  - m_Id: 18991898864672768
    m_Localized: "\u041A\u0430\u0440\u043C\u0430\u043D\u043D\u044B\u0439 \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A
      \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 \u2014 \u043E\u0442
      \u041F\u0438\u0444\u0430\u0433\u043E\u0440\u0430 \u0434\u043E \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u043E\u0432.
      \u0411\u0435\u0437 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439
      \u0438 \u0431\u0435\u0437 \u201E\u0441\u0434\u0430\u0439\u0442\u0435 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u044B\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 18991898919198720
    m_Localized: "PeopleOfMath \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u043E
      \u043D\u0430\u0439\u0442\u0438 \u044D\u043F\u043E\u0445\u0443, \u0441\u0442\u0440\u0430\u043D\u0443
      \u0438 \u0440\u0430\u0437\u0434\u0435\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438,
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443
      \u0443\u0447\u0451\u043D\u043E\u0433\u043E \u0438 \u043E\u0441\u0432\u0435\u0436\u0438\u0442\u044C
      \u0444\u0430\u043A\u0442\u044B \u043F\u0435\u0440\u0435\u0434 \u0443\u0440\u043E\u043A\u043E\u043C
      \u0438\u043B\u0438 \u043B\u0435\u043A\u0446\u0438\u0435\u0439. \u041A\u0430\u0442\u0430\u043B\u043E\u0433
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043E\u0444\u043B\u0430\u0439\u043D
      \u2014 \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 Wi\u2011Fi \u0432
      \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435 \u0440\u0435\u0448\u0438\u043B
      \u0441\u0434\u0430\u0442\u044C\u0441\u044F \u0440\u0430\u043D\u044C\u0448\u0435
      \u043A\u043B\u0430\u0441\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18991898919198721
    m_Localized: "\u0427\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438"
