      \u0438\u043D\u0434\u0435\u043A\u0441 \xB7 \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u043E\u0435
      \xB7 \u043C\u0438\u043D\u0438-\u043A\u0432\u0438\u0437 \xB7 \u0442\u0435\u043C\u044B
      \u0438 \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0448\u0440\u0438\u0444\u0442."
