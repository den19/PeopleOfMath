  - m_Id: 18991898919198724
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u0432\u044B\u0440\u0443\u0447\u0438\u043B\u043E \u043D\u0430 \u0443\u0440\u043E\u043A\u0435
      \u0438\u043B\u0438 \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0435 \u2014
      \u043A\u043E\u0440\u043E\u0442\u043A\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430
      \u0432 RuStore \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C
      \u0435\u0433\u043E \u043D\u0430\u0439\u0442\u0438. \u041F\u044F\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434 \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B
      \u043F\u043E \u0442\u0435\u043E\u0440\u0435\u043C\u0435, \u043D\u043E \u043E\u0447\u0435\u043D\u044C
      \u043F\u0440\u0438\u044F\u0442\u043D\u044B empirically."
    m_Metadata:
      m_Items: []
