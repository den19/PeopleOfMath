    m_Metadata:
      m_Items: []
  - m_Id: 9200000000000003
    m_Localized: Reset everything?
    m_Metadata:
      m_Items: []
  - m_Id: 9200000000000004
    m_Localized: Language, theme, font size, favorites, and quiz results will be
      deleted. The app will return to a fresh-install state.
    m_Metadata:
      m_Items: []
