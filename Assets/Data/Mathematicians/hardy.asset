  achievementsRu: "\u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0413\u043e\u0434\u0444\u0440\u0438
    \u0425\u0430\u0440\u043e\u043b\u0434\u0430 \u0425\u0430\u0440\u0434\u0438 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u043d\u0430\u0443\u043a\u0435. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\n\U0001F9EC \u0420\u0435\u0444\u043e\u0440\u043c\u0430
    \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u043e\u0434\u043d\u043e \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0439 \u0425\u0430\u0440\u0434\u0438 \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430,
    \u0430 \u043f\u043e\u043b\u043d\u043e\u0435 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0432 \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u0438.
    \u0414\u043e \u0425\u0430\u0440\u0434\u0438 \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0448\u043a\u043e\u043b\u0430
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u043f\u043e\u0434 \u0441\u0438\u043b\u044c\u043d\u044b\u043c
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0439
    \u0418\u0441\u0430\u0430\u043a\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u0431\u044b\u043b\u0430
    \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430
    \u043d\u0430 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u043d\u0430 \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0443.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b\u0441\u044f \u043a\u0430\u043a
    \u043d\u0430\u0431\u043e\u0440 \u043f\u0440\u0430\u0432\u0438\u043b \u0438 \u043f\u0440\u0438\u0435\u043c\u043e\u0432
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447. \u0425\u0430\u0440\u0434\u0438, \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0439
    \u0441\u0442\u0440\u043e\u0433\u0438\u043c \u00ab\u041a\u0443\u0440\u0441\u043e\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u00bb
    \u041a\u0430\u043c\u0438\u043b\u044f \u0416\u043e\u0440\u0434\u0430\u043d\u0430, \u043f\u0440\u0438\u0432\u043d\u0435\u0441
    \u0432 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043a\u043e\u043d\u0442\u0438\u043d\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c \u0438 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434. \u0421\u0432\u043e\u044e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u0440\u043e\u043b\u044c \u043e\u043d \u0437\u0430\u043a\u0440\u0435\u043f\u0438\u043b \u0438\u0437\u0434\u0430\u043d\u0438\u0435\u043c
    \u0432 1908 \u0433\u043e\u0434\u0443 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430 \u00ab\u041a\u0443\u0440\u0441
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb
    (A Course of Pure Mathematics). \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430 \u0441\u0442\u0430\u043b\u0430
    \u043f\u0435\u0440\u0432\u043e\u0439 \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435, \u0433\u0434\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 (\u043f\u0440\u0435\u0434\u0435\u043b\u044b, \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u044c,
    \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0440\u044f\u0434\u043e\u0432)
    \u0438\u0437\u043b\u0430\u0433\u0430\u043b\u0441\u044f \u0441 \u0431\u0435\u0441\u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043d\u043e\u0439
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c\u044e, \u0447\u0442\u043e \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.\n\n\U0001F91D \u041b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0435
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0440\u044b\u0432\u044b \u0425\u0430\u0440\u0434\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0434\u0432\u0443\u043c\u044f \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c\u0438
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0441\u043e\u044e\u0437\u0430\u043c\u0438
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0441 \u0414\u0436. \u0418. \u041b\u0438\u0442\u043b\u0432\u0443\u0434\u043e\u043c \u041d\u0430\u0447\u0438\u043d\u0430\u044f
    \u0441 1911 \u0433\u043e\u0434\u0430, \u0438\u0445 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u043e\u0441\u044c 35 \u043b\u0435\u0442 \u0438
    \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0445 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    XX \u0432\u0435\u043a\u0430. \u0412 \u0441\u0440\u0435\u0434\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0445\u043e\u0434\u0438\u043b\u0430 \u0448\u0443\u0442\u043a\u0430, \u0447\u0442\u043e
    \u0432 \u0410\u043d\u0433\u043b\u0438\u0438 \u0436\u0438\u0432\u0443\u0442 \u0442\u0440\u0438
    \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430:
    \u0425\u0430\u0440\u0434\u0438, \u041b\u0438\u0442\u043b\u0432\u0443\u0434 \u0438 \u0425\u0430\u0440\u0434\u0438-\u041b\u0438\u0442\u043b\u0432\u0443\u0434,
    \u043f\u0440\u0438\u0447\u0435\u043c \u0442\u0440\u0435\u0442\u0438\u0439 \u0438\u0437 \u043d\u0438\u0445
    \u2014 \u0441\u0430\u043c\u044b\u0439 \u0432\u0435\u043b\u0438\u043a\u0438\u0439. \u0418\u0445
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u043e\u0445\u0432\u0430\u0442\u0438\u043b\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439: \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b \u0438 \u043c\u0435\u0442\u043e\u0434
    \u043a\u0440\u0443\u0433\u043e\u0432: \u0412\u043c\u0435\u0441\u0442\u0435 \u043e\u043d\u0438
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u043c\u043e\u0449\u043d\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0425\u0430\u0440\u0434\u0438-\u041b\u0438\u0442\u043b\u0432\u0443\u0434\u0430
    (\u0442\u0430\u043a\u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0430\u043a
    \u00ab\u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0439 \u043c\u0435\u0442\u043e\u0434\u00bb),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0430\u0434\u0434\u0438\u0442\u0438\u0432\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b.
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u0443\u0441\u043f\u0435\u0445\u043e\u043c
    \u044d\u0442\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u0441\u0442\u0430\u043b
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441
    \u0432 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435 \u0412\u0430\u0440\u0438\u043d\u0433\u0430
    (\u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0447\u0438\u0441\u0435\u043b
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439).
    \u0422\u0435\u043e\u0440\u0438\u044f \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u0420\u0438\u043c\u0430\u043d\u0430 \u0438 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b: \u041e\u043d\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u0440\u044f\u0434 \u0432\u0430\u0436\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b \u0438 \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b\u0438
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u0441\u043b\u043e\u0432\u043d\u044b\u0445
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u043f\u0435\u0440\u0432\u0443\u044e \u0438 \u0432\u0442\u043e\u0440\u0443\u044e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0425\u0430\u0440\u0434\u0438-\u041b\u0438\u0442\u043b\u0432\u0443\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u0443\u044e\u0442
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437: \u0418\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u0441 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0440\u044f\u0434\u0430\u043c\u0438, \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b\u043c\u0438
    \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432. \u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0421\u0440\u0438\u043d\u0438\u0432\u0430\u0441\u044b
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430 \u041a\u043e\u0433\u0434\u0430
    \u0432 1913 \u0433\u043e\u0434\u0443 \u0425\u0430\u0440\u0434\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0438\u0441\u044c\u043c\u043e \u043e\u0442 \u043d\u0438\u043a\u043e\u043c\u0443 \u043d\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u043a\u043b\u0435\u0440\u043a\u0430 \u0441 \u0434\u043b\u0438\u043d\u043d\u044b\u043c \u0441\u043f\u0438\u0441\u043a\u043e\u043c
    \u0442\u0435\u043e\u0440\u0435\u043c, \u043e\u043d \u0441\u0440\u0430\u0437\u0443 \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u043b
    \u0432 \u043d\u0451\u043c \u0433\u0435\u043d\u0438\u044f. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0441\u0430\u043c\u043e\u0433\u043e \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430
    \u0425\u0430\u0440\u0434\u0438 \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0432\u043e\u0438\u043c
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u0418\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0438\u0432\u0435\u043b\u0430 \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u043e\u0434\u043d\u0438\u0445 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0445
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u0424\u043e\u0440\u043c\u0443\u043b\u0430
    \u0425\u0430\u0440\u0434\u0438-\u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430
    \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0430 \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u0439:
    \u0414\u043b\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438 `p(n)`, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0434\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u0432 \u0440\u0430\u0437\u0431\u0438\u0442\u044c
    \u0447\u0438\u0441\u043b\u043e `n` \u043d\u0430 \u0441\u0443\u043c\u043c\u0443 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u0445, \u043e\u043d\u0438 \u0432\u044b\u0432\u0435\u043b\u0438
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443. \u042d\u0442\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u0430,
    \u043f\u043e\u0440\u0430\u0436\u0430\u044e\u0449\u0430\u044f \u0441\u0432\u043e\u0435\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e, \u0434\u0430\u043b\u0430 \u043c\u043e\u0449\u043d\u044b\u0439
    \u0442\u043e\u043b\u0447\u043e\u043a \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f
    \u0432\u0441\u0435\u0439 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438. \u041f\u043e\u0437\u0436\u0435 \u043e\u043d\u0430
    \u043d\u0430\u0448\u043b\u0430 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0444\u0438\u0437\u0438\u043a\u0435
    \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0442\u0435\u0440\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0432 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0425\u0430\u0440\u0434\u0438-\u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430:
    \u0415\u0449\u0451 \u043e\u0434\u043d\u0430 \u0438\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0430,
    \u0447\u0442\u043e \u0447\u0438\u0441\u043b\u043e `\u03c9(n)` \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435\u0439
    \u0447\u0438\u0441\u043b\u0430 `n` \u00ab\u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c\u00bb
    \u0432\u0435\u0434\u0451\u0442 \u0441\u0435\u0431\u044f \u043a\u0430\u043a `log log n`.\n\n\U0001F9EC
    \u041d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044e: \u0437\u0430\u043a\u043e\u043d
    \u0425\u0430\u0440\u0434\u0438-\u0412\u0430\u0439\u043d\u0431\u0435\u0440\u0433\u0430 \u0412
    1908 \u0433\u043e\u0434\u0443 \u0425\u0430\u0440\u0434\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u043c \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u043e\u043c
    \u0438 \u043f\u0440\u0435\u0437\u0438\u0440\u0430\u043b \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u0440\u0435\u0448\u0438\u043b
    \u0437\u0430\u0434\u0430\u0447\u0443, \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u043d\u0443\u044e
    \u0435\u043c\u0443 \u0434\u0440\u0443\u0433\u043e\u043c-\u0433\u0435\u043d\u0435\u0442\u0438\u043a\u043e\u043c
    \u0420\u0435\u0434\u0436\u0438\u043d\u0430\u043b\u044c\u0434\u043e\u043c \u041f\u0430\u043d\u043d\u0435\u0442\u0442\u043e\u043c.
    \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u0441\u0442\u0430\u043b
    \u0437\u0430\u043a\u043e\u043d \u0425\u0430\u0440\u0434\u0438-\u0412\u0430\u0439\u043d\u0431\u0435\u0440\u0433\u0430
    \u2014 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0433\u0435\u043d\u0435\u0442\u0438\u043a\u0438. \u042d\u0442\u043e\u0442 \u0437\u0430\u043a\u043e\u043d
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442, \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u043e\u0442\u044b
    \u0430\u043b\u043b\u0435\u043b\u0435\u0439 \u0438 \u0433\u0435\u043d\u043e\u0442\u0438\u043f\u043e\u0432
    \u0432 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043f\u0430\u043d\u043c\u0438\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f
    \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c\u0438 \u0438\u0437 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f
    \u0432 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438
    \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432.
    \u0421\u0430\u043c \u0425\u0430\u0440\u0434\u0438 \u0441\u0447\u0438\u0442\u0430\u043b \u044d\u0442\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u044b\u043c,
    \u043d\u043e \u0434\u043b\u044f \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u043e\u043d\u043e
    \u0441\u0442\u0430\u043b\u043e \u0431\u0430\u0437\u043e\u0432\u044b\u043c.\n\n\U0001F4DA
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb
    \u0412 1940 \u0433\u043e\u0434\u0443, \u0432 \u0440\u0430\u0437\u0433\u0430\u0440 \u0412\u0442\u043e\u0440\u043e\u0439
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b, \u0425\u0430\u0440\u0434\u0438
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u044d\u0441\u0441\u0435 \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb (A Mathematician's Apology),
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043b\u0443\u0447\u0448\u0438\u0445 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0439
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u0412 \u044d\u0442\u043e\u0439
    \u043f\u0440\u043e\u043d\u0438\u0437\u0430\u043d\u043d\u043e\u0439 \u043c\u0435\u043b\u0430\u043d\u0445\u043e\u043b\u0438\u0435\u0439
    \u043a\u043d\u0438\u0433\u0435 \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u043d\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438: \u0417\u0430\u0449\u0438\u0442\u0430
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438:
    \u0425\u0430\u0440\u0434\u0438 \u0433\u043e\u0440\u044f\u0447\u043e \u043e\u0442\u0441\u0442\u0430\u0438\u0432\u0430\u043b
    \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0435\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f:
    \"\u042f \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0434\u0435\u043b\u0430\u043b
    \u043d\u0438\u0447\u0435\u0433\u043e '\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0433\u043e'.
    \u041d\u0438 \u043e\u0434\u043d\u043e \u043c\u043e\u0451 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043d\u0435 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e \u0438 \u043d\u0435 \u043c\u043e\u0433\u043b\u043e
    \u0431\u044b \u043f\u0440\u0438\u043d\u0435\u0441\u0442\u0438... \u043d\u0438 \u043c\u0430\u043b\u0435\u0439\u0448\u0435\u0433\u043e
    \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0431\u043b\u0430\u0433\u043e\u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e
    \u044d\u0442\u043e\u0433\u043e \u043c\u0438\u0440\u0430\". \u041a\u0440\u0430\u0441\u043e\u0442\u0430
    \u043a\u0430\u043a \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439 \u0438\u0441\u0442\u0438\u043d\u044b:
    \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u2014 \u0432 \u0435\u0451
    \u044d\u0441\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0440\u0430\u0441\u043e\u0442\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u0441\u0442\u0430\u0432\u0438\u043b
    \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434 \u0441 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u044c\u044e
    \u0438 \u043f\u043e\u044d\u0437\u0438\u0435\u0439. \u041f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e,
    \u0447\u0438\u0441\u0442\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b,
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u044b\u0441\u0448\u0438\u043c \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c
    \u044d\u0442\u043e\u0439 \u043a\u0440\u0430\u0441\u043e\u0442\u044b.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0417\u0430 \u0441\u0432\u043e\u0438
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0425\u0430\u0440\u0434\u0438
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043d\u0430\u0433\u0440\u0430\u0434, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u043c\u0435\u0434\u0430\u043b\u044c (1920), \u043c\u0435\u0434\u0430\u043b\u044c \u0414\u0435
    \u041c\u043e\u0440\u0433\u0430\u043d\u0430 (1929), \u043c\u0435\u0434\u0430\u043b\u044c
    \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u0430 (1940) \u0438 \u0432\u044b\u0441\u0448\u0443\u044e
    \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u2014 \u043c\u0435\u0434\u0430\u043b\u044c \u041a\u043e\u043f\u043b\u0438 (1947). \u041e\u043d
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c \u0410\u041d \u0421\u0421\u0421\u0420 \u0438 \u043c\u043d\u043e\u0433\u0438\u0445
    \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439 \u043c\u0438\u0440\u0430.
    \u041e\u0431\u0449\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0435\u0433\u043e \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0439 (\u0441\u0442\u0430\u0442\u0435\u0439
    \u0438 \u043a\u043d\u0438\u0433) \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442
    300, \u0447\u0442\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e\u0431 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u0435\u0433\u043e \u0443\u043c\u0430.
    \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0436\u0438\u0432\u0435\u0442
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u0445,
    \u043d\u043e\u0441\u044f\u0449\u0438\u0445 \u0435\u0433\u043e \u0438\u043c\u044f, \u043d\u043e
    \u0438 \u0432 \u0441\u0430\u043c\u043e\u043c \u0434\u0443\u0445\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0433\u0434\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c
    \u0438 \u043a\u0440\u0430\u0441\u043e\u0442\u0430 \u0438\u0434\u0443\u0442 \u0440\u0443\u043a\u0430
    \u043e\u0431 \u0440\u0443\u043a\u0443."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0413\u043e\u0434\u0444\u0440\u0438
    \u0425\u0430\u0440\u043e\u043b\u0434\u0430 \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b\u0430
    \u0441\u0442\u043e\u043b\u044c \u0436\u0435 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0439
    \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0439, \u043a\u0430\u043a
    \u0438 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0433\u0435\u043d\u0438\u0439. \u0415\u0441\u043b\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c
    \u043a\u0440\u0430\u0442\u043a\u043e, \u043e\u043d \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c
    \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435
    \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0438 \u043d\u0435 \u0438\u043c\u0435\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0432\u044f\u0437\u0435\u0439. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0439
    \u0438 \u0432\u0441\u0435\u043f\u043e\u0433\u043b\u043e\u0449\u0430\u044e\u0449\u0435\u0439
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e \u0431\u044b\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u0430 \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u0441\u0442\u0438,
    \u0447\u0430\u0441\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0435\u043c\u0443
    \u0432\u0442\u043e\u0440\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c.\n\n\U0001F575\ufe0f\u200d\u2642\ufe0f
    \u0417\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438
    \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u043a\u0440\u0430\u0439\u043d\u0435 \u0437\u0430\u0441\u0442\u0435\u043d\u0447\u0438\u0432
    \u0438 \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0446\u0435\u043b\u044b\u043c \u0440\u044f\u0434\u043e\u043c
    \u043f\u0440\u0438\u0447\u0443\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u043b\u0438
    \u0435\u0433\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u0444\u0438\u0433\u0443\u0440\u043e\u0439
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435: \u041d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u044c
    \u043a \u0437\u0435\u0440\u043a\u0430\u043b\u0430\u043c \u0438 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u043c:
    \u041e\u043d \u043d\u0435 \u0432\u044b\u043d\u043e\u0441\u0438\u043b \u0441\u0432\u043e\u0435\u0433\u043e
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0438, \u0432\u0445\u043e\u0434\u044f
    \u0432 \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0447\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440,
    \u043f\u0435\u0440\u0432\u044b\u043c \u0434\u0435\u043b\u043e\u043c \u043d\u0430\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043b
    \u043f\u043e\u043b\u043e\u0442\u0435\u043d\u0446\u0435 \u043d\u0430 \u0432\u0441\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u0431\u043e\u044f\u043b\u0441\u044f, \u0447\u0442\u043e \u0435\u0433\u043e \u0441\u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u044e\u0442.
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432\u0441\u0435\u0433\u043e \u043f\u044f\u0442\u044c \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445
    \u0441\u043d\u0438\u043c\u043a\u043e\u0432, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u043d \u0437\u0430\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d. \u0410\u0442\u0435\u0438\u0437\u043c
    \u0438 \"\u0438\u0433\u0440\u0430 \u0441 \u0411\u043e\u0433\u043e\u043c\": \u0425\u0430\u0440\u0434\u0438
    \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u043c \u0430\u0442\u0435\u0438\u0441\u0442\u043e\u043c,
    \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043f\u043e\u0441\u0435\u0449\u0430\u0442\u044c
    \u0447\u0430\u0441\u043e\u0432\u043d\u044e \u0434\u0430\u0436\u0435 \u0434\u043b\u044f \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0446\u0435\u0440\u0435\u043c\u043e\u043d\u0438\u0439 \u0438 \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u044d\u0442\u043e \"\u0447\u0451\u0440\u043d\u043e-\u0431\u0435\u043b\u043e\u0435\"
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043f\u0440\u0438\u043d\u044f\u0442\u043e\u0435
    \u0438\u043c \u0435\u0449\u0451 \u0432 \u044e\u043d\u043e\u0441\u0442\u0438. \u041e\u0434\u043d\u0430\u043a\u043e
    \u044d\u0442\u043e \u043d\u0435 \u043c\u0435\u0448\u0430\u043b\u043e \u0435\u043c\u0443
    \u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u0443\u044e \"\u0438\u0433\u0440\u0443\"
    \u0441 \u0411\u043e\u0433\u043e\u043c, \u0432 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d \u043d\u0435 \u0432\u0435\u0440\u0438\u043b.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044f\u0441\u044c
    \u0438\u0437 \u0414\u0430\u043d\u0438\u0438, \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b
    \u043e\u0442\u043a\u0440\u044b\u0442\u043a\u0443 \u0441 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c,
    \u0447\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0420\u0438\u043c\u0430\u043d\u0430, \u043f\u043e\u043b\u0430\u0433\u0430\u044f, \u0447\u0442\u043e
    \u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0441\u0442 \u0435\u0433\u043e \u043a\u043e\u0440\u0430\u0431\u043b\u044e
    \u0443\u0442\u043e\u043d\u0443\u0442\u044c \u0438 \u043b\u0438\u0448\u0438\u0442\u044c \u043c\u0438\u0440
    \u0442\u0430\u043a\u043e\u0439 \u0432\u0435\u043b\u0438\u043a\u043e\u0439 \u0441\u043b\u0430\u0432\u044b.
    \u0412 \u0434\u0440\u0443\u0433\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u043e\u043d
    \u0431\u0440\u0430\u043b \u043d\u0430 \u043a\u0440\u0438\u043a\u0435\u0442\u043d\u044b\u0435
    \u043c\u0430\u0442\u0447\u0438 \"\u0430\u043d\u0442\u0438-\u0431\u043e\u0436\u044c\u044e
    \u0431\u0430\u0442\u0430\u0440\u0435\u044e\" (\u0441\u0432\u0438\u0442\u0435\u0440\u0430,
    \u0437\u043e\u043d\u0442 \u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b),
    \u043d\u0430\u0434\u0435\u044f\u0441\u044c, \u0447\u0442\u043e \u0411\u043e\u0433 \u043f\u043e\u0448\u043b\u0451\u0442
    \u0445\u043e\u0440\u043e\u0448\u0443\u044e \u043f\u043e\u0433\u043e\u0434\u0443, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u043c\u0435\u0448\u0430\u0442\u044c \u0435\u043c\u0443 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c.\n\n\U0001F48E
    \u0421\u0430\u043c\u0430\u044f \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u043d\u0430\u044f
    \u0441\u0432\u044f\u0437\u044c: \u0421\u0440\u0438\u043d\u0438\u0432\u0430\u0441\u0430 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d
    \u0425\u043e\u0442\u044f \u0443 \u0425\u0430\u0440\u0434\u0438 \u043d\u0435 \u0431\u044b\u043b\u043e
    \u0441\u0435\u043c\u044c\u0438 \u0432 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u043c
    \u0441\u043c\u044b\u0441\u043b\u0435, \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438
    \u0431\u044b\u043b\u0430 \u043e\u0434\u043d\u0430 \u0441\u0432\u044f\u0437\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u0441\u0430\u043c \u043d\u0430\u0437\u0432\u0430\u043b \"\u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\".
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c-\u0441\u0430\u043c\u043e\u0443\u0447\u043a\u043e\u0439
    \u0421\u0440\u0438\u043d\u0438\u0432\u0430\u0441\u043e\u0439 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u043e\u043c.
    \u041a\u043e\u0433\u0434\u0430 \u0432 1913 \u0433\u043e\u0434\u0443 \u0425\u0430\u0440\u0434\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043e\u0442 \u043d\u0438\u043a\u043e\u043c\u0443
    \u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u043a\u043b\u0435\u0440\u043a\u0430
    \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u0434\u043b\u0438\u043d\u043d\u044b\u043c \u0441\u043f\u0438\u0441\u043a\u043e\u043c
    \u0444\u043e\u0440\u043c\u0443\u043b, \u043e\u043d \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e
    \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u043b \u0432 \u043d\u0451\u043c \u0433\u0435\u043d\u0438\u044f.
    \u042d\u0442\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u043e\u043d \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b \u043a\u0430\u043a \"\u043e\u0434\u043d\u043e
    \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u043e\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u0432 \u043c\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438\" (the one romantic incident
    in my life). \u0417\u0430\u0431\u043e\u0442\u0430 \u043e \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0435
    \u0438 \u0438\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0438 \u0434\u043b\u044f \u0425\u0430\u0440\u0434\u0438
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u043b\u0438\u0447\u043d\u044b\u043c \u0438 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u043c
    \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0435\u043c.\n\n\U0001F465
    \u041a\u0440\u0443\u0433 \u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0438 \u0432\u0437\u0433\u043b\u044f\u0434\u044b
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0441\u0442\u044c,
    \u0425\u0430\u0440\u0434\u0438 \u043d\u0435 \u0431\u044b\u043b \u043f\u043e\u043b\u043d\u044b\u043c
    \u043e\u0442\u0448\u0435\u043b\u044c\u043d\u0438\u043a\u043e\u043c. \u041e\u043d \u0432\u0445\u043e\u0434\u0438\u043b
    \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0433\u0440\u0443\u043f\u043f\u0443
    \u0411\u043b\u0443\u043c\u0441\u0431\u0435\u0440\u0438 \u2014 \u043b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u0438\u0439
    \u043a\u0440\u0443\u0436\u043e\u043a \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u043e\u0432
    \u0438 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u043e\u0432. \u0412 \u0440\u0430\u0437\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0435\u0433\u043e \u0431\u043b\u0438\u0437\u043a\u0438\u043c\u0438
    \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u0431\u044b\u043b\u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444
    \u0414\u0436\u043e\u0440\u0434\u0436 \u041c\u0443\u0440, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444 \u0411\u0435\u0440\u0442\u0440\u0430\u043d
    \u0420\u0430\u0441\u0441\u0435\u043b, \u0430 \u0442\u0430\u043a\u0436\u0435 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442
    \u0414\u0436\u043e\u043d \u041c\u0435\u0439\u043d\u0430\u0440\u0434 \u041a\u0435\u0439\u043d\u0441.
    \u041e\u043d \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u043c
    \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u043e\u043c. \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u043e\u043d \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0421\u043e\u044e\u0437\u0435
    \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f, \u0430 \u0432 1930-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u2014 \u0432 \u0421\u043e\u044e\u0437\u0435 \u0437\u0430 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u0432\u043e\u0431\u043e\u0434\u0443. \u0415\u0433\u043e \u0441\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438 \u0430\u043d\u0442\u0438\u0432\u043e\u0435\u043d\u043d\u044b\u0435 \u0432\u0437\u0433\u043b\u044f\u0434\u044b
    \u0447\u0430\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u0438 \u0435\u0433\u043e \u0431\u0435\u043b\u043e\u0439
    \u0432\u043e\u0440\u043e\u043d\u043e\u0439 \u0432 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u043e\u043c
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435.\n\n\u2764\ufe0f
    \u0418\u0442\u043e\u0433: \"\u0416\u0438\u0437\u043d\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\"
    \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u0441\u0435\u0431\u044f \u043d\u0430\u0443\u043a\u0435.
    \u0415\u0433\u043e \"\u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c\"
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u0441\u0442\u0440\u0430\u0441\u0442\u0438
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0440\u0430\u0441\u043e\u0442\u0435, \u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0437\u0430\u0445 \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438-\u0435\u0434\u0438\u043d\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438
    (\u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u041b\u0438\u0442\u043b\u0432\u0443\u0434
    \u0438 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d) \u0438 \u043e \u044f\u0440\u043a\u043e
    \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445, \u0438\u043d\u043e\u0433\u0434\u0430
    \u043f\u043e\u0447\u0442\u0438 \u0433\u0440\u043e\u0442\u0435\u0441\u043a\u043d\u044b\u0445,
    \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044f\u0445.
    \u041e\u043d \u0431\u044b\u043b \u0441\u043b\u043e\u0436\u043d\u043e\u0439, \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0439
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439, \u0447\u044c\u044f \u043f\u043e\u0434\u043b\u0438\u043d\u043d\u0430\u044f
    \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u0431\u044b\u043b\u0430
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u043d\u0435 \u043d\u0430 \u043b\u044e\u0434\u0435\u0439
    \u0432 \u0431\u044b\u0442\u043e\u0432\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435,
    \u0430 \u043d\u0430 \u043c\u0438\u0440 \u0438\u0434\u0435\u0439 \u0438 \u0447\u0438\u0441\u0435\u043b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0442\u0430\u043a \u043b\u044e\u0431\u0438\u043b
    \u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0441\u043b\u0443\u0436\u0438\u043b."
  personalLifeEn: 
  shortBioRu: "\u0413\u043e\u0434\u0444\u0440\u0438 \u0425\u0430\u0440\u043e\u043b\u0434 \u0425\u0430\u0440\u0434\u0438
    (1877\u20131947) \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    XX \u0432\u0435\u043a\u0430, \u043b\u0438\u0434\u0435\u0440 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0433\u043e \u0443\u043c\u0430, \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u043e\u0439
    \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u0435,
    \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0434\u0440\u0443\u0436\u0431\u044b
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439
    \u043e \u043f\u0440\u0438\u0440\u043e\u0434\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0412\u043e\u0442 \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0413\u043e\u0434\u0444\u0440\u0438
    \u0425\u0430\u0440\u043e\u043b\u0434\u0430 \u0425\u0430\u0440\u0434\u0438.\n\n\U0001F9EC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    (1877\u20131900) - \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e: \u0425\u0430\u0440\u0434\u0438 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    7 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1877 \u0433\u043e\u0434\u0430 \u0432 \u041a\u0440\u0430\u043d\u043b\u0438,
    \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u043e \u0421\u0443\u0440\u0440\u0435\u0439, \u0432
    \u0441\u0435\u043c\u044c\u0435 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0445 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0410\u0439\u0437\u0435\u043a \u0425\u0430\u0440\u0434\u0438,
    \u0431\u044b\u043b \u043a\u0430\u0437\u043d\u0430\u0447\u0435\u0435\u043c \u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c
    \u0440\u0438\u0441\u043e\u0432\u0430\u043d\u0438\u044f, \u0430 \u043c\u0430\u0442\u044c,
    \u0421\u043e\u0444\u0438\u044f, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b\u0430.
    \u041e\u0431\u0430 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u043e\u0431\u043b\u0430\u0434\u0430\u043b\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c\u0438, \u043d\u043e
    \u043d\u0435 \u0438\u043c\u0435\u043b\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u043b\u0430\u043d\u0442\u044b \u0425\u0430\u0440\u0434\u0438 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u0440\u0430\u043d\u043e: \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u0432\u0443\u0445
    \u043b\u0435\u0442 \u043e\u043d \u043f\u0438\u0441\u0430\u043b \u0447\u0438\u0441\u043b\u0430
    \u0434\u043e \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432, \u0430 \u0432 \u0446\u0435\u0440\u043a\u0432\u0438
    \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f, \u0440\u0430\u0437\u043b\u0430\u0433\u0430\u044f
    \u043d\u043e\u043c\u0435\u0440\u0430 \u043f\u0441\u0430\u043b\u043c\u043e\u0432 \u043d\u0430
    \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0438.
    - \u0428\u043a\u043e\u043b\u0430 \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0443\u0441\u043f\u0435\u0445\u0438:
    \u0414\u043e 12 \u043b\u0435\u0442 \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f \u0432
    \u0448\u043a\u043e\u043b\u0435 \u041a\u0440\u0430\u043d\u043b\u0438, \u0430 \u0432 1889
    \u0433\u043e\u0434\u0443 \u0432\u044b\u0438\u0433\u0440\u0430\u043b \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e
    \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439 \u0412\u0438\u043d\u0447\u0435\u0441\u0442\u0435\u0440-\u043a\u043e\u043b\u043b\u0435\u0434\u0436.
    \u0412\u0438\u043d\u0447\u0435\u0441\u0442\u0435\u0440 \u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u043e\u0439,
    \u043d\u043e \u0441\u0430\u043c \u0425\u0430\u0440\u0434\u0438 \u043d\u0435 \u043b\u044e\u0431\u0438\u043b
    \u044d\u0442\u043e \u0443\u0447\u0435\u0431\u043d\u043e\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0438\u0437-\u0437\u0430 \u0441\u0443\u0440\u043e\u0432\u043e\u0439 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u044b.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c
    \u043e\u043d \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0443\u0441\u043f\u0435\u0445\u043e\u0432 \u0438 \u0432 1896 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u0434\u043b\u044f \u0443\u0447\u0435\u0431\u044b
    \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    - \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436 \u0438 \"\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0422\u0440\u0438\u043f\u043e\u0441\": \u0412 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435
    \u0425\u0430\u0440\u0434\u0438 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f
    \u0441 \u0440\u0443\u0442\u0438\u043d\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u043a \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u043c,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u043d\u0430\u0446\u0435\u043b\u0435\u043d\u0430
    \u043d\u0430 \u0437\u0430\u0443\u0447\u0438\u0432\u0430\u043d\u0438\u0435 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0438\u0435\u043c\u043e\u0432, \u0430 \u043d\u0435 \u043d\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435
    \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430.
    \u042d\u0442\u043e \u0435\u0433\u043e \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043b\u043e,
    \u0438 \u043e\u043d \u0434\u0430\u0436\u0435 \u043f\u043e\u0434\u0443\u043c\u044b\u0432\u0430\u043b
    \u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0435 \u043d\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044e.
    \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0441\u0442\u0430\u043b\u043e \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e
    \u0441 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u041e\u0433\u0430\u0441\u0442\u0435\u0441\u043e\u043c
    \u041b\u0430\u0432\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u043b
    \u0435\u043c\u0443 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \"\u041a\u0443\u0440\u0441 \u0430\u043d\u0430\u043b\u0438\u0437\u0430\" \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u041a\u0430\u043c\u0438\u043b\u044f
    \u0416\u043e\u0440\u0434\u0430\u043d\u0430. \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430
    \u043e\u0442\u043a\u0440\u044b\u043b\u0430 \u0425\u0430\u0440\u0434\u0438 \u0433\u043b\u0430\u0437\u0430
    \u043d\u0430 \u0442\u043e, \"\u0447\u0442\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435 \u0437\u043d\u0430\u0447\u0438\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\".
    \u0412 1898 \u0433\u043e\u0434\u0443 \u043e\u043d \u0437\u0430\u043d\u044f\u043b \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u043e\u0435
    \u043c\u0435\u0441\u0442\u043e \u043d\u0430 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u044b\u0445
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u0445 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0438\u043f\u043e\u0441\u0430, \u0447\u0442\u043e \u0435\u0433\u043e \u0432\u0441\u0435\u0433\u0434\u0430
    \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u043b\u043e, \u0442\u0430\u043a \u043a\u0430\u043a
    \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0434\u043e\u043b\u0436\u0435\u043d
    \u0431\u044b\u043b \u0431\u044b\u0442\u044c \u043f\u0435\u0440\u0432\u044b\u043c. \u0412
    1900 \u0433\u043e\u0434\u0443 \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u0441\u043e\u0432\u0435\u0442\u0430 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430
    \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0435\u043c\u0438\u044e \u0421\u043c\u0438\u0442\u0430
    (\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0414\u0436\u0435\u0439\u043c\u0441\u043e\u043c
    \u0414\u0436\u0438\u043d\u0441\u043e\u043c).\n\n\U0001F468\u200d\U0001F3EB \u041d\u0430\u0447\u0430\u043b\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a (1900\u20131911) - \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435
    \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u0421
    1900 \u0433\u043e\u0434\u0430 \u0425\u0430\u0440\u0434\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0435, \u0430 \u0441
    1906 \u0433\u043e\u0434\u0430 \u0441\u0442\u0430\u043b \u043b\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u0441 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439
    (\u0432\u0441\u0435\u0433\u043e 6 \u0447\u0430\u0441\u043e\u0432 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e),
    \u0447\u0442\u043e \u0434\u0430\u0432\u0430\u043b\u043e \u0435\u043c\u0443 \u043c\u043d\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0440\u0430\u0431\u043e\u0442 \u043f\u043e
    \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0440\u044f\u0434\u043e\u0432
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432, \u0447\u0442\u043e
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0435\u0433\u043e \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044e
    \u0432 \u0447\u043b\u0435\u043d\u044b \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u0432 1910 \u0433\u043e\u0434\u0443. - \u00ab\u041a\u0443\u0440\u0441 \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb: \u0412 1908 \u0433\u043e\u0434\u0443
    \u0432\u044b\u0448\u043b\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0435\u0433\u043e
    \u0441\u0430\u043c\u043e\u0435 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u2014 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u00ab\u041a\u0443\u0440\u0441 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb
    (A Course of Pure Mathematics). \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0439. \u041e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0432\u044b\u043c \u0441\u0442\u0440\u043e\u0433\u0438\u043c
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u043e\u0441\u043d\u043e\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 (\u043f\u0440\u0435\u0434\u0435\u043b\u044b,
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u044c, \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c)
    \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435,
    \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0434\u043b\u044f
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432. \u0414\u043e \u044d\u0442\u043e\u0433\u043e
    \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430
    \u043d\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043a \u0444\u0438\u0437\u0438\u043a\u0435,
    \u0438 \u0425\u0430\u0440\u0434\u0438 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c \u2014 \u044d\u0442\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430. \u041f\u043e\u0437\u0436\u0435
    \u043e\u043d \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b \u0441\u0435\u0431\u044f
    \u0441 \"\u043c\u0438\u0441\u0441\u0438\u043e\u043d\u0435\u0440\u043e\u043c, \u0433\u043e\u0432\u043e\u0440\u044f\u0449\u0438\u043c
    \u0441 \u043a\u0430\u043d\u043d\u0438\u0431\u0430\u043b\u0430\u043c\u0438\", \u043f\u044b\u0442\u0430\u044f\u0441\u044c
    \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u0438\u0434\u0435\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0431\u044b\u043b\u0438 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043d\u043e\u0432\u044b\u043c\u0438.\n\n\U0001F91D
    \u0412\u0435\u043b\u0438\u043a\u043e\u0435 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e:
    \u041b\u0438\u0442\u043b\u0432\u0443\u0434 \u0438 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d
    (1911\u20131920) \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b
    \u0441\u0430\u043c\u044b\u043c \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c
    \u0438 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b \u0425\u0430\u0440\u0434\u0438
    \u043d\u0430 \u0432\u0435\u0441\u044c \u043c\u0438\u0440. - \u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u0414\u0436. \u0418. \u041b\u0438\u0442\u043b\u0432\u0443\u0434\u043e\u043c: \u041d\u0430\u0447\u0438\u043d\u0430\u044f
    \u0441 1911 \u0433\u043e\u0434\u0430 \u043d\u0430\u0447\u0430\u043b\u043e\u0441\u044c \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0435
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0425\u0430\u0440\u0434\u0438
    \u0441 \u0414\u0436\u043e\u043d\u043e\u043c \u0418\u0434\u0435\u043d\u0437\u043e\u0440\u043e\u043c
    \u041b\u0438\u0442\u043b\u0432\u0443\u0434\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u043e\u0441\u044c 35 \u043b\u0435\u0442. \u0418\u0445
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u0441\u043d\u043e\u0439,
    \u0447\u0442\u043e \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043c\u0438\u0440\u0435 \u0445\u043e\u0434\u0438\u043b\u0430 \u0448\u0443\u0442\u043a\u0430,
    \u0447\u0442\u043e \u0432 \u0410\u043d\u0433\u043b\u0438\u0438 \u0436\u0438\u0432\u0443\u0442
    \u0442\u0440\u0438 \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430:
    \u0425\u0430\u0440\u0434\u0438, \u041b\u0438\u0442\u043b\u0432\u0443\u0434 \u0438 \u0425\u0430\u0440\u0434\u0438-\u041b\u0438\u0442\u043b\u0432\u0443\u0434,
    \u043f\u0440\u0438\u0447\u0435\u043c \u0442\u0440\u0435\u0442\u0438\u0439 \u0438\u0437 \u043d\u0438\u0445
    \u2014 \u0441\u0430\u043c\u044b\u0439 \u0432\u0435\u043b\u0438\u043a\u0438\u0439. \u041e\u043d\u0438
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u043b\u0438
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b,
    \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u043e\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0435,
    \u0441\u0443\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0440\u0430\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0445\u0441\u044f
    \u0440\u044f\u0434\u043e\u0432 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0440\u044f\u0434\u043e\u0432
    \u0424\u0443\u0440\u044c\u0435. \u0421\u0430\u043c \u0425\u0430\u0440\u0434\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b,
    \u0447\u0442\u043e \u041b\u0438\u0442\u043b\u0432\u0443\u0434 \u043e\u0431\u043b\u0430\u0434\u0430\u043b
    \u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043d\u0430\u0432\u044b\u043a\u0430\u043c\u0438, \u0430 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0441\u044f
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438 \u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u043c
    \u0441\u0442\u0438\u043b\u0435 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f. -
    \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0421\u0440\u0438\u043d\u0438\u0432\u0430\u0441\u044b
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430: \u0412 1913 \u0433\u043e\u0434\u0443
    \u0425\u0430\u0440\u0434\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0438\u0441\u044c\u043c\u043e
    \u043e\u0442 \u043d\u0438\u043a\u043e\u043c\u0443 \u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u043a\u043b\u0435\u0440\u043a\u0430 \u0438\u0437 \u0418\u043d\u0434\u0438\u0438, \u0421\u0440\u0438\u043d\u0438\u0432\u0430\u0441\u044b
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430, \u0441 \u0434\u043b\u0438\u043d\u043d\u044b\u043c
    \u0441\u043f\u0438\u0441\u043a\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b. \u0414\u0432\u0430 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0438 \u0433\u0435\u043d\u0438\u044f,
    \u043d\u043e \u0425\u0430\u0440\u0434\u0438 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0442\u043e \u0438\u043c\u0435\u0435\u0442 \u0434\u0435\u043b\u043e \u0441 \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u044b\u043c
    \u0442\u0430\u043b\u0430\u043d\u0442\u043e\u043c. \u041e\u043d \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436
    \u0432 1914 \u0433\u043e\u0434\u0443, \u0438 \u043d\u0430\u0447\u0430\u043b\u043e\u0441\u044c
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0425\u0430\u0440\u0434\u0438 \u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u0437\u0432\u0430\u043b
    \"\u043e\u0434\u043d\u0438\u043c \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u043b\u0443\u0447\u0430\u0435\u043c \u0432 \u043c\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438\".
    \u041e\u043d\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0438
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u0434\u043b\u044f \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u043a\u0438 \u0447\u0438\u0441\u043b\u0430
    \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u0439 p(n), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0442\u043e\u0447\u043d\u043e\u0439. \u0425\u0430\u0440\u0434\u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b \u0441 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u043e\u043c,
    \u043d\u043e \u0438 \u043f\u043e\u043c\u043e\u0433 \u0435\u043c\u0443 \u0432\u043e\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u044c
    \u043f\u0440\u043e\u0431\u0435\u043b\u044b \u0432 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u0441\u0442\u0430\u0440\u0430\u044f\u0441\u044c \u043d\u0435 \u043f\u043e\u0434\u0430\u0432\u0438\u0442\u044c
    \u0435\u0433\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0433\u0435\u043d\u0438\u0439.
    \u042d\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u2014 \u043e\u0434\u043d\u0430
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.\n\n\U0001F468\u200d\U0001F393
    \u041e\u043a\u0441\u0444\u043e\u0440\u0434, \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d
    \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436
    (1919\u20131942) - \u041f\u0435\u0440\u0432\u0430\u044f \u043c\u0438\u0440\u043e\u0432\u0430\u044f
    \u0432\u043e\u0439\u043d\u0430: \u0412\u043e\u0439\u043d\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043c
    \u0434\u043b\u044f \u0425\u0430\u0440\u0434\u0438. \u041e\u043d \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u043c
    \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u043e\u043c \u0438 \u043d\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u043b
    \u043f\u0430\u0442\u0440\u0438\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430
    \u043a\u043e\u043b\u043b\u0435\u0433. \u041e\u043d \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435
    \u0443\u0432\u0430\u0436\u0430\u043b \u043d\u0435\u043c\u0435\u0446\u043a\u0443\u044e \u043d\u0430\u0443\u043a\u0443
    \u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0443 \u0438 \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0432\u0441\u0442\u0443\u043f\u0430\u0442\u044c \u0432 \u0432\u043e\u0439\u043d\u0443
    \u043d\u0435 \u0441\u0442\u043e\u0438\u043b\u043e. \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0448\u0435\u043b
    \u0432\u043e\u0435\u043d\u043d\u0443\u044e \u0441\u043b\u0443\u0436\u0431\u0443 \u043f\u043e
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c,
    \u043d\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 \u043d\u0435\u0443\u044e\u0442\u043d\u043e.
    - \u041e\u043a\u0441\u0444\u043e\u0440\u0434: \u0412 1919 \u0433\u043e\u0434\u0443 \u0425\u0430\u0440\u0434\u0438
    \u0441 \u0440\u0430\u0434\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436, \u043f\u0440\u0438\u043d\u044f\u0432 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    (\u0421\u0430\u0432\u0438\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430)
    \u0432 \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 (\u0434\u043e 1931 \u0433\u043e\u0434\u0430)
    \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0445
    \u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0432 \u0441\u0432\u043e\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438. \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0438\u043b\u044c\u043d\u0443\u044e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u043b\u0443\u0447\u0448\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442 \u0432 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u0441\u0442\u0432\u0435
    \u0441 \u041b\u0438\u0442\u043b\u0432\u0443\u0434\u043e\u043c, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u043e \u0447\u0442\u043e \u043e\u043d\u0438 \u0436\u0438\u043b\u0438
    \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u0433\u043e\u0440\u043e\u0434\u0430\u0445.
    - \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d: \u0412 1928\u20131929 \u0433\u043e\u0434\u0430\u0445
    \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u043e\u0435\u0437\u0434\u043a\u0443
    \u0432 \u0421\u0428\u0410, \u0433\u0434\u0435 \u0447\u0438\u0442\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0438 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u043e\u043c
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435, \u043e\u0431\u043c\u0435\u043d\u044f\u0432\u0448\u0438\u0441\u044c
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u0441 \u041e\u0441\u0432\u0430\u043b\u044c\u0434\u043e\u043c
    \u0412\u0435\u0431\u043b\u0435\u043d\u043e\u043c. - \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436: \u0412 1931 \u0433\u043e\u0434\u0443
    \u0425\u0430\u0440\u0434\u0438 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436,
    \u0437\u0430\u043d\u044f\u0432 \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0421\u044d\u0434\u043b\u0435\u0440\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u0434\u043e \u0432\u044b\u0445\u043e\u0434\u0430 \u043d\u0430 \u043f\u0435\u043d\u0441\u0438\u044e
    \u0432 1942 \u0433\u043e\u0434\u0443. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u0435\u043d
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435\u043c \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438,
    \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b \u044d\u0442\u0443 \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0441\u0430\u043c\u043e\u0439 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u0432 \u0410\u043d\u0433\u043b\u0438\u0438 \u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0435\u043b
    \u043e\u0441\u0442\u0430\u0442\u044c\u0441\u044f \u0432 \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435
    \u0434\u043e \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438.\n\n\U0001F58B \u041f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb
    (1940\u20131947) - \u0412\u0442\u043e\u0440\u0430\u044f \u043c\u0438\u0440\u043e\u0432\u0430\u044f
    \u0432\u043e\u0439\u043d\u0430 \u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u044c: \u0412\u0442\u043e\u0440\u0430\u044f
    \u043c\u0438\u0440\u043e\u0432\u0430\u044f \u0432\u043e\u0439\u043d\u0430, \u043a\u0430\u043a
    \u0438 \u043f\u0435\u0440\u0432\u0430\u044f, \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430
    \u0425\u0430\u0440\u0434\u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0435.
    \u041e\u043d \u0442\u044f\u0436\u0435\u043b\u043e \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043b
    \u043d\u043e\u0432\u043e\u0435 \u0431\u0435\u0437\u0443\u043c\u0438\u0435 \u0432\u043e\u0439\u043d\u044b.
    \u0412 1939 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    62 \u043b\u0435\u0442, \u043e\u043d \u043f\u0435\u0440\u0435\u043d\u0435\u0441 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u044b\u0439
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f, \u043f\u043e\u0441\u043b\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0435\u0433\u043e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438 \u0443\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e \u0443\u0445\u0443\u0434\u0448\u0430\u0442\u044c\u0441\u044f.
    - \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb:
    \u0412 1940 \u0433\u043e\u0434\u0443, \u043d\u0430 \u043f\u0438\u043a\u0435 \u043e\u0442\u0447\u0430\u044f\u043d\u0438\u044f,
    \u0425\u0430\u0440\u0434\u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u044e
    \u0441\u0430\u043c\u0443\u044e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0443\u044e \u043d\u0435-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u2014 \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb (A Mathematician's Apology).
    \u042d\u0442\u043e \u044d\u0441\u0441\u0435, \u043f\u0440\u043e\u043d\u0438\u0437\u0430\u043d\u043d\u043e\u0435
    \u043c\u0435\u043b\u0430\u043d\u0445\u043e\u043b\u0438\u0435\u0439, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0437\u0430\u0449\u0438\u0442\u043e\u0439
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u043c \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0412 \u043d\u0435\u043c \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0442\u0435\u0437\u0438\u0441:
    \"\u042f \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0434\u0435\u043b\u0430\u043b
    \u043d\u0438\u0447\u0435\u0433\u043e '\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0433\u043e'.
    \u041d\u0438 \u043e\u0434\u043d\u043e \u043c\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043d\u0435 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e \u0438 \u043d\u0435 \u043c\u043e\u0433\u043b\u043e
    \u0431\u044b \u043f\u0440\u0438\u043d\u0435\u0441\u0442\u0438, \u044f\u0432\u043d\u043e
    \u0438\u043b\u0438 \u043d\u0435\u044f\u0432\u043d\u043e, \u043a \u0434\u043e\u0431\u0440\u0443
    \u0438\u043b\u0438 \u043a\u043e \u0437\u043b\u0443, \u043d\u0438 \u043c\u0430\u043b\u0435\u0439\u0448\u0435\u0433\u043e
    \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0431\u043b\u0430\u0433\u043e\u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0435
    \u044d\u0442\u043e\u0433\u043e \u043c\u0438\u0440\u0430\". \u041e\u043d \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435
    \u0432\u0435\u0440\u0438\u043b, \u0447\u0442\u043e \u0438\u0441\u0442\u0438\u043d\u043d\u0430\u044f
    \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u0432 \u0435\u0435 \u043a\u0440\u0430\u0441\u043e\u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b \u0441 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u044c\u044e
    \u0438 \u043f\u043e\u044d\u0437\u0438\u0435\u0439, \u0438 \u0447\u0442\u043e \u043f\u043e\u043b\u0435\u0437\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 (\u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0430\u044f)
    \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u0432\u0430\u0435\u0442 \"\u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u043e\u0439\"
    \u0438 \"\u0443\u0440\u043e\u0434\u043b\u0438\u0432\u043e\u0439\". - \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b: \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u043c
    \u0430\u0442\u0435\u0438\u0441\u0442\u043e\u043c, \u043d\u043e \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u0430 \u043e\u0441\u043e\u0431\u0430\u044f \"\u0438\u0433\u0440\u0430
    \u0441 \u0411\u043e\u0433\u043e\u043c\". \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044f\u0441\u044c \u0438\u0437 \u0414\u0430\u043d\u0438\u0438,
    \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u043e\u0442\u043a\u0440\u044b\u0442\u043a\u0443,
    \u0447\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0420\u0438\u043c\u0430\u043d\u0430, \u0441\u0447\u0438\u0442\u0430\u044f, \u0447\u0442\u043e
    \u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0441\u0442 \u0435\u043c\u0443 \u0443\u0442\u043e\u043d\u0443\u0442\u044c,
    \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u043b\u0438\u0448\u0438\u0442\u044c \u043c\u0438\u0440
    \u0442\u0430\u043a\u043e\u0439 \u0441\u043b\u0430\u0432\u044b. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0431\u0440\u0430\u043b \u0441 \u0441\u043e\u0431\u043e\u0439 \u043d\u0430 \u043a\u0440\u0438\u043a\u0435\u0442\u043d\u044b\u0435
    \u043c\u0430\u0442\u0447\u0438 \u00ab\u0430\u043d\u0442\u0438-\u0431\u043e\u0436\u044c\u044e
    \u0431\u0430\u0442\u0430\u0440\u0435\u044e\u00bb (\u0441\u0432\u0438\u0442\u0435\u0440\u0430,
    \u0437\u043e\u043d\u0442 \u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0434\u043b\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b), \u043f\u043e\u043b\u0430\u0433\u0430\u044f, \u0447\u0442\u043e
    \u0411\u043e\u0433 \u043f\u043e\u0448\u043b\u0435\u0442 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u0443\u044e
    \u043f\u043e\u0433\u043e\u0434\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u0435\u0448\u0430\u0442\u044c
    \u0435\u043c\u0443 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c. - \u0421\u043c\u0435\u0440\u0442\u044c
    \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b: \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u043d\u0435\u0434\u0435\u043b\u0438 \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u0431\u044b\u043b
    \u0440\u0430\u0434 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0432\u044b\u0441\u0448\u0443\u044e
    \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u2014 \u043c\u0435\u0434\u0430\u043b\u044c \u041a\u043e\u043f\u043b\u0438 (1947). \u0414\u043e
    \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043c\u0435\u0434\u0430\u043b\u0438
    (1920), \u043c\u0435\u0434\u0430\u043b\u0438 \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u0430
    (1940), \u043c\u0435\u0434\u0430\u043b\u0438 \u0414\u0435 \u041c\u043e\u0440\u0433\u0430\u043d\u0430
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (1929) \u0438 \u0438\u0437\u0431\u0440\u0430\u043d
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u0410\u041d \u0421\u0421\u0421\u0420. \u0425\u0430\u0440\u0434\u0438 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    1 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1947 \u0433\u043e\u0434\u0430 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435.\n\n\U0001F4DD
    \u041b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b - \u042d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c:
    \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u043a\u0440\u0430\u0439\u043d\u0435 \u0437\u0430\u0441\u0442\u0435\u043d\u0447\u0438\u0432
    \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u043d. \u041e\u043d
    \u0442\u0435\u0440\u043f\u0435\u0442\u044c \u043d\u0435 \u043c\u043e\u0433 \u0441\u0432\u043e\u0435
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0438, \u0432\u043e\u0439\u0434\u044f
    \u0432 \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0447\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440,
    \u043f\u0435\u0440\u0432\u044b\u043c \u0434\u0435\u043b\u043e\u043c \u043d\u0430\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043b
    \u043f\u043e\u043b\u043e\u0442\u0435\u043d\u0446\u0435 \u043d\u0430 \u0432\u0441\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b,
    \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0440\u043e\u0432\u0430\u043b\u0438,
    \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u0432\u0441\u0435\u0433\u043e \u043f\u044f\u0442\u044c
    \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445 \u0441\u043d\u0438\u043c\u043a\u043e\u0432.
    - \u0421\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u043a\u0440\u0438\u043a\u0435\u0442\u0443:
    \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e
    \u0432\u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0434\u043b\u044f
    \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u043a\u0440\u0438\u043a\u0435\u0442.
    \u041e\u043d \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0431\u043e\u043b\u0435\u043b\u044c\u0449\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u043c
    \u0438 \u0442\u043e\u043d\u043a\u0438\u043c \u0437\u043d\u0430\u0442\u043e\u043a\u043e\u043c
    \u044d\u0442\u043e\u0439 \u0438\u0433\u0440\u044b. \u0415\u0433\u043e \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0434\u043d\u044f \u0431\u044b\u043b\u043e \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u043e
    \u043a\u0440\u0438\u043a\u0435\u0442\u043d\u043e\u043c\u0443 \u0441\u0435\u0437\u043e\u043d\u0443.
    - \u0412\u0437\u0433\u043b\u044f\u0434\u044b: \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b
    \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u043c \u0430\u0442\u0435\u0438\u0441\u0442\u043e\u043c
    \u0438 \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u043e\u043c. \u041e\u043d \u0441\u0438\u043c\u043f\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0431\u0435\u0434\u043d\u044b\u043c \u0438 \u043d\u0435\u0434\u043e\u043b\u044e\u0431\u043b\u0438\u0432\u0430\u043b
    \u00ab\u043d\u0430\u0434\u0443\u0442\u044b\u0445\u00bb \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u0435\u0439
    \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u0442\u0435\u0431\u043b\u0438\u0448\u043c\u0435\u043d\u0442\u0430
    \u2014 \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u043e\u0432, \u0441\u0443\u0434\u0435\u0439
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0432. \u0414\u043e\u043b\u0433\u0438\u0435
    \u0433\u043e\u0434\u044b \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u0441\u0441\u043e\u0446\u0438\u0430\u0446\u0438\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u043e\u0432, \u043f\u043e \u0441\u0443\u0442\u0438,
    \u043f\u0440\u043e\u0444\u0441\u043e\u044e\u0437\u0430 \u0443\u0447\u0435\u043d\u044b\u0445.
    - \u0412\u043a\u043b\u0430\u0434 \u0432 \u0433\u0435\u043d\u0435\u0442\u0438\u043a\u0443:
    \u0412 1908 \u0433\u043e\u0434\u0443 \u0425\u0430\u0440\u0434\u0438 \u0432\u044b\u0432\u0435\u043b
    \u0431\u0430\u0437\u043e\u0432\u044b\u0439 \u0437\u0430\u043a\u043e\u043d \u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0433\u0435\u043d\u0435\u0442\u0438\u043a\u0438, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043a\u0430\u043a \u0437\u0430\u043a\u043e\u043d \u0425\u0430\u0440\u0434\u0438-\u0412\u0430\u0439\u043d\u0431\u0435\u0440\u0433\u0430,
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0433\u0435\u043d\u043e\u0432 \u0432 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u0438.
    \u0421\u0430\u043c \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b \u044d\u0442\u0443
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439,
    \u043d\u043e \u0434\u043b\u044f \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u043e\u043d\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0413\u043e\u0434\u0444\u0440\u0438 \u0425\u0430\u0440\u043e\u043b\u0434\u0430
    \u0425\u0430\u0440\u0434\u0438 \u2014 \u044d\u0442\u043e \u043a\u043b\u0430\u0434\u0435\u0437\u044c
    \u043f\u0440\u0438\u0447\u0443\u0434, \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0445
    \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439. \u041e\u043d \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u0430\u044f \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u044f \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432 \u043e \u00ab\u043a\u043e\u0440\u043e\u043b\u0435 \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb. 1.\n\n\U0001F3AD \u041f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u044c \u043a \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0432\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u0438 \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0435\u0433\u043e
    \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u044c. \u0425\u0430\u0440\u0434\u0438
    \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u043b \u043f\u043e\u0447\u0442\u0438 \u043c\u0430\u043d\u0438\u0430\u043a\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043a \u0441\u0432\u043e\u0435\u043c\u0443
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044e. \u0412\u043e\u0439\u043d\u0430 \u0441
    \u0437\u0435\u0440\u043a\u0430\u043b\u0430\u043c\u0438: \u0412\u0445\u043e\u0434\u044f \u0432
    \u043b\u044e\u0431\u043e\u0439 \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0447\u043d\u044b\u0439
    \u043d\u043e\u043c\u0435\u0440 \u0438\u043b\u0438 \u043d\u043e\u0432\u0443\u044e \u043a\u043e\u043c\u043d\u0430\u0442\u0443,
    \u043e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u0434\u0435\u043b\u043e\u043c \u043c\u0435\u0442\u043e\u0434\u0438\u0447\u043d\u043e
    \u043d\u0430\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043b \u043f\u043e\u043b\u043e\u0442\u0435\u043d\u0446\u0430,
    \u043f\u043b\u0430\u0442\u043a\u0438 \u0438\u043b\u0438 \u043b\u044e\u0431\u0443\u044e \u0442\u043a\u0430\u043d\u044c
    \u043d\u0430 \u0432\u0441\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u0431\u0435\u0437
    \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f. \u041e\u043d \u043d\u0435
    \u043c\u043e\u0433 \u0432\u044b\u043d\u043e\u0441\u0438\u0442\u044c \u0432\u0438\u0434\u0430
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043b\u0438\u0446\u0430.
    \u0424\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438: \u042d\u0442\u0430 \u043d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u044c
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u043b\u0430\u0441\u044c
    \u0438 \u043d\u0430 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u041e\u043d
    \u0438\u0437\u0431\u0435\u0433\u0430\u043b \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043e\u0432
    \u0441 \u0442\u0430\u043a\u0438\u043c \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u043e\u043c,
    \u0447\u0442\u043e \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u0432\u0441\u0435\u0433\u043e \u043f\u044f\u0442\u044c \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445
    \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0439 \u0425\u0430\u0440\u0434\u0438,
    \u0438 \u043d\u0438 \u043e\u0434\u043d\u043e\u0439 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0442\u0443\u0434\u0438\u0439\u043d\u043e\u0439. 2.\n\n\U0001F64F \u0410\u0442\u0435\u0438\u0441\u0442,
    \u0438\u0433\u0440\u0430\u0432\u0448\u0438\u0439 \u0441 \u0411\u043e\u0433\u043e\u043c \u0425\u0430\u0440\u0434\u0438
    \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0438 \u0434\u0430\u0436\u0435
    \u0432\u043e\u0438\u043d\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c \u0430\u0442\u0435\u0438\u0441\u0442\u043e\u043c.
    \u041e\u043d \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043f\u043e\u0441\u0435\u0449\u0430\u0442\u044c
    \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u044b\u0435 \u0441\u043b\u0443\u0436\u0431\u044b
    \u043f\u043e \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u043e\u0432\u043e\u0434\u0430\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u0430\u0442\u0435\u0438\u0437\u043c
    \u0431\u044b\u043b \u043d\u0435 \u0441\u043a\u0443\u0447\u043d\u044b\u043c \u043e\u0442\u0440\u0438\u0446\u0430\u043d\u0438\u0435\u043c,
    \u0430 \u0432\u0435\u0441\u0435\u043b\u043e\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0438\u0433\u0440\u043e\u0439. \u041e\u043d \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b
    \u0441\u043b\u043e\u0436\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043f\u0430\u0440\u0438
    \u0441 \u041d\u0435\u0431\u0435\u0441\u0430\u043c\u0438: \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u0438\u0437 \u0414\u0430\u043d\u0438\u0438: \u041f\u043e\u0441\u043b\u0435 \u0432\u0438\u0437\u0438\u0442\u0430
    \u043a \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c \u0432 \u041a\u043e\u043f\u0435\u043d\u0433\u0430\u0433\u0435\u043d,
    \u043f\u0435\u0440\u0435\u0434 \u043e\u0442\u043f\u043b\u044b\u0442\u0438\u0435\u043c \u043d\u0430
    \u043a\u043e\u0440\u0430\u0431\u043b\u0435, \u0425\u0430\u0440\u0434\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b
    \u0432 \u0410\u043d\u0433\u043b\u0438\u044e \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c\u043c\u0443
    \u0441\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0438: \u00ab\u042f \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u0420\u0438\u043c\u0430\u043d\u0430\u00bb.
    \u041e\u043d \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u043b \u0442\u0430\u043a:
    \u0435\u0441\u043b\u0438 \u0411\u043e\u0433 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442,
    \u041e\u043d \u043d\u0435 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u0442, \u0447\u0442\u043e\u0431\u044b
    \u043a\u043e\u0440\u0430\u0431\u043b\u044c \u0437\u0430\u0442\u043e\u043d\u0443\u043b, \u0438\u0431\u043e
    \u0442\u043e\u0433\u0434\u0430 \u043c\u0438\u0440 \u043b\u0438\u0448\u0438\u0442\u0441\u044f
    \u0441\u043b\u0430\u0432\u044b \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430.
    \u041a\u043e\u0440\u0430\u0431\u043b\u044c, \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0442\u0441\u044f,
    \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u043d\u043e \u043f\u0440\u0438\u0431\u044b\u043b
    \u0432 \u043f\u043e\u0440\u0442. \u00ab\u0410\u043d\u0442\u0438-\u0431\u043e\u0436\u044c\u044f
    \u0431\u0430\u0442\u0430\u0440\u0435\u044f\u00bb: \u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044f\u0441\u044c
    \u043d\u0430 \u0441\u0442\u0430\u0434\u0438\u043e\u043d \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u043a\u0440\u0438\u043a\u0435\u0442 (\u0435\u0433\u043e \u0432\u0442\u043e\u0440\u0443\u044e
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c), \u0425\u0430\u0440\u0434\u0438 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u0440\u0430\u043b \u0441 \u0441\u043e\u0431\u043e\u0439 \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0443\u043f\u0430\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u043e\u0440\u0442\u0444\u0435\u043b\u044c
    \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044f\u043c\u0438, \u0437\u043e\u043d\u0442 \u0438
    \u0448\u0435\u0440\u0441\u0442\u044f\u043d\u043e\u0439 \u0441\u0432\u0438\u0442\u0435\u0440.
    \u041e\u043d \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b \u044d\u0442\u043e \u0442\u0430\u043a:
    \u0435\u0441\u043b\u0438 \u0411\u043e\u0433 \u0435\u0441\u0442\u044c \u0438 \u0445\u043e\u0447\u0435\u0442
    \u043f\u043e\u043c\u0435\u0448\u0430\u0442\u044c \u0435\u043c\u0443 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c,
    \u041e\u043d \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0448\u043b\u0435\u0442
    \u0434\u043e\u0436\u0434\u044c, \u0447\u0442\u043e\u0431\u044b \u0425\u0430\u0440\u0434\u0438
    \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0434\u043e\u043c\u0430 \u0438 \u0441\u0435\u043b
    \u0437\u0430 \u0441\u0442\u043e\u043b. \u0411\u0435\u0440\u044f \u0441 \u0441\u043e\u0431\u043e\u0439
    \u0437\u043e\u043d\u0442 \u0438 \u0441\u0432\u0438\u0442\u0435\u0440, \u0425\u0430\u0440\u0434\u0438
    \u043a\u0430\u043a \u0431\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043b: \u00ab\u042f
    \u0433\u043e\u0442\u043e\u0432 \u043a \u0434\u043e\u0436\u0434\u044e, \u0442\u0430\u043a
    \u0447\u0442\u043e \u0434\u0430\u0432\u0430\u0439, \u0413\u043e\u0441\u043f\u043e\u0434\u0438,
    \u0434\u0435\u043b\u0430\u0439 \u0441\u0432\u043e\u044e \u043f\u043e\u0433\u043e\u0434\u0443
    \u2014 \u044f \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0431\u0443\u0434\u0443
    \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0442\u044c\u0441\u044f \u043c\u0430\u0442\u0447\u0435\u043c\u00bb.
    3.\n\n\U0001F3CF \u0412\u0442\u043e\u0440\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u2014
    \u043a\u0440\u0438\u043a\u0435\u0442 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u043e\u0439 \u0438
    \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e,
    \u043d\u043e \u043a\u0440\u0438\u043a\u0435\u0442 \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u0442\u0432\u0435\u0440\u0434\u043e\u0435 \u0432\u0442\u043e\u0440\u043e\u0435 \u043c\u0435\u0441\u0442\u043e.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a-\u0441\u043f\u043e\u0440\u0442\u0441\u043c\u0435\u043d:
    \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0431\u043e\u043b\u0435\u043b\u044c\u0449\u0438\u043a\u043e\u043c, \u043e\u043d \u0441\u0430\u043c
    \u0438\u0433\u0440\u0430\u043b \u0432 \u043a\u0440\u0438\u043a\u0435\u0442 \u043d\u0430
    \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u043b\u0438\u0447\u043d\u043e\u043c
    \u0443\u0440\u043e\u0432\u043d\u0435. \u041e\u043d \u0431\u044b\u043b \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u043c
    \u043f\u043e\u043b\u0435\u0432\u044b\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u043c \u0438
    \u0431\u044d\u0442\u0441\u043c\u0435\u043d\u043e\u043c \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0447\u0430\u0445 \u0434\u0430\u0436\u0435 \u0432 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e
    \u0437\u0440\u0435\u043b\u043e\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435. \u042d\u043a\u0441\u043f\u0435\u0440\u0442:
    \u041e\u043d \u0437\u043d\u0430\u043b \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443
    \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0438\u0433\u0440\u044b \u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u044c\u043d\u043e.
    \u0421\u0432\u043e\u0438\u043c \u0434\u0440\u0443\u0437\u044c\u044f\u043c (\u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u041a\u0435\u0439\u043d\u0441\u0430 \u0438 \u041b\u0438\u0442\u043b\u0432\u0443\u0434\u0430)
    \u043e\u043d \u0447\u0430\u0441\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0432 \u0436\u0438\u0437\u043d\u0438 \u0435\u0441\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e
    \u0434\u0432\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0445 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f:
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u0445\u043e\u0440\u043e\u0448\u0438\u0439 \u043a\u0440\u0438\u043a\u0435\u0442. \u0420\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435:
    \u041f\u043b\u0430\u043d\u0438\u0440\u0443\u044f \u0441\u0432\u043e\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443, \u043e\u043d \u0432\u0441\u0435\u0433\u0434\u0430
    \u0441\u0432\u0435\u0440\u044f\u043b\u0441\u044f \u0441 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u0435\u043c
    \u043a\u0440\u0438\u043a\u0435\u0442\u043d\u044b\u0445 \u043c\u0430\u0442\u0447\u0435\u0439.
    \u041b\u0435\u0442\u043d\u0438\u0435 \u0441\u0435\u043c\u0435\u0441\u0442\u0440\u044b \u0431\u044b\u043b\u0438
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043c\u0435\u043d\u0435\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b
    \u0432 \u043f\u043b\u0430\u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d \u0432\u0441\u0435
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b
    \u043d\u0430 \u0441\u0442\u0430\u0434\u0438\u043e\u043d\u0435 \u00ab\u041b\u043e\u0440\u0434\u0441\u00bb.
    4.\n\n\U0001F91D \u0421\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e \u0438 12 \u0431\u0430\u043b\u043b\u043e\u0432 \u0418\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430
    \u043f\u043e\u043b\u043d\u0430 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0437\u043c\u0430.
    \u0425\u0430\u0440\u0434\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0438\u0441\u044c\u043c\u043e
    \u043e\u0442 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u043a\u043b\u0435\u0440\u043a\u0430
    \u0441 \u0432\u043e\u0440\u043e\u0445\u043e\u043c \u0444\u043e\u0440\u043c\u0443\u043b.
    \u041c\u043d\u043e\u0433\u0438\u0435 \u0438\u0437 \u043d\u0438\u0445 \u0431\u044b\u043b\u0438
    \u043d\u0435\u0432\u0435\u0440\u043d\u044b \u0438\u043b\u0438 \u043f\u043b\u043e\u0445\u043e
    \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u044b. \u041e\u0434\u043d\u0430\u043a\u043e \u0425\u0430\u0440\u0434\u0438
    \u043d\u0435 \u0432\u044b\u0431\u0440\u043e\u0441\u0438\u043b \u043f\u0438\u0441\u044c\u043c\u043e.
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u041b\u0438\u0442\u043b\u0432\u0443\u0434\u043e\u043c
    \u043e\u043d\u0438 \u0441\u0442\u0430\u043b\u0438 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044c
    \u0435\u0433\u043e \u0438 \u043d\u0430\u0442\u043a\u043d\u0443\u043b\u0438\u0441\u044c \u043d\u0430
    \u043e\u0434\u043d\u0443 \u0444\u043e\u0440\u043c\u0443\u043b\u0443, \u043a\u0430\u0441\u0430\u044e\u0449\u0443\u044e\u0441\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445 \u0440\u044f\u0434\u043e\u0432.
    \u0425\u0430\u0440\u0434\u0438 \u043f\u043e\u0437\u0436\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0441\u044f,
    \u0447\u0442\u043e \u043e\u0434\u043d\u043e\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u0430
    \u043d\u0430 \u044d\u0442\u0443 \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0431\u044b\u043b\u043e
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u043d\u044f\u0442\u044c \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0430\u0432\u0442\u043e\u0440\u0430. \u041e\u043d \u043d\u0435 \u0432\u0438\u0434\u0435\u043b
    \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b \u0441\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d \u042d\u0439\u043b\u0435\u0440\u0430 \u0438 \u042f\u043a\u043e\u0431\u0438.
    \u0425\u0430\u0440\u0434\u0438 \u043e\u0446\u0435\u043d\u0438\u043b \u0442\u0430\u043b\u0430\u043d\u0442
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430 \u00ab\u043f\u043e \u0448\u043a\u0430\u043b\u0435
    \u043e\u0442 0 \u0434\u043e 100 \u0432 12 \u0431\u0430\u043b\u043b\u043e\u0432\u00bb (\u043e\u043d
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e \u0413\u0430\u0443\u0441\u0441
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0431\u044b 100, \u042d\u0439\u043b\u0435\u0440
    \u2014 90, \u0430 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d \u2014 100,
    \u043d\u043e \u0438\u0437-\u0437\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u2014 50). \u041f\u043e\u0437\u0436\u0435
    \u043e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u2014 \u044d\u0442\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430.
    5.\n\n\U0001F691 \u0422\u0430\u043a\u0441\u0438 \u0438 \u0447\u0438\u0441\u043b\u043e 1729
    \u0421\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0431\u0430\u0439\u043a\u0430
    \u043e \u0425\u0430\u0440\u0434\u0438 \u0438 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0435.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0425\u0430\u0440\u0434\u0438 \u043d\u0430\u0432\u0435\u0449\u0430\u043b
    \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430
    \u0432 \u0441\u0430\u043d\u0430\u0442\u043e\u0440\u0438\u0438 \u0432 \u041f\u0430\u0442\u043d\u0438.
    \u041f\u043e\u0434\u044a\u0435\u0437\u0436\u0430\u044f \u043d\u0430 \u0442\u0430\u043a\u0441\u0438,
    \u0425\u0430\u0440\u0434\u0438 \u043e\u0442\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e
    \u043d\u043e\u043c\u0435\u0440 \u043c\u0430\u0448\u0438\u043d\u044b \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c
    \u0441\u043a\u0443\u0447\u043d\u044b\u043c \u2014 1729. \u0412\u043e\u0439\u0434\u044f \u0432
    \u043f\u0430\u043b\u0430\u0442\u0443, \u043e\u043d \u0441\u043a\u0430\u0437\u0430\u043b
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0443: \u00ab\u041c\u043d\u0435
    \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u044d\u0442\u043e \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e
    \u0441\u043a\u0443\u0447\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e\u00bb. \u041d\u0430
    \u0447\u0442\u043e \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439 \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b, \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u041d\u0435\u0442, \u0425\u0430\u0440\u0434\u0438, \u044d\u0442\u043e \u043e\u0447\u0435\u043d\u044c
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e!
    \u042d\u0442\u043e \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0435 \u0447\u0438\u0441\u043b\u043e,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0440\u0430\u0437\u0438\u0442\u044c
    \u043a\u0430\u043a \u0441\u0443\u043c\u043c\u0443 \u0434\u0432\u0443\u0445 \u043a\u0443\u0431\u043e\u0432
    \u0434\u0432\u0443\u043c\u044f \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438\u00bb.
    \u0422\u043e \u0435\u0441\u0442\u044c: \\( 1^3 + 12^3 = 1729 \\) \\( 9^3 + 10^3 = 1729 \\)
    \u0421 \u0442\u0435\u0445 \u043f\u043e\u0440 \u0447\u0438\u0441\u043b\u043e 1729 \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043a\u0430\u043a \u00ab\u0447\u0438\u0441\u043b\u043e \u0425\u0430\u0440\u0434\u0438 \u2014
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430\u00bb (\u0438\u043b\u0438
    \u0442\u0430\u043a\u0441\u0438-\u0447\u0438\u0441\u043b\u043e). 6.\n\n\U0001F4DA \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f\u00bb
    \u043a\u0430\u043a \u043f\u0440\u0435\u0434\u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e \u0425\u0430\u0440\u0434\u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u043a\u043d\u0438\u0433\u0443
    \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb
    \u0432 1940 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0435\u043c\u0443
    \u0431\u044b\u043b\u043e 62 \u0433\u043e\u0434\u0430. \u041e\u043d \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b
    \u0441\u0432\u043e\u044e \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u044c \u0438 \u0443\u0433\u0430\u0441\u0430\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439
    \u0441 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0439 \u043e\u0441\u0442\u0440\u043e\u0442\u043e\u0439.
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441\u0442\u0430\u0440\u0435\u044e\u0442 \u0440\u0430\u043d\u044c\u0448\u0435 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0443\u0447\u0435\u043d\u044b\u0445, \u0438 \u0438\u0445 \u043b\u0443\u0447\u0448\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442\u0441\u044f
    \u043d\u0430 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u044c. \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u044d\u0442\u0443 \u043a\u043d\u0438\u0433\u0443 \u043a\u0430\u043a \u043f\u0440\u043e\u0449\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e, \u043f\u043e\u043b\u0430\u0433\u0430\u044f, \u0447\u0442\u043e
    \u044d\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c
    \u0441\u043b\u043e\u0432\u043e\u043c \u043f\u0435\u0440\u0435\u0434 \u0443\u0445\u043e\u0434\u043e\u043c
    \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 (\u0445\u043e\u0442\u044f \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b
    \u0435\u0449\u0435 7 \u043b\u0435\u0442). \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u043a\u043d\u0438\u0433\u0430 \u043f\u0440\u043e\u043d\u0438\u0437\u0430\u043d\u0430 \u0442\u0430\u043a\u0438\u043c
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c \u043f\u0435\u0441\u0441\u0438\u043c\u0438\u0437\u043c\u043e\u043c
    \u0438 \u043c\u0435\u043b\u0430\u043d\u0445\u043e\u043b\u0438\u0435\u0439. \u041e\u043d
    \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b \u0441\u0435\u0431\u044f \u0441\u043e
    \u0441\u0442\u0430\u0440\u0435\u044e\u0449\u0438\u043c \u0441\u043f\u043e\u0440\u0442\u0441\u043c\u0435\u043d\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u0436\u0435 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043b\u0443\u0447\u0448\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442.
    7.\n\n\U0001F4BC \u041f\u0435\u0434\u0430\u043d\u0442\u0438\u0437\u043c \u0432 \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0438
    \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u043e\u0434\u0435\u0440\u0436\u0438\u043c
    \u0440\u0430\u0441\u043f\u043e\u0440\u044f\u0434\u043a\u043e\u043c \u0434\u043d\u044f. \u041e\u043d
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043d\u043e\u0441\u0438\u043b \u0447\u0430\u0441\u043e\u0432,
    \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0437\u043d\u0430\u043b \u0432\u0440\u0435\u043c\u044f
    \u0441 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e \u043c\u0438\u043d\u0443\u0442\u044b
    \u043f\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044e \u0441\u0432\u043e\u0435\u0433\u043e
    \u0442\u0435\u043b\u0430 \u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u043c
    \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f\u043c. \u0413\u043e\u0432\u043e\u0440\u044f\u0442,
    \u043e\u043d \u043c\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u043a\u043e\u043b\u043b\u0435\u0433\u0435:
    \u00ab\u0421\u0435\u0439\u0447\u0430\u0441 \u0440\u043e\u0432\u043d\u043e 3:15\u00bb, \u2014
    \u0438 \u0447\u0430\u0441\u044b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u0438
    \u044d\u0442\u043e. \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435
    \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u043c,
    \u0441\u0447\u0438\u0442\u0430\u044f \u044d\u0442\u043e \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u0435\u043c
    \u0432 \u043b\u0438\u0447\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e.
    \u0412\u0441\u044e \u0441\u0432\u043e\u044e \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0446\u0438\u044e
    \u043e\u043d \u0432\u0435\u043b \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0447\u0435\u0440\u0435\u0437 \u043f\u0438\u0441\u044c\u043c\u0430 \u0438 \u0437\u0430\u043f\u0438\u0441\u043a\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043b
    \u0447\u0435\u0440\u0435\u0437 \u0441\u043b\u0443\u0433 \u0438\u043b\u0438 \u043a\u043e\u043b\u043b\u0435\u0433.
    8.\n\n\U0001F3AF \u041f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0441\u0442\u044c \u0425\u0430\u0440\u0434\u0438
    \u0433\u043e\u0440\u0434\u0438\u043b\u0441\u044f \u0442\u0435\u043c, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u0430 \u0434\u043b\u044f \u0432\u043e\u0435\u043d\u043d\u044b\u0445
    \u0438 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0445 \u043d\u0443\u0436\u0434.
    \u041a\u043e\u0433\u0434\u0430 \u0432 \u041f\u0435\u0440\u0432\u0443\u044e \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0432\u043e\u0439\u043d\u0443 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041b\u044e\u0434\u0432\u0438\u0433 \u041f\u0440\u0430\u043d\u0434\u0442\u043b\u044c \u043d\u0430\u0447\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430 \u0432\u043e\u0435\u043d\u043d\u0443\u044e
    \u0430\u0432\u0438\u0430\u0446\u0438\u044e, \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b
    \u0432 \u0443\u0436\u0430\u0441\u0435. \u041e\u043d \u0440\u0430\u0434\u043e\u0432\u0430\u043b\u0441\u044f,
    \u0447\u0442\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b \u043d\u0435\u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u0430
    \u0432 \u0431\u0430\u043b\u043b\u0438\u0441\u0442\u0438\u043a\u0435. \u0410\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u0442\u0430\u043b\u043e
    \u0442\u043e, \u0447\u0442\u043e \u0432 \u0433\u043e\u0434\u044b \u0412\u0442\u043e\u0440\u043e\u0439
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b \u0435\u0433\u043e
    \u043b\u044e\u0431\u0438\u043c\u0443\u044e \u00ab\u0447\u0438\u0441\u0442\u0443\u044e\u00bb
    \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b \u043d\u0430\u0447\u0430\u043b\u0438
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0434\u043b\u044f \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    (\u0432\u0437\u043b\u043e\u043c \u043a\u043e\u0434\u0430 \u00ab\u042d\u043d\u0438\u0433\u043c\u044b\u00bb).
    \u0425\u043e\u0442\u044f \u0441\u0430\u043c \u043e\u043d \u043d\u0435 \u0438\u043c\u0435\u043b
    \u043a \u044d\u0442\u043e\u043c\u0443 \u043f\u0440\u044f\u043c\u043e\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f,
    \u0441\u0430\u043c \u0444\u0430\u043a\u0442 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u043f\u043e\u0448\u043b\u0438 \u043d\u0430 \u043f\u043e\u043b\u044c\u0437\u0443 \u0432\u043e\u0435\u043d\u043d\u044b\u043c,
    \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b \u0435\u0433\u043e \u0432 \u043e\u0442\u0447\u0430\u044f\u043d\u0438\u0435.
    9.\n\n\U0001F393 \u0415\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0438 \u0425\u0430\u0440\u0434\u0438
    \u0431\u044b\u043b \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c,
    \u043d\u043e \u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u043d\u0430 \u0441\u0432\u043e\u0438\u0445
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445. \u041e\u043d \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b
    \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u044b (\u0422\u0440\u0438\u043f\u043e\u0441),
    \u0441\u0447\u0438\u0442\u0430\u044f \u0438\u0445 \u00ab\u043e\u0445\u043e\u0442\u043e\u0439
    \u043d\u0430 \u043a\u0440\u044b\u0441\u00bb, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d \u0440\u0435\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f,
    \u0441\u0434\u0435\u043b\u0430\u0432 \u0435\u0435 \u0431\u043e\u043b\u0435\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0439.
    \u0421\u0440\u0435\u0434\u0438 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0431\u044b\u043b\u0430 \u041c\u044d\u0440\u0438 \u041a\u0430\u0440\u0442\u0440\u0430\u0439\u0442
    \u2014 \u043e\u0434\u043d\u0430 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0436\u0435\u043d\u0449\u0438\u043d-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u0434\u043e\u0431\u0438\u0432\u0448\u0438\u0445\u0441\u044f \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439 \u2014 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0425\u0430\u0440\u0434\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f
    \u043a \u043d\u0435\u0439 \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0432 \u0442\u0435 \u0433\u043e\u0434\u044b \u0436\u0435\u043d\u0449\u0438\u043d\u044b-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0431\u044b\u043b\u0438 \u0440\u0435\u0434\u043a\u043e\u0441\u0442\u044c\u044e. 10.\n\n\U0001F4D6
    \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f\u00bb \u2014 \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440
    \u041c\u0430\u043b\u043e \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e
    \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb
    \u0441\u0442\u0430\u043b\u0430 \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440\u043e\u043c
    \u043d\u0435 \u0441\u0440\u0435\u0434\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u0430 \u0441\u0440\u0435\u0434\u0438 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432. \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c
    \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0439 \u043f\u0440\u043e\u0437\u044b
    XX \u0432\u0435\u043a\u0430. \u0415\u0435 \u0445\u0432\u0430\u043b\u0438\u043b\u0438 \u0437\u0430
    \u0441\u0442\u0438\u043b\u044c, \u0438\u0440\u043e\u043d\u0438\u044e \u0438 \u0447\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c.
    \u0421\u0430\u043c \u0425\u0430\u0440\u0434\u0438, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u043c, \u0431\u044b\u043b \u0431\u044b \u0443\u0434\u0438\u0432\u043b\u0435\u043d,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u0447\u0438\u0442\u0430\u044e\u0442
    \u043b\u044e\u0434\u0438, \u0434\u0430\u043b\u0435\u043a\u0438\u0435 \u043e\u0442 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432
    \u0438 \u0440\u044f\u0434\u043e\u0432. \u042d\u0442\u0430 \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u044f
    \u0444\u0430\u043a\u0442\u043e\u0432 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0425\u0430\u0440\u0434\u0438 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u00ab\u0441\u0443\u0445\u0438\u043c \u0443\u0447\u0435\u043d\u044b\u043c\u00bb, \u0430
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u044b\u043c,
    \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u044b\u043c \u0438 \u0434\u043e \u043a\u0440\u0430\u0439\u043d\u043e\u0441\u0442\u0438
    \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u044e
    \u0436\u0438\u0437\u043d\u044c \u043f\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c,
    \u043e\u0447\u0435\u043d\u044c \u0441\u0442\u0440\u043e\u0433\u0438\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c."
