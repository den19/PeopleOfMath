    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u043e\u0434\u043d\u0430\u043a\u043e
    \u0441 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u043a\u0443\u0440\u0441\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u043b\u0441\u044f
