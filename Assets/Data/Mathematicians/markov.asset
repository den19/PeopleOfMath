    \u043f\u0435\u0440\u0432\u043e\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u043d\u0438\u043a\u043e\u043c
    \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u043b \u0447\u0435\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0432 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u0445
    \u043c\u0430\u0442\u0447\u0430\u0445 \u0441 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u043c. \u0421\u0430\u043c\u044b\u0439
    \u044f\u0440\u043a\u0438\u0439 \u044d\u043f\u0438\u0437\u043e\u0434 \u0435\u0433\u043e \u0448\u0430\u0445\u043c\u0430\u0442\u043d\u043e\u0439
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 \u0431\u043b\u043e\u043a\u0430\u0434\u043d\u043e\u043c \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435.
    \u0412 1942 \u0433\u043e\u0434\u0443, \u0435\u0449\u0435 \u0434\u043e \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u0438,
    \u043e\u043d \u043f\u0440\u0438\u043d\u044f\u043b \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043c \u0410.\u042f. \u041c\u043e\u0434\u0435\u043b\u0435\u043c
    \u0448\u0430\u0445\u043c\u0430\u0442\u043d\u043e\u043c \u0442\u0443\u0440\u043d\u0438\u0440\u0435.
    \u042d\u0442\u043e\u0442 \u0442\u0443\u0440\u043d\u0438\u0440 \u043f\u043e\u0437\u0436\u0435
    \u043d\u0430\u0437\u043e\u0432\u0443\u0442 \"\u0431\u043b\u043e\u043a\u0430\u0434\u043d\u044b\u043c\",
    \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434
    \u0441\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u044b\u043c
    \"\u041c\u0430\u0442\u0447\u0435\u043c \u0436\u0438\u0437\u043d\u0438\". \u041c\u0430\u0440\u043a\u043e\u0432
    \u0434\u043e \u0438\u044e\u043b\u044f 1942 \u0433\u043e\u0434\u0430 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0432 \u043e\u0441\u0430\u0436\u0434\u0435\u043d\u043d\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435
    \u0438 \u043d\u0430\u0448\u0435\u043b \u0432 \u0441\u0435\u0431\u0435 \u0441\u0438\u043b\u044b
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u044d\u0442\u043e\u043c
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u043c
    \u0441\u043e\u0441\u0442\u044f\u0437\u0430\u043d\u0438\u0438, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0432\u0441\u0435 \u0443\u0436\u0430\u0441\u044b \u0431\u043b\u043e\u043a\u0430\u0434\u044b.\n\n\u270d\ufe0f
    \u041f\u043e\u044d\u0442 \u0432 \u043c\u0438\u0440\u0435 \u0444\u043e\u0440\u043c\u0443\u043b
    \u041c\u043b\u0430\u0434\u0448\u0438\u0439 \u041c\u0430\u0440\u043a\u043e\u0432 \u043d\u0435
    \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c
    \u0432 \u0441\u0443\u0445\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0435. \u041e\u043d \u043f\u0438\u0441\u0430\u043b \u0441\u0442\u0438\u0445\u0438.
    \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u043e\u043d\u0438, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0431\u044b\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043b\u0438\u0448\u044c
    \u0443\u0437\u043a\u043e\u043c\u0443 \u043a\u0440\u0443\u0433\u0443, \u043d\u043e \u0432
    2001 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438, \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430 \u0435\u0433\u043e
    \u0441\u0442\u0438\u0445\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0439 \u0431\u044b\u043b\u0430
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430 \u0432 \u0436\u0443\u0440\u043d\u0430\u043b\u0435
    \"\u0417\u0432\u0435\u0437\u0434\u0430\". \u042d\u0442\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442
    \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u0443 \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u0438,
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044f, \u0447\u0442\u043e \u0437\u0430
    \u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430\u043c\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u043c\u0438 \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u044c
    \u0442\u043e\u043d\u043a\u0430\u044f \u0438 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u043d\u0430\u044f
    \u043d\u0430\u0442\u0443\u0440\u0430.\n\n\U0001F3BB \u041c\u0443\u0437\u044b\u043a\u0430\u043d\u0442
    \u0438 \u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c \u0430\u0440\u0445\u0438\u0432\u0430
    \u041f\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432, \u0410\u043d\u0434\u0440\u0435\u0439
    \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447 \u0431\u044b\u043b \u0443\u0432\u043b\u0435\u0447\u0435\u043d
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0447\u043d\u044b\u043c\u0438
    \u043d\u0430\u0443\u043a\u0430\u043c\u0438 \u0438 \u043f\u043e\u044d\u0437\u0438\u0435\u0439,
    \u043d\u043e \u0438 \u043c\u0443\u0437\u044b\u043a\u043e\u0439. \u041e\u043d \u043e\u0431\u043b\u0430\u0434\u0430\u043b
    \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0439
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e, \u0447\u0442\u043e \u0432\u0441\u0435\u0433\u0434\u0430
    \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u043b\u043e \u043a \u043d\u0435\u043c\u0443
    \u043b\u044e\u0434\u0435\u0439. \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043c\u043b\u0430\u0434\u0448\u0438\u0439
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0431\u0435\u0440\u0435\u0436\u043d\u043e \u0445\u0440\u0430\u043d\u0438\u043b \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0439
    \u0430\u0440\u0445\u0438\u0432 \u0441\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430.
    \u0421\u0440\u0435\u0434\u0438 \u0441\u043e\u043a\u0440\u043e\u0432\u0438\u0449 \u0430\u0440\u0445\u0438\u0432\u0430
    \u0431\u044b\u043b\u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b, \u043d\u043e \u0438 \u043e\u0431\u0448\u0438\u0440\u043d\u0430\u044f
    \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0446\u0438\u044f,
    \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043f\u0438\u0441\u044c\u043c\u0430
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445 \u0448\u0430\u0445\u043c\u0430\u0442\u0438\u0441\u0442\u043e\u0432,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u041c\u0438\u0445\u0430\u0438\u043b\u0430
    \u0427\u0438\u0433\u043e\u0440\u0438\u043d\u0430, \u0438 \u0434\u0430\u0436\u0435 \u043f\u0438\u0441\u044c\u043c\u0430
    \u0441\u044b\u043d\u0430 \u041b\u044c\u0432\u0430 \u0422\u043e\u043b\u0441\u0442\u043e\u0433\u043e
    \u2014 \u0421\u0435\u0440\u0433\u0435\u044f.\n\n\U0001F4DD \u0425\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c
    \u043f\u0430\u043c\u044f\u0442\u0438 \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d
    \u0412 1968 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0435 \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e,
    \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u00ab\u041f\u0438\u0441\u044c\u043c\u043e 99\u00bb. \u042d\u0442\u043e \u043f\u0438\u0441\u044c\u043c\u043e,
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u043f\u0440\u043e\u0442\u0438\u0432
    \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438 \u0421\u0442\u0430\u043b\u0438\u043d\u0430
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0439
    \u0432 \u043d\u0430\u0443\u043a\u0435, \u0431\u044b\u043b\u043e \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u043c
    \u0448\u0430\u0433\u043e\u043c \u0434\u043b\u044f \u0447\u043b\u0435\u043d\u0430-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u0430
    \u0410\u041d \u0421\u0421\u0421\u0420. \u041e\u043d \u043d\u0435 \u043f\u043e\u0431\u043e\u044f\u043b\u0441\u044f
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e \u0432\u044b\u0441\u043a\u0430\u0437\u0430\u0442\u044c
    \u0441\u0432\u043e\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0441\u0442\u043e\u0438\u0442 \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e
    \u0432 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u043d\u0435\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439
    \u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u0441\u0435\u043c\u044c\u0435 \u0438\u043b\u0438 \u0431\u044b\u0442\u043e\u0432\u044b\u0445
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u0445. \u041c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u043b\u0438 \u0431\u044b \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c
    \u044d\u0442\u0438 \u0434\u0435\u0442\u0430\u043b\u0438, \u0441\u043a\u043e\u0440\u0435\u0435
    \u0432\u0441\u0435\u0433\u043e, \u0436\u0434\u0443\u0442 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0432 \u0430\u0440\u0445\u0438\u0432\u0430\u0445
    \u0438\u043b\u0438 \u043c\u0435\u043c\u0443\u0430\u0440\u0430\u0445 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433."
