    \u0412\u043a\u043b\u0430\u0434 \u0432 \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0443:
    \u0412 1950-\u0445 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
