  achievementsRu: "\u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432-\u043c\u043b\u0430\u0434\u0448\u0438\u0439 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0441\u043b\u0435\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u043e \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u043b\u0435\u0436\u0438\u0442 \u043d\u0435 \u0432 \u043e\u0434\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438,
    \u0430 \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u0446\u0435\u043b\u043e\u0433\u043e
    \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u044f \u2014 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0442\u0440\u0443\u0434\u043e\u0432.\n\n\U0001F9F1 \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432
    \u0421\u0435\u0440\u0434\u0446\u0435 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430 \u2014 \u044d\u0442\u043e \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432
    \u0438 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e \u043f\u043e\u043d\u044f\u0442\u0438\u044f
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u043e\u0447\u0435\u043d\u044c \u0443\u0434\u0430\u0447\u043d\u043e\u0439
    \u0438 \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u043e\u0439. \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b (\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430): \u0412 \u043a\u043e\u043d\u0446\u0435 1940-\u0445
    \u0433\u043e\u0434\u043e\u0432 \u041c\u0430\u0440\u043a\u043e\u0432 \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430 (\u0438\u043b\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0444\u043c\u0430).
    \u042d\u0442\u043e \u0441\u0442\u0440\u043e\u0433\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043c\u043e\u0434\u0435\u043b\u044c \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438
    \u0441\u0438\u043c\u0432\u043e\u043b\u044c\u043d\u044b\u0445 \u0441\u0442\u0440\u043e\u043a.
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0439, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043c\u0430\u0448\u0438\u043d \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430, \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b \u043d\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u044b
    \u0441 \u043a\u0430\u043a\u0438\u043c-\u043b\u0438\u0431\u043e \u00ab\u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043d\u044b\u043c
    \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u0435\u043c\u00bb (\u043b\u0435\u043d\u0442\u043e\u0439,
    \u043a\u0430\u0440\u0435\u0442\u043a\u043e\u0439) \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442
    \u0441\u043e\u0431\u043e\u0439 \u00ab\u0447\u0438\u0441\u0442\u044b\u0439\u00bb \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c,
    \u0437\u0430\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0439 \u0430\u043b\u0444\u0430\u0432\u0438\u0442\u043e\u043c
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u043f\u043e\u0434\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a
    \u0434\u043b\u044f \u0437\u0430\u043c\u0435\u043d\u044b \u0447\u0430\u0441\u0442\u0435\u0439
    \u0441\u043b\u043e\u0432. \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b \u0442\u0435\u0437\u0438\u0441,
    \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0432 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u043e\u043c \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c
    \u0430\u043b\u0444\u0430\u0432\u0438\u0442\u0435 \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u043a\u0430\u043a \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c.
    \u042d\u0442\u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0434\u0435\u043b\u0430\u0435\u0442 \u0438\u0445 \u043c\u043e\u0449\u043d\u044b\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438 \u0438\u043b\u0438
    \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447. \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435
    \u043e\u0441\u043d\u043e\u0432\u044b: \u041e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u0446\u0435\u043b\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u044f \u2014 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0442\u0430\u043b\u0430 \u0432\u0435\u0434\u0443\u0449\u0435\u0439 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u043e\u0439 \u0432 \u044d\u0442\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438.
    \u0412 \u0435\u0435 \u043e\u0441\u043d\u043e\u0432\u0435 \u043b\u0435\u0436\u0438\u0442
    \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043d\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u0430 \u043d\u0430\u0448\u0438\u0445
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u043c\u0435\u043d\u0438\u0439
    \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044c
    \u0438 \u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0447\u0435\u0442\u043a\u043e
    \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u043c\u044b\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u044b
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u043b\u043e\u0432\u0430 \u0432
    \u0430\u043b\u0444\u0430\u0432\u0438\u0442\u0435). \u041c\u0430\u0440\u043a\u043e\u0432
    \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043d\u0430 \u0441\u0438\u043d\u0442\u0430\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435,
    \u0447\u0442\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e
    \u0434\u043b\u044f \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a.\n\n\U0001F9E9 \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u00ab\u043d\u0435\u0440\u0435\u0448\u0430\u0435\u043c\u044b\u0445\u00bb
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0441\u0432\u043e\u0435\u0433\u043e \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432 \u041c\u0430\u0440\u043a\u043e\u0432
    \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432
    \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c,
    \u0434\u043e\u043a\u0430\u0437\u0430\u0432 \u0438\u0445 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u044c. 1.
    \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0430
    \u0441\u043b\u043e\u0432 (1947): \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0430 \u0441\u043b\u043e\u0432 (\u0438\u043b\u0438
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430)
    \u0434\u043b\u044f \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445
    \u043f\u043e\u043b\u0443\u0433\u0440\u0443\u043f\u043f. \u042d\u0442\u043e \u043e\u0434\u043d\u0430
    \u0438\u0437 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447 \u0430\u043b\u0433\u0435\u0431\u0440\u044b, \u0438 \u0435\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u0435\u0439.
    2. \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0433\u043e\u043c\u0435\u043e\u043c\u043e\u0440\u0444\u0438\u0437\u043c\u0430
    (1958): \u041c\u0430\u0440\u043a\u043e\u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0433\u043e\u043c\u0435\u043e\u043c\u043e\u0440\u0444\u0438\u0437\u043c\u0430 \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438.
    \u042d\u0442\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438,
    \u0438 \u0435\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0435\u0439 \u0432\u0435\u0445\u043e\u0439. 3.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u041c\u0430\u0440\u043a\u043e\u0432\u0430 \u0432
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438: \u0415\u0433\u043e \u0438\u043c\u044f
    \u0442\u0430\u043a\u0436\u0435 \u043d\u043e\u0441\u0438\u0442 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438 \u0434\u043b\u044f
    \u043b\u044e\u0431\u043e\u0433\u043e `n \u2265 4` \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u0435\u043c\u043e\u0433\u043e
    \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e `n`-\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f, \u0447\u0442\u043e
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c
    \u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435\u043c \u0435\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.\n\n\U0001F4BB
    \u041f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435 \u0430\u0441\u043f\u0435\u043a\u0442\u044b
    \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0420\u0430\u0431\u043e\u0442\u044b
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430 \u043d\u0435 \u0431\u044b\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0435\u0439.
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438. \u0422\u0435\u043e\u0440\u0438\u044f \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f: \u041e\u043d
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432,
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0438\u043d\u0432\u0435\u0440\u0441\u0438\u043e\u043d\u043d\u0443\u044e
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0431\u0443\u043b\u0435\u0432\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e,
    \u043e\u043d \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043b \u0440\u044f\u0434 \u0432\u0430\u0436\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u00ab\u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430\u00bb, \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0449\u0443\u044e
    \u0448\u0438\u0444\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u044e\u0442 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u0438\u044f.
    \u0422\u0435\u043e\u0440\u0438\u044f \u042d\u0412\u041c \u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435:
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0448\u0438\u043d. \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u044f\u0437\u044b\u043a
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u044b,
    \u0430 \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0430 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432 \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b\u0430 \u043f\u0440\u0438\u0435\u043c\u044b
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c. \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430: \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438
    \u0432 \u041c\u0413\u0423 \u0432 1959 \u0433\u043e\u0434\u0443 \u0438 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u043e\u043c,
    \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0432 \u0446\u0435\u043b\u0443\u044e \u043f\u043b\u0435\u044f\u0434\u0443
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.\n\n\U0001F4DA
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u0421\u0440\u0435\u0434\u0438
    \u0435\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c
    \u043a\u043d\u0438\u0433\u0438 \u0438 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0441\u0442\u0430\u0432\u0448\u0438\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u044b\u043c\u0438
    \u0434\u043b\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432: \u00ab\u0422\u0435\u043e\u0440\u0438\u044f
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432\u00bb (1954, \u0432 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u0441\u0442\u0432\u0435
    \u0441 \u041d.\u041c. \u041d\u0430\u0433\u043e\u0440\u043d\u044b\u043c) \u2014 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0440\u0443\u0434, \u043c\u043d\u043e\u0433\u043e\u043a\u0440\u0430\u0442\u043d\u043e
    \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u0432\u0430\u0432\u0448\u0438\u0439\u0441\u044f.
    \u00ab\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438\u00bb (1984) \u2014 \u0432\u0430\u0436\u043d\u043e\u0435
    \u0443\u0447\u0435\u0431\u043d\u043e\u0435 \u043f\u043e\u0441\u043e\u0431\u0438\u0435. \u0421\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432
    \u0432 \u0434\u0432\u0443\u0445 \u0442\u043e\u043c\u0430\u0445, \u0432\u044b\u043f\u0443\u0449\u0435\u043d\u043d\u043e\u0435
    \u043a \u0435\u0433\u043e \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044e."
  achievementsEn: 
  personalLifeRu: "\u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432-\u043c\u043b\u0430\u0434\u0448\u0438\u0439: \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0436\u0438\u0437\u043d\u0438 \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u043e\u0442\u0446\u0430-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u0410\u043d\u0434\u0440\u0435\u044f \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447\u0430
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430-\u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e
    (1856\u20131922), \u044f \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0443\u0441\u044c
    \u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u0445
    \u043e \u0441\u0430\u043c\u043e\u043c \u043c\u043b\u0430\u0434\u0448\u0435\u043c \u041c\u0430\u0440\u043a\u043e\u0432\u0435.
    \u0412\u0430\u0436\u043d\u043e \u0441\u0440\u0430\u0437\u0443 \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c:
    \u0432 \u0432\u0430\u0448\u0435\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u0440\u0435\u0447\u044c
    \u0438\u0434\u0435\u0442 \u043e \u043c\u043b\u0430\u0434\u0448\u0435\u043c \u041c\u0430\u0440\u043a\u043e\u0432\u0435,
    \u043d\u043e \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0430
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0441\u043a\u0443\u043f\u043e \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e
    \u0441 \u0436\u0438\u0437\u043d\u044c\u044e \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u043e\u0442\u0446\u0430.\n\n\U0001F468\u200d\U0001F466 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432-\u043c\u043b\u0430\u0434\u0448\u0438\u0439 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    9 (22) \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1903 \u0433\u043e\u0434\u0430 \u0432
    \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435.
    \u041e\u043d \u0431\u044b\u043b \u0441\u044b\u043d\u043e\u043c \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0410\u043d\u0434\u0440\u0435\u044f \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447\u0430
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430-\u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e,
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u0430
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0446\u0435\u043f\u0435\u0439 \u041c\u0430\u0440\u043a\u043e\u0432\u0430.
    \u041c\u043b\u0430\u0434\u0448\u0438\u0439 \u041c\u0430\u0440\u043a\u043e\u0432 \u0440\u043e\u0434\u0438\u043b\u0441\u044f,
    \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u043e\u0442\u0446\u0443 \u0431\u044b\u043b\u043e
    \u0443\u0436\u0435 47 \u043b\u0435\u0442 (\u043e\u0442\u0435\u0446 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u0432 1883 \u0433\u043e\u0434\u0443, \u0438 \u0441\u044b\u043d \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u0447\u0435\u0440\u0435\u0437 20 \u043b\u0435\u0442).\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430
    \u0412 1919 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0412\u043e\u0441\u044c\u043c\u0443\u044e \u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u0443\u044e
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e. \u0421\u0432\u043e\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u043e\u043d \u043d\u0430\u0447\u0438\u043d\u0430\u043b
    \u043d\u0435 \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u2014
    \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043d\u0430 \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u043d\u043e \u0437\u0430\u0442\u0435\u043c
    \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u0442\u043e\u0447\u043d\u044b\u043c\u0438 \u043d\u0430\u0443\u043a\u0430\u043c\u0438
    \u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u043b\u0441\u044f \u043d\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0432 1924 \u0433\u043e\u0434\u0443.\n\n\U0001F9D1\u200d\U0001F52C
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0438 \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0412 1925 \u0433\u043e\u0434\u0443 \u041c\u0430\u0440\u043a\u043e\u0432 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443 \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435,
    \u0433\u0434\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u043e\u0439. \u041a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0432 1928 \u0433\u043e\u0434\u0443. \u0412 1935 \u0433\u043e\u0434\u0443 \u0435\u043c\u0443
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u0430 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a \u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u2014 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0435\u0433\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439. \u041c\u0430\u0440\u043a\u043e\u0432
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0441 1933 \u043f\u043e
    1955 \u0433\u043e\u0434, \u0437\u0430\u0432\u0435\u0434\u043e\u0432\u0430\u043b \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0421 1939 \u0433\u043e\u0434\u0430
    \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0438\u043c. \u0412.\u0410. \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430
    (\u041c\u0418\u0410\u041d). \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0431\u043b\u043e\u043a\u0430\u0434\u043d\u043e\u043c
    \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435 \u0434\u043e \u0438\u044e\u043b\u044f
    1942 \u0433\u043e\u0434\u0430, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u0431\u044b\u043b
    \u044d\u0432\u0430\u043a\u0443\u0438\u0440\u043e\u0432\u0430\u043d \u0432 \u041a\u0430\u0437\u0430\u043d\u044c.
    \u0421 1954 \u0433\u043e\u0434\u0430 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u041c\u043e\u0441\u043a\u0432\u0435, \u0430 \u0432 1959 \u0433\u043e\u0434\u0443
    \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438
    \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F91D \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0438 \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u041c\u043b\u0430\u0434\u0448\u0438\u0439
    \u041c\u0430\u0440\u043a\u043e\u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0421\u0440\u0435\u0434\u0438
    \u0435\u0433\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u2014 \u0410. \u0413. \u0414\u0440\u0430\u0433\u0430\u043b\u0438\u043d, \u0411. \u0410.
    \u041a\u0443\u0448\u043d\u0435\u0440, \u041d. \u041c. \u041d\u0430\u0433\u043e\u0440\u043d\u044b\u0439,
    \u0413. \u0421. \u0426\u0435\u0439\u0442\u0438\u043d, \u041d. \u0410. \u0428\u0430\u043d\u0438\u043d.
    \u0412 1968 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0435 \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e,
    \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u0432 \u00ab\u041f\u0438\u0441\u044c\u043c\u043e
    99\u00bb \u043f\u0440\u043e\u0442\u0438\u0432 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438
    \u0421\u0442\u0430\u043b\u0438\u043d\u0430 \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0439 \u0432 \u043d\u0430\u0443\u043a\u0435.\n\n\u26b0\ufe0f
    \u0421\u043c\u0435\u0440\u0442\u044c \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432-\u043c\u043b\u0430\u0434\u0448\u0438\u0439 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    11 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1979 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 76 \u043b\u0435\u0442. --- \u0412\u0430\u0436\u043d\u043e\u0435
    \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435 \u0412 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0436\u0438\u0437\u043d\u044c
    \u043e\u0442\u0446\u0430 \u2014 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u041c\u0430\u0440\u043a\u043e\u0432\u0430,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0435\u0433\u043e \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0441 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043e\u043c \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430, \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438,
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0443 \u0427\u0435\u0431\u044b\u0448\u0435\u0432\u0430,
    \u0437\u0430\u0449\u0438\u0442\u0443 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0439
    \u0432 1880-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u0443 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430 \u0431\u044b\u043b\u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u0427\u0435\u0431\u044b\u0448\u0435\u0432\u0430 \u2014 \u0410. \u041c. \u041b\u044f\u043f\u0443\u043d\u043e\u0432\u044b\u043c.
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0434\u0430\u0436\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u041b\u044f\u043f\u0443\u043d\u043e\u0432 \u00ab\u0441\u0434\u0435\u043b\u0430\u043b
    \u0435\u043c\u0443 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u0430\u043a\u043e\u0441\u0442\u044c\u00bb,
    \u043d\u043e \u0447\u0435\u0440\u0435\u0437 7 \u043b\u0435\u0442 \u043f\u0440\u0438\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u044d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430
    \u0435\u043c\u0443 \u00ab\u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0435\u00bb."
  personalLifeEn: 
  shortBioRu: "\u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432 (\u043c\u043b\u0430\u0434\u0448\u0438\u0439) \u2014
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u043f\u0440\u0438\u0448\u043b\u0438\u0441\u044c
    \u043d\u0430 \u0431\u0443\u0440\u043d\u044b\u0439 XX \u0432\u0435\u043a. \u0421\u044b\u043d
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430,
    \u043e\u043d \u043f\u043e\u0448\u0435\u043b \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c
    \u043e\u0442\u0446\u0430, \u043d\u043e \u043f\u043e\u0448\u0435\u043b \u0441\u0432\u043e\u0438\u043c
    \u043f\u0443\u0442\u0435\u043c, \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u043e\u043c
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u044b \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432.\n\n\U0001F4DC
    \u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0447\u0430\u043b\u043e
    \u043f\u0443\u0442\u0438 \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 9 (22) \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1903 \u0433\u043e\u0434\u0430 \u0432 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0410.\u0410. \u041c\u0430\u0440\u043a\u043e\u0432\u0430-\u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e.
    \u0421 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u043e\u0442 \u043e\u0442\u0446\u0430 \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u0442\u043e\u0447\u043d\u044b\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c. \u0412 1919 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0412\u043e\u0441\u044c\u043c\u0443\u044e \u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u0443\u044e
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u043f\u043e\u043d\u0430\u0447\u0430\u043b\u0443 \u041c\u0430\u0440\u043a\u043e\u0432-\u043c\u043b\u0430\u0434\u0448\u0438\u0439
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043d\u0430 \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u043e\u0434\u043d\u0430\u043a\u043e
    \u0441 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u043a\u0443\u0440\u0441\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u043b\u0441\u044f
    \u043d\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0432 1924 \u0433\u043e\u0434\u0443. \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u0441\u043e\u0437\u0440\u0435\u0432\u0430\u043d\u0438\u0435 \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435
    \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430,
    \u0432 1925 \u0433\u043e\u0434\u0443, \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443 \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0432
    1928 \u0433\u043e\u0434\u0443, \u0437\u0430\u0449\u0438\u0442\u0438\u0432 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043d\u0430 \u0441\u043e\u0438\u0441\u043a\u0430\u043d\u0438\u0435 \u0443\u0447\u0435\u043d\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430
    \u043d\u0430\u0443\u043a. \u0412\u043f\u043b\u043e\u0442\u044c \u0434\u043e 1935 \u0433\u043e\u0434\u0430
    \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0430\u043c \u0436\u0435,
    \u0437\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u043e\u0439 \u2014 \u044d\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435.
    \u0415\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u0448\u043b\u0430 \u0432 \u0433\u043e\u0440\u0443. \u0412 1935 \u0433\u043e\u0434\u0443
    \u0410\u043d\u0434\u0440\u0435\u044e \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447\u0443
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u0430 \u0443\u0447\u0435\u043d\u0430\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a \u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u2014 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0435\u0433\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u0443\u0436\u0435
    \u043f\u0440\u043e\u0434\u0435\u043b\u0430\u043d\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b.
    \u0413\u043e\u0434 \u0441\u043f\u0443\u0441\u0442\u044f \u043e\u043d \u0441\u0442\u0430\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u0421 1933 \u043f\u043e
    1955 \u0433\u043e\u0434 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0438 \u0441
    1936 \u043f\u043e 1942 \u0433\u043e\u0434, \u0430 \u0437\u0430\u0442\u0435\u043c \u0441
    1944 \u043f\u043e 1953 \u0433\u043e\u0434 \u0437\u0430\u0432\u0435\u0434\u043e\u0432\u0430\u043b
    \u0442\u0430\u043c \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e, \u0441 1939 \u0433\u043e\u0434\u0430,
    \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c \u0435\u0433\u043e \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u044f\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0438\u043c. \u0412.\u0410. \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430
    (\u041c\u0418\u0410\u041d) \u0410\u041d \u0421\u0421\u0421\u0420, \u0433\u0434\u0435 \u043e\u043d
    \u0442\u0440\u0443\u0434\u0438\u043b\u0441\u044f \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e
    1972 \u0433\u043e\u0434\u0430. \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u0434\u043e \u0438\u044e\u043b\u044f 1942 \u0433\u043e\u0434\u0430 \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u0431\u043b\u043e\u043a\u0430\u0434\u043d\u043e\u043c \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0431\u044b\u043b \u044d\u0432\u0430\u043a\u0443\u0438\u0440\u043e\u0432\u0430\u043d
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432\u043e\u043c
    \u041c\u0418\u0410\u041d \u0432 \u041a\u0430\u0437\u0430\u043d\u044c. \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434: \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u0438
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0412 1953 \u0433\u043e\u0434\u0443
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0421\u0421\u0421\u0420
    \u043f\u043e \u041e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044e \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a. \u0421 1954 \u0433\u043e\u0434\u0430 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u041c\u043e\u0441\u043a\u0432\u0435, \u0430 \u0432 1959 \u0433\u043e\u0434\u0443
    \u0441\u0442\u0430\u043b \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438
    \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438. \u0412 1968 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0435
    \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e, \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u0432
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435 \u00ab\u041f\u0438\u0441\u044c\u043c\u043e
    99\u00bb, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u043f\u0440\u043e\u0442\u0438\u0432
    \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438 \u0421\u0442\u0430\u043b\u0438\u043d\u0430
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0439
    \u0432 \u043d\u0430\u0443\u043a\u0435. \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    11 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1979 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435.
    \u041e\u043d \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430 \u041a\u0443\u043d\u0446\u0435\u0432\u0441\u043a\u043e\u043c
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435.\n\n\U0001F52C \u041d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u043e\u0442 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0434\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432. \u0412\u043e\u0442 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432 \u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439:
    \u0422\u0435\u043e\u0440\u0438\u044f \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432:
    \u0421\u043e\u0437\u0434\u0430\u043b \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u044b\u0439 \u0438 \u0443\u0434\u043e\u0431\u043d\u044b\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442
