    \u0441\u0442\u0430\u043b \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438
    \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438. \u0412 1968 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0435
    \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e, \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u0432
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435 \u00ab\u041f\u0438\u0441\u044c\u043c\u043e
    99\u00bb, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u043f\u0440\u043e\u0442\u0438\u0432
    \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438 \u0421\u0442\u0430\u043b\u0438\u043d\u0430
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0439
    \u0432 \u043d\u0430\u0443\u043a\u0435. \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    11 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1979 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435.
    \u041e\u043d \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430 \u041a\u0443\u043d\u0446\u0435\u0432\u0441\u043a\u043e\u043c
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435.\n\n\U0001F52C \u041d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u043e\u0442 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0434\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432. \u0412\u043e\u0442 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432 \u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439:
    \u0422\u0435\u043e\u0440\u0438\u044f \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432:
    \u0421\u043e\u0437\u0434\u0430\u043b \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u044b\u0439 \u0438 \u0443\u0434\u043e\u0431\u043d\u044b\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442
    \u0434\u043b\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430
    \u2014 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0447\u0430\u0441\u0442\u043e
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430\u043c\u0438
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442 \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.
    \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c: \u0412 1947 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0430
    \u0441\u043b\u043e\u0432 (\u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430)
    \u0434\u043b\u044f \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445
    \u043f\u043e\u043b\u0443\u0433\u0440\u0443\u043f\u043f. \u0412 1958 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0433\u043e\u043c\u0435\u043e\u043c\u043e\u0440\u0444\u0438\u0437\u043c\u0430
    \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438 \u2014 \u043e\u0434\u043d\u0443
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.
    \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b: \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u0438 \u043b\u0438\u0434\u0435\u0440\u043e\u043c
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u044b \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0433\u0434\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b \u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044e\u0442\u0441\u044f
    \u0441 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u0438\u0445 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0447\u0435\u0442\u043a\u0438\u0445 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432.
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0443:
    \u0412 1950-\u0445 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b
    \u043c\u0430\u0448\u0438\u043d \u0432 \u0412\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 \u0410\u041d \u0421\u0421\u0421\u0420, \u0433\u0434\u0435
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0441\u0432\u043e\u0438\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0434\u043b\u044f
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438.
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u041c\u0430\u0440\u043a\u043e\u0432\u0430: \u0412
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0430\u0436\u043d\u044b\u0439
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0439 \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c.\n\n\U0001F3C6
    \u041d\u0430\u0433\u0440\u0430\u0434\u044b \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0417\u0430 \u0441\u0432\u043e\u044e \u0434\u043e\u043b\u0433\u0443\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443
    \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434:
    \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b: \u041e\u0440\u0434\u0435\u043d \u00ab\u0417\u043d\u0430\u043a
    \u041f\u043e\u0447\u0435\u0442\u0430\u00bb (1945), \u043c\u0435\u0434\u0430\u043b\u044c
    \u00ab\u0417\u0430 \u0434\u043e\u0431\u043b\u0435\u0441\u0442\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u0432 \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0432\u043e\u0439\u043d\u0435 1941\u20141945 \u0433\u0433.\u00bb (1945), \u043c\u0435\u0434\u0430\u043b\u044c
    \u00ab\u0417\u0430 \u043e\u0431\u043e\u0440\u043e\u043d\u0443 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0430\u00bb
    (1946), \u043e\u0440\u0434\u0435\u043d \u041b\u0435\u043d\u0438\u043d\u0430 (1954), \u043e\u0440\u0434\u0435\u043d
    \u0422\u0440\u0443\u0434\u043e\u0432\u043e\u0433\u043e \u041a\u0440\u0430\u0441\u043d\u043e\u0433\u043e
    \u0417\u043d\u0430\u043c\u0435\u043d\u0438 (1963). \u041d\u0430\u0443\u0447\u043d\u044b\u0435
    \u043f\u0440\u0435\u043c\u0438\u0438: \u041f\u0440\u0435\u043c\u0438\u044f \u0438\u043c\u0435\u043d\u0438
    \u041f. \u041b. \u0427\u0435\u0431\u044b\u0448\u0435\u0432\u0430 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0421\u0421\u0421\u0420 (1969) \u0437\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0412\u0430\u0436\u043d\u043e\u0435 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435
    \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0432\u0430\u0448 \u0437\u0430\u043f\u0440\u043e\u0441
    \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0410\u043d\u0434\u0440\u0435\u044f \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447\u0430
    \u041c\u0430\u0440\u043a\u043e\u0432\u0430 (1903\u20131979), \u0441\u0442\u043e\u0438\u0442
    \u043f\u043e\u043c\u043d\u0438\u0442\u044c, \u0447\u0442\u043e \u0435\u0433\u043e \u043e\u0442\u0435\u0446,
    \u0410\u043d\u0434\u0440\u0435\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447
    \u041c\u0430\u0440\u043a\u043e\u0432 (\u0441\u0442\u0430\u0440\u0448\u0438\u0439) (1856\u20131922),
    \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
    \u041c\u0430\u0440\u043a\u043e\u0432 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043f\u0440\u0435\u0436\u0434\u0435
    \u0432\u0441\u0435\u0433\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439,
    \u0433\u0434\u0435 \u043e\u043d \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u00ab\u0446\u0435\u043f\u0438 \u041c\u0430\u0440\u043a\u043e\u0432\u0430\u00bb."
  shortBioEn: "Andrei Andreevich Markov, Jr., is a Soviet mathematician whose life and academic career have been in a stormy 20th century, and the son of a famous academic, he followed his father's footsteps, but went his own way, becoming the founder of the Soviet school of constructive mathematics and the creator of algorithms theory.\n\n==Background==The biography in the early years and the beginning of the journey was born on September 9, 1903, in St. Petersburg, in the family of outstanding mathematician A.A. Markov, a senior mathematician. He received a brilliant home education from early years and inherited his father's love for fine sciences.Interestingly, Markov, Jr., first enrolled in the Faculty of Chemicals of the University of Petrograd, but from the third year he moved to the physical department of the Faculty of Physics and Mathematics, which graduated in 1924.===Reception======Lenningrad====In 1925, he entered the University of Leningrad as a graduate student at the Astronomy Institute in Leningrad, which graduated in 1928, defending his thesis for a Ph.D. degree in science, and until 1935 he worked there as a fellow in heavenly mechanics, which is still of scientific significance.In 1935, Andrei Andrejevic was awarded a Ph.D. in physics and mathematics without the protection of the thesis, recognition of his outstanding abilities and work already done, and a year later he became a professor. From 1933 to 1955, he worked at the University of Leningrad, and from 1936 to 1942, and then from 1944 to 1953, he was the head of the Department of Geometry.==History==In the Great Patriotic War, Andrei Andrejevic was in the blockade of Leningrad until July 1942 and was evacuated with the MIAN team to Kazan.In 1954 he worked in Moscow and in 1959 became the head of the Department of Mathematics of the Moscow State University, which was run for the rest of his life, and in 1968 he showed civil courage by signing the famous Letter 99, aimed at the rehabilitation of Stalin and political repression in science, and Andrei Andreevich Markov died on 11 October 1979 in Moscow, buried in the Kuntsy cemetery.\n\n==History==The scientific contributions of Andrei Andreevich Markov left a deep mark in several fields of mathematics. Its work covers a range from celestial mechanics to algorithm theory. These are the main areas of his scientific interest and achievements: algorithm theory: created a completely new and convenient tool for formalizing the concept of algorithm, normal algorithms, which are now often called Markov algorithms.This was one of the fundamental works in this field: the solution of the key problems: in 1947, he proved that the problem of the identity of words (equality issues) was not solved for certain semi-groupes; in 1958, he proved that the problem of homomorphism in topology was not solved, one of the most well-known tasks in this field.Founding the Science School: He is the founder and leader of the Soviet School of constructive mathematics, where mathematical objects and processes are considered in terms of their feasibility with clear algorithms.Contribution to Cybernetics: In the 1950s, he created a laboratory of mathematical logic and machine structure at the Soviet Union's Computer Center, where he actively applied the results of his research to the development of computing technology and cryptography.\n\n:: Honours and recognition for his long career as Andrei Andreevich Markov was awarded many State and scientific awards: State awards: Order of Honour (1945), Medal for the Magnificent Work of the Great Patriotic War 1941-1945 (1945), Medal for the Defence of Leningrad (1946), Order of Lenin (1954), Order of the Labour Red Plague (1963).The Chebsheva Academy of Sciences of the USSR (1969) for outstanding work in mathematics. An important clarification, since your request concerns Andrei Andreevich Markov (1903–1979), is worth remembering that his father, Andrei Andreevich Markov (senior) (1856–1922), was also an outstanding mathematician. The Senior Markov is first known for his work in probability theory, where he introduced the concept of \"Markov chain\"."
  interestingFactsRu: "\u265f\ufe0f \u0428\u0430\u0445\u043c\u0430\u0442\u0438\u0441\u0442, \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0448\u0438\u0439
    \u0431\u043b\u043e\u043a\u0430\u0434\u0443 \u041e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f,
    \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0432\u0441\u0435\u0440\u044c\u0435\u0437 \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f
    \u0448\u0430\u0445\u043c\u0430\u0442\u0430\u043c\u0438. \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c
    \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u043e\u043c \u0431\u044b\u043b \u0435\u0433\u043e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043e\u0442\u0435\u0446, \u0438
    \u043a 8 \u0433\u043e\u0434\u0430\u043c \u0410\u043d\u0434\u0440\u0435\u0439-\u043c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0443\u0436\u0435 \u0438\u0433\u0440\u0430\u043b. \u0412 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b \u044d\u0442\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u043e \u0432 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0435
    \u0437\u0430\u043d\u044f\u0442\u0438\u0435 \u2014 \u043e\u043d \u0441\u0442\u0430\u043b
    \u043f\u0435\u0440\u0432\u043e\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u043d\u0438\u043a\u043e\u043c
    \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u043b \u0447\u0435\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0432 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u0445
    \u043c\u0430\u0442\u0447\u0430\u0445 \u0441 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u043c. \u0421\u0430\u043c\u044b\u0439
    \u044f\u0440\u043a\u0438\u0439 \u044d\u043f\u0438\u0437\u043e\u0434 \u0435\u0433\u043e \u0448\u0430\u0445\u043c\u0430\u0442\u043d\u043e\u0439
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 \u0431\u043b\u043e\u043a\u0430\u0434\u043d\u043e\u043c \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435.
    \u0412 1942 \u0433\u043e\u0434\u0443, \u0435\u0449\u0435 \u0434\u043e \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u0438,
    \u043e\u043d \u043f\u0440\u0438\u043d\u044f\u043b \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043c \u0410.\u042f. \u041c\u043e\u0434\u0435\u043b\u0435\u043c
    \u0448\u0430\u0445\u043c\u0430\u0442\u043d\u043e\u043c \u0442\u0443\u0440\u043d\u0438\u0440\u0435.
    \u042d\u0442\u043e\u0442 \u0442\u0443\u0440\u043d\u0438\u0440 \u043f\u043e\u0437\u0436\u0435
    \u043d\u0430\u0437\u043e\u0432\u0443\u0442 \"\u0431\u043b\u043e\u043a\u0430\u0434\u043d\u044b\u043c\",
    \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434
    \u0441\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u044b\u043c
    \"\u041c\u0430\u0442\u0447\u0435\u043c \u0436\u0438\u0437\u043d\u0438\". \u041c\u0430\u0440\u043a\u043e\u0432
    \u0434\u043e \u0438\u044e\u043b\u044f 1942 \u0433\u043e\u0434\u0430 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0432 \u043e\u0441\u0430\u0436\u0434\u0435\u043d\u043d\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435
    \u0438 \u043d\u0430\u0448\u0435\u043b \u0432 \u0441\u0435\u0431\u0435 \u0441\u0438\u043b\u044b
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u044d\u0442\u043e\u043c
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u043c
    \u0441\u043e\u0441\u0442\u044f\u0437\u0430\u043d\u0438\u0438, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
