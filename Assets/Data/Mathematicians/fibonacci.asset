  achievementsRu: "\u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e
    \u041f\u0438\u0437\u0430\u043d\u0441\u043a\u043e\u0433\u043e (\u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438)
    \u0432\u044b\u0445\u043e\u0434\u044f\u0442 \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430
    \u0440\u0430\u043c\u043a\u0438 \u043f\u0440\u043e\u0441\u0442\u043e\u0433\u043e \u00ab\u043f\u0440\u0438\u0432\u043e\u0437\u0430
    \u0446\u0438\u0444\u0440\u00bb \u0432 \u0415\u0432\u0440\u043e\u043f\u0443. \u041e\u043d
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u043e\u043f\u0440\u043e\u0445\u043e\u0434\u0446\u0435\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b \u043d\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0439
    \u0432\u043f\u0435\u0440\u0435\u0434. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430
    \u0447\u0435\u0442\u044b\u0440\u0435 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f: \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f, \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b, \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0438 \u0447\u0438\u0441\u0442\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b. \u041d\u0438\u0436\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u043e\u0440
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439.
    1. \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u043e\u0439
    \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    (\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f)
    \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438, \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0435\u0435
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e \u043d\u0430\u0443\u043a\u0443.
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u00ab\u041a\u043d\u0438\u0433\u0435 \u0430\u0431\u0430\u043a\u0430\u00bb
    (1202/1228) \u043e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u043f\u0438\u0441\u0430\u043b
    \u0446\u0438\u0444\u0440\u044b \u2014 \u043e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0438\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043d\u0443\u043b\u044f \u0438 \u0440\u0430\u0437\u0440\u044f\u0434\u043e\u0432:
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0447\u0435\u0442\u043a\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b,
    \u0447\u0442\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0446\u0438\u0444\u0440\u044b
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0435\u0435 \u043f\u043e\u0437\u0438\u0446\u0438\u0438
    (\u0435\u0434\u0438\u043d\u0438\u0446\u044b, \u0434\u0435\u0441\u044f\u0442\u043a\u0438,
    \u0441\u043e\u0442\u043d\u0438). \u041e\u043d \u0432\u0432\u0435\u043b \u0432 \u043e\u0431\u0438\u0445\u043e\u0434
    \u043d\u043e\u043b\u044c (`zephirum`) \u043d\u0435 \u043a\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0443\u0441\u0442\u043e\u0435 \u043c\u0435\u0441\u0442\u043e, \u0430 \u043a\u0430\u043a
    \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e,
    \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435 \u0432 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u0445.
    \u0414\u0440\u043e\u0431\u0438 \u043d\u043e\u0432\u043e\u0433\u043e \u0442\u0438\u043f\u0430:
    \u0412\u043c\u0435\u0441\u0442\u043e \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u0445
    \u0448\u0435\u0441\u0442\u0438\u0434\u0435\u0441\u044f\u0442\u0435\u0440\u0438\u0447\u043d\u044b\u0445
    \u0434\u0440\u043e\u0431\u0435\u0439 (\u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0432\u0430\u0432\u0438\u043b\u043e\u043d\u044f\u043d
    \u0438 \u0433\u0440\u0435\u043a\u043e\u0432) \u0438\u043b\u0438 \u0440\u0438\u043c\u0441\u043a\u0438\u0445
    \u0434\u0440\u043e\u0431\u0435\u0439, \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0441\u043e\u0441\u0442\u0430\u0432\u043d\u044b\u0435 \u0434\u0440\u043e\u0431\u0438 \u0438
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0435 \u0434\u0440\u043e\u0431\u0438
    (\u0445\u043e\u0442\u044f \u0432 \u0435\u0433\u043e \u0432\u0440\u0435\u043c\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u0430\u044f
    \u0437\u0430\u043f\u044f\u0442\u0430\u044f \u0435\u0449\u0435 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c,
    \u043e\u043d \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u043b \u0446\u0435\u043b\u044b\u0435
    \u0447\u0430\u0441\u0442\u0438 \u043d\u0430 \u0435\u0434\u0438\u043d\u0438\u0446\u044b,
    \u0434\u0435\u0441\u044f\u0442\u043a\u0438, \u0441\u043e\u0442\u043d\u0438 \u0438 \u0442.\u0434.).
    \u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u044b:
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0430\u0431\u043b\u0438\u0446\u044b
    \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u0432\u0430\u043b\u044e\u0442,
    \u043c\u0435\u0440 \u0432\u0435\u0441\u0430 \u0438 \u0434\u043b\u0438\u043d\u044b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0434\u043b\u044f \u043a\u043e\u043d\u0432\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u043f\u0438\u0437\u0430\u043d\u0441\u043a\u0438\u0445 \u043b\u0438\u0440 \u0432 \u0441\u0438\u0446\u0438\u043b\u0438\u0439\u0441\u043a\u0438\u0435
    \u0443\u043d\u0446\u0438\u0438), \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u043e
    \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0443 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u044b\u043c
    \u043f\u043e\u0441\u043e\u0431\u0438\u0435\u043c \u0434\u043b\u044f \u043a\u0443\u043f\u0446\u043e\u0432.
    > \u0412\u0430\u0436\u043d\u043e: \u0418\u043c\u0435\u043d\u043d\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u0443 \u0438 \u044f\u0441\u043d\u043e\u0441\u0442\u0438
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u043a\u0443\u043f\u0446\u044b \u0424\u043b\u043e\u0440\u0435\u043d\u0446\u0438\u0438 \u0438
    \u041f\u0438\u0437\u044b \u043d\u0430\u0447\u0430\u043b\u0438 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0430 \u00ab\u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434\u00bb, \u0432\u044b\u0442\u0435\u0441\u043d\u0438\u0432 \u0441\u0447\u0435\u0442
    \u043d\u0430 \u0430\u0431\u0430\u043a\u0435 \u0438 \u0440\u0438\u043c\u0441\u043a\u0438\u0435
    \u0446\u0438\u0444\u0440\u044b \u0438\u0437 \u0434\u0435\u043b\u043e\u0432\u043e\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438
    \u043a \u043a\u043e\u043d\u0446\u0443 XIII \u0432\u0435\u043a\u0430. --- 2. \u0412\u043a\u043b\u0430\u0434
    \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0438 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u043b \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u043d\u0430\u043d\u0438\u044f, \u0437\u0430\u0438\u043c\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u0443 \u0430\u0440\u0430\u0431\u043e\u0432 (\u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438)
    \u0438 \u0438\u043d\u0434\u0438\u0439\u0446\u0435\u0432, \u043d\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438\u0445 \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u043b \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u043d\u0430\u0445\u043e\u0434\u043a\u0430\u043c\u0438. \u0420\u0435\u0448\u0435\u043d\u0438\u0435
    \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439:
    \u042d\u0442\u043e \u0435\u0433\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0435\u0441\u044f
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435. \u041d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0442\u0443\u0440\u043d\u0438\u0440\u0435 1225 \u0433\u043e\u0434\u0430 \u043f\u0440\u0438
    \u0434\u0432\u043e\u0440\u0435 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 II \u0435\u043c\u0443
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438 \u0440\u0435\u0448\u0438\u0442\u044c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 x\u00b3 + 2x\u00b2 + 10x = 20. \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043a\u043e\u0440\u0435\u043d\u044c
    \u044d\u0442\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u043d\u0435
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0438 \u0446\u0435\u043b\u044b\u043c
    \u0447\u0438\u0441\u043b\u043e\u043c, \u043d\u0438 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0434\u0440\u043e\u0431\u044c\u044e, \u043d\u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u043e\u0439
    \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e
    (\u0442\u043e \u0435\u0441\u0442\u044c \u043d\u0435 \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f
    \u0447\u0435\u0440\u0435\u0437 \u221a). \u041e\u043d \u043d\u0430\u0448\u0435\u043b \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u0440\u043d\u044f \u0441 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0434\u043e 9-\u0433\u043e \u0437\u043d\u0430\u043a\u0430 \u043f\u043e\u0441\u043b\u0435
    \u0437\u0430\u043f\u044f\u0442\u043e\u0439: x = 1.368808107... \u042d\u0442\u043e\u0442
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0431\u044b\u043b \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043c\u0435\u0442\u043e\u0434\u044b
    \u0432\u0430\u0432\u0438\u043b\u043e\u043d\u0441\u043a\u043e\u0439 \u0430\u043f\u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u0446\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u043d\u043e\u0432\u043e \u043e\u0442\u043a\u0440\u044b\u043b
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0421\u0442\u0435\u0432\u0438\u043d
    \u0432 XVI \u0432\u0435\u043a\u0435. \u041c\u0435\u0442\u043e\u0434 \u043b\u043e\u0436\u043d\u043e\u0433\u043e
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f (Regula Falsi): \u041e\u043d \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0434\u0440\u0435\u0432\u043d\u0438\u0439 \u043c\u0435\u0442\u043e\u0434 \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439,
    \u0441\u0432\u0435\u0434\u044f \u0435\u0433\u043e \u043a \u0441\u0442\u0440\u043e\u0433\u0438\u043c
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430\u043c. \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f: \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u0434\u0430\u043b \u043f\u043e\u043b\u043d\u0443\u044e \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0438 \u0441\u0442\u0440\u043e\u0433\u0438\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435,
    \u043d\u043e \u0438 \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u044f (\u0432 \u0441\u0447\u0435\u0442\u0430\u0445)
    \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u0440\u043d\u0438
    \u043a\u0430\u043a \u00ab\u0434\u043e\u043b\u0433\u0438\u00bb. \u041f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u043a\u0438: \u0425\u043e\u0442\u044f \u043e\u043d
    \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0431\u0443\u043a\u0432\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b (\u043e\u043d\u0430 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u0443 \u0412\u0438\u0435\u0442\u0430), \u043e\u043d
    \u0432\u0432\u0435\u043b \u0435\u0434\u0438\u043d\u0443\u044e \u0442\u0435\u0440\u043c\u0438\u043d\u043e\u043b\u043e\u0433\u0438\u044e
    \u0434\u043b\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445, \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432
    \u0438 \u043a\u0443\u0431\u043e\u0432 \u0447\u0438\u0441\u0435\u043b, \u0447\u0442\u043e
    \u0443\u043f\u0440\u043e\u0441\u0442\u0438\u043b\u043e \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u0435
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447. --- 3. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b (\u00ab\u041a\u043d\u0438\u0433\u0430 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432\u00bb
    \u2014 Liber Quadratorum) \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 (1225 \u0433.)
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438. \u0417\u0434\u0435\u0441\u044c
    \u043e\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u043d\u0435 \u043a\u0430\u043a
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a-\u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440,
    \u0430 \u043a\u0430\u043a \u0447\u0438\u0441\u0442\u044b\u0439 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a,
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u0432\u0448\u0438\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b \u0424\u0435\u0440\u043c\u0430 \u0438 \u042d\u0439\u043b\u0435\u0440\u0430.
    \u041a\u043e\u043d\u0433\u0440\u0443\u044d\u043d\u0442\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430:
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0434\u0430\u043b \u043f\u043e\u043b\u043d\u043e\u0435
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0445
    \u00ab\u043a\u043e\u043d\u0433\u0440\u0443\u044d\u043d\u0442\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b\u00bb
    (congruum). \u041e\u043d \u043e\u0442\u043a\u0440\u044b\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0447\u0438\u0441\u0435\u043b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0441\u0443\u043c\u043c\u043e\u0439 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432
    \u0434\u0432\u0443\u0445 \u0440\u0430\u0437\u043d\u044b\u0445 \u043f\u0430\u0440 \u0447\u0438\u0441\u0435\u043b.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0447\u0438\u0441\u043b\u043e 5 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043a\u043e\u043d\u0433\u0440\u0443\u044d\u043d\u0442\u043d\u044b\u043c, \u0442\u0430\u043a
    \u043a\u0430\u043a 5 = 1\u00b2 + 2\u00b2, \u0438 \u043e\u043d\u043e \u0436\u0435 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c \u043c\u0435\u0436\u0434\u0443 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430\u043c\u0438.
    \u0422\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043e \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    (\u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b-\u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438):
    \u041e\u043d \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043e, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0435\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0434\u0432\u0443\u0445 \u0441\u0443\u043c\u043c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \u0434\u0432\u0443\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432: (a\u00b2 + b\u00b2)(c\u00b2 + d\u00b2)
    = (ac \u00b1 bd)\u00b2 + (ad \u2213 bc)\u00b2. \u042d\u0442\u043e \u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043e
    \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u0432\u0441\u0435\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u043e\u0432\u044b\u0445
    \u0442\u0440\u043e\u0435\u043a \u0438 \u043d\u0430\u0448\u043b\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0434\u0430\u0436\u0435 \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u043e\u0440\u043c. \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f:
    \u0412 \u00ab\u041a\u043d\u0438\u0433\u0435 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432\u00bb
    \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0441\u0435\u0440\u0438\u044e \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    (\u0430\u043d\u0430\u043b\u0438\u0437 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430),
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u043a\u0430\u043a \u043d\u0430\u0439\u0442\u0438
    \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432\u0438\u0434\u0430
    x\u00b2 + y\u00b2 = z\u00b2, \u043f\u0440\u0438\u0447\u0435\u043c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0442\u0440\u043e\u0439\u043a\u0438, \u0430 \u0441\u0435\u0440\u0438\u0438 \u0442\u0440\u043e\u0435\u043a
    \u0441 \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c\u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438.
    \u0421\u0443\u043c\u043c\u044b \u043a\u0443\u0431\u043e\u0432: \u041e\u043d \u043d\u0430\u0448\u0435\u043b
    \u043c\u0435\u0442\u043e\u0434\u044b \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u043b\u043e\u0436\u0438\u0442\u044c \u043d\u0430 \u0441\u0443\u043c\u043c\u0443
    \u0434\u0432\u0443\u0445 \u043a\u0443\u0431\u043e\u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438, \u0447\u0442\u043e \u043d\u0430
    \u0441\u043e\u0442\u043d\u0438 \u043b\u0435\u0442 \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b\u043e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u0442\u0430\u043a\u0441\u0438 (\u0447\u0438\u0441\u043b\u0430
    \u0425\u0430\u0440\u0434\u0438-\u0420\u0430\u043c\u043d\u0443\u0434\u0436\u0430\u043d\u0430).
    --- 4. \u041f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0438 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0430
    \u0421\u0430\u043c\u043e\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0431\u044b\u043b\u043e
    \u0434\u043b\u044f \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u043b\u0438\u0448\u044c
    \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0439 \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0430\u0446\u0438\u0435\u0439
    \u043a \u0437\u0430\u0434\u0430\u0447\u0435 \u043e \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0438
    \u043a\u0440\u043e\u043b\u0438\u043a\u043e\u0432 \u0432 12-\u0439 \u0433\u043b\u0430\u0432\u0435
    \u00ab\u041a\u043d\u0438\u0433\u0438 \u0430\u0431\u0430\u043a\u0430\u00bb. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432 \u044d\u0442\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u043e\u0433\u0440\u043e\u043c\u0435\u043d: \u0421\u0430\u043c\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c:
    1, 1, 2, 3, 5, 8, 13, 21, 34... \u0420\u0435\u043a\u0443\u0440\u0440\u0435\u043d\u0442\u043d\u043e\u0435
    \u043f\u0440\u0430\u0432\u0438\u043b\u043e: \u041e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0447\u0435\u0442\u043a\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0440\u0435\u043a\u0443\u0440\u0440\u0435\u043d\u0442\u043d\u043e\u0435 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    (\u043a\u0430\u0436\u0434\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0432\u043d\u043e
    \u0441\u0443\u043c\u043c\u0435 \u0434\u0432\u0443\u0445 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0445).
    \u0411\u0438\u043d\u043e\u043c\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u044b:
    \u0420\u0430\u0431\u043e\u0442\u0430\u044f \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e,
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u0441\u0443\u043c\u043c\u0430 \u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0432 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0435
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f (\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432
    \u0415\u0432\u0440\u043e\u043f\u0435 \u0435\u0449\u0435 \u043d\u0435 \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d) \u0434\u0430\u0435\u0442 \u0442\u0435
    \u0436\u0435 \u0447\u0438\u0441\u043b\u0430. \u041e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0447\u0438\u0441\u043b\u0430 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0439
    (\u0445\u043e\u0442\u044f \u0438 \u043d\u0435 \u0432\u044b\u0432\u0435\u043b \u043e\u0431\u0449\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443). \u0421\u0432\u044f\u0437\u044c \u0441 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439:
    \u0412 \u00ab\u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb
    \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    \u0441\u043e\u0441\u0435\u0434\u043d\u0438\u0445 \u0447\u0438\u0441\u0435\u043b \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0441\u044f \u043a \u00ab\u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u0438\u00bb (\u0437\u043e\u043b\u043e\u0442\u043e\u043c\u0443
    \u0441\u0435\u0447\u0435\u043d\u0438\u044e, \u03c6 \u2248 1.618), \u0445\u043e\u0442\u044f
    \u0441\u0430\u043c \u0442\u0435\u0440\u043c\u0438\u043d \u00ab\u0437\u043e\u043b\u043e\u0442\u043e\u0435
    \u0441\u0435\u0447\u0435\u043d\u0438\u0435\u00bb \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f
    \u043f\u043e\u0437\u0436\u0435. \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432
    \u0438 \u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043e\u0442\u0440\u0435\u0437\u043a\u043e\u0432
    \u0432 \u043a\u0440\u0430\u0439\u043d\u0435\u043c \u0438 \u0441\u0440\u0435\u0434\u043d\u0435\u043c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438. --- 5. \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    (\u00ab\u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb)
    \u0412 \u044d\u0442\u043e\u043c \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 (1220 \u0433.)
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u043a\u0430\u043a \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0442\u043e\u0440
    \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0437\u0430\u0434\u0430\u0447\u0430\u043c. \u0422\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044f:
    \u041e\u043d \u0432\u0432\u0435\u043b \u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0441\u0438\u043d\u0443\u0441\u043e\u0432 \u0438 \u0445\u043e\u0440\u0434 (\u0445\u043e\u0442\u044f
    \u0438 \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0438\u0445 \u0442\u0430\u043a),
    \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u0432 \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0435
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u0432\u044b\u0441\u043e\u0442 \u0437\u0434\u0430\u043d\u0438\u0439 \u0438 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0439
    \u0434\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043c\u0435\u0434\u0438\u0430\u043d\u0430\u0445:
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442
    \u043f\u0435\u0440\u0432\u043e\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e \u0444\u0430\u043a\u0442\u0430, \u0447\u0442\u043e \u0432\u0441\u0435
    \u0442\u0440\u0438 \u043c\u0435\u0434\u0438\u0430\u043d\u044b \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430
    \u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u044e\u0442\u0441\u044f \u0432 \u043e\u0434\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u0435 (\u0446\u0435\u043d\u0442\u0440\u043e\u0438\u0434). \u042d\u0442\u043e
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u0435\u0449\u0435 \u0432 \u0434\u0440\u0435\u0432\u043d\u043e\u0441\u0442\u0438, \u043d\u043e
    \u0438\u043c\u0435\u043d\u043d\u043e \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0434\u0430\u043b
    \u0435\u043c\u0443 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435.
    \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u0430 \u043a\u0440\u0443\u0433\u0430
    \u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044f: \u041e\u043d
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0437\u0430\u0434\u0430\u0447\u0435\u0439
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u044b \u043a\u0440\u0443\u0433\u0430,
    \u043d\u0430\u0439\u0434\u044f \u0432\u0435\u0441\u044c\u043c\u0430 \u0442\u043e\u0447\u043d\u043e\u0435
    \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0435 \u0447\u0438\u0441\u043b\u0430
    \u03c0 (\u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0434\u0440\u043e\u0431\u044c 864/275, \u0447\u0442\u043e \u0434\u0430\u0435\u0442 3.1418
    \u2014 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u0432\u044b\u0448\u0435, \u0447\u0435\u043c
    \u0443 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430, \u0445\u043e\u0442\u044f \u0438
    \u043d\u0435 \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u044f\u0449\u0430\u044f
    \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438). \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430: \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u0432\u0432\u0435\u043b \u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e \u043e\u0431\u0449\u0435\u0433\u043e
    \u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044f, \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u0432
    \u0435\u0433\u043e \u0432 \u0444\u043e\u0440\u043c\u0435, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439
    \u0434\u043b\u044f \u043a\u0443\u043f\u0446\u043e\u0432 (\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u0435). --- 6. \u0418\u043d\u043d\u043e\u0432\u0430\u0446\u0438\u0438
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u043e\u0442\u0430\u0446\u0438\u0438 \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0437\u0430\u043f\u0438\u0441\u0438
    \u0434\u0440\u043e\u0431\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0439: \u0426\u0435\u043f\u043d\u044b\u0435 \u0434\u0440\u043e\u0431\u0438:
    \u041f\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u0435 \u0441 \u0434\u0440\u043e\u0431\u044f\u043c\u0438
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u0437\u0430\u043f\u0438\u0441\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043f\u043d\u044b\u0445
    (\u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445) \u0434\u0440\u043e\u0431\u0435\u0439.
    \u0427\u0435\u0440\u0442\u0430 \u0434\u0440\u043e\u0431\u0438: \u0425\u043e\u0442\u044f
    \u043e\u043d \u043d\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0434\u0440\u043e\u0431\u043d\u0443\u044e \u0447\u0435\u0440\u0442\u0443 (\u044d\u0442\u043e
    \u0441\u0434\u0435\u043b\u0430\u044e\u0442 \u0430\u0440\u0430\u0431\u044b), \u0438\u043c\u0435\u043d\u043d\u043e
    \u0447\u0435\u0440\u0435\u0437 \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0438 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0446\u044b
    \u0443\u0441\u0432\u043e\u0438\u043b\u0438 \u0437\u0430\u043f\u0438\u0441\u044c \u0434\u0440\u043e\u0431\u0435\u0439
    \u0441 \u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u0435\u043c \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0430\u0442\u0435\u043b\u0435\u043c,
    \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u0434\u0440\u0443\u0433
    \u043d\u0430\u0434 \u0434\u0440\u0443\u0433\u043e\u043c. \u0421\u0442\u0435\u043f\u0435\u043d\u0438:
    \u041e\u043d \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432
    (`zensus`), \u043a\u0443\u0431\u043e\u0432 (`cubus`) \u0438 \u0431\u0438\u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432
    (`census census`), \u0441\u043e\u0437\u0434\u0430\u0432 \u0431\u0430\u0437\u0443, \u043d\u0430
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438\u0441\u0442\u0430
    \u043b\u0435\u0442 \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 \u0438
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u043e\u0441\u0442\u0440\u043e\u044f\u0442 \u0431\u0443\u043a\u0432\u0435\u043d\u043d\u0443\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443. --- \u0420\u0435\u0437\u044e\u043c\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0412\u043a\u043b\u0430\u0434 \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0432
    \u043d\u0430\u0443\u043a\u0443 \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d \u0442\u0435\u043c,
    \u0447\u0442\u043e \u043e\u043d \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u043f\u043e\u0434\u043d\u044f\u043b \u0438 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0443\u044e,
    \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041e\u043d \u0431\u044b\u043b
    \u043f\u0435\u0440\u0432\u044b\u043c \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0446\u0435\u043c
    \u043f\u043e\u0441\u043b\u0435 \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0420\u0438\u043c\u0430,
    \u043a\u0442\u043e: 1. \u0414\u043e\u043a\u0430\u0437\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043d\u043e\u0432\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    2. \u0420\u0435\u0448\u0438\u043b \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0442\u0440\u0435\u0442\u044c\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0441
    \u043d\u0435\u0434\u043e\u0441\u0442\u0438\u0436\u0438\u043c\u043e\u0439 \u0434\u043b\u044f
    XIII \u0432\u0435\u043a\u0430 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e. 3.
    \u041f\u0440\u043e\u0432\u0435\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    4. \u0421\u0432\u044f\u0437\u0430\u043b \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0441
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u0432 \u0435\u0434\u0438\u043d\u0443\u044e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443. \u0424\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438,
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0441\u043e\u0437\u0434\u0430\u043b
    \u0442\u043e\u0442 \u044f\u0437\u044b\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430
    \u0415\u0432\u0440\u043e\u043f\u0430 \u0434\u043e \u044d\u043f\u043e\u0445\u0438 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u0430 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u043d\u0435\u043f\u0440\u0435\u0432\u0437\u043e\u0439\u0434\u0435\u043d\u043d\u043e\u0439
    \u0434\u043e \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0440\u0430\u0431\u043e\u0442
    \u041f\u044c\u0435\u0440\u0430 \u0424\u0435\u0440\u043c\u0430 \u0432 XVII \u0432\u0435\u043a\u0435."
  achievementsEn: "Leonardo Pizansky (Phibonacci)'s achievements go well beyond the mere \"injection of numbers\" to Europe, which was a pioneer who laid the foundation for commercial mathematics, algebra and number theory for centuries to come, and its contribution can be divided into four global areas: arithmetic revolution, algebraic methods, geometric practices, and pure number theory.1. The promotion of the decimal position system (Arifmatic Revolution) is the main achievement of Fibonacci, which has changed European science. In his Book of Abaka (1202/1228), he did not simply describe the numbers, he mathematically justified their use. The introduction of zero and bits: Leonardo made it clear that the value of the figure depends on its position (units, tens, hundreds).He introduced zero into the universe (`zephirum') not just as an empty place, but as a full number involved in the calculations.Practical tables: He has developed tables for the translation of currencies, weight measures and length (e.g. tables for converting Pisa lire into Sicilian ounces), which has made his book a desktop tool for traders. > It is important: It is because of the credibility and clarity of Fibonacci's presentation that the buyers of Florence and Pisa have officially moved to \"Indian method\" by replacing the Abaka account and Roman figures from business documents by the end of the 13th century. -- 2.The contribution to the algebra and the methods of solving the Fibonacci equations has greatly advanced the algebraic knowledge borrowed from Arabs (al-Khorezmi) and Indians, but has systematized them and supplemented them with its own findings. The solution to the cube equations: This is its outstanding achievement. At the 1225 mathematical tournament at the Frederick II court, he was asked to solve the equation x3 + 2x2 + 10x = 20.Fibonacci proved that the root of this equation is neither a whole number, nor a rational fraction, nor a square irrationality (i.e., not expressed through G). He found a near value of the root to the 9th point after the decimal point: x = 1.368808107... This result was phenomenal for his time. He used the techniques of Babylon's appendix, which only Stevin discovered in Europe in the 16th century.The method of false position (Regula Falsi): He adapted and improved the ancient method of solving linear equations, reducing it to strict algorithms. Square equations: Fibonacci gave a complete classification of square equations and strict geometric evidence of their decisions, using not only positive but also allowing negative roots (in the accounts) as \"debts\".Theoretical anticipation: Although he did not use the literal algebra (it will appear only in Viet), he introduced a common terminology for unknown, squared and cubic numbers, which simplified the perception of complex problems. -- 3. The number theory (\"Liber Quadratorum Book\") This work (1225) is considered to be the top of Fibonacci's mathematical genius.===Congrut numbers===Congrut numbers: Fibonacci gave a complete description of the so-called \"congrut numbers\" (congrum). It opened the formula for finding numbers that are at the same time the sum of squares of two different pairs of numbers. For example, the number 5 is congruant, because 5 = 12 + 22 and it is also the difference between squares.Trance Fibonacci (Brahmagupty-Phibonacci): It has proved the identity strictly to represent the work of two squares in the sum of two squares: (a2 + b2) (c2 + d2) = (ac ± bd)2 + (ad × bc)2 This identity has become the basis for the entire subsequent theory of pythagoras and has been applied even in the theory of composite numbers and algebraic norms.Diofant equations: In the Book of Squares, he solved a series of complex, uncertain equations (Diofant analysis), showing how to find whole solutions for the equations of the species x2 + y2 = z2, not just a three series, but a series of threes with specified properties. Cubes: He found methods to find numbers that could be divided into two cubes in several ways, which for hundreds of years pre-empted the task of a taxi (Hardy Ramnujan number).The sequence of Fibonacci and Combinatorics The most famous discovery was in fact a beautiful illustration of Leonardo's task of breeding rabbits in chapter 12, Books Abaca, but his contribution to this area is huge: the sequence itself: 1, 1, 2, 3, 5, 8, 13, 21, 34... Recurring rule: He first made clear the recurring ratio (each number equals the sum of the two preceding ones).Binomic coefficients: Working in sequence, Fibonacci observed that the sum of diagonal elements in the Pascal triangle (which was not yet known in Europe) gave the same numbers. He laid the basis for calculating the number of combinations (although he did not produce the general formula).Relationship to geometry: In Geometry Practice, he showed that the ratio of neighbouring numbers to Fibonacci is \"glorious proportion\" (gold section, ~ ~ ~ 1.618), although the term \"golden section\" itself will appear later. He used this to build right polygons and divide the segments in extreme and medium terms. --5.In this tract (1220) Fibonacci acted as a systemizer of euclidic geometry, applying algebraic methods to geometric tasks. Trigonometry: He introduced into European practice the use of sinus and chords (although not called them), adapting Arab trigonometry tables to measure the heights of buildings and distances to inaccessible objects.The mid-point theory: Fibonacci has the first hard evidence in the history of mathematics that all three medians of the triangle intersect at one point (the centroid), a property that was used in ancient times, but it was Leonardo who gave him the rationale.The quadratur of the circle and approach: He was involved in the quadratic task of the circle, finding a very precise approach to the number pi (he used the shotgun 864/275, which gives 31418 greater accuracy than Archimedes, although not exceeding the Chinese methods of the time).Innovations in Fibonacci's mathematical nod created a fraction recording system that was used in Europe for centuries: chain fractions: He used a positional record that was the precursor to modern chain (continuous) fractions when working on fractions.He did not invent a horizontal fraction line (the Arabs will do so), but it was through his books that Europeans learned the recording of fractions with numerator and denominator above each other. Stepeni: He standardized the symbols for squares ('zensus'), cubes ('cubus') and biquadrates ('census census'), creating a base on which François Veet and Decart would build a literal algebra in three hundred years.---A summary of the significance of Fibonacci's contribution to science is unique in that he simultaneously raised both applied and fundamental mathematics. He was the first European to have been able to do this after the fall of Rome, who: 1. Proved the mathematical validity of the new numeracy system. 2. He decided the third degree equation with the precision that was not possible for the 13th century. 3. He conducted a thorough study of the diofant equations. 4. Linked the algebra to Euclid's geometry into a single practical discipline.In fact, Fibonacci created the language of mathematics that Europe spoke before the Renaissance, and his number theory remained unmatched until Pierre Ferm's 17th century work."
  personalLifeRu: "\u041e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u041f\u0438\u0437\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    (\u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438) \u043c\u043e\u0436\u043d\u043e
    \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u043e\u0434\u043d\u043e: \u043e\u043d\u0430
    \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043a\u0440\u044b\u0442\u043e\u0439
    \u043e\u0442 \u043d\u0430\u0441. \u0412 \u044d\u0442\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435
    \u043e\u043d \u0431\u044b\u043b \"\u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0431\u0435\u0437 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438\". \u0415\u0441\u043b\u0438
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b
    \u0438 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u0445\u043e\u0440\u043e\u0448\u043e
    \u0437\u0430\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u044b
    \u0432 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u0435\u0434\u0438\u0441\u043b\u043e\u0432\u0438\u044f\u0445, \u0442\u043e \u0432\u0441\u044f
    \"\u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0430\u044f\" \u0441\u0442\u043e\u0440\u043e\u043d\u0430,
    \u043a\u0430\u043a \u044d\u0442\u043e \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u0432\u0430\u0435\u0442
    \u0441 \u0443\u0447\u0451\u043d\u044b\u043c\u0438 \u0421\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u044c\u044f,
    \u043e\u043a\u0443\u0442\u0430\u043d\u0430 \u043c\u0440\u0430\u043a\u043e\u043c. \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0441\u0435\u043c\u044c\u0438: \u0416\u0435\u043d\u0430\u0442 \u043b\u0438 \u043e\u043d
    \u0431\u044b\u043b \u0438 \u0431\u044b\u043b\u0438 \u043b\u0438 \u0443 \u043d\u0435\u0433\u043e
    \u0434\u0435\u0442\u0438? \u041d\u0430 \u044d\u0442\u043e\u0442 \u0432\u043e\u043f\u0440\u043e\u0441
    \u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432 \u0435\u0441\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0434\u0438\u043d \u043e\u0442\u0432\u0435\u0442: \u043d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u0438\u0445
    \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439. \u041d\u0438 \u0432 \u043e\u0434\u043d\u043e\u043c
    \u0438\u0437 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0438\u0445\u0441\u044f
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u2014 \u043d\u0438 \u0432
    \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0430\u0445, \u043d\u0438 \u0432 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0437\u0430\u043f\u0438\u0441\u044f\u0445 \u041f\u0438\u0437\u044b \u2014 \u043d\u0435\u0442
    \u043d\u0438 \u043c\u0430\u043b\u0435\u0439\u0448\u0435\u0433\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f
    \u043e \u0436\u0435\u043d\u0435 \u0438\u043b\u0438 \u0434\u0435\u0442\u044f\u0445. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u043c,
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435,
    \u0447\u0442\u043e \u043e\u043d \u0442\u0430\u043a \u0438 \u043d\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u0438 \u043d\u0435 \u0438\u043c\u0435\u043b \u043f\u043e\u0442\u043e\u043c\u0441\u0442\u0432\u0430.
    \u041f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u0433\u043b\u0438
    \u0431\u044b\u0442\u044c \u0435\u0433\u043e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438,
    \u0430 \u0432 \u0437\u0440\u0435\u043b\u043e\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u2014 \u043f\u043e\u043b\u043d\u0430\u044f \u043f\u043e\u0433\u0440\u0443\u0436\u0451\u043d\u043d\u043e\u0441\u0442\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432\u0430\u0436\u043d\u043e \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u043d\u0443\u0442\u044c:
    \u044d\u0442\u043e \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c \u0434\u043e\u0433\u0430\u0434\u043a\u0430,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u043c\u043e\u043b\u0447\u0430\u043d\u0438\u0438
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432. \u0421\u0435\u043c\u044c\u044f
    \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0417\u0434\u0435\u0441\u044c
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0431\u043e\u043b\u0435\u0435 \u044f\u0441\u043d\u0430,
    \u0445\u043e\u0442\u044f \u0438 \u043d\u0435 \u0431\u0435\u0437 \u043d\u044e\u0430\u043d\u0441\u043e\u0432.
    \u041e\u0442\u0435\u0446: \u0413\u0443\u043b\u044c\u0435\u043b\u044c\u043c\u043e (\u0413\u0438\u043b\u044c\u0435\u0440\u043c\u043e).
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c
    \u0441\u0435\u043c\u044c\u0438 \u0411\u043e\u043d\u0430\u0447\u0447\u0438 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u043f\u0438\u0441\u0430\u0440\u044f (publicus scriba) \u0438\u043b\u0438 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044f
    \u041f\u0438\u0437\u0430\u043d\u0441\u043a\u043e\u0439 \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438.
    \u0412\u0430\u0436\u043d\u043e \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u044c: \u043e\u043d
    \u043d\u0435 \u0431\u044b\u043b \"\u0441\u044b\u043d\u043e\u043c \u0411\u043e\u043d\u0430\u0447\u0447\u0438\"
    (filius Bonacci) \u0432 \u043f\u0440\u044f\u043c\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435,
    \u0430 \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u044d\u0442\u043e\u0433\u043e
    \u0440\u043e\u0434\u0430. \u041f\u0440\u043e\u0437\u0432\u0438\u0449\u0435 \"\u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438\",
    \u043f\u043e\u0434 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043c\u044b \u0435\u0433\u043e
    \u0437\u043d\u0430\u0435\u043c, \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u043e \u043a\u0430\u043a
    \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043e\u0442 \"filius Bonacci\"
    \u0438 \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043d\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u043c
    \u0413\u0438\u0439\u043e\u043c\u043e\u043c \u041b\u0438\u0431\u0440\u0438 \u043b\u0438\u0448\u044c
    \u0432 XIX \u0432\u0435\u043a\u0435. \u041c\u0430\u0442\u044c: \u0412 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043c\u0430\u0442\u044c \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e
    \u0437\u0432\u0430\u043b\u0438 \u0410\u043b\u0435\u0441\u0441\u0430\u043d\u0434\u0440\u0430
    \u0438 \u043e\u043d\u0430 \u0443\u043c\u0435\u0440\u043b\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u043e\u043a\u043e\u043b\u043e \u0434\u0435\u0432\u044f\u0442\u0438
    \u043b\u0435\u0442, \u043d\u043e \u044d\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435
    \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0431\u0449\u0435\u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c
    \u0438 \u0447\u0430\u0441\u0442\u043e \u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u043e\u0439 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435.
    \u041f\u0440\u043e\u0437\u0432\u0438\u0449\u0435 \"\u0411\u0438\u0433\u043e\u043b\u043b\u043e\"
    (Bigollo) \u041f\u043e\u043c\u0438\u043c\u043e \"\u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438\",
    \u0443 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0431\u044b\u043b\u043e \u0435\u0449\u0451
    \u043e\u0434\u043d\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043e\u043d, \u043a\u0430\u043a \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442, \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u0441\u0430\u043c \u2014 \u0411\u0438\u0433\u043e\u043b\u043b\u043e (Bigollo). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u044d\u0442\u043e\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e:
    \u0412 \u0442\u043e\u0441\u043a\u0430\u043d\u0441\u043a\u043e\u043c \u0434\u0438\u0430\u043b\u0435\u043a\u0442\u0435
    \u043e\u043d\u043e \u043c\u043e\u0433\u043b\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c
    \"\u0431\u0435\u0437\u0434\u0435\u043b\u044c\u043d\u0438\u043a\" \u0438\u043b\u0438 \"\u043b\u043e\u0434\u044b\u0440\u044c\"
    (bighellone) \u2014 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441 \u043b\u0451\u0433\u043a\u043e\u0439
    \u0438\u0440\u043e\u043d\u0438\u0435\u0439 \u043e\u0442 \u0437\u0435\u043c\u043b\u044f\u043a\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u043b\u0438
    \u0435\u0433\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0447\u0438\u0441\u0442\u043e\u0439,
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0447\u0438\u0441\u0435\u043b. \u0421 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b,
    \u044d\u0442\u043e \u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u043c\u043e\u0433\u043b\u043e
    \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c \"\u043c\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u0439\",
    \u0447\u0442\u043e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0442\u043e\u0447\u043d\u043e
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b: \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435, \u0447\u0442\u043e \u043c\u044b
    \u0437\u043d\u0430\u0435\u043c \u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438,
    \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f \u0432 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0435 \u043e\u0442 1240 \u0433\u043e\u0434\u0430.
    \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430 \u041f\u0438\u0437\u0430 \u043f\u0440\u0438\u043d\u044f\u043b\u0430
    \u0443\u043a\u0430\u0437 \u043e \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0438
    \"\u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e\u0433\u043e \u0438 \u0443\u0447\u0451\u043d\u043e\u0433\u043e
    \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e
    \u0411\u0438\u0433\u043e\u043b\u043b\u043e\" (discretus et sapiens) \u0435\u0436\u0435\u0433\u043e\u0434\u043d\u044b\u043c
    \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u044c\u0435\u043c \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u0435
    20 \u043b\u0438\u0440. \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0435\u043d\u0441\u0438\u044f, \u0430 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0435\u0433\u043e \u0437\u0430\u0441\u043b\u0443\u0433 \u043f\u0435\u0440\u0435\u0434 \u0433\u043e\u0440\u043e\u0434\u043e\u043c
    \u0438 \u0435\u0433\u043e \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0430\u043c\u0438,
    \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0435 \u0432 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0438
    \u0437\u0430 \u0435\u0433\u043e \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0438
    \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u0443\u0441\u043b\u0443\u0433\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d,
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0433\u043e\u0440\u043e\u0434\u0443 \u043f\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c
    \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0438\u0438 \u0438 \u0441\u0447\u0435\u0442\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0430.
    \u042d\u0442\u0430 \u0437\u0430\u043f\u0438\u0441\u044c \u2014 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435
    \u043e \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u0440 \u0432 \u041f\u0438\u0437\u0435
    \u043c\u0435\u0436\u0434\u0443 1240 \u0438 1250 \u0433\u043e\u0434\u0430\u043c\u0438, \u043d\u043e
    \u0442\u043e\u0447\u043d\u0430\u044f \u0434\u0430\u0442\u0430 \u0438 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438. \u0422\u0430\u043a\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u2014 \u044d\u0442\u043e \u043f\u043e\u0447\u0442\u0438
    \u0441\u043f\u043b\u043e\u0448\u043d\u043e\u0435 \u0431\u0435\u043b\u043e\u0435 \u043f\u044f\u0442\u043d\u043e.
    \u041c\u044b \u0437\u043d\u0430\u0435\u043c \u0435\u0433\u043e \u043a\u0430\u043a \u0444\u0438\u0433\u0443\u0440\u0443
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0438 \u043d\u0430\u0443\u0447\u043d\u0443\u044e: \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430,
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430, \u0443\u0447\u0438\u0442\u0435\u043b\u044f,
    \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044f \u0438 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430.
    \u0412\u0441\u0451, \u0447\u0442\u043e \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f
    \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438."
  personalLifeEn: "One thing about Leonardo Pizano (Phibonacci)'s personal life is that it remains almost completely hidden from us, in this sense, \"a man without a biography.\" If his research and travel are well documented in his own forewords, then the whole human side, as is often the case with Middle Age scientists, is covered with darkness.No family: Was he married or had any children? The only answer to this question is that historians have no information. None of the remaining documents, either in his books or in his official records of Pisa, have any mention of his wife or children. According to some sources, there is a presumption that he never married or had no offspring.The reason for this may have been his constant travel in his youth, and in his mature age, his complete involvement in science and teaching, but it is important to emphasize that this is just a guess based on the silence of the sources. The family and origin here are clearer, though not without nuances. Father: Guillemeau (Hillermo), his father was a member of the Bonacci family and was a public writer (publicus scriba) or secretary of the Republic of Pisa.It's important to make it clear that he was not a son of Bonacci, but a member of that kind, but a member of that kind. The name \"Phibonacci\", by which we know him, arose as a reduction from \"file Bonacci\" and was invented by historian Guillaume Libri only in the nineteenth century.Mother: Some sources mention that Leonardo's mother was named Alessandra and she died when he was about nine years old, but this claim is not generally accepted and is often not supported by authoritative literature.The meaning of this word is mixed: in the Tuscany dialect, it could have meant \"bighelone\" or \"bail\" — perhaps with a slight irony from the countrymen who did not understand his passion for pure, abstract number theory. On the other hand, the same word could have meant \"many traveling,\" which was perfectly consistent with his biography.Recent years: The only documentary evidence we know about his life is contained in an official document dated 1240, and the Republic of Pisa has adopted a decree awarding a \"serious and scientific master of Leonardo Bigolo\" (discretus et sapiens) annual salary of 20 lire.It was not just a pension, but a recognition of his honour to the city and its citizens, expressed in gratitude for his training and the advice he may have provided to the city on accounting and accounting matters, the last historical mention of Fibonacci, and he died in Pisa between 1240 and 1250, but the exact date and circumstances of his death remain unknown.So Fibonacci's personal life is almost a white stain, and we know it as a figure of exclusively social and scientific life: traveler, student, teacher, writer, and counselor, everything about his private life is out of history."
  shortBioRu: "\u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u041f\u0438\u0437\u0430\u043d\u0441\u043a\u0438\u0439
    (\u043e\u043a. 1170 \u2014 \u043e\u043a. 1250), \u0431\u043e\u043b\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043f\u043e\u0434 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435\u043c \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438,
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u043a\u0440\u0443\u043f\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0441\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u043e\u0439
    \u0415\u0432\u0440\u043e\u043f\u044b. \u0415\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0430\u044f
    \u0437\u0430\u0441\u043b\u0443\u0433\u0430 \u2014 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0438\u043d\u0434\u043e-\u0430\u0440\u0430\u0431\u0441\u043a\u043e\u0439
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u043f\u0438\u0441\u0430\u043b \u0432 \u0441\u0432\u043e\u0435\u043c \u0433\u043b\u0430\u0432\u043d\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u2014 \u00ab\u041a\u043d\u0438\u0433\u0435 \u0430\u0431\u0430\u043a\u0430\u00bb.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u044d\u0442\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0430\u043a\u0442\u0430\u0445
    \u0438 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445. \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f
    \u041e \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043d\u0435\u043c\u043d\u043e\u0433\u043e, \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043c\u044b \u0447\u0435\u0440\u043f\u0430\u0435\u043c
    \u0438\u0437 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043a\u043d\u0438\u0433. \u041e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432
    \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435
    \u041f\u0438\u0437\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445
    \u0442\u043e\u0440\u0433\u043e\u0432\u044b\u0445 \u0446\u0435\u043d\u0442\u0440\u043e\u0432
    \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e\u043c\u043e\u0440\u044c\u044f.
    \u0422\u043e\u0447\u043d\u044b\u0439 \u0433\u043e\u0434 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d, \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u043a
    \u043c\u0435\u0436\u0434\u0443 1170 \u0438 1180 \u0433\u043e\u0434\u0430\u043c\u0438. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446, \u0413\u0438\u043b\u044c\u0435\u0440\u043c\u043e (\u0413\u0443\u043b\u044c\u0435\u043b\u044c\u043c\u043e),
    \u0431\u044b\u043b \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0435\u043c \u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0442\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u043e\u0433\u043e
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044f
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u043f\u0438\u0437\u0430\u043d\u0441\u043a\u0438\u0445
    \u043a\u0443\u043f\u0446\u043e\u0432 \u0432 \u0421\u0435\u0432\u0435\u0440\u043d\u043e\u0439
    \u0410\u0444\u0440\u0438\u043a\u0435, \u0432 \u043f\u043e\u0440\u0442\u0443 \u0411\u0435\u0434\u0436\u0430\u044f
    (\u043d\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0410\u043b\u0436\u0438\u0440\u0430). \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c,
    \u0435\u0449\u0435 \u0432 \u043e\u0442\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u0435,
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u043d\u0430\u0447\u0430\u043b \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u0416\u0435\u043b\u0430\u044f,
    \u0447\u0442\u043e\u0431\u044b \u0441\u044b\u043d \u043f\u043e\u0448\u0435\u043b \u043f\u043e
    \u0435\u0433\u043e \u0441\u0442\u043e\u043f\u0430\u043c, \u043e\u0442\u0435\u0446 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0435\u0433\u043e \u0432 \u0410\u043b\u0436\u0438\u0440, \u0433\u0434\u0435 \u044e\u043d\u043e\u0448\u0430
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u00ab\u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u043c
    \u043c\u0435\u0442\u043e\u0434\u043e\u043c\u00bb \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0443 \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0445 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439.
    \u041e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u043e\u0439
    \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\u044e
    \u044d\u0442\u0438\u0445 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439, \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u0434\u043e\u043b\u0433\u0438\u0435
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u043f\u043e \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e\u043c\u043e\u0440\u044c\u044e.
    \u041e\u043d \u043f\u043e\u0441\u0435\u0442\u0438\u043b \u0415\u0433\u0438\u043f\u0435\u0442,
    \u0421\u0438\u0440\u0438\u044e, \u0412\u0438\u0437\u0430\u043d\u0442\u0438\u044e (\u0413\u0440\u0435\u0446\u0438\u044e),
    \u0421\u0438\u0446\u0438\u043b\u0438\u044e \u0438 \u041f\u0440\u043e\u0432\u0430\u043d\u0441.
    \u0426\u0435\u043b\u044c\u044e \u044d\u0442\u0438\u0445 \u043f\u043e\u0435\u0437\u0434\u043e\u043a
    \u0431\u044b\u043b\u043e \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0432 \u044d\u0442\u0438\u0445 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0445. \u041f\u043e
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c,
    \u043e\u043d \u00ab\u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u043c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u043c\u0443
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e \u0438\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0438 \u043e\u0432\u043b\u0430\u0434\u0435\u043b \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u0440\u0430\u00bb. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0438 \u00ab\u041a\u043d\u0438\u0433\u0430 \u0430\u0431\u0430\u043a\u0430\u00bb \u041e\u043a\u043e\u043b\u043e
    1200 \u0433\u043e\u0434\u0430 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u041f\u0438\u0437\u0443, \u0433\u0434\u0435 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0438\u043b
    \u043a \u0440\u0430\u0431\u043e\u0442\u0435 \u043d\u0430\u0434 \u0441\u0432\u043e\u0438\u043c
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0442\u0440\u0443\u0434\u043e\u043c \u2014 \u00ab\u041a\u043d\u0438\u0433\u043e\u0439
    \u0430\u0431\u0430\u043a\u0430\u00bb (Liber Abaci). \u041f\u0435\u0440\u0432\u043e\u0435
    \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u043d\u0438\u0433\u0438 \u0431\u044b\u043b\u043e
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e \u0432 1202 \u0433\u043e\u0434\u0443,
    \u043d\u043e \u0434\u043e \u043d\u0430\u0441 \u0434\u043e\u0448\u043b\u0430 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0435\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f
    1228 \u0433\u043e\u0434\u0430. \u0421\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435
    \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u041a\u043d\u0438\u0433\u0430
    \u043d\u0435 \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430
    \u0441\u0447\u0435\u0442\u043d\u043e\u0439 \u0434\u043e\u0441\u043a\u0435 (\u0430\u0431\u0430\u043a\u0435),
    \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u044b
    \u043f\u043e\u0434\u0443\u043c\u0430\u0442\u044c \u0438\u0437 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f.
    \u041d\u0430\u043f\u0440\u043e\u0442\u0438\u0432, \u043e\u043d\u0430 \u0441\u043b\u0443\u0436\u0438\u043b\u0430
    \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0438\u043c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u043f\u043e \u043d\u043e\u0432\u043e\u0439 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u043e\u0439
    \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0434\u0435\u0441\u044f\u0442\u044c \u00ab\u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u0445
    \u0444\u0438\u0433\u0443\u0440\u00bb (\u0446\u0438\u0444\u0440 \u043e\u0442 0 \u0434\u043e
    9) \u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043c\u0435\u0441\u0442\u0430 \u0447\u0438\u0441\u043b\u0430.
    \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430: \u00ab\u041a\u043d\u0438\u0433\u0430
    \u0430\u0431\u0430\u043a\u0430\u00bb \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430 \u0438\u0437
    15 \u0433\u043b\u0430\u0432, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0431\u044b\u043b\u0438
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u044b:
    \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u0446\u0435\u043b\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0441
    \u0434\u0440\u043e\u0431\u044f\u043c\u0438. \u0417\u0430\u0434\u0430\u0447\u0438 \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438: \u0440\u0430\u0441\u0447\u0435\u0442
    \u043f\u0440\u0438\u0431\u044b\u043b\u0438, \u043e\u0431\u043c\u0435\u043d \u0432\u0430\u043b\u044e\u0442,
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u043c\u0435\u0440 \u0438 \u0432\u0435\u0441\u043e\u0432,
    \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u044b. \u041f\u0440\u0430\u0432\u0438\u043b\u0430
    \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u0439
    (\u00ab\u0442\u0440\u043e\u0439\u043d\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e\u00bb)
    \u0438 \u043c\u0435\u0442\u043e\u0434 \u043b\u043e\u0436\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f.
    \u0417\u0430\u0434\u0430\u0447\u0438 \u043d\u0430 \u0441\u0443\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0440\u044f\u0434\u043e\u0432, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0438.
    \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430
    \u043e \u043a\u0440\u043e\u043b\u0438\u043a\u0430\u0445, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0438\u0432\u0435\u043b\u0430 \u043a \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0447\u0438\u0441\u0435\u043b 1, 1, 2, 3, 5, 8, 13... (\u0445\u043e\u0442\u044f \u0441\u0430\u043c\u043e
    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u00ab\u0447\u0438\u0441\u043b\u0430 \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438\u00bb
    \u0437\u0430\u043a\u0440\u0435\u043f\u0438\u043b\u043e\u0441\u044c \u0437\u0430 \u043d\u0438\u043c\u0438
    \u043b\u0438\u0448\u044c \u0432 XIX \u0432\u0435\u043a\u0435). \u041f\u0440\u0438\u0435\u043c\u044b
    \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445
    \u0438 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0440\u043d\u0435\u0439,
    \u043f\u0440\u0438\u043c\u0435\u0440\u044b \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    (\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d \u0442\u0440\u0430\u043a\u0442\u043e\u0432\u0430\u043b
    \u043a\u0430\u043a \u0434\u043e\u043b\u0433). \u041a\u0430\u043a \u043e\u0442\u043c\u0435\u0447\u0430\u043b
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0410. \u041f. \u042e\u0448\u043a\u0435\u0432\u0438\u0447, \u044d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u0440\u0435\u0437\u043a\u043e \u0432\u043e\u0437\u0432\u044b\u0448\u0430\u0435\u0442\u0441\u044f
    \u043d\u0430\u0434 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u043e-\u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u0439 XII\u2014XIV \u0432\u0435\u043a\u043e\u0432
    \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435\u043c \u0438 \u0441\u0438\u043b\u043e\u0439
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432\u00bb. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0422\u0430\u043b\u0430\u043d\u0442 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u043d\u0435
    \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u043d\u0435\u0437\u0430\u043c\u0435\u0447\u0435\u043d\u043d\u044b\u043c.
    \u0415\u0433\u043e \u043a\u043d\u0438\u0433\u0430 \u0438 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044f
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u043b\u0438 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0421\u0432\u044f\u0449\u0435\u043d\u043d\u043e\u0439
    \u0420\u0438\u043c\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430
    II \u0413\u043e\u0433\u0435\u043d\u0448\u0442\u0430\u0443\u0444\u0435\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439
    \u043b\u044e\u0431\u043e\u0432\u044c\u044e \u043a \u043d\u0430\u0443\u043a\u0430\u043c \u0438
    \u043e\u043a\u0440\u0443\u0436\u0438\u043b \u0441\u0435\u0431\u044f \u0443\u0447\u0435\u043d\u044b\u043c\u0438.
    \u041e\u043a\u043e\u043b\u043e 1225 \u0433\u043e\u0434\u0430, \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0432\u0438\u0437\u0438\u0442\u043e\u0432
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0432 \u041f\u0438\u0437\u0443,
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0431\u044b\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d
    \u043a\u043e \u0434\u0432\u043e\u0440\u0443. \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0443\u0440\u043d\u0438\u0440
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0441\u044f \u043f\u0440\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0438
    \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u0432 \u0442\u043e\u043c
    \u0447\u0438\u0441\u043b\u0435 \u0418\u043e\u0430\u043d\u043d\u0430 \u041f\u0430\u043b\u0435\u0440\u043c\u0441\u043a\u043e\u0433\u043e.
    \u0418\u043e\u0430\u043d\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    x\u00b3 + 2x\u00b2 + 10x = 20. \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u0441\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0441 \u0437\u0430\u0434\u0430\u0447\u0435\u0439,
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0432 \u043a\u043e\u0440\u0435\u043d\u044c \u0441
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e 10\u207b\u2079, \u0438
    \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u0441\u0442\u0430\u043b
    \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u043d\u044b\u043c \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430,
    \u0436\u0438\u0432\u044f \u043f\u0440\u0438 \u0435\u0433\u043e \u0434\u0432\u043e\u0440\u0435.
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0412 \u044d\u0442\u043e\u0442 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0441\u043e\u0437\u0434\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b, \u043f\u043e\u043c\u0438\u043c\u043e \u00ab\u041a\u043d\u0438\u0433\u0438
    \u0430\u0431\u0430\u043a\u0430\u00bb: 1. \u00ab\u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb (Practica Geometriae, 1220)
    \u2014 \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0442\u0435\u043e\u0440\u0435\u043c \u0438\u0437
    \u00ab\u041d\u0430\u0447\u0430\u043b\u00bb \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0438
    \u0434\u0440\u0443\u0433\u0438\u0445 \u0440\u0430\u0431\u043e\u0442, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u044b\u0439
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u043c\u0435\u0442\u043e\u0434\u0430\u043c. \u0412 \u044d\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f
    \u043f\u0435\u0440\u0432\u043e\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u0442\u0440\u0438 \u043c\u0435\u0434\u0438\u0430\u043d\u044b \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430
    \u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u044e\u0442\u0441\u044f \u0432 \u043e\u0434\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u0435. 2. \u00ab\u041a\u043d\u0438\u0433\u0430 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432\u00bb
    (Liber Quadratorum, 1225) \u2014 \u0448\u0435\u0434\u0435\u0432\u0440 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e,
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u044b\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u041a\u043d\u0438\u0433\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432\u0442\u043e\u0440\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0442\u0430\u0432\u0438\u0442 \u0435\u0433\u043e
    \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434 \u0441 \u0441\u0430\u043c\u0438\u043c
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u043c \u0438 \u0431\u043e\u043b\u0435\u0435
    \u043f\u043e\u0437\u0434\u043d\u0438\u043c \u041f\u044c\u0435\u0440\u043e\u043c \u0424\u0435\u0440\u043c\u0430
    \u043a\u0430\u043a \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. 3. \u00ab\u0426\u0432\u0435\u0442\u043e\u043a\u00bb
    (Flos, 1225) \u2014 \u0440\u0430\u0431\u043e\u0442\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u0447,
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u0435\u043c\u0443
    \u043d\u0430 \u0442\u0443\u0440\u043d\u0438\u0440\u0435 \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 II. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043e \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u043f\u043e\u0441\u043b\u0435
    1228 \u0433\u043e\u0434\u0430 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043a
    1240 \u0433\u043e\u0434\u0443. \u0412 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0435
    \u041f\u0438\u0437\u0430\u043d\u0441\u043a\u043e\u0439 \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0441\u044f, \u0447\u0442\u043e \u0435\u043c\u0443
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u0435\u0436\u0435\u0433\u043e\u0434\u043d\u0430\u044f
    \u043f\u0435\u043d\u0441\u0438\u044f \u0437\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u0438
    \u043f\u0435\u0440\u0435\u0434 \u0433\u043e\u0440\u043e\u0434\u043e\u043c. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u0440 \u0432 \u041f\u0438\u0437\u0435
    \u043e\u043a\u043e\u043b\u043e 1250 \u0433\u043e\u0434\u0430. \u041f\u0440\u0438\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0445
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043e\u0432 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e
    \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c, \u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u2014 \u044d\u0442\u043e \u043f\u043b\u043e\u0434 \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u043e\u0432 \u0431\u043e\u043b\u0435\u0435
    \u043f\u043e\u0437\u0434\u043d\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e. \u041e\u043d \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b
    \u0415\u0432\u0440\u043e\u043f\u0443 \u0441 \u00ab\u0430\u0440\u0430\u0431\u0441\u043a\u0438\u043c\u0438\u00bb
    (\u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u043c\u0438) \u0446\u0438\u0444\u0440\u0430\u043c\u0438,
    \u043d\u043e \u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438\u0445
    \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430. \u0415\u0433\u043e
    \u00ab\u041a\u043d\u0438\u0433\u0430 \u0430\u0431\u0430\u043a\u0430\u00bb \u0441\u0442\u0430\u043b\u0430
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0443\u0447\u0438\u043b\u0438\u0441\u044c \u043c\u043d\u043e\u0433\u0438\u0435 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u0430 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b \u043f\u0440\u043e\u043b\u043e\u0436\u0438\u043b\u0438 \u043f\u0443\u0442\u044c
    \u0443\u0447\u0435\u043d\u044b\u043c \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.
    \u041d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f \u0432 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0447\u0438\u0441\u0435\u043b \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0435\u0439: \u0435\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438
    \u0431\u044b\u043b\u0438 \u043f\u043e\u0437\u0436\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u044b
    \u0432 \u043f\u0440\u0438\u0440\u043e\u0434\u0435 \u2014 \u0432 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435
    \u043b\u0438\u0441\u0442\u044c\u0435\u0432, \u0441\u043e\u0441\u043d\u043e\u0432\u044b\u0445
    \u0448\u0438\u0448\u0435\u043a \u0438 \u0441\u043f\u0438\u0440\u0430\u043b\u044f\u0445 \u0440\u0430\u043a\u043e\u0432\u0438\u043d."
  shortBioEn: "Leonardo Pizinski (c. 1170 – c. 1250), better known as Fibonacci, was the first major mathematician in medieval Europe, and his greatest credit is the spread of the Indo-Arab decimal system in Europe, which he described in detail and evidence in his main work, the Book of Abaka.The following is a detailed biography of this scientist, based on known historical facts and his own testimonies, and the early years and travels of Leonardo's life are not known much, and we draw basic information from his own books, and he was born in the Italian city of Pisa, one of the largest trading centres in the Mediterranean.The exact year of birth is unknown and historians call it the period between 1170 and 1180, and his father, Guillermo (Gulelmo), was a merchant and customs officer representing the interests of the Pezan merchants in North Africa, in the port of Bedjay (in modern Algeria), where Leonardo began studying mathematics.He asked his son to follow his footsteps to Algeria, where he was introduced to the \"Indian method\" of counting among Arab teachers.According to him, he \"did a great deal of work to study their methods in detail and mastered the art of scientific dispute.\" The return and \"The Book of Abaka\" around 1200 returned to Pisa, where he began work on his main work, \"Liber Abaci\", the first edition of the book was completed in 1202, but it only reached us in its amended version of 1228.Content and Meaning: The book was not devoted to the billboard, as one might think from the title. On the contrary, it served as a comprehensive guide to new arithmetic based on a decimal place system, and it was in this work that Leonardo popularized 10 Indian figures (number 0 to 9) and the principle of place of number.Structure: The Abaka Book consisted of 15 chapters detailing: Arifmetics of Whole Numbers and Actions with Scatters. The tasks of commercial arithmetic: Calculation of Gains, Exchange of Currency, Translation of Measures and Weights, Interest. Rules of Proportionality (\"the Three Rule\") and the Method of Falsification. The tasks of summation of series including geometric progress.The famous problem of rabbits, which led to a sequence of numbers 1, 1, 2, 3, 5, 8, 13 ... (although the name \"the number of Fibonacci\" was only established in the nineteenth century), took square and cubic roots, examples of square equations, and the use of negative numbers (which he interpreted as debt).Yushkevich, this work \"is highly exalted over the European arithmetical-algebraic literature of the XIIth to XIVth centuries by diversity and force of methods.\" The recognition and court life of Talent Leonardo was not undetected. His book and reputation for brilliant mathematics attracted the attention of the emperor of the Holy Roman Empire, Friedrich II Gaugstaufen, who was known for his love for science and surrounded himself by scientists.In about 1225, during one of the Emperor's visits to Pisa, Leonardo was invited to the court, and the famous math tournament was attended by court philosophers and mathematicians, including John Palermo, and John offered Leonardo several difficult tasks, including the resolution of the cubic equation x3 + 2x2 + 10x = 20.Fibonacci did a brilliant job of calculating the root to the exact 10 - 9th, and for a few years he became the Emperor's closest man, living in his court. In this fruitful period, Leonardo created his main scientific works, in addition to \"The Book of Abaka\": 1. \"The Practice of Geometry\" (Practica Geometriae, 1220) is a collection of theorems from Euclid's \"First\" and other works on practical measurement methods.This book contains, among other things, the first known evidence that the three medians of the triangle overlap at one point. 2. \"Liber Quadratorum\" (1225) is Leonardo's masterpiece on numbers theory. The book systematically considers the second degree diofents. This work rightfully puts it in the same line as Diofant himself and later Pierre Ferma as the largest specialist in this field.\"Flos, 1225) is a work that contains the solutions to the algebraic problems offered to him at the Friedrich II Court. Recent years and legacy The only reliable evidence of Leonardo's life after 1228 is in 1240. The document of the Republic of Piza states that he was awarded an annual pension for his honour before the city. He is believed to have died in Pisa around 1250.Leonardo's life portraits have not been preserved, and the existing images are the product of the imagination of artists of a later time. Fibonacci's legacy is enormous. He has not only introduced Europe to the Arabic (Indian) figures, but has also provided convincing evidence of their advantage.His book of Abaka was an encyclopedia of mathematical knowledge, which was taught by many generations of European mathematicians, and his work on numbers theory paved the way for Renaissance scientists. The sequence of numbers he named after him was not just a mathematical abstraction: its patterns were later discovered in nature, in the structure of leaves, pine bumps, and coils of shells."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u041f\u0438\u0437\u0430\u043d\u0441\u043a\u043e\u0433\u043e,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043c\u044b \u0437\u043d\u0430\u0435\u043c
    \u043a\u0430\u043a \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438, \u043f\u043e\u043b\u043d\u044b
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0439,
    \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0443\u0440\u044c\u0435\u0437\u043e\u0432 \u0438 \u0444\u0430\u043a\u0442\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u043d\u0430\u0447\u0435 \u043a\u0430\u043a
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043d\u0435
    \u043d\u0430\u0437\u043e\u0432\u0435\u0448\u044c. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0438\u0437 \u043d\u0438\u0445:\n\n\U0001F4DC
    \u0417\u0430\u0433\u0430\u0434\u043a\u0430 \u0438\u043c\u0435\u043d\u0438: \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u041e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0435\u0433\u043e \u00ab\u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438\u00bb. \u042d\u0442\u043e
    \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435, \u043f\u043e\u0434 \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043e\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0432\u0441\u0435\u043c\u0443
    \u043c\u0438\u0440\u0443, \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u043e \u0441\u043f\u0443\u0441\u0442\u044f
    \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c 600 \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438, \u0432 1838 \u0433\u043e\u0434\u0443,
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0443
    \u0413\u0438\u0439\u043e\u043c\u0443 \u041b\u0438\u0431\u0440\u0438. \u041e\u0442\u043a\u0443\u0434\u0430
    \u0432\u0437\u044f\u043b\u043e\u0441\u044c \u0438\u043c\u044f? \u041e\u043d \u0431\u044b\u043b
    \u0441\u044b\u043d\u043e\u043c \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0430 \u0413\u0443\u043b\u044c\u0435\u043b\u044c\u043c\u043e
    \u0411\u043e\u043d\u0430\u0447\u0447\u0438. \u041f\u043e-\u043b\u0430\u0442\u044b\u043d\u0438
    \"\u0441\u044b\u043d \u0411\u043e\u043d\u0430\u0447\u0447\u0438\" \u0437\u0432\u0443\u0447\u0438\u0442
    \u043a\u0430\u043a filius Bonacci. \u0421\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c
    \u044d\u0442\u043e \u0441\u043b\u043e\u0432\u043e\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0435
    \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u043b\u043e\u0441\u044c \u0438 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u0432 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0435 Fibonacci. \u0410 \u043a\u0430\u043a
    \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0441\u0435\u0431\u044f \u0441\u0430\u043c?
    \u0412 \u0441\u0432\u043e\u0438\u0445 \u0442\u0440\u0443\u0434\u0430\u0445 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e
    \u043f\u043e\u0434\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0441\u044f \u043a\u0430\u043a
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u041f\u0438\u0437\u0430\u043d\u0441\u043a\u0438\u0439
    (Leonardo Pisano, \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044f \u043d\u0430 \u043c\u0435\u0441\u0442\u043e
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f) \u0438\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435 \u0411\u0438\u0433\u043e\u043b\u043b\u043e
    (Bigollo). \u042d\u0442\u043e \u0441\u043b\u043e\u0432\u043e \u0441 \u0442\u043e\u0441\u043a\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u0434\u0438\u0430\u043b\u0435\u043a\u0442\u0430 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u0442\u0441\u044f
    \u043a\u0430\u043a \"\u0431\u0435\u0437\u0434\u0435\u043b\u044c\u043d\u0438\u043a\", \u043d\u043e
    \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u0435\u0442 \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c
    \u0438 \"\u0441\u0442\u0440\u0430\u043d\u043d\u0438\u043a, \u043c\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u0439\".
    \u0427\u0442\u043e \u0438\u0437 \u044d\u0442\u043e\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e,
    \u0430 \u0447\u0442\u043e \u2014 \u043d\u0430\u0441\u043c\u0435\u0448\u043a\u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u043d\u0430\u0434 \"\u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0439\"
    \u043d\u0430\u0443\u043a\u043e\u0439, \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0433\u0430\u0434\u043a\u043e\u0439.\n\n\U0001F430
    \u0421\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0438 \"\u043d\u0435\u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0430\u044f\" \u0437\u0430\u0434\u0430\u0447\u0430
    \u041f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u043e\u0431\u0435\u0441\u0441\u043c\u0435\u0440\u0442\u0438\u0432\u0448\u0430\u044f \u0435\u0433\u043e
    \u0438\u043c\u044f, \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430... \u0432\u0435\u0441\u044c\u043c\u0430 \u0434\u0430\u043b\u0435\u043a\u0430
    \u043e\u0442 \u0440\u0435\u0430\u043b\u0438\u0439 \u0441\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438. \u0412 \u0441\u0432\u043e\u0435\u0439 \u00ab\u041a\u043d\u0438\u0433\u0435
    \u0430\u0431\u0430\u043a\u0430\u00bb (Liber Abaci, 1202) \u043e\u043d \u043f\u043e\u043c\u0435\u0441\u0442\u0438\u043b
    \u043f\u0430\u0440\u0443 \u043a\u0440\u043e\u043b\u0438\u043a\u043e\u0432 \u0432 \u0437\u0430\u0433\u043e\u043d
    \u0438 \u0437\u0430\u0434\u0430\u043b\u0441\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c:
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0430\u0440 \u0440\u043e\u0434\u0438\u0442\u0441\u044f
    \u0437\u0430 \u0433\u043e\u0434, \u0435\u0441\u043b\u0438 \u043a\u0430\u0436\u0434\u0430\u044f
    \u043f\u0430\u0440\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043c\u0435\u0441\u044f\u0446
    \u0434\u0430\u0435\u0442 \u043d\u043e\u0432\u0443\u044e \u043f\u0430\u0440\u0443, \u0430
    \u043a\u0440\u043e\u043b\u0438\u043a\u0438, \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0442\u0441\u044f,
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0443\u043c\u0438\u0440\u0430\u044e\u0442.
    \u041f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0430\u044f\u0441\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u2014 1, 1, 2, 3, 5, 8, 13..., \u0433\u0434\u0435 \u043a\u0430\u0436\u0434\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u2014 \u0441\u0443\u043c\u043c\u0430 \u0434\u0432\u0443\u0445
    \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0445, \u2014 \u0432 \u0438\u0442\u043e\u0433\u0435
    \u0441\u0442\u0430\u043b\u0430 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0435\u0435,
    \u0447\u0435\u043c \u0441\u0430\u043c\u0430 \u00ab\u041a\u043d\u0438\u0433\u0430 \u0430\u0431\u0430\u043a\u0430\u00bb.\n\n\U0001F3A8
    \u041f\u0440\u0438\u0440\u043e\u0434\u0430, \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u0438 \u0434\u0435\u043d\u044c\u0433\u0438: \u043c\u0430\u0433\u0438\u044f \u0447\u0438\u0441\u0435\u043b
    \u043f\u043e\u0432\u0441\u044e\u0434\u0443 \u041f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u0433\u0440\u043e\u0439. \u0415\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u0441\u0432\u044f\u0437\u044c
    \u0441 \u0437\u043e\u043b\u043e\u0442\u044b\u043c \u0441\u0435\u0447\u0435\u043d\u0438\u0435\u043c
    (\u0447\u0438\u0441\u043b\u043e \u0424\u0438, \u2248 1.618), \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u0432 \u0441\u0430\u043c\u044b\u0445 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0445
    \u043c\u0435\u0441\u0442\u0430\u0445. \u0412 \u043f\u0440\u0438\u0440\u043e\u0434\u0435:
    \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435. \u0427\u0438\u0441\u043b\u0430 \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u043c\u043e\u0436\u043d\u043e \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0432 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u043b\u0435\u043f\u0435\u0441\u0442\u043a\u043e\u0432 \u0443 \u0446\u0432\u0435\u0442\u043e\u0432,
    \u0432 \u0441\u043f\u0438\u0440\u0430\u043b\u044f\u0445 \u0441\u043e\u0441\u043d\u043e\u0432\u044b\u0445
    \u0448\u0438\u0448\u0435\u043a \u0438 \u0430\u043d\u0430\u043d\u0430\u0441\u043e\u0432,
    \u0432 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0441\u0435\u043c\u044f\u043d
    \u0432 \u043f\u043e\u0434\u0441\u043e\u043b\u043d\u0443\u0445\u0435 \u0438 \u0434\u0430\u0436\u0435
    \u0432 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435 \u0440\u0430\u043a\u043e\u0432\u0438\u043d\u044b
    \u043d\u0430\u0443\u0442\u0438\u043b\u0443\u0441\u0430. \u0412 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435
    \u0438 \u043c\u0443\u0437\u044b\u043a\u0435: \u0418\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0435,
    \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e \u043c\u043d\u043e\u0433\u0438\u0445,
    \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u0438 \u0437\u043e\u043b\u043e\u0442\u043e\u0433\u043e
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0438 \u0438 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u044b,
    \u043e\u0442 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0434\u0430 \u0412\u0438\u043d\u0447\u0438
    \u0434\u043e \u0421\u0430\u043b\u044c\u0432\u0430\u0434\u043e\u0440\u0430 \u0414\u0430\u043b\u0438.
    \u0410 \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u044b \u0432\u0440\u043e\u0434\u0435
    \u0414\u0435\u0431\u044e\u0441\u0441\u0438 \u0438 \u0411\u0430\u0440\u0442\u043e\u043a\u0430
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0438 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u0435
    \u0432 \u0440\u0438\u0442\u043c\u0430\u0445, \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0445
    \u043d\u0430 \u0447\u0438\u0441\u043b\u0430\u0445 \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438.
    \u0412 \u043c\u0438\u0440\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432: \u041f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043d\u0430\u0448\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0434\u0430\u0436\u0435 \u043d\u0430 \u0431\u0438\u0440\u0436\u0435. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442
    \u0443\u0440\u043e\u0432\u043d\u0438 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438
    \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    23.6%, 38.2%, 61.8%), \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0440\u0435\u0439\u0434\u0435\u0440\u044b
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u0440\u0430\u0437\u0432\u043e\u0440\u043e\u0442\u043e\u0432
    \u0446\u0435\u043d\u044b.\n\n\u2694\ufe0f \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u0435\u0434\u0438\u043d\u043e\u043a \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0421\u043b\u0430\u0432\u0430
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u043b\u0430
    \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430
    \u0421\u0432\u044f\u0449\u0435\u043d\u043d\u043e\u0439 \u0420\u0438\u043c\u0441\u043a\u043e\u0439
    \u0438\u043c\u043f\u0435\u0440\u0438\u0438 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430
    II. \u041e\u043a\u043e\u043b\u043e 1225 \u0433\u043e\u0434\u0430 \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0443\u0440\u043d\u0438\u0440,
    \u0433\u0434\u0435 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444
    \u0418\u043e\u0430\u043d\u043d \u041f\u0430\u043b\u0435\u0440\u043c\u0441\u043a\u0438\u0439
    \u0437\u0430\u0434\u0430\u043b \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438 \u0442\u0440\u0438
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u041e\u0434\u043d\u0430 \u0438\u0437 \u043d\u0438\u0445 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f x\u00b3 + 2x\u00b2 + 10x = 20. \u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0448\u0438\u043b \u0435\u0435,
    \u043d\u043e \u0438 \u043d\u0430\u0448\u0435\u043b \u043a\u043e\u0440\u0435\u043d\u044c
    \u0441 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0434\u043e \u0434\u0435\u0432\u044f\u0442\u043e\u0433\u043e \u0437\u043d\u0430\u043a\u0430
    \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u044f\u0442\u043e\u0439 (1.368808107...),
    \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u043d\u0438\u043a\u0430\u043a\u0438\u0445
    \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u043e \u0441\u0432\u043e\u0435\u043c \u043c\u0435\u0442\u043e\u0434\u0435
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430
    \u0432\u0435\u043a\u0430 \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b \u0441\u0432\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f.\n\n\U0001F4DA \"\u041a\u043d\u0438\u0433\u0430 \u0430\u0431\u0430\u043a\u0430\"
    \u2014 \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u043f\u0440\u043e\u0441\u0442\u043e
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u0425\u043e\u0442\u044f \u043c\u044b \u043f\u043e\u043c\u043d\u0438\u043c
    \u0435\u0433\u043e \u043f\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u2014 \u044d\u0442\u043e \u0441\u0430\u043c\u0430
    \u00ab\u041a\u043d\u0438\u0433\u0430 \u0430\u0431\u0430\u043a\u0430\u00bb. \u042d\u0442\u0430
    \u043a\u043d\u0438\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u044b\u043c
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c \u0442\u0440\u0443\u0434\u043e\u043c
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439:
    1. \u0412\u043d\u0435\u0434\u0440\u0438\u043b \u0438\u043d\u0434\u043e-\u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0435
    \u0446\u0438\u0444\u0440\u044b (0-9) \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0438\u0445 \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0437\u0430\u043f\u0438\u0441\u0438. 2. \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0431\u043e\u043b\u0435\u0435 \u0443\u0434\u043e\u0431\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c
    \u0434\u0440\u043e\u0431\u0435\u0439 (\u0432\u0432\u0435\u043b \u0447\u0435\u0440\u0442\u0443
    \u0434\u0440\u043e\u0431\u0438) \u0438 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u043a\u043e\u0440\u043d\u044f.
    3. \u0424\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0442\u0430\u043b
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439 \u0434\u043b\u044f \u0441\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u043e\u0439
    \u0415\u0432\u0440\u043e\u043f\u044b, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0443\u0447\u0438\u043b\u0438\u0441\u044c \u043d\u0435 \u043e\u0434\u043d\u043e \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0435.\n\n\U0001F48E
