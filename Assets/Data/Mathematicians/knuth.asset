  achievementsRu: "\u0414\u043e\u043d\u0430\u043b\u044c\u0434 \u041a\u043d\u0443\u0442 \u2014 \u044d\u0442\u043e,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0436\u0438\u0432\u043e\u0439 \u043a\u043b\u0430\u0441\u0441\u0438\u043a,
    \u0447\u044c\u0435 \u0438\u043c\u044f \u0441\u0442\u0430\u043b\u043e \u043d\u0430\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0432 \u043c\u0438\u0440\u0435 IT. \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043a\u0438\u0440\u043f\u0438\u0447\u0435\u0439,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435.
    \u0421\u043b\u043e\u0436\u043d\u043e \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c \u043e\u0434\u043d\u043e
    \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435,
    \u0432\u0435\u0434\u044c \u043a\u0430\u0436\u0434\u043e\u0435 \u0438\u0437 \u043d\u0438\u0445
    \u0441\u0442\u0430\u043b\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0432 \u0441\u0432\u043e\u0435\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.\n\n\U0001F4DA
    \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\":
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0432\u0441\u0435\u0439 \u043e\u0442\u0440\u0430\u0441\u043b\u0438
    \u042d\u0442\u043e, \u0431\u0435\u0441\u0441\u043f\u043e\u0440\u043d\u043e, \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438, \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432
    \u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440 \u0434\u0430\u043d\u043d\u044b\u0445.
    \u0417\u0430\u043c\u044b\u0441\u0435\u043b \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432
    1962 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b\u043e \u0435\u0433\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u043a\u043d\u0438\u0433\u0443 \u043e \u043a\u043e\u043c\u043f\u0438\u043b\u044f\u0442\u043e\u0440\u0430\u0445.
    \u041a\u043d\u0443\u0442 \u043f\u043e\u0434\u043e\u0448\u0435\u043b \u043a \u0437\u0430\u0434\u0430\u0447\u0435
    \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e: \u043f\u043b\u0430\u043d \u0440\u0430\u0437\u0440\u043e\u0441\u0441\u044f
    \u0434\u043e \u0441\u0435\u043c\u0438 \u0442\u043e\u043c\u043e\u0432, \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0445
    \u0432\u0441\u0435 \u0430\u0441\u043f\u0435\u043a\u0442\u044b \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a. \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u044d\u0442\u043e\u0433\u043e
    \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0433\u043e \u0442\u0440\u0443\u0434\u0430
    \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0442\u0430\u043a: \u0422\u043e\u043c
    1. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b:
    \u0417\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442,
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044f \u0431\u0430\u0437\u043e\u0432\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b.
    \u0422\u043e\u043c 2. \u041f\u043e\u043b\u0443\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b: \u041f\u043e\u0441\u0432\u044f\u0449\u0435\u043d
    \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u043c. \u0422\u043e\u043c 3. \u0421\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430
    \u0438 \u043f\u043e\u0438\u0441\u043a: \u041f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0439\u0448\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0438
    \u0438 \u043f\u043e\u0438\u0441\u043a\u0430 \u0434\u0430\u043d\u043d\u044b\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u041a\u043d\u0443\u0442 \u0441\u0447\u0438\u0442\u0430\u043b \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c\u0438
    \u0430\u0441\u043f\u0435\u043a\u0442\u0430\u043c\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f.
    \u0422\u043e\u043c 4. \u041a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u044b\u0435
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b: \u0412\u044b\u0448\u0435\u043b \u0432
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0447\u0430\u0441\u0442\u044f\u0445
    (4A, 4B) \u0438 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d \u0441\u043b\u043e\u0436\u043d\u044b\u043c
    \u0437\u0430\u0434\u0430\u0447\u0430\u043c \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e
    \u043f\u043e\u0438\u0441\u043a\u0430. \u0422\u043e\u043c\u0430 5-7: \u041e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u0441\u0438\u043d\u0442\u0430\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b,
    \u0442\u0435\u043e\u0440\u0438\u044e \u044f\u0437\u044b\u043a\u043e\u0432 \u0438 \u043a\u043e\u043c\u043f\u0438\u043b\u044f\u0442\u043e\u0440\u044b,
    \u0438 \u0432\u0441\u0451 \u0435\u0449\u0435 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435. \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432\u044b\u0441\u043e\u0447\u0430\u0439\u0448\u0435\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0410\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u0437\u0430\u044f\u0432\u0438\u043b\u043e,
    \u0447\u0442\u043e \u043a\u043d\u0438\u0433\u0430 \"\u0432\u043d\u0435\u0441\u043b\u0430
    \u0431\u043e\u043b\u044c\u0448\u0438\u0439 \u0432\u043a\u043b\u0430\u0434 \u0432 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043d\u044b\u043d\u0435\u0448\u043d\u0435\u043c\u0443
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432,
    \u0447\u0435\u043c \u043b\u044e\u0431\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u043d\u0438\u0433\u0430, \u0432\u044b\u0448\u0435\u0434\u0448\u0430\u044f \u0432
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f\".
    \u0417\u0430\u043c\u044b\u0441\u0435\u043b, \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430
    \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u0430 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u043a\u0438
    \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\"
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u043e\u0439
    \u0434\u043b\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0434\u043b\u044f \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0430\u0446\u0438\u0438
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432 \u041a\u043d\u0443\u0442 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b
    \u0433\u0438\u043f\u043e\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440
    MIX, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445 \u044f\u0437\u044b\u043a\u043e\u0432
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f.\n\n\U0001F9EE
    \u0421\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c TeX \u0438 METAFONT: \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0442\u043a\u0435
    \u0412 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435 1970-\u0445 \u041a\u043d\u0443\u0442
    \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f \u0441 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439:
    \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0432\u0435\u0440\u0441\u0442\u043a\u0438
    \u043d\u043e\u0432\u044b\u0445 \u0438\u0437\u0434\u0430\u043d\u0438\u0439 \u0435\u0433\u043e
    \u043a\u043d\u0438\u0433 \u0435\u0433\u043e \u0443\u0436\u0430\u0441\u043d\u043e \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u044b\u0432\u0430\u043b\u043e.
    \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u043c:
    \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0441\u0430\u043c \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439
    \u0432\u0435\u0440\u0441\u0442\u043a\u0438. \u0422\u0430\u043a \u0432 1977 \u0433\u043e\u0434\u0443
    \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u043c\u0438 TeX (\u0434\u043b\u044f \u043d\u0430\u0431\u043e\u0440\u0430
    \u0442\u0435\u043a\u0441\u0442\u0430, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b) \u0438 METAFONT (\u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u0448\u0440\u0438\u0444\u0442\u043e\u0432). \u042d\u0442\u043e \u0431\u044b\u043b \u0434\u043e\u043b\u0433\u0438\u0439
    \u0438 \u043a\u0440\u043e\u043f\u043e\u0442\u043b\u0438\u0432\u044b\u0439 \u043f\u0443\u0442\u044c:
    \u041a\u043d\u0443\u0442 \u0434\u0443\u043c\u0430\u043b \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f
    \u0437\u0430 8 \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u0437\u0430\u0442\u044f\u043d\u0443\u043b\u0430\u0441\u044c \u043d\u0430 \u0446\u0435\u043b\u044b\u0445
    10 \u043b\u0435\u0442. \u041e\u0434\u043d\u0430\u043a\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u043f\u0440\u0435\u0432\u0437\u043e\u0448\u0435\u043b \u0432\u0441\u0435 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f.
    TeX \u0441\u0442\u0430\u043b \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043e\u043c
    \u0434\u0435-\u0444\u0430\u043a\u0442\u043e \u0434\u043b\u044f \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0439,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0444\u0438\u0437\u0438\u043a\u0435 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f TeX \u0441\u0442\u0430\u043b\u0430
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f
    \u0441\u0442\u0430\u0442\u0435\u0439 \u0441 \u0441\u0430\u043c\u044b\u043c\u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438 \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u043c\u0438\u0440\u043e\u0432\u044b\u0445 \u0436\u0443\u0440\u043d\u0430\u043b\u0430\u0445.\n\n\U0001F4A1
    \u0418\u043d\u043d\u043e\u0432\u0430\u0446\u0438\u0438: \u0430\u043d\u0430\u043b\u0438\u0437
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432 \u0438 \"\u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0435
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\"
    \u041f\u043e\u043c\u0438\u043c\u043e \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432 \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432,
    \u041a\u043d\u0443\u0442 \u043f\u043e\u0434\u0430\u0440\u0438\u043b \u043c\u0438\u0440\u0443
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043d\u0446\u0435\u043f\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0434\u0435\u0439, \u0431\u0435\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u043b\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u044e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430.
    \u041e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432: \u041a\u043d\u0443\u0442\u0430
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \"\u043e\u0442\u0446\u043e\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432\". \u0418\u043c\u0435\u043d\u043d\u043e
    \u043e\u043d \u043f\u0440\u0438\u0432\u043d\u0435\u0441 \u0432 \u044d\u0442\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443, \u043d\u0430\u0443\u0447\u0438\u0432
    \u043d\u0430\u0441 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0438\u0441\u0430\u0442\u044c
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b, \u043d\u043e \u0438 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0438\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c.
    \u0417\u0430 \u044d\u0442\u043e\u0442 \u0432\u043a\u043b\u0430\u0434 \u043e\u043d \u0431\u044b\u043b
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u041f\u0440\u0435\u043c\u0438\u0438 \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430
    \u0432 1974 \u0433\u043e\u0434\u0443 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u0432\u0441\u0435\u0433\u043e 36 \u043b\u0435\u0442, \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435\u043c.
    \u041a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f \"\u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\":
    \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u043d\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u043d\u0435 \u043a\u0430\u043a
    \u043d\u0430 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u0434\u043b\u044f
    \u043c\u0430\u0448\u0438\u043d\u044b, \u0430 \u043a\u0430\u043a \u043d\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435,
    \u043f\u043e\u043d\u044f\u0442\u043d\u043e\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443.
    \u042d\u0442\u0430 \u0438\u0434\u0435\u044f \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e
    \u0438 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044e \u043a\u043e\u0434\u0430.
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432:
    \u041a\u043d\u0443\u0442 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u0438 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0442\u0430\u043b\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c\u0438
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438. \u0421\u0440\u0435\u0434\u0438
    \u043d\u0438\u0445: \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u041a\u043d\u0443\u0442\u0430-\u041c\u043e\u0440\u0440\u0438\u0441\u0430-\u041f\u0440\u0430\u0442\u0442\u0430
    (\u041a\u041c\u041f): \u0434\u043b\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e
    \u043f\u043e\u0438\u0441\u043a\u0430 \u043f\u043e\u0434\u0441\u0442\u0440\u043e\u043a\u0438
    \u0432 \u0441\u0442\u0440\u043e\u043a\u0435. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u041a\u043d\u0443\u0442\u0430-\u0411\u0435\u043d\u0434\u0438\u043a\u0441\u0430: \u0434\u043b\u044f
    \u0432\u044b\u0432\u043e\u0434\u0430 \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0439
    \u0438\u0437 \u0430\u043a\u0441\u0438\u043e\u043c. \u041c\u0435\u0442\u043e\u0434 \u0443\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0435\u043d\u043d\u044b\u0445
    \u0445\u0435\u0448-\u0442\u0430\u0431\u043b\u0438\u0446: \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    (\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041e. \u0410\u043c\u0431\u043b\u043e\u043c)
    \u043f\u043e \u0445\u0435\u0448\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f
    \u0432 1974 \u0433\u043e\u0434\u0443, \u0441\u0442\u0430\u043b\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439.\n\n\U0001F3C6
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0438 \u043f\u0440\u0435\u043c\u0438\u044f \u0435\u0433\u043e
    \u0438\u043c\u0435\u043d\u0438 \u0421\u043f\u0438\u0441\u043e\u043a \u043d\u0430\u0433\u0440\u0430\u0434
    \u0414\u043e\u043d\u0430\u043b\u044c\u0434\u0430 \u041a\u043d\u0443\u0442\u0430 \u043e\u0433\u0440\u043e\u043c\u0435\u043d.
    \u041f\u043e\u043c\u0438\u043c\u043e \u041f\u0440\u0435\u043c\u0438\u0438 \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430,
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u043c\u0435\u0434\u0430\u043b\u044c \u0421\u0428\u0410
    (1979), \u041f\u0440\u0435\u043c\u0438\u044e \u041a\u0438\u043e\u0442\u043e (1996), \u041c\u0435\u0434\u0430\u043b\u044c
    \u0414\u0436\u043e\u043d\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    (1995) \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435.
    \u0412 \u0437\u043d\u0430\u043a \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0433\u043e \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u044f
    \u043a \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0443, ACM \u0438 IEEE \u0443\u0447\u0440\u0435\u0434\u0438\u043b\u0438
    \u041f\u0440\u0435\u043c\u0438\u044e \u0414\u043e\u043d\u0430\u043b\u044c\u0434\u0430 \u042d.
    \u041a\u043d\u0443\u0442\u0430 \u2014 \u043e\u0434\u043d\u0443 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f
    \u0437\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0441\u043d\u043e\u0432\u044b \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a."
  achievementsEn: 
  personalLifeRu: "\u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0445\u0440\u043e\u043d\u0438\u043a\u0430
    \u0436\u0438\u0437\u043d\u0438 \u0414\u043e\u043d\u0430\u043b\u044c\u0434\u0430 \u042d\u0440\u0432\u0438\u043d\u0430
    \u041a\u043d\u0443\u0442\u0430 \u2014 \u043e\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0434\u043e \u043d\u0430\u0448\u0438\u0445 \u0434\u043d\u0435\u0439, \u0441 \u0430\u043a\u0446\u0435\u043d\u0442\u043e\u043c
    \u043d\u0430 \u043b\u0438\u0447\u043d\u044b\u0435 \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0432\u0435\u0445\u0438. \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0421\u0435\u043c\u044c\u044f
    \u0414\u043e\u043d\u0430\u043b\u044c\u0434 \u042d\u0440\u0432\u0438\u043d \u041a\u043d\u0443\u0442
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 10 \u044f\u043d\u0432\u0430\u0440\u044f 1938
    \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041c\u0438\u043b\u0443\u043e\u043a\u0438,
    \u0448\u0442\u0430\u0442 \u0412\u0438\u0441\u043a\u043e\u043d\u0441\u0438\u043d. \u0415\u0433\u043e
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u2014 \u042d\u0440\u0432\u0438\u043d \u0413\u0435\u043d\u0440\u0438
    \u041a\u043d\u0443\u0442 \u0438 \u041b\u0443\u0438\u0437\u0430 \u041c\u0430\u0440\u0438
    \u0411\u043e\u043d\u0438\u043d\u0433. \u0421\u0435\u043c\u044c\u044f \u0438\u043c\u0435\u043b\u0430
    \u043d\u0435\u043c\u0435\u0446\u043a\u043e-\u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u043d\u0438. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u041a\u043d\u0443\u0442 \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u043c
    \u0432 \u0441\u0435\u043c\u044c\u0435, \u043a\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0432\u044b\u0441\u0448\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446, \u0445\u043e\u0442\u044c \u0438 \u0441\u0442\u0430\u043b
    \u043f\u0435\u0440\u0432\u044b\u043c \u0441\u0440\u0435\u0434\u0438 \u043f\u0440\u0435\u0434\u043a\u043e\u0432,
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u0432\u0448\u0438\u043c \u0432 \u043a\u043e\u043b\u043b\u0435\u0434\u0436,
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c
    \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0441\u043a\u043e\u0433\u043e \u0443\u0447\u0451\u0442\u0430
    \u0438 \u0432\u043b\u0430\u0434\u0435\u043b \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u043c
    \u043f\u0435\u0447\u0430\u0442\u043d\u044b\u043c \u0431\u0438\u0437\u043d\u0435\u0441\u043e\u043c.
    \u042d\u0442\u043e\u0442 \"\u043f\u0435\u0447\u0430\u0442\u043d\u044b\u0439\" \u0441\u043b\u0435\u0434
    \u043e\u0442\u0446\u0430, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u043e\u0432\u043b\u0438\u044f\u043b
    \u043d\u0430 \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u0414\u043e\u043d\u0430\u043b\u044c\u0434\u0430 \u043a \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u043c
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u043c. \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u041f\u0435\u0440\u0432\u044b\u0435 \u041f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f
    \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
    \u041a\u043d\u0443\u0442 \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0441\u0435\u0431\u044f
    \u043a\u0430\u043a \u0432\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434. \u0421\u0430\u043c\u0430\u044f
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d
    \u0443\u0447\u0438\u043b\u0441\u044f \u0432 \u0432\u043e\u0441\u044c\u043c\u043e\u043c \u043a\u043b\u0430\u0441\u0441\u0435.
    \u041e\u043d \u043f\u0440\u0438\u043d\u044f\u043b \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0435, \u0433\u0434\u0435 \u043d\u0443\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043a\u0430\u043a
    \u043c\u043e\u0436\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u043b\u043e\u0432
    \u0438\u0437 \u0431\u0443\u043a\u0432 \u0444\u0440\u0430\u0437\u044b \"Ziegler's Giant Bar\".
    \u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u044b \u043d\u0430\u0441\u0447\u0438\u0442\u0430\u043b\u0438
    \u043e\u043a\u043e\u043b\u043e 2500 \u0441\u043b\u043e\u0432, \u043d\u043e \u041a\u043d\u0443\u0442,
    \u043f\u0440\u0438\u0442\u0432\u043e\u0440\u0438\u0432\u0448\u0438\u0441\u044c \u0431\u043e\u043b\u044c\u043d\u044b\u043c
    \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0432\u0440\u0435\u043c\u044f
    \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0441\u043b\u043e\u0432\u0430\u0440\u044f,
    \u043d\u0430\u0448\u0451\u043b \u0431\u043e\u043b\u0435\u0435 4500 \u0441\u043b\u043e\u0432
    \u0438 \u0432\u044b\u0438\u0433\u0440\u0430\u043b \u043a\u043e\u043d\u043a\u0443\u0440\u0441.
    \u041e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u041c\u0438\u043b\u0443\u043e\u043a\u0441\u043a\u0443\u044e
    \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u0443\u044e \u0432\u044b\u0441\u0448\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0441 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u0441\u0440\u0435\u0434\u043d\u0438\u043c \u0431\u0430\u043b\u043b\u043e\u043c 97.5%, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0440\u0435\u043a\u043e\u0440\u0434\u043e\u043c \u0448\u043a\u043e\u043b\u044b. \u0423\u0447\u0451\u0431\u0430:
    \u041e\u0442 \u0424\u0438\u0437\u0438\u043a\u0438 \u043a \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e
    \u041a\u0435\u0439\u0441\u043e\u0432\u0441\u043a\u0438\u0439 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 (1956\u20131960): \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e
    \u041a\u043d\u0443\u0442 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u041a\u0435\u0439\u0441\u043e\u0432\u0441\u043a\u0438\u0439
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 (\u043d\u044b\u043d\u0435 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041a\u0435\u0439\u0441 \u0412\u0435\u0441\u0442\u0435\u0440\u043d \u0420\u0435\u0437\u0435\u0440\u0432)
    \u0432 \u041a\u043b\u0438\u0432\u043b\u0435\u043d\u0434\u0435, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043a\u043e\u043b\u0435\u0431\u0430\u043b\u0441\u044f
    \u043c\u0435\u0436\u0434\u0443 \u0444\u0438\u0437\u0438\u043a\u043e\u0439 \u0438 \u043c\u0443\u0437\u044b\u043a\u043e\u0439,
    \u043d\u043e \u0432\u044b\u0431\u043e\u0440 \u0431\u044b\u043b \u0441\u0434\u0435\u043b\u0430\u043d
    \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438.
    \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442
    \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u043c
    IBM 650. \u041f\u0440\u043e\u0432\u043e\u0434\u044f \u043d\u043e\u0447\u0438 \u043d\u0430\u043f\u0440\u043e\u043b\u0451\u0442
    \u0441 \u044d\u0442\u043e\u0439 \u043c\u0430\u0448\u0438\u043d\u043e\u0439, \u043e\u043d
    \u0443\u0432\u043b\u0451\u043a\u0441\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u043e\u0432\u0435\u0442\u044b
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0434\u0435\u0440\u0436\u0430\u0442\u044c\u0441\u044f
    \u043f\u043e\u0434\u0430\u043b\u044c\u0448\u0435. \u0411\u0435\u0439\u0441\u0431\u043e\u043b
    \u0438 \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b: \u0412 1958 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u0443\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0434\u043b\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u0431\u0430\u0441\u043a\u0435\u0442\u0431\u043e\u043b\u044c\u043d\u043e\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430, \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u043e\u043c
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u044f\u0432\u043b\u044f\u043b\u0441\u044f.
    \u0415\u0433\u043e \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u043b\u0430
    \u0432\u043a\u043b\u0430\u0434 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0438\u0433\u0440\u043e\u043a\u0430,
    \u0447\u0442\u043e \u043f\u043e\u043c\u043e\u0433\u043b\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0435
    \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442
    \u043b\u0438\u0433\u0438. \u042d\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043f\u043e\u043f\u0430\u043b\u0430 \u0432 \u0440\u0435\u043f\u043e\u0440\u0442\u0430\u0436\u0438
    Newsweek \u0438 CBS Evening News. \u0414\u0432\u043e\u0439\u043d\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c:
    \u0412 1960 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u043d\u0430\u0443\u043a \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0415\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f,
    \u0447\u0442\u043e \u043f\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0432\u0435\u0442\u0430 \u0435\u043c\u0443 \u0431\u044b\u043b\u0430 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u0430 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430 \u043d\u0430\u0443\u043a. \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u0438\u0439
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 (Caltech) \u2013 \u0414\u043e\u043a\u0442\u043e\u0440\u0430\u043d\u0442\u0443\u0440\u0430:
    \u041e\u0441\u0435\u043d\u044c\u044e 1960 \u0433\u043e\u0434\u0430 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u0438\u0439
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u043d\u0430\u0434 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0435\u0439
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0412 1963 \u0433\u043e\u0434\u0443
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u041c\u0430\u0440\u0448\u0430\u043b\u043b\u0430
    \u0425\u043e\u043b\u043b\u0430-\u043c\u043b\u0430\u0434\u0448\u0435\u0433\u043e \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043d\u0430 \u0442\u0435\u043c\u0443
    \u00abFinite Semifields and Projective Planes\u00bb \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u041a\u043d\u0443\u0442 \u0441 \u0438\u0440\u043e\u043d\u0438\u0435\u0439 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b,
    \u0447\u0442\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u0443\u044e \u0438\u0434\u0435\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u043e\u043d \u043f\u043e\u043d\u044f\u043b
    \u0437\u0430 \u0447\u0430\u0441, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c
    \u0441\u043a\u0430\u0437\u0430\u043b: \"\u0414\u043e\u043d, \u044d\u0442\u043e \u0442\u0432\u043e\u044f
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f. \u0411\u0435\u0440\u0438
    \u0438 \u0443\u0445\u043e\u0434\u0438.\". \u041d\u0430\u0447\u0430\u043b\u043e \u041a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0438 \u0420\u0430\u0431\u043e\u0442\u0430 Caltech (1963\u20131968): \u041f\u043e\u0441\u043b\u0435
    \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u041a\u043d\u0443\u0442 \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0432 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u043e\u043c
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430.
    \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e, \u0441 1960 \u043f\u043e
    1968 \u0433\u043e\u0434, \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u043e\u043c
    \u0432 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 Burroughs Corporation, \u0433\u0434\u0435
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u043e\u0439
    \u043a\u043e\u043c\u043f\u0438\u043b\u044f\u0442\u043e\u0440\u043e\u0432. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0442\u0430\u043c \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043a\u043e\u043c\u043f\u0438\u043b\u044f\u0442\u043e\u0440
    \u0434\u043b\u044f \u044f\u0437\u044b\u043a\u0430 ALGOL, \u0438 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u044e.
    \u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434
    (1968): \u0412 1968 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0451\u043b
    \u0432 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0415\u0433\u043e \u0440\u0435\u043a\u0440\u0443\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u0414\u0436\u043e\u0440\u0434\u0436 \u0424\u043e\u0440\u0441\u0430\u0439\u0442, \u0438
    \u041a\u043d\u0443\u0442, \u0448\u0443\u0442\u044f, \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0441\u044f,
    \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u0432 \u043e\u0442\u0441\u0440\u043e\u0447\u043a\u0443
    \u043d\u0430 \u0433\u043e\u0434, \u0447\u0442\u043e\u0431\u044b \"\u0434\u043e\u043f\u0438\u0441\u0430\u0442\u044c
    \u043a\u043d\u0438\u0433\u0443\". \u042d\u0442\u0443 \u043a\u043d\u0438\u0433\u0443, \u043a\u0430\u043a
    \u043e\u043d \u0441\u0430\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u0451\u0442\u0441\u044f,
    \u043e\u043d \u043f\u0438\u0448\u0435\u0442 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440.
    \u0412 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0435 \u043e\u043d \u0431\u044b\u0441\u0442\u0440\u043e
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432, \u0432\u043d\u0451\u0441
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a \u0438 \u0432 1977 \u0433\u043e\u0434\u0443 \u0431\u044b\u043b
    \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0438\u043c\u0435\u043d\u0438 \u0424\u043b\u0435\u0442\u0447\u0435\u0440\u0430 \u0414\u0436\u043e\u043d\u0441\u0430.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0423\u0447\u0451\u043d\u044b\u043c\u0438
    \u0438 \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u041a\u043d\u0443\u0442 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u0442\u0435\u0441\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0441\u0432\u044f\u0437\u0438
    \u0441\u043e \u043c\u043d\u043e\u0433\u0438\u043c\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438. \u0420\u043e\u0431\u0435\u0440\u0442
    \u0424\u043b\u043e\u0439\u0434: \u0415\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0430
    \u0438 \u0431\u043b\u0438\u0437\u043a\u0438\u0439 \u0434\u0440\u0443\u0433, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u043f\u0440\u0438\u0448\u043b\u0438
    \u0432 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434. \u041a\u043d\u0443\u0442 \u043e\u0447\u0435\u043d\u044c
    \u0442\u0435\u043f\u043b\u043e \u043e\u0442\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043e\u0431
    \u0438\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u0438 \"\u043f\u0430\u043a\u0435\u0442\u043d\u043e\u0439 \u0441\u0434\u0435\u043b\u043a\u0435\"
    \u043f\u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0443 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0410\u043d\u0434\u0440\u0435\u0439 \u0415\u0440\u0448\u043e\u0432: \u0411\u043e\u043b\u044c\u0448\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u041a\u043d\u0443\u0442\u0430,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438,
    \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u0410\u043d\u0434\u0440\u0435\u044f
    \u041f\u0435\u0442\u0440\u043e\u0432\u0438\u0447\u0430 \u0415\u0440\u0448\u043e\u0432\u0430.
    \u041a\u043d\u0443\u0442 \u0438\u0437\u0443\u0447\u0430\u043b \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0443
    \u00ab\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0434\u043b\u044f \u0411\u042d\u0421\u041c\u00bb \u0438 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043e\u043d\u0438 \u0441\u0442\u0430\u043b\u0438 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438.
    \u0421\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c \u043e\u0431\u0448\u0438\u0440\u043d\u0430\u044f
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u043c \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u043c
    \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0438, \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0438
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u043a\u043d\u0438\u0433 \u041a\u043d\u0443\u0442\u0430
    \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a \u0438
    \u0434\u0430\u0436\u0435 \u043f\u043b\u0430\u043d\u0430\u0445 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0441\u0438\u043c\u043f\u043e\u0437\u0438\u0443\u043c\u043e\u0432 \u0432 \u0421\u0421\u0421\u0420.
    \u042d\u0434\u0441\u0433\u0435\u0440 \u0414\u0435\u0439\u043a\u0441\u0442\u0440\u0430: \u0421
    \u043d\u0438\u043c \u0443 \u041a\u043d\u0443\u0442\u0430 \u0431\u044b\u043b\u0438 \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u044b\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f. \u0412 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0414\u0435\u0439\u043a\u0441\u0442\u0440\u0430 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u043e
    \u043e\u0442\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043e \u0435\u0433\u043e \u0438\u0434\u0435\u0435
    \u0441 `DEFINE` \u0432 \u044f\u0437\u044b\u043a\u0435 ALGOL, \u043d\u043e \u0438\u0445 \u043f\u0443\u0442\u0438
    \u043a\u0430\u043a \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438
    \u0447\u0430\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u043b\u0438\u0441\u044c.
    \u0414\u0440\u0443\u0433\u0438\u0435: \u041a\u043d\u0443\u0442 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b
    28 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0438\u043c\u0438 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f\u043c\u0438
    \u0432 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0435. \u0421\u0440\u0435\u0434\u0438
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 \u2014 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435
    \u0443\u0447\u0451\u043d\u044b\u0435, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a
    \u0420\u043e\u0431\u0435\u0440\u0442 \u0421\u0435\u0434\u0436\u0432\u0438\u043a, \u041b\u0435\u043e\u043d\u0438\u0434\u0430\u0441
    \u0413\u0443\u0439\u0431\u0430\u0441 \u0438 \u0410\u043d\u0434\u0440\u0435\u0439 \u0411\u0440\u043e\u0434\u0435\u0440.
    \u0423\u0445\u043e\u0434 \u0438\u0437 \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f
    \u0438 \u0421\u043c\u0435\u0440\u0442\u044c \u041e\u0442\u0441\u0442\u0430\u0432\u043a\u0430
    (1993): \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044e, \u0432
    1993 \u0433\u043e\u0434\u0443 \u041a\u043d\u0443\u0442 \u0443\u0448\u0451\u043b \u0432 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0443
    \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0451\u0442\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 (Professor Emeritus). \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0446\u0435\u043b\u044c\u044e \u0431\u044b\u043b\u043e
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u0442\u044c\u0441\u044f
    \u043d\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438 \u0441\u0432\u043e\u0435\u0433\u043e
    magnum opus \u2014 \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\",
    \u0434\u043e\u0445\u043e\u0434 \u043e\u0442 \u043f\u0440\u043e\u0434\u0430\u0436 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0443\u0436\u0435 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u043b \u0435\u0433\u043e
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e. \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435:
    \u0412 2006 \u0433\u043e\u0434\u0443 \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b
    \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d \u0440\u0430\u043a
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b,
    \u043e\u043d \u043f\u0435\u0440\u0435\u043d\u0451\u0441 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044e
    \u0438 \u043a\u0443\u0440\u0441 \u043b\u0443\u0447\u0435\u0432\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438,
    \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0433\u043d\u043e\u0437
    \u0431\u044b\u043b \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c.
    \u0412\u0430\u0436\u043d\u043e: \u0414\u043e\u043d\u0430\u043b\u044c\u0434 \u042d\u0440\u0432\u0438\u043d
    \u041a\u043d\u0443\u0442 \u0436\u0438\u0432 \u043f\u043e \u0441\u0435\u0439 \u0434\u0435\u043d\u044c
    (\u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 1938 \u0433\u043e\u0434\u0443). \u041d\u0430
    \u043c\u043e\u043c\u0435\u043d\u0442 \u043c\u043e\u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e
    \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043d\u0430\u0434 \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\"
    \u0438 \u0432\u0435\u0434\u0451\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c, \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u044f \u0441
    \u043b\u0435\u043a\u0446\u0438\u044f\u043c\u0438 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c
    \u043c\u0443\u0437\u044b\u043a\u043e\u0439. \u041b\u0438\u0447\u043d\u0430\u044f \u0416\u0438\u0437\u043d\u044c
    \u0421\u0443\u043f\u0440\u0443\u0433\u0430: \u041d\u044d\u043d\u0441\u0438 \u0414\u0436\u0438\u043b\u043b
    \u041a\u0430\u0440\u0442\u0435\u0440. \u041e\u043d\u0438 \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c
    24 \u0438\u044e\u043d\u044f 1961 \u0433\u043e\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \u041a\u043d\u0443\u0442 \u0435\u0449\u0451 \u0443\u0447\u0438\u043b\u0441\u044f \u0432
    \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0435 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430. \u0414\u0435\u0442\u0438: \u0423
    \u043d\u0438\u0445 \u0434\u0432\u043e\u0435 \u0434\u0435\u0442\u0435\u0439: \u0441\u044b\u043d
    \u0414\u0436\u043e\u043d \u041c\u0430\u0440\u0442\u0438\u043d \u041a\u043d\u0443\u0442 \u0438
    \u0434\u043e\u0447\u044c \u0414\u0436\u0435\u043d\u043d\u0438\u0444\u0435\u0440 \u0421\u044c\u0435\u0440\u0440\u0430
    \u041a\u043d\u0443\u0442. \u0414\u043e\u043c: \u041a\u043d\u0443\u0442 \u0438 \u0435\u0433\u043e
    \u0436\u0435\u043d\u0430 \u0414\u0436\u0438\u043b\u043b \u0441\u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u043a\u0443 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0434\u043e\u043c\u0430 \u0432 \u043a\u0430\u043c\u043f\u0443\u0441\u0435 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0430,
    \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u043e\u0442\u0440\u0435\u0432 \u043c\u0435\u0441\u0442\u043e
    \u0434\u043b\u044f \u0445\u0443\u0434\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432 \u0414\u0436\u0438\u043b\u043b \u0438 \u043a\u043e\u043c\u043d\u0430\u0442\u0443
    \u0434\u043b\u044f \u043c\u0443\u0437\u044b\u043a\u0438 \u0414\u043e\u043d\u0430\u043b\u044c\u0434\u0430,
    \u0433\u0434\u0435 \u0432 \u0438\u0442\u043e\u0433\u0435 \u0431\u044b\u043b \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439
    \u043e\u0440\u0433\u0430\u043d. \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438
    \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u041c\u0443\u0437\u044b\u043a\u0430:
    \u041a\u043d\u0443\u0442 \u2014 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0447\u0435\u043d\u044b\u0439,
    \u043d\u043e \u0438 \u0438\u0441\u043a\u0443\u0441\u043d\u044b\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0441\u0442
    \u0438 \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0442\u043e\u0440. \u041e\u043d \u0438
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0441\u043b\u0443\u0436\u0438\u043b\u0438 \u043e\u0440\u0433\u0430\u043d\u0438\u0441\u0442\u0430\u043c\u0438
    \u0432 \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u0438\u0445 \u0446\u0435\u0440\u043a\u0432\u044f\u0445.
    \u0412 \u0435\u0433\u043e \u0434\u043e\u043c\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d
    \u043e\u0440\u0433\u0430\u043d. \u0412 2016 \u0433\u043e\u0434\u0443 \u043e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435
    \u0434\u043b\u044f \u043e\u0440\u0433\u0430\u043d\u0430 \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c
    \u00abFantasia Apocalyptica\u00bb, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u043d\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c \u0442\u0435\u043a\u0441\u0442\u0435
    \u041e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u044f \u0418\u043e\u0430\u043d\u043d\u0430
    \u0411\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0430. \u041f\u0440\u0435\u043c\u044c\u0435\u0440\u0430
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c \u0432 \u0428\u0432\u0435\u0446\u0438\u0438
    10 \u044f\u043d\u0432\u0430\u0440\u044f 2018 \u0433\u043e\u0434\u0430, \u0432 \u0434\u0435\u043d\u044c
    \u0435\u0433\u043e 80-\u043b\u0435\u0442\u0438\u044f. \u0427\u0435\u043a\u0438 \u0437\u0430
    \u043e\u0448\u0438\u0431\u043a\u0438: \u0418\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0435\u0439 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0442\u044c
    \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0435 \u0437\u0430
    \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0435 \u0432 \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0430\u0445
    \u043e\u0448\u0438\u0431\u043a\u0438 \u2014 $2.56 (\u043e\u0434\u0438\u043d \"\u0448\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u0435\u0440\u0438\u0447\u043d\u044b\u0439
    \u0434\u043e\u043b\u043b\u0430\u0440\"). \u042d\u0442\u0438 \u0447\u0435\u043a\u0438 \u0441\u0442\u0430\u043b\u0438
    \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438.
    \u0421 2008 \u0433\u043e\u0434\u0430, \u0438\u0437-\u0437\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c
    \u0441 \u043c\u043e\u0448\u0435\u043d\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c,
    \u043e\u043d \u0432\u044b\u0434\u0430\u0451\u0442 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u044b
    \u0438\u0437 \u0432\u044b\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e \"\u0411\u0430\u043d\u043a\u0430
    \u0421\u0430\u043d-\u0421\u0435\u0440\u0440\u0438\u0444\". \u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0438\u0440\u043e\u043d\u0438\u044f: \u041a\u043d\u0443\u0442 \u043d\u0435 \u043b\u0438\u0448\u0451\u043d
    \u0441\u0430\u043c\u043e\u0438\u0440\u043e\u043d\u0438\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435: \"Beware
    of bugs in the above code; I have only proved it correct, not tried it.\" (\u041e\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u0439\u0442\u0435\u0441\u044c
    \u043e\u0448\u0438\u0431\u043e\u043a \u0432 \u043f\u0440\u0438\u0432\u0435\u0434\u0451\u043d\u043d\u043e\u043c
    \u043a\u043e\u0434\u0435; \u044f \u043b\u0438\u0448\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0435\u0433\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u043d\u043e \u043d\u0435 \u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c)."
  personalLifeEn: 
  shortBioRu: "\u0414\u043e\u043d\u0430\u043b\u044c\u0434 \u042d\u0440\u0432\u0438\u043d \u041a\u043d\u0443\u0442
    (Donald Ervin Knuth) \u2014 \u044d\u0442\u043e \u0443\u0447\u0435\u043d\u044b\u0439, \u0447\u044c\u0435
    \u0438\u043c\u044f \u0441\u0442\u0430\u043b\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439
    \u0432 \u043c\u0438\u0440\u0435 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a. \u041e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f 10 \u044f\u043d\u0432\u0430\u0440\u044f
    1938 \u0433\u043e\u0434\u0430 \u0432 \u041c\u0438\u043b\u0443\u043e\u043a\u0438, \u0448\u0442\u0430\u0442
    \u0412\u0438\u0441\u043a\u043e\u043d\u0441\u0438\u043d, \u0438 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0443\u043c \u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u043f\u043e\u0440\u044f\u0434\u043a\u0443
    \u043c\u043e\u0433\u0443\u0442 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0446\u0435\u043b\u0443\u044e
    \u043e\u0442\u0440\u0430\u0441\u043b\u044c. \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438
    \u043f\u0435\u0440\u0432\u044b\u0435 \u0448\u0430\u0433\u0438 \u043a \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0421 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442 \u0432 \u0414\u043e\u043d\u0430\u043b\u044c\u0434\u0435
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0447\u0435\u0440\u0442\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0436\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442
    \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0443: \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u043c\u0443\u0437\u044b\u043a\u0435
    \u0438 \u043f\u0435\u0447\u0430\u0442\u043d\u043e\u043c\u0443 \u0441\u043b\u043e\u0432\u0443.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c
    \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0441\u043a\u043e\u0433\u043e \u0443\u0447\u0435\u0442\u0430,
    \u0432 \u043f\u043e\u0434\u0432\u0430\u043b\u0435 \u0434\u043e\u043c\u0430 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043f\u0435\u0447\u0430\u0442\u043d\u044b\u043c \u0434\u0435\u043b\u043e\u043c, \u0447\u0442\u043e,
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b\u043e
    \u0432 \u0441\u044b\u043d\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u043a\u0435.
    \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u0430
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u0441\u043b\u0443\u0447\u0438\u0432\u0448\u0430\u044f\u0441\u044f
    \u0441 \u043d\u0438\u043c \u0432 13 \u043b\u0435\u0442. \u041a\u043e\u043c\u043f\u0430\u043d\u0438\u044f-\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c
    \u0448\u043e\u043a\u043e\u043b\u0430\u0434\u0430 Ziegler's \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043b\u0430
    \u043a\u043e\u043d\u043a\u0443\u0440\u0441: \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u043d\u0430\u0439\u0442\u0438 \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435
    \u0441\u043b\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0436\u043d\u043e
    \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0438\u0437 \u0431\u0443\u043a\u0432
    \u0432 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0438 \u043f\u043b\u0438\u0442\u043a\u0438
    \"Ziegler's Giant Bar\". \u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u044b
    \u043d\u0430\u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u043e\u043a\u043e\u043b\u043e 2500
    \u0441\u043b\u043e\u0432. \u041a\u043d\u0443\u0442 \u0436\u0435, \u043c\u0435\u0442\u043e\u0434\u0438\u0447\u043d\u043e
    \u043f\u0435\u0440\u0435\u043b\u0438\u0441\u0442\u0430\u0432 2000 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u0441\u043b\u043e\u0432\u0430\u0440\u044f Funk & Wagnalls, \u0441\u043c\u043e\u0433 \u043d\u0430\u0439\u0442\u0438
    \u0431\u043e\u043b\u0435\u0435 4700 \u0441\u043b\u043e\u0432. \u0427\u0442\u043e\u0431\u044b
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u0442\u044c\u0441\u044f,
    \u043e\u043d \u0434\u0430\u0436\u0435 \u043f\u0440\u0438\u0442\u0432\u043e\u0440\u0438\u043b\u0441\u044f
    \u0431\u043e\u043b\u044c\u043d\u044b\u043c \u0438 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b
    \u0448\u043a\u043e\u043b\u0443. \u042d\u0442\u043e\u0442 \u0441\u043b\u0443\u0447\u0430\u0439
    \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0437\u0430\u0434\u0430\u0447 \u0438
    \u043d\u0435\u0438\u0441\u0441\u044f\u043a\u0430\u0435\u043c\u0443\u044e \u044d\u043d\u0435\u0440\u0433\u0438\u044e.
    \u041a\u0441\u0442\u0430\u0442\u0438, \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0441\u0440\u0435\u0434\u043d\u044e\u044e \u0448\u043a\u043e\u043b\u0443 \u0441 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u0441\u0440\u0435\u0434\u043d\u0438\u043c \u0431\u0430\u043b\u043b\u043e\u043c 97.5%, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0440\u0435\u043a\u043e\u0440\u0434\u043e\u043c
    \u0448\u043a\u043e\u043b\u044b \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b.
    \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b: \u043e\u0442 \u0444\u0438\u0437\u0438\u043a\u0438 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e
    \u0412 1956 \u0433\u043e\u0434\u0443 \u041a\u043d\u0443\u0442 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041a\u0435\u0439\u0441\u043e\u0432\u0441\u043a\u0438\u0439 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 (\u043d\u044b\u043d\u0435 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041a\u0435\u0439\u0441 \u0412\u0435\u0441\u0442\u0435\u0440\u043d \u0420\u0435\u0437\u0435\u0440\u0432)
    \u0432 \u041a\u043b\u0438\u0432\u043b\u0435\u043d\u0434\u0435, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435.
    \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u043d \u043a\u043e\u043b\u0435\u0431\u0430\u043b\u0441\u044f
    \u043c\u0435\u0436\u0434\u0443 \u0444\u0438\u0437\u0438\u043a\u043e\u0439 \u0438 \u043c\u0443\u0437\u044b\u043a\u043e\u0439,
    \u043d\u043e \u0432\u044b\u0431\u0440\u0430\u043b \u0444\u0438\u0437\u0438\u043a\u0443,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u043a\u0440\u0443\u0442\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0443\u0432\u0438\u0434\u0435\u043b
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 IBM 650. \u0412 1956 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b
    \u044d\u0442\u0443 \u043c\u0430\u0448\u0438\u043d\u0443 \u0438 \u0431\u044b\u043b \u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d.
    \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b
    \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u0441\u043e\u0432\u0435\u0442\u0430\u043c
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u0432\u0448\u0438\u0445,
    \u0447\u0442\u043e \"\u044d\u0442\u043e \u043d\u0438 \u043a \u0447\u0435\u043c\u0443 \u0445\u043e\u0440\u043e\u0448\u0435\u043c\u0443
    \u043d\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442\", \u041a\u043d\u0443\u0442
    \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u043d\u043e\u0447\u0438
    \u043d\u0430\u043f\u0440\u043e\u043b\u0435\u0442, \u0438\u0437\u0443\u0447\u0430\u044f \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440
    \u0438 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u044f \u0435\u0433\u043e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u043e\u0435 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u0435.
    \u041e\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u043b\u0441\u044f \u0432 \u0442\u0435\u043c\u0443,
    \u0447\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043b \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443
    \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0431\u0430\u0441\u043a\u0435\u0442\u0431\u043e\u043b\u044c\u043d\u043e\u0439
    \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430,
    \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u043e\u043c \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0431\u044b\u043b. \u042d\u0442\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430
    \u043f\u043e\u043c\u043e\u0433\u043b\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0435 \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c
    \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442 \u043b\u0438\u0433\u0438 \u0438 \u0434\u0430\u0436\u0435
    \u043f\u043e\u043f\u0430\u043b\u0430 \u0432 \u0440\u0435\u043f\u043e\u0440\u0442\u0430\u0436\u0438
    Newsweek \u0438 CBS. \u0412 1960 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u043e, \u043a\u0430\u043a \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0435\u0433\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0432 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438,
    \u043f\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0440\u0435\u0448\u0435\u043d\u0438\u044e
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0432\u0435\u0442\u0430 \u0435\u043c\u0443 \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u0430
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430.
    \u041f\u0443\u0442\u044c \u043a \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0443
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\"
    \u0412 1963 \u0433\u043e\u0434\u0443 \u041a\u043d\u0443\u0442 \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0432 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u043e\u043c
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 (Caltech) \u0438 \u0441\u0442\u0430\u043b
    \u0442\u0430\u043c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c.
    \u0421\u0430\u043c\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0441\u043e\u0431\u044b\u0442\u0438\u0435 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e
    \u0432 \u044f\u043d\u0432\u0430\u0440\u0435 1962 \u0433\u043e\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e Addison-Wesley
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u043e \u0435\u043c\u0443 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u043a\u043d\u0438\u0433\u0443 \u043e \u043a\u043e\u043c\u043f\u0438\u043b\u044f\u0442\u043e\u0440\u0430\u0445.
    \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u043d \u043d\u0430\u0431\u0440\u043e\u0441\u0430\u043b
    12 \u0433\u043b\u0430\u0432, \u043d\u043e \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e
    \u0442\u0435\u043c\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0431\u043e\u043b\u0435\u0435
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430. \u0412\u043c\u0435\u0441\u0442\u043e \u043a\u043d\u0438\u0433\u0438
    \u043f\u043e \u043a\u043e\u043c\u043f\u0438\u043b\u044f\u0442\u043e\u0440\u0430\u043c \u043e\u043d
    \u0440\u0435\u0448\u0438\u043b \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0438\u0439
    \u0442\u0440\u0443\u0434 \u043f\u043e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430\u043c
    \u2014 \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\"
    (The Art of Computer Programming). \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u043b\u0430\u043d \u0438\u0437 \u043e\u0434\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u0438
    \u0431\u044b\u0441\u0442\u0440\u043e \u0432\u044b\u0440\u043e\u0441 \u0432 \u0448\u0435\u0441\u0442\u044c,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u0432 \u0441\u0435\u043c\u044c \u0442\u043e\u043c\u043e\u0432.
    \u0420\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434 \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u0441\u0442\u0430\u043b\u0430 \u0434\u0435\u043b\u043e\u043c
    \u0432\u0441\u0435\u0439 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u0420\u0430\u0441\u0446\u0432\u0435\u0442
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0412 1968 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u0435\u043b
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0442\u043e\u043c \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\",
    \u0438 \u0432 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u041a\u043d\u0443\u0442
    \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u0432 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0433\u0434\u0435 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0434\u043e 1993 \u0433\u043e\u0434\u0430, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0435\u0442\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 (Professor Emeritus). \u0412
    1974 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0432\u044b\u0448\u043b\u0438
    \u043f\u0435\u0440\u0432\u044b\u0435 \u0442\u0440\u0438 \u0442\u043e\u043c\u0430, \u041a\u043d\u0443\u0442
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u041f\u0440\u0435\u043c\u0438\u0438
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430 \u2014 \u0441\u0430\u043c\u043e\u0439 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445 \u043d\u0430\u0443\u043a
    \u2014 \"\u0437\u0430 \u0435\u0433\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0430\u043d\u0430\u043b\u0438\u0437 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432
    \u0438 \u0434\u0438\u0437\u0430\u0439\u043d \u044f\u0437\u044b\u043a\u043e\u0432 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f,
    \u0438 \u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0437\u0430
    \u0432\u043a\u043b\u0430\u0434 \u0432 \"\u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\"
    \u0447\u0435\u0440\u0435\u0437 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u043a\u043d\u0438\u0433\u0438\". \u0421\u0440\u0435\u0434\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0434\u0440\u0443\u0433\u0438\u0445 \u043d\u0430\u0433\u0440\u0430\u0434 \u2014 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u043c\u0435\u0434\u0430\u043b\u044c \u0421\u0428\u0410
    (1979), \u041f\u0440\u0435\u043c\u0438\u044f \u041a\u0438\u043e\u0442\u043e (1996) \u0438
    \u041c\u0435\u0434\u0430\u043b\u044c \u0414\u0436\u043e\u043d\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    (1995). \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 TeX, METAFONT \u0438 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438
    \"\u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\"
    \u0412 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435 1970-\u0445 \u0433\u043e\u0434\u043e\u0432
    \u041a\u043d\u0443\u0442 \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f \u0441
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439.
    \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u043f\u0435\u0447\u0430\u0442\u0438
    \u043c\u0435\u043d\u044f\u043b\u0430\u0441\u044c, \u0438 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e
    \u0432\u0435\u0440\u0441\u0442\u043a\u0438 \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0437\u0434\u0430\u043d\u0438\u044f
    \u0435\u0433\u043e \u043a\u043d\u0438\u0433 \u0435\u0433\u043e \u0441\u0438\u043b\u044c\u043d\u043e
    \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043b\u043e. \u0427\u0442\u043e\u0431\u044b
    \u0440\u0435\u0448\u0438\u0442\u044c \u044d\u0442\u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443,
    \u043e\u043d \u0432\u0437\u044f\u043b\u0441\u044f \u0437\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0442\u043a\u0438.
    \u0412 1977 \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443
    TeX \u2014 \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u043b\u0430 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e
    \u043d\u0430\u0431\u043e\u0440\u0430, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b. \u041e\u043d \u0434\u0443\u043c\u0430\u043b, \u0447\u0442\u043e
    \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u0437\u0430 8 \u043c\u0435\u0441\u044f\u0446\u0435\u0432,
    \u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0437\u0430\u0442\u044f\u043d\u0443\u043b\u0430\u0441\u044c
    \u043d\u0430 10 \u043b\u0435\u0442. \u041f\u043e\u0437\u0436\u0435 \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u0448\u0440\u0438\u0444\u0442\u043e\u0432 \u2014 METAFONT. \u0412 \u0445\u043e\u0434\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0434 TeX \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e \"\u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\"
    (Literate Programming), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u043d\u0435 \u043a\u0430\u043a \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e
    \u0434\u043b\u044f \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430, \u0430
    \u043a\u0430\u043a \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u043e\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u043e\u0435
    \u0434\u043b\u044f \u0447\u0442\u0435\u043d\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c.
    \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u041a\u043d\u0443\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0438\u043c \u043f\u0435\u0440\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0437\u043c\u043e\u043c.
    \u0417\u0430 \u043a\u0430\u0436\u0434\u0443\u044e \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u0443\u044e
    \u043e\u0448\u0438\u0431\u043a\u0443 \u0432 \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0430\u0445
    \u043e\u043d \u043f\u043b\u0430\u0442\u0438\u043b \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0435
    \u0432 $2.56 (\"\u043e\u0434\u0438\u043d \u0448\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u0435\u0440\u0438\u0447\u043d\u044b\u0439
    \u0434\u043e\u043b\u043b\u0430\u0440\"). \u041c\u043d\u043e\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0434\u0430\u0442\u0435\u043b\u0438
    \u044d\u0442\u0438\u0445 \u0447\u0435\u043a\u043e\u0432 \u043d\u0435 \u043e\u0431\u043d\u0430\u043b\u0438\u0447\u0438\u0432\u0430\u043b\u0438
    \u0438\u0445, \u0430 \u0445\u0440\u0430\u043d\u0438\u043b\u0438 \u043a\u0430\u043a \u0446\u0435\u043d\u043d\u044b\u0439
    \u0441\u0443\u0432\u0435\u043d\u0438\u0440. \u0421 2008 \u0433\u043e\u0434\u0430 \u043e\u043d
    \u0432\u044b\u0441\u044b\u043b\u0430\u0435\u0442 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u044b
    \u0438\u0437 \u0432\u044b\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e \"\u0411\u0430\u043d\u043a\u0430
    \u0421\u0430\u043d-\u0421\u0435\u0440\u0440\u0438\u0444\". \u0412 1990 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0443\u0448\u0435\u043b
    \u0438\u0437 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0430, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u0442\u044c\u0441\u044f
    \u043d\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438 \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\".
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u044b,
    \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u043d\u0435 \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u043b\u0438.
    \u041a\u043d\u0443\u0442 \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u0435\u043d
    (\u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0438\u043d) \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0438\u0441\u043a\u0443\u0441\u043d\u044b\u043c \u043e\u0440\u0433\u0430\u043d\u0438\u0441\u0442\u043e\u043c.
    \u041e\u043d \u0434\u0430\u0436\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u043e\u0440\u0433\u0430\u043d
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0434\u043e\u043c\u0435. \u0415\u0433\u043e \u0434\u0440\u0443\u0433,
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442
    \u0410\u043d\u0434\u0440\u0435\u0439 \u0415\u0440\u0448\u043e\u0432, \u0447\u044c\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b \u043f\u043e-\u0440\u0443\u0441\u0441\u043a\u0438
    \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435, \u043e\u043a\u0430\u0437\u0430\u043b
    \u043d\u0430 \u043d\u0435\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435.
    \u0412 2008 \u0433\u043e\u0434\u0443 \u041a\u043d\u0443\u0442 \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a."
  shortBioEn: 
  interestingFactsRu: "\u0414\u043e\u043d\u0430\u043b\u044c\u0434 \u041a\u043d\u0443\u0442 \u2013 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u0430\u044f,
    \u043d\u043e \u0438 \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u0430\u044f.
    \u0417\u0430 \u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438
    \u0438 \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0442\u043e\u043c\u0430\u043c\u0438 \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b\u043c
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c \u044e\u043c\u043e\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b \u043c\u043d\u043e\u0433\u0438\u0435
    \u0430\u0441\u043f\u0435\u043a\u0442\u044b \u0441\u0432\u043e\u0435\u0439 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0432 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0438\u0433\u0440\u0443. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u044f\u0440\u043a\u0438\u0435
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u044b \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.\n\n\U0001F4B0
    \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u043e\u0448\u0438\u0431\u043a\u0438:
    \u00ab\u0428\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u0435\u0440\u0438\u0447\u043d\u044b\u0439
    \u0434\u043e\u043b\u043b\u0430\u0440\u00bb \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0443\u0440\u044c\u0435\u0437
    \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0435\u043c
    \u0437\u0430 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0435 \u043e\u0448\u0438\u0431\u043a\u0438
    \u0432 \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0430\u0445. \u0417\u0430 \u043a\u0430\u0436\u0434\u0443\u044e
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043d\u0443\u044e \u043e\u043f\u0435\u0447\u0430\u0442\u043a\u0443
    \u0438\u043b\u0438 \u043d\u0435\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u041a\u043d\u0443\u0442
    \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442 $2.56. \u042d\u0442\u0430
    \u0441\u0443\u043c\u043c\u0430 \u2014 \u043d\u0435 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u044c,
    \u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u0448\u0443\u0442\u043a\u0430: 256 \u0446\u0435\u043d\u0442\u043e\u0432 \u2014 \u044d\u0442\u043e
    \u043e\u0434\u0438\u043d \u00ab\u0448\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u0435\u0440\u0438\u0447\u043d\u044b\u0439
    \u0434\u043e\u043b\u043b\u0430\u0440\u00bb. \u0427\u0435\u043a\u0438, \u0432\u044b\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0435
    \u0435\u0433\u043e \u0440\u0443\u043a\u043e\u0439, \u0441\u0442\u0430\u043b\u0438 \u0446\u0435\u043d\u043d\u044b\u043c\u0438
    \u0441\u0443\u0432\u0435\u043d\u0438\u0440\u0430\u043c\u0438, \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u0446\u0435\u0432 \u043d\u0435 \u043e\u0431\u043d\u0430\u043b\u0438\u0447\u0438\u0432\u0430\u044e\u0442
    \u0438\u0445, \u0430 \u0445\u0440\u0430\u043d\u044f\u0442 \u043a\u0430\u043a \u043f\u0430\u043c\u044f\u0442\u044c.
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u043e\u0431\u0449\u0430\u044f
    \u0441\u0443\u043c\u043c\u0430 \u0432\u044b\u043f\u043b\u0430\u0442 \u043a 2005 \u0433\u043e\u0434\u0443
    \u043f\u0440\u0435\u0432\u044b\u0441\u0438\u043b\u0430 20 \u0442\u044b\u0441\u044f\u0447
    \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432,
    \u043d\u043e \u043b\u0438\u0448\u044c \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0435 \u0447\u0435\u043a\u0438
    \u0431\u044b\u043b\u0438 \u043f\u0440\u0435\u0434\u044a\u044f\u0432\u043b\u0435\u043d\u044b
    \u0432 \u0431\u0430\u043d\u043a. \u0412 2008 \u0433\u043e\u0434\u0443 \u041a\u043d\u0443\u0442
    \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443. \u041c\u043e\u0448\u0435\u043d\u043d\u0438\u043a\u0438,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043d\u043e\u043c\u0435\u0440\u0430
    \u0441 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u043d\u0430\u043f\u043e\u043a\u0430\u0437
    \u0447\u0435\u043a\u043e\u0432, \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0438\u0442\u044c
    \u0435\u0433\u043e \u0441\u0447\u0435\u0442\u0430, \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043e
    \u0435\u043c\u0443 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u0437\u0430\u043a\u0440\u044b\u0442\u044c
    \u0442\u0440\u0438 \u0431\u0430\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0445 \u0441\u0447\u0435\u0442\u0430.
    \u0422\u0435\u043f\u0435\u0440\u044c \u0437\u0430 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0435
    \u043e\u0448\u0438\u0431\u043a\u0438 \u043e\u043d \u0432\u044b\u0441\u044b\u043b\u0430\u0435\u0442
    \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u044b \u0438\u0437 \u0432\u044b\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u00ab\u0411\u0430\u043d\u043a\u0430 \u0421\u0430\u043d-\u0421\u0435\u0440\u0440\u0438\u0444\u00bb
    (\u0441\u0442\u0440\u0430\u043d\u044b, \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043d\u043d\u043e\u0439
    \u0432 \u043f\u0435\u0440\u0432\u043e\u0430\u043f\u0440\u0435\u043b\u044c\u0441\u043a\u043e\u0439
    \u0448\u0443\u0442\u043a\u0435 \u0433\u0430\u0437\u0435\u0442\u044b Guardian). \u041a\u0430\u043a
    \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b
    \u0441\u0430\u043c \u0443\u0447\u0435\u043d\u044b\u0439, \u043d\u0430\u0433\u0440\u0430\u0434\u0430
    \u0442\u0435\u043f\u0435\u0440\u044c \u2014 \u044d\u0442\u043e \u00ab\u043f\u043e\u0447\u0435\u0442,
    \u0430 \u043d\u0435 \u0440\u0430\u0441\u0447\u0435\u0442\u00bb (kudos, not escudos).\n\n\U0001F9EE
    \u0412\u0435\u0440\u0441\u0438\u0438 TeX \u0438 METAFONT: \u0412 \u043f\u043e\u0433\u043e\u043d\u0435
    \u0437\u0430 \u03c0 \u0438 e \u041a\u043d\u0443\u0442 \u043f\u043e\u0434\u043e\u0448\u0435\u043b
    \u043a \u0432\u043e\u043f\u0440\u043e\u0441\u0443 \u043d\u0443\u043c\u0435\u0440\u0430\u0446\u0438\u0438
    \u0432\u0435\u0440\u0441\u0438\u0439 \u0441\u0432\u043e\u0438\u0445 \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0439 \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u043d\u043e\u0441\u0442\u044c\u044e. \u041d\u0430\u0447\u0438\u043d\u0430\u044f
    \u0441 \u0432\u0435\u0440\u0441\u0438\u0438 3.0, \u043d\u043e\u043c\u0435\u0440\u0430 \u0440\u0435\u043b\u0438\u0437\u043e\u0432
    \u0435\u0433\u043e \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b TeX \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0430\u044e\u0442\u0441\u044f
    \u043a \u0447\u0438\u0441\u043b\u0443 \u03c0: 3, 3.1, 3.14, 3.141 \u0438 \u0442\u0430\u043a
    \u0434\u0430\u043b\u0435\u0435. \u0410\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u044b\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043d\u043e\u043c\u0435\u0440\u0430 \u0432\u0435\u0440\u0441\u0438\u0439
    \u0448\u0440\u0438\u0444\u0442\u043e\u0432\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    METAFONT \u0441\u0442\u0440\u0435\u043c\u044f\u0442\u0441\u044f \u043a \u0447\u0438\u0441\u043b\u0443
    e. \u042d\u0442\u0430 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f \u2014 \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440 \u0435\u0433\u043e \u043b\u044e\u0431\u0432\u0438 \u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0442\u043e\u043d\u043a\u043e\u043c\u0443
    \u044e\u043c\u043e\u0440\u0443.\n\n\U0001F4DA \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u044e\u043c\u043e\u0440 \u0432 \u043a\u043d\u0438\u0433\u0430\u0445 \u0428\u0443\u0442\u043a\u0438
    \u041a\u043d\u0443\u0442\u0430 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f
    \u0447\u0435\u043a\u0430\u043c\u0438 \u0438 \u0432\u0435\u0440\u0441\u0438\u044f\u043c\u0438
    \u2014 \u043e\u043d\u0438 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0432\u043f\u043b\u0435\u0442\u0435\u043d\u044b
    \u0432 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0435\u0433\u043e \u043a\u043d\u0438\u0433.
    \u00ab\u0414\u043e\u043a\u0430\u0437\u0430\u043d\u043e, \u043d\u043e \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e\u00bb:
    \u041e\u0434\u043d\u043e \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0439
    \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u044f\u043c \u0437\u0432\u0443\u0447\u0438\u0442
    \u0442\u0430\u043a: \u00ab\u041e\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u0439\u0442\u0435\u0441\u044c
    \u043e\u0448\u0438\u0431\u043e\u043a \u0432 \u0432\u044b\u0448\u0435\u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u043c
    \u043a\u043e\u0434\u0435; \u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0435\u0433\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u043d\u043e \u043d\u0435 \u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c
    \u0435\u0433\u043e\u00bb. \u042d\u0442\u043e \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u043e\u0441\u0442\u044c
    \u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c.
    \u00ab\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c\u00bb
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0443: \u0412 \u043f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u044f\u0445
    \u043a \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c \u0432 \u0440\u0430\u0437\u043d\u044b\u0445
    \u0442\u043e\u043c\u0430\u0445 \u00ab\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\u00bb
    \u043e\u043d \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0438 \u0441 \u044e\u043c\u043e\u0440\u043e\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442
    \u043d\u0435\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438. \u0412 \u043f\u0435\u0440\u0432\u043e\u043c
    \u0442\u043e\u043c\u0435 \u043e\u043d \u043f\u0438\u0448\u0435\u0442: \u00ab\u0412\u0441\u0435
    \u043d\u0435\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0432 \u044d\u0442\u043e\u043c
    \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u044b \u0442\u0435\u043c \u0444\u0430\u043a\u0442\u043e\u043c,
    \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d
    \u043f\u0440\u0438 \u043f\u043e\u043c\u043e\u0449\u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u00bb.
    \u0412\u043e \u0432\u0442\u043e\u0440\u043e\u043c \u0442\u043e\u043c\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442:
    \u00ab...\u043d\u043e \u043d\u0435 \u0432\u0441\u043b\u0435\u043f\u0443\u044e\u00bb. \u0410
    \u0432 \u0442\u0440\u0435\u0442\u044c\u0435\u043c \u0442\u043e\u043c\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442:
    \u00ab\u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u0431\u044b\u043b \u043e\u0442\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d
    \u043f\u0440\u0438 \u043f\u043e\u043c\u043e\u0449\u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u00bb.
    \u0422\u0430\u043a \u043e\u043d \u0448\u0443\u0442\u043b\u0438\u0432\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442
    \u0432\u0438\u043d\u0443 \u0437\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435
    \u043e\u0448\u0438\u0431\u043a\u0438 \u043d\u0430 \u043c\u0430\u0448\u0438\u043d\u0443.
    \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u043e\u043d\u043e\u0440\u0430\u0440\u0430:
    \u0412 \u043e\u0433\u043b\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e
    \u0442\u043e\u043c\u0430 \u0435\u0441\u0442\u044c \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u0430\u044f
    \u0441\u0441\u044b\u043b\u043a\u0430 \u00ab\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0430\u0432\u0442\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u0433\u043e\u043d\u043e\u0440\u0430\u0440\u0430,
    407\u00bb. \u041d\u0430 \u0441\u0430\u043c\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435
    407 \u043d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430
    \u043d\u0430 \u044d\u0442\u0443 \u0442\u0435\u043c\u0443, \u043d\u043e \u0437\u0430\u0442\u043e
    \u0435\u0441\u0442\u044c \u0441\u0445\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043e\u0440\u0433\u0430\u043d\u0430.
    \u041a\u043d\u0443\u0442 \u043d\u0430\u043c\u0435\u043a\u0430\u0435\u0442, \u0447\u0442\u043e
    \u043f\u043e\u043a\u0443\u043f\u043a\u0430 \u044d\u0442\u043e\u0433\u043e \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430 \u0431\u044b\u043b\u0430
    \u043f\u0440\u043e\u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0430
    \u0437\u0430 \u0441\u0447\u0435\u0442 \u043e\u0442\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439
    \u043e\u0442 \u043f\u0440\u043e\u0434\u0430\u0436 \u0435\u0433\u043e \u043a\u043d\u0438\u0433.
    \u00ab\u0411\u0435\u0442\u043e\u043d\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb:
    \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u043a\u043d\u0438\u0433\u0438 \u00ab\u041a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb (Concrete Mathematics)
    \u2014 \u044d\u0442\u043e \u0438\u0433\u0440\u0430 \u0441\u043b\u043e\u0432, \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u044e\u0449\u0430\u044f
    \u0441\u043b\u043e\u0432\u0430 continuous (\u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0439)
    \u0438 discrete (\u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u044b\u0439). \u0412 \u043f\u0440\u0435\u0434\u0438\u0441\u043b\u043e\u0432\u0438\u0438
    \u043e\u043d \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0430\u043d\u0435\u043a\u0434\u043e\u0442,
    \u043a\u0430\u043a \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0434\u0435\u043d\u044c
    \u0447\u0442\u0435\u043d\u0438\u044f \u043a\u0443\u0440\u0441\u0430 \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043f\u043e\u0448\u0443\u0442\u0438\u043b\u0438, \u0447\u0442\u043e \u043e\u043d \u0431\u0443\u0434\u0435\u0442
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u00ab\u0442\u0435\u043e\u0440\u0438\u044e
    \u0431\u0435\u0442\u043e\u043d\u0430\u00bb, \u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432 \u0441 \u043a\u0430\u0444\u0435\u0434\u0440\u044b
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0432\u0441\u0442\u0430\u043b\u0438 \u0438 \u043f\u043e\u043a\u0438\u043d\u0443\u043b\u0438
    \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044e.\n\n\U0001F3C6 \u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0435 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435
    \u00ab\u041c\u0438\u0441\u043a\u0430\u00bb \u0434\u043b\u044f \u044f\u0433\u043e\u0434:
    \u041f\u043e\u043b\u0443\u0447\u0438\u0432 \u0432 1974 \u0433\u043e\u0434\u0443 \u041f\u0440\u0435\u043c\u0438\u044e
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430 \u2014 \u0441\u0430\u043c\u0443\u044e \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438, \u041a\u043d\u0443\u0442
    \u043d\u0435 \u0441\u0442\u0430\u043b \u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0441\u0435\u0440\u0435\u0431\u0440\u044f\u043d\u044b\u0439
    \u0442\u0440\u043e\u0444\u0435\u0439 \u043d\u0430 \u0432\u0438\u0434\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e.
    \u0412\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u043a\u0430\u043a \u0432\u0430\u0437\u0443 \u0438\u043b\u0438 \u043c\u0438\u0441\u043a\u0443
    \u0434\u043b\u044f \u043a\u043b\u0443\u0431\u043d\u0438\u043a\u0438 \u0438 \u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043e\u0433\u043e.
    \u042d\u0442\u043e\u0442 \u0436\u0435\u0441\u0442 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442 \u0435\u0433\u043e
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0440\u0435\u043d\u0435\u0431\u0440\u0435\u0436\u0435\u043d\u0438\u0435
    \u043a \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c.
    \u042d\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0430
    \u0438 \u044e\u043d\u043e\u0448\u0435\u0441\u043a\u0438\u0435 \u0448\u0430\u043b\u043e\u0441\u0442\u0438:
    \u0421\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u00ab\u043d\u0430\u0443\u0447\u043d\u0443\u044e\u00bb
    \u0441\u0442\u0430\u0442\u044c\u044e \u041a\u043d\u0443\u0442 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0432 1957 \u0433\u043e\u0434\u0443 \u0432 \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u043c
    \u0436\u0443\u0440\u043d\u0430\u043b\u0435 \u00ab\u0421\u0443\u043c\u0430\u0441\u0448\u0435\u0434\u0448\u0438\u0439\u00bb.
    \u0412 \u043d\u0435\u0439 \u043e\u043d \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b
    \u0441\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043c\u0435\u0440,
    \u0433\u0434\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u0443\u044e \u0435\u0434\u0438\u043d\u0438\u0446\u0443
    \u0441\u0438\u043b\u044b \u043d\u0430\u0437\u0432\u0430\u043b \u00abwhatmeworry\u00bb (\u0447\u0442\u043e
    \u043c\u043d\u0435 \u0432\u043e\u043b\u043d\u043e\u0432\u0430\u0442\u044c\u0441\u044f),
    \u043e\u0442\u0441\u044b\u043b\u0430\u044f \u043a \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0443
    \u043a\u043e\u043c\u0438\u043a\u0441\u043e\u0432 \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u0443
    \u042d. \u041d\u044c\u044e\u043c\u0430\u043d\u0443.\n\n\U0001F3B5 \u041c\u0443\u0437\u044b\u043a\u0430
    \u043a\u0430\u043a \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u041a\u043d\u0443\u0442
    \u2014 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439
    \u0443\u0447\u0435\u043d\u044b\u0439, \u043d\u043e \u0438 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0439
    \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442. \u041a 80-\u043b\u0435\u0442\u0438\u044e
    \u043e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u043e\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u043e\u0440\u0433\u0430\u043d\u0430
    \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c \u00abFantasia
    Apocalyptica\u00bb, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043d\u0430
    \u0442\u0435\u043a\u0441\u0442\u0435 \u041e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u044f
    \u0418\u043e\u0430\u043d\u043d\u0430 \u0411\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0430.
    \u0427\u0442\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u0434\u043b\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043c\u0435\u043b\u043e\u0434\u0438\u0439
    \u0432 \u044d\u0442\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0438.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u043d \u043f\u043e-\u0440\u0430\u0437\u043d\u043e\u043c\u0443
    \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u0435\u043b\u043e\u0434\u0438\u044e, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0414\u044d\u0432\u0438\u0434\u0430 \u041a\u0440\u0430\u0445\u0435\u043d\u0431\u044e\u043b\u044f,
    \u0430 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0443\u0437\u043e\u0440\u043e\u0432
    (\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u044c\u043d\u044b\u0445
    \u0437\u0432\u043e\u043d\u043e\u0432) \u0438 \u043c\u0435\u043b\u043e\u0434\u0438\u0439
    \u0434\u043b\u044f \u00ab\u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438 \u043a\u043e\u043b\u0435\u043d
    \u0418\u0437\u0440\u0430\u0438\u043b\u044f\u00bb \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044b.\n\n\U0001F4A1
    \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0430 \u0431\u0430\u0441\u043a\u0435\u0442\u0431\u043e\u043b\u0430
    \u0438 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 AI \u041f\u0435\u0440\u0432\u044b\u0439
    \u0432 \u043c\u0438\u0440\u0435 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a \u041d\u0411\u0410:
    \u0415\u0449\u0435 \u0432 1958 \u0433\u043e\u0434\u0443, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c \u0438 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u043e\u043c
    \u0431\u0430\u0441\u043a\u0435\u0442\u0431\u043e\u043b\u044c\u043d\u043e\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b,
    \u041a\u043d\u0443\u0442 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u0443\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0434\u043b\u044f IBM 650, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u043b\u0430 \u0432\u043a\u043b\u0430\u0434 \u043a\u0430\u0436\u0434\u043e\u0433\u043e
    \u0438\u0433\u0440\u043e\u043a\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e
    \u043d\u0430\u0431\u0440\u0430\u043d\u043d\u044b\u043c \u043e\u0447\u043a\u0430\u043c. \u0415\u0433\u043e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u043e\u043c\u043e\u0433\u043b\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0435
    \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442
    \u043b\u0438\u0433\u0438, \u0430 \u0441\u0430\u043c\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043f\u043e\u043f\u0430\u043b\u0430 \u0432 \u0440\u0435\u043f\u043e\u0440\u0442\u0430\u0436\u0438
    Newsweek \u0438 CBS. IBM \u0434\u0430\u0436\u0435 \u0441\u043d\u044f\u043b\u0430 \u043e\u0431
    \u044d\u0442\u043e\u043c \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u043c\u0435\u0442\u0440\u0430\u0436\u043d\u044b\u0439
    \u0444\u0438\u043b\u044c\u043c \u00abThe Electronic Coach\u00bb. \u041f\u043e \u0441\u0443\u0442\u0438,
    \u041a\u043d\u0443\u0442 \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u043e\u043f\u0440\u043e\u0445\u043e\u0434\u0446\u0435\u043c
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0431\u0430\u0441\u043a\u0435\u0442\u0431\u043e\u043b\u044c\u043d\u043e\u0439
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0435\u0439\u0447\u0430\u0441 \u0448\u0438\u0440\u043e\u043a\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0432 \u041d\u0411\u0410. \u00ab\u042d\u043a\u0437\u0430\u043c\u0435\u043d\u00bb \u0434\u043b\u044f
    ChatGPT: \u0412 2022 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435 \u0432 \u043f\u0440\u0435\u043a\u043b\u043e\u043d\u043d\u043e\u043c
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435, \u041a\u043d\u0443\u0442 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    ChatGPT. \u0421 \u043f\u0440\u0438\u0441\u0443\u0449\u0435\u0439 \u0435\u043c\u0443 \u043b\u044e\u0431\u043e\u0432\u044c\u044e
    \u043a \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0438 \u044e\u043c\u043e\u0440\u043e\u043c
    \u043e\u043d \u0437\u0430\u0434\u0430\u043b \u043c\u043e\u0434\u0435\u043b\u0438 \u043a\u0430\u0432\u0435\u0440\u0437\u043d\u044b\u0435
    \u0432\u043e\u043f\u0440\u043e\u0441\u044b, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440:
    \u00ab\u041f\u043e\u0434\u043d\u0438\u043c\u0435\u0442\u0441\u044f \u043b\u0438 \u0438\u043d\u0434\u0435\u043a\u0441
    Nasdaq \u0432 \u0441\u0443\u0431\u0431\u043e\u0442\u0443?\u00bb (\u0432\u043e\u043f\u0440\u043e\u0441
    \u043e \u0431\u0438\u0440\u0436\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u0430\u043a\u0440\u044b\u0442\u0430
    \u043f\u043e \u0441\u0443\u0431\u0431\u043e\u0442\u0430\u043c) \u0438 \u00ab\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0440\u043e\u0432\u043d\u043e
    \u0438\u0437 \u043f\u044f\u0442\u0438 \u0431\u0443\u043a\u0432\u00bb. \u041e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u00ab\u0433\u043e\u0440\u0430\u0437\u0434\u043e
    \u043b\u0443\u0447\u0448\u0435 99% \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u00bb, \u043d\u043e
    \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e
    \u043e\u043d\u0430 \u0434\u0435\u043b\u0430\u0435\u0442 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043e\u0448\u0438\u0431\u043a\u0438. \u042d\u0442\u0438 \u0434\u0435\u0442\u0430\u043b\u0438
    \u0440\u0438\u0441\u0443\u044e\u0442 \u043e\u0431\u0440\u0430\u0437 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e,
    \u043d\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u043a \u0436\u0438\u0437\u043d\u0438 \u0441
    \u0442\u043e\u0439 \u0436\u0435 \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e, \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e\u043c
    \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c \u044e\u043c\u043e\u0440\u0430,
    \u0441 \u043a\u0430\u043a\u043e\u0439 \u043e\u043d \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442
    \u043a \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430\u043c \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041d\u0430\u0434\u0435\u044e\u0441\u044c, \u044d\u0442\u043e\u0442 \u0441\u0431\u043e\u0440\u043d\u0438\u043a
    \u043a\u0443\u0440\u044c\u0435\u0437\u043e\u0432 \u0431\u044b\u043b \u0434\u043b\u044f \u0432\u0430\u0441
    \u0442\u0430\u043a\u0438\u043c \u0436\u0435 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c,
    \u043a\u0430\u043a \u0438 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0435 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b
    \u043e \u0436\u0438\u0437\u043d\u0438 \u041a\u043d\u0443\u0442\u0430."
