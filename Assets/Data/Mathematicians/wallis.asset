    \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f,
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0421\u0442\u0435\u0440\u043a\u0430. \u0422\u0430\u043a
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0441\u0442\u0430\u043b \u00ab\u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u0435\u043c
    \u0442\u0430\u0432\u0435\u0440\u043d\u00bb, \u043e\u043a\u0443\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432 \u0431\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438 \u0441\u0443\u0434\u0435\u0431\u043d\u044b\u0435 \u0442\u044f\u0436\u0431\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0432\u044b\u0433\u043b\u044f\u0434\u044f\u0442 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u043e
    \u043d\u0430 \u0444\u043e\u043d\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u0439.\n\n\U0001F5E3\ufe0f
    \u0421\u043f\u043e\u0440 \u043e \u0433\u043b\u0443\u0445\u043e\u043d\u0435\u043c\u044b\u0445
    \u0438 \u00ab\u044f\u0437\u044b\u043a\u043e\u0432\u043e\u0439 \u0442\u0430\u043b\u0430\u043d\u0442\u00bb
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u043e\u043c. \u041e\u043d \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u043d\u043e
    \u0432\u043b\u0430\u0434\u0435\u043b \u043b\u0430\u0442\u044b\u043d\u044c\u044e, \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c,
    \u0438\u0432\u0440\u0438\u0442\u043e\u043c, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c
    \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0433\u0440\u0430\u043c\u043c\u0430\u0442\u0438\u043a\u0443 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434, Arithmetica Infinitorum, \u0431\u044b\u043b \u0438\u0437\u0434\u0430\u043d
    \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438, \u0447\u0442\u043e\u0431\u044b \u0431\u044b\u0442\u044c
    \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0415\u0432\u0440\u043e\u043f\u044b. \u041e\u0441\u043e\u0431\u043e\u0433\u043e
    \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442
    \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f
    \u0440\u0435\u0447\u0438 \u0433\u043b\u0443\u0445\u043e\u043d\u0435\u043c\u044b\u0445. \u0412
    1670 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0432 Philosophical Transactions \u0441\u0442\u0430\u0442\u044c\u044e \u043e \u0442\u043e\u043c,
    \u043a\u0430\u043a \u043d\u0430\u0443\u0447\u0438\u043b \u0434\u0432\u0443\u0445 \u0433\u043b\u0443\u0445\u0438\u0445
    \u043e\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c
    \u044f\u0437\u044b\u043a. \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u043d \u0432\u0432\u044f\u0437\u0430\u043b\u0441\u044f
    \u0432 \u044f\u0440\u043e\u0441\u0442\u043d\u044b\u0439 \u0441\u043f\u043e\u0440 \u0441
    \u0423\u0438\u043b\u044c\u044f\u043c\u043e\u043c \u0425\u043e\u043b\u0434\u0435\u0440\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u044d\u0442\u0438\u0445
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432, \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u043c
    \u041f\u043e\u0444\u044d\u043c\u043e\u043c, \u0440\u0430\u043d\u0435\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043e\u043d, \u0438 \u043e\u0431\u0432\u0438\u043d\u044f\u043b \u0423\u043e\u043b\u043b\u0438\u0441\u0430
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0442\u043e\u0442 \u00ab\u043f\u0440\u0438\u0441\u0432\u043e\u0438\u043b
    \u0441\u0435\u0431\u0435 \u043b\u0430\u0432\u0440\u044b \u0441\u043e\u0441\u0435\u0434\u0430\u00bb.\n\n\u2694\ufe0f
    \u0414\u0443\u044d\u043b\u044c \u0430\u043d\u0430\u0433\u0440\u0430\u043c\u043c \u0438 \u0441\u043f\u043e\u0440\u044b
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0423\u043e\u043b\u043b\u0438\u0441
    \u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f \u043d\u0435\u0443\u0436\u0438\u0432\u0447\u0438\u0432\u044b\u043c
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c \u0438 \u0431\u044b\u043b \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d
    \u0432\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438 \u043b\u0438\u0447\u043d\u044b\u0445 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432.
    \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439 \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0435\u043d\u043d\u044b\u0439
    \u0441\u043f\u043e\u0440 \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b \u0441 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c
    \u0422\u043e\u043c\u0430\u0441\u043e\u043c \u0413\u043e\u0431\u0431\u0441\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u0443\u044f \u0442\u0440\u0443\u0434
    \u0423\u043e\u043b\u043b\u0438\u0441\u0430, \u0443\u043d\u0438\u0447\u0438\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043d\u0430\u0437\u0432\u0430\u043b \u0435\u0433\u043e \u00ab\u0441\u0442\u0440\u0443\u043f\u043e\u043c
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432\u00bb. \u0421\u043b\u043e\u0432\u0435\u0441\u043d\u0430\u044f
    \u0434\u0443\u044d\u043b\u044c \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438 \u0434\u043b\u0438\u043b\u0430\u0441\u044c
    \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0431\u044b\u043b\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0432\u043e \u0432\u0441\u0435\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0415\u0432\u0440\u043e\u043f\u0435. \u0415\u0449\u0435 \u043e\u0434\u0438\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u044d\u043f\u0438\u0437\u043e\u0434 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u0441 \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u043c \u0443\u0447\u0435\u043d\u044b\u043c
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u043c \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u043e\u043c.
    \u0423\u043e\u043b\u043b\u0438\u0441 \u043f\u043e\u0434\u0448\u0443\u0442\u0438\u043b \u043d\u0430\u0434
    \u043d\u0438\u043c, \u043e\u0442\u043e\u0441\u043b\u0430\u0432 \u0430\u043d\u0430\u0433\u0440\u0430\u043c\u043c\u0443,
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0443\u044e \u0435\u0433\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u043c \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0435
    \u0421\u0430\u0442\u0443\u0440\u043d\u0430. \u0413\u044e\u0439\u0433\u0435\u043d\u0441,
    \u0440\u0430\u0437\u0433\u0430\u0434\u0430\u0432 \u0435\u0435, \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0442\u043e \u0431\u044b\u043b \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d \u0432
    \u0438\u0433\u0440\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b
    \u0423\u043e\u043b\u043b\u0438\u0441\u0430 \u0431\u044b\u043b\u0430 \u0441\u043a\u043e\u0440\u0435\u0435
    \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0438\u0435\u0439 \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u0441\u0442\u0432\u0430.\n\n\U0001F4DA
    \u0421\u0438\u043c\u0432\u043e\u043b \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    \u0438 \u00ab\u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439\u00bb
    \u041e\u0434\u043d\u043e \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0439 \u0423\u043e\u043b\u043b\u0438\u0441\u0430
    \u2014 \u0441\u0438\u043c\u0432\u043e\u043b \u221e. \u041e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0432 \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u0435
    Arithmetica Infinitorum \u0432 1656 \u0433\u043e\u0434\u0443. \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0432\u044b\u0431\u0440\u0430\u043b \u044d\u0442\u043e\u0442
    \u0437\u043d\u0430\u043a, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u043c
    \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u00ab\u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u0434\u043e\u043b\u0433\u043e \u043e\u0431\u0432\u043e\u0434\u0438\u0442\u044c\u00bb \u043d\u0435\u043a\u0443\u044e
    \u043a\u0440\u0438\u0432\u0443\u044e. \u0421\u0438\u043c\u0432\u043e\u043b \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0434\u0430\u0447\u043d\u044b\u043c
    \u0438 \u043f\u0440\u043e\u0447\u043d\u043e \u0432\u043e\u0448\u0435\u043b \u0432 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443. \u0421\u0430\u043c \u0423\u043e\u043b\u043b\u0438\u0441
    \u043f\u0440\u0438\u0448\u0435\u043b \u0432 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043f\u043e\u0447\u0442\u0438 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e. \u0415\u0433\u043e
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043d\u0430\u0443\u043a\u0435 \u043f\u0440\u043e\u0441\u043d\u0443\u043b\u0441\u044f
    \u0432 1647 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u041e\u0442\u0440\u0435\u0434\u0430
    \"Clavis Mathematicae\". \u0421\u0432\u043e\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438,
    \u043e\u043d \u043e\u0441\u0432\u043e\u0438\u043b \u044d\u0442\u0443 \u043a\u043d\u0438\u0433\u0443
    \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u0435\u043b\u044c
    \u0438 \u0441 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430
    \u043d\u0430\u0447\u0430\u043b \u0434\u0435\u043b\u0430\u0442\u044c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f. \u0412 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0432 \u0410\u043d\u0433\u043b\u0438\u0438
    \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0430\u0441\u044c \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u043e\u0439 \u0438 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0430\u0441\u044c
    \u043a\u0430\u043a \u00ab\u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435\u00bb
    \u0440\u0435\u043c\u0435\u0441\u043b\u043e \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0435\u0432
    \u0438 \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439,
    \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u043f\u0440\u043e\u0440\u044b\u0432
    \u0435\u0449\u0435 \u0431\u043e\u043b\u0435\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u044f\u044e\u0449\u0438\u043c."
  interestingFactsEn: "John Wallace's personality was full of contrasts and surprises, and behind this serious Oxford professor and inventor of the mathematical symbol of infinity, there was a brilliant cryptographer, a man capable of incredible computations in his mind, and even a hero of absurd litigation over a drinking house, these are the brightest and most unexpected facts of his life.\n\nIn 1669, Wallis, suffering from insomnia, calculated in his mind what was amazing to his imagination. In his letter, he explained how, lying in bed, \"without pen, ink, paper, or anything like that, he extracted a square root of 53 digits.\" The task was to extract a square root from the 30 million million million million million million million million million million million million (with 49 zeros).The result, 1,73205 08075,68077 29353, was recorded on paper the following day, and this phenomenal ability was so striking that the secretary of the Royal Society of London even sent a colleague to check on Wallis's performance.\n\nIn 1674, Wallace, already known as a mathematician and custodian of the university archives, found himself in the center of a... scandal caused by the discovery of a new wine cellar in Oxford, where the city, without the consent of the university, licensed the opening of a fourth wine trade in the city, causing anger at the university leadership, which found it a threat to discipline and an infringement of its privileges.The Vice Chancellor brought Wallace, known for his intense analytical thought and dedication to the university, to prepare a legal case against the owner of the institution, William Sterk, so Wallace became a tavern destroyer, drowning in bureaucratic and judicial litigation, which in his biography looks chickeny in the face of abstract mathematical research.\n\nWallis was not only a mathematician but also a linguisticist, he had excellent mastery of Latin, Greek, Hebrew, French, and written a powerful grammar of English. His main work, Aritmetica Infinitorum, was published in Latin to be accessible to all of the scientific world. His method of teaching deaf speech deserves special attention.In 1670, he published an article in Philosophical Transports on how he taught two deaf pupils to speak and understand language, but he became involved in a violent dispute with William Holder, who claimed that one of these students, Alexander Potham, had previously studied and accused Wallis of \"absorbing the neighbor's laurels.\"\n\nThe duel of anagrams and arguments with colleagues Wallace was famous for his unsurvivable character and he was involved in many scientific and personal conflicts. Perhaps the most violent dispute he had with philosopher Thomas Gobbs, who, commenting on Wallace's work, had described him in a disgraceful way as a \"structural of symbols.\" The word duel between them had been long and well known in all of scientific Europe.Another interesting episode involved a Dutch scientist, Christian Guygens, who made a joke about him by sending an anagram containing his hypothesis of a possible satellite of Saturn, and Guygens discovered that he had been involved in a game that Wallis was more of a demonstration of superiority.\n\n* The symbol of infinity and \"happiness\" is one of Wallace's most famous inheritances, the symbol . . It first appeared in his work Aritmetica Infinitorum in 1656. It is assumed that Wallace chose this sign because they could have \"done forever\" a certain curve. The symbol proved to be amazingly successful and had a solid way into world science. Wallace himself came into great math almost by accident.His keen interest in science woke up in 1647, when he read William Otred's work \"Clavis Mathematicae.\" In his words, he mastered the book in a few weeks and began making his own discoveries. At the time, mathematics in England was not considered academic discipline and was perceived as a \"mechanical\" trade of traders and navigators, making its breakthrough even more impressive."
