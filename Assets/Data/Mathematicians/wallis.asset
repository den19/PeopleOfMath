    \u043e\u043a\u0441\u0444\u043e\u0440\u0434\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u0438\u043c\u0432\u043e\u043b\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0441\u044f \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444, \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0439 \u043d\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0432 \u0443\u043c\u0435,
    \u0438 \u0434\u0430\u0436\u0435 \u0433\u0435\u0440\u043e\u0439 \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u043e\u0439
    \u0442\u044f\u0436\u0431\u044b \u0438\u0437-\u0437\u0430 \u043f\u0438\u0442\u0435\u0439\u043d\u043e\u0433\u043e
    \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u044f\u0440\u043a\u0438\u0435 \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F9E0
    \u00ab\u0421\u0447\u0435\u0442 \u0432 \u0443\u043c\u0435\u00bb: \u043f\u043e\u0434\u0432\u0438\u0433
