    \u0441\u0432\u043e\u0451 \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435.
    \u0421\u0432\u043e\u0439 \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u043e\u043d \u0437\u0430\u043a\u0430\u0437\u0430\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u043c\u0443 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0443
    \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0443 \u041a\u043d\u0435\u043b\u043b\u0435\u0440\u0443
    \u0432 1701 \u0433\u043e\u0434\u0443 \u2014 \u043d\u0430 \u043d\u0451\u043c \u043e\u043d
