  achievementsRu: "\u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441 \u0441\u0442\u043e\u044f\u043b
    \u0443 \u0438\u0441\u0442\u043e\u043a\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u0438 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d
    \u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b\u0438
    \u0441\u0432\u043e\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u2014 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u0445, \u043d\u043e \u0438 \u0432 \u043d\u043e\u0432\u043e\u043c,
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043f\u043e\u0434\u0445\u043e\u0434\u0435
    \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0437\u0430\u0434\u0430\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0440\u0430\u043d\u0435\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438.
    \u0412\u043e\u0442 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0432\u0435\u0445\u0438
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0438
    \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445.\n\n\U0001F4D6 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e\u00bb (1655\u20131656):
    \u0442\u0440\u0430\u043c\u043f\u043b\u0438\u043d \u0434\u043b\u044f \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432 1656 \u0433\u043e\u0434\u0443, \u2014 \u0441\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0438 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u0423\u043e\u043b\u043b\u0438\u0441\u0430. \u0412 \u043d\u0435\u0439 \u043e\u043d: \u0420\u0430\u0437\u0432\u0438\u043b
    \u043c\u0435\u0442\u043e\u0434 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445 \u041a\u0430\u0432\u0430\u043b\u044c\u0435\u0440\u0438:
    \u0412\u043c\u0435\u0441\u0442\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u0423\u043e\u043b\u043b\u0438\u0441 \u043f\u0440\u0438\u0434\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434\u0443 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443, \u043f\u0440\u0438\u0441\u0432\u043e\u0438\u0432 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u043c. \u041e\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0435\u0439,
    \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438 \u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u0444\u0438\u0433\u0443\u0440. \u0412\u0432\u0435\u043b \u0434\u0440\u043e\u0431\u043d\u044b\u0435
    \u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438:
    \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0440\u043e\u0440\u044b\u0432. \u0423\u043e\u043b\u043b\u0438\u0441
    \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0441\u0442\u044c \u0442\u0430\u043a\u0438\u0445
    \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c \u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u0434\u043b\u044f \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u0435\u0435
    \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430 \u043a\u0440\u0438\u0432\u044b\u0445.
    \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u043d\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434: \u0412\u043c\u0435\u0441\u0442\u043e \u0441\u0442\u0440\u043e\u0433\u0438\u0445
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u043e\u043d \u0447\u0430\u0441\u0442\u043e \u043e\u0431\u043e\u0431\u0449\u0430\u043b \u043d\u0430
    \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432. \u042d\u0442\u043e
    \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u0443
    (\u0424\u0435\u0440\u043c\u0430 \u043d\u0430\u0437\u0432\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0441\u0442\u0440\u043e\u0433\u0438\u043c,
    \u0430 \u0413\u043e\u0431\u0431\u0441 \u2014 \u00ab\u0441\u0442\u0440\u0443\u043f\u043e\u043c
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432\u00bb), \u043d\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c
    \u043d\u043e\u0432\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b.
    \u042d\u0442\u043e\u0442 \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u0441\u0431\u043b\u0438\u0436\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0441 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u043e\u0439 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.
    \u0412\u044b\u0432\u0435\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0423\u043e\u043b\u043b\u0438\u0441\u0430:
    \u0410\u043f\u043e\u0444\u0435\u043e\u0437 \u0440\u0430\u0431\u043e\u0442\u044b \u2014 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0430 \u03c0 \u043f\u0443\u0442\u0451\u043c
    \u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u0438 (\u043e\u0442\u044b\u0441\u043a\u0430\u043d\u0438\u044f
    \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b\u0445 \u0447\u043b\u0435\u043d\u043e\u0432
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438).
    \u0418\u043c\u0435\u043d\u043d\u043e \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e\u00bb \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b\u043e
    \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u0418\u0441\u0430\u0430\u043a\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u043d\u0430 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0431\u0438\u043d\u043e\u043c\u0430 \u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0444\u043b\u044e\u043a\u0441\u0438\u0439.\n\n\U0001F4D0
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u0445\u00bb (1659) \u0412 \u044d\u0442\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u0423\u043e\u043b\u043b\u0438\u0441 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e, \u043e\u043f\u0438\u0441\u0430\u0432
    \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0435\u0447\u0435\u043d\u0438\u044f
    (\u044d\u043b\u043b\u0438\u043f\u0441, \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u0443,
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0443) \u043d\u0435 \u043a\u0430\u043a
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0441\u0435\u0447\u0435\u043d\u0438\u044f
    \u043a\u043e\u043d\u0443\u0441\u0430 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u044c\u044e,
    \u0430 \u043a\u0430\u043a \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442. \u042d\u0442\u043e \u0431\u044b\u043b
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0439 \u0448\u0430\u0433 \u043a \u0441\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u044b.\n\n\U0001F4DD
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435\u00bb
    (1685) \u0412 \u043a\u043e\u043d\u0446\u0435 \u0441\u0432\u043e\u0435\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0438\u0437\u0434\u0430\u043b \u044d\u0442\u0443 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u0438\u0442\u043e\u0433\u043e\u043c
    \u0435\u0433\u043e \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439. \u0412
    \u043d\u0435\u0439 \u043e\u043d: \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u044b, \u043f\u043e\u043a\u0430\u0437\u0430\u0432
    \u0435\u0451 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043e\u0442 \u0434\u0440\u0435\u0432\u043d\u043e\u0441\u0442\u0438
    \u0434\u043e \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u0410\u043d\u0442\u0438\u0446\u0438\u043f\u0438\u0440\u043e\u0432\u0430\u043b \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u0441 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c\u0438
    \u0432\u0438\u0434\u0430 a + b\u221a\u22121. \u041f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u044b
    \u0434\u0435\u043b\u0435\u043d\u0438\u044e \u0443\u0433\u043b\u043e\u0432, \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0435,
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u0439
    \u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c.\n\n\u2699\ufe0f
    \u00ab\u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u00bb (1669\u20131671) \u0423\u043e\u043b\u043b\u0438\u0441
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412 \u044d\u0442\u043e\u043c \u0442\u0440\u0435\u0445\u0447\u0430\u0441\u0442\u043d\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u043e\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443, \u0434\u0430\u0432 \u0431\u043e\u043b\u0435\u0435
    \u0441\u0442\u0440\u043e\u0433\u0438\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u0442\u0430\u043a\u0438\u043c \u043f\u043e\u043d\u044f\u0442\u0438\u044f\u043c, \u043a\u0430\u043a
    \u0441\u0438\u043b\u0430 \u0438 \u0438\u043c\u043f\u0443\u043b\u044c\u0441, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b, \u0447\u0442\u043e \u0437\u0435\u043c\u043d\u043e\u0435
    \u043f\u0440\u0438\u0442\u044f\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u043d\u043e
    \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u044b\u043c
    \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u0417\u0435\u043c\u043b\u0438.\n\n\u2728 \u0412\u043a\u043b\u0430\u0434
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043d\u043e\u0442\u0430\u0446\u0438\u044e \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0438 \u043f\u043e\u0432\u0441\u0435\u043c\u0435\u0441\u0442\u043d\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0423\u043e\u043b\u043b\u0438\u0441\u0430 \u2014 \u044d\u0442\u043e \u0441\u0438\u043c\u0432\u043e\u043b
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u221e, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0432 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e\u00bb.
    \u0412 \u0438\u0442\u043e\u0433\u0435, \u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043d\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b,
    \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u043e\u043d\u0438 \u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c \u043d\u0435\u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438,
    \u043e\u0442\u043a\u0440\u044b\u043b\u0438 \u043d\u043e\u0432\u044b\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u044b
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432
    \u0435\u0451 \u0432 \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f. \u0415\u0433\u043e
    \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u043e\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439 Opera Mathematica* (1693\u20131699)
    \u0441\u0442\u0430\u043b\u043e \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u043e\u043c
    \u044d\u0442\u043e\u0439 \u044d\u043f\u043e\u0445\u0438."
  achievementsEn: 
  personalLifeRu: "\u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441 \u043f\u0440\u043e\u0436\u0438\u043b
    \u0434\u043e\u043b\u0433\u0443\u044e \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u043e
    \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c,
    \u043f\u0440\u043e\u043d\u0438\u0437\u0430\u043d\u043d\u0443\u044e \u0431\u0443\u0440\u043d\u044b\u043c\u0438
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0439
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 XVII \u0432\u0435\u043a\u0430. \u0415\u0433\u043e
    \u043f\u0443\u0442\u044c \u043e\u0442 \u0441\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430 \u0434\u043e \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0415\u0432\u0440\u043e\u043f\u044b
    \u0431\u044b\u043b \u043f\u043e\u043b\u043d \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432, \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0442\u0440\u0438\u0443\u043c\u0444\u043e\u0432 \u0438 \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0451\u043d\u043d\u044b\u0445
    \u0441\u043f\u043e\u0440\u043e\u0432.\n\n\U0001F3E1 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 23 \u043d\u043e\u044f\u0431\u0440\u044f 1616
    \u0433\u043e\u0434\u0430 (\u043f\u043e \u0441\u0442\u0430\u0440\u043e\u043c\u0443 \u0441\u0442\u0438\u043b\u044e)
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u042d\u0448\u0444\u043e\u0440\u0434, \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u043e
    \u041a\u0435\u043d\u0442. \u041e\u043d \u0431\u044b\u043b \u0442\u0440\u0435\u0442\u044c\u0438\u043c
    \u0438\u0437 \u043f\u044f\u0442\u0438 \u0434\u0435\u0442\u0435\u0439 \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0443\u0432\u0430\u0436\u0430\u0435\u043c\u043e\u0433\u043e \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430,
    \u0442\u0430\u043a\u0436\u0435 \u043d\u043e\u0441\u0438\u0432\u0448\u0435\u0433\u043e \u0438\u043c\u044f
    \u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441, \u0438 \u0435\u0433\u043e
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0436\u0435\u043d\u044b \u0414\u0436\u043e\u0430\u043d\u043d\u044b
    \u0427\u0430\u043f\u043c\u0430\u043d. \u041a\u043e\u0433\u0434\u0430 \u0414\u0436\u043e\u043d\u0443
    \u0431\u044b\u043b\u043e \u043e\u043a\u043e\u043b\u043e \u0448\u0435\u0441\u0442\u0438 \u043b\u0435\u0442,
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f,
    \u043d\u043e \u0441\u0435\u043c\u044c\u044f \u0441\u043c\u043e\u0433\u043b\u0430 \u0434\u0430\u0442\u044c
    \u0435\u043c\u0443 \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    14 \u043c\u0430\u0440\u0442\u0430 1645 \u0433\u043e\u0434\u0430 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0421\u044e\u0437\u0430\u043d\u043d\u0435 \u0413\u043b\u0430\u0439\u0434 (Susanna
    Glynde). \u042d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u043e\u043a\u0430\u0437\u0430\u043b
    \u043f\u0440\u044f\u043c\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430
    \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0443: \u0438\u0437-\u0437\u0430
    \u0436\u0435\u043d\u0438\u0442\u044c\u0431\u044b \u0435\u043c\u0443 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c
    \u043e\u0442\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u043d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u0430
    \u0441 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u043c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c.
    \u0423 \u043d\u0438\u0445 \u0431\u044b\u043b\u043e \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439:
    \u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441-\u043c\u043b\u0430\u0434\u0448\u0438\u0439
    (1650\u20131717) \u2014 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430.
    \u042d\u043d\u043d (1656\u20131718) \u2014 \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436
    \u0437\u0430 \u0441\u044d\u0440\u0430 \u0414\u0436\u043e\u043d\u0430 \u0411\u043b\u0435\u043d\u043a\u043e\u0443
    \u0438 \u0441\u0442\u0430\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0432
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u0430\u0445.
    \u042d\u043b\u0438\u0437\u0430\u0431\u0435\u0442 (1658\u20131703).\n\n\U0001F393 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0448\u0430\u0433\u0438 \u0432 \u043d\u0430\u0443\u043a\u0435
    \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0423\u043e\u043b\u043b\u0438\u0441 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432 \u0448\u043a\u043e\u043b\u0435
    \u0432 \u042d\u0448\u0444\u043e\u0440\u0434\u0435, \u043d\u043e \u0432 1625 \u0433\u043e\u0434\u0443,
    \u0441\u043f\u0430\u0441\u0430\u044f\u0441\u044c \u043e\u0442 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0438
    \u0447\u0443\u043c\u044b, \u0435\u0433\u043e \u043c\u0430\u0442\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0430
    \u0435\u0433\u043e \u0432 \u0433\u0440\u0430\u043c\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0414\u0436\u0435\u0439\u043c\u0441\u0430 \u041c\u043e\u0432\u0430\u0442\u0430
    \u0432 \u0422\u0435\u043d\u0442\u0435\u0440\u0434\u0435\u043d\u0435. \u0422\u0430\u043c
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0441\u0435\u0431\u044f \u043a\u0430\u043a \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439
    \u0443\u0447\u0435\u043d\u0438\u043a. \u0412 \u0441\u0432\u043e\u0435\u0439 \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u043e\u043d \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u00ab\u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0443\u0447\u0438\u0442\u044c \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c, \u043d\u043e
    \u0437\u043d\u0430\u0442\u044c \u043e\u0441\u043d\u043e\u0432\u044b \u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u044b
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u044f \u0443\u0447\u0438\u043b\u00bb. \u0412
    1631 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0448\u043a\u043e\u043b\u0443 \u041c\u0430\u0440\u0442\u0438\u043d\u0430 \u0425\u043e\u043b\u0431\u0438\u0447\u0430
    \u0432 \u0424\u0435\u043b\u0441\u0442\u0435\u0434\u0435, \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u043e
    \u042d\u0441\u0441\u0435\u043a\u0441, \u0433\u0434\u0435 \u043e\u0441\u0432\u043e\u0438\u043b
    \u043b\u0430\u0442\u044b\u043d\u044c, \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438 \u0438\u0432\u0440\u0438\u0442. \u041e\u0434\u043d\u0430\u043a\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0430\u0441\u044c
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u043e\u0439
    \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u043b\u0438\u0448\u044c
    \u043a\u0430\u043a \u00ab\u0440\u0435\u043c\u0435\u0441\u043b\u0435\u043d\u043d\u043e\u0435
    \u0434\u0435\u043b\u043e\u00bb, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0423\u043e\u043b\u043b\u0438\u0441
    \u043d\u0435 \u0441\u043e\u043f\u0440\u0438\u043a\u0430\u0441\u0430\u043b\u0441\u044f \u0441
    \u043d\u0435\u0439 \u0432 \u0448\u043a\u043e\u043b\u0435. \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u0430\u044f
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e
    \u2014 \u0432 \u0440\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0435\u043d\u0441\u043a\u0438\u0435
    \u043a\u0430\u043d\u0438\u043a\u0443\u043b\u044b 1631 \u0433\u043e\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0435\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0431\u0440\u0430\u0442,
    \u043e\u0431\u0443\u0447\u0430\u0432\u0448\u0438\u0439\u0441\u044f \u043d\u0430 \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0430,
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0435\u043c\u0443 \u043f\u0440\u0430\u0432\u0438\u043b\u0430
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438. \u042d\u0442\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u00ab\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c
    \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0435
    \u0447\u0430\u0441\u044b\u00bb. \u0412 1632 \u0433\u043e\u0434\u0443 \u0423\u043e\u043b\u043b\u0438\u0441
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u041a\u043e\u043b\u043b\u0435\u0434\u0436
    \u042d\u043c\u043c\u0430\u043d\u0443\u0438\u043b \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435
    \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430 \u0432 1637 \u0433\u043e\u0434\u0443,
    \u0430 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430 \u2014 \u0432 1640-\u043c. \u0412
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0431\u044b\u043b\u0438 \u0448\u0438\u0440\u043e\u043a\u0438: \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u044d\u0442\u0438\u043a\u0443, \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0443,
    \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044e, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e,
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443 \u0438 \u0430\u043d\u0430\u0442\u043e\u043c\u0438\u044e.
    \u041e\u043d \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u0437\u0430\u0449\u0438\u0449\u0430\u043b
    \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u043a\u0440\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0423\u0438\u043b\u044c\u044f\u043c\u0430
    \u0413\u0430\u0440\u0432\u0435\u044f, \u0441\u0442\u0430\u0432 \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435,
    \u043a\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u043d\u0430
    \u0434\u0438\u0441\u043f\u0443\u0442\u0435.\n\n\u26ea \u0414\u0443\u0445\u043e\u0432\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u043e\u043c \u0412 1640 \u0433\u043e\u0434\u0443
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0431\u044b\u043b \u0440\u0443\u043a\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d
    \u0432 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0438 \u0438 \u0441\u0442\u0430\u043b
    \u043a\u0430\u043f\u0435\u043b\u043b\u0430\u043d\u043e\u043c \u0441\u044d\u0440\u0430 \u0420\u0438\u0447\u0430\u0440\u0434\u0430
    \u0414\u0430\u0440\u043b\u0438 \u0432 \u0419\u043e\u0440\u043a\u0448\u0438\u0440\u0435.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u043a\u0440\u0443\u0442\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c \u0441 \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u0410\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0439 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b. \u0412 1642 \u0433\u043e\u0434\u0443 \u0435\u043c\u0443
    \u0432 \u0440\u0443\u043a\u0438 \u043f\u043e\u043f\u0430\u043b\u0430 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0434\u0435\u043f\u0435\u0448\u0430 \u0440\u043e\u044f\u043b\u0438\u0441\u0442\u043e\u0432,
    \u0438 \u043e\u043d \u0441\u0443\u043c\u0435\u043b \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u0442\u044c
    \u0435\u0451 \u0432\u0441\u0435\u0433\u043e \u0437\u0430 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430.
    \u042d\u0442\u043e\u0442 \u0443\u0441\u043f\u0435\u0445 \u043f\u0440\u0438\u043d\u0435\u0441
    \u0435\u043c\u0443 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e \u043d\u0435\u043f\u0440\u0435\u0432\u0437\u043e\u0439\u0434\u0451\u043d\u043d\u043e\u0433\u043e
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0430 \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0443\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443.
    \u041e\u043d \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043d\u0430 \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442, \u0432\u0437\u043b\u0430\u043c\u044b\u0432\u0430\u044f
    \u0448\u0438\u0444\u0440\u044b \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u0432
    \u043a\u043e\u0440\u043e\u043b\u044f. \u0412 1643 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u0442\u0430\u043b \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0451\u043c \u0412\u0435\u0441\u0442\u043c\u0438\u043d\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439
    \u0430\u0441\u0441\u0430\u043c\u0431\u043b\u0435\u0438, \u0430 \u0432 1644 \u0433\u043e\u0434\u0443
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e
    \u0432 \u041a\u0443\u0438\u043d\u0437-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e, \u043e\u0434\u043d\u0430\u043a\u043e, \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0436\u0435\u043d\u0438\u0442\u044c\u0431\u044b \u0432 1645
    \u0433\u043e\u0434\u0443. \u041e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041b\u043e\u043d\u0434\u043e\u043d, \u0433\u0434\u0435 \u0441\u0442\u0430\u043b
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u043c \u0446\u0435\u0440\u043a\u0432\u0438
    \u0421\u0432\u044f\u0442\u043e\u0433\u043e \u0413\u0430\u0432\u0440\u0438\u0438\u043b\u0430
    \u043d\u0430 \u0424\u0435\u043d\u0447\u0435\u0440\u0447-\u0441\u0442\u0440\u0438\u0442.\n\n\U0001F9D1\u200d\U0001F3EB
    \u041e\u043a\u0441\u0444\u043e\u0440\u0434 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0440\u044b\u0432\u044b \u0412 \u041b\u043e\u043d\u0434\u043e\u043d\u0435
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0432\u043e\u0448\u0451\u043b \u0432 \u043a\u0440\u0443\u0436\u043e\u043a
    \u0443\u0447\u0451\u043d\u044b\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043b \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u0438\u043c \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0438\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c. \u0412 1647 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0442\u0440\u0443\u0434\u043e\u043c \u0423\u0438\u043b\u044c\u044f\u043c\u0430
    \u041e\u0442\u0440\u0435\u0434\u0430 \"Clavis Mathematicae\" (\u00ab\u041a\u043b\u044e\u0447\u0438
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb) \u0438, \u043f\u043e
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c,
    \u043e\u0441\u0432\u043e\u0438\u043b \u0435\u0433\u043e \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043d\u0435\u0434\u0435\u043b\u044c. \u0421 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430
    \u043d\u0430\u0447\u0430\u043b\u0441\u044f \u0435\u0433\u043e \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0432\u0437\u043b\u0451\u0442 \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.
    \u0412 1649 \u0433\u043e\u0434\u0443, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b
    \u043f\u0435\u0442\u0438\u0446\u0438\u044e \u043f\u0440\u043e\u0442\u0438\u0432 \u043a\u0430\u0437\u043d\u0438
    \u043a\u043e\u0440\u043e\u043b\u044f \u041a\u0430\u0440\u043b\u0430 I, \u0423\u043e\u043b\u043b\u0438\u0441
    \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0421\u0430\u0432\u0438\u043b\u044c\u0441\u043a\u0438\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u0432\u043e\u0435\u0439 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u0438
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0430 \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435
    \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432. \u042d\u0442\u043e
    \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435, \u0441\u0434\u0435\u043b\u0430\u043d\u043d\u043e\u0435
    \u043f\u043e \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043c\u043e\u0442\u0438\u0432\u0430\u043c,
    \u0441\u0442\u0430\u043b\u043e \u0441\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u044b\u043c.
    \u041e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u044d\u0442\u0443 \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0431\u043e\u043b\u0435\u0435 54 \u043b\u0435\u0442 \u0434\u043e \u0441\u0430\u043c\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438. \u0412 1654 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u0435\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u043e\u0433\u043e
    \u0430\u0440\u0445\u0438\u0432\u0430 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u044f.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0435
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438
    \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e\u00bb
    (1656) \u0438 \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u0445\u00bb (1655), \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u043b\u044f
    \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430.\n\n\u2694\ufe0f
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0451\u043d\u044b\u043c\u0438: \u0441\u043f\u043e\u0440\u044b \u0438 \u0441\u043e\u044e\u0437\u044b
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u043e\u0438\u043c \u0443\u043c\u043e\u043c,
    \u043d\u043e \u0438 \u043d\u0435\u0443\u0436\u0438\u0432\u0447\u0438\u0432\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c.
    \u041e\u043d \u0431\u044b\u043b \u0432\u043e\u0432\u043b\u0435\u0447\u0451\u043d \u0432
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u0440\u043e\u043c\u043a\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0441\u043f\u043e\u0440\u043e\u0432: \u0421
    \u0422\u043e\u043c\u0430\u0441\u043e\u043c \u0413\u043e\u0431\u0431\u0441\u043e\u043c: \u0418\u0445
    \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0430 \u0434\u043b\u0438\u043b\u0430\u0441\u044c
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f\u043c\u0438. \u0413\u043e\u0431\u0431\u0441,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c,
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439, \u043d\u043e \u0423\u043e\u043b\u043b\u0438\u0441
    \u0431\u0435\u0437\u0436\u0430\u043b\u043e\u0441\u0442\u043d\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b, \u043d\u0430\u0445\u043e\u0434\u044f
    \u0432 \u043d\u0438\u0445 \u043e\u0448\u0438\u0431\u043a\u0438. \u041b\u0438\u0447\u043d\u0430\u044f
    \u043d\u0435\u043f\u0440\u0438\u044f\u0437\u043d\u044c \u0423\u043e\u043b\u043b\u0438\u0441\u0430
    \u043a \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u043c\u0443 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0438\u0437\u043c\u0443
    \u0413\u043e\u0431\u0431\u0441\u0430 \u043f\u043e\u0434\u043f\u0438\u0442\u044b\u0432\u0430\u043b\u0430
    \u0438\u0445 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442. \u0421 \u0423\u0438\u043b\u044c\u044f\u043c\u043e\u043c
    \u0425\u043e\u043b\u0434\u0435\u0440\u043e\u043c: \u0423\u043e\u043b\u043b\u0438\u0441 \u043f\u0440\u0438\u0441\u0432\u043e\u0438\u043b
    \u0441\u0435\u0431\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u0443 \u0425\u043e\u043b\u0434\u0435\u0440\u0430
    \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435 \u043c\u0435\u0442\u043e\u0434\u0430
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0440\u0435\u0447\u0438 \u0433\u043b\u0443\u0445\u043e\u043d\u0435\u043c\u044b\u0445,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f\u043c
    \u0432 \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435. \u0421 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c
    \u0438 \u0425\u0430\u0440\u0440\u0438\u043e\u0442\u043e\u043c: \u0412 \u0441\u0432\u043e\u0451\u043c
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435\u00bb
    (1685) \u0423\u043e\u043b\u043b\u0438\u0441 \u043f\u0440\u0435\u0432\u043e\u0437\u043d\u043e\u0441\u0438\u043b
    \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0422\u043e\u043c\u0430\u0441\u0430 \u0425\u0430\u0440\u0440\u0438\u043e\u0442\u0430 \u0438
    \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0442\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0414\u0435\u043a\u0430\u0440\u0442\u0430,
    \u0447\u0442\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c
    \u0435\u0433\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c\u0430.
    \u0421 \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c \u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0435\u043c:
    \u0411\u0443\u0434\u0443\u0447\u0438 \u0441\u0442\u0430\u0440\u0448\u0438\u043c \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439,
    \u0423\u043e\u043b\u043b\u0438\u0441 \u043c\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0441\u044f
    \u0441 \u043d\u0438\u043c\u0438. \u041e\u043d \u0441\u044b\u0433\u0440\u0430\u043b \u0437\u0430\u043c\u0435\u0442\u043d\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0435 \u043e
    \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u0441\u0442\u0430\u0440\u0430\u044f\u0441\u044c
    \u043e\u0442\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044c \u0441\u043b\u0430\u0432\u0443
    \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\U0001F4DC
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041f\u043e\u0441\u043b\u0435 \u0420\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438
    \u043c\u043e\u043d\u0430\u0440\u0445\u0438\u0438 \u0432 1660 \u0433\u043e\u0434\u0443 \u0423\u043e\u043b\u043b\u0438\u0441
    \u0441\u0443\u043c\u0435\u043b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0439
    \u043f\u043e\u0441\u0442 \u0438 \u0434\u0430\u0436\u0435 \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0438\u043c \u043a\u0430\u043f\u0435\u043b\u043b\u0430\u043d\u043e\u043c
    \u041a\u0430\u0440\u043b\u043e\u043c II. \u041e\u043d \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u0432 1662 \u0433\u043e\u0434\u0443 \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0436\u0438\u0437\u043d\u0438 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0435\u0433\u043e
    \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c. \u0412
    1697 \u0433\u043e\u0434\u0443, \u0437\u0430 \u0448\u0435\u0441\u0442\u044c \u043b\u0435\u0442
    \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438, \u0423\u043e\u043b\u043b\u0438\u0441
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0435
    \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e \u0441\u0432\u043e\u0435\u043c\u0443 \u0434\u0440\u0443\u0433\u0443
    \u0422\u043e\u043c\u0430\u0441\u0443 \u0421\u043c\u0438\u0442\u0443, \u0433\u0434\u0435
    \u043f\u043e\u0434\u0432\u0451\u043b \u0438\u0442\u043e\u0433\u0438 \u0441\u0432\u043e\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0438 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0438\u043b,
    \u043a\u0430\u043a \u043e\u043d \u0445\u043e\u0442\u0435\u043b, \u0447\u0442\u043e\u0431\u044b
    \u0435\u0433\u043e \u043f\u043e\u043c\u043d\u0438\u043b\u0438. \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0438\u0437\u0434\u0430\u043d\u0438\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u043e\u0433\u043e
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u044f \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439
    Opera Mathematica* (1693\u20131699), \u0436\u0435\u043b\u0430\u044f \u0437\u0430\u043a\u0440\u0435\u043f\u0438\u0442\u044c
    \u0441\u0432\u043e\u0451 \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435.
    \u0421\u0432\u043e\u0439 \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u043e\u043d \u0437\u0430\u043a\u0430\u0437\u0430\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u043c\u0443 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0443
    \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0443 \u041a\u043d\u0435\u043b\u043b\u0435\u0440\u0443
    \u0432 1701 \u0433\u043e\u0434\u0443 \u2014 \u043d\u0430 \u043d\u0451\u043c \u043e\u043d
    \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0451\u043d \u0432 \u043e\u0431\u043b\u0430\u0447\u0435\u043d\u0438\u0438
    \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u044f
    \u0441 \u043a\u043d\u0438\u0433\u0430\u043c\u0438 \u0438 \u0447\u0435\u0440\u0442\u0435\u0436\u043e\u043c
    \u043f\u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u043c.
    \u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    8 \u043d\u043e\u044f\u0431\u0440\u044f 1703 \u0433\u043e\u0434\u0430 (\u043f\u043e \u043d\u043e\u0432\u043e\u043c\u0443
    \u0441\u0442\u0438\u043b\u044e) \u0432 \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 86 \u043b\u0435\u0442 \u0438 \u0431\u044b\u043b
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u0432 \u0446\u0435\u0440\u043a\u0432\u0438
    \u0421\u0432\u044f\u0442\u043e\u0439 \u041c\u0430\u0440\u0438\u0438. \u0415\u0433\u043e
    \u0434\u043e\u043c \u043d\u0430 \u041d\u044c\u044e-\u041a\u043e\u043b\u043b\u0435\u0434\u0436-\u043b\u0435\u0439\u043d,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b
    \u0441 1672 \u0433\u043e\u0434\u0430, \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0431\u044b\u043b \u043f\u0435\u0440\u0435\u0434\u0430\u043d
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0443 \u0435\u0433\u043e
    \u0441\u044b\u043d\u043e\u043c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u0438 \u0434\u043b\u044f \u0421\u0430\u0432\u0438\u043b\u044c\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432."
  personalLifeEn: 
  shortBioRu: "\u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441 (John Wallis) \u2014 \u043e\u0434\u043d\u0430
    \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0444\u0438\u0433\u0443\u0440
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0441\u0442\u043e\u044f\u0432\u0448\u0430\u044f \u0443 \u0438\u0441\u0442\u043e\u043a\u043e\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438 \u043f\u0440\u043e\u043b\u043e\u0436\u0438\u0432\u0448\u0430\u044f
    \u043f\u0443\u0442\u044c \u0434\u043b\u044f \u0418\u0441\u0430\u0430\u043a\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u0442\u0435\u0441\u043d\u043e
    \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430 \u0441 \u0431\u0443\u0440\u043d\u044b\u043c\u0438
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0439
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 XVII \u0432\u0435\u043a\u0430, \u0430 \u0435\u0433\u043e
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0435 \u0442\u0430\u043b\u0430\u043d\u0442\u044b
    \u043f\u0440\u043e\u0441\u0442\u0438\u0440\u0430\u043b\u0438\u0441\u044c \u0434\u0430\u043b\u0435\u043a\u043e
    \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0447\u0438\u0441\u0442\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438.\n\n\U0001F4DC \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 (1616\u20131640)
    \u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    23 \u043d\u043e\u044f\u0431\u0440\u044f 1616 \u0433\u043e\u0434\u0430 \u0432 \u042d\u0448\u0444\u043e\u0440\u0434\u0435,
    \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u043e \u041a\u0435\u043d\u0442, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430. \u0415\u0433\u043e \u043e\u0442\u0435\u0446
    \u0443\u043c\u0435\u0440, \u043a\u043e\u0433\u0434\u0430 \u0414\u0436\u043e\u043d\u0443
    \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e \u0448\u0435\u0441\u0442\u044c \u043b\u0435\u0442,
    \u043d\u043e \u0441\u0435\u043c\u044c\u044f \u0441\u043c\u043e\u0433\u043b\u0430 \u0434\u0430\u0442\u044c
    \u0435\u043c\u0443 \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u0423\u043e\u043b\u043b\u0438\u0441
    \u0440\u0430\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438.
    \u041e\u0431\u043b\u0430\u0434\u0430\u044f \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0430\u043c\u044f\u0442\u044c\u044e \u0438 \u043d\u0430\u0432\u044b\u043a\u0430\u043c\u0438
    \u0441\u0447\u0435\u0442\u0430, \u043e\u043d, \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u043c\u043e\u0433 \u0438\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0435
    \u043a\u043e\u0440\u043d\u0438 \u0438\u0437 53-\u0437\u043d\u0430\u0447\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0432 \u0443\u043c\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043e\u043d \u043d\u0435
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b, \u0437\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c
    \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u043e\u0439 \u043f\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u043f\u0440\u043e\u0441\u043d\u0443\u043b\u0441\u044f \u0443 \u043d\u0435\u0433\u043e \u0432
    15 \u043b\u0435\u0442, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e
    \u0443\u0432\u0438\u0434\u0435\u043b \u043a\u043d\u0438\u0433\u0443 \u043f\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435
    \u0441\u0432\u043e\u0435\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u0438 \u0437\u0430
    \u0434\u0432\u0435 \u043d\u0435\u0434\u0435\u043b\u0438 \u043e\u0441\u0432\u043e\u0438\u043b
    \u0435\u0435. \u0412 1632 \u0433\u043e\u0434\u0443 \u0423\u043e\u043b\u043b\u0438\u0441
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u042d\u043c\u043c\u0430\u043d\u0443\u0438\u043b \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u041e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u0432 1637 \u0433\u043e\u0434\u0443 \u0438 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u2014 \u0432 1640-\u043c. \u0412 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0438\u0437\u0443\u0447\u0430\u043b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443
    \u0438, \u043f\u0440\u043e\u044f\u0432\u0438\u0432 \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u044c,
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u043d\u043e\u0432\u0443\u044e \u043d\u0430 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442
    \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u0440\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0413\u0430\u0440\u0432\u0435\u044f. \u041f\u043e\u0441\u043b\u0435
    \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u043e\u043d \u043f\u0440\u0438\u043d\u044f\u043b \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0439
    \u0441\u0430\u043d \u0438 \u0441\u0442\u0430\u043b \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u0430\u043d\u0433\u043b\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438.\n\n\U0001F4C8
    \u041f\u0443\u0442\u044c \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u0433\u043e\u0434\u044b \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438 (1640\u20131649)
    \u0412 1645 \u0433\u043e\u0434\u0443 \u0423\u043e\u043b\u043b\u0438\u0441 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0421\u044e\u0437\u0430\u043d\u043d\u0435 \u0413\u043b\u0430\u0439\u0434,
    \u0447\u0442\u043e \u0432\u044b\u043d\u0443\u0434\u0438\u043b\u043e \u0435\u0433\u043e \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436, \u0442\u0430\u043a \u043a\u0430\u043a
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0438 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u043b\u0438 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c
    \u043e\u0431\u0435\u0442 \u0431\u0435\u0437\u0431\u0440\u0430\u0447\u0438\u044f. \u0412
    \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u043f\u0440\u0438\u043d\u044f\u043b\u0430 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0439
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442. \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0410\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0439 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0423\u043e\u043b\u043b\u0438\u0441, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0432\u0448\u0438\u0439
    \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432, \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u043a\u0430\u043a \u0438\u0441\u043a\u0443\u0441\u043d\u044b\u0439 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444,
    \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u044b\u0432\u0430\u044f \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043d\u043d\u044b\u0435
    \u043f\u0438\u0441\u044c\u043c\u0430 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u0432
    \u043a\u043e\u0440\u043e\u043b\u044f. \u042d\u0442\u043e\u0442 \u0442\u0430\u043b\u0430\u043d\u0442
    \u043f\u0440\u0438\u043d\u0435\u0441 \u0435\u043c\u0443 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e.
    \u0415\u0433\u043e \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0440\u0430\u0437\u0433\u043e\u0440\u0435\u043b\u0441\u044f
    \u0432 1647 \u0433\u043e\u0434\u0443 \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0435,
    \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0447\u0442\u0435\u043d\u0438\u044f \u0442\u0440\u0443\u0434\u0430
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u041e\u0442\u0440\u0435\u0434\u0430 \u00ab\u041a\u043b\u044e\u0447\u0438
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb (Clavis Mathematicae).
    \u041e\u043d \u0431\u044b\u0441\u0442\u0440\u043e \u043e\u0441\u0432\u043e\u0438\u043b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0438 \u043d\u0430\u0447\u0430\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u044f\u043c\u0438,
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b \u043f\u0440\u043e\u0442\u0438\u0432
    \u043a\u0430\u0437\u043d\u0438 \u043a\u043e\u0440\u043e\u043b\u044f \u041a\u0430\u0440\u043b\u0430
    I. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0435\u0433\u043e \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044f
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u044b\u0441\u043e\u043a\u0430, \u0447\u0442\u043e \u0432 1649 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0421\u0430\u0432\u0438\u043b\u044c\u0441\u043a\u0438\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0432 \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0441\u043c\u0435\u043d\u0438\u0432 \u0438\u0437\u0433\u043d\u0430\u043d\u043d\u043e\u0433\u043e
    \u0440\u043e\u044f\u043b\u0438\u0441\u0442\u0430. \u041e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u044d\u0442\u0443 \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0434\u043e \u0441\u0430\u043c\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0432 1703 \u0433\u043e\u0434\u0443.\n\n\U0001F52C
    \u0420\u0430\u0441\u0446\u0432\u0435\u0442 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    (1650\u20131703) \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u0441\u0430\u043c\u044b\u043c \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c
    \u0432 \u0436\u0438\u0437\u043d\u0438 \u0423\u043e\u043b\u043b\u0438\u0441\u0430. \u0412
    1655 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u2014 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e\u00bb
    (Arithmetica Infinitorum). \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u043c \u0448\u0430\u0433\u043e\u043c \u0432
    \u043f\u0440\u0435\u0434\u044b\u0441\u0442\u043e\u0440\u0438\u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u0412 \u043d\u0435\u0439
    \u0423\u043e\u043b\u043b\u0438\u0441: \u0412\u0432\u0435\u043b \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0441\u0438\u043c\u0432\u043e\u043b \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    (\u221e), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440. \u0421\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0440\u0430\u0437\u0432\u0438\u043b \u00ab\u043c\u0435\u0442\u043e\u0434 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445\u00bb
    \u041a\u0430\u0432\u0430\u043b\u044c\u0435\u0440\u0438, \u043f\u0440\u0438\u0434\u0430\u0432
    \u0435\u043c\u0443 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443. \u041d\u0430\u0448\u0435\u043b \u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u043f\u043e\u0434 \u043a\u0440\u0438\u0432\u044b\u043c\u0438, \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0432,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b
    \u0434\u043b\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \\( y = x^m \\), \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0434\u043b\u044f
    \u0434\u0440\u043e\u0431\u043d\u044b\u0445 \u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439. \u0412\u044b\u0432\u0435\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0434\u043b\u044f
    \u0447\u0438\u0441\u043b\u0430 \\( \\pi \\), \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435
    \u043a\u0430\u043a \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u0423\u043e\u043b\u043b\u0438\u0441\u0430.
    \u0412 1657 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430 \u0435\u0433\u043e \u00ab\u0412\u0441\u0435\u043e\u0431\u0449\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb (Mathesis Universalis)
    \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0412 1659 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u0445\u00bb, \u0433\u0434\u0435 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u044d\u0442\u0438 \u043a\u0440\u0438\u0432\u044b\u0435
    \u043d\u0435 \u0447\u0435\u0440\u0435\u0437 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0432 \u043a\u043e\u043d\u0443\u0441\u0435,
    \u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432\u0442\u043e\u0440\u043e\u0433\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430. \u0412 1685 \u0433\u043e\u0434\u0443 \u0423\u043e\u043b\u043b\u0438\u0441
    \u0438\u0437\u0434\u0430\u043b \u043e\u0431\u0448\u0438\u0440\u043d\u044b\u0439 \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435\u00bb. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0435\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439: \u0411\u044b\u043b\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u0442\u0435\u043e\u0440\u0438\u044f \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432,
    \u0433\u0434\u0435 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0431\u044b\u043b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d \u043a\u0430\u043a
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f, \u043e\u0431\u0440\u0430\u0442\u043d\u0430\u044f
    \u0432\u043e\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044e \u0432 \u0441\u0442\u0435\u043f\u0435\u043d\u044c.
    \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0438
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0438 \u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0412\u0432\u0435\u0434\u0435\u043d\u044b \u0432
    \u043e\u0431\u0438\u0445\u043e\u0434 \u0442\u0430\u043a\u0438\u0435 \u0442\u0435\u0440\u043c\u0438\u043d\u044b,
    \u043a\u0430\u043a \u00ab\u043c\u0430\u043d\u0442\u0438\u0441\u0441\u0430\u00bb \u0438 \u00ab\u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430\u044f
    \u0434\u0440\u043e\u0431\u044c\u00bb.\n\n\U0001F3DB\ufe0f \u041e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0438 \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u044c
    \u0442\u0430\u043b\u0430\u043d\u0442\u0430 \u0423\u043e\u043b\u043b\u0438\u0441 \u0431\u044b\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0438 \u043f\u0435\u0440\u0432\u044b\u0445 \u0447\u043b\u0435\u043d\u043e\u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    (1662). \u041f\u043e\u0441\u043b\u0435 \u0420\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438
    \u043c\u043e\u043d\u0430\u0440\u0445\u0438\u0438 \u043e\u043d \u0441\u0443\u043c\u0435\u043b
    \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u0442\u044c \u0434\u043e\u0432\u0435\u0440\u0438\u0435
    \u043a\u043e\u0440\u043e\u043b\u044f \u041a\u0430\u0440\u043b\u0430 II, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u0430\u0436\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0435\u0433\u043e
    \u0441\u0432\u043e\u0438\u043c \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u043c
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u043c. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0423\u043e\u043b\u043b\u0438\u0441\u0430 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439. \u041e\u043d: \u0420\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438
    \u0438 \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443 \u043e\u0431
    \u0443\u043f\u0440\u0443\u0433\u043e\u043c \u0441\u043e\u0443\u0434\u0430\u0440\u0435\u043d\u0438\u0438
    \u0442\u0435\u043b. \u0417\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u043e\u0439,
    \u043d\u0430\u043f\u0438\u0441\u0430\u0432 \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u043f\u043e
    \u0433\u0440\u0430\u043c\u043c\u0430\u0442\u0438\u043a\u0435 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430. \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0433\u043b\u0443\u0445\u043e\u043d\u0435\u043c\u044b\u0445
    \u0440\u0435\u0447\u0438. \u041f\u0438\u0441\u0430\u043b \u0442\u0440\u0443\u0434\u044b
    \u043f\u043e \u043b\u043e\u0433\u0438\u043a\u0435 \u0438 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u044e.
    \u0423\u043e\u043b\u043b\u0438\u0441 \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0438\u043c \u0441\u043b\u043e\u0436\u043d\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c
    \u0438 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u043c\u0438
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438 \u0441\u043f\u043e\u0440\u0430\u043c\u0438,
    \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0441 \u0422\u043e\u043c\u0430\u0441\u043e\u043c
    \u0413\u043e\u0431\u0431\u0441\u043e\u043c \u0438 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u043c
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u043e\u043c. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e
    \u0418\u0441\u0430\u0430\u043a\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043f\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e, \u0438\u0437\u0443\u0447\u0430\u043b
    \u0442\u0440\u0443\u0434\u044b \u0423\u043e\u043b\u043b\u0438\u0441\u0430 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u043a
    \u0423\u043e\u043b\u043b\u0438\u0441\u0443 \u041d\u044c\u044e\u0442\u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438
    \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e. \u0414\u0436\u043e\u043d \u0423\u043e\u043b\u043b\u0438\u0441
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0435
    28 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1703 \u0433\u043e\u0434\u0430 \u0438 \u0431\u044b\u043b
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u0432 \u0446\u0435\u0440\u043a\u0432\u0438
    \u0421\u0432\u044f\u0442\u043e\u0439 \u041c\u0430\u0440\u0438\u0438."
  shortBioEn: 
  interestingFactsRu: "\u041b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0414\u0436\u043e\u043d\u0430 \u0423\u043e\u043b\u043b\u0438\u0441\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432
    \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0435\u0439.
