  shortBioEn: 
  interestingFactsRu: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u042D\u043D\u0434\u0440\u044E
    \u0423\u0430\u0439\u043B\u0441\u0430 \u2014 \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0445\u0440\u043E\u043D\u0438\u043A\u0430 \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E
    \u043F\u043E\u0434\u0432\u0438\u0433\u0430. \u042D\u0442\u043E \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0439
    \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0440\u043E\u043C\u0430\u043D,
    \u0442\u0440\u0438\u043B\u043B\u0435\u0440 \u0438 \u0442\u0440\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0434\u0440\u0430\u043C\u0430 \u0432 \u043E\u0434\u043D\u043E\u043C \u0444\u043B\u0430\u043A\u043E\u043D\u0435,
    \u0433\u0434\u0435 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0433\u0435\u0440\u043E\u0439
    \u043F\u043E\u0447\u0442\u0438 \u0441\u0435\u043C\u044C \u043B\u0435\u0442 \u0432\u0435\u0434\u0435\u0442
    \u0442\u0430\u0439\u043D\u0443\u044E \u0432\u043E\u0439\u043D\u0443 \u0441 \u0437\u0430\u0434\u0430\u0447\u0435\u0439
    \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0430\u043B\u0435\u043A\u043E\u0433\u043E
    \u0434\u0435\u0442\u0441\u0442\u0432\u0430.  ### \U0001F4D6 \u0417\u0430\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0441\u0442\u0438  \u0412\u0441\u0451
    \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C \u043D\u0435 \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043A\u043E\u0439
    \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438, \u0430 \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439
    \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435, \u043A\u0443\u0434\u0430
    10-\u043B\u0435\u0442\u043D\u0438\u0439 \u042D\u043D\u0434\u0440\u044E \u0437\u0430\u0448\u0435\u043B
    \u043F\u043E \u043F\u0443\u0442\u0438 \u0438\u0437 \u0448\u043A\u043E\u043B\u044B.
    \u0412 \u043A\u043D\u0438\u0433\u0435 \u042D\u0440\u0438\u043A\u0430 \u0422\u0435\u043C\u043F\u043B\u0430
    \u0411\u0435\u043B\u043B\u0430 \xAB\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\xBB \u043E\u043D \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B
    \u043E \u0442\u0435\u043E\u0440\u0435\u043C\u0435, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u0437\u0430 300 \u043B\u0435\u0442 \u043D\u0435 \u0441\u043C\u043E\u0433 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u043D\u0438\u043A\u0442\u043E \u0438\u0437 \u0432\u0435\u043B\u0438\u043A\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432. \u0423\u0430\u0439\u043B\u0441
    \u043F\u043E\u0437\u0436\u0435 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B:
    \xAB\u041E\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u0439,
    \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u044F, \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u043D\u0438\u0439,
    \u043C\u043E\u0433 \u0435\u0451 \u043F\u043E\u043D\u044F\u0442\u044C. \u0418
    \u044F \u0437\u043D\u0430\u043B \u0441 \u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430,
    \u0447\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0435\u0451 \u043D\u0435
    \u043E\u0442\u043F\u0443\u0449\u0443\xBB. \u041E\u043D \u0440\u0435\u0448\u0438\u043B
    \u0441\u0442\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u043C, \u043A\u0442\u043E
    \u043F\u043E\u043A\u043E\u0440\u0438\u0442 \u044D\u0442\u0443 \u0432\u0435\u0440\u0448\u0438\u043D\u0443,
    \u0438 \u044D\u0442\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u043E
    \u0432\u0441\u044E \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u044C.  ### \U0001F92B
    \u0421\u0435\u043A\u0440\u0435\u0442\u043D\u0430\u044F \u043C\u0438\u0441\u0441\u0438\u044F:
    7 \u043B\u0435\u0442 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435 
    \u041F\u0440\u043E\u0448\u043B\u0438 \u0433\u043E\u0434\u044B. \u0423\u0430\u0439\u043B\u0441
    \u0441\u0442\u0430\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0430, \u043D\u043E \u043E \u0434\u0435\u0442\u0441\u043A\u043E\u0439
    \u043C\u0435\u0447\u0442\u0435 \u043D\u0435 \u0437\u0430\u0431\u044B\u043B. \u0412
    1986 \u0433\u043E\u0434\u0443 \u043E\u043D \u0443\u0437\u043D\u0430\u043B, \u0447\u0442\u043E
    \u0434\u0440\u0443\u0433\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A,
    \u041A\u0435\u043D \u0420\u0438\u0431\u0435\u0442, \u0434\u043E\u043A\u0430\u0437\u0430\u043B
    \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u0412\u0435\u043B\u0438\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0435\u043C\u043E\u0439 \u0424\u0435\u0440\u043C\u0430
    \u0438 \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u043E\u0439 \u0422\u0430\u043D\u0438\u044F\u043C\u044B\u2013\u0428\u0438\u043C\u0443\u0440\u044B.
    \u042D\u0442\u043E \u0431\u044B\u043B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0448\u0430\u043D\u0441 \u2014 \u044D\u0442\u043E \u0431\u044B\u043B \u043F\u0443\u0442\u044C,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u0438\u0441\u043A\u0430\u043B
    \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C. \xAB\u042F \u0431\u044B\u043B
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0437\u043E\u0432\u0430\u043D, \u2014
    \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B \u0423\u0430\u0439\u043B\u0441.
    \u2014 \u042F \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0445\u043E\u0434
    \u043C\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F\xBB. 
    \u0421 \u044D\u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430
    \u043E\u043D \u043D\u0430\u0447\u0430\u043B \u0441\u0430\u043C\u0443\u044E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u0443\u044E
    \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443. \u0423\u0430\u0439\u043B\u0441
    \u043F\u0440\u0438\u043D\u044F\u043B \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 **\u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0439
    \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0441\u0442\u0438**: *   **\u041C\u043E\u0442\u0438\u0432\u044B**:
    \u0432\u043E-\u043F\u0435\u0440\u0432\u044B\u0445, \u043B\u044E\u0431\u043E\u0435
    \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u043E \u0442\u0435\u043E\u0440\u0435\u043C\u0435
    \u0424\u0435\u0440\u043C\u0430 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442
    \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
    \u0438 \u043C\u0435\u0448\u0430\u0435\u0442 \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0442\u044C\u0441\u044F.
    \u0412\u043E-\u0432\u0442\u043E\u0440\u044B\u0445 (\u0438 \u044D\u0442\u043E
    \u0431\u043E\u043B\u0435\u0435 \u043F\u0438\u043A\u0430\u043D\u0442\u043D\u0430\u044F
    \u0434\u0435\u0442\u0430\u043B\u044C), \u043E\u043D \u0431\u043E\u044F\u043B\u0441\u044F,
    \u0447\u0442\u043E, \u0435\u0441\u043B\u0438 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
    \u043E \u0435\u0433\u043E \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u044B\u0445
    \u0443\u0441\u043F\u0435\u0445\u0430\u0445 \u043F\u0440\u043E\u0441\u043E\u0447\u0430\u0442\u0441\u044F
    \u043D\u0430\u0440\u0443\u0436\u0443, \u043A\u0442\u043E-\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0439
    \u0441\u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0435\u0433\u043E \u043D\u0430\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u0438
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043F\u0435\u0440\u0432\u044B\u043C, \u043B\u0438\u0448\u0438\u0432 \u0435\u0433\u043E
    \u0441\u043B\u0430\u0432\u044B. *   **\u041A\u043E\u043D\u0441\u043F\u0438\u0440\u0430\u0446\u0438\u044F**:
    \u041E \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0435 \u0437\u043D\u0430\u043B\u0430
    \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0433\u043E \u0436\u0435\u043D\u0430
    \u041D\u0430\u0434\u0430 (\u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u043D
    \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0441\u044F \u0432 \u044D\u0442\u043E\u043C
    \u0432 \u043C\u0435\u0434\u043E\u0432\u044B\u0439 \u043C\u0435\u0441\u044F\u0446!)
    \u0438, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u0434\u0438\u043D-\u0434\u0432\u0430
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0430\u0441\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
    \u0438\u0434\u0435\u0439.  ### \U0001F3AD \u0414\u0440\u0430\u043C\u0430 \u0432
    \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435 \u0438 \xAB\u041F\u0440\u043E\u0431\u0435\u043B
    \u0432 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435\xBB 
    \u041A\u0443\u043B\u044C\u043C\u0438\u043D\u0430\u0446\u0438\u0435\u0439 \u043C\u043D\u043E\u0433\u043E\u043B\u0435\u0442\u043D\u0435\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B \u0441\u0442\u0430\u043B\u043E 23 \u0438\u044E\u043D\u044F
    1993 \u0433\u043E\u0434\u0430. \u041D\u0430 \u043A\u043E\u043D\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0438
    \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435 \u0423\u0430\u0439\u043B\u0441
    \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B \u0442\u0440\u0438 \u043B\u0435\u043A\u0446\u0438\u0438
    \u0441 \u0431\u0435\u0437\u043E\u0431\u0438\u0434\u043D\u044B\u043C \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C
    \xAB\u041C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u044B\u0435 \u0444\u043E\u0440\u043C\u044B,
    \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u0440\u0438\u0432\u044B\u0435 \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0413\u0430\u043B\u0443\u0430\xBB. \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    \u043D\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u043E \u043D\u0438
    \u0441\u043B\u043E\u0432\u0430 \u043E \u0424\u0435\u0440\u043C\u0430, \u0438
    \u043B\u0438\u0448\u044C \u0432 \u043A\u043E\u043D\u0446\u0435 \u0442\u0440\u0435\u0442\u044C\u0435\u0439
    \u043B\u0435\u043A\u0446\u0438\u0438 \u043E\u043D \u043A\u0430\u043A \u0431\u044B
    \u043D\u0435\u0432\u0437\u043D\u0430\u0447\u0430\u0439 \u043E\u0431\u044A\u044F\u0432\u0438\u043B,
    \u0447\u0442\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u043B \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0443
    \u0422\u0430\u043D\u0438\u044F\u043C\u044B\u2013\u0428\u0438\u043C\u0443\u0440\u044B,
    \u0430 \u0437\u043D\u0430\u0447\u0438\u0442, \u0438 \u0412\u0435\u043B\u0438\u043A\u0443\u044E
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u0424\u0435\u0440\u043C\u0430. \u0417\u0430\u043B
    \u0430\u043F\u043B\u043E\u0434\u0438\u0440\u043E\u0432\u0430\u043B \u0441\u0442\u043E\u044F,
    \u043D\u043E\u0432\u043E\u0441\u0442\u044C \u043E\u0431\u043B\u0435\u0442\u0435\u043B\u0430
    \u043C\u0438\u0440.  \u041D\u043E \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
    \u0434\u0440\u0430\u043C\u0430. \u041F\u0440\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0435
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0431\u044B\u043B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D \u043F\u0440\u043E\u0431\u0435\u043B
    \u2014 \u043E\u0448\u0438\u0431\u043A\u0430 \u0432 \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u043C
    \u0440\u0430\u0437\u0434\u0435\u043B\u0435. \u0411\u043E\u043B\u0435\u0435 \u0433\u043E\u0434\u0430
    \u0423\u0430\u0439\u043B\u0441 \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C
    \u0435\u0451, \u0438 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u043D
    \u043D\u0430\u0437\u044B\u0432\u0430\u043B \u0441\u0430\u043C\u044B\u043C \u0442\u044F\u0436\u0435\u043B\u044B\u043C
    \u0432 \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438.  \u0412
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 **\u0430\u0436\u0438\u043E\u0442\u0430\u0436
    \u0438 \u0446\u0438\u0440\u043A\u0443\u043B\u044F\u0446\u0438\u044F \u0441\u043B\u0443\u0445\u043E\u0432**:
    *   \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u043B\u0438\u0441\u044C
    \u043F\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439
    \u043F\u043E\u0447\u0442\u0435 \u0434\u043E\u0433\u0430\u0434\u043A\u0430\u043C\u0438
    \u043E \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    \u2014 \u0431\u044B\u043B\u0430 \u043B\u0438 \u044D\u0442\u043E \xAB\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
    \u0442\u0440\u0435\u0449\u0438\u043D\u0430 \u0438\u043B\u0438 \u0431\u0435\u0437\u0434\u043D\u0430\xBB.
    *   \u0414\u0440\u0443\u0433 \u0423\u0430\u0439\u043B\u0441\u0430, \u041F\u0438\u0442\u0435\u0440
    \u0421\u0430\u0440\u043D\u0430\u043A, \u043E\u043F\u0438\u0441\u0430\u043B \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E
    \u043E\u0431\u0440\u0430\u0437\u043D\u043E: \xAB\u0411\u0443\u0434\u0442\u043E
    \u0423\u0430\u0439\u043B\u0441 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
    \u0440\u0430\u0441\u0441\u0442\u0435\u043B\u0438\u0442\u044C \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
    \u043A\u043E\u0432\u0435\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043A\u043E\u043C\u043D\u0430\u0442\u044B. \u0421\u0442\u043E\u0438\u0442 \u0440\u0430\u0437\u0433\u043B\u0430\u0434\u0438\u0442\u044C
    \u043E\u0434\u0438\u043D \u0443\u0433\u043E\u043B, \u043A\u0430\u043A \u0432
    \u0434\u0440\u0443\u0433\u043E\u043C \u0442\u0443\u0442 \u0436\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0441\u043A\u043B\u0430\u0434\u043A\u0438\xBB. *   \u0421\u0430\u043C \u0423\u0430\u0439\u043B\u0441,
    \u0434\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u044B\u0439 \u0434\u043E \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F,
    \u0432 \u0434\u0435\u043A\u0430\u0431\u0440\u0435 1993 \u0433\u043E\u0434\u0430
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0435
    \u043F\u0438\u0441\u044C\u043C\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C
    \u0441\u043B\u0443\u0445\u0438, \u043F\u0440\u0438\u0437\u043D\u0430\u0432, \u0447\u0442\u043E
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \xAB\u043D\u0435\u043F\u043E\u043B\u043D\u043E\xBB
    \u0438 \u043E\u043D \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E
    \xAB\u0432\u043E\u0441\u043F\u043E\u043B\u043D\u0438\u0442 \u043F\u0440\u043E\u0431\u0435\u043B
    \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F\xBB. 
    ### \U0001F4A1 \u041E\u0437\u0430\u0440\u0435\u043D\u0438\u0435 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 
    \u041F\u0440\u043E\u0440\u044B\u0432 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u043B
    19 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F 1994 \u0433\u043E\u0434\u0430.
    \u0423\u0430\u0439\u043B\u0441, \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438
    \u0441\u0434\u0430\u0432\u0448\u0438\u0439\u0441\u044F, \u043F\u0438\u0441\u0430\u043B
    \u0432 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0438 \u043A
    \u0441\u0432\u043E\u0435\u0439 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0442\u0430\u0442\u044C\u0435: \xAB\u042F \u0440\u0435\u0448\u0438\u043B
    \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0432\u0437\u0433\u043B\u044F\u0434 \u043D\u0430 \u044D\u0439\u043B\u0435\u0440\u043E\u0432\u044B
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0432 \u043F\u043E\u043F\u044B\u0442\u043A\u0435
    \u0440\u0435\u0430\u043D\u0438\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u044D\u0442\u043E\u0442 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\xBB.
    \u0418 \u044D\u0442\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E.
    \u041E\u043D \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u043F\u043E\u043D\u044F\u043B,
    \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0442\u0435\u043E\u0440\u0438\u044E \u0418\u0432\u0430\u0441\u0430\u0432\u044B,
    \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0430\u0447\u0438\u043D\u0430\u043B
    \u0441\u0432\u043E\u044E \u043A\u0430\u0440\u044C\u0435\u0440\u0443, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0431\u043E\u0439\u0442\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043D\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E, \u0430 \u043D\u0435 \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F
    \u0435\u0433\u043E \xAB\u0437\u0430\u043A\u043B\u0435\u0438\u0442\u044C\xBB. 
    \u041E\u0441\u043E\u0437\u043D\u0430\u0432 \u044D\u0442\u043E, \u043E\u043D \u043F\u0440\u0438\u0432\u043B\u0435\u043A
    \u043A \u0440\u0430\u0431\u043E\u0442\u0435 \u0441\u0432\u043E\u0435\u0433\u043E
    \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0443\u0447\u0435\u043D\u0438\u043A\u0430
    **\u0420\u0438\u0447\u0430\u0440\u0434\u0430 \u0422\u0435\u0439\u043B\u043E\u0440\u0430**,
    \u0447\u0442\u043E\u0431\u044B \u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.
    \u0412 \u043E\u043A\u0442\u044F\u0431\u0440\u0435 1994 \u0433\u043E\u0434\u0430
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0431\u044B\u043B\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430,
    \u0430 \u0432 \u043C\u0430\u0435 1995 \u0433\u043E\u0434\u0430 \u2014 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u0430.
    \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0442\u0430\u0442\u044C\u044F
    \u0432 *Annals of Mathematics* \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u0430
    \u0435\u0433\u043E \u0436\u0435\u043D\u0435 \u041D\u0430\u0434\u0435 \u0438 \u0442\u0440\u0435\u043C
    \u0434\u043E\u0447\u0435\u0440\u044F\u043C: \u041A\u043B\u044D\u0440, \u041A\u0435\u0439\u0442
    \u0438 \u041E\u043B\u0438\u0432\u0438\u0438.  ### \U0001F3C6 \u041B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u044B\u0435
    \u043C\u043E\u043C\u0435\u043D\u0442\u044B  *   **\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435
    \u043F\u043E \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0443**: \u0417\u0430
    \u0441\u0432\u043E\u0451 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0423\u0430\u0439\u043B\u0441 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u043C\u0435\u0434\u0430\u043B\u044C \u0424\u0438\u043B\u0434\u0441\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \xAB\u041D\u043E\u0431\u0435\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u043F\u0440\u0435\u043C\u0438\u0435\u0439 \u0434\u043B\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432\xBB.
    \u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u2014 \u043E\u043D\u0430 \u0432\u0440\u0443\u0447\u0430\u0435\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0447\u0435\u043D\u044B\u043C \u0434\u043E
    40 \u043B\u0435\u0442, \u0430 \u043D\u0430 \u043C\u043E\u043C\u0435\u043D\u0442
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0423\u0430\u0439\u043B\u0441\u0443 \u0431\u044B\u043B 41 \u0433\u043E\u0434.
    \u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0443\u0442\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043F\u0440\u0438\u0437\u0430 \u0432 1998 \u0433\u043E\u0434\u0443 \u0435\u043C\u0443
    \u0432\u0440\u0443\u0447\u0438\u043B\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E
    \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443.
    *   **\u041F\u0440\u0438\u0437 \u0438 \u0438\u043D\u0444\u043B\u044F\u0446\u0438\u044F**:
    \u0412 1997 \u0433\u043E\u0434\u0443 \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u043F\u0440\u0435\u043C\u0438\u044E \u0412\u043E\u043B\u044C\u0444\u0441\u043A\u0435\u043B\u044F,
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u043D\u0443\u044E \u0432 XIX
    \u0432\u0435\u043A\u0435. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F
    \u0441\u0443\u043C\u043C\u0430 \u043E\u0431\u0435\u0441\u0446\u0435\u043D\u0438\u043B\u0430\u0441\u044C
    \u0438\u0437-\u0437\u0430 \u0433\u0438\u043F\u0435\u0440\u0438\u043D\u0444\u043B\u044F\u0446\u0438\u0438,
    \u0438 \u0423\u0430\u0439\u043B\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0432\u0441\u0435\u0433\u043E \u043E\u043A\u043E\u043B\u043E $50,000 \u0432\u043C\u0435\u0441\u0442\u043E
    \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0433\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0437\u0430\u0432\u0435\u0449\u0430\u043B
    \u0435\u0435 \u0443\u0447\u0440\u0435\u0434\u0438\u0442\u0435\u043B\u044C. *  
    **\xAB\u0422\u0440\u0438 \u0411\xBB**: \u0423\u0430\u0439\u043B\u0441 \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u043B\u0441\u044F,
    \u0447\u0442\u043E \u0441\u0430\u043C\u044B\u0435 \u043B\u0443\u0447\u0448\u0438\u0435
    \u0438\u0434\u0435\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0438
    \u043A \u043D\u0435\u043C\u0443 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0442\u0434\u044B\u0445\u0430,
    \u0438 \u043E\u043D \u0441 \u044E\u043C\u043E\u0440\u043E\u043C \u043D\u0430\u0437\u044B\u0432\u0430\u043B
    \u044D\u0442\u043E \u043C\u0435\u0442\u043E\u0434\u043E\u043C \xAB\u0422\u0440\u0435\u0445
    \u0411\xBB: **Bus** (\u0430\u0432\u0442\u043E\u0431\u0443\u0441), **Bath** (\u0432\u0430\u043D\u043D\u0430)
    \u0438 **Bed** (\u043A\u0440\u043E\u0432\u0430\u0442\u044C), \u043A\u043E\u0433\u0434\u0430
    \u0435\u0433\u043E \u043F\u043E\u0434\u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435
    \u043C\u043E\u0433\u043B\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E. *   **\u041D\u0435\u043F\u043E\u043D\u044F\u0442\u044B\u0439
    \u0433\u0435\u043D\u0438\u0439**: \u0423\u0430\u0439\u043B\u0441, \u0443\u0436\u0435
    \u0431\u0443\u0434\u0443\u0447\u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u0435\u043C
    \u0410\u0431\u0435\u043B\u0435\u0432\u0441\u043A\u043E\u0439 \u043F\u0440\u0435\u043C\u0438\u0438,
    \u0447\u0435\u0441\u0442\u043D\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0441\u044F
    \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043B\u0435\u043A\u0446\u0438\u0439,
    \u0447\u0442\u043E \u0432 \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u0442\u0432\u0435
    \u043E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0441\u0435\u0431\u044F
    \u0441\u043B\u0430\u0431\u0435\u0435 \u0432 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0440\u0430\u0437\u0434\u0435\u043B\u0430\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0438 \xAB\u0441\u0431\u0435\u0433\u0430\u043B \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0443,
    \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0447\u0438\u0442\u0430\u0442\u044C
    \u043F\u0440\u043E \u0424\u0435\u0440\u043C\u0430\xBB, \u043D\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
    \u0431\u044B\u043B\u0430 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0424\u0435\u0440\u043C\u0430
    \xAB\u0438\u043C\u0435\u043B \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u044E\u0449\u0443\u044E
    \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0443 \u043F\u0438\u0441\u0430\u0442\u044C
    \u043D\u0430 \u043B\u0430\u0442\u044B\u043D\u0438\xBB, \u0430 \u0437\u043D\u0430\u043D\u0438\u0435
    \u0423\u0430\u0439\u043B\u0441\u043E\u043C \u043B\u0430\u0442\u044B\u043D\u0438
    \u0431\u044B\u043B\u043E \xAB\u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C\xBB.
    *   **\u0414\u0435\u0442\u0441\u043A\u0430\u044F \u043C\u0435\u0447\u0442\u0430**:
    \u0421\u0430\u043C\u044B\u043C \u0442\u0440\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0442\u043E, \u0447\u0442\u043E, \u043F\u043E \u0441\u043B\u043E\u0432\u0430\u043C
    \u0423\u0430\u0439\u043B\u0441\u0430, \u0433\u043B\u0430\u0432\u043D\u0430\u044F
    \u043D\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0443
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u0434\u0435\u043D\u044C\u0433\u0438 \u0438\u043B\u0438
    \u043F\u0440\u0435\u043C\u0438\u0438, \u0430 \xAB\u0440\u0435\u0434\u043A\u0430\u044F
    \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0433\u0438\u044F \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C
    \u0432\u043E \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
    \u0441\u0432\u043E\u044E \u0434\u0435\u0442\u0441\u043A\u0443\u044E \u043C\u0435\u0447\u0442\u0443\xBB."
