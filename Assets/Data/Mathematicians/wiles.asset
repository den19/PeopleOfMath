    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432 \u0438\u0442\u043E\u0433\u0435 \u0441\u043B\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0435\u0434\u0438\u043D\u043E\u043C \u0442\u0440\u0438\u0443\u043C\u0444\u0435. 
    ### \U0001F4DC \u0420\u0430\u043D\u043D\u0438\u0435 \u0442\u0440\u0443\u0434\u044B:
    \u0424\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442 \u0434\u043B\u044F \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F  \u0414\u043E \u0442\u043E\u0433\u043E
    \u043A\u0430\u043A \u0423\u0430\u0439\u043B\u0441 \u043F\u043E\u0441\u0432\u044F\u0442\u0438\u043B
    \u0441\u0435\u0431\u044F \u0442\u0435\u043E\u0440\u0435\u043C\u0435 \u0424\u0435\u0440\u043C\u0430,
    \u043E\u043D \u0443\u0436\u0435 \u0431\u044B\u043B \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043D\u044B\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C, \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0432\u0448\u0438\u043C
    \u0432\u0430\u0436\u043D\u044B\u0435 \u043F\u0440\u043E\u0440\u044B\u0432\u044B
    \u0432 \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B. \u042D\u0442\u0438
    \u0440\u0430\u043D\u043D\u0438\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u0441\u0442\u0430\u043B\u0438 \u0442\u043E\u0439 \u0431\u0430\u0437\u043E\u0439,
    \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u0437\u0436\u0435
    \u0441\u0442\u0440\u043E\u0438\u043B\u043E\u0441\u044C \u0435\u0433\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E. 
    *   **\u0413\u0438\u043F\u043E\u0442\u0435\u0437\u0430 \u0411\u0451\u0440\u0447\u0430
    \u2014 \u0421\u0443\u0438\u043D\u043D\u0435\u0440\u0442\u043E\u043D\u0430-\u0414\u0430\u0439\u0435\u0440\u0430:**
    \u0412 \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u0438 \u0440\u0430\u043D\u043D\u0438\u0445
    \u0440\u0430\u0431\u043E\u0442\u0430\u0445, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0445
    \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u0414\u0436\u043E\u043D\u0430 \u041A\u043E\u0443\u0442\u0441\u0430, \u0423\u0430\u0439\u043B\u0441
    \u0434\u043E\u043A\u0430\u0437\u0430\u043B \u043E\u0434\u043D\u0443 \u0438\u0437
    \u0447\u0430\u0441\u0442\u043D\u044B\u0445 \u0444\u043E\u0440\u043C \u044D\u0442\u043E\u0439
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0439 \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B
    \u0434\u043B\u044F \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043A\u0440\u0438\u0432\u044B\u0445 \u0441 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043D\u044B\u043C
    \u0443\u043C\u043D\u043E\u0436\u0435\u043D\u0438\u0435\u043C. \u042D\u0442\u0430
    \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0445
    \u0432 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B \u0438 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043A\u0440\u0438\u0432\u044B\u0445 \u0441 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C
    \u0438\u0445 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    L-\u0444\u0443\u043D\u043A\u0446\u0438\u0439. *   **\u0413\u043B\u0430\u0432\u043D\u0430\u044F
    \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0430 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0418\u0432\u0430\u0441\u0430\u0432\u044B:** \u0412 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u0441 \u0411\u0430\u0440\u0440\u0438 \u041C\u0430\u0437\u0443\u0440\u043E\u043C
    \u0423\u0430\u0439\u043B\u0441 \u0434\u043E\u043A\u0430\u0437\u0430\u043B \"\u0433\u043B\u0430\u0432\u043D\u0443\u044E
    \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0443\" \u0442\u0435\u043E\u0440\u0438\u0438
    \u0418\u0432\u0430\u0441\u0430\u0432\u044B \u0434\u043B\u044F \u0446\u0438\u043A\u043B\u043E\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0439 \u043F\u043E\u043B\u044F
    \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445 \u0447\u0438\u0441\u0435\u043B.
    \u042D\u0442\u043E \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435,
    \u043D\u0430\u0437\u0432\u0430\u043D\u043D\u043E\u0435 \"\u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0445 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B \u043D\u0430\u0448\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438\" , \u0440\u0435\u0448\u0438\u043B\u043E
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C, \u0432\u043E\u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0445
    \u043A \u0440\u0430\u0431\u043E\u0442\u0430\u043C \u041A\u0443\u043C\u043C\u0435\u0440\u0430.
    \u041F\u043E\u0437\u0436\u0435 \u0423\u0430\u0439\u043B\u0441 \u043E\u0431\u043E\u0431\u0449\u0438\u043B
    \u044D\u0442\u043E\u0442 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439 \u043B\u044E\u0431\u044B\u0445
    \u0442\u043E\u0442\u0430\u043B\u044C\u043D\u043E \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043F\u043E\u043B\u0435\u0439.  ### \U0001F9E9 \u0413\u043B\u0430\u0432\u043D\u044B\u0439
    \u0432\u043A\u043B\u0430\u0434: \u0414\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u0442\u0435\u043E\u0440\u0435\u043C\u044B
    \u0424\u0435\u0440\u043C\u0430  \u041A\u0443\u043B\u044C\u043C\u0438\u043D\u0430\u0446\u0438\u0435\u0439
    \u043A\u0430\u0440\u044C\u0435\u0440\u044B \u0423\u0430\u0439\u043B\u0441\u0430
    \u0441\u0442\u0430\u043B\u0430 \u0435\u0433\u043E \u0441\u0435\u043C\u0438\u043B\u0435\u0442\u043D\u044F\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430 \u043D\u0430\u0434 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C
    \u0442\u0435\u043E\u0440\u0435\u043C\u044B \u0424\u0435\u0440\u043C\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430 \u0435\u043C\u0443 \u0432\u0441\u0435\u043C\u0438\u0440\u043D\u0443\u044E
    \u0441\u043B\u0430\u0432\u0443.  1.  **\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F
    \u0438 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442:** \u041A 1986 \u0433\u043E\u0434\u0443
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
    \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u0442\u0435\u043E\u0440\u0435\u043C\u043E\u0439
    \u0424\u0435\u0440\u043C\u0430 \u0438 \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u043E\u0439
    \u0422\u0430\u043D\u0438\u044F\u043C\u044B \u2014 \u0428\u0438\u043C\u0443\u0440\u044B
    \u2014 \u0412\u0435\u0439\u043B\u044F (\u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E
    **\u0442\u0435\u043E\u0440\u0435\u043C\u0430 \u043E \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438**).
    \u0413\u0435\u0440\u0445\u0430\u0440\u0434 \u0424\u0440\u0435\u0439 \u043F\u043E\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0438\u0437 \u0433\u0438\u043F\u043E\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u043D\u0442\u0440\u043F\u0440\u0438\u043C\u0435\u0440\u0430 \u043A
    \u0442\u0435\u043E\u0440\u0435\u043C\u0435 \u0424\u0435\u0440\u043C\u0430 \u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043A\u0440\u0438\u0432\u0443\u044E (\u0442\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u0430\u044F
    \u043A\u0440\u0438\u0432\u0430\u044F \u0424\u0440\u0435\u044F), \u0430 \u041A\u0435\u043D
    \u0420\u0438\u0431\u0435\u0442 \u0434\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
    \u0442\u0430\u043A\u0430\u044F \u043A\u0440\u0438\u0432\u0430\u044F \u043D\u0435
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0439.
    \u0422\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u0435\u043E\u0440\u0435\u043C\u0443
    \u0424\u0435\u0440\u043C\u0430, \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u0432\u0441\u0435
    **\u043F\u043E\u043B\u0443\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0435
    \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u0440\u0438\u0432\u044B\u0435** \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u044B\u043C\u0438. \u042D\u0442\u043E
    \u0438 \u0441\u0442\u0430\u043B\u043E \u0446\u0435\u043B\u044C\u044E \u0423\u0430\u0439\u043B\u0441\u0430.
    2.  **\u041C\u0435\u0442\u043E\u0434 \u043F\u043E\u0434\u044A\u0451\u043C\u0430
    \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438:** \u0423\u0430\u0439\u043B\u0441
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043D\u043E\u0432\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0439
    \u043C\u0435\u0442\u043E\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B
    \"\u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C\" \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C
    \u043E\u0442 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439
    \u0413\u0430\u043B\u0443\u0430 \u043F\u043E \u043C\u043E\u0434\u0443\u043B\u044E
    \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430
    \u043A \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F\u043C
    \u0441 \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0430\u043C\u0438
    \u0432 p-\u0430\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0447\u0438\u0441\u043B\u0430\u0445.
    \u0421\u0443\u0442\u044C \u043C\u0435\u0442\u043E\u0434\u0430:     *   \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
    \u0442\u0435\u043E\u0440\u0438\u044E \u0434\u0435\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0439
    \u0411\u0430\u0440\u0440\u0438 \u041C\u0430\u0437\u0443\u0440\u0430, \u043E\u043D
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0435
    \u043A\u043E\u043B\u044C\u0446\u043E \u0434\u0435\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0439
    `R`, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438\u0437\u0443\u0435\u0442
    \u0432\u0441\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435 \"\u043F\u043E\u0434\u043D\u044F\u0442\u0438\u044F\"
    \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0433\u043E
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0413\u0430\u043B\u0443\u0430.     *   \u041F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E
    \u043E\u043D \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B \u0430\u043B\u0433\u0435\u0431\u0440\u0443
    \u0413\u0435\u043A\u043A\u0435 `T`, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438\u0437\u0443\u0435\u0442
    \u0442\u0435 \u043F\u043E\u0434\u043D\u044F\u0442\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442 \u0438\u0437 \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u044B\u0445
    \u0444\u043E\u0440\u043C.     *   \u0427\u0442\u043E\u0431\u044B \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0432\u0441\u0435 \u043F\u043E\u0434\u043D\u044F\u0442\u0438\u044F
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u044B\u043C\u0438
    (\u0442.\u0435. `R = T`), \u0423\u0430\u0439\u043B\u0441 \u0441\u0432\u0451\u043B
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043A \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443
    \u0447\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u043D\u0435\u0440\u0430\u0432\u0435\u043D\u0441\u0442\u0432\u0430
    `#(p_R/p_R\xB2) \u2264 #(p_T/p_T\xB2)`, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043C\u043E\u0436\u043D\u043E \u0438\u043D\u0442\u0435\u0440\u043F\u0440\u0435\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043A\u0430\u043A \u0430\u043D\u0430\u043B\u043E\u0433 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0444\u043E\u0440\u043C\u0443\u043B\u044B \u0434\u043B\u044F \u0447\u0438\u0441\u043B\u0430
    \u043A\u043B\u0430\u0441\u0441\u043E\u0432. 3.  **\u0414\u0440\u0430\u043C\u0430
    \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043E\u0448\u0438\u0431\u043A\u0438:**
    \u0412 \u0438\u044E\u043D\u0435 1993 \u0433\u043E\u0434\u0430 \u0423\u0430\u0439\u043B\u0441
    \u0441\u0435\u043D\u0441\u0430\u0446\u0438\u043E\u043D\u043D\u043E \u043E\u0431\u044A\u044F\u0432\u0438\u043B
    \u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435
    \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438
    \u0431\u044B\u043B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D \u043F\u0440\u043E\u0431\u0435\u043B
    \u0432 \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0439. \u042D\u0442\u043E
    \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u043A \u0433\u043E\u0434\u0443 \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B. \u041F\u0440\u043E\u0440\u044B\u0432 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B
    19 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F 1994 \u0433\u043E\u0434\u0430,
    \u043A\u043E\u0433\u0434\u0430 \u0423\u0430\u0439\u043B\u0441, \u0443\u0436\u0435
    \u043F\u043E\u0447\u0442\u0438 \u043E\u0442\u0447\u0430\u044F\u0432\u0448\u0438\u0441\u044C,
    \u043D\u0430\u0448\u0451\u043B \u0441\u043F\u043E\u0441\u043E\u0431 \u043E\u0431\u043E\u0439\u0442\u0438
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0442\u0435\u043E\u0440\u0438\u044E
    \u0418\u0432\u0430\u0441\u0430\u0432\u044B \u2014 \u0442\u0443 \u0441\u0430\u043C\u0443\u044E,
    \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0430\u0447\u0438\u043D\u0430\u043B\u0430\u0441\u044C
    \u0435\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u0430\u044F \u043A\u0430\u0440\u044C\u0435\u0440\u0430.
    \u0412\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u0441\u0432\u043E\u0438\u043C
    \u0431\u044B\u0432\u0448\u0438\u043C \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u043C
    \u0420\u0438\u0447\u0430\u0440\u0434\u043E\u043C \u0422\u0435\u0439\u043B\u043E\u0440\u043E\u043C
    \u043E\u043D \u0432\u043E\u0441\u043F\u043E\u043B\u043D\u0438\u043B \u043F\u0440\u043E\u0431\u0435\u043B.
    4.  **\u041F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u044F:** \u041E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0431\u044B\u043B\u043E \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043E
    \u0432 \u043C\u0430\u0435 1995 \u0433\u043E\u0434\u0430 \u0432 \u0432\u0438\u0434\u0435
    \u0434\u0432\u0443\u0445 \u0441\u0442\u0430\u0442\u0435\u0439 \u0432 \u0436\u0443\u0440\u043D\u0430\u043B\u0435
    *Annals of Mathematics* :     *   **\"Modular Elliptic Curves and Fermat's Last
    Theorem\"** \u2014 \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0441\u0442\u0430\u0442\u044C\u044F,
    \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u0430\u044F \u042D\u043D\u0434\u0440\u044E
    \u0423\u0430\u0439\u043B\u0441\u043E\u043C.     *   **\"Ring-Theoretic Properties
    of Certain Hecke Algebras\"** \u2014 \u0441\u0442\u0430\u0442\u044C\u044F, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u0430\u044F
    \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E \u0441 \u0420\u0438\u0447\u0430\u0440\u0434\u043E\u043C
    \u0422\u0435\u0439\u043B\u043E\u0440\u043E\u043C, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0430\u044F
    \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430. 
    ### \U0001F30D \u041D\u0430\u0441\u043B\u0435\u0434\u0438\u0435 \u0438 \u0432\u043B\u0438\u044F\u043D\u0438\u0435 
    \u0414\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0423\u0430\u0439\u043B\u0441\u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0440\u0435\u0448\u0438\u043B\u043E \u0442\u0440\u0435\u0445\u0432\u0435\u043A\u043E\u0432\u0443\u044E
    \u0437\u0430\u0434\u0430\u0447\u0443, \u043E\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u043B\u043E
    \u043D\u043E\u0432\u0443\u044E \u044D\u0440\u0443 \u0432 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B.  *   **\u041F\u043E\u043B\u043D\u0430\u044F \u0442\u0435\u043E\u0440\u0435\u043C\u0430
    \u043E \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438:**
    \u0420\u0430\u0431\u043E\u0442\u0430 \u0423\u0430\u0439\u043B\u0441\u0430 \u0441\u0442\u0430\u043B\u0430
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u043E\u043C \u0434\u043B\u044F
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043F\u043E\u043B\u043D\u043E\u0439 \u0442\u0435\u043E\u0440\u0435\u043C\u044B
    \u043E \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438,
    \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u043E\u0433\u043E \u0432
    2001 \u0433\u043E\u0434\u0443 \u041A\u0440\u0438\u0441\u0442\u043E\u0444\u043E\u043C
    \u0411\u0440\u0451\u0439\u043B\u0435\u043C, \u0411\u0440\u0430\u0439\u0430\u043D\u043E\u043C
    \u041A\u043E\u043D\u0440\u0430\u0434\u043E\u043C, \u0424\u0440\u0435\u0434\u043E\u043C
    \u0414\u0430\u0439\u043C\u043E\u043D\u0434\u043E\u043C \u0438 \u0420\u0438\u0447\u0430\u0440\u0434\u043E\u043C
    \u0422\u0435\u0439\u043B\u043E\u0440\u043E\u043C. \u042D\u0442\u043E\u0442 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043A\u0440\u0430\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0445
    \u043A\u0430\u043C\u043D\u0435\u0439 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B. *   **\u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C \u041B\u0435\u043D\u0433\u043B\u0435\u043D\u0434\u0441\u0430:**
    \u041C\u0435\u0442\u043E\u0434\u044B \u0423\u0430\u0439\u043B\u0441\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0438
    \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u0432\u043B\u0438\u044F\u043D\u0438\u0435
    \u043D\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
    \u041B\u0435\u043D\u0433\u043B\u0435\u043D\u0434\u0441\u0430 \u2014 \u0433\u0440\u0430\u043D\u0434\u0438\u043E\u0437\u043D\u043E\u0439
    \u0441\u0435\u0442\u0438 \u0433\u0438\u043F\u043E\u0442\u0435\u0437, \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0449\u0438\u0445
    \u0442\u0435\u043E\u0440\u0438\u044E \u0447\u0438\u0441\u0435\u043B, \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044E \u0438 \u0442\u0435\u043E\u0440\u0438\u044E
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439.
    \u0415\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u0441\u0442\u0430\u043B\u0430
    \u043C\u043E\u0449\u043D\u044B\u043C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435\u043C
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u0432 \u044D\u0442\u043E\u0439
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B. *   **\u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435:**
    \u0417\u0430 \u0441\u0432\u043E\u0439 \u0432\u043A\u043B\u0430\u0434 \u0423\u0430\u0439\u043B\u0441
    \u0431\u044B\u043B \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D \u0432\u044B\u0441\u0448\u0438\u0445
    \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u043D\u0430\u0433\u0440\u0430\u0434,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0410\u0431\u0435\u043B\u0435\u0432\u0441\u043A\u0443\u044E
    \u043F\u0440\u0435\u043C\u0438\u044E (2016) \u0438 \u043C\u0435\u0434\u0430\u043B\u044C
    \u041A\u043E\u043F\u043B\u0438 \u041B\u043E\u043D\u0434\u043E\u043D\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0433\u043E \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    (2017)."
  achievementsEn: 
  personalLifeRu: "\u0421\u044D\u0440 \u042D\u043D\u0434\u0440\u044E \u0414\u0436\u043E\u043D
    \u0423\u0430\u0439\u043B\u0441 \u0440\u043E\u0434\u0438\u043B\u0441\u044F 11
    \u0430\u043F\u0440\u0435\u043B\u044F 1953 \u0433\u043E\u0434\u0430 \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0410\u043D\u0433\u043B\u0438\u044F, \u0432 \u0441\u0435\u043C\u044C\u0435 \u0431\u043E\u0433\u043E\u0441\u043B\u043E\u0432\u0430
    \u041C\u043E\u0440\u0438\u0441\u0430 \u0424\u0440\u044D\u043D\u043A\u0430 \u0423\u0430\u0439\u043B\u0441\u0430
    \u0438 \u0435\u0433\u043E \u0436\u0435\u043D\u044B \u041F\u0430\u0442\u0440\u0438\u0441\u0438\u0438.
    \u0415\u0433\u043E \u043E\u0442\u0435\u0446 \u0431\u044B\u043B \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u043E\u043C,
    \u0430 \u043F\u043E\u0437\u0436\u0435 \u0441\u0442\u0430\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    \u0431\u043E\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u044F \u0432 \u041E\u043A\u0441\u0444\u043E\u0440\u0434\u0435.
    \u041A\u043E\u0433\u0434\u0430 \u042D\u043D\u0434\u0440\u044E \u0431\u044B\u043B\u043E
    \u0434\u0432\u0430 \u0433\u043E\u0434\u0430, \u0441\u0435\u043C\u044C\u044F \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0430
    \u0432 \u041D\u0438\u0433\u0435\u0440\u0438\u044E, \u0433\u0434\u0435 \u043E\u043D
    \u043D\u0430\u0447\u0430\u043B \u0441\u0432\u043E\u0435 \u0448\u043A\u043E\u043B\u044C\u043D\u043E\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435. \u041F\u043E
    \u0441\u043B\u043E\u0432\u0430\u043C \u0435\u0433\u043E \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439,
    \u0432 \u043F\u0435\u0440\u0432\u044B\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u043E\u043D \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0441\u044F
    \u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u0448\u043A\u043E\u043B\u0443, \u0445\u043E\u0442\u044F
    \u043F\u043E\u0437\u0436\u0435 \u0441\u0430\u043C \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u043B\u0441\u044F,
    \u0447\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043D\u0438\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
    \u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043B\u044E\u0431\u0438\u043B \u0440\u0435\u0448\u0430\u0442\u044C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438.  ### \U0001F3EB \u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438 \u0440\u0430\u043D\u043D\u0438\u0435 \u0433\u043E\u0434\u044B  \u0412\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C
    \u0432 \u0410\u043D\u0433\u043B\u0438\u044E \u0432 1959 \u0433\u043E\u0434\u0443,
    \u0423\u0430\u0439\u043B\u0441 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 \u0448\u043A\u043E\u043B\u0443 \u043F\u0440\u0438 \u041A\u0438\u043D\u0433\u0441-\u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435
    \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435. \u0418\u043C\u0435\u043D\u043D\u043E
    \u0442\u0430\u043C, \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u0435\u0441\u044F\u0442\u0438
    \u043B\u0435\u0442, \u043E\u043D \u043D\u0430\u0448\u0435\u043B \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435
    \u043A\u043D\u0438\u0433\u0443 \u042D\u0440\u0438\u043A\u0430 \u0422\u0435\u043C\u043F\u043B\u0430
    \u0411\u0435\u043B\u043B\u0430 \xAB\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\xBB \u0438 \u0432\u043F\u0435\u0440\u0432\u044B\u0435
    \u0443\u0437\u043D\u0430\u043B \u043E \u0412\u0435\u043B\u0438\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0435\u043C\u0435 \u0424\u0435\u0440\u043C\u0430. \u041F\u0440\u043E\u0441\u0442\u043E\u0442\u0430
    \u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0438 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043D\u0430 \u0444\u043E\u043D\u0435 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
    \u043E\u043D\u0430 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F\u043C\u0438
    \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044C
    \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u043C \u0443\u043C\u0430\u043C,
    \u043F\u043E\u0440\u0430\u0437\u0438\u043B\u0430 \u0435\u0433\u043E. \u041E\u043D
    \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B: \xAB\u0418 \u0432\u043E\u0442
    \u043E\u043D\u0430 \u0431\u044B\u043B\u0430, \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F, \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u043D\u0438\u0439,
    \u043C\u043E\u0433 \u043F\u043E\u043D\u044F\u0442\u044C, \u0438 \u044F \u0437\u043D\u0430\u043B
    \u0441 \u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430, \u0447\u0442\u043E
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0435\u0435 \u043D\u0435 \u043E\u0442\u043F\u0443\u0449\u0443.
    \u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0435\u0435 \u0440\u0435\u0448\u0438\u0442\u044C\xBB. 
    \u0421 1966 \u0433\u043E\u0434\u0430 \u0423\u0430\u0439\u043B\u0441 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0432 \u0448\u043A\u043E\u043B\u0435
    \u041B\u0435\u0439\u0441 \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0433\u0434\u0435 \u0435\u0433\u043E \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u0431\u044B\u043B
    \u0443\u0447\u0438\u0442\u0435\u043B\u044C \u0441 \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u0439
    \u0441\u0442\u0435\u043F\u0435\u043D\u044C\u044E \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u0430\u043B
    \u0435\u043C\u0443 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438 \u043F\u043E \u044D\u0442\u043E\u0439
    \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0435. \u0412 1971 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u043A\u043E\u043B\u043B\u0435\u0434\u0436
    \u041C\u0435\u0440\u0442\u043E\u043D \u041E\u043A\u0441\u0444\u043E\u0440\u0434\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043E\u043A\u043E\u043D\u0447\u0438\u043B \u0432 1974 \u0433\u043E\u0434\u0443
    \u0441\u043E \u0441\u0442\u0435\u043F\u0435\u043D\u044C\u044E \u0431\u0430\u043A\u0430\u043B\u0430\u0432\u0440\u0430
    \u043F\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435.  ###
    \U0001F468\u200D\U0001F3EB \u041D\u0430\u0443\u0447\u043D\u0430\u044F \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438 
    \u041F\u043E\u0441\u043B\u0435 \u041E\u043A\u0441\u0444\u043E\u0440\u0434\u0430
    \u0423\u0430\u0439\u043B\u0441 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 \u041A\u043B\u044D\u0440-\u043A\u043E\u043B\u043B\u0435\u0434\u0436 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u0433\u0434\u0435
    \u0441 \u043B\u0435\u0442\u0430 1975 \u0433\u043E\u0434\u0430 \u043D\u0430\u0447\u0430\u043B
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    **\u0414\u0436\u043E\u043D\u0430 \u041A\u043E\u0443\u0442\u0441\u0430**. \u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441 \u041A\u043E\u0443\u0442\u0441\u043E\u043C, \u043F\u043E \u0441\u043B\u043E\u0432\u0430\u043C
    \u0423\u0430\u0439\u043B\u0441\u0430, \u0431\u044B\u043B\u043E \xAB\u043F\u0440\u043E\u0441\u0442\u043E
    \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C\xBB
    \u0438 \u043E\u0437\u043D\u0430\u043C\u0435\u043D\u043E\u0432\u0430\u043B\u043E
    \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434 \u043E\u0442 \u0443\u0447\u0435\u0431\u044B
    \u043A \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u0435. \u0418\u0445 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430 \u043F\u0440\u0438\u0432\u0435\u043B\u0430
    \u043A \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E **\u0442\u0435\u043E\u0440\u0435\u043C\u044B
    \u041A\u043E\u0443\u0442\u0441\u0430-\u0423\u0430\u0439\u043B\u0441\u0430** \u2014
    \u0432\u0430\u0436\u043D\u043E\u043C\u0443 \u043F\u0440\u043E\u0440\u044B\u0432\u0443
    \u0432 \u0434\u0438\u043E\u0444\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u0442\u0435\u043E\u0440\u0438\u0438
    \u043A\u0443\u0431\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439. 
    \u0412 1977\u20131980 \u0433\u043E\u0434\u0430\u0445 \u0423\u0430\u0439\u043B\u0441
    \u0431\u044B\u043B \u043C\u043B\u0430\u0434\u0448\u0438\u043C \u043D\u0430\u0443\u0447\u043D\u044B\u043C
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u043C \u0432 \u041A\u043B\u044D\u0440-\u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435
    \u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0433\u0434\u0435 \u043D\u0430\u0447\u0430\u043B \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441 **\u0411\u0430\u0440\u0440\u0438 \u041C\u0430\u0437\u0443\u0440\u043E\u043C**.
    \u0412\u043C\u0435\u0441\u0442\u0435 \u043E\u043D\u0438 \u0440\u0435\u0448\u0438\u043B\u0438
    \u0434\u0430\u0432\u043D\u044E\u044E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443
    \u0432 \u0442\u0435\u043E\u0440\u0438\u0438 \u0418\u0432\u0430\u0441\u0430\u0432\u044B,
    \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0432 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443. \u0412 1980 \u0433\u043E\u0434\u0443 \u0423\u0430\u0439\u043B\u0441
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E
    \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u0437\u0430 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E,
    \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0434\u043E\u043A\u0430\u0437\u0430\u043B
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0447\u0430\u0441\u0442\u043D\u044B\u0435
    \u0441\u043B\u0443\u0447\u0430\u0438 \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B
    \u0411\u0451\u0440\u0447\u0430 \u2014 \u0421\u0443\u0438\u043D\u043D\u0435\u0440\u0442\u043E\u043D\u0430-\u0414\u0430\u0439\u0435\u0440\u0430. 
    \u0412 1981 \u0433\u043E\u0434\u0443 \u043E\u043D \u0441\u0442\u0430\u043B \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0432
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435, \u0430 \u0432 1982-\u043C
    \u2014 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0412
    1985\u20131986 \u0433\u043E\u0434\u0430\u0445 \u043F\u043E \u0441\u0442\u0438\u043F\u0435\u043D\u0434\u0438\u0438
    \u0413\u0443\u0433\u0433\u0435\u043D\u0445\u0430\u0439\u043C\u0430 \u043E\u043D
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 \u041F\u0430\u0440\u0438\u0436\u0435. 
    ### \U0001F48D \u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C
    \u0438 \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044F  \u0412 1988 \u0433\u043E\u0434\u0443
    \u0423\u0430\u0439\u043B\u0441 \u0436\u0435\u043D\u0438\u043B\u0441\u044F \u043D\u0430
    **\u041D\u0430\u0434\u0435 \u041A\u0430\u043D\u0430\u0430\u043D**, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E
    \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u043F\u043E \u043C\u043E\u043B\u0435\u043A\u0443\u043B\u044F\u0440\u043D\u043E\u0439
    \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0438 \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435.
    \u0423 \u043F\u0430\u0440\u044B \u0440\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0442\u0440\u0438 \u0434\u043E\u0447\u0435\u0440\u0438: \u041A\u043B\u044D\u0440
    (\u0430\u0432\u0433\u0443\u0441\u0442 1990), \u041A\u0435\u0439\u0442 (\u043D\u043E\u044F\u0431\u0440\u044C
    1991) \u0438 \u041E\u043B\u0438\u0432\u0438\u044F (\u043C\u0430\u0439 1994). 
    \u0418\u043C\u0435\u043D\u043D\u043E \u0432 \u0433\u043E\u0434 \u0441\u0432\u0430\u0434\u044C\u0431\u044B,
    \u0443\u0437\u043D\u0430\u0432 \u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435
    \u041A\u0435\u043D\u043E\u043C \u0420\u0438\u0431\u0435\u0442\u043E\u043C \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B,
    \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0449\u0435\u0439 \u0442\u0435\u043E\u0440\u0435\u043C\u0443
    \u0424\u0435\u0440\u043C\u0430 \u0441 \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u043E\u0439
    \u0422\u0430\u043D\u0438\u044F\u043C\u044B\u2013\u0428\u0438\u043C\u0443\u0440\u044B,
    \u0423\u0430\u0439\u043B\u0441 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0441\u044F \u0432 \u0440\u0435\u0448\u0435\u043D\u0438\u0435.
    \u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B \u0441\u0432\u043E\u0435\u0439
    \u0436\u0435\u043D\u0435 \u043E\u0431 \u044D\u0442\u043E\u043C \u0447\u0435\u0440\u0435\u0437
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
    \u043F\u043E\u0441\u043B\u0435 \u0441\u0432\u0430\u0434\u044C\u0431\u044B. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u0441\u0435\u043C\u044C \u043B\u0435\u0442 \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0432 \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u043D\u043E\u0439 \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0438,
    \u0440\u0430\u0441\u043A\u0440\u044B\u0432 \u0441\u0432\u043E\u0438 \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0435
    \u0446\u0435\u043B\u0438 \u043B\u0438\u0448\u044C \u043A\u043E\u043B\u043B\u0435\u0433\u0435
    **\u041D\u0438\u043A\u043E\u043B\u0430\u0441\u0443 \u041A\u0430\u0446\u0443**.
    \u0423\u0430\u0439\u043B\u0441 \u0433\u043E\u0432\u043E\u0440\u0438\u043B: \xAB\u042F
    \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B
    \u0441 \u043B\u044E\u0434\u044C\u043C\u0438 \u043E \u0424\u0435\u0440\u043C\u0430
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u044D\u0442\u043E \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
    \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441... \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F
    \u0431\u044B\u043B\u043E \u0432\u0440\u0435\u043C\u044F \u0441 \u0434\u0435\u0442\u044C\u043C\u0438.
    \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u0434\u0435\u0442\u0438
    \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044E\u0442\u0441\u044F
    \u0424\u0435\u0440\u043C\u0430\xBB.  \u0412 1988\u20131990 \u0433\u043E\u0434\u0430\u0445
    \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    \u0432 \u041E\u043A\u0441\u0444\u043E\u0440\u0434\u0435, \u0430 \u0432 1989 \u0433\u043E\u0434\u0443
    \u0431\u044B\u043B \u0438\u0437\u0431\u0440\u0430\u043D \u0447\u043B\u0435\u043D\u043E\u043C
    \u041B\u043E\u043D\u0434\u043E\u043D\u0441\u043A\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430.  ### \U0001F3C6 \u041A\u0443\u043B\u044C\u043C\u0438\u043D\u0430\u0446\u0438\u044F
    \u0438 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441 \u043D\u0430\u0443\u0447\u043D\u044B\u043C
    \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E\u043C  \u0412 \u0438\u044E\u043D\u0435
    1993 \u0433\u043E\u0434\u0430 \u0423\u0430\u0439\u043B\u0441 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B
    \u0442\u0440\u0438 \u043B\u0435\u043A\u0446\u0438\u0438 \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u043E\u0431\u044A\u044F\u0432\u0438\u043B \u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435
    \u0442\u0435\u043E\u0440\u0435\u043C\u044B \u0424\u0435\u0440\u043C\u0430. \u042D\u0442\u043E
    \u0432\u044B\u0437\u0432\u0430\u043B\u043E \u0441\u0435\u043D\u0441\u0430\u0446\u0438\u044E,
    \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u0440\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0435
    \u0431\u044B\u043B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D \u043F\u0440\u043E\u0431\u0435\u043B.
    \u0423\u0430\u0439\u043B\u0441 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B:
    \xAB\u041F\u0435\u0440\u0432\u044B\u0435 \u0441\u0435\u043C\u044C \u043B\u0435\u0442
    \u044F \u043B\u044E\u0431\u0438\u043B \u043A\u0430\u0436\u0434\u0443\u044E \u043C\u0438\u043D\u0443\u0442\u0443,
    \u043A\u0430\u043A \u0431\u044B \u0442\u0440\u0443\u0434\u043D\u043E \u043D\u0438
    \u0431\u044B\u043B\u043E... \u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u0430
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430... \u0442\u0430\u043A\u043E\u0439
    \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u0439 \u0441\u0442\u0438\u043B\u044C
    \u0440\u0430\u0431\u043E\u0442\u044B \u2014 \u0442\u043E\u0447\u043D\u043E \u043D\u0435
    \u043C\u043E\u0439, \u044F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0435\u0433\u043E
    \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C\xBB.  \u0420\u0435\u0448\u0430\u044E\u0449\u0435\u0435
    \u043E\u0437\u0430\u0440\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0448\u043B\u043E
    \u043A \u043D\u0435\u043C\u0443 **19 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F
    1994 \u0433\u043E\u0434\u0430**, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D
    \u0443\u0436\u0435 \u0431\u044B\u043B \u043D\u0430 \u0433\u0440\u0430\u043D\u0438
    \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F. \u0412\u043C\u0435\u0441\u0442\u0435
    \u0441 \u0431\u044B\u0432\u0448\u0438\u043C \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u043C
    **\u0420\u0438\u0447\u0430\u0440\u0434\u043E\u043C \u0422\u0435\u0439\u043B\u043E\u0440\u043E\u043C**
    \u043E\u043D \u0432\u043E\u0441\u043F\u043E\u043B\u043D\u0438\u043B \u043F\u0440\u043E\u0431\u0435\u043B,
    \u0438 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0431\u044B\u043B\u0438 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u044B
    \u0432 1995 \u0433\u043E\u0434\u0443. \u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441 \u0422\u0435\u0439\u043B\u043E\u0440\u043E\u043C \u0441\u0442\u0430\u043B\u043E
    \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u043C, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B \u0423\u0430\u0439\u043B\u0441\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0438
    \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u043E \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438
    \u043A 2000 \u0433\u043E\u0434\u0443.  ### \U0001F451 \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B, \u0442\u0438\u0442\u0443\u043B\u044B \u0438 \u0441\u043C\u0435\u0440\u0442\u044C 
    \u0412 1994 \u0433\u043E\u0434\u0443 \u0423\u0430\u0439\u043B\u0441 \u0441\u0442\u0430\u043B
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u0415\u0432\u0433\u0435\u043D\u0430
    \u0425\u0438\u0433\u0433\u0438\u043D\u0441\u0430 \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435,
    \u0433\u0434\u0435 \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0434\u043E 2009 \u0433\u043E\u0434\u0430. \u0412 1998 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E
    \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443
    \u043E\u0442 \u041C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u044E\u0437\u0430 (\u0430\u043D\u0430\u043B\u043E\u0433 \u043C\u0435\u0434\u0430\u043B\u0438
    \u0424\u0438\u043B\u0434\u0441\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u043D\u0435 \u043C\u043E\u0433 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0438\u0437-\u0437\u0430 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430).
    \u0412 2000 \u0433\u043E\u0434\u0443 \u0431\u044B\u043B \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D
    \u0432 \u0440\u044B\u0446\u0430\u0440\u0438-\u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0440\u044B
    \u041E\u0440\u0434\u0435\u043D\u0430 \u0411\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438. \u0412 2005\u20132009 \u0433\u043E\u0434\u0430\u0445
    \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u043B\u044F\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0430. 
    \u0412 2011 \u0433\u043E\u0434\u0443 \u0423\u0430\u0439\u043B\u0441 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0432 \u041E\u043A\u0441\u0444\u043E\u0440\u0434, \u0430 \u0432 2018 \u0433\u043E\u0434\u0443
    \u0441\u0442\u0430\u043B \u043F\u0435\u0440\u0432\u044B\u043C \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u043C
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.
    \u0412 2016 \u0433\u043E\u0434\u0443 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0410\u0431\u0435\u043B\u0435\u0432\u0441\u043A\u0443\u044E \u043F\u0440\u0435\u043C\u0438\u044E. 
    \u042D\u043D\u0434\u0440\u044E \u0423\u0430\u0439\u043B\u0441 **\u0436\u0438\u0432
    \u043F\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044E \u043D\u0430
    2026 \u0433\u043E\u0434** (\u0440\u043E\u0434\u0438\u043B\u0441\u044F 11 \u0430\u043F\u0440\u0435\u043B\u044F
    1953 \u0433\u043E\u0434\u0430, \u0435\u043C\u0443 73 \u0433\u043E\u0434\u0430).
    \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u0435\u0433\u043E
    \u0441\u043C\u0435\u0440\u0442\u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u0445, \u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    \u0437\u0430\u043F\u0440\u043E\u0441\u044B \u0432 \u0441\u0435\u0442\u0438 \u043D\u0435
    \u0438\u043C\u0435\u044E\u0442 \u043F\u043E\u0434 \u0441\u043E\u0431\u043E\u0439
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0439."
  personalLifeEn: 
  shortBioRu: "\u0421\u044D\u0440 \u042D\u043D\u0434\u0440\u044E \u0414\u0436\u043E\u043D
    \u0423\u0430\u0439\u043B\u0441 \u2014 \u0431\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0438\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A, \u0447\u044C\u0451 \u0438\u043C\u044F
    \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u043F\u0438\u0441\u0430\u043D\u043E
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u043D\u0430\u0443\u043A\u0438
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u0442\u0435\u043E\u0440\u0435\u043C\u044B
    \u0424\u0435\u0440\u043C\u0430, \u0437\u0430\u0434\u0430\u0447\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0430\u0441\u044C \u043D\u0435\u0440\u0435\u0448\u0451\u043D\u043D\u043E\u0439
    \u0431\u043E\u043B\u0435\u0435 \u0442\u0440\u0451\u0445 \u0441 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043E\u0439
    \u0432\u0435\u043A\u043E\u0432. \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C
    \u2014 \u044D\u0442\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0443\u0432\u043B\u0435\u0447\u0451\u043D\u043D\u043E\u0441\u0442\u0438,
    \u0441\u0430\u043C\u043E\u043E\u0442\u0432\u0435\u0440\u0436\u0435\u043D\u043D\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B \u0438 \u0442\u0440\u0438\u0443\u043C\u0444\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u0438\u0448\u0451\u043B
    \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043D\u0438\u0435,
    \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0431\u044B, \u043D\u0435\u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0438\u043C\u044B\u0445
    \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0435\u0439.  ### \U0001F4D6
    \u0420\u0430\u043D\u043D\u0438\u0435 \u0433\u043E\u0434\u044B \u0438 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043C\u0435\u0447\u0442\u044B  \u042D\u043D\u0434\u0440\u044E \u0423\u0430\u0439\u043B\u0441
    \u0440\u043E\u0434\u0438\u043B\u0441\u044F 11 \u0430\u043F\u0440\u0435\u043B\u044F
    1953 \u0433\u043E\u0434\u0430 \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0410\u043D\u0433\u043B\u0438\u044F. \u0415\u0433\u043E \u043E\u0442\u0435\u0446,
    \u041C\u043E\u0440\u0438\u0441 \u0424\u0440\u044D\u043D\u043A \u0423\u0430\u0439\u043B\u0441,
    \u0431\u044B\u043B \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u043E\u043C
    \u0438 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u0431\u043E\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u044F,
    \u0447\u0442\u043E \u0441\u043E\u0437\u0434\u0430\u043B\u043E \u0432 \u0441\u0435\u043C\u044C\u0435
    \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443 \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0445
    \u0437\u0430\u043D\u044F\u0442\u0438\u0439. \u041C\u0430\u0442\u044C \u0437\u0432\u0430\u043B\u0438
    \u041F\u0430\u0442\u0440\u0438\u0448\u0430 (\u0443\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u0430\u044F
    \u041C\u043E\u0443\u043B\u043B).  \u041F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u0439
    \u043C\u043E\u043C\u0435\u043D\u0442 \u0432 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438
    \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    \u0434\u0435\u0441\u044F\u0442\u0438 \u043B\u0435\u0442, \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0441\u044F \u0432 \u043C\u0435\u0441\u0442\u043D\u043E\u0439
    \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435 \u043D\u0430 \u043A\u043D\u0438\u0433\u0443
    \u042D\u0440\u0438\u043A\u0430 \u0422\u0435\u043C\u043F\u043B\u0430 \u0411\u0435\u043B\u043B\u0430
    \xAB\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\xBB.
    \u0412 \u043D\u0435\u0439 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u043E\u0441\u044C
    \u043E \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u0442\u0435\u043E\u0440\u0435\u043C\u0435
    \u0424\u0435\u0440\u043C\u0430 \u2014 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0438,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0437\u0432\u0443\u0447\u0430\u043B\u043E
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0441\u0442\u043E,
    \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u043D\u044F\u0442\u043D\u043E
    \u0434\u0430\u0436\u0435 \u0448\u043A\u043E\u043B\u044C\u043D\u0438\u043A\u0443,
    \u043D\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F\u043C\u0438
    \u043D\u0435 \u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044C \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u043C
    \u0443\u043C\u0430\u043C. \u042D\u0442\u0430 \u043A\u043D\u0438\u0433\u0430 \u0437\u0430\u0436\u0433\u043B\u0430
    \u0432 \u044E\u043D\u043E\u043C \u0423\u0430\u0439\u043B\u0441\u0435 \u043C\u0435\u0447\u0442\u0443
    \u2014 \u0441\u0442\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u043C, \u043A\u0442\u043E
    \u0434\u043E\u043A\u0430\u0436\u0435\u0442 \u044D\u0442\u0443 \u0442\u0435\u043E\u0440\u0435\u043C\u0443. 
    \u041E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432 \u0448\u043A\u043E\u043B\u0435 \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0430 \u0438 \u0448\u043A\u043E\u043B\u0435
    \u041B\u0435\u0439\u0441 \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435
    , \u0430 \u0437\u0430\u0442\u0435\u043C \u0432 1974 \u0433\u043E\u0434\u0443
    \u043E\u043A\u043E\u043D\u0447\u0438\u043B \u043A\u043E\u043B\u043B\u0435\u0434\u0436
    \u041C\u0435\u0440\u0442\u043E\u043D \u041E\u043A\u0441\u0444\u043E\u0440\u0434\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0441\u043E
    \u0441\u0442\u0435\u043F\u0435\u043D\u044C\u044E \u0431\u0430\u043A\u0430\u043B\u0430\u0432\u0440\u0430
    \u043F\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435.  ###
    \U0001F393 \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043F\u0443\u0442\u044C \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F 
    \u041F\u043E\u0441\u043B\u0435 \u041E\u043A\u0441\u0444\u043E\u0440\u0434\u0430
    \u0423\u0430\u0439\u043B\u0441 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (\u043A\u043E\u043B\u043B\u0435\u0434\u0436
    \u041A\u043B\u044D\u0440), \u0433\u0434\u0435 \u0432 1975 \u0433\u043E\u0434\u0443
    \u043D\u0430\u0447\u0430\u043B \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0430
    \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B
    \u0414\u0436\u043E\u043D\u0430 \u041A\u043E\u0443\u0442\u0441\u0430. \u0418\u0445
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u043E
    \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u043A\u0435 \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043A\u0440\u0438\u0432\u044B\u0445 \u0441 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043D\u044B\u043C
    \u0443\u043C\u043D\u043E\u0436\u0435\u043D\u0438\u0435\u043C \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u043C\u0435\u0442\u043E\u0434\u043E\u0432 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0418\u0432\u0430\u0441\u0430\u0432\u044B. \u0412 1980 \u0433\u043E\u0434\u0443
    \u0423\u0430\u0439\u043B\u0441 \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0437\u0430\u0449\u0438\u0442\u0438\u043B
    \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E. 
    \u0414\u0430\u043B\u0435\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430
    \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0430\u044F \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u0430\u0440\u044C\u0435\u0440\u0430: *   **1977\u20131980:** \u041C\u043B\u0430\u0434\u0448\u0438\u0439
    \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A
    \u0432 \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435 \u041A\u043B\u044D\u0440
    (\u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436) \u0438 \u0434\u043E\u0446\u0435\u043D\u0442
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    *   **1981:** \u0420\u0430\u0431\u043E\u0442\u0430 \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0432
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435. *   **1982:** \u0421\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0433\u0434\u0435
    \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043C\u043D\u043E\u0433\u043E
    \u043B\u0435\u0442. *   **1985\u20131986:** \u041A\u0430\u043A \u0441\u0442\u0438\u043F\u0435\u043D\u0434\u0438\u0430\u0442
    \u0444\u043E\u043D\u0434\u0430 \u0413\u0443\u0433\u0433\u0435\u043D\u0445\u0430\u0439\u043C\u0430
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0432\u043E \u0424\u0440\u0430\u043D\u0446\u0438\u0438
    \u2014 \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0432\u044B\u0441\u0448\u0438\u0445
    \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439
    \u0438 \u0412\u044B\u0441\u0448\u0435\u0439 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u0448\u043A\u043E\u043B\u0435. *   **1988\u20131990:** \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0412\u0435\u043B\u0438\u043A\u043E\u0431\u0440\u0438\u0442\u0430\u043D\u0438\u044E
    \u043A\u0430\u043A \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    \u041B\u043E\u043D\u0434\u043E\u043D\u0441\u043A\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0432 \u041E\u043A\u0441\u0444\u043E\u0440\u0434\u0435,
    \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D.  \u0412 1988 \u0433\u043E\u0434\u0443
    \u043E\u043D \u0436\u0435\u043D\u0438\u043B\u0441\u044F \u043D\u0430 \u041D\u0430\u0434\u0435
    \u041A\u0430\u043D\u0430\u0430\u043D, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0442\u0430\u043A\u0436\u0435 \u0431\u044B\u043B\u0430 \u0443\u0447\u0451\u043D\u044B\u043C
    \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E
    \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u043F\u043E \u043C\u0438\u043A\u0440\u043E\u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0438.
    \u0423 \u043F\u0430\u0440\u044B \u0440\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0442\u0440\u0438 \u0434\u043E\u0447\u0435\u0440\u0438: \u041A\u043B\u044D\u0440,
    \u041A\u0435\u0439\u0442 \u0438 \u041E\u043B\u0438\u0432\u0438\u044F.  ### \U0001F4A1
    \u0412\u0435\u043B\u0438\u043A\u0430\u044F \u0442\u0435\u043E\u0440\u0435\u043C\u0430
    \u0424\u0435\u0440\u043C\u0430: \u0421\u0435\u043C\u044C \u043B\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0430
    \u0438 \u0441\u043B\u0430\u0432\u044B  \u0420\u0435\u0448\u0430\u044E\u0449\u0438\u0439
    \u043C\u043E\u043C\u0435\u043D\u0442 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 1986 \u0433\u043E\u0434\u0443. \u0423\u0430\u0439\u043B\u0441 \u0443\u0437\u043D\u0430\u043B,
    \u0447\u0442\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A \u041A\u0435\u043D
    \u0420\u0438\u0431\u0435\u0442 \u0434\u043E\u043A\u0430\u0437\u0430\u043B \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0443,
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0432\u0448\u0443\u044E \u043F\u0440\u044F\u043C\u0443\u044E
    \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u0412\u0435\u043B\u0438\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0435\u043C\u043E\u0439 \u0424\u0435\u0440\u043C\u0430
    \u0438 \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u043E\u0439 \u0422\u0430\u043D\u0438\u044F\u043C\u044B\u2013\u0421\u0438\u043C\u0443\u0440\u044B\u2013\u0412\u0435\u0439\u043B\u044F
    (\u043E \u043C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438
    \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043A\u0440\u0438\u0432\u044B\u0445). \u0415\u0441\u043B\u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u044D\u0442\u0443 \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0443 \u0434\u043B\u044F
    \u043F\u043E\u043B\u0443\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0445
    \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043A\u0440\u0438\u0432\u044B\u0445, \u0442\u0435\u043E\u0440\u0435\u043C\u0430
    \u0424\u0435\u0440\u043C\u0430 \u0431\u044B\u043B\u0430 \u0431\u044B \u0434\u043E\u043A\u0430\u0437\u0430\u043D\u0430
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.
    \u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442 \u0423\u0430\u0439\u043B\u0441
    \u043F\u043E\u043D\u044F\u043B: \u043F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C \u043C\u0435\u0447\u0442\u0443
    \u0434\u0435\u0442\u0441\u0442\u0432\u0430.  \u041E\u043D \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
    \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u043B \u043A \u0440\u0430\u0431\u043E\u0442\u0435,
    \u043D\u043E \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0441\u0442\u0440\u043E\u0436\u0430\u0439\u0448\u0435\u0439
    \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0441\u0442\u0438. \u041D\u0430
    \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u0431\u043E\u043B\u0435\u0435
    \u0448\u0435\u0441\u0442\u0438 \u043B\u0435\u0442 \u043E\u043D \u043F\u043E\u0447\u0442\u0438
    \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B
    \u043E \u0441\u0432\u043E\u0435\u0439 \u0446\u0435\u043B\u0438, \u0447\u0442\u043E\u0431\u044B
    \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0438 \u043B\u0438\u0448\u043D\u0438\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432.
    \u041E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 \u043F\u043E\u043B\u043D\u043E\u0439
    \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0438 \u043D\u0430 \u0447\u0435\u0440\u0434\u0430\u043A\u0435
    \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u043E\u043C\u0430, \u043B\u0438\u0448\u044C
    \u0438\u043D\u043E\u0433\u0434\u0430 \u0434\u0435\u043B\u044F\u0441\u044C \u0434\u0435\u0442\u0430\u043B\u044F\u043C\u0438
    \u0441 \u0434\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C \u043A\u043E\u043B\u043B\u0435\u0433\u043E\u0439,
    \u041D\u0438\u043A\u043E\u043B\u0430\u0441\u043E\u043C \u041A\u0430\u0446\u0435\u043C,
    \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0438\u0434\u0435\u0439. 
    \u041A\u0443\u043B\u044C\u043C\u0438\u043D\u0430\u0446\u0438\u0435\u0439 \u044D\u0442\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B \u0441\u0442\u0430\u043B\u043E 23 \u0438\u044E\u043D\u044F
    1993 \u0433\u043E\u0434\u0430, \u043A\u043E\u0433\u0434\u0430 \u043D\u0430 \u043A\u043E\u043D\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0438
    \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B
    \u0432 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0435 \u0423\u0430\u0439\u043B\u0441
    \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B \u0442\u0440\u0438 \u043B\u0435\u043A\u0446\u0438\u0438
    \u043F\u043E\u0434 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u043C \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C
    \xAB\u041C\u043E\u0434\u0443\u043B\u044F\u0440\u043D\u044B\u0435 \u0444\u043E\u0440\u043C\u044B,
    \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u0440\u0438\u0432\u044B\u0435 \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0413\u0430\u043B\u0443\u0430\xBB. \u0412 \u043A\u043E\u043D\u0446\u0435 \u0442\u0440\u0435\u0442\u044C\u0435\u0439
    \u043B\u0435\u043A\u0446\u0438\u0438 \u043E\u043D, \u0431\u0443\u0434\u0442\u043E
    \u043D\u0435\u0432\u0437\u043D\u0430\u0447\u0430\u0439, \u043E\u0431\u044A\u044F\u0432\u0438\u043B,
    \u0447\u0442\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u043B \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0443
    \u0422\u0430\u043D\u0438\u044F\u043C\u044B\u2013\u0421\u0438\u043C\u0443\u0440\u044B
    \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0445
    \u043A\u0440\u0438\u0432\u044B\u0445, \u0430 \u0437\u043D\u0430\u0447\u0438\u0442,
    \u0438 \u0412\u0435\u043B\u0438\u043A\u0443\u044E \u0442\u0435\u043E\u0440\u0435\u043C\u0443
    \u0424\u0435\u0440\u043C\u0430. \u0417\u0430\u043B \u0432\u0437\u043E\u0440\u0432\u0430\u043B\u0441\u044F
    \u0430\u043F\u043B\u043E\u0434\u0438\u0441\u043C\u0435\u043D\u0442\u0430\u043C\u0438;
    \u043D\u043E\u0432\u043E\u0441\u0442\u044C \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
    \u043E\u0431\u043B\u0435\u0442\u0435\u043B\u0430 \u043C\u0438\u0440.  ### \U0001F9D7\u200D\u2642\uFE0F
    \u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0448\u0438\u0431\u043A\u0438
    \u0438 \u0442\u0440\u0438\u0443\u043C\u0444  \u0420\u0430\u0434\u043E\u0441\u0442\u044C
    \u0431\u044B\u043B\u0430 \u043D\u0435\u0434\u043E\u043B\u0433\u043E\u0439. \u0412
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
    \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u0438
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438 \u043F\u0440\u043E\u0431\u0435\u043B
    \u0432 \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u0440\u0430\u0437\u0434\u0435\u043B\u043E\u0432 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.
    \u041F\u043E\u043F\u044B\u0442\u043A\u0438 \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C
    \u0435\u0433\u043E \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C
    \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C \u043D\u0430 \u0433\u043E\u0434.
    \u0423\u0430\u0439\u043B\u0441, \u043F\u043E \u0435\u0433\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443
    \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u044E, \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u043D\u0430 \u0433\u0440\u0430\u043D\u0438 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F. 
    \u041F\u0440\u043E\u0440\u044B\u0432 \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F
    19 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F 1994 \u0433\u043E\u0434\u0430.
    \u041A\u043E\u0433\u0434\u0430 \u043E\u043D \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438
    \u0441\u0434\u0430\u043B\u0441\u044F, \u0435\u0433\u043E \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
    \u043E\u0441\u0435\u043D\u0438\u043B\u0430 \u0438\u0434\u0435\u044F. \u0412\u043C\u0435\u0441\u0442\u043E
    \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F
    \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0439
    \u043F\u0440\u043E\u0431\u0435\u043B, \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
    \u0438\u043D\u043E\u0439 \u043F\u043E\u0434\u0445\u043E\u0434, \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043D\u0430 \u0442\u0435\u043E\u0440\u0438\u0438 \u0418\u0432\u0430\u0441\u0430\u0432\u044B,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0431\u044B\u043B\u0430 \u0435\u043C\u0443
    \u0445\u043E\u0440\u043E\u0448\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0430
    \u043F\u043E \u0440\u0430\u043D\u043D\u0438\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u043C.
    \u042D\u0442\u0430 \u043D\u043E\u0432\u0430\u044F \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F
    \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0430 \u043E\u0431\u043E\u0439\u0442\u0438
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. 
    \u0412\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u0451\u043D\u043D\u044B\u0439,
    \u0423\u0430\u0439\u043B\u0441 \u0432\u0441\u0442\u0443\u043F\u0438\u043B \u0432
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441\u043E \u0441\u0432\u043E\u0438\u043C \u0431\u044B\u0432\u0448\u0438\u043C
    \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u043C \u0420\u0438\u0447\u0430\u0440\u0434\u043E\u043C
    \u0422\u0435\u0439\u043B\u043E\u0440\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0435
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.
    \u0418\u0445 \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442
    \u0431\u044B\u043B \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D
    \u0432 \u043C\u0430\u0435 1995 \u0433\u043E\u0434\u0430 \u0432 \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u043E\u043C
    \u0436\u0443\u0440\u043D\u0430\u043B\u0435 *Annals of Mathematics*. \u0414\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E \u0438\u0437 \u0434\u0432\u0443\u0445
    \u0441\u0442\u0430\u0442\u0435\u0439: \u043E\u0434\u043D\u0430 \u0431\u044B\u043B\u0430
    \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430 \u0423\u0430\u0439\u043B\u0441\u043E\u043C
    \u0435\u0434\u0438\u043D\u043E\u043B\u0438\u0447\u043D\u043E, \u0430 \u0432\u0442\u043E\u0440\u0430\u044F
    \u2014 \u0432 \u0441\u043E\u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u0435
    \u0441 \u0422\u0435\u0439\u043B\u043E\u0440\u043E\u043C.  \u0422\u0430\u043A
    \u043C\u0435\u0447\u0442\u0430 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u043D\u0435\u0433\u043E
    \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0430 \u0441\u0442\u0430\u043B\u0430
    \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E.  ### \U0001F3C6
    \u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435, \u043D\u0430\u0433\u0440\u0430\u0434\u044B
