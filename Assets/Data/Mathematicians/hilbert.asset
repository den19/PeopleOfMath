    \u0413\u0443\u0440\u0432\u0438\u0446\u0435\u043c \u043e\u043d\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u00ab\u043a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u0438\u0439
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u00bb \u043c\u043e\u043b\u043e\u0434\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u0447\u044c\u0438 \u0434\u043e\u043b\u0433\u0438\u0435
    \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438 \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0438 \u0441\u0442\u0430\u043b\u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c\u0438.
    \u041f\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0441\u043c\u0435\u0440\u0442\u044c \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0432 1909 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u043c \u0443\u0434\u0430\u0440\u043e\u043c.\n\n\U0001F30D
    \u0416\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b
    \u0438 \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0431\u044b\u043b \u043a\u0440\u0435\u0449\u0435\u043d \u0438 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d
    \u043a\u0430\u043a \u043a\u0430\u043b\u044c\u0432\u0438\u043d\u0438\u0441\u0442 \u0432 \u041f\u0440\u0443\u0441\u0441\u043a\u043e\u0439
    \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438,
    \u043e\u0434\u043d\u0430\u043a\u043e \u0432 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u043e\u043d \u043e\u0442\u043e\u0448\u0435\u043b \u043e\u0442
    \u0440\u0435\u043b\u0438\u0433\u0438\u0438 \u0438 \u0441\u0442\u0430\u043b \u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u043e\u043c.
    \u0415\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u043e\u0442\u0440\u0430\u0436\u0430\u043b\u0438
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0432\u0435\u0440\u0443 \u0432 \u0441\u0438\u043b\u0443
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u0443\u043c\u0430
    \u0438 \u043d\u0430\u0443\u043a\u0438. \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u0441\u0442\u0438\u043d\u0430 \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043e\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u0411\u043e\u0433\u0430 \u0438\u043b\u0438 \u043a\u0430\u043a\u0438\u0445-\u043b\u0438\u0431\u043e
    \u0430\u043f\u0440\u0438\u043e\u0440\u043d\u044b\u0445 \u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0438\u0439.
    \u0412 \u044d\u0442\u043e\u043c \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u0430
    \u0435\u0433\u043e \u0444\u0440\u0430\u0437\u0430, \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441\u0435\u043d\u043d\u0430\u044f
    \u0432 \u0437\u0430\u0449\u0438\u0442\u0443 \u0413\u0430\u043b\u0438\u043b\u0435\u044f:
    \u00ab\u0422\u043e\u043b\u044c\u043a\u043e \u0438\u0434\u0438\u043e\u0442 \u043c\u043e\u0433
    \u0431\u044b \u043f\u043e\u0432\u0435\u0440\u0438\u0442\u044c, \u0447\u0442\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0438\u0441\u0442\u0438\u043d\u0435 \u043d\u0443\u0436\u0435\u043d \u043c\u0443\u0447\u0435\u043d\u0438\u043a;
    \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e
    \u0432 \u0440\u0435\u043b\u0438\u0433\u0438\u0438, \u043d\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0441\u0435\u0431\u044f \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c\u00bb.\n\n\U0001F48E
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0431\u044b\u043b\u0438 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u043f\u043e\u0442\u0435\u0440\u044f\u043c\u0438,
    \u043d\u043e \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439 \u043f\u0440\u0438\u0445\u043e\u0434\u0430
    \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432 \u043a \u0432\u043b\u0430\u0441\u0442\u0438,
    \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0432\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435.
    \u041e\u043d \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0432\u0435\u0440\u0435\u043d \u0441\u0432\u043e\u0438\u043c \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c,
    \u0438 \u0435\u0433\u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044f\u044f \u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u044c
    \u043d\u0430\u0448\u043b\u0430 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0432
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c \u0434\u0435\u0432\u0438\u0437\u0435
    \u00abWir m\u00fcssen wissen. Wir werden wissen\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0442\u0435\u043f\u0435\u0440\u044c \u0432\u044b\u0441\u0435\u0447\u0435\u043d \u043d\u0430
    \u0435\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0435."
  personalLifeEn: "David Gilbert's personal life, unlike his public triumphs, was filled with both deep affection and friendship and the tragedy that he and his family had endured in the shadow of his grand scientific career.\n\n==Personal life==In 1892, Gilbert married Kéte Jerosch, 1864–1945, the daughter of a Königsberg trader, and described her as being of a direct and independent mind, which was very much in keeping with the nature of Gilbert himself.\n\nThe father and family tragedy of Franz's son became the main personal tragedy of the Gilbert family. The boy suffered from a mental illness that was never diagnosed in life. His condition and mental abilities were a severe blow to his father, who was unable to help the child. When Franz was placed in a psychiatric clinic, Gilbert said a bitter phrase: \"From now on I must believe that I have no son.\"This decision and its consequences have caused a great deal of suffering to Keith, and, paradoxically, Gilbert may have been humorous about his son's abilities, and he often joked that French mathematical talents inherited from his mother and \"all the rest\" from him.\n\n♪ Friendship as a pillar of great importance in Gilbert's personal life was played by friendships. His main and strongest friendship was friendship with Herman Minkowski. They met at Königsberg University, and their relationship was called \"the best and most faithful friendship.\" Together with Adolf Gurwitz, they formed the famous \"Königsberg Triangle\" of young mathematicians, whose long walks and scientific discussions became legendary.The premature death of Minkovsky in 1909 was a major blow to Gilbert.\n\n♪ Gilbert's life principles and worldview were baptized and raised as a Calvinist in the Prussian Evangelic Church, but in later years he turned away from religion and became an agnostic, his views reflected deep faith in the power of the human mind and science, and he believed that the mathematical truth was independent of God's existence or any a priori assumptions.In this context, his phrase in the defence of Galileo is illustrative: \"Only an idiot could believe that scientific truth needs a martyr; it may be necessary in religion, but scientific results prove themselves over time.\"\n\nIn the last years of Gilbert's life, he has been darkened not only by personal losses, but also by the tragedy of the Nazis' coming to power, which destroyed the Gottingen Mathematical School, and he has remained faithful to his principles, and his inner endurance is reflected in the famous motto \"Wir müssen Wissen. Wirden Wissen\", which is now planted on his grave."
  shortBioRu: "\u0414\u0430\u0432\u0438\u0434 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 (1862\u20131943)
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438,
    \u0447\u044c\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u0445\u0432\u0430\u0442\u0438\u043b\u0430
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0441\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430
    \u043f\u0443\u0442\u0438 \u0435\u0451 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043d\u0430
    XX \u0432\u0435\u043a. \u0415\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c-\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u043e\u043c\u00bb
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c \u043c\u0438\u0440\u043e\u0432\u044b\u043c
    \u043b\u0438\u0434\u0435\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 1910\u20131920-\u0435 \u0433\u043e\u0434\u044b. \u041f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u0438 \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f.\n\n\U0001F4DC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    (1862\u20131895) \u0414\u0430\u0432\u0438\u0434 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 23 \u044f\u043d\u0432\u0430\u0440\u044f 1862
    \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0412\u0435\u043b\u0430\u0443
    (\u043d\u044b\u043d\u0435 \u0417\u043d\u0430\u043c\u0435\u043d\u0441\u043a, \u041a\u0430\u043b\u0438\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u0430\u044f
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c) \u0438\u043b\u0438 \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041e\u0442\u0442\u043e \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442,
    \u0431\u044b\u043b \u0441\u0443\u0434\u044c\u0451\u0439, \u0430 \u043c\u0430\u0442\u044c,
    \u041c\u0430\u0440\u0438\u044f \u0422\u0435\u0440\u0435\u0437\u0430, \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0433\u0434\u0435
    \u0435\u0433\u043e \u043e\u0434\u043d\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u0430\u043c\u0438
    \u0438 \u0431\u043b\u0438\u0437\u043a\u0438\u043c\u0438 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438
    \u0441\u0442\u0430\u043b\u0438 \u0410\u0434\u043e\u043b\u044c\u0444 \u0413\u0443\u0440\u0432\u0438\u0446
    \u0438 \u0413\u0435\u0440\u043c\u0430\u043d \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439.
    \u0418\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438\u00bb, \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d\u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b\u0438
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b,
    \u0441\u0442\u0430\u043b\u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c\u0438,
    \u0438 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u043f\u043e\u0437\u0436\u0435 \u0441\u0434\u0435\u043b\u0430\u043b
    \u0438\u0445 \u0447\u0430\u0441\u0442\u044c\u044e \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430. \u0412 1885 \u0433\u043e\u0434\u0443 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e, \u0430 \u043f\u043e\u0441\u043b\u0435
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u043f\u0440\u043e\u0439\u0434\u044f
    \u043f\u0443\u0442\u044c \u043e\u0442 \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u0430
    \u0434\u043e \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430.\n\n\U0001F680
    \u041f\u0443\u0442\u044c \u043a \u0441\u043b\u0430\u0432\u0435 \u0438 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 (1895\u20131930) \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c \u0441\u0442\u0430\u043b 1895 \u0433\u043e\u0434,
    \u043a\u043e\u0433\u0434\u0430 \u043f\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e
    \u0424\u0435\u043b\u0438\u043a\u0441\u0430 \u041a\u043b\u0435\u0439\u043d\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0437\u0430\u043d\u044f\u043b \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u2014 \u0442\u0443 \u0441\u0430\u043c\u0443\u044e, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0440\u0430\u043d\u0435\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u041a\u0430\u0440\u043b
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445 \u0413\u0430\u0443\u0441\u0441 \u0438 \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434
    \u0420\u0438\u043c\u0430\u043d. \u041e\u043d \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443 35 \u043b\u0435\u0442.
    \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c
    \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0447\u0430\u0441\u0442\u043e \u0441\u043c\u0435\u043d\u044f\u043b\u0438
    \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430, \u0437\u043d\u0430\u043c\u0435\u043d\u0443\u044f
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u043a \u043d\u043e\u0432\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:
    - \u0422\u0435\u043e\u0440\u0438\u044f \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432:
    \u0411\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0440\u0435\u0448\u0438\u043b \u00ab\u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443
    \u0413\u043e\u0440\u0434\u0430\u043d\u0430\u00bb, \u0434\u043e\u043a\u0430\u0437\u0430\u0432
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438
    \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0431\u0430\u0437\u0438\u0441\u0430
    \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432. \u042d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u043e \u043d\u0435\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c,
    \u0447\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u0443
    \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u041f\u043e\u043b\u044f \u0413\u043e\u0440\u0434\u0430\u043d\u0430,
    \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u0432\u0448\u0435\u0433\u043e: \u00ab\u042d\u0442\u043e
    \u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u042d\u0442\u043e
    \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f!\u00bb. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043f\u043e\u0437\u0436\u0435 \u0413\u043e\u0440\u0434\u0430\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u043b
    \u0435\u0433\u043e \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c. - \u0422\u0435\u043e\u0440\u0438\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0447\u0438\u0441\u0435\u043b:
    \u0412 1897 \u0433\u043e\u0434\u0443 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u00ab\u041e\u0442\u0447\u0451\u0442
    \u043e \u0447\u0438\u0441\u043b\u0430\u0445\u00bb (Zahlbericht), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u0441\u0435 \u0437\u043d\u0430\u043d\u0438\u044f \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438. - \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438: \u0412 1899 \u0433\u043e\u0434\u0443
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u00ab\u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb, \u0433\u0434\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043d\u043e\u0432\u0443\u044e, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0430\u043a\u0441\u0438\u043e\u043c \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0439 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445
    \u043f\u043e\u043d\u044f\u0442\u0438\u0439, \u0442\u0440\u0430\u043a\u0442\u0443\u044f \u0430\u043a\u0441\u0438\u043e\u043c\u044b
    \u043a\u0430\u043a \u043d\u0435\u044f\u0432\u043d\u044b\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0438. - \u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0438 \u00ab\u0433\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432\u043e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e\u00bb: \u0412 1910-\u0445
    \u0433\u043e\u0434\u0430\u0445 \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0438 \u0432\u0432\u0451\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u0437\u043e\u0432\u0443\u0442 \u0433\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432\u044b\u043c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e\u043c. \u042d\u0442\u0430
    \u0442\u0435\u043e\u0440\u0438\u044f \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438. - 23 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b:
    \u0412 1900 \u0433\u043e\u0434\u0443 \u043d\u0430 \u0412\u0442\u043e\u0440\u043e\u043c \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u043c
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0440\u0435\u0447\u044c \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0441\u043f\u0438\u0441\u043e\u043a \u0438\u0437 23 \u043d\u0435\u0440\u0435\u0448\u0451\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435,
    \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043d\u0430 \u0433\u0440\u044f\u0434\u0443\u0449\u0438\u0439 \u0432\u0435\u043a. \u042d\u0442\u043e\u0442
    \u0441\u043f\u0438\u0441\u043e\u043a \u0441\u0442\u0430\u043b \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0439
    \u00ab\u0434\u043e\u0440\u043e\u0436\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0439\u00bb
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0432\u0441\u0435\u0433\u043e
    \u043c\u0438\u0440\u0430. > \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430
    \u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u0435\u043c\u0443 \u0432 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438
    \u0432\u044b\u0432\u043e\u0434\u0430 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F48E
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 - \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430: \u0412 1920-\u0435 \u0433\u043e\u0434\u044b
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u043f\u043e \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043e\u0442 \u043a\u0440\u0438\u0437\u0438\u0441\u0430,
    \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043c\u0438
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. \u0421\u0443\u0442\u044c
    \u0435\u0451 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c \u0432 \u043f\u043e\u043b\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0432\u0441\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c
    \u00ab\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u043c\u00bb (\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c
    \u0438 \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u044b\u043c) \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u0438.
    - \u041a\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043d\u0430\u0434\u0435\u0436\u0434
    \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0413\u0451\u0434\u0435\u043b\u044f:
    \u0412 1931 \u0433\u043e\u0434\u0443 \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u0430\u0432\u0441\u0442\u0440\u0438\u0439\u0441\u043a\u0438\u0439
    \u043b\u043e\u0433\u0438\u043a \u041a\u0443\u0440\u0442 \u0413\u0451\u0434\u0435\u043b\u044c
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435. \u041e\u043d\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438,
    \u0447\u0442\u043e \u0432 \u043b\u044e\u0431\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0439
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u043d\u0438 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c.
    \u042d\u0442\u043e \u043d\u0430\u043d\u0435\u0441\u043b\u043e \u0441\u043e\u043a\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0443\u0434\u0430\u0440 \u043f\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0446\u0435\u043b\u0438
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430.
    - \u042d\u043f\u043e\u0445\u0430 \u043d\u0430\u0446\u0438\u0437\u043c\u0430: \u041f\u043e\u0441\u043b\u0435
    \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u0432 1933 \u0433\u043e\u0434\u0443 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d,
    \u0431\u044b\u0432\u0448\u0438\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0446\u0435\u043d\u0442\u0440
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0431\u044b\u043b \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d.
    \u041c\u043d\u043e\u0433\u0438\u0435 \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0438
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u0431\u044b\u043b\u0438 \u0443\u0432\u043e\u043b\u0435\u043d\u044b
    \u0438 \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0438. \u041a\u043e\u0433\u0434\u0430
    \u043c\u0438\u043d\u0438\u0441\u0442\u0440 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0420\u0443\u0441\u0442 \u0441\u043f\u0440\u043e\u0441\u0438\u043b
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430: \u00ab\u041a\u0430\u043a \u0442\u0435\u043f\u0435\u0440\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435,
    \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u043e\u043d\u0430
    \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u043e\u0442 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0433\u043e
    \u0432\u043b\u0438\u044f\u043d\u0438\u044f?\u00bb, \u0442\u043e\u0442 \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435?
    \u0415\u0451 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0442\u00bb. \u0415\u0433\u043e
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u044b \u0432 1943 \u0433\u043e\u0434\u0443 \u043f\u043e\u0441\u0435\u0442\u0438\u043b\u0438
    \u043b\u0438\u0448\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a.
    > \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0434\u0435\u0432\u0438\u0437:
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0432\u0441\u0435 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u044f,
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b
    \u043d\u0435\u043f\u043e\u043a\u043e\u043b\u0435\u0431\u0438\u043c\u0443\u044e \u0432\u0435\u0440\u0443
    \u0432 \u0441\u0438\u043b\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u0430\u0437\u0443\u043c\u0430. \u0415\u0433\u043e \u0434\u0435\u0432\u0438\u0437\u043e\u043c,
    \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u043d\u044b\u043c \u043d\u0430 \u043c\u043e\u0433\u0438\u043b\u0435,
    \u0441\u0442\u0430\u043b\u0438 \u0441\u043b\u043e\u0432\u0430: \u00abWir m\u00fcssen wissen.
    Wir werden wissen\u00bb (\u00ab\u041c\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0437\u043d\u0430\u0442\u044c.
    \u041c\u044b \u0431\u0443\u0434\u0435\u043c \u0437\u043d\u0430\u0442\u044c\u00bb)."
  shortBioEn: "David Gilbert (1862–1943) is one of the greatest mathematicians in history, whose work covered almost every field of discipline and defined its path to the 20th century, and was known as \"the universal mathematician\" and recognized world mathematician leader in the 1910's and 1920's.\n\n==Early life==David Gilbert was born on 23 January 1862 in Velau (now Znamensk, Kaliningrad region) or Koenigsberg, where his father, Otto Gilbert, was a judge, and his mother, Maria Teresa, was interested in philosophy and astronomy.Their joint \"mathematical walks\" during which they discussed scientific problems became legendary, and Gilbert later made them part of his teaching method. In 1885, Gilbert defended his Ph.D., and after completing his studies, he worked at the University of Koenigsberg, from a private professor to an ordinary professor.\n\nThe journey to fame and the Göttingen period (1895–1930) was a break in 1895, when, at the invitation of Felix Klein Gilbert, he took up the Department of Mathematics at the University of Göttingen, the same one that Carl Friedrich Gauss and Bernhard Riman had previously worked for.This period was a time of his greatest achievements, which often changed each other, marking Gilbert's transition to a new field of study: - Invariant theory: Brilliantly decided \"the Gordan problem\" by proving the fundamental theorem of the existence of the final base for any system of invariants. This evidence was unhelpful, which led to criticism by Paul Gordan, who said, \"This is not mathematics. This is theology!\"In 1897, Gordan published the monumental \"Report on Numbers\" (Zahlbericht), which became a classic work and systematized all knowledge in this field. \"Foundations of geometry: In 1899, he published \"Foundations of Geometry\", where he proposed a new, fully formal system of axiom of euclidic geometry.He was the first to abandon the substantive definitions of basic concepts, treating axioms as implicit definitions, and this work became a model for all subsequent axiomatics. - Functional analysis and \"hilberto space\": In the 1910s, he created the theory of integrated equations and introduced the notion of infinite space, which would later be called a Gilbert space, which became the basis for modern quantum mechanics.- 23 issues: In 1900, Gilbert gave a famous speech at the Second International Congress of Mathematicians in Paris and presented a list of 23 outstanding issues that he believed would determine the evolution of mathematics for the coming century. This list was a road map for mathematicians around the world. > During this period, he also consulted Albert Einstein and assisted him in finalizing the equations of general relativity.\n\n===Career===In the 1920s, Gilbert focused on the logical basis of mathematics. He developed a program to save mathematics from the crisis caused by the paradoxes of the theory of multiples, which consisted of a complete formalization of all mathematics, followed by \"final\" (final and visual) proof of consistency.In 1931, Kurt Godel's young Austrian logic published its famous theories of incompleteness, which showed that in any fairly complex formal system there were allegations that could not be proved or denied, and that this struck a devastating blow to the main purpose of Gilbert's program.- The Nazi era: After the Nazis came to power in 1933, Göttingen, a former world math center, was destroyed. Many of Gilbert's colleagues and students were dismissed and emigrated. When the Minister of Education, Bernhard Ruth, asked Gilbert, \"How is math in Göttingen now after she was freed from Jewish influence?\", he replied, \"Mathematics in Göttingen? She is no longer there.\" His funeral in 1943 was attended by only a few people.> Celebrity motto: Despite all the disappointments, Gilbert maintained unflinching faith in the power of the human mind. His motto on the grave was \"Wir müssen wissen. Wirden wissen\" (\"We must know. We will know\")."
  interestingFactsRu: "\u0414\u0430\u0432\u0438\u0434 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0431\u044b\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u043d\u043e \u0438 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0441 \u044f\u0440\u043a\u0438\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c,
    \u0447\u0442\u043e \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438,
    \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0438\u0437 \u0440\u0430\u0437\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432.\n\n\U0001F9E0 \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0441\u0442\u044c \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d
    \u0432 \u0441\u0432\u043e\u0438 \u043c\u044b\u0441\u043b\u0438, \u0447\u0442\u043e \u0447\u0430\u0441\u0442\u043e
    \u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u043b \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0433\u043e
    \u0432\u043e\u043a\u0440\u0443\u0433, \u0447\u0442\u043e \u0441\u043b\u0443\u0436\u0438\u043b\u043e
    \u043f\u043e\u0432\u043e\u0434\u043e\u043c \u0434\u043b\u044f \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043a\u043e\u043c\u0438\u0447\u043d\u044b\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0439.
    \u0421\u043c\u0435\u043d\u0430 \u0440\u0443\u0431\u0430\u0448\u043a\u0438: \u041e\u0434\u043d\u0430\u0436\u0434\u044b,
    \u043a\u043e\u0433\u0434\u0430 \u0443 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432
    \u0441\u043e\u0431\u0440\u0430\u043b\u0438\u0441\u044c \u0433\u043e\u0441\u0442\u0438, \u0436\u0435\u043d\u0430
    \u041a\u0435\u0442\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0430, \u0447\u0442\u043e
    \u0414\u0430\u0432\u0438\u0434 \u043d\u0430\u0434\u0435\u043b \u043d\u0435\u0441\u0432\u0435\u0436\u0443\u044e
    \u0440\u0443\u0431\u0430\u0448\u043a\u0443. \u041e\u043d\u0430 \u0432\u0435\u043b\u0435\u043b\u0430
    \u0435\u043c\u0443: \u00ab\u0414\u0430\u0432\u0438\u0434, \u0441\u0442\u0443\u043f\u0430\u0439
    \u0432\u043d\u0438\u0437 \u0438 \u043d\u0430\u0434\u0435\u043d\u044c \u0434\u0440\u0443\u0433\u0443\u044e
    \u0440\u0443\u0431\u0430\u0448\u043a\u0443\u00bb. \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043f\u043e\u0441\u043b\u0443\u0448\u043d\u043e \u0443\u0448\u0435\u043b \u0432 \u0441\u043f\u0430\u043b\u044c\u043d\u044e.
    \u041a\u043e\u0433\u0434\u0430 \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0441\u044f\u0442\u044c
    \u043c\u0438\u043d\u0443\u0442 \u0436\u0435\u043d\u0430, \u043e\u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0435\u043d\u043d\u0430\u044f
    \u0435\u0433\u043e \u0434\u043e\u043b\u0433\u0438\u043c \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043c,
    \u043f\u043e\u0448\u043b\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0435\u0433\u043e,
    \u043e\u043d\u0430 \u043d\u0430\u0448\u043b\u0430 \u043c\u0443\u0436\u0430... \u0431\u0435\u0437\u043c\u044f\u0442\u0435\u0436\u043d\u043e
    \u0441\u043f\u044f\u0449\u0438\u043c. \u0420\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u044b\u0439
    \u0443\u0447\u0435\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434\u0438\u0447\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0441\u044f \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0438 \u043b\u0435\u0433 \u0441\u043f\u0430\u0442\u044c, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u044f
    \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0447\u0438\u0441\u0442\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438.
    \u0413\u043e\u0441\u0442\u044c \u0432 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u0434\u043e\u043c\u0435: \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043d\u043e\u0432\u043e\u0433\u043e
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 \u043a\u0430\u0444\u0435\u0434\u0440\u044b
    \u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u0432 \u0434\u043e\u043c\u0435 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430.
    \u0413\u043e\u0441\u0442\u044c \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043a\u0440\u0430\u0439\u043d\u0435
    \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0447\u0438\u0432\u044b\u043c \u0438 \u0438\u0437\u0440\u044f\u0434\u043d\u043e
    \u0443\u0442\u043e\u043c\u0438\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430.
    \u0427\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0442\u044c
    \u0437\u0430\u0442\u044f\u043d\u0443\u0432\u0448\u0438\u0439\u0441\u044f \u0432\u0438\u0437\u0438\u0442,
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0432\u0441\u0442\u0430\u043b, \u043d\u0430\u0434\u0435\u043b
    \u0446\u0438\u043b\u0438\u043d\u0434\u0440 \u0433\u043e\u0441\u0442\u044f, \u0442\u0440\u043e\u043d\u0443\u043b
    \u0436\u0435\u043d\u0443 \u0437\u0430 \u0440\u0443\u043a\u0443 \u0438 \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u0414\u043e\u0440\u043e\u0433\u0430\u044f, \u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043c\u044b \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c
    \u0443\u0432\u0430\u0436\u0430\u0435\u043c\u043e\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0443\u00bb.
    \u0421 \u044d\u0442\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u043e\u043d
    \u0432\u044b\u0448\u0435\u043b \u0438\u0437 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0434\u043e\u043c\u0430, \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u0438 \u0433\u043e\u0441\u0442\u044f,
    \u0438 \u0436\u0435\u043d\u0443 \u0432 \u043f\u043e\u043b\u043d\u043e\u043c \u043d\u0435\u0434\u043e\u0443\u043c\u0435\u043d\u0438\u0438.
    \u041f\u043e\u0440\u0432\u0430\u043d\u043d\u044b\u0435 \u0431\u0440\u044e\u043a\u0438: \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u043f\u043e\u044f\u0432\u043b\u044f\u043b\u0441\u044f
    \u0432 \u043f\u043e\u0440\u0432\u0430\u043d\u043d\u044b\u0445 \u0431\u0440\u044e\u043a\u0430\u0445,
    \u0447\u0442\u043e \u0441\u043c\u0443\u0449\u0430\u043b\u043e \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433.
    \u0417\u0430\u0434\u0430\u0447\u0443 \u0434\u0435\u043b\u0438\u043a\u0430\u0442\u043d\u043e
    \u0441\u043e\u043e\u0431\u0449\u0438\u0442\u044c \u0435\u043c\u0443 \u043e\u0431 \u044d\u0442\u043e\u043c
    \u0432\u043e\u0437\u043b\u043e\u0436\u0438\u043b\u0438 \u043d\u0430 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0430
    \u0420\u0438\u0445\u0430\u0440\u0434\u0430 \u041a\u0443\u0440\u0430\u043d\u0442\u0430. \u041a\u0443\u0440\u0430\u043d\u0442
    \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u043d\u0430 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0443, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043f\u0440\u043e\u0439\u0434\u044f \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u0440\u043e\u0441\u043b\u0438
    \u043a\u043e\u043b\u044e\u0447\u0438\u0445 \u043a\u0443\u0441\u0442\u043e\u0432, \u0438
    \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043f\u043e\u0440\u0432\u0430\u043b
    \u0431\u0440\u044e\u043a\u0438 \u043e\u0431 \u043e\u0434\u0438\u043d \u0438\u0437 \u043d\u0438\u0445.
    \u041d\u0430 \u044d\u0442\u043e \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u043d\u0435\u0432\u043e\u0437\u043c\u0443\u0442\u0438\u043c\u043e
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u0414\u0430 \u043d\u0435\u0442 \u0436\u0435,
    \u043e\u043d\u0438 \u0442\u0430\u043a\u0438\u0435 \u0443\u0436\u0435 \u043d\u0435 \u043e\u0434\u043d\u0443
    \u043d\u0435\u0434\u0435\u043b\u044e, \u0445\u043e\u0442\u044f \u043d\u0438\u043a\u0442\u043e
    \u044d\u0442\u043e\u0433\u043e \u0438 \u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u0435\u0442\u00bb.\n\n\U0001F4D0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043a\u0430\u043a \u043f\u043e\u044d\u0437\u0438\u044f
    (\u0438 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442) \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u043e\u0441\u043e\u0431\u044b\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430, \u043a\u043e\u0433\u0434\u0430 \u0440\u0435\u0447\u044c
    \u0437\u0430\u0445\u043e\u0434\u0438\u043b\u0430 \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0435. \u041e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0435,
    \u0441\u0442\u0430\u0432\u0448\u0435\u043c \u043f\u043e\u044d\u0442\u043e\u043c: \u041a\u043e\u0433\u0434\u0430
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b
    \u043f\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043d\u0430 \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u0445,
    \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u043e\u043d
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0430\u0442\u044c \u043f\u043e\u044d\u0442\u043e\u043c.
    \u0423\u0437\u043d\u0430\u0432 \u043e\u0431 \u044d\u0442\u043e\u043c, \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b: \u00ab\u041d\u0435 \u043c\u043e\u0433\u0443
    \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u044f \u0443\u0434\u0438\u0432\u043b\u0435\u043d.
    \u041c\u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b
    \u0441\u0442\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c\u00bb.
    \u042d\u0442\u043e\u0442 \u0430\u0444\u043e\u0440\u0438\u0437\u043c \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e
    \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0435\u0433\u043e \u0432\u0435\u0440\u0443
    \u0432 \u0442\u043e, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u0432\u044b\u0441\u0448\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430.
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0420\u0438\u043c\u0430\u043d\u0430 \u043d\u0430
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0430\u0445: \u0423 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0431\u044b\u043b \u0441\u0442\u0443\u0434\u0435\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0435\u043c\u0443 \u0440\u0430\u0431\u043e\u0442\u0443
    \u0441 \u043f\u0440\u0435\u0442\u0435\u043d\u0437\u0438\u0435\u0439 \u043d\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0420\u0438\u043c\u0430\u043d\u0430. \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043d\u0430\u0448\u0435\u043b \u0432 \u043d\u0435\u0439 \u043e\u0448\u0438\u0431\u043a\u0443,
    \u043d\u043e \u0431\u044b\u043b \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d \u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430. \u041d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439
    \u0433\u043e\u0434 \u0441\u0442\u0443\u0434\u0435\u043d\u0442 \u0443\u043c\u0435\u0440.
    \u041d\u0430 \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0430\u0445, \u0441\u0442\u043e\u044f
    \u043f\u043e\u0434 \u0434\u043e\u0436\u0434\u0435\u043c, \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441 \u0440\u0435\u0447\u044c. \u041e\u043d
    \u043d\u0430\u0447\u0430\u043b \u0441 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u044d\u0442\u043e
    \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f,
    \u043d\u043e \u0437\u0430\u0442\u0435\u043c \u0441 \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0437\u043c\u043e\u043c
    \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b: \u00ab\u0418 \u0432 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435, \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u044e
    \u043e\u0434\u043d\u043e\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0439
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439...\u00bb \u2014 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0438\u0437\u043b\u0430\u0433\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438\u0434\u0435\u044e \u043f\u0440\u044f\u043c\u043e \u043d\u0430\u0434 \u043c\u043e\u0433\u0438\u043b\u043e\u0439.\n\n\U0001F5E3\ufe0f
    \u041e\u0441\u0442\u0440\u044b\u0435 \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043e\u0442\u0432\u0435\u0442\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439
    \u043f\u0440\u044f\u043c\u043e\u0442\u043e\u0439 \u0438 \u0430\u0444\u043e\u0440\u0438\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e.
    \u041e\u0442\u0432\u0435\u0442 \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u043e\u043c\u0443
    \u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0443: \u041f\u043e\u0441\u043b\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0430
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432
    \u0432 1933 \u0433\u043e\u0434\u0443 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d: \u043c\u043d\u043e\u0433\u0438\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433-\u0435\u0432\u0440\u0435\u0435\u0432 \u0443\u0432\u043e\u043b\u0438\u043b\u0438
    \u0438 \u0432\u044b\u043d\u0443\u0434\u0438\u043b\u0438 \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043c\u0438\u043d\u0438\u0441\u0442\u0440 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0420\u0443\u0441\u0442 \u0441\u043f\u0440\u043e\u0441\u0438\u043b
    \u0443 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430: \u00ab\u041a\u0430\u043a
    \u0442\u0435\u043f\u0435\u0440\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435, \u043f\u043e\u0441\u043b\u0435
    \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u043e\u043d\u0430 \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u043e\u0442 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u044f?\u00bb
    \u041d\u0430 \u044d\u0442\u043e \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0443\u043d\u044b\u043b\u043e
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435? \u0415\u0451 \u0431\u043e\u043b\u044c\u0448\u0435
    \u043d\u0435\u0442\u00bb. \u00ab\u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u044d\u0442\u043e \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f\u00bb: \u0412 1888 \u0433\u043e\u0434\u0443
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u043e \u0431\u0430\u0437\u0438\u0441\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435,
    \u043d\u043e \u043d\u0435 \u0434\u0430\u0432\u0430\u043b\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u0430
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f. \u041f\u0430\u0443\u043b\u044c
    \u0413\u043e\u0440\u0434\u0430\u043d, \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u044d\u043a\u0441\u043f\u0435\u0440\u0442
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432,
    \u043d\u0435 \u043f\u0440\u0438\u043d\u044f\u043b \u0442\u0430\u043a\u043e\u0439 \u043f\u043e\u0434\u0445\u043e\u0434
    \u0438 \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b: \u00ab\u042d\u0442\u043e
    \u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u042d\u0442\u043e
    \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f!\u00bb. \u041f\u043e\u0437\u0436\u0435,
    \u043f\u0440\u0438\u0437\u043d\u0430\u0432 \u0441\u0438\u043b\u0443 \u043c\u0435\u0442\u043e\u0434\u0430
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430, \u0413\u043e\u0440\u0434\u0430\u043d
    \u0441\u043c\u044f\u0433\u0447\u0438\u043b\u0441\u044f \u0438 \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u042f \u0443\u0431\u0435\u0434\u0438\u043b\u0441\u044f, \u0447\u0442\u043e \u0434\u0430\u0436\u0435
    \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f \u0438\u043c\u0435\u0435\u0442 \u0441\u0432\u043e\u0438
    \u0437\u0430\u0441\u043b\u0443\u0433\u0438\u00bb.\n\n\U0001F48E \u041d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u044b\u0439
    \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u043c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0420\u0438\u043c\u0430\u043d\u0430 \u0447\u0435\u0440\u0435\u0437
    500 \u043b\u0435\u0442: \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u043d\u0430\u0437\u043e\u0439\u043b\u0438\u0432\u043e\u0433\u043e
    \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0430 \u043e \u0442\u043e\u043c,
    \u0447\u0442\u043e \u0431\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0441\u0434\u0435\u043b\u0430\u043b,
    \u0435\u0441\u043b\u0438 \u0431\u044b \u043e\u0436\u0438\u043b \u0447\u0435\u0440\u0435\u0437
    \u043f\u044f\u0442\u044c\u0441\u043e\u0442 \u043b\u0435\u0442, \u043e\u043d \u043d\u0435
    \u0437\u0430\u0434\u0443\u043c\u044b\u0432\u0430\u044f\u0441\u044c \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u042f \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u0431\u044b, \u043d\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u043b\u0438 \u043a\u0442\u043e-\u043d\u0438\u0431\u0443\u0434\u044c \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0420\u0438\u043c\u0430\u043d\u0430?\u00bb. \u042d\u0442\u0430 \u0444\u0440\u0430\u0437\u0430
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u043e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b \u044d\u0442\u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u0430\u0436\u043d\u044b\u0445
    \u0438 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u044b\u0445 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0414\u0435\u0432\u0438\u0437 \u043d\u0430 \u043c\u043e\u0433\u0438\u043b\u0435: \u0421\u0430\u043c\u044b\u043c
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0430\u0444\u043e\u0440\u0438\u0437\u043c\u043e\u043c
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u0441\u0442\u0430\u043b\u0438 \u0441\u043b\u043e\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043e\u043d \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b
    \u0441\u0432\u043e\u044e \u0440\u0435\u0447\u044c \u0432 1930 \u0433\u043e\u0434\u0443:
    \u00abWir m\u00fcssen wissen. Wir werden wissen\u00bb \u2014 \u00ab\u041c\u044b \u0434\u043e\u043b\u0436\u043d\u044b
    \u0437\u043d\u0430\u0442\u044c. \u041c\u044b \u0431\u0443\u0434\u0435\u043c \u0437\u043d\u0430\u0442\u044c\u00bb.
    \u042d\u0442\u0430 \u0444\u0440\u0430\u0437\u0430, \u0432\u044b\u0440\u0430\u0436\u0430\u044e\u0449\u0430\u044f
    \u0435\u0433\u043e \u043d\u0435\u043f\u043e\u043a\u043e\u043b\u0435\u0431\u0438\u043c\u0443\u044e
    \u0432\u0435\u0440\u0443 \u0432 \u0441\u0438\u043b\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u0430\u0437\u0443\u043c\u0430, \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430 \u043d\u0430
    \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u043e\u043c \u043a\u0430\u043c\u043d\u0435
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u042d\u0442\u0438
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0440\u0438\u0441\u0443\u044e\u0442 \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043a\u0430\u043a \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e,
    \u043d\u043e \u0438 \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u043c
    \u043c\u0438\u0440\u043e\u043c, \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u043d\u0435\u043f\u043e\u0432\u0442\u043e\u0440\u0438\u043c\u044b\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430."
  interestingFactsEn: "David Gilbert was not only one of the greatest mathematicians in history, but also a person with a bright personality, which produced many fascinating and funny stories, and these are the most interesting and interesting facts of his life, gathered from various sources.\n\n♪ Gilbert's genius in his mind was so much that he often failed to notice what was happening around him that he was causing many comedy situations. ♪ The change of shirts: One day, when the Gilberts had guests, Keith's wife noticed David wearing an incredible shirt, she told him to go downstairs and put on another shirt. ♪When the wife, concerned about his long absence, went to check on him, she found her husband... serenely asleep, and a dissipating scientist was systematically undressed and went to sleep, performing the team on an automatic basis. A guest in her own house was received at Gilbert's house one day by a new staff member, and the guest was extremely chatty and was very tired of the professor.In order to stop his long visit, Gilbert stood up, put on a guest's cylinder, touched his wife by his hand and said, \"Dear, I think we're holding a respected colleague.\" With that, he left his home, leaving both a guest and a wife in complete disbelief, and his pants were ripped off: Gilbert regularly appeared in ripped trousers, which embarrassed his colleagues.The Kurant invited Gilbert for a walk, who went through the bushes on purpose, and said that the professor probably ripped his pants off about one of them. Gilbert answered unsatisfiably, \"No, they've been like that for weeks, though no one's noticed it.\"\n\n* Mathematics as poetry (and vice versa) Gilbert had a special sense of humor when he was talking about mathematics and creativity. \"I can't say I'm surprised. I always thought he didn't have enough imagination to become a math teacher.\"This aphorism perfectly reflects his belief that mathematics is the highest form of creativity. The Riman hypothesis at the funeral: Gilbert had a student who presented him with a job claiming proof of the Riman hypothesis. Gilbert found a mistake in her, but was impressed by the depth of the approach. The student died next year. Gilbert delivered a speech at the funeral, standing in the rain.He began by saying that it was a big tragedy, but then enthusiastically said, \"In fact, let's look at the function of one complex variable...\", and he continued to express a mathematical idea right above the grave.\n\n♪ Gilbert's sharp words and answers were known for being direct and aphoristic: the Nazi minister's reply: After the Nazis took power in 1933, Göttingen University was virtually destroyed: many Jewish colleagues were fired and forced to emigrate.The education minister Bernhard Ruth once asked Gilbert: \"How is math in Göttingen now after she was freed from Jewish influence?\" Gilbert said, \"Mathematics in Göttingen? She is no longer there.\" \"It's not math, it's theology: In 1888, Gilbert proved his famous theorem about the base, which claimed existence but did not provide a way to build it.Paul Gordan, a leading expert on invariant theory, did not accept this approach and said, \"It's not math. It's theology!\" Later, after acknowledging the strength of Gilbert's method, Gordan softened and said, \"I've seen that even theology has merit.\"\n\n♪ The unchanging optimism and legacy of the Riman Hypothesis 500 years later: To a question from an obnoxious journalist about what Gilbert would have done if he had survived 500 years later, he answered without thinking: \"I would ask if anyone had proved the Riman hypothesis.\" This phrase shows that he considered this problem to be one of the most important and long-term problems in mathematics.The motto on the grave: Gilbert's most famous aphorism was the words that ended his speech in 1930: \"Wir müssen Wissen. Wirden Wissen\" — \"We must know.\" This phrase, expressing his unflinching faith in the power of the human mind, is inscribed on his tombstone in Göttingen.These stories paint a portrait of Gilbert not only as a genius scientist, but also as a man with a vast inner world, deep humanity and a unique sense of humor."
