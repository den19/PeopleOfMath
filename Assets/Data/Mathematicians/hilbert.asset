  achievementsRu: "\u0411\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u0432\u043a\u043b\u0430\u0434
    \u0414\u0430\u0432\u0438\u0434\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0431\u0448\u0438\u0440\u0435\u043d \u0438 \u0433\u043b\u0443\u0431\u043e\u043a,
    \u0447\u0442\u043e \u0435\u0433\u043e \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u044e\u0442
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445
    \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432-\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u043e\u0432.
    \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0430\u043b
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u2014 \u043e\u043d
    \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u0446\u0435\u043b\u044b\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f,
    \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0432\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u043b
    \u043f\u0443\u0442\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f \u0432\u043f\u0435\u0440\u0435\u0434.
    \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u043c\u043e\u0436\u043d\u043e
    \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u0438\u0442\u044c \u043e\u0442 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0434\u043e \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438. \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u043f\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c \u043d\u0430\u0443\u043a\u0438.\n\n\U0001F4D0
    \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0412 1899 \u0433\u043e\u0434\u0443 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0439
    \u0442\u0440\u0443\u0434 \u00ab\u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb
    (Grundlagen der Geometrie), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0438
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0432 \u0446\u0435\u043b\u043e\u043c. \u041d\u043e\u0432\u044b\u0439
    \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0430\u043a\u0441\u0438\u043e\u043c\u044b:
    \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442 \u043f\u043e\u043f\u044b\u0442\u043e\u043a
    \u0434\u0430\u0432\u0430\u0442\u044c \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f\u043c (\u0442\u043e\u0447\u043a\u0430, \u043f\u0440\u044f\u043c\u0430\u044f,
    \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u044c). \u0414\u043b\u044f \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u2014 \u044d\u0442\u043e \u043d\u0435 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u0435
    \u0438\u0441\u0442\u0438\u043d\u044b, \u0430 \u043d\u0435\u044f\u0432\u043d\u044b\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f, \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f, \u043d\u0430\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u0435
    \u043d\u0430 \u044d\u0442\u0438 \u043f\u043e\u043d\u044f\u0442\u0438\u044f. \u042d\u0442\u043e
    \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e \u0432\u043c\u0435\u0441\u0442\u043e
    \u00ab\u0442\u043e\u0447\u043a\u0430 \u2014 \u044d\u0442\u043e \u0442\u043e, \u0447\u0442\u043e
    \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0447\u0430\u0441\u0442\u0435\u0439\u00bb,
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0430\u043a\u0441\u0438\u043e\u043c\u0443
    \u00ab\u0447\u0435\u0440\u0435\u0437 \u043b\u044e\u0431\u044b\u0435 \u0434\u0432\u0435 \u0442\u043e\u0447\u043a\u0438
    \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0440\u043e\u0432\u043d\u043e
    \u043e\u0434\u043d\u0443 \u043f\u0440\u044f\u043c\u0443\u044e\u00bb. \u041f\u043e\u043b\u043d\u043e\u0442\u0430
    \u0438 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c:
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0434\u0430\u043b \u043f\u043e\u043b\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0430\u043a\u0441\u0438\u043e\u043c \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438, \u0447\u0442\u043e \u043d\u0435
    \u043c\u0435\u043d\u0435\u0435 \u0432\u0430\u0436\u043d\u043e, \u0441\u0442\u0440\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0438\u0445 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u0438 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0434\u0440\u0443\u0433
    \u043e\u0442 \u0434\u0440\u0443\u0433\u0430. \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e
    \u043e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0440\u044f\u0434 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u0445
    \u043c\u043e\u0434\u0435\u043b\u0435\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c),
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0445, \u0447\u0442\u043e
    \u043e\u0434\u043d\u0443 \u0430\u043a\u0441\u0438\u043e\u043c\u0443 \u043d\u0435\u043b\u044c\u0437\u044f
    \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445.
    \u041f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430\u043b\u0438\u0437\u043c\u0430:
    \u0415\u0433\u043e \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c, \u0447\u0442\u043e,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b
    \u0438\u0434\u0435\u0438 \u043c\u0430\u0448\u0438\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0433\u0434\u0435 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u044f\u0446\u0438\u0438
    \u0441 \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438 \u043c\u043e\u0433\u0443\u0442
    \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c\u0441\u044f \u0431\u0435\u0437 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f
    \u0438\u0445 \u00ab\u0441\u043c\u044b\u0441\u043b\u0430\u00bb.\n\n\U0001F9EE \u0422\u0435\u043e\u0440\u0438\u044f
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0447\u0438\u0441\u043b\u0430 \u041d\u0430\u0447\u0430\u043b\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0438 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u0431\u044b\u043b\u043e
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u2014 \u043e\u0431\u043b\u0430\u0441\u0442\u0438,
    \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0435\u0439 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u043e\u0440\u043c,
    \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0449\u0438\u0435\u0441\u044f \u043f\u0440\u0438
    \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u0445.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    \u0431\u0430\u0437\u0438\u0441\u0430: \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0437\u0434\u0435\u0441\u044c
    \u0441\u0442\u0430\u043b\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u00ab\u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b\u00bb
    \u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e
    \u0431\u0430\u0437\u0438\u0441\u0430 \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432. \u042d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u043e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u043c,
    \u043d\u043e \u043d\u0435\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c:
    \u043e\u043d\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435,
    \u043d\u043e \u043d\u0435 \u0434\u0430\u0432\u0430\u043b\u043e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430
    \u0434\u043b\u044f \u0435\u0433\u043e \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f.
    \u042d\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u0443
    \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u041f\u043e\u043b\u044f \u0413\u043e\u0440\u0434\u0430\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b: \u00ab\u042d\u0442\u043e \u043d\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u0430 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f!\u00bb
    \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e\u0437\u0436\u0435 \u043e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u043b
    \u0437\u043d\u0430\u0447\u0438\u043c\u043e\u0441\u0442\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430.
    \u00ab\u041e\u0442\u0447\u0451\u0442 \u043e \u0447\u0438\u0441\u043b\u0430\u0445\u00bb (Zahlbericht):
    \u0412 1897 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0447\u0438\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u0441\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043d\u0430 \u0442\u043e\u0442
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0437\u043d\u0430\u043d\u0438\u044f \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438 \u0441\u0442\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u043d\u0430 \u043c\u043d\u043e\u0433\u0438\u0435 \u0433\u043e\u0434\u044b.\n\n\U0001F4CA
    \u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0438 \u00ab\u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e\u00bb
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 XX \u0432\u0435\u043a\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0441\u044f \u043a \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    \u0418\u0442\u043e\u0433\u043e\u043c \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u0441\u0442\u0430\u043b\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043d\u043e\u0432\u043e\u0433\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u00ab\u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u00bb:
    \u0420\u0430\u0431\u043e\u0442\u0430\u044f \u0441 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c\u0438, \u043e\u043d \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430, \u0433\u0434\u0435
    \u0442\u043e\u0447\u043a\u0438 \u2014 \u044d\u0442\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u043c. \u042d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u043e\u0435 \u043f\u043e\u0437\u0436\u0435 \u0433\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432\u044b\u043c,
    \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438
    \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.
    \u0421\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f:
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u043b\u044f \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0445
    \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0432 \u0433\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432\u043e\u043c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435, \u0447\u0442\u043e
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u00ab\u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u00bb \u0438 \u00ab\u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438\u00bb \u0434\u043b\u044f \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432.
    \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0412\u0430\u0440\u0438\u043d\u0433\u0430: \u0412 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443
    \u0412\u0430\u0440\u0438\u043d\u0433\u0430, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0443\u044e,
    \u0447\u0442\u043e \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    `n` \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0442\u0430\u043a\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e `g(n)`, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435
    \u0446\u0435\u043b\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043a\u0430\u043a \u0441\u0443\u043c\u043c\u0443 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435
    \u0447\u0435\u043c `g(n)` \u0441\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u0445, \u043a\u0430\u0436\u0434\u043e\u0435
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    `n`-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e \u0434\u0440\u0443\u0433\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430.\n\n\u269b\ufe0f \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0444\u0438\u0437\u0438\u043a\u0430, \u043a\u0430\u043a \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f,
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0430
    \u043d\u0430 \u0441\u0442\u0440\u043e\u0433\u043e\u0439 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u0441\u043d\u043e\u0432\u0435. \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0415\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0444\u0438\u0437\u0438\u043a\u0435
    \u0431\u044b\u043b \u043d\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u043c.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 \u043d\u0430\u0434 \u043e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430 \u2014 \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u0442\u0435\u043d\u0437\u043e\u0440\u043d\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430.
    \u0410\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u0444\u0438\u0437\u0438\u043a\u0438:
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0440\u0438\u0437\u044b\u0432\u0430\u043b
    \u043a \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0432\u0441\u0435\u0439 \u0444\u0438\u0437\u0438\u043a\u0438, \u0447\u0442\u043e \u043d\u0430\u0448\u043b\u043e
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0432 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    6-\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435. \u0425\u043e\u0442\u044f \u043f\u043e\u043b\u043d\u0430\u044f
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u0432\u0441\u0435\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u043d\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0430, \u0435\u0433\u043e
    \u043f\u0440\u0438\u0437\u044b\u0432 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b
    \u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0431\u0430\u0437 \u0434\u043b\u044f \u0442\u0435\u0440\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438,
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u0430 \u043f\u043e\u0437\u0436\u0435 \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 (\u0414\u0436\u043e\u043d \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d) \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    (\u0410\u043d\u0434\u0440\u0435\u0439 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432).\n\n\U0001F4A1
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0421\u0430\u043c\u043e\u0439 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0439,
    \u0445\u043e\u0442\u044c \u0438 \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c
    \u0438\u0442\u043e\u0433\u0435 \u043d\u0435\u0443\u0434\u0430\u0432\u0448\u0435\u0439\u0441\u044f,
    \u0446\u0435\u043b\u044c\u044e \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u0431\u044b\u043b\u0430
    \u0437\u0430\u0449\u0438\u0442\u0430 \u0432\u0441\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043e\u0442 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0439.
    \u0412 1920-\u0435 \u0433\u043e\u0434\u044b \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443.
    \u0426\u0435\u043b\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b: \u041e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0438 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u0442\u044c
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b: 1. \u0424\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c
    \u0432\u0441\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432
    \u0435\u0451 \u0432 \u0438\u0433\u0440\u0443 \u0441 \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438
    \u043f\u043e \u0441\u0442\u0440\u043e\u0433\u0438\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c
    (\u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430).
    2. \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u00ab\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u0445\u00bb
    (\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445 \u0438 \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u044b\u0445)
    \u043c\u0435\u0442\u0430\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u0432 \u044d\u0442\u043e\u0439 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0435\u0433\u043e
    \u043e\u0442\u0440\u0438\u0446\u0430\u043d\u0438\u0435. \u041a\u0440\u0443\u0448\u0435\u043d\u0438\u0435
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f: \u0412 1931 \u0433\u043e\u0434\u0443
    \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u043b\u043e\u0433\u0438\u043a \u041a\u0443\u0440\u0442
    \u0413\u0451\u0434\u0435\u043b\u044c \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u043d\u0435\u0441\u043b\u0438 \u0441\u043e\u043a\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0443\u0434\u0430\u0440 \u043f\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430. \u0413\u0451\u0434\u0435\u043b\u044c
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432 \u043b\u044e\u0431\u043e\u0439
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443,
    \u0435\u0441\u0442\u044c \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u044d\u0442\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043d\u0435\u043b\u044c\u0437\u044f \u043d\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u043d\u0438 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c.
    \u0421\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0435\u0451 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u0435\u0451 \u0436\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.
    \u041d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u043b\u043e\u0434\u044b:
    \u0425\u043e\u0442\u044f \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0446\u0435\u043b\u044c
    \u0431\u044b\u043b\u0430 \u043d\u0435\u0434\u043e\u0441\u0442\u0438\u0436\u0438\u043c\u0430,
    \u0441\u0430\u043c\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0434\u0430\u043b\u0430 \u0442\u043e\u043b\u0447\u043e\u043a \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432,
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432
    \u0438 \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438.\n\n\U0001F30D
    23 \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0415\u0433\u043e \u0434\u043e\u043a\u043b\u0430\u0434 \u043d\u0430 \u0412\u0442\u043e\u0440\u043e\u043c
    \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u043c \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    \u0432 1900 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0441\u0430\u043c\u044b\u043c \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u044b\u043c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u043f\u0438\u0441\u043e\u043a
    \u0438\u0437 23 \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e,
    \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u043b\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043d\u0430 XX \u0432\u0435\u043a. \u042d\u0442\u043e\u0442 \u0441\u043f\u0438\u0441\u043e\u043a
    \u0441\u0442\u0430\u043b \u00ab\u043f\u0443\u0442\u0435\u0432\u043e\u0434\u043d\u043e\u0439
    \u043a\u0430\u0440\u0442\u043e\u0439\u00bb \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432\u0441\u0435\u0433\u043e \u043c\u0438\u0440\u0430. \u0412\u043e\u0442 \u043b\u0438\u0448\u044c
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c
