    \u0437\u0430\u0445\u043e\u0434\u0438\u043b\u0430 \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0435. \u041e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0435,
    \u0441\u0442\u0430\u0432\u0448\u0435\u043c \u043f\u043e\u044d\u0442\u043e\u043c: \u041a\u043e\u0433\u0434\u0430
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b
    \u043f\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043d\u0430 \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u0445,
    \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u043e\u043d
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0430\u0442\u044c \u043f\u043e\u044d\u0442\u043e\u043c.
    \u0423\u0437\u043d\u0430\u0432 \u043e\u0431 \u044d\u0442\u043e\u043c, \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b: \u00ab\u041d\u0435 \u043c\u043e\u0433\u0443
    \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u044f \u0443\u0434\u0438\u0432\u043b\u0435\u043d.
    \u041c\u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b
    \u0441\u0442\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c\u00bb.
    \u042d\u0442\u043e\u0442 \u0430\u0444\u043e\u0440\u0438\u0437\u043c \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e
    \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0435\u0433\u043e \u0432\u0435\u0440\u0443
    \u0432 \u0442\u043e, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u0432\u044b\u0441\u0448\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430.
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0420\u0438\u043c\u0430\u043d\u0430 \u043d\u0430
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0430\u0445: \u0423 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0431\u044b\u043b \u0441\u0442\u0443\u0434\u0435\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0435\u043c\u0443 \u0440\u0430\u0431\u043e\u0442\u0443
    \u0441 \u043f\u0440\u0435\u0442\u0435\u043d\u0437\u0438\u0435\u0439 \u043d\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0420\u0438\u043c\u0430\u043d\u0430. \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043d\u0430\u0448\u0435\u043b \u0432 \u043d\u0435\u0439 \u043e\u0448\u0438\u0431\u043a\u0443,
    \u043d\u043e \u0431\u044b\u043b \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d \u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430. \u041d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439
    \u0433\u043e\u0434 \u0441\u0442\u0443\u0434\u0435\u043d\u0442 \u0443\u043c\u0435\u0440.
    \u041d\u0430 \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0430\u0445, \u0441\u0442\u043e\u044f
    \u043f\u043e\u0434 \u0434\u043e\u0436\u0434\u0435\u043c, \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441 \u0440\u0435\u0447\u044c. \u041e\u043d
    \u043d\u0430\u0447\u0430\u043b \u0441 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u044d\u0442\u043e
    \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f,
    \u043d\u043e \u0437\u0430\u0442\u0435\u043c \u0441 \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0437\u043c\u043e\u043c
    \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b: \u00ab\u0418 \u0432 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435, \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u044e
    \u043e\u0434\u043d\u043e\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0439
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439...\u00bb \u2014 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0438\u0437\u043b\u0430\u0433\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438\u0434\u0435\u044e \u043f\u0440\u044f\u043c\u043e \u043d\u0430\u0434 \u043c\u043e\u0433\u0438\u043b\u043e\u0439.\n\n\U0001F5E3\ufe0f
    \u041e\u0441\u0442\u0440\u044b\u0435 \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043e\u0442\u0432\u0435\u0442\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439
    \u043f\u0440\u044f\u043c\u043e\u0442\u043e\u0439 \u0438 \u0430\u0444\u043e\u0440\u0438\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e.
    \u041e\u0442\u0432\u0435\u0442 \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u043e\u043c\u0443
    \u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0443: \u041f\u043e\u0441\u043b\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0430
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432
    \u0432 1933 \u0433\u043e\u0434\u0443 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d: \u043c\u043d\u043e\u0433\u0438\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433-\u0435\u0432\u0440\u0435\u0435\u0432 \u0443\u0432\u043e\u043b\u0438\u043b\u0438
    \u0438 \u0432\u044b\u043d\u0443\u0434\u0438\u043b\u0438 \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043c\u0438\u043d\u0438\u0441\u0442\u0440 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0420\u0443\u0441\u0442 \u0441\u043f\u0440\u043e\u0441\u0438\u043b
    \u0443 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430: \u00ab\u041a\u0430\u043a
    \u0442\u0435\u043f\u0435\u0440\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435, \u043f\u043e\u0441\u043b\u0435
    \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u043e\u043d\u0430 \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u043e\u0442 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u044f?\u00bb
    \u041d\u0430 \u044d\u0442\u043e \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0443\u043d\u044b\u043b\u043e
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435? \u0415\u0451 \u0431\u043e\u043b\u044c\u0448\u0435
    \u043d\u0435\u0442\u00bb. \u00ab\u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u044d\u0442\u043e \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f\u00bb: \u0412 1888 \u0433\u043e\u0434\u0443
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u043e \u0431\u0430\u0437\u0438\u0441\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435,
    \u043d\u043e \u043d\u0435 \u0434\u0430\u0432\u0430\u043b\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u0430
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f. \u041f\u0430\u0443\u043b\u044c
    \u0413\u043e\u0440\u0434\u0430\u043d, \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u044d\u043a\u0441\u043f\u0435\u0440\u0442
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432,
    \u043d\u0435 \u043f\u0440\u0438\u043d\u044f\u043b \u0442\u0430\u043a\u043e\u0439 \u043f\u043e\u0434\u0445\u043e\u0434
    \u0438 \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b: \u00ab\u042d\u0442\u043e
    \u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u042d\u0442\u043e
    \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f!\u00bb. \u041f\u043e\u0437\u0436\u0435,
    \u043f\u0440\u0438\u0437\u043d\u0430\u0432 \u0441\u0438\u043b\u0443 \u043c\u0435\u0442\u043e\u0434\u0430
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430, \u0413\u043e\u0440\u0434\u0430\u043d
    \u0441\u043c\u044f\u0433\u0447\u0438\u043b\u0441\u044f \u0438 \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u042f \u0443\u0431\u0435\u0434\u0438\u043b\u0441\u044f, \u0447\u0442\u043e \u0434\u0430\u0436\u0435
    \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f \u0438\u043c\u0435\u0435\u0442 \u0441\u0432\u043e\u0438
    \u0437\u0430\u0441\u043b\u0443\u0433\u0438\u00bb.\n\n\U0001F48E \u041d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u044b\u0439
    \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u043c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0420\u0438\u043c\u0430\u043d\u0430 \u0447\u0435\u0440\u0435\u0437
    500 \u043b\u0435\u0442: \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u043d\u0430\u0437\u043e\u0439\u043b\u0438\u0432\u043e\u0433\u043e
    \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0430 \u043e \u0442\u043e\u043c,
    \u0447\u0442\u043e \u0431\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0441\u0434\u0435\u043b\u0430\u043b,
    \u0435\u0441\u043b\u0438 \u0431\u044b \u043e\u0436\u0438\u043b \u0447\u0435\u0440\u0435\u0437
    \u043f\u044f\u0442\u044c\u0441\u043e\u0442 \u043b\u0435\u0442, \u043e\u043d \u043d\u0435
    \u0437\u0430\u0434\u0443\u043c\u044b\u0432\u0430\u044f\u0441\u044c \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u042f \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u0431\u044b, \u043d\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u043b\u0438 \u043a\u0442\u043e-\u043d\u0438\u0431\u0443\u0434\u044c \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0420\u0438\u043c\u0430\u043d\u0430?\u00bb. \u042d\u0442\u0430 \u0444\u0440\u0430\u0437\u0430
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u043e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b \u044d\u0442\u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u0430\u0436\u043d\u044b\u0445
    \u0438 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u044b\u0445 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0414\u0435\u0432\u0438\u0437 \u043d\u0430 \u043c\u043e\u0433\u0438\u043b\u0435: \u0421\u0430\u043c\u044b\u043c
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0430\u0444\u043e\u0440\u0438\u0437\u043c\u043e\u043c
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u0441\u0442\u0430\u043b\u0438 \u0441\u043b\u043e\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043e\u043d \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b
    \u0441\u0432\u043e\u044e \u0440\u0435\u0447\u044c \u0432 1930 \u0433\u043e\u0434\u0443:
    \u00abWir m\u00fcssen wissen. Wir werden wissen\u00bb \u2014 \u00ab\u041c\u044b \u0434\u043e\u043b\u0436\u043d\u044b
    \u0437\u043d\u0430\u0442\u044c. \u041c\u044b \u0431\u0443\u0434\u0435\u043c \u0437\u043d\u0430\u0442\u044c\u00bb.
    \u042d\u0442\u0430 \u0444\u0440\u0430\u0437\u0430, \u0432\u044b\u0440\u0430\u0436\u0430\u044e\u0449\u0430\u044f
    \u0435\u0433\u043e \u043d\u0435\u043f\u043e\u043a\u043e\u043b\u0435\u0431\u0438\u043c\u0443\u044e
    \u0432\u0435\u0440\u0443 \u0432 \u0441\u0438\u043b\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u0430\u0437\u0443\u043c\u0430, \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430 \u043d\u0430
    \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u043e\u043c \u043a\u0430\u043c\u043d\u0435
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u042d\u0442\u0438
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0440\u0438\u0441\u0443\u044e\u0442 \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043a\u0430\u043a \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e,
    \u043d\u043e \u0438 \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u043c
    \u043c\u0438\u0440\u043e\u043c, \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u043d\u0435\u043f\u043e\u0432\u0442\u043e\u0440\u0438\u043c\u044b\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430."
