  achievementsRu: "\u0424\u0430\u043B\u0435\u0441 \u041C\u0438\u043B\u0435\u0442\u0441\u043A\u0438\u0439
    \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u044B\u0445
    \u0442\u0440\u0443\u0434\u043E\u0432, \u0438 \u0432\u0441\u0435 \u0435\u0433\u043E
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B
    \u043D\u0430\u043C \u043F\u043E \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C
    \u0431\u043E\u043B\u0435\u0435 \u043F\u043E\u0437\u0434\u043D\u0438\u0445 \u0430\u0432\u0442\u043E\u0440\u043E\u0432,
    \u0442\u0430\u043A\u0438\u0445 \u043A\u0430\u043A \u0410\u0440\u0438\u0441\u0442\u043E\u0442\u0435\u043B\u044C,
    \u041F\u0440\u043E\u043A\u043B \u0438 \u0413\u0435\u0440\u043E\u0434\u043E\u0442
    . \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043E\u043D
    \u043F\u043E \u043F\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u043E\u0439
    \u043D\u0430\u0443\u043A\u0438, \u0438 \u0435\u0433\u043E \u0432\u043A\u043B\u0430\u0434
    \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443, \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u044E
    \u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044E \u043F\u043E\u0438\u0441\u0442\u0438\u043D\u0435
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u0435\u043D.
    \u041E\u043D \u043F\u0435\u0440\u0432\u044B\u043C \u043F\u0435\u0440\u0435\u0448\u0435\u043B
    \u043E\u0442 \u043C\u0438\u0444\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0439 \u043C\u0438\u0440\u0430
    \u043A \u0435\u0433\u043E \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C\u0443
    \u043F\u043E\u0437\u043D\u0430\u043D\u0438\u044E .  \u041D\u0438\u0436\u0435
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u0439
    \u043E\u0431\u0437\u043E\u0440 \u0435\u0433\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439.  ### \U0001F9EE
    \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430: \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430 
    \u0424\u0430\u043B\u0435\u0441 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043F\u0435\u0440\u0432\u044B\u043C \u0433\u0440\u0435\u043A\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0432\u0432\u0435\u043B \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
    \u0441\u0434\u0435\u043B\u0430\u0432 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044E
    \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439,
    \u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0431\u043E\u0440\u043E\u043C
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0440\u0430\u0432\u0438\u043B
    . \u0415\u043C\u0443 \u043F\u0440\u0438\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0442\u0435\u043E\u0440\u0435\u043C: 
    1.  **\u041A\u0440\u0443\u0433 \u0434\u0435\u043B\u0438\u0442\u0441\u044F \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C
    \u043F\u043E\u043F\u043E\u043B\u0430\u043C** . 2.  **\u0423\u0433\u043B\u044B
    \u043F\u0440\u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438 \u0440\u0430\u0432\u043D\u043E\u0431\u0435\u0434\u0440\u0435\u043D\u043D\u043E\u0433\u043E
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430 \u0440\u0430\u0432\u043D\u044B**
    . 3.  **\u0412\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
    \u0443\u0433\u043B\u044B, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u0435\u043C \u0434\u0432\u0443\u0445
    \u043F\u0440\u044F\u043C\u044B\u0445, \u0440\u0430\u0432\u043D\u044B** . 4. 
    **\u0420\u0430\u0432\u0435\u043D\u0441\u0442\u0432\u043E \u0434\u0432\u0443\u0445
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u0432
    \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0438 \u0434\u0432\u0443\u043C
    \u043F\u0440\u0438\u043B\u0435\u0436\u0430\u0449\u0438\u043C \u043A \u043D\u0435\u0439
    \u0443\u0433\u043B\u0430\u043C** . 5.  **\u0412\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0439
    \u0443\u0433\u043E\u043B, \u043E\u043F\u0438\u0440\u0430\u044E\u0449\u0438\u0439\u0441\u044F
    \u043D\u0430 \u0434\u0438\u0430\u043C\u0435\u0442\u0440, \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0440\u044F\u043C\u044B\u043C** (\u044D\u0442\u0443 \u0442\u0435\u043E\u0440\u0435\u043C\u0443
    \u0432 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u0445
    \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0442\u0435\u043E\u0440\u0435\u043C\u043E\u0439
    \u0424\u0430\u043B\u0435\u0441\u0430) .  \u0421\u0430\u043C\u0430\u044F \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F
    **\u0422\u0435\u043E\u0440\u0435\u043C\u0430 \u0424\u0430\u043B\u0435\u0441\u0430**
    (\u043E \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u043E\u0442\u0440\u0435\u0437\u043A\u0430\u0445, \u043E\u0442\u0441\u0435\u043A\u0430\u0435\u043C\u044B\u0445
    \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u043F\u0440\u044F\u043C\u044B\u043C\u0438 \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u0445
    \u0443\u0433\u043B\u0430), \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
    \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u043F\u0438\u0441\u0430\u043D\u0430
    \u0435\u043C\u0443 \u043F\u043E\u0437\u0436\u0435, \u0442\u0430\u043A \u043A\u0430\u043A
    \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u0430
    \u0441 \u0435\u0433\u043E \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u043C\u0435\u0442\u043E\u0434\u0430\u043C\u0438 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
    . \u041F\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0435, \u043E\u043D \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u0435\u0435 \u0432 \u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0435\u0439\u0441\u044F
    \u043A\u043D\u0438\u0433\u0435 \u043F\u043E \u043C\u043E\u0440\u0441\u043A\u043E\u0439
    \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438.  \u0424\u0430\u043B\u0435\u0441
    \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0441\u044F
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C
    \u0441\u0432\u043E\u0438\u0445 \u0437\u043D\u0430\u043D\u0438\u0439: *   **\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435
    \u0432\u044B\u0441\u043E\u0442\u044B \u043F\u0438\u0440\u0430\u043C\u0438\u0434**:
    \u041E\u043D \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B \u0432\u044B\u0441\u043E\u0442\u0443
    \u0435\u0433\u0438\u043F\u0435\u0442\u0441\u043A\u0438\u0445 \u043F\u0438\u0440\u0430\u043C\u0438\u0434,
    \u0438\u0437\u043C\u0435\u0440\u0438\u0432 \u0438\u0445 \u0442\u0435\u043D\u044C
    \u0432 \u043C\u043E\u043C\u0435\u043D\u0442, \u043A\u043E\u0433\u0434\u0430 \u0434\u043B\u0438\u043D\u0430
    \u0435\u0433\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0442\u0435\u043D\u0438 \u0440\u0430\u0432\u043D\u044F\u043B\u0430\u0441\u044C
    \u0435\u0433\u043E \u0440\u043E\u0441\u0442\u0443. \u042D\u0442\u043E \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043E
    \u043D\u0430 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0435 \u043F\u043E\u0434\u043E\u0431\u0438\u044F
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u0432
    . *   **\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u0434\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u0432 \u043C\u043E\u0440\u0435**:
    \u041E\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043C\u0435\u0442\u043E\u0434
    \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u0434\u043E \u0441\u0443\u0434\u043D\u0430, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E\u0441\u044F
    \u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C \u043C\u043E\u0440\u0435,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F .  ### \U0001F30C
    \u0410\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u044F: \u041F\u0440\u043E\u0432\u0438\u0434\u0435\u043D\u0438\u0435
    \u0438 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044C  \u0410\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u0424\u0430\u043B\u0435\u0441\u0430
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u043B\u0438 \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0435
    \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435 \u043D\u0430
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u043E\u0432
    \u0438 \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0438 \u0435\u0433\u043E
    \u0438\u043C\u044F \u043F\u043E \u0432\u0441\u0435\u0439 \u0413\u0440\u0435\u0446\u0438\u0438
    .  *   **\u041F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043D\u0438\u0435
    \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u044F**:
    \u0415\u0433\u043E \u0441\u0430\u043C\u043E\u0435 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0435
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435 \u2014 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043D\u0438\u0435
    \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u044F,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
    28 \u043C\u0430\u044F 585 \u0433\u043E\u0434\u0430 \u0434\u043E \u043D. \u044D.
    . \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0435,
    \u044D\u0442\u043E \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u0440\u0432\u0430\u043B\u043E
    \u0431\u0438\u0442\u0432\u0443 \u043C\u0435\u0436\u0434\u0443 \u043B\u0438\u0434\u0438\u0439\u0446\u0430\u043C\u0438
    \u0438 \u043C\u0438\u0434\u044F\u043D\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432 \u0441\u0442\u0440\u0430\u0445\u0435 \u0437\u0430\u043A\u043B\u044E\u0447\u0438\u043B\u0438
    \u043C\u0438\u0440 . \u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043E\u043D
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B \u0432\u0430\u0432\u0438\u043B\u043E\u043D\u0441\u043A\u0438\u0435
    \u0437\u043D\u0430\u043D\u0438\u044F \u043E \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0445\u0441\u044F
    \u0446\u0438\u043A\u043B\u0430\u0445 \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u0439,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445 \u043A\u0430\u043A \"\u0441\u0430\u0440\u043E\u0441\"
    . *   **\u041E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0432 \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u0438
    \u0438 \u043A\u043E\u0441\u043C\u043E\u043B\u043E\u0433\u0438\u0438**: \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u0424\u0430\u043B\u0435\u0441:     *   \u041E\u0442\u043A\u0440\u044B\u043B
    \u043D\u0430\u043A\u043B\u043E\u043D \u044D\u043A\u043B\u0438\u043F\u0442\u0438\u043A\u0438
    (\u0432\u0438\u0434\u0438\u043C\u043E\u0433\u043E \u043F\u0443\u0442\u0438 \u0421\u043E\u043B\u043D\u0446\u0430
    \u043F\u043E \u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0439 \u0441\u0444\u0435\u0440\u0435)
    \u043A \u043D\u0435\u0431\u0435\u0441\u043D\u043E\u043C\u0443 \u044D\u043A\u0432\u0430\u0442\u043E\u0440\u0443
    .     *   \u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0433\u043E\u0434\u0430 \u0432 **365 \u0434\u043D\u0435\u0439** .     *   \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B
    \u0432\u0440\u0435\u043C\u044F \u0441\u043E\u043B\u043D\u0446\u0435\u0441\u0442\u043E\u044F\u043D\u0438\u0439
    \u0438 \u0440\u0430\u0432\u043D\u043E\u0434\u0435\u043D\u0441\u0442\u0432\u0438\u0439
    .     *   \u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B \u0432\u0438\u0434\u0438\u043C\u044B\u0439
    \u0443\u0433\u043B\u043E\u0432\u043E\u0439 \u0440\u0430\u0437\u043C\u0435\u0440
    \u0421\u043E\u043B\u043D\u0446\u0430 \u0438 \u041B\u0443\u043D\u044B .     *  
    \u041E\u0431\u044A\u044F\u0441\u043D\u0438\u043B, \u0447\u0442\u043E \u041B\u0443\u043D\u0430
    \u0441\u0432\u0435\u0442\u0438\u0442 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u043C
    \u0441\u0432\u0435\u0442\u043E\u043C \u0421\u043E\u043B\u043D\u0446\u0430, \u0438
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435
    \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0440\u043E\u0434\u044B
    \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0445 \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u0439
    .     *   \u0412\u0432\u0435\u043B \u0432 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044E
    \u041F\u043E\u043B\u044F\u0440\u043D\u0443\u044E \u0437\u0432\u0435\u0437\u0434\u0443
    (\u0432 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u0438 \u041C\u0430\u043B\u043E\u0439
    \u041C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u044B) \u043A\u0430\u043A \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440,
    \u0447\u0435\u043C\u0443 \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F \u0443
    \u0444\u0438\u043D\u0438\u043A\u0438\u0439\u0446\u0435\u0432 .  ### \U0001F4A7
    \u0424\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044F: \u041F\u0435\u0440\u0432\u043E\u043E\u0441\u043D\u043E\u0432\u0430
    \u0432\u0441\u0435\u0433\u043E \u0441\u0443\u0449\u0435\u0433\u043E  \u0413\u043B\u0430\u0432\u043D\u0430\u044F
    \u0437\u0430\u0441\u043B\u0443\u0433\u0430 \u0424\u0430\u043B\u0435\u0441\u0430
    \u043A\u0430\u043A \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0430 \u2014 \u044D\u0442\u043E
    \u043F\u0435\u0440\u0432\u0430\u044F \u043F\u043E\u043F\u044B\u0442\u043A\u0430
    \u043D\u0430\u0439\u0442\u0438 \u0435\u0434\u0438\u043D\u043E\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043E \u0432\u0441\u0435\u0445
    \u0432\u0435\u0449\u0435\u0439 .  *   **\u0412\u043E\u0434\u0430 \u043A\u0430\u043A
    \u0430\u0440\u0445\u044D**: \u041E\u043D \u043F\u0440\u043E\u0432\u043E\u0437\u0433\u043B\u0430\u0441\u0438\u043B,
    \u0447\u0442\u043E **\u0432\u043E\u0434\u0430 (\u0438\u043B\u0438 \u0432\u043B\u0430\u0436\u043D\u0430\u044F
    \u043F\u0440\u0438\u0440\u043E\u0434\u0430)** \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0435\u0440\u0432\u043E\u043E\u0441\u043D\u043E\u0432\u043E\u0439 \u0438
    \u0441\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0438\u0435\u0439 \u0432\u0441\u0435\u0433\u043E
    \u0441\u0443\u0449\u0435\u0433\u043E (\"\u0432\u0441\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
    \u0438\u0437 \u0432\u043E\u0434\u044B \u0438 \u0432 \u043D\u0435\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F\")
    . \u041A \u044D\u0442\u043E\u043C\u0443 \u0432\u044B\u0432\u043E\u0434\u0443
    \u0435\u0433\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F:
    \u0432\u043B\u0430\u0433\u0430 \u2014 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0435
    \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u0436\u0438\u0437\u043D\u0438, \u0438\u0437
    \u0432\u043B\u0430\u0436\u043D\u043E\u0433\u043E \u0441\u0435\u043C\u0435\u043D\u0438
    \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u0432\u0441\u0435 \u0436\u0438\u0432\u043E\u0435,
    \u0430 \u0432\u043E\u0437\u0434\u0443\u0445 \u0438 \u0434\u0430\u0436\u0435 \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u0435
    \u0441\u0432\u0435\u0442\u0438\u043B\u0430 \u043F\u0438\u0442\u0430\u044E\u0442\u0441\u044F
    \u0432\u043E\u0434\u044F\u043D\u044B\u043C\u0438 \u0438\u0441\u043F\u0430\u0440\u0435\u043D\u0438\u044F\u043C\u0438
    . *   **\u041E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u043C\u0438\u0440\u0430 (\u043F\u0430\u043D\u043F\u0441\u0438\u0445\u0438\u0437\u043C)**:
    \u0424\u0430\u043B\u0435\u0441 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B,
    \u0447\u0442\u043E \"\u0432\u0441\u0435 \u043F\u043E\u043B\u043D\u043E \u0431\u043E\u0433\u043E\u0432\"
    \u0438 \u0447\u0442\u043E \u043C\u0438\u0440 \u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D.
    \u041E\u043D \u043F\u0440\u0438\u043F\u0438\u0441\u044B\u0432\u0430\u043B \u0434\u0443\u0448\u0443
    \u0434\u0430\u0436\u0435 \u043C\u0430\u0433\u043D\u0438\u0442\u0443, \u0442\u0430\u043A
    \u043A\u0430\u043A \u043E\u043D \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D
    \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442\u044C \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
    \u0436\u0435\u043B\u0435\u0437\u043E . *   **\u041A\u043E\u0441\u043C\u043E\u043B\u043E\u0433\u0438\u044F**:
    \u041E\u043D \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B
    \u0417\u0435\u043C\u043B\u044E \u043A\u0430\u043A \u043F\u043B\u043E\u0441\u043A\u0438\u0439
    \u0434\u0438\u0441\u043A, \u043F\u043B\u0430\u0432\u0430\u044E\u0449\u0438\u0439
    \u0432 \u0432\u043E\u0434\u0435 .  ### \U0001F4DC \u041F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u044B\u0435
    \u0442\u0440\u0443\u0434\u044B  \u0424\u0430\u043B\u0435\u0441 \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u043A\u043D\u0438\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u043E\u0448\u043B\u0438
    \u0431\u044B \u0434\u043E \u043D\u0430\u0441 . \u0410\u043D\u0442\u0438\u0447\u043D\u044B\u0435
    \u0430\u0432\u0442\u043E\u0440\u044B \u043F\u0440\u0438\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442
    \u0435\u043C\u0443 \u0434\u0432\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
    \u0441\u043E\u0447\u0438\u043D\u0435\u043D\u0438\u044F: **\xAB\u041E \u0441\u043E\u043B\u043D\u0446\u0435\u0441\u0442\u043E\u044F\u043D\u0438\u0438\xBB**
    \u0438 **\xAB\u041E \u0440\u0430\u0432\u043D\u043E\u0434\u0435\u043D\u0441\u0442\u0432\u0438\u0438\xBB**,
    \u0430 \u0442\u0430\u043A\u0436\u0435 **\xAB\u0421\u0443\u0434\u043E\u0432\u043E\u0434\u043D\u0443\u044E
    (\u041C\u043E\u0440\u0441\u043A\u0443\u044E) \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u044E\xBB**,
    \u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439,
    \u0432\u043F\u0440\u043E\u0447\u0435\u043C, \u0438\u043D\u043E\u0433\u0434\u0430
    \u0441\u0442\u0430\u0432\u0438\u043B\u043E\u0441\u044C \u043F\u043E\u0434 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0435
    \u0435\u0449\u0435 \u0432 \u0434\u0440\u0435\u0432\u043D\u043E\u0441\u0442\u0438
    . \u0412\u0441\u0435 \u0435\u0433\u043E \u0438\u0434\u0435\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B
    \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u043E \u0442\u0440\u0443\u0434\u0430\u043C \u0435\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u0438 \u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0442\u043E\u0440\u043E\u0432,
    \u0442\u0430\u043A\u0438\u0445 \u043A\u0430\u043A \u0410\u0440\u0438\u0441\u0442\u043E\u0442\u0435\u043B\u044C. 
    \u0412\u043A\u043B\u0430\u0434 \u0424\u0430\u043B\u0435\u0441\u0430 \u0432 \u043D\u0430\u0443\u043A\u0443
    \u043D\u0435\u043E\u0446\u0435\u043D\u0438\u043C. \u041E\u043D \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441\u0434\u0435\u043B\u0430\u043B \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435
    \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F, \u043D\u043E \u0438 \u0437\u0430\u043B\u043E\u0436\u0438\u043B
    \u043D\u043E\u0432\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F,
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u043F\u043E\u0438\u0441\u043A\u0435
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445, \u0430
    \u043D\u0435 \u0441\u0432\u0435\u0440\u0445\u044A\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043F\u0440\u0438\u0447\u0438\u043D \u044F\u0432\u043B\u0435\u043D\u0438\u0439,
    \u043D\u0430 \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445
    \u0438 \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C
    \u043F\u043E\u0437\u043D\u0430\u043D\u0438\u0438 \u043C\u0438\u0440\u0430. \u0418\u043C\u0435\u043D\u043D\u043E
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0435\u0433\u043E \u043F\u043E \u043F\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \"\u043E\u0442\u0446\u043E\u043C \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438\"
    \u0438 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u0432\u0441\u0435\u0439 \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u043E\u0439
    \u043D\u0430\u0443\u043A\u0438."
  achievementsEn: 
  personalLifeRu: "\u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C
    \u0424\u0430\u043B\u0435\u0441\u0430 \u041C\u0438\u043B\u0435\u0442\u0441\u043A\u043E\u0433\u043E,
    \u043A\u0430\u043A \u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0430\u0441\u043F\u0435\u043A\u0442\u044B \u0435\u0433\u043E \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438,
    \u043E\u043A\u0443\u0442\u0430\u043D\u0430 \u043F\u043E\u043B\u0443\u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u043C\u0438
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C\u0438.
    \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0435\u0451
    \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445 \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0442\u0430\u043A \u043A\u0430\u043A
    \u043E\u043D \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u044B\u0445
    \u0442\u0440\u0443\u0434\u043E\u0432, \u0430 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u043E \u043D\u0435\u043C \u0447\u0435\u0440\u043F\u0430\u044E\u0442\u0441\u044F
    \u0438\u0437 \u0442\u0440\u0443\u0434\u043E\u0432 \u0431\u043E\u043B\u0435\u0435
    \u043F\u043E\u0437\u0434\u043D\u0438\u0445 \u0430\u0432\u0442\u043E\u0440\u043E\u0432. 
    ### \U0001F476 \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    *   **\u0413\u043E\u0440\u043E\u0434 \u0438 \u0434\u0430\u0442\u044B**: \u0424\u0430\u043B\u0435\u0441
    \u0440\u043E\u0434\u0438\u043B\u0441\u044F \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
    **\u041C\u0438\u043B\u0435\u0442** (\u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0422\u0443\u0440\u0446\u0438\u0438)
    \u0432 \u0437\u043D\u0430\u0442\u043D\u043E\u0439 \u0441\u0435\u043C\u044C\u0435.
    \u0422\u043E\u0447\u043D\u044B\u0435 \u0434\u0430\u0442\u044B \u0435\u0433\u043E
    \u0436\u0438\u0437\u043D\u0438 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B;
    \u0430\u043D\u0442\u0438\u0447\u043D\u044B\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u043A
    \u0410\u043F\u043E\u043B\u043B\u043E\u0434\u043E\u0440 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    **640 \u0433\u043E\u0434 \u0434\u043E \u043D.\u044D.**, \u043E\u0434\u043D\u0430\u043A\u043E
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438
    \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u0438\u0432\u043E\u0434\u044F\u0442
    \u043F\u0435\u0440\u0438\u043E\u0434 **\u043E\u043A. 625/624 \u2013 \u043E\u043A.
    547/545 \u0433\u0433. \u0434\u043E \u043D.\u044D.**. *   **\u0420\u043E\u0434\u0438\u0442\u0435\u043B\u0438**:
    \u0415\u0433\u043E \u043E\u0442\u0446\u0430 \u0437\u0432\u0430\u043B\u0438 **\u042D\u043A\u0441\u0430\u043C\u0438\u0439**,
    \u043C\u0430\u0442\u044C \u2014 **\u041A\u043B\u0435\u043E\u0431\u0443\u043B\u0438\u043D\u0430**.
    \u0421\u0435\u043C\u044C\u044F \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430
    \u0438\u0437 \u0430\u0440\u0438\u0441\u0442\u043E\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0440\u043E\u0434\u0430 \u0424\u0435\u043B\u0438\u0434\u043E\u0432. *   **\u041A\u043E\u0440\u043D\u0438**:
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0432\u0435
    \u0432\u0435\u0440\u0441\u0438\u0438 \u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F.
    \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043E\u0434\u043D\u043E\u0439,
    \u043E\u043D \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B
    \u043A \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u043D\u0430\u0442\u0438.
    \u041F\u043E \u0434\u0440\u0443\u0433\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u0413\u0435\u0440\u043E\u0434\u043E\u0442,
    \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u043A\u0438 \u0431\u044B\u043B\u0438
    \u0444\u0438\u043D\u0438\u043A\u0438\u0439\u0446\u0430\u043C\u0438, \u0438\u0437\u0433\u043D\u0430\u043D\u043D\u044B\u043C\u0438
    \u0438\u0437 \u0441\u0432\u043E\u0435\u0439 \u0441\u0442\u0440\u0430\u043D\u044B. 
    ### \U0001F935 \u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C
    \u0438 \u0441\u0435\u043C\u0435\u0439\u043D\u043E\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u0421\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E \u0441\u0435\u043C\u044C\u0435
    \u0424\u0430\u043B\u0435\u0441\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0432\u044B.
    \u0414\u0438\u043E\u0433\u0435\u043D \u041B\u0430\u044D\u0440\u0442\u0441\u043A\u0438\u0439
    \u0441\u043E\u0431\u0440\u0430\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0430\u043D\u0442\u0438\u0447\u043D\u044B\u0445 \u0432\u0435\u0440\u0441\u0438\u0439:
    *   \u041E\u043D \u0431\u044B\u043B \u0436\u0435\u043D\u0430\u0442 \u0438 \u0438\u043C\u0435\u043B
    \u0441\u044B\u043D\u0430 \u043F\u043E \u0438\u043C\u0435\u043D\u0438 **\u041A\u0438\u0431\u0438\u0441\u0444**
    (\u0438\u043B\u0438 \u041A\u0438\u0431\u0438\u0441\u0442). *   \u041E\u043D \u0431\u044B\u043B
    \u0431\u0435\u0437\u0434\u0435\u0442\u043D\u044B\u043C \u0438 \u0443\u0441\u044B\u043D\u043E\u0432\u0438\u043B
    \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A\u0430, \u0441\u044B\u043D\u0430
    \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u044B. *   \u041E\u043D
    \u0436\u0438\u043B \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435
    \u0438 \u043D\u0435 \u0431\u044B\u043B \u0436\u0435\u043D\u0430\u0442 \u0432\u043E\u0432\u0441\u0435.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u0430\u043D\u0435\u043A\u0434\u043E\u0442 \u043E \u0442\u043E\u043C, \u043A\u0430\u043A
    \u0435\u0433\u043E \u043C\u0430\u0442\u044C \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043B\u0430
    \u043D\u0430 \u0436\u0435\u043D\u0438\u0442\u044C\u0431\u0435. \u0412 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438
    \u043E\u043D \u043E\u0442\u0432\u0435\u0447\u0430\u043B: \"**\u0421\u043B\u0438\u0448\u043A\u043E\u043C
    \u0440\u0430\u043D\u043E!**\", \u0430, \u043F\u043E\u0432\u0437\u0440\u043E\u0441\u043B\u0435\u0432,
    \u0433\u043E\u0432\u043E\u0440\u0438\u043B: \"**\u0421\u043B\u0438\u0448\u043A\u043E\u043C
    \u043F\u043E\u0437\u0434\u043D\u043E!**\". \u041D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441,
    \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D \u043D\u0435 \u0437\u0430\u0432\u043E\u0434\u0438\u0442
    \u0434\u0435\u0442\u0435\u0439, \u0424\u0430\u043B\u0435\u0441 \u044F\u043A\u043E\u0431\u044B
    \u043E\u0442\u0432\u0435\u0442\u0438\u043B: \"**\u041F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u043B\u044E\u0431\u043B\u044E \u0438\u0445**\".  ### \U0001F4DA
    \u0423\u0447\u0451\u0431\u0430 \u0438 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F
    *   **\u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435**: \u0424\u0430\u043B\u0435\u0441
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0445\u043E\u0440\u043E\u0448\u0435\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u043D\u0430
    \u0440\u043E\u0434\u0438\u043D\u0435, \u0447\u0435\u043C\u0443 \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u0435\u0433\u043E \u0437\u043D\u0430\u0442\u043D\u043E\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435.
    *   **\u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F**: \u041E\u043D
    \u043C\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B,
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0432 **\u0415\u0433\u0438\u043F\u0435\u0442**,
    \u0433\u0434\u0435 \u043F\u0440\u043E\u0436\u0438\u043B \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
    \u0432\u0440\u0435\u043C\u044F \u0432 \u0424\u0438\u0432\u0430\u0445 \u0438 \u041C\u0435\u043C\u0444\u0438\u0441\u0435.
    *   **\u0423\u0447\u0438\u0442\u0435\u043B\u044F**: \u0412 \u0415\u0433\u0438\u043F\u0442\u0435
    \u043E\u043D \u043E\u0431\u0443\u0447\u0430\u043B\u0441\u044F \u0443 \u043C\u0435\u0441\u0442\u043D\u044B\u0445
    \u0436\u0440\u0435\u0446\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0447\u0438\u0442\u0430\u043B\u0438\u0441\u044C \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044F\u043C\u0438
    \u0434\u0440\u0435\u0432\u043D\u0435\u0439 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438.
    \u0418\u043C\u0435\u043D\u043D\u043E \u043E\u0442 \u043D\u0438\u0445 \u043E\u043D
    \u043F\u0435\u0440\u0435\u043D\u044F\u043B \u0437\u043D\u0430\u043D\u0438\u044F
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0437\u0430\u0442\u0435\u043C \u043F\u0440\u0438\u0432\u0435\u0437 \u0432 \u0413\u0440\u0435\u0446\u0438\u044E. 
    ### \u2699\uFE0F \u0420\u0430\u0431\u043E\u0442\u0430 \u0438 \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0424\u0430\u043B\u0435\u0441
    \u043D\u0435 \u0431\u044B\u043B \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u043D\u044B\u043C
    \u0443\u0447\u0435\u043D\u044B\u043C. \u041E\u043D \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432 \u0436\u0438\u0437\u043D\u0438
    \u0441\u0432\u043E\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430 \u0438
    \u0437\u0430 \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438.
    *   **\u0418\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u044B\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u044B**:
    \u041F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0441\u044F \u043A\u0430\u043A
    \u0442\u0430\u043B\u0430\u043D\u0442\u043B\u0438\u0432\u044B\u0439 \u0438\u043D\u0436\u0435\u043D\u0435\u0440.
    \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043E\u043D \u043F\u043E\u043C\u043E\u0433
    \u0446\u0430\u0440\u044E \u041B\u0438\u0434\u0438\u0438 \u041A\u0440\u0435\u0437\u0443
    \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0432\u043E\u0439\u0441\u043A\u043E
    \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u043A\u0443 \u0413\u0430\u043B\u0438\u0441,
    \u0438\u0437\u043C\u0435\u043D\u0438\u0432 \u0435\u0435 \u0440\u0443\u0441\u043B\u043E
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u043B\u043E\u0442\u0438\u043D\u044B
    \u0438 \u043A\u0430\u043D\u0430\u043B\u0430. *   **\u041F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E**:
    \u041F\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0435, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u0410\u0440\u0438\u0441\u0442\u043E\u0442\u0435\u043B\u044C,
    \u043E\u043D \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043B
    \u043D\u0435\u0431\u044B\u0432\u0430\u043B\u044B\u0439 \u0443\u0440\u043E\u0436\u0430\u0439
    \u043E\u043B\u0438\u0432\u043E\u043A \u0438 \u0437\u0430\u0440\u0430\u043D\u0435\u0435
    \u0441\u043A\u0443\u043F\u0438\u043B \u0432\u0441\u0435 \u043C\u0430\u0441\u043B\u043E\u0434\u0430\u0432\u0438\u043B\u044C\u043D\u0438
    \u0432 \u043E\u043A\u0440\u0443\u0433\u0435, \u0447\u0442\u043E\u0431\u044B \u0432
    \u0441\u0435\u0437\u043E\u043D \u0441\u0434\u0430\u0442\u044C \u0438\u0445 \u0432
    \u0430\u0440\u0435\u043D\u0434\u0443 \u043F\u043E \u0432\u044B\u0441\u043E\u043A\u043E\u0439
    \u0446\u0435\u043D\u0435, \u0434\u043E\u043A\u0430\u0437\u0430\u0432, \u0447\u0442\u043E
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u044B \u043C\u043E\u0433\u0443\u0442
    \u0431\u044B\u0442\u044C \u0431\u043E\u0433\u0430\u0442\u044B. *   **\u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430**:
    \u0424\u0430\u043B\u0435\u0441 \u0431\u044B\u043B \u0431\u043B\u0438\u0437\u043A\u0438\u043C
    \u0434\u0440\u0443\u0433\u043E\u043C \u0438 \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u043C
    \u043C\u0438\u043B\u0435\u0442\u0441\u043A\u043E\u0433\u043E \u0442\u0438\u0440\u0430\u043D\u0430
    \u0424\u0440\u0430\u0441\u0438\u0431\u0443\u043B\u0430. \u041E\u043D \u043F\u0440\u043E\u044F\u0432\u0438\u043B
    \u0434\u0430\u043B\u044C\u043D\u043E\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u044C,
    \u0443\u0431\u0435\u0434\u0438\u0432 \u0436\u0438\u0442\u0435\u043B\u0435\u0439
    \u041C\u0438\u043B\u0435\u0442\u0430 \u043D\u0435 \u0432\u0441\u0442\u0443\u043F\u0430\u0442\u044C
    \u0432 \u0441\u043E\u044E\u0437 \u0441 \u0446\u0430\u0440\u0435\u043C \u041A\u0440\u0435\u0437\u043E\u043C
    \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0430\u0431\u0438\u0440\u0430\u044E\u0449\u0435\u0439
    \u0441\u0438\u043B\u0443 \u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u0439
    \u0434\u0435\u0440\u0436\u0430\u0432\u044B. \u042D\u0442\u043E\u0442 \u0448\u0430\u0433
    \u0432 \u0438\u0442\u043E\u0433\u0435 \u0441\u043F\u0430\u0441 \u0433\u043E\u0440\u043E\u0434
    \u043E\u0442 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u044F.  ###
    \U0001F91D \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
    \u0443\u0447\u0435\u043D\u044B\u043C\u0438 *   **\u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435
    \u0448\u043A\u043E\u043B\u044B**: \u0424\u0430\u043B\u0435\u0441 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C **\u041C\u0438\u043B\u0435\u0442\u0441\u043A\u043E\u0439
    \u0448\u043A\u043E\u043B\u044B** \u2014 \u043F\u0435\u0440\u0432\u043E\u0439
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043A\u043E\u0439
    \u043D\u0430\u0443\u0447\u043D\u043E-\u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u043E\u0439
    \u0448\u043A\u043E\u043B\u044B, \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u043E\u0439 \u043D\u0430\u0443\u043A\u0438.
    \u0415\u0433\u043E \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
    \u0443\u0447\u0435\u043D\u0438\u043A\u0430\u043C\u0438 \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044F\u043C\u0438
    \u0431\u044B\u043B\u0438 **\u0410\u043D\u0430\u043A\u0441\u0438\u043C\u0430\u043D\u0434\u0440**
    \u0438 **\u0410\u043D\u0430\u043A\u0441\u0438\u043C\u0435\u043D**. *   **\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E**:
    \u041F\u043E \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u044E, \u0438\u043C\u0435\u043D\u043D\u043E
    \u0424\u0430\u043B\u0435\u0441 \u0443\u0431\u0435\u0434\u0438\u043B \u041F\u0438\u0444\u0430\u0433\u043E\u0440\u0430
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0432 \u0415\u0433\u0438\u043F\u0435\u0442
    \u0437\u0430 \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438 \u0438 \u043F\u043E\u043C\u043E\u0433
    \u0435\u043C\u0443 \u0432\u043E\u0439\u0442\u0438 \u0432 \u0434\u043E\u0432\u0435\u0440\u0438\u0435
    \u043A \u0436\u0440\u0435\u0446\u0430\u043C.  ### \u26B0\uFE0F \u0421\u043C\u0435\u0440\u0442\u044C
    *   **\u0414\u0430\u0442\u0430 \u0438 \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430**:
    \u0424\u0430\u043B\u0435\u0441 \u0443\u043C\u0435\u0440 \u0432 \u041C\u0438\u043B\u0435\u0442\u0435,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0443\u0436\u0435 \u0432 \u043F\u0440\u0435\u043A\u043B\u043E\u043D\u043D\u043E\u043C
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u0414\u0438\u043E\u0433\u0435\u043D\u0443 \u041B\u0430\u044D\u0440\u0442\u0441\u043A\u043E\u043C\u0443,
    \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B\u0430
    **\u043E\u0442 \u0436\u0430\u0440\u044B, \u0436\u0430\u0436\u0434\u044B \u0438
    \u0441\u0442\u0430\u0440\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u0438**
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F
    \u0437\u0430 \u0433\u0438\u043C\u043D\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0441\u043E\u0441\u0442\u044F\u0437\u0430\u043D\u0438\u044F\u043C\u0438. *  
    **\u041D\u0430\u0434\u043F\u0438\u0441\u044C \u043D\u0430 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0435**:
    \u041D\u0430 \u0435\u0433\u043E \u043C\u043E\u0433\u0438\u043B\u0435 \u0431\u044B\u043B\u0430
    \u0432\u044B\u0441\u0435\u0447\u0435\u043D\u0430 \u044D\u043F\u0438\u0442\u0430\u0444\u0438\u044F,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0433\u043B\u0430\u0441\u0438\u043B\u0430:
    \"**\u042D\u0442\u0430 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0430 \u043C\u0430\u043B\u0430,
    \u043D\u043E \u0441\u043B\u0430\u0432\u0430 \u043D\u0430\u0434 \u043D\u0435\u0439
    \u043D\u0435\u043E\u0431\u044A\u044F\u0442\u043D\u0430: \u0412 \u043D\u0435\u0439
    \u043F\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u044E \u0441\u043E\u043A\u0440\u044B\u0442,
    \u043C\u043D\u043E\u0433\u043E\u0440\u0430\u0437\u0443\u043C\u043D\u044B\u0439
    \u0424\u0430\u043B\u0435\u0441**\"."
  personalLifeEn: 
  shortBioRu: "\u0424\u0430\u043B\u0435\u0441 \u041C\u0438\u043B\u0435\u0442\u0441\u043A\u0438\u0439
    \u2014 \u0444\u0438\u0433\u0443\u0440\u0430, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0442\u0435\u0441\u043D\u043E \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u043B\u0438\u0441\u044C
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043B\u0435\u0433\u0435\u043D\u0434\u044B. \u041E\u043D \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043E\u0441\u043D\u043E\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u0438\u043A\u043E\u043C
    \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u043E\u0439 \u043D\u0430\u0443\u043A\u0438
    \u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438, \u0438 \u0434\u0430\u0436\u0435
    \u0432 \u0430\u043D\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u0435\u0433\u043E
    \u0438\u043C\u044F \u0441\u0442\u0430\u043B\u043E \u043D\u0430\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0434\u043B\u044F \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    \u043C\u0443\u0434\u0440\u0435\u0446\u0430.  \u041D\u0438\u0436\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
    \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0430\u044F \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F,
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u043D\u0430 \u0430\u043D\u0442\u0438\u0447\u043D\u044B\u0445
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445
    \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u043D\u0430\u0443\u0447\u043D\u044B\u0445
    \u0434\u0430\u043D\u043D\u044B\u0445. \u0412\u0430\u0436\u043D\u043E \u043F\u043E\u043C\u043D\u0438\u0442\u044C,
    \u0447\u0442\u043E \u0424\u0430\u043B\u0435\u0441 \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u044B\u0445 \u0442\u0440\u0443\u0434\u043E\u0432,
    \u0438 \u0432\u0441\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E
    \u043D\u0435\u043C \u043F\u043E\u0447\u0435\u0440\u043F\u043D\u0443\u0442\u044B
    \u0438\u0437 \u0442\u0440\u0443\u0434\u043E\u0432 \u0431\u043E\u043B\u0435\u0435
    \u043F\u043E\u0437\u0434\u043D\u0438\u0445 \u0430\u0432\u0442\u043E\u0440\u043E\u0432,
    \u0442\u0430\u043A\u0438\u0445 \u043A\u0430\u043A \u0410\u0440\u0438\u0441\u0442\u043E\u0442\u0435\u043B\u044C
    \u0438 \u0413\u0435\u0440\u043E\u0434\u043E\u0442.  ### \U0001F4DC \u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435,
    \u0434\u0430\u0442\u044B \u0436\u0438\u0437\u043D\u0438 \u0438 \u0441\u0435\u043C\u044C\u044F 
    *   **\u0418\u043C\u044F \u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435**:
    \u0424\u0430\u043B\u0435\u0441 \u0440\u043E\u0434\u0438\u043B\u0441\u044F \u0432
    \u0431\u043E\u0433\u0430\u0442\u043E\u043C \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
    \u0433\u043E\u0440\u043E\u0434\u0435 **\u041C\u0438\u043B\u0435\u0442** \u0432
    \u041C\u0430\u043B\u043E\u0439 \u0410\u0437\u0438\u0438 (\u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0422\u0443\u0440\u0446\u0438\u0438).
    \u0415\u0433\u043E \u043E\u0442\u0446\u0430 \u0437\u0432\u0430\u043B\u0438 \u042D\u043A\u0441\u0430\u043C\u0438\u0439,
    \u043C\u0430\u0442\u044C \u2014 \u041A\u043B\u0435\u043E\u0431\u0443\u043B\u0438\u043D\u0430.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0432\u0435
    \u0432\u0435\u0440\u0441\u0438\u0438 \u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F:    
    *   **\u0410\u0440\u0438\u0441\u0442\u043E\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u0440\u043E\u0434**:
    \u043F\u043E \u044D\u0442\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438, \u043E\u043D
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B \u043A \u0437\u043D\u0430\u0442\u043D\u043E\u043C\u0443
    \u043C\u0438\u043B\u0435\u0442\u0441\u043A\u043E\u043C\u0443 \u0440\u043E\u0434\u0443
    \u0424\u0435\u043B\u0438\u0434\u043E\u0432.     *   **\u0424\u0438\u043D\u0438\u043A\u0438\u0439\u0441\u043A\u0438\u0435
    \u043A\u043E\u0440\u043D\u0438**: \u0413\u0435\u0440\u043E\u0434\u043E\u0442
    \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442, \u0447\u0442\u043E \u043F\u0440\u0435\u0434\u043A\u0438
    \u0424\u0430\u043B\u0435\u0441\u0430 \u0431\u044B\u043B\u0438 \u0444\u0438\u043D\u0438\u043A\u0438\u0439\u0446\u0430\u043C\u0438,
    \u0438\u0437\u0433\u043D\u0430\u043D\u043D\u044B\u043C\u0438 \u0438\u0437 \u0441\u0432\u043E\u0435\u0439
    \u0441\u0442\u0440\u0430\u043D\u044B. \u042D\u0442\u043E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441
    \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0434\u0438\u0441\u043A\u0443\u0441\u0441\u0438\u043E\u043D\u043D\u044B\u043C
    \u0432 \u043D\u0430\u0443\u043A\u0435. *   **\u0414\u0430\u0442\u0430 \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u0438 \u0441\u043C\u0435\u0440\u0442\u0438**: \u0422\u043E\u0447\u043D\u044B\u0435
    \u0434\u0430\u0442\u044B \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B.
    \u0410\u043D\u0442\u0438\u0447\u043D\u044B\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u043A
    \u0410\u043F\u043E\u043B\u043B\u043E\u0434\u043E\u0440 \u043D\u0430\u0437\u044B\u0432\u0430\u043B
    **640 \u0433\u043E\u0434 \u0434\u043E \u043D. \u044D.**, \u043E\u0434\u043D\u0430\u043A\u043E
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438
    \u0447\u0430\u0441\u0442\u043E \u043F\u0440\u0438\u0432\u043E\u0434\u044F\u0442
    \u043F\u0435\u0440\u0438\u043E\u0434 **\u043E\u043A. 625/624 \u2014 \u043E\u043A.
    547/545 \u0433\u0433. \u0434\u043E \u043D. \u044D.**. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0436\u0438\u0437\u043D\u0438, \u043F\u043E \u0440\u0430\u0437\u043D\u044B\u043C
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u043C, \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
    \u043E\u0442 78 \u0434\u043E 90 \u043B\u0435\u0442. *   **\u0421\u0435\u043C\u0435\u0439\u043D\u043E\u0435
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435**: \u0421\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0432\u044B.
    \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0414\u0438\u043E\u0433\u0435\u043D\u0443
    \u041B\u0430\u044D\u0440\u0442\u0441\u043A\u043E\u043C\u0443, \u043B\u0438\u0431\u043E
    \u043E\u043D \u0431\u044B\u043B \u0436\u0435\u043D\u0430\u0442 \u0438 \u0438\u043C\u0435\u043B
    \u0441\u044B\u043D\u0430 \u041A\u0438\u0431\u0438\u0441\u0444\u0430, \u043B\u0438\u0431\u043E
    \u0443\u0441\u044B\u043D\u043E\u0432\u0438\u043B \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A\u0430,
    \u043B\u0438\u0431\u043E \u0431\u044B\u043B \u0431\u0435\u0437\u0434\u0435\u0442\u043D\u044B\u043C.
    \u041D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441 \u043C\u0430\u0442\u0435\u0440\u0438
    \u043E \u0436\u0435\u043D\u0438\u0442\u044C\u0431\u0435 \u043E\u043D \u043E\u0442\u0432\u0435\u0447\u0430\u043B:
    \"\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0430\u043D\u043E!\", \u0430
    \u043F\u043E\u0437\u0436\u0435 \u2014 \"\u0421\u043B\u0438\u0448\u043A\u043E\u043C
    \u043F\u043E\u0437\u0434\u043D\u043E!\".  ### \U0001F9E0 \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
    \u0432\u0435\u0445\u0438 \u0436\u0438\u0437\u043D\u0438 \u0438 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 
    \u0424\u0430\u043B\u0435\u0441 \u0431\u044B\u043B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u043D\u044B\u043C \u0443\u0447\u0435\u043D\u044B\u043C.
    \u041E\u043D \u043F\u0440\u043E\u044F\u0432\u0438\u043B \u0441\u0435\u0431\u044F
    \u043A\u0430\u043A \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A,
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A, \u0438\u043D\u0436\u0435\u043D\u0435\u0440
    \u0438 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C. 
    *   **\u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F \u0438
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435**: \u0424\u0430\u043B\u0435\u0441
    \u043C\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B,
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043F\u043E **\u0415\u0433\u0438\u043F\u0442\u0443**,
    \u0433\u0434\u0435 \u043E\u043D \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F
    \u0441 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F\u043C\u0438
    \u0435\u0433\u0438\u043F\u0435\u0442\u0441\u043A\u0438\u0445 \u0436\u0440\u0435\u0446\u043E\u0432
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438,
    \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u0438 \u0438 \u043A\u043E\u0441\u043C\u043E\u043B\u043E\u0433\u0438\u0438.
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E
    \u043E\u043D \u043F\u0440\u0438\u0432\u0435\u0437 \u044D\u0442\u0438 \u0437\u043D\u0430\u043D\u0438\u044F
    \u0432 \u0413\u0440\u0435\u0446\u0438\u044E. *   **\u041F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C**: \u0424\u0430\u043B\u0435\u0441
    \u0431\u044B\u043B \u0431\u043B\u0438\u0437\u043E\u043A \u043A \u043C\u0438\u043B\u0435\u0442\u0441\u043A\u043E\u043C\u0443
    \u0442\u0438\u0440\u0430\u043D\u0443 \u0424\u0440\u0430\u0441\u0438\u0431\u0443\u043B\u0443
    \u0438 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u043B \u043A\u0430\u043A \u043C\u0443\u0434\u0440\u044B\u0439
    \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A. \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u0438\u043E\u043D\u0438\u0439\u0441\u043A\u0438\u043C \u0433\u043E\u0440\u043E\u0434\u0430\u043C
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F \u0432
    \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044E \u0434\u043B\u044F \u043E\u0442\u043F\u043E\u0440\u0430
    \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u0439 \u0443\u0433\u0440\u043E\u0437\u0435,
    \u043D\u043E \u044D\u0442\u043E\u0442 \u043F\u043B\u0430\u043D \u043D\u0435 \u0431\u044B\u043B
    \u043F\u0440\u0438\u043D\u044F\u0442. \u0422\u0430\u043A\u0436\u0435 \u043E\u043D
    \u0443\u0431\u0435\u0434\u0438\u043B \u0436\u0438\u0442\u0435\u043B\u0435\u0439
    \u041C\u0438\u043B\u0435\u0442\u0430 \u043D\u0435 \u0432\u0441\u0442\u0443\u043F\u0430\u0442\u044C
    \u0432 \u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u0441\u043E\u044E\u0437 \u0441
    \u0446\u0430\u0440\u0435\u043C \u041B\u0438\u0434\u0438\u0438 \u041A\u0440\u0435\u0437\u043E\u043C
    \u043F\u0440\u043E\u0442\u0438\u0432 \u041F\u0435\u0440\u0441\u0438\u0438, \u0447\u0442\u043E
    \u0432 \u0438\u0442\u043E\u0433\u0435 \u0441\u043F\u0430\u0441\u043B\u043E \u0433\u043E\u0440\u043E\u0434
    \u043E\u0442 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u044F. *  
    **\u0418\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u044B\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u044B**:
    \u041F\u043E \u043F\u0440\u043E\u0441\u044C\u0431\u0435 \u041A\u0440\u0435\u0437\u0430,
    \u0424\u0430\u043B\u0435\u0441 \u043F\u043E\u043C\u043E\u0433 \u0435\u0433\u043E
    \u0430\u0440\u043C\u0438\u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u043A\u0443 \u0413\u0430\u043B\u0438\u0441,
    \u0438\u0437\u043C\u0435\u043D\u0438\u0432 \u0435\u0435 \u0440\u0443\u0441\u043B\u043E
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u043B\u043E\u0442\u0438\u043D\u044B
    \u0438 \u043A\u0430\u043D\u0430\u043B\u0430. *   **\u041F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0430\u044F
    \u0441\u043C\u0435\u043A\u0430\u043B\u043A\u0430**: \u0427\u0442\u043E\u0431\u044B
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u044B
    \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u0431\u043E\u0433\u0430\u0442\u044B,
    \u0424\u0430\u043B\u0435\u0441, \u043F\u0440\u0435\u0434\u0432\u0438\u0434\u044F
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0443\u0440\u043E\u0436\u0430\u0439
    \u043C\u0430\u0441\u043B\u0438\u043D, \u0437\u0430\u0440\u0430\u043D\u0435\u0435
    \u0441\u043A\u0443\u043F\u0438\u043B \u0432\u0441\u0435 \u043C\u0430\u0441\u043B\u043E\u0434\u0430\u0432\u0438\u043B\u044C\u043D\u0438
    \u0432 \u041C\u0438\u043B\u0435\u0442\u0435 \u0438 \u043D\u0430 \u0425\u0438\u043E\u0441\u0435.
    \u041A\u043E\u0433\u0434\u0430 \u0435\u0433\u043E \u043F\u0440\u043E\u0433\u043D\u043E\u0437
    \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u043B\u0441\u044F, \u043E\u043D \u0441
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0432\u044B\u0433\u043E\u0434\u043E\u0439
    \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0434\u0430\u043B \u0438\u0445.  ###
    \U0001F30C \u0424\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u043E\u0435
    \u0443\u0447\u0435\u043D\u0438\u0435  \u0413\u043B\u0430\u0432\u043D\u0430\u044F
    \u0437\u0430\u0441\u043B\u0443\u0433\u0430 \u0424\u0430\u043B\u0435\u0441\u0430
    \u2014 \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F \u043C\u0438\u0440\u0430,
    \u043E\u0442\u043A\u0430\u0437 \u043E\u0442 \u0447\u0438\u0441\u0442\u043E \u043C\u0438\u0444\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0432\u0437\u0433\u043B\u044F\u0434\u0430. \u0410\u0440\u0438\u0441\u0442\u043E\u0442\u0435\u043B\u044C
    \u0441\u0447\u0438\u0442\u0430\u043B \u0435\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u043C\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043A\u0438, \u0430 \u0434\u0440\u0443\u0433\u0438\u0435
    \u2014 \u0444\u0438\u0437\u0438\u043A\u0438, \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u0438
    \u0438 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438.  *   **\u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043E
    (\u0410\u0440\u0445\u044D)**: \u0424\u0430\u043B\u0435\u0441 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B,
    \u0447\u0442\u043E **\u0432\u043E\u0434\u0430 (\u0438\u043B\u0438 \u0432\u043B\u0430\u0436\u043D\u0430\u044F
    \u043F\u0440\u0438\u0440\u043E\u0434\u0430)** \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0435\u0440\u0432\u043E\u043E\u0441\u043D\u043E\u0432\u043E\u0439 \u0432\u0441\u0435\u0433\u043E
    \u0441\u0443\u0449\u0435\u0433\u043E. \u0412\u0441\u0435 \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u043E
    \u0438\u0437 \u0432\u043E\u0434\u044B \u0438 \u0432 \u043D\u0435\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.
    \u041E\u043D \u043F\u0440\u0438\u0448\u0435\u043B \u043A \u044D\u0442\u043E\u043C\u0443
    \u0432\u044B\u0432\u043E\u0434\u0443, \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044F,
    \u0447\u0442\u043E \u0432\u043B\u0430\u0433\u0430 \u2014 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0435
    \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u0436\u0438\u0437\u043D\u0438: \u0441\u0435\u043C\u0435\u043D\u0430
    \u0432\u043B\u0430\u0436\u043D\u044B, \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F
    \u043F\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u0432\u043E\u0434\u043E\u0439,
    \u0430 \u0434\u0430\u0436\u0435 \u0441\u043E\u043B\u043D\u0446\u0435 \u0438 \u0437\u0432\u0435\u0437\u0434\u044B
    \u043F\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u0432\u043E\u0434\u044F\u043D\u044B\u043C\u0438
    \u0438\u0441\u043F\u0430\u0440\u0435\u043D\u0438\u044F\u043C\u0438. *   **\u041A\u043E\u0441\u043C\u043E\u043B\u043E\u0433\u0438\u044F**:
    \u041E\u043D \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B
    \u0417\u0435\u043C\u043B\u044E \u0432 \u0432\u0438\u0434\u0435 \u043F\u043B\u043E\u0441\u043A\u043E\u0433\u043E
    \u0434\u0438\u0441\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043B\u0430\u0432\u0430\u0435\u0442
    \u043F\u043E \u0432\u043E\u0434\u0435, \u043F\u043E\u0434\u043E\u0431\u043D\u043E
    \u0434\u0435\u0440\u0435\u0432\u0443. *   **\u041F\u0430\u043D\u043F\u0441\u0438\u0445\u0438\u0437\u043C
    (\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u043C\u0438\u0440\u0430)**: \u0424\u0430\u043B\u0435\u0441 \u0441\u0447\u0438\u0442\u0430\u043B,
    \u0447\u0442\u043E \"\u0432\u0441\u0435 \u043F\u043E\u043B\u043D\u043E \u0431\u043E\u0433\u043E\u0432\"
    \u0438 \u0447\u0442\u043E \u043C\u0438\u0440 \u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D.
    \u0414\u0443\u0448\u043E\u0439, \u043F\u043E \u0435\u0433\u043E \u043C\u043D\u0435\u043D\u0438\u044E,
    \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442 \u0434\u0430\u0436\u0435 \u043C\u0430\u0433\u043D\u0438\u0442
    \u0438 \u044F\u043D\u0442\u0430\u0440\u044C, \u0442\u0430\u043A \u043A\u0430\u043A
    \u043E\u043D\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B \u0434\u0432\u0438\u0433\u0430\u0442\u044C
    \u0434\u0440\u0443\u0433\u0438\u0435 \u0442\u0435\u043B\u0430.  ### \U0001F4D0
    \u041D\u0430\u0443\u0447\u043D\u044B\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F 
    \u0424\u0430\u043B\u0435\u0441 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043E\u0441\u043D\u043E\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u0438\u043A\u043E\u043C
    \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0438 \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u0438. \u041C\u043D\u043E\u0433\u0438\u0435
    \u0435\u0433\u043E \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u044B \u043D\u0430 \u0437\u043D\u0430\u043D\u0438\u044F\u0445,
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0445 \u043D\u0430 \u0412\u043E\u0441\u0442\u043E\u043A\u0435,
    \u043D\u043E \u043E\u043D \u043F\u0435\u0440\u0432\u044B\u043C \u043D\u0430\u0447\u0430\u043B
    \u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C.  *   **\u0410\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u044F**:    
    *   **\u041F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043D\u0438\u0435
    \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u044F**:
    \u0421\u0430\u043C\u043E\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0435
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435. 28 \u043C\u0430\u044F
    585 \u0433\u043E\u0434\u0430 \u0434\u043E \u043D. \u044D. \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
    \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435 \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u0435,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0424\u0430\u043B\u0435\u0441 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043B.
    \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E \u0442\u043E\u0447\u043D\u043E
    \u0434\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E
    \u0436\u0438\u0437\u043D\u044C.     *   **\u041E\u0442\u043A\u0440\u044B\u0442\u0438\u044F**:
    \u041E\u043D \u0432\u0432\u0435\u043B \u0432 \u043E\u0431\u0438\u0445\u043E\u0434
    \u041F\u043E\u043B\u044F\u0440\u043D\u0443\u044E \u0437\u0432\u0435\u0437\u0434\u0443
    \u043A\u0430\u043A \u0431\u043E\u043B\u0435\u0435 \u0442\u043E\u0447\u043D\u044B\u0439
    \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0433\u043E\u0434\u0430 \u0432 365 \u0434\u043D\u0435\u0439 \u0438 \u0432\u0440\u0435\u043C\u044F
    \u0441\u043E\u043B\u043D\u0446\u0435\u0441\u0442\u043E\u044F\u043D\u0438\u0439.
    *   **\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430**:     *  
    \u0415\u043C\u0443 \u043F\u0440\u0438\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0442\u0435\u043E\u0440\u0435\u043C:         1.  \u0414\u0438\u0430\u043C\u0435\u0442\u0440
    \u0434\u0435\u043B\u0438\u0442 \u043A\u0440\u0443\u0433 \u043F\u043E\u043F\u043E\u043B\u0430\u043C.        
    2.  \u0423\u0433\u043B\u044B \u043F\u0440\u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438
    \u0440\u0430\u0432\u043D\u043E\u0431\u0435\u0434\u0440\u0435\u043D\u043D\u043E\u0433\u043E
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430 \u0440\u0430\u0432\u043D\u044B.        
    3.  \u0412\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
    \u0443\u0433\u043B\u044B \u0440\u0430\u0432\u043D\u044B.         4.  \u0420\u0430\u0432\u0435\u043D\u0441\u0442\u0432\u043E
    \u0434\u0432\u0443\u0445 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u0432
    \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0438 \u0434\u0432\u0443\u043C
    \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044E\u0449\u0438\u043C \u043A \u043D\u0435\u0439
    \u0443\u0433\u043B\u0430\u043C.     *   **\u0422\u0435\u043E\u0440\u0435\u043C\u0430
    \u0424\u0430\u043B\u0435\u0441\u0430**: \u0421 \u0435\u0433\u043E \u0438\u043C\u0435\u043D\u0435\u043C
    \u0442\u0430\u043A\u0436\u0435 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0442
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u043E \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u043E\u0442\u0440\u0435\u0437\u043A\u0430\u0445, \u043E\u0442\u0441\u0435\u043A\u0430\u0435\u043C\u044B\u0445
    \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u043F\u0440\u044F\u043C\u044B\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0448\u0438\u0440\u043E\u043A\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0432 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438 \u0438 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438.    
    *   **\u041F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438**: \u041E\u043D \u0438\u0437\u043C\u0435\u0440\u0438\u043B
    \u0432\u044B\u0441\u043E\u0442\u0443 \u0435\u0433\u0438\u043F\u0435\u0442\u0441\u043A\u0438\u0445
    \u043F\u0438\u0440\u0430\u043C\u0438\u0434 \u043F\u043E \u0438\u0445 \u0442\u0435\u043D\u0438
    \u0432 \u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442, \u043A\u043E\u0433\u0434\u0430
    \u0434\u043B\u0438\u043D\u0430 \u0435\u0433\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0442\u0435\u043D\u0438 \u0440\u0430\u0432\u043D\u044F\u043B\u0430\u0441\u044C
    \u0435\u0433\u043E \u0440\u043E\u0441\u0442\u0443.  ### \U0001F48E \u0418\u0442\u043E\u0433 
    \u0416\u0438\u0437\u043D\u044C \u0424\u0430\u043B\u0435\u0441\u0430 \u041C\u0438\u043B\u0435\u0442\u0441\u043A\u043E\u0433\u043E
    \u2014 \u044D\u0442\u043E \u043C\u043E\u0441\u0442 \u043C\u0435\u0436\u0434\u0443
    \u043C\u0438\u0444\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043F\u0440\u043E\u0448\u043B\u044B\u043C \u0438 \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C
    \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0435\u043C, \u043C\u0435\u0436\u0434\u0443
    \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C\u044E
    \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u043E\u0439 \u043D\u0430\u0443\u043A\u043E\u0439.
    \u0415\u0433\u043E \u0437\u0430\u0441\u043B\u0443\u0433\u0430 \u043D\u0435 \u0432
    \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0445 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F\u0445,
    \u0430 \u0432 \u0441\u0430\u043C\u043E\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0435
    \u043A \u043F\u043E\u0437\u043D\u0430\u043D\u0438\u044E \u043C\u0438\u0440\u0430,
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u043E\u043C \u043D\u0430 \u043F\u043E\u0438\u0441\u043A\u0435
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u0438\u0447\u0438\u043D
    \u044F\u0432\u043B\u0435\u043D\u0438\u0439. \u0418\u043C\u0435\u043D\u043D\u043E
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D \u043F\u043E \u043F\u0440\u0430\u0432\u0443
    \u043D\u043E\u0441\u0438\u0442 \u0442\u0438\u0442\u0443\u043B \"\u043E\u0442\u0446\u0430
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438\" \u0438 \u0435\u0433\u043E
    \u0438\u043C\u044F \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u043F\u0438\u0441\u043E\u043A
    \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043C\u0443\u0434\u0440\u0435\u0446\u043E\u0432
    \u0434\u0440\u0435\u0432\u043D\u043E\u0441\u0442\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043D\u044C \u0424\u0430\u043B\u0435\u0441\u0430
    \u041C\u0438\u043B\u0435\u0442\u0441\u043A\u043E\u0433\u043E, \u043A\u0430\u043A
    \u0438 \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u043E\u043B\u0443\u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E
    \u043C\u0443\u0434\u0440\u0435\u0446\u0430, \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0430
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E\u043C \u0437\u0430\u0431\u0430\u0432\u043D\u044B\u0445
    \u0438\u0441\u0442\u043E\u0440\u0438\u0439, \u043E\u0441\u0442\u0440\u043E\u0443\u043C\u043D\u044B\u0445
    \u0430\u0444\u043E\u0440\u0438\u0437\u043C\u043E\u0432 \u0438 \u043F\u043E\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0430\u043D\u0435\u043A\u0434\u043E\u0442\u043E\u0432. \u042D\u0442\u0438 \u043A\u0443\u0440\u044C\u0435\u0437\u043D\u044B\u0435
    \u0444\u0430\u043A\u0442\u044B \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437\u0432\u043B\u0435\u043A\u0430\u044E\u0442, \u043D\u043E \u0438
    \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0438\u0440\u0443\u044E\u0442
    \u0435\u0433\u043E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440, \u0443\u043C
    \u0438 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u043A \u0436\u0438\u0437\u043D\u0438.  
    \u0412\u043E\u0442 \u043F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \u0441\u0430\u043C\u044B\u0445
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445 \u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u043E \"\u043F\u0435\u0440\u0432\u043E\u043C
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0435\", \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0445\u0441\u044F
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0430\u043D\u0442\u0438\u0447\u043D\u044B\u043C
    \u0430\u0432\u0442\u043E\u0440\u0430\u043C:  ### \U0001F3E6 1. \u0424\u0438\u043B\u043E\u0441\u043E\u0444-\u043C\u0438\u043B\u043B\u0438\u043E\u043D\u0435\u0440
    (\u0438\u043B\u0438 \u043A\u0430\u043A \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043D\u0430 \u043E\u043B\u0438\u0432\u043A\u0430\u0445) \u042D\u0442\u043E \u0441\u0430\u043C\u044B\u0439
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043D\u0435\u043A\u0434\u043E\u0442 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438, \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u043D\u043D\u044B\u0439
    \u0410\u0440\u0438\u0441\u0442\u043E\u0442\u0435\u043B\u0435\u043C. \u0427\u0442\u043E\u0431\u044B
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u043A\u0435\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u043C \u0441\u043E\u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0430\u043C,
    \u0447\u0442\u043E \u043C\u0443\u0434\u0440\u0435\u0446\u044B \u043C\u043E\u0433\u0443\u0442
    \u0431\u044B\u0442\u044C \u0431\u043E\u0433\u0430\u0442\u044B, \u0435\u0441\u043B\u0438
    \u0437\u0430\u0445\u043E\u0442\u044F\u0442, \u0424\u0430\u043B\u0435\u0441 \u043E\u0434\u043D\u0430\u0436\u0434\u044B
    \u0437\u0438\u043C\u043E\u0439, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0441\u0432\u043E\u0438\u043C \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043F\u043E\u0437\u043D\u0430\u043D\u0438\u044F\u043C, \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043B
    \u043D\u0435\u0431\u044B\u0432\u0430\u043B\u044B\u0439 \u0443\u0440\u043E\u0436\u0430\u0439
    \u043C\u0430\u0441\u043B\u0438\u043D.  \u041E\u043D \u0442\u0438\u0445\u043E
    \u0441\u043A\u0443\u043F\u0438\u043B \u0432\u0441\u0435 \u043C\u0430\u0441\u043B\u043E\u0434\u0430\u0432\u0438\u043B\u044C\u043D\u0438
    (\u043F\u0440\u0435\u0441\u0441\u044B \u0434\u043B\u044F \u043E\u043B\u0438\u0432\u043E\u043A)
    \u0432 \u041C\u0438\u043B\u0435\u0442\u0435 \u0438 \u043D\u0430 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C
    \u043E\u0441\u0442\u0440\u043E\u0432\u0435 \u0425\u0438\u043E\u0441 \u0437\u0430
    \u0431\u0435\u0441\u0446\u0435\u043D\u043E\u043A, \u0442\u0430\u043A \u043A\u0430\u043A
    \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0445\u043E\u0442\u0435\u043B \u0438\u0445
    \u0431\u0440\u0430\u0442\u044C. \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B
    \u0441\u0435\u0437\u043E\u043D \u0441\u0431\u043E\u0440\u0430 \u0443\u0440\u043E\u0436\u0430\u044F,
    \u0441\u043F\u0440\u043E\u0441 \u043D\u0430 \u0434\u0430\u0432\u0438\u043B\u044C\u043D\u0438
    \u0432\u0437\u043B\u0435\u0442\u0435\u043B \u0434\u043E \u043D\u0435\u0431\u0435\u0441,
    \u0438 \u0424\u0430\u043B\u0435\u0441 \u0441 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439
    \u0432\u044B\u0433\u043E\u0434\u043E\u0439 \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0434\u0430\u043B
    \u0438\u0445. \u0422\u0430\u043A \u043E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u044B \u043B\u0435\u0433\u043A\u043E
    \u043C\u043E\u0433\u0443\u0442 \u0440\u0430\u0437\u0431\u043E\u0433\u0430\u0442\u0435\u0442\u044C,
    \u043D\u043E \u0438\u0445 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B \u043B\u0435\u0436\u0430\u0442
    \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438. 
    ### \U0001F926\u200D\u2642\uFE0F 2. \u041F\u0430\u0434\u0435\u043D\u0438\u0435
    \u0432 \u043A\u043E\u043B\u043E\u0434\u0435\u0446 (\u043D\u0430\u0441\u043C\u0435\u0448\u043A\u0430
    \u0441\u043B\u0443\u0436\u0430\u043D\u043A\u0438) \u0421\u0430\u043C\u0430\u044F
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u0431\u044B\u0442\u043E\u0432\u0430\u044F
    \u0438\u0441\u0442\u043E\u0440\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043A\u0440\u0430\u0441\u043D\u043E\u0440\u0435\u0447\u0438\u0432\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0440\u0430\u0437\u043D\u0438\u0446\u0443 \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0437\u0435\u0440\u0446\u0430\u043D\u0438\u0435\u043C
    \u043D\u0435\u0431\u0430 \u0438 \u0431\u044B\u0442\u043E\u043C. \u041E\u0434\u043D\u0430\u0436\u0434\u044B
    \u043D\u043E\u0447\u044C\u044E \u0424\u0430\u043B\u0435\u0441 \u0448\u0435\u043B
    \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435, \u0438\u0437\u0443\u0447\u0430\u044F
    \u0437\u0432\u0435\u0437\u0434\u043D\u043E\u0435 \u043D\u0435\u0431\u043E, \u0438
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0432\u043B\u0435\u043A\u0441\u044F,
    \u0447\u0442\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u043A\u043E\u043B\u043E\u0434\u0446\u0430
    \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439
    \u0438 **\u0440\u0443\u0445\u043D\u0443\u043B \u0432 \u043D\u0435\u0433\u043E**.
    \u041D\u0430 \u0435\u0433\u043E \u043A\u0440\u0438\u043A\u0438 \u043E \u043F\u043E\u043C\u043E\u0449\u0438
    \u043F\u0440\u0438\u0431\u0435\u0436\u0430\u043B\u0430 \u0444\u0440\u0430\u043A\u0438\u0439\u0441\u043A\u0430\u044F
    \u0441\u043B\u0443\u0436\u0430\u043D\u043A\u0430, \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0430
    \u0435\u0433\u043E \u0438 \u0441 \u0438\u0440\u043E\u043D\u0438\u0435\u0439 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430: 
    *\"\u0422\u044B, \u0424\u0430\u043B\u0435\u0441, \u0445\u043E\u0447\u0435\u0448\u044C
    \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u043D\u0430 \u043D\u0435\u0431\u0435,
    \u0430 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F
    \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438, \u0434\u0430\u0436\u0435
    \u043D\u0435 \u0432\u0438\u0434\u0438\u0448\u044C\"*.  \u041F\u043E\u0437\u0436\u0435
    \u041F\u043B\u0430\u0442\u043E\u043D \u044F\u0437\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u0447\u0442\u043E \u044D\u0442\u0430
    \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E
    \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442, \u043A\u0430\u043A
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u044B \u0431\u044B\u0432\u0430\u044E\u0442
    \u0431\u0435\u0441\u043F\u043E\u043C\u043E\u0449\u043D\u044B \u0432 \u0436\u0438\u0442\u0435\u0439\u0441\u043A\u0438\u0445
    \u043C\u0435\u043B\u043E\u0447\u0430\u0445.  ### \U0001F9F2 3. \"\u0412\u0441\u0451
    \u043F\u043E\u043B\u043D\u043E \u0431\u043E\u0433\u043E\u0432\" (\u043C\u0430\u0433\u043D\u0438\u0442
    \u0438 \u044F\u043D\u0442\u0430\u0440\u044C) \u0424\u0430\u043B\u0435\u0441 \u0431\u044B\u043B
    \u043F\u0435\u0440\u0432\u044B\u043C, \u043A\u0442\u043E \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
    \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u044F\u0432\u043B\u0435\u043D\u0438\u0435
    \u043C\u0430\u0433\u043D\u0435\u0442\u0438\u0437\u043C\u0430. \u0423\u0432\u0438\u0434\u0435\u0432,
    \u0447\u0442\u043E \u043C\u0430\u0433\u043D\u0438\u0442 (\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u0439
    \u0436\u0435\u043B\u0435\u0437\u043D\u044F\u043A) \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
    \u0436\u0435\u043B\u0435\u0437\u043E, \u0424\u0430\u043B\u0435\u0441 \u0437\u0430\u044F\u0432\u0438\u043B,
    \u0447\u0442\u043E \u0443 \u043A\u0430\u043C\u043D\u044F **\u0435\u0441\u0442\u044C
    \u0434\u0443\u0448\u0430**.  \u041E\u043D \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u043B
    \u043B\u043E\u0433\u0438\u0447\u043D\u043E: \u0440\u0430\u0437 \u043A\u0430\u043C\u0435\u043D\u044C
    \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442\u044C
    \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0436\u0435\u043B\u0435\u0437\u043E,
    \u0437\u043D\u0430\u0447\u0438\u0442, \u043E\u043D \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D\u043D\u044B\u043C. \u0422\u043E
    \u0436\u0435 \u0441\u0430\u043C\u043E\u0435 \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B
    \u0438 \u043F\u0440\u043E \u044F\u043D\u0442\u0430\u0440\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u043E\u0441\u043B\u0435 \u043D\u0430\u0442\u0438\u0440\u0430\u043D\u0438\u044F
    \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u043B\u0435\u0433\u043A\u0438\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B (\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0437\u0430\u0446\u0438\u044F).
    \u0422\u0430\u043A \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u0435\u0433\u043E
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0430\u044F \u0444\u0440\u0430\u0437\u0430:
    *\"\u0412\u0441\u0435 \u0432\u0435\u0449\u0438 \u0438\u043C\u0435\u044E\u0442
    \u0434\u0443\u0448\u0443\"* \u0438\u043B\u0438 *\"\u041C\u0438\u0440 \u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D\"*. 
    ### \U0001F4D0 4. \u041A\u0430\u043A \u0438\u0437\u043C\u0435\u0440\u0438\u0442\u044C
    \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u0443 \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u0440\u043E\u0441\u0442\u0443 \u041A\u043E\u0433\u0434\u0430 \u0424\u0430\u043B\u0435\u0441
    \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u043F\u043E \u0415\u0433\u0438\u043F\u0442\u0443, \u0444\u0430\u0440\u0430\u043E\u043D
    \u0438\u043B\u0438 \u0436\u0440\u0435\u0446\u044B \u0437\u0430\u0445\u043E\u0442\u0435\u043B\u0438
    \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u044C \u0435\u0433\u043E \u0438 \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0438,
    \u043C\u043E\u0436\u0435\u0442 \u043B\u0438 \u043E\u043D \u0438\u0437\u043C\u0435\u0440\u0438\u0442\u044C
    \u0432\u044B\u0441\u043E\u0442\u0443 \u0412\u0435\u043B\u0438\u043A\u043E\u0439
    \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u044B, \u043D\u0435 \u0432\u0437\u0431\u0438\u0440\u0430\u044F\u0441\u044C
    \u043D\u0430 \u043D\u0435\u0435.  \u0424\u0430\u043B\u0435\u0441 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E.
    \u041E\u043D \u0432\u043E\u0442\u043A\u043D\u0443\u043B \u0441\u0432\u043E\u044E
    \u0442\u0440\u043E\u0441\u0442\u044C \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E
    \u0432 \u0437\u0435\u043C\u043B\u044E \u0438 \u0434\u043E\u0436\u0434\u0430\u043B\u0441\u044F
    \u043C\u043E\u043C\u0435\u043D\u0442\u0430, \u043A\u043E\u0433\u0434\u0430 \u0434\u043B\u0438\u043D\u0430
    \u0442\u0435\u043D\u0438 \u043E\u0442 \u0442\u0440\u043E\u0441\u0442\u0438 \u0441\u0442\u0430\u043B\u0430
    **\u0440\u043E\u0432\u043D\u043E \u0440\u0430\u0432\u043D\u0430 \u0434\u043B\u0438\u043D\u0435
    \u0441\u0430\u043C\u043E\u0439 \u0442\u0440\u043E\u0441\u0442\u0438**. \u0412
    \u044D\u0442\u043E\u0442 \u043C\u0438\u0433 \u043E\u043D \u0438\u0437\u043C\u0435\u0440\u0438\u043B
    \u0434\u043B\u0438\u043D\u0443 \u0442\u0435\u043D\u0438 \u043E\u0442 \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u044B
    \u2014 \u0438 \u043E\u043D\u0430 \u0441\u0442\u0430\u043B\u0430 \u0440\u0430\u0432\u043D\u0430
    \u0435\u0435 \u0432\u044B\u0441\u043E\u0442\u0435. \u042D\u0442\u043E\u0442 \u043C\u0435\u0442\u043E\u0434,
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u043F\u043E\u0434\u043E\u0431\u0438\u0438
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u0432,
    \u043D\u0430 \u0432\u0435\u043A\u0430 \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B
    \u0435\u0433\u043E \u0441\u0440\u0435\u0434\u0438 \u0435\u0433\u0438\u043F\u0442\u044F\u043D. 
    ### \u26F5 5. \u0422\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0438 \u0441 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u043E\u043C
    \u0440\u0435\u043A\u0438 \u0413\u0430\u043B\u0438\u0441 \u041A\u043E\u0433\u0434\u0430
    \u0446\u0430\u0440\u044C \u041A\u0440\u0435\u0437 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
    \u0432 \u043F\u043E\u0445\u043E\u0434 \u043D\u0430 \u043F\u0435\u0440\u0441\u043E\u0432,
    \u0435\u0433\u043E \u0430\u0440\u043C\u0438\u044F \u0443\u043F\u0435\u0440\u043B\u0430\u0441\u044C
    \u0432 \u0448\u0438\u0440\u043E\u043A\u0443\u044E \u0440\u0435\u043A\u0443 \u0413\u0430\u043B\u0438\u0441.
    \u0424\u0430\u043B\u0435\u0441, \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u0432\u0448\u0438\u0439
    \u0432\u043E\u0439\u0441\u043A\u043E, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u043D\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043C\u043E\u0441\u0442\u043E\u0432,
    \u0430 **\"\u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0440\u0435\u043A\u0443
    \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0439\u0441\u043A\u043E\"**.
    \u041E\u043D \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B \u0432\u044B\u0440\u044B\u0442\u044C
    \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u043A\u0430\u043D\u0430\u043B
    \u043F\u043E\u0437\u0430\u0434\u0438 \u043B\u0430\u0433\u0435\u0440\u044F, \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0432
    \u0432 \u043D\u0435\u0433\u043E \u0432\u043E\u0434\u044B \u0440\u0435\u043A\u0438,
    \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u043D\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043B\u0430\u0441\u044C
    \u043D\u0430 \u0434\u0432\u0430 \u043C\u0435\u043B\u043A\u0438\u0445 \u0440\u0443\u0447\u044C\u044F,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u043E\u0439\u0441\u043A\u043E
    \u043B\u0435\u0433\u043A\u043E \u043F\u0435\u0440\u0435\u0448\u043B\u043E \u0432\u0431\u0440\u043E\u0434.  
    ### \U0001F476 6. \u0424\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044F \u043E\u0442\u043A\u0430\u0437\u0430
    \u043E\u0442 \u0431\u0440\u0430\u043A\u0430 \u0414\u0438\u043E\u0433\u0435\u043D
    \u041B\u0430\u044D\u0440\u0442\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
    \u0434\u0438\u0430\u043B\u043E\u0433 \u0424\u0430\u043B\u0435\u0441\u0430 \u0441
    \u043C\u0430\u0442\u0435\u0440\u044C\u044E, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0430
    \u043E\u0442 \u043D\u0435\u0433\u043E \u0436\u0435\u043D\u0438\u0442\u044C\u0441\u044F.
    \u041D\u0430 \u0443\u0433\u043E\u0432\u043E\u0440\u044B \u043C\u0430\u0442\u0435\u0440\u0438
    \u043E\u043D \u043E\u0442\u0432\u0435\u0447\u0430\u043B: *\"\u0421\u043B\u0438\u0448\u043A\u043E\u043C
    \u0440\u0430\u043D\u043E!\"*, \u0430 \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430
    \u043F\u0440\u0438\u0448\u043B\u0430 \u043A \u043D\u0435\u043C\u0443 \u0447\u0435\u0440\u0435\u0437
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442, \u043E\u043D
    \u0441\u043A\u0430\u0437\u0430\u043B: *\"\u0421\u043B\u0438\u0448\u043A\u043E\u043C
    \u043F\u043E\u0437\u0434\u043D\u043E!\"*.  \u0410 \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441,
    \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D \u0441\u0430\u043C \u043D\u0435
    \u0437\u0430\u0432\u043E\u0434\u0438\u0442 \u0434\u0435\u0442\u0435\u0439, \u0424\u0430\u043B\u0435\u0441
    \u0438\u0440\u043E\u043D\u0438\u0447\u043D\u043E \u043E\u0442\u0432\u0435\u0447\u0430\u043B:
    *\"\u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0434\u0435\u0442\u0435\u0439,
    \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0441\u0438\u043B\u044C\u043D\u043E \u0438\u0445 \u043B\u044E\u0431\u043B\u044E\"*
    (\u043F\u043E\u0434\u0440\u0430\u0437\u0443\u043C\u0435\u0432\u0430\u044F, \u0447\u0442\u043E
    \u0431\u043E\u0438\u0442\u0441\u044F \u0437\u0430 \u043D\u0438\u0445 \u0438 \u043D\u0435
    \u0445\u043E\u0447\u0435\u0442 \u043E\u0433\u043E\u0440\u0447\u0435\u043D\u0438\u0439). 
    ### \U0001F4DD 7. \u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u043A\u043D\u0438\u0433 \u043A\u0430\u043A \u0441\u0430\u043C\u044B\u0439 \u0433\u0440\u043E\u043C\u043A\u0438\u0439
    \u043A\u0443\u0440\u044C\u0435\u0437 \u0421\u0430\u043C\u044B\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0444\u0430\u043A\u0442 \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438
    \u0424\u0430\u043B\u0435\u0441\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E **\u043E\u043D \u043D\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043B
    \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u043A\u043D\u0438\u0433\u0438**.
    \u0412\u0441\u0435, \u0447\u0442\u043E \u043C\u044B \u0437\u043D\u0430\u0435\u043C
    \u043E \u043D\u0435\u043C, \u2014 \u044D\u0442\u043E \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437
    \u0435\u0433\u043E \u0443\u0441\u0442\u043D\u044B\u0445 \u043B\u0435\u043A\u0446\u0438\u0439
    \u0438 \u043B\u0435\u043A\u0446\u0438\u0439 \u0435\u0433\u043E \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432.
    \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0437\u0434\u043D\u0438\u0435
    \u0430\u043D\u0442\u0438\u0447\u043D\u044B\u0435 \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u0438
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0421\u043E\u0442\u0438\u043E\u043D)
    \u043F\u0440\u0438\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0438 \u0435\u043C\u0443
    \u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u043E \u0434\u0432\u0443\u0445
    \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0441\u043E\u0447\u0438\u043D\u0435\u043D\u0438\u0439:
    *\xAB\u041E \u0441\u043E\u043B\u043D\u0446\u0435\u0441\u0442\u043E\u044F\u043D\u0438\u0438\xBB*
    \u0438 *\xAB\u041E \u0440\u0430\u0432\u043D\u043E\u0434\u0435\u043D\u0441\u0442\u0432\u0438\u0438\xBB*,
    \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435
    \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432\u043E \u043C\u043D\u0435\u043D\u0438\u0438,
    \u0447\u0442\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u043E\u0439.
    \u041E\u043D \u0431\u044B\u043B \u0447\u0438\u0441\u0442\u044B\u043C \"\u043E\u0440\u0430\u0442\u043E\u0440\u043E\u043C\"
    \u0438 \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C, \u043D\u0435 \u043B\u044E\u0431\u0438\u0432\u0448\u0438\u043C
    \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0438
    \u043C\u044B\u0441\u043B\u0438.  ### \u26B0\uFE0F 8. \u041F\u043E\u0447\u0442\u0438
    \u043E\u043B\u0438\u043C\u043F\u0438\u0439\u0441\u043A\u0430\u044F \u0441\u043C\u0435\u0440\u0442\u044C
    \u0424\u0430\u043B\u0435\u0441 \u0443\u043C\u0435\u0440 \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
    \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0438. \u041A\u0443\u0440\u044C\u0435\u0437
    \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432
    \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u0438 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
    \u0414\u0438\u043E\u0433\u0435\u043D \u041B\u0430\u044D\u0440\u0442\u0441\u043A\u0438\u0439:
    \u043E\u043D \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F **\u043E\u0442
    \u0436\u0430\u0440\u044B \u0438 \u0436\u0430\u0436\u0434\u044B**, \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044F
    \u0437\u0430 \u0433\u0438\u043C\u043D\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    (\u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u043C\u0438) \u0441\u043E\u0441\u0442\u044F\u0437\u0430\u043D\u0438\u044F\u043C\u0438.
    \u0411\u0443\u0434\u0443\u0447\u0438 \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0430\u0440\u044B\u043C
    \u0438 \u0438\u0437\u043C\u043E\u0436\u0434\u0435\u043D\u043D\u044B\u043C \u043D\u0430
    \u0441\u043E\u043B\u043D\u0446\u0435\u043F\u0435\u043A\u0435, \u043E\u043D \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
    \u043F\u0438\u0442\u044C, \u043D\u043E \u0432\u043E\u0434\u044B \u0440\u044F\u0434\u043E\u043C
    \u043D\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0438 \u043E\u043D
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F \u043F\u0440\u044F\u043C\u043E
    \u043D\u0430 \u0442\u0440\u0438\u0431\u0443\u043D\u0435, \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u044F\u0441\u044C
    \u0437\u0440\u0435\u043B\u0438\u0449\u0435\u043C.  ### \U0001F52E 9. \u0425\u0438\u0442\u0440\u043E\u0441\u0442\u044C
    \u0441 \u0442\u0440\u043E\u0439\u043D\u044B\u043C \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0435\u043C
    \u0432 \u043B\u043E\u0442\u0435\u0440\u0435\u0435 \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0435\u0449\u0435 \u043E\u0434\u0438\u043D \u043C\u0430\u043B\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u043A\u0443\u0440\u044C\u0435\u0437, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F
    \u0443 \u041F\u043B\u0443\u0442\u0430\u0440\u0445\u0430. \u0424\u0430\u043B\u0435\u0441
    \u0447\u0430\u0441\u0442\u043E \u0441\u043F\u043E\u0440\u0438\u043B \u0441 \u043B\u043E\u0432\u043A\u0438\u043C\u0438
    \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430\u043C\u0438. \u041E\u0434\u043D\u0430\u0436\u0434\u044B
    \u043E\u043D \u0440\u0435\u0448\u0438\u043B \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0439
    \u0438\u0433\u0440\u0435 (\u0432 \u043A\u043E\u0441\u0442\u0438 \u0438\u043B\u0438
    \u0436\u0440\u0435\u0431\u0438\u0438) \u0443\u043C \u043F\u0440\u0435\u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
    \u043D\u0430\u0434 \u0443\u0434\u0430\u0447\u0435\u0439. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
    \u043E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0430\u043C
    \u0441\u044B\u0433\u0440\u0430\u0442\u044C \u043D\u0430 \u0434\u0435\u043D\u044C\u0433\u0438,
    \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0440\u0430\u0441\u0447\u0435\u0442\u0443
    \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u043C\u0443 \u0432\u0435\u0437\u0435\u043D\u0438\u044E
    \u0432\u044B\u0438\u0433\u0440\u0430\u043B \u0442\u0440\u0438\u0436\u0434\u044B
    \u043F\u043E\u0434\u0440\u044F\u0434, \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E
    \u0437\u0430\u0431\u0440\u0430\u043B \u0432\u044B\u0438\u0433\u0440\u044B\u0448
    \u0438 \u0437\u0430\u044F\u0432\u0438\u043B: *\"\u042F \u0434\u043E\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0444\u0438\u043B\u043E\u0441\u043E\u0444 \u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0438 \u044D\u0442\u043E, \u0435\u0441\u043B\u0438
    \u0437\u0430\u0445\u043E\u0447\u0435\u0442\"*."
