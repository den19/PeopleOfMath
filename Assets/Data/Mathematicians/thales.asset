  achievementsRu: "\u0424\u0430\u043b\u0435\u0441 \u041c\u0438\u043b\u0435\u0442\u0441\u043a\u0438\u0439 \u043d\u0435
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432, \u0438 \u0432\u0441\u0435 \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043d\u0430\u043c \u043f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c
    \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432,
    \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044c,
    \u041f\u0440\u043e\u043a\u043b \u0438 \u0413\u0435\u0440\u043e\u0434\u043e\u0442. \u0422\u0435\u043c
    \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u043e\u043d \u043f\u043e \u043f\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439 \u043d\u0430\u0443\u043a\u0438,
    \u0438 \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u0435\u043d.
    \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u043e\u0442 \u043c\u0438\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0439 \u043c\u0438\u0440\u0430 \u043a
    \u0435\u0433\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044e. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439.\n\n\U0001F9EE
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0424\u0430\u043b\u0435\u0441
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0432\u044b\u043c
    \u0433\u0440\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0432\u0435\u043b
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430, \u0441\u0434\u0435\u043b\u0430\u0432
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0430\u0432\u0438\u043b. \u0415\u043c\u0443 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c: 1. \u041a\u0440\u0443\u0433 \u0434\u0435\u043b\u0438\u0442\u0441\u044f
    \u0434\u0438\u0430\u043c\u0435\u0442\u0440\u043e\u043c \u043f\u043e\u043f\u043e\u043b\u0430\u043c.
    2. \u0423\u0433\u043b\u044b \u043f\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438
    \u0440\u0430\u0432\u043d\u043e\u0431\u0435\u0434\u0440\u0435\u043d\u043d\u043e\u0433\u043e
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 \u0440\u0430\u0432\u043d\u044b.
    3. \u0412\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0443\u0433\u043b\u044b,
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0435\u043c
    \u0434\u0432\u0443\u0445 \u043f\u0440\u044f\u043c\u044b\u0445, \u0440\u0430\u0432\u043d\u044b.
    4. \u0420\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u043e \u0434\u0432\u0443\u0445 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432
    \u043f\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u0438 \u0434\u0432\u0443\u043c
    \u043f\u0440\u0438\u043b\u0435\u0436\u0430\u0449\u0438\u043c \u043a \u043d\u0435\u0439 \u0443\u0433\u043b\u0430\u043c.
    5. \u0412\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0439 \u0443\u0433\u043e\u043b, \u043e\u043f\u0438\u0440\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u043d\u0430 \u0434\u0438\u0430\u043c\u0435\u0442\u0440, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u0440\u044f\u043c\u044b\u043c (\u044d\u0442\u0443 \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0442\u0435\u043e\u0440\u0435\u043c\u043e\u0439
    \u0424\u0430\u043b\u0435\u0441\u0430). \u0421\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0430\u043b\u0435\u0441\u0430 (\u043e
    \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u043e\u0442\u0440\u0435\u0437\u043a\u0430\u0445, \u043e\u0442\u0441\u0435\u043a\u0430\u0435\u043c\u044b\u0445
    \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u0440\u044f\u043c\u044b\u043c\u0438
    \u043d\u0430 \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u0445 \u0443\u0433\u043b\u0430),
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u043f\u0438\u0441\u0430\u043d\u0430
    \u0435\u043c\u0443 \u043f\u043e\u0437\u0436\u0435, \u0442\u0430\u043a \u043a\u0430\u043a
    \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u0441 \u0435\u0433\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f.
    \u041f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0435 \u0432 \u043d\u0435\u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0435\u0439\u0441\u044f
    \u043a\u043d\u0438\u0433\u0435 \u043f\u043e \u043c\u043e\u0440\u0441\u043a\u043e\u0439 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438.
    \u0424\u0430\u043b\u0435\u0441 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c
    \u0441\u0432\u043e\u0438\u0445 \u0437\u043d\u0430\u043d\u0438\u0439: \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435
    \u0432\u044b\u0441\u043e\u0442\u044b \u043f\u0438\u0440\u0430\u043c\u0438\u0434: \u041e\u043d
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u0432\u044b\u0441\u043e\u0442\u0443
    \u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0445 \u043f\u0438\u0440\u0430\u043c\u0438\u0434,
    \u0438\u0437\u043c\u0435\u0440\u0438\u0432 \u0438\u0445 \u0442\u0435\u043d\u044c \u0432
    \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u0434\u043b\u0438\u043d\u0430
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043d\u0438
    \u0440\u0430\u0432\u043d\u044f\u043b\u0430\u0441\u044c \u0435\u0433\u043e \u0440\u043e\u0441\u0442\u0443.
    \u042d\u0442\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043e \u043d\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435
    \u043f\u043e\u0434\u043e\u0431\u0438\u044f \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432.
    \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u0434\u043e \u043a\u043e\u0440\u0430\u0431\u043b\u044f \u0432 \u043c\u043e\u0440\u0435:
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u0434\u043e \u0441\u0443\u0434\u043d\u0430, \u043d\u0430\u0445\u043e\u0434\u044f\u0449\u0435\u0433\u043e\u0441\u044f
    \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c \u043c\u043e\u0440\u0435, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f.\n\n\U0001F30C
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f: \u041f\u0440\u043e\u0432\u0438\u0434\u0435\u043d\u0438\u0435
    \u0438 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0424\u0430\u043b\u0435\u0441\u0430
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438 \u0441\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435
    \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0438 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0438 \u0435\u0433\u043e \u0438\u043c\u044f
    \u043f\u043e \u0432\u0441\u0435\u0439 \u0413\u0440\u0435\u0446\u0438\u0438. \u041f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u044f:
    \u0415\u0433\u043e \u0441\u0430\u043c\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u2014 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e
    28 \u043c\u0430\u044f 585 \u0433\u043e\u0434\u0430 \u0434\u043e \u043d. \u044d.. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u044d\u0442\u043e \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0435
    \u043f\u0440\u0435\u0440\u0432\u0430\u043b\u043e \u0431\u0438\u0442\u0432\u0443 \u043c\u0435\u0436\u0434\u0443
    \u043b\u0438\u0434\u0438\u0439\u0446\u0430\u043c\u0438 \u0438 \u043c\u0438\u0434\u044f\u043d\u0430\u043c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 \u0441\u0442\u0440\u0430\u0445\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0438\u043b\u0438
    \u043c\u0438\u0440. \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0432\u0430\u0432\u0438\u043b\u043e\u043d\u0441\u043a\u0438\u0435 \u0437\u043d\u0430\u043d\u0438\u044f
    \u043e \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0438\u0445\u0441\u044f \u0446\u0438\u043a\u043b\u0430\u0445
    \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0439, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u043a\u0430\u043a \"\u0441\u0430\u0440\u043e\u0441\". \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0432 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u0438 \u043a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0438:
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0424\u0430\u043b\u0435\u0441:
    \u041e\u0442\u043a\u0440\u044b\u043b \u043d\u0430\u043a\u043b\u043e\u043d \u044d\u043a\u043b\u0438\u043f\u0442\u0438\u043a\u0438
    (\u0432\u0438\u0434\u0438\u043c\u043e\u0433\u043e \u043f\u0443\u0442\u0438 \u0421\u043e\u043b\u043d\u0446\u0430
    \u043f\u043e \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u0441\u0444\u0435\u0440\u0435)
    \u043a \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u043c\u0443 \u044d\u043a\u0432\u0430\u0442\u043e\u0440\u0443.
    \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0433\u043e\u0434\u0430 \u0432 365 \u0434\u043d\u0435\u0439. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0432\u0440\u0435\u043c\u044f \u0441\u043e\u043b\u043d\u0446\u0435\u0441\u0442\u043e\u044f\u043d\u0438\u0439
    \u0438 \u0440\u0430\u0432\u043d\u043e\u0434\u0435\u043d\u0441\u0442\u0432\u0438\u0439. \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0432\u0438\u0434\u0438\u043c\u044b\u0439 \u0443\u0433\u043b\u043e\u0432\u043e\u0439 \u0440\u0430\u0437\u043c\u0435\u0440
    \u0421\u043e\u043b\u043d\u0446\u0430 \u0438 \u041b\u0443\u043d\u044b. \u041e\u0431\u044a\u044f\u0441\u043d\u0438\u043b,
    \u0447\u0442\u043e \u041b\u0443\u043d\u0430 \u0441\u0432\u0435\u0442\u0438\u0442 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c
    \u0441\u0432\u0435\u0442\u043e\u043c \u0421\u043e\u043b\u043d\u0446\u0430, \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445
    \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0439. \u0412\u0432\u0435\u043b \u0432 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044e
    \u041f\u043e\u043b\u044f\u0440\u043d\u0443\u044e \u0437\u0432\u0435\u0437\u0434\u0443 (\u0432
    \u0441\u043e\u0437\u0432\u0435\u0437\u0434\u0438\u0438 \u041c\u0430\u043b\u043e\u0439 \u041c\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u044b)
    \u043a\u0430\u043a \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440, \u0447\u0435\u043c\u0443
    \u043d\u0430\u0443\u0447\u0438\u043b\u0441\u044f \u0443 \u0444\u0438\u043d\u0438\u043a\u0438\u0439\u0446\u0435\u0432.\n\n\U0001F4A7
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f: \u041f\u0435\u0440\u0432\u043e\u043e\u0441\u043d\u043e\u0432\u0430
    \u0432\u0441\u0435\u0433\u043e \u0441\u0443\u0449\u0435\u0433\u043e \u0413\u043b\u0430\u0432\u043d\u0430\u044f
    \u0437\u0430\u0441\u043b\u0443\u0433\u0430 \u0424\u0430\u043b\u0435\u0441\u0430 \u043a\u0430\u043a
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430 \u2014 \u044d\u0442\u043e \u043f\u0435\u0440\u0432\u0430\u044f
    \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u043d\u0430\u0439\u0442\u0438 \u0435\u0434\u0438\u043d\u043e\u0435
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u043e
    \u0432\u0441\u0435\u0445 \u0432\u0435\u0449\u0435\u0439. \u0412\u043e\u0434\u0430 \u043a\u0430\u043a
    \u0430\u0440\u0445\u044d: \u041e\u043d \u043f\u0440\u043e\u0432\u043e\u0437\u0433\u043b\u0430\u0441\u0438\u043b,
    \u0447\u0442\u043e \u0432\u043e\u0434\u0430 (\u0438\u043b\u0438 \u0432\u043b\u0430\u0436\u043d\u0430\u044f
    \u043f\u0440\u0438\u0440\u043e\u0434\u0430) \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u0435\u0440\u0432\u043e\u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0438 \u0441\u0443\u0431\u0441\u0442\u0430\u043d\u0446\u0438\u0435\u0439
    \u0432\u0441\u0435\u0433\u043e \u0441\u0443\u0449\u0435\u0433\u043e (\"\u0432\u0441\u0435
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0438\u0437 \u0432\u043e\u0434\u044b
    \u0438 \u0432 \u043d\u0435\u0435 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f\").
    \u041a \u044d\u0442\u043e\u043c\u0443 \u0432\u044b\u0432\u043e\u0434\u0443 \u0435\u0433\u043e
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f:
    \u0432\u043b\u0430\u0433\u0430 \u2014 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0435
    \u0443\u0441\u043b\u043e\u0432\u0438\u0435 \u0436\u0438\u0437\u043d\u0438, \u0438\u0437
    \u0432\u043b\u0430\u0436\u043d\u043e\u0433\u043e \u0441\u0435\u043c\u0435\u043d\u0438 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442
    \u0432\u0441\u0435 \u0436\u0438\u0432\u043e\u0435, \u0430 \u0432\u043e\u0437\u0434\u0443\u0445
    \u0438 \u0434\u0430\u0436\u0435 \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0435 \u0441\u0432\u0435\u0442\u0438\u043b\u0430
    \u043f\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u0432\u043e\u0434\u044f\u043d\u044b\u043c\u0438
    \u0438\u0441\u043f\u0430\u0440\u0435\u043d\u0438\u044f\u043c\u0438. \u041e\u0434\u0443\u0448\u0435\u0432\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043c\u0438\u0440\u0430 (\u043f\u0430\u043d\u043f\u0441\u0438\u0445\u0438\u0437\u043c):
    \u0424\u0430\u043b\u0435\u0441 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \"\u0432\u0441\u0435 \u043f\u043e\u043b\u043d\u043e \u0431\u043e\u0433\u043e\u0432\" \u0438
    \u0447\u0442\u043e \u043c\u0438\u0440 \u043e\u0434\u0443\u0448\u0435\u0432\u043b\u0435\u043d.
    \u041e\u043d \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u043b \u0434\u0443\u0448\u0443
    \u0434\u0430\u0436\u0435 \u043c\u0430\u0433\u043d\u0438\u0442\u0443, \u0442\u0430\u043a
    \u043a\u0430\u043a \u043e\u043d \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442\u044c
    \u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0436\u0435\u043b\u0435\u0437\u043e.
    \u041a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u044f: \u041e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0417\u0435\u043c\u043b\u044e \u043a\u0430\u043a \u043f\u043b\u043e\u0441\u043a\u0438\u0439
    \u0434\u0438\u0441\u043a, \u043f\u043b\u0430\u0432\u0430\u044e\u0449\u0438\u0439 \u0432
    \u0432\u043e\u0434\u0435.\n\n\U0001F4DC \u041f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0424\u0430\u043b\u0435\u0441 \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043a\u043d\u0438\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e\u0448\u043b\u0438
    \u0431\u044b \u0434\u043e \u043d\u0430\u0441. \u0410\u043d\u0442\u0438\u0447\u043d\u044b\u0435
    \u0430\u0432\u0442\u043e\u0440\u044b \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u0435\u043c\u0443 \u0434\u0432\u0430 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f: \u00ab\u041e \u0441\u043e\u043b\u043d\u0446\u0435\u0441\u0442\u043e\u044f\u043d\u0438\u0438\u00bb
    \u0438 \u00ab\u041e \u0440\u0430\u0432\u043d\u043e\u0434\u0435\u043d\u0441\u0442\u0432\u0438\u0438\u00bb,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u00ab\u0421\u0443\u0434\u043e\u0432\u043e\u0434\u043d\u0443\u044e
    (\u041c\u043e\u0440\u0441\u043a\u0443\u044e) \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e\u00bb,
    \u0430\u0432\u0442\u043e\u0440\u0441\u0442\u0432\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439,
    \u0432\u043f\u0440\u043e\u0447\u0435\u043c, \u0438\u043d\u043e\u0433\u0434\u0430 \u0441\u0442\u0430\u0432\u0438\u043b\u043e\u0441\u044c
    \u043f\u043e\u0434 \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u0435 \u0435\u0449\u0435 \u0432
    \u0434\u0440\u0435\u0432\u043d\u043e\u0441\u0442\u0438. \u0412\u0441\u0435 \u0435\u0433\u043e
    \u0438\u0434\u0435\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e \u0442\u0440\u0443\u0434\u0430\u043c \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0438 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0442\u043e\u0440\u043e\u0432, \u0442\u0430\u043a\u0438\u0445
    \u043a\u0430\u043a \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044c. \u0412\u043a\u043b\u0430\u0434
    \u0424\u0430\u043b\u0435\u0441\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443 \u043d\u0435\u043e\u0446\u0435\u043d\u0438\u043c.
    \u041e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0434\u0435\u043b\u0430\u043b
    \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f,
    \u043d\u043e \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043d\u043e\u0432\u044b\u0439
    \u0441\u043f\u043e\u0441\u043e\u0431 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u043d\u0430 \u043f\u043e\u0438\u0441\u043a\u0435 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445,
    \u0430 \u043d\u0435 \u0441\u0432\u0435\u0440\u0445\u044a\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u0438\u0447\u0438\u043d \u044f\u0432\u043b\u0435\u043d\u0438\u0439, \u043d\u0430
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445
    \u0438 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u0438
    \u043c\u0438\u0440\u0430. \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u0435\u0433\u043e \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u044e\u0442
    \"\u043e\u0442\u0446\u043e\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\"
    \u0438 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0432\u0441\u0435\u0439 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438."
  achievementsEn: "Fales Miletsky did not leave any written writings, and all his achievements are known to us from the testimony of later authors such as Aristotle, Prokl and Geodot, but he is rightly considered to be the founder of European science, and his contribution to mathematics, astronomy and philosophy is indeed fundamental, and he has moved from mythological explanations of the world to his rational knowledge, and his key achievements are described below.\n\n* Mathematics: The birth of the evidence is considered to be the first Greek to introduce the principle of mathematical evidence into mathematics, making geometry a logical system rather than a mere set of practical rules. It is attributed to the following theorem: 1. The circle is divided in diameter in half. 2. The angles on the basis of the equibral triangle are equal. 3. Vertical angles formed by the intersection of two lines are equal. 4.5. A written angle based on diameter is a straight line (this is called the Fales Theorem in some sources), the most famous Theorem of Fales (on proportional sections cut parallel straight on the sides of the angle) was probably later assigned to it because it is indirectly linked to its practical measurement methods.And Fales was also famous for his practical application of his knowledge, measuring the height of the pyramids, and measuring their shadow at the time when his shadow was equal to its height.Determination of the distance to the ship at sea: It has developed a method for measuring the distance to the vessel on the high seas using geometric structures.\n\nAstronomy: The Astronomics of Fales's Vision and Calendar made a strong impression on the moderns and celebrated his name throughout Greece. The prediction of the solar eclipse: His most famous achievement is the prediction of the solar eclipse that took place on 28 May 585 BCE. According to legend, this eclipse interrupted the battle between the Lithuanians and the Midians who feared the world.He probably used Babylon's knowledge of repeated cycles of eclipse known as \"saros.\" Opens in astronomy and cosmology: Fales is believed to have opened the inclination of the ecliptics (the sun's visible path to the celestial sphere) to the celestial equator, determined the duration of the year at 365 days, set a time of solsticity and equinism, determined the apparent angular size of the sun and the moon.He said: \"O my Lord!\n\nPhilosophy: The first foundation of all of Falles's main merit as a philosopher is the first attempt to find a single material beginning of all things. Water is like an archae: He declared that water (or wet nature) is the primary substance of all things.He said, \"All things are Gods,\" and the world is insane, and he attributed the soul to a magnet, because he can move iron.\n\nThe antiquated authors attribute to him two small essays: \"On the solstice\" and \"On the equity\" and \"The sour astronomy\" which was sometimes questioned by ancient authors, all of which are known solely for the work of his followers and commentators, such as Aristotle, the contribution of Fales to science is invaluable.Not only did he make specific discoveries, but he also created a new way of thinking based on the search for natural rather than supernatural causes of phenomena, the logical evidence and the rational knowledge of the world, which is why he is rightly considered to be a \"father of philosophy\" and one of the founders of all European science."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0424\u0430\u043b\u0435\u0441\u0430
    \u041c\u0438\u043b\u0435\u0442\u0441\u043a\u043e\u0433\u043e, \u043a\u0430\u043a \u0438
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0430\u0441\u043f\u0435\u043a\u0442\u044b
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438, \u043e\u043a\u0443\u0442\u0430\u043d\u0430
    \u043f\u043e\u043b\u0443\u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c\u0438
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c\u0438.
    \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0435\u0451 \u0432
    \u0434\u0435\u0442\u0430\u043b\u044f\u0445 \u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0442\u0430\u043a \u043a\u0430\u043a
    \u043e\u043d \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432, \u0430 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043e \u043d\u0435\u043c \u0447\u0435\u0440\u043f\u0430\u044e\u0442\u0441\u044f \u0438\u0437
    \u0442\u0440\u0443\u0434\u043e\u0432 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445
    \u0430\u0432\u0442\u043e\u0440\u043e\u0432.\n\n\U0001F476 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0413\u043e\u0440\u043e\u0434
    \u0438 \u0434\u0430\u0442\u044b: \u0424\u0430\u043b\u0435\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041c\u0438\u043b\u0435\u0442 (\u043d\u0430
    \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0422\u0443\u0440\u0446\u0438\u0438) \u0432 \u0437\u043d\u0430\u0442\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0422\u043e\u0447\u043d\u044b\u0435 \u0434\u0430\u0442\u044b
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b;
    \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u043a
    \u0410\u043f\u043e\u043b\u043b\u043e\u0434\u043e\u0440 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    640 \u0433\u043e\u0434 \u0434\u043e \u043d.\u044d., \u043e\u0434\u043d\u0430\u043a\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u0442\u0430\u043a\u0436\u0435
    \u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043a.
    625/624 \u2013 \u043e\u043a. 547/545 \u0433\u0433. \u0434\u043e \u043d.\u044d.. \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438:
    \u0415\u0433\u043e \u043e\u0442\u0446\u0430 \u0437\u0432\u0430\u043b\u0438 \u042d\u043a\u0441\u0430\u043c\u0438\u0439,
    \u043c\u0430\u0442\u044c \u2014 \u041a\u043b\u0435\u043e\u0431\u0443\u043b\u0438\u043d\u0430.
    \u0421\u0435\u043c\u044c\u044f \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u043e\u0434\u0430 \u0424\u0435\u043b\u0438\u0434\u043e\u0432. \u041a\u043e\u0440\u043d\u0438:
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0432\u0435 \u0432\u0435\u0440\u0441\u0438\u0438
    \u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043e\u0434\u043d\u043e\u0439, \u043e\u043d
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b \u043a \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u043d\u0430\u0442\u0438. \u041f\u043e \u0434\u0440\u0443\u0433\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u0413\u0435\u0440\u043e\u0434\u043e\u0442,
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u043a\u0438 \u0431\u044b\u043b\u0438 \u0444\u0438\u043d\u0438\u043a\u0438\u0439\u0446\u0430\u043c\u0438,
    \u0438\u0437\u0433\u043d\u0430\u043d\u043d\u044b\u043c\u0438 \u0438\u0437 \u0441\u0432\u043e\u0435\u0439
    \u0441\u0442\u0440\u0430\u043d\u044b.\n\n\U0001F935 \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0421\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u0441\u0435\u043c\u044c\u0435 \u0424\u0430\u043b\u0435\u0441\u0430
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u044b. \u0414\u0438\u043e\u0433\u0435\u043d
    \u041b\u0430\u044d\u0440\u0442\u0441\u043a\u0438\u0439 \u0441\u043e\u0431\u0440\u0430\u043b
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445
    \u0432\u0435\u0440\u0441\u0438\u0439: \u041e\u043d \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442
    \u0438 \u0438\u043c\u0435\u043b \u0441\u044b\u043d\u0430 \u043f\u043e \u0438\u043c\u0435\u043d\u0438
    \u041a\u0438\u0431\u0438\u0441\u0444 (\u0438\u043b\u0438 \u041a\u0438\u0431\u0438\u0441\u0442).
    \u041e\u043d \u0431\u044b\u043b \u0431\u0435\u0437\u0434\u0435\u0442\u043d\u044b\u043c \u0438
    \u0443\u0441\u044b\u043d\u043e\u0432\u0438\u043b \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u043a\u0430,
    \u0441\u044b\u043d\u0430 \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u044b.
    \u041e\u043d \u0436\u0438\u043b \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0435
    \u0438 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0432\u043e\u0432\u0441\u0435.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442 \u043e \u0442\u043e\u043c, \u043a\u0430\u043a
    \u0435\u0433\u043e \u043c\u0430\u0442\u044c \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b\u0430
    \u043d\u0430 \u0436\u0435\u043d\u0438\u0442\u044c\u0431\u0435. \u0412 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438
    \u043e\u043d \u043e\u0442\u0432\u0435\u0447\u0430\u043b: \"\u0421\u043b\u0438\u0448\u043a\u043e\u043c
    \u0440\u0430\u043d\u043e!\", \u0430, \u043f\u043e\u0432\u0437\u0440\u043e\u0441\u043b\u0435\u0432,
    \u0433\u043e\u0432\u043e\u0440\u0438\u043b: \"\u0421\u043b\u0438\u0448\u043a\u043e\u043c
    \u043f\u043e\u0437\u0434\u043d\u043e!\". \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d \u043d\u0435 \u0437\u0430\u0432\u043e\u0434\u0438\u0442
    \u0434\u0435\u0442\u0435\u0439, \u0424\u0430\u043b\u0435\u0441 \u044f\u043a\u043e\u0431\u044b
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \"\u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e
    \u043b\u044e\u0431\u043b\u044e \u0438\u0445\".\n\n\U0001F4DA \u0423\u0447\u0451\u0431\u0430
    \u0438 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u0424\u0430\u043b\u0435\u0441 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0445\u043e\u0440\u043e\u0448\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0435,
    \u0447\u0435\u043c\u0443 \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0435\u0433\u043e \u0437\u043d\u0430\u0442\u043d\u043e\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435.
    \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f: \u041e\u043d \u043c\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432 \u0415\u0433\u0438\u043f\u0435\u0442, \u0433\u0434\u0435 \u043f\u0440\u043e\u0436\u0438\u043b
    \u043a\u0430\u043a\u043e\u0435-\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0432 \u0424\u0438\u0432\u0430\u0445
    \u0438 \u041c\u0435\u043c\u0444\u0438\u0441\u0435. \u0423\u0447\u0438\u0442\u0435\u043b\u044f:
    \u0412 \u0415\u0433\u0438\u043f\u0442\u0435 \u043e\u043d \u043e\u0431\u0443\u0447\u0430\u043b\u0441\u044f
    \u0443 \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u0436\u0440\u0435\u0446\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c
    \u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044f\u043c\u0438 \u0434\u0440\u0435\u0432\u043d\u0435\u0439
    \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u0438. \u0418\u043c\u0435\u043d\u043d\u043e \u043e\u0442
    \u043d\u0438\u0445 \u043e\u043d \u043f\u0435\u0440\u0435\u043d\u044f\u043b \u0437\u043d\u0430\u043d\u0438\u044f
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u0438\u0432\u0435\u0437 \u0432 \u0413\u0440\u0435\u0446\u0438\u044e.\n\n\u2699\ufe0f
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0424\u0430\u043b\u0435\u0441
    \u043d\u0435 \u0431\u044b\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043d\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c. \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0436\u0438\u0437\u043d\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u0433\u043e\u0440\u043e\u0434\u0430 \u0438 \u0437\u0430
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438. \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0435
    \u043f\u0440\u043e\u0435\u043a\u0442\u044b: \u041f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u043a\u0430\u043a \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0439 \u0438\u043d\u0436\u0435\u043d\u0435\u0440.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u043d \u043f\u043e\u043c\u043e\u0433
    \u0446\u0430\u0440\u044e \u041b\u0438\u0434\u0438\u0438 \u041a\u0440\u0435\u0437\u0443 \u043f\u0435\u0440\u0435\u043f\u0440\u0430\u0432\u0438\u0442\u044c
    \u0432\u043e\u0439\u0441\u043a\u043e \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u043a\u0443
    \u0413\u0430\u043b\u0438\u0441, \u0438\u0437\u043c\u0435\u043d\u0438\u0432 \u0435\u0435
    \u0440\u0443\u0441\u043b\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u043b\u043e\u0442\u0438\u043d\u044b
    \u0438 \u043a\u0430\u043d\u0430\u043b\u0430. \u041f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e:
    \u041f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044c,
    \u043e\u043d \u043e\u0434\u043d\u0430\u0436\u0434\u044b \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b
    \u043d\u0435\u0431\u044b\u0432\u0430\u043b\u044b\u0439 \u0443\u0440\u043e\u0436\u0430\u0439
    \u043e\u043b\u0438\u0432\u043e\u043a \u0438 \u0437\u0430\u0440\u0430\u043d\u0435\u0435 \u0441\u043a\u0443\u043f\u0438\u043b
    \u0432\u0441\u0435 \u043c\u0430\u0441\u043b\u043e\u0434\u0430\u0432\u0438\u043b\u044c\u043d\u0438
    \u0432 \u043e\u043a\u0440\u0443\u0433\u0435, \u0447\u0442\u043e\u0431\u044b \u0432 \u0441\u0435\u0437\u043e\u043d
    \u0441\u0434\u0430\u0442\u044c \u0438\u0445 \u0432 \u0430\u0440\u0435\u043d\u0434\u0443
    \u043f\u043e \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0446\u0435\u043d\u0435, \u0434\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u044b \u043c\u043e\u0433\u0443\u0442
    \u0431\u044b\u0442\u044c \u0431\u043e\u0433\u0430\u0442\u044b. \u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0430:
    \u0424\u0430\u043b\u0435\u0441 \u0431\u044b\u043b \u0431\u043b\u0438\u0437\u043a\u0438\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c \u0438 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c
    \u043c\u0438\u043b\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u0442\u0438\u0440\u0430\u043d\u0430
    \u0424\u0440\u0430\u0441\u0438\u0431\u0443\u043b\u0430. \u041e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0434\u0430\u043b\u044c\u043d\u043e\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u044c, \u0443\u0431\u0435\u0434\u0438\u0432
    \u0436\u0438\u0442\u0435\u043b\u0435\u0439 \u041c\u0438\u043b\u0435\u0442\u0430 \u043d\u0435
    \u0432\u0441\u0442\u0443\u043f\u0430\u0442\u044c \u0432 \u0441\u043e\u044e\u0437 \u0441
    \u0446\u0430\u0440\u0435\u043c \u041a\u0440\u0435\u0437\u043e\u043c \u043f\u0440\u043e\u0442\u0438\u0432
    \u043d\u0430\u0431\u0438\u0440\u0430\u044e\u0449\u0435\u0439 \u0441\u0438\u043b\u0443 \u041f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u043e\u0439
    \u0434\u0435\u0440\u0436\u0430\u0432\u044b. \u042d\u0442\u043e\u0442 \u0448\u0430\u0433
    \u0432 \u0438\u0442\u043e\u0433\u0435 \u0441\u043f\u0430\u0441 \u0433\u043e\u0440\u043e\u0434
    \u043e\u0442 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u044f.\n\n\U0001F91D
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435
    \u0448\u043a\u043e\u043b\u044b: \u0424\u0430\u043b\u0435\u0441 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u041c\u0438\u043b\u0435\u0442\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u2014 \u043f\u0435\u0440\u0432\u043e\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e-\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c\u0438
    \u0431\u044b\u043b\u0438 \u0410\u043d\u0430\u043a\u0441\u0438\u043c\u0430\u043d\u0434\u0440
    \u0438 \u0410\u043d\u0430\u043a\u0441\u0438\u043c\u0435\u043d. \u041d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e:
    \u041f\u043e \u043f\u0440\u0435\u0434\u0430\u043d\u0438\u044e, \u0438\u043c\u0435\u043d\u043d\u043e
    \u0424\u0430\u043b\u0435\u0441 \u0443\u0431\u0435\u0434\u0438\u043b \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u0432 \u0415\u0433\u0438\u043f\u0435\u0442
    \u0437\u0430 \u0437\u043d\u0430\u043d\u0438\u044f\u043c\u0438 \u0438 \u043f\u043e\u043c\u043e\u0433
    \u0435\u043c\u0443 \u0432\u043e\u0439\u0442\u0438 \u0432 \u0434\u043e\u0432\u0435\u0440\u0438\u0435
    \u043a \u0436\u0440\u0435\u0446\u0430\u043c.\n\n\u26b0\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c
    \u0414\u0430\u0442\u0430 \u0438 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:
    \u0424\u0430\u043b\u0435\u0441 \u0443\u043c\u0435\u0440 \u0432 \u041c\u0438\u043b\u0435\u0442\u0435,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0443\u0436\u0435 \u0432 \u043f\u0440\u0435\u043a\u043b\u043e\u043d\u043d\u043e\u043c
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u0414\u0438\u043e\u0433\u0435\u043d\u0443 \u041b\u0430\u044d\u0440\u0442\u0441\u043a\u043e\u043c\u0443,
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u044c \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b\u0430
    \u043e\u0442 \u0436\u0430\u0440\u044b, \u0436\u0430\u0436\u0434\u044b \u0438 \u0441\u0442\u0430\u0440\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0437\u0430 \u0433\u0438\u043c\u043d\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u043e\u0441\u0442\u044f\u0437\u0430\u043d\u0438\u044f\u043c\u0438. \u041d\u0430\u0434\u043f\u0438\u0441\u044c
    \u043d\u0430 \u0433\u0440\u043e\u0431\u043d\u0438\u0446\u0435: \u041d\u0430 \u0435\u0433\u043e
    \u043c\u043e\u0433\u0438\u043b\u0435 \u0431\u044b\u043b\u0430 \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430
    \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0433\u043b\u0430\u0441\u0438\u043b\u0430: \"\u042d\u0442\u0430 \u0433\u0440\u043e\u0431\u043d\u0438\u0446\u0430
    \u043c\u0430\u043b\u0430, \u043d\u043e \u0441\u043b\u0430\u0432\u0430 \u043d\u0430\u0434
    \u043d\u0435\u0439 \u043d\u0435\u043e\u0431\u044a\u044f\u0442\u043d\u0430: \u0412 \u043d\u0435\u0439
    \u043f\u0440\u0435\u0434 \u0442\u043e\u0431\u043e\u044e \u0441\u043e\u043a\u0440\u044b\u0442,
    \u043c\u043d\u043e\u0433\u043e\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0439 \u0424\u0430\u043b\u0435\u0441\"."
  personalLifeEn: "The personal life of Fales Miletsky, like many other aspects of his biography, is covered by semi-legal evidence; it is not always possible to restore it in detail, since he has not left any written writings and information about it is drawn from the work of later authors.\n\n==Early life==The birth and origin of the city and dates: Fales was born in Milet (in the territory of modern Turkey) in a noble family. The exact dates of his life are unknown; the ancient historian Apollodor calls 640 BCE, but researchers also refer to the period c. 625/624 – c. 547/545 BCE. His parents: His father was named Examia, mother of Cleobulina. The family originated from the aristocratic family of Felids.According to one, he belonged to a Greek noble, and according to the other, that he brought, his ancestors were Phoenicks, expelled from their country.\n\nThe information about the Fales family is contradictory. The Diogenes of Laerta collected several antiquities: he was married and had a son named Kibisf (or Kibist). He was childless and adopted his nephew, his sister's son. He lived alone and was not married at all. There was a well-known anecdote about how his mother insisted on marriage. When he was young, he said, \"It's too early!\" and when he grew up, he said, \"It's too late!\"Asked why he didn't have kids, Fales allegedly said, \"Because I love them.\"\n\nEducation and travel: Fales received a good education in his home country, which was facilitated by his noble origin. Traveling: He travelled extensively, especially to Egypt, where he lived for some time in Fivah and Memphis. The teacher: In Egypt, he was trained by local priests who were considered guardians of ancient wisdom, and he learned from them the knowledge of geometry and astronomy, which he brought to Greece.\n\nHe was not just a desk scientist, but he was active in the life of his city and beyond. Engineering projects: he was famous as a talented engineer. For example, he helped King Lydia Creza to transport the army across the Galis River, changing its course through a dam and a canal.Business: According to the legend Aristotle's legend, he once predicted an unprecedented harvest of olives and bought all the oil mills in the district in advance to rent them at a high price during the season, proving that philosophers could be rich.This step ultimately saved the city from destruction.\n\nThe foundation of the school: Fales is considered the founder of the Milet School, the first Greek science-philosophic school in history to begin the history of European science, and his direct students and followers were Anaxymandr and Anaxyman.\n\n♪ Death Day and circumstances: Fales died in Milet, aged old, and according to Diogen Laerta, his death came from heat, thirst, and old weakness while observing gymnastic competitions. ♪ The tomb was written on its tomb ♪ ♪ A epitaph that said, \"This tomb is small, but its glory is great ♪ ♪ It is hidden before thee ♪"
  shortBioRu: "\u0424\u0430\u043b\u0435\u0441 \u041c\u0438\u043b\u0435\u0442\u0441\u043a\u0438\u0439 \u2014
    \u0444\u0438\u0433\u0443\u0440\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u043b\u0438\u0441\u044c
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u044b. \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u043e\u043c
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439 \u043d\u0430\u0443\u043a\u0438
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438, \u0438 \u0434\u0430\u0436\u0435
    \u0432 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u0435\u0433\u043e \u0438\u043c\u044f
    \u0441\u0442\u0430\u043b\u043e \u043d\u0430\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043c\u0443\u0434\u0440\u0435\u0446\u0430.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445 \u0438
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0434\u0430\u043d\u043d\u044b\u0445. \u0412\u0430\u0436\u043d\u043e \u043f\u043e\u043c\u043d\u0438\u0442\u044c,
    \u0447\u0442\u043e \u0424\u0430\u043b\u0435\u0441 \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432,
    \u0438 \u0432\u0441\u0435 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u043d\u0435\u043c
    \u043f\u043e\u0447\u0435\u0440\u043f\u043d\u0443\u0442\u044b \u0438\u0437 \u0442\u0440\u0443\u0434\u043e\u0432
    \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432,
    \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044c
    \u0438 \u0413\u0435\u0440\u043e\u0434\u043e\u0442.\n\n\U0001F4DC \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435,
    \u0434\u0430\u0442\u044b \u0436\u0438\u0437\u043d\u0438 \u0438 \u0441\u0435\u043c\u044c\u044f
    \u0418\u043c\u044f \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435:
    \u0424\u0430\u043b\u0435\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0431\u043e\u0433\u0430\u0442\u043e\u043c
    \u0442\u043e\u0440\u0433\u043e\u0432\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435 \u041c\u0438\u043b\u0435\u0442
    \u0432 \u041c\u0430\u043b\u043e\u0439 \u0410\u0437\u0438\u0438 (\u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u044f
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0422\u0443\u0440\u0446\u0438\u0438).
    \u0415\u0433\u043e \u043e\u0442\u0446\u0430 \u0437\u0432\u0430\u043b\u0438 \u042d\u043a\u0441\u0430\u043c\u0438\u0439,
    \u043c\u0430\u0442\u044c \u2014 \u041a\u043b\u0435\u043e\u0431\u0443\u043b\u0438\u043d\u0430.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0432\u0435 \u0432\u0435\u0440\u0441\u0438\u0438
    \u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f:
    \u0410\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u043e\u0434: \u043f\u043e
    \u044d\u0442\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438, \u043e\u043d \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b
    \u043a \u0437\u043d\u0430\u0442\u043d\u043e\u043c\u0443 \u043c\u0438\u043b\u0435\u0442\u0441\u043a\u043e\u043c\u0443
    \u0440\u043e\u0434\u0443 \u0424\u0435\u043b\u0438\u0434\u043e\u0432. \u0424\u0438\u043d\u0438\u043a\u0438\u0439\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u043d\u0438: \u0413\u0435\u0440\u043e\u0434\u043e\u0442 \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043f\u0440\u0435\u0434\u043a\u0438 \u0424\u0430\u043b\u0435\u0441\u0430
    \u0431\u044b\u043b\u0438 \u0444\u0438\u043d\u0438\u043a\u0438\u0439\u0446\u0430\u043c\u0438,
    \u0438\u0437\u0433\u043d\u0430\u043d\u043d\u044b\u043c\u0438 \u0438\u0437 \u0441\u0432\u043e\u0435\u0439
    \u0441\u0442\u0440\u0430\u043d\u044b. \u042d\u0442\u043e\u0442 \u0432\u043e\u043f\u0440\u043e\u0441
    \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u043e\u043d\u043d\u044b\u043c
    \u0432 \u043d\u0430\u0443\u043a\u0435. \u0414\u0430\u0442\u0430 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438 \u0441\u043c\u0435\u0440\u0442\u0438: \u0422\u043e\u0447\u043d\u044b\u0435 \u0434\u0430\u0442\u044b
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b. \u0410\u043d\u0442\u0438\u0447\u043d\u044b\u0439
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a \u0410\u043f\u043e\u043b\u043b\u043e\u0434\u043e\u0440
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b 640 \u0433\u043e\u0434 \u0434\u043e \u043d. \u044d.,
    \u043e\u0434\u043d\u0430\u043a\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u0447\u0430\u0441\u0442\u043e
    \u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043a.
    625/624 \u2014 \u043e\u043a. 547/545 \u0433\u0433. \u0434\u043e \u043d. \u044d.. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0436\u0438\u0437\u043d\u0438, \u043f\u043e \u0440\u0430\u0437\u043d\u044b\u043c \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u043c,
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0430 \u043e\u0442 78 \u0434\u043e
    90 \u043b\u0435\u0442. \u0421\u0435\u043c\u0435\u0439\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435:
    \u0421\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u044b.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0414\u0438\u043e\u0433\u0435\u043d\u0443
    \u041b\u0430\u044d\u0440\u0442\u0441\u043a\u043e\u043c\u0443, \u043b\u0438\u0431\u043e \u043e\u043d
    \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0438 \u0438\u043c\u0435\u043b \u0441\u044b\u043d\u0430
    \u041a\u0438\u0431\u0438\u0441\u0444\u0430, \u043b\u0438\u0431\u043e \u0443\u0441\u044b\u043d\u043e\u0432\u0438\u043b
    \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u043a\u0430, \u043b\u0438\u0431\u043e \u0431\u044b\u043b
    \u0431\u0435\u0437\u0434\u0435\u0442\u043d\u044b\u043c. \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441
    \u043c\u0430\u0442\u0435\u0440\u0438 \u043e \u0436\u0435\u043d\u0438\u0442\u044c\u0431\u0435
    \u043e\u043d \u043e\u0442\u0432\u0435\u0447\u0430\u043b: \"\u0421\u043b\u0438\u0448\u043a\u043e\u043c
    \u0440\u0430\u043d\u043e!\", \u0430 \u043f\u043e\u0437\u0436\u0435 \u2014 \"\u0421\u043b\u0438\u0448\u043a\u043e\u043c
    \u043f\u043e\u0437\u0434\u043d\u043e!\".\n\n\U0001F9E0 \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0432\u0435\u0445\u0438 \u0436\u0438\u0437\u043d\u0438 \u0438 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0424\u0430\u043b\u0435\u0441 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043d\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c.
    \u041e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0441\u0435\u0431\u044f \u043a\u0430\u043a
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a, \u043f\u043e\u043b\u0438\u0442\u0438\u043a,
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440 \u0438 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c.
    \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435:
    \u0424\u0430\u043b\u0435\u0441 \u043c\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e \u0415\u0433\u0438\u043f\u0442\u0443,
    \u0433\u0434\u0435 \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0445
    \u0436\u0440\u0435\u0446\u043e\u0432 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u0438 \u043a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e
    \u043e\u043d \u043f\u0440\u0438\u0432\u0435\u0437 \u044d\u0442\u0438 \u0437\u043d\u0430\u043d\u0438\u044f
    \u0432 \u0413\u0440\u0435\u0446\u0438\u044e. \u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c: \u0424\u0430\u043b\u0435\u0441
    \u0431\u044b\u043b \u0431\u043b\u0438\u0437\u043e\u043a \u043a \u043c\u0438\u043b\u0435\u0442\u0441\u043a\u043e\u043c\u0443
    \u0442\u0438\u0440\u0430\u043d\u0443 \u0424\u0440\u0430\u0441\u0438\u0431\u0443\u043b\u0443
    \u0438 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b \u043a\u0430\u043a \u043c\u0443\u0434\u0440\u044b\u0439
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a. \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0438\u043e\u043d\u0438\u0439\u0441\u043a\u0438\u043c \u0433\u043e\u0440\u043e\u0434\u0430\u043c
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u0432 \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044e
    \u0434\u043b\u044f \u043e\u0442\u043f\u043e\u0440\u0430 \u043f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u043e\u0439
    \u0443\u0433\u0440\u043e\u0437\u0435, \u043d\u043e \u044d\u0442\u043e\u0442 \u043f\u043b\u0430\u043d
    \u043d\u0435 \u0431\u044b\u043b \u043f\u0440\u0438\u043d\u044f\u0442. \u0422\u0430\u043a\u0436\u0435
    \u043e\u043d \u0443\u0431\u0435\u0434\u0438\u043b \u0436\u0438\u0442\u0435\u043b\u0435\u0439
    \u041c\u0438\u043b\u0435\u0442\u0430 \u043d\u0435 \u0432\u0441\u0442\u0443\u043f\u0430\u0442\u044c
    \u0432 \u043e\u043f\u0430\u0441\u043d\u044b\u0439 \u0441\u043e\u044e\u0437 \u0441 \u0446\u0430\u0440\u0435\u043c
    \u041b\u0438\u0434\u0438\u0438 \u041a\u0440\u0435\u0437\u043e\u043c \u043f\u0440\u043e\u0442\u0438\u0432
    \u041f\u0435\u0440\u0441\u0438\u0438, \u0447\u0442\u043e \u0432 \u0438\u0442\u043e\u0433\u0435
    \u0441\u043f\u0430\u0441\u043b\u043e \u0433\u043e\u0440\u043e\u0434 \u043e\u0442 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u044f.
    \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u044b:
    \u041f\u043e \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u041a\u0440\u0435\u0437\u0430,
    \u0424\u0430\u043b\u0435\u0441 \u043f\u043e\u043c\u043e\u0433 \u0435\u0433\u043e \u0430\u0440\u043c\u0438\u0438
    \u043f\u0435\u0440\u0435\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u0447\u0435\u0440\u0435\u0437
    \u0440\u0435\u043a\u0443 \u0413\u0430\u043b\u0438\u0441, \u0438\u0437\u043c\u0435\u043d\u0438\u0432
    \u0435\u0435 \u0440\u0443\u0441\u043b\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043f\u043b\u043e\u0442\u0438\u043d\u044b \u0438 \u043a\u0430\u043d\u0430\u043b\u0430.
    \u041f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f
    \u0441\u043c\u0435\u043a\u0430\u043b\u043a\u0430: \u0427\u0442\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u044b \u043c\u043e\u0433\u0443\u0442
    \u0431\u044b\u0442\u044c \u0431\u043e\u0433\u0430\u0442\u044b, \u0424\u0430\u043b\u0435\u0441,
    \u043f\u0440\u0435\u0434\u0432\u0438\u0434\u044f \u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0443\u0440\u043e\u0436\u0430\u0439 \u043c\u0430\u0441\u043b\u0438\u043d, \u0437\u0430\u0440\u0430\u043d\u0435\u0435
    \u0441\u043a\u0443\u043f\u0438\u043b \u0432\u0441\u0435 \u043c\u0430\u0441\u043b\u043e\u0434\u0430\u0432\u0438\u043b\u044c\u043d\u0438
    \u0432 \u041c\u0438\u043b\u0435\u0442\u0435 \u0438 \u043d\u0430 \u0425\u0438\u043e\u0441\u0435.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u043f\u0440\u043e\u0433\u043d\u043e\u0437
    \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043b\u0441\u044f, \u043e\u043d \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0432\u044b\u0433\u043e\u0434\u043e\u0439 \u043f\u0435\u0440\u0435\u043f\u0440\u043e\u0434\u0430\u043b
    \u0438\u0445.\n\n\U0001F30C \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435
    \u0443\u0447\u0435\u043d\u0438\u0435 \u0413\u043b\u0430\u0432\u043d\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430
    \u0424\u0430\u043b\u0435\u0441\u0430 \u2014 \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f \u043c\u0438\u0440\u0430, \u043e\u0442\u043a\u0430\u0437
    \u043e\u0442 \u0447\u0438\u0441\u0442\u043e \u043c\u0438\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u0437\u0433\u043b\u044f\u0434\u0430. \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044c
    \u0441\u0447\u0438\u0442\u0430\u043b \u0435\u0433\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0438, \u0430 \u0434\u0440\u0443\u0433\u0438\u0435
    \u2014 \u0444\u0438\u0437\u0438\u043a\u0438, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u043e
    (\u0410\u0440\u0445\u044d): \u0424\u0430\u043b\u0435\u0441 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u0432\u043e\u0434\u0430 (\u0438\u043b\u0438 \u0432\u043b\u0430\u0436\u043d\u0430\u044f
    \u043f\u0440\u0438\u0440\u043e\u0434\u0430) \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u0435\u0440\u0432\u043e\u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0432\u0441\u0435\u0433\u043e
    \u0441\u0443\u0449\u0435\u0433\u043e. \u0412\u0441\u0435 \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u043e
    \u0438\u0437 \u0432\u043e\u0434\u044b \u0438 \u0432 \u043d\u0435\u0435 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f.
    \u041e\u043d \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u044d\u0442\u043e\u043c\u0443
    \u0432\u044b\u0432\u043e\u0434\u0443, \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u044f,
    \u0447\u0442\u043e \u0432\u043b\u0430\u0433\u0430 \u2014 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0435
    \u0443\u0441\u043b\u043e\u0432\u0438\u0435 \u0436\u0438\u0437\u043d\u0438: \u0441\u0435\u043c\u0435\u043d\u0430
    \u0432\u043b\u0430\u0436\u043d\u044b, \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u043f\u0438\u0442\u0430\u044e\u0442\u0441\u044f
    \u0432\u043e\u0434\u043e\u0439, \u0430 \u0434\u0430\u0436\u0435 \u0441\u043e\u043b\u043d\u0446\u0435
    \u0438 \u0437\u0432\u0435\u0437\u0434\u044b \u043f\u0438\u0442\u0430\u044e\u0442\u0441\u044f
    \u0432\u043e\u0434\u044f\u043d\u044b\u043c\u0438 \u0438\u0441\u043f\u0430\u0440\u0435\u043d\u0438\u044f\u043c\u0438.
    \u041a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u044f: \u041e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0417\u0435\u043c\u043b\u044e \u0432 \u0432\u0438\u0434\u0435 \u043f\u043b\u043e\u0441\u043a\u043e\u0433\u043e
    \u0434\u0438\u0441\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043b\u0430\u0432\u0430\u0435\u0442
    \u043f\u043e \u0432\u043e\u0434\u0435, \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u0434\u0435\u0440\u0435\u0432\u0443.
    \u041f\u0430\u043d\u043f\u0441\u0438\u0445\u0438\u0437\u043c (\u043e\u0434\u0443\u0448\u0435\u0432\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043c\u0438\u0440\u0430): \u0424\u0430\u043b\u0435\u0441 \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \"\u0432\u0441\u0435 \u043f\u043e\u043b\u043d\u043e \u0431\u043e\u0433\u043e\u0432\"
    \u0438 \u0447\u0442\u043e \u043c\u0438\u0440 \u043e\u0434\u0443\u0448\u0435\u0432\u043b\u0435\u043d.
    \u0414\u0443\u0448\u043e\u0439, \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e,
    \u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0442 \u0434\u0430\u0436\u0435 \u043c\u0430\u0433\u043d\u0438\u0442
    \u0438 \u044f\u043d\u0442\u0430\u0440\u044c, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d\u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b \u0434\u0432\u0438\u0433\u0430\u0442\u044c
    \u0434\u0440\u0443\u0433\u0438\u0435 \u0442\u0435\u043b\u0430.\n\n\U0001F4D0 \u041d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0424\u0430\u043b\u0435\u0441
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u043e\u043c
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438. \u041c\u043d\u043e\u0433\u0438\u0435
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u044b
    \u043d\u0430 \u0437\u043d\u0430\u043d\u0438\u044f\u0445, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0445
    \u043d\u0430 \u0412\u043e\u0441\u0442\u043e\u043a\u0435, \u043d\u043e \u043e\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u043d\u0430\u0447\u0430\u043b \u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0438 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f:
    \u041f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u043e\u0433\u043e
