  achievementsRu: "\u0425\u043e\u0442\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0448\u0438\u0440\u043e\u043a\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0435\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u043e\u0447\u043d\u044b\u0435 \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u043d\u0430\u0443\u043a\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0435\u043d.
    \u041f\u043e \u0441\u0443\u0442\u0438, \u0414\u0435\u043a\u0430\u0440\u0442 \u0431\u044b\u043b
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0444\u0438\u0437\u0438\u043a\u0435,
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0435.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u0440\u0430\u0437\u0431\u043e\u0440 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u0440\u0430\u0437\u0431\u0438\u0442\u044b\u0439
    \u043f\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c \u0437\u043d\u0430\u043d\u0438\u0439.
    --- 1. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u043d\u043e\u0432\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u042d\u0442\u043e,
    \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0438 \u0434\u043e\u043b\u0433\u043e\u0432\u0435\u0447\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0438\u0439
    \u0432\u0441\u044e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    - \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438: \u0414\u043e \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u044c\u043d\u043e.
    \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0431\u044b\u043b\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    (\u0415\u0432\u043a\u043b\u0438\u0434), \u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u0430
    \u2014 \u0430\u0440\u0430\u0431\u0441\u043a\u043e\u0439 (\u0431\u0443\u043a\u0432\u0435\u043d\u043d\u044b\u0435
    \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f). \u0414\u0435\u043a\u0430\u0440\u0442
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432, \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u0432
    \u043c\u0435\u0442\u043e\u0434 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442. \u041e\u043d
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043c\u0435\u0441\u0442\u043e
    \u0442\u043e\u0447\u0435\u043a (\u043b\u0438\u043d\u0438\u044f, \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u044c,
    \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u0435\u0447\u0435\u043d\u0438\u0435)
    \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u0442\u044c \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435\u043c \u0441 \u0434\u0432\u0443\u043c\u044f
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c\u0438 \\( x \\) \u0438 \\(
    y \\). \u0418 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442: \u043b\u044e\u0431\u043e\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0435\u0442
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u0443\u044e \u043a\u0440\u0438\u0432\u0443\u044e
    \u043d\u0430 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0432\u0432\u0435\u043b \u043e\u0431\u0449\u0435\u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0435
    \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f:
    \\( x, y, z \\) \u2014 \u0434\u043b\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445,
    \u0430 \\( a, b, c \\) \u2014 \u0434\u043b\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d. - \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u0432
    \u043b\u0438\u0441\u0442: \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u043a\u0440\u0438\u0432\u0430\u044f
    \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0430
    \\( x^3 + y^3 = 3axy \\), \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b,
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u043e\u0441\u0438\u0442 \u0435\u0433\u043e
    \u0438\u043c\u044f. - \u041d\u043e\u0432\u0430\u044f \u043d\u043e\u0442\u0430\u0446\u0438\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439: \u0418\u043c\u0435\u043d\u043d\u043e \u0414\u0435\u043a\u0430\u0440\u0442
    \u0432\u0432\u0435\u043b \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439 \u043a\u0430\u043a \\( x^3, x^4 \\) (\u0440\u0430\u043d\u0435\u0435
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438
    \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u043c\u0438 \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u043c\u0438
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438). \u042d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u043e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0439
    \u0438 \u043e\u0431\u043e\u0437\u0440\u0438\u043c\u043e\u0439. - \u041f\u0440\u0430\u0432\u0438\u043b\u043e
    \u0437\u043d\u0430\u043a\u043e\u0432 \u0414\u0435\u043a\u0430\u0440\u0442\u0430: \u0421\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u0447\u0438\u0441\u043b\u0430 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u0440\u043d\u0435\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u043f\u043e \u0447\u0435\u0440\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044e
    \u0437\u043d\u0430\u043a\u043e\u0432 \u0432 \u0435\u0433\u043e \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u0445.
    \u042d\u0442\u043e\u0442 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439 \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. - \u041c\u0435\u0442\u043e\u0434
    \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u043e\u0432:
    \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432\u044b\u0441\u0448\u0438\u0445
    \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0438\u0445 \u043a \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c. --- 2. \u0424\u0438\u0437\u0438\u043a\u0430
    \u0438 \u043e\u043f\u0442\u0438\u043a\u0430: \u041c\u0435\u0445\u0430\u043d\u0438\u0446\u0438\u0437\u043c
    \u0438 \u00ab\u0432\u0438\u0445\u0440\u0438\u00bb \u0412 \u0444\u0438\u0437\u0438\u043a\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0431\u044b\u043b \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u043c\u0435\u0445\u0430\u043d\u0438\u0441\u0442\u043e\u043c. \u041e\u043d \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u043b
    \u00ab\u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0441\u0438\u043b\u044b\u00bb \u0438 \u043c\u0430\u0433\u0438\u044e,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f, \u0447\u0442\u043e \u0432\u0441\u0435
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u044f\u0432\u043b\u0435\u043d\u0438\u044f
    \u043c\u043e\u0436\u043d\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0435\u043c
    \u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u043c\u0435\u043b\u044c\u0447\u0430\u0439\u0448\u0438\u0445
    \u0447\u0430\u0441\u0442\u0438\u0446 \u043c\u0430\u0442\u0435\u0440\u0438\u0438 (\u043a\u043e\u0440\u043f\u0443\u0441\u043a\u0443\u043b).
    - \u0417\u0430\u043a\u043e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    (\u0438\u043c\u043f\u0443\u043b\u044c\u0441\u0430): \u0414\u0435\u043a\u0430\u0440\u0442
    \u043f\u0435\u0440\u0432\u044b\u043c \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043e\u0431\u0449\u0438\u0439 \u0437\u0430\u043a\u043e\u043d \u043f\u0440\u0438\u0440\u043e\u0434\u044b:
    \u00ab\u041e\u0431\u0449\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u043c\u0438\u0440\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f
    \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u044b\u043c\u00bb. \u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u043c\u0435\u0440\u0443 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043a\u0430\u043a
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043c\u0430\u0441\u0441\u044b
    \u043d\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c (\\( mv \\)). \u0425\u043e\u0442\u044f
    \u0435\u0433\u043e \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u0441\u043e\u0432\u0441\u0435\u043c \u0442\u043e\u0447\u043d\u043e\u0439
    (\u043e\u043d \u043d\u0435 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u043b \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0439
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438),
    \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d \u0432\u0432\u0435\u043b \u044d\u0442\u043e\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0436\u0435
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u0432 \u0441\u0432\u043e\u0438 \u0437\u0430\u043a\u043e\u043d\u044b. - \u0422\u0435\u043e\u0440\u0438\u044f
    \u0432\u0438\u0445\u0440\u0435\u0439 (\u041a\u0430\u0440\u0442\u0435\u0437\u0438\u0430\u043d\u0441\u043a\u0438\u0435
    \u0432\u0438\u0445\u0440\u0438): \u0414\u043b\u044f \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u0435\u0442 \u0414\u0435\u043a\u0430\u0440\u0442
    \u0441\u043e\u0437\u0434\u0430\u043b \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u0443\u044e
    \u043a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u043e\u0434\u0435\u043b\u044c. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0435\u0439,
    \u043a\u043e\u0441\u043c\u043e\u0441 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d \u0442\u043e\u043d\u0447\u0430\u0439\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u0440\u0438\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u043c
    \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u043c \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    (\u0432\u0438\u0445\u0440\u0438). \u041f\u043b\u0430\u043d\u0435\u0442\u044b, \u043f\u043e
    \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e, \u0443\u0432\u043b\u0435\u043a\u0430\u044e\u0442\u0441\u044f
    \u044d\u0442\u0438\u043c\u0438 \u0432\u0438\u0445\u0440\u044f\u043c\u0438, \u043f\u043e\u0434\u043e\u0431\u043d\u043e
    \u043b\u0438\u0441\u0442\u044c\u044f\u043c, \u043f\u043e\u043f\u0430\u0432\u0448\u0438\u043c
    \u0432 \u0432\u043e\u0434\u043e\u0432\u043e\u0440\u043e\u0442. \u042d\u0442\u0430 \u0442\u0435\u043e\u0440\u0438\u044f
    \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b\u0430 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044e
    \u043a\u0430\u043a \u0446\u0435\u043d\u0442\u0440\u043e\u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u0438\u0445\u0440\u0435\u0439. \u0425\u043e\u0442\u044f
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u043e\u0437\u0436\u0435 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0435\u0442
    \u044d\u0442\u0443 \u0442\u0435\u043e\u0440\u0438\u044e \u0432 \u043f\u043e\u043b\u044c\u0437\u0443
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f, \u0432\u0438\u0445\u0440\u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0434\u043e\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435 \u043f\u043e\u0447\u0442\u0438 100 \u043b\u0435\u0442.
    - \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0437\u0430\u043a\u043e\u043d \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430 (\u0417\u0430\u043a\u043e\u043d \u0421\u043d\u0435\u043b\u043b\u0430
    \u2014 \u0414\u0435\u043a\u0430\u0440\u0442\u0430): \u0412 \u0441\u0432\u043e\u0435\u043c
    \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u00ab\u0414\u0438\u043e\u043f\u0442\u0440\u0438\u043a\u0430\u00bb
    (1637) \u0414\u0435\u043a\u0430\u0440\u0442 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u0421\u043d\u0435\u043b\u043b\u0430 \u0438 \u0441\u0442\u0440\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u044b\u0432\u0435\u043b
    \u0437\u0430\u043a\u043e\u043d \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430 \u043d\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0435 \u0434\u0432\u0443\u0445
    \u0441\u0440\u0435\u0434: \\[ n_1 \\sin \\theta_1 = n_2 \\sin \\theta_2 \\] \u041e\u043d
    \u0434\u0430\u043b \u0435\u0433\u043e \u0447\u0435\u0442\u043a\u0443\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0443
    \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0435\u0442\u0430
    \u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043b\u0438\u043d\u0437. \u0414\u043e
    \u043d\u0435\u0433\u043e \u0437\u0430\u043a\u043e\u043d \u0438\u0441\u043a\u0430\u043b\u0438
    \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0443\u0433\u043b\u043e\u0432,
    \u0430 \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430
    \u2014 \u044d\u0442\u043e \u0441\u0438\u043d\u0443\u0441 \u0443\u0433\u043b\u0430. - \u0422\u0435\u043e\u0440\u0438\u044f
    \u0440\u0430\u0434\u0443\u0433\u0438: \u0414\u0435\u043a\u0430\u0440\u0442 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0434\u0430\u043b \u043f\u043e\u043b\u043d\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0440\u0430\u0434\u0443\u0433\u0438.
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043e\u043d\u0430
    \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u0438\u0437-\u0437\u0430 \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445 \u043b\u0443\u0447\u0435\u0439 \u0432
    \u043a\u0430\u043f\u043b\u044f\u0445 \u0432\u043e\u0434\u044b \u0438 \u0438\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043e\u0442 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439
    \u0441\u0442\u0435\u043d\u043a\u0438 \u043a\u0430\u043f\u043b\u0438. \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0441\u0432\u043e\u0438\u0445 \u0437\u0430\u043a\u043e\u043d\u043e\u0432 \u043e\u043d \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043b
    \u0443\u0433\u043b\u044b, \u043f\u043e\u0434 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438
    \u043c\u044b \u0432\u0438\u0434\u0438\u043c \u043f\u0435\u0440\u0432\u0443\u044e \u0438
    \u0432\u0442\u043e\u0440\u0443\u044e \u0440\u0430\u0434\u0443\u0433\u0438 (42\u00b0 \u0438
    52\u00b0). - \u0422\u0435\u043e\u0440\u0438\u044f \u0441\u0432\u0435\u0442\u0430 \u043a\u0430\u043a
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f: \u0414\u0435\u043a\u0430\u0440\u0442 \u0441\u0447\u0438\u0442\u0430\u043b
    \u0441\u0432\u0435\u0442 \u043d\u0435 \u0432\u043e\u043b\u043d\u043e\u0439 \u0438 \u043d\u0435
    \u043f\u043e\u0442\u043e\u043a\u043e\u043c \u0447\u0430\u0441\u0442\u0438\u0446 (\u043a\u043e\u0440\u043f\u0443\u0441\u043a\u0443\u043b),
    \u0430 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c, \u043f\u0435\u0440\u0435\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u0443\u044e
    \u0441\u0440\u0435\u0434\u0443 (\u044d\u0444\u0438\u0440) \u043e\u0442 \u0441\u0432\u0435\u0442\u044f\u0449\u0435\u0433\u043e\u0441\u044f
    \u0442\u0435\u043b\u0430 \u043a \u0433\u043b\u0430\u0437\u0443, \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u043e
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044e \u0432 \u043f\u0430\u043b\u043a\u0435.
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c
    \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430 (\u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e)
    \u0438 \u043f\u0440\u044f\u043c\u043e\u043b\u0438\u043d\u0435\u0439\u043d\u043e\u0441\u0442\u044c.
    --- 3. \u0424\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u044f \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0430:
    \u041f\u0435\u0440\u0432\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043c\u043e\u0434\u0435\u043b\u044c \u0442\u0435\u043b\u0430 \u0414\u0435\u043a\u0430\u0440\u0442
    \u2014 \u043e\u0442\u0435\u0446 \u043f\u0441\u0438\u0445\u043e\u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u0440\u0435\u0444\u043b\u0435\u043a\u0441\u043e\u043b\u043e\u0433\u0438\u0438. \u0415\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u0436\u0438\u0432\u043e\u043c\u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0443
    \u043a\u0430\u043a \u043a \u0441\u043b\u043e\u0436\u043d\u043e\u043c\u0443 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0443
    (\u00ab\u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435-\u043c\u0430\u0448\u0438\u043d\u044b\u00bb)
    \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u0432\u0441\u0435\u0439
    \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0439 \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0438
    \u041d\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. - \u0422\u0435\u043e\u0440\u0438\u044f
    \u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0430 (\u0434\u0443\u0433\u043e\u0432\u043e\u0439
    \u0440\u0435\u0444\u043b\u0435\u043a\u0441): \u0414\u0435\u043a\u0430\u0440\u0442 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043e\u043f\u0438\u0441\u0430\u043b \u0440\u0435\u0444\u043b\u0435\u043a\u0442\u043e\u0440\u043d\u0443\u044e
    \u0434\u0443\u0433\u0443. \u041e\u043d \u043f\u043e\u043b\u0430\u0433\u0430\u043b, \u0447\u0442\u043e
    \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435 \u0438 \u0442\u0435\u043b\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u043a\u0430\u043a \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0430\u0448\u0438\u043d\u044b. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0435\u0433\u043e
    \u0441\u0445\u0435\u043c\u0435: 1. \u0412\u043d\u0435\u0448\u043d\u0438\u0439 \u043e\u0431\u044a\u0435\u043a\u0442
    \u0434\u0430\u0432\u0438\u0442 \u043d\u0430 \u043d\u0435\u0440\u0432 (\u00ab\u043d\u0438\u0442\u044c\u00bb),
    \u043d\u0430\u0442\u044f\u0433\u0438\u0432\u0430\u044f \u043a\u043b\u0430\u043f\u0430\u043d
    \u0432 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u043c \u043c\u043e\u0437\u0433\u0435.
    2. \u041a\u043b\u0430\u043f\u0430\u043d \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f.
    3. \u041f\u043e \u043f\u043e\u043b\u044b\u043c \u0442\u0440\u0443\u0431\u043a\u0430\u043c
    (\u043d\u0435\u0440\u0432\u0430\u043c) \u0438\u0437 \u043c\u043e\u0437\u0433\u0430 \u0432
    \u043c\u044b\u0448\u0446\u044b \u0443\u0441\u0442\u0440\u0435\u043c\u043b\u044f\u044e\u0442\u0441\u044f
    \u00ab\u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435 \u0434\u0443\u0445\u0438\u00bb (\u0442\u043e\u043d\u0447\u0430\u0439\u0448\u0438\u0435
    \u0447\u0430\u0441\u0442\u0438\u0446\u044b \u043a\u0440\u043e\u0432\u0438). 4. \u041c\u044b\u0448\u0446\u0430
    \u043d\u0430\u0434\u0443\u0432\u0430\u0435\u0442\u0441\u044f \u0438 \u0441\u043e\u043a\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f.
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0432\u0430\u044f \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043c\u043e\u0434\u0435\u043b\u044c, \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044e\u0449\u0430\u044f
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0431\u0435\u0437 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0434\u0443\u0448\u0438, \u0430 \u0447\u0438\u0441\u0442\u043e \u0440\u0435\u0444\u043b\u0435\u043a\u0442\u043e\u0440\u043d\u043e.
    - \u0414\u0443\u0430\u043b\u0438\u0437\u043c \u0434\u0443\u0448\u0438 \u0438 \u0442\u0435\u043b\u0430
    (\u041f\u0438\u043d\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0436\u0435\u043b\u0435\u0437\u0430):
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0438\u0441\u043a\u0430\u043b \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043e\u0440\u0433\u0430\u043d, \u0433\u0434\u0435 \u043d\u0435\u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u0434\u0443\u0448\u0430 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0438\u0440\u0443\u0435\u0442
    \u0441 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0442\u0435\u043b\u043e\u043c.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0440\u0433\u0430\u043d\u043e\u043c \u043e\u043d \u043e\u0431\u044a\u044f\u0432\u0438\u043b
    \u0448\u0438\u0448\u043a\u043e\u0432\u0438\u0434\u043d\u043e\u0435 \u0442\u0435\u043b\u043e
    (\u044d\u043f\u0438\u0444\u0438\u0437). \u041e\u043d \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e (\u043c\u044b
    \u0437\u043d\u0430\u0435\u043c, \u0447\u0442\u043e \u044d\u043f\u0438\u0444\u0438\u0437
    \u2014 \u0436\u0435\u043b\u0435\u0437\u0430 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439
    \u0441\u0435\u043a\u0440\u0435\u0446\u0438\u0438), \u043d\u043e \u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u043d \u0432\u044b\u0431\u0440\u0430\u043b \u0435\u0433\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e,
    \u0442\u0430\u043a \u043a\u0430\u043a \u044d\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u043d\u0435\u043f\u0430\u0440\u043d\u0430\u044f \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430
    \u043c\u043e\u0437\u0433\u0430. \u0415\u043c\u0443 \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c \u00ab\u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435
    \u0434\u0443\u0445\u0438\u00bb \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0442 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044b\u0435
    \u043e\u0431\u0440\u0430\u0437\u044b. - \u0422\u0435\u043e\u0440\u0438\u044f \u044d\u043c\u043e\u0446\u0438\u0439
    (\u00ab\u0421\u0442\u0440\u0430\u0441\u0442\u0438 \u0434\u0443\u0448\u0438\u00bb): \u0412
    \u0441\u0432\u043e\u0435\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c \u0442\u0440\u0443\u0434\u0435
    \u043e\u043d \u0434\u0430\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e
    \u0448\u0435\u0441\u0442\u0438 \u0431\u0430\u0437\u043e\u0432\u044b\u0445 \u044d\u043c\u043e\u0446\u0438\u0439
    (\u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435, \u043b\u044e\u0431\u043e\u0432\u044c,
    \u043d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u044c, \u0436\u0435\u043b\u0430\u043d\u0438\u0435,
    \u0440\u0430\u0434\u043e\u0441\u0442\u044c, \u043f\u0435\u0447\u0430\u043b\u044c) \u0438
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043b, \u043a\u0430\u043a
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u00ab\u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445
    \u0434\u0443\u0445\u043e\u0432\u00bb \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442 \u0442\u0435\u043b\u0435\u0441\u043d\u044b\u0435
    \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u044d\u0442\u0438\u0445 \u044d\u043c\u043e\u0446\u0438\u0439
    (\u0443\u0447\u0430\u0449\u0435\u043d\u0438\u0435 \u043f\u0443\u043b\u044c\u0441\u0430,
    \u043f\u043e\u043a\u0440\u0430\u0441\u043d\u0435\u043d\u0438\u0435, \u043f\u043b\u0430\u0447).
    - \u041f\u0440\u043e\u0442\u0438\u0432 \u0432\u0438\u0432\u0438\u0441\u0435\u043a\u0446\u0438\u0438
    (\u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441): \u0411\u0443\u0434\u0443\u0447\u0438
    \u043c\u0435\u0445\u0430\u043d\u0438\u0446\u0438\u0441\u0442\u043e\u043c, \u0414\u0435\u043a\u0430\u0440\u0442,
    \u0442\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u043f\u0440\u043e\u0442\u0438\u0432 \u0436\u0435\u0441\u0442\u043e\u043a\u043e\u0433\u043e
    \u0432\u0441\u043a\u0440\u044b\u0442\u0438\u044f \u0436\u0438\u0432\u044b\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445.
    \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0435
    \u043a\u0440\u0438\u0447\u0438\u0442 \u043e\u0442 \u0431\u043e\u043b\u0438, \u044d\u0442\u043e
    \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c \u0440\u0430\u0431\u043e\u0442\u0430
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430, \u043f\u043e\u0434\u043e\u0431\u043d\u0430\u044f
    \u0441\u043a\u0440\u0438\u043f\u0443 \u043d\u0435\u0441\u043c\u0430\u0437\u0430\u043d\u043d\u043e\u0433\u043e
    \u043a\u043e\u043b\u0435\u0441\u0430, \u0430 \u043d\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0442\u0440\u0430\u0434\u0430\u043d\u0438\u044f. \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043f\u043e\u0440\u043d\u043e\u0435,
    \u043d\u043e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0434\u043b\u044f \u0435\u0433\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435.
    --- 4. \u041a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u044f \u0438 \u0433\u0435\u043e\u043b\u043e\u0433\u0438\u044f:
    \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0417\u0435\u043c\u043b\u0438 \u0412 \u043d\u0435\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435
    \u00ab\u041c\u0438\u0440\u00bb \u0414\u0435\u043a\u0430\u0440\u0442 \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b
    \u0441\u043c\u0435\u043b\u044b\u0435 \u0434\u043e\u0433\u0430\u0434\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0432\u0440\u0435\u043c\u044f. - \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442: \u041e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b,
    \u0447\u0442\u043e \u0417\u0435\u043c\u043b\u044f \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043f\u043b\u0430\u043d\u0435\u0442\u044b \u043d\u0435\u043a\u043e\u0433\u0434\u0430 \u0431\u044b\u043b\u0438
    \u0437\u0432\u0435\u0437\u0434\u0430\u043c\u0438 (\u0441\u043e\u043b\u043d\u0446\u0430\u043c\u0438),
    \u043d\u043e \u043e\u0441\u0442\u044b\u043b\u0438, \u043f\u043e\u043a\u0440\u044b\u043b\u0438\u0441\u044c
    \u043a\u043e\u0440\u043e\u0439 \u0438 \u043f\u043e\u0433\u0430\u0441\u043b\u0438. \u0421\u043e\u043b\u043d\u0446\u0435
    \u0436\u0435, \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e, \u2014
    \u0435\u0449\u0435 \u043d\u0435 \u043e\u0441\u0442\u044b\u0432\u0448\u0430\u044f \u0437\u0432\u0435\u0437\u0434\u0430.
    - \u0413\u0435\u043e\u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u044f: \u041e\u043d
    \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0433\u043e\u0440, \u0434\u043e\u043b\u0438\u043d \u0438 \u043a\u043e\u043d\u0442\u0438\u043d\u0435\u043d\u0442\u043e\u0432
    \u043e\u0445\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u0435\u043c \u0438 \u0441\u0436\u0430\u0442\u0438\u0435\u043c.
    \u041f\u043e \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u0438, \u043a\u043e\u0433\u0434\u0430
    \u043c\u043e\u043b\u043e\u0434\u0430\u044f \u0417\u0435\u043c\u043b\u044f \u043e\u0441\u0442\u044b\u0432\u0430\u043b\u0430,
    \u0435\u0435 \u043a\u043e\u0440\u0430 \u0441\u043c\u043e\u0440\u0449\u0438\u0432\u0430\u043b\u0430\u0441\u044c,
    \u043e\u0431\u0440\u0430\u0437\u0443\u044f \u0441\u043a\u043b\u0430\u0434\u043a\u0438 (\u0433\u043e\u0440\u044b),
    \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u043e \u0442\u043e\u043c\u0443, \u043a\u0430\u043a
    \u0441\u043c\u043e\u0440\u0449\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u043e\u0436\u0438\u0446\u0430
    \u044f\u0431\u043b\u043e\u043a\u0430, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u043e
    \u0441\u043e\u0445\u043d\u0435\u0442. \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0432\u0430\u044f
    \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
    \u0433\u043e\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f.
    - \u041e\u043a\u0430\u043c\u0435\u043d\u0435\u043b\u043e\u0441\u0442\u0438: \u041e\u0442\u0440\u0438\u0446\u0430\u044f
    \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0438\u0439 \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u044b\u0439
    \u043f\u043e\u0442\u043e\u043f, \u043e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u043e\u043a\u0430\u043c\u0435\u043d\u0435\u043b\u043e\u0441\u0442\u0438
    \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445
    \u043d\u0430 \u0432\u0435\u0440\u0448\u0438\u043d\u0430\u0445 \u0433\u043e\u0440 \u2014
    \u044d\u0442\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0441\u0443\u0448\u0430 \u0438 \u043c\u043e\u0440\u0435
    \u043d\u0435\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c
    \u043c\u0435\u0441\u0442\u0430\u043c\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0433\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u044d\u043f\u043e\u0445. --- 5. \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0435
    \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u043e\u043c.
    \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c:
    - \u0428\u043b\u0438\u0444\u043e\u0432\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0442\u0430\u043d\u043a\u043e\u0432
    \u0434\u043b\u044f \u043b\u0438\u043d\u0437: \u0412 \u00ab\u0414\u0438\u043e\u043f\u0442\u0440\u0438\u043a\u0435\u00bb
    \u043e\u043d \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043b
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u0441\u0442\u0430\u043d\u043a\u0430
    \u0434\u043b\u044f \u0448\u043b\u0438\u0444\u043e\u0432\u043a\u0438 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043b\u0438\u043d\u0437, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0430\u0432\u0430\u043b\u0438
    \u043c\u0435\u043d\u044c\u0448\u0435 \u0445\u0440\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u0431\u0435\u0440\u0440\u0430\u0446\u0438\u0438, \u0447\u0435\u043c \u043e\u0431\u044b\u0447\u043d\u044b\u0435
    \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043b\u0438\u043d\u0437\u044b.
    - \u0422\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432: \u041f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u044b
    \u0434\u043b\u044f \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0437\u0430
    \u0437\u0432\u0435\u0437\u0434\u0430\u043c\u0438, \u0445\u043e\u0442\u044f \u0435\u0433\u043e
    \u043e\u043f\u0442\u0438\u043a\u0430 (\u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \u0441\u0432\u0435\u0442 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c) \u043c\u0435\u0448\u0430\u043b\u0430
    \u0435\u043c\u0443 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043e\u0446\u0435\u043d\u0438\u0442\u044c
    \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u0435, \u0438\u0437-\u0437\u0430
    \u0447\u0435\u0433\u043e \u0435\u0433\u043e \u043f\u0440\u0438\u0431\u043e\u0440\u044b \u0443\u0441\u0442\u0443\u043f\u0430\u043b\u0438
    \u0433\u0430\u043b\u0438\u043b\u0435\u0435\u0432\u0441\u043a\u0438\u043c. --- \u0418\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043c\u0435\u0441\u0442\u043e: \u041c\u0435\u0436\u0434\u0443 \u0413\u0430\u043b\u0438\u043b\u0435\u0435\u043c
    \u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c \u0412 \u043d\u0430\u0443\u043a\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435
    \u043c\u0435\u0441\u0442\u043e: 1. \u041e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f, \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0432
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u043e\u0441\u0442\u0430\u0442\u043a\u0438
    \u0441\u0445\u043e\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438
    (\u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442 \u043f\u043e\u043d\u044f\u0442\u0438\u0439
    \u00ab\u043b\u0435\u0433\u043a\u043e\u0441\u0442\u044c\u00bb \u0438 \u00ab\u0442\u044f\u0436\u0435\u0441\u0442\u044c\u00bb
    \u043a\u0430\u043a \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445 \u0441\u0432\u043e\u0439\u0441\u0442\u0432
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432). 2. \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u044f\u0437\u044b\u043a (\u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0438 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b),
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d
    \u0447\u0435\u0440\u0435\u0437 40 \u043b\u0435\u0442 \u043d\u0430\u043f\u0438\u0448\u0435\u0442
    \u0441\u0432\u043e\u0438 \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043d\u0430\u0447\u0430\u043b\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb. 3. \u0420\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0441 \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c: \u0415\u0441\u043b\u0438 \u041d\u044c\u044e\u0442\u043e\u043d
    \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438
    \u043a\u0430\u043a \u0434\u0430\u043b\u044c\u043d\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f
    (\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043d\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438
    \u0447\u0435\u0440\u0435\u0437 \u043f\u0443\u0441\u0442\u043e\u0442\u0443), \u0447\u0442\u043e
    \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0414\u0435\u043a\u0430\u0440\u0442\u0443
    \u043c\u0438\u0441\u0442\u0438\u043a\u043e\u0439, \u0442\u043e \u0414\u0435\u043a\u0430\u0440\u0442
    \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b \u043d\u0430 \u0431\u043b\u0438\u0437\u043a\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438
    (\u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0435 \u0441\u0438\u043b\u044b \u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u044f\u043c\u043e\u0439 \u043a\u043e\u043d\u0442\u0430\u043a\u0442
    \u0447\u0430\u0441\u0442\u0438\u0446). \u0412 \u044d\u0442\u043e\u043c \u0441\u043f\u043e\u0440\u0435,
    \u0441 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u044f, \u0414\u0435\u043a\u0430\u0440\u0442
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0432 \u0447\u0435\u043c-\u0442\u043e
    \u0434\u0430\u0436\u0435 \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u043e\u0437\u043e\u0440\u043b\u0438\u0432,
    \u0447\u0435\u043c \u041d\u044c\u044e\u0442\u043e\u043d: \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e\u0435
    \u043f\u043e\u043b\u0435) \u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c \u043a
    \u0438\u0434\u0435\u0435 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437
    \u043f\u043e\u0441\u0440\u0435\u0434\u043d\u0438\u043a\u0430 (\u043f\u043e\u043b\u0435),
    \u0430 \u043d\u0435 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u0447\u0435\u0440\u0435\u0437
    \u043f\u0443\u0441\u0442\u043e\u0442\u0443."
  achievementsEn: "Although the philosophical heritage of Decart is widely known, his contribution to the exact and natural sciences is no less revolutionary, and in fact, Decart was the last universal scientist to work equally deeply in mathematics, physics, biology and medicine, and below is a detailed review of his scientific achievements, broken down into fields of knowledge. -- 1.Mathematics: The birth of analytical geometry and a new algebra is perhaps the most fundamental and enduring contribution of Decart to the entire structure of mathematics.It showed that any geometric location of points (line, circle, conical section) can be described by an algebraic equation with two variables \\(x\\) and \\(y\\) and vice versa: any equation creates a certain curve on the plane. It is Decart that introduced the generally accepted symbols today: \\(x, y, z\\) for unknowns, and \\(a,b, c\\) for known values.The famous third-order curve \\(xx3 + y3 = 3xy\\) that he studied still bears his name. - New notation of degrees: It was Decart that introduced the designation of degrees as \\(xx3, xx4 ) (formerly written in bulky Latin words).- Decart Sign Rule: Formulated a rule to determine the number of positive and negative roots of the algebraic equation in the alternation of the signs in its coefficients. This criterion is still used in the theory of algebraic equations. - Method of undefined coefficients: has developed a universal algorithm to solve the equations of the highest degrees by adding them to square equations. -- 2.Physics and Optics: Mechanics and Vihri in physics Decart was a consistent mechanist who rejected \"hidden forces\" and magic, claiming that all physical phenomena could be attributed to the collision and movement of the smallest particles of matter (column).-The Law on the Conservation of the Number of Movements (impulse): Decart was the first to formulate a general law of nature: \"The total number of movements in the world remains unchanged.\"He defined the measure of motion as a mass-to-speed product (\\(mv\\). Although its wording was not very precise (it did not take into account the vectoric nature of the speed), it was he who introduced this fundamental principle, which Newton would later convert into his laws. - The theory of the vortex (Cartesian vorries): To explain the movement of planet Decart created a grand cosmological model.According to it, space is filled with thinning matter, which is in a continuous circular rotation, and the planets are, in his view, drawn by these vortexes, like the leaves that have been in the vortex, and this theory explained gravity as the centrifugal pressure of the winds; although Newton will later disprove this theory in favour of the law of gravity, the vortex of Decart has dominated European physics for almost 100 years.- Basic Law of Light Refraction (Snell-Decartes Law): In its annex, \"Dioptrica\" (1637) Decart irrespective of Snell and strictly mathematically produced the law of light refraction at the border of two environments: \\\\\\\\\\\\\\\\\\\\1\\sin \\theta_1=n_2sin_2\\\\\\\\t\\theta_2} He gave it clear wording and applied it to the optical lens. Before it, the law was looking for angles, and Decart realized that the key value was the sine of the angle.The rainbow theory: Decart first gave a full mathematical explanation of the rainbow, and he showed that it was caused by the refracting of the sun's rays in the water drops and their subsequent reflection from the inner wall of the drop, and he calculated through his laws the angles under which we see the first and second rainbows (42° and 52°).- Light theory as pressure: Decart did not consider light to be a wave or a flow of particles (column), but pressure passed through the transparent environment (ether) from the glowing body to the eye, similar to the pressure in the stick, which explained the instantity of light diffusion (in his opinion) and directness. -- 3. Physiology and medicine: The first mechanical model of the decartes body is the father of psychophysiology and reflexology.His approach to the living organism as a complex mechanism (\"animal machines\") has become the basis for all of New Time's further physiology. - The reflex theory (arc reflex): Decart first described a reflex arc. He believed that the human animal and body acted as hydraulic machines.4. The muscle is inflated and shrinking. This was the first scientific model to explain the motion without the intervention of the soul and purely reflex.He was wrong functionally (we know that epiphysis is the iron of the inner secretion), but anatomically he chose it right because it's the only non-spouse structure of the brain, and he thought it was here where the \"animal spirits\" formed mental images.- The theory of emotion (\"The Passion of the Soul\"). In his latest work, he classified six basic emotions (surprise, love, hatred, desire, joy, sadness) and described in detail how the \"animal spirits\" movements caused the physical manifestations of these emotions (elevation of pulse, redness, crying). - Against vivisection (paradox): Being a mechanisticist, Descartes nevertheless opposed the brutal autopsy of living animals.He argued that even if an animal screamed for pain, it was just the work of a machine like a squeak of a non-smoking wheel, not an expression of suffering, which was ethically controversial but logically consistent for his system. --4 Cosmology and Geology: Earth history in the unpublished tract \"Peace\" Decart had come up with bold guesses that far ahead of time.- The theory of planet formation: He assumed that the Earth and other planets were once stars, but cooled down, covered with bark and died. The sun, in his view, was not yet a cold star. Geomorphology: He explained the formation of mountains, valleys and continents by cooling and compression. His theory was that when a young earth cooled, its crust was wrinkled, forming folds, like the way the skin of an apple was shrivelled when it was dry.This was the first global theory of horticulture. - fossils: Rejecting the Bible's World Flood, he argued that the fossils of marine animals at the top of mountains were evidence that the land and sea had repeatedly changed places during long geological ages. - Five.He was working on creating: - Scliffov's lens machines: in Dioptrics, he described in detail the design of the hyperbolic lens grinding machine, which gave him less chromatical aberration than normal spherical lenses. - Telescopes: Tryed to create telescopes to observe stars, although his optics (he considered the pressure light) prevented him from properly assessing the fracture, so his instruments were reduced to Galileo.----his historic place: Between Galileo and Newton in science, Descartes has a unique place: 1. He has completed Galileo's scientific revolution, destroying the last vestiges of choclastic physics (he has abandoned the concepts of ease and gravity as the inner properties of objects). 2. He has created a language (algebra and coordinates) in which Newton will write his \"Mathematical Beginnings of Natural Philosophy\" in 40 years.Disseparation with Newton: If Newton introduced gravity as a long-range action (actions across the void), as Descartes seemed to be mystic, Descartes insisted on nearness (the transmission of power only through direct contact with particles).In this debate, in terms of modern quantum physics and field theory, Decart found himself in something even more visional than Newton: modern physics (e.g. electromagnetic field) has come back to the idea that interaction is transmitted through an intermediary (field) rather than instantaneously through a void."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0420\u0435\u043d\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0431\u0435\u0436\u0430\u043b
    \u043e\u0442 \u043c\u0438\u0440\u0441\u043a\u043e\u0439 \u0441\u0443\u0435\u0442\u044b,
    \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043d\u0435 \u0431\u044b\u043b
    \u0430\u0441\u043a\u0435\u0442\u043e\u043c. \u041e\u043d \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0439: \u0434\u0432\u043e\u0440\u044f\u043d\u0438\u043d\u043e\u043c,
    \u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0449\u0438\u043c \u0441\u0432\u043e\u0439 \u0430\u0434\u0440\u0435\u0441,
    \u043e\u0442\u0446\u043e\u043c, \u043f\u043e\u0442\u0435\u0440\u044f\u0432\u0448\u0438\u043c
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0440\u0435\u0431\u0435\u043d\u043a\u0430,
    \u0438 \u043c\u0438\u0437\u0430\u043d\u0442\u0440\u043e\u043f\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u0435\u043b \u043e\u0431\u0448\u0438\u0440\u043d\u0435\u0439\u0448\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441\u043e \u0432\u0441\u0435\u0439 \u0415\u0432\u0440\u043e\u043f\u043e\u0439. \u041d\u0438\u0436\u0435
    \u2014 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0435
    \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0432 \u0438\u043d\u0442\u0438\u043c\u043d\u0443\u044e,
    \u0431\u044b\u0442\u043e\u0432\u0443\u044e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0436\u0438\u0437\u043d\u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430.
    --- 1. \u0412\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u044c, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440
    \u0438 \u0431\u044b\u0442\u043e\u0432\u044b\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438
    - \u0412\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u044c: \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e
    \u0440\u043e\u0441\u0442\u0430, \u0441 \u043a\u0440\u0443\u043f\u043d\u043e\u0439 \u0433\u043e\u043b\u043e\u0432\u043e\u0439,
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043b\u0431\u043e\u043c \u0438
    \u0442\u043e\u043d\u043a\u0438\u043c, \u043f\u0440\u043e\u043d\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u043c. \u041e\u043d \u0431\u044b\u043b \u0431\u043b\u0435\u0434\u0435\u043d
    \u0438\u0437-\u0437\u0430 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u044f\u0445 \u0438 \u0438\u043c\u0435\u043b
    \u0442\u0438\u0445\u0438\u0439, \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u043e\u043c\u043a\u0438\u0439
    \u0433\u043e\u043b\u043e\u0441. \u041d\u043e\u0441\u0438\u043b \u043e\u043d \u0441\u043a\u0440\u043e\u043c\u043d\u0443\u044e,
    \u043d\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u043e\u043f\u0440\u044f\u0442\u043d\u0443\u044e
    \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u043a\u0443\u044e \u043e\u0434\u0435\u0436\u0434\u0443
    \u2014 \u0447\u0435\u0440\u043d\u044b\u0439 \u043a\u0430\u043c\u0437\u043e\u043b \u0438
    \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0431\u0435\u043b\u044b\u0439 \u0432\u043e\u0440\u043e\u0442\u043d\u0438\u043a.
    - \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440: \u041e\u043d \u0431\u044b\u043b \u043a\u0440\u0430\u0439\u043d\u0435
    \u0437\u0430\u043c\u043a\u043d\u0443\u0442, \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u0435\u043d
    \u0438 \u043d\u0435\u0434\u043e\u0432\u0435\u0440\u0447\u0438\u0432. \u0414\u0440\u0443\u0437\u044c\u044f
    \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438 \u0435\u0433\u043e \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u044b\u0439
    \u0438 \u0438\u043d\u043e\u0433\u0434\u0430 \u043a\u043e\u043b\u043a\u0438\u0439 \u0443\u043c.
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u0431\u043e\u044f\u043b\u0441\u044f \u043e\u0433\u043b\u0430\u0441\u043a\u0438 \u0438 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439,
    \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043e \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u0438
    \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043b \u0441 \u043c\u0435\u0441\u0442\u0430
    \u043d\u0430 \u043c\u0435\u0441\u0442\u043e 24 \u0440\u0430\u0437\u0430 \u0437\u0430 20
    \u043b\u0435\u0442, \u0447\u0430\u0441\u0442\u043e \u0434\u0430\u0436\u0435 \u043d\u0435
    \u0441\u043e\u043e\u0431\u0449\u0430\u044f \u0434\u0440\u0443\u0437\u044c\u044f\u043c \u043d\u043e\u0432\u043e\u0433\u043e
    \u0430\u0434\u0440\u0435\u0441\u0430. \u041e\u043d \u0431\u044b\u043b \u043f\u0435\u0440\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u043e\u043c
    \u0438 \u043f\u0435\u0434\u0430\u043d\u0442\u043e\u043c \u0432 \u0434\u0435\u043b\u0430\u0445
    \u043d\u0430\u0443\u043a\u0438, \u043d\u043e \u0432 \u0431\u044b\u0442\u0443 \u2014 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u044b\u043c.
    - \u0420\u0435\u0436\u0438\u043c \u0434\u043d\u044f: \u0414\u0435\u043a\u0430\u0440\u0442
    \u0431\u044b\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u00ab\u0441\u043e\u0432\u043e\u0439\u00bb.
    \u041e\u043d \u043b\u043e\u0436\u0438\u043b\u0441\u044f \u0434\u0430\u043b\u0435\u043a\u043e
    \u0437\u0430 \u043f\u043e\u043b\u043d\u043e\u0447\u044c \u0438 \u0432\u0441\u0442\u0430\u0432\u0430\u043b
    \u043e\u043a\u043e\u043b\u043e 11\u201312 \u0447\u0430\u0441\u043e\u0432 \u0434\u043d\u044f.
    \u0421\u0432\u043e\u0435 \u043b\u0443\u0447\u0448\u0435\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0434\u043b\u044f \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439 \u043e\u043d
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u00ab\u0443\u0442\u0440\u043e\u043c \u0441\u0440\u0435\u0434\u0438
    \u043d\u043e\u0447\u0438\u00bb (\u043e\u0431\u044b\u0447\u043d\u043e \u0441 2 \u0434\u043e
    5 \u0447\u0430\u0441\u043e\u0432 \u0443\u0442\u0440\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0432\u0441\u0435 \u0441\u043f\u0430\u043b\u0438, \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u043a\u0440\u043e\u0432\u0430\u0442\u0438). \u0418\u043c\u0435\u043d\u043d\u043e
    \u044d\u0442\u043e\u0442 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c
    \u0438 \u0441\u0442\u0430\u043b \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u043e\u0439 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u0432 \u0428\u0432\u0435\u0446\u0438\u0438,
    \u0433\u0434\u0435 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0430 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430
    \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0435\u0433\u043e \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044c
    \u0432 5 \u0443\u0442\u0440\u0430. - \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435: \u0411\u0443\u0434\u0443\u0447\u0438
    \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0445\u0440\u0443\u043f\u043a\u0438\u043c,
    \u043e\u043d \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u0436\u0430\u043b\u043e\u0432\u0430\u043b\u0441\u044f
    \u043d\u0430 \u0441\u0443\u0445\u043e\u0439 \u043a\u0430\u0448\u0435\u043b\u044c, \u0441\u043b\u0430\u0431\u044b\u0435
    \u043b\u0435\u0433\u043a\u0438\u0435 \u0438 \u0441\u043a\u043b\u043e\u043d\u043d\u043e\u0441\u0442\u044c
    \u043a \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430\u043c. \u041e\u043d \u043b\u0435\u0447\u0438\u043b\u0441\u044f
    \u043a\u0440\u043e\u0432\u043e\u043f\u0443\u0441\u043a\u0430\u043d\u0438\u044f\u043c\u0438
    \u0438 \u0441\u0442\u0440\u043e\u0433\u043e\u0439 \u0434\u0438\u0435\u0442\u043e\u0439,
    \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043b\u044e\u0431\u0438\u043b
    \u0432\u043a\u0443\u0441\u043d\u043e \u043f\u043e\u0435\u0441\u0442\u044c \u0438 \u0432\u044b\u043f\u0438\u0442\u044c
    \u0445\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u0431\u0443\u0440\u0433\u0443\u043d\u0434\u0441\u043a\u043e\u0433\u043e
    \u0432\u0438\u043d\u0430. --- 2. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0436\u0435\u043d\u0449\u0438\u043d\u0430\u043c\u0438: \u0424\u0440\u0430\u043d\u0441\u0438\u043d\u0430
    \u0438 \u0425\u0435\u043b\u0435\u043d\u0430 \u042f\u043d\u0441 \u042d\u0442\u043e \u0441\u0430\u043c\u0430\u044f
    \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u0430\u044f
    \u0433\u043b\u0430\u0432\u0430 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.
    - \u0421\u043b\u0443\u0436\u0430\u043d\u043a\u0430 \u0425\u0435\u043b\u0435\u043d\u0430
    \u042f\u043d\u0441 \u0432\u0430\u043d \u0434\u0435\u0440 \u0421\u0442\u0440\u043e\u043c:
    \u0412 1634 \u0433\u043e\u0434\u0443, \u0436\u0438\u0432\u044f \u0432 \u0410\u043c\u0441\u0442\u0435\u0440\u0434\u0430\u043c\u0435,
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043d\u0430\u043d\u044f\u043b \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0443
    \u0434\u043b\u044f \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0430.
    \u0415\u044e \u0441\u0442\u0430\u043b\u0430 \u0425\u0435\u043b\u0435\u043d\u0430 \u2014
    \u0434\u0435\u0432\u0443\u0448\u043a\u0430 \u0438\u0437 \u043f\u0440\u043e\u0441\u0442\u043e\u0439
    \u0441\u0435\u043c\u044c\u0438, \u0434\u043e\u0447\u044c \u0442\u0440\u0430\u043a\u0442\u0438\u0440\u0449\u0438\u043a\u0430.
    \u0412 1635 \u0433\u043e\u0434\u0443 \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0434\u043e\u0447\u044c. - \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441
    \u0425\u0435\u043b\u0435\u043d\u043e\u0439: \u042d\u0442\u043e \u043d\u0435 \u0431\u044b\u043b
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0440\u043e\u043c\u0430\u043d \u0432 \u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0441\u043c\u044b\u0441\u043b\u0435. \u0414\u0435\u043a\u0430\u0440\u0442 \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f
    \u043a \u0425\u0435\u043b\u0435\u043d\u0435 \u0441 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c,
    \u043d\u043e \u043a\u0430\u043a \u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443
    \u0431\u043e\u043b\u0435\u0435 \u043d\u0438\u0437\u043a\u043e\u0433\u043e \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0441\u0442\u0430\u0442\u0443\u0441\u0430. \u041e\u043d \u0442\u0430\u043a \u0438 \u043d\u0435
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u043d\u0435\u0439 (\u0431\u0440\u0430\u043a
    \u0441 \u043f\u0440\u0438\u0441\u043b\u0443\u0433\u043e\u0439 \u0431\u044b\u043b \u0431\u044b
    \u043c\u0435\u0437\u0430\u043b\u044c\u044f\u043d\u0441\u043e\u043c \u0438 \u0438\u0441\u043f\u043e\u0440\u0442\u0438\u043b
    \u0431\u044b \u0435\u0433\u043e \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u043a\u0443\u044e
    \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e). \u041e\u0434\u043d\u0430\u043a\u043e
    \u043e\u043d \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u043b \u0435\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e,
    \u0438 \u043e\u043d\u0430 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u0441
    \u043d\u0438\u043c \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438.
    \u041f\u043e\u0441\u043b\u0435 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438 \u0441 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0438\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043e\u0445\u043b\u0430\u0434\u0435\u043b\u0438,
    \u043d\u043e \u0425\u0435\u043b\u0435\u043d\u0430 \u0432\u0435\u043b\u0430 \u0435\u0433\u043e
    \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u043e \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e \u043e\u0442\u044a\u0435\u0437\u0434\u0430 \u0432 \u0428\u0432\u0435\u0446\u0438\u044e.
    - \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u0424\u0440\u0430\u043d\u0441\u0438\u043d\u044b (1635\u20131640): \u0414\u0435\u043a\u0430\u0440\u0442
    \u0431\u044b\u043b \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d
    \u0434\u043e\u0447\u0435\u0440\u044c\u044e. \u041e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u0435\u0435 \u0424\u0440\u0430\u043d\u0441\u0438\u043d\u043e\u0439 \u0432 \u0447\u0435\u0441\u0442\u044c
    \u0441\u0435\u0431\u044f (\u0424\u0440\u0430\u043d\u0441\u0438\u043d \u2014 \u0436\u0435\u043d\u0441\u043a\u0430\u044f
    \u0444\u043e\u0440\u043c\u0430 \u043e\u0442 \u0424\u0440\u0430\u043d\u0441\u0443\u0430/\u0420\u0435\u043d\u0435).
    \u0412 \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u0434\u0440\u0443\u0437\u044c\u044f\u043c
    \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0435\u0451 \u0441\u0432\u043e\u0435\u0439
    \u00ab\u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439 \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u043a\u043e\u0439\u00bb
    \u0438 \u00ab\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0443\u0442\u0435\u0448\u0435\u043d\u0438\u0435\u043c
    \u0432 \u044d\u0442\u043e\u043c \u043c\u0438\u0440\u0435\u00bb. - \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f:
    \u0412 1640 \u0433\u043e\u0434\u0443 \u043f\u044f\u0442\u0438\u043b\u0435\u0442\u043d\u044f\u044f
    \u0424\u0440\u0430\u043d\u0441\u0438\u043d\u0430 \u0437\u0430\u0431\u043e\u043b\u0435\u043b\u0430
    \u0441\u043a\u0430\u0440\u043b\u0430\u0442\u0438\u043d\u043e\u0439. \u0414\u0435\u043a\u0430\u0440\u0442,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0432\u0440\u0430\u0447\u043e\u043c \u043f\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044e,
    \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0435\u0435 \u043b\u0435\u0447\u0438\u0442\u044c. \u0414\u0435\u0432\u043e\u0447\u043a\u0430
    \u0443\u043c\u0435\u0440\u043b\u0430 \u0443 \u043d\u0435\u0433\u043e \u043d\u0430 \u0440\u0443\u043a\u0430\u0445.
    \u042d\u0442\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u0435 \u0441\u043b\u043e\u043c\u0430\u043b\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430. \u041e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u0432 \u0436\u0438\u0437\u043d\u0438
    \u043d\u0435 \u043f\u043b\u0430\u043a\u0430\u043b \u0442\u0430\u043a \u0433\u043e\u0440\u044c\u043a\u043e,
    \u043a\u0430\u043a \u0432 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c. \u041e\u043d \u0443\u0435\u0445\u0430\u043b
    \u0438\u0437 \u0410\u043c\u0441\u0442\u0435\u0440\u0434\u0430\u043c\u0430 \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u044e,
    \u0447\u0442\u043e\u0431\u044b \u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u044e
    \u043f\u0435\u0447\u0430\u043b\u044c, \u0438 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e
    \u0441\u0442\u0430\u043b \u0435\u0449\u0435 \u0431\u043e\u043b\u0435\u0435 \u043c\u0440\u0430\u0447\u043d\u044b\u043c
    \u0438 \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u043c. \u0412
    \u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u044d\u0442\u0430
    \u0431\u043e\u043b\u044c \u043e\u0442\u0440\u0430\u0437\u0438\u043b\u0430\u0441\u044c \u0432
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u00ab\u0421\u0442\u0440\u0430\u0441\u0442\u0438
    \u0434\u0443\u0448\u0438\u00bb, \u0433\u0434\u0435 \u043e\u043d \u0441 \u043e\u0441\u043e\u0431\u044b\u043c
    \u0446\u0438\u043d\u0438\u0437\u043c\u043e\u043c \u0438 \u0431\u043e\u043b\u044c\u044e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u044e \u0433\u043e\u0440\u044f. ---
    3. \u0414\u0440\u0443\u0436\u0431\u0430 \u0438 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430
    (\u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c)
    \u041f\u0440\u0438 \u0441\u0432\u043e\u0435\u0439 \u043c\u0438\u0437\u0430\u043d\u0442\u0440\u043e\u043f\u0438\u0438
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0437\u0430\u0432\u0438\u0441\u0438\u043c \u043e\u0442 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u043d\u0438\u044f. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c \u0438 \u00ab\u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u043c
    \u0430\u0433\u0435\u043d\u0442\u043e\u043c\u00bb \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u0431\u044b\u043b \u041c\u0430\u0440\u0435\u043d
    \u041c\u0435\u0440\u0441\u0435\u043d\u043d (\u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u043c\u043e\u043d\u0430\u0445-\u043c\u0438\u043d\u0438\u043c\u0430\u043b\u0438\u0442 \u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a). \u0418\u043c\u0435\u043d\u043d\u043e
    \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443 \u0414\u0435\u043a\u0430\u0440\u0442 \u0434\u043e\u0432\u0435\u0440\u044f\u043b
    \u0432\u0441\u0435 \u0441\u0432\u043e\u0438 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438,
    \u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u0447\u0435\u0440\u0435\u0437 \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0430
    \u0448\u043b\u0430 \u0432\u0441\u044f \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0430. - \u0421\u0432\u044f\u0437\u044c \u0441
    \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u043e\u0439 \u0415\u043b\u0438\u0437\u0430\u0432\u0435\u0442\u043e\u0439
    \u0411\u043e\u0433\u0435\u043c\u0441\u043a\u043e\u0439: \u042d\u0442\u043e \u043e\u0434\u043d\u0430
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0445
    \u043f\u043b\u0430\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u0421 1643 \u0433\u043e\u0434\u0430 \u0414\u0435\u043a\u0430\u0440\u0442 \u043d\u0430\u0447\u0430\u043b
    \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441 \u0415\u043b\u0438\u0437\u0430\u0432\u0435\u0442\u043e\u0439 \u041f\u0444\u0430\u043b\u044c\u0446\u0441\u043a\u043e\u0439
    (\u0434\u043e\u0447\u0435\u0440\u044c\u044e \u00ab\u0417\u0438\u043c\u043d\u0435\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f\u00bb \u0411\u043e\u0433\u0435\u043c\u0438\u0438).
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0443\u043c\u043d\u0435\u0439\u0448\u0435\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439 \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u0438\u0441\u0430\u043b \u0435\u0439 \u043d\u0435
    \u043a\u0430\u043a \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043e\u0441\u043e\u0431\u0435,
    \u0430 \u043a\u0430\u043a \u0440\u0430\u0432\u043d\u043e\u0439 \u043f\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u043a
    \u043d\u0435\u0439 \u043e\u043d \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b
    \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0441\u0432\u043e\u0435\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0438 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e
    \u0441\u0432\u043e\u0431\u043e\u0434\u044b \u0432\u043e\u043b\u0438. \u041e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0435\u0451 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439, \u043a\u0442\u043e
    \u043f\u043e\u043d\u044f\u043b \u0435\u0433\u043e \u00ab\u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u044e\u00bb
    \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0445 \u0443\u0447\u0435\u043d\u044b\u0445-\u043c\u0443\u0436\u0447\u0438\u043d.
    \u041f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 \u0434\u043b\u0438\u043b\u0430\u0441\u044c
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438.
    - \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0430 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430:
    \u0412\u0442\u043e\u0440\u0430\u044f \u0437\u043d\u0430\u0447\u0438\u043c\u0430\u044f \u00ab\u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043a\u0430\u00bb.
    \u041d\u043e \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0442\u0451\u043f\u043b\u044b\u0445
    \u0438 \u043d\u0435\u0436\u043d\u044b\u0445 \u043f\u0438\u0441\u0435\u043c \u043a \u0415\u043b\u0438\u0437\u0430\u0432\u0435\u0442\u0435,
    \u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0441 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u043e\u0439
    \u0431\u044b\u043b\u043e \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e-\u0445\u043e\u043b\u043e\u0434\u043d\u044b\u043c.
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430 \u0441\u0447\u0438\u0442\u0430\u043b\u0430
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u043b\u0438\u0448\u044c \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u043c
    \u00ab\u044d\u043a\u0441\u043f\u043e\u043d\u0430\u0442\u043e\u043c\u00bb \u0434\u043b\u044f
    \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u0432\u043e\u0440\u0430. --- 4. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0435\u043d\u044c\u0433\u0430\u043c\u0438 \u0438 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0435\u0439
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0431\u044b\u043b \u0434\u0432\u043e\u0440\u044f\u043d\u0438\u043d\u043e\u043c
    \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c (\u0432
    \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430
    \u0443\u0447\u0435\u043d\u044b\u0445 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438).
    \u0415\u0433\u043e \u043a\u0430\u043f\u0438\u0442\u0430\u043b \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438:
    - \u041d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e, \u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435
    \u043e\u0442\u0446\u043e\u043c (\u0437\u0435\u043c\u0435\u043b\u044c\u043d\u044b\u0435 \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u044f
    \u0432 \u041f\u0443\u0430\u0442\u0443). - \u041f\u0435\u043d\u0441\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u043b \u043e\u0442 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f (\u041b\u044e\u0434\u043e\u0432\u0438\u043a XIII \u0434\u0430\u0440\u043e\u0432\u0430\u043b
    \u0435\u043c\u0443 \u043f\u0435\u043d\u0441\u0438\u043e\u043d \u0432 1000 \u043b\u0438\u0432\u0440\u043e\u0432
    \u0432 1635 \u0433\u043e\u0434\u0443). - \u0417\u0430 \u0441\u0432\u043e\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u044b \u043e\u043d \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u043b
    \u0433\u043e\u043d\u043e\u0440\u0430\u0440\u043e\u0432 \u043a\u0430\u043a \u0441\u0435\u0439\u0447\u0430\u0441.
    \u041d\u0430\u043e\u0431\u043e\u0440\u043e\u0442, \u043e\u043d \u0438\u0437\u0434\u0430\u0432\u0430\u043b
    \u0438\u0445 \u0437\u0430 \u0441\u0432\u043e\u0439 \u0441\u0447\u0435\u0442 \u0438 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b
    \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u0437\u043d\u0430\u0442\u043d\u044b\u043c
    \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044f\u043c, \u0447\u0442\u043e\u0431\u044b
    \u0437\u0430\u0440\u0443\u0447\u0438\u0442\u044c\u0441\u044f \u0438\u0445 \u0437\u0430\u0449\u0438\u0442\u043e\u0439.
    \u041e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0436\u0438\u043c\u0438\u0441\u0442 \u0438
    \u0440\u0430\u0441\u0447\u0435\u0442\u043b\u0438\u0432. \u041f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u044f,
    \u043e\u043d \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u043e\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u043b\u0441\u044f
    \u043e \u043d\u0438\u0437\u043a\u043e\u0439 \u0430\u0440\u0435\u043d\u0434\u043d\u043e\u0439
    \u043f\u043b\u0430\u0442\u0435, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u0434\u0435\u0440\u0436\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0441\u043b\u0443\u0433 (\u043a\u0430\u043c\u0435\u0440\u0434\u0438\u043d\u0435\u0440\u0430,
    \u043a\u0443\u0445\u0430\u0440\u043a\u0443 \u0438, \u043a\u043e\u043d\u0435\u0447\u043d\u043e,
    \u0425\u0435\u043b\u0435\u043d\u0443). \u041e\u043d \u043e\u0447\u0435\u043d\u044c \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u043d\u043e
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u0441\u0432\u043e\u0435\u043c\u0443
    \u0441\u0442\u0430\u0442\u0443\u0441\u0443, \u043f\u0440\u0438 \u043b\u044e\u0431\u043e\u043c
    \u0443\u0434\u043e\u0431\u043d\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044f
    \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u0430\u043c,
    \u0447\u0442\u043e \u043e\u043d \u00ab\u0448\u0435\u0432\u0430\u043b\u044c\u0435, \u0441\u0435\u043d\u044c\u043e\u0440
    \u0434\u044e \u041f\u0435\u0440\u0440\u043e\u043d\u00bb (\u0445\u043e\u0442\u044f \u043f\u043e\u043c\u0435\u0441\u0442\u044c\u0435
    \u0431\u044b\u043b\u043e \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u043c). --- 5. \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f
    \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u043a\u0438
    - \u041e\u0445\u043e\u0442\u0430 \u043d\u0430 \u0432\u0435\u0434\u044c\u043c \u0432 \u0422\u0438\u0440\u043e\u043b\u0435:
    \u0412 1619 \u0433\u043e\u0434\u0443, \u0431\u0443\u0434\u0443\u0447\u0438 \u043d\u0430
    \u0432\u043e\u0435\u043d\u043d\u043e\u0439 \u0441\u043b\u0443\u0436\u0431\u0435 \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438,
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u043e\u0442\u0434\u0430\u043b\u0435\u043d\u043d\u0443\u044e
    \u0434\u0435\u0440\u0435\u0432\u043d\u044e (\u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0437\u0438\u043c\u043e\u0432\u043a\u0438), \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438
    \u00ab\u0431\u0440\u0430\u0442\u0441\u0442\u0432\u043e \u0440\u043e\u0437\u0435\u043d\u043a\u0440\u0435\u0439\u0446\u0435\u0440\u043e\u0432\u00bb
    \u2014 \u0442\u0430\u0439\u043d\u043e\u0435 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e, \u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0445\u043e\u0434\u0438\u043b\u0438 \u0441\u043b\u0443\u0445\u0438. \u041e\u043d \u0438\u0445
    \u043d\u0435 \u043d\u0430\u0448\u0435\u043b, \u0437\u0430\u0442\u043e \u043d\u0430\u0448\u0435\u043b
    \u0443\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0439.
    - \u042d\u043f\u0438\u0437\u043e\u0434 \u0441 \u044f\u0439\u0446\u043e\u043c: \u0412 \u041f\u0430\u0440\u0438\u0436\u0435
    \u0432 1620-\u0445 \u0433\u043e\u0434\u0430\u0445, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0432\u0430\u043a\u0443\u0443\u043c\u0430 (\u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u043e\u0442\u0440\u0438\u0446\u0430\u043b), \u0414\u0435\u043a\u0430\u0440\u0442
    \u044f\u043a\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u043b \u043e\u043f\u044b\u0442
    \u0441\u043e \u0441\u0442\u0435\u043a\u043b\u044f\u043d\u043d\u043e\u0439 \u0442\u0440\u0443\u0431\u043a\u043e\u0439
    \u0438 \u044f\u0439\u0446\u043e\u043c, \u0432\u0433\u043e\u043d\u044f\u044f \u0435\u0433\u043e
    \u0432 \u0433\u043e\u0440\u043b\u044b\u0448\u043a\u043e \u0441\u043e\u0441\u0443\u0434\u0430
    \u0441\u0438\u043b\u043e\u0439 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u043e\u0437\u0434\u0443\u0445\u0430.
    \u042d\u0442\u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0448\u043e\u0443
    \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u043b\u0438 \u043a \u043d\u0435\u043c\u0443
    \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0437\u043d\u0430\u0442\u0438. - \u0421\u0441\u043e\u0440\u044b
    \u0441 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0430\u043c\u0438: \u0412 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u0438
    \u043e\u043d \u0432\u0435\u043b \u0441\u0435\u0431\u044f \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0435
    \u0441\u043c\u0435\u043b\u043e \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u043e\u0431\u0432\u0438\u043d\u044f\u043b\u0438
    \u0432 \u0430\u0442\u0435\u0438\u0437\u043c\u0435, \u043e\u043d \u043d\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0441\u044f,
    \u0430 \u043f\u0438\u0441\u0430\u043b \u044f\u0437\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043f\u0430\u043c\u0444\u043b\u0435\u0442\u044b \u043d\u0430 \u0434\u0435\u043a\u0430\u043d\u0430
    \u0423\u0442\u0440\u0435\u0445\u0442\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0412\u043e\u044d\u0446\u0438\u044f, \u043d\u0430\u0437\u044b\u0432\u0430\u044f \u0435\u0433\u043e
    \u00ab\u0442\u0443\u043f\u0438\u0446\u0435\u0439\u00bb. \u042d\u0442\u043e \u0447\u0443\u0442\u044c
    \u043d\u0435 \u0441\u0442\u043e\u0438\u043b\u043e \u0435\u043c\u0443 \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u044f
    \u0438\u0437 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u0438 \u0432 1646 \u0433\u043e\u0434\u0443
    \u2014 \u043e\u043d \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u043d\u0430 \u0432\u0440\u0435\u043c\u044f \u0443\u0435\u0445\u0430\u0442\u044c \u0432\u043e
    \u0424\u0440\u0430\u043d\u0446\u0438\u044e, \u0447\u0442\u043e\u0431\u044b \u043e\u0441\u0442\u044b\u043b\u0438
    \u0441\u0442\u0440\u0430\u0441\u0442\u0438, \u043d\u043e \u0431\u044b\u0441\u0442\u0440\u043e
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f. --- 6. \u0416\u0438\u0437\u043d\u044c
    \u0432 \u0428\u0432\u0435\u0446\u0438\u0438: \u0424\u0430\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u043f\u0440\u0438\u0445\u043e\u0442\u044c
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f
    \u0438 \u0441\u0430\u043c\u0430\u044f \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0433\u043b\u0430\u0432\u0430
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438.
    - \u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435: \u0412 1649 \u0433\u043e\u0434\u0443
    23-\u043b\u0435\u0442\u043d\u044f\u044f \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0430
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0441\u0432\u043e\u0438\u043c \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u043c
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c (\u043e\u043d\u0430 \u043e\u0434\u0435\u0432\u0430\u043b\u0430\u0441\u044c
    \u043a\u0430\u043a \u043c\u0443\u0436\u0447\u0438\u043d\u0430, \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0430\u0441\u044c
    \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u0437\u0430\u043c\u0443\u0436 \u0438 \u043f\u043e\u0437\u0436\u0435
    \u043e\u0442\u0440\u0435\u043a\u043b\u0430\u0441\u044c \u043e\u0442 \u0442\u0440\u043e\u043d\u0430),
    \u0437\u0430\u0441\u044b\u043f\u0430\u043b\u0430 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u043f\u0438\u0441\u044c\u043c\u0430\u043c\u0438. \u041e\u043d\u0430 \u043d\u0435 \u0445\u043e\u0442\u0435\u043b\u0430
    \u0435\u0433\u043e \u043a\u043d\u0438\u0433, \u043e\u043d\u0430 \u0445\u043e\u0442\u0435\u043b\u0430,
    \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u043b\u0438\u0447\u043d\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0435\u0435 \u0432 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438. - \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u043a\u043b\u0438\u043c\u0430\u0442\u043e\u0432: \u0414\u0435\u043a\u0430\u0440\u0442 \u043d\u0435
    \u0445\u043e\u0442\u0435\u043b \u0435\u0445\u0430\u0442\u044c (\u00ab\u042f \u0440\u043e\u0436\u0434\u0435\u043d
    \u0432 \u0441\u0430\u0434\u0430\u0445 \u0422\u044e\u0438\u043b\u044c\u0440\u0438, \u0430
    \u043d\u0435 \u0441\u0440\u0435\u0434\u0438 \u0441\u043a\u0430\u043b \u0438 \u043c\u0435\u0434\u0432\u0435\u0434\u0435\u0439
    \u0421\u0435\u0432\u0435\u0440\u0430\u00bb \u2014 \u043f\u0438\u0441\u0430\u043b \u043e\u043d),
    \u043d\u043e \u043f\u043e\u0434 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0441\u043b\u0430 \u0438 \u0441\u0442\u0440\u0430\u0445\u0430 \u043f\u043e\u0442\u0435\u0440\u044f\u0442\u044c
    \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0441\u0434\u0430\u043b\u0441\u044f. - \u0410\u0434\u0441\u043a\u0438\u0439 \u0433\u0440\u0430\u0444\u0438\u043a:
    \u041f\u0440\u0438\u0431\u044b\u0432 \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c
    \u0432 \u043e\u043a\u0442\u044f\u0431\u0440\u0435 1649 \u0433\u043e\u0434\u0430, \u043e\u043d
    \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f \u0441 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c.
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0430 \u0431\u044b\u043b\u0430 \u0444\u0430\u043d\u0430\u0442\u0438\u0447\u043d\u044b\u043c
    \u00ab\u0436\u0430\u0432\u043e\u0440\u043e\u043d\u043a\u043e\u043c\u00bb \u0438 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0430
    \u0443\u0440\u043e\u043a\u043e\u0432 \u0432 5 \u0447\u0430\u0441\u043e\u0432 \u0443\u0442\u0440\u0430
    \u0432 \u0441\u0432\u043e\u0435\u0439 \u043d\u0435\u043e\u0442\u0430\u043f\u043b\u0438\u0432\u0430\u0435\u043c\u043e\u0439
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435 (\u0437\u0438\u043c\u043e\u0439
    \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430
    \u043f\u0430\u0434\u0430\u0435\u0442 \u0434\u043e -20\u00b0C). \u0414\u043b\u044f \u0414\u0435\u043a\u0430\u0440\u0442\u0430,
    \u043f\u0440\u0438\u0432\u044b\u043a\u0448\u0435\u0433\u043e \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044c
    \u0432 \u043f\u043e\u043b\u0434\u0435\u043d\u044c, \u044d\u0442\u043e \u0431\u044b\u043b\u043e
    \u043f\u044b\u0442\u043a\u043e\u0439. - \u041e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e:
    \u0412 \u0428\u0432\u0435\u0446\u0438\u0438 \u0441 \u043d\u0438\u043c \u043d\u0435 \u0431\u044b\u043b\u043e
    \u0425\u0435\u043b\u0435\u043d\u044b. \u041e\u043d \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441\u0435\u0431\u044f \u0447\u0443\u0436\u0430\u043a\u043e\u043c \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435,
    \u0433\u0434\u0435 \u0432\u0441\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438 \u043f\u043e-\u0448\u0432\u0435\u0434\u0441\u043a\u0438
    \u0438\u043b\u0438 \u043f\u043e-\u043d\u0435\u043c\u0435\u0446\u043a\u0438. \u041e\u043d
    \u0436\u0430\u043b\u043e\u0432\u0430\u043b\u0441\u044f, \u0447\u0442\u043e \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0441\u044f
    \u0432 \u00ab\u0436\u0438\u0432\u0443\u044e \u043a\u043d\u0438\u0433\u0443\u00bb \u0434\u043b\u044f
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0445\u043e\u0442\u044f\u0442, \u0430 \u043d\u0435 \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \u043d\u0443\u0436\u043d\u043e. --- 7. \u0422\u0430\u0439\u043d\u0430 \u0441\u043c\u0435\u0440\u0442\u0438:
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0438\u043b\u0438 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435?
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1650
    \u0433\u043e\u0434\u0430, \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044f\u0441\u044c
    \u0441 \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0433\u043e \u0440\u0430\u043d\u043d\u0435\u0433\u043e
    \u0443\u0440\u043e\u043a\u0430 \u043e\u0442 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u044b,
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u043e\u043f\u0430\u043b \u043f\u043e\u0434 \u043b\u0435\u0434\u044f\u043d\u043e\u0439
    \u0434\u043e\u0436\u0434\u044c \u0438 \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0438\u043b\u0441\u044f.
    \u041e\u043d \u0441\u043b\u0435\u0433 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439
    \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u0439 \u0438 \u043a\u0430\u0448\u043b\u0435\u043c.
    - \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u0440\u0430\u0447\u0435\u0439: \u041f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0435
    \u0432\u0440\u0430\u0447\u0438 (\u0441\u0430\u043c \u0414\u0435\u043a\u0430\u0440\u0442
    \u0431\u044b\u043b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0441\u043b\u0430\u0431,
    \u0447\u0442\u043e\u0431\u044b \u043b\u0435\u0447\u0438\u0442\u044c \u0441\u0435\u0431\u044f)
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0443\u044e
    \u0434\u043b\u044f \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u043d\u043e \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0434\u043b\u044f
    \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443:
    \u043a\u0440\u043e\u0432\u043e\u043f\u0443\u0441\u043a\u0430\u043d\u0438\u0435. \u042d\u0442\u043e
    \u0435\u0449\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u043e\u0441\u043b\u0430\u0431\u0438\u043b\u043e
    \u0435\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c. - \u0417\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435:
    \u041f\u0435\u0440\u0435\u0434 \u0441\u043c\u0435\u0440\u0442\u044c\u044e \u043e\u043d \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b
    \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430
    \u0438 \u043f\u0440\u043e\u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b \u043e\u0447\u0435\u043d\u044c
    \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435,
    \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u0432\u0441\u0435 \u0441\u0432\u043e\u0435 \u0441\u043a\u0443\u0434\u043d\u043e\u0435
    \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e (\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u043a\u043d\u0438\u0433\u0438 \u0438 \u0434\u043e\u043b\u0433\u0438) \u0425\u0435\u043b\u0435\u043d\u0435
    \u042f\u043d\u0441. - \u0412\u0435\u0440\u0441\u0438\u044f \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f:
    \u0412 1980-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0448\u0432\u0435\u0434\u0441\u043a\u0438\u0439
    \u0432\u0440\u0430\u0447-\u0442\u043e\u043a\u0441\u0438\u043a\u043e\u043b\u043e\u0433 \u042d\u0439\u043a\u0435
    \u041f\u0438\u043b\u044c\u0446 \u0438\u0437\u0443\u0447\u0438\u043b \u043e\u0441\u0442\u0430\u043d\u043a\u0438
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430 (\u0432\u043e\u043b\u043e\u0441\u044b, \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0438\u0435\u0441\u044f
    \u0432 \u0440\u0435\u043b\u0438\u043a\u0432\u0430\u0440\u0438\u0438) \u0438 \u043d\u0430\u0448\u0435\u043b
    \u0432 \u043d\u0438\u0445 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435
    \u043c\u044b\u0448\u044c\u044f\u043a\u0430 (\u0432 11 \u0440\u0430\u0437 \u0432\u044b\u0448\u0435
    \u043d\u043e\u0440\u043c\u044b). - \u041a\u043e\u043d\u0441\u043f\u0438\u0440\u043e\u043b\u043e\u0433\u0438\u044f:
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0441\u0438\u043b\u044c\u043d\u043e \u043c\u0435\u0448\u0430\u043b
    \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438
    \u0438 \u0438\u0435\u0437\u0443\u0438\u0442\u0430\u043c, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u0435\u0433\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c
    \u043f\u043e\u0434\u0440\u044b\u0432\u0430\u043b \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442
    \u0432\u0435\u0440\u044b. \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430
    \u0432 1654 \u0433\u043e\u0434\u0443 (\u0447\u0435\u0440\u0435\u0437 4 \u0433\u043e\u0434\u0430)
    \u0442\u0430\u0439\u043d\u043e \u043f\u0440\u0438\u043d\u044f\u043b\u0430 \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0438\u0437\u043c\u0435\u043d\u043e\u0439 \u0432 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u043e\u0439
    \u0428\u0432\u0435\u0446\u0438\u0438. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442,
    \u0447\u0442\u043e \u0438\u0435\u0437\u0443\u0438\u0442\u044b, \u0436\u0435\u043b\u0430\u0432\u0448\u0438\u0435
    \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0443,
    \u0431\u043e\u044f\u043b\u0438\u0441\u044c, \u0447\u0442\u043e \u0414\u0435\u043a\u0430\u0440\u0442
    \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0435\u0451, \u0438 \u0443\u0431\u0440\u0430\u043b\u0438
    \u0435\u0433\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u044b\u0448\u044c\u044f\u043a\u0430,
    \u043f\u043e\u0434\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0433\u043e \u0432 \u0432\u0438\u043d\u043e
    \u0438\u043b\u0438 \u043f\u0440\u0438\u0447\u0430\u0441\u0442\u0438\u0435. - \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u0432\u0435\u0440\u0441\u0438\u044f: \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438-\u043e\u0440\u0442\u043e\u0434\u043e\u043a\u0441\u044b
    \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u044e\u0442 \u044d\u0442\u0443 \u0432\u0435\u0440\u0441\u0438\u044e,
    \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044f, \u0447\u0442\u043e \u043c\u044b\u0448\u044c\u044f\u043a
    \u0432 \u0442\u0443 \u044d\u043f\u043e\u0445\u0443 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u043a\u0430\u043a \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u043e (\u0432 \u043c\u0430\u043b\u044b\u0445
    \u0434\u043e\u0437\u0430\u0445) \u043e\u0442 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043e\u043a,
    \u0438 \u043e\u043d \u043c\u043e\u0433 \u043d\u0430\u043a\u043e\u043f\u0438\u0442\u044c\u0441\u044f
    \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0435 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043f\u0443\u0442\u0435\u043c. \u041e\u0434\u043d\u0430\u043a\u043e \u0437\u0430\u0433\u0430\u0434\u043a\u0430
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440.
    \u0423\u043c\u0435\u0440 \u043e\u043d 11 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1650
    \u0433\u043e\u0434\u0430, \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441\u044f \u043f\u0435\u0440\u0435\u0434
    \u044d\u0442\u0438\u043c, \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u0444\u0440\u0430\u0437\u0443:
    \u00ab\u0414\u0443\u0448\u0430 \u043c\u043e\u044f, \u0442\u044b \u0434\u043e\u043b\u0433\u043e
    \u0431\u044b\u043b\u0430 \u0432 \u0442\u0435\u043c\u043d\u0438\u0446\u0435, \u0442\u0435\u043f\u0435\u0440\u044c
    \u043d\u0430\u0441\u0442\u0430\u043b \u0447\u0430\u0441 \u0432\u044b\u0439\u0442\u0438 \u0438\u0437
    \u043d\u0435\u0451\u00bb."
  personalLifeEn: "The personal life of Renee Descartes is the story of a genius who deliberately fled from worldly fuss, but was not an ascetic. He was a man of contradiction: a nobleman hiding his address, a father who lost his only child, and a mysanthropus who kept an extensive correspondence from all over Europe.Appearance, character, and domestic habits - Appearance: Moderns described Descartes as a small man, with a large head, an outstanding forehead, and a subtle, discerning look. He was pale because of his constant work in the premises and had a quiet, somewhat broken voice. He carried a modest but always neat noble clothing — black gems and a simple white collar. - Nature: He was extremely closed, suspicious and untrustworthy.His friends pointed out his ironic and sometimes prickly mind. Decart was pathologically afraid of publicity and persecution, which led him to move 24 times to the spot in Holland in 20 years, often without even telling his friends the new address. He was a perfectionist and a pedant in science, but he was scattered in his home.He called his best time for reflection \"the morning in the night\" (usually from 2 to 5 a.m., when everyone was asleep, he worked in bed) and it was this routine that caused his death in Sweden, where Queen Cristina made him rise at 5 a.m. — Health: As a child, he had been fragile, complaining for his entire life about dry cough, weak lungs, and fever.He was treated with blood and severe diets, but he liked to eat and drink good burgundy wine. -- 2. Relations with women: Francine and Helena Jans is the most touching and human head of his life story. - Serena Helena Jans van der Strom: In 1634, living in Amsterdam, Descartes hired a maid for the household.His relationship with Helena: It was not a great novel in a poetic sense. Descartes treated Helena with respect, but as a lesser social status, he never married her (the marriage of a servant would be a mesalian and would have ruined his noble reputation). However, he provided her financially, and she stayed with him until his death. After the tragedy, their relationship with her daughter cooled down, but Helena kept his household until he left Sweden.- The birth and death of Francine (1635–1640): Descartes was completely enthralled by his daughter. He named her Francine after herself (Francine is a woman's uniform from François/Rene) In letters to her friends, he called her \"a little Dutch girl\" and \"the only comfort in the world.\" Tragedy: in 1640, Franzina became ill with Scarlatine. Decart, as an educational doctor, tried to treat her unsuccessfully.He said that he had never cried as bitter in his life as that day, and he left Amsterdam to hide his sorrow, and then became even darker and more distant. In his philosophy, this pain was reflected in the tract \"The Passion of the Soul\", where he described with particular cynicism and pain the physiology of grief. -- 3.His friendship and correspondence (Social Life) in his mysanthropy, Descartes, was incredibly dependent on intellectual communication. His main friend and \"literary agent\" throughout his life was Marin Mercenn (a French monk with minimality and mathematics).- Linking to Princess Elizabeth of Bohemia: This is one of the most beautiful platonic stories in the history of philosophy. Since 1643, Decart has started intensive correspondence with Elizabeth of Pfalzskaya (the daughter of the Winter King of Bohemia). She was the smartest woman of her time. Decart wrote her not as a royal person but as an intellectual equal. It was in his letters to her that he elaborated in detail the ethical part of his philosophy and the concept of free will.He called her the only one who understood his \"psychology\" better than any male scientist.The relationship with the money and the aristocracy of Descartes was a noble man and never worked as a teacher (as opposed to most scientists at the time), and his capital was: - The inheritance left by the father (the land ownership in Poitus). - The pension he received from the French king (Livarian XIII gave him a pension of 1,000 liures in 1635). - For his scientific tracts he did not receive fees as now.But when he left, he said, \"My Lord, I have given you my money, and I have given you my money, and I have given you my money, and I have given you my money, and I have given you my money, and I have given you my money, and I have given you my money, and I have given you my money, and I have given you my money, and I have given you my money, and I have given you your money, and I have given you your money, and I have given you your money, and I have given you your money, and I have given you your money, and I have given you your money, and I have given you your money, and I have given you your money, and I have given you your money, and I have given you your money to my friends, and I have given you your money to my friends, and I have been a very good friend, and I have been a good friend to you, and I have always been a good friend, but I have always been a little bit of you, but I have always been a little bit of you.Traveling and eccentric acts - Hunting of witches in Tyrol: In 1619, while in military service in Germany, Decart went to a remote village (in winter) to find a \"brotherhood of rosecraters\", a secret mystical society about which rumours had gone on, but he did not find them, but found privacy for his philosophical insight.In Paris in the 1620s to prove a vacuum (which he denied), Descartes allegedly experimented with a glass tube and an egg, pushing him into the vessel &apos; s throat with pressure of air pressure, these physical shows attracted the attention of the nobles.When he was accused of atheism, he did not hide, but wrote sarcastic pamphlets on the Dean of the University of Utrecht, Voetia, calling him \"stupid.\" It almost cost him his expulsion from Holland in 1646 -- he had to leave for France for a while to cool his passions, but quickly to return. -- 6. Life in Sweden: Fatal Royal Want was the last and hardest part of his personal life.- Invitation: In 1649, the 23-year-old Queen of Christina, known for her eccentric character (she dressed as a man, refused to marry and later renounced the throne), drank Descartes with letters. She didn't want his books, she wanted him to teach her personally in philosophy.- Climate conflict: Descartes did not want to go (I was born in the Tuilry Gardens, not among the rocks and bears of the North, he wrote), but under pressure from the French ambassador and fear of losing his patronymic, he gave up. - Hell's schedule: He came to Stockholm in October 1649, he faced an impossibility. The queen was a fanatical \"divoroncom\" and demanded lessons at 5 a.m. in her unheated library (the winter in Stockholm, the temperature drops to -20 °C).For Descartes, who used to get up at noon, it was torture.The secret of death: Disease or poisoning? Early in February 1650, returning from another early lesson from Christina, Descartes fell under the cold rain and became cold. He lay low with high temperatures and cough.- Will: Before his death, he asked for a priest and gave a very short will, leaving all of his meagre property (mainly books and debts) to Helena Jans. - Poison version: In the 1980s, Swedish toxicologist Eike Piltz examined the remains of Descartes (woles retained in the relic), and found an elevated arsenic content (11 times higher than normal).- Conspirology: Decart was a major obstacle to the Catholic Church and Jesuits because his rationalism undermined the credibility of faith.- Official version: Orthodox historians reject this version, pointing out that arsenic was used as a cure (in small doses) of fever in that era, and it could accumulate naturally in the body, but the mystery of his death remains open. He died on February 11, 1650, saying, in legend, \"My soul, you have been in the dungeon for a long time, now the hour has come out of it.\""
  shortBioRu: "\u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442 (1596\u20131650) \u2014 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u043e\u0438\u0441\u043f\u044b\u0442\u0430\u0442\u0435\u043b\u044c,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043f\u043e \u043f\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u043e\u0432
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u041d\u043e\u0432\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438. \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e: \u043e\u0442 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0442\u0435\u0437\u0438\u0441\u0430 \u00ab\u042f \u043c\u044b\u0441\u043b\u044e, \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u044f \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u00bb \u0434\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u0432 \u043c\u0435\u0445\u0430\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0430\u044f
    \u0432\u0441\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u044d\u0442\u0430\u043f\u044b
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\u269c\ufe0f \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b (1596\u20131606) \u0420\u0435\u043d\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 31 \u043c\u0430\u0440\u0442\u0430
    1596 \u0433\u043e\u0434\u0430 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u041b\u0430-\u042d-\u0430\u043d-\u0422\u0443\u0440\u0435\u043d
    (\u043d\u044b\u043d\u0435 \u2014 \u0433\u043e\u0440\u043e\u0434 \u0414\u0435\u043a\u0430\u0440\u0442)
    \u0432 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0424\u0440\u0430\u043d\u0446\u0438\u0438,
    \u0432 \u0441\u0442\u0430\u0440\u0438\u043d\u043d\u043e\u043c, \u043d\u043e \u043e\u0431\u0435\u0434\u043d\u0435\u0432\u0448\u0435\u043c
    \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u043a\u043e\u043c \u0440\u043e\u0434\u0443. \u041e\u043d
    \u0431\u044b\u043b \u043c\u043b\u0430\u0434\u0448\u0438\u043c, \u0442\u0440\u0435\u0442\u044c\u0438\u043c
    \u0441\u044b\u043d\u043e\u043c \u0432 \u0441\u0435\u043c\u044c\u0435. - \u0421\u0435\u043c\u044c\u044f:
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0416\u043e\u0430\u043a\u0438\u043c \u0414\u0435\u043a\u0430\u0440\u0442,
    \u0431\u044b\u043b \u0441\u0443\u0434\u044c\u0435\u0439 \u0438 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c
    \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u0420\u0435\u043d\u043d \u0438 \u0440\u0435\u0434\u043a\u043e \u0431\u044b\u0432\u0430\u043b
    \u0434\u043e\u043c\u0430. \u041c\u0430\u0442\u044c, \u0416\u0430\u043d\u043d\u0430 \u0411\u0440\u043e\u0448\u0430\u0440,
    \u0443\u043c\u0435\u0440\u043b\u0430, \u043a\u043e\u0433\u0434\u0430 \u0420\u0435\u043d\u0435
    \u0431\u044b\u043b \u0432\u0441\u0435\u0433\u043e \u0433\u043e\u0434 \u043e\u0442 \u0440\u043e\u0434\u0443,
    \u0438 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435\u043c \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0430\u0441\u044c \u0435\u0433\u043e \u0431\u0430\u0431\u0443\u0448\u043a\u0430
    \u043f\u043e \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u043e\u0439 \u043b\u0438\u043d\u0438\u0438.
    - \u0414\u0435\u0442\u0441\u0442\u0432\u043e: \u0414\u0435\u043a\u0430\u0440\u0442 \u0441
    \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0441\u044f
    \u0445\u0440\u0443\u043f\u043a\u0438\u043c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c,
    \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u043b\u044e\u0431\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0432\u0438\u0434\u044f \u0442\u044f\u0433\u0443
    \u0441\u044b\u043d\u0430 \u043a \u043d\u0430\u0443\u043a\u0430\u043c, \u0432 \u0448\u0443\u0442\u043a\u0443
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0435\u0433\u043e \u00ab\u0441\u0432\u043e\u0438\u043c
    \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c\u00bb.\n\n\U0001F393
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u044e\u043d\u043e\u0441\u0442\u044c
    (1606\u20131618) - \u041a\u043e\u043b\u043b\u0435\u0436 \u041b\u0430-\u0424\u043b\u0435\u0448
    (1606\u20131614): \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 10 \u043b\u0435\u0442
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439 \u0438\u0435\u0437\u0443\u0438\u0442\u0441\u043a\u0438\u0439
    \u043a\u043e\u043b\u043b\u0435\u0436 \u041b\u0430-\u0424\u043b\u0435\u0448 (\u0410\u043d\u0436\u0443),
    \u043e\u0434\u043d\u043e \u0438\u0437 \u043b\u0443\u0447\u0448\u0438\u0445 \u0443\u0447\u0435\u0431\u043d\u044b\u0445
    \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u0415\u0432\u0440\u043e\u043f\u044b
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0417\u0434\u0435\u0441\u044c
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435,
    \u0438\u0437\u0443\u0447\u0430\u043b \u0434\u0440\u0435\u0432\u043d\u0438\u0435 \u044f\u0437\u044b\u043a\u0438,
    \u0440\u0438\u0442\u043e\u0440\u0438\u043a\u0443, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0443, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u0413\u0430\u043b\u0438\u043b\u0435\u044f. - \u0412\u043b\u0438\u044f\u043d\u0438\u0435:
    \u0420\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0435 \u0443\u0431\u0435\u0434\u0438\u043b\u043e \u0435\u0433\u043e, \u0430 \u0441\u043a\u043e\u0440\u0435\u0435
    \u0443\u043a\u0440\u0435\u043f\u0438\u043b\u043e \u0441\u043a\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u0441\u0445\u043e\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u043d\u0430 \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044f.
    \u0412 \u043a\u043e\u043b\u043b\u0435\u0436\u0435 \u043e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u041c\u0430\u0440\u0435\u043d\u043e\u043c
    \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0441\u0442\u0430\u043d\u0435\u0442
    \u0435\u0433\u043e \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c
    \u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u043c \u043c\u0438\u0440\u0435. - \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041f\u0443\u0430\u0442\u044c\u0435 (1614\u20131616): \u0421\u043b\u0435\u0434\u0443\u044f
    \u0436\u0435\u043b\u0430\u043d\u0438\u044e \u043e\u0442\u0446\u0430 \u0441\u0442\u0430\u0442\u044c
    \u044e\u0440\u0438\u0441\u0442\u043e\u043c, \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041f\u0443\u0430\u0442\u044c\u0435,
    \u0433\u0434\u0435 \u0432 1616 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u0438 \u043b\u0438\u0446\u0435\u043d\u0446\u0438\u0430\u0442\u0430 (\u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430)
    \u043f\u0440\u0430\u0432\u0430 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u0430\u043d\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430.\n\n\U0001F5FA\ufe0f
    \u00ab\u0412\u0435\u043b\u0438\u043a\u0430\u044f \u043a\u043d\u0438\u0433\u0430 \u043c\u0438\u0440\u0430\u00bb
    \u0438 \u0432\u043e\u0435\u043d\u043d\u0430\u044f \u0441\u043b\u0443\u0436\u0431\u0430 (1618\u20131628)
    \u0420\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0441\u044c
    \u0432 \u0441\u0445\u043e\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0443\u0447\u0435\u043d\u043e\u0441\u0442\u0438, \u0414\u0435\u043a\u0430\u0440\u0442 \u0440\u0435\u0448\u0438\u043b
    \u00ab\u0438\u0437\u0443\u0447\u0438\u0442\u044c \u0432\u0435\u043b\u0438\u043a\u0443\u044e
    \u043a\u043d\u0438\u0433\u0443 \u043c\u0438\u0440\u0430\u00bb \u0447\u0435\u0440\u0435\u0437
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u0438 \u0432\u043e\u0435\u043d\u043d\u0443\u044e
    \u0441\u043b\u0443\u0436\u0431\u0443. - \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u044f
    \u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0441 \u0411\u0435\u043a\u043c\u0430\u043d\u043e\u043c
    (1618): \u0412 1618 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0443 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043d\u0430\u0435\u043c\u043d\u043e\u0433\u043e \u043e\u0444\u0438\u0446\u0435\u0440\u0430
    \u0432 \u0430\u0440\u043c\u0438\u044e \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u043e\u0433\u043e
    \u0448\u0442\u0430\u0442\u0433\u0430\u043b\u044c\u0442\u0435\u0440\u0430 \u041c\u043e\u0440\u0438\u0446\u0430
    \u041d\u0430\u0441\u0441\u0430\u0443\u0441\u043a\u043e\u0433\u043e \u0432 \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0430\u0445.
    \u0412 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u0440\u0435\u0434\u0430 \u043e\u043d
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0444\u0438\u0437\u0438\u043a\u043e\u043c \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0418\u0441\u0430\u0430\u043a\u043e\u043c \u0411\u0435\u043a\u043c\u0430\u043d\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0430
    \u043d\u0435\u0433\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u0438 \u043f\u043e\u0434\u0442\u043e\u043b\u043a\u043d\u0443\u043b \u043a \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c
    \u0442\u043e\u0447\u043d\u044b\u043c\u0438 \u043d\u0430\u0443\u043a\u0430\u043c\u0438. \u0414\u043b\u044f
    \u0411\u0435\u043a\u043c\u0430\u043d\u0430 \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u0442\u0440\u0443\u0434 \u2014 \u00abCompendium of Music\u00bb (\u0421\u0436\u0430\u0442\u043e\u0435
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043c\u0443\u0437\u044b\u043a\u0438).
    - \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f \u0438 \u00ab\u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0435\u00bb
    (1619\u20131620): \u0417\u0430\u0442\u0435\u043c \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0443 \u043a \u0431\u0430\u0432\u0430\u0440\u0441\u043a\u043e\u043c\u0443
    \u0433\u0435\u0440\u0446\u043e\u0433\u0443 \u041c\u0430\u043a\u0441\u0438\u043c\u0438\u043b\u0438\u0430\u043d\u0443
    \u0438 \u043f\u0440\u0438\u043d\u044f\u043b \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432
    \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u043c \u044d\u0442\u0430\u043f\u0435 \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u0438\u043b\u0435\u0442\u043d\u0435\u0439
    \u0432\u043e\u0439\u043d\u044b, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435
    \u0432 \u0431\u0438\u0442\u0432\u0435 \u043f\u0440\u0438 \u0411\u0435\u043b\u043e\u0439
    \u0413\u043e\u0440\u0435 (1620). - \u0422\u0440\u0438 \u0441\u043d\u0430: \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434, 10 \u043d\u043e\u044f\u0431\u0440\u044f
    1619 \u0433\u043e\u0434\u0430, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0437\u0438\u043c\u043e\u0432\u043a\u0438
    \u0432 \u041d\u043e\u0439\u0431\u0443\u0440\u0433\u0435-\u043d\u0430-\u0414\u0443\u043d\u0430\u0435,
    \u0414\u0435\u043a\u0430\u0440\u0442, \u043f\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u043e\u0432\u0430\u043c, \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0442\u0440\u0438
    \u00ab\u0441\u043d\u0430\u00bb \u0438\u043b\u0438 \u00ab\u043e\u0437\u0430\u0440\u0435\u043d\u0438\u044f\u00bb,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u043c\u0443 \u0431\u044b\u043b\u0430
    \u043e\u0442\u043a\u0440\u044b\u0442\u0430 \u043d\u043e\u0432\u0430\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u0438 \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0438\u0434\u0435\u044f \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043d\u0430\u0443\u043a.
    - \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e
    \u0438 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f (1620\u20131628):
    \u041e\u0441\u0442\u0430\u0432\u0438\u0432 \u0441\u043b\u0443\u0436\u0431\u0443 \u0432 1621
    \u0433\u043e\u0434\u0443, \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435 (\u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0418\u0442\u0430\u043b\u0438\u044e, \u0433\u0434\u0435 \u043f\u043e\u0441\u0435\u0442\u0438\u043b
    \u0420\u0438\u043c \u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0430\u043b\u043e\u043c\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0432 \u041b\u043e\u0440\u0435\u0442\u043e), \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u043e\u0432\u0435\u043b
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435.
    \u0412 \u041f\u0430\u0440\u0438\u0436\u0435 \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0432\u0440\u0430\u0449\u0430\u043b\u0441\u044f \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u043a\u0440\u0443\u0433\u0430\u0445, \u043e\u0431\u0449\u0430\u043b\u0441\u044f \u0441
    \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u043e\u043c, \u043d\u043e \u0442\u0430\u043a\u0436\u0435
    \u0432\u0435\u043b \u0441\u0432\u0435\u0442\u0441\u043a\u0443\u044e \u0436\u0438\u0437\u043d\u044c.
    \u0412 1627 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0438\u043d\u044f\u043b \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u043e\u0441\u0430\u0434\u0435 \u041b\u0430-\u0420\u043e\u0448\u0435\u043b\u0438,
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u043e\u043f\u043b\u043e\u0442\u0430
    \u0433\u0443\u0433\u0435\u043d\u043e\u0442\u043e\u0432.\n\n\U0001F1F3\U0001F1F1 \u0413\u043e\u0434\u044b
    \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u0438: \u0440\u0430\u0441\u0446\u0432\u0435\u0442
    \u043a\u0430\u0440\u0442\u0435\u0437\u0438\u0430\u043d\u0441\u0442\u0432\u0430 (1628\u20131649)
    \u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0439
    \u0438 \u0432\u0430\u0436\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u0432
    \u0436\u0438\u0437\u043d\u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430. \u041e\u043f\u0430\u0441\u0430\u044f\u0441\u044c
    \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0439 \u0432 \u0435\u0440\u0435\u0441\u0438
    \u0438 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0441\u043e
    \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0446\u0435\u0440\u043a\u0432\u0438, \u043e\u043d \u0432 1628 \u0433\u043e\u0434\u0443
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043b\u0430\u0432\u0438\u043b\u0438\u0441\u044c
    \u0441\u0432\u043e\u0435\u0439 \u0432\u0435\u0440\u043e\u0442\u0435\u0440\u043f\u0438\u043c\u043e\u0441\u0442\u044c\u044e.
    \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b 20 \u043b\u0435\u0442
    \u0432 \u0443\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0438, \u0447\u0430\u0441\u0442\u043e
    \u043c\u0435\u043d\u044f\u044f \u043c\u0435\u0441\u0442\u043e \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0438 \u0441\u043a\u0440\u044b\u0432\u0430\u044f \u0441\u0432\u043e\u0439 \u0430\u0434\u0440\u0435\u0441,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c \u0441\u0435\u0431\u044f
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430\u0443\u043a\u0435.
    - \u0413\u043b\u0430\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b: \u0412 \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0430\u0445
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0441\u043e\u0437\u0434\u0430\u043b \u0432\u0441\u0435
    \u0441\u0432\u043e\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f:
    - \u00ab\u0420\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u043e \u043c\u0435\u0442\u043e\u0434\u0435\u00bb
    (1637): \u041e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u043d\u0430
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435
    \u0441 \u0442\u0440\u0435\u043c\u044f \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c\u0438-\u00ab\u044d\u0441\u0441\u0435\u00bb:
    \u00ab\u0414\u0438\u043e\u043f\u0442\u0440\u0438\u043a\u0430\u00bb, \u00ab\u041c\u0435\u0442\u0435\u043e\u0440\u044b\u00bb
    \u0438 \u00ab\u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f\u00bb. \u0412 \u044d\u0442\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u043e\u043d \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f:
    \u00abJe pense, donc je suis\u00bb (\u00ab\u042f \u043c\u044b\u0441\u043b\u044e, \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u044f \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u00bb). - \u00ab\u0420\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f
    \u043e \u043f\u0435\u0440\u0432\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb
    (1641, \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438): \u0412 \u044d\u0442\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442
    \u0441\u0432\u043e\u044e \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0443 \u0438
    \u0434\u0430\u0435\u0442 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0431\u044b\u0442\u0438\u044f
    \u0411\u043e\u0433\u0430. - \u00ab\u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb (1644, \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438):
    \u0421\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0435\u0433\u043e \u0444\u0438\u0437\u0438\u043a\u0438,
    \u043a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0438.
    - \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f \u00ab\u041c\u0438\u0440\u0430\u00bb
    (1633): \u0412 1633 \u0433\u043e\u0434\u0443 \u0414\u0435\u043a\u0430\u0440\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u00ab\u041c\u0438\u0440, \u0438\u043b\u0438 \u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u043e \u0441\u0432\u0435\u0442\u0435\u00bb (Le Monde), \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u0433\u0435\u043b\u0438\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430.
    \u0423\u0437\u043d\u0430\u0432 \u043e\u0431 \u043e\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0438
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0435\u0439,
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0432 \u0441\u0442\u0440\u0430\u0445\u0435 \u043e\u0442\u043b\u043e\u0436\u0438\u043b
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e, \u0442\u0430\u043a \u043a\u0430\u043a
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0432\u0437\u0433\u043b\u044f\u0434\u044b
    \u0448\u043b\u0438 \u0432\u0440\u0430\u0437\u0440\u0435\u0437 \u0441 \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u044b\u043c\u0438
    \u0434\u043e\u0433\u043c\u0430\u0442\u0430\u043c\u0438. \u041e\u043d \u043f\u0438\u0441\u0430\u043b
    \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443: \u00ab\u0415\u0441\u043b\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u0417\u0435\u043c\u043b\u0438 \u0435\u0441\u0442\u044c \u043b\u043e\u0436\u044c, \u0442\u043e
    \u043b\u043e\u0436\u044c \u0438 \u0432\u0441\u0435 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u043c\u043e\u0435\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb. -
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f:
    \u0412 1635 \u0433\u043e\u0434\u0443 \u0443 \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0434\u043e\u0447\u044c \u0424\u0440\u0430\u043d\u0441\u0438\u043d\u0430 \u043e\u0442 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0438
    \u0425\u0435\u043b\u0435\u043d\u044b \u042f\u043d\u0441 \u0432\u0430\u043d \u0434\u0435\u0440
    \u0421\u0442\u0440\u043e\u043c. \u0425\u043e\u0442\u044f \u043e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043a\u0440\u0435\u0449\u0435\u043d\u0430, \u0435\u0435 \u0447\u0430\u0441\u0442\u043e
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u00ab\u043d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0439\u00bb.
    \u041f\u044f\u0442\u0438\u043b\u0435\u0442\u043d\u044f\u044f \u0424\u0440\u0430\u043d\u0441\u0438\u043d\u0430
    \u0443\u043c\u0435\u0440\u043b\u0430 \u043e\u0442 \u0441\u043a\u0430\u0440\u043b\u0430\u0442\u0438\u043d\u044b
    \u0432 1640 \u0433\u043e\u0434\u0443, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0434\u043b\u044f \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u0433\u043e\u0440\u0435\u043c \u0432 \u0436\u0438\u0437\u043d\u0438. - \u0422\u0440\u0430\u0432\u043b\u044f
    \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u0438: \u041a 1640-\u043c \u0433\u043e\u0434\u0430\u043c
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c \u043a\u0430\u0440\u0442\u0435\u0437\u0438\u0430\u043d\u0441\u0442\u0432\u0430
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445 \u0432\u044b\u0437\u0432\u0430\u043b\u0430
    \u043e\u043f\u0430\u0441\u0435\u043d\u0438\u044f \u043a\u0430\u043b\u044c\u0432\u0438\u043d\u0438\u0441\u0442\u0441\u043a\u0438\u0445
    \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u043e\u0432, \u0442\u0430\u043a\u0438\u0445
    \u043a\u0430\u043a \u0413\u0438\u0441\u0431\u0435\u0440\u0442 \u0412\u043e\u044d\u0446\u0438\u0439.
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u043e\u0431\u0432\u0438\u043d\u044f\u043b\u0438
    \u0432 \u0430\u0442\u0435\u0438\u0437\u043c\u0435 \u0438 \u0435\u0440\u0435\u0441\u0438,
    \u043e\u043d \u0432\u0435\u043b \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0435\u043d\u043d\u0443\u044e
    \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0443 \u0441 \u043d\u0438\u043c\u0438 \u0438
    \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u0431\u044b\u043b \u0438\u0441\u043a\u0430\u0442\u044c
    \u0437\u0430\u0449\u0438\u0442\u044b \u0443 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0441\u043b\u0430 \u0438 \u043f\u0440\u0438\u043d\u0446\u0430 \u041e\u0440\u0430\u043d\u0441\u043a\u043e\u0433\u043e.\n\n\U0001F451
    \u0428\u0432\u0435\u0446\u0438\u044f \u0438 \u0441\u043c\u0435\u0440\u0442\u044c (1649\u20131650)
    \u0412 1649 \u0433\u043e\u0434\u0443, \u0438\u0437\u043c\u0443\u0447\u0435\u043d\u043d\u044b\u0439
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439 \u0442\u0440\u0430\u0432\u043b\u0435\u0439,
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0448\u0432\u0435\u0434\u0441\u043a\u043e\u0439 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u044b
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u044b, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0434\u0430\u0432\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0441\u044f,
    \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c.
    \u0415\u0435 \u0446\u0435\u043b\u044c\u044e \u0431\u044b\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u0430 \u0441\u0430\u043c
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b
    \u043e\u0431\u0443\u0447\u0430\u0442\u044c \u0435\u0435 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    - \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0434\u043d\u0438: \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0441\u043a\u0438\u0439
    \u043a\u043b\u0438\u043c\u0430\u0442 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0433\u0443\u0431\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0434\u043b\u044f \u0445\u0440\u0443\u043f\u043a\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430. \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0430
    \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b\u0430 \u043d\u0430 \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u0445
    \u0432 5 \u0447\u0430\u0441\u043e\u0432 \u0443\u0442\u0440\u0430, \u0447\u0442\u043e \u043d\u0430\u0440\u0443\u0448\u0430\u043b\u043e
    \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u044b\u0439 \u0434\u043b\u044f \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0440\u0435\u0436\u0438\u043c. \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1650 \u0433\u043e\u0434\u0430 \u043e\u043d \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0438\u043b\u0441\u044f
    \u043f\u043e \u0434\u043e\u0440\u043e\u0433\u0435 \u0432\u043e \u0434\u0432\u043e\u0440\u0435\u0446
    \u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u043b. - \u0421\u043c\u0435\u0440\u0442\u044c
    \u0438 \u0437\u0430\u0433\u0430\u0434\u043a\u0430: 11 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1650 \u0433\u043e\u0434\u0430 \u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043d\u0430 \u0434\u0435\u0432\u044f\u0442\u044b\u0439
    \u0434\u0435\u043d\u044c \u0431\u043e\u043b\u0435\u0437\u043d\u0438. \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438 \u0431\u044b\u043b\u0430
    \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0438 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u0430\u044f
    \u0432\u0435\u0440\u0441\u0438\u044f \u2014 \u043e\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u043c
    \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u043c\u044b\u0448\u044c\u044f\u043a\u043e\u043c.
    \u0415\u0435 \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b\u0438 \u0432 XX \u0432\u0435\u043a\u0435
    \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0445
    \u0441\u043b\u0435\u0434\u043e\u0432 \u043c\u044b\u0448\u044c\u044f\u043a\u0430 \u0432 \u0435\u0433\u043e
    \u043e\u0441\u0442\u0430\u043d\u043a\u0430\u0445. \u0421\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u0438
    \u044d\u0442\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442,
    \u0447\u0442\u043e \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0430\u0433\u0435\u043d\u0442\u044b \u043e\u043f\u0430\u0441\u0430\u043b\u0438\u0441\u044c,
    \u0447\u0442\u043e \u0441\u0432\u043e\u0431\u043e\u0434\u043e\u043c\u044b\u0441\u043b\u0438\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043c\u0435\u0448\u0430\u0442\u044c
    \u0438\u0445 \u043f\u043b\u0430\u043d\u0430\u043c \u043f\u043e \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u044b \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u044b
    \u0432 \u043a\u0430\u0442\u043e\u043b\u0438\u0446\u0438\u0437\u043c (\u0447\u0442\u043e
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0432 1654 \u0433\u043e\u0434\u0443).\n\n\u26b0\ufe0f
    \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u0430\u044f \u0441\u0443\u0434\u044c\u0431\u0430
    \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 - \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438: \u0423\u0436\u0435 \u0432 1663 \u0433\u043e\u0434\u0443
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0431\u044b\u043b\u0438 \u0432\u043d\u0435\u0441\u0435\u043d\u044b \u0432 \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u00ab\u0418\u043d\u0434\u0435\u043a\u0441 \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043d\u044b\u0445
    \u043a\u043d\u0438\u0433\u00bb, \u0430 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u0443\u043a\u0430\u0437\u043e\u043c \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0430 XIV
    \u0437\u0430\u043f\u0440\u0435\u0449\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435
    \u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0432\u043e \u0432\u0441\u0435\u0445
    \u0443\u0447\u0435\u0431\u043d\u044b\u0445 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u0445.
    - \u041e\u0441\u0442\u0430\u043d\u043a\u0438: \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435. \u0412 1666 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u043e\u0441\u0442\u0430\u043d\u043a\u0438 \u0431\u044b\u043b\u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u044b
    \u0432 \u041f\u0430\u0440\u0438\u0436 \u0438 \u0437\u0430\u0445\u043e\u0440\u043e\u043d\u0435\u043d\u044b
    \u0432 \u0430\u0431\u0431\u0430\u0442\u0441\u0442\u0432\u0435 \u0421\u0435\u043d-\u0416\u0435\u0440\u043c\u0435\u043d-\u0434\u0435-\u041f\u0440\u0435,
    \u0433\u0434\u0435 \u043f\u043e\u043a\u043e\u044f\u0442\u0441\u044f \u0438 \u043f\u043e
    \u0441\u0435\u0439 \u0434\u0435\u043d\u044c, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043f\u043b\u0430\u043d\u044b \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u043e\u043d\u0432\u0435\u043d\u0442\u0430 \u0432 1792 \u0433\u043e\u0434\u0443 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438
    \u0438\u0445 \u0432 \u041f\u0430\u043d\u0442\u0435\u043e\u043d. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0433\u043e\u043d\u0435\u043d\u0438\u044f, \u0438\u0434\u0435\u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    (\u043a\u0430\u0440\u0442\u0435\u0437\u0438\u0430\u043d\u0441\u0442\u0432\u043e) \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u0433\u043b\u0443\u0431\u043e\u0447\u0430\u0439\u0448\u0435\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0432\u0441\u044e \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e
    \u0437\u0430\u043f\u0430\u0434\u043d\u0443\u044e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u0438 \u043d\u0430\u0443\u043a\u0443. \u0415\u0433\u043e \u0434\u0443\u0430\u043b\u0438\u0437\u043c
    \u0434\u0443\u0448\u0438 \u0438 \u0442\u0435\u043b\u0430, \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0438 \u0432\u043a\u043b\u0430\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u043c\u044b\u0441\u043b\u0438\u0442\u0435\u043b\u0435\u0439 \u043e\u0442
    \u0421\u043f\u0438\u043d\u043e\u0437\u044b \u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u0434\u043e \u041a\u0430\u043d\u0442\u0430 \u0438 \u0413\u0443\u0441\u0441\u0435\u0440\u043b\u044f."
  shortBioEn: "Renee Descartes (1596–1650) is a French philosopher, mathematician and naturalist who is rightly regarded as one of the founders of the philosophy of the New Age and Scientific Revolution, and his legacy is vast, ranging from the famous \"I Think, therefore I exist\" theory to the creation of analytical geometry and mechanistic physics principles, and the most detailed biography covering all the key stages of his life is presented below.\n\n==Early life====History and early years (1596–1606)===Rene Descartes was born on March 31, 1596 in the small town of La Eh-en-Turen (now Descartes) in central France, an old but impoverished noble race. He was the youngest, third son of the family. — Family: His father, Joaquim Decart, was a judge and counsellor of Parliament in Rennes and rarely came home.The mother, Jeanne Brochard, died when Renee was only a year old, and his grandmother raised the boy on his mother's side.\n\n1606-1618) - La Flesh College (1606-1614): At the age of 10, Descartes entered the prestigious Jesuit College of La Flesh (Anjo), one of the best institutions of education in Europe at the time, where he received a fundamental classical education, studying ancient languages, rhetoric, philosophy, and mathematics and physics, including the works of Galileo.- Impact: Religious education did not convince him, but rather strengthened his scepticism about the holocaustist philosophy based on Aristotle's authority, and he also met Maren Mercenne at the college, who will later become his close friend and chief correspondent in the scientific world.- University of Poitié (1614-1616): Following the father &apos; s desire to become a lawyer, Descartes entered the University of Poitié, where he received a bachelor &apos; s degree in law and a master &apos; s degree in canonical and civil law in 1616.\n\n* \"The Great Book of Peace\" and \"The Military Service\" (1618–1628), disappointed in his holodetic studies, Descartes decided to study the great book of peace through travel and military service.—Dollands and his acquaintance with Beckman (1618): In 1618, he joined the army as a hired officer in the Protestant State-Gather Moritz Nassausky army in the Netherlands.In Breda, he met the outstanding physicist and mathematician Isaac Beckman, who had a huge influence on him and led him to pursue accurate science, and for Beckman he wrote his first remaining work, \"Compendium of Music\".- Germany and \"the vision\" (1619 - 1620): Descartes then joined the Bawar Duke of Maximilian and took part in the initial phase of the Thirty-Year War, including the Battle of the White Mountain (1620).Three dreams: It was during this period, 10 November 1619, during the winter in Noyburg-on-Dunai, Decart, that he said he had experienced three \"sleep\" or \"sleeps\" in which he had discovered a new philosophy and framework of analytical geometry, as well as the idea of a universal mathematical method for all sciences.- Return to France and travels (1620-1628): Descartes left his service in 1621, travelling through Europe (including Italy, where he visited Rome and made a pilgrimage to Loreto) and then spent several years in Paris, where he was active in the scientific community, and in Paris he communicated with Mercenne, but also led secular life, and in 1627 he took part in the siege of La Rochelle, the last castle of the Huguenots.\n\n♪ Years in Holland: The flourishing of Carcatism (1628–1649) is the most fruitful and important period in Decart's life, fearing accusations of heresy and persecution by the Catholic Church, he moved to the Netherlands in 1628, which was famous for its religious tolerance, where he spent 20 years in seclusion, often changing his place of residence and hiding his address to devote himself exclusively to science.- Main works: In the Netherlands, Descartes created all his main works: \"Discussion about the method\" (1637): published in French with three annexes, \"Esse\": \"Dioptrica\", \"Meteors\" and \"Geometrics.\" In this paper, he stated his famous principle: \"Je pense, donc je suis\" (\"I think, therefore I exist\").In this work he develops his metaphysics and provides rational proof of God's existence. \"First philosophy\" (1644, in Latin): The systematic presentation of his physics, cosmology and metaphysics. \"The tragedy of \"Peace\" (1633): In 1633, Decart completed the fundamental work \"Peace, or Tractat on Light\" (Le Monde), in which Copernica supported the heliocentric system.When he learned of Galileo's condemnation by the Inquisition, Descartes, in fear, postponed the publication because his own views ran counter to church dogmas. He wrote to Mersenn: \"If the earth's movement is a lie, then a lie and all the grounds of my philosophy.\" Personal life and tragedy: In 1635, Descartes had a daughter, Francine, born to a maid, Helena Jans van der Strom. Although she was baptized, she was often called \"unlawful\".==Death==Francina died of Scarlatine in 1640, which was the greatest sorrow of Descartes in life.===============================================================================================================================================================================================================================\n\n===Swedish===In 1649, after years of harassment, Descartes accepted the invitation of the Swedish Queen Christina, whom she had long been e-mailing, and moved to Stockholm, whose purpose was to establish the Academy of Sciences and to teach her philosophy.At the beginning of February 1650, he caught a cold on the way to the palace and became ill. Death and mystery: On 11 February 1650, René Decartes died on the ninth day of illness. The official cause of death was pneumonia, but there is an alternative version, a possible arsenic poisoning. It was introduced in the 20th century on the basis of traces of arsenic found in his remains.Proponents of this version believe that Catholic agents feared that Decart's freedom of thought might hinder their plans to turn Queen Christine into Catholicism (which occurred in 1654).\n\nAfter death: In 1663, Descartes' essays were introduced into the Catholic \"Index of Prohibited Books\", and in France, Louis XIV banned teaching his philosophy in all schools.In 1666, his remains were transported to Paris and buried in the Abbey of St. Germain de Pre, where they are still resting today, despite the plans of the National Convention to transfer them to Pantheon in 1792. Despite the persecution, the ideas of Descartes (Cartesianism) have had a profound impact on all subsequent Western philosophy and science.His dualism of the soul and body, rationalistic method, and contribution to mathematics have become the basis for thinkers from Spinoza and Leibnicus to Kant and Guzserl."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0443\u0445\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f.
    \u0417\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0441\u0442\u0430 \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0441\u044f
    \u0447\u0443\u0434\u0430\u043a\u043e\u0432\u0430\u0442\u044b\u0439 \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u043a,
    \u0431\u0435\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u044b\u0439 \u0434\u0443\u044d\u043b\u044f\u043d\u0442
    \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438 \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u043e\u044f\u043b\u0441\u044f \u043b\u0435\u0442\u0430\u0442\u044c
    \u043d\u0430 \u043a\u043e\u0440\u0430\u0431\u043b\u044f\u0445. \u041d\u0438\u0436\u0435
    \u2014 \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u044f \u0441\u0430\u043c\u044b\u0445
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0445, \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0445
    \u0438 \u043c\u0430\u043b\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432
    \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430,
    \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u043d\u0430\u044f \u043f\u043e \u0442\u0435\u043c\u0430\u043c.
    --- 1. \u042d\u043f\u0438\u0441\u0442\u043e\u043b\u044f\u0440\u043d\u044b\u0439 \u043c\u0430\u043d\u044c\u044f\u043a:
    \u041f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 \u043a\u0430\u043a \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0434\u0435\u043b\u043e \u0436\u0438\u0437\u043d\u0438 \u0414\u0435\u043a\u0430\u0440\u0442,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0437\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u043a\u043e\u043c,
    \u0432\u0435\u043b \u043e\u0434\u043d\u0443 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043e\u0431\u0448\u0438\u0440\u043d\u044b\u0445 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043e\u043a
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438 (\u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u043e\u043a\u043e\u043b\u043e 500 \u0435\u0433\u043e \u043f\u0438\u0441\u0435\u043c). \u041d\u043e
    \u0437\u0434\u0435\u0441\u044c \u0435\u0441\u0442\u044c \u043d\u044e\u0430\u043d\u0441\u044b:
    - \u0421\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0435\u0434 \u0431\u0443\u043c\u0430\u0433\u043e\u0439:
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438
    \u0431\u043e\u044f\u043b\u0441\u044f, \u0447\u0442\u043e \u0435\u0433\u043e \u043f\u0438\u0441\u044c\u043c\u0430
    \u043f\u043e\u043f\u0430\u0434\u0443\u0442 \u0432 \u0440\u0443\u043a\u0438 \u0432\u0440\u0430\u0433\u043e\u0432-\u0438\u0435\u0437\u0443\u0438\u0442\u043e\u0432.
    \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0448\u0438\u0444\u0440
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043a\u043e\u0434\u043e\u0432\u044b\u0445
    \u0438\u043c\u0435\u043d \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445 \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u0432.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432 \u043f\u0438\u0441\u044c\u043c\u0430\u0445
    \u043a \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443 \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u043f\u0440\u043e\u0441\u0442\u043e \u00ab\u0421\u0438\u043d\u044c\u043e\u0440\u043e\u043c\u00bb,
    \u0430 \u0441\u0432\u043e\u0438 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438 \u2014
    \u00ab\u043c\u043e\u0438\u043c\u0438 \u0434\u0435\u0442\u044c\u043c\u0438\u00bb. \u041e\u043d
    \u0447\u0430\u0441\u0442\u043e \u043f\u0438\u0441\u0430\u043b \u043d\u0430 \u043f\u043e\u043b\u044f\u0445
    \u0444\u0440\u0430\u0437\u0443 \u00ab\u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0439 \u0438
    \u0441\u043e\u0436\u0433\u0438\u00bb. - \u00ab\u0421\u043f\u043b\u0435\u0442\u043d\u0438\u043a\u00bb:
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0441\u0443\u0445\u0438\u0445
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u043e\u0432,
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u0438\u0441\u044c\u043c\u0430
    \u043f\u043e\u043b\u043d\u044b \u0441\u0430\u0440\u043a\u0430\u0437\u043c\u0430. \u041e\u043d
    \u043c\u043e\u0433 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443:
    \u00ab\u041d\u0430\u0434\u043e\u0435\u043b \u043c\u043d\u0435 \u044d\u0442\u043e\u0442 \u0412\u043e\u044d\u0446\u0438\u0439
    (\u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u0440\u0430\u0433-\u0442\u0435\u043e\u043b\u043e\u0433).
    \u0415\u0441\u043b\u0438 \u0431\u044b \u044f \u0431\u044b\u043b \u043b\u044f\u0433\u0443\u0448\u043a\u043e\u0439,
    \u044f \u0431\u044b \u043f\u0435\u0440\u0435\u043f\u0440\u044b\u0433\u043d\u0443\u043b \u0447\u0435\u0440\u0435\u0437
    \u0435\u0433\u043e \u0433\u043b\u0443\u043f\u0443\u044e \u0433\u043e\u043b\u043e\u0432\u0443\u00bb.
    --- 2. \u0414\u0443\u044d\u043b\u044f\u043d\u0442 \u0438 \u0432\u043e\u043b\u044c\u043d\u043e\u0434\u0443\u043c\u0435\u0446
    \u0432 \u044e\u043d\u043e\u0441\u0442\u0438 \u041c\u0430\u043b\u043e \u043a\u0442\u043e
    \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e \u0431\u0443\u0434\u0443\u0449\u0438\u0439
    \u0430\u0432\u0442\u043e\u0440 \u00ab\u0420\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439
    \u043e \u043f\u0435\u0440\u0432\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb
    \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438 \u0431\u044b\u043b \u043e\u0442\u0447\u0430\u044f\u043d\u043d\u044b\u043c
    \u0437\u0430\u0431\u0438\u044f\u043a\u043e\u0439. - \u041e\u0441\u043a\u043e\u0440\u0431\u043b\u0435\u043d\u0438\u0435
    \u0447\u0435\u0441\u0442\u0438: \u0412 1620-\u0445 \u0433\u043e\u0434\u0430\u0445, \u0436\u0438\u0432\u044f
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435, \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u043e\u0441\u0441\u043e\u0440\u0438\u043b\u0441\u044f
    \u0441 \u043d\u0435\u043a\u0438\u043c \u0448\u0435\u0432\u0430\u043b\u044c\u0435 \u0434\u0435
    \u0411\u0430\u0440\u0440\u043e\u043c \u0438\u0437-\u0437\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043d\u043e\u0433\u043e
    \u0434\u043e\u043b\u0433\u0430 \u0438\u043b\u0438 (\u043f\u043e \u0434\u0440\u0443\u0433\u043e\u0439
    \u0432\u0435\u0440\u0441\u0438\u0438) \u0438\u0437-\u0437\u0430 \u043d\u0430\u0441\u043c\u0435\u0448\u0435\u043a
    \u043d\u0430\u0434 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438 \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c\u0438.
    \u041f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0431\u044b\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e
    \u0440\u043e\u0441\u0442\u0430 \u0438 \u0433\u0440\u043e\u0437\u0438\u043b \u043f\u043e\u0431\u0438\u0442\u044c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430. - \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u043a\u043b\u0438\u043d\u043a\u0430: \u0414\u0435\u043a\u0430\u0440\u0442, \u043d\u0435
    \u043e\u0442\u043b\u0438\u0447\u0430\u0432\u0448\u0438\u0439\u0441\u044f \u0431\u043e\u0433\u0430\u0442\u044b\u0440\u0441\u043a\u0438\u043c
    \u0442\u0435\u043b\u043e\u0441\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c, \u0441\u043a\u0430\u0437\u0430\u043b
    \u0434\u0435 \u0411\u0430\u0440\u0440\u0443: \u00ab\u042f \u043d\u0435 \u0441\u0442\u0430\u043d\u0443
    \u0434\u0440\u0430\u0442\u044c\u0441\u044f \u0441 \u0432\u0430\u043c\u0438 \u0442\u0430\u043c,
    \u0433\u0434\u0435 \u0432\u0430\u043c \u0443\u0434\u043e\u0431\u043d\u043e. \u0418\u0434\u0435\u043c\u0442\u0435
    \u043d\u0430 \u0442\u043e\u0442 \u043f\u0443\u0441\u0442\u044b\u0440\u044c, \u0433\u0434\u0435
    \u044f \u0441\u043c\u043e\u0433\u0443 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432\u044b\u043f\u0430\u0434
    \u0438 \u0437\u0430\u043a\u043e\u043b\u043e\u0442\u044c \u0432\u0430\u0441, \u0430 \u0432\u044b
    \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043c\u0435\u043d\u044f \u0434\u043e\u0441\u0442\u0430\u0442\u044c
    \u0441\u0432\u043e\u0435\u0439 \u0434\u043b\u0438\u043d\u043d\u043e\u0439 \u0448\u043f\u0430\u0433\u043e\u0439\u00bb.
    \u041f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0441\u0442\u0440\u0443\u0441\u0438\u043b
    \u0438 \u0438\u0437\u0432\u0438\u043d\u0438\u043b\u0441\u044f. \u042d\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e\u0431\u043b\u0435\u0442\u0435\u043b\u0430 \u0432\u0435\u0441\u044c \u041f\u0430\u0440\u0438\u0436,
    \u0443\u043a\u0440\u0435\u043f\u0438\u0432 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442
    \u0434\u0430\u0436\u0435 \u0434\u0443\u044d\u043b\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438.
    --- 3. \u0424\u043e\u0431\u0438\u044f \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u0442\u0435\u043b\u044f
    \u0423\u0447\u0438\u0442\u044b\u0432\u0430\u044f, \u0447\u0442\u043e \u0414\u0435\u043a\u0430\u0440\u0442
    \u0431\u044b\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0446\u0438\u0441\u0442\u043e\u043c
    \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b \u0432\u0441\u0435 \u0444\u0438\u0437\u0438\u043a\u043e\u0439,
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f \u0444\u043e\u0431\u0438\u044f \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442
    \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u043e. - \u041d\u0438\u043a\u0430\u043a\u0438\u0445
    \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439: \u0414\u0435\u043a\u0430\u0440\u0442 \u043d\u0430
    \u0434\u0443\u0445 \u043d\u0435 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043b \u043c\u043e\u0440\u0441\u043a\u0438\u0435
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f. \u041f\u0435\u0440\u0435\u043f\u0440\u0430\u0432\u043b\u044f\u044f\u0441\u044c
    \u0438\u0437 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u0438 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e,
    \u043e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b \u0434\u0435\u043b\u0430\u0442\u044c
    \u043a\u0440\u044e\u043a \u0438 \u0435\u0445\u0430\u0442\u044c \u0441\u0443\u0445\u0438\u043c
    \u043f\u0443\u0442\u0435\u043c \u0447\u0435\u0440\u0435\u0437 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e,
    \u0445\u043e\u0442\u044f \u044d\u0442\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u043e
    \u0432 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0435
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. - \u041f\u0440\u0438\u0447\u0438\u043d\u0430
    \u0441\u0442\u0440\u0430\u0445\u0430: \u041e\u043d \u0431\u043e\u044f\u043b\u0441\u044f
    \u043d\u0435 \u0448\u0442\u043e\u0440\u043c\u0430, \u0430 \u043c\u043e\u0440\u0441\u043a\u043e\u0439
    \u0431\u043e\u043b\u0435\u0437\u043d\u0438. \u0412 \u043f\u0438\u0441\u044c\u043c\u0435
    \u0434\u0440\u0443\u0433\u0443 \u043e\u043d \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e
    \u043c\u043e\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u0447\u043a\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442
    \u0435\u0433\u043e \u0442\u0435\u043b\u043e \u0441\u043e\u0434\u0440\u043e\u0433\u0430\u0442\u044c\u0441\u044f
    \u0442\u0430\u043a, \u0447\u0442\u043e \u00ab\u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435
    \u0434\u0443\u0445\u0438\u00bb (\u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f
    \u043d\u0435\u0440\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b) \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442
    \u0432 \u0445\u0430\u043e\u0441, \u0438 \u043e\u043d \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0441\u0432\u044f\u0437\u043d\u043e \u043c\u044b\u0441\u043b\u0438\u0442\u044c. \u0414\u043b\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0447\u044c\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u0441\u0442\u0440\u043e\u0438\u043b\u0430\u0441\u044c \u043d\u0430 \u00ab\u044f\u0441\u043d\u043e\u043c
    \u0438 \u043e\u0442\u0447\u0435\u0442\u043b\u0438\u0432\u043e\u043c \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0438\u00bb,
    \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0440\u0430\u0432\u043d\u043e\u0441\u0438\u043b\u044c\u043d\u043e
    \u0431\u0435\u0437\u0443\u043c\u0438\u044e. --- 4. \u0413\u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u043a\u0430 \u0414\u0435\u043a\u0430\u0440\u0442
    \u0431\u044b\u043b \u0433\u0443\u0440\u043c\u0430\u043d\u043e\u043c, \u043d\u043e \u043f\u0440\u0438
    \u044d\u0442\u043e\u043c \u0432\u0435\u0440\u0438\u043b, \u0447\u0442\u043e \u0435\u0434\u0430
    \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442.
    \u041e\u043d \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0434\u043b\u044f \u0441\u0435\u0431\u044f
    \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u0434\u0438\u0435\u0442\u0443, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0438\u043d\u043e\u0433\u0434\u0430 \u043d\u0430\u0440\u0443\u0448\u0430\u043b \u0441\u0430\u043c\u044b\u043c
    \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c.
    - \u0421\u043b\u0430\u0434\u043a\u043e\u0435 \u0434\u043b\u044f \u0443\u043c\u0430: \u041e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435
    \u0432\u0430\u0440\u0435\u043d\u044b\u0445 \u044f\u0438\u0446, \u0432\u0435\u0442\u0447\u0438\u043d\u044b
    \u0438 \u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0441\u043b\u0430\u0434\u043a\u043e\u0433\u043e \u0432\u0438\u043d\u0430 (\u043c\u0443\u0441\u043a\u0430\u0442\u0430)
    \u0443\u043b\u0443\u0447\u0448\u0430\u0435\u0442 \u043a\u0440\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u0443\u0435\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0434\u0435\u0439. \u0412
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u00ab\u041e \u0441\u0442\u0440\u0430\u0441\u0442\u044f\u0445\u00bb
    \u043e\u043d \u0434\u0430\u0436\u0435 \u043d\u0430\u043c\u0435\u043a\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043c\u043e\u0437\u0433 \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0441\u044b\u0442\u043d\u043e\u0433\u043e
    \u043e\u0431\u0435\u0434\u0430. - \u041a\u0443\u0440\u0438\u0446\u0430 \u0432 \u043c\u043e\u043b\u043e\u043a\u0435:
    \u0415\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u044b\u043c \u0431\u043b\u044e\u0434\u043e\u043c
    \u0431\u044b\u043b \u0431\u0443\u043b\u044c\u043e\u043d \u0438\u0437 \u0441\u0442\u0430\u0440\u043e\u0439
    \u043a\u0443\u0440\u0438\u0446\u044b, \u0441\u0432\u0430\u0440\u0435\u043d\u043d\u043e\u0439
    \u0432 \u043c\u043e\u043b\u043e\u043a\u0435 \u0441 \u043f\u0440\u044f\u043d\u043e\u0441\u0442\u044f\u043c\u0438.
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u044d\u0442\u043e
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u00ab\u0443\u0432\u043b\u0430\u0436\u043d\u044f\u0435\u0442\u00bb
    \u043c\u043e\u0437\u0433, \u043f\u043e\u043c\u043e\u0433\u0430\u044f \u043f\u0440\u0438
    \u0435\u0433\u043e \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u0443\u0445\u043e\u043c
    \u043a\u0430\u0448\u043b\u0435. - \u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u043c\u044f\u0441\u0430
    \u0432 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438: \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u0441\u0442\u0430\u043b
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0446\u0435\u043c,
    \u043f\u0438\u0442\u0430\u044f\u0441\u044c \u043b\u0438\u0448\u044c \u0440\u044b\u0431\u043e\u0439,
    \u043e\u0432\u043e\u0449\u0430\u043c\u0438 \u0438 \u0445\u043b\u0435\u0431\u043e\u043c,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043c\u044f\u0441\u043e, \u043f\u043e \u0435\u0433\u043e
    \u043c\u043d\u0435\u043d\u0438\u044e, \u00ab\u0434\u0435\u043b\u0430\u043b\u043e \u043a\u0440\u043e\u0432\u044c
    \u0433\u0443\u0441\u0442\u043e\u0439 \u0438 \u043c\u0435\u0448\u0430\u043b\u043e \u0434\u0443\u043c\u0430\u0442\u044c
    \u043e \u0411\u043e\u0433\u0435\u00bb. --- 5. \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u0441 \u044d\u043c\u0431\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0435\u0439: \u0421\u043f\u043e\u0440
    \u043e \u0449\u0435\u043d\u043a\u0430\u0445 \u0412 XVII \u0432\u0435\u043a\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0435\u0444\u043e\u0440\u043c\u0438\u0437\u043c\u0430
    \u2014 \u0441\u0447\u0438\u0442\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u0432\u0441\u0435
    \u0436\u0438\u0432\u044b\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0443\u0436\u0435
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u044b
    \u0432 \u043c\u0438\u043d\u0438\u0430\u0442\u044e\u0440\u0435 \u0432 \u0441\u043f\u0435\u0440\u043c\u0435
    \u0438\u043b\u0438 \u044f\u0439\u0446\u0435\u043a\u043b\u0435\u0442\u043a\u0435. - \u0412\u0441\u043a\u0440\u044b\u0442\u0438\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430: \u0427\u0442\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u0436\u0438\u0437\u043d\u044c \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442
    \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e (\u044d\u043f\u0438\u0433\u0435\u043d\u0435\u0437),
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0432 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438
    \u0432\u0440\u0430\u0447\u0435\u0439 \u0441\u0434\u0435\u043b\u0430\u043b \u0432\u0441\u043a\u0440\u044b\u0442\u0438\u0435
    \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0441\u043e\u0431\u0430\u043a\u0438.
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432 \u0443\u0442\u0440\u043e\u0431\u0435
    \u044d\u043c\u0431\u0440\u0438\u043e\u043d \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442
    \u043d\u0435 \u043a\u0430\u043a \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0430\u044f \u0441\u043e\u0431\u0430\u043a\u0430,
    \u0430 \u043a\u0430\u043a \u0431\u0435\u0441\u0444\u043e\u0440\u043c\u0435\u043d\u043d\u044b\u0439
    \u0441\u0433\u0443\u0441\u0442\u043e\u043a. - \u0428\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0439
    \u0432\u044b\u0432\u043e\u0434: \u041f\u043e\u0441\u043b\u0435 \u043e\u043f\u044b\u0442\u0430
    \u043e\u043d \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u043e
    \u0432\u044b\u043c\u044b\u043b \u0440\u0443\u043a\u0438 \u0438 \u0437\u0430\u044f\u0432\u0438\u043b,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u044d\u0442\u0438 \"\u0447\u0443\u0434\u0435\u0441\u0430\"
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u2014 \u043f\u0440\u043e\u0441\u0442\u043e\u0435
    \u043d\u0430\u0433\u0440\u0435\u0432\u0430\u043d\u0438\u0435 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439.
    \u0421\u043b\u0443\u0445\u0438 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444
    \u0432\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0436\u0438\u0432\u044b\u0445 (\u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0442\u043e \u0443\u043c\u0435\u0440\u0448\u0438\u0445) \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445
    \u0440\u0430\u0434\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0441\u0432\u043e\u0435\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438, \u0432\u044b\u0437\u0432\u0430\u043b\u0438
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b, \u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0443
    \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c\u0441\u044f
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u0435\u043b\u044c.
    --- 6. \u0410\u0442\u0435\u0438\u0441\u0442 \u0438\u043b\u0438 \u0445\u0438\u0442\u0440\u044b\u0439
    \u043a\u0430\u0442\u043e\u043b\u0438\u043a? \u041f\u043e\u043b\u0435\u043c\u0438\u043a\u0430
    \u0441 \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c \u0414\u0435\u043a\u0430\u0440\u0442
    \u0438 \u0411\u043b\u0435\u0437 \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0438\u0441\u044c
    \u0432 1647 \u0433\u043e\u0434\u0443. \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0431\u0438\u0442\u0432\u0430
    \u0434\u0432\u0443\u0445 \u0433\u0435\u043d\u0438\u0435\u0432. - \u042f\u0431\u043b\u043e\u043a\u043e
    \u0440\u0430\u0437\u0434\u043e\u0440\u0430: \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0439 \u043e\u043f\u044b\u0442
    (\u00ab\u043e\u0433\u043e\u043d\u044c\u00bb \u0432\u0435\u0440\u044b) \u0434\u043e\u043b\u0436\u0435\u043d
    \u0431\u044b\u0442\u044c \u0432\u044b\u0448\u0435 \u0440\u0430\u0437\u0443\u043c\u0430.
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0445\u043e\u043b\u043e\u0434\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b:
    \u00ab\u0413\u043e\u0441\u043f\u043e\u0434\u0438\u043d \u041f\u0430\u0441\u043a\u0430\u043b\u044c,
    \u044f \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u044e
    \u043e \u0442\u043e\u043c, \u0447\u0435\u0433\u043e \u043d\u0435 \u043c\u043e\u0433\u0443
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u00bb.
    - \u0424\u0430\u043a\u0442 \u043e \"\u0444\u0438\u043a\u0442\u0438\u0432\u043d\u043e\u043c
    \u0411\u043e\u0433\u0435\": \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0432\u043e\u0437\u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b \u0435\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u044b.
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0442\u043e\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442
    \u0411\u043e\u0433\u0430 \u043b\u0438\u0448\u044c \u043a\u0430\u043a \u00ab\u0443\u0441\u043b\u043e\u0432\u043d\u0443\u044e
    \u0437\u0430\u0433\u043b\u0443\u0448\u043a\u0443\u00bb (\u0447\u0442\u043e\u0431\u044b \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c
    \u043d\u0430\u0447\u0430\u043b\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439,
    \u0430 \u043f\u043e\u0442\u043e\u043c \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0442 \u043e
    \u041d\u0435\u043c). \u0414\u0435\u043a\u0430\u0440\u0442 \u0432 \u043e\u0442\u0432\u0435\u0442
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d
    \u0438 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0441\u0432\u043e\u0438 \u043d\u0435\u0440\u0432\u043d\u044b\u0435
    \u0441\u0440\u044b\u0432\u044b \u0437\u0430 \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u044f
    \u0441\u0432\u044b\u0448\u0435. \u042d\u0442\u043e \u0431\u044b\u043b \u0445\u043e\u043b\u043e\u0434\u043d\u044b\u0439
    \u0438 \u0432\u0435\u0436\u043b\u0438\u0432\u044b\u0439 \u0440\u0430\u0437\u0440\u044b\u0432,
    \u043f\u043e\u0441\u043b\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d\u0438
    \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0438\u0441\u044c. --- 7. \u0414\u0435\u043a\u0430\u0440\u0442
    \u0438 \u0435\u0433\u043e \u00ab\u0410\u0434\u0430\u043c\u00bb \u2014 \u043e\u0448\u0438\u0431\u043a\u0430
    \u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0438 \u0414\u0435\u043a\u0430\u0440\u0442 \u043e\u0447\u0435\u043d\u044c
    \u0433\u043e\u0440\u0434\u0438\u043b\u0441\u044f \u0441\u0432\u043e\u0438\u043c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c
    \u0448\u0438\u0448\u043a\u043e\u0432\u0438\u0434\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b
    (\u044d\u043f\u0438\u0444\u0438\u0437\u0430) \u043a\u0430\u043a \u043c\u0435\u0441\u0442\u0430
    \u043e\u0431\u0438\u0442\u0430\u043d\u0438\u044f \u0434\u0443\u0448\u0438. \u041e\u043d
    \u0434\u0430\u0436\u0435 \u0432\u0441\u043a\u0440\u044b\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0431\u0430\u0440\u0430\u043d\u044c\u0438\u0445 \u0433\u043e\u043b\u043e\u0432, \u0447\u0442\u043e\u0431\u044b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u044d\u0442\u043e. - \u0424\u0430\u043a\u0442
    \u043e\u0448\u0438\u0431\u043a\u0438: \u0414\u0435\u043a\u0430\u0440\u0442 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u044d\u043f\u0438\u0444\u0438\u0437 \u043f\u0430\u0440\u0438\u0442 \u0432
    \u0446\u0435\u043d\u0442\u0440\u0435 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432
    \u043c\u043e\u0437\u0433\u0430, \u043a\u0430\u043a \u00ab\u0441\u043e\u043b\u043d\u0446\u0435
    \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u043c\u0438\u0440\u0430\u00bb. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043e\u043d \u043d\u0435 \u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u044d\u0442\u0430 \u0436\u0435\u043b\u0435\u0437\u0430 \u043f\u0440\u043e\u0447\u043d\u043e
    \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0430 \u043a \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044e
    \u043c\u043e\u0437\u0433\u0430. \u041a\u043e\u0433\u0434\u0430 \u0430\u043d\u0430\u0442\u043e\u043c\u044b
    \u0443\u043a\u0430\u0437\u0430\u043b\u0438 \u0435\u043c\u0443 \u043d\u0430 \u044d\u0442\u043e,
    \u0414\u0435\u043a\u0430\u0440\u0442 \u043e\u0442\u043c\u0430\u0445\u043d\u0443\u043b\u0441\u044f,
    \u0441\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0443 \u043b\u044e\u0434\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d \u0432\u0441\u043a\u0440\u044b\u0432\u0430\u043b
    (\u043f\u043e-\u0432\u0438\u0434\u0438\u043c\u043e\u043c\u0443, \u0443 \u043a\u0430\u0437\u043d\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u043e\u0432), \u0436\u0435\u043b\u0435\u0437\u0430
    \"\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0435\u0435 \u0438\u0437-\u0437\u0430 \u0431\u0443\u0440\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438\". - \u0421\u043c\u0435\u0448\u043d\u043e\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0435:
    \u041e\u043d \u0432\u0435\u0440\u0438\u043b, \u0447\u0442\u043e \u0434\u0443\u0448\u0430
    \u0441\u0438\u0434\u0438\u0442 \u0432 \u0436\u0435\u043b\u0435\u0437\u0435, \u043d\u043e
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b,
    \u0447\u0442\u043e \u0434\u0443\u0448\u0430 \u00ab\u043d\u0435\u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u00bb.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438,
    \u043a\u0430\u043a \u043d\u0435\u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u043c\u043e\u0436\u0435\u0442 \u0434\u0430\u0432\u0438\u0442\u044c \u043d\u0430 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0442\u0435\u043b\u043e \u0432 \u0436\u0435\u043b\u0435\u0437\u0435, \u0414\u0435\u043a\u0430\u0440\u0442
    \u0447\u0435\u0441\u0442\u043d\u043e \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u042f
    \u043d\u0435 \u043e\u0431\u044f\u0437\u0430\u043d \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0442\u044c
    \u0447\u0443\u0434\u043e, \u044d\u0442\u043e \u0442\u0430\u0439\u043d\u0430 \u0442\u0432\u043e\u0440\u0435\u043d\u0438\u044f\u00bb.
    --- 8. \u041f\u043e\u0447\u0435\u043c\u0443 \u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \"\u041e\u043f\u0430\u0441\u043d\u043e\u0439\"?
    \u0412 1663 \u0433\u043e\u0434\u0443 (\u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438) \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0438
    \u043f\u043e\u043f\u0430\u043b\u0438 \u0432 \u0418\u043d\u0434\u0435\u043a\u0441 \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043d\u044b\u0445
    \u043a\u043d\u0438\u0433. \u041d\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0435\u043d
    \u0441\u0430\u043c \u0444\u0430\u043a\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b \u043f\u0440\u0438 \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u0438 \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u0438:
    - \u0421\u0443\u0434 \u043d\u0430\u0434 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c:
    \u041e\u0434\u0438\u043d \u0441\u0442\u0443\u0434\u0435\u043d\u0442 \u0423\u0442\u0440\u0435\u0445\u0442\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e
    \u0437\u0430\u0449\u0438\u0449\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435
    \u2014 \u044d\u0442\u043e \u043c\u0430\u0448\u0438\u043d\u044b \u0438 \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e\u0442
    \u0431\u043e\u043b\u0438. \u041d\u0435\u0434\u0440\u0443\u0433\u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430
    \u0434\u043e\u043d\u0435\u0441\u043b\u0438 \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0438,
    \u0447\u0442\u043e \u0414\u0435\u043a\u0430\u0440\u0442 \u0443\u0447\u0438\u0442, \u0431\u0443\u0434\u0442\u043e
    \u043b\u044e\u0434\u0438 \u2014 \u0442\u043e\u0436\u0435 \u043c\u0430\u0448\u0438\u043d\u044b
    (\u0445\u043e\u0442\u044f \u043e\u043d \u0447\u0435\u0442\u043a\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u043b
    \u0434\u0443\u0448\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430). - \u0426\u0435\u0440\u043a\u043e\u0432\u043d\u044b\u0439
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441: \u0414\u0435\u043a\u0430\u0440\u0442 \u043d\u0435
    \u044f\u0432\u0438\u043b\u0441\u044f \u043d\u0430 \u0441\u0443\u0434, \u043d\u043e \u043f\u0440\u0438\u0441\u043b\u0430\u043b
    \u043f\u0438\u0441\u044c\u043c\u043e, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0438\u0437\u0434\u0435\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u0438\u043a\u0430\u043c: \u00ab\u0414\u043e\u043a\u0430\u0436\u0438\u0442\u0435,
    \u0447\u0442\u043e \u0443 \u0441\u043e\u0431\u0430\u043a\u0438 \u0435\u0441\u0442\u044c
    \u0431\u0435\u0441\u0441\u043c\u0435\u0440\u0442\u043d\u0430\u044f \u0434\u0443\u0448\u0430,
    \u0438 \u044f \u043f\u0440\u0438\u0437\u043d\u0430\u044e \u043e\u0448\u0438\u0431\u043a\u0443.
    \u0415\u0441\u043b\u0438 \u0432\u044b \u043d\u0435 \u043c\u043e\u0436\u0435\u0442\u0435,
    \u0442\u043e \u0434\u0430\u0439\u0442\u0435 \u043c\u043d\u0435 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0444\u0438\u0437\u0438\u043a\u0443\u00bb. \u042d\u0442\u043e
    \u0434\u0435\u0440\u0437\u043a\u043e\u0435 \u043f\u0438\u0441\u044c\u043c\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u0438
    \u043d\u0430 \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u0438, \u0438 \u043f\u0430\u0441\u0442\u043e\u0440\u044b
    \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u044b \u0431\u044b\u043b\u0438 \u043e\u0442\u0441\u0442\u0443\u043f\u0438\u0442\u044c,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043d\u0435 \u043c\u043e\u0433\u043b\u0438 \u043d\u0430\u0439\u0442\u0438
    \u0446\u0438\u0442\u0430\u0442 \u0438\u0437 \u0411\u0438\u0431\u043b\u0438\u0438 \u043e
    \u0434\u0443\u0448\u0430\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445. --- 9.
    \u0422\u0440\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445 \u0441\u043d\u0430:
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043f\u0440\u0438\u0448\u043b\u0430
    \u0432\u043e \u0441\u043d\u0435 \u0421\u0430\u043c\u044b\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0444\u0430\u043a\u0442 \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u2014 \u044d\u0442\u043e \u043d\u043e\u0447\u044c \u043d\u0430 10 \u043d\u043e\u044f\u0431\u0440\u044f
    1619 \u0433\u043e\u0434\u0430 \u0432 \u041d\u043e\u0439\u0431\u0443\u0440\u0433\u0435. -
    \u0421\u043e\u043d \u21161: \u0415\u043c\u0443 \u043f\u0440\u0438\u0441\u043d\u0438\u043b\u0441\u044f
    \u0432\u0438\u0445\u0440\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u043d\u0430\u043b
    \u0435\u0433\u043e \u043a \u0446\u0435\u0440\u043a\u0432\u0438. - \u0421\u043e\u043d \u21162:
    \u0415\u043c\u0443 \u043f\u0440\u0438\u0441\u043d\u0438\u043b\u0441\u044f \u0443\u0434\u0430\u0440
    \u0433\u0440\u043e\u043c\u0430 \u0438 \u0441\u0432\u0435\u0440\u043a\u0430\u044e\u0449\u0430\u044f
    \u043c\u043e\u043b\u043d\u0438\u044f. - \u0421\u043e\u043d \u21163: \u0415\u043c\u0443 \u043f\u0440\u0438\u0441\u043d\u0438\u043b\u0430\u0441\u044c
    \u043a\u043d\u0438\u0433\u0430 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0438,
    \u043e\u0442\u043a\u0440\u044b\u0442\u0430\u044f \u043d\u0430 \u0441\u0442\u0438\u0445\u0435
    \u00abQuod vitae sectabor iter?\u00bb (\u00ab\u041a\u0430\u043a\u043e\u0439 \u043f\u0443\u0442\u044c
    \u0436\u0438\u0437\u043d\u0438 \u043c\u043d\u0435 \u0438\u0437\u0431\u0440\u0430\u0442\u044c?\u00bb),
    \u0438 \u0440\u044f\u0434\u043e\u043c \u0441\u0442\u043e\u044f\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u0434\u0430\u0432\u0448\u0438\u0439 \u0435\u043c\u0443 \u043a\u043d\u0438\u0433\u0443 \u043f\u043e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041f\u0440\u043e\u0441\u043d\u0443\u0432\u0448\u0438\u0441\u044c,
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0443\u043f\u0430\u043b \u043d\u0430 \u043a\u043e\u043b\u0435\u043d\u0438
    \u0438, \u043f\u043e \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c, \u00ab\u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441\u0435\u0431\u044f \u043e\u0445\u0432\u0430\u0447\u0435\u043d\u043d\u044b\u043c \u043e\u0433\u043d\u0435\u043c
    \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0437\u043c\u0430\u00bb. \u041e\u043d \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u043d\u0430\u0443\u043a\u0438 \u043c\u043e\u0436\u043d\u043e
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u043e\u0431\u0449\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0435\u0442\u043e\u0434\u043e\u0439.
    \u041e\u043d \u043f\u043e\u043a\u043b\u044f\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u043d\u043e\u0432\u0443\u044e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e \u0438
    \u0434\u0430\u0436\u0435 \u0441\u0445\u043e\u0434\u0438\u043b \u0432 \u0446\u0435\u0440\u043a\u043e\u0432\u044c
    \u0411\u043e\u0433\u043e\u043c\u0430\u0442\u0435\u0440\u0438 \u0432 \u041b\u043e\u0440\u0435\u0442\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0434\u0430\u0442\u044c \u043e\u0431\u0435\u0442 (\u043e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b \u044d\u0442\u0438 \u0441\u043d\u044b \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0437\u043d\u0430\u043a\u043e\u043c). --- 10. \u041a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0439
    \u043a\u0443\u0440\u044c\u0435\u0437: \u041a\u0430\u043a \u0414\u0435\u043a\u0430\u0440\u0442
    \"\u0443\u0431\u0438\u043b\" \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0432\u0430\u0440\u0430 \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u0438\u0437\u0438\u0442\u0430
    \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c \u0414\u0435\u043a\u0430\u0440\u0442
    \u043f\u0438\u0442\u0430\u043b\u0441\u044f \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u0442\u0435\u043c, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u043e\u0437\u0438\u043b
    \u0441 \u0441\u043e\u0431\u043e\u0439 \u0438\u0437 \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    (\u0432\u0438\u043d\u0430 \u0438 \u0441\u044b\u0440\u044b), \u0442\u0430\u043a \u043a\u0430\u043a
    \u0448\u0432\u0435\u0434\u0441\u043a\u0443\u044e \u043a\u0443\u0445\u043d\u044e \u0441\u0447\u0438\u0442\u0430\u043b
    \u0432\u0430\u0440\u0432\u0430\u0440\u0441\u043a\u043e\u0439. - \u0418\u043d\u0446\u0438\u0434\u0435\u043d\u0442:
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0430
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430 \u0437\u0430\u0445\u043e\u0442\u0435\u043b\u0430
    \u0443\u0433\u043e\u0441\u0442\u0438\u0442\u044c \u0435\u0433\u043e \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u043c
    \u0448\u0432\u0435\u0434\u0441\u043a\u0438\u043c \u0431\u043b\u044e\u0434\u043e\u043c \u0438\u0437
    \u043a\u0432\u0430\u0448\u0435\u043d\u043e\u0439 \u0441\u0435\u043b\u044c\u0434\u0438. \u0414\u0435\u043a\u0430\u0440\u0442
    \u0431\u0440\u0435\u0437\u0433\u043b\u0438\u0432\u043e \u043e\u0442\u043e\u0434\u0432\u0438\u043d\u0443\u043b
    \u0442\u0430\u0440\u0435\u043b\u043a\u0443 \u0438 \u0433\u0440\u043e\u043c\u043a\u043e (\u043d\u0430
    \u0432\u0435\u0441\u044c \u0441\u0442\u043e\u043b) \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441,
    \u0447\u0442\u043e \u044d\u0442\u0430 \u0435\u0434\u0430 \"\u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442
    \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0432,
    \u043d\u043e \u043d\u0435 \u0434\u043b\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u0438\u0449\u0443\u0449\u0435\u0433\u043e \u0438\u0441\u0442\u0438\u043d\u0443\". - \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f:
    \u041e\u0441\u043a\u043e\u0440\u0431\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0439
    \u043f\u043e\u0432\u0430\u0440 \u043f\u043e\u0434\u0430\u043b \u0432 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0443.
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430, \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0431\u044b\u043b\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u044e\u043c\u043e\u0440\u0430,
    \u0432\u044b\u0437\u0432\u0430\u043b\u0430 \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u0438
    \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0435\u0433\u043e \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e
    \u0438\u0437\u0432\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u043f\u0435\u0440\u0435\u0434
    \u043f\u043e\u0432\u0430\u0440\u043e\u043c, \u0438\u043d\u0430\u0447\u0435 \u043e\u043d
    \u043b\u0438\u0448\u0438\u043b\u0441\u044f \u0431\u044b \u043f\u0435\u043d\u0441\u0438\u0438.
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0438\u0437\u0432\u0438\u043d\u0438\u043b\u0441\u044f,
    \u043d\u043e \u0432 \u0442\u043e\u0442 \u0436\u0435 \u0434\u0435\u043d\u044c \u0432 \u043f\u0438\u0441\u044c\u043c\u0435
    \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443 \u043d\u0430\u043f\u0438\u0441\u0430\u043b:
    \"\u0421\u044a\u0435\u0441\u0442\u044c \u044d\u0442\u0443 \u0442\u0443\u0445\u043b\u0443\u044e
    \u0440\u044b\u0431\u0443 \u2014 \u0437\u043d\u0430\u0447\u0438\u0442 \u043e\u0442\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f
    \u043e\u0442 \u0440\u0430\u0437\u0443\u043c\u0430, \u044f \u043b\u0443\u0447\u0448\u0435
    \u0443\u043c\u0440\u0443\". \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b:
    \u043e\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0443\u043c\u0435\u0440 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u043d\u043e \u043d\u0435 \u043e\u0442 \u0440\u044b\u0431\u044b,
    \u0430 \u043e\u0442 \u0445\u043e\u043b\u043e\u0434\u0430. --- 11. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0441\u043b\u043e\u0432\u0430 \u0438 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0415\u0441\u0442\u044c
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043e\u0441\u043f\u0430\u0440\u0438\u0432\u0430\u044e\u0442, \u043d\u043e \u043e\u043d\u0430
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043a\u0440\u0430\u0441\u0438\u0432\u0430, \u0447\u0442\u043e\u0431\u044b
    \u0435\u0435 \u043d\u0435 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438. - \u0420\u0430\u0437\u0433\u043e\u0432\u043e\u0440
    \u0441 \u043c\u043e\u043d\u0430\u0445\u043e\u043c: \u0423\u0442\u0440\u043e\u043c \u043f\u0435\u0440\u0435\u0434
    \u0441\u043c\u0435\u0440\u0442\u044c\u044e, \u043a\u043e\u0433\u0434\u0430 \u0414\u0435\u043a\u0430\u0440\u0442
    \u0443\u0436\u0435 \u0431\u0440\u0435\u0434\u0438\u043b \u043e\u0442 \u0436\u0430\u0440\u0430,
    \u043a \u043d\u0435\u043c\u0443 \u043f\u0440\u0438\u0448\u0435\u043b \u043c\u043e\u043d\u0430\u0445-\u0438\u0435\u0437\u0443\u0438\u0442
    (\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b
    \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c) \u0434\u043b\u044f \u0438\u0441\u043f\u043e\u0432\u0435\u0434\u0438.
    \u041c\u043e\u043d\u0430\u0445 \u0441\u043f\u0440\u043e\u0441\u0438\u043b: \u00ab\u0412\u0435\u0440\u0438\u0442\u0435
    \u043b\u0438 \u0432\u044b \u0432 \u0421\u0432\u044f\u0442\u0443\u044e \u0422\u0440\u043e\u0438\u0446\u0443?\u00bb.
    \u0414\u0435\u043a\u0430\u0440\u0442, \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u043e\u0442\u043a\u0440\u044b\u043b \u0433\u043b\u0430\u0437\u0430 \u0438 \u0441 \u0443\u043b\u044b\u0431\u043a\u043e\u0439
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u042f \u0432\u0435\u0440\u044e \u0432
    \u0411\u043e\u0433\u0430, \u043d\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0422\u0440\u043e\u0438\u0446\u044b... \u044d\u0442\u043e \u0437\u0430\u0434\u0430\u0447\u0430
    \u0434\u043b\u044f \u0430\u043d\u0433\u0435\u043b\u043e\u0432, \u0430 \u043d\u0435 \u0434\u043b\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0430\u00bb. - \u041f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e:
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0430 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430,
    \u0443\u0437\u043d\u0430\u0432 \u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430,
    \u0437\u0430\u043f\u043b\u0430\u043a\u0430\u043b\u0430 \u0438 \u0441\u043a\u0430\u0437\u0430\u043b\u0430
    \u0444\u0440\u0430\u0437\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430
    \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u043a\u043e\u0439: \u00ab\u041e\u043d \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0434\u043e\u043b\u0433\u043e \u0441\u043f\u0430\u043b, \u0447\u0442\u043e\u0431\u044b
    \u0443\u043c\u0435\u0440\u0435\u0442\u044c \u0431\u043e\u0434\u0440\u0441\u0442\u0432\u0443\u044f.
    \u041d\u043e \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u0435\u0449\u0435 \u0441\u043e\u0442\u0440\u044f\u0441\u0443\u0442
    \u0415\u0432\u0440\u043e\u043f\u0443\u00bb. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043f\u0440\u0430\u0432\u0430 \u2014 \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437
    20 \u043b\u0435\u0442 \u0438\u0434\u0435\u0438 \u043a\u0430\u0440\u0442\u0435\u0437\u0438\u0430\u043d\u0441\u0442\u0432\u0430
    \u0441\u0442\u0430\u043b\u0438 \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439
    \u0432\u043e \u0432\u0441\u0435\u0445 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445
    \u0415\u0432\u0440\u043e\u043f\u044b."
  interestingFactsEn: "Renee Descartes's life is not just a dry academic biography, but the great rationalist's hiding a strange hypochondriac, a fearless duellant in his youth and a man who was afraid of flying on ships, below is a collection of the most interesting, chickeny and unknown facts in the life of a philosopher, divided by themes. -- 1.Episcopular maniac: The Census as the main concern of Decart's life, as a shutter, led one of the most extensive correspondence in the history of science (saved about 500 of his letters), but there are nuances: Fear before paper: Descartes panicked that his letters would fall into the hands of the Ezeos, so he developed his own code and codename system for his correspondents.For example, in his letters to Mercenn, he called Galileo simply \"Sinior\" and his manuscripts \"my children.\" He often wrote the phrase \"Read and burn.\" \"Gossipist\": Unlike dry philosophical tracts, his personal letters were full of sarcasm. He could have written to Mercenne: \"I've had enough of this Voetia (his main enemy theologist). If I were a frog, I would jump over his stupid head.\" --2.Dowellant and free-thinking youth, Little knows that the future author of \"Thinking about the First Philosophy\" in youth was a desperate bully.- The Claw Philosophy: Descartes, who was not rich in size, told De Barr: \"I will not fight you where you feel comfortable. Go to the desert where I can fall and stab you, and you can't reach me with your long spaghetti.\" The enemy has freaked out and apologized. This story has spread across Paris, strengthening Descartes' reputation as a man who even reads a duel mathematically. -- 3.The Fobia of the Sailor, given that Descartes was a mechanic and explained all physics, his personal phobia seemed paradoxical.In his letter to a friend, he wrote that a sea bump caused his body to shake so that the \"animal spirits\" (his nervous system theory) came into chaos, and he could not think together. For a man whose philosophy was based on \"clear and clear thinking\", it was tantamount to insanity. --4 The gastronomic eccentric decartes was a gourmet, but believed that food affected intelligence.He made a strict diet for himself, which was sometimes broken in the most absurd way.- The chicken in milk: His favorite dish was an old chicken broth made of milk and spice. He thought it was perfectly \"wetting\" the brain by helping him with his chronic dry cough. - Absent meat in old age: In the last years of his life, he became practically vegetarian, eating only fish, vegetables and bread, because he thought the meat \"made blood thick and prevented thinking about God.\" - 5.Conflict with embryos: The 17th-century Puppy Contest was a theory of preformism - all living creatures were thought to have been fully formed in a miniatur in sperm or egg. - The autopsy of Decart: To prove that life is coming gradually (epigenesis), Descartes performed an autopsy on a pregnant dog in the presence of doctors. He showed that in the womb the embryo did not look like a small dog, but rather as an unformed clot.- Shocking conclusion: After his experience, he was defiantly wash his hands and say that all these \"weirds\" of birth are just heating fluids.- The apple of discord: Pascal believed that religious experience should be above reason.Pascal accused Descartes of using God only as a \"conditional silence\" (to explain the beginning of the movement of the universe and then forget about him).Descartes and his Adams were very proud of his discovery of the prune gland (epiphysis) as the place of the soul. He even opened up some lamb heads to prove it. The fact of the mistake: Decart claimed that epiphysis was floating in the center of the brain's stomach like \"sun in the middle of the world.\" But he did not know that man had this iron firmly attached to the base of the brain.When the anatomists pointed to him, Descartes swung away, saying that the people he opened up (probably in the case of executed criminals) had iron \"mover because of a violent life.\" - Funny contradiction: he believed that the soul was sitting in the iron, but insisted that the soul was \"unmaterial.\" When asked how the intangibles could press on the material body in the iron, Descartes honestly replied, \"I don't have to explain the miracle, it's the mystery of creation.\" - 8.In 1663 (even after his death) his books came into the forbidden book index, but it was interesting to know that he had a history in Holland: - Courting a student: a student at the University of Utrecht publicly defended Decart's theory that animals were machines and did not feel pain.- Church process: Descartes did not appear at trial, but sent a letter in which the monstrously suggested to the church: \"Show me that the dog has an immortal soul, and I admit the mistake. If you cannot, let me study physics quietly.\" This bold letter was brought to the meeting, and the pastors were forced to back off because they could not find the Bible quotations about the souls of animals. --9.Three famous dreams: Mathematics came in a dream the most famous fact of his life story was the night of November 10, 1619, in Neuburg. - Sleep 1: He dreamt of a vortex that drove him to the church. - Sleep 2: He dreamed of a thunderstorm and a shiny lightning. - Sleep 3: He dreamed of an encyclopedia book opened on the verse \"Quod vitae setabor ter?\", and there was a man who gave him a book on geometry.When he woke up, Descartes fell down on his knees and said, \"I felt so excited about the fire.\" He realized that all science could be combined by a common mathematical method. He vowed to build a new philosophy and even went to the church of God's mother in Loreto to make a vow.As Descartes \"killed\" a king's chef during a visit to Stockholm Decart was mainly fed by what he had brought from France (guilty and cheese) because the Swedish kitchen considered it barbaric.Descartes squeezlyly moved the dish and said loudly (on the table) that the food \"is only for slaves, but not for a man seeking the truth.\" Consequences: The insulted court chef resigned. Christine, who had a sense of humor, called Descartes and forced him to apologize publicly to the cook, otherwise he would lose his pension.Decart apologized, but on the same day, in a letter to Mersenne, he wrote, \"Eat this rotten fish means give up my mind, I'd rather die.\" The irony of fate: he did die in a few months, not from the fish, but from the cold.\" --11. Last words and mystical prediction. There's a legend that historians challenge, but it's too beautiful to bring it.- Talking to a monk: On the morning before he died, when Descartes was delusional, a Jesuit monk came to him (who he hated for his whole life) for confession. The monk asked, \"Do you believe in the Holy Trinity?\" Decart, legendally, opened his eyes and smiled, \"I believe in God, but the Trinity's evidence is a task for angels, not for the geometry.\"- Prophecy: The Queen of Cristina, after learning of the death of Decart, cried and said a phrase that became prophetic: \"He slept too long to die awake, but his ideas still shake Europe.\" She was right – after 20 years, the ideas of Cartesianism became the main philosophy in all European universities."
