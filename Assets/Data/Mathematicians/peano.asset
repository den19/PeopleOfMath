  achievementsRu: "\u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u0442\u0440\u0443\u0434\u044b
    \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041f\u0435\u0430\u043d\u043e \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0441\u043f\u0435\u043a\u0442\u0440: \u043e\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043e\u0441\u043d\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0434\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \u0434\u043b\u044f \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f, \u0430 \u0447\u0430\u0441\u0442\u0438
    \u0435\u0434\u0438\u043d\u043e\u0433\u043e, \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u043f\u043e \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u0438\u044e
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0432\u0441\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c
    \u0438\u0445 \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445.\n\n\U0001F4DC \u0410\u043a\u0441\u0438\u043e\u043c\u044b
    \u041f\u0435\u0430\u043d\u043e: \u0417\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438 (1889) \u0421\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u041f\u0435\u0430\u043d\u043e \u2014 \u044d\u0442\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430
    \u0430\u043a\u0441\u0438\u043e\u043c \u0434\u043b\u044f \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432 \u0435\u0433\u043e \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u043e\u043c \u043f\u0430\u043c\u0444\u043b\u0435\u0442\u0435
    Arithmetices principia, nova methodo exposita (\u041f\u0440\u0438\u043d\u0446\u0438\u043f\u044b
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438, \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435
    \u043d\u043e\u0432\u044b\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043c) \u0432 1889 \u0433\u043e\u0434\u0443.
    \u041e\u043d \u0445\u043e\u0442\u0435\u043b \u0441\u0432\u0435\u0441\u0442\u0438 \u0432\u0441\u044e
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443 \u043a \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c
    \u0431\u0430\u0437\u043e\u0432\u044b\u043c, \u043d\u0435\u0434\u043e\u043a\u0430\u0437\u0443\u0435\u043c\u044b\u043c
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f\u043c, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u044b \u0441\u0442\u0440\u043e\u0433\u043e
    \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435.
    \u042d\u0442\u0438 \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b (N) \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c: 1. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0430\u0447\u0430\u043b\u0430: `1` (\u0438\u043b\u0438 `0` \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430\u0445) \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0447\u0438\u0441\u043b\u043e\u043c.
    \u042d\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u043d\u0435 \u043f\u0443\u0441\u0442\u043e. 2. \u0424\u0443\u043d\u043a\u0446\u0438\u044f
    \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u0414\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430
    `x` \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0440\u043e\u0432\u043d\u043e
    \u043e\u0434\u043d\u043e \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e `x'`, \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u043e\u0435
    \u0435\u0433\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u0438\u043b\u0438
    \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c (\u043f\u043e
    \u0441\u0443\u0442\u0438, `x + 1`). 3. \u0418\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435
    \u043d\u0430\u0447\u0430\u043b\u0430: \u041d\u0438 \u0434\u043b\u044f \u043a\u0430\u043a\u043e\u0433\u043e
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430
    `x` \u043d\u0435\u0432\u0435\u0440\u043d\u043e, \u0447\u0442\u043e `x' = 1`. \u0414\u0440\u0443\u0433\u0438\u043c\u0438
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438, `1` \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e
    \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430. 4. \u0418\u043d\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c
    \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u0415\u0441\u043b\u0438 `x'
    = y'`, \u0442\u043e `x = y`. \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0434\u0438\u043d \u00ab\u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u00bb,
    \u0438 \u0440\u0430\u0437\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430 \u043d\u0435
    \u043c\u043e\u0433\u0443\u0442 \u0438\u043c\u0435\u0442\u044c \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438 \u0442\u043e\u0433\u043e \u0436\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f.
    5. \u0410\u043a\u0441\u0438\u043e\u043c\u0430 \u0438\u043d\u0434\u0443\u043a\u0446\u0438\u0438
    (\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u043d\u0434\u0443\u043a\u0446\u0438\u0438): \u0415\u0441\u043b\u0438 \u043a\u0430\u043a\u043e\u0435-\u0442\u043e
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0432\u0435\u0440\u043d\u043e \u0434\u043b\u044f
    `1`, \u0438 \u0438\u0437 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d\u043e
    \u0432\u0435\u0440\u043d\u043e \u0434\u043b\u044f `x`, \u0441\u043b\u0435\u0434\u0443\u0435\u0442,
    \u0447\u0442\u043e \u043e\u043d\u043e \u0432\u0435\u0440\u043d\u043e \u0438 \u0434\u043b\u044f
    `x'`, \u0442\u043e \u044d\u0442\u043e \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0432\u0435\u0440\u043d\u043e
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u044d\u0442\u0438\u0445
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0438 \u0441\u0442\u0440\u043e\u0433\u0438\u0445
    \u043f\u0440\u0430\u0432\u0438\u043b \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0438 \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0432\u0441\u0435 \u0438\u0445 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430,
    \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0430\u0441\u0441\u043e\u0446\u0438\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c.
    \u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u041f\u0435\u0430\u043d\u043e \u0441\u0442\u0430\u043b\u0430
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043e\u043a\u0430\u0437\u0430\u0432
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0442\u0430\u043a\u0438\u0445 \u043c\u044b\u0441\u043b\u0438\u0442\u0435\u043b\u0435\u0439,
    \u043a\u0430\u043a \u0411\u0435\u0440\u0442\u0440\u0430\u043d \u0420\u0430\u0441\u0441\u0435\u043b.\n\n\U0001F300
    \u041a\u0440\u0438\u0432\u0430\u044f \u041f\u0435\u0430\u043d\u043e: \u041f\u0435\u0440\u0432\u044b\u0439
    \u00ab\u0444\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u043e\u043d\u0441\u0442\u0440\u00bb
    (1890) \u0412 1890 \u0433\u043e\u0434\u0443 \u041f\u0435\u0430\u043d\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b
    \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u044e, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0432
    \u0440\u0430\u0431\u043e\u0442\u0443, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0443\u044e
    \u043a\u0440\u0438\u0432\u0443\u044e, \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0449\u0443\u044e
    \u0447\u0435\u0440\u0435\u0437 \u043a\u0430\u0436\u0434\u0443\u044e \u0442\u043e\u0447\u043a\u0443
    \u0435\u0434\u0438\u043d\u0438\u0447\u043d\u043e\u0433\u043e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430.
    \u0415\u0433\u043e \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u044f \u0431\u044b\u043b\u0438
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u0435\u043d\u044b \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c
    \u0413\u0435\u043e\u0440\u0433\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u043e \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438
    \u043e\u0442\u0440\u0435\u0437\u043a\u0430 \u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430
    (\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438 \u0431\u0438\u0435\u043a\u0446\u0438\u0438
    \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438), \u043d\u043e \u041a\u0430\u043d\u0442\u043e\u0440\u043e\u0432\u043e
    \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e
    \u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b\u043c. \u041f\u0435\u0430\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0435 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u0442\u0430\u043a\u0436\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0432 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u044b\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043e \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438.
    \u0415\u0433\u043e \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u0431\u044b\u043b\u0430
    \u0447\u0438\u0441\u0442\u043e \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043d\u0430 \u0442\u0440\u043e\u0438\u0447\u043d\u043e\u043c
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0447\u0438\u0441\u0435\u043b,
    \u0438 \u043d\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0438\u0441\u0443\u043d\u043a\u043e\u0432. \u042d\u0442\u043e \u0431\u044b\u043b
    \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043c\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c
    \u043a\u0440\u0438\u0432\u043e\u0439, \u0437\u0430\u043f\u043e\u043b\u043d\u044f\u044e\u0449\u0435\u0439
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e (space-filling
    curve). \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u043a\u0440\u0438\u0432\u043e\u0439 \u041f\u0435\u0430\u043d\u043e: \u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043d\u0438\u0433\u0434\u0435 \u043d\u0435 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u0443\u0435\u043c\u043e\u0441\u0442\u044c:
    \u0424\u0443\u043d\u043a\u0446\u0438\u0438, \u0437\u0430\u0434\u0430\u044e\u0449\u0438\u0435
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b \u0442\u043e\u0447\u0435\u043a
    \u043a\u0440\u0438\u0432\u043e\u0439, \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b,
    \u043d\u043e \u043d\u0435 \u0438\u043c\u0435\u044e\u0442 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439
    \u043d\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0435. \u0421\u0430\u043c\u043e\u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0435:
    \u0427\u0442\u043e\u0431\u044b \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442,
    \u043a\u0440\u0438\u0432\u0430\u044f \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0437 \u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u0442\u044c
    \u0441\u0430\u043c\u0443 \u0441\u0435\u0431\u044f. \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435: \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0438\u0440. \u041e\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u043e,
    \u0447\u0442\u043e \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f \u0438 \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u044b\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0431\u0440\u0430\u0437\u044b
    \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043e\u0431\u043c\u0430\u043d\u0447\u0438\u0432\u044b,
    \u0438 \u0434\u043b\u044f \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u0442\u0430\u043a\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u043d\u0443\u0436\u043d\u0430 \u0441\u0442\u0440\u043e\u0433\u0430\u044f
    \u043b\u043e\u0433\u0438\u043a\u0430. \u041f\u043e \u0441\u043b\u043e\u0432\u0430\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0425\u0430\u043d\u0441\u0430
    \u0425\u0430\u043d\u0430, \u044d\u0442\u043e \u00ab\u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u043e \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439;
    \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u043d\u044f\u0442\u043e
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0437 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437\u00bb.\n\n\U0001F4DA \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb: \u042d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f
    \u0432 \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u0445 (1891\u20131908) \u041a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438 \u041f\u0435\u0430\u043d\u043e \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0435\u043a\u0442
    \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb
    (Formulario Mathematico). \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u043e\u043f\u044b\u0442\u043a\u0430
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0443\u044e
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044e \u0432\u0441\u0435\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0443\u044e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u043c
    \u041f\u0435\u0430\u043d\u043e. \u0420\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434
    \u043d\u0438\u043c \u0432\u0435\u043b\u0430\u0441\u044c \u0441 1891 \u043f\u043e 1908 \u0433\u043e\u0434
    \u0438 \u0432\u044b\u0448\u043b\u0430 \u0432 \u043f\u044f\u0442\u0438 \u0438\u0437\u0434\u0430\u043d\u0438\u044f\u0445
    (tomi).\n\n\U0001F3AF \u0426\u0435\u043b\u044c \u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430
    \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0426\u0435\u043b\u044c: \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0432\u0441\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u0438 \u043c\u0435\u0442\u043e\u0434\u044b \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u043e
    \u0441\u0436\u0430\u0442\u043e\u0439, \u0442\u043e\u0447\u043d\u043e\u0439 \u0438 \u0435\u0434\u0438\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u0435, \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0439 \u043e\u0442
    \u0434\u0432\u0443\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0435\u0439
    \u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430. \u0411\u0438\u0431\u043b\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c:
    \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u00bb \u043d\u0435 \u0431\u044b\u043b
    \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0443\u0445\u0438\u043c \u0441\u043f\u0438\u0441\u043a\u043e\u043c
    \u0444\u043e\u0440\u043c\u0443\u043b. \u041e\u043d \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b
    \u0431\u043e\u0433\u0430\u0442\u044b\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438 \u0431\u0438\u0431\u043b\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b, \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044f
    \u043f\u0435\u0440\u0432\u043e\u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0438
    \u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u043c\u043d\u043e\u0433\u0438\u0445 \u0442\u0435\u043e\u0440\u0435\u043c
    (\u043e\u0442 \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0438 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430
    \u0434\u043e \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u0413\u0430\u0443\u0441\u0441\u0430).
    \u0412 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u0445 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b\u0438\u0441\u044c
    \u043e\u0431\u0448\u0438\u0440\u043d\u044b\u0435 \u0441\u043f\u0438\u0441\u043a\u0438 \u0438\u043c\u0435\u043d
    \u0438 \u0442\u0440\u0443\u0434\u043e\u0432, \u0441 \u0446\u0438\u0442\u0430\u0442\u0430\u043c\u0438
    \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0430.
    \u0421\u0438\u043c\u0432\u043e\u043b\u0438\u0437\u043c: \u041f\u0435\u0430\u043d\u043e \u0432\u0432\u0435\u043b
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440: `\u2208` (\u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0443), `\u2283` (\u0432 \u0435\u0433\u043e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435), `\u222a` (\u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432), `\u2229` (\u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432). \u0415\u0433\u043e \u043d\u043e\u0442\u0430\u0446\u0438\u044f
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u0434\u0430\u0447\u043d\u043e\u0439, \u0447\u0442\u043e \u0431\u044b\u043b\u0430
    \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u044f\u0442\u0430 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0430
    \u0420\u0430\u0441\u0441\u0435\u043b\u043e\u043c \u0438 \u0423\u0430\u0439\u0442\u0445\u0435\u0434\u043e\u043c
    \u0432 \u0438\u0445 \u00abPrincipia Mathematica\u00bb.\n\n\U0001F5E3\ufe0f \u042d\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u044f\u0437\u044b\u043a\u0430: \u043e\u0442 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043a \u00ab\u041b\u0430\u0442\u0438\u043d\u043e \u0441\u0438\u043d\u0435 \u0444\u043b\u0435\u043a\u0441\u0438\u043e\u043d\u0435\u00bb
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0430 \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u044f\u0437\u044b\u043a\u0430, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043f\u0438\u0441\u0430\u043b\u0438\u0441\u044c \u043f\u043e\u044f\u0441\u043d\u0435\u043d\u0438\u044f
    \u043a \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c: \u041f\u0435\u0440\u0432\u044b\u0435
    \u0447\u0435\u0442\u044b\u0440\u0435 \u0438\u0437\u0434\u0430\u043d\u0438\u044f (I-IV \u0442\u043e\u043c\u0430,
    \u0441 1895 \u043f\u043e 1903 \u0433\u043e\u0434) \u0432\u044b\u0448\u043b\u0438 \u0441
    \u043f\u043e\u044f\u0441\u043d\u0435\u043d\u0438\u044f\u043c\u0438 \u043d\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432 \u0442\u043e
    \u0432\u0440\u0435\u043c\u044f \u0431\u044b\u043b lingua franca \u043d\u0430\u0443\u043a\u0438.
    \u041f\u044f\u0442\u043e\u0435 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435
    \u0438\u0437\u0434\u0430\u043d\u0438\u0435 (1908 \u0433\u043e\u0434) \u0431\u044b\u043b\u043e
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043e \u043d\u0430 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043d\u043d\u043e\u043c
    \u041f\u0435\u0430\u043d\u043e \u044f\u0437\u044b\u043a\u0435 \u00ab\u041b\u0430\u0442\u0438\u043d\u043e
    \u0441\u0438\u043d\u0435 \u0444\u043b\u0435\u043a\u0441\u0438\u043e\u043d\u0435\u00bb (Latino
    sine flexione \u2014 \u00ab\u043b\u0430\u0442\u044b\u043d\u044c \u0431\u0435\u0437 \u0441\u043b\u043e\u0432\u043e\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439\u00bb).
    \u042d\u0442\u043e \u0431\u044b\u043b \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u044b\u0439
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u043b\u0430\u0442\u044b\u043d\u0438, \u0438\u0437
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u044b\u043b\u0438 \u0443\u0431\u0440\u0430\u043d\u044b
    \u043f\u0430\u0434\u0435\u0436\u0438 \u0438 \u0441\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f,
    \u0447\u0442\u043e, \u043f\u043e \u0437\u0430\u043c\u044b\u0441\u043b\u0443 \u041f\u0435\u0430\u043d\u043e,
    \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u0435\u0433\u043e \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u044f\u0437\u044b\u043a\u043e\u043c. \u041e\u043d
    \u0442\u0430\u043a \u0432\u0435\u0440\u0438\u043b \u0432 \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0435\u043a\u0442,
    \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u0441\u0432\u043e\u044e \u043b\u0435\u043a\u0446\u0438\u044e
    \u0432 1908 \u0433\u043e\u0434\u0443 \u043d\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u043c
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 \u0420\u0438\u043c\u0435 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b \u043d\u0430
    \u044d\u0442\u043e\u043c \u044f\u0437\u044b\u043a\u0435.\n\n\U0001F91D \u0412\u043b\u0438\u044f\u043d\u0438\u0435
    \u0438 \u043a\u0440\u0438\u0442\u0438\u043a\u0430 \u0412\u043b\u0438\u044f\u043d\u0438\u0435:
    \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u00bb \u0438 \u0435\u0433\u043e \u0448\u043a\u043e\u043b\u0430
    (\u0432 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u0445\u043e\u0434\u0438\u043b\u0438
    \u0442\u0430\u043a\u0438\u0435 \u044f\u0440\u043a\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043a\u0430\u043a \u041c\u0430\u0440\u0438\u043e \u041f\u044c\u0435\u0440\u0438, \u0427\u0435\u0437\u0430\u0440\u0435
    \u0411\u0443\u0440\u0430\u043b\u0438-\u0424\u043e\u0440\u0442\u0438, \u0414\u0436\u043e\u0432\u0430\u043d\u043d\u0438
    \u0412\u0430\u0439\u043b\u0430\u0442\u0438) \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0440\u0430\u043d\u043d\u044e\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043b\u043e\u0433\u0438\u043a\u0443.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c \u0411\u0435\u0440\u0442\u0440\u0430\u043d
    \u0420\u0430\u0441\u0441\u0435\u043b \u0432 1900 \u0433\u043e\u0434\u0443 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u0438\u0434\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439
    \u041f\u0435\u0430\u043d\u043e, \u0447\u0442\u043e \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u041a\u0440\u0438\u0442\u0438\u043a\u0430: \u041f\u0440\u043e\u0435\u043a\u0442 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b
    \u0438 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u0443\u044e \u043a\u0440\u0438\u0442\u0438\u043a\u0443.
    \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0441\u0430\u0440\u043a\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0442\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043e \u00ab\u0448\u043a\u043e\u043b\u0435
    \u041f\u0435\u0430\u043d\u043e\u00bb, \u0441\u0447\u0438\u0442\u0430\u044f \u0438\u0445
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043c\u043e\u043c
    \u0438 \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438 \u0431\u0435\u0441\u043f\u043b\u043e\u0434\u043d\u044b\u043c.
    \u0415\u0433\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u0430, \u0445\u043e\u0442\u044f
    \u0447\u0430\u0441\u0442\u043e \u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u0430\u044f,
    \u043d\u0430\u043d\u0435\u0441\u043b\u0430 \u0443\u0440\u043e\u043d \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u0438
    \u0448\u043a\u043e\u043b\u044b \u0438 \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0438\u043b\u0430
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435
    \u0438\u0434\u0435\u0439 \u041f\u0435\u0430\u043d\u043e \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438.
    \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0412\u0438\u0442\u043e \u0412\u043e\u043b\u044c\u0442\u0435\u0440\u0440\u0430,
    \u0442\u043e\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u044d\u0442\u0438 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u044f
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u043c\u0438
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u043c\u0438, \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044f
    \u0438\u0445 \u00ab\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439\u00bb \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e: \u0412
    \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u0435\u00bb \u041f\u0435\u0430\u043d\u043e
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u0439
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u0430
    \u0442\u0430\u043a\u0436\u0435 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 n-\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.\n\n\U0001F48E \u0418\u0442\u043e\u0433
    \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041f\u0435\u0430\u043d\u043e \u0431\u044b\u043b
    \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u043e\u043c \u043d\u043e\u0432\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f
    \u043d\u0435 \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e
    \u043e\u0434\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438, \u0430 \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0437\u0438\u0436\u0434\u0435\u0442\u0441\u044f
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.
    \u0421\u0432\u043e\u0438\u043c\u0438 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u043c\u0438
    \u043e\u043d \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443,
    \u0441\u0432\u043e\u0435\u0439 \u043a\u0440\u0438\u0432\u043e\u0439 \u2014 \u0440\u0430\u0437\u0434\u0432\u0438\u043d\u0443\u043b
    \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438,
    \u0430 \u0441\u0432\u043e\u0438\u043c \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u043e\u043c\u00bb
    \u2014 \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u043f\u0443\u0442\u044c \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0435\u0434\u0438\u043d\u043e\u0433\u043e, \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0437\u043d\u0430\u043d\u0438\u044f. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u043f\u0440\u044f\u043c\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0448\u043a\u043e\u043b
    \u0420\u0430\u0441\u0441\u0435\u043b\u0430, \u0423\u0430\u0439\u0442\u0445\u0435\u0434\u0430
    \u0438, \u0432 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c, \u0433\u0440\u0443\u043f\u043f\u044b
    \u0411\u0443\u0440\u0431\u0430\u043a\u0438."
  achievementsEn: "Giuseppe Peano's achievements and works range from the fundamentals of mathematics to the creation of a universal language for science. Its main works are not just isolated discoveries, but parts of a single, grand project to rethink and systematize all mathematics. Consider them in detail.\n\nThe most famous achievement of Peano is the axiom system for natural numbers, published in its Latin pamphlet Arithemetics principia, nova methodo exposita (the arithmetic principles set out by the new method) in 1889. He wanted to put all arithmetic into a few basic, unproven statements from which everyone else could be strictly removed.These axioms define many natural numbers (N) as follows: 1. The existence of the beginning: `1' (or `0' in modern versions) is a natural number. This states that many natural numbers are not empty. 2. The function of the sequence: For each natural number `x' there is exactly one natural number `x' called its next or direct follower (in essence `x + 1'). 3.Deletion of the beginning: For no natural number `x' is wrong that `x' = 1. In other words `1' is not a follower of any other natural number. 4. Injectability: If `x' = y', `x = y'. This means that each number can have only one `presor' and different numbers cannot have the same follower. 5.The axiom of induction (the principle of mathematical induction): If a property is true for `1' and what it is true for `x', it is true for `x', it is true for all natural numbers. On the basis of these simple and strict rules, it can be determined to add and multiply and then prove all their properties, such as association and commutability.The Peano system has become the cornerstone of all the subsequent work of formalizing mathematics, with a huge influence on thinkers such as Bertrand Russell.\n\nThe first \"fractal monster\" (1890) in 1890, Peano made a sensation by publishing a work in which a continuous curve was built that passes through each point of the unit square. His research was inspired by George Cantor's discovery of the equal power of the segment and the square (the existence of a bisection between them), but the Cantoro representation was torn.Peano showed that a continuous display is also possible by completely disputing the intuitive concepts of dimensionality. It was a purely analytical design based on a three-dimensional representation of numbers and did not contain geometric drawings. This was the first example of what we call today the space-filling curve.The key properties of the Peano curve: Continuousity and no differentiation anywhere: The functions that set the coordinates of the points of the curve are continuous, but do not have a derivative at any point. Self-conversion: To fill the square, the curve must cross itself endlessly. Revolutionary influence: This discovery shocked the mathematical world.It showed that intuition and visual geometric images can be deceiving, and it requires strict logic to understand such objects. According to the mathematician Hans Khan, this \"cannot be understood by intuition; it can only be understood through logical analysis\".\n\n===Peano Life ========Peano Life ==========Physicals===============Peno======Peano===================================================================================================================================================================================================\n\nObjective and structure of the project: To present all known mathematical theorems, definitions and methods in a very concise, precise and uniform form, free from ambiguity in the normal language. Bibliographic and historical value: \"Formullar\" was not merely a dry list of formulas. It contained rich historical and bibliographic material, indicating the origin and authors of many theorems (from Euclid and Archimedes to Newton and Gauss).The annexes contained extensive lists of names and works, quoting them in the original language. Symbolism: Peano introduced many mathematical symbols that we still use: ``'(is due to multiple), `'(in its system meant logical follow-up or inclusion), ``(comparison of multiples), `'(intersection of multiples).His lecture was so successful that it was accepted and developed by Russell and Whitehead in their \"Principia Mathematica\".\n\nThe evolution of the language: from French to French blue flexion, the evolution of the language in which the explanations for the formulas were written is interesting: the first four editions (I-IV volumes, 1895 to 1903) were published with an explanation in French, which was at that time a lingua franca of science. The fifth and last edition (1908) was written in the language invented by Peano, Latino sine flexione (Latino sine flexione, \"Latinuá franca de la locación\".It was a simplified version of Latin, from which the paddles and tensions were removed, which Peano intended to make it an ideal international scientific language, and he so believed in the project that even his lecture in 1908 at the International Congress of Mathematicians in Rome was read in that language.\n\n===Critics===========Career=========Career==========Career========Career=========Chessing===========Chess======Chess and criticism==============================================================================================================================================================Henri Poancaré spoke sarcastically about the \"Peano School\" because he considered their passion for formalism and symbols to be fruitless; his criticism, although often unfair, had damaged the school's reputation and made it difficult to disseminate the ideas of Peano in France; some contemporarys, such as Vito Volterra, too, considered the research to be too abstract and philosophical, as opposed to \"real\" mathematics.Contribution to history: For the first time in \"Formullar\", Peano provided a rigorous and in-depth analysis of the concept of function, as well as an axiomatic definition of n-dimensional vector space, far ahead of its time.\n\nThe result of Giuseppe Peano was the architect of a new mathematical language, whose main contribution is not to solve a single problem, but to create the tools and foundations on which modern mathematics is based. By his axioms, he formalized arithmetic, his curve — spread the limits of intuition, and his Formolar — he showed the way to creating a unified, rigorous and universal mathematical knowledge.His work has had a direct impact on the formation of schools in Russell, Whitehead and, subsequently, Burbaki groups."
  personalLifeRu: "\u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041f\u0435\u0430\u043d\u043e \u043f\u0440\u043e\u0436\u0438\u043b
    \u0434\u043e\u043b\u0433\u0443\u044e \u0438 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c, \u0446\u0435\u043b\u0438\u043a\u043e\u043c \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0443\u044e
    \u043d\u0430\u0443\u043a\u0435. \u0415\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u2014 \u044d\u0442\u043e \u043f\u0443\u0442\u044c
    \u043e\u0442 \u0441\u044b\u043d\u0430 \u0444\u0435\u0440\u043c\u0435\u0440\u0430 \u0434\u043e
    \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u043e\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438,
    \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u0430\u043a \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f,
    \u0442\u0430\u043a \u0438 \u043d\u0435\u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f
    \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432.\n\n\U0001F33E
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b (1858\u20131876) \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435
    \u041f\u0435\u0430\u043d\u043e \u0440\u043e\u0434\u0438\u043b\u0441\u044f 27 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1858 \u0433\u043e\u0434\u0430 \u043d\u0430 \u0444\u0435\u0440\u043c\u0435 \u0422\u0435\u0442\u0442\u043e-\u0413\u0430\u043b\u0430\u043d\u0442
    \u0432 \u0421\u043f\u0438\u043d\u0435\u0442\u0442\u0435, \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0434\u0435\u0440\u0435\u0432\u043d\u0435 \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e
    \u043e\u0442 \u0433\u043e\u0440\u043e\u0434\u0430 \u041a\u0443\u043d\u0435\u043e \u0432
    \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u043e\u043c \u0440\u0435\u0433\u0438\u043e\u043d\u0435
    \u041f\u044c\u0435\u043c\u043e\u043d\u0442. \u0415\u0433\u043e \u0441\u0435\u043c\u044c\u044f
    \u0431\u044b\u043b\u0430 \u0444\u0435\u0440\u043c\u0435\u0440\u0441\u043a\u043e\u0439. \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0432 \u0434\u0435\u0440\u0435\u0432\u0435\u043d\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0432 \u0448\u043a\u043e\u043b\u0435 \u0432 \u041a\u0443\u043d\u0435\u043e,
    \u043a\u0443\u0434\u0430 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u0445\u043e\u0434\u0438\u043b
    \u043f\u0435\u0448\u043a\u043e\u043c \u043e\u043a\u043e\u043b\u043e 5 \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u043e\u0432.
    \u041f\u0443\u0442\u044c \u043a \u043d\u0430\u0443\u043a\u0435 \u0435\u043c\u0443 \u043e\u0442\u043a\u0440\u044b\u043b
    \u0435\u0433\u043e \u0434\u044f\u0434\u044f, \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a
    \u0438 \u044e\u0440\u0438\u0441\u0442, \u0436\u0438\u0432\u0448\u0438\u0439 \u0432 \u0422\u0443\u0440\u0438\u043d\u0435.
    \u0417\u0430\u043c\u0435\u0442\u0438\u0432 \u0442\u0430\u043b\u0430\u043d\u0442 \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u043a\u0430,
    \u0432 1870 \u0433\u043e\u0434\u0443 \u043e\u043d \u0437\u0430\u0431\u0440\u0430\u043b \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435
    \u043a \u0441\u0435\u0431\u0435, \u0447\u0442\u043e\u0431\u044b \u0442\u043e\u0442 \u043c\u043e\u0433
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0445\u043e\u0440\u043e\u0448\u0435\u0435
    \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u041f\u0435\u0430\u043d\u043e \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u043b\u0438\u0446\u0435\u0439
    \u041a\u0430\u0432\u0443\u0440\u0430 \u0432 \u0422\u0443\u0440\u0438\u043d\u0435 \u0438
    \u0432 1876 \u0433\u043e\u0434\u0443 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.\n\n\U0001F393
    \u0423\u0447\u0451\u0431\u0430 \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b (1876\u20131890) \u0412 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u041f\u0435\u0430\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u043b \"\u0447\u0438\u0441\u0442\u0443\u044e\"
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u0430\u043a \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0435\u0433\u043e
    \u0441\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u043e\u0432 \u0432\u044b\u0431\u0438\u0440\u0430\u043b\u0438
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435.
    \u0412 1880 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0441 \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c.
    \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u043f\u0443\u0441\u043a\u0430
    \u043e\u043d \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c
    \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0443 \u042d\u043d\u0440\u0438\u043a\u043e \u0414'\u041e\u0432\u0438\u0434\u0438\u043e,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0443 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0410\u043d\u0434\u0436\u0435\u043b\u043e \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438.
    \u0418\u0437-\u0437\u0430 \u0441\u043b\u0430\u0431\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438 \u041f\u0435\u0430\u043d\u043e \u0443\u0436\u0435
    \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0433\u043e\u0434\u0430 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0430\u0447\u0430\u043b \u0432\u0435\u0441\u0442\u0438 \u0435\u0433\u043e \u043a\u0443\u0440\u0441
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u0412 1884 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0439
    \u043f\u0435\u0440\u0432\u044b\u0439 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u044b\u0448\u0435\u043b \u043f\u043e\u0434 \u0438\u043c\u0435\u043d\u0435\u043c \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438,
    \u0445\u043e\u0442\u044f \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0431\u044b\u043b \u043d\u0430\u043f\u0438\u0441\u0430\u043d \u0441\u0430\u043c\u0438\u043c
    \u041f\u0435\u0430\u043d\u043e. \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438 \u0447\u0435\u0441\u0442\u043d\u043e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043b \u044d\u0442\u043e, \u043d\u0430\u0437\u0432\u0430\u0432
    \u041f\u0435\u0430\u043d\u043e \"\u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c\".
    \u0412 1886 \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0438 \u0432 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u043e\u0439 \u0432\u043e\u0435\u043d\u043d\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438. \u0422\u0440\u0438 \u0433\u043e\u0434\u0430
    \u0441\u043f\u0443\u0441\u0442\u044f, \u0432 1889 \u0433\u043e\u0434\u0443, \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430 \u0432 \u044d\u0442\u043e\u043c
    \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438. \u0412 1890 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b, \u043d\u0430\u043a\u043e\u043d\u0435\u0446, \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0432 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0437\u0430\u043d\u044f\u0432
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F466
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0412 1887 \u0433\u043e\u0434\u0443
    \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041f\u0435\u0430\u043d\u043e \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041a\u0430\u0440\u043e\u043b\u0435 \u041a\u0440\u043e\u0437\u0438\u043e (Carola
    Crosio). \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0442\u0443\u0440\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0430
    \u041b\u0443\u0438\u0434\u0436\u0438 \u041a\u0440\u043e\u0437\u0438\u043e, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0441\u0432\u043e\u0435\u0439 \u043a\u0430\u0440\u0442\u0438\u043d\u043e\u0439 \"\u041c\u0430\u0434\u043e\u043d\u043d\u0430
    \u0423\u0431\u0435\u0436\u0438\u0449\u0435 \u0413\u0440\u0435\u0448\u043d\u0438\u043a\u043e\u0432\".
    \u0421\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043e \u0442\u043e\u043c, \u0431\u044b\u043b\u0438
    \u043b\u0438 \u0443 \u043f\u0430\u0440\u044b \u0434\u0435\u0442\u0438, \u0432 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445 \u043d\u0435\u0442.\n\n\U0001F52C
    \u0420\u0430\u0441\u0446\u0432\u0435\u0442 \u0438 \u0432\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 (1890-\u0435 \u2013 1900-\u0435)
    \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b \u0441\u0430\u043c\u044b\u043c
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c, \u043d\u043e \u0438
    \u0441\u0430\u043c\u044b\u043c \u0441\u043b\u043e\u0436\u043d\u044b\u043c \u0432 \u0436\u0438\u0437\u043d\u0438
    \u041f\u0435\u0430\u043d\u043e. \"\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\" \u0438
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435\u043c:
    \u0412 1891 \u0433\u043e\u0434\u0443 \u041f\u0435\u0430\u043d\u043e \u043d\u0430\u0447\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0439
    \u043f\u0440\u043e\u0435\u043a\u0442 \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb (Formulario Mathematico).
    \u041e\u043d \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d
    \u044d\u0442\u043e\u0439 \u0438\u0434\u0435\u0435\u0439, \u0447\u0442\u043e \u043d\u0430\u0447\u0430\u043b
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e
    \u0434\u043b\u044f \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f.
    \u042d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0435:
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u043d\u0435 \u043c\u043e\u0433\u043b\u0438
    \u0443\u0441\u0432\u043e\u0438\u0442\u044c \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b,
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0439 \u043d\u0430 \u0441\u043b\u043e\u0436\u043d\u043e\u043c
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435.
    \u041f\u0435\u0430\u043d\u043e, \u043d\u0435\u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0439
    \u043b\u0435\u043a\u0442\u043e\u0440, \u0441\u0442\u0430\u043b \u043d\u0435\u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c. \u0423\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u0435
    \u0438\u0437 \u0412\u043e\u0435\u043d\u043d\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    (1901): \u0415\u0433\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0437\u043c\u043e\u043c
    \u0438 \"\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u043e\u043c\" \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c
    \u0441\u0447\u0435\u0442\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0443\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u044e
    \u0438\u0437 \u0412\u043e\u0435\u043d\u043d\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u0432 1901 \u0433\u043e\u0434\u0443, \u0442\u0430\u043a \u043a\u0430\u043a \u0435\u0433\u043e
    \u0441\u0442\u0438\u043b\u044c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f\u043c. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b \u0441\u0432\u043e\u044e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438:
    \u041f\u0435\u0430\u043d\u043e \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0440\u0435\u0434\u043a\u043e\u0441\u0442\u043d\u044b\u043c
    \u0434\u0430\u0440\u043e\u043c \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043e\u0448\u0438\u0431\u043a\u0438
    \u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0432 \u0447\u0443\u0436\u0438\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u0445. \u042d\u0442\u0430 \u0435\u0433\u043e
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u0430
    \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u043b\u0435\u0433.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0435\u0433\u043e \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u041a\u043e\u0440\u0440\u0430\u0434\u043e
    \u0421\u0435\u0433\u0440\u0435 \u0432\u043e\u0437\u043d\u0438\u043a \u0438\u043c\u0435\u043d\u043d\u043e
    \u0438\u0437-\u0437\u0430 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u041f\u0435\u0430\u043d\u043e
    \u0443\u043a\u0430\u0437\u0430\u043b \u043d\u0430 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043a\u0438
    \u0432 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0435. \u0422\u0430\u043a\u0436\u0435
    \u043e\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c\u0438
    \u0440\u0435\u0437\u043a\u0438\u043c\u0438 \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u044f\u043c\u0438,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0430 \u043a\u043d\u0438\u0433\u0443
    \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u0412\u0435\u0440\u043e\u043d\u0435\u0437\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435\u043c \"\u043d\u0435\u043b\u0435\u043f\u043e\u0441\u0442\u0435\u0439\".\n\n\U0001F30D
    \u0422\u0440\u0438\u0443\u043c\u0444 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u0438
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0420\u0430\u0441\u0441\u0435\u043b\u043e\u043c
    (1900) \u041f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0436\u0438\u0437\u043d\u0438 \u041f\u0435\u0430\u043d\u043e \u0441\u0442\u0430\u043b
    1900 \u0433\u043e\u0434, \u043a\u043e\u0433\u0434\u0430 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    \u043f\u0440\u043e\u0448\u043b\u0438 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u044b
    \u043f\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430
    \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u0430\u044f
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0434\u043e\u043c
    \u0420\u0430\u0441\u0441\u0435\u043b\u043e\u043c. \u0420\u0430\u0441\u0441\u0435\u043b \u0431\u044b\u043b
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438
    \u041f\u0435\u0430\u043d\u043e, \u0447\u0442\u043e \u043f\u0440\u0435\u0440\u0432\u0430\u043b
    \u0441\u0432\u043e\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435
    \u0438 \u0443\u0435\u0445\u0430\u043b \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u044e,
    \u0447\u0442\u043e\u0431\u044b \"\u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0438\u0437\u0443\u0447\u0438\u0442\u044c
    \u043a\u0430\u0436\u0434\u043e\u0435 \u0441\u043b\u043e\u0432\u043e, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0435
    \u0438\u043c \u0438\u043b\u0438 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438\".
    \u042d\u0442\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0420\u0430\u0441\u0441\u0435\u043b\u0430.\n\n\U0001F310
    \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u0440\u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u043e\u0439
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u041f\u043e\u0441\u043b\u0435
    1900 \u0433\u043e\u0434\u0430 \u041f\u0435\u0430\u043d\u043e \u0432\u0441\u0435 \u0431\u043e\u043b\u044c\u0448\u0435
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0443\u0434\u0435\u043b\u044f\u043b \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \"\u041b\u0430\u0442\u0438\u043d\u043e \u0441\u0438\u043d\u0435
    \u0444\u043b\u0435\u043a\u0441\u0438\u043e\u043d\u0435\" (\u043b\u0430\u0442\u044b\u043d\u044c
    \u0431\u0435\u0437 \u0441\u043b\u043e\u0432\u043e\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439).
    \u042d\u0442\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0438\u043b\u044c\u043d\u044b\u043c,
    \u0447\u0442\u043e \u0432 1908 \u0433\u043e\u0434\u0443 \u043e\u043d \u0434\u0430\u0436\u0435
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435
    \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u0432\u043e\u0435\u0433\u043e \"\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u0430\"
    \u043d\u0430 \u044d\u0442\u043e\u043c \u044f\u0437\u044b\u043a\u0435. \u0412 1910 \u0433\u043e\u0434\u0443
    \u0443\u043c\u0435\u0440\u043b\u0430 \u0435\u0433\u043e \u043c\u0430\u0442\u044c. \u0412
    1925 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u043d\u0430
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0435\u0433\u043e \u0442\u0435\u043a\u0443\u0449\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u043c.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b, \u041f\u0435\u0430\u043d\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u0448\u0438\u0440\u043e\u043a\u0438\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b.
    \u041e\u043d \u0431\u044b\u043b \u0437\u043d\u0430\u043a\u043e\u043c \u0441 \u043c\u043d\u043e\u0433\u0438\u043c\u0438
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0424\u0435\u043b\u0438\u043a\u0441\u0430 \u041a\u043b\u044f\u0439\u043d\u0430,
    \u0438 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0441\u044f \u0441
    \u0413\u043e\u0442\u043b\u043e\u0431\u043e\u043c \u0424\u0440\u0435\u0433\u0435. \u0415\u0433\u043e
    \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442 \u0431\u044b\u043b \u0432\u044b\u0441\u043e\u043a,
    \u0438 \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u043d\u0430\u0433\u0440\u0430\u0434,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u0432\u0430\u043d\u0438\u0435 \u0447\u043b\u0435\u043d\u0430-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u0430
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u0434\u0435\u0438 \u041b\u0438\u043d\u0447\u0435\u0438
    \u0432 1905 \u0433\u043e\u0434\u0443 \u2014 \u0432\u044b\u0441\u0448\u0435\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0418\u0442\u0430\u043b\u0438\u0438.\n\n\U0001F54A\ufe0f
    \u0421\u043c\u0435\u0440\u0442\u044c \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041f\u0435\u0430\u043d\u043e
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 20 \u0430\u043f\u0440\u0435\u043b\u044f
    1932 \u0433\u043e\u0434\u0430 \u0432 \u0422\u0443\u0440\u0438\u043d\u0435. \u041e\u043d
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0434\u043e
    \u0441\u0430\u043c\u043e\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e
    \u0434\u043d\u044f."
  personalLifeEn: "Giuseppe Peano has lived a long and fruitful life devoted entirely to science, his personal history is a journey from the farmer's son to one of the founders of mathematical logic, full of both recognition and misunderstanding by contemporarys.\n\n==Early life==The birth and early years (1858–1876) of Giuseppe Peano was born on 27 August 1858 at Tetto Galant farm in Spinette, a small village near the town of Cuneo in Piedmont, Italy.In 1870 he took Giuseppe to his place of residence to receive a good secondary education, and Peano graduated from the Cavura Lyceum in Turin and entered the University of Turin in 1876.\n\n===Early career=======Early career================Early career==========Peano=============================================================================================================================================================================================================Because of his poor health, he actually began his differential calculation course two years later, and in 1884 he published his first major differential calculation textbook, which was published under the name Jenocki, although it was almost entirely written by Peano himself. Jenokki honestly admitted it by calling it \"A distinguished young man.\" In 1886 he began teaching at the Turin Military Academy.Three years later, in 1889, he received the title of first class professor in this institution, and in 1890 he was finally appointed as an extraordinary professor of differential calculation at the University of Turin, taking over the chair of his teacher, Jenokki.\n\nIn 1887, Giuseppe Peano married Carola Crozio, a daughter of a Turkish artist, Luigi Crozio, known as Madonna Sanctuary of the Sinners, and there was no information on whether the couple had children.\n\n♪ The flower and the relationship with colleagues (1890s – 1900s) This period has become the most fruitful but also the most difficult in Peano's life. \"Formullar\" and teaching problems: In 1891, Peano began his grand project \"Formulario Mathematico\", and he was so interested in this idea that he began using it to teach.This led to a disaster: students could not learn the material in a complex symbolic language; Peano, once a popular lecturer, became an unsavory teacher; dismissal from the Military Academy (1901): his passion for symbolism and \"Formoular\" eventually led to his dismissal from the Military Academy in 1901, as his teaching style ceased to meet the requirements.But he kept his professorship at the university, and his relationship with colleagues: Peano had a rare gift to find mistakes and exceptions in other people's theories, which was often annoying to his colleagues, for example, his conflict with the mathematician Corrado Segra was due precisely to the fact that Peano had pointed to the shortcomings of his work.He is also known for his sharp reviews, such as the book by Giuseppe Veroneze, which he called \"unbelievable things.\"\n\nThe triumph in Paris and the meeting with Russell (1900) was the year 1900, when the Congresses on Philosophy and Mathematics were held in Paris. That was where he met with Bertrand Russell, and Russell was so impressed by the logic of Peano that he interrupted his participation in the Congress and went to the village to study \"the every word he or his disciples wrote.\"This meeting changed the direction of Russell's research.\n\n♪ Interlinguistics and the last years since 1900, Peano has spent more and more time creating an international supportive language, Latino Blue Flexion (latinum without word change), so much that in 1908 he even published the last edition of his \"Formullar\" in that language.In 1925, he moved to the Department of Advanced Mathematics, which was more in line with his current interests, and despite his difficult relationship with some colleagues in the middle of his career, Peano maintained extensive scientific contacts, and was familiar with many German mathematicians, including Felix Klein, and was texting with Gothlobo Fregue.His authority was high, and he was awarded many awards, including the rank of a member of the respondent, the Dei Linchea Academy, in 1905, the highest scientific award in Italy.\n\n==Death==The death of Giuseppe Peano was due to a heart attack on April 20, 1932 in Turin, where he continued teaching at the university until the last day."
  shortBioRu: "\u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041f\u0435\u0430\u043d\u043e (1858\u20131932)
    \u2014 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438
    \u0438 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0438. \u041e\u043d
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c
    \u0430\u043a\u0441\u0438\u043e\u043c \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0430\u0432\u0442\u043e\u0440 \u00ab\u043a\u0440\u0438\u0432\u043e\u0439
    \u041f\u0435\u0430\u043d\u043e\u00bb \u2014 \u043f\u0435\u0440\u0432\u043e\u0439 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0439
    \u043a\u0440\u0438\u0432\u043e\u0439, \u0437\u0430\u043f\u043e\u043b\u043d\u044f\u044e\u0449\u0435\u0439
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442.\n\n\U0001F5D3\ufe0f \u0414\u0435\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0414\u0435\u0442\u0441\u0442\u0432\u043e,
    \u044e\u043d\u043e\u0441\u0442\u044c \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    (1858\u20131880) \u041f\u0435\u0430\u043d\u043e \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    27 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1858 \u0433\u043e\u0434\u0430 \u043d\u0430
    \u0444\u0435\u0440\u043c\u0435 \u0422\u0435\u0442\u0442\u043e-\u0413\u0430\u043b\u0430\u043d\u0442
    \u0432 \u0421\u043f\u0438\u043d\u0435\u0442\u0442\u0435, \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e
    \u043e\u0442 \u0433\u043e\u0440\u043e\u0434\u0430 \u041a\u0443\u043d\u0435\u043e \u0432
    \u041f\u044c\u0435\u043c\u043e\u043d\u0442\u0435, \u0418\u0442\u0430\u043b\u0438\u044f.
    \u0415\u0433\u043e \u0441\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430 \u0444\u0435\u0440\u043c\u0435\u0440\u0441\u043a\u043e\u0439.
    \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432 \u0434\u0435\u0440\u0435\u0432\u0435\u043d\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c \u0432 \u0448\u043a\u043e\u043b\u0435
    \u0432 \u041a\u0443\u043d\u0435\u043e, \u043a\u0443\u0434\u0430 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e
    \u0445\u043e\u0434\u0438\u043b \u043f\u0435\u0448\u043a\u043e\u043c 5 \u043a\u043c. \u0422\u0430\u043b\u0430\u043d\u0442
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430 \u0437\u0430\u043c\u0435\u0442\u0438\u043b
    \u0435\u0433\u043e \u0434\u044f\u0434\u044f, \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a
    \u0438 \u044e\u0440\u0438\u0441\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432
    1870 \u0433\u043e\u0434\u0443 \u0437\u0430\u0431\u0440\u0430\u043b \u0435\u0433\u043e \u0432
    \u0422\u0443\u0440\u0438\u043d \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f.
    \u041f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u043b\u0438\u0446\u0435\u044f
    \u041a\u0430\u0432\u0443\u0440\u0430 \u0432 1876 \u0433\u043e\u0434\u0443 \u041f\u0435\u0430\u043d\u043e
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0412 1880 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0435\u0433\u043e \u0441 \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c,
    \u0437\u0430\u0449\u0438\u0442\u0438\u0432 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041d\u0430\u0447\u0430\u043b\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b (1880\u20131890) \u0421\u0440\u0430\u0437\u0443
    \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u043f\u0443\u0441\u043a\u0430 \u041f\u0435\u0430\u043d\u043e
    \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0432 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0441\u0442\u0430\u0432
    \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u042d\u043d\u0440\u0438\u043a\u043e \u0414'\u041e\u0432\u0438\u0434\u0438\u043e, \u0430
    \u0437\u0430\u0442\u0435\u043c \u0410\u043d\u0434\u0436\u0435\u043b\u043e \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438,
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u043a\u0430\u0444\u0435\u0434\u0440\u044b
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u0418\u0437-\u0437\u0430
    \u0441\u043b\u0430\u0431\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438 \u041f\u0435\u0430\u043d\u043e \u0443\u0436\u0435
    \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0433\u043e\u0434\u0430 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0430\u0447\u0430\u043b \u0432\u0435\u0441\u0442\u0438 \u0435\u0433\u043e \u043a\u0443\u0440\u0441.
    \u0412 1884 \u0433\u043e\u0434\u0443 \u043e\u043d \u0438\u0437\u0434\u0430\u043b \u0441\u0432\u043e\u0439
    \u043f\u0435\u0440\u0432\u044b\u0439 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u044b\u0448\u0435\u043b \u043f\u043e\u0434 \u0438\u043c\u0435\u043d\u0435\u043c \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438.
    \u0412 1887 \u0433\u043e\u0434\u0443 \u041f\u0435\u0430\u043d\u043e \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041a\u0430\u0440\u043e\u043b\u0435 \u041a\u0440\u043e\u0437\u0438\u043e,
    \u0434\u043e\u0447\u0435\u0440\u0438 \u0442\u0443\u0440\u0438\u043d\u0441\u043a\u043e\u0433\u043e
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0430 \u041b\u0443\u0438\u0434\u0436\u0438
    \u041a\u0440\u043e\u0437\u0438\u043e. \u0412 1886 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u043e\u0439 \u0432\u043e\u0435\u043d\u043d\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438, \u0433\u0434\u0435 \u0432 1889 \u0433\u043e\u0434\u0443
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430. \u041f\u0438\u043a
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    (1890\u20131900) \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b
    \u0441\u0430\u043c\u044b\u043c \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c
    \u0432 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0435: \u0410\u043a\u0441\u0438\u043e\u043c\u044b
    \u041f\u0435\u0430\u043d\u043e (1889): \u0412 \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u043e\u043c
    \u043f\u0430\u043c\u0444\u043b\u0435\u0442\u0435 \u00abArithmetices principia, nova methodo
    exposita\u00bb \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0430\u043a\u0441\u0438\u043e\u043c \u0434\u043b\u044f
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u043e\u0441\u0438\u0442
    \u0435\u0433\u043e \u0438\u043c\u044f. \u00ab\u041a\u0440\u0438\u0432\u0430\u044f \u041f\u0435\u0430\u043d\u043e\u00bb
    (1890): \u041e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u043f\u0435\u0440\u0432\u044b\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0439
    \u043a\u0440\u0438\u0432\u043e\u0439, \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0449\u0435\u0439
    \u0447\u0435\u0440\u0435\u0437 \u043a\u0430\u0436\u0434\u0443\u044e \u0442\u043e\u0447\u043a\u0443
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u0435\u0439
    \u0438 \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u043e\u043c. \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0430
    (1890): \u0412 \u0434\u0435\u043a\u0430\u0431\u0440\u0435 1890 \u0433\u043e\u0434\u0430
    \u041f\u0435\u0430\u043d\u043e \u0431\u044b\u043b \u043d\u0430\u043a\u043e\u043d\u0435\u0446
    \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0432 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0437\u0430\u043d\u044f\u0432
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u0414\u0436\u0435\u043d\u043e\u043a\u043a\u0438. \u041d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0436\u0443\u0440\u043d\u0430\u043b\u044b \u0438 \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u00bb:
    \u0412 1891 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0436\u0443\u0440\u043d\u0430\u043b `Rivista di Matematica`. \u0412 \u0442\u043e\u043c
    \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0439
    \u043f\u0440\u043e\u0435\u043a\u0442 \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb (Formulario Mathematico)
    \u2014 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044e, \u0446\u0435\u043b\u044c\u044e
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u044b\u043b\u043e \u0438\u0437\u043b\u043e\u0436\u0438\u0442\u044c
    \u0432\u0441\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043d\u0430
    \u0435\u0433\u043e \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435.
    \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0441 \u0420\u0430\u0441\u0441\u0435\u043b\u043e\u043c
    (1900) \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0436\u0438\u0437\u043d\u0438 \u041f\u0435\u0430\u043d\u043e \u0441\u0442\u0430\u043b
    1900 \u0433\u043e\u0434, \u043a\u043e\u0433\u0434\u0430 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    \u043f\u0440\u043e\u0448\u043b\u0438 \u041f\u0435\u0440\u0432\u0430\u044f \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u044f
    \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f \u043f\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u0438 \u0412\u0442\u043e\u0440\u043e\u0439 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0439
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u041f\u0435\u0430\u043d\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u043c \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435
    \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0434\u043e\u043a\u043b\u0430\u0434
    \u043e \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e\u0441\u0442\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0439
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0442\u0430\u043c \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u0435\u0433\u043e
    \u0441\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u0430\u044f \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0441 \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0434\u043e\u043c \u0420\u0430\u0441\u0441\u0435\u043b\u043e\u043c.
    \u0420\u0430\u0441\u0441\u0435\u043b \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u043e\u0440\u0430\u0436\u0435\u043d \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438 \u041f\u0435\u0430\u043d\u043e, \u0447\u0442\u043e
    \u043f\u0440\u0435\u0440\u0432\u0430\u043b \u0441\u0432\u043e\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435 \u0438 \u0443\u0435\u0445\u0430\u043b
    \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u044e, \u0447\u0442\u043e\u0431\u044b \u00ab\u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e
    \u0438\u0437\u0443\u0447\u0438\u0442\u044c \u043a\u0430\u0436\u0434\u043e\u0435 \u0441\u043b\u043e\u0432\u043e,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0435 \u0438\u043c \u0438\u043b\u0438
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438\u00bb. \u0417\u0430\u043a\u0430\u0442
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0438 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u0438\u043d\u0442\u0435\u0440\u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u043e\u0439
    (1901\u20131932) \u041f\u043e\u0441\u043b\u0435 1900 \u0433\u043e\u0434\u0430 \u0432 \u0436\u0438\u0437\u043d\u0438
    \u041f\u0435\u0430\u043d\u043e \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f:
    \u0423\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u0435 \u0438\u0437 \u0412\u043e\u0435\u043d\u043d\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 (1901): \u0415\u0433\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u043c \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u0430\u00bb
    \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0435\u0433\u043e
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u0435\u0433\u043e \u0443\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u044f \u0438\u0437
    \u0412\u043e\u0435\u043d\u043d\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438.
    \u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u044f\u0437\u044b\u043a
    \u00ab\u041b\u0430\u0442\u0438\u043d\u043e \u0441\u0438\u043d\u0435 \u0444\u043b\u0435\u043a\u0441\u0438\u043e\u043d\u0435\u00bb
    (1903): \u041f\u0435\u0430\u043d\u043e \u043e\u0431\u044a\u044f\u0432\u0438\u043b \u043e
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e
    \u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430, \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u043e\u0439
    \u0432\u0435\u0440\u0441\u0438\u0438 \u043b\u0430\u0442\u044b\u043d\u0438 \u0431\u0435\u0437
    \u0441\u043b\u043e\u0432\u043e\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439. \u0412
    1908 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    `Academia pro Interlingua`, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u043d\u044f\u043b\u0430
    \u0435\u0433\u043e \u044f\u0437\u044b\u043a \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0441\u0432\u043e\u0435\u0433\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e.
    \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u00ab\u0424\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u0430\u00bb
    (1908): \u0411\u044b\u043b\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e
    \u043f\u044f\u0442\u043e\u0435 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435
    \u0438\u0437\u0434\u0430\u043d\u0438\u0435, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0435\u0435
    4200 \u0444\u043e\u0440\u043c\u0443\u043b \u0438 \u0442\u0435\u043e\u0440\u0435\u043c. \u041a
    \u0442\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0440\u043e\u0435\u043a\u0442
    \u0443\u0436\u0435 \u0443\u0441\u0442\u0430\u0440\u0435\u043b, \u043d\u043e \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b: \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043c\u0430\u0442\u0435\u0440\u0438 \u0432 1910 \u0433\u043e\u0434\u0443
    \u041f\u0435\u0430\u043d\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0412
    1925 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u043d\u0430
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u043c. \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435
    \u041f\u0435\u0430\u043d\u043e \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442
    \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430
    20 \u0430\u043f\u0440\u0435\u043b\u044f 1932 \u0433\u043e\u0434\u0430 \u0432 \u0422\u0443\u0440\u0438\u043d\u0435,
