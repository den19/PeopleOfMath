  branchKeys:
  - analysis
  achievementsRu: "\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u042d\u0432\u0430\u043d\u0434\u0436\u0435\u043b\u0438\u0441\u0442\u0430
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u0442\u0440\u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438: \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 (\u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0433\u043e
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f), \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u043a\u0430
    (\u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u0438\u0441\u0442\u0435\u0447\u0435\u043d\u0438\u044f
    \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439) \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    (\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u043c\u0430\u043b\u044b\u0445). \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u2014 \u0441\u0431\u043e\u0440\u043d\u0438\u043a \"Opera geometrica\"
    (1644 \u0433\u043e\u0434), \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0441\u043e\u0431\u0440\u0430\u043d\u044b
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0441\u0435 \u0435\u0433\u043e
    \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b.\n\n\U0001F4DC
    \"Opera geometrica\" \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u042d\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u043a\u043d\u0438\u0433\u0430, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438,
    \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d\u0430 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430
    \u0435\u043c\u0443 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e \u0441\u043b\u0430\u0432\u0443
    \u0438 \u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u043c
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0434\u043b\u044f \u0446\u0435\u043b\u043e\u0433\u043e \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f
    \u0443\u0447\u0435\u043d\u044b\u0445. \u0412 \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438,
    \u044d\u0442\u043e \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0438\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u043e\u0432, \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u044b\u0445
    \u043f\u043e\u0434 \u043e\u0434\u043d\u043e\u0439 \u043e\u0431\u043b\u043e\u0436\u043a\u043e\u0439:
    De sphaera et solidis sphaeralibus (\"\u041e \u0448\u0430\u0440\u0435 \u0438 \u0448\u0430\u0440\u043e\u0432\u0438\u0434\u043d\u044b\u0445
    \u0442\u0435\u043b\u0430\u0445\"): \u043f\u0435\u0440\u0432\u0430\u044f \u0447\u0430\u0441\u0442\u044c,
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0430\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044e
    \u0438\u0434\u0435\u0439 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 \u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0441\u0444\u0435\u0440\u044b \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0444\u0438\u0433\u0443\u0440,
    \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0445 \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432.
    De motu gravium naturaliter descendentium, et proiectorum (\"\u041e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438
    \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0442\u0435\u043b, \u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0445
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u0438 \u043e \u0442\u0435\u043b\u0430\u0445
    \u0431\u0440\u043e\u0448\u0435\u043d\u043d\u044b\u0445\"): \u0432\u0442\u043e\u0440\u0430\u044f
    \u0447\u0430\u0441\u0442\u044c, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0413\u0430\u043b\u0438\u043b\u0435\u044f
    \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0441\u043d\u0430\u0440\u044f\u0434\u043e\u0432
    \u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u043c \u043f\u0430\u0434\u0435\u043d\u0438\u0438.
    De dimensione parabolae, solidique hyperbolici problemata duo (\"\u0414\u0432\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043e\u0431 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438 \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b
    \u0438 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0442\u0435\u043b\u0430\"): \u0442\u0440\u0435\u0442\u044c\u044f, \u0441\u0430\u043c\u0430\u044f
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u044c.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u043e\u0449\u044c \"\u043c\u0435\u0442\u043e\u0434\u0430 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445\",
    \u043e \u0447\u0435\u043c \u043f\u043e\u0439\u0434\u0435\u0442 \u0440\u0435\u0447\u044c
    \u043d\u0438\u0436\u0435.\n\n\U0001F9EE \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0438 \"\u043c\u0435\u0442\u043e\u0434 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445\"
    \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u043e\u0435
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0435\u0433\u043e
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0434\u043b\u044f \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b,
    \u043d\u043e \u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445 \u041a\u0430\u0432\u0430\u043b\u044c\u0435\u0440\u0438,
    \u0441\u0434\u0435\u043b\u0430\u0432 \u0435\u0433\u043e \u0431\u043e\u043b\u0435\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c
    \u0438 \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u044b\u043c \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432.
    \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u0430 \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b:
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u043a\u043d\u0438\u0433\u0435 \u043e\u043d \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442
    21 (!) \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430. \u041f\u0435\u0440\u0432\u044b\u0435 10
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \"\u043c\u0435\u0442\u043e\u0434 \u0438\u0441\u0447\u0435\u0440\u043f\u044b\u0432\u0430\u043d\u0438\u044f\"
    (\u043a\u0430\u043a \u0443 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430), \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    11 \u2014 \u043d\u043e\u0432\u044b\u0439 \u043c\u0435\u0442\u043e\u0434 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445.
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0441\u0432\u043e\u0435\u0433\u043e \u0440\u043e\u0434\u0430
    \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0438\u044f: \"\u0421\u043c\u043e\u0442\u0440\u0438\u0442\u0435,
    \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u0442\u0430\u043a \u0436\u0435 \u043d\u0430\u0434\u0435\u0436\u043d\u043e, \u043a\u0430\u043a
    \u0438 \u0441\u0442\u0430\u0440\u044b\u0439\". \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0442\u0435\u043b\u0430: \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0442\u0435\u043b\u043e, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u043e\u0435
    \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c \u0447\u0430\u0441\u0442\u0438 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u044b
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u044b
    (\u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \"\u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043e\u0441\u0442\u0440\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0439 \u043a\u043b\u0438\u043d\"),
    \u0438\u043c\u0435\u0435\u0442 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u0443\u044e
    \u0434\u043b\u0438\u043d\u0443, \u043d\u043e \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439
    \u043e\u0431\u044a\u0435\u043c, \u0440\u0430\u0432\u043d\u044b\u0439 \u043e\u0431\u044a\u0435\u043c\u0443
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430.
    \u042d\u0442\u043e\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u0441\u0430\u043c \u0441\u0447\u0438\u0442\u0430\u043b \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c,
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0448\u0430\u0433\u043e\u0432
    \u043a \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0426\u0438\u043a\u043b\u043e\u0438\u0434\u0430:
    \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c (\u0438 \u0437\u0434\u0435\u0441\u044c
    \u0438\u0434\u0435\u0442 \u0441\u043f\u043e\u0440 \u0441 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u0435\u043c)
    \u043d\u0430\u0448\u0435\u043b \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u043f\u043e\u0434
    \u0430\u0440\u043a\u043e\u0439 \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u044b. \u041e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u043e\u043d\u0430 \u0440\u043e\u0432\u043d\u043e \u0432 \u0442\u0440\u0438
    \u0440\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0449\u0435\u0433\u043e \u043a\u0440\u0443\u0433\u0430.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u0441\u0430\u043c
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0438 \u041a\u0430\u0432\u0430\u043b\u044c\u0435\u0440\u0438
    \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0438 \u0440\u0435\u0448\u0438\u0442\u044c \u044d\u0442\u0443
    \u0437\u0430\u0434\u0430\u0447\u0443, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0432\u0441\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0438. \u0414\u0440\u0443\u0433\u0438\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f: \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u0432 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0442\u0435\u043b \u0438 \u0440\u0435\u0448\u0438\u043b \u0440\u044f\u0434 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0441\u0432\u043e\u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430.\n\n\u269b\ufe0f
    \u0424\u0438\u0437\u0438\u043a\u0430 \u0438 \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u043a\u0430
    \u041f\u043e\u043c\u0438\u043c\u043e \u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440\u0430,
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u0444\u0438\u0437\u0438\u043a\u0435
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b. \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442
    \u0441 \u0440\u0442\u0443\u0442\u044c\u044e (1643 \u0433.): \u0412 \u044d\u0442\u043e\u043c
    \u043e\u043f\u044b\u0442\u0435 \u043e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440,
    \u043d\u043e \u0438, \u043f\u043e \u0441\u0443\u0442\u0438, \u0441\u043e\u0437\u0434\u0430\u043b
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u043c\u0438\u0440\u0435 \u0432\u0430\u043a\u0443\u0443\u043c
    \u2014 \"\u0442\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438\u0435\u0432\u0443
    \u043f\u0443\u0441\u0442\u043e\u0442\u0443\" \u043d\u0430\u0434 \u0441\u0442\u043e\u043b\u0431\u043e\u043c
    \u0440\u0442\u0443\u0442\u0438. \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u0443\u0441\u0442\u044b\u043c, \u0447\u0442\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u043b\u043e
    \u043c\u043d\u043e\u0433\u043e\u0432\u0435\u043a\u043e\u0432\u043e\u0439 \u0434\u043e\u0433\u043c\u0435,
    \u0447\u0442\u043e \"\u043f\u0440\u0438\u0440\u043e\u0434\u0430 \u0431\u043e\u0438\u0442\u0441\u044f
    \u043f\u0443\u0441\u0442\u043e\u0442\u044b\". \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0432 \u0444\u0438\u0437\u0438\u043a\u0435. \u0424\u043e\u0440\u043c\u0443\u043b\u0430
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438: \u0412 \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u043a\u0435
    \u043e\u043d \u0432\u044b\u0432\u0435\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442
    \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0438\u0441\u0442\u0435\u0447\u0435\u043d\u0438\u044f
    \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0438\u0437 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f
    \u0432 \u0441\u043e\u0441\u0443\u0434\u0435, \u0437\u0430\u043b\u043e\u0436\u0438\u0432
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438."
  achievementsEn: "Evanjist Torricelli's main scientific achievements can be divided into three major areas: fundamental physics (opening atmospheric pressure), hydraulics (drain formula) and mathematics (geometry infinitely small), his main work being the \"Opera geometrica\" (1644), which gathers almost all of his significant works.\n\n♪ \"Opera geometrica\" is the main scientific work ♪ ♪ It's the only book published in Torricelli's life ♪ ♪ but it's the one that brought him European glory ♪ ♪ and became the most important math textbook for a generation of scientists ♪In fact, it is a collection of several tracts combined under the same cover: De sphaera et solidis sphaeralibus, the first part devoted to the development of Archimedes' ideas on sphere geometry and other figures derived from the rotation of correct polygons.De motu gravium naturaliter descentium, et proietorum (\"On the movement of heavy bodies falling naturally and on bodies abandoned\": the second part, in which Torricelli develops and mathematically strictly proves Galileo's position on the movement of shells and free fall. De dmensione parabolae, solidique heyperbolici problemata duo (\"two tasks on measuring parabola and hyperbolic body\": third, the most revolutionary part.It is here that Torricelli demonstrated the power of the \"unsequenced method\", which will be discussed below.\n\n* Mathematics and the \"undissolved method\" is probably the most significant legacy of it for pure mathematics. Torricelli not only used but also popularized the method of indivisible Cavalry, making it more accessible and visible to contemporarys. Parabola Quadratur: In his book he gives 21(!) different evidence to calculate the area of the parabolic segment.The first 10 uses a classic \"drainage method\" (like Archimedes) and the other 11 use a new method of indivisibleness, and it was a sort of demonstration: \"Look, this method works as well as the old one.\"The paradox of the hyperbolic body: Torricelli proved that the body that was derived from the spinning of a part of the hyperbola around the asymptote (so called \"hyperbolic sharp-angle wedge\") has infinite length, but the final volume equal to the volume of a given cylinder. This result, which he himself thought was amazing, had an enormous impact on the mathematicians of the time and was one of the first steps towards understanding infinity in mathematics.Cycloid: He was the first to find the area under the arc of the cycloid (and here he is arguing with the French mathematician Robertval) and found it to be exactly three times the size of the circle. Interestingly, Galileo and Cavalieri themselves failed to accomplish this task despite all the efforts made. Other achievements: Torricelli also worked to identify the centres of gravity of the various bodies and solved a number of other difficult tasks using his method.\n\nIn addition to the barometer, its achievements in physics are fundamental. The experiment with mercury (1643): In this experience, it not only invented the barometer, but also, in effect, created the world's first vacuum, \"Torrichelium void\" above the mercury pillar. It proved that space could be truly empty, which was contrary to the centuries-old doctrine that \"the nature is afraid of voids.\" It was a turning point in physics.The Torricelli formula: In hydraulics, he drew a fundamental formula that determines the velocity of the liquid from the opening in the vessel by laying the foundations of modern hydrodynamics."
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u042d\u0432\u0430\u043d\u0434\u0436\u0435\u043b\u0438\u0441\u0442\u0430
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438, \u0445\u043e\u0442\u044c \u0438
    \u043a\u043e\u0440\u043e\u0442\u043a\u0430\u044f, \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430
    \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432
    \u0438 \u0442\u0435\u0441\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0438\u044f
    \u0441 \u0441\u0443\u0434\u044c\u0431\u0430\u043c\u0438 \u0432\u0435\u043b\u0438\u043a\u0438\u0445
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432. \u0412\u043e\u0442
    \u0435\u0451 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f.\n\n\U0001F9EC
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b (1608\u20131626) \u042d\u0432\u0430\u043d\u0434\u0436\u0435\u043b\u0438\u0441\u0442\u0430
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    15 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1608 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u0424\u0430\u044d\u043d\u0446\u0430 (\u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u044f
    \u0420\u0430\u0432\u0435\u043d\u043d\u0430) \u0432 \u0431\u0435\u0434\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0413\u0430\u0441\u043f\u0430\u0440
    (\u0413\u0430\u0441\u043f\u0430\u0440\u0435) \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438,
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430 \u0442\u0435\u043a\u0441\u0442\u0438\u043b\u044c\u043d\u043e\u0439
    \u0444\u0430\u0431\u0440\u0438\u043a\u0435, \u0430 \u043c\u0430\u0442\u044c, \u041a\u0430\u0442\u0435\u0440\u0438\u043d\u0430
    \u0410\u043d\u0436\u0435\u0442\u0442\u0438, \u0432\u0435\u043b\u0430 \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u043e.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u043a\u0443\u0434\u043d\u044b\u0435
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430, \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438,
    \u0437\u0430\u043c\u0435\u0442\u0438\u0432 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0441\u044b\u043d\u0430, \u043e\u0442\u0434\u0430\u043b\u0438 \u0435\u0433\u043e \u043d\u0430
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043a \u0434\u044f\u0434\u0435 \u042f\u043a\u043e\u0431\u043e
    (\u0414\u0436\u0430\u043a\u043e\u043c\u043e) \u2014 \u0431\u0435\u043d\u0435\u0434\u0438\u043a\u0442\u0438\u043d\u0441\u043a\u043e\u043c\u0443
    \u043c\u043e\u043d\u0430\u0445\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0430\u043b
    \u0435\u043c\u0443 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u0412 1624 \u0433\u043e\u0434\u0443 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0438\u0435\u0437\u0443\u0438\u0442\u0441\u043a\u0438\u0439
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0432 \u0441\u0430\u043c\u043e\u0439 \u0424\u0430\u044d\u043d\u0446\u0435, \u0433\u0434\u0435
    \u0434\u043e 1626 \u0433\u043e\u0434\u0430 \u0438\u0437\u0443\u0447\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e. \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430, \u0434\u044f\u0434\u044f
    \u0440\u0435\u0448\u0438\u043b, \u0447\u0442\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0420\u0438\u043c\u0435, \u043a\u0443\u0434\u0430
    \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u044e\u043d\u043e\u0448\u0443 \u0432
    1627 \u0433\u043e\u0434\u0443.\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430 \u0432 \u0420\u0438\u043c\u0435
    \u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0441 \"\u0433\u0430\u043b\u0438\u043b\u0435\u0435\u0432\u0441\u043a\u0438\u043c
    \u043a\u0440\u0443\u0433\u043e\u043c\" (1627\u20131641) \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0435\u0435\u0437\u0434
    \u0441\u0442\u0430\u043b \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u043c. \u0412 \u0420\u0438\u043c\u0435
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u043f\u043e\u043f\u0430\u043b
    \u043f\u043e\u0434 \u043a\u0440\u044b\u043b\u043e \u0411\u0435\u043d\u0435\u0434\u0435\u0442\u0442\u043e
    \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438 \u2014 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u0421\u0430\u043f\u0438\u0435\u043d\u0446\u0435
    (\u0420\u0438\u043c\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442),
    \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u0443\u0447\u0435\u043d\u0438\u043a\u0430
    \u0438 \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e \u0434\u0440\u0443\u0433\u0430 \u0413\u0430\u043b\u0438\u043b\u0435\u044f.
    \u0412\u0437\u0430\u043c\u0435\u043d \u0437\u0430 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435
    \u0441 1626 \u043f\u043e 1632 \u0433\u043e\u0434 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0435\u043c
    \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438. \u0418\u043c\u0435\u043d\u043d\u043e \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438
    \u043f\u0440\u0438\u0432\u0438\u043b \u0435\u043c\u0443 \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u043d\u043e\u0432\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u0438
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b \u0441 \u0442\u0440\u0443\u0434\u0430\u043c\u0438
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f. \u0412 \u0420\u0438\u043c\u0435 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0441\u0431\u043b\u0438\u0437\u0438\u043b\u0441\u044f \u0441 \u0434\u0432\u0443\u043c\u044f
    \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438
    \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438 \u2014 \u0420\u0430\u0444\u0444\u0430\u044d\u043b\u043b\u043e
    \u041c\u0430\u0434\u0436\u043e\u0442\u0442\u0438 \u0438 \u0410\u043d\u0442\u043e\u043d\u0438\u043e
    \u041d\u0430\u0440\u0434\u0438. \u0421\u0430\u043c \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0441 \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435\u043c \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u044d\u0442\u0443 \u0442\u0440\u043e\u0438\u0446\u0443 \u0441\u0432\u043e\u0438\u043c \"\u0440\u0438\u043c\u0441\u043a\u0438\u043c
    \u0442\u0440\u0438\u0443\u043c\u0432\u0438\u0440\u0430\u0442\u043e\u043c\". \u0422\u0430\u043a\u0436\u0435
    \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0441\u044f \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0411\u043e\u043d\u0430\u0432\u0435\u043d\u0442\u0443\u0440\u043e\u0439 \u041a\u0430\u0432\u0430\u043b\u044c\u0435\u0440\u0438,
    \u0447\u0435\u0439 \"\u043c\u0435\u0442\u043e\u0434 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445\"
    \u043f\u043e\u0437\u0436\u0435 \u043b\u0451\u0433 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439. \u0412 1632 \u0433\u043e\u0434\u0443,
    \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0432 \"\u0414\u0438\u0430\u043b\u043e\u0433
    \u043e \u0434\u0432\u0443\u0445 \u0433\u043b\u0430\u0432\u043d\u0435\u0439\u0448\u0438\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445 \u043c\u0438\u0440\u0430\" \u0413\u0430\u043b\u0438\u043b\u0435\u044f,
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0432 \u043f\u0438\u0441\u044c\u043c\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0441\u044f, \u0447\u0442\u043e \u0441\u0442\u0430\u043b
    \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u043c \u043a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430\u043d\u0446\u0435\u043c.
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u043c\u0435\u043b\u043e\u0435 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u043e\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0435\u0439
    \u0432 1633 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0441\u0442\u0430\u043b \u0431\u043e\u043b\u0435\u0435
    \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u0435\u043d \u0432 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445
    \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u044f\u0445.\n\n\U0001F91D
    \u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0413\u0430\u043b\u0438\u043b\u0435\u0435\u043c
    \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u0410\u0440\u0447\u0435\u0442\u0440\u0438
    (1641\u20131642) \u041e\u043a\u043e\u043b\u043e 1640 \u0433\u043e\u0434\u0430 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \"Trattato del moto\" (\"\u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438\"). \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438,
    \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0451\u043d\u043d\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439,
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u0435\u0451 \u0413\u0430\u043b\u0438\u043b\u0435\u044e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043a \u0442\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0443\u0436\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u043b\u0435\u043f
    \u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u043f\u043e\u0434 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u043c
    \u0430\u0440\u0435\u0441\u0442\u043e\u043c \u0432 \u0441\u0432\u043e\u0435\u0439 \u0432\u0438\u043b\u043b\u0435
    \u0432 \u0410\u0440\u0447\u0435\u0442\u0440\u0438. \u0423 \u0413\u0430\u043b\u0438\u043b\u0435\u044f
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u0439 \u2014
    \u043e\u043d \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u043a \u0441\u0435\u0431\u0435.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0442\u043e\u0442 \u0441\u043c\u043e\u0433 \u043f\u0440\u0438\u0435\u0445\u0430\u0442\u044c
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1641 \u0433\u043e\u0434\u0430. \u0418\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0430\u0441\u044c
    \u0432\u0441\u0435\u0433\u043e \u0442\u0440\u0438 \u043c\u0435\u0441\u044f\u0446\u0430,
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438 \u0413\u0430\u043b\u0438\u043b\u0435\u044f
    8 \u044f\u043d\u0432\u0430\u0440\u044f 1642 \u0433\u043e\u0434\u0430. \u0417\u0430 \u044d\u0442\u043e
    \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0441\u0442\u0430\u043b \u0435\u0433\u043e \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0451\u043c
    \u0438 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c, \u043f\u043e\u043c\u043e\u0433\u0430\u044f
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u043d\u0430\u0434 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u2014 \"\u0411\u0435\u0441\u0435\u0434\u044b \u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430...\".\n\n\U0001F3DB\ufe0f
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0438 \u0440\u0430\u0441\u0446\u0432\u0435\u0442
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b (1642\u20131644) \u041f\u043e\u0441\u043b\u0435
    \u043a\u043e\u043d\u0447\u0438\u043d\u044b \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0432\u0435\u043b\u0438\u043a\u0438\u0439
    \u0433\u0435\u0440\u0446\u043e\u0433 \u0422\u043e\u0441\u043a\u0430\u043d\u0441\u043a\u0438\u0439
    \u0424\u0435\u0440\u0434\u0438\u043d\u0430\u043d\u0434 II \u041c\u0435\u0434\u0438\u0447\u0438,
    \u0432\u044b\u0441\u043e\u043a\u043e \u0446\u0435\u043d\u0438\u0432\u0448\u0438\u0439 \u0437\u0430\u0441\u043b\u0443\u0433\u0438
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438, \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b
    \u0435\u0433\u043e \u043d\u0430 \u043c\u0435\u0441\u0442\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u044f
    \u2014 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0433\u0435\u0440\u0446\u043e\u0433\u0430 \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0424\u043b\u043e\u0440\u0435\u043d\u0442\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 (\u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438).
    \u042d\u0442\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u0430\u043b\u043e
    \u0435\u043c\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0443\u044e
    \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u043d\u043e \u0438
    \u0441\u0432\u043e\u0431\u043e\u0434\u0443 \u0434\u043b\u044f \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u0439. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u0434\u0435\u043b\u0430\u0435\u0442
    \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f:
    1643 \u0433\u043e\u0434: \u041f\u043e \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a
    \u0412\u0438\u043d\u0447\u0435\u043d\u0446\u043e \u0412\u0438\u0432\u0438\u0430\u043d\u0438
    \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 \u0441 \u0440\u0442\u0443\u0442\u044c\u044e,
    \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0441\u043e\u0437\u0434\u0430\u0451\u0442\u0441\u044f \u043f\u0435\u0440\u0432\u044b\u0439
    \u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440 \u0438 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0433\u043e
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f. 1644 \u0433\u043e\u0434: \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442 \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u043f\u0440\u0438\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u2014 \"Opera geometrica\" (\"\u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0440\u0443\u0434\u044b\"), \u0433\u0434\u0435 \u0438\u0437\u043b\u0430\u0433\u0430\u0435\u0442
    \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435,
    \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u043a\u0435 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.\n\n\u2694\ufe0f
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u041d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0431\u044b\u043b
    \u043d\u0435 \u0431\u0435\u0437\u043e\u0431\u043b\u0430\u0447\u043d\u044b\u043c. \u0415\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e
    \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u044b
    \u043f\u0440\u0438\u0432\u0435\u043b\u0430 \u043a \u043e\u0441\u0442\u0440\u043e\u0439 \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0435
    \u0441 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0416\u0438\u043b\u0435\u043c \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u0435\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0435\u0433\u043e
    \u0432 \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432 \u0441\u0447\u0438\u0442\u0430\u044e\u0442,
    \u0447\u0442\u043e \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u043f\u0440\u0438\u0448\u0451\u043b
    \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e,
    \u044d\u0442\u043e\u0442 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u043e\u043c\u0440\u0430\u0447\u0438\u043b
    \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b.
    \u0421\u0430\u043c \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438, \u043f\u043e
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432,
    \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0441\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, \u043d\u043e
    \u0438 \u0440\u0435\u0434\u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u0431\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u0441\u0442\u0432\u043e\u043c. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u0435\u0433\u043e \u0444\u0440\u0430\u0437\u0430 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e
    \u043e\u043d \u0441\u043e\u0436\u0430\u043b\u0435\u0435\u0442, \u0447\u0442\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0433\u043e
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u0434\u0435\u043b\u0430\u043b \u043e\u043d,
    \u0430 \u043d\u0435 \u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u0413\u0430\u043b\u0438\u043b\u0435\u0439.\n\n\u26b0\ufe0f
    \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u042d\u0432\u0430\u043d\u0434\u0436\u0435\u043b\u0438\u0441\u0442\u0430 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0441\u043a\u043e\u0440\u043e\u043f\u043e\u0441\u0442\u0438\u0436\u043d\u043e \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432\u043e \u0424\u043b\u043e\u0440\u0435\u043d\u0446\u0438\u0438 25 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1647 \u0433\u043e\u0434\u0430, \u0447\u0435\u0440\u0435\u0437 10 \u0434\u043d\u0435\u0439
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0432\u043e\u0435\u0433\u043e 39-\u043b\u0435\u0442\u0438\u044f,
    \u043e\u0442 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438
    (\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0431\u0440\u044e\u0448\u043d\u043e\u0433\u043e \u0442\u0438\u0444\u0430). \u041e\u043d
    \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u0432 \u0431\u0430\u0437\u0438\u043b\u0438\u043a\u0435
    \u0421\u0430\u043d-\u041b\u043e\u0440\u0435\u043d\u0446\u043e \u0432\u043e \u0424\u043b\u043e\u0440\u0435\u043d\u0446\u0438\u0438.
    \u0412\u0441\u0451 \u0441\u0432\u043e\u0451 \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e
    \u043e\u043d \u0437\u0430\u0432\u0435\u0449\u0430\u043b \u043f\u0440\u0438\u0451\u043c\u043d\u043e\u043c\u0443
    \u0441\u044b\u043d\u0443 \u0410\u043b\u0435\u0441\u0441\u0430\u043d\u0434\u0440\u043e. \u0427\u0435\u0440\u0435\u0437
    68 \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    \u0432 1715 \u0433\u043e\u0434\u0443, \u0432\u044b\u0448\u043b\u043e \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0435\u0433\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043b\u0435\u043a\u0446\u0438\u0439, \u043d\u0430 \u0444\u0440\u043e\u043d\u0442\u0438\u0441\u043f\u0438\u0441\u0435
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u044b\u043b\u0430 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0430
    \u0430\u043d\u0430\u0433\u0440\u0430\u043c\u043c\u0430: \"En virescit Galileus alter\" (\"\u0417\u0434\u0435\u0441\u044c
    \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430\u0435\u0442 \u0434\u0440\u0443\u0433\u043e\u0439
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439\"), \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0432\u044b\u0441\u0448\u0438\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435\u043c
    \u0435\u0433\u043e \u0437\u0430\u0441\u043b\u0443\u0433 \u043f\u043e\u0442\u043e\u043c\u043a\u0430\u043c\u0438."
  personalLifeEn: "Evangeist Torricelli's life, though short, was full of dramatic twists and close interlinkage with the great contemporarys, and this is her detailed timeline.\n\n==Early life==Evangelist Torricelli was born on October 15, 1608, in the town of Faenza (Ravenna province) in a poor family, and his father, Gaspar (Gaspare), Torricelli, worked in a textile factory, while his mother, Katerina Anjetti, ran a household, and despite the meagre means, his parents, after seeing his son's abilities, gave him up to his uncle Jacobo (Jacomo), a Benedictine monk who gave him primary education.In 1624, Torricelli entered Jesuit College, probably in Faenza, where he studied mathematics and philosophy until 1626, and after his father's death, the uncle decided that further education was possible only in Rome, where he sent a young man to Rome in 1627.\n\n▪ Studying in Rome and familiarizing with the \"Galileev circle\" (1627 - 1641) The move became decisive. In Rome, Torricelli was placed under the wing of Benedetto Castelli, a professor of mathematics at Sapienza University, an outstanding student and a close friend of Galileo, and in exchange for his studies from 1626 to 1632, Torricelli worked as Castelli's secretary, and it was Castelli who gave him the love of a new mechanic and introduced him to Galileo's work.In Rome, Torricelli became close to two other students, Raffaallo Majotti and Antonio Nardi, who themselves, with admiration, called the Trinity their \"Rome triumvirate.\" Also during this period, Torricelli became a friend of Mathematician Bonaventura Cavalieri, whose \"mode of the indivisible\" later formed the basis of his own geometric discoveries.In 1632, after reading Galileo's \"Dialogue of the Two Great Systems of the World\", Torricelli admitted in a letter that he had become a convinced copernican, a bold statement, especially after Galileo's condemnation by the Inquisition in 1633, and then Torricelli became more cautious in public discourse.\n\n~ Meeting with Galileo and working in Archerti (1641–1642) Around 1640, Torricelli wrote his first significant scientific tract, \"Trattato del moto\", Castelli, impressed by the work, sent it to Galileo, who was already completely blind and under house arrest in his villa in Archerti. Galileo had no doubt — he immediately invited Torricelli to his place of residence.However, he was not able to arrive until early October 1641, and their joint work lasted only three months, until Galileo's death on 8 January 1642, during which time Torricelli became his secretary and assistant, helping with the latest work, \"Besedes and Mathematical Evidence\".\n\nThe recognition and growth of his career (1642 - 1644), after the death of his teacher, the Grand Duke of Tuscany Ferdinand II Medici, who had highly valued Torricelli's merit, appointed him to the place of Galileo, the Duke's court mathematician and Professor of Mathematics at the University of Florence (academia), which gave him not only financial stability but also freedom for scientific research.It is during this period that he makes his main discoveries: 1643: At Torricelli's initiative his student Vincenzo Viviani is conducting a famous experiment with mercury, which creates the first barometer and proves the existence of atmospheric pressure. 1644: Torricelli publishes his main life-time work, \"Opera geometrica\" (\"Geometric Works\"), which describes his work in mechanics, hydrovlycs and geometry.\n\nHis work in calculating the area of the cycloid has led to intense controversy with French mathematician Gille Robertval, who accused him of plagiarizing, even though most historians believe Torricelli has come to his decision independently, this conflict has clouded him in recent years.Torricelli himself, according to the modern - day people, was not only genius but also rare modesty and nobleness, but he was known for his saying that he regretted that he had made a great discovery of atmospheric pressure, not his teacher Galileo.\n\n==Death and legacy==Evangelist Torricelli died quickly in Florence on October 25, 1647, 10 days after his 39th birthday, from severe fever (probably typhoid typhoid) and was buried in San Lorenzo Basilica in Florence.After 68 years of his death, in 1715, a collection of his academic lectures was published, and an anagram was posted on the front page: \"En viescit Galileo alter\" (\"The other Galileo is flourishing here\"), which was the ultimate recognition of his achievements by his descendants."
  shortBioRu: "\u042d\u0432\u0430\u043d\u0434\u0436\u0435\u043b\u0438\u0441\u0442\u0430 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    (1608\u20131647) \u2014 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0438 \u0444\u0438\u0437\u0438\u043a,
    \u0443\u0447\u0435\u043d\u0438\u043a \u0413\u0430\u043b\u0438\u043b\u0435\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u043e\u0448\u0435\u043b \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043a\u0430\u043a
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u044c \u0440\u0442\u0443\u0442\u043d\u043e\u0433\u043e
    \u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440\u0430 \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u0434\u043e\u043a\u0430\u0437\u0430\u0432\u0448\u0438\u0439 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0433\u043e \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c, \u0445\u043e\u0442\u044c \u0438 \u043a\u043e\u0440\u043e\u0442\u043a\u0430\u044f,
    \u0431\u044b\u043b\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u0430
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u043c\u0438.\n\n\U0001F9EC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    15 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1608 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u0424\u0430\u044d\u043d\u0446\u0430 (\u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u044f
    \u0420\u0430\u0432\u0435\u043d\u043d\u0430) \u0432 \u043e\u0447\u0435\u043d\u044c \u0431\u0435\u0434\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0413\u0430\u0441\u043f\u0430\u0440,
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430 \u0442\u0435\u043a\u0441\u0442\u0438\u043b\u044c\u043d\u043e\u0439
    \u0444\u0430\u0431\u0440\u0438\u043a\u0435, \u0430 \u043c\u0430\u0442\u044c, \u041a\u0430\u0442\u0435\u0440\u0438\u043d\u0430
    \u0410\u043d\u0436\u0435\u0442\u0442\u0438, \u0432\u0435\u043b\u0430 \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u043e.
    \u0417\u0430\u043c\u0435\u0442\u0438\u0432 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0441\u044b\u043d\u0430,
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0438
    \u0435\u0433\u043e \u043d\u0430 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043a
    \u0434\u044f\u0434\u0435, \u0431\u0435\u043d\u0435\u0434\u0438\u043a\u0442\u0438\u043d\u0441\u043a\u043e\u043c\u0443
    \u043c\u043e\u043d\u0430\u0445\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0430\u043b
    \u0435\u043c\u0443 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u0412 1624 \u0433\u043e\u0434\u0443 \u044e\u043d\u044b\u0439 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0438\u0435\u0437\u0443\u0438\u0442\u0441\u043a\u0438\u0439
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436, \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e.
    \u0412 1627 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430, \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0420\u0438\u043c, \u0447\u0442\u043e\u0431\u044b \u0443\u0447\u0438\u0442\u044c\u0441\u044f
    \u0443 \u0411\u0435\u043d\u0435\u0434\u0435\u0442\u0442\u043e \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438
    \u2014 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0421\u0430\u043f\u0438\u0435\u043d\u0446\u0435, \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e
    \u0434\u0440\u0443\u0433\u0430 \u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0430 \u0413\u0430\u043b\u0438\u043b\u0435\u044f.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c: \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043f\u0440\u0438\u043e\u0431\u0449\u0438\u043b\u0441\u044f \u043a \u043d\u043e\u0432\u044b\u043c
    \u0438\u0434\u0435\u044f\u043c \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0438 \u0441\u0442\u0430\u043b
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
