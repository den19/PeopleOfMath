    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d, \u0447\u0442\u043e \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e
