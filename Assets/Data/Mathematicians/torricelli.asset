    \u043e\u043d \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u0413\u0430\u043b\u0438\u043b\u0435\u044e
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u043d\u0430\u0434 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u00ab\u0411\u0435\u0441\u0435\u0434\u044b \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430...\u00bb
