    \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438 \u2014 \u0420\u0430\u0444\u0444\u0430\u044d\u043b\u043b\u043e
    \u041c\u0430\u0434\u0436\u043e\u0442\u0442\u0438 \u0438 \u0410\u043d\u0442\u043e\u043d\u0438\u043e
    \u041d\u0430\u0440\u0434\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0432 \u0448\u0443\u0442\u043a\u0443 \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0441\u0432\u043e\u0438\u043c
    \u00ab\u0440\u0438\u043c\u0441\u043a\u0438\u043c \u0442\u0440\u0438\u0443\u043c\u0432\u0438\u0440\u0430\u0442\u043e\u043c\u00bb.\n\n\U0001F9D1\u200d\U0001F3EB
    \u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u043a\u0443\u043c\u0438\u0440\u043e\u043c
