    \u042D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0441\u0442\u0430\u043B\u043E
    \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0431\u0435\u0441\u0446\u0435\u043D\u043D\u043E\u0439
