    \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0441\u0432\u043e\u0438\u043c \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0424\u043b\u043e\u0440\u0435\u043d\u0442\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0422\u0430\u043a,
    \u0432 34 \u0433\u043e\u0434\u0430, \u043e\u043d \u0437\u0430\u043d\u044f\u043b \u043c\u0435\u0441\u0442\u043e
    \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f.\n\n\U0001F52C
    \u0413\u043b\u0430\u0432\u043d\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
