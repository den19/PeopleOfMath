    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0422\u0430\u043A,
    \u0432 34 \u0433\u043E\u0434\u0430, \u043E\u043D \u0437\u0430\u043D\u044F\u043B
    \u043C\u0435\u0441\u0442\u043E \u0441\u0432\u043E\u0435\u0433\u043E \u0443\u0447\u0438\u0442\u0435\u043B\u044F. 
    ### \U0001F52C \u0413\u043B\u0430\u0432\u043D\u044B\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F 
    \u041D\u0430\u0443\u0447\u043D\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435
    \u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438 \u043E\u0433\u0440\u043E\u043C\u043D\u043E,
    \u043D\u043E \u0441\u0430\u043C\u044B\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435
    \u0435\u0433\u043E \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u043B\u0435\u0436\u0430\u0442 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0444\u0438\u0437\u0438\u043A\u0438:  *   **\u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u043E\u0435
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438 \u0431\u0430\u0440\u043E\u043C\u0435\u0442\u0440:**
    \u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435
    \u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438 \u0431\u044B\u043B\u043E
    \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u0437\u0430\u0433\u0430\u0434\u043A\u043E\u0439,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0435 \u043C\u043E\u0433 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C
    \u0434\u0430\u0436\u0435 \u0413\u0430\u043B\u0438\u043B\u0435\u0439: \u043F\u043E\u0447\u0435\u043C\u0443
    \u0432\u043E\u0434\u0430 \u0432 \u043D\u0430\u0441\u043E\u0441\u0430\u0445 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0443
    \u043E\u043A\u043E\u043B\u043E 10 \u043C\u0435\u0442\u0440\u043E\u0432. \u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438
    \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0438\u0437-\u0437\u0430 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u043E\u0437\u0434\u0443\u0445\u0430,
    \u0430 \u043D\u0435 \u0438\u0437-\u0437\u0430 \xAB\u0431\u043E\u044F\u0437\u043D\u0438
    \u043F\u0443\u0441\u0442\u043E\u0442\u044B\xBB (horror vacui) \u0410\u0440\u0438\u0441\u0442\u043E\u0442\u0435\u043B\u044F.
    \u041E\u043D \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u043B,
    \u0447\u0442\u043E \u043C\u044B \u0436\u0438\u0432\u0435\u043C \xAB\u043D\u0430
    \u0434\u043D\u0435 \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u043E\u0433\u043E
    \u043E\u043A\u0435\u0430\u043D\u0430\xBB \u0438 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
    \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435.
    \u0427\u0442\u043E\u0431\u044B \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u044D\u0442\u043E, \u0432 1643 \u0433\u043E\u0434\u0443 \u0435\u0433\u043E \u0443\u0447\u0435\u043D\u0438\u043A
    **\u0412\u0438\u043D\u0447\u0435\u043D\u0446\u043E \u0412\u0438\u0432\u0438\u0430\u043D\u0438**
    (\u043F\u043E \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435 \u0443\u0447\u0438\u0442\u0435\u043B\u044F)
    \u043F\u0440\u043E\u0432\u0435\u043B \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u043E\u043F\u044B\u0442: \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u0443\u044E
    \u0442\u0440\u0443\u0431\u043A\u0443, \u0437\u0430\u043F\u0430\u044F\u043D\u043D\u0443\u044E
    \u0441 \u043E\u0434\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0446\u0430, \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0438
    \u0440\u0442\u0443\u0442\u044C\u044E \u0438, \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u0432,
    \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0432 \u0447\u0430\u0448\u0443
    \u0441 \u0440\u0442\u0443\u0442\u044C\u044E. \u0421\u0442\u043E\u043B\u0431 \u0440\u0442\u0443\u0442\u0438
    \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F \u0434\u043E \u043E\u0442\u043C\u0435\u0442\u043A\u0438
    \u043E\u043A\u043E\u043B\u043E 76 \u0441\u043C, \u0430 \u043D\u0430\u0434 \u043D\u0438\u043C
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C \u043F\u0443\u0441\u0442\u043E\u0442\u0430,
    \u043D\u0430\u0437\u0432\u0430\u043D\u043D\u0430\u044F \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    **\xAB\u0442\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438\u0435\u0432\u043E\u0439
    \u043F\u0443\u0441\u0442\u043E\u0442\u043E\u0439\xBB**. \u0422\u0430\u043A \u0431\u044B\u043B
    \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D \u043F\u0435\u0440\u0432\u044B\u0439
    \u0440\u0442\u0443\u0442\u043D\u044B\u0439 \u0431\u0430\u0440\u043E\u043C\u0435\u0442\u0440,
    \u0438 \u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u043C
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B, \u0447\u0442\u043E \u0432\u044B\u0441\u043E\u0442\u0430
    \u0441\u0442\u043E\u043B\u0431\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0441 \u043F\u043E\u0433\u043E\u0434\u043E\u0439, \u0442\u043E \u0435\u0441\u0442\u044C
    \u0441 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u044B\u043C \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C. 
    *   **\u0413\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u0430:** \u041E\u043D
    \u0437\u0430\u043B\u043E\u0436\u0438\u043B \u043E\u0441\u043D\u043E\u0432\u044B
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u0438,
    \u0432\u044B\u0432\u0435\u0434\u044F \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0443\u044E
    **\u0444\u043E\u0440\u043C\u0443\u043B\u0443 \u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438**,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u044F
    \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438 \u0438\u0437 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F
    \u0432 \u0441\u043E\u0441\u0443\u0434\u0435. \u0412 \u0441\u0432\u043E\u0435\u0439
    \u0440\u0430\u0431\u043E\u0442\u0435 \u043E\u043D \u0442\u0430\u043A\u0436\u0435
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B, \u0447\u0442\u043E \u0441\u0442\u0440\u0443\u044F
    \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u043F\u0430\u0440\u0430\u0431\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443.  *   **\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430:**
    \u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438 \u0431\u044B\u043B
    \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C.
    \u041E\u043D \u0440\u0430\u0437\u0432\u0438\u043B **\xAB\u043C\u0435\u0442\u043E\u0434
    \u043D\u0435\u0434\u0435\u043B\u0438\u043C\u044B\u0445\xBB** \u041A\u0430\u0432\u0430\u043B\u044C\u0435\u0440\u0438
    \u0438 \u0441 \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0440\u0435\u0448\u0438\u043B
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0441\u043B\u043E\u0436\u043D\u044B\u0445
    \u0437\u0430\u0434\u0430\u0447, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043D\u0430\u0448\u0435\u043B \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u0438
    \u0446\u0435\u043D\u0442\u0440 \u0442\u044F\u0436\u0435\u0441\u0442\u0438 \u0446\u0438\u043A\u043B\u043E\u0438\u0434\u044B.
    \u041E\u043D \u0442\u0430\u043A\u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u043B
    \u043F\u043E\u043D\u044F\u0442\u0438\u0435 \u043E\u0433\u0438\u0431\u0430\u044E\u0449\u0435\u0439
    \u043A\u0440\u0438\u0432\u043E\u0439 \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u0432 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438 **\u0442\u043E\u0447\u043A\u043E\u0439
    \u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438** \u2014 \u0442\u043E\u0447\u043A\u043E\u0439
    \u0432 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0435,
    \u0441\u0443\u043C\u043C\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0439
    \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0434\u043E \u0432\u0435\u0440\u0448\u0438\u043D
    \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0430.  ### \U0001F52D
    \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u0438 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435  \u041F\u043E\u043C\u0438\u043C\u043E
    \u0447\u0438\u0441\u0442\u043E\u0439 \u043D\u0430\u0443\u043A\u0438, \u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438
    \u0431\u044B\u043B \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u043C\u0441\u044F
    \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u043C-\u043E\u043F\u0442\u0438\u043A\u043E\u043C.
    \u041E\u043D \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u043B
    \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u043B\u0438\u043D\u0437\u044B \u0434\u043B\u044F \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u043E\u0432
