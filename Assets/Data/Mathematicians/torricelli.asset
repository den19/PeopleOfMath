    \u0410\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0438 \u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440: \u0413\u043b\u0430\u0432\u043d\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0431\u044b\u043b\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043e \u0441 \u0437\u0430\u0433\u0430\u0434\u043a\u043e\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0435 \u043c\u043e\u0433 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c
    \u0434\u0430\u0436\u0435 \u0413\u0430\u043b\u0438\u043b\u0435\u0439: \u043f\u043e\u0447\u0435\u043c\u0443
    \u0432\u043e\u0434\u0430 \u0432 \u043d\u0430\u0441\u043e\u0441\u0430\u0445 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0432\u044b\u0441\u043e\u0442\u0443 \u043e\u043a\u043e\u043b\u043e
    10 \u043c\u0435\u0442\u0440\u043e\u0432. \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u044d\u0442\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442
    \u0438\u0437-\u0437\u0430 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u043e\u0437\u0434\u0443\u0445\u0430,
    \u0430 \u043d\u0435 \u0438\u0437-\u0437\u0430 \u00ab\u0431\u043e\u044f\u0437\u043d\u0438
    \u043f\u0443\u0441\u0442\u043e\u0442\u044b\u00bb (horror vacui) \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044f.
    \u041e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b, \u0447\u0442\u043e
    \u043c\u044b \u0436\u0438\u0432\u0435\u043c \u00ab\u043d\u0430 \u0434\u043d\u0435 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0433\u043e
    \u043e\u043a\u0435\u0430\u043d\u0430\u00bb \u0438 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430
    \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435.
    \u0427\u0442\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u044d\u0442\u043e,
    \u0432 1643 \u0433\u043e\u0434\u0443 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a
    \u0412\u0438\u043d\u0447\u0435\u043d\u0446\u043e \u0412\u0438\u0432\u0438\u0430\u043d\u0438
    (\u043f\u043e \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435 \u0443\u0447\u0438\u0442\u0435\u043b\u044f)
    \u043f\u0440\u043e\u0432\u0435\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043e\u043f\u044b\u0442: \u0441\u0442\u0435\u043a\u043b\u044f\u043d\u043d\u0443\u044e \u0442\u0440\u0443\u0431\u043a\u0443,
    \u0437\u0430\u043f\u0430\u044f\u043d\u043d\u0443\u044e \u0441 \u043e\u0434\u043d\u043e\u0433\u043e
    \u043a\u043e\u043d\u0446\u0430, \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u043b\u0438 \u0440\u0442\u0443\u0442\u044c\u044e
    \u0438, \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0432, \u043e\u043f\u0443\u0441\u0442\u0438\u043b\u0438
    \u0432 \u0447\u0430\u0448\u0443 \u0441 \u0440\u0442\u0443\u0442\u044c\u044e. \u0421\u0442\u043e\u043b\u0431
    \u0440\u0442\u0443\u0442\u0438 \u043e\u043f\u0443\u0441\u0442\u0438\u043b\u0441\u044f \u0434\u043e
    \u043e\u0442\u043c\u0435\u0442\u043a\u0438 \u043e\u043a\u043e\u043b\u043e 76 \u0441\u043c,
    \u0430 \u043d\u0430\u0434 \u043d\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u043f\u0443\u0441\u0442\u043e\u0442\u0430, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u00ab\u0442\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438\u0435\u0432\u043e\u0439
    \u043f\u0443\u0441\u0442\u043e\u0442\u043e\u0439\u00bb. \u0422\u0430\u043a \u0431\u044b\u043b
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d \u043f\u0435\u0440\u0432\u044b\u0439
    \u0440\u0442\u0443\u0442\u043d\u044b\u0439 \u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440,
    \u0438 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u043f\u0435\u0440\u0432\u044b\u043c
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b, \u0447\u0442\u043e \u0432\u044b\u0441\u043e\u0442\u0430
    \u0441\u0442\u043e\u043b\u0431\u0430 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0441
    \u043f\u043e\u0433\u043e\u0434\u043e\u0439, \u0442\u043e \u0435\u0441\u0442\u044c \u0441
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u044b\u043c \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c.
    \u0413\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u043a\u0430: \u041e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u043a\u0438, \u0432\u044b\u0432\u0435\u0434\u044f
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c
    \u0438\u0441\u0442\u0435\u0447\u0435\u043d\u0438\u044f \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438
    \u0438\u0437 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f \u0432 \u0441\u043e\u0441\u0443\u0434\u0435.
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b, \u0447\u0442\u043e
    \u0441\u0442\u0440\u0443\u044f \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442
    \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0444\u043e\u0440\u043c\u0443.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0431\u044b\u043b \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c.
    \u041e\u043d \u0440\u0430\u0437\u0432\u0438\u043b \u00ab\u043c\u0435\u0442\u043e\u0434 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445\u00bb
    \u041a\u0430\u0432\u0430\u043b\u044c\u0435\u0440\u0438 \u0438 \u0441 \u0435\u0433\u043e
    \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0440\u0435\u0448\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043d\u0430\u0448\u0435\u043b \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u0438 \u0446\u0435\u043d\u0442\u0440
    \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u044b.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u043a\u0440\u044b\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u043e\u0433\u0438\u0431\u0430\u044e\u0449\u0435\u0439 \u043a\u0440\u0438\u0432\u043e\u0439
    \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0442\u043e\u0447\u043a\u043e\u0439 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u2014 \u0442\u043e\u0447\u043a\u043e\u0439 \u0432 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0435,
    \u0441\u0443\u043c\u043c\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0439
    \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0434\u043e \u0432\u0435\u0440\u0448\u0438\u043d
    \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430.\n\n\U0001F52D \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041f\u043e\u043c\u0438\u043c\u043e
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u0438, \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043c-\u043e\u043f\u0442\u0438\u043a\u043e\u043c.
    \u041e\u043d \u0438\u0437\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u043b \u0432\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u043b\u0438\u043d\u0437\u044b \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432
    \u0438 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u044b,
    \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u0438\u0437 \u043e\u0434\u043d\u043e\u0439
    \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u043e\u0439 \u043b\u0438\u043d\u0437\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u0432\u044b\u043f\u043b\u0430\u0432\u043b\u044f\u043b \u0438\u0437 \u043a\u0430\u043f\u043b\u0438
    \u0441\u0442\u0435\u043a\u043b\u0430. \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0441\u043a\u043e\u0440\u043e\u043f\u043e\u0441\u0442\u0438\u0436\u043d\u043e \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    25 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1647 \u0433\u043e\u0434\u0430 \u0432\u043e
    \u0424\u043b\u043e\u0440\u0435\u043d\u0446\u0438\u0438, \u0432\u0441\u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437
    10 \u0434\u043d\u0435\u0439 \u043f\u043e\u0441\u043b\u0435 \u0441\u0432\u043e\u0435\u0433\u043e
    39-\u043b\u0435\u0442\u0438\u044f. \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0441\u0442\u0430\u043b \u0431\u0440\u044e\u0448\u043d\u043e\u0439
    \u0442\u0438\u0444. \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043e\u043d
    \u0432 \u0431\u0430\u0437\u0438\u043b\u0438\u043a\u0435 \u0421\u0430\u043d-\u041b\u043e\u0440\u0435\u043d\u0446\u043e.
    \u0412 \u043f\u0430\u043c\u044f\u0442\u044c \u043e \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u0445
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u0430
    \u0432\u043d\u0435\u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u0435\u0434\u0438\u043d\u0438\u0446\u0430
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u2014 \u0442\u043e\u0440\u0440 (\u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0440\u0430\u0432\u043d\u0430\u044f 1 \u043c\u043c \u0440\u0442\u0443\u0442\u043d\u043e\u0433\u043e
    \u0441\u0442\u043e\u043b\u0431\u0430). \u0415\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u00ab\u0432\u0442\u043e\u0440\u044b\u043c \u0413\u0430\u043b\u0438\u043b\u0435\u0435\u043c\u00bb,
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c
    \u0431\u044b\u043b\u043e \u0435\u0433\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043d\u0430\u0443\u043a\u0438."
  shortBioEn: "Evangelist Torricelli (1608 - 1647) is an Italian mathematician and physicist, a student of Galileo, who has come into history as an inventor of a mercury barometer and a man who has proven the existence of atmospheric pressure.\n\nEarly years and the formation of Torricelli were born on October 15, 1608, in the town of Faenza (Ravenna province) in a very poor family, where his father, Gaspar, worked in a textile factory, and his mother, Katerina Angetti, ran a household, and after noting his son's outstanding abilities, his parents sent him to study for his uncle, a Benedictine monk, who gave him an elementary education.In 1624, young Torricelli entered Jesuit College, where he studied mathematics and philosophy, and in 1627, after his father's death, he moved to Rome to study from Benedetto Castelli, a professor of mathematics in Sapienza, a close friend and student of Galileo, a turning point: under the leadership of Castelli Torricelli, he joined the new ideas of mechanics and became a strong follower of Galileo.In Rome, he also became friends with two other students, Castelli, Raffaallo Majotti and Antonio Nardi, whom Galileo called his \"Rima triumvirate\" as a joke.\n\nIn 1641, Castelli sent Galileo, who had already been blind, a tract of Torricelli's \"Trattato del moto\" mechanics. Galileo was so impressed that he immediately invited a young scientist to his place in Archerti as an assistant and secretary. Torricelli moved to Archetri and spent the last three months of his life with a great scientist.This time became an invaluable school for him: he helped Galileo work on his latest work, \"Beseda and Mathematical Evidence...\", and worked on his ideas. After the death of Galileo in 1642, the great Duke of Toskan Ferdinand II Medici appointed Torricelli as his court mathematician and professor of mathematics and philosophy at the University of Florence.\n\nThe major discoveries of Torricelli's scientific heritage are enormous, but its most famous achievements lie in the field of physics: Atmospheric pressure and barometer: Torricelli's main discovery was a mystery that even Galileo could not explain: why pump water rises only to a height of about 10 metres; Torricelli realized that it is caused by air pressure, not by \"thororor vacui\" of the Aristotle.He suggested that we were living \"at the bottom of the ocean\" and that the atmosphere was putting pressure on us to prove it. In 1643, his student Vincenzo Viviani (on the initiative of the teacher) had performed a famous experience: a glass tube that had been strewn from one end, filled up with mercury and turned it into a bowl of mercury. The mercury column had dropped to about 76 cm and a void had been created over it, later called \"the Torricelli void\".So the first mercury barometer was invented, and Torricelli was the first to determine that the height of the pole changes with weather, i.e. atmospheric pressure. Hydraulic: He laid the foundations for a modern hydraulics, drawing out the famous Torricelli formula, which determines the velocity of the liquid from the hole in the vessel. In his work he also found that the fluid jet was parabolic in shape. Mathematics: Torricelli was a brilliant mathematician.He developed the \"unsequently\" method of the Cavalry, and with it he solved many complex problems, such as finding the area and centre of gravity of the cycroid; he also discovered the concept of the curve and was known in geometry as the Torricelli point, a point in a triangle from which the sum of the distances to the top is minimal.\n\n==History==The last years and legacy, besides pure science, Torricelli was an outstanding opportunist artist who made high-quality telescope lenses and designed microscopes consisting of one tiny lens that he melted from a drop of glass. Torricelli quickly died on October 25, 1647 in Florence, just 10 days after his 39th birthday.In memory of his discovery, his name is called an off-system pressure unit, a thorre (approximately 1 mm mercury pole), called \"the second Galileo\", which was so profound that it had an impact on the development of science."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u042d\u0432\u0430\u043d\u0434\u0436\u0435\u043b\u0438\u0441\u0442\u0430
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u2014 \u044d\u0442\u043e \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0440\u043e\u0433\u0430\u044f \u0447\u0435\u0440\u0435\u0434\u0430
    \u0434\u0430\u0442 \u0438 \u0444\u043e\u0440\u043c\u0443\u043b, \u043d\u043e \u0438 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0441\u043c\u0435\u0441\u044c \u043a\u0443\u0440\u044c\u0435\u0437\u043e\u0432, \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u043f\u043e\u0440\u043e\u0432 \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0432. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u044f\u0440\u043a\u0438\u0435 \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0435
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.\n\n\U0001F9E0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441:
    \"\u0420\u043e\u0433 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438\" (\u0438\u043b\u0438
    \u0442\u0440\u0443\u0431\u0430 \u0413\u0430\u0432\u0440\u0438\u0438\u043b\u0430) \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c\u0442\u0435
    \u0441\u0435\u0431\u0435 \u0444\u0438\u0433\u0443\u0440\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c,
    \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0441\u044c \u0432\u0441\u0435 \u0442\u043e\u043d\u044c\u0448\u0435,
    \u0438 \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442
    \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c \u043e\u0431\u044a\u0435\u043c\u043e\u043c.
    \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0441\u0434\u0435\u043b\u0430\u043b \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438,
    \u0441\u043e\u0437\u0434\u0430\u0432 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0443\u044e
    \"\u0422\u0440\u0443\u0431\u0443 \u0413\u0430\u0432\u0440\u0438\u0438\u043b\u0430\". \u0424\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e
    \u044d\u0442\u043e \u0442\u0435\u043b\u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u044b. \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441:
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0431\u044b\u043b\u0438 \u043e\u0448\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u044b. \u041a\u0430\u043a
    \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u043b\u0438\u0442\u044c \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u0440\u0430\u0441\u043a\u0438,
    \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u0434\u043b\u0438\u043d\u043d\u0443\u044e \u0442\u0440\u0443\u0431\u0443, \u043d\u043e
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u043f\u043e\u043a\u0440\u0430\u0441\u0438\u0442\u044c \u0435\u0451 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u0430?
    \u0420\u0435\u0430\u043a\u0446\u0438\u044f \u043a\u043e\u043b\u043b\u0435\u0433: \u042d\u0442\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u043e
    \u0431\u0443\u0440\u043d\u044b\u0435 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435
    \u0441\u043f\u043e\u0440\u044b. \u0414\u0430\u0436\u0435 \u0441\u0430\u043c \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0435\u0433\u043e \"\u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u044b\u043c\".
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u044b-\u044d\u043c\u043f\u0438\u0440\u0438\u043a\u0438
    \u0432\u0440\u043e\u0434\u0435 \u0422\u043e\u043c\u0430\u0441\u0430 \u0413\u043e\u0431\u0431\u0441\u0430
    \u0441 \u043d\u0435\u0433\u043e\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043d\u0435
    \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442\u044c
    \u043a \u0442\u0430\u043a\u0438\u043c \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e
    \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u044b\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c.\n\n\U0001F3FA
    \u0421\u0435\u043a\u0440\u0435\u0442 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0445
    \u043b\u0438\u043d\u0437: \u043f\u043e\u0442\u0435\u0440\u044f\u043d\u043d\u0430\u044f \u0448\u043a\u0430\u0442\u0443\u043b\u043a\u0430
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0431\u044b\u043b \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043c-\u043e\u043f\u0442\u0438\u043a\u043e\u043c.
    \u041e\u043d \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0440\u0443\u0447\u043d\u043e
    \u0438\u0437\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u043b \u043b\u0438\u043d\u0437\u044b
    \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432 \u0438 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u043e\u0432,
    \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0432 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u041f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u0441\u0442\u0432\u043e
    \u043d\u0430\u0434 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e:
    \u0412 \u041c\u0443\u0437\u0435\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438
    \u0432\u043e \u0424\u043b\u043e\u0440\u0435\u043d\u0446\u0438\u0438 \u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f
    \u0435\u0433\u043e \u043b\u0438\u043d\u0437\u0430 \u0434\u0438\u0430\u043c\u0435\u0442\u0440\u043e\u043c
    83 \u043c\u043c, \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f
    \u0432 1646 \u0433\u043e\u0434\u0443. \u0411\u0435\u0437 \u043c\u0430\u043b\u043e\u0433\u043e
    \u0447\u0435\u0440\u0435\u0437 300 \u043b\u0435\u0442 \u0444\u0438\u0437\u0438\u043a\u0438
    \u0440\u0435\u0448\u0438\u043b\u0438 \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c \u0435\u0451
    \u0441 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c\u0438 \u043b\u0438\u043d\u0437\u0430\u043c\u0438
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0438\u0444\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0440\u0435\u0448\u0435\u0442\u043a\u0438. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u0431\u044b\u043b \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c:
    \u043b\u0438\u043d\u0437\u0430 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u0438\u043b\u0430 \u043f\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0443
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435! \u0417\u0430\u0441\u0435\u043a\u0440\u0435\u0447\u0435\u043d\u043d\u0430\u044f
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f: \u041a\u0430\u043a \u0435\u043c\u0443
    \u0443\u0434\u0430\u0432\u0430\u043b\u043e\u0441\u044c \u0434\u043e\u0441\u0442\u0438\u0447\u044c
    \u0442\u0430\u043a\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0431\u0435\u0437
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0441\u0442\u0430\u043d\u043a\u043e\u0432?
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0437\u043d\u0430\u043b \u0441\u0435\u043a\u0440\u0435\u0442,
    \u043d\u043e \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u0445\u0440\u0430\u043d\u0438\u0442\u044c
    \u043c\u043e\u043b\u0447\u0430\u043d\u0438\u0435: \"\u041a \u043a\u0440\u0430\u0439\u043d\u0435\u043c\u0443
    \u043c\u043e\u0435\u043c\u0443 \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u044f
    \u043d\u0435 \u043c\u043e\u0433\u0443 \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u043c\u043e\u0439
    \u0441\u0435\u043a\u0440\u0435\u0442, \u0442\u0430\u043a \u043a\u0430\u043a \u0432\u0435\u043b\u0438\u043a\u0438\u0439
    \u0433\u0435\u0440\u0446\u043e\u0433 \u043f\u0440\u0435\u0434\u043f\u0438\u0441\u0430\u043b
    \u043c\u043d\u0435 \u043c\u043e\u043b\u0447\u0430\u0442\u044c \u043e \u043d\u0451\u043c\u2026\".
    \u0415\u0441\u0442\u044c \u043b\u0438\u0448\u044c \u043d\u0430\u043c\u0435\u043a, \u0447\u0442\u043e
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u044f\u0432\u043b\u0435\u043d\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0435\u0439.
    \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0440\u0430\u0437\u0433\u0430\u0434\u043a\u0430
    \u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c \u0432 \u0448\u043a\u0430\u0442\u0443\u043b\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u0440\u043e\u0434\u0438\u043b\u0430 \u0441\u0440\u0435\u0434\u0438
    \u0435\u0433\u043e \u0434\u0440\u0443\u0437\u0435\u0439... \u0438 \u0431\u044b\u043b\u0430
    \u043f\u043e\u0442\u0435\u0440\u044f\u043d\u0430.\n\n\u2694\ufe0f \u041f\u043e\u043b\u0435\u043c\u0438\u043a\u0430
    \u0441 \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u0435\u043c: \u0432\u043e\u0439\u043d\u0430
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u044b \u0417\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u044b\u0445 \u0431\u0430\u0442\u0430\u043b\u0438\u0439
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u043c \u043c\u0438\u0440\u0435 \u0432\u0435\u043b\u0438\u0441\u044c
    \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0436\u0430\u0440\u043a\u0438\u0435 \u0441\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0437\u0430 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439.
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0416\u0438\u043b\u044c \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u044c \u043e\u0431\u0432\u0438\u043d\u0438\u043b
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0432 \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435,
    \u0437\u0430\u044f\u0432\u0438\u0432, \u0447\u0442\u043e \u0442\u043e\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u044b
    (\u043a\u0440\u0438\u0432\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0442\u043e\u0447\u043a\u0430 \u043d\u0430 \u043a\u0430\u0442\u044f\u0449\u0435\u043c\u0441\u044f
    \u043a\u043e\u043b\u0435\u0441\u0435). \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c
    \u0438\u043b\u0438 \u0437\u0430\u0438\u043c\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435?
    \u0421\u043f\u043e\u0440 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0435\u043d\u043d\u044b\u043c, \u0447\u0442\u043e
    \u043e\u043c\u0440\u0430\u0447\u0438\u043b \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438,
    \u0445\u043e\u0442\u044f \u0432 \u0438\u0442\u043e\u0433\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u0441\u043a\u043b\u043e\u043d\u044f\u044e\u0442\u0441\u044f \u043a \u0442\u043e\u043c\u0443,
    \u0447\u0442\u043e \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0435\u0446 \u043f\u0440\u0438\u0448\u0435\u043b
    \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e.\n\n\u26f2
    \u0428\u0443\u0442\u043a\u0430 \u0413\u0430\u043b\u0438\u043b\u0435\u044f, \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0430\u044f
    \u043d\u0430\u0443\u043a\u0443 \u0421\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043a\u0443\u0440\u044c\u0435\u0437 \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u043f\u0440\u0435\u0434\u044b\u0441\u0442\u043e\u0440\u0438\u0435\u0439
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f.
    \u0421\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u0438 \u0444\u043b\u043e\u0440\u0435\u043d\u0442\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u0433\u0435\u0440\u0446\u043e\u0433\u0430 \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c
    \u0441 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439: \u0432\u043e\u0434\u0430
    \u0432 \u043d\u0430\u0441\u043e\u0441\u0430\u0445 \u0443\u043f\u043e\u0440\u043d\u043e \u043d\u0435
    \u0436\u0435\u043b\u0430\u043b\u0430 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0432\u044b\u0448\u0435 10,5 \u043c\u0435\u0442\u0440\u043e\u0432. \u041e\u043d\u0438 \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0438\u0441\u044c
    \u0437\u0430 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043a \u0413\u0430\u043b\u0438\u043b\u0435\u044e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0448\u0443\u0442\u0438\u043b, \u0447\u0442\u043e,
    \u0432\u0438\u0434\u0438\u043c\u043e, \"\u043f\u0440\u0438\u0440\u043e\u0434\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0435\u0442
    \u0431\u043e\u044f\u0442\u044c\u0441\u044f \u043f\u0443\u0441\u0442\u043e\u0442\u044b\"
    \u043d\u0430 \u0442\u0430\u043a\u043e\u0439 \u0432\u044b\u0441\u043e\u0442\u0435. \u0418\u043c\u0435\u043d\u043d\u043e
    \u044d\u0442\u0443 \"\u0448\u0443\u0442\u043a\u0443\" \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u043f\u043e\u0440\u0443\u0447\u0438\u043b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c
    \u0441\u0432\u043e\u0438\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c. \u041d\u0430
    \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u044d\u0442\u043e\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u043b\u043e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043e \u043c\u0438\u0440\u0435,
    \u0434\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0443 \u0432\u043e\u0437\u0434\u0443\u0445\u0430
    \u0435\u0441\u0442\u044c \u0432\u0435\u0441.\n\n\u2601\ufe0f \u0416\u0438\u0437\u043d\u044c
    \"\u043d\u0430 \u0434\u043d\u0435 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0433\u043e
    \u043e\u043a\u0435\u0430\u043d\u0430\" \u0412 \u043f\u0438\u0441\u044c\u043c\u0435 \u043a
    \u0434\u0440\u0443\u0433\u0443 \u041c\u0438\u043a\u0435\u043b\u0430\u043d\u0434\u0436\u0435\u043b\u043e
    \u0420\u0438\u0447\u0447\u0438 \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0439
    \u043e\u043f\u044b\u0442 \u0441\u043e \u0440\u0442\u0443\u0442\u044c\u044e, \u043d\u043e
    \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0441\u0430\u043c\u0443\u044e
    \u043a\u0440\u0430\u0441\u0438\u0432\u0443\u044e \u043c\u0435\u0442\u0430\u0444\u043e\u0440\u0443
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0444\u0438\u0437\u0438\u043a\u0438:
    \"\u041c\u044b \u0436\u0438\u0432\u0435\u043c, \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0435
    \u043d\u0430 \u0434\u043d\u043e \u043e\u043a\u0435\u0430\u043d\u0430 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0439
    \u0441\u0442\u0438\u0445\u0438\u0438\". \u042d\u0442\u043e \u043f\u043e\u044d\u0442\u0438\u0447\u043d\u043e\u0435
    \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e
    \u043c\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0442\u043e\u0438\u043c
    \u043d\u0430 \u0437\u0435\u043c\u043b\u0435, \u0430 \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u0441\u044f
    \u043f\u043e\u0434 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u043e\u0433\u043e
    \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043e\u0433\u043e \u043e\u043a\u0435\u0430\u043d\u0430,
    \u0441\u0442\u0430\u043b\u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u044b\u043c \u0442\u0440\u0438\u0443\u043c\u0444\u043e\u043c.\n\n\u26cf\ufe0f
    \"\u0421\u043e\u0436\u0430\u043b\u0435\u044e, \u0447\u0442\u043e \u044d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u043b
    \u043d\u0435 \u043e\u043d\" \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438,
    \u043e\u0431\u043b\u0430\u0434\u0430\u044f \u0432\u0437\u0440\u044b\u0432\u043d\u044b\u043c
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c \u0438 \u043b\u044e\u0431\u043e\u0432\u044c\u044e
    \u043a \u0444\u043b\u043e\u0440\u0435\u043d\u0442\u0438\u0439\u0441\u043a\u0438\u043c \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f\u043c,
    \u0432 \u043d\u0430\u0443\u043a\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b \u0440\u0435\u0434\u043a\u043e\u0435
    \u0431\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u0441\u0442\u0432\u043e. \u041f\u043e\u0441\u043b\u0435
    \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b
    \u0441\u0432\u043e\u0435 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u043e\u043d \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435 \u0441\u043e\u0436\u0430\u043b\u0435\u043b,
    \u0447\u0442\u043e \u043e\u043d\u043e \u043d\u0435 \u0434\u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c
    \u0435\u0433\u043e \u0441\u043b\u0435\u043f\u043e\u043c\u0443 \u0438 \u0443\u043c\u0438\u0440\u0430\u044e\u0449\u0435\u043c\u0443
    \u0443\u0447\u0438\u0442\u0435\u043b\u044e \u0413\u0430\u043b\u0438\u043b\u0435\u044e. \u042d\u0442\u043e\u0442
    \u0436\u0435\u0441\u0442 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0438
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0446\u0435\u043d\u043d\u044b\u043c,
    \u0447\u0435\u043c \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c."
  interestingFactsEn: "The life of Evangelist Torricelli is not only a strict series of dates and formulas, but also an exciting mix of chickens, dramatic debates, and amazing secrets, and these are the brightest and most unusual pages of his biography.\n\nThe mathematical paradox: \"Rog Torricelli\" (or Gabriel's pipe) imagine a figure that goes into infinity and becomes thinner and has a final volume. This is the discovery that Torricelli made by creating the so-called \"Gavriil Tube.\" Technically, this is the body of hyperbola rotation.How can you fill the final amount of paint to fill an infinitely long tube, but it's impossible to paint it because it's endless? The reaction of colleagues: This discovery caused a violent philosophical debate. Even Torricelli himself called it \"paradox.\" Empirical philosophers like Thomas Gobbs argued with outrage that math should not lead to such intuitive absurd results.\n\nThe secret of perfect lenses: Torricelli's lost box was not only a theorist, but also a genius artist-optic. He personally made lenses for telescopes and microscopes, achieving remarkable accuracy for his time. Exceedance over modernity: The Museum of History of Science in Florence stores its 83 mm lens, built in 1646.Without 300 years later, physicists decided to compare it to modern lenses using a diffuse grid.The result was sensational: Torricelli's lens was superior in quality to modern technology! Secrecy technology: How did it achieve such accuracy without modern machines? Torricelli knew the secret, but was forced to remain silent: \"To my extreme regret, I cannot reveal my secret, because the great Duke has ordered me to keep quiet about it.\" There is only a hint that he used a phenomenon we call today interference.After death, the clue was kept in a box that wandered among his friends... and was lost.\n\n===Cycloids=========Cycloids========Cycledge===============================================================Cycling==========================================================================================================================================================Independence or borrowing? The argument was so fierce that it clouded the last years of Torricelli's life, even though historians eventually tend to see the Italian man come to his own decision.\n\nThe joke of Galileo, which changed science, is the most famous chicken, linked to the history of its main discovery. The builders of the Florentine Duke faced a problem: the water in the pumps was reluctant to rise above 10.5 meters. They asked for help from Galileo, who joked that \"nature seems to cease being afraid of the void\" at this height.In fact, this practical task has turned the world into a reality, proving that air has weight.\n\nIn a letter addressed to a friend of Michelangelo Richie Torricelli, he not only described his experience with mercury, but also formulated the most beautiful metaphor in the history of physics: \"We live under the ocean of air.\" This poetic realization that we are not just standing on the ground, but under pressure from the giant invisible ocean has become his personal triumph.\n\nTorricelli, who has the character and love of Florentine entertainment, has shown little generosity in science. After making his greatest discovery, he sincerely regretted that it was not given to his blind and dying teacher Galileo."
