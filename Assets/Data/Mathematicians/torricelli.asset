  wikiTitleRu: "\u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438, \u042D\u0432\u0430\u043D\u0434\u0436\u0435\u043B\u0438\u0441\u0442\u0430"
  wikidataId: Q102490
  fullNameRu: "\u0422\u043E\u0440\u0440\u0438\u0447\u0435\u043B\u043B\u0438, \u042D\u0432\u0430\u043D\u0434\u0436\u0435\u043B\u0438\u0441\u0442\u0430"
  fullNameEn: Evangelista Torricelli
  birthDate: 15.10.1608
  deathDate: 25.10.1647
