    \u0432\u0441\u0442\u0440\u0435\u0442\u044F\u0442\u0441\u044F, \u043A\u0430\u043A\u043E\u0435
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043F\u0440\u043E\u043B\u0435\u0442\u0438\u0442
    \u043C\u0443\u0445\u0430?\xBB* \u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0437\u0430\u0434\u0430\u0447\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u0447\u0430\u0441\u0442\u043E \u0440\u0435\u0448\u0430\u044E\u0442 \u0447\u0435\u0440\u0435\u0437
    \u0441\u0443\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E
    \u0440\u044F\u0434\u0430. \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043E\u0442\u0432\u0435\u0442\u0438\u043B \u0437\u0430 \u043F\u0430\u0440\u0443
    \u0441\u0435\u043A\u0443\u043D\u0434. \u0421\u0442\u0443\u0434\u0435\u043D\u0442
    \u0443\u043D\u044B\u043B\u043E \u0441\u043A\u0430\u0437\u0430\u043B: *\xAB\u0412\u044B
    \u0437\u043D\u0430\u043B\u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u0435\xBB*.
    \u041D\u0430 \u0447\u0442\u043E \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0443\u0434\u0438\u0432\u0438\u043B\u0441\u044F: *\xAB\u041A\u0430\u043A\u043E\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435? \u042F \u043F\u0440\u043E\u0441\u0442\u043E
    \u043F\u0440\u043E\u0441\u0443\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043B
    \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439 \u0440\u044F\u0434
    \u0432 \u0443\u043C\u0435\xBB*.  ### \U0001F973 \u042D\u043A\u0441\u0446\u0435\u043D\u0442\u0440\u0438\u0447\u043D\u044B\u0435
    \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0438 \u0438 \u043E\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043D\u0438  \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0431\u044B\u043B \u043F\u043E\u043B\u043D\u043E\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E
    \u043E\u0431\u0440\u0430\u0437\u0443 \xAB\u0441\u043A\u0443\u0447\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430\xBB. \u041E\u043D
    \u043B\u044E\u0431\u0438\u043B \u0448\u0443\u043C, \u0432\u0435\u0447\u0435\u0440\u0438\u043D\u043A\u0438
    \u0438 \u0433\u0440\u043E\u043C\u043A\u0443\u044E \u043C\u0443\u0437\u044B\u043A\u0443. 
    *   **\u041E\u0444\u0438\u0441 \u043A\u0430\u043A \u0441\u0442\u0443\u0434\u0438\u044F
    \u0437\u0432\u0443\u043A\u043E\u0437\u0430\u043F\u0438\u0441\u0438:** \u0415\u0433\u043E
    \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0431\u044B\u043B
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442 \u043D\u0430 \u0432\u0435\u0441\u044C
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D. \u041A\u043E\u0433\u0434\u0430
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u043D\u0430\u0434 \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439, \u043E\u043D \u0432\u043A\u043B\u044E\u0447\u0430\u043B
    **\u043D\u0435\u043C\u0435\u0446\u043A\u0443\u044E \u043E\u043F\u0435\u0440\u0443
    \u0412\u0430\u0433\u043D\u0435\u0440\u0430 \u043D\u0430 \u043F\u043E\u043B\u043D\u0443\u044E
    \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C**. \u0421\u043E\u0441\u0435\u0434\u0438
    \u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u0438 \u0436\u0430\u043B\u043E\u0432\u0430\u043B\u0438\u0441\u044C,
    \u043D\u043E \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u043D\u0435 \u0440\u0435\u0448\u0430\u043B\u0441\u044F \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0435\u043C\u0443 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0435. \u0421\u0430\u043C
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B,
    \u0447\u0442\u043E \u0433\u0440\u043E\u043C\u043A\u0430\u044F \u043C\u0443\u0437\u044B\u043A\u0430
    \xAB\u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442\xBB \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435
    \u0448\u0443\u043C\u044B \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u0435\u043C\u0443 \u043C\u044B\u0441\u043B\u0438\u0442\u044C \u0432 \u043F\u043E\u043B\u043D\u0443\u044E
    \u0441\u0438\u043B\u0443. \u041E\u043D \u043C\u043E\u0433 \u0447\u0430\u0441\u0430\u043C\u0438
    \u0441\u0438\u0434\u0435\u0442\u044C \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C,
    \u043F\u043E\u043A\u0430 \u0438\u0437 \u0435\u0433\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430
    \u0434\u043E\u043D\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0437\u0432\u0443\u043A\u0438
    \xAB\u0412\u0430\u043B\u044C\u043A\u0438\u0440\u0438\u0439\xBB. *   **\u041A\u043E\u0440\u043E\u043B\u044C
    \u0432\u0435\u0447\u0435\u0440\u0438\u043D\u043E\u043A:** \u0424\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D \u043E\u0431\u043E\u0436\u0430\u043B \u0432\u0435\u0447\u0435\u0440\u0438\u043D\u043A\u0438
    \u0438 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B \u0438\u0445 \u0443
    \u0441\u0435\u0431\u044F \u0434\u043E\u043C\u0430 \u043A\u0430\u0436\u0434\u044B\u0435
    \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435. \u0415\u0433\u043E \u0441\u0442\u043E\u043B\u044B
    \u043B\u043E\u043C\u0438\u043B\u0438\u0441\u044C \u043E\u0442 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u043E\u0439
    \u0435\u0434\u044B \u0438 \u0434\u043E\u0440\u043E\u0433\u0438\u0445 \u0432\u0438\u043D.
    \u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u043E\u043D \u043C\u043E\u0433 \u043F\u043E\u0441\u0440\u0435\u0434\u0438
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430 \u043E \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0435
    \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u0442\u044C,
    \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u0434\u043E\u0441\u043A\u0435
    \u0438 \u043D\u0430\u0447\u0430\u0442\u044C \u0438\u0441\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C
    \u0435\u0451 \u0444\u043E\u0440\u043C\u0443\u043B\u0430\u043C\u0438, \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044F
    \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u0443\u044E \u043D\u0430\u0443\u0447\u043D\u0443\u044E
    \u0438\u0434\u0435\u044E, \u0430 \u0437\u0430\u0442\u0435\u043C, \u0441\u0442\u0435\u0440\u0435\u0432
    \u0432\u0441\u0451, \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443 \u043A\u0430\u043A \u043D\u0438
    \u0432 \u0447\u0451\u043C \u043D\u0435 \u0431\u044B\u0432\u0430\u043B\u043E.
    *   **\u0428\u043E\u0444\u0451\u0440 \u0438 \xAB\u042F\u043D\u043A\u0438\xBB:**
    \u0411\u0443\u0434\u0443\u0447\u0438 \u043E\u0447\u0435\u043D\u044C \u0441\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u043E\u043D \u0432\u0441\u0435\u0433\u0434\u0430
    \u0435\u0437\u0434\u0438\u043B \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0438\u0445
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F\u0445. \u0412 \u041B\u043E\u0441-\u0410\u043B\u0430\u043C\u043E\u0441\u0435,
    \u0433\u0434\u0435 \u0431\u044B\u043B\u0430 \u0441\u0442\u0440\u043E\u0436\u0430\u0439\u0448\u0430\u044F
    \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0441\u0442\u044C \u0438 \u0432\u0441\u0435
    \u0445\u043E\u0434\u0438\u043B\u0438 \u0432 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0445
    \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \xAB\u0434\u0436\u0438\u043F\u0430\u0445\xBB,
    \u043E\u043D \u043D\u0430\u0441\u0442\u043E\u044F\u043B \u043D\u0430 \u0442\u043E\u043C,
    \u0447\u0442\u043E\u0431\u044B \u0435\u043C\u0443 \u0432\u044B\u0434\u0435\u043B\u0438\u043B\u0438
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0434\u043B\u0438\u043D\u043D\u044B\u0439
    \u043B\u0438\u043C\u0443\u0437\u0438\u043D. \u041E\u0445\u0440\u0430\u043D\u0430
    \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0431\u044B\u043B\u0430 \u0432 \u0448\u043E\u043A\u0435,
    \u043D\u043E \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430. \u041A\u043E\u043B\u043B\u0435\u0433\u0438
    \u0448\u0443\u0442\u0438\u043B\u0438, \u0447\u0442\u043E \u043F\u043E \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044E
    \u044D\u043B\u0435\u0433\u0430\u043D\u0442\u043D\u043E\u0433\u043E \u043B\u0438\u043C\u0443\u0437\u0438\u043D\u0430
    \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E
    \u043F\u0440\u0438\u0435\u0445\u0430\u043B \xAB\u0411\u043E\u043B\u044C\u0448\u043E\u0439
    \u0411\u043E\u0441\u0441\xBB. *   **\u0421\u043E\u043D \u0438 \u0440\u0435\u0436\u0438\u043C:**
    \u041E\u043D \u043C\u043E\u0433 \u0437\u0430\u0441\u043D\u0443\u0442\u044C \u0432
    \u043B\u044E\u0431\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u0438 \u0432 \u043B\u044E\u0431\u043E\u0439
    \u043F\u043E\u0437\u0435, \u0441\u0442\u043E\u0438\u043B\u043E \u0435\u043C\u0443
    \u0443\u0441\u0442\u0430\u0442\u044C. \u0420\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438,
    \u0447\u0442\u043E \u043E\u043D \u043C\u043E\u0433 \u0443\u0441\u043D\u0443\u0442\u044C
    \u043D\u0430 \u043F\u043E\u043B\u0443\u0441\u043B\u043E\u0432\u0435 \u0432\u043E
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E
    \u0434\u043E\u043A\u043B\u0430\u0434\u0430, \u0430 \u043A\u043E\u0433\u0434\u0430
    \u0435\u0433\u043E \u0431\u0443\u0434\u0438\u043B\u0438 \u0447\u0435\u0440\u0435\u0437
    5 \u043C\u0438\u043D\u0443\u0442, \u043E\u043D \u0442\u0443\u0442 \u0436\u0435
    \u0432\u0441\u0442\u0443\u043F\u0430\u043B \u0432 \u0434\u0438\u0441\u043A\u0443\u0441\u0441\u0438\u044E
    \u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043B \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0443\u0441\u043A\u043E\u043B\u044C\u0437\u0430\u043B\u043E \u043E\u0442 \u0434\u043E\u043A\u043B\u0430\u0434\u0447\u0438\u043A\u0430
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432. 
    ### \U0001F5E3\uFE0F \u041E\u0441\u0442\u0440\u043E\u0443\u043C\u0438\u0435,
    \u0430\u043D\u0435\u043A\u0434\u043E\u0442\u044B \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
    \u044E\u043C\u043E\u0440\u0430  \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0431\u044B\u043B \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u0441\u0432\u043E\u0438\u043C
    \u043E\u0441\u0442\u0440\u044B\u043C, \u0438\u043D\u043E\u0433\u0434\u0430 \u044F\u0437\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C,
    \u043D\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u043B\u0438\u0441\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C \u044E\u043C\u043E\u0440\u0430. 
    *   **\u0410\u043D\u0435\u043A\u0434\u043E\u0442\u044B \u043D\u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430\u0445:**
    \u041E\u043D \u043B\u044E\u0431\u0438\u043B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
    \u0430\u043D\u0435\u043A\u0434\u043E\u0442\u044B (\u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435
    \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438
    \u0444\u0440\u0438\u0432\u043E\u043B\u044C\u043D\u044B\u0435) \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u043B\u0435\u043A\u0446\u0438\u0439. \u041E\u0434\u043D\u0430\u0436\u0434\u044B
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0437\u0430\u0449\u0438\u0442\u044B
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u043C,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0447\u0435\u043D\u044C \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u043B,
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u043F\u043E\u043D\u044F\u043B,
    \u0447\u0442\u043E \u0442\u043E\u0442 \u043D\u0430 \u0433\u0440\u0430\u043D\u0438
    \u043F\u0440\u043E\u0432\u0430\u043B\u0430. \u0422\u043E\u0433\u0434\u0430 \u043E\u043D
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B \u0435\u0433\u043E \u0438
    \u0441\u043A\u0430\u0437\u0430\u043B: *\xAB\u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u044F \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
    \u0432\u0430\u043C \u0430\u043D\u0435\u043A\u0434\u043E\u0442, \u0430 \u0432\u044B
    \u043F\u043E\u043A\u0430 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u0435\u0441\u044C\xBB*.
    \u0421\u0442\u0443\u0434\u0435\u043D\u0442 \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0441\u044F,
    \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u043B\u0441\u044F \u0438 \u0432
    \u0438\u0442\u043E\u0433\u0435 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435
    \u0437\u0430\u0449\u0438\u0442\u0438\u043B\u0441\u044F. *   **\xAB\u0414\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0430\u043D\u0435\u043A\u0434\u043E\u0442\u0430\xBB:**
    \u0415\u0433\u043E \u043B\u044E\u0431\u0438\u043B\u0438 \u0437\u0430 \u0442\u043E,
    \u0447\u0442\u043E \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043E\u043D \u043C\u043E\u0433 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C
    \u043F\u0440\u043E\u0441\u0442\u044B\u043C\u0438 \u0431\u044B\u0442\u043E\u0432\u044B\u043C\u0438
    \u043F\u0440\u0438\u043C\u0435\u0440\u0430\u043C\u0438. \u041E\u0434\u043D\u0430\u0436\u0434\u044B,
    \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044F \u0441 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0441\u0442\u043E\u043C
    \u0442\u0435\u043E\u0440\u0438\u044E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0435\u0439,
    \u043E\u043D \u0441\u043A\u0430\u0437\u0430\u043B: *\xAB\u0412\u0441\u0451 \u043F\u0440\u043E\u0441\u0442\u043E.
    \u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0434\u0432\u0430
    \u043D\u043E\u0441\u043A\u0430 \u2014 \u043E\u0434\u0438\u043D \u0447\u0451\u0440\u043D\u044B\u0439,
    \u043E\u0434\u0438\u043D \u0431\u0435\u043B\u044B\u0439, \u0438 \u0432\u044B
    \u0438\u0445 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u2014 \u0442\u0435\u043E\u0440\u0438\u044F
    \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0435\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
    \u0447\u0442\u043E \u0432\u044B \u043D\u0430\u0439\u0434\u0451\u0442\u0435 \u0447\u0451\u0440\u043D\u044B\u0439.
    \u0410 \u0436\u0438\u0437\u043D\u044C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043E \u0432\u044B \u043D\u0430\u0439\u0434\u0451\u0442\u0435 \u0431\u0435\u043B\u044B\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u0435\u043D\xBB*.
    *   **\u041E\u0442\u0432\u0435\u0442 \u043D\u0430 \u043A\u0440\u0438\u0442\u0438\u043A\u0443:**
    \u041A\u043E\u0433\u0434\u0430 \u043E\u0434\u0438\u043D \u0438\u0437 \u0447\u0438\u0441\u0442\u044B\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 \u0443\u043F\u0440\u0435\u043A\u043D\u0443\u043B
    \u0435\u0433\u043E \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u043E\u043D
    \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \xAB\u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u043E\u0439,
    \u0430 \u043D\u0435 \u0438\u0441\u0442\u0438\u043D\u043D\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0439\xBB,
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u043E\u0442\u0432\u0435\u0442\u0438\u043B
    \u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439: *\xAB\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0447\u0438\u0441\u0442\u043E\u0439
    \u0438\u043B\u0438 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u043E\u0439.
    \u041E\u043D\u0430 \u0431\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439
    \u0438\u043B\u0438 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439.
    \u0410 \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0430\u044F
    \u2014 \u043E\u043D\u0430 \u0440\u0430\u043D\u043E \u0438\u043B\u0438 \u043F\u043E\u0437\u0434\u043D\u043E
    \u043D\u0430\u0439\u0434\u0451\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\xBB*. 
    ### \U0001F6F8 \xAB\u042D\u043A\u0441\u0442\u0440\u0430\u043E\u0440\u0434\u0438\u043D\u0430\u0440\u043D\u044B\u0435\xBB
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0438 \u043E\u0448\u0438\u0431\u043A\u0438 
    \u0418\u043D\u043E\u0433\u0434\u0430 \u0435\u0433\u043E \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u0443\u043C \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u043B \u043A \u0437\u0430\u0431\u0430\u0432\u043D\u044B\u043C
    \u043A\u0443\u0440\u044C\u0435\u0437\u0430\u043C, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u043E\u0448\u0438\u0431\u0430\u043B\u0441\u044F
    \u0438\u043B\u0438 \u0441\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u043B\u0441\u044F
    \u0441 \u0447\u0435\u043C-\u0442\u043E, \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0433
    \u043F\u043E\u043D\u044F\u0442\u044C.  *   **\u0421\u043F\u043E\u0440 \u0441
    \u043A\u043E\u043B\u043B\u0435\u0433\u043E\u0439:** \u041E\u0434\u043D\u0430\u0436\u0434\u044B
    \u0435\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u0433\u0430 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B,
    \u0447\u0442\u043E \u043D\u0435\u0442 \u043F\u0440\u0435\u0434\u0435\u043B\u0430
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438.
    \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043B:
    *\xAB\u041D\u0435\u0442, \u0435\u0441\u0442\u044C. \u042F, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043D\u0435 \u043C\u043E\u0433\u0443 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C,
    \u0447\u0442\u043E \u0435\u043B \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A
    \u0434\u0432\u0430 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u044D\u0442\u043E \u043D\u0435 \u0438\u043C\u0435\u0435\u0442
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F\xBB*. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0432 \u0442\u043E\u0442 \u0436\u0435 \u0434\u0435\u043D\u044C \u043E\u043D
    \u043D\u0430 \u0441\u043F\u043E\u0440 \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u0430\u043B
    \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0442\u0440\u0451\u0445\u0442\u043E\u043C\u043D\u043E\u0439
    \u043C\u043E\u043D\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u043F\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u0438,
    \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u0439 \u0438\u043C
    20 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434, \u0441\u043B\u043E\u0432\u043E
    \u0432 \u0441\u043B\u043E\u0432\u043E. *   **\u0418\u043D\u0446\u0438\u0434\u0435\u043D\u0442
    \u0441 \u0413\u0451\u0434\u0435\u043B\u0435\u043C:** \u041E\u0434\u043D\u0430\u0436\u0434\u044B
    \u043E\u043D \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B \u0441 \u041A\u0443\u0440\u0442\u043E\u043C
    \u0413\u0451\u0434\u0435\u043B\u0435\u043C \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0443\u044E
    \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443.
    \u0413\u0451\u0434\u0435\u043B\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u0435\u043C\u0443 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F. \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F \u0438 \u0441\u043A\u0430\u0437\u0430\u043B:
    *\xAB\u041A\u0443\u0440\u0442, \u0432\u044B \u0436\u0435 \u0437\u043D\u0430\u0435\u0442\u0435,
    \u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043E\u0448\u0438\u0431\u0430\u044E\u0441\u044C
    \u0432 \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u0445. \u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u044F \u043F\u0440\u043E\u0432\u0435\u0440\u044E \u0432\u0430\u0448\u0438 \u0444\u043E\u0440\u043C\u0443\u043B\u044B\xBB*.
    \u041E\u043D \u0432\u0437\u044F\u043B \u043B\u0438\u0441\u0442, \u0431\u044B\u0441\u0442\u0440\u043E
    \u043F\u0440\u043E\u0441\u0447\u0438\u0442\u0430\u043B \u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u043B,
    \u0447\u0442\u043E \u043E\u0434\u0438\u043D \u0438\u0437 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432
    \u0432\u0435\u0440\u0435\u043D. \u0413\u0451\u0434\u0435\u043B\u044C \u0441\u0443\u0445\u043E
    \u043E\u0442\u0432\u0435\u0442\u0438\u043B: *\xAB\u0412\u044B \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043E\u0434\u043D\u043E\u043C \u2014
    \u0432\u044B \u0434\u0443\u043C\u0430\u0435\u0442\u0435, \u0447\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u043E\u0448\u0438\u0431\u0430\u0435\u0442\u0435\u0441\u044C\xBB*.
    \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F
    \u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u044D\u0442\u043E
    \u043B\u0443\u0447\u0448\u0430\u044F \u0448\u0443\u0442\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u043E\u043D \u0441\u043B\u044B\u0448\u0430\u043B \u0437\u0430 \u043C\u0435\u0441\u044F\u0446.
    *   **\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u0434\u043E\u043C\u0430:**
    \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0431\u044B\u043B \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
    \u0431\u043E\u0433\u0430\u0442, \u043D\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
    \u043D\u0435 \u0443\u043C\u0435\u043B \u0441\u0447\u0438\u0442\u0430\u0442\u044C
    \u0434\u0435\u043D\u044C\u0433\u0438 \u0432 \u0431\u044B\u0442\u0443. \u041E\u0434\u043D\u0430\u0436\u0434\u044B
    \u043E\u043D \u043A\u0443\u043F\u0438\u043B \u0434\u043E\u043C \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435,
    \u043D\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0432 \u043D\u0430
    \u0446\u0435\u043D\u0443. \u041A\u043E\u0433\u0434\u0430 \u0436\u0435\u043D\u0430
    \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u0435\u0433\u043E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u0442, \u043E\u043D \u043E\u0442\u0432\u0435\u0442\u0438\u043B:
    *\xAB\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u043D\u043E \u043C\u043D\u0435
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u044D\u0442\u043E
    \u0432\u044B\u0433\u043E\u0434\u043D\u043E, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0443 \u0434\u043E\u043C\u0430 \u0435\u0441\u0442\u044C \u043F\u043E\u0434\u0432\u0430\u043B,
    \u0433\u0434\u0435 \u044F \u043C\u043E\u0433\u0443 \u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u0441\u0432\u043E\u0438 \u0444\u043E\u0440\u043C\u0443\u043B\u044B\xBB*.  ###
    \U0001F579\uFE0F \u0428\u0430\u0445\u043C\u0430\u0442\u044B, \u0438\u0433\u0440\u044B
    \u0438 \u0432\u0438\u0440\u0442\u0443\u043E\u0437\u043D\u043E\u0441\u0442\u044C 
    \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0431\u044B\u043B \u0430\u0437\u0430\u0440\u0442\u043D\u044B\u043C
    \u0438\u0433\u0440\u043E\u043A\u043E\u043C, \u043D\u043E \u0435\u0433\u043E \u0430\u0437\u0430\u0440\u0442
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0451\u043D
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0439.  *   **\u0422\u0435\u043E\u0440\u0438\u044F
    \u0438\u0433\u0440 \u0437\u0430 \u043A\u0430\u0440\u0442\u043E\u0447\u043D\u044B\u043C
    \u0441\u0442\u043E\u043B\u043E\u043C:** \u041E\u043D \u043E\u0431\u043E\u0436\u0430\u043B
    \u043F\u043E\u043A\u0435\u0440 \u0438 \u0431\u0440\u0438\u0434\u0436. \u041F\u0440\u0438\u0447\u0451\u043C,
    \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043C\u043D\u043E\u0433\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432, \u043E\u043D
    \u0438\u0433\u0440\u0430\u043B \u043D\u0435 \u043F\u043E \xAB\u0447\u0438\u0441\u0442\u043E\u0439
    \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0438\xBB, \u0430
    \u043F\u043E \xAB\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u043C\u0443
    \u0444\u0430\u043A\u0442\u043E\u0440\u0443\xBB. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B:
    *\xAB\u0412 \u043F\u043E\u043A\u0435\u0440\u0435 \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442
    \u043D\u0435 \u0442\u043E\u0442, \u043A\u0442\u043E \u0437\u043D\u0430\u0435\u0442
    \u0442\u0435\u043E\u0440\u0438\u044E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0435\u0439,
    \u0430 \u0442\u043E\u0442, \u043A\u0442\u043E \u0443\u043C\u0435\u0435\u0442
    \u0431\u043B\u0435\u0444\u043E\u0432\u0430\u0442\u044C. \u041D\u043E \u044F \u0437\u043D\u0430\u044E
    \u0442\u0435\u043E\u0440\u0438\u044E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0435\u0439
    *\u0438* \u0443\u043C\u0435\u044E \u0431\u043B\u0435\u0444\u043E\u0432\u0430\u0442\u044C\xBB*.
    \u041E\u043D \u0447\u0430\u0441\u0442\u043E \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u043B,
    \u043D\u043E \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u043B \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E,
    \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043E\u0431\u0438\u0436\u0430\u0442\u044C
    \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432. *   **\u041F\u0430\u0440\u0442\u0438\u044F
    \u0441 \u0448\u0430\u0445\u043C\u0430\u0442\u043D\u044B\u043C \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u043C:**
    \u0417\u0430\u0434\u043E\u043B\u0433\u043E \u0434\u043E \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F
    \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u0448\u0430\u0445\u043C\u0430\u0442\u043D\u044B\u0445
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C \u043E\u043D \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \xAB\u043C\u0430\u0448\u0438\u043D\u044B \u0431\u0443\u0434\u0443\u0442
    \u0438\u0433\u0440\u0430\u0442\u044C \u0432 \u0448\u0430\u0445\u043C\u0430\u0442\u044B
    \u043B\u0443\u0447\u0448\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430\xBB.
    \u041A\u043E\u0433\u0434\u0430 \u0435\u0433\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0438,
    \u043A\u0430\u043A \u044D\u0442\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u043E\u043D \u043E\u0442\u0432\u0435\u0442\u0438\u043B: *\xAB\u041E\u0447\u0435\u043D\u044C
    \u043F\u0440\u043E\u0441\u0442\u043E. \u041C\u0430\u0448\u0438\u043D\u0430 \u043D\u0435
    \u0443\u0441\u0442\u0430\u0451\u0442, \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0435\u0442\u0441\u044F
    \u0438 \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u043E\u0448\u0438\u0431\u043E\u043A.
    \u0410 \u043E\u0448\u0438\u0431\u043A\u0438 \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435,
    \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
    \u0441\u0438\u043B\u044C\u043D\u044B\u043C \u0432 \u0448\u0430\u0445\u043C\u0430\u0442\u0430\u0445.
    \u0417\u043D\u0430\u0447\u0438\u0442, \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
    \u043C\u0430\u0448\u0438\u043D\u0430 \u043D\u0430\u0443\u0447\u0438\u0442\u0441\u044F
    \u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C \u043E\u0448\u0438\u0431\u043E\u043A,
    \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442 \u043D\u0435\u043F\u043E\u0431\u0435\u0434\u0438\u043C\u0430\xBB*. 
    ### \u269B\uFE0F \u041B\u043E\u0441-\u0410\u043B\u0430\u043C\u043E\u0441: \u0437\u0430\u0431\u0430\u0432\u043D\u044B\u0439
    \u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439  \u0414\u0430\u0436\u0435
    \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0439
    \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0441\u0442\u0438 \u0440\u0430\u0431\u043E\u0442\u044B
    \u043D\u0430\u0434 \u0430\u0442\u043E\u043C\u043D\u043E\u0439 \u0431\u043E\u043C\u0431\u043E\u0439
    \u0435\u0433\u043E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u043B\u0441\u044F
    \u044F\u0440\u043A\u043E.  *   **\u041E\u0442\u043A\u0430\u0437 \u043E\u0442
    \u0432\u043E\u0435\u043D\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B:**
    \u0412 \u041B\u043E\u0441-\u0410\u043B\u0430\u043C\u043E\u0441\u0435 \u0432\u0441\u0435\u043C
    \u0443\u0447\u0451\u043D\u044B\u043C \u0432\u044B\u0434\u0430\u043B\u0438 \u0432\u043E\u0435\u043D\u043D\u0443\u044E
    \u0443\u043D\u0438\u0444\u043E\u0440\u043C\u0443. \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u044F\u0432\u0438\u043B\u0441\u044F \u0432 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C
    \u043A\u043E\u0441\u0442\u044E\u043C\u0435 \u0438 \u0433\u0430\u043B\u0441\u0442\u0443\u043A\u0435,
    \u0437\u0430\u044F\u0432\u0438\u0432: *\xAB\u0414\u0436\u0435\u043D\u0442\u043B\u044C\u043C\u0435\u043D
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0432 \u043F\u0438\u0436\u0430\u043C\u0435, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
    \u044D\u0442\u0430 \u043F\u0438\u0436\u0430\u043C\u0430 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430\xBB*. \u0418 \u0435\u043C\u0443 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0438.
    *   **\u041A\u043B\u0430\u0440\u0430 \u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440:**
    \u0415\u0433\u043E \u0436\u0435\u043D\u0430 \u041A\u043B\u0430\u0440\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430
    \u0441 \u043D\u0438\u043C \u043D\u0430\u0434 \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u043C\u0438
    \u0434\u043B\u044F EDVAC. \u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043E\u043D\u0430
    \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430 \u043E\u0448\u0438\u0431\u043A\u0443
    \u0432 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0435, \u0438\u0437-\u0437\u0430
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u0432\u044B\u0434\u0430\u043B \u0430\u0431\u0441\u0443\u0440\u0434\u043D\u044B\u0439
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442. \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D,
    \u0432\u043C\u0435\u0441\u0442\u043E \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
    \u0440\u0430\u0441\u0441\u0435\u0440\u0434\u0438\u0442\u044C\u0441\u044F, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
    \u043D\u0430 \u043B\u0438\u0441\u0442 \u0438 \u0441\u043A\u0430\u0437\u0430\u043B:
    *\xAB\u041A\u043B\u0430\u0440\u0430, \u0434\u043E\u0440\u043E\u0433\u0430\u044F,
    \u0442\u044B \u043E\u0448\u0438\u0431\u043B\u0430\u0441\u044C \u0432 \u0441\u0442\u0440\u043E\u043A\u0435
    42. \u041D\u043E \u044F \u0442\u0435\u0431\u044F \u043B\u044E\u0431\u043B\u044E
    \u0434\u0430\u0436\u0435 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
    \u044D\u0442\u043E\u0442 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440,
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u043E\u0449\u0430\u044E.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0435\u0441\u043B\u0438 \u0442\u044B \u043E\u0448\u0438\u0431\u0451\u0448\u044C\u0441\u044F
    \u0435\u0449\u0451 \u0440\u0430\u0437, \u044F \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E
    \u0442\u0435\u0431\u044F \u0432\u044B\u0447\u0438\u0441\u043B\u044F\u0442\u044C
    \u043B\u043E\u0433\u0430\u0440\u0438\u0444\u043C\u044B \u0432\u0440\u0443\u0447\u043D\u0443\u044E\xBB*.
    \u041A\u043B\u0430\u0440\u0430 \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0430\u0441\u044C
    \u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043E\u0448\u0438\u0431\u043B\u0430\u0441\u044C. 
    ### \u26B0\uFE0F \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043A\u0443\u0440\u044C\u0451\u0437\u044B:
    \u0441\u0438\u043B\u0430 \u0434\u0443\u0445\u0430 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 
    \u0414\u0430\u0436\u0435 \u043F\u0435\u0440\u0435\u0434 \u043B\u0438\u0446\u043E\u043C
    \u0441\u043C\u0435\u0440\u0442\u0438 \u0435\u0433\u043E \u0440\u0430\u0437\u0443\u043C
    \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u044E\u043C\u043E\u0440\u0430
    \u043D\u0435 \u043F\u043E\u043A\u0438\u0434\u0430\u043B\u0438 \u0435\u0433\u043E. 
    *   **\u0421\u043F\u043E\u0440 \u043E \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0438:**
    \u041B\u0435\u0436\u0430 \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435
    \u0441 \u043D\u0435\u0438\u0437\u043B\u0435\u0447\u0438\u043C\u044B\u043C \u0440\u0430\u043A\u043E\u043C,
    \u043E\u043D \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B \u0441 \u0432\u0440\u0430\u0447\u043E\u043C
    \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u044E \u043A\u043B\u0435\u0442\u043A\u0438.
    \u0412\u0440\u0430\u0447 \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
    \u043A\u043B\u0435\u0442\u043A\u0438 \u0434\u0435\u043B\u044F\u0442\u0441\u044F
    \u0438 \u0443\u043C\u0438\u0440\u0430\u044E\u0442, \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u2014 \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \xAB\u043A\u043B\u0435\u0442\u043E\u0447\u043D\u044B\u0439
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\xBB. \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0441\u043B\u0430\u0431\u043E \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F
    \u0438 \u0441\u043A\u0430\u0437\u0430\u043B: *\xAB\u042F \u0432\u0441\u0435\u0433\u0434\u0430
    \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u044F \u2014 \u0441\u0430\u043C\u043E\u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0449\u0438\u0439\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442. \u0416\u0430\u043B\u044C \u0442\u043E\u043B\u044C\u043A\u043E,
    \u0447\u0442\u043E \u044D\u0442\u043E\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439
    \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
    \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
    \u0432\u0435\u0447\u043D\u043E\xBB*. *   **\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0441\u043B\u043E\u0432\u0430:** \u041F\u043E \u0441\u043B\u0443\u0445\u0430\u043C,
    \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0443\u0436\u0435 \u0431\u044B\u043B
    \u0432 \u0430\u0433\u043E\u043D\u0438\u0438, \u0435\u0433\u043E \u0431\u0440\u0430\u0442
    \u0441\u043F\u0440\u043E\u0441\u0438\u043B \u0435\u0433\u043E: *\xAB\u0421\u0442\u0440\u0430\u0448\u043D\u043E
    \u0443\u043C\u0438\u0440\u0430\u0442\u044C?\xBB* \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043E\u0442\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430 \u0438 \u043E\u0442\u0432\u0435\u0442\u0438\u043B:
    *\xAB\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u2014 \u0434\u0430. \u041D\u043E \u043C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u044B\u043B\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
    \u043A\u0430\u043A \u044D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.
    \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u0443\u0437\u043D\u0430\u044E \u043D\u0430
    \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435\xBB*. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
    \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u0438\u0445 \u0441\u043B\u043E\u0432
    \u043E\u043D \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435
    \u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B
    \u0432 \u0441\u0435\u0431\u044F.  \u042D\u0442\u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u043F\u043E\u0440\u0442\u0440\u0435\u0442
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0440\u043E\u0431\u043E\u0442\u0430, \u0430 \u044F\u0440\u043A\u043E\u0433\u043E,
    \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E,
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u043D\u043E\u0433\u043E \u0438 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E
    \u0443\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
