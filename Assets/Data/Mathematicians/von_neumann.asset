  achievementsRu: "\u0414\u0436\u043E\u043D \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u0431\u044F
    \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435, \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0435\u0435
    \u0441\u0442\u043E\u043B\u044C \u043C\u043D\u043E\u0433\u0438\u0435 \u043E\u0431\u043B\u0430\u0441\u0442\u0438,
    \u0447\u0442\u043E \u0435\u0433\u043E \u043F\u043E \u043F\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u043E\u0434\u043D\u0438\u043C \u0438\u0437
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445 \u0432\u0435\u043B\u0438\u043A\u0438\u0445
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u043E\u0432 \u0432 \u043D\u0430\u0443\u043A\u0435.
    \u0415\u0433\u043E \u0432\u043A\u043B\u0430\u0434 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0440\u0435\u0448\u0438\u043B \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u2014 \u0432\u043E \u043C\u043D\u043E\u0433\u0438\u0445
    \u0441\u043B\u0443\u0447\u0430\u044F\u0445 \u043E\u043D \u0441\u043E\u0437\u0434\u0430\u043B
    \u0446\u0435\u043B\u044B\u0435 \u043D\u043E\u0432\u044B\u0435 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B
    \u0438 \u0437\u0430\u043B\u043E\u0436\u0438\u043B \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u043C\u0438\u0440\u0430.
    \u041D\u0438\u0436\u0435 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E \u043E\u043F\u0438\u0441\u0430\u043D\u044B
    \u0435\u0433\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F. 
    ### \U0001F4D0 \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430 \u0438
    \u043B\u043E\u0433\u0438\u043A\u0430: \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442
    \u0434\u043B\u044F \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0439 
    \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u043E \u0444\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D\u0430 \u0431\u044B\u043B\u043E \u043F\u043E\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C
    \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C. \u041E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u043A\u0430\u043A \u0432 \u0441\u0430\u043C\u044B\u0445 \u0430\u0431\u0441\u0442\u0440\u0430\u043A\u0442\u043D\u044B\u0445
    \u043E\u0431\u043B\u0430\u0441\u0442\u044F\u0445, \u0442\u0430\u043A \u0438 \u0432
    \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u044B\u0445, \u043F\u0440\u0438\u0447\u0435\u043C
    \u0447\u0430\u0441\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u043F\u0435\u0440\u0435\u0436\u0430\u043B \u0441\u0432\u043E\u0435 \u0432\u0440\u0435\u043C\u044F,
    \u0447\u0442\u043E \u0435\u0433\u043E \u0438\u0434\u0435\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043B\u0438\u0448\u044C
    \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F \u0441\u043F\u0443\u0441\u0442\u044F. 
    *   **\u0410\u043A\u0441\u0438\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044F
    \u0442\u0435\u043E\u0440\u0438\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432**:
    \u0412 \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 1925 \u0433\u043E\u0434\u0430
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0440\u0435\u0448\u0438\u043B
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0443\u044E
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443, \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0443\u044E
    \u0438\u0437-\u0437\u0430 \u043F\u0430\u0440\u0430\u0434\u043E\u043A\u0441\u043E\u0432
    \u0432 \u043D\u0430\u0438\u0432\u043D\u043E\u0439 \u0442\u0435\u043E\u0440\u0438\u0438
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043F\u0430\u0440\u0430\u0434\u043E\u043A\u0441\u0430 \u0420\u0430\u0441\u0441\u0435\u043B\u0430).
    \u041E\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0441\u0442\u0440\u043E\u0433\u0443\u044E
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0430\u043A\u0441\u0438\u043E\u043C,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0438\u0441\u043A\u043B\u044E\u0447\u0430\u043B\u0430
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u044F, \u0432\u0432\u0435\u0434\u044F
    **\u0430\u043A\u0441\u0438\u043E\u043C\u0443 \u0444\u0443\u043D\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F**
    \u0438 \u043F\u043E\u043D\u044F\u0442\u0438\u0435 **\u043A\u043B\u0430\u0441\u0441\u0430**
    (\u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \"\u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0430\").
    \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u043D\u0435\u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0432\u0443\u044E
    \u043E\u0441\u043D\u043E\u0432\u0443 \u0434\u043B\u044F \u0432\u0441\u0435\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438. \u0415\u0433\u043E
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0431\u044B\u043B\u0430 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u0437\u043D\u0430\u0447\u0438\u043C\u0430, \u0447\u0442\u043E \u043B\u0435\u0433\u043B\u0430
    \u0432 \u043E\u0441\u043D\u043E\u0432\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0430\u043A\u0441\u0438\u043E\u043C **NBG** (\u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430
    \u2014 \u0411\u0435\u0440\u043D\u0430\u0439\u0441\u0430 \u2014 \u0413\u0451\u0434\u0435\u043B\u044F). 
    *   **\u0422\u0435\u043E\u0440\u0435\u043C\u044B \u043E \u043D\u0435\u043F\u043E\u043B\u043D\u043E\u0442\u0435
    \u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430**:
    \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u0434\u0438\u0441\u043A\u0443\u0441\u0441\u0438\u044F\u0445 1930 \u0433\u043E\u0434\u0430
    \u043E \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.
    \u0423\u0437\u043D\u0430\u0432 \u043E \u0442\u0435\u043E\u0440\u0435\u043C\u0430\u0445
    \u041A\u0443\u0440\u0442\u0430 \u0413\u0451\u0434\u0435\u043B\u044F, \u043E\u043D
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
    \u043E\u0441\u043E\u0437\u043D\u0430\u043B \u0438\u0445 \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0435\u0435
    \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u2014 **\u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0435\u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0432\u043E\u0441\u0442\u044C
    \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u043A\u0438 \u0435\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438** (\u0432\u0442\u043E\u0440\u0430\u044F
    \u0442\u0435\u043E\u0440\u0435\u043C\u0430 \u0413\u0451\u0434\u0435\u043B\u044F).
    \u0425\u043E\u0442\u044F \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442
    \u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0438 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B
    \u0413\u0451\u0434\u0435\u043B\u044E, \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445,
    \u043A\u0442\u043E \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0441\u043E\u0437\u043D\u0430\u043B
    \u043C\u0430\u0441\u0448\u0442\u0430\u0431 \u044D\u0442\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430
    \u043F\u043E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0435 \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430. 
    *   **\u0422\u0435\u043E\u0440\u0438\u044F \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432
    \u0438 \u0430\u043B\u0433\u0435\u0431\u0440\u044B \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430**:
    \u0412 1930-\u0445 \u0433\u043E\u0434\u0430\u0445, \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E
    \u0441 \u0424. \u0414\u0436. \u041C\u044E\u0440\u0440\u0435\u0435\u043C, \u043E\u043D
    \u043E\u0441\u043D\u043E\u0432\u0430\u043B \u0446\u0435\u043B\u0443\u044E \u043E\u0431\u043B\u0430\u0441\u0442\u044C
    \u2014 **\u0442\u0435\u043E\u0440\u0438\u044E \u043A\u043E\u043B\u0435\u0446
    \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432**, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u043E\u0437\u0436\u0435 \u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C\u0441\u044F
    **\u0430\u043B\u0433\u0435\u0431\u0440\u0430\u043C\u0438 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430**.
    \u042D\u0442\u0430 \u0440\u0430\u0431\u043E\u0442\u0430 \u0441\u0442\u0430\u043B\u0430
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0433\u043B\u0430\u0432\u043D\u044B\u0445
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0447\u0438\u0441\u0442\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435, \u043D\u043E \u0438
    \u0432 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u0444\u0438\u0437\u0438\u043A\u0435.
    \u0412 \u0440\u0430\u043C\u043A\u0430\u0445 \u044D\u0442\u0438\u0445 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439
    \u043E\u043D \u0442\u0430\u043A\u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u043B
    **\u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u0443\u044E \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044E**,
    \u0433\u0434\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430 \u043C\u043E\u0436\u0435\u0442
    \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0446\u0435\u043B\u044B\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F,
    \u043D\u043E \u0438 \u043B\u044E\u0431\u044B\u0435 \u0447\u0438\u0441\u043B\u0430
    \u043D\u0430 \u043E\u0442\u0440\u0435\u0437\u043A\u0435 \u043C\u0435\u0436\u0434\u0443
    0 \u0438 1.  *   **\u042D\u0440\u0433\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0442\u0435\u043E\u0440\u0438\u044F**: \u0412 1932 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B
    \u0441\u0435\u0440\u0438\u044E \u0440\u0430\u0431\u043E\u0442, \u0437\u0430\u043B\u043E\u0436\u0438\u0432\u0448\u0438\u0445
    \u043E\u0441\u043D\u043E\u0432\u044B \u044D\u0440\u0433\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u2014 \u0440\u0430\u0437\u0434\u0435\u043B\u0430
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438, \u0438\u0437\u0443\u0447\u0430\u044E\u0449\u0435\u0433\u043E
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0438\u0441\u0442\u0435\u043C \u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u043C.
    \u0415\u0433\u043E **\u044D\u0440\u0433\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0442\u0435\u043E\u0440\u0435\u043C\u0430** \u0441\u0442\u0430\u043B\u0430 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439,
    \u0438, \u043A\u0430\u043A \u043F\u0438\u0441\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A
    \u041F\u043E\u043B \u0425\u0430\u043B\u043C\u043E\u0448, \xAB\u0435\u0441\u043B\u0438
    \u0431\u044B \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u043D\u0435
    \u0441\u0434\u0435\u043B\u0430\u043B \u043D\u0438\u0447\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E,
    \u0438\u0445 \u0431\u044B\u043B\u043E \u0431\u044B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
    \u0447\u0442\u043E\u0431\u044B \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0435\u043C\u0443 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0438\u0435\xBB.  ### \u269B\uFE0F
    \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0430\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430:
    \u043F\u0440\u0438\u0434\u0430\u043D\u0438\u0435 \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u0438
    \u043D\u043E\u0432\u043E\u0439 \u0444\u0438\u0437\u0438\u043A\u0435  \u0424\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D \u043F\u043E \u043F\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u0435\u0439 \u0441\u0442\u0440\u043E\u0433\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u0430 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438.  *   **\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0444\u043E\u0440\u043C\u0430\u043B\u0438\u0437\u043C**: \u0412 1926 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u044B\u0435
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u043A
    \u0432\u0435\u043A\u0442\u043E\u0440\u044B \u0432 **\u0433\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u043E\u0432\u043E\u043C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435**, \u0430
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u044B
    (\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435, \u0438\u043C\u043F\u0443\u043B\u044C\u0441,
    \u044D\u043D\u0435\u0440\u0433\u0438\u044F) \u2014 \u043A\u0430\u043A \u043B\u0438\u043D\u0435\u0439\u043D\u044B\u0435
    \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u044B, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
    \u043D\u0430 \u044D\u0442\u0438 \u0432\u0435\u043A\u0442\u043E\u0440\u044B. \u042D\u0442\u043E
    \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E \u0443\u043D\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0434\u0432\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0432\u0448\u0438\u0435
    \u0442\u043E\u0433\u0434\u0430 \u0432\u0435\u0440\u0441\u0438\u0438 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438 \u2014 \u043C\u0430\u0442\u0440\u0438\u0447\u043D\u0443\u044E
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0443 \u0413\u0435\u0439\u0437\u0435\u043D\u0431\u0435\u0440\u0433\u0430
    \u0438 \u0432\u043E\u043B\u043D\u043E\u0432\u0443\u044E \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0443
    \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440\u0430.  *   **\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043E\u0441\u043D\u043E\u0432\u044B \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438**: \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C
    \u044D\u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u0441\u0442\u0430\u043B\u0430
    \u0435\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u043D\u0438\u0433\u0430 **\"Mathematische Grundlagen der Quantenmechanik\"**
    (\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043E\u0441\u043D\u043E\u0432\u044B \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438), \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u0432 1932 \u0433\u043E\u0434\u0443. \u042D\u0442\u0430 \u043A\u043D\u0438\u0433\u0430
    \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u0441\u0442\u0430\u043B\u0430 \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u043E\u043C
    \u043F\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u0444\u0438\u0437\u0438\u043A\u0435.
    \u0412 \u043D\u0435\u0439 \u043E\u043D, \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438,
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0441\u0442\u0440\u043E\u0433\u0443\u044E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430
    \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u043B
    **\u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u0432**
    (\u0445\u043E\u0442\u044F \u043F\u043E\u0437\u0436\u0435 \u0432 \u043D\u0435\u0439
    \u0431\u044B\u043B \u043D\u0430\u0439\u0434\u0435\u043D \u043A\u043E\u043D\u0446\u0435\u043F\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u043E\u0431\u0435\u043B, \u043E\u043D\u0430 \u043F\u043E\u0440\u043E\u0434\u0438\u043B\u0430
    \u0446\u0435\u043B\u043E\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439, \u043F\u0440\u0438\u0432\u0435\u0434\u0448\u0435\u0435
    \u043A \u0442\u0435\u043E\u0440\u0435\u043C\u0435 \u0411\u0435\u043B\u043B\u0430).
    \u0421\u0430\u043C \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0441\u0447\u0438\u0442\u0430\u043B
    \u0440\u0430\u0431\u043E\u0442\u0443 \u043F\u043E \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0435 \u0441\u0430\u043C\u043E\u0439
    \u0432\u0430\u0436\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E \u0441\u0432\u043E\u0435\u0433\u043E
    \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u044F.  ### \U0001F579\uFE0F \u0422\u0435\u043E\u0440\u0438\u044F
    \u0438\u0433\u0440 \u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430:
    \u043D\u043E\u0432\u0430\u044F \u043D\u0430\u0443\u043A\u0430 \u043E \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u0438
    \u0440\u0435\u0448\u0435\u043D\u0438\u0439  \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043B
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443 \u043A \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0435
    \u2014 \u043E\u043D \u0441\u043E\u0437\u0434\u0430\u043B \u0434\u043B\u044F \u043D\u0435\u0435
    \u043D\u043E\u0432\u044B\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u044F\u0437\u044B\u043A.  *   **\u0422\u0435\u043E\u0440\u0435\u043C\u0430 \u043E
    \u043C\u0438\u043D\u0438\u043C\u0430\u043A\u0441\u0435 (1928)**: \u042D\u0442\u0430
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0441\u0442\u0430\u043B\u0430 \u043E\u0442\u043F\u0440\u0430\u0432\u043D\u043E\u0439
    \u0442\u043E\u0447\u043A\u043E\u0439 \u0434\u043B\u044F \u0432\u0441\u0435\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0438\u0433\u0440. \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0434\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0434\u043B\u044F
    \u043B\u044E\u0431\u043E\u0439 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
    \u0438\u0433\u0440\u044B \u0441 \u043D\u0443\u043B\u0435\u0432\u043E\u0439 \u0441\u0443\u043C\u043C\u043E\u0439
    (\u0433\u0434\u0435 \u0432\u044B\u0438\u0433\u0440\u044B\u0448 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0440\u0430\u0432\u0435\u043D \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0448\u0443
    \u0434\u0440\u0443\u0433\u043E\u0433\u043E) \u0441 \u043F\u043E\u043B\u043D\u043E\u0439
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0435\u0439 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    **\u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F**,
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0430\u044F \u043A\u0430\u0436\u0434\u043E\u043C\u0443
    \u0438\u0433\u0440\u043E\u043A\u0443 \u043C\u0438\u043D\u0438\u043C\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0441\u0432\u043E\u0439 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0439 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0448. 
    *   **\"\u0422\u0435\u043E\u0440\u0438\u044F \u0438\u0433\u0440 \u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435\" (1944)**: \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E
    \u0441 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0441\u0442\u043E\u043C \u041E\u0441\u043A\u0430\u0440\u043E\u043C
    \u041C\u043E\u0440\u0433\u0435\u043D\u0448\u0442\u0435\u0440\u043D\u043E\u043C
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u0442\u0440\u0443\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u0430\u043B\u043E\u0436\u0438\u043B
    \u043E\u0441\u043D\u043E\u0432\u044B **\u0442\u0435\u043E\u0440\u0438\u0438 \u0438\u0433\u0440**
    \u043A\u0430\u043A \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043B
    \u0435\u0435 \u043A \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0435. \u042D\u0442\u0430
    \u043A\u043D\u0438\u0433\u0430 \u0438\u043C\u0435\u043B\u0430 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439
    \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441 \u0438 \u043F\u0440\u0435\u0434\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0430
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0446\u0435\u043B\u043E\u0433\u043E
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043D\u0430\u0443\u043A\u0435, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0431\u044B\u043B\u0438
    \u043F\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043D\u044B \u041D\u043E\u0431\u0435\u043B\u0435\u0432\u0441\u043A\u0438\u0435
    \u043F\u0440\u0435\u043C\u0438\u0438.  *   **\u041E\u0431\u0449\u0435\u0435 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0435**: \u0412 1937 \u0433\u043E\u0434\u0443
    \u043E\u043D \u0440\u0435\u0448\u0438\u043B \u0437\u0430\u0434\u0430\u0447\u0443
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u044F \u0432 \u043C\u043E\u0434\u0435\u043B\u0438
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0440\u043E\u0441\u0442\u0430, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u043E \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0439
    \u0442\u043E\u0447\u043A\u0435. \u042D\u0442\u0430 \u0440\u0430\u0431\u043E\u0442\u0430
    \u0441\u0442\u0430\u043B\u0430 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043E\u0441\u043D\u043E\u0432
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438.  ### \U0001F4BB \u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430  \u042D\u0442\u043E,
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0441\u0430\u043C\u044B\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0432\u043A\u043B\u0430\u0434
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0438\u0437\u043C\u0435\u043D\u0438\u043B \u043C\u0438\u0440. \u0415\u0433\u043E
    \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0435
    \u043F\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430
    **ENIAC** \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u043A \u043F\u0435\u0440\u0435\u043E\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u0438\u044E
    \u0441\u0430\u043C\u043E\u0439 \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u0438
    \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043C\u0430\u0448\u0438\u043D.  *   **\u041F\u0440\u0438\u043D\u0446\u0438\u043F
    \u0445\u0440\u0430\u043D\u0438\u043C\u043E\u0439 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B**:
    \u041A\u043B\u044E\u0447\u0435\u0432\u0430\u044F \u0438\u0434\u0435\u044F, \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u043E\u043C \u0432 **\"\u041F\u0435\u0440\u0432\u043E\u043C
    \u043F\u0440\u043E\u0435\u043A\u0442\u0435 \u043E\u0442\u0447\u0435\u0442\u0430
    \u043E\u0431 EDVAC\" (1945)**, \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u043B\u0430\u0441\u044C
    \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0438 **\u0434\u0430\u043D\u043D\u044B\u0435,
    \u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 (\u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438)
    \u0434\u043E\u043B\u0436\u043D\u044B \u0445\u0440\u0430\u043D\u0438\u0442\u044C\u0441\u044F
    \u0432 \u043E\u0434\u043D\u043E\u0439 \u0438 \u0442\u043E\u0439 \u0436\u0435
    \u043F\u0430\u043C\u044F\u0442\u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430**.
    \u042D\u0442\u043E \u0434\u0435\u043B\u0430\u043B\u043E \u043C\u0430\u0448\u0438\u043D\u0443
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u0443\u0435\u043C\u043E\u0439,
    \u0442\u0430\u043A \u043A\u0430\u043A \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
    \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C,
    \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044F
    \xAB\u0436\u0435\u043B\u0435\u0437\u043E\xBB.  *   **\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430**: \u041E\u043D
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430,
    \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u0438\u0437 \u043F\u044F\u0442\u0438
    \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0447\u0430\u0441\u0442\u0435\u0439:    
    1.  **\u0410\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u043A\u043E-\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E (\u0410\u041B\u0423)**
    \u2014 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F.    
    2.  **\u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    (\u0423\u0423)** \u2014 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
    \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u043C \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u043A\u043E\u043C\u0430\u043D\u0434.     3.  **\u041F\u0430\u043C\u044F\u0442\u044C**
    \u2014 \u0445\u0440\u0430\u043D\u0438\u0442 \u0434\u0430\u043D\u043D\u044B\u0435
    \u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u044B.     4.  **\u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430
    \u0432\u0432\u043E\u0434\u0430** \u2014 \u0434\u043B\u044F \u0432\u0432\u043E\u0434\u0430
    \u0434\u0430\u043D\u043D\u044B\u0445.     5.  **\u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430
    \u0432\u044B\u0432\u043E\u0434\u0430** \u2014 \u0434\u043B\u044F \u0432\u044B\u0432\u043E\u0434\u0430
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432.  *   **\u0414\u0432\u043E\u0438\u0447\u043D\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430**: \u041E\u043D \u043D\u0430\u0441\u0442\u043E\u044F\u043B
    \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    **\u0434\u0432\u043E\u0438\u0447\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F** (\u0432\u043C\u0435\u0441\u0442\u043E
    \u0434\u0435\u0441\u044F\u0442\u0438\u0447\u043D\u043E\u0439, \u043A\u0430\u043A
    \u0432 ENIAC), \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0443\u043F\u0440\u043E\u0441\u0442\u0438\u043B\u043E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430.  \u042D\u0442\u0430
    \u043C\u043E\u0434\u0435\u043B\u044C, \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0430\u044F
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 **\u0444\u043E\u043D-\u043D\u0435\u0439\u043C\u0430\u043D\u043E\u0432\u0441\u043A\u043E\u0439
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B**, \u0434\u043E
    \u0441\u0438\u0445 \u043F\u043E\u0440 \u043B\u0435\u0436\u0438\u0442 \u0432 \u043E\u0441\u043D\u043E\u0432\u0435
    \u043F\u043E\u0434\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430
    \u0432\u0441\u0435\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u0432, \u043E\u0442
    \u0441\u043C\u0430\u0440\u0442\u0444\u043E\u043D\u043E\u0432 \u0434\u043E \u0441\u0443\u043F\u0435\u0440\u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u0432. 
    ### \U0001F4A3 \u0412\u043E\u0435\u043D\u043D\u044B\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438:
    \u043E\u0442 \u0430\u0442\u043E\u043C\u043D\u043E\u0439 \u0431\u043E\u043C\u0431\u044B
    \u0434\u043E \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0430\u043A\u0435\u0442  \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u0444\u0438\u0433\u0443\u0440 \u0432 \u043D\u0430\u0443\u0447\u043D\u043E-\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u0445 \u0421\u0428\u0410 \u0432\u043E
    \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u043E\u0441\u043B\u0435 \u0412\u0442\u043E\u0440\u043E\u0439
    \u043C\u0438\u0440\u043E\u0432\u043E\u0439 \u0432\u043E\u0439\u043D\u044B.  *  
    **\u041C\u0430\u043D\u0445\u044D\u0442\u0442\u0435\u043D\u0441\u043A\u0438\u0439
    \u043F\u0440\u043E\u0435\u043A\u0442**: \u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u043D\u0442\u0430 \u041B\u043E\u0441-\u0410\u043B\u0430\u043C\u043E\u0441\u0441\u043A\u043E\u0439
    \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u043E\u043D
    \u0432\u043D\u0435\u0441 \u0440\u0435\u0448\u0430\u044E\u0449\u0438\u0439 \u0432\u043A\u043B\u0430\u0434
    \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0443 **\u0438\u043C\u043F\u043B\u043E\u0437\u0438\u0432\u043D\u043E\u0433\u043E
    \u043C\u0435\u0442\u043E\u0434\u0430** \u043F\u043E\u0434\u0440\u044B\u0432\u0430
    \u043F\u043B\u0443\u0442\u043E\u043D\u0438\u0435\u0432\u043E\u0439 \u0431\u043E\u043C\u0431\u044B.
    \u041E\u043D \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043C\u043E\u0434\u0435\u043B\u044C \xAB\u0432\u0437\u0440\u044B\u0432\u043D\u044B\u0445
    \u043B\u0438\u043D\u0437\xBB \u2014 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0432\u0437\u0440\u044B\u0432\u0447\u0430\u0442\u044B\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u0436\u0438\u043C\u0430\u043B\u0430
    \u043F\u043B\u0443\u0442\u043E\u043D\u0438\u0435\u0432\u044B\u0439 \u0448\u0430\u0440
    \u0434\u043E \u0441\u0432\u0435\u0440\u0445\u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0441 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0435\u0439. \u0418\u043C\u0435\u043D\u043D\u043E
    \u044D\u0442\u0430 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
    \u0431\u044B\u043B\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0430
    \u0432 \u0431\u043E\u043C\u0431\u0435 \xAB\u0422\u043E\u043B\u0441\u0442\u044F\u043A\xBB,
    \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0439 \u043D\u0430 \u041D\u0430\u0433\u0430\u0441\u0430\u043A\u0438. 
    *   **\u0412\u043E\u0434\u043E\u0440\u043E\u0434\u043D\u0430\u044F \u0431\u043E\u043C\u0431\u0430**:
    \u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0439\u043D\u044B \u043E\u043D \u0431\u044B\u043B
    \u0432\u0435\u0434\u0443\u0449\u0438\u043C \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u043D\u0442\u043E\u043C
    \u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435
    \u0442\u0435\u0440\u043C\u043E\u044F\u0434\u0435\u0440\u043D\u043E\u0433\u043E
    \u043E\u0440\u0443\u0436\u0438\u044F, \u0440\u0430\u0431\u043E\u0442\u0430\u044F
    \u043D\u0430\u0434 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u043C\u0438 \u0430\u0441\u043F\u0435\u043A\u0442\u0430\u043C\u0438
    \u0444\u0438\u0437\u0438\u043A\u0438 \u0442\u0435\u0440\u043C\u043E\u044F\u0434\u0435\u0440\u043D\u044B\u0445
    \u0440\u0435\u0430\u043A\u0446\u0438\u0439.  *   **\u0411\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0440\u0430\u043A\u0435\u0442\u044B**: \u0412 1950-\u0435 \u0433\u043E\u0434\u044B
    \u043E\u043D \u0431\u044B\u043B \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u043D\u0430\u0443\u0447\u043D\u044B\u043C
    \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u043C \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0421\u0428\u0410 \u0438 \u0441\u044B\u0433\u0440\u0430\u043B \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E
    \u0440\u043E\u043B\u044C \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u043F\u0435\u0440\u0432\u044B\u0445
    **\u043C\u0435\u0436\u043A\u043E\u043D\u0442\u0438\u043D\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0430\u043A\u0435\u0442 (\u041C\u0411\u0420)** \u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438
    \u044F\u0434\u0435\u0440\u043D\u043E\u0433\u043E \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043D\u0438\u044F. 
    ### \U0001F9EC \u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0436\u0438\u0437\u043D\u044C \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0434\u0435\u0438 
    \u0413\u0435\u043D\u0438\u0439 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430
    \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0438 \u0432 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438
    \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0442\u0430\u043B\u0438 \u043E\u0441\u043D\u043E\u0432\u043E\u0439 \u0434\u043B\u044F
    \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u043D\u0430\u0443\u0447\u043D\u044B\u0445
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439.  *   **\u0421\u0430\u043C\u043E\u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0449\u0438\u0435\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B \u0438 \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u044B\u0435
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B**: \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B \u0436\u0438\u0437\u043D\u0438 \u043E\u043D \u0438\u0437\u0443\u0447\u0430\u043B
    \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F
    \u043C\u0430\u0448\u0438\u043D\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043C\u043E\u0433\u043B\u0430 \u0431\u044B \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u044C
    \u0441\u0430\u043C\u0443 \u0441\u0435\u0431\u044F. \u041E\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0430\u0431\u0441\u0442\u0440\u0430\u043A\u0442\u043D\u0443\u044E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043C\u043E\u0434\u0435\u043B\u044C \u2014 **\u043A\u043B\u0435\u0442\u043E\u0447\u043D\u044B\u0439
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442** (\u0441\u043E\u0432\u043E\u043A\u0443\u043F\u043D\u043E\u0441\u0442\u044C
    \u044F\u0447\u0435\u0435\u043A, \u043C\u0435\u043D\u044F\u044E\u0449\u0438\u0445
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043F\u043E \u0437\u0430\u0434\u0430\u043D\u043D\u044B\u043C
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C) \u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442
    \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \xAB\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
    \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\xBB, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0439
    \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0441\u0432\u043E\u044E \u043A\u043E\u043F\u0438\u044E.
    \u042D\u0442\u0430 \u0440\u0430\u0431\u043E\u0442\u0430, \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u043F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u043E, \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0437\u0430\u043B\u043E\u0436\u0438\u043B\u0430 \u043E\u0441\u043D\u043E\u0432\u044B
    \u0442\u0435\u043E\u0440\u0438\u0438 **\u0441\u0430\u043C\u043E\u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C** \u0438 **\u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438**, \u043D\u043E \u0438, \u043A\u0430\u043A \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F,
    \u043F\u0440\u0435\u0434\u0432\u043E\u0441\u0445\u0438\u0442\u0438\u043B\u0430
    \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B
    \u0414\u041D\u041A.  *   **\u041C\u0435\u0442\u043E\u0434 \u041C\u043E\u043D\u0442\u0435-\u041A\u0430\u0440\u043B\u043E**:
    \u041E\u043D \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u043E\u0440\u043E\u0432
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u0435\u0442\u043E\u0434\u0430 **\u041C\u043E\u043D\u0442\u0435-\u041A\u0430\u0440\u043B\u043E**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435 \u0432\u044B\u0431\u043E\u0440\u043A\u0438
    \u0434\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0441\u043B\u043E\u0436\u043D\u044B\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0437\u0430\u0434\u0430\u0447.
    \u042D\u0442\u043E\u0442 \u043C\u0435\u0442\u043E\u0434 \u0441\u0442\u0430\u043B
    \u043D\u0435\u0437\u0430\u043C\u0435\u043D\u0438\u043C\u044B\u043C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C
    \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438
    \u044F\u0434\u0435\u0440\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F
    \u0438 \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043D\u0430\u0448\u0435\u043B \u0448\u0438\u0440\u043E\u043A\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
    \u0432 \u0444\u0438\u0437\u0438\u043A\u0435, \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0435
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043E\u0431\u043B\u0430\u0441\u0442\u044F\u0445. 
    *   **\"\u041A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440 \u0438 \u043C\u043E\u0437\u0433\"**:
    \u0415\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F, \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u043D\u0430\u044F
    \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C, \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u043F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u043E, \u0431\u044B\u043B\u0430
    \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u0430 \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B \u0438 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u0432
    \u0440\u0430\u0431\u043E\u0442\u044B \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043C\u0430\u0448\u0438\u043D \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u043E\u0437\u0433\u0430. \u0412 \u043D\u0435\u0439 \u043E\u043D \u0437\u0430\u0442\u0440\u043E\u043D\u0443\u043B
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0432\u043E\u043F\u0440\u043E\u0441\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
    \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
    \u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u044B\u0445 \u043D\u0430\u0443\u043A
    \u0438 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430.  \u0414\u0436\u043E\u043D
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0437\u0430 \u0441\u0432\u043E\u0438
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u0431\u044B\u043B
    \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0430
    \u043D\u0430\u0433\u0440\u0430\u0434, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    **\u041F\u0440\u0435\u043C\u0438\u044E \u0411\u043E\u0445\u0435\u0440\u0430 (1938)**
    , **\u041F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u0441\u043A\u0443\u044E
    \u043C\u0435\u0434\u0430\u043B\u044C \u0421\u0432\u043E\u0431\u043E\u0434\u044B
    (1956)** \u0438 **\u041F\u0440\u0435\u043C\u0438\u044E \u042D\u043D\u0440\u0438\u043A\u043E
    \u0424\u0435\u0440\u043C\u0438 (1956)** , \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0437\u0430 \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0435\u0441\u044F
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u0432 \u043D\u0430\u0443\u043A\u0435
    \u0438 \u0442\u0435\u0445\u043D\u0438\u043A\u0435."
  achievementsEn: 
  personalLifeRu: "\u0416\u0438\u0437\u043D\u044C \u0414\u0436\u043E\u043D\u0430
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430 \u2014 \u044D\u0442\u043E
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u0440\u0435\u0434\u0430
    \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u0437\u0430\u0440\u0435\u043D\u0438\u0439,
    \u043D\u043E \u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u043C\u0435\u043B \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F
    \u0436\u0438\u0437\u043D\u044C\u044E, \u0431\u044B\u043B \u0434\u0443\u0448\u043E\u0439
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0438 \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u043E\u0439
    \u0444\u0438\u0433\u0443\u0440\u043E\u0439 \u0434\u043B\u044F \u043C\u043D\u043E\u0433\u0438\u0445
    \u043A\u043E\u043B\u043B\u0435\u0433. \u0415\u0433\u043E \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F
    \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430 \u044F\u0440\u043A\u0438\u043C\u0438
    \u044D\u043F\u0438\u0437\u043E\u0434\u0430\u043C\u0438, \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u044E\u0449\u0438\u043C\u0438
    \u0435\u0433\u043E \u043A\u0430\u043A \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C. 
    \u041D\u0438\u0436\u0435 \u2014 \u0445\u0440\u043E\u043D\u043E\u043B\u043E\u0433\u0438\u044F
    \u0438 \u0434\u0435\u0442\u0430\u043B\u0438 \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438, \u043A\u0430\u0440\u044C\u0435\u0440\u043D\u043E\u0433\u043E
    \u043F\u0443\u0442\u0438 \u0438 \u0432\u0437\u0430\u0438\u043C\u043E\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0439
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u043C\u0438\u0441\u044F
    \u0443\u043C\u0430\u043C\u0438 XX \u0432\u0435\u043A\u0430.  ### \U0001F37C \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043E \u0432 \u0411\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u0435 
    \u0414\u0436\u043E\u043D \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0440\u043E\u0434\u0438\u043B\u0441\u044F **28 \u0434\u0435\u043A\u0430\u0431\u0440\u044F
    1903 \u0433\u043E\u0434\u0430** \u0432 \u0441\u0442\u043E\u043B\u0438\u0446\u0435
    \u0412\u0435\u043D\u0433\u0440\u0438\u0438, \u0411\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u0435.
    \u041D\u0430 \u0441\u0432\u0435\u0442 \u043E\u043D \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u0432 \u0431\u043E\u0433\u0430\u0442\u043E\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0439
    \u0441\u0435\u043C\u044C\u0435, \u0432 \u0434\u043E\u043C\u0435, \u0433\u0434\u0435
    \u0446\u0430\u0440\u0438\u043B\u0430 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043B\u0438\u0431\u0435\u0440\u0430\u043B\u0438\u0437\u043C\u0430.  *   **\u0421\u0435\u043C\u0435\u0439\u043D\u043E\u0435
    \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435:** \u0414\u043E\u043C
    \u041D\u0435\u0439\u043C\u0430\u043D\u043E\u0432 \u0431\u044B\u043B \u043C\u0435\u0441\u0442\u043E\u043C
    \u0432\u0441\u0442\u0440\u0435\u0447 \u0431\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u0441\u043A\u043E\u0439
    \u044D\u043B\u0438\u0442\u044B. \u041E\u0442\u0435\u0446, \u041C\u0430\u043A\u0441
    \u041D\u0435\u0439\u043C\u0430\u043D, \u0447\u0430\u0441\u0442\u043E \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B
    \u043E\u0431\u0435\u0434\u044B, \u0433\u0434\u0435 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B\u0438\u0441\u044C
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0430, \u043D\u0430\u0443\u043A\u0430
    \u0438 \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u043E\u0435 \u0434\u0435\u043B\u043E.
    \u041C\u0430\u0442\u044C, \u041C\u0430\u0440\u0433\u0438\u0442, \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430
    \u0438\u0437 \u0441\u0435\u043C\u044C\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0446\u0435\u043D\u0438\u043B\u0430 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435.
    \u0423 \u042F\u043D\u043E\u0448\u0430 \u0431\u044B\u043B\u043E \u0434\u0432\u0430
    \u043C\u043B\u0430\u0434\u0448\u0438\u0445 \u0431\u0440\u0430\u0442\u0430 \u2014
    \u041C\u0438\u0445\u0430\u044D\u043B\u044C \u0438 \u041D\u0438\u043A\u043E\u043B\u0430\u0441.
    *   **\u041F\u0435\u0440\u0432\u044B\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F
    \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438:** \u0421\u0435\u043C\u044C\u044F
    \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0430, \u0447\u0442\u043E
    \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 4-5 \u043B\u0435\u0442
    \u042F\u043D\u043E\u0448 \u043C\u043E\u0433 \u0443\u0434\u0438\u0432\u0438\u0442\u044C
    \u0433\u043E\u0441\u0442\u0435\u0439, \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0432
    \u0432 \u0443\u043C\u0435 \u0434\u0432\u0430 \u043C\u043D\u043E\u0433\u043E\u0437\u043D\u0430\u0447\u043D\u044B\u0445
    \u0447\u0438\u0441\u043B\u0430 \u0438\u043B\u0438 \u0432\u0441\u0442\u0430\u0432\u0438\u0432
    \u043E\u0441\u0442\u0440\u043E\u0443\u043C\u043D\u0443\u044E \u0440\u0435\u043F\u043B\u0438\u043A\u0443
    \u043D\u0430 \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043A\u043E\u043C
    \u044F\u0437\u044B\u043A\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D
    \u0432\u044B\u0443\u0447\u0438\u043B \u043F\u043E \u043A\u043D\u0438\u0433\u0430\u043C
    \u0438\u0437 \u043E\u0442\u0446\u043E\u0432\u0441\u043A\u043E\u0439 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438.
    \u0415\u0433\u043E \u043E\u0442\u0435\u0446, \u0433\u043E\u0440\u0434\u044F\u0441\u044C
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u0441\u044B\u043D\u0430, \u0442\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435,
    \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043B \u043D\u0430 \u0432\u0441\u0435\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438, \u043D\u0430\u043D\u0438\u043C\u0430\u044F
    \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u0439 \u043F\u043E \u044F\u0437\u044B\u043A\u0430\u043C,
    \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0438 \u043C\u0443\u0437\u044B\u043A\u0435. 
    ### \U0001F393 \u0423\u0447\u0451\u0431\u0430: \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F,
    \u0426\u044E\u0440\u0438\u0445 \u0438 \u0434\u043E\u043A\u0442\u043E\u0440\u0430\u0442 
    \u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0444\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D\u0430 \u0431\u044B\u043B\u043E \u043D\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043B\u044C\u043D\u044B\u043C
    \u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u043E \u0435\u0433\u043E \u043A\u043E\u043B\u043E\u0441\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438. 
    *   **\u0413\u0438\u043C\u043D\u0430\u0437\u0438\u044F (1911\u20131921):** \u041E\u043D
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0443\u044E
    \u043B\u044E\u0442\u0435\u0440\u0430\u043D\u0441\u043A\u0443\u044E \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044E
    \u0411\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0441\u043B\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0432\u044B\u0441\u043E\u043A\u0438\u043C
    \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u044F.
    \u0423\u0447\u0438\u0442\u0435\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E
    \u043F\u043E\u043D\u044F\u043B\u0438, \u0447\u0442\u043E \u043E\u043D \u0434\u0430\u043B\u0435\u043A\u043E
    \u043E\u043F\u0435\u0440\u0435\u0436\u0430\u0435\u0442 \u0441\u0432\u0435\u0440\u0441\u0442\u043D\u0438\u043A\u043E\u0432.
    \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A \u041B\u0430\u0441\u043B\u043E
    \u0420\u0430\u0446, \u0437\u0430\u043C\u0435\u0442\u0438\u0432 \u0435\u0433\u043E
    \u0442\u0430\u043B\u0430\u043D\u0442, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043B
    \u043E\u0431\u0443\u0447\u0430\u0442\u044C \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0430
    \u043F\u043E \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0435. *   **\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043A\u0438\u0435
    \u0433\u043E\u0434\u044B (1921\u20131926):** \u041F\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u0438\u044E
    \u043E\u0442\u0446\u0430, \u0436\u0435\u043B\u0430\u0432\u0448\u0435\u0433\u043E,
    \u0447\u0442\u043E\u0431\u044B \u0441\u044B\u043D \u0438\u043C\u0435\u043B \xAB\u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E\xBB
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044E, \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 **\u0426\u044E\u0440\u0438\u0445\u0441\u043A\u0438\u0439
    \u043F\u043E\u043B\u0438\u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C** \u043D\u0430
    \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442.
    \u041E\u0434\u043D\u0430\u043A\u043E \u043E\u043D \u043D\u0435 \u0445\u043E\u0442\u0435\u043B
    \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443.
    \u041E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0430 \u0437\u0430\u043E\u0447\u043D\u043E\u0435
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0432 **\u0411\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442** \u0434\u043B\u044F
    \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438,
    \u043F\u043E\u0441\u0435\u0449\u0430\u044F \u043B\u0435\u043A\u0446\u0438\u0438
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u043E\u043D\u0446\u0435 \u0441\u0435\u043C\u0435\u0441\u0442\u0440\u043E\u0432,
    \u0447\u0442\u043E\u0431\u044B \u0441\u0434\u0430\u0432\u0430\u0442\u044C \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u044B.
    *   **\u0422\u0440\u043E\u0439\u043D\u043E\u0439 \u0443\u0447\u0435\u0431\u043D\u044B\u0439
    \u043F\u043B\u0430\u043D:** \u0412 1921\u20131923 \u0433\u043E\u0434\u0430\u0445
    \u043E\u043D \u0443\u0447\u0438\u043B\u0441\u044F \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0430
    \u0437\u0430\u0442\u0435\u043C \u043F\u0435\u0440\u0435\u0448\u0435\u043B \u0432
    \u0426\u044E\u0440\u0438\u0445. \u0412\u043C\u0435\u0441\u0442\u043E \u0442\u043E\u0433\u043E
    \u0447\u0442\u043E\u0431\u044B \u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432
    \u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435, \u043E\u043D \u043A\u0443\u0440\u0441\u0438\u0440\u043E\u0432\u0430\u043B
    \u043C\u0435\u0436\u0434\u0443 \u0426\u044E\u0440\u0438\u0445\u043E\u043C, \u0411\u0435\u0440\u043B\u0438\u043D\u043E\u043C
    \u0438 \u0411\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u043E\u043C. \u0412 1925
    \u0433\u043E\u0434\u0443 \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0434\u0438\u043F\u043B\u043E\u043C \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430-\u0445\u0438\u043C\u0438\u043A\u0430
    \u0432 \u0426\u044E\u0440\u0438\u0445\u0435. \u0412 1926 \u0433\u043E\u0434\u0443
    \u043E\u043D \u0437\u0430\u0449\u0438\u0442\u0438\u043B \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E \u043F\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u0432 \u0411\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (PhD
    summa cum laude). \u0415\u0433\u043E \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044F,
    \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0430\u044F \u0430\u043A\u0441\u0438\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0442\u0435\u043E\u0440\u0438\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432,
    \u0431\u044B\u043B\u0430 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430 \u0435\u0449\u0435
    \u0434\u043E \u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u0434\u0438\u043F\u043B\u043E\u043C\u0430
    \u0445\u0438\u043C\u0438\u043A\u0430.  ### \U0001F468\u200D\U0001F3EB \u0420\u0430\u0431\u043E\u0442\u0430
    \u0432 \u0415\u0432\u0440\u043E\u043F\u0435 \u0438 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 
    \u041A\u0430\u0440\u044C\u0435\u0440\u0430 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430
    \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043B\u0430\u0441\u044C
    \u0441 \u0441\u0430\u043C\u043E\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u0430. 
    *   **\u0415\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0439 \u043F\u0435\u0440\u0438\u043E\u0434
    (1927\u20131930):** \u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u0449\u0438\u0442\u044B
    \u043E\u043D \u0441\u0442\u0430\u043B \u043F\u0440\u0438\u0432\u0430\u0442-\u0434\u043E\u0446\u0435\u043D\u0442\u043E\u043C
    \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043C \u0432 \u0413\u0430\u043C\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u043C.
    \u0412 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434 \u043E\u043D
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u043B
    \u0441 \u0414\u0430\u0432\u0438\u0434\u043E\u043C \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u043E\u043C
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0435, \u0440\u0430\u0431\u043E\u0442\u0430\u044F
    \u043D\u0430\u0434 \u043E\u0441\u043D\u043E\u0432\u0430\u043C\u0438 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438. \u0418\u043C\u0435\u043D\u043D\u043E
    \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0435\u0433\u043E \u0438\u043C\u044F
    \u0441\u0442\u0430\u043B\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E
    \u0432 \u043C\u0438\u0440\u043E\u0432\u044B\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043A\u0440\u0443\u0433\u0430\u0445. *   **\u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D,
    \u0421\u0428\u0410 (\u0441 1930):** \u0412 1930 \u0433\u043E\u0434\u0443 \u043E\u043D
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
    \u043E\u0442 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u041F\u043E
    \u043B\u0435\u0433\u0435\u043D\u0434\u0435, \u0435\u0433\u043E \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B\u0438,
    \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0432 \u0432\u0441\u0435\u0433\u043E
    \u043E\u0434\u043D\u0443 \u0435\u0433\u043E \u0441\u0442\u0430\u0442\u044C\u044E.    
    *   \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u043D \u0431\u044B\u043B
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435.    
    *   \u0412 **1933 \u0433\u043E\u0434\u0443**, \u043A\u043E\u0433\u0434\u0430
    \u0431\u044B\u043B \u043E\u0441\u043D\u043E\u0432\u0430\u043D \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442
    \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 (IAS),
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0441\u0442\u0430\u043B
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0435\u0433\u043E \u0448\u0435\u0441\u0442\u0438
    \u043F\u043E\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u0432
    (\u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0410\u043B\u044C\u0431\u0435\u0440\u0442\u043E\u043C
    \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D\u043E\u043C, \u041A\u0443\u0440\u0442\u043E\u043C
    \u0413\u0451\u0434\u0435\u043B\u0435\u043C \u0438 \u0434\u0440\u0443\u0433\u0438\u043C\u0438).
    \u042D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u043E\u043D \u0437\u0430\u043D\u0438\u043C\u0430\u043B
    \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438.
    \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E \u043E\u043D
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F
    \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439
    \u0440\u0443\u0442\u0438\u043D\u043E\u0439 \u0438 \u043D\u0435 \u0431\u0440\u0430\u043B
    \u043D\u0430 \u0441\u0435\u0431\u044F \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u043A\u0430\u0444\u0435\u0434\u0440\u0430\u043C\u0438, \u043F\u043E\u0441\u0432\u044F\u0449\u0430\u044F
    \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u043C. 
    ### \U0001F495 \u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C:
    \u0434\u0432\u0430 \u0431\u0440\u0430\u043A\u0430 \u0438 \u043E\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043D\u0438  \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0431\u044B\u043B \u0436\u0438\u0432\u044B\u043C, \u043E\u0431\u0449\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0438 \u0436\u0438\u0437\u043D\u0435\u0440\u0430\u0434\u043E\u0441\u0442\u043D\u044B\u043C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u0447\u0442\u043E \u0440\u0435\u0437\u043A\u043E
    \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u043E
    \u0441 \u043E\u0431\u0440\u0430\u0437\u043E\u043C \xAB\u0437\u0430\u043C\u043A\u043D\u0443\u0442\u043E\u0433\u043E
    \u0433\u0435\u043D\u0438\u044F\xBB.  *   **\u041F\u0435\u0440\u0432\u044B\u0439
    \u0431\u0440\u0430\u043A (1935\u20131937):** \u0412 1935 \u0433\u043E\u0434\u0443
    \u043E\u043D \u0436\u0435\u043D\u0438\u043B\u0441\u044F \u043D\u0430 \u041C\u0430\u0440\u0438\u0435\u0442\u0442\u0435
    \u041A\u043E\u0432\u0435\u0448\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0431\u044B\u043B\u0430 \u0438\u0437 \u0437\u043D\u0430\u0442\u043D\u043E\u0439
    \u0432\u0435\u043D\u0433\u0435\u0440\u0441\u043A\u043E\u0439 \u0441\u0435\u043C\u044C\u0438.
    \u0412 1936 \u0433\u043E\u0434\u0443 \u0443 \u043D\u0438\u0445 \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u0434\u043E\u0447\u044C **\u041C\u0430\u0440\u0438\u043D\u0430**, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0441\u0442\u0430\u043B\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0441\u0442\u043E\u043C.
    *   **\u0420\u0430\u0437\u0432\u043E\u0434 \u0438 \u0432\u0442\u043E\u0440\u043E\u0439
    \u0431\u0440\u0430\u043A:** \u0411\u0440\u0430\u043A \u0431\u044B\u043B \u043D\u0435\u0434\u043E\u043B\u0433\u0438\u043C.
    \u0412 1937 \u0433\u043E\u0434\u0443 \u043E\u043D \u0440\u0430\u0437\u0432\u0435\u043B\u0441\u044F.
    \u0412\u0441\u043A\u043E\u0440\u0435 \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
    \u043E\u043D \u0436\u0435\u043D\u0438\u043B\u0441\u044F \u043D\u0430 **\u041A\u043B\u0430\u0440\u0435
    \u0414\u044D\u043D**, \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0434\u043D\u043E\u0439 \u0438\u0437
    \u043F\u043E\u0435\u0437\u0434\u043E\u043A. \u041A\u043B\u0430\u0440\u0430 \u0431\u044B\u043B\u0430
    \u0443\u043C\u043D\u043E\u0439, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0436\u0435\u043D\u0449\u0438\u043D\u043E\u0439, \u0438\u043C\u0435\u0432\u0448\u0435\u0439
    \u043E\u043F\u044B\u0442 \u0432 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438
    \u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
    \u043E\u0442 \u0441\u0432\u043E\u0435\u0439 \u043F\u0435\u0440\u0432\u043E\u0439
    \u0436\u0435\u043D\u044B, \u041A\u043B\u0430\u0440\u0430 \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u0432 \u043D\u0430\u0443\u0447\u043D\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u0435 \u043C\u0443\u0436\u0430: \u043E\u043D\u0430
    \u043F\u0438\u0441\u0430\u043B\u0430 \u043A\u043E\u0434 \u0434\u043B\u044F \u043F\u0435\u0440\u0432\u044B\u0445
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u0432, \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u0430
    \u0441 \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u043C\u0438 \u0434\u043B\u044F
    \u041C\u0430\u043D\u0445\u044D\u0442\u0442\u0435\u043D\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0438 \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0430
    \u0435\u0433\u043E \u0442\u0440\u0443\u0434\u044B. \u0418\u0445 \u0431\u0440\u0430\u043A
    \u0431\u044B\u043B \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C
    \u0438 \u043F\u0440\u043E\u0434\u043B\u0438\u043B\u0441\u044F \u0434\u043E \u0441\u0430\u043C\u043E\u0439
    \u0441\u043C\u0435\u0440\u0442\u0438 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430.
    \u0414\u0435\u0442\u0435\u0439 \u0432 \u044D\u0442\u043E\u043C \u0431\u0440\u0430\u043A\u0435
    \u043D\u0435 \u0431\u044B\u043B\u043E. *   **\u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440
    \u0438 \u043E\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043D\u0438:** \u0424\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D \u0431\u044B\u043B \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u0441\u0432\u043E\u0435\u0439 \u043B\u044E\u0431\u043E\u0432\u044C\u044E \u043A
    \u0431\u0443\u0440\u043D\u044B\u043C \u0432\u0435\u0447\u0435\u0440\u0438\u043D\u043A\u0430\u043C,
    \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0435\u0434\u0435 \u0438 \u0434\u043E\u0440\u043E\u0433\u0438\u043C
    \u043A\u043E\u0441\u0442\u044E\u043C\u0430\u043C. \u0415\u0433\u043E \u0434\u043E\u043C
    \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 \u0447\u0430\u0441\u0442\u043E
    \u0431\u044B\u043B \u043E\u0442\u043A\u0440\u044B\u0442 \u0434\u043B\u044F \u043A\u043E\u043B\u043B\u0435\u0433
    \u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432. \u041E\u043D \u043E\u0431\u043E\u0436\u0430\u043B
    \u0448\u0443\u0442\u043A\u0438, \u0430\u043D\u0435\u043A\u0434\u043E\u0442\u044B
    (\u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0435) \u0438 \u0431\u044B\u043B
    \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0447\u0438\u043A\u043E\u043C.
    \u0423 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043F\u043E \u043D\u043E\u0447\u0430\u043C,
    \u0441\u043B\u0443\u0448\u0430\u044F \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043C\u0443\u0437\u044B\u043A\u0443 (\u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0412\u0430\u0433\u043D\u0435\u0440\u0430) \u043D\u0430 \u043F\u043E\u043B\u043D\u043E\u0439
    \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u0438, \u0447\u0442\u043E, \u043F\u043E
    \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430\u043C, \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u043E
    \u0435\u043C\u0443 \u0434\u0443\u043C\u0430\u0442\u044C.  ### \U0001F91D \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0443\u0447\u0451\u043D\u044B\u043C\u0438:
    \u043E\u0442 \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D\u0430 \u0434\u043E
    \u0413\u0451\u0434\u0435\u043B\u044F  \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0431\u044B\u043B \u043D\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435
    \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u0435\u043D \u0438 \u043B\u0438\u0448\u0435\u043D
    \u0432\u044B\u0441\u043E\u043A\u043E\u043C\u0435\u0440\u0438\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0435\u0433\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441
    \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438 \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C
    \u0431\u044B\u043B\u0438 \u0442\u0435\u043F\u043B\u044B\u043C\u0438 \u0438\u043B\u0438
    \u043A\u0440\u0430\u0439\u043D\u0435 \u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438. 
    *   **\u0421 \u0410\u043B\u044C\u0431\u0435\u0440\u0442\u043E\u043C \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D\u043E\u043C:**
    \u041E\u043D\u0438 \u0431\u044B\u043B\u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438
    \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0440\u0430\u0437\u043D\u0438\u0446\u0443 \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    \u0438 \u0441\u043A\u043B\u0430\u0434\u0435 \u0443\u043C\u0430, \u043E\u043D\u0438
    \u0447\u0430\u0441\u0442\u043E \u0433\u0443\u043B\u044F\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435
    \u043F\u043E \u043A\u0430\u043C\u043F\u0443\u0441\u0443, \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044F
    \u0444\u0438\u0437\u0438\u043A\u0443. \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0446\u0435\u043D\u0438\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043C\u043E\u0449\u044C \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430,
    \u043A\u0430\u043A-\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
    \xAB\u0436\u0430\u043B\u0435\u0435\u0442\xBB, \u0447\u0442\u043E \u0442\u043E\u0442
    \u0443\u0448\u0435\u043B \u0438\u0437 \u0447\u0438\u0441\u0442\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0432 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u044B\u0435 \u043E\u0431\u043B\u0430\u0441\u0442\u0438.
    *   **\u0421 \u041A\u0443\u0440\u0442\u043E\u043C \u0413\u0451\u0434\u0435\u043B\u0435\u043C:**
    \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0431\u044B\u043B\u0438
    \u0441\u043B\u043E\u0436\u043D\u044B\u043C\u0438. \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0431\u044B\u043B \u0432 \u0432\u043E\u0441\u0442\u043E\u0440\u0433\u0435 \u043E\u0442
    \u0442\u0435\u043E\u0440\u0435\u043C \u0413\u0451\u0434\u0435\u043B\u044F \u043E
    \u043D\u0435\u043F\u043E\u043B\u043D\u043E\u0442\u0435. \u0413\u0451\u0434\u0435\u043B\u044C,
    \u0432 \u0441\u0432\u043E\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u0443\u0432\u0430\u0436\u0430\u043B
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430, \u043D\u043E \u0441\u0447\u0438\u0442\u0430\u043B
    \u0435\u0433\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \xAB\u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u044B\u043C\xBB
    \u0438 \xAB\u043F\u0440\u0430\u0433\u043C\u0430\u0442\u0438\u0447\u043D\u044B\u043C\xBB.
    *   **\u0421 \u041E\u0441\u043A\u0430\u0440\u043E\u043C \u041C\u043E\u0440\u0433\u0435\u043D\u0448\u0442\u0435\u0440\u043D\u043E\u043C:**
    \u0418\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043D\u0430\u0434 \u043A\u043D\u0438\u0433\u043E\u0439 \xAB\u0422\u0435\u043E\u0440\u0438\u044F
    \u0438\u0433\u0440\xBB \u043F\u0435\u0440\u0435\u0440\u043E\u0441\u043B\u043E
    \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u0434\u0440\u0443\u0436\u0431\u0443.
    \u041C\u043E\u0440\u0433\u0435\u043D\u0448\u0442\u0435\u0440\u043D \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B,
    \u0447\u0442\u043E \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0431\u044B\u043B
    \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u044B\u043C
    \u0438 \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u044B\u043C, \u043A\u043E\u0433\u0434\u0430
    \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u043B \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0441\u0442\u0443
    \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u0438. *   **\u0421 \u042D\u0434\u0432\u0430\u0440\u0434\u043E\u043C
    \u0422\u0435\u043B\u043B\u0435\u0440\u043E\u043C \u0438 \u0421\u0442\u0430\u043D\u0438\u0441\u043B\u0430\u0432\u043E\u043C
    \u0423\u043B\u0430\u043C\u043E\u043C:** \u0421 \u043D\u0438\u043C\u0438 \u0435\u0433\u043E
    \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043B\u0430 \u0442\u0435\u0441\u043D\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0432 \u041B\u043E\u0441-\u0410\u043B\u0430\u043C\u043E\u0441\u0435.
    \u0423\u043B\u0430\u043C, \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438,
    \u0432\u044B\u0441\u043E\u043A\u043E \u0446\u0435\u043D\u0438\u043B \u0444\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D\u0430 \u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u043B
    \u0435\u0433\u043E \xAB\u0441\u0430\u043C\u044B\u043C \u0431\u044B\u0441\u0442\u0440\u044B\u043C
    \u0443\u043C\u043E\u043C\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D
    \u043A\u043E\u0433\u0434\u0430-\u043B\u0438\u0431\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B.
    *   **\u0421\u043E\u043F\u0435\u0440\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441 \u0410\u043B\u0430\u043D\u043E\u043C \u0422\u044C\u044E\u0440\u0438\u043D\u0433\u043E\u043C:**
    \u0425\u043E\u0442\u044F \u043E\u043D\u0438 \u0431\u044B\u043B\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B
    (\u0422\u044C\u044E\u0440\u0438\u043D\u0433 \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 \u043A\u0430\u043A
    \u0440\u0430\u0437 \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F, \u043A\u043E\u0433\u0434\u0430
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0431\u044B\u043B \u0442\u0430\u043C
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C), \u0438\u0445
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C
    \u0441\u0443\u0433\u0443\u0431\u043E \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C\u0438.
    \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D, \u043F\u043E \u0441\u043B\u0443\u0445\u0430\u043C,
    \u0431\u044B\u043B \u043F\u043E\u0440\u0430\u0436\u0435\u043D \u0438\u0434\u0435\u0435\u0439
    \u0422\u044C\u044E\u0440\u0438\u043D\u0433\u0430 \u043E\u0431 \xAB\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u043C\u0430\u0448\u0438\u043D\u0435\xBB, \u043D\u043E \u043E\u043D\u0438 \u0442\u0430\u043A
    \u0438 \u043D\u0435 \u0441\u0442\u0430\u043B\u0438 \u0431\u043B\u0438\u0437\u043A\u0438\u043C\u0438
    \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438 \u2014 \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u044F
    \u0432 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u043C\u0435\u043D\u0442\u0435
    \u0431\u044B\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u0435\u043B\u0438\u043A\u0438
    (\u0422\u044C\u044E\u0440\u0438\u043D\u0433 \u0431\u044B\u043B \u0437\u0430\u043C\u043A\u043D\u0443\u0442
    \u0438 \u0430\u0441\u043A\u0435\u0442\u0438\u0447\u0435\u043D).  ### \u26B0\uFE0F
    \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u0438 \u0441\u043C\u0435\u0440\u0442\u044C  \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B \u0436\u0438\u0437\u043D\u0438 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430
    \u0431\u044B\u043B\u0438 \u043E\u043C\u0440\u0430\u0447\u0435\u043D\u044B \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E,
    \u043D\u043E \u043E\u043D \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B \u044F\u0441\u043D\u043E\u0441\u0442\u044C
    \u0443\u043C\u0430 \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u043E\u043D\u0446\u0430. 
    *   **\u0423\u0445\u0443\u0434\u0448\u0435\u043D\u0438\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F:**
    \u0412 1955 \u0433\u043E\u0434\u0443, \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u0440\u0430\u0431\u043E\u0442\u044B \u043D\u0430\u0434 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u043C
    \u0440\u0430\u043A\u0435\u0442 \u0432 \u041F\u0435\u043D\u0442\u0430\u0433\u043E\u043D\u0435,
    \u0443 \u043D\u0435\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u0438\u0441\u044C
    \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u0431\u043E\u043B\u0438. \u0412\u0441\u043A\u043E\u0440\u0435
    \u0435\u043C\u0443 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439
    \u0434\u0438\u0430\u0433\u043D\u043E\u0437 \u2014 **\u0440\u0430\u043A \u043A\u043E\u0441\u0442\u0435\u0439
    (\u0441\u0430\u0440\u043A\u043E\u043C\u0430)** \u0438\u043B\u0438 **\u0440\u0430\u043A
    \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B** (\u0432 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u0445
    \u0434\u0430\u043D\u043D\u044B\u0435 \u0440\u0430\u0437\u043D\u044F\u0442\u0441\u044F).
    \u0411\u043E\u043B\u0435\u0437\u043D\u044C \u0431\u044B\u043B\u0430, \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
    \u0432\u044B\u0437\u0432\u0430\u043D\u0430 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u043E\u0431\u043B\u0443\u0447\u0435\u043D\u0438\u0435\u043C \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u041B\u043E\u0441-\u0410\u043B\u0430\u043C\u043E\u0441\u0435,
    \u0445\u043E\u0442\u044F \u043E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0442\u0440\u0438\u0446\u0430\u043B
    \u044D\u0442\u043E. *   **\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435
    \u0432\u0435\u0440\u043E\u0439:** \u0411\u0443\u0434\u0443\u0447\u0438 \u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u043E\u043C
    (\u0438\u043B\u0438 \u043C\u044F\u0433\u043A\u0438\u043C \u0430\u0442\u0435\u0438\u0441\u0442\u043E\u043C)
    \u0432\u0441\u044E \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C, \u0444\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D, \u043B\u0435\u0436\u0430 \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435,
    \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F \u043F\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u0442\u044C
    \u0441 \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u043E\u043C. \u041C\u043D\u043E\u0433\u0438\u0435
    \u0434\u0440\u0443\u0437\u044C\u044F \u0431\u044B\u043B\u0438 \u0448\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u044B
    \u044D\u0442\u0438\u043C. \u041E\u0434\u043D\u0430\u043A\u043E \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E \u043E\u043D
    \u0441\u0434\u0435\u043B\u0430\u043B \u044D\u0442\u043E, \u0447\u0442\u043E\u0431\u044B
    \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C \u0441\u0432\u043E\u044E
    \u043C\u0430\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0431\u044B\u043B\u0430
    \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u0430. \u0421\u0430\u043C\u0430
    \u0431\u0435\u0441\u0435\u0434\u0430 \u0441 \u0435\u043F\u0438\u0441\u043A\u043E\u043F\u043E\u043C
    \u0431\u044B\u043B\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439 \u0438,
    \u043F\u043E \u0441\u043B\u043E\u0432\u0430\u043C \u0434\u0440\u0443\u0437\u0435\u0439,
    \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0430 \u0435\u0433\u043E
    \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E \u043C\u0438\u0440\u043E\u0432\u043E\u0437\u0437\u0440\u0435\u043D\u0438\u044F.
    *   **\u0421\u043C\u0435\u0440\u0442\u044C:** \u0414\u0436\u043E\u043D \u0444\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F
    **8 \u0444\u0435\u0432\u0440\u0430\u043B\u044F 1957 \u0433\u043E\u0434\u0430**
    \u0432 \u0432\u043E\u0435\u043D\u043D\u043E\u043C \u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u0435
    \u0423\u043E\u043B\u0442\u0435\u0440\u0430 \u0420\u0438\u0434\u0430 \u0432 \u0412\u0430\u0448\u0438\u043D\u0433\u0442\u043E\u043D\u0435
    \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 53 \u043B\u0435\u0442.
    *   **\u041E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0441\u043C\u0435\u0440\u0442\u0438:** \u0411\u043E\u043B\u0435\u0437\u043D\u044C
    \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043E\u0432\u0430\u043B\u0430,
    \u0438 \u043E\u043D \u0431\u044B\u043B \u043F\u0440\u0438\u043A\u043E\u0432\u0430\u043D
    \u043A \u0438\u043D\u0432\u0430\u043B\u0438\u0434\u043D\u043E\u0439 \u043A\u043E\u043B\u044F\u0441\u043A\u0435.
    \u0418\u0437-\u0437\u0430 \u0441\u0442\u0440\u043E\u0436\u0430\u0439\u0448\u0435\u0433\u043E
    \u0440\u0435\u0436\u0438\u043C\u0430 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0441\u0442\u0438
    (\u043E\u043D \u0431\u044B\u043B \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u043D\u0442\u043E\u043C
    \u043F\u043E \u044F\u0434\u0435\u0440\u043D\u044B\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u043C)
    \u0437\u0430 \u0435\u0433\u043E \u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C
    \u0441\u043B\u0435\u0434\u0438\u043B\u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0432\u0440\u0430\u0447\u0438. \u0414\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D \u0443\u043C\u0438\u0440\u0430\u043B, \u0435\u043C\u0443 \u043D\u0435
    \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u043B\u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C
    \u0441 \u043D\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C\u0438
    \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u044F\u043C\u0438. \u0415\u0433\u043E
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043D\u0435\u0434\u0435\u043B\u0438
    \u043F\u0440\u043E\u0448\u043B\u0438 \u0432 \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0438
    \u0441\u0435\u043C\u044C\u0438 \u2014 \u0436\u0435\u043D\u044B \u041A\u043B\u0430\u0440\u044B
    \u0438 \u0434\u043E\u0447\u0435\u0440\u0438 \u041C\u0430\u0440\u0438\u043D\u044B. 
    \u041F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u0438
    \u043D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0435\u0433\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430
    \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0431\u044B\u043B\u0430
    \u043F\u043E\u0432\u0435\u0448\u0435\u043D\u0430 \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0430:
    *\xAB\u0414\u0436\u043E\u043D \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D,
    1903\u20131957. \u0415\u0433\u043E \u0440\u0430\u0437\u0443\u043C \u0431\u044B\u043B
    \u0442\u0435\u043C \u043C\u043E\u0441\u0442\u043E\u043C, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0448\u0430\u0433\u043D\u0443\u043B
    \u0438\u0437 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u0435\xBB*.
    \u041E\u043D \u0431\u044B\u043B \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0435\u043D
    \u043D\u0430 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435 \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435,
    \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u0431\u044F
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0440\u0443\u0434\u044B,
    \u0430 \u0446\u0435\u043B\u0443\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u0443
    \u043C\u0438\u0440\u0430, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u0438 \u043C\u0430\u0448\u0438\u043D\u0430 \u043C\u043E\u0433\u043B\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438."
  personalLifeEn: 
  shortBioRu: "\u0414\u0436\u043E\u043D \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u2014 \u044D\u0442\u043E \u043E\u0434\u043D\u0430 \u0438\u0437 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u0444\u0438\u0433\u0443\u0440 \u0432 \u043D\u0430\u0443\u043A\u0435 XX \u0432\u0435\u043A\u0430,
    \u0447\u0435\u0439 \u0433\u0435\u043D\u0438\u0439 \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u043B
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443, \u0444\u0438\u0437\u0438\u043A\u0443,
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0443 \u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u0438\u043A\u0443.
    \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u2014 \u044D\u0442\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0433\u043E \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430,
    \u0447\u044C\u0438 \u0438\u0434\u0435\u0438 \u043B\u0435\u0433\u043B\u0438 \u0432
    \u043E\u0441\u043D\u043E\u0432\u0443 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0433\u043E \u043C\u0438\u0440\u0430.
    \u041D\u0438\u0436\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
    \u0435\u0433\u043E \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0430\u044F \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F. 
    ### \u0414\u0435\u0442\u0441\u0442\u0432\u043E \u0438 \u0441\u0435\u043C\u044C\u044F:
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0433\u0435\u043D\u0438\u044F  \u0414\u0436\u043E\u043D \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0440\u043E\u0434\u0438\u043B\u0441\u044F 28 \u0434\u0435\u043A\u0430\u0431\u0440\u044F
    1903 \u0433\u043E\u0434\u0430 \u0432 \u0411\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u0435,
    \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u0445\u043E\u0434\u0438\u0432\u0448\u0435\u043C
    \u0432 \u0441\u043E\u0441\u0442\u0430\u0432 \u0410\u0432\u0441\u0442\u0440\u043E-\u0412\u0435\u043D\u0433\u0435\u0440\u0441\u043A\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438. \u0415\u0433\u043E \u0438\u043C\u044F
    \u043F\u0440\u0438 \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0438 \u2014 \u041D\u0435\u0439\u043C\u0430\u043D
    \u042F\u043D\u043E\u0448 \u041B\u0430\u0439\u043E\u0448 (Neumann J\xE1nos Lajos).
    \u041E\u043D \u0431\u044B\u043B \u0441\u0442\u0430\u0440\u0448\u0438\u043C \u0438\u0437
    \u0442\u0440\u0435\u0445 \u0441\u044B\u043D\u043E\u0432\u0435\u0439 \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0439 \u0441\u0435\u043C\u044C\u0435. 
    - **\u041E\u0442\u0435\u0446**, \u041C\u0430\u043A\u0441 (\u041C\u0438\u043A\u0448\u0430)
    \u041D\u0435\u0439\u043C\u0430\u043D, \u0431\u044B\u043B \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u043C
    \u0431\u0430\u043D\u043A\u0438\u0440\u043E\u043C, \u0438\u043C\u0435\u0432\u0448\u0438\u043C
    \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E \u0441\u0442\u0435\u043F\u0435\u043D\u044C
    \u043F\u043E \u043F\u0440\u0430\u0432\u0443. - **\u041C\u0430\u0442\u044C**,
    \u041C\u0430\u0440\u0433\u0438\u0442 \u041A\u0430\u043D\u043D, \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430
    \u0438\u0437 \u0441\u0435\u043C\u044C\u0438, \u0440\u0430\u0437\u0431\u043E\u0433\u0430\u0442\u0435\u0432\u0448\u0435\u0439
    \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435 \u0441\u0435\u043B\u044C\u0445\u043E\u0437\u0442\u0435\u0445\u043D\u0438\u043A\u043E\u0439. 
    \u0412 1913 \u0433\u043E\u0434\u0443, \u0437\u0430 \u0437\u0430\u0441\u043B\u0443\u0433\u0438
    \u043F\u0435\u0440\u0435\u0434 \u0438\u043C\u043F\u0435\u0440\u0438\u0435\u0439,
    \u043E\u0442\u0435\u0446 \u042F\u043D\u043E\u0448\u0430 \u0431\u044B\u043B \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D
    \u0432 \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u043E\u0435 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E,
    \u0438 \u0441\u0435\u043C\u044C\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430
    \u043D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0442\u0438\u0442\u0443\u043B \"margittai\", \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u0441\u0442\u0430\u0432\u043A\u0443
    \"\u0444\u043E\u043D\". \u0421\u0430\u043C \u042F\u043D\u043E\u0448 \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B \u043D\u0435\u043C\u0435\u0446\u043A\u0443\u044E
    \u0432\u0435\u0440\u0441\u0438\u044E \u2014 \"von Neumann\", \u0430 \u0435\u0433\u043E
    \u043E\u0442\u0435\u0446 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B \u0444\u0430\u043C\u0438\u043B\u0438\u044E
    \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439.  ###
    \u0412\u0443\u043D\u0434\u0435\u0440\u043A\u0438\u043D\u0434: \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438  \u0421 \u0440\u0430\u043D\u043D\u0435\u0433\u043E
    \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u042F\u043D\u043E\u0448 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u043B
    \u043D\u0435\u043E\u0431\u044B\u0447\u0430\u0439\u043D\u044B\u0435 \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u043E\u0440\u0430\u0436\u0430\u043B\u0438 \u0432\u0441\u0435\u0445 \u0432\u043E\u043A\u0440\u0443\u0433. 
    - **\u041D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u0430\u044F \u043F\u0430\u043C\u044F\u0442\u044C:**
    \u0412 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 6 \u043B\u0435\u0442
    \u043E\u043D \u043C\u043E\u0433 \u0448\u0443\u0442\u0438\u0442\u044C \u043D\u0430
    \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043A\u043E\u043C
    \u0438 \u0432 \u0443\u043C\u0435 \u0434\u0435\u043B\u0438\u0442\u044C \u0432\u043E\u0441\u044C\u043C\u0438\u0437\u043D\u0430\u0447\u043D\u044B\u0435
    \u0447\u0438\u0441\u043B\u0430. \u0421\u0435\u043C\u044C\u044F \u0440\u0430\u0437\u0432\u043B\u0435\u043A\u0430\u043B\u0430
    \u0433\u043E\u0441\u0442\u0435\u0439 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u0435\u0439
    \u0435\u0433\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u043E\u0439 \u043A\u043D\u0438\u0433\u0438.
    - **\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430:** \u041A 8
    \u0433\u043E\u0434\u0430\u043C \u043E\u043D \u043E\u0441\u0432\u043E\u0438\u043B
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0438 \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u0438\u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0435. - **\u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435:**
    \u0421 1911 \u0433\u043E\u0434\u0430 \u043E\u043D \u0443\u0447\u0438\u043B\u0441\u044F
    \u0432 \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u043E\u0439 \u041B\u044E\u0442\u0435\u0440\u0430\u043D\u0441\u043A\u043E\u0439
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438. \u0415\u0433\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u0430\u043B\u0430\u043D\u0442 \u0431\u044B\u043B \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0447\u0435\u0432\u0438\u0434\u0435\u043D, \u0447\u0442\u043E \u0448\u043A\u043E\u043B\u0430
    \u043D\u0430\u043D\u044F\u043B\u0430 \u0434\u043B\u044F \u043D\u0435\u0433\u043E
    \u0447\u0430\u0441\u0442\u043D\u044B\u0445 \u0440\u0435\u043F\u0435\u0442\u0438\u0442\u043E\u0440\u043E\u0432,
    \u0430 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0435\u0433\u043E \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u0439
    \u0431\u044B\u043B \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A
    \u0413\u0430\u0431\u043E\u0440 \u0421\u0435\u0433\u0451. \u0421 15 \u043B\u0435\u0442
    \u043E\u043D \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F \u0432\u044B\u0441\u0448\u0435\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0439 \u0441 \u0421\u0435\u0433\u0451,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u044B\u043B \u043F\u043E\u0442\u0440\u044F\u0441\u0435\u043D
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u044E\u043D\u043E\u0448\u0438.  \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
    \u0435\u0433\u043E \u043E\u0442\u0435\u0446, \u043E\u043F\u0430\u0441\u0430\u044F\u0441\u044C,
    \u0447\u0442\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0435\u0442 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E
    \u0434\u043E\u0445\u043E\u0434\u0430, \u043D\u0430\u0441\u0442\u043E\u044F\u043B
    \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \"\u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0439\"
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u0438. \u0412 \u0438\u0442\u043E\u0433\u0435
    \u0431\u044B\u043B \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441:
    \u042F\u043D\u043E\u0448 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B
    \u0438\u0437\u0443\u0447\u0430\u0442\u044C \u0445\u0438\u043C\u0438\u044E, \u043D\u043E
    \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443.  ### \u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438 \u043D\u0430\u0447\u0430\u043B\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u044B
    \u0432 \u0415\u0432\u0440\u043E\u043F\u0435  \u0424\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435, \u043F\u0440\u043E\u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0432
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043A \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u043C\u0443
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044E \u0432 \u0440\u0430\u0437\u043D\u044B\u0445
    \u0441\u0442\u0440\u0430\u043D\u0430\u0445 \u0438 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445. 
    - **1921-1923:** \u041E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u0438\u0439 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0434\u043B\u044F \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F \u0445\u0438\u043C\u0438\u0438.
    - **1923-1926:** \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
    \u043F\u043E \u0442\u043E\u0439 \u0436\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0432 \u0426\u044E\u0440\u0438\u0445\u0441\u043A\u043E\u043C \u043F\u043E\u043B\u0438\u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C\u0435
    (\u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0430\u044F \u0432\u044B\u0441\u0448\u0430\u044F
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0448\u043A\u043E\u043B\u0430),
    \u0433\u0434\u0435 \u0432 1925 \u0433\u043E\u0434\u0443 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0434\u0438\u043F\u043B\u043E\u043C \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430-\u0445\u0438\u043C\u0438\u043A\u0430.
    - **1926:** \u0412 \u0442\u043E\u043C \u0436\u0435 \u0433\u043E\u0434\u0443 \u043E\u043D
    \u0437\u0430\u0449\u0438\u0442\u0438\u043B \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E \u043F\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u0432 \u0411\u0443\u0434\u0430\u043F\u0435\u0448\u0442\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0415\u0433\u043E
    \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
    \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u0430
    \u0430\u043A\u0441\u0438\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0442\u0435\u043E\u0440\u0438\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432. 
    \u041A \u044D\u0442\u043E\u043C\u0443 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
    \u0435\u0449\u0435 \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u043C,
    \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 19-20 \u043B\u0435\u0442
    \u043E\u043D \u0443\u0436\u0435 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0430\u0431\u043E\u0442, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0435
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u0432\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B.  \u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0434\u0438\u043F\u043B\u043E\u043C\u043E\u0432 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043D\u0430\u0447\u0430\u043B \u0441\u0432\u043E\u044E \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043A\u0430\u0440\u044C\u0435\u0440\u0443 \u0432 \u0415\u0432\u0440\u043E\u043F\u0435,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F, \u043E\u0434\u043D\u0430\u043A\u043E,
    \u0431\u044B\u043B\u0430 \u043D\u0435\u0434\u043E\u043B\u0433\u043E\u0439 \u0438\u0437-\u0437\u0430
    \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438. 
    - **1927-1929:** \u0411\u044B\u043B \u043F\u0440\u0438\u0432\u0430\u0442-\u0434\u043E\u0446\u0435\u043D\u0442\u043E\u043C
    \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    - **1929-1930:** \u041F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B
    \u0432 \u0413\u0430\u043C\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    - \u0412 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434 \u043E\u043D
    \u0442\u0435\u0441\u043D\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u043B
    \u0441 \u0432\u0435\u043B\u0438\u043A\u0438\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C
    \u0414\u0430\u0432\u0438\u0434\u043E\u043C \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u043E\u043C
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0435. \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C
    \u0438\u0445 \u0440\u0430\u0431\u043E\u0442\u044B \u0441\u0442\u0430\u043B\u043E
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430 \u0434\u043B\u044F
    \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438,
    \u0433\u0434\u0435 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0444\u043E\u0440\u043C\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043B
    \u0442\u0435\u043E\u0440\u0438\u044E \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432 \u0432 \u0433\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u043E\u0432\u043E\u043C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435. - \u0412
    1928 \u0433\u043E\u0434\u0443 \u043E\u043D \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B
    \u0441\u0432\u043E\u044E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0443\u044E
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u043E \u043C\u0438\u043D\u0438\u043C\u0430\u043A\u0441\u0435,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u0430\u043B\u043E\u0436\u0438\u043B\u0430
    \u043E\u0441\u043D\u043E\u0432\u044B \u0442\u0435\u043E\u0440\u0438\u0438 \u0438\u0433\u0440. 
    ### \u041F\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u0421\u0428\u0410 \u0438
    \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u043A\u0430\u0440\u044C\u0435\u0440\u044B 
    \u041F\u0440\u0435\u0434\u0432\u0438\u0434\u044F \u0443\u0445\u0443\u0434\u0448\u0435\u043D\u0438\u0435
    \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
    \u0432 \u0415\u0432\u0440\u043E\u043F\u0435, \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043F\u0440\u0438\u043D\u044F\u043B \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
    \u0438\u0437 \u0421\u0428\u0410.  - **1930:** \u041E\u043D \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B
    \u0432 \u0421\u0428\u0410 \u0438 \u0441\u0442\u0430\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. - **1933:**
    \u041A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B \u043E\u0441\u043D\u043E\u0432\u0430\u043D
    \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u044B\u0439 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442
    \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 (Institute
    for Advanced Study) \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435,
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0441\u0442\u0430\u043B
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0435\u0433\u043E \u043F\u0435\u0440\u0432\u044B\u0445
    \u0448\u0435\u0441\u0442\u0438 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u0432
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438. \u041E\u043D \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B
    \u044D\u0442\u0443 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u0434\u043E
    \u043A\u043E\u043D\u0446\u0430 \u0436\u0438\u0437\u043D\u0438. \u0421\u0440\u0435\u0434\u0438
    \u0435\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u0433 \u0431\u044B\u043B\u0438
    \u0410\u043B\u044C\u0431\u0435\u0440\u0442 \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D
    \u0438 \u041A\u0443\u0440\u0442 \u0413\u0451\u0434\u0435\u043B\u044C. - **1937:**
    \u041E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u043E\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u0442\u0432\u043E. - **1938:**
    \u0416\u0435\u043D\u0438\u043B\u0441\u044F \u043D\u0430 \u041A\u043B\u0430\u0440\u0435
    \u0414\u044D\u043D, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043B\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\u043E\u043C
    \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u0441 \u043D\u0438\u043C
    \u043D\u0430\u0434 \u0440\u0430\u043D\u043D\u0438\u043C\u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430\u043C\u0438. 
    \u0412 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434 \u0435\u0433\u043E
    \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B
    \u0431\u044B\u043B\u0438 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
    \u0448\u0438\u0440\u043E\u043A\u0438. \u041E\u043D \u0432\u043D\u0435\u0441 \u0432\u043A\u043B\u0430\u0434
    \u0432 \u0430\u043A\u0441\u0438\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0442\u0435\u043E\u0440\u0438\u044E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432,
    \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u0430\u043D\u0430\u043B\u0438\u0437 (\u0430\u043B\u0433\u0435\u0431\u0440\u044B
    \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430), \u044D\u0440\u0433\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0442\u0435\u043E\u0440\u0438\u044E \u0438 \u043C\u043D\u043E\u0433\u0438\u0435
    \u0434\u0440\u0443\u0433\u0438\u0435 \u043E\u0431\u043B\u0430\u0441\u0442\u0438. 
    ### \u0412\u043A\u043B\u0430\u0434 \u0432 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u0430\u0442\u043E\u043C\u043D\u043E\u0439 \u0431\u043E\u043C\u0431\u044B \u0438
    \u0432\u043E\u0435\u043D\u043D\u044B\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438 
    \u0421 \u043D\u0430\u0447\u0430\u043B\u043E\u043C \u0412\u0442\u043E\u0440\u043E\u0439
    \u043C\u0438\u0440\u043E\u0432\u043E\u0439 \u0432\u043E\u0439\u043D\u044B \u0444\u043E\u043D
    \u041D\u0435\u0439\u043C\u0430\u043D \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0441\u044F \u0432 \u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F, \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0432
    \u0441\u0432\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u0430\u043B\u0430\u043D\u0442 \u043A \u0440\u0435\u0448\u0435\u043D\u0438\u044E
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0437\u0430\u0434\u0430\u0447. 
    - \u0421 1940 \u0433\u043E\u0434\u0430 \u043E\u043D \u0431\u044B\u043B \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u043D\u0442\u043E\u043C
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0445
    \u0438 \u0432\u043E\u0435\u043D\u043D\u043E-\u043C\u043E\u0440\u0441\u043A\u0438\u0445
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439. - \u041E\u043D
    \u0441\u0442\u0430\u043B \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u043C \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u043C
    \u041C\u0430\u043D\u0445\u044D\u0442\u0442\u0435\u043D\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u043F\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E
    \u0430\u0442\u043E\u043C\u043D\u043E\u0439 \u0431\u043E\u043C\u0431\u044B \u0432
    \u041B\u043E\u0441-\u0410\u043B\u0430\u043C\u043E\u0441\u0435. \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u044E \u0438\u043C\u043F\u043B\u043E\u0437\u0438\u0432\u043D\u043E\u0433\u043E
    \u0432\u0437\u0440\u044B\u0432\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
    \u0434\u043B\u044F \u0434\u0435\u0442\u043E\u043D\u0430\u0446\u0438\u0438 \u043F\u043B\u0443\u0442\u043E\u043D\u0438\u0435\u0432\u043E\u0439
    \u0431\u043E\u043C\u0431\u044B. \u041E\u043D \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u043E\u0432\u0435\u043B
    \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0440\u0430\u0441\u0447\u0435\u0442\u044B
    \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430.
    - \u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0439\u043D\u044B \u043E\u043D
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043D\u0430\u0434 \u0442\u0435\u0440\u043C\u043E\u044F\u0434\u0435\u0440\u043D\u044B\u043C
    \u043E\u0440\u0443\u0436\u0438\u0435\u043C, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435
    \u043D\u0430\u0434 \u0432\u043E\u0434\u043E\u0440\u043E\u0434\u043D\u043E\u0439
    \u0431\u043E\u043C\u0431\u043E\u0439, \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u044F
    \u0441 \u042D\u0434\u0432\u0430\u0440\u0434\u043E\u043C \u0422\u0435\u043B\u043B\u0435\u0440\u043E\u043C
    \u0438 \u0421\u0442\u0430\u043D\u0438\u0441\u043B\u0430\u0432\u043E\u043C \u0423\u043B\u0430\u043C\u043E\u043C. 
    ### \u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430
    \u0438 \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439
    \u044D\u0440\u044B  \u0421\u0430\u043C\u044B\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u0432\u043A\u043B\u0430\u0434 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0438 \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u0432\u043F\u0435\u0440\u0435\u0434, \u0441\u0432\u044F\u0437\u0430\u043D \u0441
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B
    \u043F\u0435\u0440\u0432\u044B\u0445 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u0432. 
    - \u0415\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430\u043C
    \u0431\u044B\u043B \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0441\u0432\u044F\u0437\u0430\u043D \u0441 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C\u044E
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u044B\u0435
    \u0440\u0430\u0441\u0447\u0435\u0442\u044B \u0434\u043B\u044F \u0430\u0442\u043E\u043C\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430. - \u0412 1945 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B
    \xAB\u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442
    \u043E\u0442\u0447\u0435\u0442\u0430 \u043E\u0431 EDVAC\xBB (First Draft of a
    Report on the EDVAC). \u042D\u0442\u043E\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442,
    \u0445\u043E\u0442\u044F \u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043D \u043D\u0430
    \u0440\u0430\u0431\u043E\u0442\u0430\u0445 \u0433\u0440\u0443\u043F\u043F\u044B
    \u041C\u043E\u0443\u0447\u043B\u0438 \u0438 \u042D\u043A\u043A\u0435\u0440\u0442\u0430,
    \u0441\u043E\u0437\u0434\u0430\u0432\u0448\u0438\u0445 ENIAC, \u044F\u0441\u043D\u043E
    \u0438 \u043F\u043E\u043B\u043D\u043E \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0437\u0436\u0435 \u0441\u0442\u0430\u043B\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B \u043A\u0430\u043A **\u0444\u043E\u043D-\u043D\u0435\u0439\u043C\u0430\u043D\u043E\u0432\u0441\u043A\u0430\u044F
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430**.  \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
    \u0438\u0434\u0435\u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u043B\u0438\u0441\u044C
    \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C: 1.  **\u0414\u0432\u043E\u0438\u0447\u043D\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430:** \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0434\u0432\u043E\u0438\u0447\u043D\u043E\u0433\u043E \u043A\u043E\u0434\u0430
    \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0434\u0430\u043D\u043D\u044B\u0445 \u0438 \u043A\u043E\u043C\u0430\u043D\u0434.
    2.  **\u041F\u0440\u0438\u043D\u0446\u0438\u043F \u0445\u0440\u0430\u043D\u0438\u043C\u043E\u0439
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B:** \u0421\u0430\u043C\u0430
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 (\u043D\u0430\u0431\u043E\u0440
    \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0439) \u0434\u043E\u043B\u0436\u043D\u0430
    \u0445\u0440\u0430\u043D\u0438\u0442\u044C\u0441\u044F \u0432 \u043F\u0430\u043C\u044F\u0442\u0438
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430 \u043D\u0430\u0440\u0430\u0432\u043D\u0435
    \u0441 \u0434\u0430\u043D\u043D\u044B\u043C\u0438. \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u043E
    \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
    \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0438 \u0434\u0435\u043B\u0430\u043B\u043E \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u043C
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u043C. 3.  **\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430:** \u041A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043E\u0441\u0442\u043E\u044F\u0442\u044C
    \u0438\u0437 \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E-\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 (\u0410\u041B\u0423),
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    (\u0423\u0423), \u043F\u0430\u043C\u044F\u0442\u0438, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432 \u0432\u0432\u043E\u0434\u0430
    \u0438 \u0432\u044B\u0432\u043E\u0434\u0430.  \u041F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0447\u0442\u043E \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D \u0441\u0442\u0430\u043B
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445,
    \u043A\u0442\u043E \u0443\u0432\u0438\u0434\u0435\u043B \u0432 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0435
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0443\u044E
    \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u043C\u0430\u0448\u0438\u043D\u0443, \u0430 \u043C\u043E\u0449\u043D\u044B\u0439
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0434\u043B\u044F
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u0445
    \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u0438 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u044B\u0445
    \u0437\u0430\u0434\u0430\u0447, \u0447\u0442\u043E \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u043A \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E
    \u043C\u0435\u0442\u043E\u0434\u0430 \u041C\u043E\u043D\u0442\u0435-\u041A\u0430\u0440\u043B\u043E. 
    ### \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u0438 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435  \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B \u0436\u0438\u0437\u043D\u0438 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C. \u041E\u043D \u0441\u0442\u0430\u043B
    \u0447\u043B\u0435\u043D\u043E\u043C \u041A\u043E\u043C\u0438\u0441\u0441\u0438\u0438
    \u043F\u043E \u0430\u0442\u043E\u043C\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
    \u0421\u0428\u0410 (Atomic Energy Commission) \u0432 1955 \u0433\u043E\u0434\u0443.
    \u0415\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B \u0441\u043C\u0435\u0441\u0442\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0442\u0435\u043E\u0440\u0438\u0438
