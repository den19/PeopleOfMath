    \u0414\u0436\u043E\u043D \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F 8 \u0444\u0435\u0432\u0440\u0430\u043B\u044F
    1957 \u0433\u043E\u0434\u0430 \u0432 \u0412\u0430\u0448\u0438\u043D\u0433\u0442\u043E\u043D\u0435,
    \u043E\u043A\u0440\u0443\u0433 \u041A\u043E\u043B\u0443\u043C\u0431\u0438\u044F,
    \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 53 \u043B\u0435\u0442. 
    \u041D\u0430\u0441\u043B\u0435\u0434\u0438\u0435 \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D\u0430
