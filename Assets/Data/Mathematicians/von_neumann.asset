    \u044D\u043F\u0438\u0437\u043E\u0434\u043E\u0432. \u0415\u0433\u043E \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u044D\u043A\u0441\u0446\u0435\u043D\u0442\u0440\u0438\u0447\u043D\u044B\u0439
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u0438 \u043E\u0441\u0442\u0440\u043E\u0443\u043C\u0438\u0435
    \u043F\u043E\u0440\u043E\u0436\u0434\u0430\u043B\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
