  achievementsRu: "\u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435,
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u0441\u0442\u043e\u043b\u044c
    \u043c\u043d\u043e\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u044e\u0442
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445
    \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u043e\u0432
    \u0432 \u043d\u0430\u0443\u043a\u0435. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0438\u043b \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u2014 \u0432\u043e \u043c\u043d\u043e\u0433\u0438\u0445
    \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0446\u0435\u043b\u044b\u0435 \u043d\u043e\u0432\u044b\u0435 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b
    \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430.
    \u041d\u0438\u0436\u0435 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u044b
    \u0435\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f.\n\n\U0001F4D0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u043b\u043e\u0433\u0438\u043a\u0430:
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0431\u0443\u0434\u0443\u0449\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    \u0431\u044b\u043b\u043e \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c.
    \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043a\u0430\u043a \u0432 \u0441\u0430\u043c\u044b\u0445
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445,
    \u0442\u0430\u043a \u0438 \u0432 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445,
    \u043f\u0440\u0438\u0447\u0435\u043c \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u043f\u0435\u0440\u0435\u0436\u0430\u043b \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0438
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043b\u0438\u0448\u044c \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u0441\u043f\u0443\u0441\u0442\u044f. \u0410\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432: \u0412
    \u0441\u0432\u043e\u0435\u0439 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 1925 \u0433\u043e\u0434\u0430
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0440\u0435\u0448\u0438\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443, \u0432\u043e\u0437\u043d\u0438\u043a\u0448\u0443\u044e
    \u0438\u0437-\u0437\u0430 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u0432 \u0432
    \u043d\u0430\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430
    \u0420\u0430\u0441\u0441\u0435\u043b\u0430). \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0430\u043a\u0441\u0438\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0430\u043b\u0430
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f, \u0432\u0432\u0435\u0434\u044f
    \u0430\u043a\u0441\u0438\u043e\u043c\u0443 \u0444\u0443\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043a\u043b\u0430\u0441\u0441\u0430 (\u0432
    \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \"\u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430\").
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0443\u044e
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0437\u043d\u0430\u0447\u0438\u043c\u0430, \u0447\u0442\u043e \u043b\u0435\u0433\u043b\u0430
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0430\u043a\u0441\u0438\u043e\u043c
    NBG (\u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430 \u2014 \u0411\u0435\u0440\u043d\u0430\u0439\u0441\u0430
    \u2014 \u0413\u0451\u0434\u0435\u043b\u044f). \u0422\u0435\u043e\u0440\u0435\u043c\u044b
    \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435 \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044f\u0445 1930 \u0433\u043e\u0434\u0430
    \u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0423\u0437\u043d\u0430\u0432 \u043e \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u0445 \u041a\u0443\u0440\u0442\u0430
    \u0413\u0451\u0434\u0435\u043b\u044f, \u043e\u043d \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u043e\u0441\u043e\u0437\u043d\u0430\u043b
    \u0438\u0445 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0435\u0435 \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435
    \u2014 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438 \u0435\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438 (\u0432\u0442\u043e\u0440\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0413\u0451\u0434\u0435\u043b\u044f). \u0425\u043e\u0442\u044f
    \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b \u0413\u0451\u0434\u0435\u043b\u044e,
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445, \u043a\u0442\u043e \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u0441\u043e\u0437\u043d\u0430\u043b \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u044d\u0442\u043e\u0433\u043e
    \u0443\u0434\u0430\u0440\u0430 \u043f\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430. \u0422\u0435\u043e\u0440\u0438\u044f
    \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430: \u0412 1930-\u0445 \u0433\u043e\u0434\u0430\u0445,
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0424. \u0414\u0436. \u041c\u044e\u0440\u0440\u0435\u0435\u043c,
    \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0446\u0435\u043b\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u2014 \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u043e\u043b\u0435\u0446 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b\u0438
    \u043d\u0430\u0437\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u043c\u0438
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u043e \u0438 \u0432 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435.
    \u0412 \u0440\u0430\u043c\u043a\u0430\u0445 \u044d\u0442\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u0433\u0434\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043c\u043e\u0436\u0435\u0442
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0446\u0435\u043b\u044b\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f, \u043d\u043e
    \u0438 \u043b\u044e\u0431\u044b\u0435 \u0447\u0438\u0441\u043b\u0430 \u043d\u0430 \u043e\u0442\u0440\u0435\u0437\u043a\u0435
    \u043c\u0435\u0436\u0434\u0443 0 \u0438 1. \u042d\u0440\u0433\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f: \u0412 1932 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0435\u0440\u0438\u044e
    \u0440\u0430\u0431\u043e\u0442, \u0437\u0430\u043b\u043e\u0436\u0438\u0432\u0448\u0438\u0445
    \u043e\u0441\u043d\u043e\u0432\u044b \u044d\u0440\u0433\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u2014 \u0440\u0430\u0437\u0434\u0435\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0435\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043c
    \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c. \u0415\u0433\u043e \u044d\u0440\u0433\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439,
    \u0438, \u043a\u0430\u043a \u043f\u0438\u0441\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041f\u043e\u043b \u0425\u0430\u043b\u043c\u043e\u0448, \u00ab\u0435\u0441\u043b\u0438
    \u0431\u044b \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u043b
    \u043d\u0438\u0447\u0435\u0433\u043e \u0434\u0440\u0443\u0433\u043e\u0433\u043e, \u0438\u0445
    \u0431\u044b\u043b\u043e \u0431\u044b \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0435\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0431\u0435\u0441\u0441\u043c\u0435\u0440\u0442\u0438\u0435\u00bb.\n\n\u269b\ufe0f \u041a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430: \u043f\u0440\u0438\u0434\u0430\u043d\u0438\u0435
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438 \u043d\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u043f\u043e \u043f\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043c: \u0412 1926 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u0435
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043a\u0430\u043a \u0432\u0435\u043a\u0442\u043e\u0440\u044b \u0432 \u0433\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432\u043e\u043c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435, \u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b (\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435,
    \u0438\u043c\u043f\u0443\u043b\u044c\u0441, \u044d\u043d\u0435\u0440\u0433\u0438\u044f)
    \u2014 \u043a\u0430\u043a \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0435 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b,
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u043d\u0430 \u044d\u0442\u0438
    \u0432\u0435\u043a\u0442\u043e\u0440\u044b. \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0443\u043d\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0434\u0432\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u0435 \u0442\u043e\u0433\u0434\u0430
    \u0432\u0435\u0440\u0441\u0438\u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u2014 \u043c\u0430\u0442\u0440\u0438\u0447\u043d\u0443\u044e
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443 \u0413\u0435\u0439\u0437\u0435\u043d\u0431\u0435\u0440\u0433\u0430
    \u0438 \u0432\u043e\u043b\u043d\u043e\u0432\u0443\u044e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443
    \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u0430. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0441\u043d\u043e\u0432\u044b \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438: \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c
    \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u0430
    \u0435\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u043d\u0438\u0433\u0430 \"Mathematische Grundlagen der Quantenmechanik\" (\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0441\u043d\u043e\u0432\u044b \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438), \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432 1932 \u0433\u043e\u0434\u0443. \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430
    \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f \u0441\u0442\u0430\u043b\u0430
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435.
    \u0412 \u043d\u0435\u0439 \u043e\u043d, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0441\u0442\u0440\u043e\u0433\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0443
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0441\u043a\u0440\u044b\u0442\u044b\u0445
    \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432 (\u0445\u043e\u0442\u044f \u043f\u043e\u0437\u0436\u0435
    \u0432 \u043d\u0435\u0439 \u0431\u044b\u043b \u043d\u0430\u0439\u0434\u0435\u043d \u043a\u043e\u043d\u0446\u0435\u043f\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u043e\u0431\u0435\u043b, \u043e\u043d\u0430 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0430
    \u0446\u0435\u043b\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u043f\u0440\u0438\u0432\u0435\u0434\u0448\u0435\u0435
    \u043a \u0442\u0435\u043e\u0440\u0435\u043c\u0435 \u0411\u0435\u043b\u043b\u0430). \u0421\u0430\u043c
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u0441\u0430\u043c\u043e\u0439 \u0432\u0430\u0436\u043d\u043e\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u0441\u0432\u043e\u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f.\n\n\U0001F579\ufe0f
    \u0422\u0435\u043e\u0440\u0438\u044f \u0438\u0433\u0440 \u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430:
    \u043d\u043e\u0432\u0430\u044f \u043d\u0430\u0443\u043a\u0430 \u043e \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043a \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435
    \u2014 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0434\u043b\u044f \u043d\u0435\u0435
    \u043d\u043e\u0432\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043c\u0438\u043d\u0438\u043c\u0430\u043a\u0441\u0435
    (1928): \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430
    \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u043e\u0439
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u0433\u0440.
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0439 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439
    \u0438\u0433\u0440\u044b \u0441 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0441\u0443\u043c\u043c\u043e\u0439
    (\u0433\u0434\u0435 \u0432\u044b\u0438\u0433\u0440\u044b\u0448 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0440\u0430\u0432\u0435\u043d \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448\u0443 \u0434\u0440\u0443\u0433\u043e\u0433\u043e)
    \u0441 \u043f\u043e\u043b\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f
    \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f
    \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0438\u0433\u0440\u043e\u043a\u0443 \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0439 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0439 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448.
    \"\u0422\u0435\u043e\u0440\u0438\u044f \u0438\u0433\u0440 \u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\" (1944): \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u043e\u043c \u041e\u0441\u043a\u0430\u0440\u043e\u043c
    \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d\u043e\u043c \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u0433\u0440
    \u043a\u0430\u043a \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0435\u0435 \u043a \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435. \u042d\u0442\u0430
    \u043a\u043d\u0438\u0433\u0430 \u0438\u043c\u0435\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0440\u0435\u0437\u043e\u043d\u0430\u043d\u0441 \u0438 \u043f\u0440\u0435\u0434\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0446\u0435\u043b\u043e\u0433\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0432 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0430\u0443\u043a\u0435,
    \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u044b \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0438\u0435
    \u043f\u0440\u0435\u043c\u0438\u0438. \u041e\u0431\u0449\u0435\u0435 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435: \u0412 1937 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u044f \u0432 \u043c\u043e\u0434\u0435\u043b\u0438
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u043e\u0441\u0442\u0430,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u043e \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0435.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u043e\u0441\u043d\u043e\u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0438.\n\n\U0001F4BB
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u044b
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430
    \u042d\u0442\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0437\u043c\u0435\u043d\u0438\u043b
    \u043c\u0438\u0440. \u0415\u0433\u043e \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432
    \u043f\u0440\u043e\u0435\u043a\u0442\u0435 \u043f\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430 ENIAC \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u0438\u044e
    \u0441\u0430\u043c\u043e\u0439 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0448\u0438\u043d. \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u0445\u0440\u0430\u043d\u0438\u043c\u043e\u0439
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b: \u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f
    \u0438\u0434\u0435\u044f, \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u043e\u043c \u0432 \"\u041f\u0435\u0440\u0432\u043e\u043c
    \u043f\u0440\u043e\u0435\u043a\u0442\u0435 \u043e\u0442\u0447\u0435\u0442\u0430 \u043e\u0431
    EDVAC\" (1945), \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c \u0432
    \u0442\u043e\u043c, \u0447\u0442\u043e \u0438 \u0434\u0430\u043d\u043d\u044b\u0435, \u0438
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 (\u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438)
    \u0434\u043e\u043b\u0436\u043d\u044b \u0445\u0440\u0430\u043d\u0438\u0442\u044c\u0441\u044f
    \u0432 \u043e\u0434\u043d\u043e\u0439 \u0438 \u0442\u043e\u0439 \u0436\u0435 \u043f\u0430\u043c\u044f\u0442\u0438
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430. \u042d\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u043e
    \u043c\u0430\u0448\u0438\u043d\u0443 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439
    \u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u0443\u0435\u043c\u043e\u0439,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443
    \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0438\u0437\u043c\u0435\u043d\u044f\u0442\u044c,
    \u043d\u0435 \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044f \u00ab\u0436\u0435\u043b\u0435\u0437\u043e\u00bb.
    \u0410\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430:
    \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430,
    \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0438\u0437 \u043f\u044f\u0442\u0438
    \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0435\u0439: 1.
    \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u043e-\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e (\u0410\u041b\u0423) \u2014
    \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    2. \u0423\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    (\u0423\u0423) \u2014 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e\u0440\u044f\u0434\u043a\u043e\u043c
    \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u0430\u043d\u0434.
    3. \u041f\u0430\u043c\u044f\u0442\u044c \u2014 \u0445\u0440\u0430\u043d\u0438\u0442 \u0434\u0430\u043d\u043d\u044b\u0435
    \u0438 \u043a\u043e\u043c\u0430\u043d\u0434\u044b. 4. \u0423\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430
    \u0432\u0432\u043e\u0434\u0430 \u2014 \u0434\u043b\u044f \u0432\u0432\u043e\u0434\u0430
    \u0434\u0430\u043d\u043d\u044b\u0445. 5. \u0423\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430
    \u0432\u044b\u0432\u043e\u0434\u0430 \u2014 \u0434\u043b\u044f \u0432\u044b\u0432\u043e\u0434\u0430
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432. \u0414\u0432\u043e\u0438\u0447\u043d\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430: \u041e\u043d \u043d\u0430\u0441\u0442\u043e\u044f\u043b
    \u043d\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438
    \u0434\u0432\u043e\u0438\u0447\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f (\u0432\u043c\u0435\u0441\u0442\u043e
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u043e\u0439, \u043a\u0430\u043a \u0432
    ENIAC), \u0447\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0443\u043f\u0440\u043e\u0441\u0442\u0438\u043b\u043e \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430. \u042d\u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u044c,
    \u043f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0430\u044f \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435
    \u0444\u043e\u043d-\u043d\u0435\u0439\u043c\u0430\u043d\u043e\u0432\u0441\u043a\u043e\u0439
    \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u044b, \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440 \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435
    \u043f\u043e\u0434\u0430\u0432\u043b\u044f\u044e\u0449\u0435\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430
    \u0432\u0441\u0435\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432, \u043e\u0442 \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d\u043e\u0432
    \u0434\u043e \u0441\u0443\u043f\u0435\u0440\u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432.\n\n\U0001F4A3
    \u0412\u043e\u0435\u043d\u043d\u044b\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438:
    \u043e\u0442 \u0430\u0442\u043e\u043c\u043d\u043e\u0439 \u0431\u043e\u043c\u0431\u044b \u0434\u043e
    \u0431\u0430\u043b\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u043a\u0435\u0442
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0444\u0438\u0433\u0443\u0440
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e-\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 \u0421\u0428\u0410 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0438 \u043f\u043e\u0441\u043b\u0435 \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b. \u041c\u0430\u043d\u0445\u044d\u0442\u0442\u0435\u043d\u0441\u043a\u0438\u0439
    \u043f\u0440\u043e\u0435\u043a\u0442: \u0412 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u0430 \u041b\u043e\u0441-\u0410\u043b\u0430\u043c\u043e\u0441\u0441\u043a\u043e\u0439
    \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438 \u043e\u043d \u0432\u043d\u0435\u0441
    \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u0439 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443
    \u0438\u043c\u043f\u043b\u043e\u0437\u0438\u0432\u043d\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430
    \u043f\u043e\u0434\u0440\u044b\u0432\u0430 \u043f\u043b\u0443\u0442\u043e\u043d\u0438\u0435\u0432\u043e\u0439
    \u0431\u043e\u043c\u0431\u044b. \u041e\u043d \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c
    \u00ab\u0432\u0437\u0440\u044b\u0432\u043d\u044b\u0445 \u043b\u0438\u043d\u0437\u00bb \u2014
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432\u0437\u0440\u044b\u0432\u0447\u0430\u0442\u044b\u0445
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0436\u0438\u043c\u0430\u043b\u0430
    \u043f\u043b\u0443\u0442\u043e\u043d\u0438\u0435\u0432\u044b\u0439 \u0448\u0430\u0440 \u0434\u043e
    \u0441\u0432\u0435\u0440\u0445\u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0441 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0435\u0439. \u0418\u043c\u0435\u043d\u043d\u043e
    \u044d\u0442\u0430 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u0431\u044b\u043b\u0430
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0430 \u0432 \u0431\u043e\u043c\u0431\u0435
    \u00ab\u0422\u043e\u043b\u0441\u0442\u044f\u043a\u00bb, \u0441\u0431\u0440\u043e\u0448\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430 \u041d\u0430\u0433\u0430\u0441\u0430\u043a\u0438. \u0412\u043e\u0434\u043e\u0440\u043e\u0434\u043d\u0430\u044f
    \u0431\u043e\u043c\u0431\u0430: \u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b
    \u043e\u043d \u0431\u044b\u043b \u0432\u0435\u0434\u0443\u0449\u0438\u043c \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u043e\u043c
    \u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435
    \u0442\u0435\u0440\u043c\u043e\u044f\u0434\u0435\u0440\u043d\u043e\u0433\u043e \u043e\u0440\u0443\u0436\u0438\u044f,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043d\u0430\u0434 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c\u0438
    \u0430\u0441\u043f\u0435\u043a\u0442\u0430\u043c\u0438 \u0444\u0438\u0437\u0438\u043a\u0438
    \u0442\u0435\u0440\u043c\u043e\u044f\u0434\u0435\u0440\u043d\u044b\u0445 \u0440\u0435\u0430\u043a\u0446\u0438\u0439.
    \u0411\u0430\u043b\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u043a\u0435\u0442\u044b:
    \u0412 1950-\u0435 \u0433\u043e\u0434\u044b \u043e\u043d \u0431\u044b\u043b \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c
    \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0421\u0428\u0410
    \u0438 \u0441\u044b\u0433\u0440\u0430\u043b \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435 \u043f\u0435\u0440\u0432\u044b\u0445
    \u043c\u0435\u0436\u043a\u043e\u043d\u0442\u0438\u043d\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0431\u0430\u043b\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u043a\u0435\u0442
    (\u041c\u0411\u0420) \u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u044f\u0434\u0435\u0440\u043d\u043e\u0433\u043e
    \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043d\u0438\u044f.\n\n\U0001F9EC \u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0434\u0435\u0438
    \u0413\u0435\u043d\u0438\u0439 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0438 \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0442\u0430\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.
    \u0421\u0430\u043c\u043e\u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u044f\u0449\u0438\u0435\u0441\u044f
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u044b \u0438 \u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0435
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u044b: \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043c\u0430\u0448\u0438\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043c\u043e\u0433\u043b\u0430 \u0431\u044b \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c
    \u0441\u0430\u043c\u0443 \u0441\u0435\u0431\u044f. \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u043e\u0434\u0435\u043b\u044c \u2014 \u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442 (\u0441\u043e\u0432\u043e\u043a\u0443\u043f\u043d\u043e\u0441\u0442\u044c
    \u044f\u0447\u0435\u0435\u043a, \u043c\u0435\u043d\u044f\u044e\u0449\u0438\u0445 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435
    \u043f\u043e \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c)
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0439
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442 \u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442\u044c
    \u00ab\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440\u00bb,
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0439 \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u0441\u0432\u043e\u044e \u043a\u043e\u043f\u0438\u044e. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430,
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e,
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u0430\u043c\u043e\u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u044f\u0449\u0438\u0445\u0441\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c \u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u043d\u043e \u0438, \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u0414\u041d\u041a. \u041c\u0435\u0442\u043e\u0434
    \u041c\u043e\u043d\u0442\u0435-\u041a\u0430\u0440\u043b\u043e: \u041e\u043d \u0431\u044b\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u043e\u0440\u043e\u0432
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430 \u041c\u043e\u043d\u0442\u0435-\u041a\u0430\u0440\u043b\u043e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442
    \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0435 \u0432\u044b\u0431\u043e\u0440\u043a\u0438
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u0447.
    \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0441\u0442\u0430\u043b \u043d\u0435\u0437\u0430\u043c\u0435\u043d\u0438\u043c\u044b\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u044f\u0434\u0435\u0440\u043d\u043e\u0433\u043e \u043e\u0440\u0443\u0436\u0438\u044f \u0438
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043d\u0430\u0448\u0435\u043b
    \u0448\u0438\u0440\u043e\u043a\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0444\u0438\u0437\u0438\u043a\u0435, \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445.
    \"\u041a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 \u0438 \u043c\u043e\u0437\u0433\":
    \u0415\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f, \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u0447\u0435\u043d\u043d\u0430\u044f
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044c, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e, \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430
    \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u044b
    \u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u0432 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0448\u0438\u043d
    \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430.
    \u0412 \u043d\u0435\u0439 \u043e\u043d \u0437\u0430\u0442\u0440\u043e\u043d\u0443\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0432\u043e\u043f\u0440\u043e\u0441\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e
    \u0441\u0438\u0445 \u043f\u043e\u0440 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u0432
    \u0446\u0435\u043d\u0442\u0440\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a \u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430. \u0414\u0436\u043e\u043d \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0437\u0430 \u0441\u0432\u043e\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043d\u0430\u0433\u0440\u0430\u0434, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041f\u0440\u0435\u043c\u0438\u044e
    \u0411\u043e\u0445\u0435\u0440\u0430 (1938), \u041f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0441\u043a\u0443\u044e
    \u043c\u0435\u0434\u0430\u043b\u044c \u0421\u0432\u043e\u0431\u043e\u0434\u044b (1956) \u0438
    \u041f\u0440\u0435\u043c\u0438\u044e \u042d\u043d\u0440\u0438\u043a\u043e \u0424\u0435\u0440\u043c\u0438
    (1956), \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442
    \u0437\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0432 \u043d\u0430\u0443\u043a\u0435 \u0438 \u0442\u0435\u0445\u043d\u0438\u043a\u0435."
  achievementsEn: "John von Neyman left behind a legacy that covers so many areas that he is rightly considered one of the last great universals in science; his contribution has not merely been accomplished by certain tasks — in many cases, he has created whole new disciplines and laid the foundations of the modern world; his key achievements are described in detail below.\n\n* Mathematics and logic: Von Neuman's Mathematical Artwork was remarkably diverse and profound, working in both abstract and applied fields, often so far ahead of its time that its ideas were applied only decades later.Axiomatization of the theory of multiples: In his 1925 doctoral thesis, Von Neyman solved a fundamental problem caused by paradoxes in naive multiplies (e.g. Russell's paradox) and developed a strict axiom system that eliminated contradictions by introducing axiom of basics and the concept of class (as opposed to \"multiple\".His work was so important that he was the basis of the NBG axiom system (Nyman-Bernais-Goedel) and the theory of incompleteness and evidence: Fon Neyman actively participated in key discussions in 1930 on the fundamentals of mathematics. After learning about Kurt Goedel's theorems, he almost immediately realized their most important consequence: the inability to prove the consistency of arithmetic by her own means (the second Godel Theorem).Although Godel was the priority in the discovery, Von Neyman was one of the first to fully understand the scale of this attack on Gilbert's program, the theory of operators and the algebra of von Neuman: In the 1930s, in conjunction with F. J. Murray, he founded an entire field, the theory of the rings of operators, which later became the algebras of von Neyman, one of the main tools not only in pure mathematics but also in quantum physics.In this research, he also created a continuous geometry where space size can take not only whole values, but also any numbers between 0 and 1.His erotic theorem has become fundamental, and, as Mathematics Paul Halmosh wrote, \"If Von Neyman hadn't done anything else, they would have been enough to guarantee him mathematical immortality.\"\n\nQuantum Mechanics: The severity of the new physics, Von Neyman, is rightly considered to be one of the creators of the rigid mathematical machine of quantum mechanics.This allowed for the unification of the two versions of quantum mechanics that existed at the time, the Heisenberg matrix mechanics and the Schroedinger wave mechanics. The mathematical basis of quantum mechanics was the result of his classic book \"Mathematishe Grundlagen der Quantenmechanik\" (Mathematical Framework for quantum mechanics), published in 1932, which became the main textbook in mathematical quantum physics for decades.In it, he suggested, inter alia, a strict mathematical formulation of the measurement process and proved to the theory that it was impossible to hide parameters (although later it found a conceptual gap, it created an entire research path leading to Bell's theorem), and von Neyman considered quantum mechanics to be the most important part of his legacy.\n\n===Pharmacy and economics===The theory of games and economics: Fon Neuman's new science of decision-making did not simply apply mathematics to the economy; he created a new mathematical language for it. The theory of minimix (1928): This was the starting point for the whole game theory.Von Neuman has proven that for any final zero-sum game (where one wins equal the other loses), with full information, there is an optimal strategy that allows each player to minimize its maximum possible loss.\"Theory of Games and Economic Behavior\" (1944): In collaboration with Economist Oscar Morgenstern von Neuman, published a fundamental work that laid the foundation for the theory of games as a separate mathematical discipline and applied it to the economy, a book of great reverberence and determined the development of a whole field in economic science, for which the Nobel Prizes were subsequently awarded.Overall economic balance: In 1937, he decided to establish a balance in the model of economic growth, using the theory of a fixed point, which became one of the pillars of a modern mathematical economy.\n\nThe architecture of a modern computer is perhaps the most famous contribution by von Neuman, who has changed the world. His involvement in the ENIAC computer project has led to a rethinking of the concept of computing machines.The principle of stored software: The key idea expressed by von Neuman in the \"First Draft EDVAC Report\" (1945) was that both the data and the program(s) should be stored in the same computer memory. This made the machine universal and programmable, because the program could be modified without rebuilding the \"rail\".Von Neyman architecture: He proposed a computer logical structure consisting of five main parts: 1. The Arifmeticological device (ALU) is a computational device. 2. The control device (U) is a command control. 3. The memory is a data and command storage device. 4. The input devices are a data input device. 5. The output device is a output device.The twin system: He insisted on using a binary numeracy system (instead of a decimal place, like ENIAC), which has greatly simplified the computer design. This model, called the background-neman architecture, is still the basis of the vast majority of all existing computers, from smartphones to supercomputers.\n\n==History==The Manhattan Project: As a consultant to the Los Alamos Laboratory, he made a decisive contribution to the development of an implosion method for the detonation of a plutonium bomb.He calculated a mathematical model of \"explosive lenses\", an explosive system that squeezed a plutonium ball to a supercritical state with perfect symmetry, which was used in the Talstyak bomb dropped on Nagasaki, a hydrogen bomb: after the war, he was a leading consultant and involved in the development of thermonuclear weapons, working on key aspects of the physics of thermonuclear reactions.Ballistic Missiles: In the 1950s, he was the principal scientific adviser to the U.S. government and played a central role in the design and development of the first intercontinental ballistic missiles (IBM) and nuclear deterrence strategies.\n\n* Artificial life and other ideas of Genius von Neyman have also been manifested in the creation of concepts that have become the basis for future scientific directions. Self-replicating machines and cellular machines: In recent years, he has studied the theoretical possibility of creating a machine that could reproduce itself.He developed an abstract mathematical model, a cellular machine (the sum of cells that alter the state according to the set rules) and proved that such an machine could contain a \"universal designer\" capable of producing a copy. This post-mortem work not only laid the foundations for the theory of self-reproduction systems and artificial life, but was also believed to have pre-empted the discovery of the DNA structure.Monte Carlo: He was one of the initiators of the Monte Carlo statistical method, which uses random samples to solve complex mathematical and physical problems, which has become an indispensable tool in the design of nuclear weapons and has since been widely used in physics, economics and other fields.Computer and the Brain: His last, unfinished manuscript published postmortem was dedicated to comparing the architecture and principles of computing machines and the human brain, and he addressed fundamental issues that still remain the focus of cognitive science and artificial intelligence.John von Neyman was awarded many awards for his achievements, including the Boher Prize (1938), the Presidential Medal of Liberty (1956) and the Enrico Fermi Award (1956), which is awarded for outstanding advances in science and technology."
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u0414\u0436\u043e\u043d\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0434\u0430
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0439,
    \u043d\u043e \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u043c\u0435\u043b \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0442\u044c\u0441\u044f
    \u0436\u0438\u0437\u043d\u044c\u044e, \u0431\u044b\u043b \u0434\u0443\u0448\u043e\u0439
    \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0438 \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u043e\u0439
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439 \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433. \u0415\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u044f\u0440\u043a\u0438\u043c\u0438
    \u044d\u043f\u0438\u0437\u043e\u0434\u0430\u043c\u0438, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u044e\u0449\u0438\u043c\u0438
    \u0435\u0433\u043e \u043a\u0430\u043a \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c.
    \u041d\u0438\u0436\u0435 \u2014 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f
    \u0438 \u0434\u0435\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u043a\u0430\u0440\u044c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0438 \u0438 \u0432\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f
    \u0443\u043c\u0430\u043c\u0438 XX \u0432\u0435\u043a\u0430.\n\n\U0001F37C \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435
    \u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    28 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1903 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0442\u043e\u043b\u0438\u0446\u0435
    \u0412\u0435\u043d\u0433\u0440\u0438\u0438, \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435.
    \u041d\u0430 \u0441\u0432\u0435\u0442 \u043e\u043d \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0431\u043e\u0433\u0430\u0442\u043e\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435, \u0432 \u0434\u043e\u043c\u0435, \u0433\u0434\u0435 \u0446\u0430\u0440\u0438\u043b\u0430
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u0438\u0437\u043c\u0430. \u0421\u0435\u043c\u0435\u0439\u043d\u043e\u0435
    \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435: \u0414\u043e\u043c \u041d\u0435\u0439\u043c\u0430\u043d\u043e\u0432
    \u0431\u044b\u043b \u043c\u0435\u0441\u0442\u043e\u043c \u0432\u0441\u0442\u0440\u0435\u0447
    \u0431\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u043e\u0439 \u044d\u043b\u0438\u0442\u044b.
    \u041e\u0442\u0435\u0446, \u041c\u0430\u043a\u0441 \u041d\u0435\u0439\u043c\u0430\u043d,
    \u0447\u0430\u0441\u0442\u043e \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b \u043e\u0431\u0435\u0434\u044b,
    \u0433\u0434\u0435 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b\u0438\u0441\u044c \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430,
    \u043d\u0430\u0443\u043a\u0430 \u0438 \u0431\u0430\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0435
    \u0434\u0435\u043b\u043e. \u041c\u0430\u0442\u044c, \u041c\u0430\u0440\u0433\u0438\u0442,
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430 \u0438\u0437 \u0441\u0435\u043c\u044c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0446\u0435\u043d\u0438\u043b\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u0423 \u042f\u043d\u043e\u0448\u0430 \u0431\u044b\u043b\u043e \u0434\u0432\u0430 \u043c\u043b\u0430\u0434\u0448\u0438\u0445
    \u0431\u0440\u0430\u0442\u0430 \u2014 \u041c\u0438\u0445\u0430\u044d\u043b\u044c \u0438
    \u041d\u0438\u043a\u043e\u043b\u0430\u0441. \u041f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438: \u0421\u0435\u043c\u044c\u044f
    \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0430, \u0447\u0442\u043e \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 4-5 \u043b\u0435\u0442 \u042f\u043d\u043e\u0448
    \u043c\u043e\u0433 \u0443\u0434\u0438\u0432\u0438\u0442\u044c \u0433\u043e\u0441\u0442\u0435\u0439,
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0432 \u0432 \u0443\u043c\u0435 \u0434\u0432\u0430
    \u043c\u043d\u043e\u0433\u043e\u0437\u043d\u0430\u0447\u043d\u044b\u0445 \u0447\u0438\u0441\u043b\u0430
    \u0438\u043b\u0438 \u0432\u0441\u0442\u0430\u0432\u0438\u0432 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u0443\u044e
    \u0440\u0435\u043f\u043b\u0438\u043a\u0443 \u043d\u0430 \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d
    \u0432\u044b\u0443\u0447\u0438\u043b \u043f\u043e \u043a\u043d\u0438\u0433\u0430\u043c \u0438\u0437
    \u043e\u0442\u0446\u043e\u0432\u0441\u043a\u043e\u0439 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0433\u043e\u0440\u0434\u044f\u0441\u044c
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u0441\u044b\u043d\u0430,
    \u0442\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b
    \u043d\u0430 \u0432\u0441\u0435\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u043c \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438,
    \u043d\u0430\u043d\u0438\u043c\u0430\u044f \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439
    \u043f\u043e \u044f\u0437\u044b\u043a\u0430\u043c, \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0438 \u043c\u0443\u0437\u044b\u043a\u0435.\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430:
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f, \u0426\u044e\u0440\u0438\u0445 \u0438
    \u0434\u043e\u043a\u0442\u043e\u0440\u0430\u0442 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u043d\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u043e \u0435\u0433\u043e \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438.
    \u0413\u0438\u043c\u043d\u0430\u0437\u0438\u044f (1911\u20131921): \u041e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u0443\u044e
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043b\u0430\u0432\u0438\u043b\u0430\u0441\u044c
    \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f.
    \u0423\u0447\u0438\u0442\u0435\u043b\u044f \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u043e\u043d\u044f\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u0434\u0430\u043b\u0435\u043a\u043e \u043e\u043f\u0435\u0440\u0435\u0436\u0430\u0435\u0442
    \u0441\u0432\u0435\u0440\u0441\u0442\u043d\u0438\u043a\u043e\u0432. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041b\u0430\u0441\u043b\u043e \u0420\u0430\u0446, \u0437\u0430\u043c\u0435\u0442\u0438\u0432
    \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043b
    \u043e\u0431\u0443\u0447\u0430\u0442\u044c \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430
    \u043f\u043e \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435. \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b (1921\u20131926): \u041f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u043d\u0438\u044e
    \u043e\u0442\u0446\u0430, \u0436\u0435\u043b\u0430\u0432\u0448\u0435\u0433\u043e, \u0447\u0442\u043e\u0431\u044b
    \u0441\u044b\u043d \u0438\u043c\u0435\u043b \u00ab\u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e\u00bb
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u044e, \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u0438\u0439
    \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c \u043d\u0430 \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043e\u043d \u043d\u0435 \u0445\u043e\u0442\u0435\u043b \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u043d\u0430 \u0437\u0430\u043e\u0447\u043d\u043e\u0435 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043f\u043e\u0441\u0435\u0449\u0430\u044f \u043b\u0435\u043a\u0446\u0438\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u043a\u043e\u043d\u0446\u0435 \u0441\u0435\u043c\u0435\u0441\u0442\u0440\u043e\u0432,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0430\u0432\u0430\u0442\u044c \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u044b.
    \u0422\u0440\u043e\u0439\u043d\u043e\u0439 \u0443\u0447\u0435\u0431\u043d\u044b\u0439 \u043f\u043b\u0430\u043d:
    \u0412 1921\u20131923 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u0432
    \u0426\u044e\u0440\u0438\u0445. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e
    \u0447\u0442\u043e\u0431\u044b \u0443\u0447\u0438\u0442\u044c\u0441\u044f \u0432 \u043e\u0434\u043d\u043e\u043c
    \u043c\u0435\u0441\u0442\u0435, \u043e\u043d \u043a\u0443\u0440\u0441\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u0435\u0436\u0434\u0443 \u0426\u044e\u0440\u0438\u0445\u043e\u043c, \u0411\u0435\u0440\u043b\u0438\u043d\u043e\u043c
    \u0438 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u043e\u043c. \u0412 1925 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u0438\u043f\u043b\u043e\u043c
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430-\u0445\u0438\u043c\u0438\u043a\u0430 \u0432
    \u0426\u044e\u0440\u0438\u0445\u0435. \u0412 1926 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (PhD summa cum laude). \u0415\u0433\u043e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f,
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0430\u044f \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u0431\u044b\u043b\u0430
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0430 \u0435\u0449\u0435 \u0434\u043e \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u043f\u043b\u043e\u043c\u0430
    \u0445\u0438\u043c\u0438\u043a\u0430.\n\n\U0001F468\u200d\U0001F3EB \u0420\u0430\u0431\u043e\u0442\u0430
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0438 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u041a\u0430\u0440\u044c\u0435\u0440\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u0441 \u0441\u0430\u043c\u043e\u0433\u043e \u043d\u0430\u0447\u0430\u043b\u0430. \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 (1927\u20131930): \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0449\u0438\u0442\u044b
    \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u043c.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b \u0441 \u0414\u0430\u0432\u0438\u0434\u043e\u043c
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043d\u0430\u0434 \u043e\u0441\u043d\u043e\u0432\u0430\u043c\u0438
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u0435\u0433\u043e \u0438\u043c\u044f \u0441\u0442\u0430\u043b\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u0432 \u043c\u0438\u0440\u043e\u0432\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0440\u0443\u0433\u0430\u0445. \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d,
    \u0421\u0428\u0410 (\u0441 1930): \u0412 1930 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u043e\u0442 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u041f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u0435\u0433\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438, \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0432
    \u0432\u0441\u0435\u0433\u043e \u043e\u0434\u043d\u0443 \u0435\u0433\u043e \u0441\u0442\u0430\u0442\u044c\u044e.
    \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435. \u0412 1933 \u0433\u043e\u0434\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u0431\u044b\u043b \u043e\u0441\u043d\u043e\u0432\u0430\u043d
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 (IAS), \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0435\u0433\u043e \u0448\u0435\u0441\u0442\u0438 \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432 (\u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c,
    \u041a\u0443\u0440\u0442\u043e\u043c \u0413\u0451\u0434\u0435\u043b\u0435\u043c \u0438 \u0434\u0440\u0443\u0433\u0438\u043c\u0438).
    \u042d\u0442\u043e \u043c\u0435\u0441\u0442\u043e \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043e\u043d
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0440\u0443\u0442\u0438\u043d\u043e\u0439 \u0438 \u043d\u0435 \u0431\u0440\u0430\u043b
    \u043d\u0430 \u0441\u0435\u0431\u044f \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e
    \u043a\u0430\u0444\u0435\u0434\u0440\u0430\u043c\u0438, \u043f\u043e\u0441\u0432\u044f\u0449\u0430\u044f
    \u0432\u0441\u0435 \u0432\u0440\u0435\u043c\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c.\n\n\U0001F495
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0434\u0432\u0430
    \u0431\u0440\u0430\u043a\u0430 \u0438 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u0436\u0438\u0432\u044b\u043c,
    \u043e\u0431\u0449\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0438 \u0436\u0438\u0437\u043d\u0435\u0440\u0430\u0434\u043e\u0441\u0442\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0447\u0442\u043e \u0440\u0435\u0437\u043a\u043e
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0441 \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u00ab\u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f\u00bb. \u041f\u0435\u0440\u0432\u044b\u0439 \u0431\u0440\u0430\u043a
    (1935\u20131937): \u0412 1935 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041c\u0430\u0440\u0438\u0435\u0442\u0442\u0435 \u041a\u043e\u0432\u0435\u0448\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0438\u0437 \u0437\u043d\u0430\u0442\u043d\u043e\u0439
    \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0438.
    \u0412 1936 \u0433\u043e\u0434\u0443 \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0434\u043e\u0447\u044c \u041c\u0430\u0440\u0438\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0441\u0442\u0430\u043b\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u043e\u043c.
    \u0420\u0430\u0437\u0432\u043e\u0434 \u0438 \u0432\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a:
    \u0411\u0440\u0430\u043a \u0431\u044b\u043b \u043d\u0435\u0434\u043e\u043b\u0433\u0438\u043c.
    \u0412 1937 \u0433\u043e\u0434\u0443 \u043e\u043d \u0440\u0430\u0437\u0432\u0435\u043b\u0441\u044f.
    \u0412\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041a\u043b\u0430\u0440\u0435
    \u0414\u044d\u043d, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0434\u043d\u043e\u0439 \u0438\u0437
    \u043f\u043e\u0435\u0437\u0434\u043e\u043a. \u041a\u043b\u0430\u0440\u0430 \u0431\u044b\u043b\u0430
    \u0443\u043c\u043d\u043e\u0439, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439, \u0438\u043c\u0435\u0432\u0448\u0435\u0439
    \u043e\u043f\u044b\u0442 \u0432 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u0441\u0432\u043e\u0435\u0439 \u043f\u0435\u0440\u0432\u043e\u0439 \u0436\u0435\u043d\u044b,
    \u041a\u043b\u0430\u0440\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043c\u0443\u0436\u0430:
    \u043e\u043d\u0430 \u043f\u0438\u0441\u0430\u043b\u0430 \u043a\u043e\u0434 \u0434\u043b\u044f
    \u043f\u0435\u0440\u0432\u044b\u0445 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432,
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0430 \u0441 \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u043c\u0438
    \u0434\u043b\u044f \u041c\u0430\u043d\u0445\u044d\u0442\u0442\u0435\u043d\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0430
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b. \u0418\u0445 \u0431\u0440\u0430\u043a
    \u0431\u044b\u043b \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c \u0438 \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0441\u044f
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438 \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d\u0430. \u0414\u0435\u0442\u0435\u0439 \u0432 \u044d\u0442\u043e\u043c
    \u0431\u0440\u0430\u043a\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e. \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440
    \u0438 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438: \u0424\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0435\u0439 \u043b\u044e\u0431\u043e\u0432\u044c\u044e \u043a \u0431\u0443\u0440\u043d\u044b\u043c
    \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0430\u043c, \u0445\u043e\u0440\u043e\u0448\u0435\u0439
    \u0435\u0434\u0435 \u0438 \u0434\u043e\u0440\u043e\u0433\u0438\u043c \u043a\u043e\u0441\u0442\u044e\u043c\u0430\u043c.
    \u0415\u0433\u043e \u0434\u043e\u043c \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u043b \u043e\u0442\u043a\u0440\u044b\u0442 \u0434\u043b\u044f
    \u043a\u043e\u043b\u043b\u0435\u0433 \u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432.
    \u041e\u043d \u043e\u0431\u043e\u0436\u0430\u043b \u0448\u0443\u0442\u043a\u0438, \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u044b
    (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0435) \u0438 \u0431\u044b\u043b
    \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u043c \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0447\u0438\u043a\u043e\u043c.
    \u0423 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043f\u043e \u043d\u043e\u0447\u0430\u043c,
    \u0441\u043b\u0443\u0448\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u0443\u0437\u044b\u043a\u0443 (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0412\u0430\u0433\u043d\u0435\u0440\u0430)
    \u043d\u0430 \u043f\u043e\u043b\u043d\u043e\u0439 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438,
    \u0447\u0442\u043e, \u043f\u043e \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c,
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u043e \u0435\u043c\u0443 \u0434\u0443\u043c\u0430\u0442\u044c.\n\n\U0001F91D
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0451\u043d\u044b\u043c\u0438: \u043e\u0442 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430
    \u0434\u043e \u0413\u0451\u0434\u0435\u043b\u044f \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u0431\u044b\u043b \u043d\u0430 \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u0440\u0443\u0436\u0435\u043b\u044e\u0431\u0435\u043d
    \u0438 \u043b\u0438\u0448\u0435\u043d \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0435\u0440\u0438\u044f,
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0435\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u0431\u044b\u043b\u0438 \u0442\u0435\u043f\u043b\u044b\u043c\u0438 \u0438\u043b\u0438 \u043a\u0440\u0430\u0439\u043d\u0435
    \u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438. \u0421 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c: \u041e\u043d\u0438 \u0431\u044b\u043b\u0438
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0440\u0430\u0437\u043d\u0438\u0446\u0443
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0438 \u0441\u043a\u043b\u0430\u0434\u0435
    \u0443\u043c\u0430, \u043e\u043d\u0438 \u0447\u0430\u0441\u0442\u043e \u0433\u0443\u043b\u044f\u043b\u0438
    \u0432\u043c\u0435\u0441\u0442\u0435 \u043f\u043e \u043a\u0430\u043c\u043f\u0443\u0441\u0443,
    \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044f \u0444\u0438\u0437\u0438\u043a\u0443. \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0446\u0435\u043d\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u043e\u0449\u044c \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430,
    \u043a\u0430\u043a-\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u00ab\u0436\u0430\u043b\u0435\u0435\u0442\u00bb, \u0447\u0442\u043e \u0442\u043e\u0442
    \u0443\u0448\u0435\u043b \u0438\u0437 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.
    \u0421 \u041a\u0443\u0440\u0442\u043e\u043c \u0413\u0451\u0434\u0435\u043b\u0435\u043c:
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438.
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u0432 \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u0435
    \u043e\u0442 \u0442\u0435\u043e\u0440\u0435\u043c \u0413\u0451\u0434\u0435\u043b\u044f \u043e
    \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435. \u0413\u0451\u0434\u0435\u043b\u044c,
    \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u0443\u0432\u0430\u0436\u0430\u043b
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430, \u043d\u043e \u0441\u0447\u0438\u0442\u0430\u043b
    \u0435\u0433\u043e \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u00ab\u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u043c\u00bb
    \u0438 \u00ab\u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u043c\u00bb.
    \u0421 \u041e\u0441\u043a\u0430\u0440\u043e\u043c \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d\u043e\u043c:
    \u0418\u0445 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u043d\u0430\u0434 \u043a\u043d\u0438\u0433\u043e\u0439 \u00ab\u0422\u0435\u043e\u0440\u0438\u044f
    \u0438\u0433\u0440\u00bb \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u043e \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e
    \u0434\u0440\u0443\u0436\u0431\u0443. \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d
    \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b, \u0447\u0442\u043e \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0442\u0435\u0440\u043f\u0435\u043b\u0438\u0432\u044b\u043c \u0438 \u043c\u0435\u0442\u043e\u0434\u0438\u0447\u043d\u044b\u043c,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u0443
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438. \u0421 \u042d\u0434\u0432\u0430\u0440\u0434\u043e\u043c
    \u0422\u0435\u043b\u043b\u0435\u0440\u043e\u043c \u0438 \u0421\u0442\u0430\u043d\u0438\u0441\u043b\u0430\u0432\u043e\u043c
    \u0423\u043b\u0430\u043c\u043e\u043c: \u0421 \u043d\u0438\u043c\u0438 \u0435\u0433\u043e
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u043b\u0430 \u0442\u0435\u0441\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u041b\u043e\u0441-\u0410\u043b\u0430\u043c\u043e\u0441\u0435.
    \u0423\u043b\u0430\u043c, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0432\u044b\u0441\u043e\u043a\u043e \u0446\u0435\u043d\u0438\u043b \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    \u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0435\u0433\u043e \u00ab\u0441\u0430\u043c\u044b\u043c
    \u0431\u044b\u0441\u0442\u0440\u044b\u043c \u0443\u043c\u043e\u043c\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u043a\u043e\u0433\u0434\u0430-\u043b\u0438\u0431\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b.
    \u0421\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441 \u0410\u043b\u0430\u043d\u043e\u043c
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u043e\u043c: \u0425\u043e\u0442\u044f \u043e\u043d\u0438
    \u0431\u044b\u043b\u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u044b (\u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u043a\u0430\u043a \u0440\u0430\u0437 \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f,
    \u043a\u043e\u0433\u0434\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b
    \u0442\u0430\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c),
    \u0438\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u0441\u0443\u0433\u0443\u0431\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438.
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d, \u043f\u043e \u0441\u043b\u0443\u0445\u0430\u043c,
    \u0431\u044b\u043b \u043f\u043e\u0440\u0430\u0436\u0435\u043d \u0438\u0434\u0435\u0435\u0439
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430 \u043e\u0431 \u00ab\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0448\u0438\u043d\u0435\u00bb, \u043d\u043e \u043e\u043d\u0438 \u0442\u0430\u043a
    \u0438 \u043d\u0435 \u0441\u0442\u0430\u043b\u0438 \u0431\u043b\u0438\u0437\u043a\u0438\u043c\u0438
    \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u2014 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u044f
    \u0432 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0442\u0435 \u0431\u044b\u043b\u0438
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0432\u0435\u043b\u0438\u043a\u0438 (\u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u0431\u044b\u043b \u0437\u0430\u043c\u043a\u043d\u0443\u0442 \u0438 \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u0435\u043d).\n\n\u26b0\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430 \u0431\u044b\u043b\u0438 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u044b
    \u0431\u043e\u043b\u0435\u0437\u043d\u044c\u044e, \u043d\u043e \u043e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b
    \u044f\u0441\u043d\u043e\u0441\u0442\u044c \u0443\u043c\u0430 \u0434\u043e \u0441\u0430\u043c\u043e\u0433\u043e
    \u043a\u043e\u043d\u0446\u0430. \u0423\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f:
    \u0412 1955 \u0433\u043e\u0434\u0443, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u043d\u0430\u0434 \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u043c \u0440\u0430\u043a\u0435\u0442
    \u0432 \u041f\u0435\u043d\u0442\u0430\u0433\u043e\u043d\u0435, \u0443 \u043d\u0435\u0433\u043e
    \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c \u0441\u0438\u043b\u044c\u043d\u044b\u0435
    \u0431\u043e\u043b\u0438. \u0412\u0441\u043a\u043e\u0440\u0435 \u0435\u043c\u0443 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437
    \u2014 \u0440\u0430\u043a \u043a\u043e\u0441\u0442\u0435\u0439 (\u0441\u0430\u0440\u043a\u043e\u043c\u0430)
    \u0438\u043b\u0438 \u0440\u0430\u043a \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439
    \u0436\u0435\u043b\u0435\u0437\u044b (\u0432 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0434\u0430\u043d\u043d\u044b\u0435 \u0440\u0430\u0437\u043d\u044f\u0442\u0441\u044f).
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0431\u044b\u043b\u0430, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0432\u044b\u0437\u0432\u0430\u043d\u0430 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c
    \u043e\u0431\u043b\u0443\u0447\u0435\u043d\u0438\u0435\u043c \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u041b\u043e\u0441-\u0410\u043b\u0430\u043c\u043e\u0441\u0435,
    \u0445\u043e\u0442\u044f \u043e\u043d \u0432\u0441\u0435\u0433\u0434\u0430 \u043e\u0442\u0440\u0438\u0446\u0430\u043b
    \u044d\u0442\u043e. \u0418\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435 \u0432\u0435\u0440\u043e\u0439:
    \u0411\u0443\u0434\u0443\u0447\u0438 \u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u043e\u043c
    (\u0438\u043b\u0438 \u043c\u044f\u0433\u043a\u0438\u043c \u0430\u0442\u0435\u0438\u0441\u0442\u043e\u043c)
    \u0432\u0441\u044e \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c, \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d, \u043b\u0435\u0436\u0430 \u0432 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0435,
    \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0441\u044f \u043f\u043e\u0431\u0435\u0441\u0435\u0434\u043e\u0432\u0430\u0442\u044c
    \u0441 \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u043c.
    \u041c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0437\u044c\u044f \u0431\u044b\u043b\u0438
    \u0448\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u044d\u0442\u0438\u043c. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0443\u0441\u043f\u043e\u043a\u043e\u0438\u0442\u044c \u0441\u0432\u043e\u044e
    \u043c\u0430\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u0430. \u0421\u0430\u043c\u0430 \u0431\u0435\u0441\u0435\u0434\u0430
    \u0441 \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u043e\u043c \u0431\u044b\u043b\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0439
    \u0438, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0434\u0440\u0443\u0437\u0435\u0439,
    \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u044f. \u0421\u043c\u0435\u0440\u0442\u044c:
    \u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    8 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1957 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0435\u043d\u043d\u043e\u043c
    \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0435 \u0423\u043e\u043b\u0442\u0435\u0440\u0430
    \u0420\u0438\u0434\u0430 \u0432 \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 53 \u043b\u0435\u0442. \u041e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0441\u043c\u0435\u0440\u0442\u0438: \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0431\u044b\u0441\u0442\u0440\u043e
    \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043b\u0430,
    \u0438 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u043a\u043e\u0432\u0430\u043d
    \u043a \u0438\u043d\u0432\u0430\u043b\u0438\u0434\u043d\u043e\u0439 \u043a\u043e\u043b\u044f\u0441\u043a\u0435.
    \u0418\u0437-\u0437\u0430 \u0441\u0442\u0440\u043e\u0436\u0430\u0439\u0448\u0435\u0433\u043e
    \u0440\u0435\u0436\u0438\u043c\u0430 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u0441\u0442\u0438
    (\u043e\u043d \u0431\u044b\u043b \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u043e\u043c
    \u043f\u043e \u044f\u0434\u0435\u0440\u043d\u044b\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u043c)
    \u0437\u0430 \u0435\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0441\u043b\u0435\u0434\u0438\u043b\u0438
    \u0432\u043e\u0435\u043d\u043d\u044b\u0435 \u0432\u0440\u0430\u0447\u0438. \u0414\u0430\u0436\u0435
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0443\u043c\u0438\u0440\u0430\u043b, \u0435\u043c\u0443
    \u043d\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u043b\u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c
    \u0441 \u043d\u0435\u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c\u0438
    \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u044f\u043c\u0438. \u0415\u0433\u043e
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u043d\u0435\u0434\u0435\u043b\u0438
    \u043f\u0440\u043e\u0448\u043b\u0438 \u0432 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0438
    \u0441\u0435\u043c\u044c\u0438 \u2014 \u0436\u0435\u043d\u044b \u041a\u043b\u0430\u0440\u044b
    \u0438 \u0434\u043e\u0447\u0435\u0440\u0438 \u041c\u0430\u0440\u0438\u043d\u044b. \u041f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u043d\u0430 \u0441\u0442\u0435\u043d\u0435
    \u0435\u0433\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430 \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0432\u0435\u0448\u0435\u043d\u0430 \u0442\u0430\u0431\u043b\u0438\u0447\u043a\u0430:
    \u00ab\u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d,
    1903\u20131957. \u0415\u0433\u043e \u0440\u0430\u0437\u0443\u043c \u0431\u044b\u043b \u0442\u0435\u043c
    \u043c\u043e\u0441\u0442\u043e\u043c, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0448\u0430\u0433\u043d\u0443\u043b \u0438\u0437
    \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u0435\u00bb.
    \u041e\u043d \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0440\u0443\u0434\u044b, \u0430
    \u0446\u0435\u043b\u0443\u044e \u043a\u0430\u0440\u0442\u0438\u043d\u0443 \u043c\u0438\u0440\u0430,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a
    \u0438 \u043c\u0430\u0448\u0438\u043d\u0430 \u043c\u043e\u0433\u043b\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0432 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438."
  personalLifeEn: "John von Neuman's life is not only a series of genius insights, but also the story of a man who was able to enjoy life, who was the soul of the company, and who remained a mysterious figure for many colleagues. His biography is full of vivid episodes characterizing him as a person. Below is the timeline and details of his personal life, career path and relationships with other prominent minds of the 20th century.\n\n==Breathing==The birth and childhood in Budapest, John von Neuman, was born on December 28, 1903 in the capital of Hungary, Budapest, and was born in a rich Jewish family, a house where intellectual liberalism prevailed.Janos had two younger brothers, Michael and Nicholas, who had the first genius: the family remembered that at the age of 4 to 5, Janos could surprise the guests by dividing two many numbers in mind, or by adding a witty line in ancient Greek that he had learned from the books of his father's library; his father, proud of his son's abilities, nevertheless insisted on comprehensive development by hiring teachers in languages, history, and music.\n\n♪ Studying: The gymnasium, Zurich and the Ph.D. of Von Neuman's Education was untrivial and demonstrated its enormous performance. (1911–1921) He entered the famous Lutheran Gymnasium in Budapest, which was famous for its high level of teaching.University years (1921–1926) At the insistence of the father who wanted his son to have a \"practice\" profession, von Neyman entered the Zurich Polytechnic at the Faculty of Chemical Science, but he did not want to leave math, and he went to the University of Budapest to study mathematics by taking lectures only at the end of semesters to take exams.He studied at the University of Berlin from 1921 to 1923 and moved to Zurich instead of studying in one place, he studied between Zurich, Berlin and Budapest. He received a degree in chemical engineering in Zurich in 1925, and in 1926 he defended a doctoral thesis in mathematics at the University of Budapest (PhD summa cum laude).His dissertation on axiomization of the theory of multiples was written prior to formal chemistship.\n\n==History==The European period (1927–1930): After his defence, he became a private professor at the University of Berlin and then at Hamburg, and during that period he worked actively with David Gilbert in Göttingen, working on the basics of quantum mechanics, at which time his name became known in the world mathematical circles.Princeton, United States of America (since 1930): In 1930, he received an invitation from Princeton University, a legend that he was invited to read only one article, first a professor in Princeton. In 1933, when the Institute of Advanced Studies (IAS) was founded, von Neyman became one of his six life professors (with Albert Einstein, Kurt Gedel and others).Interestingly, he has never been involved in administrative routines or took over the leadership of the departments, devoted to research all the time.\n\n▪ Personal life: In 1935, he married Mariette Koveshi, who was a prominent Hungarian family, born in 1936 of Marina's daughter, who became a famous economist.Shortly after, he married Clara Dan, whom he met on one of the trips, and Clara was a smart, educated woman with experience in programming and mathematics, and unlike her first wife, Clara was active in the research work of her husband: she wrote the code for the first computers, helped with the calculations for the Manhattan project and edited his work, and their marriage was happy and extended until the death of von Neuman.There were no children in this marriage. Fon Neuman was known for his love of frantic parties, good food and expensive costumes. His house in Princeton was often open to colleagues and students. He loved jokes, jokes (including a few risky ones) and was a great storyteller. He had a habit of working at night listening to classical music (especially Wagner) on full volume, which he said helped him think.\n\n==Career======Career========Career======Career========Careers=========Careers==================================================================================================================================)====================================================================Einstein, who valued the mathematical power of von Neuman, once said that he \"sorry\" that he had left pure mathematics in applied fields. With Kurt Goedel: Relationships were complex. Fon Neiman was thrilled with the Godel theory of incompleteness. Godel, in turn, respected von Neyman, but considered him too \"applied\" and \"pragmatic.\" With Oscar Morgenstern, their collaboration on the game theory has become a true friendship.Morgenstern recalled that von Neiman was incredibly patient and methodical when he explained complex mathematical concepts to an economist, with Edward Teller and Stanislaw Ulam, who were closely associated with him in Los Alamos, and that Ulam, among other things, highly valued von Neuman and called him the \"highest mind he's ever met.Competition with Alan Turing: Although they knew each other (Thuring was working in Princeton at the time Von Neuman was there), their relationship remained highly professional. Fon Neuman was rumored to have been struck by Turing's idea of a \"universal machine,\" but they never became close friends — the differences in temperament were too great (Thuring was closed and ascetic).\n\nIn 1955, while working on a rocket project in the Pentagon, he began to suffer severe pain, and was soon diagnosed with bone cancer (sarcoma) or pancreatic cancer (the data vary from source to source).The disease was probably caused by radiation exposure during his work in Los Alamos, even though he had always denied it. The test of faith: being an agnostic (or soft atheist) throughout his life, von Neiman, lying in hospital, agreed to talk to a Catholic priest, many friends were shocked by it, but later he found himself doing so to calm his mother, who was religious.His conversation with the bishop was brief and, according to his friends, did not change his scientific outlook; death: John von Neyman died on 8 February 1957 at Walter Reed Military Hospital in Washington, D.C., at the age of 53; the circumstances of his death: the disease was rapidly progressing and he was chained to a wheelchair; and due to the strictest regime of secrecy (he was a nuclear consultant) he was followed by military doctors.Even when he died, he was not allowed to speak to unverified visitors, and his last weeks were surrounded by his family, Clara's wife and Marina's daughter. After his death on the wall of his office, a sign was hung at the Institute of Advanced Studies: \"John von Neyman, 1903–157. His mind was the bridge on which man had moved from the past to the future.\"He was buried in a cemetery in Princeton, leaving a whole picture of the world in which man and machine could exist in harmony."
  shortBioRu: "\u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u2014
    \u044d\u0442\u043e \u043e\u0434\u043d\u0430 \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0444\u0438\u0433\u0443\u0440 \u0432 \u043d\u0430\u0443\u043a\u0435 XX \u0432\u0435\u043a\u0430,
    \u0447\u0435\u0439 \u0433\u0435\u043d\u0438\u0439 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u0444\u0438\u0437\u0438\u043a\u0443,
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0443.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u0435\u0433\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f.
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u0441\u0435\u043c\u044c\u044f: \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0433\u0435\u043d\u0438\u044f \u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 28 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1903 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435,
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u0445\u043e\u0434\u0438\u0432\u0448\u0435\u043c
    \u0432 \u0441\u043e\u0441\u0442\u0430\u0432 \u0410\u0432\u0441\u0442\u0440\u043e-\u0412\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439
    \u0438\u043c\u043f\u0435\u0440\u0438\u0438. \u0415\u0433\u043e \u0438\u043c\u044f \u043f\u0440\u0438
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u2014 \u041d\u0435\u0439\u043c\u0430\u043d
    \u042f\u043d\u043e\u0448 \u041b\u0430\u0439\u043e\u0448 (Neumann J\u00e1nos Lajos). \u041e\u043d
    \u0431\u044b\u043b \u0441\u0442\u0430\u0440\u0448\u0438\u043c \u0438\u0437 \u0442\u0440\u0435\u0445
    \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0435. -
    \u041e\u0442\u0435\u0446, \u041c\u0430\u043a\u0441 (\u041c\u0438\u043a\u0448\u0430) \u041d\u0435\u0439\u043c\u0430\u043d,
    \u0431\u044b\u043b \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u043c \u0431\u0430\u043d\u043a\u0438\u0440\u043e\u043c,
    \u0438\u043c\u0435\u0432\u0448\u0438\u043c \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043f\u043e \u043f\u0440\u0430\u0432\u0443.
    - \u041c\u0430\u0442\u044c, \u041c\u0430\u0440\u0433\u0438\u0442 \u041a\u0430\u043d\u043d,
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430 \u0438\u0437 \u0441\u0435\u043c\u044c\u0438,
    \u0440\u0430\u0437\u0431\u043e\u0433\u0430\u0442\u0435\u0432\u0448\u0435\u0439 \u043d\u0430
    \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435 \u0441\u0435\u043b\u044c\u0445\u043e\u0437\u0442\u0435\u0445\u043d\u0438\u043a\u043e\u0439.
    \u0412 1913 \u0433\u043e\u0434\u0443, \u0437\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u0438
    \u043f\u0435\u0440\u0435\u0434 \u0438\u043c\u043f\u0435\u0440\u0438\u0435\u0439, \u043e\u0442\u0435\u0446
    \u042f\u043d\u043e\u0448\u0430 \u0431\u044b\u043b \u0432\u043e\u0437\u0432\u0435\u0434\u0435\u043d
    \u0432 \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u043a\u043e\u0435 \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u043e,
    \u0438 \u0441\u0435\u043c\u044c\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0442\u0438\u0442\u0443\u043b \"margittai\", \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u0438\u0441\u0442\u0430\u0432\u043a\u0443
    \"\u0444\u043e\u043d\". \u0421\u0430\u043c \u042f\u043d\u043e\u0448 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043d\u0435\u043c\u0435\u0446\u043a\u0443\u044e
    \u0432\u0435\u0440\u0441\u0438\u044e \u2014 \"von Neumann\", \u0430 \u0435\u0433\u043e \u043e\u0442\u0435\u0446
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b \u0444\u0430\u043c\u0438\u043b\u0438\u044e
    \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439. \u0412\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434:
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0421 \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u042f\u043d\u043e\u0448 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u044b\u0435
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u0440\u0430\u0436\u0430\u043b\u0438 \u0432\u0441\u0435\u0445 \u0432\u043e\u043a\u0440\u0443\u0433.
    - \u041d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0430\u044f \u043f\u0430\u043c\u044f\u0442\u044c:
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 6 \u043b\u0435\u0442 \u043e\u043d
    \u043c\u043e\u0433 \u0448\u0443\u0442\u0438\u0442\u044c \u043d\u0430 \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438 \u0432 \u0443\u043c\u0435 \u0434\u0435\u043b\u0438\u0442\u044c \u0432\u043e\u0441\u044c\u043c\u0438\u0437\u043d\u0430\u0447\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430. \u0421\u0435\u043c\u044c\u044f \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u043b\u0430
    \u0433\u043e\u0441\u0442\u0435\u0439 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0438\u0435\u0439
    \u0435\u0433\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u043e\u0439
    \u043a\u043d\u0438\u0433\u0438. - \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430:
    \u041a 8 \u0433\u043e\u0434\u0430\u043c \u043e\u043d \u043e\u0441\u0432\u043e\u0438\u043b
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435.
    - \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435: \u0421 1911 \u0433\u043e\u0434\u0430
    \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u041b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u0439 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438.
    \u0415\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0447\u0435\u0432\u0438\u0434\u0435\u043d, \u0447\u0442\u043e \u0448\u043a\u043e\u043b\u0430
    \u043d\u0430\u043d\u044f\u043b\u0430 \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0447\u0430\u0441\u0442\u043d\u044b\u0445
    \u0440\u0435\u043f\u0435\u0442\u0438\u0442\u043e\u0440\u043e\u0432, \u0430 \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439 \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0413\u0430\u0431\u043e\u0440 \u0421\u0435\u0433\u0451. \u0421 15 \u043b\u0435\u0442 \u043e\u043d
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0432\u044b\u0441\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0441 \u0421\u0435\u0433\u0451,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u043f\u043e\u0442\u0440\u044f\u0441\u0435\u043d
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u044e\u043d\u043e\u0448\u0438.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446, \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c,
    \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043d\u0435
    \u043f\u0440\u0438\u043d\u0435\u0441\u0435\u0442 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e
    \u0434\u043e\u0445\u043e\u0434\u0430, \u043d\u0430\u0441\u0442\u043e\u044f\u043b \u043d\u0430
    \u0431\u043e\u043b\u0435\u0435 \"\u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u043e\u0439\"
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0438. \u0412 \u0438\u0442\u043e\u0433\u0435
    \u0431\u044b\u043b \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442 \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441:
    \u042f\u043d\u043e\u0448 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u0445\u0438\u043c\u0438\u044e, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0447\u0430\u043b\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0424\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435, \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0432
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u043a \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c\u0443
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044e \u0432 \u0440\u0430\u0437\u043d\u044b\u0445
    \u0441\u0442\u0440\u0430\u043d\u0430\u0445 \u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445.
    - 1921-1923: \u041e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f
    \u0445\u0438\u043c\u0438\u0438. - 1923-1926: \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u043e \u0442\u043e\u0439 \u0436\u0435
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432 \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u043e\u043c
    \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c\u0435 (\u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u0430\u044f
    \u0432\u044b\u0441\u0448\u0430\u044f \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430), \u0433\u0434\u0435 \u0432 1925 \u0433\u043e\u0434\u0443
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u0438\u043f\u043b\u043e\u043c \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430-\u0445\u0438\u043c\u0438\u043a\u0430.
    - 1926: \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0415\u0433\u043e
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. \u041a
    \u044d\u0442\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0435\u0449\u0435
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19-20 \u043b\u0435\u0442 \u043e\u043d
    \u0443\u0436\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u0431\u043e\u0442,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u043e\u0432\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u0434\u0438\u043f\u043b\u043e\u043c\u043e\u0432 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f, \u043e\u0434\u043d\u0430\u043a\u043e, \u0431\u044b\u043b\u0430
    \u043d\u0435\u0434\u043e\u043b\u0433\u043e\u0439 \u0438\u0437-\u0437\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438. - 1927-1929: \u0411\u044b\u043b \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    - 1929-1930: \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. - \u0412 \u044d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u0442\u0435\u0441\u043d\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b
    \u0441 \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0414\u0430\u0432\u0438\u0434\u043e\u043c \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c
    \u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430 \u0434\u043b\u044f \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438, \u0433\u0434\u0435 \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432
    \u0432 \u0433\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u0432\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435.
    - \u0412 1928 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u043e \u043c\u0438\u043d\u0438\u043c\u0430\u043a\u0441\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u0433\u0440. \u041f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u0421\u0428\u0410
    \u0438 \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u041f\u0440\u0435\u0434\u0432\u0438\u0434\u044f \u0443\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u0435
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435, \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0438\u0437 \u0421\u0428\u0410. - 1930: \u041e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0421\u0428\u0410 \u0438 \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    - 1933: \u041a\u043e\u0433\u0434\u0430 \u0431\u044b\u043b \u043e\u0441\u043d\u043e\u0432\u0430\u043d
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (Institute for Advanced Study) \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u0445 \u0448\u0435\u0441\u0442\u0438
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b \u044d\u0442\u0443 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438. \u0421\u0440\u0435\u0434\u0438
    \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433 \u0431\u044b\u043b\u0438 \u0410\u043b\u044c\u0431\u0435\u0440\u0442
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d \u0438 \u041a\u0443\u0440\u0442 \u0413\u0451\u0434\u0435\u043b\u044c.
    - 1937: \u041e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e. - 1938: \u0416\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041a\u043b\u0430\u0440\u0435 \u0414\u044d\u043d, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0441\u0442\u0430\u043b\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u043e\u043c
    \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u0441 \u043d\u0438\u043c \u043d\u0430\u0434
    \u0440\u0430\u043d\u043d\u0438\u043c\u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u043c\u0438.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0431\u044b\u043b\u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0448\u0438\u0440\u043e\u043a\u0438.
    \u041e\u043d \u0432\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 (\u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d\u0430), \u044d\u0440\u0433\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0412\u043a\u043b\u0430\u0434 \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0430\u0442\u043e\u043c\u043d\u043e\u0439 \u0431\u043e\u043c\u0431\u044b \u0438 \u0432\u043e\u0435\u043d\u043d\u044b\u0435
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0432\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f \u0432 \u0432\u043e\u0435\u043d\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432
    \u0441\u0432\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442 \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447. - \u0421 1940 \u0433\u043e\u0434\u0430 \u043e\u043d \u0431\u044b\u043b
    \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u043e\u043c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0430\u0440\u043c\u0435\u0439\u0441\u043a\u0438\u0445 \u0438 \u0432\u043e\u0435\u043d\u043d\u043e-\u043c\u043e\u0440\u0441\u043a\u0438\u0445
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0439. - \u041e\u043d \u0441\u0442\u0430\u043b
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u043c
    \u041c\u0430\u043d\u0445\u044d\u0442\u0442\u0435\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430
    \u043f\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0430\u0442\u043e\u043c\u043d\u043e\u0439
    \u0431\u043e\u043c\u0431\u044b \u0432 \u041b\u043e\u0441-\u0410\u043b\u0430\u043c\u043e\u0441\u0435.
    \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e
    \u0438\u043c\u043f\u043b\u043e\u0437\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u0437\u0440\u044b\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u0434\u043b\u044f \u0434\u0435\u0442\u043e\u043d\u0430\u0446\u0438\u0438 \u043f\u043b\u0443\u0442\u043e\u043d\u0438\u0435\u0432\u043e\u0439
    \u0431\u043e\u043c\u0431\u044b. \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0432\u0435\u043b
    \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0441\u0447\u0435\u0442\u044b
    \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430.
    - \u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430\u0434 \u0442\u0435\u0440\u043c\u043e\u044f\u0434\u0435\u0440\u043d\u044b\u043c
    \u043e\u0440\u0443\u0436\u0438\u0435\u043c, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435
    \u043d\u0430\u0434 \u0432\u043e\u0434\u043e\u0440\u043e\u0434\u043d\u043e\u0439 \u0431\u043e\u043c\u0431\u043e\u0439,
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u044f \u0441 \u042d\u0434\u0432\u0430\u0440\u0434\u043e\u043c
    \u0422\u0435\u043b\u043b\u0435\u0440\u043e\u043c \u0438 \u0421\u0442\u0430\u043d\u0438\u0441\u043b\u0430\u0432\u043e\u043c
    \u0423\u043b\u0430\u043c\u043e\u043c. \u0410\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430 \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u044d\u0440\u044b \u0421\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u0432\u043f\u0435\u0440\u0435\u0434, \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c
    \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u044b \u043f\u0435\u0440\u0432\u044b\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432. - \u0415\u0433\u043e
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u043c
    \u0431\u044b\u043b \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c\u044e
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0440\u0430\u0441\u0447\u0435\u0442\u044b \u0434\u043b\u044f \u0430\u0442\u043e\u043c\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0435\u043a\u0442\u0430. - \u0412 1945 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u00ab\u041f\u0435\u0440\u0432\u044b\u0439
    \u043f\u0440\u043e\u0435\u043a\u0442 \u043e\u0442\u0447\u0435\u0442\u0430 \u043e\u0431 EDVAC\u00bb
    (First Draft of a Report on the EDVAC). \u042d\u0442\u043e\u0442 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442,
    \u0445\u043e\u0442\u044f \u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u043d \u043d\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0433\u0440\u0443\u043f\u043f\u044b \u041c\u043e\u0443\u0447\u043b\u0438
    \u0438 \u042d\u043a\u043a\u0435\u0440\u0442\u0430, \u0441\u043e\u0437\u0434\u0430\u0432\u0448\u0438\u0445
    ENIAC, \u044f\u0441\u043d\u043e \u0438 \u043f\u043e\u043b\u043d\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043a\u0430\u043a \u0444\u043e\u043d-\u043d\u0435\u0439\u043c\u0430\u043d\u043e\u0432\u0441\u043a\u0430\u044f
    \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c: 1. \u0414\u0432\u043e\u0438\u0447\u043d\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430: \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0434\u0432\u043e\u0438\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u0434\u0430 \u0434\u043b\u044f
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0430\u043d\u043d\u044b\u0445
    \u0438 \u043a\u043e\u043c\u0430\u043d\u0434. 2. \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0445\u0440\u0430\u043d\u0438\u043c\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b:
    \u0421\u0430\u043c\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 (\u043d\u0430\u0431\u043e\u0440
    \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0439) \u0434\u043e\u043b\u0436\u043d\u0430
    \u0445\u0440\u0430\u043d\u0438\u0442\u044c\u0441\u044f \u0432 \u043f\u0430\u043c\u044f\u0442\u0438
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430 \u043d\u0430\u0440\u0430\u0432\u043d\u0435
    \u0441 \u0434\u0430\u043d\u043d\u044b\u043c\u0438. \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e
    \u0438\u0437\u043c\u0435\u043d\u044f\u0442\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443
    \u0431\u0435\u0437 \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043d\u043e\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0438 \u0434\u0435\u043b\u0430\u043b\u043e \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u043c.
    3. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430:
    \u041a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 \u0434\u043e\u043b\u0436\u0435\u043d
    \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u044c \u0438\u0437 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e-\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 (\u0410\u041b\u0423), \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f (\u0423\u0423), \u043f\u0430\u043c\u044f\u0442\u0438,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432
    \u0432\u0432\u043e\u0434\u0430 \u0438 \u0432\u044b\u0432\u043e\u0434\u0430. \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0447\u0442\u043e \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445, \u043a\u0442\u043e
    \u0443\u0432\u0438\u0434\u0435\u043b \u0432 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u043c\u0430\u0448\u0438\u043d\u0443,
    \u0430 \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447, \u0447\u0442\u043e \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u043c\u0435\u0442\u043e\u0434\u0430 \u041c\u043e\u043d\u0442\u0435-\u041a\u0430\u0440\u043b\u043e.
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c.
    \u041e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u041a\u043e\u043c\u0438\u0441\u0441\u0438\u0438
    \u043f\u043e \u0430\u0442\u043e\u043c\u043d\u043e\u0439 \u044d\u043d\u0435\u0440\u0433\u0438\u0438
    \u0421\u0428\u0410 (Atomic Energy Commission) \u0432 1955 \u0433\u043e\u0434\u0443. \u0415\u0433\u043e
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u0441\u043c\u0435\u0441\u0442\u0438\u043b\u0438\u0441\u044c
    \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u043e\u0432
    \u0438 \u0441\u0432\u044f\u0437\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043c\u043e\u0437\u0433\u0430
    \u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430, \u0447\u0442\u043e
    \u043d\u0430\u0448\u043b\u043e \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0432
    \u0435\u0433\u043e \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u0447\u0435\u043d\u043d\u043e\u0439
    \u043a\u043d\u0438\u0433\u0435 \u00ab\u041a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440
    \u0438 \u043c\u043e\u0437\u0433\u00bb (The Computer and the Brain). \u0412 1955 \u0433\u043e\u0434\u0443
    \u0435\u043c\u0443 \u0431\u044b\u043b \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \"\u0440\u0430\u043a\" (\u0441\u0430\u0440\u043a\u043e\u043c\u0430
    \u043a\u043e\u0441\u0442\u0438). \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0442\u044f\u0436\u0435\u043b\u0443\u044e \u0431\u043e\u043b\u0435\u0437\u043d\u044c, \u043e\u043d
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0441\u0432\u043e\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u044f. \u0414\u0436\u043e\u043d \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    8 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1957 \u0433\u043e\u0434\u0430 \u0432 \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d\u0435,
    \u043e\u043a\u0440\u0443\u0433 \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u044f, \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 53 \u043b\u0435\u0442. \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0435\u0433\u043e \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u043d\u044b\u0435
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0443\u044e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443,
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0441\u0434\u0435\u043b\u0430\u043b \u0435\u0433\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0443\u0447\u0435\u043d\u044b\u0445 XX \u0432\u0435\u043a\u0430."
  shortBioEn: "John von Neyman is one of the key figures in 20th-century science whose genius covered mathematics, physics, economics, and information science, and his life is the story of an incredible intelligence whose ideas formed the basis of the modern digital world.His name at birth was Neimann János Lajos, who was the eldest of three sons in a wealthy Jewish family.In 1913, for his credit to the Empire, Janos' father was built into noble dignity, and the family was given the investigative title \"Margittai\", which allowed the use of the \"phone\". Janos himself later used the German version, \"won Neumann\", and his father kept his name unchanged.Incredible memory: At the age of six, he could joke in ancient Greek and in his mind in 8-digit numbers, and the family entertained the guests by showing his ability to remember the pages of a phone book.His math talent was so obvious that the school hired private tutors for him, and one of his teachers was a famous mathematician Gabor Segyo, who, since the age of 15, had been doing the highest math with Sego, who was shocked by the young man's abilities. Despite his genius, his father, fearing that math would not generate enough income, insisted on a more practical profession.As a result, a compromise was reached: Janos was supposed to study chemistry, but he did not leave math, and Fon Neuman received a brilliant education in Europe, demonstrating his ability to study simultaneously in different countries and universities. - 1921-1923: He went to Berlin University to study chemistry.1923-1926: Continuing his studies in the same field at the Zurich Polytechnic (Swiss Higher Technical School), where he received a degree in chemical engineering in 1925. 1926: In the same year, he defended his Ph.D. in mathematics at the University of Budapest, and his doctoral work was devoted to axiomization of the theory of multiples.By that time, while still a student, at the age of 19 to 20, he had already published several fundamental mathematical works, including the modern definition of order numbers, and Von Neiman began his academic career in Europe, but was short-lived because of the political situation. 1927-1929: He was a visiting professor at the University of Berlin.During this period, he worked closely with great mathematician David Gilbert in Göttingen to create a mathematical foundation for quantum mechanics, where von Neyman formalized theory with the help of operators in the Gilbert Space.Moving to the United States and the flourishing of the career in anticipation of a deteriorating political environment in Europe, von Neyman accepted an invitation from the United States. 1930: He moved to the United States and became a professor at Princeton University. 1933: When the prestigious Institute for Advanced Studies (Institute for Advanced Study) was founded in Princeton, von Neyman became one of his first six professors of mathematics.His colleagues included Albert Einstein and Kurt Goedel: He acquired American citizenship. - 1938: Married to Clara Dan, who later became a famous programmer and worked with him on early computers. During this period, his scientific interests were incredibly broad. He contributed to axiomatic multi-dimensional theory, functional analysis (Algebras von Neyman), ergodic theory, and many other fields.He has been a key participant in the Manhattan Nuclear Bomb Project in Los Alamos since 1940.He proposed the concept of implosion that was used to detonate the plutonium bomb, and he also made critical calculations for this process. - After the war, he continued to work on thermonuclear weapons, including a hydrogen bomb, in cooperation with Edward Teller and Stanislav Ulam.The computer architecture and the birth of the digital age are the most famous contributions by von Neyman, who has defined the development of computing technology for decades to come, in the form of the first computer architecture. His interest in computers was directly related to the need to make difficult calculations for the nuclear project. In 1945 he published the First Draft Report on the EDVAC (First Draft of a Report on the EDVAC).This document, although based on the work of the Mouchley and Eckert group that created ENIAC, clearly and fully formulated the key principles that later became known as the background-nemanian architecture: 1. The main ideas were: 1. The dual system: Use of the binary code to present data and commands. 2. The stored program principle: The program itself (the set of instructions) should be stored in computer memory on an equal basis with the data.3. The main devices: The computer must consist of an arithmetic-logic device (ALU), a control device (UU), a memory, and input and output devices.It is noteworthy that von Neyman was one of the first to see on the computer not just a large computing machine, but a powerful tool to solve the enormous scientific and engineering problems that led to the Monte Carlo method, and in recent years and legacy, von Neyman has continued to work actively in recent years, and became a member of the Atomic Energy Commission of the United States in 1955.His interests shifted to the theory of automatic machines and the connection between brain and computer work, as reflected in his unfinished book \"The Computer and the Brain\", in 1955, he was diagnosed with \"cancer\" (sharcoma bone) and continued his research despite a serious illness. John von Neuman died on February 8, 1957 in Washington, D.C., at the age of 53.His work has laid the foundation for most modern computers that still use its architectural principles, and his contribution to quantum mechanics, economics and mathematics has made him one of the most influential scientists of the 20th century."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0414\u0436\u043e\u043d\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439,
    \u043d\u043e \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445,
    \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445, \u0430 \u043f\u043e\u0440\u043e\u0439
    \u0438 \u0448\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0445 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0445
    \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432. \u0415\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438, \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0439
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0438 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u0438\u0435
    \u043f\u043e\u0440\u043e\u0436\u0434\u0430\u043b\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0445\u043e\u0434\u0438\u043b\u0438
    \u043f\u043e \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0443 \u0438 \u041b\u043e\u0441-\u0410\u043b\u0430\u043c\u043e\u0441\u0443
    \u043a\u0430\u043a \u043b\u0435\u0433\u0435\u043d\u0434\u044b. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u044f\u0440\u043a\u0438\u0435 \u0438\u0437 \u043d\u0438\u0445 \u2014 \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445.\n\n\U0001F4DA
    \u0424\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0430\u043c\u044f\u0442\u044c
    \u0438 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f
    \u042d\u0442\u043e \u0441\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0444\u0430\u043a\u0442\u043e\u0432
    \u043e \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0435. \u0415\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0431\u044b\u043b\u0438 \u0443\u0432\u0435\u0440\u0435\u043d\u044b,
    \u0447\u0442\u043e \u043e\u043d \u043c\u044b\u0441\u043b\u0438\u0442 \u043d\u0435 \u043a\u0430\u043a
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0430 \u043a\u0430\u043a \u043c\u0430\u0448\u0438\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0435\u0449\u0451 \u0438 \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439 \u043f\u0430\u043c\u044f\u0442\u044c\u044e.
    \u0421\u0442\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c:
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043d\u0430 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0435
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 \u043a\u0442\u043e-\u0442\u043e
    \u043f\u043e\u0441\u043f\u043e\u0440\u0438\u043b, \u0447\u0442\u043e \u043d\u0438\u043a\u0442\u043e
    \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0446\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c \u043f\u0435\u0440\u0432\u0443\u044e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443
    \u0440\u043e\u043c\u0430\u043d\u0430 \u0427\u0430\u0440\u043b\u044c\u0437\u0430 \u0414\u0438\u043a\u043a\u0435\u043d\u0441\u0430
    \u00ab\u041f\u043e\u0432\u0435\u0441\u0442\u044c \u043e \u0434\u0432\u0443\u0445 \u0433\u043e\u0440\u043e\u0434\u0430\u0445\u00bb.
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e
    \u043f\u0440\u043e\u0434\u0435\u043a\u043b\u0430\u043c\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0451 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e. \u041a\u043e\u0433\u0434\u0430
    \u0433\u043e\u0441\u0442\u0438 \u043f\u0440\u0438\u0448\u043b\u0438 \u0432 \u0438\u0437\u0443\u043c\u043b\u0435\u043d\u0438\u0435,
    \u043e\u043d \u043f\u043e\u0436\u0430\u043b \u043f\u043b\u0435\u0447\u0430\u043c\u0438 \u0438
    \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u042d\u0442\u043e \u0436\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0430\u0447\u0430\u043b\u043e. \u0412\u044b \u0431\u044b \u0443\u0434\u0438\u0432\u0438\u043b\u0438\u0441\u044c,
    \u0435\u0441\u043b\u0438 \u0431\u044b \u044f \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b
    \u0435\u0451 \u0446\u0435\u043b\u0438\u043a\u043e\u043c\u00bb. \u0418 \u043e\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043c\u043e\u0433 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c
    \u0446\u0435\u043b\u044b\u0435 \u0433\u043b\u0430\u0432\u044b \u043a\u043d\u0438\u0433,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0447\u0438\u0442\u0430\u043b \u043e\u0434\u0438\u043d
    \u0440\u0430\u0437 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435. \u041a\u043b\u0430\u0441\u0441\u0438\u043a\u0430
    \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e:
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 6 \u043b\u0435\u0442 \u043e\u043d
    \u043c\u043e\u0433 \u0446\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u0430
    \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435 \u0424\u0443\u043a\u0438\u0434\u0438\u0434\u0430 (\u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0430), \u0447\u0435\u043c \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b
    \u0432 \u0437\u0430\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u0438 \u0432 \u0433\u043e\u0441\u0442\u0438
    \u043a \u0435\u0433\u043e \u043e\u0442\u0446\u0443. \u0422\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u0430\u044f
    \u043a\u043d\u0438\u0433\u0430: \u0421\u0435\u043c\u044c\u044f \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u043b\u0430\u0441\u044c
    \u0442\u0435\u043c, \u0447\u0442\u043e \u043f\u0440\u043e\u0441\u0438\u043b\u0430 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0433\u043e
    \u042f\u043d\u043e\u0448\u0430 \u043d\u0430\u0439\u0442\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u0439
    \u043d\u043e\u043c\u0435\u0440 \u043b\u044e\u0431\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435, \u043d\u0430\u0437\u044b\u0432\u0430\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u043b\u0438\u0446\u0443. \u041c\u0430\u043b\u044c\u0447\u0438\u043a,
    \u0437\u0430\u0433\u043b\u044f\u043d\u0443\u0432 \u0432 \u043a\u043d\u0438\u0433\u0443 \u043d\u0430
    \u0441\u0435\u043a\u0443\u043d\u0434\u0443, \u0442\u0443\u0442 \u0436\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u043d\u043e\u043c\u0435\u0440, \u0430 \u0437\u0430\u0442\u0435\u043c \u043c\u043e\u0433
    \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u0435\u0449\u0451 \u043f\u0430\u0440\u0443
    \u0434\u0435\u0441\u044f\u0442\u043a\u043e\u0432 \u043d\u043e\u043c\u0435\u0440\u043e\u0432
    \u043f\u043e\u0434\u0440\u044f\u0434 \u043f\u043e \u043f\u0430\u043c\u044f\u0442\u0438.
    \u041c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f:
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0441\u0442\u0443\u0434\u0435\u043d\u0442 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0435\u043c\u0443 \u0437\u0430\u0434\u0430\u0447\u0443: \u00ab\u0414\u0432\u0430 \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0438\u0441\u0442\u0430
    \u0435\u0434\u0443\u0442 \u043d\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0434\u0440\u0443\u0433
    \u0434\u0440\u0443\u0433\u0443. \u041c\u0443\u0445\u0430 \u043b\u0435\u0442\u0438\u0442
    \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438 \u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e...
    \u041a\u043e\u0433\u0434\u0430 \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0438\u0441\u0442\u044b
    \u0432\u0441\u0442\u0440\u0435\u0442\u044f\u0442\u0441\u044f, \u043a\u0430\u043a\u043e\u0435
    \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u0440\u043e\u043b\u0435\u0442\u0438\u0442
    \u043c\u0443\u0445\u0430?\u00bb \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0437\u0430\u0434\u0430\u0447\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0447\u0430\u0441\u0442\u043e
    \u0440\u0435\u0448\u0430\u044e\u0442 \u0447\u0435\u0440\u0435\u0437 \u0441\u0443\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0440\u044f\u0434\u0430.
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b
    \u0437\u0430 \u043f\u0430\u0440\u0443 \u0441\u0435\u043a\u0443\u043d\u0434. \u0421\u0442\u0443\u0434\u0435\u043d\u0442
    \u0443\u043d\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u0412\u044b
    \u0437\u043d\u0430\u043b\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u00bb. \u041d\u0430
    \u0447\u0442\u043e \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0443\u0434\u0438\u0432\u0438\u043b\u0441\u044f:
    \u00ab\u041a\u0430\u043a\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435? \u042f
    \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u043e\u0441\u0443\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043b
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u0440\u044f\u0434 \u0432
    \u0443\u043c\u0435\u00bb.\n\n\U0001F973 \u042d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0435
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u043f\u043e\u043b\u043d\u043e\u0439
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u0431\u0440\u0430\u0437\u0443 \u00ab\u0441\u043a\u0443\u0447\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430\u00bb. \u041e\u043d \u043b\u044e\u0431\u0438\u043b
    \u0448\u0443\u043c, \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438 \u0438 \u0433\u0440\u043e\u043c\u043a\u0443\u044e
    \u043c\u0443\u0437\u044b\u043a\u0443. \u041e\u0444\u0438\u0441 \u043a\u0430\u043a \u0441\u0442\u0443\u0434\u0438\u044f
    \u0437\u0432\u0443\u043a\u043e\u0437\u0430\u043f\u0438\u0441\u0438: \u0415\u0433\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0431\u044b\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442 \u043d\u0430 \u0432\u0435\u0441\u044c \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d.
    \u041a\u043e\u0433\u0434\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439, \u043e\u043d \u0432\u043a\u043b\u044e\u0447\u0430\u043b
    \u043d\u0435\u043c\u0435\u0446\u043a\u0443\u044e \u043e\u043f\u0435\u0440\u0443 \u0412\u0430\u0433\u043d\u0435\u0440\u0430
    \u043d\u0430 \u043f\u043e\u043b\u043d\u0443\u044e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c.
    \u0421\u043e\u0441\u0435\u0434\u0438 \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0436\u0430\u043b\u043e\u0432\u0430\u043b\u0438\u0441\u044c,
    \u043d\u043e \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u043d\u0435 \u0440\u0435\u0448\u0430\u043b\u0441\u044f \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u0435\u043c\u0443 \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u0435. \u0421\u0430\u043c
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0433\u0440\u043e\u043c\u043a\u0430\u044f \u043c\u0443\u0437\u044b\u043a\u0430
    \u00ab\u0432\u044b\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u00bb \u043f\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0435
    \u0448\u0443\u043c\u044b \u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u0435\u043c\u0443
    \u043c\u044b\u0441\u043b\u0438\u0442\u044c \u0432 \u043f\u043e\u043b\u043d\u0443\u044e \u0441\u0438\u043b\u0443.
    \u041e\u043d \u043c\u043e\u0433 \u0447\u0430\u0441\u0430\u043c\u0438 \u0441\u0438\u0434\u0435\u0442\u044c
    \u0437\u0430 \u0441\u0442\u043e\u043b\u043e\u043c, \u043f\u043e\u043a\u0430 \u0438\u0437
    \u0435\u0433\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430 \u0434\u043e\u043d\u043e\u0441\u0438\u043b\u0438\u0441\u044c
    \u0437\u0432\u0443\u043a\u0438 \u00ab\u0412\u0430\u043b\u044c\u043a\u0438\u0440\u0438\u0439\u00bb.
    \u041a\u043e\u0440\u043e\u043b\u044c \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043e\u043a:
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u043e\u0431\u043e\u0436\u0430\u043b
    \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438 \u0438 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b
    \u0438\u0445 \u0443 \u0441\u0435\u0431\u044f \u0434\u043e\u043c\u0430 \u043a\u0430\u0436\u0434\u044b\u0435
    \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435. \u0415\u0433\u043e \u0441\u0442\u043e\u043b\u044b
    \u043b\u043e\u043c\u0438\u043b\u0438\u0441\u044c \u043e\u0442 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u043d\u043e\u0439
    \u0435\u0434\u044b \u0438 \u0434\u043e\u0440\u043e\u0433\u0438\u0445 \u0432\u0438\u043d.
    \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u043e\u043d \u043c\u043e\u0433 \u043f\u043e\u0441\u0440\u0435\u0434\u0438
    \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0430 \u043e \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435
    \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e \u0437\u0430\u043c\u043e\u043b\u0447\u0430\u0442\u044c,
    \u043f\u043e\u0434\u043e\u0439\u0442\u0438 \u043a \u0434\u043e\u0441\u043a\u0435 \u0438
    \u043d\u0430\u0447\u0430\u0442\u044c \u0438\u0441\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0435\u0451 \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438, \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044f
    \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0438\u0434\u0435\u044e, \u0430 \u0437\u0430\u0442\u0435\u043c, \u0441\u0442\u0435\u0440\u0435\u0432
    \u0432\u0441\u0451, \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043a \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0443
    \u043a\u0430\u043a \u043d\u0438 \u0432 \u0447\u0451\u043c \u043d\u0435 \u0431\u044b\u0432\u0430\u043b\u043e.
    \u0428\u043e\u0444\u0451\u0440 \u0438 \u00ab\u042f\u043d\u043a\u0438\u00bb: \u0411\u0443\u0434\u0443\u0447\u0438
    \u043e\u0447\u0435\u043d\u044c \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043e\u043d \u0432\u0441\u0435\u0433\u0434\u0430
    \u0435\u0437\u0434\u0438\u043b \u043d\u0430 \u0434\u043e\u0440\u043e\u0433\u0438\u0445 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f\u0445.
    \u0412 \u041b\u043e\u0441-\u0410\u043b\u0430\u043c\u043e\u0441\u0435, \u0433\u0434\u0435
    \u0431\u044b\u043b\u0430 \u0441\u0442\u0440\u043e\u0436\u0430\u0439\u0448\u0430\u044f \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0432\u0441\u0435 \u0445\u043e\u0434\u0438\u043b\u0438 \u0432 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0445
    \u0432\u043e\u0435\u043d\u043d\u044b\u0445 \u00ab\u0434\u0436\u0438\u043f\u0430\u0445\u00bb,
    \u043e\u043d \u043d\u0430\u0441\u0442\u043e\u044f\u043b \u043d\u0430 \u0442\u043e\u043c,
    \u0447\u0442\u043e\u0431\u044b \u0435\u043c\u0443 \u0432\u044b\u0434\u0435\u043b\u0438\u043b\u0438
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0434\u043b\u0438\u043d\u043d\u044b\u0439
    \u043b\u0438\u043c\u0443\u0437\u0438\u043d. \u041e\u0445\u0440\u0430\u043d\u0430 \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u0431\u044b\u043b\u0430 \u0432 \u0448\u043e\u043a\u0435, \u043d\u043e \u043f\u0440\u0438\u0432\u044b\u043a\u043b\u0430.
    \u041a\u043e\u043b\u043b\u0435\u0433\u0438 \u0448\u0443\u0442\u0438\u043b\u0438, \u0447\u0442\u043e
    \u043f\u043e \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0433\u043e
    \u043b\u0438\u043c\u0443\u0437\u0438\u043d\u0430 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043d\u044f\u0442\u044c,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0435\u0445\u0430\u043b \u00ab\u0411\u043e\u043b\u044c\u0448\u043e\u0439
    \u0411\u043e\u0441\u0441\u00bb. \u0421\u043e\u043d \u0438 \u0440\u0435\u0436\u0438\u043c:
    \u041e\u043d \u043c\u043e\u0433 \u0437\u0430\u0441\u043d\u0443\u0442\u044c \u0432 \u043b\u044e\u0431\u043e\u043c
    \u043c\u0435\u0441\u0442\u0435 \u0438 \u0432 \u043b\u044e\u0431\u043e\u0439 \u043f\u043e\u0437\u0435,
    \u0441\u0442\u043e\u0438\u043b\u043e \u0435\u043c\u0443 \u0443\u0441\u0442\u0430\u0442\u044c.
    \u0420\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438, \u0447\u0442\u043e
    \u043e\u043d \u043c\u043e\u0433 \u0443\u0441\u043d\u0443\u0442\u044c \u043d\u0430 \u043f\u043e\u043b\u0443\u0441\u043b\u043e\u0432\u0435
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0434\u043e\u043a\u043b\u0430\u0434\u0430, \u0430 \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e
    \u0431\u0443\u0434\u0438\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 5 \u043c\u0438\u043d\u0443\u0442,
    \u043e\u043d \u0442\u0443\u0442 \u0436\u0435 \u0432\u0441\u0442\u0443\u043f\u0430\u043b
    \u0432 \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044e \u0438 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0443\u0441\u043a\u043e\u043b\u044c\u0437\u0430\u043b\u043e \u043e\u0442 \u0434\u043e\u043a\u043b\u0430\u0434\u0447\u0438\u043a\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0447\u0430\u0441\u043e\u0432.\n\n\U0001F5E3\ufe0f
    \u041e\u0441\u0442\u0440\u043e\u0443\u043c\u0438\u0435, \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u044b
    \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u044e\u043c\u043e\u0440\u0430 \u0424\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0438\u043c \u043e\u0441\u0442\u0440\u044b\u043c, \u0438\u043d\u043e\u0433\u0434\u0430
    \u044f\u0437\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c, \u043d\u043e \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u043b\u0438\u0441\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430. \u0410\u043d\u0435\u043a\u0434\u043e\u0442\u044b \u043d\u0430
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u0445: \u041e\u043d \u043b\u044e\u0431\u0438\u043b
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u044b
    (\u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438 \u0444\u0440\u0438\u0432\u043e\u043b\u044c\u043d\u044b\u0435) \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043b\u0435\u043a\u0446\u0438\u0439. \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0447\u0435\u043d\u044c \u043d\u0435\u0440\u0432\u043d\u0438\u0447\u0430\u043b, \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e
    \u0442\u043e\u0442 \u043d\u0430 \u0433\u0440\u0430\u043d\u0438 \u043f\u0440\u043e\u0432\u0430\u043b\u0430.
    \u0422\u043e\u0433\u0434\u0430 \u043e\u043d \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0435\u0433\u043e \u0438 \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u044f \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0443
    \u0432\u0430\u043c \u0430\u043d\u0435\u043a\u0434\u043e\u0442, \u0430 \u0432\u044b \u043f\u043e\u043a\u0430
    \u0443\u0441\u043f\u043e\u043a\u043e\u0438\u0442\u0435\u0441\u044c\u00bb. \u0421\u0442\u0443\u0434\u0435\u043d\u0442
    \u0440\u0430\u0441\u0441\u043c\u0435\u044f\u043b\u0441\u044f, \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u0438\u043b\u0441\u044f
    \u0438 \u0432 \u0438\u0442\u043e\u0433\u0435 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b\u0441\u044f. \u00ab\u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u0430\u00bb:
    \u0415\u0433\u043e \u043b\u044e\u0431\u0438\u043b\u0438 \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043e\u043d \u043c\u043e\u0433 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438
    \u0431\u044b\u0442\u043e\u0432\u044b\u043c\u0438 \u043f\u0440\u0438\u043c\u0435\u0440\u0430\u043c\u0438.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b, \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044f
    \u0441 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u043e\u043c \u0442\u0435\u043e\u0440\u0438\u044e
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439, \u043e\u043d \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u0412\u0441\u0451 \u043f\u0440\u043e\u0441\u0442\u043e. \u0415\u0441\u043b\u0438
    \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0434\u0432\u0430 \u043d\u043e\u0441\u043a\u0430
    \u2014 \u043e\u0434\u0438\u043d \u0447\u0451\u0440\u043d\u044b\u0439, \u043e\u0434\u0438\u043d
    \u0431\u0435\u043b\u044b\u0439, \u0438 \u0432\u044b \u0438\u0445 \u043f\u043e\u0442\u0435\u0440\u044f\u043b\u0438
    \u2014 \u0442\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \u0432\u044b \u043d\u0430\u0439\u0434\u0451\u0442\u0435
    \u0447\u0451\u0440\u043d\u044b\u0439. \u0410 \u0436\u0438\u0437\u043d\u044c \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0432\u044b \u043d\u0430\u0439\u0434\u0451\u0442\u0435 \u0431\u0435\u043b\u044b\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0430\u043c \u043d\u0435 \u043d\u0443\u0436\u0435\u043d\u00bb.
    \u041e\u0442\u0432\u0435\u0442 \u043d\u0430 \u043a\u0440\u0438\u0442\u0438\u043a\u0443:
    \u041a\u043e\u0433\u0434\u0430 \u043e\u0434\u0438\u043d \u0438\u0437 \u0447\u0438\u0441\u0442\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0443\u043f\u0440\u0435\u043a\u043d\u0443\u043b
    \u0435\u0433\u043e \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f
    \u00ab\u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439, \u0430 \u043d\u0435
    \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439\u00bb,
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b
    \u0441 \u0443\u043b\u044b\u0431\u043a\u043e\u0439: \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043d\u0435 \u0431\u044b\u0432\u0430\u0435\u0442 \u0447\u0438\u0441\u0442\u043e\u0439 \u0438\u043b\u0438
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439. \u041e\u043d\u0430 \u0431\u044b\u0432\u0430\u0435\u0442
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0439 \u0438\u043b\u0438 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0439.
    \u0410 \u0435\u0441\u043b\u0438 \u043e\u043d\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0430\u044f
    \u2014 \u043e\u043d\u0430 \u0440\u0430\u043d\u043e \u0438\u043b\u0438 \u043f\u043e\u0437\u0434\u043d\u043e
    \u043d\u0430\u0439\u0434\u0451\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u00bb.\n\n\U0001F6F8
    \u00ab\u042d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u0435\u00bb
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0438 \u043e\u0448\u0438\u0431\u043a\u0438
    \u0418\u043d\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0443\u043c \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b \u043a \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u043c
    \u043a\u0443\u0440\u044c\u0435\u0437\u0430\u043c, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f
    \u0438\u043b\u0438 \u0441\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u043b\u0441\u044f \u0441
    \u0447\u0435\u043c-\u0442\u043e, \u0447\u0442\u043e \u043d\u0435 \u043c\u043e\u0433 \u043f\u043e\u043d\u044f\u0442\u044c.
    \u0421\u043f\u043e\u0440 \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439: \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0430 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u043d\u0435\u0442 \u043f\u0440\u0435\u0434\u0435\u043b\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u0430\u043c\u044f\u0442\u0438. \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u043f\u0430\u0440\u0438\u0440\u043e\u0432\u0430\u043b: \u00ab\u041d\u0435\u0442, \u0435\u0441\u0442\u044c.
    \u042f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0435 \u043c\u043e\u0433\u0443
    \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c, \u0447\u0442\u043e \u0435\u043b
    \u043d\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043a \u0434\u0432\u0430 \u0434\u043d\u044f
    \u043d\u0430\u0437\u0430\u0434, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e
    \u044d\u0442\u043e \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u00bb.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0442\u043e\u0442 \u0436\u0435 \u0434\u0435\u043d\u044c
    \u043e\u043d \u043d\u0430 \u0441\u043f\u043e\u0440 \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u0430\u043b
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u043e\u0439
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u043f\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438,
    \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043d\u043e\u0439 \u0438\u043c 20 \u043b\u0435\u0442
    \u043d\u0430\u0437\u0430\u0434, \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e.
    \u0418\u043d\u0446\u0438\u0434\u0435\u043d\u0442 \u0441 \u0413\u0451\u0434\u0435\u043b\u0435\u043c:
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u043d \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b
    \u0441 \u041a\u0443\u0440\u0442\u043e\u043c \u0413\u0451\u0434\u0435\u043b\u0435\u043c \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0443\u044e
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443.
    \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0435\u043c\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f. \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u0443\u043b\u044b\u0431\u043d\u0443\u043b\u0441\u044f \u0438 \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u041a\u0443\u0440\u0442, \u0432\u044b \u0436\u0435 \u0437\u043d\u0430\u0435\u0442\u0435,
    \u044f \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043e\u0448\u0438\u0431\u0430\u044e\u0441\u044c
    \u0432 \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u0445. \u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u044f \u043f\u0440\u043e\u0432\u0435\u0440\u044e \u0432\u0430\u0448\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u044b\u00bb.
    \u041e\u043d \u0432\u0437\u044f\u043b \u043b\u0438\u0441\u0442, \u0431\u044b\u0441\u0442\u0440\u043e
    \u043f\u0440\u043e\u0441\u0447\u0438\u0442\u0430\u043b \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0432\u0435\u0440\u0435\u043d. \u0413\u0451\u0434\u0435\u043b\u044c \u0441\u0443\u0445\u043e
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u0412\u044b \u043e\u0448\u0438\u0431\u043b\u0438\u0441\u044c
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043e\u0434\u043d\u043e\u043c \u2014 \u0432\u044b
    \u0434\u0443\u043c\u0430\u0435\u0442\u0435, \u0447\u0442\u043e \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043e\u0448\u0438\u0431\u0430\u0435\u0442\u0435\u0441\u044c\u00bb. \u0424\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0440\u0430\u0441\u0445\u043e\u0445\u043e\u0442\u0430\u043b\u0441\u044f
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u044d\u0442\u043e
    \u043b\u0443\u0447\u0448\u0430\u044f \u0448\u0443\u0442\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u0441\u043b\u044b\u0448\u0430\u043b \u0437\u0430 \u043c\u0435\u0441\u044f\u0446.
    \u041f\u043e\u043a\u0443\u043f\u043a\u0430 \u0434\u043e\u043c\u0430: \u0424\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0431\u043e\u0433\u0430\u0442, \u043d\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u043d\u0435 \u0443\u043c\u0435\u043b \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u0434\u0435\u043d\u044c\u0433\u0438
    \u0432 \u0431\u044b\u0442\u0443. \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u043d
    \u043a\u0443\u043f\u0438\u043b \u0434\u043e\u043c \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u043d\u0435 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0432 \u043d\u0430 \u0446\u0435\u043d\u0443.
    \u041a\u043e\u0433\u0434\u0430 \u0436\u0435\u043d\u0430 \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0430
    \u0435\u0433\u043e, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044d\u0442\u043e \u0441\u0442\u043e\u0438\u0442,
    \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u042f \u043d\u0435 \u0437\u043d\u0430\u044e,
    \u043d\u043e \u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u0447\u0442\u043e
    \u044d\u0442\u043e \u0432\u044b\u0433\u043e\u0434\u043d\u043e, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u0443 \u0434\u043e\u043c\u0430 \u0435\u0441\u0442\u044c \u043f\u043e\u0434\u0432\u0430\u043b,
    \u0433\u0434\u0435 \u044f \u043c\u043e\u0433\u0443 \u0445\u0440\u0430\u043d\u0438\u0442\u044c
    \u0441\u0432\u043e\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u044b\u00bb.\n\n\U0001F579\ufe0f
    \u0428\u0430\u0445\u043c\u0430\u0442\u044b, \u0438\u0433\u0440\u044b \u0438 \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u043e\u0441\u0442\u044c
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u044b\u043b \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u043c
    \u0438\u0433\u0440\u043e\u043a\u043e\u043c, \u043d\u043e \u0435\u0433\u043e \u0430\u0437\u0430\u0440\u0442
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u043b \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u043b\u0451\u043d
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0438\u0433\u0440 \u0437\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043d\u044b\u043c \u0441\u0442\u043e\u043b\u043e\u043c:
    \u041e\u043d \u043e\u0431\u043e\u0436\u0430\u043b \u043f\u043e\u043a\u0435\u0440 \u0438
    \u0431\u0440\u0438\u0434\u0436. \u041f\u0440\u0438\u0447\u0451\u043c, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043e\u043d \u0438\u0433\u0440\u0430\u043b \u043d\u0435 \u043f\u043e \u00ab\u0447\u0438\u0441\u0442\u043e\u0439
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438\u00bb, \u0430 \u043f\u043e
    \u00ab\u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0444\u0430\u043a\u0442\u043e\u0440\u0443\u00bb.
    \u041e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b: \u00ab\u0412 \u043f\u043e\u043a\u0435\u0440\u0435
    \u043f\u043e\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u043d\u0435 \u0442\u043e\u0442,
    \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442 \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439,
    \u0430 \u0442\u043e\u0442, \u043a\u0442\u043e \u0443\u043c\u0435\u0435\u0442 \u0431\u043b\u0435\u0444\u043e\u0432\u0430\u0442\u044c.
    \u041d\u043e \u044f \u0437\u043d\u0430\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0438 \u0443\u043c\u0435\u044e \u0431\u043b\u0435\u0444\u043e\u0432\u0430\u0442\u044c\u00bb.
    \u041e\u043d \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u043b,
    \u043d\u043e \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u043b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e,
    \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u043e\u0431\u0438\u0436\u0430\u0442\u044c \u043f\u0430\u0440\u0442\u043d\u0451\u0440\u043e\u0432.
    \u041f\u0430\u0440\u0442\u0438\u044f \u0441 \u0448\u0430\u0445\u043c\u0430\u0442\u043d\u044b\u043c
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u043c: \u0417\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0445
    \u0448\u0430\u0445\u043c\u0430\u0442\u043d\u044b\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c
    \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u00ab\u043c\u0430\u0448\u0438\u043d\u044b \u0431\u0443\u0434\u0443\u0442 \u0438\u0433\u0440\u0430\u0442\u044c
    \u0432 \u0448\u0430\u0445\u043c\u0430\u0442\u044b \u043b\u0443\u0447\u0448\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430\u00bb.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438,
    \u043a\u0430\u043a \u044d\u0442\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u041e\u0447\u0435\u043d\u044c
    \u043f\u0440\u043e\u0441\u0442\u043e. \u041c\u0430\u0448\u0438\u043d\u0430 \u043d\u0435
    \u0443\u0441\u0442\u0430\u0451\u0442, \u043d\u0435 \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u0435\u0442\u0441\u044f
    \u0438 \u043d\u0435 \u0434\u0435\u043b\u0430\u0435\u0442 \u043e\u0448\u0438\u0431\u043e\u043a.
    \u0410 \u043e\u0448\u0438\u0431\u043a\u0438 \u2014 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435,
    \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0432 \u0448\u0430\u0445\u043c\u0430\u0442\u0430\u0445.
    \u0417\u043d\u0430\u0447\u0438\u0442, \u043a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0448\u0438\u043d\u0430 \u043d\u0430\u0443\u0447\u0438\u0442\u0441\u044f \u043d\u0435
    \u0434\u0435\u043b\u0430\u0442\u044c \u043e\u0448\u0438\u0431\u043e\u043a, \u043e\u043d\u0430
    \u0431\u0443\u0434\u0435\u0442 \u043d\u0435\u043f\u043e\u0431\u0435\u0434\u0438\u043c\u0430\u00bb.\n\n\u269b\ufe0f
    \u041b\u043e\u0441-\u0410\u043b\u0430\u043c\u043e\u0441: \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0439
    \u0438 \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u0439 \u0414\u0430\u0436\u0435 \u0432
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0439
    \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043d\u0430\u0434 \u0430\u0442\u043e\u043c\u043d\u043e\u0439 \u0431\u043e\u043c\u0431\u043e\u0439
    \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b\u0441\u044f
    \u044f\u0440\u043a\u043e. \u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0432\u043e\u0435\u043d\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u044b: \u0412 \u041b\u043e\u0441-\u0410\u043b\u0430\u043c\u043e\u0441\u0435
    \u0432\u0441\u0435\u043c \u0443\u0447\u0451\u043d\u044b\u043c \u0432\u044b\u0434\u0430\u043b\u0438
    \u0432\u043e\u0435\u043d\u043d\u0443\u044e \u0443\u043d\u0438\u0444\u043e\u0440\u043c\u0443.
    \u0424\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u044f\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c \u043a\u043e\u0441\u0442\u044e\u043c\u0435
