    \u043F\u043E\u043B\u043D\u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0439,
    \u043D\u043E \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445,
