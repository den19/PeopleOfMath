    | | \u0434\u043e 813 | \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0435 \u0438 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u043a\u043e \u0434\u0432\u043e\u0440\u0443 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u0445\u0430\u043b\u0438\u0444\u0430 \u0430\u043b\u044c-\u041c\u0430\u043c\u0443\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u043e\u0433\u0434\u0430 \u0431\u044b\u043b
    \u043d\u0430\u043c\u0435\u0441\u0442\u043d\u0438\u043a\u043e\u043c \u0432 \u0425\u043e\u0440\u0430\u0441\u0430\u043d\u0435.
    | \u041a \u044d\u0442\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u043d
