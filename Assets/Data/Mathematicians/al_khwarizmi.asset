    \u043f\u0440\u0438 \u043a\u043e\u043d\u0447\u0438\u043d\u0435 \u0445\u0430\u043b\u0438\u0444\u0430
    \u0430\u043b\u044c-\u0412\u0430\u0441\u0438\u043a\u0430. | \u043e\u043a. 850 | \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u043c\u0430\u044f
    \u0434\u0430\u0442\u0430 \u0441\u043c\u0435\u0440\u0442\u0438.\n\n\u2728 \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0441\u043a\u0443\u0434\u043e\u0441\u0442\u044c \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u0430\u043d\u043d\u044b\u0445, \u0432\u043a\u043b\u0430\u0434 \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438
    \u0432 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u043d\u0430\u0443\u043a\u0443 \u043e\u0433\u0440\u043e\u043c\u0435\u043d:
    \u0410\u043b\u0433\u0435\u0431\u0440\u0430: \u0415\u0433\u043e \u043a\u043d\u0438\u0433\u0430
    \u00ab\u041a\u0440\u0430\u0442\u043a\u0430\u044f \u043a\u043d\u0438\u0433\u0430 \u043e\u0431
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u0438 \u0430\u043b\u043c\u0443\u043a\u0430\u0431\u0430\u043b\u044b\u00bb \u0434\u0430\u043b\u0430
    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u0443\u043a\u0435 \u00ab\u0430\u043b\u0433\u0435\u0431\u0440\u0430\u00bb
    (\u043e\u0442 \u0441\u043b\u043e\u0432\u0430 \u0430\u043b\u044c-\u0434\u0436\u0435\u0431\u0440)
    \u0438 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0438\u0437\u043b\u043e\u0436\u0438\u043b\u0430
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445
    \u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c: \u041b\u0430\u0442\u0438\u043d\u0441\u043a\u0430\u044f
    \u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u044f \u0435\u0433\u043e
    \u0438\u043c\u0435\u043d\u0438 \u2014 Algoritmi \u2014 \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u0442\u0435\u0440\u043c\u0438\u043d\u0430 \u00ab\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u00bb,
    \u043e\u0437\u043d\u0430\u0447\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u0447\u0435\u0442\u043a\u0438\u0445 \u043f\u0440\u0430\u0432\u0438\u043b \u0434\u043b\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439. \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430
    \u0438 \u043d\u0443\u043c\u0435\u0440\u0430\u0446\u0438\u044f: \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u041a\u043d\u0438\u0433\u0430 \u043e\u0431 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u043c
    \u0441\u0447\u0435\u0442\u0435\u00bb \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0430
    \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0439 \u0438, \u043f\u043e\u0437\u0436\u0435,
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0439 \u043c\u0438\u0440 \u0441
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u043e\u0439 \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0435\u0439 \u0446\u0438\u0444\u0440\u044b
    \u043e\u0442 0 \u0434\u043e 9. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f
    \u0438 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f: \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u00ab\u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b\u00bb (\u0417\u0438\u0434\u0436) \u0438 \u00ab\u041a\u043d\u0438\u0433\u0443
    \u043a\u0430\u0440\u0442\u0438\u043d\u044b \u0417\u0435\u043c\u043b\u0438\u00bb, \u0433\u0434\u0435
    \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u043b
    \u0442\u0440\u0443\u0434\u044b \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f, \u043e\u043f\u0438\u0441\u0430\u0432
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0437\u0435\u043c\u043b\u0438 \u0438
    \u0443\u0442\u043e\u0447\u043d\u0438\u0432 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0433\u043e\u0440\u043e\u0434\u043e\u0432."
  shortBioEn: "The exact dates of al-Khwarizmi's life are unknown, and there is much uncertainty in this area. His biography can be reconstructed only in general terms, based on fragmentary historical evidence. Below is a chronology of key events in his life and work.\n\n📜 Main milestones of life and activity | Year (approx.) | Event | |:--- |:--- | | c. 783 | Estimated date of birth. Place of birth - Khorezm (historical region in Central Asia), possibly the city of Khiva. | to 813 | He was educated at home and became a famous scientist, after which he was invited to the court of the future caliph al-Mamun, who at that time was the governor of Khorasan. | 813 | Caliph al-Mamun takes the throne in Baghdad and transports many scholars there, including al-Khwarizmi. | 813–833 | Al-Khwarizmi works in Baghdad in the famous “House of Wisdom” (Bayt al-Hikmah), an academy of sciences created by Caliph al-Mamun. He heads this library or is one of the leading scientists. | 827 | Takes part in a major scientific project to measure the length of the degree of the earth's meridian on the Sinjar Plain. | c. 830 | Creates his most famous work, “A Brief Book on the Calculus of Algebra and Almukabala” (Kitab al-jabr wal-mukabala), laying the foundations of algebra as an independent science. | 842–847 | During the reign of the Caliph, al-Wasika leads an expedition to the Khazars. | 847 | Last reliable mention. Mentioned among those present at the death of Caliph al-Wasiq. | c. 850 | Estimated date of death.\n\n✨ Scientific heritage Despite the paucity of biographical data, al-Khorezmi’s contribution to world science is enormous: Algebra: His book “A Brief Book on the Calculus of Algebra and Almukabala” gave the name to the science “algebra” (from the word al-jabr) and for the first time outlined the systematic solution of linear and quadratic equations. Algorithm: The Latin transcription of his name - Algoritmi - became the basis for the term \"algorithm\", meaning a system of clear rules for calculations. Arithmetic and numbering: His work “The Book of Indian Counting” introduced the Arab and, later, the European world to the decimal positional number system, including the numbers 0 to 9. Astronomy and geography: He created the “Astronomical Tables” (Zij) and the “Book of the Picture of the Earth”, where he revised and supplemented the works of Ptolemy, describing known lands and clarifying the coordinates of many cities."
  interestingFactsRu: "\U0001F5D3\ufe0f \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438
    \u043f\u043e \u0433\u043e\u0434\u0430\u043c | \u0413\u043e\u0434 (\u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e)
    | \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0439 \u0444\u0430\u043a\u0442
    | \u041f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438 | |:--- |:--- |:---
    | | \u043e\u043a. 783 | \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438\u0437 \u0440\u043e\u0434\u0430 \u043c\u0430\u0433\u043e\u0432 | \u0415\u0433\u043e
    \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435 \u00ab\u0430\u043b\u044c-\u041c\u0430\u0434\u0436\u0443\u0441\u0438\u00bb
    \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u043a\u0438, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0431\u044b\u043b\u0438 \u0437\u043e\u0440\u043e\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043a\u0438\u043c\u0438
    \u0436\u0440\u0435\u0446\u0430\u043c\u0438. \u0421\u0430\u043c \u0436\u0435 \u043e\u043d
    \u0431\u044b\u043b \u043f\u0440\u0430\u0432\u043e\u0432\u0435\u0440\u043d\u044b\u043c \u043c\u0443\u0441\u0443\u043b\u044c\u043c\u0430\u043d\u0438\u043d\u043e\u043c.|
    | 810\u2013819 | \u0416\u0438\u0437\u043d\u044c \u0432 \u041c\u0435\u0440\u0432\u0435, \u0430
    \u043d\u0435 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435 | \u0412\u043e\u043f\u0440\u0435\u043a\u0438
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u043c\u0443
    \u043c\u043d\u0435\u043d\u0438\u044e, \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438,
    \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0436\u0438\u043b
    \u0432 \u041c\u0435\u0440\u0432\u0435 (\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439
    \u0422\u0443\u0440\u043a\u043c\u0435\u043d\u0438\u0441\u0442\u0430\u043d) \u043f\u0440\u0438
    \u0434\u0432\u043e\u0440\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u0445\u0430\u043b\u0438\u0444\u0430
    \u0430\u043b\u044c-\u041c\u0430\u043c\u0443\u043d\u0430. \u0411\u0430\u0433\u0434\u0430\u0434
    \u0442\u043e\u0433\u0434\u0430 \u0431\u044b\u043b \u043e\u0445\u0432\u0430\u0447\u0435\u043d
    \u0432\u043e\u0439\u043d\u043e\u0439. \u041e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0441\u0442\u043e\u043b\u0438\u0446\u0443 \u0442\u043e\u043b\u044c\u043a\u043e \u0432
    819 \u0433\u043e\u0434\u0443.| | 827 | \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435
    \u0434\u043b\u0438\u043d\u044b \u0417\u0435\u043c\u043b\u0438 \u0441 \u043d\u0435\u0431\u044b\u0432\u0430\u043b\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e | \u041e\u043d \u043f\u0440\u0438\u043d\u044f\u043b
    \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0439
    \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0438 \u0432 \u043f\u0443\u0441\u0442\u044b\u043d\u0435
    \u0421\u0438\u043d\u0434\u0436\u0430\u0440 \u043f\u043e \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044e
    \u0434\u043b\u0438\u043d\u044b \u0433\u0440\u0430\u0434\u0443\u0441\u0430 \u0437\u0435\u043c\u043d\u043e\u0433\u043e
    \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d\u0430. \u0421\u0434\u0435\u043b\u0430\u043d\u043d\u044b\u0435
    \u0442\u043e\u0433\u0434\u0430 \u0440\u0430\u0441\u0447\u0451\u0442\u044b \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u043d\u0435\u043f\u0440\u0435\u0432\u0437\u043e\u0439\u0434\u0451\u043d\u043d\u044b\u043c\u0438
    \u043f\u043e \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0447\u0442\u0438
    700 \u043b\u0435\u0442.| | \u043e\u043a. 830 | \u041a\u043d\u0438\u0433\u0430, \u043f\u043e\u0434\u0430\u0440\u0438\u0432\u0448\u0430\u044f
    \u043c\u0438\u0440\u0443 \u00ab\u0430\u043b\u0433\u0435\u0431\u0440\u0443\u00bb | \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \u00ab\u041a\u0438\u0442\u0430\u0431 \u0430\u043b\u044c-\u0434\u0436\u0435\u0431\u0440 \u0432\u0430\u043b\u044c-\u043c\u0443\u043a\u0430\u0431\u0430\u043b\u0430\u00bb.
    \u0421\u043b\u043e\u0432\u043e \u00ab\u0430\u043b\u044c-\u0434\u0436\u0435\u0431\u0440\u00bb
    (\u0432\u043e\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435) \u0438\u0437 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u043e\u0441\u044c \u0432 \u0442\u0435\u0440\u043c\u0438\u043d
    \u00ab\u0430\u043b\u0433\u0435\u0431\u0440\u0430\u00bb.| | \u043e\u043a. 830 | \u0422\u0435\u0440\u043c\u0438\u043d
    \u00ab\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u00bb \u0438\u0437 \u0435\u0433\u043e
    \u0438\u043c\u0435\u043d\u0438 | \u0418\u043c\u0435\u043d\u043d\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0443
    \u0435\u0433\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u043d\u0438\u0433\u0438, \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0449\u0435\u043c\u0443\u0441\u044f
    \u0441\u043e \u0441\u043b\u043e\u0432 \u00abDixit Algorizmi\u00bb (\u00ab\u0421\u043a\u0430\u0437\u0430\u043b
    \u0410\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438\u00bb), \u0435\u0433\u043e
    \u0438\u043c\u044f \u0432 \u0444\u043e\u0440\u043c\u0435 Algoritmi \u0434\u0430\u043b\u043e
    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u044e
    \u00ab\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u00bb.| | 841\u2013842 | \u042d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u044f
    \u043a \u0445\u0430\u0437\u0430\u0440\u0430\u043c | \u041f\u0440\u0438 \u0445\u0430\u043b\u0438\u0444\u0435
    \u0430\u043b\u044c-\u0412\u0430\u0441\u0438\u043a\u0435 \u0443\u0447\u0451\u043d\u044b\u0439
    \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u043b \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u044e
    \u0432 \u0425\u0430\u0437\u0430\u0440\u0441\u043a\u0438\u0439 \u043a\u0430\u0433\u0430\u043d\u0430\u0442.
    \u0425\u0430\u043b\u0438\u0444 \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043b \u0435\u0433\u043e
    \u0437\u043d\u0430\u0442\u043e\u043a\u043e\u043c \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b
    \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0430, \u0442\u0430\u043a
    \u043a\u0430\u043a \u0443\u0440\u043e\u0436\u0435\u043d\u0446\u044b \u0425\u043e\u0440\u0435\u0437\u043c\u0430
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0438 \u0441 \u0445\u0430\u0437\u0430\u0440\u0430\u043c\u0438
    \u0442\u0435\u0441\u043d\u044b\u0435 \u0442\u043e\u0440\u0433\u043e\u0432\u044b\u0435 \u0441\u0432\u044f\u0437\u0438.|
    | 847 | \u0417\u0430\u0431\u0430\u0432\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439
    \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435 | \u0412 \u044d\u0442\u043e\u043c \u0433\u043e\u0434\u0443
    \u0443\u043c\u0438\u0440\u0430\u043b \u0445\u0430\u043b\u0438\u0444 \u0430\u043b\u044c-\u0412\u0430\u0441\u0438\u043a.
    \u0410\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438 \u0431\u044b\u043b \u0432
    \u0447\u0438\u0441\u043b\u0435 \u0443\u0447\u0451\u043d\u044b\u0445, \u043a\u043e\u0433\u043e
    \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0445\u0430\u043b\u0438\u0444\u0443 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c
    \u0436\u0438\u0442\u044c. \u041e\u043d\u0438 \u043f\u0440\u0435\u0434\u0440\u0435\u043a\u043b\u0438
    \u0435\u043c\u0443 \u0434\u043e\u043b\u0433\u0443\u044e \u0436\u0438\u0437\u043d\u044c,
    \u043d\u043e \u0445\u0430\u043b\u0438\u0444 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0447\u0435\u0440\u0435\u0437 10 \u0434\u043d\u0435\u0439. \u042d\u0442\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043e \u043d\u0451\u043c \u0432
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445. |"
  interestingFactsEn: "🗓️ Interesting facts from the life of al-Khorezmi by year | Year (approx.) | Interesting fact | Details | |:--- |:--- |:--- | | OK. 783 | Origin from a family of magicians | His nickname \"al-Majusi\" indicates that his ancestors were probably Zoroastrian priests. He himself was a devout Muslim.| | 810–819 | Life in Merv, not in Baghdad | Contrary to popular belief, al-Khwarizmi most likely lived in Merv (modern Turkmenistan) at the court of the future caliph al-Mamun. Baghdad was then engulfed in war. He moved to the capital only in 819.| | 827 | Measuring the length of the Earth with unprecedented accuracy | He took part in a grand expedition in the Sinjar Desert to measure the length of the degree of the earth's meridian. The calculations made then remained unsurpassed in accuracy for almost 700 years.| | OK. 830 | The book that gave the world “algebra” | His main work was called “Kitab al-jabr wal-mukabala”. The word “al-jabr” (replenishment) from the name turned into the term “algebra”.| | OK. 830 | The term \"algorithm\" from his name | It was thanks to the Latin translation of his arithmetic book, beginning with the words \"Dixit Algorizmi\" (\"Said Al-Khwarizmi\"), that his name in the form Algoritmi gave its name to the concept of \"algorithm\".| | 841–842 | Expedition to the Khazars | Under Caliph al-Wasiq, the scientist led an expedition to the Khazar Kaganate. The Caliph considered him an expert on the culture of this people, since the natives of Khorezm maintained close trade ties with the Khazars.| | 847 | A funny incident at court | This year Caliph al-Wasiq died. Al-Khwarizmi was among the scholars who were invited to cast a horoscope to predict how long the caliph had to live. They predicted a long life for him, but the caliph died 10 days later. This is the last mention of him in the sources. |"
