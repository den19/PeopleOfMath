  achievementsRu: "\u0414\u0430, \u0445\u043e\u0442\u044c \u043c\u044b \u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u043c
    \u0442\u043e\u0447\u043d\u044b\u0445 \u0434\u0430\u0442 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0442\u0440\u0443\u0434\u043e\u0432, \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438 \u043c\u043e\u0436\u043d\u043e
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e
    \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u0442\u044c \u043a \u043f\u0435\u0440\u0438\u043e\u0434\u0430\u043c
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435.
    \u0412\u043e\u0442 \u043a\u0430\u043a \u0435\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u043e
    \u0433\u043e\u0434\u0430\u043c.\n\n\U0001F5D3\ufe0f \u0425\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u0434\u043e 813 \u0433. \u2014
    \u0421\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u041f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0425\u043e\u0440\u0435\u0437\u043c\u0435,
    \u0433\u0434\u0435 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u0439 \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f\u043c\u0438.
    \u0415\u0449\u0451 \u0434\u043e \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u0432
    \u0411\u0430\u0433\u0434\u0430\u0434 \u043e\u043d \u0443\u0436\u0435 \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0443\u0447\u0451\u043d\u044b\u043c,
    \u0447\u0442\u043e \u0438 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u043b\u043e \u043a
    \u043d\u0435\u043c\u0443 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u0445\u0430\u043b\u0438\u0444\u0430 \u0430\u043b\u044c-\u041c\u0430\u043c\u0443\u043d\u0430.
    813 \u0433. \u2014 \u041f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u00ab\u0414\u043e\u043c
    \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u0438\u00bb \u0425\u0430\u043b\u0438\u0444 \u0430\u043b\u044c-\u041c\u0430\u043c\u0443\u043d,
    \u0441\u0442\u0430\u0432 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u0435\u043c, \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434
    \u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0435\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c
    (\u00ab\u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430\u0440\u0435\u043c\u00bb)
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u00ab\u0414\u043e\u043c\u0430
    \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u0438\u00bb (\u0411\u0430\u0439\u0442 \u0430\u043b\u044c-\u0445\u0438\u043a\u043c\u0430)
    \u2014 \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0446\u0435\u043d\u0442\u0440\u0430 \u0425\u0430\u043b\u0438\u0444\u0430\u0442\u0430. \u0417\u0434\u0435\u0441\u044c
    \u043e\u043d \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b \u0440\u0430\u0431\u043e\u0442\u0443
    \u043d\u0430\u0434 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u043c \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0435\u0439
    \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0445,
    \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u0445 \u0438 \u043f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432. 827 \u0433.
    \u2014 \u042d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u044f \u043f\u043e \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044e
    \u0417\u0435\u043c\u043b\u0438 \u0410\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438
    \u043f\u0440\u0438\u043d\u044f\u043b \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u043c
    \u043d\u0430\u0443\u0447\u043d\u043e\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u0435 \u2014
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438 \u0434\u043b\u0438\u043d\u044b \u0433\u0440\u0430\u0434\u0443\u0441\u0430
    \u0434\u0443\u0433\u0438 \u0437\u0435\u043c\u043d\u043e\u0433\u043e \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d\u0430
    \u043d\u0430 \u0440\u0430\u0432\u043d\u0438\u043d\u0435 \u0421\u0438\u043d\u0434\u0436\u0430\u0440.
    \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u0438 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f,
    \u0441\u0434\u0435\u043b\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f
    \u0440\u0430\u0437\u043c\u0435\u0440\u0430 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438
    \u0417\u0435\u043c\u043b\u0438, \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u043d\u0435\u043f\u0440\u0435\u0432\u0437\u043e\u0439\u0434\u0451\u043d\u043d\u044b\u043c\u0438
    \u043f\u043e \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u043f\u043e\u0447\u0442\u0438 700 \u043b\u0435\u0442. \u043e\u043a. 830 \u0433. \u2014
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435
    \u0421\u043e\u0437\u0434\u0430\u043b \u0441\u0432\u043e\u0439 \u0441\u0430\u043c\u044b\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0442\u0440\u0443\u0434 \u2014
    \u00ab\u041a\u0440\u0430\u0442\u043a\u0430\u044f \u043a\u043d\u0438\u0433\u0430 \u043e\u0431
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u0438 \u0430\u043b\u043c\u0443\u043a\u0430\u0431\u0430\u043b\u044b\u00bb (\u041a\u0438\u0442\u0430\u0431
    \u0430\u043b\u044c-\u0434\u0436\u0435\u0431\u0440 \u0432\u0430\u043b\u044c-\u043c\u0443\u043a\u0430\u0431\u0430\u043b\u0430).
    \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u043e \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u0432\u0435\u043b\u043e \u0432 \u043d\u0430\u0443\u043a\u0443
    \u0442\u0435\u0440\u043c\u0438\u043d \u00ab\u0430\u043b\u0433\u0435\u0431\u0440\u0430\u00bb
    (\u043e\u0442 \u0430\u043b\u044c-\u0434\u0436\u0435\u0431\u0440). \u0412 \u044d\u0442\u043e\u0439
    \u043a\u043d\u0438\u0433\u0435 \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u043a\u0430\u043a \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443, \u0434\u0430\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e
    \u0448\u0435\u0441\u0442\u0438 \u0432\u0438\u0434\u043e\u0432 \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445
    \u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0438 \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u043c\u0435\u0442\u043e\u0434\u044b \u0438\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f. \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434
    \u043d\u0430 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043a\u0430\u043a \u043d\u0430 \u0412\u043e\u0441\u0442\u043e\u043a\u0435, \u0442\u0430\u043a
    \u0438 \u043d\u0430 \u0417\u0430\u043f\u0430\u0434\u0435. 813\u2013833 \u0433\u0433. (\u0432\u0440\u0435\u043c\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0440\u0438 \u0430\u043b\u044c-\u041c\u0430\u043c\u0443\u043d\u0435)
    \u2014 \u00ab\u041a\u043d\u0438\u0433\u0430 \u043e\u0431 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u043c
    \u0441\u0447\u0451\u0442\u0435\u00bb \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u00ab\u041a\u043d\u0438\u0433\u0443
    \u043e\u0431 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u043c \u0441\u0447\u0451\u0442\u0435\u00bb,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u043e\u043f\u0438\u0441\u0430\u043b \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u0443\u044e
    \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0449\u0443\u044e
    \u0434\u0435\u0432\u044f\u0442\u044c \u0446\u0438\u0444\u0440 \u0438 \u043d\u043e\u043b\u044c
    (\u043e\u0442\u043a\u0443\u0434\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043f\u0440\u0438\u0448\u043b\u0438 \u00ab\u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0435\u00bb
    \u0446\u0438\u0444\u0440\u044b). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u0430
    \u043a\u043d\u0438\u0433\u0430 \u0441\u044b\u0433\u0440\u0430\u043b\u0430 \u0440\u0435\u0448\u0430\u044e\u0449\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u0438
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b.
    \u041b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434
    \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0447\u0438\u043d\u0430\u043b\u0441\u044f
    \u0441\u043e \u0441\u043b\u043e\u0432 Dixit Algorizmi (\u00ab\u0421\u043a\u0430\u0437\u0430\u043b
    \u0410\u043b\u0433\u043e\u0440\u0435\u0437\u043c\u0438\u00bb), \u0438 \u0438\u043c\u0435\u043d\u043d\u043e
    \u043e\u0442 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u043c\u0435\u043d\u0438
    \u0430\u0432\u0442\u043e\u0440\u0430 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e
    \u0441\u043b\u043e\u0432\u043e \u00ab\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u00bb.
    \u0434\u043e 847 \u0433. \u2014 \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f
    \u0438 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0412 \u044d\u0442\u043e\u0442
    \u0436\u0435 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u043f\u043e \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u2014 \u00ab\u0417\u0438\u0434\u0436\u00bb (\u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b). \u0412 \u043d\u0438\u0445 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0438\u0441\u044c
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0441\u0438\u043d\u0443\u0441\u043e\u0432, \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432,
    \u0442\u0430\u043d\u0433\u0435\u043d\u0441\u043e\u0432 \u0438 \u043a\u043e\u0442\u0430\u043d\u0433\u0435\u043d\u0441\u043e\u0432,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0434\u043b\u044f
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442 \u0438 \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0439.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u00ab\u041a\u043d\u0438\u0433\u0443
    \u043a\u0430\u0440\u0442\u0438\u043d\u044b \u0417\u0435\u043c\u043b\u0438\u00bb \u2014 \u043f\u0435\u0440\u0432\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u043d\u0430 \u0430\u0440\u0430\u0431\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435,
    \u0443\u0442\u043e\u0447\u043d\u044f\u044e\u0449\u0443\u044e \u043a\u0430\u0440\u0442\u044b
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f. 842\u2013847 \u0433\u0433. \u2014 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u041f\u0440\u0438 \u0445\u0430\u043b\u0438\u0444\u0435 \u0430\u043b\u044c-\u0412\u0430\u0441\u0438\u043a\u0435
    \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u043b
    \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u044e \u043a \u0445\u0430\u0437\u0430\u0440\u0430\u043c.
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435
    \u043e \u043d\u0451\u043c \u0434\u0430\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f 847
    \u0433\u043e\u0434\u043e\u043c, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043f\u0440\u0438 \u043a\u043e\u043d\u0447\u0438\u043d\u0435 \u0445\u0430\u043b\u0438\u0444\u0430
    \u0430\u043b\u044c-\u0412\u0430\u0441\u0438\u043a\u0430.\n\n\U0001F48E \u0418\u0442\u043e\u0433:
    \u0414\u0432\u0430 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0434\u0430\u0440\u0430 \u043d\u0430\u0443\u043a\u0435
    \u0415\u0441\u043b\u0438 \u043f\u043e\u0434\u0432\u043e\u0434\u0438\u0442\u044c \u0438\u0442\u043e\u0433
    \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0443, \u0442\u043e \u0434\u0432\u0430
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0438\u043c\u0435\u044e\u0442
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435: 1. \u0410\u043b\u0433\u0435\u0431\u0440\u0430
    \u043a\u0430\u043a \u043d\u0430\u0443\u043a\u0430: \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0438\u043b \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u0430
    \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u0443\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443
    \u0441 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438.
    2. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043a\u0430\u043a \u043f\u043e\u043d\u044f\u0442\u0438\u0435:
    \u041e\u043d \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f, \u0438 \u0435\u0433\u043e \u0438\u043c\u044f,
    \u0441\u0442\u0430\u0432\u0448\u0435\u0435 \u043d\u0430\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c,
    \u0434\u0430\u043b\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043e\u0434\u043d\u043e\u043c\u0443
    \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u043f\u043e\u043d\u044f\u0442\u0438\u0439
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0435."
  achievementsEn: "Yes, although we do not know the exact dates of the creation of many of his works, the main scientific achievements of al-Khwarizmi can be fairly confidently tied to the periods of his life in Baghdad. Here's how his key discoveries and works break down by year.\n\n🗓️ Chronology of key scientific achievements up to 813 - Formation He received his education in Khorezm, where he became acquainted with Indian and Greek scientific traditions. Even before moving to Baghdad, he was already a famous scientist, which attracted the attention of the future Caliph al-Mamun to him. 813 - Moving to the “House of Wisdom” Caliph al-Mamun, having become a ruler, invited al-Khwarizmi to Baghdad and appointed him head (“librarian”) of the famous “House of Wisdom” (Bayt al-Hikmah) - the main scientific center of the Caliphate. Here he led the work on the translation and systematization of ancient Greek, Indian and Persian scientific works. 827 - Expedition to measure the Earth Al-Khwarizmi took part in a grandiose scientific project - measuring the length of the degree of arc of the earth's meridian on the Sinjar Plain. Significance: These measurements, made to determine the size of the Earth's circumference, remained unsurpassed in accuracy for almost 700 years. c. 830 - The main work on algebra Created his most famous work - “A short book on the calculus of algebra and almukabala” (Kitab al-jabr wal-mukabala). Meaning: This work forever introduced the term “algebra” (from al-jabr) into science. In this book, al-Khwarizmi first introduced algebra as an independent science, gave a classification of six types of linear and quadratic equations and outlined methods for solving them. This work became the basis for the development of mathematics in both the East and the West for centuries. 813–833 (while working under al-Mamun) - “The Book of Indian Counting” During this period, he wrote the “Book of Indian Counting”, in which he described in detail the decimal positional number system using nine digits and zero (from where “Arabic” numerals came into mathematics). Significance: This book played a decisive role in popularizing the decimal system. The Latin translation of this work began with the words Dixit Algorizmi (“Algorizmi said”), and it is from a corruption of the author’s name that the word “algorithm” is derived. before 847 - Astronomy and geography During the same period, he created fundamental works on astronomy - “Zij” (astronomical tables). They contained detailed trigonometric tables of sines, cosines, tangents and cotangents, as well as rules for calculating the motion of planets and eclipses. He also wrote The Book of the Picture of the Earth, the first mathematical geography in Arabic, clarifying the maps of Ptolemy. 842–847 — In recent years, under Caliph al-Wasiq, al-Khorezmi led an expedition to the Khazars. The last mention of him dates back to 847, when he was present at the death of Caliph al-Wasiq.\n\n💎 Bottom line: Two major gifts to science To sum up his contributions, two of his achievements are truly fundamental: 1. Algebra as a science: He not only solved equations, but created a new discipline with its own methods. 2. Algorithm as a concept: He popularized the Indian number system, and his name, which became a household name, gave the name to one of the most important concepts in mathematics and computer science."
  personalLifeRu: "\u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0435\u0441\u043b\u0438
    \u0440\u0435\u0447\u044c \u0438\u0434\u0435\u0442 \u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438
    \u0432 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u043e\u043c \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0438
    \u2014 \u043e \u0441\u0435\u043c\u044c\u0435, \u0434\u0435\u0442\u044f\u0445, \u0431\u044b\u0442\u0435,
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f\u0445 \u0438\u043b\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445
    \u2014 \u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0438\u043a\u0430\u043a\u0438\u0445
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439. \u0412\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430\u044f
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438
    \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c
    \u0444\u0430\u043a\u0442\u0430\u043c \u0438\u0437 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435,
    \u0438\u0437 \u044d\u0442\u0438\u0445 \u0441\u043a\u0443\u043f\u044b\u0445 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439
    \u043c\u043e\u0436\u043d\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c
    \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044e \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0441\u043e\u0431\u044b\u0442\u0438\u0439 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0442\u0435, \u0447\u0442\u043e
    \u043f\u0440\u043e\u043b\u0438\u0432\u0430\u044e\u0442 \u0441\u0432\u0435\u0442 \u043d\u0430
    \u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0432\u0435\u0440\u043e\u0438\u0441\u043f\u043e\u0432\u0435\u0434\u0430\u043d\u0438\u0435.\n\n\U0001F5D3\ufe0f
    \u0425\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0438 (\u043b\u0438\u0447\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b)
    | \u0413\u043e\u0434 (\u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e)
    | \u0421\u043e\u0431\u044b\u0442\u0438\u0435 | \u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439
    | |:--- |:--- |:--- | | \u043e\u043a. 783 | \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0432 \u0425\u043e\u0440\u0435\u0437\u043c\u0435 (\u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0432 \u0421\u0440\u0435\u0434\u043d\u0435\u0439
    \u0410\u0437\u0438\u0438), \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0425\u0438\u0432\u0430. | \u0418\u043c\u0435\u043b
    \u043f\u043e\u043b\u043d\u043e\u0435 \u0438\u043c\u044f \u0410\u0431\u0443 \u0410\u0431\u0434\u0443\u043b\u043b\u0430\u0445
