    \u043f\u0440\u043e\u0438\u0437\u043d\u0451\u0441 \u0444\u0440\u0430\u0437\u0443, \u0441\u0442\u0430\u0432\u0448\u0443\u044e
    \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439: \u00ab\u042d\u0442\u043e \u0432\u044b\u0448\u0435
    \u043c\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0442 \u0438 \u0432\u044b\u0448\u0435
