  achievementsRu: "\u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432 \u042f\u043a\u043e\u0431 \u042f\u043a\u043e\u0431\u0438
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0441\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0442\u043e\u0447\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u043e\u0442 \u0447\u0438\u0441\u0442\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0434\u043e \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0442\u0440\u0443\u0434\u043e\u0432.\n\n\U0001F4D0 \u0421\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c
    \u0442\u0435\u043e\u0440\u0438\u0438 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u042d\u0442\u043e, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u0441\u0430\u043c\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u042f\u043a\u043e\u0431\u0438,
    \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0435\u0433\u043e \u0441\u0442\u0430\u0432\u044f\u0442
    \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434 \u0441 \u041d\u0438\u043b\u044c\u0441\u043e\u043c
    \u0425\u0435\u043d\u0440\u0438\u043a\u043e\u043c \u0410\u0431\u0435\u043b\u0435\u043c. \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434: \u0412 1829 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044e \"Fundamenta Nova Theoriae
    Functionum Ellipticarum\" (\"\u041d\u043e\u0432\u044b\u0435 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439\"). \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u0435\u043e\u0440\u0438\u0438. \u0422\u044d\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0438:
    \u0412 \u044d\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u042f\u043a\u043e\u0431\u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0442\u044d\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u043e\u0441\u044f\u0442 \u0435\u0433\u043e \u0438\u043c\u044f.
    \u042d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u042f\u043a\u043e\u0431\u0438: \u041e\u043d \u0432\u0432\u0435\u043b \u0432 \u043e\u0431\u0438\u0445\u043e\u0434
    \u0442\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0435\u043c\u044b\u0435
    \u043a\u0430\u043a `sn z`, `cn z` \u0438 `dn z`, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0430\u043d\u0430\u043b\u043e\u0433\u0430\u043c\u0438
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043d\u043e \u0434\u043b\u044f \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432.\n\n\U0001F4CA \u0412\u043a\u043b\u0430\u0434
    \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0438 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b \u042f\u043a\u043e\u0431\u0438 \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0441\u0442\u043e\u0432
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u042f\u043a\u043e\u0431\u0438\u0430\u043d:
    \u0412 \u0440\u0430\u0431\u043e\u0442\u0435 \"\u041e \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0434\u0435\u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043d\u0442\u0430\u0445\" (1841)
    \u043e\u043d \u0432\u0432\u0435\u043b \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u043a\u0430\u043a \u044f\u043a\u043e\u0431\u0438\u0430\u043d\u044b. \u042d\u0442\u043e
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0441\u0442\u0430\u043b\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0434\u043b\u044f \u0437\u0430\u043c\u0435\u043d\u044b \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0432 \u043a\u0440\u0430\u0442\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u0445
    \u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435\u0439:
    \u0412 1840 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430 \u0435\u0433\u043e \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \"De Formatione et Proprietatibus Determinantium\"
    (\"\u041e\u0431 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u0445 \u0434\u0435\u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043d\u0442\u043e\u0432\").
    \u041e\u043d \u043f\u0440\u0438\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0434, \u0432\u0432\u0435\u043b
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0438\u0445 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u0438 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f. \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b: \u042f\u043a\u043e\u0431\u0438
    \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043a \u0437\u0430\u0434\u0430\u0447\u0430\u043c
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u0421 \u0438\u0445
    \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u043e\u0434\u043d\u0443 \u0438\u0437 \u0442\u0435\u043e\u0440\u0435\u043c \u0424\u0435\u0440\u043c\u0430
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \u043d\u0435 \u0431\u043e\u043b\u0435\u0435
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432,
    \u0438 \u0434\u0430\u0436\u0435 \u043d\u0430\u0448\u0435\u043b \u0447\u0438\u0441\u043b\u043e
    \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u0432 \u0442\u0430\u043a\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f.
    \u0421\u0438\u043c\u0432\u043e\u043b \u042f\u043a\u043e\u0431\u0438: \u0412\u0432\u0435\u043b
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0441\u0438\u043c\u0432\u043e\u043b\u0430
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435
    \u043a\u0430\u043a \u0441\u0438\u043c\u0432\u043e\u043b \u042f\u043a\u043e\u0431\u0438,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    \"Canon arithmeticus\": \u0412 1839 \u0433\u043e\u0434\u0443 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0438\u043d\u0434\u0435\u043a\u0441\u043e\u0432
    \u0438 \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0445 \u0432\u044b\u0447\u0435\u0442\u043e\u0432
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0434\u043e 1000, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0432\u0430\u0436\u043d\u044b\u043c
    \u043f\u043e\u0434\u0441\u043f\u043e\u0440\u044c\u0435\u043c \u0434\u043b\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\u2699\ufe0f \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 \u042f\u043a\u043e\u0431\u0438 \u0432\u043d\u0435\u0441
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443, \u0441\u043e\u0437\u0434\u0430\u0432 \u043c\u043e\u0449\u043d\u044b\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447
    \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438. \u041c\u0435\u0442\u043e\u0434 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430-\u042f\u043a\u043e\u0431\u0438:
    \u041e\u043d \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0420\u043e\u0443\u044d\u043d\u0430
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430 \u0434\u043b\u044f \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438.
    \u0422\u0435\u043f\u0435\u0440\u044c \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a \u043c\u0435\u0442\u043e\u0434
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430-\u042f\u043a\u043e\u0431\u0438.
    \u0415\u0433\u043e \u0438\u0434\u0435\u0438 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u044b
    \u0432 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e \u0438\u0437\u0434\u0430\u043d\u043d\u044b\u0445
    \"Vorlesungen \u00fcber Dynamik\" (\"\u041b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435\",
    1866). \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u042f\u043a\u043e\u0431\u0438:
    \u0412 1836 \u0433\u043e\u0434\u0443 \u0434\u043b\u044f \u0437\u0430\u0434\u0430\u0447 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u043e\u043d \u0432\u0432\u0435\u043b \u0442\u0430\u043a
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b
    \u042f\u043a\u043e\u0431\u0438, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u0439
    \u0443\u043f\u0440\u043e\u0441\u0442\u0438\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f.
    \u042d\u043b\u043b\u0438\u043f\u0441\u043e\u0438\u0434\u044b \u042f\u043a\u043e\u0431\u0438:
    \u0417\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c \u0444\u0438\u0433\u0443\u0440\u0430\u043c\u0438
    \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u044f \u0432\u0440\u0430\u0449\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438, \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043f\u043e\u043c\u0438\u043c\u043e \u044d\u043b\u043b\u0438\u043f\u0441\u043e\u0438\u0434\u043e\u0432
    \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u041c\u0430\u043a\u043b\u043e\u0440\u0435\u043d\u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u0438 \u0442\u0440\u0435\u0445\u043e\u0441\u043d\u044b\u0435
    \u044d\u043b\u043b\u0438\u043f\u0441\u043e\u0438\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f
    \u044d\u043b\u043b\u0438\u043f\u0441\u043e\u0438\u0434\u0430\u043c\u0438 \u042f\u043a\u043e\u0431\u0438.
    \u041f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438:
    \u0412 \u0440\u0430\u043c\u043a\u0430\u0445 \u0441\u0432\u043e\u0435\u0439 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043e \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043b\u0438\u043d\u0438\u044f\u043c \u043d\u0430 \u044d\u043b\u043b\u0438\u043f\u0441\u043e\u0438\u0434\u0435,
    \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0442\u0432\u0435\u0440\u0434\u043e\u0433\u043e
    \u0442\u0435\u043b\u0430 \u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0433\u0438\u0440\u043e\u0441\u043a\u043e\u043f\u0430.\n\n\u270d\ufe0f
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u042f\u043a\u043e\u0431\u0438 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e.
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0430\u044f \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f
    \u043d\u0430\u0443\u043a \u0438\u0437\u0434\u0430\u043b\u0430 \u0435\u0433\u043e \u043f\u043e\u043b\u043d\u043e\u0435
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439
    \"C. G. J. Jacobi's gesammelte Werke\" \u0432 \u0432\u043e\u0441\u044c\u043c\u0438 \u0442\u043e\u043c\u0430\u0445
    \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441 1881 \u043f\u043e 1891 \u0433\u043e\u0434."
  achievementsEn: "Carl Gustav Jacob Jacob Jacoby left a deep mark in mathematics and mechanics, and his contribution covers almost all areas of the exact sciences of his time, from pure analysis to heavenly mechanics, and his main scientific achievements and works are described in detail below.\n\n==History==The theory of elliptical functions is certainly the most famous achievement of Jacoby, for which he is placed in the same line as Niels Henrik Abel.Theta functions: In this book and subsequent works, Jacoby has developed a deep-seated theory of theta functions that now bear his name. The Elliptic functions of Jacobi: He has introduced three main elliptical functions, referred to as `sn z', `cn z' and `dn z', which are equivalents to trigonometric functions but for elliptical integrals.\n\n===Algebra===The input to the algebra and the Yakobi numbers theory was one of the leading algebraists of his time.Definition theory: In 1840, his monumental work \"De Formatione et Proprietatibus Determinantium\" was published. He introduced the theory of the determinants of modern appearances, introduced many of their properties and symbols. The application of elliptical functions in the number theory was the first to apply elliptical functions to the tasks of number theory.It has proved one of the Farm's theories that any natural number can be represented as a sum of not more than four squares, and even found the number of ways to represent it. The symbol Jacobi: has introduced a synthesis of the Legjandra symbol, known as the Jacobi symbol, which is used in comparison theory.\"Canon aristmeticus\": In 1839, he published the basic index and degree table for all primes up to 1,000, which was an important tool for researchers at that time.\n\n===Mechanics and mathematical physics===Jacoby made a huge contribution to the theoretical mechanics by creating powerful methods to solve dynamic problems. Hamilton-Yacobi: He improved William Rowan Hamilton's method to integrate the dynamics equations. Now it's known as Hamilton-Yacobi. His ideas are set out in the postmortem edition of \"Vorlesungen über Dynamik\" (\"Visionalions\", 1866).In 1836 he introduced the so-called \"Jacob's integral\" for the purposes of heavenly mechanics, which makes it easier to solve the equations of motion.Application tasks: In its dynamic theory, it has solved many complex tasks, including the movement of geodetic lines on ellipsoid, the rotation of the solid body and the movement of the gyroscope.\n\nThe basic works of Jacobi's scientific heritage are enormous, and the Berlin Academy of Sciences published its full collection of essays \"C. G. J. Jacobi's gesamelte Werke\" in eight volumes between 1881 and 1891."
  personalLifeRu: "\U0001F476 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u043c\u044c\u044f
    \u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432 \u042f\u043a\u043e\u0431 \u042f\u043a\u043e\u0431\u0438
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 10 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1804 \u0433\u043e\u0434\u0430 \u0432 \u041f\u043e\u0442\u0441\u0434\u0430\u043c\u0435, \u041f\u0440\u0443\u0441\u0441\u0438\u044f.
    \u041e\u043d \u0431\u044b\u043b \u0432\u0442\u043e\u0440\u044b\u043c \u0441\u044b\u043d\u043e\u043c
    \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435 \u0431\u0430\u043d\u043a\u0438\u0440\u0430 \u0421\u0438\u043c\u043e\u043d\u0430
    \u042f\u043a\u043e\u0431\u0438 \u0438 \u0435\u0433\u043e \u0436\u0435\u043d\u044b \u0420\u0430\u0445\u0435\u043b\u0438,
    \u0443\u0440\u043e\u0436\u0434\u0451\u043d\u043d\u043e\u0439 \u041b\u0435\u043c\u0430\u043d.
    \u0415\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0431\u0440\u0430\u0442,
    \u041c\u043e\u0440\u0438\u0446 \u0413\u0435\u0440\u043c\u0430\u043d, \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u0444\u0438\u0437\u0438\u043a\u043e\u043c
    \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u043a\u0430\u043a \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a
    \u0411\u043e\u0440\u0438\u0441 \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447 \u042f\u043a\u043e\u0431\u0438.
    \u041c\u043b\u0430\u0434\u0448\u0438\u0439 \u0431\u0440\u0430\u0442, \u042d\u0434\u0443\u0430\u0440\u0434,
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u043e\u0442\u0446\u043e\u0432\u0441\u043a\u043e\u0435
    \u0431\u0430\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0435 \u0434\u0435\u043b\u043e.\n\n\U0001F3EB
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435
    \u0412 \u0434\u043e\u043c\u0435 \u042f\u043a\u043e\u0431\u0438 \u0446\u0430\u0440\u0438\u043b\u0430
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0432\u044b\u0441\u043e\u043a\u043e\u0439
    \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b, \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438
    \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u044f\u0437\u044b\u043a\u0430\u0445.
    \u0421\u0432\u043e\u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u0437\u043d\u0430\u043d\u0438\u044f \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u044f\u0437\u044b\u043a\u043e\u0432
    (\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e, \u043b\u0430\u0442\u044b\u043d\u0438,
    \u0438\u0432\u0440\u0438\u0442\u0430) \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u042f\u043a\u043e\u0431\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0434\u044f\u0434\u0435 \u043f\u043e \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u043e\u0439
    \u043b\u0438\u043d\u0438\u0438, \u0424. \u0410. \u041b\u0435\u043c\u0430\u043d\u0443, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u043d \u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u00ab\u043d\u0435\u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u043c
    \u0438 \u0433\u043e\u0440\u044f\u0447\u043e \u043b\u044e\u0431\u0438\u043c\u044b\u043c\u00bb
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c. \u0412 1816 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 11 \u043b\u0435\u0442, \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439
    \u043a\u043b\u0430\u0441\u0441 \u041f\u043e\u0442\u0441\u0434\u0430\u043c\u0441\u043a\u043e\u0439
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438. \u0415\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u0435\u043d,
    \u0447\u0442\u043e \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0433\u043e\u0434\u0430
    \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0451\u043b \u0432 \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u043a\u043b\u0430\u0441\u0441. \u0423\u0447\u0438\u0442\u0435\u043b\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0413\u0435\u043d\u0440\u0438\u0445 \u0411\u0430\u0443\u044d\u0440, \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043b
    \u0435\u043c\u0443 \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u043c\u0435\u0442
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u0430
    \u043d\u0435 \u043f\u043e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u0438\u0437-\u0437\u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0448\u0435\u0433\u043e
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u043c\u043b\u0430\u0434\u0448\u0435 16 \u043b\u0435\u0442, \u042f\u043a\u043e\u0431\u0438
    \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438
    \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0433\u043e\u0434\u0430. \u0412 1821 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u0441\u0434\u0430\u0447\u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0445 \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0445
    \u0438 \u0443\u0441\u0442\u043d\u044b\u0445 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u043e\u0432,
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0430\u0442\u0442\u0435\u0441\u0442\u0430\u0442
    \u0441 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430\u043c\u0438.
    \u0412 \u043d\u0451\u043c, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u043e\u0441\u044c \u043e \u0435\u0433\u043e \u00ab\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0432\u0435\u043b\u0438\u043a\u043e\u043b\u0435\u043f\u043d\u044b\u0445\u00bb \u0437\u043d\u0430\u043d\u0438\u044f\u0445
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u00ab\u043d\u0435\u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0445\u00bb
    \u043f\u043e \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u044f\u0437\u044b\u043a\u0443
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u0430 \u0440\u0435\u043a\u0442\u043e\u0440
    \u0448\u043a\u043e\u043b\u044b \u043d\u0430\u0437\u0432\u0430\u043b \u0435\u0433\u043e \u00ab\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u043c\u043e\u043c\u00bb.\n\n\U0001F393 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0438 \u0441\u043c\u0435\u043d\u0430 \u0432\u0435\u0440\u043e\u0438\u0441\u043f\u043e\u0432\u0435\u0434\u0430\u043d\u0438\u044f
    \u0412 \u0430\u043f\u0440\u0435\u043b\u0435 1821 \u0433\u043e\u0434\u0430 \u042f\u043a\u043e\u0431\u0438
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u041f\u0435\u0440\u0432\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u0441 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u043c
    \u043f\u043e\u0441\u0435\u0449\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0413\u0435\u0433\u0435\u043b\u044f
    \u0438 \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0438 \u0411\u0451\u043a\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0431\u044b\u043b\u043e \u043d\u0430 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u043c
    \u0443\u0440\u043e\u0432\u043d\u0435 \u0438 \u0441\u0442\u0440\u043e\u0438\u043b\u043e\u0441\u044c
    \u043d\u0430 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0438, \u0447\u0442\u043e
    \u043d\u0435 \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u043b\u043e
    \u0435\u0433\u043e. \u041f\u043e \u0441\u043e\u0432\u0435\u0442\u0443 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u0437 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0442\u0440\u0443\u0434\u044b \u043a\u043b\u0430\u0441\u0441\u0438\u043a\u043e\u0432
    \u2014 \u042d\u0439\u043b\u0435\u0440\u0430, \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0438 \u041b\u0430\u043f\u043b\u0430\u0441\u0430. \u042d\u0439\u043b\u0435\u0440 \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u043a\u0443\u043c\u0438\u0440\u043e\u043c \u043d\u0430 \u0432\u0441\u044e
    \u0436\u0438\u0437\u043d\u044c. \u0412 1821 \u0433\u043e\u0434\u0443 \u042f\u043a\u043e\u0431\u0438
    \u043f\u0440\u0438\u043d\u044f\u043b \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0438 \u0441\u043c\u0435\u043d\u0438\u043b \u0438\u043c\u044f \u0441 \u042f\u043a\u043e\u0431
    \u0428\u0438\u043c\u043e\u043d \u043d\u0430 \u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432
    \u042f\u043a\u043e\u0431. \u042d\u0442\u043e \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u044b\u0439
    \u0448\u0430\u0433, \u0442\u0430\u043a \u043a\u0430\u043a \u0432 \u041f\u0440\u0443\u0441\u0441\u0438\u0438
    \u0435\u0432\u0440\u0435\u044f\u043c \u0431\u044b\u043b\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043e
    \u043f\u0440\u0430\u0432\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438. \u0412 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u043e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0441\u0435\u0431\u044f \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043d\u043e \u0438 \u043a\u0430\u043a
    \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0439 \u043f\u0435\u0434\u0430\u0433\u043e\u0433.
    \u041f\u043e\u0437\u0436\u0435, \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044f \u0441\u0432\u043e\u0439
    \u0432\u044b\u0431\u043e\u0440 \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043e\u043d \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u041a\u0442\u043e \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u0432\u043a\u0443\u0441\u0438\u043b \u0441\u043b\u0430\u0434\u043e\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0434\u0435\u0439, \u0442\u043e\u0442 \u0443\u0436\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0440\u0430\u0441\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u0441 \u043d\u0438\u043c\u0438\u00bb.\n\n\U0001F4DC
    \u041d\u0430\u0447\u0430\u043b\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0412 1825 \u0433\u043e\u0434\u0443 \u042f\u043a\u043e\u0431\u0438
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434,
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0440\u0430\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0447\u0430\u0441\u0442\u043d\u044b\u0445 \u0434\u0440\u043e\u0431\u0435\u0439 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0434\u0430\u043b
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d \u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f \u0432\u044b\u0441\u0448\u0435\u0439
    \u0448\u043a\u043e\u043b\u044b. \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435
    \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0447\u0438\u0442\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u0430. \u0415\u0433\u043e
    \u043b\u0435\u043a\u0446\u0438\u044f \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043f\u043e\u0437\u0436\u0435 \u0431\u044b\u043b\u0430
    \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439
    \u0415. \u0415. \u041a\u0443\u043c\u043c\u0435\u0440\u043e\u043c \u043f\u0435\u0440\u0432\u043e\u0439
    \u0432 \u0441\u0432\u043e\u0451\u043c \u0440\u043e\u0434\u0435 \u0432 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.\n\n\U0001F468\u200d\U0001F3EB
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0430 \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435
    \u0412 1826 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u0432\u0441\u0435\u0433\u043e 21 \u0433\u043e\u0434\u0430, \u042f\u043a\u043e\u0431\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u043e
    \u0431\u044b\u0441\u0442\u0440\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b: \u0432
    1827 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c,
    \u0430 \u0432 1829 \u0433\u043e\u0434\u0443 \u2014 \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u0412 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435
    \u0435\u0433\u043e \u0445\u043e\u0440\u043e\u0448\u043e \u043f\u0440\u0438\u043d\u044f\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c
    \u0424. \u0412. \u0411\u0435\u0441\u0441\u0435\u043b\u044c, \u043e\u0434\u043d\u0430\u043a\u043e
    \u043e\u043d \u0431\u044b\u0441\u0442\u0440\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u043b
    \u043f\u0440\u043e\u0442\u0438\u0432 \u0441\u0435\u0431\u044f \u043c\u043d\u043e\u0433\u0438\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433 \u0441\u0432\u043e\u0435\u0439 \u0440\u0435\u0437\u043a\u043e\u0441\u0442\u044c\u044e
    \u0438 \u0441\u0430\u0440\u043a\u0430\u0437\u043c\u043e\u043c. \u0411\u0435\u0441\u0441\u0435\u043b\u044c
    \u043f\u0438\u0441\u0430\u043b \u0413\u0430\u0443\u0441\u0441\u0443, \u0447\u0442\u043e
    \u042f\u043a\u043e\u0431\u0438 \u0443\u043c\u0443\u0434\u0440\u0438\u043b\u0441\u044f \u043a\u0430\u0436\u0434\u043e\u043c\u0443
    \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0447\u0442\u043e-\u043d\u0438\u0431\u0443\u0434\u044c
    \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0435, \u043d\u043e \u043f\u0440\u0438
    \u044d\u0442\u043e\u043c \u0441\u0447\u0438\u0442\u0430\u043b \u0435\u0433\u043e \u00ab\u0445\u043e\u0440\u043e\u0448\u0438\u043c
    \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c\u00bb.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c, \u0432 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u043c
    \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0441 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u043c
    \u0433\u0435\u043d\u0438\u0435\u043c \u041d\u0438\u043b\u044c\u0441\u043e\u043c \u0425\u0435\u043d\u0440\u0438\u043a\u043e\u043c
    \u0410\u0431\u0435\u043b\u0435\u043c, \u042f\u043a\u043e\u0431\u0438 \u0441\u043e\u0437\u0434\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u2014 \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439.\n\n\U0001F3E1 \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u0431\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0412 1831 \u0433\u043e\u0434\u0443 \u042f\u043a\u043e\u0431\u0438
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041c\u0430\u0440\u0438 \u0428\u0432\u0438\u043d\u043a.
    \u0412 \u0431\u0440\u0430\u043a\u0435 \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u043f\u044f\u0442\u044c
    \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0438 \u0442\u0440\u0438 \u0434\u043e\u0447\u0435\u0440\u0438.
    \u0412 1832 \u0433\u043e\u0434\u0443 \u0443\u043c\u0435\u0440 \u0435\u0433\u043e \u043e\u0442\u0435\u0446,
    \u0447\u0442\u043e \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e \u0443\u0445\u0443\u0434\u0448\u0438\u043b\u043e
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0441\u0435\u043c\u044c\u0438, \u0438 \u042f\u043a\u043e\u0431\u0438 \u0432\u0437\u044f\u043b
    \u043d\u0430 \u0441\u0435\u0431\u044f \u0437\u0430\u0431\u043e\u0442\u0443 \u043e \u043c\u0430\u0442\u0435\u0440\u0438.
    \u0412 1842\u20131843 \u0433\u043e\u0434\u0430\u0445, \u0438\u0437-\u0437\u0430 \u0441\u0438\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u0435\u0440\u0435\u0443\u0442\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u0438 \u0434\u0438\u0430\u0431\u0435\u0442\u0430,
    \u043e\u043d \u043f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u043c\u044b\u0439
    \u043e\u0442\u043f\u0443\u0441\u043a \u0438 \u0443\u0435\u0445\u0430\u043b \u043b\u0435\u0447\u0438\u0442\u044c\u0441\u044f
    \u0432 \u0418\u0442\u0430\u043b\u0438\u044e. \u041f\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u043e\u043d \u043d\u0435 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433,
    \u0430 \u043f\u043e\u0441\u0435\u043b\u0438\u043b\u0441\u044f \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435,
    \u0433\u0434\u0435 \u0436\u0438\u043b \u043d\u0430 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u043f\u0435\u043d\u0441\u0438\u044e \u0438 \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a. \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    1848 \u0433\u043e\u0434\u0430 \u042f\u043a\u043e\u0431\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043b
    \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u043e\u0432, \u0437\u0430 \u0447\u0442\u043e
    \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043d\u043d\u044b\u0439 \u043a\u043e\u0440\u043e\u043b\u044c
    \u043b\u0438\u0448\u0438\u043b \u0435\u0433\u043e \u043f\u0435\u043d\u0441\u0438\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0443 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0432\u044b\u043f\u043b\u0430\u0442\u0430
    \u0431\u044b\u043b\u0430 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430.
    \u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432 \u042f\u043a\u043e\u0431 \u042f\u043a\u043e\u0431\u0438
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435
    18 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1851 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    46 \u043b\u0435\u0442 \u043e\u0442 \u043e\u0441\u043f\u044b."
  personalLifeEn: "==Early life==The birth and family of Carl Gustav Jacob Jacob Jacoby was born on 10 December 1804 in Potsdam, Prussia, and was the second son of the wealthy Jewish banker Simon Jacoby and his wife Rachel, born Lehman, and his older brother Moritz Herman, later became a famous physicist and engineer known in Russia as the academic Boris Semyonovich Jacoby.\n\n* Childhood and education in the Jakobi home was a cultured environment, spoken in several languages. His first deep knowledge of languages (in Greek, Latin, Hebrew) and mathematics was obtained by Yakobi from his maternal uncle, F. A. Lemana, later known as \"unusual and beloved\" by a teacher. In 1816, at the age of 11, he entered the second grade of Potsdam High School.His talent was so obvious that six months later he moved to senior high school, and he was allowed to study the subject himself and not in the standard curriculum, but because of the university rule that prevented him from accepting students under 16 years of age, Jacoby had to spend four years in a gymnasium.In 1821, after a brilliant written and oral examination, he received an exclusive diploma, which included \"perfectly excellent\" mathematics and \"unusual\" Greek language and history, and was described by a school rector as a \"universal mind\".\n\n==Career==The University and the change of faith in April 1821, Jacoby entered Berlin University. He attended lectures on the philosophy of Gegel and the philosophy of Böck with interest. However, the teaching of mathematics at the University was quite elementary and was based on a memory that did not satisfy him.In 1821, Jacoby accepted Lutheranism and changed his name from Jacob Shimon to Carl Gustav Jacob. This was a forced move, because in Prussia, Jews were restricted to academic positions, and he showed himself not only as a brilliant mathematician but also as a talented teacher.Later, explaining his choice for mathematics, he said, \"Who once tasted the sweetness of mathematical ideas will never part with them.\"\n\n==History==In 1825, Jacoby was brilliant in defending his Ph.D., in which he proved the formula for the degradation of Lagrangian private fractions, in the same year he passed the State examination for the post of teacher of higher education. He began to lecture at the University of Berlin as a private professor.Kummer is the first of his kind at the University of Germany.\n\n==Career=====Career=======Career====In 1826, at the age of 21, Yakobi received an invitation to the University of Koenigsberg, which was the beginning of an extraordinary career: in 1827 he became an extraordinary professor and in 1829 he was well received by a well-known astronomer, F. V. Bessel, but he quickly turned his violent and sarcasm against many colleagues.Bessel wrote to Gaussa that Jacoby had managed to say something unpleasant to everyone, but he thought he was a \"good young man.\" It was here, in an intellectual competition with Norwegian genius Niels Henrik Abel, that Jacoby created his main work, the theory of elliptical functions.\n\nIn 1831, Jacoby married Marie Schwink. Five sons and three daughters were born in marriage. In 1832, his father died, seriously deteriorating his family's financial situation, and Jacoby took care of his mother. From 1842 to 1843, due to severe overwork and diabetes, he received paid leave of absence from his colleague Dirichle and went to Italy to be treated.He did not return to Koenigsberg, but settled in Berlin, where he lived on a royal pension and was a member of the Berlin Academy of Sciences. During the 1848 revolution, Jacoby supported the liberals, for which the angry king deprived him of his pension. However, thanks to the intervention of the scientific community, the payment was restored."
  shortBioRu: "\u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432 \u042f\u043a\u043e\u0431 \u042f\u043a\u043e\u0431\u0438
    (1804\u20131851) \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XIX \u0432\u0435\u043a\u0430,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b,
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443, \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0443
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u044e\u0449\u0438\u0445
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\U0001F4DC \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u044e\u043d\u043e\u0441\u0442\u044c \u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432
    \u042f\u043a\u043e\u0431 \u042f\u043a\u043e\u0431\u0438 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    10 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1804 \u0433\u043e\u0434\u0430 \u0432 \u041f\u043e\u0442\u0441\u0434\u0430\u043c\u0435,
    \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435 \u0431\u0430\u043d\u043a\u0438\u0440\u0430 \u0421\u0438\u043c\u043e\u043d\u0430
    \u042f\u043a\u043e\u0431\u0438 \u0438 \u0420\u0430\u0445\u0435\u043b\u0438 \u041b\u0435\u043c\u0430\u043d.
    \u041e\u043d \u0431\u044b\u043b \u0432\u0442\u043e\u0440\u044b\u043c \u0438\u0437 \u0447\u0435\u0442\u044b\u0440\u0451\u0445
    \u0434\u0435\u0442\u0435\u0439; \u0435\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u0431\u0440\u0430\u0442, \u041c\u043e\u0440\u0438\u0446 \u0413\u0435\u0440\u043c\u0430\u043d,
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0441\u0442\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u0444\u0438\u0437\u0438\u043a\u043e\u043c
    \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c, \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u043f\u043e\u0434 \u0438\u043c\u0435\u043d\u0435\u043c \u0411\u043e\u0440\u0438\u0441\u0430
    \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447\u0430 \u042f\u043a\u043e\u0431\u0438.
    \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u042f\u043a\u043e\u0431\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u043e\u0434
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u0441\u0432\u043e\u0435\u0433\u043e
    \u0434\u044f\u0434\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u043e\u0439
    \u043b\u0438\u043d\u0438\u0438, \u041b\u0435\u043c\u0430\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0438\u0432\u0438\u043b \u0435\u043c\u0443 \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u044f\u0437\u044b\u043a\u0430\u043c
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0412 1816 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 12 \u043b\u0435\u0442, \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u043e\u0442\u0441\u0434\u0430\u043c\u0441\u043a\u0443\u044e
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u043e\u0442\u043b\u0438\u0447\u043d\u043e\u0439 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0439
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435 \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c, \u0443\u0436\u0435
    \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0433\u043e\u0434\u0430 \u0435\u0433\u043e
    \u043f\u0435\u0440\u0435\u0432\u0435\u043b\u0438 \u0432 \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u043a\u043b\u0430\u0441\u0441. \u041e\u0434\u043d\u0430\u043a\u043e \u0438\u0437-\u0437\u0430
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0448\u0435\u0433\u043e
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u043c\u043b\u0430\u0434\u0448\u0435 16 \u043b\u0435\u0442, \u042f\u043a\u043e\u0431\u0438
    \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438
    \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0434\u043b\u044f \u0443\u0433\u043b\u0443\u0431\u043b\u0451\u043d\u043d\u043e\u0433\u043e
    \u0441\u0430\u043c\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044f \u0436\u0438\u0432\u043e\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a\u0430\u043a \u043a \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c, \u0442\u0430\u043a \u0438 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u043b
    \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u043e\u043f\u044b\u0442\u043a\u0443
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u043d\u0430\u0439\u0442\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043e\u0431\u0449\u0435\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438.\n\n\U0001F393
    \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0412 1821 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    16 \u043b\u0435\u0442, \u042f\u043a\u043e\u0431\u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0448\u0442\u0443\u0434\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u044e, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0430 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u043c
    \u0443\u0440\u043e\u0432\u043d\u0435 \u0438 \u0441\u0442\u0440\u043e\u0438\u043b\u0430\u0441\u044c
    \u043d\u0430 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0438, \u0447\u0442\u043e
    \u043d\u0435 \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u043b\u043e
    \u044e\u043d\u043e\u0433\u043e \u0432\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434\u0430.
    \u041f\u043e \u0441\u043e\u0432\u0435\u0442\u0443 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043e\u043d
    \u043d\u0430\u0447\u0430\u043b \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0440\u0443\u0434\u044b \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430 \u042d\u0439\u043b\u0435\u0440\u0430,
    \u0416\u043e\u0437\u0435\u0444\u0430-\u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0438 \u041f\u044c\u0435\u0440\u0430-\u0421\u0438\u043c\u043e\u043d\u0430 \u041b\u0430\u043f\u043b\u0430\u0441\u0430.
    \u042d\u0439\u043b\u0435\u0440 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0435\u0433\u043e
    \u043a\u0443\u043c\u0438\u0440\u043e\u043c \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043d\u0438. \u0412 1823 \u0433\u043e\u0434\u0443
    \u042f\u043a\u043e\u0431\u0438 \u043f\u0440\u0438\u043d\u044f\u043b \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c
    \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u043e\u0442\u043a\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044c
    \u043e\u0442 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0432 \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0412 1825 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e Disquisitiones Analyticae
    de Fractionibus Simplicibus (\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043e \u043f\u0440\u043e\u0441\u0442\u0435\u0439\u0448\u0438\u0445
    \u0434\u0440\u043e\u0431\u044f\u0445), \u043f\u043e\u0441\u0432\u044f\u0449\u0451\u043d\u043d\u0443\u044e
    \u0440\u0430\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. \u0412\u0430\u0436\u043d\u044b\u043c \u0441\u043e\u0431\u044b\u0442\u0438\u0435\u043c
    \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0441\u0442\u0430\u043b\u043e
    \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u0435 \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0432 1821 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e
    \u043e\u043d \u0441\u043c\u0435\u043d\u0438\u043b \u0438\u043c\u044f \u0441 \u042f\u043a\u043e\u0431
    \u0428\u0438\u043c\u043e\u043d \u043d\u0430 \u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432
    \u042f\u043a\u043e\u0431. \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u043e\u0439
    \u043c\u0435\u0440\u043e\u0439, \u0442\u0430\u043a \u043a\u0430\u043a \u0432 1822 \u0433\u043e\u0434\u0443
    \u0432 \u041f\u0440\u0443\u0441\u0441\u0438\u0438 \u0431\u044b\u043b \u043e\u0442\u043c\u0435\u043d\u0451\u043d
    \u044d\u0434\u0438\u043a\u0442 1812 \u0433\u043e\u0434\u0430, \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u0432\u0448\u0438\u0439
    \u0435\u0432\u0440\u0435\u044f\u043c \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438. \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435
    \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u042f\u043a\u043e\u0431\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0430\u0432\u043e \u0447\u0438\u0442\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0438 \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u0430.\n\n\U0001F3C6
    \u0420\u0430\u0441\u0446\u0432\u0435\u0442 \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435
    \u041a\u0430\u0440\u044c\u0435\u0440\u0430 \u042f\u043a\u043e\u0431\u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e. \u0412 1827 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0432\u0441\u0435\u0433\u043e 23
    \u043b\u0435\u0442, \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u0442\u044c \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c, \u0430 \u0443\u0436\u0435
    \u0432 1829 \u0433\u043e\u0434\u0443 \u2014 \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u042d\u0442\u043e
    \u0431\u044b\u043b\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0431\u044b\u0441\u0442\u0440\u043e\u0435
    \u043f\u0440\u043e\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0418\u043c\u0435\u043d\u043d\u043e \u0432
    \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435 \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442
    \u0440\u0430\u0441\u043a\u0440\u044b\u043b\u0441\u044f \u0432 \u043f\u043e\u043b\u043d\u043e\u0439
    \u043c\u0435\u0440\u0435. \u0412 1829 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u2014 Fundamenta nova theoriae functionum ellipticarum (\u041d\u043e\u0432\u044b\u0435
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u0435\u043e\u0440\u0438\u0438
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439).
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u0435\u043e\u0440\u0438\u0438 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043d\u0430\u0434 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e \u0438 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041d\u0438\u043b\u044c\u0441 \u0425\u0435\u043d\u0440\u0438\u043a \u0410\u0431\u0435\u043b\u044c.
    \u042f\u043a\u043e\u0431\u0438 \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u0440\u0430\u0431\u043e\u0442\u0430\u043c
    \u0410\u0431\u0435\u043b\u044f, \u0437\u0430\u044f\u0432\u0438\u0432 \u043e\u0431 \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0435\u043c: \u00ab\u042d\u0442\u043e
    \u0432\u044b\u0448\u0435 \u043c\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0442 \u0438
    \u0432\u044b\u0448\u0435 \u043c\u043e\u0438\u0445 \u043f\u043e\u0445\u0432\u0430\u043b\u00bb.
    \u0412 1831 \u0433\u043e\u0434\u0443 \u042f\u043a\u043e\u0431\u0438 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041c\u0430\u0440\u0438 \u0428\u0432\u0438\u043d\u043a. \u0412 \u0431\u0440\u0430\u043a\u0435
    \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u043f\u044f\u0442\u044c
    \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0438 \u0442\u0440\u0438 \u0434\u043e\u0447\u0435\u0440\u0438.
    \u0412 1832 \u0433\u043e\u0434\u0443 \u0443\u043c\u0435\u0440 \u0435\u0433\u043e \u043e\u0442\u0435\u0446,
    \u0438 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0441\u0435\u043c\u044c\u0438 \u0443\u0445\u0443\u0434\u0448\u0438\u043b\u043e\u0441\u044c,
    \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0432 \u042f\u043a\u043e\u0431\u0438 \u0432\u0437\u044f\u0442\u044c
    \u043d\u0430 \u0441\u0435\u0431\u044f \u0437\u0430\u0431\u043e\u0442\u0443 \u043e \u043c\u0430\u0442\u0435\u0440\u0438.
    \u041f\u0435\u0440\u0438\u043e\u0434 \u043a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u0439
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u044b \u0441\u0442\u0430\u043b \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c
    \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u043e\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0441\u0442\u0438. \u0421\u043f\u0438\u0441\u043e\u043a
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u0432 \u044d\u0442\u0438
    \u0433\u043e\u0434\u044b \u043e\u0433\u0440\u043e\u043c\u0435\u043d: \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b: \u0412\u0432\u0451\u043b \u0432 \u043e\u0431\u0438\u0445\u043e\u0434
    \u0441\u0438\u043c\u0432\u043e\u043b \u042f\u043a\u043e\u0431\u0438, \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435
    \u0441\u0438\u043c\u0432\u043e\u043b\u0430 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430;
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0424\u0435\u0440\u043c\u0430
    \u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0447\u0438\u0441\u0435\u043b
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \u0434\u0432\u0443\u0445
    \u0438 \u0447\u0435\u0442\u044b\u0440\u0451\u0445 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432.
    \u0412 1839 \u0433\u043e\u0434\u0443 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0442\u0430\u0431\u043b\u0438\u0446\u0443 \u0438\u043d\u0434\u0435\u043a\u0441\u043e\u0432
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0434\u043e 1000 (Canon arithmeticus). \u0410\u043d\u0430\u043b\u0438\u0437 \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430:
    \u0412 \u0440\u0430\u0431\u043e\u0442\u0435 1841 \u0433\u043e\u0434\u0430 \u00ab\u041e \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0434\u0435\u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043d\u0442\u0430\u0445\u00bb \u043e\u043d
    \u0432\u0432\u0451\u043b \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u043a\u0430\u043a \u044f\u043a\u043e\u0431\u0438\u0430\u043d\u044b. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0432\u043d\u0451\u0441 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435\u0439.
    \u0415\u043c\u0443 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0437\u0430\u0441\u043b\u0443\u0433\u0430
    \u0432\u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0432 \u0448\u0438\u0440\u043e\u043a\u043e\u0435
    \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0441\u0438\u043c\u0432\u043e\u043b\u0430
    \u0447\u0430\u0441\u0442\u043d\u043e\u0439 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439
    \u2202. \u0414\u0438\u043d\u0430\u043c\u0438\u043a\u0430: \u0423\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0420\u043e\u0443\u044d\u043d\u0430
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430 \u0434\u043b\u044f \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430-\u042f\u043a\u043e\u0431\u0438.
    \u0412 1836 \u0433\u043e\u0434\u0443 \u0432\u0432\u0451\u043b \u0432 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u042f\u043a\u043e\u0431\u0438.\n\n\U0001FA7A
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c, \u043f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432
    \u0411\u0435\u0440\u043b\u0438\u043d \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0418\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0438\u0432\u0435\u043b\u0430 \u043a \u0442\u043e\u043c\u0443,
    \u0447\u0442\u043e \u0432 1843 \u0433\u043e\u0434\u0443 \u042f\u043a\u043e\u0431\u0438 \u043f\u0435\u0440\u0435\u043d\u0451\u0441
    \u043d\u0435\u0440\u0432\u043d\u044b\u0439 \u0441\u0440\u044b\u0432, \u0443\u0441\u0443\u0433\u0443\u0431\u043b\u0451\u043d\u043d\u044b\u0439
    \u0434\u0438\u0430\u0431\u0435\u0442\u043e\u043c. \u041f\u043e \u0445\u043e\u0434\u0430\u0442\u0430\u0439\u0441\u0442\u0432\u0443
    \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u0440\u0443\u0433\u0430 \u041f\u0435\u0442\u0435\u0440\u0430
    \u0413\u0443\u0441\u0442\u0430\u0432\u0430 \u041b\u0435\u0436\u0451\u043d\u0430 \u0414\u0438\u0440\u0438\u0445\u043b\u0435,
    \u043a\u043e\u0440\u043e\u043b\u044c \u041f\u0440\u0443\u0441\u0441\u0438\u0438 \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c IV \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0443\u0447\u0451\u043d\u043e\u043c\u0443 \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u043c\u044b\u0439
    \u043e\u0442\u043f\u0443\u0441\u043a \u0434\u043b\u044f \u043f\u043e\u0435\u0437\u0434\u043a\u0438
    \u0432 \u0418\u0442\u0430\u043b\u0438\u044e \u0441 \u0446\u0435\u043b\u044c\u044e \u043f\u043e\u043f\u0440\u0430\u0432\u043a\u0438
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f. \u041f\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u0432 1844 \u0433\u043e\u0434\u0443 \u042f\u043a\u043e\u0431\u0438 \u043d\u0435 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433, \u0430 \u043f\u043e\u0441\u0435\u043b\u0438\u043b\u0441\u044f
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435. \u041a\u043e\u0440\u043e\u043b\u044c
    \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0435\u043c\u0443 \u043f\u0435\u043d\u0441\u0438\u044e,
    \u0438 \u043e\u043d \u0436\u0438\u043b \u0432 \u0441\u0442\u043e\u043b\u0438\u0446\u0435,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0447\u043b\u0435\u043d\u043e\u043c \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a (\u0438\u0437\u0431\u0440\u0430\u043d
    \u0432 1836 \u0433\u043e\u0434\u0443). \u0412 1848 \u0433\u043e\u0434\u0443, \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0445
    \u0441\u043e\u0431\u044b\u0442\u0438\u0439, \u042f\u043a\u043e\u0431\u0438, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0441\u0432\u043e\u0438\u043c\u0438 \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u043c\u0438, \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043b \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u043e\u0432.
    \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043d\u043d\u044b\u0439
    \u043a\u043e\u0440\u043e\u043b\u044c \u043b\u0438\u0448\u0438\u043b \u0435\u0433\u043e \u043f\u0435\u043d\u0441\u0438\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432\u0441\u043a\u043e\u0440\u0435, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u043c \u0445\u043e\u0434\u0430\u0442\u0430\u0439\u0441\u0442\u0432\u0430\u043c
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043b\u0438\u0447\u043d\u043e\u043c\u0443 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430 \u0444\u043e\u043d \u0413\u0443\u043c\u0431\u043e\u043b\u044c\u0434\u0442\u0430,
    \u0432\u044b\u043f\u043b\u0430\u0442\u0430 \u043f\u0435\u043d\u0441\u0438\u0438 \u0431\u044b\u043b\u0430
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u043f\u0435\u043d\u0441\u0438\u0438, \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u042f\u043a\u043e\u0431\u0438
    \u0431\u044b\u043b\u043e \u043f\u043e\u0434\u043e\u0440\u0432\u0430\u043d\u043e. \u041a\u0430\u0440\u043b
    \u0413\u0443\u0441\u0442\u0430\u0432 \u042f\u043a\u043e\u0431 \u042f\u043a\u043e\u0431\u0438
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435
    18 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1851 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    46 \u043b\u0435\u0442 \u043e\u0442 \u043e\u0441\u043f\u044b. \u0415\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0430
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435
    Friedhof I der Dreifaltigkeits-Kirchengemeinde \u0432 \u0431\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c
    \u0440\u0430\u0439\u043e\u043d\u0435 \u041a\u0440\u043e\u0439\u0446\u0431\u0435\u0440\u0433,
    \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e \u043e\u0442 \u043c\u043e\u0433\u0438\u043b\u044b
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0430
    \u0424\u0440\u0430\u043d\u0446\u0430 \u042d\u043d\u043a\u0435. \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u042f\u043a\u043e\u0431\u0438 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e.
    \u0412 1881\u20131891 \u0433\u043e\u0434\u0430\u0445 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0430
    \u0435\u0433\u043e \u043f\u043e\u043b\u043d\u043e\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439 (Gesammelte Werke) \u0432 \u0432\u043e\u0441\u044c\u043c\u0438
    \u0442\u043e\u043c\u0430\u0445. \u0415\u0433\u043e \u0438\u043c\u044f \u043d\u043e\u0441\u044f\u0442
    \u043c\u043d\u043e\u0433\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b \u0438 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438,
    \u0430 \u0435\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043d\u0430\u0443\u043a\u0435,
    \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c
    \u0434\u0435\u0432\u0438\u0437\u0435 \u00ab\u0418\u043d\u0432\u0435\u0440\u0442\u0438\u0440\u0443\u0439,
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u043d\u0432\u0435\u0440\u0442\u0438\u0440\u0443\u0439\u00bb
    (man muss immer umkehren*), \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443."
  shortBioEn: "Carl Gustav Jacob Jacob Jacoby (1804-1851) is one of the greatest mathematicians in the 19th century, whose works cover the theory of elliptical functions, the theory of numbers, algebra, dynamics and many other parts of mathematics and mechanics, and he has also been recognized as one of the most inspiring teachers of his time.\n\n==Early life==The child and youth of Carl Gustav Jacob Jacob Jacoby was born on December 10, 1804 in Potsdam, a wealthy Jewish banker, Simon Jacoby and Rachel Lehman, and was the second of four children; his older brother, Moritz Herman, later became a famous physicist and engineer, an academicist of the Petersburg Academy of Sciences, named Boris Semyonovich Jacoby.==History==Jacoby received his initial education under the leadership of his maternal uncle, Lehman, who gave him the love of classical languages and mathematics, and in 1816, at the age of 12, he entered a Potsdam gymnasium. Thanks to excellent home training and outstanding abilities, he was transferred to a senior school six months later.However, because of the university rule that prevented students under the age of 16, Jacoby had to spend several years in a gymnasium, which he used for deeper self-education, with a keen interest in both humanities and mathematics, during which time he made his first attempt at scientific research in an attempt to find an algebraic solution to the general equation of the fifth degree.\n\nIn 1821, at the age of 16, Jacoby entered Berlin University, where he continued to work on philosophy, philosophy and mathematics, and at the university of the time, mathematics was taught at a rather elementary level and was based on a memory that did not satisfy the young wunderkinda.On the advice of a teacher, he began to study the classic works of Leonard Eyler, Joseph Louis Lagrang and Pierre Simón Laplas, and he remained his idol throughout his life. In 1823, Jacoby made the final decision to devote himself to mathematics, abandoning his alternative career in Philology.In 1825, he was brilliant in his Ph.D. in Disquisitiones Analyticae de Fractionibus Simplicibus (Analytical Research on Simple Drills) on the degradation of rational functions, and in 1821 he changed his name from Jacob Shimon to Carl Gustav Jacob.This was a coercive measure, since in 1822, in Prussia the edict of 1812 was abolished, allowing Jews to hold academic posts, and immediately after the protection of the Doctor's thesis, Jakobi was given the right to lecture and began teaching at the University of Berlin as a private professor.\n\n♪ The Königsberg career of Jakobi grew rapidly. In 1827, at the age of 23, he was invited to become an extraordinary professor, and in 1829, he was an ordinary professor of mathematics at Königsberg University.In 1829, he published his main work, \"Fundamenta nova aoriae functionum ellipticarum\", which became a classic and laid the foundation for the theory of elliptical functions, which was the parallel and independent work of the Norwegian master mathematician Niels Henrik Abel.In 1831, Jacoby married Marie Schwink, and they had five sons and three daughters, and in 1832 his father died, and his family's financial situation deteriorated, forcing Jacoby to take care of his mother, and the period of Königsberg's profession was a time of extraordinary scientific prosperity.The list of his achievements in these years is huge: Theory of Numbers: introduced the symbol Jacobi, a synthesis of the symbol Lejandra; proved Ferm's theorems of the numbering of two and four squares. In 1839, he published the index table for all prime numbers up to 1,000 (Canon aristmeticus). Analysis and algebra: In 1841, he introduced and studied functional definitions, which are now known as Jacobians.He also made a significant contribution to the definition theory, and he was instrumental in introducing into the wide use of the private derivative symbol.\n\nIn 1843, Jacoby suffered from a nervous breakdown aggravated by diabetes. At the request of his friend Peter Gustave Lejoen Dirichle, King of Prussia Friedrich Wilhelm IV, he granted him a paid leave to travel to Italy to correct his health. On his return in 1844, Jacoby did not return to Koenigsberg but settled in Berlin.In 1848, during the revolutionary events, Jacoby, known for his liberal views, publicly supported the liberals, and after the repression of the revolution, the angry king took away his pension.However, thanks to persistent requests from the scientific community and personal intervention by Alexander von Humboldt, the pension was restored, despite the restoration of the pension, Jacoby's health was undermined. Carl Gustav Jacob Jacoby died in Berlin on February 18, 1851, at the age of 46.His grave is located in Friedhof I der Dreifaltigkeits-Kirchengemeinde, in the Berlin district of Kreutzberg, near the grave of astronomer Johann Franz Enke. Jacoby's legacy is enormous. In 1881–1891, the Berlin Academy of Sciences published his full collection of essays (Gesamelte Werke) in eight volumes.His name is given to many mathematical objects and concepts, and his approach to science, as expressed in the famous motto \"Invertiroui, always invertirus\" (man muss immer umkehren*), continues to inspire researchers around the world."
  interestingFactsRu: "\u0425\u043e\u0442\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u041a\u0430\u0440\u043b\u0430
    \u0413\u0443\u0441\u0442\u0430\u0432\u0430 \u042f\u043a\u043e\u0431\u0430 \u042f\u043a\u043e\u0431\u0438
    \u043f\u043e\u043b\u043d\u0430 \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u0432 \u043d\u0435\u0439
    \u0442\u0430\u043a\u0436\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f
    \u044f\u0440\u043a\u0438\u0435, \u0430 \u043f\u043e\u0440\u043e\u0439 \u0438 \u043a\u0443\u0440\u044c\u0451\u0437\u043d\u044b\u0435
    \u044d\u043f\u0438\u0437\u043e\u0434\u044b, \u0440\u0438\u0441\u0443\u044e\u0449\u0438\u0435
    \u0435\u0433\u043e \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0441
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430.\n\n\u2728 \u0417\u0430\u0431\u0430\u0432\u043d\u044b\u0435
    \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e \u0434\u0435\u043b\u0430\u0442\u044c
    \u0432\u0440\u0430\u0433\u043e\u0432: \u041f\u0440\u0438\u0431\u044b\u0432 \u0432 1826 \u0433\u043e\u0434\u0443
    \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u042f\u043a\u043e\u0431\u0438
    \u043f\u043e \u0441\u0432\u043e\u0435\u0439 \u043f\u0440\u044f\u043c\u043e\u0442\u0435 \u0438
    \u0441\u0430\u0440\u043a\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u0443\u043c\u0443\u0434\u0440\u0438\u043b\u0441\u044f
    \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043f\u0440\u043e\u0442\u0438\u0432
    \u0441\u0435\u0431\u044f \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435\u0445 \u043a\u043e\u043b\u043b\u0435\u0433.
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c
    \u0424.\u0412. \u0411\u0435\u0441\u0441\u0435\u043b\u044c \u043f\u0438\u0441\u0430\u043b
    \u0413\u0430\u0443\u0441\u0441\u0443: \u00ab\u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e
    \u043e\u0447\u0435\u043d\u044c \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432, \u043d\u043e
    \u043e\u043d \u0441\u0430\u043c \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u043b \u043f\u043e\u0447\u0442\u0438
