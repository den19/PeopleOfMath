    \u0431\u0443\u0434\u0443\u0447\u0438 \u0447\u043b\u0435\u043d\u043e\u043c \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a (\u0438\u0437\u0431\u0440\u0430\u043d
