  wikidataId: Q76564
  fullNameRu: "\u042F\u043A\u043E\u0431\u0438, \u041A\u0430\u0440\u043B \u0413\u0443\u0441\u0442\u0430\u0432
    \u042F\u043A\u043E\u0431"
  fullNameEn: Carl Gustav Jacob Jacobi
  birthDate: 10.12.1804
  deathDate: 18.02.1851
