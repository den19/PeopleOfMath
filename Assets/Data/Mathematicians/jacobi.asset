    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c
    \u0424.\u0412. \u0411\u0435\u0441\u0441\u0435\u043b\u044c \u043f\u0438\u0441\u0430\u043b
    \u0413\u0430\u0443\u0441\u0441\u0443: \u00ab\u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e
    \u043e\u0447\u0435\u043d\u044c \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432, \u043d\u043e
    \u043e\u043d \u0441\u0430\u043c \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u043b \u043f\u043e\u0447\u0442\u0438
    \u0432\u0441\u0435\u0445 \u043f\u0440\u043e\u0442\u0438\u0432 \u0441\u0435\u0431\u044f...
    \u043a\u043e\u0440\u0435\u043d\u043d\u044b\u0445 \u043a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0436\u0446\u0435\u0432
    \u043e\u043d \u0443\u0432\u0435\u0440\u044f\u043b, \u0447\u0442\u043e \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
    \u0441\u0432\u043e\u0451 \u0442\u0435\u043f\u0435\u0440\u0435\u0448\u043d\u0435\u0435 \u043c\u0435\u0441\u0442\u043e\u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0435,
    \u043a\u0430\u043a \u0441\u0441\u044b\u043b\u043a\u0443... \u0430 \u044d\u0442\u043e\u0433\u043e
    \u0435\u043c\u0443 \u043d\u0435 \u043f\u0440\u043e\u0449\u0430\u044e\u0442. \u041e\u0434\u043d\u0430\u043a\u043e
    \u044f \u043d\u0430\u0434\u0435\u044e\u0441\u044c, \u0447\u0442\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0435
    \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0434\u0443\u0440\u0430\u0447\u0435\u0441\u0442\u0432\u0430
    \u0443 \u043d\u0435\u0433\u043e \u0441\u043a\u043e\u0440\u043e \u043f\u0440\u043e\u0439\u0434\u0443\u0442\u00bb.
    \u042d\u0442\u0430 \u0447\u0435\u0440\u0442\u0430 \u2014 \u00ab\u043e\u0441\u0442\u0440\u044b\u0439
    \u044f\u0437\u044b\u043a \u0438 \u0431\u0440\u0438\u043b\u043b\u0438\u0430\u043d\u0442\u043e\u0432\u043e\u0435
    \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u0438\u0435\u00bb \u2014 \u043f\u043e\u0440\u043e\u0439
    \u0434\u0435\u043b\u0430\u043b\u0430 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0443\u0432\u0430\u0436\u0430\u043b\u0438, \u043d\u043e
    \u043d\u0435 \u043b\u044e\u0431\u0438\u043b\u0438. \u0421\u0430\u043c\u043e\u043e\u0442\u0432\u0435\u0440\u0436\u0435\u043d\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434\u043e\u0433\u043e\u043b\u0438\u0437\u043c: \u042f\u043a\u043e\u0431\u0438
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0442\u0440\u0443\u0434\u043e\u043b\u044e\u0431\u0438\u0435\u043c,
    \u043f\u043e\u0440\u043e\u0439 \u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0449\u0438\u043c
    \u0441 \u0441\u0430\u043c\u043e\u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435\u043c.
    \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0435\u0433\u043e \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e\u0439
    \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u0435,
    \u043e\u043d \u043e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u0420\u0430\u0437\u0443\u043c\u0435\u0435\u0442\u0441\u044f, \u044f \u0438\u043d\u043e\u0433\u0434\u0430
    \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438\u043c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c
    \u0438\u0437-\u0437\u0430 \u043f\u0435\u0440\u0435\u0443\u0442\u043e\u043c\u043b\u0435\u043d\u0438\u044f,
    \u043d\u043e \u0447\u0442\u043e \u0441 \u0442\u043e\u0433\u043e? \u0422\u043e\u043b\u044c\u043a\u043e
    \u0443 \u043a\u0430\u043f\u0443\u0441\u0442\u044b \u043d\u0435\u0442 \u043d\u0435\u0440\u0432\u043e\u0432
    \u0438 \u0437\u0430\u0431\u043e\u0442. \u0418 \u0447\u0442\u043e \u043e\u043d\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442
    \u0437\u0430 \u0441\u0432\u043e\u0451 \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u043e\u0435
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435?\u00bb. \u042d\u0442\u043e \u0431\u0435\u0437\u043c\u0435\u0440\u043d\u043e\u0435
    \u0440\u0432\u0435\u043d\u0438\u0435 \u0432 \u0438\u0442\u043e\u0433\u0435 \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0435\u0433\u043e \u043d\u0435\u0440\u0432\u043d\u043e\u043c\u0443 \u0441\u0440\u044b\u0432\u0443
    \u0432 1843 \u0433\u043e\u0434\u0443. \u0418\u0441\u0442\u0438\u043d\u043d\u043e\u0435 \u0431\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u0441\u0442\u0432\u043e:
    \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043d\u0430\u0443\u043a\u0438 \u0437\u043d\u0430\u0435\u0442
    \u043d\u0435\u043c\u0430\u043b\u043e \u0441\u043f\u043e\u0440\u043e\u0432 \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435,
    \u043d\u043e \u042f\u043a\u043e\u0431\u0438 \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0441\u0435\u0431\u044f
    \u0441 \u0441\u0430\u043c\u043e\u0439 \u043b\u0443\u0447\u0448\u0435\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0432\u0435\u0447\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a, \u041d\u0438\u043b\u044c\u0441 \u0425\u0435\u043d\u0440\u0438\u043a
    \u0410\u0431\u0435\u043b\u044c, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u0438\u043b\u0438
    \u0438 \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u043b\u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u042f\u043a\u043e\u0431\u0438, \u0442\u043e\u0442
    \u043d\u0435 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043b\u0441\u044f, \u0430
    \u043f\u0440\u043e\u0438\u0437\u043d\u0451\u0441 \u0444\u0440\u0430\u0437\u0443, \u0441\u0442\u0430\u0432\u0448\u0443\u044e
    \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439: \u00ab\u042d\u0442\u043e \u0432\u044b\u0448\u0435
    \u043c\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0442 \u0438 \u0432\u044b\u0448\u0435
    \u043c\u043e\u0438\u0445 \u043f\u043e\u0445\u0432\u0430\u043b\u00bb. \u0411\u043e\u043b\u0435\u0435
    \u0442\u043e\u0433\u043e, \u0438\u043c\u0435\u043d\u043d\u043e \u042f\u043a\u043e\u0431\u0438
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043d\u0430\u0437\u0432\u0430\u0442\u044c
    \u043e\u0431\u0448\u0438\u0440\u043d\u044b\u0439 \u043a\u043b\u0430\u0441\u0441 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432
    \u0432 \u0447\u0435\u0441\u0442\u044c \u0441\u0432\u043e\u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u0430 \u2014 \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u043c\u0438.\n\n\U0001F4DA
    \u041f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0430\u043b\u0430\u043d\u0442
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u042f\u043a\u043e\u0431\u0438
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c
    \u0443\u0447\u0451\u043d\u044b\u043c, \u043d\u043e \u0438 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u043f\u043e \u043e\u0431\u0449\u0435\u043c\u0443
    \u043c\u043d\u0435\u043d\u0438\u044e, \u043d\u0435 \u0438\u043c\u0435\u043b \u0441\u0435\u0431\u0435
    \u0440\u0430\u0432\u043d\u044b\u0445. \u0412 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u0445
    \u043e\u043d \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0442\u044c
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0443\u044e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c,
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u0443\u044e \u043c\u044b\u0441\u043b\u0438\u0442\u044c
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e. \u041d\u0435\u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0447\u0442\u043e \u0441\u0440\u0435\u0434\u0438 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0438\u043b\u0438 \u0442\u0435\u0445, \u043a\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u043b
    \u0441\u0435\u0431\u044f \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438,
    \u2014 \u0446\u0435\u043b\u0430\u044f \u043f\u043b\u0435\u044f\u0434\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432: \u041b\u044e\u0434\u0432\u0438\u0433
    \u041e\u0442\u0442\u043e \u0413\u0435\u0441\u0441\u0435, \u041a\u043b\u0435\u0431\u0448,
    \u0428\u0430\u0440\u043b\u044c \u042d\u0440\u043c\u0438\u0442, \u0416\u043e\u0437\u0435\u0444
    \u041b\u0438\u0443\u0432\u0438\u043b\u043b\u044c, \u0410\u0440\u0442\u0443\u0440 \u041a\u044d\u043b\u0438
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u043a\u0443\u0440\u044c\u0451\u0437\u043d\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439 \u0441 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c
    \u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u0445
    \u0410\u043d\u0433\u043b\u0438\u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0435\u0433\u043e \u043f\u0440\u044f\u043c\u043e\u0442\u0443. \u041f\u043e\u0441\u043b\u0435
    \u0432\u0438\u0437\u0438\u0442\u0430 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436
    \u0432 1842 \u0433\u043e\u0434\u0443 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u043e
    \u0442\u043e\u043c, \u043a\u0442\u043e, \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e,
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0410\u043d\u0433\u043b\u0438\u0438,
    \u043e\u043d, \u043a\u0430\u043a \u0433\u043e\u0432\u043e\u0440\u044f\u0442, \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u0422\u0430\u043a\u043e\u0433\u043e \u043d\u0435\u0442\u00bb.\n\n\U0001F319 \u041d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041f\u0430\u043c\u044f\u0442\u044c \u043e
    \u041a\u0430\u0440\u043b\u0435 \u0413\u0443\u0441\u0442\u0430\u0432\u0435 \u042f\u043a\u043e\u0431\u0438
    \u0443\u0432\u0435\u043a\u043e\u0432\u0435\u0447\u0435\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0412 \u0435\u0433\u043e
    \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d \u043a\u0440\u0430\u0442\u0435\u0440
    Jacobi \u043d\u0430 \u041b\u0443\u043d\u0435."
