  achievementsRu: "\u0412\u043a\u043b\u0430\u0434 \u0416\u0430\u043d-\u041f\u044c\u0435\u0440\u0430 \u0421\u0435\u0440\u0440\u0430
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d
    \u0442\u0435\u043c, \u0447\u0442\u043e \u043e\u043d \u0442\u0440\u0438\u0436\u0434\u044b
    \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0446\u0435\u043b\u044b\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0437\u0430 \u0441\u0432\u043e\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443. \u0415\u0433\u043e
    \u0442\u0440\u0443\u0434\u044b \u0434\u0435\u043b\u044f\u0442\u0441\u044f \u043d\u0430 \u0442\u0440\u0438
    \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u044d\u043f\u043e\u0445\u0438. \u041d\u0438\u0436\u0435
    \u2014 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u043e\u0440
    \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u044d\u0442\u0430\u043f\u0430, \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c \u0438 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0439. --- \u042d\u043f\u043e\u0445\u0430
    1: \u0410\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f (1948\u20131953) \u042d\u0442\u043e
    \u0432\u0440\u0435\u043c\u044f, \u043a\u043e\u0433\u0434\u0430 \u0421\u0435\u0440\u0440
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438. 1. \u0421\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0421\u0435\u0440\u0440\u0430 \u0412 \u0441\u0432\u043e\u0435\u0439 \u0434\u0438\u043f\u043b\u043e\u043c\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 (1951) \u0421\u0435\u0440\u0440 \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e
    \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0438\u043b \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u041b\u0435\u0440\u0435. \u041e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0440\u0430\u0441\u0441\u043b\u043e\u0435\u043d\u0438\u044f (Serre spectral sequence),
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442
    \u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0431\u0430\u0437\u044b, \u0441\u043b\u043e\u044f
    \u0438 \u0442\u043e\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0440\u0430\u0441\u0441\u043b\u043e\u0435\u043d\u0438\u044f. \u0414\u0435\u0442\u0430\u043b\u044c:
    \u0414\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u0440\u0430\u0441\u0441\u043b\u043e\u0435\u043d\u0438\u044f
    \\( F \\to E \\to B \\) \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \\( E^2_{p,q} = H_p(B, H_q(F)) \\Rightarrow H_{p+q}(E) \\). \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b \u0441\u0444\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u043e \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0438 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \"\u0442\u0451\u043c\u043d\u044b\u043c \u043b\u0435\u0441\u043e\u043c\". 2. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0438 \u043a\u043b\u0430\u0441\u0441\u044b
    \u0421\u0435\u0440\u0440\u0430 (C-\u0442\u0435\u043e\u0440\u0438\u044f) \u041e\u043d \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043a\u043b\u0430\u0441\u0441\u043e\u0432 \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f \u0421\u0435\u0440\u0440\u0430 (\u043a\u043b\u0430\u0441\u0441
    \\( \\mathcal{C} \\) \u0433\u0440\u0443\u043f\u043f, \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0439
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0433\u0440\u0443\u043f\u043f,
    \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0439).
    \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u044d\u0442\u043e, \u043e\u043d
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e: \u0413\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b \\( \\pi_i(S^n) \\) \u043a\u043e\u043d\u0435\u0447\u043d\u044b
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \\( i > n \\), \u0437\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c
    \u0441\u043b\u0443\u0447\u0430\u044f \\( i = 2n-1 \\), \u0433\u0434\u0435 \u043e\u043d\u0438
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043f\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0439
    \u0430\u0431\u0435\u043b\u0435\u0432\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u043e\u0439
    \u0440\u0430\u043d\u0433\u0430 1. \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0440\u043e\u0440\u044b\u0432,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0434\u043e \u0421\u0435\u0440\u0440\u0430 \u043d\u0435
    \u0437\u043d\u0430\u043b\u0438 \u0434\u0430\u0436\u0435 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    \u044d\u0442\u0438\u0445 \u0433\u0440\u0443\u043f\u043f. 3. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f
    \u0441 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438
    \u0421\u0435\u0440\u0440 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u0445\u043d\u0438\u043a\u0443
    \\( \\mathcal{C} \\)-\u0438\u0437\u043e\u043c\u043e\u0440\u0444\u0438\u0437\u043c\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0430
    \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u0442\u044c \u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u043a\u0440\u044b\u0432\u0430\u044e\u0449\u0438\u0445.
    \u042d\u0442\u043e \u0434\u0430\u043b\u043e \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0440\u0430\u0437\u043b\u0438\u0447\u0435\u043d\u0438\u044f \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438
    \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432.
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u044d\u0442\u043e\u0433\u043e
    \u043f\u0435\u0440\u0438\u043e\u0434\u0430: \u0414\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f
    \u00abHomologie singuli\u00e8re des espaces fibr\u00e9s\u00bb (\u0410\u043d\u043d\u0430\u043b\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, 1951) \u0438 \u0441\u0435\u0440\u0438\u044f
    \u0437\u0430\u043c\u0435\u0442\u043e\u043a \u0432 Comptes Rendus. --- \u042d\u043f\u043e\u0445\u0430
    2: \u041f\u0435\u0440\u0435\u0445\u043e\u0434 \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u2014 \u0442\u0435\u043e\u0440\u0438\u044f
    \u043f\u0443\u0447\u043a\u043e\u0432 (1954\u20131959) \u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u043b\u043e\u043c
    \u0432 \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u0421\u0435\u0440\u0440\u0430. \u041e\u043d
    \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c
    \u043a \u0430\u043b\u0433\u0435\u0431\u0440\u0435. 1. Faisceaux Alg\u00e9briques Coh\u00e9rents
    (FAC) \u2014 1955 \u0433\u043e\u0434 \u042d\u0442\u043e \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0440\u043e\u0434\u0438\u043b
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e. \u0412 \u044d\u0442\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0432 Annals of Mathematics) \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435:
    \u0410\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0443\u0447\u043a\u0438:
    \u041e\u043d \u043f\u0435\u0440\u0435\u043d\u0435\u0441 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0443\u0447\u043a\u043e\u0432 \u041e\u043a\u0430-\u041a\u0430\u0440\u0442\u0430\u043d\u0430
    \u043d\u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f \u043d\u0430\u0434
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c
    \u043f\u043e\u043b\u0435\u043c. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0410 \u0438
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0411 (\u0434\u043b\u044f \u0430\u0444\u0444\u0438\u043d\u043d\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439): \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0410: \u0414\u043b\u044f \u043a\u043e\u0433\u0435\u0440\u0435\u043d\u0442\u043d\u043e\u0433\u043e
    \u043f\u0443\u0447\u043a\u0430 \\( \\mathcal{F} \\) \u043d\u0430 \u0430\u0444\u0444\u0438\u043d\u043d\u043e\u043c
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0438 \\( X \\) \u0435\u0433\u043e
    \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0435\u0447\u0435\u043d\u0438\u044f
    \u043f\u043e\u0440\u043e\u0436\u0434\u0430\u044e\u0442 \u0432\u0441\u0435 \u0440\u043e\u0441\u0442\u043a\u0438.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0411: \u0412\u0441\u0435 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438
    \\( H^i(X, \\mathcal{F}) = 0 \\) \u0434\u043b\u044f \\( i > 0 \\). \u0421\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435:
    \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f
    \u043a\u043e\u0433\u0435\u0440\u0435\u043d\u0442\u043d\u044b\u0445 \u043f\u0443\u0447\u043a\u043e\u0432
    \u043d\u0430 \u0430\u0444\u0444\u0438\u043d\u043d\u043e\u043c \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0438
    \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u0430 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438
    \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043f\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445
    \u043c\u043e\u0434\u0443\u043b\u0435\u0439 \u043d\u0430\u0434 \u043a\u043e\u043b\u044c\u0446\u043e\u043c
    \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.
    \u042d\u0442\u043e \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043a\u043b\u0435\u0438\u043b\u043e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 (\u043a\u043e\u043b\u044c\u0446\u0430) \u0438
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e (\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430).
    2. GAGA (G\u00e9om\u00e9trie Alg\u00e9brique et G\u00e9om\u00e9trie Analytique) \u2014 1956
    \u0433\u043e\u0434 \u0412 \u044d\u0442\u043e\u043c \u0442\u0440\u0443\u0434\u0435 \u0421\u0435\u0440\u0440
    \u0441\u0440\u0430\u0432\u043d\u0438\u043b \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f \u043d\u0430\u0434
    \u043f\u043e\u043b\u0435\u043c \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \\( \\mathbb{C} \\) \u0441 \u0438\u0445 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0430\u043d\u0430\u043b\u043e\u0433\u0430\u043c\u0438 (\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u043c\u0438
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f\u043c\u0438). \u041e\u043d
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438
    \u043a\u043e\u0433\u0435\u0440\u0435\u043d\u0442\u043d\u044b\u0445 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0443\u0447\u043a\u043e\u0432 \u0438 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0443\u0447\u043a\u043e\u0432 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u044b.
    \u042d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0439
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u044a\u0435\u043a\u0442
    \u043d\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c (\u0437\u0430\u0434\u0430\u0435\u0442\u0441\u044f
    \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u0430\u043c\u0438). \u042d\u0442\u043e\u0442
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0441\u0442\u0430\u043b \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430.
    --- \u042d\u043f\u043e\u0445\u0430 3: \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b,
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0413\u0430\u043b\u0443\u0430
    \u0438 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b
    (1968 \u2013 2000-\u0435) \u041f\u043e\u0441\u043b\u0435 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0441 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c \u0421\u0435\u0440\u0440
    \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443,
    \u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442 \u0442\u0443\u0434\u0430
    \u0432\u0441\u044e \u043c\u043e\u0449\u044c \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. 1. \u0422\u0435\u043e\u0440\u0438\u044f
    \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0439 \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438
    \u0427\u0436\u0435\u043d\u044f \u0412 1965 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442
    \u0442\u0440\u0443\u0434 \u00abAlg\u00e8bre locale, multiplicit\u00e9s\u00bb (\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u041f\u044c\u0435\u0440\u043e\u043c \u0421\u0430\u043c\u0443\u044d\u043b\u0435\u043c),
    \u0433\u0434\u0435 \u0432\u0432\u043e\u0434\u0438\u0442 \u0447\u0435\u0442\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0439 \u0432 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0445
    \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043b\u044c\u0446\u0430\u0445,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0442\u043e\u0440-\u0444\u0443\u043d\u043a\u0442\u043e\u0440\u044b.
    \u042d\u0442\u043e \u0434\u0430\u043b\u043e \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \"\u0447\u0438\u0441\u043b\u0430 \u0442\u043e\u0447\u0435\u043a \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u044f
    \u043a\u0440\u0438\u0432\u044b\u0445\". 2. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u0421\u0435\u0440\u0440\u0430 \u043e \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438
    (1975) \u2014 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0421\u0435\u0440\u0440 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u00abValeurs propres des op\u00e9rateurs de Hecke
    modulo l\u00bb. \u041e\u043d \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    (\u0441\u0442\u0430\u0432\u0448\u0443\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439),
    \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0435
    \u043d\u0435\u0447\u0435\u0442\u043d\u043e\u0435 \u0434\u0432\u0443\u043c\u0435\u0440\u043d\u043e\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0433\u0440\u0443\u043f\u043f\u044b
    \u0413\u0430\u043b\u0443\u0430 \\( \\text{Gal}(\\bar{\\mathbb{Q}}/\\mathbb{Q}) \\) \u043d\u0430\u0434
    \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c \u043f\u043e\u043b\u0435\u043c \\( \\mathbb{F}_l
    \\), \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043d\u0435\u0440\u0430\u0437\u0432\u0435\u0442\u0432\u043b\u0435\u043d\u043d\u044b\u043c
    \u0432\u043d\u0435 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442
    \u0438\u0437 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u044b
    (\u0442.\u0435. \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u043c).
    \u0414\u0435\u0442\u0430\u043b\u0438: \u041e\u043d \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \"\u0432\u0435\u0441\" \u0438 \"\u0443\u0440\u043e\u0432\u0435\u043d\u044c\" \u0442\u0430\u043a\u043e\u0433\u043e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u0434\u0430\u043b
    \u044f\u0432\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u043a\u0430\u043a
    \u0438\u0445 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u043f\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044e
    \u0432 \u0442\u043e\u0447\u043a\u0435 \\( l \\). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0442\u0435\u043c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441
    \u0432 1994 \u0433\u043e\u0434\u0443 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0412\u0435\u043b\u0438\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0424\u0435\u0440\u043c\u0430. \u0423\u0430\u0439\u043b\u0441
    \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u0447\u0430\u0441\u0442\u043d\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0421\u0435\u0440\u0440\u0430
    (\u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u0445
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445).
    3. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0413\u0440\u043e\u043b\u043b\u044f-\u0421\u0435\u0440\u0440\u0430
    \u043e \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u043e\u0439 \u043a\u0440\u0438\u0432\u043e\u0439
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u041f\u044c\u0435\u0440\u043e\u043c \u0414\u0435\u043b\u0438\u043d\u0435\u043c
    (1973) \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432\u0441\u0435
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0413\u0430\u043b\u0443\u0430, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441
    \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u043c\u0438 \u0444\u043e\u0440\u043c\u0430\u043c\u0438
    \u0432\u0435\u0441\u0430 \\( \\geq 2 \\), \u0440\u0430\u0441\u043f\u0430\u0434\u0430\u044e\u0442\u0441\u044f
    \u0432 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043a\u0440\u0443\u0447\u0435\u043d\u0438\u044f
    \u0438 \u044d\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445.
    \u042d\u0442\u043e \u0434\u0430\u043b\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044e \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432
    \u0413\u0435\u043a\u043a\u0435. 4. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u041e\u0442\u0442\u0435\u0440\u0441\u043b\u0438-\u0421\u0435\u0440\u0440\u0430
    (1973) \u0421\u0435\u0440\u0440 \u0438 \u041e\u0442\u0442\u0435\u0440\u0441\u043b\u0438
    \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b\u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u043e \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044f\u043c\u0440\u0438 \u0440\u043e\u0434\u043e\u0432
    \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0445 \u043f\u043e\u043b\u0435\u0439 \u0441 \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0439
    \u0433\u0440\u0443\u043f\u043f\u043e\u0439 \u043a\u043b\u0430\u0441\u0441\u043e\u0432. \u041e\u043d\u0438
    \u0441\u0432\u044f\u0437\u0430\u043b\u0438 \u0434\u0438\u0441\u043a\u0440\u0438\u043c\u0438\u043d\u0430\u043d\u0442\u044b
    \u043f\u043e\u043b\u0435\u0439 \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438 \u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044f\u043c\u0438,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u0440\u0438\u0432\u044b\u0435 \u0441 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u043c
    \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435\u043c. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0430 \u0446\u0435\u043b\u0443\u044e \u0432\u0435\u0442\u0432\u044c
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0432 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. --- \u0421\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0440\u0443\u0434\u044b \u0438 \"\u041a\u0440\u0430\u0441\u043d\u0430\u044f \u043a\u043d\u0438\u0433\u0430\"
    (1964) \u0412 1964 \u0433\u043e\u0434\u0443 \u0421\u0435\u0440\u0440 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442
    \u043a\u043d\u0438\u0433\u0443 \u00abCohomologie Galoisienne\u00bb (\u041a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438
    \u0413\u0430\u043b\u0443\u0430), \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043d\u0435\u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \"\u041a\u0440\u0430\u0441\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u043e\u0439\" (\u0438\u0437-\u0437\u0430
    \u043e\u0431\u043b\u043e\u0436\u043a\u0438). \u0412 \u043d\u0435\u0439 \u043e\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0439
    \u043f\u0440\u043e\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445 \u0433\u0440\u0443\u043f\u043f
    \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0435\u0435 \u043a \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0439
    \u0433\u0440\u0443\u043f\u043f\u0435 \u0413\u0430\u043b\u0443\u0430. \u041e\u043d \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043a\u043b\u0430\u0441\u0441\u043e\u0432 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438 (cd) \u043f\u043e\u043b\u0435\u0439
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043f\u043e\u043b\u0435
    \\( \\mathbb{Q}_p \\) \u0438\u043c\u0435\u0435\u0442 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c 2. \u042d\u0442\u043e
    \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b\u043e, \u043f\u043e\u0447\u0435\u043c\u0443
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b
    \u043d\u0430\u0434 p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043f\u043e\u043b\u044f\u043c\u0438
    \u0432\u0435\u0434\u0443\u0442 \u0441\u0435\u0431\u044f \"\u0445\u043e\u0440\u043e\u0448\u043e\".
    \u041a\u043d\u0438\u0433\u0430 \u00abArbres, amalgames, SL\u2082\u00bb (1977): \u041d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434, \u0433\u0434\u0435 \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0433\u0440\u0430\u0444\u043e\u0432 (\u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432)
    \u043a \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044e \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f \\( SL_2 \\) \u043d\u0430\u0434 \u043a\u043e\u043b\u044c\u0446\u0430\u043c\u0438.
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b \u043d\u0430 \u0434\u0435\u0440\u0435\u0432\u0435 (\u0434\u0435\u0440\u0435\u0432\u043e
    \u0421\u0435\u0440\u0440\u0430) \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u044d\u0442\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b
    \u043a\u0430\u043a \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0441 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435\u043c. \u042d\u0442\u043e
    \u0434\u0430\u043b\u043e \u043c\u043e\u0449\u043d\u044b\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f. --- \u041c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f
    \u0421\u0435\u0440\u0440\u0430: \"\u041c\u0430\u043b\u044b\u0435 \u0442\u0435\u043e\u0440\u0435\u043c\u043d\u044b\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\" \u0413\u043b\u0430\u0432\u043d\u0430\u044f
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432
    \u2014 \u043e\u043d \u0438\u0437\u0431\u0435\u0433\u0430\u043b \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u0445
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0439. \u0415\u0441\u043b\u0438 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043f\u0438\u0441\u0430\u043b \u0442\u043e\u043c\u0430 (EGA \u043d\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442
    \u0442\u044b\u0441\u044f\u0447\u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446), \u0442\u043e
    \u0421\u0435\u0440\u0440 \u043f\u0438\u0441\u0430\u043b \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0435,
    \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u043e \u0441\u0436\u0430\u0442\u044b\u0435
    \u0437\u0430\u043c\u0435\u0442\u043a\u0438. \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0442\u0435\u0445\u043d\u0438\u043a\u0430 \u2014 \u043c\u0435\u0442\u043e\u0434 \"\u0441\u043a\u0440\u0443\u0447\u0438\u0432\u0430\u043d\u0438\u044f\"
    (twisting) \u2014 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432
    \u0442\u043e\u043c, \u0447\u0442\u043e \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e\u043d
    \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442 \u043f\u0440\u043e\u0441\u0442\u043e\u0439
    \u0447\u0430\u0441\u0442\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 (\u043e\u0431\u044b\u0447\u043d\u043e
    \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u043f\u0440\u044f\u043c\u0443\u044e
    \\( \\mathbb{P}^1 \\)), \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0442\u0430\u043c,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u043f\u0443\u0441\u043a\u0430 (descent) \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442
    \u043d\u0430 \u043e\u0431\u0449\u0438\u0435 \u0441\u0445\u0435\u043c\u044b. --- \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b
    (\u043f\u043e\u043b\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445):
    1. 1951 \u2014 Homologie singuli\u00e8re des espaces fibr\u00e9s (Topology). 2. 1955 \u2014
    Faisceaux alg\u00e9briques coh\u00e9rents (Algebraic Geometry, FAC). 3. 1956 \u2014 G\u00e9om\u00e9trie
    alg\u00e9brique et g\u00e9om\u00e9trie analytique (GAGA). 4. 1958 \u2014 Modules projectifs
    et espaces fibr\u00e9s \u00e0 fibre vectorielle (\u0422\u0435\u043e\u0440\u0438\u044f \u043c\u043e\u0434\u0443\u043b\u0435\u0439).
    5. 1964 \u2014 Cohomologie galoisienne (\u0422\u0435\u043e\u0440\u0438\u044f \u0413\u0430\u043b\u0443\u0430
    \u0438 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438). 6. 1965 \u2014
    Alg\u00e8bre locale, multiplicit\u00e9s (\u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u041f. \u0421\u0430\u043c\u0443\u044d\u043b\u0435\u043c). 7. 1970 \u2014 Cours d'arithm\u00e9tique
    (\u0423\u0447\u0435\u0431\u043d\u0438\u043a \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b, \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u044b\u0439
    \u043d\u0430 \u0432\u0441\u0435 \u044f\u0437\u044b\u043a\u0438). 8. 1973 \u2014 Formes modulaires
    et repr\u00e9sentations l-adiques (\u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0414\u0435\u043b\u0438\u043d\u0435\u043c). 9. 1975 \u2014 Valeurs propres des op\u00e9rateurs
    de Hecke modulo l (\u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438).
    10. 1988 \u2014 Abelian l-adic representations and elliptic curves (\u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0440\u0443\u0434 \u043f\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u043c
    \u0413\u0430\u043b\u0443\u0430). 11. 1992 \u2014 Topics in Galois Theory* (\u041b\u0435\u043a\u0446\u0438\u0438
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0435, \u0438\u0437\u0434\u0430\u043d\u044b
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e \u0434\u043b\u044f \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439).
    --- \u0418\u0442\u043e\u0433\u043e\u0432\u043e\u0435 \u0440\u0435\u0437\u044e\u043c\u0435
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0430
    \u0421\u0435\u0440\u0440 \u2014 \"\u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u043c\u043e\u0441\u0442\"
    \u043c\u0435\u0436\u0434\u0443 \u0447\u0438\u0441\u0442\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u043e\u0439,
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0435\u0439 \u0438 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u043e\u0439.
    \u041e\u043d \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u0437\u0434\u0430\u043b
    \u044f\u0437\u044b\u043a, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0433\u043e\u0432\u043e\u0440\u044f\u0442
    \u0432\u0441\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u044b. \u0415\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f:
    - \u0414\u0430\u0442\u044c \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f.
    - \u0421\u0432\u044f\u0437\u0430\u0442\u044c \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438
    \u0441 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043f\u0443\u0447\u043a\u0430\u043c\u0438. - \u041f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    \u0413\u0430\u043b\u0443\u0430, \u0431\u0435\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0424\u0435\u0440\u043c\u0430. - \u0412\u0432\u0435\u0441\u0442\u0438
    \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u044b \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438
    \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0440\u0438\u0432\u044b\u0445 \u043d\u0430\u0434 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c\u0438
    \u043f\u043e\u043b\u044f\u043c\u0438."
  achievementsEn: 
  personalLifeRu: "\U0001F9EC \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u043c\u044c\u044f
    \u0416\u0430\u043d-\u041f\u044c\u0435\u0440 \u0410\u043b\u044c\u0431\u0435\u0440 \u0410\u0445\u0438\u043b\u043b
    \u0421\u0435\u0440\u0440 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 15 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1926 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u0430\u0436
    (Bages) \u043d\u0430 \u044e\u0433\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0432
    \u0441\u0435\u043c\u044c\u0435 \u0444\u0430\u0440\u043c\u0430\u0446\u0435\u0432\u0442\u043e\u0432.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0416\u0430\u043d \u0421\u0435\u0440\u0440,
    \u0438 \u043c\u0430\u0442\u044c, \u0410\u0434\u0435\u043b\u044c \u0414\u0438\u0435\u0442,
    \u043e\u0431\u0430 \u0431\u044b\u043b\u0438 \u043f\u0440\u043e\u0432\u0438\u0437\u043e\u0440\u0430\u043c\u0438.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043c\u0430\u0442\u044c
    \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0441\u0430\u043c\u0430 \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0430\u0441\u044c \u0442\u043e\u0447\u043d\u044b\u043c\u0438
    \u043d\u0430\u0443\u043a\u0430\u043c\u0438: \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043a\u043e\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430 \u0444\u0430\u0440\u043c\u0430\u0446\u0438\u0438
    \u0432 \u041c\u043e\u043d\u043f\u0435\u043b\u044c\u0435, \u043e\u043d\u0430 \u0440\u0430\u0434\u0438
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430 \u043f\u0440\u043e\u0441\u043b\u0443\u0448\u0430\u043b\u0430
    \u043a\u0443\u0440\u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438 \u0441\u0434\u0430\u043b\u0430 \u044d\u043a\u0437\u0430\u043c\u0435\u043d.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0435\u0435 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438
    (\u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u0424\u0430\u0431\u0440\u0438 \u0438 \u0424\u043e\u0433\u0442\u0430)
    \u044e\u043d\u044b\u0439 \u0416\u0430\u043d-\u041f\u044c\u0435\u0440 \u043d\u0430\u0447\u0430\u043b
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0432 14-15 \u043b\u0435\u0442, \u043e\u0441\u0432\u0430\u0438\u0432\u0430\u044f
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435, \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b
    \u0438 \u0440\u044f\u0434\u044b \u0432 \u0447\u0438\u0441\u0442\u043e \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c,
    \"\u044d\u0439\u043b\u0435\u0440\u043e\u0432\u0441\u043a\u043e\u043c\" \u0441\u0442\u0438\u043b\u0435,
    \u0431\u0435\u0437 \u0441\u0442\u0440\u043e\u0433\u0438\u0445 \u044d\u043f\u0441\u0438\u043b\u043e\u043d-\u0434\u0435\u043b\u044c\u0442\u0430-\u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u043e\u043d \u0443\u0432\u043b\u0435\u043a\u0441\u044f
    \u0441 7-8 \u043b\u0435\u0442. \u0412 \u043b\u0438\u0446\u0435\u0435 \u0432 \u041d\u0438\u043c\u0435
    (Lyc\u00e9e Alphonse-Daudet) \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u0439
    \u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u043f\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0443 \"\u0411\u043e\u0440\u043e\u0434\u0430\"
    (Le Barbu), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b
    \u0421\u0435\u0440\u0440\u0430 \u043a \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0443 Concours G\u00e9n\u00e9ral, \u0433\u0434\u0435
    \u0442\u043e\u0442 \u0437\u0430\u043d\u044f\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u043c\u0435\u0441\u0442\u043e.\n\n\U0001F393
    \u0423\u0447\u0451\u0431\u0430, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0438 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438
    1945\u20131948: \u041f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0435 \u0438
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0412\u044b\u0441\u0448\u0435\u0439 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 (\u00c9cole Normale Sup\u00e9rieure). \u0412 19 \u043b\u0435\u0442
    \u043e\u043d \u0435\u0449\u0435 \u043d\u0435 \u0437\u043d\u0430\u043b, \u0447\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0435\u0439, \u0438
    \u0434\u0443\u043c\u0430\u043b \u0441\u0442\u0430\u0442\u044c \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043f\u043e\u043f\u0430\u0432 \u0432 ENS, \u043e\u043d \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438. 1948\u20131954:
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0432 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438 (CNRS). 1951: \u0417\u0430\u0449\u0438\u0442\u0430
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    (Ph.D.) \u0432 \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435 (\u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442) \u043f\u043e \u0442\u0435\u043c\u0435
    \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u041b\u0435\u0440\u0435\u2014\u0421\u0435\u0440\u0440\u0430. 1954\u20131956: \u0420\u0430\u0431\u043e\u0442\u0430
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u041d\u0430\u043d\u0441\u0438.
    1956\u20131994: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043a\u0430\u0444\u0435\u0434\u0440\u044b
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u043c \u041a\u043e\u043b\u043b\u0435\u0436
    \u0434\u0435 \u0424\u0440\u0430\u043d\u0441 (Coll\u00e8ge de France). \u041e\u043d \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b
    \u0441\u0432\u043e\u044e \u0438\u043d\u0430\u0443\u0433\u0443\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u043b\u0435\u043a\u0446\u0438\u044e \u043a\u0430\u043a \u0432\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442: \u0437\u0430 \u043c\u0435\u0441\u044f\u0446 \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0432\u0441\u0435\u0433\u043e \u043f\u043e\u043b\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b
    \u0438 \u0432 \u0438\u0442\u043e\u0433\u0435 \u0438\u043c\u043f\u0440\u043e\u0432\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b.
    \u0412 1994 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u0410\u043a\u0442\u0438\u0432\u043d\u043e
    \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u043b \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435
    \u0432\u0438\u0437\u0438\u0442\u044b \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u0438\u0439
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u0413\u0430\u0440\u0432\u0430\u0440\u0434,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0447\u0438\u0442\u0430\u043b \u043a\u0443\u0440\u0441\u044b
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445 \u043f\u043e
    \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443 \u2014 \u043e\u0442 \u0410\u043b\u0436\u0438\u0440\u0430
    \u0434\u043e \u0421\u0438\u043d\u0433\u0430\u043f\u0443\u0440\u0430 \u0438 \u041c\u043e\u0441\u043a\u0432\u044b.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c, \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0421\u0443\u043f\u0440\u0443\u0433\u0430: 10 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1948 \u0433\u043e\u0434\u0430 \u0421\u0435\u0440\u0440 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0416\u043e\u0437\u0438\u0430\u043d \u042d\u043b\u0451 (Josiane Heulot) (1922\u20132004).
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0445\u0438\u043c\u0438\u043a\u043e\u043c-\u043e\u0440\u0433\u0430\u043d\u0438\u043a\u043e\u043c,
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u0432 \u0412\u044b\u0441\u0448\u0435\u0439
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u0435
    \u0434\u043b\u044f \u0434\u0435\u0432\u0443\u0448\u0435\u043a \u0432 \u0421\u0435\u0432\u0440\u0435
    \u0438 \u0434\u0430\u0436\u0435 \u0431\u044b\u043b\u0430 \u0435\u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c.
    \u0421\u0430\u043c \u0421\u0435\u0440\u0440 \u0448\u0443\u0442\u0438\u043b, \u0447\u0442\u043e
    \u0432 \u044e\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043b\u0441\u044f
    \u0432 \u0445\u0438\u043c\u0438\u0438 \u0438\u0437-\u0437\u0430 \u0435\u0435 \"\u043f\u043e\u0447\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\" \u043f\u0440\u0438\u0440\u043e\u0434\u044b,
    \u043d\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0445\u0438\u043c\u0438\u043a\u0435. \u0414\u043e\u0447\u044c: 29 \u043d\u043e\u044f\u0431\u0440\u044f
    1949 \u0433\u043e\u0434\u0430 \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0434\u043e\u0447\u044c \u041a\u043b\u043e\u0434\u0438\u043d \u041c\u043e\u043d\u0442\u0435\u0439
    (Claudine Monteil). \u041e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c
    \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u043e\u043c, \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u0435\u043c
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u043c. \u041f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u043a:
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0414\u0435\u043d\u0438 \u0421\u0435\u0440\u0440
    \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0435\u043c\u0443 \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u043a\u043e\u043c.
    \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u0421\u0435\u0440\u0440 \u043b\u044e\u0431\u0438\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043e\u0442\u0434\u044b\u0445 \u2014 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0433\u043e\u0440\u043d\u044b\u043c\u0438 \u043b\u044b\u0436\u0430\u043c\u0438, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u044b\u043c
    \u0442\u0435\u043d\u043d\u0438\u0441\u043e\u043c \u0438 \u0441\u043a\u0430\u043b\u043e\u043b\u0430\u0437\u0430\u043d\u0438\u0435\u043c
    \u0432 \u0424\u043e\u043d\u0442\u0435\u043d\u0431\u043b\u043e.\n\n\U0001F91D \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0451\u043d\u044b\u043c\u0438
    \u042d\u0442\u043e \u043e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u044f\u0440\u043a\u0438\u0445 \u0441\u0442\u0440\u0430\u043d\u0438\u0446 \u0435\u0433\u043e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0421\u0435\u0440\u0440 \u0432\u0440\u0430\u0449\u0430\u043b\u0441\u044f
    \u0432 \u044d\u043f\u0438\u0446\u0435\u043d\u0442\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438 XX \u0432\u0435\u043a\u0430. \u0410\u043d\u0440\u0438 \u041a\u0430\u0440\u0442\u0430\u043d
    (\u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c):
    \u041a\u0430\u0440\u0442\u0430\u043d \u0431\u044b\u043b \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c,
    \u043d\u043e \u043e\u043d \u043d\u0435 \u0434\u0430\u0432\u0430\u043b \u0433\u043e\u0442\u043e\u0432\u044b\u0445
    \u0442\u0435\u043c \u0434\u043b\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u2014 \u0443\u0447\u0435\u043d\u0438\u043a\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u043b\u0438
    \u043d\u0430\u0439\u0442\u0438 \u0438\u0445 \u0441\u0430\u043c\u0438. \u0412 1948\u20131949
    \u0433\u043e\u0434\u0430\u0445 \u0421\u0435\u0440\u0440 \u043f\u043e\u0441\u0435\u0449\u0430\u043b
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440 \u041a\u0430\u0440\u0442\u0430\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0448\u043a\u043e\u043b\u043e\u0439
    \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430. \u0413\u0440\u0443\u043f\u043f\u0430
    \u0411\u0443\u0440\u0431\u0430\u043a\u0438 (Nicolas Bourbaki): \u0421\u0435\u0440\u0440
    \u0441\u0442\u0430\u043b \u0441\u0430\u043c\u044b\u043c \u043c\u043e\u043b\u043e\u0434\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c \u044d\u0442\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439
    \u0433\u0440\u0443\u043f\u043f\u044b \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432. \u041e\u043d \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043b\u0441\u044f
    \u043a \u043d\u0435\u0439 \u0432 \u043a\u043e\u043d\u0446\u0435 1940-\u0445, \u043a\u043e\u0433\u0434\u0430
    \u0442\u0430\u043c \u0443\u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u0410\u043d\u0440\u0438
    \u041a\u0430\u0440\u0442\u0430\u043d, \u041a\u043b\u043e\u0434 \u0428\u0435\u0432\u0430\u043b\u043b\u0435,
    \u0416\u0430\u043d \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435 \u0438 \u0410\u043d\u0434\u0440\u0435
    \u0412\u0435\u0439\u043b\u044c. \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    (\u0434\u0440\u0443\u0433, \u043a\u043e\u043b\u043b\u0435\u0433\u0430, \u043e\u043f\u043f\u043e\u043d\u0435\u043d\u0442):
    \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0435 \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0438 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f.
    \u041e\u043d\u0438 \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0438\u0441\u044c, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c\u0438. \u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    (\u043a\u043e\u043d\u0435\u0446 1950-\u0445 \u2013 \u043d\u0430\u0447\u0430\u043b\u043e
    1960-\u0445): \u0412\u043c\u0435\u0441\u0442\u0435 \u043e\u043d\u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0418\u0445 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 1955\u20131965 \u0433\u043e\u0434\u043e\u0432,
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c
    \u0442\u043e\u043c\u043e\u043c, \u2014 \u044d\u0442\u043e \u0436\u0438\u0432\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0421\u0435\u0440\u0440 \u043f\u0438\u0441\u0430\u043b \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0443
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u043e\u0442\u0447\u0435\u0442\u044b
    \u0441 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0438\u0437 \u0412\u0443\u0434\u0441-\u0425\u043e\u0443\u043b \u0432 1964 \u0433\u043e\u0434\u0443),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u043b\u0438
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430 \u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043e\u0442\u0438\u0432\u043e\u0432. \u0420\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435:
    \u041a \u043a\u043e\u043d\u0446\u0443 1960-\u0445 \u0438\u0445 \u043f\u043e\u0434\u0445\u043e\u0434\u044b
    \u0440\u0430\u0437\u043e\u0448\u043b\u0438\u0441\u044c. \u0421\u0435\u0440\u0440 \u0431\u044b\u043b
    \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0447\u0435\u043d,
    \u043b\u044e\u0431\u0438\u043b \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0438 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 (\"jolies
    choses\" \u2014 \"\u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u0432\u0435\u0449\u0438\"),
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435\u043c
    \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0445 \u043e\u0431\u0449\u0438\u0445
    \u0442\u0435\u043e\u0440\u0438\u0439. \u0413\u043e\u0440\u044c\u043a\u0438\u0439 \u0444\u0438\u043d\u0430\u043b
    (1980-\u0435): \u041f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043a\u0430\u043a
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u0438\u0440
    \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u044e \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \"R\u00e9coltes et Semailles\" (\"\u0423\u0440\u043e\u0436\u0430\u0439
    \u0438 \u043f\u043e\u0441\u0435\u0432\"), \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b
    \u0435\u0435 \u0431\u044b\u0432\u0448\u0438\u043c \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c.
    \u0421\u0435\u0440\u0440 \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0445, \u043a\u0442\u043e \u043e\u0442\u0432\u0435\u0442\u0438\u043b.
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0443\u043f\u0440\u0435\u043a\u043d\u0443\u043b
    \u0421\u0435\u0440\u0440\u0430 \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u0442\u043e\u0442
    \"\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0435 \u0432\u0435\u0449\u0438\" \u0438 \"\u0441
    \u0443\u0436\u0430\u0441\u043e\u043c \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f
    \u043a \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u043c\u0443 \u0441\u0430\u043c\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0443\".
    \u0418\u0445 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 \u0432 \u0442\u0435
    \u0433\u043e\u0434\u044b \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c
    \u043c\u043e\u0441\u0442\u0438\u043a\u043e\u043c \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f
    \u0433\u0438\u0433\u0430\u043d\u0442\u0430\u043c\u0438. \u0410\u043d\u0434\u0440\u0435 \u0412\u0435\u0439\u043b\u044c
    \u0438 \u041f\u044c\u0435\u0440 \u0414\u0435\u043b\u0438\u043d\u044c: \u0421\u0435\u0440\u0440
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b
    \u0441 \u0412\u0435\u0439\u043b\u0435\u043c, \u0430 \u043f\u043e\u0437\u0436\u0435 \u2014
    \u0441 \u041f\u044c\u0435\u0440\u043e\u043c \u0414\u0435\u043b\u0438\u043d\u0435\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437
    \u0412\u0435\u0439\u043b\u044f, \u043e\u043f\u0438\u0440\u0430\u044f\u0441\u044c \u0432
    \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043d\u0430 \u0438\u0434\u0435\u0438
    \u0421\u0435\u0440\u0440\u0430. \u041e\u043d \u0431\u044b\u043b \u0434\u043b\u044f \u043d\u0438\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c \u0438\u0434\u0435\u0439 \u0438
    \u0441\u0442\u0440\u043e\u0433\u0438\u043c \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u043c.
    \u0421\u0435\u0440\u0440 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442
    \u043a \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445,
    \u043e\u043d \u0431\u044b\u043b \u043b\u0438\u0448\u0435\u043d \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043d\u043e\u0431\u0438\u0437\u043c\u0430: \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e\u043d \u0441 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435\u043c
    \u0438 \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0440\u0435\u0430\u0433\u0438\u0440\u043e\u0432\u0430\u043b
    \u043d\u0430 \u0438\u0437\u044f\u0449\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0434\u0430\u0436\u0435 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0439 \u043b\u0435\u043c\u043c\u044b,
    \u0435\u0441\u043b\u0438 \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0439."
  personalLifeEn: 
  shortBioRu: "\u0416\u0430\u043d-\u041f\u044c\u0435\u0440 \u0421\u0435\u0440\u0440 (\u0440. 1926) \u2014
    \u0433\u0435\u043d\u0438\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u041e\u0431\u0449\u0438\u0435
    \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f: \u0414\u0430\u0442\u0430 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f:
    15 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1926 \u0433\u043e\u0434\u0430. \u041c\u0435\u0441\u0442\u043e
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f: \u0411\u0430\u0436 (\u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442
    \u0412\u043e\u0441\u0442\u043e\u0447\u043d\u044b\u0435 \u041f\u0438\u0440\u0435\u043d\u0435\u0438),
    \u0424\u0440\u0430\u043d\u0446\u0438\u044f. \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e:
    \u0424\u0440\u0430\u043d\u0446\u0438\u044f. \u0421\u0444\u0435\u0440\u0430 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0410\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f,
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f,
    \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b, \u0442\u0435\u043e\u0440\u0438\u044f
    \u0433\u0440\u0443\u043f\u043f. \u0421\u0442\u0430\u0442\u0443\u0441: \u041e\u0434\u0438\u043d
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0438 XXI \u0432\u0435\u043a\u043e\u0432,
    \u043e\u0431\u043b\u0430\u0434\u0430\u0442\u0435\u043b\u044c \u0432\u0441\u0435\u0445 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043c\u0438\u0439
    (\u043a\u0440\u043e\u043c\u0435 \u043f\u0440\u0435\u043c\u0438\u0438 \u0410\u0431\u0435\u043b\u044f,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0435\u0440\u0432\u044b\u043c \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0432
    2003 \u0433\u043e\u0434\u0443). --- 1. \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 (1926\u20131945) \u0416\u0430\u043d-\u041f\u044c\u0435\u0440
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0441\u0435\u043c\u044c\u0435 \u0444\u0430\u0440\u043c\u0430\u0446\u0435\u0432\u0442\u043e\u0432.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0416\u0430\u043d \u0421\u0435\u0440\u0440,
    \u0431\u044b\u043b \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u043e\u043c \u041f\u0435\u0440\u0432\u043e\u0439
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b (\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d
    \u0412\u043e\u0435\u043d\u043d\u044b\u043c \u043a\u0440\u0435\u0441\u0442\u043e\u043c),
    \u0447\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    14 \u043b\u0435\u0442 (\u0432 1940 \u0433\u043e\u0434\u0443), \u043a\u043e\u0433\u0434\u0430
    \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u0430\u044f \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f
    \u043e\u043a\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043b\u0430 \u0424\u0440\u0430\u043d\u0446\u0438\u044e,
    \u0441\u0435\u043c\u044c\u044f \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u043d\u0430
    \u044e\u0433 \u0432 \u041c\u043e\u043d\u043f\u0435\u043b\u044c\u0435, \u0447\u0442\u043e\u0431\u044b
    \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (\u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u043e\u043d\u0438 \u043d\u0435 \u0431\u044b\u043b\u0438 \u0435\u0432\u0440\u0435\u044f\u043c\u0438,
    \u0436\u0438\u0437\u043d\u044c \u0432 \u043e\u043a\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0437\u043e\u043d\u0435 \u0431\u044b\u043b\u0430 \u043e\u043f\u0430\u0441\u043d\u043e\u0439).
    \u0412 \u041c\u043e\u043d\u043f\u0435\u043b\u044c\u0435 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u043b\u0438\u0446\u0435\u0439, \u0433\u0434\u0435 \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c. \u0412 1944 \u0433\u043e\u0434\u0443, \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 17 \u043b\u0435\u0442, \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041f\u0430\u0440\u0438\u0436, \u0447\u0442\u043e\u0431\u044b \u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c\u0441\u044f
    \u043a \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044e \u0432 \u0441\u0430\u043c\u0443\u044e
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e \u044d\u043b\u0438\u0442\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u2014 \u0412\u044b\u0441\u0448\u0443\u044e
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443
    (\u00c9cole Normale Sup\u00e9rieure) \u043d\u0430 \u0443\u043b\u0438\u0446\u0435 \u0423\u043b\u044c\u043c.
    \u0412 1945 \u0433\u043e\u0434\u0443 \u043e\u043d \u0443\u0441\u043f\u0435\u0448\u043d\u043e
    \u0441\u0434\u0430\u0435\u0442 \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u044b \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442
    \u043f\u0435\u0440\u0432\u043e\u0435 \u043c\u0435\u0441\u0442\u043e, \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u044f
    \u0432 ENS. 2. \u0420\u0430\u043d\u043d\u044f\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f (1945\u20131951) \u0412 \u0412\u044b\u0441\u0448\u0435\u0439
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u0435
    \u0421\u0435\u0440\u0440 \u043f\u043e\u043f\u0430\u043b \u043f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u0410\u043d\u0440\u0438 \u041a\u0430\u0440\u0442\u0430\u043d\u0430 \u2014 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438.
    \u041a\u0430\u0440\u0442\u0430\u043d \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e
    \u043e\u0434\u0430\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0421\u0435\u0440\u0440\u0430
    \u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c. \u0412
    1948 \u0433\u043e\u0434\u0443 \u0421\u0435\u0440\u0440 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
    \u0434\u0438\u043f\u043b\u043e\u043c\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443.
    \u0412 1949 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442
    \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043e \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044f\u0445.
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 23 \u043b\u0435\u0442 \u043e\u043d
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c
    \u0432 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u0446\u0435\u043d\u0442\u0440\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438 (CNRS). \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u043f\u0440\u043e\u0440\u044b\u0432 (1950): \u0421\u0435\u0440\u0440 \u043f\u0438\u0448\u0435\u0442
    \u0441\u0432\u043e\u044e \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043d\u0430 \u0442\u0435\u043c\u0443 \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0433\u0440\u0443\u043f\u043f \u0441\u0444\u0435\u0440. \u041e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442
    \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0421\u0435\u0440\u0440\u0430 (\u043d\u044b\u043d\u0435 \u043d\u043e\u0441\u044f\u0449\u0438\u0435
    \u0435\u0433\u043e \u0438\u043c\u044f) \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f.
    \u0414\u043e \u043d\u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043d\u0435 \u0437\u043d\u0430\u043b\u0438, \u043a\u0430\u043a \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c
    \u044d\u0442\u0438 \u0433\u0440\u0443\u043f\u043f\u044b \u0434\u0430\u0436\u0435 \u0434\u043b\u044f
    \u043f\u0440\u043e\u0441\u0442\u0435\u0439\u0448\u0438\u0445 \u0441\u0444\u0435\u0440, \u0430
    \u0421\u0435\u0440\u0440 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434\u044b,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u0435 \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c.
    \u0412 1951 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0441\u0442\u0435\u043f\u0435\u043d\u044c.
    3. \u041f\u0435\u0440\u0435\u0445\u043e\u0434 \u043a \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 (1952\u20131955) \u041f\u043e\u0441\u043b\u0435
    \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u0421\u0435\u0440\u0440 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e \u043c\u0435\u043d\u044f\u0435\u0442
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435. \u041e\u043d \u0440\u0435\u0448\u0430\u0435\u0442
    \u0437\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439 (\u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435\u043c
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432,
    \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u0430\u043c\u0438).
    \u0412 1955 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442
    \u0441\u0432\u043e\u044e \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u0443\u044e
    \u0441\u0442\u0430\u0442\u044c\u044e \u00abFaisceaux alg\u00e9briques coh\u00e9rents\u00bb
    (\u0410\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u0433\u0435\u0440\u0435\u043d\u0442\u043d\u044b\u0435
    \u043f\u0443\u0447\u043a\u0438). \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u043d \u0434\u0435\u043b\u0430\u0435\u0442 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u043e\u0440\u044b\u0432: \u041e\u043d \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442
    \u043c\u0435\u0442\u043e\u0434\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u0443\u0447\u043a\u043e\u0432
    (\u0438\u0437 \u0430\u043d\u0430\u043b\u0438\u0437\u0430) \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e. \u041e\u043d \u0432\u0432\u043e\u0434\u0438\u0442
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0439
    \u043f\u0443\u0447\u043a\u043e\u0432 \u0434\u043b\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439. \u041e\u043d \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u0443\u0435\u0442
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    (\u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0421\u0435\u0440\u0440\u0430 \u043e\u0431
    \u0430\u0444\u0444\u0438\u043d\u043d\u043e\u0441\u0442\u0438), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0442\u043e\u0447\u043d\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u043a\u043e\u043b\u044c\u0446\u0430
    \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u043e\u0432 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b\u0430
    \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u0440\u0438\u0435\u0445\u0430\u043b \u0432 \u041f\u0430\u0440\u0438\u0436
    \u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0421\u0435\u0440\u0440\u043e\u043c
    \u0441\u043e\u0437\u0434\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 (\u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u044b
    \u0421\u0435\u0440\u0440\u0430-\u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430).
    4. \u0420\u0430\u0431\u043e\u0442\u0430 \u0441 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c
    \u0438 \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    (1956\u20131969) \u0412 \u043a\u043e\u043d\u0446\u0435 1950-\u0445 \u0421\u0435\u0440\u0440
    \u0438 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f
    \u043d\u0435\u0440\u0430\u0437\u043b\u0443\u0447\u043d\u044b. \u041e\u043d\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442
    \u043d\u0430\u0434 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c \u043e\u0441\u043d\u043e\u0432
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u0445\u0435\u043c (\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u0440\u0435\u0448\u0430\u0442\u044c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u043f\u043e\u043b\u044f\u0445). \u041e\u0434\u043d\u0430\u043a\u043e \u043c\u0435\u0436\u0434\u0443
    \u043d\u0438\u043c\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0435: \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0431\u044b\u043b \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u0438\u0441\u0442\u043e\u043c:
    \u043e\u043d \u0445\u043e\u0442\u0435\u043b \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0441\u0430\u043c\u0443\u044e \u043e\u0431\u0449\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e,
    \u0440\u0435\u0448\u0430\u044e\u0449\u0443\u044e \u0432\u0441\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0441\u0440\u0430\u0437\u0443, \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430
    \u0443\u0440\u043e\u0432\u043d\u0435 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0445
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0439. \u0421\u0435\u0440\u0440 \u0431\u044b\u043b
    \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u043c: \u043e\u043d \u0432\u0435\u0440\u0438\u043b
    \u0432 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0438 \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u044b\u0435 \u043f\u0440\u0438\u043c\u0435\u0440\u044b.
    \u041a \u043a\u043e\u043d\u0446\u0443 1960-\u0445 \u0433\u043e\u0434\u043e\u0432 \u0438\u0445
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0443\u0442\u0438 \u0440\u0430\u0437\u043e\u0448\u043b\u0438\u0441\u044c.
    \u0421\u0435\u0440\u0440 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442
    \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0435
    Grothendieck's EGA (\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438), \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u0432,
    \u0447\u0442\u043e \u044d\u0442\u043e \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043e\u0442\u043e\u0440\u0432\u0430\u043d\u043e
    \u043e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u041e\u043d
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f \u043d\u0430 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b. 5. \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b
    \u0438 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b
    (1970\u20131980-\u0435) \u0412 1970-\u0445 \u0421\u0435\u0440\u0440 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0444\u0438\u0433\u0443\u0440 \u0432 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435\u043c \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0440\u0438\u0432\u044b\u0445 \u0438 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c. \u0413\u043b\u0430\u0432\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u044d\u0442\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430: \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438 (\u0432
    \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u0441\u0442\u0432\u0435 \u0441 \u041f\u044c\u0435\u0440\u043e\u043c
    \u0414\u0435\u043b\u0438\u043d\u0435\u043c): \u041e\u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0438,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0435
    \u0444\u043e\u0440\u043c\u044b \u043c\u043e\u0436\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u0442\u044c
    \u0441 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438
    \u0413\u0430\u043b\u0443\u0430. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0424\u0435\u0440\u043c\u0430
    \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441\u043e\u043c (1994), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0421\u0435\u0440\u0440\u0430 \u0438 \u0414\u0435\u043b\u0438\u043d\u044f. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u0421\u0435\u0440\u0440\u0430 \u043e \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438
    (1975): \u041e\u043d \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0432\u0441\u0435 \u0434\u0432\u0443\u043c\u0435\u0440\u043d\u044b\u0435
    \u043d\u0435\u0447\u0435\u0442\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0413\u0430\u043b\u0443\u0430 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u044f\u0442
    \u0438\u0437 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c.
    \u042d\u0442\u0430 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0431\u044b\u043b\u0430
    \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 2000-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043b\u0435\u0433\u043b\u0430 \u0432
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0424\u0435\u0440\u043c\u0430. 6. \u041f\u0440\u0435\u043c\u0438\u0438
    \u0438 \u043c\u0438\u0440\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0416\u0430\u043d-\u041f\u044c\u0435\u0440 \u0421\u0435\u0440\u0440 \u2014 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438,
    \u043f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0438\u0439 \u0442\u0440\u0438 \u0441\u0430\u043c\u044b\u0435
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    (\u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u044f \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043c\u0435\u0434\u0430\u043b\u0438): \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f
    \u043c\u0435\u0434\u0430\u043b\u044c (1954) \u2014 \u043d\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u043c
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 \u0410\u043c\u0441\u0442\u0435\u0440\u0434\u0430\u043c\u0435. \u041d\u0430 \u043c\u043e\u043c\u0435\u043d\u0442
    \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0435\u043c\u0443 \u0431\u044b\u043b\u043e
    27 \u043b\u0435\u0442, \u043e\u043d \u0431\u044b\u043b \u0441\u0430\u043c\u044b\u043c \u043c\u043e\u043b\u043e\u0434\u044b\u043c
    \u043d\u0430 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c.
    \u041f\u0440\u0435\u043c\u0438\u044f \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430 (1985)
    \u2014 \u0437\u0430 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041f\u0440\u0435\u043c\u0438\u044f
    \u0421\u0442\u0438\u043b\u0430 (1995) \u2014 \u0437\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041f\u0440\u0435\u043c\u0438\u044f \u0412\u043e\u043b\u044c\u0444\u0430 (2000) \u2014
    \u0437\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0438 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b. \u041f\u0440\u0435\u043c\u0438\u044f \u0410\u0431\u0435\u043b\u044f
    (2003) \u2014 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c
    \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c \u044d\u0442\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    (\u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0430
    \u0432 2002 \u0433\u043e\u0434\u0443). \u041d\u0430\u0433\u0440\u0430\u0436\u0434\u0451\u043d
    \"\u0437\u0430 \u0435\u0433\u043e \u0440\u043e\u043b\u044c \u0432 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043e\u0431\u043b\u0438\u043a\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\". 7. \u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043f\u043e\u0437\u0438\u0446\u0438\u044f \u0438 \u043f\u0430\u0446\u0438\u0444\u0438\u0437\u043c
    \u0421\u0435\u0440\u0440 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u043b \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d\u043e\u043c. \u0412 1960-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u043f\u0440\u043e\u0442\u0438\u0432 \u0432\u043e\u0439\u043d\u044b \u0432 \u0410\u043b\u0436\u0438\u0440\u0435
    (\u043e\u043d \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \"\u041c\u0430\u043d\u0438\u0444\u0435\u0441\u0442 121\" \u2014 \u043f\u0440\u0438\u0437\u044b\u0432
    \u043a \u043d\u0435\u043f\u043e\u0432\u0438\u043d\u043e\u0432\u0435\u043d\u0438\u044e \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u0430\u043b\u0436\u0438\u0440\u0441\u043a\u043e\u0439 \u0432\u043e\u0439\u043d\u044b).
    \u0412 1968 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0445
    \u0432\u043e\u043b\u043d\u0435\u043d\u0438\u0439 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u043e\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043b \u0440\u0435\u0444\u043e\u0440\u043c\u044b
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u043e\u0432, \u0442\u0440\u0435\u0431\u0443\u044f
    \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f.
    8. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b (1980\u2013\u043d.\u0432.)
    \u0421 1980-\u0445 \u0433\u043e\u0434\u043e\u0432 \u0421\u0435\u0440\u0440 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c\u0441\u044f.
    \u0415\u0433\u043e \u0441\u0442\u0438\u043b\u044c \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u044d\u0442\u0430\u043b\u043e\u043d\u043d\u044b\u043c:
    \u043e\u043d \u043f\u0438\u0448\u0435\u0442 \u043a\u043e\u0440\u043e\u0442\u043a\u043e,
    \u044f\u0441\u043d\u043e, \u0438\u0437\u044f\u0449\u043d\u043e, \u0447\u0430\u0441\u0442\u043e
    \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u044f\u0441\u044c \u043e\u0442 \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u0445
    \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439. \u0414\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440 (\u0435\u043c\u0443 \u0443\u0436\u0435 \u043f\u043e\u0434 100 \u043b\u0435\u0442)
    \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u0430\u0445
    \u0432 \u041a\u043e\u043b\u043b\u0435\u0436 \u0434\u0435 \u0424\u0440\u0430\u043d\u0441
    (\u0433\u0434\u0435 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0441 1956 \u043f\u043e 1994 \u0433\u043e\u0434) \u0438 \u0432\u0435\u0434\u0435\u0442
    \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441 \u043c\u043e\u043b\u043e\u0434\u044b\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438
    \u0441\u043e \u0432\u0441\u0435\u0433\u043e \u043c\u0438\u0440\u0430. \u0412 2012 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043a\u043d\u0438\u0433\u0443
    \"Topics in Galois Theory\" (\u0422\u0435\u043c\u044b \u0442\u0435\u043e\u0440\u0438\u0438
    \u0413\u0430\u043b\u0443\u0430), \u0433\u0434\u0435 \u043f\u043e\u0434\u0432\u0435\u043b
    \u0438\u0442\u043e\u0433\u0438 \u0441\u0432\u043e\u0438\u0445 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c: \u0416\u0435\u043d\u0430\u0442 (\u0441 1952 \u0433\u043e\u0434\u0430)
    \u043d\u0430 \u0416\u043e\u0437\u0435\u0442\u0442 \u0421\u0435\u0440\u0440, \u0443 \u043d\u0438\u0445
    \u0435\u0441\u0442\u044c \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439. \u041e\u043d
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430 \u0438 \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c\u044e.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0441\u043b\u0430\u0432\u0443, \u043e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u043a \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0430\u043d-\u041f\u044c\u0435\u0440 \u0421\u0435\u0440\u0440 \u2014 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f,
    \u043d\u043e \u0438 \u0432\u0435\u0441\u044c\u043c\u0430 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f.
    \u0417\u0430 \u0441\u0442\u0440\u043e\u0433\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u043b\u0430\u0432\u043e\u0439 \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441 \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u043c
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c \u044e\u043c\u043e\u0440\u0430, \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u043c\u0438 \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u043b\u044f \u0433\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u043e\u0439.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u044f\u0440\u043a\u0438\u0435 \u0438
    \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b \u0438\u0437
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F4DD \u0414\u0435\u0442\u0441\u0442\u0432\u043e:
    \u043a\u0430\u043a \u0441\u0442\u0430\u0442\u044c \u0433\u0435\u043d\u0438\u0435\u043c,
    \u0441\u043f\u0430\u0441\u0430\u044f\u0441\u044c \u043e\u0442 \u0445\u0443\u043b\u0438\u0433\u0430\u043d\u043e\u0432
    \u0421\u0432\u043e\u0439 \u043f\u0443\u0442\u044c \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0421\u0435\u0440\u0440 \u043d\u0430\u0447\u0430\u043b \u043d\u0435 \u0441 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u0438\u044f, \u0430 \u0441 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438. \u0428\u043a\u043e\u043b\u044c\u043d\u044b\u0439
    \"\u0440\u0435\u043f\u0435\u0442\u0438\u0442\u043e\u0440\" \u0434\u043b\u044f \u0441\u0442\u0430\u0440\u0448\u0438\u0445:
    \u0412 \u043f\u0430\u043d\u0441\u0438\u043e\u043d\u0435 \u0432 \u041d\u0438\u043c\u0435
    \u0435\u0433\u043e, \u043c\u043b\u0430\u0434\u0448\u0435\u0433\u043e, \u043e\u0431\u0438\u0436\u0430\u043b\u0438
    \u0441\u0442\u0430\u0440\u0448\u0438\u0435 \u043c\u0430\u043b\u044c\u0447\u0438\u0448\u043a\u0438.
    \u0427\u0442\u043e\u0431\u044b \u0438\u0445 \u0443\u0442\u0438\u0445\u043e\u043c\u0438\u0440\u0438\u0442\u044c,
    \u0421\u0435\u0440\u0440 \u043d\u0430\u0447\u0430\u043b \u0434\u0435\u043b\u0430\u0442\u044c
    \u0437\u0430 \u043d\u0438\u0445 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041f\u043e\u0437\u0436\u0435
    \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b \u044d\u0442\u043e \u043b\u0443\u0447\u0448\u0435\u0439
    \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u043e\u0439. \u0423\u0440\u043e\u043a\u0438
    \u043e\u0442 \u043c\u0430\u043c\u044b-\u0444\u0430\u0440\u043c\u0430\u0446\u0435\u0432\u0442\u0430:
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c, \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043a\u043e\u0439
    \u0444\u0430\u0440\u043c\u0430\u0446\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430, \u0440\u0430\u0434\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430
    \u043f\u0440\u043e\u0441\u043b\u0443\u0448\u0430\u043b\u0430 \u043a\u0443\u0440\u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0423\u0447\u0435\u0431\u043d\u0438\u043a\u0438,
    \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043e\u043d\u0430 \u0443\u0447\u0438\u043b\u0430\u0441\u044c,
    \u043e\u043d\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430, \u0438 \u0432
    14-15 \u043b\u0435\u0442 \u0416\u0430\u043d-\u041f\u044c\u0435\u0440 \u043d\u0430\u0447\u0430\u043b
    \u0438\u0445 \u0438\u0437\u0443\u0447\u0430\u0442\u044c, \u043e\u0441\u0432\u043e\u0438\u0432
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b
    \u0432 \"\u044d\u0439\u043b\u0435\u0440\u043e\u0432\u0441\u043a\u043e\u043c\" \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c
    \u0441\u0442\u0438\u043b\u0435 (\u0431\u0435\u0437 \u0441\u0442\u0440\u043e\u0433\u0438\u0445
    \u044d\u043f\u0441\u0438\u043b\u043e\u043d-\u0434\u0435\u043b\u044c\u0442\u0430-\u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439).
    \u041f\u0440\u043e\u0432\u0430\u043b \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u0435:
    \u0412 1944 \u0433\u043e\u0434\u0443 \u043e\u043d \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0435
    \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435. \u0417\u0430\u0434\u0430\u043d\u0438\u0435
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e \u0437\u043d\u0430\u043d\u0438\u044f
    \u0437\u0430\u043a\u043e\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d
    \u043d\u0435 \u0437\u043d\u0430\u043b. \u0420\u0435\u0448\u0438\u0432, \u0447\u0442\u043e
    \u0438\u0437 \u0432\u0441\u0435\u0445 \u0444\u043e\u0440\u043c\u0443\u043b \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442
    \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u043d\u0430, \u043e\u043d 6 \u0447\u0430\u0441\u043e\u0432
    \u0440\u0435\u0448\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0443 \u043d\u0430 \u0435\u0435
    \u043e\u0441\u043d\u043e\u0432\u0435, \u0431\u044b\u043b \u0443\u0432\u0435\u0440\u0435\u043d
    \u0432 \u043f\u043e\u0431\u0435\u0434\u0435... \u043d\u043e \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u043d\u0435\u0432\u0435\u0440\u043d\u043e\u0439,
    \u0438 \u043e\u043d \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043d\u0438\u0447\u0435\u0433\u043e.\n\n\U0001F4A1
    \u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441: \u0433\u0440\u044f\u0437\u043d\u0430\u044f
    \u043f\u043e\u0441\u0443\u0434\u0430 \u0438 \u043f\u043e\u043b\u0443\u043d\u043e\u0447\u043d\u044b\u0435
    \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u044f \u0421\u0435\u0440\u0440 \u043c\u044b\u0441\u043b\u0438\u0442
    \u0441\u043e\u0432\u0441\u0435\u043c \u043d\u0435 \u0442\u0430\u043a, \u043a\u0430\u043a
    \u043e\u0431\u044b\u0447\u043d\u044b\u0435 \u043b\u044e\u0434\u0438, \u0430 \u0435\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u044b \"\u0440\u0430\u0431\u043e\u0442\u044b\" \u043c\u043e\u0433\u0443\u0442
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f \u0432\u0435\u0441\u044c\u043c\u0430
    \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u043c\u0438. \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u2014 \u043a\u0443\u0445\u043e\u043d\u043d\u0430\u044f
    \u0440\u0430\u043a\u043e\u0432\u0438\u043d\u0430: \u0421\u0435\u0440\u0440 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u043c\u044b\u0442\u044c\u0435 \u043f\u043e\u0441\u0443\u0434\u044b \u2014
    \u044d\u0442\u043e \u043e\u0442\u043b\u0438\u0447\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0434\u043b\u044f \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439 \u043d\u0430\u0434
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043b \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0433\u043e\u0442\u043e\u0432\u043a\u043e\u0439, \u043a\u0430\u043a \"\u043b\u0435\u0433\u043a\u0438\u043c
    \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0438\u043c\u0441\u044f\"
    \u0434\u0435\u043b\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0445\u043e\u0440\u043e\u0448\u043e
    \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0430\u0435\u0442 \u043c\u043e\u0437\u0433
    \u0434\u043b\u044f \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043c\u044b\u0441\u043b\u0435\u0439.
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0432 \u043f\u043e\u043b\u0443\u0441\u043d\u0435:
    \u041e\u043d \u0447\u0430\u0441\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043f\u043e
    \u043d\u043e\u0447\u0430\u043c, \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438
    \"\u043f\u043e\u043b\u0443\u0441\u043d\u0430\", \u043a\u043e\u0433\u0434\u0430 \u043d\u0435
    \u043d\u0443\u0436\u043d\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c.
    \u042d\u0442\u043e, \u043f\u043e \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c,
    \u0434\u0430\u0435\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u043b\u0443\u0447\u0448\u0435 \u0441\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u0438 \u043b\u0435\u0433\u0447\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f
    \u043c\u0435\u0436\u0434\u0443 \u0442\u0435\u043c\u0430\u043c\u0438. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0432 \u043a\u0438\u043d\u043e\u0442\u0435\u0430\u0442\u0440\u0435: \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0441\u0435\u0430\u043d\u0441\u043e\u0432 \u0432 \u043a\u0438\u043d\u043e, \u0432 \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u0430\u0445
    \u043c\u0435\u0436\u0434\u0443 \u0440\u0435\u043a\u043b\u0430\u043c\u043d\u044b\u043c\u0438
    \u0440\u043e\u043b\u0438\u043a\u0430\u043c\u0438, \u0421\u0435\u0440\u0440 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b
    \u0433\u043b\u0430\u0437\u0430 \u0438 \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u043b\u0441\u044f
    \u0432 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u043e \u0441\u0432\u043e\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447\u0430\u0445.\n\n\U0001F3AD \"\u0421\u0435\u0440\u0440 1,
    \u0413\u0430\u0431\u0435\u0440 0\": \u044e\u043c\u043e\u0440 \u0438 \u0434\u0443\u0445 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0421\u0435\u0440\u0440 \u2014 \u043d\u0435 \u0441\u0443\u0445\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a.
    \u041d\u0430 \u0441\u0432\u043e\u0438\u0445 \u043b\u0435\u043a\u0446\u0438\u044f\u0445 \u0432
    \u041a\u043e\u043b\u043b\u0435\u0436 \u0434\u0435 \u0424\u0440\u0430\u043d\u0441 \u043e\u043d
    \u043b\u044e\u0431\u0438\u043b \u0437\u0430\u0442\u0435\u0432\u0430\u0442\u044c \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u0433\u0440\u044b \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u044f\u043c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0430\u043c\u0438 \u0431\u044b\u043b\u0438
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438.
    \u0421\u0447\u0435\u0442 \u043d\u0430 \u0434\u043e\u0441\u043a\u0435: \u041d\u0430 \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u0430\u0445
    \u0421\u0435\u0440\u0440 \u043c\u043e\u0433 \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u043d\u0430 \u0434\u043e\u0441\u043a\u0435 \"Serre 1, Gaber 0\", \u0435\u0441\u043b\u0438
    \u0435\u043c\u0443 \u0443\u0434\u0430\u0432\u0430\u043b\u043e\u0441\u044c \"\u043f\u043e\u0439\u043c\u0430\u0442\u044c\"
    \u0441\u0432\u043e\u0435\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u043e\u0433\u043e \u043e\u043f\u043f\u043e\u043d\u0435\u043d\u0442\u0430
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0441\u043f\u043e\u0440\u0435. \u041e\u043d \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435
    \u0440\u0430\u0434\u043e\u0432\u0430\u043b\u0441\u044f \u0442\u0430\u043a\u0438\u043c \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c
    \u043f\u043e\u0431\u0435\u0434\u0430\u043c. \u0418\u043d\u0430\u0443\u0433\u0443\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u043b\u0435\u043a\u0446\u0438\u044f \u0431\u0435\u0437 \u0442\u0435\u043a\u0441\u0442\u0430:
    \u041a\u043e\u0433\u0434\u0430 \u0432 1956 \u0433\u043e\u0434\u0443 \u0421\u0435\u0440\u0440
    \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041a\u043e\u043b\u043b\u0435\u0436 \u0434\u0435 \u0424\u0440\u0430\u043d\u0441, \u043e\u043d
    \u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e
    \u043b\u0435\u043a\u0446\u0438\u044e \u0446\u0435\u043b\u044b\u0439 \u043c\u0435\u0441\u044f\u0446,
    \u043d\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0432\u0441\u0435\u0433\u043e \u043f\u043e\u043b\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b.
    \u0412 \u0438\u0442\u043e\u0433\u0435 \u043e\u043d \u0437\u0430\u0447\u0438\u0442\u0430\u043b
    \u044d\u0442\u043e\u0442 \u043e\u0442\u0440\u044b\u0432\u043e\u043a, \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u2014 \u043f\u0440\u043e\u0438\u043c\u043f\u0440\u043e\u0432\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b.
    \u041f\u043e\u0437\u0436\u0435, \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b\u0438
    \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0442\u0435\u043a\u0441\u0442
    \u0434\u043b\u044f \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438, \u043e\u043d
    \u043d\u0430\u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u044e
    \u043d\u0430 \u043f\u043b\u0435\u043d\u043a\u0443, \u043d\u043e \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044c
    \u0441\u043a\u0430\u0437\u0430\u043b\u0430, \u0447\u0442\u043e \u0437\u0430\u043f\u0438\u0441\u044c
    \u043d\u0435\u0440\u0430\u0437\u0431\u043e\u0440\u0447\u0438\u0432\u0430. \u0412 \u0438\u0442\u043e\u0433\u0435
    \u0435\u0433\u043e \u0438\u043d\u0430\u0443\u0433\u0443\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u043b\u0435\u043a\u0446\u0438\u044f \u0442\u0430\u043a \u0438 \u043d\u0435 \u0431\u044b\u043b\u0430
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430 \u2014 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u041a\u043e\u043b\u043b\u0435\u0436
    \u0434\u0435 \u0424\u0440\u0430\u043d\u0441.\n\n\U0001F3C6 \u0420\u0435\u043a\u043e\u0440\u0434\u044b
    \u0438 \u043f\u043e\u0447\u0442\u0438 \"\u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0430\u044f\"
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0421\u0430\u043c\u044b\u0439 \u043c\u043e\u043b\u043e\u0434\u043e\u0439
    \u0444\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0438\u0439 \u043b\u0430\u0443\u0440\u0435\u0430\u0442:
    \u0412 1954 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 27 \u043b\u0435\u0442, \u0438 \u044d\u0442\u043e\u0442
    \u0440\u0435\u043a\u043e\u0440\u0434 \u043d\u0435 \u043f\u043e\u0431\u0438\u0442 \u0434\u043e
    \u0441\u0438\u0445 \u043f\u043e\u0440. \u041f\u0435\u0440\u0432\u044b\u0439 \u043b\u0430\u0443\u0440\u0435\u0430\u0442
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438:
    \u0412 2003 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u043c \u044d\u0442\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0430 \u043a\u0430\u043a \u0430\u043d\u0430\u043b\u043e\u0433
    \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439. \"\u041e\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0435\"
    \u043e\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u042d\u043d\u0434\u0440\u044e
    \u0423\u0430\u0439\u043b\u0441\u0430 \u043d\u0430\u0434 \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u043e\u0439 \u0424\u0435\u0440\u043c\u0430, \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u0435\u043c\u0443 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438, \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c,
    \u0447\u0442\u043e \u0421\u0435\u0440\u0440, \u0441 \u0435\u0433\u043e \u043c\u043e\u043b\u043d\u0438\u0435\u043d\u043e\u0441\u043d\u043e\u0439
    \u0440\u0435\u0430\u043a\u0446\u0438\u0435\u0439, \u0440\u0435\u0448\u0438\u0442 \u0437\u0430\u0434\u0430\u0447\u0443
    \u043f\u0435\u0440\u0432\u044b\u043c.\n\n\U0001F607 \"\u041e\u0434\u043d\u043e\u0433\u043e
    \u0411\u043e\u0433\u0430 \u043f\u0440\u043e\u0441\u0438\u0442\u044c \u043d\u0435 \u0437\u0430
    \u0447\u0442\u043e\": \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u0442\u0435\u0438\u0441\u0442 \u0438 \u0434\u0436\u0435\u043d\u0442\u043b\u044c\u043c\u0435\u043d
    \u0421\u0435\u0440\u0440 \u2014 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0442\u0432\u0435\u0440\u0434\u044b\u0445
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u0439. \u0411\u0443\u0434\u0443\u0447\u0438
    \u0432\u043d\u0443\u043a\u043e\u043c \u043f\u0430\u0441\u0442\u043e\u0440\u0430, \u043e\u043d
    \u0441\u0430\u043c \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u0430\u0442\u0435\u0438\u0441\u0442\u043e\u043c. \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441
    \u043e \u0432\u0435\u0440\u0435 \u043e\u043d \u043e\u0442\u0432\u0435\u0447\u0430\u043b
    \u0441 \u043f\u0440\u0438\u0441\u0443\u0449\u0438\u043c \u0435\u043c\u0443 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u0438\u0435\u043c:
    \"\u041d\u0435\u043b\u044c\u0437\u044f \u0443\u043f\u0440\u0435\u043a\u0430\u0442\u044c
    \u0411\u043e\u0433\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u043d\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442, \u044d\u0442\u043e \u0431\u044b\u043b\u043e
    \u0431\u044b \u043c\u0435\u043b\u043e\u0447\u043d\u043e\". \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0443\u0441,
    \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u043a\u0440\u0430\u0439\u043d\u0435
    \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u043c \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c
    \u0434\u043b\u044f \u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u043a\u0430\u043a \"\u0433\u043e\u0442\u043e\u0432\u043e\u0433\u043e
    \u0432\u0441\u0435\u0433\u0434\u0430 \u043e\u0431\u0441\u0443\u0434\u0438\u0442\u044c \u043b\u044e\u0431\u0443\u044e
    \u0438\u0434\u0435\u044e\"."
