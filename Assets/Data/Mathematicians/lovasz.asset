  achievementsRu: "\u041b\u0430\u0441\u043b\u043e \u041b\u043e\u0432\u0430\u0441 \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0438\u043b\u0438 \u0434\u0430\u0432\u043d\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b,
    \u043d\u043e \u0438 \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u0446\u0435\u043b\u044b\u0435
    \u043d\u043e\u0432\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043d\u0430 \u0441\u0442\u044b\u043a\u0435
    \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438. \u0415\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434 \u0447\u0430\u0441\u0442\u043e \u0434\u0435\u043b\u044f\u0442
    \u043d\u0430 \u0442\u0440\u0438 \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435
    \u0441\u0444\u0435\u0440\u044b: \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f, \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043f\u0440\u043e\u0440\u044b\u0432\u043d\u044b\u0445 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u043c\u043e\u0449\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432.\n\n\U0001F52D
    \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0430\u0444\u043e\u0432: \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447 \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1970-\u0445 \u0433\u043e\u0434\u043e\u0432,
    \u043a\u043e\u0433\u0434\u0430 \u0442\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0430\u0444\u043e\u0432
    \u0435\u0449\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0430\u0441\u044c \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0439\u043d\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e, \u041b\u043e\u0432\u0430\u0441 \u0440\u0435\u0448\u0438\u043b
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0434\u0430\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0438 \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c \u0438 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u044d\u0442\u0443 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u0445
    \u0433\u0440\u0430\u0444\u0430\u0445 (1972 \u0433\u043e\u0434): \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u043e\u0435
    \u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435.
    \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443,
    \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u0441\u0442\u0430\u0432\u0430\u0432\u0448\u0443\u044e\u0441\u044f
    \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0433\u0440\u0430\u0444\u044b \u0441
    \u043e\u0441\u043e\u0431\u044b\u043c \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e\u043c
    \u2014 \u0432 \u043d\u0438\u0445 \u0445\u0440\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u043b\u044e\u0431\u043e\u0433\u043e \u043f\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0433\u043e
    \u043f\u043e\u0434\u0433\u0440\u0430\u0444\u0430 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442
    \u0441 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u043c \u0435\u0433\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u043a\u043b\u0438\u043a\u0438. \u042d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0441\u0440\u0430\u0437\u0443 \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b\u043e \u0435\u0433\u043e
    \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0440\u044f\u0434 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u043c\u0438\u0440\u0430. \u0401\u043c\u043a\u043e\u0441\u0442\u044c \u0428\u0435\u043d\u043d\u043e\u043d\u0430
    \u043f\u044f\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 (1979 \u0433\u043e\u0434):
    \u041b\u043e\u0432\u0430\u0441 \u0440\u0435\u0448\u0438\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u0438\u0437 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438,
    \u043d\u0430\u0439\u0434\u044f \u0442\u043e\u0447\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0451\u043c\u043a\u043e\u0441\u0442\u0438 \u0428\u0435\u043d\u043d\u043e\u043d\u0430 \u0434\u043b\u044f
    \u0433\u0440\u0430\u0444\u0430-\u043f\u044f\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430.
    \u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043e\u043d \u0432\u0432\u0435\u043b
    \u043d\u043e\u0432\u0443\u044e \u043c\u0435\u0440\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043a\u0430\u043a
    \u0447\u0438\u0441\u043b\u043e \u041b\u043e\u0432\u0430\u0441\u0430 (\u0438\u043b\u0438
    \u0442\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u044f \u041b\u043e\u0432\u0430\u0441\u0430)
    \u2014 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0430\u0444\u043e\u0432 \u0438
    \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u0438. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u041a\u043d\u0435\u0437\u0435\u0440\u0430: \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u044d\u0442\u0443 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u0438\u0437 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0430\u0444\u043e\u0432, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0438\u0437 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438 \u2014 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0434\u0440\u0443\u0433\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u042d\u0442\u043e\u0442 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0439
    \u0438 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0438\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0432 \u0437\u0430\u0440\u043e\u0436\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0435.\n\n\U0001F9EE
    \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b: \u043c\u043e\u0441\u0442 \u043c\u0435\u0436\u0434\u0443
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u043c
    \u043c\u0438\u0440\u043e\u043c \u0413\u043b\u0430\u0432\u043d\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430
    \u041b\u043e\u0432\u0430\u0441\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0432 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b, \u043f\u043e\u043a\u0430\u0437\u0430\u0432,
    \u043a\u0430\u043a \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0440\u0435\u0448\u0430\u0442\u044c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438. LLL-\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    (\u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u041b\u0435\u043d\u0441\u0442\u0440\u044b
    \u2014 \u041b\u0435\u043d\u0441\u0442\u0440\u044b \u2014 \u041b\u043e\u0432\u0430\u0441\u0430):
    \u0421\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0438, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0439
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0431\u0440\u0430\u0442\u044c\u044f\u043c\u0438
    \u041b\u0435\u043d\u0441\u0442\u0440\u0430. \u042d\u0442\u043e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0440\u0435\u0434\u0443\u043a\u0446\u0438\u0438 \u0431\u0430\u0437\u0438\u0441\u0430 \u0432
    \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445 \u0440\u0435\u0448\u0435\u0442\u043a\u0430\u0445.
    \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u041e\u043d \u0441\u0442\u0430\u043b
    \"\u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u0438\u043c \u043d\u043e\u0436\u043e\u043c\"
    \u0434\u043b\u044f \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438.
    \u0421 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u0435\u0433\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u043a\u0440\u0438\u043f\u0442\u043e\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0438
    \u0434\u043b\u044f \u0432\u0437\u043b\u043e\u043c\u0430 \u0441\u0442\u0430\u0440\u044b\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c. \u0421 \u0434\u0440\u0443\u0433\u043e\u0439 \u2014
    \u043d\u0430 \u043d\u0435\u043c \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u044b \u043f\u043e\u0441\u0442\u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u0435
    \u043a\u0440\u0438\u043f\u0442\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u043c\u0438
    \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0430\u0442\u0430\u043a\u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432. \u0415\u0433\u043e \u0442\u0430\u043a\u0436\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442 \u0434\u043b\u044f \u0444\u0430\u043a\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u0438
    \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u043e\u0432 \u0438 \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0432
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430\u0445 \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u0438:
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041c\u0430\u0440\u0442\u0438\u043d\u043e\u043c
    \u0413\u0440\u0451\u0442\u0448\u0435\u043b\u0435\u043c \u0438 \u041b\u0435\u043a\u0441\u043e\u043c
    \u0428\u0440\u0435\u0439\u0432\u0435\u0440\u043e\u043c \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u043a\u0430\u043a \u0437\u0430\u0434\u0430\u0447\u0438 \u043f\u043e\u043b\u0443\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u043c\u043e\u0436\u043d\u043e \u0440\u0435\u0448\u0430\u0442\u044c \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e,
    \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u0434\u0438\u0437\u0430\u0439\u043d\u0435 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432.\n\n\U0001F3B2
    \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u041b\u043e\u0432\u0430\u0441 \u0432\u043d\u0435\u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u043e, \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0441\u043e \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e. \u041b\u043e\u043a\u0430\u043b\u044c\u043d\u0430\u044f
    \u043b\u0435\u043c\u043c\u0430 \u041b\u043e\u0432\u0430\u0441\u0430 (\u041b\u041b\u041b):
    \u042d\u0442\u043e \u043c\u043e\u0449\u043d\u0435\u0439\u0448\u0438\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0432 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u043e\u0439 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0435.
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442,
    \u043a\u043e\u0433\u0434\u0430 \u043d\u0443\u0436\u043d\u044b\u0439 \u043e\u0431\u044a\u0435\u043a\u0442
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0447\u0430\u0441\u0442\u043e,
    \u043b\u0435\u043c\u043c\u0430 \u041b\u043e\u0432\u0430\u0441\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u0447\u0435\u043d\u044c \u0440\u0435\u0434\u043a\u0438\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432,
    \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0433\u043e\u0440\u0430\u0437\u0434\u043e
    \u0431\u043e\u043b\u0435\u0435 \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439.
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e PCP: \u0412\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u0430\u043c\u0438 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u043e
    \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    (PCP). \u042d\u0442\u043e\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442,
    \u043b\u0435\u0436\u0430\u0449\u0438\u0439 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438,
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043c\u043e\u0436\u043d\u043e
    \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439
    \u043d\u0430\u0434\u0435\u0436\u043d\u043e\u0441\u0442\u044c\u044e, \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0432
    \u043b\u0438\u0448\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432.\n\n\U0001F30C \u041d\u043e\u0432\u0430\u044f
    \u0433\u043b\u0430\u0432\u0430: \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0435\u0434\u0435\u043b\u043e\u0432
    \u0433\u0440\u0430\u0444\u043e\u0432 \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u041b\u043e\u0432\u0430\u0441 (\u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u041a\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u043c \u0411\u043e\u0440\u0433\u0441\u043e\u043c,
    \u0414\u0436\u0435\u043d\u043d\u0438\u0444\u0435\u0440 \u0427\u0435\u0439\u0435\u0441, \u0412\u0435\u0440\u043e\u0439
    \u0428\u043e\u0448, \u0411\u0430\u043b\u0430\u0436\u0435\u043c \u0421\u0435\u0433\u0435\u0434\u0438
    \u0438 \u0441\u0432\u043e\u0435\u0439 \u0436\u0435\u043d\u043e\u0439 \u041a\u0430\u0442\u0430\u043b\u0438\u043d
    \u0412\u0435\u0441\u0442\u0435\u0440\u0433\u043e\u043c\u0431\u0438) \u0440\u0430\u0437\u0432\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0440\u0435\u0434\u0435\u043b\u043e\u0432 \u0433\u0440\u0430\u0444\u043e\u0432.
    \u042d\u0442\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043d\u043e\u0432\u043e\u0435
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0441\u0432\u044f\u0437\u0438
    \u043c\u0435\u0436\u0434\u0443 \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0433\u0440\u0430\u0444\u043e\u0432, \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u043e\u0439, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044f
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b, \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0449\u0438\u0435
    \u043a\u0430\u043a \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0435\u0439
    \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0433\u0440\u0430\u0444\u043e\u0432.\n\n\U0001F4DA
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u041b\u0430\u0441\u043b\u043e
    \u041b\u043e\u0432\u0430\u0441 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u0438 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c \u0431\u043e\u043b\u0435\u0435
    300 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0441\u0442\u0430\u0442\u0435\u0439 \u0438
    11 \u043a\u043d\u0438\u0433, \u043c\u043d\u043e\u0433\u0438\u0435 \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0441\u0442\u0430\u043b\u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430\u043c\u0438. \u0421\u0440\u0435\u0434\u0438
    \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445:
    \"Combinatorial Problems and Exercises\" \u2014 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0437\u0430\u0434\u0430\u0447\u043d\u0438\u043a \u043f\u043e \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0435,
    \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u0432\u0448\u0438\u0439 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u043d\u0438\u0439. \"Matching Theory\"
    (\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041c.\u0414. \u041f\u043b\u0430\u043c\u043c\u0435\u0440\u043e\u043c)
    \u2014 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0440\u0443\u0434
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u0430\u0440\u043e\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0439,
    \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u044b\u0439 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a \u043a\u0430\u043a \"\u041f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0430\u0444\u043e\u0432.
    \u0422\u0435\u043e\u0440\u0438\u044f \u043f\u0430\u0440\u043e\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0439
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0444\u0438\u0437\u0438\u043a\u0435,
    \u0445\u0438\u043c\u0438\u0438\". \"Discrete Mathematics: Elementary and Beyond\" \u2014
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0432 \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443."
  achievementsEn: 
  personalLifeRu: "\u041b\u0430\u0441\u043b\u043e \u041b\u043e\u0432\u0430\u0441 \u0436\u0438\u0432 \u0438
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u043f\u043e \u0441\u0435\u0439 \u0434\u0435\u043d\u044c (\u0435\u043c\u0443 78 \u043b\u0435\u0442,
    \u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f 9 \u043c\u0430\u0440\u0442\u0430
    1948 \u0433\u043e\u0434\u0430). \u041e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043d\u0430\u0443\u043a\u043e\u0439,
    \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0432 2025 \u0433\u043e\u0434\u0443 \u043c\u0435\u0434\u0430\u043b\u044c
    \u042d\u0440\u0430\u0437\u043c\u0430 \u2014 \u043e\u0434\u043d\u0443 \u0438\u0437 \u0432\u044b\u0441\u0448\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438. \u041d\u0438\u0436\u0435 \u2014 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438, \u0443\u0447\u0451\u0431\u044b \u0438
    \u0432\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438.\n\n\U0001F476 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435,
    \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0448\u0430\u0433\u0438
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u041b\u0430\u0441\u043b\u043e
    \u041b\u043e\u0432\u0430\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435,
    \u0412\u0435\u043d\u0433\u0440\u0438\u044f. \u0415\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u043d\u043e: \u0421\u0440\u0435\u0434\u043d\u044f\u044f
    \u0448\u043a\u043e\u043b\u0430: \u0423\u0447\u0438\u043b\u0441\u044f \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043a\u043b\u0430\u0441\u0441\u0435
    Fazekas Mih\u00e1ly Gimn\u00e1zium, \u043a\u0443\u0434\u0430 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u043f\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u044f.
    \u042d\u0442\u0430 \u0448\u043a\u043e\u043b\u0430 \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e \u0438 \u0435\u0433\u043e \u0441\u0432\u0435\u0440\u0441\u0442\u043d\u0438\u043a\u043e\u0432
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0440\u0435\u0434\u043e\u0439:
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0438\u0437 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0447\u0438\u0442\u0430\u043b\u0438
    \u0438\u043c \u043b\u0435\u043a\u0446\u0438\u0438, \u0438 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0443\u0447\u0435\u043d\u0438\u043a\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041b\u043e\u0432\u0430\u0441\u0430,
    \u0443\u0436\u0435 \u0432 \u0448\u043a\u043e\u043b\u0435 \u043d\u0430\u0447\u0430\u043b\u0438
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439. \u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u044f: \u0412 14 \u043b\u0435\u0442
    \u043e\u043d \u043d\u0430\u0442\u043a\u043d\u0443\u043b\u0441\u044f \u043d\u0430 \u0441\u0442\u0430\u0442\u044c\u044e
    \u041f\u0430\u043b\u0430 \u042d\u0440\u0434\u0451\u0448\u0430 \u0432 \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0436\u0443\u0440\u043d\u0430\u043b\u0435
    \u0434\u043b\u044f \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432. \u042d\u0442\u0430
    \u0441\u0442\u0430\u0442\u044c\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0430
    \u043d\u0430 \u043d\u0435\u0433\u043e \u0442\u0430\u043a\u043e\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435,
    \u0447\u0442\u043e \u043e\u043d \u043f\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u043b \u0435\u0451
    \u00ab\u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044c
    \u0440\u0430\u0437\u00bb. \u0412 1963 \u0433\u043e\u0434\u0443, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u0442\u0430\u0440\u0448\u0435\u043a\u043b\u0430\u0441\u0441\u043d\u0438\u043a\u043e\u043c,
    \u043e\u043d \u043b\u0438\u0447\u043d\u043e \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b
    \u042d\u0440\u0434\u0451\u0448\u0430, \u0438 \u044d\u0442\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430
    \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u043f\u0443\u0442\u044c.
    \u041e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u044b: \u0421 1964 \u043f\u043e 1966 \u0433\u043e\u0434
    \u041b\u043e\u0432\u0430\u0441 \u0442\u0440\u0438\u0436\u0434\u044b \u043f\u043e\u0434\u0440\u044f\u0434
    \u0432\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u043b \u0437\u043e\u043b\u043e\u0442\u044b\u0435
    \u043c\u0435\u0434\u0430\u043b\u0438 \u043d\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0435
    (\u0432 1965 \u0438 1966 \u0433\u043e\u0434\u0430\u0445 \u2014 \u0441 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u043c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c). \u0414\u043e \u044d\u0442\u043e\u0433\u043e,
    \u0432 1963 \u0433\u043e\u0434\u0443, \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0435\u0440\u0435\u0431\u0440\u043e. \u0422\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u043e\u043d\u043d\u0430\u044f
    \u0438\u0433\u0440\u0430: \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0438 \u043f\u043e\u0431\u0435\u0434\u0438\u043b \u0432 \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u043c
    \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u043e\u043d\u043d\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0448\u043e\u0443, \u0433\u0434\u0435 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432
    \u043f\u043e\u043c\u0435\u0449\u0430\u043b\u0438 \u0432 \u0441\u0442\u0435\u043a\u043b\u044f\u043d\u043d\u044b\u0435
    \u043a\u0430\u0431\u0438\u043d\u044b \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447. \u0412 \u0444\u0438\u043d\u0430\u043b\u0435 \u043e\u043d
    \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043b\u0441\u044f \u0441\u043e \u0441\u0432\u043e\u0438\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c \u041b\u0430\u0439\u043e\u0448\u0435\u043c \u041f\u043e\u0448\u0435\u0439.
    \u042d\u043f\u0438\u0437\u043e\u0434, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u0440\u0438\u043f\u0438\u0441\u0430\u043b
    \u043f\u043e\u0431\u0435\u0434\u0443 \u0438\u0434\u0435\u0435, \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0439
    \u0434\u0440\u0443\u0433\u043e\u043c, \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440.\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430
    \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442: \u041f\u043e\u0441\u043b\u0435
    \u0448\u043a\u043e\u043b\u044b \u041b\u043e\u0432\u0430\u0441 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0438\u043c\u0435\u043d\u0438 \u042d\u0442\u0432\u0451\u0448\u0430 \u041b\u043e\u0440\u0430\u043d\u0434\u0430.
    \u0423\u0447\u0451\u043d\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c: \u0412
    1970 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 22
    \u043b\u0435\u0442, \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430 \u043d\u0430\u0443\u043a (C.Sc.)
    \u0432 \u0412\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a. \u042d\u0442\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u043b\u0438, \u0447\u0442\u043e
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442 \u0441\u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0442\u0430\u043a\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f.
    \u041a \u0442\u043e\u043c\u0443 \u043c\u043e\u043c\u0435\u043d\u0442\u0443 \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e
    15 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0441\u0442\u0430\u0442\u0435\u0439. \u0412
    1971 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c (Dr.Rer.Nat.) \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c:
    \u0415\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0432
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0422\u0438\u0431\u043e\u0440 \u0413\u0430\u043b\u043b\u0430\u0438.\n\n\U0001F9D1\u200d\U0001F3EB
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0435
    \u0441\u0432\u044f\u0437\u0438 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041b\u043e\u0432\u0430\u0441\u0430 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0440\u0430\u043d \u0438
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0439: \u0412\u0435\u043d\u0433\u0440\u0438\u044f:
    \u041f\u043e\u0441\u043b\u0435 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u044b
    \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (1971\u20131975),
    \u0437\u0430\u0442\u0435\u043c \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0421\u0435\u0433\u0435\u0434\u0430 (1975\u20131983), \u0433\u0434\u0435 \u0441\u0442\u0430\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0438 \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u043c
    \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0430 \u0432 1983 \u0433\u043e\u0434\u0443 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442 \u0443\u0436\u0435 \u043d\u0430
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e
    \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0412 1979 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    31 \u0433\u043e\u0434\u0430, \u043e\u043d \u0441\u0442\u0430\u043b \u0441\u0430\u043c\u044b\u043c
    \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c \u0412\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0437\u0430 \u0432\u0441\u044e
    \u0435\u0451 \u0438\u0441\u0442\u043e\u0440\u0438\u044e. \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0439
    \u043e\u043f\u044b\u0442: \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432
    \u0421\u0428\u0410 \u2014 \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u0419\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (1993\u20131999), \u0437\u0430\u0442\u0435\u043c \u0441\u0442\u0430\u0440\u0448\u0438\u043c
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u0432
    Microsoft Research (1999\u20132006). \u0412 1972\u20131973 \u0433\u043e\u0434\u0430\u0445
    \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b \u0441\u0442\u0430\u0436\u0438\u0440\u043e\u0432\u043a\u0443
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0412\u0430\u043d\u0434\u0435\u0440\u0431\u0438\u043b\u044c\u0442\u0430.
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0438 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e:
    \u0412 2006 \u0433\u043e\u0434\u0443 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432
    \u0412\u0435\u043d\u0433\u0440\u0438\u044e, \u0441\u0442\u0430\u0432 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0421 2014 \u043f\u043e
    2020 \u0433\u043e\u0434 \u0431\u044b\u043b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u0412\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a.\n\n\U0001F91D \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u041f\u0430\u043b\u043e\u043c \u042d\u0440\u0434\u0451\u0448\u0435\u043c \u0438
    \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0451\u043d\u044b\u043c\u0438 \u0421
    \u042d\u0440\u0434\u0451\u0448\u0435\u043c: \u0418\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u044b\u043c\u0438. \u042d\u0440\u0434\u0451\u0448
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b
    \u041b\u043e\u0432\u0430\u0441\u0430, \u043d\u043e \u0438 \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c \u043f\u043e \u0448\u0435\u0441\u0442\u0438
    \u0441\u0442\u0430\u0442\u044c\u044f\u043c. \u042d\u0442\u043e \u0434\u0430\u0451\u0442
    \u041b\u043e\u0432\u0430\u0441\u0443 \u0447\u0438\u0441\u043b\u043e \u042d\u0440\u0434\u0451\u0448\u0430,
    \u0440\u0430\u0432\u043d\u043e\u0435 1. \u0421\u0430\u043c \u041b\u043e\u0432\u0430\u0441
    \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b, \u0447\u0442\u043e \u042d\u0440\u0434\u0451\u0448
    \u043d\u0430\u0443\u0447\u0438\u043b \u0435\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u043d\u043e \u0438 \u00ab\u043f\u043e\u043b\u043d\u043e\u0439
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0441\u0442\u0438 \u0432 \u0437\u0430\u0434\u0430\u0447\u0430\u0445
    \u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445\u00bb,
    \u0447\u0442\u043e \u043d\u0435\u0438\u0437\u0431\u0435\u0436\u043d\u043e \u0432\u0435\u0434\u0451\u0442
    \u043a \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0443.
    \u0421 \u0436\u0435\u043d\u043e\u0439: \u0415\u0433\u043e \u0436\u0435\u043d\u0430, \u041a\u0430\u0442\u0430\u043b\u0438\u043d
    \u0412\u0435\u0441\u0442\u0435\u0440\u0433\u043e\u043c\u0431\u0438 (Katalin Vesztergombi),
    \u0442\u043e\u0436\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a. \u041e\u043d\u0438
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0438\u0441\u044c \u0435\u0449\u0451
    \u0432 \u0448\u043a\u043e\u043b\u0435, \u0433\u0434\u0435 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0432 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435
    \u0434\u043b\u044f \u043e\u0434\u0430\u0440\u0451\u043d\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439.
    \u041e\u043d\u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0443\u043f\u0440\u0443\u0433\u0438,
    \u043d\u043e \u0438 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0435 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u044b.
    \u0412 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0440\u0435\u0434\u0435:
    \u041a\u043e\u043b\u043b\u0435\u0433\u0438 \u0438 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u044b
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u041b\u043e\u0432\u0430\u0441\u0430
    \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u00ab\u043d\u0430\u0432\u043e\u0434\u0438\u0442 \u043c\u043e\u0441\u0442\u044b\u00bb \u043c\u0435\u0436\u0434\u0443
    \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0410\u0432\u0438 \u0412\u0438\u0433\u0434\u0435\u0440\u0441\u043e\u043d,
    \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0430 \u0438 \u0431\u0443\u0434\u0443\u0449\u0438\u0439
    \u0441\u043e-\u043b\u0430\u0443\u0440\u0435\u0430\u0442 \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438, \u043e\u0442\u043c\u0435\u0447\u0430\u043b \u0435\u0433\u043e
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0449\u0435\u0434\u0440\u043e\u0441\u0442\u044c, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u00ab\u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a \u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u00bb.
    \u0415\u0433\u043e \u0441\u0442\u0438\u043b\u044c \u2014 \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043c\u0435\u0442\u043e\u0434\u044b \u0438\u0437 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438,
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0432 \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.\n\n\u23f3
    \u0421\u043c\u0435\u0440\u0442\u044c \u041b\u0430\u0441\u043b\u043e \u041b\u043e\u0432\u0430\u0441
    \u0436\u0438\u0432. \u041f\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e
    \u043d\u0430 2025 \u0433\u043e\u0434 \u043e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c-\u044d\u043c\u0435\u0440\u0438\u0442\u043e\u043c
    \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u042d\u0442\u0432\u0451\u0448\u0430
    \u041b\u043e\u0440\u0430\u043d\u0434\u0430 \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u043c \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u0430
    \u0420\u0435\u043d\u044c\u0438 \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435.\n\n\U0001F4DA
    \u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e: \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u041f\u043e\u043c\u0438\u043c\u043e
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439,
    \u041b\u043e\u0432\u0430\u0441 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c
    \u0432\u043a\u043b\u0430\u0434\u043e\u043c \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u0415\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0437\u0430\u0434\u0430\u0447\u043d\u0438\u043a \u00abCombinatorial Problems and Exercises\u00bb,
    \u0438\u0437\u0434\u0430\u043d\u043d\u044b\u0439, \u043a\u043e\u0433\u0434\u0430 \u0435\u043c\u0443
    \u0435\u0449\u0451 \u043d\u0435 \u0431\u044b\u043b\u043e 30 \u043b\u0435\u0442, \u043e\u043a\u0430\u0437\u0430\u043b
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u0432\u043e\u0435\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435:
    \u0437\u0430\u0434\u0430\u0447\u0438, \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438
    \u0438 \u043f\u043e\u043b\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f.
    \u041e\u043d \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f
    \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u043c
    \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f
    \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b
    \u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434\u044b."
  personalLifeEn: 
  shortBioRu: "\u041b\u0430\u0441\u043b\u043e \u041b\u043e\u0432\u0430\u0441 (\u0432\u0435\u043d\u0433.
    Lov\u00e1sz L\u00e1szl\u00f3) \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0447\u044c\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043b\u0438
    \u0447\u0438\u0441\u0442\u0443\u044e \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0443
    \u0441 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0438 \u043d\u0430\u0448\u043b\u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430\u0445. \u041e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    9 \u043c\u0430\u0440\u0442\u0430 1948 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435
    \u0438 \u0441\u0442\u0430\u043b \u0447\u0430\u0441\u0442\u044c\u044e \u0442\u043e\u0433\u043e
    \u0441\u0430\u043c\u043e\u0433\u043e \u00ab\u0437\u043e\u043b\u043e\u0442\u043e\u0433\u043e
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\u00bb \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u0434
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u044b
    \u0441\u0442\u0440\u0430\u043d\u044b.\n\n\U0001F9D1\u200d\U0001F393 \u0414\u0435\u0442\u0441\u0442\u0432\u043e,
    \u044e\u043d\u043e\u0441\u0442\u044c \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u043f\u0443\u0442\u0438
    \u0411\u0443\u0434\u0443\u0449\u0438\u0439 \u0433\u0435\u043d\u0438\u0439 \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0441\u0435\u0431\u044f \u0435\u0449\u0435 \u0432 \u0448\u043a\u043e\u043b\u0435. \u0412
    1960-\u0445 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0430\u0445,
    \u0433\u0434\u0435 \u0435\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0431\u044b\u043b\u0438 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438:
    1964, 1965, 1966 \u2014 \u0442\u0440\u0438\u0436\u0434\u044b \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043b
    \u0437\u043e\u043b\u043e\u0442\u044b\u0435 \u043c\u0435\u0434\u0430\u043b\u0438, \u043f\u0440\u0438\u0447\u0435\u043c
    \u0432 1965 \u0438 1966 \u0433\u043e\u0434\u0430\u0445 \u0441 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u043c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c (\u0434\u043e \u044d\u0442\u043e\u0433\u043e,
    \u0432 1963 \u0433\u043e\u0434\u0443, \u0432\u0437\u044f\u043b \u0441\u0435\u0440\u0435\u0431\u0440\u043e).
    \u042d\u0442\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u043c: \u0435\u0433\u043e \u0441\u044b\u043d
    \u0442\u0430\u043a\u0436\u0435 \u0432\u044b\u0438\u0433\u0440\u0430\u043b \u043c\u0435\u0434\u0430\u043b\u044c
    \u043d\u0430 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0435 \u0432 2008 \u0433\u043e\u0434\u0443.
    \u041e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u044e\u043d\u043e\u0433\u043e \u041b\u043e\u0432\u0430\u0441\u0430 \u043e\u043a\u0430\u0437\u0430\u043b\u0430
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u041f\u0430\u043b\u043e\u043c
    \u042d\u0440\u0434\u0451\u0448\u0435\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b
    \u0435\u0433\u043e \u043d\u0430 \u0437\u0430\u043d\u044f\u0442\u0438\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u043e\u0439
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0433\u0440\u0430\u0444\u043e\u0432.
    \u0412\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u041b\u043e\u0432\u0430\u0441
    \u0441\u0442\u0430\u043b \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c \u0448\u0435\u0441\u0442\u0438
    \u0441\u0442\u0430\u0442\u0435\u0439 \u0441 \u042d\u0440\u0434\u0451\u0448\u0435\u043c,
    \u0447\u0442\u043e \u0434\u0430\u043b\u043e \u0435\u043c\u0443 \u0447\u0438\u0441\u043b\u043e
    \u042d\u0440\u0434\u0451\u0448\u0430, \u0440\u0430\u0432\u043d\u043e\u0435 1 (\u043d\u0430\u0438\u0432\u044b\u0441\u0448\u0438\u0439
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u0431\u043b\u0438\u0437\u043e\u0441\u0442\u0438
    \u043a \u00ab\u043f\u0430\u0442\u0440\u0438\u0430\u0440\u0445\u0443\u00bb \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438).
    \u041f\u043e\u0441\u043b\u0435 \u0448\u043a\u043e\u043b\u044b \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0438\u043c\u0435\u043d\u0438 \u042d\u0442\u0432\u0451\u0448\u0430 \u041b\u043e\u0440\u0430\u043d\u0434\u0430.
    \u0412 22 \u0433\u043e\u0434\u0430, \u0432 1970 \u0433\u043e\u0434\u0443, \u043e\u043d \u0443\u0436\u0435
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430
    \u043d\u0430\u0443\u043a \u0432 \u0412\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u043f\u043e\u0434
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u0422\u0438\u0431\u043e\u0440\u0430
    \u0413\u0430\u043b\u043b\u0430\u0438, \u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0433\u043e\u0434 \u0441\u043f\u0443\u0441\u0442\u044f,
    \u0432 1971-\u043c. \u041a \u044d\u0442\u043e\u043c\u0443 \u043c\u043e\u043c\u0435\u043d\u0442\u0443
    \u043e\u043d \u0431\u044b\u043b \u0430\u0432\u0442\u043e\u0440\u043e\u043c 15 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0441\u0442\u0430\u0442\u0435\u0439.\n\n\U0001F468\u200d\U0001F52C \u041a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0438 \u043c\u0438\u0440\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0415\u0433\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u0430
    \u0440\u0430\u0431\u043e\u0442\u043e\u0439 \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445 \u043c\u0438\u0440\u0430:
    \u0412\u0435\u043d\u0433\u0440\u0438\u044f (\u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b):
    \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (\u0434\u043e 1975),
    \u0437\u0430\u0442\u0435\u043c \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0421\u0435\u0433\u0435\u0434\u0430, \u0433\u0434\u0435 \u0432 1978 \u0433\u043e\u0434\u0443
    \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0412 1983 \u0433\u043e\u0434\u0443
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442,
    \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0442\u0430\u043c
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a. \u0421\u0428\u0410 (1993\u20132006): \u0411\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u0419\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (1993-1999), \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0432 Microsoft
    Research (\u0434\u043e 2006 \u0433\u043e\u0434\u0430). \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u0412\u0435\u043d\u0433\u0440\u0438\u044e (\u0441 2006): \u0412\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0443, \u0441\u0442\u0430\u0432 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (2006-2011). \u0412 2014\u20132020 \u0433\u043e\u0434\u0430\u0445 \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u043f\u043e\u0441\u0442 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430 \u0412\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u0412 2007\u20132010
    \u0433\u043e\u0434\u0430\u0445 \u041b\u043e\u0432\u0430\u0441 \u0431\u044b\u043b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u044e\u0437\u0430 (IMU).\n\n\U0001F4A1 \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u041b\u043e\u0432\u0430\u0441 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432\u044b
    \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445
    \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438: \u0422\u0435\u043e\u0440\u0438\u044f
    \u0433\u0440\u0430\u0444\u043e\u0432: \u0412 1972 \u0433\u043e\u0434\u0443 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u0445
    \u0433\u0440\u0430\u0444\u0430\u0445, \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u043e\u0441\u0442\u0430\u0432\u0430\u0432\u0448\u0443\u044e\u0441\u044f \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u043e\u0439
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439. \u0414\u043e\u043a\u0430\u0437\u0430\u043b
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u041a\u043d\u0435\u0437\u0435\u0440\u0430,
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e
    \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438.
    \u041d\u0430\u0448\u0435\u043b \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0443 \u0451\u043c\u043a\u043e\u0441\u0442\u0438
    \u0428\u0435\u043d\u043d\u043e\u043d\u0430 \u0434\u043b\u044f \u043f\u044f\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u0433\u0440\u0430\u0444\u0430, \u0440\u0435\u0448\u0438\u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438.
    \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0431\u0440\u0430\u0442\u044c\u044f\u043c\u0438 \u041b\u0435\u043d\u0441\u0442\u0440\u0430
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b LLL-\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    (\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u041b\u0435\u043d\u0441\u0442\u0440\u044b
    \u2014 \u041b\u0435\u043d\u0441\u0442\u0440\u044b \u2014 \u041b\u043e\u0432\u0430\u0441\u0430)
    \u2014 \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f \u043a\u0440\u0438\u043f\u0442\u043e\u0441\u0438\u0441\u0442\u0435\u043c,
    \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0445 \u043a \u0430\u0442\u0430\u043a\u0430\u043c
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u0445 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432.
    \u0421\u043e\u0437\u0434\u0430\u043b \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0443\u044e
    \u043b\u0435\u043c\u043c\u0443 \u041b\u043e\u0432\u0430\u0441\u0430 \u2014 \u043c\u043e\u0449\u043d\u044b\u0439
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0432 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u043e\u0439
    \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0435. \u0412\u043d\u0435\u0441
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u043e
    \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    (PCP), \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0435\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F3C6
    \u0413\u043b\u0430\u0432\u043d\u044b\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0417\u0430
    \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u041b\u0430\u0441\u043b\u043e
    \u041b\u043e\u0432\u0430\u0441 \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0441\u0435\u0445 \u043c\u044b\u0441\u043b\u0438\u043c\u044b\u0445 \u043f\u0440\u0435\u043c\u0438\u0439
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435: \u041f\u0440\u0435\u043c\u0438\u044f
    \u0412\u043e\u043b\u044c\u0444\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    (1999). \u041f\u0440\u0435\u043c\u0438\u044f \u041a\u043d\u0443\u0442\u0430 (1999). \u041f\u0440\u0435\u043c\u0438\u044f
    \u0413\u0451\u0434\u0435\u043b\u044f (2001). \u041f\u0440\u0435\u043c\u0438\u044f \u041a\u0438\u043e\u0442\u043e
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a (2010). \u041f\u0440\u0435\u043c\u0438\u044f \u0410\u0431\u0435\u043b\u044f
    (2021) \u2014 \u043e\u0434\u043d\u0430 \u0438\u0437 \u0432\u044b\u0441\u043e\u0447\u0430\u0439\u0448\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a (\u0441 2006) \u0438 \u0447\u043b\u0435\u043d\u043e\u043c \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0421\u0428\u0410.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041b\u0430\u0441\u043b\u043e
    \u041b\u043e\u0432\u0430\u0441 \u0436\u0435\u043d\u0430\u0442 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u041a\u0430\u0442\u0430\u043b\u0438\u043d \u0412\u0435\u0441\u0442\u0435\u0440\u0433\u043e\u043c\u0431\u0438,
    \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0443\u0447\u0438\u043b\u0438\u0441\u044c \u0432 \u0441\u043f\u0435\u0446\u0448\u043a\u043e\u043b\u0435.
    \u0423 \u043d\u0438\u0445 \u0447\u0435\u0442\u0432\u0435\u0440\u043e \u0434\u0435\u0442\u0435\u0439
    \u0438 \u0441\u0435\u043c\u0435\u0440\u043e \u0432\u043d\u0443\u043a\u043e\u0432. \u0418\u0445
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043d\u0435
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u0435\u043c\u044c\u0435\u0439
    \u2014 \u043e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438
    \u043d\u0430\u0434 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430\u043c\u0438 \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438."
  shortBioEn: 
  interestingFactsRu: "\u041f\u043e\u043c\u0438\u043c\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u0432 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u041b\u0430\u0441\u043b\u043e \u041b\u043e\u0432\u0430\u0441\u0430 \u0435\u0441\u0442\u044c
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u044f\u0440\u043a\u0438\u0445 \u0438
    \u043a\u0443\u0440\u044c\u0451\u0437\u043d\u044b\u0445 \u0434\u0435\u0442\u0430\u043b\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0438\u0441\u0443\u044e\u0442 \u0435\u0433\u043e
    \u043a\u0430\u043a \u043d\u0435\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u0443\u044e
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c.\n\n\U0001F3C6 \u0412\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434
    \u0438 \u00ab\u0437\u043e\u043b\u043e\u0442\u043e\u0435 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0435\u00bb
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041e\u043b\u0438\u043c\u043f:
    \u041b\u0430\u0441\u043b\u043e \u041b\u043e\u0432\u0430\u0441 \u0431\u044b\u043b \u0447\u0430\u0441\u0442\u044c\u044e
    \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u043e\u0433\u043e \u00ab\u0437\u043e\u043b\u043e\u0442\u043e\u0433\u043e
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\u00bb \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432. \u041e\u043d \u0442\u0440\u0438\u0436\u0434\u044b
    \u043f\u043e\u0434\u0440\u044f\u0434 \u0432\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u043b
    \u0437\u043e\u043b\u043e\u0442\u044b\u0435 \u043c\u0435\u0434\u0430\u043b\u0438 \u043d\u0430
    \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0435 (\u0432 1964, 1965 \u0438 1966 \u0433\u043e\u0434\u0430\u0445),
    \u043f\u0440\u0438\u0447\u0451\u043c \u0432 \u0434\u0432\u0443\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445
    \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u2014 \u0441 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u043c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u042d\u0442\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0435\u0441\u044f
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0435\u0439:
    \u0435\u0433\u043e \u0441\u044b\u043d \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043b
    \u043c\u0435\u0434\u0430\u043b\u044c \u043d\u0430 \u044d\u0442\u043e\u0439 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0435
    \u0432 2008 \u0433\u043e\u0434\u0443. \u0422\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u043e\u043d\u043d\u0430\u044f
    \u0434\u0443\u044d\u043b\u044c: \u0412 \u044e\u043d\u043e\u0441\u0442\u0438 \u043e\u043d
    \u0441\u0442\u0430\u043b \u043f\u043e\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u0435\u043c
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0433\u043e
    \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0448\u043e\u0443,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432
    \u043f\u043e\u043c\u0435\u0449\u0430\u043b\u0438 \u0432 \u0441\u0442\u0435\u043a\u043b\u044f\u043d\u043d\u044b\u0435
    \u043a\u0430\u0431\u0438\u043d\u044b \u0438 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b\u0438
    \u0440\u0435\u0448\u0430\u0442\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043d\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c.
    \u042d\u0442\u043e\u0442 \u0444\u043e\u0440\u043c\u0430\u0442 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u043b
    \u0437\u0440\u0435\u043b\u0438\u0449\u043d\u043e\u0441\u0442\u0438 \u0438 \u0434\u0435\u043b\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0437\u0440\u0435\u043b\u0438\u0449\u0435\u043c \u0434\u043b\u044f \u0448\u0438\u0440\u043e\u043a\u043e\u0439
    \u043f\u0443\u0431\u043b\u0438\u043a\u0438.\n\n\U0001F91D \u0414\u0440\u0443\u0436\u0431\u0430
    \u0441 \u00ab\u043a\u043e\u0447\u0443\u044e\u0449\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c\u00bb
    \u041a\u0443\u043c\u0438\u0440 \u0438 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a:
    \u041e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u041b\u043e\u0432\u0430\u0441\u0430 \u043e\u043a\u0430\u0437\u0430\u043b\u0430
    \u0441\u0442\u0430\u0442\u044c\u044f \u0438 \u043b\u0438\u0447\u043d\u0430\u044f \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0441 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c \u041f\u0430\u043b\u043e\u043c
    \u042d\u0440\u0434\u0451\u0448\u0435\u043c \u2014 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0441\u0432\u043e\u0438\u043c \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u043c
    \u0441\u0442\u0438\u043b\u0435\u043c \u0436\u0438\u0437\u043d\u0438 \u00ab\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb. \u0418\u043c\u0435\u043d\u043d\u043e
    \u042d\u0440\u0434\u0451\u0448 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e
    \u041b\u043e\u0432\u0430\u0441\u0430 \u043d\u0430 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435
    \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438. \u0421\u0442\u0435\u043f\u0435\u043d\u044c
    \u0440\u043e\u0434\u0441\u0442\u0432\u0430 \u0432 \u043c\u0438\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438:
    \u041b\u043e\u0432\u0430\u0441 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u0448\u0435\u0441\u0442\u0438 \u0441\u0442\u0430\u0442\u0435\u0439 \u0441 \u042d\u0440\u0434\u0451\u0448\u0435\u043c,
    \u0447\u0442\u043e \u0432 \u043c\u0438\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0434\u0430\u0451\u0442 \u0435\u043c\u0443 \u0447\u0438\u0441\u043b\u043e \u042d\u0440\u0434\u0451\u0448\u0430,
    \u0440\u0430\u0432\u043d\u043e\u0435 1. \u042d\u0442\u043e \u0447\u0438\u0441\u043b\u043e
    \u2014 \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c
    \u00ab\u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0431\u043b\u0438\u0437\u043e\u0441\u0442\u0438\u00bb
    \u043a \u042d\u0440\u0434\u0451\u0448\u0443, \u0438 \u0438\u043c\u0435\u0442\u044c \u0435\u0434\u0438\u043d\u0438\u0446\u0443
    \u2014 \u0437\u043d\u0430\u0447\u0438\u0442 \u0431\u044b\u0442\u044c \u0435\u0433\u043e
    \u043f\u0440\u044f\u043c\u044b\u043c \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c,
    \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u044b\u0441\u0448\u0438\u043c
    \u0437\u043d\u0430\u043a\u043e\u043c \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u0430. \u041e\u0442\u043a\u0440\u044b\u0442\u044b\u0439
    \u0441\u0442\u0438\u043b\u044c: \u041e\u0431\u0449\u0435\u043d\u0438\u0435 \u0441 \u042d\u0440\u0434\u0451\u0448\u0435\u043c
    \u043f\u0440\u0438\u0432\u0438\u043b\u043e \u041b\u043e\u0432\u0430\u0441\u0443 \u0441\u0442\u0438\u043b\u044c
    \u00ab\u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439\u00bb \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0433\u0434\u0435 \u0438\u0434\u0435\u0438 \u0438 \u043d\u0435\u043f\u043e\u043b\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e
    \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044e\u0442\u0441\u044f \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438.
    \u0421\u0430\u043c \u041b\u043e\u0432\u0430\u0441 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b,
    \u0447\u0442\u043e \u042d\u0440\u0434\u0451\u0448 \u043d\u0430\u0443\u0447\u0438\u043b \u0435\u0433\u043e
    \u00ab\u043f\u043e\u043b\u043d\u043e\u0439 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0441\u0442\u0438
    \u0432 \u0437\u0430\u0434\u0430\u0447\u0430\u0445 \u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445\u00bb, \u0447\u0442\u043e
    \u043d\u0435\u0438\u0437\u0431\u0435\u0436\u043d\u043e \u0432\u0435\u0434\u0451\u0442 \u043a
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0443.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435
    \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u0438 \u0428\u043a\u043e\u043b\u044c\u043d\u0430\u044f
    \u043b\u044e\u0431\u043e\u0432\u044c: \u041b\u043e\u0432\u0430\u0441 \u0436\u0435\u043d\u0430\u0442
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u041a\u0430\u0442\u0430\u043b\u0438\u043d
    \u0412\u0435\u0441\u0442\u0435\u0440\u0433\u043e\u043c\u0431\u0438, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0443\u0447\u0438\u043b\u0438\u0441\u044c
    \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u0435
    \u0434\u043b\u044f \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0445 \u0434\u0435\u0442\u0435\u0439.
    \u0418\u0445 \u0441\u043e\u044e\u0437 \u2014 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0439, \u043d\u043e \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439:
    \u043e\u043d\u0438 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u043c\u0438
    \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u0430\u043c\u0438. \u041a\u0443\u0440\u044c\u0451\u0437
    \u0441 \u0444\u0430\u043c\u0438\u043b\u0438\u0435\u0439: \u0412\u0430\u0436\u043d\u043e
    \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e \u0432 \u0440\u0443\u0441\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435 \u0444\u0430\u043c\u0438\u043b\u0438\u044f \u041b\u043e\u0432\u0430\u0441
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u043e\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u0435\u0439
    \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439 \u0444\u0430\u043c\u0438\u043b\u0438\u0438
    Lov\u00e1sz, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u0438\u043c\u044f
    \u041b\u043e\u0432\u0435\u043b\u0430\u0441 (\u043e\u0442 \u0430\u043d\u0433\u043b. Lovelace)
    \u2014 \u044d\u0442\u043e \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0439
    \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436-\u0440\u0430\u0441\u043f\u0443\u0442\u043d\u0438\u043a
    \u0438\u0437 \u0440\u043e\u043c\u0430\u043d\u0430 \u0421\u044d\u043c\u044e\u044d\u043b\u0430
    \u0420\u0438\u0447\u0430\u0440\u0434\u0441\u043e\u043d\u0430 \u00ab\u041a\u043b\u0430\u0440\u0438\u0441\u0441\u0430\u00bb,
    \u0447\u044c\u0451 \u0438\u043c\u044f \u0441\u0442\u0430\u043b\u043e \u043d\u0430\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c.
    \u042d\u0442\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0440\u0430\u0437\u043d\u044b\u0435
    \u043b\u044e\u0434\u0438, \u0438 \u0438\u0445 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u0430
    \u0431\u044b\u043b\u0430 \u0431\u044b \u0437\u0430\u0431\u0430\u0432\u043d\u043e\u0439 \u043e\u0448\u0438\u0431\u043a\u043e\u0439.
    \u041a\u0430\u043a \u0432\u0438\u0434\u0438\u0442\u0435, \u041b\u0430\u0441\u043b\u043e
    \u041b\u043e\u0432\u0430\u0441 \u2014 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439, \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439
    \u0441 \u0437\u043e\u043b\u043e\u0442\u044b\u043c \u0432\u0435\u043a\u043e\u043c \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438."
