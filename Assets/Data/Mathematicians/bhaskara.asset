  achievementsRu: "\u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u2014 \u044d\u0442\u043e \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043f\u0438\u0441\u043e\u043a \u0444\u043e\u0440\u043c\u0443\u043b,
    \u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0432 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043d\u0430 500\u2013600 \u043b\u0435\u0442 \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0430
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e \u043d\u0430\u0443\u043a\u0443.
    1. \u0410\u043b\u0433\u0435\u0431\u0440\u0430 (\u00ab\u0411\u0438\u0434\u0436\u0430\u0433\u0430\u043d\u0438\u0442\u0430\u00bb):
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0433\u043e
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432 \u0432
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435, \u043f\u0435\u0440\u0435\u0439\u0434\u044f \u043e\u0442
    \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0445
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432 \u043a \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u043c
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u043c \u0441 \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438.
    \u0421\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u043e\u0442\u0430\u0446\u0438\u044f:
    \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u0432 \u043c\u0438\u0440\u0435 \u043d\u0430\u0447\u0430\u043b
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0431\u0443\u043a\u0432\u044b \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0432\u0435\u043b\u0438\u0447\u0438\u043d.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u043d \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u043b
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u043a\u0430\u043a \u0439\u0430
    (\u043e\u0442 \u0441\u043b\u043e\u0432\u0430 \u0439\u0430\u0432\u0430\u0442-\u0442\u0430\u0432\u0430\u0442
    \u2014 \u00ab\u0441\u0442\u043e\u043b\u044c\u043a\u043e-\u0442\u043e\u00bb), \u0430 \u0432\u0442\u043e\u0440\u043e\u0435
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u2014 \u043a\u0430\u043a
    \u043a\u0430\u043b\u0430 (\u00ab\u0447\u0435\u0440\u043d\u044b\u0439\u00bb). \u042d\u0442\u043e
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e \u0435\u043c\u0443 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0432 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435,
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0430\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443. \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439: \u041e\u043d \u0447\u0435\u0442\u043a\u043e
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u043f\u0440\u0430\u0432\u0438\u043b\u043e,
    \u0447\u0442\u043e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0438\u043c\u0435\u0435\u0442 \u0434\u0432\u0430 \u043a\u043e\u0440\u043d\u044f. \u0412
    \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0443\u0434\u0435 \u043e\u043d \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
    \u0441\u043b\u0443\u0447\u0430\u0438 \u0441 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u043a\u043e\u0440\u043d\u044f\u043c\u0438, \u043f\u0440\u0438\u0447\u0435\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u043e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u0435\u0442 \u043a\u0430\u043a \u043f\u043e\u043b\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u044b\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f (\u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u0430\u043a \u043c\u043d\u043e\u0433\u0438\u0435 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438 \u0434\u0430\u0436\u0435 \u0440\u0430\u043d\u043d\u0438\u0435 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043e\u0442\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043b\u0438
    \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430
    \u043a\u0430\u043a \u00ab\u043d\u0435\u043b\u0435\u043f\u044b\u0435\u00bb). \u0426\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434 \u00ab\u0427\u0430\u043a\u0440\u0430\u0432\u0430\u043b\u0430\u00bb
    (\u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u041f\u0435\u043b\u043b\u044f): \u042d\u0442\u043e \u0435\u0433\u043e \u0437\u043e\u043b\u043e\u0442\u043e\u0439
    \u0432\u0435\u043d\u0435\u0446. \u041e\u043d \u0440\u0435\u0448\u0438\u043b \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0432\u0438\u0434\u0430 \\( x^2
    = 1 + p y^2 \\). \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0432\u043e\u0434\u0438\u043b \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0441\u043b\u0443\u0447\u0430\u0438
    \u043a \u043f\u0440\u043e\u0441\u0442\u044b\u043c, \u043f\u043e\u043b\u0443\u0447\u0430\u044f
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0432 \u0446\u0435\u043b\u044b\u0445 \u0447\u0438\u0441\u043b\u0430\u0445.
    \u041f\u0440\u0438\u043c\u0435\u0440: \u0414\u043b\u044f \\( p = 61 \\) \u043e\u043d \u043d\u0430\u0448\u0435\u043b
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435: \\( x = 1,766,319,049 \\) \u0438 \\( y = 226,153,980
    \\). (\u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0446\u044b, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0424\u0435\u0440\u043c\u0430 \u0438 \u042d\u0439\u043b\u0435\u0440\u0430, \u0441\u043c\u043e\u0433\u043b\u0438
    \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0437 500 \u043b\u0435\u0442!).
    \u0410\u043d\u0430\u043b\u0438\u0437 \u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043d\u0430
    \u043d\u043e\u043b\u044c: \u041e\u043d \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u043b\u0441\u044f
    \u043a \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438.
    \u0412 \u00ab\u0411\u0438\u0434\u0436\u0430\u0433\u0430\u043d\u0438\u0442\u0435\u00bb \u043e\u043d
    \u043f\u0438\u0448\u0435\u0442: \u00ab\u0412\u0435\u043b\u0438\u0447\u0438\u043d\u0430,
    \u0434\u0435\u043b\u0435\u043d\u043d\u0430\u044f \u043d\u0430 \u043d\u043e\u043b\u044c,
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0434\u0440\u043e\u0431\u044c\u044e,
    \u0437\u043d\u0430\u043c\u0435\u043d\u0430\u0442\u0435\u043b\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0440\u0430\u0432\u0435\u043d \u043d\u0443\u043b\u044e. \u042d\u0442\u0443 \u0434\u0440\u043e\u0431\u044c
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u043e\u0439\u00bb.
    \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u0432\u0432\u0435\u043b \u0438\u0434\u0435\u044e,
    \u0447\u0442\u043e \\( a/0 = \\infty \\), \u0445\u043e\u0442\u044f \u0438 \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e
    \u043f\u043e\u043b\u0430\u0433\u0430\u043b, \u0447\u0442\u043e \\( \\infty \\times 0 = a
    \\). --- 2. \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u0438 \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b (\u00ab\u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438\u00bb):
    \u041e\u043f\u0435\u0440\u0435\u0436\u0430\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0443
    \u00ab\u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438\u00bb (\u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432 \u0447\u0435\u0441\u0442\u044c \u0435\u0433\u043e \u0434\u043e\u0447\u0435\u0440\u0438
    \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435) \u2014 \u044d\u0442\u043e \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0434\u0430\u0447\u043d\u0438\u043a. \u042d\u0442\u043e
    \u043a\u043b\u0430\u0434\u0435\u0437\u044c \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u044b\u0445
    \u0434\u043e\u0433\u0430\u0434\u043e\u043a, \u0441\u0442\u0430\u0432\u0448\u0438\u0445 \u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u043c\u0438 \u043f\u043e\u0437\u0436\u0435. \u041f\u0440\u0438\u0437\u043d\u0430\u043a\u0438
    \u0434\u0435\u043b\u0438\u043c\u043e\u0441\u0442\u0438: \u041e\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438
    \u0434\u0435\u043b\u0438\u043c\u043e\u0441\u0442\u0438 \u0447\u0438\u0441\u0435\u043b (\u043d\u0430
    3, 7, 11, 13 \u0438 \u0442.\u0434.), \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e
    \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438\u0437\u0443\u0447\u0430\u044e\u0442 \u0432
    \u0448\u043a\u043e\u043b\u0435, \u043d\u043e \u0432 \u0431\u043e\u043b\u0435\u0435 \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438. \u041a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0430:
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0434\u0430\u043b \u0447\u0435\u0442\u043a\u0438\u0435
    \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b
    \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0447\u0438\u0441\u043b\u0430
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a \u0438 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0439.
    \u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a:
    \\( P_n = 1 \\times 2 \\times 3 \\times... \\times n \\) (\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u0430\u043b).
    \u0411\u0438\u043d\u043e\u043c\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u044b:
    \u041e\u043d \u0437\u043d\u0430\u043b, \u043a\u0430\u043a \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0439,
    \u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u043b\u0430\u0434\u0435\u043b
    \u0431\u0438\u043d\u043e\u043c\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0434\u043b\u044f
    \u0446\u0435\u043b\u044b\u0445 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439, \u0445\u043e\u0442\u044f \u0438 \u043d\u0435
    \u0437\u0430\u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e \u0432 \u043e\u0431\u0449\u0435\u043c
    \u0432\u0438\u0434\u0435. \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u044d\u0442\u0438 \u0437\u043d\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447 \u043e \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438
    \u0432\u043a\u0443\u0441\u043e\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u0432
    \u0441\u043c\u0435\u0448\u0430\u0442\u044c 6 \u0438\u043d\u0433\u0440\u0435\u0434\u0438\u0435\u043d\u0442\u043e\u0432).
    \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0435 \u0438 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u043d\u0438: \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u0431\u044b\u0441\u0442\u0440\u044b\u0435
    \u0438\u0442\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0434\u043b\u044f \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u0440\u043d\u0435\u0439
    \u0438\u0437 \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u043c\u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430\u043c\u0438
    \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e. --- 3. \u0422\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0438 \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041e\u0442 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0435\u0439
    \u043a \u0441\u0444\u0435\u0440\u0430\u043c \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432,
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u043d\u0435 \u0441\u0442\u0430\u0442\u0438\u0447\u043d\u043e,
    \u0430 \u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 (\u0432 \u0441\u0432\u044f\u0437\u0438
    \u0441 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439). \u0421\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041e\u043d \u0434\u0430\u043b
    \u0442\u043e\u0447\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0434\u043b\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0434\u043b\u0438\u043d\u044b
    \u0434\u0443\u0433\u0438 \u043d\u0430 \u0441\u0444\u0435\u0440\u0435. \u042d\u0442\u043e
    \u0431\u044b\u043b\u043e \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e \u0434\u043b\u044f
    \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u0430
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432\u043e\u0441\u0445\u043e\u0434\u0430/\u0437\u0430\u0445\u043e\u0434\u0430
    \u0437\u0432\u0435\u0437\u0434. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430:
    \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u043d\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443, \u043e\u043d \u0434\u0430\u043b \u0434\u0432\u0430
    \u0440\u0430\u0437\u043d\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    (\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043f\u043e\u0434\u043e\u0431\u0438\u0435
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432 \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043f\u043b\u043e\u0449\u0430\u0434\u0438), \u0438 \u043e\u0431\u0430 \u0431\u044b\u043b\u0438
    \u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438 \u0438 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u043c\u0438.
    \u0423\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435 \u0447\u0438\u0441\u043b\u0430 \u03c0:
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0434\u0440\u0435\u0432\u043d\u0438\u0445,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0433\u0440\u0443\u0431\u044b\u043c \u0447\u0438\u0441\u043b\u043e\u043c 3, \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0434\u0432\u0430 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f:
    \u041f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u043d\u043e\u0435 \u0434\u043b\u044f
    \u0431\u044b\u0442\u043e\u0432\u044b\u0445 \u0437\u0430\u0434\u0430\u0447: \\( \\sqrt{10}
    \\approx 3,1622 \\). \u0422\u043e\u0447\u043d\u043e\u0435 \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438:
    \\( 3,141666... \\) (\u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043b\u0443\u0447\u0448\u0438\u0445 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0439
    \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u0442\u043e\u0447\u043d\u043e\u0435 \u0434\u043e \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e
    \u0437\u043d\u0430\u043a\u0430). \u0418\u0434\u0435\u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f:
    \u0418\u0437\u0443\u0447\u0430\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0435\u0442,
    \u043e\u043d \u0432\u0432\u0435\u043b \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e
    \u00ab\u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438\u00bb
    \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b, \u0447\u0442\u043e
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445
    \u0442\u043e\u0447\u043a\u0430\u0445. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442, \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u0434\u043e\u0448\u0435\u043b
    \u0432\u043f\u043b\u043e\u0442\u043d\u0443\u044e \u043a \u043f\u043e\u043d\u044f\u0442\u0438\u044e
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044f,
    \u043a\u0430\u043a \u0438\u0437\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f
    \u043f\u0440\u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u043e\u043c
    \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u0430
    (\u0445\u043e\u0442\u044f \u043e\u043d \u043d\u0435 \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e \u043a\u0430\u043a \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b,
    \u043a\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d). --- 4. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f
    (\u00ab\u0413\u043e\u043b\u0430\u0434\u0445\u0430\u0439\u044f\u00bb \u0438 \u00ab\u0413\u0440\u0430\u043d\u0445\u0430\u0433\u0430\u043d\u0438\u0442\u0430\u00bb):
    \u041f\u0435\u0440\u0435\u0445\u043e\u0434 \u043a \u0444\u0438\u0437\u0438\u043a\u0435 \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0435\u0431\u044f \u0432 \u043f\u0435\u0440\u0432\u0443\u044e
    \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c,
    \u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0431\u044b\u043b\u0430
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c.
    \u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u044d\u043f\u0438\u0446\u0438\u043a\u043b\u043e\u0432:
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f,
    \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442 \u0438\u0434\u0435\u0438
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u043e\u0432\u044b\u0445
    \u043e\u0440\u0431\u0438\u0442 \u043f\u043b\u0430\u043d\u0435\u0442. \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043c\u043e\u0434\u0435\u043b\u044c, \u0433\u0434\u0435 \u043f\u043b\u0430\u043d\u0435\u0442\u044b
    \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044f \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043e\u0440\u0431\u0438\u0442\u0430\u043c, \u0445\u043e\u0442\u044f \u0438 \u043d\u0435
    \u0434\u043e\u0432\u0435\u043b \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0440\u0430\u0441\u0447\u0435\u0442
    \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 (\u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0435\u0442
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0447\u0435\u0440\u0435\u0437 400 \u043b\u0435\u0442).
    \u041e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438:
    \u0412 \u0442\u0440\u0443\u0434\u0435 \u00ab\u0413\u043e\u043b\u0430\u0434\u0445\u0430\u0439\u044f\u00bb
    \u043e\u043d \u0434\u0430\u0435\u0442 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0434\u043b\u044f XII \u0432\u0435\u043a\u0430 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435
    \u043f\u0440\u0438\u0447\u0438\u043d\u044b, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u043f\u0430\u0434\u0430\u044e\u0442 \u043d\u0430
    \u0417\u0435\u043c\u043b\u044e: \u00ab\u0417\u0435\u043c\u043b\u044f \u043f\u0440\u0438\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0441\u0432\u043e\u0435\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0441\u0438\u043b\u043e\u0439. \u042d\u0442\u0430 \u0441\u0438\u043b\u0430 \u043f\u0440\u0438\u0442\u044f\u0436\u0435\u043d\u0438\u044f
    \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0438\u0445 \u043f\u0430\u0434\u0430\u0442\u044c
    \u043d\u0430 \u0437\u0435\u043c\u043b\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0446\u0435\u043d\u0442\u0440\u043e\u043c\u00bb.
    \u042d\u0442\u043e \u043f\u0435\u0440\u0432\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430, \u0431\u043b\u0438\u0437\u043a\u0430\u044f
    \u043a \u0437\u0430\u043a\u043e\u043d\u0443 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f (\u0437\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u041d\u044c\u044e\u0442\u043e\u043d\u0430!). \u0412\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u0441\u0438\u043d\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430
    \u043f\u043b\u0430\u043d\u0435\u0442: \u041e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b
    \u0441 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0432\u0440\u0435\u043c\u044f, \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u043b\u0430\u043d\u0435\u0442\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0442\u0443 \u0436\u0435 \u0442\u043e\u0447\u043a\u0443 \u043d\u0435\u0431\u0430.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0435\u0433\u043e \u0440\u0430\u0441\u0447\u0435\u0442\u044b
    \u0441\u0438\u0434\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430
    \u0421\u0430\u0442\u0443\u0440\u043d\u0430 \u0438 \u042e\u043f\u0438\u0442\u0435\u0440\u0430
    \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0438\u0441\u044c \u043e\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0434\u0430\u043d\u043d\u044b\u0445 \u043c\u0435\u043d\u0435\u0435 \u0447\u0435\u043c \u043d\u0430
    1%. \u041f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435
    \u00ab\u0412\u0435\u0447\u043d\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f\u00bb:
    \u0412 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0447\u0435\u0440\u0442\u0435\u0436 \u043a\u043e\u043b\u0435\u0441\u0430 \u0441 \u043d\u0430\u043a\u043b\u043e\u043d\u043d\u044b\u043c\u0438
    \u0442\u0440\u0443\u0431\u043a\u0430\u043c\u0438, \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u043c\u0438
    \u0440\u0442\u0443\u0442\u044c\u044e. \u041f\u0440\u0438 \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u0440\u0442\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0442\u0435\u043a\u0430\u043b\u0430,
    \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u044f \u0434\u0438\u0441\u0431\u0430\u043b\u0430\u043d\u0441.
    \u0425\u043e\u0442\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u0442\u0430\u043a\u043e\u0439
    \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043d\u0435 \u043c\u043e\u0433 (\u0438\u0437-\u0437\u0430 \u0442\u0440\u0435\u043d\u0438\u044f),
    \u0441\u0430\u043c \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0438\u043d\u0435\u0440\u0446\u0438\u0438
    \u0438 \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0441\u0438\u043b\u044b \u0431\u044b\u043b
    \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d
    \u0438\u043c \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435, \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u043c
    \u0435\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c.
    --- \u0420\u0435\u0437\u044e\u043c\u0435: \u041c\u0435\u0441\u0442\u043e \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043d\u0430\u0443\u043a\u0438 \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 II \u2014
    \u044d\u0442\u043e \u043c\u043e\u0441\u0442 \u043c\u0435\u0436\u0434\u0443 \u0434\u0440\u0435\u0432\u043d\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0415\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434 \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d \u0442\u0435\u043c,
    \u0447\u0442\u043e \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043c\u043d\u043e\u0433\u0438\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e
    \u043d\u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0441\u0442\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0447\u0435\u0440\u0435\u0437 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442 \u043d\u0430 \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0439
    (\u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u044c)
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0435 \u0443\u0447\u0435\u043d\u044b\u0435
    \u044d\u043f\u043e\u0445\u0438 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0438\u0441\u044c \u0441 \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u043e\u0439. \u0415\u0441\u043b\u0438 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c
    \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e, \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0435
    \u0432\u0435\u043b\u0438\u043a\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u2014 \u044d\u0442\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041e\u043d \u0440\u0435\u0448\u0430\u043b
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438, \u0447\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430,
    \u043d\u043e \u043d\u0430 \u0448\u0435\u0441\u0442\u044c \u0432\u0435\u043a\u043e\u0432
    \u0440\u0430\u043d\u044c\u0448\u0435."
  achievementsEn: "His contribution is not just a list of formulas, but a real revolution in thinking that has been 500 to 600 years ahead of European science. 1. Algebra (Bijaganita): The birth of Bhaskar's abstract thinking has made a breakthrough in algebra, moving from concrete numerical examples to abstract operations with symbols.For example, he referred to the unknown as ya (from the word yawat-tawat to the word \"only\") and the second unknown as the kala (\"black\"). This allowed him to write complex equations in a compact form that pre-empted modern algebra. The solution of the square equations: He made clear the rule that the square equation has two roots.In his work, he considers positive and negative cases, the latter recognizing as full solutions (while many Greek and even early European mathematicians cast negative numbers as \"unbelievable\"). The cyclical method \"Chakrava\" (Pell equation solution): This is his golden crown. He decided the uncertain equation of species \\(xx×2 = 1 + p \\).Bhaskara developed an algorithm that reduced complex cases to simple ones, with solutions in whole numbers. Example: For \\(p = 61 \\) he found a solution: \\(x = 1.76.319.049 \\) and \\(y = 226.153.980 \\). (Europeans, including Ferma and Eiler, were not able to repeat this result until 500 years later!) Analysis of the division zero: It came closer to understanding infinity.In the Bijaganite, he writes: \"The great thing divided by zero becomes a fraction whose denominator is zero. This is called an infinitely large one.\" He first introduced the idea that \\(a/0 = \\infty\\), although he mistakenly believed that \\(\\\\ifty \\times 0 = a\\).--2. Arifmetics and theory of the chips (Lilavati) are not just a task force.This is a set of intuitive guesses that became strict theories later on. The evidence of divisionality: He has systematized and improved the rules for checking the divisionality of numbers (on 3, 7, 11, 13, etc.) that are still being studied at school, but in a more complex version. The combination: Bhaskara has provided clear and correct formulas for calculating the number of reshufflings and combinations. The formula for resets: \\(P_n = 1 \\times 2 \\times 3 \\times ... \\times n\\) (factorial).Binomic coefficients: He knew how to compute the number of combinations, and he actually owned Newton's binoma for whole positive degrees, although he didn't write it in general. He used that knowledge to solve problems about combos (e.g. how many ways to mix six ingredients).Square and cubic roots: He developed extremely fast iterative methods to extract roots from large numbers used by Indian astronomers for calculations with high accuracy. -- 3. Trigonometry and Geometry: From planes to spheres, unlike many predecessors, Bhaskar considered geometry not static, but in motion (in connection with astronomy).Spherical Geometry: He gave precise formulas for calculating the length of the arc on the sphere. It was critical for navigation and the calculation of the sun's rising time/set. The Pythagoras Theorem: He didn't just know the theorem, he gave two different evidences (using triangles and using squares) and both were strict and elegant.Clarifying the number pi: Unlike the ancients, who often used a rough number of 3, Bhaskara used two values: \\(\\\\sqrt\\10}\\approx 3.1622 \\) Precisely for astronomy:(3.141666...\\) (which is one of the best approaches for his time, accurate to the third sign).Ideas of differentiation: In studying the motion of planets, he introduced the concept of \"flammable speed\" and stated that the maximum value of sinus difference is reached at certain points. Mathematicians believe that he has come close to the concept of derivative, describing how function changes with infinitely little change of argument (although he has not formalized it as a differential like Newton). --4.Astronomia (Goladhaya and Granhaganita): The transition to physics in Bhaskara was primarily an astronomer, and mathematics was a tool for him. The rejection of epicycles: Unlike Ptolemy, he gave up the idea of complex circular orbits of planets. He suggested a model where planets move in elliptical orbits, although he did not complete the calculation of this model (Kepler will do it in 400 years).He explains the gravity: \"In the work of Goldhaya,\" he explains in a striking sense the reason why things fall to the earth: \"The earth attracts objects with its own power.Calculation of the synodic period of planets: He calculated with remarkable accuracy the time in which the planet returns to the same point in the sky. For example, his calculations of the Syderic period of Saturn and Jupiter differed by less than 1% from the current data. \"Eternal engine\" prediction: In mechanics, he developed a drawing of a wheel with inclined tubes filled with mercury. When mercury was rotated, he diverted, creating an imbalance.Although such an engine could not physically operate (due to friction), the very principle of inertia and force was analysed by it at a level that was not available to its contemporaries. -- Summary: The place in the history of Bhaskar II is a bridge between ancient mathematics and modern mathematics. His contribution is unique in that he has proved many theorems that have just been postulated before him.It was through the translation of his works into Arabic (and then into Latin) that European Renaissance scientists were introduced to the positional system of numeracy and algebra; in detail, his greatest achievement is the integration of algebra and geometry, and he solved geometrical problems algebraically, which became the basis for the analytical geometry of Decart, but six centuries earlier."
  personalLifeRu: "\u0414\u0435\u0442\u0430\u043b\u0438 \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b II, \u043a\u0430\u043a \u044d\u0442\u043e
    \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u0432\u0430\u0435\u0442 \u0441 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0444\u0438\u0433\u0443\u0440\u0430\u043c\u0438 \u0442\u043e\u0439 \u044d\u043f\u043e\u0445\u0438,
    \u043e\u043a\u0443\u0442\u0430\u043d\u044b \u043f\u0435\u043b\u0435\u043d\u043e\u0439 \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0438 \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u044b \u0441 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u043c\u0438.
    \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442
    \u043b\u0438\u0448\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438
    \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u044b\u043c\u0438 \u0444\u0430\u043a\u0442\u0430\u043c\u0438,
    \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043f\u043e\u0447\u0435\u0440\u043f\u043d\u0443\u0442\u044b\u043c\u0438
    \u0438\u0437 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432 \u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445
    \u043d\u0430\u0434\u043f\u0438\u0441\u0435\u0439, \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0432\u043e\u0441\u043f\u043e\u043b\u043d\u044f\u044e\u0442 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435
    \u043f\u0440\u0435\u0434\u0430\u043d\u0438\u044f. \u0412\u043e\u0442 \u0447\u0442\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u044f \u0444\u0430\u043a\u0442\u044b
    \u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u044b.\n\n\U0001F4DC \u0414\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b: \u0441\u0435\u043c\u044c\u044f, \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u044f
    \u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0438 \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0441\u043a\u0443\u0434\u043d\u043e\u0441\u0442\u044c \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439,
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u0442\u0430\u043b\u0438
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u044b
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e: \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u043e\u0442\u0435\u0446: \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 1114 \u0433\u043e\u0434\u0443. \u041e\u043d \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u0434\u0435\u0448\u0430\u0441\u0442\u0445\u0430-\u0431\u0440\u0430\u0445\u043c\u0430\u043d\u043e\u0432
    (\u044d\u0442\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430
    \u0431\u0440\u0430\u0445\u043c\u0430\u043d\u043e\u0432 \u0432 \u0418\u043d\u0434\u0438\u0438).
    \u0415\u0433\u043e \u043e\u0442\u0446\u0430 \u0437\u0432\u0430\u043b\u0438 \u041c\u0430\u0445\u0435\u0448\u0432\u0430\u0440\u0430
    (\u0438\u043b\u0438 \u041c\u0430\u0445\u0430\u0434\u0435\u0432\u0430). \u041e\u043d \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0446\u043e\u043c, \u0430
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c \u0438 \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438 \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b.
    \u0414\u0438\u043d\u0430\u0441\u0442\u0438\u044f \u0443\u0447\u0435\u043d\u044b\u0445: \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u043d\u0430\u043d\u0438\u044f \u0432 \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0435
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0434\u0435\u043b\u043e\u043c. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043f\u0440\u0430\u043f\u0440\u0430\u043f\u0440\u0430\u0434\u0435\u0434
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u043f\u043e\u0442\u043e\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e. \u042d\u0442\u0443 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044e
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b,
    \u043f\u0435\u0440\u0435\u0434\u0430\u0432 \u0437\u043d\u0430\u043d\u0438\u044f \u0441\u0432\u043e\u0435\u043c\u0443
    \u0441\u044b\u043d\u0443 \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u041b\u043e\u043a\u0448\u0430\u043c\u0443\u0434\u0440\u0430
    (Lokasamudra). \u0412\u043d\u0443\u043a \u0438 \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430: \u0415\u0433\u043e \u0432\u043d\u0443\u043a, \u0427\u0430\u043d\u0433\u0430\u0434\u0435\u0432\u0430
    (Changadeva), \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u0448\u0435\u043b \u043f\u043e
    \u0441\u0442\u043e\u043f\u0430\u043c \u043f\u0440\u0435\u0434\u043a\u043e\u0432 \u0438 \u0441\u0442\u0430\u043b
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435
    \u0446\u0430\u0440\u044f \u0421\u0438\u043d\u0433\u0445\u0430\u043d\u044b \u0438\u0437 \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0438
    \u042f\u0434\u0430\u0432\u0430. \u0412 1207 \u0433\u043e\u0434\u0443 (\u0443\u0436\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b)
    \u0427\u0430\u043d\u0433\u0430\u0434\u0435\u0432\u0430 \u043f\u043e\u043c\u043e\u0433 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u044c
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041f\u0430\u0442\u0430\u043d
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f
    \u0442\u0440\u0443\u0434\u043e\u0432 \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u0435\u0434\u0430,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0432\u044b\u0441\u043e\u043a\u043e\u043c
    \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0438 \u043a \u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044e
    \u0432\u043d\u0443\u0442\u0440\u0438 \u0441\u0435\u043c\u044c\u0438. \u0421\u043c\u0435\u0440\u0442\u044c:
    \u041e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 1185 \u0433\u043e\u0434\u0443
    \u0432 \u0423\u0434\u0434\u0436\u0430\u0439\u043d\u0435, \u0433\u0434\u0435 \u0438 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u043b
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044e.\n\n\u2764\ufe0f
    \u041b\u0435\u0433\u0435\u043d\u0434\u0430 \u043e \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438:
    \u00ab\u041f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f\u00bb \u0434\u043e\u0447\u044c
    \u0421\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0438
    \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0435\u0433\u043e \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438, \u0432 \u0447\u0435\u0441\u0442\u044c
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0442\u0440\u0443\u0434
    \u043f\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435. \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435
    \u00ab\u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438\u00bb \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u0442\u0441\u044f
    \u043a\u0430\u043a \u00ab\u041f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f\u00bb
    \u0438\u043b\u0438 \u00ab\u0418\u0433\u0440\u0438\u0432\u0430\u044f\u00bb. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u044d\u0442\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u044b, \u043d\u043e \u0441\u0443\u0442\u044c
    \u0438\u0445 \u0435\u0434\u0438\u043d\u0430: \u0422\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0431\u0440\u0430\u043a: \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u043c, \u0438\u0437\u0443\u0447\u0438\u043b
    \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f \u0441\u0432\u043e\u0435\u0439 \u0434\u043e\u0447\u0435\u0440\u0438
    \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u043e\u043d\u0430 \u043e\u0432\u0434\u043e\u0432\u0435\u0435\u0442 \u0432\u0441\u043a\u043e\u0440\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043c\u0443\u0436\u0435\u0441\u0442\u0432\u0430,
    \u0435\u0441\u043b\u0438 \u0441\u0432\u0430\u0434\u044c\u0431\u0430 \u0441\u043e\u0441\u0442\u043e\u0438\u0442\u0441\u044f
    \u043d\u0435 \u0432 \u0441\u0442\u0440\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0439,
    \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439 \u0447\u0430\u0441.
    \u0420\u043e\u043a\u043e\u0432\u0430\u044f \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u044c:
    \u0427\u0442\u043e\u0431\u044b \u0441\u043f\u0430\u0441\u0442\u0438 \u0434\u043e\u0447\u044c,
    \u043e\u043d \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0432\u043e\u0434\u044f\u043d\u044b\u0435
    \u0447\u0430\u0441\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e\u043b\u0436\u043d\u044b
    \u0431\u044b\u043b\u0438 \u0442\u043e\u0447\u043d\u043e \u043e\u0442\u043c\u0435\u0440\u0438\u0442\u044c
    \u044d\u0442\u043e\u0442 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442.
    \u041e\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u043f\u0440\u0438\u0431\u043e\u0440
    \u0432 \u043a\u043e\u043c\u043d\u0430\u0442\u0435 \u0438 \u0441\u0442\u0440\u043e\u0433\u043e
    \u043d\u0430\u043a\u0430\u0437\u0430\u043b \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438
    \u043d\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442\u044c \u043a \u043d\u0435\u043c\u0443.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u0441\u0442\u0432\u043e
    \u0432\u0437\u044f\u043b\u043e \u0432\u0435\u0440\u0445: \u0434\u0435\u0432\u0443\u0448\u043a\u0430
    \u043f\u043e\u0434\u043e\u0448\u043b\u0430 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u043d\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c, \u0438 \u0432 \u044d\u0442\u043e\u0442
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0436\u0435\u043c\u0447\u0443\u0436\u0438\u043d\u0430
    \u0438\u0437 \u0435\u0451 \u043d\u043e\u0441\u043e\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u044c\u0446\u0430
    \u0443\u043f\u0430\u043b\u0430 \u0432 \u0432\u043e\u0434\u0443 \u0438 \u0437\u0430\u043a\u0443\u043f\u043e\u0440\u0438\u043b\u0430
    \u0441\u043b\u0438\u0432\u043d\u043e\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435,
    \u043d\u0430\u0440\u0443\u0448\u0438\u0432 \u0445\u043e\u0434 \u0447\u0430\u0441\u043e\u0432.
    \u0423\u0442\u0435\u0448\u0435\u043d\u0438\u0435 \u0432 \u043d\u0430\u0443\u043a\u0435:
    \u0412\u0440\u0435\u043c\u044f \u0431\u044b\u043b\u043e \u0443\u043f\u0443\u0449\u0435\u043d\u043e,
    \u0441\u0432\u0430\u0434\u044c\u0431\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c
    \u0432 \u043d\u0435\u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439
    \u0447\u0430\u0441, \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435
    \u0441\u0431\u044b\u043b\u043e\u0441\u044c: \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438
    \u0441\u0442\u0430\u043b\u0430 \u0432\u0434\u043e\u0432\u043e\u0439. \u0427\u0442\u043e\u0431\u044b
    \u0443\u0442\u0435\u0448\u0438\u0442\u044c \u0434\u043e\u0447\u044c \u0432 \u0435\u0435
    \u0433\u043e\u0440\u0435 (\u0430 \u0432\u0434\u043e\u0432\u0430 \u0432 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u043d\u0435 \u043c\u043e\u0433\u043b\u0430
    \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u044b\u0439\u0442\u0438 \u0437\u0430\u043c\u0443\u0436),
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0434\u043b\u044f \u043d\u0435\u0451 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442, \u043d\u0430\u043f\u043e\u043b\u043d\u0438\u0432
    \u0435\u0433\u043e \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438 \u0438 \u0441\u0442\u0438\u0445\u0430\u043c\u0438.
    \u0422\u0430\u043a \u0438\u043c\u044f \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438 \u0441\u0442\u0430\u043b\u043e
    \u0431\u0435\u0441\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u043c. \u0412\u0430\u0436\u043d\u043e
    \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a \u044d\u0442\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u0435
    \u0441 \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e. \u041f\u043e
    \u043c\u043d\u0435\u043d\u0438\u044e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u043d\u0435\u0442
    \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438
    \u0431\u044b\u043b\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439, \u0430 \u043d\u0435 \u0432\u044b\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u043c
    \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u043c \u0438\u043b\u0438 \u0434\u0430\u0436\u0435
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u043c \u043f\u0440\u0438\u0435\u043c\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b, \u0447\u0442\u043e\u0431\u044b
    \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0431\u043e\u043b\u0435\u0435
    \u0436\u0438\u0432\u044b\u043c \u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u043c.
    \u0421\u0430\u043c\u0430 \u043b\u0435\u0433\u0435\u043d\u0434\u0430 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u043e\u043c
    \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438 \u043a \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0435, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c, \u0447\u0442\u043e
    \u043e\u043d\u0430 \u043c\u043e\u0433\u043b\u0430 \u0431\u044b\u0442\u044c \u0431\u043e\u043b\u0435\u0435
    \u043f\u043e\u0437\u0434\u043d\u0438\u043c \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b II \u0434\u043b\u044f
    \u043d\u0430\u0441 \u2014 \u044d\u0442\u043e, \u0441 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b,
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u0430\u044f \u0446\u0435\u043f\u043e\u0447\u043a\u0430
    \u0443\u0447\u0435\u043d\u044b\u0445-\u0431\u0440\u0430\u0445\u043c\u0430\u043d\u043e\u0432,
    \u0430 \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u2014 \u043a\u0440\u0430\u0441\u0438\u0432\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e\u0431 \u043e\u0442\u0446\u043e\u0432\u0441\u043a\u043e\u0439
    \u043b\u044e\u0431\u0432\u0438, \u0441\u0442\u0430\u0432\u0448\u0430\u044f \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b\u0435\u043c\u043e\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f."
  personalLifeEn: "The details of Bhaskara II's personal life, as is often the case with historical figures of that era, are wrapped around diaper time and bound with legends. The historians have only a few credible facts, mostly drawn from his own works and later inscriptions, and the rest are filled with beautiful traditions. This is what is known about his personal life, sharing facts and legends.\n\nThe facts of the family, dynasty, and students, despite the scarcity of information, are well documented: Origin and Father: Bhaskara was born in 1114; he came from the family of Deshastha-Brahman (an ethnic group of Brahmans in India), and his father was called Maheshwara (or Mahadeva), not just a father, but a famous mathematician, astronomer and astrologer, who became the first teacher of Bhaskara.Science: Mathematical knowledge in his family was an inheritance, and his great-great-great-great-grandfather was known to have been the successor of a court scientist, a tradition that Bhaskara continued to pass on knowledge to his son, Lockshamuddra, a grandson and a science school: his grandson, Changadewa, also followed in the footsteps of his ancestors, and became an astronomer at King Singh's court from the Yadada dynasty.In 1207 (even after the death of Bhaskara), Changadewa helped to set up a school in Patan City specifically to study his grandfather's work, which shows high respect for his family's inheritance, death: he died in 1185 in Udjain, where he led an astronomical observatory.\n\nThe legend of Lilavata: \"The beautiful\" daughter The most famous and romantic story in Bhaskara's life is related to his daughter Lilavati, who he named after after his famous arithmetic work. The name Lilavati is translated as \"The beautiful\" or \"The gig\".There are several ways of this legend, but the essence of it is one: A tragic marriage: Bhaskara, as an astrologer, studied her daughter's horoscope and predicted that she would be widowed soon after marriage, if the wedding was not held at a fixed, happy hour.And when he set up the device in the room, he severely punished Lilavati not to approach it, but the curiosity prevailed: the girl came to see the mechanism, and at that moment the pearl from her nose ring fell into the water, and sealed the drain, breaking the clock.To comfort her daughter in her grief (and the widow in Indian society could no longer marry), Bhaskara wrote a math tract for her, filling it with fascinating tasks and poems. This made the name Lilavati immortal. It is important to note that historians are cautious about this legend.According to some researchers, there is no convincing evidence that Lilavati was a real historical figure, not a fictional character, or even a literary technique that Bhaskara used to make his math textbook more alive and interesting. The legend itself first appears in a Persian commentary to his work, suggesting that it might have been a later addition.Thus, Bhaskar II's personal life is, on the one hand, a confirmed chain of brahman scientists and, on the other, a beautiful story of fatherly love that has become an integral part of his scientific heritage."
  shortBioRu: "\u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 II (\u0442\u0430\u043a\u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043a\u0430\u043a \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0410\u0447\u0430\u0440\u044c\u044f,
    \u0447\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430\u00bb) \u2014 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0439
    \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c XII \u0432\u0435\u043a\u0430, \u0447\u044c\u0438
    \u0442\u0440\u0443\u0434\u044b \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0441\u0432\u043e\u0451 \u0432\u0440\u0435\u043c\u044f. \u041e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 1114 \u0433\u043e\u0434\u0443 \u0438 \u0443\u043c\u0435\u0440 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0432 1185 \u0433\u043e\u0434\u0443.\n\n\U0001F9EC \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u0443\u0442\u044c \u041e
    \u0436\u0438\u0437\u043d\u0438 \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0444\u0430\u043a\u0442\u043e\u0432, \u043e\u0434\u043d\u0430\u043a\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u043e\u043d \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u0431\u0440\u0430\u0445\u043c\u0430\u043d\u043e\u0432.
    \u0415\u0433\u043e \u043e\u0442\u0446\u0430 \u0437\u0432\u0430\u043b\u0438 \u041c\u0430\u0445\u0435\u0448\u0432\u0430\u0440\u0430,
    \u0438 \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u043c. \u0421\u0430\u043c \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435
    \u0411\u0438\u0434\u0436\u0443\u0434\u0430-\u0411\u0438\u0434\u0430 (\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439
    \u0411\u0438\u0434\u0436\u0430\u043f\u0443\u0440 \u0432 \u0448\u0442\u0430\u0442\u0435 \u041a\u0430\u0440\u043d\u0430\u0442\u0430\u043a\u0430),
    \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u043c \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e
    \u043e\u0442 \u0433\u043e\u0440 \u0421\u0430\u0445\u0438\u0430\u0434\u0440\u0438. \u0413\u043b\u0430\u0432\u043d\u044b\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0435\u0433\u043e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0441\u0442\u0430\u043b \u0433\u043e\u0440\u043e\u0434 \u0423\u0434\u0434\u0436\u0430\u0439\u043d
    \u2014 \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438 \u0434\u0440\u0435\u0432\u043d\u0435\u0439 \u0418\u043d\u0434\u0438\u0438.
    \u0422\u0430\u043c \u043e\u043d \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u043b
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044e, \u0441\u0442\u0430\u0432
    \u043f\u0440\u0435\u0435\u043c\u043d\u0438\u043a\u043e\u043c \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b.
    \u0415\u0433\u043e \u0441\u043b\u0430\u0432\u0430 \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c
    \u0432\u0435\u043b\u0438\u043a\u0430, \u0447\u0442\u043e \u0432 XIII \u0432\u0435\u043a\u0435
    \u0435\u0433\u043e \u0432\u043d\u0443\u043a, \u0427\u0430\u043d\u0433\u0430\u0434\u0435\u0432\u0430,
    \u0431\u044b\u043b \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c \u043f\u0440\u0438
    \u0434\u0432\u043e\u0440\u0435 \u0446\u0430\u0440\u044f \u0421\u0438\u043d\u0433\u0430\u0445\u0430\u043d\u044b
    \u0438\u0437 \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0438 \u042f\u0434\u0430\u0432\u0430,
    \u0430 \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0442\u0440\u0443\u0434\u043e\u0432
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b \u0431\u044b\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u044b
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0448\u043a\u043e\u043b\u044b.\n\n\U0001F48E
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434: \u00ab\u0421\u0438\u0434\u0434\u0445\u0430\u043d\u0442\u0430-\u0448\u0438\u0440\u043e\u043c\u0430\u043d\u0438\u00bb
    \u0412 1150 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    36 \u043b\u0435\u0442, \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u0441\u0432\u043e\u0439 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u00ab\u0421\u0438\u0434\u0434\u0445\u0430\u043d\u0442\u0430-\u0448\u0438\u0440\u043e\u043c\u0430\u043d\u0438\u00bb
    (\u00ab\u0412\u0435\u043d\u0435\u0446 \u0443\u0447\u0435\u043d\u0438\u044f\u00bb). \u042d\u0442\u043e
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0442\u043e\u0438\u0442
    \u0438\u0437 \u0447\u0435\u0442\u044b\u0440\u0451\u0445 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0447\u0430\u0441\u0442\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0434\u043d\u0435\u0435
    \u0441\u0442\u0430\u043b\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c\u0438
    \u043a\u043d\u0438\u0433\u0430\u043c\u0438: 1. \u00ab\u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438\u00bb
    (\u00ab\u041f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f\u00bb) \u2014 \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u043f\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    2. \u00ab\u0411\u0438\u0434\u0436\u0430\u0433\u0430\u043d\u0438\u0442\u0430\u00bb (\u00ab\u0421\u0447\u0435\u0442
    \u0441\u0435\u043c\u044f\u043d\u00bb \u0438\u043b\u0438 \u00ab\u0418\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u043a\u043e\u0440\u043d\u0435\u0439\u00bb) \u2014 \u0442\u0440\u0443\u0434 \u043f\u043e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435. 3. \u00ab\u0413\u043e\u043b\u0430\u0434\u0445\u0430\u0439\u044f\u00bb
    (\u00ab\u0421\u0444\u0435\u0440\u0430\u00bb) \u2014 \u0440\u0430\u0437\u0434\u0435\u043b,
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u044b\u0439 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u0441\u0444\u0435\u0440\u0435. 4. \u00ab\u0413\u0440\u0430\u043d\u0445\u0430\u0433\u0430\u043d\u0438\u0442\u0430\u00bb
    (\u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u00bb)
    \u2014 \u0447\u0430\u0441\u0442\u044c, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u0435\u0442.\n\n\U0001F522
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f,
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0438\u0435 \u0432\u0440\u0435\u043c\u044f
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442
    \u0438\u0434\u0435\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435
    \u0431\u044b\u043b\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u044b \u043b\u0438\u0448\u044c
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f \u0441\u043f\u0443\u0441\u0442\u044f. -
    \u0410\u043b\u0433\u0435\u0431\u0440\u0430 \u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439: \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432
    \u043c\u0438\u0440\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u043e\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u043c\u043e\u0436\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u0434\u0432\u0430 \u043a\u043e\u0440\u043d\u044f,
    \u0438, \u0445\u043e\u0442\u044f \u0438 \u0441 \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u0435\u043c,
    \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u0440\u043d\u0435\u0439.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0431\u0443\u043a\u0432\u044b \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0432\u0435\u043b\u0438\u0447\u0438\u043d,
    \u0447\u0442\u043e \u043e\u0447\u0435\u043d\u044c \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043d\u043e\u0442\u0430\u0446\u0438\u044e. - \u0420\u0430\u0431\u043e\u0442\u0430 \u0441
    \u043d\u0443\u043b\u0435\u043c \u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c\u044e:
    \u041e\u043d \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u043b\u0441\u044f \u0432 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0438
    \u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043d\u0430 \u043d\u043e\u043b\u044c, \u0437\u0430\u044f\u0432\u0438\u0432,
    \u0447\u0442\u043e \u0447\u0438\u0441\u043b\u043e, \u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0435
    \u043d\u0430 \u043d\u043e\u043b\u044c, \u0434\u0430\u0435\u0442 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c
    (`a/0 = \u221e`). \u042d\u0442\u043e \u0431\u044b\u043b \u0432\u0430\u0436\u043d\u044b\u0439
    \u0448\u0430\u0433 \u0432\u043f\u0435\u0440\u0435\u0434 \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e
    \u0441 \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438,
    \u0445\u043e\u0442\u044f \u0435\u0433\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u0432\u0441\u0451 \u0435\u0449\u0435 \u0431\u044b\u043b\u043e \u043d\u0435\u043f\u043e\u043b\u043d\u044b\u043c
    (\u043e\u043d, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e
    \u043f\u043e\u043b\u0430\u0433\u0430\u043b, \u0447\u0442\u043e `a/0 0 = a`). - \u041d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f: \u0412\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u041f\u0435\u043b\u043b\u044f (`x\u00b2 = 1 + py\u00b2`). \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434 \u00ab\u0447\u0430\u043a\u0440\u0430\u0432\u0430\u043b\u0430\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432.
    \u0412\u043f\u0435\u0447\u0430\u0442\u043b\u044f\u0435\u0442, \u0447\u0442\u043e \u043e\u043d
    \u043d\u0430\u0448\u0435\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0442\u0430\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u043a\u0430\u043a `x\u00b2 = 1
    + 61y\u00b2` (`x = 1,766,319,049`, `y = 226,153,980`). \u042d\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0430 \u043a\u0430\u043a
    \u0432\u044b\u0437\u043e\u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c \u041f\u044c\u0435\u0440\u043e\u043c
    \u0424\u0435\u0440\u043c\u0430 \u043b\u0438\u0448\u044c \u0432 1657 \u0433\u043e\u0434\u0443!
    - \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0438 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044f:
    \u0412 \u00ab\u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438\u00bb \u043e\u043d \u0434\u0430\u0435\u0442
    \u0434\u0432\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430
    \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u0442 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0447\u0438\u0441\u043b\u0430 \u03c0,
    \u0440\u0430\u0432\u043d\u043e\u0435 3,141666. \u0412 \u0441\u0432\u043e\u0438\u0445 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b, \u0431\u043b\u0438\u0437\u043a\u0438\u0435
    \u043a \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e, \u0438, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c, \u0431\u044b\u043b \u0437\u043d\u0430\u043a\u043e\u043c
    \u0441 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u0437\u0436\u0435 \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430. -
    \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439
    \u0433\u0435\u043d\u0438\u0439: \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0435 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u043d\u043d\u0438\u0445
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432
    \u0432\u0435\u0447\u043d\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f
    (\u043f\u0435\u0440\u043f\u0435\u0442\u0443\u0443\u043c \u043c\u043e\u0431\u0438\u043b\u0435).
    \u0412 \u0435\u0433\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0438 \u0444\u0438\u0433\u0443\u0440\u0438\u0440\u0443\u0435\u0442
    \u043a\u043e\u043b\u0435\u0441\u043e \u0441 \u0441\u043e\u0441\u0443\u0434\u0430\u043c\u0438,
    \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u043c\u0438
    \u0440\u0442\u0443\u0442\u044c\u044e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u043e\u043b\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u0432\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f \u0432\u0435\u0447\u043d\u043e
    \u0438\u0437-\u0437\u0430 \u043f\u0435\u0440\u0435\u0442\u0435\u043a\u0430\u043d\u0438\u044f
    \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438.\n\n\U0001F4D6 \u041b\u0435\u0433\u0435\u043d\u0434\u0430
    \u043e \u00ab\u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438\u00bb \u0421 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0442\u0440\u0443\u0434\u0430
    \u043f\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u043a\u0440\u0430\u0441\u0438\u0432\u0430\u044f \u043b\u0435\u0433\u0435\u043d\u0434\u0430.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0435\u0439, \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u043d\u0430\u0437\u0432\u0430\u043b \u043a\u043d\u0438\u0433\u0443 \u0432 \u0447\u0435\u0441\u0442\u044c
    \u0441\u0432\u043e\u0435\u0439 \u0434\u043e\u0447\u0435\u0440\u0438 \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438,
    \u0447\u0442\u043e\u0431\u044b \u0443\u0442\u0435\u0448\u0438\u0442\u044c \u0435\u0435.
    \u041e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439
    \u0447\u0430\u0441 \u0434\u043b\u044f \u0435\u0435 \u0441\u0432\u0430\u0434\u044c\u0431\u044b
    \u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0432\u043e\u0434\u044f\u043d\u044b\u0445
    \u0447\u0430\u0441\u043e\u0432 \u0445\u043e\u0442\u0435\u043b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u0442\u043e\u0447\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442. \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438,
    \u0438\u0437 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u0441\u0442\u0432\u0430 \u0437\u0430\u0433\u043b\u044f\u043d\u0443\u0432
    \u0432 \u0441\u043e\u0441\u0443\u0434 \u0441 \u0447\u0430\u0441\u0430\u043c\u0438, \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e
    \u0443\u0440\u043e\u043d\u0438\u043b\u0430 \u0432 \u043d\u0435\u0433\u043e \u0436\u0435\u043c\u0447\u0443\u0436\u0438\u043d\u0443
    \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u043e\u0434\u0435\u0436\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0437\u0430\u043a\u0443\u043f\u043e\u0440\u0438\u043b\u0430 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435.
    \u0421\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0439 \u0447\u0430\u0441 \u0431\u044b\u043b
    \u0443\u043f\u0443\u0449\u0435\u043d, \u0438, \u0447\u0442\u043e\u0431\u044b \u0443\u0442\u0435\u0448\u0438\u0442\u044c
    \u0434\u043e\u0447\u044c, \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0434\u043b\u044f \u043d\u0435\u0435 \u043a\u043d\u0438\u0433\u0443 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0430
    \u0438\u0445 \u043e\u0431\u043e\u0438\u0445 \u043d\u0430 \u0432\u0435\u043a\u0430. \u0414\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u044d\u0442\u043e\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0430,
    \u043d\u043e \u043e\u043d\u0430 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u0443\u043a\u0435
    \u0432 \u0442\u0443 \u044d\u043f\u043e\u0445\u0443. \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b II \u0441\u0442\u0430\u043b\u043e \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u044b\u0441\u043b\u0438
    \u0441\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u043e\u0439 \u0418\u043d\u0434\u0438\u0438,
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0439 \u0441\u043b\u0443\u0436\u0438\u043b\u0438
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430\u043c\u0438 \u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043d\u0430\u0443\u043a\u0438
    \u043a\u0430\u043a \u0432 \u0410\u0437\u0438\u0438, \u0442\u0430\u043a \u0438 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435."
  shortBioEn: "Bhaskara II (also known as Bhaskar Acharya, which means \"Bhaskar's teacher\") is the largest Indian mathematician and astronomer of the 12th century, whose works were far ahead of their time. He was born in 1114 and died in 1185.\n\nThe origin and way of life of Bhaskara is not entirely devoid of facts, but it is known that he was from the Brahman family, whose father was named Maheshwara, and he was also a famous astrologer, and Bhaskara was born in Bijuda Bijapur (modern Bijapur in Karnataka State), near the mountains of Sahiadri, where the city of Udjin, the leading centre of mathematical and astronomical thought in ancient India, was the main centre of activity.There he headed the astronomical observatory, succeeded the famous mathematician Brahmagupta, whose glory was so great that in the 13th century his grandson, Changadewa, was an astronomer at the court of King Singhana from the Yadawa dynasty, and special schools were founded to study the works of Bhaskara.\n\n==Career==The main work: \"Siddhant-Shiromani\" in 1150, at the age of 36, Bhaskara completed its fundamental work, \"Siddhant-Shiromani\". This encyclopedia consists of four separate parts, which later became famous books: 1. \"Lilavati\" (\"The Beautiful\") is a tract on arithmetic and geometry.\"Goladhaya\" (\"Sphere\") is a section devoted to spherical geometry and the celestial sphere. 4. \"Grandhaganita\" (\"Matematics of Planets\") is a part describing the theory of planetary motion.\n\nThe mathematical advances that preceded the time of Bhaskara's Mathematical works contain ideas that were discovered in Europe only centuries later. - Algebra and the solution of equations: Bhaskara was one of the first in the world to realize that the square equation could have two roots, and, although doubtful, recognized the existence of negative roots.He also used letters to indicate unknown values, which is very similar to the modern algebraic note. - Working with zero and infinity: He advanced in the understanding of the zero division, stating that the number divided by zero gave infinity ('a/0 = \\\\). This was an important step forward from his predecessors, although his understanding was still incomplete (he, for example, mistakenly believed that `a/0 0 = a').- Undefined equations: The outstanding achievement of Bhaskara is the solution of the so-called Pell equation ( `x2 = 1 + py2'). He created a cyclical method for this \"chamber\", which is an improvement in the methods of his predecessors. It is impressive that he has found huge, whole solutions for equations such as `x2 = 1 + 61y2' (`x = 1.76.319.049', `y = 226.153.980').This task was proposed as a challenge to European mathematicians by Pierre Ferm only in 1657! - Geometry and trigonometry: In Lilavati, he provides two proofs of the Pythagorean theorem and calculates the approximate pi value of 3.141666. In his astronomical work, he also uses results close to differential calculation and, according to some reports, was familiar with the principles that later formed the basis for Newton's analysis.- Inventive genius: Bhaskare owns one of the earliest known permanent engine projects (perpetum mobile) and features a wheel with receptacles partially filled with mercury, which was to rotate forever because of fluid flow.\n\nThe legend of Lilavati, with the title of his major arithmetic work, is a beautiful legend. According to her, Bhaskara named the book after her daughter Lilavati to comfort her. He calculated an hour for her wedding, and with the help of water, he wanted to determine the exact moment. Lilavati accidentally dropped a pearl from her clothes on the vessel, looking at the vessel with a watch, and then he closed the hole.The happy hour was missed, and to comfort her daughter, Bhaskara wrote a book for her on mathematics, which made both of them famous for centuries. The credibility of this story has not been confirmed, but it is a fine illustration of the attitude to science in that era. The legacy of Bhaskara II was the top of the mathematical thought of medieval India, his work has been a textbook for centuries and has had a great impact on the development of science both in Asia and Europe."
  interestingFactsRu: "\u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 II, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u0431\u044b\u043b \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0447\u0451\u043d\u044b\u043c,
    \u043d\u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438
    \u0442\u0440\u0443\u0434\u044b \u043e\u043a\u0443\u0442\u0430\u043d\u044b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e\u043c
    \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u043d\u043e \u0438 \u043a\u0430\u043a
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430, \u043f\u043e\u044d\u0442\u0430 \u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u044f.\n\n\u2699\ufe0f \u041a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440
    \u0432\u0435\u0447\u043d\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f
    \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0430\u043c\u044b\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442: \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u2014 \u0430\u0432\u0442\u043e\u0440
    \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432
    \u0432\u0435\u0447\u043d\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f
    (\u043f\u0435\u0440\u043f\u0435\u0442\u0443\u0443\u043c \u043c\u043e\u0431\u0438\u043b\u0435).
    \u0412 \u0441\u0432\u043e\u0451\u043c \u0441\u0442\u0438\u0445\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0438
    \u043e\u043a\u043e\u043b\u043e 1150 \u0433\u043e\u0434\u0430 \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b
    \u043a\u043e\u043b\u0435\u0441\u043e, \u043f\u043e \u043e\u0431\u043e\u0434\u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0431\u044b\u043b\u0438 \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u044b \u043d\u0430\u043a\u043b\u043e\u043d\u043d\u044b\u0435
    \u0441\u043e\u0441\u0443\u0434\u044b, \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u0435
    \u0440\u0442\u0443\u0442\u044c\u044e. \u0418\u0434\u0435\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043f\u0440\u0438 \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u043a\u043e\u043b\u0435\u0441\u0430 \u0440\u0442\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0442\u0435\u043a\u0430\u043b\u0430
    \u0431\u044b \u0432 \u0441\u043e\u0441\u0443\u0434\u0430\u0445, \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u044f
    \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439 \u0434\u0438\u0441\u0431\u0430\u043b\u0430\u043d\u0441
    \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044f \u043a\u043e\u043b\u0435\u0441\u043e
    \u0432\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f \u0432\u0435\u0447\u043d\u043e. \u0425\u043e\u0442\u044f
    \u0441 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0444\u0438\u0437\u0438\u043a\u0438
    \u044d\u0442\u043e\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u043d\u0435 \u043c\u043e\u0433
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0438\u0437-\u0437\u0430 \u0442\u0440\u0435\u043d\u0438\u044f,
    \u0441\u0430\u043c\u0430 \u0438\u0434\u0435\u044f \u0438 \u0430\u043d\u0430\u043b\u0438\u0437
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u0432 \u0441\u0438\u043b \u0442\u044f\u0436\u0435\u0441\u0442\u0438
    \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0431\u044b\u043b\u0438 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0441 \u043a\u043e\u043b\u0435\u0441\u0430 \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b
    \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c \u043c\u043d\u043e\u0433\u043e\u0432\u0435\u043a\u043e\u0432\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u043e\u043f\u044b\u0442\u043e\u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u0432\u0435\u0447\u043d\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u043b\u0430
    \u0434\u0430\u0436\u0435 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0434\u0430 \u0412\u0438\u043d\u0447\u0438.\n\n\U0001F48E
    \u0412\u044b\u0437\u043e\u0432, \u0431\u0440\u043e\u0448\u0435\u043d\u043d\u044b\u0439 \u0447\u0435\u0440\u0435\u0437
    500 \u043b\u0435\u0442 \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u0435\u0442\u043e\u0434
    \u00ab\u0427\u0430\u043a\u0440\u0430\u0432\u0430\u043b\u0430\u00bb (\u0447\u0442\u043e \u0432
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0435 \u0441 \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442\u0430
    \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u043a\u043e\u043b\u0435\u0441\u043e\u00bb,
    \u043d\u0430\u043c\u0435\u043a\u0430\u044f \u043d\u0430 \u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043f\u0440\u0438\u0440\u043e\u0434\u0443 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430)
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u041f\u0435\u043b\u043b\u044f (\\( x^2 = 1 + py^2 \\)). \u041e\u043d \u043d\u0430\u0448\u0451\u043b
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0441\u043b\u0443\u0447\u0430\u044f
    \\( p=61 \\): \\( x = 1,766,319,049 \\) \\( y = 226,153,980 \\) \u0421\u0430\u043c\u043e\u0435
    \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435: \u0441\u043f\u0443\u0441\u0442\u044f
    \u043f\u044f\u0442\u044c \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0439, \u0432 1657 \u0433\u043e\u0434\u0443,
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041f\u044c\u0435\u0440 \u0424\u0435\u0440\u043c\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0440\u043e\u0432\u043d\u043e \u044d\u0442\u0443 \u0436\u0435 \u0437\u0430\u0434\u0430\u0447\u0443
    (\\( x^2 = 61y^2 + 1 \\)) \u043a\u0430\u043a \u0432\u044b\u0437\u043e\u0432 \u0441\u0432\u043e\u0438\u043c
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c \u0432 \u0415\u0432\u0440\u043e\u043f\u0435.
    \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441\u043c\u043e\u0433\u043b\u0438 \u0440\u0435\u0448\u0438\u0442\u044c \u0435\u0451 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0432\u0435\u043a\u0430, \u0438 \u0438\u0445
    \u043c\u0435\u0442\u043e\u0434\u044b (\u0446\u0435\u043f\u043d\u044b\u0435 \u0434\u0440\u043e\u0431\u0438)
    \u0431\u044b\u043b\u0438 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0441\u043b\u043e\u0436\u043d\u0435\u0435
    \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u044b. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0413\u0435\u0440\u043c\u0430\u043d \u0413\u0430\u043d\u043a\u0435\u043b\u044c \u043d\u0430\u0437\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u00ab\u0427\u0430\u043a\u0440\u0430\u0432\u0430\u043b\u0430\u00bb
    \u00ab\u043b\u0443\u0447\u0448\u0438\u043c, \u0447\u0442\u043e \u0431\u044b\u043b\u043e
    \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u043e \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b \u0434\u043e \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430\u00bb.\n\n\U0001F4D6
    \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438: \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043a\u0430\u043a \u0443\u0442\u0435\u0448\u0435\u043d\u0438\u0435 \u0421\u0430\u043c\u044b\u0439
    \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0438 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442 \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0435\u0433\u043e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u0442\u0440\u0443\u0434\u043e\u043c
    \u043f\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435 \u2014 \u00ab\u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438\u00bb,
    \u0447\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0430\u043a
    \u00ab\u041f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f\u00bb \u0438\u043b\u0438
    \u00ab\u0418\u0433\u0440\u0438\u0432\u0430\u044f\u00bb. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u043d\u0430\u0437\u0432\u0430\u043b \u043a\u043d\u0438\u0433\u0443 \u0432 \u0447\u0435\u0441\u0442\u044c
    \u0441\u0432\u043e\u0435\u0439 \u0434\u043e\u0447\u0435\u0440\u0438 \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438.
    \u041e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b, \u0447\u0442\u043e \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0439
    \u0447\u0430\u0441 \u0434\u043b\u044f \u0435\u0451 \u0441\u0432\u0430\u0434\u044c\u0431\u044b
    \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u0442 \u0432 \u0441\u0442\u0440\u043e\u0433\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.
    \u0427\u0442\u043e\u0431\u044b \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c
    \u0435\u0433\u043e, \u043e\u043d \u0441\u043c\u0430\u0441\u0442\u0435\u0440\u0438\u043b
    \u0432\u043e\u0434\u044f\u043d\u044b\u0435 \u0447\u0430\u0441\u044b \u2014 \u0447\u0430\u0448\u0443
    \u0441 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435\u043c, \u043f\u043b\u0430\u0432\u0430\u044e\u0449\u0443\u044e
    \u0432 \u0441\u043e\u0441\u0443\u0434\u0435 \u0441 \u0432\u043e\u0434\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u0442\u043e\u043d\u0443\u0442\u044c
    \u0432 \u043d\u0443\u0436\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442. \u041d\u043e
    \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u0430\u044f \u043d\u0435\u0432\u0435\u0441\u0442\u0430
    \u043f\u043e\u0434\u043e\u0448\u043b\u0430 \u043a \u043f\u0440\u0438\u0431\u043e\u0440\u0443,
    \u0438 \u0436\u0435\u043c\u0447\u0443\u0436\u0438\u043d\u0430 \u0438\u0437 \u0435\u0451
    \u0443\u043a\u0440\u0430\u0448\u0435\u043d\u0438\u044f \u0443\u043f\u0430\u043b\u0430 \u0432
    \u0432\u043e\u0434\u0443 \u0438 \u0437\u0430\u043a\u0443\u043f\u043e\u0440\u0438\u043b\u0430
    \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435. \u0411\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439
    \u0447\u0430\u0441 \u0431\u044b\u043b \u0443\u043f\u0443\u0449\u0435\u043d, \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435
    \u0441\u0431\u044b\u043b\u043e\u0441\u044c \u2014 \u043e\u043d\u0430 \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0430
    \u0432\u044b\u0439\u0442\u0438 \u0437\u0430\u043c\u0443\u0436 \u0438\u043b\u0438 \u0441\u0442\u0430\u043b\u0430
    \u0432\u0434\u043e\u0432\u043e\u0439. \u0427\u0442\u043e\u0431\u044b \u0443\u0442\u0435\u0448\u0438\u0442\u044c
    \u0434\u043e\u0447\u044c, \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0434\u043b\u044f \u043d\u0435\u0451 \u043a\u043d\u0438\u0433\u0443 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u0430\u0432\u0435\u043a\u0438 \u043e\u0431\u0435\u0441\u0441\u043c\u0435\u0440\u0442\u0438\u0432
    \u0435\u0451 \u0438\u043c\u044f. \u0412\u0430\u0436\u043d\u043e \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c:
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f
    \u043a \u044d\u0442\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u0435 \u0441 \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e.
    \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438
    \u0431\u044b\u043b\u0430 \u0436\u0435\u043d\u043e\u0439 \u0438\u043b\u0438 \u0443\u0447\u0435\u043d\u0438\u0446\u0435\u0439,
    \u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u044d\u0442\u043e \u0438
    \u0432\u043e\u0432\u0441\u0435 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0439
    \u043f\u0440\u0438\u0451\u043c \u2014 \u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u00ab\u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f\u00bb
    \u043a \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u043c\u043e\u0439 \u0443\u0447\u0435\u043d\u0438\u0446\u0435,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441\u043a\u0443\u0447\u043d\u044b\u0439
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u0431\u043e\u043b\u0435\u0435 \u0436\u0438\u0432\u044b\u043c.\n\n\U0001F3B2
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0432 \u0441\u0442\u0438\u0445\u0430\u0445
    \u0438 \u0437\u0430\u0434\u0430\u0447\u043a\u0430\u0445 \u0434\u043b\u044f \u043a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u044b
    \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0442\u043e\u0433\u043e,
    \u0431\u044b\u043b\u0430 \u043b\u0438 \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e, \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0438\u0441\u0430\u043b
    \u0441\u0432\u043e\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0432 \u0441\u0442\u0438\u0445\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u0435 \u0438 \u0447\u0430\u0441\u0442\u043e \u043e\u0431\u0440\u0430\u0449\u0430\u043b\u0441\u044f
    \u0432 \u043d\u0438\u0445 \u043a \u00ab\u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0439
    \u0434\u0435\u0432\u0443\u0448\u043a\u0435\u00bb. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0432 \u00ab\u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438\u00bb \u0435\u0441\u0442\u044c
    \u0442\u0430\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438: \"\u041e, \u041b\u0438\u043b\u0430\u0432\u0430\u0442\u0438,
    \u0443\u043c\u043d\u0430\u044f \u0434\u0435\u0432\u043e\u0447\u043a\u0430, \u0435\u0441\u043b\u0438
    \u0442\u044b \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0448\u044c \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u0435, \u0441\u043a\u0430\u0436\u0438
    \u043c\u043d\u0435 \u0441\u0443\u043c\u043c\u0443 \u0447\u0438\u0441\u0435\u043b 2, 5, 32,
    193, 18, 10 \u0438 100, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u0438\u0445 \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u044f \u0438\u0437 10000.\"
    \"\u0414\u0438\u0442\u044f \u0441 \u043e\u043b\u0435\u043d\u044c\u0438\u043c\u0438 \u0433\u043b\u0430\u0437\u0430\u043c\u0438,
    \u0441\u043a\u0430\u0436\u0438 \u043c\u043d\u0435, \u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0431\u0443\u0434\u0435\u0442 135 \u0443\u043c\u043d\u043e\u0436\u0438\u0442\u044c \u043d\u0430
    12, \u0435\u0441\u043b\u0438 \u0442\u044b \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0448\u044c
    \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e \u0447\u0430\u0441\u0442\u044f\u043c
    \u0438 \u043f\u043e \u0440\u0430\u0437\u0440\u044f\u0434\u0430\u043c.\" \u0410 \u0432\u043e\u0442
    \u043e\u0434\u043d\u0430 \u0438\u0437 \u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447 \u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439:
    > \u0417\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c \u043b\u044e\u0431\u043e\u0432\u044c\u044e,
    \u043e\u0436\u0435\u0440\u0435\u043b\u044c\u0435 \u0441\u043b\u043e\u043c\u0430\u043b\u043e\u0441\u044c.
    > \u0420\u044f\u0434 \u0436\u0435\u043c\u0447\u0443\u0436\u0438\u043d \u0440\u0430\u0441\u0441\u044b\u043f\u0430\u043b\u0441\u044f.
    > \u0428\u0435\u0441\u0442\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0443\u043f\u0430\u043b\u0430
    \u043d\u0430 \u043f\u043e\u043b. > \u041f\u044f\u0442\u0430\u044f \u0447\u0430\u0441\u0442\u044c
    \u2014 \u043d\u0430 \u043a\u0440\u043e\u0432\u0430\u0442\u044c. > \u042e\u043d\u0430\u044f
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430 \u0441\u043f\u0430\u0441\u043b\u0430 \u0442\u0440\u0435\u0442\u044c.
    > \u0414\u0435\u0441\u044f\u0442\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0431\u044b\u043b\u0430
    \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u043d\u0430 \u0435\u0451 \u0432\u043e\u0437\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u043c.
    > \u0415\u0441\u043b\u0438 \u043d\u0430 \u043d\u0438\u0442\u043a\u0435 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c
    \u0448\u0435\u0441\u0442\u044c \u0436\u0435\u043c\u0447\u0443\u0436\u0438\u043d, > \u0421\u043a\u043e\u043b\u044c\u043a\u043e
    \u0436\u0435\u043c\u0447\u0443\u0436\u0438\u043d \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e?
    \u042d\u0442\u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u043b\u0438, \u043d\u043e \u0438 \u0443\u0447\u0438\u043b\u0438
    \u0440\u0435\u0448\u0430\u0442\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438 \u0447\u0435\u0440\u0435\u0437 \u0436\u0438\u0432\u044b\u0435,
    \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0435 \u043e\u0431\u0440\u0430\u0437\u044b.\n\n\U0001F522
    \u041f\u0435\u0440\u0432\u043e\u043f\u0440\u043e\u0445\u043e\u0434\u0435\u0446 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435
    \u0441 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430 \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445, \u043a\u0442\u043e \u043e\u0441\u043e\u0437\u043d\u0430\u043b
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438,
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0443\u044e \u0441 \u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c
    \u043d\u0430 \u043d\u043e\u043b\u044c. \u041e\u043d \u0447\u0451\u0442\u043a\u043e \u0437\u0430\u044f\u0432\u0438\u043b,
    \u0447\u0442\u043e \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430, \u0434\u0435\u043b\u0451\u043d\u043d\u0430\u044f
    \u043d\u0430 \u043d\u043e\u043b\u044c, \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c\u044e (\\(
    a/0 = \\infty \\)). \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u0431\u044b\u043b\u043e \u0435\u0449\u0451 \u043d\u0435\u043f\u043e\u043b\u043d\u044b\u043c:
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e \\( \\infty \\times
    0 = a \\). \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u0443
    \u043e\u0448\u0438\u0431\u043a\u0443, \u0441\u0430\u043c \u0444\u0430\u043a\u0442 \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043e\u043d \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0442\u044c
    \u044d\u0442\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u044e \u0432 XII \u0432\u0435\u043a\u0435,
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F30C
