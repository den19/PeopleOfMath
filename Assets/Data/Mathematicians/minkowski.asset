  achievementsRu: "\u0413\u0435\u0440\u043c\u0430\u043d \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0437\u0430\u043c\u0435\u0442\u043d\u044b\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u043d\u0430\u0443\u043a\u0435, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u0432 \u0434\u0432\u0443\u0445, \u043d\u0430 \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434,
    \u0434\u0430\u043b\u0435\u043a\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445:
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439 \u0440\u0430\u0437\u0434\u0435\u043b
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432
    \u0432 \u0444\u0438\u0437\u0438\u043a\u0435, \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u0432
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e-\u0432\u0440\u0435\u043c\u044f,
    \u0441\u0442\u0430\u0432\u0448\u0435\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u044f\u0437\u044b\u043a\u043e\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F9EE
    \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b: \u043d\u043e\u0432\u044b\u0439
    \u044f\u0437\u044b\u043a \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b
    \u0414\u043e \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u0432 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e.
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e, \u043f\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043c\u043e\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435, \u0433\u0434\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0431\u043e\u043b\u0435\u0435
    \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c. \u042d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439
    \u0447\u0438\u0441\u0435\u043b. \u0420\u0430\u043d\u043d\u0438\u0439 \u0442\u0440\u0438\u0443\u043c\u0444
    (1883): \u0415\u0449\u0451 \u0432 17 \u043b\u0435\u0442, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c, \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0440\u0435\u0448\u0438\u043b \u0441\u043b\u043e\u0436\u043d\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0438
    \u0446\u0435\u043b\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430 \u0432 \u0432\u0438\u0434\u0435
    \u0441\u0443\u043c\u043c\u044b \u043f\u044f\u0442\u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u0430, \u0447\u0442\u043e \u043e\u043d \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0430\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435,
    \u0430 \u0441\u043e\u0437\u0434\u0430\u043b \u043e\u0431\u0448\u0438\u0440\u043d\u0443\u044e
    \u043e\u0431\u0449\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c, \u0437\u0430 \u0447\u0442\u043e \u0443\u0434\u043e\u0441\u0442\u043e\u0438\u043b\u0441\u044f
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0413\u0440\u0430\u043d-\u043f\u0440\u0438. \u042d\u0442\u043e\u0442
    \u0443\u0441\u043f\u0435\u0445 \u043f\u0440\u0435\u0434\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u043f\u0443\u0442\u044c.
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 (1896): \u041a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u044d\u0442\u043e\u043c
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0441\u0442\u0430\u043b\u0430
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u00ab\u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b\u00bb (Geometrie der Zahlen). \u0412 \u044d\u0442\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u0431\u044b\u043b\u0438 \u0437\u0430\u043b\u043e\u0436\u0435\u043d\u044b
    \u043e\u0441\u043d\u043e\u0432\u044b \u043d\u043e\u0432\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043d\u0430\u0445\u043e\u0434\u044f\u0449\u0435\u0439\u0441\u044f
    \u043d\u0430 \u0441\u0442\u044b\u043a\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u043e \u0432\u044b\u043f\u0443\u043a\u043b\u043e\u043c
    \u0442\u0435\u043b\u0435: \u042d\u0442\u043e \u0441\u0435\u0440\u0434\u0446\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0412 \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u043e\u043c
    \u0432\u0438\u0434\u0435 \u0434\u043b\u044f \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438
    \u043e\u043d\u0430 \u0433\u043b\u0430\u0441\u0438\u0442: \u0435\u0441\u043b\u0438 \u0432\u0437\u044f\u0442\u044c
    \u0432\u044b\u043f\u0443\u043a\u043b\u0443\u044e \u0444\u0438\u0433\u0443\u0440\u0443, \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0443\u044e
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0446\u0435\u043d\u0442\u0440\u0430,
    \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0435
    \u043c\u0435\u043d\u044c\u0448\u0435 4, \u0438 \u043f\u043e\u043c\u0435\u0441\u0442\u0438\u0442\u044c
    \u0435\u0451 \u0446\u0435\u043d\u0442\u0440 \u0432 \u043b\u044e\u0431\u043e\u0439 \u0443\u0437\u0435\u043b
    \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0439 \u0440\u0435\u0448\u0435\u0442\u043a\u0438,
    \u0442\u043e \u0432\u043d\u0443\u0442\u0440\u0438 \u0438\u043b\u0438 \u043d\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0435
    \u0444\u0438\u0433\u0443\u0440\u044b \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u043d\u0430\u0439\u0434\u0435\u0442\u0441\u044f \u0435\u0449\u0451 \u043e\u0434\u043d\u0430
    \u0442\u043e\u0447\u043a\u0430 \u044d\u0442\u043e\u0439 \u0440\u0435\u0448\u0435\u0442\u043a\u0438.
    \u042d\u0442\u0430, \u043d\u0430 \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434,
    \u043f\u0440\u043e\u0441\u0442\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u0434\u0435\u044f \u0441\u0442\u0430\u043b\u0430 \u043c\u043e\u0449\u043d\u044b\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441 \u0435\u0451 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043c\u043e
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \u0447\u0435\u0442\u044b\u0440\u0435\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432, \u0438\u043b\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b\u0445 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0439.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u0445 \u043b\u044e\u0431\u043e\u0439
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438 `n`: \u0434\u043b\u044f
    \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e
    \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0442\u043e\u0447\u043a\u0438 \u0440\u0435\u0448\u0435\u0442\u043a\u0438
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043e\u0431\u044a\u0435\u043c \u043d\u0435
    \u043c\u0435\u043d\u0435\u0435 `2^n`.\n\n\u23f3 \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e-\u0432\u0440\u0435\u043c\u044f:
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0432 \u0444\u0438\u0437\u0438\u043a\u0435
    \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0443\u0432\u043b\u0435\u043a\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u043e\u0439,
    \u0438 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u0435\u0433\u043e
    \u043a \u0441\u0430\u043c\u043e\u043c\u0443 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u043c\u0443
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044e. \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044f \u0421\u0422\u041e
    (1907-1908): \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u043e\u0441\u043e\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
