    \u043e\u0441\u044c\u044e, \u0430 \u0432 \u0435\u0434\u0438\u043d\u043e\u043c \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u043e\u043c
    \u043c\u0438\u0440\u0435. \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e: \u0412 \u044d\u0442\u043e\u043c
