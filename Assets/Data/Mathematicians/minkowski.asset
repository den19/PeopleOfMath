    \u0441\u0443\u0442\u044c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f. \u0412\u043c\u0435\u0441\u0442\u043e
    \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043a\u0438
    \u043a\u0430\u043a \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u0435, \u043e\u043d
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0435\u0434\u0438\u043d\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b `ds\u00b2 = c\u00b2dt\u00b2 - dx\u00b2
    - dy\u00b2 - dz\u00b2`, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b\u043c (\u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u044b\u043c)
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u0435\u043b\u0435\u0439.
    \u042d\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0442 \u0442\u043e\u0442 \u0444\u0430\u043a\u0442,
    \u0447\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0442\u0435\u0447\u0435\u0442 \u043f\u043e-\u0440\u0430\u0437\u043d\u043e\u043c\u0443
    \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445
    \u043e\u0442\u0441\u0447\u0435\u0442\u0430, \u0430 \u0434\u043b\u0438\u043d\u0430 \u0442\u0435\u043b
    \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438.\n\n\U0001F4DC
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0435 \u0442\u0440\u0443\u0434\u044b
    \u041f\u043e\u043c\u0438\u043c\u043e \u0434\u0432\u0443\u0445 \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439, \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0438
    \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445:
    \u0412\u043d\u0435\u0441 \u0432\u0430\u0436\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u0438\u043a\u043e\u0432
    \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0432\u044b\u043f\u0443\u043a\u043b\u044b\u0445
    \u0442\u0435\u043b. \u0418\u043c\u0435\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u043a\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438.
    \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u0443\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0443
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u041c\u0430\u043a\u0441\u0432\u0435\u043b\u043b\u0430.
    \u0412\u043a\u043b\u0430\u0434 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d \u0442\u0435\u043c, \u0447\u0442\u043e
    \u043e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0438\u043b
    \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0430 \u0441\u043e\u0437\u0434\u0430\u043b \u0446\u0435\u043b\u044b\u0435 \u043d\u043e\u0432\u044b\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u044f\u0437\u044b\u043a\u0438
    \u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u2014 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b \u0434\u043b\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438
    \u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e-\u0432\u0440\u0435\u043c\u044f
    \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u0438. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b,
    \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0438 \u0438\u0437\u0434\u0430\u043d\u043d\u044b\u0435
    \u0434\u0440\u0443\u0433\u043e\u043c \u0414\u0430\u0432\u0438\u0434\u043e\u043c \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c,
    \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043d\u0430\u0443\u043a\u0443 XX
    \u0432\u0435\u043a\u0430."
  achievementsEn: "Herman Minkowski left a significant mark in science, working in two seemingly distant fields: he created a new section of pure mathematics, the geometry of numbers, and then made a breakthrough in physics, proposing a four-dimensional space-time, which became the mathematical language of special relativity theory.\n\nThe new language for the number theory before the Minkovsky number theory developed largely independently. Minkovsky revolutionized, showing that many complex arithmetical tasks can be reworded in geometric language, where the solution becomes more obvious.Early triumph (1883): As a student at age 17, Minkovsky brilliantly solved the complex task of the Paris Academy of Sciences of presenting an entire number of five squares; his work was so deep that he did not just make a decision, but created a broad general theory of square forms, for which he won the Grand Prix Award, which was a success that determined his way forward.Basic work (1896): His work in this area culminated in the monograph Geometrie der Zahlen, which laid the foundation for a new field of mathematics at the intersection of geometry and number theory, the Minkovsky Theorem of the convulsive body: this is the heart of the geometry of numbers.In a simplified form for the plane, it says that if you take a convex figure symmetrically in relation to a center with a minimum area of 4, and place it in any node of a whole array of grids, then there's a certain point of this grid inside or at the boundary of the figure. This seemingly simple geometric idea has become a powerful tool to prove the fundamental theorem of number theory.For example, it can prove to the Lagrangian Theorem that any natural number is represented as the sum of four squares, or that it produces results in the area of diofant approach. Theorem works in spaces of any dimension `n': A volume of at least `2' n' is required to guarantee the existence of a grid point.\n\n♪ Space-time: the revolution in physics in the last years of Minkovsky's life has become a bit of a math physicist, and this has led to his most famous discovery. ♪ The Geometric Interpretation of the STO (1907-1908) ♪ Minkovsky realized that Einstein's special relativity theory is becoming extraordinary ♪ ♪ if you describe it not in a three-dimensional space with a separate temporal axis, but in a single four-dimensional world ♪The space of Minkovsky: In this world, each point (e.g. event) is given by four coordinates: three spatial (`x', 'y', 'z') and a temporal (`ct'), where `c' is the speed of light. This space is flat and has a pseudo-euclidic metric. \"Spatial space in itself and time in itself should turn to fiction...\": This famous phrase from his report \"Spatial and Time\" (1908) reflects the essence of discovery.Instead of treating spatial and temporal intervals as absolute, he proposed a single interval `ds2 = c2dt2 - dx2 - dy2 - dz2', which is invariant (non-changed) for all observers. This mathematically expresses the fact that time flows differently in different reference systems and body length changes in motion.\n\nOther important works besides two main areas, Minkovsky has been active in other areas: he has made an important contribution to multi-dimensional theory and the geometry of convex bodies. He has hydrodynamics and capillary theory. He has proposed a modern four-dimensional wording for the equations of Maxwell.Minkovsky's contribution is unique in that he has not only accomplished specific tasks, but has created whole new mathematical languages and structures — the geometry of numbers for arithmetic and space-time for physics. His work, collected and published by David Gilbert's friend, has had an enormous impact on the science of the twentieth century."
  personalLifeRu: "\u0413\u0435\u0440\u043c\u0430\u043d \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u043f\u0440\u043e\u0436\u0438\u043b \u044f\u0440\u043a\u0443\u044e, \u043d\u043e \u043d\u0435\u0434\u043e\u043b\u0433\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c, \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u0443\u044e
    \u043d\u0430\u0443\u043a\u043e\u0439 \u0438 \u0442\u0435\u0441\u043d\u043e\u0439 \u0434\u0440\u0443\u0436\u0431\u043e\u0439.
    \u0415\u0433\u043e \u043f\u0443\u0442\u044c \u043e\u0442 \u0432\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434\u0430
    \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438
    \u0434\u043e \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0431\u044b\u043b
    \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0431\u043e\u0440\u0432\u0430\u043b\u0441\u044f \u043d\u0430 \u0432\u0437\u043b\u0435\u0442\u0435.\n\n\U0001F476
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u043c\u044c\u044f \u0413\u0435\u0440\u043c\u0430\u043d
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    22 \u0438\u044e\u043d\u044f 1864 \u0433\u043e\u0434\u0430 \u0432 \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435
    \u0410\u043b\u0435\u043a\u0441\u043e\u0442\u044b (\u043d\u044b\u043d\u0435 \u0447\u0430\u0441\u0442\u044c
    \u041a\u0430\u0443\u043d\u0430\u0441\u0430, \u041b\u0438\u0442\u0432\u0430), \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0442\u043e\u0433\u0434\u0430 \u0432\u0445\u043e\u0434\u0438\u043b\u043e \u0432 \u0441\u043e\u0441\u0442\u0430\u0432
    \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438.
    \u041e\u043d \u0431\u044b\u043b \u0442\u0440\u0435\u0442\u044c\u0438\u043c \u0441\u044b\u043d\u043e\u043c
    \u0432 \u0437\u0430\u0436\u0438\u0442\u043e\u0447\u043d\u043e\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u043a\u0443\u043f\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0435.
    - \u041e\u0442\u0435\u0446: \u041b\u0435\u0432\u0438\u043d (\u041b\u0435\u0439\u0431) \u0411\u043e\u0440\u0443\u0445\u043e\u0432\u0438\u0447
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439, \u043a\u0443\u043f\u0435\u0446
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0433\u0438\u043b\u044c\u0434\u0438\u0438. \u041d\u0430
    \u0435\u0433\u043e \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u0425\u043e\u0440\u0430\u043b\u044c\u043d\u0430\u044f
    \u0441\u0438\u043d\u0430\u0433\u043e\u0433\u0430 \u0432 \u041a\u043e\u0432\u043d\u043e (\u043d\u044b\u043d\u0435
    \u041a\u0430\u0443\u043d\u0430\u0441). - \u041c\u0430\u0442\u044c: \u0420\u0430\u0445\u0438\u043b\u044c
    \u0418\u0441\u0430\u0430\u043a\u043e\u0432\u043d\u0430 \u0422\u043e\u0439\u0431\u043c\u0430\u043d.
    - \u0411\u0440\u0430\u0442\u044c\u044f \u0438 \u0441\u0435\u0441\u0442\u0440\u0430: \u0421\u0442\u0430\u0440\u0448\u0438\u0439
    \u0431\u0440\u0430\u0442 \u041c\u0430\u043a\u0441 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0439 \u0431\u0438\u0437\u043d\u0435\u0441 \u0438
    \u0441\u0442\u0430\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c
    \u043a\u043e\u043d\u0441\u0443\u043b\u043e\u043c \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435.
    \u0412\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u0442, \u041e\u0441\u043a\u0430\u0440
    (1858\u20131931), \u0441\u0442\u0430\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u0432\u0440\u0430\u0447\u043e\u043c-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0434\u0438\u0430\u0431\u0435\u0442\u0430. \u0422\u0430\u043a\u0436\u0435 \u0443 \u0413\u0435\u0440\u043c\u0430\u043d\u0430
    \u0431\u044b\u043b\u0438 \u0441\u0442\u0430\u0440\u0448\u0430\u044f \u0441\u0435\u0441\u0442\u0440\u0430
    \u0424\u0430\u043d\u043d\u0438 \u0438 \u043c\u043b\u0430\u0434\u0448\u0438\u0439 \u0431\u0440\u0430\u0442
    \u0422\u0443\u0432\u044c\u044f (\u0422\u043e\u0431\u0438). \u0412 1872 \u0433\u043e\u0434\u0443,
    \u0441\u043f\u0430\u0441\u0430\u044f\u0441\u044c \u043e\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445
    \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0445 \u043f\u043e\u0433\u0440\u043e\u043c\u043e\u0432
    \u0432 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438,
    \u0441\u0435\u043c\u044c\u044f \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u0432
    \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433, \u0433\u0434\u0435 \u043e\u0442\u0435\u0446
    \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u043c
    \u043a\u043e\u0432\u0440\u043e\u0432 \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0437\u0430\u0432\u043e\u0434\u043d\u044b\u0445 \u0438\u0433\u0440\u0443\u0448\u0435\u043a.\n\n\U0001F4DA
    \u0413\u043e\u0434\u044b \u0443\u0447\u0435\u0431\u044b \u0438 \u043f\u0435\u0440\u0432\u044b\u0435
    \u0442\u0440\u0438\u0443\u043c\u0444\u044b \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438. \u0412 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438
    \u043e\u043d \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0438\u0437\u0443\u0447\u0430\u043b \u0442\u0440\u0443\u0434\u044b \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430,
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u0438 \u0413\u0430\u0443\u0441\u0441\u0430.
    \u0412 1879 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0412 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432\u0448\u0435\u0435 \u0432\u0441\u044e
    \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0443\u044e \u0436\u0438\u0437\u043d\u044c:
    \u043e\u043d \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0441\u044f \u0441 \u0441\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u043e\u043c
    \u0414\u0430\u0432\u0438\u0434\u043e\u043c \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c.
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u0410\u0434\u043e\u043b\u044c\u0444\u043e\u043c
    \u0413\u0443\u0440\u0432\u0438\u0446\u0435\u043c \u043e\u043d\u0438 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b\u0438
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u0434\u043e\u043b\u0433\u0438\u0435
    \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438\u00bb, \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044f
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b.
    \u041f\u043e\u0437\u0436\u0435 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0433\u0434\u0435 \u0441\u043b\u0443\u0448\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u0442\u0430\u043a\u0438\u0445 \u043a\u043e\u0440\u0438\u0444\u0435\u0435\u0432, \u043a\u0430\u043a
    \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440 \u0438 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441.
    \u0412 1881 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    17 \u043b\u0435\u0442, \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b
    \u0441\u0432\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0445 \u0444\u043e\u0440\u043c
    \u043d\u0430 \u043a\u043e\u043d\u043a\u0443\u0440\u0441 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u0412\u043e\u043f\u0440\u0435\u043a\u0438
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c, \u0441\u0442\u0430\u0442\u044c\u044f \u0431\u044b\u043b\u0430
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0430 \u043d\u0430 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435, \u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u043f\u043e\u043c\u0435\u0448\u0430\u043b\u043e
    \u0435\u0439 \u0432 1883 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u0413\u0440\u0430\u043d-\u043f\u0440\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c (Grand Prix des Sciences Math\u00e9matiques). \u0412
    1885 \u0433\u043e\u0434\u0443 \u043e\u043d \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435,
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0432 \u0441\u0432\u043e\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.\n\n\U0001F468\u200d\U0001F3EB
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0431\u044b\u043b\u0430 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439:
    1887\u20131894: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432 \u0411\u043e\u043d\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (\u0441 1892 \u2014
    \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u0439,
    \u0441 1894 \u2014 \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440).
    1894\u20131896: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. 1896\u20131902:
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432 \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u043e\u043c
    \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c\u0435 (\u043d\u044b\u043d\u0435
    ETH Zurich). \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u043d\u0435 \u0432\u044b\u0437\u044b\u0432\u0430\u043b \u0443 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0434\u043e\u0432\u0435\u0440\u0438\u044f \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0447\u0430\u0441\u0442\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u043b
    \u0435\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438. \u0421 1902 \u0433\u043e\u0434\u0430
    \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438: \u041f\u043e
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e \u0441\u0432\u043e\u0435\u0433\u043e
    \u0434\u0440\u0443\u0433\u0430 \u0414\u0430\u0432\u0438\u0434\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0437\u0430\u043d\u044f\u043b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0443\u044e \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u2014 \u0432\u0435\u0434\u0443\u0449\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 \u043c\u0438\u0440\u0430 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\U0001F91D
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439 \u0432 \u043b\u0438\u0447\u043d\u043e\u0439 \u0438
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0431\u044b\u043b \u0414\u0430\u0432\u0438\u0434 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442.
    \u0418\u0445 \u0434\u0440\u0443\u0436\u0431\u0430, \u043d\u0430\u0447\u0430\u0432\u0448\u0430\u044f\u0441\u044f
    \u0432 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0435 \u0433\u043e\u0434\u044b,
    \u0431\u044b\u043b\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u0440\u043e\u0447\u043d\u043e\u0439. \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0435\u0433\u043e \u00ab\u0441\u0432\u043e\u0438\u043c
    \u043b\u0443\u0447\u0448\u0438\u043c, \u0441\u0430\u043c\u044b\u043c \u043d\u0430\u0434\u0435\u0436\u043d\u044b\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c\u00bb. \u0418\u043c\u0435\u043d\u043d\u043e \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043d\u0430\u0441\u0442\u043e\u044f\u043b \u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u0434\u043b\u044f \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0438\u0437\u0434\u0430\u043b \u043f\u043e\u043b\u043d\u043e\u0435
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435 \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432.
    \u0412 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0442\u0435\u0441\u043d\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b
    \u0441 \u0424\u0435\u043b\u0438\u043a\u0441\u043e\u043c \u041a\u043b\u0435\u0439\u043d\u043e\u043c
    \u0438 \u041a\u0430\u0440\u043b\u043e\u043c \u0420\u0443\u043d\u0433\u0435. \u042d\u0442\u0438
    \u0442\u0440\u043e\u0435, \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c,
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0438 \u00ab\u043a\u0432\u0430\u0440\u0442\u0435\u0442\u00bb
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u0447\u044c\u0438 \u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438 \u0441\u0442\u0430\u043b\u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u0435\u0441\u043b\u0438 \u041a\u043b\u0435\u0439\u043d
    \u0431\u044b\u043b \u0441\u043a\u043b\u043e\u043d\u0435\u043d \u043a \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438
    \u0438 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e, \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0438 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b\u0438
    \u0431\u043e\u043b\u0435\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u0443\u044e, \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0443\u044e
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443. \u041e\u0434\u043d\u0430 \u0438\u0437
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0448\u0443\u0442\u043e\u043a \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u043d\u0430 \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u0438 \u041a\u043b\u0435\u0439\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043e\u0431\u0441\u0443\u0434\u0438\u0442\u044c
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445
    \u0448\u043a\u043e\u043b, \u0431\u044b\u043b\u0430: \u00ab\u041d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f
    \u043b\u0438 \u0432\u0430\u043c, \u0433\u043e\u0441\u043f\u043e\u0434\u0438\u043d \u0442\u0430\u0439\u043d\u044b\u0439
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a, \u0447\u0442\u043e \u0441\u0440\u0435\u0434\u0438
    \u044d\u0442\u0438\u0445 \u0446\u0438\u0444\u0440 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e
    \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0434\u043e\u043b\u044e \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442
    \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0447\u0438\u0441\u043b\u0430?\u00bb. \u0421\u0430\u043c
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u043e\u0439 \u0438, \u0445\u043e\u0442\u044f \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d \u043e\u0442\u043d\u0435\u0441\u0441\u044f
    \u043a \u0435\u0433\u043e \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u043e\u0439
    \u043c\u043e\u0434\u0435\u043b\u0438 \u0441\u043a\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438,
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043a\u0430\u0437\u0430\u043b\u0430
    \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F48D
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0412 1897 \u0433\u043e\u0434\u0443
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0410\u0432\u0433\u0443\u0441\u0442\u0435 \u0410\u0434\u043b\u0435\u0440 \u0432
    \u0421\u0442\u0440\u0430\u0441\u0431\u0443\u0440\u0433\u0435. \u0423 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0434\u0432\u0435 \u0434\u043e\u0447\u0435\u0440\u0438:
    \u041b\u0438\u043b\u0438 (1898\u20131983), \u0441\u0442\u0430\u0432\u0448\u0430\u044f \u0443\u0447\u0435\u043d\u044b\u043c-\u0431\u043e\u0442\u0430\u043d\u0438\u043a\u043e\u043c.
    \u0420\u0443\u0442 (1902\u20132000).\n\n\U0001F54A\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c
    12 \u044f\u043d\u0432\u0430\u0440\u044f 1909 \u0433\u043e\u0434\u0430, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    44 \u043b\u0435\u0442, \u0432 \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0435 \u0441\u0438\u043b
    \u0438 \u0441\u043b\u0430\u0432\u044b, \u0413\u0435\u0440\u043c\u0430\u043d \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0441\u043a\u043e\u0440\u043e\u043f\u043e\u0441\u0442\u0438\u0436\u043d\u043e \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435 \u043e\u0442 \u0440\u0430\u0437\u0440\u044b\u0432\u0430
    \u0430\u043f\u043f\u0435\u043d\u0434\u0438\u043a\u0441\u0430 (\u043f\u0435\u0440\u0438\u0442\u043e\u043d\u0438\u0442\u0430).
    \u0415\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u044c \u0441\u0442\u0430\u043b\u0430 \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c \u0434\u043b\u044f \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0438 \u0432\u0441\u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430."
  personalLifeEn: "Herman Minkowski lived a bright but short life, full of science and close friendship, his journey from the vunderkind from the Russian Empire to one of the most powerful mathematicians of his time was fast and tragicly torn off in the air.\n\n==Early life==The birth and family of Herman Minkowski was born on 22 June 1864 in the place of Alexota (now part of Kaunas, Lithuania), which was then part of the Russian Empire. He was the third son of a wealthy Jewish merchant family. Father: Levin (Labe) Boruchovich Minkowski, first guild merchant. On his donation was built a Horal synagogue in Kovno (now Kaunas).Brothers and Sisters: Big Brother Max continued his family business and became a French consul in Koenigsberg, second brother, Oscar (1858–1931), became a famous diabetic physician, and Herman had an older sister, Fanny, and a younger brother, Toby, and in 1872 the family moved to Koenigsberg to export carpets and produce factory toys.\n\n==Career==Minkovsky has demonstrated outstanding mathematical abilities since his childhood and studied the work of Dedecinda, Dirichle and Gaussa himself at the gymnasium, and in 1879 he graduated from the gymnasium and entered the University of Koenigsberg.Together with Adolf Gurwitz, they held famous \"mathematical walks\" discussing scientific issues, and later, Minkovsky continued his education at the University of Berlin, where he attended lectures by corifeis such as Cronecker and Weyerstrass.Contrary to the rules, the article was written in German, but it did not prevent her from obtaining the Grand Prix in Mathematics in 1883 (Grand Prix des Sciences Matématiques), and in 1885 he defended his Ph.D. in Koenigsberg, continuing his research in this field.\n\n==Reception==The professional career of Minkovsky was fast: 1887–1894: Professor at the University of Bonn (from 1892 to extraordinary, from 1894 to ordinary professor). 1894–1896: Professor at the University of Koenigsberg. 1896–1902: Professor at the Zurich Polytechnic (now ETH Zurich).Here he was one of Albert Einstein's teachers, who, ironically, did not summon Minkovsky's trust as a mathematician, and often missed his lectures. From 1902 to the end of his life: At the invitation of his friend David Gilbert, he took up a dedicated mathematics department at Göttingen University, the leading mathematical center for the world of the time.\n\n==History==The relationship with other Central scientists in Minkovsky's personal and professional life was David Gilbert. Their friendship, which began in the student years, was extremely strong. Gilbert called him \"his best, most reliable friend.\" Gilbert insisted on creating a chair for Minkovsky in Göttingen. After the death of Minkovsky, Gilbert published a full collection of his works.In Göttingen, Minkovsky worked closely with Felix Klein and Carl Rung, and these three, along with Gilbert, formed a \"churt\" of mathematicians whose weekly walks became legendary, but if Klein was inclined to organize and plan, Minkovsky and Gilbert preferred a more free, creative atmosphere.One of Minkovsky's famous jokes at the Klein meeting, who tried to discuss German school statistics, was: \"Do you think, Mr. Secret Counsel, that a unusually large proportion of these numbers are simple numbers?\" The Minkovsky himself was deeply interested in mathematical physics and, although initially Einstein was skeptical about his four-dimensional model, his work was a key influence on the evolution of relativity theory.\n\nIn 1897 Minkovsky married Augusta Adler in Strasbourg, having two daughters, Lily (1898–1983), who became a botanist scientist.\n\n==Death==On January 12, 1909, at the age of 44, in the prime of power and glory, Herman Minkovsky died in Göttingen, rapidly from the rupture of his appendix (peritonite), and his death was a major blow to Gilbert and the entire scientific world."
  shortBioRu: "\u0413\u0435\u0440\u043c\u0430\u043d \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    (22 \u0438\u044e\u043d\u044f 1864 \u2014 12 \u044f\u043d\u0432\u0430\u0440\u044f 1909) \u2014
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0444\u0438\u0437\u0438\u043a, \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b \u0438
    \u0447\u0435\u0442\u044b\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430-\u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u0441\u0442\u0430\u0432\u0448\u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0413\u0435\u0440\u043c\u0430\u043d \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u043a\u0443\u043f\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0435
    \u0432 \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435 \u0410\u043b\u0435\u043a\u0441\u043e\u0442\u044b
    \u0410\u0432\u0433\u0443\u0441\u0442\u043e\u0432\u0441\u043a\u043e\u0439 \u0433\u0443\u0431\u0435\u0440\u043d\u0438\u0438
    \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438
    (\u043d\u044b\u043d\u0435 \u2014 \u0440\u0430\u0439\u043e\u043d \u041a\u0430\u0443\u043d\u0430\u0441\u0430
    \u0432 \u041b\u0438\u0442\u0432\u0435). \u0415\u0433\u043e \u043e\u0442\u0446\u043e\u043c
    \u0431\u044b\u043b \u043a\u0443\u043f\u0435\u0446 \u043f\u0435\u0440\u0432\u043e\u0439 \u0433\u0438\u043b\u044c\u0434\u0438\u0438
    \u041b\u0435\u0432\u0438\u043d (\u041b\u0435\u0439\u0431\u0430) \u0411\u043e\u0440\u0443\u0445\u043e\u0432\u0438\u0447
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439, \u043c\u0430\u0442\u0435\u0440\u044c\u044e
    \u2014 \u0420\u0430\u0445\u0438\u043b\u044c \u0418\u0441\u0430\u0430\u043a\u043e\u0432\u043d\u0430
    \u0422\u043e\u0439\u0431\u043c\u0430\u043d. \u0421\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430
    \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438 \u0443\u0432\u0430\u0436\u0430\u0435\u043c\u043e\u0439:
    \u043d\u0430 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u043e\u0442\u0446\u0430 \u0432 \u041a\u043e\u0432\u043d\u043e \u0431\u044b\u043b\u0430
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u0425\u043e\u0440\u0430\u043b\u044c\u043d\u0430\u044f
    \u0441\u0438\u043d\u0430\u0433\u043e\u0433\u0430. \u0413\u0435\u0440\u043c\u0430\u043d \u0431\u044b\u043b
    \u0442\u0440\u0435\u0442\u044c\u0438\u043c \u0441\u044b\u043d\u043e\u043c \u0432 \u0441\u0435\u043c\u044c\u0435.
    \u0415\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u0435 \u0431\u0440\u0430\u0442\u044c\u044f:
    - \u041c\u0430\u043a\u0441 (\u041c\u0430\u0440\u043a\u0443\u0441) \u2014 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0435 \u0434\u0435\u043b\u043e, \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435\u0439 \u0438 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u043b\u0443\u0436\u0438\u043b \u043a\u043e\u043d\u0441\u0443\u043b\u043e\u043c \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435. - \u041e\u0441\u043a\u0430\u0440
    \u2014 \u0441\u0442\u0430\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0432\u0440\u0430\u0447\u043e\u043c,
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u0434\u0438\u0430\u0431\u0435\u0442\u0430,
    \u0438 \u0434\u0435\u0434\u043e\u043c \u0430\u0441\u0442\u0440\u043e\u0444\u0438\u0437\u0438\u043a\u0430
    \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0430 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e.
    \u0412 1872 \u0433\u043e\u0434\u0443, \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0445
    \u043f\u043e\u0433\u0440\u043e\u043c\u043e\u0432 \u0432 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u0438\u043c\u043f\u0435\u0440\u0438\u0438, \u0441\u0435\u043c\u044c\u044f \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430
    \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433 (\u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f),
    \u0433\u0434\u0435 \u043e\u0442\u0435\u0446 \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u043c
    \u043a\u043e\u0432\u0440\u043e\u0432 \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0437\u0430\u0432\u043e\u0434\u043d\u044b\u0445 \u0438\u0433\u0440\u0443\u0448\u0435\u043a.
    \u0417\u0434\u0435\u0441\u044c \u043f\u0440\u043e\u0448\u043b\u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u044e\u043d\u043e\u0441\u0442\u044c \u0413\u0435\u0440\u043c\u0430\u043d\u0430.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0440\u0430\u043d\u043e. \u0415\u0449\u0451
    \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438 \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u0442\u0440\u0443\u0434\u044b \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430, \u0414\u0438\u0440\u0438\u0445\u043b\u0435
    \u0438 \u0413\u0430\u0443\u0441\u0441\u0430. \u0412 1880 \u0433\u043e\u0434\u0443, \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 15 \u043b\u0435\u0442, \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0433\u0434\u0435 \u0435\u0433\u043e
    \u043e\u0434\u043d\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u043e\u043c \u0438 \u0431\u043b\u0438\u0437\u043a\u0438\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c \u0441\u0442\u0430\u043b \u0414\u0430\u0432\u0438\u0434
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u2014 \u0431\u0443\u0434\u0443\u0449\u0430\u044f
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0441\u043b\u0443\u0448\u0430\u044f
    \u043b\u0435\u043a\u0446\u0438\u0438 \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u0430
    \u0438 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430. \u041f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c \u0432 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0435
    \u0441\u0442\u0430\u043b 1881 \u0433\u043e\u0434. \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a \u043e\u0431\u044a\u044f\u0432\u0438\u043b\u0430
    \u043a\u043e\u043d\u043a\u0443\u0440\u0441 \u043d\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0438
    \u0447\u0438\u0441\u043b\u0430 \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b
    \u043f\u044f\u0442\u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432. 18-\u043b\u0435\u0442\u043d\u0438\u0439
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443, \u043d\u043e \u0438
    \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0446\u0435\u043b\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c \u042d\u0439\u0437\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u0430.
    \u0412 1883 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u0413\u0440\u0430\u043d-\u043f\u0440\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c (Grand Prix des Sciences Math\u00e9matiques), \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0432
    \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0441 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0413\u0435\u043d\u0440\u0438
    \u0421\u043c\u0438\u0442\u043e\u043c. \u0412 1885 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435
    \u0437\u0430 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0432\u0448\u0443\u044e
    \u0435\u0433\u043e \u0442\u0440\u0438\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443. \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041a\u0430\u0440\u044c\u0435\u0440\u0430 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0431\u044b\u043b\u0430 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439 \u0438 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439:
    1887\u20131894: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0411\u043e\u043d\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 (\u0441 1892 \u2014
    \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u0439,
    \u0441 1894 \u2014 \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440).
    1894\u20131896: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. 1896\u20131902:
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c\u0430 (Eidgen\u00f6ssische
    Polytechnikum). \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0435\u0433\u043e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432 \u0431\u044b\u043b
    \u0410\u043b\u044c\u0431\u0435\u0440\u0442 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u043f\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e, \u0447\u0430\u0441\u0442\u043e
    \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u0438 \u043d\u0435 \u0432\u044b\u0437\u044b\u0432\u0430\u043b \u0443 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0434\u043e\u0432\u0435\u0440\u0438\u044f \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a.
    1897: \u0416\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0410\u0432\u0433\u0443\u0441\u0442\u0435
    \u0410\u0434\u043b\u0435\u0440 \u0432 \u0421\u0442\u0440\u0430\u0441\u0431\u0443\u0440\u0433\u0435.
    \u0423 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0434\u0432\u0435
    \u0434\u043e\u0447\u0435\u0440\u0438 \u2014 \u041b\u0438\u043b\u0438 (1898) \u0438 \u0420\u0443\u0442
    (1902). 1902\u20131909: \u041f\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e
    \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u0440\u0443\u0433\u0430 \u0414\u0430\u0432\u0438\u0434\u0430
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u0437\u0430\u043d\u044f\u043b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0443\u044e \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u2014 \u0446\u0435\u043d\u0442\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u0438 \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445: 1. \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b: \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0434\u0435\u0442\u0438\u0449\u0435 \u0432 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412 1896 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u00ab\u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b\u00bb (Geometrie der Zahlen), \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b
    \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044f. \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e \u0432\u044b\u043f\u0443\u043a\u043b\u043e\u043c \u0442\u0435\u043b\u0435 \u0441\u0442\u0430\u043b\u0430
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u044d\u0442\u043e\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b. 2.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u0438\u0437\u0438\u043a\u0430:
    \u0412 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435, \u043f\u043e\u0434
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u043e\u043d \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f
    \u0444\u0438\u0437\u0438\u043a\u043e\u0439, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u041b\u043e\u0440\u0435\u043d\u0446\u0430 \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u043e\u0439.
    3. \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e-\u0432\u0440\u0435\u043c\u044f:
    \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u0432\u0448\u0435\u0435 \u0438\u043c\u044f
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e. \u0412 1907\u20131908
    \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u043e\u0441\u043e\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c
    \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0430
    \u0432 \u0447\u0435\u0442\u044b\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u043c \u043c\u0438\u0440\u0435,
    \u0433\u0434\u0435 \u0442\u0440\u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u044e\u0442\u0441\u044f
    \u0441 \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c. \u041e\u043d \u0432\u0432\u0451\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e\u00bb \u2014 \u0447\u0435\u0442\u044b\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u0435
    \u043f\u0441\u0435\u0432\u0434\u043e\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e. 21 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1908 \u0433\u043e\u0434\u0430 \u043d\u0430 80-\u043c \u0441\u044a\u0435\u0437\u0434\u0435
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u043e\u0438\u0441\u043f\u044b\u0442\u0430\u0442\u0435\u043b\u0435\u0439
    \u0438 \u0432\u0440\u0430\u0447\u0435\u0439 \u0432 \u041a\u0451\u043b\u044c\u043d\u0435
    \u043e\u043d \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441 \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u043b\u0435\u043a\u0446\u0438\u044e \u00ab\u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0438 \u0432\u0440\u0435\u043c\u044f\u00bb (Raum und Zeit), \u0433\u0434\u0435 \u043f\u0440\u043e\u0432\u043e\u0437\u0433\u043b\u0430\u0441\u0438\u043b:
    > \u00ab\u041e\u0442\u043d\u044b\u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0441\u0430\u043c\u043e \u043f\u043e \u0441\u0435\u0431\u0435 \u0438 \u0432\u0440\u0435\u043c\u044f
    \u0441\u0430\u043c\u043e \u043f\u043e \u0441\u0435\u0431\u0435 \u0434\u043e\u043b\u0436\u043d\u044b
    \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u0432 \u0444\u0438\u043a\u0446\u0438\u0438,
    \u0438 \u043b\u0438\u0448\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0438\u0434
    \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u043e\u0431\u043e\u0438\u0445
    \u0434\u043e\u043b\u0436\u0435\u043d \u0435\u0449\u0451 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u00bb.
    \u0418\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d
    \u0441\u043a\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0442\u043d\u0451\u0441\u0441\u044f
    \u043a \u044d\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438, \u043d\u0430\u0437\u0432\u0430\u0432
    \u0435\u0451 \u0438\u0437\u043b\u0438\u0448\u043d\u0435 \u0441\u043b\u043e\u0436\u043d\u043e\u0439,
    \u043d\u043e \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0438\u043c\u0435\u043d\u043d\u043e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0412 \u0440\u0430\u0437\u0433\u0430\u0440 \u0441\u0432\u043e\u0435\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b,
    12 \u044f\u043d\u0432\u0430\u0440\u044f 1909 \u0433\u043e\u0434\u0430, \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0441\u043a\u043e\u0440\u043e\u043f\u043e\u0441\u0442\u0438\u0436\u043d\u043e \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435 \u043e\u0442 \u0440\u0430\u0437\u0440\u044b\u0432\u0430
    \u0430\u043f\u043f\u0435\u043d\u0434\u0438\u043a\u0441\u0430 (\u043f\u0435\u0440\u0438\u0442\u043e\u043d\u0438\u0442\u0430)
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 44 \u043b\u0435\u0442. \u0415\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u044c \u0441\u0442\u0430\u043b\u0430 \u0442\u044f\u0436\u0435\u043b\u044b\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c \u0434\u043b\u044f \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430 \u0438 \u0434\u043b\u044f \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u043f\u043e\u0442\u0435\u0440\u044f\u0432\u0448\u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u043e
    \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e \u0434\u0440\u0443\u0433\u0430. \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u0431\u044b\u043b\u0438
    \u0441\u043e\u0431\u0440\u0430\u043d\u044b \u0438 \u0438\u0437\u0434\u0430\u043d\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c
    \u0432 \u0434\u0432\u0443\u0445 \u0442\u043e\u043c\u0430\u0445 (Gesammelte Abhandlungen,
    1911). \u0418\u043c\u044f \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0443\u0432\u0435\u043a\u043e\u0432\u0435\u0447\u0435\u043d\u043e \u0432 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f\u0445
    \u043a\u0440\u0430\u0442\u0435\u0440\u0430 \u043d\u0430 \u041b\u0443\u043d\u0435, \u0430\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u0430,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u0445:
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e,
    \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u043e \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e,
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e."
  shortBioEn: "Herman Minkowski (22 June 1864 – 12 January 1909) was a German mathematician and physicist who created numbers geometry and four-dimensional space-time, which became the mathematical foundation of special relativity theory.His father was the first Guildman of Levin (Leiba) Boruchovich Minkovsky, his mother, Rachel Isaacovna Toybman, and his family was wealthy and respected, with the construction of the Horol synagogue at Kovno, and his third son in the family, and his older brothers, Max (Marcus), continued the family business, engaged in commerce and later served as French consul in Koenigsberg.Oscar became a famous doctor, a researcher of diabetes, and grandfather of astrophysics, Rudolph Minkovsky. In 1872, fearing Jewish pogroms in the Russian Empire, the family moved to Koenigsberg, Germany, where the father began exporting carpets and producing factory toys, where Herman's childhood and youth took place.He also studied at the gymnasium the works of Dedekind, Dirichle and Gaussa, and in 1880, at the age of 15, he attended the University of Koenigsberg, where David Gilbert, a future legend of mathematics, became his only friend, and then continued his studies at the University of Berlin, giving lectures to Cronecker and Weyerstrass, and his career in 1881.The Paris Academy of Sciences has announced a challenge to present the number as the sum of five squares. 18-year-old Minkovsky has not only solved the problem, but has actually restored the whole theory of Eisenstein's quadratic forms. In 1883 he was awarded the Grand Prix in Mathematics (Grand Prix des Sciences Matématiques), sharing the award with English mathematician Henry Smith.In 1885, he received a Ph.D. from Koenigsberg for his his histhology, which continued with his triumphal work. 1894–1896: Professor of the University of Koenigsberg. 1896–1902: Professor of the Zurich Polytechnic (Eidgenössische Polytechnikum).During this period, one of his students was Albert Einstein, who, according to Minkovsky's memory, often missed lectures and did not call a professor of trust as a mathematician. 1897: Married Auguste Adler in Strasbourg, with two daughters, Lily (1898) and Ruth (1902).1902 - 1909: At the invitation of his friend David Gilbert, he took up a special mathematics department at the University of Göttingen, the center of the mathematical thought of the time.In 1896, he published the monograph Geometrie der Zahlen, in which he applied geometric methods to solve the complex problems of the number theory, such as diofents of approach. His famous Minkovsky theorem of body bulge became the cornerstone of this discipline. 2. Mathematical physics: In Göttingen, under the influence of Gilbert, he was interested in physics, especially Lorenz's electronic theory and electrodynamics.Space-time: The main discovery that famously highlighted the name Minkovsky. In 1907–2008, he realized that Einstein's special theory of relativity could be elegantly described in a four-dimensional world where three spatial coordinates combine with time. He introduced the concept of \"Minkovsky space\", a four-dimensional pseudo-euclide space.On September 21, 1908, at the 80th Congress of German natural scientists and doctors in Cologne, he gave his famous lecture, \"Raum und Zeit\", where he declared: > \"The space in itself and the time in itself should turn to fiction, and only some kind of connection between the two must still be independent.\"Initially Einstein was skeptical about this mathematical formalization, calling it overly complex, but it was then the space of Minkovsky that became the basis for the general theory of relativity, and death and legacy in the midst of his career, on January 12, 1909, died quickly in Göttingen from the rupture of his appendix (peritonite) at the age of 44.His death was a serious blow to the scientific world and to Gilbert, who lost his closest friend, and after his death his works were collected and published by Gilbert in two volumes (Gesamelte Abhandlungen, 1911), the name of Minkovsky is permanently contained in the names of the crater on the Moon, the asteroid, and in numerous mathematical and physical terms: the space of Minkovsky, the inequality of Minkovsky, the functional of Minkovsky."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0413\u0435\u0440\u043c\u0430\u043d\u0430 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u043b\u043d\u0430 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0439, \u0438\u0440\u043e\u043d\u0438\u0438
    \u0438 \u044f\u0440\u043a\u0438\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u043a\u0430\u043a \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0433\u043e,
    \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u043e\u0433\u043e \u0438 \u043d\u0435\u043c\u043d\u043e\u0433\u043e
    \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u0443\u0447\u0451\u043d\u043e\u0433\u043e.\n\n\U0001F9E0
    \u0412\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434, \u043f\u043e\u0431\u0435\u0434\u0438\u0432\u0448\u0438\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u0432 \u0412 17 \u043b\u0435\u0442,
    \u0435\u0449\u0451 \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c,
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0440\u0435\u0448\u0438\u043b
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443
    \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0438
    \u0447\u0438\u0441\u043b\u0430 \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b
    \u043f\u044f\u0442\u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432. \u0415\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439, \u0447\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0438\u043b\u0430
    \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u0432\u043e\u043f\u0440\u043e\u0441\u0430
    \u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u043e\u0431\u0449\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c. \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u043a \u0428\u0430\u0440\u043b\u044c
    \u042d\u0440\u043c\u0438\u0442, \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d, \u0447\u0442\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u044e\u043d\u043e\u043c\u0443 \u0433\u0435\u043d\u0438\u044e: \u00ab\u042f \u043f\u0440\u0435\u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d
    \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u044f
    \u043f\u0435\u0440\u0435\u0434 \u0412\u0430\u0448\u0438\u043c\u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438
    \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c\u0438... \u0412\u044b
    \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u0434\u043e
    \u043c\u043d\u043e\u0439 \u043a\u0430\u043a \u0431\u044b \u0441\u043e\u0432\u0441\u0435\u043c
    \u043d\u043e\u0432\u044b\u0439 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0438\u0440\u00bb. 17-\u043b\u0435\u0442\u043d\u0438\u0439 \u044e\u043d\u043e\u0448\u0430
    \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0413\u0440\u0430\u043d-\u043f\u0440\u0438 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u0438 \u043d\u0430\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430
    \u041c\u0430\u0440\u0438 \u042d\u043d\u043c\u043e\u043d\u0430 \u0416\u043e\u0440\u0434\u0430\u043d\u0430:
    \u00ab\u0420\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0430\u0442\u044c \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c\u00bb.\n\n\U0001F468\u200d\U0001F393
    \u00ab\u041b\u0435\u043d\u0438\u0432\u044b\u0439 \u043f\u0451\u0441\u00bb \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d
    \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0443\u0440\u044c\u0435\u0437
    \u0432 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0412
    1896\u20131902 \u0433\u043e\u0434\u0430\u0445 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b \u0432 \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u043e\u043c
    \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c\u0435, \u0438 \u0441\u0440\u0435\u0434\u0438
    \u0435\u0433\u043e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432 \u0431\u044b\u043b
    \u0410\u043b\u044c\u0431\u0435\u0440\u0442 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d.
    \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u043d\u0435\u043b\u0435\u0441\u0442\u043d\u043e
    \u043e\u0442\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043e \u043d\u0435\u043c: \u00ab\u042d\u0442\u043e\u0442
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d, \u043e\u043d \u0432\u0435\u0447\u043d\u043e
    \u043f\u0440\u043e\u0433\u0443\u043b\u0438\u0432\u0430\u043b \u043c\u043e\u0438 \u043b\u0435\u043a\u0446\u0438\u0438...
    \u042f \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u0431\u044b \u043d\u0435 \u043f\u043e\u0432\u0435\u0440\u0438\u043b,
    \u0447\u0442\u043e \u043e\u043d \u043d\u0430 \u0442\u0430\u043a\u043e\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d\u00bb.
    \u041e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0431\u044b\u0432\u0448\u0435\u0433\u043e
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430 \u00ab\u043b\u0435\u043d\u0438\u0432\u044b\u043c
    \u043f\u0441\u043e\u043c\u00bb (lazy dog) \u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0442\u043e\u0442 \u00ab\u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435
    \u0443\u0442\u0440\u0443\u0436\u0434\u0430\u043b \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439\u00bb.
    \u041f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e\u0433\u043e \u00ab\u043d\u0435\u0440\u0430\u0434\u0438\u0432\u043e\u0433\u043e\u00bb
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430 \u0441\u043f\u0443\u0441\u0442\u044f \u0432\u0441\u0435\u0433\u043e
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u044f\u0442\u044c,
    \u0441\u043e\u0437\u0434\u0430\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0435\u0433\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0434\u0430\u0436\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    (\u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0430\u043f\u043e\u043a\u0440\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f)
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u0442\u043e\u043c, \u043a\u0430\u043a
    \u043d\u0430 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0435 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0434\u0430\u043b \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0443 \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0435\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e
    \u00ab\u043f\u0440\u043e\u0443\u0447\u0438\u0442\u044c\u00bb, \u043d\u043e \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0435\u0433\u043e \u0440\u0435\u0448\u0438\u043b.\n\n\u26c8
    \u0428\u0443\u0442\u043a\u0430 \u043d\u0430\u0434 \u0433\u0440\u043e\u0437\u043e\u0439 \u0438
    \u00ab\u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439 \u0447\u0435\u0442\u044b\u0440\u0435\u0445
    \u043a\u0440\u0430\u0441\u043e\u043a\u00bb \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c
    \u043e\u0441\u0442\u0440\u044b\u043c \u0443\u043c\u043e\u043c \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430. \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u043d
    \u0437\u0430\u044f\u0432\u0438\u043b \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c,
    \u0447\u0442\u043e \u043d\u0430\u0434\u0435\u0435\u0442\u0441\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u043a\u0440\u0430\u0441\u043e\u043a (\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u043b\u0438 4-\u0445 \u0446\u0432\u0435\u0442\u043e\u0432, \u0447\u0442\u043e\u0431\u044b
    \u0440\u0430\u0441\u043a\u0440\u0430\u0441\u0438\u0442\u044c \u043b\u044e\u0431\u0443\u044e
    \u043a\u0430\u0440\u0442\u0443). \u0427\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043d\u0435\u0434\u0435\u043b\u044c \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u044b\u0445
    \u043f\u043e\u043f\u044b\u0442\u043e\u043a, \u0432\u043e\u0439\u0434\u044f \u0432 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044e
    \u043f\u043e\u0434 \u0440\u0430\u0441\u043a\u0430\u0442\u044b \u0441\u0438\u043b\u044c\u043d\u043e\u0439
    \u0433\u0440\u043e\u0437\u044b, \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441:
    \u00ab\u041d\u0435\u0431\u043e \u0433\u043d\u0435\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430
    \u043c\u043e\u044e \u0434\u0435\u0440\u0437\u043e\u0441\u0442\u044c: \u043c\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u0446\u0432\u0435\u0442\u043e\u0432 \u0442\u043e\u0436\u0435
    \u043d\u0435\u0432\u0435\u0440\u043d\u043e\u00bb. \u041b\u0438\u0448\u044c \u043f\u043e\u0441\u043b\u0435
    \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u0443\u043b\u044b\u0431\u043d\u0443\u043b\u0441\u044f
    \u0438 \u043d\u0430\u0447\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u044e.\n\n\U0001F52C
    \u0412\u043a\u043b\u0430\u0434 \u0431\u0440\u0430\u0442\u0430-\u043c\u0435\u0434\u0438\u043a\u0430
    \u0412 \u0442\u0435\u043d\u0438 \u0413\u0435\u0440\u043c\u0430\u043d\u0430 \u0447\u0430\u0441\u0442\u043e
    \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0435\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u0431\u0440\u0430\u0442 \u041e\u0441\u043a\u0430\u0440 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439,
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0432\u0440\u0430\u0447. \u0418\u043c\u0435\u043d\u043d\u043e
    \u041e\u0441\u043a\u0430\u0440 \u0432 1889 \u0433\u043e\u0434\u0443 \u043f\u0440\u043e\u0432\u0435\u043b
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 \u043f\u043e \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044e
    \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b
    \u0443 \u0441\u043e\u0431\u0430\u043a\u0438, \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u0447\u0435\u0433\u043e \u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u043b\u0441\u044f
    \u0441\u0430\u0445\u0430\u0440\u043d\u044b\u0439 \u0434\u0438\u0430\u0431\u0435\u0442. \u042d\u0442\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u043e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439
    \u0436\u0435\u043b\u0435\u0437\u043e\u0439 \u0438 \u0434\u0438\u0430\u0431\u0435\u0442\u043e\u043c
    \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u0443
    \u0434\u043b\u044f \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0438\u043d\u0441\u0443\u043b\u0438\u043d\u0430. \u0421\u044b\u043d \u041e\u0441\u043a\u0430\u0440\u0430
