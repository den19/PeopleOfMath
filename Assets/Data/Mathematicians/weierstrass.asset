  achievementsRu: "\u0412\u043a\u043b\u0430\u0434 \u041a\u0430\u0440\u043b\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u2014 \u044d\u0442\u043e, \u043f\u043e \u0441\u0443\u0442\u0438,
    \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0432\u0441\u0435\u0433\u043e
    \u0437\u0434\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043d\u0430 \u043d\u043e\u0432\u043e\u043c,
    \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0441\u0442\u0440\u043e\u0433\u043e\u043c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0435. \u0415\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u00ab\u043e\u0442\u0446\u043e\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u00bb \u0438\u043c\u0435\u043d\u043d\u043e \u0437\u0430
    \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b
    \u044d\u0442\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0438\u0437 \u043d\u0430\u0431\u043e\u0440\u0430
    \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0445,
    \u043d\u043e \u043f\u043e\u0440\u043e\u0439 \u0448\u0430\u0442\u043a\u0438\u0445 \u0438\u0441\u0442\u0438\u043d
    \u0432 \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u0443\u044e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e.\n\n\U0001F3DB\ufe0f
    \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u0430\u043d\u0430\u043b\u0438\u0437\u0430:
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \"\u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u0438\u0441\u0442\u0438\u043d\u044b\" \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u0431\u044b\u043b\u043e
    \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u043e\u0442 \u043d\u0435\u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0435\u0439
    \u0438 \u0430\u043f\u0435\u043b\u043b\u044f\u0446\u0438\u0439 \u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435,
    \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e, \u043c\u043e\u0433\u043b\u0438
    \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u043e\u0448\u0438\u0431\u043a\u0430\u043c.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b: \u0414\u043e \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0434\u0430\u0436\u0435 \u0443 \u041a\u043e\u0448\u0438 \u043d\u0435 \u0431\u044b\u043b\u043e
    \u0441\u0442\u0440\u043e\u0433\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0435\u0451, \u0437\u0430\u043b\u043e\u0436\u0438\u0432
    \u043f\u0440\u043e\u0447\u043d\u044b\u0439 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0432\u0441\u0435\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u03b5-\u03b4-\u044f\u0437\u044b\u043a: \u041e\u043d
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u0440\u0435\u0434\u0435\u043b\u0430, \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u0430 \u044f\u0437\u044b\u043a\u0435
    \u00ab\u044d\u043f\u0441\u0438\u043b\u043e\u043d-\u0434\u0435\u043b\u044c\u0442\u0430\u00bb
    (\u03b5-\u03b4). \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0437\u0432\u0443\u0447\u0438\u0442 \u043a\u0430\u043a: \u0444\u0443\u043d\u043a\u0446\u0438\u044f
    `f(x)` \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430 \u0432 \u0442\u043e\u0447\u043a\u0435
    `x0`, \u0435\u0441\u043b\u0438 \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e `\u03b5>0`
    \u043d\u0430\u0439\u0434\u0435\u0442\u0441\u044f \u0442\u0430\u043a\u043e\u0435 `\u03b4>0`,
    \u0447\u0442\u043e \u0438\u0437 `|x-x0| < \u03b4` \u0441\u043b\u0435\u0434\u0443\u0435\u0442
    `|f(x)-f(x0)| < \u03b5`, \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0441\u044f
    \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430\u0445
    \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439. \u041f\u043e\u043d\u044f\u0442\u0438\u044f
    \u0432\u0435\u0440\u0445\u043d\u0435\u0439 \u0438 \u043d\u0438\u0436\u043d\u0435\u0439 \u0433\u0440\u0430\u043d\u0438:
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0432\u0435\u043b \u0432 \u043e\u0431\u0438\u0445\u043e\u0434 \u044d\u0442\u0438
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0421\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0442\u0438\u0432 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438: \u0415\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434\u0430
    \u0435\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430
    \u0420\u0438\u043c\u0430\u043d\u0430. \u0415\u0441\u043b\u0438 \u0420\u0438\u043c\u0430\u043d
    \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u043b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b, \u0442\u043e \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b \u043d\u0430 \u0441\u0442\u0440\u043e\u0433\u043e
    \u00ab\u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u00bb
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u043d\u0430 \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0445 \u0440\u044f\u0434\u0430\u0445,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u00ab\u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438\u0441\u0442\u0438\u043d\u0430\u043c\u0438\u00bb.\n\n\U0001F300 \u0422\u0435\u043e\u0440\u0438\u044f
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0438 \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0435 \u0440\u044f\u0434\u044b \u0412
    \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u043a \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043b\u0435\u0436\u0430\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0439 \u0440\u044f\u0434. \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435: \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0443\u044e
    \u00ab\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c\u00bb \u0444\u0443\u043d\u043a\u0446\u0438\u044e,
    \u0437\u0430\u0434\u0430\u043d\u043d\u0443\u044e \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c
    \u0440\u044f\u0434\u043e\u043c \u0432 \u043e\u0434\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438,
    \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u0448\u0438\u0440\u043e\u043a\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430:
    \u0414\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0441\u0443\u043c\u043c\u0430
    \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e \u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0433\u043e\u0441\u044f
    \u0440\u044f\u0434\u0430 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0441\u0430\u043c\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439.
    \u0418\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043e\u0441\u043e\u0431\u044b\u0435
    \u0442\u043e\u0447\u043a\u0438: \u041f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0432 \u043e\u043a\u0440\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438
    \u0438\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043e\u0441\u043e\u0431\u043e\u0439
    \u0442\u043e\u0447\u043a\u0438. \u0422\u0435\u043e\u0440\u0438\u044f \u0446\u0435\u043b\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439: \u0417\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0438\u0445 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0432 \u0432\u0438\u0434\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0439.\n\n\U0001F4CA
    \"\u041a\u043e\u043d\u0442\u0440\u043f\u0440\u0438\u043c\u0435\u0440\u044b\" \u0438 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435\u043c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043a\u043e\u043d\u0442\u0440\u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438,
    \u0441\u043a\u043e\u043b\u044c \u043e\u0431\u043c\u0430\u043d\u0447\u0438\u0432\u043e\u0439
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f. \u0412\u0441\u044e\u0434\u0443 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430\u044f,
    \u043d\u043e \u043d\u0438\u0433\u0434\u0435 \u043d\u0435 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u0443\u0435\u043c\u0430\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f: \u0412 1861 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u043f\u0440\u0438\u043c\u0435\u0440 \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430
    \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0442\u043e\u0447\u043a\u0435, \u043d\u043e
    \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439
    \u043d\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u0435\u0439 \u0438 \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439
    \u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0438: \u0414\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043b\u044e\u0431\u0443\u044e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0443\u044e
    \u043d\u0430 \u043e\u0442\u0440\u0435\u0437\u043a\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u044e
    \u043c\u043e\u0436\u043d\u043e \u0441\u043a\u043e\u043b\u044c \u0443\u0433\u043e\u0434\u043d\u043e
    \u0442\u043e\u0447\u043d\u043e \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u044c
    \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u0430\u043c\u0438 (\u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e
    \u0441\u0445\u043e\u0434\u044f\u0449\u0438\u043c\u0441\u044f \u0440\u044f\u0434\u043e\u043c).\n\n\U0001F52C
    \u042d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u0430\u0431\u0435\u043b\u0435\u0432\u044b
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0418\u043c\u0435\u043d\u043d\u043e \u0440\u0430\u043d\u043d\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438 \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0438 \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c. \u041f\u0440\u043e\u0440\u044b\u0432\u043d\u0430\u044f
    \u0441\u0442\u0430\u0442\u044c\u044f 1854 \u0433\u043e\u0434\u0430: \u041d\u0430\u0445\u043e\u0434\u044f\u0441\u044c
    \u0432 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f, \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044e
    \u0433\u0438\u043f\u0435\u0440\u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432, \u0440\u0435\u0448\u0438\u0432
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u042f\u043a\u043e\u0431\u0438. \u042d\u0442\u0430
    \u0441\u0442\u0430\u0442\u044c\u044f \u043c\u043e\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e
    \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c.
    \u041d\u043e\u0432\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439: \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0439\u043d\u0443\u044e \u0438
    \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u043d\u0430 \u0441\u0432\u043e\u0435\u0439
    \u0441\u0438\u0433\u043c\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0438 `\u03c3(u)` \u2014
    \u0446\u0435\u043b\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0449\u0435\u0439
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u043a\u0432\u0430\u0437\u0438\u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    \u0438 \u044f\u0432\u043b\u044f\u044e\u0449\u0435\u0439\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0432\u0441\u0435\u0445
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.\n\n\U0001F4D0
    \u0414\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0412\u043a\u043b\u0430\u0434 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0432\u0430\u0436\u043d\u044b\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b. \u0412\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435: \u041e\u043d \u043f\u0440\u0438\u0434\u0430\u043b
    \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439
    \u0432\u0438\u0434, \u0432\u0432\u0435\u0434\u044f \u0441\u0442\u0440\u043e\u0433\u0438\u0435
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u0434\u043b\u044f \u0441\u0438\u043b\u044c\u043d\u043e\u0433\u043e
    \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0443\u043c\u0430 \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0432
    \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0435 \u00ab\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b\u0435\u00bb
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f. \u041b\u0438\u043d\u0435\u0439\u043d\u0430\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430: \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0445
    \u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435\u0439 \u043c\u0430\u0442\u0440\u0438\u0446.
    \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u0418\u0437\u0443\u0447\u0430\u043b
    \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043b\u0438\u043d\u0438\u0438
    \u0438 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438
    (\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u043b\u043e\u0449\u0430\u0434\u0438).\n\n\U0001F4DA \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u0442\u0440\u0443\u0434\u044b \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c, \u043d\u043e
    \u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c.
    \u0415\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d \u0447\u0438\u0442\u0430\u043b 40
    \u043b\u0435\u0442, \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u043b\u0438 \u043b\u0443\u0447\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0441\u043e \u0432\u0441\u0435\u0439
    \u0415\u0432\u0440\u043e\u043f\u044b, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0413.
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430, \u041a. \u0420\u0443\u043d\u0433\u0435, \u0424.
    \u0424\u0440\u043e\u0431\u0435\u043d\u0438\u0443\u0441\u0430, \u041c. \u041c\u0438\u0442\u0442\u0430\u0433-\u041b\u0435\u0444\u0444\u043b\u0435\u0440\u0430
    \u0438, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0421\u043e\u0444\u044c\u044e \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0443\u044e.
    \u0418\u0440\u043e\u043d\u0438\u0447\u043d\u043e, \u043d\u043e \u0441\u0430\u043c \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043d\u0435 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0437\u0430\u0431\u043e\u0442\u0438\u043b\u0441\u044f
    \u043e \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\u0432\u043e\u0438\u0445
    \u043b\u0435\u043a\u0446\u0438\u0439 \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432,
    \u0441\u0447\u0438\u0442\u0430\u044f \u0432\u0430\u0436\u043d\u0435\u0435 \u0436\u0438\u0432\u043e\u0435
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435. \u0418\u043c\u0435\u043d\u043d\u043e
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u0435\u0433\u043e
    \u0421\u043e\u0431\u0440\u0430\u043d\u0438\u044f \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439
    (\u00abMathematische Werke\u00bb) \u043d\u0430\u0447\u0430\u043b\u043e\u0441\u044c \u0435\u0449\u0435
    \u043f\u0440\u0438 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u043e\u0441\u044c
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 1927 \u0433\u043e\u0434\u0443, \u043e\u0445\u0432\u0430\u0442\u0438\u0432
    7 \u0442\u043e\u043c\u043e\u0432. \u0415\u0433\u043e \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435
    \u043a \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0439 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e \u043b\u0438\u0446\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u043d \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b \u0430\u043d\u0430\u043b\u0438\u0437
    \u0438\u0437 \u043d\u0430\u0443\u043a\u0438, \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u043d\u0430 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044e, \u0432 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443,
    \u0433\u0434\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0448\u0430\u0433 \u0434\u043e\u043a\u0430\u0437\u0430\u043d
    \u0441 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u044f\u0441\u043d\u043e\u0441\u0442\u044c\u044e."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041a\u0430\u0440\u043b\u0430
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u2014 \u044d\u0442\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u0440\u0438\u043d\u0435\u0441 \u0441\u0435\u0431\u044f \u0432 \u0436\u0435\u0440\u0442\u0432\u0443
    \u043d\u0430\u0443\u043a\u0435. \u0415\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u043f\u043e\u043b\u043d\u0430 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432: \u043e\u0442 \u0431\u043b\u0438\u0441\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430-\u0434\u0443\u044d\u043b\u044f\u043d\u0442\u0430
    \u0434\u043e \u0437\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u043a\u0430-\u0443\u0447\u0438\u0442\u0435\u043b\u044f,
    \u043e\u0442 \u0432\u0441\u0435\u043e\u0431\u0449\u0435\u0433\u043e \u0437\u0430\u0431\u0432\u0435\u043d\u0438\u044f
    \u0434\u043e \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u00ab\u043d\u0435\u043a\u043e\u0440\u043e\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb.
    \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b
    \u0436\u0435\u043d\u0430\u0442, \u043d\u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c\u0438
    \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044f\u043c\u0438
    \u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u043c\u0438 \u0443\u0442\u0440\u0430\u0442\u0430\u043c\u0438.\n\n\U0001F476
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u041a\u0430\u0440\u043b \u0422\u0435\u043e\u0434\u043e\u0440 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    31 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1815 \u0433\u043e\u0434\u0430 \u0432 \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435
    \u041e\u0441\u0442\u0435\u043d\u0444\u0435\u043b\u044c\u0434\u0435 (\u043d\u044b\u043d\u0435
    \u0447\u0430\u0441\u0442\u044c \u0433\u043e\u0440\u043e\u0434\u0430 \u042d\u043d\u043d\u0438\u0433\u0435\u0440\u043b\u043e,
    \u0412\u0435\u0441\u0442\u0444\u0430\u043b\u0438\u044f). \u041e\u043d \u0431\u044b\u043b
    \u0441\u0442\u0430\u0440\u0448\u0438\u043c \u0441\u044b\u043d\u043e\u043c \u0432 \u0441\u0435\u043c\u044c\u0435.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441, \u0431\u044b\u043b \u0432\u044b\u0445\u043e\u0434\u0446\u0435\u043c
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u043c\u044d\u0440\u0430, \u0441\u043b\u0443\u0436\u0438\u043b
    \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0435\u043c \u0443 \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0433\u0440\u0430\u0444\u0430, \u0430 \u043f\u043e\u0437\u0436\u0435 \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u0442\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u044b\u043c \u0438\u043d\u0441\u043f\u0435\u043a\u0442\u043e\u0440\u043e\u043c.
    \u042d\u0442\u043e \u0431\u044b\u043b \u0432\u043e\u043b\u0435\u0432\u043e\u0439, \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u044b\u0439,
    \u043d\u043e \u043a\u0440\u0430\u0439\u043d\u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u044b\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435
    \u043f\u043e\u043d\u0438\u043c\u0430\u043b \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439
    \u0441\u044b\u043d\u0430 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u043e\u0439. \u041c\u0430\u0442\u044c, \u0422\u0435\u043e\u0434\u043e\u0440\u0430
    \u0424\u0451\u0440\u0441\u0442\u0435\u0440, \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0431\u0443\u0440\u0433\u043e\u043c\u0438\u0441\u0442\u0440\u0430. \u041e\u043d\u0430 \u0443\u043c\u0435\u0440\u043b\u0430,
    \u043a\u043e\u0433\u0434\u0430 \u041a\u0430\u0440\u043b\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e
    12 \u043b\u0435\u0442 (\u0432 1827 \u0433\u043e\u0434\u0443), \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0443 \u041a\u0430\u0440\u043b\u0430 \u0431\u044b\u043b\u0438 \u043c\u043b\u0430\u0434\u0448\u0438\u0435
    \u0431\u0440\u0430\u0442\u044c\u044f. \u041e\u0434\u0438\u043d \u0438\u0437 \u043d\u0438\u0445,
    \u041f\u0435\u0442\u0435\u0440 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441,
    \u0441\u0442\u0430\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c-\u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u0435\u043c,
    \u0430 \u0434\u0440\u0443\u0433\u043e\u0439, \u042e\u043b\u0438\u0443\u0441, \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432 \u0410\u043c\u0435\u0440\u0438\u043a\u0443. \u0421\u0435\u043c\u044c\u044f \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043b\u0430 \u0432\u0441\u043b\u0435\u0434
    \u0437\u0430 \u043e\u0442\u0446\u043e\u043c, \u0447\u0442\u043e \u043c\u0435\u0448\u0430\u043b\u043e
    \u041a\u0430\u0440\u043b\u0443 \u0437\u0430\u0432\u043e\u0434\u0438\u0442\u044c \u0434\u043e\u043b\u0433\u0438\u0435
    \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0435 \u0441\u0432\u044f\u0437\u0438 \u0432
    \u0434\u0435\u0442\u0441\u0442\u0432\u0435. ---\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430
    \u0438 \u044e\u043d\u043e\u0448\u0435\u0441\u0442\u0432\u043e: \u043c\u044f\u0442\u0435\u0436
    \u043f\u0440\u043e\u0442\u0438\u0432 \u043e\u0442\u0446\u0430 1834\u20131838 \u0433\u0433.
    \u2014 \u0411\u043e\u043d\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    (\u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442).
    \u041f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u043e\u0442\u0446\u0430,
    \u0436\u0435\u043b\u0430\u0432\u0448\u0435\u0433\u043e \u0432\u0438\u0434\u0435\u0442\u044c
    \u0441\u044b\u043d\u0430 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u0443\u0436\u0430\u0449\u0438\u043c, \u041a\u0430\u0440\u043b \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0411\u043e\u043d\u043d \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043f\u0440\u0430\u0432\u043e.
    \u041e\u0434\u043d\u0430\u043a\u043e \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043d\u0430\u0443\u043a\u0438 \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u0438 \u0443 \u043d\u0435\u0433\u043e
    \u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435. \u0412\u043c\u0435\u0441\u0442\u043e
    \u043b\u0435\u043a\u0446\u0438\u0439 \u043e\u043d \u0442\u0430\u0439\u043d\u043e \u043f\u043e\u0441\u0435\u0449\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0443\u0436\u043a\u0438
    \u0438 \u0448\u0442\u0443\u0434\u0438\u0440\u043e\u0432\u0430\u043b \u0442\u0440\u0443\u0434\u044b
    \u041b\u0430\u043f\u043b\u0430\u0441\u0430, \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0438 \u042f\u043a\u043e\u0431\u0438. \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f \u043a\u0430\u043a
    \u0437\u0430\u044f\u0434\u043b\u044b\u0439 \u0444\u0435\u0445\u0442\u043e\u0432\u0430\u043b\u044c\u0449\u0438\u043a
    \u0438 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u0443\u044d\u043b\u0435\u0439. \u0421\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c
    \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f, \u0447\u0442\u043e
    \u043e\u043d \u0431\u044b\u043b \u0438\u0441\u043a\u0443\u0441\u043d\u044b\u043c \u0431\u043e\u0439\u0446\u043e\u043c,
    \u0438 \u0445\u043e\u0442\u044f \u043d\u0430 \u0435\u0433\u043e \u043b\u0438\u0446\u0435
    \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u0448\u0440\u0430\u043c\u044b, \u043d\u0438
    \u0440\u0430\u0437\u0443 \u043d\u0435 \u0431\u044b\u043b \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e
    \u0440\u0430\u043d\u0435\u043d. \u0427\u0435\u0442\u044b\u0440\u0435 \u0433\u043e\u0434\u0430
    \u043e\u043d \u0432\u0435\u043b \u0440\u0430\u0437\u0433\u0443\u043b\u044c\u043d\u0443\u044e
    \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0443\u044e \u0436\u0438\u0437\u043d\u044c,
    \u043d\u0435 \u0441\u0434\u0430\u0432 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e
    \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430.
    \u0412 1838 \u0433\u043e\u0434\u0443, \u043f\u043e\u0437\u0430\u0434\u0438 \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u0438 \u043e\u0442\u0435\u0446, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043b\u0438\u0448\u0438\u043b
    \u0435\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438.
    1839 \u0433. \u2014 \u041c\u044e\u043d\u0441\u0442\u0435\u0440\u0441\u043a\u0430\u044f \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f.
    \u041a\u0430\u0440\u043b \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u041c\u044e\u043d\u0441\u0442\u0435\u0440\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0417\u0434\u0435\u0441\u044c
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u0430\u044f
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041a\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u043c \u0413\u0443\u0434\u0435\u0440\u043c\u0430\u043d\u043e\u043c.
    \u0413\u0443\u0434\u0435\u0440\u043c\u0430\u043d, \u0437\u0430\u043c\u0435\u0442\u0438\u0432
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0439 \u0442\u0430\u043b\u0430\u043d\u0442
    \u044e\u043d\u043e\u0448\u0438, \u0443\u0432\u043b\u0435\u043a \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0438 \u043f\u043e \u0441\u0443\u0442\u0438 \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c.
    \u0412 1840 \u0433\u043e\u0434\u0443 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u0438\u043f\u043b\u043e\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u044f.
    ---\n\n\U0001F9D1\u200d\U0001F3EB \u0420\u0430\u0431\u043e\u0442\u0430: 14 \u043b\u0435\u0442
    \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0441\u044b\u043b\u043a\u0438
    \u0421 1842 \u043f\u043e 1856 \u0433\u043e\u0434 \u0434\u043b\u0438\u0442\u0441\u044f \u0441\u0430\u043c\u044b\u0439
    \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u0438 \u2014 \u00ab\u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0430\u0431\u0441\u0442\u0432\u043e\u00bb. 1842\u20131843: \u041c\u044e\u043d\u0441\u0442\u0435\u0440,
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u043a \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u043c.
    1843\u20131848: \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0432 \u0448\u043a\u043e\u043b\u0435
    \u0432 \u0414\u043e\u0439\u0447-\u041a\u0440\u043e\u043d\u0435 (\u043d\u044b\u043d\u0435
    \u0412\u0430\u043b\u0447, \u041f\u043e\u043b\u044c\u0448\u0430). \u041e\u043d \u0436\u0438\u043b
    \u0432 \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u043e\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435,
    \u0441\u043f\u0430\u043b \u043d\u0430 \u0436\u0435\u0441\u0442\u043a\u043e\u0439 \u043a\u043e\u0439\u043a\u0435,
    \u0430 \u0432\u0441\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0438 \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u0443 \u0442\u0440\u0430\u0442\u0438\u043b
    \u043d\u0430 \u043a\u043d\u0438\u0433\u0438 \u0438 \u0431\u0443\u043c\u0430\u0433\u0443.
    1848\u20131856: \u0411\u0440\u0430\u0443\u043d\u0441\u0431\u0435\u0440\u0433 (\u043d\u044b\u043d\u0435
    \u0411\u0440\u0430\u043d\u0435\u0432\u043e, \u041f\u043e\u043b\u044c\u0448\u0430), \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f
    \u0421\u0432\u044f\u0442\u043e\u0439 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b.
    \u0411\u044b\u0442 \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f: \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0438\u043c\u0435\u043b \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0443 \u0434\u043e 30 \u0447\u0430\u0441\u043e\u0432
    \u0432 \u043d\u0435\u0434\u0435\u043b\u044e (\u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0443 \u0438 \u0447\u0438\u0441\u0442\u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435).
    \u0415\u0433\u043e \u0433\u043e\u0434\u043e\u0432\u043e\u0439 \u043e\u043a\u043b\u0430\u0434
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u0436\u0430\u043b\u043a\u0438\u0435
    348 \u0442\u0430\u043b\u0435\u0440\u043e\u0432. \u0418\u0437-\u0437\u0430 \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438
    \u043e\u043d \u043d\u0435 \u043c\u043e\u0433 \u043a\u0443\u043f\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u043c\u0430\u0440\u043e\u043a, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c
    \u0441\u0432\u043e\u0438 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438 \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0436\u0443\u0440\u043d\u0430\u043b\u044b, \u0438 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c
    \u043d\u0435\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c, \u0432 \u043f\u043e\u043b\u043d\u043e\u0439
    \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u043e\u0442 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430, \u043f\u0440\u043e\u0432\u043e\u0434\u044f \u043d\u043e\u0447\u0438
    \u043f\u0440\u0438 \u0441\u0432\u0435\u0447\u0430\u0445, \u043e\u043d \u0437\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0441\u0432\u043e\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.
    \u041e\u043d \u0441\u0430\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e
    \u044d\u0442\u0438 \u0433\u043e\u0434\u044b \u00ab\u0431\u044b\u043b\u0438 \u043f\u043e\u0445\u043e\u0436\u0438
    \u043d\u0430 \u0436\u0438\u0437\u043d\u044c \u0432 \u043a\u0430\u043c\u0435\u043d\u043d\u043e\u043c
    \u043c\u0435\u0448\u043a\u0435\u00bb. ---\n\n\U0001F680 \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0430
    1854 \u0433. \u2014 \u0422\u0440\u0438\u0443\u043c\u0444. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    39 \u043b\u0435\u0442 \u043e\u043d \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442
    \u0432 \u00ab\u0416\u0443\u0440\u043d\u0430\u043b\u0435 \u041a\u0440\u0435\u043b\u043b\u0435\u00bb
    \u0441\u0442\u0430\u0442\u044c\u044e \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e
    \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435. \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0437\u0430\u043e\u0447\u043d\u043e
    \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0430\u0435\u0442 \u0435\u043c\u0443 \u0437\u0432\u0430\u043d\u0438\u0435
    \u043f\u043e\u0447\u0435\u0442\u043d\u043e\u0433\u043e \u0434\u043e\u043a\u0442\u043e\u0440\u0430
    \u043d\u0430\u0443\u043a (\u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438).
    1856 \u0433. \u2014 \u041f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d.
    \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0445\u043e\u0434\u0430\u0442\u0430\u0439\u0441\u0442\u0432\u0443
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430 \u0444\u043e\u043d \u0413\u0443\u043c\u0431\u043e\u043b\u044c\u0434\u0442\u0430,
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442
    \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u043c \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 (\u043f\u043e\u0437\u0436\u0435 \u2014
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442).
    \u041e\u043d \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u043e\u043a\u0438\u0434\u0430\u0435\u0442
    \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u044e. \u0421 1856 \u0433\u043e\u0434\u0430
    \u0438 \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438
    \u043e\u043d \u0436\u0438\u0432\u0435\u0442 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435,
    \u0437\u0430\u043d\u0438\u043c\u0430\u044f \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0433\u043e,
    \u0430 \u0441 1864 \u0433\u043e\u0434\u0430 \u2014 \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0415\u0433\u043e
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c\u0438 \u2014 \u043e\u043d
    \u0447\u0438\u0442\u0430\u043b \u0438\u0445 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e,
    \u0432\u0434\u0443\u043c\u0447\u0438\u0432\u043e, \u0442\u0440\u0435\u0431\u0443\u044f \u043e\u0442
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432 \u043d\u0435 \u043a\u043e\u043d\u0441\u043f\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c,
    \u0430 \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c. ---\n\n\u2764\ufe0f \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438:
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0438 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0431\u044b\u043b \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c,
    \u043d\u043e \u043e\u0447\u0435\u043d\u044c \u0434\u043e\u0431\u0440\u044b\u043c \u0438
    \u0432\u0435\u043b\u0438\u043a\u043e\u0434\u0443\u0448\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043d\u0435 \u0440\u0430\u0437 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b\u0430 \u043a
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430\u043c. \u0421 \u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434\u043e\u043c
    \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u043e\u043c (\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u0438 \u0432\u043e \u0432\u0440\u0430\u0436\u0434\u0443).
    \u042d\u0442\u043e \u0431\u044b\u043b \u0441\u0430\u043c\u044b\u0439 \u0442\u044f\u0436\u0435\u043b\u044b\u0439
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.
    \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440 \u0431\u044b\u043b \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439
    \u043f\u043e \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c\u0443 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0443
    \u0438 \u044f\u0440\u044b\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u043c
    \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    \u0413\u0435\u043e\u0440\u0433\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0430. \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u0442\u0440\u0430\u0432\u0438\u043b \u041a\u0430\u043d\u0442\u043e\u0440\u0430,
    \u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u043c \u0441\u0442\u0440\u043e\u0433\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u043e
    \u0432\u0441\u0442\u0430\u043b \u043d\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u041a\u0430\u043d\u0442\u043e\u0440\u0430.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438
    \u043d\u0430\u043a\u0430\u043b\u0438\u043b\u0438\u0441\u044c \u0434\u043e \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043e\u043d\u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0438
    \u0437\u0434\u043e\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f, \u0445\u043e\u0442\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u0432 \u043e\u0434\u043d\u043e\u043c \u0437\u0434\u0430\u043d\u0438\u0438.
    \u0421 \u0413\u0435\u043e\u0440\u0433\u043e\u043c \u041a\u0430\u043d\u0442\u043e\u0440\u043e\u043c
    (\u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u0434\u0440\u0443\u0436\u0431\u0430 \u0438
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430). \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0445,
    \u043a\u0442\u043e \u0441\u0440\u0430\u0437\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u043b
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u041a\u0430\u043d\u0442\u043e\u0440\u0430.
    \u041e\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u0435\u0433\u043e
    \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u043e \u0438 \u043d\u0430\u0443\u0447\u043d\u043e,
    \u0437\u0430\u0449\u0438\u0449\u0430\u044f \u043e\u0442 \u043d\u0430\u043f\u0430\u0434\u043e\u043a
    \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u0430. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043d\u0430\u0441\u0442\u043e\u044f\u043b
    \u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u043f\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. \u041e\u043d\u0438
    \u0432\u0435\u043b\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430. \u0421 \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434\u043e\u043c
    \u0420\u0438\u043c\u0430\u043d\u043e\u043c (\u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0435
    \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e). \u0425\u043e\u0442\u044f
    \u043e\u043d\u0438 \u043d\u0435 \u0432\u0440\u0430\u0436\u0434\u043e\u0432\u0430\u043b\u0438
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435. \u0420\u0438\u043c\u0430\u043d
    \u0431\u044b\u043b \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u0430\u043a \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0431\u044b\u043b
    \"\u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c\",
    \u0442\u0440\u0435\u0431\u0443\u044e\u0449\u0438\u043c \u0447\u0438\u0441\u0442\u043e\u0433\u043e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0420\u0438\u043c\u0430\u043d
    \u0448\u0438\u0440\u043e\u043a\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b.
    \u0421 \u0421\u043e\u0444\u044c\u0435\u0439 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    (\u0441\u0430\u043c\u0430\u044f \u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u043b\u0438\u0447\u043d\u0430\u044f
    \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c). \u042d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438. \u041f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0438\u0441\u044c
    \u0432 1870 \u0433\u043e\u0434\u0443. \u041e\u043d \u0431\u044b\u043b \u0434\u043b\u044f
    \u043d\u0435\u0451 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c, \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u043e\u0442\u0446\u043e\u043c \u0438, \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u043c
    \u043c\u0443\u0436\u0447\u0438\u043d\u043e\u0439, \u0445\u043e\u0442\u044f \u0438\u0445
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u043f\u043b\u0430\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438. \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043c\u0443\u0436\u0430 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0432 1883 \u0433\u043e\u0434\u0443, \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043f\u0440\u0438\u044e\u0442\u0438\u043b \u0435\u0451 \u0441 \u043c\u0430\u043b\u043e\u043b\u0435\u0442\u043d\u0435\u0439
    \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u0443 \u0441\u0435\u0431\u044f \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435.
    \u041e\u043d \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0441\u0438\u043b\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f
    \u0434\u043b\u044f \u043d\u0435\u0451 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u0439
    \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435.
    \u0418\u0437\u0432\u0435\u0441\u0442\u0438\u0435 \u043e \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0432 1891 \u0433\u043e\u0434\u0443 \u043e\u0442 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f
    \u043b\u0435\u0433\u043a\u0438\u0445 \u0441\u0442\u0430\u043b\u043e \u0434\u043b\u044f 75-\u043b\u0435\u0442\u043d\u0435\u0433\u043e
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u043e\u0439.
    \u041e\u043d \u0443\u0448\u0435\u043b \u0432 \u0441\u0435\u0431\u044f, \u0441\u0436\u0435\u0433
    \u0432\u0441\u0435 \u0435\u0451 \u043f\u0438\u0441\u044c\u043c\u0430 \u043a \u043d\u0435\u043c\u0443
    (\u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u043e\u0438)
    \u0438, \u043f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432, \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e
    \u0441\u0442\u0430\u043b \u0431\u044b\u0441\u0442\u0440\u043e \u0441\u0434\u0430\u0432\u0430\u0442\u044c.
    ---\n\n\U0001FA7A \u0411\u043e\u043b\u0435\u0437\u043d\u0438 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u043b\u043e \u0441\u043b\u0430\u0431\u044b\u043c
    \u0438\u0437-\u0437\u0430 \u043f\u0435\u0440\u0435\u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f
    \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438. \u0412 1861 \u0433\u043e\u0434\u0443
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043b\u0435\u043a\u0446\u0438\u0438 \u0443
    \u043d\u0435\u0433\u043e \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u0441\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f
    \u0438 \u043c\u0438\u0433\u0440\u0435\u043d\u0438. \u0421 \u0442\u0435\u0445 \u043f\u043e\u0440
    \u043e\u043d \u043d\u0435 \u043c\u043e\u0433 \u0441\u0442\u043e\u044f\u0442\u044c \u0447\u0438\u0442\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438 \u2014 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0438\u0434\u0435\u043b
    \u0432 \u043a\u0440\u0435\u0441\u043b\u0435, \u0430 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b
    \u043f\u043e \u043e\u0447\u0435\u0440\u0435\u0434\u0438 \u043f\u0438\u0441\u0430\u043b\u0438
    \u0437\u0430 \u043d\u0435\u0433\u043e \u043d\u0430 \u0434\u043e\u0441\u043a\u0435 \u043c\u0435\u043b\u043e\u043c.
    \u0421 \u043a\u043e\u043d\u0446\u0430 1880-\u0445 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u0438\u043a\u043e\u0432\u0430\u043d \u043a \u043f\u043e\u0441\u0442\u0435\u043b\u0438
    \u0432 \u0441\u0432\u043e\u0435\u0439 \u0431\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0435. \u041e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b
    \u043e\u0442 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u0435\u0441\u0441\u043e\u043d\u043d\u0438\u0446\u044b
    \u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 \u0441\u0435\u0440\u0434\u0446\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0434\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445
    \u0434\u043d\u0435\u0439 \u043e\u043d \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0443 \u0441\u0435\u0431\u044f \u0434\u043e\u043c\u0430, \u0447\u0438\u0442\u0430\u044f
    \u0438\u043c \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u0440\u044f\u043c\u043e \u0441
    \u043a\u0440\u043e\u0432\u0430\u0442\u0438. ---\n\n\u26b0\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c
    \u041a\u0430\u0440\u043b \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 19 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1897 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u043e\u0442
    \u043a\u0440\u0443\u043f\u043e\u0437\u043d\u043e\u0439 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438.
    \u0415\u043c\u0443 \u0431\u044b\u043b 81 \u0433\u043e\u0434. \u041e\u043d \u0443\u043c\u0435\u0440
    \u0432 \u043f\u043e\u043b\u043d\u043e\u043c \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0435
    (\u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442,
    \u0434\u0435\u0442\u0435\u0439 \u043d\u0435 \u0438\u043c\u0435\u043b). \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u044b
    \u0431\u044b\u043b\u0438 \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u043c\u0438, \u043d\u043e
    \u043d\u0430 \u043d\u0438\u0445 \u0441\u043e\u0431\u0440\u0430\u043b\u0430\u0441\u044c \u0432\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u044d\u043b\u0438\u0442\u0430
    \u0415\u0432\u0440\u043e\u043f\u044b. \u041e\u043d \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043d\u0430 \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435 \u0421\u0432\u044f\u0442\u043e\u0439
    \u042f\u0434\u0432\u0438\u0433\u0438 (St. Hedwig-Friedhof) \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435.
    \u0415\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043c\u0435\u0441\u0442\u043e\u043c \u043f\u0430\u043b\u043e\u043c\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0441\u043e \u0432\u0441\u0435\u0433\u043e
    \u043c\u0438\u0440\u0430. \u0412 \u043f\u0430\u043c\u044f\u0442\u044c \u043e \u043d\u0435\u043c
    \u043d\u0430\u0437\u0432\u0430\u043d \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435
    (\u043a\u0440\u0430\u0442\u0435\u0440 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430)
    \u0438 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0438 \u0441\u0442\u043e\u0445\u0430\u0441\u0442\u0438\u043a\u0438 (WIAS) \u043d\u043e\u0441\u0438\u0442
    \u0435\u0433\u043e \u0438\u043c\u044f."
  personalLifeEn: 
  shortBioRu: "\u041a\u0430\u0440\u043b \u0422\u0435\u043e\u0434\u043e\u0440 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 (1815\u20131897) \u2014
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u0451 \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435 \u043a \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u043e\u0439
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u043b\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u0443\u0442\u044c
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u043e\u0437\u0434\u043d\u0435\u0433\u043e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f \u0433\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0432 \u0442\u0435\u043d\u0438, \u043d\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u0441\u0442\u0430\u043b
    \u00ab\u043e\u0442\u0446\u043e\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u00bb.\n\n\U0001F9EC \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u044e\u043d\u043e\u0441\u0442\u044c: \u043d\u0435\u0441\u0433\u0438\u0431\u0430\u0435\u043c\u0430\u044f
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u041a\u0430\u0440\u043b \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    31 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1815 \u0433\u043e\u0434\u0430 \u0432 \u041e\u0441\u0442\u0435\u043d\u0444\u0435\u043b\u044c\u0434\u0435,
    \u0412\u0435\u0441\u0442\u0444\u0430\u043b\u0438\u044f, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430. \u0415\u0433\u043e \u043c\u0430\u0442\u044c
    \u0422\u0435\u043e\u0434\u043e\u0440\u0430 \u0443\u043c\u0435\u0440\u043b\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0435\u043c\u0443 \u0431\u044b\u043b\u043e 12 \u043b\u0435\u0442, \u0438 \u043c\u0430\u043b\u044c\u0447\u0438\u043a
    \u0440\u043e\u0441 \u043f\u043e\u0434 \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c
    \u043e\u0442\u0446\u0430, \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0438\u0434\u0435\u043b \u0441\u044b\u043d\u0430
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u0443\u0436\u0430\u0449\u0438\u043c. \u0412 1829 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e
    \u0432 \u041f\u0430\u0434\u0435\u0440\u0431\u043e\u0440\u043d\u0435, \u0433\u0434\u0435
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u043f\u0435\u0440\u0435\u0436\u0430\u043b \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443,
    \u0447\u0442\u043e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0441\u0432\u043e\u0438\u043b \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u0438 \u0448\u0442\u0443\u0434\u0438\u0440\u043e\u0432\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u044b \u0410\u0431\u0435\u043b\u044f \u0438 \u042f\u043a\u043e\u0431\u0438
    \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c \u0432 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435.
    \u0418\u0437-\u0437\u0430 \u0441\u0442\u0435\u0441\u043d\u0435\u043d\u043d\u043e\u0433\u043e
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u0435\u043c\u044c\u0438 \u041a\u0430\u0440\u043b
    \u0441 15 \u043b\u0435\u0442 \u043f\u043e\u0434\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b
    \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u043e\u043c \u0443 \u0442\u043e\u0440\u0433\u043e\u0432\u043a\u0438.
    \u0412 1834 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e \u0441 \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c
    \u0438 \u043f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u043e\u0442\u0446\u0430
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0411\u043e\u043d\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043d\u0430 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442. \u042d\u0442\u043e \u0431\u044b\u043b
    \u0433\u043e\u0434, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432\u0448\u0438\u0439
    \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440: \u0432\u043c\u0435\u0441\u0442\u043e
    \u043f\u0440\u0430\u0432\u0430 \u041a\u0430\u0440\u043b \u0441 \u0433\u043e\u043b\u043e\u0432\u043e\u0439
    \u0443\u0448\u0435\u043b \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0443\u044e \u0436\u0438\u0437\u043d\u044c.
    \u041e\u043d \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f \u043a\u0430\u043a
    \u0438\u0441\u043a\u0443\u0441\u043d\u044b\u0439 \u0444\u0435\u0445\u0442\u043e\u0432\u0430\u043b\u044c\u0449\u0438\u043a,
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0434\u0443\u044d\u043b\u044f\u0445,
    \u043d\u043e \u043d\u0438 \u0440\u0430\u0437\u0443 \u043d\u0435 \u0431\u044b\u043b \u0440\u0430\u043d\u0435\u043d.
    \u0427\u0435\u0442\u044b\u0440\u0435 \u0433\u043e\u0434\u0430 \u0441\u043f\u0443\u0441\u0442\u044f,
    \u043d\u0435 \u0441\u0434\u0430\u0432 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430, \u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0434\u043e\u043c\u043e\u0439, \u043e\u0442\u043a\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044c
    \u043e\u0442 \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430.\n\n\U0001F4DA
    \u041f\u0443\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043a \u0441\u043b\u0430\u0432\u0435 \u0412 1839 \u0433\u043e\u0434\u0443, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u043f\u043e\u043c\u043e\u0449\u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0445, \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u041c\u044e\u043d\u0441\u0442\u0435\u0440\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u0430\u0442\u0442\u0435\u0441\u0442\u0430\u0442\u0430.
    \u0422\u0430\u043c \u0441\u0443\u0434\u044c\u0431\u0430 \u0441\u0432\u0435\u043b\u0430 \u0435\u0433\u043e
    \u0441 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u041a\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u043c
    \u0413\u0443\u0434\u0435\u0440\u043c\u0430\u043d\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b \u0432 \u043d\u0435\u043c \u0433\u0435\u043d\u0438\u044f
    \u0438 \u0443\u0432\u043b\u0435\u043a \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.
    \u042d\u0442\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0439. \u0421 1842 \u043f\u043e 1856 \u0433\u043e\u0434
    \u0434\u043b\u0438\u0442\u0441\u044f \u00ab\u043f\u0435\u0440\u0438\u043e\u0434 \u0437\u0430\u0431\u0432\u0435\u043d\u0438\u044f\u00bb
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430. \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0432 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0445, \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439 \u0434\u043e 30 \u0447\u0430\u0441\u043e\u0432
    \u0432 \u043d\u0435\u0434\u0435\u043b\u044e. \u0415\u043c\u0443 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u043d\u043e \u0438 \u0444\u0438\u0437\u0438\u043a\u0443,
    \u0431\u043e\u0442\u0430\u043d\u0438\u043a\u0443, \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044e,
    \u0438\u0441\u0442\u043e\u0440\u0438\u044e, \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a \u0438 \u0434\u0430\u0436\u0435 \u0433\u0438\u043c\u043d\u0430\u0441\u0442\u0438\u043a\u0443.
    \u0417\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0430 (348 \u0442\u0430\u043b\u0435\u0440\u043e\u0432
    \u0432 \u0433\u043e\u0434) \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0430\u043b\u043e,
    \u0447\u0442\u043e\u0431\u044b \u043a\u0443\u043f\u0438\u0442\u044c \u043c\u0430\u0440\u043a\u0438
    \u0434\u043b\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439
    \u0432 \u0436\u0443\u0440\u043d\u0430\u043b\u044b. \u041f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0439
    \u0432 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u044e, \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0449\u0430\u043b
    \u043d\u043e\u0447\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0442\u043e\u0433\u0434\u0430, \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445
    \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432,
    \u043e\u043d \u0437\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0441\u0432\u043e\u0435\u0439 \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438.
    \u041d\u0435\u0445\u0432\u0430\u0442\u043a\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0431\u044b\u043b\u0430 \u0442\u0430\u043a\u043e\u0432\u0430, \u0447\u0442\u043e \u0434\u0430\u0436\u0435
    \u0432 \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0434\u0438\u043f\u043b\u043e\u043c\u0435
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u043e\u043c
    \u0432 1841 \u0433\u043e\u0434\u0443, \u0431\u044b\u043b\u0430 \u0437\u0430\u043f\u0438\u0441\u044c
    \u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043a\u0435 \u0437\u043d\u0430\u043d\u0438\u0439
    \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c,
    \u0447\u0442\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u043e
    \u0435\u0433\u043e \u043f\u0440\u0430\u0432\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0438\u0445.\n\n\U0001F680 \u0412\u0437\u043b\u0435\u0442 \u0438 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u041f\u0440\u043e\u0440\u044b\u0432 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u0432 1854 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0432 \u00ab\u0416\u0443\u0440\u043d\u0430\u043b\u0435
    \u041a\u0440\u0435\u043b\u043b\u0435\u00bb \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c. \u041e\u043d\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0430
    \u044d\u0444\u0444\u0435\u043a\u0442 \u0440\u0430\u0437\u043e\u0440\u0432\u0430\u0432\u0448\u0435\u0439\u0441\u044f
    \u0431\u043e\u043c\u0431\u044b. \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e
    \u043f\u0440\u0438\u0441\u0432\u043e\u0438\u043b \u0435\u043c\u0443 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043f\u043e\u0447\u0435\u0442\u043d\u043e\u0433\u043e \u0434\u043e\u043a\u0442\u043e\u0440\u0430
    \u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438.
    \u0412 1856 \u0433\u043e\u0434\u0443, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430
    \u0444\u043e\u043d \u0413\u0443\u043c\u0431\u043e\u043b\u044c\u0434\u0442\u0430, \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432 \u041f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u2014 \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0421 \u044d\u0442\u043e\u0433\u043e
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f
    \u0435\u0433\u043e 40-\u043b\u0435\u0442\u043d\u044f\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0430 \u0435\u0433\u043e \u0432 \u0437\u0432\u0435\u0437\u0434\u0443
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b. \u0412
    1864 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u0415\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438,
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0435 \u043f\u043e \u0441\u043e\u043a\u0440\u0430\u0442\u043e\u0432\u0441\u043a\u043e\u043c\u0443
    \u043c\u0435\u0442\u043e\u0434\u0443 \u00ab\u043c\u0430\u0439\u0435\u0432\u0442\u0438\u043a\u0438\u00bb
    \u2014 \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u0432 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0439 \u043f\u043e\u0438\u0441\u043a
    \u0438\u0441\u0442\u0438\u043d\u044b, \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0438 \u043f\u0435\u0440\u0435\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u0435
    \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438 \u0438 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0438
    \u0435\u0433\u043e \u043a\u0430\u043a \u043b\u0443\u0447\u0448\u0435\u0433\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f
    \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438. \u041e\u0434\u043d\u0430\u043a\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435,
    \u043f\u043e\u0434\u043e\u0440\u0432\u0430\u043d\u043d\u043e\u0435 \u043d\u043e\u0447\u043d\u044b\u043c\u0438
    \u0431\u0434\u0435\u043d\u0438\u044f\u043c\u0438, \u0434\u0430\u043b\u043e \u0441\u0431\u043e\u0439.
    \u0412 1861 \u0433\u043e\u0434\u0443 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043b\u0435\u043a\u0446\u0438\u0438
    \u0443 \u043d\u0435\u0433\u043e \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u0442\u044f\u0436\u0435\u043b\u044b\u0439
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f.
    \u0421 \u0442\u0435\u0445 \u043f\u043e\u0440 \u043e\u043d \u0447\u0438\u0442\u0430\u043b
    \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0438\u0434\u044f, \u0430 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b
    \u043f\u0438\u0441\u0430\u043b\u0438 \u0437\u0430 \u043d\u0435\u0433\u043e \u043d\u0430
    \u0434\u043e\u0441\u043a\u0435. \u0421 \u043a\u043e\u043d\u0446\u0430 1880-\u0445 \u0433\u043e\u0434\u043e\u0432
    \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u0438\u043a\u043e\u0432\u0430\u043d \u043a \u043f\u043e\u0441\u0442\u0435\u043b\u0438.\n\n\U0001F494
    \u0421\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u0430\u044f \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0441 \u0421\u043e\u0444\u044c\u0435\u0439 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0412 1870 \u0433\u043e\u0434\u0443 \u0432 \u0436\u0438\u0437\u043d\u0438 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430,
    \u043e\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0430\u044f \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434. \u041a \u043d\u0435\u043c\u0443 \u043f\u0440\u0438\u0435\u0445\u0430\u043b\u0430
    20-\u043b\u0435\u0442\u043d\u044f\u044f \u0421\u043e\u0444\u044c\u044f \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u044b\u043b\u043e \u043e\u0442\u043a\u0430\u0437\u0430\u043d\u043e
    \u0432 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0438 \u043b\u0435\u043a\u0446\u0438\u0439
    \u0438\u0437-\u0437\u0430 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d\u0430
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430. \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0432\u0437\u044f\u043b\u0441\u044f \u043e\u0431\u0443\u0447\u0430\u0442\u044c \u0435\u0451
    \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e, \u0438 \u043e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0435\u0433\u043e \u043b\u0443\u0447\u0448\u0435\u0439 \u0443\u0447\u0435\u043d\u0438\u0446\u0435\u0439.
    \u0418\u0445 \u0441\u0432\u044f\u0437\u044c \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u0430
    \u0432 \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u043b\u0438\u0447\u043d\u0443\u044e
    \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c. \u041e\u043d
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u0435\u0439 \u0432 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u0445,
    \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u0434\u043b\u044f \u043d\u0435\u0451 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0438, \u043f\u043e\u0441\u043b\u0435
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0438\u0431\u0435\u043b\u0438
    \u0435\u0451 \u043c\u0443\u0436\u0430 \u0432 1883 \u0433\u043e\u0434\u0443, \u043f\u0440\u0438\u044e\u0442\u0438\u043b
    \u0435\u0451 \u0441 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0434\u043e\u043c\u0435 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435.
    \u0426\u0435\u043d\u043e\u0439 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445
    \u0443\u0441\u0438\u043b\u0438\u0439 \u043e\u043d \u043f\u043e\u043c\u043e\u0433 \u0435\u0439
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435.
    \u0418\u0437\u0432\u0435\u0441\u0442\u0438\u0435 \u043e \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0432 1891 \u0433\u043e\u0434\u0443 \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u043e \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430.
    \u0423\u0437\u043d\u0430\u0432 \u043e\u0431 \u044d\u0442\u043e\u043c, \u043e\u043d \u0441\u0436\u0435\u0433
    \u0432\u0441\u0435 \u0435\u0435 \u043f\u0438\u0441\u044c\u043c\u0430, \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432
    \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441 \u043d\u0435\u0439. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F9E0
    \u00ab\u041e\u0442\u0435\u0446 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u00bb \u0413\u043b\u0430\u0432\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u2014 \u044d\u0442\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u0430
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u0438 \u0430\u043d\u0430\u043b\u0438\u0437\u0430.
    \u0414\u043e \u043d\u0435\u0433\u043e \u0434\u0430\u0436\u0435 \u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u041a\u043e\u0448\u0438 \u0431\u044b\u043b\u043e \u043c\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u044b\u0445
    \u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0438\u0439. \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0438 \u0432\u0432\u0435\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u03b5-\u03b4-\u044f\u0437\u044b\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e
    \u0441\u0438\u0445 \u043f\u043e\u0440 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0418\u043c\u0435\u043d\u043d\u043e \u0435\u043c\u0443
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u0435\u043b\u0430,
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438 \u0438 \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u044b \u0443\u0447\u0438\u043c \u0441\u0435\u0433\u043e\u0434\u043d\u044f.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u0440\u0430\u0437\u0438\u043b \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043c\u0438\u0440, \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0432 \u0432 1861 \u0433\u043e\u0434\u0443
    \u0444\u0443\u043d\u043a\u0446\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430
    \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0442\u043e\u0447\u043a\u0435, \u043d\u043e
    \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439
    \u043d\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0435, \u2014
    \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f
    \u043c\u043e\u0436\u0435\u0442 \u043e\u0431\u043c\u0430\u043d\u044b\u0432\u0430\u0442\u044c.
    \u0421\u0440\u0435\u0434\u0438 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u2014 \u0442\u0430\u043a\u0438\u0435 \u0437\u0432\u0435\u0437\u0434\u044b, \u043a\u0430\u043a
    \u0413\u0435\u043e\u0440\u0433 \u041a\u0430\u043d\u0442\u043e\u0440, \u0424\u0435\u0440\u0434\u0438\u043d\u0430\u043d\u0434
    \u0424\u0440\u043e\u0431\u0435\u043d\u0438\u0443\u0441, \u041a\u0430\u0440\u043b \u0420\u0443\u043d\u0433\u0435
    \u0438 \u0421\u043e\u0444\u044c\u044f \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f.
    \u041a\u0430\u0440\u043b \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 19 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1897 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u043e\u0442
    \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438, \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043c\u0435\u043d\u0438\u0432 \u043b\u0438\u0446\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0438\u043c\u044f \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u043e\u0441\u044f\u0442
    \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435 \u0438 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438 \u0441\u0442\u043e\u0445\u0430\u0441\u0442\u0438\u043a\u0438
    (WIAS)."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041a\u0430\u0440\u043b\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u0432, \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445
    \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u0438 \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a
    \u0441\u0443\u0445\u043e\u0433\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430,
    \u043d\u043e \u0438 \u043a\u0430\u043a \u0436\u0438\u0432\u043e\u0433\u043e, \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u043e\u0433\u043e
    \u0438 \u043e\u0447\u0435\u043d\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u044f\u0440\u043a\u0438\u0435 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b, \u043a\u0443\u0440\u044c\u0435\u0437\u044b \u0438 \u0434\u0435\u0442\u0430\u043b\u0438
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.\n\n\u2694\ufe0f
    1. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0435 \u0431\u043e\u044f\u043b\u0441\u044f \u0448\u0440\u0430\u043c\u043e\u0432 (\u0421\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u0443\u044d\u043b\u0438) \u0412\u043e\u043f\u0440\u0435\u043a\u0438 \u043e\u0431\u0440\u0430\u0437\u0443
    \u0442\u0438\u0445\u043e\u0433\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043d\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u0432 \u0411\u043e\u043d\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 (1834\u20131838) \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0431\u044b\u043b \u043e\u0442\u0447\u0430\u044f\u043d\u043d\u044b\u043c \u0441\u043e\u0440\u0432\u0438\u0433\u043e\u043b\u043e\u0432\u043e\u0439.
    \u041e\u043d \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u043e\u0435
    \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u043e Corps Guestphalia \u0438 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u043a\u0430\u043a \u043e\u0434\u0438\u043d \u0438\u0437 \u043b\u0443\u0447\u0448\u0438\u0445
    \u0444\u0435\u0445\u0442\u043e\u0432\u0430\u043b\u044c\u0449\u0438\u043a\u043e\u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u041a\u0443\u0440\u044c\u0435\u0437: \u041e\u043d \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0434\u0435\u0441\u044f\u0442\u043a\u0430\u0445 \u0434\u0443\u044d\u043b\u0435\u0439
    \u043d\u0430 \u0440\u0430\u043f\u0438\u0440\u0430\u0445, \u0438 \u0435\u0433\u043e \u043b\u0438\u0446\u043e
    \u0431\u044b\u043b\u043e \u0443\u043a\u0440\u0430\u0448\u0435\u043d\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u00ab\u0448\u0440\u0430\u043c\u0438\u0440\u0430\u043c\u0438\u00bb (Schmiss) \u2014 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u044c\u044e
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0418\u0440\u043e\u043d\u0438\u044f
    \u0441\u0443\u0434\u044c\u0431\u044b: \u0417\u0430 4 \u0433\u043e\u0434\u0430 \u0431\u0443\u0440\u043d\u043e\u0439
    \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u043f\u043e\u043b\u0443\u0447\u0430\u044f \u0443\u0434\u0430\u0440\u044b \u0440\u0430\u043f\u0438\u0440\u043e\u0439
    \u0432 \u0433\u043e\u043b\u043e\u0432\u0443 \u0438 \u043a\u043e\u0440\u043f\u0443\u0441,
    \u043e\u043d \u043d\u0438 \u0440\u0430\u0437\u0443 \u043d\u0435 \u0431\u044b\u043b \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e
    \u0440\u0430\u043d\u0435\u043d. \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u0441\u043f\u0443\u0441\u0442\u044f
    \u0433\u043e\u0434\u044b, \u0441\u0438\u0434\u044f \u0432 \u0442\u0438\u0448\u0438\u043d\u0435
    \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430, \u043e\u043d \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0433\u043e\u043b\u043e\u0432\u043d\u044b\u0435
    \u0431\u043e\u043b\u0438 \u0438 \u0431\u0435\u0441\u0441\u043e\u043d\u043d\u0438\u0446\u0443
    \u043e\u0442 \u0443\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f.
    \u0422\u043e \u0435\u0441\u0442\u044c \u0444\u0435\u0445\u0442\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u0435\u0435, \u0447\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.\n\n\U0001F4B0
    2. \u042d\u043a\u043e\u043d\u043e\u043c\u0438\u044f \u043d\u0430 \u043c\u0430\u0440\u043a\u0430\u0445
    \u0438 \u00ab\u0440\u0430\u0437\u043e\u0440\u0432\u0430\u043d\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430\u00bb
    \u0412 \u0433\u043e\u0434\u044b \u0440\u0430\u0431\u043e\u0442\u044b \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c
    \u0432 \u0414\u043e\u0439\u0447-\u041a\u0440\u043e\u043d\u0435 \u0438 \u0411\u0440\u0430\u0443\u043d\u0441\u0431\u0435\u0440\u0433\u0435
    (1843\u20131856) \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0431\u044b\u043b
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0431\u0435\u0434\u0435\u043d, \u0447\u0442\u043e
    \u044d\u0442\u043e \u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b\u043e \u0441 \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u043e\u043c.
    \u0424\u0430\u043a\u0442: \u0415\u0433\u043e \u0433\u043e\u0434\u043e\u0432\u043e\u0433\u043e
    \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u044c\u044f (348 \u0442\u0430\u043b\u0435\u0440\u043e\u0432)
    \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0430\u043b\u043e \u043d\u0430 \u0435\u0434\u0443
    \u0438 \u0441\u0432\u0435\u0447\u0438. \u0427\u0442\u043e\u0431\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c
    \u0441\u0432\u043e\u044e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u0442\u0430\u0442\u044c\u044e
    \u043f\u043e \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c
    \u0432 \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u044b\u0439 \u00ab\u0416\u0443\u0440\u043d\u0430\u043b
    \u041a\u0440\u0435\u043b\u043b\u0435\u00bb, \u0435\u043c\u0443 \u043d\u0443\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u043a\u0443\u043f\u0438\u0442\u044c \u043f\u043e\u0447\u0442\u043e\u0432\u044b\u0435
    \u043c\u0430\u0440\u043a\u0438. \u041a\u0443\u0440\u044c\u0435\u0437: \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043e\u0442\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b
    \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0443 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439
    \u043d\u0430 \u043c\u0435\u0441\u044f\u0446\u044b, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e
    \u0434\u0435\u043d\u0435\u0433 \u043d\u0430 \u043c\u0430\u0440\u043a\u0438 \u0434\u043b\u044f
    \u0442\u044f\u0436\u0435\u043b\u043e\u0433\u043e \u043a\u043e\u043d\u0432\u0435\u0440\u0442\u0430.
    \u0412 \u0438\u0442\u043e\u0433\u0435 \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u043b
    \u0438\u0445 \u0441 \u043e\u043a\u0430\u0437\u0438\u0435\u0439 \u0438\u043b\u0438 \u0432
    \u0434\u043e\u043b\u0433, \u0447\u0435\u043c \u0441\u0438\u043b\u044c\u043d\u043e \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e \u0441\u0432\u043e\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439. \u0415\u0441\u043b\u0438 \u0431\u044b
    \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0438 \u043b\u0438\u0448\u043d\u0438\u0435
    \u0433\u0440\u043e\u0448\u0438, \u043e\u043d \u043c\u043e\u0433 \u0431\u044b \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u0442\u044c\u0441\u044f
    \u043d\u0430 5 \u043b\u0435\u0442 \u0440\u0430\u043d\u044c\u0448\u0435!\n\n\U0001F9D1\u200d\U0001F3EB
    3. \u00ab\u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0441 \u043c\u0435\u043b\u043a\u043e\u043c\u00bb
    \u0438 \u043b\u0435\u043a\u0446\u0438\u0438 \u0432 \u043a\u0440\u0435\u0441\u043b\u0435
    \u041f\u043e\u0441\u043b\u0435 1861 \u0433\u043e\u0434\u0430 \u0443 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0440\u0430\u0437\u0432\u0438\u043b\u0430\u0441\u044c \u0442\u044f\u0436\u0435\u043b\u0430\u044f
    \u0444\u043e\u0440\u043c\u0430 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u0432 \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f
    (\u0432\u0435\u0440\u0442\u0438\u0433\u043e). \u0421\u0442\u043e\u044f\u0442\u044c \u043d\u0430
    \u043a\u0430\u0444\u0435\u0434\u0440\u0435 \u043e\u043d \u0431\u043e\u043b\u044c\u0448\u0435
    \u043d\u0435 \u043c\u043e\u0433. \u0422\u0440\u0430\u0434\u0438\u0446\u0438\u044f: \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u0430\u0434\u0438\u043b\u0441\u044f \u0432 \u0431\u043e\u043b\u044c\u0448\u043e\u0435
    \u043c\u044f\u0433\u043a\u043e\u0435 \u043a\u0440\u0435\u0441\u043b\u043e \u043f\u0435\u0440\u0435\u0434
    \u0434\u043e\u0441\u043a\u043e\u0439 \u0438 \u0447\u0438\u0442\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u0441\u0438\u0434\u044f. \u041d\u043e \u0442\u0430\u043a \u043a\u0430\u043a \u0441\u0430\u043c
    \u043e\u043d \u043f\u043e\u0434\u043d\u044f\u0442\u044c\u0441\u044f \u043a \u0434\u043e\u0441\u043a\u0435
    \u043d\u0435 \u043c\u043e\u0433, \u043e\u043d \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u0430 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b
    \u043f\u043e \u043e\u0447\u0435\u0440\u0435\u0434\u0438 \u0432\u044b\u0445\u043e\u0434\u0438\u043b\u0438
    \u043a \u0434\u043e\u0441\u043a\u0435 \u0438 \u043f\u0438\u0441\u0430\u043b\u0438 \u043c\u0435\u043b\u043e\u043c
    \u043f\u043e\u0434 \u0435\u0433\u043e \u0434\u0438\u043a\u0442\u043e\u0432\u043a\u0443.
    \u0417\u0430\u0431\u0430\u0432\u043d\u044b\u0439 \u0448\u0442\u0440\u0438\u0445: \u041e\u0447\u0435\u0432\u0438\u0434\u0446\u044b
    \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0438, \u0447\u0442\u043e \u043e\u043d
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b \u043f\u0438\u0441\u0430\u0442\u044c \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e
    \u0440\u043e\u0432\u043d\u043e. \u0415\u0441\u043b\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442
    \u0441\u0442\u0430\u0432\u0438\u043b \u043a\u0440\u0438\u0432\u043e\u0439 \u0437\u043d\u0430\u043a
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430, \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u044e
    \u0438 \u0432\u043e\u0440\u0447\u0430\u043b: \u00ab\u041c\u043e\u043b\u043e\u0434\u043e\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043a\u0430\u043b\u043b\u0438\u0433\u0440\u0430\u0444\u0438\u044f,
    \u043d\u043e \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0432 \u0437\u043d\u0430\u043a\u0430\u0445
    \u2014 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0432 \u0433\u043e\u043b\u043e\u0432\u0435!\u00bb
    \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u043e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043f\u043e\u0432\u044b\u0448\u0430\u043b \u0433\u043e\u043b\u043e\u0441\u0430,
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u0435\u0433\u043e \u043e\u0431\u043e\u0436\u0430\u043b\u0438.\n\n\U0001F436
    4. \u0421\u043e\u0431\u0430\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0433\u0443\u043b\u044f\u043b\u0430
    \u0432\u043c\u0435\u0441\u0442\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043e\u0431\u043e\u0436\u0430\u043b
    \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0441\u043e\u0431\u0430\u043a. \u0412 \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u0443
    \u043d\u0435\u0433\u043e \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u0442\u0430\u043a\u0441\u0430.
    \u041a\u0443\u0440\u044c\u0435\u0437: \u041d\u0430 \u0441\u043a\u043b\u043e\u043d\u0435
    \u043b\u0435\u0442, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0441\u043e\u0432\u0441\u0435\u043c
    \u043e\u0441\u043b\u0430\u0431, \u043e\u043d \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e
    \u0445\u043e\u0442\u0435\u043b \u0433\u0443\u043b\u044f\u0442\u044c. \u041d\u043e \u0438\u0437-\u0437\u0430
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0435\u0433\u043e \u0448\u0430\u0442\u0430\u043b\u043e,
    \u043e\u043d \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u0443:
    \u043e\u043d \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u043b \u0442\u0430\u043a\u0441\u0443
    \u0432\u043f\u0435\u0440\u0435\u0434 \u043d\u0430 \u043f\u043e\u0432\u043e\u0434\u043a\u0435,
    \u0438 \u0441\u043e\u0431\u0430\u043a\u0430 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e
    \u0442\u0430\u0449\u0438\u043b\u0430 \u0435\u0433\u043e \u043f\u043e \u0430\u043b\u043b\u0435\u044f\u043c
    \u0422\u0438\u0440\u0433\u0430\u0440\u0442\u0435\u043d\u0430. \u0421\u043e\u0441\u0435\u0434\u0438
    \u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u0447\u0430\u0441\u0442\u043e \u0432\u0438\u0434\u0435\u043b\u0438,
    \u043a\u0430\u043a \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0434\u0435\u0440\u0436\u0430\u0441\u044c
    \u0437\u0430 \u043f\u043e\u0432\u043e\u0434\u043e\u043a, \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u043d\u043e\u0441\u043e\u043c \u0441\u0432\u043e\u0435\u0439
    \u0442\u0430\u043a\u0441\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0430\u043c\u0430
    \u0432\u044b\u0431\u0438\u0440\u0430\u043b\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442
    \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438.\n\n\U0001F92F 5. \u041a\u0430\u043a \u043e\u043d
    \u00ab\u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043b\u00bb \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044e
    (\u0421\u043a\u0430\u043d\u0434\u0430\u043b \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439)
    \u0412 1861 \u0433\u043e\u0434\u0443 \u043d\u0430 \u043b\u0435\u043a\u0446\u0438\u0438 \u043e\u043d
    \u043f\u0440\u0438\u0432\u0435\u043b \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0439
    \u0432\u0435\u0437\u0434\u0435, \u043d\u043e \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0435\u0439
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439 \u043d\u0438\u0433\u0434\u0435.
    \u0420\u0435\u0430\u043a\u0446\u0438\u044f: \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u044d\u0442\u043e \u043a\u0430\u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u0432\u043e\u043a\u0430\u0446\u0438\u044e.
    \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0428\u0430\u0440\u043b\u044c \u042d\u0440\u043c\u0438\u0442 \u043d\u0430\u0437\u0432\u0430\u043b
    \u044d\u0442\u043e \u00ab\u0443\u0436\u0430\u0441\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439\u00bb.
    \u041e\u0434\u0438\u043d \u0438\u0437 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430, \u0443\u0441\u043b\u044b\u0448\u0430\u0432
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b:
    \u00ab\u0415\u0441\u043b\u0438 \u044d\u0442\u043e \u043f\u0440\u0430\u0432\u0434\u0430,
    \u0442\u043e \u044f \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043f\u043e\u0432\u0435\u0440\u044e \u043d\u0438 \u0432 \u043e\u0434\u043d\u0443
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443!\u00bb
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0443\u0441\u043c\u0435\u0445\u043d\u0443\u043b\u0441\u044f
    \u0438 \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439
    \u0444\u0440\u0430\u0437\u043e\u0439: \u00ab\u0412 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u043d\u0435\u0442 \u043c\u0435\u0441\u0442\u0430 \u0440\u0438\u0441\u0443\u043d\u043a\u0430\u043c,
    \u0435\u0441\u0442\u044c \u043c\u0435\u0441\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0442\u0440\u043e\u0433\u0438\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f\u043c.
    \u041c\u044b\u0441\u043b\u044c \u0442\u043e\u0447\u043d\u0435\u0435 \u0433\u043b\u0430\u0437\u0430\u00bb.\n\n\U0001F494
    6. \u0421\u043e\u0436\u0436\u0435\u043d\u043d\u0430\u044f \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430
    (\u041f\u043e\u0441\u0442\u0443\u043f\u043e\u043a, \u0445\u0440\u0430\u043d\u044f\u0449\u0438\u0439
    \u0442\u0430\u0439\u043d\u0443) \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044f \u043e \u0441\u043a\u043e\u0440\u043e\u043f\u043e\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0421\u043e\u0444\u044c\u0438 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0432 1891 \u0433\u043e\u0434\u0443 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0438 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u043a.
    \u041a\u0443\u0440\u044c\u0435\u0437 (\u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0439):
    \u041e\u043d \u0441\u043e\u0431\u0440\u0430\u043b \u0432\u0441\u0435 \u043f\u0438\u0441\u044c\u043c\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043a\u043e\u0433\u0434\u0430-\u043b\u0438\u0431\u043e \u043f\u0438\u0441\u0430\u043b\u0430
    \u0435\u043c\u0443 (\u0430 \u0438\u0445 \u0431\u044b\u043b\u0438 \u0441\u043e\u0442\u043d\u0438,
    \u043f\u043e\u043b\u043d\u044b\u0435 \u043b\u0438\u0447\u043d\u044b\u0445 \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0439),
    \u0438 \u0441\u0436\u0435\u0433 \u0438\u0445 \u0434\u043e\u0442\u043b\u0430 \u0432 \u043a\u0430\u043c\u0438\u043d\u0435.
    \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u043e\u043d \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b \u0432\u0441\u0435 \u0441\u0432\u043e\u0438
    \u043f\u0438\u0441\u044c\u043c\u0430, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435
    \u0435\u0439 (\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0442\u043e\u043c
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0439\u0434\u0435\u043d\u044b \u0432 \u0435\u0435
    \u0430\u0440\u0445\u0438\u0432\u0430\u0445). \u0417\u0430\u0447\u0435\u043c \u043e\u043d
    \u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b? \u0411\u0438\u043e\u0433\u0440\u0430\u0444\u044b
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442, \u0447\u0442\u043e
    \u043e\u043d \u0445\u043e\u0442\u0435\u043b \u0443\u043d\u0435\u0441\u0442\u0438 \u0442\u0430\u0439\u043d\u0443
    \u0438\u0445 \u0438\u0441\u0442\u0438\u043d\u043d\u044b\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439
    \u0432 \u043c\u043e\u0433\u0438\u043b\u0443, \u0447\u0442\u043e\u0431\u044b \u043d\u0438\u043a\u0442\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b \u0435\u0451 \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u0439.
    \u042d\u0442\u043e\u0442 \u0436\u0435\u0441\u0442 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u043f\u043e\u0440\u044b: \u0431\u044b\u043b\u0430
    \u043b\u0438 \u044d\u0442\u043e \u043b\u044e\u0431\u043e\u0432\u044c, \u043e\u0442\u0446\u043e\u0432\u0441\u043a\u0430\u044f
    \u0437\u0430\u0431\u043e\u0442\u0430 \u0438\u043b\u0438 \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0435\u0434
    \u043e\u0433\u043b\u0430\u0441\u043a\u043e\u0439?\n\n\U0001F3C6 7. \u041e\u0442\u043a\u0430\u0437
    \u043e\u0442 \u0437\u043e\u043b\u043e\u0442\u0430 (\u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c)
    \u0412 1885 \u0433\u043e\u0434\u0443, \u0432 \u0447\u0435\u0441\u0442\u044c 70-\u043b\u0435\u0442\u0438\u044f,
    \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0445\u043e\u0442\u0435\u043b\u043e \u043e\u0442\u0447\u0435\u043a\u0430\u043d\u0438\u0442\u044c
    \u0432 \u0447\u0435\u0441\u0442\u044c \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0437\u043e\u043b\u043e\u0442\u0443\u044e \u043f\u0430\u043c\u044f\u0442\u043d\u0443\u044e
    \u043c\u0435\u0434\u0430\u043b\u044c. \u041a\u0443\u0440\u044c\u0435\u0437: \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043d\u0430\u043e\u0442\u0440\u0435\u0437 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f!
    \u041e\u043d \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u043d\u0435 \u0445\u043e\u0447\u0435\u0442,
    \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u0447\u0435\u043a\u0430\u043d\u0438\u043b\u0438 \u043d\u0430 \u0434\u0435\u043d\u044c\u0433\u0430\u0445.
    \u0412\u043c\u0435\u0441\u0442\u043e \u043c\u0435\u0434\u0430\u043b\u0438 \u043e\u043d \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b...
    \u0447\u0442\u043e\u0431\u044b \u0435\u043c\u0443 \u043f\u043e\u0434\u0430\u0440\u0438\u043b\u0438
    \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u043c\u0435\u0434\u043d\u044b\u0439 \u0433\u043b\u043e\u0431\u0443\u0441
    \u0437\u0432\u0435\u0437\u0434\u043d\u043e\u0433\u043e \u043d\u0435\u0431\u0430, \u0447\u0442\u043e\u0431\u044b
    \u043e\u043d \u043c\u043e\u0433 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0430
    \u0441\u043e\u0437\u0432\u0435\u0437\u0434\u0438\u044f, \u043b\u0435\u0436\u0430 \u0432
    \u043f\u043e\u0441\u0442\u0435\u043b\u0438. \u041f\u043e\u0434\u0430\u0440\u043e\u043a \u0431\u044b\u043b
    \u0441\u0434\u0435\u043b\u0430\u043d, \u0438 \u044d\u0442\u043e\u0442 \u0433\u043b\u043e\u0431\u0443\u0441
    \u0441\u0442\u043e\u044f\u043b \u0443 \u0435\u0433\u043e \u043a\u0440\u043e\u0432\u0430\u0442\u0438
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438.\n\n\U0001F4D6
    8. \u0427\u0442\u0435\u043d\u0438\u0435 \u043b\u0435\u043a\u0446\u0438\u0439 \u043d\u0435\u0431\u0443
    \u0411\u0443\u0434\u0443\u0447\u0438 \u0443\u0436\u0435 \u043f\u0440\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u043c
    \u043a \u043f\u043e\u0441\u0442\u0435\u043b\u0438 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b (1894\u20131897), \u043e\u043d \u043d\u0435 \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u043b
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c. \u0414\u0435\u0442\u0430\u043b\u044c:
    \u041e\u043d \u0447\u0438\u0442\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438 \u0443
    \u0441\u0435\u0431\u044f \u0434\u043e\u043c\u0430. \u0423\u0447\u0435\u043d\u0438\u043a\u0438
    (\u0447\u0435\u043b\u043e\u0432\u0435\u043a 10\u201315) \u0441\u0438\u0434\u0435\u043b\u0438
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0435\u0433\u043e \u043a\u0440\u043e\u0432\u0430\u0442\u0438
    \u0441 \u0431\u043b\u043e\u043a\u043d\u043e\u0442\u0430\u043c\u0438, \u0430 \u043e\u043d,
    \u043b\u0435\u0436\u0430 \u043d\u0430 \u043f\u043e\u0434\u0443\u0448\u043a\u0430\u0445 \u0438
    \u0433\u043b\u044f\u0434\u044f \u0432 \u043f\u043e\u0442\u043e\u043b\u043e\u043a, \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b
    \u0438\u043c \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0442\u0435\u043e\u0440\u0435\u043c\u044b.
    \u0415\u0441\u043b\u0438 \u043e\u043d \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f
    \u0438 \u0432\u044b\u0432\u043e\u0434\u0438\u043b \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443, \u043e\u043d \u0432\u043e\u0434\u0438\u043b
    \u043f\u0430\u043b\u044c\u0446\u0435\u043c \u043f\u043e \u0432\u043e\u0437\u0434\u0443\u0445\u0443
    \u043d\u0430\u0434 \u0441\u043e\u0431\u043e\u0439, \u0441\u043b\u043e\u0432\u043d\u043e
    \u043f\u0438\u0441\u0430\u044f \u043d\u0430 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043e\u0439
    \u0434\u043e\u0441\u043a\u0435. \u0423\u0447\u0435\u043d\u0438\u043a\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u044d\u0442\u043e \u00ab\u043c\u0435\u043b\u043e\u0432\u043e\u0439 \u043f\u0430\u043b\u044c\u0446\u0435\u043c\u00bb,
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0441\u0431\u0438\u0432\u0430\u043b\u0441\u044f
    \u0438 \u043d\u0435 \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f \u0432 \u0434\u043b\u0438\u043d\u043d\u044b\u0445
    \u0432\u044b\u043a\u043b\u0430\u0434\u043a\u0430\u0445.\n\n\U0001F37A 9. \u041f\u0440\u043e\u043a\u043b\u044f\u0442\u0430\u044f
    \u00ab\u0411\u0443\u0442\u044b\u043b\u043a\u0430 \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u0430\u00bb
    \u0423 \u043d\u0435\u0433\u043e \u0431\u044b\u043b \u0434\u0430\u0432\u043d\u0438\u0439
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439
    \u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434\u043e\u043c \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e\u0448\u0435\u043b \u0434\u043e \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043e\u043d\u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0438
    \u043a\u043b\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0435
    \u0432 \u043a\u043e\u0440\u0438\u0434\u043e\u0440\u0430\u0445 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u041a\u0443\u0440\u044c\u0435\u0437: \u0420\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442,
    \u0447\u0442\u043e \u043a\u0430\u043a-\u0442\u043e \u043d\u0430 \u0431\u0430\u043d\u043a\u0435\u0442\u0435
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043f\u043e\u0434\u043e\u0437\u0432\u0430\u043b
    \u043e\u0444\u0438\u0446\u0438\u0430\u043d\u0442\u0430 \u0438 \u0433\u0440\u043e\u043c\u043a\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0441\u043b\u044b\u0448\u0430\u043b \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440,
    \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u041f\u0440\u0438\u043d\u0435\u0441\u0438\u0442\u0435
    \u043c\u043d\u0435 \u0431\u0443\u0442\u044b\u043b\u043a\u0443 \u0432\u0438\u043d\u0430,
    \u0442\u043e\u043b\u044c\u043a\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430,
    \u0431\u0435\u0437 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0432 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u043c\u0438\u043b\u043b\u0438\u043b\u0438\u0442\u0440\u043e\u0432\u00bb. (\u041d\u0430\u043c\u0435\u043a
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440
    \u043e\u0442\u0440\u0438\u0446\u0430\u043b \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430). \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440 \u0432
    \u043e\u0442\u0432\u0435\u0442 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u043e
    \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0437\u0430\u043b. \u042d\u0442\u043e \u0431\u044b\u043b
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0440\u0435\u0434\u043a\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u0435\u0432,
    \u043a\u043e\u0433\u0434\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u0441\u0435\u0431\u0435 \u044f\u0437\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u0443\u044e \u043a\u043e\u043b\u043a\u043e\u0441\u0442\u044c."
