  achievementsRu: "\u0412\u043A\u043B\u0430\u0434 \u041A\u0430\u0440\u043B\u0430
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u0432
    \u043D\u0430\u0443\u043A\u0443 \u2014 \u044D\u0442\u043E, \u043F\u043E \u0441\u0443\u0442\u0438,
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0430 \u0432\u0441\u0435\u0433\u043E
    \u0437\u0434\u0430\u043D\u0438\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u043D\u0430 \u043D\u043E\u0432\u043E\u043C,
    \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u0441\u0442\u0440\u043E\u0433\u043E\u043C
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0435. \u0415\u0433\u043E
    \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438 \xAB\u043E\u0442\u0446\u043E\u043C
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u0430\u043D\u0430\u043B\u0438\u0437\u0430\xBB
    \u0438\u043C\u0435\u043D\u043D\u043E \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E
    \u043E\u043D \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B \u044D\u0442\u0443
    \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0438\u0437 \u043D\u0430\u0431\u043E\u0440\u0430
    \u0438\u043D\u0442\u0443\u0438\u0442\u0438\u0432\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0445,
    \u043D\u043E \u043F\u043E\u0440\u043E\u0439 \u0448\u0430\u0442\u043A\u0438\u0445
    \u0438\u0441\u0442\u0438\u043D \u0432 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u0443\u044E
    \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E. 
    ### \U0001F3DB\uFE0F \u0410\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044F
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430: \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \"\u0430\u043B\u0433\u0435\u0431\u0440\u044B \u0438\u0441\u0442\u0438\u043D\u044B\" 
    \u0413\u043B\u0430\u0432\u043D\u043E\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u0431\u044B\u043B\u043E
    \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043D\u0430\u043B\u0438\u0437 \u043E\u0442 \u043D\u0435\u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u0435\u0439
    \u0438 \u0430\u043F\u0435\u043B\u043B\u044F\u0446\u0438\u0439 \u043A \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435,
    \u043F\u043E \u0435\u0433\u043E \u043C\u043D\u0435\u043D\u0438\u044E, \u043C\u043E\u0433\u043B\u0438
    \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043A \u043E\u0448\u0438\u0431\u043A\u0430\u043C. 
    *   **\u0422\u0435\u043E\u0440\u0438\u044F \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B**: \u0414\u043E \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0434\u0430\u0436\u0435 \u0443 \u041A\u043E\u0448\u0438 \u043D\u0435 \u0431\u044B\u043B\u043E
    \u0441\u0442\u0440\u043E\u0433\u043E\u0439 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0447\u0438\u0441\u0435\u043B.
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B
    \u0435\u0451, \u0437\u0430\u043B\u043E\u0436\u0438\u0432 \u043F\u0440\u043E\u0447\u043D\u044B\u0439
    \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442
    \u0434\u043B\u044F \u0432\u0441\u0435\u0433\u043E \u0430\u043D\u0430\u043B\u0438\u0437\u0430.
    *   **\u03B5-\u03B4-\u044F\u0437\u044B\u043A**: \u041E\u043D \u0444\u043E\u0440\u043C\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043B
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u043F\u0440\u0435\u0434\u0435\u043B\u0430,
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0441\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u043D\u0430
    \u044F\u0437\u044B\u043A\u0435 \xAB\u044D\u043F\u0441\u0438\u043B\u043E\u043D-\u0434\u0435\u043B\u044C\u0442\u0430\xBB
    (\u03B5-\u03B4). \u0418\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0441\u0442\u0438,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0437\u0432\u0443\u0447\u0438\u0442
    \u043A\u0430\u043A: \u0444\u0443\u043D\u043A\u0446\u0438\u044F `f(x)` \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u0430
    \u0432 \u0442\u043E\u0447\u043A\u0435 `x0`, \u0435\u0441\u043B\u0438 \u0434\u043B\u044F
    \u043B\u044E\u0431\u043E\u0433\u043E `\u03B5>0` \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F
    \u0442\u0430\u043A\u043E\u0435 `\u03B4>0`, \u0447\u0442\u043E \u0438\u0437 `|x-x0|
    < \u03B4` \u0441\u043B\u0435\u0434\u0443\u0435\u0442 `|f(x)-f(x0)| < \u03B5`,
    \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0441\u044F
    \u0432 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0430\u0445
    \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439. *  
    **\u041F\u043E\u043D\u044F\u0442\u0438\u044F \u0432\u0435\u0440\u0445\u043D\u0435\u0439
    \u0438 \u043D\u0438\u0436\u043D\u0435\u0439 \u0433\u0440\u0430\u043D\u0438**:
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0432\u0432\u0435\u043B \u0432 \u043E\u0431\u0438\u0445\u043E\u0434 \u044D\u0442\u0438
    \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u0435 \u043F\u043E\u043D\u044F\u0442\u0438\u044F
    \u0442\u0435\u043E\u0440\u0438\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432
    \u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430. *   **\u0421\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u044C
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u0438**:
    \u0415\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u043E
    \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0441\u044F \u043E\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u0430
    \u0435\u0433\u043E \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u0430
    \u0420\u0438\u043C\u0430\u043D\u0430. \u0415\u0441\u043B\u0438 \u0420\u0438\u043C\u0430\u043D
    \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u043B \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043C\u0435\u0442\u043E\u0434\u044B, \u0442\u043E \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043B \u043D\u0430 \u0441\u0442\u0440\u043E\u0433\u043E
    \xAB\u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C\xBB
    \u043E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438, \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u043E\u043C
    \u043D\u0430 \u0441\u0442\u0435\u043F\u0435\u043D\u043D\u044B\u0445 \u0440\u044F\u0434\u0430\u0445,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u043B
    \xAB\u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0438\u0441\u0442\u0438\u043D\u0430\u043C\u0438\xBB.  ### \U0001F300 \u0422\u0435\u043E\u0440\u0438\u044F
    \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439 \u0438 \u0441\u0442\u0435\u043F\u0435\u043D\u043D\u044B\u0435
    \u0440\u044F\u0434\u044B  \u0412 \u043E\u0441\u043D\u043E\u0432\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0430
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u043A
    \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u043C \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043D\u043E\u0433\u043E
    \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u043B\u0435\u0436\u0430\u043B
    \u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\u0439 \u0440\u044F\u0434.  *  
    **\u0410\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435**: \u041E\u043D
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0442\u0435\u043E\u0440\u0438\u044E,
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0443\u044E \xAB\u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C\xBB
    \u0444\u0443\u043D\u043A\u0446\u0438\u044E, \u0437\u0430\u0434\u0430\u043D\u043D\u0443\u044E
    \u0441\u0442\u0435\u043F\u0435\u043D\u043D\u044B\u043C \u0440\u044F\u0434\u043E\u043C
    \u0432 \u043E\u0434\u043D\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438,
    \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u0448\u0438\u0440\u043E\u043A\u0443\u044E
    \u043E\u0431\u043B\u0430\u0441\u0442\u044C. *   **\u0422\u0435\u043E\u0440\u0435\u043C\u0430
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430**: \u0414\u043E\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0441\u0443\u043C\u043C\u0430 \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E
    \u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E\u0441\u044F \u0440\u044F\u0434\u0430
    \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439 \u0441\u0430\u043C\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0444\u0443\u043D\u043A\u0446\u0438\u0435\u0439. *   **\u0418\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u043E\u0441\u043E\u0431\u044B\u0435 \u0442\u043E\u0447\u043A\u0438**: \u041F\u043E\u0434\u0440\u043E\u0431\u043D\u043E
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0444\u0443\u043D\u043A\u0446\u0438\u0438 \u0432 \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438
    \u0438\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u043E\u0441\u043E\u0431\u043E\u0439 \u0442\u043E\u0447\u043A\u0438. *   **\u0422\u0435\u043E\u0440\u0438\u044F
    \u0446\u0435\u043B\u044B\u0445 \u0444\u0443\u043D\u043A\u0446\u0438\u0439**:
    \u0417\u0430\u043B\u043E\u0436\u0438\u043B \u043E\u0441\u043D\u043E\u0432\u044B
    \u0438\u0445 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0432 \u0432\u0438\u0434\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0445
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0439.  ###
    \U0001F4CA \"\u041A\u043E\u043D\u0442\u0440\u043F\u0440\u0438\u043C\u0435\u0440\u044B\"
    \u0438 \u0442\u0435\u043E\u0440\u0438\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u0439 
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0441\u044F
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435\u043C \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u043E\u043D\u0442\u0440\u043F\u0440\u0438\u043C\u0435\u0440\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0430\u0433\u043B\u044F\u0434\u043D\u043E
    \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438, \u0441\u043A\u043E\u043B\u044C
    \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u043E\u0439 \u043C\u043E\u0436\u0435\u0442
    \u0431\u044B\u0442\u044C \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044F.  *   **\u0412\u0441\u044E\u0434\u0443
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u0430\u044F, \u043D\u043E
    \u043D\u0438\u0433\u0434\u0435 \u043D\u0435 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0440\u0443\u0435\u043C\u0430\u044F
    \u0444\u0443\u043D\u043A\u0446\u0438\u044F**: \u0412 1861 \u0433\u043E\u0434\u0443
    \u043E\u043D \u0441\u043E\u0437\u0434\u0430\u043B \u043F\u0440\u0438\u043C\u0435\u0440
    \u0444\u0443\u043D\u043A\u0446\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u0430 \u0432 \u043A\u0430\u0436\u0434\u043E\u0439
    \u0442\u043E\u0447\u043A\u0435, \u043D\u043E \u043D\u0435 \u0438\u043C\u0435\u0435\u0442
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u043D\u043E\u0439 \u043D\u0438
    \u0432 \u043E\u0434\u043D\u043E\u0439. \u042D\u0442\u043E \u0441\u0442\u0430\u043B\u043E
    \u0441\u0435\u043D\u0441\u0430\u0446\u0438\u0435\u0439 \u0438 \u043F\u0440\u043E\u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043B\u043E
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C
    \u0441\u0442\u0440\u043E\u0433\u043E\u0433\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u043D\u043E\u0439 \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0441\u0442\u0438.
    *   **\u0422\u0435\u043E\u0440\u0435\u043C\u0430 \u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438**:
    \u0414\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043B\u044E\u0431\u0443\u044E
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u0443\u044E \u043D\u0430
    \u043E\u0442\u0440\u0435\u0437\u043A\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u044E
    \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u043E\u043B\u044C \u0443\u0433\u043E\u0434\u043D\u043E
    \u0442\u043E\u0447\u043D\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C
    \u043C\u043D\u043E\u0433\u043E\u0447\u043B\u0435\u043D\u0430\u043C\u0438 (\u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E
    \u0441\u0445\u043E\u0434\u044F\u0449\u0438\u043C\u0441\u044F \u0440\u044F\u0434\u043E\u043C). 
    ### \U0001F52C \u042D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0438 \u0430\u0431\u0435\u043B\u0435\u0432\u044B \u0444\u0443\u043D\u043A\u0446\u0438\u0438 
    \u0418\u043C\u0435\u043D\u043D\u043E \u0440\u0430\u043D\u043D\u0438\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u043F\u043E
    \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0438 \u0430\u0431\u0435\u043B\u0435\u0432\u044B\u043C \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u043C
    \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438 \u0435\u043C\u0443 \u043C\u0438\u0440\u043E\u0432\u0443\u044E
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C.  *   **\u041F\u0440\u043E\u0440\u044B\u0432\u043D\u0430\u044F
    \u0441\u0442\u0430\u0442\u044C\u044F 1854 \u0433\u043E\u0434\u0430**: \u041D\u0430\u0445\u043E\u0434\u044F\u0441\u044C
    \u0432 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0443\u0447\u0438\u0442\u0435\u043B\u044F, \u043E\u043D \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B
    \u0440\u0430\u0431\u043E\u0442\u0443 \u043F\u043E \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044E
    \u0433\u0438\u043F\u0435\u0440\u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u043E\u0432, \u0440\u0435\u0448\u0438\u0432
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443 \u042F\u043A\u043E\u0431\u0438.
    \u042D\u0442\u0430 \u0441\u0442\u0430\u0442\u044C\u044F \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E
    \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u0435\u0433\u043E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u043C.
    *   **\u041D\u043E\u0432\u0430\u044F \u0442\u0435\u043E\u0440\u0438\u044F \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439**: \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043E\u0437\u0434\u0430\u043B \u0441\u0442\u0440\u043E\u0439\u043D\u0443\u044E
    \u0438 \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u0443\u044E
    \u0442\u0435\u043E\u0440\u0438\u044E, \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u0443\u044E
    \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u0441\u0438\u0433\u043C\u0430-\u0444\u0443\u043D\u043A\u0446\u0438\u0438
    `\u03C3(u)` \u2014 \u0446\u0435\u043B\u043E\u0439 \u0444\u0443\u043D\u043A\u0446\u0438\u0438,
    \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0449\u0435\u0439 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438
    \u043A\u0432\u0430\u0437\u0438\u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u043D\u043E\u0441\u0442\u0438
    \u0438 \u044F\u0432\u043B\u044F\u044E\u0449\u0435\u0439\u0441\u044F \u043E\u0441\u043D\u043E\u0432\u043E\u0439
    \u0434\u043B\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F
    \u0432\u0441\u0435\u0445 \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439.  ### \U0001F4D0 \u0414\u0440\u0443\u0433\u0438\u0435
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 
    \u0412\u043A\u043B\u0430\u0434 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0432\u0430\u0436\u043D\u044B\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u044B. 
    *   **\u0412\u0430\u0440\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0435
    \u0438\u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0435**: \u041E\u043D
    \u043F\u0440\u0438\u0434\u0430\u043B \u044D\u0442\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0432\u0438\u0434,
    \u0432\u0432\u0435\u0434\u044F \u0441\u0442\u0440\u043E\u0433\u0438\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
    \u0434\u043B\u044F \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0443\u043C\u0430
    \u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0432 \u0442\u0430\u043A
    \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u044B\u0435 \xAB\u0440\u0430\u0437\u0440\u044B\u0432\u043D\u044B\u0435\xBB
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F. *   **\u041B\u0438\u043D\u0435\u0439\u043D\u0430\u044F
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430**: \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0442\u0435\u043E\u0440\u0438\u044E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u044B\u0445
    \u0434\u0435\u043B\u0438\u0442\u0435\u043B\u0435\u0439 \u043C\u0430\u0442\u0440\u0438\u0446.
    *   **\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F**: \u0418\u0437\u0443\u0447\u0430\u043B
    \u0433\u0435\u043E\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043B\u0438\u043D\u0438\u0438 \u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 (\u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438). 
    ### \U0001F4DA \u041D\u0430\u0441\u043B\u0435\u0434\u0438\u0435 \u0438 \u0442\u0440\u0443\u0434\u044B 
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0431\u044B\u043B
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u043C
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C,
    \u043D\u043E \u0438 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u043C
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C.
    \u0415\u0433\u043E \u043B\u0435\u043A\u0446\u0438\u0438 \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0435,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043D \u0447\u0438\u0442\u0430\u043B
    40 \u043B\u0435\u0442, \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u043B\u0438
    \u043B\u0443\u0447\u0448\u0438\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432
    \u0441\u043E \u0432\u0441\u0435\u0439 \u0415\u0432\u0440\u043E\u043F\u044B, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0413. \u041A\u0430\u043D\u0442\u043E\u0440\u0430, \u041A. \u0420\u0443\u043D\u0433\u0435,
    \u0424. \u0424\u0440\u043E\u0431\u0435\u043D\u0438\u0443\u0441\u0430, \u041C.
    \u041C\u0438\u0442\u0442\u0430\u0433-\u041B\u0435\u0444\u0444\u043B\u0435\u0440\u0430
    \u0438, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0421\u043E\u0444\u044C\u044E
    \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u0443\u044E.  \u0418\u0440\u043E\u043D\u0438\u0447\u043D\u043E,
    \u043D\u043E \u0441\u0430\u043C \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0437\u0430\u0431\u043E\u0442\u0438\u043B\u0441\u044F
    \u043E \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0438 \u0441\u0432\u043E\u0438\u0445
    \u043B\u0435\u043A\u0446\u0438\u0439 \u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432,
    \u0441\u0447\u0438\u0442\u0430\u044F \u0432\u0430\u0436\u043D\u0435\u0435 \u0436\u0438\u0432\u043E\u0435
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u0435. \u0418\u043C\u0435\u043D\u043D\u043E
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438\u0437\u0434\u0430\u043D\u0438\u0435
    \u0435\u0433\u043E **\u0421\u043E\u0431\u0440\u0430\u043D\u0438\u044F \u0441\u043E\u0447\u0438\u043D\u0435\u043D\u0438\u0439**
    (\xABMathematische Werke\xBB) \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C
    \u0435\u0449\u0435 \u043F\u0440\u0438 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438
    \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B\u043E\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432 1927 \u0433\u043E\u0434\u0443, \u043E\u0445\u0432\u0430\u0442\u0438\u0432
    7 \u0442\u043E\u043C\u043E\u0432.  \u0415\u0433\u043E \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435
    \u043A \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0439 \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u0438 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E \u043B\u0438\u0446\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.
    \u041E\u043D \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B \u0430\u043D\u0430\u043B\u0438\u0437
    \u0438\u0437 \u043D\u0430\u0443\u043A\u0438, \u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0449\u0435\u0439\u0441\u044F
    \u043D\u0430 \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044E, \u0432 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0443,
    \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0448\u0430\u0433 \u0434\u043E\u043A\u0430\u0437\u0430\u043D
    \u0441 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u044F\u0441\u043D\u043E\u0441\u0442\u044C\u044E."
  achievementsEn: 
  personalLifeRu: "\u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C
    \u041A\u0430\u0440\u043B\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u2014 \u044D\u0442\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u043E\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u0438\u043D\u0435\u0441 \u0441\u0435\u0431\u044F \u0432 \u0436\u0435\u0440\u0442\u0432\u0443
    \u043D\u0430\u0443\u043A\u0435. \u0415\u0433\u043E \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F
    \u043F\u043E\u043B\u043D\u0430 \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043E\u0432: \u043E\u0442 \u0431\u043B\u0438\u0441\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u0430-\u0434\u0443\u044D\u043B\u044F\u043D\u0442\u0430
    \u0434\u043E \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u0438\u043A\u0430-\u0443\u0447\u0438\u0442\u0435\u043B\u044F,
    \u043E\u0442 \u0432\u0441\u0435\u043E\u0431\u0449\u0435\u0433\u043E \u0437\u0430\u0431\u0432\u0435\u043D\u0438\u044F
    \u0434\u043E \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \xAB\u043D\u0435\u043A\u043E\u0440\u043E\u043D\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u043B\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438\xBB.
    \u041E\u043D \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B
    \u0436\u0435\u043D\u0430\u0442, \u043D\u043E \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u044C
    \u0431\u044B\u043B\u0430 \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430
    \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u0438 \u0442\u044F\u0436\u0435\u043B\u044B\u043C\u0438 \u0443\u0442\u0440\u0430\u0442\u0430\u043C\u0438. 
    ### \U0001F476 \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u041A\u0430\u0440\u043B \u0422\u0435\u043E\u0434\u043E\u0440 \u0412\u0438\u043B\u044C\u0433\u0435\u043B\u044C\u043C
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    **31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F 1815 \u0433\u043E\u0434\u0430**
    \u0432 \u043C\u0435\u0441\u0442\u0435\u0447\u043A\u0435 \u041E\u0441\u0442\u0435\u043D\u0444\u0435\u043B\u044C\u0434\u0435
    (\u043D\u044B\u043D\u0435 \u0447\u0430\u0441\u0442\u044C \u0433\u043E\u0440\u043E\u0434\u0430
    \u042D\u043D\u043D\u0438\u0433\u0435\u0440\u043B\u043E, \u0412\u0435\u0441\u0442\u0444\u0430\u043B\u0438\u044F).
    \u041E\u043D \u0431\u044B\u043B **\u0441\u0442\u0430\u0440\u0448\u0438\u043C
    \u0441\u044B\u043D\u043E\u043C** \u0432 \u0441\u0435\u043C\u044C\u0435.  \u0415\u0433\u043E
    \u043E\u0442\u0435\u0446, **\u0412\u0438\u043B\u044C\u0433\u0435\u043B\u044C\u043C
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441**, \u0431\u044B\u043B
    \u0432\u044B\u0445\u043E\u0434\u0446\u0435\u043C \u0438\u0437 \u0441\u0435\u043C\u044C\u0438
    \u043C\u044D\u0440\u0430, \u0441\u043B\u0443\u0436\u0438\u043B \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u0435\u043C
    \u0443 \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0433\u0440\u0430\u0444\u0430,
    \u0430 \u043F\u043E\u0437\u0436\u0435 \u2014 \u0433\u043B\u0430\u0432\u043D\u044B\u043C
    \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u043C \u0438\u043D\u0441\u043F\u0435\u043A\u0442\u043E\u0440\u043E\u043C.
    \u042D\u0442\u043E \u0431\u044B\u043B \u0432\u043E\u043B\u0435\u0432\u043E\u0439,
    \u0430\u043C\u0431\u0438\u0446\u0438\u043E\u0437\u043D\u044B\u0439, \u043D\u043E
    \u043A\u0440\u0430\u0439\u043D\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u044B\u0439
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043B \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0439
    \u0441\u044B\u043D\u0430 \u0430\u0431\u0441\u0442\u0440\u0430\u043A\u0442\u043D\u043E\u0439
    \u043D\u0430\u0443\u043A\u043E\u0439. \u041C\u0430\u0442\u044C, **\u0422\u0435\u043E\u0434\u043E\u0440\u0430
    \u0424\u0451\u0440\u0441\u0442\u0435\u0440**, \u0431\u044B\u043B\u0430 \u0434\u043E\u0447\u0435\u0440\u044C\u044E
    \u0431\u0443\u0440\u0433\u043E\u043C\u0438\u0441\u0442\u0440\u0430. \u041E\u043D\u0430
    \u0443\u043C\u0435\u0440\u043B\u0430, \u043A\u043E\u0433\u0434\u0430 \u041A\u0430\u0440\u043B\u0443
    \u0431\u044B\u043B\u043E \u0432\u0441\u0435\u0433\u043E **12 \u043B\u0435\u0442**
    (\u0432 1827 \u0433\u043E\u0434\u0443), \u0447\u0442\u043E \u0441\u0442\u0430\u043B\u043E
    \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0442\u044F\u0436\u0435\u043B\u0435\u0439\u0448\u0438\u043C
    \u0443\u0434\u0430\u0440\u043E\u043C.  \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
    \u0447\u0442\u043E \u0443 \u041A\u0430\u0440\u043B\u0430 \u0431\u044B\u043B\u0438
    \u043C\u043B\u0430\u0434\u0448\u0438\u0435 \u0431\u0440\u0430\u0442\u044C\u044F.
    \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445, **\u041F\u0435\u0442\u0435\u0440
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441**, \u0441\u0442\u0430\u043B
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C-\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u0435\u043C,
    \u0430 \u0434\u0440\u0443\u0433\u043E\u0439, **\u042E\u043B\u0438\u0443\u0441**,
    \u044D\u043C\u0438\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043B \u0432 \u0410\u043C\u0435\u0440\u0438\u043A\u0443.
    \u0421\u0435\u043C\u044C\u044F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
    \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043B\u0430 \u0432\u0441\u043B\u0435\u0434
    \u0437\u0430 \u043E\u0442\u0446\u043E\u043C, \u0447\u0442\u043E \u043C\u0435\u0448\u0430\u043B\u043E
    \u041A\u0430\u0440\u043B\u0443 \u0437\u0430\u0432\u043E\u0434\u0438\u0442\u044C
    \u0434\u043E\u043B\u0433\u0438\u0435 \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u0438\u0435
    \u0441\u0432\u044F\u0437\u0438 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435. 
    ---  ### \U0001F393 \u0423\u0447\u0451\u0431\u0430 \u0438 \u044E\u043D\u043E\u0448\u0435\u0441\u0442\u0432\u043E:
    \u043C\u044F\u0442\u0435\u0436 \u043F\u0440\u043E\u0442\u0438\u0432 \u043E\u0442\u0446\u0430 
    **1834\u20131838 \u0433\u0433. \u2014 \u0411\u043E\u043D\u043D\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 (\u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442).**  \u041F\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u0438\u044E
    \u043E\u0442\u0446\u0430, \u0436\u0435\u043B\u0430\u0432\u0448\u0435\u0433\u043E
    \u0432\u0438\u0434\u0435\u0442\u044C \u0441\u044B\u043D\u0430 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0441\u043B\u0443\u0436\u0430\u0449\u0438\u043C, \u041A\u0430\u0440\u043B \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 \u0411\u043E\u043D\u043D \u0438\u0437\u0443\u0447\u0430\u0442\u044C \u043F\u0440\u0430\u0432\u043E.
    \u041E\u0434\u043D\u0430\u043A\u043E \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043D\u0430\u0443\u043A\u0438 \u0432\u044B\u0437\u044B\u0432\u0430\u043B\u0438
    \u0443 \u043D\u0435\u0433\u043E \u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435.
    \u0412\u043C\u0435\u0441\u0442\u043E \u043B\u0435\u043A\u0446\u0438\u0439 \u043E\u043D
    \u0442\u0430\u0439\u043D\u043E \u043F\u043E\u0441\u0435\u0449\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u0440\u0443\u0436\u043A\u0438 \u0438 \u0448\u0442\u0443\u0434\u0438\u0440\u043E\u0432\u0430\u043B
    \u0442\u0440\u0443\u0434\u044B \u041B\u0430\u043F\u043B\u0430\u0441\u0430, \u041B\u0430\u0433\u0440\u0430\u043D\u0436\u0430
    \u0438 \u042F\u043A\u043E\u0431\u0438.  \u0412 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434
    \u043E\u043D \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0441\u044F
    \u043A\u0430\u043A \u0437\u0430\u044F\u0434\u043B\u044B\u0439 \u0444\u0435\u0445\u0442\u043E\u0432\u0430\u043B\u044C\u0449\u0438\u043A
    \u0438 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0445
    \u0434\u0443\u044D\u043B\u0435\u0439. \u0421\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C
    \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F, \u0447\u0442\u043E
    \u043E\u043D \u0431\u044B\u043B \u0438\u0441\u043A\u0443\u0441\u043D\u044B\u043C
    \u0431\u043E\u0439\u0446\u043E\u043C, \u0438 \u0445\u043E\u0442\u044F \u043D\u0430
    \u0435\u0433\u043E \u043B\u0438\u0446\u0435 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
    \u0448\u0440\u0430\u043C\u044B, \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435
    \u0431\u044B\u043B \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E \u0440\u0430\u043D\u0435\u043D.
    \u0427\u0435\u0442\u044B\u0440\u0435 \u0433\u043E\u0434\u0430 \u043E\u043D \u0432\u0435\u043B
    \u0440\u0430\u0437\u0433\u0443\u043B\u044C\u043D\u0443\u044E \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0443\u044E
    \u0436\u0438\u0437\u043D\u044C, \u043D\u0435 \u0441\u0434\u0430\u0432 \u043D\u0438
    \u043E\u0434\u043D\u043E\u0433\u043E \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430. \u0412 1838 \u0433\u043E\u0434\u0443,
    \u043F\u043E\u0437\u0430\u0434\u0438 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
    \u0438 \u043E\u0442\u0435\u0446, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043B\u0438\u0448\u0438\u043B
    \u0435\u0433\u043E \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0439
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438.   **1839 \u0433. \u2014
    \u041C\u044E\u043D\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u044F.** 
    \u041A\u0430\u0440\u043B \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432
    \u041C\u044E\u043D\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u044E
    \u043D\u0430 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.
    \u0417\u0434\u0435\u0441\u044C \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C
    \u0435\u0433\u043E \u0441\u0443\u0434\u044C\u0431\u043E\u043D\u043E\u0441\u043D\u0430\u044F
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    **\u041A\u0440\u0438\u0441\u0442\u043E\u0444\u043E\u043C \u0413\u0443\u0434\u0435\u0440\u043C\u0430\u043D\u043E\u043C**.
    \u0413\u0443\u0434\u0435\u0440\u043C\u0430\u043D, \u0437\u0430\u043C\u0435\u0442\u0438\u0432
    \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u044B\u0439 \u0442\u0430\u043B\u0430\u043D\u0442
    \u044E\u043D\u043E\u0448\u0438, \u0443\u0432\u043B\u0435\u043A \u0435\u0433\u043E
    \u0442\u0435\u043E\u0440\u0438\u0435\u0439 \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439 \u0438 \u043F\u043E \u0441\u0443\u0442\u0438
    \u0441\u0442\u0430\u043B \u0435\u0433\u043E \u0434\u0443\u0445\u043E\u0432\u043D\u044B\u043C
    \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u043C. \u0412 1840
    \u0433\u043E\u0434\u0443 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u0438\u043F\u043B\u043E\u043C
    \u0443\u0447\u0438\u0442\u0435\u043B\u044F.  ---  ### \U0001F9D1\u200D\U0001F3EB
    \u0420\u0430\u0431\u043E\u0442\u0430: 14 \u043B\u0435\u0442 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0441\u044B\u043B\u043A\u0438  \u0421 **1842 \u043F\u043E 1856 \u0433\u043E\u0434**
    \u0434\u043B\u0438\u0442\u0441\u044F \u0441\u0430\u043C\u044B\u0439 \u0442\u044F\u0436\u0435\u043B\u044B\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438
    \u2014 \xAB\u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0440\u0430\u0431\u0441\u0442\u0432\u043E\xBB.  *   **1842\u20131843:** \u041C\u044E\u043D\u0441\u0442\u0435\u0440,
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043A \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430\u043C.
    *   **1843\u20131848:** \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430
    \u0432 \u0448\u043A\u043E\u043B\u0435 \u0432 **\u0414\u043E\u0439\u0447-\u041A\u0440\u043E\u043D\u0435**
    (\u043D\u044B\u043D\u0435 \u0412\u0430\u043B\u0447, \u041F\u043E\u043B\u044C\u0448\u0430).
    \u041E\u043D \u0436\u0438\u043B \u0432 \u043A\u0440\u043E\u0448\u0435\u0447\u043D\u043E\u0439
    \u043A\u043E\u043C\u043D\u0430\u0442\u0435, \u0441\u043F\u0430\u043B \u043D\u0430
    \u0436\u0435\u0441\u0442\u043A\u043E\u0439 \u043A\u043E\u0439\u043A\u0435, \u0430
    \u0432\u0441\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0438 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0443 \u0442\u0440\u0430\u0442\u0438\u043B
    \u043D\u0430 \u043A\u043D\u0438\u0433\u0438 \u0438 \u0431\u0443\u043C\u0430\u0433\u0443.
    *   **1848\u20131856:** \u0411\u0440\u0430\u0443\u043D\u0441\u0431\u0435\u0440\u0433
    (\u043D\u044B\u043D\u0435 \u0411\u0440\u0430\u043D\u0435\u0432\u043E, \u041F\u043E\u043B\u044C\u0448\u0430),
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F \u0421\u0432\u044F\u0442\u043E\u0439
    \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u044B.  **\u0411\u044B\u0442
    \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F:** \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0438\u043C\u0435\u043B \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443 \u0434\u043E **30 \u0447\u0430\u0441\u043E\u0432
    \u0432 \u043D\u0435\u0434\u0435\u043B\u044E** (\u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0444\u0438\u0437\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0443 \u0438 \u0447\u0438\u0441\u0442\u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435).
    \u0415\u0433\u043E \u0433\u043E\u0434\u043E\u0432\u043E\u0439 \u043E\u043A\u043B\u0430\u0434
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B \u0436\u0430\u043B\u043A\u0438\u0435
    348 \u0442\u0430\u043B\u0435\u0440\u043E\u0432. \u0418\u0437-\u0437\u0430 \u0431\u0435\u0434\u043D\u043E\u0441\u0442\u0438
    \u043E\u043D \u043D\u0435 \u043C\u043E\u0433 \u043A\u0443\u043F\u0438\u0442\u044C
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043C\u0430\u0440\u043E\u043A,
    \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
    \u0441\u0432\u043E\u0438 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0438 \u0432
    \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0436\u0443\u0440\u043D\u0430\u043B\u044B,
    \u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0435\u0433\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F
    \u0442\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
    \u043D\u0435\u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438. 
    \u0418\u043C\u0435\u043D\u043D\u043E \u0437\u0434\u0435\u0441\u044C, \u0432 \u043F\u043E\u043B\u043D\u043E\u0439
    \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0438 \u043E\u0442 \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u0438\u0440\u0430, \u043F\u0440\u043E\u0432\u043E\u0434\u044F \u043D\u043E\u0447\u0438
    \u043F\u0440\u0438 \u0441\u0432\u0435\u0447\u0430\u0445, \u043E\u043D \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442 \u0441\u0432\u043E\u0435\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439. \u041E\u043D \u0441\u0430\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B,
    \u0447\u0442\u043E \u044D\u0442\u0438 \u0433\u043E\u0434\u044B \xAB\u0431\u044B\u043B\u0438
    \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430 \u0436\u0438\u0437\u043D\u044C
    \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u043C \u043C\u0435\u0448\u043A\u0435\xBB. 
    ---  ### \U0001F680 \u041D\u0430\u0443\u0447\u043D\u043E\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435
    \u0438 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0443\u0440\u0430  **1854 \u0433.
    \u2014 \u0422\u0440\u0438\u0443\u043C\u0444.** \u0412 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    39 \u043B\u0435\u0442 \u043E\u043D \u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0435\u0442
    \u0432 \xAB\u0416\u0443\u0440\u043D\u0430\u043B\u0435 \u041A\u0440\u0435\u043B\u043B\u0435\xBB
    \u0441\u0442\u0430\u0442\u044C\u044E \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438
    \u0430\u0431\u0435\u043B\u0435\u0432\u044B\u0445 \u0444\u0443\u043D\u043A\u0446\u0438\u0439,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
    \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u043C
    \u0432 \u0415\u0432\u0440\u043E\u043F\u0435. **\u041A\u0451\u043D\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442** \u0437\u0430\u043E\u0447\u043D\u043E
    \u043F\u0440\u0438\u0441\u0443\u0436\u0434\u0430\u0435\u0442 \u0435\u043C\u0443
    \u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u043E\u0447\u0435\u0442\u043D\u043E\u0433\u043E
    \u0434\u043E\u043A\u0442\u043E\u0440\u0430 \u043D\u0430\u0443\u043A (\u0431\u0435\u0437
    \u0437\u0430\u0449\u0438\u0442\u044B \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438). 
    **1856 \u0433. \u2014 \u041F\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u0411\u0435\u0440\u043B\u0438\u043D.**
    \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0445\u043E\u0434\u0430\u0442\u0430\u0439\u0441\u0442\u0432\u0443
    **\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430 \u0444\u043E\u043D
    \u0413\u0443\u043C\u0431\u043E\u043B\u044C\u0434\u0442\u0430**, \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043E
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430 \u0432 \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u043C
    \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u043C \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    (\u043F\u043E\u0437\u0436\u0435 \u2014 \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442). \u041E\u043D
    \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442
    \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u044E.  \u0421 1856 \u0433\u043E\u0434\u0430
    \u0438 \u0434\u043E \u0441\u0430\u043C\u043E\u0439 \u0441\u043C\u0435\u0440\u0442\u0438
    \u043E\u043D \u0436\u0438\u0432\u0435\u0442 \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0435,
    \u0437\u0430\u043D\u0438\u043C\u0430\u044F \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C
    \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u044D\u043A\u0441\u0442\u0440\u0430\u043E\u0440\u0434\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E,
    \u0430 \u0441 1864 \u0433\u043E\u0434\u0430 \u2014 **\u043E\u0440\u0434\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430** \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0415\u0433\u043E
    \u043B\u0435\u043A\u0446\u0438\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u043C\u0438 \u2014
    \u043E\u043D \u0447\u0438\u0442\u0430\u043B \u0438\u0445 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
    \u0432\u0434\u0443\u043C\u0447\u0438\u0432\u043E, \u0442\u0440\u0435\u0431\u0443\u044F
    \u043E\u0442 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u043D\u0435
    \u043A\u043E\u043D\u0441\u043F\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
    \u0430 *\u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C*.  ---  ### \u2764\uFE0F
    \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
    \u0443\u0447\u0435\u043D\u044B\u043C\u0438: \u0434\u0440\u0443\u0436\u0431\u0430
    \u0438 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E 
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0431\u044B\u043B
    \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u043C, \u043D\u043E \u043E\u0447\u0435\u043D\u044C
    \u0434\u043E\u0431\u0440\u044B\u043C \u0438 \u0432\u0435\u043B\u0438\u043A\u043E\u0434\u0443\u0448\u043D\u044B\u043C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0435\u0433\u043E \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u043D\u0435 \u0440\u0430\u0437 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u043B\u0430
    \u043A \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430\u043C.  **\u0421
    \u041B\u0435\u043E\u043F\u043E\u043B\u044C\u0434\u043E\u043C \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440\u043E\u043C
    (\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u043F\u0435\u0440\u0435\u0440\u043E\u0441\u043B\u0438
    \u0432\u043E \u0432\u0440\u0430\u0436\u0434\u0443).** \u042D\u0442\u043E \u0431\u044B\u043B
    \u0441\u0430\u043C\u044B\u0439 \u0442\u044F\u0436\u0435\u043B\u044B\u0439 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442
    \u0432 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438. \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440
    \u0431\u044B\u043B \u0435\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u0433\u043E\u0439
    \u043F\u043E \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u043E\u043C\u0443
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0443 \u0438
    \u044F\u0440\u044B\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C
    \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B \u0438 \u0442\u0435\u043E\u0440\u0438\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432
    \u0413\u0435\u043E\u0440\u0433\u0430 \u041A\u0430\u043D\u0442\u043E\u0440\u0430.
    \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E
    \u0442\u0440\u0430\u0432\u0438\u043B \u041A\u0430\u043D\u0442\u043E\u0440\u0430,
    \u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043A\u043E\u043C \u0441\u0442\u0440\u043E\u0433\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B, \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D\u043D\u043E
    \u0432\u0441\u0442\u0430\u043B \u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u0443
    \u041A\u0430\u043D\u0442\u043E\u0440\u0430. \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
    \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u043D\u0430\u043A\u0430\u043B\u0438\u043B\u0438\u0441\u044C
    \u0434\u043E \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u043E\u043D\u0438
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F,
    \u0445\u043E\u0442\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0432
    \u043E\u0434\u043D\u043E\u043C \u0437\u0434\u0430\u043D\u0438\u0438.  **\u0421
    \u0413\u0435\u043E\u0440\u0433\u043E\u043C \u041A\u0430\u043D\u0442\u043E\u0440\u043E\u043C
    (\u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u0434\u0440\u0443\u0436\u0431\u0430
    \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430).** \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u0445,
    \u043A\u0442\u043E \u0441\u0440\u0430\u0437\u0443 \u043F\u0440\u0438\u0437\u043D\u0430\u043B
    \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u041A\u0430\u043D\u0442\u043E\u0440\u0430.
    \u041E\u043D \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B
    \u0435\u0433\u043E \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E \u0438 \u043D\u0430\u0443\u0447\u043D\u043E,
    \u0437\u0430\u0449\u0438\u0449\u0430\u044F \u043E\u0442 \u043D\u0430\u043F\u0430\u0434\u043E\u043A
    \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440\u0430. \u0418\u043C\u0435\u043D\u043D\u043E
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043D\u0430\u0441\u0442\u043E\u044F\u043B
    \u043D\u0430 \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0438 \u043F\u0435\u0440\u0432\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B \u041A\u0430\u043D\u0442\u043E\u0440\u0430
    \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432.
    \u041E\u043D\u0438 \u0432\u0435\u043B\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u0443\u044E
    \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0443 \u0432\u043F\u043B\u043E\u0442\u044C
    \u0434\u043E \u0431\u043E\u043B\u0435\u0437\u043D\u0438 \u041A\u0430\u043D\u0442\u043E\u0440\u0430. 
    **\u0421 \u0411\u0435\u0440\u043D\u0445\u0430\u0440\u0434\u043E\u043C \u0420\u0438\u043C\u0430\u043D\u043E\u043C
    (\u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0435 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E).**
    \u0425\u043E\u0442\u044F \u043E\u043D\u0438 \u043D\u0435 \u0432\u0440\u0430\u0436\u0434\u043E\u0432\u0430\u043B\u0438
    \u043E\u0442\u043A\u0440\u044B\u0442\u043E, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0435 \u043C\u0435\u0442\u043E\u0434\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435.
    \u0420\u0438\u043C\u0430\u043D \u0431\u044B\u043B \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043A\u043E\u043C
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u0434\u0445\u043E\u0434\u0430 \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u0438, \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F
    \u043A\u0430\u043A \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0431\u044B\u043B \"\u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0437\u0430\u0442\u043E\u0440\u043E\u043C\",
    \u0442\u0440\u0435\u0431\u0443\u044E\u0449\u0438\u043C \u0447\u0438\u0441\u0442\u043E\u0433\u043E
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430. \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043A\u0440\u0438\u0442\u0438\u043A\u043E\u0432\u0430\u043B \u043C\u0435\u0442\u043E\u0434
    \u0414\u0438\u0440\u0438\u0445\u043B\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0420\u0438\u043C\u0430\u043D \u0448\u0438\u0440\u043E\u043A\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B. 
    **\u0421 \u0421\u043E\u0444\u044C\u0435\u0439 \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    (\u0441\u0430\u043C\u0430\u044F \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
    \u043B\u0438\u0447\u043D\u0430\u044F \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u044C).**
    \u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438. \u041F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0438\u0441\u044C
    \u0432 1870 \u0433\u043E\u0434\u0443. \u041E\u043D \u0431\u044B\u043B \u0434\u043B\u044F
    \u043D\u0435\u0451 \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u043C,
    \u043D\u0430\u0443\u0447\u043D\u044B\u043C \u043E\u0442\u0446\u043E\u043C \u0438,
    \u043A\u0430\u043A \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F, \u0433\u043B\u0443\u0431\u043E\u043A\u043E
    \u0432\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u044B\u043C \u043C\u0443\u0436\u0447\u0438\u043D\u043E\u0439,
    \u0445\u043E\u0442\u044F \u0438\u0445 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
    \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u043F\u043B\u0430\u0442\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438.
    \u041F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u043C\u0443\u0436\u0430
    \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u043E\u0439 \u0432 1883
    \u0433\u043E\u0434\u0443, \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043F\u0440\u0438\u044E\u0442\u0438\u043B \u0435\u0451 \u0441 \u043C\u0430\u043B\u043E\u043B\u0435\u0442\u043D\u0435\u0439
    \u0434\u043E\u0447\u0435\u0440\u044C\u044E \u0443 \u0441\u0435\u0431\u044F \u0432
    \u0411\u0435\u0440\u043B\u0438\u043D\u0435. \u041E\u043D \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B
    \u043A\u043E\u043B\u043E\u0441\u0441\u0430\u043B\u044C\u043D\u044B\u0435 \u0443\u0441\u0438\u043B\u0438\u044F,
    \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
    \u0434\u043B\u044F \u043D\u0435\u0451 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0441\u043A\u043E\u0439
    \u043A\u0430\u0444\u0435\u0434\u0440\u044B \u0432 \u0421\u0442\u043E\u043A\u0433\u043E\u043B\u044C\u043C\u0435. 
    **\u0418\u0437\u0432\u0435\u0441\u0442\u0438\u0435 \u043E \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0439
    \u0441\u043C\u0435\u0440\u0442\u0438 \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u0432 1891 \u0433\u043E\u0434\u0443 \u043E\u0442 \u0432\u043E\u0441\u043F\u0430\u043B\u0435\u043D\u0438\u044F
    \u043B\u0435\u0433\u043A\u0438\u0445** \u0441\u0442\u0430\u043B\u043E \u0434\u043B\u044F
    75-\u043B\u0435\u0442\u043D\u0435\u0433\u043E \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u043E\u0439. \u041E\u043D
    \u0443\u0448\u0435\u043B \u0432 \u0441\u0435\u0431\u044F, \u0441\u0436\u0435\u0433
    \u0432\u0441\u0435 \u0435\u0451 \u043F\u0438\u0441\u044C\u043C\u0430 \u043A \u043D\u0435\u043C\u0443
    (\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441\u0432\u043E\u0438) \u0438, \u043F\u043E \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432, \u043F\u043E\u0441\u043B\u0435
    \u044D\u0442\u043E\u0433\u043E \u0441\u0442\u0430\u043B \u0431\u044B\u0441\u0442\u0440\u043E
    \u0441\u0434\u0430\u0432\u0430\u0442\u044C.  ---  ### \U0001FA7A \u0411\u043E\u043B\u0435\u0437\u043D\u0438
    \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B 
    \u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u043E \u0441\u043B\u0430\u0431\u044B\u043C
    \u0438\u0437-\u0437\u0430 \u043F\u0435\u0440\u0435\u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F
    \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438.   *   **\u0412
    1861 \u0433\u043E\u0434\u0443** \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043B\u0435\u043A\u0446\u0438\u0438
    \u0443 \u043D\u0435\u0433\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F
    \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u043F\u0440\u0438\u0441\u0442\u0443\u043F
    \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F
    \u0438 \u043C\u0438\u0433\u0440\u0435\u043D\u0438. \u0421 \u0442\u0435\u0445
    \u043F\u043E\u0440 \u043E\u043D \u043D\u0435 \u043C\u043E\u0433 \u0441\u0442\u043E\u044F\u0442\u044C
    \u0447\u0438\u0442\u0430\u0442\u044C \u043B\u0435\u043A\u0446\u0438\u0438 \u2014
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0438\u0434\u0435\u043B \u0432 \u043A\u0440\u0435\u0441\u043B\u0435,
    \u0430 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438
    \u043F\u0438\u0441\u0430\u043B\u0438 \u0437\u0430 \u043D\u0435\u0433\u043E \u043D\u0430
    \u0434\u043E\u0441\u043A\u0435 \u043C\u0435\u043B\u043E\u043C. *   \u0421 **\u043A\u043E\u043D\u0446\u0430
    1880-\u0445** \u043E\u043D \u0431\u044B\u043B \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043F\u0440\u0438\u043A\u043E\u0432\u0430\u043D \u043A \u043F\u043E\u0441\u0442\u0435\u043B\u0438
    \u0432 \u0441\u0432\u043E\u0435\u0439 \u0431\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u043E\u0439
    \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435. \u041E\u043D \u0441\u0442\u0440\u0430\u0434\u0430\u043B
    \u043E\u0442 \u0445\u0440\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u0438\u0446\u044B \u0438 \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u0439
    \u0441\u0435\u0440\u0434\u0446\u0430. \u041E\u0434\u043D\u0430\u043A\u043E \u0434\u043E
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445 \u0434\u043D\u0435\u0439
    \u043E\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432
    \u0443 \u0441\u0435\u0431\u044F \u0434\u043E\u043C\u0430, \u0447\u0438\u0442\u0430\u044F
    \u0438\u043C \u043B\u0435\u043A\u0446\u0438\u0438 \u043F\u0440\u044F\u043C\u043E
    \u0441 \u043A\u0440\u043E\u0432\u0430\u0442\u0438.  ---  ### \u26B0\uFE0F \u0421\u043C\u0435\u0440\u0442\u044C 
    \u041A\u0430\u0440\u043B \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F **19 \u0444\u0435\u0432\u0440\u0430\u043B\u044F
    1897 \u0433\u043E\u0434\u0430** \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0435
    \u043E\u0442 **\u043A\u0440\u0443\u043F\u043E\u0437\u043D\u043E\u0439 \u043F\u043D\u0435\u0432\u043C\u043E\u043D\u0438\u0438**.
    \u0415\u043C\u0443 \u0431\u044B\u043B 81 \u0433\u043E\u0434.  \u041E\u043D \u0443\u043C\u0435\u0440
    \u0432 \u043F\u043E\u043B\u043D\u043E\u043C \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435
    (\u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B \u0436\u0435\u043D\u0430\u0442,
    \u0434\u0435\u0442\u0435\u0439 \u043D\u0435 \u0438\u043C\u0435\u043B). \u041F\u043E\u0445\u043E\u0440\u043E\u043D\u044B
    \u0431\u044B\u043B\u0438 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u043C\u0438,
    \u043D\u043E \u043D\u0430 \u043D\u0438\u0445 \u0441\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C
    \u0432\u0441\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u044D\u043B\u0438\u0442\u0430 \u0415\u0432\u0440\u043E\u043F\u044B. \u041E\u043D
    \u0431\u044B\u043B \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0435\u043D \u043D\u0430
    \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435 \u0421\u0432\u044F\u0442\u043E\u0439
    \u042F\u0434\u0432\u0438\u0433\u0438 (St. Hedwig-Friedhof) \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0435.
    \u0415\u0433\u043E \u043C\u043E\u0433\u0438\u043B\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0430\u0441\u044C
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043C\u0435\u0441\u0442\u043E\u043C \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 \u0441\u043E
    \u0432\u0441\u0435\u0433\u043E \u043C\u0438\u0440\u0430.  \u0412 \u043F\u0430\u043C\u044F\u0442\u044C
    \u043E \u043D\u0435\u043C \u043D\u0430\u0437\u0432\u0430\u043D **\u043A\u0440\u0430\u0442\u0435\u0440
    \u043D\u0430 \u041B\u0443\u043D\u0435** (\u043A\u0440\u0430\u0442\u0435\u0440
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430) \u0438
    **\u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u0438\u0439 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442
    \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u043E\u0433\u043E \u0430\u043D\u0430\u043B\u0438\u0437\u0430
    \u0438 \u0441\u0442\u043E\u0445\u0430\u0441\u0442\u0438\u043A\u0438** (WIAS)
    \u043D\u043E\u0441\u0438\u0442 \u0435\u0433\u043E \u0438\u043C\u044F."
  personalLifeEn: 
  shortBioRu: "\u041A\u0430\u0440\u043B \u0422\u0435\u043E\u0434\u043E\u0440 \u0412\u0438\u043B\u044C\u0433\u0435\u043B\u044C\u043C
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 (1815\u20131897)
    \u2014 \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A,
    \u0447\u044C\u0451 \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435
    \u043A \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u0438
    \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043D\u0430\u043B\u0438\u0437. \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0439
    \u043F\u0443\u0442\u044C \u2014 \u044D\u0442\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u043F\u043E\u0437\u0434\u043D\u0435\u0433\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u044F
    \u0433\u0435\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u043E\u043B\u0433\u0438\u0435
    \u0433\u043E\u0434\u044B \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F
    \u0432 \u0442\u0435\u043D\u0438, \u043D\u043E \u0432 \u0438\u0442\u043E\u0433\u0435
    \u0441\u0442\u0430\u043B \xAB\u043E\u0442\u0446\u043E\u043C \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430\xBB.  ### \U0001F9EC \u0414\u0435\u0442\u0441\u0442\u0432\u043E
    \u0438 \u044E\u043D\u043E\u0441\u0442\u044C: \u043D\u0435\u0441\u0433\u0438\u0431\u0430\u0435\u043C\u0430\u044F
    \u0441\u0442\u0440\u0430\u0441\u0442\u044C  \u041A\u0430\u0440\u043B \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F 1815 \u0433\u043E\u0434\u0430 \u0432
    \u041E\u0441\u0442\u0435\u043D\u0444\u0435\u043B\u044C\u0434\u0435, \u0412\u0435\u0441\u0442\u0444\u0430\u043B\u0438\u044F,
    \u0432 \u0441\u0435\u043C\u044C\u0435 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430.
    \u0415\u0433\u043E \u043C\u0430\u0442\u044C \u0422\u0435\u043E\u0434\u043E\u0440\u0430
    \u0443\u043C\u0435\u0440\u043B\u0430, \u043A\u043E\u0433\u0434\u0430 \u0435\u043C\u0443
    \u0431\u044B\u043B\u043E 12 \u043B\u0435\u0442, \u0438 \u043C\u0430\u043B\u044C\u0447\u0438\u043A
    \u0440\u043E\u0441 \u043F\u043E\u0434 \u0441\u0438\u043B\u044C\u043D\u044B\u043C
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435\u043C \u043E\u0442\u0446\u0430, \u0412\u0438\u043B\u044C\u0433\u0435\u043B\u044C\u043C\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0438\u0434\u0435\u043B \u0441\u044B\u043D\u0430
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0441\u043B\u0443\u0436\u0430\u0449\u0438\u043C.  \u0412 1829 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044E
    \u0432 \u041F\u0430\u0434\u0435\u0440\u0431\u043E\u0440\u043D\u0435, \u0433\u0434\u0435
    \u043F\u0440\u043E\u044F\u0432\u0438\u043B \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435. \u041E\u043D
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043F\u0435\u0440\u0435\u0436\u0430\u043B
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443, \u0447\u0442\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u043E\u0441\u0432\u043E\u0438\u043B \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u0438\u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0435 \u0438 \u0448\u0442\u0443\u0434\u0438\u0440\u043E\u0432\u0430\u043B
    \u0440\u0430\u0431\u043E\u0442\u044B \u0410\u0431\u0435\u043B\u044F \u0438 \u042F\u043A\u043E\u0431\u0438
    \u043F\u043E \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u043C \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435.
    \u0418\u0437-\u0437\u0430 \u0441\u0442\u0435\u0441\u043D\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0441\u0435\u043C\u044C\u0438
    \u041A\u0430\u0440\u043B \u0441 15 \u043B\u0435\u0442 \u043F\u043E\u0434\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043B
    \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u043E\u043C \u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u043A\u0438. 
    \u0412 1834 \u0433\u043E\u0434\u0443 \u043E\u043D \u043E\u043A\u043E\u043D\u0447\u0438\u043B
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044E \u0441 \u043E\u0442\u043B\u0438\u0447\u0438\u0435\u043C
    \u0438 \u043F\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u0438\u044E \u043E\u0442\u0446\u0430
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0411\u043E\u043D\u043D\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043D\u0430
    \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442.
    \u042D\u0442\u043E \u0431\u044B\u043B \u0433\u043E\u0434, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0432\u0448\u0438\u0439
    \u0435\u0433\u043E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440: \u0432\u043C\u0435\u0441\u0442\u043E
    \u043F\u0440\u0430\u0432\u0430 \u041A\u0430\u0440\u043B \u0441 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
    \u0443\u0448\u0435\u043B \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443
    \u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0443\u044E
    \u0436\u0438\u0437\u043D\u044C. \u041E\u043D \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0441\u044F
    \u043A\u0430\u043A \u0438\u0441\u043A\u0443\u0441\u043D\u044B\u0439 \u0444\u0435\u0445\u0442\u043E\u0432\u0430\u043B\u044C\u0449\u0438\u043A,
    \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432 \u0434\u0443\u044D\u043B\u044F\u0445,
    \u043D\u043E \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435 \u0431\u044B\u043B
    \u0440\u0430\u043D\u0435\u043D. \u0427\u0435\u0442\u044B\u0440\u0435 \u0433\u043E\u0434\u0430
    \u0441\u043F\u0443\u0441\u0442\u044F, \u043D\u0435 \u0441\u0434\u0430\u0432 \u043D\u0438
    \u043E\u0434\u043D\u043E\u0433\u043E \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430,
    \u043E\u043D \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0434\u043E\u043C\u043E\u0439,
    \u043E\u0442\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044C \u043E\u0442
    \u043A\u0430\u0440\u044C\u0435\u0440\u044B \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430. 
    ### \U0001F4DA \u041F\u0443\u0442\u044C \u0447\u0435\u0440\u0435\u0437 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043A \u0441\u043B\u0430\u0432\u0435  \u0412 1839 \u0433\u043E\u0434\u0443,
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043F\u043E\u043C\u043E\u0449\u0438
    \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445, \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u041C\u044E\u043D\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E
    \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u044E \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u0430\u0442\u0442\u0435\u0441\u0442\u0430\u0442\u0430.
    \u0422\u0430\u043C \u0441\u0443\u0434\u044C\u0431\u0430 \u0441\u0432\u0435\u043B\u0430
    \u0435\u0433\u043E \u0441 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    **\u041A\u0440\u0438\u0441\u0442\u043E\u0444\u043E\u043C \u0413\u0443\u0434\u0435\u0440\u043C\u0430\u043D\u043E\u043C**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u043B
    \u0432 \u043D\u0435\u043C \u0433\u0435\u043D\u0438\u044F \u0438 \u0443\u0432\u043B\u0435\u043A
    \u0435\u0433\u043E \u0442\u0435\u043E\u0440\u0438\u0435\u0439 \u044D\u043B\u043B\u0438\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439. \u042D\u0442\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0441\u0442\u0430\u043B\u0430 \u0440\u0435\u0448\u0430\u044E\u0449\u0435\u0439. 
    \u0421 1842 \u043F\u043E 1856 \u0433\u043E\u0434 \u0434\u043B\u0438\u0442\u0441\u044F
    \xAB\u043F\u0435\u0440\u0438\u043E\u0434 \u0437\u0430\u0431\u0432\u0435\u043D\u0438\u044F\xBB
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430. \u041E\u043D
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C
    \u0432 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F\u0445, \u0441 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439 \u0434\u043E 30 \u0447\u0430\u0441\u043E\u0432
    \u0432 \u043D\u0435\u0434\u0435\u043B\u044E. \u0415\u043C\u0443 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443,
    \u043D\u043E \u0438 \u0444\u0438\u0437\u0438\u043A\u0443, \u0431\u043E\u0442\u0430\u043D\u0438\u043A\u0443,
    \u0433\u0435\u043E\u0433\u0440\u0430\u0444\u0438\u044E, \u0438\u0441\u0442\u043E\u0440\u0438\u044E,
    \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u044F\u0437\u044B\u043A \u0438
    \u0434\u0430\u0436\u0435 \u0433\u0438\u043C\u043D\u0430\u0441\u0442\u0438\u043A\u0443. 
    \u0417\u0430\u0440\u0430\u0431\u043E\u0442\u043A\u0430 (348 \u0442\u0430\u043B\u0435\u0440\u043E\u0432
    \u0432 \u0433\u043E\u0434) \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0430\u043B\u043E,
    \u0447\u0442\u043E\u0431\u044B \u043A\u0443\u043F\u0438\u0442\u044C \u043C\u0430\u0440\u043A\u0438
    \u0434\u043B\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0438 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0435\u0439
    \u0432 \u0436\u0443\u0440\u043D\u0430\u043B\u044B. \u041F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0439
    \u0432 \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E, \u043E\u043D \u043F\u043E\u0441\u0432\u044F\u0449\u0430\u043B
    \u043D\u043E\u0447\u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435.
    \u0418\u043C\u0435\u043D\u043D\u043E \u0442\u043E\u0433\u0434\u0430, \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F
    \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043E\u0432,
    \u043E\u043D \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B \u043E\u0441\u043D\u043E\u0432\u044B
    \u0441\u0432\u043E\u0435\u0439 \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u0442\u0435\u043E\u0440\u0438\u0438.
    \u041D\u0435\u0445\u0432\u0430\u0442\u043A\u0430 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u0431\u044B\u043B\u0430 \u0442\u0430\u043A\u043E\u0432\u0430, \u0447\u0442\u043E
    \u0434\u0430\u0436\u0435 \u0432 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u043C
    \u0434\u0438\u043F\u043B\u043E\u043C\u0435 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430,
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u043C \u0432 1841 \u0433\u043E\u0434\u0443,
    \u0431\u044B\u043B\u0430 \u0437\u0430\u043F\u0438\u0441\u044C \u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0435
    \u0437\u043D\u0430\u043D\u0438\u0439 \u043F\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C, \u0447\u0442\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u043B\u043E
    \u0435\u0433\u043E \u043F\u0440\u0430\u0432\u043E \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u044C
    \u0438\u0445.  ### \U0001F680 \u0412\u0437\u043B\u0435\u0442 \u0438 \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u0438\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434  \u041F\u0440\u043E\u0440\u044B\u0432 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u043B
    \u0432 1854 \u0433\u043E\u0434\u0443, \u043A\u043E\u0433\u0434\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B \u0432 \xAB\u0416\u0443\u0440\u043D\u0430\u043B\u0435
    \u041A\u0440\u0435\u043B\u043B\u0435\xBB \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u043F\u043E \u0430\u0431\u0435\u043B\u0435\u0432\u044B\u043C
    \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u043C. \u041E\u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u043B\u0430
    \u044D\u0444\u0444\u0435\u043A\u0442 \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u0432\u0448\u0435\u0439\u0441\u044F
    \u0431\u043E\u043C\u0431\u044B. \u041A\u0451\u043D\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
    \u043F\u0440\u0438\u0441\u0432\u043E\u0438\u043B \u0435\u043C\u0443 \u0441\u0442\u0435\u043F\u0435\u043D\u044C
    \u043F\u043E\u0447\u0435\u0442\u043D\u043E\u0433\u043E \u0434\u043E\u043A\u0442\u043E\u0440\u0430
    \u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044B \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438. 
    \u0412 1856 \u0433\u043E\u0434\u0443, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0435 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430
    \u0444\u043E\u043D \u0413\u0443\u043C\u0431\u043E\u043B\u044C\u0434\u0442\u0430,
    \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043E
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \u0432 \u041F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u043C
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u2014 \u044D\u043A\u0441\u0442\u0440\u0430\u043E\u0440\u0434\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430 \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0421
    \u044D\u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u0435\u0433\u043E 40-\u043B\u0435\u0442\u043D\u044F\u044F \u043A\u0430\u0440\u044C\u0435\u0440\u0430
    \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0435, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430 \u0435\u0433\u043E
    \u0432 \u0437\u0432\u0435\u0437\u0434\u0443 \u043F\u0435\u0440\u0432\u043E\u0439
    \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u044B.  \u0412 1864 \u0433\u043E\u0434\u0443
    \u043E\u043D \u0441\u0442\u0430\u043B \u043E\u0440\u0434\u0438\u043D\u0430\u0440\u043D\u044B\u043C
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C. \u0415\u0433\u043E
    \u043B\u0435\u043A\u0446\u0438\u0438, \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0435
    \u043F\u043E \u0441\u043E\u043A\u0440\u0430\u0442\u043E\u0432\u0441\u043A\u043E\u043C\u0443
    \u043C\u0435\u0442\u043E\u0434\u0443 \xAB\u043C\u0430\u0439\u0435\u0432\u0442\u0438\u043A\u0438\xBB
    \u2014 \u0432\u043E\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432
    \u0432 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u043E\u0438\u0441\u043A
    \u0438\u0441\u0442\u0438\u043D\u044B, \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438
    \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0435
    \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438 \u0438 \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0438
    \u0435\u0433\u043E \u043A\u0430\u043A \u043B\u0443\u0447\u0448\u0435\u0433\u043E
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F
    \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438.  \u041E\u0434\u043D\u0430\u043A\u043E
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435, \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0435
    \u043D\u043E\u0447\u043D\u044B\u043C\u0438 \u0431\u0434\u0435\u043D\u0438\u044F\u043C\u0438,
    \u0434\u0430\u043B\u043E \u0441\u0431\u043E\u0439. \u0412 1861 \u0433\u043E\u0434\u0443
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043B\u0435\u043A\u0446\u0438\u0438
    \u0443 \u043D\u0435\u0433\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F
    \u0442\u044F\u0436\u0435\u043B\u044B\u0439 \u043F\u0440\u0438\u0441\u0442\u0443\u043F
    \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F.
    \u0421 \u0442\u0435\u0445 \u043F\u043E\u0440 \u043E\u043D \u0447\u0438\u0442\u0430\u043B
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0438\u0434\u044F, \u0430 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B
    \u043F\u0438\u0441\u0430\u043B\u0438 \u0437\u0430 \u043D\u0435\u0433\u043E \u043D\u0430
    \u0434\u043E\u0441\u043A\u0435. \u0421 \u043A\u043E\u043D\u0446\u0430 1880-\u0445
    \u0433\u043E\u0434\u043E\u0432 \u043E\u043D \u0431\u044B\u043B \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043F\u0440\u0438\u043A\u043E\u0432\u0430\u043D \u043A \u043F\u043E\u0441\u0442\u0435\u043B\u0438. 
    ### \U0001F494 \u0421\u0443\u0434\u044C\u0431\u043E\u043D\u043E\u0441\u043D\u0430\u044F
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0421\u043E\u0444\u044C\u0435\u0439
    \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u043E\u0439  \u0412 1870
    \u0433\u043E\u0434\u0443 \u0432 \u0436\u0438\u0437\u043D\u0438 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430,
    \u043E\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0430\u044F \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439
    \u0441\u043B\u0435\u0434. \u041A \u043D\u0435\u043C\u0443 \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0430
    20-\u043B\u0435\u0442\u043D\u044F\u044F \u0421\u043E\u0444\u044C\u044F \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u0430\u044F,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0431\u044B\u043B\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u043D\u043E
    \u0432 \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u0438 \u043B\u0435\u043A\u0446\u0438\u0439
    \u0438\u0437-\u0437\u0430 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u043E\u043D\u0430
    \u0436\u0435\u043D\u0449\u0438\u043D\u0430.  \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0432\u0437\u044F\u043B\u0441\u044F \u043E\u0431\u0443\u0447\u0430\u0442\u044C
    \u0435\u0451 \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u043E, \u0438 \u043E\u043D\u0430
    \u0441\u0442\u0430\u043B\u0430 \u0435\u0433\u043E \u043B\u0443\u0447\u0448\u0435\u0439
    \u0443\u0447\u0435\u043D\u0438\u0446\u0435\u0439. \u0418\u0445 \u0441\u0432\u044F\u0437\u044C
    \u043F\u0435\u0440\u0435\u0440\u043E\u0441\u043B\u0430 \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E
    \u043B\u0438\u0447\u043D\u0443\u044E \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u044C.
    \u041E\u043D \u043F\u043E\u043C\u043E\u0433\u0430\u043B \u0435\u0439 \u0432 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u0445,
    \u0434\u043E\u0431\u0438\u043B\u0441\u044F \u0434\u043B\u044F \u043D\u0435\u0451
    \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0438,
    \u043F\u043E\u0441\u043B\u0435 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0433\u0438\u0431\u0435\u043B\u0438 \u0435\u0451 \u043C\u0443\u0436\u0430 \u0432
    1883 \u0433\u043E\u0434\u0443, \u043F\u0440\u0438\u044E\u0442\u0438\u043B \u0435\u0451
    \u0441 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439 \u0434\u043E\u0447\u0435\u0440\u044C\u044E
    \u0432 \u0441\u0432\u043E\u0435\u043C \u0434\u043E\u043C\u0435 \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0435.
    \u0426\u0435\u043D\u043E\u0439 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u044B\u0445
    \u0443\u0441\u0438\u043B\u0438\u0439 \u043E\u043D \u043F\u043E\u043C\u043E\u0433
    \u0435\u0439 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0441\u043A\u0443\u044E
    \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u0432 \u0421\u0442\u043E\u043A\u0433\u043E\u043B\u044C\u043C\u0435. 
    \u0418\u0437\u0432\u0435\u0441\u0442\u0438\u0435 \u043E \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0439
    \u0441\u043C\u0435\u0440\u0442\u0438 \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u0432 1891 \u0433\u043E\u0434\u0443 \u043F\u043E\u0442\u0440\u044F\u0441\u043B\u043E
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430. \u0423\u0437\u043D\u0430\u0432
    \u043E\u0431 \u044D\u0442\u043E\u043C, \u043E\u043D \u0441\u0436\u0435\u0433
    \u0432\u0441\u0435 \u0435\u0435 \u043F\u0438\u0441\u044C\u043C\u0430, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0432\u043E\u044E \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0443
    \u0441 \u043D\u0435\u0439. \u042D\u0442\u043E \u0441\u0442\u0430\u043B\u043E
    \u0442\u044F\u0436\u0435\u043B\u0435\u0439\u0448\u0438\u043C \u0443\u0434\u0430\u0440\u043E\u043C
    \u0432 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438.  ### \U0001F9E0 \xAB\u041E\u0442\u0435\u0446
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u0430\u043D\u0430\u043B\u0438\u0437\u0430\xBB 
    \u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u2014
    \u044D\u0442\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 **\u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430**. \u0414\u043E \u043D\u0435\u0433\u043E
    \u0434\u0430\u0436\u0435 \u0432 \u0440\u0430\u0431\u043E\u0442\u0430\u0445 \u041A\u043E\u0448\u0438
    \u0431\u044B\u043B\u043E \u043C\u043D\u043E\u0433\u043E \u0438\u043D\u0442\u0443\u0438\u0442\u0438\u0432\u043D\u044B\u0445
    \u0434\u043E\u043F\u0443\u0449\u0435\u043D\u0438\u0439.  \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043E\u0437\u0434\u0430\u043B \u0441\u0442\u0440\u043E\u0433\u0443\u044E
    \u0442\u0435\u043E\u0440\u0438\u044E \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B \u0438 \u0432\u0432\u0435\u043B \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    **\u03B5-\u03B4-\u044F\u0437\u044B\u043A**, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043E\u0441\u043D\u043E\u0432\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430. \u0418\u043C\u0435\u043D\u043D\u043E
    \u0435\u043C\u0443 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
    \u0441\u0442\u0440\u043E\u0433\u043E\u0435 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u043F\u0440\u0435\u0434\u0435\u043B\u0430, \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0441\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043C\u044B \u0443\u0447\u0438\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F. 
    \u041E\u043D \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0440\u0430\u0437\u0438\u043B
    \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u043C\u0438\u0440, \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0432
    \u0432 1861 \u0433\u043E\u0434\u0443 **\u0444\u0443\u043D\u043A\u0446\u0438\u044E,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u0430
    \u0432 \u043A\u0430\u0436\u0434\u043E\u0439 \u0442\u043E\u0447\u043A\u0435, \u043D\u043E
    \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u043D\u043E\u0439
    \u043D\u0438 \u0432 \u043E\u0434\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0435**,
    \u2014 \u043D\u0430\u0433\u043B\u044F\u0434\u043D\u043E\u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044F
    \u043C\u043E\u0436\u0435\u0442 \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u0442\u044C. 
    \u0421\u0440\u0435\u0434\u0438 \u0435\u0433\u043E \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432
    \u2014 \u0442\u0430\u043A\u0438\u0435 \u0437\u0432\u0435\u0437\u0434\u044B, \u043A\u0430\u043A
    **\u0413\u0435\u043E\u0440\u0433 \u041A\u0430\u043D\u0442\u043E\u0440**, **\u0424\u0435\u0440\u0434\u0438\u043D\u0430\u043D\u0434
    \u0424\u0440\u043E\u0431\u0435\u043D\u0438\u0443\u0441**, **\u041A\u0430\u0440\u043B
    \u0420\u0443\u043D\u0433\u0435** \u0438 \u0421\u043E\u0444\u044C\u044F \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u0430\u044F. 
    \u041A\u0430\u0440\u043B \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F 19 \u0444\u0435\u0432\u0440\u0430\u043B\u044F
    1897 \u0433\u043E\u0434\u0430 \u0432 \u0411\u0435\u0440\u043B\u0438\u043D\u0435
    \u043E\u0442 \u043F\u043D\u0435\u0432\u043C\u043E\u043D\u0438\u0438, \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043C\u0435\u043D\u0438\u0432 \u043B\u0438\u0446\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.
    \u0415\u0433\u043E \u0438\u043C\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u043D\u043E\u0441\u044F\u0442 \u043A\u0440\u0430\u0442\u0435\u0440 \u043D\u0430
    \u041B\u0443\u043D\u0435 \u0438 \u0411\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u0438\u0439
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0438 \u0441\u0442\u043E\u0445\u0430\u0441\u0442\u0438\u043A\u0438
    (WIAS)."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043D\u044C \u041A\u0430\u0440\u043B\u0430
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430 \u043F\u043E\u043B\u043D\u0430
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u0430\u0440\u0430\u0434\u043E\u043A\u0441\u043E\u0432,
    \u0437\u0430\u0431\u0430\u0432\u043D\u044B\u0445 \u0441\u043B\u0443\u0447\u0430\u0435\u0432
    \u0438 \u0442\u0440\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0434\u0435\u0442\u0430\u043B\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0435\u0433\u043E
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u043A \u0441\u0443\u0445\u043E\u0433\u043E
    \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u043A\u0430, \u043D\u043E \u0438 \u043A\u0430\u043A
    \u0436\u0438\u0432\u043E\u0433\u043E, \u0441\u0442\u0440\u0430\u0441\u0442\u043D\u043E\u0433\u043E
    \u0438 \u043E\u0447\u0435\u043D\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u043D\u043E\u0433\u043E
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.   \u0412\u043E\u0442 \u0441\u0430\u043C\u044B\u0435
    \u044F\u0440\u043A\u0438\u0435 \u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0444\u0430\u043A\u0442\u044B, \u043A\u0443\u0440\u044C\u0435\u0437\u044B \u0438
    \u0434\u0435\u0442\u0430\u043B\u0438 \u0438\u0437 \u0435\u0433\u043E \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438. 
    ### \u2694\uFE0F 1. \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043D\u0435 \u0431\u043E\u044F\u043B\u0441\u044F \u0448\u0440\u0430\u043C\u043E\u0432
    (\u0421\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0435 \u0434\u0443\u044D\u043B\u0438)
    \u0412\u043E\u043F\u0440\u0435\u043A\u0438 \u043E\u0431\u0440\u0430\u0437\u0443
    \u0442\u0438\u0445\u043E\u0433\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u043D\u043E\u0433\u043E
    \u0443\u0447\u0435\u043D\u043E\u0433\u043E, \u0432 \u0411\u043E\u043D\u043D\u0441\u043A\u0438\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434 (1834\u20131838) \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0431\u044B\u043B \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u043C \u0441\u043E\u0440\u0432\u0438\u0433\u043E\u043B\u043E\u0432\u043E\u0439.
    \u041E\u043D \u0432\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0435
    \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u043E *Corps Guestphalia* \u0438 \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0441\u044F
    \u043A\u0430\u043A \u043E\u0434\u0438\u043D \u0438\u0437 \u043B\u0443\u0447\u0448\u0438\u0445
    \u0444\u0435\u0445\u0442\u043E\u0432\u0430\u043B\u044C\u0449\u0438\u043A\u043E\u0432
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. *  
    **\u041A\u0443\u0440\u044C\u0435\u0437:** \u041E\u043D \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0432 \u0434\u0435\u0441\u044F\u0442\u043A\u0430\u0445 \u0434\u0443\u044D\u043B\u0435\u0439
    \u043D\u0430 \u0440\u0430\u043F\u0438\u0440\u0430\u0445, \u0438 \u0435\u0433\u043E
    \u043B\u0438\u0446\u043E \u0431\u044B\u043B\u043E \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u043E
    \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \xAB\u0448\u0440\u0430\u043C\u0438\u0440\u0430\u043C\u0438\xBB (Schmiss) \u2014
    \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C\u044E \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0445
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u0442\u043E\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438.  *   **\u0418\u0440\u043E\u043D\u0438\u044F
    \u0441\u0443\u0434\u044C\u0431\u044B:** \u0417\u0430 4 \u0433\u043E\u0434\u0430
    \u0431\u0443\u0440\u043D\u043E\u0439 \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438, \u043F\u043E\u043B\u0443\u0447\u0430\u044F \u0443\u0434\u0430\u0440\u044B
    \u0440\u0430\u043F\u0438\u0440\u043E\u0439 \u0432 \u0433\u043E\u043B\u043E\u0432\u0443
    \u0438 \u043A\u043E\u0440\u043F\u0443\u0441, \u043E\u043D **\u043D\u0438 \u0440\u0430\u0437\u0443
    \u043D\u0435 \u0431\u044B\u043B \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E
    \u0440\u0430\u043D\u0435\u043D**. \u041F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u0441\u043F\u0443\u0441\u0442\u044F \u0433\u043E\u0434\u044B, \u0441\u0438\u0434\u044F
    \u0432 \u0442\u0438\u0448\u0438\u043D\u0435 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430,
    \u043E\u043D \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0445\u0440\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0433\u043E\u043B\u043E\u0432\u043D\u044B\u0435 \u0431\u043E\u043B\u0438 \u0438
    \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u0438\u0446\u0443 \u043E\u0442 \u0443\u043C\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u0435\u0440\u0435\u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F.
    \u0422\u043E \u0435\u0441\u0442\u044C \u0444\u0435\u0445\u0442\u043E\u0432\u0430\u043D\u0438\u0435
    \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0434\u043B\u044F \u043D\u0435\u0433\u043E
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435, \u0447\u0435\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430.  ### \U0001F4B0
    2. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F \u043D\u0430 \u043C\u0430\u0440\u043A\u0430\u0445
    \u0438 \xAB\u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043D\u043D\u0430\u044F
    \u0441\u043B\u0430\u0432\u0430\xBB \u0412 \u0433\u043E\u0434\u044B \u0440\u0430\u0431\u043E\u0442\u044B
    \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C \u0432 \u0414\u043E\u0439\u0447-\u041A\u0440\u043E\u043D\u0435
    \u0438 \u0411\u0440\u0430\u0443\u043D\u0441\u0431\u0435\u0440\u0433\u0435 (1843\u20131856)
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0431\u044B\u043B
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u0434\u0435\u043D,
    \u0447\u0442\u043E \u044D\u0442\u043E \u0433\u0440\u0430\u043D\u0438\u0447\u0438\u043B\u043E
    \u0441 \u0430\u043D\u0435\u043A\u0434\u043E\u0442\u043E\u043C. *   **\u0424\u0430\u043A\u0442:**
    \u0415\u0433\u043E \u0433\u043E\u0434\u043E\u0432\u043E\u0433\u043E \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F
    (348 \u0442\u0430\u043B\u0435\u0440\u043E\u0432) \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0430\u043B\u043E
    \u043D\u0430 \u0435\u0434\u0443 \u0438 \u0441\u0432\u0435\u0447\u0438. \u0427\u0442\u043E\u0431\u044B
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u043E\u044E
    \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u0442\u0430\u0442\u044C\u044E
    \u043F\u043E \u0430\u0431\u0435\u043B\u0435\u0432\u044B\u043C \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u043C
    \u0432 \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442\u043D\u044B\u0439
    \xAB\u0416\u0443\u0440\u043D\u0430\u043B \u041A\u0440\u0435\u043B\u043B\u0435\xBB,
    \u0435\u043C\u0443 \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043A\u0443\u043F\u0438\u0442\u044C
    \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0435 \u043C\u0430\u0440\u043A\u0438. 
    *   **\u041A\u0443\u0440\u044C\u0435\u0437:** \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    **\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B
    \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0443 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0435\u0439
    \u043D\u0430 \u043C\u0435\u0441\u044F\u0446\u044B**, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0443 \u043D\u0435\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E
    \u0434\u0435\u043D\u0435\u0433 \u043D\u0430 \u043C\u0430\u0440\u043A\u0438 \u0434\u043B\u044F
    \u0442\u044F\u0436\u0435\u043B\u043E\u0433\u043E \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0430.
    \u0412 \u0438\u0442\u043E\u0433\u0435 \u043E\u043D \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u043B
    \u0438\u0445 \u0441 \u043E\u043A\u0430\u0437\u0438\u0435\u0439 \u0438\u043B\u0438
    \u0432 \u0434\u043E\u043B\u0433, \u0447\u0435\u043C \u0441\u0438\u043B\u044C\u043D\u043E
    \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u044E
    \u0441\u0432\u043E\u0438\u0445 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0439.
    \u0415\u0441\u043B\u0438 \u0431\u044B \u0443 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0438
    \u043B\u0438\u0448\u043D\u0438\u0435 \u0433\u0440\u043E\u0448\u0438, \u043E\u043D
    \u043C\u043E\u0433 \u0431\u044B \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u043D\u0430 5 \u043B\u0435\u0442 \u0440\u0430\u043D\u044C\u0448\u0435!  ###
    \U0001F9D1\u200D\U0001F3EB 3. \xAB\u041F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440
    \u0441 \u043C\u0435\u043B\u043A\u043E\u043C\xBB \u0438 \u043B\u0435\u043A\u0446\u0438\u0438
    \u0432 \u043A\u0440\u0435\u0441\u043B\u0435 \u041F\u043E\u0441\u043B\u0435 1861
    \u0433\u043E\u0434\u0430 \u0443 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0440\u0430\u0437\u0432\u0438\u043B\u0430\u0441\u044C \u0442\u044F\u0436\u0435\u043B\u0430\u044F
    \u0444\u043E\u0440\u043C\u0430 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u043E\u0432
    \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F
    (\u0432\u0435\u0440\u0442\u0438\u0433\u043E). \u0421\u0442\u043E\u044F\u0442\u044C
    \u043D\u0430 \u043A\u0430\u0444\u0435\u0434\u0440\u0435 \u043E\u043D \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435 \u043C\u043E\u0433. *   **\u0422\u0440\u0430\u0434\u0438\u0446\u0438\u044F:**
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0441\u0430\u0434\u0438\u043B\u0441\u044F
    \u0432 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043C\u044F\u0433\u043A\u043E\u0435
    \u043A\u0440\u0435\u0441\u043B\u043E \u043F\u0435\u0440\u0435\u0434 \u0434\u043E\u0441\u043A\u043E\u0439
    \u0438 \u0447\u0438\u0442\u0430\u043B \u043B\u0435\u043A\u0446\u0438\u0438 **\u0441\u0438\u0434\u044F**.
    \u041D\u043E \u0442\u0430\u043A \u043A\u0430\u043A \u0441\u0430\u043C \u043E\u043D
    \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u043A \u0434\u043E\u0441\u043A\u0435
    \u043D\u0435 \u043C\u043E\u0433, \u043E\u043D \u0434\u0438\u043A\u0442\u043E\u0432\u0430\u043B
    \u0444\u043E\u0440\u043C\u0443\u043B\u044B, \u0430 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B
    \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0438
    \u043A \u0434\u043E\u0441\u043A\u0435 \u0438 \u043F\u0438\u0441\u0430\u043B\u0438
    \u043C\u0435\u043B\u043E\u043C \u043F\u043E\u0434 \u0435\u0433\u043E \u0434\u0438\u043A\u0442\u043E\u0432\u043A\u0443.
    *   **\u0417\u0430\u0431\u0430\u0432\u043D\u044B\u0439 \u0448\u0442\u0440\u0438\u0445:**
    \u041E\u0447\u0435\u0432\u0438\u0434\u0446\u044B \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0438,
    \u0447\u0442\u043E \u043E\u043D \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B
    \u043F\u0438\u0441\u0430\u0442\u044C \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
    \u0440\u043E\u0432\u043D\u043E. \u0415\u0441\u043B\u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442
    \u0441\u0442\u0430\u0432\u0438\u043B \u043A\u0440\u0438\u0432\u043E\u0439 \u0437\u043D\u0430\u043A
    \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u0430, \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B \u043B\u0435\u043A\u0446\u0438\u044E
    \u0438 \u0432\u043E\u0440\u0447\u0430\u043B: *\xAB\u041C\u043E\u043B\u043E\u0434\u043E\u0439
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u043A\u0430\u043B\u043B\u0438\u0433\u0440\u0430\u0444\u0438\u044F,
    \u043D\u043E \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0432 \u0437\u043D\u0430\u043A\u0430\u0445
    \u2014 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0432 \u0433\u043E\u043B\u043E\u0432\u0435!\xBB*
    \u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u043E\u043D \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u043F\u043E\u0432\u044B\u0448\u0430\u043B \u0433\u043E\u043B\u043E\u0441\u0430,
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u0435\u0433\u043E \u043E\u0431\u043E\u0436\u0430\u043B\u0438. 
    ### \U0001F436 4. \u0421\u043E\u0431\u0430\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0433\u0443\u043B\u044F\u043B\u0430 \u0432\u043C\u0435\u0441\u0442\u043E \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043E\u0431\u043E\u0436\u0430\u043B
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0441\u043E\u0431\u0430\u043A. \u0412 \u0411\u0435\u0440\u043B\u0438\u043D\u0435
    \u0443 \u043D\u0435\u0433\u043E \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
    \u0442\u0430\u043A\u0441\u0430.  *   **\u041A\u0443\u0440\u044C\u0435\u0437:**
    \u041D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435 \u043B\u0435\u0442, \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D \u0441\u043E\u0432\u0441\u0435\u043C \u043E\u0441\u043B\u0430\u0431,
    \u043E\u043D \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0445\u043E\u0442\u0435\u043B
    \u0433\u0443\u043B\u044F\u0442\u044C. \u041D\u043E \u0438\u0437-\u0437\u0430
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0435\u0433\u043E \u0448\u0430\u0442\u0430\u043B\u043E,
    \u043E\u043D \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B \u0441\u0438\u0441\u0442\u0435\u043C\u0443:
    \u043E\u043D \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u043B \u0442\u0430\u043A\u0441\u0443
    \u0432\u043F\u0435\u0440\u0435\u0434 \u043D\u0430 \u043F\u043E\u0432\u043E\u0434\u043A\u0435,
    \u0438 \u0441\u043E\u0431\u0430\u043A\u0430 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
    \u0442\u0430\u0449\u0438\u043B\u0430 \u0435\u0433\u043E \u043F\u043E \u0430\u043B\u043B\u0435\u044F\u043C
    \u0422\u0438\u0440\u0433\u0430\u0440\u0442\u0435\u043D\u0430. \u0421\u043E\u0441\u0435\u0434\u0438
    \u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u0447\u0430\u0441\u0442\u043E
    \u0432\u0438\u0434\u0435\u043B\u0438, \u043A\u0430\u043A \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A, \u0434\u0435\u0440\u0436\u0430\u0441\u044C
    \u0437\u0430 \u043F\u043E\u0432\u043E\u0434\u043E\u043A, \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
    \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u043D\u043E\u0441\u043E\u043C
    \u0441\u0432\u043E\u0435\u0439 \u0442\u0430\u043A\u0441\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0441\u0430\u043C\u0430 \u0432\u044B\u0431\u0438\u0440\u0430\u043B\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
    \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438.  ### \U0001F92F 5. \u041A\u0430\u043A
    \u043E\u043D \xAB\u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043B\xBB \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044E
    (\u0421\u043A\u0430\u043D\u0434\u0430\u043B \u0441 \u0444\u0443\u043D\u043A\u0446\u0438\u0435\u0439)
    \u0412 1861 \u0433\u043E\u0434\u0443 \u043D\u0430 \u043B\u0435\u043A\u0446\u0438\u0438
    \u043E\u043D \u043F\u0440\u0438\u0432\u0435\u043B \u0441\u0432\u043E\u0439 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u043F\u0440\u0438\u043C\u0435\u0440 \u0444\u0443\u043D\u043A\u0446\u0438\u0438,
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0439 \u0432\u0435\u0437\u0434\u0435,
    \u043D\u043E \u043D\u0435 \u0438\u043C\u0435\u044E\u0449\u0435\u0439 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u043D\u043E\u0439
    \u043D\u0438\u0433\u0434\u0435.  *   **\u0420\u0435\u0430\u043A\u0446\u0438\u044F:**
    \u0421\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u0438 \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u044F\u043B\u0438
    \u044D\u0442\u043E \u043A\u0430\u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043F\u0440\u043E\u0432\u043E\u043A\u0430\u0446\u0438\u044E. \u0417\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A \u0428\u0430\u0440\u043B\u044C
    \u042D\u0440\u043C\u0438\u0442 \u043D\u0430\u0437\u0432\u0430\u043B \u044D\u0442\u043E
    \xAB\u0443\u0436\u0430\u0441\u043D\u043E\u0439 \u0444\u0443\u043D\u043A\u0446\u0438\u0435\u0439\xBB.
    \u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430, \u0443\u0441\u043B\u044B\u0448\u0430\u0432
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E,
    \u0432\u043E\u0441\u043A\u043B\u0438\u043A\u043D\u0443\u043B: *\xAB\u0415\u0441\u043B\u0438
    \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430, \u0442\u043E \u044F
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u044E \u043D\u0438 \u0432 \u043E\u0434\u043D\u0443
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443!\xBB*  *   \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F \u0438 \u043E\u0442\u0432\u0435\u0442\u0438\u043B
    \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0439 \u0444\u0440\u0430\u0437\u043E\u0439:
    *\xAB\u0412 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u043D\u0435\u0442
    \u043C\u0435\u0441\u0442\u0430 \u0440\u0438\u0441\u0443\u043D\u043A\u0430\u043C,
    \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441\u0442\u0440\u043E\u0433\u0438\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F\u043C.
    \u041C\u044B\u0441\u043B\u044C \u0442\u043E\u0447\u043D\u0435\u0435 \u0433\u043B\u0430\u0437\u0430\xBB*.  
    ### \U0001F494 6. \u0421\u043E\u0436\u0436\u0435\u043D\u043D\u0430\u044F \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0430
    (\u041F\u043E\u0441\u0442\u0443\u043F\u043E\u043A, \u0445\u0440\u0430\u043D\u044F\u0449\u0438\u0439
    \u0442\u0430\u0439\u043D\u0443) \u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044F \u043E \u0441\u043A\u043E\u0440\u043E\u043F\u043E\u0441\u0442\u0438\u0436\u043D\u043E\u0439
    \u0441\u043C\u0435\u0440\u0442\u0438 \u0421\u043E\u0444\u044C\u0438 \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u0432 1891 \u0433\u043E\u0434\u0443 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
    \u0438 \u043C\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A.
    *   **\u041A\u0443\u0440\u044C\u0435\u0437 (\u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u043D\u044B\u0439):**
    \u041E\u043D \u0441\u043E\u0431\u0440\u0430\u043B \u0432\u0441\u0435 \u043F\u0438\u0441\u044C\u043C\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u0430\u044F
    \u043A\u043E\u0433\u0434\u0430-\u043B\u0438\u0431\u043E \u043F\u0438\u0441\u0430\u043B\u0430
    \u0435\u043C\u0443 (\u0430 \u0438\u0445 \u0431\u044B\u043B\u0438 \u0441\u043E\u0442\u043D\u0438,
    \u043F\u043E\u043B\u043D\u044B\u0435 \u043B\u0438\u0447\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043D\u0438\u0439),
    \u0438 **\u0441\u0436\u0435\u0433 \u0438\u0445 \u0434\u043E\u0442\u043B\u0430**
    \u0432 \u043A\u0430\u043C\u0438\u043D\u0435.  *   \u041F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u043E\u043D **\u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B**
    \u0432\u0441\u0435 \u0441\u0432\u043E\u0438 \u043F\u0438\u0441\u044C\u043C\u0430,
    \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u0435\u0439
    (\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0442\u043E\u043C \u0431\u044B\u043B\u0438
    \u043D\u0430\u0439\u0434\u0435\u043D\u044B \u0432 \u0435\u0435 \u0430\u0440\u0445\u0438\u0432\u0430\u0445).
    \u0417\u0430\u0447\u0435\u043C \u043E\u043D \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B?
    \u0411\u0438\u043E\u0433\u0440\u0430\u0444\u044B \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442,
    \u0447\u0442\u043E \u043E\u043D \u0445\u043E\u0442\u0435\u043B \u0443\u043D\u0435\u0441\u0442\u0438
    \u0442\u0430\u0439\u043D\u0443 \u0438\u0445 \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0445
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0439 \u0432 \u043C\u043E\u0433\u0438\u043B\u0443,
    \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B
    \u0435\u0451 \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u0438\u0439. \u042D\u0442\u043E\u0442
    \u0436\u0435\u0441\u0442 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
    \u0441\u043F\u043E\u0440\u044B: \u0431\u044B\u043B\u0430 \u043B\u0438 \u044D\u0442\u043E
    \u043B\u044E\u0431\u043E\u0432\u044C, \u043E\u0442\u0446\u043E\u0432\u0441\u043A\u0430\u044F
    \u0437\u0430\u0431\u043E\u0442\u0430 \u0438\u043B\u0438 \u0441\u0442\u0440\u0430\u0445
    \u043F\u0435\u0440\u0435\u0434 \u043E\u0433\u043B\u0430\u0441\u043A\u043E\u0439? 
    ### \U0001F3C6 7. \u041E\u0442\u043A\u0430\u0437 \u043E\u0442 \u0437\u043E\u043B\u043E\u0442\u0430
    (\u0421\u043A\u0440\u043E\u043C\u043D\u043E\u0441\u0442\u044C) \u0412 1885 \u0433\u043E\u0434\u0443,
    \u0432 \u0447\u0435\u0441\u0442\u044C 70-\u043B\u0435\u0442\u0438\u044F, \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0435
    \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0445\u043E\u0442\u0435\u043B\u043E \u043E\u0442\u0447\u0435\u043A\u0430\u043D\u0438\u0442\u044C
    \u0432 \u0447\u0435\u0441\u0442\u044C \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0437\u043E\u043B\u043E\u0442\u0443\u044E \u043F\u0430\u043C\u044F\u0442\u043D\u0443\u044E
    \u043C\u0435\u0434\u0430\u043B\u044C.  *   **\u041A\u0443\u0440\u044C\u0435\u0437:**
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043D\u0430\u043E\u0442\u0440\u0435\u0437
    \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F! \u041E\u043D \u0437\u0430\u044F\u0432\u0438\u043B,
    \u0447\u0442\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442, \u0447\u0442\u043E\u0431\u044B
    \u0435\u0433\u043E \u043F\u043E\u0440\u0442\u0440\u0435\u0442 \u0447\u0435\u043A\u0430\u043D\u0438\u043B\u0438
    \u043D\u0430 \u0434\u0435\u043D\u044C\u0433\u0430\u0445. \u0412\u043C\u0435\u0441\u0442\u043E
    \u043C\u0435\u0434\u0430\u043B\u0438 \u043E\u043D \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B...
    \u0447\u0442\u043E\u0431\u044B \u0435\u043C\u0443 \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0438
    **\u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043C\u0435\u0434\u043D\u044B\u0439
    \u0433\u043B\u043E\u0431\u0443\u0441 \u0437\u0432\u0435\u0437\u0434\u043D\u043E\u0433\u043E
    \u043D\u0435\u0431\u0430**, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043C\u043E\u0433
    \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F,
    \u043B\u0435\u0436\u0430 \u0432 \u043F\u043E\u0441\u0442\u0435\u043B\u0438. \u041F\u043E\u0434\u0430\u0440\u043E\u043A
    \u0431\u044B\u043B \u0441\u0434\u0435\u043B\u0430\u043D, \u0438 \u044D\u0442\u043E\u0442
    \u0433\u043B\u043E\u0431\u0443\u0441 \u0441\u0442\u043E\u044F\u043B \u0443 \u0435\u0433\u043E
    \u043A\u0440\u043E\u0432\u0430\u0442\u0438 \u0434\u043E \u0441\u0430\u043C\u043E\u0439
    \u0441\u043C\u0435\u0440\u0442\u0438.  ### \U0001F4D6 8. \u0427\u0442\u0435\u043D\u0438\u0435
    \u043B\u0435\u043A\u0446\u0438\u0439 \u043D\u0435\u0431\u0443 \u0411\u0443\u0434\u0443\u0447\u0438
    \u0443\u0436\u0435 \u043F\u0440\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u043A \u043F\u043E\u0441\u0442\u0435\u043B\u0438 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B (1894\u20131897), \u043E\u043D \u043D\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u044C. *   **\u0414\u0435\u0442\u0430\u043B\u044C:**
    \u041E\u043D \u0447\u0438\u0442\u0430\u043B \u043B\u0435\u043A\u0446\u0438\u0438
    \u0443 \u0441\u0435\u0431\u044F \u0434\u043E\u043C\u0430. \u0423\u0447\u0435\u043D\u0438\u043A\u0438
    (\u0447\u0435\u043B\u043E\u0432\u0435\u043A 10\u201315) \u0441\u0438\u0434\u0435\u043B\u0438
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0435\u0433\u043E \u043A\u0440\u043E\u0432\u0430\u0442\u0438
    \u0441 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430\u043C\u0438, \u0430 \u043E\u043D,
    \u043B\u0435\u0436\u0430 \u043D\u0430 \u043F\u043E\u0434\u0443\u0448\u043A\u0430\u0445
    \u0438 \u0433\u043B\u044F\u0434\u044F \u0432 \u043F\u043E\u0442\u043E\u043B\u043E\u043A,
    \u0434\u0438\u043A\u0442\u043E\u0432\u0430\u043B \u0438\u043C \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u0435
    \u0442\u0435\u043E\u0440\u0435\u043C\u044B.  *   \u0415\u0441\u043B\u0438 \u043E\u043D
    \u0443\u0432\u043B\u0435\u043A\u0430\u043B\u0441\u044F \u0438 \u0432\u044B\u0432\u043E\u0434\u0438\u043B
    \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u043A\u0443\u044E \u0444\u043E\u0440\u043C\u0443\u043B\u0443,
    \u043E\u043D \u0432\u043E\u0434\u0438\u043B \u043F\u0430\u043B\u044C\u0446\u0435\u043C
    \u043F\u043E \u0432\u043E\u0437\u0434\u0443\u0445\u0443 \u043D\u0430\u0434 \u0441\u043E\u0431\u043E\u0439,
    \u0441\u043B\u043E\u0432\u043D\u043E \u043F\u0438\u0441\u0430\u044F \u043D\u0430
    \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0439 \u0434\u043E\u0441\u043A\u0435.
    \u0423\u0447\u0435\u043D\u0438\u043A\u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
    \u044D\u0442\u043E \xAB\u043C\u0435\u043B\u043E\u0432\u043E\u0439 \u043F\u0430\u043B\u044C\u0446\u0435\u043C\xBB,
    \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u0431\u0438\u0432\u0430\u043B\u0441\u044F
    \u0438 \u043D\u0435 \u043E\u0448\u0438\u0431\u0430\u043B\u0441\u044F \u0432 \u0434\u043B\u0438\u043D\u043D\u044B\u0445
    \u0432\u044B\u043A\u043B\u0430\u0434\u043A\u0430\u0445.  ### \U0001F37A 9. \u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0430\u044F
    \xAB\u0411\u0443\u0442\u044B\u043B\u043A\u0430 \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440\u0430\xBB
    \u0423 \u043D\u0435\u0433\u043E \u0431\u044B\u043B \u0434\u0430\u0432\u043D\u0438\u0439
    \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442 \u0441 \u043A\u043E\u043B\u043B\u0435\u0433\u043E\u0439
    \u041B\u0435\u043E\u043F\u043E\u043B\u044C\u0434\u043E\u043C \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440\u043E\u043C,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u043E\u0448\u0435\u043B \u0434\u043E
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u043E\u043D\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
    \u043A\u043B\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u043F\u0440\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0435
    \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u0445 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    *   **\u041A\u0443\u0440\u044C\u0435\u0437:** \u0420\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442,
    \u0447\u0442\u043E \u043A\u0430\u043A-\u0442\u043E \u043D\u0430 \u0431\u0430\u043D\u043A\u0435\u0442\u0435
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u043F\u043E\u0434\u043E\u0437\u0432\u0430\u043B
    \u043E\u0444\u0438\u0446\u0438\u0430\u043D\u0442\u0430 \u0438 \u0433\u0440\u043E\u043C\u043A\u043E,
    \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u044B\u0448\u0430\u043B \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440,
    \u0441\u043A\u0430\u0437\u0430\u043B: *\xAB\u041F\u0440\u0438\u043D\u0435\u0441\u0438\u0442\u0435
    \u043C\u043D\u0435 \u0431\u0443\u0442\u044B\u043B\u043A\u0443 \u0432\u0438\u043D\u0430,
    \u0442\u043E\u043B\u044C\u043A\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
    \u0431\u0435\u0437 \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B \u0432 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u043C\u0438\u043B\u043B\u0438\u043B\u0438\u0442\u0440\u043E\u0432\xBB*. (\u041D\u0430\u043C\u0435\u043A
    \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440
    \u043E\u0442\u0440\u0438\u0446\u0430\u043B \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0447\u0438\u0441\u043B\u0430). \u041A\u0440\u043E\u043D\u0435\u043A\u0435\u0440
    \u0432 \u043E\u0442\u0432\u0435\u0442 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E
    \u043F\u043E\u043A\u0438\u043D\u0443\u043B \u0437\u0430\u043B. \u042D\u0442\u043E
    \u0431\u044B\u043B \u043E\u0434\u0438\u043D \u0438\u0437 \u0440\u0435\u0434\u043A\u0438\u0445
    \u0441\u043B\u0443\u0447\u0430\u0435\u0432, \u043A\u043E\u0433\u0434\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B \u0441\u0435\u0431\u0435 \u044F\u0437\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u0443\u044E \u043A\u043E\u043B\u043A\u043E\u0441\u0442\u044C."
