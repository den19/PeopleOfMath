  achievementsRu: "\u042d\u043c\u0438\u043b\u044c \u0410\u0440\u0442\u0438\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0441\u043b\u0435\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0438 \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432\u044b\u0445\u043e\u0434\u0438\u0442
    \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u043e\u0434\u043d\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u2014 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u043d\u043e\u0432\u044b\u0435
    \u044f\u0437\u044b\u043a\u0438 \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432
    \u0438 \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0432\u0430\u043b
    \u0446\u0435\u043b\u044b\u0435 \u0442\u0435\u043e\u0440\u0438\u0438. \u0415\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u043a\u0430\u043a \u043d\u043e\u0432\u0430\u0442\u043e\u0440, \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\n\U0001F4DC \u0417\u0430\u043a\u043e\u043d
    \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438 \u0410\u0440\u0442\u0438\u043d\u0430:
    \u0432\u0435\u043d\u0435\u0446 \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u0435\u0439
    \u043a\u043b\u0430\u0441\u0441\u043e\u0432 \u042d\u0442\u043e, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \"\u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439\"
    \u0441\u0432\u043e\u0435\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b. \u0412 1927 \u0433\u043e\u0434\u0443
    \u0410\u0440\u0442\u0438\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043e\u0431\u0449\u0438\u0439
    \u0437\u0430\u043a\u043e\u043d \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u043c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u0430\u0431\u0435\u043b\u0435\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u0435\u0439 \u043a\u043b\u0430\u0441\u0441\u043e\u0432.
    \u0412 \u0447\u0435\u043c \u0435\u0433\u043e \u0441\u0443\u0442\u044c \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435?
    \u041e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435: \u042d\u0442\u043e\u0442 \u0437\u0430\u043a\u043e\u043d
    \u0441\u0442\u0430\u043b \u043a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439
    \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c \u043f\u043e\u043b\u0443\u0442\u043e\u0440\u0430\u0432\u0435\u043a\u043e\u0432\u044b\u0445
    \u043f\u043e\u0438\u0441\u043a\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u041e\u043d \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b \u0438 \u043e\u0431\u043e\u0431\u0449\u0438\u043b
    \u0432\u0441\u0435 \u0440\u0430\u043d\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435
    \u0437\u0430\u043a\u043e\u043d\u044b \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438:
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u0437\u0430\u043a\u043e\u043d
    \u0413\u0430\u0443\u0441\u0441\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u043a\u043e\u043d\u044b
    \u0434\u043b\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439 \u0431\u043e\u043b\u0435\u0435
    \u0432\u044b\u0441\u043e\u043a\u0438\u0445 \u043f\u043e\u0440\u044f\u0434\u043a\u043e\u0432,
    \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u042d\u0439\u0437\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c
    \u0438 \u041a\u0443\u043c\u043c\u0435\u0440\u043e\u043c. \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f: \u0417\u0430\u043a\u043e\u043d \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438
    \u0410\u0440\u0442\u0438\u043d\u0430 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0438 \u0438\u0437\u044f\u0449\u043d\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u043e\u0439
    \u043f\u043e\u043b\u044f (\u0435\u0433\u043e \u0438\u0434\u0435\u0430\u043b\u0430\u043c\u0438)
    \u0438 \u0435\u0433\u043e \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f\u043c\u0438
    (\u0433\u0440\u0443\u043f\u043f\u043e\u0439 \u0413\u0430\u043b\u0443\u0430). \u0413\u0440\u0443\u0431\u043e
    \u0433\u043e\u0432\u043e\u0440\u044f, \u043e\u043d \u0434\u0430\u0435\u0442 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u0435\u0446\u0435\u043f\u0442, \u043a\u0430\u043a \u043f\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u043c\u0443
    \u0447\u0438\u0441\u043b\u0443 \u0432 \u043f\u043e\u043b\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0432 \u0433\u0440\u0443\u043f\u043f\u0435 \u0413\u0430\u043b\u0443\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \"\u043f\u0435\u0440\u0435\u043c\u0435\u0448\u0438\u0432\u0430\u0435\u0442\"
    \u044d\u0442\u043e \u043f\u043e\u043b\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u043a\u0430\u043c\u043d\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b.\n\n\U0001F9E9 \u0420\u0435\u0448\u0435\u043d\u0438\u0435
    17-\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430:
    \u0440\u0430\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u044b
    \u0410\u0440\u0442\u0438\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043a\u043e\u043c\u0443 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0440\u0435\u0448\u0438\u0442\u044c
    \u0434\u0432\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0414\u0430\u0432\u0438\u0434\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u0432 1900 \u0433\u043e\u0434\u0443.
    \u0412 1927 \u0433\u043e\u0434\u0443 \u043e\u043d \u0440\u0435\u0448\u0438\u043b 17-\u044e
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443. \u0421\u0443\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b:
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u043b:
    \u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u043b\u044e\u0431\u0443\u044e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0435\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439?
    \u0420\u0435\u0448\u0435\u043d\u0438\u0435: \u0410\u0440\u0442\u0438\u043d \u0434\u0430\u043b
    \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442
    \u043d\u0430 \u044d\u0442\u043e\u0442 \u0432\u043e\u043f\u0440\u043e\u0441. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0437\u0434\u0435\u0441\u044c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0441\u0430\u043c \u0444\u0430\u043a\u0442 \u0440\u0435\u0448\u0435\u043d\u0438\u044f,
    \u0430 \u043f\u0443\u0442\u044c \u043a \u043d\u0435\u043c\u0443.\n\n\U0001F333 \u0422\u0435\u043e\u0440\u0438\u044f
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043b\u0435\u0439:
    \u043d\u043e\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0447\u0438\u0441\u043b\u0430
    \u0414\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f 17-\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u0410\u0440\u0442\u0438\u043d\u0443
    \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u043d\u043e\u0432\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e. \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u041e\u0442\u0442\u043e \u0428\u0440\u0430\u0439\u0435\u0440\u043e\u043c \u043e\u043d
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043b\u0435\u0439.
    \u041d\u043e\u0432\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434: \u041e\u043d\u0438
    \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u0441\u0442\u0440\u043e\u0439\u043d\u0443\u044e
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e, \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0441\u0442\u0430\u043b\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c \u0447\u0435\u0442\u043a\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0438 \u0438\u0437\u0443\u0447\u0438\u0442\u044c
    \u043f\u043e\u043b\u044f, \u0433\u0434\u0435 \u043c\u043e\u0436\u043d\u043e \u0432\u0432\u0435\u0441\u0442\u0438
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \"\u043f\u043e\u0440\u044f\u0434\u043a\u0430\"
    (\u0431\u043e\u043b\u044c\u0448\u0435/\u043c\u0435\u043d\u044c\u0448\u0435), \u0438 \u043f\u043e\u043b\u044f,
    \u0433\u0434\u0435 \u044d\u0442\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430). \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0410\u0440\u0442\u0438\u043d\u0443 \u0434\u0430\u0442\u044c \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0435
    \u0438 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    17-\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430.\n\n\U0001F300
    \u0422\u0435\u043e\u0440\u0438\u044f \u043a\u043e\u0441: \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u043d\u043e\u0432\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0412 1925 \u0433\u043e\u0434\u0443
    \u0410\u0440\u0442\u0438\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u043d\u043e\u0432\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u043e\u0441. \u0424\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f:
    \u041e\u043d \u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b \u043a\u043e\u0441, \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u043a\u0430\u043a \u0435\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u043c\u043e\u0436\u043d\u043e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0432 \u0432\u0438\u0434\u0435
    \u0434\u0438\u0430\u0433\u0440\u0430\u043c\u043c (\u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u043d\u0438\u0442\u0435\u0439), \u0438 \u043d\u0430\u0448\u0435\u043b \u0435\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0435
    \u0438 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0449\u0438\u0445
    \u0438 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439. \u0412\u043b\u0438\u044f\u043d\u0438\u0435:
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043a\u0430\u0437\u0430\u043b\u0430
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0442\u0435\u043e\u0440\u0438\u044e \u0433\u0440\u0443\u043f\u043f, \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e
    (\u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u0443\u0437\u043b\u043e\u0432 \u0438
    \u0437\u0430\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u0439) \u0438 \u0434\u0430\u0436\u0435
    \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u0443. \u0413\u0440\u0443\u043f\u043f\u044b
    \u043a\u043e\u0441 \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u044b
    \u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u043e\u0431\u044a\u0435\u043a\u0442\u0430\u043c\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0444\u0438\u0437\u0438\u043a\u0438,
    \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0433\u0440\u0443\u043f\u043f\u044b
    \u043a\u043e\u0441 \u0410\u0440\u0442\u0438\u043d\u0430 (\u0438\u0445 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435)
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\n\U0001F517
    \u0410\u0440\u0442\u0438\u043d\u043e\u0432\u044b \u043a\u043e\u043b\u044c\u0446\u0430 \u0438
    \u043e\u0431\u0449\u0430\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430 \u0412 1944 \u0433\u043e\u0434\u0443
    \u0410\u0440\u0442\u0438\u043d \u0432\u0432\u0435\u043b \u0432\u0430\u0436\u043d\u044b\u0439
    \u043a\u043b\u0430\u0441\u0441 \u043a\u043e\u043b\u0435\u0446, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u043e\u0441\u044f\u0442 \u0435\u0433\u043e \u0438\u043c\u044f
    \u2014 \u0430\u0440\u0442\u0438\u043d\u043e\u0432\u044b \u043a\u043e\u043b\u044c\u0446\u0430.
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u043e\u0431\u044a\u0435\u043a\u0442: \u042d\u0442\u043e \u043a\u043e\u043b\u044c\u0446\u0430,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043b\u044e\u0431\u0430\u044f \u0443\u0431\u044b\u0432\u0430\u044e\u0449\u0430\u044f
    \u0446\u0435\u043f\u043e\u0447\u043a\u0430 \u0438\u0434\u0435\u0430\u043b\u043e\u0432 \u043e\u0431\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    (\u0443\u0441\u043b\u043e\u0432\u0438\u0435 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438).
    \u041d\u0430 \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u044d\u0442\u043e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e,
    \u043d\u043e \u043e\u043d\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c. \u0420\u043e\u043b\u044c
    \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0435: \u0410\u0440\u0442\u0438\u043d\u043e\u0432\u044b
    \u043a\u043e\u043b\u044c\u0446\u0430 \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u043c \u0432 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435 \u0438 \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435, \u043e\u0431\u043e\u0431\u0449\u0430\u044f \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u043f\u043e\u043b\u044f. \u042d\u0442\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430, \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0435\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430\u043c\u0438 \u043a \u0434\u0440\u0443\u0433\u0438\u043c
    \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u043c, \u0441\u0434\u0435\u043b\u0430\u043b\u0430
    \u0435\u0433\u043e, \u043d\u0430\u0440\u044f\u0434\u0443 \u0441 \u042d\u043c\u043c\u0438
    \u041d\u0451\u0442\u0435\u0440, \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043e\u0431\u0449\u0435\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b.\n\n\U0001F4DA \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0438 \u044d\u043a\u0441\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0430
    \u041f\u043e\u043c\u0438\u043c\u043e \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u0410\u0440\u0442\u0438\u043d
    \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c
    \u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0415\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438
    \u0438 \u043a\u043d\u0438\u0433\u0438, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a
    \"\u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\",
    \"\u0422\u0435\u043e\u0440\u0438\u044f \u0413\u0430\u043b\u0443\u0430\", \"\u0422\u0435\u043e\u0440\u0438\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0447\u0438\u0441\u0435\u043b\",
    \u0446\u0435\u043d\u0438\u043b\u0438\u0441\u044c \u0437\u0430 \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u0443\u044e
    \u044f\u0441\u043d\u043e\u0441\u0442\u044c, \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c
    \u0438 \u043a\u0440\u0430\u0441\u043e\u0442\u0443 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f.
    \u0428\u043a\u043e\u043b\u0430 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432: \u041e\u043d
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b 34 \u0434\u043e\u043a\u0442\u043e\u0440\u0430
    \u043d\u0430\u0443\u043a, \u0441\u0440\u0435\u0434\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0442\u0430\u043a\u0438\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043a\u0430\u043a \u0421\u0435\u0440\u0436 \u041b\u0435\u043d\u0433 \u0438 \u0414\u0436\u043e\u043d
    \u0422\u0435\u0439\u0442. \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435:
    \u0415\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044b \u043a \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u0432\u0430\u043d \u0434\u0435\u0440 \u0412\u0430\u0440\u0434\u0435\u043d\u0430
    \"\u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\".
    \u0412\u043a\u043b\u0430\u0434 \u042d\u043c\u0438\u043b\u044f \u0410\u0440\u0442\u0438\u043d\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0431\u043e\u0440
    \u0442\u0435\u043e\u0440\u0435\u043c, \u0430 \u0446\u0435\u043b\u0430\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435: \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435
    \u043a \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0438, \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044e
    \u0438 \u043f\u043e\u0438\u0441\u043a\u0443 \u0441\u0430\u043c\u044b\u0445 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0445
    \u0438 \u044f\u0441\u043d\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432."
  achievementsEn: "Emil Artin left a deep mark on mathematics, and his contributions extend far beyond one field. He didn't just solve complex problems - he created new languages ​​for describing mathematical objects and rethought entire theories. His key achievements, in which he acted as an innovator, can be divided into several fundamental areas. \n\n📜 Artin's Law of Reciprocity: The Crown of Class Field Theory This is by far his most famous achievement, which he called the “pinnacle” of his career. In 1927, Artin proved the general law of reciprocity, which became the central result of Abelian class field theory. What is its essence and significance? Summary: This law was the culmination of more than a century and a half of research by mathematicians. He combined and generalized all previously known reciprocity laws: Gauss's quadratic law, as well as laws for powers of higher orders discovered by Eisenstein and Kummer. Fundamental Principle: Artin's Law of Reciprocity establishes a deep and elegant connection between the arithmetic of a field (its ideals) and its symmetries (the Galois group). Roughly speaking, it gives a universal recipe for how to use a prime number in a field to construct an element in the Galois group that “mixes” this field in a certain way. This discovery became one of the cornerstones of modern algebraic number theory. \n\n🧩 Solution to Hilbert's 17th problem: quadratic decomposition Artin was one of the few mathematicians who managed to solve two of David Hilbert's famous problems posed in 1900. In 1927, he solved the 17th problem. The essence of the problem: Hilbert asked: can any rational function of several variables, which takes only non-negative values, be represented as a sum of squares of rational functions? Solution: Artin gave a positive answer to this question. However, the main thing here is not just the fact of the decision itself, but the path to it. \n\n🌳 Real field theory: a new look at numbers To solve Hilbert's 17th problem, Artin needed to create a new theory. Together with Otto Schreier, he developed the theory of real fields. New approach: They created a coherent axiomatic theory, within the framework of which it became possible to clearly define and study fields where the concept of “order” (more/less) can be introduced, and fields where this is not possible (for example, complex numbers). This allowed Artin to give an elegant and rigorous proof of Hilbert's 17th problem.🌀 Braid theory: the birth of a new field In 1925, Artin founded a completely new field of mathematics - braid theory. Formalization: He gave a strict definition of the braid group, showed how its elements can be represented in the form of diagrams (intertwined threads), and found its simple and elegant definition using generators and relations. Impact: This work had a huge impact on group theory, topology (the study of knots and links), and even physics. Braid groups are closely related to fundamental objects of modern mathematics and physics, such as Artin braid groups (their generalization) and representation theory. \n\n🔗 Artinian rings and general algebra In 1944, Artin introduced an important class of rings that now bear his name - Artinian rings. Fundamental object: These are rings in which any decreasing chain of ideals breaks off (minimality condition). This may seem like an abstract property, but it has proven incredibly fruitful. Role in algebra: Artinian rings have become a fundamental object in abstract algebra and commutative algebra, generalizing finite-dimensional algebras and fields. This work, together with his approaches to other areas, made him, along with Emmy Noether, one of the founders of modern general algebra. \n\n📚 Legacy of a teacher and expositor In addition to his original research, Artin was an outstanding teacher and popularizer of mathematics. His lectures and books, such as “Geometric Algebra”, “Galois Theory”, “The Theory of Algebraic Numbers”, were valued for their extraordinary clarity, rigor and beauty of presentation. School of students: He trained 34 doctors of science, including such famous mathematicians as Serge Lang and John Tate. Influence on teaching: His approaches to the presentation of algebra had a significant influence on van der Waerden's famous textbook, Modern Algebra. Emil Artin's contribution is not just a set of theorems, but a whole philosophy in mathematics: the desire for abstraction, generalization and the search for the most elegant and clear proofs."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u042d\u043c\u0438\u043b\u044f
    \u0410\u0440\u0442\u0438\u043d\u0430, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0435\u0433\u043e \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c\u0438 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044f\u043c\u0438
    \u0438 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u043c\u0438, \u0442\u0435\u0441\u043d\u043e
    \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u043d\u044b\u043c\u0438 \u0441
    \u0431\u0443\u0440\u043d\u043e\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439 XX
    \u0432\u0435\u043a\u0430.\n\n\U0001F494 \u0422\u044f\u0436\u0435\u043b\u043e\u0435 \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0443\u0442\u0440\u0430\u0442\u044b \u0415\u0433\u043e
    \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0431\u044b\u043b\u043e \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u043e
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439. \u041e\u0442\u0435\u0446, \u042d\u043c\u0438\u043b\u044c
    \u0410\u0440\u0442\u0438\u043d-\u0441\u0442\u0430\u0440\u0448\u0438\u0439, \u0437\u0430\u0440\u0430\u0437\u0438\u043b\u0441\u044f
    \u0441\u0438\u0444\u0438\u043b\u0438\u0441\u043e\u043c, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u043c\u0443 \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0443. \u0412 1904 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u043f\u043e\u043c\u0435\u0449\u0435\u043d \u0432 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043b\u0435\u0447\u0435\u0431\u043d\u0438\u0446\u0443, \u0433\u0434\u0435 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 1906 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u043c\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e
    \u0432\u043e\u0441\u0435\u043c\u044c \u043b\u0435\u0442. \u041c\u0430\u0442\u044c, \u042d\u043c\u043c\u0430,
    \u0431\u044b\u0432\u0448\u0430\u044f \u043f\u0435\u0432\u0438\u0446\u0430 \u043e\u043f\u0435\u0440\u0435\u0442\u0442\u044b,
    \u0432\u0441\u043a\u043e\u0440\u0435 \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436
    \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u2014 \u0437\u0430 \u043f\u0440\u0435\u0443\u0441\u043f\u0435\u0432\u0430\u044e\u0449\u0435\u0433\u043e
    \u0444\u0430\u0431\u0440\u0438\u043a\u0430\u043d\u0442\u0430 \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0430
    \u0425\u044e\u0431\u043d\u0435\u0440\u0430, \u0438 \u0441\u0435\u043c\u044c\u044f \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430
    \u0432 \u0420\u0430\u0439\u0445\u0435\u043d\u0431\u0435\u0440\u0433 (\u043d\u044b\u043d\u0435
    \u041b\u0438\u0431\u0435\u0440\u0435\u0446 \u0432 \u0427\u0435\u0445\u0438\u0438).\n\n\U0001F49E
    \u0411\u0440\u0430\u043a \u0441 \u041d\u0430\u0442\u0430\u0448\u0435\u0439 \u042f\u0441\u043d\u043e\u0439:
    \u043b\u044e\u0431\u043e\u0432\u044c \u0438 \u043e\u0431\u0449\u0435\u0435 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u0412 1929 \u0433\u043e\u0434\u0443 \u0410\u0440\u0442\u0438\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041d\u0430\u0442\u0430\u043b\u0438 (\u041d\u0430\u0442\u0430\u0448\u0435)
    \u041d\u0430\u0443\u043c\u043e\u0432\u043d\u0435 \u042f\u0441\u043d\u043e\u0439, \u043c\u043e\u043b\u043e\u0434\u043e\u0439
    \u044d\u043c\u0438\u0433\u0440\u0430\u043d\u0442\u043a\u0435 \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043a\u043e\u0439.
    \u0423 \u043d\u0438\u0445 \u0431\u044b\u043b\u043e \u043c\u043d\u043e\u0433\u043e \u043e\u0431\u0449\u0438\u0445
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432, \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0441\u0438\u043b\u044c\u043d\u044b\u0445 \u0431\u044b\u043b\u0430
    \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f. \u0410\u0440\u0442\u0438\u043d
    \u043a\u0443\u043f\u0438\u043b \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u043a\u0430\u043c\u0435\u0440 Leica, \u0438 \u043e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u0446\u0435\u043b\u0443\u044e \u0441\u0435\u0440\u0438\u044e
    \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043e\u0432
    \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 \u0438 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438. \u0418\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0435
    \u0444\u043e\u0442\u043e\u0440\u0430\u0431\u043e\u0442\u044b \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u044b \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u043c\u0438
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430 \u0438 \u0434\u0430\u0436\u0435 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438\u0441\u044c
    \u0432 \u043c\u0443\u0437\u0435\u0435 \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0435.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0421\u0435\u043c\u044c\u044f \u0438 \u0434\u0435\u0442\u0438 \u0423 \u042d\u043c\u0438\u043b\u044f
    \u0438 \u041d\u0430\u0442\u0430\u0448\u0438 \u0431\u044b\u043b\u043e \u0442\u0440\u043e\u0435
    \u0434\u0435\u0442\u0435\u0439: \u041a\u0430\u0440\u0438\u043d (\u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0432 \u044f\u043d\u0432\u0430\u0440\u0435 1933 \u0433\u043e\u0434\u0430). \u041c\u0430\u0439\u043a\u043b
    (\u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043b\u0435\u0442\u043e\u043c 1934 \u0433\u043e\u0434\u0430).
    \u041e\u043d \u043f\u043e\u0448\u0435\u043b \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c
    \u043e\u0442\u0446\u0430 \u0438 \u0441\u0442\u0430\u043b \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u043c\u0441\u044f
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0422\u043e\u043c\u0430\u0441 (\u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 1938 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435 \u0432 \u0421\u0428\u0410). \u0414\u043e\u0447\u044c
    \u041a\u0430\u0440\u0438\u043d \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436
    \u0437\u0430 \u0414\u0436\u043e\u043d\u0430 \u0422\u0435\u0439\u0442\u0430, \u0443\u0447\u0435\u043d\u0438\u043a\u0430
    \u042d\u043c\u0438\u043b\u044f \u0410\u0440\u0442\u0438\u043d\u0430 \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b.\n\n\U0001F6A9 \u0416\u0438\u0437\u043d\u044c
    \u043f\u043e\u0434 \u043f\u0440\u0438\u0446\u0435\u043b\u043e\u043c \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u043e\u0433\u043e
    \u0440\u0435\u0436\u0438\u043c\u0430 \u0411\u0440\u0430\u043a \u0441 \u041d\u0430\u0442\u0430\u0448\u0435\u0439,
    \u0438\u043c\u0435\u0432\u0448\u0435\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0443\u044e \u0441\u0443\u0434\u044c\u0431\u0443
    \u0410\u0440\u0442\u0438\u043d\u0430 \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438.
    \u0421 \u043f\u0440\u0438\u0445\u043e\u0434\u043e\u043c \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u0438\u0445 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u043e\u0441\u044c \u0432\u0441\u0435 \u0431\u043e\u043b\u0435\u0435
    \u0448\u0430\u0442\u043a\u0438\u043c. \u0421\u0430\u043c \u0410\u0440\u0442\u0438\u043d
    \u043d\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u043b \u0441\u0432\u043e\u0435\u0433\u043e
    \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u043a \u0440\u0435\u0436\u0438\u043c\u0443, \u0437\u0430 \u0447\u0442\u043e \u0435\u0433\u043e
    \u0434\u0430\u0436\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u043b\u0438
    \u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0431\u044b\u0442\u044c
    \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u0435\u0435 \u0432 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445
    \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u044f\u0445. \u041f\u043e
    \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c \u041d\u0430\u0442\u0430\u0448\u0438,
    \u0437\u0430 \u0438\u0445 \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u043e\u0439 \u0432\u0435\u043b\u043e\u0441\u044c
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435, \u0438 \u0438\u043c \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c
    \u0436\u0438\u0442\u044c \u0441 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435\u043c \u0441\u043b\u0435\u0436\u043a\u0438.
    \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u043e\u043d\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b\u0438
    \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0443\u0445\u0430
    \u0438 \u0434\u0430\u0436\u0435 \"\u0438\u0433\u0440\u0430\u043b\u0438\" \u0441\u043e \u0441\u0432\u043e\u0438\u043c
    \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u0435\u043b\u0435\u043c, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044f\u0441\u044c
    \u043d\u0430 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438,
    \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044f \u0435\u0433\u043e \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c
    \u0437\u0430 \u043d\u0438\u043c\u0438. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043f\u043e\u043f\u044b\u0442\u043a\u0438 \u043a\u043e\u043b\u043b\u0435\u0433,
    \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0413\u0435\u043b\u044c\u043c\u0443\u0442\u0430
    \u0425\u0430\u0441\u0441\u0435, \u043f\u043e\u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e, \u0432 1937 \u0433\u043e\u0434\u0443 \u0410\u0440\u0442\u0438\u043d
    \u0431\u044b\u043b \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d \u0432 \u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0443 \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438
    \u0441 \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u0438\u043c\u0438 \u0440\u0430\u0441\u043e\u0432\u044b\u043c\u0438
    \u0437\u0430\u043a\u043e\u043d\u0430\u043c\u0438. \u0412 \u043e\u043a\u0442\u044f\u0431\u0440\u0435
    1937 \u0433\u043e\u0434\u0430 \u0441\u0435\u043c\u044c\u044f \u0410\u0440\u0442\u0438\u043d\u043e\u0432
    \u0431\u044b\u043b\u0430 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u0430 \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0432 \u0421\u0428\u0410.\n\n\U0001F1FA\U0001F1F8 \u0416\u0438\u0437\u043d\u044c \u0432
    \u0410\u043c\u0435\u0440\u0438\u043a\u0435, \u0440\u0430\u0437\u0432\u043e\u0434 \u0438
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0412 \u0421\u0428\u0410
    \u0410\u0440\u0442\u0438\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0418\u043d\u0434\u0438\u0430\u043d\u044b, \u0430 \u0437\u0430\u0442\u0435\u043c \u0432
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435. \u0412 1958 \u0433\u043e\u0434\u0443
    \u0438\u0445 \u0431\u0440\u0430\u043a \u0441 \u041d\u0430\u0442\u0430\u0448\u0435\u0439
    \u0440\u0430\u0441\u043f\u0430\u043b\u0441\u044f, \u0438 \u043e\u043d\u0438 \u0440\u0430\u0437\u0432\u0435\u043b\u0438\u0441\u044c.
    \u041d\u0430\u0442\u0430\u0448\u0430 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436 \u0437\u0430 \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0430
    \u041c\u0430\u0440\u043a\u0430 \u0411\u0440\u0430\u043d\u0441\u0443\u0438\u043a\u0430. \u0421\u0430\u043c
    \u0410\u0440\u0442\u0438\u043d \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0440\u0430\u0437\u0432\u043e\u0434\u0430 \u043d\u0430\u0447\u0430\u043b \u0431\u043b\u0438\u0437\u043a\u0438\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0425\u0435\u043b\u044c \u0411\u0440\u0430\u0443\u043d,
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0438 \u043e\u043d\u0438 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430\u043c\u0438
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438
    \u0432 1962 \u0433\u043e\u0434\u0443."
  personalLifeEn: "Emil Artin's personal life, despite his reputation as a strict scientist, was filled with deep loyalties and dramatic turns, closely intertwined with the turbulent history of the 20th century. \n\n💔 Difficult childhood and early losses His childhood was overshadowed by tragedy. The father, Emil Artin Sr., contracted syphilis, which led to a serious mental disorder. In 1904, he was placed in a psychiatric hospital, where he died in 1906, when the future mathematician was only eight years old. His mother, Emma, ​​a former operetta singer, soon remarried to the successful manufacturer Rudolf Hübner, and the family moved to Reichenberg (now Liberec in the Czech Republic). \n\n💞 Marriage to Natasha Yasnaya: love and common passion In 1929, Artin married Natalie (Natasha) Naumovna Yasnaya, a young emigrant from Russia who was his student. They had many common interests, one of the strongest being photography. Artin bought one of the first Leica cameras, and together they created a whole series of wonderful portraits of each other and the life around them. Their joint photographic works were subsequently recognized as works of art and were even exhibited in a museum in Hamburg. \n\n👨‍👩‍👧‍👦 Family and children Emil and Natasha had three children: Karin (born in January 1933). Michael (born summer 1934). He followed in his father's footsteps and became a world-famous mathematician, specializing in algebraic geometry. Thomas (born in 1938, already in the USA). Daughter Karin married John Tate, a student of Emil Artin and an outstanding mathematician in the field of number theory. \n\n🚩 Life under the gun of the Nazi regime Marriage to Natasha, who was of Jewish origin, determined Artin’s future fate in Germany. As the Nazis came to power, their position became increasingly precarious. Artin himself did not hide his negative attitude towards the regime, for which he was even warned about the need to be more careful in public statements. According to Natasha’s recollections, their apartment was under surveillance, and they had to live with the feeling of being watched. However, they maintained their presence of mind and even \"played\" with their observer by going on long walks, forcing him to follow them. Despite efforts by colleagues, including Helmut Hasse, to influence the situation, Artin was forced into forced retirement in 1937 under Nazi racial laws. In October 1937, the Artin family was forced to emigrate to the United States.🇺🇸 Life in America, divorce, and later years In the USA, Artin worked at Indiana University and then at Princeton. In 1958, his marriage to Natasha fell apart, and they divorced. Natasha later married the composer Mark Brunswick. Artin himself soon after the divorce began a close relationship with Hel Braun, a woman mathematician, and they remained partners until his death in 1962."
  shortBioRu: "\u042d\u043c\u0438\u043b\u044c \u0410\u0440\u0442\u0438\u043d (1898\u20131962) \u0431\u044b\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2013 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0433\u043e
    \u0443\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0441\u0446\u0432\u0435\u043b
    \u0432 \u0431\u0443\u0440\u043d\u044b\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0432\u043e\u0439\u043d
    \u0438 \u0438\u0434\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u0442\u0440\u044f\u0441\u0435\u043d\u0438\u0439, \u0430 \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0432\u0445\u043e\u0434\u0438\u0442 \u0432 \u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u0444\u043e\u043d\u0434
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\U0001F4DC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u043e\u0435
    \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u042d\u043c\u0438\u043b\u044c \u0410\u0440\u0442\u0438\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 3 \u043c\u0430\u0440\u0442\u0430 1898 \u0433\u043e\u0434\u0430
    \u0432 \u0412\u0435\u043d\u0435, \u0432 \u0441\u0435\u043c\u044c\u0435, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439
    \u0441 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0435\u043c
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430
    \u0438, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c,
    \u043f\u0435\u0432\u0446\u043e\u043c, \u0430 \u043c\u0430\u0442\u044c \u2014 \u043f\u0435\u0432\u0438\u0446\u0435\u0439
    \u043e\u043f\u0435\u0440\u0435\u0442\u0442\u044b. \u0412 1906 \u0433\u043e\u0434\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u042d\u043c\u0438\u043b\u044e \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e
    \u0432\u043e\u0441\u0435\u043c\u044c \u043b\u0435\u0442, \u0435\u0433\u043e \u043e\u0442\u0435\u0446
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f. \u0412\u0441\u043a\u043e\u0440\u0435
    \u043c\u0430\u0442\u044c \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436 \u0432\u043e
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437, \u0438 \u0441\u0435\u043c\u044c\u044f
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u0432 \u0420\u0430\u0439\u0445\u0435\u043d\u0431\u0435\u0440\u0433
    \u0432 \u0411\u043e\u0433\u0435\u043c\u0438\u0438 (\u043d\u044b\u043d\u0435 \u041b\u0438\u0431\u0435\u0440\u0435\u0446
    \u0432 \u0427\u0435\u0445\u0438\u0438), \u0433\u0434\u0435 \u043e\u0442\u0447\u0438\u043c
    \u0432\u043b\u0430\u0434\u0435\u043b \u0442\u0435\u043a\u0441\u0442\u0438\u043b\u044c\u043d\u044b\u043c
    \u0431\u0438\u0437\u043d\u0435\u0441\u043e\u043c. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u043f\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0410\u0440\u0442\u0438\u043d \u0431\u044b\u043b \u0430\u0432\u0441\u0442\u0440\u0438\u0439\u0446\u0435\u043c
    \u0441 \u0430\u0440\u043c\u044f\u043d\u0441\u043a\u0438\u043c\u0438 \u043a\u043e\u0440\u043d\u044f\u043c\u0438.
    \u0421\u0432\u043e\u044e \u0444\u0430\u043c\u0438\u043b\u0438\u044e \u043e\u043d \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u043e\u0442 \u0434\u0435\u0434\u0430, \u0430\u0440\u043c\u044f\u043d\u0441\u043a\u043e\u0433\u043e
    \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0430 \u043a\u043e\u0432\u0440\u0430\u043c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0435\u0440\u0435\u0431\u0440\u0430\u043b\u0441\u044f
    \u0432 \u0412\u0435\u043d\u0443. \u041f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0435\u0433\u043e
    \u0441\u044b\u043d\u0430, \u041c\u0430\u0439\u043a\u043b\u0430, \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f
    \u0444\u0430\u043c\u0438\u043b\u0438\u044f \u0431\u044b\u043b\u0430 \u00ab\u0410\u0440\u0442\u0438\u043d\u044f\u043d\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043e\u0437\u0436\u0435 \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u043b\u0438.
    \u0412 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0435 \u0433\u043e\u0434\u044b \u0410\u0440\u0442\u0438\u043d
    \u043d\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0415\u0433\u043e \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e
    \u0431\u044b\u043b\u0430 \u0445\u0438\u043c\u0438\u044f, \u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u0442\u044c
    \u0435\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0441 16 \u043b\u0435\u0442. \u0412\u043f\u0440\u043e\u0447\u0435\u043c,
    \u044d\u0442\u043e \u043d\u0435 \u043f\u043e\u043c\u0435\u0448\u0430\u043b\u043e \u0435\u043c\u0443
    \u0432 1916 \u0433\u043e\u0434\u0443 \u0441 \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c
    \u043e\u043a\u043e\u043d\u0447\u0438\u0442\u044c \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u0447\u0438\u043b\u0438\u0449\u0435.\n\n\U0001F393 \u041f\u0443\u0442\u044c \u043a
    \u043d\u0430\u0443\u043a\u0435: \u0412\u0435\u043d\u0430, \u0432\u043e\u0439\u043d\u0430
    \u0438 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d \u0412 1916 \u0433\u043e\u0434\u0443
    \u0410\u0440\u0442\u0438\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0412\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u043e\u0434\u043d\u0430\u043a\u043e
    \u043f\u0440\u043e\u0443\u0447\u0438\u043b\u0441\u044f \u0442\u0430\u043c \u0432\u0441\u0435\u0433\u043e
    \u043e\u0434\u0438\u043d \u0441\u0435\u043c\u0435\u0441\u0442\u0440. \u0412 \u0440\u0430\u0437\u0433\u0430\u0440
    \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0435\u0433\u043e \u043f\u0440\u0438\u0437\u0432\u0430\u043b\u0438 \u0432 \u0430\u0432\u0441\u0442\u0440\u0438\u0439\u0441\u043a\u0443\u044e
    \u0430\u0440\u043c\u0438\u044e, \u0438 \u0434\u043e 1918 \u0433\u043e\u0434\u0430 \u043e\u043d
    \u0441\u043b\u0443\u0436\u0438\u043b \u043d\u0430 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u043e\u043c
    \u0444\u0440\u043e\u043d\u0442\u0435. \u041f\u043e\u0441\u043b\u0435 \u0434\u0435\u043c\u043e\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u0432 1919 \u0433\u043e\u0434\u0443 \u0410\u0440\u0442\u0438\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0433\u0434\u0435
    \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0441\u0442\u0430\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0413\u0443\u0441\u0442\u0430\u0432 \u0425\u0435\u0440\u0433\u043b\u043e\u0446. \u0412
    1921 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441 \u0431\u043b\u0435\u0441\u043a\u043e\u043c
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0443\u044e
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0445
    \u043f\u043e\u043b\u0435\u0439. \u0417\u0430\u0442\u0435\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0432\u0430\u0436\u043d\u044b\u0439 \u0434\u043b\u044f
    \u0435\u0433\u043e \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0433\u043e\u0434 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u2014 \u043c\u0438\u0440\u043e\u0432\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0422\u0430\u043c
    \u043e\u043d \u0441\u043b\u0443\u0448\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438 \u0414\u0430\u0432\u0438\u0434\u0430
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u0438 \u0420\u0438\u0447\u0430\u0440\u0434\u0430
    \u041a\u0443\u0440\u0430\u043d\u0442\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043d\u0430\u0447\u0430\u043b
    \u0442\u0435\u0441\u043d\u043e\u0435 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u042d\u043c\u043c\u0438 \u041d\u0451\u0442\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u043d\u0430 \u043d\u0435\u0433\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435.\n\n\U0001F3EB \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0438 \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430
    \u0412 1922 \u0433\u043e\u0434\u0443 \u0410\u0440\u0442\u0438\u043d \u043d\u0430\u0447\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c,
    \u0430 \u0432\u0441\u043a\u043e\u0440\u0435 \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0431\u0443\u0434\u0435\u0442 \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u0438. \u0412 1925 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b
    \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c,
    \u0430 \u0432 1926 \u2014 \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c.
    \u042d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u0442\u0430\u043b\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0434\u043b\u044f
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b.
    \u0414\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0435 \u0441 1921 \u043f\u043e
    1931 \u0433\u043e\u0434, \u043a\u0430\u043a \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438, \u0441\u0442\u0430\u043b\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043c
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u0440\u0435\u0434\u043a\u043e
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u0432 \u0436\u0438\u0437\u043d\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0410\u0440\u0442\u0438\u043d\u0430
    \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u0438\u043c\u0435\u043d\u043d\u043e
    \u043a \u044d\u0442\u043e\u043c\u0443 \u043f\u0435\u0440\u0438\u043e\u0434\u0443: \u0422\u0435\u043e\u0440\u0438\u044f
    \u043f\u043e\u043b\u0435\u0439: \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441
    \u041e\u0442\u0442\u043e \u0428\u0440\u0430\u0439\u0435\u0440\u043e\u043c \u0410\u0440\u0442\u0438\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043f\u043e\u043b\u0435\u0439 \u0438 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e-\u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043f\u043e\u043b\u0435\u0439. \u041d\u0430 \u0435\u0435 \u043e\u0441\u043d\u043e\u0432\u0435
    \u0432 1927 \u0433\u043e\u0434\u0443 \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    17-\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u043b\u0430,
    \u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u043b\u044e\u0431\u0443\u044e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u0443\u044e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043a\u0430\u043a \u0441\u0443\u043c\u043c\u0443 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432.
    \u0422\u0435\u043e\u0440\u0438\u044f \u043a\u043e\u0441: \u0412 1925 \u0433\u043e\u0434\u0443
    \u0410\u0440\u0442\u0438\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u043d\u043e\u0432\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u043e\u0441, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043d\u0430\u0448\u043b\u0430 \u0448\u0438\u0440\u043e\u043a\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0443\u043f\u043f. \u0422\u0435\u043e\u0440\u0438\u044f \u043f\u043e\u043b\u0435\u0439
    \u043a\u043b\u0430\u0441\u0441\u043e\u0432 \u0438 \u0437\u0430\u043a\u043e\u043d \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438:
    \u0412\u0435\u0440\u0448\u0438\u043d\u043e\u0439 \u0435\u0433\u043e \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430
    \u0441\u0442\u0430\u043b\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043e\u0431\u0449\u0435\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u0430 \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438
    (\u043d\u044b\u043d\u0435 \u0437\u0430\u043a\u043e\u043d \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438
    \u0410\u0440\u0442\u0438\u043d\u0430), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0431\u043e\u0431\u0449\u0438\u043b
    \u0432\u0441\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0440\u0430\u043d\u0435\u0435
    \u0437\u0430\u043a\u043e\u043d\u044b \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438,
    \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 \u0440\u0430\u0431\u043e\u0442 \u0413\u0430\u0443\u0441\u0441\u0430.
    \u042d\u0442\u043e\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0441\u0442\u0430\u043b
    \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u043e\u043b\u0435\u0439 \u043a\u043b\u0430\u0441\u0441\u043e\u0432. \u0410\u0440\u0442\u0438\u043d\u043e\u0432\u044b
    \u043a\u043e\u043b\u044c\u0446\u0430: \u0412 1944 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0432\u0432\u0435\u043b \u0432\u0430\u0436\u043d\u044b\u0439 \u043a\u043b\u0430\u0441\u0441
    \u043a\u043e\u043b\u0435\u0446, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0445 \u0432
    \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c \u0430\u0440\u0442\u0438\u043d\u043e\u0432\u044b\u043c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u043c \u0432 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435.\n\n\U0001F30A \u042d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f
    \u0432 \u0421\u0428\u0410 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0443 \u041f\u0440\u0438\u0445\u043e\u0434 \u043a
    \u0432\u043b\u0430\u0441\u0442\u0438 \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432 \u0432
    1933 \u0433\u043e\u0434\u0443 \u043a\u0440\u0443\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b
    \u0436\u0438\u0437\u043d\u044c \u0410\u0440\u0442\u0438\u043d\u0430. \u0425\u043e\u0442\u044f
    \u0441\u0430\u043c \u043e\u043d \u043d\u0435 \u0431\u044b\u043b \u0435\u0432\u0440\u0435\u0435\u043c,
    \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u041d\u0430\u0442\u0430\u0448\u0430 (\u041d\u0430\u0442\u0430\u043b\u0438)
    \u042f\u0441\u043d\u0430\u044f, \u0434\u043e\u0447\u044c \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u0430
    \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0438, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432 1929 \u0433\u043e\u0434\u0443,
    \u0438\u043c\u0435\u043b\u0430 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435.
    \u0412 1937 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0443\u0436\u0435\u0441\u0442\u043e\u0447\u0435\u043d\u0438\u044f
    \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0441\u043a\u0438\u0445 \u0437\u0430\u043a\u043e\u043d\u043e\u0432,
    \u043e\u043d \u0431\u044b\u043b \u0443\u0432\u043e\u043b\u0435\u043d \u0438\u0437 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0438 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432 \u0421\u0428\u0410.
    \u0412 \u0410\u043c\u0435\u0440\u0438\u043a\u0435 \u0410\u0440\u0442\u0438\u043d \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0418\u043d\u0434\u0438\u0430\u043d\u044b
    (1938\u20131946), \u0430 \u0437\u0430\u0442\u0435\u043c \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (1946\u20131958).
    \u0415\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438 \u0438 \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u044b
    \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
