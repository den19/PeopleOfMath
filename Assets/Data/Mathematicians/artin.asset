    \u0441\u0432\u043e\u0435\u0439 \u0448\u043a\u043e\u043b\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0433\u0440\u043e\u043c\u043a\u0438\u043c
    \u0441\u043e\u0431\u044b\u0442\u0438\u0435\u043c! \u041b\u0438\u0448\u044c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    16 \u043b\u0435\u0442, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0432\u043b\u0438\u044f\u043d\u0438\u044e
    \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f,
    \u043e\u043d \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f
