    \u0433\u0440\u043e\u0441\u0441\u043c\u0435\u0439\u0441\u0442\u0435\u0440 \u0432 \u0443\u0437\u043a\u043e\u043c
    \u043a\u0440\u0443\u0433\u0443 \u0410\u0440\u0442\u0438\u043d \u0431\u044b\u043b \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u044b\u043c
    \u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0448\u0430\u0445\u043c\u0430\u0442\u0438\u0441\u0442\u043e\u043c.
    \u0412 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0435 \u043e\u043d \u0447\u0430\u0441\u0442\u043e
    \u0438\u0433\u0440\u0430\u043b \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438
    \u0438 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0430\u043c\u0438 \u043f\u0440\u044f\u043c\u043e
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u043f\u0440\u0438\u0447\u0435\u043c
    \u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u0441 \u0442\u0430\u043a\u0438\u043c
    \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e\u043c, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0438\u0433\u0440\u0443 \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b\u0438 \u0441
    \u0438\u0433\u0440\u043e\u0439 \u0433\u0440\u043e\u0441\u0441\u043c\u0435\u0439\u0441\u0442\u0435\u0440\u0430.
    \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u0435\u0433\u043e \u043f\u0430\u0440\u0442\u0438\u0438 \u0441 \u041e\u0442\u0442\u043e
    \u0428\u0440\u0430\u0439\u0435\u0440\u043e\u043c, \u0438\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f
    \u0438\u0433\u0440\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0434\u043e\u0441\u0443\u0433\u043e\u043c, \u0430 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0434\u0443\u044d\u043b\u044c\u044e.\n\n\U0001F575\ufe0f \u0418\u0433\u0440\u044b \u0441
    \u0433\u0435\u0441\u0442\u0430\u043f\u043e \u0412 \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u043e\u0439
    \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438 \u0438\u0445 \u0441\u0435\u043c\u044c\u044f
    \u0436\u0438\u043b\u0430 \u043f\u043e\u0434 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439
    \u0443\u0433\u0440\u043e\u0437\u043e\u0439 \u0438\u0437-\u0437\u0430 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0436\u0435\u043d\u044b
    \u041d\u0430\u0442\u0430\u0448\u0438. \u041f\u043e \u0435\u0435 \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c,
    \u043e\u043d\u0438 \u0437\u043d\u0430\u043b\u0438, \u0447\u0442\u043e \u0437\u0430 \u0438\u0445
    \u0434\u043e\u043c\u043e\u043c \u0432\u0435\u0434\u0435\u0442\u0441\u044f \u0441\u043b\u0435\u0436\u043a\u0430.
    \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b
    \u0432\u043f\u0430\u0434\u0430\u0442\u044c \u0432 \u043f\u0430\u043d\u0438\u043a\u0443,
    \u043e\u043d\u0438 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0438 \u044d\u0442\u043e
    \u0432 \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u0443\u044e \u0438\u0433\u0440\u0443:
    \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u043b\u0438\u0441\u044c \u043d\u0430 \u0434\u043e\u043b\u0433\u0438\u0435
    \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438, \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044f
    \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f,
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0431\u044b\u043b\u043e \u0442\u044f\u0436\u0435\u043b\u043e
    \u0438\u0434\u0442\u0438, \u0442\u0430\u0449\u0438\u0442\u044c\u0441\u044f \u0437\u0430
    \u043d\u0438\u043c\u0438 \u043c\u043d\u043e\u0433\u043e \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u043e\u0432.\n\n\U0001F4AC
    \u0410\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0447\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c \u0410\u0440\u0442\u0438\u043d \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439 \u043d\u0435\u043f\u043e\u0434\u043a\u0443\u043f\u043d\u043e\u0439
    \u0447\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c\u044e \u0432 \u043d\u0430\u0443\u043a\u0435.
    \u041e\u043d \u043c\u043e\u0433 \u043f\u0440\u0435\u0440\u0432\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u044e
    \u0438 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c:
    \"\u0412\u044b \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0432\u0435\u0440\u0438\u0442\u044c
    \u043d\u0438 \u043e\u0434\u043d\u043e\u043c\u0443 \u043c\u043e\u0435\u043c\u0443 \u0441\u043b\u043e\u0432\u0443,
    \u043f\u043e\u043a\u0430 \u044f \u043d\u0435 \u0434\u043e\u043a\u0430\u0436\u0443 \u044d\u0442\u043e\".
    \u041e\u043d \u043f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0441\u044f
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u044d\u0442\u043e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0430\u044f \u0438\u0441\u0442\u0438\u043d\u0430,
    \u0438 \u043d\u0435 \u0442\u0435\u0440\u043f\u0435\u043b \u043d\u0438 \u043c\u0430\u043b\u0435\u0439\u0448\u0435\u0433\u043e
    \u043d\u0430\u043c\u0435\u043a\u0430 \u043d\u0430 \u043c\u043e\u0448\u0435\u043d\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0438\u043b\u0438 \u043d\u0435\u0434\u043e\u043c\u043e\u043b\u0432\u043a\u0443.\n\n\U0001F4DA
    \"\u041f\u0438\u043e\u043d\u0435\u0440\" \u041b\u0435\u043a\u0446\u0438\u0439 \u0415\u0433\u043e
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0431\u044b\u043b\u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b.
    \u041e\u043d \u043c\u043e\u0433 \u043f\u0440\u0438\u0439\u0442\u0438 \u043d\u0430 \u0437\u0430\u043d\u044f\u0442\u0438\u044f
    \u0431\u0435\u0437 \u0435\u0434\u0438\u043d\u043e\u0433\u043e \u043b\u0438\u0441\u0442\u0430
    \u0431\u0443\u043c\u0430\u0433\u0438 \u0438, \u0437\u0430\u0434\u0430\u0432 \u043b\u0438\u0448\u044c
    \u043e\u0434\u0438\u043d \u0432\u043e\u043f\u0440\u043e\u0441 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438,
    \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0447\u0430\u0441\u043e\u0432\u0443\u044e
    \u043b\u0435\u043a\u0446\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0438 \u044f\u0441\u043d\u043e\u0439, \u0447\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u0438
    \u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u043b\u0438, \u043a\u0430\u043a \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438\u0441\u044c \u0434\u043b\u044f \u043d\u0438\u0445
    \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u043c\u0438. \u0417\u0430 \u044d\u0442\u043e
    \u0435\u0433\u043e \u043f\u0440\u043e\u0437\u0432\u0430\u043b\u0438 \"\u043f\u0435\u0432\u0446\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\", \u0442\u0430\u043a \u043a\u0430\u043a
    \u0435\u0433\u043e \u0433\u043e\u043b\u043e\u0441 \u0438 \u043c\u0430\u043d\u0435\u0440\u0430
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b
    \u0438 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b.\n\n\U0001F30D
    \"\u0411\u043b\u0443\u0434\u043d\u044b\u0439 \u0441\u044b\u043d\" \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u041f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u043e\u043d
    \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0413\u0430\u043c\u0431\u0443\u0440\u0433 \u0432
    1937 \u0433\u043e\u0434\u0443, \u043e\u043d \u043e\u0447\u0435\u043d\u044c \u0442\u043e\u0441\u043a\u043e\u0432\u0430\u043b
    \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0443\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443
    \u0432 \u0421\u0428\u0410 (\u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435),
    \u0432 1958 \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043f\u0440\u0438\u043d\u044f\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433
    \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u0442\u0430\u043c
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438. \u0413\u043e\u0432\u043e\u0440\u044f\u0442,
    \u0435\u0433\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u043b\u0430 \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0431\u043e\u0442\u0430, \u043d\u043e
    \u0438 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u0430\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430
    \u0441\u0442\u0430\u0440\u043e\u0433\u043e \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.\n\n\U0001F9EC
    \u0414\u0438\u043d\u0430\u0441\u0442\u0438\u044f \u0433\u0435\u043d\u0438\u0435\u0432 \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u043e \u0442\u0430\u043b\u0430\u043d\u0442 \u0410\u0440\u0442\u0438\u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u043b\u0441\u044f
    \u043f\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0443. \u0415\u0433\u043e
    \u0441\u044b\u043d, \u041c\u0430\u0439\u043a\u043b \u0410\u0440\u0442\u0438\u043d, \u0441\u0442\u0430\u043b
    \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041c\u0430\u0442\u044c \u041c\u0430\u0439\u043a\u043b\u0430
    \u2014 \u041d\u0430\u0442\u0430\u0448\u0430 \u2014 \u0448\u0443\u0442\u0438\u043b\u0430,
    \u0447\u0442\u043e \u0432 \u0434\u043e\u043c\u0435 \u0431\u044b\u043b\u043e \u0434\u0432\u0430
    \"\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u043e\u043d\u0441\u0442\u0440\u0430\":
    \u043e\u0442\u0435\u0446 \u0438 \u0441\u044b\u043d. \u042d\u0442\u0438 \u0444\u0430\u043a\u0442\u044b
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442, \u0447\u0442\u043e \u042d\u043c\u0438\u043b\u044c
    \u0410\u0440\u0442\u0438\u043d \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \"\u0441\u0443\u0445\u0438\u043c \u0443\u0447\u0435\u043d\u044b\u043c\", \u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441 \u0436\u0438\u0432\u044b\u043c, \u044f\u0440\u043a\u0438\u043c \u0438 \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u044b\u043c
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c."
  interestingFactsEn: "Emil Artin's life and work are full of amazing contrasts and unexpected details that make his personality even more attractive. Here are some interesting and entertaining facts about him that go beyond the strict biographical information. \n\n👨‍🔬 Chemistry instead of mathematics: a youthful hobby Few people know that during his school years Artin was much more passionate about chemistry than mathematics. He conducted chemical experiments and even caused a small explosion in his school's chemistry laboratory, which became quite a big event! Only at the age of 16, thanks to the influence of a school teacher, did he become seriously interested in mathematics. \n\n📸 An outstanding amateur photographer, Artin was not just passionate about photography - he was a real master, whose works are recognized as valuable documents of the time. In 1930, he bought one of the first Leica cameras and, together with his wife Natasha, created a collection of photographs that is highly valued today. Among his photographs are portraits of such luminaries of mathematics as Albert Einstein, David Hilbert and Emmy Noether. These photographs not only record history, but also demonstrate his artistic eye. \n\n♟ Chess grandmaster in a narrow circle Artin was a passionate and strong chess player. In Hamburg, he often played with mathematicians and assistants right at the university, and did it with such skill that his game was compared to the game of a grandmaster. His games with Otto Schreyer are especially famous; their joint play was not just leisure, but an intellectual duel. \n\n🕵️ Games with the Gestapo In Nazi Germany, their family lived under constant threat due to the Jewish origin of their wife Natasha. According to her recollections, they knew that their house was being monitored. Instead of panicking, they turned it into a kind of game: they went for long walks, forcing their pursuer, who had difficulty walking, to trail behind them for many kilometers. \n\n💬 Absolute mathematical honesty Artin was known for his incorruptible honesty in science. He would interrupt a lecture and tell the students, “You must not believe a word I say until I prove it.” He adhered to the principle that mathematics is an absolute truth, and did not tolerate the slightest hint of fraud or omission.📚 \"Pioneer\" Lectures His lectures were legendary. He could show up to class without a single sheet of paper and, with just one question from the audience, give an hour-long lecture that was so structured and clear that the audience did not notice how complex abstract concepts became clear to them. For this, he was nicknamed the “singer of mathematics”, as his voice and manner of presentation were musical and captivating. \n\n🌍 The \"Prodigal Son\" of Mathematics After he left Hamburg in 1937, he was very homesick for Europe. Despite a brilliant career in the USA (at Princeton), in 1958 he unexpectedly decided to return to Hamburg and teach there for the rest of his life. They say that he was attracted not only by his work, but also by the special atmosphere of the old European university. \n\n🧬 Dynasty of geniuses Surprisingly, Artin’s talent was inherited. His son, Michael Artin, became a world famous mathematician and one of the leading experts in the field of algebraic geometry. Michael's mother, Natasha, joked that there were two \"math monsters\" in the house: father and son. These facts show that Emil Artin was not just a “dry scientist”, but a person with a lively, bright and multifaceted character."
