    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0448\u043a\u043e\u043b\u0443.
    \u0421\u0440\u0435\u0434\u0438 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u2014 \u0442\u0430\u043a\u0438\u0435 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u0430\u043a \u0421\u0435\u0440\u0436
    \u041b\u0435\u043d\u0433, \u0414\u0436\u043e\u043d \u0422\u0435\u0439\u0442 \u0438 \u0425\u0430\u043d\u0441
    \u0426\u0430\u0441\u0441\u0435\u043d\u0445\u0430\u0443\u0441. \u0412 1958 \u0433\u043e\u0434\u0443
    \u0410\u0440\u0442\u0438\u043d \u043f\u0440\u0438\u043d\u044f\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433,
    \u0433\u0434\u0435 \u0438 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043e
    \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438 20 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1962 \u0433\u043e\u0434\u0430.\n\n\U0001F9EC \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u042d\u043c\u0438\u043b\u044c
    \u0410\u0440\u0442\u0438\u043d, \u043d\u0430\u0440\u044f\u0434\u0443 \u0441 \u042d\u043c\u043c\u0438
    \u041d\u0451\u0442\u0435\u0440, \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u0415\u0433\u043e \u0438\u0434\u0435\u0438
    \u0438 \u043c\u0435\u0442\u043e\u0434\u044b \u043b\u0435\u0436\u0430\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432
    \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u0442\u0440\u0443\u0434\u044b
    \u0432\u043e\u0448\u043b\u0438 \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u00ab\u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u00bb \u0411\u0430\u0440\u0442\u0430 \u0432\u0430\u043d
    \u0434\u0435\u0440 \u0412\u0430\u0440\u0434\u0435\u043d\u0430. \u041e\u043d \u0431\u044b\u043b
    \u0438\u0437\u0431\u0440\u0430\u043d \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u044f \u0410\u0440\u0442\u0438\u043d\u043e\u0432
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b\u0430\u0441\u044c \u0438 \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0438: \u0435\u0433\u043e \u0441\u044b\u043d,
    \u041c\u0430\u0439\u043a\u043b \u0410\u0440\u0442\u0438\u043d, \u0442\u0430\u043a\u0436\u0435
    \u0441\u0442\u0430\u043b \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u043c
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438."
  shortBioEn: "Emil Artin (1898–1962) was one of the leading mathematicians of the 20th century, whose work laid the foundations of modern algebra. His life is the story of a brilliant mind that flourished in turbulent times of war and ideological upheaval, and his scientific legacy is included in the golden fund of world mathematics. \n\n📜 Early years and difficult childhood Emil Artin was born on March 3, 1898 in Vienna, into a family associated with art. His father was an art dealer and, according to some sources, a singer, and his mother was an operetta singer. In 1906, when Emil was only eight years old, his father died. Soon the mother remarried and the family moved to Reichenberg in Bohemia (now Liberec in the Czech Republic), where the stepfather owned a textile business. It is interesting that Artin was an Austrian by nationality with Armenian roots. He inherited his surname from his grandfather, an Armenian carpet merchant who moved to Vienna. According to his son, Michael, the original surname was \"Artinian\", which was later shortened. During his school years, Artin did not show outstanding abilities in mathematics. His true passion was chemistry, and mathematics began to interest him only at the age of 16. However, this did not prevent him from graduating from a real school with honors in 1916. \n\n🎓 The path to science: Vienna, war and Göttingen In 1916, Artin entered the University of Vienna, but studied there for only one semester. At the height of the First World War he was drafted into the Austrian army and served on the Italian front until 1918. After demobilization in 1919, Artin continued his education at the University of Leipzig, where the famous mathematician Gustav Herglotz became his mentor. In 1921, he brilliantly defended his doctoral dissertation on the arithmetic of quadratic fields. This was followed by an extremely important year for his formation at the University of Göttingen, the world center of mathematics at that time. There he listened to lectures by David Gilbert and Richard Courant, and also began a close collaboration with Emmy Noether, who had a huge influence on him.🏫 The Hamburg period and the flowering of creativity In 1922, Artin began working as an assistant, and soon as a professor at the University of Hamburg, with which most of his life would be connected. In 1925 he became extraordinary, and in 1926 - ordinary professor. This time became incredibly fruitful for his scientific career. The decade from 1921 to 1931, as colleagues noted, was a period of activity rarely encountered in the life of a mathematician. Artin's main achievements date specifically to this period: Field theory: Together with Otto Schreyer, Artin created the theory of real fields and formal real fields. Based on this, in 1927 he solved Hilbert's famous 17th problem, which asked whether any positive definite rational function can be expressed as a sum of squares. Braid theory: In 1925, Artin founded an entirely new field of mathematics, braid theory, which found wide application in topology and group theory. Class field theory and the law of reciprocity: The pinnacle of his work was the proof of the general law of reciprocity (now Artin's law of reciprocity), which generalized all previously known laws of reciprocity, starting with the work of Gauss. This result became central to class field theory. Artinian rings: In 1944, he introduced an important class of rings, called Artinian rings in his honor, which became a fundamental object in abstract algebra. \n\n🌊 Emigration to the USA and return to Europe The Nazis' coming to power in 1933 dramatically changed Artin's life. Although he himself was not Jewish, his wife Natasha (Natalie) Yasnaya, the daughter of a Russian economist, whom he married in 1929, was of Jewish descent. In 1937, after the tightening of anti-Semitic laws, he was fired from the University of Hamburg and forced to emigrate to the United States. In America, Artin taught at Indiana University (1938–1946) and then at Princeton University (1946–1958). His lectures and seminars had a huge impact on the American mathematical school. Among his students are such outstanding mathematicians as Serge Lang, John Tate and Hans Zassenhaus. In 1958, Artin decided to return to Hamburg, where he worked until his death on December 20, 1962.🧬 Legacy and Recognition Emil Artin, along with Emmy Noether, is rightfully considered one of the founders of modern abstract algebra. His ideas and methods form the basis of the most important areas of this science. His works were included in the classic textbook \"Modern Algebra\" by Bartel van der Waerden. He was elected an honorary member of the London Mathematical Society. The Artin scientific dynasty continued in the next generation: his son, Michael Artin, also became a world-famous mathematician, specializing in algebraic geometry."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u042d\u043c\u0438\u043b\u044f
    \u0410\u0440\u0442\u0438\u043d\u0430 \u043f\u043e\u043b\u043d\u044b \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432 \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0445
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0435\u0449\u0435 \u0431\u043e\u043b\u0435\u0435
    \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439.
    \u0412\u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0445
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432
    \u043e \u043d\u0435\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u0445\u043e\u0434\u044f\u0442
    \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u0441\u0442\u0440\u043e\u0433\u0438\u0445 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u0430\u043d\u043d\u044b\u0445.\n\n\U0001F468\u200d\U0001F52C \u0425\u0438\u043c\u0438\u044f
    \u0432\u043c\u0435\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438:
    \u044e\u043d\u043e\u0448\u0435\u0441\u043a\u043e\u0435 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u041c\u0430\u043b\u043e \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e
    \u0432 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0435 \u0433\u043e\u0434\u044b \u0410\u0440\u0442\u0438\u043d
    \u0431\u044b\u043b \u043a\u0443\u0434\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0443\u0432\u043b\u0435\u0447\u0435\u043d
    \u0445\u0438\u043c\u0438\u0435\u0439, \u0447\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u041e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u043f\u044b\u0442\u044b \u0438 \u0434\u0430\u0436\u0435 \u0443\u0441\u0442\u0440\u043e\u0438\u043b
