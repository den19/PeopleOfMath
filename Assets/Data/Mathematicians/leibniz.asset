  achievementsRu: "\u0413\u043e\u0442\u0444\u0440\u0438\u0434 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u0437\u043d\u0430\u043d\u0438\u044f. \u0415\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434 \u043d\u0435 \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f
    \u043a \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u043c
    \u2014 \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u043e\u043f\u044b\u0442\u043a\u0430
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0435\u0434\u0438\u043d\u0443\u044e, \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0445\u0432\u0430\u0442\u0438\u043b\u0430
    \u0431\u044b \u0432\u0441\u0435 \u0430\u0441\u043f\u0435\u043a\u0442\u044b \u043c\u0438\u0440\u043e\u0437\u0434\u0430\u043d\u0438\u044f.
    \u0412\u043e\u0442 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u0438 \u0442\u0440\u0443\u0434\u043e\u0432
    \u043f\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u043c.\n\n\u2797
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u044f\u0437\u044b\u043a\u0430, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043d\u0430\u0443\u043a\u0430 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u2014 \u044d\u0442\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0441\u0442\u043e\u0438\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u043d\u0430\u0443\u043a\u0430. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0437\u0434\u0435\u0441\u044c:
    \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u043e\u043a\u043e\u043b\u043e 1675 \u0433\u043e\u0434\u0430,
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0418\u0441\u0430\u0430\u043a\u0430
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430. \u041e\u0434\u043d\u0430\u043a\u043e \u0438\u043c\u0435\u043d\u043d\u043e
    \u043d\u043e\u0442\u0430\u0446\u0438\u044f \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    (\u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b
    `\u222b` \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u0430\u044f `dy/dx`)
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u0434\u043e\u0431\u043d\u043e\u0439, \u0447\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0438 \u043f\u043e \u0441\u0435\u0439 \u0434\u0435\u043d\u044c. \u0421\u0432\u043e\u0438
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0432 1684 \u0433\u043e\u0434\u0443, \u043d\u0430 \u0442\u0440\u0438 \u0433\u043e\u0434\u0430
    \u0440\u0430\u043d\u044c\u0448\u0435 \u041d\u044c\u044e\u0442\u043e\u043d\u0430, \u0447\u0442\u043e
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u043c\u0443 \u0441\u043f\u043e\u0440\u0443
    \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u043c\u0435\u0436\u0434\u0443
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u043a\u043e\u043d\u0442\u0438\u043d\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0415\u0432\u0440\u043e\u043f\u044b \u0438 \u0410\u043d\u0433\u043b\u0438\u0438. \u0414\u0432\u043e\u0438\u0447\u043d\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f:
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u044d\u0442\u0443 \u0441\u0438\u0441\u0442\u0435\u043c\u0443,
    \u043d\u043e \u0438 \u0432\u0438\u0434\u0435\u043b \u0432 \u043d\u0435\u0439 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u043c\u044b\u0441\u043b,
    \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u0443\u044f `1` \u0441 \u0411\u043e\u0433\u043e\u043c,
    \u0430 `0` \u0441 \u043f\u0443\u0441\u0442\u043e\u0442\u043e\u0439. \u042d\u0442\u043e\u0442
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f, \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0439
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432, \u0441\u0442\u0430\u043b
    \u0435\u0449\u0435 \u043e\u0434\u043d\u0438\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c
    \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043d\u0438\u044f.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0435\u0451 \u0434\u043b\u044f \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u0432 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0441\u0432\u043e\u0435\u0433\u043e \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u0430.
    \u0410\u0440\u0438\u0444\u043c\u043e\u043c\u0435\u0442\u0440 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430:
    \u0412 1673 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0447\u0435\u0442\u043d\u0443\u044e \u043c\u0430\u0448\u0438\u043d\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u043c.
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u0430
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f, \u043c\u0430\u0448\u0438\u043d\u0430 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u0443\u043c\u0435\u043b\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c
    \u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u0442\u044c, \u043d\u043e \u0438 \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c,
    \u0434\u0435\u043b\u0438\u0442\u044c \u0438 \u0438\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c
    \u043a\u043e\u0440\u043d\u0438 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u043d\u043e\u043c\u0443
    \u0438\u043c \u0441\u0442\u0443\u043f\u0435\u043d\u0447\u0430\u0442\u043e\u043c\u0443 \u0432\u0430\u043b\u0438\u043a\u0443
    (\u043a\u043e\u043b\u0435\u0441\u043e \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430).
    \u042d\u0442\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435 \u043e\u043d
    \u043b\u0438\u0447\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u043c \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435.\n\n\u269b\ufe0f \u0424\u0438\u0437\u0438\u043a\u0430:
    \u041e\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u043a \u044d\u043d\u0435\u0440\u0433\u0438\u0438
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u043d\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438, \u0431\u0440\u043e\u0441\u0438\u0432 \u0432\u044b\u0437\u043e\u0432
    \u0433\u043e\u0441\u043f\u043e\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0435\u0439
    \u0442\u043e\u0433\u0434\u0430 \u043a\u0430\u0440\u0442\u0435\u0437\u0438\u0430\u043d\u0441\u043a\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435: \u0414\u0438\u043d\u0430\u0301\u043c\u0438\u043a\u0430
    \u0438 \"\u0436\u0438\u0432\u0430\u044f \u0441\u0438\u043b\u0430\": \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u043d\u043e\u0432\u0443\u044e \u043d\u0430\u0443\u043a\u0443
    \u2014 \u0434\u0438\u043d\u0430\u0301\u043c\u0438\u043a\u0443, \u043d\u0430\u0443\u043a\u0443
    \u043e \u0441\u0438\u043b\u0435, \u0438 \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \"\u0436\u0438\u0432\u043e\u0439 \u0441\u0438\u043b\u044b\" (vis viva), \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432
    \u0435\u0435 \u043a\u0430\u043a \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u043c\u0430\u0441\u0441\u044b \u043d\u0430 \u043a\u0432\u0430\u0434\u0440\u0430\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438
    (`mv\u00b2`). \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0439
    \u043c\u0435\u0440\u043e\u0439 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u0430
    \u043d\u0435 \"\u043c\u0435\u0440\u0442\u0432\u0430\u044f \u0441\u0438\u043b\u0430\" \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    (`mv`), \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0437\u0430\u043a\u043e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \"\u0436\u0438\u0432\u044b\u0445 \u0441\u0438\u043b\". \u042d\u0442\u043e \u0431\u044b\u043b\u0430
    \u043e\u0434\u043d\u0430 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043e\u043a
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438. \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f: \u0418\u0441\u0445\u043e\u0434\u044f \u0438\u0437
    \u0441\u0432\u043e\u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u0430
    \u043c\u0438\u0440\u0430, \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e\u0442 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043f\u0440\u0438\u0440\u043e\u0434\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c.\n\n\U0001F4A1
    \u041b\u043e\u0433\u0438\u043a\u0430 \u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f:
    \u041c\u0435\u0447\u0442\u0430 \u043e \u0432\u0441\u0435\u043e\u0431\u0449\u0435\u0439 \u043d\u0430\u0443\u043a\u0435
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u0441 \u0435\u0433\u043e \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435\u043c
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434 \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f: \"\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u044f
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430\" \u0438
    \"\u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439\":
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u043c\u0435\u0447\u0442\u043e\u0439
    \u0431\u044b\u043b\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b
    \u0431\u044b \u0441\u0432\u0435\u0441\u0442\u0438 \u043b\u044e\u0431\u043e\u0435 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435
    \u043a \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c. \u041e\u043d
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b \u0438\u0434\u0435\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f, \u0447\u0442\u043e \u0432 \u0441\u043f\u043e\u0440\u0435
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430\u043c \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0431\u044b\u043b\u043e \u0431\u044b \"\u0432\u0437\u044f\u0442\u044c \u0432 \u0440\u0443\u043a\u0438
    \u043f\u0435\u0440\u044c\u044f, \u0441\u0435\u0441\u0442\u044c \u0437\u0430 \u0441\u0432\u043e\u0438
    \u0441\u0447\u0435\u0442\u043d\u044b\u0435 \u0434\u043e\u0441\u043a\u0438 \u0438 \u0441\u043a\u0430\u0437\u0430\u0442\u044c
    \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443: \u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u0435\u043c!\". \u0412 \u0440\u0430\u043d\u043d\u0435\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \"\u041e\u0431 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435
    \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438\" (1666)
    \u043e\u043d \u0443\u0436\u0435 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u044d\u0442\u043e\u0439 \u0438\u0434\u0435\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u043d\u0430 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432. \u0414\u0432\u0430 \u0442\u0438\u043f\u0430
    \u0438\u0441\u0442\u0438\u043d \u0438 \u0437\u0430\u043a\u043e\u043d\u044b \u043b\u043e\u0433\u0438\u043a\u0438:
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0440\u0430\u0437\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b
    \"\u0438\u0441\u0442\u0438\u043d\u044b \u0440\u0430\u0437\u0443\u043c\u0430\" (\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435
    \u0438 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u043d\u0430 \u0437\u0430\u043a\u043e\u043d\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f)
    \u0438 \"\u0438\u0441\u0442\u0438\u043d\u044b \u0444\u0430\u043a\u0442\u0430\" (\u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0435,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043d\u0430 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u0438\u043c \u0437\u0430\u043a\u043e\u043d\u0435 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f). \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043e\u0442\u0441\u0442\u0430\u0438\u0432\u0430\u043b \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f, \u0447\u0442\u043e \u0434\u0443\u0448\u0430
    \u2014 \u043d\u0435 \"\u0447\u0438\u0441\u0442\u0430\u044f \u0434\u043e\u0441\u043a\u0430\"
    (tabula rasa), \u0438 \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u043a \u0442\u0435\u0437\u0438\u0441\u0443
    \u0441\u0435\u043d\u0441\u0443\u0430\u043b\u0438\u0441\u0442\u043e\u0432 \"\u041d\u0435\u0442
    \u043d\u0438\u0447\u0435\u0433\u043e \u0432 \u0440\u0430\u0437\u0443\u043c\u0435, \u0447\u0435\u0433\u043e
    \u043f\u0440\u0435\u0436\u0434\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u044b
    \u0432 \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0445\" \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u043e\u0433\u043e\u0432\u043e\u0440\u043a\u0443: \"...\u043a\u0440\u043e\u043c\u0435 \u0441\u0430\u043c\u043e\u0433\u043e
    \u0440\u0430\u0437\u0443\u043c\u0430\".\n\n\U0001F9E0 \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    (\u041c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0430): \u041c\u043e\u043d\u0430\u0434\u044b
    \u0438 \u043f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f
    \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u044f \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u043c\u0435\u0441\u0442\u043e \u0432 \u0437\u0440\u0435\u043b\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0442
    \u0435\u0433\u043e \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b: \"\u041c\u043e\u043d\u0430\u0434\u043e\u043b\u043e\u0433\u0438\u044f\"
    (1714): \u0412 \u044d\u0442\u043e\u043c \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442
    \u043c\u0438\u0440 \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0438\u0437 \u0431\u0435\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445, \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445
    \u0438 \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0445 \u0441\u0443\u0431\u0441\u0442\u0430\u043d\u0446\u0438\u0439
    \u2014 \u043c\u043e\u043d\u0430\u0434. \u041a\u0430\u0436\u0434\u0430\u044f \u043c\u043e\u043d\u0430\u0434\u0430
    \u2014 \u044d\u0442\u043e \"\u0437\u0435\u0440\u043a\u0430\u043b\u043e \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439\",
    \u043e\u0442\u0440\u0430\u0436\u0430\u044e\u0449\u0435\u0435 \u0432\u0435\u0441\u044c \u043c\u0438\u0440
    \u0432 \u0441\u0435\u0431\u0435, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0435\u0435 \"\u043e\u043a\u043e\u043d\", \u0442\u043e
    \u0435\u0441\u0442\u044c \u043d\u0435 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u043c\u043e\u043d\u0430\u0434\u0430\u043c\u0438.
    \"\u0422\u0435\u043e\u0434\u0438\u0446\u0435\u044f\" (1710): \u0412 \u044d\u0442\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u0442\u044c \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u0437\u043b\u0430 \u0432 \u043c\u0438\u0440\u0435, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u043c
    \u0432\u0441\u0435\u0431\u043b\u0430\u0433\u0438\u043c \u0411\u043e\u0433\u043e\u043c. \u0415\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0439 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442
    \u2014 \u043d\u0430\u0448 \u043c\u0438\u0440 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \"\u043d\u0430\u0438\u043b\u0443\u0447\u0448\u0438\u043c \u0438\u0437 \u0432\u0441\u0435\u0445
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u043c\u0438\u0440\u043e\u0432\".
    \u042d\u0442\u043e\u0442 \u0442\u0435\u0437\u0438\u0441 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0431\u044b\u043b \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0432\u044b\u0441\u043c\u0435\u044f\u043d
    \u0412\u043e\u043b\u044c\u0442\u0435\u0440\u043e\u043c \u0432 \u043f\u043e\u0432\u0435\u0441\u0442\u0438
    \"\u041a\u0430\u043d\u0434\u0438\u0434\". \"\u0420\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f
    \u043e \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0435\" (1686): \u042d\u0442\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u0436\u043d\u044b\u043c
    \u044d\u0442\u0430\u043f\u043e\u043c, \u0433\u0434\u0435 \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043f\u043e\u043b\u043d\u043e
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u0441\u0432\u043e\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b.\n\n\U0001F4DC
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043d\u0435 \u0431\u044b\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435.
    \u0415\u0433\u043e \u0438\u0434\u0435\u0438 \u0447\u0430\u0441\u0442\u043e \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u044b
    \u043d\u0435 \u0432 \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u043e\u043c\u0430\u0445, \u0430 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0430\u0445 \u0438 \u043e\u0431\u0448\u0438\u0440\u043d\u043e\u0439
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435. \u041a \u0447\u0438\u0441\u043b\u0443
    \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442
    \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f: \u041e\u0431 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435
    \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438 (1666) \u041d\u043e\u0432\u0430\u044f
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    (1671) \u0420\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0435
    (1686) \u041d\u043e\u0432\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u044b
    (1695) \u041d\u043e\u0432\u044b\u0435 \u043e\u043f\u044b\u0442\u044b \u043e \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u043c
    \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u0438\u0438 (1704) \u2014 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u0442\u0440\u0443\u0434 \u0414\u0436\u043e\u043d\u0430
    \u041b\u043e\u043a\u043a\u0430 \u0422\u0435\u043e\u0434\u0438\u0446\u0435\u044f (1710) \u041c\u043e\u043d\u0430\u0434\u043e\u043b\u043e\u0433\u0438\u044f
    (1714) \u041d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u044b \u0438
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0442\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u043d\u0430 \u0440\u0430\u0437\u0443\u043c\u0435 (1714) \u0422\u0430\u043a\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0432\u043a\u043b\u0430\u0434 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043f\u0438\u0441\u043e\u043a
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439, \u0430 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u0430\u044f
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u043d\u0430\u0446\u0435\u043b\u0435\u043d\u043d\u0430\u044f
    \u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \"\u0432\u0441\u0435\u043e\u0431\u0449\u0435\u0439
    \u043d\u0430\u0443\u043a\u0438\", \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b\u0430
    \u0431\u044b \u043b\u043e\u0433\u0438\u043a\u0443, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u0444\u0438\u0437\u0438\u043a\u0443 \u0438 \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0443
    \u0432 \u0435\u0434\u0438\u043d\u0443\u044e \u0441\u0442\u0440\u043e\u0439\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b,
    \u043e\u0442 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439 \u0434\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0439, \u0441\u0442\u0430\u043b\u0438
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0438\u0445 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c."
  achievementsEn: 
  personalLifeRu: "\u0413\u043e\u0442\u0444\u0440\u0438\u0434 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043f\u0440\u043e\u0436\u0438\u043b \u0436\u0438\u0437\u043d\u044c,
    \u0446\u0435\u043b\u0438\u043a\u043e\u043c \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0443\u044e
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044e \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0443,
    \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u043e\u043b\u043d\u0430 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432:
    \u043e\u0442 \u0432\u0441\u0435\u043e\u0431\u0449\u0435\u0433\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f
    \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438 \u0434\u043e \u043f\u043e\u0447\u0442\u0438
    \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u0437\u0430\u0431\u0432\u0435\u043d\u0438\u044f
    \u0432 \u043a\u043e\u043d\u0446\u0435, \u043e\u0442 \u043e\u0431\u0448\u0438\u0440\u043d\u0435\u0439\u0448\u0435\u0439
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438 \u0434\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0433\u043e
    \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0430. \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0445\u0440\u043e\u043d\u0438\u043a\u0430 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0438.\n\n\U0001F476 \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435: \u041f\u0440\u0435\u0434\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0442\u0430\u043b\u0430\u043d\u0442\u044b \u0413\u043e\u0442\u0444\u0440\u0438\u0434
    \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 1 \u0438\u044e\u043b\u044f 1646 \u0433\u043e\u0434\u0430
    \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0435, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u0438 \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u044b
    \u0428\u043c\u0443\u043a\u043a. \u0415\u0433\u043e \u043f\u0440\u0435\u0434\u043a\u0438
    \u043f\u043e \u043e\u0442\u0446\u0443, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0438\u043c\u0435\u043b\u0438 \u0441\u043b\u0430\u0432\u044f\u043d\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u043d\u0438, \u0430 \u0444\u0430\u043c\u0438\u043b\u0438\u044f, \u043a\u0430\u043a
    \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u043d\u0435\u043c\u0435\u0447\u0435\u043d\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u043e\u0439
    \u0438\u043c\u0435\u043d\u0438 \u00ab\u041b\u0443\u0431\u0435\u043d\u0435\u0446\u00bb. \u0421
    \u043e\u0431\u0435\u0438\u0445 \u0441\u0442\u043e\u0440\u043e\u043d \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0431\u044b\u043b\u0438 \u044e\u0440\u0438\u0441\u0442\u044b \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430,
    \u0447\u0442\u043e \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043f\u0440\u0435\u0434\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u043e
    \u0435\u0433\u043e \u0431\u0443\u0434\u0443\u0449\u0438\u0435 \u0437\u0430\u043d\u044f\u0442\u0438\u044f.
    \u0421 \u0440\u0430\u043d\u043d\u0438\u043c \u0434\u0435\u0442\u0441\u0442\u0432\u043e\u043c
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u0441\u0432\u044f\u0437\u0430\u043d\u044b
    \u043f\u043e\u0447\u0442\u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439 \u0445\u0440\u043e\u043d\u0438\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u0435\u043b \u0435\u0433\u043e \u043e\u0442\u0435\u0446,
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0440\u0435\u0449\u0435\u043d\u0438\u044f
    \u043c\u043b\u0430\u0434\u0435\u043d\u0435\u0446 \u043f\u043e\u0434\u043d\u044f\u043b \u0433\u043b\u0430\u0437\u0430
    \u043a \u043f\u043e\u0442\u043e\u043b\u043a\u0443, \u0438 \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0443\u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u0432 \u044d\u0442\u043e\u043c \u0437\u043d\u0430\u043a \u0431\u0443\u0434\u0443\u0449\u0438\u0445
    \u00ab\u0441\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0439 \u0432\u0435\u0449\u0435\u0439
    \u0447\u0443\u0434\u0435\u0441\u043d\u044b\u0445\u00bb. \u041e\u0442\u0435\u0446 \u0443\u043c\u0435\u0440,
    \u043a\u043e\u0433\u0434\u0430 \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0443 \u0431\u044b\u043b\u043e
    \u0432\u0441\u0435\u0433\u043e \u0448\u0435\u0441\u0442\u044c \u043b\u0435\u0442. \u0412\u0441\u043a\u043e\u0440\u0435
    \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f
    \u0435\u0449\u0435 \u043e\u0434\u0438\u043d \u0441\u043b\u0443\u0447\u0430\u0439: \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439
    \u0413\u043e\u0442\u0444\u0440\u0438\u0434 \u0443\u043f\u0430\u043b \u0441\u043e \u0441\u0442\u043e\u043b\u0430,
    \u043d\u043e \u043e\u0442\u0434\u0435\u043b\u0430\u043b\u0441\u044f \u0441\u043c\u0435\u0445\u043e\u043c.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0431\u044b\u0432\u0448\u0438\u0439 \u0432
    \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u0434\u043e\u043c\u0430, \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u044f\u043b
    \u044d\u0442\u043e \u043a\u0430\u043a \u0411\u043e\u0436\u044c\u0435 \u043f\u0440\u043e\u0432\u0438\u0434\u0435\u043d\u0438\u0435
    \u0438 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043b \u043e\u0442\u0441\u043b\u0443\u0436\u0438\u0442\u044c
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043c\u043e\u043b\u0435\u0431\u0435\u043d. \u0423\u0432\u044b, \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u0430
    \u043e\u0442\u0446\u0430 \u043d\u0435 \u0441\u0443\u0436\u0434\u0435\u043d\u043e \u0431\u044b\u043b\u043e
    \u0441\u0431\u044b\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.
    \u041c\u0430\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u043a\u0430\u043a \u0443\u043c\u043d\u0443\u044e
    \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0443\u044e \u0436\u0435\u043d\u0449\u0438\u043d\u0443,
    \u043e\u0442\u0434\u0430\u043b\u0430 \u0441\u044b\u043d\u0430 \u0432 \u043b\u0443\u0447\u0448\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0430 \u2014 \u0448\u043a\u043e\u043b\u0443
    \u041d\u0438\u043a\u043e\u043b\u0430\u0438. \u0413\u043e\u0442\u0444\u0440\u0438\u0434 \u0440\u0430\u043d\u043e
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e
    \u0442\u044f\u0433\u0443 \u043a \u0437\u043d\u0430\u043d\u0438\u044f\u043c \u0438 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    \u041e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u0441\u0442\u0443\u043f
    \u043a \u0431\u043e\u0433\u0430\u0442\u043e\u0439 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435
    \u043e\u0442\u0446\u0430. \u0427\u0442\u043e\u0431\u044b \u0447\u0438\u0442\u0430\u0442\u044c
    \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u0435 \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043d\u0438\u0433\u0438, \u043e\u043d \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0431\u0435\u0437 \u0441\u043b\u043e\u0432\u0430\u0440\u0435\u0439, \u0432\u044b\u0443\u0447\u0438\u043b
    \u044d\u0442\u0438 \u044f\u0437\u044b\u043a\u0438. \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c \u0441\u0442\u0430\u043b\u0430 \u043a\u043d\u0438\u0433\u0430
    \u0422\u0438\u0442\u0430 \u041b\u0438\u0432\u0438\u044f \u0441 \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0430\u0446\u0438\u044f\u043c\u0438
    \u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u044f\u043c\u0438 \u043a \u043d\u0438\u043c
    \u2014 \u043f\u043e \u043d\u0438\u043c \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u043f\u043e\u0441\u0442\u0438\u0433\u0430\u0442\u044c
    \u043b\u0430\u0442\u044b\u043d\u044c, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u043a \u0447\u0442\u0435\u043d\u0438\u044e \u043a\u043b\u0430\u0441\u0441\u0438\u043a\u043e\u0432.
    \u0423\u0436\u0435 \u0432 12 \u043b\u0435\u0442 \u043e\u043d \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e
    \u0432\u043b\u0430\u0434\u0435\u043b \u043b\u0430\u0442\u044b\u043d\u044c\u044e \u0438 \u0441\u043e\u0447\u0438\u043d\u044f\u043b
    \u0441\u0442\u0438\u0445\u0438, \u0430 \u0432 14 \u043b\u0435\u0442, \u0447\u0442\u043e
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0434\u043b\u044f \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043d\u0430\u0447\u0430\u043b \u0437\u0430\u0434\u0443\u043c\u044b\u0432\u0430\u0442\u044c\u0441\u044f
    \u043e \u0440\u0435\u0444\u043e\u0440\u043c\u0435 \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438.\n\n\U0001F3DB\ufe0f \u0423\u0447\u0451\u0431\u0430
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445: \u041f\u0443\u0442\u044c
    \u043a \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e \u0412 1661 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 15 \u043b\u0435\u0442, \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043d\u0430 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442, \u043d\u043e \u0435\u0433\u043e
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u0431\u044b\u043b\u0438 \u0433\u043e\u0440\u0430\u0437\u0434\u043e
    \u0448\u0438\u0440\u0435. \u041e\u043d \u0438\u0437\u0443\u0447\u0430\u043b \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u0443 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u042f\u043a\u043e\u0431\u0430
    \u0422\u043e\u043c\u0430\u0437\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0438
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b \u0441 \u0442\u0440\u0443\u0434\u0430\u043c\u0438
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430. \u0412 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0438 \u0444\u0438\u0437\u0438\u043a\u043e\u0439, \u0447\u0438\u0442\u0430\u044f \u041a\u0435\u043f\u043b\u0435\u0440\u0430,
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430.
    \u0412 1663 \u0433\u043e\u0434\u0443, \u0447\u0442\u043e\u0431\u044b \u0443\u0433\u043b\u0443\u0431\u0438\u0442\u044c
    \u0441\u0432\u043e\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u043d\u0430\u043d\u0438\u044f, \u043e\u043d \u043d\u0430 \u043b\u0435\u0442\u043d\u0438\u0439
    \u0441\u0435\u043c\u0435\u0441\u0442\u0440 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0419\u0435\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043f\u043e\u0434
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u042d\u0440\u0445\u0430\u0440\u0434\u0430
    \u0412\u0435\u0439\u0433\u0435\u043b\u044f. \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u0431\u044b\u043b\u0430 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439:
    1663 \u0433\u043e\u0434: \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430. 1664 \u0433\u043e\u0434: \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438. \u0412 1666 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 20 \u043b\u0435\u0442, \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0439
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0439 \u0442\u0440\u0443\u0434
    \u00ab\u041e\u0431 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438\u00bb
    (De arte combinatoria), \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u0432\u043e\u0435\u0439 \u0431\u0443\u0434\u0443\u0449\u0435\u0439
    \u043c\u0435\u0447\u0442\u044b \u043e \u0432\u0441\u0435\u043e\u0431\u0449\u0435\u043c \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435. \u041a\u043e\u0433\u0434\u0430 \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0435\u043c\u0443
    \u0431\u044b\u043b\u043e \u043e\u0442\u043a\u0430\u0437\u0430\u043d\u043e. \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442. \u0420\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0441\u044c,
    \u043e\u043d \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0440\u043e\u0434\u043d\u043e\u0439
    \u0433\u043e\u0440\u043e\u0434 \u0438 \u0432 \u0442\u043e\u043c \u0436\u0435 1666 \u0433\u043e\u0434\u0443
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0410\u043b\u044c\u0442\u0434\u043e\u0440\u0444\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 (\u0432 \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433\u0435),
    \u0433\u0434\u0435 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u00ab\u041e \u0437\u0430\u043f\u0443\u0442\u0430\u043d\u043d\u044b\u0445 \u0441\u0443\u0434\u0435\u0431\u043d\u044b\u0445
    \u0434\u0435\u043b\u0430\u0445\u00bb (De casibus perplexis in jure) \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u043f\u0440\u0430\u0432\u0430.
    \u0415\u043c\u0443 \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c,
    \u043d\u043e \u041b\u0435\u0439\u0431\u043d\u0438\u0446, \u043f\u043e \u0435\u0433\u043e
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c,
    \u0438\u043c\u0435\u043b \u00ab\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0438\u043d\u044b\u0435 \u043f\u043b\u0430\u043d\u044b\u00bb.\n\n\U0001F9D1\u200d\U0001F4BC
    \u041a\u0430\u0440\u044c\u0435\u0440\u0430: \u041d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435
    \u0443 \u043a\u043d\u044f\u0437\u0435\u0439 \u0438 \u043d\u0430 \u043d\u0438\u0432\u0435
    \u043d\u0430\u0443\u043a\u0438 \u041e\u0442\u043a\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044c
    \u043e\u0442 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b, \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u043d\u0430 \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0441\u043b\u0443\u0436\u0431\u0443.
    \u041c\u0430\u0439\u043d\u0446\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    (1667\u20131672): \u041f\u0435\u0440\u0432\u044b\u0435 \u0448\u0430\u0433\u0438 \u0412 1667
    \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0431\u0430\u0440\u043e\u043d\u043e\u043c \u0418\u043e\u0433\u0430\u043d\u043d\u043e\u043c
    \u041a\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u043c \u0444\u043e\u043d \u0411\u043e\u0439\u043d\u0435\u0431\u0443\u0440\u0433\u043e\u043c,
    \u0431\u044b\u0432\u0448\u0438\u043c \u043c\u0438\u043d\u0438\u0441\u0442\u0440\u043e\u043c
    \u043c\u0430\u0439\u043d\u0446\u0441\u043a\u043e\u0433\u043e \u043a\u0443\u0440\u0444\u044e\u0440\u0441\u0442\u0430,
    \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043a \u043d\u0435\u043c\u0443
    \u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0443. \u0412 \u041c\u0430\u0439\u043d\u0446\u0435
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0440\u0435\u0444\u043e\u0440\u043c\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430,
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e-\u043f\u0440\u0430\u0432\u043e\u0432\u044b\u043c\u0438
    \u0438 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u0438\u043c\u0438 \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c\u0438.
    \u041f\u0430\u0440\u0438\u0436 \u0438 \u041b\u043e\u043d\u0434\u043e\u043d (1672\u20131676):
    \u0421\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0433\u0435\u043d\u0438\u044f
    \u0412 1672 \u0433\u043e\u0434\u0443 \u0441 \u0432\u0430\u0436\u043d\u043e\u0439 \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0438\u0441\u0441\u0438\u0435\u0439 (\u043f\u043b\u0430\u043d \u043e\u0442\u0432\u043b\u0435\u0447\u044c
    \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0430 XIV \u043e\u0442 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445
    \u0437\u0435\u043c\u0435\u043b\u044c) \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u041f\u0430\u0440\u0438\u0436. \u042d\u0442\u0430 \u043f\u043e\u0435\u0437\u0434\u043a\u0430
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u043d\u0435\u0443\u0434\u0430\u0447\u043d\u043e\u0439
    \u0432 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043f\u043b\u0430\u043d\u0435,
    \u043d\u043e \u0441\u0442\u0430\u043b\u0430 \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0439
    \u0434\u043b\u044f \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f.
    \u0412 \u041f\u0430\u0440\u0438\u0436\u0435 \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0438 \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441
    \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u043c \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u043e\u043c,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0441 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430\u043c\u0438
    \u0410\u043d\u0442\u0443\u0430\u043d\u043e\u043c \u0410\u0440\u043d\u043e \u0438 \u041d\u0438\u043a\u043e\u043b\u044f
    \u041c\u0430\u043b\u044c\u0431\u0440\u0430\u043d\u0448\u0435\u043c. \u041e\u0431\u0449\u0435\u043d\u0438\u0435
    \u0441 \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u043e\u043c \u0432\u044b\u044f\u0432\u0438\u043b\u043e
    \u043f\u0440\u043e\u0431\u0435\u043b\u044b \u0432 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u0438 \u043f\u043e\u0434\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u043e
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u043a \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c
    \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c. \u0412 1673 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u043e\u0435\u0437\u0434\u043a\u0443
    \u0432 \u041b\u043e\u043d\u0434\u043e\u043d \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u043c\u0443 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0443
    \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u0438\u043c \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043c\u0430\u0448\u0438\u043d\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043c\u043e\u0433\u043b\u0430
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c
    \u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u0442\u044c, \u043d\u043e \u0438 \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c,
    \u0434\u0435\u043b\u0438\u0442\u044c \u0438 \u0438\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c
    \u043a\u043e\u0440\u043d\u0438. \u042d\u0442\u043e \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e
    \u0435\u043c\u0443 \u0437\u0432\u0430\u043d\u0438\u0435 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0433\u043e
    \u0447\u043b\u0435\u043d\u0430 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0418\u043c\u0435\u043d\u043d\u043e \u0432
    \u041f\u0430\u0440\u0438\u0436\u0435, \u0432 1675 \u0433\u043e\u0434\u0443, \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443
    \u043e\u0441\u043d\u043e\u0432 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u041e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u041d\u044c\u044e\u0442\u043e\u043d\u0430, \u043d\u043e \u0435\u0433\u043e
    \u043d\u043e\u0442\u0430\u0446\u0438\u044f \u0438 \u043c\u0435\u0442\u043e\u0434\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c
    \u0431\u043e\u043b\u0435\u0435 \u0443\u0434\u043e\u0431\u043d\u044b\u043c\u0438 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438
    \u0432\u0441\u0435\u043e\u0431\u0449\u0435\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435.
    \u041d\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u043c \u043f\u0443\u0442\u0438 \u0432
    \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440 \u0432 1676 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u0441\u0435\u0442\u0438\u043b \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u044e
    \u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b\u0441\u044f \u0432 \u0413\u0430\u0430\u0433\u0435
    \u0441 \u0411\u0435\u043d\u0435\u0434\u0438\u043a\u0442\u043e\u043c \u0421\u043f\u0438\u043d\u043e\u0437\u043e\u0439,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u0442\u0430\u043a\u0436\u0435 \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u043d\u0430 \u043d\u0435\u0433\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u0435. \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440
    (1676\u20131716): \u0417\u0440\u0435\u043b\u043e\u0441\u0442\u044c \u0438 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e
    \u0421 1676 \u0433\u043e\u0434\u0430 \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0441\u043b\u0443\u0436\u0438\u043b
    \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435 \u0433\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0441\u043a\u0438\u0445
    \u0433\u0435\u0440\u0446\u043e\u0433\u043e\u0432, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u044f
    \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430\u0440\u044f,
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430 \u044e\u0441\u0442\u0438\u0446\u0438\u0438
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043e\u0433\u0440\u0430\u0444\u0430. \u042d\u0442\u043e
    \u0431\u044b\u043b \u043f\u0435\u0440\u0438\u043e\u0434 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438. \u041e\u043d:
    \u0417\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439
    \u0434\u043e\u043c\u0430 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u043e\u0432,
    \u0434\u043b\u044f \u0447\u0435\u0433\u043e \u0432 1687\u20131690 \u0433\u043e\u0434\u0430\u0445
    \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u043f\u043e \u042e\u0436\u043d\u043e\u0439 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438,
    \u0410\u0432\u0441\u0442\u0440\u0438\u0438 \u0438 \u0418\u0442\u0430\u043b\u0438\u0438.
    \u041e\u0441\u043d\u043e\u0432\u0430\u043b \u0438 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0443\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e
    \u043d\u0430\u0443\u043a (\u0432 1700 \u0433\u043e\u0434\u0443). \u0412\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0441\u044f
    \u0441 \u041f\u0435\u0442\u0440\u043e\u043c I (\u0432 1711, 1712 \u0438 1716 \u0433\u043e\u0434\u0430\u0445)
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u043f\u0440\u043e\u0435\u043a\u0442\u044b \u0440\u0435\u0444\u043e\u0440\u043c \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u043d\u0430\u0443\u043a\u0438
    \u0438 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043b\u0435\u0433\u043b\u0438
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u0431\u044b\u043b\u0438 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u044b.
    \u041f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u0435\u0433\u043e
    \u0433\u0435\u0440\u0446\u043e\u0433 \u0441\u0442\u0430\u043b \u043a\u043e\u0440\u043e\u043b\u0435\u043c
    \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u0438 \u0413\u0435\u043e\u0440\u0433\u043e\u043c
    I, \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u0431\u044b\u043b\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043f\u0440\u0438
    \u0434\u0432\u043e\u0440\u0435. \u041e\u043d \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0435, \u0430 \u0435\u0433\u043e
    \u0440\u043e\u043b\u044c \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043e\u0441\u043f\u0430\u0440\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0432 \u0445\u043e\u0434\u0435 \u0437\u0430\u0442\u044f\u0436\u043d\u043e\u0433\u043e \u0438
    \u0433\u043e\u0440\u044c\u043a\u043e\u0433\u043e \u0441\u043f\u043e\u0440\u0430 \u0441 \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c.\n\n\U0001FAC2
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442
    \u0438, \u0441\u0443\u0434\u044f \u043f\u043e \u0432\u0441\u0435\u043c\u0443, \u043d\u0435
    \u0438\u043c\u0435\u043b \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u0440\u043e\u043c\u0430\u043d\u043e\u0432.
    \u0412\u0441\u044f \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430 \u043d\u0430\u0443\u043a\u0435, \u0438
    \u0438\u043c\u0435\u043d\u043d\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e.
    \u0415\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u0431\u044b\u043b\u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438
    \u0438 \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u044b\u043c\u0438: \u041d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0438:
    \u041e\u043d \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0441\u043a\u0430\u043b \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439
    \u0438 \u043d\u0430\u0448\u0435\u043b \u0438\u0445 \u0432 \u043b\u0438\u0446\u0435 \u0422\u043e\u043c\u0430\u0437\u0438\u044f,
    \u0412\u0435\u0439\u0433\u0435\u043b\u044f \u0438, \u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0414\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0435 \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b: \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u043e\u0431\u0448\u0438\u0440\u043d\u0443\u044e
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443 \u0441 \u0441\u043e\u0442\u043d\u044f\u043c\u0438
    \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u0432
    \u043f\u043e \u0432\u0441\u0435\u0439 \u0415\u0432\u0440\u043e\u043f\u0435. \u0421\u0440\u0435\u0434\u0438
    \u043d\u0438\u0445 \u0431\u044b\u043b\u0438 \u0442\u0430\u043a\u0438\u0435 \u0441\u0432\u0435\u0442\u0438\u043b\u0430,
    \u043a\u0430\u043a \u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u0438 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d \u0412\u043e\u043b\u044c\u0444,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0438
    \u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u0435\u0433\u043e \u0438\u0434\u0435\u0438. \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u0441 \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c: \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0418\u0441\u0430\u0430\u043a\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c
    \u0431\u044b\u043b\u0438 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u0433\u043e\u0440\u044c\u043a\u0438\u043c
    \u0441\u043f\u043e\u0440\u043e\u043c \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435
    \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0425\u043e\u0442\u044f \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435
    \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043e, \u0447\u0442\u043e
    \u043e\u0431\u0430 \u0443\u0447\u0435\u043d\u044b\u0445 \u0441\u043e\u0437\u0434\u0430\u043b\u0438
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e,
    \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 XVIII \u0432\u0435\u043a\u0430 \u044d\u0442\u043e\u0442
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u043f\u0440\u0438\u0432\u0435\u043b \u043a
    \u0440\u0430\u0441\u043a\u043e\u043b\u0443 \u043c\u0435\u0436\u0434\u0443 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u043c\u0438
    \u0438 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438
    \u0438 \u043d\u0430\u043d\u0435\u0441 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0439
    \u0443\u0440\u043e\u043d \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u0432 \u0410\u043d\u0433\u043b\u0438\u0438.\n\n\U0001F54A\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c
    \u0438 \u0437\u0430\u0431\u0432\u0435\u043d\u0438\u0435 \u0413\u043e\u0442\u0444\u0440\u0438\u0434
    \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 14 \u043d\u043e\u044f\u0431\u0440\u044f
    1716 \u0433\u043e\u0434\u0430 \u0432 \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 70 \u043b\u0435\u0442. \u0415\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u044c \u043f\u0440\u043e\u0448\u043b\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u0437\u0430\u043c\u0435\u0447\u0435\u043d\u043d\u043e\u0439. \u041d\u0430 \u0435\u0433\u043e
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u044b \u043d\u0435 \u044f\u0432\u0438\u043b\u0441\u044f
    \u043d\u0438\u043a\u0442\u043e \u0438\u0437 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0441\u043e\u0440\u043e\u043a \u043b\u0435\u0442. \u041d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0435
    \u043d\u0430 \u0435\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0435 \u0431\u044b\u043b\u043e
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u043b\u0438\u0448\u044c
    \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f,
    \u0438 \u043d\u0430 \u043d\u0435\u043c \u0431\u044b\u043b\u0430 \u0432\u044b\u0431\u0438\u0442\u0430
    \u043b\u0438\u0448\u044c \u043f\u0440\u043e\u0441\u0442\u0430\u044f \u043d\u0430\u0434\u043f\u0438\u0441\u044c:
    \"OSSA LEIBNITII\" \u2014 \u00ab\u041f\u0440\u0430\u0445 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430\u00bb.
    \u042d\u0442\u043e\u0442 \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u0439 \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a
    \u043d\u0430 \u044e\u0436\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u0446\u0435\u0440\u043a\u0432\u0438
    \u0432 \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0435 \u2014 \u0432\u0441\u0451,
    \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u043b\u0438
    \u043c\u0438\u0440. \u0416\u0438\u0437\u043d\u044c \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u2014 \u044d\u0442\u043e \u043f\u0443\u0442\u044c \u0433\u0435\u043d\u0438\u044f-\u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0438,
    \u0447\u044c\u0438 \u043f\u043e\u0438\u0441\u043a\u0438 \u0438\u0441\u0442\u0438\u043d\u044b
    \u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0437\u043d\u0430\u043d\u0438\u044f \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0432\u0440\u0435\u043c\u044f, \u043d\u043e \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0438 \u0435\u043c\u0443 \u0438 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0441\u043b\u0430\u0432\u0443, \u0438 \u0433\u043e\u0440\u044c\u043a\u043e\u0435 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0435."
  personalLifeEn: 
  shortBioRu: "\u0413\u043e\u0442\u0444\u0440\u0438\u0434 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u2014 \u0444\u0438\u0433\u0443\u0440\u0430,
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442
    \u0434\u0430\u0436\u0435 \u043f\u043e \u043c\u0435\u0440\u043a\u0430\u043c \u044d\u043f\u043e\u0445\u0438
    \u0433\u0435\u043d\u0438\u0435\u0432-\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u043e\u0432.
    \u041e\u043d \u0431\u044b\u043b \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0444\u0438\u0437\u0438\u043a\u043e\u043c,
    \u044e\u0440\u0438\u0441\u0442\u043e\u043c, \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u043e\u043c,
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u043c \u0438 \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u043e\u043c,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u043d\u0430 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438 \u0432\u0440\u0435\u043c\u044f. \u0415\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043d\u0435\u0443\u0442\u043e\u043c\u0438\u043c\u043e\u0433\u043e \u0438\u0441\u043a\u0430\u0442\u0435\u043b\u044f
    \u0437\u043d\u0430\u043d\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f
    \u043e\u0445\u0432\u0430\u0442\u0438\u0442\u044c \u0438 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c
    \u0432\u0441\u0435 \u0441\u0444\u0435\u0440\u044b \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438.\n\n\U0001F4DC \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u044e\u043d\u043e\u0441\u0442\u044c: \u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u043c\u0430
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 1
    \u0438\u044e\u043b\u044f 1646 \u0433\u043e\u0434\u0430 \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0435,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446, \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f,
    \u043a\u043e\u0433\u0434\u0430 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0443 \u0431\u044b\u043b\u043e
    \u0432\u0441\u0435\u0433\u043e \u0448\u0435\u0441\u0442\u044c \u043b\u0435\u0442, \u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u0435\u043c\u0443 \u0432 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e \u0431\u043e\u0433\u0430\u0442\u0435\u0439\u0448\u0443\u044e
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443. \u042d\u0442\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u043c \u0434\u043b\u044f
    \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0435\u0433\u043e
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438. \u0421 \u0440\u0430\u043d\u043d\u0438\u0445
    \u043b\u0435\u0442 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0439
    \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043a\u043d\u0438\u0433\u0430\u043c, \u0438\u0437\u0443\u0447\u0430\u044f
    \u043b\u0430\u0442\u044b\u043d\u044c \u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0438 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u0438\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432, \u0447\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u043b\u043e \u0435\u0433\u043e \u043a\u0440\u0443\u0433\u043e\u0437\u043e\u0440.
    \u0423\u0436\u0435 \u0432 12 \u043b\u0435\u0442 \u043e\u043d \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e
    \u0432\u043b\u0430\u0434\u0435\u043b \u043b\u0430\u0442\u044b\u043d\u044c\u044e, \u0430
    \u0432 14 \u0441\u043e\u0447\u0438\u043d\u0438\u043b 300 \u0433\u0435\u043a\u0437\u0430\u043c\u0435\u0442\u0440\u043e\u0432
    \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438 \u0437\u0430 \u043e\u0434\u0438\u043d
    \u0434\u0435\u043d\u044c, \u043f\u043e\u0440\u0430\u0437\u0438\u0432 \u0441\u0432\u043e\u0438\u0445
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439. \u0412 15 \u043b\u0435\u0442 \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b
    \u044e\u0440\u0438\u0441\u043f\u0440\u0443\u0434\u0435\u043d\u0446\u0438\u044e, \u043e\u0434\u043d\u0430\u043a\u043e
    \u0441 \u0436\u0430\u0434\u043d\u043e\u0441\u0442\u044c\u044e \u0432\u043f\u0438\u0442\u044b\u0432\u0430\u043b
    \u0437\u043d\u0430\u043d\u0438\u044f \u043f\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u043d \u043d\u0435
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b\u0441\u044f \u0440\u043e\u0434\u043d\u044b\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u043e\u043c \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0419\u0435\u043d\u0443, \u0447\u0442\u043e\u0431\u044b \u0443\u0433\u043b\u0443\u0431\u0438\u0442\u044c
    \u0441\u0432\u043e\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f. \u0415\u0433\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0443\u0442\u044c \u0431\u044b\u043b \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c:
    1663 \u0433\u043e\u0434: \u041f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430 \u0437\u0430 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u00ab\u041e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u0446\u0438\u0438\u00bb
    (De principio individui), \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0443\u0436\u0435
    \u043f\u0440\u043e\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044e\u0442\u0441\u044f
    \u0437\u0435\u0440\u043d\u0430 \u0435\u0433\u043e \u0431\u0443\u0434\u0443\u0449\u0435\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438. 1664 \u0433\u043e\u0434: \u0421\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u043e\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    1666 \u0433\u043e\u0434: \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 20 \u043b\u0435\u0442
    \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442 \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u00ab\u041e\u0431 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438\u00bb
    (De arte combinatoria). \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u043d \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442 \u0438\u0434\u0435\u044e
    \u00ab\u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430\u00bb
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f, \u0441\u0442\u0440\u0435\u043c\u044f\u0441\u044c
    \u0441\u0432\u0435\u0441\u0442\u0438 \u0432\u0441\u0435 \u0437\u043d\u0430\u043d\u0438\u044f
    \u043a \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f\u043c \u043f\u0440\u043e\u0441\u0442\u0435\u0439\u0448\u0438\u0445
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u2014 \u044d\u0442\u043e \u0431\u044b\u043b
    \u0440\u0430\u043d\u043d\u0438\u0439 \u043d\u0430\u0431\u0440\u043e\u0441\u043e\u043a \u0435\u0433\u043e
    \u043c\u0435\u0447\u0442\u044b \u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430.
    \u041f\u043e\u043f\u044b\u0442\u043a\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0435
    \u0431\u044b\u043b\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0435\u043d\u0430 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f\u043c\u0438
    \u0438\u0437-\u0437\u0430 \u0435\u0433\u043e \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438,
    \u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446, \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0441\u044c,
    \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0440\u043e\u0434\u043d\u043e\u0439 \u0433\u043e\u0440\u043e\u0434.
    \u041e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433
    \u0438 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0410\u043b\u044c\u0442\u0434\u043e\u0440\u0444\u0430
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u00ab\u041e \u0437\u0430\u043f\u0443\u0442\u0430\u043d\u043d\u044b\u0445
    \u0441\u0443\u0434\u0435\u0431\u043d\u044b\u0445 \u0434\u0435\u043b\u0430\u0445\u00bb (De
    casibus perplexis in jure), \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u044b, \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f, \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u044f
    \u0441\u0432\u043e\u0431\u043e\u0434\u0443 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.\n\n\U0001F3DB\ufe0f
    \u041d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435 \u0443 \u043a\u043d\u044f\u0437\u0435\u0439:
    \u0414\u0438\u043f\u043b\u043e\u043c\u0430\u0442, \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a
    \u0438 \u0443\u0447\u0451\u043d\u044b\u0439 \u0412\u0441\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u043f\u0440\u043e\u0448\u043b\u0430
    \u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435 \u0443 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445
    \u043a\u043d\u044f\u0437\u0435\u0439, \u0447\u0442\u043e \u0434\u0430\u0432\u0430\u043b\u043e
    \u0435\u043c\u0443 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0443\u044e \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c
    \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430\u0443\u043a\u043e\u0439, \u043d\u043e \u0442\u0430\u043a\u0436\u0435 \u0438
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u043b\u043e \u0435\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u043c\u0438
    \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c\u0438.
    \u041c\u0430\u0439\u043d\u0446\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    (1667\u20131676): \u041f\u0435\u0440\u0432\u044b\u0435 \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0448\u0430\u0433\u0438 \u0412 \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433\u0435 \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u0431\u0430\u0440\u043e\u043d\u043e\u043c
    \u0418\u043e\u0433\u0430\u043d\u043d\u043e\u043c \u041a\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u043c
    \u0444\u043e\u043d \u0411\u043e\u0439\u043d\u0435\u0431\u0443\u0440\u0433\u043e\u043c, \u0431\u044b\u0432\u0448\u0438\u043c
    \u043c\u0438\u043d\u0438\u0441\u0442\u0440\u043e\u043c \u043c\u0430\u0439\u043d\u0446\u0441\u043a\u043e\u0433\u043e
    \u043a\u0443\u0440\u0444\u044e\u0440\u0441\u0442\u0430. \u0411\u043e\u0439\u043d\u0435\u0431\u0443\u0440\u0433
    \u0432\u0437\u044f\u043b \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e
    \u043f\u043e\u0434 \u0441\u0432\u043e\u0435 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0438 \u0432\u0432\u0435\u043b \u0435\u0433\u043e \u043f\u0440\u0438 \u0434\u0432\u043e\u0440.
    \u041d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435 \u0443 \u043a\u0443\u0440\u0444\u044e\u0440\u0441\u0442\u0430
    \u041c\u0430\u0439\u043d\u0446\u0430 \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438 \u043f\u0443\u0431\u043b\u0438\u0446\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u043f\u0440\u0430\u0432\u043e\u0432\u043e\u0433\u043e \u043a\u043e\u0434\u0435\u043a\u0441\u0430.
    \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0435\u0433\u043e
    \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u043e\u0442\u0432\u043b\u0435\u0447\u044c
    \u0430\u043c\u0431\u0438\u0446\u0438\u0438 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0430 XIV
    \u043e\u0442 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u0437\u0435\u043c\u0435\u043b\u044c.
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043f\u043b\u0430\u043d \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043d\u0438\u044f \u0415\u0433\u0438\u043f\u0442\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u043a\u0430\u043a \u043e\u043d \u043d\u0430\u0434\u0435\u044f\u043b\u0441\u044f,
    \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u044c
    \u0432\u043e\u0435\u043d\u043d\u0443\u044e \u043c\u043e\u0449\u044c \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u043f\u0440\u043e\u0442\u0438\u0432 \u041e\u0441\u043c\u0430\u043d\u0441\u043a\u043e\u0439
    \u0438\u043c\u043f\u0435\u0440\u0438\u0438. \u0421 \u044d\u0442\u043e\u0439 \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0438\u0441\u0441\u0438\u0435\u0439 \u043e\u043d \u0432 1672 \u0433\u043e\u0434\u0443
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436.
    \u041f\u0430\u0440\u0438\u0436 (1672\u20131676): \u041a\u043e\u043b\u044b\u0431\u0435\u043b\u044c
    \u0433\u0435\u043d\u0438\u044f \u041f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0435
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435, \u0434\u043b\u0438\u0432\u0448\u0435\u0435\u0441\u044f
    \u0447\u0435\u0442\u044b\u0440\u0435 \u0433\u043e\u0434\u0430, \u0441\u0442\u0430\u043b\u043e,
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0430\u043c\u044b\u043c \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c
    \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043c \u0432 \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430.
    \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438
    \u0415\u0432\u0440\u043e\u043f\u044b. \u041e\u043d \u043e\u0431\u0449\u0430\u043b\u0441\u044f
    \u0441 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f \u0443\u043c\u0430\u043c\u0438:
    \u0444\u0438\u0437\u0438\u043a\u043e\u043c \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u043c \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u043e\u043c,
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c \u041d\u0438\u043a\u043e\u043b\u044f
    \u041c\u0430\u043b\u044c\u0431\u0440\u0430\u043d\u0448\u0435\u043c, \u0442\u0435\u043e\u043b\u043e\u0433\u043e\u043c
    \u0410\u043d\u0442\u0443\u0430\u043d\u043e\u043c \u0410\u0440\u043d\u043e. \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043f\u0440\u043e\u0431\u0435\u043b\u044b \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u043d\u0430\u043d\u0438\u044f\u0445
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430, \u0447\u0442\u043e \u043f\u043e\u0431\u0443\u0434\u0438\u043b\u043e
    \u0442\u043e\u0433\u043e \u043a \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u043c \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c,
    \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u043d \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0441\u044f
    \u0432 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0418\u043c\u0435\u043d\u043d\u043e \u0432
    \u041f\u0430\u0440\u0438\u0436\u0435, \u0432 1675 \u0433\u043e\u0434\u0443, \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0432\u043e\u0435 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f,
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u041d\u044c\u044e\u0442\u043e\u043d\u0430.
    \u0422\u0430\u043a\u0436\u0435 \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u0440\u0438\u0444\u043c\u043e\u043c\u0435\u0442\u0440, \u043f\u0435\u0440\u0432\u0443\u044e
    \u043c\u0430\u0448\u0438\u043d\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043c\u043e\u0433\u043b\u0430
    \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0432\u0441\u0435 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f,
    \u0438 \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u043c \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u0432 1673 \u0433\u043e\u0434\u0443, \u0433\u0434\u0435
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0435\u0433\u043e \u0447\u043b\u0435\u043d\u043e\u043c.
    \u0412 1676 \u0433\u043e\u0434\u0443, \u043d\u0430 \u043f\u0443\u0442\u0438 \u0438\u0437
    \u041f\u0430\u0440\u0438\u0436\u0430 \u0432 \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440,
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043f\u043e\u0435\u0437\u0434\u043a\u0443 \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u044e,
    \u0433\u0434\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b\u0441\u044f \u0441 \u0411\u0435\u043d\u0435\u0434\u0438\u043a\u0442\u043e\u043c
    \u0421\u043f\u0438\u043d\u043e\u0437\u043e\u0439, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0443\u0437\u043d\u0430\u043b \u043e\u0431 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u0445 \u0410\u043d\u0442\u043e\u043d\u0438
    \u0432\u0430\u043d \u041b\u0435\u0432\u0435\u043d\u0433\u0443\u043a\u0430 \u0432 \u043c\u0438\u0440\u0435
    \u043c\u0438\u043a\u0440\u043e\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u043e\u0432.
    \u042d\u0442\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0435\u0433\u043e \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435 \u0432\u0437\u0433\u043b\u044f\u0434\u044b.\n\n\U0001F451
    \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0441\u043a\u0438\u0435 \u0433\u043e\u0434\u044b
    (1676\u20131716): \u0417\u0440\u0435\u043b\u043e\u0441\u0442\u044c, \u0441\u043b\u0430\u0432\u0430
    \u0438 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e \u0421 1676 \u0433\u043e\u0434\u0430
    \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b \u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435
    \u0443 \u0433\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0441\u043a\u0438\u0445 \u0433\u0435\u0440\u0446\u043e\u0433\u043e\u0432,
    \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430\u0440\u044f, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u2014 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430 \u044e\u0441\u0442\u0438\u0446\u0438\u0438
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043e\u0433\u0440\u0430\u0444\u0430. \u042d\u0442\u043e
    \u0431\u044b\u043b \u043f\u0435\u0440\u0438\u043e\u0434 \u0432\u044b\u0441\u043e\u0447\u0430\u0439\u0448\u0435\u0439
    \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438. \u041e\u043d:
    \u0417\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439:
    \u041f\u043e \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u0438\u044e \u0433\u0435\u0440\u0446\u043e\u0433\u0430
    \u042d\u0440\u043d\u0441\u0442\u0430 \u0410\u0432\u0433\u0443\u0441\u0442\u0430 \u043e\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u043f\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0434\u043e\u043c\u0430
    \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u043e\u0432, \u0434\u043b\u044f
    \u0447\u0435\u0433\u043e \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u043f\u043e \u042e\u0436\u043d\u043e\u0439 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438,
    \u0410\u0432\u0441\u0442\u0440\u0438\u0438 \u0438 \u0418\u0442\u0430\u043b\u0438\u0438 (1687\u20131690).
    \u0421\u0442\u0430\u043b \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u043d\u0430\u0443\u043a\u0438: \u041f\u043e \u0435\u0433\u043e \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u0432 1700 \u0433\u043e\u0434\u0443 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u0431\u044b\u043b\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043e \u0411\u0440\u0430\u043d\u0434\u0435\u043d\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0435
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e
    (\u043f\u043e\u0437\u0436\u0435 \u2014 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a), \u043f\u0435\u0440\u0432\u044b\u043c
    \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u043d \u0441\u0442\u0430\u043b. \u041f\u044b\u0442\u0430\u043b\u0441\u044f \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c
    \u0446\u0435\u0440\u043a\u0432\u0438: \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0431\u044b\u043b
    \u043e\u0434\u0435\u0440\u0436\u0438\u043c \u0438\u0434\u0435\u0435\u0439 \u043f\u0440\u0438\u043c\u0438\u0440\u0435\u043d\u0438\u044f
    \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u043e\u0439
    \u0446\u0435\u0440\u043a\u0432\u0435\u0439, \u0432\u0435\u0434\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443 \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044f
    \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u0438\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438,
    \u043e\u0434\u043d\u0430\u043a\u043e \u044d\u0442\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u044b
    \u043d\u0435 \u0443\u0432\u0435\u043d\u0447\u0430\u043b\u0438\u0441\u044c \u0443\u0441\u043f\u0435\u0445\u043e\u043c.
    \u0412\u043b\u0438\u044f\u043b \u043d\u0430 \u0420\u043e\u0441\u0441\u0438\u044e: \u0422\u0440\u0438\u0436\u0434\u044b
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0441\u044f \u0441 \u041f\u0435\u0442\u0440\u043e\u043c
    I (\u0432 1711, 1712 \u0438 1716 \u0433\u043e\u0434\u0430\u0445) \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u044b \u043f\u043e
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043f\u043b\u0430\u043d \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0437\u0436\u0435 \u0431\u044b\u043b \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d.
    \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u0431\u044b\u043b\u0438 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u044b \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u043c
    \u0441 \u0433\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0441\u043a\u0438\u043c \u0434\u0432\u043e\u0440\u043e\u043c.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0433\u0435\u0440\u0446\u043e\u0433 \u0441\u0442\u0430\u043b
    \u043a\u043e\u0440\u043e\u043b\u0435\u043c \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u0438
    \u0413\u0435\u043e\u0440\u0433\u043e\u043c I, \u041b\u0435\u0439\u0431\u043d\u0438\u0446,
    \u0447\u044c\u0438 \u0437\u0430\u0441\u043b\u0443\u0433\u0438 \u0432 \u0410\u043d\u0433\u043b\u0438\u0438
    \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u043d\u0438\u0436\u0435\u043d\u044b \u0438\u0437-\u0437\u0430
    \u0441\u043f\u043e\u0440\u0430 \u0441 \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c \u043e
    \u043f\u0435\u0440\u0432\u0435\u043d\u0441\u0442\u0432\u0435 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f, \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u043d\u0435 \u0443 \u0434\u0435\u043b. \u0412 1716 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0435,
    \u043e\u0434\u0438\u043d\u043e\u043a\u0438\u043c \u0438 \u043f\u043e\u0447\u0442\u0438 \u0437\u0430\u0431\u044b\u0442\u044b\u043c,
    \u0430 \u0435\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u044b \u043f\u0440\u043e\u0448\u043b\u0438
    \u043f\u043e\u0447\u0442\u0438 \u043d\u0435\u0437\u0430\u043c\u0435\u0447\u0435\u043d\u043d\u044b\u043c\u0438.\n\n\U0001F48E
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443 \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0442\u0440\u0443\u0434\u043d\u043e \u043f\u0435\u0440\u0435\u043e\u0446\u0435\u043d\u0438\u0442\u044c.
    \u0415\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442: \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430:
    \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0435 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043e\u043c \u0438 \u043d\u043e\u0442\u0430\u0446\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0434\u0432\u043e\u0438\u0447\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432\u0441\u0435\u0445 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439.
    \u041b\u043e\u0433\u0438\u043a\u0430 \u0438 \u044f\u0437\u044b\u043a: \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u2014 \u043f\u0440\u0435\u0434\u0442\u0435\u0447\u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438.
    \u041e\u043d \u043c\u0435\u0447\u0442\u0430\u043b \u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u00ab\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438\u00bb
    (characteristica universalis) \u0438 \u00ab\u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439\u00bb (calculus ratiocinator)
    \u2014 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b
    \u0431\u044b \u0440\u0435\u0448\u0430\u0442\u044c \u043b\u044e\u0431\u044b\u0435 \u0441\u043f\u043e\u0440\u044b
    \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c\u0438.
    \u0424\u0438\u0437\u0438\u043a\u0430: \u0417\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u043d\u043e\u0432\u043e\u0439 \u043d\u0430\u0443\u043a\u0438 \u2014 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438,
    \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u0436\u0438\u0432\u043e\u0439
    \u0441\u0438\u043b\u044b\u00bb (\u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438) \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0437\u0430\u043a\u043e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0432 \u0435\u0435 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0432\u0435\u0440\u0441\u0438\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f.
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f: \u0421\u043e\u0437\u0434\u0430\u043b
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u2014 \u00ab\u041c\u043e\u043d\u0430\u0434\u043e\u043b\u043e\u0433\u0438\u044e\u00bb,
    \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043c\u0438\u0440 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u0431\u0435\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0445 \u0438 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u0443\u0431\u0441\u0442\u0430\u043d\u0446\u0438\u0439 \u2014 \u043c\u043e\u043d\u0430\u0434.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0437\u0430\u043a\u043e\u043d \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0440\u0430\u0437\u0432\u0438\u043b
    \u0443\u0447\u0435\u043d\u0438\u0435 \u043e \u00ab\u043d\u0430\u0438\u043b\u0443\u0447\u0448\u0435\u043c
    \u0438\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u043c\u0438\u0440\u043e\u0432\u00bb,
    \u0447\u0442\u043e \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0431\u044b\u043b\u043e \u0432\u044b\u0441\u043c\u0435\u044f\u043d\u043e \u0412\u043e\u043b\u044c\u0442\u0435\u0440\u043e\u043c
    \u0432 \u00ab\u041a\u0430\u043d\u0434\u0438\u0434\u0435\u00bb, \u043d\u043e \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0432\u0435\u0440\u0448\u0438\u043d \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438 XVII \u0432\u0435\u043a\u0430. \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0447\u0435\u043d\u044b\u043c;
    \u043e\u043d \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u0435\u0434\u0438\u043d\u0443\u044e \u043a\u0430\u0440\u0442\u0438\u043d\u0443 \u043c\u0438\u0440\u0430,
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0432 \u043d\u0430\u0443\u043a\u0443, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u0438 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e. \u0415\u0433\u043e \u0438\u0434\u0435\u0438
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0435\u0433\u043e \u0432\u0440\u0435\u043c\u044f, \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435
    \u0438\u0437 \u043d\u0438\u0445 \u043e\u0431\u0440\u0435\u043b\u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0432\u043e\u043f\u043b\u043e\u0449\u0435\u043d\u0438\u0435 \u043b\u0438\u0448\u044c \u0447\u0435\u0440\u0435\u0437
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0430 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u2014 \u044d\u0442\u043e \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0434\u0430 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439, \u043d\u043e \u0438 \u043a\u043b\u0430\u0434\u0435\u0437\u044c
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445, \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445
    \u0438 \u0434\u0430\u0436\u0435 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439. \u0415\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u0430,
    \u0447\u0442\u043e \u043f\u043e\u0440\u043e\u0436\u0434\u0430\u043b\u0430 \u0441\u0430\u043c\u044b\u0435
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0435 \u0441\u043b\u0443\u0445\u0438
    \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u044b. \u0412\u043e\u0442 \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430
    \u0441\u0430\u043c\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432 \u043e \u00ab\u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u043c \u0433\u0435\u043d\u0438\u0438\u00bb:\n\n\U0001F92F
    \u041f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u0430 \u0438 \u0447\u0443\u0434\u0435\u0441\u0430
    - \u041a\u0440\u0435\u0441\u0442\u0438\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0435:
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445 \u041b\u0435\u0439\u0431\u043d\u0438\u0446, \u0431\u044b\u043b
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0438 \u0441\u043a\u043b\u043e\u043d\u043d\u044b\u043c \u043a \u043c\u0438\u0441\u0442\u0438\u043a\u0435.
    \u041d\u0430 \u043a\u0440\u0435\u0441\u0442\u0438\u043d\u0430\u0445 \u043c\u043b\u0430\u0434\u0435\u043d\u0446\u0430
    \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0430 \u043e\u043d \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439
    \u043f\u043e\u0434\u043d\u044f\u043b \u0433\u043b\u0430\u0437\u0430 \u043a \u043f\u043e\u0442\u043e\u043b\u043a\u0443
    \u0438 \u043f\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e \u043d\u0430 \u043d\u0435\u0433\u043e
    \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u043b. \u041e\u0442\u0435\u0446 \u0442\u0443\u0442
    \u0436\u0435 \u0437\u0430\u043f\u0438\u0441\u0430\u043b \u0432 \u0441\u0435\u043c\u0435\u0439\u043d\u0443\u044e
    \u0445\u0440\u043e\u043d\u0438\u043a\u0443, \u0447\u0442\u043e \u0432\u0438\u0434\u0438\u0442
    \u0432 \u044d\u0442\u043e\u043c \u0437\u043d\u0430\u043a \u0431\u0443\u0434\u0443\u0449\u0438\u0445
    \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u0441\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0439.
    - \u0421\u043f\u0430\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u0430\u0434\u0435\u043d\u0438\u0435:
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u0432\u0443\u0445 \u043b\u0435\u0442
    \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439 \u0413\u043e\u0442\u0444\u0440\u0438\u0434
    \u0443\u043f\u0430\u043b \u0441\u043e \u0441\u0442\u043e\u043b\u0430, \u043d\u043e, \u043a
    \u0441\u0447\u0430\u0441\u0442\u044c\u044e, \u043d\u0435 \u0443\u0448\u0438\u0431\u0441\u044f
    \u0438 \u0434\u0430\u0436\u0435 \u0440\u0430\u0441\u0441\u043c\u0435\u044f\u043b\u0441\u044f.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u043d\u0430\u0445\u043e\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u0432 \u043a\u043e\u043c\u043d\u0430\u0442\u0435, \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u044f\u043b
    \u044d\u0442\u043e \u043a\u0430\u043a \u0411\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u043f\u0440\u043e\u0432\u0438\u0434\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u0441\u043f\u043e\u0440\u044f\u0434\u0438\u043b\u0441\u044f
    \u043e\u0442\u0441\u043b\u0443\u0436\u0438\u0442\u044c \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043c\u043e\u043b\u0435\u0431\u0435\u043d. \u0423\u0432\u044b, \u0441\u043f\u0430\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u043f\u0440\u043e\u0432\u0438\u0434\u0435\u043d\u0438\u0435 \u043d\u0435 \u0443\u0431\u0435\u0440\u0435\u0433\u043b\u043e
    \u0441\u0430\u043c\u043e\u0433\u043e \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 \u2014
    \u043e\u043d \u0443\u043c\u0435\u0440, \u043a\u043e\u0433\u0434\u0430 \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0443
    \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e \u0448\u0435\u0441\u0442\u044c.\n\n\U0001F4DA
    \u0427\u0442\u0435\u043d\u0438\u0435 \u043a\u0430\u043a \u0441\u043f\u043e\u0440\u0442 -
    \u0421\u0430\u043c\u043e\u0443\u0447\u043a\u0430 \u0432 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0433\u043e\u0434\u0430: \u041e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c \u0441
    \u0431\u043e\u0433\u0430\u0442\u043e\u0439 \u043e\u0442\u0446\u043e\u0432\u0441\u043a\u043e\u0439
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u043e\u0439, \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043d\u0435 \u0441\u0442\u0430\u043b \u0436\u0434\u0430\u0442\u044c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439. \u041e\u043d \u043d\u0430\u0443\u0447\u0438\u043b\u0441\u044f
    \u0447\u0438\u0442\u0430\u0442\u044c \u043f\u043e \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c\u0443
    \u0438\u0437\u0434\u0430\u043d\u0438\u044e \u0422\u0438\u0442\u0430 \u041b\u0438\u0432\u0438\u044f,
    \u0433\u0434\u0435 \u043f\u043e\u0434 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430\u043c\u0438
    \u0431\u044b\u043b\u0438 \u043a\u0440\u0430\u0442\u043a\u0438\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u0438
    \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438. \u0422\u0430\u043a, \u043a \u0447\u0435\u0442\u044b\u0440\u0435\u043c
    \u0433\u043e\u0434\u0430\u043c \u043e\u043d \u043e\u0441\u0432\u043e\u0438\u043b \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u044f\u0437\u044b\u043a\u043e\u0432
    \u043c\u0438\u0440\u0430. - \u0413\u0435\u043a\u0437\u0430\u043c\u0435\u0442\u0440\u044b
    \u0437\u0430 \u0434\u0435\u043d\u044c: \u0412 14 \u043b\u0435\u0442, \u0447\u0442\u043e\u0431\u044b
    \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u044c \u0438\u043b\u0438 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u044c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439, \u043e\u043d \u0437\u0430 \u043e\u0434\u0438\u043d
    \u0434\u0435\u043d\u044c \u0441\u043e\u0447\u0438\u043d\u0438\u043b 300 (!) \u0433\u0435\u043a\u0437\u0430\u043c\u0435\u0442\u0440\u043e\u0432
    \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438 \u0432 \u0441\u0442\u0438\u043b\u0435
    \u0412\u0435\u0440\u0433\u0438\u043b\u0438\u044f. \u0414\u043b\u044f \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0441\u0442\u0443\u043f\u0430\u043b
    \u043d\u0430 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u0437\u044e, \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0430\u043c\u044f\u0442\u0438 \u0438 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u043e\u0433\u043e
    \u0434\u0430\u0440\u0430.\n\n\U0001F9EE \u041a\u0443\u0440\u044c\u0435\u0437\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439 - \u041a\u043e\u043b\u0435\u0441\u043e
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 (\u0441\u0442\u0443\u043f\u0435\u043d\u0447\u0430\u0442\u044b\u0439
    \u0432\u0430\u043b\u0438\u043a): \u0421\u043e\u0437\u0434\u0430\u0432\u0430\u044f \u0441\u0432\u043e\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0430\u0440\u0438\u0444\u043c\u043e\u043c\u0435\u0442\u0440,
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0436\u043d\u043e \u0441\u0447\u0438\u0442\u0430\u0442\u044c
    \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0436\u0435\u0441\u0442\u043a\u043e\u0433\u043e \u0434\u0438\u0441\u043a\u0430. \u0412\u043c\u0435\u0441\u0442\u043e
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0448\u0435\u0441\u0442\u0435\u0440\u0435\u043d\u043e\u043a
    \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u0446\u0438\u043b\u0438\u043d\u0434\u0440
    \u0441 \u0437\u0443\u0431\u0446\u0430\u043c\u0438 \u0440\u0430\u0437\u043d\u043e\u0439 \u0434\u043b\u0438\u043d\u044b
    (9 \u0441\u0442\u0443\u043f\u0435\u043d\u0435\u0439), \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e
    \u043c\u0430\u0448\u0438\u043d\u0435 \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c \u0438
    \u0434\u0435\u043b\u0438\u0442\u044c \u0432 \u0440\u0430\u0437\u044b \u0431\u044b\u0441\u0442\u0440\u0435\u0435,
    \u0447\u0435\u043c \u043b\u044e\u0431\u044b\u0435 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0435
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430. \u041e\u043d \u043b\u0438\u0447\u043d\u043e
    \u043f\u0440\u0438\u0432\u0435\u0437 \u044d\u0442\u0443 \u0447\u0443\u0434\u043e-\u043c\u0430\u0448\u0438\u043d\u0443
    \u0432 \u041b\u043e\u043d\u0434\u043e\u043d \u0432 1673 \u0433\u043e\u0434\u0443 \u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b \u0444\u0443\u0440\u043e\u0440. - \u0414\u0432\u043e\u0439\u043a\u0430
    \u043a\u0430\u043a \u043a\u0430\u043c\u0435\u043d\u044c \u043f\u0440\u0435\u0442\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f:
    \u0415\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u2014 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u2014 \u0431\u044b\u043b\u043e
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u0432 1684 \u0433\u043e\u0434\u0443
    \u0432 \u0441\u0442\u0430\u0442\u044c\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043d\u0430\u0447\u0438\u043d\u0430\u043b\u0430\u0441\u044c \u0441... \u043e\u043f\u0435\u0447\u0430\u0442\u043a\u0438!
    \u0412 \u043d\u0435\u0439 \u0431\u044b\u043b\u0430 \u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0430
    \u043e\u0448\u0438\u0431\u043a\u0430 \u043f\u0440\u0438 \u043d\u0430\u0431\u043e\u0440\u0435
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b. \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e,
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0431\u044b\u0441\u0442\u0440\u043e \u0440\u0430\u0437\u043e\u0431\u0440\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0441\u0443\u0442\u0438 \u0434\u0435\u043b\u0430, \u043d\u043e \u0437\u0430\u0431\u0430\u0432\u043d\u043e,
    \u0447\u0442\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u043d\u043e\u0432\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u0435\u0434\u0432\u0430 \u043d\u0435 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043b\u0430
    \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0441\u043a\u0430\u044f \u043d\u0435\u0431\u0440\u0435\u0436\u043d\u043e\u0441\u0442\u044c.\n\n\U0001F5E3\ufe0f
    \u0414\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u0438\u044f \u0438 \u043d\u0435\u043b\u0435\u043f\u044b\u0435
    \u0441\u043b\u0443\u0445\u0438 - \u0421\u043f\u0430\u0441\u0438\u0442\u0435\u043b\u044c
    \u0415\u0433\u0438\u043f\u0442\u0430: \u0412 1672 \u0433\u043e\u0434\u0443 \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0443
    XIV \u043f\u043b\u0430\u043d... \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u0442\u044c \u0415\u0433\u0438\u043f\u0435\u0442.
    \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u0446\u0435\u043b\u044c\u044e \u044d\u0442\u043e\u0433\u043e
    \u0430\u0432\u0430\u043d\u0442\u044e\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430
    \u0431\u044b\u043b\u043e \u043e\u0442\u0432\u043b\u0435\u0447\u044c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u043e\u0442 \u0440\u0430\u0437\u043e\u0440\u0435\u043d\u0438\u044f
    \u0433\u0435\u0440\u043c\u0430\u043d\u0441\u043a\u0438\u0445 \u0437\u0435\u043c\u0435\u043b\u044c.
    \u041f\u043b\u0430\u043d \u0431\u044b\u043b \u043e\u0442\u0432\u0435\u0440\u0433\u043d\u0443\u0442,
    \u043d\u043e \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d \u0441\u043f\u0443\u0441\u0442\u044f
    \u0441\u0442\u043e \u043b\u0435\u0442 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u043f\u043e\u0447\u0442\u0438 \u043f\u043e \u0442\u043e\u043c\u0443
    \u0436\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443. - \u0428\u043f\u0438\u043e\u043d,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u043e\u044f\u043b\u0438\u0441\u044c:
    \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u044f \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435
    \u0432 1676 \u0433\u043e\u0434\u0443, \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0437\u0430\u0435\u0445\u0430\u043b
    \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u044e, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u0432\u0438\u0434\u0430\u0442\u044c \u0421\u043f\u0438\u043d\u043e\u0437\u0443.
    \u0414\u0440\u0443\u0437\u044c\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430 \u0434\u043e\u043b\u0433\u043e
    \u043e\u0442\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u043b\u0438 \u0435\u0433\u043e
    \u043e\u0442 \u0432\u0441\u0442\u0440\u0435\u0447\u0438, \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c,
    \u0447\u0442\u043e \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u2014 \u0442\u0430\u0439\u043d\u044b\u0439
    \u0448\u043f\u0438\u043e\u043d \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0433\u043e \u043a\u043d\u044f\u0437\u044f.
    \u0421\u043f\u0438\u043d\u043e\u0437\u0430 \u043f\u0440\u0438\u043d\u044f\u043b \u0433\u043e\u0441\u0442\u044f,
    \u043d\u043e \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c
    \u0441\u0442\u044b\u0434\u0438\u043b\u0441\u044f \u044d\u0442\u043e\u0433\u043e \u0432\u0438\u0437\u0438\u0442\u0430
    (\u0438\u0437-\u0437\u0430 \u0440\u0430\u0437\u043d\u0438\u0446\u044b \u0432 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0445
    \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u0445) \u0438 \u043f\u043e\u0437\u0436\u0435
    \u043d\u0430\u0447\u0438\u0441\u0442\u043e \u043e\u0442\u0440\u0438\u0446\u0430\u043b, \u0447\u0442\u043e
    \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u043b \u0441 \u043d\u0438\u043c.
    - \u00ab\u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0441\u043a\u0438\u0439 \u0424\u0430\u0443\u0441\u0442\u00bb:
    \u041f\u0440\u0438 \u0433\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0441\u043a\u043e\u043c
    \u0434\u0432\u043e\u0440\u0435 \u0437\u0430 \u043d\u0438\u043c \u0437\u0430\u043a\u0440\u0435\u043f\u0438\u043b\u0430\u0441\u044c
    \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044f \u043c\u0430\u0433\u0430 \u0438 \u0430\u043b\u0445\u0438\u043c\u0438\u043a\u0430.
    \u041a\u043e\u0433\u0434\u0430 \u043e\u043d \u0432 1679 \u0433\u043e\u0434\u0443 \u0443\u0433\u043e\u0432\u043e\u0440\u0438\u043b
    \u0433\u0435\u0440\u0446\u043e\u0433\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u044c
    \u0433\u043e\u0440\u043d\u044b\u0439 \u0437\u0430\u0432\u043e\u0434, \u043c\u0435\u0441\u0442\u043d\u044b\u0435
    \u0436\u0438\u0442\u0435\u043b\u0438 \u0431\u044b\u043b\u0438 \u0443\u0432\u0435\u0440\u0435\u043d\u044b,
    \u0447\u0442\u043e \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043d\u0430\u043c\u0435\u0440\u0435\u0432\u0430\u0435\u0442\u0441\u044f
    \u043f\u0440\u0438 \u043f\u043e\u043c\u043e\u0449\u0438 \u0430\u0434\u0441\u043a\u0438\u0445
    \u0441\u0438\u043b \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0441\u0432\u0438\u043d\u0435\u0446
    \u0432 \u0437\u043e\u043b\u043e\u0442\u043e. \u0421\u043b\u0443\u0445\u0438 \u0434\u043e\u0448\u043b\u0438
    \u0434\u043e \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043a\u043d\u044f\u0437\u044c
    \u0434\u0430\u043b \u0435\u043c\u0443 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043d\u0430 \u00ab\u043e\u043f\u044b\u0442\u044b
    \u0441 \u043c\u0435\u0442\u0430\u043b\u043b\u0430\u043c\u0438\u00bb, \u0447\u0442\u043e\u0431\u044b
    \u043f\u0440\u0435\u0441\u0435\u0447\u044c \u043f\u0430\u043d\u0438\u043a\u0443.\n\n\U0001F3AD
    \u042d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 - \u041f\u0430\u0440\u0438\u043a-\u043a\u043e\u043f\u0438\u043b\u043a\u0430:
    \u041a\u0430\u043a \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0436\u0435\u043d\u0442\u043b\u044c\u043c\u0435\u043d\u044b
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043d\u043e\u0441\u0438\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u043f\u0430\u0440\u0438\u043a.
    \u0418 \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430
    \u043f\u0440\u044f\u0442\u0430\u0442\u044c \u0434\u0435\u043d\u044c\u0433\u0438 \u0432 \u0441\u043a\u043b\u0430\u0434\u043a\u0430\u0445
    \u043f\u0430\u0440\u0438\u043a\u0430! \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0438, \u043a\u0430\u043a \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u043e\u0436\u0438\u0432\u043b\u0435\u043d\u043d\u044b\u0445
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0439 \u043e\u043d \u0432\u0434\u0440\u0443\u0433
    \u043d\u0430\u0447\u0438\u043d\u0430\u043b \u0440\u044b\u0442\u044c\u0441\u044f \u0432 \u0441\u0432\u043e\u0435\u0439
    \u0448\u0435\u0432\u0435\u043b\u044e\u0440\u0435, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0441\u0442\u0430\u0442\u044c
    \u043c\u043e\u043d\u0435\u0442\u0443 \u0438 \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043a\u0430\u043a\u043e\u0439-\u043d\u0438\u0431\u0443\u0434\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0447\u0435\u0440\u0442\u0435\u0436, \u043d\u0430\u0440\u0438\u0441\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u043d\u0430 \u043d\u0435\u0439. - \u0423\u0447\u0435\u043d\u044b\u0439 \u0434\u043e \u043c\u043e\u0437\u0433\u0430
    \u043a\u043e\u0441\u0442\u0435\u0439: \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u043a\u0440\u0435\u0441\u043b\u0435, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u043c
    \u043d\u0430 \u043a\u043e\u043b\u0435\u0441\u0438\u043a\u0430\u0445, \u0447\u0442\u043e\u0431\u044b
    \u043a\u0430\u0442\u0430\u0442\u044c\u0441\u044f \u043f\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0443,
    \u043d\u0435 \u0432\u0441\u0442\u0430\u0432\u0430\u044f. \u0415\u0433\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0445\u043b\u0430\u043c\u043b\u0435\u043d
    \u0431\u0443\u043c\u0430\u0433\u0430\u043c\u0438, \u0447\u0442\u043e \u043e\u043d \u0447\u0430\u0441\u0442\u043e
    \u0437\u0430\u0441\u044b\u043f\u0430\u043b \u043f\u0440\u044f\u043c\u043e \u0437\u0430 \u0441\u0442\u043e\u043b\u043e\u043c,
    \u0430 \u043f\u0440\u043e\u0441\u044b\u043f\u0430\u044f\u0441\u044c, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u043f\u0438\u0441\u0430\u0442\u044c, \u043d\u0435 \u0434\u0435\u043b\u0430\u044f \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u044f
    \u043c\u0435\u0436\u0434\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u0441\u0443\u0442\u043e\u043a.
    - \u041b\u044e\u0431\u043e\u0432\u044c \u043a \u041a\u0438\u0442\u0430\u044e: \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d
    \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u043e\u0439 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043e\u0439,
    \u0447\u0442\u043e \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b \u043e\u0431\u0443\u0447\u0438\u0442\u044c
    \u043a\u0438\u0442\u0430\u0439\u0446\u0435\u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0430 \u0443 \u043d\u0438\u0445
    \u043f\u0435\u0440\u0435\u043d\u044f\u0442\u044c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e.
    \u041e\u043d \u0434\u0430\u0436\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u043f\u0440\u043e\u0435\u043a\u0442
    \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u0432 \u041a\u0438\u0442\u0430\u0439 \u043c\u0438\u0441\u0441\u0438\u043e\u043d\u0435\u0440\u043e\u0432-\u0443\u0447\u0435\u043d\u044b\u0445
    \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0440\u0443\u0447\u043d\u043e
    \u043d\u0430\u0440\u0438\u0441\u043e\u0432\u0430\u043b \u0433\u0435\u0440\u0431 \u0434\u043b\u044f
    \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a.\n\n\U0001F974
    \u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0435
    \u043d\u0435\u0443\u0440\u044f\u0434\u0438\u0446\u044b - \u0427\u0435\u0440\u043d\u044b\u0439
    \u0441\u043f\u0438\u0441\u043e\u043a \u043a\u043e\u0440\u043e\u043b\u044f: \u041a\u043e\u0433\u0434\u0430
    \u0433\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0441\u043a\u0438\u0439 \u0433\u0435\u0440\u0446\u043e\u0433
    \u0441\u0442\u0430\u043b \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u043c \u043a\u043e\u0440\u043e\u043b\u0435\u043c
    \u0413\u0435\u043e\u0440\u0433\u043e\u043c I, \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u041b\u043e\u043d\u0434\u043e\u043d,
    \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c\u0441\u044f
    \u043c\u043e\u043d\u0430\u0440\u0445\u0443. \u041e\u0434\u043d\u0430\u043a\u043e \u043a\u043e\u0440\u043e\u043b\u044c
    \u0432\u044b\u0447\u0435\u0440\u043a\u043d\u0443\u043b \u0435\u0433\u043e \u0438\u043c\u044f
    \u0438\u0437 \u0441\u043f\u0438\u0441\u043a\u0430 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445,
    \u043f\u0440\u0438\u043f\u0438\u0441\u0430\u0432 \u043d\u0430 \u043f\u043e\u043b\u044f\u0445:
    \u00ab\u041e\u043d \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0441\u0442\u0430\u0440 \u0438
    \u0432\u0440\u0435\u0434\u0435\u043d\u00bb. \u0423\u0447\u0435\u043d\u044b\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430 \u0433\u0435\u0440\u0446\u043e\u0433\u043e\u0432
    40 \u043b\u0435\u0442, \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0432 \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0435
    \u043d\u0438 \u0441 \u0447\u0435\u043c. - \u041d\u0435\u0441\u043e\u0441\u0442\u043e\u044f\u0432\u0448\u0438\u0439\u0441\u044f
    \u0441\u043a\u0443\u043b\u044c\u043f\u0442\u043e\u0440: \u0412 1689 \u0433\u043e\u0434\u0443
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u043f\u043e\u0441\u0435\u0442\u0438\u043b \u0420\u0438\u043c
    \u0438 \u0431\u044b\u043b \u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d \u0434\u0440\u0435\u0432\u043d\u0438\u043c\u0438
    \u0441\u0442\u0430\u0442\u0443\u044f\u043c\u0438. \u041e\u043d \u0441\u0440\u043e\u0447\u043d\u043e
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u043f\u0438\u0441\u044c\u043c\u043e \u0434\u043e\u043c\u043e\u0439
    \u0441 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043f\u0440\u0438\u0441\u043b\u0430\u0442\u044c
    \u0435\u043c\u0443... \u043c\u043e\u043b\u043e\u0442\u043e\u043a \u0438 \u0437\u0443\u0431\u0438\u043b\u043e.
    \u041e\u043d \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435 \u0432\u0435\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0441\u043c\u043e\u0436\u0435\u0442 \u0441\u0430\u043c \u0432\u044b\u0440\u0435\u0437\u0430\u0442\u044c
    \u0438\u0437 \u043c\u0440\u0430\u043c\u043e\u0440\u0430 \u0441\u043a\u0443\u043b\u044c\u043f\u0442\u0443\u0440\u0443,
    \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0443\u044e \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0435
    \u0448\u0435\u0434\u0435\u0432\u0440\u044b.\n\n\U0001F56F\ufe0f \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e - \u0423\u043a\u0440\u0430\u0434\u0435\u043d\u043d\u043e\u0435
    \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0435: \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443
    \u0443 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e
    \u0441\u0435\u043c\u044c\u0438, \u0435\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u044b
    \u043f\u0440\u043e\u0448\u043b\u0438 \u043f\u043e\u0447\u0442\u0438 \u043d\u0435\u0437\u0430\u043c\u0435\u0442\u043d\u043e.
    \u041f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0435 \u043d\u0435 \u044f\u0432\u0438\u043b\u0438\u0441\u044c,
    \u0438 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0444\u0430\u043a\u0442,
    \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0432 \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u0435,
    \u2014 \u044d\u0442\u043e \u0442\u043e, \u0447\u0442\u043e \u0437\u0430 \u0433\u0440\u043e\u0431\u043e\u043c
    \u0448\u0435\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e \u0441\u0442\u0430\u0440\u044b\u0439
    \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044c. \u041d\u043e \u0441\u0430\u043c\u043e\u0435
    \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u043e\u0435 \u0441\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c
    \u043f\u043e\u0437\u0436\u0435: \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0435
    \u0431\u044b\u043b\u043e \u0443\u043a\u0440\u0430\u0434\u0435\u043d\u043e! \u0427\u0435\u0440\u0435\u0437
    \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442, \u043a\u043e\u0433\u0434\u0430 \u0446\u0435\u0440\u043a\u043e\u0432\u044c
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u043b\u0438
    \u043f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b, \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u0438
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0438 \u043c\u043e\u0433\u0438\u043b\u044c\u043d\u0443\u044e
    \u043f\u043b\u0438\u0442\u0443 \u043f\u043e\u0434 \u043a\u043e\u0440\u043d\u044f\u043c\u0438
    \u0441\u0442\u0430\u0440\u043e\u0433\u043e \u0434\u0443\u0431\u0430 \u043d\u0430 \u043e\u043a\u0440\u0430\u0438\u043d\u0435
    \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0430 \u2014 \u0432\u0438\u0434\u0438\u043c\u043e,
    \u0435\u0451 \u0440\u0435\u0448\u0438\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430
    \u0434\u043b\u044f \u043c\u043e\u0441\u0442\u043e\u0432\u043e\u0439. - \u041c\u043e\u0433\u0438\u043b\u0430
    \u0441 \u043e\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u043f\u0438\u0441\u044c\u044e:
    \u041d\u0430 \u043d\u044b\u043d\u0435\u0448\u043d\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0435
    \u0432\u044b\u0431\u0438\u0442\u0430 \u0432\u0441\u0435\u0433\u043e \u043e\u0434\u043d\u0430
    \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0430\u044f \u0444\u0440\u0430\u0437\u0430: \u00abOSSA
    LEIBNITII\u00bb (\u00ab\u041f\u0440\u0430\u0445 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430\u00bb).
    \u041d\u0438 \u0434\u0430\u0442 \u0436\u0438\u0437\u043d\u0438, \u043d\u0438 \u0442\u0438\u0442\u0443\u043b\u043e\u0432,
    \u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0439 \u2014 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0435 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435
    \u043e \u0442\u043e\u043c, \u043a\u0442\u043e \u043b\u0435\u0436\u0438\u0442 \u0432 \u0437\u0435\u043c\u043b\u0435.
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0431\u044b\u043b \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c: \u043e\u043d \u043c\u043e\u0433
    \u043f\u043e\u0442\u0435\u0440\u044f\u0442\u044c \u043a\u0430\u0440\u0435\u0442\u0443 \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f, \u0441\u043f\u043e\u0440\u0438\u0442\u044c
    \u0441 \u043a\u043e\u0440\u043e\u043b\u044f\u043c\u0438 \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435
    \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u0445 \u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0430\u043b\u0445\u0438\u043c\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u043d\u0435 \u043c\u0430\u0433\u0438\u0435\u0439, \u0430 \u0440\u0430\u043d\u043d\u0435\u0439
    \u0445\u0438\u043c\u0438\u0435\u0439. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439
    \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a \u0432\u0435\u043b\u0438\u043a\u043e\u0439
    \u043a\u043d\u0438\u0433\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u0442\u0430\u043a \u0438 \u043d\u0435 \u0443\u0441\u043f\u0435\u043b \u0434\u043e\u043f\u0438\u0441\u0430\u0442\u044c."
