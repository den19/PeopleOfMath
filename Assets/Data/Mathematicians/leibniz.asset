    LEIBNITII\u00bb (\u00ab\u041f\u0440\u0430\u0445 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430\u00bb).
    \u041d\u0438 \u0434\u0430\u0442 \u0436\u0438\u0437\u043d\u0438, \u043d\u0438 \u0442\u0438\u0442\u0443\u043b\u043e\u0432,
    \u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0439 \u2014 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0435 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435
    \u043e \u0442\u043e\u043c, \u043a\u0442\u043e \u043b\u0435\u0436\u0438\u0442 \u0432 \u0437\u0435\u043c\u043b\u0435.
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0431\u044b\u043b \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c
