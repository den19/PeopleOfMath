  fullNameRu: "\u041B\u0435\u0439\u0431\u043D\u0438\u0446, \u0413\u043E\u0442\u0444\u0440\u0438\u0434
    \u0412\u0438\u043B\u044C\u0433\u0435\u043B\u044C\u043C"
  fullNameEn: Gottfried Wilhelm Leibniz
