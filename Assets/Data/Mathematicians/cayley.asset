    \u0447\u0442\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0435\u0433\u043e \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439 \u043f\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044f\u043c \u0441\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0414\u0436\u0435\u0439\u043c\u0441 \u0414\u0436\u043e\u0437\u0435\u0444 \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440.
    \u0423 \u043d\u0438\u0445 \u0431\u044b\u043b\u0430 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f
    \u0433\u0443\u043b\u044f\u0442\u044c \u0432\u043c\u0435\u0441\u0442\u0435 \u043f\u043e \u0434\u0432\u043e\u0440\u0430\u043c
    \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0441-\u0418\u043d\u043d\u0430 (\u0441\u0443\u0434\u0435\u0431\u043d\u043e\u0433\u043e
    \u0438\u043d\u043d\u0430 \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0435), \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044e \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0438 \u043a\u043e\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432. \u0418 \u0438\u043c\u0435\u043d\u043d\u043e
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u0441\u043a\u043e\u0439
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438, \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f, \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043e\u0442 200 \u0434\u043e 300 \u0441\u0432\u043e\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442. \u0415\u0449\u0451 \u043e\u0434\u0438\u043d \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u044b\u0439
    \u044d\u043f\u0438\u0437\u043e\u0434: \u0433\u043e\u0442\u043e\u0432\u044f\u0441\u044c \u043a
    \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u0441\u043a\u043e\u043c\u0443 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0443,
    \u041a\u044d\u043b\u0438 \u0441\u044a\u0435\u0437\u0434\u0438\u043b \u0432 \u0414\u0443\u0431\u043b\u0438\u043d,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0420\u043e\u0443\u044d\u043d\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u043e \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u0430\u0445.\n\n\U0001F3E1
    \u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0441\u0447\u0430\u0441\u0442\u044c\u0435
    \u0438 \u0437\u0430\u0432\u0438\u0441\u0442\u044c \u041a\u043e\u0433\u0434\u0430 \u0432
    1863 \u0433\u043e\u0434\u0443 \u041a\u044d\u043b\u0438 \u043d\u0430\u043a\u043e\u043d\u0435\u0446
    \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435, \u043e\u043d \u0441\u0440\u0430\u0437\u0443
    \u0436\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0438, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u0435\u0433\u043e
    \u0434\u043e\u043c \u0431\u044b\u043b \u043f\u043e\u043b\u043e\u043d \u0441\u0447\u0430\u0441\u0442\u044c\u044f.
    \u042d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u044f\u0440\u043a\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u0443\u0435\u0442
    \u0441 \u0436\u0438\u0437\u043d\u044c\u044e \u0435\u0433\u043e \u0434\u0440\u0443\u0433\u0430
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u041a\u044d\u043b\u0438, \u0442\u0430\u043a \u0438 \u043d\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f.
    \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440 \u043a\u0430\u043a-\u0442\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u041a\u044d\u043b\u0438 \u0431\u044b\u043b \u0433\u043e\u0440\u0430\u0437\u0434\u043e
    \u0443\u0434\u0430\u0447\u043b\u0438\u0432\u0435\u0435 \u0435\u0433\u043e \u0432 \u0436\u0438\u0437\u043d\u0438:
    \u043e\u043d \u043e\u0431\u0440\u0435\u043b \u0442\u0438\u0445\u0443\u044e \u0438 \u043c\u0438\u0440\u043d\u0443\u044e
    \u0441\u0435\u043c\u0435\u0439\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0442\u043e\u0433\u0434\u0430 \u043a\u0430\u043a \u043e\u043d \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c
    \u00ab\u0441\u0440\u0430\u0436\u0430\u043b\u0441\u044f \u0441\u043e \u0432\u0441\u0435\u043c
    \u043c\u0438\u0440\u043e\u043c\u00bb.\n\n\U0001F3A8 \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f:
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0446\u0438\u0444\u0440\u044b, \u043d\u043e
    \u0438 \u043a\u0438\u0441\u0442\u0438 \u0423 \u041a\u044d\u043b\u0438 \u0431\u044b\u043b\u0438
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b. \u041e\u043d \u043f\u0438\u0442\u0430\u043b
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u0447\u0442\u0435\u043d\u0438\u044e \u0440\u043e\u043c\u0430\u043d\u043e\u0432,
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f\u043c \u0438 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u0438.
    \u041e\u043d \u0441\u0430\u043c \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u0430\u043a\u0432\u0430\u0440\u0435\u043b\u044c\u043d\u043e\u0439
    \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u044c\u044e \u0438 \u0434\u0430\u0436\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u043b
    \u044d\u0442\u043e\u043c\u0443 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043d\u0430\u0432\u044b\u043a\u0438 \u0440\u0438\u0441\u043e\u0432\u0430\u043d\u0438\u044f
    \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0441\u0432\u043e\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0438\u0430\u0433\u0440\u0430\u043c\u043c.\n\n\U0001F9E9
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0432 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f\u0445
    \u041f\u043b\u043e\u0434\u043e\u0432\u0438\u0442\u043e\u0441\u0442\u044c \u041a\u044d\u043b\u0438
    \u0438 \u0432\u043a\u043b\u0430\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d
    \u0432\u043d\u0435\u0441 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u043e\u0442\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u0432 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u043c
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432,
    \u043d\u043e\u0441\u044f\u0449\u0438\u0445 \u0435\u0433\u043e \u0438\u043c\u044f. \u0421\u0440\u0435\u0434\u0438
    \u043d\u0438\u0445: \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0438 \u0433\u0440\u0430\u0444
    \u041a\u044d\u043b\u0438. \u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u041a\u044d\u043b\u0438.
    \u0421\u0435\u043a\u0441\u0442\u0438\u043a\u0430 \u041a\u044d\u043b\u0438 (\u043a\u0440\u0438\u0432\u0430\u044f)
    \u0438 \u0434\u0430\u0436\u0435 \u0438\u0433\u0440\u0430 \u00ab\u041c\u044b\u0448\u0435\u043b\u043e\u0432\u043a\u0430
    \u041a\u044d\u043b\u0438\u00bb \u2014 \u0437\u0430\u0434\u0430\u0447\u0430-\u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430
    \u0441 \u043a\u0430\u0440\u0442\u0430\u043c\u0438. \u041a\u0440\u0430\u0442\u0435\u0440
    \u041a\u044d\u043b\u0438 \u043d\u0430 \u041b\u0443\u043d\u0435.\n\n\U0001F4DC \u041c\u0430\u0441\u0448\u0442\u0430\u0431
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f \u041e\u0431\u0449\u0435\u0435 \u0447\u0438\u0441\u043b\u043e
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442
    900, \u0430 \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c
    \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442 967. \u041f\u043e\u0437\u0434\u043d\u0435\u0435,
    \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    \u041a\u044d\u043b\u0438 \u043b\u0438\u0447\u043d\u043e \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0435\u043c\u044c \u0442\u043e\u043c\u043e\u0432 \u0441\u0432\u043e\u0438\u0445 \u0441\u0431\u043e\u0440\u043d\u0438\u043a\u043e\u0432,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044e\u044e \u0431\u043e\u043b\u0435\u0437\u043d\u044c.
    \u0415\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u044b \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435
    \u0441\u0442\u0430\u043b\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u0435\u043c \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u0438 \u0438\u0437
    \u0420\u043e\u0441\u0441\u0438\u0438 \u0438 \u0410\u043c\u0435\u0440\u0438\u043a\u0438."
  interestingFactsEn: "Arthur Kelly's life is full of unusual twists that make his biography not just a story of scientific achievement, but also an exciting story about a man who dedicated himself to a passion for mathematics.\n\n♪ Childhood, gift and choice of path as early as childhood, Kelly had extraordinary math skills — he did complex tasks for fun only. His talent was so obvious that teachers at Kings College School urged his father not to include his son in the family business, but to prepare him for admission to Cambridge University.At the age of 17, he had already entered Trinity College Cambridge, which was considered an extraordinary early age for a student at that time, where he succeeded not only in mathematics, but also in several languages, including Greek, French, German and Italian.\n\nThe career of a lawyer and the era of \"mathematical walk\" is one of the most famous facts of his life story: a 14-year career as a successful lawyer specializing in transport law; although his income as a lawyer was much higher than his professor's salary, he never regretted leaving law to devote himself entirely to science.It's interesting that during this period, his close friend and colleague in scientific discussions became mathematician James Joseph Sylvester, and they had a tradition of walking together in Lincoln's Inn (Judicial Inn in London), discussing the theory of invariants and covariants, and it was during the practice of lawyers, in his spare time, that he wrote 200 to 300 of his mathematical works.Another interesting episode: In preparation for the bar exam, Kelly went to Dublin to listen to William Rowan Hamilton's lecture on the Quaterrons.\n\n♪ Family life: happiness and envy ♪ ♪ When Kelly finally became a professor in Cambridge in 1863, he got married immediately and, according to his contemporaries, his home was filled with happiness ♪ ♪ This is particularly striking in contrast to the life of his friend and colleague Sylvester, who, unlike Kelly, never married ♪Sylvester once noticed that Calie was much happier than he was in his life: he found a quiet and peaceful family life in Cambridge, while he spent his entire life \"battling the world\".\n\n▪ Interest: Not only the numbers, but also the brushes of Kelly were not only scientific and professional interests; he was passionate about reading novels, travels and paintings; he himself was interested in water painting and even found practical applications using drawing skills to create his mathematical diagrams.\n\nThe legacy of Kelly's fertility and the contribution he made to mathematics is reflected in the incredible number of objects bearing his name, among them Theorem and Count Kelly. Table Kelly. Crater Kelly on the Moon.\n\nThe total number of his works exceeds 900, and according to some data, it is 967. later, shortly before his death, Kelly personally edited seven volumes of his compilations, despite a painful internal illness, and his funeral in Trinity College was a worldwide event attended by officials from Russia and America."
