  wikiTitleRu: "\u041A\u044D\u043B\u0438, \u0410\u0440\u0442\u0443\u0440"
  wikidataId: Q159430
  fullNameRu: "\u041A\u044D\u043B\u0438, \u0410\u0440\u0442\u0443\u0440"
  fullNameEn: Arthur Cayley
  birthDate: 16.08.1821
  deathDate: 26.01.1895
