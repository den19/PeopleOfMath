  achievementsRu: "\u0410\u0440\u0442\u0443\u0440 \u041a\u044d\u043b\u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0441\u043b\u0435\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0438 \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u0446\u0435\u043b\u044b\u0439 \u0440\u044f\u0434 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439. \u041e\u043d \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439
    \u044f\u0437\u044b\u043a \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440
    \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432.\n\n\U0001F52C \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u041a\u044d\u043b\u0438
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0435,
    \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0432 \u0435\u0451 \u0431\u0430\u0437\u043e\u0432\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f. \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0440\u0438\u0446: \u041a\u044d\u043b\u0438
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0440\u0438\u0446. \u0412 \u0441\u0432\u043e\u0435\u043c
    \u043c\u0435\u043c\u0443\u0430\u0440\u0435 1858 \u0433\u043e\u0434\u0430 \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c
    \u043c\u0430\u0442\u0440\u0438\u0446\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043a\u0430\u043a \u0443\u0434\u043e\u0431\u043d\u0443\u044e \u0444\u043e\u0440\u043c\u0443
    \u0437\u0430\u043f\u0438\u0441\u0438 \u0441\u0438\u0441\u0442\u0435\u043c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439,
    \u0430 \u043a\u0430\u043a \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u044b,
    \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u044e\u0449\u0438\u0435\u0441\u044f \u0441\u0432\u043e\u0438\u043c
    \u0437\u0430\u043a\u043e\u043d\u0430\u043c. \u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0438 \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0440\u0438\u0446
    \u0438, \u0447\u0442\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0435, \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0440\u0438\u0446
    \u043d\u0435\u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e (\u0442\u043e
    \u0435\u0441\u0442\u044c \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0441\u043e\u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0435\u0439
    \u0432\u0430\u0436\u0435\u043d). \u0421 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430
    \u043c\u0430\u0442\u0440\u0438\u0447\u043d\u0430\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043d\u043e\u0432\u043e\u0439, \u043c\u043e\u0449\u043d\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430\u2013\u041a\u044d\u043b\u0438:
    \u042d\u0442\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0435\u0433\u043e
    \u0441\u0430\u043c\u043e\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0440\u0438\u0446. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e \u043b\u044e\u0431\u0430\u044f
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u0430\u044f \u043c\u0430\u0442\u0440\u0438\u0446\u0430
    \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u0435\u0442 \u0441\u0432\u043e\u0435\u043c\u0443
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e. \u041a\u044d\u043b\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0435\u0451 \u0434\u043b\u044f \u043c\u0430\u0442\u0440\u0438\u0446 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432
    2\u00d72 \u0438 3\u00d73, \u0438, \u0445\u043e\u0442\u044f \u043e\u043d \u043d\u0435 \u0434\u0430\u043b
    \u043e\u0431\u0449\u0435\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432,
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u0430\u043c\u043d\u044f
    \u043b\u0438\u043d\u0435\u0439\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b.
    \u0424\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0433\u043e
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0433\u0440\u0443\u043f\u043f\u044b: \u042d\u0442\u043e
    \u043e\u0434\u043d\u043e \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u041a\u044d\u043b\u0438. \u0414\u043e
    \u043d\u0435\u0433\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \"\u0433\u0440\u0443\u043f\u043f\u0430\"
    \u0431\u044b\u043b\u043e \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043e
    \u0441 \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a
    (\u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0413\u0430\u043b\u0443\u0430). \u041a\u044d\u043b\u0438
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432, \u0434\u0430\u0432
    \u0432 1854 \u0433\u043e\u0434\u0443 \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u0433\u0440\u0443\u043f\u043f\u044b. \u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0433\u0440\u0443\u043f\u043f\u0443 \u043a\u0430\u043a \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0441 \u0431\u0438\u043d\u0430\u0440\u043d\u043e\u0439
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u0435\u0442\u0441\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u043c
    \u0437\u0430\u043a\u043e\u043d\u0430\u043c, \u0430\u0431\u0441\u0442\u0440\u0430\u0433\u0438\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0441\u044c
    \u043e\u0442 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439 \u043f\u0440\u0438\u0440\u043e\u0434\u044b
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432. \u0412 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c
    \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f:
    \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u041a\u044d\u043b\u0438 (\u0434\u043b\u044f
    \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438),
    \u0433\u0440\u0430\u0444 \u041a\u044d\u043b\u0438 \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u041a\u044d\u043b\u0438 (\u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0430\u044f,
    \u0447\u0442\u043e \u043b\u044e\u0431\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u0438\u0437\u043e\u043c\u043e\u0440\u0444\u043d\u0430
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u0435
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a). \u0422\u0435\u043e\u0440\u0438\u044f
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432: \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0414\u0436\u0435\u0439\u043c\u0441\u043e\u043c \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u043e\u043c,
    \u041a\u044d\u043b\u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u2014 \u0440\u0430\u0437\u0434\u0435\u043b\u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u044b,
    \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u043e\u0440\u043c
    (\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u043e\u0432),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f
    \u043f\u0440\u0438 \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u0445
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445. \u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u043e\u0439 \u0437\u0434\u0435\u0441\u044c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0435\u0433\u043e \u0441\u0435\u0440\u0438\u044f \u0438\u0437 \u0434\u0435\u0441\u044f\u0442\u0438
    \"\u041c\u0435\u043c\u0443\u0430\u0440\u043e\u0432 \u043e \u043a\u0432\u0430\u043d\u0442\u0430\u0445\"
    (1854\u20131878), \u0433\u0434\u0435 \u043e\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u044d\u0442\u0443 \u0442\u0435\u043e\u0440\u0438\u044e.\n\n\U0001F4D0
    \u041d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0435 \u0438\u0434\u0435\u0438
    \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u041a\u044d\u043b\u0438 \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0435,
    \u043d\u043e \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0435\u0451 \u0434\u043b\u044f
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u0430\u044f
    \u043c\u0435\u0442\u0440\u0438\u043a\u0430 \u0438 \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041e\u0434\u043d\u043e \u0438\u0437
    \u0435\u0433\u043e \u0441\u0430\u043c\u044b\u0445 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u2014 \u044d\u0442\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0432\u044f\u0437\u0438 \u043c\u0435\u0436\u0434\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0438 \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439.
    \u0412 1859 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0432\u0432\u0435\u0441\u0442\u0438 \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u042d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043f\u0440\u0438\u0432\u0435\u043b \u043a \u043e\u0448\u0435\u043b\u043e\u043c\u043b\u044f\u044e\u0449\u0435\u043c\u0443
    \u0432\u044b\u0432\u043e\u0434\u0443: \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043b\u0438\u0448\u044c \u0447\u0430\u0441\u0442\u043d\u044b\u043c \u0441\u043b\u0443\u0447\u0430\u0435\u043c
    \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439. \u0411\u043e\u043b\u0435\u0435
    \u0442\u043e\u0433\u043e, \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \"\u043b\u0435\u0433\u043b\u0430
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0438\u0441\u0442\u043e\u043b\u043a\u043e\u0432\u0430\u043d\u0438\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u043e\u0433\u043e\",
    \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u0438
    \u041a\u044d\u043b\u0438\u2013\u041a\u043b\u0435\u0439\u043d\u0430 \u2014 \u043c\u043e\u0434\u0435\u043b\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0430
    \u043f\u043e\u043d\u044f\u0442\u044c \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u044b
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0441 \u0442\u043e\u0447\u043a\u0438
    \u0437\u0440\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439.
    \u041e\u0441\u043d\u043e\u0432\u044b \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438: \u041a\u044d\u043b\u0438 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u042d\u0442\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u0438\u0437\u0443\u0447\u0430\u0435\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b (\u043a\u0440\u0438\u0432\u044b\u0435, \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438),
    \u0437\u0430\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0414\u0436\u043e\u0440\u0434\u0436\u0435\u043c
    \u0421\u0430\u043b\u043c\u043e\u043d\u043e\u043c \u043e\u043d \u043e\u0442\u043a\u0440\u044b\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438 27
    \u043f\u0440\u044f\u043c\u044b\u0445 \u043d\u0430 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F9E9 \u0414\u0440\u0443\u0433\u0438\u0435
    \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u041c\u0430\u0441\u0448\u0442\u0430\u0431 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u0431\u044b\u043b \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u043c.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0432\u043d\u0435\u0441 \u0432\u0430\u0436\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432: \u0422\u0435\u043e\u0440\u0438\u044e \u0433\u0440\u0430\u0444\u043e\u0432:
    \u0415\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u0430
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u041a\u044d\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0434\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u0447\u0438\u0441\u043b\u043e
    \u043f\u043e\u043c\u0435\u0447\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432
    \u0441 \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c \u0447\u0438\u0441\u043b\u043e\u043c
    \u0432\u0435\u0440\u0448\u0438\u043d. \u042d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438: \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \"\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0439
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\" (1876). \u041a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0443
    \u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e
    \u0438 \u0430\u0441\u0442\u0440\u043e\u0444\u0438\u0437\u0438\u043a\u0443: \u041e\u043d
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435\u043c \u041b\u0443\u043d\u044b \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0434\u0432\u0430 \u0448\u0438\u0440\u043e\u043a\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u043e\u0442\u0447\u0435\u0442\u0430 \u043f\u043e \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435.
    \u041e\u0431\u044a\u0435\u043c \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f \u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442:
    \u0437\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043e\u043a\u043e\u043b\u043e 900 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442,
    \u0438 \u0431\u043e\u043b\u0435\u0435 300 \u0438\u0437 \u043d\u0438\u0445 \u0431\u044b\u043b\u0438
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u044b \u0432 \u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u043e\u043c.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0432\u044b\u0441\u0448\u0438\u043c\u0438
    \u043d\u0430\u0433\u0440\u0430\u0434\u0430\u043c\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043c\u0435\u0434\u0430\u043b\u044c
    (1859), \u041c\u0435\u0434\u0430\u043b\u044c \u041a\u043e\u043f\u043b\u0438 (1882) \u0438
    \u043f\u0435\u0440\u0432\u0443\u044e \u041c\u0435\u0434\u0430\u043b\u044c \u0434\u0435 \u041c\u043e\u0440\u0433\u0430\u043d\u0430
    (1884)."
  achievementsEn: 
  personalLifeRu: "\u0425\u043e\u0442\u044f, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439,
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0445 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0439
    \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438
    \u0410\u0440\u0442\u0443\u0440\u0430 \u041a\u044d\u043b\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u043d\u0435\u043c\u043d\u043e\u0433\u043e, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0440\u0438\u0441\u0443\u044e\u0442
    \u043e\u0431\u0440\u0430\u0437 \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0431\u0440\u0435\u043b \u0432 \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438
    \u0442\u043e, \u0447\u0442\u043e \u0438\u0441\u043a\u0430\u043b: \u0442\u0438\u0445\u043e\u0435
    \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0435 \u0441\u0447\u0430\u0441\u0442\u044c\u0435
    \u0438 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u044e.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0421\u0435\u043c\u044c\u044f \u0438 \u0431\u0440\u0430\u043a \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0432 \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438
    \u041a\u044d\u043b\u0438 \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b \u0432 1863 \u0433\u043e\u0434\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 42
    \u043b\u0435\u0442 \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u043f\u0435\u0440\u0432\u044b\u043c \u0421\u044d\u0434\u043b\u0435\u0440\u043e\u0432\u0441\u043a\u0438\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435.
    \u042d\u0442\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0435\u043c\u0443 \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0434\u043e\u0445\u043e\u0434\u043d\u0443\u044e
    \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443
    \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0435 \u0440\u0430\u0434\u0438 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u044f.
    \u041a\u044d\u043b\u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0436\u0430\u043b\u0435\u043b
    \u043e\u0431 \u044d\u0442\u043e\u043c \u0440\u0435\u0448\u0435\u043d\u0438\u0438, \u0442\u0430\u043a
    \u043a\u0430\u043a \u043e\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u043b\u043e \u0435\u043c\u0443
    \u043f\u0443\u0442\u044c \u043a \u043f\u043e\u043b\u043d\u043e\u0439 \u0441\u0430\u043c\u043e\u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0437\u043d\u0430\u043a\u043e\u0432\u043e\u043c
    1863 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u0435\u0449\u0435
    \u043e\u0434\u0438\u043d \u0432\u0430\u0436\u043d\u044b\u0439 \u0448\u0430\u0433: 8 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0421\u044c\u044e\u0437\u0435\u043d
    \u041c\u043e\u043b\u0430\u0439\u043d (Susan Moline, 1831\u20131923). \u0421\u044c\u044e\u0437\u0435\u043d
    \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u0420\u043e\u0431\u0435\u0440\u0442\u0430
    \u041c\u043e\u043b\u0430\u0439\u043d\u0430, \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0431\u0430\u043d\u043a\u0438\u0440\u0430 \u0438\u0437 \u0413\u0440\u0438\u043d\u0432\u0438\u0447\u0430.
    \u0412\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u0441\u0432\u0430\u0434\u044c\u0431\u044b
    \u041a\u044d\u043b\u0438 \u043a\u0443\u043f\u0438\u043b \u0434\u043e\u043c \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435
    \u043d\u0430 \u0413\u0430\u0440\u0434\u0435\u043d-\u0445\u0430\u0443\u0441, \u041b\u0438\u0442\u0442\u043b
    \u0421\u0435\u043d\u0442-\u041c\u044d\u0440\u0438 \u041b\u0435\u0439\u043d, \u0433\u0434\u0435
    \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u043c\u043e\u043b\u043e\u0434\u0430\u044f
    \u0441\u0435\u043c\u044c\u044f. \u0423 \u0410\u0440\u0442\u0443\u0440\u0430 \u0438 \u0421\u044c\u044e\u0437\u0435\u043d
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0434\u0432\u043e\u0435 \u0434\u0435\u0442\u0435\u0439:
    \u0413\u0435\u043d\u0440\u0438 \u041a\u044d\u043b\u0438 (Henry Cayley, 1870\u20131949) \u2014
    \u043f\u043e\u0448\u0435\u043b \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c \u043e\u0442\u0446\u0430
    \u0438 \u0438\u0437\u0443\u0447\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435, \u043d\u043e, \u043a\u0430\u043a
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0441\u044f, \u0440\u0435\u0448\u0438\u043b,
    \u0447\u0442\u043e \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0432\u044b\u0441\u043e\u0442\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u043e\u0442\u0446\u0430, \u0438 \u0432\u044b\u0431\u0440\u0430\u043b \u043a\u0430\u0440\u044c\u0435\u0440\u0443
    \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u0430. \u041c\u044d\u0440\u0438
    \u041a\u044d\u043b\u0438 (Mary Cayley, 1872\u20131950).\n\n\U0001F496 \u0421\u0435\u043c\u0435\u0439\u043d\u043e\u0435
    \u0441\u0447\u0430\u0441\u0442\u044c\u0435 \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440
    \u0412\u0441\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u041a\u044d\u043b\u0438 \u0431\u044b\u043b\u0430 \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c
    \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438 \u0438 \u0441\u0447\u0430\u0441\u0442\u044c\u044f.
    \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u044f\u0440\u043a\u043e \u044d\u0442\u043e
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432
    \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0438 \u0441 \u0435\u0433\u043e \u0434\u0440\u0443\u0433\u043e\u043c
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0414\u0436\u0435\u0439\u043c\u0441\u043e\u043c \u0414\u0436\u043e\u0437\u0435\u0444\u043e\u043c
    \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u043e\u043c. \u041e\u0431\u0430 \u043e\u043d\u0438
    \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0431\u044b\u043b\u0438
    \u0445\u043e\u043b\u043e\u0441\u0442\u044f\u043a\u0430\u043c\u0438 \u0438 \u0436\u0438\u043b\u0438
    \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0435, \u043d\u043e, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u0436\u0435\u043d\u0430\u0442\u043e\u0433\u043e \u041a\u044d\u043b\u0438,
    \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440 \u0442\u0430\u043a \u0438 \u043d\u0435
    \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0431\u0440\u0430\u043a. \u0414\u0440\u0443\u0433
    \u041a\u044d\u043b\u0438 \u043e\u0434\u043d\u0430\u0436\u0434\u044b \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u0442\u043e\u0442 \u0431\u043e\u043b\u0435\u0435 \u0443\u0434\u0430\u0447\u043b\u0438\u0432
    \u0432 \u0436\u0438\u0437\u043d\u0438, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u0431\u0440\u0435\u043b
    \u0442\u0438\u0445\u0443\u044e \u0438 \u043c\u0438\u0440\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u0430\u043a \u043e\u043d, \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440,
    \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u043e\u0434\u0438\u043d \u0438 \u0432\u0441\u044e
    \u0436\u0438\u0437\u043d\u044c \"\u0441\u0440\u0430\u0436\u0430\u043b\u0441\u044f \u0441\u043e
    \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u043e\u043c\". \u0414\u043e\u043c \u041a\u044d\u043b\u0438,
    \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0434\u043e\u043c\u0430
    \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0420\u043e\u0443\u044d\u043d\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430,
    \u0431\u044b\u043b \"\u043f\u043e\u043b\u043e\u043d \u0441\u0447\u0430\u0441\u0442\u044c\u044f\".
    \u0421\u0430\u043c \u041a\u044d\u043b\u0438 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u0439,
    \u043d\u043e \u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439, \u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0449\u0438\u0439
    \u044f\u0441\u043d\u044b\u043c \u0443\u043c\u043e\u043c \u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c\u044e.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u043c\u043e\u0433 \u0441 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043b\u0435\u0433\u043a\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f
    \u043c\u0435\u0436\u0434\u0443 \u044e\u0440\u0438\u0441\u043f\u0440\u0443\u0434\u0435\u043d\u0446\u0438\u0435\u0439
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439, \u043f\u043e\u0441\u0432\u044f\u0449\u0430\u044f
    \u043a\u0430\u0436\u0434\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\U0001F3DB\ufe0f \u041e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u041f\u043e\u043c\u0438\u043c\u043e \u0441\u0435\u043c\u044c\u0438 \u0438 \u043d\u0430\u0443\u043a\u0438,
    \u041a\u044d\u043b\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0436\u0438\u0437\u043d\u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u041e\u043d \u0431\u044b\u043b
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u043c \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c
    \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u0432\u044b\u0441\u0448\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d.
    \u0412 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 1880-\u0445 \u0433\u043e\u0434\u043e\u0432
    \u043e\u043d \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u043b \u0441\u043e\u0432\u0435\u0442
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430 \u041d\u044c\u044e\u043d\u0445\u0435\u043c
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435, \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0436\u0435\u043d\u0441\u043a\u0438\u0445
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435\u0439. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0431\u044b\u043b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u0433\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0411\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0439
    \u0430\u0441\u0441\u043e\u0446\u0438\u0430\u0446\u0438\u0438 \u0441\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044e \u043d\u0430\u0443\u043a\u0438 \u0438 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0427\u0442\u043e \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f
    \u043b\u0438\u0447\u043d\u044b\u0445 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439,
    \u041a\u044d\u043b\u0438 \u043d\u0435 \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0441\u043f\u043e\u0440\u0442\u0441\u043c\u0435\u043d\u043e\u043c, \u043d\u043e \u0431\u044b\u043b
    \u0437\u0430\u044f\u0434\u043b\u044b\u043c \u043f\u0435\u0448\u0435\u0445\u043e\u0434\u043e\u043c
    \u0438 \u0432\u0445\u043e\u0434\u0438\u043b \u0432 \u0410\u043b\u044c\u043f\u0438\u0439\u0441\u043a\u0438\u0439
    \u043a\u043b\u0443\u0431.\n\n\u26b0\ufe0f \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0410\u0440\u0442\u0443\u0440 \u041a\u044d\u043b\u0438 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    26 \u044f\u043d\u0432\u0430\u0440\u044f 1895 \u0433\u043e\u0434\u0430 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 73 \u043b\u0435\u0442, \u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u0436\u0435\u043d\u0443 \u0438
    \u0434\u0432\u043e\u0438\u0445 \u0434\u0435\u0442\u0435\u0439. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a \u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u044c
    \u043d\u0430\u0443\u043a\u0435 \u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u0447\u0435\u0442\u0430\u0442\u044c\u0441\u044f
    \u0441 \u0442\u0438\u0445\u0438\u043c \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u043c \u0441\u0447\u0430\u0441\u0442\u044c\u0435\u043c
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439
    \u043f\u043e\u0437\u0438\u0446\u0438\u0435\u0439."
  personalLifeEn: 
  shortBioRu: "\u0410\u0440\u0442\u0443\u0440 \u041a\u044d\u043b\u0438 (Arthur Cayley, 1821\u20131895)
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u043b\u043e\u0434\u043e\u0432\u0438\u0442\u044b\u0445
    \u0438 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0412\u0438\u043a\u0442\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0439 \u044d\u043f\u043e\u0445\u0438,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c-\u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c\u00bb
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0415\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u044b
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044e \u0433\u0440\u0443\u043f\u043f,
    \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u0430\u0442\u0440\u0438\u0446 \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e. \u0417\u0430 \u0441\u0432\u043e\u044e
    \u0436\u0438\u0437\u043d\u044c \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043e\u043a\u043e\u043b\u043e 900 \u0441\u0442\u0430\u0442\u0435\u0439 \u0438 \u043a\u043d\u0438\u0433.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u0435\u0433\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f.\n\n\U0001F9EC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0410\u0440\u0442\u0443\u0440 \u041a\u044d\u043b\u0438 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    16 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1821 \u0433\u043e\u0434\u0430 \u0432 \u0420\u0438\u0447\u043c\u043e\u043d\u0434\u0435,
    \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u043e \u0421\u0443\u0440\u0440\u0435\u0439, \u0410\u043d\u0433\u043b\u0438\u044f.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0413\u0435\u043d\u0440\u0438 \u041a\u044d\u043b\u0438,
    \u0431\u044b\u043b \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0435\u043c \u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043b
    \u0432 \u0434\u0430\u043b\u044c\u043d\u0435\u043c \u0440\u043e\u0434\u0441\u0442\u0432\u0435
    \u0441 \u0441\u044d\u0440\u043e\u043c \u0414\u0436\u043e\u0440\u0434\u0436\u0435\u043c \u041a\u044d\u043b\u0438,
    \u043f\u0438\u043e\u043d\u0435\u0440\u043e\u043c \u0432\u043e\u0437\u0434\u0443\u0445\u043e\u043f\u043b\u0430\u0432\u0430\u043d\u0438\u044f.
    \u041c\u0430\u0442\u044c, \u041c\u0430\u0440\u0438\u044f \u0410\u043d\u0442\u043e\u043d\u0438\u044f
    \u0414\u043e\u0442\u0438, \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0414\u043e\u0442\u0438. \u041f\u0435\u0440\u0432\u044b\u0435
    \u0432\u043e\u0441\u0435\u043c\u044c \u043b\u0435\u0442 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438
    \u0410\u0440\u0442\u0443\u0440 \u043f\u0440\u043e\u0432\u0451\u043b \u0432 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435,
    \u0433\u0434\u0435 \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0432\u0451\u043b \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u0435\u043b\u0430, \u0430 \u0435\u0433\u043e \u0434\u0435\u0434 \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u043f\u043e\u0441\u0442 \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0441\u0443\u043b\u0430.
    \u0412 1829 \u0433\u043e\u0434\u0443 \u0441\u0435\u043c\u044c\u044f \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c \u0432 \u0410\u043d\u0433\u043b\u0438\u044e
    \u0438 \u043f\u043e\u0441\u0435\u043b\u0438\u043b\u0430\u0441\u044c \u0432 \u0411\u043b\u044d\u043a\u0445\u0438\u0442\u0435,
    \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e \u043e\u0442 \u041b\u043e\u043d\u0434\u043e\u043d\u0430.\n\n\U0001F468\u200d\U0001F393
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0447\u0430\u043b\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0421 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442
    \u041a\u044d\u043b\u0438 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438.
    \u0415\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u0432 \u0448\u043a\u043e\u043b\u0435
    \u041a\u0438\u043d\u0433\u0441-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430, \u043a\u0443\u0434\u0430
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 14 \u043b\u0435\u0442,
    \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b \u0432 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0435
    \u0433\u0435\u043d\u0438\u044f \u0438 \u0443\u0431\u0435\u0434\u0438\u043b \u043e\u0442\u0446\u0430
    \u043e\u0442\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u0438\u0434\u0435\u0438
    \u043e\u0431\u0443\u0447\u0430\u0442\u044c \u0441\u044b\u043d\u0430 \u0431\u0438\u0437\u043d\u0435\u0441\u0443,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c
    \u0435\u0433\u043e \u043a \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044e
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 17 \u043b\u0435\u0442 \u041a\u044d\u043b\u0438
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439
    \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0415\u0433\u043e
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0431\u044b\u043b \u0423\u0438\u043b\u044c\u044f\u043c
    \u0425\u043e\u043f\u043a\u0438\u043d\u0441, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043a\u0430\u043a \u00ab\u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432\u00bb.
    \u0412 1842 \u0433\u043e\u0434\u0443 \u041a\u044d\u043b\u0438 \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043a\u0430\u043a Senior
    Wrangler (\u043b\u0443\u0447\u0448\u0438\u0439 \u0441\u0442\u0443\u0434\u0435\u043d\u0442
    \u043d\u0430 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u043e\u043c \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0435
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435) \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e \u0421\u043c\u0438\u0442\u0430
    \u0437\u0430 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443. \u041e\u043d \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 \u043d\u0430 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0433\u043e\u0434\u0430, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b 28 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0436\u0443\u0440\u043d\u0430\u043b\u0435.\n\n\u2696\ufe0f
    \u0410\u0434\u0432\u043e\u043a\u0430\u0442\u0441\u043a\u0430\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430
    \u0414\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u041a\u044d\u043b\u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0431\u044b\u043b\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439. \u041a\u0440\u043e\u043c\u0435
    \u0442\u043e\u0433\u043e, \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0439
    \u0441\u0430\u043d, \u0447\u0442\u043e \u041a\u044d\u043b\u0438 \u043d\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b\u043e.
    \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432 1846 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0438 \u043d\u0430\u0447\u0430\u043b \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043f\u0440\u0430\u0432\u043e
    \u0432 \u043b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u043c \u0441\u0443\u0434\u0435\u0431\u043d\u043e\u043c
    \u0438\u043d\u043d\u0435 \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0430. \u0421
    1849 \u043f\u043e 1863 \u0433\u043e\u0434 \u041a\u044d\u043b\u0438 \u0443\u0441\u043f\u0435\u0448\u043d\u043e
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u0441\u043a\u043e\u0439
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u043e\u0439, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044f\u0441\u044c
    \u043d\u0430 \u0434\u0435\u043b\u0430\u0445, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u0441 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u043e\u0439.
    \u041e\u0434\u043d\u0430\u043a\u043e \u044e\u0440\u0438\u0441\u043f\u0440\u0443\u0434\u0435\u043d\u0446\u0438\u044f
    \u043d\u0435 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u0438\u0435\u043c. \u0412\u0441\u0451 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0449\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e\u0442 14-\u043b\u0435\u0442\u043d\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0431\u043e\u043b\u0435\u0435 300
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u0431\u043e\u0442,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0441\u0432\u043e\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u00ab\u041c\u0435\u043c\u0443\u0430\u0440\u044b \u043e \u043a\u0432\u0430\u043d\u0442\u0430\u0445\u00bb
    (\u0441\u0435\u0440\u0438\u044f \u0438\u0437 10 \u0440\u0430\u0431\u043e\u0442, 1854\u20131878).
    \u0412 \u041b\u043e\u043d\u0434\u043e\u043d\u0435 \u043e\u043d \u0447\u0430\u0441\u0442\u043e
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0441\u044f \u0438 \u0433\u0443\u043b\u044f\u043b
    \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0414\u0436\u0435\u0439\u043c\u0441\u043e\u043c \u0414\u0436\u043e\u0437\u0435\u0444\u043e\u043c
    \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u043e\u043c, \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044e \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432.\n\n\U0001F393
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0430 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435
    \u0412 1863 \u0433\u043e\u0434\u0443 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435
    \u0431\u044b\u043b\u0430 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0430 \u043d\u043e\u0432\u0430\u044f
    \u0421\u044d\u0434\u043b\u0435\u0440\u043e\u0432\u0441\u043a\u0430\u044f \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0430
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0438 \u043d\u0430 \u043d\u0435\u0451 \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0410\u0440\u0442\u0443\u0440 \u041a\u044d\u043b\u0438. \u041e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0434\u043e\u0445\u043e\u0434\u043d\u0443\u044e \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u0441\u043a\u0443\u044e
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443 \u0440\u0430\u0434\u0438 \u0433\u043e\u0440\u0430\u0437\u0434\u043e
    \u0431\u043e\u043b\u0435\u0435 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0433\u043e \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u044f
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430, \u043d\u043e \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043e\u0431 \u044d\u0442\u043e\u043c \u043d\u0435 \u0436\u0430\u043b\u0435\u043b, \u0442\u0430\u043a
    \u043a\u0430\u043a \u043d\u0430\u043a\u043e\u043d\u0435\u0446 \u0441\u043c\u043e\u0433 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0421\u044c\u044e\u0437\u0435\u043d \u041c\u043e\u043b\u0430\u0439\u043d,
    \u0434\u043e\u0447\u0435\u0440\u0438 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0431\u0430\u043d\u043a\u0438\u0440\u0430. \u041a\u044d\u043b\u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u044d\u0442\u0443 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438. \u041e\u043d \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0439
    \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440 \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u0432\u044b\u0441\u0448\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0434\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043b\u0435\u0442 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u044f
    \u0441\u043e\u0432\u0435\u0442 \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430 \u041d\u044c\u044e\u043d\u0445\u0435\u043c
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435. \u041e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 26 \u044f\u043d\u0432\u0430\u0440\u044f
    1895 \u0433\u043e\u0434\u0430.\n\n\U0001F52C \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0410\u0440\u0442\u0443\u0440
    \u041a\u044d\u043b\u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435,
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0441\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412\u043e\u0442 \u0435\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f:
    \u0422\u0435\u043e\u0440\u0438\u044f \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432:
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u043e\u043c
    \u043e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u044d\u0442\u043e\u0439
    \u0432\u0430\u0436\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u044b,
    \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0435\u0439 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f
    \u043f\u0440\u0438 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u0445.
    \u0422\u0435\u043e\u0440\u0438\u044f \u043c\u0430\u0442\u0440\u0438\u0446: \u041a\u044d\u043b\u0438
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0440\u0438\u0446. \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430-\u041a\u044d\u043b\u0438, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043a\u0430\u0436\u0434\u0430\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u0430\u044f
    \u043c\u0430\u0442\u0440\u0438\u0446\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043a\u043e\u0440\u043d\u0435\u043c \u0441\u0432\u043e\u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u0430. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0433\u0440\u0443\u043f\u043f: \u041e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0434\u0430\u043b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b
    \u043a\u0430\u043a \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0441 \u0431\u0438\u043d\u0430\u0440\u043d\u043e\u0439
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439, \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u044e\u0449\u0435\u0439
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c,
    \u043e\u0442\u0434\u0435\u043b\u0438\u0432 \u044d\u0442\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u043e\u0442 \u0433\u0440\u0443\u043f\u043f \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a.
    \u0412 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u044b
    \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u041a\u044d\u043b\u0438, \u0433\u0440\u0430\u0444
    \u041a\u044d\u043b\u0438 \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u041a\u044d\u043b\u0438.
    \u0410\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f:
    \u041e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u044d\u0442\u043e\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b. \u0412\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0414\u0436\u043e\u0440\u0434\u0436\u0435\u043c \u0421\u0430\u043b\u043c\u043e\u043d\u043e\u043c
    \u043e\u0442\u043a\u0440\u044b\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043e 27 \u043f\u0440\u044f\u043c\u044b\u0445
    \u043d\u0430 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438.
    \u041d\u0435\u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f:
    \u041a\u044d\u043b\u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0438 \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0435\u043c\u0443
    \u0434\u0430\u0442\u044c \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u0443\u044e
    \u043c\u043e\u0434\u0435\u043b\u044c \u0434\u043b\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u043e\u0433\u043e. \u042d\u0442\u0430
    \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u0437\u0436\u0435 \u0431\u044b\u043b\u0430
    \u0440\u0430\u0437\u0432\u0438\u0442\u0430 \u0424\u0435\u043b\u0438\u043a\u0441\u043e\u043c
    \u041a\u043b\u0435\u0439\u043d\u043e\u043c \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u043a\u0430\u043a \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044f
    \u041a\u044d\u043b\u0438-\u041a\u043b\u0435\u0439\u043d\u0430. \u0414\u0440\u0443\u0433\u0438\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438: \u041e\u043d \u0432\u043d\u0451\u0441 \u0432\u0430\u0436\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0432
    \u0432 1876 \u0433\u043e\u0434\u0443 \u00ab\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0439
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u00bb), \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0443
    (\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u041a\u044d\u043b\u0438 \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0430 \u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432),
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439
    \u0438 \u0430\u0441\u0442\u0440\u043e\u0444\u0438\u0437\u0438\u043a\u043e\u0439.\n\n\U0001F3C6
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    \u041c\u0430\u0441\u0448\u0442\u0430\u0431 \u0442\u0430\u043b\u0430\u043d\u0442\u0430 \u041a\u044d\u043b\u0438
    \u0431\u044b\u043b \u0448\u0438\u0440\u043e\u043a\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438. \u041e\u043d \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (\u0438\u0437\u0431\u0440\u0430\u043d \u0432
    1852 \u0433\u043e\u0434\u0443), \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043c\u0435\u0434\u0430\u043b\u0438 (1859), \u041c\u0435\u0434\u0430\u043b\u0438 \u041a\u043e\u043f\u043b\u0438
    (1882) \u0438 \u043f\u0435\u0440\u0432\u043e\u0439 \u041c\u0435\u0434\u0430\u043b\u0438
    \u0434\u0435 \u041c\u043e\u0440\u0433\u0430\u043d\u0430 \u043e\u0442 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (1884), \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d \u0431\u044b\u043b \u0441
    1868 \u043f\u043e 1870 \u0433\u043e\u0434. \u0415\u0433\u043e \u0438\u043c\u044f \u0442\u0430\u043a\u0436\u0435
    \u043d\u043e\u0441\u0438\u0442 \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0410\u0440\u0442\u0443\u0440\u0430 \u041a\u044d\u043b\u0438
    \u043f\u043e\u043b\u043d\u0430 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u043d\u043e \u0438 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u043e\u043c \u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0435,
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0432\u0448\u0435\u043c \u0441\u0435\u0431\u044f
    \u0441\u0442\u0440\u0430\u0441\u0442\u0438 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.\n\n\U0001F913
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e, \u043e\u0434\u0430\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0432\u044b\u0431\u043e\u0440 \u043f\u0443\u0442\u0438 \u0415\u0449\u0435 \u0432
    \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u041a\u044d\u043b\u0438 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b
    \u043d\u0435\u0437\u0430\u0443\u0440\u044f\u0434\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u2014 \u043e\u043d \u0440\u0435\u0448\u0430\u043b
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0440\u0430\u0434\u0438 \u0437\u0430\u0431\u0430\u0432\u044b. \u0415\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u0435\u043d,
    \u0447\u0442\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0432 \u0448\u043a\u043e\u043b\u0435
    \u041a\u0438\u043d\u0433\u0441-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043b\u0438 \u043e\u0442\u0446\u0443
    \u043d\u0435 \u043f\u0440\u0438\u043e\u0431\u0449\u0430\u0442\u044c \u0441\u044b\u043d\u0430
    \u043a \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u043c\u0443 \u0431\u0438\u0437\u043d\u0435\u0441\u0443,
    \u0430 \u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u0435\u0433\u043e \u043a \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044e
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 17 \u043b\u0435\u0442 \u043e\u043d
    \u0443\u0436\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0430 \u2014 \u044d\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u043b\u043e\u0441\u044c
    \u043d\u0435\u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u0440\u0430\u043d\u043d\u0438\u043c
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043e\u043c \u0434\u043b\u044f \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f. \u0422\u0430\u043c \u043e\u043d \u043f\u0440\u0435\u0443\u0441\u043f\u0435\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u043e \u0438 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u044f\u0437\u044b\u043a\u0430\u0445, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439,
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439, \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439
    \u0438 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439.\n\n\u2696\ufe0f
    \u041a\u0430\u0440\u044c\u0435\u0440\u0430 \u044e\u0440\u0438\u0441\u0442\u0430 \u0438 \u044d\u043f\u043e\u0445\u0430
    \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0433\u0443\u043b\u043e\u043a\u00bb \u041e\u0434\u0438\u043d \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u2014 \u044d\u0442\u043e
    14-\u043b\u0435\u0442\u043d\u044f\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u043f\u0440\u0435\u0443\u0441\u043f\u0435\u0432\u0430\u044e\u0449\u0435\u0433\u043e
    \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u0430, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u043c \u043f\u0440\u0430\u0432\u0435.
    \u0425\u043e\u0442\u044f \u0435\u0433\u043e \u0434\u043e\u0445\u043e\u0434 \u043a\u0430\u043a
    \u044e\u0440\u0438\u0441\u0442\u0430 \u0431\u044b\u043b \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0432\u044b\u0448\u0435 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u0433\u043e
    \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u044f, \u043e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0436\u0430\u043b\u0435\u043b \u043e\u0431 \u0443\u0445\u043e\u0434\u0435
    \u0438\u0437 \u044e\u0440\u0438\u0441\u043f\u0440\u0443\u0434\u0435\u043d\u0446\u0438\u0438,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c
    \u0441\u0435\u0431\u044f \u043d\u0430\u0443\u043a\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0435\u0433\u043e \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439 \u043f\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044f\u043c \u0441\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0414\u0436\u0435\u0439\u043c\u0441 \u0414\u0436\u043e\u0437\u0435\u0444 \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440.
    \u0423 \u043d\u0438\u0445 \u0431\u044b\u043b\u0430 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f
    \u0433\u0443\u043b\u044f\u0442\u044c \u0432\u043c\u0435\u0441\u0442\u0435 \u043f\u043e \u0434\u0432\u043e\u0440\u0430\u043c
    \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0441-\u0418\u043d\u043d\u0430 (\u0441\u0443\u0434\u0435\u0431\u043d\u043e\u0433\u043e
    \u0438\u043d\u043d\u0430 \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0435), \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044e \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0438 \u043a\u043e\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432. \u0418 \u0438\u043c\u0435\u043d\u043d\u043e
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u0441\u043a\u043e\u0439
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438, \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f, \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043e\u0442 200 \u0434\u043e 300 \u0441\u0432\u043e\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442. \u0415\u0449\u0451 \u043e\u0434\u0438\u043d \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u044b\u0439
    \u044d\u043f\u0438\u0437\u043e\u0434: \u0433\u043e\u0442\u043e\u0432\u044f\u0441\u044c \u043a
    \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u0441\u043a\u043e\u043c\u0443 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0443,
    \u041a\u044d\u043b\u0438 \u0441\u044a\u0435\u0437\u0434\u0438\u043b \u0432 \u0414\u0443\u0431\u043b\u0438\u043d,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0420\u043e\u0443\u044d\u043d\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u043e \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u0430\u0445.\n\n\U0001F3E1
    \u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0441\u0447\u0430\u0441\u0442\u044c\u0435
    \u0438 \u0437\u0430\u0432\u0438\u0441\u0442\u044c \u041a\u043e\u0433\u0434\u0430 \u0432
    1863 \u0433\u043e\u0434\u0443 \u041a\u044d\u043b\u0438 \u043d\u0430\u043a\u043e\u043d\u0435\u0446
    \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435, \u043e\u043d \u0441\u0440\u0430\u0437\u0443
    \u0436\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0438, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u0435\u0433\u043e
    \u0434\u043e\u043c \u0431\u044b\u043b \u043f\u043e\u043b\u043e\u043d \u0441\u0447\u0430\u0441\u0442\u044c\u044f.
    \u042d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u044f\u0440\u043a\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u0443\u0435\u0442
    \u0441 \u0436\u0438\u0437\u043d\u044c\u044e \u0435\u0433\u043e \u0434\u0440\u0443\u0433\u0430
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u041a\u044d\u043b\u0438, \u0442\u0430\u043a \u0438 \u043d\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f.
    \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440 \u043a\u0430\u043a-\u0442\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u041a\u044d\u043b\u0438 \u0431\u044b\u043b \u0433\u043e\u0440\u0430\u0437\u0434\u043e
    \u0443\u0434\u0430\u0447\u043b\u0438\u0432\u0435\u0435 \u0435\u0433\u043e \u0432 \u0436\u0438\u0437\u043d\u0438:
    \u043e\u043d \u043e\u0431\u0440\u0435\u043b \u0442\u0438\u0445\u0443\u044e \u0438 \u043c\u0438\u0440\u043d\u0443\u044e
    \u0441\u0435\u043c\u0435\u0439\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0442\u043e\u0433\u0434\u0430 \u043a\u0430\u043a \u043e\u043d \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c
    \u00ab\u0441\u0440\u0430\u0436\u0430\u043b\u0441\u044f \u0441\u043e \u0432\u0441\u0435\u043c
    \u043c\u0438\u0440\u043e\u043c\u00bb.\n\n\U0001F3A8 \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f:
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0446\u0438\u0444\u0440\u044b, \u043d\u043e
    \u0438 \u043a\u0438\u0441\u0442\u0438 \u0423 \u041a\u044d\u043b\u0438 \u0431\u044b\u043b\u0438
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b. \u041e\u043d \u043f\u0438\u0442\u0430\u043b
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u0447\u0442\u0435\u043d\u0438\u044e \u0440\u043e\u043c\u0430\u043d\u043e\u0432,
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f\u043c \u0438 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u0438.
    \u041e\u043d \u0441\u0430\u043c \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u0430\u043a\u0432\u0430\u0440\u0435\u043b\u044c\u043d\u043e\u0439
    \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u044c\u044e \u0438 \u0434\u0430\u0436\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u043b
    \u044d\u0442\u043e\u043c\u0443 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043d\u0430\u0432\u044b\u043a\u0438 \u0440\u0438\u0441\u043e\u0432\u0430\u043d\u0438\u044f
    \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0441\u0432\u043e\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0438\u0430\u0433\u0440\u0430\u043c\u043c.\n\n\U0001F9E9
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0432 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f\u0445
    \u041f\u043b\u043e\u0434\u043e\u0432\u0438\u0442\u043e\u0441\u0442\u044c \u041a\u044d\u043b\u0438
    \u0438 \u0432\u043a\u043b\u0430\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d
    \u0432\u043d\u0435\u0441 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u043e\u0442\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u0432 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u043c
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432,
    \u043d\u043e\u0441\u044f\u0449\u0438\u0445 \u0435\u0433\u043e \u0438\u043c\u044f. \u0421\u0440\u0435\u0434\u0438
    \u043d\u0438\u0445: \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0438 \u0433\u0440\u0430\u0444
    \u041a\u044d\u043b\u0438. \u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u041a\u044d\u043b\u0438.
    \u0421\u0435\u043a\u0441\u0442\u0438\u043a\u0430 \u041a\u044d\u043b\u0438 (\u043a\u0440\u0438\u0432\u0430\u044f)
    \u0438 \u0434\u0430\u0436\u0435 \u0438\u0433\u0440\u0430 \u00ab\u041c\u044b\u0448\u0435\u043b\u043e\u0432\u043a\u0430
    \u041a\u044d\u043b\u0438\u00bb \u2014 \u0437\u0430\u0434\u0430\u0447\u0430-\u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430
    \u0441 \u043a\u0430\u0440\u0442\u0430\u043c\u0438. \u041a\u0440\u0430\u0442\u0435\u0440
    \u041a\u044d\u043b\u0438 \u043d\u0430 \u041b\u0443\u043d\u0435.\n\n\U0001F4DC \u041c\u0430\u0441\u0448\u0442\u0430\u0431
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f \u041e\u0431\u0449\u0435\u0435 \u0447\u0438\u0441\u043b\u043e
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442
    900, \u0430 \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c
    \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442 967. \u041f\u043e\u0437\u0434\u043d\u0435\u0435,
    \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    \u041a\u044d\u043b\u0438 \u043b\u0438\u0447\u043d\u043e \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0435\u043c\u044c \u0442\u043e\u043c\u043e\u0432 \u0441\u0432\u043e\u0438\u0445 \u0441\u0431\u043e\u0440\u043d\u0438\u043a\u043e\u0432,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044e\u044e \u0431\u043e\u043b\u0435\u0437\u043d\u044c.
    \u0415\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u044b \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435
    \u0441\u0442\u0430\u043b\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u0435\u043c \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u0438 \u0438\u0437
    \u0420\u043e\u0441\u0441\u0438\u0438 \u0438 \u0410\u043c\u0435\u0440\u0438\u043a\u0438."
