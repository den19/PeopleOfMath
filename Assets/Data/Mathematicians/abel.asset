  achievementsRu: "\U0001F4DC 1823: \u041f\u0435\u0440\u0432\u044b\u0435 \u0448\u0430\u0433\u0438 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u042d\u0442\u043e\u0442 \u0433\u043e\u0434
    \u043e\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043b\u0441\u044f \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u041e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0443\u044e
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0435\u043c\u043e\u0441\u0442\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0425\u043e\u0442\u044f \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044c
    \u043d\u0435 \u0431\u044b\u043b\u0430 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430
    \u0438 \u043f\u043e\u0437\u0436\u0435 \u0437\u0430\u0442\u0435\u0440\u044f\u043b\u0430\u0441\u044c,
    \u043e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u0436\u043d\u043e\u0439 \u0432\u0435\u0445\u043e\u0439,
    \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0410\u0431\u0435\u043b\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e. \u041f\u043e \u0441\u0443\u0442\u0438,
    \u043e\u043d \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445,
    \u043a\u0442\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0440\u0435\u0448\u0438\u043b \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435.\n\n\u2694\ufe0f 1824: \u0412\u0435\u043b\u0438\u043a\u0430\u044f
    \u043f\u043e\u0431\u0435\u0434\u0430 \u043d\u0430\u0434 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435\u043c
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    21 \u0433\u043e\u0434\u0430 \u0410\u0431\u0435\u043b\u044c \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043f\u0440\u043e\u0440\u044b\u0432 \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0435.
    \u041e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0437\u0430
    \u0441\u0432\u043e\u0439 \u0441\u0447\u0435\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438
    \u043e\u0431\u0449\u0435\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0432 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u0430\u0445.
    \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e
    \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0435\u0434\u0438\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0449\u0435\u0439
    \u043b\u0438\u0448\u044c \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u043a\u043e\u0440\u043d\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043c\u043e\u0433\u043b\u0430
    \u0431\u044b \u0434\u0430\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0434\u043b\u044f
    \u043b\u044e\u0431\u043e\u0433\u043e \u0442\u0430\u043a\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043e\u043d
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u0441\u0432\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u041a\u0430\u0440\u043b\u0443 \u0413\u0430\u0443\u0441\u0441\u0443, \u043d\u043e \u0442\u043e\u0442
    \u043d\u0435 \u043e\u0446\u0435\u043d\u0438\u043b \u0435\u0435 \u0432\u0430\u0436\u043d\u043e\u0441\u0442\u044c.
    \u041d\u0430 \u044d\u0442\u0443 \u0440\u0430\u0431\u043e\u0442\u0443 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043e\u043f\u0438\u0440\u0430\u043b\u0441\u044f \u042d\u0432\u0430\u0440\u0438\u0441\u0442
    \u0413\u0430\u043b\u0443\u0430, \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u044f \u0441\u0432\u043e\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e.\n\n\u270d\ufe0f 1825\u20131826: \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0436\u0443\u0440\u043d\u0430\u043b\u0430 \u041a\u0440\u0435\u043b\u043b\u0435 \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u044f
    \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435, \u0410\u0431\u0435\u043b\u044c \u043f\u0440\u043e\u0432\u0435\u043b
    \u0437\u0438\u043c\u0443 1825\u20131826 \u0433\u043e\u0434\u043e\u0432 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435.
    \u0422\u0430\u043c \u043e\u043d \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b \u0410\u0432\u0433\u0443\u0441\u0442\u0430
    \u041a\u0440\u0435\u043b\u043b\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u00abJournal f\u00fcr die
    reine und angewandte Mathematik\u00bb (\u0416\u0443\u0440\u043d\u0430\u043b \u041a\u0440\u0435\u043b\u043b\u0435).
    \u0410\u0431\u0435\u043b\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432
    \u0436\u0443\u0440\u043d\u0430\u043b\u0430, \u043d\u043e \u0438 \u043e\u043a\u0430\u0437\u0430\u043b
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443
    \u044d\u0442\u043e\u043c\u0443 \u043d\u0430\u0447\u0438\u043d\u0430\u043d\u0438\u044e. \u0412
    \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b:
    \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u0443\u044e \u0432\u0435\u0440\u0441\u0438\u044e
    \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0431 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445,
    \u0433\u0434\u0435 \u0431\u043e\u043b\u0435\u0435 \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u044c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0432\u044b\u0448\u0435 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u043e\u0439
    \u0432 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u0430\u0445 \u0438 \u043f\u0440\u0438\u0432\u0435\u043b
    \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u043f\u0440\u0438\u043c\u0435\u0440\u044b
    \u0442\u0430\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u041d\u0430\u0447\u0430\u043b\u043e
    \u0440\u0430\u0431\u043e\u0442 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043f\u043e\u043b\u043e\u0436\u0438\u0432 \u043d\u0430\u0447\u0430\u043b\u043e
    \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044e \u0441 \u041a\u0430\u0440\u043b\u043e\u043c
    \u0413\u0443\u0441\u0442\u0430\u0432\u043e\u043c \u042f\u043a\u043e\u0431\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e \u043d\u0430\u0443\u043a\u0435 \u043e\u0433\u0440\u043e\u043c\u043d\u0443\u044e
    \u043f\u043e\u043b\u044c\u0437\u0443.\n\n\U0001F1EB\U0001F1F7 1826: \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u043c\u0435\u043c\u0443\u0430\u0440 \u0438 \u0443\u0442\u0435\u0440\u044f\u043d\u043d\u044b\u0439
    \u0448\u0435\u0434\u0435\u0432\u0440 \u041b\u0435\u0442\u043e\u043c 1826 \u0433\u043e\u0434\u0430
    \u0410\u0431\u0435\u043b\u044c \u043f\u0440\u0438\u0431\u044b\u043b \u0432 \u041f\u0430\u0440\u0438\u0436
    \u2014 \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u041e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u043e\u043c \u0438 \u041a\u043e\u0448\u0438 \u0438
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u2014 \u043c\u0435\u043c\u0443\u0430\u0440 \u043e \u0442\u0440\u0430\u043d\u0441\u0446\u0435\u043d\u0434\u0435\u043d\u0442\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0410\u0431\u0435\u043b\u044f \u043e\u0431 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u0445
    \u043e\u0442 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. \u041e\u0434\u043d\u0430\u043a\u043e \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044c,
    \u043f\u043e\u0434\u0430\u043d\u043d\u0430\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a, \u0431\u044b\u043b\u0430
    \u0443\u0442\u0435\u0440\u044f\u043d\u0430 \u0441\u0430\u043c\u0438\u043c \u041a\u043e\u0448\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0442\u043b\u043e\u0436\u0438\u043b \u0435\u0435
    \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443. \u0420\u0430\u0431\u043e\u0442\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0439\u0434\u0435\u043d\u0430 \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430
    \u043b\u0438\u0448\u044c \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e, \u0432
    1841 \u0433\u043e\u0434\u0443. \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043d\u0430\u0437\u0432\u0430\u043b \u044d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u00ab\u043d\u0435\u0440\u0443\u043a\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u043e\u043c\u00bb
    \u0410\u0431\u0435\u043b\u044e. \u0412 \u0442\u043e\u043c \u0436\u0435 1826 \u0433\u043e\u0434\u0443
    \u0410\u0431\u0435\u043b\u044c \u043f\u0440\u0438\u0432\u0435\u043b \u043a\u043e\u043d\u0442\u0440\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u041a\u043e\u0448\u0438 \u043e \u0441\u0443\u043c\u043c\u0435
    \u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0433\u043e\u0441\u044f \u0440\u044f\u0434\u0430
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0439
    \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438.\n\n\u23f3 1827\u20131828:
    \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0442\u0440\u0443\u0434\u044b
    \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432 \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u044e
    \u0432 1827 \u0433\u043e\u0434\u0443, \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044c
    \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. \u041e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u00abRecherches sur les Fonctions
    elliptiques\u00bb, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430
    \u043f\u0435\u0440\u0432\u044b\u043c \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c. \u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u044d\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043a\u0430\u043a \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u0435
    \u043a \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u043c
    \u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u043b \u0438\u0445
    \u043d\u0430 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c.
    \u0412 1828 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u044c \u0438 \u0443\u0445\u0443\u0434\u0448\u0430\u044e\u0449\u0435\u0435\u0441\u044f
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043d\u0430\u0443\u043a\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0431\u043e\u0433\u0430\u0442\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u0447\u0442\u043e, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c
    \u0428\u0430\u0440\u043b\u044f \u042d\u0440\u043c\u0438\u0442\u0430, \u00ab\u0438\u043c
    \u0431\u0443\u0434\u0435\u0442 \u0447\u0435\u043c \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0435 500 \u043b\u0435\u0442\u00bb.
    \u0415\u0433\u043e \u0438\u043c\u044f \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u043e\u0441\u044f\u0442
    \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432, \u043e\u0442 \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432
    \u0434\u043e \u0442\u0435\u043e\u0440\u0435\u043c \u0438 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439."
  achievementsEn: "📜 1823: First steps and integral equations This year marked the beginning of his independent research. He presented his first significant work on the integrability of differential equations. Although the manuscript was not published and was later lost, it was a milestone for which Abel received a government scholarship. In fact, he became one of the first to formulate and solve the integral equation.\n\n⚔️ 1824: Great victory over the fifth degree equation At the age of 21, Abel made a breakthrough in algebra. He published at his own expense a proof of the theorem on the unsolvability of a general fifth-degree equation in radicals. This meant that there was no single formula, using only arithmetic and roots, that could provide a solution to any such equation. Interestingly, he sent his work to Carl Gauss, but he did not appreciate its importance. Évariste Galois subsequently relied on this work when creating his theory.\n\n✍️ 1825–1826: Berlin period and the birth of the Krelle magazine Traveling through Europe, Abel spent the winter of 1825–1826 in Berlin. There he met August Krelle, who founded the famous \"Journal für die reine und angewandte Mathematik\" (Krelle's Journal). Abel not only became one of the first authors of the magazine, but also provided significant support for this endeavor. During this period, he published: An expanded version of his work on equations, where he more strictly proved the unsolvability of equations of degree higher than four in radicals and gave specific examples of such equations. Beginning of work on the theory of elliptic functions, marking the beginning of a competition with Carl Gustav Jacobi, which brought great benefits to science.\n\n🇫🇷 1826: A Parisian memoir and a lost masterpiece In the summer of 1826, Abel arrived in Paris, the center of the mathematical world of that time. He met Legendre and Cauchy and prepared his main work - a memoir on transcendental functions, containing Abel's famous theorem on integrals of algebraic functions. However, the manuscript submitted to the Paris Academy of Sciences was lost by Cauchy himself, who put it aside. The work was found and published only posthumously, in 1841. Legendre later called this discovery “a miraculous monument” to Abel. Also in 1826, Abel gave a counterexample that disproved Cauchy's theorem on the sum of a convergent series of continuous functions, showing the necessity of the concept of uniform convergence.\n\n⏳ 1827–1828: Completion of the theory and last works Returning to Norway in 1827, he continued to actively develop the theory of elliptic functions. He published his work \"Recherches sur les Fonctions elliptiques\", which became the first ever published work on elliptic functions. He defined these functions as inverses of elliptic integrals and extended them to the complex domain. In 1828 he was elected a member of the Royal Scientific Society of Norway. Despite poverty and deteriorating health, he left such a rich legacy to science that, in the words of Charles Hermite, “they will have something to do for the next 500 years.” Dozens of mathematical objects now bear his name, from Abelian groups and integrals to theorems and transformations."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041d\u0438\u043b\u044c\u0441\u0430
    \u0425\u0435\u043d\u0440\u0438\u043a\u0430 \u0410\u0431\u0435\u043b\u044f \u2014 \u044d\u0442\u043e
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043b\u044e\u0431\u0432\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u0430\u043a
    \u0438 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0430
    \u0438\u0437-\u0437\u0430 \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438 \u0440\u0430\u043d\u043d\u0435\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0443\u0447\u0435\u043d\u043e\u0433\u043e. \u0412\u043e\u0442
    \u0435\u0435 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f:\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u044e\u043d\u043e\u0441\u0442\u044c (1802-1821):
    \u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f
    \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 1802 \u0433\u043e\u0434, 5
    \u0430\u0432\u0433\u0443\u0441\u0442\u0430: \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u041d\u0438\u043b\u044c\u0441\u0430 \u0425\u0435\u043d\u0440\u0438\u043a\u0430 \u0432 \u0441\u0435\u043c\u044c\u0435
    \u043f\u0430\u0441\u0442\u043e\u0440\u0430 \u0421\u0451\u0440\u0435\u043d\u0430 \u0413\u0435\u043e\u0440\u0433\u0430
    \u0410\u0431\u0435\u043b\u044f \u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432\u0435 \u0424\u0438\u043d\u043d\u0451\u0439.
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e: \u0421\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430
    \u043c\u043d\u043e\u0433\u043e\u0434\u0435\u0442\u043d\u043e\u0439 (\u0410\u0431\u0435\u043b\u044c
    \u0431\u044b\u043b \u0432\u0442\u043e\u0440\u044b\u043c \u0438\u0437 \u0441\u0435\u043c\u0438
    \u0434\u0435\u0442\u0435\u0439), \u0438 \u0435\u0433\u043e \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438
    \u043d\u0435 \u0434\u0430\u0432\u0430\u043b\u0438 \u0435\u043c\u0443 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438. \u041e\u0442\u0435\u0446 \u0441\u0442\u0440\u0430\u0434\u0430\u043b
    \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c\u043e\u043c, \u0430 \u043c\u0430\u0442\u044c
    \u0442\u0430\u043a\u0436\u0435 \u0438\u043c\u0435\u043b\u0430 \u043f\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u0438\u0435
    \u043a \u0441\u043f\u0438\u0440\u0442\u043d\u043e\u043c\u0443. 1820 \u0433\u043e\u0434:
    \u0421\u043c\u0435\u0440\u0442\u044c \u043e\u0442\u0446\u0430. \u041d\u0430 \u043f\u043b\u0435\u0447\u0438
    18-\u043b\u0435\u0442\u043d\u0435\u0433\u043e \u041d\u0438\u043b\u044c\u0441\u0430 \u043b\u043e\u0436\u0438\u0442\u0441\u044f
    \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0437\u0430 \u0441\u0435\u043c\u044c\u044e \u0438\u0437 \u0448\u0435\u0441\u0442\u0438
    \u0434\u0435\u0442\u0435\u0439. \u0427\u0442\u043e\u0431\u044b \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c
    \u0436\u0438\u0437\u043d\u044c \u043c\u0430\u0442\u0435\u0440\u0438, \u043e\u043d \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
    \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0431\u0440\u0430\u0442\u044c\u0435\u0432
    \u043a \u0441\u0435\u0431\u0435 \u043d\u0430 \u043f\u043e\u043f\u0435\u0447\u0435\u043d\u0438\u0435
    \u0438 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0440\u0435\u043f\u0435\u0442\u0438\u0442\u043e\u0440\u0441\u0442\u0432\u043e\u043c.\n\n\U0001F496
    \u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0438 \u043e\u0431\u0440\u0443\u0447\u0435\u043d\u0438\u0435
    (1823\u20131824) 1823 \u0433\u043e\u0434, \u043b\u0435\u0442\u043e: \u0410\u0431\u0435\u043b\u044c
    \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043f\u043e\u0435\u0437\u0434\u043a\u0443
    \u0432 \u041a\u043e\u043f\u0435\u043d\u0433\u0430\u0433\u0435\u043d \u0434\u043b\u044f \u0432\u0441\u0442\u0440\u0435\u0447\u0438
    \u0441 \u0434\u0430\u0442\u0441\u043a\u0438\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438.
    \u041d\u0430 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0431\u0430\u043b\u043e\u0432
    \u043e\u043d \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u0441\u044f \u0441 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u043e\u0439
    (\"\u041a\u0440\u0435\u043b\u043b\u0438\") \u041a\u0435\u043c\u043f, 19-\u043b\u0435\u0442\u043d\u0435\u0439
    \u0434\u0435\u0432\u0443\u0448\u043a\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f,
    \u043a\u0430\u043a \u0438 \u043e\u043d \u0441\u0430\u043c\u0430, \u0431\u044b\u043b\u0430
    \u0431\u0435\u0434\u043d\u0430 \u0438 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b\u0430
    \u043d\u0430 \u0436\u0438\u0437\u043d\u044c \u0440\u0435\u043f\u0435\u0442\u0438\u0442\u043e\u0440\u0441\u0442\u0432\u043e\u043c.
    1824 \u0433\u043e\u0434, \u0420\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043e: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u044f\u0436\u0435\u043b\u043e\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0410\u0431\u0435\u043b\u044c \u0438
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430 \u043f\u0440\u0430\u0437\u0434\u043d\u0443\u044e\u0442
    \u0441\u0432\u043e\u044e \u043f\u043e\u043c\u043e\u043b\u0432\u043a\u0443. \u041e\u043d\u0438
    \u0441\u0442\u0440\u043e\u044f\u0442 \u043f\u043b\u0430\u043d\u044b \u043d\u0430 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c, \u043d\u043e \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e
    \u0410\u0431\u0435\u043b\u044e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e
    \u043d\u0430\u0439\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u043e \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u043c\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443.\n\n\U0001F6B6\u200d\u2642\ufe0f \u0420\u0430\u0437\u043b\u0443\u043a\u0430
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u0437\u0438\u043c\u0430 (1825\u20131829)
    1825\u20131827: \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u044f \u043f\u043e
    \u0415\u0432\u0440\u043e\u043f\u0435 \u0441 \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u0446\u0435\u043b\u044f\u043c\u0438, \u0410\u0431\u0435\u043b\u044c \u043f\u043e\u0447\u0442\u0438
    \u0432\u0441\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f
    \u0432 \u0440\u0430\u0437\u043b\u0443\u043a\u0435 \u0441\u043e \u0441\u0432\u043e\u0435\u0439
    \u043d\u0435\u0432\u0435\u0441\u0442\u043e\u0439. \u041a\u043e\u043d\u0435\u0446 1828 \u0433\u043e\u0434\u0430:
    \u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0410\u0431\u0435\u043b\u044f \u0440\u0435\u0437\u043a\u043e \u0443\u0445\u0443\u0434\u0448\u0430\u0435\u0442\u0441\u044f.
    \u041e\u043d \u0440\u0435\u0448\u0430\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438
    \u0420\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043e 1828 \u0433\u043e\u0434\u0430 \u0441
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u043e\u0439 \u0432\u043e \u0424\u0440\u043e\u043b\u0430\u043d\u0434\u0435,
    \u0433\u0434\u0435 \u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u0433\u0443\u0432\u0435\u0440\u043d\u0430\u043d\u0442\u043a\u043e\u0439
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0435\u0433\u043e \u0434\u0440\u0443\u0437\u0435\u0439.
    1829 \u0433\u043e\u0434, 6 \u0430\u043f\u0440\u0435\u043b\u044f: \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0432\u0438\u0437\u0438\u0442\u0430 \u043a \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0435
    \u0410\u0431\u0435\u043b\u044c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u0435\u0442
    \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043e\u043c \u0438 \u0443\u043c\u0438\u0440\u0430\u0435\u0442.
    \u0415\u043c\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e 26 \u043b\u0435\u0442.
    \u0427\u0435\u0440\u0435\u0437 \u043d\u0435\u0434\u0435\u043b\u044e \u0435\u0433\u043e \u0445\u043e\u0440\u043e\u043d\u044f\u0442
    \u043d\u0430 \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435 \u0432\u043e \u0424\u0440\u043e\u043b\u0430\u043d\u0434\u0435.\n\n\U0001F494
    \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0422\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0435: \u041f\u0438\u0441\u044c\u043c\u043e
    \u043e\u0442 \u0434\u0440\u0443\u0433\u0430 \u0410\u0432\u0433\u0443\u0441\u0442\u0430 \u041a\u0440\u0435\u043b\u043b\u0435
    \u0441 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435
    \u043f\u0440\u0438\u0448\u043b\u043e \u0432 \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u044e
    \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043d\u044f \u043f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438. \u0421\u0443\u0434\u044c\u0431\u0430
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u044b: \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0410\u0431\u0435\u043b\u044f \u043e\u0434\u0438\u043d \u0438\u0437 \u0435\u0433\u043e
    \u0434\u0440\u0443\u0437\u0435\u0439, \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440 \u041a\u0435\u0439\u043b\u044c\u0445\u0430\u0443,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c
    \u0440\u0443\u043a\u0438 \u0438 \u0441\u0435\u0440\u0434\u0446\u0430. \u041f\u0435\u0440\u0435\u0434
    \u0441\u043c\u0435\u0440\u0442\u044c\u044e \u0410\u0431\u0435\u043b\u044c \u043f\u0440\u043e\u0441\u0438\u043b
    \u0435\u0433\u043e \u043f\u043e\u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f
    \u043e \u043d\u0435\u0432\u0435\u0441\u0442\u0435, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044f
    \u0435\u0451 \u043a\u0430\u043a \"\u043d\u0435 \u043a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0443,
    \u0440\u044b\u0436\u0435\u0432\u043e\u043b\u043e\u0441\u0443\u044e \u0438 \u0432\u0435\u0441\u043d\u0443\u0448\u0447\u0430\u0442\u0443\u044e,
    \u043d\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u043b\u0435\u043f\u043d\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430\". \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430
    \u043f\u0440\u0438\u043d\u044f\u043b\u0430 \u044d\u0442\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435."
  personalLifeEn: "The personal life of Niels Henrik Abel is a tragic love story that was never realized due to poverty and the early death of the scientist. Here is her chronology:\n\n👨‍👩‍👧‍👦 Childhood and youth (1802-1821): Difficult family situation 1802, August 5: Birth of Nils Henrik in the family of pastor Søren Georg Abel on the island of Finnøy. Childhood: The family had many children (Abel was the second of seven children), and his parents did not give him a quiet life. The father suffered from alcoholism, and the mother also had an addiction to alcohol. 1820: Death of father. 18-year-old Nils bears the responsibility of caring for a family of six children. To make his mother's life easier, he takes one of the brothers into his care and earns money by tutoring.\n\n💖 Meeting and betrothal (1823–1824) 1823, summer: Abel travels to Copenhagen to meet Danish mathematicians. At one of the balls, he meets Christina (\"Crelli\") Kemp, a 19-year-old girl who, like himself, was poor and made a living as a tutor. 1824, Christmas: Despite their difficult financial situation, Abel and Christina celebrate their engagement. They are making plans for a life together, but for this Abel needs to find a well-paid job.\n\n🚶‍♂️ Separation and the last winter (1825–1829) 1825–1827: Traveling around Europe for scientific purposes, Abel is almost always separated from his bride. Late 1828: Abel's health deteriorates sharply. He decides to spend Christmas 1828 with Christina in Froland, where she worked as a governess for a family of his friends. 1829, April 6: During a visit to Christina, Abel falls ill with tuberculosis and dies. He was only 26 years old. A week later he is buried in the cemetery in Froland.\n\n💔 After death Tragic coincidence: A letter from friend August Krelle offering a professorship in Berlin arrived in Norway two days after his death. Christina's fate: After Abel's death, one of his friends, Balthasar Keilhau, wrote a letter to Christina proposing marriage. Before his death, Abel asked him to take care of his bride, describing her as “not a beauty, red-haired and freckled, but a magnificent person.” Christina accepted this offer."
  shortBioRu: "\u041d\u0438\u043b\u044c\u0441 \u0425\u0435\u043d\u0440\u0438\u043a \u0410\u0431\u0435\u043b\u044c
    (1802\u20131829) \u2014 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u044f \u043a\u043e\u0440\u043e\u0442\u043a\u0430\u044f \u0436\u0438\u0437\u043d\u044c,
    \u043f\u043e\u043b\u043d\u0430\u044f \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438
    \u043b\u0438\u0448\u0435\u043d\u0438\u0439, \u0441\u0442\u0430\u043b\u0430 \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0432 \u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u044f\u0440\u043a\u0438\u0445
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u044b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0438 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439.\n\n\U0001F4DC \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u044e\u043d\u043e\u0441\u0442\u044c (1802\u20131821) 5 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1802 \u0433\u043e\u0434\u0430: \u0420\u043e\u0434\u0438\u043b\u0441\u044f \u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432\u0435
    \u0424\u0438\u043d\u043d\u0451\u0439, \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u044f,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u043f\u0430\u0441\u0442\u043e\u0440\u0430 \u0421\u0451\u0440\u0435\u043d\u0430
    \u0413\u0435\u043e\u0440\u0433\u0430 \u0410\u0431\u0435\u043b\u044f. \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u043e \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u043e \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u044c\u044e,
    \u0441\u043b\u0430\u0431\u044b\u043c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c
    \u0438 \u0440\u0430\u0437\u0434\u043e\u0440\u0430\u043c\u0438 \u0432 \u0441\u0435\u043c\u044c\u0435.
    1815 \u0433\u043e\u0434: \u041f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043a\u0430\u0444\u0435\u0434\u0440\u0430\u043b\u044c\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0438\u0438
    (\u043d\u044b\u043d\u0435 \u041e\u0441\u043b\u043e). \u041f\u0435\u0440\u0432\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0443\u0447\u0438\u043b\u0441\u044f \u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e.
    1817 \u0433\u043e\u0434: \u0412 \u0448\u043a\u043e\u043b\u0435 \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u043d\u043e\u0432\u044b\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0411\u0435\u0440\u0442 \u041c\u0438\u0445\u0430\u044d\u043b\u044c \u0425\u043e\u043b\u044c\u043c\u0431\u043e\u044d,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b
    \u0432 \u044e\u043d\u043e\u043c \u041d\u0438\u043b\u044c\u0441\u0435 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442 \u0438 \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c. \u0425\u043e\u043b\u044c\u043c\u0431\u043e\u044d
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b \u0410\u0431\u0435\u043b\u044f
    \u0441 \u0442\u0440\u0443\u0434\u0430\u043c\u0438 \u042d\u0439\u043b\u0435\u0440\u0430,
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430, \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0438 \u0413\u0430\u0443\u0441\u0441\u0430. 1820 \u0433\u043e\u0434: \u0423\u043c\u0438\u0440\u0430\u0435\u0442
    \u043e\u0442\u0435\u0446 \u0410\u0431\u0435\u043b\u044f. \u0421\u0435\u043c\u044c\u044f
    \u0441 \u0448\u0435\u0441\u0442\u044c\u044e \u0434\u0435\u0442\u044c\u043c\u0438 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u043d\u0430 \u0433\u0440\u0430\u043d\u0438 \u043d\u0438\u0449\u0435\u0442\u044b, \u0430
    \u0443 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u0434\u0443\u0448\u0435\u0432\u043d\u043e\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e.
    \u0412\u0441\u044f \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043b\u043e\u0436\u0438\u0442\u0441\u044f \u043d\u0430 18-\u043b\u0435\u0442\u043d\u0435\u0433\u043e
    \u041d\u0438\u043b\u044c\u0441\u0430.\n\n\U0001F393 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    (1821\u20131824) 1821 \u0433\u043e\u0434: \u041f\u0440\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435
    \u0425\u043e\u043b\u044c\u043c\u0431\u043e\u044d \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u041a\u0440\u0438\u0441\u0442\u043e\u0444\u0435\u0440\u0430
    \u0425\u0430\u043d\u0441\u0442\u0438\u043d\u0430 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0435\u0442
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0438\u0438.
    \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u043e\u0447\u044c \u0441\u0435\u043c\u044c\u0435,
    \u043e\u043d \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u043f\u043e\u0434\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c
    \u0440\u0435\u043f\u0435\u0442\u0438\u0442\u043e\u0440\u0441\u0442\u0432\u043e\u043c. 1822
    \u0433\u043e\u0434: \u041f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u00ab\u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb.
    \u0417\u0438\u043c\u0430 1822\u20131823: \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0443 \u0441\u0432\u043e\u044e
    \u043f\u0435\u0440\u0432\u0443\u044e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0435\u043c\u043e\u0441\u0442\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0420\u0443\u043a\u043e\u043f\u0438\u0441\u044c
    \u0431\u044b\u043b\u0430 \u0443\u0442\u0435\u0440\u044f\u043d\u0430, \u043d\u043e \u0437\u0430
    \u043d\u0435\u0435 \u0410\u0431\u0435\u043b\u044e \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b\u0438
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e. 1823 \u0433\u043e\u0434: \u0421\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u0442
    \u043f\u043e\u0435\u0437\u0434\u043a\u0443 \u0432 \u041a\u043e\u043f\u0435\u043d\u0433\u0430\u0433\u0435\u043d,
    \u0433\u0434\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u0441\u044f \u0441\u043e
    \u0441\u0432\u043e\u0435\u0439 \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u043d\u0435\u0432\u0435\u0441\u0442\u043e\u0439,
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u043e\u0439 \u041a\u0435\u043c\u043f. \u041f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442
    \u0441\u0432\u043e\u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0442\u0430\u0442\u044c\u0438
    \u0432 \u043d\u043e\u0432\u043e\u043c \u043d\u0430\u0443\u0447\u043d\u043e\u043c \u0436\u0443\u0440\u043d\u0430\u043b\u0435.
    1824 \u0433\u043e\u0434: \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 21 \u0433\u043e\u0434\u0430
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438
    \u043e\u0431\u0449\u0435\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0432 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u0430\u0445.
    \u0418\u0437\u0434\u0430\u0435\u0442 \u0441\u0432\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u043d\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435
    \u0437\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u0447\u0435\u0442,
    \u0441\u0442\u0440\u0435\u043c\u044f\u0441\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435. \u0412 \u0442\u043e\u043c \u0436\u0435
    \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u043e\u0431\u0440\u0443\u0447\u0430\u043b\u044c\u043d\u043e\u0435
    \u043a\u043e\u043b\u044c\u0446\u043e \u043e\u0442 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u044b.\n\n\u2708\ufe0f
    \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435
    (1825\u20131827) \u0421\u0435\u043d\u0442\u044f\u0431\u0440\u044c 1825 \u2013 \u0444\u0435\u0432\u0440\u0430\u043b\u044c
    1826: \u041f\u043e\u043b\u0443\u0447\u0438\u0432 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0432 \u043f\u043e\u0435\u0437\u0434\u043a\u0443 \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435.
    \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0435\u0434\u0435\u0442 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d,
    \u0433\u0434\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u0441\u044f \u0441 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c
    \u0438 \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c \u0410\u0432\u0433\u0443\u0441\u0442\u043e\u043c
    \u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434\u043e\u043c \u041a\u0440\u0435\u043b\u043b\u0435.
    \u042d\u0442\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0439: \u041a\u0440\u0435\u043b\u043b\u0435 \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0436\u0443\u0440\u043d\u0430\u043b \u00abJournal f\u00fcr die reine und angewandte Mathematik\u00bb
    (\u0436\u0443\u0440\u043d\u0430\u043b \u041a\u0440\u0435\u043b\u043b\u0435), \u0432 \u043f\u0435\u0440\u0432\u043e\u043c
    \u0442\u043e\u043c\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u044b\u043b\u0438
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b \u0440\u0430\u0431\u043e\u0442\u044b
    \u0410\u0431\u0435\u043b\u044f. \u0417\u0434\u0435\u0441\u044c \u0436\u0435 \u043e\u043d
    \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u0443\u044e
    \u0432\u0435\u0440\u0441\u0438\u044e \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043e\u0431 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445 \u043f\u044f\u0442\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0424\u0435\u0432\u0440\u0430\u043b\u044c \u2013
    \u0438\u044e\u043b\u044c 1826: \u041f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0435\u0442
    \u0432 \u0418\u0442\u0430\u043b\u0438\u044e, \u0433\u0434\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432
    \u0432 \u0412\u0435\u043d\u0435\u0446\u0438\u0438. \u0418\u044e\u043b\u044c \u2013 \u0434\u0435\u043a\u0430\u0431\u0440\u044c
    1826: \u041f\u0440\u0438\u0431\u044b\u0432\u0430\u0435\u0442 \u0432 \u041f\u0430\u0440\u0438\u0436,
    \u0442\u043e\u0433\u0434\u0430\u0448\u043d\u0438\u0439 \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438. \u0417\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u0441\u044f
    \u0441 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u043e\u043c \u0438 \u041a\u043e\u0448\u0438.
    \u041f\u0438\u0448\u0435\u0442 \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043c\u0435\u043c\u0443\u0430\u0440 \u043e\u0431 \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0431\u044b\u043b
    \u0443\u0442\u0435\u0440\u044f\u043d \u0438 \u043d\u0430\u0439\u0434\u0435\u043d \u0443\u0436\u0435
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e. \u0420\u0430\u0431\u043e\u0442\u0430
    \u043d\u0435 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u0410\u0431\u0435\u043b\u044e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u0438 \u043e\u043d \u043d\u0435 \u0441\u043c\u043e\u0433 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u0442\u0430\u043c \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c.\n\n\U0001F4C9
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u044e
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b (1827\u20131829)
    \u041d\u0430\u0447\u0430\u043b\u043e 1827 \u0433\u043e\u0434\u0430: \u0421\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f, \u0410\u0431\u0435\u043b\u044c
    \u0433\u043e\u043b\u043e\u0434\u0430\u0435\u0442. \u041e\u043d \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u0447\u0435\u0440\u0435\u0437 \u0411\u0435\u0440\u043b\u0438\u043d \u0432 \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u044e.
    1827\u20131828: \u0416\u0438\u0432\u0435\u0442 \u0432 \u043a\u0440\u0430\u0439\u043d\u0435\u0439
    \u043d\u0438\u0449\u0435\u0442\u0435, \u043f\u043e\u0434\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044f
    \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438 \u0443\u0440\u043e\u043a\u0430\u043c\u0438
    \u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435\u043c
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435. \u0411\u043e\u043b\u044c\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u044c
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0433\u043e \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u044c\u044f
    \u0443\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u0432\u044b\u043f\u043b\u0430\u0442\u0443
    \u0434\u043e\u043b\u0433\u043e\u0432 \u0441\u0435\u043c\u044c\u0438. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u044d\u0442\u043e, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043d\u0430\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. 1828 \u0433\u043e\u0434: \u0418\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438. \u041e\u0441\u0435\u043d\u044c 1828 \u0433\u043e\u0434\u0430:
    \u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0440\u0435\u0437\u043a\u043e \u0443\u0445\u0443\u0434\u0448\u0430\u0435\u0442\u0441\u044f
    \u0438\u0437-\u0437\u0430 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430.
    6 \u0430\u043f\u0440\u0435\u043b\u044f 1829 \u0433\u043e\u0434\u0430: \u0423\u043c\u0438\u0440\u0430\u0435\u0442
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 26 \u043b\u0435\u0442 \u0432\u043e
    \u0424\u0440\u043e\u043b\u0430\u043d\u0434\u0435, \u0431\u043b\u0438\u0437 \u0410\u0440\u0435\u043d\u0434\u0430\u043b\u0430.
    \u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0432 \u0411\u0435\u0440\u043b\u0438\u043d,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u041a\u0440\u0435\u043b\u043b\u0435 \u0434\u043e\u0431\u0438\u0432\u0430\u043b\u0441\u044f
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e, \u043f\u0440\u0438\u0448\u043b\u043e \u0432
    \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u044e \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430
    \u0434\u043d\u044f \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0410\u0431\u0435\u043b\u044f.\n\n\U0001F3C6
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0412 1839 \u0433\u043e\u0434\u0443 \u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u0425\u043e\u043b\u044c\u043c\u0431\u043e\u044d \u0438\u0437\u0434\u0430\u043b \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439 \u0410\u0431\u0435\u043b\u044f. \u0412
    2002 \u0433\u043e\u0434\u0443, \u043a 200-\u043b\u0435\u0442\u0438\u044e \u0441\u043e \u0434\u043d\u044f
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0410\u0431\u0435\u043b\u044f, \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438 \u0443\u0447\u0440\u0435\u0434\u0438\u043b\u043e
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    \u2014 \u043e\u0434\u043d\u0443 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0441\u0432\u043e\u0435\u0433\u043e \u0440\u043e\u0434\u0430 \u00ab\u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e\u00bb \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u041f\u0430\u043c\u044f\u0442\u043d\u0438\u043a \u0410\u0431\u0435\u043b\u044e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d
    \u0432 \u041e\u0441\u043b\u043e. \u0415\u0433\u043e \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u043f\u043e\u043c\u0435\u0449\u0430\u043b\u0441\u044f \u043d\u0430 \u0431\u0430\u043d\u043a\u043d\u043e\u0442\u0435
    \u0432 500 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u0445 \u043a\u0440\u043e\u043d.
    \u0415\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u044b
    \u043c\u043d\u043e\u0433\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b: \u0430\u0431\u0435\u043b\u0435\u0432\u0430 \u0433\u0440\u0443\u043f\u043f\u0430,
    \u0430\u0431\u0435\u043b\u0435\u0432\u044b \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b,
    \u0430\u0431\u0435\u043b\u0435\u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435,
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0410\u0431\u0435\u043b\u044f \u2014 \u0420\u0443\u0444\u0444\u0438\u043d\u0438
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435."
  shortBioEn: "Niels Henrik Abel (1802–1829) was a Norwegian mathematician whose short life, full of poverty and deprivation, became one of the most tragic and at the same time vivid pages in the history of science. His work laid the foundations for several areas of modern mathematics. Below is a detailed chronology of his life and key achievements.📜 Childhood and adolescence (1802-1821) August 5, 1802: Born on the island of Finnøy, Norway, in the family of Pastor Søren Georg Abel. Childhood was marred by poverty, poor health and discord in the family. 1815: Enrolled in a cathedral school in Christiania (now Oslo). At first, he studied mediocre. 1817: A new mathematics teacher, Bert Michael Holmboe, appeared at school, who saw a brilliant talent in young Niels and became his mentor.Holmboe introduced Abel to the writings of Euler, Newton, Lagrange and Gauss. 1820: Abel's father dies. A family with six children is on the verge of poverty, and the older brother has a mental disorder. All responsibility rests with 18-year-old Niels.🎓 University and first discoveries (1821–1824) 1821: With the support of Holmboe and Professor of Astronomy Christopher Hansteen enters the University of Christiania. To help the family, he begins to work as a tutor. 1822: Receives the degree of \"candidate of philosophy\". Winter 1822–1823: Presents to the university his first significant work on the integrability of differential equations.The manuscript was lost, but Abel was awarded a state scholarship for it. 1823: Makes a trip to Copenhagen, where he meets his future bride, Christina Kemp. Publishes his first articles in a new scientific journal. 1824: At the age of 21, he independently proves the theorem on the insolubility of the general equation of the fifth degree in radicals. Publishes his work in French at his own expense, seeking recognition.In the same year, she received an engagement ring from Christina.\n\n✈️ Journey through Europe (1825–1827) September 1825 – February 1826: Having received a state scholarship, he goes on a trip to Europe. First he goes to Berlin, where he meets the engineer and publisher August Leopold Krell.This meeting was decisive: Krelle founded the Journal für die reine und angewandte Mathematik (Krelle's journal), in the first volume of which Abel's works were published. Here he publishes an extended version of his work on fifth-degree equations. February – July 1826: Moves to Italy, where he spends several months in Venice. July – December 1826: Arrives in Paris, then the center of mathematical thought. He meets Legendre and Cauchy.He writes his famous memoir about abelian functions, which was subsequently lost and found posthumously. The work did not bring Abel recognition in Paris, and he could not get a position there.📉 Return to Norway and the Last Years (1827–1829) Early 1827: Funds run out, Abel is starving. He returns through Berlin to Norway. 1827–1828: Lives in extreme poverty, moonlighting in private lessons and temporary teaching at a university and an engineering school. Most of the modest salary is spent on paying off family debts. Despite this, he continues to work intensively on the theory of elliptic functions.1828: Elected a Fellow of the Royal Norwegian Society. Fall 1828: Health deteriorates sharply due to tuberculosis. April 6, 1829: Dies at the age of 26 in Froland, near Arendal. An invitation to a prestigious position in Berlin, which Krelle sought for him, came to Norway two days after Abel's death.🏆 Heritage In 1839, Holmboe's teacher published a collection of Abel's writings. In 2002, on the 200th anniversary of Abel's birth, the Norwegian government established the Abel Prize — one of the most prestigious awards in mathematics, a kind of \"Nobel Prize\" for mathematicians. A monument to Abel is erected in Oslo. His portrait was placed on the 500 Norwegian kroner banknote.Many mathematical objects are named after him: the Abelian group, Abelian integrals, Abelian manifold, the Abel-Ruffini theorem, and others."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041d\u0438\u043b\u044c\u0441\u0430 \u0425\u0435\u043d\u0440\u0438\u043a\u0430
    \u0410\u0431\u0435\u043b\u044f, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0441\u0432\u043e\u044e \u043a\u043e\u0440\u043e\u0442\u043a\u0443\u044e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0442\u0440\u0430\u0433\u0438\u0437\u043c \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u044b.
    \u0412\u043e\u0442 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u0432
    \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0440\u044f\u0434\u043a\u0435:\n\n\U0001F4DC 1815\u20131820: \u041f\u0443\u0442\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443, \u043d\u0430\u0447\u0430\u0442\u044b\u0439 \u043f\u043e
    \u043e\u0448\u0438\u0431\u043a\u0435 \u041d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0439
    \u0432\u044b\u0431\u043e\u0440 \u0448\u043a\u043e\u043b\u044b: \u0412 1815 \u0433\u043e\u0434\u0443
    13-\u043b\u0435\u0442\u043d\u0438\u0439 \u041d\u0438\u043b\u044c\u0441 \u0434\u043e\u043b\u0436\u0435\u043d
    \u0431\u044b\u043b \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u0432
    \u043a\u0430\u0444\u0435\u0434\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443
    \u0432 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0438\u0438. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0431\u0440\u0430\u0442 \u0425\u0430\u043d\u0441
    \u041c\u0430\u0442\u0438\u0430\u0441 \u0442\u0430\u043a \u0442\u044f\u0436\u0435\u043b\u043e
    \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043b \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u0449\u0443\u044e
    \u0440\u0430\u0437\u043b\u0443\u043a\u0443 \u0441 \u0434\u043e\u043c\u043e\u043c, \u0447\u0442\u043e
    \u043e\u0442\u0435\u0446 \u0440\u0435\u0448\u0438\u043b \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c
    \u0432\u043c\u0435\u0441\u0442\u043e \u043d\u0435\u0433\u043e \u041d\u0438\u043b\u044c\u0441\u0430.
    \u0422\u0430\u043a \u043d\u0430\u0447\u0430\u043b\u0441\u044f \u0435\u0433\u043e \u043f\u0443\u0442\u044c
    \u0432 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043c\u0438\u0440. \u041f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f: \u0412 1819 \u0433\u043e\u0434\u0443 \u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0411\u0435\u0440\u0442 \u041c\u0438\u0445\u0430\u044d\u043b\u044c \u0425\u043e\u043b\u044c\u043c\u0431\u043e\u044d
