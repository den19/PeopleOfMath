    \u0433\u0435\u043d\u0438\u0435\u043c \u043e\u043d \u0441\u043e\u0447\u0435\u0442\u0430\u0435\u0442
    \u043d\u0435\u043d\u0430\u0441\u044b\u0442\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u0438 \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u0435 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443, \u0435\u0441\u043b\u0438 \u043e\u043d \u0431\u0443\u0434\u0435\u0442
    \u0436\u0438\u0442\u044c, \u043e\u043d, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0441\u0442\u0430\u043d\u0435\u0442 \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c\u00bb.
    \u042d\u0442\u043e \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e \u0441\u0431\u044b\u043b\u043e\u0441\u044c,
    \u043d\u043e \u043e\u0433\u043e\u0432\u043e\u0440\u043a\u0430 \u00ab\u0435\u0441\u043b\u0438
    \u043e\u043d \u0431\u0443\u0434\u0435\u0442 \u0436\u0438\u0442\u044c\u00bb \u0441\u0442\u0430\u043b\u0430
    \u0440\u043e\u043a\u043e\u0432\u043e\u0439. \u0411\u0440\u0435\u043c\u044f \u0433\u043b\u0430\u0432\u044b
    \u0441\u0435\u043c\u044c\u0438: \u0412 1820 \u0433\u043e\u0434\u0443 \u0443\u043c\u0438\u0440\u0430\u0435\u0442
    \u043e\u0442\u0435\u0446 \u0410\u0431\u0435\u043b\u044f, \u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u0441\u0435\u043c\u044c\u044e \u0438\u0437 \u0448\u0435\u0441\u0442\u0438 \u0434\u0435\u0442\u0435\u0439
    \u043d\u0430 \u0433\u0440\u0430\u043d\u0438 \u043d\u0438\u0449\u0435\u0442\u044b. \u0412\u0434\u043e\u0431\u0430\u0432\u043e\u043a
    \u0443 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u0434\u0443\u0448\u0435\u0432\u043d\u043e\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e.
    \u0412\u0441\u044f \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0437\u0430 \u0441\u0435\u043c\u044c\u044e \u043b\u043e\u0436\u0438\u0442\u0441\u044f \u043d\u0430
    18-\u043b\u0435\u0442\u043d\u0435\u0433\u043e \u041d\u0438\u043b\u044c\u0441\u0430.\n\n\U0001F393
    1821\u20131824: \u041f\u0435\u0440\u0432\u044b\u0439 \u043f\u0440\u043e\u0440\u044b\u0432
    \u0438 \u043b\u0438\u0447\u043d\u043e\u0435 \u0441\u0447\u0430\u0441\u0442\u044c\u0435 \u0421\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044f
    \u043e\u0442 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432: \u041f\u043e\u0441\u0442\u0443\u043f\u0438\u0432
    \u0432 1821 \u0433\u043e\u0434\u0443 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0438\u0438, \u0410\u0431\u0435\u043b\u044c
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0431\u0435\u0434\u0435\u043d,
    \u0447\u0442\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430, \u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0432\u0448\u0438\u0441\u044c
    \u0441 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438, \u0441\u043b\u043e\u0436\u0438\u043b\u0438\u0441\u044c
    \u0438 \u0441\u0442\u0430\u043b\u0438 \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0442\u044c
    \u0435\u043c\u0443 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u0438\u0437 \u043b\u0438\u0447\u043d\u044b\u0445
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432, \u00ab\u0434\u0430\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c
    \u0434\u043b\u044f \u043d\u0430\u0443\u043a\u0438 \u044d\u0442\u043e \u0440\u0435\u0434\u043a\u043e\u0435
    \u0434\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u00bb. \u042d\u043a\u043e\u043d\u043e\u043c\u0438\u044f
    \u043d\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435:
    \u0421\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u043e \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \u0432 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u0430\u0445 \u0410\u0431\u0435\u043b\u044c
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0432 1824 \u0433\u043e\u0434\u0443 \u0432 \u0432\u0438\u0434\u0435 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0431\u0440\u043e\u0448\u044e\u0440\u044b \u043d\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435. \u0427\u0442\u043e\u0431\u044b \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442\u044c
    \u043d\u0430 \u043f\u0435\u0447\u0430\u0442\u0438, \u043e\u043d \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u043b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0434\u043e
    \u0448\u0435\u0441\u0442\u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446, \u0438\u0437-\u0437\u0430
    \u0447\u0435\u0433\u043e \u043e\u043d\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0447\u0435\u043d\u044c
    \u0442\u0440\u0443\u0434\u043d\u044b\u043c \u0434\u043b\u044f \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f.
    \u0414\u0430\u0442\u0441\u043a\u0438\u0439 \u0441\u043e\u0432\u0435\u0442: \u0415\u0433\u043e
    \u043f\u0435\u0440\u0432\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u043e\u0431 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0438
    \u043d\u0430 \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u044e \u0434\u0430\u0442\u0441\u043a\u043e\u043c\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0424\u0435\u0440\u0434\u0438\u043d\u0430\u043d\u0434\u0443
    \u0414\u0435\u0433\u0435\u043d\u0443. \u0422\u043e\u0442 \u043d\u0435 \u043d\u0430\u0448\u0435\u043b
    \u043e\u0448\u0438\u0431\u043e\u043a, \u043d\u043e \u0443\u0441\u043e\u043c\u043d\u0438\u043b\u0441\u044f,
    \u0447\u0442\u043e \u0441\u0442\u043e\u043b\u044c \u0441\u043b\u043e\u0436\u043d\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u0440\u0435\u0448\u0438\u043b \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442 \u0438\u0437 \u0434\u0430\u043b\u0435\u043a\u043e\u0439
    \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438. \u0414\u0435\u0433\u0435\u043d \u043f\u043e\u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u043b
    \u0410\u0431\u0435\u043b\u044e \u0437\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u0431\u043e\u043b\u0435\u0435
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e
    \u2014 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u0438. \u042d\u0442\u043e\u0442 \u0441\u043e\u0432\u0435\u0442
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u043a\u0438\u043c.
    \u041f\u043e\u043c\u043e\u043b\u0432\u043a\u0430 \u0441 \u0442\u0430\u043a\u043e\u0439 \u0436\u0435
    \u0431\u0435\u0434\u043d\u043e\u0439 \u043d\u0435\u0432\u0435\u0441\u0442\u043e\u0439: \u0412\u043e
    \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0435\u0437\u0434\u043a\u0438 \u0432 \u041a\u043e\u043f\u0435\u043d\u0433\u0430\u0433\u0435\u043d
    \u0432 1823 \u0433\u043e\u0434\u0443 \u0410\u0431\u0435\u043b\u044c \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b
    \u0441\u0432\u043e\u044e \u043b\u044e\u0431\u043e\u0432\u044c \u2014 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0443
    \u041a\u0435\u043c\u043f. \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430 \u0431\u044b\u043b\u0430
    \u0442\u0430\u043a \u0436\u0435 \u0431\u0435\u0434\u043d\u0430, \u043a\u0430\u043a \u0438
    \u043e\u043d, \u0438 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b\u0430
    \u043d\u0430 \u0436\u0438\u0437\u043d\u044c \u0440\u0435\u043f\u0435\u0442\u0438\u0442\u043e\u0440\u0441\u0442\u0432\u043e\u043c.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043d\u0438\u0449\u0435\u0442\u0443,
    \u0432 1824 \u0433\u043e\u0434\u0443 \u043e\u043d\u0438 \u043e\u0431\u0440\u0443\u0447\u0438\u043b\u0438\u0441\u044c.\n\n\u2708\ufe0f
    1825\u20131827: \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0435 \u0442\u0443\u0440\u043d\u0435,
    \u043f\u043e\u043b\u043d\u043e\u0435 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0439
    \u041f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u0436\u0443\u0440\u043d\u0430\u043b\u0430: \u0412 1825 \u0433\u043e\u0434\u0443 \u0432
    \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u0410\u0431\u0435\u043b\u044c \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c-\u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0435\u043c
    \u0410\u0432\u0433\u0443\u0441\u0442\u043e\u043c \u041a\u0440\u0435\u043b\u043b\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043a\u0430\u043a \u0440\u0430\u0437 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0441\u044f
    \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u044c \u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0436\u0443\u0440\u043d\u0430\u043b.
    \u0410\u0431\u0435\u043b\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u0445
    \u0430\u0432\u0442\u043e\u0440\u043e\u0432, \u043d\u043e \u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u00ab\u0432\u0434\u043e\u0445\u043d\u0443\u043b \u0436\u0438\u0437\u043d\u044c\u00bb \u0432
    \u044d\u0442\u043e \u0438\u0437\u0434\u0430\u043d\u0438\u0435, \u043d\u0430\u043f\u0435\u0447\u0430\u0442\u0430\u0432
    \u0432 \u043d\u0435\u043c 7 \u0441\u0432\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0442.
    \u0416\u0443\u0440\u043d\u0430\u043b \u041a\u0440\u0435\u043b\u043b\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0438 \u043f\u043e\u043d\u044b\u043d\u0435. \u0420\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435: \u0412 1826 \u0433\u043e\u0434\u0443 \u0410\u0431\u0435\u043b\u044c
    \u043f\u0440\u0438\u0435\u0445\u0430\u043b \u0432 \u041f\u0430\u0440\u0438\u0436 \u2014
    \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0439
    \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043c\u0435\u043c\u0443\u0430\u0440 \u043e\u0431
    \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445
    \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u043b \u0435\u0433\u043e \u043d\u0430 \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u044e
    \u041e\u0433\u044e\u0441\u0442\u0435\u043d\u0443 \u041a\u043e\u0448\u0438. \u041e\u0434\u043d\u0430\u043a\u043e
    \u041a\u043e\u0448\u0438, \u0437\u0430\u043d\u044f\u0442\u044b\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u0434\u0435\u043b\u0430\u043c\u0438, \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044c. \u0410\u0431\u0435\u043b\u044c, \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u0435\u043d\u043d\u044b\u0439
    \u0438 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439,
    \u0443\u0435\u0445\u0430\u043b \u0438\u0437 \u041f\u0430\u0440\u0438\u0436\u0430 \u043d\u0438
    \u0441 \u0447\u0435\u043c. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0431\u044b\u043b \u043d\u0430\u0439\u0434\u0435\u043d \u0438
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d \u043b\u0438\u0448\u044c
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e.\n\n\u23f3 1827\u20131829: \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u043d\u0438\u0449\u0435\u0442\u0443 \u0438 \u0437\u0430\u043f\u043e\u0437\u0434\u0430\u043b\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0411\u043e\u0440\u044c\u0431\u0430
    \u0437\u0430 \u0432\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u0435: \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432 \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u044e \u0432 1827 \u0433\u043e\u0434\u0443,
    \u0410\u0431\u0435\u043b\u044c \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0432 \u043e\u0442\u0447\u0430\u044f\u043d\u043d\u043e\u043c
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438: \u043e\u043d \u0433\u043e\u043b\u043e\u0434\u0430\u043b,
    \u043f\u043e\u0434\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u0443\u0440\u043e\u043a\u0430\u043c\u0438, \u0430 \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u043a\u0443\u0434\u043d\u043e\u0433\u043e
    \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u044c\u044f \u043e\u0442\u0434\u0430\u0432\u0430\u043b
    \u043d\u0430 \u0432\u044b\u043f\u043b\u0430\u0442\u0443 \u0434\u043e\u043b\u0433\u043e\u0432
    \u0441\u0435\u043c\u044c\u0438. \u041f\u043e\u043c\u043e\u0449\u044c \u043e\u0442 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433: \u0422\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u043d\u0430\u043f\u0438\u0441\u0430\u043b\u0438
    \u043f\u0438\u0441\u044c\u043c\u043e \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u043e\u043c\u0443
    \u043a\u043e\u0440\u043e\u043b\u044e \u0441 \u043f\u0440\u043e\u0441\u044c\u0431\u043e\u0439
    \u043f\u043e\u043c\u043e\u0447\u044c \u0433\u0435\u043d\u0438\u044e, \u0410\u0431\u0435\u043b\u044f
    \u0432\u0437\u044f\u043b\u0438 \u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435. \u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435,
    \u043e\u043f\u043e\u0437\u0434\u0430\u0432\u0448\u0435\u0435 \u043d\u0430 \u0434\u0432\u0430
    \u0434\u043d\u044f: \u0414\u0440\u0443\u0433 \u0438 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a
    \u0410\u0431\u0435\u043b\u044f, \u0410\u0432\u0433\u0443\u0441\u0442 \u041a\u0440\u0435\u043b\u043b\u0435,
    \u0441\u0443\u043c\u0435\u043b \u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e \u043c\u0435\u0441\u0442\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u041f\u0438\u0441\u044c\u043c\u043e \u0441 \u044d\u0442\u0438\u043c \u0440\u0430\u0434\u043e\u0441\u0442\u043d\u044b\u043c
    \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u0435\u043c \u043f\u0440\u0438\u0448\u043b\u043e
    \u0432 \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u044e \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430
    \u0434\u043d\u044f \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0410\u0431\u0435\u043b\u044f,
    8 \u0430\u043f\u0440\u0435\u043b\u044f 1829 \u0433\u043e\u0434\u0430. \u041e\u043d \u0443\u043c\u0435\u0440
    6 \u0430\u043f\u0440\u0435\u043b\u044f \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 26 \u043b\u0435\u0442. \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u0430\u044f
    \u0441\u043b\u0430\u0432\u0430: \u0412 1830 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e, \u0410\u0431\u0435\u043b\u044c \u0438
    \u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432 \u042f\u043a\u043e\u0431\u0438
    \u0431\u044b\u043b\u0438 \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u044b \u0411\u043e\u043b\u044c\u0448\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0437\u0430 \u0438\u0445
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c.\n\n\U0001F3C6 \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0415\u0433\u043e \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u0431\u044b\u043b \u043f\u043e\u043c\u0435\u0449\u0435\u043d
    \u043d\u0430 \u0431\u0430\u043d\u043a\u043d\u043e\u0442\u0443 \u0432 500 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u0445
    \u043a\u0440\u043e\u043d (\u0432 1978\u20132002 \u0433\u043e\u0434\u0430\u0445). \u0412
    \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d \u043a\u0440\u0430\u0442\u0435\u0440
    \u043d\u0430 \u041b\u0443\u043d\u0435. \u0412 2002 \u0433\u043e\u0434\u0443 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438 \u0443\u0447\u0440\u0435\u0434\u0438\u043b\u043e
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    \u2014 \u043e\u0434\u043d\u0443 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u043c\u0438\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u043c \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u0428\u0430\u0440\u043b\u044c \u042d\u0440\u043c\u0438\u0442 \u0441\u043a\u0430\u0437\u0430\u043b
    \u043e\u0431 \u0410\u0431\u0435\u043b\u0435: \u00ab\u041e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c \u0441\u0442\u043e\u043b\u044c
    \u0431\u043e\u0433\u0430\u0442\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435,
    \u0447\u0442\u043e \u0438\u043c \u0431\u0443\u0434\u0435\u0442 \u0447\u0435\u043c \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0435 500 \u043b\u0435\u0442\u00bb."
  interestingFactsEn: "Niels Henrik Abel's life, despite its short duration, was filled with events that simultaneously reveal his genius and the tragedy of his fate. Here are the most interesting facts from his biography, presented in chronological order:📜 1815–1820: A Path to Science Started by Mistake An Unexpected School Choice: In 1815, the 13-year-old Niels was to go to a cathedral school in Christiania. However, his older brother Hans Matthias was so upset about the upcoming separation from the house that his father decided to send Niels instead. Thus began his journey into the big world.Teacher's Prophecy: In 1819, his mathematics teacher Bert Michael Holmboe wrote, “With a superlative genius, he combines an insatiable interest and gravitation toward mathematics, so if he lives, he is likely to become a great mathematician.” This prophecy came true, but the clause “if he will live” became fatal. Burden of the head of the family: In 1820, Abel's father dies, leaving a family of six children on the verge of poverty.In addition, the older brother has a mental disorder. All responsibility for the family rests with 18-year-old Niels.🎓 1821–1824: The first breakthrough and personal happiness Scholarship from professors: Having entered the University of Christiania in 1821, Abel was so poor that the professors, having familiarized themselves with his works, formed and began to pay him a scholarship from personal funds, “in order to preserve this rare talent for science.”Savings on proof: Abel first published his famous result on the insolubility of fifth-degree equations in radicals in 1824 in the form of a small pamphlet in French. To save on printing, he reduced the proof to six pages, making it very difficult to understand. Danish Council: His first work on fifth-degree equations was sent to the Danish mathematician Ferdinand Degen for review.He did not find any mistakes, but he doubted that such a difficult task was solved by an unknown student from distant Norway. Degen advised Abel to tackle a more promising area — elliptic functions. This advice turned out to be prophetic. Engagement to an equally poor bride: On a trip to Copenhagen in 1823, Abel met his love Christina Kemp. Kristina was as poor as he was and earned her living by tutoring.Despite their poverty, they became engaged in 1824.\n\n✈️ 1825–1827: A European tour full of disappointments The appearance of a great journal: In 1825, in Berlin, Abel met an amateur engineer August Krelle, who was just about to found the first specialized mathematical journal. Abel not only became one of its first authors, but also actually \"breathed life\" into this publication, printing 7 of his works in it.Krelle's journal still exists. Disappointment in Paris: In 1826, Abel came to Paris, the center of the mathematical world. He wrote his main memoir about abelian functions and submitted it for review to Augustin Cauchy. However, Cauchy, busy with his own affairs, simply lost the manuscript. Abel, insulted and disappointed, left Paris with nothing. His main work was found and published only posthumously.1827-1829: Return to poverty and belated recognition Struggle for survival: Returning to Norway in 1827, Abel found himself in a desperate situation: he starved, worked part-time lessons, and gave most of his meager salary to pay off family debts.Help from French colleagues: Only after several famous French mathematicians wrote a letter to the Norwegian king asking him to help the genius, Abel was hired as a temporary teacher at the university and the engineering school. An invitation that was two days late: Abel's friend and mentor, August Krelle, managed to get him a place as a professor at the University of Berlin.A letter with this joyful news came to Norway two days after Abel's death, on April 8, 1829. He died on April 6 of tuberculosis at the age of 26. Posthumous fame: In 1830, already posthumously, Abel and Carl Gustave Jacobi were awarded the Grand Prize of the Paris Academy of Sciences for their work on elliptic functions.🏆 Legacy His portrait was placed on the 500 Norwegian kroner banknote (1978–2002). A crater on the Moon is named in his honor. In 2002, the Norwegian government established the Abel Prize, one of the most prestigious awards in the world of mathematics, often called the equivalent of the Nobel Prize for mathematicians. Charles Hermite said of Abel: “He left mathematicians with such a rich heritage that they will have something to do for the next 500 years.”"
