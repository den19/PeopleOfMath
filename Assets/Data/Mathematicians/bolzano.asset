  achievementsRu: "\u0413\u043e\u0432\u043e\u0440\u044f \u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0445
    \u0411\u0435\u0440\u043d\u0430\u0440\u0434\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e,
    \u0432\u0430\u0436\u043d\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0431\u043e\u0440
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439, \u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0441\u043c\u0435\u043d\u0430 \u043f\u0430\u0440\u0430\u0434\u0438\u0433\u043c\u044b. \u041e\u043d
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445,
    \u043a\u0442\u043e \u043d\u0430\u0447\u0430\u043b \u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043b\u043e\u0433\u0438\u043a\u0438 \u043d\u0430 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u0441\u0442\u0440\u043e\u0433\u043e\u043c, \u043d\u0435 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e\u043c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0435, \u043d\u0430\u043c\u043d\u043e\u0433\u043e
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432 \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.\n\n\U0001F4D0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0442\u0446\u043e\u0432-\u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u0431\u044b\u043b\u0438 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u044b \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u043d\u0438\u044e
    \u0440\u0430\u0441\u043f\u043b\u044b\u0432\u0447\u0430\u0442\u044b\u0445 \u043f\u043e\u043d\u044f\u0442\u0438\u0439
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445
    \u0438 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    \u043e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0430\u043d\u0430\u043b\u0438\u0437
    \u043d\u0430 \u043f\u0440\u043e\u0447\u043d\u0443\u044e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043e\u0441\u043d\u043e\u0432\u0443. \u0421\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438: \u0412 1817
    \u0433\u043e\u0434\u0443 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u0427\u0438\u0441\u0442\u043e
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u00bb
    \u043e\u043d \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e
    \u0441\u0443\u0442\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u0435\u043c
    \u0441\u0430\u043c\u044b\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u0438\u0437
    \u043a\u0443\u0440\u0441\u0430 \u043c\u0430\u0442\u0430\u043d\u0430\u043b\u0438\u0437\u0430.
    \u041e\u043d\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043e
    \u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u0438\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u0430 `\u03c9`: \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c
    `f(x+\u03c9) - f(x)` \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0441\u0434\u0435\u043b\u0430\u043d\u0430
    \u043c\u0435\u043d\u044c\u0448\u0435 \u043b\u044e\u0431\u043e\u0439 \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0439
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b, \u0435\u0441\u043b\u0438 `\u03c9` \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u043c\u0430\u043b\u043e. \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0439 \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438
    (\u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e-\u041a\u043e\u0448\u0438): \u0412 \u0442\u043e\u0439
    \u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0435 1817 \u0433\u043e\u0434\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0438 \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439
    \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u042d\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u043d\u0430 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0433\u043e\u0434\u0430 \u0440\u0430\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u0443
    \u041a\u043e\u0448\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u043e\u0441\u0442\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u044d\u0442\u043e\u0442
    \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439. \u0418\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438
    \u0442\u043e\u0447\u043d\u0435\u0435 \u0431\u044b\u043b\u043e \u0431\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0435\u0433\u043e \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0435\u043c \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e-\u041a\u043e\u0448\u0438.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u043e\u043c
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 (\u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e): \u0412 \u0442\u043e\u0439 \u0436\u0435
    \u0437\u043d\u0430\u043a\u043e\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 1817
    \u0433\u043e\u0434\u0430 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e\u0449\u0430\u044f
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0440\u0430\u0437\u043d\u044b\u0445 \u0437\u043d\u0430\u043a\u043e\u0432
    \u043d\u0430 \u043a\u043e\u043d\u0446\u0430\u0445 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430,
    \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0438\u043c\u0435\u0435\u0442
    \u043a\u043e\u0440\u0435\u043d\u044c \u0432\u043d\u0443\u0442\u0440\u0438 \u044d\u0442\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430. \u0421\u0435\u0439\u0447\u0430\u0441
    \u044d\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043a\u0430\u043a \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e.
    \u00ab\u0418\u0437\u043c\u0435\u0440\u0438\u043c\u044b\u0435 \u0447\u0438\u0441\u043b\u0430\u00bb
    \u2014 \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b: \u0421\u0430\u043c\u0430\u044f, \u043f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u0438 \u043d\u0435\u0434\u043e\u043e\u0446\u0435\u043d\u0435\u043d\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0431\u044b\u043b\u0430
    \u0441\u043e\u0437\u0434\u0430\u043d\u0430 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 1830-\u0445
    \u0433\u043e\u0434\u043e\u0432 \u0432 \u0435\u0433\u043e \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438
    \u00ab\u0427\u0438\u0441\u0442\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b\u00bb.
    \u041e\u043d \u043f\u043e\u043d\u044f\u043b \u0433\u043b\u0430\u0432\u043d\u0443\u044e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438: \u0434\u043b\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0438\u043c\u0435\u0442\u044c \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u043b
    \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0442\u0430\u043a\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e, \u0441\u043e\u0437\u0434\u0430\u0432
    \u0441\u0432\u043e\u0438 \u00ab\u0438\u0437\u043c\u0435\u0440\u0438\u043c\u044b\u0435 \u0447\u0438\u0441\u043b\u0430\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438 \u043f\u043e \u0441\u0443\u0442\u0438
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0435\u0439 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438\u0437 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430, \u043e\u0441\u0442\u0430\u0432\u0448\u0430\u044f\u0441\u044f
    \u0432 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438, \u043d\u0430\u043c\u043d\u043e\u0433\u043e
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430,
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u0438 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430,
    \u043f\u043e\u044f\u0432\u0438\u0432\u0448\u0438\u0435\u0441\u044f \u043b\u0438\u0448\u044c
    \u0432 1870-\u0445 \u0433\u043e\u0434\u0430\u0445. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e-\u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430:
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u0442\u043e\u043c, \u0447\u0442\u043e
    \u0438\u0437 \u043b\u044e\u0431\u043e\u0439 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0439
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c \u0441\u0445\u043e\u0434\u044f\u0449\u0443\u044e\u0441\u044f
    \u043f\u043e\u0434\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    \u042d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u043e \u0432\u043d\u043e\u0432\u044c \u043e\u0442\u043a\u0440\u044b\u0442\u043e
    \u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043e
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u043e\u043c \u043f\u043e\u0437\u0436\u0435,
    \u0438 \u0442\u0435\u043f\u0435\u0440\u044c \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043d\u043e\u0441\u0438\u0442
    \u0438\u0445 \u043e\u0431\u0449\u0435\u0435 \u0438\u043c\u044f. \u00ab\u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u044b
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e\u00bb: \u0412 \u0441\u0432\u043e\u0435\u0439
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e
    \u0432 1851 \u0433\u043e\u0434\u0443) \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u043b
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u043e
    \u0441\u0432\u043e\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0443 \u0447\u0435\u0442\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b). \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0413\u0435\u043e\u0440\u0433\u0430
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u0438 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432.\n\n\U0001F9E0 \u041b\u043e\u0433\u0438\u043a\u0430
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u043d\u0430\u0443\u043a\u0438
    \u0412 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043b\u043e\u0433\u0438\u043a\u0438 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043d\u0435 \u043c\u0435\u043d\u0435\u0435
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u043e\u0442,
    \u0441\u0442\u0430\u0432 \u043f\u0440\u0435\u0434\u0442\u0435\u0447\u0435\u0439 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0438 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0410\u043d\u0442\u0438\u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0437\u043c
    \u0438 \u00ab\u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u0430\u043c\u0438
    \u043f\u043e \u0441\u0435\u0431\u0435\u00bb: \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u2014 \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0442\u043e\u043c\u043d\u043e\u0435
    \u00ab\u041d\u0430\u0443\u043a\u043e\u0443\u0447\u0435\u043d\u0438\u0435\u00bb (1837). \u0412
    \u043d\u0435\u043c \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b \u0447\u0435\u0442\u043a\u0443\u044e
    \u0433\u0440\u0430\u043d\u0438\u0446\u0443 \u043c\u0435\u0436\u0434\u0443 \u043b\u043e\u0433\u0438\u043a\u043e\u0439
    \u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0435\u0439. \u041e\u043d
    \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0441\u0430\u043c\u0438 \u043f\u043e \u0441\u0435\u0431\u0435\u00bb (Satz an sich), \u0442\u043e
    \u0435\u0441\u0442\u044c \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e,
    \u0431\u0435\u0437\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u043c\u044b\u0441\u043b\u0430
    \u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438\u0441\u0442\u0438\u043d\u0435\u043d \u0438\u043b\u0438 \u043b\u043e\u0436\u0435\u043d
    \u0432\u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442
    \u0442\u043e\u0433\u043e, \u0434\u0443\u043c\u0430\u0435\u0442 \u043b\u0438 \u043e \u043d\u0435\u043c
    \u043a\u0442\u043e-\u0442\u043e \u0438\u043b\u0438 \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0441\u0438\u0442
    \u043b\u0438 \u0435\u0433\u043e \u0432\u0441\u043b\u0443\u0445. \u042d\u0442\u043e \u0431\u044b\u043b\u0430
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u0434\u043b\u044f
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438\u0434\u0435\u044f
    \"\u043c\u0438\u0440\u0430 3\" (\u043f\u043e \u041f\u043e\u043f\u043f\u0435\u0440\u0443),
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b\u0430 \u042d\u0434\u043c\u0443\u043d\u0434\u0430
    \u0413\u0443\u0441\u0441\u0435\u0440\u043b\u044f. \u041b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (Ableitbarkeit): \u0412 \u0440\u0430\u043c\u043a\u0430\u0445
    \u00ab\u041d\u0430\u0443\u043a\u043e\u0443\u0447\u0435\u043d\u0438\u044f\u00bb \u043e\u043d
    \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    (\u0432\u044b\u0432\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438). \u0415\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434 \u043e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u043b\u0441\u044f
    \u043d\u0430 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438 \u0438\u0434\u0435\u0439:
    \u0435\u0441\u043b\u0438 \u043f\u0440\u0438 \u0437\u0430\u043c\u0435\u043d\u0435 \u0432\u0441\u0435\u0445
    \u043d\u0435\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u043d\u044f\u0442\u0438\u0439
    \u0432 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043d\u0430 \u043b\u044e\u0431\u044b\u0435
    \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0441\u0442\u044c
    \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f, \u0442\u043e \u044d\u0442\u043e
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0438\u0441\u0442\u0438\u043d\u043d\u044b\u043c.
    \u042d\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u0447\u0442\u0438
    \u0437\u0430 100 \u043b\u0435\u0442 \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b\u043e
    \u0441\u0435\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u0438\u0441\u0442\u0438\u043d\u044b \u0438 \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f
    \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u0430 \u0422\u0430\u0440\u0441\u043a\u043e\u0433\u043e.\n\n\U0001F4A1
    \u042d\u0442\u0438\u043a\u0430 \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u0412\u0430\u0436\u043d\u043e \u043f\u043e\u043c\u043d\u0438\u0442\u044c,
    \u0447\u0442\u043e \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0431\u044b\u043b \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u00ab\u0447\u0438\u0441\u0442\u044b\u043c\u00bb \u0443\u0447\u0435\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u043d\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0447\u0442\u043e \u043e\u0442\u0440\u0430\u0436\u0430\u043b\u043e\u0441\u044c
    \u043d\u0430 \u0432\u0441\u0435\u0439 \u0435\u0433\u043e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u0423\u0442\u0438\u043b\u0438\u0442\u0430\u0440\u0438\u0437\u043c: \u0412 \u0441\u0432\u043e\u0438\u0445
    \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u0445
    \u043e\u043d \u043f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0441\u044f
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 \u0443\u0442\u0438\u043b\u0438\u0442\u0430\u0440\u0438\u0437\u043c\u0430,
    \u0441\u0447\u0438\u0442\u0430\u044f \u0432\u044b\u0441\u0448\u0435\u0439 \u0446\u0435\u043b\u044c\u044e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0431\u043b\u0430\u0433\u043e \u0432\u0441\u0435\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0415\u0433\u043e \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u0441\u0442\u0430\u043b\u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u0435\u0433\u043e \u0443\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u044f \u0438 \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u044f
    \u0438\u0437 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0432
    1819 \u0433\u043e\u0434\u0443. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u0432\u043a\u043b\u0430\u0434 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u043e\u0433\u0440\u043e\u043c\u0435\u043d
    \u0438 \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u0435\u043d. \u041e\u043d
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0438\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u0447;
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u043d\u0430\u0443\u043a\u0438, \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0432
    \u043c\u043e\u0441\u0442\u044b \u043c\u0435\u0436\u0434\u0443 \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\u044e
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u043d\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439. \u0415\u0433\u043e \u0438\u0434\u0435\u0438,
    \u043e\u0431\u043e\u0433\u043d\u0430\u0432 \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f,
    \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u043b\u0438\u0446\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043b\u043e\u0433\u0438\u043a\u0438."
  achievementsEn: "Speaking of Bernard Bolzano's achievements, it is important to understand that his main contribution is not just a set of discoveries, but a fundamental paradigm shift; he was one of the first to build a math and logic building on a completely rigid, not intuitive foundation, far ahead of his time.\n\nThe Mathematical Analysis and Theory of Bolzano Numbers is rightly considered to be one of the founding fathers of modern mathematical analysis, and its work has focused on overcoming vague concepts of infinitely small and intuitive notions of continuity in order to put the analysis on a sound logical basis.Strict definition of continuity: In 1817, in the work of \"Slight Analysis Evidence\", he gave the first strict definition of continuity of function, which is essentially a definition we know from the course of math analysis. It is formulated by adding the argument `f(x+) - f(x)': the difference `f(x) &apos; can be made less than any given value if `\\\\\\\\\\ &apos; is not sufficient.In the same work in 1817, Bolzano formulated and tried to prove strictly the criterion of convergence in numerical sequence four years earlier than Kosha, who simply postulated the criterion, would have historically called it the Bolzano-Koshi criterion.The intermediate value theory (Bolzano Theorem): In the same landmark work in 1817, he presented the first rigorous analytical proof of the theorem that a continuous function that accepts different signs at the end of the interval is necessarily a root within that interval; this statement is now known as the Bolzano Theorem.\"Measible numbers\" is a pre-emption of the theory of real numbers: Bolzano's most probably revolutionary and undervalued work was created in the early 1830s in his manuscript, \"Pure number theory.\" He understood the main logical problem of analysing the time: to prove consistency, it was necessary to have a strict definition of the real numbers.Bolzano attempted to build this theory by creating his \"measured numbers\" which were essentially the design of real numbers from rationals, a work that remained in manuscripts far ahead of the famous constructions of Dedecinda, Cantor and Weyerstrass, which appeared only in the 1870s.Bolzano-Weyerstrass Theorem: He also gave the first proof of the fundamental theorem that any limited infinite sequence could be distinguished by a consistent sub-order. This evidence was re-opened and popularized by Weyerstress later, and now the theorem bears their common name.\"Infinite Paradoxes\": In its last work (published postmortem in 1851), Bolzano performed a brilliant analysis of the properties of endless sets. He showed that an infinite multitude can be equal to its portion (e.g. many natural numbers equal to many even numbers). This work has had an enormous impact on George Cantor and his multi-dimensional theory.\n\nThe logic and philosophy of science in Bolzano's logic has undergone an equally significant coup, predisposing analytical philosophy and phenomenal science: Antipsychology and \"proposals in themselves\": his main work is the four-volume \"science\" (1837), in which he drew a clear line between logic and psychology.He introduced the notion of \"satz an sich\", that is, objective, timeless judgment, which is true or false, whether someone thinks of it or says it out loud, which was a revolutionary idea of \"peace 3\" (popper), which later inspired Edmund Gusserl.Logical follow-up (Ableitbarkeit): In the framework of \"Scientific education\", he gave the first formal definition of logical logic in history, based on a variation of ideas: if the sentence preserves any other truth, then the sentence is logical; this definition, in almost 100 years, prejudged the semantic definitions of the truth and of Alfred Tarsky's effect.\n\nIt is important to remember that Bolzano was not only a \"clean\" scientist, but also a deeply moral person, which reflected in all his activities.So Bolzano's contribution is huge and multi-dimensional, and he has not just solved a few mathematical problems; he has created a new toolbox for all science, building bridges between the strictness of mathematical analysis, the objectivity of logic and moral philosophy, and his ideas, after overtaking decades, have formed the face of modern mathematics and logic."
  personalLifeRu: "\u0425\u043e\u0442\u044f \u0411\u0435\u0440\u043d\u0430\u0440\u0434 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0438 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0438 \u043d\u0435
    \u0438\u043c\u0435\u043b \u0434\u0435\u0442\u0435\u0439, \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c\u0438:
    \u0441 \u0441\u0435\u043c\u044c\u0435\u0439, \u0441 \u0435\u0434\u0438\u043d\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438
    \u0438 \u0441 \u0432\u0435\u0440\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c \u0441\u0447\u0435\u0442\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u0430
    \u0435\u0433\u043e \u043a \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0443 \u0441
    \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u044b\u043c\u0438 \u0438 \u0441\u0432\u0435\u0442\u0441\u043a\u0438\u043c\u0438
    \u0432\u043b\u0430\u0441\u0442\u044f\u043c\u0438. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u0447\u044c\u0438 \u043b\u0438\u0447\u043d\u044b\u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438
    \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u0443.\n\n\U0001F46A \u0421\u0435\u043c\u044c\u044f
    \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 5 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1781 \u0433\u043e\u0434\u0430 \u0432 \u041f\u0440\u0430\u0433\u0435 \u0432 \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0439 \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0411\u0435\u0440\u043d\u0430\u0440\u0434
    \u041f\u043e\u043c\u043f\u0435\u0439 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e, \u0431\u044b\u043b
    \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0435\u043c
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041f\u0440\u0430\u0433\u0443. \u041c\u0430\u0442\u044c, \u041c\u0430\u0440\u0438\u044f
    \u0421\u0435\u0441\u0438\u043b\u0438\u044f \u041c\u0430\u0443\u0440\u0435\u0440, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u044f\u0437\u044b\u0447\u043d\u043e\u0439
    \u043a\u0443\u043f\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0438
    \u0438 \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b\u0430 \u043d\u0430\u0431\u043e\u0436\u043d\u043e\u0439
    \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u043a\u043e\u0439. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e,
    \u0447\u0442\u043e \u0434\u043e\u043c\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438
    \u043f\u043e-\u043d\u0435\u043c\u0435\u0446\u043a\u0438, \u0447\u0435\u0448\u0441\u043a\u0430\u044f
    \u0441\u0440\u0435\u0434\u0430 \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u043d\u0430 \u043d\u0435\u0433\u043e
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435.
    \u0411\u0435\u0440\u043d\u0430\u0440\u0434 \u0431\u044b\u043b \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044b\u043c
    \u0438\u0437 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438 \u0434\u0435\u0442\u0435\u0439.
    \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0438
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c \u0432 \u0442\u043e\u043c,
    \u0447\u0442\u043e \u0434\u043e \u0432\u0437\u0440\u043e\u0441\u043b\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430
    \u0434\u043e\u0436\u0438\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043d \u0438
    \u0435\u0433\u043e \u0431\u0440\u0430\u0442 \u0418\u043e\u0433\u0430\u043d\u043d (Johann).
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0435\u043c, \u043d\u043e \u0438 \u0444\u0438\u043b\u0430\u043d\u0442\u0440\u043e\u043f\u043e\u043c
    \u2014 \u043e\u043d \u0431\u044b\u043b \u0434\u0432\u0438\u0436\u0443\u0449\u0435\u0439
    \u0441\u0438\u043b\u043e\u0439 \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u043f\u0440\u0430\u0436\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0438\u044e\u0442\u0430, \u0447\u0442\u043e, \u043d\u0435\u0441\u043e\u043c\u043d\u0435\u043d\u043d\u043e,
    \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u043e \u043d\u0430 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u0441\u0430\u043c\u043e\u0433\u043e
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e. \u0421\u0430\u043c \u0411\u0435\u0440\u043d\u0430\u0440\u0434
    \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0441\u044f
    \u0441\u043b\u0430\u0431\u044b\u043c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c
    \u0438 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u0441\u0442\u0440\u0430\u0434\u0430\u043b
    \u043e\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0441 \u0434\u044b\u0445\u0430\u043d\u0438\u0435\u043c.\n\n\U0001F6E4\ufe0f
    \u041f\u0443\u0442\u044c \u043a \u0441\u0432\u044f\u0449\u0435\u043d\u0441\u0442\u0432\u0443
    \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0435 \u0421 1791 \u043f\u043e
    1796 \u0433\u043e\u0434 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 \u043f\u0440\u0430\u0436\u0441\u043a\u043e\u0439 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438
    \u043f\u0438\u0430\u0440\u0438\u0441\u0442\u043e\u0432 \u2014 \u043e\u0440\u0434\u0435\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0430\u0432\u0430\u043b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043e\u0431\u0435\u0442 \u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043e
    \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0438 \u043c\u043e\u043b\u043e\u0434\u0435\u0436\u0438.
    \u042d\u0442\u043e \u0443\u043a\u0440\u0435\u043f\u0438\u043b\u043e \u0432 \u043d\u0435\u043c
    \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435
    \u0434\u043e\u0433\u043c\u044b, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u043d\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438 \u0432\u0435\u0440\u0443 \u0432 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e\u0441\u0442\u044c. \u0412
    1796 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041a\u0430\u0440\u043b\u043e\u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0432 \u041f\u0440\u0430\u0433\u0435, \u0438\u0437\u0443\u0447\u0430\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e,
    \u0444\u0438\u0437\u0438\u043a\u0443 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u041d\u0430 \u043d\u0435\u0433\u043e \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438
    \u0442\u0440\u0443\u0434\u044b \u0410\u0431\u0440\u0430\u0445\u0430\u043c\u0430 \u0413\u043e\u0442\u0442\u0445\u0435\u043b\u044c\u0444\u0430
    \u041a\u0435\u0441\u0442\u043d\u0435\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0434\u0430\u0436\u0435 \u0441\u0430\u043c\u044b\u0435 \u00ab\u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u0435\u00bb
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f.
    \u0412 1800 \u0433\u043e\u0434\u0443, \u043f\u0440\u043e\u0442\u0438\u0432 \u0432\u043e\u043b\u0438
    \u043e\u0442\u0446\u0430, \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e. \u0412 1804 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043f\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438,
    \u0430 \u0432\u0441\u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430
    \u0434\u043d\u044f \u0431\u044b\u043b \u0440\u0443\u043a\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d
    \u0432 \u0441\u0430\u043d \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430. \u0412 1805 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u043d\u0430
    \u043d\u0435\u0434\u0430\u0432\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0443\u044e
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u0440\u0435\u043b\u0438\u0433\u0438\u0438 \u0432 \u041f\u0440\u0430\u0433\u0435, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u0431\u044b\u043b \u0442\u0430\u043a\u0436\u0435
    \u043f\u0435\u0440\u0432\u044b\u043c \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u043e\u043c
    \u0438 \u043d\u0430 \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\u26a1
    \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441 \u0432\u043b\u0430\u0441\u0442\u044f\u043c\u0438
    \u0438 \u043a\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0441\u044f
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043a\u0430\u0444\u0435\u0434\u0440\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u0438
    \u0431\u044b\u043b\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0430 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0435\u043c I \u0434\u043b\u044f \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u044f
    \u043f\u043e\u0437\u0438\u0446\u0438\u0439 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0441\u0442\u0430\u043b
    \u043f\u043e\u043b\u043d\u043e\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e
    \u0442\u043e\u0433\u043e, \u043d\u0430 \u0447\u0442\u043e \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b\u0438
    \u0432\u043b\u0430\u0441\u0442\u0438. \u0415\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438
    \u0431\u044b\u043b\u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b, \u043e\u043d
    \u043f\u0440\u043e\u043f\u043e\u0432\u0435\u0434\u043e\u0432\u0430\u043b \u0438\u0434\u0435\u0438
    \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e\u0441\u0442\u0438,
    \u043f\u0430\u0446\u0438\u0444\u0438\u0437\u043c\u0430 \u0438 \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u0438\u043b\u0438\u0442\u0430\u0440\u0438\u0437\u043c. \u041e\u043d \u043e\u0441\u0443\u0436\u0434\u0430\u043b
    \u0434\u0438\u0441\u043a\u0440\u0438\u043c\u0438\u043d\u0430\u0446\u0438\u044e \u0447\u0435\u0448\u0441\u043a\u043e\u0433\u043e
    \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f \u0438 \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c.
    \u042d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0442\u043e\u043c\u0443,
    \u0447\u0442\u043e \u043f\u0440\u043e\u0442\u0438\u0432 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0438
    \u0432\u043e\u0437\u0431\u0443\u0436\u0434\u0435\u043d\u044b \u0434\u0435\u043b\u0430 \u0432
    \u0432\u0435\u043d\u0441\u043a\u043e\u043c \u0441\u0443\u0434\u0435. \u0412 \u0434\u0435\u043a\u0430\u0431\u0440\u0435
    1819 \u0433\u043e\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0435\u043d
    \u043e\u0442 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u044b \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d
    \u0432 \u0441\u0441\u044b\u043b\u043a\u0443 \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u044e.
    \u0412 1821\u20131825 \u0433\u043e\u0434\u0430\u0445 \u043f\u0440\u043e\u0442\u0438\u0432
    \u043d\u0435\u0433\u043e \u0432\u0435\u043b\u0441\u044f \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u044b\u0439
    \u0441\u0443\u0434 \u043f\u043e \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044e \u0432
    \u0435\u0440\u0435\u0441\u0438. \u0415\u043c\u0443 \u0431\u044b\u043b\u043e \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043e
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c, \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0440\u0430\u0431\u043e\u0442\u044b (\u0437\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c
    \u043d\u0435\u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0433\u043e \u0438
    \u043d\u0435\u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f), \u0430 \u0435\u0433\u043e
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u0430\u043b\u0430\u0441\u044c
    \u0446\u0435\u043d\u0437\u0443\u0440\u0435.\n\n\U0001F4DA \u0413\u043e\u0434\u044b \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u044f,
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u0421
    1823 \u0433\u043e\u0434\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0436\u0438\u043b
    \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u0432 \u043f\u043e\u043c\u0435\u0441\u0442\u044c\u0435 \u0441\u0432\u043e\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439
    \u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u0435\u0439, \u0441\u0435\u043c\u044c\u0438
    \u0413\u043e\u0444\u043c\u0430\u043d, \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435
    \u0422\u0435\u0445\u043e\u0431\u0443\u0437 (Techobuz) \u0432 \u042e\u0436\u043d\u043e\u0439
    \u0411\u043e\u0433\u0435\u043c\u0438\u0438, \u043f\u0440\u043e\u0432\u043e\u0434\u044f \u043b\u0435\u0442\u043e
    \u0443 \u043d\u0438\u0445, \u0430 \u0437\u0438\u043c\u0443 \u2014 \u0432 \u041f\u0440\u0430\u0433\u0435
    \u0443 \u0431\u0440\u0430\u0442\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0430. \u0419\u043e\u0437\u0435\u0444
    \u0413\u043e\u0444\u043c\u0430\u043d \u0431\u044b\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u044b \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e, \u0430
    \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u0410\u043d\u043d\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c. \u042d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e \u0441\u0430\u043c\u044b\u043c \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c:
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u044e,
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b. \u041a\u043e\u0433\u0434\u0430 \u0410\u043d\u043d\u0430
    \u0413\u043e\u0444\u043c\u0430\u043d \u0437\u0430\u0431\u043e\u043b\u0435\u043b\u0430 \u0432
    1841 \u0433\u043e\u0434\u0443, \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u0413\u043e\u0444\u043c\u0430\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041f\u0440\u0430\u0433\u0443, \u0433\u0434\u0435 \u043e\u043d\u0438 \u0432\u0441\u0435
    \u0436\u0438\u043b\u0438 \u0443 \u0431\u0440\u0430\u0442\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0430
    (\u0410\u043d\u043d\u0430 \u0443\u043c\u0435\u0440\u043b\u0430 \u0432 1842 \u0433\u043e\u0434\u0443).
    \u0422\u0430\u043c \u043e\u043d \u0441\u043d\u043e\u0432\u0430 \u0441\u0442\u0430\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u0431\u043e\u0433\u0435\u043c\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u043d\u0430\u0443\u043a \u0438 \u0434\u0430\u0436\u0435 \u0431\u044b\u043b \u0435\u0433\u043e
    \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c \u0432 1842\u20131843
    \u0433\u043e\u0434\u0430\u0445. \u0411\u0435\u0440\u043d\u0430\u0440\u0434 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041f\u0440\u0430\u0433\u0435
    18 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1848 \u0433\u043e\u0434\u0430 \u043e\u0442
    \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u0430\u043b\u0430 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u043d\u0430
    \u0435\u0433\u043e \u0441\u043b\u0430\u0431\u044b\u0435 \u043b\u0435\u0433\u043a\u0438\u0435.\n\n\u2764\ufe0f
    \u0424\u0438\u043b\u0430\u043d\u0442\u0440\u043e\u043f\u0438\u044f \u0438 \u043b\u0438\u0447\u043d\u044b\u0435
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0447\u0435\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u0444\u0438\u043b\u0430\u043d\u0442\u0440\u043e\u043f\u043e\u043c.
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438
    \u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438 \u043e\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0434\u043e\u043c\u043e\u0432 \u0434\u043b\u044f
    \u0431\u0435\u0434\u043d\u044b\u0445, \u043f\u0440\u0438\u044e\u0442\u043e\u0432 \u0434\u043b\u044f
    \u0441\u043b\u0435\u043f\u044b\u0445, \u0441\u0441\u0443\u0434\u043d\u044b\u0445 \u043a\u0430\u0441\u0441
    \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a
    \u0438 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0445 \u0448\u043a\u043e\u043b \u0432
    \u0441\u0435\u043b\u044c\u0441\u043a\u043e\u0439 \u043c\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438.
    \u0415\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u0430
    \u0435\u0433\u043e \u043d\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043d \u043f\u0440\u0435\u0442\u0432\u043e\u0440\u044f\u043b \u0432 \u0436\u0438\u0437\u043d\u044c,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u0437\u0430\u043f\u0440\u0435\u0442\u044b. \u041e\u043d \u0431\u044b\u043b \u00ab\u0432\u0435\u0440\u043d\u044b\u043c
    \u0441\u044b\u043d\u043e\u043c \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0446\u0435\u0440\u043a\u0432\u0438\u00bb, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0441\u0442\u043e\u043c, \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u0432\u0448\u0438\u043c\u0441\u044f
    \u043e\u0442\u0440\u0435\u043a\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u0441\u0432\u043e\u0438\u0445
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u0439."
  personalLifeEn: "Although Bernard Bolzano was neither married nor had children, his personal life was full of deep relationships: with his family, with his like-minded people, and with the faith that eventually led him to conflict with church and secular authorities, his life being the story of a man whose personal beliefs and affections determined his fate.\n\nHis father, Bernard Pompey Bolzano, was an Italian art dealer who moved to Prague on October 5, 1781.Bernard was the fourth of 12 children, and his family's tragedy was that he and his brother Johann lived to an adult age, and his father was not just a merchant, but a philanthropist — he was a driving force behind the establishment of the Prague shelter, which undoubtedly affected the character of Bolzano himself. Bernard himself, since childhood, had suffered from poor health and had suffered from respiratory problems throughout his life.\n\nIn 1796, Bolzano studied at the Prague P.E.C., an order that gave a special vow to care for young people, and strengthened religious doctrine rather than deep moral beliefs and social justice.He was greatly influenced by Abraham Gotthelf Kestner's work, who sought to prove even the most \"obvious\" mathematical claims. In 1800, he began studying theology against his father's will. In 1804, he received a Ph.D. in philosophy, and in just two days he was ordained a Catholic priest.In 1805, he was appointed to the newly created Department of Religious Philosophy in Prague, despite being also the first candidate for the Department of Mathematics.\n\nThe fact that the Department of the Philosophy of Religion was created by Emperor Franz I to strengthen the conservative Catholic Church, however, Bolzano became the complete opposite of what the authorities had hoped for, his lectures were popular, he preached social justice, pacifism and criticism of militarism, and he condemned discrimination against the Czech population and anti-Semitism.In December 1819, he was suspended from the profession and sent to the village; in 1821-1825, he was tried by a church court on charges of heresy; he was forbidden to teach, publish works (except for non-religious and non-political content) and his correspondence was censored.\n\n♪ Years of exile, friendship, and death since 1823 Bolzano has lived mainly in the estate of his friends and patrons, the Goffman family, the village of Techobuz in South Bohemia, spending their summers with them, and winter with his brother Johann in Prague. Joseph Goffmann was a mathematician who reviewed Bolzano's work and his wife Anna became a close friend, which proved to be the most fruitful period for him: despite his isolation, he wrote his main works.When Anna Goffmann became ill in 1841, Bolzano moved with the Goffmann family to Prague, where they all lived with his brother Johann (Anna died in 1842), where he was again an active member of the Royal Bohemian Society of Sciences and even its president in 1842-1843, and Bernard Bolzano died in Prague on 18 December 1848 of a cold that caused complications to his weak lungs.\n\nHe supported the establishment of homes for the poor, shelters for the blind, credit funds for the working class, and libraries and primary schools in rural areas, and his personal life was fully subject to his moral principles, which he had implemented despite persecution and prohibitions.He was \"a faithful son of the Catholic Church,\" but he was also a rationalist who refused to renounce his beliefs."
  shortBioRu: "\u0411\u0435\u0440\u043d\u0430\u0440\u0434 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    (Bernard Placidus Johann Nepomuk Bolzano, 1781\u20131848) \u2014 \u0447\u0435\u0448\u0441\u043a\u0438\u0439
    (\u0431\u043e\u0433\u0435\u043c\u0441\u043a\u0438\u0439) \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u043b\u043e\u0433\u0438\u043a, \u0444\u0438\u043b\u043e\u0441\u043e\u0444, \u0442\u0435\u043e\u043b\u043e\u0433
    \u0438 \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a
    \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0441\u0432\u043e\u0451 \u0432\u0440\u0435\u043c\u044f. \u041e\u043d \u0431\u044b\u043b
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430
    \u043c\u0435\u0436\u0434\u0443 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u043e\u0439 \u043c\u044b\u0441\u043b\u044c\u044e
    \u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0438 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u044b\u043c
    \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u0438\u0437\u043c\u043e\u043c \u0410\u0432\u0441\u0442\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0438\u043c\u043f\u0435\u0440\u0438\u0438. \u0412 \u044d\u0442\u043e\u043c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u043c
    \u043e\u0431\u0437\u043e\u0440\u0435 \u043c\u044b \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u0438\u043c
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u0443\u0442\u044c,
    \u043e\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0432 \u041f\u0440\u0430\u0433\u0435
    \u0434\u043e \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u044f \u0438 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c
    \u0435\u0433\u043e \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u043b\u043e\u0433\u0438\u043a\u0443
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e.\n\n\U0001F4DC \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b, \u0441\u0435\u043c\u044c\u044f \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u043c\u044c\u044f:
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    5 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1781 \u0433\u043e\u0434\u0430 \u0432 \u041f\u0440\u0430\u0433\u0435,
    \u0432 \u0441\u0430\u043c\u043e\u043c \u0441\u0435\u0440\u0434\u0446\u0435 \u0411\u043e\u0433\u0435\u043c\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u0442\u0432\u0430 (\u0442\u043e\u0433\u0434\u0430
    \u0447\u0430\u0441\u0442\u044c \u0438\u043c\u043f\u0435\u0440\u0438\u0438 \u0413\u0430\u0431\u0441\u0431\u0443\u0440\u0433\u043e\u0432).
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0411\u0435\u0440\u043d\u0430\u0440\u0434
    \u041f\u043e\u043c\u043f\u0435\u0439 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e, \u0431\u044b\u043b
    \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0435\u043c
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430,
    \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u043c \u0432
    \u041f\u0440\u0430\u0433\u0443, \u0430 \u043c\u0430\u0442\u044c, \u041c\u0430\u0440\u0438\u044f
    \u0421\u0435\u0441\u0438\u043b\u0438\u044f \u041c\u0430\u0443\u0440\u0435\u0440, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u044f\u0437\u044b\u0447\u043d\u043e\u0439
    \u043f\u0440\u0430\u0436\u0441\u043a\u043e\u0439 \u043a\u0443\u043f\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0438. \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0431\u044b\u043b\u0438
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u043c\u0438
    \u043a\u0430\u0442\u043e\u043b\u0438\u043a\u0430\u043c\u0438. \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u0438\u0437 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438 \u0434\u0435\u0442\u0435\u0439
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0434\u043e \u0432\u0437\u0440\u043e\u0441\u043b\u043e\u0433\u043e
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0434\u043e\u0436\u0438\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0411\u0435\u0440\u043d\u0430\u0440\u0434 \u0438 \u0435\u0433\u043e \u0431\u0440\u0430\u0442
    \u0418\u043e\u0433\u0430\u043d\u043d. \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435: \u041d\u0430 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u043e \u0431\u043b\u0430\u0433\u043e\u0447\u0435\u0441\u0442\u0438\u0435
    \u043e\u0442\u0446\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0441\u0442\u043e\u044f\u043b \u0443 \u0438\u0441\u0442\u043e\u043a\u043e\u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u043f\u0440\u0430\u0436\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u044e\u0442\u0430,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0432
    \u041f\u0440\u0430\u0436\u0441\u043a\u043e\u0439 \u043f\u0438\u0430\u0440\u0438\u0441\u0442\u0441\u043a\u043e\u0439
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438 (1791\u20131796). \u041f\u0438\u0430\u0440\u0438\u0441\u0442\u044b
    \u2014 \u043c\u043e\u043d\u0430\u0448\u0435\u0441\u043a\u0438\u0439 \u043e\u0440\u0434\u0435\u043d,
    \u0434\u0430\u0432\u0430\u0432\u0448\u0438\u0439 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043e\u0431\u0435\u0442 \u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043e
    \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0438 \u043c\u043e\u043b\u043e\u0434\u0435\u0436\u0438.
    \u042d\u0442\u0430 \u0441\u0440\u0435\u0434\u0430 \u0443\u043a\u0440\u0435\u043f\u0438\u043b\u0430
    \u0432 \u044e\u043d\u043e\u043c \u0411\u0435\u0440\u043d\u0430\u0440\u0434\u0435 \u043d\u0435
    \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435
    \u0434\u043e\u0433\u043c\u044b, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u043d\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438 \u0432\u0435\u0440\u0443 \u0432 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e\u0441\u0442\u044c. \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b: \u0412 1796 \u0433\u043e\u0434\u0443 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043d\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u041a\u0430\u0440\u043b\u043e\u0432\u0430
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0432 \u041f\u0440\u0430\u0433\u0435,
    \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e,
    \u0444\u0438\u0437\u0438\u043a\u0443 \u0438, \u0447\u0442\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432\u0430\u0436\u043d\u043e, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u0415\u0433\u043e \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u043b\u0438 \u0442\u0440\u0443\u0434\u044b
    \u0410\u0431\u0440\u0430\u0445\u0430\u043c\u0430 \u0413\u043e\u0442\u0442\u0445\u0435\u043b\u044c\u0444\u0430
    \u041a\u0435\u0441\u0442\u043d\u0435\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0434\u0430\u0436\u0435 \u0441\u0430\u043c\u044b\u0435 \u00ab\u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u0435\u00bb
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f.
    \u0412 1800 \u0433\u043e\u0434\u0443, \u043f\u0440\u043e\u0442\u0438\u0432 \u0432\u043e\u043b\u0438
    \u043e\u0442\u0446\u0430, \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0442\u0430\u043a\u0436\u0435
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043f\u0438\u0441\u0430\u043b:
    \u00ab\u041c\u043e\u0435 \u043e\u0441\u043e\u0431\u043e\u0435 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u043f\u043e\u043a\u043e\u0438\u043b\u043e\u0441\u044c\u2026
    \u043d\u0430 \u0435\u0435 \u0447\u0438\u0441\u0442\u043e \u0443\u043c\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0447\u0430\u0441\u0442\u044f\u0445, \u0438\u043d\u044b\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438,
    \u044f \u0446\u0435\u043d\u0438\u043b \u043b\u0438\u0448\u044c \u0442\u0443 \u0447\u0430\u0441\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0431\u044b\u043b\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439\u00bb. \u0412 1804 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043f\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438,
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0432 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u0439 \u0432\u0437\u0433\u043b\u044f\u0434
    \u043d\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430. \u0412\u0441\u0435\u0433\u043e
    \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043d\u044f \u043f\u043e\u0441\u043b\u0435
    \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438,
    \u0432 1804 \u0433\u043e\u0434\u0443, \u043e\u043d \u0431\u044b\u043b \u0440\u0443\u043a\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d
    \u0432 \u0441\u0430\u043d \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430.\n\n\U0001F3DB\ufe0f \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u0441 \u0432\u043b\u0430\u0441\u0442\u044f\u043c\u0438 \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0430:
    \u0412 1805 \u0433\u043e\u0434\u0443 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0431\u044b\u043b
    \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u043d\u0430 \u043d\u043e\u0432\u0443\u044e
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u0440\u0435\u043b\u0438\u0433\u0438\u0438 \u0432 \u041a\u0430\u0440\u043b\u043e\u0432\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u043e\u043c
    \u0438 \u043d\u0430 \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043a\u0430\u0444\u0435\u0434\u0440\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u0438
    \u0431\u044b\u043b\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0430 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0435\u043c I \u0434\u043b\u044f \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u044f
    \u043f\u043e\u0437\u0438\u0446\u0438\u0439 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438
    \u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0435\u0441 \u0438\u0434\u0435\u044f\u043c
    \u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0441\u0442\u0430\u043b \u043f\u043e\u043b\u043d\u043e\u0439
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e
    \u0442\u043e\u0433\u043e, \u043d\u0430 \u0447\u0442\u043e \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b\u0438
    \u0432\u043b\u0430\u0441\u0442\u0438. \u0415\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438
    \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c\u044e \u0443 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432,
    \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0434\u0435\u043a\u0430\u043d\u043e\u043c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0433\u043e \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430
    \u0432 1818 \u0433\u043e\u0434\u0443. \u041b\u0438\u0431\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u0438 \u0434\u043e\u043d\u043e\u0441: \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u043e\u043c,
    \u0443\u0442\u0438\u043b\u0438\u0442\u0430\u0440\u0438\u0441\u0442\u043e\u043c \u0438 \u043f\u043e\u0431\u043e\u0440\u043d\u0438\u043a\u043e\u043c
    \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e\u0441\u0442\u0438.
    \u0412 \u0441\u0432\u043e\u0438\u0445 \u043f\u0440\u043e\u043f\u043e\u0432\u0435\u0434\u044f\u0445
    \u0438 \u043b\u0435\u043a\u0446\u0438\u044f\u0445 \u043e\u043d \u0440\u0435\u0437\u043a\u043e
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b \u043c\u0438\u043b\u0438\u0442\u0430\u0440\u0438\u0437\u043c,
    \u0432\u043e\u0439\u043d\u0443 \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u043e, \u043f\u0440\u0438\u0437\u044b\u0432\u0430\u044f
    \u043a \u0440\u0435\u0444\u043e\u0440\u043c\u0430\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u041e\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u0437\u0430 \u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u043e \u0447\u0435\u0448\u0441\u043a\u043e\u0433\u043e
    \u0438 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0433\u043e \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f
    \u0432 \u0411\u043e\u0433\u0435\u043c\u0438\u0438, \u043e\u0441\u0443\u0436\u0434\u0430\u043b
    \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u043b
    \u043f\u0440\u0430\u0432\u0430 \u043a\u0440\u0435\u0441\u0442\u044c\u044f\u043d. \u0422\u0430\u043a\u0438\u0435
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0431\u044b\u0441\u0442\u0440\u043e
    \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0435\u0433\u043e \u0432\u0440\u0430\u0433\u043e\u043c
    \u0441\u0440\u0435\u0434\u0438 \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u044b\u0445 \u0438
    \u0441\u0432\u0435\u0442\u0441\u043a\u0438\u0445 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u043e\u0432.
    \u0412 1816 \u0433\u043e\u0434\u0443 \u0432 \u0412\u0435\u043d\u0441\u043a\u043e\u043c \u0441\u0443\u0434\u0435
    \u043d\u0430 \u043d\u0435\u0433\u043e \u0443\u0436\u0435 \u0431\u044b\u043b\u0438 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u044b
    \u0434\u0435\u043b\u0430. \u0423\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u0435 \u0438
    \u0441\u0441\u044b\u043b\u043a\u0430: \u041a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0441\u0442\u0430\u043b\u043e \u0434\u0435\u043a\u0430\u0431\u0440\u044c\u0441\u043a\u043e\u0435
    \u0443\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u0435 1819 \u0433\u043e\u0434\u0430.
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442\u0440\u0435\u0447\u044c\u0441\u044f \u043e\u0442 \u0441\u0432\u043e\u0438\u0445
    \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432 \u0438 \u0431\u044b\u043b \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0435\u043d
    \u043e\u0442 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u044b. \u0415\u043c\u0443
    \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0434\u043f\u0438\u0441\u0430\u043d\u043e \u0436\u0438\u0442\u044c
    \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435, \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u0430
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f \u0440\u0430\u0431\u043e\u0442
    (\u0437\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c \u0442\u0435\u0445,
    \u0447\u0442\u043e \u043d\u0435 \u043a\u0430\u0441\u0430\u043b\u0438\u0441\u044c \u0440\u0435\u043b\u0438\u0433\u0438\u0438
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438) \u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430
    \u0446\u0435\u043d\u0437\u0443\u0440\u0430 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438.
    \u0412 1821\u20131825 \u0433\u043e\u0434\u0430\u0445 \u043f\u0440\u043e\u0442\u0438\u0432
    \u043d\u0435\u0433\u043e \u0432\u0435\u043b\u0441\u044f \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u044b\u0439
    \u0441\u0443\u0434 \u043f\u043e \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044e \u0432
    \u0435\u0440\u0435\u0441\u0438. \u041e\u043d \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u0437\u0430\u0449\u0438\u0449\u0430\u043b \u0441\u0432\u043e\u0438 \u0432\u0437\u0433\u043b\u044f\u0434\u044b,
    \u043d\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0431\u044b\u043b \u0443\u0439\u0442\u0438 \u0432 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0443,
    \u0442\u0430\u043a \u0438 \u043d\u0435 \u043e\u0442\u0440\u0435\u043a\u0448\u0438\u0441\u044c
    \u043e\u0442 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u0439.\n\n\u231b \u0413\u043e\u0434\u044b
    \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u044f \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u041f\u0440\u0430\u0433\u0443 \u0421 1823 \u0433\u043e\u0434\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0436\u0438\u043b \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435 \u0422\u0435\u0445\u043e\u0431\u0443\u0437
    (Techobuz) \u0432 \u042e\u0436\u043d\u043e\u0439 \u0411\u043e\u0433\u0435\u043c\u0438\u0438,
    \u0432 \u0438\u043c\u0435\u043d\u0438\u0438 \u0441\u0432\u043e\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439
    \u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u0435\u0439, \u0441\u0435\u043c\u044c\u0438
    \u0413\u043e\u0444\u043c\u0430\u043d. \u041b\u0435\u0442\u043e\u043c \u043e\u043d \u0436\u0438\u043b
    \u0443 \u043d\u0438\u0445, \u0430 \u0437\u0438\u043c\u0443 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b
    \u0432 \u041f\u0440\u0430\u0433\u0435 \u0443 \u0431\u0440\u0430\u0442\u0430. \u042d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u0441\u0430\u043c\u044b\u043c \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c
    \u0432 \u043f\u043b\u0430\u043d\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0442\u0440\u0443\u0434\u043e\u0432.
    \u041e\u043d \u0438\u043c\u0435\u043b \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c
    \u0441\u0435\u0431\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0437\u0430\u043f\u0440\u0435\u0442\u044b
    \u0438 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u044e. \u0412 1842 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u0441\u043b\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0410\u043d\u043d\u044b
    \u0413\u043e\u0444\u043c\u0430\u043d, \u043e\u043d \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u0434\u0440\u0443\u0437\u0435\u0439 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041f\u0440\u0430\u0433\u0443, \u0433\u0434\u0435 \u0441\u043d\u043e\u0432\u0430
    \u0441\u0442\u0430\u043b \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0431\u043e\u0433\u0435\u043c\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u043d\u0430\u0443\u043a, \u0438 \u0434\u0430\u0436\u0435
    \u0431\u044b\u043b \u0435\u0433\u043e \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u0432 1842\u20131843 \u0433\u043e\u0434\u0430\u0445. \u0411\u0435\u0440\u043d\u0430\u0440\u0434
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u041f\u0440\u0430\u0433\u0435 18 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1848
    \u0433\u043e\u0434\u0430 \u043e\u0442 \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u044b,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u0430\u043b\u0430 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f
    \u043d\u0430 \u0435\u0433\u043e \u0441\u043b\u0430\u0431\u044b\u0435 \u043b\u0435\u0433\u043a\u0438\u0435.\n\n\U0001F4D0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0438\u043e\u043d\u0435\u0440\u043e\u0432
    \u0432 \u0434\u0435\u043b\u0435 \u043f\u0440\u0438\u0434\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0430\u043d\u0430\u043b\u0438\u0437\u0443 \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438.
    \u041e\u043d \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043e\u0442 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u044b\u0445
    \u043f\u043e\u043d\u044f\u0442\u0438\u0439 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u0441\u043e\u0437\u0434\u0430\u0432 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e (\u00ab\u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e\u00bb)
    \u043e\u0441\u043d\u043e\u0432\u0443. \u0415\u0433\u043e \u0438\u0434\u0435\u0438 \u043d\u0430\u043c\u043d\u043e\u0433\u043e
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438 \u0432\u0440\u0435\u043c\u044f \u0438
    \u0431\u044b\u043b\u0438 \u0437\u0430\u043d\u043e\u0432\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u044b
    \u043b\u0438\u0448\u044c \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f.
    \u0421\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043f\u0440\u0435\u0434\u0435\u043b\u0430 (\u03b5-\u03b4): \u0412 \u0441\u0432\u043e\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442\u0430\u0445, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a
    \u00abRein analytischer Beweis\u00bb (1817), \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0432\u0432\u0435\u043b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043f\u0440\u0435\u0434\u0435\u043b\u0430, \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0438\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u043e\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c\u0443
    \u044d\u043f\u0441\u0438\u043b\u043e\u043d-\u0434\u0435\u043b\u044c\u0442\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e.
    \u041e\u043d \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u043b \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    \u0438 \u0441\u0442\u0440\u043e\u0438\u043b \u0430\u043d\u0430\u043b\u0438\u0437 \u043d\u0430
    \u0441\u0442\u0440\u043e\u0433\u043e\u0439 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439
    \u043e\u0441\u043d\u043e\u0432\u0435. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    (\u043e \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u043e\u043c \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438):
    \u0412 \u0442\u043e\u0439 \u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0435 1817 \u0433\u043e\u0434\u0430
    \u043e\u043d \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u043e\u043c
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043a\u0430\u043a
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e\u2013\u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430:
    \u042d\u0442\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0430\u043d\u0430\u043b\u0438\u0437\u0430 (\u043e
    \u0442\u043e\u043c, \u0447\u0442\u043e \u0438\u0437 \u043b\u044e\u0431\u043e\u0439 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0439
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c \u0441\u0445\u043e\u0434\u044f\u0449\u0443\u044e\u0441\u044f
    \u043f\u043e\u0434\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c)
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0432 \u0435\u0433\u043e \u043d\u0435\u0438\u0437\u0434\u0430\u043d\u043d\u044b\u0445
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0445.
    \u041a\u0430\u0440\u043b \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0435\u0435 \u043f\u043e\u0437\u0436\u0435, \u0438 \u0434\u043e\u043b\u0433\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043d\u043e\u0441\u0438\u043b\u0430
    \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e \u0438\u043c\u044f, \u043f\u043e\u043a\u0430
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043d\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0438
    \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e.
    \u041f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u041a\u043e\u0448\u0438: \u0412 \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    1817 \u0433\u043e\u0434\u0430 \u043e\u043d \u0434\u0430\u043b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043a\u0430\u043a \u00ab\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u041a\u043e\u0448\u0438\u00bb, \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432 \u041e\u0433\u044e\u0441\u0442\u0435\u043d\u0430
    \u041b\u0443\u0438 \u041a\u043e\u0448\u0438 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u043d\u0430 \u0447\u0435\u0442\u044b\u0440\u0435 \u0433\u043e\u0434\u0430. \u00ab\u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u044b
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e\u00bb: \u0412 \u044d\u0442\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 (Paradoxien des Unendlichen, \u0438\u0437\u0434\u0430\u043d\u0430
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e \u0432 1851 \u0433\u043e\u0434\u0443)
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u043f\u0435\u0440\u0432\u044b\u043c \u0432\u0432\u0435\u043b
    \u0441\u0442\u0440\u043e\u0433\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438
    \u043d\u0430\u0434 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430\u043c\u0438, \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0432\u0437\u0430\u0438\u043c\u043d\u043e-\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e
    \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0441\u043e \u0441\u0432\u043e\u0435\u0439
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u044c\u044e,
    \u0438 \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u0435 \u0438\u0434\u0435\u0438
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b\u0438
    \u0413\u0435\u043e\u0440\u0433\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0430, \u0420\u0438\u0445\u0430\u0440\u0434\u0430
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430 \u0438 \u0427\u0430\u0440\u043b\u044c\u0437\u0430
    \u0421\u0430\u043d\u0434\u0435\u0440\u0441\u0430 \u041f\u0438\u0440\u0441\u0430.\n\n\U0001F9E0
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435 \u0438 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439 \u0442\u0440\u0443\u0434
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u2014 \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0442\u043e\u043c\u043d\u0430\u044f
    \u00ab\u041d\u0430\u0443\u043a\u043e\u0443\u0447\u0435\u043d\u0438\u0435\u00bb (Wissenschaftslehre,
    1837) \u2014 \u044d\u0442\u043e \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u043d\u0430\u0443\u043a\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u043d\u0430 \u043b\u043e\u0433\u0438\u043a\u0435 \u0438 \u044d\u043f\u0438\u0441\u0442\u0435\u043c\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0410\u043d\u0442\u0438\u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0437\u043c:
    \u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0438\u0434\u0435\u044f \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u2014 \u0436\u0435\u0441\u0442\u043a\u043e\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0438.
    \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u0437\u0430\u043a\u043e\u043d\u044b \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u0438\u0441\u0442\u0438\u043d\u044b
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e,
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u0438 \u044f\u0437\u044b\u043a\u0430.
    \u042d\u0442\u043e \u0440\u0435\u0437\u043a\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0441 \u0433\u043e\u0441\u043f\u043e\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u043c
    \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u0434\u0445\u043e\u0434\u043e\u043c \u0438 \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438. \u00ab\u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0441\u0430\u043c\u043e \u043f\u043e \u0441\u0435\u0431\u0435\u00bb (Satz an sich): \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e,
    \u0431\u0435\u0437\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0438 \u0431\u0435\u0437\u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u00ab\u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u0430\u043c\u043e\u0433\u043e
    \u043f\u043e \u0441\u0435\u0431\u0435\u00bb \u2014 \u0441\u043c\u044b\u0441\u043b\u0430
    \u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u0441\u0442\u0438\u043d\u043d\u044b\u043c
    \u0438\u043b\u0438 \u043b\u043e\u0436\u043d\u044b\u043c, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u0442\u043e\u0433\u043e, \u043c\u044b\u0441\u043b\u0438\u0442 \u043b\u0438
    \u0435\u0433\u043e \u043a\u0442\u043e-\u0442\u043e \u0438\u043b\u0438 \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0441\u0438\u0442.
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u043e\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0430 \u043d\u0430 \u042d\u0434\u043c\u0443\u043d\u0434\u0430
    \u0413\u0443\u0441\u0441\u0435\u0440\u043b\u044f, \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044f
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0438, \u0438 \u043c\u043d\u043e\u0433\u0438\u0445
    \u0434\u0440\u0443\u0433\u0438\u0445 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432.
    \u041b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    (Ableitbarkeit): \u0412 \u00ab\u041d\u0430\u0443\u043a\u043e\u0443\u0447\u0435\u043d\u0438\u0438\u00bb
    \u043e\u043d \u0434\u0430\u043b \u043e\u0434\u043d\u043e \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0439
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    (\u0432\u044b\u0432\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438) \u0447\u0435\u0440\u0435\u0437
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043f\u043e\u0434\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u044f\u043c\u044b\u043c \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0439
    \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u0430 \u0422\u0430\u0440\u0441\u043a\u043e\u0433\u043e.\n\n\U0001F4D6
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u043d\u0430\u0443\u043a\u0438
    \u042d\u0442\u0438\u043a\u0430 \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f: \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u0431\u044b\u043b \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0443\u0442\u0438\u043b\u0438\u0442\u0430\u0440\u0438\u0441\u0442\u043e\u043c. \u0415\u0433\u043e
    \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0433\u043b\u0430\u0441\u0438\u043b: \u00ab\u0418\u0437 \u0432\u0441\u0435\u0445 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445
    \u0442\u0435\u0431\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0432\u044b\u0431\u0438\u0440\u0430\u0439
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435,
    \u0432\u0437\u0432\u0435\u0441\u0438\u0432 \u0432\u0441\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f,
    \u0431\u043e\u043b\u0435\u0435 \u0432\u0441\u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0443\u0436\u0438\u0442
    \u0431\u043b\u0430\u0433\u0443 \u0446\u0435\u043b\u043e\u0433\u043e \u0432\u043e \u0432\u0441\u0435\u0445
    \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u044f\u0445\u00bb. \u042d\u0442\u043e \u0431\u044b\u043b
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u043f\u043e\u0441\u043e\u0431 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0438 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0440\u0435\u0444\u043e\u0440\u043c\u044b \u0431\u0435\u0437 \u043d\u0430\u0441\u0438\u043b\u0438\u044f.
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u0440\u0435\u043b\u0438\u0433\u0438\u0438:
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043c\u043d\u043e\u0433\u043e\u0442\u043e\u043c\u043d\u044b\u0439
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u043f\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044e
    (Lehrbuch der Religionswissenschaft), \u0433\u0434\u0435 \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e \u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0442\u044c
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435 \u0434\u043e\u0433\u043c\u0430\u0442\u044b,
    \u0447\u0442\u043e \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0443
    \u0441 \u0446\u0435\u0440\u043a\u043e\u0432\u044c\u044e.\n\n\U0001F3DB\ufe0f \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0438\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d \u043e\u0442 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0415\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b, \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0438\u0435
    \u0432\u0440\u0435\u043c\u044f, \u0431\u044b\u043b\u0438 \u043f\u0435\u0440\u0435\u043e\u0442\u043a\u0440\u044b\u0442\u044b
    \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 1881 \u0433\u043e\u0434\u0443 \u041e\u0442\u0442\u043e \u0428\u0442\u043e\u043b\u044c\u0446\u0435\u043c.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439
    \u0442\u0440\u0443\u0434 \u0441\u0442\u0430\u043b \u0448\u0438\u0440\u043e\u043a\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c,
    \u0442\u0430\u043a\u0438\u043c \u043a\u0430\u043a \u0424\u0440\u0430\u043d\u0446 \u0411\u0440\u0435\u043d\u0442\u0430\u043d\u043e,
    \u0430 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0433\u043e \u2014 \u0413\u0443\u0441\u0441\u0435\u0440\u043b\u044e,
    \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u043e \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u043a\u0430\u043a \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0438,
    \u0442\u0430\u043a \u0438 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438. \u0421\u0435\u0433\u043e\u0434\u043d\u044f
    \u043e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u043d \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u044b\u0441\u043b\u0438\u0442\u0435\u043b\u0435\u0439
    XIX \u0432\u0435\u043a\u0430, \u0447\u044c\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435,
    \u043d\u0430\u0447\u0430\u0432\u0448\u0435\u0435\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0432\u0435\u043a\u0430 \u043f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438, \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u044b\u043c."
  shortBioEn: "Bernard Bolzano (Bernard Placidus Johann Nepomuk Bolzano, 1781-1848) was a Czech mathematician, a logic, philosopher, theologist, and Catholic priest of Italian origin whose ideas were far ahead of their time, whose life reflected a tragic conflict between the leading thought of the Enlightenment and the conservative absoluteism of the Austrian Empire.In this detailed review, we will follow his life path, from his birth in Prague to exile and postmortem recognition, and will examine in detail his pioneering contribution to mathematics, logic and philosophy.\n\nEarly years, family and education Origin and family: Bolzano was born on 5 October 1781 in Prague, at the heart of the Kingdom of Bohemia (then part of the empire of Gabsburg). His father, Bernard Pompeey Bolzano, was an Italian art dealer who emigrated to Prague, and his mother, Maria Cecilia Maurer, came from a German-speaking Prague-based merchant family.Unfortunately, only Bernard and his brother Johann lived to an adult age among the 12 children in the family, with children and influence: Bolzano's personality was greatly influenced by the piety of his father, who was the foundation of the Prague shelter, and by his training at the Prague Paryristian Gymnasium (1791–1796).This environment has strengthened young Bernards not so much religious dogmas as deep moral beliefs and social justice, and in 1796 Bolzano joined the Philosophy Faculty of Karlov University in Prague, where he studied philosophy, physics and, most importantly, mathematics, and was inspired by Abraham Gotthelf Kestner, who sought to prove even the most \"obvious\" mathematical claims.In 1800, he also began studying theology against his father's will, and in 1804, he wrote: \"My special pleasure in mathematics was resting... on her purely mental parts, i.e., I only valued the part of mathematics that was simultaneously philosophy.\" In 1804 he received a Ph.D. in philosophy, presenting a thesis in geometry, in which he presented his view of the nature of mathematical evidence.Only two days after his thesis was defended, in 1804, he was ordained as a Catholic priest.\n\n* Academic career and conflict with the Professor's authorities: In 1805 Bolzano was appointed to the new Department of Religious Philosophy at the University of Karl, even though he was also the first candidate for the Department of Mathematics, and it is interesting that the Department of Religious Philosophy was created by Emperor Franz I to strengthen the conservative Catholic Church's position against the ideas of Enlightenment.However, Bolzano became the complete opposite of what the authorities had hoped for, and his lectures were very popular with the students, and he was elected Dean of the Philosophy Faculty in 1818, Liberal View and Report: Bolzano was a committed pacifist, utilitarian and socialist.In his sermons and lectures, he severely criticized militarism, war and social inequality, calling for educational and social reforms, and he advocated equality between the Czech and German population in Bohemia, condemned anti-Semitism and protected the rights of peasants, and quickly made him an enemy among church and secular conservatives.Dismissal and exile: The conflict culminated in the termination of office in December 1819, and Bolzano refused to renounce his views and was suspended from his profession; he was ordered to live in the village, was prohibited from publishing works (except those relating to religion and politics) and was censored by correspondence; and was tried by a church court in 1821-1825 on charges of heresy.He was brilliant in defending his views, but he eventually had to resign without giving up his beliefs.\n\nIn 1823, Bolzano lived mainly in the village of Techobuz in the South Bohemia, in the name of his friends and patrons, in the family of Hoffmann, in the summer, and spent the winter with his brother in Prague.In 1842, after his illness, Anna Goffmann moved to Prague with his family, where he was again an active member of the Royal Bohemian Society of Sciences, and even his president in 1842-1843, and Bernard Bolzano died in Prague on 18 December 1848 from a cold that caused complications to his weak lungs.\n\nThe Mathematical Achievement of Bolzano is one of the pioneers in making mathematical analysis strict, and he sought to rid mathematics of intuitive concepts of time and movement by creating a fully analytical (arhythmetic) foundation, which was far ahead of time and was not reopened until decades later.Strict definition of limit (--): In his works such as \"Rein analististscher Beweis\" (1817), Bolzano introduced a definition of limit virtually identical to the modern epsilon delta definition. He rejected the concept of infinitely small Leibnicus and based the analysis on a strict numerical basis.Theorem Bolzano (intermediate): In the same work in 1817, he gave the first rigorous analytical proof of the theorem of the intermediate value, now known as the Bolzano Theorem. Theorem Bolzano-Veyerstrasss: This fundamental theorem of analysis (that any limited sequence can be distinguished by a consistent sub-order) was fully proven by Bolzano in his unpublished work.Carl Weierstrasss independently proved it later, and for a long time theorem was only his name until historians discovered Bolzano's priority. Kosha's sequence: In his work in 1817, he defined what later became known as the \"Kosha sequence\", ahead of Augustin Louis Kosha by about four years.In this work (Paradoxien des Unendlichen, published postmortem in 1851) Bolzano was the first to impose strict operations on endless sets, showing that an infinite crowd can be mutually and indistinguishably compared with its own part, and giving the first ideas of the multiple theories that subsequently inspired George Cantor, Richard Dedekind and Charles Sanders Pierce.\n\nThe Philosophical and Logical Heritage of Bolzano, the four-volume \"Scientific Study\" (Wissenschaftslehre, 1837), is an attempt to create a comprehensive theory of science based on logic and epistemology. Antipsychism: The key idea of Bolzano is a rigid division of logic and psychology. He argued that the laws of logic and truth exist objectively, regardless of human thought and language.This contrasted sharply with the prevailing approach and pre-empted the basic principle of analytical philosophy. \"A proposal in itself\" (Satz an sich): Bolzano introduced the notion of an objective, timeless and indisposed \"proposal in itself\", a meaning of judgement that can be true or false, whether thought by someone or spoken by them.It was a revolutionary ontology that influenced Edmund Gusserl, the founder of phenomenalology, and many other philosophers.\n\nThe contribution of ethics and political philosophy to other sciences: Bolzano was a consistent utilitarian, and his ethical principle was: \"You must choose from all the actions that you have before you which, by weighing all the consequences, will best benefit the whole in all its parts.\" It was a way for him to justify his radical social and political reforms without violence.Philosophy of religion: He wrote a book on religious science (Lehrbuch der Religionswissenschaft), which tried to understand religious doctrine rationally, leading to a conflict with the church.\n\nHis postmortem recognition in Bolzano's life was virtually isolated from the scientific community, and his mathematical works, far ahead of time, were re-opened and published only in 1881 by Otto Stolzem.His main philosophy was widely known by his disciples and followers, such as Franz Brentano, and through him Gusserl, which made Bolzano one of the main predecessors of both phenomenal science and analytical philosophy, and he is now recognized as one of the greatest thinkers of the 19th century, whose influence, only half a century after his death, has proved enormous."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0411\u0435\u0440\u043d\u0430\u0440\u0434\u0430 \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0439 \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0445
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0439.
    \u0415\u0433\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0447\u0435\u043d\u044c
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0437\u0430\u0441\u043b\u0443\u0433, \u0430
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437 \u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0435,
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0435\u043c \u0441\u0432\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f, \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u0431\u044b\u043b\u0438
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b,
    \u0447\u0442\u043e \u0438\u0445 \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0438 \u043b\u0438\u0448\u044c
    \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f.\n\n\U0001F476
    \"\u0413\u043e\u043b\u043e\u0441, \u0432\u043e\u043f\u0438\u044e\u0449\u0438\u0439 \u0432
    \u043f\u0443\u0441\u0442\u044b\u043d\u0435\" \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u041a\u0430\u0440\u043b \u0411\u043e\u0439\u0435\u0440
    \u0438 \u0423\u0442\u0430 \u041c\u0435\u0440\u0446\u0431\u0430\u0445 \u043d\u0430\u0437\u0432\u0430\u043b\u0438
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \"\u0433\u043b\u0430\u0441\u043e\u043c
    \u0432\u043e\u043f\u0438\u044e\u0449\u0438\u043c \u0432 \u043f\u0443\u0441\u0442\u044b\u043d\u0435\".
    \u042d\u0442\u043e\u0442 \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0438\u0439 \u043e\u0431\u0440\u0430\u0437
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u0443: \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0435\u0433\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0431\u044b\u043b\u0438
    \u0437\u0430\u043d\u043e\u0432\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u044b \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438
    \u043e\u043d\u0438 \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u0437\u0430\u043c\u0435\u0447\u0435\u043d\u043d\u044b\u043c\u0438. \u041e\u043d
    \u0441\u043b\u043e\u0432\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u0438\u0441\u0442\u0438\u043d\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0431\u044b\u043b
    \u0433\u043e\u0442\u043e\u0432 \u0443\u0441\u043b\u044b\u0448\u0430\u0442\u044c.\n\n\U0001F52C
    \u041e\u043f\u0435\u0440\u0435\u0436\u0430\u044f \u0432\u0440\u0435\u043c\u044f: \"\u0423\u043a\u0440\u0430\u0434\u0435\u043d\u043d\u044b\u0435\"
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0421\u043f\u0438\u0441\u043e\u043a \u0435\u0433\u043e
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u0440\u0438\u043f\u0438\u0441\u0430\u043b\u0438 \u0434\u0440\u0443\u0433\u0438\u043c,
    \u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442: \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0439
    \u041a\u043e\u0448\u0438: \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439
    \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0437\u043d\u0430\u0435\u0442
    \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u0442\u0443\u0434\u0435\u043d\u0442-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0431\u044b\u043b \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e, \u0430 \u043d\u0435 \u041a\u043e\u0448\u0438.
    \u041e\u043d \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0443 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0442. \u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430\u044f,
    \u043d\u043e \u043d\u0438\u0433\u0434\u0435 \u043d\u0435 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u0443\u0435\u043c\u0430\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f: \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e
    \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0442\u0430\u043a\u0443\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043b\u043e\u043c\u0430\u0435\u0442 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u0443\u044e
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044e, \u0437\u0430 30 \u043b\u0435\u0442 \u0434\u043e
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b
    \u041a\u0430\u0440\u043b \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441,
    \u0447\u044c\u0435 \u0438\u043c\u044f \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u043e\u0447\u043d\u043e
    \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0441 \u044d\u0442\u0438\u043c
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e-\u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430:
    \u042d\u0442\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0431\u044b\u043b\u0430
    \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u0432 \u0447\u0435\u0441\u0442\u044c \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430,
    \u043f\u043e\u043a\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043d\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0438,
    \u0447\u0442\u043e \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0435\u0435 \u043d\u0430 \u043f\u043e\u043b\u0432\u0435\u043a\u0430 \u0440\u0430\u043d\u044c\u0448\u0435.\n\n\U0001F4DA
    \"\u041d\u0430\u0443\u0447\u043d\u043e\u0435\" \u0438\u0441\u0446\u0435\u043b\u0435\u043d\u0438\u0435:
    \u0417\u0430\u0431\u0430\u0432\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u0441
    \u0415\u0432\u043a\u043b\u0438\u0434\u043e\u043c \u041e\u0434\u043d\u0430\u0436\u0434\u044b,
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043d\u0438\u043a\u0443\u043b \u0432
    \u041f\u0440\u0430\u0433\u0435, \u0411\u043e\u043b\u044c\u0446\u0430\u043d\u043e \u0441\u0438\u043b\u044c\u043d\u043e
    \u0437\u0430\u0431\u043e\u043b\u0435\u043b. \u0412\u0441\u0435 \u0442\u0435\u043b\u043e
    \u043b\u043e\u043c\u0438\u043b\u043e, \u0438 \u043e\u043d \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441\u0442\u0440\u0430\u0448\u043d\u0443\u044e \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c.
    \u0416\u0435\u043b\u0430\u044f \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0441\u0432\u043e\u0435
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435, \u043e\u043d \u0432\u0437\u044f\u043b
    \u0432 \u0440\u0443\u043a\u0438 \"\u041d\u0430\u0447\u0430\u043b\u0430\" \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u0438 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u0435 \u043e \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445.
    \"\u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0432 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0438
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430, \u043d\u0430\u043f\u043e\u043b\u043d\u0438\u043b\u0430
    \u043c\u0435\u043d\u044f \u0442\u0430\u043a\u0438\u043c \u0436\u0438\u0432\u044b\u043c \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435\u043c,
    \u0447\u0442\u043e \u044f \u0442\u043e\u0442\u0447\u0430\u0441 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b
