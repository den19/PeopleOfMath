    \u0411\u043e\u0440\u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u0443\u043c\u0430\u0442\u044c.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0441\u043e\u043e\u0431\u0449\u0438\u043b
    \u043e \u0441\u0432\u043e\u0451\u043c \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u00ab\u0432\u0435\u043b\u0438\u043a\u043e\u043c\u0443
    \u0424\u0435\u043b\u0438\u043a\u0441\u0443\u00bb, \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438
    \u0432\u043e\u0446\u0430\u0440\u0438\u043b\u0430\u0441\u044c \u043b\u0435\u0434\u044f\u043d\u0430\u044f
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430. \u0410\u043f\u043e\u0433\u0435\u0435\u043c
    \u0438\u0445 \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439
    \u0441\u0442\u0430\u043b, \u043f\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e \u0411\u043e\u0440\u043d\u0430, \u0435\u0433\u043e
    \u0434\u043e\u043a\u043b\u0430\u0434 \u043f\u0435\u0440\u0435\u0434 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
