    klein, \u0447\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439\u00bb.
    \u042d\u0442\u0443 \u0438\u0433\u0440\u0443 \u0441\u043b\u043e\u0432 \u043e\u0431\u043e\u0436\u0430\u043b\u0438
    \u0435\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438.
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043d\u0435\u0433\u043e,
    \u0435\u0433\u043e \u0434\u0440\u0443\u0433 \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0430,
    \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0421\u043e\u0444\u0443\u0441 \u041b\u0438, \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c
    \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u043e\u0441\u0442\u0430, \u0437\u0430
    \u0447\u0442\u043e \u0435\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u00ab\u0433\u0435\u0440\u043c\u0430\u043d\u0441\u043a\u0438\u043c
    \u0432\u0435\u043b\u0438\u043a\u0430\u043d\u043e\u043c\u00bb. \u041c\u0435\u0436\u0434\u0443
    \u043d\u0438\u043c\u0438 \u0447\u0430\u0441\u0442\u043e \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u043b\u0438
    \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u0434\u0442\u0440\u0443\u043d\u0438\u0432\u0430\u043d\u0438\u044f,
    \u0438 \u041a\u043b\u0435\u0439\u043d \u0441 \u044e\u043c\u043e\u0440\u043e\u043c \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f
    \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0443
    \u0440\u043e\u0441\u0442\u0443 \u043d\u0430 \u0444\u043e\u043d\u0435 \u0434\u0440\u0443\u0433\u0430.\n\n\U0001F3DB\ufe0f
    \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d vs \u0411\u0435\u0440\u043b\u0438\u043d:
    \u0438\u0433\u0440\u0430 \u043f\u0440\u0435\u0441\u0442\u043e\u043b\u043e\u0432 \u041a\u043b\u0435\u0439\u043d
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0447\u0451\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c \u00ab\u0438\u0433\u0440\u043e\u043a\u043e\u043c
    \u043f\u0440\u0435\u0441\u0442\u043e\u043b\u043e\u0432\u00bb \u0432 \u043c\u0438\u0440\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412 \u043a\u043e\u043d\u0446\u0435
    XIX \u0432\u0435\u043a\u0430 \u043e\u0441\u0442\u0440\u043e \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0430\u043b\u0438
    \u0434\u0432\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0448\u043a\u043e\u043b\u044b \u2014 \u0431\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0430\u044f
    \u0438 \u0433\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0430\u044f. \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0441\u0432\u044b\u0441\u043e\u043a\u0430
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0438\u0441\u044c \u043a \u041a\u043b\u0435\u0439\u043d\u0443,
    \u0441\u0447\u0438\u0442\u0430\u044f \u0435\u0433\u043e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u044b\u043c
    \u00ab\u0444\u0430iseur\u00bb (\u0444\u0440. \u00ab\u043f\u043e\u0437\u0451\u0440, \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044c
    \u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0438\u0434\u00bb). \u041a\u043b\u0435\u0439\u043d,
    \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u0441\u0442\u0440\u043e\u0438\u043b
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435 \u00ab\u0438\u043c\u043f\u0435\u0440\u0438\u044e\u00bb,
    \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u044f \u043b\u0443\u0447\u0448\u0438\u0435
    \u0443\u043c\u044b \u0441\u043e \u0432\u0441\u0435\u0433\u043e \u043c\u0438\u0440\u0430,
    \u0438 \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c \u0441\u0447\u0451\u0442\u0435
    \u0438\u043c\u0435\u043d\u043d\u043e \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d
    \u0441\u0442\u0430\u043b \u043c\u0438\u0440\u043e\u0432\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c. \u042d\u0442\u0443 \u043f\u043e\u0431\u0435\u0434\u0443
    \u043e\u043d \u043e\u0434\u0435\u0440\u0436\u0430\u043b \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u0432\u043e\u0435\u043c\u0443
    \u0442\u0430\u043b\u0430\u043d\u0442\u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u0430
    \u0438 \u0441\u0435\u0442\u0435\u0432\u0438\u043a\u0430.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0422\u0440\u0443\u0434\u043e\u0433\u043e\u043b\u0438\u043a
    \u0438 \u0441\u0435\u043c\u044c\u044f \u041a\u043b\u0435\u0439\u043d \u0431\u044b\u043b
    \u043e\u0434\u0435\u0440\u0436\u0438\u043c \u0440\u0430\u0431\u043e\u0442\u043e\u0439. \u0412
    \u0441\u0432\u043e\u0438 \u00ab\u0437\u043e\u043b\u043e\u0442\u044b\u0435 \u0433\u043e\u0434\u044b\u00bb
    \u043e\u043d \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b,
    \u0447\u0442\u043e \u0435\u043c\u0443 \u043d\u0443\u0436\u043d\u043e \u0434\u0435\u043b\u0430\u0442\u044c
    \u0431\u043e\u043b\u044c\u0448\u0435 \u0438 \u043d\u0435 \u0434\u0430\u0432\u0430\u0442\u044c
    \u0441\u0435\u0431\u0435 \u043e\u0442\u0434\u044b\u0445\u0430. \u041e\u043d \u0431\u044b\u043b
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0442\u0440\u0443\u0434\u043e\u0433\u043e\u043b\u0438\u043a\u043e\u043c,
    \u0438 \u044d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u043f\u0440\u0438\u0447\u0438\u043d \u0435\u0433\u043e \u0438\u0441\u0442\u043e\u0449\u0435\u043d\u0438\u044f.
    \u041e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043d\u0435\u043c\u043d\u043e\u0433\u043e,
    \u0438\u0431\u043e, \u043a\u0430\u043a \u043e\u0442\u043c\u0435\u0447\u0430\u044e\u0442
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u044b, \u043e\u043d\u0430 \u0447\u0430\u0441\u0442\u043e
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u0432\u043d\u0435 \u043f\u043e\u043b\u044f
    \u0437\u0440\u0435\u043d\u0438\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439,
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u044b\u0445
    \u043d\u0430 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0432 1875 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0410\u043d\u043d\u0435
    \u0413\u0435\u0433\u0435\u043b\u044c, \u0432\u043d\u0443\u0447\u043a\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430 \u0413\u0435\u043e\u0440\u0433\u0430 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 \u0413\u0435\u0433\u0435\u043b\u044f. \u0423
    \u043d\u0438\u0445 \u0431\u044b\u043b\u043e \u0447\u0435\u0442\u0432\u0435\u0440\u043e \u0434\u0435\u0442\u0435\u0439:
    \u041e\u0442\u0442\u043e, \u041b\u0443\u0438\u0437\u0430, \u0421\u043e\u0444\u0438 (\u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0435) \u0438 \u042d\u043b\u0438\u0437\u0430\u0431\u0435\u0442.
    \u042d\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u0432\u043e\u044e \u043f\u043e\u0433\u043b\u043e\u0449\u0451\u043d\u043d\u043e\u0441\u0442\u044c
    \u043d\u0430\u0443\u043a\u043e\u0439, \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0430
    \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u0430\u044f \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F4DC \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438:
    \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432
    \u0421\u0430\u043c\u044b\u0439 \u043c\u0440\u0430\u0447\u043d\u044b\u0439 \u043a\u0443\u0440\u044c\u0451\u0437
    \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u041a\u043b\u0435\u0439\u043d\u0430. \u0412 1933 \u0433\u043e\u0434\u0443,
    \u0447\u0435\u0440\u0435\u0437 \u0432\u043e\u0441\u0435\u043c\u044c \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u043a\u043e\u043d\u0447\u0438\u043d\u044b, \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u0438\u0439
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0425\u0443\u0433\u043e \u0414\u0438\u043d\u0433\u043b\u0435\u0440
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0434\u043e\u043d\u043e\u0441, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u041a\u043b\u0435\u0439\u043d\u0430 \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438
    \u00ab\u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0430\u00bb
    \u0441 \u0446\u0435\u043b\u044c\u044e \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0414\u0438\u043d\u0433\u043b\u0435\u0440 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u041a\u043b\u0435\u0439\u043d \u0443\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e
    \u0441\u043e\u0437\u0434\u0430\u043b \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435
    \u0446\u0435\u043d\u0442\u0440 \u0434\u043b\u044f \u043f\u0440\u0438\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0445 \u0438 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445, \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0432 \u00ab\u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0435
    \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u00bb \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432
    \u043f\u043e \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438, \u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0434\u0438\u043a\u0442\u0430\u0442\u0443\u0440\u0443 \u043d\u0430\u0434 \u0432\u0441\u0435\u043c\u0438
    \u0432\u0430\u0436\u043d\u044b\u043c\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u0436\u0443\u0440\u043d\u0430\u043b\u0430\u043c\u0438 \u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u043c\u0438.
    \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u043e\u043d \u043e\u0431\u0432\u0438\u043d\u0438\u043b
    \u041a\u043b\u0435\u0439\u043d\u0430 \u0432 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u043c
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u043e\u0441\u0442\u044c \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0439
    (\u041a\u043b\u0435\u0439\u043d \u0441\u043f\u0430\u0441 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0438 \u043f\u0440\u0438\u0432\u043b\u0451\u043a
    \u0432 \u043d\u0435\u0451 \u0432\u0435\u0441\u044c \u0446\u0432\u0435\u0442 \u043d\u0430\u0443\u043a\u0438,
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f),
    \u044d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u043a\u0430\u043a\u0443\u044e \u043e\u0433\u0440\u043e\u043c\u043d\u0443\u044e \u0440\u043e\u043b\u044c
    \u043e\u043d \u0438\u0433\u0440\u0430\u043b \u0432 \u043d\u0430\u0443\u043a\u0435, \u0435\u0441\u043b\u0438
    \u0434\u0430\u0436\u0435 \u043d\u0430\u0446\u0438\u0441\u0442\u044b \u0441\u043f\u0443\u0441\u0442\u044f
    \u0433\u043e\u0434\u044b \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u044c
    \u0438\u0441\u0442\u043e\u0440\u0438\u044e, \u043f\u0440\u0438\u043f\u0438\u0441\u0430\u0432
    \u0435\u043c\u0443 \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438 \u043e \u00ab\u043c\u0438\u0440\u043e\u0432\u043e\u043c
    \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0435\u00bb. \u041f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438
    \u0432\u043b\u0430\u0441\u0442\u0438 \u043d\u0435 \u043d\u0430\u0448\u043b\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f\u043c, \u0438 \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u041a\u043b\u0435\u0439\u043d\u0430 \u043d\u0435 \u0431\u044b\u043b \u0441\u043d\u044f\u0442,
    \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u043c\u044b\u043c
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c \u0435\u0433\u043e
    \u0432\u0435\u043b\u0438\u0447\u0438\u044f.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f \u0414\u0430\u0432\u0438\u0434 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u041a\u043b\u0435\u0439\u043d \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d, \u0441\u043a\u0430\u0437\u0430\u043b
    \u043e \u043d\u0451\u043c \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439
    \u0434\u0435\u043d\u044c \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438:
    \u00ab\u0412\u0441\u0451, \u0447\u0442\u043e \u0432\u044b \u0437\u0434\u0435\u0441\u044c
    \u0432\u0438\u0434\u0438\u0442\u0435 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435,
    \u2014 \u0434\u0435\u043b\u043e \u0440\u0443\u043a \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    [...] \u0421\u0435\u043a\u0440\u0435\u0442 \u0443\u0441\u043f\u0435\u0445\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0441\u044f
    \u0432 \u0435\u0433\u043e \u043d\u0435\u043f\u043e\u0434\u043a\u0443\u043f\u043d\u043e\u0439
    \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438. \u0412\u0435\u043b\u0438\u043a\u0438\u0435
    \u0446\u0435\u043b\u0438, \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u2014 \u043c\u0435\u043b\u044c\u0447\u0430\u0439\u0448\u0438\u0435
    \u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u043e\u0431\u0443\u0436\u0434\u0435\u043d\u0438\u044f
    [...]\u00bb. \u042d\u0442\u043e \u0441\u0430\u043c\u043e\u0435 \u0442\u043e\u0447\u043d\u043e\u0435
    \u0438 \u043b\u0430\u043a\u043e\u043d\u0438\u0447\u043d\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0442\u043e\u0433\u043e, \u043a\u0435\u043c \u0431\u044b\u043b \u0424\u0435\u043b\u0438\u043a\u0441
    \u041a\u043b\u0435\u0439\u043d \u0434\u043b\u044f \u043d\u0430\u0443\u043a\u0438. \u041d\u0430
    \u0435\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0435 \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u043f\u0440\u043e\u0441\u0442\u0443\u044e, \u043d\u043e \u043e\u0447\u0435\u043d\u044c
    \u0451\u043c\u043a\u0443\u044e \u043d\u0430\u0434\u043f\u0438\u0441\u044c: \u00ab\u0424\u0435\u043b\u0438\u043a\u0441
    \u041a\u043b\u0435\u0439\u043d. \u0414\u0440\u0443\u0433. \u0418\u0441\u043a\u0440\u0435\u043d\u043d\u0438\u0439
    \u0438 \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u044b\u0439\u00bb."
