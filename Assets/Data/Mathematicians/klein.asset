  fullNameRu: "\u041A\u043B\u0435\u0439\u043D, \u0424\u0435\u043B\u0438\u043A\u0441
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043D"
  fullNameEn: Felix Christian Klein
  birthDate: 25.04.1849
  deathDate: 22.06.1925
