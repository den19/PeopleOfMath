  achievementsRu: "\u0424\u0435\u043b\u0438\u043a\u0441 \u041a\u043b\u0435\u0439\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0441\u043b\u0435\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u043d\u0435 \u043e\u0434\u043d\u0438\u043c, \u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438. \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430 \u2014
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0435\u0434\u0438\u043d\u043e\u0439 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438,
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0432\u0448\u0435\u0439 \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439,
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f.
    \u0415\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0438 \u0438\u0434\u0435\u0438 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0442\u0430\u043a:\n\n\U0001F4DC \u00ab\u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0441\u043a\u0430\u044f
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u00bb (1872): \u041e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0439 \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u043a\u043b\u0430\u0434
    \u041a\u043b\u0435\u0439\u043d\u0430. \u0421\u0443\u0442\u044c \u0435\u0433\u043e \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0438\u0434\u0435\u0438, \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0439 \u0432
    \u0438\u043d\u0430\u0443\u0433\u0443\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u043b\u0435\u043a\u0446\u0438\u0438, \u043f\u0440\u043e\u0441\u0442\u0430 \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0430:
    \u043b\u044e\u0431\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u2014
    \u044d\u0442\u043e, \u043f\u043e \u0441\u0443\u0442\u0438, \u0442\u0435\u043e\u0440\u0438\u044f
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 (\u0441\u0432\u043e\u0439\u0441\u0442\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f)
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439. \u0414\u043e
    \u041a\u043b\u0435\u0439\u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0445
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d. \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e: \u0415\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0438\u0437\u0443\u0447\u0430\u0435\u0442 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430,
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b\u0435 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0433\u0440\u0443\u043f\u043f\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 (\u043f\u043e\u0432\u043e\u0440\u043e\u0442\u044b,
    \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u044b). \u0410\u0444\u0444\u0438\u043d\u043d\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u2014 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b
    \u0430\u0444\u0444\u0438\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439.
    \u041f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u2014 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439. \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432\u0430\u0436\u043d\u043e, \u0447\u0442\u043e \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u044d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u043e\u0433\u043e.
    \u041a\u043b\u0435\u0439\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u043e\u043d\u0430 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u0430
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0433\u0440\u0443\u043f\u043f\u044b \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439, \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0445
    \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u0435\u0447\u0435\u043d\u0438\u0435
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u0440\u0443\u0433). \u042d\u0442\u043e
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u044f\u0441\u043d\u0438\u043b\u043e
    \u0435\u0451 \u043c\u0435\u0441\u0442\u043e \u0441\u0440\u0435\u0434\u0438 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0439, \u043d\u043e \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u043e
    \u0435\u0451 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c.
    \u0421\u0430\u043c\u0430 \u0438\u0434\u0435\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0439 \u0447\u0435\u0440\u0435\u0437 \u0438\u0445
    \u0433\u0440\u0443\u043f\u043f\u044b \u043b\u0435\u0433\u043b\u0430 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0430
    \u0438 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0439
    \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u043e\u043b\u044f.\n\n\U0001F9E9 \u0423\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0438 \u0438\u043a\u043e\u0441\u0430\u044d\u0434\u0440
    \u042d\u0442\u043e \u043e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0445 \u0440\u0430\u0431\u043e\u0442 \u041a\u043b\u0435\u0439\u043d\u0430,
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0430\u044f \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0430\u043b\u0433\u0435\u0431\u0440\u043e\u0439,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439 \u0438 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0433\u0440\u0443\u043f\u043f. \u0412 \u0441\u0432\u043e\u0435\u0439 \u043a\u043d\u0438\u0433\u0435
    \u00ab\u041b\u0435\u043a\u0446\u0438\u0438 \u043e\u0431 \u0438\u043a\u043e\u0441\u0430\u044d\u0434\u0440\u0435
    \u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438\u00bb (1884) \u043e\u043d
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0443,
    \u043d\u0430\u0434 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u0438\u043b\u0438\u0441\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f\u043c\u0438:
    \u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u0440\u0435\u0448\u0438\u0442\u044c \u043e\u0431\u0449\u0435\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 5-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \u0432 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u0430\u0445? (\u041e\u0442\u0432\u0435\u0442:
    \u043d\u0435\u0442, \u044d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0410\u0431\u0435\u043b\u044c).
    \u041a\u043b\u0435\u0439\u043d \u043f\u043e\u0448\u0451\u043b \u0434\u0440\u0443\u0433\u0438\u043c
    \u043f\u0443\u0442\u0451\u043c. \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0433\u0440\u0443\u043f\u043f\u0430 \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0439
    \u0438\u043a\u043e\u0441\u0430\u044d\u0434\u0440\u0430 (\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0433\u043e
    \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438\u0433\u0440\u0430\u043d\u043d\u0438\u043a\u0430)
    \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u043c\u043e\u043d\u043e\u0434\u0440\u043e\u043c\u0438\u0435\u0439
    (\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f\u043c\u0438 \u043a\u043e\u0440\u043d\u0435\u0439)
    \u043e\u0431\u0449\u0435\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u041e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u044d\u0442\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0440\u0430\u0437\u0438\u0442\u044c
    \u043d\u0435 \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044b,
    \u0430 \u0447\u0435\u0440\u0435\u0437 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u2014 \u0433\u043e\u0440\u0430\u0437\u0434\u043e
    \u0431\u043e\u043b\u0435\u0435 \u0441\u043b\u043e\u0436\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u2014 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f
    (\u0443\u0432\u0438\u0434\u0435\u043d\u043d\u0430\u044f \u0432 \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f\u0445
    \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u0430) \u043f\u0440\u0438\u0432\u0435\u043b\u0430
    \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b.\n\n\U0001F4D0
    \u0422\u0435\u043e\u0440\u0438\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u042d\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0430\u043c\u044b\u043c
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u044b\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u043c
    \u0432 \u0436\u0438\u0437\u043d\u0438 \u041a\u043b\u0435\u0439\u043d\u0430. \u041e\u043d\u043e
    \u0441\u0442\u0430\u043b\u043e \u043b\u043e\u0433\u0438\u0447\u043d\u044b\u043c \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c
    \u0438\u0434\u0435\u0439 \u00ab\u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u0439
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b\u00bb \u0438 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u043d\u0430\u0434 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435\u043c \u043f\u044f\u0442\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0412\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e:
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435,
    \u041a\u043b\u0435\u0439\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f
    (\u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b) \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445 \u0433\u0440\u0443\u043f\u043f
    \u0434\u0440\u043e\u0431\u043d\u043e-\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439.
    \u041c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u044b\u0439 \u0442\u0440\u0443\u0434: \u0412\u043c\u0435\u0441\u0442\u0435
    \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u0420\u043e\u0431\u0435\u0440\u0442\u043e\u043c \u0424\u0440\u0438\u043a\u0435 \u043e\u043d
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    4-\u0442\u043e\u043c\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u00ab\u041b\u0435\u043a\u0446\u0438\u0438
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u0438\u0442\u043e\u0433\u043e\u043c \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0438 \u043e\u043a\u0430\u0437\u0430\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f \u041b\u0438, \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b.\n\n\U0001F522 \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043d\u044b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u041c\u043e\u0434\u0435\u043b\u044c \u041a\u043b\u0435\u0439\u043d\u0430: \u0412 \u0435\u0433\u043e
    \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u043e\u0434\u043d\u0430
    \u0438\u0437 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438 (\u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u0430\u044f
    \u043c\u043e\u0434\u0435\u043b\u044c), \u0433\u0434\u0435 \u00ab\u043f\u0440\u044f\u043c\u044b\u043c\u0438\u00bb
    \u0441\u043b\u0443\u0436\u0430\u0442 \u0445\u043e\u0440\u0434\u044b \u043a\u0440\u0443\u0433\u0430.
    \u041a\u0432\u0430\u0440\u0442\u0438\u043a\u0430 \u041a\u043b\u0435\u0439\u043d\u0430: \u0412
    1878 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u0443 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c
    \u0440\u043e\u0434\u0430 3, \u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0449\u0443\u044e
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0439
    \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0440\u043e\u0434\u0430 \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0435\u0439
    (168 \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u0438\u0437\u043c\u043e\u0432). \u042d\u0442\u0430
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c, \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u0430\u0436\u043d\u044b\u043c
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u043c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0420\u0435\u0444\u043e\u0440\u043c\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f:
    \u041e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u00ab\u0447\u0438\u0441\u0442\u043e\u0439\u00bb \u043d\u0430\u0443\u043a\u043e\u0439. \u041a\u043b\u0435\u0439\u043d
    \u0441\u044b\u0433\u0440\u0430\u043b \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e \u0440\u043e\u043b\u044c
    \u0432 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0432 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0446\u0435\u043d\u0442\u0440
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0440\u0435\u0444\u043e\u0440\u043c\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u043d\u0430\u043f\u0438\u0441\u0430\u0432
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u0442\u0440\u0443\u0434\u044b
    \u043f\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u00ab\u0441 \u0432\u044b\u0441\u0448\u0435\u0439 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f\u00bb.
    \u0424\u0435\u043b\u0438\u043a\u0441 \u041a\u043b\u0435\u0439\u043d \u0431\u044b\u043b \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c
    \u0438\u0434\u0435\u0439, \u043d\u043e \u0438 \u00ab\u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u043e\u043c\u00bb
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0443\u043c\u0435\u043b \u0441\u0432\u044f\u0437\u0430\u0442\u044c \u0432\u043e\u0435\u0434\u0438\u043d\u043e
    \u0435\u0451 \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u0447\u0430\u0441\u0442\u0438
    \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043a\u0440\u0430\u0441\u043e\u0442\u0443
    \u0438 \u0441\u0438\u043b\u0443 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e-\u0433\u0440\u0443\u043f\u043f\u043e\u0432\u043e\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430. \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u043c\u043d\u043e\u0433\u0438\u0445
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0435\u043e\u0440\u0438\u0439."
  achievementsEn: 
  personalLifeRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0424\u0435\u043b\u0438\u043a\u0441\u0430
    \u041a\u043b\u0435\u0439\u043d\u0430 \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432\u043b\u0438\u044f\u043b
    \u043d\u0430 \u043d\u0430\u0443\u043a\u0443 \u0441\u0432\u043e\u0438\u043c\u0438 \u043b\u0438\u0447\u043d\u044b\u043c\u0438
    \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430\u043c\u0438, \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c\u0438
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u0432\u0430\u0442\u044c \u043a\u0440\u0438\u0437\u0438\u0441\u044b.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b
    \u0434\u0435\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0438.\n\n\U0001F4DC \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0424\u0435\u043b\u0438\u043a\u0441
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d \u041a\u043b\u0435\u0439\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    25 \u0430\u043f\u0440\u0435\u043b\u044f 1849 \u0433\u043e\u0434\u0430 \u0432 \u0414\u044e\u0441\u0441\u0435\u043b\u044c\u0434\u043e\u0440\u0444\u0435,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u043f\u0440\u0443\u0441\u0441\u043a\u0438\u0445 \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u043e\u0432.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041a\u0430\u0441\u043f\u0430\u0440 \u041a\u043b\u0435\u0439\u043d,
    \u0431\u044b\u043b \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0435\u043c \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u0432 \u0420\u0435\u0439\u043d\u0441\u043a\u043e\u0439
    \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0438, \u0430 \u043c\u0430\u0442\u044c
    \u2014 \u0421\u043e\u0444\u0438 \u042d\u043b\u0438\u0437, \u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f
    \u041a\u0430\u0439\u0441\u0435\u0440. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u044f\u0440\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0435\u0433\u043e
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f: \u043e\u043d\u043e \u0441\u043e\u0432\u043f\u0430\u043b\u043e
    \u0441 \u0443\u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0431\u043e\u044f\u043c\u0438 \u0420\u0435\u0439\u043d\u0441\u043a\u043e\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438 \u043f\u0440\u043e\u0442\u0438\u0432
    \u043f\u0440\u0443\u0441\u0441\u043a\u0438\u0445 \u0432\u043b\u0430\u0441\u0442\u0435\u0439,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0434\u0430\u043b\u043e \u0435\u0433\u043e \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e
    \u043d\u0430 \u0441\u0432\u0435\u0442 \u043f\u043e\u0447\u0442\u0438 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440.\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430
    \u0438 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0413\u0438\u043c\u043d\u0430\u0437\u0438\u044f
    \u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442: \u041a\u043b\u0435\u0439\u043d
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e
    \u0432 \u0414\u044e\u0441\u0441\u0435\u043b\u044c\u0434\u043e\u0440\u0444\u0435 \u0438 \u0432
    1865 \u0433\u043e\u0434\u0443 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0411\u043e\u043d\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0433\u0434\u0435 \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e
    \u043d\u0430\u043c\u0435\u0440\u0435\u0432\u0430\u043b\u0441\u044f \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u0444\u0438\u0437\u0438\u043a\u0443. \u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c: \u0421\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u044b\u043c
    \u0441\u0442\u0430\u043b\u043e \u0435\u0433\u043e \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e
    \u0441 \u042e\u043b\u0438\u0443\u0441\u043e\u043c \u041f\u043b\u044e\u043a\u043a\u0435\u0440\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438. \u041a\u043b\u0435\u0439\u043d \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c \u0432
    1866 \u0433\u043e\u0434\u0443. \u041f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c
    \u041f\u043b\u044e\u043a\u043a\u0435\u0440\u0430, \u0447\u0435\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043b\u0435\u0436\u0430\u043b \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u041a\u043b\u0435\u0439\u043d\u0430 \u0441\u043c\u0435\u0441\u0442\u0438\u043b\u0438\u0441\u044c
    \u0432 \u044d\u0442\u0443 \u0441\u0442\u043e\u0440\u043e\u043d\u0443. \u0414\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c: \u0412 1868 \u0433\u043e\u0434\u0443, \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19 \u043b\u0435\u0442, \u043f\u043e\u0434
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u041f\u043b\u044e\u043a\u043a\u0435\u0440\u0430
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0437\u0430 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043b\u0438\u043d\u0438\u0439
    \u0438 \u0435\u0451 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c \u043a
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435. \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u041f\u043b\u044e\u043a\u043a\u0435\u0440\u0430 \u0432 \u0442\u043e\u043c \u0436\u0435
    \u0433\u043e\u0434\u0443 \u0438\u043c\u0435\u043d\u043d\u043e \u041a\u043b\u0435\u0439\u043d\u0443
    \u0431\u044b\u043b\u043e \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c
    \u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u043a \u043f\u0435\u0447\u0430\u0442\u0438
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0442\u043e\u043c \u0435\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430.\n\n\U0001F30D \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f
    \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u041a\u043b\u0435\u0439\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043f\u043e\u0435\u0437\u0434\u043a\u0443 \u043f\u043e \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438,
    \u043f\u043e\u0441\u0435\u0442\u0438\u0432 \u0411\u0435\u0440\u043b\u0438\u043d, \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d
    \u0438 \u041f\u0430\u0440\u0438\u0436. \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043d\u0430 \u043d\u0435\u0433\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u0431\u043e\u043b\u044c\u0448\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0441
    \u043a\u0440\u0443\u043f\u043d\u044b\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438,
    \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0410\u043b\u044c\u0444\u0440\u0435\u0434
    \u041a\u043b\u0435\u0431\u0448 (\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0438\u0434\u0435\u043b
    \u0432 \u043d\u0451\u043c \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u043b\u0438\u0434\u0435\u0440\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438) \u0438, \u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u0441 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0421\u043e\u0444\u0443\u0441\u043e\u043c \u041b\u0438. \u0418\u043c\u0435\u043d\u043d\u043e
    \u041b\u0438 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b \u041a\u043b\u0435\u0439\u043d\u0430
    \u0441 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0435\u0439 \u0433\u0440\u0443\u043f\u043f,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u044b\u0433\u0440\u0430\u043b\u0430 \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435. \u0412 1870 \u0433\u043e\u0434\u0443, \u043f\u0435\u0440\u0435\u0434
    \u0441\u0430\u043c\u044b\u043c \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0424\u0440\u0430\u043d\u043a\u043e-\u043f\u0440\u0443\u0441\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b, \u041a\u043b\u0435\u0439\u043d \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u041b\u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u0433\u0434\u0435 \u043e\u0431\u0449\u0430\u043b\u0441\u044f \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438
    \u0416\u0430\u043d\u043e\u043c \u0413\u0430\u0441\u0442\u043e\u043d\u043e\u043c \u0414\u0430\u0440\u0431\u0443
    \u0438 \u041a\u0430\u043c\u0438\u043b\u0435\u043c \u0416\u043e\u0440\u0434\u0430\u043d\u043e\u043c.
    \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0432\u043e\u0439\u043d\u044b \u043e\u043d
    \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u0441\u0440\u043e\u0447\u043d\u043e
    \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e
    \u0438 \u0447\u0443\u0442\u044c \u043d\u0435 \u0441\u0442\u0430\u043b \u0436\u0435\u0440\u0442\u0432\u043e\u0439
    \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0438 \u0442\u0438\u0444\u0430.\n\n\U0001F3DB\ufe0f
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d
    (1872\u20131875): \u041f\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438
    \u041a\u043b\u0435\u0431\u0448\u0430, 23-\u043b\u0435\u0442\u043d\u0438\u0439 \u041a\u043b\u0435\u0439\u043d
    \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u044e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u00ab\u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0441\u043a\u0443\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443\u00bb, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u0435\u043c\u0443 \u043e\u0431\u0449\u0435\u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c. \u041c\u044e\u043d\u0445\u0435\u043d
    (1875\u20131880): \u0412 1875 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0451\u043b
    \u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u0412\u044b\u0441\u0448\u0443\u044e \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u041c\u044e\u043d\u0445\u0435\u043d\u0435. \u042d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0431\u044b\u043b \u043e\u0442\u043c\u0435\u0447\u0435\u043d
    \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438: \u0432 \u044d\u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0410\u043d\u043d\u0435
    \u0413\u0435\u0433\u0435\u043b\u044c, \u0432\u043d\u0443\u0447\u043a\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430 \u0413\u0435\u043e\u0440\u0433\u0430 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 \u0413\u0435\u0433\u0435\u043b\u044f. \u0412
    \u041c\u044e\u043d\u0445\u0435\u043d\u0435 \u041a\u043b\u0435\u0439\u043d \u0438 \u0435\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440
    \u0444\u043e\u043d \u0411\u0440\u0438\u043b\u043b\u044c \u0447\u0438\u0442\u0430\u043b\u0438
    \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u0435 \u043a\u0443\u0440\u0441\u044b
    \u0434\u043b\u044f \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432,
    \u0441\u0440\u0435\u0434\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0431\u044b\u043b\u0438
    \u0410\u0434\u043e\u043b\u044c\u0444 \u0413\u0443\u0440\u0432\u0438\u0446, \u0412\u0430\u043b\u044c\u0442\u0435\u0440
    \u0444\u043e\u043d \u0414\u0438\u043a, \u041a\u0430\u0440\u043b \u0420\u0443\u043d\u0433\u0435
    \u0438 \u041c\u0430\u043a\u0441 \u041f\u043b\u0430\u043d\u043a. \u0412 1876 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u0442\u0430\u043b \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u043e\u043c
    \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0436\u0443\u0440\u043d\u0430\u043b\u0430 \u00abMathematische Annalen\u00bb. \u041b\u0435\u0439\u043f\u0446\u0438\u0433
    (1880\u20131886): \u0417\u0430\u0442\u0435\u043c \u041a\u043b\u0435\u0439\u043d \u0431\u044b\u043b
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0451\u043d \u043d\u0430 \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u042d\u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u0441\u0442\u0430\u043b\u043e \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u0430\u043c\u044b\u043c
    \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u043c
    \u043f\u043b\u0430\u043d\u0435, \u043d\u043e \u0438 \u0441\u0430\u043c\u044b\u043c \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u043c.
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0432 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u0438 \u043d\u0430\u043f\u0440\u044f\u0436\u0451\u043d\u043d\u043e\u043c \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u0441 \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435. \u0412
    1882\u20131884 \u0433\u043e\u0434\u0430\u0445 \u0435\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435,
    \u043f\u043e\u0434\u043e\u0440\u0432\u0430\u043d\u043d\u043e\u0435 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u044b\u043c
    \u043f\u0435\u0440\u0435\u0443\u0442\u043e\u043c\u043b\u0435\u043d\u0438\u0435\u043c, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0440\u0443\u0445\u043d\u0443\u043b\u043e: \u043e\u043d \u043f\u0435\u0440\u0435\u0436\u0438\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044e.
    \u042d\u0442\u0430 \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u043e\u043b\u043e\u0436\u0438\u043b\u0430 \u043a\u043e\u043d\u0435\u0446 \u0435\u0433\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0430
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u044c\u0441\u044f \u043d\u0430
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0438
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443.
    \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d (1886\u20131913) \u0438 \u043a\u043e\u043d\u0447\u0438\u043d\u0430:
    \u0412 1886 \u0433\u043e\u0434\u0443 \u041a\u043b\u0435\u0439\u043d \u043f\u0440\u0438\u043d\u044f\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0443 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0417\u0434\u0435\u0441\u044c
    \u043e\u043d \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0432 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u041e\u043d \u0432\u0432\u0451\u043b
    \u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u044b,
    \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443 \u0438 \u043f\u0440\u0438\u0432\u043b\u0451\u043a
    \u043a \u0440\u0430\u0431\u043e\u0442\u0435 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435
    \u0414\u0430\u0432\u0438\u0434\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430.
    \u041e\u043d \u0447\u0438\u0442\u0430\u043b \u044f\u0440\u043a\u0438\u0435 \u043a\u0443\u0440\u0441\u044b
    \u043f\u043e \u0441\u0430\u043c\u044b\u043c \u0440\u0430\u0437\u043d\u044b\u043c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c,
    \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u044f \u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e \u0432\u0441\u0435\u0433\u043e \u043c\u0438\u0440\u0430. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0440\u0435\u0444\u043e\u0440\u043c\u0435 \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u043d\u0430\u0443\u0447\u043d\u043e-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u0432. \u0412 1913 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0432\u044b\u0448\u0435\u043b \u0432 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0443
    \u043f\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f,
    \u043d\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c.
    \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u041a\u043b\u0435\u0439\u043d, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u043a\u043e\u043b\u043b\u0435\u0433,
    \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0448\u043e\u0432\u0438\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0430\u043a\u0446\u0438\u044f\u0445. \u0412 1924 \u0433\u043e\u0434\u0443 \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0448\u0438\u0440\u043e\u043a\u043e
    \u043e\u0442\u043c\u0435\u0442\u0438\u043b\u0430 \u0435\u0433\u043e 75-\u043b\u0435\u0442\u0438\u0435.
    \u0424\u0435\u043b\u0438\u043a\u0441 \u041a\u043b\u0435\u0439\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435 22 \u0438\u044e\u043d\u044f
    1925 \u0433\u043e\u0434\u0430 \u0438 \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043d\u0430 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u043c \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435.
    \u0412 1933 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438, \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u043e\u043b\u043e\u0433\u0438, \u0432 \u0440\u0430\u043c\u043a\u0430\u0445
    \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u00ab\u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u043e\u0439\u00bb, \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c
    \u043e\u0441\u043f\u043e\u0440\u0438\u0442\u044c \u0435\u0433\u043e \u00ab\u0430\u0440\u0438\u0439\u0441\u043a\u043e\u0435\u00bb
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043e\u0431\u0432\u0438\u043d\u0438\u0442\u044c
    \u0432 \u043f\u043e\u0442\u0432\u043e\u0440\u0441\u0442\u0432\u0435 \u0435\u0432\u0440\u0435\u044f\u043c,
    \u043d\u043e \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u043e \u044d\u0442\u0438\u0445
    \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0439.\n\n\U0001F9D1\u200d\U0001F91D\u200d\U0001F9D1
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0421\u043e\u0444\u0443\u0441 \u041b\u0438: \u0421\u0430\u043c\u043e\u0435 \u0442\u0435\u0441\u043d\u043e\u0435
    \u0438 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0435 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e.
    \u0418\u0445 \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0432 1869 \u0433\u043e\u0434\u0443
    \u0438 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f. \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435:
    \u0421\u043e\u043f\u0435\u0440\u043d\u0438\u043a \u0438 \u0434\u0440\u0443\u0433. \u0418\u0445
    \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0446\u0438\u044f \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0431\u044b\u043b\u0430 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439,
    \u043d\u043e \u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439. \u041e\u043d\u0438
    \u043e\u0431\u043c\u0435\u043d\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u043f\u0438\u0441\u044c\u043c\u0430\u043c\u0438
    \u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0438\u0441\u044c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0432\u0435\u043b\u0438\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0443\u043d\u0438\u0444\u043e\u0440\u043c\u0438\u0437\u0430\u0446\u0438\u0438.
    \u0414\u0430\u0432\u0438\u0434 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442: \u041a\u043b\u0435\u0439\u043d
    \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d \u0432 1895 \u0433\u043e\u0434\u0443,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u0438\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0446\u0435\u043d\u0442\u0440 \u043c\u0438\u0440\u0430. \u0410\u043b\u044c\u0444\u0440\u0435\u0434
    \u041a\u043b\u0435\u0431\u0448: \u0412\u0430\u0436\u043d\u044b\u0439 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043b
    \u041a\u043b\u0435\u0439\u043d\u0430 \u043d\u0430 \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0432 \u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0435.
    \u042d\u043c\u043c\u0438 \u041d\u0451\u0442\u0435\u0440: \u041a\u043b\u0435\u0439\u043d
    \u0442\u0435\u0441\u043d\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b
    \u0441 \u043d\u0435\u0439 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044f
    \u0435\u0451 \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0438 \u043e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u041e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0435\u0451 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043a \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438
    \u0432 1918 \u0433\u043e\u0434\u0443. \u0413\u0440\u0435\u0439\u0441 \u0427\u0438\u0441\u0445\u043e\u043b\u043c
    \u042f\u043d\u0433: \u041a\u043b\u0435\u0439\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b
    \u0435\u0451 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0435\u0439 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0437\u0430\u0449\u0438\u0449\u0451\u043d\u043d\u043e\u0439 \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u0412 \u0446\u0435\u043b\u043e\u043c,
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0443\u0441\u0438\u043b\u0438\u044f\u043c
    \u041a\u043b\u0435\u0439\u043d\u0430, \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0436\u0435\u043d\u0449\u0438\u043d
    \u0432 1893 \u0433\u043e\u0434\u0443."
  personalLifeEn: 
  shortBioRu: "\u0424\u0435\u043b\u0438\u043a\u0441 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d \u041a\u043b\u0435\u0439\u043d
    (1849\u20131925) \u2014 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u0451 \u0438\u043c\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u043f\u0438\u0441\u0430\u043d\u043e
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043d\u0430\u0443\u043a\u0438. \u041e\u043d
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0451\u043d\u044b\u043c, \u043d\u043e \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c, \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u043c
    \u0438 \u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0442\u043e\u0440\u043e\u043c, \u0441\u0443\u043c\u0435\u0432\u0448\u0438\u043c
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432 \u0441\u0442\u0440\u043e\u0439\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u0438 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0432 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438.\n\n\U0001F4DC \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 (1849\u20131872)
    \u041a\u043b\u0435\u0439\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0414\u044e\u0441\u0441\u0435\u043b\u044c\u0434\u043e\u0440\u0444\u0435
    25 \u0430\u043f\u0440\u0435\u043b\u044f 1849 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0435\u043c\u044c\u0435
    \u043f\u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u0440\u0435\u0434\u0430\u043d\u0438\u0435,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u043e\u0432\u043f\u0430\u043b\u043e
    \u0441 \u0443\u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0431\u043e\u044f\u043c\u0438 \u0420\u0435\u0439\u043d\u0441\u043a\u043e\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438, \u0447\u0442\u043e \u043f\u0440\u0438\u0434\u0430\u0451\u0442
    \u0435\u0433\u043e \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e \u043d\u0430 \u0441\u0432\u0435\u0442
    \u043f\u043e\u0447\u0442\u0438 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440. \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0411\u043e\u043d\u043d\u0430 \u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c: \u0412 1865 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 16 \u043b\u0435\u0442, \u041a\u043b\u0435\u0439\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0411\u043e\u043d\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0433\u0434\u0435 \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e
    \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u0444\u0438\u0437\u0438\u043a\u0443. \u0421\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u044b\u043c
    \u0441\u0442\u0430\u043b\u043e \u0435\u0433\u043e \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e
    \u0441 \u042e\u043b\u0438\u0443\u0441\u043e\u043c \u041f\u043b\u044e\u043a\u043a\u0435\u0440\u043e\u043c,
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438. \u041a\u043b\u0435\u0439\u043d \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c, \u0438
    \u043f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u041f\u043b\u044e\u043a\u043a\u0435\u0440\u0430
    \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u0441\u043c\u0435\u0441\u0442\u0438\u043b\u0438\u0441\u044c
    \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0420\u0430\u043d\u043d\u0438\u0439 \u0434\u043e\u043a\u0442\u043e\u0440\u0430\u0442 \u0438
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u0442\u0440\u0443\u0434\u043e\u0432
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f: \u0412 1868 \u0433\u043e\u0434\u0443, \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19 \u043b\u0435\u0442, \u041a\u043b\u0435\u0439\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0437\u0430 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043b\u0438\u043d\u0438\u0439
    \u0438 \u0435\u0451 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c \u043a
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435. \u041a\u043e\u0433\u0434\u0430 \u0432
    \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u041f\u043b\u044e\u043a\u043a\u0435\u0440
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f, \u0438\u043c\u0435\u043d\u043d\u043e
    \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u041a\u043b\u0435\u0439\u043d \u0431\u044b\u043b
    \u043f\u0440\u0438\u0437\u0432\u0430\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c
    \u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u043a \u043f\u0435\u0447\u0430\u0442\u0438
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0442\u043e\u043c \u0435\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430 \u00ab\u041d\u043e\u0432\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u00bb. \u0413\u043e\u0434\u044b
    \u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0438\u0439 \u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430:
    \u041f\u043e\u0441\u043b\u0435 \u0411\u043e\u043d\u043d\u0430 \u041a\u043b\u0435\u0439\u043d
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043f\u043e\u0435\u0437\u0434\u043a\u0443 \u043f\u043e \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438,
    \u043f\u043e\u0441\u0435\u0442\u0438\u0432 \u0411\u0435\u0440\u043b\u0438\u043d, \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d
    \u0438 \u041f\u0430\u0440\u0438\u0436. \u041e\u0441\u043e\u0431\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043d\u0435\u0433\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0441 \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u043e\u043c \u041a\u043b\u0435\u0431\u0448\u0435\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b
    \u0432 \u043d\u0451\u043c \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u043b\u0438\u0434\u0435\u0440\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412 1870 \u0433\u043e\u0434\u0443
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u041a\u043b\u0435\u0439\u043d \u043d\u0430\u0447\u0430\u043b
    \u0441\u0432\u043e\u0451 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0421\u043e\u0444\u0443\u0441\u043e\u043c \u041b\u0438, \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043e\u043d\u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f. \u0418\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u0430
    \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0424\u0440\u0430\u043d\u043a\u043e-\u043f\u0440\u0443\u0441\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b, \u0432\u044b\u043d\u0443\u0434\u0438\u0432\u0448\u0435\u0439
    \u041a\u043b\u0435\u0439\u043d\u0430 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e.\n\n\U0001F9E0 \u0420\u0430\u0441\u0446\u0432\u0435\u0442
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u00ab\u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0441\u043a\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u00bb
    (1872\u20131886) \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b
    \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u041a\u043b\u0435\u0439\u043d\u0430. \u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u044b\u0439
    \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442: \u0412 1872 \u0433\u043e\u0434\u0443,
    \u043f\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u041a\u043b\u0435\u0431\u0448\u0430,
    23-\u043b\u0435\u0442\u043d\u0438\u0439 \u041a\u043b\u0435\u0439\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0430.
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u0438\u043d\u0430\u0443\u0433\u0443\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u043b\u0435\u043a\u0446\u0438\u0438 (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u043a\u0430\u043a \u00ab\u0421\u0440\u0430\u0432\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0438\u0435 \u043d\u043e\u0432\u044b\u0445
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439\u00bb)
    \u043e\u043d \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0438\u0434\u0435\u0438, \u0432\u043e\u0448\u0435\u0434\u0448\u0438\u0435
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043a\u0430\u043a \u00ab\u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0441\u043a\u0430\u044f
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u00bb. \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f
    \u043c\u044b\u0441\u043b\u044c \u0431\u044b\u043b\u0430 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0439:
    \u043a\u0430\u0436\u0434\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    (\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430, \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430,
    \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u0438 \u0442.\u0434.)
    \u0435\u0441\u0442\u044c \u043d\u0435 \u0447\u0442\u043e \u0438\u043d\u043e\u0435, \u043a\u0430\u043a
    \u0442\u0435\u043e\u0440\u0438\u044f \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439. \u042d\u0442\u043e
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b,
    \u043d\u043e \u0438 \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u041c\u044e\u043d\u0445\u0435\u043d \u0438 \u041b\u0435\u0439\u043f\u0446\u0438\u0433:
    \u0412 1875 \u0433\u043e\u0434\u0443 \u041a\u043b\u0435\u0439\u043d \u043f\u0435\u0440\u0435\u0448\u0451\u043b
    \u0432 \u041c\u044e\u043d\u0445\u0435\u043d\u0441\u043a\u0438\u0439 \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c,
    \u0430 \u0432 1880 \u0433\u043e\u0434\u0443 \u2014 \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0412 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0435
    \u043e\u043d \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0441\u0432\u043e\u044e \u0441\u0430\u043c\u0443\u044e
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u0443\u044e, \u043d\u043e \u0438
    \u0441\u0430\u043c\u0443\u044e \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u0443\u044e
    \u043f\u043e\u0440\u0443. \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445 \u0438 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0432\u0441\u0442\u0443\u043f\u0438\u0432 \u0432
    \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u043e\u0435, \u043d\u043e \u043d\u0430\u043f\u0440\u044f\u0436\u0451\u043d\u043d\u043e\u0435
    \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441 \u0410\u043d\u0440\u0438
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0437\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0432\u0435\u043b\u0438\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0443\u043d\u0438\u0444\u043e\u0440\u043c\u0438\u0437\u0430\u0446\u0438\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c \u0435\u0433\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0441\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c. \u041a\u0440\u0438\u0437\u0438\u0441
    \u0438 \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u0438\u0435:
    \u041e\u043a\u043e\u043b\u043e 1882\u20131884 \u0433\u043e\u0434\u043e\u0432 \u0438\u0437-\u0437\u0430
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0443\u0442\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0438 \u043d\u0435\u0440\u0432\u043d\u043e\u0433\u043e \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u041a\u043b\u0435\u0439\u043d\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0440\u0443\u0445\u043d\u0443\u043b\u043e, \u043e\u043d \u0432\u043f\u0430\u043b \u0432
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044e.
    \u042d\u0442\u0430 \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u043e\u043b\u043e\u0436\u0438\u043b\u0430 \u043a\u043e\u043d\u0435\u0446 \u0435\u0433\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f-\u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0430
    \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u044c
    \u0441\u0432\u043e\u044e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e
    \u044d\u043d\u0435\u0440\u0433\u0438\u044e \u043d\u0430 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044e
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435.\n\n\U0001F3DB\ufe0f
    \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434:
    \u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440 \u0438 \u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0442\u043e\u0440
    (1886\u20131925) \u041f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d
    \u0432 1886 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u043d\u043e\u0432\u043e\u0433\u043e, \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0432\u0430\u0436\u043d\u043e\u0433\u043e
    \u044d\u0442\u0430\u043f\u0430 \u0432 \u0436\u0438\u0437\u043d\u0438 \u041a\u043b\u0435\u0439\u043d\u0430.
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e
    \u0446\u0435\u043d\u0442\u0440\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438:
    \u041a\u043b\u0435\u0439\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0446\u0435\u043b\u044c
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d
    \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0446\u0435\u043d\u0442\u0440 \u043c\u0438\u0440\u0430. \u041e\u043d \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0442\u0443\u0434\u0430 \u0414\u0430\u0432\u0438\u0434\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u0441\u043e\u0437\u0434\u0430\u043b \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443 \u0438 \u0432\u0432\u0451\u043b
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443 \u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u043e\u0432 \u0438 \u043a\u043e\u043b\u043b\u043e\u043a\u0432\u0438\u0443\u043c\u043e\u0432.
    \u041c\u043e\u0434\u0435\u043b\u044c \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430,
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0430\u044f \u041a\u043b\u0435\u0439\u043d\u043e\u043c,
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c \u0434\u043b\u044f
    \u043f\u043e\u0434\u0440\u0430\u0436\u0430\u043d\u0438\u044f \u0432\u043e \u0432\u0441\u0451\u043c
    \u043c\u0438\u0440\u0435. \u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c: \u0421 1876 \u0433\u043e\u0434\u0430
    \u0438 \u043f\u043e\u0447\u0442\u0438 40 \u043b\u0435\u0442 \u041a\u043b\u0435\u0439\u043d
    \u0431\u044b\u043b \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u043e\u043c
    \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0436\u0443\u0440\u043d\u0430\u043b\u043e\u0432
    \u043c\u0438\u0440\u0430 \u2014 \u00abMathematische Annalen\u00bb. \u0415\u0433\u043e \u0443\u043c\u0435\u043b\u043e\u0435
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0432\u044b\u0432\u0435\u043b\u043e
    \u0436\u0443\u0440\u043d\u0430\u043b \u043d\u0430 \u043b\u0438\u0434\u0438\u0440\u0443\u044e\u0449\u0438\u0435
    \u043f\u043e\u0437\u0438\u0446\u0438\u0438. \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e,
    \u043e\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c
    \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u00ab\u042d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a\u00bb.
    \u041f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u043a\u0430 \u0438 \u0440\u0435\u0444\u043e\u0440\u043c\u0430
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f: \u041a\u043b\u0435\u0439\u043d
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0442\u0440\u0443\u0434
    \u00ab\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0441 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0432\u044b\u0441\u0448\u0435\u0439\u00bb
    \u0431\u044b\u043b \u043d\u0430\u043f\u0438\u0441\u0430\u043d \u0434\u043b\u044f \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439
    \u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c\u044e. \u0412 1908
    \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c
    \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u0435\u043c \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439
    \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044e. \u041f\u0440\u0438 \u0435\u0433\u043e
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435
    \u0432 1893 \u0433\u043e\u0434\u0443 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043d\u0430\u0447\u0430\u043b
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0436\u0435\u043d\u0449\u0438\u043d
    \u0434\u043b\u044f \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435 \u0430\u0441\u043f\u0435\u043a\u0442\u044b:
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445
    \u00ab\u0447\u0438\u0441\u0442\u044b\u0445\u00bb \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u041a\u043b\u0435\u0439\u043d \u0443\u0434\u0435\u043b\u044f\u043b \u0431\u043e\u043b\u044c\u0448\u043e\u0435
    \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c.
    \u041e\u043d \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u043f\u0440\u0438 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u0432 \u0434\u043b\u044f \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u0430 \u0432
    \u043f\u0440\u0435\u043a\u043b\u043e\u043d\u043d\u043e\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 \u0438 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e.
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441\u043e \u0441\u0432\u043e\u0438\u043c
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c \u0410\u0440\u043d\u043e\u043b\u044c\u0434\u043e\u043c
    \u0417\u043e\u043c\u043c\u0435\u0440\u0444\u0435\u043b\u044c\u0434\u043e\u043c \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0447\u0435\u0442\u044b\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0438\u0440\u043e\u0441\u043a\u043e\u043f\u0430.
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b: \u041a\u043b\u0435\u0439\u043d
    \u0432\u044b\u0448\u0435\u043b \u0432 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0443 \u0432
    1913 \u0433\u043e\u0434\u0443, \u043d\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438. \u0412 \u0433\u043e\u0434\u044b
    \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u043e\u043d, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433, \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0448\u043e\u0432\u0438\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0430\u043a\u0446\u0438\u044f\u0445. \u0412 1924 \u0433\u043e\u0434\u0443 \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u0448\u0438\u0440\u043e\u043a\u043e
    \u043e\u0442\u043c\u0435\u0442\u0438\u043b\u043e \u0435\u0433\u043e 75-\u043b\u0435\u0442\u0438\u0435,
    \u0430 22 \u0438\u044e\u043d\u044f 1925 \u0433\u043e\u0434\u0430 \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435.\n\n\U0001F52C \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0412\u043a\u043b\u0430\u0434 \u0424\u0435\u043b\u0438\u043a\u0441\u0430
    \u041a\u043b\u0435\u0439\u043d\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043e\u0433\u0440\u043e\u043c\u0435\u043d. \u041f\u043e\u043c\u0438\u043c\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u00ab\u042d\u0440\u043b\u0430\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b\u00bb,
    \u043a \u0435\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c
    \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f: \u041d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043c\u043e\u0434\u0435\u043b\u044c \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 (\u043c\u043e\u0434\u0435\u043b\u044c
    \u041a\u043b\u0435\u0439\u043d\u0430), \u0434\u043e\u043a\u0430\u0437\u0430\u0432 \u0435\u0451
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439: \u041e\u043d
    \u0432\u043d\u0451\u0441 \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u043c\u043d\u043e\u0433\u043e\u0442\u043e\u043c\u043d\u043e\u0439 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439
    \u0441 \u0420\u043e\u0431\u0435\u0440\u0442\u043e\u043c \u0424\u0440\u0438\u043a\u0435.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0443\u043f\u043f: \u0415\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u0441\u0432\u044f\u0437\u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0443\u043f\u043f \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439
    \u043f\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043f\u044f\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043a\u043e\u0441\u0430\u044d\u0434\u0440\u0430.
    \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f: \u041e\u043d \u043e\u043f\u0438\u0441\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u00ab\u0431\u0443\u0442\u044b\u043b\u043a\u0443
    \u041a\u043b\u0435\u0439\u043d\u0430\u00bb \u2014 \u043e\u0434\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044e\u044e
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0431\u0435\u0437 \u043a\u0440\u0430\u044f,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u043c \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0424\u0435\u043b\u0438\u043a\u0441 \u041a\u043b\u0435\u0439\u043d \u0431\u044b\u043b \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0447\u0451\u043d\u044b\u043c; \u043e\u043d
    \u0431\u044b\u043b \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438, \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u0435\u0451 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u0432, \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0439
    \u0438 \u0441\u0432\u044f\u0437\u0435\u0439 \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c\u0438 \u0437\u043d\u0430\u043d\u0438\u044f.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0438 \u0440\u0430\u0431\u043e\u0442\u0430
    \u2014 \u044d\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u043c
    \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043c\u043e\u0433\u0443\u0442
    \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043b\u0438\u0446\u043e \u0446\u0435\u043b\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0424\u0435\u043b\u0438\u043a\u0441 \u041a\u043b\u0435\u0439\u043d \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e, \u0438 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u043f\u043e\u043b\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0441\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0439,
    \u043d\u043e \u0438 \u044f\u0440\u043a\u0438\u0445, \u0430 \u043f\u043e\u0440\u043e\u0439
    \u0438 \u043a\u0443\u0440\u044c\u0451\u0437\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439.
    \u0412\u043e\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437 \u043d\u0438\u0445,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u043b\u0438\u0441\u044c.\n\n\U0001F604 \u00ab\u0412\u0435\u043b\u0438\u043a\u0438\u0439
    \u0424\u0435\u043b\u0438\u043a\u0441\u00bb \u0438 \u0435\u0433\u043e \u0436\u0435\u043b\u0435\u0437\u043d\u0430\u044f
    \u0432\u043e\u043b\u044f \u0412 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435,
    \u0433\u0434\u0435 \u041a\u043b\u0435\u0439\u043d \u0431\u044b\u043b \u043d\u0435\u043f\u0440\u0435\u0440\u0435\u043a\u0430\u0435\u043c\u044b\u043c
    \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u043c, \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b
    \u0441 \u043f\u043e\u0447\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u0440\u043e\u043d\u0438\u0435\u0439
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \u00ab\u0432\u0435\u043b\u0438\u043a\u0438\u0439
    \u0424\u0435\u043b\u0438\u043a\u0441\u00bb. \u041e\u043d \u043e\u0431\u043b\u0430\u0434\u0430\u043b
    \u0445\u0430\u0440\u0438\u0437\u043c\u043e\u0439 \u0438 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u0435\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0434\u043d\u0438\u043c \u0441\u043b\u043e\u0432\u043e\u043c \u043c\u043e\u0433 \u043a\u0430\u043a
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e
