  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041b\u044c\u0432\u0430 \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447\u0430 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e \u0438
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430
    \u0442\u0440\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f,
    \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432
    \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f.\n\n\U0001F9E9
    \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f \u0438 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0433\u0440\u0443\u043f\u043f: \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u041f\u0435\u0440\u0432\u044b\u0435 \u0438,
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430
    \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435. \u0423\u0436\u0435 \u0432 1932 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0442\u0430\u043b\u043e \u0432\u0435\u0445\u043e\u0439
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0417\u0430\u043a\u043e\u043d
    \u0434\u0432\u043e\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430:
    \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u0435\u0433\u043e \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430.
    \u041e\u043d \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u0437\u0430\u043a\u043e\u043d \u0434\u0432\u043e\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0435\u0440\u0430, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0432
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0433\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0432 \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u043c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435 \u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438
    \u0435\u0433\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f. \u041f\u043e
    \u0441\u0443\u0442\u0438, \u044d\u0442\u043e\u0442 \u0437\u0430\u043a\u043e\u043d \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u0433\u0440\u0443\u043f\u043f\u044b \u0411\u0435\u0442\u0442\u0438 (\u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0435
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438 \"\u0434\u044b\u0440\u043e\u043a\"
    \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435) \u043e\u0434\u043d\u043e\u0433\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0447\u0435\u0440\u0435\u0437 \u0433\u0440\u0443\u043f\u043f\u044b
    \u0411\u0435\u0442\u0442\u0438 \u0434\u0440\u0443\u0433\u043e\u0433\u043e. \u042d\u0442\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0434\u0430\u043b\u043e \u043c\u043e\u0449\u043d\u044b\u0439
    \u0438\u043c\u043f\u0443\u043b\u044c\u0441 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044e
    \u0432\u0441\u0435\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u0432 \u0438 \u0434\u0432\u043e\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430: \u0420\u0430\u0437\u0432\u0438\u0432\u0430\u044f
    \u0441\u0432\u043e\u0439 \u0437\u0430\u043a\u043e\u043d \u0434\u0432\u043e\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u043e\u0431\u0449\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u0432
    \u0434\u043b\u044f \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u044b\u0445
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f.
    \u0421\u0435\u0433\u043e\u0434\u043d\u044f \u044d\u0442\u0430 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043a\u0430\u043a \u0434\u0432\u043e\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430-\u0432\u0430\u043d \u041a\u0430\u043c\u043f\u0435\u043d\u0430
    \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043d\u0430 \u0433\u0440\u0443\u043f\u043f\u0430\u0445.
    \u042d\u0442\u0430 \u0442\u0435\u043e\u0440\u0438\u044f \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f
    \u043d\u0430 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0435
    \u0430\u0431\u0435\u043b\u0435\u0432\u044b \u0433\u0440\u0443\u043f\u043f\u044b \u0438 \u0431\u044b\u043b\u0430
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0430 \u043d\u0430 \u0441\u043b\u0443\u0447\u0430\u0439
    \u043d\u0435\u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f (\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0422\u0430\u043d\u043d\u0430\u043a\u0430-\u041a\u0440\u0435\u0439\u043d\u0430). \u041e\u043d\u0430
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0430 \u0446\u0435\u043b\u0443\u044e
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443. \u0414\u0440\u0443\u0433\u0438\u0435 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f: \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043b\u0430\u0441\u0441\u044b \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430:
    \u041e\u043d \u0432\u0432\u0435\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u043b\u0430\u0434\u043a\u0438\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u043e\u0441\u044f\u0442
    \u0435\u0433\u043e \u0438\u043c\u044f. \u0422\u0435\u043e\u0440\u0438\u044f \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438:
    \u0423\u0447\u0435\u043d\u044b\u0439 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u043f\u0440\u0438\u043c\u0435\u0440,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043e\u0432
    \u0440\u0430\u0432\u043d\u0430 \u0441\u0443\u043c\u043c\u0435 \u0438\u0445 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0435\u0439,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0432\u0430\u0436\u043d\u044b\u043c \u0438
    \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c.
    \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439:
    \u041e\u043d \u043f\u0440\u043e\u0432\u0435\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e
    \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u0441\u0444\u0435\u0440
    \u0432\u044b\u0441\u0448\u0438\u0445 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0435\u0439,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0448\u0430\u0433\u043e\u043c \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0439.
    \u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u044d\u0442\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u2014 \"\u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b\" (1938), \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0432 1941 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u0421\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438.\n\n\U0001F680
    \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f: \"\u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430\" \u0412 \u043d\u0430\u0447\u0430\u043b\u0435
    1950-\u0445 \u0433\u043e\u0434\u043e\u0432 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u043c\u0435\u043b\u044b\u0439 \u043f\u043e\u0432\u043e\u0440\u043e\u0442
    \u0432 \u0441\u0432\u043e\u0435\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u0435,
    \u043f\u0435\u0440\u0435\u0439\u0434\u044f \u043e\u0442 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438 \u043a \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u043c
    \u0437\u0430\u0434\u0430\u0447\u0430\u043c. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c
    \u0441\u0442\u0430\u043b\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432. \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438: \u041f\u043e\u0432\u043e\u0434\u043e\u043c \u043f\u043e\u0441\u043b\u0443\u0436\u0438\u043b\u0430
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u0430\u044f
    \u0437\u0430\u0434\u0430\u0447\u0430, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f
    \u0441 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043e\u043c.
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043b
    \u043c\u0435\u0436\u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0439
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0434\u0435\u043b\u0438\u043b\u0438\u0441\u044c
    \u0441\u0432\u043e\u0438\u043c\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c\u0438.
    \u042d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u0435\u0433\u043e \u0438
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 (\u0412.\u0413. \u0411\u043e\u043b\u0442\u044f\u043d\u0441\u043a\u043e\u0433\u043e,
    \u0420.\u0412. \u0413\u0430\u043c\u043a\u0440\u0435\u043b\u0438\u0434\u0437\u0435, \u0415.\u0424.
    \u041c\u0438\u0449\u0435\u043d\u043a\u043e) \u043a \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0435
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430. \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430:
    \u0421\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0432 1956 \u0433\u043e\u0434\u0443, \u044d\u0442\u043e\u0442 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0434\u0430\u0435\u0442 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0434\u043b\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u043c\u044b\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0445
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u043c
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u0421\u0443\u0442\u044c \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430
    \u043c\u043e\u0436\u043d\u043e \u043a\u0440\u0430\u0442\u043a\u043e \u043e\u043f\u0438\u0441\u0430\u0442\u044c
    \u0442\u0430\u043a: 1. \u0414\u043b\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0437\u0430\u0434\u0430\u0435\u0442\u0441\u044f
    \u0441\u043a\u0430\u043b\u044f\u0440\u043d\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f
    \u2014 \u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0438\u0430\u043d `H`, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u0435\u0442 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0435
    \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \"\u0441\u043e\u043f\u0440\u044f\u0436\u0435\u043d\u043d\u044b\u0435\" \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435.
    2. \u0423\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e
    \u0434\u043b\u044f \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439
    \u0435\u043c\u0443 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0442\u0430\u043a\u043e\u0439
    \u043d\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0431\u043e\u0440
    \u0441\u043e\u043f\u0440\u044f\u0436\u0435\u043d\u043d\u044b\u0445 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445,
    \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0438\u0430\u043d
    \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442 \u0441\u0432\u043e\u0435\u0433\u043e
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430 \u0432 \u043a\u0430\u0436\u0434\u043e\u0439
    \u0442\u043e\u0447\u043a\u0435 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438.
    3. \u0422\u0430\u043a\u0436\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u044e\u0442\u0441\u044f
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043d\u0430 \u043a\u043e\u043d\u0446\u0430\u0445 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438
    \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0435 `M(\u03c8(t1), x(t1)) = 0` \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e \u043f\u0440\u043e\u0440\u044b\u0432\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0432\u044b\u0432\u0435\u043b\u043e \u0442\u0435\u043e\u0440\u0438\u044e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u043d\u0430 \u043d\u043e\u0432\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c.
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f,
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e
    \u0440\u0435\u0448\u0430\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0438 \u0441 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f\u043c\u0438
    \u043d\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    `u(t)` \u0434\u043e\u043b\u0436\u043d\u043e \u043b\u0435\u0436\u0430\u0442\u044c \u0432
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u043c
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435). \u041e\u043d \u0441\u0442\u0430\u043b
    \u043c\u043e\u0449\u043d\u0435\u0439\u0448\u0438\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0439 \u0432 \u0430\u0432\u0438\u0430\u0446\u0438\u0438,
    \u043a\u043e\u0441\u043c\u043e\u043d\u0430\u0432\u0442\u0438\u043a\u0435, \u0440\u043e\u0431\u043e\u0442\u043e\u0442\u0435\u0445\u043d\u0438\u043a\u0435
    \u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435. \u0417\u0430 \u044d\u0442\u043e\u0442
    \u0446\u0438\u043a\u043b \u0440\u0430\u0431\u043e\u0442 \u0432 1962 \u0433\u043e\u0434\u0443
    \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432 \u0430\u0432\u0442\u043e\u0440\u043e\u0432
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438.\n\n\U0001F52C \u0414\u0440\u0443\u0433\u0438\u0435
    \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0435 \u0432\u043a\u043b\u0430\u0434\u044b \u041f\u043e\u043c\u0438\u043c\u043e
    \u0434\u0432\u0443\u0445 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439, \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u0432\u043d\u0435\u0441 \u0432\u0435\u0441\u043e\u043c\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438:
    \u0422\u0435\u043e\u0440\u0438\u044f \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439:
    \u0412 1930-\u0445 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0410.\u0410. \u0410\u043d\u0434\u0440\u043e\u043d\u043e\u0432\u044b\u043c \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438, \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0449\u0438\u043c\u0438
    \u0432 \u0440\u0430\u0434\u0438\u043e\u0444\u0438\u0437\u0438\u043a\u0435 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432\u0430\u0436\u043d\u044b \u0435\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u043f\u043e \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u043a\u0435 \u0440\u0435\u043b\u0430\u043a\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445
    \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439 \u2014 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432
    \u0441 \u0434\u0432\u0443\u043c\u044f \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c\u0438
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430\u043c\u0438 (\"\u0431\u044b\u0441\u0442\u0440\u044b\u043c\u0438\"
    \u0438 \"\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u043c\u0438\" \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438).
    \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u0433\u0440\u044b: \u041e\u043d \u0432\u043d\u0435\u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0433\u0440, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0432
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f-\u0443\u0431\u0435\u0433\u0430\u043d\u0438\u044f.
    \u041e\u0434\u043d\u0430 \u0438\u0437 \u0435\u0433\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442 \u2014 \"\u041b\u0438\u043d\u0435\u0439\u043d\u0430\u044f
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u0438\u0433\u0440\u0430 \u0443\u0431\u0435\u0433\u0430\u043d\u0438\u044f\". \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u0432 \u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0445
    \u043a\u043d\u0438\u0433 \u0434\u043b\u044f \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432,
    \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \"\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0434\u043b\u044f \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432\"
    \u0438 \"\u0417\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0441 \u0432\u044b\u0441\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439\", \u0447\u0442\u043e
    \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u043d\u0430\u043d\u0438\u0439.
    \u0414\u043b\u044f \u0431\u043e\u043b\u0435\u0435 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0433\u043e
    \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0432 \u0434\u0435\u0442\u0430\u043b\u0438
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043d\u0430\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u044e
    \u0435\u0433\u043e \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u043d\u0438\u0433\u0443 \u00ab\u0416\u0438\u0437\u043d\u0435\u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u041b. \u0421. \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430, \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435
    \u0438\u043c \u0441\u0430\u043c\u0438\u043c\u00bb, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432\u00bb, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0443\u044e
    \u0432 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u0441\u0442\u0432\u0435 \u0441 \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438."
  achievementsEn: 
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u041b\u044c\u0432\u0430 \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447\u0430
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430 \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043f\u043e\u0442\u0435\u0440\u044f\u0432 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
    \u0437\u0440\u0435\u043d\u0438\u0435, \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0435 \u0441\u043b\u043e\u043c\u0430\u043b\u0441\u044f, \u043d\u043e \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430.
    \u0412\u043e\u0442 \u0435\u0451 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0445\u0440\u043e\u043d\u0438\u043a\u0430.\n\n\U0001F4C5
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u041b\u0435\u0432 \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 3 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1908 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435. \u0415\u0433\u043e
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u043d\u0435 \u0431\u044b\u043b\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u2014 \u043e\u0442\u0435\u0446 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441\u0447\u0435\u0442\u043e\u0432\u043e\u0434\u043e\u043c,
    \u0430 \u043c\u0430\u0442\u044c, \u0422\u0430\u0442\u044c\u044f\u043d\u0430 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u043d\u0430,
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0440\u0442\u043d\u0438\u0445\u043e\u0439. \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c \u0441\u0442\u0430\u043b\u0430 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f
    \u0432 1922 \u0433\u043e\u0434\u0443. 13-\u043b\u0435\u0442\u043d\u0438\u0439 \u041b\u0451\u0432\u0430
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u043e\u0447\u0438\u043d\u0438\u0442\u044c
    \u043a\u0435\u0440\u043e\u0441\u0438\u043d\u043e\u0432\u044b\u0439 \u043f\u0440\u0438\u043c\u0443\u0441,
    \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0433\u0440\u0435\u0442\u044c\u0441\u044f. \u041f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u0432\u0437\u0440\u044b\u0432, \u0438 \u043c\u0430\u043b\u044c\u0447\u0438\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043e\u0436\u043e\u0433\u0438 \u043b\u0438\u0446\u0430,
    \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u0437\u0440\u0435\u043d\u0438\u0435.\n\n\U0001F9D1\u200d\U0001F3EB \u0423\u0447\u0451\u0431\u0430
    \u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u043c\u0438\u0440 \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0437\u0430\u043a\u0440\u044b\u043b\u0441\u044f.
    \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438, \u0437\u0430\u043d\u044f\u0442\u044b\u0435
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0435, \u043d\u0435 \u043c\u043e\u0433\u043b\u0438
    \u0432\u043e\u0434\u0438\u0442\u044c \u0435\u0433\u043e \u0432 \u043e\u0431\u044b\u0447\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443, \u043d\u043e \u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c
    \u043f\u0440\u0438\u0448\u043b\u0438 \u043e\u0434\u043d\u043e\u043a\u043b\u0430\u0441\u0441\u043d\u0438\u043a\u0438.
    \u041e\u043d\u0438 \u043f\u043e \u043e\u0447\u0435\u0440\u0435\u0434\u0438 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u043b\u0438
    \u0435\u0433\u043e \u0434\u043e \u0448\u043a\u043e\u043b\u044b \u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0438
    \u0441 \u0443\u0440\u043e\u043a\u0430\u043c\u0438. \u0413\u043b\u0430\u0432\u043d\u043e\u0439
    \u043e\u043f\u043e\u0440\u043e\u0439 \u0441\u0442\u0430\u043b\u0430 \u0435\u0433\u043e \u043c\u0430\u0442\u044c,
    \u0422\u0430\u0442\u044c\u044f\u043d\u0430 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u043d\u0430.
    \u041e\u043d\u0430 \u0432\u044b\u0443\u0447\u0438\u043b\u0430 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435
    \u044f\u0437\u044b\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u0447\u0438\u0442\u0430\u0442\u044c
    \u0441\u044b\u043d\u0443 \u0432\u0441\u043b\u0443\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u043a\u043d\u0438\u0433\u0438, \u0438 \u0441\u0442\u0430\u043b\u0430 \u0435\u0433\u043e
    \u043b\u0438\u0447\u043d\u044b\u043c \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0435\u043c,
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044f \u043f\u043e\u0434 \u0434\u0438\u043a\u0442\u043e\u0432\u043a\u0443
    \u0441\u0442\u0430\u0442\u044c\u0438 \u0438 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438.
    \u0412 1925 \u0433\u043e\u0434\u0443 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0415\u0433\u043e
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0430\u043c\u044f\u0442\u044c
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u0430 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u044b\u043a\u043b\u0430\u0434\u043a\u0438, \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044f \u043d\u0430 \u043b\u0435\u043a\u0446\u0438\u044f\u0445.
    \u0423\u0436\u0435 \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u043c \u043a\u0443\u0440\u0441\u0435
    \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430\u0443\u043a\u043e\u0439 \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0430
    \u041f.\u0421. \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u0430.
    \u0412 1929 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.\n\n\U0001F52C
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0415\u0433\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e: 1935 \u0433\u043e\u0434
    \u2014 \u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044b \u0435\u043c\u0443 \u0431\u044b\u043b\u0430
    \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u0430 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a, \u0438 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041c\u0413\u0423. 1939 \u0433\u043e\u0434 \u2014 \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u041d \u0421\u0421\u0421\u0420. 1958 \u0433\u043e\u0434 \u2014 \u0438\u0437\u0431\u0440\u0430\u043d
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c \u0410\u041d \u0421\u0421\u0421\u0420.
    \u0421 1939 \u0433\u043e\u0434\u0430 \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b
    \u043e\u0442\u0434\u0435\u043b\u043e\u043c \u0432 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0438\u043c\u0435\u043d\u0438 \u0412.\u0410.
    \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430 \u0410\u041d \u0421\u0421\u0421\u0420.
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1950-\u0445 \u0433\u043e\u0434\u043e\u0432 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u043e\u0432\u043e\u0440\u043e\u0442,
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e \u0441\u043c\u0435\u043d\u0438\u0432
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432.
    \u041f\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u043e\u0432\u0430\u043c, \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b
    \u044d\u0442\u043e \u00ab\u0438\u0437 \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439\u00bb, \u0436\u0435\u043b\u0430\u044f,
    \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u043b\u0438
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u043e\u043b\u044c\u0437\u0443.
    \u042d\u0442\u043e\u0442 \u0448\u0430\u0433, \u043f\u043e\u043b\u043d\u044b\u0439 \u0440\u0438\u0441\u043a\u0430,
    \u043f\u0440\u0438\u0432\u0435\u043b \u0435\u0433\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430
    \u2014 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0438\u043d\u0435\u0441 \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0441\u043b\u0430\u0432\u0443.\n\n\U0001F91D \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0438\u043c \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c
    \u0438 \u0431\u0435\u0441\u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043d\u044b\u043c
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c, \u0447\u0442\u043e \u0447\u0430\u0441\u0442\u043e
    \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b\u043e \u043a \u0441\u043b\u043e\u0436\u043d\u044b\u043c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438:
    \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0435 \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e:
    \u0415\u0449\u0435 \u0432 1939 \u0433\u043e\u0434\u0443, \u0432\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0430
    \u0441\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u0438\u0445 \u0440\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0439,
    \u043e\u043d \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0443\u0440\u044b
    \u0410.\u041d. \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430 \u0432
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a, \u043d\u0430\u0440\u0443\u0448\u0438\u0432
    \u043d\u0435\u0433\u043b\u0430\u0441\u043d\u044b\u0439 \u0437\u0430\u043f\u0440\u0435\u0442.
    \u0422\u0430\u043a\u0436\u0435 \u043e\u043d \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043b,
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u0445
    \u2014 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e
    \u043f\u0438\u0441\u0430\u043b \u043f\u0438\u0441\u044c\u043c\u0430 \u0432 \u043b\u0430\u0433\u0435\u0440\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0412.\u0410. \u0415\u0444\u0440\u0435\u043c\u043e\u0432\u0438\u0447\u0443.
    \u0423\u0447\u0438\u0442\u0435\u043b\u044c \u0438 \u0434\u0440\u0443\u0433: \u041a \u0441\u0432\u043e\u0438\u043c
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c \u043e\u043d \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f
    \u043d\u0435 \u043a\u0430\u043a \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a,
    \u0430 \u043a\u0430\u043a \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a \u0438
    \u0434\u0440\u0443\u0433. \u0415\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a \u0415.\u0424.
    \u041c\u0438\u0449\u0435\u043d\u043a\u043e \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b,
    \u043a\u0430\u043a \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u0437\u0430\u0431\u043e\u0442\u0438\u043b\u0441\u044f
    \u043e \u0435\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044f
    \u0435\u0433\u043e \u0432 \u043a\u043b\u0438\u043d\u0438\u043a\u0443 \u0438 \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u044f
    \u043b\u0435\u0447\u0435\u043d\u0438\u0435, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043a\u0430\u043a
    \u043e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u043a\u0430\u0442\u0430\u043b\u0438\u0441\u044c
    \u043d\u0430 \u043b\u044b\u0436\u0430\u0445 \u0438 \u043a\u043e\u043d\u044c\u043a\u0430\u0445,
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u043d\u0430\u0443\u0447\u0438\u043b\u0441\u044f \u043a\u0430\u0442\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430 \u043b\u044b\u0436\u0430\u0445 \u0438 \u043a\u043e\u043d\u044c\u043a\u0430\u0445
    \u0443\u0436\u0435 \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u043b\u0435\u043f\u044b\u043c.
    \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0432 \u0431\u0435\u0434\u0435:
    \u041e\u0434\u043d\u043e \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445
    \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439 \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430
    \u2014 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0441 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u0412.\u0410. \u0420\u043e\u0445\u043b\u0438\u043d\u044b\u043c. \u0422\u043e\u0442 \u043f\u043e\u043f\u0430\u043b
    \u0432 \u043f\u043b\u0435\u043d, \u0430 \u043f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b
    \u2014 \u0432 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0439 \u043b\u0430\u0433\u0435\u0440\u044c.
    \u0418\u043c\u0435\u043d\u043d\u043e \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u0441\u0432\u043e\u0438\u043c\u0438 \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u043c\u0438
    \u0445\u043b\u043e\u043f\u043e\u0442\u0430\u043c\u0438 \u0434\u043e\u0431\u0438\u043b\u0441\u044f
    \u0435\u0433\u043e \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435.
    \u00ab\u0422\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435\u00bb:
    \u042d\u0442\u0443 \u0444\u0440\u0430\u0437\u0443 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441, \u043a\u043e\u0433\u0434\u0430 \u043a\u043e\u043b\u043b\u0435\u0433\u0430
    \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c. \u0414\u043b\u044f \u0441\u0430\u043c\u043e\u0433\u043e
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430 \u044d\u0442\u043e \u0431\u044b\u043b
    \u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u0436\u0438\u0437\u043d\u0438:
    \u0434\u0435\u043b\u0430\u0442\u044c \u0442\u043e, \u0447\u0442\u043e \u0434\u0440\u0443\u0433\u0438\u0435
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c.\n\n\u2764\ufe0f
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u043e: \u041f\u0435\u0440\u0432\u044b\u0439 \u0431\u0440\u0430\u043a
    (1941-1952): \u0415\u0433\u043e \u0436\u0435\u043d\u043e\u0439 \u0441\u0442\u0430\u043b\u0430
    \u0431\u0438\u043e\u043b\u043e\u0433 \u0422\u0430\u0438\u0441\u0438\u044f \u0421\u0430\u043c\u0443\u0438\u043b\u043e\u0432\u043d\u0430
    \u0418\u0432\u0430\u043d\u043e\u0432\u0430. \u041f\u043e \u0438\u0440\u043e\u043d\u0438\u0438
    \u0441\u0443\u0434\u044c\u0431\u044b, \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d,
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u0438\u0441\u0430\u0432\u0448\u0438\u0439
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0439,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0441\u043a\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0434\u043b\u044f \u0436\u0435\u043d\u044b \u043f\u043e
    \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0438 \u0441\u0430\u0440\u0430\u043d\u0447\u0438.
    \u041f\u043e\u0441\u043b\u0435 \u0435\u0451 \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0439
    \u0437\u0430\u0449\u0438\u0442\u044b \u043e\u043d \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0437\u0432\u0435\u0441\u0442\u0438\u0441\u044c
    \u00ab\u0441 \u0447\u0438\u0441\u0442\u043e\u0439 \u0441\u043e\u0432\u0435\u0441\u0442\u044c\u044e\u00bb.
    \u0412\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a (\u0441 1958): \u0412\u0442\u043e\u0440\u043e\u0439
    \u0440\u0430\u0437 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430
    \u0432\u0440\u0430\u0447\u0435 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0435
    \u0418\u0433\u043d\u0430\u0442\u044c\u0435\u0432\u043d\u0435. \u041f\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c,
    \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0441\u0430\u043c\u0430\u044f
    \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u0432\u044c, \u043e\u043d
    \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u043a \u043d\u0435\u0439
    \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d. \u0414\u0435\u0442\u0435\u0439 \u0432
    \u043e\u0431\u043e\u0438\u0445 \u0431\u0440\u0430\u043a\u0430\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e.
    \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440: \u0411\u043e\u0440\u044c\u0431\u0430 \u0441
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043d\u0435\u0434\u0443\u0433\u043e\u043c
    \u0437\u0430\u043a\u0430\u043b\u0438\u043b\u0430 \u0435\u0433\u043e \u0432\u043e\u043b\u044e.
    \u041e\u043d \u0441\u0442\u0430\u0440\u0430\u043b\u0441\u044f \u043d\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u043f\u0440\u0438\u0441\u043f\u043e\u0441\u043e\u0431\u043b\u0435\u043d\u0438\u044f\u043c\u0438
    \u0434\u043b\u044f \u0441\u043b\u0435\u043f\u044b\u0445, \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u0445\u043e\u0434\u0438\u0442\u044c \u043e\u0434\u0438\u043d, \u0447\u0430\u0441\u0442\u043e
    \u043f\u0430\u0434\u0430\u043b, \u043d\u043e \u043d\u0435 \u0441\u0434\u0430\u0432\u0430\u043b\u0441\u044f.
    \u041f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0437\u043d\u0430\u0432\u0448\u0438\u0445
    \u0435\u0433\u043e \u043b\u044e\u0434\u0435\u0439, \u043d\u0438\u043a\u0442\u043e \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0434\u0443\u043c\u0430\u043b \u043e \u043d\u0435\u043c \u043a\u0430\u043a
    \u043e \u0441\u043b\u0435\u043f\u043e\u043c \u0438 \u0443\u0449\u0435\u0440\u0431\u043d\u043e\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0435.\n\n\U0001F54A\ufe0f \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u0412 \u043a\u043e\u043d\u0446\u0435
    \u0436\u0438\u0437\u043d\u0438 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u043c\u0435\u043c\u0443\u0430\u0440\u044b
    \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c \u00ab\u0416\u0438\u0437\u043d\u0435\u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u041b. \u0421. \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u0438\u043c \u0441\u0430\u043c\u0438\u043c\u00bb,
    \u0433\u0434\u0435 \u0434\u0430\u043b \u0440\u0435\u0437\u043a\u0438\u0435 \u0438 \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u044b\u0435
    \u043e\u0446\u0435\u043d\u043a\u0438 \u043c\u043d\u043e\u0433\u0438\u043c \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c
    \u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c, \u0447\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u043e
    \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u0443\u044e \u0440\u0435\u0430\u043a\u0446\u0438\u044e
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u043c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435.
    \u0411\u0443\u0434\u0443\u0447\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0434\u0435\u044f\u0442\u0435\u043b\u0435\u043c, \u043e\u043d \u043c\u043d\u043e\u0433\u043e
    \u0441\u0438\u043b \u043f\u043e\u0441\u0432\u044f\u0449\u0430\u043b \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0448\u043a\u043e\u043b\u0435, \u0431\u043e\u0440\u044f\u0441\u044c \u0437\u0430
    \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c
    \u0438 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u0432. \u041b\u0435\u0432 \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    3 \u043c\u0430\u044f 1988 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 79 \u043b\u0435\u0442. \u041e\u043d
    \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430 \u041d\u043e\u0432\u043e\u0434\u0435\u0432\u0438\u0447\u044c\u0435\u043c
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435 \u0441\u0442\u043e\u043b\u0438\u0446\u044b."
  personalLifeEn: 
  shortBioRu: "\u041b\u0435\u0432 \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    (1908\u20131988) \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430,
    \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0441\u0438\u043b\u044b
    \u0432\u043e\u043b\u0438, \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u043d\u0438\u044f
    \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0437\u0440\u0435\u043d\u0438\u044f.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043f\u043e\u043b\u043d\u0443\u044e
    \u043f\u043e\u0442\u0435\u0440\u044e \u0437\u0440\u0435\u043d\u0438\u044f \u0432 14 \u043b\u0435\u0442,
    \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c
    \u043b\u0438\u0434\u0435\u0440\u043e\u043c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445,
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0440\u0430\u0437\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\U0001F52C
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0442\u0440\u0435\u0445, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0431\u044b, \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0440\u0430\u0437\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0438 \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0434\u043e\u0431\u0438\u043b\u0441\u044f
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f. \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430: \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u0430\u044f
    \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u0432\u044c. \u041e\u043d
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043e\u0431\u0449\u0438\u0439 \u0437\u0430\u043a\u043e\u043d
    \u0434\u0432\u043e\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0441\u0432\u044f\u0437\u0430\u0432\u0448\u0438\u0439
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432 \u0438 \u0438\u0445 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0439.
    \u0422\u0430\u043a\u0436\u0435 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u0432 \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u044b\u0445
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f
    (\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043a\u0430\u043a \u0434\u0432\u043e\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430). \u0412 \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438 \u043e\u043d \u043e\u0442\u043a\u0440\u044b\u043b
    \u043d\u043e\u0432\u044b\u0435 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b
    \u2014 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043b\u0430\u0441\u0441\u044b \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430.
    \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f: \u0412 \u043d\u0430\u0447\u0430\u043b\u0435
    1950-\u0445 \u0433\u043e\u0434\u043e\u0432 \u043e\u043d \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e
    \u0441\u043c\u0435\u043d\u0438\u043b \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432. \u0415\u0435 \u0441\u0435\u0440\u0434\u0446\u0435
    \u2014 \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0438 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439:
    \u0412 1930-\u0445 \u0433\u043e\u0434\u0430\u0445, \u043f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c
    \u0444\u0438\u0437\u0438\u043a\u0430 \u0410.\u0410. \u0410\u043d\u0434\u0440\u043e\u043d\u043e\u0432\u0430,
    \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u0435\u043e\u0440\u0438\u0438 \u00ab\u0433\u0440\u0443\u0431\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u00bb
    \u0438 \u0432\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u043a\u0443
    \u0440\u0435\u043b\u0430\u043a\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439.\n\n\U0001F4D6
    \u0416\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u0443\u0442\u044c \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f:
    \u0420\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u041c\u043e\u0441\u043a\u0432\u0435 3
    \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1908 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0441\u0447\u0435\u0442\u043e\u0432\u043e\u0434\u0430 \u0438 \u043f\u043e\u0440\u0442\u043d\u0438\u0445\u0438.
    \u0412 13 \u043b\u0435\u0442 \u0441 \u043d\u0438\u043c \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u043d\u0435\u0441\u0447\u0430\u0441\u0442\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439:
    \u043f\u0440\u0438 \u043f\u043e\u043f\u044b\u0442\u043a\u0435 \u043f\u043e\u0447\u0438\u043d\u0438\u0442\u044c
    \u043f\u0440\u0438\u043c\u0443\u0441 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u0432\u0437\u0440\u044b\u0432. \u041e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043e\u0436\u043e\u0433\u0438 \u043b\u0438\u0446\u0430
    \u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u0437\u0440\u0435\u043d\u0438\u0435. \u041f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0445\u0443\u0434\u0448\u0438\u043b\u0430
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e, \u043f\u0440\u0438\u0432\u0435\u0434\u044f
    \u043a \u043f\u043e\u043b\u043d\u043e\u0439 \u0441\u043b\u0435\u043f\u043e\u0442\u0435.
    \u041c\u0430\u0442\u044c \u2014 \u0435\u0433\u043e \u00ab\u0433\u043b\u0430\u0437\u0430\u00bb:
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c, \u0422\u0430\u0442\u044c\u044f\u043d\u0430
    \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u043d\u0430, \u0441\u0442\u0430\u043b\u0430 \u0435\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u043e\u043f\u043e\u0440\u043e\u0439. \u041d\u0435
    \u0438\u043c\u0435\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u043e\u043d\u0430 \u0432\u044b\u0443\u0447\u0438\u043b\u0430
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \u044f\u0437\u044b\u043a\u0438,
    \u0447\u0442\u043e\u0431\u044b \u0447\u0438\u0442\u0430\u0442\u044c \u0441\u044b\u043d\u0443
    \u0432\u0441\u043b\u0443\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0441\u0442\u0430\u0442\u044c\u0438
    \u0438 \u043a\u043d\u0438\u0433\u0438, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b\u0430
    \u0440\u043e\u043b\u044c \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0433\u043e \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044f
    \u0438 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043e\u0440\u0430. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0435\u0439 \u043e\u043d \u0441\u043c\u043e\u0433 \u043e\u043a\u043e\u043d\u0447\u0438\u0442\u044c
    \u0448\u043a\u043e\u043b\u0443 \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u0442\u044c
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0438 \u0431\u043b\u0438\u0441\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u0442\u0430\u0440\u0442:
    \u0412 1925 \u0433\u043e\u0434\u0443 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043d\u0430 \u0444\u0438\u0437\u043c\u0430\u0442
    \u041c\u0413\u0423. \u0411\u0443\u0434\u0443\u0447\u0438 \u0441\u043b\u0435\u043f\u044b\u043c,
    \u043e\u043d \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0430\u043c\u044f\u0442\u044c\u044e, \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044f
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0432\u044b\u043a\u043b\u0430\u0434\u043a\u0438
    \u043d\u0430 \u0441\u043b\u0443\u0445. \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043d\u0430
    \u043b\u0435\u043a\u0446\u0438\u0438 \u043e\u043d, \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u0443\u044f\u0441\u044c
    \u043f\u043e \u0433\u043e\u043b\u043e\u0441\u0443, \u0443\u043a\u0430\u0437\u0430\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0443 \u043d\u0430 \u043e\u0448\u0438\u0431\u043a\u0443
    \u0432 \u0447\u0435\u0440\u0442\u0435\u0436\u0435 \u043d\u0430 \u0434\u043e\u0441\u043a\u0435.
    \u0423\u0436\u0435 \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u043c \u043a\u0443\u0440\u0441\u0435
    \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u041f.\u0421. \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u0430.
    \u0421\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u0437\u043b\u0435\u0442:
    \u0412 1935 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    27 \u043b\u0435\u0442, \u0435\u043c\u0443 \u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044b
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0430 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a, \u0438 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c.
    \u0412 1939 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c,
    \u0430 \u0432 1958 \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c \u0410\u041d \u0421\u0421\u0421\u0420. \u0421\u043c\u0435\u043b\u0430\u044f
    \u0441\u043c\u0435\u043d\u0430 \u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438: \u041a
    1950-\u043c \u0433\u043e\u0434\u0430\u043c \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c
    \u043b\u0438\u0434\u0435\u0440\u043e\u043c \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438,
    \u043d\u043e, \u043f\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u043e\u0432\u0430\u043c, \u00ab\u0438\u0437 \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439\u00bb \u0440\u0435\u0448\u0438\u043b
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u044c\u0441\u044f \u043d\u0430
    \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438. \u042d\u0442\u043e\u0442 \u0441\u043c\u0435\u043b\u044b\u0439
    \u0448\u0430\u0433 \u043f\u0440\u0438\u0432\u0435\u043b \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430. \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440:
    \u0415\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430
    \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u043e\u0439. \u041f\u0435\u0440\u0432\u044b\u0439
    \u0440\u0430\u0437 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432 1941 \u0433\u043e\u0434\u0443
    \u043d\u0430 \u0431\u0438\u043e\u043b\u043e\u0433\u0435 \u0422\u0430\u0438\u0441\u0438\u0438
    \u0418\u0432\u0430\u043d\u043e\u0432\u043e\u0439, \u043d\u043e \u0431\u0440\u0430\u043a
    \u0440\u0430\u0441\u043f\u0430\u043b\u0441\u044f. \u0412\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432 1958 \u0433\u043e\u0434\u0443 \u043d\u0430
    \u0432\u0440\u0430\u0447\u0435 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0435
    \u0418\u0433\u043d\u0430\u0442\u044c\u0435\u0432\u043d\u0435. \u041e\u043d \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c
    \u0438 \u0431\u0435\u0441\u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043d\u044b\u043c
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c, \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435
    \u0432 \u00ab\u0434\u0435\u043b\u0435 \u041b\u0443\u0437\u0438\u043d\u0430\u00bb \u0438
    \u0432 \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044f\u0445 \u043e \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438, \u0437\u0430 \u0447\u0442\u043e
    \u043d\u0430\u0436\u0438\u043b \u043c\u043d\u043e\u0433\u043e \u043d\u0435\u0434\u043e\u0431\u0440\u043e\u0436\u0435\u043b\u0430\u0442\u0435\u043b\u0435\u0439.
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b: \u0412
    \u043a\u043e\u043d\u0446\u0435 \u0436\u0438\u0437\u043d\u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u043c\u0435\u043c\u0443\u0430\u0440\u044b,
    \u0433\u0434\u0435 \u0434\u0430\u043b \u043e\u0446\u0435\u043d\u043a\u0438 \u043c\u043d\u043e\u0433\u0438\u043c
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c.
    \u0423\u043c\u0435\u0440 3 \u043c\u0430\u044f 1988 \u0433\u043e\u0434\u0430, \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043d\u0430 \u041d\u043e\u0432\u043e\u0434\u0435\u0432\u0438\u0447\u044c\u0435\u043c \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435.\n\n\U0001F3C5
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    - \u0421\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u0430\u044f \u043f\u0440\u0435\u043c\u0438\u044f
    (1941) \u2014 \u0437\u0430 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u00ab\u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0435 \u0433\u0440\u0443\u043f\u043f\u044b\u00bb.
    - \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u0430\u044f \u043f\u0440\u0435\u043c\u0438\u044f
    (1962) \u2014 \u0437\u0430 \u0446\u0438\u043a\u043b \u0440\u0430\u0431\u043e\u0442 \u043f\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f.
    - \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f \u0421\u0421\u0421\u0420 (1975) \u2014 \u0437\u0430
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u00ab\u041e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0435
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u00bb. - \u0413\u0435\u0440\u043e\u0439
    \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430 (1969). - \u041c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043e\u0440\u0434\u0435\u043d\u043e\u0432, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u044f\u0442\u044c
    \u043e\u0440\u0434\u0435\u043d\u043e\u0432 \u041b\u0435\u043d\u0438\u043d\u0430. - \u0411\u044b\u043b
    \u0432\u0438\u0446\u0435-\u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u044e\u0437\u0430 \u0438 \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0438 \u0412\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a.\n\n\U0001F48E
    \u0418\u0442\u043e\u0433 \u041b\u0435\u0432 \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u2014 \u0444\u0438\u0433\u0443\u0440\u0430
    \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u0440\u043d\u043e\u0433\u043e \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u043f\u043e\u0431\u0435\u0434\u0430
    \u0434\u0443\u0445\u0430 \u043d\u0430\u0434 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c\u0438,
    \u0430 \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u043e\u0442 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438
    \u0434\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u0447
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u0435\u0442\u0430\u043c\u0438
    \u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430\u043c\u0438. \u041e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b, \u043d\u043e
    \u0438 \u043c\u043e\u0449\u043d\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443,
    \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0432 \u0442\u0430\u043a\u0438\u0445 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432,
    \u043a\u0430\u043a \u0414.\u0412. \u0410\u043d\u043e\u0441\u043e\u0432, \u0412.\u0413. \u0411\u043e\u043b\u0442\u044f\u043d\u0441\u043a\u0438\u0439,
    \u0420.\u0412. \u0413\u0430\u043c\u043a\u0440\u0435\u043b\u0438\u0434\u0437\u0435 \u0438
    \u0434\u0440\u0443\u0433\u0438\u0435."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041b\u044c\u0432\u0430 \u0421\u0435\u043c\u0451\u043d\u043e\u0432\u0438\u0447\u0430
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430 \u043f\u043e\u043b\u043d\u0430
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0432\u043e\u043b\u044e, \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e \u0438 \u043d\u0435\u0437\u0430\u0443\u0440\u044f\u0434\u043d\u044b\u0439
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440. \u0412\u043e\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0434\u0440\u0443\u0437\u0435\u0439
    \u0438 \u0441\u0430\u043c\u043e\u043e\u0442\u0432\u0435\u0440\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043c\u0430\u0442\u0435\u0440\u0438 \u041f\u043e\u0441\u043b\u0435 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438
    \u0441 \u043f\u0440\u0438\u043c\u0443\u0441\u043e\u043c, \u043a\u043e\u0433\u0434\u0430
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u043e\u0441\u043b\u0435\u043f, \u0435\u0433\u043e
    \u043e\u0434\u043d\u043e\u043a\u043b\u0430\u0441\u0441\u043d\u0438\u043a\u0438 \u043d\u0435
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u0442\u043e\u0432\u0430\u0440\u0438\u0449\u0430
    \u0432 \u0431\u0435\u0434\u0435. \u041e\u043d\u0438 \u043f\u0440\u0438\u0448\u043b\u0438
    \u043a \u043d\u0435\u043c\u0443 \u0434\u043e\u043c\u043e\u0439 \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438
    \u0441\u0432\u043e\u044e \u043f\u043e\u043c\u043e\u0449\u044c: \u043f\u043e \u043e\u0447\u0435\u0440\u0435\u0434\u0438
    \u0432\u043e\u0434\u0438\u0442\u044c \u0435\u0433\u043e \u0432 \u0448\u043a\u043e\u043b\u0443,
    \u043f\u043e\u043c\u043e\u0433\u0430\u0442\u044c \u043d\u0430 \u0443\u0440\u043e\u043a\u0430\u0445,
    \u043e\u0437\u0432\u0443\u0447\u0438\u0432\u0430\u044f, \u0447\u0442\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u043f\u0438\u0448\u0435\u0442 \u043d\u0430 \u0434\u043e\u0441\u043a\u0435. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u044d\u0442\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435 \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u043c\u0443
    \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u0443 \u0441\u0430\u043c\u043e\u0433\u043e \u041b\u044c\u0432\u0430,
    \u043e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0443\u0447\u0435\u0431\u0443, \u043d\u043e \u0438 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b
    \u0448\u043a\u043e\u043b\u0443 \u0441 \u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u043c\u0435\u0434\u0430\u043b\u044c\u044e.
    \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u0436\u0435 \u043e\u043f\u043e\u0440\u043e\u0439
    \u0438 \"\u0433\u043b\u0430\u0437\u0430\u043c\u0438\" \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0435\u0433\u043e \u043c\u0430\u0442\u044c, \u0422\u0430\u0442\u044c\u044f\u043d\u0430
    \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u043d\u0430. \u041d\u0435 \u0438\u043c\u0435\u044f
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043e\u043d\u0430 \u0432\u044b\u0443\u0447\u0438\u043b\u0430 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435
    \u044f\u0437\u044b\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u0447\u0438\u0442\u0430\u0442\u044c
    \u0441\u044b\u043d\u0443 \u0432\u0441\u043b\u0443\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0441\u0442\u0430\u0442\u044c\u0438. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e
    \u043b\u0438\u0447\u043d\u044b\u043c \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0435\u043c,
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0430 \u043f\u043e\u0434 \u0434\u0438\u043a\u0442\u043e\u0432\u043a\u0443
    \u0442\u0440\u0443\u0434\u044b \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0443\u0440\u0443.
    \u0427\u0442\u043e\u0431\u044b \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0442\u044c \u0441\u043b\u0435\u043f\u043e\u043c\u0443
    \u0441\u044b\u043d\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u043d\u0430\u043a\u0438, \u043e\u043d\u0438 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b\u0438
    \u0441\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0437\u043d\u0430\u043a \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u044f
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 (`\u2229`) \u0443 \u043d\u0438\u0445 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \"\u0445\u0432\u043e\u0441\u0442\u0438\u043a \u0432\u0432\u0435\u0440\u0445\", \u0438 \u043a\u043e\u0433\u0434\u0430
    \u0422\u0430\u0442\u044c\u044f\u043d\u0430 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u043d\u0430
    \u0447\u0438\u0442\u0430\u043b\u0430 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435,
    \u043e\u043d\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430: \"\u0410 \u0445\u0432\u043e\u0441\u0442\u0438\u043a
    \u0432\u0432\u0435\u0440\u0445 B\". \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u0448\u0440\u0438\u0444\u0442\u043e\u043c
    \u0411\u0440\u0430\u0439\u043b\u044f.\n\n\U0001F9E0 \u0424\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \"\u043d\u0435\u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0435\"
    \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u043e \u041f\u043e\u0442\u0435\u0440\u044f \u0437\u0440\u0435\u043d\u0438\u044f
    \u043d\u0435 \u0441\u043b\u043e\u043c\u0438\u043b\u0430 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430,
    \u0430 \u0437\u0430\u043a\u0430\u043b\u0438\u043b\u0430 \u0435\u0433\u043e \u0432\u043e\u043b\u044e.
    \u041f\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430 \u0418.\u0420. \u0428\u0430\u0444\u0430\u0440\u0435\u0432\u0438\u0447\u0430,
    \u043e\u043d \"\u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0435\u0451 \u043f\u0440\u0438\u0437\u043d\u0430\u0442\u044c. \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u043d\u0438\u043a\u0430\u043a\u043e\u0439
    \u0442\u0435\u0445\u043d\u0438\u043a\u043e\u0439, \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u043e\u0439
    \u0434\u043b\u044f \u0441\u043b\u0435\u043f\u044b\u0445. \u0412\u0441\u0435\u0433\u0434\u0430
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0445\u043e\u0434\u0438\u0442\u044c \u0441\u0430\u043c,
    \u0431\u0435\u0437 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0434\u0440\u0443\u0433\u0438\u0445. \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u0443 \u043d\u0435\u0433\u043e \u043d\u0430 \u043b\u0438\u0446\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u044b\u043b\u0438 \u0441\u0441\u0430\u0434\u0438\u043d\u044b \u0438 \u0446\u0430\u0440\u0430\u043f\u0438\u043d\u044b.
    \u041e\u043d \u043d\u0430\u0443\u0447\u0438\u043b\u0441\u044f \u043a\u0430\u0442\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430 \u043a\u043e\u043d\u044c\u043a\u0430\u0445, \u043d\u0430 \u043b\u044b\u0436\u0430\u0445,
    \u043f\u043b\u0430\u0432\u0430\u043b \u043d\u0430 \u0431\u0430\u0439\u0434\u0430\u0440\u043a\u0435\".
    \u0412 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u043e\u043d
    \u043f\u043e\u0440\u0430\u0436\u0430\u043b \u0432\u0441\u0435\u0445 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c\u044e
    \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u0432 \u043f\u0430\u043c\u044f\u0442\u0438
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u044b\u043a\u043b\u0430\u0434\u043a\u0438, \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044f \u043d\u0430 \u043b\u0435\u043a\u0446\u0438\u044f\u0445.
    \u041e\u043d \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043d\u0430 \u043b\u0435\u043a\u0446\u0438\u0438
    \u043e\u043d, \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u0443\u044f\u0441\u044c \u043f\u043e
    \u0433\u043e\u043b\u043e\u0441\u0443, \u0443\u043a\u0430\u0437\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0443
    \u043d\u0430 \u043e\u0448\u0438\u0431\u043a\u0443 \u0432 \u0447\u0435\u0440\u0442\u0435\u0436\u0435
    \u043d\u0430 \u0434\u043e\u0441\u043a\u0435.\n\n\U0001F9D7 \u0421\u043c\u0435\u043b\u044b\u0439
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442 \u0432 \u043d\u0430\u0443\u043a\u0435 \u0411\u0443\u0434\u0443\u0447\u0438
    \u0443\u0436\u0435 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c
    \u043b\u0438\u0434\u0435\u0440\u043e\u043c \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438,
    \u0432 1950-\u0445 \u0433\u043e\u0434\u0430\u0445 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u043c\u0435\u043d\u0443 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432,
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0432\u0448\u0438\u0441\u044c \u043d\u0430
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u042d\u0442\u043e\u0442 \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0448\u0430\u0433 \u043e\u043d \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b \"\u0438\u0437
    \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439\":
    \u0435\u043c\u0443 \u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c, \u0447\u0442\u043e\u0431\u044b
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u043b\u0438
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u043e\u043b\u044c\u0437\u0443.
    \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043e\u043d, \u0443\u0436\u0435 \u0431\u0443\u0434\u0443\u0447\u0438
    \u043c\u044d\u0442\u0440\u043e\u043c, \u043f\u043e \u0441\u0443\u0442\u0438, \u0441\u0442\u0430\u043b
    \"\u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0449\u0438\u043c\", \u0447\u0430\u0441\u0430\u043c\u0438
    \u043e\u0431\u0449\u0430\u044f\u0441\u044c \u0441 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430\u043c\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0430\u043c\u0438, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u043d\u044f\u0442\u044c \u0438\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438 \u0438\u0445 \u043d\u0430
    \u044f\u0437\u044b\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c
    \u0441\u0442\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430
    \u2014 \u043e\u0441\u043d\u043e\u0432\u0430 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f.\n\n\U0001F981 \u041c\u0443\u0436\u0435\u0441\u0442\u0432\u043e
    \u0438 \u0431\u0435\u0441\u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043d\u043e\u0441\u0442\u044c
    \u0432 \u043f\u043e\u0441\u0442\u0443\u043f\u043a\u0430\u0445 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u043d\u0435 \u0431\u043e\u044f\u043b\u0441\u044f \u0438\u0434\u0442\u0438 \u043f\u0440\u043e\u0442\u0438\u0432
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u0435\u0441\u043b\u0438 \u0441\u0447\u0438\u0442\u0430\u043b
    \u044d\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u043c. \u0412
    \u0437\u0430\u0449\u0438\u0442\u0443 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430:
    \u0412 1939 \u0433\u043e\u0434\u0443, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u044b\u0431\u043e\u0440\u043e\u0432
    \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a, \u043e\u043d
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u0441 \u0440\u0435\u0447\u044c\u044e \u0432 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443
    \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0443\u0440\u044b \u0410.\u041d. \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430,
    \u043d\u0430\u0440\u0443\u0448\u0438\u0432 \u043d\u0435\u0433\u043b\u0430\u0441\u043d\u044b\u0439
    \u0437\u0430\u043f\u0440\u0435\u0442, \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u043e\u0447\u0435\u043d\u044c
    \u0441\u043c\u0435\u043b\u044b\u043c \u0448\u0430\u0433\u043e\u043c. \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430
    \u043e\u043f\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043b\u043b\u0435\u0433: \u041e\u043d
    \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u043f\u0438\u0441\u0430\u043b \u043f\u0438\u0441\u044c\u043c\u0430
    \u0432 \u043b\u0430\u0433\u0435\u0440\u044f \u0441\u0432\u043e\u0438\u043c \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0412.\u0410. \u0415\u0444\u0440\u0435\u043c\u043e\u0432\u0438\u0447\u0443, \u0447\u0442\u043e
    \u0432 \u0442\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0431\u044b\u043b\u043e
    \u0440\u0430\u0432\u043d\u043e\u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0432\u0438\u0433\u0443.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438\u0437 \u043b\u0430\u0433\u0435\u0440\u044f \u0434\u0440\u0443\u0433\u043e\u0433\u043e
    \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0430 \u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0435\u043c\u0443 \u0436\u0438\u043b\u044c\u0435 \u043d\u0430 \u0441\u0435\u043c\u044c
    \u043b\u0435\u0442. \u041e\u0434\u0438\u043d \u0438\u0437 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0441\u043f\u0430\u0441 \u0435\u043c\u0443 \u0436\u0438\u0437\u043d\u044c \u0432 \u0433\u043e\u043b\u043e\u0434\u043d\u044b\u0435
    \u0432\u043e\u0435\u043d\u043d\u044b\u0435 \u0433\u043e\u0434\u044b, \u043f\u0440\u0438\u043d\u0435\u0441\u044f
    \u0441\u0432\u043e\u0439 \u043f\u0430\u0435\u043a, \u043a\u043e\u0433\u0434\u0430 \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d
    \u0443\u043c\u0438\u0440\u0430\u043b \u043e\u0442 \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u0438.
    \"\u0422\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435\":
    \u042d\u0442\u0430 \u0444\u0440\u0430\u0437\u0430 \u0441\u0442\u0430\u043b\u0430 \u0435\u0433\u043e
    \u0432\u0438\u0437\u0438\u0442\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u043e\u0439.
    \u041a\u043e\u0433\u0434\u0430 \u043a\u0442\u043e-\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b
    \u0435\u043c\u0443, \u0447\u0442\u043e \u0435\u0433\u043e \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c,
    \u043e\u043d \u043e\u0442\u0432\u0435\u0447\u0430\u043b: \"\u0422\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435!\". \u042d\u0442\u043e\u0442
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b
    \u0438 \u043a \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0435\u0431\u0435, \u0434\u0435\u043b\u0430\u044f
    \u0442\u043e, \u0447\u0442\u043e \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438
    \u043d\u0435\u043c\u044b\u0441\u043b\u0438\u043c\u044b\u043c \u0434\u043b\u044f \u0441\u043b\u0435\u043f\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.\n\n\U0001F4DC \u041e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u044b\u0435
    \u043c\u0435\u043c\u0443\u0430\u0440\u044b \u0412 \u043a\u043e\u043d\u0446\u0435 \u0436\u0438\u0437\u043d\u0438
    \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043c\u0435\u043c\u0443\u0430\u0440\u044b \u00ab\u0416\u0438\u0437\u043d\u0435\u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u041b. \u0421. \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u0430, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u0438\u043c \u0441\u0430\u043c\u0438\u043c\u00bb,
    \u0433\u0434\u0435 \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e
    \u0432\u044b\u0441\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e \u043c\u043d\u043e\u0433\u0438\u0445
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u0445 \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u0445.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u043d \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u043e\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c \"\u0434\u0435\u043b\u0435
    \u041b\u0443\u0437\u0438\u043d\u0430\", \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0431\u044b\u043b \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d \u0441\u0432\u043e\u0438\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u041f.\u0421. \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u044b\u043c.
    \u0412 \u043d\u0438\u0445 \u0442\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0435\u0433\u043e \u043d\u0435 \u043f\u0443\u0441\u043a\u0430\u043b\u0438
    \u0432 \u0421\u0428\u0410, \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044f \u043f\u043e\u0435\u0445\u0430\u0442\u044c
    \u043d\u0435 \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e, \u0430 \u0441 \u0434\u0440\u0443\u0433\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439, \u043d\u0430 \u0447\u0442\u043e \u043e\u043d
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u043e\u0442\u043a\u0430\u0437\u043e\u043c, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e
    \u0435\u043c\u0443 25 \u043b\u0435\u0442 \u043d\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u043b\u0438
    \u0432\u044b\u0435\u0437\u0436\u0430\u0442\u044c \u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0443.
    \u042d\u0442\u0438 \u043c\u0435\u043c\u0443\u0430\u0440\u044b \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c, \u043d\u043e \u0438 \u0431\u044b\u0442, \u0438\u043d\u0442\u0440\u0438\u0433\u0438
    \u0438 \u0441\u0442\u0440\u0430\u0445\u0438 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438."
