    \u043f\u0435\u0447\u0430\u0442\u043d\u043e\u043c\u0443 \u0442\u0435\u043a\u0441\u0442\u0443.\n\n\U0001F3AD
    \u0421\u043b\u043e\u0436\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440
