    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u0438, \u043d\u043e \u0438 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435
    \u0437\u0430\u0431\u043e\u0442\u044b: \u043e\u043d \u0434\u0435\u043b\u0438\u0442\u0441\u044f
    \u043c\u044b\u0441\u043b\u044f\u043c\u0438 \u043e \u0434\u0435\u043d\u044c\u0433\u0430\u0445,
    \u043e \u043a\u0430\u0440\u044c\u0435\u0440\u043d\u044b\u0445 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0430\u0445,
    \u043e \u0436\u0438\u0442\u0435\u0439\u0441\u043a\u0438\u0445 \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u044f\u0445
    \u0438 \u0434\u0430\u0436\u0435 \u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438
    \u0441\u0432\u043e\u0438\u0445 \u043a\u043e\u043b\u043b\u0435\u0433. \u042d\u0442\u043e
    \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u043c \u0433\u0435\u043d\u0438\u0435\u043c,
    \u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043a\u0430\u043a \u0438 \u0432\u0441\u0435, \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043b
    \u0438\u0437-\u0437\u0430 \u0431\u044b\u0442\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c.\n\n\U0001F4D0
    \u042f\u0440\u043a\u0438\u0439 \u043e\u0431\u0440\u0430\u0437: \u0440\u0430\u0437\u043d\u0438\u0446\u0430
    \u043c\u0435\u0436\u0434\u0443 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u043c\u0438
    \u0420\u0438\u043c\u0430\u043d\u0430 \u0438 \u041b\u0435\u0431\u0435\u0433\u0430 \u041e\u043d
    \u0441\u0430\u043c \u043e\u0447\u0435\u043d\u044c \u043e\u0431\u0440\u0430\u0437\u043d\u043e
    \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b \u0440\u0430\u0437\u043d\u0438\u0446\u0443
    \u043c\u0435\u0436\u0434\u0443 \u0441\u0432\u043e\u0438\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043c
    \u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0420\u0438\u043c\u0430\u043d\u0430,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0431\u044b\u0442\u043e\u0432\u0443\u044e
    \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u044e: \u00ab\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c\u0442\u0435,
    \u0447\u0442\u043e \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0437\u0430\u043f\u043b\u0430\u0442\u0438\u0442\u044c
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u0443\u044e \u0441\u0443\u043c\u043c\u0443.
    \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u0420\u0438\u043c\u0430\u043d\u0430 \u2014
    \u044d\u0442\u043e \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u043f\u0440\u043e\u0441\u0442\u043e
    \u0434\u043e\u0441\u0442\u0430\u0435\u0442\u0435 \u0438\u0437 \u043a\u0430\u0440\u043c\u0430\u043d\u0430
    \u043c\u043e\u043d\u0435\u0442\u044b \u0438 \u0431\u0430\u043d\u043a\u043d\u043e\u0442\u044b
    \u0432 \u0442\u043e\u043c \u043f\u043e\u0440\u044f\u0434\u043a\u0435, \u0432 \u043a\u0430\u043a\u043e\u043c
    \u043e\u043d\u0438 \u0442\u0430\u043c \u043b\u0435\u0436\u0430\u0442, \u0438 \u043e\u0442\u0434\u0430\u0435\u0442\u0435
    \u0438\u0445 \u043a\u0440\u0435\u0434\u0438\u0442\u043e\u0440\u0443, \u043f\u043e\u043a\u0430
    \u043d\u0435 \u043d\u0430\u0431\u0435\u0440\u0435\u0442\u0435 \u043d\u0443\u0436\u043d\u0443\u044e
    \u0441\u0443\u043c\u043c\u0443. \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u041b\u0435\u0431\u0435\u0433\u0430
    \u2014 \u044d\u0442\u043e \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0435 \u0432\u0441\u0435
    \u0434\u0435\u043d\u044c\u0433\u0438 \u043f\u043e \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u0443,
    \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u0443\u0435\u0442\u0435 \u043c\u043e\u043d\u0435\u0442\u043a\u0438
    \u0438 \u043a\u0443\u043f\u044e\u0440\u044b \u043e\u0434\u043d\u043e\u0433\u043e \u043d\u043e\u043c\u0438\u043d\u0430\u043b\u0430,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u043e\u0442\u0434\u0430\u0435\u0442\u0435 \u0438\u0445
    \u0432\u0441\u0435 \u0432\u043c\u0435\u0441\u0442\u0435\u00bb. \u042d\u0442\u0430 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u044f
    \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0441\u0443\u0442\u044c \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430: \u0432\u043c\u0435\u0441\u0442\u043e
    \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u00ab\u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c\u00bb
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b, \u0438\u0434\u044f \u043f\u043e \u043e\u0441\u0438
    X (\u043a\u0430\u043a \u0420\u0438\u043c\u0430\u043d), \u043e\u043d \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u0441\u043c\u043e\u0442\u0440\u0438\u0442 \u043d\u0430 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438 (\u043e\u0441\u044c Y), \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u0443\u0435\u0442
    \u0438\u0445 \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0441 \u00ab\u043c\u0435\u0440\u043e\u0439\u00bb
    \u044d\u0442\u0438\u0445 \u0433\u0440\u0443\u043f\u043f.\n\n\U0001F9D0 \u0421\u0434\u0435\u0440\u0436\u0430\u043d\u043d\u043e\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u043c
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043e\u0431\u0449\u0438\u0445
    \u0438 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0445 \u0442\u0435\u043e\u0440\u0438\u0439
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0441\u0430\u043c
    \u041b\u0435\u0431\u0435\u0433 \u043d\u0435 \u0431\u044b\u043b \u043f\u043e\u043a\u043b\u043e\u043d\u043d\u0438\u043a\u043e\u043c
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0439 \u0440\u0430\u0434\u0438 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0439.
    \u041e\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439
    \u0444\u0440\u0430\u0437\u043e\u0439: \u00ab\u0421\u0432\u0435\u0434\u0435\u043d\u043d\u0430\u044f
    \u043a \u043e\u0431\u0449\u0438\u043c \u0442\u0435\u043e\u0440\u0438\u044f\u043c, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u0431\u044b \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u043e\u0439 \u0431\u0435\u0437 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f\u00bb.
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0437\u0430 \u043e\u0431\u0449\u0438\u043c\u0438
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f\u043c\u0438 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0441\u0442\u043e\u044f\u0442\u044c \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0430\u044f
    \u0437\u0430\u0434\u0430\u0447\u0430 \u0438 \u0441\u043c\u044b\u0441\u043b.\n\n\U0001F48E
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0441\u043b\u0435\u0434
    \u0415\u0433\u043e \u0438\u043c\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0440\u043e\u0447\u043d\u043e \u0432\u043e\u0448\u043b\u043e \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a, \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u043c\u0435\u043c,
    \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u0443
    \u043c\u0435\u0436\u0434\u0443 \u043f\u043e\u0434\u0445\u043e\u0434\u0430\u043c\u0438. \u041d\u0430
    \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0435 \u00ab\u041f\u0440\u043e\u0442\u0438\u0440\u0430\u043d\u0438\u0435
    \u0434\u043e\u0441\u043a\u0438 \u043f\u043e \u041b\u0435\u0431\u0435\u0433\u0443 \u0438
    \u043f\u043e \u0420\u0438\u043c\u0430\u043d\u0443\u00bb \u0441\u043b\u0435\u0432\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c
    \u0448\u0438\u0440\u043e\u043a\u043e\u0439 \u0448\u0432\u0430\u0431\u0440\u043e\u0439 \u0441\u0442\u0438\u0440\u0430\u0435\u0442
    \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u044e \u0434\u043e\u0441\u043a\u0443 (\u043a\u0430\u043a
    \u041b\u0435\u0431\u0435\u0433 \u00ab\u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u00bb
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430\u043c\u0438
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439), \u0430 \u0441\u043f\u0440\u0430\u0432\u0430
    \u2014 \u0441\u0442\u0438\u0440\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0437\u043a\u0443\u044e
    \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u043b\u043e\u0441\u0443
    (\u043a\u0430\u043a \u0420\u0438\u043c\u0430\u043d \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f
    \u043f\u043e \u0443\u0437\u043a\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430\u043c
    \u043e\u0441\u0438 X)."
