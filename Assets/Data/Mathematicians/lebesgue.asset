  achievementsRu: "\u0412\u043a\u043b\u0430\u0434 \u0410\u043d\u0440\u0438 \u041b\u0435\u043e\u043d\u0430 \u041b\u0435\u0431\u0435\u0433\u0430
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u043f\u043e \u0441\u0432\u043e\u0435\u043c\u0443
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c
    \u0441 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c \u043d\u043e\u0432\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u043e\u0432\u044b\u0439
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b, \u0430 \u0446\u0435\u043b\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u043c\u0435\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437.\n\n\U0001F9E0
    \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u041b\u0435\u0431\u0435\u0433\u0430: \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0432 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u041a \u043a\u043e\u043d\u0446\u0443 XIX \u0432\u0435\u043a\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u0420\u0438\u043c\u0430\u043d\u0430 \u0441\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u043b\u0441\u044f
    \u0441 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c\u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f\u043c\u0438:
    \u043e\u043d \u043d\u0435 \u043c\u043e\u0433 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u0438, \u0438\u043c\u0435\u044e\u0449\u0438\u043c\u0438
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0440\u0430\u0437\u0440\u044b\u0432\u043e\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439 \u0414\u0438\u0440\u0438\u0445\u043b\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0432\u043d\u0430 1 \u043d\u0430
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u043b\u0430\u0445
    \u0438 0 \u043d\u0430 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445).
    \u041b\u0435\u0431\u0435\u0433 \u043f\u043e\u0434\u043e\u0448\u0435\u043b \u043a \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e \u0438\u043d\u0430\u0447\u0435.
    \u0418\u0434\u0435\u044f: \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e
    \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0442\u044c \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f (\u043e\u0441\u044c X)
    \u043d\u0430 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b,
    \u043a\u0430\u043a \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u043b \u0420\u0438\u043c\u0430\u043d,
    \u041b\u0435\u0431\u0435\u0433 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0442\u044c
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439
    (\u043e\u0441\u044c Y). \u041c\u0435\u0440\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430:
    \u0414\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \\( y_i \\), \u043e\u043d \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0442\u043e\u0447\u0435\u043a \\(
    E_i \\) \u043d\u0430 \u043e\u0441\u0438 X, \u0433\u0434\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u044f
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u043c\u0435\u0436\u0434\u0443 \\( y_{i-1} \\) \u0438 \\( y_i \\). \u0417\u0430\u0442\u0435\u043c
    \u043e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u043b \u043d\u0435 \u0434\u043b\u0438\u043d\u0443
    \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430, \u0430 \u00ab\u043c\u0435\u0440\u0443\u00bb
    \u044d\u0442\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \\(
    m(E_i) \\), \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u043e\u043d\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u043e
    \u0438\u0437 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430
    \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u0442\u043e\u0447\u0435\u043a.
    \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435, \u043c\u0435\u0440\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0440\u0430\u0432\u043d\u0430 \u043d\u0443\u043b\u044e, \u0430 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u2014 \u0435\u0434\u0438\u043d\u0438\u0446\u0435, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442:
    \u041f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u043c
    \u041b\u0435\u0431\u0435\u0433\u0430, \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043c\u043e\u0449\u043d\u044b\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c.
    \u041a\u043b\u0430\u0441\u0441 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0435\u043c\u044b\u0445
    \u043f\u043e \u041b\u0435\u0431\u0435\u0433\u0443 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0448\u0438\u0440\u043e\u0447\u0430\u0439\u0448\u0438\u043c
    \u0438 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445.\n\n\U0001F4D0
    \u0422\u0435\u043e\u0440\u0438\u044f \u043c\u0435\u0440\u044b \u041b\u0435\u0431\u0435\u0433\u0430:
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430 \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b
    \u041b\u0435\u0431\u0435\u0433\u0430 \u0431\u044b\u043b \u0431\u044b \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d
    \u0431\u0435\u0437 \u0435\u0433\u043e \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0435\u0440\u044b. \u041e\u043d \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u0434\u043b\u0438\u043d\u044b\u00bb \u0434\u043b\u044f
    \u043e\u0447\u0435\u043d\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u043e\u0431\u043e\u0431\u0449\u0438\u0432 \u0438\u0434\u0435\u0438 \u0441\u0432\u043e\u0438\u0445
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u2014 \u042d\u043c\u0438\u043b\u044f \u0411\u043e\u0440\u0435\u043b\u044f \u0438 \u041a\u0430\u043c\u0438\u043b\u044f
    \u0416\u043e\u0440\u0434\u0430\u043d\u0430. \u0410\u043a\u0441\u0438\u043e\u043c\u044b \u043c\u0435\u0440\u044b:
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 1902 \u0433\u043e\u0434\u0430
    (\u00ab\u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b, \u0434\u043b\u0438\u043d\u0430,
    \u043f\u043b\u043e\u0449\u0430\u0434\u044c\u00bb) \u041b\u0435\u0431\u0435\u0433 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u043c\u0435\u0440\u0443 \u043a\u0430\u043a \u0444\u0443\u043d\u043a\u0446\u0438\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u043e\u043b\u0436\u043d\u0430 \u043e\u0431\u043b\u0430\u0434\u0430\u0442\u044c
    \u0442\u0440\u0435\u043c\u044f \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c\u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438:
    \u0431\u044b\u0442\u044c \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u043e\u0439
    \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0435 (\u043a\u043e\u043d\u0433\u0440\u0443\u044d\u043d\u0442\u043d\u044b\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0438\u043c\u0435\u044e\u0442 \u0440\u0430\u0432\u043d\u0443\u044e
    \u043c\u0435\u0440\u0443), \u0431\u044b\u0442\u044c \u0441\u0447\u0451\u0442\u043d\u043e-\u0430\u0434\u0434\u0438\u0442\u0438\u0432\u043d\u043e\u0439
    (\u043c\u0435\u0440\u0430 \u0441\u0443\u043c\u043c\u044b \u0441\u0447\u0451\u0442\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u043d\u0435\u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0440\u0430\u0432\u043d\u0430 \u0441\u0443\u043c\u043c\u0435
    \u0438\u0445 \u043c\u0435\u0440) \u0438 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0443 (0, 1) \u043c\u0435\u0440\u0443,
    \u0440\u0430\u0432\u043d\u0443\u044e 1. \u0418\u0437\u043c\u0435\u0440\u0438\u043c\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438: \u041e\u043d \u0432\u0432\u0435\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0438\u0437\u043c\u0435\u0440\u0438\u043c\u043e\u0439
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u0435\u0434\u0435\u043b
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439) \u043d\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u043a\u043b\u0430\u0441\u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0439,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043a\u043b\u0430\u0441\u0441 \u0438\u0437\u043c\u0435\u0440\u0438\u043c\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0437\u0430\u043c\u043a\u043d\u0443\u0442 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0430.
    \u042d\u0442\u043e \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0441\u0442\u0430\u043b\u043e
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445
    \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u0442\u0435\u043e\u0440\u0435\u043c.\n\n\U0001F4DA
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u0438 \u0438\u0445
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u041b\u0435\u0431\u0435\u0433 \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438, \u043d\u043e
    \u0438 \u0432 \u0440\u044f\u0434\u0435 \u043a\u043d\u0438\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0442\u0430\u043b\u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438:
    \u00ab\u041b\u0435\u043a\u0446\u0438\u0438 \u043e\u0431 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0438 \u043e\u0442\u044b\u0441\u043a\u0430\u043d\u0438\u0438 \u043f\u0440\u0438\u043c\u0438\u0442\u0438\u0432\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439\u00bb (1904) \u2014 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430 \u0438 \u0435\u0435 \u0441\u0432\u044f\u0437\u0438
    \u0441 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c.
    \u00ab\u041b\u0435\u043a\u0446\u0438\u0438 \u043e \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u044f\u0434\u0430\u0445\u00bb (1906) \u2014 \u0440\u0430\u0431\u043e\u0442\u0430,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0441\u0432\u043e\u0439 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u043a \u0442\u0435\u043e\u0440\u0438\u0438
    \u0440\u044f\u0434\u043e\u0432 \u0424\u0443\u0440\u044c\u0435, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432
    \u0440\u0435\u0448\u0438\u0442\u044c \u0440\u044f\u0434 \u0441\u0442\u0430\u0440\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0432\u0430\u0436\u043d\u044b\u0435 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043f\u043e\u0447\u043b\u0435\u043d\u043d\u043e\u043c
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0440\u044f\u0434\u043e\u0432.\n\n\U0001F30D
    \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0418\u0434\u0435\u0438 \u041b\u0435\u0431\u0435\u0433\u0430
    \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e. \u041e\u043d\u0438 \u043f\u0440\u043e\u043d\u0438\u043a\u043b\u0438
    \u0432: \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e: \u041e\u043d \u0432\u043d\u0435\u0441
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e,
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u0432 \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u043e \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430.
    \u0422\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439:
    \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u041b\u0435\u0431\u0435\u0433\u0430 \u0438
    \u0442\u0435\u043e\u0440\u0438\u044f \u043c\u0435\u0440\u044b \u0441\u0442\u0430\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u0438\u0437\u0438\u043a\u0443 \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437: \u0415\u0433\u043e \u0438\u0434\u0435\u0438 \u0448\u0438\u0440\u043e\u043a\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0432 \u044d\u0442\u0438\u0445
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0445.\n\n\U0001F4A1 \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442: \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u0438
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043e\u0431\u0449\u0438\u0445 \u0442\u0435\u043e\u0440\u0438\u0439
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0441\u0430\u043c
    \u041b\u0435\u0431\u0435\u0433 \u0441 \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u044b\u043c
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u043c. \u041e\u043d \u043f\u0438\u0441\u0430\u043b:
    \u00ab\u0421\u0432\u0435\u0434\u0435\u043d\u043d\u0430\u044f \u043a \u043e\u0431\u0449\u0438\u043c
    \u0442\u0435\u043e\u0440\u0438\u044f\u043c, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u0431\u044b \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u043e\u0439 \u0431\u0435\u0437 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f.
    \u041e\u043d\u0430 \u0431\u044b\u0441\u0442\u0440\u043e \u0431\u044b \u0443\u043c\u0435\u0440\u043b\u0430\u00bb.
    \u0415\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 1922 \u0433\u043e\u0434\u0430,
    \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u043b\u0438 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u044b
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u043a\u0435, \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0431\u043e\u0440
    \u0442\u0435\u043e\u0440\u0435\u043c, \u0430 \u0446\u0435\u043b\u044b\u0439 \u043d\u043e\u0432\u044b\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u0430\u043d\u0430\u043b\u0438\u0437\u0443 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u043e\u0431\u043b\u0438\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    XX \u0432\u0435\u043a\u0430."
  achievementsEn: 
  personalLifeRu: "\U0001F476 \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b, \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0410\u043d\u0440\u0438 \u041b\u0435\u043e\u043d
    \u041b\u0435\u0431\u0435\u0433 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 28 \u0438\u044e\u043d\u044f
    1875 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u043e\u0432\u0435
    \u043d\u0430 \u0441\u0435\u0432\u0435\u0440\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0441\u043a\u0438\u043c
    \u0440\u0430\u0431\u043e\u0447\u0438\u043c, \u0430 \u043c\u0430\u0442\u044c \u2014 \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439.
    \u0412 \u0441\u0435\u043c\u044c\u0435 \u0441\u043e\u0431\u0440\u0430\u043b\u0438 \u0445\u043e\u0440\u043e\u0448\u0443\u044e
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442 \u043f\u0440\u0438\u043e\u0431\u0449\u0438\u043b\u0430
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430 \u043a \u0437\u043d\u0430\u043d\u0438\u044f\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043a\u043e\u0433\u0434\u0430 \u0410\u043d\u0440\u0438
    \u0431\u044b\u043b\u043e \u0435\u0449\u0451 \u0441\u043e\u0432\u0441\u0435\u043c \u043c\u0430\u043b\u043e,
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0443\u043c\u0435\u0440 \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437\u0430.
    \u041c\u0430\u0442\u044c, \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c \u043e\u0434\u043d\u0430,
    \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u043b\u0430 \u0432\u0441\u0435 \u0443\u0441\u0438\u043b\u0438\u044f,
    \u0447\u0442\u043e\u0431\u044b \u0434\u0430\u0442\u044c \u0441\u044b\u043d\u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435,
    \u0438 \u0432\u044b\u0445\u043b\u043e\u043f\u043e\u0442\u0430\u043b\u0430 \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e \u043c\u0443\u043d\u0438\u0446\u0438\u043f\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e. \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u043e\u043c\u0443 \u044e\u043d\u043e\u0448\u0435
    \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439
    \u043a\u043e\u043b\u043b\u0435\u0436 \u0432 \u0411\u043e\u0432\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0443\u0447\u0451\u0431\u0443
    \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0445
    \u043b\u0438\u0446\u0435\u044f\u0445 \u0421\u0435\u043d-\u041b\u0443\u0438 \u0438 \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0430
    \u0412\u0435\u043b\u0438\u043a\u043e\u0433\u043e.\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430
    \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0412
    1894 \u0433\u043e\u0434\u0443 \u041b\u0435\u0431\u0435\u0433 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u044d\u043b\u0438\u0442\u043d\u0443\u044e \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0443\u044e
    \u0412\u044b\u0441\u0448\u0443\u044e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 (\u00c9cole Normale Sup\u00e9rieure) \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u0443\u0437
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u041e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0435\u0451 \u0432 1897 \u0433\u043e\u0434\u0443, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u0434\u0438\u043f\u043b\u043e\u043c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0421\u0440\u0430\u0437\u0443
    \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u043f\u0443\u0441\u043a\u0430 \u041b\u0435\u0431\u0435\u0433
    \u043d\u0435 \u0441\u043f\u0435\u0448\u0438\u043b \u043d\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443. \u041e\u043d \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u0432 \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u0435
    \u0435\u0449\u0451 \u043d\u0430 \u0434\u0432\u0430 \u0433\u043e\u0434\u0430, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430\u0440\u044f.
    \u042d\u0442\u043e \u0434\u0430\u043b\u043e \u0435\u043c\u0443 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u0431\u043e\u0433\u0430\u0442\u0435\u0439\u0448\u0435\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u0439 \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0441\u0430\u043c\u044b\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u0420\u0435\u043d\u0435-\u041b\u0443\u0438 \u0411\u044d\u0440\u0430
    \u043f\u043e \u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c
    \u0438 \u0442\u0440\u0443\u0434\u044b \u041a\u0430\u043c\u0438\u043b\u043b\u0430 \u0416\u043e\u0440\u0434\u0430\u043d\u0430.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434, \u0432 1898 \u0433\u043e\u0434\u0443,
    \u0431\u044b\u043b\u0430 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430
    \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0442\u0430\u0442\u044c\u044f.\n\n\U0001F4BC \u0420\u0430\u0431\u043e\u0442\u0430
    \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u0435\u043c\u044c\u0438 \u0421
    1899 \u043f\u043e 1902 \u0433\u043e\u0434 \u041b\u0435\u0431\u0435\u0433 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0432 \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u043c
    \u043b\u0438\u0446\u0435\u0435 \u0433\u043e\u0440\u043e\u0434\u0430 \u041d\u0430\u043d\u0441\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c, \u0441\u043e\u0432\u043c\u0435\u0449\u0430\u044f
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u043e\u043d \u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0441\u0432\u043e\u044e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u00ab\u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b, \u0434\u043b\u0438\u043d\u0430,
    \u043f\u043b\u043e\u0449\u0430\u0434\u044c\u00bb. \u0412 1903 \u0433\u043e\u0434\u0443,
    \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439
    \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438,
    \u041b\u0435\u0431\u0435\u0433 \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041b\u0443\u0438\u0437-\u041c\u0430\u0440\u0433\u0435\u0440\u0438\u0442
    \u0412\u0430\u043b\u043b\u0435 (Louise-Marguerite Vallet), \u0441\u0435\u0441\u0442\u0440\u0435
    \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0441\u0432\u043e\u0438\u0445 \u043e\u0434\u043d\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u043e\u0432.
    \u0412 \u0431\u0440\u0430\u043a\u0435 \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0434\u0432\u043e\u0435 \u0434\u0435\u0442\u0435\u0439 \u2014 \u0441\u044b\u043d \u0416\u0430\u043a
    \u0438 \u0434\u043e\u0447\u044c \u0421\u044e\u0437\u0430\u043d\u043d\u0430. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u043d\u0435
    \u0441\u043b\u043e\u0436\u0438\u043b\u0430\u0441\u044c, \u0438 \u0432 1916 \u0433\u043e\u0434\u0443
    \u0441\u0443\u043f\u0440\u0443\u0433\u0438 \u0440\u0430\u0437\u043e\u0448\u043b\u0438\u0441\u044c.\n\n\U0001F4C8
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430:
    \u043e\u0442 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0438 \u043a \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u044d\u043b\u0438\u0442\u0435 \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e, \u043f\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0434\u043b\u044f \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043f\u0443\u0442\u0438 \u2014 \u043e\u0442 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u043e\u0432 \u043a \u0441\u0442\u043e\u043b\u0438\u0447\u043d\u044b\u043c.
    1902\u20131906: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0420\u0435\u043d\u043d\u0430. 1906\u20131910: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u041f\u0443\u0430\u0442\u044c\u0435.
    1910: \u041d\u0430\u043a\u043e\u043d\u0435\u0446, \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0443\u044e
    \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0443, \u0433\u0434\u0435 \u0441\u0442\u0430\u043b
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c, \u0430
    \u0441 1920 \u0433\u043e\u0434\u0430 \u2014 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c.
    1921: \u041b\u0435\u0431\u0435\u0433 \u0437\u0430\u043d\u044f\u043b \u043f\u043e\u0441\u0442
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u043c \u041a\u043e\u043b\u043b\u0435\u0436
    \u0434\u0435 \u0424\u0440\u0430\u043d\u0441, \u0433\u0434\u0435 \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438. \u0412 \u0433\u043e\u0434\u044b
    \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u043e\u043d \u0432\u043d\u0451\u0441 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u043e\u0431\u043e\u0440\u043e\u043d\u0443, \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u044e
    \u0421\u043b\u0443\u0436\u0431\u044b \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0439.
    \u041e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u043c\u0438
    \u0430\u0440\u0442\u0438\u043b\u043b\u0435\u0440\u0438\u0439\u0441\u043a\u0438\u0445 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0439,
    \u0437\u0430 \u0447\u0442\u043e \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u043e\u0440\u0434\u0435\u043d\u0430 \u041f\u043e\u0447\u0451\u0442\u043d\u043e\u0433\u043e
    \u043b\u0435\u0433\u0438\u043e\u043d\u0430.\n\n\U0001F5E3\ufe0f \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0443 \u041b\u0435\u0431\u0435\u0433\u0430
    \u0431\u044b\u043b \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u043e\u0439, \u0438 \u0435\u0433\u043e
    \u043f\u0443\u0442\u044c \u043a \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e \u0431\u044b\u043b
    \u043e\u0442\u043c\u0435\u0447\u0435\u043d \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u0441\u043f\u043e\u0440\u0430\u043c\u0438. \u0420\u0430\u043d\u043d\u044f\u044f \u043a\u0440\u0438\u0442\u0438\u043a\u0430:
    \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044e \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430
    \u0420\u0438\u043c\u0430\u043d\u0430 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b\u0438
    \u0440\u0435\u0437\u043a\u0443\u044e \u043a\u0440\u0438\u0442\u0438\u043a\u0443 \u0441\u043e
    \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u0445
    \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u0432, \u0442\u0430\u043a\u0438\u0445
    \u043a\u0430\u043a \u0416\u0430\u043d \u0413\u0430\u0441\u0442\u043e\u043d \u0414\u0430\u0440\u0431\u0443
    \u0438 \u041a\u0430\u043c\u0438\u043b\u043b \u0416\u043e\u0440\u0434\u0430\u043d. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043e\u0447\u0435\u043d\u044c \u0441\u043a\u043e\u0440\u043e \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f
    \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043b\u0430 \u0432\u0441\u0435\u043e\u0431\u0449\u0435\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435. \u0421\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u0411\u044d\u0440\u043e\u043c: \u0423 \u043d\u0435\u0433\u043e \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430
    \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u0430\u044f \u043d\u0430\u043f\u0440\u044f\u0436\u0451\u043d\u043d\u043e\u0441\u0442\u044c
    \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445 \u0441 \u0420\u0435\u043d\u0435-\u041b\u0443\u0438
    \u0411\u044d\u0440\u043e\u043c. \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u043d\u0430\u0447\u0430\u043b\u0441\u044f
    \u0432 1904 \u0433\u043e\u0434\u0443 \u0438\u0437-\u0437\u0430 \u0442\u043e\u0433\u043e,
    \u043a\u0442\u043e \u0438\u0437 \u043d\u0438\u0445 \u0438\u043c\u0435\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435
    \u043f\u0440\u0430\u0432 \u0447\u0438\u0442\u0430\u0442\u044c \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439
    \u043a\u0443\u0440\u0441 \u043b\u0435\u043a\u0446\u0438\u0439 \u0432 \u041a\u043e\u043b\u043b\u0435\u0436
    \u0434\u0435 \u0424\u0440\u0430\u043d\u0441, \u0438 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043f\u0435\u0440\u0435\u0440\u043e\u0441 \u0432 \u0437\u0430\u0442\u044f\u0436\u043d\u0443\u044e
    \u0432\u0440\u0430\u0436\u0434\u0443. \u0420\u0430\u0437\u043d\u043e\u0433\u043b\u0430\u0441\u0438\u044f
    \u0441 \u0411\u043e\u0440\u0435\u043b\u0435\u043c: \u041b\u0435\u0431\u0435\u0433 \u0442\u0430\u043a\u0436\u0435
    \u0440\u0430\u0437\u043e\u0448\u0451\u043b\u0441\u044f \u0432\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u0445
    \u0441 \u042d\u043c\u0438\u043b\u0435\u043c \u0411\u043e\u0440\u0435\u043b\u0435\u043c (\u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043a\u0441\u0442\u0430\u0442\u0438, \u0431\u044b\u043b \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c). \u0421\u043f\u043e\u0440
    \u043a\u0430\u0441\u0430\u043b\u0441\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432
    \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043c\u043e\u0441\u0442\u0438
    \u0438 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438. \u0411\u043e\u0440\u0435\u043b\u044c \u043f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0441\u044f
    \u0431\u043e\u043b\u0435\u0435 \u0441\u0442\u0440\u043e\u0433\u0438\u0445 \u043f\u043e\u0437\u0438\u0446\u0438\u0439,
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u041b\u0435\u0431\u0435\u0433
    \u0441\u043c\u0435\u043b\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0430\u043a\u0441\u0438\u043e\u043c\u0443 \u0432\u044b\u0431\u043e\u0440\u0430 \u0438 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0440\u0430\u0437\u043d\u043e\u0433\u043b\u0430\u0441\u0438\u044f,
    \u043e\u0431\u0430 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0438 \u0432\u043a\u043b\u0430\u0434
    \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u043f\u0440\u0438\u0448\u043b\u043e \u043a \u043d\u0435\u043c\u0443 \u043f\u043e\u0437\u0436\u0435:
    \u0432 1922 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439
    \u043c\u0438\u0440\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0435
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e
    (1930) \u0438 \u0410\u041d \u0421\u0421\u0421\u0420 (1929).\n\n\U0001F54A\ufe0f \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u0431\u0435\u0433\u0430
    \u0431\u044b\u043b\u0438 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u044b \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438. \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0435\u0433\u043e \u0440\u043e\u0434\u043d\u043e\u0439 \u0434\u043e\u043c \u0432 \u0411\u043e\u0432\u0435
    \u0431\u044b\u043b \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d. \u041d\u043e \u0431\u043e\u043b\u0435\u0435
    \u0442\u044f\u0436\u0451\u043b\u044b\u043c \u0443\u0434\u0430\u0440\u043e\u043c \u0441\u0442\u0430\u043b\u0430
    \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u0430\u044f \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u044f
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u0432 1940 \u0433\u043e\u0434\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0440\u0430\u043d\u0438\u043b\u0430 \u0435\u0433\u043e
    \u043f\u0430\u0442\u0440\u0438\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430.
    \u041b\u0435\u0431\u0435\u0433 \u0437\u0430\u043c\u043a\u043d\u0443\u043b\u0441\u044f \u0432
    \u0441\u0435\u0431\u0435, \u0435\u0433\u043e \u0438 \u0431\u0435\u0437 \u0442\u043e\u0433\u043e
    \u0441\u043b\u0430\u0431\u043e\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0440\u0435\u0437\u043a\u043e
    \u0443\u0445\u0443\u0434\u0448\u0438\u043b\u043e\u0441\u044c. \u0410\u043d\u0440\u0438 \u041b\u0435\u043e\u043d
    \u041b\u0435\u0431\u0435\u0433 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 26
    \u0438\u044e\u043b\u044f 1941 \u0433\u043e\u0434\u0430 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 66 \u043b\u0435\u0442."
  personalLifeEn: 
  shortBioRu: "\u0410\u043d\u0440\u0438 \u041b\u0435\u043e\u043d \u041b\u0435\u0431\u0435\u0433 (1875\u20131941)
    \u2014 \u0444\u0438\u0433\u0443\u0440\u0430, \u0447\u044c\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u0441\u043a\u043e\u0440\u0435\u0435 \u0447\u0435\u0440\u0435\u0437 \u0438\u0441\u0442\u043e\u0440\u0438\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443, \u0447\u0435\u043c \u0447\u0435\u0440\u0435\u0437
    \u044f\u0440\u043a\u0438\u0435 \u0432\u043d\u0435\u0448\u043d\u0438\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u044f.
    \u041e\u043d \u043f\u0440\u043e\u0436\u0438\u043b \u0436\u0438\u0437\u043d\u044c, \u0432\u043d\u0435\u0448\u043d\u0435
    \u043b\u0438\u0448\u0435\u043d\u043d\u0443\u044e \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432, \u043d\u043e \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u0443\u044e
    \u0433\u043b\u0443\u0431\u043e\u0447\u0430\u0439\u0448\u0435\u0439 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439
    \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u0435\u0439 \u0435\u0433\u043e \u0438\u0434\u0435\u0439.
    \u0412\u043e\u0442 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u043b\u043d\u044b\u0439
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u044d\u0442\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0445.
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    (1875\u20131897) \u041b\u0435\u0431\u0435\u0433 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    28 \u0438\u044e\u043d\u044f 1875 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u0411\u043e\u0432\u0435 (\u043d\u0430 \u0441\u0435\u0432\u0435\u0440\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438).
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u043f\u0440\u043e\u0441\u0442\u044b\u043c
    \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0441\u043a\u0438\u043c \u0440\u0430\u0431\u043e\u0447\u0438\u043c,
    \u0430 \u043c\u0430\u0442\u044c \u2014 \u0448\u0432\u0435\u0435\u0439. \u041a\u043e\u0433\u0434\u0430
    \u0410\u043d\u0440\u0438 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e 11 \u043b\u0435\u0442,
    \u043e\u0442\u0435\u0446 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442
    \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430, \u0438 \u0441\u0435\u043c\u044c\u044f
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u0432 \u043a\u0440\u0430\u0439\u043d\u0435
    \u0441\u0442\u0435\u0441\u043d\u0435\u043d\u043d\u044b\u0445 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445.
    \u0412\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430
    \u043b\u0435\u0433\u043b\u0438 \u043d\u0430 \u043f\u043b\u0435\u0447\u0438 \u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u0440\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u044c, \u0441\u0443\u043c\u0435\u043b\u0430
    \u0434\u0430\u0442\u044c \u0441\u044b\u043d\u0443 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0443\u0447\u0438\u0442\u044c\u0441\u044f. \u041f\u0440\u043e\u044f\u0432\u0438\u0432 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438, \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u043b\u0438\u0446\u0435\u0439 \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0430 \u0412\u0435\u043b\u0438\u043a\u043e\u0433\u043e,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u2014 \u0432 \u0412\u044b\u0441\u0448\u0443\u044e
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443
    (\u0432 1894 \u0433\u043e\u0434\u0443). \u0412 \u0441\u0442\u0435\u043d\u0430\u0445 \u044d\u0442\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u043e\u043d \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0432 \u0441\u0440\u0435\u0434\u0435 \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u0441\u0432\u0435\u0442\u0438\u043b
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u043d\u0430\u0443\u043a\u0438
    (\u0441\u0440\u0435\u0434\u0438 \u0435\u0433\u043e \u0441\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u043e\u0432
    \u0431\u044b\u043b, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u041f\u043e\u043b\u044c
    \u041f\u0435\u043d\u043b\u0435\u0432\u0435). \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e
    \u043f\u0443\u0442\u044c \u043d\u0435 \u0431\u044b\u043b \u0431\u0435\u0437\u043e\u0431\u043b\u0430\u0447\u043d\u044b\u043c:
    \u043d\u0430 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u044b\u0445 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u0445
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b
    \u043b\u0438\u0448\u044c \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    (\u0430\u0433\u0440\u0435\u0436\u0435 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0432 1897 \u0433\u043e\u0434\u0443), \u0443\u0441\u0442\u0443\u043f\u0438\u0432 \u043f\u0435\u0440\u0432\u0435\u043d\u0441\u0442\u0432\u043e.
    \u042d\u0442\u043e, \u043e\u0434\u043d\u0430\u043a\u043e, \u043d\u0435 \u043f\u043e\u043c\u0435\u0448\u0430\u043b\u043e
    \u0435\u043c\u0443 \u0437\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u0447\u0438\u0441\u0442\u043e\u0439
    \u043d\u0430\u0443\u043a\u043e\u0439. \u041d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043d\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    (1899\u20131902) \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u041b\u0435\u0431\u0435\u0433 \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0446\u0435\u043d\u0442\u0440\u0430 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439,
    \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0438\u0437\u0443\u0447\u0430\u044f \u0442\u0440\u0443\u0434\u044b \u0441\u0432\u043e\u0438\u0445
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432.
    \u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0439 \u0442\u043e\u0447\u043a\u043e\u0439 \u043e\u0442\u0441\u0447\u0435\u0442\u0430
    \u0434\u043b\u044f \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u0441\u0442\u0430\u043b
    1901 \u0433\u043e\u0434, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u00ab\u041e\u0431 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0435\u00bb. \u0412
    \u043d\u0435\u0439 \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435,
    \u043e\u0431\u043e\u0431\u0449\u0438\u0432 \u0438\u0434\u0435\u0438 \u0420\u0438\u043c\u0430\u043d\u0430.
    \u0414\u0435\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0430
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0438\u0441\u044c \u0432 \u043e\u0442\u043a\u0430\u0437\u0435
    \u043e\u0442 \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f (\u043e\u0441\u0438 X)
    \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u044f
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439
    (\u043e\u0441\u0438 Y). \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c \u00ab\u043c\u0435\u0440\u0443\u00bb
    \u0434\u0430\u0436\u0435 \u0434\u043b\u044f \u043e\u0447\u0435\u043d\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0445,
    \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    \u0442\u043e\u0447\u0435\u043a, \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0435\u043c\u044b\u0441\u043b\u0438\u043c\u043e
    \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0435.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0435\u0433\u043e \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0432 1902 \u0433\u043e\u0434\u0443 \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0412\u0430\u0436\u043d\u043e
    \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430 \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u043e\u0432\u043e\u043c\u0443 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0443,
    \u0430 \u0446\u0435\u043b\u043e\u043c\u0443 \u043d\u043e\u0432\u043e\u043c\u0443 \u043f\u043e\u043d\u044f\u0442\u0438\u044e
    \u0438\u0437\u043c\u0435\u0440\u0438\u043c\u043e\u0441\u0442\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u0447\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u043b\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437. \u0417\u0440\u0435\u043b\u044b\u0435 \u0433\u043e\u0434\u044b:
    \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435
    (1902\u20131921) \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433, \u041b\u0435\u0431\u0435\u0433 \u043d\u0435 \u0441\u0440\u0430\u0437\u0443
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u0435\u0441\u0442\u043e \u0432 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u044d\u043b\u0438\u0442\u0435. \u0421 1902 \u043f\u043e 1906 \u0433\u043e\u0434 \u043e\u043d
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0420\u0435\u043d\u043d\u0430 (\u0432 \u0411\u0440\u0435\u0442\u0430\u043d\u0438), \u0437\u0430\u0442\u0435\u043c
    \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u0432 \u041f\u0443\u0430\u0442\u044c\u0435 (1906\u20131910),
    \u0433\u0434\u0435 \u0447\u0438\u0442\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435. \u041b\u0438\u0448\u044c \u0432 1910 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436,
    \u0437\u0430\u043d\u044f\u0432 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f
    (ma\u00eetre de conf\u00e9rences) \u0432 \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435.
    \u041f\u043e\u043b\u043d\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u043e\u043d \u0441\u0442\u0430\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u0432 1919 \u0433\u043e\u0434\u0443.
    \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 (1910\u20131920-\u0435) \u2014
    \u0432\u0440\u0435\u043c\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0438.
    \u041b\u0435\u0431\u0435\u0433 \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u0443\u044e
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044e \u0441 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u2014 \u042d\u043c\u0438\u043b\u0435\u043c \u0411\u043e\u0440\u0435\u043b\u0435\u043c.
    \u0411\u043e\u0440\u0435\u043b\u044c \u0438 \u0435\u0433\u043e \u0448\u043a\u043e\u043b\u0430
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0438 \u0442\u0435\u043e\u0440\u0438\u044e
    \u043c\u0435\u0440\u044b \u0441 \u043f\u043e\u0437\u0438\u0446\u0438\u0439 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043c\u043e\u0441\u0442\u0438, \u0442\u043e\u0433\u0434\u0430
    \u043a\u0430\u043a \u041b\u0435\u0431\u0435\u0433 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0430\u043a\u0441\u0438\u043e\u043c\u0443 \u0432\u044b\u0431\u043e\u0440\u0430 \u0438 \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0431\u043e\u043b\u0435\u0435 \u0441\u043c\u0435\u043b\u043e,
    \u0447\u0442\u043e \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u0443.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043e\u0431\u0430 \u0443\u0447\u0435\u043d\u044b\u0445 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0438
    \u0432\u0435\u043b\u0438\u0447\u0438\u0435 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430.
    \u0412 1922 \u0433\u043e\u0434\u0443 \u041b\u0435\u0431\u0435\u0433 \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u0441\u043c\u0435\u043d\u0438\u0432
    \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443 \u0410\u043d\u0440\u0438
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 (\u0447\u0442\u043e \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u043d\u043e,
    \u0445\u043e\u0442\u044f \u0438 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e). \u041f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0412\u0442\u043e\u0440\u0430\u044f \u043c\u0438\u0440\u043e\u0432\u0430\u044f
    \u0432\u043e\u0439\u043d\u0430 (1921\u20131941) \u0421 1921 \u0433\u043e\u0434\u0430 \u041b\u0435\u0431\u0435\u0433
    \u0437\u0430\u043d\u044f\u043b \u043f\u043e\u0441\u0442 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u041a\u043e\u043b\u043b\u0435\u0436 \u0434\u0435 \u0424\u0440\u0430\u043d\u0441,
    \u0433\u0434\u0435 \u0447\u0438\u0442\u0430\u043b \u043a\u0443\u0440\u0441\u044b \u043f\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439. \u0412
    1930-\u0435 \u0433\u043e\u0434\u044b \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0441\u043c\u0435\u0441\u0442\u0438\u043b\u0438\u0441\u044c \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438, \u043e\u043d \u043c\u043d\u043e\u0433\u043e
    \u043f\u0438\u0441\u0430\u043b \u043e\u0431 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0412 1940 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u0432\u043e \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u0435, \u041b\u0435\u0431\u0435\u0433, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0443\u0436\u0435 \u043f\u043e\u0436\u0438\u043b\u044b\u043c \u0438 \u0431\u043e\u043b\u044c\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u0432 \u043e\u043a\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u041f\u0430\u0440\u0438\u0436\u0435. \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u0432\u043e\u0435\u043d\u043d\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u043e\u0440\u0432\u0430\u043b\u0438
