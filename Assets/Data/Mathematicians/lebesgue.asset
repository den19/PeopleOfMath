    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u043e\u0440\u0432\u0430\u043b\u0438
    \u0435\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435. \u041e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    26 \u0438\u044e\u043b\u044f 1941 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    66 \u043b\u0435\u0442. \u041b\u0438\u0447\u043d\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u044b\u0435 \u0434\u0435\u0442\u0430\u043b\u0438
    \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440: \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \u043a\u0430\u043a
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0433\u043e,
    \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e \u043a \u0441\u0435\u0431\u0435 \u0438
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u043e\u0431\u043b\u0430\u0434\u0430\u0432\u0448\u0435\u0433\u043e \u0442\u043e\u043d\u043a\u0438\u043c
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c \u044e\u043c\u043e\u0440\u0430. \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435:
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0438\u043c\u044f \u043f\u0440\u043e\u0447\u043d\u043e \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u0443\u0435\u0442\u0441\u044f
    \u0441 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u043c, \u0441\u0430\u043c
    \u041b\u0435\u0431\u0435\u0433 \u0432 \u043a\u043e\u043d\u0446\u0435 \u0436\u0438\u0437\u043d\u0438
    \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u0441\u0430\u043c\u0430 \u0442\u0435\u0445\u043d\u0438\u043a\u0430
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u0430
    \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u0438\u0435 \u0441\u0430\u043c\u043e\u0433\u043e
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u00ab\u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u043f\u043e\u0434 \u043a\u0440\u0438\u0432\u043e\u0439\u00bb \u043a\u0430\u043a \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u043c\u0435\u0440\u044b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430. \u0422\u0430\u043a\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u0440 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b,
    \u0433\u0434\u0435 \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0434\u0440\u0430\u043c\u044b
    \u0440\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0436\u0443\u0440\u043d\u0430\u043b\u043e\u0432, \u0430 \u043d\u0435 \u0432 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0445\u0440\u043e\u043d\u0438\u043a\u0430\u0445, \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e
    \u043e\u043d\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438 \u044f\u0437\u044b\u043a
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438."
  shortBioEn: "Henri Leon Lebeg (1875–141) is a figure whose biography in detail is revealed more through the history of mathematics and scientific correspondence than through vivid external events, living a life that is apparently free of dramatic twists but filled with the deepest internal evolution of his ideas. This is the most complete portrait of this math based on available historical data.==Early years and education==Lebeg was born on June 28, 1875 in Bowe, northern France, where his father was a simple printing worker and his mother a seamstress. When Henri was only 11 years old, his father died of tuberculosis and his family was in very difficult circumstances.After his brilliant performance, he entered the prestigious Parisian Lyceum of Louis the Great, and then the Higher Normal School (1894), where he found himself in the midst of future French science (with his fellow students, for example, Paul Penleve), but his path was not cloudless: he showed only a second result in his math exams (the mathematics match in 1897), giving way to the first.This, however, did not prevent him from pursuing pure science; the beginning of his career and the birth of a new theory (1899–1902) immediately after Lebeg began working in the library of the National Centre for Scientific Research, in parallel with his predecessors' in-depth research, the key point of departure for his discoveries was 1901, when he published his famous work on the Integrated.In it, he proposed a radical new view of integration, summarizing the ideas of Riman. The details of his approach were not to break down the area of definition (axis X) in favour of breaking down the area of values (axis Y). This made it possible to define the \"measure\" even for very complex, fragmented sets of points, which was inconceivable in classical analysis. This was the basis of his doctoral thesis, which he protected at the University of Paris in 1902.It is important to note that thesis was not just about the new integral, but about the whole new concept of the measurability of the many things, which reversed the functional analysis.In 1910, he returned to Paris as a professor (maêtre de conférences) in Sorbonne, where he became a full professor only in 1919, a period of intense debate (1910's) and Lebe entered into a serious discussion with the largest mathematician of the time, Emil Borel.Borel and his school developed a theory of action from the perspective of constructive logic and effective computation, while Lebe used the axiom of choice and indivisible multitudes more daringly, which was criticized. Despite the differences, both scientists acknowledged each other's greatness. In 1922 Lebeg was elected a member of the Paris Academy of Sciences, replacing Henri Poancare (which was symbolic, though some time after the death of the latter).In the 1930s, Lebeg became a professor at Collège de France, where he studied the theory of function. In the 1930s, his interests shifted to applied mathematics and mechanics, and he wrote a great deal about the historical evolution of mathematical analysis.He died on July 26, 1941, at the age of 66, in a state of war that was described by the Contemporarys as being a man who was confined to himself and his students, but had a subtle sense of humor.Legacy: Although his name is strongly associated with integration, Lebe himself at the end of his life acknowledged that his greatest contribution was not the technology of integration itself, but the rethinking of the concept of \"area under the curve\" itself as an abstract measure of many.So his life is an example of a classic academic career, where the main dramas were in the pages of scientific journals, not in political chronicles, but they defined the language of modern mathematics."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0410\u043d\u0440\u0438 \u041b\u0435\u0431\u0435\u0433\u0430,
    \u043f\u043e\u043c\u0438\u043c\u043e \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u044b\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439,
    \u043f\u043e\u043b\u043d\u0430 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u044b\u0445
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0438\u0441\u0443\u044e\u0442
    \u0435\u0433\u043e \u0436\u0438\u0432\u043e\u0439, \u0443\u0437\u043d\u0430\u0432\u0430\u0435\u043c\u044b\u0439
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442.\n\n\U0001F9D2 \u041a\u0443\u0440\u044c\u0451\u0437
    \u0438\u0437 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u0442 \u041e\u0434\u043d\u0430
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439 \u0441\u043b\u0443\u0447\u0438\u043b\u0430\u0441\u044c
    \u0441 \u041b\u0435\u0431\u0435\u0433\u043e\u043c, \u043a\u043e\u0433\u0434\u0430 \u0435\u043c\u0443
    \u0431\u044b\u043b\u043e \u043e\u043a\u043e\u043b\u043e \u0434\u0435\u0441\u044f\u0442\u0438
    \u043b\u0435\u0442. \u041d\u0430 \u0443\u0440\u043e\u043a\u0435 \u043e\u043d \u0440\u0435\u0448\u0438\u043b
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043f\u0435\u0440\u0432\u044b\u043c \u0438 \u043f\u0440\u0438\u043d\u0435\u0441
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0443\u0447\u0438\u0442\u0435\u043b\u044e.
    \u0423\u0447\u0438\u0442\u0435\u043b\u044c, \u0441\u0432\u0435\u0440\u0438\u0432\u0448\u0438\u0441\u044c
    \u0441 \u043e\u0442\u0432\u0435\u0442\u043e\u043c \u0432 \u043a\u043d\u0438\u0433\u0435,
    \u0441\u043a\u0430\u0437\u0430\u043b \u0435\u043c\u0443: \u00ab\u042d\u0442\u043e \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e.
    \u041f\u0435\u0440\u0435\u0434\u0435\u043b\u044b\u0432\u0430\u0439\u00bb. \u041b\u0435\u0431\u0435\u0433
    \u043e\u0442\u043e\u0448\u0435\u043b, \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435,
    \u043d\u0435 \u043d\u0430\u0448\u0435\u043b \u043e\u0448\u0438\u0431\u043a\u0438 \u0438
    \u0441\u043d\u043e\u0432\u0430 \u043f\u043e\u0434\u043e\u0448\u0435\u043b \u0441 \u0442\u0435\u043c
