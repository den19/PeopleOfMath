    \u043b\u044e\u0431\u0438\u043c\u0443\u044e \u0434\u043e\u0447\u044c \u043d\u0430 \u0432\u043e\u0441\u0435\u043c\u044c
    \u043b\u0435\u0442. \u041f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u043c\u0435\u0441\u0442\u043e \u0435\u0433\u043e \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e
