    \u0411\u0440\u043e\u0441\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b
    \u0441 \u0432\u044b\u0441\u043e\u0442\u044b 50 \u043c\u0435\u0442\u0440\u043e\u0432 \u0431\u044b\u043b\u043e
    \u0431\u044b \u043a\u0440\u0430\u0439\u043d\u0435 \u043d\u0435\u0442\u043e\u0447\u043d\u043e
    \u0438\u0437-\u0437\u0430 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f
    \u0432\u043e\u0437\u0434\u0443\u0445\u0430. 3. \u041f\u0435\u0440\u0432\u044b\u0439 \u0432
    \u043c\u0438\u0440\u0435 \u00ab\u043c\u043e\u0437\u0433\u043e\u0432\u043e\u0439 \u0448\u0442\u0443\u0440\u043c\u00bb
    (\u0418\u043b\u0438 \u043a\u0430\u043a \u043e\u043d \u0447\u0443\u0442\u044c \u043d\u0435
    \u0441\u0442\u0430\u043b \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u043e\u043c)
    \u0412 1580-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0413\u0430\u043b\u0438\u043b\u0435\u0439,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u0438 \u0431\u0435\u0434\u043d\u044b\u043c
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c, \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u043d\u0430\u0439\u0442\u0438 \u0441\u043f\u043e\u0441\u043e\u0431 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c.
    \u041e\u043d \u0432\u0441\u0435\u0440\u044c\u0435\u0437 \u0437\u0430\u0434\u0443\u043c\u0430\u043b
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u043d\u0430\u043d\u0438\u044f \u043a... \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0435
    \u0438 \u0433\u0440\u0430\u0434\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443.
    \u041e\u043d \u043f\u043e\u0434\u0430\u043b \u0437\u0430\u044f\u0432\u043a\u0443 \u043d\u0430
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430 \u0432 \u0412\u0435\u043d\u0435\u0446\u0438\u0438,
    \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u044f, \u0447\u0442\u043e \u0441\u043c\u043e\u0436\u0435\u0442
    \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0430\u0442\u044c \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435
    \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0440\u044b\u0447\u0430\u0433\u043e\u0432, \u0430
    \u0442\u0430\u043a\u0436\u0435 \u043e\u0431\u043c\u0435\u043b\u044f\u0442\u044c \u0440\u0435\u043a\u0438
    \u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0434\u0430\u043c\u0431\u044b. \u0415\u0433\u043e
    \u043d\u0435 \u0432\u0437\u044f\u043b\u0438, \u043d\u043e \u044d\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u043e\u043c, \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u00ab\u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043d\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c\u00bb.
    4. \u041e\u043d \u043d\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u043b \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f,
    \u043d\u043e \u0441\u0434\u0435\u043b\u0430\u043b \u0435\u0433\u043e \u0431\u0438\u0437\u043d\u0435\u0441\u043e\u043c
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u043a\u0430\u043a \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430,
    \u043d\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0435\u0433\u043e \u043d\u0435
    \u043e\u043d. \u0412 1608 \u0433\u043e\u0434\u0443 \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439
    \u043e\u043f\u0442\u0438\u043a \u0425\u0430\u043d\u0441 \u041b\u0438\u043f\u043f\u0435\u0440\u0441\u0433\u0435\u0439
    \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043b
    \u043f\u043e\u0434\u0437\u043e\u0440\u043d\u0443\u044e \u0442\u0440\u0443\u0431\u0443. \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u043d\u0435 \u0432\u0438\u0434\u0435\u043b \u044d\u0442\u043e\u0433\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430
    \u0432\u0436\u0438\u0432\u0443\u044e, \u043b\u0438\u0448\u044c \u0443\u0441\u043b\u044b\u0448\u0430\u043b
    \u043e \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f.
    \u0411\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0437\u0430 \u043e\u0434\u043d\u0443
    \u043d\u043e\u0447\u044c \u043e\u043d \u0434\u043e\u0433\u0430\u0434\u0430\u043b\u0441\u044f,
    \u043a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u043b\u0438\u043d\u0437\u044b,
    \u0438 \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u0435\u043b\u044c
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u043b
    \u043f\u0440\u0438\u0431\u043e\u0440 \u0441 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\u043c
    \u0432 8 \u0440\u0430\u0437, \u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u0432 32 \u0440\u0430\u0437\u0430.
    \u041d\u043e \u0441\u0430\u043c\u043e\u0435 \u0437\u0430\u0431\u0430\u0432\u043d\u043e\u0435:
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043d\u0435 \u0441\u0442\u0430\u043b \u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f
    \u0447\u0435\u0440\u0442\u0435\u0436\u0430\u043c\u0438 \u0441\u043e \u0432\u0441\u0435\u043c\u0438.
    \u041e\u043d \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u043b \u0441\u0432\u043e\u0438 \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u044b
    \u0432\u0435\u043d\u0435\u0446\u0438\u0430\u043d\u0441\u043a\u0438\u043c \u043a\u0443\u043f\u0446\u0430\u043c
    \u043a\u0430\u043a \u043f\u043e\u0434\u0437\u043e\u0440\u043d\u044b\u0435 \u0442\u0440\u0443\u0431\u044b
    \u0434\u043b\u044f \u0441\u0443\u0434\u043e\u0432, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f,
    \u0447\u0442\u043e \u043e\u043d\u0438 \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u0432\u0438\u0434\u0435\u0442\u044c
    \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u0440\u0430\u0431\u043b\u0438
    \u043d\u0430 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0435 \u0437\u0430 \u0434\u0432\u0430
    \u0447\u0430\u0441\u0430 \u0434\u043e \u0438\u0445 \u043f\u0440\u0438\u0431\u044b\u0442\u0438\u044f.
    \u041e\u043d \u0445\u043e\u0440\u043e\u0448\u043e \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430 \u044d\u0442\u043e\u043c, \u043f\u043e\u043a\u0430 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u044b
    \u043d\u0435 \u0440\u0430\u0441\u043a\u0443\u0441\u0438\u043b\u0438 \u0435\u0433\u043e \u0441\u0435\u043a\u0440\u0435\u0442.
    5. \u041a\u043e\u043d\u043a\u0443\u0440\u0441 \u043d\u0430 \u00ab\u0441\u0430\u043c\u044b\u0439
    \u0442\u043e\u0447\u043d\u044b\u0439 \u043f\u0443\u043b\u044c\u0441\u00bb \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443
    \u0441\u0435\u043a\u0443\u043d\u0434\u043e\u043c\u0435\u0440\u043e\u0432 \u0432 XVII \u0432\u0435\u043a\u0435
    \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e, \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u0438\u0437\u043c\u0435\u0440\u044f\u0442\u044c
    \u0432\u0440\u0435\u043c\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0442\u0435\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043f\u0443\u043b\u044c\u0441\u043e\u043c
    \u0438\u043b\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0435\u0442\u0440\u043e\u043d\u043e\u043c\u0430. \u0412 \u041f\u0430\u0434\u0443\u0435
    \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430 \u2014 \u0432\u0440\u0430\u0447 \u0421\u0430\u043d\u0442\u043e\u0440\u0438\u043e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u043f\u0435\u0440\u0432\u044b\u0439
    \u0432 \u043c\u0438\u0440\u0435 \u0442\u0435\u0440\u043c\u043e\u043c\u0435\u0442\u0440 \u0438
    \u0432\u0435\u0441\u044b \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u043f\u0443\u043b\u044c\u0441\u0430. \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0436\u0435
    \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u0438\u0437\u043c\u0435\u0440\u044f\u0442\u044c
    \u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u0448\u0430\u0440\u043e\u0432 \u043f\u043e \u043d\u0430\u043a\u043b\u043e\u043d\u043d\u043e\u0439
    \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438, \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044f
    \u0432\u0440\u0435\u043c\u044f \u0441 \u043f\u0435\u043d\u0438\u0435\u043c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0433\u043e\u043b\u043e\u0441\u043e\u0432. \u041e\u043d \u043f\u0435\u043b \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0435
    \u0433\u0430\u043c\u043c\u044b, \u0441\u0447\u0438\u0442\u0430\u044f \u0442\u0430\u043a\u0442\u044b,
    \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u0431\u0438\u0432\u0430\u0442\u044c \u0440\u0438\u0442\u043c.
    \u041c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u0442 \u043e\u0442\u0446\u0430-\u043b\u044e\u0442\u043d\u0438\u0441\u0442\u0430 \u043e\u0447\u0435\u043d\u044c
    \u043f\u043e\u043c\u043e\u0433\u043b\u043e \u0435\u043c\u0443 \u0432 \u0444\u0438\u0437\u0438\u043a\u0435!
    6. \u041e\u043d \u0434\u0430\u0432\u0430\u043b \u0438\u043c\u0435\u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u043c
    \u0432 \u043e\u0431\u043c\u0435\u043d \u043d\u0430 \u0434\u0435\u043d\u044c\u0433\u0438
    \u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0430 \u042e\u043f\u0438\u0442\u0435\u0440\u0430
    \u0432 1610 \u0433\u043e\u0434\u0443, \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043f\u043e\u043d\u0438\u043c\u0430\u043b,
    \u0447\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043d\u0443\u0436\u043d\u043e
    \u00ab\u043f\u0440\u043e\u0434\u0430\u0442\u044c\u00bb \u0441 \u0432\u044b\u0433\u043e\u0434\u043e\u0439.
    \u041e\u043d \u043d\u0430\u0437\u0432\u0430\u043b \u0438\u0445 \u00ab\u041c\u0435\u0434\u0438\u0446\u0435\u0439\u0441\u043a\u0438\u043c\u0438
    \u0437\u0432\u0451\u0437\u0434\u0430\u043c\u0438\u00bb (\u0432 \u0447\u0435\u0441\u0442\u044c
    \u043f\u0440\u0430\u0432\u044f\u0449\u0435\u0439 \u0444\u043b\u043e\u0440\u0435\u043d\u0442\u0438\u0439\u0441\u043a\u043e\u0439
    \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0438 \u041c\u0435\u0434\u0438\u0447\u0438),
    \u0445\u043e\u0442\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u044b \u043f\u043e\u0437\u0436\u0435
    \u043f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043b\u0438 \u0438\u0445
    \u0432 \u0433\u0430\u043b\u0438\u043b\u0435\u0435\u0432\u044b \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0438.
    \u041e\u043d \u043f\u043e\u0441\u043b\u0430\u043b \u0433\u0435\u0440\u0446\u043e\u0433\u0443
    \u041a\u043e\u0437\u0438\u043c\u043e II \u041c\u0435\u0434\u0438\u0447\u0438 \u043c\u043e\u0434\u0435\u043b\u044c
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430 \u0438 \u043a\u043d\u0438\u0433\u0443
    \u00ab\u0417\u0432\u0451\u0437\u0434\u043d\u044b\u0439 \u0432\u0435\u0441\u0442\u043d\u0438\u043a\u00bb
    \u0441 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0438\u0435\u043c. \u0412 \u043e\u0442\u0432\u0435\u0442
    \u0433\u0435\u0440\u0446\u043e\u0433 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0413\u0430\u043b\u0438\u043b\u0435\u044f
    \u0441\u0432\u043e\u0438\u043c \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u043c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u043e\u043a\u043b\u0430\u0434\u043e\u043c
    (\u0432 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0435,
    \u0447\u0435\u043c \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435)
    \u0438 \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u043b \u043e\u0442 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c. \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0441\u0442\u0430\u043b \u0443\u0447\u0435\u043d\u044b\u043c \u0441 \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u043e\u0439
    \u0432 \u00ab\u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u043f\u043b\u0430\u0432\u0430\u043d\u0438\u0435\u00bb.
    7. \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0438 \u043f\u0430\u043f\u0430 \u0440\u0438\u043c\u0441\u043a\u0438\u0439:
    \u0414\u0440\u0443\u0436\u0431\u0430, \u043f\u0435\u0440\u0435\u0448\u0435\u0434\u0448\u0430\u044f
    \u0432\u043e \u0432\u0440\u0430\u0436\u0434\u0443 \u0414\u043e \u0441\u0443\u0434\u0430
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0434\u0440\u0443\u0436\u0438\u043b \u0441 \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u043e\u043c
    \u041c\u0430\u0444\u0444\u0435\u043e \u0411\u0430\u0440\u0431\u0435\u0440\u0438\u043d\u0438
    (\u0431\u0443\u0434\u0443\u0449\u0438\u043c \u043f\u0430\u043f\u043e\u0439 \u0423\u0440\u0431\u0430\u043d\u043e\u043c
    VIII). \u0412 1624 \u0433\u043e\u0434\u0443 \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043f\u0440\u0438\u0435\u0445\u0430\u043b
    \u043a \u043d\u0435\u043c\u0443 \u0432 \u0420\u0438\u043c \u043d\u0430 \u0430\u0443\u0434\u0438\u0435\u043d\u0446\u0438\u044e
    \u0446\u0435\u043b\u044b\u0445 \u0448\u0435\u0441\u0442\u044c \u0440\u0430\u0437 \u043f\u043e\u0434\u0440\u044f\u0434!
    \u041f\u0430\u043f\u0430 \u0434\u0430\u0440\u0438\u043b \u0435\u043c\u0443 \u0446\u0435\u043d\u043d\u044b\u0435
    \u043f\u043e\u0434\u0430\u0440\u043a\u0438 \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u043b\u044f\u043b
    \u043d\u0430 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u00ab\u0414\u0438\u0430\u043b\u043e\u0433\u043e\u0432\u00bb.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u043a\u043d\u0438\u0433\u0435 \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0432\u043b\u043e\u0436\u0438\u043b \u0434\u043e\u0432\u043e\u0434\u044b \u043f\u0430\u043f\u044b
    \u0423\u0440\u0431\u0430\u043d\u0430 VIII \u0432 \u0443\u0441\u0442\u0430 \u0433\u043b\u0443\u043f\u043e\u0432\u0430\u0442\u043e\u0433\u043e
    \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 \u043f\u043e \u0438\u043c\u0435\u043d\u0438
    \u0421\u0438\u043c\u043f\u043b\u0438\u0447\u043e (\u0447\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442
    \u00ab\u041f\u0440\u043e\u0441\u0442\u0430\u043a\u00bb \u0438\u043b\u0438 \u00ab\u0414\u0443\u0440\u0430\u0447\u043e\u043a\u00bb).
    \u041a\u043e\u0433\u0434\u0430 \u043f\u0430\u043f\u0430 \u044d\u0442\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b,
    \u043e\u043d \u0431\u044b\u043b \u0432 \u044f\u0440\u043e\u0441\u0442\u0438 \u043d\u0435
    \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0437-\u0437\u0430 \u043d\u0430\u0443\u043a\u0438,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0438\u0437-\u0437\u0430 \u043b\u0438\u0447\u043d\u043e\u0433\u043e
    \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u0435\u043d\u0438\u044f. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0433\u043d\u0435\u0432 \u043f\u043e\u043d\u0442\u0438\u0444\u0438\u043a\u0430, \u0430
    \u043d\u0435 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u0438\u0435 \u0441\u043f\u043e\u0440\u044b,
    \u043f\u0440\u0438\u0432\u0435\u043b \u043a \u0436\u0435\u0441\u0442\u043a\u043e\u043c\u0443
    \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u0443 1633 \u0433\u043e\u0434\u0430. 8.
    \u041f\u043e\u043c\u0438\u0434\u043e\u0440\u044b \u0438 \u0441\u0443\u043f: \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u0435 \u0417\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0434\u043e \u0441\u0443\u0434\u0430 \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u043b. \u0412\u0440\u0430\u0447\u0438
    \u043f\u0440\u0435\u0434\u043f\u0438\u0441\u0430\u043b\u0438 \u0435\u043c\u0443 \u0441\u0442\u0440\u043e\u0433\u0443\u044e
    \u0434\u0438\u0435\u0442\u0443. \u0418\u043d\u043a\u0432\u0438\u0437\u0438\u0442\u043e\u0440\u044b
    \u0431\u043e\u044f\u043b\u0438\u0441\u044c, \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0440\u0435\u0442
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u044c\u044e
    \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043f\u0440\u0438\u0437\u043d\u0430\u044e\u0442
    \u0435\u0433\u043e \u0432\u0438\u043d\u043e\u0432\u043d\u044b\u043c, \u0438 \u044d\u0442\u043e
    \u0441\u043e\u0440\u0432\u0435\u0442 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441. \u0417\u0430\u0431\u0430\u0432\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442: \u041e\u043d\u0438 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043b\u0438
    \u043a\u043e\u0440\u043c\u0438\u0442\u044c \u0435\u0433\u043e \u043a\u0443\u0440\u0438\u043d\u044b\u043c
    \u0431\u0443\u043b\u044c\u043e\u043d\u043e\u043c \u0438 \u044f\u0439\u0446\u0430\u043c\u0438,
    \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u043e\u043a\u0440\u0435\u043f \u0438 \u0434\u043e\u0436\u0438\u043b
    \u0434\u043e \u0441\u0443\u0434\u0430. \u041d\u043e \u043f\u043e \u0438\u0440\u043e\u043d\u0438\u0438
    \u0441\u0443\u0434\u044c\u0431\u044b, \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e
    \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u043b\u0443\u0447\u0448\u0435 \u0432\u0430\u0440\u0438\u0442\u044c
    \u044f\u0439\u0446\u0430, \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438 \u043d\u0435
    \u043b\u043e\u043f\u0430\u043b\u0438\u0441\u044c. \u0410 \u0435\u0449\u0435 \u043e\u043d
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0446\u0435\u0432, \u043a\u0442\u043e \u043d\u0430\u0447\u0430\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0440\u043e\u043f\u0430\u0433\u0430\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043f\u043e\u043c\u0438\u0434\u043e\u0440\u044b \u0432 \u043f\u0438\u0449\u0443 (\u0445\u043e\u0442\u044f
    \u0434\u043e \u0441\u043e\u0443\u0441\u0430 \u0431\u043e\u043b\u043e\u043d\u044c\u0435\u0437\u0435
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u043e\u0441\u044c \u0435\u0449\u0451 300 \u043b\u0435\u0442).
    9. \u0421\u0430\u043c\u0430\u044f \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u0430\u044f
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430 \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438
    \u2014 \u043c\u043e\u043d\u0430\u0445\u0438\u043d\u044f \u041c\u044b \u0437\u043d\u0430\u0435\u043c
    \u043e \u0442\u0440\u0435\u0445 \u0434\u0435\u0442\u044f\u0445 \u0413\u0430\u043b\u0438\u043b\u0435\u044f.
    \u041d\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439
    \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0444\u0430\u043a\u0442
    \u2014 \u044d\u0442\u043e \u0435\u0433\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430
    \u0441 \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u0412\u0438\u0440\u0434\u0436\u0438\u043d\u0438\u0435\u0439
    (\u0421\u0435\u0441\u0442\u0440\u043e\u0439 \u041c\u0430\u0440\u0438\u0435\u0439 \u0427\u0435\u043b\u0435\u0441\u0442\u043e\u0439),
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u043f\u043e\u0434 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u043c
    \u0430\u0440\u0435\u0441\u0442\u043e\u043c. \u041e\u043d\u0430 \u0436\u0438\u043b\u0430
    \u0432 \u0441\u043e\u0441\u0435\u0434\u043d\u0435\u043c \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435.
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043d\u0435 \u043c\u043e\u0433 \u0435\u0435
    \u043d\u0430\u0432\u0435\u0449\u0430\u0442\u044c (\u043f\u043e \u043f\u0440\u0438\u043a\u0430\u0437\u0443
    \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0438), \u043d\u043e \u043e\u043d\u0430
    \u043f\u0440\u0438\u0441\u044b\u043b\u0430\u043b\u0430 \u0435\u043c\u0443 \u043f\u0435\u0447\u0435\u043d\u044c\u0435,
    \u0432\u0430\u0440\u0435\u043d\u044c\u0435 \u0438 \u0432\u044b\u0448\u0438\u0442\u044b\u0435
    \u043f\u043b\u0430\u0442\u043a\u0438. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c:
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0430 \u0435\u0433\u043e
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438 \u043d\u0430\u0431\u0435\u043b\u043e (\u0443
    \u043d\u0435\u0433\u043e \u0431\u044b\u043b \u0443\u0436\u0430\u0441\u043d\u044b\u0439 \u043f\u043e\u0447\u0435\u0440\u043a),
    \u043f\u043e\u043a\u0430 \u043d\u0435 \u0443\u043c\u0435\u0440\u043b\u0430 \u0432 1634 \u0433\u043e\u0434\u0443
    \u043e\u0442 \u0434\u0438\u0437\u0435\u043d\u0442\u0435\u0440\u0438\u0438. \u0415\u0435
    \u0441\u043c\u0435\u0440\u0442\u044c \u0441\u043b\u043e\u043c\u0430\u043b\u0430 \u0413\u0430\u043b\u0438\u043b\u0435\u044f
    \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440
    \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0438. \u041e\u043d \u0433\u043e\u0434\u0430\u043c\u0438
    \u043d\u0435 \u043c\u043e\u0433 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043e\u0442
    \u0433\u043e\u0440\u044f. 10. \u0415\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0438\u043b\u0438
    \u00ab\u043d\u0435 \u043f\u043e \u0447\u0438\u043d\u0443\u00bb \u0446\u0435\u043b\u044b\u0445
    95 \u043b\u0435\u0442 \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0443\u043c\u0435\u0440
    \u0432 1642 \u0433\u043e\u0434\u0443 \u043f\u043e\u0434 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u043c
    \u0430\u0440\u0435\u0441\u0442\u043e\u043c. \u0426\u0435\u0440\u043a\u043e\u0432\u044c \u0437\u0430\u043f\u0440\u0435\u0442\u0438\u043b\u0430
    \u0445\u043e\u0440\u043e\u043d\u0438\u0442\u044c \u0435\u0433\u043e \u0441 \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c\u0438
    \u0432 \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0431\u0430\u0437\u0438\u043b\u0438\u043a\u0435
    \u0424\u043b\u043e\u0440\u0435\u043d\u0446\u0438\u0438 (\u0421\u0430\u043d\u0442\u0430-\u041a\u0440\u043e\u0447\u0435)
    \u0440\u044f\u0434\u043e\u043c \u0441 \u041c\u0438\u043a\u0435\u043b\u0430\u043d\u0434\u0436\u0435\u043b\u043e.
    \u0415\u0433\u043e \u0442\u0435\u043b\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0441\u0443\u043d\u0443\u043b\u0438
    \u0432 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e \u0431\u043e\u043a\u043e\u0432\u0443\u044e
    \u043a\u043e\u043c\u043d\u0430\u0442\u043a\u0443. \u0422\u043e\u043b\u044c\u043a\u043e \u0432
    1737 \u0433\u043e\u0434\u0443 (\u0447\u0435\u0440\u0435\u0437 95 \u043b\u0435\u0442) \u0435\u0433\u043e
    \u043e\u0441\u0442\u0430\u043d\u043a\u0438 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u043b\u0438
    \u0432 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043c\u0430\u0432\u0437\u043e\u043b\u0435\u0439
    \u0431\u0430\u0437\u0438\u043b\u0438\u043a\u0438. \u0416\u0443\u0442\u043a\u0430\u044f \u0434\u0435\u0442\u0430\u043b\u044c:
    \u041f\u0440\u0438 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0435 \u043c\u043e\u0449\u0435\u0439
