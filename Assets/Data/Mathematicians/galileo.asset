    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430, \u043a\u0430\u0441\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0434\u0432\u0443\u0445 \u043d\u043e\u0432\u044b\u0445 \u043e\u0442\u0440\u0430\u0441\u043b\u0435\u0439
    \u043d\u0430\u0443\u043a\u0438\u00bb (1638), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
