    \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0431\u044b\u043b\u043e \u0437\u0430\u043c\u0435\u043d\u0435\u043d\u043e \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u043c
    \u0430\u0440\u0435\u0441\u0442\u043e\u043c \u043d\u0430 \u0432\u0438\u043b\u043b\u0435 \u0410\u0440\u0447\u0435\u0442\u0440\u0438,
    \u0431\u043b\u0438\u0437 \u0424\u043b\u043e\u0440\u0435\u043d\u0446\u0438\u0438. \u0415\u043c\u0443
    \u0431\u044b\u043b\u043e \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043e \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
