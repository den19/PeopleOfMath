  achievementsRu: "\u0413\u0430\u043b\u0438\u043b\u0435\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u2014
    \u0433\u0438\u0433\u0430\u043d\u0442 \u043d\u0430 \u043f\u043b\u0435\u0447\u0430\u0445 \u0433\u0438\u0433\u0430\u043d\u0442\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0432 \u043d\u0430\u0443\u043a\u0435, \u0430 \u0432 \u0441\u0430\u043c\u043e\u043c \u043c\u0435\u0442\u043e\u0434\u0435
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f \u043c\u0438\u0440\u0430. \u041e\u043d
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b \u0444\u0438\u0437\u0438\u043a\u0443
    \u0438\u0437 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439
    \u0432 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443 \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0439\u0448\u0438\u0439 \u043e\u0431\u0437\u043e\u0440
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u0440\u0430\u0437\u0431\u0438\u0442\u044b\u0439
    \u043f\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c.
    1. \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u043a\u0430
    (\u041a\u0438\u043d\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430)
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d
    \u043f\u043e\u0437\u0436\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0441\u0432\u043e\u0438
    \u0437\u0430\u043a\u043e\u043d\u044b. \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0435\u0433\u043e
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0437\u0434\u0435\u0441\u044c
    \u2014 \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043e\u0442 \u0443\u043c\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0430\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f.
    \u0417\u0430\u043a\u043e\u043d \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e
    \u043f\u0430\u0434\u0435\u043d\u0438\u044f. \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e
    (\u043a\u0430\u0442\u0430\u044f \u0448\u0430\u0440\u044b \u043f\u043e \u043d\u0430\u043a\u043b\u043e\u043d\u043d\u044b\u043c
    \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u044f\u043c, \u0447\u0442\u043e\u0431\u044b
    \u0437\u0430\u043c\u0435\u0434\u043b\u0438\u0442\u044c \u043f\u0430\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u044c \u0432\u0440\u0435\u043c\u044f)
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c
    \u043f\u0430\u0434\u0430\u044e\u0449\u0435\u0433\u043e \u0442\u0435\u043b\u0430 \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0430\u0434\u0435\u043d\u0438\u044f, \u0430
    \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u043d\u044b\u0439 \u043f\u0443\u0442\u044c \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    (\\( s \\propto t^2 \\)). \u0421\u0430\u043c\u043e\u0435 \u0432\u0430\u0436\u043d\u043e\u0435:
    \u043e\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b, \u0447\u0442\u043e
    \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e
    \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043e\u0442 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 (\u0432 \u0432\u0430\u043a\u0443\u0443\u043c\u0435
    \u043f\u0435\u0440\u043e \u0438 \u043f\u0443\u043b\u044f \u0443\u043f\u0430\u0434\u0443\u0442
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e), \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0432
    \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044f, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0432\u0448\u0435\u0433\u043e,
    \u0447\u0442\u043e \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0442\u0435\u043b\u0430 \u043f\u0430\u0434\u0430\u044e\u0442
    \u0431\u044b\u0441\u0442\u0440\u0435\u0435. \u0414\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u043f\u043e \u0438\u043d\u0435\u0440\u0446\u0438\u0438 (\u0417\u0430\u043a\u043e\u043d
    \u0438\u043d\u0435\u0440\u0446\u0438\u0438). \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u043e\u0442\u043a\u0440\u044b\u043b \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0435\u0441\u043b\u0438 \u0442\u0435\u043b\u043e \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f
    \u043f\u043e \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0433\u043b\u0430\u0434\u043a\u043e\u0439
    \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438
    \u0438 \u043d\u0430 \u043d\u0435\u0433\u043e \u043d\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442
    \u0441\u0438\u043b\u044b (\u0442\u0440\u0435\u043d\u0438\u0435), \u043e\u043d\u043e \u0431\u0443\u0434\u0435\u0442
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0434\u0432\u0438\u0433\u0430\u0442\u044c\u0441\u044f
    \u0432\u0435\u0447\u043d\u043e \u0441 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439
    \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e. \u041f\u043e \u0441\u0443\u0442\u0438,
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0438\u043d\u0435\u0440\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043e\u0442\u0441\u0447\u0435\u0442\u0430 \u0438
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435
    \u043f\u043e\u043a\u043e\u044f \u0438 \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u0440\u0430\u0437\u043b\u0438\u0447\u0438\u043c\u044b. \u0411\u0430\u043b\u043b\u0438\u0441\u0442\u0438\u043a\u0430
    (\u0414\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0441\u043d\u0430\u0440\u044f\u0434\u043e\u0432).
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043e\u0442\u043a\u0440\u044b\u043b, \u0447\u0442\u043e
    \u0442\u0435\u043b\u043e, \u0431\u0440\u043e\u0448\u0435\u043d\u043d\u043e\u0435 \u043f\u043e\u0434
    \u0443\u0433\u043b\u043e\u043c \u043a \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0443,
    \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f \u043f\u043e \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u0435.
    \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u044d\u0442\u043e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u043b\u043e\u0436\u0438\u0442\u044c
    \u043d\u0430 \u0434\u0432\u0430 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445:
    \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0435 \u043f\u043e \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u0438
    \u0438 \u0440\u0430\u0432\u043d\u043e\u0443\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u043e\u0435
    \u043f\u043e \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u0438. \u042d\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u0430\u0440\u0442\u0438\u043b\u043b\u0435\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u0434\u0435\u043b\u0430 \u0438 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.
    \u0421\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432.
    \u0412 \u0442\u0440\u0443\u0434\u0435 \u00ab\u0411\u0435\u0441\u0435\u0434\u044b...\u00bb
    \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u043d\u0430\u0443\u043a\u0438 \u043e \u043f\u0440\u043e\u0447\u043d\u043e\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432, \u0432\u044b\u0432\u0435\u0434\u044f
    \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0447\u043d\u043e\u0441\u0442\u0438
    \u0431\u0430\u043b\u043a\u0438 \u043e\u0442 \u0435\u0435 \u043f\u043e\u043f\u0435\u0440\u0435\u0447\u043d\u043e\u0433\u043e
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u0434\u043b\u0438\u043d\u044b. 2. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f
    (\u0422\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f) \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u043d\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f,
    \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0434\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430
    \u043d\u0430\u0443\u043a\u0438 (\u0441 3-\u043a\u0440\u0430\u0442\u043d\u044b\u043c \u0434\u043e
    32-\u043a\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044f)
    \u0438 \u043f\u0435\u0440\u0432\u044b\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u043b
    \u0435\u0433\u043e \u043d\u0430 \u043d\u0435\u0431\u043e \u0432 1609\u20131610 \u0433\u043e\u0434\u0430\u0445.
    \u0417\u0430 \u043e\u0434\u0438\u043d \u0433\u043e\u0434 \u043e\u043d \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043b
    \u0430\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u043a\u0430\u0440\u0442\u0438\u043d\u0443 \u043c\u0438\u0440\u0430: \u041b\u0443\u043d\u0430.
    \u041e\u043d \u0443\u0432\u0438\u0434\u0435\u043b, \u0447\u0442\u043e \u041b\u0443\u043d\u0430
    \u0433\u043e\u0440\u0438\u0441\u0442\u0430, \u043f\u043e\u043a\u0440\u044b\u0442\u0430 \u043a\u0440\u0430\u0442\u0435\u0440\u0430\u043c\u0438
    \u0438 \u00ab\u043c\u043e\u0440\u044f\u043c\u0438\u00bb. \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e,
    \u0447\u0442\u043e \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0435 \u0442\u0435\u043b\u0430
    \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u00ab\u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0441\u0444\u0435\u0440\u0430\u043c\u0438\u00bb,
    \u0430 \u0438\u043c\u0435\u044e\u0442 \u0437\u0435\u043c\u043d\u0443\u044e \u043f\u0440\u0438\u0440\u043e\u0434\u0443.
    \u0421\u043f\u0443\u0442\u043d\u0438\u043a\u0438 \u042e\u043f\u0438\u0442\u0435\u0440\u0430
    (\u041c\u0435\u0434\u0438\u0446\u0435\u0439\u0441\u043a\u0438\u0435 \u0437\u0432\u0435\u0437\u0434\u044b).
    \u041e\u0442\u043a\u0440\u044b\u043b 4 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445
    \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0430 (\u0418\u043e, \u0415\u0432\u0440\u043e\u043f\u0430,
    \u0413\u0430\u043d\u0438\u043c\u0435\u0434, \u041a\u0430\u043b\u043b\u0438\u0441\u0442\u043e).
    \u042d\u0442\u043e \u0431\u044b\u043b \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u0439 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442
    \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0437\u043c\u0430:
    \u0435\u0441\u043b\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u042e\u043f\u0438\u0442\u0435\u0440\u0430
    \u0432\u0440\u0430\u0449\u0430\u044e\u0442\u0441\u044f \u0442\u0435\u043b\u0430, \u0437\u043d\u0430\u0447\u0438\u0442,
    \u0417\u0435\u043c\u043b\u044f \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0446\u0435\u043d\u0442\u0440\u043e\u043c
    \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0432\u043e \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439.
    \u0424\u0430\u0437\u044b \u0412\u0435\u043d\u0435\u0440\u044b. \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u043e\u0442\u043a\u0440\u044b\u043b, \u0447\u0442\u043e \u0412\u0435\u043d\u0435\u0440\u0430
    \u0441\u043c\u0435\u043d\u044f\u0435\u0442 \u0441\u0432\u043e\u0438 \u0444\u0430\u0437\u044b
    \u043e\u0442 \u0443\u0437\u043a\u043e\u0433\u043e \u0441\u0435\u0440\u043f\u0430 \u0434\u043e
    \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u0434\u0438\u0441\u043a\u0430 (\u043a\u0430\u043a
    \u041b\u0443\u043d\u0430). \u0412 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f
    \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c,
    \u0430 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430
    \u2014 \u043b\u0435\u0433\u043a\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043c\u044b\u043c.
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u0430\u043c\u044b\u043c \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0412\u0435\u043d\u0435\u0440\u0430 \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0421\u043e\u043b\u043d\u0446\u0430, \u0430 \u043d\u0435
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0417\u0435\u043c\u043b\u0438. \u0421\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0435
    \u043f\u044f\u0442\u043d\u0430. \u041d\u0430\u0431\u043b\u044e\u0434\u0430\u044f \u0437\u0430
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u043f\u044f\u0442\u0435\u043d, \u043e\u043d
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0421\u043e\u043b\u043d\u0446\u0435
    \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432\u043e\u043a\u0440\u0443\u0433
    \u0441\u0432\u043e\u0435\u0439 \u043e\u0441\u0438. \u0422\u0430\u043a\u0436\u0435 \u043e\u043d
    \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043f\u044f\u0442\u043d\u0430 \u0438\u043c\u0435\u044e\u0442
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u0440\u0438\u0440\u043e\u0434\u0443,
    \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0432 \u043c\u043d\u0435\u043d\u0438\u0435
    \u043e \u00ab\u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438\u00bb
    \u043d\u0435\u0431\u0435\u0441. \u0417\u0432\u0435\u0437\u0434\u043d\u043e\u0435 \u043d\u0435\u0431\u043e.
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0443\u0432\u0438\u0434\u0435\u043b, \u0447\u0442\u043e
    \u041c\u043b\u0435\u0447\u043d\u044b\u0439 \u041f\u0443\u0442\u044c \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u00ab\u043c\u043e\u043b\u043e\u0447\u043d\u0430\u044f \u0440\u0435\u043a\u0430\u00bb,
    \u0430 \u0441\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u0431\u0435\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0441\u043b\u0430\u0431\u044b\u0445
    \u0437\u0432\u0435\u0437\u0434. 3. \u041c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f
    \u043d\u0430\u0443\u043a\u0438 (\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434)
    \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432\u0430\u0436\u043d\u0435\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u0431\u044b\u043b\u043e \u0442\u043e,
    \u043a\u0430\u043a \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0438\u0445 \u0441\u0434\u0435\u043b\u0430\u043b.
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0442\u0446\u043e\u043c
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438. \u0418\u0434\u0435\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 (\u041c\u044b\u0441\u043b\u0435\u043d\u043d\u044b\u0439
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442). \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u043c\u0435\u0442\u043e\u0434 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432 \u0442\u0443 \u044d\u043f\u043e\u0445\u0443, \u043d\u043e \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u043e\u0441\u0442\u044c \u0441\u0442\u0430\u0440\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044b\u0439
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 \u043e \u0434\u0432\u0443\u0445
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u043a\u0430\u043c\u043d\u044f\u0445,
    \u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0445 \u0441 \u0440\u0430\u0437\u043d\u043e\u0439
    \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e, \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u0442\u0435\u043b\u0430 \u0434\u043e\u043b\u0436\u043d\u044b
    \u043f\u0430\u0434\u0430\u0442\u044c \u0441 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u043c
    \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435\u043c. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f
    \u0444\u0438\u0437\u0438\u043a\u0438. \u041e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u043f\u0440\u0438\u043d\u0446\u0438\u043f:
    \u00ab\u041a\u043d\u0438\u0433\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u044b \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0430
    \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb.
    \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b
    \u044f\u0432\u043b\u0435\u043d\u0438\u044f, \u0430 \u0438\u0437\u043c\u0435\u0440\u044f\u043b
    \u0438\u0445 (\u0432\u0440\u0435\u043c\u044f, \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435,
    \u0443\u0433\u043e\u043b) \u0438 \u0432\u044b\u0432\u043e\u0434\u0438\u043b \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0437\u0430\u043a\u043e\u043d\u044b, \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u043c\u044b\u0435
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438. \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f. \u0421\u0442\u0440\u043e\u0433\u0430\u044f \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430:
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u043a\u043e\u043d\u044b
    \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b \u0432\u043e \u0432\u0441\u0435\u0445
    \u0438\u043d\u0435\u0440\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445
    \u043e\u0442\u0441\u0447\u0435\u0442\u0430. \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043d\u0438 \u043e\u0434\u0438\u043d \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 (\u0431\u0440\u043e\u0441\u0430\u043d\u0438\u0435
    \u043c\u044f\u0447\u0430, \u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430)
    \u0432\u043d\u0443\u0442\u0440\u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u043e\u0433\u043e
    \u043a\u043e\u0440\u0430\u0431\u043b\u044f, \u0434\u0432\u0438\u0436\u0443\u0449\u0435\u0433\u043e\u0441\u044f
    \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e, \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442
    \u0432\u0430\u043c \u0443\u0437\u043d\u0430\u0442\u044c, \u0441\u0442\u043e\u0438\u0442\u0435
    \u043b\u0438 \u0432\u044b \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u0438\u043b\u0438
    \u043f\u043b\u044b\u0432\u0435\u0442\u0435. 4. \u0414\u0440\u0443\u0433\u0438\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f
    \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b (\u041a\u043e\u0441\u0432\u0435\u043d\u043d\u044b\u0435
    \u0432\u043a\u043b\u0430\u0434\u044b) \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043d\u0435
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0441\u044f \u0442\u0435\u043e\u0440\u0438\u0435\u0439,
    \u043e\u043d \u0431\u044b\u043b \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u043c
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c: \u0413\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u0435\u0441\u044b. \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u044b \u0432
    1586 \u0433\u043e\u0434\u0443 \u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u0438 \u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u0430
    \u043c\u0435\u0442\u0430\u043b\u043b\u043e\u0432. \u0422\u0435\u0440\u043c\u043e\u0441\u043a\u043e\u043f
    (\u041f\u0440\u043e\u043e\u0431\u0440\u0430\u0437 \u0442\u0435\u0440\u043c\u043e\u043c\u0435\u0442\u0440\u0430).
    \u041e\u043a\u043e\u043b\u043e 1593 \u0433\u043e\u0434\u0430 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043f\u0440\u0438\u0431\u043e\u0440, \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439
    \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b
    \u0432\u043e\u0437\u0434\u0443\u0445\u0430 (\u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435
    \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u0433\u0430\u0437\u0430).
    \u041c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f. \u041e\u043d \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u043d\u0430\u0441\u0435\u043a\u043e\u043c\u044b\u0445.
    \u0426\u0438\u0440\u043a\u0443\u043b\u044c. \u0418\u0437\u043e\u0431\u0440\u0435\u043b \u0432\u043e\u0435\u043d\u043d\u044b\u0439
    \u0446\u0438\u0440\u043a\u0443\u043b\u044c-\u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b
    \u0434\u043b\u044f \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043a\u043e\u0440\u043d\u0435\u0439 \u0438 \u043f\u043b\u043e\u0449\u0430\u0434\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u043b\u0441\u044f
    \u043a\u0430\u043a \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u0432
    \u0438 \u0430\u0440\u0442\u0438\u043b\u043b\u0435\u0440\u0438\u0441\u0442\u043e\u0432. 5.
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u0438 \u0431\u043e\u0440\u044c\u0431\u0430 \u0437\u0430 \u0441\u0432\u043e\u0431\u043e\u0434\u0443
    \u043d\u0430\u0443\u043a\u0438 \u0425\u043e\u0442\u044f \u044d\u0442\u043e \u0438 \u043d\u0435
    \u0444\u0438\u0437\u0438\u043a\u0430, \u0435\u0433\u043e \u044d\u043f\u0438\u0441\u0442\u043e\u043b\u044f\u0440\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0438 \u0437\u0430\u0449\u0438\u0442\u0430
    \u0433\u0435\u043b\u0438\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0437\u043c\u0430 \u0438\u043c\u0435\u044e\u0442
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u0442\u043e\u043b\u043a\u043e\u0432\u0430\u043d\u0438\u044f
    \u041f\u0438\u0441\u0430\u043d\u0438\u044f. \u0412 \u043f\u0438\u0441\u044c\u043c\u0430\u0445
    \u043a \u041a\u0430\u0441\u0442\u0435\u043b\u043b\u0438 \u0438 \u0434\u2019\u042d\u0441\u0442\u0438
    \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0442\u0435\u0437\u0438\u0441: \u0421\u0432\u044f\u0449\u0435\u043d\u043d\u043e\u0435 \u041f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0443\u0447\u0438\u0442, \u043a\u0430\u043a \u043f\u043e\u043f\u0430\u0441\u0442\u044c
    \u043d\u0430 \u043d\u0435\u0431\u043e, \u043d\u043e \u043d\u0435 \u0442\u043e\u043c\u0443,
    \u043a\u0430\u043a \u0443\u0441\u0442\u0440\u043e\u0435\u043d\u043e \u043d\u0435\u0431\u043e.
    \u041e\u043d \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b, \u0447\u0442\u043e
    \u0442\u0430\u043c, \u0433\u0434\u0435 \u0411\u0438\u0431\u043b\u0438\u044f \u0432\u0441\u0442\u0443\u043f\u0430\u0435\u0442
    \u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0435 \u0441 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u044b\u043c\u0438
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438 \u0444\u0430\u043a\u0442\u0430\u043c\u0438,
    \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c
    \u0430\u043b\u043b\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0442\u043e\u043b\u043a\u043e\u0432\u0430\u043d\u0438\u0435.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u043e\u0439 \u0434\u043b\u044f \u0434\u0438\u0430\u043b\u043e\u0433\u0430
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u0438. --- \u041a\u0440\u0430\u0442\u043a\u0438\u0439
    \u0438\u0442\u043e\u0433: \u0427\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u043b
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439? \u0414\u043b\u044f \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u0430
    \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0438\u043c \u0435\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u00ab\u0447\u0435\u043c\u043f\u0438\u043e\u043d\u0441\u043a\u0438\u0435\u00bb \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u043f\u0438\u0441\u043a\u0430: 1. \u0418\u043d\u0435\u0440\u0446\u0438\u044f:
    \u0422\u0435\u043b\u043e \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e,
    \u0435\u0441\u043b\u0438 \u043d\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0430
    \u0441\u0438\u043b\u0430. 2. \u0420\u0430\u0432\u043d\u043e\u0443\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u043e\u0435
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435: \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c
    \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u0442\u0435\u0442 \u043b\u0438\u043d\u0435\u0439\u043d\u043e,
    \u043f\u0443\u0442\u044c \u2014 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u043e.
    3. \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439:
    \u0413\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0438
    \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0435
    \u043f\u043e\u043b\u0435\u0442\u0430 \u0441\u043d\u0430\u0440\u044f\u0434\u0430 \u043d\u0435
    \u0432\u043b\u0438\u044f\u044e\u0442 \u0434\u0440\u0443\u0433 \u043d\u0430 \u0434\u0440\u0443\u0433\u0430.
    4. \u0413\u043e\u0440\u044b \u043d\u0430 \u041b\u0443\u043d\u0435: \u041d\u0435\u0431\u0435\u0441\u0430
    \u043d\u0435\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b. 5. \u0421\u043f\u0443\u0442\u043d\u0438\u043a\u0438
    \u042e\u043f\u0438\u0442\u0435\u0440\u0430: \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442
    \u0446\u0435\u043d\u0442\u0440\u044b \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u0435
    \u043e\u0442 \u0417\u0435\u043c\u043b\u0438. 6. \u0424\u0430\u0437\u044b \u0412\u0435\u043d\u0435\u0440\u044b:
    \u0412\u0435\u043d\u0435\u0440\u0430 \u0442\u043e\u0447\u043d\u043e \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0421\u043e\u043b\u043d\u0446\u0430. 7. \u0412\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0421\u043e\u043b\u043d\u0446\u0430: \u0414\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u043f\u044f\u0442\u043d\u0430\u043c\u0438.
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0438\u0442\u043e\u0433: \u0414\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 \u0431\u044b\u043b\u0430 \u0432\u0435\u0442\u0432\u044c\u044e
    \u043d\u0430\u0442\u0443\u0440\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438. \u041f\u043e\u0441\u043b\u0435
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u043e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u043e\u0439, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u043d\u0430 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438, \u0440\u0430\u0441\u0447\u0435\u0442\u0435
    \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0435 \u0433\u0438\u043f\u043e\u0442\u0435\u0437.
    \u0411\u0435\u0437 \u0435\u0433\u043e \u00ab\u0411\u0435\u0441\u0435\u0434\u00bb \u043d\u0435
    \u0431\u044b\u043b\u043e \u0431\u044b \u0437\u0430\u043a\u043e\u043d\u043e\u0432 \u041d\u044c\u044e\u0442\u043e\u043d\u0430,
    \u0430 \u0431\u0435\u0437 \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u044b \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 (\u043a\u043e\u0442\u043e\u0440\u0430\u044f,
    \u043a\u0441\u0442\u0430\u0442\u0438, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u044b\u043c
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0435\u0433\u043e \u0436\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430)."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0413\u0430\u043b\u0438\u043b\u0435\u043e
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f,
    \u043f\u043e\u043b\u043d\u0430\u044f \u044f\u0440\u043a\u0438\u0445 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0430 \u0444\u043e\u043d\u0435 \u0435\u0433\u043e \u0433\u0440\u043e\u043c\u043a\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0438 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0441 \u0446\u0435\u0440\u043a\u043e\u0432\u044c\u044e.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0430
    \u043a\u0430\u043a \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u043e\u0436\u043d\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c,
    \u0442\u0430\u043a \u0438 \u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u043d\u043e\u0440\u043c\u0430\u043c\u0438 \u0418\u0442\u0430\u043b\u0438\u0438 XVII \u0432\u0435\u043a\u0430.
    \u0421\u0435\u043c\u044c\u044f \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432
    \u0441\u0435\u043c\u044c\u0435 \u043e\u0431\u0435\u0434\u043d\u0435\u0432\u0448\u0438\u0445
    \u0434\u0432\u043e\u0440\u044f\u043d. \u0415\u0433\u043e \u043e\u0442\u0446\u043e\u043c
    \u0431\u044b\u043b \u0412\u0438\u043d\u0447\u0435\u043d\u0446\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u0439,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442,
    \u043b\u044e\u0442\u043d\u0438\u0441\u0442 \u0438 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a
    \u043c\u0443\u0437\u044b\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043a\u0430\u0437\u0430\u043b
    \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430
    \u0440\u0430\u043d\u043d\u0435\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0441\u044b\u043d\u0430.
    \u0412 \u0441\u0435\u043c\u044c\u0435 \u0412\u0438\u043d\u0447\u0435\u043d\u0446\u043e \u0438
    \u0414\u0436\u0443\u043b\u0438\u0438 \u0410\u043c\u043c\u0430\u043d\u043d\u0430\u0442\u0438
    \u0431\u044b\u043b\u043e \u0448\u0435\u0441\u0442\u0435\u0440\u043e \u0434\u0435\u0442\u0435\u0439,
    \u043d\u043e \u0432\u044b\u0436\u0438\u0442\u044c \u0443\u0434\u0430\u043b\u043e\u0441\u044c
    \u0447\u0435\u0442\u0432\u0435\u0440\u044b\u043c. \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0431\u044b\u043b \u0441\u0442\u0430\u0440\u0448\u0438\u043c \u0438\u0437 \u043d\u0438\u0445,
    \u0443 \u043d\u0435\u0433\u043e \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b\u0438
    \u0441\u0435\u0441\u0442\u0440\u044b \u0412\u0438\u0440\u0434\u0436\u0438\u043d\u0438\u044f
    \u0438 \u041b\u0438\u0432\u0438\u044f \u0438 \u043c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0431\u0440\u0430\u0442 \u041c\u0438\u043a\u0435\u043b\u0430\u043d\u0434\u0436\u0435\u043b\u043e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0448\u0435\u043b \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c
    \u043e\u0442\u0446\u0430 \u0438 \u0441\u0442\u0430\u043b \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u043e\u043c-\u043b\u044e\u0442\u043d\u0438\u0441\u0442\u043e\u043c.
    \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430
    \u0432 1591 \u0433\u043e\u0434\u0443 \u043d\u0430 \u0413\u0430\u043b\u0438\u043b\u0435\u044f,
    \u043a\u0430\u043a \u043d\u0430 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0432
    \u0440\u043e\u0434\u0443, \u043b\u0435\u0433\u043b\u0430 \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c
    \u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043e \u0441\u0435\u043c\u044c\u0435,
    \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0442\u044c
    \u043f\u0440\u0438\u0434\u0430\u043d\u043e\u0435 \u0434\u043b\u044f \u0441\u0435\u0441\u0442\u0435\u0440,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u043c
    \u0431\u0440\u0435\u043c\u0435\u043d\u0435\u043c. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u041c\u0430\u0440\u0438\u043d\u043e\u0439 \u0413\u0430\u043c\u0431\u0430 \u0438
    \u0434\u0435\u0442\u0438 \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442, \u043e\u0434\u043d\u0430\u043a\u043e
    \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0438 \u0434\u043e\u043b\u0433\u0438\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u041c\u0430\u0440\u0438\u043d\u043e\u0439
    \u0413\u0430\u043c\u0431\u0430 (Marina Gamba) \u2014 \u0432\u0435\u043d\u0435\u0446\u0438\u0430\u043d\u043a\u043e\u0439,
    \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u044f
    \u0432 \u041f\u0430\u0434\u0443\u0435. \u042d\u0442\u043e\u0442 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u0438\u0439
    \u0441\u043e\u044e\u0437 \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0441\u044f \u043e\u043a\u043e\u043b\u043e
    \u0434\u0435\u0441\u044f\u0442\u0438 \u043b\u0435\u0442. \u0412 \u044d\u0442\u0438\u0445
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445 \u0443 \u0413\u0430\u043b\u0438\u043b\u0435\u044f
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439,
    \u043f\u0440\u0438\u0447\u0435\u043c \u0432\u0441\u0435 \u043e\u043d\u0438 \u0431\u044b\u043b\u0438
    \u0440\u043e\u0436\u0434\u0435\u043d\u044b \u0432\u043d\u0435 \u0431\u0440\u0430\u043a\u0430:
    \u0412\u0438\u0440\u0434\u0436\u0438\u043d\u0438\u044f (Virginia) (\u0440\u043e\u0434. 1600)
    \u2014 \u0441\u0442\u0430\u0440\u0448\u0430\u044f \u0434\u043e\u0447\u044c \u0438 \u043b\u044e\u0431\u0438\u043c\u0438\u0446\u0430
    \u043e\u0442\u0446\u0430. \u041b\u0438\u0432\u0438\u044f (Livia) (\u0440\u043e\u0434. 1601)
    \u2014 \u0432\u0442\u043e\u0440\u0430\u044f \u0434\u043e\u0447\u044c. \u0412\u0438\u043d\u0447\u0435\u043d\u0446\u043e
    (Vincenzo) (\u0440\u043e\u0434. 1606) \u2014 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0441\u044b\u043d, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0439 \u0432 \u0447\u0435\u0441\u0442\u044c
    \u0434\u0435\u0434\u0430. \u041b\u0438\u0448\u044c \u0432 1619 \u0433\u043e\u0434\u0443
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043b \u0438 \u0443\u0437\u0430\u043a\u043e\u043d\u0438\u043b
    \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u044b\u043d\u0430 \u0412\u0438\u043d\u0447\u0435\u043d\u0446\u043e,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0442\u043e\u043c\u0443
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f
    \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0440\u043e\u0434.
    \u0421\u0443\u0434\u044c\u0431\u0430 \u0434\u043e\u0447\u0435\u0440\u0435\u0439: \u043f\u043e\u0441\u0442\u0440\u0438\u0433
    \u0432 \u043c\u043e\u043d\u0430\u0445\u0438\u043d\u0438 \u0421\u0443\u0434\u044c\u0431\u0430
    \u0434\u043e\u0447\u0435\u0440\u0435\u0439 \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u0441\u043b\u043e\u0436\u0438\u043b\u0430\u0441\u044c
    \u0438\u043d\u0430\u0447\u0435. \u0418\u0437-\u0437\u0430 \u0438\u0445 \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u043e\u0433\u043e
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043e\u043d\u0438 \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c \u043d\u0435\u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u043c\u0438
    \u0434\u043b\u044f \u0432\u044b\u0433\u043e\u0434\u043d\u043e\u0433\u043e \u0437\u0430\u043c\u0443\u0436\u0435\u0441\u0442\u0432\u0430,
    \u0430 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u0438\u0445 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u043c
    \u043f\u0440\u0438\u0434\u0430\u043d\u044b\u043c \u0431\u044b\u043b\u043e \u0434\u043b\u044f
    \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u043d\u0435\u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0440\u043e\u0441\u043a\u043e\u0448\u044c\u044e, \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f
    \u0435\u0433\u043e \u0438 \u0431\u0435\u0437 \u0442\u043e\u0433\u043e \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043f\u0435\u0440\u0435\u0434 \u0441\u0435\u0441\u0442\u0440\u0430\u043c\u0438. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043f\u0440\u0438\u0435\u043c\u043b\u0435\u043c\u044b\u043c \u0432\u044b\u0445\u043e\u0434\u043e\u043c
    \u0434\u043b\u044f \u0434\u0435\u0432\u0443\u0448\u0435\u043a \u0438\u0437 \u0442\u0430\u043a\u043e\u0439
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0431\u044b\u043b\u0430 \u043c\u043e\u043d\u0430\u0448\u0435\u0441\u043a\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c. \u041e\u0431\u0435 \u0434\u043e\u0447\u0435\u0440\u0438
    \u0431\u044b\u043b\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u044b \u0432
    \u0431\u0435\u0434\u043d\u044b\u0439 \u0444\u0440\u0430\u043d\u0446\u0438\u0441\u043a\u0430\u043d\u0441\u043a\u0438\u0439
    \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u044c \u0421\u0430\u043d-\u041c\u0430\u0442\u0442\u0435\u043e
    \u0432 \u0410\u0440\u0447\u0435\u0442\u0440\u0438, \u0433\u0434\u0435 \u043f\u0440\u043e\u0432\u0435\u043b\u0438
    \u0432\u0441\u044e \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c. \u0412\u0438\u0440\u0434\u0436\u0438\u043d\u0438\u044f,
    \u043f\u0440\u0438\u043d\u044f\u0432\u0448\u0430\u044f \u0438\u043c\u044f \u041c\u0430\u0440\u0438\u044f
    \u0427\u0435\u043b\u0435\u0441\u0442\u0430 (Suor Maria Celeste), \u0431\u044b\u043b\u0430,
    \u043f\u043e \u0432\u0441\u0435\u0439 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438,
    \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043e\u0434\u0430\u0440\u0435\u043d\u043d\u043e\u0439
    \u0438\u0437 \u0434\u0435\u0442\u0435\u0439 \u0413\u0430\u043b\u0438\u043b\u0435\u044f.
    \u041e\u043d\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0430
    \u0441 \u043e\u0442\u0446\u043e\u043c \u0442\u0435\u043f\u043b\u044b\u0435 \u0438 \u0431\u043b\u0438\u0437\u043a\u0438\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u0447\u0442\u043e \u0445\u043e\u0440\u043e\u0448\u043e
    \u0432\u0438\u0434\u043d\u043e \u043f\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0435\u0439\u0441\u044f
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435: \u0438\u0437 124 \u043f\u0438\u0441\u0435\u043c,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445 \u0435\u044e \u043e\u0442\u0446\u0443,
    \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0435\u0442 \u0437\u0430\u0431\u043e\u0442\u043b\u0438\u0432\u044b\u043c
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u043f\u043e\u0441\u044b\u043b\u0430\u043b
    \u0435\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b, \u0446\u0432\u0435\u0442\u044b
    \u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u043f\u043e \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0443
    \u0432 \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0447\u0438\u043d\u0438\u043b \u0447\u0430\u0441\u044b \u0438 \u043e\u043a\u043d\u0430).
    \u041e\u043d\u0430, \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c,
    \u0448\u0438\u043b\u0430 \u0435\u043c\u0443 \u043e\u0434\u0435\u0436\u0434\u0443 \u0438
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b.
    \u041f\u0438\u0441\u044c\u043c\u0430 \u0441\u0430\u043c\u043e\u0433\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u044f,
    \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0431\u044b\u043b\u0438
    \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u044b \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435\u043c
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0443\u0434\u0430 \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0438
    1633 \u0433\u043e\u0434\u0430. \u0412\u0438\u0440\u0434\u0436\u0438\u043d\u0438\u044f-\u041c\u0430\u0440\u0438\u044f
    \u0427\u0435\u043b\u0435\u0441\u0442\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 1634 \u0433\u043e\u0434\u0443, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u0443\u0434\u0430\u0440\u043e\u043c \u0434\u043b\u044f
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e. \u0412\u0442\u043e\u0440\u0430\u044f \u0434\u043e\u0447\u044c,
    \u041b\u0438\u0432\u0438\u044f, \u0432 \u043c\u043e\u043d\u0430\u0448\u0435\u0441\u0442\u0432\u0435
    \u0410\u0440\u043a\u0430\u043d\u0434\u0436\u0435\u043b\u0430 (Suor Arcangela), \u0431\u044b\u043b\u0430
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0434\u0440\u0443\u0433\u0438\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c. \u0418\u0437 \u043f\u0438\u0441\u0435\u043c
    \u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u043d\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0435\u0442
    \u043a\u0430\u043a \u0441\u043b\u043e\u0436\u043d\u0430\u044f, \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u0430\u044f,
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0442\u0440\u0430\u0434\u0430\u044e\u0449\u0430\u044f
    \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0435\u0439 \u0438 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c\u043e\u043c
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0430 \u0441
    \u043e\u0442\u0446\u043e\u043c \u0442\u0435\u0441\u043d\u044b\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439.
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0441\u044b\u043d\u043e\u043c \u0412 1629 \u0433\u043e\u0434\u0443 \u0435\u0433\u043e
