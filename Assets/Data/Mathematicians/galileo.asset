    \u0436\u0438\u043b\u0438 \u0435\u0433\u043e \u0434\u043e\u0447\u0435\u0440\u0438."
  personalLifeEn: 
  shortBioRu: "\u0413\u0430\u043b\u0438\u043b\u0435\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u2014
    \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0434\u0438\u043d
    \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u043c\u0435\u0436\u0434\u0443 \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u0435\u043c \u0438 \u0434\u043e\u0433\u043c\u0430\u0442\u0438\u0437\u043c\u043e\u043c.
    \u0415\u0433\u043e \u043f\u0443\u0442\u044c \u2014 \u043e\u0442 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u0434\u043e \u0441\u0443\u0434\u0430 \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0438
    \u0438 \u043e\u0442\u0440\u0435\u0447\u0435\u043d\u0438\u044f, \u2014 \u044d\u0442\u043e
    \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0430\u044e\u0442\u0441\u044f
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e
    \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u0435\u0433\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f.
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    (1564\u20131585) \u0413\u0430\u043b\u0438\u043b\u0435\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 15 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1564 \u0433\u043e\u0434\u0430 \u0432 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435 \u041f\u0438\u0437\u0430, \u0432 \u0437\u043d\u0430\u0442\u043d\u043e\u0439,
    \u043d\u043e \u043e\u0431\u0435\u0434\u043d\u0435\u0432\u0448\u0435\u0439 \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0412\u0438\u043d\u0447\u0435\u043d\u0446\u043e
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439, \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u043e\u043c \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d \u043e\u043a\u0430\u0437\u0430\u043b
    \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430
    \u0440\u0430\u043d\u043d\u0435\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0441\u044b\u043d\u0430.
    \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u0439
