    \u0412\u0430\u043b\u043b\u043e\u043c\u0431\u0440\u043e\u0437\u0430, \u0433\u0434\u0435 \u043e\u043d
    \u0434\u0430\u0436\u0435 \u0441\u0442\u0430\u043b \u043f\u043e\u0441\u043b\u0443\u0448\u043d\u0438\u043a\u043e\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u043d\u0438\u044e
    \u043e\u0442\u0446\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b
    \u043f\u0440\u043e\u0442\u0438\u0432 \u043c\u043e\u043d\u0430\u0448\u0435\u0441\u043a\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0441\u044b\u043d\u0430, \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u044c.
    \u0421\u043b\u0435\u0434\u0443\u044f \u0432\u043e\u043b\u0435 \u043e\u0442\u0446\u0430,
    \u0432 1581 \u0433\u043e\u0434\u0443 \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041f\u0438\u0437\u0430\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e \u0441\u0442\u0430\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430. \u041e\u043d \u0443\u0432\u043b\u0435\u043a\u0441\u044f
    \u0447\u0442\u0435\u043d\u0438\u0435\u043c \u0442\u0440\u0443\u0434\u043e\u0432 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u0438 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
