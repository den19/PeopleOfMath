    \u0410\u0431\u0443-\u043b\u044c-\u0424\u0430\u0442\u0445 \u041e\u043c\u0430\u0440 \u0438\u0431\u043d
    \u0418\u0431\u0440\u0430\u0445\u0438\u043c \u041d\u0438\u0448\u0430\u043f\u0443\u0440\u0438,
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 18 \u043c\u0430\u044f 1048 \u0433\u043e\u0434\u0430
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041d\u0438\u0448\u0430\u043f\u0443\u0440 (\u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u0425\u043e\u0440\u0430\u0441\u0430\u043d, \u043d\u0430 \u0441\u0435\u0432\u0435\u0440\u043e-\u0432\u043e\u0441\u0442\u043e\u043a\u0435
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0418\u0440\u0430\u043d\u0430).
    \u0415\u0433\u043e \u0444\u0430\u043c\u0438\u043b\u0438\u044f, \u0425\u0430\u0439\u044f\u043c,
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043e\u0442 \u0441\u043b\u043e\u0432\u0430
    `\u0445\u0430\u0439\u043c\u0430` \u2014 \u043f\u0430\u043b\u0430\u0442\u043a\u0430, \u0438,
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0430
    \u043d\u0430 \u0440\u0435\u043c\u0435\u0441\u043b\u043e \u0435\u0433\u043e \u043e\u0442\u0446\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043c
    \u043f\u043e \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044e \u043f\u0430\u043b\u0430\u0442\u043e\u043a.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u043e, \u0441\u0435\u043c\u044c\u044f
    \u0431\u044b\u043b\u0430 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0430,
