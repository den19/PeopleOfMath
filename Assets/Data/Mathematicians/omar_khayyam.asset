    \u0438 \u043d\u043e\u0432\u043e\u0439 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u043e\u0439, \u0430 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
