    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u043e\u044d\u0437\u0438\u0438.\n\n\U0001F4DC
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0432\u0435\u0445\u0438 \u0436\u0438\u0437\u043d\u0438:
    \u043e\u0442 \u043f\u0430\u043b\u0430\u0442\u043e\u0447\u043d\u043e\u0439 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439
    \u0434\u043e \u0434\u0432\u043e\u0440\u0446\u043e\u0432\u043e\u0439 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438
