    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0435\u0436\u0434\u0435
    \u0432\u0441\u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0451\u043d\u044b\u043c: \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c. \u0415\u0433\u043e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0438\u0447\u044c \u0437\u0430\u043a\u043e\u043d\u044b
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0442\u044c
