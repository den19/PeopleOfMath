    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0438\u0447\u044c \u0437\u0430\u043a\u043e\u043d\u044b
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0442\u044c
    \u043c\u0435\u0441\u0442\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0432 \u043d\u0435\u0439
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u043e\u044d\u0437\u0438\u0438.\n\n\U0001F4DC
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0432\u0435\u0445\u0438 \u0436\u0438\u0437\u043d\u0438:
    \u043e\u0442 \u043f\u0430\u043b\u0430\u0442\u043e\u0447\u043d\u043e\u0439 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439
    \u0434\u043e \u0434\u0432\u043e\u0440\u0446\u043e\u0432\u043e\u0439 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u041e\u043c\u0430\u0440 \u0425\u0430\u0439\u044f\u043c, \u043f\u043e\u043b\u043d\u043e\u0435
