    \u0438\u0441\u0442\u043e\u0440\u0438\u0438."
  personalLifeEn: 
  shortBioRu: "\u041e\u043c\u0430\u0301\u0440 \u0425\u0430\u0439\u044f\u0301\u043c \u2014 \u0444\u0438\u0433\u0443\u0440\u0430,
