    \u0432 1092 \u0433\u043e\u0434\u0443 \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0441\u0443\u043b\u0442\u0430\u043d\u0430 \u041c\u0430\u043b\u0438\u043a-\u0448\u0430\u0445\u0430
