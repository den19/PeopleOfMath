  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041e\u043c\u0430\u0440\u0430 \u0425\u0430\u0439\u044f\u043c\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e
    \u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442
    \u0441\u0432\u043e\u0435\u0439 \u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439. \u041e\u043d
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u044d\u0440\u0443\u0434\u0438\u0442\u043e\u043c,
    \u0430 \u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0442\u043e\u0440\u043e\u043c, \u0447\u044c\u0438
    \u0438\u0434\u0435\u0438 \u043d\u0430 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c
    \u043d\u0430 \u0442\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.\n\n\U0001F4D0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0420\u0435\u0444\u043e\u0440\u043c\u0430\u0442\u043e\u0440
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u041e\u043c\u0430\u0440 \u0425\u0430\u0439\u044f\u043c
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434, \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445
    \u0437\u0430\u0434\u0430\u0447 \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u0430\u043b\u044c-\u043c\u0443\u043a\u0430\u0431\u0430\u043b\u044b\u00bb
    (\u043e\u043a. 1070 \u0433.), \u0441\u0442\u0430\u043b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
    \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u043c. \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b: \u0412 \u044d\u0442\u043e\u043c \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435
    \u0425\u0430\u0439\u044f\u043c \u043f\u0435\u0440\u0432\u044b\u043c \u0434\u0430\u043b \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u043a\u0430\u043a \u043d\u0430\u0443\u043a\u0438 \u043e\u0431 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445,
    \u043e\u0442\u0434\u0435\u043b\u0438\u0432 \u0435\u0435 \u043e\u0442 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438.
    \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439:
    \u041e\u043d \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u043b\u043d\u0443\u044e
    \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u043d\u0430 25 \u0442\u0438\u043f\u043e\u0432,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0432\u0441\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435
    \u0441\u043b\u0443\u0447\u0430\u0438 \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445, \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445
    \u0438 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0441 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438. \u0413\u043b\u0430\u0432\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u2014 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439:
    \u0413\u043b\u0430\u0432\u043d\u044b\u043c \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u043c
    \u0441\u0442\u0430\u043b\u043e \u0435\u0433\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0445 14 \u0442\u0438\u043f\u043e\u0432
    \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    (\u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0442\u0440\u0435\u0442\u044c\u0435\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438). \u0414\u043e \u043d\u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043c\u043e\u0433\u043b\u0438 \u0440\u0435\u0448\u0430\u0442\u044c \u043b\u0438\u0448\u044c
    \u0447\u0430\u0441\u0442\u043d\u044b\u0435 \u0441\u043b\u0443\u0447\u0430\u0438. \u041c\u0435\u0442\u043e\u0434
    \u0425\u0430\u0439\u044f\u043c\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0441\u044f
    \u0432 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u043a\u043e\u0440\u043d\u0435\u0439
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u043a\u0430\u043a \u0442\u043e\u0447\u0435\u043a
    \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u0447\u0435\u043d\u0438\u0439 \u2014 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438,
    \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b, \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u044b
    \u0438 \u044d\u043b\u043b\u0438\u043f\u0441\u0430. \u041f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438:
    \u0415\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434, \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u0440\u0438\u0432\u044b\u0435, \u0441\u0442\u0430\u043b \u043f\u0440\u044f\u043c\u044b\u043c
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0441\u043f\u0443\u0441\u0442\u044f \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u0420\u0435\u043d\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0438 \u041f\u044c\u0435\u0440 \u0424\u0435\u0440\u043c\u0430.
    \u0420\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434 \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u043c\u0438\u00bb
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430: \u0412 \u0441\u0432\u043e\u0435\u043c \u00ab\u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438
    \u043a \u0442\u0440\u0443\u0434\u043d\u044b\u043c \u043f\u043e\u0441\u0442\u0443\u043b\u0430\u0442\u0430\u043c
    \u043a\u043d\u0438\u0433\u0438 \u0415\u0432\u043a\u043b\u0438\u0434\u0430\u00bb (1077 \u0433.)
    \u043e\u043d \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u043b \u0441\u043c\u0435\u043b\u0443\u044e
    \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043f\u044f\u0442\u044b\u0439
    \u043f\u043e\u0441\u0442\u0443\u043b\u0430\u0442 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u043e \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u044f\u043c\u044b\u0445,
    \u0447\u0442\u043e \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.\n\n\u2600\ufe0f
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f: \u041a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c,
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0438\u0439 \u0432\u0440\u0435\u043c\u044f
    \u0412 1074 \u0433\u043e\u0434\u0443 \u0425\u0430\u0439\u044f\u043c \u0431\u044b\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d
    \u0432 \u0418\u0441\u0444\u0430\u0445\u0430\u043d \u0434\u043b\u044f \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0430
    \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u0439 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0435\u0439.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c
    \u0437\u0434\u0435\u0441\u044c \u0441\u0442\u0430\u043b\u0430 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u043d\u0430\u044f
    \u0440\u0435\u0444\u043e\u0440\u043c\u0430. \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f \u00ab\u0414\u0436\u0430\u043b\u0430\u043b\u0438\u00bb:
    \u0412 1079 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u043d\u043e\u0432\u044b\u0439 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0439 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0439 \u0432 \u0447\u0435\u0441\u0442\u044c
    \u0441\u0443\u043b\u0442\u0430\u043d\u0430 \u041c\u0430\u043b\u0438\u043a-\u0448\u0430\u0445\u0430.
    \u041d\u0435\u043f\u0440\u0435\u0432\u0437\u043e\u0439\u0434\u0435\u043d\u043d\u0430\u044f
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c: \u042d\u0442\u043e\u0442 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u043e\u0447\u0435\u043d, \u0447\u0442\u043e \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u0438\u043b
    \u043f\u043e \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0433\u0440\u0438\u0433\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u0438\u0439
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c, \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044b\u0439
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u043b\u0438\u0448\u044c \u0432 1582 \u0433\u043e\u0434\u0443.
    \u0426\u0438\u043a\u043b: 33 \u0433\u043e\u0434\u0430, 8 \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u2014 \u0432\u0438\u0441\u043e\u043a\u043e\u0441\u043d\u044b\u0435 (\u0432 4-\u0439, 8-\u0439,
    12-\u0439, 16-\u0439, 20-\u0439, 24-\u0439, 28-\u0439 \u0438 33-\u0439 \u0433\u043e\u0434\u044b).
    \u0422\u043e\u0447\u043d\u043e\u0441\u0442\u044c: \u0413\u043e\u0434 \u043f\u043e \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044e
    \u0425\u0430\u0439\u044f\u043c\u0430 \u0434\u043b\u0438\u0442\u0441\u044f 365,2424242 \u0441\u0443\u0442\u043e\u043a,
    \u0447\u0442\u043e \u0432\u0441\u0435\u0433\u043e \u043d\u0430 1,24 \u0441\u0435\u043a\u0443\u043d\u0434\u044b
    \u043e\u0442\u043b\u0438\u0447\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0433\u043e\u0434\u0430.
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b: \u0417\u0430 \u0433\u043e\u0434\u044b \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438 \u043e\u043d
    \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u00ab\u0417\u0438\u0434\u0436 \u041c\u0430\u043b\u0438\u043a-\u0448\u0430\u0445\u0438\u00bb
    \u0438 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u0437\u0432\u0435\u0437\u0434, \u0432
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c, \u043e\u043f\u0438\u0441\u0430\u043b \u043e\u043a\u043e\u043b\u043e
    100 \u0437\u0432\u0435\u0437\u0434.\n\n\U0001F4DA \u0414\u0440\u0443\u0433\u0438\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u041f\u043e\u043c\u0438\u043c\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438, \u0425\u0430\u0439\u044f\u043c
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0442\u0440\u0443\u0434\u044b \u0432 \u0434\u0440\u0443\u0433\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u0438 \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c. \u0424\u0438\u0437\u0438\u043a\u0430:
    \u041d\u0430\u043f\u0438\u0441\u0430\u043b \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u0412\u0435\u0441\u044b
    \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u0438, \u0438\u043b\u0438 \u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u043e\u0431 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0437\u043e\u043b\u043e\u0442\u0430
    \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u0430 \u0432 \u0441\u043f\u043b\u0430\u0432\u0430\u0445\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u043f\u043e \u0441\u0443\u0442\u0438, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0444\u0438\u0437\u0438\u043a\u043e-\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0443\u0434\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0432\u0435\u0441\u0430 \u043c\u0435\u0442\u0430\u043b\u043b\u043e\u0432. \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430:
    \u0415\u0433\u043e \u0440\u0430\u043d\u043d\u044f\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u0422\u0440\u0443\u0434\u043d\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb, \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c, \u043d\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u0432 \u043d\u0435\u0439
    \u043e\u043d \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b \u043c\u0435\u0442\u043e\u0434\u044b
    \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u0440\u043d\u0435\u0439,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0431\u0438\u043d\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u043d\u0430 700
    \u043b\u0435\u0442 \u0440\u0430\u043d\u044c\u0448\u0435 \u043d\u0435\u0433\u043e. \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f:
    \u0411\u0443\u0434\u0443\u0447\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0418\u0431\u043d \u0421\u0438\u043d\u044b (\u0410\u0432\u0438\u0446\u0435\u043d\u043d\u044b),
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u043e\u0432
    \u043d\u0430 \u0430\u0440\u0430\u0431\u0441\u043a\u043e\u043c \u0438 \u043f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0430\u0445, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b \u0432\u043e\u043f\u0440\u043e\u0441\u044b
    \u0431\u044b\u0442\u0438\u044f, \u0434\u0435\u0442\u0435\u0440\u043c\u0438\u043d\u0438\u0437\u043c\u0430
    \u0438 \u0432\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u043c\u0438\u0440\u0430. \u0415\u0433\u043e
    \u00ab\u041d\u043e\u0443\u0440\u0443\u0437-\u043d\u0430\u043c\u0435\u00bb \u2014 \u044d\u0442\u043e
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435
    \u043e \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f\u0445 \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a\u0430
    \u0432\u0435\u0441\u043d\u044b \u041d\u0430\u0432\u0440\u0443\u0437.\n\n\U0001F48E \u0418\u0442\u043e\u0433
    \u041e\u043c\u0430\u0440 \u0425\u0430\u0439\u044f\u043c \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0443\u0447\u0435\u043d\u044b\u043c-\u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0441\u0442\u043e\u043c.
    \u0415\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u0441\u0442\u0430\u043b\u0438 \u043c\u043e\u0441\u0442\u043e\u043c
    \u043c\u0435\u0436\u0434\u0443 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439
    \u0438 \u043d\u043e\u0432\u043e\u0439 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u043e\u0439, \u0430 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b, \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u0418\u0440\u0430\u043d\u0435
    \u0438 \u0410\u0444\u0433\u0430\u043d\u0438\u0441\u0442\u0430\u043d\u0435, \u044f\u0432\u043b\u044f\u044f\u0441\u044c
    \u0436\u0438\u0432\u044b\u043c \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u043e\u043c
    \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u044e."
  achievementsEn: 
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u041e\u043c\u0430\u0440\u0430 \u0425\u0430\u0439\u044f\u043c\u0430,
    \u0437\u0430\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u043d\u0430\u044f \u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0438\u0445\u0441\u044f
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0435\u0442
    \u043a\u0430\u043a \u043f\u0443\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u0446\u0435\u043b\u0438\u043a\u043e\u043c \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0432\u0448\u0435\u0433\u043e
    \u0441\u0435\u0431\u044f \u043d\u0430\u0443\u043a\u0435 \u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0435\u0433\u043e
    \u044f\u0440\u043a\u0438\u0439 \u0441\u043b\u0435\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438. \u0414\u0435\u0442\u0430\u043b\u0438
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0431\u043e\u043b\u044c\u0448\u0435\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u0437\u0430
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u043c\u0438 \u0445\u0440\u043e\u043d\u0438\u043a,
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u044b\u0445
    \u043d\u0430 \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0445. \u041d\u0438\u0436\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0432\u0435\u0445\u0438 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u043f\u043e \u043a\u0440\u0443\u043f\u0438\u0446\u0430\u043c
    \u0438\u0437 \u0434\u043e\u0448\u0435\u0434\u0448\u0438\u0445 \u0434\u043e \u043d\u0430\u0441
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432.\n\n\U0001F476
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u041e\u043c\u0430\u0440 \u0425\u0430\u0439\u044f\u043c, \u043f\u043e\u043b\u043d\u043e\u0435
    \u0438\u043c\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0413\u0438\u044f\u0441\u0430\u0434\u0434\u0438\u043d
    \u0410\u0431\u0443-\u043b\u044c-\u0424\u0430\u0442\u0445 \u041e\u043c\u0430\u0440 \u0438\u0431\u043d
    \u0418\u0431\u0440\u0430\u0445\u0438\u043c \u041d\u0438\u0448\u0430\u043f\u0443\u0440\u0438,
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 18 \u043c\u0430\u044f 1048 \u0433\u043e\u0434\u0430
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041d\u0438\u0448\u0430\u043f\u0443\u0440,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u043e\u0433\u0434\u0430 \u0431\u044b\u043b
    \u043a\u0440\u0443\u043f\u043d\u044b\u043c \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0425\u043e\u0440\u0430\u0441\u0430\u043d\u0430
    (\u043d\u0430 \u0441\u0435\u0432\u0435\u0440\u043e-\u0432\u043e\u0441\u0442\u043e\u043a\u0435
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0418\u0440\u0430\u043d\u0430).
    \u0415\u0433\u043e \u0441\u0435\u043c\u044c\u044f, \u0441\u0443\u0434\u044f \u043f\u043e
    \u0444\u0430\u043c\u0438\u043b\u0438\u0438 (\u00ab\u0445\u0430\u0439\u044f\u043c\u00bb \u2014
    \u043f\u0430\u043b\u0430\u0442\u043e\u0447\u043d\u044b\u0445 \u0434\u0435\u043b \u043c\u0430\u0441\u0442\u0435\u0440),
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430 \u0438\u0437 \u0440\u0435\u043c\u0435\u0441\u043b\u0435\u043d\u043d\u0438\u043a\u043e\u0432,
    \u0438\u0437\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u0432\u0448\u0438\u0445
    \u043f\u0430\u043b\u0430\u0442\u043a\u0438. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0430 \u043c\u043b\u0430\u0434\u0448\u0430\u044f
    \u0441\u0435\u0441\u0442\u0440\u0430 \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0410\u0438\u0448\u0430.
    \u041e\u043d \u0440\u0430\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u043d\u0435\u0437\u0430\u0443\u0440\u044f\u0434\u043d\u044b\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438: \u0443\u0436\u0435 \u0432
    8 \u043b\u0435\u0442 \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e.
    \u0412 12 \u043b\u0435\u0442 \u041e\u043c\u0430\u0440 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u043c\u0435\u0434\u0440\u0435\u0441\u0435 \u041d\u0438\u0448\u0430\u043f\u0443\u0440\u0430,
    \u0433\u0434\u0435 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043e\u0441\u0432\u043e\u0438\u043b
    \u043a\u0443\u0440\u0441 \u043c\u0443\u0441\u0443\u043b\u044c\u043c\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0430\u0432\u0430 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b,
    \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e
    \u0432\u0440\u0430\u0447\u0430 (\u0445\u0430\u043a\u0438\u043c\u0430). \u041e\u0434\u043d\u0430\u043a\u043e
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0430\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430
    \u043c\u0430\u043b\u043e \u0435\u0433\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u043b\u0430,
    \u043e\u043d \u0432\u0441\u0435\u0446\u0435\u043b\u043e \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e \u0442\u0440\u0443\u0434\u043e\u0432 \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445
    \u0438 \u0432\u043e\u0441\u0442\u043e\u0447\u043d\u044b\u0445 \u0443\u0447\u0435\u043d\u044b\u0445,
    \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0415\u0432\u043a\u043b\u0438\u0434 \u0438
    \u0410\u0432\u0438\u0446\u0435\u043d\u043d\u0430 (\u0418\u0431\u043d \u0421\u0438\u043d\u0430).
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 16 \u043b\u0435\u0442 \u0436\u0438\u0437\u043d\u044c
    \u041e\u043c\u0430\u0440\u0430 \u0440\u0435\u0437\u043a\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c:
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0438
    \u0443\u043c\u0435\u0440\u043b\u0438 \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0438
    \u043c\u0430\u0442\u044c. \u041f\u0440\u043e\u0434\u0430\u0432 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439
    \u0434\u043e\u043c \u0438 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0443\u044e,
    \u043e\u043d \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u041d\u0438\u0448\u0430\u043f\u0443\u0440
    \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u0421\u0430\u043c\u0430\u0440\u043a\u0430\u043d\u0434,
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0446\u0435\u043d\u0442\u0440\u043e\u0432 \u0412\u043e\u0441\u0442\u043e\u043a\u0430.\n\n\U0001F9D1\u200d\U0001F393
    \u041f\u0443\u0442\u044c \u043a \u0441\u043b\u0430\u0432\u0435: \u0423\u0447\u0451\u0431\u0430
    \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u0412 \u0421\u0430\u043c\u0430\u0440\u043a\u0430\u043d\u0434\u0435
    \u0425\u0430\u0439\u044f\u043c \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435
    \u0432 \u043c\u0435\u0434\u0440\u0435\u0441\u0435, \u043d\u043e \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0441\u0442\u044c
    \u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445 \u0434\u0438\u0441\u043f\u0443\u0442\u0430\u0445
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u0430
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u0432\u043e\u0437\u0432\u0435\u043b\u0438 \u0432
    \u0440\u0430\u043d\u0433 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0430. \u041a\u0430\u043a
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0443\u0447\u0435\u043d\u044b\u0435 \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043e\u043d \u043d\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0441\u044f
    \u043f\u043e\u0434\u043e\u043b\u0433\u0443 \u043d\u0430 \u043e\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435.
    \u041e\u043a\u043e\u043b\u043e 1070 \u0433\u043e\u0434\u0430 \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0411\u0443\u0445\u0430\u0440\u0443, \u0433\u0434\u0435 \u043e\u043a\u043e\u043b\u043e
    \u0434\u0435\u0441\u044f\u0442\u0438 \u043b\u0435\u0442 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u043a\u043d\u0438\u0433\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0430\u0445.
    \u042d\u0442\u043e\u0442 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u0435\u043c\u0443
    \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u0447\u0435\u0442\u044b\u0440\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0430.\n\n\U0001F451
    \u0417\u0432\u0451\u0437\u0434\u043d\u044b\u0439 \u0447\u0430\u0441 \u0432 \u0418\u0441\u0444\u0430\u0445\u0430\u043d\u0435:
    \u041f\u0438\u043a \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0412 1074 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0425\u0430\u0439\u044f\u043c\u0443
    \u0431\u044b\u043b\u043e \u043e\u043a\u043e\u043b\u043e 27 \u043b\u0435\u0442, \u0435\u0433\u043e
    \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u0432 \u0418\u0441\u0444\u0430\u0445\u0430\u043d
    \u2014 \u0441\u0442\u043e\u043b\u0438\u0446\u0443 \u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0421\u0435\u043b\u044c\u0434\u0436\u0443\u043a\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438.
    \u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0438\u0441\u0445\u043e\u0434\u0438\u043b\u043e
    \u043e\u0442 \u0441\u0443\u043b\u0442\u0430\u043d\u0430 \u041c\u0430\u043b\u0438\u043a-\u0448\u0430\u0445\u0430
    \u0438 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0432\u0438\u0437\u0438\u0440\u044f
    \u041d\u0438\u0437\u0430\u043c \u0430\u043b\u044c-\u041c\u0443\u043b\u044c\u043a\u0430.
    \u041f\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043b\u0435\u0433\u0435\u043d\u0434,
    \u043e\u043d\u0438 \u0431\u044b\u043b\u0438 \u043e\u0434\u043d\u043e\u043a\u043b\u0430\u0441\u0441\u043d\u0438\u043a\u0430\u043c\u0438
    \u0425\u0430\u0439\u044f\u043c\u0430 \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438.
    \u0412 \u0418\u0441\u0444\u0430\u0445\u0430\u043d\u0435 \u0425\u0430\u0439\u044f\u043c \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445
    \u0432 \u043c\u0438\u0440\u0435 \u0434\u0432\u043e\u0440\u0446\u043e\u0432\u044b\u0445 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0439
    \u0438 \u0441\u0442\u0430\u043b \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c
    \u0441\u0443\u043b\u0442\u0430\u043d\u0430. \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    (\u043e\u043a\u043e\u043b\u043e 20 \u043b\u0435\u0442) \u0441\u0442\u0430\u043b \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439
    \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b. \u0420\u0430\u0431\u043e\u0442\u0430\u044f
    \u0441 \u0433\u0440\u0443\u043f\u043f\u043e\u0439 \u0443\u0447\u0435\u043d\u044b\u0445,
    \u043e\u043d: - \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0439
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c \u00ab\u0414\u0436\u0430\u043b\u0430\u043b\u0438\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u0431\u043e\u043b\u0435\u0435
    \u0442\u043e\u0447\u043d\u044b\u043c, \u0447\u0435\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439
    \u0435\u043c\u0443 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0439 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c,
    \u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0432 \u0418\u0440\u0430\u043d\u0435 \u0438 \u0410\u0444\u0433\u0430\u043d\u0438\u0441\u0442\u0430\u043d\u0435.
    - \u0421\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u00ab\u041c\u0430\u043b\u0438\u043a\u0448\u0430\u0445\u0441\u043a\u0438\u0435
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b\u00bb, \u0432\u043a\u043b\u044e\u0447\u0430\u0432\u0448\u0438\u0435
    \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u044f\u0440\u043a\u0438\u0445 \u0437\u0432\u0435\u0437\u0434.
    - \u041d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0442\u0440\u0443\u0434 \u00ab\u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438
    \u043a \u0442\u0440\u0443\u0434\u043d\u044b\u043c \u043f\u043e\u0441\u0442\u0443\u043b\u0430\u0442\u0430\u043c
    \u043a\u043d\u0438\u0433\u0438 \u0415\u0432\u043a\u043b\u0438\u0434\u0430\u00bb (1077 \u0433.),
    \u0433\u0434\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0438\u043d\u0438\u0439
    \u0438 \u0443\u0447\u0435\u043d\u0438\u0435 \u043e \u0447\u0438\u0441\u043b\u0435, \u043f\u043e\u0434\u043e\u0439\u0434\u044f
    \u043a \u0438\u0434\u0435\u044f\u043c \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.\n\n\U0001F465 \u0423\u0447\u0435\u043d\u0438\u043a\u0438,
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u041e\u0431 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445 \u0425\u0430\u0439\u044f\u043c\u0430
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043d\u0435\u043c\u043d\u043e\u0433\u043e.
    \u0412 \u0447\u0438\u0441\u043b\u0435 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0431\u044b\u043b\u0438 \u0442\u0430\u043a\u0438\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435
    \u0443\u0447\u0435\u043d\u044b\u0435, \u043a\u0430\u043a \u0430\u043b-\u0410\u0441\u0444\u0438\u0437\u0430\u0440\u0438
    \u0438 \u0430\u043b-\u0425\u0430\u0437\u0438\u043d\u0438. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438,
    \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432 \u0430\u043b\u044c-\u0413\u0430\u0437\u0430\u043b\u0438,
    \u043e\u0431\u0440\u0430\u0449\u0430\u043b\u0438\u0441\u044c \u043a \u043d\u0435\u043c\u0443
    \u0437\u0430 \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438 \u0440\u0430\u0437\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f\u043c\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c, \u0425\u0430\u0439\u044f\u043c
    \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0440\u0435\u0437\u043a\u0438\u043c
