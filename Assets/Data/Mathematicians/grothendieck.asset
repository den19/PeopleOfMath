  achievementsRu: "\u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0438\u043b \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u2014 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043d\u043e\u0432\u044b\u0439 \u044f\u0437\u044b\u043a, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0442
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440. \u0415\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043b\u0435\u0436\u0430\u0442 \u0432 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0435
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u043e\u0440
    \u0435\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0438\u0434\u0435\u0439.\n\n\U0001F3D7\ufe0f
    \u0422\u0435\u043e\u0440\u0438\u044f \u0441\u0445\u0435\u043c: \u043d\u043e\u0432\u044b\u0439
    \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0413\u043b\u0430\u0432\u043d\u0430\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430 \u2014 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u0445\u0435\u043c (theory of schemes). \u0414\u043e
    \u043d\u0435\u0433\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u0438\u0437\u0443\u0447\u0430\u043b\u0430 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f
    \u2014 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043d\u0430\u0434 \u043f\u043e\u043b\u044f\u043c\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u043c\u0438 \u0438\u043b\u0438
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438.
    \u042d\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443:
    \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u043c\u043e\u0433\u043b\u043e \u0438\u043c\u0435\u0442\u044c \u0440\u0430\u0437\u043d\u043e\u0435
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0439
    \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043f\u043e\u043b\u044f,
    \u0447\u0442\u043e \u043c\u0435\u0448\u0430\u043b\u043e \u0443\u0432\u0438\u0434\u0435\u0442\u044c
    \u0435\u0434\u0438\u043d\u0443\u044e \u043a\u0430\u0440\u0442\u0438\u043d\u0443. \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043e\u0431\u044a\u0435\u043a\u0442 \u043d\u0435 \u0447\u0435\u0440\u0435\u0437 \u0435\u0433\u043e
    \u0442\u043e\u0447\u043a\u0438, \u0430 \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u043b\u044c\u0446\u043e
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0436\u043d\u043e
    \u043d\u0430 \u043d\u0435\u043c \u0437\u0430\u0434\u0430\u0442\u044c. \u0412\u043c\u0435\u0441\u0442\u043e
    \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044c,
    \u0433\u0434\u0435 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f,
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \"\u043f\u043e\u043c\u043d\u0438\u0442\" \u0432\u0441\u0435
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0441\u0440\u0430\u0437\u0443. \u042d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e \u0430\u0444\u0444\u0438\u043d\u043d\u043e\u0439
    \u0441\u0445\u0435\u043c\u044b \u043a\u0430\u043a \u0441\u043f\u0435\u043a\u0442\u0440\u0430
    (\u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0438\u0434\u0435\u0430\u043b\u043e\u0432) \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u044c\u0446\u0430.
    > \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0441\u043c\u0435\u043b\u0430\u044f \u0438\u0434\u0435\u044f
    \u2014 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c \u043b\u044e\u0431\u043e\u043c\u0443
    \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u043a\u043e\u043b\u044c\u0446\u0443
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e. \u0422\u0430\u043a\u043e\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u0438\u043c\u0435\u043b \u0434\u0432\u0430 \u0432\u0430\u0436\u043d\u044b\u0445
    \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f: > 1. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u043e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438:
    \u041a\u043e\u043b\u044c\u0446\u043e \u0446\u0435\u043b\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \\(\\mathbb{Z}\\) \u0442\u043e\u0436\u0435 \u0441\u0442\u0430\u043b\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u043c \u2014 \u0441\u0445\u0435\u043c\u043e\u0439
    \\(\\operatorname{Spec}(\\mathbb{Z})\\). \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u043a \u0437\u0430\u0434\u0430\u0447\u0430\u043c \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. > 2. \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c:
    \u041f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \"\u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\",
    \u043c\u0435\u043d\u044f\u044f \u0431\u0430\u0437\u043e\u0432\u043e\u0435 \u043a\u043e\u043b\u044c\u0446\u043e.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u043d\u0430\u0434 \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u043f\u043e\u043b\u044f\u043c\u0438,
    \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0435\u043d\u044f\u044f \"\u0431\u0430\u0437\u0443\"
    \\(\\operatorname{Spec}(k)\\), \u0441\u043b\u043e\u0432\u043d\u043e \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044f
    \u043e\u0434\u0438\u043d \u0438 \u0442\u043e\u0442 \u0436\u0435 \u043e\u0431\u044a\u0435\u043a\u0442
    \u043f\u043e\u0434 \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \"\u043b\u0438\u043d\u0437\u0430\u043c\u0438\".
    \u0421\u0445\u0435\u043c\u044b \u0441\u0442\u0430\u043b\u0438 \u0442\u0435\u043c \"\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u044f\u0437\u044b\u043a\u043e\u043c\", \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043d\u0430 \u0432\u0441\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f.
    \u041d\u0430 \u0438\u0445 \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u044b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \"\u00c9l\u00e9ments
    de g\u00e9om\u00e9trie alg\u00e9brique\" (EGA) \u2014 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0441 \u0416\u0430\u043d\u043e\u043c \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \"\u0415\u0432\u0430\u043d\u0433\u0435\u043b\u0438\u0435\u043c \u043e\u0442 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430\".\n\n\U0001F52D
    \u0422\u043e\u043f\u043e\u0441\u044b \u0438 \u044d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438: \u043d\u043e\u0432\u044b\u0439
    \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043f\u043e\u0448\u0435\u043b \u0435\u0449\u0435 \u0434\u0430\u043b\u044c\u0448\u0435,
    \u043e\u0431\u043e\u0431\u0449\u0438\u0432 \u0441\u0430\u043c\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430. \u0412\u043c\u0435\u0441\u0442\u043e
    \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0447\u0435\u0440\u0435\u0437
    \u0442\u043e\u0447\u043a\u0438, \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c \u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044e \u043f\u0443\u0447\u043a\u043e\u0432
    \u043d\u0430 \u043d\u0435\u043c. \u042d\u0442\u043e \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435
    \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b \u0442\u043e\u043f\u043e\u0441\u043e\u043c
    (topos). \u0422\u043e\u043f\u043e\u0441\u044b \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435
    \"\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\" \u0434\u043b\u044f \u0440\u0430\u0437\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447. \u0421\u0430\u043c\u0430\u044f \u0432\u0430\u0436\u043d\u0430\u044f
    \u0438\u0437 \u043d\u0438\u0445 \u2014 \u044d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f (\u00e9tale topology) \u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u043d\u0430 \u043d\u0435\u0439 \u044d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438.
    \u042d\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \"\u043f\u043e\u043a\u0440\u044b\u0442\u0438\u044f\" \u043d\u0435 \u0432 \u043e\u0431\u044b\u0447\u043d\u043e\u043c
    \u0441\u043c\u044b\u0441\u043b\u0435, \u0430 \u0447\u0435\u0440\u0435\u0437 \u043e\u0441\u043e\u0431\u044b\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e
    \u0432\u044b\u0433\u043b\u044f\u0434\u044f\u0442 \u043a\u0430\u043a \u0438\u0437\u043e\u043c\u043e\u0440\u0444\u0438\u0437\u043c\u044b.
    \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0440\u043e\u0440\u044b\u0432, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432\u0448\u0438\u0439:
    \u041f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u043c\u0435\u0442\u043e\u0434\u044b
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438 \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438: \u042d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0432\u0435\u0434\u0443\u0442
    \u0441\u0435\u0431\u044f \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u043e \u043e\u0431\u044b\u0447\u043d\u044b\u043c
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u044f\u043c,
    \u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0432 \u043c\u0438\u0440\u0435
    \u0441\u0445\u0435\u043c, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u043e\u043b\u044f
    \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438.
    \u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442:
    \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u041f\u044c\u0435\u0440 \u0414\u0435\u043b\u0438\u043d\u044c (\u0443\u0447\u0435\u043d\u0438\u043a
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430) \u0441\u043c\u043e\u0433 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0442\u0440\u0435\u0442\u044c\u044e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u0412\u0435\u0439\u043b\u044f
    \u043e \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0442\u0440\u0438\u0443\u043c\u0444\u043e\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 XX \u0432\u0435\u043a\u0430.
    \u041e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b:
    \u0421\u0430\u043c \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0441\u0447\u0438\u0442\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0442\u043e\u043f\u043e\u0441\u043e\u0432 \u0441\u0432\u043e\u0435\u0439
    \u0441\u0430\u043c\u043e\u0439 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u043e\u0439, \u0432\u0438\u0434\u044f \u0432 \u043d\u0435\u0439
    \"\u0441\u0438\u043d\u0442\u0435\u0437 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\".\n\n\U0001F9E9 \u0414\u0440\u0443\u0433\u0438\u0435
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438 \u0412\u043a\u043b\u0430\u0434 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430
    \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u0441\u0445\u0435\u043c\u0430\u043c\u0438 \u0438 \u0442\u043e\u043f\u043e\u0441\u0430\u043c\u0438.
    \u0421\u0440\u0435\u0434\u0438 \u0435\u0433\u043e \"\u0439\u043e\u0433\" (\u043a\u0430\u043a
    \u043e\u043d \u0441\u0430\u043c \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0441\u0432\u043e\u0438
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438) \u0432\u044b\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f:
    \u041c\u043e\u0442\u0438\u0432\u044b (Motives): \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0437\u0430\u0434\u0443\u043c\u0430\u043b \u043c\u043e\u0442\u0438\u0432\u044b \u043a\u0430\u043a
    \"\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0431\u043b\u043e\u043a\u0438\" \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0442\u0435\u043e\u0440\u0438\u0439
    \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0439. \u0418\u0434\u0435\u044f
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044e, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0439,
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044f \u0440\u0430\u0437\u043d\u044b\u0435 \"\u0444\u0443\u043d\u043a\u0442\u043e\u0440\u044b
    \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\", \u043c\u043e\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0432\u0441\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 (\u044d\u0442\u0430\u043b\u044c\u043d\u044b\u0435,
    \u0434\u0435 \u0420\u0430\u043c\u0430, \u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0435
    \u0438 \u0434\u0440.). \u0425\u043e\u0442\u044f \u0441\u0430\u043c \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043d\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u044d\u0442\u0443 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443,
    \u043e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437
    \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \\(K\\)-\u0442\u0435\u043e\u0440\u0438\u044f
    \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0420\u0438\u043c\u0430\u043d\u0430-\u0420\u043e\u0445\u0430-\u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430:
    \u041e\u043d \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0420\u0438\u043c\u0430\u043d\u0430-\u0420\u043e\u0445\u0430,
    \u0441\u043e\u0437\u0434\u0430\u0432 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u043e\u0432\u044b\u0439
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043c \\(K\\)-\u0442\u0435\u043e\u0440\u0438\u0438.
    \u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437:
    \u0415\u0433\u043e \u0440\u0430\u043d\u043d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044e \u044f\u0434\u0435\u0440\u043d\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0435\u043d\u0437\u043e\u0440\u043d\u044b\u0445 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0439,
    \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b\u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u043c\u0438
    \u0438 \u043d\u0430\u0448\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0439
    \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435.\n\n\U0001F4DD
    \u041e\u0441\u043e\u0431\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0421\u0442\u0438\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u044b \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430
    \u0431\u044b\u043b \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d. \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432-\u00ab\u0440\u0435\u0448\u0430\u0442\u0435\u043b\u0435\u0439
    \u0437\u0430\u0434\u0430\u0447\u00bb, \u043e\u043d \u0431\u044b\u043b \u00ab\u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u0442\u0435\u043e\u0440\u0438\u0439\u00bb. \u0415\u0433\u043e \u0446\u0435\u043b\u044c\u044e
    \u0431\u044b\u043b\u043e \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0439\u0442\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b, \u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e
    \u043e\u0431\u0449\u0443\u044e \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u044d\u0442\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0430\u0441\u044c
    \u0431\u044b \u0447\u0430\u0441\u0442\u043d\u044b\u043c \u0441\u043b\u0443\u0447\u0430\u0435\u043c
    \u0438 \u0440\u0435\u0448\u0430\u043b\u0430\u0441\u044c \u0431\u044b \"\u043f\u043e\u0447\u0442\u0438
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\". \u0415\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u0442\u0440\u043e\u0438\u043b\u0438\u0441\u044c
    \u0438\u0437 \u0434\u043b\u0438\u043d\u043d\u044b\u0445 \u0446\u0435\u043f\u043e\u0447\u0435\u043a
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445, \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u044b\u0445
    \u043b\u0435\u043c\u043c, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u043e \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438,
    \u043d\u043e \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u044f\u0441\u043d\u044b\u043c\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043d\u043e\u0432\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c, \u0431\u0435\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0431\u044b\u043b\u0438 \u0431\u044b \u043d\u0435\u043c\u044b\u0441\u043b\u0438\u043c\u044b
    \u043c\u043d\u043e\u0433\u0438\u0435 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0439, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0424\u0435\u0440\u043c\u0430."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430 \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c
    \u0436\u0435 \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0439,
    \u043a\u0430\u043a \u0438 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0433\u0435\u043d\u0438\u0439. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u0432\u044f\u0437\u044f\u043c\u0438, \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u043c\u0438 \u0438, \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c
    \u0441\u0447\u0451\u0442\u0435, \u043f\u043e\u043b\u043d\u044b\u043c \u043e\u0442\u0448\u0435\u043b\u044c\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c.
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0435\u0433\u043e \u0441\u0442\u0440\u043e\u0439\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0435\u043e\u0440\u0438\u0439,
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u2014 \u044d\u0442\u043e \u0437\u0430\u043f\u0443\u0442\u0430\u043d\u043d\u044b\u0439 \u043a\u043b\u0443\u0431\u043e\u043a
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439, \u0434\u043e\u043b\u0433\u0430,
    \u0431\u043e\u043b\u0438 \u0438 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0430.\n\n\U0001F494
    \u0416\u0435\u043d\u0449\u0438\u043d\u044b \u0438 \u0434\u0435\u0442\u0438: \u0441\u043b\u043e\u0436\u043d\u044b\u0439
    \u0443\u0437\u043e\u0440 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0445 \u0441\u0432\u044f\u0437\u0435\u0439
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0431\u044b\u043b \u043e\u0442\u0446\u043e\u043c
    \u043f\u043e \u043c\u0435\u043d\u044c\u0448\u0435\u0439 \u043c\u0435\u0440\u0435 \u043f\u044f\u0442\u0435\u0440\u044b\u0445
    \u0434\u0435\u0442\u0435\u0439 \u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0436\u0435\u043d\u0449\u0438\u043d, \u043d\u043e \u0435\u0433\u043e \u0440\u043e\u043b\u044c
    \u0432 \u0438\u0445 \u0436\u0438\u0437\u043d\u0438 \u0431\u044b\u043b\u0430, \u043c\u044f\u0433\u043a\u043e
    \u0433\u043e\u0432\u043e\u0440\u044f, \u043d\u0435\u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439.
    \u0415\u0433\u043e \u043f\u043e\u0433\u043b\u043e\u0449\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0438 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435
    \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u043d\u0430 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e
    \u0447\u0430\u0441\u0442\u043e \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438 \u0441\u0435\u043c\u044c\u044e
    \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u043c \u043f\u043b\u0430\u043d\u0435. \u041f\u0435\u0440\u0432\u0430\u044f
    \u0441\u0435\u043c\u044c\u044f: \u0421\u0435\u0440\u0436 \u0438 \u0410\u043b\u0438\u043d
    \u0414\u0440\u0438\u043a\u0435\u0440. \u0415\u0449\u0435 \u0432 \u041d\u0430\u043d\u0441\u0438,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u043c,
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0436\u0438\u043b \u043d\u0430 \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0435
    \u0443 \u0410\u043b\u0438\u043d \u0414\u0440\u0438\u043a\u0435\u0440 (Marcelle \"Aline\"
    Driquert), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0441\u0442\u0430\u0440\u0448\u0435
    \u0435\u0433\u043e. \u0423 \u043d\u0438\u0445 \u0437\u0430\u0432\u044f\u0437\u0430\u043b\u0438\u0441\u044c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u0438 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u0439
    \u0441\u044b\u043d \u0421\u0435\u0440\u0436 (Serge). \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u043d\u0435\u0434\u043e\u043b\u0433\u0438\u043c\u0438, \u0438
    \u0432\u043e\u043a\u0440\u0443\u0433 \u043e\u043f\u0435\u043a\u0438 \u043d\u0430\u0434 \u0421\u0435\u0440\u0436\u0435\u043c
    \u0440\u0430\u0437\u0433\u043e\u0440\u0435\u043b\u0438\u0441\u044c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435
    \u0441\u043f\u043e\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 1962 \u0433\u043e\u0434\u0443
    \u0434\u043e\u0448\u043b\u0438 \u0434\u0430\u0436\u0435 \u0434\u043e \u0441\u0443\u0434\u0430.
    \u0412 \u0438\u0442\u043e\u0433\u0435 \u0421\u0435\u0440\u0436 \u0432\u044b\u0440\u043e\u0441
    \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e. \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u0439
    \u0421\u0435\u0440\u0436, \u043f\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u043e\u0432\u0430\u043c, \u043f\u0440\u043e\u0448\u0435\u043b \u0447\u0435\u0440\u0435\u0437
    \"\u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u0443\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443
    \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043d\u0435\u0443\u0434\u0430\u0447\u043d\u0438\u043a\u0430\",
    \u043f\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u044f\u0441\u044c \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c\u0438
    \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0430\u043c\u0438, \u0438 \u0432 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0441\u0442\u0430\u043b \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u0433\u0443\u0440\u0443. \u042d\u0442\u0430
    \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0441 \u0421\u0435\u0440\u0436\u0435\u043c \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0442\u0440\u0435\u0449\u0438\u043d\u043e\u0439 \u0432 \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430.
    \u0411\u0440\u0430\u043a \u0441 \u041c\u0438\u0440\u0435\u0439 \u0414\u044e\u0444\u0443\u0440.
    \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f,
    \u0443\u0436\u0435 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435, \u0441\u043b\u043e\u0436\u0438\u043b\u0438\u0441\u044c
    \u0441 \u041c\u0438\u0440\u0435\u0439 \u0414\u044e\u0444\u0443\u0440 (Mireille Dufour).
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043f\u043e\u043e\u0431\u0435\u0449\u0430\u043b \u0441\u0432\u043e\u0435\u0439 \u0443\u043c\u0438\u0440\u0430\u044e\u0449\u0435\u0439
    \u043c\u0430\u0442\u0435\u0440\u0438 \u0425\u0430\u043d\u043a\u0435 \u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f
    \u043d\u0430 \u041c\u0438\u0440\u0435\u0439, \u0438 \u0431\u0440\u0430\u043a \u0431\u044b\u043b
    \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 \u043a\u043e\u043d\u0446\u0435 1950-\u0445 \u0433\u043e\u0434\u043e\u0432. \u0423
    \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0442\u0440\u043e\u0435
    \u0434\u0435\u0442\u0435\u0439: \u0414\u043e\u0447\u044c \u0419\u043e\u0445\u0430\u043d\u043d\u0430
    (Johanna) (\u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c 16 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1959 \u0433\u043e\u0434\u0430 \u0432 \u0411\u043e\u0441\u0442\u043e\u043d\u0435, \u0421\u0428\u0410).
    \u0421\u044b\u043d \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 (Alexandre) \u043c\u043b.
    (\u0440\u043e\u0434\u0438\u043b\u0441\u044f 18 \u0438\u044e\u043b\u044f 1961 \u0433\u043e\u0434\u0430).
    \u0421\u044b\u043d \u041c\u0430\u0442\u044c\u0451 (Matthieu) (\u0440\u043e\u0434\u0438\u043b\u0441\u044f
    23 \u0430\u043f\u0440\u0435\u043b\u044f 1965 \u0433\u043e\u0434\u0430). \u042d\u0442\u043e\u0442
    \u0431\u0440\u0430\u043a \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c \u043d\u0435
    \u0431\u044b\u043b. \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u043c\u043e\u0433
    \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442\u044c \u0432 \u0438\u0445 \u043e\u0431\u0449\u0438\u0439
    \u0434\u043e\u043c \u0434\u0440\u0443\u0433\u0438\u0445 \u0436\u0435\u043d\u0449\u0438\u043d,
    \u0430 \u0432 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u043c\u043e\u043c\u0435\u043d\u0442
    \u0434\u0430\u0436\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043c\u0435\u0436\u0434\u0443
    \u041c\u0438\u0440\u0435\u0439 \u0438 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0435\u0433\u043e
    \u043b\u044e\u0431\u043e\u0432\u043d\u0438\u0446, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c, \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u0438
    \u0432 \"\u043f\u0430\u043a\u0442\" \u043f\u0440\u043e\u0442\u0438\u0432 \u0435\u0449\u0435
    \u043e\u0434\u043d\u043e\u0439 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0446\u044b. \u041f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \"\u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\" \u0432 1970 \u0433\u043e\u0434\u0443
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u041c\u0438\u0440\u0435\u0439
    \u0441\u0442\u0430\u043b\u0438 \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043d\u044b\u043c\u0438.
    \u041a\u0430\u043a\u043e\u0435-\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u043d
    \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043f\u043b\u0430\u0442\u0438\u0442\u044c
    \u0430\u043b\u0438\u043c\u0435\u043d\u0442\u044b, \u0438 \u041c\u0438\u0440\u0435\u0439
    \u0431\u044b\u043b\u0430 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u0430 \u043e\u0434\u043d\u0430
    \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0442\u044c \u0434\u0432\u043e\u0438\u0445 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445
    \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0432 \u043f\u0440\u0438\u0433\u043e\u0440\u043e\u0434\u0435
    \u041f\u0430\u0440\u0438\u0436\u0430. \u041f\u043e \u0438\u0440\u043e\u043d\u0438\u0438
    \u0441\u0443\u0434\u044c\u0431\u044b, \u043f\u043e\u0437\u0434\u043d\u0435\u0435 \u041c\u0438\u0440\u0435\u0439
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u0432\u0441\u043b\u0435\u0434 \u0437\u0430
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c \u043d\u0430 \u044e\u0433
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u0441\u044b\u043d\u043e\u0432\u044c\u044f
    \u043c\u043e\u0433\u043b\u0438 \u0432\u0438\u0434\u0435\u0442\u044c\u0441\u044f \u0441 \u043e\u0442\u0446\u043e\u043c.
    \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0437\u0432\u043e\u0434
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0441\u044f \u043b\u0438\u0448\u044c \u0432 1981
    \u0433\u043e\u0434\u0443. \u041c\u0438\u0440\u0435\u0439 \u0443\u043c\u0435\u0440\u043b\u0430
    \u0432 2008 \u0433\u043e\u0434\u0443, \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u043d\u0430\u044f
    \u0441\u0432\u043e\u0438\u043c\u0438 \u0434\u0435\u0442\u044c\u043c\u0438. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439
    \u0441\u044b\u043d: \u0425\u0430\u043d\u0441 \u0438 \u0414\u0436\u0430\u0441\u0442\u0438\u043d
    \u0421\u043a\u0430\u043b\u044c\u0431\u0430. \u041f\u043e\u043c\u0438\u043c\u043e \u044d\u0442\u0438\u0445
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u0434\u0435\u0442\u0435\u0439, \u0443 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430
    \u0431\u044b\u043b \u0435\u0449\u0435 \u043e\u0434\u0438\u043d \u0441\u044b\u043d \u043f\u043e
    \u0438\u043c\u0435\u043d\u0438 \u0425\u0430\u043d\u0441 (Hans) (\u0438\u043b\u0438 \u0414\u0436\u043e\u043d)
    \u043e\u0442 \u0436\u0435\u043d\u0449\u0438\u043d\u044b \u043f\u043e \u0438\u043c\u0435\u043d\u0438
    \u0414\u0436\u0430\u0441\u0442\u0438\u043d \u0421\u043a\u0430\u043b\u044c\u0431\u0430 (Justine
    Skalba). \u0421\u0443\u0434\u044c\u0431\u0430 \u0425\u0430\u043d\u0441\u0430 \u0442\u0443\u043c\u0430\u043d\u043d\u0430:
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u0443\u043f\u043e\u043c\u044f\u043d\u0443\u043b, \u0447\u0442\u043e \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u0439 \u043e \u043d\u0435\u043c \u0434\u043e\u043b\u0433\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f.\n\n\U0001F333 \u0421\u0435\u043c\u0435\u0439\u043d\u044b\u0435
    \u0443\u0437\u044b: \u0441\u0435\u0441\u0442\u0440\u0430 \u0438 \u043c\u0430\u0442\u044c
    \u041e\u0441\u043e\u0431\u043e\u0435 \u043c\u0435\u0441\u0442\u043e \u0432 \u0436\u0438\u0437\u043d\u0438
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0438
    \u0435\u0433\u043e \u043c\u0430\u0442\u044c \u0425\u0430\u043d\u043a\u0430 \u0438 \u0441\u0432\u043e\u0434\u043d\u0430\u044f
    \u0441\u0435\u0441\u0442\u0440\u0430 \u041c\u0430\u0439\u0434\u0438. \u041c\u0430\u0442\u044c,
    \u0425\u0430\u043d\u043a\u0430 (Johanna \"Hanka\" Grothendieck): \u0418\u0445 \u0441\u0432\u044f\u0437\u044c
    \u0431\u044b\u043b\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u0430 \u0438 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u0430.
    \u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b \u043e\u043d\u0438 \u0436\u0438\u043b\u0438
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0432 \u041c\u043e\u043d\u043f\u0435\u043b\u044c\u0435,
    \u0442\u044f\u0436\u0435\u043b\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u044f, \u0447\u0442\u043e\u0431\u044b
    \u0432\u044b\u0436\u0438\u0442\u044c. \u0425\u0430\u043d\u043a\u0430 \u0431\u043e\u043b\u0435\u043b\u0430
    \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043e\u043c, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u043c
    \u0432 \u043b\u0430\u0433\u0435\u0440\u044f\u0445 \u0434\u043b\u044f \u0438\u043d\u0442\u0435\u0440\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445,
    \u0438 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c \u0432 1957 \u0433\u043e\u0434\u0443.
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u0441\u0432\u043e\u044e \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u0438\u043c\u0435\u043d\u043d\u043e \u0435\u0439. \u0423\u0445\u043e\u0434 \u043c\u0430\u0442\u0435\u0440\u0438
    \u0441\u0442\u0430\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u043f\u043e\u0442\u0435\u0440\u0435\u0439 \u0438, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u043f\u043e\u0432\u043b\u0438\u044f\u043b \u043d\u0430 \u0435\u0433\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u041c\u0438\u0440\u0435\u0439,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0435
    \u043e\u0431\u0435\u0449\u0430\u043d\u0438\u0435. \u0421\u0432\u043e\u0434\u043d\u0430\u044f
    \u0441\u0435\u0441\u0442\u0440\u0430, \u041c\u0430\u0439\u0434\u0438 (Maidi Raddatz): \u0421\u0432\u043e\u0434\u043d\u0430\u044f
    \u0441\u0435\u0441\u0442\u0440\u0430 \u041c\u0430\u0439\u0434\u0438 (\u0434\u043e\u0447\u044c
    \u0425\u0430\u043d\u043a\u0438 \u043e\u0442 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0431\u0440\u0430\u043a\u0430)
    \u043f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0430
    \u0432 \u0421\u0428\u0410. \u0412 \u043a\u043e\u043d\u0446\u0435 1970-\u0445 \u0433\u043e\u0434\u043e\u0432,
    \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b,
    \u043e\u043d\u0430 \u0440\u0435\u0448\u0438\u043b\u0430 \u043d\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044c
    \u0431\u0440\u0430\u0442\u0430. \u042d\u0442\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u043e\u0431\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u043e\u0439.
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043f\u043e-\u0432\u0438\u0434\u0438\u043c\u043e\u043c\u0443, \u0442\u043e\u0441\u043a\u043e\u0432\u0430\u043b
    \u043f\u043e \u043d\u0435\u0439 \u0438 \u0434\u0430\u0436\u0435 \u043f\u0440\u0438\u0441\u043b\u0430\u043b
    \u0434\u0435\u043d\u0435\u0433 \u043d\u0430 \u0434\u043e\u0440\u043e\u0433\u0443, \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0441\u0435\u0441\u0442\u0440\u0443 \u0432 \u0442\u043e\u043c,
    \u0447\u0442\u043e \u043e\u043d\u0430 \u0432\u0442\u043e\u0440\u0433\u043b\u0430\u0441\u044c
    \u0432 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e,
    \u0438 \u0432\u044b\u0433\u043d\u0430\u043b \u0435\u0451 \u0438\u0437 \u0434\u043e\u043c\u0430.
    \u0418\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435
    \u044d\u0442\u043e\u0433\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0440\u0430\u0437\u043e\u0440\u0432\u0430\u043b\u0438\u0441\u044c. \u0415\u0433\u043e \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u0446\u0430
    \u0414\u0438\u0430\u043d\u0430 \u0442\u0430\u043a \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0430
    \u0442\u043e \u0432\u0440\u0435\u043c\u044f: \"\u041c\u044b \u0432\u0441\u0435 \u0435\u0449\u0435
    \u043e\u0431\u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c \u043f\u0430\u0440\u043e\u0439
    \u043f\u0438\u0441\u0435\u043c \u043f\u043e\u0437\u0436\u0435, \u043d\u043e \u043e\u043d\u0438
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438\u0441\u044c \u0432\u0441\u0435 \u0445\u0443\u0436\u0435
    \u0438 \u0445\u0443\u0436\u0435... \u042f \u043f\u043e\u043c\u043d\u044e \u043e\u0434\u043d\u043e
    \u043f\u0438\u0441\u044c\u043c\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043d\u0430
    \u0434\u0430\u0436\u0435 \u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u043b\u0430. \u041e\u043d\u0430
    \u0432\u044b\u0431\u0440\u043e\u0441\u0438\u043b\u0430 \u0435\u0433\u043e \u043f\u0440\u044f\u043c\u043e
    \u0432 \u043c\u0443\u0441\u043e\u0440\u043a\u0443\".\n\n\U0001F64F \"\u0412\u0435\u043b\u0438\u043a\u0438\u0439
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\" \u0438 \u0440\u0430\u0437\u0440\u044b\u0432
    \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c, \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0432\u0448\u0438\u043c
    \u0435\u0433\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c,
    \u0441\u0442\u0430\u043b 1970 \u0433\u043e\u0434, \u043a\u043e\u0433\u0434\u0430 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0443\u0448\u0435\u043b \u0438\u0437 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u0432\u044b\u0441\u0448\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IHES). \u041e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0440\u0432\u0430\u043b
    \u0441 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043c\u0438\u0440\u043e\u043c,
    \u043d\u043e \u0438 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c, \u0443\u0439\u0434\u044f \u0432
    \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438 \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u0441\u043a\u0438\u0439
    \u0430\u043a\u0442\u0438\u0432\u0438\u0437\u043c. \u0415\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u043e\u0442\u0447\u0443\u0436\u0434\u0435\u043d\u043d\u044b\u043c.
    \u0414\u043e\u0447\u044c \u0419\u043e\u0445\u0430\u043d\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433,
    \u0430 \u0437\u0430\u0442\u0435\u043c, \u0432 14 \u043b\u0435\u0442, \u043e\u043d \u0437\u0430\u0431\u0440\u0430\u043b
    \u0435\u0451 \u0438\u0437 \u0448\u043a\u043e\u043b\u044b, \u0441\u0447\u0438\u0442\u0430\u044f
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0440\u0435\u0434\u043d\u044b\u043c,
    \u043d\u043e \u0442\u0430\u043a \u0438 \u043d\u0435 \u0441\u0442\u0430\u043b \u0443\u0447\u0438\u0442\u044c
    \u0435\u0451 \u0441\u0430\u043c. \u0421\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0441\u0431\u043b\u0438\u0437\u0438\u043b\u0441\u044f
    \u0441 \u0434\u0435\u0442\u044c\u043c\u0438 \u2014 \u0432 \u043f\u0438\u0441\u044c\u043c\u0430\u0445
    1979-1980 \u0433\u043e\u0434\u043e\u0432 \u043e\u043d \u043f\u0438\u0441\u0430\u043b \u043e
    \u0442\u0435\u043f\u043b\u044b\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445
    \u0441 \u043d\u0438\u043c\u0438 \u0438 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d\u0438
    \u043d\u0430\u043a\u043e\u043d\u0435\u0446 \u043d\u0430\u0447\u0430\u043b\u0438 \u043d\u0430\u0432\u0435\u0449\u0430\u0442\u044c
    \u0435\u0433\u043e \u043f\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u044d\u0442\u0438 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b \u0431\u044b\u043b\u0438
    \u043d\u0435\u0434\u043e\u043b\u0433\u0438\u043c\u0438 \u0438 \u0441\u043e\u0448\u043b\u0438
    \u043d\u0430 \u043d\u0435\u0442. \u041f\u043e\u0432\u0437\u0440\u043e\u0441\u043b\u0435\u0432,
    \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0435\u0433\u043e \u0434\u0435\u0442\u0435\u0439
    \u0438\u0437\u0431\u0440\u0430\u043b\u0438 \u0436\u0438\u0437\u043d\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u0441\u0430\u043c \u043d\u0430\u0437\u044b\u0432\u0430\u043b \"\u043e\u0442\u0449\u0435\u043f\u0435\u043d\u0446\u0430\u043c\u0438\"
    (breakaways): \u043e\u043d\u0438 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043f\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u043c\u0438
    \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0430\u043c\u0438 \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e\u043c.\n\n\U0001F56F\ufe0f
    \u041e\u0442\u0448\u0435\u043b\u044c\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438
    \u043f\u043e\u043b\u043d\u044b\u0439 \u0443\u0445\u043e\u0434 \u0412 1990 \u0433\u043e\u0434\u0443
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0441\u0436\u0435\u0433 \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u0431\u0443\u043c\u0430\u0433
    \u0438 \u0443\u0435\u0434\u0438\u043d\u0438\u043b\u0441\u044f \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435
    \u041b\u0430\u0441\u0441\u0435\u0440 \u0432 \u041f\u0438\u0440\u0435\u043d\u0435\u044f\u0445.
    \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 20 \u0441 \u043b\u0438\u0448\u043d\u0438\u043c
    \u043b\u0435\u0442 \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u0432\u0435\u043b \u0436\u0438\u0437\u043d\u044c
    \u043e\u0442\u0448\u0435\u043b\u044c\u043d\u0438\u043a\u0430, \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435 \u043e\u0431\u0449\u0430\u044f\u0441\u044c \u0441 \u043b\u044e\u0434\u044c\u043c\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0441\u0432\u043e\u044e \u0441\u0435\u043c\u044c\u044e.
    \u041e\u043d \u0443\u043c\u0435\u0440 13 \u043d\u043e\u044f\u0431\u0440\u044f 2014 \u0433\u043e\u0434\u0430
    \u0432 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0435 \u0433\u043e\u0440\u043e\u0434\u0430
    \u0421\u0435\u043d-\u0416\u0438\u0440\u043e\u043d, \u043e\u0434\u0438\u043d\u043e\u043a\u0438\u0439
    \u0438 \u0437\u0430\u0431\u044b\u0442\u044b\u0439 \u043c\u0438\u0440\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u043a\u043e\u0433\u0434\u0430-\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b."
  personalLifeEn: 
  shortBioRu: "\u0410\u043b\u0435\u043a\u0441\u0430\u0301\u043d\u0434\u0440 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u0301\u043a
    (1928\u20132014) \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430,
    \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c
    \u0436\u0435 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0439 \u0438 \u043d\u0435\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0439,
    \u043a\u0430\u043a \u0438 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u0438. \u041e\u043d \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0438\u043b \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u043d\u043e \u0435\u0433\u043e
    \u043f\u0443\u0442\u044c \u0431\u044b\u043b \u043e\u0442\u043c\u0435\u0447\u0435\u043d \u0432\u043e\u0439\u043d\u043e\u0439,
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u0438\u0437\u043c\u043e\u043c
    \u0438 \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u044b\u043c \u0437\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c.\n\n\U0001F4DC
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0431\u0443\u0440\u043d\u043e\u0435
    \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435
    28 \u043c\u0430\u0440\u0442\u0430 1928 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0435\u0440\u043e\u0432-\u0430\u043d\u0430\u0440\u0445\u0438\u0441\u0442\u043e\u0432.
    \u041e\u0442\u0435\u0446, \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u00ab\u0421\u0430\u0448\u0430\u00bb
    \u0428\u0430\u043f\u0438\u0440\u043e (\u043e\u043a. 1890\u20131942): \u0420\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0435
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041d\u043e\u0432\u043e\u0437\u044b\u0431\u043a\u043e\u0432
    (\u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0430\u044f \u0438\u043c\u043f\u0435\u0440\u0438\u044f).
    \u0421 \u044e\u043d\u043e\u0441\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438,
    \u0431\u044b\u043b \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u0435\u043d \u043a \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0439
    \u043a\u0430\u0437\u043d\u0438, \u0437\u0430\u043c\u0435\u043d\u0435\u043d\u043d\u043e\u0439
    \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0439 \u043a\u0430\u0442\u043e\u0440\u0433\u043e\u0439,
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u0435\u0436\u0430\u043b \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438 1917
    \u0433\u043e\u0434\u0430. \u0412 \u0431\u043e\u044f\u0445 \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u043b\u0435\u0432\u0443\u044e \u0440\u0443\u043a\u0443. \u0412 1921 \u0433\u043e\u0434\u0443
    \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e.
    \u041c\u0430\u0442\u044c, \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u00ab\u0425\u0430\u043d\u043a\u0430\u00bb
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a (1900\u20131957): \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0438 \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0435,
    \u0431\u044b\u043b\u0430 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u043a\u043e\u0439
    \u0438 \u043b\u0435\u0432\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u0438\u0441\u0442\u043a\u043e\u0439.
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u043d\u043e\u0441\u0438\u043b \u0444\u0430\u043c\u0438\u043b\u0438\u044e
    \u043c\u0430\u0442\u0435\u0440\u0438, \u0442\u0430\u043a \u043a\u0430\u043a \u0435\u0433\u043e
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u043d\u0435 \u0431\u044b\u043b\u0438 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u0436\u0435\u043d\u0430\u0442\u044b. \u0412 1933 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0413\u0438\u0442\u043b\u0435\u0440\u0430 \u043a
    \u0432\u043b\u0430\u0441\u0442\u0438, \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0431\u0435\u0436\u0430\u043b\u0438
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e, \u043e\u0441\u0442\u0430\u0432\u0438\u0432
    5-\u043b\u0435\u0442\u043d\u0435\u0433\u043e \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430
    \u043d\u0430 \u043f\u043e\u043f\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0430\u0441\u0442\u043e\u0440\u0430
    \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430 \u0425\u0435\u0439\u0434\u043e\u0440\u043d\u0430
    \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0435. \u0412 1939 \u0433\u043e\u0434\u0443,
    \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c \u0437\u0430 \u0435\u0433\u043e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c,
    \u043f\u0440\u0438\u0435\u043c\u043d\u044b\u0435 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0438 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430
    \u043a \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f\u043c
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0440\u0430\u0437\u0440\u0430\u0437\u0438\u043b\u0430\u0441\u044c \u0412\u0442\u043e\u0440\u0430\u044f
    \u043c\u0438\u0440\u043e\u0432\u0430\u044f \u0432\u043e\u0439\u043d\u0430. \u041e\u0442\u0435\u0446
    \u0431\u044b\u043b \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u0430\u043d \u0438 \u0432
    1942 \u0433\u043e\u0434\u0443 \u0434\u0435\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d
    \u0432 \u041e\u0441\u0432\u0435\u043d\u0446\u0438\u043c, \u0433\u0434\u0435 \u043f\u043e\u0433\u0438\u0431.
    \u041c\u0430\u0442\u044c \u0438 \u0441\u044b\u043d \u0431\u044b\u043b\u0438 \u0438\u043d\u0442\u0435\u0440\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u044b
    \u0432 \u043b\u0430\u0433\u0435\u0440\u044f \u0434\u043b\u044f \u00ab\u043d\u0435\u0431\u043b\u0430\u0433\u043e\u043d\u0430\u0434\u0435\u0436\u043d\u044b\u0445
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u0446\u0435\u0432\u00bb (\u0420\u044c\u0435\u043a\u0440\u043e,
    \u0413\u044e\u0440\u0441). \u041c\u0430\u0442\u044c \u0437\u0430\u0440\u0430\u0437\u0438\u043b\u0430\u0441\u044c
    \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043e\u043c, \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043f\u043e\u0437\u0436\u0435 \u0443\u043c\u0435\u0440\u043b\u0430. \u0421\u0430\u043c
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0431\u044b\u043b \u0440\u0430\u0437\u043b\u0443\u0447\u0435\u043d
    \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0432\u043e\u0439\u043d\u044b \u0436\u0438\u043b \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435
    \u0428\u0430\u043c\u0431\u043e\u043d-\u0441\u044e\u0440-\u041b\u0438\u043d\u044c\u043e\u043d,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u0442\u0435\u043c, \u0447\u0442\u043e
    \u0435\u0435 \u0436\u0438\u0442\u0435\u043b\u0438 \u0443\u043a\u0440\u044b\u0432\u0430\u043b\u0438
    \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0445 \u0434\u0435\u0442\u0435\u0439. \u0422\u0430\u043c
    \u043e\u043d \u043f\u043e\u0441\u0435\u0449\u0430\u043b \u0448\u043a\u043e\u043b\u0443 \u041a\u043e\u043b\u043b\u0435\u0436
    \u0421\u0435\u0432\u0435\u043d\u043e\u043b\u044c, \u0433\u0434\u0435 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.\n\n\U0001F393 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u043f\u0443\u0442\u0438 \u041f\u043e\u0441\u043b\u0435
    \u0432\u043e\u0439\u043d\u044b \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0432\u043e\u0441\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043b\u0441\u044f
    \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e, \u0438 \u043e\u043d\u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0438
    \u0432 \u041c\u043e\u043d\u043f\u0435\u043b\u044c\u0435, \u0433\u0434\u0435 \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0412 1948 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430.
    \u0423\u0436\u0435 \u0442\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0441\u0435\u0431\u044f \u043a\u0430\u043a \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439
    \u043c\u044b\u0441\u043b\u0438\u0442\u0435\u043b\u044c, \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043f\u043e\u0447\u0442\u0438 \u0431\u0435\u0437 \u043f\u043e\u043c\u043e\u0449\u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439,
    \u00ab\u043f\u0435\u0440\u0435\u043e\u0442\u043a\u0440\u044b\u0432\u00bb \u0442\u0435\u043e\u0440\u0438\u044e
    \u043c\u0435\u0440\u044b \u041b\u0435\u0431\u0435\u0433\u0430. \u041f\u043e \u0441\u043e\u0432\u0435\u0442\u0443
    \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u0435\u0449\u0430\u0442\u044c \u0441\u0435\u043c\u0438\u043d\u0430\u0440
    \u0410\u043d\u0440\u0438 \u041a\u0430\u0440\u0442\u0430\u043d\u0430 \u0432 \u0412\u044b\u0441\u0448\u0435\u0439
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u0435.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u044b
    \u0431\u044b\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043f\u043e\u043d\u0430\u0447\u0430\u043b\u0443
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0432\u044b\u0441\u043e\u043a. \u041f\u043e
    \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u041a\u0430\u0440\u0442\u0430\u043d\u0430
    \u0438 \u0410\u043d\u0434\u0440\u0435 \u0412\u0435\u0439\u043b\u044f \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041d\u0430\u043d\u0441\u0438,
    \u0433\u0434\u0435 \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0416\u0430\u043d\u0430 \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435 \u0438 \u041b\u043e\u0440\u0430\u043d\u0430
    \u0428\u0432\u0430\u0440\u0446\u0430 \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u043e\u043c. \u0412 \u041d\u0430\u043d\u0441\u0438
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b
    \u0444\u0443\u0440\u043e\u0440: \u0435\u043c\u0443 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438
    \u0441\u043f\u0438\u0441\u043e\u043a \u0438\u0437 14 \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432,
    \u0438 \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0438\u0445 \u0432\u0441\u0435 \u0437\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u0435\u0433\u043e \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438, \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u043d\u043e\u0439
    \u0432 1953 \u0433\u043e\u0434\u0443.\n\n\U0001F4A1 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0440\u043e\u0440\u044b\u0432 \u0438 \u00ab\u0437\u043e\u043b\u043e\u0442\u044b\u0435
    \u0433\u043e\u0434\u044b\u00bb \u041d\u0430\u0447\u0430\u0432 \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435 1950-\u0445 \u0440\u0435\u0437\u043a\u043e
    \u0441\u043c\u0435\u043d\u0438\u043b \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0438 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b,
    \u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u00ab\u0422\u043e\u0445\u043e\u043a\u0443
    paper\u00bb (1957), \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432
    \u043c\u043e\u0449\u043d\u044b\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439.
    \u0412 1958 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0439 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u0432\u044b\u0441\u0448\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IHES) \u043f\u043e\u0434 \u041f\u0430\u0440\u0438\u0436\u0435\u043c. \u042d\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0435\u0433\u043e
    \u0441\u0430\u043c\u043e\u0433\u043e \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0433\u043e
    \u043f\u0435\u0440\u0438\u043e\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u00ab\u0437\u043e\u043b\u043e\u0442\u044b\u043c \u0432\u0435\u043a\u043e\u043c\u00bb. \u041f\u043e\u0434
    \u0435\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0432 IHES \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440 \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 (SGA), \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0432\u0438\u0434\u0435 \u043c\u043d\u043e\u0433\u043e\u0442\u043e\u043c\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432. \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0416\u0430\u043d\u043e\u043c \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435 \u043e\u043d
    \u043d\u0430\u0447\u0430\u043b \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430 \u00ab\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb (EGA), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b \u0441\u0442\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u043c
    \u0411\u0438\u0431\u043b\u0438\u0435\u0439 \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u0411\u044b\u043b\u043e \u0432\u044b\u043f\u0443\u0449\u0435\u043d\u043e 4 \u0442\u043e\u043c\u0430
    (\u0432 8 \u043a\u043d\u0438\u0433\u0430\u0445), \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e\u0439. \u0412 1966
    \u0433\u043e\u0434\u0443 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0431\u044b\u043b
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043c\u0435\u0434\u0430\u043b\u0438 \u2014 \u0432\u044b\u0441\u0448\u0435\u0439 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043b\u0438\u0447\u043d\u043e
    \u043f\u0440\u0438\u0435\u0445\u0430\u0442\u044c \u043d\u0430 \u0446\u0435\u0440\u0435\u043c\u043e\u043d\u0438\u044e
    \u0432 \u041c\u043e\u0441\u043a\u0432\u0443 \u0432 \u0437\u043d\u0430\u043a \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430
    \u043f\u0440\u043e\u0442\u0438\u0432 \u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0438\u043d\u0430\u043a\u043e\u043c\u044b\u0441\u043b\u0438\u044f \u0432 \u0421\u0421\u0421\u0420.\n\n\U0001F6A9
    \u0420\u0430\u0437\u0440\u044b\u0432 \u0441 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u043c
    \u0438 \u0443\u0445\u043e\u0434 \u0438\u0437 \u043d\u0430\u0443\u043a\u0438 \u0412 1970
    \u0433\u043e\u0434\u0443 \u0432 \u0436\u0438\u0437\u043d\u0438 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b \u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u043f\u0435\u0440\u0435\u043b\u043e\u043c. \u041e\u043d \u0443\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e IHES \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044f
    \u0437\u0430 \u0441\u0447\u0435\u0442 \u0432\u043e\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432,
    \u0438, \u0431\u0443\u0434\u0443\u0447\u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u043e\u043c \u0438 \u044d\u043a\u043e\u043b\u043e\u0433\u043e\u043c,
    \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u043e\u0434\u0430\u043b
    \u0432 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0443. \u041e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0433\u0440\u0443\u043f\u043f\u0443 \u00ab\u0412\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u0435\u00bb
    (Survival), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u043e\u0440\u043e\u043b\u0430\u0441\u044c
    \u043f\u0440\u043e\u0442\u0438\u0432 \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u044b \u0438 \u043c\u0438\u043b\u0438\u0442\u0430\u0440\u0438\u0437\u043c\u0430.
    \u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0443\u0448\u0435\u043b \u0438\u0437 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0414\u043e \u0441\u0432\u043e\u0435\u0439
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0435\u043d\u0441\u0438\u0438
    \u0432 1988 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u041c\u043e\u043d\u043f\u0435\u043b\u044c\u0435,
    \u043d\u043e \u0435\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438\u0441\u044c
    \u0432\u0441\u0435 \u0431\u043e\u043b\u0435\u0435 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438,
    \u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u0441\u043c\u0435\u0449\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438,
    \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u044d\u0437\u043e\u0442\u0435\u0440\u0438\u043a\u0438.\n\n\U0001F4D6
    \u041e\u0442\u0448\u0435\u043b\u044c\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    20 \u0441 \u043b\u0438\u0448\u043d\u0438\u043c \u043b\u0435\u0442 \u0436\u0438\u0437\u043d\u0438
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u043f\u0440\u043e\u0432\u0435\u043b
    \u043f\u043e\u0447\u0442\u0438 \u043a\u0430\u043a \u043e\u0442\u0448\u0435\u043b\u044c\u043d\u0438\u043a
    \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435 \u041b\u0430\u0441\u0435\u0440 \u0432
    \u041f\u0438\u0440\u0435\u043d\u0435\u044f\u0445. \u041e\u043d \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \u043e\u0442 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432 \u0441 \u0432\u043d\u0435\u0448\u043d\u0438\u043c
    \u043c\u0438\u0440\u043e\u043c \u0438 \u0434\u0430\u0436\u0435 \u0437\u0430\u043f\u0440\u0435\u0442\u0438\u043b
    \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u0438 \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u0432\u0430\u0442\u044c
    \u0441\u0442\u0430\u0440\u044b\u0435 \u0442\u0440\u0443\u0434\u044b. \u0412 1988 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u041a\u0440\u0430\u0444\u043e\u0440\u0434\u0430. \u041e\u043d
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u0432\u043e\u043f\u043b\u043e\u0449\u0435\u043d\u043d\u043e\u0435
    \u0432 \u0442\u044b\u0441\u044f\u0447\u0430\u0445 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u043e\u0432 SGA \u0438 EGA, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u0445
    \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439,
    \u0441\u0430\u043c\u043e\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u0438\u0437
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u00abR\u00e9coltes et Semailles\u00bb (\u00ab\u0416\u0430\u0442\u0432\u044b \u0438 \u043f\u043e\u0441\u0435\u0432\u044b\u00bb).
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 13 \u043d\u043e\u044f\u0431\u0440\u044f
    2014 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0421\u0435\u043d-\u0416\u0438\u0440\u043e\u043d
    (\u0424\u0440\u0430\u043d\u0446\u0438\u044f)."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u0440\u0430\u0436\u0430\u044e\u0442 \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u043d\u0435 \u043c\u0435\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438.
    \u0412\u043e\u0442 \u043b\u0438\u0448\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432, \u0440\u0438\u0441\u0443\u044e\u0449\u0438\u0445 \u0435\u0433\u043e
    \u043d\u0435\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u0439 \u043f\u043e\u0440\u0442\u0440\u0435\u0442.\n\n\U0001F9D2
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e, \u0432\u043e\u0439\u043d\u0430 \u0438 \u044e\u043d\u043e\u0448\u0435\u0441\u0442\u0432\u043e:
    \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f \u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u041f\u043e\u0431\u0435\u0433 \u0438 \u043f\u043b\u0430\u043d \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430
    \u0413\u0438\u0442\u043b\u0435\u0440\u0430: \u0412 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u044c
    \u043b\u0435\u0442, \u043d\u0430\u0445\u043e\u0434\u044f\u0441\u044c \u0432 \u043b\u0430\u0433\u0435\u0440\u0435
    \u0434\u043b\u044f \u0438\u043d\u0442\u0435\u0440\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043f\u0440\u0438\u043d\u044f\u043b \u0434\u0435\u0440\u0437\u043a\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435.
    \u041e\u043d \u0441\u0431\u0435\u0436\u0430\u043b \u0438 \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u043f\u0440\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u043a \u0413\u0438\u0442\u043b\u0435\u0440\u0443,
    \u0447\u0442\u043e\u0431\u044b \u0443\u0431\u0438\u0442\u044c \u0435\u0433\u043e. \u042d\u0442\u043e\u0442
    \u044d\u043f\u0438\u0437\u043e\u0434 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u044c
    \u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043d \u043f\u0440\u043e\u043d\u0435\u0441 \u0447\u0435\u0440\u0435\u0437 \u0432\u0441\u044e
    \u0436\u0438\u0437\u043d\u044c. \u0421\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u043f\u0435\u0440\u0435\u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438:
    \u0412 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u041c\u043e\u043d\u043f\u0435\u043b\u044c\u0435,
    \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0441\u044c
    \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f,
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0437\u0430\u043d\u043e\u0432\u043e \u043e\u0442\u043a\u0440\u044b\u043b \u0434\u043b\u044f
    \u0441\u0435\u0431\u044f \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u0435\u0440\u044b \u041b\u0435\u0431\u0435\u0433\u0430,
    \u043d\u0435 \u0437\u043d\u0430\u044f, \u0447\u0442\u043e \u044d\u0442\u043e \u0443\u0436\u0435
    \u0431\u044b\u043b\u043e \u0441\u0434\u0435\u043b\u0430\u043d\u043e \u0434\u043e \u043d\u0435\u0433\u043e.
    \u0423\u0437\u043d\u0430\u0432, \u0447\u0442\u043e \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u0441\u044f
    \u0432 \u0441\u0432\u043e\u0435\u043c \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u041f\u0435\u0440\u0432\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u0440\u0443\u0433\u0430:
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u043b\u0430\u0433\u0435\u0440\u0435 \u0434\u043b\u044f
    \u0438\u043d\u0442\u0435\u0440\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438\u043b\u0435\u0442\u043d\u0438\u0439
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043e\u0442 \u0434\u0440\u0443\u0433\u043e\u0439 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u043e\u0439,
    \u0434\u0435\u0432\u043e\u0447\u043a\u0438 \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u041c\u0430\u0440\u0438\u044f,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u0440\u0443\u0433\u0430
    \u043a\u0430\u043a \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0442\u043e\u0447\u0435\u043a,
    \u0440\u0430\u0432\u043d\u043e\u0443\u0434\u0430\u043b\u0435\u043d\u043d\u044b\u0445 \u043e\u0442
    \u0446\u0435\u043d\u0442\u0440\u0430. \u042d\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u043e \u0435\u0433\u043e \u0441\u0432\u043e\u0435\u0439
    \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u043e\u0439 \u0438 \u044f\u0441\u043d\u043e\u0441\u0442\u044c\u044e,
    \u0438 \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b \u043e\u043d \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b
    \u0435\u0433\u043e \u043a\u0430\u043a \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043e\u0442\u043a\u0440\u044b\u043b\u0430\u0441\u044c
    \u0435\u043c\u0443 \u0441 \u043d\u043e\u0432\u043e\u0439, \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0439
    \u0441\u0442\u043e\u0440\u043e\u043d\u044b. \"\u0413\u0440\u0443\u0431\u043e\u0441\u0442\u044c\"
    \u0441 \u043f\u0435\u0440\u0432\u044b\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c:
    \u041f\u0440\u0438\u0435\u0445\u0430\u0432 \u0432 \u041d\u0430\u043d\u0441\u0438, \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0441\u0432\u043e\u044e \u0440\u0430\u043d\u043d\u044e\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u043c
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u043c \u0416\u0430\u043d\u0443 \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435,
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0431\u0443\u0434\u0443\u0449\u0435\u043c\u0443 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0443.
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0431\u044b\u043b\u0430 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u0432\u0435\u0440\u043d\u043e\u0439, \u043d\u043e \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0439
    \u0438 \u0431\u0435\u0441\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e\u0439. \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0441\u0432\u043e\u0435\u0439 \u0440\u0435\u0437\u043a\u043e\u0441\u0442\u044c\u044e,
    \u0443\u0441\u0442\u0440\u043e\u0438\u043b \u0435\u043c\u0443 \"\u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u0443\u044e
    \u0432\u0437\u0431\u0443\u0447\u043a\u0443\" \u0437\u0430 \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0435
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0440\u0430\u0434\u0438 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044f.
    \u042d\u0442\u043e\u0442 \u0443\u0440\u043e\u043a \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a,
    \u043f\u043e-\u0432\u0438\u0434\u0438\u043c\u043e\u043c\u0443, \u0443\u0441\u0432\u043e\u0438\u043b,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0442\u0435\u043e\u0440\u0438\u0438,
    \u043f\u0440\u0438 \u0432\u0441\u0435\u0439 \u0438\u0445 \u0433\u043b\u0443\u0431\u0438\u043d\u0435,
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u043b\u0438 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b
    \u043d\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c.\n\n\U0001F464 \u041b\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438: \u0447\u0443\u0434\u0430\u0447\u0435\u0441\u0442\u0432\u0430
    \u0433\u0435\u043d\u0438\u044f \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043e\u0448\u0438\u0431\u043a\u0430: \u0411\u0443\u0434\u0443\u0447\u0438 \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0443\u043c\u043e\u0432
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043e\u0448\u0438\u0431\u0441\u044f \u0438 \u043f\u0440\u0438\u043d\u044f\u043b \u0447\u0438\u0441\u043b\u043e
    57 \u0437\u0430 \u043f\u0440\u043e\u0441\u0442\u043e\u0435. \u042d\u0442\u043e\u0442 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442 \u0441\u043b\u0443\u0436\u0438\u0442 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435\u043c,
    \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u0433\u0435\u043d\u0438\u0438 \u043d\u0435
    \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u044b \u043e\u0442 \u00ab\u0441\u0431\u043e\u0435\u0432\u00bb
    \u043c\u043e\u0437\u0433\u0430. \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0431\u0435\u0437
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u0430: \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u043d\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u0432\u043e\u0435\u043d\u043d\u043e\u0439
    \u0441\u043b\u0443\u0436\u0431\u044b. \u041e\u043d \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u043d\u0430\u043d\u0441\u0435\u043d\u043e\u0432\u0441\u043a\u0438\u043c \u043f\u0430\u0441\u043f\u043e\u0440\u0442\u043e\u043c
    \u0434\u043b\u044f \u0431\u0435\u0436\u0435\u043d\u0446\u0435\u0432 \u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 1980-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0441\u0442\u0430\u043b \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u041f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    vs. \u0411\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u044f: \u041a\u043e\u0433\u0434\u0430
    \u0435\u0433\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434,
    \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u0442\u044c
    \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043d\u0435
    \u0441\u0432\u0435\u0440\u0433\u0430\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0421\u0428\u0410, \u0437\u0430\u044f\u0432\u0438\u0432, \u0447\u0442\u043e \u0433\u043e\u0442\u043e\u0432
    \u0441\u0438\u0434\u0435\u0442\u044c \u0432 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0439
    \u0442\u044e\u0440\u044c\u043c\u0435, \u0435\u0441\u043b\u0438 \u0435\u043c\u0443 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044f\u0442
    \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043a\u043d\u0438\u0433\u0430\u043c. \u0421\u043a\u0440\u043e\u043c\u043d\u044b\u0439
    \u0431\u044b\u0442: \u0412 \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0438 \u043e\u043d
    \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e \u0435\u0441\u0442 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0431\u0430\u043d\u0430\u043d\u044b, \u0445\u043b\u0435\u0431 \u0438 \u043c\u043e\u043b\u043e\u043a\u043e,
    \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0432\u0440\u0435\u043c\u044f
    \u043d\u0430 \u0435\u0434\u0443. \u041c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0435
    \u043d\u0430\u043a\u043b\u043e\u043d\u043d\u043e\u0441\u0442\u0438: \u0412 \u041d\u0430\u043d\u0441\u0438
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a, \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u0432\u0448\u0438\u0441\u044c
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u0434\u0440\u0443\u0433\u0430, \u0440\u0435\u0448\u0438\u043b
    \u043d\u0430\u0443\u0447\u0438\u0442\u044c\u0441\u044f \u0438\u0433\u0440\u0430\u0442\u044c
    \u043d\u0430 \u043f\u0438\u0430\u043d\u0438\u043d\u043e. \u041e\u043d \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b
    \u0434\u0440\u0443\u0433\u0430 \u0430\u0440\u0435\u043d\u0434\u043e\u0432\u0430\u0442\u044c
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442,
    \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0432 \u044d\u0442\u043e \u0442\u0435\u043c,
    \u0447\u0442\u043e \u0441\u0430\u043c \u043e\u043d \u043e\u0434\u0435\u0442 \u043d\u0435
    \u043f\u043e\u0434\u043e\u0431\u0430\u044e\u0449\u0435. \u041e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0442\u0430\u043a \u0443\u0441\u0435\u0440\u0434\u043d\u043e, \u0447\u0442\u043e \u0438\u0433\u0440\u0430\u043b
    \u0434\u043e \u043f\u043e\u0437\u0434\u043d\u0435\u0439 \u043d\u043e\u0447\u0438, \u0438\u0437-\u0437\u0430
    \u0447\u0435\u0433\u043e \u0435\u0433\u043e \u0445\u043e\u0437\u044f\u0439\u043a\u0438 \u0432\u044b\u0433\u043e\u043d\u044f\u043b\u0438
    \u0435\u0433\u043e \u0441 \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u044b \u2014 \u043f\u043e
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c,
    \u043e\u043d \u0441\u043c\u0435\u043d\u0438\u043b \u0436\u0438\u043b\u044c\u0435 23 \u0440\u0430\u0437\u0430!
    \u0414\u0430\u0440 \u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u044f: \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \"\u043a\u0440\u0435\u0441\u0442\u043d\u044b\u043c
    \u043e\u0442\u0446\u043e\u043c\" \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432, \u0434\u0430\u0432\u0430\u044f \u0438\u043c
    \u043c\u0435\u0442\u043a\u0438\u0435 \u0438 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0438\u043c\u0435\u043d\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \"\u043c\u043e\u0442\u0438\u0432\u044b\",
    \"\u0442\u043e\u043f\u043e\u0441\u044b\"). \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0420\u0430\u0432\u0438 \u0412\u0430\u043a\u0438\u043b\u0443,
    \"\u0432 \u0443\u043c\u0435\u043d\u0438\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0432\u0435\u0449\u0438 \u0435\u0441\u0442\u044c \u043e\u0433\u0440\u043e\u043c\u043d\u0430\u044f
    \u0441\u0438\u043b\u0430\".\n\n\U0001F4A1 \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043e\u0431\u0440\u0430\u0437
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u041c\u0435\u0442\u043e\u0434 \"\u0441\u043f\u0435\u043b\u043e\u0433\u043e
    \u0430\u0432\u043e\u043a\u0430\u0434\u043e\": \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b \u0441\u0432\u043e\u0439 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0441 \u0432\u0441\u043a\u0440\u044b\u0442\u0438\u0435\u043c
    \u043e\u0440\u0435\u0445\u0430. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e
    \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u043b\u043e\u0442\u044c \u0435\u0433\u043e \u043c\u043e\u043b\u043e\u0442\u043a\u043e\u043c
    (\u043a\u0430\u043a \u0434\u0435\u043b\u0430\u043b\u0438 \u0434\u0440\u0443\u0433\u0438\u0435),
    \u043e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b \"\u0440\u0430\u0437\u043c\u0430\u0447\u0438\u0432\u0430\u0442\u044c
    \u0435\u0433\u043e \u0432 \u0432\u043e\u0434\u0435\", \u0432\u044b\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044f
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0437\u0430\u0434\u0430\u0447\u0438 \u0446\u0435\u043b\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e. \u041a\u043e\u0433\u0434\u0430 \"\u0432\u0440\u0435\u043c\u044f
    \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442, \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u043d\u0430\u0436\u0430\u0442\u0438\u044f \u0440\u0443\u043a\u0438, \u0438 \u0441\u043a\u043e\u0440\u043b\u0443\u043f\u0430
    \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u043a\u0430\u043a \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e
    \u0441\u043e\u0437\u0440\u0435\u0432\u0448\u0438\u0439 \u0430\u0432\u043e\u043a\u0430\u0434\u043e\".
    \"\u0418\u0441\u043f\u043e\u0440\u0447\u0435\u043d\u043d\u044b\u0439\" \u0441\u0442\u0438\u043b\u044c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430: \u041e\u043d
    \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0420\u0438\u043c\u0430\u043d\u0430-\u0420\u043e\u0445\u0430,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u043e \u0431\u044b\u043b\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043e \u043d\u0430 \"\u0442\u0440\u044e\u043a\u0435\",
    \u0430 \u043d\u0435 \u043d\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u0445\u043e\u0442\u0435\u043b \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c.
    \u0415\u0433\u043e \u043d\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b\u043e
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0412\u0435\u0439\u043b\u044f \u041f\u044c\u0435\u0440\u043e\u043c \u0414\u0435\u043b\u0438\u043d\u0435\u043c,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0432 \u043d\u0435\u043c \u0442\u043e\u0436\u0435
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \"\u0442\u0440\u044e\u043a\",
    \u0430 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0449\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b.
    \"\u041a\u0442\u043e \u0441\u0442\u0440\u043e\u0438\u0442 \u0434\u043e\u043c\": \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u0434\u0435\u043b\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u043d\u0430 \u0434\u0432\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438:
    \u0442\u0435\u0445, \u043a\u0442\u043e \u0443\u043b\u0443\u0447\u0448\u0430\u0435\u0442
    \u0438\u043b\u0438 \u043e\u0431\u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442
    \u0433\u043e\u0442\u043e\u0432\u044b\u0439 \"\u0434\u043e\u043c\" \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439, \u0438 \u0442\u0435\u0445, \u043a\u0442\u043e \u0441\u0442\u0440\u043e\u0438\u0442
    \u043d\u043e\u0432\u044b\u0435 \u0434\u043e\u043c\u0430. \u041a \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c
    \u043e\u043d \u043f\u0440\u0438\u0447\u0438\u0441\u043b\u044f\u043b \u0438 \u0441\u0435\u0431\u044f.\n\n\U0001F631
    \u0420\u0430\u0437\u0440\u044b\u0432 \u0441 \u043c\u0438\u0440\u043e\u043c \u0438 \u043f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b: \u044d\u0437\u043e\u0442\u0435\u0440\u0438\u043a\u0430 \u0438
    \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u044f \"\u0412\u0435\u043b\u0438\u043a\u0438\u0439
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\" 1970 \u0433\u043e\u0434\u0430: \u041e\u043d
    \u0448\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043b \u043c\u0438\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0443\u0439\u0434\u044f \u0438\u0437 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0433\u043e
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0432\u044b\u0441\u0448\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IHES) \u0432 \u0437\u043d\u0430\u043a \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430
    \u043f\u0440\u043e\u0442\u0438\u0432 \u0432\u043e\u0435\u043d\u043d\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f.
    \u041e\u043d \u043d\u0430\u0434\u0435\u044f\u043b\u0441\u044f, \u0447\u0442\u043e \u0437\u0430
    \u043d\u0438\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0442 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435,
    \u043d\u043e \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0435.
    \u041f\u0443\u0442\u044c \u0432 \u044d\u0437\u043e\u0442\u0435\u0440\u0438\u043a\u0443:
    \u041f\u043e\u0441\u043b\u0435 \u0443\u0445\u043e\u0434\u0430 \u0438\u0437 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0435\u0439, \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0435\u0439,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u044d\u0437\u043e\u0442\u0435\u0440\u0438\u043a\u043e\u0439.
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u00ab\u041a\u043b\u044e\u0447 \u043a \u0441\u043d\u0430\u043c,
    \u0438\u043b\u0438 \u0414\u0438\u0430\u043b\u043e\u0433 \u0441 \u0413\u043e\u0441\u043f\u043e\u0434\u043e\u043c
    \u0411\u043e\u0433\u043e\u043c\u00bb, \u0433\u0434\u0435 \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u0411\u043e\u0433\u0430 \u0447\u0435\u0440\u0435\u0437 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0441\u043d\u043e\u0432\u0438\u0434\u0435\u043d\u0438\u0439. \u041e\u0442\u0448\u0435\u043b\u044c\u043d\u0438\u043a
    \u0432 \u041f\u0438\u0440\u0435\u043d\u0435\u044f\u0445: \u0412 1991 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0438\u0441\u0447\u0435\u0437 \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435
    \u041b\u0430\u0441\u0441\u0435\u0440 \u0432 \u041f\u0438\u0440\u0435\u043d\u0435\u044f\u0445,
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0440\u0432\u0430\u0432
    \u0441 \u0432\u043d\u0435\u0448\u043d\u0438\u043c \u043c\u0438\u0440\u043e\u043c, \u0441\u0435\u043c\u044c\u0435\u0439
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438. \u0415\u0433\u043e \u0434\u043e\u0447\u044c
    \u0419\u043e\u0445\u0430\u043d\u043d\u0430 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0430:
    \"\u041a\u043e\u0433\u0434\u0430 \u043c\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u043b\u0438
    \u0435\u043c\u0443 \u043f\u0438\u0441\u044c\u043c\u043e, \u043e\u043d\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u043b\u043e\u0441\u044c
    \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044e\".
    \"\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0437\u043b\u0430\" \u0438 15 000 \u0441\u0442\u0440\u0430\u043d\u0438\u0446:
    \u0416\u0438\u0432\u044f \u0432 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438, \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043e\u043a\u043e\u043b\u043e 70 000 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439. \u041e\u0434\u043d\u0430 \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u043e\u0431\u044a\u0435\u043c\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0435\u0439
    \u2014 \u00ab\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0437\u043b\u0430\u00bb,
    \u0433\u0434\u0435 \u043e\u043d \u043d\u0430 15 000 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u044f\u0435\u0442 \u043e \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0435
    \u0438 \u0441\u0430\u0442\u0430\u043d\u0435, \u043f\u044b\u0442\u0430\u044f\u0441\u044c
    \u043f\u043e\u043d\u044f\u0442\u044c \u043f\u0440\u0438\u0440\u043e\u0434\u0443 \u0437\u043b\u0430
    \u0432 \u043c\u0438\u0440\u0435. \u041e\u043d \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f
    \u0434\u0438\u0441\u0442\u0438\u043b\u043b\u044f\u0446\u0438\u0435\u0439 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0439,
    \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c
    \u0438\u0445 \"\u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u043a \u043d\u0435\u0432\u0437\u0433\u043e\u0434\u0430\u043c\" \u2014 \u044d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u0430\u044f
    \u0430\u043b\u0445\u0438\u043c\u0438\u044f \u0432 \u043f\u043e\u0438\u0441\u043a\u0430\u0445
    \u043e\u0442\u0432\u0435\u0442\u0430 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u043f\u043e\u0447\u0435\u043c\u0443 \u0432 \u043c\u0438\u0440\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0437\u043b\u043e. \u041f\u0440\u043e\u0441\u044c\u0431\u0430 \u043e \u0440\u0435\u0432\u043e\u043b\u044c\u0432\u0435\u0440\u0435:
    \u0417\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432
    \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438, \u0432 2014 \u0433\u043e\u0434\u0443,
    \u043e\u043d \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b \u0441\u0432\u043e\u0435\u0433\u043e
    \u0441\u043e\u0441\u0435\u0434\u0430 \u043a\u0443\u043f\u0438\u0442\u044c \u0435\u043c\u0443
    \u0440\u0435\u0432\u043e\u043b\u044c\u0432\u0435\u0440, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0441\u0442\u0440\u0435\u043b\u0438\u0442\u044c\u0441\u044f.
    \u0417\u0430\u043f\u0440\u0435\u0442 \u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e:
    \u0412 2010 \u0433\u043e\u0434\u0443 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043f\u0438\u0441\u044c\u043c\u043e,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438
    \u0437\u0430\u043f\u0440\u0435\u0442\u0438\u043b \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u0432\u0430\u0442\u044c
    \u043b\u044e\u0431\u044b\u0435 \u0441\u0432\u043e\u0438 \u0442\u0435\u043a\u0441\u0442\u044b
    \u0432 \u043b\u044e\u0431\u043e\u0439 \u0444\u043e\u0440\u043c\u0435. \u042d\u0442\u043e
    \u0431\u044b\u043b \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439
    \u0436\u0435\u0441\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043d\u0430\u0434
    \u0441\u0432\u043e\u0438\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435\u043c."
