  id: grothendieck
  wikiTitleRu: "\u0413\u0440\u043E\u0442\u0435\u043D\u0434\u0438\u043A, \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440"
  wikidataId: Q77141
  fullNameRu: "\u0413\u0440\u043E\u0442\u0435\u043D\u0434\u0438\u043A, \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440"
  fullNameEn: Alexander Grothendieck
  birthDate: 28.03.1928
  deathDate: 13.11.2014
