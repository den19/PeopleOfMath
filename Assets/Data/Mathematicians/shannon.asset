    \u0441\u0445\u0435\u043c\u00bb | | \u0414\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f (MIT) | 1940 \u0433.
    | \u00ab\u0410\u043b\u0433\u0435\u0431\u0440\u0430 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043d\u0435\u0442\u0438\u043a\u0438\u00bb | | \u0420\u0430\u0431\u043e\u0442\u0430
    \u0432 Bell Labs | 1941\u20131956 \u0433\u0433. | \u041a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u043e\u0433\u043d\u0435\u043c, \u0442\u0435\u043e\u0440\u0438\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
