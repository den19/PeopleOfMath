    \u0431\u044b\u043b\u043e \u0443\u0432\u0438\u0434\u0435\u0442\u044c: \u0420\u043e\u0431\u043e\u0442\u0430-\u0436\u043e\u043d\u0433\u043b\u0435\u0440\u0430,
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0433\u043e \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c
    \u0432 \u0432\u043e\u0437\u0434\u0443\u0445\u0435 \u043f\u044f\u0442\u044c \u043c\u044f\u0447\u0435\u0439.
    \u0414\u0432\u0443\u0445\u043c\u0435\u0441\u0442\u043d\u044b\u0439 \u043e\u0434\u043d\u043e\u043a\u043e\u043b\u0435\u0441\u043d\u044b\u0439
    \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043e\u043d \u043a\u0430\u0442\u0430\u043b\u0441\u044f \u0441 \u0436\u0435\u043d\u043e\u0439.
    \u041a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 THROBAC I, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0432 \u0440\u0438\u043c\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u041c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0430\u043b\u0435\u0446
    \u043d\u0430 \u043a\u0443\u0445\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c
    \u0438\u0437 \u043f\u043e\u0434\u0432\u0430\u043b\u0430. \u041e\u0433\u043d\u0435\u043c\u0435\u0442\u043d\u0443\u044e
    \u0442\u0440\u0443\u0431\u0443 \u0438 \u043f\u0440\u0443\u0436\u0438\u043d\u043d\u044b\u0439
    \u0448\u0435\u0441\u0442 \u0441 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u044b\u043c
    \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0435\u043c.\n\n\U0001F3B0 \u041f\u043e\u0431\u0435\u0433
    \u0432 \u041b\u0430\u0441-\u0412\u0435\u0433\u0430\u0441: \u043f\u0435\u0440\u0432\u044b\u0439
    \u043d\u043e\u0441\u0438\u043c\u044b\u0439 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440
    \u0412 1960-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0428\u0435\u043d\u043d\u043e\u043d \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u042d\u0434\u0432\u0430\u0440\u0434\u043e\u043c
    \u0422\u043e\u0440\u043f\u043e\u043c \u0437\u0430\u0434\u0443\u043c\u0430\u043b \u043e\u0431\u044b\u0433\u0440\u0430\u0442\u044c
    \u0440\u0443\u043b\u0435\u0442\u043a\u0443 \u0432 \u041b\u0430\u0441-\u0412\u0435\u0433\u0430\u0441\u0435.
    \u041e\u043d\u0438 \u0441\u043e\u0437\u0434\u0430\u043b\u0438, \u043f\u043e \u0441\u0443\u0442\u0438,
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u043c\u0438\u0440\u0435 \u043d\u043e\u0441\u0438\u043c\u044b\u0439
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c,
    \u0432 \u043a\u0430\u043a\u043e\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u0448\u0430\u0440\u0438\u043a. \u0423\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e:
    \u0420\u0430\u0437\u043c\u0435\u0440\u043e\u043c \u0441 \u043f\u0430\u0447\u043a\u0443 \u0441\u0438\u0433\u0430\u0440\u0435\u0442,
    \u0435\u0433\u043e \u043f\u0440\u044f\u0442\u0430\u043b\u0438 \u0432 \u043e\u0431\u0443\u0432\u0438,
    \u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u043b\u0438 \u0438\u043c \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043d\u0430\u0436\u0430\u0442\u0438\u0439 \u043f\u0430\u043b\u044c\u0446\u0430\u043c\u0438
    \u043d\u043e\u0433. \u0421\u0435\u043a\u0440\u0435\u0442\u043d\u0430\u044f \u0441\u0432\u044f\u0437\u044c:
    \u041a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 \u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0441\u0438\u0433\u043d\u0430\u043b\u044b \u0447\u0435\u0440\u0435\u0437 \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u0439
    \u0434\u0438\u043d\u0430\u043c\u0438\u043a \u0432 \u0443\u0445\u0435. \u041f\u0440\u043e\u0432\u043e\u0434\u0430
    \u0431\u044b\u043b\u0438 \u0432\u044b\u043a\u0440\u0430\u0448\u0435\u043d\u044b \u0432 \u0446\u0432\u0435\u0442
    \u043a\u043e\u0436\u0438 \u0438 \u043f\u0440\u0438\u043a\u043b\u0435\u0435\u043d\u044b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0433\u0440\u0438\u043c\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0438\u0445 \u043d\u0435
    \u0431\u044b\u043b\u043e \u0432\u0438\u0434\u043d\u043e. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442:
    \u0423\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u043e,
    \u0434\u0430\u0432\u0430\u044f \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e
    \u043d\u0430\u0434 \u043a\u0430\u0437\u0438\u043d\u043e. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0434\u0443\u044d\u0442 \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u043b \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f,
    \u0438\u0441\u043f\u0443\u0433\u0430\u0432\u0448\u0438\u0441\u044c \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f
    \u0441\u043b\u0443\u0436\u0431 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043c\u0430\u0444\u0438\u0438. \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0434\u0438\u043d\u0430\u043c\u0438\u043a
    \u0422\u043e\u0440\u043f\u0430 \u0432\u044b\u043f\u0430\u043b \u0438\u0437 \u0443\u0445\u0430
    \u043d\u0430 \u0432\u0438\u0434\u0443 \u0443 \u0432\u0441\u0435\u0445, \u0447\u0442\u043e
    \u0435\u0434\u0432\u0430 \u043d\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a
    \u0440\u0430\u0437\u043e\u0431\u043b\u0430\u0447\u0435\u043d\u0438\u044e.\n\n\U0001F3AA
    \u041d\u0430\u0443\u043a\u0430 \u0438 \u0446\u0438\u0440\u043a \u043d\u0430 \u043e\u0434\u043d\u043e\u0439
    \u0434\u043e\u0440\u043e\u0436\u043a\u0435 \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u0428\u0435\u043d\u043d\u043e\u043d\u0430 \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0438\u043b\u044c\u043d\u044b, \u0447\u0442\u043e \u043f\u0440\u043e\u043d\u0438\u0437\u044b\u0432\u0430\u043b\u0438
    \u0432\u0441\u044e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c. \u0416\u043e\u043d\u0433\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435:
    \u041e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0436\u043e\u043d\u0433\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0435 \u0432 Bell Labs, \u043d\u043e \u0438
    \u0441\u043e\u0437\u0434\u0430\u043b \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0436\u043e\u043d\u0433\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f,
    \u0432\u044b\u0432\u043e\u0434\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0439. \u041e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0436\u043e\u043d\u0433\u043b\u0438\u0440\u0443\u044e\u0449\u0438\u0445
    \u043c\u0430\u0448\u0438\u043d, \u043d\u043e \u0441\u0430\u043c \u0442\u0430\u043a \u0438
    \u043d\u0435 \u0441\u043c\u043e\u0433 \u043f\u0440\u0435\u0432\u0437\u043e\u0439\u0442\u0438
    \u0440\u0435\u043a\u043e\u0440\u0434 \u0432 \u0447\u0435\u0442\u044b\u0440\u0435 \u043c\u044f\u0447\u0430.
    \u0423\u043d\u0438\u0446\u0438\u043a\u043b: \u0428\u0435\u043d\u043d\u043e\u043d\u0430 \u0447\u0430\u0441\u0442\u043e
    \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0443\u0432\u0438\u0434\u0435\u0442\u044c
    \u0440\u0430\u0437\u044a\u0435\u0437\u0436\u0430\u044e\u0449\u0438\u043c \u043f\u043e \u043a\u043e\u0440\u0438\u0434\u043e\u0440\u0430\u043c
    \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438 \u043d\u0430 \u043e\u0434\u043d\u043e\u043a\u043e\u043b\u0435\u0441\u043d\u043e\u043c
    \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0435 \u2014 \u0438 \u043f\u0440\u0438
    \u044d\u0442\u043e\u043c \u0436\u043e\u043d\u0433\u043b\u0438\u0440\u0443\u044e\u0449\u0438\u043c.\n\n\U0001F9E9
    \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0448\u0443\u0442\u043a\u0438
    \u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u00ab\u042d\u043d\u0442\u0440\u043e\u043f\u0438\u044f\u00bb
    \u043e\u0442 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430: \u0421\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \"\u043a\u0443\u0440\u0451\u0437\u043d\u043e\u0435\" \u0440\u0435\u0448\u0435\u043d\u0438\u0435.
    \u0428\u0435\u043d\u043d\u043e\u043d \u0445\u043e\u0442\u0435\u043b \u043d\u0430\u0437\u0432\u0430\u0442\u044c
    \u043c\u0435\u0440\u0443 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \"\u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e\",
    \u043d\u043e \u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d
    \u043f\u043e\u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u043b \u043d\u0430\u0437\u0432\u0430\u0442\u044c
    \u0435\u0451 \"\u044d\u043d\u0442\u0440\u043e\u043f\u0438\u0435\u0439\". \u0412\u043e-\u043f\u0435\u0440\u0432\u044b\u0445,
    \u044d\u0442\u043e\u0442 \u0442\u0435\u0440\u043c\u0438\u043d \u0443\u0436\u0435 \u0431\u044b\u043b
    \u0432 \u0444\u0438\u0437\u0438\u043a\u0435, \u0430 \u0432\u043e-\u0432\u0442\u043e\u0440\u044b\u0445,
    \"\u043d\u0438\u043a\u0442\u043e \u0442\u043e\u043b\u043a\u043e\u043c \u043d\u0435 \u0437\u043d\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u044d\u043d\u0442\u0440\u043e\u043f\u0438\u044f,
    \u0438 \u044d\u0442\u043e \u0434\u0430\u0441\u0442 \u0432\u0430\u043c \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e \u0432 \u0441\u043f\u043e\u0440\u0430\u0445\".
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u0411\u0440\u0430\u0439\u0442\u043e\u043d:
    \u0412 1985 \u0433\u043e\u0434\u0443 \u0428\u0435\u043d\u043d\u043e\u043d, \u0443\u0436\u0435
    \u0434\u0430\u0432\u043d\u043e \u043d\u0435 \u043f\u043e\u044f\u0432\u043b\u044f\u0432\u0448\u0438\u0439\u0441\u044f
    \u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0435, \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e
    \u043f\u0440\u0438\u0435\u0445\u0430\u043b \u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044e
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u0432 \u0411\u0440\u0430\u0439\u0442\u043e\u043d. \u041f\u043e\u043d\u0430\u0447\u0430\u043b\u0443
    \u0435\u0433\u043e \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0443\u0437\u043d\u0430\u043b.
    \u041d\u0430 \u0431\u0430\u043d\u043a\u0435\u0442\u0435 \u043e\u043d \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441
    \u043a\u043e\u0440\u043e\u0442\u043a\u0443\u044e \u0440\u0435\u0447\u044c, \u0437\u0430\u0442\u0435\u043c
    \u0432\u0441\u0442\u0430\u043b \u0438 \u043d\u0430\u0447\u0430\u043b \u0436\u043e\u043d\u0433\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0442\u0440\u0435\u043c\u044f \u043c\u044f\u0447\u0430\u043c\u0438. \u041f\u043e\u0441\u043b\u0435
    \u044d\u0442\u043e\u0433\u043e \u0441\u043e\u0442\u043d\u0438 \u0443\u0447\u0435\u043d\u044b\u0445
    \u0432\u044b\u0441\u0442\u0440\u043e\u0438\u043b\u0438\u0441\u044c \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c
    \u0437\u0430 \u0435\u0433\u043e \u0430\u0432\u0442\u043e\u0433\u0440\u0430\u0444\u043e\u043c,
    \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044f \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e
    \u0441 \u0442\u0435\u043c, \u0435\u0441\u043b\u0438 \u0431\u044b \u043d\u0430 \u0438\u0445
    \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044e \u044f\u0432\u0438\u043b\u0441\u044f
    \u0441\u0430\u043c \u0418\u0441\u0430\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d.\n\n\U0001F4DA
    \u0418\u0442\u043e\u0433 \u0416\u0438\u0437\u043d\u044c \u041a\u043b\u043e\u0434\u0430 \u0428\u0435\u043d\u043d\u043e\u043d\u0430
    \u2014 \u044d\u0442\u043e \u044f\u0440\u043a\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439
    \u0433\u0435\u043d\u0438\u0439 \u043d\u0435 \u0437\u0430\u043c\u044b\u043a\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u043e\u0434\u043d\u043e\u0439 \u043d\u0430\u0443\u043a\u0438.
    \u041e\u043d \u0443\u043c\u0435\u043b \u0432\u0438\u0434\u0435\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0432 \u0436\u043e\u043d\u0433\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438, \u0442\u0435\u043e\u0440\u0438\u044e
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0432 \u0440\u0443\u043b\u0435\u0442\u043a\u0435
    \u0438 \u043b\u043e\u0433\u0438\u043a\u0443 \u0432 \u0441\u0430\u043c\u044b\u0445 \u0431\u0435\u0437\u0443\u043c\u043d\u044b\u0445
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430\u0445, \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044f
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u0443\u044e \u043d\u0430\u0443\u043a\u0443 \u0432
    \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435
    \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435."
  interestingFactsEn: "Claude Shannon was not just a genius scientist, but also an incredible fictionist who turned his life into an exciting game, and these are the most exciting and curly facts from his biography.\n\nThe most famous toy, Ultimate Machine, was a small box with a single switch. When it was turned on, the lid opened inside, the mechanical arm went out and turned the switch off and hid it back. It was a pure expression of humor and love for mechanics.His home on Lake Mystic was a real museum of chickens, and you could see a robot juggler that could hold five balls in the air, a two-seat one-wheeled bicycle that he was riding with his wife, a computer called THROBAC I, which performed arithmetical activities in the Roman numeral system, a mechanical finger in the kitchen that could be operated from the basement, a pipe of fire and a spring pole with a petrol engine.\n\nThe escape to Las Vegas: Shannon's first computer in the 1960s, together with mathematician Edward Thorpe, planned to beat a roulette in Las Vegas. They basically created the world's first computer in service to predict which sector the balloon would stop in. The device: size with a pack of cigarettes, it was hidden in shoes, and it was managed by pressing its toes. The secret connection: The computer sent signals through tiny dynamics in the ear.The wires were painted in colour and glued with a special make-up, so they wouldn't be visible. The result: The device worked, giving priority over the casino. However, the duet stopped testing, scared of the security services and the Mafia. One day Thorpe's dynamic fell out of the ear in front of everyone who almost led to the disclosure.\n\n♪ Science and circus on one track of Shannon's passions were so powerful that they've been piercing his whole life. ♪ Juggling: He's not only juggling at Bell Labs, but he's also created a formal juggling theory, he's drawing trajectory equations. ♪ He's built several juggling machines, but he never beat the four-ball record.Unicycle: Shannon was often seen driving a single-wheel bicycle laboratory along the corridors — and juggling.\n\nThe most famous scientific \"smoking\" solution. Shannon wanted to call the measure \"uncertainty,\" but John von Neyman advised it to be called \"Entropy.\" First, the term was already in physics, and second, \"no one really knows what entropy is, and that would give you a huge advantage in arguments.\"Return to Brighton: In 1985, Shannon, a long-standing publicist, suddenly arrived at a conference on information theory in Brighton. No one recognized him at first. He gave a short speech at the banquet, then stood up and juggled three balls, and hundreds of scientists lined up behind his autograph, comparing that feeling to the fact that Isaac Newton himself had appeared at their conference.\n\nThe outcome of Claude Shannon's life is a powerful proof that real genius is not caught in the same science, and he was able to see mathematics in juggling, probabilities theory in roulette and logic in the most insane mechanisms, turning serious science into a fascinating adventure."
