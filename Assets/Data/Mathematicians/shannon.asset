    \u041c\u0438\u0447\u0438\u0433\u0430\u043d | | \u0423\u0447\u0451\u0431\u0430 \u0432 \u041c\u0438\u0447\u0438\u0433\u0430\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 | 1932\u20131936
    \u0433\u0433. | \u0414\u0432\u0435 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430:
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0442\u0435\u0445\u043d\u0438\u043a\u0430
    | | \u041c\u0430\u0433\u0438\u0441\u0442\u0435\u0440\u0441\u043a\u0430\u044f \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f
    (MIT) | 1937 \u0433. | \u00ab\u0421\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0440\u0435\u043b\u0435\u0439\u043d\u044b\u0445 \u0438
