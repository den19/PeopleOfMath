  achievementsRu: "\u041a\u043b\u043e\u0434 \u0428\u0435\u043d\u043d\u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0442\u0430\u043b\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u0442\u0435\u0445\u043d\u0438\u043a\u0438. \u0415\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u0434\u0435\u0435\u0439
    \u2014 \u044d\u0442\u043e \u0446\u0435\u043b\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430
    \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0438\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432, \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0438\u0445
    \u043c\u0438\u0440. \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c
    \u0438\u0445 \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445.\n\n\u2699\ufe0f \u0426\u0438\u0444\u0440\u043e\u0432\u0430\u044f
    \u0441\u0445\u0435\u043c\u043e\u0442\u0435\u0445\u043d\u0438\u043a\u0430: \u043e\u0442 \u0440\u0435\u043b\u0435
    \u043a \u0431\u0443\u043b\u0435\u0432\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u0435
    \u041f\u0435\u0440\u0432\u044b\u043c \u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0441\u0430\u043c\u044b\u043c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0428\u0435\u043d\u043d\u043e\u043d\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430, \u043f\u0440\u043e\u0434\u0435\u043b\u0430\u043d\u043d\u0430\u044f
    \u0438\u043c \u0435\u0449\u0435 \u0432 MIT. \u0412 \u0441\u0432\u043e\u0435\u0439 \u043c\u0430\u0433\u0438\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u00ab\u0421\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0440\u0435\u043b\u0435\u0439\u043d\u044b\u0445 \u0438
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u0445\u0435\u043c\u00bb (1937 \u0433.) \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043f\u0440\u043e\u0440\u044b\u0432. \u0421\u0443\u0442\u044c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f:
    \u0428\u0435\u043d\u043d\u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0445\u0435\u043c\u044b, \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u0438\u0437
    \u0440\u0435\u043b\u0435 \u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u0435\u0439,
    \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u0442\u044c \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0438 \u0441\u0442\u0440\u043e\u0433\u043e\u0439
    \u0431\u0443\u043b\u0435\u0432\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u041e\u043d
    \u0441\u0432\u044f\u0437\u0430\u043b \u0434\u0432\u0430 \u043c\u0438\u0440\u0430: \u043b\u043e\u0433\u0438\u043a\u0443
    (\u0438\u0441\u0442\u0438\u043d\u0430/\u043b\u043e\u0436\u044c) \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    (\u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e/\u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e,
    1/0). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0432\u0441\u0435\u0445 \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0445 \u0441\u0445\u0435\u043c,
    \u043b\u0435\u0436\u0430\u0449\u0438\u0445 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u00ab\u0441\u0430\u043c\u043e\u0439 \u0437\u043d\u0430\u0447\u0438\u043c\u043e\u0439
    \u043c\u0430\u0433\u0438\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0435\u0439
    XX \u0432\u0435\u043a\u0430\u00bb.\n\n\U0001F4E1 \u0422\u0435\u043e\u0440\u0438\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438:
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0441\u0432\u044f\u0437\u0438
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u0436\u0438\u0437\u043d\u0438
    \u0428\u0435\u043d\u043d\u043e\u043d\u0430 \u2014 \u044d\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0430
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u043d\u0430\u0448\u0435\u043c
    \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0438 \u0434\u0430\u043d\u043d\u044b\u0445
    \u0438 \u0441\u0432\u044f\u0437\u0438. \u041e\u0441\u043d\u043e\u0432\u044b \u0431\u044b\u043b\u0438
    \u0437\u0430\u043b\u043e\u0436\u0435\u043d\u044b \u0432 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0441\u0442\u0430\u0442\u044c\u0435 \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0441\u0432\u044f\u0437\u0438\u00bb (1948 \u0433\u043e\u0434).
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0438\u0434\u0435\u0438 \u044d\u0442\u043e\u0433\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430: \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438: \u0428\u0435\u043d\u043d\u043e\u043d
    \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u043f\u043e\u0441\u043e\u0431
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438, \u043e\u0442\u0434\u0435\u043b\u0438\u0432
    \u0435\u0433\u043e \u043e\u0442 \u0441\u043c\u044b\u0441\u043b\u0430 \u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f
    \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f. \u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u043e\u0439. \u041c\u0435\u0440\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    (\u042d\u043d\u0442\u0440\u043e\u043f\u0438\u044f): \u041e\u043d \u0432\u0432\u0435\u043b
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0443, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0443\u044e
    \u044d\u043d\u0442\u0440\u043e\u043f\u0438\u0435\u0439, \u043a\u0430\u043a \u043c\u0435\u0440\u0443
    \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0438\u043b\u0438 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0438. \u042d\u0442\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u043e\u043d \u043f\u043e\u0437\u0430\u0438\u043c\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0438\u0437 \u0442\u0435\u0440\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438
    \u043f\u043e \u0441\u043e\u0432\u0435\u0442\u0443 \u0414\u0436\u043e\u043d\u0430 \u0444\u043e\u043d
    \u041d\u0435\u0439\u043c\u0430\u043d\u0430. \u0415\u0434\u0438\u043d\u0438\u0446\u0430 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u2014 \u00ab\u0411\u0438\u0442\u00bb: \u0418\u043c\u0435\u043d\u043d\u043e \u0428\u0435\u043d\u043d\u043e\u043d
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0441\u043b\u043e\u0432\u043e \u00ab\u0431\u0438\u0442\u00bb (binary digit) \u043a\u0430\u043a
    \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0435\u0434\u0438\u043d\u0438\u0446\u0443
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u0434\u043b\u044f \u0432\u044b\u0431\u043e\u0440\u0430
    \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u043c\u0438
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430\u043c\u0438. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0428\u0435\u043d\u043d\u043e\u043d\u0430-\u0425\u0430\u0440\u0442\u043b\u0438: \u041e\u043d
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0437\u0430\u043a\u043e\u043d \u0434\u043b\u044f \u043a\u0430\u043d\u0430\u043b\u043e\u0432
    \u0441\u0432\u044f\u0437\u0438 \u0441 \u0448\u0443\u043c\u043e\u043c. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u0430\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c
    \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    (\u043f\u0440\u0435\u0434\u0435\u043b \u0428\u0435\u043d\u043d\u043e\u043d\u0430), \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u0440\u0435\u0432\u044b\u0441\u0438\u0442\u044c
    \u0431\u0435\u0437 \u0440\u0438\u0441\u043a\u0430 \u043e\u0448\u0438\u0431\u043e\u043a.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435,
    \u043c\u043e\u0436\u043d\u043e \u0441\u043a\u043e\u043b\u044c \u0443\u0433\u043e\u0434\u043d\u043e
    \u0431\u043b\u0438\u0437\u043a\u043e \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u044c\u0441\u044f
    \u043a \u044d\u0442\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438, \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0431\u0435\u0437\u043e\u0448\u0438\u0431\u043e\u0447\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043e\u0441\u043d\u043e\u0432\u0443
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c \u0441\u0432\u044f\u0437\u0438: \u043e\u0442 \u0441\u043e\u0442\u043e\u0432\u043e\u0439
    \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0438\u0438 \u0438 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0430
    \u0434\u043e \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0432\u044f\u0437\u0438
    \u0438 \u0441\u0436\u0430\u0442\u0438\u044f \u0434\u0430\u043d\u043d\u044b\u0445.\n\n\U0001F510
    \u041a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f: \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u0420\u0430\u0431\u043e\u0442\u0430\u044f \u0432 Bell Labs \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0438 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0435, \u0428\u0435\u043d\u043d\u043e\u043d
    \u0432\u043d\u0435\u0441 \u043d\u0435\u043e\u0446\u0435\u043d\u0438\u043c\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044e. \u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430: \u0412 1949 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0442\u0430\u0442\u044c\u044e
    \u00ab\u0422\u0435\u043e\u0440\u0438\u044f \u0441\u0432\u044f\u0437\u0438 \u0432 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445\u00bb, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0442\u0430\u043b\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c
    \u0435\u0433\u043e \u0437\u0430\u0441\u0435\u043a\u0440\u0435\u0447\u0435\u043d\u043d\u043e\u0433\u043e
    \u0434\u043e\u043a\u043b\u0430\u0434\u0430 1945 \u0433\u043e\u0434\u0430. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442
    \u043a \u0430\u043d\u0430\u043b\u0438\u0437\u0443 \u0448\u0438\u0444\u0440\u043e\u0432.
    \u041e\u043d \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u044f
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e\u0439 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u044c
    \u0448\u0438\u0444\u0440\u0430 \u0412\u0435\u0440\u043d\u0430\u043c\u0430 \u0438 \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u2014
    \u043e\u0431\u044a\u0435\u043c\u0430 \u0448\u0438\u0444\u0440\u0442\u0435\u043a\u0441\u0442\u0430,
    \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0433\u043e \u0434\u043b\u044f
    \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0439 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0430
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u0438\u0437 \u0440\u0435\u043c\u0435\u0441\u043b\u0430
    \u0432 \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u0443\u044e \u043d\u0430\u0443\u043a\u0443.\n\n\U0001F916
    \u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442
    \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u044b \u0428\u0435\u043d\u043d\u043e\u043d
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0438\u043e\u043d\u0435\u0440\u043e\u0432,
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432\u0448\u0438\u0445 \u043e\u0441\u043d\u043e\u0432\u044b
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430.
    \u0428\u0430\u0445\u043c\u0430\u0442\u043d\u044b\u0439 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440:
    \u0412 1950 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u043f\u0438\u0441\u0430\u043b, \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e
    \u0437\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 \u0434\u043b\u044f \u0438\u0433\u0440\u044b
    \u0432 \u0448\u0430\u0445\u043c\u0430\u0442\u044b, \u0438 \u0434\u0430\u0436\u0435 \u0441\u043e\u0437\u0434\u0430\u043b
    \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0442\u0430\u043a\u0438\u0445
    \u043c\u0430\u0448\u0438\u043d. \u041c\u044b\u0448\u044c \u00ab\u0422\u0435\u0441\u0435\u0439\u00bb:
    \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u044b\u0448\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043c\u043e\u0433\u043b\u0430
    \u043e\u0431\u0443\u0447\u0430\u0442\u044c\u0441\u044f \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c
    \u0432\u044b\u0445\u043e\u0434 \u0438\u0437 \u043b\u0430\u0431\u0438\u0440\u0438\u043d\u0442\u0430,
    \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044f \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432 \u0441\u0430\u043c\u043e\u043e\u0431\u0443\u0447\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430. \u042d\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u043b\u044f
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u043e\u0432,
    \u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u0437\u0430 \u044d\u0442\u043e \u0435\u0433\u043e
    \u0432\u044b\u0441\u043e\u043a\u043e \u0446\u0435\u043d\u0438\u043b\u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438,
    \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430
    \u0410.\u041d. \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430. \u0412
    \u0446\u0435\u043b\u043e\u043c, \u0441\u043e\u0432\u043e\u043a\u0443\u043f\u043d\u043e\u0441\u0442\u044c
    \u044d\u0442\u0438\u0445 \u0442\u0440\u0443\u0434\u043e\u0432 \u0441\u043e\u0437\u0434\u0430\u043b\u0430
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438. \u0420\u0430\u0431\u043e\u0442\u044b
    \u0428\u0435\u043d\u043d\u043e\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0440\u0435\u0448\u0438\u043b\u0438 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043d\u043e
    \u0438 \u0434\u0430\u043b\u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u043b\u044e\u0431\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u0441 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0435\u0439, \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u043e\u0439
    \u0438 \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u043c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438."
  achievementsEn: "Claude Shannon left behind a legacy that has become the foundation for several key areas of modern science and technology, and his contribution is not limited to one idea, but a whole system of fundamental works that have changed the world. Let us look at them in detail.\n\n====Symbol analysis======In his master's thesis \"Symvolic Analysis of Relays and Switches\" (1937), Shannon's discovery: Shannon showed that complex electrical circuits consisting of relays and switches can be described by simple and strict bald algebra.It has linked two worlds: logic (truth/falsity) and electricity (set/off, 1/0). This work has become the theoretical foundation for the design of all digital circuits that underpin modern computers. It has been called \"the most significant master's thesis of the twentieth century\".\n\nThe information theory: the main work of Shannon's life is the creation of a theory of information that revolutionized our understanding of data and communication, the basis of which was laid in his famous article \"Mathematic Theory of Communication\" (1948). Key ideas of this fundamental work: Definition of information: Shannon was the first to propose a mathematical way of measuring the amount of information, separating it from the meaning and content of the message.Information has become objective. (Entropy) Information Measure: He introduced the amount called entropy as a measure of uncertainty or amount of information in the message. This is a notion he borrowed from the thermodynamics on the advice of John von Neuman. The unit of measurement is \"Bit\": Shannon suggested using the word \"beat\" as the minimum unit of information to choose between two equally likely options.Shannon-Hartley Theorem: He has proven the fundamental law for noise communication channels. The Theorem states that there is a maximum speed of transmission of information (the Shannon limit) which cannot be exceeded without the risk of error, but with special coding, you can come as close as you can to that speed, with a virtually unmistakable transmission.This work has provided a theoretical basis for all modern communication systems, from cellular telephones and the Internet to space communications and data compression.\n\nCryptography: The transformation of art into science by working in Bell Labs during and after World War II, Shannon made an invaluable contribution to cryptography. Key work: In 1949, he published an article entitled \"Theory of Communication in Secret Systems\", which was the result of his classified 1945 report.He formalized the concepts of complete secrecy, proved the persistence of Vernam's code, and introduced the concept of the distance of the oneness, the volume of the encryption required for a clear decryption, which turned cryptography from a craft to a full-fledged science.\n\nIn 1950, he published a work describing how to program a computer for playing chess, and even created one of the first machines.Mouse Tesei: He created an electro-méchanical mouse that could learn to find a way out of the maze, remembering the right path is one of the first examples of a self-learning device. These works laid the foundation for cybernetics and automatrix theory, and that's why he was highly valued by colleagues, up to A.N. Kolmogorov's academicist.Shannon &apos; s work not only addressed specific engineering challenges of its time, but also provided a universal mathematical language to describe and design any systems related to the transmission, processing and storage of information."
  personalLifeRu: "\u041a\u043b\u043e\u0434 \u0428\u0435\u043d\u043d\u043e\u043d \u0431\u044b\u043b \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0443\u0447\u0435\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u043e\u0447\u0435\u043d\u044c \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430,
    \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u0440\u0435\u0448\u0435\u043d\u0438\u0439
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445 \u043b\u0438\u0447\u043d\u044b\u0445
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439. \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437 \u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u043c
    \u043f\u0443\u0442\u0438.\n\n\U0001F476 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435,
    \u0421\u0435\u043c\u044c\u044f \u0438 \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u041a\u043b\u043e\u0434
    \u042d\u043b\u0432\u0443\u0434 \u0428\u0435\u043d\u043d\u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    30 \u0430\u043f\u0440\u0435\u043b\u044f 1916 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u041f\u0435\u0442\u043e\u0446\u043a\u0438, \u0448\u0442\u0430\u0442 \u041c\u0438\u0447\u0438\u0433\u0430\u043d.
    \u0425\u043e\u0442\u044f \u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432
    \u041f\u0435\u0442\u043e\u0446\u043a\u0438, \u043f\u0435\u0440\u0432\u044b\u0435 \u0448\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u044c
    \u043b\u0435\u0442 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u043e\u043d
    \u043f\u0440\u043e\u0432\u0435\u043b \u0432 \u0441\u043e\u0441\u0435\u0434\u043d\u0435\u043c
    \u0413\u044d\u0439\u043b\u043e\u0440\u0434\u0435, \u0448\u0442\u0430\u0442 \u041c\u0438\u0447\u0438\u0433\u0430\u043d,
    \u043a\u0443\u0434\u0430 \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u044f \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430
    \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.
    \u0415\u0433\u043e \u0441\u0435\u043c\u044c\u044f \u0441\u043e\u0437\u0434\u0430\u043b\u0430
    \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u0443\u044e \u0441\u0440\u0435\u0434\u0443
    \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442\u043e\u0432:
    \u041e\u0442\u0435\u0446, \u041a\u043b\u043e\u0434 \u0428\u0435\u043d\u043d\u043e\u043d-\u0441\u0442\u0430\u0440\u0448\u0438\u0439
    (1862\u20131934), \u0431\u044b\u043b \u0431\u0438\u0437\u043d\u0435\u0441\u043c\u0435\u043d\u043e\u043c,
    \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u043e\u043c \u0438 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0441\u0443\u0434\u044c\u0435\u0439 \u043f\u043e \u0434\u0435\u043b\u0430\u043c
    \u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435. \u041e\u043d \u043e\u0431\u043b\u0430\u0434\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043a\u043b\u0430\u0434\u043e\u043c
    \u0443\u043c\u0430 \u0438 \u043f\u043e\u043e\u0449\u0440\u044f\u043b \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u0441\u044b\u043d\u0430. \u041c\u0430\u0442\u044c, \u041c\u0435\u0439\u0431\u0435\u043b
    \u0412\u0443\u043b\u0444 \u0428\u0435\u043d\u043d\u043e\u043d (1890\u20131945), \u0431\u044b\u043b\u0430
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445
    \u044f\u0437\u044b\u043a\u043e\u0432, \u0430 \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b\u0430
    \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c \u0413\u044d\u0439\u043b\u043e\u0440\u0434\u0441\u043a\u043e\u0439
    \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0448\u043a\u043e\u043b\u044b. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442: \u0421\u0430\u043c \u0422\u043e\u043c\u0430\u0441 \u042d\u0434\u0438\u0441\u043e\u043d
    \u0431\u044b\u043b \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0438\u043c \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c,
    \u0438 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0428\u0435\u043d\u043d\u043e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b \u0435\u0433\u043e \u0441\u0432\u043e\u0438\u043c \u0433\u0435\u0440\u043e\u0435\u043c.
    \u0412 \u044e\u043d\u043e\u0441\u0442\u0438 \u0428\u0435\u043d\u043d\u043e\u043d \u0431\u044b\u043b
    \u043d\u0435\u0443\u0442\u043e\u043c\u0438\u043c\u044b\u043c \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u0435\u043c.
    \u041e\u043d \u0441\u043e\u0431\u0438\u0440\u0430\u043b \u043c\u043e\u0434\u0435\u043b\u0438
    \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043e\u0432, \u0441\u043e\u0437\u0434\u0430\u043b
    \u0440\u0430\u0434\u0438\u043e\u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u0443\u044e
    \u043b\u043e\u0434\u043a\u0443 \u0438 \u0434\u0430\u0436\u0435 \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u0444\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043c\u0435\u0436\u0434\u0443 \u0441\u0432\u043e\u0438\u043c
    \u0434\u043e\u043c\u043e\u043c \u0438 \u0434\u043e\u043c\u043e\u043c \u0434\u0440\u0443\u0433\u0430,
    \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u043c \u0432 \u043f\u043e\u043b\u0443\u043c\u0438\u043b\u0435.
    \u0422\u0430\u043a\u0436\u0435 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043a\u0443\u0440\u044c\u0435\u0440\u043e\u043c
    \u0432 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 Western Union.\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430
    \u0438 \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0412 1932 \u0433\u043e\u0434\u0443 \u0428\u0435\u043d\u043d\u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041c\u0438\u0447\u0438\u0433\u0430\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u041e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0435\u0433\u043e \u0432 1936 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0441\u0440\u0430\u0437\u0443 \u0434\u0432\u0435
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430:
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u043f\u043e
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0442\u0435\u0445\u043d\u0438\u043a\u0435. \u0417\u0430\u0442\u0435\u043c
    \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u041c\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441\u043a\u0438\u0439
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 (MIT), \u0433\u0434\u0435 \u0441\u0442\u0430\u043b
    \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c \u0412\u044d\u043d\u0438\u0432\u0430\u0440\u0430
    \u0411\u0443\u0448\u0430, \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043d\u0430\u0434
    \u0435\u0433\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c \u2014 \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u043c
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u043c. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0442\u0430\u043c \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u0441\u0432\u043e\u0435
    \u043f\u0435\u0440\u0432\u043e\u0435 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435. \u0412 \u0441\u0432\u043e\u0435\u0439
    \u043c\u0430\u0433\u0438\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u00ab\u0421\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0440\u0435\u043b\u0435\u0439\u043d\u044b\u0445 \u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u0445\u0435\u043c\u00bb (1937 \u0433., \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430
    \u0432 1938 \u0433.) \u0428\u0435\u043d\u043d\u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u0431\u0443\u043b\u0435\u0432\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442 \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0445\u0435\u043c.
    \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0432\u0441\u0435\u0445 \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0445 \u0441\u0445\u0435\u043c
    \u0438 \u0431\u044b\u043b\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u043e \u00ab\u0441\u0430\u043c\u043e\u0439
    \u0437\u043d\u0430\u0447\u0438\u043c\u043e\u0439 \u043c\u0430\u0433\u0438\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0435\u0439 XX \u0432\u0435\u043a\u0430\u00bb.
    \u041f\u043e \u0441\u043e\u0432\u0435\u0442\u0443 \u0411\u0443\u0448\u0430 \u0428\u0435\u043d\u043d\u043e\u043d
    \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0434\u0440\u0443\u0433\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e. \u0415\u0433\u043e
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f,
    \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u043d\u0430\u044f \u0432 MIT \u0432 1940 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435
    \u00ab\u0410\u043b\u0433\u0435\u0431\u0440\u0430 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043d\u0435\u0442\u0438\u043a\u0438\u00bb. \u0412 \u043d\u0435\u0439 \u043e\u043d
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u043a \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u041c\u0435\u043d\u0434\u0435\u043b\u044f. \u0425\u043e\u0442\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u0437\u0430\u043c\u0435\u0447\u0435\u043d\u043d\u043e\u0439 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f,
    \u043e\u043d\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0435\u0433\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043d\u0430 \u0441\u0442\u044b\u043a\u0435 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d.\n\n\U0001F52C
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0438 \u0412\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0423\u0447\u0451\u043d\u044b\u043c\u0438 \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0428\u0435\u043d\u043d\u043e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0434\u0432\u0443\u043c\u044f
    \u043c\u0435\u0441\u0442\u0430\u043c\u0438. 1. Bell Labs (1941\u20131956): \u0412\u0435\u0441\u043d\u043e\u0439
    1941 \u0433\u043e\u0434\u0430 \u0428\u0435\u043d\u043d\u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 Bell Labs, \u0433\u0434\u0435 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0434\u043e 1956 \u0433\u043e\u0434\u0430. \u0412 \u0433\u043e\u0434\u044b \u0412\u0442\u043e\u0440\u043e\u0439
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0437\u0435\u043d\u0438\u0442\u043d\u044b\u043c
    \u043e\u0433\u043d\u0435\u043c \u0438, \u0447\u0442\u043e \u0432\u0430\u0436\u043d\u0435\u0435,
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439. \u0415\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043f\u0440\u0438\u0432\u0435\u043b\u0430 \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f.
    \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u043d\u0430\u043a\u043e\u0432\u044b\u0445
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438
    \u0441\u0442\u0430\u043b\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0432 1943 \u0433\u043e\u0434\u0443
    \u0441 \u0410\u043b\u0430\u043d\u043e\u043c \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u043e\u043c.
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u0431\u044b\u043b \u0432 \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d\u0435,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u043c\u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438
    \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438 \u0432\u0437\u043b\u043e\u043c\u0430 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445
    \u0448\u0438\u0444\u0440\u043e\u0432. \u041e\u043d\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b\u0438\u0441\u044c
    \u0432 \u0441\u0442\u043e\u043b\u043e\u0432\u043e\u0439 Bell Labs \u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b\u0438
    \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438. \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0428\u0435\u043d\u043d\u043e\u043d\u0443 \u0441\u0432\u043e\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043e \u00ab\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0448\u0438\u043d\u0435 \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430\u00bb,
    \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e \u043d\u0430 \u0428\u0435\u043d\u043d\u043e\u043d\u0430
    \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435.
    \u0412 1948 \u0433\u043e\u0434\u0443 \u0428\u0435\u043d\u043d\u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0441\u0432\u044f\u0437\u0438\u00bb, \u0433\u0434\u0435
    \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u0431\u0438\u0442\u00bb
    \u043a\u0430\u043a \u0435\u0434\u0438\u043d\u0438\u0446\u0443 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438.
    2. MIT (1956\u20131978): \u0421 1956 \u0433\u043e\u0434\u0430 \u0428\u0435\u043d\u043d\u043e\u043d
    \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 MIT, \u0430 \u0441 1957 \u0433\u043e\u0434\u0430 \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c.
    \u041e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    Bell Labs, \u043d\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u0430\u044f \u0435\u0433\u043e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0431\u044b\u043b\u0430
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u043e\u043c.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043c\u043d\u043e\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c\u0438
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430,
    \u0441\u043e\u0437\u0434\u0430\u043b \u0448\u0430\u0445\u043c\u0430\u0442\u043d\u044b\u0439
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 \u0438 \u043e\u0431\u0443\u0447\u0430\u0435\u043c\u0443\u044e
    \u043c\u044b\u0448\u044c \u00ab\u0422\u0435\u0441\u0435\u0439\u00bb.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u041b\u0438\u0447\u043d\u0430\u044f \u0416\u0438\u0437\u043d\u044c \u0438 \u0425\u043e\u0431\u0431\u0438
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0428\u0435\u043d\u043d\u043e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c \u0436\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0430,
    \u043a\u0430\u043a \u0438 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430. \u041e\u043d \u0431\u044b\u043b \u0434\u0432\u0430\u0436\u0434\u044b
    \u0436\u0435\u043d\u0430\u0442: \u041f\u0435\u0440\u0432\u044b\u0439 \u0431\u0440\u0430\u043a
    \u0441 \u041d\u043e\u0440\u043c\u043e\u0439 \u041b\u0435\u0432\u043e\u0440 \u0431\u044b\u043b
    \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d \u0432 1940 \u0433\u043e\u0434\u0443, \u043d\u043e
    \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0441\u044f \u0432\u0441\u0435\u0433\u043e \u043e\u043a\u043e\u043b\u043e
    \u0433\u043e\u0434\u0430 \u0438 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0441\u044f
    \u0440\u0430\u0437\u0432\u043e\u0434\u043e\u043c. \u0412\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a
    \u0441 \u041c\u044d\u0440\u0438 \u042d\u043b\u0438\u0437\u0430\u0431\u0435\u0442 \u00ab\u0411\u0435\u0442\u0442\u0438\u00bb
    \u041c\u0443\u0440 \u0431\u044b\u043b \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d \u0432
    1949 \u0433\u043e\u0434\u0443. \u0411\u0435\u0442\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u043c \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u043e\u043c
    \u0432 Bell Labs \u0438 \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0430
    \u0428\u0435\u043d\u043d\u043e\u043d\u0443 \u0432 \u0435\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f\u0445.
    \u0423 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0442\u0440\u043e\u0435
    \u0434\u0435\u0442\u0435\u0439: \u0441\u044b\u043d\u043e\u0432\u044c\u044f \u0420\u043e\u0431\u0435\u0440\u0442,
    \u0414\u0436\u0435\u0439\u043c\u0441, \u042d\u043d\u0434\u0440\u044e \u041c\u0443\u0440
    \u0438 \u0434\u043e\u0447\u044c \u041c\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0430.
    \u0417\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u043d\u0430\u0443\u043a\u0438
    \u0428\u0435\u043d\u043d\u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0438\u043c\u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u043c\u0438
    \u0445\u043e\u0431\u0431\u0438. \u041e\u043d \u043b\u044e\u0431\u0438\u043b \u0436\u043e\u043d\u0433\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438 \u0435\u0437\u0434\u0443 \u043d\u0430 \u043e\u0434\u043d\u043e\u043a\u043e\u043b\u0435\u0441\u043d\u043e\u043c
    \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0435, \u043f\u0440\u0438\u0447\u0435\u043c
    \u0447\u0430\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u043e
    \u0432 \u043a\u043e\u0440\u0438\u0434\u043e\u0440\u0430\u0445 Bell Labs \u0438 MIT. \u041e\u043d
    \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u00ab\u0411\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u0443\u044e \u043c\u0430\u0448\u0438\u043d\u0443\u00bb
    (Ultimate Machine), \u0440\u0430\u043a\u0435\u0442\u043d\u044b\u0439 \u043b\u0435\u0442\u0430\u044e\u0449\u0438\u0439
    \u0434\u0438\u0441\u043a, \u043c\u043e\u0442\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u043f\u043e\u0433\u043e-\u0441\u0442\u0438\u043a \u0438 \u0434\u0430\u0436\u0435 \u0434\u0432\u0443\u0445\u043c\u0435\u0441\u0442\u043d\u044b\u0439
    \u043e\u0434\u043d\u043e\u043a\u043e\u043b\u0435\u0441\u043d\u044b\u0439 \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434.
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u0436\u0435\u043d\u043e\u0439 \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438
    \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438
    \u0434\u043b\u044f \u0438\u0433\u0440\u044b \u0432 \u0431\u043b\u044d\u043a\u0434\u0436\u0435\u043a
    \u0438 \u0434\u0430\u0436\u0435 \u0441\u043e\u0437\u0434\u0430\u043b \u043e\u0434\u0438\u043d
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043d\u043e\u0441\u0438\u043c\u044b\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432 \u0434\u043b\u044f \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u0430
    \u043a\u0430\u0440\u0442.\n\n\U0001F9D3 \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041a\u043b\u043e\u0434 \u0428\u0435\u043d\u043d\u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    24 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 2001 \u0433\u043e\u0434\u0430 \u0432 \u041c\u0435\u0434\u0444\u043e\u0440\u0434\u0435,
    \u0448\u0442\u0430\u0442 \u041c\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 84 \u043b\u0435\u0442. \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u043e\u043d
    \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    \u0410\u043b\u044c\u0446\u0433\u0435\u0439\u043c\u0435\u0440\u0430 \u0438 \u043f\u0440\u043e\u0432\u0435\u043b
    \u0441\u0432\u043e\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0432 \u0434\u043e\u043c\u0435 \u043f\u0440\u0435\u0441\u0442\u0430\u0440\u0435\u043b\u044b\u0445.
    \u041e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b, \u0430 \u0446\u0435\u043b\u0443\u044e \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u0443\u044e
    \u0438\u0434\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438
    \u043c\u0438\u0440. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u0441\u0442\u0430\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438,
    \u0430 \u0435\u0433\u043e \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u0436\u0438\u0437\u043d\u0438 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0435\u0442
    \u0443\u0447\u0435\u043d\u044b\u0445 \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u0435\u0439
