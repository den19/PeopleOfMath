    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u043e \u0441\u0432\u043e\u0435\u043c\u0443 \u043e\u0431\u044a\u0451\u043c\u0443 \u0438
    \u0437\u043d\u0430\u0447\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u0435 \u0438\u043c\u0435\u0435\u0442
    \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438.
    \u0415\u0433\u043e \u043f\u0435\u0440\u0443 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442
    \u043e\u043a\u043e\u043b\u043e 850 \u0440\u0430\u0431\u043e\u0442, \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0445
    \u0432\u0441\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0435\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0444\u0438\u0437\u0438\u043a\u0443, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e
    \u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a. \u041f\u043e \u043e\u0446\u0435\u043d\u043a\u0430\u043c, \u0435\u0433\u043e
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438
    \u043e\u043a\u043e\u043b\u043e \u0442\u0440\u0435\u0442\u0438 \u0432\u0441\u0435\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438\u0437\u0434\u0430\u043d\u0438\u0439 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435
    \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435
    \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044e\u044e \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044c
    XVIII \u0432\u0435\u043a\u0430. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u0445.\n\n\U0001F9EE
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u044f\u0437\u044b\u043a\u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u042d\u0439\u043b\u0435\u0440 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447, \u043e\u043d \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u0441\u043e\u0437\u0434\u0430\u043b \u044f\u0437\u044b\u043a, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u043a\u0430.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430
    \u2014 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438\u0437 \u043d\u0430\u0431\u043e\u0440\u0430
    \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0432 \u0435\u0434\u0438\u043d\u0443\u044e, \u0441\u0442\u0440\u043e\u0439\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443. \u041a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438: \u0412 \u0441\u0432\u043e\u0451\u043c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445\u00bb
    (1748) \u042d\u0439\u043b\u0435\u0440 \u043f\u043e\u043b\u043e\u0436\u0438\u043b \u0432
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0432\u0441\u0435\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u0414\u043e
    \u043d\u0435\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437 \u0431\u044b\u043b \u0441\u043a\u043e\u0440\u0435\u0435
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0438\u0451\u043c\u043e\u0432. \u042d\u0439\u043b\u0435\u0440 \u0436\u0435
    \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u00ab\u0432\u0435\u0441\u044c
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u043c\u0430\u043b\u044b\u0445 \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432\u043e\u043a\u0440\u0443\u0433
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0432\u0435\u043b\u0438\u0447\u0438\u043d
    \u0438 \u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439\u00bb, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432
    \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u043a\u0430\u043a \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0435. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u0442\u0434\u0435\u043b\u0438\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043e\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0438 \u043f\u0440\u0438\u0434\u0430\u043b\u0430
    \u0435\u0439 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043d\u043e\u0432\u044b\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438: \u042d\u0439\u043b\u0435\u0440
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u2014 \u0440\u0430\u0437\u0434\u0435\u043b\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0449\u0435\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c
    \u0438\u043b\u0438 \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0440\u0430\u0437\u0432\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0437\u0430\u043b\u043e\u0436\u0438\u0432
    \u043e\u0441\u043d\u043e\u0432\u044b \u043a\u0430\u043a \u0434\u043b\u044f \u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0445,
    \u0442\u0430\u043a \u0438 \u0434\u043b\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445.
    \u041d\u043e\u0432\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b: \u042d\u0439\u043b\u0435\u0440 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432 \u043c\u0435\u0442\u043e\u0434\u044b \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0441\u0432\u043e\u0439\u0441\u0442\u0432
    \u0446\u0435\u043b\u044b\u0445 \u0447\u0438\u0441\u0435\u043b. \u0412 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0441\u0442\u0430\u043b\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0437\u0430\u043a\u043e\u043d\u0430 \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438
    (\u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u0437\u0430\u043a\u043e\u043d
    \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438), \u0441\u0442\u0430\u0432\u0448\u0435\u0433\u043e
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u043a\u0430: \u041c\u043d\u043e\u0433\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u0441\u0447\u0438\u0442\u0430\u0435\u043c \u0441\u0430\u043c\u043e \u0441\u043e\u0431\u043e\u0439
    \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0449\u0438\u043c\u0438\u0441\u044f, \u0432\u0432\u0451\u043b
    \u0438\u043c\u0435\u043d\u043d\u043e \u042d\u0439\u043b\u0435\u0440. \u0421\u0440\u0435\u0434\u0438
    \u043d\u0438\u0445: f(x) \u2014 \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u03a3 \u2014 \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0441\u0443\u043c\u043c\u044b. e \u2014 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0430.
    i \u2014 \u043c\u043d\u0438\u043c\u0430\u044f \u0435\u0434\u0438\u043d\u0438\u0446\u0430.
    \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u044f \u03c0 (\u043f\u0438).\n\n\u2699\ufe0f
    \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u043a\u0430:
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0444\u0438\u0437\u0438\u043a\u0438 \u043d\u0430
    \u044f\u0437\u044b\u043a \u0444\u043e\u0440\u043c\u0443\u043b \u0412\u043a\u043b\u0430\u0434
    \u042d\u0439\u043b\u0435\u0440\u0430 \u0432 \u0444\u0438\u0437\u0438\u043a\u0443 \u043d\u0435
    \u043c\u0435\u043d\u0435\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u0435\u043d.
    \u0415\u0441\u043b\u0438 \u041d\u044c\u044e\u0442\u043e\u043d \u0438\u0437\u043b\u0430\u0433\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0437\u0430\u043a\u043e\u043d\u044b \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0442\u043e \u042d\u0439\u043b\u0435\u0440 \u043f\u0435\u0440\u0435\u0432\u0435\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443
    \u043d\u0430 \u044f\u0437\u044b\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u0441\u0434\u0435\u043b\u0430\u0432 \u0435\u0451
    \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439 \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432.
    \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430:
    \u0415\u0433\u043e \u0434\u0432\u0443\u0445\u0442\u043e\u043c\u043d\u0430\u044f \u00ab\u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430,
    \u0438\u043b\u0438 \u041d\u0430\u0443\u043a\u0430 \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438,
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u00bb
    (1736) \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u044b\u043c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c,
    \u0433\u0434\u0435 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0442\u043e\u0447\u043a\u0438
    \u0431\u044b\u043b\u0430 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u042d\u0442\u043e \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e \u0435\u043c\u0443 \u043e\u0431\u0449\u0435\u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c. \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430
    \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430: \u042d\u0439\u043b\u0435\u0440
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438
    \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430. \u041e\u043d
    \u0432\u0432\u0451\u043b \u00ab\u0443\u0433\u043b\u044b \u042d\u0439\u043b\u0435\u0440\u0430\u00bb
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430, \u0432\u044b\u0432\u0435\u043b
    \u00ab\u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u042d\u0439\u043b\u0435\u0440\u0430\u00bb
    \u0434\u043b\u044f \u0435\u0433\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0438
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u043b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u0446\u0435\u043d\u0442\u0440\u0430 \u043c\u0430\u0441\u0441 \u0438 \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432\u043e\u043a\u0440\u0443\u0433 \u043d\u0435\u0433\u043e. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u0422\u0435\u043e\u0440\u0438\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u0442\u0432\u0451\u0440\u0434\u044b\u0445 \u0442\u0435\u043b\u00bb (1765) \u0441\u0442\u0430\u043b\u0430
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0413\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430:
    \u0412 1757 \u0433\u043e\u0434\u0443 \u042d\u0439\u043b\u0435\u0440 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u042d\u0439\u043b\u0435\u0440\u0430, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0438\u0435
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0439
    (\u043d\u0435\u0432\u044f\u0437\u043a\u043e\u0439) \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438.
    \u042d\u0442\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438.
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f: \u042d\u0439\u043b\u0435\u0440 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u041c\u043e\u043f\u0435\u0440\u0442\u044e\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u044d\u0442\u043e\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438, \u043f\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u043f\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0442\u0435\u043b\u0430
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430
    (\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435) \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442
    \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435.
    \u041e\u043f\u0442\u0438\u043a\u0430: \u0412 \u0441\u043f\u043e\u0440\u0435 \u043e \u043f\u0440\u0438\u0440\u043e\u0434\u0435
    \u0441\u0432\u0435\u0442\u0430 \u042d\u0439\u043b\u0435\u0440 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u043c \u0432\u043e\u043b\u043d\u043e\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432
    \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0431\u044b\u043b\u0430 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043e\u0439
    \u043d\u044c\u044e\u0442\u043e\u043d\u043e\u0432\u0441\u043a\u043e\u0439 \u043a\u043e\u0440\u043f\u0443\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438. \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0430\u0445\u0440\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043e\u0432 \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432.\n\n\U0001F30C
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f \u0438 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435
    \u043d\u0430\u0443\u043a\u0438 \u0413\u0435\u043d\u0438\u0439 \u042d\u0439\u043b\u0435\u0440\u0430
    \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b\u0441\u044f \u0438 \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438
    \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447. \u041d\u0435\u0431\u0435\u0441\u043d\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430:
    \u041e\u043d \u043c\u043d\u043e\u0433\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0435\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u041b\u0443\u043d\u044b (\u0437\u0430\u0434\u0430\u0447\u0430
    \u0442\u0440\u0451\u0445 \u0442\u0435\u043b: \u0421\u043e\u043b\u043d\u0446\u0435, \u0417\u0435\u043c\u043b\u044f,
    \u041b\u0443\u043d\u0430). \u0415\u0433\u043e \u0440\u0430\u0441\u0447\u0451\u0442\u044b
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0447\u043d\u044b,
    \u0447\u0442\u043e \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443
    \u043c\u043e\u0440\u0435\u0445\u043e\u0434\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0438\u0446
    \u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0434\u043e\u043b\u0433\u043e\u0442\u044b
    \u0432 \u043c\u043e\u0440\u0435. \u042d\u0439\u043b\u0435\u0440 \u0442\u0430\u043a\u0436\u0435
    \u043f\u0435\u0440\u0432\u044b\u043c \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u043c\u0430\u0441\u0441\u0443 \u041b\u0443\u043d\u044b,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432, \u0447\u0442\u043e \u043e\u043d\u0430
    \u043c\u0435\u043d\u044c\u0448\u0435 \u0437\u0435\u043c\u043d\u043e\u0439 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 81 \u0440\u0430\u0437. \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0435
    \u0440\u0430\u0441\u0447\u0451\u0442\u044b: \u042d\u0439\u043b\u0435\u0440 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c\u0438 \u043e\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439, \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0442\u0443\u0440\u0431\u0438\u043d \u0438 \u0432\u0435\u0442\u0440\u044f\u043d\u044b\u0445
    \u043c\u0435\u043b\u044c\u043d\u0438\u0446. \u0412 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u042d\u0439\u043b\u0435\u0440\u0430 \u0434\u043b\u044f \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0441\u0436\u0438\u043c\u0430\u0435\u043c\u0430\u044f \u043a\u043e\u043b\u043e\u043d\u043d\u0430
    \u0442\u0435\u0440\u044f\u0435\u0442 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u044c.
    \u042d\u0432\u043e\u043b\u044c\u0432\u0435\u043d\u0442\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c
    \u0437\u0443\u0431\u0430 \u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u043c\u0430\u0448\u0438\u043d\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0438,
    \u0442\u0430\u043a\u0436\u0435 \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438. \u041a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f:
    \u0420\u0430\u0431\u043e\u0442\u0430\u044f \u0432 \u0420\u043e\u0441\u0441\u0438\u0438,
    \u043e\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u0441\u0442\u0440\u0430\u043d\u044b, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u043f\u043e\u043b\u043d\u043e\u0433\u043e
    \u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u0442\u043b\u0430\u0441\u0430 \u0420\u043e\u0441\u0441\u0438\u0438 \u0432 1745 \u0433\u043e\u0434\u0443.\n\n\U0001F4DC
    \u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435
    \u042d\u0439\u043b\u0435\u0440 \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c, \u043d\u043e
    \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u00ab\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435
    \u043e \u0440\u0430\u0437\u043d\u044b\u0445 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u044f\u0445\u00bb
    (1768-1772) \u0441\u0442\u0430\u043b\u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u043e\u0441\u043d\u043e\u0432
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438, \u043e\u043f\u0442\u0438\u043a\u0438,
    \u0430\u043a\u0443\u0441\u0442\u0438\u043a\u0438 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438,
    \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u0432 \u043e\u043a\u043e\u043b\u043e 40 \u0438\u0437\u0434\u0430\u043d\u0438\u0439
    \u043d\u0430 10 \u044f\u0437\u044b\u043a\u0430\u0445. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438 \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435
    \u00ab\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb
    (1768-1769). \u0414\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u043d\u043e\u0439
    \u043f\u043e\u0442\u0435\u0440\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0432 1766 \u0433\u043e\u0434\u0443
    \u042d\u0439\u043b\u0435\u0440 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b, \u0441\u043e\u0437\u0434\u0430\u0432
    \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 17 \u043b\u0435\u0442
    \u0436\u0438\u0437\u043d\u0438 \u043e\u043a\u043e\u043b\u043e 380 \u0441\u0442\u0430\u0442\u0435\u0439
    \u0438 \u043a\u043d\u0438\u0433. \u0415\u0433\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c, \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u044f\u0441\u043d\u043e\u0441\u0442\u044c \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439
    \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
    \u00ab\u043e\u0431\u0449\u0438\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c\u00bb
    \u0434\u043b\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439
    \u0443\u0447\u0451\u043d\u044b\u0445. \u0415\u0441\u043b\u0438 \u0445\u043e\u0442\u0438\u0442\u0435,
    \u043c\u044b \u043c\u043e\u0436\u0435\u043c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435
    \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0430\u043a\u043e\u0439-\u043b\u0438\u0431\u043e
    \u0438\u0437 \u044d\u0442\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0430 \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b \u0438\u043b\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445 \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430
    \u042d\u0439\u043b\u0435\u0440\u0430 \u2014 \u044d\u0442\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u0441\u0447\u0430\u0441\u0442\u044c\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043d \u043e\u0431\u0440\u0451\u043b \u0432
    \u0441\u0435\u043c\u044c\u0435, \u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0435\u0433\u043e \u043d\u0435 \u0441\u043b\u043e\u043c\u0438\u043b\u0430. \u041e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439
    \u043b\u044e\u0431\u043e\u0432\u044c\u044e, \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u043c
    13 \u0434\u0435\u0442\u0435\u0439 \u0438 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0438 \u043f\u043e\u043b\u043d\u043e\u0433\u043e
    \u0434\u043e\u043c\u0430 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u0434\u0435\u0442\u0435\u0439.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0411\u0440\u0430\u043a \u0441 \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u043e\u0439 \u0413\u0437\u0435\u043b\u044c:
    \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u0432\u044c \u042d\u0439\u043b\u0435\u0440
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0435
    \u0413\u0437\u0435\u043b\u044c 7 \u044f\u043d\u0432\u0430\u0440\u044f 1734 \u0433\u043e\u0434\u0430,
    \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0432\u044b\u0441\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u043e\u0433\u043e
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0430 \u0413\u0435\u043e\u0440\u0433\u0430
    \u0413\u0437\u0435\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438,
    \u0438 \u0432\u043d\u0443\u0447\u043a\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u0446\u044b \u0438 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u0438\u0441\u0442\u043a\u0438
    \u041c\u0430\u0440\u0438\u0438 \u0421\u0438\u0431\u0438\u043b\u043b\u044b \u041c\u0435\u0440\u0438\u0430\u043d.
    \u041f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c,
    \u043e\u043d\u0430 \u0442\u043e\u0436\u0435 \u0431\u044b\u043b\u0430 \u0440\u043e\u0434\u043e\u043c
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439
    \u0441\u043e \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0438\u0435\u0439. \u0418\u0445
    \u0431\u0440\u0430\u043a, \u043f\u0440\u043e\u0434\u043b\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u043f\u043e\u0447\u0442\u0438 40 \u043b\u0435\u0442, \u0431\u044b\u043b \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c
    \u0438 \u043a\u0440\u0435\u043f\u043a\u0438\u043c. \u0417\u0430 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430 \u0440\u043e\u0434\u0438\u043b\u0430 \u042d\u0439\u043b\u0435\u0440\u0443
    13 \u0434\u0435\u0442\u0435\u0439. \u042d\u0442\u0430 \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u043e\u0433\u0440\u043e\u043c\u043d\u0430\u044f \u0441\u0435\u043c\u044c\u044f \u0441\u0442\u0430\u043b\u0430
    \u043d\u0435 \u043f\u043e\u043c\u0435\u0445\u043e\u0439, \u0430 \u0447\u0430\u0441\u0442\u044c\u044e
    \u0435\u0433\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438, \u0447\u0442\u043e \u042d\u0439\u043b\u0435\u0440
    \u0447\u0430\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u043b \u0441\u0432\u043e\u0438 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f, \u0434\u0435\u0440\u0436\u0430 \u043d\u0430
    \u0440\u0443\u043a\u0430\u0445 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u043c\u0430\u043b\u044b\u0448\u0435\u0439,
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u0434\u0440\u0443\u0433\u0438\u0435
    \u0434\u0435\u0442\u0438 \u0438\u0433\u0440\u0430\u043b\u0438 \u0443 \u0435\u0433\u043e
    \u043d\u043e\u0433. \u042d\u0442\u0430 \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0434\u0435\u0442\u0430\u043b\u044c \u0440\u0438\u0441\u0443\u0435\u0442 \u043e\u0431\u0440\u0430\u0437
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e, \u0434\u043b\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0441\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430 \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b\u0435\u043c\u043e\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u0436\u0438\u0437\u043d\u0438, \u0430 \u043d\u0435
    \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0435\u043c \u0434\u043b\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b. \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u0438\u0437 13 \u0434\u0435\u0442\u0435\u0439 \u0432\u044b\u0436\u0438\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u044f\u0442\u0435\u0440\u043e: \u0442\u0440\u0438 \u0441\u044b\u043d\u0430 \u0438
    \u0434\u0432\u0435 \u0434\u043e\u0447\u0435\u0440\u0438. \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u043e\u0431\u044b\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439
    \u0434\u043b\u044f XVIII \u0432\u0435\u043a\u0430, \u043a\u043e\u0433\u0434\u0430 \u0434\u0435\u0442\u0441\u043a\u0430\u044f
    \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u044c \u0431\u044b\u043b\u0430 \u043e\u0447\u0435\u043d\u044c
    \u0432\u044b\u0441\u043e\u043a\u0430.\n\n\U0001F3DB\ufe0f \u0414\u0435\u0442\u0438 \u0438
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0438
    \u0414\u0435\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u0436\u0438\u043b\u0438,
    \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043f\u043e\u0448\u043b\u0438 \u043f\u043e
    \u0441\u0442\u043e\u043f\u0430\u043c \u043e\u0442\u0446\u0430 \u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u0437\u0430\u043c\u0435\u0442\u043d\u044b\u0439 \u0441\u043b\u0435\u0434 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438:
    \u0418\u043e\u0433\u0430\u043d\u043d \u0410\u043b\u044c\u0431\u0440\u0435\u0445\u0442 \u042d\u0439\u043b\u0435\u0440
    (1734\u20131800): \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d, \u0440\u043e\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435. \u0421\u0442\u0430\u043b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0438 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u2014 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0451\u043c
    \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435.
    \u041e\u043d \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u043c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c
    \u043e\u0442\u0446\u0430, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430.
    \u041a\u0430\u0440\u043b \u041b\u0435\u043e\u043d\u0442\u044c\u0435\u0432\u0438\u0447 \u042d\u0439\u043b\u0435\u0440
    (1740\u20131790): \u0412\u0442\u043e\u0440\u043e\u0439 \u0441\u044b\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0448\u0451\u043b \u043f\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439
    \u0441\u0442\u0435\u0437\u0435. \u0425\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u0440 \u041b\u0435\u043e\u043d\u0442\u044c\u0435\u0432\u0438\u0447
    \u042d\u0439\u043b\u0435\u0440 (1743\u20131808): \u041c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0441\u044b\u043d, \u0438\u0437\u0431\u0440\u0430\u0432\u0448\u0438\u0439 \u0432\u043e\u0435\u043d\u043d\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0438 \u0434\u043e\u0441\u043b\u0443\u0436\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u0434\u043e \u0433\u0435\u043d\u0435\u0440\u0430\u043b-\u043b\u0435\u0439\u0442\u0435\u043d\u0430\u043d\u0442\u0430,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0432\u0448\u0438\u0439
    \u0421\u0435\u0441\u0442\u0440\u043e\u0440\u0435\u0446\u043a\u0438\u043c \u043e\u0440\u0443\u0436\u0435\u0439\u043d\u044b\u043c
    \u0437\u0430\u0432\u043e\u0434\u043e\u043c. \u041f\u043e\u0442\u043e\u043c\u043a\u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430
    \u042d\u0439\u043b\u0435\u0440\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b\u0438
    \u0435\u0433\u043e \u0440\u043e\u0434 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u0438
    \u0441\u0442\u0430\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043d\u0430
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0438 \u0432\u043e\u0435\u043d\u043d\u043e\u0439 \u0441\u043b\u0443\u0436\u0431\u0435.
    \u0421\u0440\u0435\u0434\u0438 \u043d\u0438\u0445 \u0431\u044b\u043b\u0438 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u044b,
    \u0433\u0443\u0431\u0435\u0440\u043d\u0430\u0442\u043e\u0440\u044b \u0438 \u043e\u0444\u0438\u0446\u0435\u0440\u044b.\n\n\U0001F494
    \u0412\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0412 1773 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u043f\u043e\u0447\u0442\u0438 40 \u043b\u0435\u0442 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c.
    \u042d\u0439\u043b\u0435\u0440 \u0442\u044f\u0436\u0435\u043b\u043e \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043b
    \u043f\u043e\u0442\u0435\u0440\u044e. \u0421\u043f\u0443\u0441\u0442\u044f \u0442\u0440\u0438
    \u0433\u043e\u0434\u0430, \u0432 1776 \u0433\u043e\u0434\u0443, \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0435\u0451 \u0441\u0432\u043e\u0434\u043d\u043e\u0439 \u0441\u0435\u0441\u0442\u0440\u0435
    \u2014 \u0421\u0430\u043b\u043e\u043c\u0435\u0435 \u0410\u0431\u0438\u0433\u0435\u0439\u043b
    \u0413\u0437\u0435\u043b\u044c. \u0412\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a,
    \u043f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c,
    \u0442\u043e\u0436\u0435 \u0431\u044b\u043b \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c,
    \u0438 \u0421\u0430\u043b\u043e\u043c\u0435\u044f \u0437\u0430\u0431\u043e\u0442\u0438\u043b\u0430\u0441\u044c
    \u043e\u0431 \u0443\u0436\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u043b\u0435\u043f\u0448\u0435\u043c
    \u0443\u0447\u0451\u043d\u043e\u043c \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0432 1783 \u0433\u043e\u0434\u0443. \u0422\u0430\u043a\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u042d\u0439\u043b\u0435\u0440\u0430, \u043e\u043c\u0440\u0430\u0447\u0451\u043d\u043d\u0430\u044f
    \u043f\u043e\u0442\u0435\u0440\u0435\u0439 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0435\u0442\u0435\u0439
    \u0438 \u0434\u0432\u0443\u0445 \u0442\u044f\u0436\u0451\u043b\u044b\u0445 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439
    \u043d\u0430 \u0433\u043b\u0430\u0437\u0430\u0445, \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0435\u0433\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u044c \u0438 \u0436\u0438\u0437\u043d\u0435\u043b\u044e\u0431\u0438\u0435.
    \u0421\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u043d\u0430\u0434\u0451\u0436\u043d\u043e\u0439 \u0433\u0430\u0432\u0430\u043d\u044c\u044e,
    \u0442\u043e\u0439 \u0441\u0430\u043c\u043e\u0439 \"\u0442\u0438\u0445\u043e\u0439 \u043f\u0440\u0438\u0441\u0442\u0430\u043d\u044c\u044e\",
    \u043e\u0442\u043a\u0443\u0434\u0430 \u043e\u043d \u0447\u0435\u0440\u043f\u0430\u043b \u0441\u0438\u043b\u044b
    \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0439."
  personalLifeEn: 
  shortBioRu: "\u041b\u0435\u043e\u043d\u0430\u0440\u0434 \u042d\u0439\u043b\u0435\u0440 \u2014 \u044d\u0442\u043e,
    \u0431\u0435\u0437 \u043f\u0440\u0435\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044f,
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043c\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430.
    \u041e\u043d \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0447\u0451\u043d\u044b\u043c,
    \u0447\u044c\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043e\u0445\u0432\u0430\u0442\u0438\u043b\u0438
    \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435
    \u0442\u043e\u0433\u0434\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u0438.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b\u0430\u0441\u044c
    \u0434\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u043d\u043e\u0439
    \u043f\u043e\u0442\u0435\u0440\u0438 \u0437\u0440\u0435\u043d\u0438\u044f.\n\n\U0001F4DC
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u044e\u043d\u043e\u0441\u0442\u044c:
    \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0433\u0435\u043d\u0438\u044f
    \u0432 \u0411\u0430\u0437\u0435\u043b\u0435 \u041b\u0435\u043e\u043d\u0430\u0440\u0434 \u042d\u0439\u043b\u0435\u0440
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 15 \u0430\u043f\u0440\u0435\u043b\u044f 1707
    \u0433\u043e\u0434\u0430 \u0432 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u0430\u0437\u0435\u043b\u0435, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u043f\u0430\u0441\u0442\u043e\u0440\u0430 \u041f\u0430\u0443\u043b\u044f \u042d\u0439\u043b\u0435\u0440\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0430\u043c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0438 \u043a\u043e\u0433\u0434\u0430-\u0442\u043e
    \u0443\u0447\u0438\u043b\u0441\u044f \u0443 \u042f\u043a\u043e\u0431\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438.
    \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u043e\u0442\u0435\u0446
    \u0433\u043e\u0442\u043e\u0432\u0438\u043b \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430
    \u043a \u0434\u0443\u0445\u043e\u0432\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u0435,
    \u043d\u043e \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u0432\u0438\u043b \u0435\u043c\u0443
    \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u042d\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0441\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u044b\u043c
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c. \u0412 1720 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 13 \u043b\u0435\u0442, \u042d\u0439\u043b\u0435\u0440
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0411\u0430\u0437\u0435\u043b\u044c\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0422\u0430\u043c \u043e\u043d
    \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u0440\u0438\u0432\u043b\u0451\u043a \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c
    \u0438 \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b \u0432 \u044e\u043d\u043e\u0448\u0435
    \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u044b\u0439 \u0442\u0430\u043b\u0430\u043d\u0442.
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0434\u0430\u0432\u0430\u043b \u0435\u043c\u0443
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0442\u0430\u0442\u044c\u0438 \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f, \u0430 \u043f\u043e \u0441\u0443\u0431\u0431\u043e\u0442\u0430\u043c
    \u043b\u0438\u0447\u043d\u043e \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043b \u0441 \u043d\u0438\u043c
    \u0442\u0440\u0443\u0434\u043d\u044b\u0435 \u043c\u0435\u0441\u0442\u0430. \u042d\u0442\u043e\u0442
    \u043e\u043f\u044b\u0442 \u042d\u0439\u043b\u0435\u0440 \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u043b\u0443\u0447\u0448\u0438\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c \u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f
    \u0443\u0441\u043f\u0435\u0445\u0430 \u0432 \u043d\u0430\u0443\u043a\u0435. \u0412 1724
    \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 17 \u043b\u0435\u0442,
    \u042d\u0439\u043b\u0435\u0440 \u043f\u0440\u043e\u0438\u0437\u043d\u0451\u0441 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0443\u044e
    \u0440\u0435\u0447\u044c \u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432. \u041f\u043e\u0437\u0436\u0435 \u043e\u043d
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432 \u0411\u0430\u0437\u0435\u043b\u0435, \u043d\u043e \u0435\u0433\u043e \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0443\u0440\u0443
    \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b\u0438 \u0438\u0437-\u0437\u0430 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u044e\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430.\n\n\U0001F1F7\U0001F1FA
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    (1727\u20131741): \u043f\u0435\u0440\u0432\u044b\u0435 \u0442\u0440\u0438\u0443\u043c\u0444\u044b
    \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0441\u0443\u0434\u044c\u0431\u0435 \u042d\u0439\u043b\u0435\u0440\u0430 \u0441\u0442\u0430\u043b\u043e
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u043d\u0435\u0434\u0430\u0432\u043d\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a \u0432 1726 \u0433\u043e\u0434\u0443.
    \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044e \u0435\u043c\u0443
    \u0434\u0430\u043b\u0438 \u0431\u0440\u0430\u0442\u044c\u044f \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438
    \u0442\u0430\u043c. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e
    \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u0435\u043c\u0443 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b\u0438
    \u043c\u0435\u0441\u0442\u043e \u043f\u043e \u043a\u0430\u0444\u0435\u0434\u0440\u0435 \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0438,
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u043d \u0432\u0441\u0435\u0440\u044c\u0451\u0437
    \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435\u043c
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b. \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e
    \u043f\u0440\u0438\u0431\u044b\u0442\u0438\u0438 \u0432 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433
    24 \u043c\u0430\u044f 1727 \u0433\u043e\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u0430\u0434\u044a\u044e\u043d\u043a\u0442\u043e\u043c \u043f\u043e \u0432\u044b\u0441\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0412 \u0420\u043e\u0441\u0441\u0438\u0438
    \u0442\u0430\u043b\u0430\u043d\u0442 \u042d\u0439\u043b\u0435\u0440\u0430 \u0440\u0430\u0441\u043a\u0440\u044b\u043b\u0441\u044f
    \u0432 \u043f\u043e\u043b\u043d\u043e\u0439 \u043c\u0435\u0440\u0435. \u041e\u043d \u0431\u044b\u0441\u0442\u0440\u043e
    \u043e\u0441\u0432\u043e\u0438\u043b \u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a
    \u0438 \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u043b\u0441\u044f \u0432 \u0440\u0430\u0431\u043e\u0442\u0443.
    \u0415\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u0448\u043b\u0430 \u0432 \u0433\u043e\u0440\u0443: \u0412 1731 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0444\u0438\u0437\u0438\u043a\u0438, \u0430 \u0432 1733 \u0433\u043e\u0434\u0443 \u2014
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432\u044b\u0441\u0448\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0441\u043c\u0435\u043d\u0438\u0432 \u0443\u0435\u0445\u0430\u0432\u0448\u0435\u0433\u043e
