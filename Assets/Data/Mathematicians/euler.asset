    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438. \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c.
    \u042d\u0439\u043b\u0435\u0440 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0420\u043e\u0441\u0441\u0438\u0438, \u043f\u0438\u0441\u0430\u043b \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438,
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439.
    \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445
    \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u0441\u0442\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043f\u043e \u0440\u0430\u0441\u0447\u0451\u0442\u0443 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438
    \u043a\u043e\u043c\u0435\u0442\u044b \u0432 1735 \u0433\u043e\u0434\u0443. \u0413\u0440\u0443\u043f\u043f\u0430
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0441\u0438\u043b\u0430
    \u043d\u0430 \u044d\u0442\u043e \u0442\u0440\u0438 \u043c\u0435\u0441\u044f\u0446\u0430,
    \u0430 \u042d\u0439\u043b\u0435\u0440 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043b \u0432\u0441\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0432\u0441\u0435\u0433\u043e
    \u0437\u0430 \u0442\u0440\u0438 \u0434\u043d\u044f! \u041e\u0434\u043d\u0430\u043a\u043e
    \u0442\u0430\u043a\u043e\u0435 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435
    \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0431\u043e\u043b\u0435\u0437\u043d\u0438, \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u043f\u0440\u0430\u0432\u044b\u0439 \u0433\u043b\u0430\u0437. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u044d\u0442\u043e, \u0432 1736 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u043e
    \u0435\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0434\u0432\u0443\u0445\u0442\u043e\u043c\u043d\u043e\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435
    \u00ab\u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430, \u0438\u043b\u0438 \u041d\u0430\u0443\u043a\u0430
    \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438, \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u00bb, \u0433\u0434\u0435
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u0442\u0435\u043b, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u043d\u043e\u0432\u043e\u0439 \u044d\u0440\u044b \u0432 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435.\n\n\U0001F1E9\U0001F1EA
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    (1741\u20131766): \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0412 1741 \u0433\u043e\u0434\u0443, \u043d\u0430 \u0444\u043e\u043d\u0435 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0439
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438
    \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
