    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u043e \u0441\u0432\u043e\u0435\u043c\u0443 \u043e\u0431\u044a\u0451\u043c\u0443 \u0438
    \u0437\u043d\u0430\u0447\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u0435 \u0438\u043c\u0435\u0435\u0442
    \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438.
    \u0415\u0433\u043e \u043f\u0435\u0440\u0443 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442
    \u043e\u043a\u043e\u043b\u043e 850 \u0440\u0430\u0431\u043e\u0442, \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0445
    \u0432\u0441\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0435\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0444\u0438\u0437\u0438\u043a\u0443, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e
    \u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a. \u041f\u043e \u043e\u0446\u0435\u043d\u043a\u0430\u043c, \u0435\u0433\u043e
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438
    \u043e\u043a\u043e\u043b\u043e \u0442\u0440\u0435\u0442\u0438 \u0432\u0441\u0435\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438\u0437\u0434\u0430\u043d\u0438\u0439 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435
    \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435
    \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044e\u044e \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044c
    XVIII \u0432\u0435\u043a\u0430. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u0445.\n\n\U0001F9EE
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u044f\u0437\u044b\u043a\u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u042d\u0439\u043b\u0435\u0440 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447, \u043e\u043d \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u0441\u043e\u0437\u0434\u0430\u043b \u044f\u0437\u044b\u043a, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u043a\u0430.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430
    \u2014 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438\u0437 \u043d\u0430\u0431\u043e\u0440\u0430
    \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0432 \u0435\u0434\u0438\u043d\u0443\u044e, \u0441\u0442\u0440\u043e\u0439\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443. \u041a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438: \u0412 \u0441\u0432\u043e\u0451\u043c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445\u00bb
    (1748) \u042d\u0439\u043b\u0435\u0440 \u043f\u043e\u043b\u043e\u0436\u0438\u043b \u0432
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0432\u0441\u0435\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u0414\u043e
    \u043d\u0435\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437 \u0431\u044b\u043b \u0441\u043a\u043e\u0440\u0435\u0435
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0438\u0451\u043c\u043e\u0432. \u042d\u0439\u043b\u0435\u0440 \u0436\u0435
    \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u00ab\u0432\u0435\u0441\u044c
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u043c\u0430\u043b\u044b\u0445 \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432\u043e\u043a\u0440\u0443\u0433
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0432\u0435\u043b\u0438\u0447\u0438\u043d
    \u0438 \u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439\u00bb, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432
    \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u043a\u0430\u043a \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0435. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u0442\u0434\u0435\u043b\u0438\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043e\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0438 \u043f\u0440\u0438\u0434\u0430\u043b\u0430
    \u0435\u0439 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043d\u043e\u0432\u044b\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438: \u042d\u0439\u043b\u0435\u0440
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u2014 \u0440\u0430\u0437\u0434\u0435\u043b\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0449\u0435\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c
    \u0438\u043b\u0438 \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0440\u0430\u0437\u0432\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0437\u0430\u043b\u043e\u0436\u0438\u0432
    \u043e\u0441\u043d\u043e\u0432\u044b \u043a\u0430\u043a \u0434\u043b\u044f \u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0445,
    \u0442\u0430\u043a \u0438 \u0434\u043b\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445.
    \u041d\u043e\u0432\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b: \u042d\u0439\u043b\u0435\u0440 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432 \u043c\u0435\u0442\u043e\u0434\u044b \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0441\u0432\u043e\u0439\u0441\u0442\u0432
    \u0446\u0435\u043b\u044b\u0445 \u0447\u0438\u0441\u0435\u043b. \u0412 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0441\u0442\u0430\u043b\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0437\u0430\u043a\u043e\u043d\u0430 \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438
    (\u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u0437\u0430\u043a\u043e\u043d
    \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438), \u0441\u0442\u0430\u0432\u0448\u0435\u0433\u043e
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u043a\u0430: \u041c\u043d\u043e\u0433\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u0441\u0447\u0438\u0442\u0430\u0435\u043c \u0441\u0430\u043c\u043e \u0441\u043e\u0431\u043e\u0439
    \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0449\u0438\u043c\u0438\u0441\u044f, \u0432\u0432\u0451\u043b
    \u0438\u043c\u0435\u043d\u043d\u043e \u042d\u0439\u043b\u0435\u0440. \u0421\u0440\u0435\u0434\u0438
    \u043d\u0438\u0445: f(x) \u2014 \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u03a3 \u2014 \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0441\u0443\u043c\u043c\u044b. e \u2014 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0430.
    i \u2014 \u043c\u043d\u0438\u043c\u0430\u044f \u0435\u0434\u0438\u043d\u0438\u0446\u0430.
    \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u044f \u03c0 (\u043f\u0438).\n\n\u2699\ufe0f
    \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u043a\u0430:
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0444\u0438\u0437\u0438\u043a\u0438 \u043d\u0430
    \u044f\u0437\u044b\u043a \u0444\u043e\u0440\u043c\u0443\u043b \u0412\u043a\u043b\u0430\u0434
    \u042d\u0439\u043b\u0435\u0440\u0430 \u0432 \u0444\u0438\u0437\u0438\u043a\u0443 \u043d\u0435
    \u043c\u0435\u043d\u0435\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u0435\u043d.
    \u0415\u0441\u043b\u0438 \u041d\u044c\u044e\u0442\u043e\u043d \u0438\u0437\u043b\u0430\u0433\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0437\u0430\u043a\u043e\u043d\u044b \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0442\u043e \u042d\u0439\u043b\u0435\u0440 \u043f\u0435\u0440\u0435\u0432\u0435\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443
    \u043d\u0430 \u044f\u0437\u044b\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u0441\u0434\u0435\u043b\u0430\u0432 \u0435\u0451
    \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439 \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432.
    \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430:
    \u0415\u0433\u043e \u0434\u0432\u0443\u0445\u0442\u043e\u043c\u043d\u0430\u044f \u00ab\u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430,
    \u0438\u043b\u0438 \u041d\u0430\u0443\u043a\u0430 \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438,
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u00bb
    (1736) \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u044b\u043c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c,
    \u0433\u0434\u0435 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0442\u043e\u0447\u043a\u0438
    \u0431\u044b\u043b\u0430 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u042d\u0442\u043e \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e \u0435\u043c\u0443 \u043e\u0431\u0449\u0435\u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c. \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430
    \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430: \u042d\u0439\u043b\u0435\u0440
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438
    \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430. \u041e\u043d
    \u0432\u0432\u0451\u043b \u00ab\u0443\u0433\u043b\u044b \u042d\u0439\u043b\u0435\u0440\u0430\u00bb
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430, \u0432\u044b\u0432\u0435\u043b
    \u00ab\u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u042d\u0439\u043b\u0435\u0440\u0430\u00bb
    \u0434\u043b\u044f \u0435\u0433\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0438
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u043b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u0446\u0435\u043d\u0442\u0440\u0430 \u043c\u0430\u0441\u0441 \u0438 \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432\u043e\u043a\u0440\u0443\u0433 \u043d\u0435\u0433\u043e. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u0422\u0435\u043e\u0440\u0438\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u0442\u0432\u0451\u0440\u0434\u044b\u0445 \u0442\u0435\u043b\u00bb (1765) \u0441\u0442\u0430\u043b\u0430
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0413\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430:
    \u0412 1757 \u0433\u043e\u0434\u0443 \u042d\u0439\u043b\u0435\u0440 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u042d\u0439\u043b\u0435\u0440\u0430, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0438\u0435
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0439
    (\u043d\u0435\u0432\u044f\u0437\u043a\u043e\u0439) \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438.
    \u042d\u0442\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438.
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f: \u042d\u0439\u043b\u0435\u0440 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u041c\u043e\u043f\u0435\u0440\u0442\u044e\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u044d\u0442\u043e\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438, \u043f\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u043f\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0442\u0435\u043b\u0430
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430
    (\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435) \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442
    \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435.
    \u041e\u043f\u0442\u0438\u043a\u0430: \u0412 \u0441\u043f\u043e\u0440\u0435 \u043e \u043f\u0440\u0438\u0440\u043e\u0434\u0435
    \u0441\u0432\u0435\u0442\u0430 \u042d\u0439\u043b\u0435\u0440 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u043c \u0432\u043e\u043b\u043d\u043e\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432
    \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0431\u044b\u043b\u0430 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043e\u0439
    \u043d\u044c\u044e\u0442\u043e\u043d\u043e\u0432\u0441\u043a\u043e\u0439 \u043a\u043e\u0440\u043f\u0443\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438. \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0430\u0445\u0440\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043e\u0432 \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432.\n\n\U0001F30C
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f \u0438 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435
    \u043d\u0430\u0443\u043a\u0438 \u0413\u0435\u043d\u0438\u0439 \u042d\u0439\u043b\u0435\u0440\u0430
    \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b\u0441\u044f \u0438 \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438
    \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447. \u041d\u0435\u0431\u0435\u0441\u043d\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430:
    \u041e\u043d \u043c\u043d\u043e\u0433\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0435\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u041b\u0443\u043d\u044b (\u0437\u0430\u0434\u0430\u0447\u0430
    \u0442\u0440\u0451\u0445 \u0442\u0435\u043b: \u0421\u043e\u043b\u043d\u0446\u0435, \u0417\u0435\u043c\u043b\u044f,
    \u041b\u0443\u043d\u0430). \u0415\u0433\u043e \u0440\u0430\u0441\u0447\u0451\u0442\u044b
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0447\u043d\u044b,
    \u0447\u0442\u043e \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443
    \u043c\u043e\u0440\u0435\u0445\u043e\u0434\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0438\u0446
    \u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0434\u043e\u043b\u0433\u043e\u0442\u044b
    \u0432 \u043c\u043e\u0440\u0435. \u042d\u0439\u043b\u0435\u0440 \u0442\u0430\u043a\u0436\u0435
    \u043f\u0435\u0440\u0432\u044b\u043c \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u043c\u0430\u0441\u0441\u0443 \u041b\u0443\u043d\u044b,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432, \u0447\u0442\u043e \u043e\u043d\u0430
    \u043c\u0435\u043d\u044c\u0448\u0435 \u0437\u0435\u043c\u043d\u043e\u0439 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 81 \u0440\u0430\u0437. \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0435
    \u0440\u0430\u0441\u0447\u0451\u0442\u044b: \u042d\u0439\u043b\u0435\u0440 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c\u0438 \u043e\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439, \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0442\u0443\u0440\u0431\u0438\u043d \u0438 \u0432\u0435\u0442\u0440\u044f\u043d\u044b\u0445
    \u043c\u0435\u043b\u044c\u043d\u0438\u0446. \u0412 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u042d\u0439\u043b\u0435\u0440\u0430 \u0434\u043b\u044f \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0441\u0436\u0438\u043c\u0430\u0435\u043c\u0430\u044f \u043a\u043e\u043b\u043e\u043d\u043d\u0430
    \u0442\u0435\u0440\u044f\u0435\u0442 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u044c.
    \u042d\u0432\u043e\u043b\u044c\u0432\u0435\u043d\u0442\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c
    \u0437\u0443\u0431\u0430 \u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u043c\u0430\u0448\u0438\u043d\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0438,
    \u0442\u0430\u043a\u0436\u0435 \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438. \u041a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f:
    \u0420\u0430\u0431\u043e\u0442\u0430\u044f \u0432 \u0420\u043e\u0441\u0441\u0438\u0438,
    \u043e\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u0441\u0442\u0440\u0430\u043d\u044b, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u043f\u043e\u043b\u043d\u043e\u0433\u043e
    \u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u0442\u043b\u0430\u0441\u0430 \u0420\u043e\u0441\u0441\u0438\u0438 \u0432 1745 \u0433\u043e\u0434\u0443.\n\n\U0001F4DC
    \u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435
    \u042d\u0439\u043b\u0435\u0440 \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c, \u043d\u043e
    \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u00ab\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435
    \u043e \u0440\u0430\u0437\u043d\u044b\u0445 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u044f\u0445\u00bb
    (1768-1772) \u0441\u0442\u0430\u043b\u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u043e\u0441\u043d\u043e\u0432
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438, \u043e\u043f\u0442\u0438\u043a\u0438,
    \u0430\u043a\u0443\u0441\u0442\u0438\u043a\u0438 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438,
    \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u0432 \u043e\u043a\u043e\u043b\u043e 40 \u0438\u0437\u0434\u0430\u043d\u0438\u0439
    \u043d\u0430 10 \u044f\u0437\u044b\u043a\u0430\u0445. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438 \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435
    \u00ab\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb
    (1768-1769). \u0414\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u043d\u043e\u0439
    \u043f\u043e\u0442\u0435\u0440\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0432 1766 \u0433\u043e\u0434\u0443
    \u042d\u0439\u043b\u0435\u0440 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b, \u0441\u043e\u0437\u0434\u0430\u0432
    \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 17 \u043b\u0435\u0442
    \u0436\u0438\u0437\u043d\u0438 \u043e\u043a\u043e\u043b\u043e 380 \u0441\u0442\u0430\u0442\u0435\u0439
    \u0438 \u043a\u043d\u0438\u0433. \u0415\u0433\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c, \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u044f\u0441\u043d\u043e\u0441\u0442\u044c \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439
    \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
    \u00ab\u043e\u0431\u0449\u0438\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c\u00bb
    \u0434\u043b\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439
    \u0443\u0447\u0451\u043d\u044b\u0445. \u0415\u0441\u043b\u0438 \u0445\u043e\u0442\u0438\u0442\u0435,
    \u043c\u044b \u043c\u043e\u0436\u0435\u043c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435
    \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0430\u043a\u043e\u0439-\u043b\u0438\u0431\u043e
    \u0438\u0437 \u044d\u0442\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0430 \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b \u0438\u043b\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445 \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438."
  achievementsEn: "Leonard Eyler left behind a scientific heritage that is of no size and significance in history, with about 850 pieces of work covering all parts of modern mathematics and mechanics, as well as physics, astronomy and many applied sciences, estimated at about one third of all scientific publications in mathematics, theoretical physics and mechanics in Europe in the last quarter of the eighteenth century.Its contribution can be seen in several interrelated areas.\n\nMathematics: building the language of modern science, Miller has not only solved many complex problems, but has literally created a language that is spoken by modern mathematics and physics. His main advantage is to transform mathematical analysis from a set of fragmented methods into a single, coherent system. The concept of function: In his fundamental work, Introduction to the Analysis of Unfinishables (1748), the concept of function was the basis of all analysis.Before that, the analysis was more of a collection of geometric and algebraic techniques, and the other thing that did it was that \"all analysis of infinitely small amounts revolves around variables and their functions,\" defining the function as an analytical expression, it was a revolution that separated mathematics from geometrics and made it independent.Creation of new sections of mathematics: Euler is rightly considered to be the creator of the variable calculation, a section that seeks functions that produce a maximum or minimum of a certain amount; it has also systematically developed the theory of differential equations, laying the foundations for both ordinary and private derivatives.New areas and numbers theory: Eyler laid the foundation for the analytical theory of numbers, using for the first time the methods of analysis to study the properties of whole numbers. In this area, his greatest achievement was the opening of the law of reciprocity (quadratic law of reciprocity) which became the cornerstone of modern numbers theory. Modern symbols: Many mathematical symbols that we today consider to be self-evident are the ones that have introduced the Eulerian.Among them is f(x) for function. \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\n===Mechanics and physics===The translation of physics into formula language is no less fundamental. If Newton has laid down his laws primarily in geometry, he has translated mechanics into mathematical analysis, making it available for calculation. Analytical mechanics: His two-volume \"Mechanics, or Science on Movement, as described by analytically\" (1736) was the first textbook where the dynamics of the dot were presented using a new calculation.This brought him a pan-European celebrity. A solid-body mechanic: Eyler laid the foundations for solid-body mechanics. He introduced the \"Eyler's corners\" to describe the spinning of the solid body, brought out the \"Eyler equations\" for his motion, and divided the motion of the mass centre and the rotation around him. His work \"Stored Body Theory\" (1765) became classic in this field.Hydrodynamics: In 1757, Euler published the famous Eulerian equations describing the movement of the ideal liquid, which is the foundation of hydrodynamics. The principle of least action: The lowest effect: The last-action formula, together with Mopertuy, mathematically formulated this fundamental variation principle of mechanics, showing that when the body moves, a certain value (act) takes a minimum value.Optics: In a dispute about the nature of light, Eyler advocated wave theory, which at the time was an alternative to Newton's corporate theory, and he also theoretically justified the possibility of creating acromatic lens for telescopes.\n\nAstronomics and applied sciences of the genius of Eulerian have also been found in specific practical tasks. He was also the first to calculate the mass of the moon with great precision.Engineering calculations: Eyler has been dealing with ship stability problems, created turbine theory and windmills. In the area of material resistance, there is a critical load formula known for the Eulerian formula, in which the compressed column loses stability. The evolvant profile of the tooth of the six, which is used in machine construction, is also linked to its work.Cartography: While working in Russia, he led the mapping of the country, leading to the creation of a complete geographical atlas of Russia in 1745.\n\n▪ Eyler's scientific education was not only a researcher, but also an outstanding popularist of science. His \"Write to the German Princess on various physical and philosophical matter\" (1768-1772) was a brilliant illustration of the basics of mechanics, optics, acoustics, and astronomy, with about 40 publications in 10 languages. He also wrote classic textbooks on algebra \"Universal Arifmetics\" (1768-1769).Even after a complete loss of vision in 1766, Euler continued to dictate his work by creating some 380 articles and books over the last 17 years, his extraordinary productivity, remarkable clarity and depth of discovery have made him a real \"general teacher\" for subsequent generations of scientists. If you want, we can elaborate on any of these areas, such as his contribution to numbers theory or hydrodynamic equations."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430
    \u042d\u0439\u043b\u0435\u0440\u0430 \u2014 \u044d\u0442\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u0441\u0447\u0430\u0441\u0442\u044c\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043d \u043e\u0431\u0440\u0451\u043b \u0432
    \u0441\u0435\u043c\u044c\u0435, \u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0435\u0433\u043e \u043d\u0435 \u0441\u043b\u043e\u043c\u0438\u043b\u0430. \u041e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439
    \u043b\u044e\u0431\u043e\u0432\u044c\u044e, \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u043c
    13 \u0434\u0435\u0442\u0435\u0439 \u0438 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0438 \u043f\u043e\u043b\u043d\u043e\u0433\u043e
    \u0434\u043e\u043c\u0430 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u0434\u0435\u0442\u0435\u0439.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0411\u0440\u0430\u043a \u0441 \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u043e\u0439 \u0413\u0437\u0435\u043b\u044c:
    \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u0432\u044c \u042d\u0439\u043b\u0435\u0440
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0435
    \u0413\u0437\u0435\u043b\u044c 7 \u044f\u043d\u0432\u0430\u0440\u044f 1734 \u0433\u043e\u0434\u0430,
    \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0432\u044b\u0441\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u043e\u0433\u043e
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0430 \u0413\u0435\u043e\u0440\u0433\u0430
    \u0413\u0437\u0435\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438,
    \u0438 \u0432\u043d\u0443\u0447\u043a\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u0446\u044b \u0438 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u0438\u0441\u0442\u043a\u0438
    \u041c\u0430\u0440\u0438\u0438 \u0421\u0438\u0431\u0438\u043b\u043b\u044b \u041c\u0435\u0440\u0438\u0430\u043d.
    \u041f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c,
    \u043e\u043d\u0430 \u0442\u043e\u0436\u0435 \u0431\u044b\u043b\u0430 \u0440\u043e\u0434\u043e\u043c
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439
    \u0441\u043e \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0438\u0435\u0439. \u0418\u0445
    \u0431\u0440\u0430\u043a, \u043f\u0440\u043e\u0434\u043b\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u043f\u043e\u0447\u0442\u0438 40 \u043b\u0435\u0442, \u0431\u044b\u043b \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c
    \u0438 \u043a\u0440\u0435\u043f\u043a\u0438\u043c. \u0417\u0430 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430 \u0440\u043e\u0434\u0438\u043b\u0430 \u042d\u0439\u043b\u0435\u0440\u0443
    13 \u0434\u0435\u0442\u0435\u0439. \u042d\u0442\u0430 \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u043e\u0433\u0440\u043e\u043c\u043d\u0430\u044f \u0441\u0435\u043c\u044c\u044f \u0441\u0442\u0430\u043b\u0430
    \u043d\u0435 \u043f\u043e\u043c\u0435\u0445\u043e\u0439, \u0430 \u0447\u0430\u0441\u0442\u044c\u044e
    \u0435\u0433\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438, \u0447\u0442\u043e \u042d\u0439\u043b\u0435\u0440
    \u0447\u0430\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u043b \u0441\u0432\u043e\u0438 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f, \u0434\u0435\u0440\u0436\u0430 \u043d\u0430
    \u0440\u0443\u043a\u0430\u0445 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u043c\u0430\u043b\u044b\u0448\u0435\u0439,
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u0434\u0440\u0443\u0433\u0438\u0435
    \u0434\u0435\u0442\u0438 \u0438\u0433\u0440\u0430\u043b\u0438 \u0443 \u0435\u0433\u043e
    \u043d\u043e\u0433. \u042d\u0442\u0430 \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0434\u0435\u0442\u0430\u043b\u044c \u0440\u0438\u0441\u0443\u0435\u0442 \u043e\u0431\u0440\u0430\u0437
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e, \u0434\u043b\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0441\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430 \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b\u0435\u043c\u043e\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u0436\u0438\u0437\u043d\u0438, \u0430 \u043d\u0435
    \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0435\u043c \u0434\u043b\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b. \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u0438\u0437 13 \u0434\u0435\u0442\u0435\u0439 \u0432\u044b\u0436\u0438\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u044f\u0442\u0435\u0440\u043e: \u0442\u0440\u0438 \u0441\u044b\u043d\u0430 \u0438
    \u0434\u0432\u0435 \u0434\u043e\u0447\u0435\u0440\u0438. \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u043e\u0431\u044b\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439
    \u0434\u043b\u044f XVIII \u0432\u0435\u043a\u0430, \u043a\u043e\u0433\u0434\u0430 \u0434\u0435\u0442\u0441\u043a\u0430\u044f
    \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u044c \u0431\u044b\u043b\u0430 \u043e\u0447\u0435\u043d\u044c
    \u0432\u044b\u0441\u043e\u043a\u0430.\n\n\U0001F3DB\ufe0f \u0414\u0435\u0442\u0438 \u0438
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0438
    \u0414\u0435\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u0436\u0438\u043b\u0438,
    \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043f\u043e\u0448\u043b\u0438 \u043f\u043e
    \u0441\u0442\u043e\u043f\u0430\u043c \u043e\u0442\u0446\u0430 \u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u0437\u0430\u043c\u0435\u0442\u043d\u044b\u0439 \u0441\u043b\u0435\u0434 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438:
    \u0418\u043e\u0433\u0430\u043d\u043d \u0410\u043b\u044c\u0431\u0440\u0435\u0445\u0442 \u042d\u0439\u043b\u0435\u0440
    (1734\u20131800): \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d, \u0440\u043e\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435. \u0421\u0442\u0430\u043b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0438 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u2014 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0451\u043c
    \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435.
    \u041e\u043d \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u043c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c
    \u043e\u0442\u0446\u0430, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430.
    \u041a\u0430\u0440\u043b \u041b\u0435\u043e\u043d\u0442\u044c\u0435\u0432\u0438\u0447 \u042d\u0439\u043b\u0435\u0440
    (1740\u20131790): \u0412\u0442\u043e\u0440\u043e\u0439 \u0441\u044b\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0448\u0451\u043b \u043f\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439
    \u0441\u0442\u0435\u0437\u0435. \u0425\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u0440 \u041b\u0435\u043e\u043d\u0442\u044c\u0435\u0432\u0438\u0447
    \u042d\u0439\u043b\u0435\u0440 (1743\u20131808): \u041c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0441\u044b\u043d, \u0438\u0437\u0431\u0440\u0430\u0432\u0448\u0438\u0439 \u0432\u043e\u0435\u043d\u043d\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0438 \u0434\u043e\u0441\u043b\u0443\u0436\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u0434\u043e \u0433\u0435\u043d\u0435\u0440\u0430\u043b-\u043b\u0435\u0439\u0442\u0435\u043d\u0430\u043d\u0442\u0430,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0432\u0448\u0438\u0439
    \u0421\u0435\u0441\u0442\u0440\u043e\u0440\u0435\u0446\u043a\u0438\u043c \u043e\u0440\u0443\u0436\u0435\u0439\u043d\u044b\u043c
    \u0437\u0430\u0432\u043e\u0434\u043e\u043c. \u041f\u043e\u0442\u043e\u043c\u043a\u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430
    \u042d\u0439\u043b\u0435\u0440\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b\u0438
    \u0435\u0433\u043e \u0440\u043e\u0434 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u0438
    \u0441\u0442\u0430\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043d\u0430
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0438 \u0432\u043e\u0435\u043d\u043d\u043e\u0439 \u0441\u043b\u0443\u0436\u0431\u0435.
    \u0421\u0440\u0435\u0434\u0438 \u043d\u0438\u0445 \u0431\u044b\u043b\u0438 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u044b,
    \u0433\u0443\u0431\u0435\u0440\u043d\u0430\u0442\u043e\u0440\u044b \u0438 \u043e\u0444\u0438\u0446\u0435\u0440\u044b.\n\n\U0001F494
    \u0412\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0412 1773 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u043f\u043e\u0447\u0442\u0438 40 \u043b\u0435\u0442 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c.
    \u042d\u0439\u043b\u0435\u0440 \u0442\u044f\u0436\u0435\u043b\u043e \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043b
    \u043f\u043e\u0442\u0435\u0440\u044e. \u0421\u043f\u0443\u0441\u0442\u044f \u0442\u0440\u0438
    \u0433\u043e\u0434\u0430, \u0432 1776 \u0433\u043e\u0434\u0443, \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0435\u0451 \u0441\u0432\u043e\u0434\u043d\u043e\u0439 \u0441\u0435\u0441\u0442\u0440\u0435
    \u2014 \u0421\u0430\u043b\u043e\u043c\u0435\u0435 \u0410\u0431\u0438\u0433\u0435\u0439\u043b
    \u0413\u0437\u0435\u043b\u044c. \u0412\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a,
    \u043f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c,
    \u0442\u043e\u0436\u0435 \u0431\u044b\u043b \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c,
    \u0438 \u0421\u0430\u043b\u043e\u043c\u0435\u044f \u0437\u0430\u0431\u043e\u0442\u0438\u043b\u0430\u0441\u044c
    \u043e\u0431 \u0443\u0436\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u043b\u0435\u043f\u0448\u0435\u043c
    \u0443\u0447\u0451\u043d\u043e\u043c \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0432 1783 \u0433\u043e\u0434\u0443. \u0422\u0430\u043a\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u042d\u0439\u043b\u0435\u0440\u0430, \u043e\u043c\u0440\u0430\u0447\u0451\u043d\u043d\u0430\u044f
    \u043f\u043e\u0442\u0435\u0440\u0435\u0439 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0435\u0442\u0435\u0439
    \u0438 \u0434\u0432\u0443\u0445 \u0442\u044f\u0436\u0451\u043b\u044b\u0445 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439
    \u043d\u0430 \u0433\u043b\u0430\u0437\u0430\u0445, \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0435\u0433\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u044c \u0438 \u0436\u0438\u0437\u043d\u0435\u043b\u044e\u0431\u0438\u0435.
    \u0421\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u043d\u0430\u0434\u0451\u0436\u043d\u043e\u0439 \u0433\u0430\u0432\u0430\u043d\u044c\u044e,
    \u0442\u043e\u0439 \u0441\u0430\u043c\u043e\u0439 \"\u0442\u0438\u0445\u043e\u0439 \u043f\u0440\u0438\u0441\u0442\u0430\u043d\u044c\u044e\",
    \u043e\u0442\u043a\u0443\u0434\u0430 \u043e\u043d \u0447\u0435\u0440\u043f\u0430\u043b \u0441\u0438\u043b\u044b
    \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0439."
  personalLifeEn: "Leonard Eyler's personal life is an amazing story about the happiness he found in his family, and a great tragedy that has not broken him, filled with love for years, the birth of 13 children and the amazing ability to work in a home full of little children.\n\n===Career======Career=====Career's main love was married to Katarina Gzel on 7 January 1734, shortly after he was promoted to the post of Professor of Higher Mathematics at the Petersburg Academy of Sciences, Catarina was the daughter of Swiss artist George Gzel, who worked at the St. Petersburg gymnasium, and a granddaughter of famous artist and naturalist Maria Sybilla Merian, who was also a Swiss-affiliated family.Their marriage, which lasted for almost 40 years, was happy and strong, during which time Katarina gave birth to 13 children, a truly huge family that became part of his amazing creative process, and modern - day historians and historians noted that it was often the greatest discovery that the country had made, holding one of the babies in its arms, while the other children played at his feet.This touching detail represents a scientist for whom the family was an integral part of life and not an obstacle to work. Unfortunately, of the 13 children, only five survived: three sons and two daughters; it was a common tragedy for the 18th century, when infant mortality was very high.\n\nChildren and the continuation of the dynasty, the children who survived followed in many ways in the footsteps of their father and left a significant mark in history: Johann Albrecht Eyler (1734 - 1800): the oldest son born in Petersburg, became a distinguished mathematician and later secretary of the Imperial Academy of Sciences in Petersburg, and he was not only a student but also the closest assistant to his father, especially in the last years of Leonard's life.Carl Leontjevic Eyler (1740–1790): Second son, who followed the medical path, Christopher Leontjevic Eyler (1743–1808): Junior son, who chose a military career and served as Lieutenant General, and who ran the Sestrevsky Arms Plant, and the descendants of Leonard Eiler continued his family in Russia and became known in the public and military service, including generals, governors and officers.\n\n* Second marriage and last years in 1773, after almost 40 years of living together, Katarina died.So, the personal life of the eyler, darkened by the loss of many children and two hard surgeries in front of his eyes, demonstrates his remarkable persistence and his life-love, and the family was his safe haven, the very \"silence of the marina\" from which he drew strength for his genius."
  shortBioRu: "\u041b\u0435\u043e\u043d\u0430\u0440\u0434 \u042d\u0439\u043b\u0435\u0440 \u2014 \u044d\u0442\u043e,
    \u0431\u0435\u0437 \u043f\u0440\u0435\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044f,
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043c\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430.
    \u041e\u043d \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0447\u0451\u043d\u044b\u043c,
    \u0447\u044c\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043e\u0445\u0432\u0430\u0442\u0438\u043b\u0438
    \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435
    \u0442\u043e\u0433\u0434\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u0438.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b\u0430\u0441\u044c
    \u0434\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u043d\u043e\u0439
    \u043f\u043e\u0442\u0435\u0440\u0438 \u0437\u0440\u0435\u043d\u0438\u044f.\n\n\U0001F4DC
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u044e\u043d\u043e\u0441\u0442\u044c:
    \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0433\u0435\u043d\u0438\u044f
    \u0432 \u0411\u0430\u0437\u0435\u043b\u0435 \u041b\u0435\u043e\u043d\u0430\u0440\u0434 \u042d\u0439\u043b\u0435\u0440
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 15 \u0430\u043f\u0440\u0435\u043b\u044f 1707
    \u0433\u043e\u0434\u0430 \u0432 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u0430\u0437\u0435\u043b\u0435, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u043f\u0430\u0441\u0442\u043e\u0440\u0430 \u041f\u0430\u0443\u043b\u044f \u042d\u0439\u043b\u0435\u0440\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0430\u043c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0438 \u043a\u043e\u0433\u0434\u0430-\u0442\u043e
    \u0443\u0447\u0438\u043b\u0441\u044f \u0443 \u042f\u043a\u043e\u0431\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438.
    \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u043e\u0442\u0435\u0446
    \u0433\u043e\u0442\u043e\u0432\u0438\u043b \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430
    \u043a \u0434\u0443\u0445\u043e\u0432\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u0435,
    \u043d\u043e \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u0432\u0438\u043b \u0435\u043c\u0443
    \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u042d\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0441\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u044b\u043c
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c. \u0412 1720 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 13 \u043b\u0435\u0442, \u042d\u0439\u043b\u0435\u0440
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0411\u0430\u0437\u0435\u043b\u044c\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0422\u0430\u043c \u043e\u043d
    \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u0440\u0438\u0432\u043b\u0451\u043a \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c
    \u0438 \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b \u0432 \u044e\u043d\u043e\u0448\u0435
    \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u044b\u0439 \u0442\u0430\u043b\u0430\u043d\u0442.
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0434\u0430\u0432\u0430\u043b \u0435\u043c\u0443
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0442\u0430\u0442\u044c\u0438 \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f, \u0430 \u043f\u043e \u0441\u0443\u0431\u0431\u043e\u0442\u0430\u043c
    \u043b\u0438\u0447\u043d\u043e \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043b \u0441 \u043d\u0438\u043c
    \u0442\u0440\u0443\u0434\u043d\u044b\u0435 \u043c\u0435\u0441\u0442\u0430. \u042d\u0442\u043e\u0442
    \u043e\u043f\u044b\u0442 \u042d\u0439\u043b\u0435\u0440 \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u043b\u0443\u0447\u0448\u0438\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c \u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f
    \u0443\u0441\u043f\u0435\u0445\u0430 \u0432 \u043d\u0430\u0443\u043a\u0435. \u0412 1724
    \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 17 \u043b\u0435\u0442,
    \u042d\u0439\u043b\u0435\u0440 \u043f\u0440\u043e\u0438\u0437\u043d\u0451\u0441 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0443\u044e
    \u0440\u0435\u0447\u044c \u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432. \u041f\u043e\u0437\u0436\u0435 \u043e\u043d
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432 \u0411\u0430\u0437\u0435\u043b\u0435, \u043d\u043e \u0435\u0433\u043e \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0443\u0440\u0443
    \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b\u0438 \u0438\u0437-\u0437\u0430 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u044e\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430.\n\n\U0001F1F7\U0001F1FA
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    (1727\u20131741): \u043f\u0435\u0440\u0432\u044b\u0435 \u0442\u0440\u0438\u0443\u043c\u0444\u044b
    \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0441\u0443\u0434\u044c\u0431\u0435 \u042d\u0439\u043b\u0435\u0440\u0430 \u0441\u0442\u0430\u043b\u043e
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u043d\u0435\u0434\u0430\u0432\u043d\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a \u0432 1726 \u0433\u043e\u0434\u0443.
    \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044e \u0435\u043c\u0443
    \u0434\u0430\u043b\u0438 \u0431\u0440\u0430\u0442\u044c\u044f \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438
    \u0442\u0430\u043c. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e
    \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u0435\u043c\u0443 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b\u0438
    \u043c\u0435\u0441\u0442\u043e \u043f\u043e \u043a\u0430\u0444\u0435\u0434\u0440\u0435 \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0438,
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u043d \u0432\u0441\u0435\u0440\u044c\u0451\u0437
    \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435\u043c
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b. \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e
    \u043f\u0440\u0438\u0431\u044b\u0442\u0438\u0438 \u0432 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433
    24 \u043c\u0430\u044f 1727 \u0433\u043e\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u0430\u0434\u044a\u044e\u043d\u043a\u0442\u043e\u043c \u043f\u043e \u0432\u044b\u0441\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0412 \u0420\u043e\u0441\u0441\u0438\u0438
    \u0442\u0430\u043b\u0430\u043d\u0442 \u042d\u0439\u043b\u0435\u0440\u0430 \u0440\u0430\u0441\u043a\u0440\u044b\u043b\u0441\u044f
    \u0432 \u043f\u043e\u043b\u043d\u043e\u0439 \u043c\u0435\u0440\u0435. \u041e\u043d \u0431\u044b\u0441\u0442\u0440\u043e
    \u043e\u0441\u0432\u043e\u0438\u043b \u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a
    \u0438 \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u043b\u0441\u044f \u0432 \u0440\u0430\u0431\u043e\u0442\u0443.
    \u0415\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u0448\u043b\u0430 \u0432 \u0433\u043e\u0440\u0443: \u0412 1731 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0444\u0438\u0437\u0438\u043a\u0438, \u0430 \u0432 1733 \u0433\u043e\u0434\u0443 \u2014
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432\u044b\u0441\u0448\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0441\u043c\u0435\u043d\u0438\u0432 \u0443\u0435\u0445\u0430\u0432\u0448\u0435\u0433\u043e
    \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0443 \u0414\u0430\u043d\u0438\u0438\u043b\u0430
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438. \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c.
    \u042d\u0439\u043b\u0435\u0440 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0420\u043e\u0441\u0441\u0438\u0438, \u043f\u0438\u0441\u0430\u043b \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438,
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439.
    \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445
    \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u0441\u0442\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043f\u043e \u0440\u0430\u0441\u0447\u0451\u0442\u0443 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438
    \u043a\u043e\u043c\u0435\u0442\u044b \u0432 1735 \u0433\u043e\u0434\u0443. \u0413\u0440\u0443\u043f\u043f\u0430
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0441\u0438\u043b\u0430
    \u043d\u0430 \u044d\u0442\u043e \u0442\u0440\u0438 \u043c\u0435\u0441\u044f\u0446\u0430,
    \u0430 \u042d\u0439\u043b\u0435\u0440 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043b \u0432\u0441\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0432\u0441\u0435\u0433\u043e
    \u0437\u0430 \u0442\u0440\u0438 \u0434\u043d\u044f! \u041e\u0434\u043d\u0430\u043a\u043e
    \u0442\u0430\u043a\u043e\u0435 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435
    \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0431\u043e\u043b\u0435\u0437\u043d\u0438, \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u043f\u0440\u0430\u0432\u044b\u0439 \u0433\u043b\u0430\u0437. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u044d\u0442\u043e, \u0432 1736 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u043e
    \u0435\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0434\u0432\u0443\u0445\u0442\u043e\u043c\u043d\u043e\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435
    \u00ab\u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430, \u0438\u043b\u0438 \u041d\u0430\u0443\u043a\u0430
    \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438, \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u00bb, \u0433\u0434\u0435
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u0442\u0435\u043b, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u043d\u043e\u0432\u043e\u0439 \u044d\u0440\u044b \u0432 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435.\n\n\U0001F1E9\U0001F1EA
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    (1741\u20131766): \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0412 1741 \u0433\u043e\u0434\u0443, \u043d\u0430 \u0444\u043e\u043d\u0435 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0439
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438
    \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0410\u043d\u043d\u044b \u0418\u043e\u0430\u043d\u043d\u043e\u0432\u043d\u044b, \u042d\u0439\u043b\u0435\u0440
    \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u043f\u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u044f
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 II \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d. \u0422\u0430\u043c \u043e\u043d \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043b\u0430\u0441\u0441
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a. \u0417\u0430 25 \u043b\u0435\u0442 \u0436\u0438\u0437\u043d\u0438
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u042d\u0439\u043b\u0435\u0440 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043e\u043a\u043e\u043b\u043e 300 \u0440\u0430\u0431\u043e\u0442. \u042d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c
    \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439: 1748 \u0433\u043e\u0434 \u2014 \u0432\u044b\u0445\u043e\u0434
    \u0432 \u0441\u0432\u0435\u0442 \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0432
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u043c\u0430\u043b\u044b\u0445\u00bb, \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f \u0432\u043f\u0435\u0440\u0451\u0434 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0432\u0441\u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. 1755 \u0433\u043e\u0434 \u2014 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e
    \u00ab\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u00bb. \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e
    \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f,
    \u0440\u0435\u0448\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0437\u0430\u0434\u0430\u0447
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435
    \u0438 \u043e\u043f\u0442\u0438\u043a\u0435. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u00ab\u041f\u0438\u0441\u044c\u043c\u0430 \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439
    \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435 \u043e \u0440\u0430\u0437\u043d\u044b\u0445
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u0440\u0438\u044f\u0445\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0442\u0430\u043b\u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u043c \u043d\u0430\u0443\u0447\u043d\u043e-\u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u0438 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b\u0438
    \u043e\u043a\u043e\u043b\u043e 40 \u0438\u0437\u0434\u0430\u043d\u0438\u0439 \u043d\u0430
    \u0434\u0435\u0441\u044f\u0442\u0438 \u044f\u0437\u044b\u043a\u0430\u0445. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u043e\u043c II, \u043e\u0434\u043d\u0430\u043a\u043e,
    \u0431\u044b\u043b\u0438 \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438: \u043a\u043e\u0440\u043e\u043b\u044c
    \u043d\u0435 \u043e\u0446\u0435\u043d\u0438\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u042d\u0439\u043b\u0435\u0440\u0430, \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u044f
    \u0435\u043c\u0443 \u0431\u043e\u043b\u0435\u0435 \u0441\u0432\u0435\u0442\u0441\u043a\u0438\u0445
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432. \u0418\u043c\u0435\u043d\u043d\u043e
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432 1766 \u0433\u043e\u0434\u0443, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u043d\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u043e\u0442 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u0440\u0438\u0446\u044b \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b
    II, \u042d\u0439\u043b\u0435\u0440 \u0431\u0435\u0437 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0420\u043e\u0441\u0441\u0438\u044e.\n\n\U0001F1F7\U0001F1FA
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433
    \u0438 \u0442\u0440\u0438\u0443\u043c\u0444 \u043d\u0430\u0434 \u0441\u043b\u0435\u043f\u043e\u0442\u043e\u0439
    (1766\u20131783) \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433,
    \u042d\u0439\u043b\u0435\u0440 \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0447\u0442\u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u043b\u0435\u043f \u043d\u0430
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0433\u043b\u0430\u0437. \u041d\u043e \u044d\u0442\u043e
    \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u043e \u0435\u0433\u043e,
    \u0430, \u043d\u0430\u043f\u0440\u043e\u0442\u0438\u0432, \u043a\u0430\u0436\u0435\u0442\u0441\u044f,
    \u0434\u0430\u0436\u0435 \u043f\u043e\u0434\u0441\u0442\u0435\u0433\u043d\u0443\u043b\u043e
    \u0435\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c.
    \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f \u0441\u0432\u043e\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043e\u043d \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u0430\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u0438 \u043e\u0444\u043e\u0440\u043c\u043b\u044f\u043b\u0438
    \u0438\u0445. \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434,
    \u0443\u0436\u0435 \u043d\u0435 \u0432\u0438\u0434\u044f \u043d\u0438 \u0441\u0442\u0440\u043e\u0447\u043a\u0438,
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043e\u0448\u043b\u0438
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043d\u0430\u0443\u043a\u0438: | \u0413\u043e\u0434
    | \u0422\u0440\u0443\u0434 | \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 | |:--- |:---
    |:--- | | 1768\u20131770 | \u00ab\u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u00bb | \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0440\u0438\u043b\u043e\u0433\u0438\u044e
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0430\u043d\u0430\u043b\u0438\u0437\u0443 (\u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e
    \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c\u00bb \u0438 \u00ab\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u043c\u00bb). | | 1768\u20131769
    | \u00ab\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb
    | \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b
    \u043e\u043a\u043e\u043b\u043e 30 \u0438\u0437\u0434\u0430\u043d\u0438\u0439 \u043d\u0430
    6 \u044f\u0437\u044b\u043a\u0430\u0445. | | 1768\u20131774 | \u00ab\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435...\u00bb
    | \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0435 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0444\u0438\u0437\u0438\u043a\u0438, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438, \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0451\u043d\u043d\u043e\u0435
    \u043d\u0430 \u043c\u043d\u043e\u0433\u0438\u0435 \u044f\u0437\u044b\u043a\u0438. | \u0417\u0430
    \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c \u042d\u0439\u043b\u0435\u0440 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0431\u043e\u043b\u0435\u0435 850 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442,
    \u0430 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435,
    \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u043c\u043e\u0435 \u0432 \u043f\u043e\u043b\u043d\u043e\u0435
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439
    (Opera Omnia), \u043d\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u0434\u0435\u0441\u044f\u0442\u043a\u0438
    \u0442\u043e\u043c\u043e\u0432 \u0438 \u0438\u0437\u0434\u0430\u0451\u0442\u0441\u044f \u0434\u043e
    \u0441\u0438\u0445 \u043f\u043e\u0440.\n\n\U0001F4DD \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0412\u043a\u043b\u0430\u0434 \u042d\u0439\u043b\u0435\u0440\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u043d\u0435\u043e\u0431\u044a\u044f\u0442\u0435\u043d.
    \u041e\u043d: \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437, \u043f\u0440\u0438\u0434\u0430\u0432 \u0435\u043c\u0443
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0434 \u0438
    \u0441\u043e\u0437\u0434\u0430\u0432 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0417\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e
    \u0442\u0435\u043b\u0430 \u0438 \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438,
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. \u0412\u043d\u0451\u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u043e\u043f\u0442\u0438\u043a\u0443,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e (\u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b
    \u043c\u0430\u0441\u0441\u0443 \u041b\u0443\u043d\u044b) \u0438 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0412\u0432\u0451\u043b
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \u0438 \u0442\u0435\u0440\u043c\u0438\u043d\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440: \u0441\u0438\u043c\u0432\u043e\u043b\u044b
    \u0447\u0438\u0441\u043b\u0430 \u03c0 (\u043f\u0438), \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432
    e, \u043c\u043d\u0438\u043c\u043e\u0439 \u0435\u0434\u0438\u043d\u0438\u0446\u044b i \u0438
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435. \u042d\u0439\u043b\u0435\u0440
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 18 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1783 \u0433\u043e\u0434\u0430 \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435
    \u043e\u0442 \u0430\u043f\u043e\u043f\u043b\u0435\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u0434\u0430\u0440\u0430. \u041e\u043d \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043d\u0430 \u0421\u043c\u043e\u043b\u0435\u043d\u0441\u043a\u043e\u043c \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u043c
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435, \u0430 \u0432 1956 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u043f\u0440\u0430\u0445 \u0431\u044b\u043b \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0451\u043d
    \u0432 \u041d\u0435\u043a\u0440\u043e\u043f\u043e\u043b\u044c XVIII \u0432\u0435\u043a\u0430
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e-\u041d\u0435\u0432\u0441\u043a\u043e\u0439
    \u043b\u0430\u0432\u0440\u044b. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014
    \u044d\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u0440 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0441\u0430\u043c\u043e\u043e\u0442\u0434\u0430\u0447\u0438, \u043b\u044e\u0431\u0432\u0438
    \u043a \u0437\u043d\u0430\u043d\u0438\u044f\u043c \u0438 \u0441\u0438\u043b\u044b \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0434\u0443\u0445\u0430, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0433\u043e \u0442\u0432\u043e\u0440\u0438\u0442\u044c
    \u0432\u0435\u043b\u0438\u043a\u043e\u0435 \u0434\u0430\u0436\u0435 \u043f\u0435\u0440\u0435\u0434
    \u043b\u0438\u0446\u043e\u043c \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0435\u043c\u043e\u0449\u0438. \u0416\u0430\u043d-\u0411\u0430\u0442\u0438\u0441\u0442
    \u0416\u043e\u0437\u0435\u0444 \u0424\u0443\u0440\u044c\u0435, \u0432\u0435\u043b\u0438\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0441\u043a\u0430\u0437\u0430\u043b
    \u043e \u043d\u0451\u043c: \u00ab\u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u042d\u0439\u043b\u0435\u0440\u0430,
    \u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u042d\u0439\u043b\u0435\u0440\u0430, \u043e\u043d
    \u2014 \u043d\u0430\u0448 \u043e\u0431\u0449\u0438\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u00bb.
    \u0418 \u044d\u0442\u0438 \u0441\u043b\u043e\u0432\u0430 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f
    \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f."
  shortBioEn: "Leonard Eyler is, without exaggeration, one of the greatest minds in human history, and he was not just a mathematician, but a universal scientist whose discoveries have reached almost all the known fields of science at that time; his life is a story of phenomenal productivity and dedication to science that has continued even after the complete loss of vision.\n\n==Early life==The birth of a genius in Basel, Leonard Eyler, was born on April 15, 1707 in Basel, the family of pastor Paul Eyler, who was himself interested in mathematics and once studied at Jacob Bernulli's, originally preparing Leonard for a spiritual career, but also inculcating his love for mathematics.There he quickly drew the attention of the famous Professor Johann Bernulli, who became his mentor and saw the youth as an extraordinary talent. Bernulli gave him complex mathematical articles for his own study, and on Saturdays he personally took up difficult places with him, and that experience was the best way to succeed in science.In 1724, at the age of 17, he gave a brilliant speech about the philosophy of Descartes and Newton and received a master's degree in art, and later he tried to obtain a professorship in Basel, but was rejected because of his too young age.\n\nThe first triumphs of the Break-up in the fate of Eyler were invited to the newly founded Petersburg Academy of Sciences in 1726, recommended by the Bernulli brothers who had already worked there, and it was interesting that he had been offered a place in physiology at the beginning, so he took a serious medical study.However, upon arrival in St. Petersburg on 24 May 1727, he was appointed as an associate in higher mathematics, and in Russia, the talent of the European Union was fully revealed. He quickly learned Russian and went to work. His career quickly went uphill: in 1731 he became a professor of physics, and in 1733 he became an academic and professor of higher mathematics, replacing Daniel Bernulli, who had left his home country.He was involved in mapping Russia, writing textbooks, astronomy, and one of the most striking episodes was the work on the path of the comet in 1735, and a group of academics asked for three months to do it, and then he did all the calculations in just three days, but such enormous stress led to a disease that caused him to lose his right eye.Nevertheless, in 1736, his fundamental two-volume essay \"Mechanics, or Science on Movement, as presented analytically\" was published, where he first applied a mathematical analysis to describe the movement of the bodies, which was the beginning of a new era in mechanics.\n\n==History==The Berlin period (1741–1766): The flower and recognition in 1741, against the backdrop of the unstable political situation in Russia after the death of Anna Johnovna, was accepted by the Prussian King Friedrich II and moved to Berlin, where he led a mathematical class at the Berlin Academy of Sciences.This period was the time of its greatest mathematical discoveries: 1748, the release of \"Introducing the Analysis of infinitely small,\" a monumental work that for centuries has determined the evolution of all mathematical analysis. 1755, published \"Differential Calculus.\" In parallel, it laid the foundations for a variable calculation, solved many problems in the theory of numbers, hydrodynamics and optics.He also wrote the famous \"Write to the German Princess on various physical and philosophical matter\", which became an incredibly popular scientific and popular work and survived about 40 publications in 10 languages. However, relations with Friedrich II were not easy: the King did not appreciate the practicality and universality of Euler, preferring him to more secular philosophers.That is why, in 1766, after receiving a new invitation from the Empress Catherine II, Eyler returned to Russia without hesitation.\n\nWhen he returned to Petersburg, he was almost completely blind, but it did not stop him, but it seemed to have given rise to his phenomenal performance.It was during this period that he created his main works, which were part of the history of science: . . . . . . . . . . . . . . . . . . ~ 1768 - 1770 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .1768–1774 \"Write to the German Princess...\" ♪ Popular presentation of physics, astronomy and philosophy, translated into many languages. ♪ In his lifetime, Eyler wrote over 850 scientific works, and his scientific heritage, collected in a complete collection of essays (Opera Omnia), has dozens of volumes and is still being published.\n\nThe scientific heritage and the significance of the contribution of Euler to science is truly unimportant. He has transformed the mathematical analysis by giving it modern form and creating many sections, including the variable calculation and the theory of differential equations. He has laid the foundations for solid and hydrodynamic mechanics, forming famous equations.He has made a fundamental contribution to the theory of numbers, geometry, optics, astronomy (in particular the first time he calculated the mass of the moon) and many other fields. He has introduced many symbols and terms into mathematics that we still use: the symbols of pi (pi), the basis of natural logarithms e, the perceived unit i, and many others.He was buried in the Smolen Lutheran Cemetery, and in 1956 his ashes were transferred to the 18th century Necropol of Alexandro-Nevska Laurra. His life is an example of an incredible self-sacrifice, a love of knowledge, and the power of the human spirit that can do great even in the face of physical weakness. Jean-Baptiste Joseph Furier, the great mathematician, said of him, \"Read to Eiler, read to him, he is our teacher.\" And these words remain valid today."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430 \u042d\u0439\u043b\u0435\u0440\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0434\u0430
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b,
    \u043d\u043e \u0438 \u043a\u0430\u043b\u0435\u0439\u0434\u043e\u0441\u043a\u043e\u043f \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445,
    \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0438 \u0434\u0430\u0436\u0435 \u043d\u0435\u043c\u043d\u043e\u0433\u043e
    \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439.
    \u0415\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c, \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u0434\u0435\u043b\u0430\u043b\u0438
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0440\u0430\u0437\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0435 \u043f\u043e \u0442\u0435\u043c\u0430\u043c:\n\n\U0001F9E0
    \u0424\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438:
    \u043f\u0430\u043c\u044f\u0442\u044c, \u0441\u0447\u0435\u0442 \u0438 \u0441\u043b\u0443\u0445
    \u042d\u0439\u043b\u0435\u0440 \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u0440\u0430\u0436\u0430\u043b\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432:
    \u0425\u043e\u0434\u044f\u0447\u0430\u044f \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f.
    \u041e\u043d \u043f\u043e\u043c\u043d\u0438\u043b \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c
    \"\u042d\u043d\u0435\u0438\u0434\u0443\" \u0412\u0435\u0440\u0433\u0438\u043b\u0438\u044f
    \u2014 \u043e\u0433\u0440\u043e\u043c\u043d\u0443\u044e \u043f\u043e\u044d\u043c\u0443.
    \u0422\u0430\u043a\u0436\u0435 \u0432 \u0435\u0433\u043e \u043f\u0430\u043c\u044f\u0442\u0438
    \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c \u0432\u0441\u0435 \u0442\u0435\u043a\u0441\u0442\u044b
    \"\u0418\u043b\u0438\u0430\u0434\u044b\" \u0438 \"\u041e\u0434\u0438\u0441\u0441\u0435\u0438\"
    \u0413\u043e\u043c\u0435\u0440\u0430. \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e,
    \u043e\u043d \u043c\u043e\u0433 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438
    \u043b\u044e\u0431\u043e\u0439 \u0430\u0431\u0437\u0430\u0446 \u0438\u0437 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043d\u043e\u0439
    \u043a\u043d\u0438\u0433\u0438, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u044d\u0442\u0430
    \u043a\u043d\u0438\u0433\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0440\u043e\u043b\u0438\u0441\u0442\u0430\u043d\u0430. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a-\u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b, \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0441\u043f\u043e\u0440\u0430 \u0441 \u0414\u0435\u043d\u0438 \u0414\u0438\u0434\u0440\u043e,
    \u042d\u0439\u043b\u0435\u0440 \u043f\u043e\u0440\u0430\u0437\u0438\u043b \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445,
    \u044f\u043a\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0432 \u0431\u044b\u0442\u0438\u0435
    \u0411\u043e\u0433\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u043e\u0439: \u00ab(a + b\u207f)/n
    = x\u00bb. \u041d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u044d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u0448\u0443\u0442\u043a\u0430, \u043d\u043e \u043e\u043d\u0430
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0432\u0435\u043b\u0438\u043a\u0430 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044f.
    \u0412 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043e\u043d \u043f\u043e\u0440\u0430\u0436\u0430\u043b
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u0432 \u0443\u043c\u0435.
    \u0421\u043b\u043e\u043d \u0438 \u043c\u0443\u0445\u0430. \u041f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u043a \u042d\u0439\u043b\u0435\u0440\u0443 \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0438\u0441\u044c
    \u0441 \u0437\u0430\u0434\u0430\u0447\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0432 \u0442\u0443\u043f\u0438\u043a
    \u043c\u043d\u043e\u0433\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432:
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u0441\u043b\u043e\u043d
    \u0442\u044f\u0436\u0435\u043b\u0435\u0435 \u043c\u0443\u0445\u0438. \u042d\u0439\u043b\u0435\u0440
    \u0440\u0435\u0448\u0438\u043b \u0435\u0451, \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0432
    \u0441\u043b\u043e\u0436\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432
    \u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0434\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u0432 \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u043c\u0430\u0441\u0441\u0430 \u0441\u043b\u043e\u043d\u0430
    \u0431\u043e\u043b\u044c\u0448\u0435 \u043c\u0430\u0441\u0441\u044b \u043c\u0443\u0445\u0438.
    \u042d\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u2014 \u044f\u0440\u043a\u0438\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440 \u0435\u0433\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0432\u0441\u0451, \u0447\u0442\u043e \u0443\u0433\u043e\u0434\u043d\u043e.\n\n\U0001F56F\ufe0f
    \u0422\u0440\u0438\u0443\u043c\u0444 \u043d\u0430\u0434 \u0441\u043b\u0435\u043f\u043e\u0442\u043e\u0439:
    \"\u0413\u043b\u0430\u0437\u0430 \u0443\u043c\u0430\" \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u044b\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0438 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u044e\u0449\u0438\u0439 \u0444\u0430\u043a\u0442
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438: \u041f\u043e\u0442\u0435\u0440\u044f
    \u0437\u0440\u0435\u043d\u0438\u044f. \u0412 1735 \u0433\u043e\u0434\u0443, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u043d\u0430\u0434 \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u043f\u043e \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    (\u0440\u0430\u0441\u0447\u0451\u0442 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438
    \u043a\u043e\u043c\u0435\u0442\u044b), \u042d\u0439\u043b\u0435\u0440 \u043f\u0440\u043e\u0432\u0451\u043b
    \u0442\u0440\u0438 \u0434\u043d\u044f \u0431\u0435\u0437 \u0441\u043d\u0430. \u041a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043f\u0440\u043e\u0441\u0438\u043b\u0438 \u043d\u0430 \u044d\u0442\u043e \u0442\u0440\u0438
    \u043c\u0435\u0441\u044f\u0446\u0430, \u0430 \u043e\u043d \u0432\u0441\u0451 \u0441\u0434\u0435\u043b\u0430\u043b
    \u0437\u0430 \u0442\u0440\u0438 \u0434\u043d\u044f. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0441\u0432\u0435\u0440\u0445\u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e
    \u043e\u043d \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u043f\u0440\u0430\u0432\u044b\u0439
    \u0433\u043b\u0430\u0437. \u0412\u0442\u043e\u0440\u0430\u044f \u0441\u043b\u0435\u043f\u043e\u0442\u0430.
    \u041f\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0432 \u0420\u043e\u0441\u0441\u0438\u044e
    \u0432 1766 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u0441\u043b\u0435\u043f \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u0439 \u0433\u043b\u0430\u0437.
    \u041a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e \u043e\u043a\u043e\u043d\u0447\u0435\u043d\u0430.
    \u041d\u043e \u042d\u0439\u043b\u0435\u0440 \u043d\u0435 \u0441\u0434\u0430\u043b\u0441\u044f.
    \u0414\u043d\u0435\u0432\u043d\u0438\u043a \u0432 \u0442\u0435\u043c\u043d\u043e\u0442\u0435.
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0437\u0430\u043f\u0438\u0441\u0438: \u043f\u0438\u0441\u0430\u043b
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b
    \u043c\u0435\u043b\u043e\u043c \u043d\u0430 \u0433\u0440\u0438\u0444\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u043e\u0441\u043a\u0435 \u0438\u043b\u0438 \u043a\u0440\u0443\u043f\u043d\u043e \u0432\u044b\u0432\u043e\u0434\u0438\u043b
    \u0438\u0445 \u043d\u0430 \u0431\u0443\u043c\u0430\u0433\u0435. \u0427\u0442\u043e\u0431\u044b
    \u043d\u0435 \u0437\u0430\u0431\u044b\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0441\u0432\u043e\u0438\u0445 \u043c\u044b\u0441\u043b\u0435\u0439, \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u0430\u0440\u0430\u043d\u0434\u0430\u0448,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0441\u043b\u0435\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u043c\u043e\u0433
    \u043e\u0449\u0443\u043f\u0430\u0442\u044c \u043f\u0430\u043b\u044c\u0446\u0430\u043c\u0438.
    \"\u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u042d\u0439\u043b\u0435\u0440\u0430\". \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    17 \u043b\u0435\u0442 \u043f\u043e\u043b\u043d\u043e\u0439 \u0441\u043b\u0435\u043f\u043e\u0442\u044b
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u044b
    \u0441\u0432\u043e\u0438\u0445 \u0442\u0440\u0443\u0434\u043e\u0432 (\u043e\u043a\u043e\u043b\u043e
    380 \u0441\u0442\u0430\u0442\u0435\u0439 \u0438 \u043a\u043d\u0438\u0433)! \u041e\u043d
    \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0437\u044f\u0442\u044e, \u0441\u044b\u043d\u043e\u0432\u044c\u044f\u043c \u0438\u043b\u0438
    \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0438\u043c.
    \u0415\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u044f\u0441\u043d\u044b\u043c\u0438
    \u0438 \u043b\u043e\u0433\u0438\u0447\u043d\u044b\u043c\u0438, \u0447\u0442\u043e \u043d\u0435
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438
    \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u043e\u0432.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0434\u0435\u0442\u0438:
    \"\u0413\u0435\u043d\u0438\u0439 \u043d\u0430 \u043a\u043e\u043b\u0435\u043d\u044f\u0445\"
    \u042d\u0439\u043b\u0435\u0440 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0443\u0447\u0451\u043d\u044b\u043c, \u043d\u043e \u0438 \u043b\u044e\u0431\u044f\u0449\u0438\u043c
    \u0441\u0435\u043c\u044c\u044f\u043d\u0438\u043d\u043e\u043c, \u0447\u0442\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442
    \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u043e\u0441\u0442\u0438:
    \u0414\u0435\u0442\u0438 \u2014 \u044d\u0442\u043e \u043c\u0443\u0437\u044b\u043a\u0430.
    \u042d\u0439\u043b\u0435\u0440 \u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u0438\u043b
    \u043c\u0443\u0437\u044b\u043a\u0443. \u041e\u043d \u0438\u0433\u0440\u0430\u043b \u043d\u0430
    \u043a\u043b\u0430\u0432\u0435\u0441\u0438\u043d\u0435, \u0438 \u0447\u0430\u0441\u0442\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0443\u0441\u043f\u043e\u043a\u043e\u0438\u0442\u044c \u043f\u043b\u0430\u0447\u0443\u0449\u0435\u0433\u043e
    \u0440\u0435\u0431\u0435\u043d\u043a\u0430, \u043e\u043d \u0441\u0430\u0436\u0430\u043b
    \u0435\u0433\u043e \u043a \u0441\u0435\u0431\u0435 \u043d\u0430 \u043a\u043e\u043b\u0435\u043d\u0438
    \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u043b \u0438\u0433\u0440\u0430\u0442\u044c,
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u044f\u0442\u044c
    \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0413\u043e\u0432\u043e\u0440\u044f\u0442,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0431\u044b\u043b\u0438 \u0441\u0434\u0435\u043b\u0430\u043d\u044b
    \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \u043d\u0430 \u0435\u0433\u043e \u043a\u043e\u043b\u0435\u043d\u044f\u0445 \u0441\u0438\u0434\u0435\u043b
    \u043e\u0434\u0438\u043d \u0438\u0437 13 \u0434\u0435\u0442\u0435\u0439, \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u0433\u0440\u0430\u043b\u0438 \u043d\u0430 \u043f\u043e\u043b\u0443 \u0440\u044f\u0434\u043e\u043c.
    13 \u0434\u0435\u0442\u0435\u0439. \u0423 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u043e
    13 \u0434\u0435\u0442\u0435\u0439 \u043e\u0442 \u043f\u0435\u0440\u0432\u043e\u0439 \u0436\u0435\u043d\u044b
    (\u041a\u0430\u0442\u0430\u0440\u0438\u043d\u044b \u0413\u0437\u0435\u043b\u044c). \u0418\u0437
    \u043d\u0438\u0445 \u0432\u044b\u0436\u0438\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u044f\u0442\u0435\u0440\u043e. \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0441\u0443\u0440\u043e\u0432\u0430\u044f
    \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c XVIII \u0432\u0435\u043a\u0430,
    \u0438 \u043f\u043e\u0442\u0435\u0440\u044f \u0434\u0435\u0442\u0435\u0439 \u0431\u044b\u043b\u0430
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043b
    \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e. \u0422\u0451\u0449\u0430
    \u0438 \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u0446\u0430. \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043f\u0435\u0440\u0432\u043e\u0439 \u0436\u0435\u043d\u044b
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0435\u0451 \u0441\u0432\u043e\u0434\u043d\u043e\u0439
    \u0441\u0435\u0441\u0442\u0440\u0435. \u0415\u0433\u043e \u0442\u0435\u0449\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u0446\u0430 \u041c\u0430\u0440\u0438\u044f \u0421\u0438\u0431\u0438\u043b\u043b\u0430
    \u041c\u0435\u0440\u0438\u0430\u043d, \u0431\u044b\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u0441\u0432\u043e\u0438\u043c\u0438 \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0430\u0446\u0438\u044f\u043c\u0438
    \u043d\u0430\u0441\u0435\u043a\u043e\u043c\u044b\u0445, \u043d\u043e \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043e\u043d\u0430 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b \u0441\u0432\u044f\u0437\u0443\u044e\u0449\u0438\u043c
    \u0437\u0432\u0435\u043d\u043e\u043c \u0434\u043b\u044f \u0441\u0435\u043c\u044c\u0438 \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.\n\n\U0001F5FA\ufe0f \u041a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444
    \u0438 \u0448\u043f\u0438\u043e\u043d \u042d\u0439\u043b\u0435\u0440 \u0431\u044b\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u043e\u0447\u0435\u043d\u044c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c: \u041f\u0435\u0440\u0432\u0430\u044f
    \u043a\u0430\u0440\u0442\u0430 \u0420\u043e\u0441\u0441\u0438\u0438. \u0412 1745 \u0433\u043e\u0434\u0443
    \u043f\u043e\u0434 \u0435\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0431\u044b\u043b \u0438\u0437\u0434\u0430\u043d \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u043e\u043b\u043d\u044b\u0439
    \"\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0442\u043b\u0430\u0441
    \u0420\u043e\u0441\u0441\u0438\u0438\". \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0430
    \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0434\u0430\u043d\u043d\u044b\u0445
    \u0441 \u0441\u043e\u0442\u0435\u043d \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0439.
    \u0421\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u041f\u043e \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u0438\u044e \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u0440\u0438\u0446\u044b \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b
    II \u042d\u0439\u043b\u0435\u0440 \u0440\u0435\u0448\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0438
    \u043f\u043e \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438, \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0438 \u0434\u0430\u0436\u0435 \u0431\u0430\u043b\u043b\u0438\u0441\u0442\u0438\u043a\u0435.
    \u041e\u043d \u0431\u044b\u043b, \u043f\u043e \u0441\u0443\u0442\u0438, \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c \u043f\u043e \u043d\u0430\u0443\u043a\u0435.\n\n\U0001F934
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043c\u043e\u043d\u0430\u0440\u0445\u0430\u043c\u0438
    \u042d\u0439\u043b\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043f\u0440\u0438
    \u0434\u0432\u0443\u0445 \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043c\u043e\u043d\u0430\u0440\u0445\u0430\u0445
    \u2014 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0435 II (\u041f\u0440\u0443\u0441\u0441\u0438\u044f)
    \u0438 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0435 II (\u0420\u043e\u0441\u0441\u0438\u044f),
    \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u043d\u0435\u043c\u0443
    \u0431\u044b\u043b\u043e \u0434\u0438\u0430\u043c\u0435\u0442\u0440\u0430\u043b\u044c\u043d\u043e
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u044b\u043c:
    \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u043e\u043c
    II. \u041f\u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u043a\u043e\u0440\u043e\u043b\u044c,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u043f\u0440\u043e\u0441\u0432\u0435\u0449\u0451\u043d\u043d\u044b\u043c,
    \u043d\u0435 \u043b\u044e\u0431\u0438\u043b \u042d\u0439\u043b\u0435\u0440\u0430. \u041e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b \u0435\u0433\u043e \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0441\u043a\u0443\u0447\u043d\u044b\u043c \u0438 \u043d\u0435 \"\u0441\u0432\u0435\u0442\u0441\u043a\u0438\u043c\".
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445 \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e
    \u042d\u0439\u043b\u0435\u0440 \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \"\u0443\u0447\u0451\u043d\u043e\u0433\u043e
    \u043c\u0443\u0436\u0438\u043a\u0430\" \u0438 \u043d\u0435 \u0443\u043c\u0435\u0435\u0442
    \u0432\u0435\u0441\u0442\u0438 \u0431\u0435\u0441\u0435\u0434\u0443. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043a\u043e\u0440\u043e\u043b\u044c \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u042d\u0439\u043b\u0435\u0440\u0430,
    \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d \u043d\u0435 \u0442\u0430\u043a\u043e\u0439
    \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u0439, \u043a\u0430\u043a \u0412\u043e\u043b\u044c\u0442\u0435\u0440.
    \u041d\u0430 \u044d\u0442\u043e \u042d\u0439\u043b\u0435\u0440 \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u0412\u0430\u0448\u0435 \u0412\u0435\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e,
    \u044f \u043d\u0435 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u0435\u043d, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u043c\u043e\u0438 \u043e\u0442\u0432\u0435\u0442\u044b \u0438\u043c\u0435\u044e\u0442
    \u0441\u043c\u044b\u0441\u043b, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442
    \u043e\u0441\u0442\u0440\u043e\u0442 \u0433\u043e\u0441\u043f\u043e\u0434\u0438\u043d\u0430
    \u0412\u043e\u043b\u044c\u0442\u0435\u0440\u0430\u00bb. \u041e\u0431\u043e\u0436\u0430\u043d\u0438\u0435
    \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b II. \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432 \u0420\u043e\u0441\u0441\u0438\u044e, \u042d\u0439\u043b\u0435\u0440 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043e\u0442 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b \u0446\u0430\u0440\u0441\u043a\u0438\u0439
    \u043f\u0440\u0438\u0435\u043c. \u041e\u043d\u0430 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u0435,
    \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u043d\u0438 \u0432 \u0447\u0451\u043c \u043d\u0435
    \u043d\u0443\u0436\u0434\u0430\u043b\u0441\u044f, \u0438 \u0441\u043a\u0430\u0437\u0430\u043b\u0430:
    \u00ab\u0415\u0441\u043b\u0438 \u042d\u0439\u043b\u0435\u0440 \u043e\u0441\u043b\u0435\u043f,
    \u043f\u0443\u0441\u0442\u044c \u0434\u0438\u043a\u0442\u0443\u0435\u0442 \u2014 \u044f
    \u0437\u0430\u043f\u043b\u0430\u0447\u0443 \u0437\u0430 \u0432\u0441\u0435\u0445 \u043f\u0438\u0441\u0446\u043e\u0432\u00bb.
    \u041e\u043d\u0430 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043f\u043e\u043b\u043d\u0443\u044e \u0441\u0432\u043e\u0431\u043e\u0434\u0443
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430.\n\n\u270d\ufe0f \"\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435\"
    \u2014 \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440 XVIII \u0432\u0435\u043a\u0430
    \u042d\u0439\u043b\u0435\u0440 \u0431\u044b\u043b \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \"\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435
    \u043e \u0440\u0430\u0437\u043d\u044b\u0445 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u044f\u0445\",
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0435 \u0432 1768\u20131772 \u0433\u043e\u0434\u0430\u0445,
    \u0441\u0442\u0430\u043b\u0438 \u043c\u0438\u0440\u043e\u0432\u044b\u043c \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440\u043e\u043c.
    \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430 \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u0430
    \u043d\u0430 10 \u044f\u0437\u044b\u043a\u043e\u0432, \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b\u0430
    \u043e\u043a\u043e\u043b\u043e 40 \u0438\u0437\u0434\u0430\u043d\u0438\u0439. \u041f\u043e
    \u0441\u0443\u0442\u0438, \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0430\u044f
    \u0436\u0438\u0432\u044b\u043c \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c
    \u044f\u0437\u044b\u043a\u043e\u043c. \u0414\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u042d\u0439\u043b\u0435\u0440\u0430 \u044d\u0442\u0443
    \u043a\u043d\u0438\u0433\u0443 \u0447\u0438\u0442\u0430\u043b\u0438 \u043c\u043d\u043e\u0433\u0438\u0435
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f.\n\n\u26b0\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c
    \u0438 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f \u042d\u0439\u043b\u0435\u0440 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    18 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1783 \u0433\u043e\u0434\u0430 \u0432
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435. \u041b\u0435\u0433\u0435\u043d\u0434\u0430
    \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u0440
    \u0442\u0430\u043a \u0436\u0435, \u043a\u0430\u043a \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b.
    \u0412 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438
    \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0433\u043e \u0448\u0430\u0440\u0430. \u041f\u043e\u043a\u0430
    \u0435\u0433\u043e \u0437\u044f\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443, \u042d\u0439\u043b\u0435\u0440 \u0432\u0437\u044f\u043b
    \u0442\u0430\u0431\u0430\u043a\u0435\u0440\u043a\u0443, \u043f\u043e\u043d\u044e\u0445\u0430\u043b
    \u0442\u0430\u0431\u0430\u043a\u0443 \u0438... \u0432\u0434\u0440\u0443\u0433 \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441:
    \u00ab\u042f \u0443\u043c\u0438\u0440\u0430\u044e\u00bb. \u0412 \u0442\u043e\u0442 \u0436\u0435
    \u043c\u0438\u0433 \u0435\u0433\u043e \u0441\u0435\u0440\u0434\u0446\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u043e\u0441\u044c.
    \u041d\u0430 \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0438 (\u0432
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e-\u041d\u0435\u0432\u0441\u043a\u043e\u0439
    \u043b\u0430\u0432\u0440\u0435) \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0433\u043b\u0430\u0441\u0438\u0442: \u00ab\u0417\u0434\u0435\u0441\u044c
    \u043f\u043e\u043a\u043e\u0438\u0442\u0441\u044f \u043f\u0440\u0430\u0445 \u043c\u0443\u0434\u0440\u043e\u0433\u043e,
    \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u043e\u0433\u043e \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430 \u042d\u0439\u043b\u0435\u0440\u0430\u00bb."
  interestingFactsEn: "Leonard Eyler's life is not only a series of genius formulas, but also a caleidoscope of amazing, funny and even a little bit of mystical stories. His phenomenal memory, incredible efficiency, and unique life circumstances have made his identity legendary. These are the most interesting and interesting facts from his biography, divided by themes:\n\n♪ Phenomenal abilities: the memory, account, and hearing of Eyler have truly unique intellectual abilities that have struck the contemporarys: The Walking Encyclopedia. He remembered by heart the Eneida of Vergilia, a huge poem. He also kept all the texts of \"Iliada\" and \"Odyssey\" Homer in his memory. Moreover, he could reproduce any paragraph from the book he read, even if the book was simply positive.One time, during a dispute with Denis Didro, he struck the court members, allegedly proving God's existence with a formula: \"(a + bn)/n = x.\" In fact, it was a joke, but it shows how great his reputation was. In reality, he was struck by calculations in his mind. The elephant and the fly. Legend is that he was approached by a task that put many mathematicians at a standstill: to prove that an elephant was heavier than a fly.So, the problem with the problem is that, in a complex system of inequality and differential equations, it's a way of proving that even in a complex system, the mass of the elephant is bigger than the mass of the fly, and this story is a vivid example of his ability to math anything.\n\nIn 1735, while working on the task of astronomy (coma trajectory), he spent three days without sleep. Colleagues asked for it for three months, and he did it in three days. However, he lost his right eye. The second blindness. When he returned to Russia in 1766, he was almost completely blind to the second eye.The science career seemed to be over, but he didn't give up, the diary in the dark, and he designed his own recording system: he wrote huge formulas of chalk on the board, or he put them on paper, and he used a special pencil to keep his mind in order to remember the sequence of his thoughts, and he left a trace that he could feel with his fingers.It is amazing that in the last 17 years of complete blindness he has created more than half of his work (about 380 articles and books), and he dictates his work to his son-in-law, or to his sons, or just to the recorder.\n\n♪ Family life and children: \"Genius on the knees\" by Euler was not just a scientist, but also a loving family member, adding to his image of humanity: children are music.It is said that his greatest discoveries were made just when one of his 13 children was on his knees and the rest were playing on the floor next to him. 13 children. He had 13 children from his first wife (Gzel Katarina). Only five of them survived. It was a harsh reality of the 18th century, and the loss of his children was his personal tragedy, which he had been taking with courage. A mother and niece. After the death of his first wife, he married her half sister.His mother-in-law, Maria Sybilla Merian, was famous for her insect illustrations, but in history she remained as a man who became a link for the family of great mathematicians.\n\nIn 1745, the first complete Russian \"Geographic Atlas\" was published under his leadership. This was a huge job that required the processing of data from hundreds of expeditions. Secret tasks.He was basically a government science adviser.\n\ said, \"Your Majesty, I am not witty, because my answers make sense, unlike Mr. Volter's. \" The love of Catherine II. When he returned to Russia, he received a royal reception from Catherine. She gave him a huge salary so he wouldn't need anything, and she said, \"If he's blind, let him dictate that I pay for all the writers.\" She gave him full freedom of creativity.\n\n\"Write to the German Princess\" was an 18th-century bestseller who was a brilliant popularist of science. His \"Write to the German Princess on various physical and philosophical matter\" written in 1768-1772 became a world bestseller. This book was translated into 10 languages, with about 40 publications, and was essentially an encyclopedia of physics and astronomy of the time, written in a living and accessible language.Even after his death, the book was read by many generations.\n\nThe legend says that he died the same way he worked. On that day, he was in the process of calculating the trajectory of the balloon. While his brother-in-law was recording the formula, he took the tobacco, smelled the tobacco, and... suddenly said, \"I'm dying.\" His heart stopped at the same moment.His tombstone (in the Alexandro-Nevá lavre) has an epitaph that reads: \"Here lies the ashes of the wise, righteous and famous Leonard Eyler.\""
