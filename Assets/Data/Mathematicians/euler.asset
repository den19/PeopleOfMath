    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f \u0432\u043f\u0435\u0440\u0451\u0434 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0432\u0441\u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. 1755 \u0433\u043e\u0434 \u2014 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e
    \u00ab\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u00bb. \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e
    \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f,
    \u0440\u0435\u0448\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0437\u0430\u0434\u0430\u0447
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435
    \u0438 \u043e\u043f\u0442\u0438\u043a\u0435. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u00ab\u041f\u0438\u0441\u044c\u043c\u0430 \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439
    \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435 \u043e \u0440\u0430\u0437\u043d\u044b\u0445
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u0440\u0438\u044f\u0445\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0442\u0430\u043b\u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u043c \u043d\u0430\u0443\u0447\u043d\u043e-\u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u0438 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b\u0438
    \u043e\u043a\u043e\u043b\u043e 40 \u0438\u0437\u0434\u0430\u043d\u0438\u0439 \u043d\u0430
    \u0434\u0435\u0441\u044f\u0442\u0438 \u044f\u0437\u044b\u043a\u0430\u0445. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u043e\u043c II, \u043e\u0434\u043d\u0430\u043a\u043e,
    \u0431\u044b\u043b\u0438 \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438: \u043a\u043e\u0440\u043e\u043b\u044c
    \u043d\u0435 \u043e\u0446\u0435\u043d\u0438\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u042d\u0439\u043b\u0435\u0440\u0430, \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u044f
    \u0435\u043c\u0443 \u0431\u043e\u043b\u0435\u0435 \u0441\u0432\u0435\u0442\u0441\u043a\u0438\u0445
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432. \u0418\u043c\u0435\u043d\u043d\u043e
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432 1766 \u0433\u043e\u0434\u0443, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u043d\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u043e\u0442 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u0440\u0438\u0446\u044b \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b
    II, \u042d\u0439\u043b\u0435\u0440 \u0431\u0435\u0437 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0420\u043e\u0441\u0441\u0438\u044e.\n\n\U0001F1F7\U0001F1FA
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433
    \u0438 \u0442\u0440\u0438\u0443\u043c\u0444 \u043d\u0430\u0434 \u0441\u043b\u0435\u043f\u043e\u0442\u043e\u0439
    (1766\u20131783) \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433,
    \u042d\u0439\u043b\u0435\u0440 \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0447\u0442\u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u043b\u0435\u043f \u043d\u0430
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0433\u043b\u0430\u0437. \u041d\u043e \u044d\u0442\u043e
    \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u043e \u0435\u0433\u043e,
    \u0430, \u043d\u0430\u043f\u0440\u043e\u0442\u0438\u0432, \u043a\u0430\u0436\u0435\u0442\u0441\u044f,
    \u0434\u0430\u0436\u0435 \u043f\u043e\u0434\u0441\u0442\u0435\u0433\u043d\u0443\u043b\u043e
    \u0435\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c.
    \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f \u0441\u0432\u043e\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043e\u043d \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u0430\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u0438 \u043e\u0444\u043e\u0440\u043c\u043b\u044f\u043b\u0438
    \u0438\u0445. \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434,
    \u0443\u0436\u0435 \u043d\u0435 \u0432\u0438\u0434\u044f \u043d\u0438 \u0441\u0442\u0440\u043e\u0447\u043a\u0438,
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043e\u0448\u043b\u0438
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043d\u0430\u0443\u043a\u0438: | \u0413\u043e\u0434
    | \u0422\u0440\u0443\u0434 | \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 | |:--- |:---
    |:--- | | 1768\u20131770 | \u00ab\u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u00bb | \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0440\u0438\u043b\u043e\u0433\u0438\u044e
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0430\u043d\u0430\u043b\u0438\u0437\u0443 (\u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e
    \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c\u00bb \u0438 \u00ab\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u043c\u00bb). | | 1768\u20131769
    | \u00ab\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb
    | \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b
    \u043e\u043a\u043e\u043b\u043e 30 \u0438\u0437\u0434\u0430\u043d\u0438\u0439 \u043d\u0430
    6 \u044f\u0437\u044b\u043a\u0430\u0445. | | 1768\u20131774 | \u00ab\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435...\u00bb
    | \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0435 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0444\u0438\u0437\u0438\u043a\u0438, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438, \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0451\u043d\u043d\u043e\u0435
    \u043d\u0430 \u043c\u043d\u043e\u0433\u0438\u0435 \u044f\u0437\u044b\u043a\u0438. | \u0417\u0430
    \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c \u042d\u0439\u043b\u0435\u0440 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0431\u043e\u043b\u0435\u0435 850 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442,
    \u0430 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435,
    \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u043c\u043e\u0435 \u0432 \u043f\u043e\u043b\u043d\u043e\u0435
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439
    (Opera Omnia), \u043d\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u0434\u0435\u0441\u044f\u0442\u043a\u0438
    \u0442\u043e\u043c\u043e\u0432 \u0438 \u0438\u0437\u0434\u0430\u0451\u0442\u0441\u044f \u0434\u043e
    \u0441\u0438\u0445 \u043f\u043e\u0440.\n\n\U0001F4DD \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0412\u043a\u043b\u0430\u0434 \u042d\u0439\u043b\u0435\u0440\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u043d\u0435\u043e\u0431\u044a\u044f\u0442\u0435\u043d.
    \u041e\u043d: \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437, \u043f\u0440\u0438\u0434\u0430\u0432 \u0435\u043c\u0443
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0434 \u0438
    \u0441\u043e\u0437\u0434\u0430\u0432 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0417\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e
    \u0442\u0435\u043b\u0430 \u0438 \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438,
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. \u0412\u043d\u0451\u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u043e\u043f\u0442\u0438\u043a\u0443,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e (\u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b
    \u043c\u0430\u0441\u0441\u0443 \u041b\u0443\u043d\u044b) \u0438 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0412\u0432\u0451\u043b
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \u0438 \u0442\u0435\u0440\u043c\u0438\u043d\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440: \u0441\u0438\u043c\u0432\u043e\u043b\u044b
    \u0447\u0438\u0441\u043b\u0430 \u03c0 (\u043f\u0438), \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432
    e, \u043c\u043d\u0438\u043c\u043e\u0439 \u0435\u0434\u0438\u043d\u0438\u0446\u044b i \u0438
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435. \u042d\u0439\u043b\u0435\u0440
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 18 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1783 \u0433\u043e\u0434\u0430 \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435
    \u043e\u0442 \u0430\u043f\u043e\u043f\u043b\u0435\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u0434\u0430\u0440\u0430. \u041e\u043d \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043d\u0430 \u0421\u043c\u043e\u043b\u0435\u043d\u0441\u043a\u043e\u043c \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u043c
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435, \u0430 \u0432 1956 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u043f\u0440\u0430\u0445 \u0431\u044b\u043b \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0451\u043d
    \u0432 \u041d\u0435\u043a\u0440\u043e\u043f\u043e\u043b\u044c XVIII \u0432\u0435\u043a\u0430
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e-\u041d\u0435\u0432\u0441\u043a\u043e\u0439
    \u043b\u0430\u0432\u0440\u044b. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014
    \u044d\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u0440 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0441\u0430\u043c\u043e\u043e\u0442\u0434\u0430\u0447\u0438, \u043b\u044e\u0431\u0432\u0438
    \u043a \u0437\u043d\u0430\u043d\u0438\u044f\u043c \u0438 \u0441\u0438\u043b\u044b \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0434\u0443\u0445\u0430, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0433\u043e \u0442\u0432\u043e\u0440\u0438\u0442\u044c
    \u0432\u0435\u043b\u0438\u043a\u043e\u0435 \u0434\u0430\u0436\u0435 \u043f\u0435\u0440\u0435\u0434
    \u043b\u0438\u0446\u043e\u043c \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0435\u043c\u043e\u0449\u0438. \u0416\u0430\u043d-\u0411\u0430\u0442\u0438\u0441\u0442
    \u0416\u043e\u0437\u0435\u0444 \u0424\u0443\u0440\u044c\u0435, \u0432\u0435\u043b\u0438\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0441\u043a\u0430\u0437\u0430\u043b
    \u043e \u043d\u0451\u043c: \u00ab\u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u042d\u0439\u043b\u0435\u0440\u0430,
    \u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u042d\u0439\u043b\u0435\u0440\u0430, \u043e\u043d
    \u2014 \u043d\u0430\u0448 \u043e\u0431\u0449\u0438\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u00bb.
    \u0418 \u044d\u0442\u0438 \u0441\u043b\u043e\u0432\u0430 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f
    \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430 \u042d\u0439\u043b\u0435\u0440\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0434\u0430
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b,
    \u043d\u043e \u0438 \u043a\u0430\u043b\u0435\u0439\u0434\u043e\u0441\u043a\u043e\u043f \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445,
    \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0438 \u0434\u0430\u0436\u0435 \u043d\u0435\u043c\u043d\u043e\u0433\u043e
    \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439.
    \u0415\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c, \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u0434\u0435\u043b\u0430\u043b\u0438
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0440\u0430\u0437\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0435 \u043f\u043e \u0442\u0435\u043c\u0430\u043c:\n\n\U0001F9E0
    \u0424\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438:
    \u043f\u0430\u043c\u044f\u0442\u044c, \u0441\u0447\u0435\u0442 \u0438 \u0441\u043b\u0443\u0445
    \u042d\u0439\u043b\u0435\u0440 \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u0440\u0430\u0436\u0430\u043b\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432:
    \u0425\u043e\u0434\u044f\u0447\u0430\u044f \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f.
    \u041e\u043d \u043f\u043e\u043c\u043d\u0438\u043b \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c
    \"\u042d\u043d\u0435\u0438\u0434\u0443\" \u0412\u0435\u0440\u0433\u0438\u043b\u0438\u044f
    \u2014 \u043e\u0433\u0440\u043e\u043c\u043d\u0443\u044e \u043f\u043e\u044d\u043c\u0443.
    \u0422\u0430\u043a\u0436\u0435 \u0432 \u0435\u0433\u043e \u043f\u0430\u043c\u044f\u0442\u0438
    \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c \u0432\u0441\u0435 \u0442\u0435\u043a\u0441\u0442\u044b
    \"\u0418\u043b\u0438\u0430\u0434\u044b\" \u0438 \"\u041e\u0434\u0438\u0441\u0441\u0435\u0438\"
    \u0413\u043e\u043c\u0435\u0440\u0430. \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e,
    \u043e\u043d \u043c\u043e\u0433 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438
    \u043b\u044e\u0431\u043e\u0439 \u0430\u0431\u0437\u0430\u0446 \u0438\u0437 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043d\u043e\u0439
    \u043a\u043d\u0438\u0433\u0438, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u044d\u0442\u0430
    \u043a\u043d\u0438\u0433\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0440\u043e\u043b\u0438\u0441\u0442\u0430\u043d\u0430. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a-\u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b, \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0441\u043f\u043e\u0440\u0430 \u0441 \u0414\u0435\u043d\u0438 \u0414\u0438\u0434\u0440\u043e,
    \u042d\u0439\u043b\u0435\u0440 \u043f\u043e\u0440\u0430\u0437\u0438\u043b \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445,
    \u044f\u043a\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0432 \u0431\u044b\u0442\u0438\u0435
    \u0411\u043e\u0433\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u043e\u0439: \u00ab(a + b\u207f)/n
    = x\u00bb. \u041d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u044d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u0448\u0443\u0442\u043a\u0430, \u043d\u043e \u043e\u043d\u0430
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0432\u0435\u043b\u0438\u043a\u0430 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044f.
    \u0412 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043e\u043d \u043f\u043e\u0440\u0430\u0436\u0430\u043b
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u0432 \u0443\u043c\u0435.
    \u0421\u043b\u043e\u043d \u0438 \u043c\u0443\u0445\u0430. \u041f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u043a \u042d\u0439\u043b\u0435\u0440\u0443 \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0438\u0441\u044c
    \u0441 \u0437\u0430\u0434\u0430\u0447\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0432 \u0442\u0443\u043f\u0438\u043a
    \u043c\u043d\u043e\u0433\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432:
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u0441\u043b\u043e\u043d
    \u0442\u044f\u0436\u0435\u043b\u0435\u0435 \u043c\u0443\u0445\u0438. \u042d\u0439\u043b\u0435\u0440
    \u0440\u0435\u0448\u0438\u043b \u0435\u0451, \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0432
    \u0441\u043b\u043e\u0436\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432
    \u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0434\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u0432 \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u043c\u0430\u0441\u0441\u0430 \u0441\u043b\u043e\u043d\u0430
    \u0431\u043e\u043b\u044c\u0448\u0435 \u043c\u0430\u0441\u0441\u044b \u043c\u0443\u0445\u0438.
    \u042d\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u2014 \u044f\u0440\u043a\u0438\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440 \u0435\u0433\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0432\u0441\u0451, \u0447\u0442\u043e \u0443\u0433\u043e\u0434\u043d\u043e.\n\n\U0001F56F\ufe0f
    \u0422\u0440\u0438\u0443\u043c\u0444 \u043d\u0430\u0434 \u0441\u043b\u0435\u043f\u043e\u0442\u043e\u0439:
    \"\u0413\u043b\u0430\u0437\u0430 \u0443\u043c\u0430\" \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u044b\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0438 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u044e\u0449\u0438\u0439 \u0444\u0430\u043a\u0442
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438: \u041f\u043e\u0442\u0435\u0440\u044f
    \u0437\u0440\u0435\u043d\u0438\u044f. \u0412 1735 \u0433\u043e\u0434\u0443, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u043d\u0430\u0434 \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u043f\u043e \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    (\u0440\u0430\u0441\u0447\u0451\u0442 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438
    \u043a\u043e\u043c\u0435\u0442\u044b), \u042d\u0439\u043b\u0435\u0440 \u043f\u0440\u043e\u0432\u0451\u043b
    \u0442\u0440\u0438 \u0434\u043d\u044f \u0431\u0435\u0437 \u0441\u043d\u0430. \u041a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043f\u0440\u043e\u0441\u0438\u043b\u0438 \u043d\u0430 \u044d\u0442\u043e \u0442\u0440\u0438
    \u043c\u0435\u0441\u044f\u0446\u0430, \u0430 \u043e\u043d \u0432\u0441\u0451 \u0441\u0434\u0435\u043b\u0430\u043b
    \u0437\u0430 \u0442\u0440\u0438 \u0434\u043d\u044f. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0441\u0432\u0435\u0440\u0445\u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e
    \u043e\u043d \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u043f\u0440\u0430\u0432\u044b\u0439
    \u0433\u043b\u0430\u0437. \u0412\u0442\u043e\u0440\u0430\u044f \u0441\u043b\u0435\u043f\u043e\u0442\u0430.
    \u041f\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0432 \u0420\u043e\u0441\u0441\u0438\u044e
    \u0432 1766 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u0441\u043b\u0435\u043f \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u0439 \u0433\u043b\u0430\u0437.
    \u041a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e \u043e\u043a\u043e\u043d\u0447\u0435\u043d\u0430.
    \u041d\u043e \u042d\u0439\u043b\u0435\u0440 \u043d\u0435 \u0441\u0434\u0430\u043b\u0441\u044f.
    \u0414\u043d\u0435\u0432\u043d\u0438\u043a \u0432 \u0442\u0435\u043c\u043d\u043e\u0442\u0435.
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0437\u0430\u043f\u0438\u0441\u0438: \u043f\u0438\u0441\u0430\u043b
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b
    \u043c\u0435\u043b\u043e\u043c \u043d\u0430 \u0433\u0440\u0438\u0444\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u043e\u0441\u043a\u0435 \u0438\u043b\u0438 \u043a\u0440\u0443\u043f\u043d\u043e \u0432\u044b\u0432\u043e\u0434\u0438\u043b
    \u0438\u0445 \u043d\u0430 \u0431\u0443\u043c\u0430\u0433\u0435. \u0427\u0442\u043e\u0431\u044b
    \u043d\u0435 \u0437\u0430\u0431\u044b\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0441\u0432\u043e\u0438\u0445 \u043c\u044b\u0441\u043b\u0435\u0439, \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u0430\u0440\u0430\u043d\u0434\u0430\u0448,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0441\u043b\u0435\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u043c\u043e\u0433
    \u043e\u0449\u0443\u043f\u0430\u0442\u044c \u043f\u0430\u043b\u044c\u0446\u0430\u043c\u0438.
    \"\u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u042d\u0439\u043b\u0435\u0440\u0430\". \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    17 \u043b\u0435\u0442 \u043f\u043e\u043b\u043d\u043e\u0439 \u0441\u043b\u0435\u043f\u043e\u0442\u044b
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u044b
    \u0441\u0432\u043e\u0438\u0445 \u0442\u0440\u0443\u0434\u043e\u0432 (\u043e\u043a\u043e\u043b\u043e
    380 \u0441\u0442\u0430\u0442\u0435\u0439 \u0438 \u043a\u043d\u0438\u0433)! \u041e\u043d
    \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0437\u044f\u0442\u044e, \u0441\u044b\u043d\u043e\u0432\u044c\u044f\u043c \u0438\u043b\u0438
    \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0438\u043c.
    \u0415\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u044f\u0441\u043d\u044b\u043c\u0438
    \u0438 \u043b\u043e\u0433\u0438\u0447\u043d\u044b\u043c\u0438, \u0447\u0442\u043e \u043d\u0435
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438
    \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u043e\u0432.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0434\u0435\u0442\u0438:
    \"\u0413\u0435\u043d\u0438\u0439 \u043d\u0430 \u043a\u043e\u043b\u0435\u043d\u044f\u0445\"
    \u042d\u0439\u043b\u0435\u0440 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0443\u0447\u0451\u043d\u044b\u043c, \u043d\u043e \u0438 \u043b\u044e\u0431\u044f\u0449\u0438\u043c
    \u0441\u0435\u043c\u044c\u044f\u043d\u0438\u043d\u043e\u043c, \u0447\u0442\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442
    \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u043e\u0441\u0442\u0438:
    \u0414\u0435\u0442\u0438 \u2014 \u044d\u0442\u043e \u043c\u0443\u0437\u044b\u043a\u0430.
    \u042d\u0439\u043b\u0435\u0440 \u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u0438\u043b
    \u043c\u0443\u0437\u044b\u043a\u0443. \u041e\u043d \u0438\u0433\u0440\u0430\u043b \u043d\u0430
    \u043a\u043b\u0430\u0432\u0435\u0441\u0438\u043d\u0435, \u0438 \u0447\u0430\u0441\u0442\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0443\u0441\u043f\u043e\u043a\u043e\u0438\u0442\u044c \u043f\u043b\u0430\u0447\u0443\u0449\u0435\u0433\u043e
    \u0440\u0435\u0431\u0435\u043d\u043a\u0430, \u043e\u043d \u0441\u0430\u0436\u0430\u043b
    \u0435\u0433\u043e \u043a \u0441\u0435\u0431\u0435 \u043d\u0430 \u043a\u043e\u043b\u0435\u043d\u0438
    \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u043b \u0438\u0433\u0440\u0430\u0442\u044c,
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u044f\u0442\u044c
    \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0413\u043e\u0432\u043e\u0440\u044f\u0442,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0431\u044b\u043b\u0438 \u0441\u0434\u0435\u043b\u0430\u043d\u044b
    \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \u043d\u0430 \u0435\u0433\u043e \u043a\u043e\u043b\u0435\u043d\u044f\u0445 \u0441\u0438\u0434\u0435\u043b
    \u043e\u0434\u0438\u043d \u0438\u0437 13 \u0434\u0435\u0442\u0435\u0439, \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u0433\u0440\u0430\u043b\u0438 \u043d\u0430 \u043f\u043e\u043b\u0443 \u0440\u044f\u0434\u043e\u043c.
    13 \u0434\u0435\u0442\u0435\u0439. \u0423 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u043e
    13 \u0434\u0435\u0442\u0435\u0439 \u043e\u0442 \u043f\u0435\u0440\u0432\u043e\u0439 \u0436\u0435\u043d\u044b
    (\u041a\u0430\u0442\u0430\u0440\u0438\u043d\u044b \u0413\u0437\u0435\u043b\u044c). \u0418\u0437
    \u043d\u0438\u0445 \u0432\u044b\u0436\u0438\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u044f\u0442\u0435\u0440\u043e. \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0441\u0443\u0440\u043e\u0432\u0430\u044f
    \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c XVIII \u0432\u0435\u043a\u0430,
    \u0438 \u043f\u043e\u0442\u0435\u0440\u044f \u0434\u0435\u0442\u0435\u0439 \u0431\u044b\u043b\u0430
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043b
    \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e. \u0422\u0451\u0449\u0430
    \u0438 \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u0446\u0430. \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043f\u0435\u0440\u0432\u043e\u0439 \u0436\u0435\u043d\u044b
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0435\u0451 \u0441\u0432\u043e\u0434\u043d\u043e\u0439
    \u0441\u0435\u0441\u0442\u0440\u0435. \u0415\u0433\u043e \u0442\u0435\u0449\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u0446\u0430 \u041c\u0430\u0440\u0438\u044f \u0421\u0438\u0431\u0438\u043b\u043b\u0430
    \u041c\u0435\u0440\u0438\u0430\u043d, \u0431\u044b\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u0441\u0432\u043e\u0438\u043c\u0438 \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0430\u0446\u0438\u044f\u043c\u0438
    \u043d\u0430\u0441\u0435\u043a\u043e\u043c\u044b\u0445, \u043d\u043e \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043e\u043d\u0430 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b \u0441\u0432\u044f\u0437\u0443\u044e\u0449\u0438\u043c
    \u0437\u0432\u0435\u043d\u043e\u043c \u0434\u043b\u044f \u0441\u0435\u043c\u044c\u0438 \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.\n\n\U0001F5FA\ufe0f \u041a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444
    \u0438 \u0448\u043f\u0438\u043e\u043d \u042d\u0439\u043b\u0435\u0440 \u0431\u044b\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u043e\u0447\u0435\u043d\u044c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c: \u041f\u0435\u0440\u0432\u0430\u044f
    \u043a\u0430\u0440\u0442\u0430 \u0420\u043e\u0441\u0441\u0438\u0438. \u0412 1745 \u0433\u043e\u0434\u0443
    \u043f\u043e\u0434 \u0435\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0431\u044b\u043b \u0438\u0437\u0434\u0430\u043d \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u043e\u043b\u043d\u044b\u0439
    \"\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0442\u043b\u0430\u0441
    \u0420\u043e\u0441\u0441\u0438\u0438\". \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0430
    \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0434\u0430\u043d\u043d\u044b\u0445
    \u0441 \u0441\u043e\u0442\u0435\u043d \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0439.
    \u0421\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u041f\u043e \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u0438\u044e \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u0440\u0438\u0446\u044b \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b
    II \u042d\u0439\u043b\u0435\u0440 \u0440\u0435\u0448\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0438
    \u043f\u043e \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438, \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0438 \u0434\u0430\u0436\u0435 \u0431\u0430\u043b\u043b\u0438\u0441\u0442\u0438\u043a\u0435.
    \u041e\u043d \u0431\u044b\u043b, \u043f\u043e \u0441\u0443\u0442\u0438, \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c \u043f\u043e \u043d\u0430\u0443\u043a\u0435.\n\n\U0001F934
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043c\u043e\u043d\u0430\u0440\u0445\u0430\u043c\u0438
    \u042d\u0439\u043b\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043f\u0440\u0438
    \u0434\u0432\u0443\u0445 \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043c\u043e\u043d\u0430\u0440\u0445\u0430\u0445
    \u2014 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0435 II (\u041f\u0440\u0443\u0441\u0441\u0438\u044f)
    \u0438 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0435 II (\u0420\u043e\u0441\u0441\u0438\u044f),
    \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u043d\u0435\u043c\u0443
    \u0431\u044b\u043b\u043e \u0434\u0438\u0430\u043c\u0435\u0442\u0440\u0430\u043b\u044c\u043d\u043e
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u044b\u043c:
    \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u043e\u043c
    II. \u041f\u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u043a\u043e\u0440\u043e\u043b\u044c,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u043f\u0440\u043e\u0441\u0432\u0435\u0449\u0451\u043d\u043d\u044b\u043c,
    \u043d\u0435 \u043b\u044e\u0431\u0438\u043b \u042d\u0439\u043b\u0435\u0440\u0430. \u041e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b \u0435\u0433\u043e \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0441\u043a\u0443\u0447\u043d\u044b\u043c \u0438 \u043d\u0435 \"\u0441\u0432\u0435\u0442\u0441\u043a\u0438\u043c\".
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445 \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e
    \u042d\u0439\u043b\u0435\u0440 \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \"\u0443\u0447\u0451\u043d\u043e\u0433\u043e
    \u043c\u0443\u0436\u0438\u043a\u0430\" \u0438 \u043d\u0435 \u0443\u043c\u0435\u0435\u0442
    \u0432\u0435\u0441\u0442\u0438 \u0431\u0435\u0441\u0435\u0434\u0443. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043a\u043e\u0440\u043e\u043b\u044c \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u042d\u0439\u043b\u0435\u0440\u0430,
    \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d \u043d\u0435 \u0442\u0430\u043a\u043e\u0439
    \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u0439, \u043a\u0430\u043a \u0412\u043e\u043b\u044c\u0442\u0435\u0440.
    \u041d\u0430 \u044d\u0442\u043e \u042d\u0439\u043b\u0435\u0440 \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u0412\u0430\u0448\u0435 \u0412\u0435\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e,
    \u044f \u043d\u0435 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u0435\u043d, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u043c\u043e\u0438 \u043e\u0442\u0432\u0435\u0442\u044b \u0438\u043c\u0435\u044e\u0442
    \u0441\u043c\u044b\u0441\u043b, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442
    \u043e\u0441\u0442\u0440\u043e\u0442 \u0433\u043e\u0441\u043f\u043e\u0434\u0438\u043d\u0430
    \u0412\u043e\u043b\u044c\u0442\u0435\u0440\u0430\u00bb. \u041e\u0431\u043e\u0436\u0430\u043d\u0438\u0435
    \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b II. \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432 \u0420\u043e\u0441\u0441\u0438\u044e, \u042d\u0439\u043b\u0435\u0440 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043e\u0442 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b \u0446\u0430\u0440\u0441\u043a\u0438\u0439
    \u043f\u0440\u0438\u0435\u043c. \u041e\u043d\u0430 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u0435,
    \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u043d\u0438 \u0432 \u0447\u0451\u043c \u043d\u0435
    \u043d\u0443\u0436\u0434\u0430\u043b\u0441\u044f, \u0438 \u0441\u043a\u0430\u0437\u0430\u043b\u0430:
    \u00ab\u0415\u0441\u043b\u0438 \u042d\u0439\u043b\u0435\u0440 \u043e\u0441\u043b\u0435\u043f,
    \u043f\u0443\u0441\u0442\u044c \u0434\u0438\u043a\u0442\u0443\u0435\u0442 \u2014 \u044f
    \u0437\u0430\u043f\u043b\u0430\u0447\u0443 \u0437\u0430 \u0432\u0441\u0435\u0445 \u043f\u0438\u0441\u0446\u043e\u0432\u00bb.
    \u041e\u043d\u0430 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043f\u043e\u043b\u043d\u0443\u044e \u0441\u0432\u043e\u0431\u043e\u0434\u0443
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430.\n\n\u270d\ufe0f \"\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435\"
    \u2014 \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440 XVIII \u0432\u0435\u043a\u0430
    \u042d\u0439\u043b\u0435\u0440 \u0431\u044b\u043b \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \"\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0446\u0435\u0441\u0441\u0435
    \u043e \u0440\u0430\u0437\u043d\u044b\u0445 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u044f\u0445\",
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0435 \u0432 1768\u20131772 \u0433\u043e\u0434\u0430\u0445,
    \u0441\u0442\u0430\u043b\u0438 \u043c\u0438\u0440\u043e\u0432\u044b\u043c \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440\u043e\u043c.
    \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430 \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u0430
    \u043d\u0430 10 \u044f\u0437\u044b\u043a\u043e\u0432, \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b\u0430
    \u043e\u043a\u043e\u043b\u043e 40 \u0438\u0437\u0434\u0430\u043d\u0438\u0439. \u041f\u043e
    \u0441\u0443\u0442\u0438, \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0430\u044f
    \u0436\u0438\u0432\u044b\u043c \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c
    \u044f\u0437\u044b\u043a\u043e\u043c. \u0414\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u042d\u0439\u043b\u0435\u0440\u0430 \u044d\u0442\u0443
    \u043a\u043d\u0438\u0433\u0443 \u0447\u0438\u0442\u0430\u043b\u0438 \u043c\u043d\u043e\u0433\u0438\u0435
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f.\n\n\u26b0\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c
    \u0438 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f \u042d\u0439\u043b\u0435\u0440 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    18 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1783 \u0433\u043e\u0434\u0430 \u0432
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435. \u041b\u0435\u0433\u0435\u043d\u0434\u0430
    \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u0440
    \u0442\u0430\u043a \u0436\u0435, \u043a\u0430\u043a \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b.
    \u0412 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438
    \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0433\u043e \u0448\u0430\u0440\u0430. \u041f\u043e\u043a\u0430
    \u0435\u0433\u043e \u0437\u044f\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443, \u042d\u0439\u043b\u0435\u0440 \u0432\u0437\u044f\u043b
    \u0442\u0430\u0431\u0430\u043a\u0435\u0440\u043a\u0443, \u043f\u043e\u043d\u044e\u0445\u0430\u043b
    \u0442\u0430\u0431\u0430\u043a\u0443 \u0438... \u0432\u0434\u0440\u0443\u0433 \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441:
    \u00ab\u042f \u0443\u043c\u0438\u0440\u0430\u044e\u00bb. \u0412 \u0442\u043e\u0442 \u0436\u0435
    \u043c\u0438\u0433 \u0435\u0433\u043e \u0441\u0435\u0440\u0434\u0446\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u043e\u0441\u044c.
    \u041d\u0430 \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0438 (\u0432
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e-\u041d\u0435\u0432\u0441\u043a\u043e\u0439
    \u043b\u0430\u0432\u0440\u0435) \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0433\u043b\u0430\u0441\u0438\u0442: \u00ab\u0417\u0434\u0435\u0441\u044c
    \u043f\u043e\u043a\u043e\u0438\u0442\u0441\u044f \u043f\u0440\u0430\u0445 \u043c\u0443\u0434\u0440\u043e\u0433\u043e,
    \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u043e\u0433\u043e \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0430 \u042d\u0439\u043b\u0435\u0440\u0430\u00bb."
