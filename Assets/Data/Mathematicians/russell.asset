    \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439
    \u043a\u0440\u0438\u0437\u0438\u0441. \u041f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c
    \u0441\u0432\u043e\u0435\u0433\u043e \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0433\u043e
    \u0434\u0440\u0443\u0433\u0430, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430-\u0433\u0435\u0433\u0435\u043b\u044c\u044f\u043d\u0446\u0430
    \u041c\u0430\u043a\u0442\u0430\u0433\u0433\u0430\u0440\u0442\u0430, \u043e\u043d \u0443\u0432\u043b\u0451\u043a\u0441\u044f
    \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u043c\u043e\u043c. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u043a\u0443\u043f\u0438\u0442\u044c
    \u0431\u0430\u043d\u043a\u0443 \u0442\u0430\u0431\u0430\u043a\u0430 \u0438 \u043d\u0430
    \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u043c \u043f\u0443\u0442\u0438 \u043f\u043e \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u041b\u0435\u0439\u043d
    \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e, \u043f\u043e\u0434\u0431\u0440\u043e\u0441\u0438\u0432
    \u0435\u0451 \u0432 \u0432\u043e\u0437\u0434\u0443\u0445, \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b:
    \"\u0412\u0435\u043b\u0438\u043a\u0438\u0439 \u0411\u043e\u0436\u0435 \u0432 \u0441\u0430\u043f\u043e\u0433\u0430\u0445!
    \u041e\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442
    \u0432\u0435\u0440\u0435\u043d!\". \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442
    \u043c\u043e\u043c\u0435\u043d\u0442 \u043e\u043d \u043e\u0441\u043e\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b \u0433\u0435\u0433\u0435\u043b\u044c\u044f\u043d\u0446\u0435\u043c.
    \u0418\u0440\u043e\u043d\u0438\u044f: \u041f\u043e\u0437\u0436\u0435 \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u044d\u0442\u0438\u0445 \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432 \u0438
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432 \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u043c\u0430.
    \u0410 \u0447\u0442\u043e \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0442\u0430\u0431\u0430\u043a\u0430
    \u2014 \u043e\u043d \u043a\u0443\u0440\u0438\u043b \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c,
    \u0438 \u043e\u0434\u043d\u0430\u0436\u0434\u044b, \u0432 1948 \u0433\u043e\u0434\u0443,
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0430\u0432\u0438\u0430\u043f\u0435\u0440\u0435\u043b\u0451\u0442\u0430,
    \u043e\u043d \u043f\u043e\u0448\u0451\u043b \u0432 \u0442\u0443\u0430\u043b\u0435\u0442
    \u043f\u043e\u043a\u0443\u0440\u0438\u0442\u044c, \u0438 \u0432 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u0442\u0430\u043c, \u0441\u0430\u043c\u043e\u043b\u0451\u0442
    \u0440\u0443\u0445\u043d\u0443\u043b \u0432 \u043c\u043e\u0440\u0435. \u041e\u043d \u0432\u044b\u0436\u0438\u043b,
    \u0430 cigarette \u0441\u043f\u0430\u0441\u043b\u0430 \u0435\u043c\u0443 \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F393
    \u0427\u0443\u0434\u043d\u043e\u0439 \u0440\u0435\u0431\u0451\u043d\u043e\u043a \u0438 \u0441\u0442\u0440\u043e\u0433\u0430\u044f
    \u0431\u0430\u0431\u0443\u0448\u043a\u0430 \u0412\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u043d\u044b\u0439
    \u0431\u0430\u0431\u0443\u0448\u043a\u043e\u0439 \u0432 \u0441\u0442\u0440\u043e\u0433\u0438\u0445
    \u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0445 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f\u0445,
    \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439 \u0411\u0435\u0440\u0442\u0440\u0430\u043d
    \u0443\u0436\u0435 \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u0440\u0430\u0436\u0430\u043b
    \u0432\u0441\u0435\u0445 \u0441\u0432\u043e\u0435\u0439 \u043b\u044e\u0431\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u043d \u0441\u043f\u0440\u043e\u0441\u0438\u043b
    \u0441\u0432\u043e\u044e \u0442\u0451\u0442\u044e: \"\u0422\u0451\u0442\u044f, \u0430 \u043c\u043e\u0440\u0441\u043a\u0438\u0435
    \u0443\u0442\u043e\u0447\u043a\u0438 \u0434\u0443\u043c\u0430\u044e\u0442?\". \u041d\u0430
    \u043d\u0435\u0434\u043e\u0443\u043c\u0451\u043d\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442
    \"\u041d\u0435 \u0437\u043d\u0430\u044e\", \u043e\u043d \u043f\u0430\u0440\u0438\u0440\u043e\u0432\u0430\u043b:
    \"\u0422\u043e\u0433\u0434\u0430 \u0442\u044b \u0434\u043e\u043b\u0436\u043d\u0430 \u044d\u0442\u043e
    \u0443\u0437\u043d\u0430\u0442\u044c!\". \u0411\u0430\u0431\u0443\u0448\u043a\u0430 \u0431\u044b\u043b\u0430
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435, \u043d\u043e \u043a 14 \u0433\u043e\u0434\u0430\u043c
    \u043e\u043d \u0443\u0436\u0435 \u0441\u0442\u0430\u043b \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c
    \u0435\u0451 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0443\u0442\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439,
    \u0430 \u0435\u0451 \u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0443\u044e \u043c\u043e\u0440\u0430\u043b\u044c
    \u2014 \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e\u0439. \u0427\u0442\u043e\u0431\u044b
    \u0432\u0435\u0441\u0442\u0438 \u0434\u043d\u0435\u0432\u043d\u0438\u043a \u0432 \u0442\u0430\u0439\u043d\u0435
    \u043e\u0442 \u0432\u0441\u0435\u0445, \u043e\u043d \u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e
    \u043d\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435.\n\n\U0001F4EC
    \u041e\u0442\u0432\u0435\u0442\u044b \u043d\u0430 \u0441\u043e\u0442\u043d\u0438 \u043f\u0438\u0441\u0435\u043c
    \u0420\u0430\u0441\u0441\u0435\u043b \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0435\u043d, \u0438 \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u043b\u0438\u0447\u043d\u043e
    \u043e\u0442\u0432\u0435\u0447\u0430\u0442\u044c \u043d\u0430 \u043f\u0438\u0441\u044c\u043c\u0430.
    \u0423\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e
    \u0432 \u043f\u0438\u043a \u0441\u0432\u043e\u0435\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u043b \u0434\u043e 100 \u043f\u0438\u0441\u0435\u043c
    \u0432 \u0434\u0435\u043d\u044c. \u041e\u043d \u0437\u0430\u0432\u043e\u0434\u0438\u043b
    \u043b\u0438\u0447\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0434\u0430\u0436\u0435 \u0441 \u0434\u0435\u0442\u044c\u043c\u0438. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043e\u043d \u043f\u043e\u0437\u0434\u0440\u0430\u0432\u0438\u043b \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e
    \u0434\u0435\u0432\u043e\u0447\u043a\u0443 \u0441 \u0434\u043d\u0451\u043c \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u043b
    \u0441 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c,
    \u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u043e\u0434\u0438\u043d\u043e\u043a\u043e\u0439
    \u0434\u0435\u0432\u043e\u0447\u043a\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0441\u0442\u0430\u0442\u044c \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u043f\u043e
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0441\u043e \u0441\u0432\u043e\u0435\u0439
    \u0432\u043d\u0443\u0447\u043a\u043e\u0439.\n\n\U0001F3A5 \u041c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442 \u043f\u0440\u043e \u0430\u0434 \u0425\u043e\u0434\u0438\u043b
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442, \u0447\u0442\u043e \u043a\u043e\u0433\u0434\u0430
    \u0420\u0430\u0441\u0441\u0435\u043b \u0443\u043c\u0435\u0440 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u043b
    \u043f\u0435\u0440\u0435\u0434 \u0411\u043e\u0433\u043e\u043c, \u0412\u0441\u0435\u0432\u044b\u0448\u043d\u0438\u0439
    \u0441\u043a\u0430\u0437\u0430\u043b \u0435\u043c\u0443: \"\u0422\u044b \u0431\u044b\u043b
    \u0447\u0435\u0441\u0442\u043d\u044b\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u043c,
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u044f \u043e\u0442\u0432\u0435\u0447\u0443 \u043d\u0430
    \u0442\u0440\u0438 \u0442\u0432\u043e\u0438\u0445 \u0432\u043e\u043f\u0440\u043e\u0441\u0430,
    \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c
    \u0442\u0435\u0431\u044f \u0432 \u0430\u0434\". \u0420\u0430\u0441\u0441\u0435\u043b \u0441\u0440\u0430\u0437\u0443
    \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u043d\u0430
    \u0432\u0441\u0435\u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u043e \u0438 \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043a\u0430\u043c\u0435\u043d\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0411\u043e\u0433 \u0441\u0430\u043c \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442
    \u043f\u043e\u0434\u043d\u044f\u0442\u044c. \u041a\u043e\u0433\u0434\u0430 \u0411\u043e\u0433
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0420\u0430\u0441\u0441\u0435\u043b \u0441 \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u043e\u043c
    \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043f\u043e\u0439\u043c\u0430\u043b
    \u0435\u0433\u043e \u0432 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043f\u043e \u0438\u0440\u043e\u043d\u0438\u0438
    \u0441\u0443\u0434\u044c\u0431\u044b, \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e\u0442
    \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f
    \u0437\u0430\u0433\u043e\u043d\u044f\u0442\u044c \u0412\u0441\u0435\u0432\u044b\u0448\u043d\u0435\u0433\u043e
    \u0432 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u043c\u043a\u0438,
    \u0438 \u0435\u0441\u0442\u044c \u0435\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u0434. \u041e\u0442\u043b\u0438\u0447\u043d\u0430\u044f \u0448\u0443\u0442\u043a\u0430,
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0430\u044f, \u043a\u0430\u043a
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438
    \u0435\u0433\u043e \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u044c \u043b\u043e\u0433\u0438\u043a\u043e\u0439.
    \u041a\u0430\u043a \u0432\u0438\u0434\u0438\u0442\u0435, \u0420\u0430\u0441\u0441\u0435\u043b
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0443\u0445\u0438\u043c
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c, \u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u043c\u0435\u043b
    \u043f\u043e\u0441\u043c\u0435\u044f\u0442\u044c\u0441\u044f \u0438 \u043d\u0430\u0434 \u0441\u043e\u0431\u043e\u0439,
    \u0438 \u043d\u0430\u0434 \u0441\u0430\u043c\u043e\u0439, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0431\u044b, \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0439
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439."
  interestingFactsEn: "Bertrand Russell is the figure around which passions have always boiled, and his life is full of funny, strange and human episodes that make him not just a great philosopher, but an incredibly living character, and these are some of the brightest and most interesting facts and chickens from his biography.\n\nThe legend of \"Cheinique Russell\" (which is often debriefed) is perhaps Russell's most famous philosophical argument and at the same time the source of the mass of anecdotes. In reality, in 1952 he proposed a thought experiment: if I claim that there is a porcelain teapot spinning between Earth and Mars, I will not have to prove it until you deny it.He said, \"You know, the truth is that the burden of proof lies with someone who claims to exist (including God), and he says, \"On the Internet and the oral bikes, this is a clever argument that has turned into an absurd story about how Russell came to church, hit the priest with a kettle over the head, and ran away, thus proving his right not to believe in God.\"It's fiction, of course, but it's a vivid illustration of how his image of \"logistical bully\" attracted folk creativity.\n\nRussell's prison humor was a convinced pacifist and sat in prison for his beliefs. In 1918, he went to prison for six months, and in his memoirs with humor, he described the moment he met with the warden: > \"I was very encouraged upon arrival by a guard at the gate, who was supposed to record my data. He asked about my religion, and I said, 'Agnostic'.He said, \"Well, there are many religions, but I suppose they all worship the same God.\" That's what kept me in the mood for about a week.\"\n\n♪ How tobacco helped to become a Hegelian... and left him when Russell was young ♪ ♪ passed through an intellectual crisis ♪ ♪ Under the influence of his eccentric friend, McGaggart's geologist philosopher, he got caught up in idealism ♪ ♪ once he went to buy a tobacco jar ♪ ♪ and on the way back to Trinity Lane ♪ ♪ suddenly threw her in the air ♪ ♪ Great God in his boots ♪ ♪ Ontological argument is true ♪ ♪ at this moment he realized he was a Gegelian ♪Irony: Later on, he gave up those views and became one of the main critics of idealism, and as for tobacco, he smoked his whole life, and one day, in 1948, during an air flight, he went to the bathroom to smoke, and the moment he was there, the plane crashed into the sea, he survived, and cigarette saved his life.\n\n♪ Wonderful kid and a tough grandmother raised by Grandma in strict puritan tradition, little Bertrand was already stunning everyone with his curiosity. One day he asked his aunt, \"Aunt, the ducks think?\" ♪ To the distraught answer, he said, \"I don't know,\" he said, \"Then you have to know!\"Grandma was his primary child, but by the age of 14, he had already found her intellectually tiring, and her puritan morality excessive. To keep a diary secret from everyone, he wrote it in Greek.\n\nHe was incredibly popular with hundreds of letters, and he had the habit of answering letters personally. He was said to have received up to 100 letters a day at the peak of his activity. He wrote personal letters even with his children. He once congratulated a little girl on her birthday, who coincided with his own, and another single girl offered to be friends in correspondence with her granddaughter.\n\nWhen Russell died and appeared before God, God said to him, \"You were an honest opponent, so I will answer three of your questions before I send you to hell.\" Russell immediately began a test of all power and asked him to create a stone that God himself could not lift. When God answered yes, Russell was thrilled to catch him in a logical paradox.But ironically, this is the moment when he tries to put the Most High in a logical framework, and it's his personal hell, and it's a great joke, showing how moderns perceived his obsession as logical. As you can see, Russell was not just a dry academic, but a man with a huge sense of humor who could laugh at himself and himself and on himself, which seemed to be a difficult philosophical problem."
