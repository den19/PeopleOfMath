    \u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a
    \u043c\u0430\u0441\u0441\u044b \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u043e\u0432. \u0412
    \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432 1952 \u0433\u043e\u0434\u0443
