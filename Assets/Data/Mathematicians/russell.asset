  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0430
    \u0420\u0430\u0441\u0441\u0435\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e \u0438
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043b\u0435\u0435
    70 \u043a\u043d\u0438\u0433 \u0438 \u043e\u043a\u043e\u043b\u043e 2000 \u0441\u0442\u0430\u0442\u0435\u0439.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043b\u0435\u0436\u0430\u0442 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043b\u043e\u0433\u0438\u043a\u0438
    \u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043d\u043e \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0441\u043b\u0435\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u044f\u0437\u044b\u043a\u0430 \u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438. \u0412\u0430\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c
    \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439.\n\n\U0001F4D0
    \u041b\u043e\u0433\u0438\u043a\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u042d\u0442\u043e \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0430\u044f
    \u0438 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0447\u0430\u0441\u0442\u044c \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f \u0420\u0430\u0441\u0441\u0435\u043b\u0430.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0430\u0437\u0432\u0438\u043b\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435
    \u0438\u0434\u0435\u0438, \u043d\u043e \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430
    \u043f\u0443\u0442\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u0432\u043f\u0435\u0440\u0435\u0434. \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430
    \u043b\u043e\u0433\u0438\u0446\u0438\u0437\u043c\u0430: \u0420\u0430\u0441\u0441\u0435\u043b
    \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u0443\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0432\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0432\u044b\u0432\u0435\u0434\u0435\u043d\u0430
    \u0438\u0437 \u0447\u0438\u0441\u0442\u043e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u0432. \u0412\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u043e\u043c \u041d\u043e\u0440\u0442\u043e\u043c
    \u0423\u0430\u0439\u0442\u0445\u0435\u0434\u043e\u043c \u043e\u043d \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u043b
    \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c
    \u044d\u0442\u0443 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0432 \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c
    \u0442\u0440\u0435\u0445\u0442\u043e\u043c\u043d\u043e\u043c \u0442\u0440\u0443\u0434\u0435
    \u00abPrincipia Mathematica\u00bb (1910\u20131913), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439
    \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0432\u0441\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438.
    \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0420\u0430\u0441\u0441\u0435\u043b\u0430:
    \u0412 1901 \u0433\u043e\u0434\u0443, \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043d\u0430\u0434
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u0420\u0430\u0441\u0441\u0435\u043b \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u043e\u0441\u0438\u0442 \u0435\u0433\u043e
    \u0438\u043c\u044f. \u041e\u043d \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442
    \u043f\u0440\u0438 \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0438\u0438
    \u00ab\u043a\u043b\u0430\u0441\u0441\u0430 \u0432\u0441\u0435\u0445 \u043a\u043b\u0430\u0441\u0441\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u0441\u0430\u043c\u0438\u0445 \u0441\u0435\u0431\u044f\u00bb:
    \u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u044d\u0442\u043e\u0442
    \u043a\u043b\u0430\u0441\u0441 \u0447\u043b\u0435\u043d\u043e\u043c \u0441\u0430\u043c\u043e\u0433\u043e
    \u0441\u0435\u0431\u044f? \u041e\u0442\u0432\u0435\u0442\u044b \u00ab\u0434\u0430\u00bb
    \u0438 \u00ab\u043d\u0435\u0442\u00bb \u0432 \u0440\u0430\u0432\u043d\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0442 \u043a \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044e.
    \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0432\u0441\u043a\u0440\u044b\u043b\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0442\u0438\u043f\u043e\u0432: \u0427\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441,
    \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0442\u0438\u043f\u043e\u0432. \u0421\u0443\u0442\u044c
    \u0435\u0451 \u0432 \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u043d\u044f\u0442\u0438\u0439: \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    (\u0438\u043b\u0438 \u043a\u043b\u0430\u0441\u0441) \u0432\u0441\u0435\u0433\u0434\u0430
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u043a \u0431\u043e\u043b\u0435\u0435
    \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0443 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0442\u0438\u043f\u0443, \u0447\u0435\u043c \u0435\u0433\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b.
    \u042d\u0442\u043e \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438, \u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0449\u0438\u0435
    \u043a \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0443 \u0441\u0430\u043c\u043e\u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0438.
    \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442
    \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043b\u0451\u0433 \u0432
    \u043e\u0441\u043d\u043e\u0432\u0443 \u00abPrincipia Mathematica\u00bb.\n\n\U0001F5E3\ufe0f
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u044f\u0437\u044b\u043a\u0430 \u0438
    \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f \u0420\u0430\u0441\u0441\u0435\u043b
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b \u043b\u043e\u0433\u0438\u043a\u0443
    \u043a\u0430\u043a \u00ab\u0441\u0443\u0449\u043d\u043e\u0441\u0442\u044c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb
    \u0438 \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0437\u0430\u0434\u0430\u0447\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u2014 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u044f\u0437\u044b\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u044f\u0441\u043d\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0431\u044b\u043b\u0430
    \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0434\u0435\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u0439 (1905): \u042d\u0442\u043e
    \u0435\u0433\u043e \u0441\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0438 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0430\u044f
    \u0441\u0442\u0430\u0442\u044c\u044f. \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0435
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u00ab\u043d\u044b\u043d\u0435\u0448\u043d\u0438\u0439 \u043a\u043e\u0440\u043e\u043b\u044c
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438\u00bb) \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u0438\u043c\u0435\u043d\u0430\u043c\u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438,
    \u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0441\u043e\u0431\u043e\u0439
    \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438. \u042d\u0442\u043e\u0442
    \u0430\u043d\u0430\u043b\u0438\u0437 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u00ab\u043d\u0435\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432\u00bb (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u00ab\u043d\u044b\u043d\u0435\u0448\u043d\u0438\u0439
    \u043a\u043e\u0440\u043e\u043b\u044c \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u043b\u044b\u0441\u00bb
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442 \u0431\u044b\u0442\u044c \u0431\u0435\u0441\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044b\u043c
    \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043f\u0440\u043e\u0441\u0442\u043e
    \u043b\u043e\u0436\u043d\u044b\u043c) \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u043e\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0431\u044b\u0442\u0438\u044f
    \u0411\u043e\u0433\u0430. \u041b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0442\u043e\u043c\u0438\u0437\u043c:
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u041b\u044e\u0434\u0432\u0438\u0433\u043e\u043c \u0412\u0438\u0442\u0433\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c
    \u0420\u0430\u0441\u0441\u0435\u043b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u0442\u043e\u043c\u0438\u0437\u043c\u0430. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u0435\u0439, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u043c\u0435\u0436\u0434\u0443
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043e\u0439 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430.
    \u041f\u0440\u043e\u0441\u0442\u0435\u0439\u0448\u0438\u0435 \u00ab\u0430\u0442\u043e\u043c\u0430\u0440\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b\u00bb (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u00ab\u044d\u0442\u043e \u0431\u0435\u043b\u043e\u0435\u00bb) \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442\u0441\u044f
    \u00ab\u0430\u0442\u043e\u043c\u0430\u0440\u043d\u044b\u043c\u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c\u0438\u00bb,
    \u0430 \u0431\u043e\u043b\u0435\u0435 \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u00ab\u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0435
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u00bb \u0441\u0442\u0440\u043e\u044f\u0442\u0441\u044f
    \u0438\u0437 \u043d\u0438\u0445 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0432\u044f\u0437\u043e\u043a. \u0414\u0432\u0430 \u0432\u0438\u0434\u0430 \u0437\u043d\u0430\u043d\u0438\u044f:
    \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u0440\u043e\u0432\u0451\u043b \u0432\u0430\u0436\u043d\u043e\u0435
    \u0433\u043d\u043e\u0441\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0435 \u043c\u0435\u0436\u0434\u0443 \u00ab\u0437\u043d\u0430\u043d\u0438\u0435\u043c-\u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e\u043c\u00bb
    (\u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u0438\u0439)
    \u0438 \u00ab\u0437\u043d\u0430\u043d\u0438\u0435\u043c \u043f\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044e\u00bb
    (\u0432\u0441\u0451 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u043d\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c
    \u043e\u043f\u043e\u0441\u0440\u0435\u0434\u043e\u0432\u0430\u043d\u043d\u043e, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0437\u043d\u0430\u043d\u0438\u0435 \u043e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043c\u0438\u0440\u0435 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043b\u044e\u0434\u044f\u0445).
    \u0418\u043c\u0435\u043d\u0430, \u043f\u043e \u0420\u0430\u0441\u0441\u0435\u043b\u0443,
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e
    \u043a \u0442\u043e\u043c\u0443, \u0441 \u0447\u0435\u043c \u043c\u044b \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u0437\u043d\u0430\u043a\u043e\u043c\u044b.\n\n\U0001F30C \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f \u0420\u0430\u0441\u0441\u0435\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f
    \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c\u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u044b
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f, \u0447\u0430\u0441\u0442\u043e
    \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044f \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u0438\u043d\u0442\u0435\u0437\u044b. \u00ab\u041d\u0435\u0439\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439
    \u043c\u043e\u043d\u0438\u0437\u043c\u00bb: \u0412 \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    1920-\u0445 \u0433\u043e\u0434\u043e\u0432 (\u00ab\u0410\u043d\u0430\u043b\u0438\u0437 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f\u00bb,
    \u00ab\u0410\u043d\u0430\u043b\u0438\u0437 \u043c\u0430\u0442\u0435\u0440\u0438\u0438\u00bb)
    \u0420\u0430\u0441\u0441\u0435\u043b \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e,
    \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043c\u0438\u0440 \u0432 \u0441\u0432\u043e\u0435\u0439 \u043e\u0441\u043d\u043e\u0432\u0435
    \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u043d\u0435 \u0438\u0437 \u043c\u0430\u0442\u0435\u0440\u0438\u0438
    \u0438 \u043d\u0435 \u0438\u0437 \u0434\u0443\u0445\u0430, \u0430 \u0438\u0437 \u043d\u0435\u043a\u043e\u0435\u0433\u043e
    \u00ab\u043d\u0435\u0439\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430\u00bb.
    \u0415\u0433\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b (\u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f
    \u0438\u043b\u0438 \u043f\u0435\u0440\u0446\u0435\u043f\u0442\u044b) \u043c\u043e\u0433\u0443\u0442
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u043b\u0438\u0431\u043e
    \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438, \u043b\u0438\u0431\u043e
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0434\u0430\u043d\u043d\u044b\u043c\u0438
    \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u043e\u0433\u043e,
    \u0432 \u043a\u0430\u043a\u0438\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u043d\u044b\u0435
    \u0441\u0432\u044f\u0437\u0438 \u043e\u043d\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u044b.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0444\u0438\u0437\u0438\u043a\u0430
    \u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u044f \u0438\u0437\u0443\u0447\u0430\u044e\u0442
    \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435, \u043d\u043e \u0441 \u0440\u0430\u0437\u043d\u044b\u0445
    \u0441\u0442\u043e\u0440\u043e\u043d. \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430\u043b\u0438\u0437\u043c
    \u0432 \u043d\u0430\u0443\u043a\u0435: \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u0440\u0438\u0448\u0451\u043b
    \u043a \u0432\u044b\u0432\u043e\u0434\u0443, \u0447\u0442\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u0435 \u0434\u0430\u0451\u0442 \u043d\u0430\u043c
    \u0437\u043d\u0430\u043d\u0438\u0435 \u043d\u0435 \u043e \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438
    \u0432\u0435\u0449\u0435\u0439, \u0430 \u043b\u0438\u0448\u044c \u043e\u0431 \u0438\u0445
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435.
    \u042d\u0442\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0440\u0430\u0437\u0432\u0438\u0442\u043e\u0435
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u0427\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u0435, \u0435\u0433\u043e \u0441\u0444\u0435\u0440\u0430
    \u0438 \u0433\u0440\u0430\u043d\u0438\u0446\u044b\u00bb (1948), \u043f\u0435\u0440\u0435\u043a\u043b\u0438\u043a\u0430\u0435\u0442\u0441\u044f
    \u0441 \u0438\u0434\u0435\u044f\u043c\u0438 \u041a\u0430\u043d\u0442\u0430 \u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u043e
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u0438\u0437\u043c \u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u0434\u0435\u0431\u0430\u0442\u044b \u043e \u043d\u0430\u0443\u0447\u043d\u043e\u043c \u0440\u0435\u0430\u043b\u0438\u0437\u043c\u0435.\n\n\u270d\ufe0f
    \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0440\u0443\u0434\u044b \u0420\u0430\u0441\u0441\u0435\u043b \u0431\u044b\u043b \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c, \u043d\u043e \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0434\u0435\u044f\u0442\u0435\u043b\u0435\u043c.
    \u0417\u0430 \u044d\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043d \u0431\u044b\u043b
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u043f\u043e \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435
    \u0432 1950 \u0433\u043e\u0434\u0443. \u00ab\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0437\u0430\u043f\u0430\u0434\u043d\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb (1945): \u042d\u0442\u0430
    \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u0420\u0430\u0441\u0441\u0435\u043b\u0443
    \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u0443\u044e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0441\u0442\u0430\u043b\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445
    \u0432 XX \u0432\u0435\u043a\u0435. \u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u043a\u0440\u0438\u0442\u0438\u043a\u0430: \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0440\u0430\u0431\u043e\u0442 \u043d\u0430
    \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0442\u0435\u043c\u044b: \u043e
    \u0431\u0440\u0430\u043a\u0435 \u0438 \u043c\u043e\u0440\u0430\u043b\u0438 (\u00ab\u0411\u0440\u0430\u043a
    \u0438 \u043c\u043e\u0440\u0430\u043b\u044c\u00bb, 1929), \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438,
    \u0440\u0435\u043b\u0438\u0433\u0438\u0438 (\u00ab\u041f\u043e\u0447\u0435\u043c\u0443 \u044f
    \u043d\u0435 \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0438\u043d\u00bb, 1927),
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0432\u043b\u0430\u0441\u0442\u0438
    (\u00ab\u0412\u043b\u0430\u0441\u0442\u044c\u00bb, 1938) \u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u0435.
    \u00ab\u0410\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u00bb
    (1967\u20131969): \u0412 \u0442\u0440\u0451\u0445 \u0442\u043e\u043c\u0430\u0445, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0432 \u043a\u043e\u043d\u0446\u0435 \u0436\u0438\u0437\u043d\u0438, \u0420\u0430\u0441\u0441\u0435\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u044e
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c,
    \u043d\u043e \u0438 \u0434\u0430\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u0430\u043c\u043e\u0430\u043d\u0430\u043b\u0438\u0437 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f."
  achievementsEn: 
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0430 \u0420\u0430\u0441\u0441\u0435\u043b\u0430
    \u2014 \u044d\u0442\u043e \u043f\u043e\u0447\u0442\u0438 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0435,
    \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u043e\u0435 \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0432\u0437\u043b\u0435\u0442\u0430\u043c\u0438, \u0431\u0443\u0440\u043d\u044b\u043c\u0438
    \u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0434\u0440\u0430\u043c\u0430\u043c\u0438 \u0438
    \u0431\u0435\u0441\u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043d\u043e\u0439
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0431\u043e\u0440\u044c\u0431\u043e\u0439.
    \u041f\u0443\u0442\u044c \u043e\u0442 \u043e\u0434\u0438\u043d\u043e\u043a\u043e\u0433\u043e
    \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0430 \u0434\u043e \u0441\u043e\u0432\u0435\u0441\u0442\u0438
    \u0437\u0430\u043f\u0430\u0434\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430 \u0431\u044b\u043b
    \u0442\u0435\u0440\u043d\u0438\u0441\u0442 \u0438 \u043f\u043e\u043b\u043e\u043d \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432.\n\n\U0001F4DC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b, \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0411\u0435\u0440\u0442\u0440\u0430\u043d \u0410\u0440\u0442\u0443\u0440
    \u0423\u0438\u043b\u044c\u044f\u043c \u0420\u0430\u0441\u0441\u0435\u043b \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    18 \u043c\u0430\u044f 1872 \u0433\u043e\u0434\u0430 \u0432 \u0420\u0435\u0439\u0432\u0435\u043d\u0441\u043a\u0440\u043e\u0444\u0442\u0435,
    \u0423\u044d\u043b\u044c\u0441, \u0432 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u043c\u0435\u0439 \u0411\u0440\u0438\u0442\u0430\u043d\u0438\u0438. \u0415\u0433\u043e
    \u0434\u0435\u0434, \u043b\u043e\u0440\u0434 \u0414\u0436\u043e\u043d \u0420\u0430\u0441\u0441\u0435\u043b,
    \u0434\u0432\u0430\u0436\u0434\u044b \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u043f\u043e\u0441\u0442
    \u043f\u0440\u0435\u043c\u044c\u0435\u0440-\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430.
    \u041e\u0442\u0435\u0446, \u0432\u0438\u043a\u043e\u043d\u0442 \u042d\u043c\u0431\u0435\u0440\u043b\u0438,
    \u0438 \u043c\u0430\u0442\u044c, \u041a\u044d\u0442\u0440\u0438\u043d \u041b\u0443\u0438\u0437\u0430,
    \u0431\u044b\u043b\u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445
    \u0434\u043b\u044f \u0432\u0438\u043a\u0442\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0439
    \u044d\u043f\u043e\u0445\u0438 \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432, \u0447\u0442\u043e
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043e\u0442\u0440\u0430\u0437\u0438\u043b\u043e\u0441\u044c
    \u0438 \u043d\u0430 \u0441\u0443\u0434\u044c\u0431\u0435 \u0441\u044b\u043d\u0430. \u0421\u0447\u0430\u0441\u0442\u044c\u0435
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0431\u044b\u043b\u043e \u043d\u0435\u0434\u043e\u043b\u0433\u0438\u043c.
    \u0412 1874 \u0433\u043e\u0434\u0443 \u043e\u0442 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438
    \u0443\u043c\u0435\u0440\u043b\u0438 \u043c\u0430\u0442\u044c \u0438 \u0441\u0442\u0430\u0440\u0448\u0430\u044f
    \u0441\u0435\u0441\u0442\u0440\u0430 \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0430, \u0430
    \u0432 1876 \u0433\u043e\u0434\u0443 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0438 \u043e\u0442\u0435\u0446. \u041e\u0441\u0438\u0440\u043e\u0442\u0435\u0432 \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0447\u0435\u0442\u044b\u0440\u0435\u0445
    \u043b\u0435\u0442, \u0411\u0435\u0440\u0442\u0440\u0430\u043d \u0438 \u0435\u0433\u043e
    \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0431\u0440\u0430\u0442 \u0424\u0440\u044d\u043d\u043a
    \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u0432 \u0446\u0435\u043d\u0442\u0440\u0435
    \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u0440\u0430. \u0418\u0445
    \u043e\u0442\u0435\u0446 \u0432 \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b
    \u043e\u043f\u0435\u043a\u0443\u043d\u0430\u043c\u0438 \u0434\u0432\u0443\u0445 \u0430\u0442\u0435\u0438\u0441\u0442\u043e\u0432,
    \u0447\u0442\u043e \u043f\u043e \u0442\u0435\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0430\u043c
    \u0431\u044b\u043b\u043e \u043d\u0435\u043c\u044b\u0441\u043b\u0438\u043c\u043e. \u0412\u043b\u0430\u0441\u0442\u0438
    \u043e\u0441\u043f\u043e\u0440\u0438\u043b\u0438 \u0432\u043e\u043b\u044e, \u0438 \u0431\u0430\u0431\u0443\u0448\u043a\u0430,
    \u0433\u0440\u0430\u0444\u0438\u043d\u044f \u0420\u0430\u0441\u0441\u0435\u043b, \u0434\u043e\u0431\u0438\u043b\u0430\u0441\u044c
    \u043e\u043f\u0435\u043a\u0438 \u043d\u0430\u0434 \u0432\u043d\u0443\u043a\u0430\u043c\u0438.
    \u041e\u043d\u0430 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0430 \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0430
    \u0432 \u0441\u0442\u0440\u043e\u0433\u043e\u0439 \u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0439
    \u043c\u043e\u0440\u0430\u043b\u0438, \u043f\u043e\u0441\u0435\u043b\u0438\u0432 \u0435\u0433\u043e
    \u0432 \u041f\u0435\u043c\u0431\u0440\u043e\u043a-\u041b\u043e\u0434\u0436 \u0432 \u0420\u0438\u0447\u043c\u043e\u043d\u0434-\u043f\u0430\u0440\u043a\u0435.
    \u041e\u0434\u0438\u043d\u043e\u043a\u043e\u0435 \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0432 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u043e\u0442 \u0441\u0432\u0435\u0440\u0441\u0442\u043d\u0438\u043a\u043e\u0432
    \u043d\u0430\u043b\u043e\u0436\u0438\u043b\u043e \u043e\u0442\u043f\u0435\u0447\u0430\u0442\u043e\u043a
    \u043d\u0430 \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440; \u043f\u043e\u0437\u0436\u0435
    \u043e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0441\u044f, \u0447\u0442\u043e
    \u0432 \u044e\u043d\u043e\u0441\u0442\u0438 \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u043e
    \u043f\u043e\u0441\u0435\u0449\u0430\u043b\u0438 \u043c\u044b\u0441\u043b\u0438 \u043e \u0441\u0430\u043c\u043e\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0435.
    \u0421\u043f\u0430\u0441\u0435\u043d\u0438\u0435\u043c \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u0441\u0442\u0430\u043b\u0438 \u043a\u043d\u0438\u0433\u0438 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.
    \u0412 11 \u043b\u0435\u0442 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e
    \u0441 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u043e\u043d \u0441\u0440\u0430\u0432\u043d\u0438\u043b \u0441 \"\u043f\u0435\u0440\u0432\u043e\u0439
    \u043b\u044e\u0431\u043e\u0432\u044c\u044e\" \u2014 \u044d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u043b\u043e
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043c\u0438\u0440 \u0431\u0435\u0441\u0441\u043f\u043e\u0440\u043d\u044b\u0445
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u0438\u043d.\n\n\U0001F393
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043f\u0435\u0440\u0432\u044b\u0435
    \u0448\u0430\u0433\u0438 \u0432 \u043d\u0430\u0443\u043a\u0435 \u0412 1890 \u0433\u043e\u0434\u0443
    \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u0433\u0434\u0435
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0441\u0435\u0431\u044f. \u0412 1893 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0432\u044b\u0441\u0448\u0438\u0439 \u0431\u0430\u043b\u043b \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0430 \u0432 1894 \u0433\u043e\u0434\u0443 \u2014 \u043f\u043e \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c (\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438).
    \u0412 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 \u043e\u043d \u0432\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u044d\u043b\u0438\u0442\u043d\u043e\u0435 \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u043e\u043d\u043d\u043e\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \"\u0410\u043f\u043e\u0441\u0442\u043e\u043b\u044b\",
    \u0433\u0434\u0435 \u0437\u0430\u0432\u044f\u0437\u0430\u043b\u0438\u0441\u044c \u0435\u0433\u043e
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0435
    \u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u0432\u044f\u0437\u0438 \u0441 \u0414\u0436\u043e\u0440\u0434\u0436\u0435\u043c \u041c\u0443\u0440\u043e\u043c
    \u0438 \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u043e\u043c \u041d\u043e\u0440\u0442\u043e\u043c
    \u0423\u0430\u0439\u0442\u0445\u0435\u0434\u043e\u043c. \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u043e\u0439
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439
    \u0441\u0442\u0430\u043b\u0430 \u043a\u043d\u0438\u0433\u0430 \"\u0413\u0435\u0440\u043c\u0430\u043d\u0441\u043a\u0430\u044f
    \u0441\u043e\u0446\u0438\u0430\u043b-\u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u044f\"
    (1896), \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u043f\u043e\u0435\u0437\u0434\u043a\u0435
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d. \u0412 1895 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e
    \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435,
    \u0437\u0430\u0449\u0438\u0442\u0438\u0432 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.\n\n\U0001F494 \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u0431\u0443\u0440\u043d\u044b\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0420\u0430\u0441\u0441\u0435\u043b\u0430
    \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c \u0436\u0435 \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0438 \u043d\u0435\u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439,
    \u043a\u0430\u043a \u0438 \u0435\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u044b.
    \u041f\u0435\u0440\u0432\u044b\u0439 \u0431\u0440\u0430\u043a \u0441 \u042d\u043b\u0438\u0441:
    \u0412 \u0434\u0435\u043a\u0430\u0431\u0440\u0435 1894 \u0433\u043e\u0434\u0430 \u043e\u043d
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0439
    \u043a\u0432\u0430\u043a\u0435\u0440\u0448\u0435 \u042d\u043b\u0438\u0441 \u041f\u0438\u0440\u0441\u043e\u043b\u043b
    \u0421\u043c\u0438\u0442, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u044b\u043b
    \u0437\u043d\u0430\u043a\u043e\u043c \u0441 17 \u043b\u0435\u0442. \u042d\u0442\u043e\u0442
    \u0431\u0440\u0430\u043a \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0441\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e
    \u0434\u043e 1921 \u0433\u043e\u0434\u0430, \u043e\u0434\u043d\u0430\u043a\u043e \u0432
    1901 \u0433\u043e\u0434\u0443 \u0420\u0430\u0441\u0441\u0435\u043b \u043e\u0441\u043e\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043b\u044e\u0431\u0438\u0442
    \u0436\u0435\u043d\u0443. \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0447\u0442\u043e \u0440\u0430\u0437\u0440\u044b\u0432 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u0432 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d,
    \u043a\u0430\u0442\u0430\u044f\u0441\u044c \u043d\u0430 \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0435,
    \u0432\u0434\u0440\u0443\u0433 \u043f\u043e\u043d\u044f\u043b \u044d\u0442\u043e. \u041e\u043d\u0438
    \u0440\u0430\u0437\u0432\u0435\u043b\u0438\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 1921 \u0433\u043e\u0434\u0443, \u0447\u0442\u043e\u0431\u044b \u0420\u0430\u0441\u0441\u0435\u043b
    \u043c\u043e\u0433 \u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0414\u043e\u0440\u0435
    \u0411\u043b\u044d\u043a. \u0412\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a
    \u0441 \u0414\u043e\u0440\u043e\u0439 \u0438 \u0448\u043a\u043e\u043b\u0430 \"\u0411\u0438\u043a\u043e\u043d-\u0425\u0438\u043b\u043b\":
    \u0414\u043e\u0440\u0430 \u0411\u043b\u044d\u043a \u0431\u044b\u043b\u0430 \u0435\u0433\u043e
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439
    \u0438 \u0441\u043e\u0440\u0430\u0442\u043d\u0438\u0446\u0435\u0439. \u041f\u043e\u0436\u0435\u043d\u0438\u0432\u0448\u0438\u0441\u044c
    \u0432 1921 \u0433\u043e\u0434\u0443, \u043e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \"\u0411\u0438\u043a\u043e\u043d-\u0425\u0438\u043b\u043b\"
    \u0432 1927 \u0433\u043e\u0434\u0443, \u0433\u0434\u0435 \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c
    \u0432\u043e\u043f\u043b\u043e\u0442\u0438\u0442\u044c \u0441\u0432\u043e\u0438 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u0430\u043b\u044b. \u0412 \u044d\u0442\u043e\u043c \u0431\u0440\u0430\u043a\u0435
    \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0434\u0432\u043e\u0435 \u0434\u0435\u0442\u0435\u0439:
    \u0414\u0436\u043e\u043d \u041a\u043e\u043d\u0440\u0430\u0434 (1921) \u0438 \u041a\u044d\u0442\u0440\u0438\u043d
    \u0414\u0436\u0435\u0439\u043d (1923). \u041e\u0434\u043d\u0430\u043a\u043e \u0431\u0440\u0430\u043a
    \u0440\u0430\u0441\u043f\u0430\u043b\u0441\u044f \u0432 1935 \u0433\u043e\u0434\u0443. \u0422\u0440\u0435\u0442\u0438\u0439
    \u0431\u0440\u0430\u043a \u0441 \u041f\u0430\u0442\u0440\u0438\u0446\u0438\u0435\u0439:
    \u0412 1936 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041f\u0430\u0442\u0440\u0438\u0446\u0438\u0438 \"\u041f\u0438\u0442\u0435\u0440\"
    \u0421\u043f\u0435\u043d\u0441, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u043e\u0434\u0438\u043b\u0430
    \u0435\u043c\u0443 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0441\u044b\u043d\u0430,
    \u041a\u043e\u043d\u0440\u0430\u0434\u0430 \u0421\u0435\u0431\u0430\u0441\u0442\u044c\u044f\u043d\u0430
    \u0420\u043e\u0431\u0435\u0440\u0442\u0430. \u042d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a
    \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0441\u044f
    \u0440\u0430\u0437\u0432\u043e\u0434\u043e\u043c \u0432 1952 \u0433\u043e\u0434\u0443. \u0427\u0435\u0442\u0432\u0435\u0440\u0442\u044b\u0439
    \u0431\u0440\u0430\u043a \u0441 \u042d\u0434\u0438\u0442: \u0412 1952 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 80 \u043b\u0435\u0442, \u0420\u0430\u0441\u0441\u0435\u043b
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044b\u0439
    \u0440\u0430\u0437 \u2014 \u043d\u0430 \u042d\u0434\u0438\u0442 \u0424\u0438\u043d\u0447.
    \u042d\u0442\u043e\u0442 \u0441\u043e\u044e\u0437 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c \u0438 \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0441\u044f
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u043c
    \u0441\u044b\u043d\u043e\u043c \u0414\u0436\u043e\u043d\u043e\u043c \u0441\u0442\u0430\u043b\u0438
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.
    \u0420\u0430\u0441\u0441\u0435\u043b \u0432\u043e\u0437\u043b\u0430\u0433\u0430\u043b \u043d\u0430
    \u043d\u0435\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043d\u0430\u0434\u0435\u0436\u0434\u044b,
    \u043d\u043e \u0443 \u0414\u0436\u043e\u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u043b\u0430\u0441\u044c
    \u0448\u0438\u0437\u043e\u0444\u0440\u0435\u043d\u0438\u044f, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0434\u043b\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430 \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c.\n\n\U0001F9D1\u200d\U0001F3EB \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430, \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u044b
    \u0438 \u043f\u043e\u0435\u0437\u0434\u043a\u0438 \u0420\u0430\u0441\u0441\u0435\u043b \u043d\u0435\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e
    \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u0432 \u0446\u0435\u043d\u0442\u0440\u0435
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0442\u043e\u0438\u043b\u0438 \u0435\u043c\u0443 \u043c\u0435\u0441\u0442\u0430 \u0432
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445 \u0443\u0447\u0435\u0431\u043d\u044b\u0445
    \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u0445. \u0423\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u0435
    \u0438\u0437 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430:
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0420\u0430\u0441\u0441\u0435\u043b, \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u0439
    \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442, \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b \u043f\u0440\u043e\u0442\u0438\u0432 \u043f\u0440\u0438\u0437\u044b\u0432\u0430.
    \u0412 1916 \u0433\u043e\u0434\u0443 \u0437\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e
    \u0430\u043d\u0442\u0438\u0432\u043e\u0435\u043d\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432
    \u043e\u043d \u0431\u044b\u043b \u043e\u0448\u0442\u0440\u0430\u0444\u043e\u0432\u0430\u043d
    \u0438 \u0443\u0432\u043e\u043b\u0435\u043d \u0438\u0437 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430.
    \u0422\u044e\u0440\u0435\u043c\u043d\u043e\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435:
    \u0412 1918 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u0435\u043d
    \u043a \u0448\u0435\u0441\u0442\u0438 \u043c\u0435\u0441\u044f\u0446\u0430\u043c \u0442\u044e\u0440\u044c\u043c\u044b
    \u0437\u0430 \u0441\u0442\u0430\u0442\u044c\u044e, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439,
    \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e \u0432\u043b\u0430\u0441\u0442\u0435\u0439,
    \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u044f\u043b \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0443\u044e
    \u0430\u0440\u043c\u0438\u044e. \u0421\u0432\u043e\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435
    \u043e\u043d \u0441 \u043f\u043e\u043b\u044c\u0437\u043e\u0439 \u043f\u0440\u043e\u0432\u0435\u043b,
    \u043d\u0430\u043f\u0438\u0441\u0430\u0432 \u043a\u043d\u0438\u0433\u0443 \"\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e\". \u041f\u043e\u0435\u0437\u0434\u043a\u0430
    \u0432 \u0420\u043e\u0441\u0441\u0438\u044e \u0438 \u041a\u0438\u0442\u0430\u0439: \u0412
    1920 \u0433\u043e\u0434\u0443 \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u043e\u0441\u0435\u0442\u0438\u043b
    \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u0443\u044e \u0420\u043e\u0441\u0441\u0438\u044e
    \u0432 \u0441\u043e\u0441\u0442\u0430\u0432\u0435 \u0434\u0435\u043b\u0435\u0433\u0430\u0446\u0438\u0438,
    \u0433\u0434\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b\u0441\u044f \u0441 \u041b\u0435\u043d\u0438\u043d\u044b\u043c
    \u0438 \u0422\u0440\u043e\u0446\u043a\u0438\u043c. \u0423\u0432\u0438\u0434\u0435\u043d\u043d\u043e\u0435
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u0435\u0433\u043e \u043a \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u043c\u0443
    \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u044e \u0432 \u0431\u043e\u043b\u044c\u0448\u0435\u0432\u0438\u0437\u043c\u0435,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0441\u0440\u0430\u0432\u043d\u0438\u043b
    \u0441 \u043d\u043e\u0432\u043e\u0439 \u0440\u0435\u043b\u0438\u0433\u0438\u0435\u0439.
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u041a\u0438\u0442\u0430\u0439, \u0433\u0434\u0435 \u043f\u043e\u0447\u0442\u0438
    \u0433\u043e\u0434 \u0447\u0438\u0442\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438 \u0432
    \u041f\u0435\u043a\u0438\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u044d\u0442\u043e\u0439 \u043f\u043e\u0435\u0437\u0434\u043a\u0438
    \u043e\u043d \u0442\u044f\u0436\u0435\u043b\u043e \u043f\u0435\u0440\u0435\u0431\u043e\u043b\u0435\u043b
    \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0435\u0439. \u0421\u043a\u0430\u043d\u0434\u0430\u043b
    \u0432 \u0421\u0428\u0410: \u0412 \u043a\u043e\u043d\u0446\u0435 1930-\u0445 \u2014 \u043d\u0430\u0447\u0430\u043b\u0435
    1940-\u0445 \u0433\u043e\u0434\u043e\u0432 \u0420\u0430\u0441\u0441\u0435\u043b \u0447\u0438\u0442\u0430\u043b
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445
    \u0427\u0438\u043a\u0430\u0433\u043e \u0438 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0438.
    \u0412 1940 \u0433\u043e\u0434\u0443 \u0435\u0433\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0432 \u0421\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0430 \u0431\u044b\u043b\u043e \u0430\u043d\u043d\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043e
    \u043f\u043e\u0441\u043b\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u043e\u0432 \u0438\u0437-\u0437\u0430 \u0435\u0433\u043e
    \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432
    \u043d\u0430 \u043c\u043e\u0440\u0430\u043b\u044c \u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u044e.\n\n\U0001F468\u200d\U0001F52C
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u0420\u0430\u0441\u0441\u0435\u043b \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c\u0438 \u0443\u043c\u0430\u043c\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0438
    \u044d\u0442\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0447\u0430\u0441\u0442\u043e
    \u0431\u044b\u043b\u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438 \u0438 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c\u0438.
    \u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441
    \u0423\u0430\u0439\u0442\u0445\u0435\u0434\u043e\u043c: \u0418\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434 \"Principia Mathematica\" (1910-1913)
    \u0441\u0442\u0430\u043b\u0430 \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439 \u0438\u0445
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0430. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043f\u043e\u0437\u0436\u0435 \u0438\u0445 \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u0440\u0430\u0437\u043e\u0448\u043b\u0438\u0441\u044c.
    \u0414\u0440\u0443\u0436\u0431\u0430 \u0438 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u0412\u0438\u0442\u0433\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c: \u0420\u0430\u0441\u0441\u0435\u043b
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u041b\u044e\u0434\u0432\u0438\u0433\u0430
    \u0412\u0438\u0442\u0433\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0438\u0435\u0445\u0430\u043b \u043a \u043d\u0435\u043c\u0443 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436
    \u0432 1911 \u0433\u043e\u0434\u0443. \u0418\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u0431\u0443\u0440\u043d\u044b\u043c\u0438: \u0420\u0430\u0441\u0441\u0435\u043b
    \u0432\u0438\u0434\u0435\u043b \u0432 \u0412\u0438\u0442\u0433\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u0435
    \u0433\u0435\u043d\u0438\u044f, \u043d\u043e \u0442\u043e\u0442 \u0447\u0430\u0441\u0442\u043e
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b \u0438 \u043e\u0441\u043f\u0430\u0440\u0438\u0432\u0430\u043b
    \u0438\u0434\u0435\u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u044f. \u0418\u0445 \u0432\u0437\u0433\u043b\u044f\u0434\u044b
    \u043d\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e \u0432 \u0438\u0442\u043e\u0433\u0435
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0437\u043e\u0448\u043b\u0438\u0441\u044c.
    \u0414\u0438\u0430\u043b\u043e\u0433 \u0441 \u0424\u0440\u0435\u0433\u0435: \u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u043b\u043e\u0433\u0438\u0446\u0438\u0437\u043c\u0430
    \u0443\u0436\u0435 \u0432\u044b\u0441\u043a\u0430\u0437\u0430\u043d\u044b \u0413\u043e\u0442\u043b\u043e\u0431\u043e\u043c
    \u0424\u0440\u0435\u0433\u0435, \u0420\u0430\u0441\u0441\u0435\u043b \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e
    \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0441 \u043d\u0438\u043c \u0432 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443.
    \u0415\u0433\u043e \u043f\u0438\u0441\u044c\u043c\u043e \u0424\u0440\u0435\u0433\u0435 \u0441
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435\u043c \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0438\u043c\u0435\u043d\u0435\u043c \u0420\u0430\u0441\u0441\u0435\u043b\u0430, \u0441\u0442\u0430\u043b\u043e
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c. \u0424\u0440\u0435\u0433\u0435
    \u0441 \u0433\u043e\u0440\u0435\u0447\u044c\u044e \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \"\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u043f\u043e\u0448\u0430\u0442\u043d\u0443\u043b\u0430\u0441\u044c\".
    \u0418\u0434\u0435\u0439\u043d\u044b\u0435 \u0441\u043f\u043e\u0440\u044b: \u041e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u0432\u0435\u043b \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0435
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435 \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0438
    \u0441 \u041c\u0443\u0440\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0432\u043e\u0438\u043c \u0438\u0434\u0435\u0439\u043d\u044b\u043c
    \u0441\u043e\u0440\u0430\u0442\u043d\u0438\u043a\u043e\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0441 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u043c\u0438 \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0441\u0442\u0430\u043c\u0438,
    \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0423\u0438\u043b\u044c\u044f\u043c
    \u0414\u0436\u0435\u0439\u043c\u0441 \u0438 \u0414\u0436\u043e\u043d \u0414\u044c\u044e\u0438.\n\n\U0001F54A\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u041f\u043e\u0441\u043b\u0435 \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0420\u0430\u0441\u0441\u0435\u043b \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0433\u043e\u043b\u043e\u0441\u043e\u0432,
    \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u044f \u0437\u0430 \u044f\u0434\u0435\u0440\u043d\u043e\u0435
    \u0440\u0430\u0437\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0438 \u043c\u0438\u0440
    \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435. \u0412 1949 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d \u041e\u0440\u0434\u0435\u043d\u043e\u043c
    \u0417\u0430\u0441\u043b\u0443\u0433, \u0430 \u0432 1950 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    \u043f\u043e \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435. \u0412 1955 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442
    \u0420\u0430\u0441\u0441\u0435\u043b\u0430\u2014\u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430,
    \u0430 \u0432 1958 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041a\u0430\u043c\u043f\u0430\u043d\u0438\u0438 \u0437\u0430 \u044f\u0434\u0435\u0440\u043d\u043e\u0435
    \u0440\u0430\u0437\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0435. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    89 \u043b\u0435\u0442, \u0432 1961 \u0433\u043e\u0434\u0443, \u043e\u043d \u0441\u043d\u043e\u0432\u0430
    \u043f\u0440\u043e\u0432\u0435\u043b \u043d\u0435\u0434\u0435\u043b\u044e \u0432 \u0442\u044e\u0440\u044c\u043c\u0435
    \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0430\u043d\u0442\u0438\u0432\u043e\u0435\u043d\u043d\u043e\u0439
    \u0430\u043a\u0446\u0438\u0438. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u043f\u0440\u0435\u043a\u043b\u043e\u043d\u043d\u044b\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442,
    \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u0412 1967 \u0433\u043e\u0434\u0443
    \u043d\u0430\u0447\u0430\u043b \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e
    \u0442\u0440\u0435\u0445\u0442\u043e\u043c\u043d\u043e\u0439 \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.
    \u0411\u0435\u0440\u0442\u0440\u0430\u043d \u0420\u0430\u0441\u0441\u0435\u043b \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0433\u0440\u0438\u043f\u043f\u0430 2 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1970 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0432\u043e\u0435\u043c \u0434\u043e\u043c\u0435
    \u0432 \u0423\u044d\u043b\u044c\u0441\u0435, \u043d\u0435 \u0434\u043e\u0436\u0438\u0432
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043c\u0435\u0441\u044f\u0446\u0435\u0432
    \u0434\u043e \u0441\u0432\u043e\u0435\u0433\u043e 98-\u043b\u0435\u0442\u0438\u044f."
  personalLifeEn: 
  shortBioRu: "\u0411\u0435\u0440\u0442\u0440\u0430\u043d \u0420\u0430\u0441\u0441\u0435\u043b (1872\u20131970)
    \u043f\u0440\u043e\u0436\u0438\u043b \u043f\u043e\u0447\u0442\u0438 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0435,
    \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u043e\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u043c\u0438 \u0432 \u043b\u043e\u0433\u0438\u043a\u0435
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438, \u0431\u0443\u0440\u043d\u044b\u043c\u0438
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u044f\u043c\u0438
    \u0438 \u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0434\u0440\u0430\u043c\u0430\u043c\u0438.
    \u041e\u0434\u0438\u043d \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438,
    \u043e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c \u043c\u044b\u0441\u043b\u0438\u0442\u0435\u043b\u0435\u043c,
    \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u044b\u043c \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0434\u0435\u044f\u0442\u0435\u043b\u0435\u043c, \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c
    \u0441\u0430\u043c\u044b\u0445 \u0431\u0443\u0440\u043d\u044b\u0445 \u0441\u043e\u0431\u044b\u0442\u0438\u0439
    XX \u0432\u0435\u043a\u0430. \u0415\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0432\u043e\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043e\u0442 \u0432\u0438\u043a\u0442\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0439
    \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0438 \u043a \u0440\u043e\u043b\u0438
    \u0441\u043e\u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u043f\u0430\u0434\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0420\u0430\u0441\u0441\u0435\u043b
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 18 \u043c\u0430\u044f 1872 \u0433\u043e\u0434\u0430
    \u0432 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435 \u0432 \u0423\u044d\u043b\u044c\u0441\u0435. \u0415\u0433\u043e
    \u0434\u0435\u0434, \u043b\u043e\u0440\u0434 \u0414\u0436\u043e\u043d \u0420\u0430\u0441\u0441\u0435\u043b,
    \u0434\u0432\u0430\u0436\u0434\u044b \u0431\u044b\u043b \u043f\u0440\u0435\u043c\u044c\u0435\u0440-\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u043e\u043c
    \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u0438. \u0415\u0433\u043e
    \u043a\u0440\u0451\u0441\u0442\u043d\u044b\u043c \u043e\u0442\u0446\u043e\u043c \u0431\u044b\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444
    \u0414\u0436\u043e\u043d \u0421\u0442\u044e\u0430\u0440\u0442 \u041c\u0438\u043b\u043b\u044c,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438
    \u043d\u0430 \u043d\u0435\u0433\u043e \u0432 \u044e\u043d\u043e\u0441\u0442\u0438. \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0420\u0430\u0441\u0441\u0435\u043b\u0430 \u0431\u044b\u043b\u0438
    \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u044b \u0447\u0435\u0440\u0435\u0434\u043e\u0439
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0439: \u0432 1874 \u0433\u043e\u0434\u0443 \u043e\u0442
    \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438 \u0443\u043c\u0435\u0440\u043b\u0438 \u0435\u0433\u043e
    \u043c\u0430\u0442\u044c \u0438 \u0441\u0435\u0441\u0442\u0440\u0430, \u0430 \u0447\u0435\u0440\u0435\u0437
    \u0434\u0432\u0430 \u0433\u043e\u0434\u0430, \u0432 1876-\u043c, \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u043e\u0442\u0435\u0446. \u041e\u0441\u0438\u0440\u043e\u0442\u0435\u0432 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u0447\u0435\u0442\u044b\u0440\u0451\u0445 \u043b\u0435\u0442, \u0411\u0435\u0440\u0442\u0440\u0430\u043d
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u043c
    \u0431\u0440\u0430\u0442\u043e\u043c \u0424\u0440\u044d\u043d\u043a\u043e\u043c \u0431\u044b\u043b
    \u043e\u0442\u0434\u0430\u043d \u043d\u0430 \u043f\u043e\u043f\u0435\u0447\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0435\u0439 \u0431\u0430\u0431\u0443\u0448\u043a\u0435, \u043b\u0435\u0434\u0438
    \u0420\u0430\u0441\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043c\u043e\u0433\u043b\u0430
    \u043e\u0441\u043f\u043e\u0440\u0438\u0442\u044c \u0432\u043e\u043b\u044e \u043e\u0442\u0446\u0430,
    \u0436\u0435\u043b\u0430\u0432\u0448\u0435\u0433\u043e \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0442\u044c
    \u0441\u044b\u043d\u0430 \u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u043e\u043c. \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0435\u0433\u043e \u043f\u0440\u043e\u0448\u043b\u043e \u0432 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438
    \u043e\u0442 \u0441\u0432\u0435\u0440\u0441\u0442\u043d\u0438\u043a\u043e\u0432, \u0438
    \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u0437\u0430 \u043a\u043d\u0438\u0433\u0430\u043c\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u043e\u0433\u0434\u0430, \u0432 11 \u043b\u0435\u0442,
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e
    \u043d\u0430 \u043d\u0435\u0433\u043e \u043d\u0435\u0438\u0437\u0433\u043b\u0430\u0434\u0438\u043c\u043e\u0435
    \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435, \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u0432
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u0442\u043e\u0447\u043d\u043e\u043c\u0443
    \u0437\u043d\u0430\u043d\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u043f\u0440\u043e\u043d\u0451\u0441 \u0447\u0435\u0440\u0435\u0437 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0435
    \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0412 1890 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u0441\u043b\u0435 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0433\u043e \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f,
    \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u041e\u043d \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0435\u0433\u043e, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u0432\u044b\u0441\u0448\u0438\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 (1893), \u0430
    \u0437\u0430\u0442\u0435\u043c \u043f\u043e \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c (\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f)
    \u0432 1894 \u0433\u043e\u0434\u0443. \u0412 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435
    \u043e\u043d \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0442\u0430\u0439\u043d\u043e\u0435
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u00ab\u0410\u043f\u043e\u0441\u0442\u043e\u043b\u044b\u00bb,
    \u0433\u0434\u0435 \u0437\u0430\u0432\u044f\u0437\u0430\u043b \u0434\u0440\u0443\u0436\u0431\u0443
    \u0441 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c \u0414\u0436\u043e\u0440\u0434\u0436\u0435\u043c
    \u041c\u0443\u0440\u043e\u043c \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u043e\u043c \u0423\u0430\u0439\u0442\u0445\u0435\u0434\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u044b\u0433\u0440\u0430\u043b\u0438 \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u0438. \u0412 \u0434\u0435\u043a\u0430\u0431\u0440\u0435
    1894 \u0433\u043e\u0434\u0430 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430
    \u0410\u043b\u0438\u0441 \u041f\u0438\u0440\u0441\u043e\u043b\u043b \u0421\u043c\u0438\u0442,
    \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0439 \u043a\u0432\u0430\u043a\u0435\u0440\u0448\u0435.
    \u041c\u043e\u043b\u043e\u0434\u043e\u0436\u0451\u043d\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0438\u0441\u044c
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d, \u0433\u0434\u0435 \u0420\u0430\u0441\u0441\u0435\u043b
    \u0438\u0437\u0443\u0447\u0430\u043b \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0443. \u0415\u0433\u043e \u0440\u0430\u043d\u043d\u0438\u0435
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435 \u0432\u0437\u0433\u043b\u044f\u0434\u044b
    \u0431\u044b\u043b\u0438 \u0431\u043b\u0438\u0437\u043a\u0438 \u043a \u043d\u0435\u043e\u0433\u0435\u0433\u0435\u043b\u044c\u044f\u043d\u0441\u0442\u0432\u0443,
    \u0438 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u0430\u044f \u043a\u043d\u0438\u0433\u0430
    \u00ab\u041e\u0447\u0435\u0440\u043a \u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f\u0445
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb (1897) \u0431\u044b\u043b\u0430
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0430 \u0432 \u044d\u0442\u043e\u043c \u0434\u0443\u0445\u0435.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c
    \u0441\u0442\u0430\u043b 1898 \u0433\u043e\u0434, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u0434
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u041c\u0443\u0440\u0430 \u0420\u0430\u0441\u0441\u0435\u043b
    \u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0440\u0432\u0430\u043b
    \u0441 \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u043c\u043e\u043c \u041a\u0430\u043d\u0442\u0430
    \u0438 \u0413\u0435\u0433\u0435\u043b\u044f, \u043f\u0435\u0440\u0435\u0439\u0434\u044f
    \u043d\u0430 \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u0440\u0435\u0430\u043b\u0438\u0437\u043c\u0430
    \u0438 \u044d\u043c\u043f\u0438\u0440\u0438\u0437\u043c\u0430. \u041e\u043d \u043f\u0440\u0438\u0448\u0451\u043b
    \u043a \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044e, \u0447\u0442\u043e \u043c\u0435\u0442\u043e\u0434\u043e\u043c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0434\u043e\u043b\u0436\u0435\u043d
    \u0431\u044b\u0442\u044c \u0430\u043d\u0430\u043b\u0438\u0437, \u0430 \u043d\u0435 \u0441\u0438\u043d\u0442\u0435\u0437.
    \u041b\u043e\u0433\u0438\u043a\u0430 \u0438 \u00abPrincipia Mathematica\u00bb \u0412\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u0451\u043d\u043d\u044b\u0439
    \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435
    \u041f\u0435\u0430\u043d\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b \u043d\u0430 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u0432 1900 \u0433\u043e\u0434\u0443, \u0420\u0430\u0441\u0441\u0435\u043b
    \u043d\u0430\u0447\u0430\u043b \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u044b\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u044e \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u0443\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u043b\u043e\u0433\u0438\u0446\u0438\u0437\u043c\u0430
    \u2014 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0432\u0441\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043a \u043b\u043e\u0433\u0438\u043a\u0435. \u0412 1903 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u00ab\u041f\u0440\u0438\u043d\u0446\u0438\u043f\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb, \u0433\u0434\u0435 \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u044d\u0442\u0443 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0432 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u043d\u0430\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u043e\u043d \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0420\u0430\u0441\u0441\u0435\u043b\u0430.
    \u0421\u0443\u0442\u044c \u0435\u0433\u043e \u0432 \u0432\u043e\u043f\u0440\u043e\u0441\u0435:
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u043b\u0438 \u043a\u043b\u0430\u0441\u0441
    \u0432\u0441\u0435\u0445 \u043a\u043b\u0430\u0441\u0441\u043e\u0432, \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0449\u0438\u0445\u0441\u044f
    \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u0441\u0430\u043c\u0438\u0445 \u0441\u0435\u0431\u044f,
    \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0435\u0431\u0435? \u041b\u044e\u0431\u043e\u0439
    \u043e\u0442\u0432\u0435\u0442 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044e.
    \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u043b\u043e\u0433\u0438\u043a \u0413\u043e\u0442\u043b\u043e\u0431
    \u0424\u0440\u0435\u0433\u0435, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u043f\u0438\u0441\u044c\u043c\u043e
    \u043e\u0442 \u0420\u0430\u0441\u0441\u0435\u043b\u0430, \u043d\u0430\u043f\u0438\u0441\u0430\u043b,
    \u0447\u0442\u043e \u00ab\u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u043f\u043e\u0448\u0430\u0442\u043d\u0443\u043b\u0430\u0441\u044c\u00bb.
    \u0427\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u0442\u044c
    \u044d\u0442\u043e\u0442 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441, \u0420\u0430\u0441\u0441\u0435\u043b
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0442\u0438\u043f\u043e\u0432 \u2014 \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443, \u0433\u0434\u0435 \u043a\u0430\u0436\u0434\u043e\u0435
    \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u0435 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f
    \u043a \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e\u043c\u0443 \u0443\u0440\u043e\u0432\u043d\u044e,
    \u0447\u0442\u043e \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u0441\u0430\u043c\u043e\u043e\u0442\u043d\u0435\u0441\u0435\u043d\u0438\u0435. \u0412\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u043e\u043c \u0423\u0430\u0439\u0442\u0445\u0435\u0434\u043e\u043c
    \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u044d\u0442\u043e\u043c\u0443
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0439 \u0442\u0440\u0443\u0434,
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0441\u0442\u0430\u043b\u043e \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u043e\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435
    \u00abPrincipia Mathematica\u00bb (1910\u20131913). \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430,
    \u0445\u043e\u0442\u044c \u0438 \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0430 \u0434\u043e
    \u043a\u043e\u043d\u0446\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u043d\u043e\u0435
    (\u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0413\u0451\u0434\u0435\u043b\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0442\u0430\u043a\u043e\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0430), \u0441\u0442\u0430\u043b\u0430
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u0430. \u0412 \u044d\u0442\u043e\u0442 \u0436\u0435
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0420\u0430\u0441\u0441\u0435\u043b \u0441\u043e\u0437\u0434\u0430\u0451\u0442
    \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u0435\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u0439
    (1905), \u0441\u0442\u0430\u0432\u0448\u0443\u044e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0435
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f (\u00ab\u043d\u044b\u043d\u0435\u0448\u043d\u0438\u0439
    \u043a\u043e\u0440\u043e\u043b\u044c \u0424\u0440\u0430\u043d\u0446\u0438\u0438\u00bb) \u043d\u0435
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0438\u043c\u0435\u043d\u0430\u043c\u0438,
    \u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0441\u043e\u0431\u043e\u0439
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043d\u0435\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432. \u041e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u0442\u044e\u0440\u044c\u043c\u044b
    \u0438 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0420\u0430\u0441\u0441\u0435\u043b, \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u0439
    \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442, \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0432\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f \u0432 \u0430\u043d\u0442\u0438\u0432\u043e\u0435\u043d\u043d\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u0412 1916 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u0443\u0432\u043e\u043b\u0435\u043d \u0438\u0437 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430
    \u0437\u0430 \u0432\u044b\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0442\u0438\u0432
    \u043a\u043e\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u0438 (\u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u0437\u044b\u0432\u0430) \u0438 \u043e\u0448\u0442\u0440\u0430\u0444\u043e\u0432\u0430\u043d
    \u043d\u0430 110 \u0444\u0443\u043d\u0442\u043e\u0432. \u0412 1918 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u0451\u043d
    \u043a \u0448\u0435\u0441\u0442\u0438 \u043c\u0435\u0441\u044f\u0446\u0430\u043c \u0442\u044e\u0440\u0435\u043c\u043d\u043e\u0433\u043e
    \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0437\u0430 \u0441\u0442\u0430\u0442\u044c\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f, \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e
    \u0432\u043b\u0430\u0441\u0442\u0435\u0439, \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u044f\u043b\u0430
    \u0441\u043e\u044e\u0437\u043d\u044b\u0435 \u0441 \u0421\u0428\u0410 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f.
    \u0421\u0432\u043e\u0451 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043e\u043d
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0434\u043b\u044f \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u043a\u043d\u0438\u0433\u0438 \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e\u00bb
    (1919). \u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b \u0420\u0430\u0441\u0441\u0435\u043b
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u0443\u044e
    \u0420\u043e\u0441\u0441\u0438\u044e (1920), \u0433\u0434\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b\u0441\u044f
    \u0441 \u041b\u0435\u043d\u0438\u043d\u044b\u043c. \u0423\u0432\u0438\u0434\u0435\u043d\u043d\u043e\u0435
    \u0435\u0433\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043b\u043e:
    \u043e\u043d \u0431\u044b\u043b \u043f\u043e\u0442\u0440\u044f\u0441\u0451\u043d \u0436\u0435\u0441\u0442\u043e\u043a\u043e\u0441\u0442\u044c\u044e
    \u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043c \u0441\u0432\u043e\u0431\u043e\u0434\u044b
    \u0432 \u0431\u043e\u043b\u044c\u0448\u0435\u0432\u0438\u0441\u0442\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435, \u043d\u0430\u0437\u0432\u0430\u0432 \u0435\u0451
    \u0444\u043e\u0440\u043c\u043e\u0439 \u0444\u0430\u043d\u0430\u0442\u0438\u0447\u043d\u043e\u0439
    \u0440\u0435\u043b\u0438\u0433\u0438\u0438. \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0443\u0435\u0445\u0430\u043b \u0432 \u041a\u0438\u0442\u0430\u0439 \u0447\u0438\u0442\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0432 \u041f\u0435\u043a\u0438\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0433\u0434\u0435
    \u043f\u0440\u043e\u0432\u0451\u043b \u043f\u043e\u0447\u0442\u0438 \u0433\u043e\u0434,
    \u0438\u0437\u0443\u0447\u0430\u044f \u044d\u0442\u0443 \u0434\u0440\u0435\u0432\u043d\u044e\u044e
    \u0446\u0438\u0432\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044e. \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0420\u0430\u0441\u0441\u0435\u043b\u0430 \u0431\u044b\u043b\u0430 \u0431\u0443\u0440\u043d\u043e\u0439
    \u0438 \u043d\u0435\u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439.
    \u041e\u043d \u0440\u0430\u0437\u0432\u0435\u043b\u0441\u044f \u0441 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0436\u0435\u043d\u043e\u0439 \u0432 1921 \u0433\u043e\u0434\u0443 \u0438 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0414\u043e\u0440\u0435 \u0411\u043b\u044d\u043a. \u0423 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0434\u0432\u043e\u0435 \u0434\u0435\u0442\u0435\u0439.
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u0414\u043e\u0440\u043e\u0439 \u043e\u043d
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u00ab\u0411\u0438\u043a\u043e\u043d-\u0425\u0438\u043b\u043b\u00bb,
    \u0433\u0434\u0435 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0432\u043e\u043f\u043b\u043e\u0442\u0438\u0442\u044c
    \u0441\u0432\u043e\u0438 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u0438. \u0415\u0433\u043e \u0431\u0440\u0430\u043a \u0441 \u0414\u043e\u0440\u043e\u0439
    \u0440\u0430\u0441\u043f\u0430\u043b\u0441\u044f \u0432 1935 \u0433\u043e\u0434\u0443, \u0438
    \u0432 1936 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041f\u0430\u0442\u0440\u0438\u0446\u0438\u0438 \u0421\u043f\u0435\u043d\u0441,
    \u0440\u043e\u0434\u0438\u0432\u0448\u0435\u0439 \u0435\u043c\u0443 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e
    \u0441\u044b\u043d\u0430. \u041f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0430
    \u0432 \u0421\u0428\u0410 \u0432 \u043a\u043e\u043d\u0446\u0435 1930-\u0445 \u0433\u043e\u0434\u043e\u0432
    \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430\u0441\u044c
    \u0441 \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u044b\u043c \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u043e\u043c:
    \u0432 1940 \u0433\u043e\u0434\u0443 \u0438\u0437-\u0437\u0430 \u0435\u0433\u043e \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432 \u043d\u0430 \u043c\u043e\u0440\u0430\u043b\u044c
    \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439 \u0441\u0443\u0434 \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0430
    \u043e\u0442\u043c\u0435\u043d\u0438\u043b \u0435\u0433\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u0421\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435. \u0412
    1952 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    80 \u043b\u0435\u0442, \u043e\u043d \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0441\u0432\u043e\u0439
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439, \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044b\u0439
    \u0431\u0440\u0430\u043a \u0441 \u042d\u0434\u0438\u0442 \u0424\u0438\u043d\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0438\u043d\u0451\u0441 \u0435\u043c\u0443 \u0441\u0447\u0430\u0441\u0442\u044c\u0435.
    \u0412 1931 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0431\u0440\u0430\u0442\u0430, \u0420\u0430\u0441\u0441\u0435\u043b \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0442\u0438\u0442\u0443\u043b \u0438 \u0441\u0442\u0430\u043b 3-\u043c \u0433\u0440\u0430\u0444\u043e\u043c
    \u0420\u0430\u0441\u0441\u0435\u043b\u043e\u043c. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f
    \u0431\u043e\u0440\u044c\u0431\u0430 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u041f\u043e\u0441\u043b\u0435 \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0420\u0430\u0441\u0441\u0435\u043b \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0433\u043e\u043b\u043e\u0441\u043e\u0432 \u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438
    \u0437\u0430 \u044f\u0434\u0435\u0440\u043d\u043e\u0435 \u0440\u0430\u0437\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0435.
    \u0412 1955 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442 \u0420\u0430\u0441\u0441\u0435\u043b\u0430\u2014\u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430,
    \u0430 \u0432 1957 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u043e\u0440\u043e\u0432 \u041f\u0430\u0433\u0443\u043e\u0448\u0441\u043a\u043e\u0433\u043e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0443\u0447\u0451\u043d\u044b\u0445 \u0437\u0430
    \u043c\u0438\u0440. \u041e\u043d \u0431\u044b\u043b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041a\u0430\u043c\u043f\u0430\u043d\u0438\u0438 \u0437\u0430 \u044f\u0434\u0435\u0440\u043d\u043e\u0435
    \u0440\u0430\u0437\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0435 (1958\u20131963) \u0438
    \u0434\u0430\u0436\u0435 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 89 \u043b\u0435\u0442
    \u0432 1961 \u0433\u043e\u0434\u0443 \u0441\u043d\u043e\u0432\u0430 \u043f\u0440\u043e\u0432\u0451\u043b
    \u043d\u0435\u0434\u0435\u043b\u044e \u0432 \u0442\u044e\u0440\u044c\u043c\u0435 \u0437\u0430
    \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0430\u043d\u0442\u0438\u0432\u043e\u0435\u043d\u043d\u043e\u0439
    \u0430\u043a\u0446\u0438\u0438 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430. \u0412
    \u043a\u043e\u043d\u0446\u0435 1960-\u0445 \u0433\u043e\u0434\u043e\u0432 \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0422\u0440\u0438\u0431\u0443\u043d\u0430\u043b \u0420\u0430\u0441\u0441\u0435\u043b\u0430
    \u0434\u043b\u044f \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u0432\u043e\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0439
    \u0421\u0428\u0410 \u0432\u043e \u0412\u044c\u0435\u0442\u043d\u0430\u043c\u0435. \u0420\u0430\u0441\u0441\u0435\u043b
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043d\u0430\u0433\u0440\u0430\u0434: \u0432 1949 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u0442\u0430\u043b \u043a\u0430\u0432\u0430\u043b\u0435\u0440\u043e\u043c \u041e\u0440\u0434\u0435\u043d\u0430
    \u0417\u0430\u0441\u043b\u0443\u0433, \u0430 \u0432 1950 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    \u043f\u043e \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435 \u00ab\u0437\u0430
    \u0437\u0430\u0449\u0438\u0442\u0443 \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u0445
    \u0438\u0434\u0435\u0430\u043b\u043e\u0432 \u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u044b
    \u043c\u044b\u0441\u043b\u0438\u00bb. \u041e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0431\u0440\u043e\u043d\u0445\u0438\u0442\u0430 2 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1970 \u0433\u043e\u0434\u0430 \u0432 \u0423\u044d\u043b\u044c\u0441\u0435, \u043d\u0435
    \u0434\u043e\u0436\u0438\u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0434\u043e \u0441\u0432\u043e\u0435\u0433\u043e
    98-\u043b\u0435\u0442\u0438\u044f."
  shortBioEn: 
  interestingFactsRu: "\u0411\u0435\u0440\u0442\u0440\u0430\u043d \u0420\u0430\u0441\u0441\u0435\u043b \u2014 \u0444\u0438\u0433\u0443\u0440\u0430,
    \u0432\u043e\u043a\u0440\u0443\u0433 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0432\u0441\u0435\u0433\u0434\u0430
    \u043a\u0438\u043f\u0435\u043b\u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u0438, \u0438
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u043f\u043e\u043b\u043d\u0430 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445,
    \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445 \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u044b\u0445
    \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c,
    \u043d\u043e \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0436\u0438\u0432\u044b\u043c
    \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u043c. \u0412\u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432 \u0438 \u043a\u0443\u0440\u044c\u0451\u0437\u043e\u0432
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.\n\n\u2615
    \u041b\u0435\u0433\u0435\u043d\u0434\u0430 \u043e \u00ab\u0427\u0430\u0439\u043d\u0438\u043a\u0435
    \u0420\u0430\u0441\u0441\u0435\u043b\u0430\u00bb (\u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0447\u0430\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0438\u0440\u0430\u044e\u0442)
    \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439
    \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442 \u0420\u0430\u0441\u0441\u0435\u043b\u0430
    \u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a
    \u043c\u0430\u0441\u0441\u044b \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u043e\u0432. \u0412
    \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432 1952 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044b\u0439
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442: \u0435\u0441\u043b\u0438
    \u044f \u0437\u0430\u044f\u0432\u043b\u044e, \u0447\u0442\u043e \u043c\u0435\u0436\u0434\u0443
    \u0417\u0435\u043c\u043b\u0435\u0439 \u0438 \u041c\u0430\u0440\u0441\u043e\u043c \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u0444\u0430\u0440\u0444\u043e\u0440\u043e\u0432\u044b\u0439 \u0447\u0430\u0439\u043d\u0438\u043a,
    \u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0443 \u043e\u0431\u044f\u0437\u0430\u043d
    \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u044d\u0442\u043e, \u043f\u043e\u043a\u0430
    \u0432\u044b \u043d\u0435 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0435\u0442\u0435.
    \u042d\u0442\u0438\u043c \u043e\u043d \u0445\u043e\u0442\u0435\u043b \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u0431\u0440\u0435\u043c\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043b\u0435\u0436\u0438\u0442 \u043d\u0430 \u0442\u043e\u043c, \u043a\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0447\u0435\u0433\u043e-\u0442\u043e
    (\u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0411\u043e\u0433\u0430). \u041a\u0443\u0440\u044c\u0451\u0437:
    \u0412 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0435 \u0438 \u0443\u0441\u0442\u043d\u044b\u0445
    \u0431\u0430\u0439\u043a\u0430\u0445 \u044d\u0442\u043e\u0442 \u0443\u043c\u043d\u044b\u0439
    \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0441\u044f
    \u0432 \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u0443\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u044e
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u0440\u0438\u0448\u0451\u043b
    \u0432 \u0446\u0435\u0440\u043a\u043e\u0432\u044c, \u0443\u0434\u0430\u0440\u0438\u043b
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430 \u0447\u0430\u0439\u043d\u0438\u043a\u043e\u043c
    \u043f\u043e \u0433\u043e\u043b\u043e\u0432\u0435 \u0438 \u0443\u0431\u0435\u0436\u0430\u043b,
    \"\u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044f\" \u0442\u0430\u043a\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0441\u0432\u043e\u0451 \u043f\u0440\u0430\u0432\u043e
    \u043d\u0435 \u0432\u0435\u0440\u0438\u0442\u044c \u0432 \u0411\u043e\u0433\u0430. \u042d\u0442\u043e,
    \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0432\u044b\u043c\u044b\u0441\u0435\u043b,
    \u043d\u043e \u044f\u0440\u043a\u043e \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0449\u0438\u0439,
    \u043a\u0430\u043a \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437 \"\u0445\u0443\u043b\u0438\u0433\u0430\u043d\u0430
    \u043e\u0442 \u043b\u043e\u0433\u0438\u043a\u0438\" \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u043b
    \u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e.\n\n\U0001F525
    \u0422\u044e\u0440\u0435\u043c\u043d\u044b\u0439 \u044e\u043c\u043e\u0440 \u0420\u0430\u0441\u0441\u0435\u043b
    \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u043c \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u043e\u043c
    \u0438 \u043d\u0435 \u0440\u0430\u0437 \u0441\u0438\u0434\u0435\u043b \u0432 \u0442\u044e\u0440\u044c\u043c\u0435
    \u0437\u0430 \u0441\u0432\u043e\u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f.
    \u0412 1918 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043f\u0430\u043b \u0432
    \u0442\u044e\u0440\u044c\u043c\u0443 \u043d\u0430 \u0448\u0435\u0441\u0442\u044c \u043c\u0435\u0441\u044f\u0446\u0435\u0432
    \u0438 \u0432 \u0441\u0432\u043e\u0438\u0445 \u043c\u0435\u043c\u0443\u0430\u0440\u0430\u0445
    \u0441 \u044e\u043c\u043e\u0440\u043e\u043c \u043e\u043f\u0438\u0441\u0430\u043b \u043c\u043e\u043c\u0435\u043d\u0442
    \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0441 \u043d\u0430\u0434\u0437\u0438\u0440\u0430\u0442\u0435\u043b\u0435\u043c:
    > \"\u042f \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c \u043e\u0431\u043e\u0434\u0440\u0451\u043d
    \u043f\u043e \u043f\u0440\u0438\u0431\u044b\u0442\u0438\u0438 \u0441\u0442\u043e\u0440\u043e\u0436\u0435\u043c
    \u0443 \u0432\u043e\u0440\u043e\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e\u043b\u0436\u0435\u043d
    \u0431\u044b\u043b \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u043c\u043e\u0438 \u0434\u0430\u043d\u043d\u044b\u0435.
    \u041e\u043d \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u043e \u043c\u043e\u0435\u0439
    \u0440\u0435\u043b\u0438\u0433\u0438\u0438, \u0438 \u044f \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    '\u0410\u0433\u043d\u043e\u0441\u0442\u0438\u043a'. \u041e\u043d \u0441\u043f\u0440\u043e\u0441\u0438\u043b,
    \u043a\u0430\u043a \u044d\u0442\u043e \u043f\u0438\u0448\u0435\u0442\u0441\u044f, \u0438
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u0441\u043e \u0432\u0437\u0434\u043e\u0445\u043e\u043c:
    '\u0427\u0442\u043e \u0436, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043c\u043d\u043e\u0433\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u0439, \u043d\u043e,
    \u043f\u043e\u043b\u0430\u0433\u0430\u044e, \u0432\u0441\u0435 \u043e\u043d\u0438 \u043f\u043e\u043a\u043b\u043e\u043d\u044f\u044e\u0442\u0441\u044f
    \u043e\u0434\u043d\u043e\u043c\u0443 \u0438 \u0442\u043e\u043c\u0443 \u0436\u0435 \u0411\u043e\u0433\u0443'.
    \u042d\u0442\u043e \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u043e
    \u043c\u043e\u0451 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u043e\u043a\u043e\u043b\u043e
    \u043d\u0435\u0434\u0435\u043b\u0438\". \u042d\u0442\u043e\u0442 \u044d\u043f\u0438\u0437\u043e\u0434
    \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0435\u0433\u043e \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u0438\u0435 \u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043a\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0434\u0430\u0436\u0435 \u0432 \u0441\u0430\u043c\u044b\u0445 \u043c\u0440\u0430\u0447\u043d\u044b\u0445
    \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445.\n\n\U0001F9E0
    \u041a\u0430\u043a \u0442\u0430\u0431\u0430\u043a \u043f\u043e\u043c\u043e\u0433 \u0441\u0442\u0430\u0442\u044c
    \u0433\u0435\u0433\u0435\u043b\u044c\u044f\u043d\u0446\u0435\u043c... \u0438 \u0431\u0440\u043e\u0441\u0438\u0442\u044c
    \u0435\u0433\u043e \u0412 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438 \u0420\u0430\u0441\u0441\u0435\u043b
    \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439
    \u043a\u0440\u0438\u0437\u0438\u0441. \u041f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c
    \u0441\u0432\u043e\u0435\u0433\u043e \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0433\u043e
    \u0434\u0440\u0443\u0433\u0430, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430-\u0433\u0435\u0433\u0435\u043b\u044c\u044f\u043d\u0446\u0430
    \u041c\u0430\u043a\u0442\u0430\u0433\u0433\u0430\u0440\u0442\u0430, \u043e\u043d \u0443\u0432\u043b\u0451\u043a\u0441\u044f
    \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u043c\u043e\u043c. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u043a\u0443\u043f\u0438\u0442\u044c
    \u0431\u0430\u043d\u043a\u0443 \u0442\u0430\u0431\u0430\u043a\u0430 \u0438 \u043d\u0430
    \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u043c \u043f\u0443\u0442\u0438 \u043f\u043e \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u041b\u0435\u0439\u043d
    \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e, \u043f\u043e\u0434\u0431\u0440\u043e\u0441\u0438\u0432
    \u0435\u0451 \u0432 \u0432\u043e\u0437\u0434\u0443\u0445, \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b:
    \"\u0412\u0435\u043b\u0438\u043a\u0438\u0439 \u0411\u043e\u0436\u0435 \u0432 \u0441\u0430\u043f\u043e\u0433\u0430\u0445!
    \u041e\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442
    \u0432\u0435\u0440\u0435\u043d!\". \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442
    \u043c\u043e\u043c\u0435\u043d\u0442 \u043e\u043d \u043e\u0441\u043e\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b \u0433\u0435\u0433\u0435\u043b\u044c\u044f\u043d\u0446\u0435\u043c.
    \u0418\u0440\u043e\u043d\u0438\u044f: \u041f\u043e\u0437\u0436\u0435 \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u044d\u0442\u0438\u0445 \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432 \u0438
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432 \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u043c\u0430.
    \u0410 \u0447\u0442\u043e \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0442\u0430\u0431\u0430\u043a\u0430
    \u2014 \u043e\u043d \u043a\u0443\u0440\u0438\u043b \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c,
    \u0438 \u043e\u0434\u043d\u0430\u0436\u0434\u044b, \u0432 1948 \u0433\u043e\u0434\u0443,
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0430\u0432\u0438\u0430\u043f\u0435\u0440\u0435\u043b\u0451\u0442\u0430,
    \u043e\u043d \u043f\u043e\u0448\u0451\u043b \u0432 \u0442\u0443\u0430\u043b\u0435\u0442
    \u043f\u043e\u043a\u0443\u0440\u0438\u0442\u044c, \u0438 \u0432 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u0442\u0430\u043c, \u0441\u0430\u043c\u043e\u043b\u0451\u0442
    \u0440\u0443\u0445\u043d\u0443\u043b \u0432 \u043c\u043e\u0440\u0435. \u041e\u043d \u0432\u044b\u0436\u0438\u043b,
    \u0430 cigarette \u0441\u043f\u0430\u0441\u043b\u0430 \u0435\u043c\u0443 \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F393
    \u0427\u0443\u0434\u043d\u043e\u0439 \u0440\u0435\u0431\u0451\u043d\u043e\u043a \u0438 \u0441\u0442\u0440\u043e\u0433\u0430\u044f
    \u0431\u0430\u0431\u0443\u0448\u043a\u0430 \u0412\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u043d\u044b\u0439
    \u0431\u0430\u0431\u0443\u0448\u043a\u043e\u0439 \u0432 \u0441\u0442\u0440\u043e\u0433\u0438\u0445
    \u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0445 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f\u0445,
    \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439 \u0411\u0435\u0440\u0442\u0440\u0430\u043d
    \u0443\u0436\u0435 \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u0440\u0430\u0436\u0430\u043b
    \u0432\u0441\u0435\u0445 \u0441\u0432\u043e\u0435\u0439 \u043b\u044e\u0431\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u043d \u0441\u043f\u0440\u043e\u0441\u0438\u043b
    \u0441\u0432\u043e\u044e \u0442\u0451\u0442\u044e: \"\u0422\u0451\u0442\u044f, \u0430 \u043c\u043e\u0440\u0441\u043a\u0438\u0435
    \u0443\u0442\u043e\u0447\u043a\u0438 \u0434\u0443\u043c\u0430\u044e\u0442?\". \u041d\u0430
    \u043d\u0435\u0434\u043e\u0443\u043c\u0451\u043d\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442
    \"\u041d\u0435 \u0437\u043d\u0430\u044e\", \u043e\u043d \u043f\u0430\u0440\u0438\u0440\u043e\u0432\u0430\u043b:
    \"\u0422\u043e\u0433\u0434\u0430 \u0442\u044b \u0434\u043e\u043b\u0436\u043d\u0430 \u044d\u0442\u043e
    \u0443\u0437\u043d\u0430\u0442\u044c!\". \u0411\u0430\u0431\u0443\u0448\u043a\u0430 \u0431\u044b\u043b\u0430
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435, \u043d\u043e \u043a 14 \u0433\u043e\u0434\u0430\u043c
    \u043e\u043d \u0443\u0436\u0435 \u0441\u0442\u0430\u043b \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c
    \u0435\u0451 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0443\u0442\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439,
    \u0430 \u0435\u0451 \u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0443\u044e \u043c\u043e\u0440\u0430\u043b\u044c
    \u2014 \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e\u0439. \u0427\u0442\u043e\u0431\u044b
    \u0432\u0435\u0441\u0442\u0438 \u0434\u043d\u0435\u0432\u043d\u0438\u043a \u0432 \u0442\u0430\u0439\u043d\u0435
    \u043e\u0442 \u0432\u0441\u0435\u0445, \u043e\u043d \u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e
    \u043d\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435.\n\n\U0001F4EC
    \u041e\u0442\u0432\u0435\u0442\u044b \u043d\u0430 \u0441\u043e\u0442\u043d\u0438 \u043f\u0438\u0441\u0435\u043c
    \u0420\u0430\u0441\u0441\u0435\u043b \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0435\u043d, \u0438 \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u043b\u0438\u0447\u043d\u043e
    \u043e\u0442\u0432\u0435\u0447\u0430\u0442\u044c \u043d\u0430 \u043f\u0438\u0441\u044c\u043c\u0430.
    \u0423\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e
    \u0432 \u043f\u0438\u043a \u0441\u0432\u043e\u0435\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u043b \u0434\u043e 100 \u043f\u0438\u0441\u0435\u043c
    \u0432 \u0434\u0435\u043d\u044c. \u041e\u043d \u0437\u0430\u0432\u043e\u0434\u0438\u043b
    \u043b\u0438\u0447\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0434\u0430\u0436\u0435 \u0441 \u0434\u0435\u0442\u044c\u043c\u0438. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043e\u043d \u043f\u043e\u0437\u0434\u0440\u0430\u0432\u0438\u043b \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e
    \u0434\u0435\u0432\u043e\u0447\u043a\u0443 \u0441 \u0434\u043d\u0451\u043c \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u043b
    \u0441 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c,
    \u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u043e\u0434\u0438\u043d\u043e\u043a\u043e\u0439
    \u0434\u0435\u0432\u043e\u0447\u043a\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0441\u0442\u0430\u0442\u044c \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u043f\u043e
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0441\u043e \u0441\u0432\u043e\u0435\u0439
    \u0432\u043d\u0443\u0447\u043a\u043e\u0439.\n\n\U0001F3A5 \u041c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442 \u043f\u0440\u043e \u0430\u0434 \u0425\u043e\u0434\u0438\u043b
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442, \u0447\u0442\u043e \u043a\u043e\u0433\u0434\u0430
    \u0420\u0430\u0441\u0441\u0435\u043b \u0443\u043c\u0435\u0440 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u043b
    \u043f\u0435\u0440\u0435\u0434 \u0411\u043e\u0433\u043e\u043c, \u0412\u0441\u0435\u0432\u044b\u0448\u043d\u0438\u0439
    \u0441\u043a\u0430\u0437\u0430\u043b \u0435\u043c\u0443: \"\u0422\u044b \u0431\u044b\u043b
    \u0447\u0435\u0441\u0442\u043d\u044b\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u043c,
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u044f \u043e\u0442\u0432\u0435\u0447\u0443 \u043d\u0430
    \u0442\u0440\u0438 \u0442\u0432\u043e\u0438\u0445 \u0432\u043e\u043f\u0440\u043e\u0441\u0430,
    \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c
    \u0442\u0435\u0431\u044f \u0432 \u0430\u0434\". \u0420\u0430\u0441\u0441\u0435\u043b \u0441\u0440\u0430\u0437\u0443
    \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u043d\u0430
    \u0432\u0441\u0435\u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u043e \u0438 \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043a\u0430\u043c\u0435\u043d\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0411\u043e\u0433 \u0441\u0430\u043c \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442
    \u043f\u043e\u0434\u043d\u044f\u0442\u044c. \u041a\u043e\u0433\u0434\u0430 \u0411\u043e\u0433
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0420\u0430\u0441\u0441\u0435\u043b \u0441 \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u043e\u043c
    \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043f\u043e\u0439\u043c\u0430\u043b
    \u0435\u0433\u043e \u0432 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043f\u043e \u0438\u0440\u043e\u043d\u0438\u0438
    \u0441\u0443\u0434\u044c\u0431\u044b, \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e\u0442
    \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f
    \u0437\u0430\u0433\u043e\u043d\u044f\u0442\u044c \u0412\u0441\u0435\u0432\u044b\u0448\u043d\u0435\u0433\u043e
    \u0432 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u043c\u043a\u0438,
    \u0438 \u0435\u0441\u0442\u044c \u0435\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u0434. \u041e\u0442\u043b\u0438\u0447\u043d\u0430\u044f \u0448\u0443\u0442\u043a\u0430,
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0430\u044f, \u043a\u0430\u043a
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438
    \u0435\u0433\u043e \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u044c \u043b\u043e\u0433\u0438\u043a\u043e\u0439.
    \u041a\u0430\u043a \u0432\u0438\u0434\u0438\u0442\u0435, \u0420\u0430\u0441\u0441\u0435\u043b
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0443\u0445\u0438\u043c
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c, \u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u043c\u0435\u043b
    \u043f\u043e\u0441\u043c\u0435\u044f\u0442\u044c\u0441\u044f \u0438 \u043d\u0430\u0434 \u0441\u043e\u0431\u043e\u0439,
    \u0438 \u043d\u0430\u0434 \u0441\u0430\u043c\u043e\u0439, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0431\u044b, \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0439
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439."
