  achievementsRu: "\u041D\u0430\u0443\u0447\u043D\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435
    \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \u2014 \u044D\u0442\u043E \u0432\u0435\u0440\u0448\u0438\u043D\u0430
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B. \u0415\u0433\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439
    \u0432\u043A\u043B\u0430\u0434 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u043C\u043E\u0449\u043D\u044B\u0445
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u0435\u0442\u043E\u0434\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043D\u0430 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F \u043E\u043F\u0435\u0440\u0435\u0434\u0438\u043B\u0438
    \u0441\u0432\u043E\u0451 \u0432\u0440\u0435\u043C\u044F \u0438 \u0441\u0442\u0430\u043B\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B \u0432 \u0415\u0432\u0440\u043E\u043F\u0435
    \u043B\u0438\u0448\u044C \u0432 \u041D\u043E\u0432\u043E\u0435 \u0432\u0440\u0435\u043C\u044F. 
    \u0415\u0433\u043E \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
    \u043D\u0430 \u0434\u0432\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
    \u0435\u0433\u043E \u0434\u0432\u0443\u043C \u0432\u0435\u043B\u0438\u043A\u0438\u043C
    \u0442\u0440\u0443\u0434\u0430\u043C.  ### 1. \xAB\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0432 \u0443\u0447\u0435\u043D\u0438\u0435 \u043E \u0441\u0447\u0451\u0442\u0435\xBB
    (1299): \u0421\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044F
    \u0438 \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u043A\u0430  \u042D\u0442\u043E\u0442
    \u0443\u0447\u0435\u0431\u043D\u0438\u043A, \u0445\u043E\u0442\u044C \u0438 \u0431\u044B\u043B
    \u0443\u0442\u0435\u0440\u044F\u043D \u0432 \u041A\u0438\u0442\u0430\u0435, \u043D\u043E
    \u043E\u043A\u0430\u0437\u0430\u043B \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043D\u0430 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0432 \u042F\u043F\u043E\u043D\u0438\u0438
    \u0438 \u041A\u043E\u0440\u0435\u0435.  *   **\u0421\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430
    \u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435**: \u041A\u043D\u0438\u0433\u0430
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 **259 \u0437\u0430\u0434\u0430\u0447,
    \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0445 \u043D\u0430
    20 \u0433\u043B\u0430\u0432**, \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u0443\u0440\u0441 \u043E\u0442 \u0430\u0437\u043E\u0432 \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u043A\u0438
    \u0434\u043E \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0439. *   **\u041F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u044C**:
    \u0421\u043B\u0435\u0434\u0443\u044F \u044E\u0436\u043D\u043E-\u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438, \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435
    \u0438\u0437\u043B\u0430\u0433\u0430\u043B \u043F\u0440\u0430\u0432\u0438\u043B\u0430
    \u0432 \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u0435 \u0434\u043B\u044F \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u044F
    \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
    \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435
    \u0432 \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447\u0430\u0445, \u0447\u0442\u043E \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443\u0435\u0442
    \u043E \u0432\u044B\u0445\u043E\u0434\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u044B \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u0447\u044C\u0435\u0439
    \u0441\u0440\u0435\u0434\u044B. *   **\u041C\u0435\u0442\u043E\u0434 \u0413\u0430\u0443\u0441\u0441\u0430**:
    \u0412 \u044D\u0442\u043E\u043C \u0442\u0440\u0443\u0434\u0435 \u0427\u0436\u0443
    \u0428\u0438\u0446\u0437\u0435 \u0443\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043C
    \u043B\u0438\u043D\u0435\u0439\u043D\u044B\u0445 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439,
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0432 \u043C\u0435\u0442\u043E\u0434,
    \u043F\u043E \u0441\u0443\u0442\u0438 \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442\u043D\u044B\u0439
    **\xAB\u043C\u0435\u0442\u043E\u0434\u0443 \u0413\u0430\u0443\u0441\u0441\u0430\xBB
    (\u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445)**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432 \u0415\u0432\u0440\u043E\u043F\u0435
    \u0431\u044B\u043B \u043E\u0442\u043A\u0440\u044B\u0442 \u043B\u0438\u0448\u044C
    \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F \u0441\u043F\u0443\u0441\u0442\u044F.
    *   **\u0412\u043B\u0438\u044F\u043D\u0438\u0435**: \u041A\u043D\u0438\u0433\u0430
    \u0441\u044B\u0433\u0440\u0430\u043B\u0430 \u043A\u043B\u044E\u0447\u0435\u0432\u0443\u044E
    \u0440\u043E\u043B\u044C \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u044F\u043F\u043E\u043D\u0441\u043A\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 *\u0432\u0430\u0441\u0430\u043D*. 
    ### 2. \xAB\u042F\u0448\u043C\u043E\u0432\u043E\u0435 \u0437\u0435\u0440\u043A\u0430\u043B\u043E
    \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432\xBB
    (1303): \u0412\u0435\u0440\u0448\u0438\u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B  \u042D\u0442\u043E\u0442 \u0442\u0440\u0443\u0434,
    \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0414\u0436\u043E\u0440\u0434\u0436
    \u0421\u0430\u0440\u0442\u043E\u043D \u043D\u0430\u0437\u0432\u0430\u043B \u0427\u0436\u0443
    \u0428\u0438\u0446\u0437\u0435 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 \u0432\u0441\u0435\u0445
    \u0432\u0440\u0435\u043C\u0435\u043D , \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
    \u0433\u043B\u0430\u0432\u043D\u044B\u0435 \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F.  *   **\u041C\u0435\u0442\u043E\u0434
    \xAB\u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432\xBB
    (\u56DB\u5143\u8853)**: \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \u0440\u0430\u0437\u0432\u0438\u043B
    \u043C\u0435\u0442\u043E\u0434 \xAB\u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0433\u043E
    \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E\xBB
    \u0434\u043B\u044F \u043E\u0434\u043D\u043E\u0433\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u0432 \u043C\u0435\u0442\u043E\u0434 \u0434\u043B\u044F \u0441\u0438\u0441\u0442\u0435\u043C
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439 \u0441 **\u0447\u0435\u0442\u044B\u0440\u044C\u043C\u044F
    \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C\u0438**, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u043B\u0438\u0441\u044C
    \u043A\u0430\u043A **\u041D\u0435\u0431\u043E, \u0417\u0435\u043C\u043B\u044F,
    \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0438 \u041C\u0430\u0442\u0435\u0440\u0438\u044F**
    (\u5929, \u5730, \u4EBA, \u7269). *   **\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439**: \u041E\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0441\u043B\u043E\u0436\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443
    \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u043E\u0432
    \u043C\u043D\u043E\u0433\u043E\u0447\u043B\u0435\u043D\u043E\u0432 \u043D\u0430
    \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0434\u043E\u0441\u043A\u0435 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u0441\u0447\u0435\u0442\u043D\u044B\u0445 \u043F\u0430\u043B\u043E\u0447\u0435\u043A.
    \u0412 \u0446\u0435\u043D\u0442\u0440\u0435 \u044D\u0442\u043E\u0439 \u0441\u0445\u0435\u043C\u044B
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444
    **\u592A (\u0422\u0430\u0439\u0446\u0437\u0438)**, \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0449\u0438\u0439
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439 \u0447\u043B\u0435\u043D
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F. *   **\u041C\u0435\u0442\u043E\u0434
    \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F**: \u041A\u043B\u044E\u0447\u0435\u0432\u044B\u043C
    \u043D\u043E\u0432\u0448\u0435\u0441\u0442\u0432\u043E\u043C \u0441\u0442\u0430\u043B\u0430
    \u0442\u0435\u0445\u043D\u0438\u043A\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u0434\u043B\u044F \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439 \u0441 \u0447\u0435\u0442\u044B\u0440\u044C\u043C\u044F
    \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u043A
    \u043E\u0434\u043D\u043E\u043C\u0443 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
    \u0441 \u043E\u0434\u043D\u0438\u043C \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C.
    \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442,
    \u0447\u0442\u043E \u0432 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0437\u0430\u0434\u0430\u0447\u0430\u0445 \u0435\u0433\u043E \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0449\u0435,
    \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u044B\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u043D\u0442\u044B,
    \u0447\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0438
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445,
    \u043D\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u0441\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0439. *   **\u0427\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439**:
    \u0414\u043B\u044F \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u043A\u043E\u0440\u043D\u0435\u0439 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0445
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439 \u0432\u044B\u0441\u0448\u0438\u0445
    \u0441\u0442\u0435\u043F\u0435\u043D\u0435\u0439 (\u0432\u043F\u043B\u043E\u0442\u044C
    \u0434\u043E 14-\u0439) \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
    \u043C\u0435\u0442\u043E\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432
    \u0415\u0432\u0440\u043E\u043F\u0435 \u0431\u044B\u043B \u043F\u0435\u0440\u0435\u043E\u0442\u043A\u0440\u044B\u0442
    **\u0423\u0438\u043B\u044C\u044F\u043C\u043E\u043C \u0413\u043E\u0440\u043D\u0435\u0440\u043E\u043C**
    \u0438 **\u041F\u0430\u043E\u043B\u043E \u0420\u0443\u0444\u0444\u0438\u043D\u0438**,
    \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u043A\u0430\u043A **\u043C\u0435\u0442\u043E\u0434
    \u0413\u043E\u0440\u043D\u0435\u0440\u0430**. \u041E\u043D \u0442\u0430\u043A\u0436\u0435
    \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u043B\u0441\u044F \u0434\u043B\u044F
    \u0438\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0445
    \u0438 \u043A\u0443\u0431\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043A\u043E\u0440\u043D\u0435\u0439.
    *   **\u0422\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A \u041F\u0430\u0441\u043A\u0430\u043B\u044F**:
    \u0412 \u043A\u043D\u0438\u0433\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
    \u0434\u0438\u0430\u0433\u0440\u0430\u043C\u043C\u0430 \u0431\u0438\u043D\u043E\u043C\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u043E\u0432,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u043D\u0430 \u0417\u0430\u043F\u0430\u0434\u0435
    \u043A\u0430\u043A \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A
    \u041F\u0430\u0441\u043A\u0430\u043B\u044F. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0441\u0430\u043C \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \u0441\u0441\u044B\u043B\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u044D\u0442\u043E\u0442 \u043C\u0435\u0442\u043E\u0434 \u043A\u0430\u043A
    \u043D\u0430 \xAB\u0434\u0440\u0435\u0432\u043D\u044E\u044E \u0442\u0435\u0445\u043D\u0438\u043A\u0443\xBB
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430 **\u0426\u0437\u044F
    \u0421\u044F\u043D\u044F** (\u043E\u043A. 1010\u20131070). *   **\u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0442\u043E\u0440\u0438\u043A\u0430
    \u0438 \u0440\u044F\u0434\u044B**: \u041E\u043D \u043A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043B
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0442\u0438\u043F\u044B
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0438\u0439 \u0438 \u0440\u044F\u0434\u043E\u0432
    \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438
    \u0441 \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0430\u043C\u0438
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430 \u041F\u0430\u0441\u043A\u0430\u043B\u044F,
    \u0443\u0433\u043B\u0443\u0431\u0438\u0432 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0442\u043E\u0440\u043D\u044B\u0445
    \u0442\u043E\u0436\u0434\u0435\u0441\u0442\u0432.  \u0413\u043B\u0430\u0432\u043D\u043E\u0435
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435 \u0427\u0436\u0443
    \u0428\u0438\u0446\u0437\u0435 \u2014 \u043D\u0435 \u0432 \u0440\u0435\u0448\u0435\u043D\u0438\u0438
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u0447,
    \u0430 \u0432 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0438 \u043C\u043E\u0449\u043D\u043E\u0433\u043E \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u044F\u0437\u044B\u043A\u0430 \u0438 \u043C\u0435\u0442\u043E\u0434\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0438
    \u0440\u0435\u0448\u0430\u0442\u044C \u0437\u0430\u0434\u0430\u0447\u0438 \u043D\u0435\u0432\u0438\u0434\u0430\u043D\u043D\u043E\u0439
    \u0440\u0430\u043D\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438.
    \u0415\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430, \u0443\u0442\u0435\u0440\u044F\u043D\u043D\u0430\u044F
    \u0432 \u041A\u0438\u0442\u0430\u0435 \u0438 \u0432\u043D\u043E\u0432\u044C \u043E\u0431\u0440\u0435\u0442\u0435\u043D\u043D\u0430\u044F
    \u0432 XIX \u0432\u0435\u043A\u0435, \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
    \u044F\u0440\u0447\u0430\u0439\u0448\u0438\u043C \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C
    \u0432\u044B\u0441\u043E\u0447\u0430\u0439\u0448\u0435\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F
    \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u044B\u0441\u043B\u0438 \u0432 \u0421\u0440\u0435\u0434\u043D\u0438\u0435
    \u0432\u0435\u043A\u0430."
  achievementsEn: 
  personalLifeRu: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
    \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
    \u043E \u043B\u0438\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438, \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0438,
    \u0440\u0430\u0431\u043E\u0442\u0435 \u0438 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u0445
    \u0441 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u0430\u043C\u0438
    \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 (1249\u20131314) \u043F\u043E\u0447\u0442\u0438
    \u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0430\u0441\u044C.
    \u0418\u0441\u0442\u043E\u0440\u0438\u043A\u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442
    \u043B\u0438\u0448\u044C \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u044B\u043C\u0438
    \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C\u0438, \u0431\u043E\u043B\u044C\u0448\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430
    \u043F\u043E \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u044B\u043C \u0434\u0430\u043D\u043D\u044B\u043C
    \u0438\u0437 \u0435\u0433\u043E \u0442\u0440\u0443\u0434\u043E\u0432.  \u0412\u043E\u0442
    \u0432\u0441\u0451, \u0447\u0442\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E
    \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439
    \u0434\u0435\u043D\u044C:  ### \U0001F570\uFE0F \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
    \u0432\u0435\u0445\u0438 \u0436\u0438\u0437\u043D\u0438  *   **\u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0438 \u0438\u043C\u044F**: \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435
    \u0440\u043E\u0434\u0438\u043B\u0441\u044F \u0432 **1249 \u0433\u043E\u0434\u0443**
    \u0432 \u0440\u0430\u0439\u043E\u043D\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u041F\u0435\u043A\u0438\u043D\u0430. \u0415\u0433\u043E \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u043C
    \u0438\u043C\u0435\u043D\u0435\u043C \u0431\u044B\u043B\u043E **\u0425\u0430\u043D\u044C\u0446\u0438\u043D
    (\u6F22\u537F)**, \u0430 \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u044B\u043C
    \u043F\u0441\u0435\u0432\u0434\u043E\u043D\u0438\u043C\u043E\u043C \u2014 **\u0421\u0443\u043D\u0442\u0438\u043D
    (\u677E\u5EAD)**. *   **\u0421\u043C\u0435\u0440\u0442\u044C**: \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u043E\u043D \u0443\u043C\u0435\u0440 \u0432 **1314 \u0433\u043E\u0434\u0443**.
    *   **\u041C\u0435\u0441\u0442\u043E \u0441\u043C\u0435\u0440\u0442\u0438**:
    \u0422\u043E\u0447\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u0435\u0433\u043E
    \u0441\u043C\u0435\u0440\u0442\u0438 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E. 
    ### \U0001F30F \u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F
    \u0438 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u0435 
    \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u0445
    \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u044B\u0445 \u0444\u0430\u043A\u0442\u043E\u0432
    \u043E \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438 \u2014 \u043E\u043D
    \u043C\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0438 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B:  *   **\u041F\u0435\u0440\u0435\u043B\u043E\u043C\u043D\u044B\u0439
    \u043C\u043E\u043C\u0435\u043D\u0442**: \u0412 1279 \u0433\u043E\u0434\u0443
    \u0434\u0438\u043D\u0430\u0441\u0442\u0438\u044F \u0421\u0443\u043D \u043F\u0430\u043B\u0430,
    \u0438 \u043A \u0432\u043B\u0430\u0441\u0442\u0438 \u043F\u0440\u0438\u0448\u043B\u0438
    \u043C\u043E\u043D\u0433\u043E\u043B\u044B, \u043E\u0441\u043D\u043E\u0432\u0430\u0432
    \u0434\u0438\u043D\u0430\u0441\u0442\u0438\u044E \u042E\u0430\u043D\u044C. \u041F\u043E\u0441\u043B\u0435
    \u044D\u0442\u043E\u0433\u043E \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u0427\u0436\u0443
    \u0428\u0438\u0446\u0437\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
    \u043D\u0430 \u044E\u0433 \u041A\u0438\u0442\u0430\u044F. *   **20 \u043B\u0435\u0442
    \u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0438\u0439**: \u0418\u0437
    \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u044F \u043A \u0435\u0433\u043E
    \u0433\u043B\u0430\u0432\u043D\u043E\u043C\u0443 \u0442\u0440\u0443\u0434\u0443
    \xAB\u042F\u0448\u043C\u043E\u0432\u043E\u0435 \u0437\u0435\u0440\u043A\u0430\u043B\u043E
    \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432\xBB
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E, \u0447\u0442\u043E \u043E\u043D
    **\u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u043F\u043E \u041A\u0438\u0442\u0430\u044E \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0443\u0447\u0438\u0442\u0435\u043B\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0431\u043E\u043B\u0435\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
    \u043B\u0435\u0442**. *   **\u0423\u0441\u043F\u0435\u0448\u043D\u044B\u0439
    \u043F\u0435\u0434\u0430\u0433\u043E\u0433**: \u0415\u0433\u043E \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A
    \u041C\u043E \u0416\u043E \u043F\u0438\u0441\u0430\u043B, \u0447\u0442\u043E
    \u0441\u043B\u0430\u0432\u0430 \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435
    \u043A\u0430\u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u0440\u043E\u0441\u043B\u0430, \u0438 \u0447\u0438\u0441\u043B\u043E \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432,
    \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0432\u0448\u0438\u0445 \u043A \u043D\u0435\u043C\u0443
    \u0443\u0447\u0438\u0442\u044C\u0441\u044F, \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u043B\u043E\u0441\u044C
    \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0434\u043D\u0451\u043C. \u042D\u0442\u043E
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u0435\u0433\u043E \u0432\u044B\u0441\u043E\u043A\u043E\u043C
    \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442\u0435 \u0438 \u0432\u043E\u0441\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u043D\u043E\u0441\u0442\u0438
    \u043A\u0430\u043A \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430. 
    ### \U0001F393 \u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438 \u043D\u0430\u0443\u0447\u043D\u0430\u044F \u0441\u0440\u0435\u0434\u0430 
    \u041A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0445 \u0434\u0430\u043D\u043D\u044B\u0445
    \u043E \u0442\u043E\u043C, \u0443 \u043A\u043E\u0433\u043E \u0438 \u0433\u0434\u0435
    \u043E\u043D \u0443\u0447\u0438\u043B\u0441\u044F, \u043D\u0435\u0442. \u041E\u0434\u043D\u0430\u043A\u043E
    \u043F\u043E \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u043C \u043C\u043E\u0436\u043D\u043E
    \u0441\u0443\u0434\u0438\u0442\u044C \u043E \u0448\u0438\u0440\u043E\u0442\u0435
    \u0435\u0433\u043E \u043F\u043E\u0437\u043D\u0430\u043D\u0438\u0439:  *   **\u041D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0439**: \u041E\u043D \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B
    \u0438 \u0440\u0430\u0437\u0432\u0438\u043B \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0448\u043A\u043E\u043B\u044B, \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438,
    \u043C\u0435\u0442\u043E\u0434\u044B \u0440\u0435\u0448\u0435\u043D\u0438\u044F
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435
    \u0434\u043E \u043D\u0435\u0433\u043E \u0442\u0430\u043A\u0438\u043C\u0438 \u0443\u0447\u0435\u043D\u044B\u043C\u0438,
    \u043A\u0430\u043A **\u0426\u0438\u043D\u044C \u0426\u0437\u044E\u0448\u0430\u043E**
    \u0438 **\u0426\u0437\u044F \u0421\u044F\u043D\u044C**. \u042D\u0442\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043E \u043E\u043D \u0431\u044B\u043B \u0433\u043B\u0443\u0431\u043E\u043A\u043E
    \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D \u0432 \u043D\u0430\u0443\u0447\u043D\u0443\u044E
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044E \u0441\u0432\u043E\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438 \u043E\u0431\u0449\u0430\u043B\u0441\u044F
    \u0441 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F\u043C\u0438 \u044D\u0442\u0438\u0445
    \u0437\u043D\u0430\u043D\u0438\u0439. *   **\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439**: \u0412 \u0434\u043E\u0448\u0435\u0434\u0448\u0438\u0445
    \u0434\u043E \u043D\u0430\u0441 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u0445
    \u043D\u0435\u0442 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u0439 \u043E \u0435\u0433\u043E
    \u043B\u0438\u0447\u043D\u044B\u0445 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430\u0445
    \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0435 \u0441
    \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0443\u0447\u0435\u043D\u044B\u043C\u0438
    \u0442\u043E\u0433\u043E \u043F\u0435\u0440\u0438\u043E\u0434\u0430.  \u0422\u0430\u043A\u0438\u043C
    \u043E\u0431\u0440\u0430\u0437\u043E\u043C, \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C
    \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u043D\u0430\u0441 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u043E\u0439.
    \u041C\u044B \u0437\u043D\u0430\u0435\u043C \u0435\u0433\u043E \u0432 \u043F\u0435\u0440\u0432\u0443\u044E
    \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u043A\u0430\u043A \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430, \u0447\u044C\u0438
    \u0442\u0440\u0443\u0434\u044B \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0438
    \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F, \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F
    \u043A\u0430\u043A \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u0435\u0433\u043E \u0447\u0430\u0441\u0442\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
    \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u043C\u0438 \u0434\u043B\u044F
    \u0438\u0441\u0442\u043E\u0440\u0438\u0438."
  personalLifeEn: 
  shortBioRu: "**\u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435**  \u2014 \u043E\u0434\u0438\u043D
    \u0438\u0437 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432, \u0447\u044C\u0438
    \u0440\u0430\u0431\u043E\u0442\u044B \u043E\u0437\u043D\u0430\u043C\u0435\u043D\u043E\u0432\u0430\u043B\u0438
    \u0432\u0435\u0440\u0448\u0438\u043D\u0443 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0435\u0433\u043E \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435, \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439
    \u043E \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C \u043A\u0440\u0430\u0439\u043D\u0435
    \u043C\u0430\u043B\u043E, \u0438 \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u043D\u0430\u0448\u0438\u0445 \u0437\u043D\u0430\u043D\u0438\u0439 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430
    \u043D\u0430 \u0435\u0433\u043E \u0442\u0440\u0443\u0434\u0430\u0445.  ### \u0416\u0438\u0437\u043D\u044C
    \u0438 \u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0438\u044F  *   **\u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435**:
    \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \u0431\u044B\u043B \u0440\u043E\u0434\u043E\u043C
    \u0438\u0437 \u042F\u043D\u044C\u0448\u0430\u043D\u044F (Yan-shan), \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438
    \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E \u043E\u0442 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u041F\u0435\u043A\u0438\u043D\u0430. *   **\u0412\u0440\u0435\u043C\u044F \u0436\u0438\u0437\u043D\u0438**:
    \u041F\u0440\u0438\u043D\u044F\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u0442\u044C,
    \u0447\u0442\u043E \u043E\u043D \u0436\u0438\u043B \u0441 1249 \u043F\u043E 1314
    \u0433\u043E\u0434. \u042D\u0442\u043E \u0431\u044B\u043B \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u043D\u044B\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434, \u043A\u043E\u0433\u0434\u0430 \u0434\u0438\u043D\u0430\u0441\u0442\u0438\u044F
    \u042E\u0436\u043D\u0430\u044F \u0421\u0443\u043D \u043F\u0430\u043B\u0430, \u0438
    \u0432 1279 \u0433\u043E\u0434\u0443 \u043A \u0432\u043B\u0430\u0441\u0442\u0438
    \u043F\u0440\u0438\u0448\u043B\u0430 \u043C\u043E\u043D\u0433\u043E\u043B\u044C\u0441\u043A\u0430\u044F
    \u0434\u0438\u043D\u0430\u0441\u0442\u0438\u044F \u042E\u0430\u043D\u044C, \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0432\u0448\u0430\u044F
    \u041A\u0438\u0442\u0430\u0439 \u043F\u043E\u0434 \u0432\u043B\u0430\u0441\u0442\u044C\u044E
    \u0425\u0443\u0431\u0438\u043B\u0430\u044F. *   **\u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
    \u0443\u0447\u0438\u0442\u0435\u043B\u044C**: \u0421\u0430\u043C\u043E\u0435
    \u044F\u0440\u043A\u043E\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0435
    \u043D\u0430\u043C \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043E \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
    \u0432 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0438 \u043A
    \u0435\u0433\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u043C\u0443 \u0442\u0440\u0443\u0434\u0443,
    \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u043C \u0435\u0433\u043E
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u043E\u043C
    \u041C\u043E \u0416\u043E (Mo Ruo). \u041E\u043D\u043E \u0433\u043B\u0430\u0441\u0438\u0442,
    \u0447\u0442\u043E \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \"\u0441\u0442\u0430\u043B
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442 \u043A\u0430\u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A.
    \u041E\u043D \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0431\u043E\u043B\u0435\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
    \u043B\u0435\u0442, \u0438 \u0447\u0438\u0441\u043B\u043E \u0442\u0435\u0445,
    \u043A\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B \u043A \u043D\u0435\u043C\u0443
    \u0443\u0447\u0438\u0442\u044C\u0441\u044F, \u0440\u043E\u0441\u043B\u043E \u0441
    \u043A\u0430\u0436\u0434\u044B\u043C \u0434\u043D\u0435\u043C\". *   **\u0412\u043B\u0438\u044F\u043D\u0438\u0435
    \u044D\u043F\u043E\u0445\u0438**: \u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
    \u041A\u0438\u0442\u0430\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E
    \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E
    \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u043F\u043E \u0432\u0441\u0435\u0439 \u0441\u0442\u0440\u0430\u043D\u0435. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u044D\u0442\u0438\u043C \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F\u043C
    \u043E\u043D \u0441\u043C\u043E\u0433 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u0421\u0435\u0432\u0435\u0440\u0430
    \u0438 \u042E\u0433\u0430 \u041A\u0438\u0442\u0430\u044F, \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0438\u0432
    \u043C\u0435\u0442\u043E\u0434\u044B, \u0440\u0430\u043D\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435
    \u043B\u0438\u0448\u044C \u0432 \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0445
    \u0448\u043A\u043E\u043B\u0430\u0445.  ### \u041D\u0430\u0443\u0447\u043D\u043E\u0435
    \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435  \u0412\u0441\u0435\u043C\u0438\u0440\u043D\u0443\u044E
    \u0441\u043B\u0430\u0432\u0443 \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435
    \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438 \u0434\u0432\u0430 \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u0430\u043B\u0438 \u043A\u043B\u0430\u0441\u0441\u0438\u043A\u043E\u0439
    \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439 \u0438 \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.  **1. \xAB\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0432 \u0443\u0447\u0435\u043D\u0438\u0435 \u043E \u0441\u0447\u0451\u0442\u0435\xBB
    (\u7B97\u5B66\u542F\u8499, \u0421\u0443\u0430\u043D\u044C \u0441\u044E\u044D
