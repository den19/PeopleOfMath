    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E,
    \u0441 \u0435\u0433\u043E \u0442\u0440\u0443\u0434\u0430\u043C\u0438 \u0438 \u0441\u0443\u0434\u044C\u0431\u043E\u0439
    \u0435\u0433\u043E \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u044F \u0441\u0432\u044F\u0437\u0430\u043D\u043E
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0438 \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
    \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0444\u0430\u043A\u0442\u043E\u0432.  ### \U0001F4DC \u0418\u0441\u0442\u043E\u0440\u0438\u044F
    \xAB\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F\xBB \u0442\u0440\u0443\u0434\u043E\u0432,
    \u0443\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0445 \u043D\u0430 \u0440\u043E\u0434\u0438\u043D\u0435 
    \u0422\u043E, \u0447\u0442\u043E \u043C\u044B \u0437\u043D\u0430\u0435\u043C
    \u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u0427\u0436\u0443
    \u0428\u0438\u0446\u0437\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F, \u2014
    \u044D\u0442\u043E \u043F\u043E\u0447\u0442\u0438 \u0447\u0443\u0434\u043E. \u0415\u0433\u043E
    \u0433\u043B\u0430\u0432\u043D\u044B\u0435 \u0442\u0440\u0443\u0434\u044B, \u043E\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0435
    \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u0432\u043B\u0438\u044F\u043D\u0438\u0435
    \u043D\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0432 \u042F\u043F\u043E\u043D\u0438\u0438 \u0438 \u041A\u043E\u0440\u0435\u0435,
    \u0431\u044B\u043B\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u0443\u0442\u0435\u0440\u044F\u043D\u044B \u0432 \u0441\u0430\u043C\u043E\u043C
    \u041A\u0438\u0442\u0430\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    \u043A XVIII \u0432\u0435\u043A\u0443.  *   **\u041A\u043D\u0438\u0433\u0430,
    \u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0430\u044F\u0441\u044F \u0438\u0437
    \u041A\u043E\u0440\u0435\u0438**: \u0415\u0433\u043E \u0443\u0447\u0435\u0431\u043D\u0438\u043A
    \xAB\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 \u0443\u0447\u0435\u043D\u0438\u0435
    \u043E \u0441\u0447\u0451\u0442\u0435\xBB (1299) \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
    \u0432 \u042F\u043F\u043E\u043D\u0438\u0438 \u0438 \u041A\u043E\u0440\u0435\u0435
    \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u0439,
    \u0431\u044B\u043B \u043D\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D \u0432
    \u041A\u043E\u0440\u0435\u0435 \u0432 1433 \u0433\u043E\u0434\u0443 \u0438 \u0432
    \u042F\u043F\u043E\u043D\u0438\u0438 \u0432 1658-\u043C. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0432 \u041A\u0438\u0442\u0430\u0435 \u0435\u0433\u043E \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0430\u044F
    \u0432\u0435\u0440\u0441\u0438\u044F \u0431\u044B\u043B\u0430 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0430
    \u043B\u0438\u0448\u044C \u0432 XIX \u0432\u0435\u043A\u0435, \u043A\u043E\u0433\u0434\u0430
    \u043A\u043E\u0440\u0435\u0439\u0441\u043A\u043E\u0435 \u0438\u0437\u0434\u0430\u043D\u0438\u0435
    1660 \u0433\u043E\u0434\u0430 \u043F\u0435\u0440\u0435\u0432\u0435\u043B\u0438
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439
    \u044F\u0437\u044B\u043A. *   **\u0421\u043F\u0430\u0441\u0451\u043D\u043D\u0430\u044F
    \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C**: \u0412\u0442\u043E\u0440\u043E\u0439,
    \u0441\u0430\u043C\u044B\u0439 \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0435\u0433\u043E
    \u0442\u0440\u0443\u0434 \u2014 \xAB\u042F\u0448\u043C\u043E\u0432\u043E\u0435
    \u0437\u0435\u0440\u043A\u0430\u043B\u043E \u0447\u0435\u0442\u044B\u0440\u0451\u0445
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432\xBB \u2014 \u0442\u0430\u043A\u0436\u0435
    \u0441\u0447\u0438\u0442\u0430\u043B\u0441\u044F \u0443\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u043C.
    \u0417\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439 \u0431\u0438\u0431\u043B\u0438\u043E\u0433\u0440\u0430\u0444
    \u0416\u0443\u0430\u043D\u044C \u042E\u0430\u043D\u044C, \u043D\u0435 \u043D\u0430\u0439\u0434\u044F
    \u0435\u0433\u043E \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u0431\u043E\u0440\u043D\u0438\u043A\u0430
    \u0432 1799 \u0433\u043E\u0434\u0443, \u043F\u043E\u0437\u0436\u0435, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u043E\u043C \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438
    \u0427\u0436\u044D\u0446\u0437\u044F\u043D, \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
    \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0441\u044F \u043D\u0430 \u0441\u0438\u043B\u044C\u043D\u043E
    \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u043D\u0443\u044E \u043A\u043E\u043F\u0438\u044E.
    \u041E\u043D **\u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0440\u0443\u0447\u043D\u043E
    \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u0430\u043B \u0435\u0451**, \u0447\u0442\u043E\u0431\u044B
    \u0441\u043F\u0430\u0441\u0442\u0438 \u0442\u0435\u043A\u0441\u0442 \u0434\u043B\u044F
    \u043F\u043E\u0442\u043E\u043C\u043A\u043E\u0432. \u0411\u0435\u0437 \u044D\u0442\u043E\u0433\u043E
    \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u043D\u043E\u0433\u043E \u0441\u043F\u0438\u0441\u043A\u0430
    \u043C\u044B \u0431\u044B, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
    \u0437\u043D\u0430\u043B\u0438 \u043E \u0432\u0435\u0440\u0448\u0438\u043D\u0435
    \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439 \u0430\u043B\u0433\u0435\u0431\u0440\u044B. 
    ### \U0001F4A1 \xAB\u041D\u0435\u0443\u0447\u0435\u0431\u043D\u044B\u0435\xBB
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0440\u0430\u0434\u0438 \u043D\u0430\u0443\u043A\u0438 
    \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043C\u043D\u043E\u0433\u0438\u0445
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0435\u043C\u0443
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u0430\u0447\u0438\u0432\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445,
    \u0431\u044B\u0442\u043E\u0432\u044B\u0445 \u0438\u043B\u0438 \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447\u0430\u0445, \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435
    \u0432 \u0441\u0432\u043E\u0451\u043C \u0433\u043B\u0430\u0432\u043D\u043E\u043C
    \u0442\u0440\u0443\u0434\u0435 \u0447\u0430\u0441\u0442\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043A\u0430\u043A **\u0447\u0438\u0441\u0442\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F \u0434\u043B\u044F
    \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043C\u0435\u0442\u043E\u0434\u043E\u0432**.
    \u041E\u043D \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E \u0443\u0441\u043B\u043E\u0436\u043D\u044F\u043B
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F, \u0432\u0432\u043E\u0434\u044F \u043B\u0438\u0448\u043D\u0438\u0435
    \u0434\u0430\u043D\u043D\u044B\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
    \u043A\u0430\u043A \u0435\u0433\u043E \u043C\u043E\u0449\u043D\u044B\u0439 \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441 \u0441\u0430\u043C\u044B\u043C\u0438 \u0437\u0430\u043F\u0443\u0442\u0430\u043D\u043D\u044B\u043C\u0438
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u043C\u0438. \u0415\u0433\u043E
    \u0446\u0435\u043B\u044C\u044E \u0431\u044B\u043B\u0430 \u043D\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043F\u043E\u043B\u044C\u0437\u0430,
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u044F
    \u043A\u0440\u0430\u0441\u043E\u0442\u044B \u0438 \u0441\u0438\u043B\u044B \u0441\u0430\u043C\u043E\u0433\u043E
    \u043C\u0435\u0442\u043E\u0434\u0430.  ### \U0001F393 \u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435,
    \u043E\u0431\u043E\u0433\u043D\u0430\u0432\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F 
    \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435 \u043D\u0435 \u0431\u044B\u043B
    \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u043C \u043F\u0440\u0438
    \u0434\u0432\u043E\u0440\u0435, \u043E\u043D \u0431\u044B\u043B **\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C**, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043B \u043D\u0430
    \u0436\u0438\u0437\u043D\u044C \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u0435\u043C.
    \u0418\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u044F
    \u043A \u0435\u0433\u043E \u043A\u043D\u0438\u0433\u0435 \u043C\u044B \u0437\u043D\u0430\u0435\u043C,
    \u0447\u0442\u043E \u043E\u043D \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0431\u043E\u043B\u0435\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
    \u043B\u0435\u0442, \u0438 \u0447\u0438\u0441\u043B\u043E \u0435\u0433\u043E
    \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432 \u0440\u043E\u0441\u043B\u043E
    \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0434\u043D\u0451\u043C. \u0418\u043C\u0435\u043D\u043D\u043E
    \u044D\u0442\u0430 \xAB\u043D\u0430\u0440\u043E\u0434\u043D\u0430\u044F\xBB \u043A\u0430\u0440\u044C\u0435\u0440\u0430,
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0430
    \u0435\u043C\u0443 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u0421\u0435\u0432\u0435\u0440\u0430
    \u0438 \u042E\u0433\u0430 \u041A\u0438\u0442\u0430\u044F \u043F\u043E\u0441\u043B\u0435
    \u043C\u043E\u043D\u0433\u043E\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u0437\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u0438\u044F. 
    ### \u23F3 \u041E\u043F\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0435 \u0415\u0432\u0440\u043E\u043F\u044B
    \u043D\u0430 \u0432\u0435\u043A\u0430  \u041C\u043D\u043E\u0433\u0438\u0435 \u043C\u0435\u0442\u043E\u0434\u044B,
    \u043E\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435 \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435,
    \u0431\u044B\u043B\u0438 \xAB\u043F\u0435\u0440\u0435\u043E\u0442\u043A\u0440\u044B\u0442\u044B\xBB
    \u0432 \u0415\u0432\u0440\u043E\u043F\u0435 \u043B\u0438\u0448\u044C \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F
    \u0441\u043F\u0443\u0441\u0442\u044F, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
    \u0435\u0433\u043E \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u044E\u0449\u0438\u043C\u0438. 
    *   **\u0422\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A \u041F\u0430\u0441\u043A\u0430\u043B\u044F**,
    \u043F\u0440\u043E\u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0432 \u0435\u0433\u043E \u043A\u043D\u0438\u0433\u0435 1303 \u0433\u043E\u0434\u0430,
    \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0427\u0436\u0443
    \u0428\u0438\u0446\u0437\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u043B \xAB\u0434\u0440\u0435\u0432\u043D\u0438\u043C
    \u043C\u0435\u0442\u043E\u0434\u043E\u043C\xBB \u0438 \u043F\u0440\u0438\u043F\u0438\u0441\u044B\u0432\u0430\u043B
    \u0435\u0433\u043E \u0431\u043E\u043B\u0435\u0435 \u0440\u0430\u043D\u043D\u0435\u043C\u0443
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443 \u0426\u0437\u044F
    \u0421\u044F\u043D\u044E (\u043E\u043A. 1050 \u0433.). *   **\u041C\u0435\u0442\u043E\u0434
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
    \u0434\u043B\u044F \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u043A\u043E\u0440\u043D\u0435\u0439 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439
    \u0432\u043F\u043B\u043E\u0442\u044C \u0434\u043E 14-\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438,
    \u0432 \u0415\u0432\u0440\u043E\u043F\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u043A\u0430\u043A **\u043C\u0435\u0442\u043E\u0434 \u0413\u043E\u0440\u043D\u0435\u0440\u0430**
    (\u043E\u0442\u043A\u0440\u044B\u0442 \u0432 XIX \u0432\u0435\u043A\u0435). *  
    \u0415\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434 \u043A \u0440\u0435\u0448\u0435\u043D\u0438\u044E
    \u0441\u0438\u0441\u0442\u0435\u043C \u043B\u0438\u043D\u0435\u0439\u043D\u044B\u0445
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439, \u043F\u043E \u0441\u0443\u0442\u0438,
    \u0431\u044B\u043B \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442\u0435\u043D
    **\u043C\u0435\u0442\u043E\u0434\u0443 \u0413\u0430\u0443\u0441\u0441\u0430**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432 \u0415\u0432\u0440\u043E\u043F\u0435
    \u0431\u044B\u043B \u0444\u043E\u0440\u043C\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D
    \u043B\u0438\u0448\u044C \u0432 XIX \u0432\u0435\u043A\u0435.  ### \u2753 \u0417\u0430\u0433\u0430\u0434\u043A\u0430
    \u0434\u043B\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u043E\u0432  \u041E\u0434\u043D\u0430
    \u0438\u0437 \u0433\u043B\u0430\u0432\u043D\u044B\u0445 \u0438\u043D\u0442\u0440\u0438\u0433
    \u0434\u043B\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u043E\u0432 \u043D\u0430\u0443\u043A\u0438
    \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u0432 \u0442\u043E\u043C,
    \u0447\u0442\u043E, \u0445\u043E\u0442\u044F \u0427\u0436\u0443 \u0428\u0438\u0446\u0437\u0435
    \u0431\u044B\u043B \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u043E\u043C
    \u0438 \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u043E\u043C \u0442\u0440\u0451\u0445
    \u0434\u0440\u0443\u0433\u0438\u0445 \u0432\u0435\u043B\u0438\u043A\u0438\u0445
    \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432
    XIII \u0432\u0435\u043A\u0430 (\u0426\u0438\u043D\u044C \u0426\u0437\u044E\u0448\u0430\u043E,
    \u041B\u0438 \u0415 \u0438 \u042F\u043D \u0425\u0443\u044D\u044F), \u0438\u0437
    \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442 \u043D\u0435\u044F\u0441\u043D\u043E,
    \u0431\u044B\u043B \u043B\u0438 \u043E\u043D \u0437\u043D\u0430\u043A\u043E\u043C
    \u0441 \u0438\u0445 \u0442\u0440\u0443\u0434\u0430\u043C\u0438. \u0415\u0433\u043E
    \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u043B\u0430\u0441\u044C \u0432 \u0442\u043E\u043C,
    \u0447\u0442\u043E \u043E\u043D \u043F\u0440\u0438\u0448\u0451\u043B \u043A \u0441\u0432\u043E\u0438\u043C
    \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F\u043C \u0441\u0432\u043E\u0438\u043C
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043F\u0443\u0442\u0451\u043C,
    \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u044F\u0432\u043B\u044F\u044F\u0441\u044C
    \u0438 \u0432\u0435\u0440\u0448\u0438\u043D\u043E\u0439, \u0438 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u043C
    \xAB\u043E\u0434\u0438\u043D\u043E\u0447\u043A\u043E\u0439\xBB \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438."
