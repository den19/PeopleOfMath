  achievementsRu: ". \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0430
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0432\u0441\u044e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0444\u0438\u0437\u0438\u043a\u0443 \u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u2014 \u043e\u0442 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0445
    \u0442\u0435\u043b \u0434\u043e \u043f\u0440\u0438\u0440\u043e\u0434\u044b \u0441\u0432\u0435\u0442\u0430
    \u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b,
    \u0447\u0430\u0441\u0442\u043e \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435
    \u0432 \u0432\u0438\u0434\u0435 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0445
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432,
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u043b\u044f
    \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0447\u0435\u043d\u044b\u0445.\n\n\U0001F4D0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u041e\u0442 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u03c0 \u0434\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0431\u044b\u0441\u0442\u0440\u043e \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f.
    \u0415\u0433\u043e \u0440\u0430\u043d\u043d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0431\u044b\u043b\u0438 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u044b \u0440\u0435\u0448\u0435\u043d\u0438\u044e
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u0447
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438: \u0412\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u0447\u0438\u0441\u043b\u0430 \u03c0 \u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u0430
    \u043a\u0440\u0443\u0433\u0430: \u0412 1654 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \"\u041e\u0431 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438\"
    (De Circuli Magnitudine Inventa), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0434\u043b\u0438\u043d\u044b \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438
    \u043a \u0434\u0438\u0430\u043c\u0435\u0442\u0440\u0443. \u041f\u043e\u0437\u0436\u0435
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u043f\u043e \u044d\u0442\u043e\u0439
    \u0442\u0435\u043c\u0435 \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u0432 \u0441\u0431\u043e\u0440\u043d\u0438\u043a\u0435 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430,
    \u041b\u0430\u043c\u0431\u0435\u0440\u0442\u0430 \u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439:
    \u0415\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \"\u041e \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u0445
    \u043f\u0440\u0438 \u0438\u0433\u0440\u0435 \u0432 \u043a\u043e\u0441\u0442\u0438\" (De
    Ratiociniis in Ludo Aleae, 1657) \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u0438\u0432\u044b\u0445:
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u044b, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u044b\u0435
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u044b,
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438 \u0446\u0435\u043f\u043d\u043e\u0439 \u043b\u0438\u043d\u0438\u0439. \u0412 \u0445\u043e\u0434\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0434 \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u043c\u0438
    \u0447\u0430\u0441\u0430\u043c\u0438 \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u0432\u043e\u043b\u044e\u0442 \u043f\u043b\u043e\u0441\u043a\u0438\u0445
    \u043a\u0440\u0438\u0432\u044b\u0445 \u0438, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u044d\u0432\u043e\u043b\u044e\u0442\u0430
    \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u044b \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0442\u0430\u043a\u0436\u0435 \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u043e\u0439.\n\n\U0001F52D
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f: \u0420\u0430\u0437\u0433\u0430\u0434\u043a\u0430
    \u0442\u0430\u0439\u043d \u0421\u0430\u0442\u0443\u0440\u043d\u0430 \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0441\u0432\u043e\u0438\u043c \u0443\u0441\u043f\u0435\u0445\u0430\u043c \u0432 \u043e\u043f\u0442\u0438\u043a\u0435,
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043f\u0440\u043e\u0440\u044b\u0432\u043d\u044b\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f: \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0422\u0438\u0442\u0430\u043d\u0430: \u0412 \u043c\u0430\u0440\u0442\u0435 1655 \u0433\u043e\u0434\u0430
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e
    \u0438\u043c \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430 \u043e\u043d \u043e\u0442\u043a\u0440\u044b\u043b
    \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0439 \u0441\u043f\u0443\u0442\u043d\u0438\u043a
    \u0421\u0430\u0442\u0443\u0440\u043d\u0430 \u2014 \u0422\u0438\u0442\u0430\u043d. \u0420\u0430\u0437\u0433\u0430\u0434\u043a\u0430
    \u043a\u043e\u043b\u0435\u0446 \u0421\u0430\u0442\u0443\u0440\u043d\u0430: \u041e\u043d
    \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e
    \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u044b\u0435
    \"\u043f\u0440\u0438\u0434\u0430\u0442\u043a\u0438\" \u0421\u0430\u0442\u0443\u0440\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b
    \u0435\u0449\u0435 \u0413\u0430\u043b\u0438\u043b\u0435\u0439. \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b, \u0447\u0442\u043e \u0421\u0430\u0442\u0443\u0440\u043d
    \u043e\u043a\u0440\u0443\u0436\u0435\u043d \u0442\u043e\u043d\u043a\u0438\u043c \u043a\u043e\u043b\u044c\u0446\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043d\u0438\u0433\u0434\u0435 \u043d\u0435 \u043f\u0440\u0438\u043b\u0435\u0433\u0430\u0435\u0442
    \u043a \u043f\u043b\u0430\u043d\u0435\u0442\u0435 \u0438 \u043d\u0430\u043a\u043b\u043e\u043d\u0435\u043d\u043e
    \u043a \u044d\u043a\u043b\u0438\u043f\u0442\u0438\u043a\u0435. \u0421\u0432\u043e\u0438
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u043e\u043d \u043e\u0431\u043e\u0431\u0449\u0438\u043b
    \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0421\u0430\u0442\u0443\u0440\u043d\u0430\"
    (Systema Saturnium, 1659). \u0414\u0440\u0443\u0433\u0438\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f:
    \u0412 \u0442\u043e\u0439 \u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d
    \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0442\u0443\u043c\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u0441\u043e\u0437\u0432\u0435\u0437\u0434\u0438\u0438
    \u041e\u0440\u0438\u043e\u043d\u0430 \u0438 \u0441\u043e\u043e\u0431\u0449\u0438\u043b \u043e
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0438 \u043f\u043e\u043b\u043e\u0441
    \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445 \u042e\u043f\u0438\u0442\u0435\u0440\u0430
    \u0438 \u041c\u0430\u0440\u0441\u0430.\n\n\u2699\ufe0f \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430
    \u0438 \u0445\u0440\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041e\u0442
    \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u0430 \u043a \u0437\u0430\u043a\u043e\u043d\u0430\u043c
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435
    \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0444\u0438\u0437\u0438\u043a\u0438. \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0445 \u0447\u0430\u0441\u043e\u0432:
    \u0412 1656\u20131657 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u0438\u0437\u043e\u0431\u0440\u0435\u043b
    \u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0435 \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0435
    \u0447\u0430\u0441\u044b \u0441\u043e \u0441\u043f\u0443\u0441\u043a\u043e\u0432\u044b\u043c
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u043e\u043c, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0435\u0439 \u0432 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \"\u041c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0435 \u0447\u0430\u0441\u044b\"
    (Horologium Oscillatorium, 1673): \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430 \u0432 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435.
    \u0412 \u043d\u0435\u043c \u043e\u043d: \u0414\u0430\u043b \u043f\u043e\u043b\u043d\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u0430
    \u0438 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u0435\u0433\u043e \u0446\u0435\u043d\u0442\u0440\u0430
    \u043a\u0430\u0447\u0430\u043d\u0438\u044f \u2014 \u044d\u0442\u043e \u0431\u044b\u043b\u0430
    \u043f\u0435\u0440\u0432\u0430\u044f \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0443\u0441\u043f\u0435\u0448\u043d\u043e
    \u0440\u0435\u0448\u0435\u043d\u043d\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430 \u043e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0442\u0435\u043b. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0442\u0430\u0443\u0442\u043e\u0445\u0440\u043e\u043d\u043d\u043e\u0441\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043e \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u0435 (\u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c
    \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439
    \u043e\u0442 \u0430\u043c\u043f\u043b\u0438\u0442\u0443\u0434\u044b). \u0412\u044b\u0432\u0435\u043b
    \u0437\u0430\u043a\u043e\u043d\u044b \u0446\u0435\u043d\u0442\u0440\u043e\u0431\u0435\u0436\u043d\u043e\u0439
    \u0441\u0438\u043b\u044b \u0434\u043b\u044f \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043e \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438
    \u0437\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0435 \u0434\u043e
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430. \u0417\u0430\u043a\u043e\u043d\u044b \u0441\u043e\u0443\u0434\u0430\u0440\u0435\u043d\u0438\u044f:
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0437\u0430\u043a\u043e\u043d\u044b
    \u0443\u043f\u0440\u0443\u0433\u043e\u0433\u043e \u0441\u043e\u0443\u0434\u0430\u0440\u0435\u043d\u0438\u044f
    \u0442\u0435\u043b. \u041e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u044d\u0442\u0443
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 1656 \u0433\u043e\u0434\u0443, \u043d\u043e
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430 \u043e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e. \u0412
    \u0445\u043e\u0434\u0435 \u044d\u0442\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u043e\u043d, \u043f\u043e \u0441\u0443\u0442\u0438, \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u043f\u043e\u043d\u044f\u0432, \u0447\u0442\u043e
    \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432
    \u0438\u043c\u0435\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c
    \u0442\u0435\u043b.\n\n\U0001F4A1 \u041e\u043f\u0442\u0438\u043a\u0430: \u0422\u0440\u0438\u0443\u043c\u0444
    \u0432\u043e\u043b\u043d\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u0412\u043a\u043b\u0430\u0434
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430 \u0432 \u043e\u043f\u0442\u0438\u043a\u0443
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438. \u0423\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432: \u0414\u043b\u044f \u0441\u0432\u043e\u0438\u0445
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439 \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u043e\u0432\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b \u0448\u043b\u0438\u0444\u043e\u0432\u043a\u0438
    \u043b\u0438\u043d\u0437 \u0438 \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b
    \u043e\u043a\u0443\u043b\u044f\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e
    \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u043e\u0441\u0438\u0442 \u0435\u0433\u043e
    \u0438\u043c\u044f. \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u0441\u0432\u0435\u0442\u0435\"
    (Trait\u00e9 de la Lumi\u00e8re, 1690): \u0412 \u044d\u0442\u043e\u043c \u0442\u0440\u0443\u0434\u0435
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441 \u043f\u043e\u043b\u043d\u043e\u0439
    \u044f\u0441\u043d\u043e\u0441\u0442\u044c\u044e \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u0432\u043e\u043b\u043d\u043e\u0432\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u0441\u0432\u0435\u0442\u0430.
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430:
    \u041e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043a\u0430\u0436\u0434\u0430\u044f \u0442\u043e\u0447\u043a\u0430
    \u0432\u043e\u043b\u043d\u043e\u0432\u043e\u0433\u043e \u0444\u0440\u043e\u043d\u0442\u0430
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c
    \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0445 \u0432\u043e\u043b\u043d. \u042d\u0442\u043e\u0442
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u0432\u043e\u043b\u043d\u043e\u0432\u043e\u0439
    \u043e\u043f\u0442\u0438\u043a\u0438 \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442
    \u0437\u0430\u043a\u043e\u043d\u044b \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0438 \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f. \u0414\u0432\u043e\u0439\u043d\u043e\u0435
    \u043b\u0443\u0447\u0435\u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u0435:
    \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0441\u0432\u043e\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u043d \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b
    \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u043e\u0435 \u044f\u0432\u043b\u0435\u043d\u0438\u0435
    \u0434\u0432\u043e\u0439\u043d\u043e\u0433\u043e \u043b\u0443\u0447\u0435\u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430 \u0432 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u0430\u0445
    \u0438\u0441\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0433\u043e \u0448\u043f\u0430\u0442\u0430.
    \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
    \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u0432 \u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0434\u043d\u043e\u043e\u0441\u043d\u044b\u0445 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u0430\u0445
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438\u0437\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f
    \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b.\n\n\U0001F30C
    \u041f\u043e\u0437\u0434\u043d\u0438\u0435 \u0442\u0440\u0443\u0434\u044b: \u0413\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044f
    \u0438 \u0436\u0438\u0437\u043d\u044c \u0432\u043e \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439
    \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0441\u044f \u043a \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c
    \u043c\u0438\u0440\u043e\u0437\u0434\u0430\u043d\u0438\u044f: \u041e \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u0445
    \u0442\u044f\u0436\u0435\u0441\u0442\u0438: \u0412 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438
    \u043a \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442\u0443 \u043e \u0441\u0432\u0435\u0442\u0435\"
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \"\u0420\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435
    \u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u0445 \u0442\u044f\u0436\u0435\u0441\u0442\u0438\"
    (Discours de la cause de la pesanteur), \u0433\u0434\u0435 \u0434\u0430\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438
    \u0447\u0435\u0440\u0435\u0437 \u043a\u0430\u0440\u0442\u0435\u0437\u0438\u0430\u043d\u0441\u043a\u0438\u0435
    \u0432\u0438\u0445\u0440\u0438. \u0425\u043e\u0442\u044f \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f
    \u043d\u0435 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438
    \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c, \u043e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0431\u043b\u0438\u0437\u043a\u043e \u043f\u043e\u0434\u043e\u0448\u0435\u043b \u043a \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044e
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f. \"\u041a\u043e\u0441\u043c\u043e\u0442\u0435\u043e\u0440\u043e\u0441\"
    (Cosmotheoros, 1698): \u042d\u0442\u043e\u0442 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0439
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439
    \u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u043e\u0431\u0438\u0442\u0430\u0435\u043c\u044b\u0445 \u043c\u0438\u0440\u043e\u0432. \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u043b, \u0447\u0442\u043e \u0436\u0438\u0437\u043d\u044c
    \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u0445
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u0438 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430
    \u0441\u0438\u043b\u044c\u043d\u043e \u043e\u0442\u043b\u0438\u0447\u0430\u0442\u044c\u0441\u044f
    \u043e\u0442 \u0437\u0435\u043c\u043d\u043e\u0439. \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430
    \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u0430 \u043d\u0430
    \u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a \u0432 1717 \u0433\u043e\u0434\u0443
    \u043f\u043e \u043b\u0438\u0447\u043d\u043e\u043c\u0443 \u043f\u0440\u0438\u043a\u0430\u0437\u0443
    \u041f\u0435\u0442\u0440\u0430 I. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0442\u043e, \u0447\u0442\u043e \u0432 XVIII \u0432\u0435\u043a\u0435 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u0431\u044b\u043b\u0438 \u043e\u0442\u0447\u0430\u0441\u0442\u0438
    \u0437\u0430\u0442\u043c\u0435\u043d\u044b \u0444\u0438\u0433\u0443\u0440\u043e\u0439 \u041d\u044c\u044e\u0442\u043e\u043d\u0430,
    \u0438\u043c\u0435\u043d\u043d\u043e \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043f\u0440\u043e\u0447\u043d\u044b\u0439 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u041d\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0415\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434, \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u044e\u0449\u0438\u0439
    \u0438\u0437\u044f\u0449\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0441 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u043c \u0433\u0435\u043d\u0438\u0435\u043c,
    \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u0437
    \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u0438\u0433\u0443\u0440
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438."
  achievementsEn: 
  personalLifeRu: "\u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 14 \u0430\u043f\u0440\u0435\u043b\u044f 1629
    \u0433\u043e\u0434\u0430 \u0432 \u0413\u0430\u0430\u0433\u0435 \u0432 \u043e\u0447\u0435\u043d\u044c
    \u0431\u043e\u0433\u0430\u0442\u043e\u0439 \u0438 \u0437\u043d\u0430\u0442\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0435\u0439\u043d
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441, \u0431\u044b\u043b \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u043e\u043c
    \u0438 \u0442\u0430\u0439\u043d\u044b\u043c \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c
    \u043f\u0440\u0438\u043d\u0446\u0435\u0432 \u041e\u0440\u0430\u043d\u0441\u043a\u0438\u0445,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u043f\u043e\u044d\u0442\u043e\u043c
    \u0438 \u0443\u0447\u0435\u043d\u044b\u043c, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0432\u0448\u0438\u043c
    \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0442\u0430\u043a\u043e\u043c\u0443 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044e
    \u043e\u0442\u0446\u0430, \u0432 \u0434\u043e\u043c\u0435 \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u043e\u0432
    \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u0432\u0430\u043b\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044b \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u041c\u0430\u0442\u044c \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0430,
    \u0421\u044e\u0437\u0430\u043d\u043d\u0430 \u0432\u0430\u043d \u0411\u0430\u0440\u043b\u0435,
    \u0443\u043c\u0435\u0440\u043b\u0430, \u043a\u043e\u0433\u0434\u0430 \u0435\u043c\u0443
    \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e \u0432\u043e\u0441\u0435\u043c\u044c
    \u043b\u0435\u0442.\n\n\U0001F4DA \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438 \u0440\u0430\u043d\u043d\u044f\u044f \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u043d\u043e\u0435
    \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u0415\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438
    \u0435\u0433\u043e \"\u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043f\u0430\u043c\u044f\u0442\u044c\" \u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \"\u0447\u0443\u0434\u043e\u043c \u0441\u0440\u0435\u0434\u0438 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u043e\u0432\".
    \u041e\u043d \u0440\u0430\u043d\u043e \u043e\u0441\u0432\u043e\u0438\u043b \u043b\u0430\u0442\u044b\u043d\u044c,
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u0438 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a\u0438,
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443, \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e. \u0414\u0435\u043a\u0430\u0440\u0442,
    \u0431\u044b\u0432\u0430\u0432\u0448\u0438\u0439 \u0432 \u0434\u043e\u043c\u0435 \u0435\u0433\u043e
    \u043e\u0442\u0446\u0430, \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0443\u0441\u043f\u0435\u0445\u0430\u043c \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0430. \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u044b:
    \u0412 1645 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    16 \u043b\u0435\u0442, \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041b\u0435\u0439\u0434\u0435\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b \u043f\u0440\u0430\u0432\u043e \u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f: \u0421 1647 \u043f\u043e
    1649 \u0433\u043e\u0434 \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0432 \u041e\u0440\u0430\u043d\u0436-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u0440\u0435\u0434\u0430. \u0415\u0433\u043e
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0432 \u041b\u0435\u0439\u0434\u0435\u043d\u0435
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0424\u0440\u0430\u043d\u0441 \u0432\u0430\u043d \u0421\u0445\u043e\u0442\u0435\u043d.
    \u0421\u0442\u0435\u043f\u0435\u043d\u044c: \u0412 1655 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0437\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043a\u0442\u043e\u0440\u0430
    \u044e\u0440\u0438\u0441\u043f\u0440\u0443\u0434\u0435\u043d\u0446\u0438\u0438 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0410\u043d\u0442\u0432\u0435\u0440\u043f\u0435\u043d\u0430.\n\n\U0001F4BC \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435
    \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0438 \u043d\u0435 \u0438\u043c\u0435\u043b
    \u0434\u0435\u0442\u0435\u0439. \u041e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c \u043d\u0430\u0443\u043a\u0435.
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c
    \u2014 \u043e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u0432 \u043c\u0438\u0433\u0440\u0435\u043d\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u043d\u043e\u0433\u0434\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438
    \u0435\u0433\u043e \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u0443.\n\n\U0001F52C
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0413\u044e\u0439\u0433\u0435\u043d\u0441,
    \u0432\u043e\u043f\u0440\u0435\u043a\u0438 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f\u043c
    \u043e\u0442\u0446\u0430, \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0435\u043b \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0441\u043b\u0443\u0436\u0431\u0435. \u0415\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e:
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f:
    \u0412 1651 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443, \u0430 \u0432 1657 \u0433\u043e\u0434\u0443 \u2014
    \u043e\u0434\u0438\u043d \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f: \u0412 1655 \u0433\u043e\u0434\u0443,
    \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u0432
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f, \u043e\u043d \u043e\u0442\u043a\u0440\u044b\u043b
    \u0441\u043f\u0443\u0442\u043d\u0438\u043a \u0421\u0430\u0442\u0443\u0440\u043d\u0430 \u2014
    \u0422\u0438\u0442\u0430\u043d, \u0430 \u0432 1659 \u0433\u043e\u0434\u0443 \u0440\u0430\u0437\u0433\u0430\u0434\u0430\u043b
    \u0437\u0430\u0433\u0430\u0434\u043a\u0443 \u043a\u043e\u043b\u0435\u0446 \u0421\u0430\u0442\u0443\u0440\u043d\u0430.
    \u041c\u0438\u0440\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435:
    \u0421\u043b\u0430\u0432\u0430 \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430 \u0431\u044b\u0441\u0442\u0440\u043e
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c
    \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435. \u0412 1663 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 (1665-1681): \u042d\u0442\u043e \u0431\u044b\u043b
    \u0441\u0430\u043c\u044b\u0439 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0439
    \u044d\u0442\u0430\u043f \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u041f\u043e
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430 \u041a\u043e\u043b\u044c\u0431\u0435\u0440\u0430
    \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u041f\u0430\u0440\u0438\u0436
    \u0438 \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0438 \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a. \u041e\u043d \u043f\u0440\u043e\u0436\u0438\u043b \u0442\u0430\u043c
    16 \u043b\u0435\u0442, \u043e\u0431\u0449\u0430\u044f\u0441\u044c \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0430
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430. \u0412 1673 \u0433\u043e\u0434\u0443 \u0432
    \u041f\u0430\u0440\u0438\u0436\u0435 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u043f\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u2014 \"\u041c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0435
    \u0447\u0430\u0441\u044b\". \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u044e (1681-1695): \u0418\u0437-\u0437\u0430
    \u0443\u0445\u0443\u0434\u0448\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0438 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0438\u0445 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0445
    \u0433\u043e\u043d\u0435\u043d\u0438\u0439 \u043d\u0430 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u043e\u0432
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0432 1681 \u0433\u043e\u0434\u0443 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u0413\u0430\u0430\u0433\u0443. \u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441
    \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c: \u0412 1689 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u0441\u0435\u0442\u0438\u043b \u041b\u043e\u043d\u0434\u043e\u043d, \u0433\u0434\u0435
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0441\u044f \u0441 \u0418\u0441\u0430\u0430\u043a\u043e\u043c
    \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c. \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u0443\u043c\u0435\u0440 \u0432 \u0413\u0430\u0430\u0433\u0435
    8 \u0438\u044e\u043b\u044f 1695 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    66 \u043b\u0435\u0442."
  personalLifeEn: 
  shortBioRu: "\u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0432\u0430\u043d \u0417\u0451\u0439\u043b\u0438\u0445\u0435\u043c (Christiaan Huygens)
    \u2014 \u043e\u0434\u043d\u0430 \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0444\u0438\u0433\u0443\u0440 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    XVII \u0432\u0435\u043a\u0430. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0430\u044f
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c, \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435
    \u0438 \u0432\u0441\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f. 1. \u0421\u0435\u043c\u044c\u044f
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b (1629\u20131645) \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 14
    \u0430\u043f\u0440\u0435\u043b\u044f 1629 \u0433\u043e\u0434\u0430 \u0432 \u0413\u0430\u0430\u0433\u0435,
    \u0432 \u0431\u043e\u0433\u0430\u0442\u043e\u0439 \u0438 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0438\u043d
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 (1596\u20131687), \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438: \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u043c
    \u043f\u043e\u044d\u0442\u043e\u043c, \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u043e\u043c,
    \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u043e\u043c \u0438 \u0442\u0430\u0439\u043d\u044b\u043c
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c \u043f\u0440\u0438\u043d\u0446\u0435\u0432
    \u041e\u0440\u0430\u043d\u0441\u043a\u0438\u0445. \u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0438\u043d
    \u0431\u044b\u043b \u0448\u0438\u0440\u043e\u043a\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d,
    \u0437\u043d\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044f\u0437\u044b\u043a\u043e\u0432
    \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441\u043e \u043c\u043d\u043e\u0433\u0438\u043c\u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u0430\u043c\u0438
    \u044d\u043f\u043e\u0445\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0420\u0435\u043d\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u043d\u043e\u0433\u0434\u0430
    \u0431\u044b\u0432\u0430\u043b \u0432 \u0438\u0445 \u0434\u043e\u043c\u0435. \u0418\u043c\u0435\u043d\u043d\u043e
    \u043e\u0442\u0435\u0446 \u043f\u0440\u0438\u0432\u0438\u043b \u0441\u044b\u043d\u0443 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043d\u0430\u0443\u043a\u0430\u043c \u0438 \u0434\u0430\u043b \u0435\u043c\u0443
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u041e\u0434\u0430\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0430 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c
    \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u043d\u043e. \u0415\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u043f\u0438\u0441\u0430\u043b \u043e \u043d\u0435\u043c \u043a\u0430\u043a \u043e \"\u0447\u0443\u0434\u0435
    \u0441\u0440\u0435\u0434\u0438 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u043e\u0432\".
    \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u043b\u0430\u0442\u044b\u043d\u044c, \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439,
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u0438 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a\u0438, \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443,
    \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044e, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043e\u0441\u0432\u043e\u0438\u043b \u0438\u0433\u0440\u0443
    \u043d\u0430 \u043a\u043b\u0430\u0432\u0435\u0441\u0438\u043d\u0435 \u0438 \u0443\u0432\u043b\u0435\u043a\u0441\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u043e\u0439. 2. \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 (1645\u20131654)
    \u0412 1645 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    16 \u043b\u0435\u0442, \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041b\u0435\u0439\u0434\u0435\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b \u043f\u0440\u0430\u0432\u043e \u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c
    \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0437\u043c\u043e\u043c \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0424\u0440\u0430\u043d\u0441\u0430
    \u0432\u0430\u043d \u0421\u0445\u043e\u0442\u0435\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0442\u043c\u0435\u0442\u0438\u043b \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442
    \u0438 \u0434\u0430\u0436\u0435 \u043f\u0435\u0440\u0435\u0441\u044b\u043b\u0430\u043b \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u0414\u0435\u043a\u0430\u0440\u0442\u0443. \u0412
    1647 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u041e\u0440\u0430\u043d\u0441\u043a\u043e\u0439
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438\u0438 \u0432 \u0411\u0440\u0435\u0434\u0435,
    \u0433\u0434\u0435 \u043f\u0440\u043e\u0443\u0447\u0438\u043b\u0441\u044f \u0434\u043e 1649
    \u0433\u043e\u0434\u0430. \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u043d\u043e
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u043f\u043e\u0437\u0436\u0435 \u043e\u043d \u043e\u0442\u043e\u0448\u0435\u043b \u043e\u0442
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0439,
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0435\u0433\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435. \u041f\u043e
    \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0438 \u0443\u0447\u0435\u0431\u044b \u043e\u0442\u0435\u0446
    \u043f\u0440\u043e\u0447\u0438\u043b \u0435\u043c\u0443 \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438\u043b\u0438 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u043b\u0443\u0436\u0431\u0443, \u043e\u0434\u043d\u0430\u043a\u043e \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d
    \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0435\u043b \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443. \u0412 1655 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0437\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043a\u0442\u043e\u0440\u0430
    \u044e\u0440\u0438\u0441\u043f\u0440\u0443\u0434\u0435\u043d\u0446\u0438\u0438 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0410\u043d\u0442\u0432\u0435\u0440\u043f\u0435\u043d\u0430, \u043d\u043e \u044d\u0442\u043e
    \u0431\u044b\u043b\u043e \u0441\u043a\u043e\u0440\u0435\u0435 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e.
    3. \u041f\u0435\u0440\u0432\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0443\u0441\u043f\u0435\u0445\u0438
    (1651\u20131657) \u041a\u0440\u0443\u0433 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430 \u0431\u044b\u043b \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u043e
    \u0448\u0438\u0440\u043e\u043a. \u0421\u0432\u043e\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u043d \u043d\u0430\u0447\u0430\u043b
    \u0432 1651 \u0433\u043e\u0434\u0443 \u0441 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u043e\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e
    \u0434\u043b\u0438\u043d\u044b \u0434\u0443\u0433 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438,
    \u044d\u043b\u043b\u0438\u043f\u0441\u0430 \u0438 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u044b.
    \u0412 1654 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430 \u0435\u0433\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \"\u041e\u0431 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438\",
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0430
    \u0432\u0430\u0436\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 \u0432 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0447\u0438\u0441\u043b\u0430
    \u03c0. \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0432
    \u0432 1657 \u0433\u043e\u0434\u0443 \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \"\u041e
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445 \u043f\u0440\u0438 \u0438\u0433\u0440\u0435
    \u0432 \u043a\u043e\u0441\u0442\u0438\" \u2014 \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442 \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.
    \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f
    \u043e\u043f\u0442\u0438\u043a\u043e\u0439 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439.
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441\u043e \u0441\u0432\u043e\u0438\u043c
    \u0441\u0442\u0430\u0440\u0448\u0438\u043c \u0431\u0440\u0430\u0442\u043e\u043c \u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0438\u043d\u043e\u043c
    \u043e\u043d \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u0432
    \u043d\u043e\u0432\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b \u0448\u043b\u0438\u0444\u043e\u0432\u043a\u0438
    \u043b\u0438\u043d\u0437, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b
    \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\u043c.
    4. \u0417\u043e\u043b\u043e\u0442\u043e\u0439 \u0432\u0435\u043a \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439
    (1655\u20131665) \u042d\u0442\u043e \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043c \u0441\u0430\u043c\u044b\u0445
    \u044f\u0440\u043a\u0438\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430:
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f: \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0441\u0432\u043e\u0439 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f, 25 \u043c\u0430\u0440\u0442\u0430 1655
    \u0433\u043e\u0434\u0430 \u043e\u043d \u043e\u0442\u043a\u0440\u044b\u043b \u0441\u0430\u043c\u044b\u0439
    \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0441\u043f\u0443\u0442\u043d\u0438\u043a \u0421\u0430\u0442\u0443\u0440\u043d\u0430
    \u2014 \u0422\u0438\u0442\u0430\u043d. \u0421\u0430\u043c\u044b\u043c \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0441\u0442\u0430\u043b\u043e
    \u0440\u0430\u0437\u0433\u0430\u0434\u043a\u0430 \u0437\u0430\u0433\u0430\u0434\u043a\u0438
    \u0421\u0430\u0442\u0443\u0440\u043d\u0430: \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u043f\u0435\u0440\u0432\u044b\u043c
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b,
    \u0447\u0442\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \"\u043f\u0440\u0438\u0434\u0430\u0442\u043a\u0438\"
    \u043f\u043b\u0430\u043d\u0435\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0438\u0434\u0435\u043b
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439, \u043d\u0430 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0442\u043e\u043d\u043a\u0438\u043c
    \u043a\u043e\u043b\u044c\u0446\u043e\u043c, \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u043c
    \u043f\u043b\u0430\u043d\u0435\u0442\u0443 \u0438 \u043d\u0435 \u0441\u043e\u043f\u0440\u0438\u043a\u0430\u0441\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0441 \u043d\u0435\u0439. \u0421\u0432\u043e\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f
    \u043e\u043d \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0421\u0430\u0442\u0443\u0440\u043d\u0430\"
    (1659). \u0412 \u044d\u0442\u043e\u0439 \u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0442\u0443\u043c\u0430\u043d\u043d\u043e\u0441\u0442\u0438
    \u041e\u0440\u0438\u043e\u043d\u0430 \u0438 \u043e\u0442\u043c\u0435\u0442\u0438\u043b \u043f\u043e\u043b\u043e\u0441\u044b
    \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u042e\u043f\u0438\u0442\u0435\u0440\u0430
    \u0438 \u041c\u0430\u0440\u0441\u0430. \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0445 \u0447\u0430\u0441\u043e\u0432:
    \u0422\u043e\u0447\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0431\u044b\u043b\u0438 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0430\u0436\u043d\u044b \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    \u0412 1656\u20131657 \u0433\u043e\u0434\u0430\u0445 \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0435 \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0435
    \u0447\u0430\u0441\u044b \u0441\u043e \u0441\u043f\u0443\u0441\u043a\u043e\u0432\u044b\u043c
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u043e\u043c. \u042d\u0442\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0445\u0440\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e. \u0421\u0432\u043e\u044e
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \"\u041c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0435
    \u0447\u0430\u0441\u044b\" (1658). 5. \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    (1665\u20131681) \u0421\u043b\u0430\u0432\u0430 \u043e \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0435
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c
    \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435. \u0412 1663 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0412 1665 \u0433\u043e\u0434\u0443,
    \u043f\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e \u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432 \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u0416\u0430\u043d\u0430-\u0411\u0430\u0442\u0438\u0441\u0442\u0430 \u041a\u043e\u043b\u044c\u0431\u0435\u0440\u0430,
    \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u041f\u0430\u0440\u0438\u0436
    \u0438 \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0438 \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    (\u043f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u0435\u043c) \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u0415\u043c\u0443
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u0449\u0435\u0434\u0440\u0430\u044f
    \u043f\u0435\u043d\u0441\u0438\u044f \u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b
    \u0430\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u044b \u0432 \u0437\u0434\u0430\u043d\u0438\u0438
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438. \u0412 \u041f\u0430\u0440\u0438\u0436\u0435
    \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b 16 \u043b\u0435\u0442 (\u0441 1665 \u043f\u043e
    1681), \u043b\u0438\u0448\u044c \u0438\u0437\u0440\u0435\u0434\u043a\u0430 \u043d\u0430\u0432\u0435\u0449\u0430\u044f
    \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u044e. \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u0435\u0433\u043e
    \u0434\u0440\u0443\u0436\u0431\u044b \u0438 \u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0441
    \u0442\u0430\u043a\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438, \u043a\u0430\u043a
    \u0413\u043e\u0442\u0444\u0440\u0438\u0434 \u041b\u0435\u0439\u0431\u043d\u0438\u0446, \u0438
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b. \u0412 1673 \u0433\u043e\u0434\u0443 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    \u0432\u044b\u0448\u043b\u043e \u0432\u0442\u043e\u0440\u043e\u0435, \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u043e\u0435
    \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430 \u043f\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435
    \u2014 \"Horologium Oscillatorium\" (\"\u041c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0435
    \u0447\u0430\u0441\u044b\"). \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438.
    \u0412 \u043d\u0435\u0439 \u0413\u044e\u0439\u0433\u0435\u043d\u0441: \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0430\u044f\u0442\u043d\u0438\u043a,
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043e\u0442 \u0430\u043c\u043f\u043b\u0438\u0442\u0443\u0434\u044b (\u0442\u0430\u0443\u0442\u043e\u0445\u0440\u043e\u043d\u043d\u043e\u0441\u0442\u044c).
    \u0414\u0430\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u0435,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0435\u0433\u043e \u0446\u0435\u043d\u0442\u0440\u0430 \u043a\u0430\u0447\u0430\u043d\u0438\u044f
    \u2014 \u043a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u0442\u0435\u043b. \u0417\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u0435\u043e\u0440\u0438\u0438 \u044d\u0432\u043e\u043b\u044e\u0442 \u0438 \u044d\u0432\u043e\u043b\u044c\u0432\u0435\u043d\u0442
    \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445. \u0412\u044b\u0432\u0435\u043b
    \u0437\u0430\u043a\u043e\u043d\u044b \u0446\u0435\u043d\u0442\u0440\u043e\u0431\u0435\u0436\u043d\u043e\u0439
    \u0441\u0438\u043b\u044b \u0434\u043b\u044f \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f.
    \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043e \u0441\u043e\u0443\u0434\u0430\u0440\u0435\u043d\u0438\u0438
    \u0443\u043f\u0440\u0443\u0433\u0438\u0445 \u0442\u0435\u043b. \u0412 1680 \u0433\u043e\u0434\u0443,
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435, \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c \"\u043f\u043b\u0430\u043d\u0435\u0442\u043d\u043e\u0439
    \u043c\u0430\u0448\u0438\u043d\u044b\" \u2014 \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u0430
    \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u0440\u0438\u044f. 6. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u044e \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b (1681\u20131695) \u0412 1681 \u0433\u043e\u0434\u0443, \u0438\u0437-\u0437\u0430
    \u0443\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0438, \u0447\u0442\u043e \u0431\u043e\u043b\u0435\u0435 \u0432\u0430\u0436\u043d\u043e,
    \u0432 \u0441\u0432\u044f\u0437\u0438 \u0441 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0439
    \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0439 \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0430
    XIV (\u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u043e\u0442\u043c\u0435\u043d\u043e\u0439
    \u041d\u0430\u043d\u0442\u0441\u043a\u043e\u0433\u043e \u044d\u0434\u0438\u043a\u0442\u0430
    \u0432 1685 \u0433\u043e\u0434\u0443), \u0413\u044e\u0439\u0433\u0435\u043d\u0441, \u0431\u0443\u0434\u0443\u0447\u0438
    \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u043e\u043c, \u0440\u0435\u0448\u0438\u043b
    \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u041f\u0430\u0440\u0438\u0436 \u0438 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u0413\u0430\u0430\u0433\u0443.
    \u041d\u0430 \u0440\u043e\u0434\u0438\u043d\u0435 \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0441\u0432\u043e\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:
    \u041e\u043f\u0442\u0438\u043a\u0430 \u0438 \u0432\u043e\u043b\u043d\u043e\u0432\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0441\u0432\u0435\u0442\u0430: \u041e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u043a \u0440\u0430\u0431\u043e\u0442\u0435 \u043d\u0430\u0434 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432. \u0412 1682 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b
    \u043e\u043a\u0443\u043b\u044f\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u0435\u043f\u0435\u0440\u044c
    \u043d\u043e\u0441\u0438\u0442 \u0435\u0433\u043e \u0438\u043c\u044f \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440. \u041e\u043d \u0448\u043b\u0438\u0444\u043e\u0432\u0430\u043b
    \u043b\u0438\u043d\u0437\u044b \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c\u0438
    \u0444\u043e\u043a\u0443\u0441\u043d\u044b\u043c\u0438 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f\u043c\u0438
    (\u0434\u043e 63 \u043c\u0435\u0442\u0440\u043e\u0432). \u0412 1690 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0439
    magnum opus \u2014 \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u0441\u0432\u0435\u0442\u0435\"
    (\"Trait\u00e9 de la Lumi\u00e8re\"). \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u0432\u043e\u043b\u043d\u043e\u0432\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u0441\u0432\u0435\u0442\u0430
    \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u0437\u0430\u043a\u043e\u043d\u044b
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0438 \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430. \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u043b\u044f \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f
    \u0434\u0432\u043e\u0439\u043d\u043e\u0433\u043e \u043b\u0443\u0447\u0435\u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0432 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u0430\u0445 \u0438\u0441\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0433\u043e
    \u0448\u043f\u0430\u0442\u0430. \u0422\u0435\u043e\u0440\u0438\u044f \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f:
    \u0412 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u043a \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442\u0443 \u043e \u0441\u0432\u0435\u0442\u0435\"
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \"\u0420\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435
    \u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u0445 \u0442\u044f\u0436\u0435\u0441\u0442\u0438\".
    \u0412 \u043d\u0435\u043c \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u043d\u0430 \u0432\u0438\u0445\u0440\u044f\u0445 \u0414\u0435\u043a\u0430\u0440\u0442\u0430.
    \u0425\u043e\u0442\u044f \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438
    \u043d\u0435 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438
    \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c, \u0432 \u044d\u0442\u043e\u043c \u0442\u0440\u0443\u0434\u0435
    \u043e\u043d \u0431\u043b\u0438\u0437\u043a\u043e \u043f\u043e\u0434\u043e\u0448\u0435\u043b
    \u043a \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0435 \u0437\u0430\u043a\u043e\u043d\u0430
    \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u043e\u0440\u043c\u0435. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0442\u0440\u0443\u0434\u044b:
    \u0412 1689 \u0433\u043e\u0434\u0443 \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u043f\u043e\u0441\u0435\u0442\u0438\u043b
    \u041b\u043e\u043d\u0434\u043e\u043d, \u0433\u0434\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0441\u044f
    \u0441 \u0418\u0441\u0430\u0430\u043a\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c.
    \u041e\u043d \u0432\u043e\u0441\u0445\u0438\u0449\u0430\u043b\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c\u044e \"\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0447\u0430\u043b\" \u041d\u044c\u044e\u0442\u043e\u043d\u0430, \u043d\u043e
    \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f
    \u043a \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044e \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f
    \u0432 \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438. \u0415\u0433\u043e
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \"\u041a\u043e\u0441\u043c\u043e\u0442\u0435\u043e\u0440\u043e\u0441\"
    \u0431\u044b\u043b \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e
    \u0432 1698 \u0433\u043e\u0434\u0443. \u0412 \u043d\u0435\u043c \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u044f\u043b \u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u043c\u0438\u0440\u043e\u0432 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u0436\u0438\u0437\u043d\u0438 \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u0445.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u0432 1717 \u0433\u043e\u0434\u0443
    \u043f\u043e \u043f\u0440\u0438\u043a\u0430\u0437\u0443 \u041f\u0435\u0442\u0440\u0430 I
    \u044d\u0442\u043e\u0442 \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u0431\u044b\u043b \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d
    \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a. 7. \u0421\u043c\u0435\u0440\u0442\u044c
    \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430
    \u0431\u044b\u043b\u0438 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u044b \u0431\u043e\u043b\u0435\u0437\u043d\u044f\u043c\u0438
    \u0438 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e\u043c. \u041e\u043d
    \u0443\u043c\u0435\u0440 \u0432 \u0413\u0430\u0430\u0433\u0435 8 \u0438\u044e\u043b\u044f
    1695 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 66
    \u043b\u0435\u0442. \u0425\u043e\u0442\u044f \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    XVIII \u0432\u0435\u043a\u0430 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e
    \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435 \u0438 \u043e\u043f\u0442\u0438\u043a\u0435
    \u0431\u044b\u043b\u0438 \u0437\u0430\u0442\u043c\u0435\u043d\u044b \u0444\u0438\u0433\u0443\u0440\u043e\u0439
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430, \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u043f\u0440\u0438\u0437\u043d\u0430\u043d \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0443\u0447\u0435\u043d\u044b\u0445
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u0415\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u0432\u043e\u043b\u043d\u043e\u0432\u043e\u0439
    \u043e\u043f\u0442\u0438\u043a\u0438, \u0430 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0433\u043e
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0444\u0438\u0437\u0438\u043a\u0438. \u041e\u043d
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u0442\u043e\u0440\u043e\u043c,
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u0435\u043c,
    \u0447\u044c\u0438 \u0442\u0440\u0443\u0434\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0446\u0435\u043b\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439
    \u043d\u0430\u0443\u043a\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0430 \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430,
    \u043f\u043e\u043c\u0438\u043c\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0441\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0439, \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e\u043c \u043a\u0443\u0440\u044c\u0451\u0437\u043d\u044b\u0445
    \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u044b\u0445 \u0434\u0435\u0442\u0430\u043b\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442
    \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0432 \u043d\u0451\u043c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0433\u0435\u043d\u0438\u044f, \u043d\u043e \u0438 \u0436\u0438\u0432\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438
    \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044f\u043c\u0438 \u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u043c\u0438
    \u0447\u0435\u0440\u0442\u0430\u043c\u0438.\n\n\U0001F451 1. \"\u041c\u043e\u0439 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\":
    \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0441 \u0433\u0435\u043d\u0438\u0435\u043c
    \u043e\u0442 \u0414\u0435\u043a\u0430\u0440\u0442\u0430 \u041e\u0434\u0430\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c
    \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u043d\u043e. \u0415\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \"\u0447\u0443\u0434\u043e\u043c
    \u0441\u0440\u0435\u0434\u0438 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u043e\u0432\".
    \u041d\u043e \u0441\u0430\u043c\u044b\u043c \u043b\u0435\u0441\u0442\u043d\u044b\u043c \u0431\u044b\u043b\u043e
    \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435, \u0441\u0434\u0435\u043b\u0430\u043d\u043d\u043e\u0435
    \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u0432\u0430\u043b
    \u0432 \u0434\u043e\u043c\u0435 \u0435\u0433\u043e \u043e\u0442\u0446\u0430. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435:
    \u0423\u0432\u0438\u0434\u0435\u0432 \u0440\u0430\u043d\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0443\u0441\u043f\u0435\u0445\u0438 \u044e\u043d\u043e\u0433\u043e \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0430,
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0451\u043d, \u0447\u0442\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u043b
    \u0435\u0433\u043e \u0441 \u0441\u0430\u043c\u0438\u043c \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u043c.
    \"\u041c\u043e\u0439 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\": \u042d\u0442\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0442\u0430\u043a \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u043e\u0441\u044c \u043e\u0442\u0446\u0443
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430, \u0447\u0442\u043e \u043e\u043d \u0432
    \u0448\u0443\u0442\u043a\u0443 \u0441\u0442\u0430\u043b \u043d\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0441\u044b\u043d\u0430 \u00ab\u043c\u043e\u0439 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u00bb.
    \u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0442\u0430\u043a\u0443\u044e \u043e\u0446\u0435\u043d\u043a\u0443
    \u043e\u0442 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043c\u043e\u0432 \u044d\u043f\u043e\u0445\u0438 \u0432 \u0441\u0442\u043e\u043b\u044c
    \u044e\u043d\u043e\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u2014 \u043a\u0443\u0440\u044c\u0451\u0437\u043d\u044b\u0439
    \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043d\u043e\u0433\u043e\u0435
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0440\u0430\u043d\u043d\u0435\u043c \u0442\u0430\u043b\u0430\u043d\u0442\u0435
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e.\n\n\U0001F474 2. \u0421\u044b\u043d \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u043e\u0442\u0446\u0430 \u0438 \u0431\u0440\u0430\u0442, \"\u0432\u043e\u0440\u0443\u044e\u0449\u0438\u0439\"
    \u043b\u0438\u043d\u0437\u044b \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0441\u0432\u043e\u0439 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439 \u0443\u043c
    \u0438 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443, \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0432 \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u0438\u0438
    \u0443 \u0441\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430, \u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0438\u043d\u0430.
    \u042d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0443\u044e
    \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u0435\u0449\u0451 \u0431\u043e\u043b\u0435\u0435
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u043e\u0439. \u0412\u043b\u0430\u0441\u0442\u044c
    \u043e\u0442\u0446\u0430: \u041f\u043e\u0436\u0438\u043b\u043e\u0439 \u043e\u0442\u0435\u0446,
    \u0431\u044b\u0432\u0448\u0438\u0439 \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442, \u0435\u0434\u0438\u043d\u043e\u043b\u0438\u0447\u043d\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u043b \u0434\u0435\u043b\u0430\u043c\u0438 \u0441\u0435\u043c\u044c\u0438
    \u0438 \u0444\u0438\u043d\u0430\u043d\u0441\u0430\u043c\u0438. \u041e\u043d \u0431\u0435\u0437
    \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u043b
    \u0441\u0432\u043e\u0438\u0445 \u0443\u0436\u0435 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445
    \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0438\u0437 \u0441\u0442\u0440\u0430\u043d\u044b
    \u0432 \u0441\u0442\u0440\u0430\u043d\u0443 \u043f\u043e \u0441\u0432\u043e\u0435\u043c\u0443
    \u0443\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0438\u044e, \u0438 \u0442\u0435 \u0431\u0435\u0441\u043f\u0440\u0435\u043a\u043e\u0441\u043b\u043e\u0432\u043d\u043e
    \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u043b\u0438\u0441\u044c. \"\u0423\u043d\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435\"
    \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u0438\u044f: \u041e\u0442\u0446\u0443 \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u0430
    \u043d\u0440\u0430\u0432\u0438\u043b\u0438\u0441\u044c \"\u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0433\u0440\u0443\u0448\u043a\u0438\" \u2014 \u043a\u0430\u0440\u043c\u0430\u043d\u043d\u044b\u0435
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u044b, \u0432\u043e\u043b\u0448\u0435\u0431\u043d\u044b\u0435
    \u0444\u043e\u043d\u0430\u0440\u0438. \u0421\u044b\u043d\u0443, \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0443,
    \u0431\u044b\u043b\u043e \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u043e \u0438\u0445 \u0434\u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435, \u0438 \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u043b
    \u044d\u0442\u043e \u0437\u0430\u043d\u044f\u0442\u0438\u0435 \u0434\u043e\u0441\u0430\u0434\u043d\u044b\u043c
    \u0438 \u0434\u0430\u0436\u0435 \u0443\u043d\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043e\u0441\u043b\u0443\u0448\u0430\u0442\u044c\u0441\u044f
    \u043e\u043d \u043d\u0435 \u0441\u043c\u0435\u043b. \u0425\u0438\u0442\u0440\u044b\u0439
    \u043f\u043b\u0430\u043d: \u0427\u0442\u043e\u0431\u044b \u0445\u043e\u0442\u044c \u043a\u0430\u043a-\u0442\u043e
    \u043e\u0442\u0441\u0440\u043e\u0447\u0438\u0442\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0443
    \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0433\u043e \u0432\u043e\u043b\u0448\u0435\u0431\u043d\u043e\u0433\u043e
    \u0444\u043e\u043d\u0430\u0440\u044f \u043e\u0442\u0446\u0443, \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u043f\u043e\u0448\u0451\u043b \u043d\u0430 \u0445\u0438\u0442\u0440\u043e\u0441\u0442\u044c:
    \u043e\u043d \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b \u0441\u0432\u043e\u0435\u0433\u043e
    \u0431\u0440\u0430\u0442\u0430 \u041b\u044e\u0434\u0432\u0438\u0433\u0430 \u0442\u0430\u0439\u043d\u043e
    \u0432\u044b\u043d\u0443\u0442\u044c \u043e\u0434\u043d\u0443 \u0438\u0437 \u0442\u0440\u0451\u0445
    \u043b\u0438\u043d\u0437 \u0438\u0437 \u0444\u043e\u043d\u0430\u0440\u044f. \u0422\u0430\u043a\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043e\u043d \u043d\u0430\u0434\u0435\u044f\u043b\u0441\u044f,
    \u0447\u0442\u043e \u043f\u043e\u0441\u044b\u043b\u043a\u0430 \u0441\u043b\u043e\u043c\u0430\u0435\u0442\u0441\u044f,
    \u0438 \u043e\u0442\u0446\u0443 \u043d\u0435 \u0443\u0434\u0430\u0441\u0442\u0441\u044f
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0442\u044c \u0432 \u0440\u043e\u043b\u0438 \"\u0448\u043e\u0443\u043c\u0435\u043d\u0430\"
    \u0441\u043e \u0441\u0432\u0435\u0442\u043e\u0432\u044b\u043c\u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0430\u043c\u0438
    \u043f\u0435\u0440\u0435\u0434 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0439.\n\n\U0001F9D0
    3. \u0417\u0430\u043d\u044f\u0442\u043d\u043e\u0439 \u043f\u0430\u0441\u0441\u0430\u0436:
    \"\u041d\u0430\u0443\u043a\u0430 \u043d\u0435 \u0434\u043b\u044f \u043b\u0430\u0432\u043e\u0447\u043d\u0438\u043a\u043e\u0432\"
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u044f
    \u0438\u0437 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0438, \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u0440\u0430\u0436\u0430\u043b
    \u0441\u043d\u043e\u0431\u0438\u0441\u0442\u0441\u043a\u043e\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    \u043a \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044e
    \u043d\u0430\u0443\u043a\u0438, \u0447\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442
    \u0437\u0430\u0431\u0430\u0432\u043d\u043e \u043d\u0430 \u0444\u043e\u043d\u0435 \u0435\u0433\u043e
    \u0436\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0445
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0447\u0430\u0441\u043e\u0432). \u0410\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0441\u043d\u043e\u0431\u0438\u0437\u043c: \u0412 \u043e\u0434\u043d\u043e\u043c \u0438\u0437
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u043e\u0432, \u0446\u0438\u0442\u0438\u0440\u0443\u044e\u0449\u0438\u0445
    \u0435\u0433\u043e \u0431\u0435\u0441\u0435\u0434\u0443, \u0413\u044e\u0439\u0433\u0435\u043d\u0441
    \u0441 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u0442,
    \u0447\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u0430\u044f\u0442\u043d\u0438\u043a\u043e\u0432\u044b\u0435
    \u0447\u0430\u0441\u044b \u00ab\u0432\u043e\u0432\u0441\u0435 \u043d\u0435 \u0434\u043b\u044f
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043b\u0430\u0431\u0430\u0437\u043d\u0438\u043a\u0438
    \u0437\u043d\u0430\u043b\u0438, \u043a\u043e\u0433\u0434\u0430 \u0438\u043c \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c
    \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u044e, \u0430 \u0440\u0430\u0434\u0438 \u0447\u0438\u0441\u0442\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u0434\u043b\u044f \u0443\u0441\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u044f
    \u0431\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u043d\u044b\u0445 \u0441\u043e\u0441\u043b\u043e\u0432\u0438\u0439\u00bb.
    \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b: \u042d\u0442\u043e
    \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0437\u0432\u0443\u0447\u0438\u0442
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u043e, \u0432\u0435\u0434\u044c
    \u0438\u043c\u0435\u043d\u043d\u043e \u0435\u0433\u043e \u0447\u0430\u0441\u044b \u0441\u0442\u0430\u043b\u0438
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043d\u0430\u0441\u0443\u0449\u043d\u043e\u0439
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438
    \u2014 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0434\u043e\u043b\u0433\u043e\u0442\u044b
    \u0432 \u043c\u043e\u0440\u0435, \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0430\u0436\u043d\u043e \u0434\u043b\u044f \u0442\u043e\u0440\u0433\u043e\u0432\u043e\u0433\u043e
    \u0444\u043b\u043e\u0442\u0430 \u0438 \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u043d\u0438\u044f.
    \u0422\u0430\u043a \u0447\u0442\u043e \"\u043b\u0430\u0432\u043e\u0447\u043d\u0438\u043a\u0438\"
    \u0432 \u0438\u0442\u043e\u0433\u0435 \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c\u0438 \u0431\u0435\u043d\u0435\u0444\u0438\u0446\u0438\u0430\u0440\u0430\u043c\u0438.\n\n\U0001F4B8
    4. \u0411\u043e\u0440\u044c\u0431\u0430 \u0437\u0430 \u043f\u0430\u0440\u0438\u043a: \u043a\u0443\u0440\u044c\u0451\u0437
    \u0441 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u043c \u0431\u044e\u0434\u0436\u0435\u0442\u043e\u043c
    \u0412 1662 \u0433\u043e\u0434\u0443 \u0413\u044e\u0439\u0433\u0435\u043d\u0441 \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f
    \u0441 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445 \u0433\u0435\u043d\u0438\u0435\u0432
    \u043a\u0430\u0436\u0435\u0442\u0441\u044f \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u2014 \u043e\u0431\u043b\u044b\u0441\u0435\u043d\u0438\u0435 \u0432 34 \u0433\u043e\u0434\u0430.
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0435\u043c\u0443
    \u0431\u0440\u0430\u0442\u0443 \u043e \u00ab\u0434\u0443\u0448\u0435\u0440\u0430\u0437\u0434\u0438\u0440\u0430\u044e\u0449\u0435\u043c
    \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u0438\u00bb \u043e \u0441\u0432\u043e\u0435\u0439
    \u0440\u0430\u043d\u043d\u0435\u0439 \u043f\u043b\u0435\u0448\u0438\u0432\u043e\u0441\u0442\u0438.
    \u041f\u043e\u043a\u0443\u043f\u043a\u0430 \u043f\u0430\u0440\u0438\u043a\u0430: \u0427\u0442\u043e\u0431\u044b
    \u0440\u0435\u0448\u0438\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443, \u043e\u043d
    \u0437\u0430\u043a\u0430\u0437\u0430\u043b \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u043b\u0443\u0447\u0448\u0438\u0439
    \u043f\u0430\u0440\u0438\u043a. \u0421\u0435\u043c\u0435\u0439\u043d\u044b\u0439 \u0437\u0430\u0433\u043e\u0432\u043e\u0440:
    \u0427\u0442\u043e\u0431\u044b \u0440\u0430\u0441\u043f\u043b\u0430\u0442\u0438\u0442\u044c\u0441\u044f
    \u0437\u0430 \u0434\u043e\u0440\u043e\u0433\u043e\u0439 \u043f\u0430\u0440\u0438\u043a,
    \u0441\u0442\u043e\u0438\u0432\u0448\u0438\u0439 4,5 \u043b\u0443\u0438\u0434\u043e\u0440\u0430,
    \u0431\u0440\u0430\u0442\u044c\u044f \u0437\u0430\u0434\u0443\u043c\u0430\u043b\u0438 \u0445\u0438\u0442\u0440\u044b\u0439
    \u043f\u043b\u0430\u043d. \u041e\u043d\u0438 \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c
    \u0432\u044b\u0442\u044f\u043d\u0443\u0442\u044c \u044d\u0442\u0438 \u0434\u0435\u043d\u044c\u0433\u0438
    \u0438\u0437 \u043e\u0442\u0446\u0430, \u043d\u043e \u0438\u0445 \"\u0437\u0430\u0433\u043e\u0432\u043e\u0440\"
    \u043f\u043e \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044e \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u0438\u0437 \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439 \u043a\u0430\u0437\u043d\u044b,
    \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u043f\u0440\u043e\u0432\u0430\u043b\u0438\u043b\u0441\u044f,
    \u0438 \u0434\u0435\u043d\u044c\u0433\u0438 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c
    \u0438\u0441\u043a\u0430\u0442\u044c \u0441\u0430\u043c\u0438\u043c.\n\n\U0001F468\u200d\U0001F52C
    5. \u0420\u043e\u043b\u044c \"\u0443\u043c\u043d\u0438\u043a\u0430\" \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u0438 \u0431\u043e\u0440\u044c\u0431\u0430 \u0441 \"\u043c\u0435\u043b\u043e\u0447\u043e\u0432\u043a\u043e\u0439\"
    \u0412 \u041f\u0430\u0440\u0438\u0436\u0435 \u0413\u044e\u0439\u0433\u0435\u043d\u0441,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0433\u043b\u0430\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a, \u0447\u0430\u0441\u0442\u043e \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f
    \u043d\u0430 \"\u043f\u0443\u0441\u0442\u044f\u043a\u0438\" \u043f\u043e \u0437\u0430\u043a\u0430\u0437\u0443
    \u043a\u043e\u0440\u043e\u043b\u044f \u0438 \u0434\u0432\u043e\u0440\u0430, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0441\u0438\u043b\u044c\u043d\u043e \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u043b\u043e.
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u044f \u0442\u0440\u0430\u0442\u044f\u0442 \u0432\u043f\u0443\u0441\u0442\u0443\u044e
    \u043d\u0430 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0447\u0438\u043d\u043e\u0432
    \u0438 \u043d\u0430\u0433\u0440\u0430\u0434, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u0430\u043a \u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u043d\u0430\u0443\u043a\u043e\u0439.
    \u042d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435 \u00ab\u043a\u043e\u0440\u043e\u043b\u044f-\u0441\u043e\u043b\u043d\u0446\u0430\u00bb
    \u0431\u044b\u043b\u0430 \u0434\u0430\u043b\u0435\u043a\u0430 \u043e\u0442 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0439,
    \u0438 \u0434\u0430\u0436\u0435 \u0442\u0430\u043a\u043e\u0439 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u0439
    \u0443\u0447\u0451\u043d\u044b\u0439, \u043a\u0430\u043a \u0413\u044e\u0439\u0433\u0435\u043d\u0441,
    \u0447\u0430\u0441\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441\u0435\u0431\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c \u043e\u0442
    \u043a\u0430\u043f\u0440\u0438\u0437\u043e\u0432 \u0438 \u0431\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u0438,
    \u0447\u0442\u043e, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u043b\u043e
    \u0435\u0433\u043e \u0438 \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u043b\u043e \u043e\u0442
    \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439."
