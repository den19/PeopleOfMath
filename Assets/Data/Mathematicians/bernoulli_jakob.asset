  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u042f\u043a\u043e\u0431\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e \u0438 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0441\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u041e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445,
    \u043a\u0442\u043e \u043e\u0441\u043e\u0437\u043d\u0430\u043b \u043c\u043e\u0449\u044c \u043d\u043e\u0432\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430,
    \u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0435\u0433\u043e \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043a\u0430\u043a
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445,
    \u0442\u0430\u043a \u0438 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c
    \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\n\U0001F4CA \u0422\u0435\u043e\u0440\u0438\u044f
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439: \u00ab\u0417\u043e\u043b\u043e\u0442\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u00bb \u0438 \u00ab\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0439\u00bb \u042d\u0442\u043e
    \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u0435\u0442\u0438\u0449\u0435 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438,
    \u043f\u0440\u0438\u043d\u0435\u0441\u0448\u0435\u0435 \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0441\u043b\u0430\u0432\u0443. \u0415\u0433\u043e magnum opus, \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00abArs Conjectandi\u00bb (\u00ab\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0439\u00bb), \u0431\u044b\u043b
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d \u0435\u0433\u043e \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u043a\u043e\u043c
    \u0432 1713 \u0433\u043e\u0434\u0443, \u0447\u0435\u0440\u0435\u0437 \u0432\u043e\u0441\u0435\u043c\u044c
    \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0443\u0447\u0435\u043d\u043e\u0433\u043e.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438. \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u043c\u0435\u0441\u0442\u043e \u0432 \u043a\u043d\u0438\u0433\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0437\u0430\u043a\u043e\u043d\u0430
    \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0447\u0438\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0430\u043c \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0441 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u044c\u044e
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0441\u0432\u043e\u0435\u0439 \u00ab\u0417\u043e\u043b\u043e\u0442\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u043e\u0439\u00bb. \u0412 \u0441\u0432\u043e\u0435\u0439
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0441 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0435\u043c
    \u043e\u043d \u043e\u0442\u043c\u0435\u0447\u0430\u043b, \u0447\u0442\u043e \u0445\u043e\u0442\u044f
    \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e \u00ab\u043a\u0430\u0436\u0434\u044b\u0439
    \u0433\u043b\u0443\u043f\u0435\u0446\u00bb \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0441 \u0440\u043e\u0441\u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0430
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439 \u043e\u0448\u0438\u0431\u043a\u0430
    \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0435\u0442\u0441\u044f, \u0434\u0430\u0442\u044c
    \u044d\u0442\u043e\u043c\u0443 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u2014
    \u0437\u0430\u0434\u0430\u0447\u0430 \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e\u0439
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438. \u0421\u0443\u0442\u044c \u0442\u0435\u043e\u0440\u0435\u043c\u044b:
    \u041e\u043d\u0430 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e
    \u043f\u0440\u0438 \u043c\u043d\u043e\u0433\u043e\u043a\u0440\u0430\u0442\u043d\u043e\u043c
    \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u0438 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445
    \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043f\u043e\u0434\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043d\u0438\u0438 \u043c\u043e\u043d\u0435\u0442\u044b)
    \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u044f
    (\u0432\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u044f \u00ab\u043e\u0440\u043b\u0430\u00bb)
    \u0441\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438
    \u043a \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438. \u041f\u0440\u043e\u0449\u0435
    \u0433\u043e\u0432\u043e\u0440\u044f, \u0447\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435
    \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0439, \u0442\u0435\u043c \u0431\u043b\u0438\u0436\u0435
    \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u0430\u044f \u0434\u043e\u043b\u044f
    \u0443\u0441\u043f\u0435\u0445\u043e\u0432 \u043a \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0439
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438 `p`. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0432\u0430\u044f \u0441\u0442\u0440\u043e\u0433\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430
    \u0438\u0434\u0435\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u043d\u0435\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u043b\u0438\u0448\u044c
    \u043d\u0430 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435.
    \u041e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0431\u0443\u0434\u0443\u0449\u0438\u0445
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u044b\u0432\u043e\u0434\u0430 \u0438 \u0432\u044b\u0431\u043e\u0440\u043e\u0447\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u0412 \u0435\u0433\u043e
    \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439:
    \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    (\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445 \u043e\u043f\u044b\u0442\u043e\u0432
    \u0441 \u0434\u0432\u0443\u043c\u044f \u0438\u0441\u0445\u043e\u0434\u0430\u043c\u0438),
    \u0441\u0445\u0435\u043c\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0438 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438. \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e,
    \u00abArs Conjectandi\u00bb \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438,
    \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a
    \u0438 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0439, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u043a \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u043c
    \u0438\u0433\u0440\u0430\u043c \u0438 \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u043c
    \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f\u043c.\n\n\U0001F4D0 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437: \u043f\u0435\u0440\u0432\u043e\u043f\u0440\u043e\u0445\u043e\u0434\u0435\u0446
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u043c\u0430\u043b\u044b\u0445 \u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0438 \u0441\u0430\u043c\u044b\u0445 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u0432
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435.
    \u0422\u0435\u0440\u043c\u0438\u043d \u00ab\u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u00bb:
    \u0412 1690 \u0433\u043e\u0434\u0443, \u0432 \u0440\u0430\u0431\u043e\u0442\u0435, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0435 \u043e \u043a\u0440\u0438\u0432\u043e\u0439 \u0440\u0430\u0432\u043d\u043e\u0433\u043e
    \u0441\u043f\u0443\u0441\u043a\u0430 (\u0438\u0437\u043e\u0445\u0440\u043e\u043d\u0435),
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0438\u043b
    \u0432 \u043f\u0435\u0447\u0430\u0442\u0438 \u0442\u0435\u0440\u043c\u0438\u043d \u00ab\u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u00bb
    \u0432 \u0435\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435.
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c
    \u0448\u0430\u0433\u043e\u043c \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0412\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435: \u0412\u043c\u0435\u0441\u0442\u0435
    \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u0431\u0440\u0430\u0442\u043e\u043c \u0418\u043e\u0433\u0430\u043d\u043d\u043e\u043c
    \u043e\u043d \u0441\u0442\u043e\u044f\u043b \u0443 \u0438\u0441\u0442\u043e\u043a\u043e\u0432
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u0412 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u043e\u043d \u0432\u043d\u0435\u0441
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0438\u0437\u043e\u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438 (\u043f\u043e\u0438\u0441\u043a \u0444\u0438\u0433\u0443\u0440\u044b
    \u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043b\u043e\u0449\u0430\u0434\u044c\u044e
    \u043f\u0440\u0438 \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0435)
    \u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u043e \u0431\u0440\u0430\u0445\u0438\u0441\u0442\u043e\u0445\u0440\u043e\u043d\u0435
    (\u043a\u0440\u0438\u0432\u043e\u0439 \u0441\u043a\u043e\u0440\u0435\u0439\u0448\u0435\u0433\u043e
    \u0441\u043f\u0443\u0441\u043a\u0430). \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438:
    \u0412 1696 \u0433\u043e\u0434\u0443 \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0432\u0438\u0434\u0430 `y' = p(x)y + q(x)y^n`, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0441 \u0442\u0435\u0445 \u043f\u043e\u0440 \u043d\u043e\u0441\u0438\u0442 \u0435\u0433\u043e
    \u0438\u043c\u044f. \u042d\u0442\u043e \u0432\u0430\u0436\u043d\u044b\u0439 \u043a\u043b\u0430\u0441\u0441
    \u043d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0441\u0432\u043e\u0434\u044f\u0449\u0438\u0439\u0441\u044f
    \u043a \u043b\u0438\u043d\u0435\u0439\u043d\u043e\u043c\u0443. \u0420\u044f\u0434\u044b:
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0441 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c\u0438 \u0440\u044f\u0434\u0430\u043c\u0438.
    \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0440\u0430\u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c
    \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u044f\u0434\u0430
    `\u2211 1/n` (\u0445\u043e\u0442\u044f \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u0438 \u0434\u043e \u043d\u0435\u0433\u043e) \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0440\u044f\u0434\u0430 `\u2211
    1/n\u00b2`, \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u043e\u043d
    \u0441\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043a \u0447\u0438\u0441\u043b\u0443,
    \u043c\u0435\u043d\u044c\u0448\u0435\u043c\u0443 2 (\u0435\u0433\u043e \u0442\u043e\u0447\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0437\u0434\u043d\u0435\u0435
    \u043d\u0430\u0448\u0435\u043b \u042d\u0439\u043b\u0435\u0440).\n\n\U0001F9EE \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b: \u0427\u0438\u0441\u043b\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u0412 \u0445\u043e\u0434\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0441\u0443\u043c\u043c \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0445 \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    (`1^k + 2^k +... + n^k`) \u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u043e\u0442\u043a\u0440\u044b\u043b \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u0432\u0430\u0436\u043d\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0435 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b.
    \u042d\u0442\u0438 \u0447\u0438\u0441\u043b\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438
    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0447\u0438\u0441\u0435\u043b \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438.
    \u041e\u043d\u0438 \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0432 \u0440\u0430\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0438
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0432 \u0440\u044f\u0434\u044b
    \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0432 \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u0445
    \u0441\u0443\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u042d\u0439\u043b\u0435\u0440\u0430-\u041c\u0430\u043a\u043b\u043e\u0440\u0435\u043d\u0430).\n\n\U0001F4C8
    \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u0438\u0432\u044b\u0445
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0432\u043d\u0435\u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432
    \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043a\u0440\u0438\u0432\u044b\u0445.
    \u041b\u0435\u043c\u043d\u0438\u0441\u043a\u0430\u0442\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438:
    \u0412 1694 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u0438
    \u0432\u0432\u0435\u043b \u0432 \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0438\u0435
    \u043a\u0440\u0438\u0432\u0443\u044e, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0430\u0437\u0432\u0430\u043b
    \u043b\u0435\u043c\u043d\u0438\u0441\u043a\u0430\u0442\u043e\u0439 (\u043e\u0442 \u0433\u0440\u0435\u0447.
    \u00ab\u043b\u0435\u043d\u0442\u0430\u00bb). \u042d\u0442\u043e \u043f\u043b\u043e\u0441\u043a\u0430\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0440\u0438\u0432\u0430\u044f,
    \u0438\u043c\u0435\u044e\u0449\u0430\u044f \u0444\u043e\u0440\u043c\u0443 \u00ab\u0432\u043e\u0441\u044c\u043c\u0435\u0440\u043a\u0438\u00bb
    \u0438\u043b\u0438 \u0441\u0438\u043c\u0432\u043e\u043b\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438.
    \u041e\u043d \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0435\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430,
    \u0445\u043e\u0442\u044f \u0438 \u043d\u0435 \u0437\u043d\u0430\u043b, \u0447\u0442\u043e
    \u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0449\u0438\u0439 \u0441\u043b\u0443\u0447\u0430\u0439
    \u044d\u0442\u043e\u0439 \u043a\u0440\u0438\u0432\u043e\u0439 \u0438\u0437\u0443\u0447\u0430\u043b\u0441\u044f
    \u041a\u0430\u0441\u0441\u0438\u043d\u0438. \u0426\u0435\u043f\u043d\u0430\u044f \u043b\u0438\u043d\u0438\u044f:
    \u0412 1691 \u0433\u043e\u0434\u0443 \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443
    \u043e \u0444\u043e\u0440\u043c\u0435, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442
    \u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u0430\u044f \u0442\u044f\u0436\u0435\u043b\u0430\u044f
    \u043d\u0438\u0442\u044c, \u043f\u043e\u0434\u0432\u0435\u0448\u0435\u043d\u043d\u0430\u044f
    \u0437\u0430 \u0434\u0432\u0430 \u043a\u043e\u043d\u0446\u0430. \u042d\u0442\u0430 \u043a\u0440\u0438\u0432\u0430\u044f,
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0430\u044f \u0446\u0435\u043f\u043d\u043e\u0439
    \u043b\u0438\u043d\u0438\u0435\u0439, \u0438\u043c\u0435\u0435\u0442 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0432 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435
    \u0438 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0444\u043e\u0440\u043c \u0430\u0440\u043e\u043a
    \u0438 \u0432\u0438\u0441\u044f\u0447\u0438\u0445 \u043c\u043e\u0441\u0442\u043e\u0432).
    \u041b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u043f\u0438\u0440\u0430\u043b\u044c: \u041e\u043d \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e\u043c \u044d\u0442\u043e\u0439 \u043a\u0440\u0438\u0432\u043e\u0439
    \u2014 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c \u0441\u0432\u043e\u044e \u0444\u043e\u0440\u043c\u0443
    \u043f\u0440\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u0445
    (\u043f\u043e\u0434\u043e\u0431\u0438\u0438), \u2014 \u0447\u0442\u043e \u0437\u0430\u0432\u0435\u0449\u0430\u043b
    \u0438\u0437\u043e\u0431\u0440\u0430\u0437\u0438\u0442\u044c \u0435\u0451 \u043d\u0430 \u0441\u0432\u043e\u0435\u043c
    \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u043e\u043c \u043a\u0430\u043c\u043d\u0435
    \u0441 \u043d\u0430\u0434\u043f\u0438\u0441\u044c\u044e \u00abEADEM MUTATA RESURGO\u00bb
    (\u00ab\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u043d\u0430\u044f, \u044f \u0432\u043d\u043e\u0432\u044c
    \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0430\u044e\u00bb). \u041f\u043e \u0438\u0440\u043e\u043d\u0438\u0438
    \u0441\u0443\u0434\u044c\u0431\u044b, \u043d\u0430 \u0435\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0435
    \u043f\u043e \u043e\u0448\u0438\u0431\u043a\u0435 \u0432\u044b\u0441\u0435\u043a\u043b\u0438
    \u0441\u043f\u0438\u0440\u0430\u043b\u044c \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430.
    \u042d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b:
    \u0412 1694 \u0433\u043e\u0434\u0443, \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043d\u0430\u0434
    \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u043e\u0431 \u0438\u0437\u0433\u0438\u0431\u0435
    \u0443\u043f\u0440\u0443\u0433\u043e\u0439 \u0431\u0430\u043b\u043a\u0438 (`elastica`) \u0438
    \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u044f \u0434\u043b\u0438\u043d\u0443 \u0434\u0443\u0433\u0438
    \u043b\u0435\u043c\u043d\u0438\u0441\u043a\u0430\u0442\u044b, \u043e\u043d \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f
    \u0441 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u043c\u0438 \u0432\u0438\u0434\u0430
    `\u222b dt/\u221a(1 - t\u2074)`. \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0442\u043e \u044d\u0442\u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b
    \u043d\u0435 \u0432\u044b\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u043f\u043e\u043b\u043e\u0436\u0438\u0432 \u043d\u0430\u0447\u0430\u043b\u043e \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432 \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.\n\n\U0001F4B0
    \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0447\u0438\u0441\u043b\u0430 e \u0412
    1683 \u0433\u043e\u0434\u0443, \u0437\u0430\u0434\u043e\u043b\u0433\u043e \u0434\u043e \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a \u042d\u0439\u043b\u0435\u0440 \u0434\u0430\u043b \u0435\u043c\u0443
    \u0431\u0443\u043a\u0432\u0435\u043d\u043d\u043e\u0435 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435,
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u043e\u0442\u043a\u0440\u044b\u043b \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0443
    `e`. \u041e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e, \u0438\u0437\u0443\u0447\u0430\u044f
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u043c
    \u043d\u0430\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043e\u0432 \u0438 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044f
    \u043f\u0440\u0435\u0434\u0435\u043b \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    `lim (n\u2192\u221e) (1 + 1/n)^n`.\n\n\U0001F30C \u0424\u0438\u0437\u0438\u043a\u0430 \u0438
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b \u0441\u0432\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0430\u043b\u0430\u043d\u0442
    \u043a \u0437\u0430\u0434\u0430\u0447\u0430\u043c \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0438. \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c
    \u0446\u0435\u043d\u0442\u0440\u0430 \u043a\u0430\u0447\u0430\u043d\u0438\u044f \u0442\u0435\u043b,
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435
    \u0442\u0435\u043b \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u044b
    \u043f\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0432 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438
    \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u043a \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e
    \u043c\u043e\u0441\u0442\u043e\u0432. \u0415\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441
    \u0435\u0441\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u043f\u043e \u043b\u044e\u0431\u043e\u043c\u0443
    \u0438\u0437 \u044d\u0442\u0438\u0445 \u0430\u0441\u043f\u0435\u043a\u0442\u043e\u0432,
    \u044f \u0433\u043e\u0442\u043e\u0432 \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c \u043d\u0430
    \u043d\u0438\u0445 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e."
  achievementsEn: "The scientific legacy of Jacob Bernulli is indeed enormous and covers almost every field of mathematics in his time. He was one of the first to realize the power of the new Leibnitz analysis and to use it brilliantly for both fundamental and applied purposes. His contribution can be divided into several key areas.\n\nThe theory of probability: \"Golden Theorem\" and \"Art of Promise\" is the main child of Bernulli, who brought him world glory. His magnum opus, the tract \"Ars Conjectandi\", was published by his nephew in 1713, eight years after the death of his scientist, and this work became the foundation for all modern probability and statistics theory.The book focuses on proof of the law of large numbers, which Bernulli himself proudly called his \"Golden Theorem.\" In his correspondence with Leibnitzam, he pointed out that while the intuitive \"every fool\" realizes that with the increase in the number of observations, error decreases, giving this strict mathematical proof is a task of extreme complexity.Theorem: It argues that when independent tests (e.g. coin throwing) are repeated repeatedly, the frequency of an event (head fall) is likely to be the theoretical probability.Significance: This was the first strict mathematical formulation of the idea that previously existed only on an intuitive level, which provided a theoretical basis for all future statistical output and sample studies, and named in his honour the key concepts of probability theory: Bernulli's trials (sequence of independent experiments with two outcomes), Bernulli's scheme and Bernulli's distribution.In addition, \"Ars Conjectandi\" contained a thorough analysis of the combination, the theory of conversions and combinations, and the application of probability theory to gambling and moral expectations.\n\nMathematical analysis: The pioneer in calculating the infinitely small Jacob Bernulli was one of the first and most active popularists and producers of differential and integrated calculations of Leibnice in Europe. The term \"integrated\" was used for the first time in the work on the equal descent curve (isochrone) in 1690.This was a huge step in the development of a standardized analysis language, a variable calculation: along with his brother Johann, he was at the origin of the variable calculation; in particular, he made a significant contribution to the isoperimetric task (searching for a figure with the maximum area at the designated perimeter) and the brahistochron task (cry of early descent).Differential equation of Bernulli: In 1696, he decided the equation of the species 'y' = p(x)y + q(x)yn', which since then has been bearing his name. This is an important class of non-linear differential equations, which is reduced to linear. Series: He worked actively with endless series.He proved the cost-effectiveness of the harmonic series `', 1/n' (although this was known before it) and proved the convergence of the series `, 1/n2', showing that it was equal to less than 2 (his exact value was later found by Euler).\n\n===Searchs=================================================================================================)=======================================================================================================================================================\n\n♪ Analytical geometry and the study of Bernulli curves have contributed tremendously to the study of the properties of various curves. ♪ In 1694, Lemniskat Bernulli: he described and introduced a curve called Lemniscate (from the Greek \"Lint\"). ♪ It's a flat algebraic curve that takes the shape of an \"8\" or an infinity symbol ♪ ♪ He studied its properties, although he didn't know that the more general case of this curve was studied by Cassini.Chainline: In 1691, he solved the problem of the shape of a uniform heavy thread, suspended at two ends. This curve, called the chain line, is fundamental to construction and architecture (e.g. for the calculation of arch shapes and hanging bridges).Logarithmic spiral: He was so enthralled by the unique characteristic of this curve — to maintain its shape in various geometric transformations (likeness), that he would make it appear on his tombstone with the inscription \"EADEM MUTATA RESURGO\" (\"The Changed I Resurrection\").elliptical integrals: In 1694, working on the bend of the tibia (`elastica') and calculating the length of the arc of the lemniscata, he encountered the integrators of the species `dt/G(1 - t4)'. He first realized that these integrals did not express themselves through elementary functions, starting with the theory of elliptical integrations and functions.\n\n==Reopening==The opening of the e-number in 1683, long before the name was given to him by the e-mail, Bernulli discovered the constant `e'. He did so by studying the continuous calculation of complex interest and by considering the limit of `lim (n') (1 + 1/n)\\n'.\n\n♪ The physics and mechanic Bernulli also applied his math talent to mechanics and physics. He worked on determining the rocking center, exploring the resistance of different shapes in fluid motion, and applying variable calculations to bridge design. If you have additional questions on any of these aspects, I'm prepared to answer them in more detail."
  personalLifeRu: "\u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0431\u044b\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0432 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u043d\u0435 \u0431\u044b\u043b\u043e \u0433\u0440\u043e\u043c\u043a\u0438\u0445
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u043e\u0432 \u0438\u043b\u0438 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430, \u043f\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438, \u043d\u0430\u0443\u043a\u0435 \u0438 \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u044b\u043c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c \u0441 \u0441\u0435\u043c\u044c\u0435\u0439,
    \u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u2013
    \u0441 \u043c\u043b\u0430\u0434\u0448\u0438\u043c \u0431\u0440\u0430\u0442\u043e\u043c \u0418\u043e\u0433\u0430\u043d\u043d\u043e\u043c.
    \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0435\u0433\u043e
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438:\n\n\U0001F48D \u0421\u0435\u043c\u044c\u044f
    \u0438 \u0431\u0440\u0430\u043a \u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u042f\u043a\u043e\u0431\u0430 \u0441\u043b\u043e\u0436\u0438\u043b\u0430\u0441\u044c \u0432\u043f\u043e\u043b\u043d\u0435
    \u043e\u0431\u044b\u0447\u043d\u043e \u0434\u043b\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0431\u044e\u0440\u0433\u0435\u0440\u0430 \u0411\u0430\u0437\u0435\u043b\u044f \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0416\u0435\u043d\u0438\u0442\u044c\u0431\u0430:
    \u0412 1684 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    30 \u043b\u0435\u0442, \u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u042e\u0434\u0438\u0442 \u0428\u0442\u0443\u043f\u0430\u043d\u0443\u0441
    (Judith Stupanus). \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0430\u043f\u0442\u0435\u043a\u0430\u0440\u044f,
    \u0442\u043e \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0442\u043e\u0433\u043e \u0436\u0435 \u043a\u0440\u0443\u0433\u0430 \u0431\u0430\u0437\u0435\u043b\u044c\u0441\u043a\u043e\u0439
    \u044d\u043b\u0438\u0442\u044b, \u0447\u0442\u043e \u0438 \u0441\u0435\u043c\u044c\u044f
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438. \u0414\u0435\u0442\u0438: \u0412 \u0431\u0440\u0430\u043a\u0435
    \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0434\u0432\u043e\u0435
    \u0434\u0435\u0442\u0435\u0439 \u2013 \u0441\u044b\u043d \u0438 \u0434\u043e\u0447\u044c.
    \u0421\u044b\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u041d\u0438\u043a\u043e\u043b\u0430\u0443\u0441\u043e\u043c
    \u0432 \u0447\u0435\u0441\u0442\u044c \u043e\u0442\u0446\u0430 \u042f\u043a\u043e\u0431\u0430.
    \u0427\u0442\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0434\u043b\u044f \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u0438\u0445 \u0434\u0435\u0442\u0438 \u043d\u0435 \u043f\u043e\u0448\u043b\u0438 \u043f\u043e
    \u0441\u0442\u043e\u043f\u0430\u043c \u043e\u0442\u0446\u0430 \u0438 \u043d\u0435 \u0441\u0442\u0430\u043b\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438. \u0421\u044b\u043d, \u041d\u0438\u043a\u043e\u043b\u0430\u0443\u0441,
    \u043f\u043e\u0448\u0435\u043b \u043f\u043e \u043f\u0443\u0442\u0438 \u0434\u0435\u0434\u0430
    \u0438 \u0441\u0442\u0430\u043b \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0438\u043c \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c
    \u0438 \u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043c \u0433\u0438\u043b\u044c\u0434\u0438\u0438
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u043e\u0432. \u0415\u0433\u043e \u0436\u0435\u043d\u0430
    \u0438 \u0434\u0435\u0442\u0438 \u043f\u0435\u0440\u0435\u0436\u0438\u043b\u0438 \u0435\u0433\u043e,
    \u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438
    \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a \u043d\u0430 \u0435\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0435,
    \u043d\u0430\u0434\u043f\u0438\u0441\u044c \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u043b\u0430\u0441\u044c \u0441\u043b\u043e\u0432\u0430\u043c\u0438:
    \u00ab...\u0441\u043e\u043e\u0440\u0443\u0436\u0435\u043d \u043e\u043f\u0435\u0447\u0430\u043b\u0435\u043d\u043d\u044b\u043c
    \u0441\u0443\u043f\u0440\u0443\u0433\u043e\u043c \u0438 \u0434\u0435\u0442\u044c\u043c\u0438,
    \u0442\u043e\u0441\u043a\u0443\u044e\u0449\u0438\u043c\u0438 \u043f\u043e \u043c\u0443\u0436\u0443
    \u0438 \u043e\u0442\u0446\u0443\u00bb.\n\n\U0001F624 \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0431\u0440\u0430\u0442\u043e\u043c \u0418\u043e\u0433\u0430\u043d\u043d\u043e\u043c:
    \u043e\u0442 \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043a \u0432\u0440\u0430\u0436\u0434\u0435
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0441\u0430\u043c\u0430\u044f \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u0430\u044f
    \u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u044c
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f, \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u0448\u0438\u0440\u043e\u043a\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430. \u0418\u0445
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u043e
    \u0432 \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0435\u043d\u043d\u0443\u044e \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0446\u0438\u044e
    \u0438 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u0443\u044e \u0432\u0440\u0430\u0436\u0434\u0443.
    1. \u041d\u0430\u0447\u0430\u043b\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439:
    \u042f\u043a\u043e\u0431 \u0431\u044b\u043b \u043d\u0430 12 \u043b\u0435\u0442 \u0441\u0442\u0430\u0440\u0448\u0435
    \u0441\u0432\u043e\u0435\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0430.
    \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u0438\u0445
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c\u0438
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0430:
    \u042f\u043a\u043e\u0431 \u043e\u0431\u0443\u0447\u0430\u043b \u043c\u043b\u0430\u0434\u0448\u0435\u0433\u043e
    \u0431\u0440\u0430\u0442\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    2. \u041f\u0440\u0438\u0447\u0438\u043d\u044b \u0440\u0430\u0437\u0440\u044b\u0432\u0430:
    \u0421\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u043e,
    \u043a\u043e\u0433\u0434\u0430 \u0418\u043e\u0433\u0430\u043d\u043d \u0434\u043e\u0441\u0442\u0438\u0433
    \u0443\u0440\u043e\u0432\u043d\u044f, \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c\u043e\u0433\u043e
    \u0441 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e\u043c \u0431\u0440\u0430\u0442\u0430.
    \u041f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u043e\u0431\u0430
    \u043e\u0431\u043b\u0430\u0434\u0430\u043b\u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430\u043c\u0438. \u042f\u043a\u043e\u0431\u0430
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e,
    \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438 \u043e\u0441\u0442\u0440\u043e \u043d\u0443\u0436\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u0432 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0438, \u0442\u043e\u0433\u0434\u0430
    \u043a\u0430\u043a \u0418\u043e\u0433\u0430\u043d\u043d \u0431\u044b\u043b \u0445\u0432\u0430\u0441\u0442\u043b\u0438\u0432
    \u0438 \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u0435\u043d. \u0421\u0438\u0442\u0443\u0430\u0446\u0438\u044e
    \u0443\u0441\u0443\u0433\u0443\u0431\u043b\u044f\u043b\u0430 \u0437\u0430\u0432\u0438\u0441\u0442\u044c:
    \u042f\u043a\u043e\u0431, \u043a\u0430\u043a \u0441\u0442\u0430\u0440\u0448\u0438\u0439,
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u0438 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u0411\u0430\u0437\u0435\u043b\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0418\u043e\u0433\u0430\u043d\u043d, \u043f\u043e-\u0432\u0438\u0434\u0438\u043c\u043e\u043c\u0443,
    \u0445\u043e\u0442\u0435\u043b \u0431\u044b \u0437\u0430\u043d\u044f\u0442\u044c \u0441\u0430\u043c.
    \u0418\u0445 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0435 \u0441\u043f\u043e\u0440\u044b,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 1697 \u0433\u043e\u0434\u0430,
    \u0431\u044b\u043b\u0438 \u0445\u043e\u0440\u043e\u0448\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u0430\u0445.
    \u041e\u043d\u0438 \u043e\u0431\u043c\u0435\u043d\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u043a\u043e\u043b\u043a\u0438\u043c\u0438 \u0441\u0442\u0430\u0442\u044c\u044f\u043c\u0438,
    \u0431\u0440\u043e\u0441\u0430\u043b\u0438 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u044b\u0437\u043e\u0432\u044b,
    \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0438
    \u0443\u043d\u0438\u0437\u0438\u0442\u044c \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430.
    \u042d\u0442\u043e\u0442 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u043e\u043c\u0440\u0430\u0447\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u042f\u043a\u043e\u0431\u0430. \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u0442\u043e\u043c,
    \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u0418\u043e\u0433\u0430\u043d\u043d
    \u0441\u043c\u0435\u043d\u0438\u043b \u0435\u0433\u043e \u043d\u0430 \u043f\u043e\u0441\u0442\u0443
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0411\u0430\u0437\u0435\u043b\u0435 \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u0432 1705
    \u0433\u043e\u0434\u0443."
  personalLifeEn: "Although Jacob Bernulli was one of the greatest mathematicians of his time, there were no loud scandals or romantic stories in his personal life, and she was devoted, for the most part, to science and difficult relationships with his family, especially his younger brother Johann.\n\n==Personal life==The family life of Jacob was usually formed by a wealthy burger, Basel, who married Jakob Bernulli in 1684, at the age of 30, married Judith Stupanus, who was the daughter of a wealthy pharmacist, who came from the same circle of the basal elite as Bernulli's family.Most notably for the mathematician dynasty, their children did not follow in their father's footsteps or become scientists.\n\n* Relations with Brother Johann: From teaching to hostility, this was the most dramatic and painful part of his personal life, which unfortunately is widely known, and their cooperation became a fierce competition and a public feud. 1. The beginning of the relationship: Jacob was 12 years older than his brother Johann. Initially, their relationship was a teacher-student relationship: Jacob taught his younger brother mathematics. 2.The reasons for the breakup: The rivalry arose when Johann reached a level comparable to that of his brother, and according to the people of the day, both were complex in character. Jacob was described as a man who was sensitive, annoying and in dire need of recognition, while Johann was boastful and ambitious.The situation was exacerbated by envy: Jacob, as a senior, occupied the prestigious and prestigious department of mathematics in Basel, which Johann seemed to want to occupy himself; their public debates, especially after 1697, were well known in the scientific community; they exchanged punctured articles; they made mathematical challenges to each other to test and humiliate their opponent; and this conflict has clouded Jacob's last years of life.The irony of fate is that it was Johann who replaced him as a professor of mathematics in Basel after the death of his older brother in 1705."
  shortBioRu: "\u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u2014 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043e\u0434\u0438\u043d \u0438\u0437
    \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u041e\u043d \u0431\u044b\u043b \u0441\u0442\u0430\u0440\u0448\u0438\u043c
    \u0431\u0440\u0430\u0442\u043e\u043c \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438,
    \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0432\u043c\u0435\u0441\u0442\u0435 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f, \u0438 \u0434\u044f\u0434\u0435\u0439
    \u0414\u0430\u043d\u0438\u0438\u043b\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445.\n\n\U0001F9EC \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u042f\u043a\u043e\u0431
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    6 \u044f\u043d\u0432\u0430\u0440\u044f 1655 \u0433\u043e\u0434\u0430 (\u043f\u043e \u0441\u0442\u0430\u0440\u043e\u043c\u0443
    \u0441\u0442\u0438\u043b\u044e \u2014 27 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1654
    \u0433\u043e\u0434\u0430) \u0432 \u0411\u0430\u0437\u0435\u043b\u0435, \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0438\u044f.
    \u041e\u043d \u0431\u044b\u043b \u0441\u044b\u043d\u043e\u043c \u043f\u0440\u0435\u0443\u0441\u043f\u0435\u0432\u0430\u044e\u0449\u0435\u0433\u043e
    \u0444\u0430\u0440\u043c\u0430\u0446\u0435\u0432\u0442\u0430 \u041d\u0438\u043a\u043e\u043b\u0430\u044f
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0438 \u041c\u0430\u0440\u0433\u0430\u0440\u0435\u0442
    \u0428\u0451\u043d\u0430\u0443\u044d\u0440, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0432\u0448\u0435\u0439
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u0431\u0430\u043d\u043a\u0438\u0440\u043e\u0432
    \u0438 \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0438\u0445 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u0432.
    \u0421\u0435\u043c\u044c\u044f \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438, \u0438\u043c\u0435\u0432\u0448\u0430\u044f
    \u0444\u043b\u0430\u043c\u0430\u043d\u0434\u0441\u043a\u0438\u0435 \u043a\u043e\u0440\u043d\u0438,
    \u0431\u0435\u0436\u0430\u043b\u0430 \u0432 \u0411\u0430\u0437\u0435\u043b\u044c \u043e\u0442
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0445 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u0433\u0435\u0440\u0446\u043e\u0433\u0430
    \u0410\u043b\u044c\u0431\u044b \u0432 1583 \u0433\u043e\u0434\u0443. \u041e\u0442\u0435\u0446
    \u042f\u043a\u043e\u0431\u0430 \u0431\u044b\u043b \u0432\u0438\u0434\u043d\u044b\u043c \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d\u043e\u043c
    \u0411\u0430\u0437\u0435\u043b\u044f, \u0447\u043b\u0435\u043d\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0432\u0435\u0442\u0430 \u0438 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u043c.
    \u0412\u043e\u043f\u0440\u0435\u043a\u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u044e \u043e\u0442\u0446\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0435\u0433\u043e
    \u043a \u0434\u0443\u0445\u043e\u0432\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u0435,
    \u042f\u043a\u043e\u0431 \u0442\u0430\u0439\u043d\u043e \u0443\u0432\u043b\u0435\u043a\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439. \u041e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e \u0441 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u0435\u043c.
    \u0412 1671 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438, \u0430 \u0432 1676 \u2014 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043b\u0438\u0446\u0435\u043d\u0446\u0438\u0430\u0442\u0430 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u044f
    \u0432 \u0411\u0430\u0437\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u0417\u0430 \u0432\u0440\u0435\u043c\u044f \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f
    \u043e\u043d \u043e\u0432\u043b\u0430\u0434\u0435\u043b \u043f\u044f\u0442\u044c\u044e \u044f\u0437\u044b\u043a\u0430\u043c\u0438:
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c, \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c,
    \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u043c, \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u043c
    \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c.\n\n\U0001F30D \u0413\u043e\u0434\u044b
    \u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0438\u0439 \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f
    \u0412 1676\u20131680 \u0433\u043e\u0434\u0430\u0445 \u042f\u043a\u043e\u0431 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u0435\u0437\u0434\u043a\u0443
    \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u0447\u0430\u0441\u0442\u043d\u044b\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c
    \u0432 \u0416\u0435\u043d\u0435\u0432\u0435 \u0438 \u0424\u0440\u0430\u043d\u0446\u0438\u0438,
    \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b \u0438\u0434\u0435\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438
    \u041d\u0438\u043a\u043e\u043b\u044f \u041c\u0430\u043b\u044c\u0431\u0440\u0430\u043d\u0448\u0430.
    \u0412 1681\u20131682 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u043b
    \u043d\u043e\u0432\u043e\u0435 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435,
    \u043f\u043e\u0441\u0435\u0442\u0438\u0432 \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u044b
    \u0438 \u0410\u043d\u0433\u043b\u0438\u044e. \u0422\u0430\u043c \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0438 \u0437\u0430\u0432\u044f\u0437\u0430\u043b \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438: \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u043c
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441\u043e\u043c, \u0420\u043e\u0431\u0435\u0440\u0442\u043e\u043c
    \u0411\u043e\u0439\u043b\u0435\u043c \u0438 \u0420\u043e\u0431\u0435\u0440\u0442\u043e\u043c
    \u0413\u0443\u043a\u043e\u043c. \u042d\u0442\u0438 \u043f\u043e\u0435\u0437\u0434\u043a\u0438
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u043b\u0438
    \u0435\u0433\u043e \u043a\u0440\u0443\u0433\u043e\u0437\u043e\u0440 \u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b \u043d\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F4DA
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432 \u0411\u0430\u0437\u0435\u043b\u044c
    \u0432 1683 \u0433\u043e\u0434\u0443, \u042f\u043a\u043e\u0431 \u043d\u0430\u0447\u0430\u043b
    \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435 \u0432 \u0411\u0430\u0437\u0435\u043b\u044c\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0412 1684 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u042e\u0434\u0438\u0442
    \u0428\u0442\u0443\u043f\u0430\u043d\u0443\u0441, \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0443 \u043d\u0435\u0433\u043e \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0441\u044b\u043d
    \u0438 \u0434\u043e\u0447\u044c. \u0415\u0433\u043e \u0434\u0435\u0442\u0438, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0447\u043b\u0435\u043d\u043e\u0432
    \u0441\u0435\u043c\u044c\u0438 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438, \u043d\u0435
    \u043f\u043e\u0448\u043b\u0438 \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c \u043e\u0442\u0446\u0430.
    \u0412 1687 \u0433\u043e\u0434\u0443 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u0435
    \u0432 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0435: \u043e\u043d \u0431\u044b\u043b
    \u0438\u0437\u0431\u0440\u0430\u043d \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0411\u0430\u0437\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u044d\u0442\u0443 \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0441\u0432\u043e\u0438\u0445 \u0434\u043d\u0435\u0439.\n\n\U0001F52D \u041d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u042f\u043a\u043e\u0431\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0431\u044b\u043b\u0430
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0439
    \u0438 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u043b\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439. \u041e\u0441\u0432\u043e\u0435\u043d\u0438\u0435
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430:
    \u0412 1687 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u043f\u0435\u0440\u0432\u044b\u043c \u043c\u0435\u043c\u0443\u0430\u0440\u043e\u043c
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e (1684 \u0433\u043e\u0434) \u0438
    \u043d\u0430\u0447\u0430\u043b \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0441\u0432\u0430\u0438\u0432\u0430\u0442\u044c. \u041e\u0442\u0432\u0435\u0442 \u043e\u0442
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u043d\u0430 \u0437\u0430\u043f\u0440\u043e\u0441\u044b
    \u043e \u0440\u0430\u0437\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f\u0445 \u043f\u0440\u0438\u0448\u0435\u043b
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0433\u043e\u0434\u0430,
    \u043d\u043e \u043a \u0442\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u042f\u043a\u043e\u0431 \u0443\u0436\u0435 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0432\u043b\u0430\u0434\u0435\u043b \u043d\u043e\u0432\u044b\u043c \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u043c
    \u0438 \u043d\u0430\u0447\u0430\u043b \u043e\u0431\u0443\u0447\u0430\u0442\u044c \u0435\u043c\u0443
    \u0441\u0432\u043e\u0435\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0430.
    \u042f\u043a\u043e\u0431, \u0418\u043e\u0433\u0430\u043d\u043d \u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0438 \u0442\u0440\u0438\u0443\u043c\u0432\u0438\u0440\u0430\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430 20 \u043b\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0442\u0435\u0440\u043c\u0438\u043d\u0430 \u00ab\u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u00bb:
    \u0412 1690 \u0433\u043e\u0434\u0443 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0435 \u043e \u043a\u0440\u0438\u0432\u043e\u0439 \u0440\u0430\u0432\u043d\u043e\u0433\u043e
    \u0441\u043f\u0443\u0441\u043a\u0430 (\u0438\u0437\u043e\u0445\u0440\u043e\u043d\u0435),
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0438\u043b \u0432 \u043f\u0435\u0447\u0430\u0442\u0438
    \u0442\u0435\u0440\u043c\u0438\u043d \u00ab\u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u00bb
    \u0432 \u0435\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0432\u0430\u0436\u043d\u043e\u0439 \u0432\u0435\u0445\u043e\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u043a\u0440\u0438\u0432\u044b\u0445: \u041e\u043d \u0432\u043d\u0435\u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0432
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u043c\u043d\u043e\u0433\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445.
    \u0415\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u0430
    \u043b\u0435\u043c\u043d\u0438\u0441\u043a\u0430\u0442\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435\u043c \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u044b
    \u0438 \u0446\u0435\u043f\u043d\u043e\u0439 \u043b\u0438\u043d\u0438\u0438. \u041e\u0441\u043e\u0431\u0443\u044e
    \u043b\u044e\u0431\u043e\u0432\u044c \u042f\u043a\u043e\u0431 \u043f\u0438\u0442\u0430\u043b
    \u043a \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u043f\u0438\u0440\u0430\u043b\u0438, \u0432\u043e\u0441\u0445\u0438\u0449\u0430\u044f\u0441\u044c
    \u0435\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e\u043c \u0441\u0430\u043c\u043e\u043f\u043e\u0434\u043e\u0431\u0438\u044f
    \u2014 \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u043e\u0439
    \u043f\u0440\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u0445.
    \u0427\u0438\u0441\u043b\u043e e: \u0412 1683 \u0433\u043e\u0434\u0443, \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u044f
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0430\u0445,
    \u043e\u043d \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b \u043f\u0440\u0435\u0434\u0435\u043b
    `lim (1 + 1/n)^n`, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a
    \u0447\u0438\u0441\u043b\u043e `e`. \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439:
    \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0435
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435.
    \u041e\u043d \u0432\u0432\u0435\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043d\u044f\u0442\u0438\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434,
    \u00ab\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0439\u00bb
    (`Ars Conjectandi`), \u0431\u044b\u043b \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e, \u0432 1713 \u0433\u043e\u0434\u0443.
    \u0412 \u044d\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435 \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0447\u0430\u0441\u0442\u043d\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439 \u0437\u0430\u043a\u043e\u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u0445
    \u0447\u0438\u0441\u0435\u043b (\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0430\u043a
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438),
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438. \u0412 \u0435\u0433\u043e
    \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0447\u0438\u0441\u043b\u0430
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0438 \u0432\u0430\u0436\u043d\u043e\u0435
    \u0432 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0435 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435:
    \u0412 1699 \u0433\u043e\u0434\u0443 \u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u0430 \u0432
    1701 \u0433\u043e\u0434\u0443 \u2014 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a.\n\n\u2694\ufe0f
    \u0421\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441 \u0431\u0440\u0430\u0442\u043e\u043c
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u042f\u043a\u043e\u0431\u0430 \u0441
    \u043c\u043b\u0430\u0434\u0448\u0438\u043c \u0431\u0440\u0430\u0442\u043e\u043c \u0418\u043e\u0433\u0430\u043d\u043d\u043e\u043c
    \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u0431\u044b\u043b\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c,
    \u043d\u043e \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u0438
    \u0432 \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e.
    \u0411\u0438\u043e\u0433\u0440\u0430\u0444\u044b \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u042f\u043a\u043e\u0431\u0430 \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e,
    \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e,
    \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u0438 \u043c\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043d\u0435\u0438\u0437\u0431\u0435\u0436\u043d\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b\u043e
    \u043a \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430\u043c \u0441 \u043d\u0435
    \u043c\u0435\u043d\u0435\u0435 \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u044b\u043c
    \u0431\u0440\u0430\u0442\u043e\u043c. \u0418\u0445 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0435
    \u0441\u043f\u043e\u0440\u044b, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435
    \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0430
    \u0432 \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0438\u044e \u0432 1695 \u0433\u043e\u0434\u0443,
    \u0441\u0442\u0430\u043b\u0438 \u0448\u0438\u0440\u043e\u043a\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u0438, \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432,
    \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c\u0443
    \u0440\u0430\u0437\u0440\u044b\u0432\u0443 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439
    \u0432 1697 \u0433\u043e\u0434\u0443.\n\n\U0001F56F\ufe0f \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435 \u0412
    1692 \u0433\u043e\u0434\u0443 \u0443 \u042f\u043a\u043e\u0431\u0430 \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430.
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u043f\u043e\u0434\u0442\u0430\u0447\u0438\u0432\u0430\u043b\u0430
    \u0435\u0433\u043e \u0441\u0438\u043b\u044b \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u043c\u043d\u043e\u0433\u0438\u0445 \u043b\u0435\u0442, \u0438 \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    16 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1705 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0430\u0437\u0435\u043b\u0435.
    \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043e\u043d \u0431\u044b\u043b \u0432
    \u0411\u0430\u0437\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0441\u043e\u0431\u043e\u0440\u0435.
    \u0421\u043b\u0435\u0434\u0443\u044f \u0435\u0433\u043e \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u044e,
    \u043d\u0430 \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0438 \u0434\u043e\u043b\u0436\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0431\u044b\u0442\u044c \u0432\u044b\u0440\u0435\u0437\u0430\u043d\u0430
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u043f\u0438\u0440\u0430\u043b\u044c \u0441 \u043d\u0430\u0434\u043f\u0438\u0441\u044c\u044e
    \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438: \u00abEADEM MUTATA RESURGO\u00bb (\u00ab\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u043d\u0430\u044f,
    \u044f \u0432\u043d\u043e\u0432\u044c \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0430\u044e\u00bb),
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0439
    \u0432\u0435\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0435\u043d\u0438\u0435.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b
    \u0438\u043b\u0438 \u043f\u043e \u043d\u0435\u0437\u043d\u0430\u043d\u0438\u044e, \u043a\u0430\u043c\u0435\u043d\u0449\u0438\u043a\u0438
    \u0438\u0437\u043e\u0431\u0440\u0430\u0437\u0438\u043b\u0438 \u043d\u0430 \u0435\u0433\u043e
    \u043c\u043e\u0433\u0438\u043b\u0435 \u0430\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u0432\u0443,
    \u0430 \u043d\u0435 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u043f\u0438\u0440\u0430\u043b\u044c. \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u042f\u043a\u043e\u0431\u0430 \u0435\u0433\u043e \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0432 \u0411\u0430\u0437\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0437\u0430\u043d\u044f\u043b \u0435\u0433\u043e \u0431\u0440\u0430\u0442 \u0418\u043e\u0433\u0430\u043d\u043d.
    \u0412 \u0447\u0435\u0441\u0442\u044c \u0431\u0440\u0430\u0442\u044c\u0435\u0432 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u043d\u0430\u0437\u0432\u0430\u043d \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435."
  shortBioEn: "Jacob Bernulli is a Swiss mathematician, one of the founders of probability theory and mathematical analysis, and he was the older brother of Johann Bernulli, with whom he set the basis for the variable calculation, and Uncle Daniel Bernulli, and a detailed biography based on historical and encyclopedia sources.\n\n==Early life==Jacob Bernulli was born on January 6, 1655 (old style – December 27, 1654) in Basel, Switzerland, and was the son of a successful pharmacist, Nikolai Bernulli and Margaret Schönauer, from the family of bankers and city advisers, and the family of Bernulli, who had Flemish roots, fled to Basel from the religious persecution of the Spanish Duke Alba in 1583.Jacob's father was a prominent citizen of Basel, a member of the city council and a magistrate, and despite the wishes of his father, who prepared him for a spiritual career, Jacob secretly became involved in mathematics, and studied mathematics independently, in parallel with theology, and in 1671 he received a Master of Philosophy degree, and in 1676 he received a Master of Philosophy degree in theology of the University of Basel.During his studies, he learned five languages: French, Italian, English, Latin and Greek.\n\n==History==Jacob made a long trip across Europe from 1676 to 1680, working as a private teacher in Geneva and France, where he studied the ideas of the followers of Decart, in particular Nicole Malbrus, and in 1681 to 1682 he undertook a new journey to visit the Netherlands and England, where he met and closed correspondence with leading scholars of the time: Christian Guygens, Robert Boyle and Robert Guke.These visits have greatly expanded his vision and allowed scientific contacts to be made for life.\n\n===Academic career===Jakob began to lecture on experimental physics at the University of Basel in 1683, and in 1684 he married Judith Stupanus, from whom he had a son and daughter. His children, unlike many other members of the Bernulli family, did not follow in the footsteps of his father.In 1687, he was elected professor of mathematics at the University of Basel and held the Chair for the rest of his life.\n\n==History==The scientific work of Jacob Bernulli was extremely fruitful and covered many fields, including Leibnitz's analysis: In 1687, he studied the first memoir of Leibnitz on a differential basis (1684) and began to study it himself.The answer from Leibnitz to the requests for clarification came three years later, but by that time Jacob had himself acquired a new calculation and began to teach him his brother Johann, Jacob, Johann and Leibnitz formed a triumvirate that set the development of European mathematics for 20 years.Introduction of the term \"integrated\": In 1690, Bernulli first used the term \"integrated\" in the press in its contemporary meaning, which was an important milestone in the history of mathematics. Research on curves: He made a huge contribution to analytical geometry by examining the properties of many curves. His name is Lemnisette Bernulli, and he also studied the cycle and chain.Jacob's special love for the logarithmic spiral, admired its self-like properties to remain unchanged in various changes. The number e: In 1683, researching the problem of complex interest, he discovered the limit `lim (1 + 1/n) &apos; which later became known as the number `e &apos; . The probability theory: This is probably his most significant legacy. He introduced many modern concepts of probability theory.His main work, \"Ars Conjectandi\", was published postmortem in 1713, and in this book he formulated and proved a private case of the law of large numbers (known as the Bernulli Theorem), which was the foundation of all modern statistics.Acceptance: Jacob Bernulli became a member of the Paris Academy of Sciences in 1699 and the Berlin Academy of Sciences in 1701.\n\n♪ The competition with Jacob's brother with his younger brother Johann was initially a collaboration, but eventually grew into violent rivalry, and the biographers described Jacob as being sensitive, irritating, aggressive, and vengeful, which inevitably led to conflicts with an equally ambitious brother.Their public disputes, particularly after Johann moved to Holland in 1695, became widely known and, according to historians, contributed to the final breakup in 1697.\n\n==Death======================================================================]=======================================================================)=========)=============)==========)=========================================================================However, ironically, or out of ignorance, the masons painted the archimedes on his grave, not the logarithmic spiral, after Jacob's death, his chair at the University of Basel was occupied by his brother Johann, and named a crater on the Moon after the Bernulli brothers."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u042f\u043a\u043e\u0431\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0434\u0430
    \u0441\u0443\u0445\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u043d\u043e \u0438 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u043f\u043e\u043b\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u044b\u0445
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439 \u0438 \u0434\u0430\u0436\u0435
    \u0442\u0440\u0430\u0433\u0438\u043a\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0448\u0438\u0431\u043e\u043a. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u044f\u0440\u043a\u0438\u0435 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438:\n\n\U0001F9F2
    \u00ab\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0441\u043f\u0438\u0440\u0430\u043b\u044c\u00bb
