    \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u043a\u043e\u043c \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u043c
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u0432 1713 \u0433\u043e\u0434\u0443, \u0447\u0435\u0440\u0435\u0437
    \u0432\u043e\u0441\u0435\u043c\u044c \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438. \u0412 \u044d\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435
    \u043e\u043d, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0447\u0438\u0441\u0435\u043b
    \u2014 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u0441\u0430\u043c \u0441 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u044c\u044e \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0441\u0432\u043e\u0435\u0439 \u00ab\u0417\u043e\u043b\u043e\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u043e\u0439\u00bb.\n\n\U0001F4DA
    \u0421\u0430\u043c\u043e\u0443\u0447\u043a\u0430 \u0438 \u043f\u043e\u043b\u0438\u0433\u043b\u043e\u0442
    \u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 \u2014 \u044f\u0440\u043a\u0438\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0448\u0435\u043b \u043d\u0430\u043f\u0435\u0440\u0435\u043a\u043e\u0440 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u043c
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f\u043c. \u0415\u0433\u043e \u043e\u0442\u0435\u0446
    \u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0435\u0433\u043e \u043a \u043a\u0430\u0440\u044c\u0435\u0440\u0435
    \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0430, \u043d\u043e \u042f\u043a\u043e\u0431,
    \u0432\u043e\u043f\u0440\u0435\u043a\u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u044e \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439,
    \u0442\u0430\u0439\u043d\u043e \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439, \u043e\u0441\u0432\u043e\u0438\u0432
    \u0438\u0445 \u0432 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e.
    \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u043e\u043d \u0431\u044b\u043b \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d: \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u043e\u043d \u043e\u0432\u043b\u0430\u0434\u0435\u043b \u043f\u044f\u0442\u044c\u044e \u044f\u0437\u044b\u043a\u0430\u043c\u0438
    \u2014 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c, \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c,
    \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u043c, \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u043c
    \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c \u2014 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.\n\n\U0001F315 \u041b\u0443\u043d\u043d\u044b\u0439
    \u043a\u0440\u0430\u0442\u0435\u0440 \u0438 \u0442\u0440\u0430\u043c\u0432\u0430\u0439\u043d\u044b\u0435
    \u043f\u0443\u0442\u0438 \u041f\u0430\u043c\u044f\u0442\u044c \u043d\u0430 \u043d\u0435\u0431\u0435\u0441\u0430\u0445:
    \u0412 \u0447\u0435\u0441\u0442\u044c \u042f\u043a\u043e\u0431\u0430 \u0438 \u0435\u0433\u043e
    \u0431\u0440\u0430\u0442\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u043d
    \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435 \u2014 \u043a\u0440\u0430\u0442\u0435\u0440
    \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438 (Bernoulli). \u041f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041a\u0440\u0438\u0432\u0430\u044f
    \u043b\u0435\u043c\u043d\u0438\u0441\u043a\u0430\u0442\u0430 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f \u0432 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c,
    \u043d\u0430\u0448\u043b\u0430 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0438\u0438.
    \u0415\u0435 \u0444\u043e\u0440\u043c\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u043f\u0440\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0442\u0440\u0430\u043c\u0432\u0430\u0439\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439
    \u043d\u0430 \u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u0441 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u043c\u0438
    \u043c\u0430\u043b\u043e\u0433\u043e \u0440\u0430\u0434\u0438\u0443\u0441\u0430. \u042d\u0442\u0438
    \u0444\u0430\u043a\u0442\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442,
    \u0447\u0442\u043e \u042f\u043a\u043e\u0431 \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0441 \u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0443\u0448\u043e\u0439, \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430 (\u043f\u0443\u0441\u0442\u044c \u0438 \u043d\u0435\u043f\u0440\u0435\u0434\u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u043c,
    \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0441 \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0435\u043c)
    \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u043c \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435\u043c,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e
    \u0435\u043c\u0443 \u0432\u0438\u0434\u0435\u0442\u044c \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438
    \u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u044c\u044e."
  interestingFactsEn: "Jacob Bernulli's life is not only a series of dry mathematical achievements, but also a fascinating story full of curious details, philosophical reflections and even tragic mistakes.\n\nThe most famous and touching fact is his love for logarithmic spiral. Jacob was so enthralled by its unique characteristic — to keep his shape in any transformation of scale (the same kind) — as Spira Mirabilis. He ordered the spiral to be removed on its topstone along with its motto in Latin: \"EADEM MUTATA RESURGO\".This phrase is translated as \"Changed, I Resurrect\" or \"Though I Changed, I Reveal the same.\" For Bernully, it was not just a beautiful mathematical object, but a deep symbol of endurance, persistence in adversity, and even the resurrection of the soul after death, but history had decided otherwise. The irony of fate (or the ignorance of the masons) was not the logarithmic, archimedic spiral on its grave in the Basel Cathedral.This makes it meaningless because the archimedes spiral has no self-like character; the great mathematician has been the victim of an unfortunate mistake, but has made this story even more famous.\n\nIn 1683, Jakob Bernulli, when he was thinking about the problem of continuous accumulation of complex interest, made another fundamental discovery. He wondered what would happen if interest on the deposit were to be assessed more often, not once a year, every month, every hour? In his calculations, he came to the limit of the sequence `lim (nBernulli showed that the limit was between 2.5 and 3, and in fact discovered the famous constant e (~2.71828...) later named and popularized by Leonard Eyler.\n\nThe \"Art of Promise\" is the main work that came to light after his death. The main work of his life, the monumental work on the probabilities theory of \"Art of Presumption\", was not published in the life of a scientist. It was published by his nephew, Nikolai Bernulli, in 1713, eight years after his death.In that book, he, inter alia, formulated and proved the first version of the law of large numbers, the fundamental theorem, which he himself proudly referred to as his \"Golden Theorem\".\n\nThe self-student and polygul of Jacob Bernulli is a vivid example of a man who went against family tradition, who was prepared by his father for his religious career, but Jacob, against the wishes of his parents, secretly engaged in mathematics and astronomy, learning them to a large extent on his own, and was brilliantly educated: he mastered five languages — French, Italian, English, Latin and Greek — and received a master of philosophy at the university.\n\n* Moon crater and tramways of Memory in Heaven: Jacob and his brother Johann are named after the crater on the Moon — Bernoulli Crater (Bernoulli). Applying geometry: The Lemniskat Bernulli curve, named after him, has found unexpected use in engineering, and its form is used in the design of tramways on small-radial rotations.These facts show that Jacob Bernulli was not just a great mathematician, but also a man with a poetic soul, a deep sense of humor (and unintentional in the case of a headstone) and innovative thinking that allowed him to see the connection between abstract numbers and real life."
