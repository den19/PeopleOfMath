  achievementsRu: "\u041f\u0430\u043b \u042d\u0440\u0434\u0451\u0448 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0435\u043c, \u0430
    \u0446\u0435\u043b\u0443\u044e \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0434\u0435\u0439, \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u043b\u0438\u0446\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439.\n\n\U0001F4A1
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u042d\u0440\u0434\u0451\u0448
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \"\u0440\u0435\u0448\u0430\u0442\u0435\u043b\u0435\u043c
    \u0437\u0430\u0434\u0430\u0447\", \u043d\u043e \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u0446\u0435\u043b\u044b\u0445 \u043f\u043e\u0434\u0445\u043e\u0434\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434:
    \u042d\u0440\u0434\u0451\u0448, \u043d\u0430\u0440\u044f\u0434\u0443 \u0441 \u041c\u0430\u0440\u043a\u043e\u043c
    \u041a\u0430\u0446\u0435\u043c \u0438 \u0434\u0440\u0443\u0433\u0438\u043c\u0438, \u043f\u0438\u043e\u043d\u0435\u0440\u0441\u043a\u0438
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u043a \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0421\u0443\u0442\u044c \u043c\u0435\u0442\u043e\u0434\u0430 \u043f\u0440\u043e\u0441\u0442\u0430
    \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0430: \u0447\u0442\u043e\u0431\u044b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u0430 \u0441 \u043d\u0443\u0436\u043d\u044b\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438, \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b,
    \u0447\u0442\u043e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e
    \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u043c\u0443 \u043e\u0431\u044a\u0435\u043a\u0442\u0443
    \u043d\u0435 \u043e\u0431\u043b\u0430\u0434\u0430\u0442\u044c \u044d\u0442\u0438\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u043c\u0435\u043d\u044c\u0448\u0435
    \u0435\u0434\u0438\u043d\u0438\u0446\u044b. \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e,
    \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0439 \u043e\u0431\u044a\u0435\u043a\u0442 \u0434\u043e\u043b\u0436\u0435\u043d
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c. \u042d\u0442\u043e\u0442
    \u043c\u0435\u0442\u043e\u0434 \u0441\u0442\u0430\u043b \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432 \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043f\u043e\u0438\u0441\u043a\u043e\u0432\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u042d\u0440\u0434\u0451\u0448\u0430\u2013\u041a\u0430\u0446\u0430,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0430\u044f, \u0447\u0442\u043e
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435\u0439 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u0435\u0442\u0441\u044f
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e,
    \u2014 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0435\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0420\u0430\u043c\u0441\u0435\u044f: \u042d\u0440\u0434\u0451\u0448 \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u043e\u0432
    \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u043f\u043e\u043b\u043d\u044b\u0439
    \u0445\u0430\u043e\u0441 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d: \u0432
    \u043b\u044e\u0431\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435
    \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430\u0439\u0434\u0443\u0442\u0441\u044f
    \u0443\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0434\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b.
    \u041e\u043d \u0432\u043d\u0435\u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0420\u0430\u043c\u0441\u0435\u044f, \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u0438 \u0440\u0435\u0448\u0438\u0432 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0437\u0430\u0434\u0430\u0447, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u0433\u043e\u0441\u0442\u0435\u0439
    \u043d\u0430 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0435, \u0441\u0440\u0435\u0434\u0438
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e
    \u043d\u0430\u0439\u0434\u0443\u0442\u0441\u044f \u043b\u0438\u0431\u043e `k` \u043f\u043e\u043f\u0430\u0440\u043d\u043e
    \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0445, \u043b\u0438\u0431\u043e `l` \u043f\u043e\u043f\u0430\u0440\u043d\u043e
    \u043d\u0435\u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0445 \u043b\u044e\u0434\u0435\u0439.
    \u042d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0430
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0430\u0444\u043e\u0432: \u042d\u0440\u0434\u0451\u0448
    \u0441\u0442\u043e\u044f\u043b \u0443 \u0438\u0441\u0442\u043e\u043a\u043e\u0432 \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0430\u0444\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0438\u0449\u0435\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u043b\u0438 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e
    \u0440\u0435\u0431\u0435\u0440 \u0432 \u0433\u0440\u0430\u0444\u0435 \u0441 \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438. \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u042d\u0440\u0434\u0451\u0448\u0430\u2013\u041a\u0443\u2013\u0420\u0430\u0434\u043e
    \u2014 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u043c
    \u0440\u0430\u0437\u043c\u0435\u0440\u0435 \u0441\u0435\u043c\u0435\u0439\u0441\u0442\u0432\u0430
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u043f\u043e\u043f\u0430\u0440\u043d\u043e
    \u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u044e\u0449\u0438\u0445\u0441\u044f. \u0415\u0433\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u043e \u043f\u0430\u0440\u043e\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u044f\u0445
    (Erd\u0151s Matching Conjecture), \u043a\u0430\u0441\u0430\u044e\u0449\u0430\u044f\u0441\u044f
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430
    \u0441\u0435\u043c\u0435\u0439\u0441\u0442\u0432\u0430 `k`-\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0431\u0435\u0437 \u043d\u0435\u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u043f\u0430\u0440, \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.\n\n\U0001F9E9
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0421\u043f\u0438\u0441\u043e\u043a
    \u0435\u0433\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432
    \u043e\u0433\u0440\u043e\u043c\u0435\u043d. \u0412\u043e\u0442 \u043b\u0438\u0448\u044c
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445:
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445 (\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e): \u0412
    1949 \u0433\u043e\u0434\u0443 \u042d\u0440\u0434\u0451\u0448 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0410\u0442\u043b\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u043e\u043c
    \u043d\u0430\u0448\u0435\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b, \u0442\u043e
    \u0435\u0441\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e,
    \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0449\u0435\u0435 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430.
    \u042d\u0442\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u0435 \u0431\u044b\u043b\u043e \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c
    \u0438, \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439 \u0432\u0440\u0430\u0436\u0434\u0435
    \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438.
    \u041f\u043e\u0441\u0442\u0443\u043b\u0430\u0442 \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0430
    (\u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e):
    \u0412 19 \u043b\u0435\u0442 \u042d\u0440\u0434\u0451\u0448 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0435
    \u0438 \u0438\u0437\u044f\u0449\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e
    \u0446\u0435\u043b\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430 `n > 1` \u043c\u0435\u0436\u0434\u0443
    `n` \u0438 `2n` \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0430\u0439\u0434\u0435\u0442\u0441\u044f
    \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0447\u0438\u0441\u043b\u043e. \u042d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u0430\u044f \u043a\u0440\u0443\u043f\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430, \u0441\u0440\u0430\u0437\u0443 \u043f\u0440\u0438\u043d\u0435\u0441\u0448\u0430\u044f
    \u0435\u043c\u0443 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c, \u0438
    \u0441\u0430\u043c \u042d\u0440\u0434\u0451\u0448 \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u043d\u0430\u0448\u0435\u043b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \"\u0438\u0437 \u041a\u043d\u0438\u0433\u0438\". \u042d\u0440\u0434\u0451\u0448\u0435\u0432\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434 \"\u043f\u043e\u043a\u0440\u044b\u0432\u0430\u044e\u0449\u0438\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c\": \u042d\u0440\u0434\u0451\u0448 \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \"\u043f\u043e\u043a\u0440\u044b\u0432\u0430\u044e\u0442\"
    \u0432\u0441\u0435 \u0446\u0435\u043b\u044b\u0435 \u0447\u0438\u0441\u043b\u0430. \u042d\u0442\u043e
    \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0432 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0438 \u043d\u0435\u0447\u0435\u0442\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u043d\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043c\u044b\u0445
    \u0432 \u0432\u0438\u0434\u0435 `2^k + p` (\u0433\u0434\u0435 `p` \u2014 \u043f\u0440\u043e\u0441\u0442\u043e\u0435).
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043f\u0440\u0438\u043c\u0438\u0442\u0438\u0432\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430\u0445: \u0412 1935 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0441\u0443\u043c\u043c\u0430
    `1/(a log a)` \u043f\u043e \u0432\u0441\u0435\u043c \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c
    `a` \u0438\u0437 \u043b\u044e\u0431\u043e\u0433\u043e \u043f\u0440\u0438\u043c\u0438\u0442\u0438\u0432\u043d\u043e\u0433\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 (\u0433\u0434\u0435 \u043d\u0438
    \u043e\u0434\u0438\u043d \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u043d\u0435 \u0434\u0435\u043b\u0438\u0442
    \u0434\u0440\u0443\u0433\u043e\u0439) \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0430.
    \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u043e\u043d \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c
    \u044d\u0442\u043e\u0439 \u0441\u0443\u043c\u043c\u044b \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044f
    \u043d\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u042d\u0442\u0430 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043a\u0430\u043a Erd\u0151s Primitive
    Set Conjecture, \u0431\u044b\u043b\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430
    \u043b\u0438\u0448\u044c \u0432 2022 \u0433\u043e\u0434\u0443 \u043e\u043a\u0441\u0444\u043e\u0440\u0434\u0441\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0414\u0436\u0430\u0440\u0435\u0434\u043e\u043c
    \u0414\u0443\u0439\u043a\u0435\u0440\u043e\u043c \u041b\u0438\u0445\u0442\u043c\u0430\u043d\u043e\u043c.\n\n\U0001F451
    \"\u041a\u043e\u0440\u043e\u043b\u044c \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0449\u0438\u043a\u043e\u0432
    \u0437\u0430\u0434\u0430\u0447\" \u0438 \u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u0432\u043a\u043b\u0430\u0434\u043e\u043c \u042d\u0440\u0434\u0451\u0448\u0430 \u0441\u0442\u0430\u043b\u043e
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c, \u043d\u043e \u0438 \u0438\u0445 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430.
    \u0422\u044b\u0441\u044f\u0447\u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437: \u041e\u043d
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0435
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c,
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0445 \u0432\u0441\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432.
    \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b \u0434\u0435\u043d\u0435\u0436\u043d\u044b\u0435
    \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u044f (\u043e\u0442
    25 \u0434\u043e 10 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432) \u0437\u0430 \u0438\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0415\u0433\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0442\u044c
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u0441\u043f\u0443\u0441\u0442\u044f. \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u042d\u0440\u0434\u0451\u0448\u0430\u2013\u0422\u0443\u0440\u0430\u043d\u0430
    \u043e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u044f\u0445: \u041e\u0434\u043d\u0430
    \u0438\u0437 \u0435\u0433\u043e \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0433\u0438\u043f\u043e\u0442\u0435\u0437
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u0435\u0441\u043b\u0438
    \u0441\u0443\u043c\u043c\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u0445 \u0432\u0435\u043b\u0438\u0447\u0438\u043d
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0440\u0430\u0441\u0445\u043e\u0434\u0438\u0442\u0441\u044f, \u0442\u043e \u044d\u0442\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0438
    \u0441\u043a\u043e\u043b\u044c \u0443\u0433\u043e\u0434\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0434\u043b\u0438\u043d\u044b. \u0412 2020 \u0433\u043e\u0434\u0443 \u0431\u044b\u043b
    \u0441\u0434\u0435\u043b\u0430\u043d \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0448\u0430\u0433
    \u0432\u043f\u0435\u0440\u0435\u0434, \u043a\u043e\u0433\u0434\u0430 \u0422\u043e\u043c\u0430\u0441
    \u0411\u043b\u0443\u043c \u0438 \u041e\u043b\u043e\u0444 \u0421\u0438\u0441\u0430\u0441\u043a
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u044d\u0442\u0443 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0434\u043b\u044f \u0441\u043b\u0443\u0447\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0439
    \u0434\u043b\u0438\u043d\u044b 3 (\u0442\u0440\u043e\u0435\u043a). \u0427\u0438\u0441\u043b\u043e
    \u042d\u0440\u0434\u0451\u0448\u0430: \u0415\u0433\u043e \u043a\u043e\u0447\u0435\u0432\u043e\u0439
    \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438 \u0438 \u0431\u043e\u043b\u0435\u0435
    500 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0438
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u043a\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c. `\u0427\u0438\u0441\u043b\u043e
    \u042d\u0440\u0434\u0451\u0448\u0430` \u2014 \u044d\u0442\u043e \u043a\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0438\u0439
    \u043f\u0443\u0442\u044c \u043f\u043e \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u043c
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f\u043c \u043e\u0442 \u0434\u0430\u043d\u043d\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0434\u043e \u0441\u0430\u043c\u043e\u0433\u043e
    \u042d\u0440\u0434\u0451\u0448\u0430. \u0423 \u0435\u0433\u043e \u043f\u0440\u044f\u043c\u044b\u0445
    \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0432\u043d\u043e
    1, \u0443 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u0435\u0433\u043e \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u0432
    \u2014 2 \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0441\u0435\u0442\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432
    \u0438 \u0435\u0433\u043e \u0440\u043e\u043b\u0438 \u043a\u0430\u043a \u0441\u0432\u044f\u0437\u0443\u044e\u0449\u0435\u0433\u043e
    \u0437\u0432\u0435\u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u0412\u043a\u043b\u0430\u0434 \u042d\u0440\u0434\u0451\u0448\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0443\u043c\u043c\u0430
    \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u044b\u0445 \u0442\u0435\u043e\u0440\u0435\u043c.
    \u042d\u0442\u043e \u0446\u0435\u043b\u0430\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043a\u0430\u043a \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e,
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0433\u043e \u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430. \u041e\u043d \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0447 \u0432 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0438\u0433\u0440\u0443, \u0430 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u2014 \u0432 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0434\u0432\u0438\u0433\u0430\u0442\u044c \u043d\u0430\u0443\u043a\u0443 \u0432\u043f\u0435\u0440\u0435\u0434."
  achievementsEn: "Paul Erdös left behind a whole universe of mathematical ideas, methods, and open questions, not just a collection of theorem, but a whole universe of mathematical ideas, methods and open questions, and his contribution essentially defined the face of modern combinatorics and numbers theory. Here is a detailed overview of his major scientific achievements.\n\nThe basic methods and areas of the Erdös were not just the problem solver, but the creator of whole approaches that changed mathematics. The probability method: Erdös, along with Mark Katz and others, pioneered the probability theory to pure mathematics. The essence of the method is simple and genius: to prove the existence of an object with the right properties, it showed that the probability of a randomly chosen object does not have these properties less than one.This meant that such an object should exist. This method became the cornerstone of discrete mathematics and is used, for example, in the development of encryption algorithms and search systems. The Erdös-Katsa theorem, which claims that the number of simple random number dividers is subject to normal distribution, is a classic example of its use.Ramsay Theory: Erdes became one of the main architects of this area, claiming that total chaos is impossible: any structure is necessarily structured in a large enough way. He has made a huge contribution to Ramsay's theory by setting and solving many problems, such as the number of guests at a party, among whom there are guaranteed to be either `k' partners or `l' in pairs of strangers.Erdös was at the origin of extreme graph theory, looking for a maximum or minimum number of ribs in the specified properties box. The famous Erdös-Ku Rado theorem is the fundamental result of the maximum size of a family of multiples that overlap in pairs.His theory of steam relationships (Erdʹs Matching Convention) concerning the maximum size of the `k'-element family without non-interruptible couples remains a key open issue in this area.\n\nThe key theorems and the opening of the list of its specific results are enormous. Here are just a few of the brightest ones: the simple numbers theorem (elementary evidence): In 1949, Erdös, together with Atla Selberg, found the first basic proof of the asymptotic law of prime allocation, i.e., evidence that does not use integrated analysis techniques.This event was sensational and, unfortunately, led to years of hostility between the two mathematicians. Bertrand postulat (elegant evidence): At the age of 19, Erdös offered incredibly simple and elegant evidence that for any whole number `n > 1' between `n' and `2n' there was always a simple number. This was his first major work, immediately bringing him to his attention, and Erdös himself believed that he had found evidence \"from the Book\".Erdošev's \"covering systems\" method: Erdösch introduced the concept of systems of comparisons that \"cover\" all whole numbers. This is a powerful tool in the combination theory of numbers that he used to prove that there are endless arithmetical advances of odd numbers that are not represented as `2 ~k + p' (where `p' is simple).The theory of primitive multiples: In 1935, he proved that the sum `1/(a log a)' for all elements `a' of any primitive set (where no element divides another) was limited. Moreover, he made a famous hypothesis that the maximum amount was achieved by a multitude of prime numbers. This hypothesis, known as the Erd\\s PRIMative Set Project, was only proved by Oxford mathematician Jared Dyker Lichtman in 2022.\n\n♪ The King of the Problemmakers and his legacy ♪ ♪ Perhaps the greatest contribution of Erdös was not only to solve the problems but also to produce them. ♪ Thousands of hypotheses: He has formulated an incredible number of problems covering all his areas of interest ♪ ♪ He offered cash rewards (from $25 to $10,000) for solving them ♪ ♪ That's incredibly stimulating math ♪ ♪ His hypotheses continue to inspire research decades later ♪Erdös-Thuran's problem about progress: One of his most famous and complex hypotheses is that if the sum of the inverse values of the elements of the multitude is different, it is a multitude that contains arithmetical progress as long as possible. In 2020, a huge step forward was taken when Thomas Bloom and Olof Sisask proved this hypothesis for a progressive 3 (three) length.The number of Erdös: Its nomadic lifestyle and over 500 sponsors have produced a unique science metric. \"The number of Erdösa\" is the shortest way from a given scientist to Erdös himself, and its direct sponsors have one, the co-authors have two, and so on. This has become a symbol of an incredible network of scientific contacts and its role as a link to the mathematical world.Erdös' contribution is not just the sum of proven theorem; it's a whole philosophy of mathematics as a social, open and continuous process; it turned problem solving into an exciting game, and problem making is an art that continues to move science forward."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041f\u0430\u043b\u0430
    \u042d\u0440\u0434\u0451\u0448\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0435\u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u2014
    \u043e\u043d\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0430
    \u0441\u043e\u0431\u043e\u0439 \u043f\u043e\u043b\u043d\u043e\u0435 \u0438 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0435
    \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0433\u043e
    \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u043e\u0434\u043d\u043e\u0439 \u0446\u0435\u043b\u0438: \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041e\u043d \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0432\u0441\u0435\u0445 \u043e\u0431\u0449\u0435\u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0445
    \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u043e\u0432 \"\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439\"
    \u0436\u0438\u0437\u043d\u0438, \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0430\u0442\u044c
    \"\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c\".\n\n\U0001F494
    \u0422\u0440\u0430\u0432\u043c\u0430 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0438 \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u0430\u044f
    \u0441\u0432\u044f\u0437\u044c \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e \u0421\u0443\u0434\u044c\u0431\u0430
    \u042d\u0440\u0434\u0451\u0448\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u0434\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0430
    \u0441 \u043f\u0435\u0440\u0432\u044b\u0445 \u0447\u0430\u0441\u043e\u0432 \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u0438. \u0412 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f, \u0435\u0433\u043e \u0434\u0432\u0435
    \u0441\u0442\u0430\u0440\u0448\u0438\u0435 \u0441\u0435\u0441\u0442\u0440\u044b, 3 \u0438
    5 \u043b\u0435\u0442, \u0443\u043c\u0435\u0440\u043b\u0438 \u043e\u0442 \u0441\u043a\u0430\u0440\u043b\u0430\u0442\u0438\u043d\u044b.
    \u042d\u0442\u0430 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f \u043d\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u043e\u0442\u043f\u0435\u0447\u0430\u0442\u043e\u043a \u043d\u0430 \u0432\u0441\u044e \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c. \u041c\u0430\u0442\u044c, \u0410\u043d\u043d\u0430, \u0431\u044b\u043b\u0430
    \u0442\u0440\u0430\u0432\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0430 \u043f\u043e\u0442\u0435\u0440\u0435\u0439
    \u0438 \u043f\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u043e\u044f\u043b\u0430\u0441\u044c,
    \u0447\u0442\u043e \u0441\u044b\u043d \u043f\u043e\u0434\u0445\u0432\u0430\u0442\u0438\u0442
    \u043a\u0430\u043a\u0443\u044e-\u043d\u0438\u0431\u0443\u0434\u044c \u0437\u0430\u0440\u0430\u0437\u0443
    \u043e\u0442 \u0447\u0443\u0436\u0438\u0445 \u043b\u044e\u0434\u0435\u0439. \u0418\u0437-\u0437\u0430
    \u044d\u0442\u043e\u0433\u043e \u0441\u0442\u0440\u0430\u0445\u0430 \u043e\u043d\u0430 \u0434\u0435\u0440\u0436\u0430\u043b\u0430
    \u041f\u0430\u043b\u0430 \u043d\u0430 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u043c \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0438
    \u0434\u043e 10 \u043b\u0435\u0442. \u041f\u043e \u0441\u0443\u0442\u0438, \u0435\u0433\u043e
    \u043c\u0438\u0440\u043e\u043c \u0434\u043e \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432\u043e\u0433\u043e
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0431\u044b\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u043d \u0441\u0430\u043c \u0438 \u0435\u0433\u043e \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438.
    \u041c\u0430\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0441\u0442\u0430\u043b\u0430 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c \u0438
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c,
    \u0430 \u043e\u0442\u0435\u0446, \u0432\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0439\u0441\u044f
    \u0438\u0437 \u0441\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e \u043f\u043b\u0435\u043d\u0430,
    \u043a\u043e\u0433\u0434\u0430 \u041f\u0430\u043b\u0443 \u0431\u044b\u043b\u043e \u043e\u043a\u043e\u043b\u043e
    10 \u043b\u0435\u0442, \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b \u0435\u0433\u043e
    \u0441 \u0431\u043e\u043b\u0435\u0435 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438\u0434\u0435\u044f\u043c\u0438, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435
    \u0441 \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438.
    \u041c\u0430\u0442\u044c, \u0410\u043d\u043d\u0430 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c,
    \u0441\u0442\u0430\u043b\u0430 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0443 \u042d\u0440\u0434\u0451\u0448\u0430 \u0431\u044b\u043b\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f
    \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0432\u044f\u0437\u044c.
    \u041e\u043d\u0438 \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0431\u043b\u0438\u0437\u043a\u0438, \u0447\u0442\u043e, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u043c, \u0441\u043f\u0430\u043b\u0438 \u0432
    \u043e\u0434\u043d\u043e\u0439 \u043f\u043e\u0441\u0442\u0435\u043b\u0438 \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e \u0435\u0433\u043e \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0438 \u043e\u043d\u0430
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0430 \u0432\u0437\u0440\u043e\u0441\u043b\u043e\u043c\u0443
    \u0441\u044b\u043d\u0443 \u043c\u044b\u0442\u044c\u0441\u044f \u0438 \u043e\u0434\u0435\u0432\u0430\u0442\u044c\u0441\u044f.
    \u041e\u043d\u0430 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u043b\u0430
    \u0435\u0433\u043e \u0432 \u043f\u043e\u0435\u0437\u0434\u043a\u0430\u0445 \u043f\u043e
    \u043c\u0438\u0440\u0443 \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u0432\u043e\u0435\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0432 1971 \u0433\u043e\u0434\u0443.\n\n\U0001F392
    \u0410\u0441\u043a\u0435\u0442, \u0444\u0438\u043b\u0430\u043d\u0442\u0440\u043e\u043f \u0438
    \"\u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d \u043c\u0438\u0440\u0430\" \u042d\u0440\u0434\u0451\u0448
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442,
    \u0443 \u043d\u0435\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0435\u0442\u0435\u0439
    \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u043e\u043c\u0430.
    \u0415\u0433\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \"\u0434\u043e\u043c\u043e\u043c\" \u0431\u044b\u043b\u0438 \u0447\u0435\u043c\u043e\u0434\u0430\u043d
    \u0438 \u0440\u044e\u043a\u0437\u0430\u043a. \u0413\u043e\u0434\u044b \u0441\u043f\u0443\u0441\u0442\u044f
    \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0437\u0440\u044b\u0432\u0430 \u0441 \u0421\u0428\u0410
    \u0432 \u0440\u0430\u0437\u0433\u0430\u0440 \u043c\u0430\u043a\u043a\u0430\u0440\u0442\u0438\u0437\u043c\u0430
    \u043e\u043d \u0432\u0435\u043b \u043a\u043e\u0447\u0435\u0432\u043e\u0439 \u043e\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043d\u0438, \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u044f
    \u043f\u043e \u043c\u0438\u0440\u0443, \u043f\u043e\u044f\u0432\u043b\u044f\u044f\u0441\u044c
    \u043d\u0430 \u043f\u043e\u0440\u043e\u0433\u0435 \u043a\u043e\u043b\u043b\u0435\u0433 \u0441\u043e
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \"\u041c\u043e\u0439 \u043c\u043e\u0437\u0433
    \u043e\u0442\u043a\u0440\u044b\u0442\" \u0438 \u043e\u0441\u0442\u0430\u0432\u0430\u044f\u0441\u044c
    \u043d\u0430 \u0432\u0440\u0435\u043c\u044f \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0441\u0432\u043e\u044e \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c,
    \u043e\u043d \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0449\u0435\u0434\u0440. \u0412\u0441\u0435 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0435
    \u0434\u0435\u043d\u044c\u0433\u0438 \u0438 \u043f\u0440\u0435\u043c\u0438\u0438 \u043e\u043d
    \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b. \u0421\u0430\u043c\u044b\u043c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0442\u043e, \u043a\u0430\u043a, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0432 1984
    \u0433\u043e\u0434\u0443 \u043f\u0440\u0435\u043c\u0438\u044e \u0412\u043e\u043b\u044c\u0444\u0430
    \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u0435 50 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432,
    \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u0435\u0431\u0435 \u043b\u0438\u0448\u044c
    720 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432, \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b \u043d\u0430 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e
    \u0434\u043b\u044f \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0438 \u043f\u043e\u043c\u043e\u0449\u044c \u043d\u0443\u0436\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f.
    \u041e\u043d \u043c\u043e\u0433 \u043e\u0442\u0434\u0430\u0442\u044c \u0432\u0441\u0435
    \u0434\u0435\u043d\u044c\u0433\u0438 \u043f\u0435\u0440\u0432\u043e\u043c\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u043d\u043e\u043c\u0443
    \u043d\u0438\u0449\u0435\u043c\u0443, \u0430 \u0441\u0432\u043e\u0438 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438
    \u0442\u0440\u0430\u0442\u0438\u043b \u043d\u0430 \u043f\u043e\u043e\u0449\u0440\u0435\u043d\u0438\u0435
    \u0442\u0435\u0445, \u043a\u0442\u043e \u043c\u043e\u0433 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0435\u0433\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b. \u0422\u0430\u043a\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0430 \u043e\u0442
    \u043d\u0435\u0433\u043e \u043f\u043e\u043b\u043d\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438
    \u043e\u0442 \u0434\u0440\u0443\u0433\u0438\u0445. \u041e\u043d \u0431\u044b\u043b \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u043d\u0435 \u043f\u0440\u0438\u0441\u043f\u043e\u0441\u043e\u0431\u043b\u0435\u043d \u043a
    \u0431\u044b\u0442\u0443, \u043d\u0435 \u0443\u043c\u0435\u043b \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u0434\u0443\u0448\u0435\u043c, \u0437\u0430\u0432\u044f\u0437\u044b\u0432\u0430\u0442\u044c
    \u0448\u043d\u0443\u0440\u043a\u0438 \u0438 \u0434\u0430\u0436\u0435 \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043f\u0440\u043e\u0442\u043a\u043d\u0443\u043b \u043d\u043e\u0436\u043e\u043c \u043f\u0430\u043a\u0435\u0442
    \u0441 \u0442\u043e\u043c\u0430\u0442\u043d\u044b\u043c \u0441\u043e\u043a\u043e\u043c,
    \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0441\u0442\u0430\u0442\u044c \u0435\u0433\u043e.\n\n\U0001F9E0
    \u042d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u042d\u0440\u0434\u0451\u0448
    \u0431\u044b\u043b \u0430\u0441\u0435\u043a\u0441\u0443\u0430\u043b\u0435\u043d. \u0415\u0433\u043e
    \u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043a \u0436\u0435\u043d\u0449\u0438\u043d\u0430\u043c
    \u0438 \u0441\u0435\u043a\u0441\u0443 \u0431\u044b\u043b\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0438\u043b\u044c\u043d\u044b\u043c, \u0447\u0442\u043e, \u043f\u043e \u0441\u043b\u0443\u0445\u0430\u043c,
    \u043e\u043d \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0441\u044f \u043f\u043e\u0439\u0442\u0438
    \u043d\u0430 \u0441\u0442\u0440\u0438\u043f\u0442\u0438\u0437 \u0432 1940-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0434\u0438 \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    $100 \u0434\u043b\u044f \u0441\u0431\u043e\u0440\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u0432\u043e\u044e\u044e\u0449\u0435\u0433\u043e
    \u041a\u0438\u0442\u0430\u044f. \u0421\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c
    \u0443 \u043d\u0435\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u043b\u0441\u044f \u0441\u0432\u043e\u0439
    \"\u0441\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0439\" \u044f\u0437\u044b\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0432 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0430\u0445:
    \u0411\u043e\u0433\u0430 \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \"\u0412\u0435\u0440\u0445\u043e\u0432\u043d\u044b\u043c
    \u0424\u0430\u0448\u0438\u0441\u0442\u043e\u043c\" (SF). \u0414\u0435\u0442\u0435\u0439
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \"\u044d\u043f\u0441\u0438\u043b\u043e\u043d\u0430\u043c\u0438\"
    (\u0432 \u0447\u0435\u0441\u0442\u044c \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u0431\u0443\u043a\u0432\u044b, \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u044e\u0449\u0435\u0439
    \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u0443\u044e \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0443).
    \u0416\u0435\u043d\u0449\u0438\u043d \u2014 \"\u0431\u043e\u0441\u0441\u0430\u043c\u0438\",
    \u043c\u0443\u0436\u0447\u0438\u043d \u2014 \"\u0440\u0430\u0431\u0430\u043c\u0438\". \u0421\u0428\u0410
    \u2014 \"\u0421\u044d\u043c\" (\u0421\u0430\u043c\u0443\u0438\u043b), \u0430 \u0421\u0421\u0421\u0420
    \u2014 \"\u0414\u0436\u043e\" (\u0418\u043e\u0441\u0438\u0444). \u0421\u0430\u043c\u044b\u043c
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0430\u0441\u043f\u0435\u043a\u0442\u043e\u043c
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0441\u0442\u0430\u043b\u0430
    \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u043e\u0442 \u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d\u043e\u0432.
    \u041e\u043d \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b \u0438\u0445, \u0447\u0442\u043e\u0431\u044b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043f\u043e 20 \u0447\u0430\u0441\u043e\u0432
    \u0432 \u0441\u0443\u0442\u043a\u0438, \u0438 \u043b\u044e\u0431\u0438\u043b \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c:
    \"\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u2014 \u044d\u0442\u043e \u043c\u0430\u0448\u0438\u043d\u0430
    \u0434\u043b\u044f \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043a\u043e\u0444\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0435\u043c\u044b\". \u0412 1979 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u0434\u0440\u0443\u0433, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0420\u043e\u043d \u0413\u0440\u044d\u043c, \u043f\u043e\u0441\u043f\u043e\u0440\u0438\u043b
    \u0441 \u043d\u0438\u043c \u043d\u0430 $500, \u0447\u0442\u043e \u043e\u043d \u0441\u043c\u043e\u0436\u0435\u0442
    \u043c\u0435\u0441\u044f\u0446 \u043e\u0431\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f
    \u0431\u0435\u0437 \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u043e\u0432.
    \u042d\u0440\u0434\u0451\u0448 \u0432\u044b\u0438\u0433\u0440\u0430\u043b \u0441\u043f\u043e\u0440,
    \u043d\u043e \u043f\u043e\u0437\u0436\u0435 \u0441 \u0433\u0440\u0443\u0441\u0442\u044c\u044e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0441\u044f, \u0447\u0442\u043e \u044d\u0442\u043e\u0442
    \u043c\u0435\u0441\u044f\u0446 \u043e\u0442\u0431\u0440\u043e\u0441\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043d\u0430\u0437\u0430\u0434, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e
    \u043e\u043d \u043d\u0435 \u043c\u043e\u0433 \u0432\u0438\u0434\u0435\u0442\u044c \u043f\u0435\u0440\u0435\u0434
    \u0441\u043e\u0431\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u0430 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430 \u043f\u0443\u0441\u0442\u043e\u0439
    \u043b\u0438\u0441\u0442 \u0431\u0443\u043c\u0430\u0433\u0438. \u041a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0430\u0440\u0438 \u0431\u044b\u043b\u043e \u0432\u044b\u0438\u0433\u0440\u0430\u043d\u043e,
    \u043e\u043d \u0441\u0440\u0430\u0437\u0443 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u043a \u043f\u0440\u0438\u0435\u043c\u0443 \u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d\u043e\u0432.\n\n\U0001F54A\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u042d\u0440\u0434\u0451\u0448
    \u043d\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438.
    \u041e\u043d \u0448\u0443\u0442\u0438\u043b \u043d\u0430\u0434 \u043d\u0435\u0439, \u043f\u0440\u0438\u0434\u0443\u043c\u044b\u0432\u0430\u044f
    \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c\u044b
    \u0441 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043e\u043c: \"\u0411\u0435\u0434\u043d\u044b\u0439
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0441\u0442\u0430\u0440\u0438\u043a\", \"\u0416\u0438\u0432\u043e\u0439
    \u0442\u0440\u0443\u043f\", \"\u0410\u0440\u0445\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044d\u043a\u0441\u043f\u043e\u043d\u0430\u0442\". \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0434\u043e \u0441\u0430\u043c\u043e\u0433\u043e \u043a\u043e\u043d\u0446\u0430 \u0438
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438 \u0432 \u0412\u0430\u0440\u0448\u0430\u0432\u0435
    \u0432 1996 \u0433\u043e\u0434\u0443. \u0414\u0430\u0436\u0435 \u0442\u043e\u0433\u0434\u0430
    \u0432 \u0435\u0433\u043e \u043a\u0430\u0440\u043c\u0430\u043d\u0435 \u043b\u0435\u0436\u0430\u043b
    \u0431\u0438\u043b\u0435\u0442 \u043d\u0430 \u0441\u0430\u043c\u043e\u043b\u0435\u0442 \u0434\u043e
    \u0412\u0438\u043b\u044c\u043d\u044e\u0441\u0430, \u0433\u0434\u0435 \u0434\u043e\u043b\u0436\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u044c\u0441\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f
    \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u043e\u043c \u0444\u043e\u0440\u043c\u044b
    \u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f: \u043a\u0430\u0436\u0434\u043e\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0431\u043e\u043b\u0435\u0435
    \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439 \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439,
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e
    \u0431\u043e\u043b\u044c\u0448\u0435 \u0442\u0435\u043e\u0440\u0435\u043c \u0438 \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044c
    \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0434\u0435\u043b\u0430\u0442\u044c
    \u0442\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435. \u0415\u0433\u043e \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u043d\u044b\u0439
    \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438 \u0431\u044b\u043b \u043d\u0435
    \u0436\u0435\u0440\u0442\u0432\u043e\u0439, \u0430 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u044b\u043c
    \u0432\u044b\u0431\u043e\u0440\u043e\u043c, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0448\u0438\u043c
    \u0435\u043c\u0443 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0443\u044e
    \u0441\u0432\u043e\u0431\u043e\u0434\u0443 \u0434\u043b\u044f \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e,
    \u0447\u0442\u043e \u0438\u043c\u0435\u043b\u043e \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435."
  personalLifeEn: "Pala Erdös' personal life was not just unconventional; it was a complete and conscious submission to the same goal of all of its existence: mathematics; he deliberately abandoned all the commonly accepted attributes of \"normal\" life to become \"country-based mathematician\".\n\nThe trauma of childhood and the indissoluble connection with Destiny Erdös' mother was determined from the first hours of his life. On the day he was born, his two older sisters, three and five years old, died of the Scarlatine. This tragedy left a mark on his life. Mother, Anna, was traumatized by the loss and panicked that the son would catch some infection from strangers. Because of this fear, she kept Pahl in home-school education until she was 10 years old.His mother, who was a math teacher, became his first and main teacher, and his father, who returned from Siberian captivity when Palu was about 10 years old, introduced him to more complex mathematical ideas, including prime numbers. Mother, Anna Wilhelm, became the only woman with whom Erdös had a deep emotional connection.They were so close that, according to some reports, they slept in the same bed until he got to university, and she helped an adult son wash and dress, and she accompanied him on trips around the world until she died in 1971.\n\nAscet, philanthropist and \"world citizen\" Erdös never married, had no children and had no own home. His only home was a suitcase and a backpack. Years after the breakup with the United States in the midst of Macartism, he was traveling around the world, showing up on the doorstep of his colleagues with the words \"My brain is open\" and staying together. Despite his asceticity, he was incredibly generous.The most famous example is how, after receiving the Volf Prize of $50,000 in 1984, he kept only $720 and the rest for a scholarship for young mathematicians and help in need, he could give all the money to the first person to meet the beggar, and spent his scholarships to encourage those who could prove his hypothesis, a life that required him to be completely dependent on others.He was totally unadapted, couldn't use the shower, tie his shoelaces, and even once stabbed a bag of tomato juice to get it out.\n\nHis aversion to women and sex was so strong that he reportedly agreed to go to striptease in the 1940s only to earn $100 to raise funds for a fighting China. In time, he developed his \"secret\" language, which he used in his conversations: God called \"The Supreme Fascist\" (SF).Children called \"epsylons\" (in honor of a tiny Greek letter), women \"boss, men\" \"families.\" The United States called \"Samuel\" and the USSR called \"Joe\" (Josif). The most famous aspect of his personal life was addiction to amphetamines. He took them to work 20 hours a day, and he liked to say, \"Mathematics is a machine to turn coffee into theorems.\"In 1979, his friend, the mathematician Ron Graham, argued with him for $500 that he could spend a month without stimulants. Erdosh won the argument, but later, with sadness, admitted that this month had thrown the math back because he couldn't see the theorems in front of him, but he was just looking at an empty piece of paper. Once the bet was won, he immediately returned to the amphetamines.\n\nHe was joking at her, making aliases with age: \"A poor great old man\", \"A living corpse\", \"Archieological exhibit.\" He worked until the end and died of a heart attack during a conference in Warsaw in 1996, even then in his pocket was a plane ticket to Vilnius, where the next conference was to take place.His life was one of form and content: every action was designed to make mathematics more accessible and socially, to prove as much theorem as possible, and to awaken others to do the same; his ascetic lifestyle was not a victim, but an informed choice that allowed him to maintain absolute freedom for the only thing that mattered to him."
  shortBioRu: "\u041f\u0430\u043b \u042d\u0440\u0434\u0451\u0448 (Paul Erd\u0151s) \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u043c\u044f \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0430 \u0446\u0435\u043b\u0430\u044f
    \u044d\u043f\u043e\u0445\u0430 \u0438 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d. \u041e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u043b\u043e\u0434\u043e\u0432\u0438\u0442\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430,
    \u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c \u0433\u0435\u043d\u0438\u0435\u043c,
    \u0447\u0435\u0439 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0439
    \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438 \u0438 \u0441\u0442\u0438\u043b\u044c
    \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c\u0438.\n\n\U0001F9EC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0433\u0435\u043d\u0438\u044f \u041f\u0430\u043b \u042d\u0440\u0434\u0451\u0448 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    26 \u043c\u0430\u0440\u0442\u0430 1913 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435,
    \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0441 \u0441\u0430\u043c\u043e\u0433\u043e
    \u043d\u0430\u0447\u0430\u043b\u0430 \u0431\u044b\u043b\u0430 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u0430
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439: \u0434\u0432\u0435 \u0435\u0433\u043e
    \u0441\u0442\u0430\u0440\u0448\u0438\u0435 \u0441\u0435\u0441\u0442\u0440\u044b \u0443\u043c\u0435\u0440\u043b\u0438
    \u043e\u0442 \u0441\u043a\u0430\u0440\u043b\u0430\u0442\u0438\u043d\u044b \u0432 \u0434\u0435\u043d\u044c
    \u0435\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f. \u041e\u043f\u0430\u0441\u0430\u044f\u0441\u044c
    \u0437\u0430 \u0436\u0438\u0437\u043d\u044c \u0441\u044b\u043d\u0430, \u043c\u0430\u0442\u044c
    \u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u0435\u0433\u043e \u0434\u043e\u043c\u0430 \u0434\u043e
    10 \u043b\u0435\u0442, \u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d\u0430 \u0438
    \u043e\u0442\u0435\u0446 (\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0432\u0435\u043b
    \u0448\u0435\u0441\u0442\u044c \u043b\u0435\u0442 \u0432 \u0441\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u043c
    \u043f\u043b\u0435\u043d\u0443 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u041f\u0435\u0440\u0432\u043e\u0439
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b) \u0441\u0442\u0430\u043b\u0438
    \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c\u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u044f\u043c\u0438.
    \u042d\u0440\u0434\u0451\u0448 \u0440\u0430\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438.
    \u0412 \u0442\u0440\u0438 \u0433\u043e\u0434\u0430 \u043e\u043d \u043f\u0435\u0440\u0435\u043c\u043d\u043e\u0436\u0430\u043b
    \u0432 \u0443\u043c\u0435 \u0442\u0440\u0435\u0445\u0437\u043d\u0430\u0447\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430, \u0430 \u0432 \u0447\u0435\u0442\u044b\u0440\u0435 \u2014
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u00ab\u043e\u0442\u043a\u0440\u044b\u043b\u00bb
    \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430. \u0415\u0433\u043e \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u0447\u0438\u0441\u043b\u0430\u043c, \u0438 \u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u043a \u043f\u0440\u043e\u0441\u0442\u044b\u043c \u0447\u0438\u0441\u043b\u0430\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438\u043c\u0438 \u00ab\u043b\u0443\u0447\u0448\u0438\u043c\u0438 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438\u00bb,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430 \u0432\u0441\u044e \u0435\u0433\u043e
    \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0443\u044e \u0436\u0438\u0437\u043d\u044c.
    - \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435: \u0412 1930 \u0433\u043e\u0434\u0443
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0423\u0436\u0435 \u0432
    19 \u043b\u0435\u0442 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u043e
    \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043f\u043e\u0441\u0442\u0443\u043b\u0430\u0442\u0430 \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0430
    (\u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435, \u0447\u0442\u043e
    \u043c\u0435\u0436\u0434\u0443 \u043b\u044e\u0431\u044b\u043c \u0447\u0438\u0441\u043b\u043e\u043c
    \u0438 \u0435\u0433\u043e \u0443\u0434\u0432\u043e\u0435\u043d\u0438\u0435\u043c \u0432\u0441\u0435\u0433\u0434\u0430
    \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0447\u0438\u0441\u043b\u043e),
    \u0447\u0442\u043e \u0441\u0440\u0430\u0437\u0443 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e
    \u0435\u043c\u0443 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0443\u0433\u0430\u0445.
    - \u0414\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c:
    \u0412 1934 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    21 \u0433\u043e\u0434\u0430, \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.\n\n\U0001F30D
    \u00ab\u0421\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u00bb
    \u0438 \u0433\u043e\u0434\u044b \u0441\u043a\u0438\u0442\u0430\u043d\u0438\u0439 \u0418\u0437-\u0437\u0430
    \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0435\u0433\u043e \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c\u0430
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u042d\u0440\u0434\u0451\u0448 \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0412\u0435\u043d\u0433\u0440\u0438\u044e \u0438 \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u044e
    \u0436\u0438\u0437\u043d\u044c, \u043f\u043e\u043b\u043d\u0443\u044e \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0439.
    - \u041d\u0430\u0447\u0430\u043b\u043e \u043f\u0443\u0442\u0438: \u0412 1934 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u041c\u0430\u043d\u0447\u0435\u0441\u0442\u0435\u0440\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 (\u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u044f)
    \u043f\u043e \u043f\u043e\u0441\u0442\u0434\u043e\u043a\u0442\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438, \u0430 \u0432 1938 \u0433\u043e\u0434\u0443
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410, \u0433\u0434\u0435
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 \u0438 \u041f\u0435\u043d\u0441\u0438\u043b\u044c\u0432\u0430\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. - \u0420\u0430\u0437\u0440\u044b\u0432
    \u0441 \u0410\u043c\u0435\u0440\u0438\u043a\u043e\u0439: \u0412 \u0440\u0430\u0437\u0433\u0430\u0440
    \u043c\u0430\u043a\u043a\u0430\u0440\u0442\u0438\u0437\u043c\u0430 \u042d\u0440\u0434\u0451\u0448,
    \u0438\u0437-\u0437\u0430 \u0441\u0432\u043e\u0435\u0439 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438
    \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e \u0432 \u0412\u0435\u043d\u0433\u0440\u0438\u0438
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0432 \u0441\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0442\u0440\u0430\u043d\u0430\u0445, \u0431\u044b\u043b \u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d
    \u00ab\u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\u0431\u043b\u0430\u0433\u043e\u043d\u0430\u0434\u0435\u0436\u043d\u044b\u043c\u00bb.
    \u0412 1954 \u0433\u043e\u0434\u0443 \u043f\u043e\u0441\u043b\u0435 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 \u0410\u043c\u0441\u0442\u0435\u0440\u0434\u0430\u043c\u0435 \u0435\u043c\u0443 \u0431\u044b\u043b
    \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d \u0432\u044a\u0435\u0437\u0434 \u0432 \u0421\u0428\u0410.
    \u042d\u0440\u0434\u0451\u0448, \u0441\u0442\u0430\u0432\u044f\u0449\u0438\u0439 \u0441\u0432\u043e\u0431\u043e\u0434\u0443
    \u043f\u0440\u0435\u0432\u044b\u0448\u0435 \u0432\u0441\u0435\u0433\u043e, \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0441\u0442\u0440\u0430\u043d\u0443 \u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435
    \u0434\u0435\u0441\u044f\u0442\u044c \u043b\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u043b
    \u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u0435 (\u0432 \u0422\u0435\u0445\u043d\u0438\u043e\u043d\u0435),
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0441\u0442\u0440\u0430\u043d\u0430\u0445. \u0421 \u0442\u0435\u0445 \u043f\u043e\u0440
    \u043e\u043d \u0432\u0435\u043b \u043a\u043e\u0447\u0435\u0432\u043e\u0439 \u043e\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043d\u0438. \u0423 \u043d\u0435\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e
    \u043d\u0438 \u0434\u043e\u043c\u0430, \u043d\u0438 \u0441\u0435\u043c\u044c\u0438, \u043d\u0438
    \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b.
    \u041e\u043d \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441 \u043e\u0434\u043d\u0438\u043c \u043f\u043e\u043b\u0443\u043f\u0443\u0441\u0442\u044b\u043c
    \u0447\u0435\u043c\u043e\u0434\u0430\u043d\u043e\u043c, \u043f\u043e\u044f\u0432\u043b\u044f\u044f\u0441\u044c
    \u043d\u0430 \u043f\u043e\u0440\u043e\u0433\u0435 \u043a\u043e\u043b\u043b\u0435\u0433 \u0441\u043e
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438: \u00ab\u041c\u043e\u0439 \u043c\u043e\u0437\u0433
    \u043e\u0442\u043a\u0440\u044b\u0442\u00bb. \u041e\u043d \u043c\u043e\u0433 \u043e\u0441\u0442\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0447\u0430\u0441\u043e\u0432
    \u0438\u043b\u0438 \u043d\u0435\u0434\u0435\u043b\u044c, \u0447\u0442\u043e\u0431\u044b
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u0441\u0442\u0430\u0442\u044c\u044e, \u0430 \u0437\u0430\u0442\u0435\u043c \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f
    \u0434\u0430\u043b\u044c\u0448\u0435. \u0415\u0433\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0431\u044b\u043b\u043e \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.\n\n\u270d\ufe0f \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0438 \u0444\u0435\u043d\u043e\u043c\u0435\u043d
    \u00ab\u0427\u0438\u0441\u043b\u0430 \u042d\u0440\u0434\u0451\u0448\u0430\u00bb \u042d\u0440\u0434\u0451\u0448
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0430 \u043a\u0430\u0442\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u0435\u043d.
    - \u041f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c:
    \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u0438\u043b\u0438 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c \u043e\u043a\u043e\u043b\u043e
    1500 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442 \u2014 \u044d\u0442\u043e
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u044b\u0441\u043e\u043a\u0438\u0445
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0443\u0441\u0442\u0443\u043f\u0430\u044e\u0449\u0438\u0439
    \u043b\u0438\u0448\u044c \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0443 \u042d\u0439\u043b\u0435\u0440\u0443.
    - \u041e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:
    \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0435,
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0430\u0444\u043e\u0432, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0435, \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445.
    - \u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e:
    \u0423 \u042d\u0440\u0434\u0451\u0448\u0430 \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u0435\u0435
    500 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u0432. \u0412 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0440\u0435\u0434\u0435, \u0433\u0434\u0435 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0431\u044b\u043b\u0438 \u0440\u0435\u0434\u043a\u043e\u0441\u0442\u044c\u044e, \u044d\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c
    \u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c. - \u0427\u0438\u0441\u043b\u043e \u042d\u0440\u0434\u0451\u0448\u0430
    (Erd\u0151s number): \u0415\u0433\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e
    \u0448\u0443\u0442\u043e\u0447\u043d\u044b\u0439 \u043d\u0430\u0443\u043a\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c. \u00ab\u0427\u0438\u0441\u043b\u043e
    \u042d\u0440\u0434\u0451\u0448\u0430\u00bb \u2014 \u044d\u0442\u043e \u0434\u043b\u0438\u043d\u0430
    \u043a\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0435\u0433\u043e \u043f\u0443\u0442\u0438
    \u043e\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0434\u043e \u0441\u0430\u043c\u043e\u0433\u043e
    \u041f\u0430\u043b\u0430 \u042d\u0440\u0434\u0451\u0448\u0430 \u043f\u043e \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u043c
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f\u043c. \u0423 \u0435\u0433\u043e
    \u043f\u0440\u044f\u043c\u044b\u0445 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u0432
    \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0432\u043d\u043e 1, \u0443 \u0438\u0445 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u0432
    \u2014 2 \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0441\u0435\u0442\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432.\n\n\U0001F4D6
    \u00ab\u0412\u0435\u043b\u0438\u043a\u0438\u0439 \u0444\u0430\u0448\u0438\u0441\u0442\u00bb,
    \u00ab\u041a\u043d\u0438\u0433\u0430\u00bb \u0438 \u043f\u0440\u0438\u0447\u0443\u0434\u044b
    \u0433\u0435\u043d\u0438\u044f \u041b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u042d\u0440\u0434\u0451\u0448\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f,
    \u0447\u0435\u043c \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.
    \u041e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u043d\u0430 \u0441\u0432\u043e\u0435\u043c
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c \u044f\u0437\u044b\u043a\u0435
    \u0438 \u0436\u0438\u043b \u043f\u043e \u0441\u0432\u043e\u0438\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c.
    - \u00ab\u041a\u043d\u0438\u0433\u0430\u00bb (The Book): \u042d\u0440\u0434\u0451\u0448
    \u0448\u0443\u0442\u043b\u0438\u0432\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u043e
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438 \u043d\u0435\u043a\u043e\u0439
    \u0442\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u043e\u0439 \u00ab\u041a\u043d\u0438\u0433\u0438\u00bb,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0411\u043e\u0433 \u0445\u0440\u0430\u043d\u0438\u0442
    \u0441\u0430\u043c\u044b\u0435 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u0438 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0432\u0441\u0435\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c. \u0423\u0432\u0438\u0434\u0435\u0432 \u0442\u0430\u043a\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u043e\u043d
    \u0432\u043e\u0441\u043a\u043b\u0438\u0446\u0430\u043b: \u00ab\u042d\u0442\u043e \u0438\u0437
    \u041a\u043d\u0438\u0433\u0438!\u00bb. \u0421\u0430\u043c\u043e\u0433\u043e \u0411\u043e\u0433\u0430
    \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u00ab\u0412\u0435\u0440\u0445\u043e\u0432\u043d\u044b\u043c
    \u0424\u0430\u0448\u0438\u0441\u0442\u043e\u043c\u00bb (SF) \u0438 \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d,
    \u0447\u0442\u043e \u0442\u043e\u0442 \u043f\u0440\u044f\u0447\u0435\u0442 \u043e\u0442
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u043b\u0443\u0447\u0448\u0438\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438
    \u0435\u0433\u043e \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u0438\u0439 \u043f\u0430\u0441\u043f\u043e\u0440\u0442.
    - \u0421\u0442\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u044b \u0438 \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c:
    \u042d\u0440\u0434\u0451\u0448 \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0438\u043c \u043f\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u0438\u0435\u043c
    \u043a \u043a\u0440\u0435\u043f\u043a\u043e\u043c\u0443 \u043a\u043e\u0444\u0435 \u0438
    \u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d\u0430\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0438 \u0435\u043c\u0443 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043f\u043e 20 \u0447\u0430\u0441\u043e\u0432 \u0432 \u0441\u0443\u0442\u043a\u0438. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u0435\u0433\u043e \u0434\u0440\u0443\u0433 \u043f\u043e\u0441\u043f\u043e\u0440\u0438\u043b
    \u043d\u0430 500 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432, \u0447\u0442\u043e \u043e\u043d
    \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442 \u043c\u0435\u0441\u044f\u0446 \u043e\u0431\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f
    \u0431\u0435\u0437 \u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d\u0430. \u042d\u0440\u0434\u0451\u0448
    \u0432\u044b\u0438\u0433\u0440\u0430\u043b \u0441\u043f\u043e\u0440, \u043d\u043e \u0441
    \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u0435\u043c \u0437\u0430\u043c\u0435\u0442\u0438\u043b:
    \u00ab\u0414\u043e \u044d\u0442\u043e\u0433\u043e \u044f \u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u043d\u0430 \u0447\u0438\u0441\u0442\u044b\u0439 \u043b\u0438\u0441\u0442 \u0431\u0443\u043c\u0430\u0433\u0438
    \u0438 \u0432\u0438\u0434\u0435\u043b \u0442\u0435\u043e\u0440\u0435\u043c\u044b. \u0422\u0435\u043f\u0435\u0440\u044c
    \u044f \u0432\u0438\u0436\u0443 \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0438\u0441\u0442\u044b\u0439
    \u043b\u0438\u0441\u0442 \u0431\u0443\u043c\u0430\u0433\u0438\u00bb. - \u041e\u0441\u043e\u0431\u044b\u0439
    \u0441\u043b\u0435\u043d\u0433: \u0423 \u043d\u0435\u0433\u043e \u0431\u044b\u043b \u0441\u0432\u043e\u0439
    \u0441\u043b\u043e\u0432\u0430\u0440\u044c: \u0434\u0435\u0442\u0435\u0439 \u043e\u043d
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u00ab\u044d\u043f\u0441\u0438\u043b\u043e\u043d\u0430\u043c\u0438\u00bb,
    \u0436\u0435\u043d\u0449\u0438\u043d \u2014 \u00ab\u0431\u043e\u0441\u0441\u0430\u043c\u0438\u00bb,
    \u043c\u0443\u0436\u0447\u0438\u043d \u2014 \u00ab\u0440\u0430\u0431\u0430\u043c\u0438\u00bb,
    \u043c\u0443\u0437\u044b\u043a\u0443 \u2014 \u00ab\u0448\u0443\u043c\u043e\u043c\u00bb,
    \u0430 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c \u2014 \u00ab\u044f\u0434\u043e\u043c\u00bb.
    - \u0424\u0438\u043b\u0430\u043d\u0442\u0440\u043e\u043f\u0438\u044f: \u041f\u043e\u043b\u0443\u0447\u0438\u0432
    \u043f\u0440\u0435\u043c\u0438\u044e \u0412\u043e\u043b\u044c\u0444\u0430 \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u0435
    50 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0432 1984 \u0433\u043e\u0434\u0443,
    \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u0435\u0431\u0435 \u043b\u0438\u0448\u044c
    720 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432, \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043b \u043d\u0430 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e
    \u043f\u0430\u043c\u044f\u0442\u0438 \u0441\u0432\u043e\u0438\u0445 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439
    \u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u0435.\n\n\U0001F54A\ufe0f \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0443\u0445\u043e\u0434 \u0414\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445
    \u0434\u043d\u0435\u0439 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u042d\u0440\u0434\u0451\u0448
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u041e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 20 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1996 \u0433\u043e\u0434\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438
    \u0432 \u0412\u0430\u0440\u0448\u0430\u0432\u0435. \u0412 \u043a\u0430\u0440\u043c\u0430\u043d\u0435
    \u0435\u0433\u043e \u043f\u0438\u0434\u0436\u0430\u043a\u0430 \u043d\u0430\u0448\u043b\u0438
    \u0431\u0438\u043b\u0435\u0442 \u043d\u0430 \u0441\u0430\u043c\u043e\u043b\u0435\u0442 \u0434\u043e
    \u0412\u0438\u043b\u044c\u043d\u044e\u0441\u0430, \u0433\u0434\u0435 \u0434\u043e\u043b\u0436\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u044c\u0441\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f
    \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f. \u041e\u043d \u0431\u044b\u043b
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430 \u0415\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u043c
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435 \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435.
    \u0416\u0438\u0437\u043d\u044c \u041f\u0430\u043b\u0430 \u042d\u0440\u0434\u0451\u0448\u0430
    \u2014 \u044d\u0442\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0439 \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438
    \u043d\u0430\u0443\u043a\u0435, \u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a \u043e\u0434\u0438\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043c\u043e\u0436\u0435\u0442
    \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u043d\u043e \u0438 \u0441\u0430\u043c
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0443, \u0441\u0434\u0435\u043b\u0430\u0432
    \u0435\u0433\u043e \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c."
  shortBioEn: "Pal Erdös is not just a name in the history of mathematics, but an era and a unique phenomenon, one of the most fruitful mathematicians of the 20th century, a traveling genius whose eccentric way of life and working style have become legendary.\n\nHis early years and the formation of the genius Pal Erdös were born on 26 March 1913 in Budapest, in a educated Jewish family of math teachers, and his life from the beginning was a tragedy: his two older sisters died of Scarlatine on his birthday. Fearing for his son's life, his mother kept him at home until the age of 10, and it was her and her father (who spent six years in Siberian captivity during World War I) who became his first teachers.Erdös showed phenomenal abilities early in his three years, he multiplied three-digit numbers in his mind and discovered negative numbers in four years. His love for numbers, and especially for the simple numbers he called his \"best friends,\" determined his entire life.At the age of 19, he created a sensational simple proof of Bertrand's postulate (confirmation that there is always a simple number between any number and its doubling), which immediately brought him to his attention in mathematical circles.\n\n==History====Early years=============Career===============Career===========\"Starting Mathematics\"===============\"Starting Mathematics\"===========\"Starting Mathematics\"=====================================================================================================================================================- The gap with America: In the midst of the Macartism of Erdös, in correspondence with his mother in Hungary and colleagues in socialist countries, he was declared \"politically unreliable.\" In 1954, following the International Congress of Mathematicians in Amsterdam, he was banned from entering the United States.He had no home, no family, no permanent work, and he traveled with one half-empty suitcase on the doorstep of his colleagues, saying, \"My brain is open.\" He could stay for a few hours or weeks to write together and then go on, and his existence was completely subordinated to mathematics.\n\nThe mathematical legacy and the phenomenon of the Erdös Chisla is not just a mathematician, but a catalyst for the mathematical community. His contribution to science is indeed co-sustained.- Research areas: He worked in combinatory, number theory, graph theory, mathematical analysis, probability theory, and other fields. - Collaboration: Erdosch had over 500 authors. In a mathematical environment where joint work was rare for a long time, this became a unique phenomenon. - The number of Erdøs number: Its huge number of sponsors produced a funky science metric.The number of Erdös is the shortest path from mathematics to Pala Erdös in joint publications. Its direct co-authors have one, their co-authors have two, and so on. This has become a symbol of an incredible network of scientific contacts.\n\n♪ The Great Fascist, the Book, and the genius Idea Erdös was no less outstanding than his mathematician. He spoke his own unique language and lived by his rules. ♪ The Book\" (The Book): Erdöschus joked about the existence of a transfinite Book where God keeps the most beautiful and elegant evidence of all theorem. ♪ He saw this evidence, he said, \"This is from the Book!\"He called himself the Supreme Fascist (SF) and was convinced that he was hiding the best evidence from mathematicians and his Hungarian passport.Erdös won the argument, but regretted to say, \"I've looked at a clean piece of paper and I've seen theorems. Now I see just a clean piece of paper.\" Special slang: he had his own dictionary: he called children \"epsilons\", women \"boss\", men \"bums\", music \"noise\", and alcohol \"dude\".- Philanthropia: After receiving the $50,000 Wolf Award in 1984, he only kept $720 and the rest was donated to his parents in Israel.\n\n==Death==Erdös continued to travel and pursue mathematics until the last days of his life. He died of a heart attack on 20 September 1996 during a conference in Warsaw, where his jacket was found in the pocket of a plane ticket to Vilnius, where the next conference was to be held.The life of Pala Erdös is a unique example of absolute commitment to science, an example of how one person can change not only mathematics, but also the very approach to mathematical creativity, making it socially and incredibly productive."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041f\u0430\u043b\u0430 \u042d\u0440\u0434\u0451\u0448\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0439,
    \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u0441\u0430\u043c\u044b\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u0435
    \u0431\u044b\u0442\u043e\u0432\u044b\u0435 \u043c\u043e\u043c\u0435\u043d\u0442\u044b \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u044b \u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u044b.
    \u0417\u0430 \u0435\u0433\u043e \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0441\u0442\u043e\u044f\u043b\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f,
    \u0434\u0435\u043b\u0430\u044e\u0449\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0443\u043a\u043e\u0439,
    \u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0436\u0438\u0437\u043d\u0438. \u0412\u043e\u0442
    \u0441\u0430\u043c\u044b\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u043e \u00ab\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb.\n\n\U0001F5E3\ufe0f
    \u042d\u0440\u0434\u0451\u0448\u0435\u0432\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a:
    \u0442\u0430\u0439\u043d\u044b\u0439 \u043a\u043e\u0434 \u0433\u0435\u043d\u0438\u044f \u042d\u0440\u0434\u0451\u0448
    \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u043d\u0430 \u0441\u0432\u043e\u0435\u043c \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0448\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043b
    \u043a\u043e\u043b\u043b\u0435\u0433 \u0438 \u0434\u0435\u043b\u0430\u043b \u0435\u0433\u043e
    \u0440\u0435\u0447\u044c \u043f\u043e\u0445\u043e\u0436\u0435\u0439 \u043d\u0430 \u0448\u0438\u0444\u0440:
    \u00ab\u0412\u0435\u0440\u0445\u043e\u0432\u043d\u044b\u0439 \u0424\u0430\u0448\u0438\u0441\u0442\u00bb
    (The Supreme Fascist, SF): \u0422\u0430\u043a \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0411\u043e\u0433\u0430. \u042d\u0440\u0434\u0451\u0448 \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d,
    \u0447\u0442\u043e \u0411\u043e\u0433 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e
    \u043f\u0440\u044f\u0447\u0435\u0442 \u043e\u0442 \u043b\u044e\u0434\u0435\u0439 \u0441\u0430\u043c\u044b\u0435
    \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438,
    \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0436\u0435, \u0435\u0433\u043e \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u0438\u0439
    \u043f\u0430\u0441\u043f\u043e\u0440\u0442 \u0432 \u0441\u0430\u043c\u044b\u0439 \u043d\u0435\u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442. \u00ab\u041a\u043d\u0438\u0433\u0430\u00bb (The Book):
    \u042d\u0442\u043e \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044b\u0439 \u0441\u0431\u043e\u0440\u043d\u0438\u043a
    \u0441\u0430\u043c\u044b\u0445 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0445
    \u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f
    \u0443 \u00ab\u0412\u0435\u0440\u0445\u043e\u0432\u043d\u043e\u0433\u043e \u0424\u0430\u0448\u0438\u0441\u0442\u0430\u00bb.
    \u0423\u0432\u0438\u0434\u0435\u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u042d\u0440\u0434\u0451\u0448 \u0432\u043e\u0441\u043a\u043b\u0438\u0446\u0430\u043b:
    \u00ab\u042d\u0442\u043e \u0438\u0437 \u041a\u043d\u0438\u0433\u0438!\u00bb \u00ab\u042d\u043f\u0441\u0438\u043b\u043e\u043d\u044b\u00bb:
    \u0422\u0430\u043a \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0434\u0435\u0442\u0435\u0439.
    \u0412 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u044d\u043f\u0441\u0438\u043b\u043e\u043d
    (`\u03b5`) \u2014 \u044d\u0442\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u043c\u0430\u043b\u0430\u044f \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430, \u0438
    \u042d\u0440\u0434\u0451\u0448 \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e
    \u0434\u0435\u0442\u0438 \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e
    \u0441\u043e \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c\u0438 \u2014 \u0442\u0430\u043a\u0438\u0435
    \u0436\u0435 \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u0435. \u00ab\u0411\u043e\u0441\u0441\u044b\u00bb:
    \u0416\u0435\u043d\u0449\u0438\u043d\u044b. \u00ab\u0420\u0430\u0431\u044b\u00bb: \u041c\u0443\u0436\u0447\u0438\u043d\u044b.
    \u00ab\u0428\u0443\u043c\u00bb: \u041c\u0443\u0437\u044b\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043c\u0435\u0448\u0430\u043b\u0430 \u0435\u043c\u0443 \u0434\u0443\u043c\u0430\u0442\u044c.
    \u00ab\u042f\u0434\u00bb: \u0410\u043b\u043a\u043e\u0433\u043e\u043b\u044c. \u00ab\u0421\u044d\u043c\u00bb
    \u0438 \u00ab\u0414\u0436\u043e\u00bb: \u0422\u0430\u043a \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0421\u0428\u0410 \u0438 \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0439 \u0421\u043e\u044e\u0437,
    \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0441 \u0432\u043b\u0430\u0441\u0442\u044f\u043c\u0438
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b. \u041a\u043e\u0433\u0434\u0430 \u042d\u0440\u0434\u0451\u0448
    \u043f\u0440\u0438\u0435\u0437\u0436\u0430\u043b \u043a \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c,
    \u043e\u043d \u043c\u043e\u0433 \u0437\u0430\u044f\u0432\u0438\u0442\u044c \u0445\u043e\u0437\u044f\u0439\u043a\u0435
    \u0434\u043e\u043c\u0430: \u00ab\u0411\u043e\u0441\u0441, \u043c\u044b \u0433\u043e\u043b\u043e\u0434\u043d\u044b.
    \u041a\u043e\u0433\u0434\u0430 \u0440\u0430\u0431\u044b \u0431\u0443\u0434\u0443\u0442 \u0435\u0441\u0442\u044c?\u00bb
    \u0447\u0442\u043e \u043e\u0431\u044b\u0447\u043d\u043e \u0432\u0432\u043e\u0434\u0438\u043b\u043e
    \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0445 \u0432 \u0441\u0442\u0443\u043f\u043e\u0440.\n\n\u2615
    \u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0440\u0438\u0442\u0443\u0430\u043b: \u00ab\u041c\u0430\u0448\u0438\u043d\u0430
    \u0434\u043b\u044f \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043a\u043e\u0444\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0435\u043c\u044b\u00bb \u042d\u0440\u0434\u0451\u0448 \u0431\u044b\u043b
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c \u0442\u0440\u0443\u0434\u043e\u0433\u043e\u043b\u0438\u043a\u043e\u043c.
    \u041e\u043d \u043c\u043e\u0433 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043f\u043e
    18-20 \u0447\u0430\u0441\u043e\u0432 \u0432 \u0441\u0443\u0442\u043a\u0438, \u0438 \u0435\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043e\u0440\u0443\u0436\u0438\u0435\u043c \u0432
    \u044d\u0442\u043e\u043c \u0431\u044b\u043b\u0438 \u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d\u044b
    \u0438 \u043a\u043e\u0444\u0435 (\u0434\u043e 10 \u0447\u0430\u0448\u0435\u043a \u0432 \u0434\u0435\u043d\u044c).
    \u041e\u043d \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u043b \u044d\u0442\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e,
    \u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u00ab\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c\u044e\u00bb.
    \u0421\u0430\u043c\u044b\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u0432 1979 \u0433\u043e\u0434\u0443. \u0415\u0433\u043e \u0434\u0440\u0443\u0433, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0420\u043e\u043d \u0413\u0440\u044d\u043c, \u043f\u043e\u0441\u043f\u043e\u0440\u0438\u043b
    \u0441 \u043d\u0438\u043c \u043d\u0430 500 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432,
    \u0447\u0442\u043e \u042d\u0440\u0434\u0451\u0448 \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442
    \u043f\u0440\u043e\u0436\u0438\u0442\u044c \u043c\u0435\u0441\u044f\u0446 \u0431\u0435\u0437
    \u0430\u043c\u0444\u0435\u0442\u0430\u043c\u0438\u043d\u0430. \u042d\u0440\u0434\u0451\u0448
    \u043f\u0440\u0438\u043d\u044f\u043b \u0432\u044b\u0437\u043e\u0432 \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b 30 \u0434\u043d\u0435\u0439. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0434\u0435\u043d\u044c\u0433\u0438, \u043e\u043d
    \u0441 \u0433\u0440\u0443\u0441\u0442\u044c\u044e \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u0422\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u044f
    \u043d\u0435 \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d. \u041d\u043e \u0437\u0430
    \u044d\u0442\u043e\u0442 \u043c\u0435\u0441\u044f\u0446 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043e\u0442\u0431\u0440\u043e\u0441\u0438\u043b\u043e \u043d\u0430\u0437\u0430\u0434. \u042f
    \u0441\u0430\u0434\u0438\u043b\u0441\u044f \u0437\u0430 \u0441\u0442\u043e\u043b, \u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u043d\u0430 \u043f\u0443\u0441\u0442\u0443\u044e \u0431\u0443\u043c\u0430\u0433\u0443 \u0438
    \u043d\u0435 \u0432\u0438\u0434\u0435\u043b \u0442\u0435\u043e\u0440\u0435\u043c \u2014
    \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0443\u0441\u0442\u043e\u0439 \u043b\u0438\u0441\u0442\u00bb.
    \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e
    \u043e\u043d \u043f\u0440\u0438\u043d\u044f\u043b \u0434\u043e\u0437\u0443 \u0438 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u043a \u0440\u0430\u0431\u043e\u0442\u0435. \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0444\u0440\u0430\u0437\u0430: \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u2014 \u044d\u0442\u043e \u043c\u0430\u0448\u0438\u043d\u0430 \u0434\u043b\u044f \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u043a\u043e\u0444\u0435 \u0432 \u0442\u0435\u043e\u0440\u0435\u043c\u044b\u00bb \u0441\u0442\u0430\u043b\u0430
    \u0434\u0435\u0432\u0438\u0437\u043e\u043c \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.
    \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e
    \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u043f\u0440\u0438\u0445\u043e\u0442\u043b\u0438\u0432,
    \u0447\u0442\u043e \u0435\u043b \u0432\u0441\u0451, \u0447\u0442\u043e \u0434\u0430\u044e\u0442,
    \u0438 \u0441\u043f\u0430\u043b \u043d\u0430 \u043f\u043e\u043b\u0443, \u0435\u0441\u043b\u0438
    \u043d\u0435 \u0431\u044b\u043b\u043e \u043a\u0440\u043e\u0432\u0430\u0442\u0438.\n\n\U0001F4B0
    \u0429\u0435\u0434\u0440\u043e\u0441\u0442\u044c \u0441\u0443\u043c\u0430\u0441\u0448\u0435\u0434\u0448\u0435\u0433\u043e
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430 \u042d\u0440\u0434\u0451\u0448 \u043d\u0435
    \u043f\u0440\u0438\u0434\u0430\u0432\u0430\u043b \u0434\u0435\u043d\u044c\u0433\u0430\u043c
    \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f,
    \u043a\u0440\u043e\u043c\u0435 \u043a\u0430\u043a \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u043f\u043e\u043c\u043e\u0447\u044c \u0434\u0440\u0443\u0433\u0438\u043c. \u041f\u0440\u0435\u043c\u0438\u044f
    \u0412\u043e\u043b\u044c\u0444\u0430: \u0412 1984 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u0435 50
    000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432. \u042d\u0440\u0434\u0451\u0448 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0441\u0435\u0431\u0435 \u0440\u043e\u0432\u043d\u043e 720 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432
    (\u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u043c\u043c\u0430
    \u0434\u043b\u044f \u043b\u0435\u0433\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u044a\u0435\u0437\u0434\u0430
    \u0432 \u0421\u0428\u0410), \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043b \u043d\u0430 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438 \u0438\u043c\u0435\u043d\u0438 \u0441\u0432\u043e\u0438\u0445
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u0435
    \u0438 \u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u043e\u0436\u0438\u043b\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c. \u041f\u0440\u0438\u0437\u043e\u0432\u044b\u0435
    \u0437\u0430 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b: \u042d\u0440\u0434\u0451\u0448
    \u0447\u0430\u0441\u0442\u043e \u043e\u0431\u044a\u044f\u0432\u043b\u044f\u043b \u0434\u0435\u043d\u0435\u0436\u043d\u044b\u0435
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b (\u043e\u0442 $25 \u0434\u043e $10 000) \u0437\u0430
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0441\u0432\u043e\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c. \u041e\u0434\u043d\u0430\u043a\u043e \u0447\u0435\u043a\u0438
    \u043e\u043d \u0432\u044b\u043f\u0438\u0441\u044b\u0432\u0430\u043b \u043d\u0430 \u0438\u043c\u044f
    \u0442\u043e\u0433\u043e, \u043a\u0442\u043e \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443,
    \u043d\u043e \u0447\u0430\u0441\u0442\u043e, \u043d\u0435 \u043c\u0435\u043d\u044f\u044f
    \u043f\u043e\u0434\u043f\u0438\u0441\u0438, \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043b
    \u044d\u0442\u0438 \u0447\u0435\u043a\u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u043b\u044e\u0434\u044f\u043c
    \u043a\u0430\u043a \u043f\u043e\u0434\u0430\u0440\u043e\u043a. \u0418\u043d\u043e\u0433\u0434\u0430
    \u043e\u043d \u043e\u0442\u0434\u0430\u0432\u0430\u043b \u0432\u0441\u0435 \u043d\u0430\u043b\u0438\u0447\u043d\u044b\u0435,
    \u0447\u0442\u043e \u0431\u044b\u043b\u0438 \u0443 \u043d\u0435\u0433\u043e \u0432 \u043a\u0430\u0440\u043c\u0430\u043d\u0435,
    \u043f\u0435\u0440\u0432\u043e\u043c\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u043d\u043e\u043c\u0443
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0443 \u0438\u043b\u0438 \u043d\u0438\u0449\u0435\u043c\u0443.
    \u00ab\u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0431\u0435\u0437 \u0432\u0435\u0449\u0435\u0439\u00bb:
    \u0412\u0435\u0441\u044c \u0435\u0433\u043e \u0431\u0430\u0433\u0430\u0436 \u0441\u043e\u0441\u0442\u043e\u044f\u043b
    \u0438\u0437 \u0441\u0442\u0430\u0440\u043e\u0433\u043e \u043f\u043e\u043b\u0443\u043f\u0443\u0441\u0442\u043e\u0433\u043e
    \u0447\u0435\u043c\u043e\u0434\u0430\u043d\u0430. \u041e\u043d \u043d\u0435 \u0443\u043c\u0435\u043b
    \u0437\u0430\u0432\u044f\u0437\u044b\u0432\u0430\u0442\u044c \u0448\u043d\u0443\u0440\u043a\u0438,
