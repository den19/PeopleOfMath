  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0421\u0435\u0440\u0433\u0435\u044f \u041b\u044c\u0432\u043e\u0432\u0438\u0447\u0430 \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0448\u0438\u0440\u043e\u043a\u0438\u0439
    \u0441\u043f\u0435\u043a\u0442\u0440 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u0438
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    XX \u0432\u0435\u043a\u0430. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439, \u043a\u0430\u0436\u0434\u043e\u0435
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u0442\u0430\u043b\u043e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.\n\n\U0001F4DC
    \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0435\u0439 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0435. \u0421\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439:
    \u0412 1935 \u0433\u043e\u0434\u0443 \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0434\u0430\u043b
    \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439
    \u0434\u043b\u044f \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0449\u0438\u0445\u0441\u044f
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u0443\u0435\u043c\u044b\u043c\u0438
    \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435.
    \u041e\u043d \u043f\u043e\u0434\u043e\u0448\u0451\u043b \u043a \u044d\u0442\u043e\u043c\u0443
    \u043f\u043e\u043d\u044f\u0442\u0438\u044e \u0441 \u043f\u043e\u0437\u0438\u0446\u0438\u0439
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u044f
    \u043f\u043e \u0447\u0430\u0441\u0442\u044f\u043c \u0438 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u044f
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u043d\u0430 \u0433\u043b\u0430\u0434\u043a\u0438\u0435 \u043f\u0440\u043e\u0431\u043d\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u041f\u0440\u043e\u0440\u044b\u0432 \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435:
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0432\u0432\u0435\u0441\u0442\u0438
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u043e\u0433\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438. \u0420\u0430\u043d\u0435\u0435
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 (\u0441 \u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b\u043c\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0443\u0434\u0430\u0440\u043d\u044b\u043c\u0438 \u0432\u043e\u043b\u043d\u0430\u043c\u0438)
    \u0431\u044b\u043b\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u0442\u044c
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438.
    \u0420\u0430\u0431\u043e\u0442\u044b \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0434\u0430\u043b\u0438
    \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0441\u0442\u0440\u043e\u0433\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442.\n\n\U0001F4D0
    \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430
    \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u042d\u0442\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0441\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e, \u043d\u043e\u0441\u044f\u0449\u0435\u0435 \u0435\u0433\u043e
    \u0438\u043c\u044f. \u041d\u043e\u0432\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430: \u0414\u043b\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u043c\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u0432\u0432\u0451\u043b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \\( W^{m}_{p} \\), \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043a\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430. \u042d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u0447\u044c\u0438 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435
    \u0434\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0430
    \\( m \\) \u0441\u0443\u043c\u043c\u0438\u0440\u0443\u0435\u043c\u044b \u0441\u043e \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e
    \\( p \\). \u0422\u0435\u043e\u0440\u0435\u043c\u044b \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f:
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u044d\u0442\u0438\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432.
    \u042d\u0442\u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442
    \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0438 \u043c\u0435\u0436\u0434\u0443
    \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u043c\u0438 \u0438
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0442\u044c, \u0447\u0442\u043e \u043f\u0440\u0438
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0438\u0437 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0439
    \u0438\u043b\u0438 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0434\u0440\u0443\u0433\u043e\u043c\u0443,
    \"\u043b\u0443\u0447\u0448\u0435\u043c\u0443\" \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443.
    \u042d\u0442\u043e \u0438\u043c\u0435\u0435\u0442 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0433\u043b\u0430\u0434\u043a\u043e\u0441\u0442\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0446\u0435\u043b\u043e\u0439 \u044d\u043f\u043e\u0445\u0438: \u0421\u043e\u0432\u043e\u043a\u0443\u043f\u043d\u043e\u0441\u0442\u044c
    \u044d\u0442\u0438\u0445 \u0438\u0434\u0435\u0439, \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0432 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u00ab\u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435\u00bb (1950), \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438 \u043d\u0430 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f \u0432\u043f\u0435\u0440\u0451\u0434.\n\n\U0001F4BB
    \u0422\u0435\u043e\u0440\u0438\u044f \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0412 \"\u0441\u0438\u0431\u0438\u0440\u0441\u043a\u0438\u0439\"
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0432\u043e\u0435\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u043e\u0435
    \u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0432 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041d\u043e\u0432\u044b\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0451\u043d\u043d\u043e\u043c\u0443
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e: \u041e\u043d
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043e\u0431\u0449\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b \u2014 \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b
    \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043a\u0440\u0430\u0442\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432.
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434: \u0421\u0432\u043e\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043e\u043d
    \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u0432 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b\u00bb
    (1974). \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0439
    \u0438\u043c \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u0442\u043e\u0447\u043d\u044b\u0445 \u043e\u0446\u0435\u043d\u043e\u043a \u043f\u043e\u0433\u0440\u0435\u0448\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043b\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445.\n\n\U0001F9ED
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u041f\u043e\u043c\u0438\u043c\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432, \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u0432\u043d\u0451\u0441 \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0440\u044f\u0434 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445 \u0438
    \u043c\u0435\u0436\u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 \u0438 \u0441\u0435\u0439\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u044f:
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0412. \u0418. \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u044b\u043c
    \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e-\u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447 \u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0438
    \u0443\u043f\u0440\u0443\u0433\u0438\u0445 \u0432\u043e\u043b\u043d. \u042d\u0442\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u0438\u043c\u0435\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0441\u0435\u0439\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438: \u0415\u0433\u043e
    \u043f\u0435\u0440\u0443 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u0437\u0430\u0434\u0430\u0447\u0435 \u041a\u043e\u0448\u0438 \u0434\u043b\u044f
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u043c
    \u0438 \u043d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u043c \u0437\u0430\u0434\u0430\u0447\u0430\u043c,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u043b\u0438\u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c. \u041a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0430:
    \u0412 1950-\u0445 \u0433\u043e\u0434\u0430\u0445, \u043a\u043e\u0433\u0434\u0430 \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0430
    \u0432 \u0421\u0421\u0421\u0420 \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u0430\u043b\u0430\u0441\u044c
    \u043a\u0440\u0438\u0442\u0438\u043a\u0435, \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0410. \u0410. \u041b\u044f\u043f\u0443\u043d\u043e\u0432\u044b\u043c \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u044c\u0451\u0439
    \u00ab\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0447\u0435\u0440\u0442\u044b \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u044b\u0433\u0440\u0430\u043b\u0430 \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0438 \u0438
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u0438
    \u0432 \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u043c \u0421\u043e\u044e\u0437\u0435.
    \u041a\u0440\u0430\u0442\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435: | \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c | \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f | |:--- |:--- | | \u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 | \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439. | | \u0422\u0435\u043e\u0440\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    | \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f. |
    | \u0412\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    | \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b.
    | | \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 | \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e-\u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439; \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e
    \u0437\u0430\u0434\u0430\u0447\u0435 \u041a\u043e\u0448\u0438 \u0434\u043b\u044f \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. | | \u041a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0430
    | \u0423\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \"\u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438\"
    \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438 \u0432 \u0421\u0421\u0421\u0420,
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u0430\u044f
    \u0441\u0442\u0430\u0442\u044c\u044f \u0441 \u0410.\u0410. \u041b\u044f\u043f\u0443\u043d\u043e\u0432\u044b\u043c.
    |"
  achievementsEn: 
  personalLifeRu: "\u0421\u0435\u0440\u0433\u0435\u0439 \u041b\u044c\u0432\u043e\u0432\u0438\u0447 \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u2014 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0447\u044c\u044f \u043b\u0438\u0447\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430
    \u0441 \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439 \u0441\u0442\u0440\u0430\u043d\u044b.
    \u0412 \u043d\u0435\u0439 \u0435\u0441\u0442\u044c \u043c\u0435\u0441\u0442\u043e \u0438
    \u0440\u0430\u043d\u043d\u0435\u043c\u0443 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0432 \u0433\u043e\u0434\u044b \u0432\u043e\u0439\u043d\u044b, \u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u043d\u043e\u0432\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0446\u0435\u043d\u0442\u0440\u043e\u0432
    \u0432 \u0421\u0438\u0431\u0438\u0440\u0438.\n\n\U0001F468\u200d\U0001F466 \u0421\u0435\u043c\u044c\u044f
    \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0420\u043e\u0434\u0438\u043b\u0441\u044f
    \u0421\u0435\u0440\u0433\u0435\u0439 \u041b\u044c\u0432\u043e\u0432\u0438\u0447 6 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1908 \u0433\u043e\u0434\u0430 \u0432 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435
    \u0432 \u0438\u043d\u0442\u0435\u043b\u043b\u0438\u0433\u0435\u043d\u0442\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041b\u0435\u0432
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u0438\u0447, \u0431\u044b\u043b
    \u044e\u0440\u0438\u0441\u0442\u043e\u043c, \u043f\u0440\u0438\u0441\u044f\u0436\u043d\u044b\u043c
    \u043f\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c, \u0430 \u043c\u0430\u0442\u044c,
    \u041d\u0430\u0442\u0430\u043b\u044c\u044f \u0413\u0435\u043e\u0440\u0433\u0438\u0435\u0432\u043d\u0430,
    \u2014 \u0432\u044b\u0441\u043e\u043a\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b\u0430
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u044e,
    \u0430 \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b\u0430 \u0432\u0440\u0430\u0447\u043e\u043c.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043e\u0431\u0430
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0432 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u043c
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438. \u0421\u0435\u0440\u0433\u0435\u0439 \u0440\u0430\u043d\u043e
    \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u043e\u0442\u0446\u0430, \u0438 \u0435\u0433\u043e
    \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435\u043c \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0430\u0441\u044c
    \u043c\u0430\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u043b\u0430
    \u0432\u0441\u0435 \u0443\u0441\u0438\u043b\u0438\u044f, \u0447\u0442\u043e\u0431\u044b
    \u0440\u0430\u0437\u0432\u0438\u0442\u044c \u043d\u0435\u0437\u0430\u0443\u0440\u044f\u0434\u043d\u044b\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0441\u044b\u043d\u0430.
    \u0421 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u043e\u043d \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b
    \u0448\u0438\u0440\u043e\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c:
    \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0438 \u0444\u0438\u0437\u0438\u043a\u043e\u0439,
    \u043d\u043e \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439, \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0435\u0439,
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u043e\u0439, \u043f\u0438\u0441\u0430\u043b \u0441\u0442\u0438\u0445\u0438
    \u0438 \u0443\u0447\u0438\u043b\u0441\u044f \u0438\u0433\u0440\u0435 \u043d\u0430 \u0444\u043e\u0440\u0442\u0435\u043f\u0438\u0430\u043d\u043e.\n\n\U0001F393
    \u0413\u043e\u0434\u044b \u0443\u0447\u0435\u043d\u0438\u044f \u041f\u043e\u0441\u043b\u0435
    \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0448\u043a\u043e\u043b\u044b \u0441
    \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c \u0432 1924 \u0433\u043e\u0434\u0443, 16-\u043b\u0435\u0442\u043d\u0438\u0439
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0438\u0437-\u0437\u0430 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u044b\u0445
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439 (\u0432 \u0432\u0443\u0437\u044b
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438 \u0441 17 \u043b\u0435\u0442) \u043d\u0435
    \u0441\u043c\u043e\u0433 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u0442\u044c
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u042d\u0442\u043e\u0442
    \u0433\u043e\u0434 \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c
    \u0432 \u0445\u0443\u0434\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0441\u0442\u0443\u0434\u0438\u0438 \u043f\u043e \u043a\u043b\u0430\u0441\u0441\u0443 \u0444\u043e\u0440\u0442\u0435\u043f\u0438\u0430\u043d\u043e.
    \u0412 1925 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0417\u0434\u0435\u0441\u044c
    \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442 \u0431\u044b\u043b \u0441\u0440\u0430\u0437\u0443
    \u0437\u0430\u043c\u0435\u0447\u0435\u043d \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430\u043c\u0438
    \u041d. \u041c. \u0413\u044e\u043d\u0442\u0435\u0440\u043e\u043c \u0438 \u0412. \u0418.
    \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u044b\u043c. \u041d. \u041c. \u0413\u044e\u043d\u0442\u0435\u0440
    \u0441\u0442\u0430\u043b \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c,
    \u0430 \u0412. \u0418. \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u0430 \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438 \u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u043a\u0430\u043a \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0442\u043e\u0440\u043e\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f. \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0441\u043b\u0443\u0448\u0430\u043b
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u0442\u0430\u043a\u0438\u0445
    \u043a\u0430\u043a \u0413. \u041c. \u0424\u0438\u0445\u0442\u0435\u043d\u0433\u043e\u043b\u044c\u0446
    \u0438 \u0411. \u041d. \u0414\u0435\u043b\u043e\u043d\u0435. \u0423\u0436\u0435 \u0432 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435: \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443
    \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b \u0432 \u0440\u0430\u0441\u0447\u0435\u0442\u043d\u043e\u043c
    \u0431\u044e\u0440\u043e \u0437\u0430\u0432\u043e\u0434\u0430 \u00ab\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u0441\u0438\u043b\u0430\u00bb,
    \u0433\u0434\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435
    \u043d\u043e\u0432\u043e\u0439 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439
    \u0443 \u0432\u0430\u043b\u043e\u0432. \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u0430\u044f
    \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0441\u0442\u0430\u0442\u044c\u044f \u0431\u044b\u043b\u0430
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430 \u0432 \u00ab\u0414\u043e\u043a\u043b\u0430\u0434\u0430\u0445
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a\u00bb \u0435\u0449\u0435
    \u0434\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0412 1929 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.\n\n\U0001F9ED \u041d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u041f\u043e\u0441\u043b\u0435
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u043f\u0440\u0438\u0448\u0435\u043b \u0432 \u0421\u0435\u0439\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442. \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0412. \u0418. \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u044b\u043c \u043e\u043d
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e-\u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u0432\u043e\u043b\u043d\u043e\u0432\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0448\u0435\u043b
    \u0448\u0438\u0440\u043e\u043a\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0433\u0435\u043e\u0444\u0438\u0437\u0438\u043a\u0435. \u0421 1932 \u0433\u043e\u0434\u0430
    \u0435\u0433\u043e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u043c \u0438\u043c. \u0412. \u0410.
    \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430 (\u041c\u0418\u0410\u041d). \u0412 1934
    \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a \u0438 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b \u043e\u0442\u0434\u0435\u043b
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0412 \u044d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0431\u044b\u043b\u0438 \u0441\u0434\u0435\u043b\u0430\u043d\u044b
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f: \u0432 1935 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432\u0432\u0435\u043b \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u043f\u0440\u0438\u0448\u043b\u043e \u0440\u0430\u043d\u043e: \u0432 1933 \u0433\u043e\u0434\u0443
    (\u0432 24 \u0433\u043e\u0434\u0430) \u043e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u041d \u0421\u0421\u0421\u0420, \u0430 \u0432 1939 \u0433\u043e\u0434\u0443 (\u0432
    30 \u043b\u0435\u0442) \u2014 \u0441\u0430\u043c\u044b\u043c \u043c\u043e\u043b\u043e\u0434\u044b\u043c
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c \u0432 \u0441\u0442\u0440\u0430\u043d\u0435.
    \u0412 \u0433\u043e\u0434\u044b \u0432\u043e\u0439\u043d\u044b, \u0441 1941 \u043f\u043e
    1944 \u0433\u043e\u0434, \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0431\u044b\u043b \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u041c\u0418\u0410\u041d, \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u0435\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0432 \u041a\u0430\u0437\u0430\u043d\u044c
    \u0438 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0434\u043b\u044f \u043d\u0443\u0436\u0434 \u0444\u0440\u043e\u043d\u0442\u0430. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u043c
    \u0430\u0442\u043e\u043c\u043d\u043e\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u0435. \u0412
    1944 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u043d\u0430
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044e
    \u2116 2 (\u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u0430\u0442\u043e\u043c\u043d\u043e\u0439 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0438\u043c.
    \u0418. \u0412. \u041a\u0443\u0440\u0447\u0430\u0442\u043e\u0432\u0430) \u0432 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438
    \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044f \u0418. \u0412. \u041a\u0443\u0440\u0447\u0430\u0442\u043e\u0432\u0430
    \u0438 \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u044f \u0423\u0447\u0435\u043d\u043e\u0433\u043e
    \u0441\u043e\u0432\u0435\u0442\u0430. \u041e\u043d \u043e\u0442\u0432\u0435\u0447\u0430\u043b
    \u0437\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0440\u0430\u0441\u0447\u0435\u0442\u044b \u043f\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044e
    \u0438\u0437\u043e\u0442\u043e\u043f\u043e\u0432 \u0443\u0440\u0430\u043d\u0430 (\u0432
    \u0433\u0440\u0443\u043f\u043f\u0430\u0445 \u0418.\u041a. \u041a\u0438\u043a\u043e\u0438\u043d\u0430)
    \u0438 \u043f\u043b\u0443\u0442\u043e\u043d\u0438\u044f, \u0440\u0430\u0441\u0447\u0435\u0442\u044b
    \u043a\u0430\u0441\u043a\u0430\u0434\u043e\u0432 \u0434\u0438\u0444\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u044b\u0445
    \u043c\u0430\u0448\u0438\u043d \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043b\u0438\u0448\u044c \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043b\u0438\u043d\u0435\u0439\u043a\u0438 \u0438 \u043c\u0430\u043b\u043e\u043c\u043e\u0449\u043d\u044b\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043c\u0430\u0448\u0438\u043d\u044b.\n\n\U0001F9D1\u200d\U0001F3EB
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0431\u044b\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u043c
    \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u0432\u043e\u043a\u0440\u0443\u0433
    \u0441\u0435\u0431\u044f \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0441\u0440\u0435\u0434\u0443.
    \u041e\u043d \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044c
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u043d\u0430\u0443\u043a\u0438. \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0448\u043a\u043e\u043b\u0430:
    \u041e\u043d \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043b \u0446\u0435\u043b\u0443\u044e
    \u043f\u043b\u0435\u044f\u0434\u0443 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 \u0438
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0432\u0443\u0437\u0430\u0445 \u0441\u0442\u0440\u0430\u043d\u044b.
    \u0415\u0433\u043e \u043e\u0431\u0430\u044f\u043d\u0438\u0435, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    \u043a \u043c\u043e\u043b\u043e\u0434\u0435\u0436\u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438.
    \u0421\u043e\u0440\u0430\u0442\u043d\u0438\u043a\u0438 \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438:
    \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0442\u0435\u0441\u043d\u043e\u043c
    \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0435 \u0441 \u0418. \u0412. \u041a\u0443\u0440\u0447\u0430\u0442\u043e\u0432\u044b\u043c
    \u0438 \u0418. \u041a. \u041a\u0438\u043a\u043e\u0438\u043d\u044b\u043c \u043d\u0430\u0434
    \u0430\u0442\u043e\u043c\u043d\u044b\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u043c.
    \u041f\u043e\u0437\u0436\u0435, \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u041c. \u0410.
    \u041b\u0430\u0432\u0440\u0435\u043d\u0442\u044c\u0435\u0432\u044b\u043c \u0438 \u0421.
    \u0410. \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u0432\u0438\u0447\u0435\u043c,
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u043e\u0440\u043e\u0432
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0421\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0410\u041d \u0421\u0421\u0421\u0420.
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u043b\u0435\u0433:
    \u0412\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0416\u0430\u043d \u041b\u0435\u0440\u044d,
    \u0447\u044c\u0438 \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e\u0441\u0435\u0449\u0430\u043b
    \u041b\u043e\u0440\u0430\u043d \u0428\u0432\u0430\u0440\u0446, \u043e\u0441\u043e\u0431\u043e
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u043b \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430, \u043d\u0430\u0437\u044b\u0432\u0430\u044f
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u00ab\u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0451\u043d\u043d\u044b\u043c\u0438 \u043c\u043e\u0438\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u044b\u043c\u00bb.
    \u0421\u0430\u043c \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0432\u044b\u0441\u043e\u043a\u043e
    \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u043b \u0432\u043a\u043b\u0430\u0434 \u0428\u0432\u0430\u0440\u0446\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437\u0432\u0438\u043b \u0435\u0433\u043e
    \u0442\u0435\u043e\u0440\u0438\u044e.\n\n\U0001F3D7\ufe0f \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0421\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0412 1957 \u0433\u043e\u0434\u0443
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a, \u0447\u0442\u043e\u0431\u044b
    \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u0442\u044c \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0439
    \u0438\u043c \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0421\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u0410\u041d \u0421\u0421\u0421\u0420. \u041e\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b
    \u0438\u043c \u0434\u043e 1983 \u0433\u043e\u0434\u0430. \u0412 \u0441\u0438\u0431\u0438\u0440\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u043e\u0435
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u2014 \u0442\u0435\u043e\u0440\u0438\u044e
    \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b
    \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f.
    \u0412 1983 \u0433\u043e\u0434\u0443 \u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u041c\u043e\u0441\u043a\u0432\u0443, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0432
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u041c\u0418\u0410\u041d.\n\n\U0001F54A\ufe0f
    \u0421\u043c\u0435\u0440\u0442\u044c \u0421\u0435\u0440\u0433\u0435\u0439 \u041b\u044c\u0432\u043e\u0432\u0438\u0447
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    3 \u044f\u043d\u0432\u0430\u0440\u044f 1989 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435
    \u043d\u0430 81-\u043c \u0433\u043e\u0434\u0443 \u0436\u0438\u0437\u043d\u0438."
  personalLifeEn: 
  shortBioRu: "\u0421\u0435\u0440\u0433\u0435\u0439 \u041b\u044c\u0432\u043e\u0432\u0438\u0447 \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    (6 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1908 \u2014 3 \u044f\u043d\u0432\u0430\u0440\u044f
    1989) \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u0438 \u043c\u0435\u0442\u043e\u0434\u044b
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438 \u043b\u0438\u0446\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0443\u0447\u0435\u043d\u043e\u0433\u043e,
    \u0447\u044c\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0430\u043b\u0438\u0441\u044c
    \u0441 \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447, \u043e\u0442 \u0441\u0435\u0439\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0438
    \u0434\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u044f\u0434\u0435\u0440\u043d\u043e\u0433\u043e
    \u043e\u0440\u0443\u0436\u0438\u044f \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u0438.\n\n\U0001F9EC
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e, \u044e\u043d\u043e\u0441\u0442\u044c \u0438
    \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0421\u0435\u0440\u0433\u0435\u0439
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432
    \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435
    \u0432 \u0438\u043d\u0442\u0435\u043b\u043b\u0438\u0433\u0435\u043d\u0442\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041b\u0435\u0432
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u0438\u0447, \u0431\u044b\u043b
    \u043f\u0440\u0438\u0441\u044f\u0436\u043d\u044b\u043c \u043f\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c,
    \u0430 \u043c\u0430\u0442\u044c, \u041d\u0430\u0442\u0430\u043b\u044c\u044f \u0413\u0435\u043e\u0440\u0433\u0438\u0435\u0432\u043d\u0430,
    \u2014 \u0432\u044b\u0441\u043e\u043a\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0432\u0448\u0430\u044f
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u044e,
    \u0430 \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u0432\u0448\u0430\u044f \u0432\u0440\u0430\u0447\u043e\u043c.
    \u0420\u0430\u043d\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u0432 \u043e\u0442\u0446\u0430,
    \u0421\u0435\u0440\u0433\u0435\u0439 \u0432\u043e\u0441\u043f\u0438\u0442\u044b\u0432\u0430\u043b\u0441\u044f
    \u043c\u0430\u0442\u0435\u0440\u044c\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u043b\u0430
    \u0432\u0441\u0435 \u0441\u0438\u043b\u044b \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f
    \u0435\u0433\u043e \u043d\u0435\u0437\u0430\u0443\u0440\u044f\u0434\u043d\u044b\u0445 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0412 \u0433\u043e\u0434\u044b \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b (1918\u20131923) \u043e\u043d \u0436\u0438\u043b \u0432 \u0425\u0430\u0440\u044c\u043a\u043e\u0432\u0435,
    \u0433\u0434\u0435 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0441\u0432\u043e\u0438\u043b \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443
    \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0448\u043a\u043e\u043b\u044b, \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044f
    \u043e\u0441\u043e\u0431\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412 1923 \u0433\u043e\u0434\u0443, \u0432\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432 \u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434, \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439
    \u043a\u043b\u0430\u0441\u0441 190-\u0439 \u0448\u043a\u043e\u043b\u044b, \u0441\u043b\u0430\u0432\u0438\u0432\u0448\u0435\u0439\u0441\u044f
    \u0441\u0432\u043e\u0438\u043c\u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u044f\u043c\u0438.
    \u0423\u0436\u0435 \u0442\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442
    \u0431\u044b\u043b \u0437\u0430\u043c\u0435\u0447\u0435\u043d: \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043d\u0430\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043b\u0430 \u0435\u043c\u0443
    \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0442\u044c \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442. \u0412 1924 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0448\u043a\u043e\u043b\u0443 \u0441
    \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c, \u043d\u043e \u0438\u0437-\u0437\u0430
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u044b\u0445 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439
    \u043d\u0435 \u0441\u043c\u043e\u0433 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u0442\u044c
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0413\u043e\u0434
    \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b, \u0437\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c
    \u0432 \u0445\u0443\u0434\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0441\u0442\u0443\u0434\u0438\u0438 \u043f\u043e \u043a\u043b\u0430\u0441\u0441\u0443 \u0444\u043e\u0440\u0442\u0435\u043f\u0438\u0430\u043d\u043e.
    \u0412 1925 \u0433\u043e\u0434\u0443 \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0441\u0442\u0430\u043b
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0422\u0430\u043c
    \u043e\u043d \u043f\u043e\u043f\u0430\u043b \u043f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u044f
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u041d.\u041c. \u0413\u044e\u043d\u0442\u0435\u0440\u0430 (\u0441\u0432\u043e\u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f)
    \u0438 \u0412.\u0418. \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0432\u043e\u0438\u043c
    \u0432\u0442\u043e\u0440\u044b\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c. \u0415\u0433\u043e
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0440\u0430\u043d\u043e: \u0435\u0449\u0435
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c\u044e \u0432 \u00ab\u0414\u043e\u043a\u043b\u0430\u0434\u0430\u0445
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a\u00bb.\n\n\U0001F52C
    \u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0434\u0435\u0431\u044e\u0442 \u0438 \u043c\u0438\u0440\u043e\u0432\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 (1929\u20131941) \u041f\u043e\u0441\u043b\u0435
    \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0432 1929 \u0433\u043e\u0434\u0443 \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u043d\u0430\u0447\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043e\u0442\u0434\u0435\u043b\u0435 \u0421\u0435\u0439\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430. \u0417\u0434\u0435\u0441\u044c \u043e\u043d
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0412.\u0418. \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u044b\u043c
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e-\u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u0437\u0430\u0434\u0430\u0447
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u0443\u043f\u0440\u0443\u0433\u0438\u0445 \u0432\u043e\u043b\u043d, \u0447\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u043a\u0440\u0443\u043f\u043d\u044b\u043c \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u043c
    \u0432 \u0441\u0435\u0439\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435. \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0430\u043a \u043c\u0435\u0442\u043e\u0434
    \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u0430-\u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430,
    \u043d\u0430\u0448\u0435\u043b \u0448\u0438\u0440\u043e\u043a\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0433\u0435\u043e\u0444\u0438\u0437\u0438\u043a\u0435. \u0421 1932 \u0433\u043e\u0434\u0430
    \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u0430 \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u043c \u0438\u043c. \u0412.\u0410.
    \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430 (\u041c\u0418\u0410\u041d). \u0412 \u044d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0441\u043c\u0435\u0449\u0430\u044e\u0442\u0441\u044f
    \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0418\u0437\u0443\u0447\u0430\u044f
    \u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f,
    \u043e\u043d \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442 \u043a \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u043c\u0443
    \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043f\u043e\u043d\u044f\u0442\u0438\u044e \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u043e\u0433\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0438 \u0432\u0432\u043e\u0434\u0438\u0442
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438.
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443
    \u0432\u0437\u0433\u043b\u044f\u043d\u0443\u0442\u044c \u043d\u0430 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438.
    \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u044d\u0442\u043e\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0430
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u043d\u043e\u0432\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432 \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430,
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f.
    \u042d\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0446\u0435\u043b\u043e\u0439 \u044d\u043f\u043e\u0445\u0438 \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0435.
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u043f\u0440\u0438\u0448\u043b\u043e \u043e\u0447\u0435\u043d\u044c
    \u0440\u0430\u043d\u043e: \u0432 1933 \u0433\u043e\u0434\u0443 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    24 \u043b\u0435\u0442 \u043e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u041d \u0421\u0421\u0421\u0420, \u0430 \u0432 1939 \u0433\u043e\u0434\u0443, \u0432
    30 \u043b\u0435\u0442, \u2014 \u0441\u0430\u043c\u044b\u043c \u043c\u043e\u043b\u043e\u0434\u044b\u043c
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    (\u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c) \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0421\u0421\u0421\u0420. \u042d\u0442\u043e\u0442 \u0440\u0435\u043a\u043e\u0440\u0434
    \u043e\u043d \u0434\u0435\u0440\u0436\u0430\u043b \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b.\n\n\u269b\ufe0f
    \u00ab\u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u00bb
    \u0430\u0442\u043e\u043c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430
    (1943\u20131950-\u0435) \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432, \u0431\u0443\u0434\u0443\u0447\u0438 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u041c\u0418\u0410\u041d (1941\u20131944), \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u044b\u0432\u0430\u043b
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u0434\u043b\u044f \u043d\u0443\u0436\u0434 \u0444\u0440\u043e\u043d\u0442\u0430. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u044d\u0442\u0430\u043f\u043e\u043c \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u0438 \u0441\u0442\u0430\u043b 1943 \u0433\u043e\u0434, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443
    \u0432 \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044e \u2116 2 \u043f\u043e\u0434
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u0418.\u0412.
    \u041a\u0443\u0440\u0447\u0430\u0442\u043e\u0432\u0430, \u043d\u0430\u0447\u0430\u0432 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0432 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u043c \u0430\u0442\u043e\u043c\u043d\u043e\u043c
    \u043f\u0440\u043e\u0435\u043a\u0442\u0435. \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u043f\u0440\u043e\u0435\u043a\u0442\u0430, \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u0435\u043c
    \u041a\u0443\u0440\u0447\u0430\u0442\u043e\u0432\u0430 \u0438 \u0447\u043b\u0435\u043d\u043e\u043c
    \u0433\u0440\u0443\u043f\u043f\u044b \u0418.\u041a. \u041a\u0438\u043a\u043e\u0438\u043d\u0430.
    \u041e\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b \u0440\u0430\u0441\u0447\u0435\u0442\u043d\u043e-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438 \u043f\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0430\u0442\u043e\u043c\u043d\u043e\u0439 \u0431\u043e\u043c\u0431\u044b, \u043a\u0443\u0440\u0438\u0440\u0443\u044f
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043e\u0431\u043e\u0433\u0430\u0449\u0435\u043d\u0438\u044f
    \u0443\u0440\u0430\u043d\u0430 (\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u043d\u0430-235
    \u0438 \u043f\u043b\u0443\u0442\u043e\u043d\u0438\u044f-239) \u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u044b
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432. \u0415\u043c\u0443 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0440\u0435\u0448\u0430\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u043e \u044d\u0442\u043e\u0433\u043e \u043d\u0438\u043a\u0442\u043e \u043d\u0435
    \u0441\u0442\u0430\u0432\u0438\u043b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043c\u0430\u043b\u043e\u043c\u043e\u0449\u043d\u044b\u0435 \u043f\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c
    \u043c\u0435\u0440\u043a\u0430\u043c \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430. \u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0421\u043e\u0432\u0435\u0442\u0430 \u041c\u0438\u043d\u0438\u0441\u0442\u0440\u043e\u0432
    \u0421\u0421\u0421\u0420 \u043e\u0431\u044f\u0437\u044b\u0432\u0430\u043b\u043e \u0435\u0433\u043e
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0447\u0430\u0441\u0442\u044c
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c
    \u043d\u0430 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u043c \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u0435
    \u2116 813. \u0417\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0438
    \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u044f\u0434\u0435\u0440\u043d\u043e\u0433\u043e
    \u043e\u0440\u0443\u0436\u0438\u044f \u0432 1951 \u0433\u043e\u0434\u0443 \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0437\u0432\u0430\u043d\u0438\u044f
    \u0413\u0435\u0440\u043e\u044f \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430. \u0417\u0430 \u0433\u043e\u0434\u044b \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432 \u0430\u0442\u043e\u043c\u043d\u043e\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u0435
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b \u0442\u0440\u0438\u0436\u0434\u044b
    \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d \u0421\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u0438\u043c\u0438
    \u043f\u0440\u0435\u043c\u0438\u044f\u043c\u0438 (1941, 1951, 1953). \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434, \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e
    \u0441 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u043c\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438,
    \u043e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u2014 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u00ab\u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435\u00bb (1950), \u0441\u0442\u0430\u0432\u0448\u0443\u044e
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u043e\u0439
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0432\u0441\u0435\u0433\u043e
    \u043c\u0438\u0440\u0430.\n\n\U0001F4BB \u0423 \u0438\u0441\u0442\u043e\u043a\u043e\u0432
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438 \u0420\u0430\u0431\u043e\u0442\u0430
    \u043d\u0430\u0434 \u0430\u0442\u043e\u043c\u043d\u044b\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u043c
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0443
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u0438.
    \u0412 1952 \u0433\u043e\u0434\u0443 \u043e\u043d \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b
    \u043f\u0435\u0440\u0432\u0443\u044e \u0432 \u0421\u0421\u0421\u0420 \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043d\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0435 \u041c\u0413\u0423. \u0412
    1955 \u0433\u043e\u0434\u0443 \u043f\u043e \u0435\u0433\u043e \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u0431\u044b\u043b \u0441\u043e\u0437\u0434\u0430\u043d \u0412\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0446\u0435\u043d\u0442\u0440 \u041c\u0413\u0423, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043c\u043e\u0449\u043d\u044b\u0445 \u0432 \u0441\u0442\u0440\u0430\u043d\u0435. \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0438\u043e\u043d\u0435\u0440\u043e\u0432
    \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438 \u0432 \u0421\u0421\u0421\u0420.
    \u0412 \u0442\u043e \u0432\u0440\u0435\u043c\u044f, \u043a\u043e\u0433\u0434\u0430 \u044d\u0442\u0430
    \u043d\u0430\u0443\u043a\u0430 \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u043a\u0430\u043a \u00ab\u0431\u0443\u0440\u0436\u0443\u0430\u0437\u043d\u0430\u044f \u043b\u0436\u0435\u043d\u0430\u0443\u043a\u0430\u00bb,
    \u043e\u043d \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0410.\u0410. \u041b\u044f\u043f\u0443\u043d\u043e\u0432\u044b\u043c
    \u0438 \u0410.\u0418. \u041a\u0438\u0442\u043e\u0432\u044b\u043c \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u044c\u0435\u0439
    \u00ab\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0447\u0435\u0440\u0442\u044b \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438\u00bb
    (1955), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u044b\u0433\u0440\u0430\u043b\u0430
    \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e \u0440\u043e\u043b\u044c \u0432 \u0435\u0435
    \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0438
    \u0432 \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u043c \u0421\u043e\u044e\u0437\u0435.
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u043e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u042d\u0412\u041c, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0440\u043e\u0438\u0447\u043d\u043e\u0439 \u043c\u0430\u0448\u0438\u043d\u044b \u00ab\u0421\u0435\u0442\u0443\u043d\u044c\u00bb.\n\n\U0001F3D7\ufe0f
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0421\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e
    \u041e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0410\u041d \u0421\u0421\u0421\u0420
    (1957\u20131983) \u0412 \u043a\u043e\u043d\u0446\u0435 1950-\u0445 \u0433\u043e\u0434\u043e\u0432
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430\u043c\u0438
    \u041c.\u0410. \u041b\u0430\u0432\u0440\u0435\u043d\u0442\u044c\u0435\u0432\u044b\u043c
    \u0438 \u0421.\u0410. \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u043e\u0432\u0438\u0447\u0435\u043c
    \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b \u0441 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u043e\u0439
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0421\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0421\u0421\u0421\u0420. \u041e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a \u0438 \u0441
    1957 \u043f\u043e 1983 \u0433\u043e\u0434 \u0431\u0435\u0441\u0441\u043c\u0435\u043d\u043d\u043e
    \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u043b \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0421\u041e \u0410\u041d \u0421\u0421\u0421\u0420
    (\u043d\u044b\u043d\u0435 \u043d\u043e\u0441\u044f\u0449\u0438\u0439 \u0435\u0433\u043e
    \u0438\u043c\u044f). \u041f\u043e\u0434 \u0435\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0441\u044f
    \u0432 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u043c\u0438\u0440\u043e\u0432\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0446\u0435\u043d\u0442\u0440\u043e\u0432. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0438 \u043f\u0435\u0440\u0432\u044b\u043c \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u043c
    \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432 \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u043c
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (1959\u20131976),
    \u0432\u043d\u0435\u0441\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0443 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u043a\u0430\u0434\u0440\u043e\u0432. \u0412 \u00ab\u0441\u0438\u0431\u0438\u0440\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434\u00bb \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0441\u043e\u0437\u0434\u0430\u043b
    \u043d\u043e\u0432\u043e\u0435 \u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u2014 \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432
    \u043a \u043d\u0435\u0439 \u043c\u0435\u0442\u043e\u0434\u044b \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.\n\n\U0001F3DB\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0412 1983 \u0433\u043e\u0434\u0443 \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u041c\u043e\u0441\u043a\u0432\u0443 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0438\u043c. \u0412.\u0410. \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430.
    \u0421\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u043d 3 \u044f\u043d\u0432\u0430\u0440\u044f
    1989 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435. \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0421\u0435\u0440\u0433\u0435\u044f \u041b\u044c\u0432\u043e\u0432\u0438\u0447\u0430
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u043c
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430, \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u043c
    \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c \u043b\u0435\u0436\u0430\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0415\u0433\u043e \u0438\u043c\u044f
    \u043d\u043e\u0441\u044f\u0442 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0421\u041e \u0420\u0410\u041d, \u0443\u043b\u0438\u0446\u044b \u0432 \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a\u0435,
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u044b
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0438 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438
    \u0434\u043b\u044f \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u0443\u0447\u0435\u043d\u044b\u0445."
  shortBioEn: 
  interestingFactsRu: "\u0421\u0435\u0440\u0433\u0435\u0439 \u041b\u044c\u0432\u043e\u0432\u0438\u0447 \u0421\u043e\u0431\u043e\u043b\u0435\u0432,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0443\u0447\u0435\u043d\u044b\u043c,
    \u0431\u044b\u043b \u0442\u0430\u043a\u0436\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441 \u044f\u0440\u043a\u043e\u0439 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e,
    \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u0438\u0437\u043e\u0431\u0438\u043b\u043e\u0432\u0430\u043b\u0430
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u043c\u0438, \u043d\u043e \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u043c\u0438,
    \u0430 \u043f\u043e\u0440\u043e\u0439 \u0438 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u043c\u0438
    \u044d\u043f\u0438\u0437\u043e\u0434\u0430\u043c\u0438. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0437 \u043d\u0438\u0445, \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435
    \u043f\u043e\u043b\u043d\u043e \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440.\n\n\U0001F91D \"\u041a\u0440\u0435\u0441\u0442\u043d\u044b\u0439
    \u043e\u0442\u0435\u0446\" \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438
    \u0438 \u0437\u0430\u0449\u0438\u0442\u043d\u0438\u043a \"\u043f\u0440\u0430\u0436\u0441\u043a\u043e\u0439
    \u0432\u0435\u0441\u043d\u044b\" \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0431\u044b\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0441 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439 \u043f\u043e\u0437\u0438\u0446\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u0431\u043e\u044f\u043b\u0441\u044f
    \u0438\u0434\u0442\u0438 \u043f\u0440\u043e\u0442\u0438\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u044f.
    \u0421\u043f\u0430\u0441\u0435\u043d\u0438\u0435 \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438:
    \u0412 1950-\u0435 \u0433\u043e\u0434\u044b \u0432 \u0421\u0421\u0421\u0420 \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0430
    \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0441\u0447\u0438\u0442\u0430\u043b\u0430\u0441\u044c
    \"\u0431\u0443\u0440\u0436\u0443\u0430\u0437\u043d\u043e\u0439 \u043b\u0436\u0435\u043d\u0430\u0443\u043a\u043e\u0439\".
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0410.\u0410.
    \u041b\u044f\u043f\u0443\u043d\u043e\u0432\u044b\u043c, \u0440\u0438\u0441\u043a\u0443\u044f
    \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u0435\u0439, \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u044c\u0451\u0439
    \"\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0447\u0435\u0440\u0442\u044b \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438\",
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u044b\u0433\u0440\u0430\u043b\u0430 \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438
    \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f.
    \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0435 \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e:
    \u041e\u043d \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \"\u043f\u0438\u0441\u044c\u043c\u043e \u0442\u0440\u0451\u0445\u0441\u043e\u0442\" \u043f\u0440\u043e\u0442\u0438\u0432
    \u043b\u044b\u0441\u0435\u043d\u043a\u043e\u0432\u0449\u0438\u043d\u044b, \u0437\u0430\u0449\u0438\u0449\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u044b \u041b.\u0412. \u041a\u0430\u043d\u0442\u043e\u0440\u043e\u0432\u0438\u0447\u0430
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435 (\u0441\u0447\u0438\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044f
    \u043e\u0442\u0445\u043e\u0434\u043e\u043c \u043e\u0442 \u043c\u0430\u0440\u043a\u0441\u0438\u0437\u043c\u0430)
    \u0438 \u0432 1968 \u0433\u043e\u0434\u0443 \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443 \"\u043f\u0440\u0430\u0436\u0441\u043a\u043e\u0439
    \u0432\u0435\u0441\u043d\u044b\", \u0447\u0435\u043c \u043d\u0430\u0432\u043b\u0451\u043a
    \u043d\u0430 \u0441\u0435\u0431\u044f \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u043e
    \u043f\u0430\u0440\u0442\u0438\u0439\u043d\u043e\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0430.\n\n\U0001F3AD
    \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u044b \u0438 \"\u043f\u0440\u043e\u0432\u0430\u043b\u044c\u043d\u044b\u0439\"
    \u044e\u0431\u0438\u043b\u0435\u0439 \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u044b\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u0441\u043e\u0437\u0434\u0430\u0432\u0448\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0446\u0435\u043d\u0442\u0440\u044b, \u0447\u0430\u0441\u0442\u043e \u0441\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u043b\u0441\u044f
    \u0441 \u043d\u0435\u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u043c \u0438 \u0438\u043d\u0442\u0440\u0438\u0433\u0430\u043c\u0438
    \u0432 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0440\u0435\u0434\u0435.
    \u042e\u0431\u0438\u043b\u0435\u0439 \u0431\u0435\u0437 \u043d\u0430\u0433\u0440\u0430\u0434\u044b:
    \u0412 1983 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0443
    \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u043b\u043e\u0441\u044c 75 \u043b\u0435\u0442,
    \u0432\u0441\u0435 \u043e\u0436\u0438\u0434\u0430\u043b\u0438, \u0447\u0442\u043e \u0435\u043c\u0443
    \u0432\u0440\u0443\u0447\u0430\u0442 \u0432\u0442\u043e\u0440\u0443\u044e \u0417\u043e\u043b\u043e\u0442\u0443\u044e
    \u0417\u0432\u0435\u0437\u0434\u0443 \u0413\u0435\u0440\u043e\u044f \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430 \u0437\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0421\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0451\u043d
    \u043b\u0438\u0448\u044c \u041f\u043e\u0447\u0451\u0442\u043d\u043e\u0439 \u0433\u0440\u0430\u043c\u043e\u0442\u043e\u0439.
    \u041f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u043f\u043e\u0441\u043b\u0443\u0436\u0438\u043b\u0430
    \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u043e\u0437\u0438\u0446\u0438\u044f \u0432 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0435
    \u0441 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u041b.\u0421. \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d\u044b\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b \u0437\u0430 \u043a\u043b\u0435\u0432\u0435\u0442\u0443
    \u043d\u0430 \u0410.\u041d. \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430.
    \u0422\u0440\u0430\u0432\u043b\u044f \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0433\u043e\u0440\u043e\u0434\u043a\u0435:
    \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0442\u0430
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0421\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0432\u044b\u043d\u0443\u0434\u0438\u043b\u043e
    \u0435\u0433\u043e \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u0442\u044c \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435
    \u043e\u0431 \u0443\u0445\u043e\u0434\u0435 \u0441 \u043f\u043e\u0441\u0442\u0430 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0427\u0443\u0432\u0441\u0442\u0432\u0443\u044f \u0441\u0435\u0431\u044f \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u0451\u043d\u043d\u044b\u043c, \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a.\n\n\U0001F3A8 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u043f\u043e\u044d\u0442 \u0438 \u0441\u043a\u0430\u0437\u043e\u0447\u043d\u0438\u043a \u041c\u0430\u043b\u043e
    \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e \u0437\u0430 \u0441\u0442\u0440\u043e\u0433\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430
    \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u044c \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0430\u044f
    \u043d\u0430\u0442\u0443\u0440\u0430. \u041b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435: \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u043f\u0438\u0441\u0430\u043b \u0441\u0442\u0438\u0445\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435,
    \u043a\u0430\u043a \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c, \u0441\u043e\u0447\u0438\u043d\u044f\u043b
    \u0441\u043a\u0430\u0437\u043a\u0438. \u042d\u0442\u0430 \"\u043d\u0435\u043a\u0430\u043d\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f\"
    \u0433\u0440\u0430\u043d\u044c \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442\u0430
    \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u043a\u043d\u0438\u0433\u0435
    \"\u0421\u0435\u0440\u0433\u0435\u0439 \u041b\u044c\u0432\u043e\u0432\u0438\u0447 \u0421\u043e\u0431\u043e\u043b\u0435\u0432.
    \u0413\u0440\u0430\u043d\u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u0430\", \u043a\u0443\u0434\u0430
    \u0432\u043e\u0448\u043b\u0438 \u0435\u0433\u043e \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u0440\u0430\u043d\u0435\u0435 \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0432\u0448\u0438\u0435\u0441\u044f
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f.\n\n\U0001F575\ufe0f
    \"\u0418\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u0438\u043a\"
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u043d\u0435 \u0431\u044b\u043b \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u044b\u043c
    \u0441\u0432\u044f\u0442\u044b\u043c. \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0441\u043f\u043e\u0440\u043d\u044b\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \"\u0434\u0435\u043b\u0435 \u041b\u0443\u0437\u0438\u043d\u0430\"
    \u2014 \u0442\u0440\u0430\u0432\u043b\u0435 \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u041d.\u041d. \u041b\u0443\u0437\u0438\u043d\u0430
    \u0432 1930-\u0435 \u0433\u043e\u0434\u044b. \u0420\u043e\u043b\u044c \u0432 \"\u0434\u0435\u043b\u0435
    \u041b\u0443\u0437\u0438\u043d\u0430\": \u0421\u043e\u0431\u043e\u043b\u0435\u0432, \u0434\u043e\u0432\u0435\u0440\u0438\u0432\u0448\u0438\u0441\u044c
    \u043c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0438\u043c \u0434\u0440\u0443\u0437\u044c\u044f\u043c,
    \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b \u043f\u0440\u043e\u0442\u0438\u0432 \u0441\u0432\u043e\u0435\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u041b\u0443\u0437\u0438\u043d\u0430. \u042d\u0442\u043e\u0442
    \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u043a \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0442\u0451\u043c\u043d\u043e\u0435 \u043f\u044f\u0442\u043d\u043e \u0432 \u0435\u0433\u043e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0438, \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432,
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432
    \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u0441\u0430\u043c\u043e\u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430 \u043a \"\u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u0430\u0440\u0430\u0437\u0435\".\n\n\U0001F4C9 \u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u0431\u044b\u0442\u044c \u0431\u0430\u043b\u043e\u0432\u043d\u0435\u043c \u0441\u0443\u0434\u044c\u0431\u044b
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0440\u0430\u043d\u043e \u043f\u0440\u0438\u0448\u0451\u043b
    \u043a \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0441\u043b\u0430\u0432\u0435,
    \u0441\u0442\u0430\u0432 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c \u0432
    30 \u043b\u0435\u0442. \u041e\u0434\u043d\u0430\u043a\u043e \u044d\u0442\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \"\u0431\u0430\u043b\u043e\u0432\u043d\u044f \u0441\u0443\u0434\u044c\u0431\u044b\" \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u043e
    \u0435\u043c\u0443 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439 \u0434\u0438\u0441\u043a\u043e\u043c\u0444\u043e\u0440\u0442.
    \u041e\u043d \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0441\u044f \u0440\u0435\u0434\u043a\u043e\u0439
    \u0441\u0430\u043c\u043e\u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c\u044e, \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0431\u043e\u0440\u043e\u043b\u0441\u044f \u0437\u0430 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u044b
    \u0438 \u0431\u044b\u043b \u0447\u0443\u0436\u0434 \u0441\u0430\u043c\u043e\u0440\u0435\u043a\u043b\u0430\u043c\u0435,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0441\u0432\u043e\u0438\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0421\u0435\u0440\u0433\u0435\u0439
    \u041b\u044c\u0432\u043e\u0432\u0438\u0447 \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0451\u0442
    \u043f\u0435\u0440\u0435\u0434 \u043d\u0430\u043c\u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043a\u0430\u043a \u0430\u0432\u0442\u043e\u0440 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c, \u043d\u043e \u043a\u0430\u043a \u0436\u0438\u0432\u043e\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441\u043e \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0441\u0443\u0434\u044c\u0431\u043e\u0439, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0431\u044b\u043b\u0438 \u0438 \u0442\u0440\u0438\u0443\u043c\u0444\u044b, \u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f,
    \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u0441\u0442\u0443\u043f\u043a\u0438, \u0438 \u0433\u043e\u0440\u044c\u043a\u0438\u0435
    \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u044f."
