  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0421\u0435\u0440\u0433\u0435\u044f \u041b\u044c\u0432\u043e\u0432\u0438\u0447\u0430 \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0448\u0438\u0440\u043e\u043a\u0438\u0439
    \u0441\u043f\u0435\u043a\u0442\u0440 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u0438
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    XX \u0432\u0435\u043a\u0430. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439, \u043a\u0430\u0436\u0434\u043e\u0435
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u0442\u0430\u043b\u043e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.\n\n\U0001F4DC
    \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0435\u0439 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0435. \u0421\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439:
    \u0412 1935 \u0433\u043e\u0434\u0443 \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0434\u0430\u043b
    \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439
    \u0434\u043b\u044f \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0449\u0438\u0445\u0441\u044f
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u0443\u0435\u043c\u044b\u043c\u0438
    \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435.
    \u041e\u043d \u043f\u043e\u0434\u043e\u0448\u0451\u043b \u043a \u044d\u0442\u043e\u043c\u0443
    \u043f\u043e\u043d\u044f\u0442\u0438\u044e \u0441 \u043f\u043e\u0437\u0438\u0446\u0438\u0439
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u044f
    \u043f\u043e \u0447\u0430\u0441\u0442\u044f\u043c \u0438 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u044f
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u043d\u0430 \u0433\u043b\u0430\u0434\u043a\u0438\u0435 \u043f\u0440\u043e\u0431\u043d\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u041f\u0440\u043e\u0440\u044b\u0432 \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435:
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0432\u0432\u0435\u0441\u0442\u0438
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u043e\u0433\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438. \u0420\u0430\u043d\u0435\u0435
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 (\u0441 \u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b\u043c\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0443\u0434\u0430\u0440\u043d\u044b\u043c\u0438 \u0432\u043e\u043b\u043d\u0430\u043c\u0438)
    \u0431\u044b\u043b\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u0442\u044c
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438.
    \u0420\u0430\u0431\u043e\u0442\u044b \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0434\u0430\u043b\u0438
    \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0441\u0442\u0440\u043e\u0433\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442.\n\n\U0001F4D0
    \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430
    \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u042d\u0442\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0441\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e, \u043d\u043e\u0441\u044f\u0449\u0435\u0435 \u0435\u0433\u043e
    \u0438\u043c\u044f. \u041d\u043e\u0432\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430: \u0414\u043b\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u043c\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u0432\u0432\u0451\u043b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \\( W^{m}_{p} \\), \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043a\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430. \u042d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u0447\u044c\u0438 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435
    \u0434\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0430
    \\( m \\) \u0441\u0443\u043c\u043c\u0438\u0440\u0443\u0435\u043c\u044b \u0441\u043e \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e
    \\( p \\). \u0422\u0435\u043e\u0440\u0435\u043c\u044b \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f:
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u044d\u0442\u0438\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432.
    \u042d\u0442\u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442
    \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0438 \u043c\u0435\u0436\u0434\u0443
    \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u043c\u0438 \u0438
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0442\u044c, \u0447\u0442\u043e \u043f\u0440\u0438
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0438\u0437 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0439
    \u0438\u043b\u0438 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0434\u0440\u0443\u0433\u043e\u043c\u0443,
    \"\u043b\u0443\u0447\u0448\u0435\u043c\u0443\" \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443.
    \u042d\u0442\u043e \u0438\u043c\u0435\u0435\u0442 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0433\u043b\u0430\u0434\u043a\u043e\u0441\u0442\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0446\u0435\u043b\u043e\u0439 \u044d\u043f\u043e\u0445\u0438: \u0421\u043e\u0432\u043e\u043a\u0443\u043f\u043d\u043e\u0441\u0442\u044c
    \u044d\u0442\u0438\u0445 \u0438\u0434\u0435\u0439, \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0432 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u00ab\u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435\u00bb (1950), \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438 \u043d\u0430 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f \u0432\u043f\u0435\u0440\u0451\u0434.\n\n\U0001F4BB
    \u0422\u0435\u043e\u0440\u0438\u044f \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0412 \"\u0441\u0438\u0431\u0438\u0440\u0441\u043a\u0438\u0439\"
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0432\u043e\u0435\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u043e\u0435
    \u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0432 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041d\u043e\u0432\u044b\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0451\u043d\u043d\u043e\u043c\u0443
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e: \u041e\u043d
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043e\u0431\u0449\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b \u2014 \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b
    \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043a\u0440\u0430\u0442\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432.
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434: \u0421\u0432\u043e\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043e\u043d
    \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u0432 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b\u00bb
    (1974). \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0439
    \u0438\u043c \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u0442\u043e\u0447\u043d\u044b\u0445 \u043e\u0446\u0435\u043d\u043e\u043a \u043f\u043e\u0433\u0440\u0435\u0448\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043b\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445.\n\n\U0001F9ED
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u041f\u043e\u043c\u0438\u043c\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432, \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u0432\u043d\u0451\u0441 \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0440\u044f\u0434 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445 \u0438
    \u043c\u0435\u0436\u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 \u0438 \u0441\u0435\u0439\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u044f:
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0412. \u0418. \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u044b\u043c
    \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e-\u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447 \u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0438
    \u0443\u043f\u0440\u0443\u0433\u0438\u0445 \u0432\u043e\u043b\u043d. \u042d\u0442\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u0438\u043c\u0435\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0441\u0435\u0439\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438: \u0415\u0433\u043e
    \u043f\u0435\u0440\u0443 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u0437\u0430\u0434\u0430\u0447\u0435 \u041a\u043e\u0448\u0438 \u0434\u043b\u044f
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u043c
    \u0438 \u043d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u043c \u0437\u0430\u0434\u0430\u0447\u0430\u043c,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u043b\u0438\u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c. \u041a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0430:
    \u0412 1950-\u0445 \u0433\u043e\u0434\u0430\u0445, \u043a\u043e\u0433\u0434\u0430 \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0430
    \u0432 \u0421\u0421\u0421\u0420 \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u0430\u043b\u0430\u0441\u044c
    \u043a\u0440\u0438\u0442\u0438\u043a\u0435, \u0421\u043e\u0431\u043e\u043b\u0435\u0432 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0410. \u0410. \u041b\u044f\u043f\u0443\u043d\u043e\u0432\u044b\u043c \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u044c\u0451\u0439
    \u00ab\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0447\u0435\u0440\u0442\u044b \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u044b\u0433\u0440\u0430\u043b\u0430 \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0438 \u0438
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u0438
    \u0432 \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u043c \u0421\u043e\u044e\u0437\u0435.
    \u041a\u0440\u0430\u0442\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435: | \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c | \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f | |:--- |:--- | | \u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 | \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439. | | \u0422\u0435\u043e\u0440\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    | \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u0421\u043e\u0431\u043e\u043b\u0435\u0432\u0430 \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f. |
    | \u0412\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    | \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043a\u0443\u0431\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0443\u043b.
    | | \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 | \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e-\u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439; \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e
    \u0437\u0430\u0434\u0430\u0447\u0435 \u041a\u043e\u0448\u0438 \u0434\u043b\u044f \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. | | \u041a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0430
    | \u0423\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \"\u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438\"
    \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438 \u0432 \u0421\u0421\u0421\u0420,
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u0430\u044f
    \u0441\u0442\u0430\u0442\u044c\u044f \u0441 \u0410.\u0410. \u041b\u044f\u043f\u0443\u043d\u043e\u0432\u044b\u043c.
    |"
  achievementsEn: "The scientific legacy of Sergei Lvović Soboliv covers a wide range of fields and has had a profound impact on the mathematics of the twentieth century, and its contribution can be divided into several fundamental areas, each of which has become a separate field of research.\n\nThe theory of shared functions and shared solutions This work by Sobolova became a real revolution in mathematical analysis. The strict definition of the generic derivative: In 1935, Sobolov gave the first strict definition of the generic derivative for a broad class of functions that are not classically differentiated.It came to this concept from a functional analysis perspective, integrating parts and shifting the differentiation operation to smooth test functions. The gap in mathematical physics: This allowed for the introduction of a strict notion of a generic differential equation solution with private derivatives. Previously, many physical tasks (with bursting solutions such as shock waves) could not be described by classical methods.Sobolova's work gave it a strict mathematical apparatus.\n\nThe space of Sobean and theorem of investment is probably the most famous achievement of a scientist, bearing his name. New functional spaces: To work with the shared solutions of Sobeans, have introduced special functional spaces \\(W\\m}__p}, now known as the Sobol space. These are spaces whose features are functions whose general derivatives are to some order of magnitude \\(m\\) added up to the level of \\(p\\).Investment Theorems: The Sobean has proven the fundamental theorems of investment for these spaces. These theories establish the relationships between different functional spaces and allow, for example, to argue that under certain conditions the function from the Sobean space is automatically continuous or belongs to another \"best\" space.This is crucial to proving the existence and consistency of differential equation solutions. The foundation for an entire era: the sum of these ideas, detailed in his famous monograph, \"Some Application of Functional Analysis in Mathematical Physics\" (1950), became one of the most important areas of differential equations theory with private derivatives for decades to come.\n\nThe theory of cubatural formulas and computational mathematics in the \"Sibir period\" of Sobolv's activity created a new major focus in computational mathematics. A new approach to close integration: It developed a common theory of cube formulas, analog quadratic formulas for numerical computation of multiple integrals.Basic work: He summarized his findings in the monograph \"Introducing the theory of cube formulas\" (1974), and in this work he used the functional analysis tool he created to provide accurate estimates of error and to construct optimal numerical integration formulas for the functions of many variables.\n\nOther critical areas besides fundamental results, the Sobol has made a decisive contribution to a number of applied and interdisciplinary areas. Mathematical physics and seismology: Together with V. I. Smirnov, he has developed a method of functional and invariant solutions to address the problem of the spread of the wave. These works were of great importance to seismology.The theory of differential equations with private derivatives: His pen belongs to classic Kosha work for hyperbolic equations, mixed and non-linear tasks, and polyharmonic equations. Cybernetics: In the 1950s, when cybernetics in the USSR were criticized, Sobolov joined A.A.Laponov made a presentation on \"The Basic Features of Cybernetics\", which played a key role in the recognition and development of this science in the Soviet Union. A summary of its key scientific interests is presented in the table: . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .The creation of a general theory of cube formulas. ♪ Mathematical physics ♪ Development of a method of functional-invariant solutions; work on Kosha's task for hyperbolic equations. ♪ Cybernetics ♪ Participation in the \"rehabilitation\" of cybernetics in the USSR, joint programme article with A.A. Liapunov ♪"
  personalLifeRu: "\u0421\u0435\u0440\u0433\u0435\u0439 \u041b\u044c\u0432\u043e\u0432\u0438\u0447 \u0421\u043e\u0431\u043e\u043b\u0435\u0432
    \u2014 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0447\u044c\u044f \u043b\u0438\u0447\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430
