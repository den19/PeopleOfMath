    | \u0417\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0444\u0430\u043a\u0442
    | |:--- |:--- | | \u041b\u0438\u0447\u043d\u043e\u0441\u0442\u044c | \u0421\u043e\u0435\u0434\u0438\u043d\u044f\u043b
    \u0432 \u0441\u0435\u0431\u0435 \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438. \u041a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b \u0410\u0440\u0438\u0430\u0431\u0445\u0430\u0442\u0443
