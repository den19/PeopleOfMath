    \u043a\u0440\u0443\u0433\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432\u00bb.
    \u0415\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u0431\u044b\u043b\u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u044b
    \u043d\u0430 \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0439 \u0438 \u0430\u0437\u0438\u0430\u0442\u0441\u043a\u0438\u0435
    \u044f\u0437\u044b\u043a\u0438, \u0447\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e
    \u0445\u043e\u0434 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
