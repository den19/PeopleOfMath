  achievementsRu: "\u0425\u043e\u0442\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u044f \u0443\u0436\u0435
    \u043a\u043e\u0441\u043d\u0443\u043b\u0441\u044f \u044d\u0442\u043e\u0439 \u0442\u0435\u043c\u044b
    \u0432 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u043c \u043e\u0442\u0432\u0435\u0442\u0435,
    \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043c
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u0432\u043a\u043b\u0430\u0434
    \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b \u0432 \u043d\u0430\u0443\u043a\u0443
    \u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0441\u0442\u044c\u044e. \u0415\u0433\u043e
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u0434\u0430\u043b\u0435\u043a\u043e
    \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b. \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0438\u0437 \u043d\u0430\u0431\u043e\u0440\u0430
    \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0432 \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u0432
    \u0432 \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u0443\u044e
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443, \u043e\u043f\u0435\u0440\u0438\u0440\u0443\u044e\u0449\u0443\u044e
    \u043e\u0431\u0449\u0438\u043c\u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c\u0438.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u0430\u0437\u0431\u043e\u0440 \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0430
    \u043f\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c \u043d\u0430\u0443\u043a\u0438.
    --- 1. \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u00ab\u041f\u0440\u0430\u0432\u0438\u043b \u0437\u043d\u0430\u043a\u043e\u0432\u00bb \u042d\u0442\u043e
    \u0441\u0430\u043c\u043e\u0435 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b.
    \u0412 12-\u0439 \u0433\u043b\u0430\u0432\u0435 \u00ab\u0411\u0440\u0430\u0445\u043c\u0430-\u0441\u043f\u0445\u0443\u0442\u0430-\u0441\u0438\u0434\u0434\u0445\u0430\u043d\u0442\u044b\u00bb
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u0443\u0435\u0442
    \u0435\u0434\u0438\u043d\u044b\u0435 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0432\u0438\u0434\u043e\u0432
    \u0447\u0438\u0441\u0435\u043b: \u041d\u043e\u043b\u044c \u043a\u0430\u043a \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e: \u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u043d\u043e\u043b\u044c \u043d\u0435 \u043a\u0430\u043a \u00ab\u043f\u0443\u0441\u0442\u043e\u0435
    \u043c\u0435\u0441\u0442\u043e\u00bb \u0432 \u0437\u0430\u043f\u0438\u0441\u0438 \u0447\u0438\u0441\u043b\u0430,
    \u0430 \u043a\u0430\u043a \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u044f
    \u0447\u0438\u0441\u043b\u0430 \u0438\u0437 \u0441\u0430\u043c\u043e\u0433\u043e \u0441\u0435\u0431\u044f
    (`x - x = 0`). \u041e\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430: `a + 0 = a`, `a - 0 = a`, \u0438, \u0447\u0442\u043e
    \u0441\u0430\u043c\u043e\u0435 \u0432\u0430\u0436\u043d\u043e\u0435, `a \u00d7 0 = 0`. \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430 (\u00ab\u0414\u043e\u043b\u0433\u0438\u00bb): \u041e\u043d
    \u0432\u0432\u0435\u043b \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430 \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0434\u043e\u043b\u0433\u043e\u0432, \u0430 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u2014 \u0434\u043b\u044f \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430. \u041f\u0440\u0430\u0432\u0438\u043b\u0430
    \u0437\u043d\u0430\u043a\u043e\u0432 (\u0421\u0443\u0442\u0440\u044b): \u041e\u043d \u0434\u0430\u043b
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430
    \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0434\u0435\u043b\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u044b \u0443\u0447\u0438\u043c \u0432
    \u0448\u043a\u043e\u043b\u0435: \u00ab\u041f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0434\u0432\u0443\u0445 \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432 (\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445)
    \u0435\u0441\u0442\u044c \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e; \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0434\u0432\u0443\u0445 \u0434\u043e\u043b\u0433\u043e\u0432 (\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445)
    \u0435\u0441\u0442\u044c \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e; \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0438 \u0434\u043e\u043b\u0433\u0430
    \u0435\u0441\u0442\u044c \u0434\u043e\u043b\u0433\u00bb. \u0422\u043e \u0435\u0441\u0442\u044c:
    `(+) (+) = (+)`, `(-) (-) = (+)`, `(+) (-) = (-)`. \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430
    \u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043d\u0430 \u043d\u043e\u043b\u044c: \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430
    \u043f\u0435\u0440\u0432\u044b\u043c \u043e\u0441\u043e\u0437\u043d\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u044d\u0442\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438. \u041e\u043d
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b, \u0447\u0442\u043e
    `0 / 0 = 0` (\u0447\u0442\u043e \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e \u0441
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438
    \u0437\u0440\u0435\u043d\u0438\u044f, \u043d\u043e \u044d\u0442\u043e \u0431\u044b\u043b\u0430
    \u043f\u0435\u0440\u0432\u0430\u044f \u0437\u0430\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0434\u0430\u0442\u044c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u044d\u0442\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438). \u0427\u0442\u043e
    \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f `a / 0` (\u0433\u0434\u0435 a \u2260 0),
    \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u044d\u0442\u043e \u0431\u0435\u0437
    \u0447\u0435\u0442\u043a\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f,
    \u043b\u0438\u0448\u044c \u0443\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0442\u0430\u043a\u0430\u044f
    \u0434\u0440\u043e\u0431\u044c \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e\u043c
    \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 (\u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u0432 \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438). --- 2.
    \u0410\u043b\u0433\u0435\u0431\u0440\u0430 \u0438 \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b
    (\u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u041f\u0435\u043b\u043b\u044f) \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432 \u0432
    \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432\u0442\u043e\u0440\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0423\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u041f\u0435\u043b\u043b\u044f: \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435\u043c
    \u0432\u0438\u0434\u0430 Nx\u00b2 + 1 = y\u00b2 (\u0433\u0434\u0435 N \u2014 \u043d\u0435
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442). \u041c\u0435\u0442\u043e\u0434 \u00ab\u0421\u0430\u043c\u043e\u0441\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u00bb
    (\u0411\u0445\u0430\u0432\u0430\u043d\u0430): \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u0439, \u0438\u043c\u0435\u044f
    \u0434\u0432\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0442\u0430\u043a\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0438\u0445 \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043d\u043e\u0432\u043e\u0433\u043e,
    \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f.
    \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 (\u043f\u043e\u0437\u0436\u0435
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0439 \u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043e\u043c
    \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b\u2014\u0424\u0438\u0431\u043e\u043d\u0430\u0447\u0447\u0438)
    \u0433\u043b\u0430\u0441\u0438\u0442: \u0415\u0441\u043b\u0438 `x\u2081\u00b2 - Ny\u2081\u00b2
    = k\u2081` \u0438 `x\u2082\u00b2 - Ny\u2082\u00b2 = k\u2082`, \u0442\u043e `(x\u2081x\u2082
    + Ny\u2081y\u2082)\u00b2 - N(x\u2081y\u2082 + x\u2082y\u2081)\u00b2 = k\u2081k\u2082`. \u042d\u0442\u043e\u0442
    \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0438\u0437 \u043e\u0434\u043d\u043e\u0433\u043e.
    \u041f\u043e\u0437\u0436\u0435, \u0432 XII \u0432\u0435\u043a\u0435, \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0411\u0445\u0430\u0441\u043a\u0430\u0440\u0430
    II \u0434\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434
    \u0434\u043e \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430
    (\u0427\u0430\u043a\u0440\u0430\u0432\u0430\u043b\u0430), \u043d\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u0438\u043c\u0435\u043d\u043d\u043e \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430.
    \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0446\u044b \u0437\u0430\u043d\u043e\u0432\u043e
    \u043e\u0442\u043a\u0440\u044b\u043b\u0438 \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 XVII \u0432\u0435\u043a\u0435 (\u0424\u0435\u0440\u043c\u0430,
    \u0423\u043e\u043b\u043b\u0438\u0441, \u041b\u0430\u0433\u0440\u0430\u043d\u0436). --- 3.
    \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f (\u0424\u043e\u0440\u043c\u0443\u043b\u0430
    \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b) \u0412 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u0435\u043d:
    \u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u0434\u043b\u044f \u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u0432\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430:
    \u0414\u043b\u044f \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430
    \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438 a, b, c, d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043c\u043e\u0436\u043d\u043e \u0432\u043f\u0438\u0441\u0430\u0442\u044c \u0432 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u044c
    (\u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439), \u043f\u043b\u043e\u0449\u0430\u0434\u044c
    \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u0430\u043a: S
    = \u221a[(s - a)(s - b)(s - c)(s - d)], \u0433\u0434\u0435 s \u2014 \u043f\u043e\u043b\u0443\u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440.
    \u042d\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0413\u0435\u0440\u043e\u043d\u0430 \u0434\u043b\u044f
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 (\u0435\u0441\u043b\u0438
    \u043f\u0440\u0438\u043d\u044f\u0442\u044c d=0, \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432 \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u0413\u0435\u0440\u043e\u043d\u0430). \u0412\u0430\u0436\u043d\u043e, \u0447\u0442\u043e
    \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0434\u0430\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443, \u043d\u043e \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u0441\u0440\u0435\u0434\u0438 \u0432\u0441\u0435\u0445
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432
    \u0441 \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c\u0438 \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438
    \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044f \u0438\u043c\u0435\u043d\u043d\u043e
    \u0443 \u0432\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430.
    \u0414\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u0438 \u0432\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430:
    \u041e\u043d \u043d\u0430\u0448\u0435\u043b \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u0434\u043b\u0438\u043d \u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u0435\u0439
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430
    \u0447\u0435\u0440\u0435\u0437 \u0435\u0433\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b:
    \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432 \u043b\u044e\u0431\u043e\u043c
    \u0432\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u043c \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0435,
    \u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043f\u0435\u0440\u043f\u0435\u043d\u0434\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u044b,
    \u043f\u0440\u044f\u043c\u0430\u044f, \u043e\u043f\u0443\u0449\u0435\u043d\u043d\u0430\u044f
    \u0438\u0437 \u0442\u043e\u0447\u043a\u0438 \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u044f
    \u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u0435\u0439 \u043f\u0435\u0440\u043f\u0435\u043d\u0434\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e
    \u0441\u0442\u043e\u0440\u043e\u043d\u0435, \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0435\u043b\u0438\u0442
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0443\u044e
    \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u043f\u043e\u043f\u043e\u043b\u0430\u043c. ---
    4. \u0412\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0422\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0412 \u0441\u0432\u043e\u0438\u0445 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0430\u0445 \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434\u044b \u0434\u043b\u044f \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442: \u0418\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430 (\u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b):
    \u0414\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439
    \u0441\u0438\u043d\u0443\u0441\u043e\u0432 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b\u0445
    \u0443\u0433\u043b\u043e\u0432 (\u043a\u043e\u0433\u0434\u0430 \u0442\u0430\u0431\u043b\u0438\u0447\u043d\u044b\u0435
    \u0434\u0430\u043d\u043d\u044b\u0435 \u0431\u044b\u043b\u0438 \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u044b),
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u0443\u044e \u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u044e.
    \u0415\u0433\u043e \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0447\u0430\u0441\u0442\u043d\u044b\u043c
    \u0441\u043b\u0443\u0447\u0430\u0435\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u041d\u044c\u044e\u0442\u043e\u043d\u0430-\u0421\u0442\u0438\u0440\u043b\u0438\u043d\u0433\u0430
    (\u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443 \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c \u043d\u0430
    1000 \u043b\u0435\u0442). \u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u0434\u043b\u044f
    \u0440\u0430\u0434\u0438\u0443\u0441\u0430 \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0439
    \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438: \u041e\u043d \u0432\u044b\u0432\u0435\u043b
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0440\u0430\u0434\u0438\u0443\u0441\u0430 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438,
    \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0439 \u0432\u043e\u043a\u0440\u0443\u0433
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430, \u0447\u0435\u0440\u0435\u0437
    \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430
    (S) \u0438 \u0435\u0433\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b (a, b, c): R =
    (abc) / (4S). \u041b\u0438\u043d\u0435\u0439\u043d\u044b\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f:
    \u041e\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434\u044b \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c
    \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0441 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043c\u0435\u0442\u043e\u0434\u044b,
    \u043e\u0447\u0435\u043d\u044c \u0431\u043b\u0438\u0437\u043a\u0438\u0435 \u043a \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c\u0443
    \u043c\u0435\u0442\u043e\u0434\u0443 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445. --- 5. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f
    (\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u044b\u0439 \u043d\u043e\u0432\u0430\u0442\u043e\u0440)
    \u0415\u0433\u043e \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u044b (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u00ab\u041a\u0445\u0430\u043d\u0434\u0430\u043a\u0445\u0430\u0434\u044c\u044f\u043a\u0430\u00bb)
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0438 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0435
    \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438
    \u0442\u043e\u0447\u043d\u0435\u0435, \u0447\u0435\u043c \u0443 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432:
    \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0433\u043e\u0434\u0430:
    \u041e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0437\u0432\u0435\u0437\u0434\u043d\u043e\u0433\u043e \u0433\u043e\u0434\u0430 \u043a\u0430\u043a
    365 \u0434\u043d\u0435\u0439 6 \u0447\u0430\u0441\u043e\u0432 5 \u043c\u0438\u043d\u0443\u0442
    \u0438 19 \u0441\u0435\u043a\u0443\u043d\u0434, \u0447\u0442\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0431\u043b\u0438\u0437\u043a\u043e \u043a \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c (\u043e\u0448\u0438\u0431\u043a\u0430 \u0432\u0441\u0435\u0433\u043e
    \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0438\u043d\u0443\u0442).
    \u041f\u0430\u0440\u0430\u043b\u043b\u0430\u043a\u0441 \u041b\u0443\u043d\u044b: \u0412
    \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u043e\u043d
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e \u041b\u0443\u043d\u0430
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0431\u043b\u0438\u0436\u0435 \u043a
    \u0417\u0435\u043c\u043b\u0435, \u0447\u0435\u043c \u0421\u043e\u043b\u043d\u0446\u0435,
    \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b \u044d\u0442\u043e \u0440\u0430\u0437\u043d\u0438\u0446\u0435\u0439
    \u0432 \u0432\u0438\u0434\u0438\u043c\u043e\u043c \u043f\u0430\u0440\u0430\u043b\u043b\u0430\u043a\u0441\u0435
    (\u043a\u0430\u0436\u0443\u0449\u0435\u043c\u0441\u044f \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0438
    \u0441\u0432\u0435\u0442\u0438\u043b\u0430 \u043f\u0440\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0438
    \u0441 \u0440\u0430\u0437\u043d\u044b\u0445 \u0442\u043e\u0447\u0435\u043a \u0417\u0435\u043c\u043b\u0438).
    \u041a\u0440\u0438\u0442\u0438\u043a\u0430 \u0433\u0435\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0437\u043c\u0430
    (\u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u043e): \u041e\u043d
    \u0436\u0435\u0441\u0442\u043a\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b
    \u0410\u0440\u0438\u0430\u0431\u0445\u0430\u0442\u0443 \u0437\u0430 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0417\u0435\u043c\u043b\u0438 \u0432\u043e\u043a\u0440\u0443\u0433
    \u0441\u0432\u043e\u0435\u0439 \u043e\u0441\u0438. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u044f \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435,
    \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430 \u0432 \u0441\u0432\u043e\u0438\u0445
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0430\u043a,
    \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0417\u0435\u043c\u043b\u044f \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    (\u0442\u0435\u043e\u0440\u0438\u044f \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435).
    \u041e\u043d \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439, \u0441\u0430\u043c
    \u0442\u043e\u0433\u043e \u043d\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u044f
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438. --- 6. \u0412\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u043d\u0430\u0443\u043a\u0443 (\u041c\u0435\u0442\u0430-\u0432\u043a\u043b\u0430\u0434)
    \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b \u2014 \u044d\u0442\u043e
    \u0441\u043f\u043e\u0441\u043e\u0431 \u043f\u043e\u0434\u0430\u0447\u0438 \u0437\u043d\u0430\u043d\u0438\u0439:
    \u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u043c\u0438\u0441\u0442\u0438\u043a\u0438 \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435: \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432,
    \u043e\u043d \u0436\u0435\u0441\u0442\u043a\u043e \u043e\u0442\u0434\u0435\u043b\u044f\u043b
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430
    \u043e\u0442 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0439 \u043e\u0431\u0440\u044f\u0434\u043d\u043e\u0441\u0442\u0438.
    \u041e\u043d \u0437\u0430\u044f\u0432\u043b\u044f\u043b, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043f\u043e\u043d\u044f\u0442\u043d\u0430
    \u043b\u044e\u0431\u043e\u043c\u0443, \u043a\u0442\u043e \u043e\u0441\u0432\u043e\u0438\u043b
    \u0435\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u0432\u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438
    \u043e\u0442 \u043a\u0430\u0441\u0442\u044b. \u041f\u0435\u0440\u0435\u0434\u0430\u0447\u0430
    \u0437\u043d\u0430\u043d\u0438\u0439 \u0430\u0440\u0430\u0431\u0430\u043c: \u0418\u043c\u0435\u043d\u043d\u043e
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434 \u0432 771 \u0433\u043e\u0434\u0443 \u0431\u044b\u043b
    \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435
    \u043a\u0430\u043a \u00ab\u0421\u0438\u043d\u0434\u0445\u0438\u043d\u0434\u00bb. \u0427\u0435\u0440\u0435\u0437
    \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0430\u0440\u0430\u0431\u044b
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0438\u0441\u044c \u0441 \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f,
    \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u043c
    \u0437\u0430\u043f\u0438\u0441\u0438 \u0447\u0438\u0441\u0435\u043b (\u0441 \u043d\u0443\u043b\u0435\u043c)
    \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c\u0438 \u0437\u043d\u0430\u043a\u043e\u0432.
    \u0411\u0435\u0437 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u044b \u0442\u0440\u0443\u0434\u043e\u0432
    \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438, \u0430 \u0431\u0435\u0437
    \u0430\u043b\u044c-\u0425\u043e\u0440\u0435\u0437\u043c\u0438 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0439
    \u0420\u0435\u043d\u0435\u0441\u0441\u0430\u043d\u0441 \u043c\u043e\u0433 \u0431\u044b \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f. --- \u0420\u0435\u0437\u044e\u043c\u0438\u0440\u0443\u044e\u0449\u0430\u044f
    \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 | \u041e\u0431\u043b\u0430\u0441\u0442\u044c
    | \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 | \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0434\u043b\u044f \u043d\u0430\u0443\u043a\u0438 | |:--- |:--- |:--- | | \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430
    | \u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u0441 \u043d\u0443\u043b\u0435\u043c \u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0447\u0438\u0441\u043b\u0430\u043c\u0438. | \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e\u0439 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b (Z). | | \u0410\u043b\u0433\u0435\u0431\u0440\u0430
    | \u0422\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043e \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b
    \u0438 \u043c\u0435\u0442\u043e\u0434 \u0411\u0445\u0430\u0432\u0430\u043d\u0430. | \u041e\u0441\u043d\u043e\u0432\u0430
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u041f\u0435\u043b\u043b\u044f; \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. | | \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    | \u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u043f\u043b\u043e\u0449\u0430\u0434\u0438
    \u0432\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430.
    | \u041e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b
    \u0413\u0435\u0440\u043e\u043d\u0430; \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043d\u043e\u0432\u043e\u0433\u043e
    \u043a\u043b\u0430\u0441\u0441\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447. | | \u0410\u043d\u0430\u043b\u0438\u0437 | \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u0430\u044f
    \u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u044f \u0434\u043b\u044f
    \u0441\u0438\u043d\u0443\u0441\u043e\u0432. | \u041f\u0435\u0440\u0432\u044b\u0439 \u0448\u0430\u0433
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0430\u043d\u0430\u043b\u0438\u0437\u0430. |
    | \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f | \u0423\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435
    \u0434\u043b\u0438\u043d\u044b \u0433\u043e\u0434\u0430 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u0430\u0440\u0430\u043b\u043b\u0430\u043a\u0441\u0430. | \u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0439
    \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0439 \u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442. |"
  achievementsEn: 
  personalLifeRu: "\u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0435\u0441\u043b\u0438
    \u0440\u0435\u0447\u044c \u0438\u0434\u0435\u0442 \u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u043a\u0440\u0430\u0439\u043d\u0435 \u043c\u0430\u043b\u043e. \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043c\u043e\u0433\u0443\u0442 \u0432\u043e\u0441\u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u043b\u0438\u0448\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u044b,
    \u0430 \u0434\u0435\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u0441\u0435\u043c\u044c\u0438 \u0438 \u0431\u044b\u0442\u0430
    \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438.
    \u0412\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0430
    \u0438\u0437 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432 \u0438 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445
    \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0442\u043e\u0440\u043e\u0432. \u0412\u043e\u0442
    \u0432\u0441\u0451, \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0441\u043a\u0430\u0437\u0430\u0442\u044c
    \u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438, \u043f\u043e\u043c\u0438\u043c\u043e
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439:
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u043c\u044c\u044f:
    \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u043e\u043a\u043e\u043b\u043e 598 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u0411\u0445\u0438\u043b\u043b\u0430\u043c\u0430\u043b\u0430 (\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439
    \u0411\u0445\u0438\u043d\u043c\u0430\u043b \u0432 \u0448\u0442\u0430\u0442\u0435 \u0420\u0430\u0434\u0436\u0430\u0441\u0442\u0445\u0430\u043d).
    \u0415\u0433\u043e \u043e\u0442\u0446\u0430 \u0437\u0432\u0430\u043b\u0438 \u0414\u0436\u0438\u0448\u043d\u0443\u0433\u0443\u043f\u0442\u0430.
    \u0420\u0435\u043b\u0438\u0433\u0438\u044f: \u041e\u043d \u0431\u044b\u043b \u0438\u043d\u0434\u0443\u0438\u0441\u0442\u043e\u043c
    \u0438 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b \u043a \u0448\u0438\u0432\u0430\u0438\u0442\u0441\u043a\u043e\u0439
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438, \u0442\u043e \u0435\u0441\u0442\u044c
    \u043f\u043e\u0447\u0438\u0442\u0430\u043b \u0431\u043e\u0433\u0430 \u0428\u0438\u0432\u0443
    \u043a\u0430\u043a \u0432\u0435\u0440\u0445\u043e\u0432\u043d\u043e\u0435 \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u043e.
    \u041c\u0435\u0441\u0442\u043e \u0438 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438:
    \u0411\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438
    \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b \u0432 \u0440\u043e\u0434\u043d\u043e\u043c
    \u0411\u0445\u0438\u043d\u043c\u0430\u043b\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0442\u043e\u0433\u0434\u0430 \u0431\u044b\u043b \u0441\u0442\u043e\u043b\u0438\u0446\u0435\u0439
    \u0446\u0430\u0440\u0441\u0442\u0432\u0430 \u0413\u0443\u0440\u0434\u0436\u0430\u0440\u0430.
    \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e
    \u043e\u043d \u0436\u0438\u043b \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0430\u043c
    \u043f\u0440\u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435
    \u0446\u0430\u0440\u044f \u0412\u044c\u044f\u0433\u0440\u0430\u043c\u0443\u043a\u0445\u0438.
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0441\u0442\u0430\u0442\u0443\u0441 \u0438 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435:
    \u041e\u043d \u0431\u044b\u043b \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438 \u0432 \u0423\u0434\u0434\u0436\u0430\u0439\u043d\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u0431\u044b\u043b\u0430 \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0418\u043d\u0434\u0438\u0438. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0441\u0432\u043e\u0435\u043c\u0443 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044e
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435 \u0411\u0445\u0438\u043b\u043b\u0430\u043c\u0430\u043b\u0430\u0447\u0430\u0440\u044c\u044f,
    \u0447\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u0438\u0437 \u0411\u0445\u0438\u043b\u043b\u0430\u043c\u0430\u043b\u044b\u00bb. \u041f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c: \u041f\u043e\u0437\u0434\u043d\u0435\u0435
    \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0423\u0434\u0434\u0436\u0430\u0439\u043d,
    \u0433\u0434\u0435 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 67 \u043b\u0435\u0442
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0439 \u0432\u0442\u043e\u0440\u043e\u0439
    \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u00ab\u041a\u0445\u0430\u043d\u0434\u0430\u043a\u0445\u0430\u0434\u044c\u044f\u043a\u0430\u00bb.
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043d
    \u0443\u043c\u0435\u0440 \u0432 \u0423\u0434\u0434\u0436\u0430\u0439\u043d\u0435 \u043e\u043a\u043e\u043b\u043e
    668 \u0433\u043e\u0434\u0430. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u043c\u044b \u0437\u043d\u0430\u0435\u043c, \u0433\u0434\u0435 \u0438 \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d \u0436\u0438\u043b, \u043a\u0435\u043c \u0431\u044b\u043b \u0435\u0433\u043e
    \u043e\u0442\u0435\u0446, \u043a\u0430\u043a\u043e\u0439 \u0440\u0435\u043b\u0438\u0433\u0438\u0438
    \u043f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0441\u044f \u0438 \u0433\u0434\u0435
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b. \u041e\u0434\u043d\u0430\u043a\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f
    \u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u0441\u0435\u043c\u044c\u0435, \u0432\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445
    \u0441 \u043b\u044e\u0434\u044c\u043c\u0438 \u0438\u043b\u0438 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0445
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u0445 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442. \u0412\u0441\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435
    \u043d\u0430\u043c \u0444\u0430\u043a\u0442\u044b \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043a \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u0438
    \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044e \u0443\u0447\u0435\u043d\u044b\u0445
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u043c\u0443
    \u043f\u043e \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u0430\u043c."
  personalLifeEn: 
  shortBioRu: "\u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430 \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u0432,
    \u0436\u0438\u0432\u0448\u0438\u0439 \u0432 VII \u0432\u0435\u043a\u0435. \u0415\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u0438\u0441\u043b\u0430\u043c\u0441\u043a\u043e\u043c
    \u043c\u0438\u0440\u0435, \u0430 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0433\u043e
    \u2014 \u0438 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435. \u041e\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u043a\u0430\u043a \u043f\u0435\u0440\u0432\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0439
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u0441 \u043d\u0443\u043b\u0435\u043c \u0438
    \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438.\n\n\U0001F4DC
    \u0416\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u0443\u0442\u044c \u0438 \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0441\u0440\u0435\u0434\u0430 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435:
    \u0411\u0440\u0430\u0445\u043c\u0430\u0433\u0443\u043f\u0442\u0430 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u043e\u043a\u043e\u043b\u043e 598 \u0433\u043e\u0434\u0430 (\u043f\u043e \u0435\u0433\u043e
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0437\u0430\u043f\u0438\u0441\u044f\u043c)
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u0445\u0438\u043b\u043b\u0430\u043c\u0430\u043b\u0430
    (\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0411\u0445\u0438\u043d\u043c\u0430\u043b)
    \u0432 \u0448\u0442\u0430\u0442\u0435 \u0420\u0430\u0434\u0436\u0430\u0441\u0442\u0445\u0430\u043d,
    \u0421\u0435\u0432\u0435\u0440\u043e-\u0417\u0430\u043f\u0430\u0434\u043d\u0430\u044f \u0418\u043d\u0434\u0438\u044f.
    \u0415\u0433\u043e \u043e\u0442\u0446\u043e\u043c \u0431\u044b\u043b \u0414\u0436\u0438\u0448\u043d\u0443\u0433\u0443\u043f\u0442\u0430.
    \u041c\u0435\u0441\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u044b: \u0411\u043e\u043b\u044c\u0448\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0441\u0432\u043e\u0435\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
