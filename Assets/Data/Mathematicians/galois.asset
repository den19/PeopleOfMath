  fullNameRu: "\u0413\u0430\u043B\u0443\u0430, \u042D\u0432\u0430\u0440\u0438\u0441\u0442"
  fullNameEn: "\xC9variste Galois"
  birthDate: 25.10.1811
  deathDate: 31.05.1832
