    \u0441\u043c\u0435\u0440\u0442\u0438 \u0413\u0430\u043b\u0443\u0430 \u0416\u043e\u0437\u0435\u0444
    \u041b\u0438\u0443\u0432\u0438\u043b\u043b\u044c \u043d\u0430\u0448\u0435\u043b \u044d\u0442\u0438
    \u0437\u0430\u043f\u0438\u0441\u0438 \u0438 \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e
    \u0434\u0435\u0440\u0436\u0438\u0442 \u0432 \u0440\u0443\u043a\u0430\u0445 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434. 3. \u0417\u0430\u043f\u0438\u0441\u043a\u0430 \u043d\u0430 \u043f\u043e\u043b\u044f\u0445:
    \u00ab\u041d\u0430 \u044d\u0442\u043e \u0443 \u043c\u0435\u043d\u044f \u043d\u0435\u0442
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438\u00bb \u0412 \u043d\u043e\u0447\u044c \u043f\u0435\u0440\u0435\u0434
    \u0434\u0443\u044d\u043b\u044c\u044e, \u043d\u0430\u043a\u0430\u043d\u0443\u043d\u0435 \u0441\u0432\u043e\u0435\u0439
    \u0433\u0438\u0431\u0435\u043b\u0438, \u0413\u0430\u043b\u0443\u0430 \u043f\u0438\u0441\u0430\u043b
    \u043f\u0438\u0441\u044c\u043c\u043e \u0434\u0440\u0443\u0433\u0443 \u0441 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c
    \u0441\u0432\u043e\u0438\u0445 \u0438\u0434\u0435\u0439. \u041d\u0430 \u043f\u043e\u043b\u044f\u0445
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438, \u0440\u044f\u0434\u043e\u043c \u0441
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0442\u0435\u043e\u0440\u0435\u043c,
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0444\u0440\u0430\u0437\u0443: \u00ab\u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c...
    \u0438 \u0443 \u043c\u0435\u043d\u044f \u043d\u0435\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438\u00bb
    (\u043f\u043e-\u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438: \u00abIl faut
    une infinit\u00e9... et je n'ai pas le temps\u00bb). \u042d\u0442\u043e\u0442 \u0436\u0435\u0441\u0442\u043a\u0438\u0439,
    \u043f\u043e\u0447\u0442\u0438 \u0446\u0438\u043d\u0438\u0447\u043d\u044b\u0439 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439,
    \u0431\u0440\u043e\u0448\u0435\u043d\u043d\u044b\u0439 \u0432 \u043b\u0438\u0446\u043e \u0432\u0435\u0447\u043d\u043e\u0441\u0442\u0438,
    \u0441\u0442\u0430\u043b \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u0435\u0433\u043e
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0443\u0434\u044c\u0431\u044b
    \u2014 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u043c, \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u043d\u044b\u0439
    \u0438\u0437-\u0437\u0430 \u043f\u0443\u0441\u0442\u044f\u043a\u043e\u0432\u043e\u0439 \u0434\u0443\u044d\u043b\u0438.
    4. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0432 \u0442\u044e\u0440\u044c\u043c\u0435
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u043a\u0430\u043d\u0434\u0430\u043b
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f
    \u0432 \u0442\u044e\u0440\u044c\u043c\u0435 \u0421\u0435\u043d\u0442-\u041f\u0435\u043b\u0430\u0436\u0438
    \u0413\u0430\u043b\u0443\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439, \u043d\u043e \u0438
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0432\u0435\u0441\u0442\u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0431\u043e\u0440\u044c\u0431\u0443. \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0442\u044e\u0440\u0435\u043c\u043d\u043e\u0435
    \u043d\u0430\u0447\u0430\u043b\u044c\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0432\u0435\u043b\u043e
    \u043e\u0431\u044b\u0441\u043a \u0432 \u0435\u0433\u043e \u043a\u0430\u043c\u0435\u0440\u0435
    \u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u043e \u0442\u0430\u043c...
    \u043d\u0435 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u043b\u0438\u0441\u0442\u043e\u0432\u043a\u0438, \u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438. \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441
    \u043e\u0445\u0440\u0430\u043d\u043d\u0438\u043a\u043e\u0432, \u0447\u0442\u043e \u044d\u0442\u043e
    \u0437\u0430 \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \u0437\u043d\u0430\u043a\u0438,
    \u0413\u0430\u043b\u0443\u0430 \u043e\u0442\u0432\u0435\u0442\u0438\u043b, \u0447\u0442\u043e
    \u044d\u0442\u043e \u0435\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442 \u043a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0438
    \u043d\u043e\u0432\u043e\u0439 \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u043e\u0441\u043e\u0431\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c. \u041d\u0430
    \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u044d\u0442\u043e \u0431\u044b\u043b\u0438
    \u043d\u0430\u0431\u0440\u043e\u0441\u043a\u0438 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0443\u043f\u043f. \u041d\u0430\u0445\u043e\u0434\u044f\u0441\u044c \u0432
    \u0442\u043e\u0439 \u0436\u0435 \u0442\u044e\u0440\u044c\u043c\u0435, \u043e\u043d \u043f\u043e\u0441\u0441\u043e\u0440\u0438\u043b\u0441\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u043c
    \u043d\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0447\u0432\u0435
    \u0438 \u0434\u0430\u0436\u0435 \u0431\u044b\u043b \u0440\u0430\u043d\u0435\u043d \u0432
    \u043f\u043b\u0435\u0447\u043e \u043d\u043e\u0436\u043e\u043c \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0434\u0440\u0430\u043a\u0438. 5. \u0421\u0430\u043c\u043e\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e
    \u0438 \u0441\u0435\u043c\u0435\u0440\u043a\u0430 \u043f\u0438\u043a \u041b\u0435\u0433\u0435\u043d\u0434\u0430
    \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e \u0432 \u0442\u044e\u0440\u044c\u043c\u0435
    \u0413\u0430\u043b\u0443\u0430 \u0432\u043f\u0430\u043b \u0432 \u0433\u043b\u0443\u0431\u043e\u0447\u0430\u0439\u0448\u0443\u044e
    \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044e. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043d\u043e\u0447\u044c\u044e \u043e\u043d \u0432\u0437\u044f\u043b \u0431\u0440\u0438\u0442\u0432\u0443
    \u0438 \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u0435\u0440\u0435\u0440\u0435\u0437\u0430\u0442\u044c
    \u0441\u0435\u0431\u0435 \u0433\u043e\u0440\u043b\u043e. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u0435\u0433\u043e \u0441\u043f\u0430\u0441\u043b\u043e \u043d\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043b\u044e\u0434\u0435\u0439, \u0430... \u0433\u0440\u043e\u043c. \u0412\u043d\u0435\u0437\u0430\u043f\u043d\u044b\u0439
    \u0440\u0430\u0441\u043a\u0430\u0442 \u0433\u0440\u043e\u043c\u0430 (\u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c \u2014 \u0433\u043e\u043b\u043e\u0441 \u0441\u043e\u043a\u0430\u043c\u0435\u0440\u043d\u0438\u043a\u0430)
    \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b \u0435\u0433\u043e \u0432\u0437\u0434\u0440\u043e\u0433\u043d\u0443\u0442\u044c,
    \u0438 \u043e\u043d \u043f\u043e\u0440\u0435\u0437\u0430\u043b \u0442\u043e\u043b\u044c\u043a\u043e
    \u043a\u043e\u0436\u0443, \u043d\u0435 \u0437\u0430\u0434\u0435\u0432 \u0430\u0440\u0442\u0435\u0440\u0438\u0438.
    \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u0443\u0441\u043f\u043e\u043a\u043e\u0438\u043b\u0441\u044f
    \u0438 \u043f\u043e\u043a\u043b\u044f\u043b\u0441\u044f \u0436\u0438\u0442\u044c \u0440\u0430\u0434\u0438
    \u043d\u0430\u0443\u043a\u0438. 6. \u0417\u0430\u0433\u0430\u0434\u043a\u0430 \u0434\u0443\u044d\u043b\u0438:
    \u041b\u044e\u0431\u043e\u0432\u044c \u0438\u043b\u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430?
    \u041e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0434\u0443\u044d\u043b\u0438
    \u0413\u0430\u043b\u0443\u0430 \u043f\u043e\u043a\u0440\u044b\u0442\u044b \u043c\u0440\u0430\u043a\u043e\u043c
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440. \u0412\u0435\u0440\u0441\u0438\u044f
    \u043b\u044e\u0431\u0432\u0438: \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0432\u044b\u0437\u0432\u0430\u043b \u043d\u0430 \u0434\u0443\u044d\u043b\u044c
    \u043d\u0435\u043a\u043e\u0435\u0433\u043e \u041f\u0435\u0448\u043e \u0434'\u042d\u0440\u0431\u0435\u043d\u0432\u0438\u043b\u043b\u044f,
    \u0436\u0435\u043d\u0438\u0445\u0430 \u0441\u0432\u043e\u0435\u0439 \u0432\u043e\u0437\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u043e\u0439
    \u0421\u0442\u0435\u0444\u0430\u043d\u0438 \u041f\u043e\u0442\u0435\u0440\u0435\u043d-\u0414\u044e\u043c\u043e\u0442\u0435\u043b\u044c.
    \u0412\u0435\u0440\u0441\u0438\u044f \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f:
    \u041c\u043d\u043e\u0433\u0438\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u0441\u043a\u043b\u043e\u043d\u044f\u044e\u0442\u0441\u044f
    \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0434\u0443\u044d\u043b\u044c \u0431\u044b\u043b\u0430
    \u043f\u043e\u0434\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u0440\u043e\u044f\u043b\u0438\u0441\u0442\u0430\u043c\u0438.
    \u0413\u0430\u043b\u0443\u0430 \u0431\u044b\u043b \u043a\u0440\u0430\u0439\u043d\u0435 \u043e\u043f\u0430\u0441\u0435\u043d
    \u043a\u0430\u043a \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0439
    \u043b\u0438\u0434\u0435\u0440, \u0438 \u0435\u0433\u043e \u043f\u0440\u043e\u0449\u0435
    \u0431\u044b\u043b\u043e \u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c \u0432 \u043f\u043e\u0435\u0434\u0438\u043d\u043a\u0435
    \u0447\u0435\u0441\u0442\u0438, \u0447\u0435\u043c \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u044b\u0432\u0430\u0442\u044c.
    \u0412 \u043f\u043e\u043b\u044c\u0437\u0443 \u044d\u0442\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0442\u043e\u0442 \u0444\u0430\u043a\u0442,
    \u0447\u0442\u043e \u0435\u0433\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0438
    \u0431\u044b\u043b\u0438 \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0441\u0442\u0440\u0435\u043b\u043a\u0430\u043c\u0438,
    \u0430 \u0441\u0430\u043c \u0413\u0430\u043b\u0443\u0430 \u0432 \u0436\u0438\u0437\u043d\u0438
    \u043d\u0435 \u0434\u0435\u0440\u0436\u0430\u043b \u043f\u0438\u0441\u0442\u043e\u043b\u0435\u0442\u0430
    \u0432 \u0440\u0443\u043a\u0430\u0445. \u0412\u0435\u0440\u0441\u0438\u044f \"\u0433\u043b\u0443\u043f\u0446\u043e\u0432\":
    \u0412 \u043f\u0440\u0435\u0434\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0445 \u043f\u0438\u0441\u044c\u043c\u0430\u0445
    \u043e\u043d \u043f\u0438\u0441\u0430\u043b: \u00ab\u042f \u0443\u043c\u0438\u0440\u0430\u044e
    \u0436\u0435\u0440\u0442\u0432\u043e\u0439 \u0431\u0435\u0441\u0447\u0435\u0441\u0442\u043d\u043e\u0439
    \u043a\u043e\u043a\u0435\u0442\u043a\u0438 \u0438 \u0434\u0432\u0443\u0445 \u0433\u043b\u0443\u043f\u0446\u043e\u0432,
    \u043e\u0431\u043c\u0430\u043d\u0443\u0442\u044b\u0445 \u0435\u044e\u00bb. \u041e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0441\u0438\u043b \u0434\u0440\u0443\u0437\u0435\u0439
    \u00ab\u043d\u0435 \u0441\u0443\u0434\u0438\u0442\u044c \u0441\u0442\u0440\u043e\u0433\u043e\u00bb
    \u0435\u0433\u043e \u0443\u0431\u0438\u0439\u0446, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u043e\u043d\u0438 \u0431\u044b\u043b\u0438 \u00ab\u0447\u0435\u0441\u0442\u043d\u044b\u043c\u0438
    \u0438 \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0438\u043c\u0438\u00bb. \u042d\u0442\u043e
    \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0435 \u0432\u0435\u043b\u0438\u043a\u043e\u0434\u0443\u0448\u0438\u0435
    \u0434\u0430\u0435\u0442 \u043f\u0438\u0449\u0443 \u0434\u043b\u044f \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0442\u043e\u043b\u043a\u043e\u0432\u0430\u043d\u0438\u0439. 7. \u041c\u043e\u0433\u0438\u043b\u0430
    \u0431\u0435\u0437 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f \u042d\u0432\u0430\u0440\u0438\u0441\u0442
    \u0413\u0430\u043b\u0443\u0430 \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430
    \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u043c \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435
    \u041c\u043e\u043d\u043f\u0430\u0440\u043d\u0430\u0441. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043d\u0430 \u0435\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0435 \u043d\u0435\u0442
    \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439
    \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041d\u0430 \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u043e\u043c
    \u043a\u0430\u043c\u043d\u0435 \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u044b \u043b\u0438\u0448\u044c
    \u0434\u0430\u0442\u044b \u0436\u0438\u0437\u043d\u0438 \u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430\u044f
    \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f. \u041c\u043d\u043e\u0433\u0438\u0435 \u0441\u0447\u0438\u0442\u0430\u044e\u0442,
    \u0447\u0442\u043e \u044d\u0442\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e\u0441\u0442\u044c.
    \u041b\u0438\u0448\u044c \u0432 1848 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u0432\u043d\u043e\u0432\u044c \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f, \u0435\u0433\u043e \u0438\u043c\u044f
    \u043a\u0430\u043a \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0431\u043e\u0440\u0446\u0430 \u0431\u044b\u043b\u043e \u0432\u043f\u0438\u0441\u0430\u043d\u043e
    \u0432 \u0441\u043f\u0438\u0441\u043a\u0438 \u0433\u0435\u0440\u043e\u0435\u0432, \u043d\u043e
    \u043f\u0440\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0437\u0430\u0431\u044b\u043b\u0438 \u043f\u043e\u0447\u0442\u0438 \u043d\u0430 20 \u043b\u0435\u0442.
    8. \u0421\u0430\u043c\u044b\u0439 \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u0433\u0435\u043d\u0438\u0439
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0425\u043e\u0442\u044f \u0413\u0430\u043b\u0443\u0430 \u043f\u0440\u043e\u0436\u0438\u043b
    \u0432\u0441\u0435\u0433\u043e 20 \u043b\u0435\u0442, \u043e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043c\u043e\u043b\u043e\u0434\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u0437\u0430\u043b\u043e\u0436\u0438\u0432\u0448\u0438\u0445
    \u043e\u0441\u043d\u043e\u0432\u044b \u0446\u0435\u043b\u043e\u0433\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0430
    \u043d\u0430\u0443\u043a\u0438. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0435\u0433\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0438\u0434\u0435\u0438
    \u043e \u0433\u0440\u0443\u043f\u043f\u0430\u0445 \u043e\u043d \u043d\u0430\u0447\u0430\u043b
    \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c, \u043a\u043e\u0433\u0434\u0430
    \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e 17 \u043b\u0435\u0442.
    \u0414\u043b\u044f \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u041d\u044c\u044e\u0442\u043e\u043d
    \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0432 23 \u0433\u043e\u0434\u0430, \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d
    \u2014 \u0432 26, \u0430 \u0413\u0430\u043b\u0443\u0430 \u0432 17 \u043b\u0435\u0442 \u0443\u0436\u0435
    \u0440\u0435\u0448\u0430\u043b \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u0443\u0447\u0438\u043b\u0438 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435
    \u0443\u043c\u044b \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0439. 9. \u00ab\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u0438\u0435\u00bb
    \u0432 \u0412\u044b\u0441\u0448\u0435\u0439 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u041a\u043e\u0433\u0434\u0430 \u0432 1830 \u0433\u043e\u0434\u0443
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u0418\u044e\u043b\u044c\u0441\u043a\u0430\u044f
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f, \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440
    \u0448\u043a\u043e\u043b\u044b \u0437\u0430\u043f\u0435\u0440 \u0432\u0441\u0435\u0445 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u0432 \u0437\u0434\u0430\u043d\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438
    \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0432 \u0443\u043b\u0438\u0447\u043d\u044b\u0445
    \u0431\u043e\u044f\u0445. \u0413\u0430\u043b\u0443\u0430 \u043f\u0440\u0438\u0448\u0435\u043b
    \u0432 \u044f\u0440\u043e\u0441\u0442\u044c. \u041e\u043d \u0432\u044b\u0432\u0435\u0441\u0438\u043b
    \u0432 \u0445\u043e\u043b\u043b\u0435 \u0448\u043a\u043e\u043b\u044b \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u043f\u043b\u0430\u043a\u0430\u0442 \u0441 \u043f\u0440\u0438\u0437\u044b\u0432\u043e\u043c
    \u043a \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0438\u044e \u043f\u0440\u043e\u0442\u0438\u0432
    \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u043e\u0431\u043e\u0437\u0432\u0430\u043b
    \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430 \u0442\u0440\u0443\u0441\u043e\u043c.
    \u0417\u0430 \u044d\u0442\u043e \u0435\u0433\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u043b\u0438
    \u0438\u0437 \u0448\u043a\u043e\u043b\u044b \u2014 \u043d\u0435 \u0437\u0430 \u043f\u043b\u043e\u0445\u0438\u0435
    \u043e\u0446\u0435\u043d\u043a\u0438, \u0430 \u0437\u0430 \u0438\u0437\u043b\u0438\u0448\u043d\u044e\u044e
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c.
    \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u0447\u0442\u043e
    \u043f\u043e\u0437\u0436\u0435, \u0432 1848 \u0433\u043e\u0434\u0443, \u044d\u0442\u0430
    \u0441\u0430\u043c\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u0441\u0442\u0430\u043b\u0430
    \u043a\u043e\u043b\u044b\u0431\u0435\u043b\u044c\u044e \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f. 10. \u0421\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0439
    \u043a\u043e\u0434 \u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u0413\u0430\u043b\u0443\u0430 \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u043d\u0430 100 \u043b\u0435\u0442 \u0432\u043f\u0435\u0440\u0435\u0434. \u0421\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435
    \u0438\u043c \u043f\u043e\u043b\u044f \u0413\u0430\u043b\u0443\u0430 (GF) \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432. \u0417\u0430\u0431\u0430\u0432\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442: \u0435\u0441\u043b\u0438 \u0431\u044b \u0432\u043b\u0430\u0441\u0442\u044f\u043c
    \u0432 XIX \u0432\u0435\u043a\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e
    \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \"\u0437\u0430\u043a\u043e\u0440\u044e\u0447\u043a\u0438\"
    \u044d\u0442\u043e\u0433\u043e \u0431\u0435\u0437\u0443\u043c\u043d\u043e\u0433\u043e \u044e\u043d\u043e\u0448\u0438
    \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044c \u0431\u0430\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0435
    \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 \u0432 XXI \u0432\u0435\u043a\u0435,
    \u043e\u043d\u0438 \u0431\u044b \u0441\u043e\u0447\u043b\u0438 \u044d\u0442\u043e \u0448\u0443\u0442\u043a\u043e\u0439.
    11. \u0422\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0439
    \u0412 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0441\u0432\u043e\u0438\u0445 \u043f\u0438\u0441\u0435\u043c
    \u0413\u0430\u043b\u0443\u0430 \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u043b\u0435\u0437\u043d\u0430
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u044b,
    \u043d\u043e \u0438 \u0434\u043b\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u0412 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442
    \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432
    \u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u043c \u0447\u0438\u0441\u043b\u043e\u043c
    \u0441\u0442\u043e\u0440\u043e\u043d. \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043e
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0437\u0436\u0435,
    \u043d\u043e \u043e\u043d \u0431\u044b\u043b \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u043f\u0440\u0430\u0432. \u042d\u0432\u0430\u0440\u0438\u0441\u0442 \u0413\u0430\u043b\u0443\u0430
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0435\u043d\u0438\u0435\u043c;
    \u043e\u043d \u0431\u044b\u043b \u0436\u0438\u0432\u044b\u043c \u043e\u043b\u0438\u0446\u0435\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0435\u043c
    \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0433\u0435\u0440\u043e\u044f
    XIX \u0432\u0435\u043a\u0430: \u0431\u0443\u043d\u0442\u0430\u0440\u044c, \u0432\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u0439,
    \u0431\u0435\u0437\u0443\u043c\u0435\u0446 \u0438 \u043f\u0440\u043e\u0432\u0438\u0434\u0435\u0446,
    \u043e\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0438\u0439 \u0441\u043b\u0435\u0434 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0438\u0434\u0435\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u044c
    \u043d\u0430\u0443\u043a\u0443 \u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438
    \u0441\u043f\u0443\u0441\u0442\u044f \u043f\u043e\u0447\u0442\u0438 \u0434\u0432\u0430 \u0432\u0435\u043a\u0430."
  interestingFactsEn: "The life of Evarist Galois is not only a mathematician and a tragedy, but also a treasure of incredible coincidences, historical chickens and legends, and behind his brief biography there are many details that make his image even more vivid and mysterious. These are the most interesting and interesting facts about him, as detailed as possible.Galua is a fool who decides only in his mind. This is the most famous legend of Galois' failure in the entrance examinations at the Polytechnic School. The truth is: The examiner asked Galois to explain the logarithm task. Galois went so deep in his mind that he started to solve the problem in his mind, writing only the final answers.When the examiner asked him to record the course of his reasoning, Galois, pissed off by being interrupted, threw a wet rag at him to wash off the board (or, in other versions, a board to erase). Reality: Although this story is very popular, historians doubt its absolute credibility. It is well known that he showed brilliant but too concise solutions in his exams, which the commission simply failed to understand.He was a genius, but he was categorically unable to explain his thoughts in the school program, which led to failure. 2. The coroner, who had been lost twice, was incredibly unlucky about publishing his works, and for the first time he sent his main memoir, Augustin Louis Kosha, one of the greatest mathematicians of the time, and Koshi approved the work and pledged to introduce her to the Academy of Sciences.However, Koshi either lost the manuscript, or (in another version) she was lost in the Academy archives. Galois never waited for an answer. For the second time, after the prison, he sent a revised version to the secretary of the Academy of Sciences, Simeon Denis Poisson. Poisson studied the work for several months and reached a verdict: \"We tried to understand the evidence... but they were not enough to pass judgement.\" The Russians again failed to understand and put it in the archive.It was only 14 years after Galoua's death that Joseph Louville found these records and realized that he was holding a genius job. 3. Note in the fields: \"I don't have time.\" The night before the duel, the night before his death, Galoua wrote a letter to a friend setting out his ideas.This harsh, almost cynical comment, thrown into the face of eternity, was a symbol of his tragic fate — a genius, destroyed by a trifling duel. 4. Mathematics in prison and political scandal. During his detention in St. Pelegi Galois prison, not only did he pursue mathematics, but he also continued his political struggle.In response to a question from the guards about what these strange signs are, Galois replied that this was his draft constitution for the new France, encrypted in a special way, and that it was actually a sketch of his group theory, and while in the same prison, he had an argument with another political prisoner and was even stabbed in the shoulder with a knife during a fight.The suicide and seven of Legend's peak says that Galois prison was in the deepest depression. One night he took a razor and tried to slit his throat. However, ironically, he was saved not by human interference, but by... thunder.The mystery of the duel: Love or politics? The circumstances of the Galois duel are still covered by darkness. The love version: It is believed that he has called a Pescho d'Erbenville duel, the groom of his beloved Stephanie Poteren-Dumothel. The political version: Many historians tend to believe that the duel was built by Royalists. Galois was extremely dangerous as a revolutionary leader and was easier to eliminate in a fight of honour than to arrest.He also asked his friends not to judge strictly his murderers because they were \"honest and sincere.\" This strange generosity provides food for many interpretations.The grave without recognition, Evarist Galois is buried in the Paris cemetery of Montparnas, but there is no mention of math in his gravestone, only the dates of life and the standard epitathium on the tombstone, and many believe that this is the greatest historical injustice. Only in 1848, when the revolution again took place in France, his name as a political wrestler was included in the lists of heroes, but the genius math was forgotten for almost 20 years.8. The youngest genius in the history of mathematics, although Galois lived only 20 years, he was one of the youngest mathematicians to lay the foundation of a whole section of science, and it was interesting that he began to develop his basic ideas about groups when he was only 17 years old, and in comparison, Newton began his main discoveries at 23, Einstein at 26, and Galois at 17 years of age had already solved the problems that the greatest minds had suffered for centuries.\"Resurrection\" in the High School of Normality when the July Revolution took place in 1830, the principal of the school locked up all the students in the building so that they would not engage in street fighting. Galois was furious. He posted a huge poster in the hall of the school calling for rebellion against the principal, and then publicly called the principal a coward, for which he was expelled from school, not for bad grades, but for excessive political activity.It is noteworthy that later in 1848, this very school became the cradle of the Republican movement. 10. Galua's secret code and cryptography pre-empted the creation of encryption systems 100 years ahead. The Galua (GF) fields it created today are the basis for cryptographic algorithms.Funny fact: if authorities in the 19th century were to say that the strange \"crackets\" of this crazy young man would protect banking transactions in the 21st century, they would think it's a joke. 11. The accuracy of the predictions in one of Galois' letters said that his work would be useful not only for algebra, but also for geometry and numbers theory.In particular, he predicted that his theory would make it strictly impossible to construct the right polygons with a certain number of parties, which was proved much later, but he was absolutely right.Galois' evarist was not just a genius; he was a living symbol of the romantic hero of the 19th century: a rebel in love, a madman, and a seer who left a mark so deep that his ideas continued to move science and technology after almost two centuries."
