    \u0447\u0442\u043e \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0438\u0447\u0435\u0433\u043e.
    \u041a\u0430\u043a \u0431\u044b \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043c\u044b
    \u043d\u0438 \u0445\u043e\u0442\u0435\u043b\u0438 \u044d\u0442\u043e \u043e\u043f\u0438\u0441\u0430\u0442\u044c,
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438
    \u0445\u0440\u0430\u043d\u044f\u0442 \u043f\u043e\u043b\u043d\u043e\u0435 \u043c\u043e\u043b\u0447\u0430\u043d\u0438\u0435
    \u043e \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0435, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438
    \u0438 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445
    \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F4DC \u0418\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0438\u0448\u0438\u043d\u0430 \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u0438
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u044b \u0435\u0434\u0438\u043d\u043e\u0434\u0443\u0448\u043d\u044b:
    \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u044d\u0442\u043e\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c. \u041c\u044b
    \u043d\u0435 \u0437\u043d\u0430\u0435\u043c: \u041a\u0435\u043c \u0431\u044b\u043b\u0438
    \u0435\u0433\u043e \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438. \u0411\u044b\u043b
    \u043b\u0438 \u043e\u043d \u0436\u0435\u043d\u0430\u0442 \u0438 \u0431\u044b\u043b\u0438
