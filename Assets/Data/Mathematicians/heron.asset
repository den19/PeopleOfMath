    13 \u043c\u0430\u0440\u0442\u0430 62 \u0433\u043e\u0434\u0430 \u043d. \u044d.. \u0412\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u043a: \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0434\u043e\u043b\u0435\u0439 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438
    \u043e\u0442\u043d\u0435\u0441\u0442\u0438 \u0435\u0433\u043e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043a\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0435
    I \u0432\u0435\u043a\u0430 \u043d. \u044d.. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u0435\u0433\u043e \u0442\u043e\u0447\u043d\u043e\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0433\u0430\u0434\u043a\u043e\u0439,
    \u0445\u043e\u0442\u044f \u0435\u0433\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \u00ab\u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0438\u0439\u00bb
    \u043d\u0435\u0434\u0432\u0443\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u0436\u0438\u043b \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439
    \u2014 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u043c \u043d\u0430\u0443\u0447\u043d\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430.\n\n\u270d\ufe0f \u0413\u0435\u0440\u043e\u0439 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438? \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u043c\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u043c
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u043c\u044b \u043c\u043e\u0436\u0435\u043c \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u043e \u0435\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438, \u043e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u044f\u0441\u044c
    \u043d\u0430 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0435: \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u0415\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u044e\u0442
    \u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e
    \u0434\u0430\u043b\u0435\u043a\u043e \u043d\u0435 \u043a\u0430\u0436\u0434\u043e\u043c\u0443
    \u0436\u0438\u0442\u0435\u043b\u044e \u0420\u0438\u043c\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438.
    \u041e\u043d \u0431\u044b\u043b \u0437\u043d\u0430\u043a\u043e\u043c \u0441 \u0442\u0440\u0443\u0434\u0430\u043c\u0438
    \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432:
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430, \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430,
    \u041a\u0442\u0435\u0441\u0438\u0431\u0438\u044f. \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u044f:
    \u041e\u043d \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c
    \u043a\u0430\u043a \u00ab\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u00bb (ho mechanikos).
    \u041e\u043d \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b, \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b
    \u0434\u043b\u044f \u0442\u0435\u0430\u0442\u0440\u043e\u0432 \u0438 \u0445\u0440\u0430\u043c\u043e\u0432,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0438\u0441\u0430\u043b \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u044b. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442,
    \u0447\u0442\u043e \u043e\u043d \u043c\u043e\u0433 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u043c
    \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0435 \u2014 \u0446\u0435\u043d\u0442\u0440\u0435
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f.
    \u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0442\u0430\u0442\u0443\u0441:
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u043e\u0441\u0438\u043b\u0438
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440
    \u0438 \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u043b\u0438 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b
    \u043d\u0430 \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u043f\u0443\u0431\u043b\u0438\u043a\u0438 (\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u0430\u0442\u0440\u044b, \u0445\u0440\u0430\u043c\u043e\u0432\u044b\u0435 \u00ab\u0447\u0443\u0434\u0435\u0441\u0430\u00bb),
    \u0430 \u043d\u0435 \u043d\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447 \u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430.\n\n\u2757
    \u0412\u0430\u0436\u043d\u043e\u0435 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0435
    \u0412 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0432\u0438\u0434\u0435\u043e, \u043c\u043e\u0436\u043d\u043e \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044c
    \u0441\u043c\u0435\u043b\u044b\u0435 \u0442\u0435\u043e\u0440\u0438\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e \u0441\u0432\u044f\u0437\u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0439
    \u0413\u0435\u0440\u043e\u043d\u0430 \u0441 \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0438\u043c\u0438
    \u0447\u0443\u0434\u0435\u0441\u0430\u043c\u0438, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0441 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c \u0432\u043e\u0434\u044b
    \u0432 \u0432\u0438\u043d\u043e \u043d\u0430 \u0441\u0432\u0430\u0434\u044c\u0431\u0435
    \u0432 \u041a\u0430\u043d\u0435 \u0413\u0430\u043b\u0438\u043b\u0435\u0439\u0441\u043a\u043e\u0439.
    \u041f\u043e\u0434\u043e\u0431\u043d\u044b\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043b\u0438\u0448\u044c \u0441\u043f\u0435\u043a\u0443\u043b\u044f\u0446\u0438\u044f\u043c\u0438
    \u0438 \u043d\u0435 \u0438\u043c\u0435\u044e\u0442 \u043f\u043e\u0434 \u0441\u043e\u0431\u043e\u0439
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432.
    \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0413\u0435\u0440\u043e\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u043f\u043e\u0445\u043e\u0436\u0438\u0435
    \u00ab\u0432\u043e\u043b\u0448\u0435\u0431\u043d\u044b\u0435\u00bb \u0441\u043e\u0441\u0443\u0434\u044b
    \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0437\u043d\u0430\u0442\u0438,
    \u043d\u043e \u043b\u044e\u0431\u0430\u044f \u0441\u0432\u044f\u0437\u044c \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u0438 \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0439
    \u0441 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u043c\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u0438\u043b\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438
    \u2014 \u044d\u0442\u043e \u043b\u0438\u0448\u044c \u0434\u043e\u043c\u044b\u0441\u043b\u044b.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0413\u0435\u0440\u043e\u043d\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f
    \u0434\u043b\u044f \u043d\u0430\u0441 \u00ab\u0431\u0435\u043b\u044b\u043c \u043f\u044f\u0442\u043d\u043e\u043c\u00bb.
    \u0415\u0433\u043e \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u0430 \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0434\u0435\u0438,
    \u043d\u0430 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0438\u0435
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0438 \u0434\u043e\u0448\u0435\u0434\u0448\u0438\u0435
    \u0434\u043e \u043d\u0430\u0441 \u0432 \u0432\u0438\u0434\u0435 \u0444\u043e\u0440\u043c\u0443\u043b,
    \u0447\u0435\u0440\u0442\u0435\u0436\u0435\u0439 \u0438 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u043e\u0432. \u0415\u0441\u043b\u0438 \u0432\u044b
    \u0437\u0430\u0445\u043e\u0442\u0438\u0442\u0435 \u0443\u0437\u043d\u0430\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435
    \u043e \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f\u0445, \u044f
    \u0441 \u0440\u0430\u0434\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0443
    \u043e \u043d\u0438\u0445 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435."
  personalLifeEn: "With regard to Geron of Alexandria's personal life, it is regrettable to note that virtually nothing is certain; however much we wish to describe it, historical sources remain completely silent about his family, his origin and the circumstances of life.\n\nThe historical silence of the historians and biographers is unanimous: the information about the personal life of this genius engineer and mathematician is not preserved. We don't know who his parents were. Whether he was married or had children. What he was doing outside of his scientific and engineering activities. What kind of person he was in his life.All of his life descriptions are essentially a recapitulation of his scientific works and inventions, because it's the only thing left of this great mind.\n\nThe only clue is that in his work \"On Dioptra\", Geron mentions the lunar eclipse.His exact origin therefore remains a mystery, although his nickname \"Alexandria\" clearly indicates that he lived and worked in Alexandria of Egypt, the largest scientific center of the ancient world.\n\nAlthough we don't know the details of his personal life, we can make some assumptions about his situation based on his work: Education: His works testify to a brilliant education, which was not available to every resident of the Roman Empire. He was familiar with the work of many predecessors: Euclida, Archimedes, Ktesibia.He taught, created complex mechanisms for theatres and temples, and wrote scientific tracts, and some researchers believe that he could teach at the famous Alexandre Museyon, the centre of science and education.\n\nSome sources, especially in entertainment videos, can find bold theories about, for example, the relationship of Heron's inventions to Bible miracles, in particular, the conversion of water into wine at a wedding in Cana Galileo, and these are mere speculations and have no historical evidence.Geron may have created similar \"magic\" vessels to entertain the nobles, but any connection of his life and inventions to specific historical personalities or events is merely a hunch, so that the personal life of Geron of Alexandria will forever be a \"white spot\".His true legacy is not his biography, but his genius ideas, which for centuries have been ahead of their time and have come to us in the form of formulas, drawings and descriptions of the mechanisms, and if you want to learn more about his scientific works and inventions, I would be happy to tell you more about them."
  shortBioRu: "\u0413\u0435\u0440\u043e\u043d \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0438\u0439
    \u2014 \u043e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445
    \u0438 \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u044b\u0445 \u0444\u0438\u0433\u0443\u0440
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e
    \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430, \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430 \u0446\u0435\u043b\u044b\u0445 \u043f\u043e\u043b\u0442\u043e\u0440\u044b
    \u0442\u044b\u0441\u044f\u0447\u0438 \u043b\u0435\u0442 \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b
    \u0441\u0432\u043e\u0451 \u0432\u0440\u0435\u043c\u044f. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0435\u0433\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c,
    \u0434\u0435\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438, \u0430 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0438\u0437 \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0439 \u0442\u0430\u043a \u0438
    \u043d\u0435 \u043d\u0430\u0448\u043b\u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u043c
    \u043c\u0438\u0440\u0435.\n\n\U0001F4C5 \u0422\u0430\u0439\u043d\u0430 \u0436\u0438\u0437\u043d\u0438
    \u0438 \u0434\u0430\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u041f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0413\u0435\u0440\u043e\u043d\u0430
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0443\u0442\u0435\u0440\u044f\u043d\u044b. \u041c\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u043c
    \u043d\u0438 \u0442\u043e\u0447\u043d\u044b\u0445 \u0434\u0430\u0442 \u0435\u0433\u043e
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0438 \u0441\u043c\u0435\u0440\u0442\u0438,
    \u043d\u0438 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f
    \u0437\u0430\u0433\u0430\u0434\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u043e\u043b\u0433\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u043b\u043d\u043e\u0432\u0430\u043b\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432,
    \u2014 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043e\u043d \u0436\u0438\u043b. \u0414\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0434\u0430\u0442:
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u043e\u043d \u0436\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 (\u0443\u043c\u0435\u0440
    \u0432 212 \u0433. \u0434\u043e \u043d. \u044d.) \u0438 \u0434\u043e \u041f\u0430\u043f\u043f\u0430
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    (\u043e\u043a. 300 \u0433. \u043d. \u044d.), \u0447\u0442\u043e \u0434\u0430\u0432\u0430\u043b\u043e
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u0440\u043e\u0441
    \u0432 \u0434\u0432\u0435 \u0441 \u043b\u0438\u0448\u043d\u0438\u043c \u0441\u043e\u0442\u043d\u0438
    \u043b\u0435\u0442. \u041a\u043b\u044e\u0447 \u043a \u0440\u0430\u0437\u0433\u0430\u0434\u043a\u0435:
    \u0412 \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0443\u0434\u0435 \u00ab\u041e \u0434\u0438\u043e\u043f\u0442\u0440\u0435\u00bb
    \u0413\u0435\u0440\u043e\u043d \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043f\u0440\u0438\u043c\u0435\u0440\u0430 \u043b\u0443\u043d\u043d\u043e\u0435 \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435, \u043a\u0430\u043a \u0443\u0434\u0430\u043b\u043e\u0441\u044c
    \u0432\u044b\u044f\u0441\u043d\u0438\u0442\u044c, \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e
    13 \u043c\u0430\u0440\u0442\u0430 62 \u0433\u043e\u0434\u0430 \u043d. \u044d.. \u042d\u0442\u043e
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c \u0441
    \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0434\u043e\u043b\u0435\u0439 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438
    \u043e\u0442\u043d\u0435\u0441\u0442\u0438 \u0435\u0433\u043e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043a\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0435
    I \u0432\u0435\u043a\u0430 \u043d. \u044d.. \u041c\u0435\u0441\u0442\u043e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0413\u0435\u0440\u043e\u043d \u0436\u0438\u043b \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439
    \u2014 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u043c \u043d\u0430\u0443\u0447\u043d\u043e\u043c
    \u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u043e\u043c \u0446\u0435\u043d\u0442\u0440\u0435
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430. \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u043e\u043d \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u043c
    \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0435 (\u0445\u0440\u0430\u043c\u0435 \u043c\u0443\u0437),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043a\u043b\u044e\u0447\u0430\u043b \u0432
    \u0441\u0435\u0431\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0443\u044e
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443.\n\n\U0001F52C \u042d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u043d\u0430\u0443\u043a\u0438 \u0413\u0435\u0440\u043e\u043d
    \u043d\u0435 \u0431\u044b\u043b \u0443\u0437\u043a\u0438\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u043c.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442
    \u0441\u043e\u0431\u043e\u0439 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044e
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445 \u0437\u043d\u0430\u043d\u0438\u0439
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0443\u044e
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u2014 \u0415\u0432\u043a\u043b\u0438\u0434\u0430, \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430,
    \u0421\u0442\u0440\u0430\u0442\u043e\u043d\u0430 \u0438\u0437 \u041b\u0430\u043c\u043f\u0441\u0430\u043a\u0430.
    \u0415\u0433\u043e \u0441\u0442\u0438\u043b\u044c \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b \u0434\u043e\u0433\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u043c \u0438
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u044b\u043c: \u043e\u043d \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0438 \u043f\u0440\u0438\u043c\u0435\u0440\u044b,
    \u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0430\u0432\u0430\u044f \u0441\u0442\u0440\u043e\u0433\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430.
    \u0421\u0440\u0435\u0434\u0438 \u0435\u0433\u043e \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432 \u0432\u044b\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439: 1. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u00ab\u041c\u0435\u0442\u0440\u0438\u043a\u0430\u00bb: \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0440\u0443\u0434
    \u0413\u0435\u0440\u043e\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b
    \u0443\u0442\u0435\u0440\u044f\u043d \u0438 \u0432\u043d\u043e\u0432\u044c \u043d\u0430\u0439\u0434\u0435\u043d
    \u043b\u0438\u0448\u044c \u0432 1896 \u0433\u043e\u0434\u0443. \u042d\u0442\u043e \u0441\u0431\u043e\u0440\u043d\u0438\u043a
    \u043f\u0440\u0430\u0432\u0438\u043b \u0438 \u0444\u043e\u0440\u043c\u0443\u043b \u0434\u043b\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u043f\u043b\u043e\u0449\u0430\u0434\u0435\u0439
    \u0438 \u043e\u0431\u044a\u0435\u043c\u043e\u0432 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0444\u0438\u0433\u0443\u0440. \u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u0413\u0435\u0440\u043e\u043d\u0430:
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u00ab\u041c\u0435\u0442\u0440\u0438\u043a\u0435\u00bb
    \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f
    \u043d\u0430\u0439\u0442\u0438 \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430
    \u043f\u043e \u0434\u043b\u0438\u043d\u0430\u043c \u0442\u0440\u0435\u0445 \u0435\u0433\u043e
    \u0441\u0442\u043e\u0440\u043e\u043d. \u0425\u043e\u0442\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u043e\u0442\u043a\u0440\u044b\u043b
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434, \u0438\u043c\u0435\u043d\u043d\u043e \u0413\u0435\u0440\u043e\u043d
    \u0437\u0430\u043f\u0438\u0441\u0430\u043b \u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0435. \u0414\u0440\u0443\u0433\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b:
    \u0412 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0413\u0435\u0440\u043e\u043d\u0430 \u0442\u0430\u043a\u0436\u0435
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b
    \u0434\u043b\u044f \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445
    \u0438 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0440\u043d\u0435\u0439
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0438\u0442\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430, \u043d\u043e\u0441\u044f\u0449\u0430\u044f \u0435\u0433\u043e
    \u0438\u043c\u044f) \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    2. \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0438\u044f
    \u0412 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u00ab\u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u00bb
    \u0413\u0435\u0440\u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u043f\u044f\u0442\u044c
    \u043f\u0440\u043e\u0441\u0442\u0435\u0439\u0448\u0438\u0445 \u043c\u0430\u0448\u0438\u043d:
    \u0440\u044b\u0447\u0430\u0433, \u0432\u043e\u0440\u043e\u0442, \u043a\u043b\u0438\u043d,
    \u0432\u0438\u043d\u0442 \u0438 \u0431\u043b\u043e\u043a, \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u00ab\u0437\u043e\u043b\u043e\u0442\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438\u00bb: \u0432\u044b\u0438\u0433\u0440\u044b\u0448
    \u0432 \u0441\u0438\u043b\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442
    \u043a \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448\u0443 \u0432 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438.
    3. \u041f\u043d\u0435\u0432\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u043a\u0430
    \u0421\u0430\u043c\u044b\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f \u0413\u0435\u0440\u043e\u043d\u0430
    \u043e\u043f\u0438\u0441\u0430\u043d\u044b \u0432 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0435
    \u00ab\u041f\u043d\u0435\u0432\u043c\u0430\u0442\u0438\u043a\u0430\u00bb: \u042d\u043e\u043b\u0438\u043f\u0438\u043b:
    \u042d\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043f\u0430\u0440\u043e\u0432\u043e\u0439 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c,
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0439 \u0441\u043e\u0431\u043e\u0439
    \u0448\u0430\u0440, \u0432\u0440\u0430\u0449\u0430\u044e\u0449\u0438\u0439\u0441\u044f \u043f\u043e\u0434
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043c \u0441\u0442\u0440\u0443\u0439 \u043f\u0430\u0440\u0430.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438, \u0447\u0442\u043e \u043e\u043d
    \u043c\u043e\u0433 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044c \u0434\u043e 3500
    \u043e\u0431\u043e\u0440\u043e\u0442\u043e\u0432 \u0432 \u043c\u0438\u043d\u0443\u0442\u0443.
    \u0410\u0432\u0442\u043e\u043c\u0430\u0442 \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u0430\u0436\u0438
    \u00ab\u0441\u0432\u044f\u0442\u043e\u0439\u00bb \u0432\u043e\u0434\u044b: \u041c\u043e\u043d\u0435\u0442\u043d\u044b\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u044b\u0434\u0430\u0432\u0430\u043b \u043f\u043e\u0440\u0446\u0438\u044e \u0432\u043e\u0434\u044b
    \u0434\u043b\u044f \u043e\u043c\u043e\u0432\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435
    \u043e\u043f\u0443\u0441\u043a\u0430\u043d\u0438\u044f \u043c\u043e\u043d\u0435\u0442\u044b.
    \u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0432\u0435\u0440\u0438:
    \u041c\u0435\u0445\u0430\u043d\u0438\u0437\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u043b \u0434\u0432\u0435\u0440\u0438 \u0445\u0440\u0430\u043c\u0430,
    \u043a\u043e\u0433\u0434\u0430 \u043d\u0430 \u0436\u0435\u0440\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0435
    \u0440\u0430\u0437\u0432\u043e\u0434\u0438\u043b\u0438 \u043e\u0433\u043e\u043d\u044c, \u0438
    \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b \u0438\u0445, \u043a\u043e\u0433\u0434\u0430
    \u043e\u0433\u043e\u043d\u044c \u0442\u0443\u0448\u0438\u043b\u0438. \u0424\u043e\u043d\u0442\u0430\u043d
    \u0413\u0435\u0440\u043e\u043d\u0430: \u0423\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0432\u043e\u0434\u0430 \u0431\u044c\u0435\u0442
    \u0441\u0442\u0440\u0443\u0435\u0439 \u0432\u0432\u0435\u0440\u0445 \u0437\u0430 \u0441\u0447\u0435\u0442
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0441\u0436\u0430\u0442\u043e\u0433\u043e \u0432\u043e\u0437\u0434\u0443\u0445\u0430,
    \u0431\u0435\u0437 \u0432\u043d\u0435\u0448\u043d\u0435\u0433\u043e \u043d\u0430\u0441\u043e\u0441\u0430.
    4. \u0413\u0435\u043e\u0434\u0435\u0437\u0438\u044f \u0438 \u043e\u043f\u0442\u0438\u043a\u0430
    \u0414\u0438\u043e\u043f\u0442\u0440: \u0412 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435
    \u00ab\u041e \u0434\u0438\u043e\u043f\u0442\u0440\u0435\u00bb \u0413\u0435\u0440\u043e\u043d
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u044d\u0442\u043e\u0442 \u043f\u0440\u0438\u0431\u043e\u0440
    \u2014 \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0442\u0435\u043e\u0434\u043e\u043b\u0438\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u0434\u043b\u044f
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u0443\u0433\u043b\u043e\u0432 \u043d\u0430
    \u043c\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0435\u043c\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u044a\u0435\u043c\u043a\u0438, \u043f\u043e \u0441\u0443\u0442\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442. \u041e\u0434\u043e\u043c\u0435\u0442\u0440:
    \u041f\u0440\u0438\u0431\u043e\u0440 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0437\u0443\u0431\u0447\u0430\u0442\u0443\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443
    \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u043f\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0443
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u0430\u043a\u0441\u043e\u043c\u0435\u0442\u0440\u0430.
    \u0417\u0430\u043a\u043e\u043d \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u0432\u0435\u0442\u0430:
    \u0412 \u0442\u0440\u0443\u0434\u0435 \u00ab\u041a\u0430\u0442\u043e\u043f\u0442\u0440\u0438\u043a\u0430\u00bb
    \u043e\u043d \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0437\u0430\u043a\u043e\u043d
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u0432
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0441\u0432\u0435\u0442 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442
    \u0441\u0430\u043c\u044b\u0439 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043f\u0443\u0442\u044c
    \u2014 \u0447\u0430\u0441\u0442\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u0431\u043e\u043b\u0435\u0435
    \u043f\u043e\u0437\u0434\u043d\u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430
    \u0424\u0435\u0440\u043c\u0430.\n\n\U0001F3DB\ufe0f \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u0437\u0430\u0431\u0432\u0435\u043d\u0438\u0435 \u0413\u0435\u0440\u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b,
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u044d\u043e\u043b\u0438\u043f\u0438\u043b
    \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0435\u0430\u0442\u0440) \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c\u0438
    \u0447\u0443\u0434\u0435\u0441\u0430\u043c\u0438 \u0442\u0435\u0445\u043d\u0438\u043a\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u043c
    \u043c\u0438\u0440\u0435 \u043e\u043d\u0438 \u043d\u0435 \u043d\u0430\u0448\u043b\u0438
    \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043a\u0430\u043a \u0434\u043e\u0440\u043e\u0433\u0438\u0435
    \u0438\u0433\u0440\u0443\u0448\u043a\u0438, \u0442\u0435\u0430\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u044d\u0444\u0444\u0435\u043a\u0442\u044b \u0438\u043b\u0438 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u00ab\u0447\u0443\u0434\u0435\u0441\u00bb \u0432 \u0445\u0440\u0430\u043c\u0430\u0445,
    \u0447\u0442\u043e\u0431\u044b \u0443\u043a\u0440\u0435\u043f\u0438\u0442\u044c \u0432\u0435\u0440\u0443
    \u043f\u0440\u0438\u0445\u043e\u0436\u0430\u043d. \u0412 \u044d\u043f\u043e\u0445\u0443
    \u0421\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u044c\u044f \u043c\u043d\u043e\u0433\u0438\u0435
    \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u0431\u044b\u043b\u0438 \u0437\u0430\u0431\u044b\u0442\u044b.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u0430\u043c
    \u0432\u043e\u0437\u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043b\u0438\u0448\u044c \u0441\u043f\u0443\u0441\u0442\u044f
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f, \u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    \u0435\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u043b\u0438
    \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043a\u0430\u043a
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435 \u043c\u043d\u043e\u0433\u0438\u0445
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439.
    \u0413\u0435\u0440\u043e\u043d \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043a\u0430\u043a \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u0433\u043e \u0433\u0435\u043d\u0438\u044f,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f, \u043d\u043e \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0438
    \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043c\u0438\u0440, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043e\u043d \u0436\u0438\u043b."
  shortBioEn: "Geron of Alexandria is one of the brightest and most mysterious figures in ancient science, often called the greatest engineer in human history, a man who has been ahead of his time for a thousand and a half years, but despite his reputation, the details of his personal life remain almost unknown, and many of his brilliant inventions have never found practical application in the ancient world.\n\nThe mystery of life and the date of the details of Geron's biography are almost completely lost. We don't know the exact dates of his birth and death, nor the circumstances of his life. The main mystery that has long been of concern to historians is the time he lived in. The range of dates: it is known that he lived after Archimedes (dead in 212 BCE) and until Pappa of Alexandria (c. 300 C.C.), which has caused a huge difference of more than two hundred years.The key to the answer is that in his work \"On Dioptra\", Geron cited as an example the lunar eclipse, which was discovered to have occurred on 13 March 62 CE, which enabled modern researchers to place its activities with a high probability of being transferred to the second half of the first century CE. The place of activity: Heron lived and worked in Alexandria of Egypt, the largest scientific and cultural center of the ancient world.He probably taught at the Alexandri Museyon, the temple of the muse, which included the famous Alexandria Library.\n\nThe Encyclopedia of Antiquities, Geron, was not a specialist, but was a real encyclopaedia of applied knowledge of the time, which systematized the achievements of his predecessors, Euclid, Archimedes, Straton of Lampsak, and his style of presentation was dogmatic and practical: he provided rules and examples, not always providing strict mathematical evidence.One of his many works is the following: 1. Meterica Mathematics: This is Heron's main mathematical work, which was lost and discovered only in 1896; this is a set of rules and formulas for calculating the area and dimensions of the various figures; and the Heron Formula: It is in the \"Metrick\" that the famous formula is to find the area of the triangle by the length of the three sides.Although it is known that Archimedes discovered the formula, it was Geron who recorded and popularized it. Other methods: Heron's work also describes algorithms for extracting square and cubic roots (e.g., the iteration formula bearing his name) and the rules for solving the square equations. 2.Mechanics and engineering in the Mechanica tract Heron described five simple machines: lever, gate, wedge, screw and block, and formulated the \"golden mechanics rule\": winning is always a loser at a distance. 3. Pneumatics and hydraulics Heron's most famous inventions are described in his work \"Pneumatics\": Eolipel: This is the first steam engine in history to be a ball spinning under the steam.Modern reconstructions showed that he could develop to 3,500 revolutions per minute, a machine for selling \"saint\" water: a coin machine that gave a portion of water to wash after the coin had been lowered; automatic doors: the mechanism that opened the temple door when fire was fired on the altar, and closed it when the fire was put out.4. Geodemia and optics of Dioptr: In the tract \"O dioptra\", Geron describes this device, a representation of modern theodolite used to measure angles on the ground, and he also set out the rules for land surveying, essentially based on the application of rectangular coordinates.Odometer: A tool for measuring the path travelled, which used a smudge and operated on the principle of a modern taxiometer. The law of light reflection: In the work of Capottrica, it justified the law of reflection by putting forward the principle that light chooses the shortest way: the private case of a later Ferm principle.\n\nIn the ancient world, however, they were not widely applied and used mainly as expensive toys, theatre effects, or to create miracles in temples to strengthen the faith of the parishioners.His interest in his works did not return until centuries later, and during the industrial revolution, his inventions began to be perceived as a premonition of many modern technologies, and Heron remained a brilliant example of engineering genius whose ideas were far ahead of his time but could not change the world in which he lived."
  interestingFactsRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0413\u0435\u0440\u043e\u043d\u0430
