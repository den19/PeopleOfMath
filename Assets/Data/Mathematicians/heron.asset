    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432 \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0439,
    \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u044d\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435,
    \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u043e\u0442 \u044d\u0442\u043e\u0433\u043e
    \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0443\u043c\u0430.\n\n\U0001F4A1 \u041e\u0442\u043a\u0443\u0434\u0430
    \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u043e \u043d\u0435\u043c? \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
