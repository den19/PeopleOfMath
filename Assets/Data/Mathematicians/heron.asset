    \u0432 \u0441\u0438\u043b\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0430\u0451\u0442
    \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448 \u0432 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438.\n\n\U0001F30A
    \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f
