    \u2014 \u044d\u0442\u043e \u043d\u0430\u0434\u043f\u0438\u0441\u044c \u043d\u0430 \u0435\u0433\u043e
    \u043c\u043e\u0433\u0438\u043b\u044c\u043d\u043e\u043c \u043a\u0430\u043c\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u0432
    \u0432\u0438\u0434\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438. \u0415\u0451 \u0430\u0432\u0442\u043e\u0440\u043e\u043c,
    \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0431\u044b\u043b
    \u0434\u0440\u0443\u0433\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
