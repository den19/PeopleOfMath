    \u0435\u0439 \u2014 \u0438 \u043a\u0430\u043c\u0435\u043d\u044c > \u041c\u0443\u0434\u0440\u044b\u043c
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c \u0435\u0433\u043e \u0441\u043a\u0430\u0436\u0435\u0442
    \u0443\u0441\u043e\u043f\u0448\u0435\u0433\u043e \u0432\u0435\u043a. > \u0412\u043e\u043b\u0435\u0439
    \u0431\u043e\u0433\u043e\u0432 \u0448\u0435\u0441\u0442\u0443\u044e \u0447\u0430\u0441\u0442\u044c
    \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b \u0440\u0435\u0431\u0451\u043d\u043a\u043e\u043c.
    > \u0418 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443 \u0448\u0435\u0441\u0442\u043e\u0439
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b \u0441 \u043f\u0443\u0448\u043a\u043e\u043c
    \u043d\u0430 \u0449\u0435\u043a\u0430\u0445. > \u0422\u043e\u043b\u044c\u043a\u043e \u043c\u0438\u043d\u0443\u043b\u0430
    \u0441\u0435\u0434\u044c\u043c\u0430\u044f, \u0441 \u043f\u043e\u0434\u0440\u0443\u0433\u043e\u0439
    \u043e\u043d \u043e\u0431\u0440\u0443\u0447\u0438\u043b\u0441\u044f. > \u0421 \u043d\u0435\u044e,
    \u043f\u044f\u0442\u044c \u043b\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u0434\u044f,
    \u0441\u044b\u043d\u0430 \u0434\u043e\u0436\u0434\u0430\u043b\u0441\u044f \u043c\u0443\u0434\u0440\u0435\u0446;
    > \u0422\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043b\u0436\u0438\u0437\u043d\u0438
    \u043e\u0442\u0446\u043e\u0432\u0441\u043a\u043e\u0439 \u0432\u043e\u0437\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u0439
    \u0441\u044b\u043d \u0435\u0433\u043e \u043f\u0440\u043e\u0436\u0438\u043b. > \u041e\u0442\u043d\u044f\u0442
    \u043e\u043d \u0431\u044b\u043b \u0443 \u043e\u0442\u0446\u0430 \u0440\u0430\u043d\u043d\u0435\u0439
    \u043c\u043e\u0433\u0438\u043b\u043e\u0439 \u0441\u0432\u043e\u0435\u0439. > \u0414\u0432\u0430\u0436\u0434\u044b
    \u0434\u0432\u0430 \u0433\u043e\u0434\u0430 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044c
    \u043e\u043f\u043b\u0430\u043a\u0438\u0432\u0430\u043b \u0442\u044f\u0436\u043a\u043e\u0435
    \u0433\u043e\u0440\u0435, > \u0422\u0443\u0442 \u0438 \u0443\u0432\u0438\u0434\u0435\u043b
    \u043f\u0440\u0435\u0434\u0435\u043b \u0436\u0438\u0437\u043d\u0438 \u043f\u0435\u0447\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0432\u043e\u0435\u0439.\u00bb \u042d\u0442\u0430 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f
    \u2014 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u00ab\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u00bb,
    \u043f\u0440\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u0439 \u0441\u0432\u0435\u0442
    \u043d\u0430 \u043b\u0438\u0447\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430.
    \u0420\u0435\u0448\u0438\u0432 \u044d\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435,
    \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u044f\u0441\u043d\u0438\u0442\u044c, \u0447\u0442\u043e
    \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b 84 \u0433\u043e\u0434\u0430. \u0412\u043e\u0442
    \u043a\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438, \u0435\u0441\u043b\u0438 \u0432\u0435\u0440\u0438\u0442\u044c
    \u044d\u0442\u043e\u0439 \u043d\u0430\u0434\u043f\u0438\u0441\u0438: \u0414\u0435\u0442\u0441\u0442\u0432\u043e:
    \u0434\u043e 14 \u043b\u0435\u0442. \u042e\u043d\u043e\u0441\u0442\u044c (\u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435
    \u0431\u043e\u0440\u043e\u0434\u044b): \u0434\u043e 21 \u0433\u043e\u0434\u0430. \u0416\u0435\u043d\u0438\u0442\u044c\u0431\u0430:
    \u0432 33 \u0433\u043e\u0434\u0430. \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u044b\u043d\u0430:
    \u0432 38 \u043b\u0435\u0442. \u0421\u043c\u0435\u0440\u0442\u044c \u0441\u044b\u043d\u0430:
    \u0432 42 \u0433\u043e\u0434\u0430 (\u043a\u043e\u0433\u0434\u0430 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0443
    \u0431\u044b\u043b\u043e 80 \u043b\u0435\u0442). \u0421\u043c\u0435\u0440\u0442\u044c \u0441\u0430\u043c\u043e\u0433\u043e
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430: \u0432 84 \u0433\u043e\u0434\u0430.\n\n\U0001F48E
    \"\u041e\u0442\u0435\u0446 \u0430\u043b\u0433\u0435\u0431\u0440\u044b\" \u0438 \u0435\u0433\u043e
    \u044f\u0437\u044b\u043a \u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u043d \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u043c
    \u043c\u0438\u0440\u0435 \u043d\u0430\u0447\u0430\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0440\u0430\u0437\u0432\u0438\u0442\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u043a\u0443, \u0438\u0437\u0431\u0430\u0432\u0438\u0432\u0448\u0438\u0441\u044c
    \u043e\u0442 \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u0445 \u0441\u043b\u043e\u0432\u0435\u0441\u043d\u044b\u0445
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0439. \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u043c \u0432\u0438\u0434\u0435. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e\u043d \u0432\u0432\u0435\u043b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0437\u043d\u0430\u043a\u0438 \u0434\u043b\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    (`\u03c2`), \u0435\u0433\u043e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430 (`\u0394\u03a5`)
    \u0438 \u043a\u0443\u0431\u0430 (`\u039a\u03a5`). \u042d\u0442\u043e \u0431\u044b\u043b
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043f\u0440\u043e\u0440\u044b\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430.\n\n\U0001F3AF \"\u0414\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\": \u0433\u043e\u043d\u043a\u0430
    \u0447\u0435\u0440\u0435\u0437 \u0432\u0435\u043a\u0430 \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u2014 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb.
    \u042d\u0442\u043e \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0437\u0430\u0434\u0430\u0447
    (\u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0438\u0445\u0441\u044f \u043a\u043d\u0438\u0433\u0430\u0445
    \u0438\u0445 189), \u0440\u0435\u0448\u0430\u044f \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043d \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b
    \u043f\u043e\u0438\u0441\u043a\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0421\u0435\u0433\u043e\u0434\u043d\u044f
    \u0442\u0430\u043a\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u0433\u0434\u0435
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u2014 \u0446\u0435\u043b\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043a\u0430\u043a
    \u00ab\u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u00bb.
    \u041d\u043e \u043d\u0430 \u044d\u0442\u043e\u043c \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043d\u0435 \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0441 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u043e\u0439\u00bb
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u0440\u0430\u043c\u0430
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u041f\u044c\u0435\u0440 \u0424\u0435\u0440\u043c\u0430,
    \u0447\u0438\u0442\u0430\u044f \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430,
    \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \u043a\u043d\u0438\u0433\u0438 \u0437\u0430\u043f\u0438\u0441\u0430\u043b
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u0434\u043b\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f `x\u207f + y\u207f = z\u207f` \u043f\u0440\u0438
    `n>2` \u043d\u0435\u0442 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439. \u0420\u044f\u0434\u043e\u043c \u043e\u043d
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0444\u0440\u0430\u0437\u0443, \u0447\u0442\u043e \u043d\u0430\u0448\u0451\u043b \u00ab\u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0447\u0443\u0434\u0435\u0441\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u00bb,
    \u043d\u043e \u043f\u043e\u043b\u044f \u043a\u043d\u0438\u0433\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0443\u0437\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u0432\u043c\u0435\u0441\u0442\u0438\u0442\u044c.
    \u042d\u0442\u0430 \u0437\u0430\u043c\u0435\u0442\u043a\u0430 \u0441\u0442\u0430\u043b\u0430
    \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0424\u0435\u0440\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u0431\u043e\u043b\u0435\u0435 350 \u043b\u0435\u0442!\n\n\U0001F30D \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0432 \u043a\u043e\u0441\u043c\u043e\u0441\u0435 \u0438 \u043d\u0430\u0443\u043a\u0435
    \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u0438 \u0441\u043b\u0430\u0432\u0430 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u043f\u0435\u0440\u0435\u0448\u0430\u0433\u043d\u0443\u043b\u0438 \u0447\u0435\u0440\u0435\u0437
    \u0442\u044b\u0441\u044f\u0447\u0435\u043b\u0435\u0442\u0438\u044f, \u0438 \u0432 \u043f\u0430\u043c\u044f\u0442\u044c
    \u043e \u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d: \u041a\u0440\u0430\u0442\u0435\u0440
    \u043d\u0430 \u041b\u0443\u043d\u0435 \u2014 \u043d\u0430 \u0432\u0438\u0434\u0438\u043c\u043e\u0439
    \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u043d\u0430\u0448\u0435\u0433\u043e \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0430
    \u0435\u0441\u0442\u044c \u043a\u0440\u0430\u0442\u0435\u0440, \u043d\u043e\u0441\u044f\u0449\u0438\u0439
    \u0435\u0433\u043e \u0438\u043c\u044f (Diophantus). \u0426\u0435\u043b\u044b\u0439 \u0440\u0430\u0437\u0434\u0435\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u2014 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0438 \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432 \u0430\u043d\u0430\u043b\u0438\u0437
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u0412\u0441\u0451
    \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0444\u0438\u0433\u0443\u0440\u0443
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u0443\u0447\u0435\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439,
    \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0434\u0430\u043b\u0438 \u043f\u0438\u0449\u0443 \u0434\u043b\u044f \u0443\u043c\u0430
    \u0438 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u0435 \u043d\u0430 \u0432\u0435\u043a\u0430
    \u0432\u043f\u0435\u0440\u0435\u0434."
  interestingFactsEn: "Even though Diofant's identity is covered in mystery, his name is associated with many fascinating stories and facts, and I suggest that we go into the world of fascinating details surrounding this great mathematician.\n\nEpitaphia-hololowomka The most famous and exciting story about Diofant is the inscription on his tombstone, which was written as a mathematical task. It was believed to have been another mathematician, Metrodor. > \"The Pearl of Diofant is tombing; wonder it — and the stone > The wisdom of art will tell it by the dead age. > The will of the gods in the sixth part of life he lived as a child. > And half sixth met with a gun on the cheeks.> Only after the seventh, he was engaged with his girlfriend. > With her, having spent five years, the son waited for the wise man; > Only half of his father's beloved son lived. > He was taken from his father by his early grave. > Twice two years, the parent mourned the bitter grief, > Toth, and saw the limit of his sad life. ' This epithephia is the only document that sheds light on Diofant's personal life. By solving this equation, you can find out that he lived 84 years.Here's what the timeline of his life looks like, according to this inscription: childhood: up to the age of 14; youth: up to the age of 21; marriage: 33; son's birth: 38; son's death: 42 (when Diofant was 80); and Diofant's death: 84.\n\n==History==\"Father of Algebra\" and his language, Diofant made a real revolution in mathematics. He was one of the first in the ancient world to use a developed mathematical symbolism, freeing himself of cumbersome words. This allowed for the recording of complex equations in a reasonably compact form. For example, he introduced special signs for the unknown (`\\, `, '), his square (', , ) and the cube (', , , , ).It was a real breakthrough that laid the foundations of modern algebraic language.\n\nThe main work of the Dioffent is \"Arifmetics.\" This is a collection of tasks (in the remaining 189 books), which he shows elegant methods to find solutions to uncertain equations. Today, equations where unknowns are whole numbers are known as \"diofents of the equation.\" But this is not the end of the story. It is with Arifmetics that the most famous mathematical drama in history is linked.In the French mathematician Pierre Ferma, reading Diofant's edition, he wrote a statement in the book fields that for the equation `xn + yn = zn' at `n>2' there were no numbered solutions. Next he left a famous phrase that he found \"a truly wonderful proof,\" but that the fields of the book were too narrow to fit it. This note caused the Great Farm Theorem, which mathematicians have proven for over 350 years.\n\nThe legacy in space and science of the influence and glory of Diofante has passed through the millennia and is named as: Crater on the Moon — on the visible side of our satellite is the crater that gives its name (Diofantus). A whole section of mathematics — the theory of diofant equations and diofents — analyses are fundamental areas of modern number theory.All of this makes the figure of Diofant not only an outstanding scientist, but also a true legend whose life and work have given food for thought and inspiration for centuries to come."
