  fullNameRu: "\u0414\u0438\u043E\u0444\u0430\u043D\u0442 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0438\u0439\u0441\u043A\u0438\u0439"
