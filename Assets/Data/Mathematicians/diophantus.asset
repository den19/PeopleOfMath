  achievementsRu: "\u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0438\u0439
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u044f\u0434 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043d\u0430 \u0432\u0435\u043a\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043b\u0435\u0436\u0430\u0442 \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430, \u043d\u043e\u0432\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0438 \u0432 \u0441\u0430\u043c\u043e\u043c \u043f\u043e\u0434\u0445\u043e\u0434\u0435
    \u043a \u0447\u0438\u0441\u043b\u0430\u043c.\n\n\U0001F4A1 \u041e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u043e\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0413\u0440\u0435\u0447\u0435\u0441\u043a\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0434\u043e \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0431\u044b\u043b\u0430 \u0442\u0435\u0441\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439:
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0440\u0435\u0448\u0430\u043b\u0438\u0441\u044c \u0441
    \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0447\u0435\u0440\u0442\u0435\u0436\u0435\u0439
    \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0439, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438
    \u043e\u043d\u0438 \u0431\u044b\u043b\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043f\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u0443\u0442\u0438. \u0414\u0438\u043e\u0444\u0430\u043d\u0442
    \u0432 \u043a\u043e\u0440\u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u044d\u0442\u043e\u0442
    \u043f\u043e\u0434\u0445\u043e\u0434. \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u0438\u0437 \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445 \u0443\u0447\u0435\u043d\u044b\u0445
    \u043d\u0430\u0447\u0430\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0447\u0438\u0441\u0442\u043e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b,
    \u043d\u0435 \u043f\u0440\u0438\u0431\u0435\u0433\u0430\u044f \u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u0438 \u0434\u043b\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0448\u0430\u0433\u043e\u043c \u0432\u043f\u0435\u0440\u0435\u0434,
    \u0432\u044b\u0434\u0435\u043b\u0438\u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0432
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0441\u0434\u0435\u043b\u0430\u0432 \u0435\u0435 \u0431\u043e\u043b\u0435\u0435
    \u0433\u0438\u0431\u043a\u0438\u043c \u0438 \u043c\u043e\u0449\u043d\u044b\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447.\n\n\u270d\ufe0f
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u043e\u0433\u043e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \u0414\u043e \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u0432\u0441\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438\u0441\u044c
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u2014 \u044d\u0442\u043e \u0431\u044b\u043b\u0430
    \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0430\u044f \u0440\u0438\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430. \u042d\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u043e
    \u0437\u0430\u043f\u0438\u0441\u0438 \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u043c\u0438
    \u0438 \u043d\u0435\u0443\u0434\u043e\u0431\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439. \u0414\u0438\u043e\u0444\u0430\u043d\u0442
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0441\u0438\u043d\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u2014 \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044b\u0445 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u0446\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u043a\u0438. \u041e\u043d \u0432\u0432\u0435\u043b
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0437\u043d\u0430\u043a\u0438
    \u0434\u043b\u044f: \u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 (`\u03c2`)
    \u0438 \u0435\u0435 \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439, \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e \u0448\u0435\u0441\u0442\u043e\u0439 (`\u0394\u03a5` \u0434\u043b\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430,
    `\u039a\u03a5` \u0434\u043b\u044f \u043a\u0443\u0431\u0430 \u0438 \u0442.\u0434.). \u0412\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u044f
    (\u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0442\u0430\u044f \u0431\u0443\u043a\u0432\u0430
    \u03a8). \u0420\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 (\u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u043e\u0442 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043b\u043e\u0432\u0430
    \"\u0440\u0430\u0432\u043d\u044b\u0439\"). \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e,
    \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u043f\u0440\u0430\u0432\u0438\u043b\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0441 \u044d\u0442\u0438\u043c\u0438 \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438:
    \u043f\u0440\u0438\u0432\u0435\u043b \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0445 \u0447\u043b\u0435\u043d\u043e\u0432, \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0430
    \u0447\u043b\u0435\u043d\u043e\u0432 \u0438\u0437 \u043e\u0434\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432 \u0434\u0440\u0443\u0433\u0443\u044e
    \u0441\u043e \u0441\u043c\u0435\u043d\u043e\u0439 \u0437\u043d\u0430\u043a\u0430 \u0438,
    \u0447\u0442\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432\u0430\u0436\u043d\u043e,
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u043f\u0440\u0430\u0432\u0438\u043b\u043e
    \u0437\u043d\u0430\u043a\u043e\u0432 \u043f\u0440\u0438 \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0438
    (\u00ab\u043c\u0438\u043d\u0443\u0441 \u043d\u0430 \u043c\u0438\u043d\u0443\u0441 \u0434\u0430\u0451\u0442
    \u043f\u043b\u044e\u0441\u00bb). \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0438 \u0440\u0435\u0448\u0430\u0442\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f,
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0441\u043a\u043e\u0440\u0438\u0432
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f.\n\n\U0001F50D
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432 \u0430\u043d\u0430\u043b\u0438\u0437:
    \u043c\u0435\u0442\u043e\u0434 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u2014 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 (\u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0441 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438).
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434,
    \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442
    \u0441\u043e\u0431\u043e\u0439 \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0437\u0430\u0434\u0430\u0447,
    \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0439 \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u043d \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f. \u041e\u0434\u043d\u0430\u043a\u043e, \u0437\u0430
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u0440\u0438\u0435\u043c\u0430\u043c\u0438
    \u043f\u0440\u043e\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0431\u0449\u0438\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434. \u0421\u0443\u0442\u044c \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0432\u0438\u0434\u0430 `F(x, y) = 0` \u0431\u044b\u043b\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439:
    1. \u041d\u0443\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 \u043e\u0434\u043d\u043e
    \u0447\u0430\u0441\u0442\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    `(a, b)`. 2. \u0417\u0430\u0442\u0435\u043c \u0447\u0435\u0440\u0435\u0437 \u044d\u0442\u0443
    \u0442\u043e\u0447\u043a\u0443 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f
    \u043f\u0440\u044f\u043c\u0430\u044f \u0441 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0433\u043b\u043e\u0432\u044b\u043c \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u043e\u043c
    `k`. 3. \u041d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432\u0442\u043e\u0440\u0430\u044f
    \u0442\u043e\u0447\u043a\u0430 \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u044f
    \u044d\u0442\u043e\u0439 \u043f\u0440\u044f\u043c\u043e\u0439 \u0441 \u043a\u0440\u0438\u0432\u043e\u0439,
    \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0439 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435\u043c.
    \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0438 \u0442\u043e\u0447\u043a\u0430,
    \u0438 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b,
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b \u043d\u043e\u0432\u043e\u0439
    \u0442\u043e\u0447\u043a\u0438 \u0442\u0430\u043a\u0436\u0435 \u0431\u0443\u0434\u0443\u0442
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438. \u042d\u0442\u043e\u0442
    \u043c\u0435\u0442\u043e\u0434, \u043f\u043e \u0441\u0443\u0442\u0438, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043c\u043e\u0449\u043d\u044b\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u043d\u043e\u0432\u044b\u0445
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u0448\u0435\u043d\u0438\u0439
    \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e.
    \u041e\u043d \u043e\u043a\u0430\u0437\u0430\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e.\n\n\U0001F48E \u041d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u0447\u0438\u0441\u043b\u0430\u043c
    \u0414\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0447\u0438\u0441\u043b\u0430\u043c\u0438
    \u0431\u044b\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430. \u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u0436\u0435
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0435\u0449\u0435 \u043e\u0434\u043d\u0443
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e: \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0434\u0440\u043e\u0431\u0435\u0439 \u0447\u0438\u0441\u043b\u0430\u043c\u0438: \u041e\u043d
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430
    (\u0434\u0440\u043e\u0431\u0438) \u043d\u0430\u0440\u0430\u0432\u043d\u0435 \u0441 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0438\u0445 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0439.
    \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d: \u0425\u043e\u0442\u044f \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u0443 \u043d\u0435\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e,
    \u043e\u043d \u0432\u0432\u0435\u043b \u0441\u0438\u043c\u0432\u043e\u043b \u0434\u043b\u044f
    \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u044f \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439
    \u0441 \u0432\u044b\u0447\u0438\u0442\u0430\u0435\u043c\u044b\u043c\u0438 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430\u043c\u0438,
    \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u043f\u0435\u0440\u0438\u0440\u0443\u044f
    \u0438\u043c\u0438 \u0432 \u0441\u0432\u043e\u0438\u0445 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u0445.\n\n\U0001F30D
    \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443 \u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u0438 \u0437\u0430\u0431\u044b\u0442\u044b.
    \u0415\u0433\u043e \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb
    \u0441\u0442\u0430\u043b\u0430 \u043c\u043e\u0441\u0442\u043e\u043c, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u0437\u043d\u0430\u043d\u0438\u044f \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    \u043f\u0435\u0440\u0435\u0448\u043b\u0438 \u043a \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c (\u0432 X \u0432\u0435\u043a\u0435)
    \u0438 \u0437\u0430\u0442\u0435\u043c, \u0447\u0435\u0440\u0435\u0437 \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u0435
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b (\u0441\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u2014 \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u0411\u0430\u0448\u0435 \u0434\u0435
    \u041c\u0435\u0437\u0438\u0440\u0438\u0430\u043a\u0430 \u0432 1621 \u0433\u043e\u0434\u0443),
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0443. \u0420\u0430\u0431\u043e\u0442\u0430 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u0415\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u044b \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u043b\u0438
    \u0442\u0430\u043a\u0438\u0445 \u0433\u0438\u0433\u0430\u043d\u0442\u043e\u0432, \u043a\u0430\u043a
    \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442, \u041f\u044c\u0435\u0440
    \u0424\u0435\u0440\u043c\u0430 (\u0438\u043c\u0435\u043d\u043d\u043e \u043d\u0430 \u043f\u043e\u043b\u044f\u0445
    \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb \u0431\u044b\u043b\u0430
    \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430),
    \u041b\u0435\u043e\u043d\u0430\u0440\u0434 \u042d\u0439\u043b\u0435\u0440, \u041a\u0430\u0440\u043b
    \u042f\u043a\u043e\u0431\u0438 \u0438 \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435.
    \u0418\u0442\u043e\u0433\u043e\u0432\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 | \u0421\u0444\u0435\u0440\u0430
    \u0432\u043a\u043b\u0430\u0434\u0430 | \u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f | |:--- |:--- | | \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 | \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043f\u0435\u0440\u0432\u0443\u044e \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044b\u0445 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439
    \u0434\u043b\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445, \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439
    \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439, \u043f\u0435\u0440\u0435\u0439\u0434\u044f
    \u043e\u0442 \u0441\u043b\u043e\u0432\u0435\u0441\u043d\u043e\u0439 \u043a \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0439
    \u0437\u0430\u043f\u0438\u0441\u0438. | | \u041e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u043e\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 | \u041f\u0435\u0440\u0432\u044b\u043c
    \u0441\u0442\u0430\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0447\u0438\u0441\u0442\u044b\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b,
    \u043d\u0435 \u043f\u0440\u0438\u0431\u0435\u0433\u0430\u044f \u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f\u043c \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. | | \u041c\u0435\u0442\u043e\u0434
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f | \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043e\u0431\u0449\u0438\u0439 \u043f\u043e\u0434\u0445\u043e\u0434 (\u00ab\u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432
    \u0430\u043d\u0430\u043b\u0438\u0437\u00bb) \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. | | \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b | \u0424\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u043d\u043e\u0432\u044b\u0439 \u0440\u0430\u0437\u0434\u0435\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u0432 \u0446\u0435\u043d\u0442\u0440 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0432 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u043b\u0430\u0445.
    \u0415\u0433\u043e \u0438\u043c\u044f \u043d\u043e\u0441\u0438\u0442 \u043a\u043b\u0430\u0441\u0441
    \u0437\u0430\u0434\u0430\u0447 \u2014 \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. | | \u041d\u043e\u0432\u043e\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0447\u0438\u0441\u043b\u0430 | \u0423\u0440\u0430\u0432\u043d\u044f\u043b
    \u0432 \u043f\u0440\u0430\u0432\u0430\u0445 \u0434\u0440\u043e\u0431\u0438 \u0438 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430, \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u0432 \u0438\u0445
    \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0439,
    \u0438 \u043d\u0430\u0447\u0430\u043b \u043e\u043f\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430\u043c\u0438.
    | \u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0430\u043b \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u2014 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439
    \u044f\u0437\u044b\u043a \u0438 \u043c\u0435\u0442\u043e\u0434, \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0438\u0437 \u043d\u0430\u0431\u043e\u0440\u0430
    \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0432 \u0432 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0438 \u043f\u043e\u043b\u043d\u0443\u044e \u0441\u043c\u044b\u0441\u043b\u0430 \u043d\u0430\u0443\u043a\u0443."
  achievementsEn: "The Diofant of Alexandria has made a number of fundamental breakthroughs that for centuries have defined the development of mathematics, and its key achievements lie in the creation of algebraic language, a new method of solving equations, and in the very approach to numbers.\n\nThe release of algebra from the geometry of Greek mathematician to Diofant was closely linked to geometry: the tasks were done by drawing and geometric constructions, even if they were algebraic in nature. The Diofant changed this approach fundamentally. He was the first antiquated scientist to systematically use purely algebraic methods without using geometric interpretation to prove and solve.This was a huge step forward by placing algebra in a stand-alone field of mathematics and making it a more flexible and powerful tool to meet challenges.\n\nThe creation of the first algebraic language prior to Diofant was all written in words, so called rhetorical algebra. This made the records cumbersome and uncomfortable for complex operations. The Diofant proposed a synced algebra, a system of abbreviated symbols that preceded modern mathematical symbols.He introduced special signs for the unknown and its degrees up to the sixth ( &lt; ~ &gt; for the square, &gt; ~ for the cube, etc.).Moreover, he described the rules of action with these symbols: he introduced rules for bringing such members, moving members from one part of the equation to another with a change of sign, and, most importantly, he formulated the rule of signs in multiplying (\"minus per minus plus\"). This allowed for compact recording and resolution of complex equations, greatly accelerating the process of thinking.\n\nThe analysis of the Diophants: the method of solving the uncertain equations The main contribution of the Dioffent is to develop a method for finding rational positive solutions to the uncertain equations (according to several unknowns). Its main work, Arifmetica, is a set of tasks for which it demonstrates the original solution method for each of them. However, there is a common approach behind the individual approaches.The essence of its method to solve equations of species `F(x, y) = 0' was as follows: 1. One private solution needs to be found, e.g. `a, b)'. 2. Then the point is taken straight with the rational angular coefficient `k'. 3. A second intersection point of this line with the curve given by the equation is found. Because both the point and the rational coefficient are also rational, the coordinates of the new point will be rational.This method is essentially a powerful tool for generating new rational solutions based on one known, and it has had a huge impact on the mathematicians of the future.\n\nThe innovation of numbers for most ancient Greek mathematicians was only natural numbers, but the Diofant has made another revolution: the recognition of fractions: He was the first Greek scientist to consider positive rational numbers (droby) on an equal basis with natural numbers and to actively use them as solutions.Use of negative values: Although he did not have a final concept of negative number, he introduced a symbol to subtract and formulated rules of operations with subtractable values, actually operating on them in his calculations.\n\nThe benefits of Diofant's world science were not forgotten. His \"Arifmetics\" became a bridge where knowledge of antiquity passed to Arab mathematicians (in the Xth century) and then through Latin translations (the most famous edition of Bash de Meziriac in 1621) to Europe.His methods inspired giants such as François Veet, Pierre Ferma (named \"Arifmetics\" fields by the famous Great Theorem), Leonard Eyler, Carl Jacoby and Henri Poancare. The resulting contribution . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . developed the first-his history system of reduced designations for unknowns, degrees and actions, from verbal to compact.The exemption from geometry has begun to systematically apply pure algebraic methods without using geometrical constructs to solve equations. ♪ The solution method ♪ has developed a common approach (\"diofant analysis\") to find positive rational solutions to uncertain equations. ♪ The number theory ♪ has actually established a new section of mathematics, putting the solution of equations in rational numbers at the centre of research.His name is a class of tasks, diofents of the equation. ♪ New concept of number ♪ equalized the rights of fractions and natural numbers by allowing them as solutions, and began to operate with negative figures. ♪ Diofant didn't just solve certain problems, he created a new language and method, turning algebra from a set of recipes to a self-contained and meaningful science."
  personalLifeRu: "\u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u0440\u043e\u0432\u043d\u043e
    \u043d\u0438\u0447\u0435\u0433\u043e, \u043a\u0440\u043e\u043c\u0435 \u0447\u0438\u0441\u0435\u043b,
    \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0432 \u0435\u0433\u043e
    \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u0438. \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e\u0448\u043b\u0438 \u0434\u043e \u043d\u0430\u0441
    \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0443\u0434\u044b, \u0431\u044b\u0442\u043e\u0432\u0430\u044f
    \u0438 \u043b\u0438\u0447\u043d\u0430\u044f \u0441\u0442\u043e\u0440\u043e\u043d\u0430 \u0436\u0438\u0437\u043d\u0438
    \u044d\u0442\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043a\u0440\u044b\u0442\u0430
    \u0432\u043e \u043c\u0440\u0430\u043a\u0435 \u0432\u0435\u043a\u043e\u0432. \u0423 \u043d\u0430\u0441
    \u043d\u0435\u0442 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0438\u0441\u044c\u043c\u0430,
    \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u043d\u0438
    \u043e\u0434\u043d\u043e\u0433\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f
    \u043e \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0435, \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u0445
    \u0438\u043b\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0435 \u0432\u043d\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430. \u0412\u0441\u0435, \u0447\u0442\u043e
    \u043c\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043c\u043e\u0436\u0435\u043c \u00ab\u0437\u043d\u0430\u0442\u044c\u00bb
    \u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u2014 \u044d\u0442\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438-\u044d\u043f\u0438\u0442\u0430\u0444\u0438\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0434\u0430\u0436\u0435 \u0437\u0434\u0435\u0441\u044c
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f
    \u043a \u044d\u0442\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e.
    --- 1. \u042d\u043f\u0438\u0442\u0430\u0444\u0438\u044f-\u0437\u0430\u0434\u0430\u0447\u0430:
    \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u00ab\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u00bb
    \u0412 \u00ab\u041f\u0430\u043b\u0430\u0442\u0438\u043d\u0441\u043a\u043e\u0439 \u0430\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0438\u00bb
    (\u0441\u0431\u043e\u0440\u043d\u0438\u043a\u0435 \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0445
    \u044d\u043f\u0438\u0433\u0440\u0430\u043c\u043c, \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u043c
    \u043e\u043a\u043e\u043b\u043e 500 \u0433\u043e\u0434\u0430 \u043d. \u044d.) \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f
    \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f, \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u043b\u043e\u0441\u044c,
    \u0431\u044b\u043b\u0430 \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430 \u043d\u0430 \u043c\u043e\u0433\u0438\u043b\u044c\u043d\u043e\u043c
    \u043a\u0430\u043c\u043d\u0435 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430: > \u00ab\u041f\u0440\u0430\u0445
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0433\u0440\u043e\u0431\u043d\u0438\u0446\u0430
    \u043f\u043e\u043a\u043e\u0438\u0442; \u0434\u0438\u0432\u0438\u0441\u044c \u0435\u0439
    \u2014 \u0438 \u043a\u0430\u043c\u0435\u043d\u044c > \u041c\u0443\u0434\u0440\u044b\u043c
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c \u0435\u0433\u043e \u0441\u043a\u0430\u0436\u0435\u0442
    \u0443\u0441\u043e\u043f\u0448\u0435\u0433\u043e \u0432\u0435\u043a. > \u0412\u043e\u043b\u0435\u0439
    \u0431\u043e\u0433\u043e\u0432 \u0448\u0435\u0441\u0442\u0443\u044e \u0447\u0430\u0441\u0442\u044c
    \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b \u0440\u0435\u0431\u0451\u043d\u043a\u043e\u043c.
    > \u0418 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443 \u0448\u0435\u0441\u0442\u043e\u0439
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b \u0441 \u043f\u0443\u0448\u043a\u043e\u043c
    \u043d\u0430 \u0449\u0435\u043a\u0430\u0445. > \u0422\u043e\u043b\u044c\u043a\u043e \u043c\u0438\u043d\u0443\u043b\u0430
    \u0441\u0435\u0434\u044c\u043c\u0430\u044f, \u0441 \u043f\u043e\u0434\u0440\u0443\u0433\u043e\u0439
    \u043e\u043d \u043e\u0431\u0440\u0443\u0447\u0438\u043b\u0441\u044f. > \u0421 \u043d\u0435\u044e,
    \u043f\u044f\u0442\u044c \u043b\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u0434\u044f,
    \u0441\u044b\u043d\u0430 \u0434\u043e\u0436\u0434\u0430\u043b\u0441\u044f \u043c\u0443\u0434\u0440\u0435\u0446;
    > \u0422\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043b\u0436\u0438\u0437\u043d\u0438
    \u043e\u0442\u0446\u043e\u0432\u0441\u043a\u043e\u0439 \u0432\u043e\u0437\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u0439
    \u0441\u044b\u043d \u0435\u0433\u043e \u043f\u0440\u043e\u0436\u0438\u043b. > \u041e\u0442\u043d\u044f\u0442
    \u043e\u043d \u0431\u044b\u043b \u0443 \u043e\u0442\u0446\u0430 \u0440\u0430\u043d\u043d\u0435\u0439
    \u043c\u043e\u0433\u0438\u043b\u043e\u0439 \u0441\u0432\u043e\u0435\u0439. > \u0414\u0432\u0430\u0436\u0434\u044b
    \u0434\u0432\u0430 \u0433\u043e\u0434\u0430 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044c
    \u043e\u043f\u043b\u0430\u043a\u0438\u0432\u0430\u043b \u0442\u044f\u0436\u043a\u043e\u0435
    \u0433\u043e\u0440\u0435, > \u0422\u0443\u0442 \u0438 \u0443\u0432\u0438\u0434\u0435\u043b
    \u043f\u0440\u0435\u0434\u0435\u043b \u0436\u0438\u0437\u043d\u0438 \u043f\u0435\u0447\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0432\u043e\u0435\u0439\u00bb. --- 2. \u0420\u0435\u0448\u0435\u043d\u0438\u0435
    \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u0438: \u0425\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f
    \u0436\u0438\u0437\u043d\u0438 \u0415\u0441\u043b\u0438 \u0440\u0435\u0448\u0438\u0442\u044c
    \u044d\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435, \u0441\u043b\u043e\u0436\u0438\u0432
    \u0432\u0441\u0435 \u0447\u0430\u0441\u0442\u0438 \u0436\u0438\u0437\u043d\u0438 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430,
    \u043c\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c, \u0447\u0442\u043e \u043e\u043d
    \u043f\u0440\u043e\u0436\u0438\u043b 84 \u0433\u043e\u0434\u0430. \u0418\u0441\u0445\u043e\u0434\u044f
    \u0438\u0437 \u044d\u0442\u043e\u0433\u043e, \u043c\u044b \u043c\u043e\u0436\u0435\u043c
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e
    \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044e \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u043c\u043e\u0439
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438: \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    (0\u201314 \u043b\u0435\u0442): \u041f\u0435\u0440\u0432\u0443\u044e \u0448\u0435\u0441\u0442\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438 (84 / 6 = 14 \u043b\u0435\u0442)
    \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c.
    \u042e\u043d\u043e\u0441\u0442\u044c (14\u201321 \u0433\u043e\u0434): \u0415\u0449\u0435
    \u043e\u0434\u043d\u0443 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438 (84 / 12 = 7 \u043b\u0435\u0442)
    \u043e\u043d \u0431\u044b\u043b \u044e\u043d\u043e\u0448\u0435\u0439, \u0438 \u0438\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u00ab\u043f\u0443\u0448\u043e\u043a\u00bb
    \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u043d\u0430 \u0435\u0433\u043e \u0449\u0435\u043a\u0430\u0445
    (\u0442\u043e \u0435\u0441\u0442\u044c \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b\u043e
    \u043f\u043e\u043b\u043e\u0432\u043e\u0435 \u0441\u043e\u0437\u0440\u0435\u0432\u0430\u043d\u0438\u0435).
    \u041a 21 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c
    \u043c\u0443\u0436\u0447\u0438\u043d\u043e\u0439. \u041e\u0431\u0440\u0443\u0447\u0435\u043d\u0438\u0435
    (\u0432 33 \u0433\u043e\u0434\u0430): \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f
    \u0441\u0435\u0434\u044c\u043c\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438
    (84 / 7 = 12 \u043b\u0435\u0442) \u043f\u0440\u043e\u0448\u043b\u0430 \u0434\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430
    \u043e\u0431\u0440\u0443\u0447\u0435\u043d\u0438\u044f. 21 + 12 = 33 \u0433\u043e\u0434\u0430.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    (\u043f\u043e \u043c\u0435\u0440\u043a\u0430\u043c \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    \u2014 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u043f\u043e\u0437\u0434\u043d\u043e)
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u043e\u0431\u0440\u0443\u0447\u0438\u043b\u0441\u044f
    \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u00ab\u043f\u043e\u0434\u0440\u0443\u0433\u043e\u0439\u00bb
    (\u0436\u0435\u043d\u043e\u0439). \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u044b\u043d\u0430
    (\u0432 38 \u043b\u0435\u0442): \u041f\u043e\u0441\u043b\u0435 \u043e\u0431\u0440\u0443\u0447\u0435\u043d\u0438\u044f
    \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b \u0441 \u0436\u0435\u043d\u043e\u0439
    5 \u043b\u0435\u0442, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0443 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0441\u044b\u043d. 33 + 5 = 38 \u043b\u0435\u0442.
    \u0421\u043c\u0435\u0440\u0442\u044c \u0441\u044b\u043d\u0430 (\u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0443
    80 \u043b\u0435\u0442): \u0421\u044b\u043d \u043f\u0440\u043e\u0436\u0438\u043b \u0440\u043e\u0432\u043d\u043e
    \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443 \u0436\u0438\u0437\u043d\u0438 \u043e\u0442\u0446\u0430
    (84 / 2 = 42 \u0433\u043e\u0434\u0430). \u0417\u043d\u0430\u0447\u0438\u0442, \u0441\u044b\u043d
    \u0443\u043c\u0435\u0440, \u043a\u043e\u0433\u0434\u0430 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0443
    \u0431\u044b\u043b\u043e 38 + 42 = 80 \u043b\u0435\u0442. \u0421\u043c\u0435\u0440\u0442\u044c
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 (\u0432 84 \u0433\u043e\u0434\u0430): \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0441\u044b\u043d\u0430 \u0414\u0438\u043e\u0444\u0430\u043d\u0442
    \u043e\u043f\u043b\u0430\u043a\u0438\u0432\u0430\u043b \u0435\u0433\u043e \u0440\u043e\u0432\u043d\u043e
    4 \u0433\u043e\u0434\u0430 (\u0434\u0432\u0430\u0436\u0434\u044b \u0434\u0432\u0430) \u0438
    \u0443\u043c\u0435\u0440 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 80 + 4
    = 84 \u0433\u043e\u0434\u0430. --- 3. \u041d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0432\u0435\u0440\u044f\u0442\u044c \u044d\u0442\u043e\u0439
    \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u0438? \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043a\u0440\u0430\u0441\u043e\u0442\u0443 \u044d\u0442\u043e\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0438,
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u0438 \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438
    \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a \u043d\u0435\u0439 \u043a\u0430\u043a
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u0443, \u0430 \u043d\u0435 \u043a \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0444\u0430\u043a\u0442\u0443 \u043f\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c
    \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c: 1. \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439: \u041d\u0435\u0442
    \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0431\u044b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u0438, \u0447\u0442\u043e
    \u044d\u0442\u0430 \u043d\u0430\u0434\u043f\u0438\u0441\u044c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u043d\u0430 \u043c\u043e\u0433\u0438\u043b\u0435
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438.
    \u0412\u043f\u0435\u0440\u0432\u044b\u0435 \u043e\u043d\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0437 200 \u0441 \u043b\u0438\u0448\u043d\u0438\u043c
    \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u043c\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438. 2. \u0421\u043b\u0438\u0448\u043a\u043e\u043c \u00ab\u043a\u0440\u0443\u0433\u043b\u044b\u0435\u00bb
    \u0447\u0438\u0441\u043b\u0430: \u0412\u043e\u0437\u0440\u0430\u0441\u0442 84 \u0433\u043e\u0434\u0430,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432\u0441\u0435 \u044d\u0442\u0430\u043f\u044b
    (14, 7, 12, 5, 42, 4 \u0433\u043e\u0434\u0430) \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u043d\u044b
    \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e
    \u0440\u0435\u0448\u0438\u0442\u044c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435.
    \u0412 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0434\u0430\u0442\u044b
    \u0432\u0440\u044f\u0434 \u043b\u0438 \u0431\u044b\u043b\u0438 \u0431\u044b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043a\u0440\u0430\u0442\u043d\u044b \u0448\u0435\u0441\u0442\u0438, \u0441\u0435\u043c\u0438
    \u0438 \u0434\u0432\u043e\u0439\u043a\u0435. \u0421\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e,
    \u044d\u0442\u043e \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u0430\u044f
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u0433\u0440\u0430, \u0433\u0434\u0435 \u00ab\u0448\u0435\u0441\u0442\u0430\u044f
    \u0447\u0430\u0441\u0442\u044c\u00bb, \u00ab\u0441\u0435\u0434\u044c\u043c\u0430\u044f \u0447\u0430\u0441\u0442\u044c\u00bb
    \u0438 \u00ab\u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0430\u00bb \u0431\u044b\u043b\u0438
    \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u0434\u043b\u044f \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438, \u0430 \u0436\u0438\u0437\u043d\u044c \u0441\u0430\u043c\u043e\u0433\u043e
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e
    \u00ab\u043f\u043e\u0434\u043e\u0433\u043d\u0430\u043d\u0430\u00bb \u043f\u043e\u0434 \u044d\u0442\u0438
    \u0446\u0438\u0444\u0440\u044b. 3. \u041d\u0435\u0442 \u0438\u043c\u0435\u043d: \u0412 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u0438
    \u043d\u0435\u0442 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u043c\u0435\u043d\u0438.
    \u041d\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u0436\u0435\u043d\u0430, \u043d\u0435
    \u043d\u0430\u0437\u0432\u0430\u043d \u0441\u044b\u043d. \u041c\u044b \u0434\u0430\u0436\u0435
    \u043d\u0435 \u0437\u043d\u0430\u0435\u043c, \u043a\u0430\u043a \u0437\u0432\u0430\u043b\u0438
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u0438\u043b\u0438 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432.
    --- 4. \u0415\u0441\u0442\u044c \u043b\u0438 \u0435\u0449\u0435 \u043a\u0430\u043a\u0438\u0435-\u043b\u0438\u0431\u043e
    \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f? \u0410\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u043d\u0438\u043a\u0430\u043a\u0438\u0445. - \u041c\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u043c,
    \u0431\u044b\u043b\u0430 \u043b\u0438 \u0443 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u044f (\u043a\u0440\u043e\u043c\u0435 \u0437\u0430\u043d\u044f\u0442\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439) \u0438\u043b\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435.
    - \u041c\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u043c, \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043b\u0438 \u043e\u043d \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438.
    - \u041c\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u043c, \u0431\u044b\u043b \u043b\u0438
    \u043e\u043d \u0436\u0435\u043d\u0430\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u0438\u043d
    \u0440\u0430\u0437 \u0438\u043b\u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0435\u0433\u043e \u00ab\u043f\u043e\u0434\u0440\u0443\u0433\u0430\u00bb \u0432 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u0438
    \u2014 \u044d\u0442\u043e \u043b\u0438\u0448\u044c \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0439
    \u043e\u0431\u043e\u0440\u043e\u0442, \u0430 \u043d\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u0430\u044f
    \u0441\u0443\u043f\u0440\u0443\u0433\u0430. - \u041c\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u043c,
    \u0431\u044b\u043b\u0438 \u043b\u0438 \u0443 \u043d\u0435\u0433\u043e \u0434\u0440\u0443\u0433\u0438\u0435
    \u0434\u0435\u0442\u0438, \u043a\u0440\u043e\u043c\u0435 \u0443\u043c\u0435\u0440\u0448\u0435\u0433\u043e
    \u0441\u044b\u043d\u0430. - \u041c\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u043c, \u043a\u0430\u043a
    \u043e\u043d \u0432\u044b\u0433\u043b\u044f\u0434\u0435\u043b, \u0447\u0435\u043c \u043f\u0438\u0442\u0430\u043b\u0441\u044f,
    \u0431\u043e\u043b\u0435\u043b \u043b\u0438 \u043e\u043d \u0438 \u043a\u0430\u043a \u0438\u043c\u0435\u043d\u043d\u043e
    \u0443\u043c\u0435\u0440. --- \u0418\u0442\u043e\u0433 \u0415\u0441\u043b\u0438 \u043f\u043e\u0434\u0432\u043e\u0434\u0438\u0442\u044c
    \u0447\u0435\u0440\u0442\u0443, \u0442\u043e \u0432\u0441\u044f \u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0443\u043c\u0435\u0449\u0430\u0435\u0442\u0441\u044f
    \u0432 \u043e\u0434\u043d\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435: \u00ab\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u0432 33 \u0433\u043e\u0434\u0430, \u0432 38 \u043b\u0435\u0442 \u0441\u0442\u0430\u043b
    \u043e\u0442\u0446\u043e\u043c, \u0432 80 \u043b\u0435\u0442 \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u0441\u044b\u043d\u0430 \u0438 \u0443\u043c\u0435\u0440 \u0432 84 \u0433\u043e\u0434\u0430,
    \u043e\u043f\u043b\u0430\u043a\u0438\u0432\u0430\u044f \u0435\u0433\u043e\u00bb. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0434\u0430\u0436\u0435 \u044d\u0442\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f
    \u2014 \u043d\u0435 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0442, \u0430 \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430,
    \u043f\u0440\u0438\u043f\u0438\u0441\u0430\u043d\u043d\u0430\u044f \u0435\u043c\u0443 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c\u0438
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\u043c\u0438. \u0412 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043c\u044b \u0438\u043c\u0435\u0435\u043c \u0434\u0435\u043b\u043e \u0441 \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0443\u043c\u043e\u0432
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438, \u043e \u0447\u0430\u0441\u0442\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043c\u044b
    \u043d\u0435 \u0437\u043d\u0430\u0435\u043c \u0440\u043e\u0432\u043d\u044b\u043c \u0441\u0447\u0435\u0442\u043e\u043c
    \u043d\u0438\u0447\u0435\u0433\u043e. \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430
    \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u0435\u0433\u043e \u0444\u0438\u0433\u0443\u0440\u0443
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043c\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0439."
  personalLifeEn: "Unfortunately, the personal life of Dyofant of Alexandria is unknown, except for the numbers encrypted in his epitacy, unlike his scientific achievements, which have reached us through labor, the domestic and personal aspects of this mathematician's life are completely hidden in the darkness of the ages, and we have no letters, no evidence of contemporarys, no mention of his family, habits, or nature outside the mathematical context.All we can \"know\" about his personal life today is the result of the mathematical task of epitaphia, but even here, historians are very careful about this information. -- 1.Epitafia-Tax: The only \"document\" in the \"Palatinate Anthology\" (the collection of ancient Greek epigrams from about 500 CE) contains the following task, which was thought to have been planted on the gravestone of Diofant: > \"The Pray of Diofant the Tomb; Be surprised by it — and the stone > The wisdom of art will tell it by the dead century. > The will of the gods for the sixth part of his life he lived as a child. > And half sixth met with a cannon on the cheeks.> Only passed the seventh, he was engaged to his friend. > With her, having spent five years, the son was waiting for the wise man; > Only half of his father's beloved son lived. > He was taken from his father by his early grave. > Twice two years a parent mourned a terrible grief, > This and saw the limit of his sad life.\" -- 2. The decision of Epitaphy: The chronology of life If this equation is resolved, folding all parts of Diofant's life, we get that he lived 84 years.From this perspective, we can restore the following timeline of his expected personal life: Childhood (0-14 years old): The first sixth of his life (84 / 6 = 14 years old) he lived as a child. Youth (14 - 21 years): Another twelfth of his life (84 / 12 = 7) he was a boy, and it was during this period that the \"blank\" appeared on his cheeks (i.e. puberty). By the age of 21, he had become an adult man.Betrothal (33 years): The next seventh part of life (84 / 7 = 12 years) passed until the time of engagement. 21 + 12 = 33 years. It was at that age (by antiquity, rather late) that Diofant engaged his \"friend\" (wife). The birth of his son (38 years old): After the engagement, he lived with his wife for five years before their son was born. 33 + 5 = 38 years. The death of his son (80 years old Diofant): The son lived exactly half of his father's life (84 / 2 = 42 years).So the son died when Diofant was 38 + 42 = 80. Diofant's death (84 years old): After the death of his son, Diofant mourned him exactly four years (two times two) and died at the age of 80 + 4 = 84. -- 3. How can you trust this epitherapy? Despite the beauty of this story, historians and philologists treat her as a mathematical anecdote, not as a documentary fact for several reasons: 1.No confirmation: There are no other ancient sources that confirm that this inscription was actually on the Diofant's grave in Alexandria. It appears for the first time only more than 200 years after his alleged death. 2. Too round numbers: age 84, as well as all stages (14, 7, 12, 5, 42, 4) are designed to perfect the equation.In real life, the dates are unlikely to be so many times six, seven and two. It is probably a literary and mathematical game, where \"sixth part\", \"seventh part\" and \"half\" were chosen specifically to formulate a beautiful task, and the life of the Diofant himself was simply \"like\" to these figures. 3. No names: There are no names in the Epitaphya. There is no wife, no son. We don't even know what the parents of the Dioffant or his students were called. -------------------------------------------------------------------------------------------------------------------------------------------------We don't know if he was only married once or maybe his \"friend\" in the epithephia was just a literary turnover, not a real spouse.- We don't know what he looked like, what he was eating, whether he was sick or how he died. - The result is that if you draw a line, the whole of Diofant's personal life fits into one single sentence: \"A legend says, he married at age 33, at age 38, became a father, at age 80, lost his son and died at age 84, mourning him.\" But even this information is not a biographical fact, it's just a mathematical puzzle attributed to him by successive generations.In reality, we are dealing with one of the greatest minds of antiquity, whose private life we know nothing about, which is the mystery that makes it almost mythical."
  shortBioRu: "\u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0438\u0439
    (\u043e\u043a. III \u0432\u0435\u043a\u0430 \u043d. \u044d.) \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438, \u0447\u044c\u0438 \u0438\u0434\u0435\u0438
    \u043d\u0430 \u0432\u0435\u043a\u0430 \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0441\u0432\u043e\u0451 \u0432\u0440\u0435\u043c\u044f. \u0415\u0433\u043e \u0447\u0430\u0441\u0442\u043e
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u00ab\u043e\u0442\u0446\u043e\u043c \u0430\u043b\u0433\u0435\u0431\u0440\u044b\u00bb;
    \u043e\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043f\u0440\u0435\u0436\u0434\u0435
    \u0432\u0441\u0435\u0433\u043e \u043a\u0430\u043a \u0430\u0432\u0442\u043e\u0440 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb./n/n\u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442, \u043e \u0441\u0430\u043c\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043a\u0440\u0430\u0439\u043d\u0435 \u043c\u0430\u043b\u043e \u2014 \u043e\u043d\u0430
    \u043e\u043a\u0443\u0442\u0430\u043d\u0430 \u0442\u0430\u0439\u043d\u0430\u043c\u0438 \u0438
    \u0434\u043e\u043c\u044b\u0441\u043b\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442
    \u0441\u043f\u043e\u0440\u044b \u0441\u0440\u0435\u0434\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432
    \u043d\u0430\u0443\u043a\u0438./n/n\u041a\u043e\u0433\u0434\u0430 \u0438 \u0433\u0434\u0435
    \u0436\u0438\u043b \u0414\u0438\u043e\u0444\u0430\u043d\u0442?/n/n\u0414\u043e\u043f\u043e\u0434\u043b\u0438\u043d\u043d\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043b\u0438\u0448\u044c \u0442\u043e,
    \u0447\u0442\u043e \u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u0436\u0438\u043b \u0438
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438
    \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439. \u042d\u0442\u043e \u0431\u044b\u043b
    \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0446\u0435\u043d\u0442\u0440 \u044d\u043b\u043b\u0438\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430, \u0433\u0434\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0430\u044f
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430. \u042d\u0442\u043e \u043c\u0435\u0441\u0442\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u0432\u043e \u0432\u0441\u0435\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445./n/n\u0422\u043e\u0447\u043d\u044b\u0435
    \u0434\u0430\u0442\u044b \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0438 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u2014 \u043f\u0440\u0435\u0434\u043c\u0435\u0442
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439 \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0438.
    \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c
    \u043b\u0438\u0448\u044c \u00ab\u0432\u0438\u043b\u043a\u0443\u00bb \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 500 \u043b\u0435\u0442:/n/n \u041d\u0438\u0436\u043d\u044f\u044f \u0433\u0440\u0430\u043d\u0438\u0446\u0430:
    \u0432 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u00ab\u041e \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445\u00bb \u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u0441\u0441\u044b\u043b\u0430\u0435\u0442\u0441\u044f
    \u043d\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0413\u0438\u043f\u0441\u0438\u043a\u043b\u0430, \u0436\u0438\u0432\u0448\u0435\u0433\u043e
    \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435 II \u0432\u0435\u043a\u0430 \u0434\u043e
    \u043d. \u044d. \u0417\u043d\u0430\u0447\u0438\u0442, \u0414\u0438\u043e\u0444\u0430\u043d\u0442
    \u0436\u0438\u043b \u043f\u043e\u0437\u0436\u0435./n \u0412\u0435\u0440\u0445\u043d\u044f\u044f
    \u0433\u0440\u0430\u043d\u0438\u0446\u0430: \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0422\u0435\u043e\u043d \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0438\u0439
    (\u043e\u0442\u0435\u0446 \u0413\u0438\u043f\u0430\u0442\u0438\u0438), \u0436\u0438\u0432\u0448\u0438\u0439
    \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435 IV \u0432\u0435\u043a\u0430 \u043d.
    \u044d., \u0446\u0438\u0442\u0438\u0440\u0443\u0435\u0442 \u043e\u0442\u0440\u044b\u0432\u043a\u0438
    \u0438\u0437 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb. \u0417\u043d\u0430\u0447\u0438\u0442,
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u0436\u0438\u043b \u0440\u0430\u043d\u044c\u0448\u0435./n/n\u0414\u043e\u043b\u0433\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432 \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u043e
    \u0436\u0438\u0437\u043d\u044c \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u043a \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435
    III \u0432\u0435\u043a\u0430 \u043d. \u044d. (\u043e\u043a. 250 \u0433.). \u042d\u0442\u043e\u0442
    \u0432\u044b\u0432\u043e\u0434 \u043e\u043f\u0438\u0440\u0430\u043b\u0441\u044f \u043d\u0430
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0447\u0442\u043e
    \u0443\u043f\u043e\u043c\u044f\u043d\u0443\u0442\u044b\u0439 \u0432 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0438\u0438
    \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb \u00ab\u0434\u043e\u0441\u0442\u043e\u043f\u043e\u0447\u0442\u0435\u043d\u043d\u044b\u0439
    \u0414\u0438\u043e\u043d\u0438\u0441\u0438\u0439\u00bb \u2014 \u044d\u0442\u043e \u0435\u043f\u0438\u0441\u043a\u043e\u043f
    \u0414\u0438\u043e\u043d\u0438\u0441\u0438\u0439 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0438\u0439,
    \u0436\u0438\u0432\u0448\u0438\u0439 \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u043e\u0433\u0434\u0430./n/n\u041e\u0434\u043d\u0430\u043a\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0423. \u041a\u043d\u043e\u0440\u0440\u0430, \u0441\u0442\u0430\u0432\u044f\u0442 \u044d\u0442\u0443
    \u0434\u0430\u0442\u0438\u0440\u043e\u0432\u043a\u0443 \u043f\u043e\u0434 \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u0435:
    \u0435\u0441\u0442\u044c \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043b\u0430\u0433\u0430\u0442\u044c,
    \u0447\u0442\u043e \u0414\u0438\u043e\u0444\u0430\u043d\u0442 \u043c\u043e\u0433 \u0436\u0438\u0442\u044c
    \u0440\u0430\u043d\u044c\u0448\u0435, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0434\u0430\u0436\u0435
    \u0432 I \u0432\u0435\u043a\u0435 \u043d. \u044d. \u0420\u0430\u0437\u0431\u0440\u043e\u0441
    \u0434\u0430\u0442 \u0432 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f\u0445
    \u043e\u0447\u0435\u043d\u044c \u0432\u0435\u043b\u0438\u043a: \u043e\u0442 \u043e\u043a.
    200 \u0433. \u0434\u043e 409 \u0433. \u043d. \u044d./n/n\u042d\u043f\u0438\u0442\u0430\u0444\u0438\u044f
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430/n/n\u041f\u043e\u0447\u0442\u0438 \u0432\u0441\u0451,
    \u0447\u0442\u043e \u00ab\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u00bb \u043e \u043b\u0438\u0447\u043d\u043e\u0439
