    \u0437\u0430\u0434\u0430\u0447\u0430, \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043d\u043d\u0430\u044f
    \u043f\u043e\u0437\u0436\u0435. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435,
    \u043e\u043d\u0430 \u0434\u0430\u0451\u0442 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435
    \u0446\u0438\u0444\u0440\u044b:/n/n\u00ab\u041f\u0440\u0430\u0445 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u0433\u0440\u043e\u0431\u043d\u0438\u0446\u0430 \u043f\u043e\u043a\u043e\u0438\u0442; \u0434\u0438\u0432\u0438\u0441\u044c
