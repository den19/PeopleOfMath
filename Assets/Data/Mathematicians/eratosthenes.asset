  fullNameRu: "\u042D\u0440\u0430\u0442\u043E\u0441\u0444\u0435\u0301\u043D \u041A\u0438\u0440\u0435\u0301\u043D\u0441\u043A\u0438\u0439"
  fullNameEn: Eratosthenes of Cyrene
