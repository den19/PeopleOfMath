    \u0432 \u043f\u043e\u043b\u0434\u0435\u043d\u044c \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u0421\u0438\u0435\u043d\u0430 (\u043d\u044b\u043d\u0435 \u0410\u0441\u0443\u0430\u043d)
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0435 \u043b\u0443\u0447\u0438 \u043f\u0430\u0434\u0430\u044e\u0442
    \u043e\u0442\u0432\u0435\u0441\u043d\u043e \u0438 \u043e\u0441\u0432\u0435\u0449\u0430\u044e\u0442
    \u0434\u043d\u043e \u0441\u0430\u043c\u044b\u0445 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445
    \u043a\u043e\u043b\u043e\u0434\u0446\u0435\u0432. \u0412 \u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u043d\u0430 \u043e\u0434\u043d\u043e\u043c
    \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d\u0435, \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0435
    \u0447\u0430\u0441\u044b \u043e\u0442\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u044e\u0442
    \u0442\u0435\u043d\u044c. \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0438\u0437\u043c\u0435\u0440\u0438\u043b
    \u044d\u0442\u0443 \u0442\u0435\u043d\u044c \u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b,
    \u0447\u0442\u043e \u0443\u0433\u043e\u043b \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445
    \u043b\u0443\u0447\u0435\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442
    7\u00b012', \u0447\u0442\u043e \u0440\u043e\u0432\u043d\u043e \u0432 50 \u0440\u0430\u0437
    \u043c\u0435\u043d\u044c\u0448\u0435 \u043f\u043e\u043b\u043d\u043e\u0439 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438
    \u0432 360\u00b0. \u041f\u0440\u0438\u043d\u044f\u0432 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435
    \u043c\u0435\u0436\u0434\u0443 \u0421\u0438\u0435\u043d\u043e\u0439 \u0438 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0435\u0439
    \u0437\u0430 5000 \u0441\u0442\u0430\u0434\u0438\u0435\u0432 (\u043f\u043e \u0434\u0430\u043d\u043d\u044b\u043c
    \u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0445 \u0437\u0435\u043c\u043b\u0435\u043c\u0435\u0440\u043e\u0432),
    \u043e\u043d \u043b\u0435\u0433\u043a\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b
    \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u044c \u0417\u0435\u043c\u043b\u0438:
    5000 50 = 250 000 \u0441\u0442\u0430\u0434\u0438\u0435\u0432. \u0422\u043e\u0447\u043d\u043e\u0441\u0442\u044c
    \u044d\u0442\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442
    \u0441\u043f\u043e\u0440\u044b, \u0442\u0430\u043a \u043a\u0430\u043a \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u043a\u0430\u043a\u0438\u043c \u0438\u043c\u0435\u043d\u043d\u043e \u0441\u0442\u0430\u0434\u0438\u0435\u043c
    \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u0443\u0447\u0451\u043d\u044b\u0439.
    \u0415\u0441\u043b\u0438 \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0439 \u0441\u0442\u0430\u0434\u0438\u0439
    (\u043e\u043a. 157,5 \u043c), \u0435\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u0431\u044b\u043b \u0431\u044b \u0431\u043b\u0438\u0437\u043e\u043a \u043a \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c\u0443
    (\u043e\u043a. 39 690 \u043a\u043c), \u0435\u0441\u043b\u0438 \u0436\u0435 \u0430\u0442\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    (\u043e\u043a. 178 \u043c), \u0442\u043e \u043f\u043e\u0433\u0440\u0435\u0448\u043d\u043e\u0441\u0442\u044c
    \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0431\u044b \u043e\u043a\u043e\u043b\u043e
    16%. \u0412 \u043b\u044e\u0431\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435, \u044d\u0442\u043e
    \u0431\u044b\u043b \u043f\u0440\u043e\u0440\u044b\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b \u0448\u0430\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c
    \u0417\u0435\u043c\u043b\u0438. \u0412 \u0441\u0432\u043e\u0451\u043c \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u00ab\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u043a\u0430\u00bb
    \u043e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043f\u0438\u0441\u0430\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0438\u0440, \u043d\u043e
    \u0438 \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u0435\u0433\u043e \u043a\u0430\u0440\u0442\u0443, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442
    \u2014 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u0438 \u0438 \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d\u044b.\n\n\U0001F4D0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \"\u0420\u0435\u0448\u0435\u0442\u043e
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430\" \u0412 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u0434\u0432\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f. \u0412\u043e-\u043f\u0435\u0440\u0432\u044b\u0445,
    \u044d\u0442\u043e \u00ab\u0440\u0435\u0448\u0435\u0442\u043e \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430\u00bb
    \u2014 \u0434\u0440\u0435\u0432\u043d\u0435\u0439\u0448\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u0441\u0435\u0445
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b, \u043d\u0435
    \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0433\u043e
    \u043f\u0440\u0435\u0434\u0435\u043b\u0430. \u0412\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0430
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438
    \u043d\u0430 \u0432\u043e\u0441\u043a\u043e\u0432\u044b\u0445 \u0442\u0430\u0431\u043b\u0438\u0447\u043a\u0430\u0445,
    \u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430
    \u00ab\u0432\u044b\u043a\u0430\u043b\u044b\u0432\u0430\u043b\u0438\u00bb, \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044f
    \u043d\u0435\u0442\u0440\u043e\u043d\u0443\u0442\u044b\u043c\u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0435,
    \u043a\u0430\u043a \u0432 \u0440\u0435\u0448\u0435\u0442\u0435. \u0412\u043e-\u0432\u0442\u043e\u0440\u044b\u0445,
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0434\u0435\u043b\u0438\u0439\u0441\u043a\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043e\u0431 \u0443\u0434\u0432\u043e\u0435\u043d\u0438\u0438 \u043a\u0443\u0431\u0430,
    \u0441\u043e\u0437\u0434\u0430\u0432 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u0438\u0431\u043e\u0440 \u2014 \u043c\u0435\u0437\u043e\u043b\u044f\u0431\u0438\u0439.
    \u041e\u0434\u043d\u0430\u043a\u043e \u044d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u0441\u044f \u043a\u0440\u0438\u0442\u0438\u043a\u0435,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u044b \u0441\u0447\u0438\u0442\u0430\u043b\u0438
    \u043d\u0435\u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u043c \u0440\u0435\u0448\u0430\u0442\u044c
    \u0447\u0438\u0441\u0442\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u043e\u0432.\n\n\U0001F52D \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f
    \u0438 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0443
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u041a\u0430\u0442\u0430\u0441\u0442\u0435\u0440\u0438\u0437\u043c\u044b\u00bb \u2014
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 44 \u0441\u043e\u0437\u0432\u0435\u0437\u0434\u0438\u0439
    \u0441 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u0441 \u043d\u0438\u043c\u0438 \u043c\u0438\u0444\u043e\u0432. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0442\u043e\u0447\u043d\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b
    \u043d\u0430\u043a\u043b\u043e\u043d \u044d\u043a\u043b\u0438\u043f\u0442\u0438\u043a\u0438
    (\u0443\u0433\u043e\u043b \u0437\u0435\u043c\u043d\u043e\u0439 \u043e\u0441\u0438) \u0438
    \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u043e\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u0435\u0439
    \u041e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u0438\u0445 \u0438\u0433\u0440, \u0441\u0442\u0430\u0432,
    \u0442\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u0438.\n\n\U0001F48E
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0438 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0430
    \u0417\u0430 \u0441\u0432\u043e\u044e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u0432\u0430 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0430. \u041e\u0434\u043d\u043e
    \u0438\u0437 \u043d\u0438\u0445 \u2014 \u00ab\u041f\u0435\u043d\u0442\u0430\u0442\u043b\u00bb,
    \u0442\u043e \u0435\u0441\u0442\u044c \u043f\u044f\u0442\u0438\u0431\u043e\u0440\u0435\u0446,
    \u0432 \u0437\u043d\u0430\u043a \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f \u0435\u0433\u043e
    \u0442\u0430\u043b\u0430\u043d\u0442\u043e\u0432 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0445. \u0414\u0440\u0443\u0433\u043e\u0435
    \u2014 \u00ab\u0411\u0435\u0442\u0430\u00bb (\u0432\u0442\u043e\u0440\u0430\u044f \u0431\u0443\u043a\u0432\u0430
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0438\u0442\u0430).
    \u041e\u043d\u043e \u0438\u043c\u0435\u043b\u043e \u0434\u0432\u043e\u0439\u043d\u043e\u0439
    \u0441\u043c\u044b\u0441\u043b: \u0441 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b,
    \u0435\u0433\u043e \u043c\u043e\u0433\u043b\u0438 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0442\u044c,
    \u0441\u0447\u0438\u0442\u0430\u044f \u00ab\u0432\u0442\u043e\u0440\u044b\u043c \u041f\u043b\u0430\u0442\u043e\u043d\u043e\u043c\u00bb,
    \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u2014 \u043d\u0430\u043c\u0435\u043a\u0430\u044f
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e, \u0431\u0443\u0434\u0443\u0447\u0438 \u0433\u0435\u043d\u0438\u0435\u043c
    \u0432\u043e \u0432\u0441\u0451\u043c, \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043e\u043d \u043d\u0435\u043c\u043d\u043e\u0433\u043e
    \u0443\u0441\u0442\u0443\u043f\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0443).
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432
    \u0443\u0442\u0435\u0440\u044f\u043d\u044b \u0438 \u0434\u043e\u0448\u043b\u0438 \u0434\u043e
    \u043d\u0430\u0441 \u043b\u0438\u0448\u044c \u0432 \u043e\u0442\u0440\u044b\u0432\u043a\u0430\u0445
    \u0438 \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u0430\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0430\u0432\u0442\u043e\u0440\u043e\u0432, \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430
    \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u043d\u0430\u0443\u043a\u0443 \u043e\u0433\u0440\u043e\u043c\u043d\u043e.
    \u0415\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u044b \u0431\u044b\u043b\u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b
    \u043f\u043e \u0441\u0432\u043e\u0435\u0439 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u0435
    \u0438 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438, \u0430 \u0438\u043c\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438.
    \u0412 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u044b
    \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435, \u043f\u043e\u0434\u0432\u043e\u0434\u043d\u0430\u044f
    \u0433\u043e\u0440\u0430 \u0432 \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e\u043c
    \u043c\u043e\u0440\u0435 \u0438 \u0434\u0430\u0436\u0435 \u043e\u0434\u0438\u043d \u0438\u0437
    \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u0432 \u0433\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u041b\u0443\u043d\u044b."
  shortBioEn: "Eratosphene of Kirensky is one of the greatest scientists of Antiquity, a man whose knowledge was so extensive that his contemporaries called him the Pentatle (Pluriborz) and later researchers \"father of geography.\" He was a mathematician, astronomer, geographer, philologist and poet, and his life is an exciting story of infinite human curiosity.\n\n♪ Lifeway: from Kirena to Alexandria, Eratosphen was born around 276 BCE in Kirena (in the territory of modern Libya) in the family of Aglaos. He received his primary education in Alexandria, where he was mentored by a famous poet and scientist of Kallimach, and by a philosopher of Lisny.There he drew close to the Platonian Academy and later proudly called himself a platonic. His life changed dramatically around 245. The King of Egypt, Ptolemy III, Everget, invited Eratosphen to Alexandria to head the Alexandria Library, the greatest book store in the ancient world. He replaced the poet Apollonia of Rhodes.As the head librarian, Eratosphen dedicated himself to expanding the funds: he instructed ships arriving at the port to take away all the books for copying, and he himself acquired the true texts of the tragedies of Eshil, Sofocle and Euripida, and he was also teaching the children of the monarch, including the future of Ptolemy IV. The last years of his life were blinded by blindness, which prevented him from reading or observing nature.According to evidence, in 194 BCE, at the age of 82, he voluntarily starved himself.\n\nThe achievements and discoveries of Eratosphene were a real encyclopediacist, covering almost all the sciences known at the time.\n\nHe first introduced the term \"geography\" into the world and considered it to be a science. The most famous of its achievements was the measurement of the earth's circumference. He knew that on the day of the summer solstice at noon in Siena (now Asuan), the sun's rays were falling away from the deep bottom of the wells.At the same time, in Alexandria, about one meridian, the sun clocks cast a shadow. Eratosphen measured this shadow and found that the angle of fall of the sun's rays was 7°12', which is exactly 50 times less than the total circle of 360°. By taking the distance between Siena and Alexandria in 5,000 stages (from the Egyptian surveyors), he easily calculated the Earth's circle: 5000 50 = 250,000 steps.The accuracy of this result is still controversial because it is not known what stage the scientist used. If he used the Egyptian stage (c. 157.5 m), the result would be close to the modern stage (c. 39,690 km), if the aptic (c. 178 m), the error would be about 16%; in any case, it would have been a breakthrough that confirmed the Earth's orbitality.In his three-volume work \"Geographics\", he not only described the known world, but also tried to create a map of it using a coordinate system, parallels and meridians.\n\n♪ Mathematics and Resheto Eratosphene in Mathematics Eratosphen left behind two outstanding inventions. First, it's the \"Aratosphene Requeto\" that's the oldest algorithm for finding all prime numbers that do not exceed the limit. In the time of a scientist, they were recorded on wax tablets, and the composite numbers were pricked, leaving the simple ones intact, as in the decision.Secondly, he proposed a mechanical solution to the famous delicacy problem of doubling the cube by creating a special device, mesolabies, but this approach was criticized because some philosophers felt it was inappropriate to solve pure mathematical problems through mechanisms.\n\nAstronomia and chronology to Eratosphen belongs to Catasterism, a description of 44 constellations with associated myths. He also calculated quite accurately the angle of ecliptics (the angle of the Earth's axis) and drew up a list of the winners of the Olympic Games, thus becoming the founder of scientific chronology.\n\n▪ The legacy and nicknames for their universality, Eratosphen, received two nicknames, one of which is the Pentatle, i.e. the five-batcher, in recognition of his talents in different disciplines. The other is the Beta (the second letter of the Greek alphabet).It had two meanings: on the one hand, it could have been called \"Second Plato\", on the other, implying that, as a genius in everything, in every single field, he was a little less than the first experts (e.g. Archimedes), although most of his works were lost and only reached us in the passages and rehearsals of other authors, the influence of Eratosphene on world science is enormous.His methods were genius in their simplicity and accuracy, and his name was left forever in history, and he was honored by a crater on the moon, an underwater mountain in the Mediterranean and even one of the periods of the geological history of the moon."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430
    \u043f\u043e\u043b\u043d\u044b \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043d\u044e\u0430\u043d\u0441\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u0445\u043e\u0434\u044f\u0442
    \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u0441\u0443\u0445\u043e\u0433\u043e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u0430.
    \u041c\u043d\u043e\u0433\u0438\u0435 \u0438\u0437 \u044d\u0442\u0438\u0445 \u0444\u0430\u043a\u0442\u043e\u0432
    \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u0435\u0433\u043e \u043a\u0430\u043a
    \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u043e\u0433\u043e, \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u043e\u0433\u043e
    \u0438 \u0434\u0430\u0436\u0435 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u044f\u0437\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u0412\u043e\u0442 \u0441\u0430\u043c\u0430\u044f
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432,
    \u043f\u0440\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u0445 \u0441\u0432\u0435\u0442
    \u043d\u0430 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u043c\u0435\u0442\u043e\u0434\u044b
    \u00ab\u043e\u0442\u0446\u0430 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0438\u00bb.
    1. \u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f:
    \u00ab\u041a\u043e\u043b\u043e\u0434\u0435\u0446\u00bb \u0438 \u00ab\u0412\u0435\u0440\u0431\u043b\u044e\u0434\u00bb
    \u043a\u0430\u043a \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u0438\u0431\u043e\u0440\u044b \u041d\u0435 \u043a\u043e\u043b\u043e\u0434\u0435\u0446,
    \u0430 \u00ab\u0432\u0435\u0440\u0431\u043b\u044e\u0436\u0438\u0439\u00bb \u0440\u0430\u0441\u0447\u0435\u0442:
    \u0412 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0445 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430\u0445
    \u0447\u0430\u0441\u0442\u043e \u043f\u0438\u0448\u0443\u0442, \u0447\u0442\u043e \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043a\u043e\u043b\u043e\u0434\u0435\u0446
    \u0432 \u0421\u0438\u0435\u043d\u0435, \u0433\u0434\u0435 \u0421\u043e\u043b\u043d\u0446\u0435
    \u043e\u0441\u0432\u0435\u0449\u0430\u043b\u043e \u0434\u043d\u043e. \u041d\u0430 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435, \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0434\u0440\u0443\u0433\u043e\u0439, \u0431\u043e\u043b\u0435\u0435 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434. \u0421\u0438\u0435\u043d\u0430 \u043b\u0435\u0436\u0430\u043b\u0430
    \u043d\u0430 \u043f\u0443\u0442\u0438 \u043a\u0430\u0440\u0430\u0432\u0430\u043d\u043e\u0432,
    \u0438 \u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u0436\u0438\u0442\u0435\u043b\u0438 \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0438,
    \u0447\u0442\u043e \u0432 \u043f\u043e\u043b\u0434\u0435\u043d\u044c \u043b\u0435\u0442\u043d\u0435\u0433\u043e
    \u0441\u043e\u043b\u043d\u0446\u0435\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435
    \u0448\u0435\u0441\u0442\u044b \u043d\u0435 \u043e\u0442\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u044e\u0442
    \u0442\u0435\u043d\u0438. \u041d\u043e \u043a\u0430\u043a \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u044c
    \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043c\u0435\u0436\u0434\u0443
    \u0433\u043e\u0440\u043e\u0434\u0430\u043c\u0438 \u0431\u0435\u0437 \u043a\u0430\u0440\u0442?
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u043d\u0435 \u0435\u0437\u0434\u0438\u043b
    \u0438\u0437 \u0433\u043e\u0440\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434.
    \u041e\u043d \u043d\u0430\u043d\u044f\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0431\u0435\u043c\u0430\u0442\u0438\u0441\u0442\u043e\u0432 \u2014 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043e\u0431\u0443\u0447\u0435\u043d\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u0448\u0430\u0433\u0438. \u041d\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u2014 \u043e\u043d \u0441\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0435. \u0411\u0435\u043c\u0430\u0442\u0438\u0441\u0442\u044b
    \u0448\u043b\u0438 \u043d\u0435 \u043f\u043e \u043f\u0440\u044f\u043c\u043e\u0439, \u0430
    \u043f\u043e \u0438\u0437\u0432\u0438\u043b\u0438\u0441\u0442\u043e\u0439 \u0434\u043e\u0440\u043e\u0433\u0435
    \u0432\u0434\u043e\u043b\u044c \u041d\u0438\u043b\u0430. \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u043f\u0443\u0442\u044c \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442
    \u0438\u0437\u0433\u0438\u0431\u044b \u0440\u0435\u043a\u0438, \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u044b\u043f\u0440\u044f\u043c\u0438\u043b \u044d\u0442\u0443 \u043a\u0440\u0438\u0432\u0443\u044e,
    \u043e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u044f\u0441\u044c \u043d\u0430 \u0441\u0440\u0435\u0434\u043d\u0435\u0439
    \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0432\u0435\u0440\u0431\u043b\u044e\u0436\u044c\u0438\u0445
    \u043a\u0430\u0440\u0430\u0432\u0430\u043d\u043e\u0432 (\u043e\u043a\u043e\u043b\u043e 100
    \u0441\u0442\u0430\u0434\u0438\u0435\u0432 \u0432 \u0434\u0435\u043d\u044c). \u0422\u0430\u043a
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0432\u043e\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    5000 \u0441\u0442\u0430\u0434\u0438\u0435\u0432. \u041e\u0448\u0438\u0431\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u043f\u0430\u0441\u043b\u0430 \u041a\u043e\u043b\u0443\u043c\u0431\u0430: \u0422\u043e\u0442
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    (\u043e\u043a\u043e\u043b\u043e 250 000 \u0441\u0442\u0430\u0434\u0438\u0435\u0432), \u0431\u044b\u043b
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0431\u043b\u0438\u0437\u043e\u043a
    \u043a \u0438\u0441\u0442\u0438\u043d\u0435 (\u0432\u0441\u0435\u0433\u043e \u043d\u0430
    ~2% \u0432\u044b\u0448\u0435, \u0435\u0441\u043b\u0438 \u0441\u0447\u0438\u0442\u0430\u0442\u044c
    \u0432 \u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0445 \u0441\u0442\u0430\u0434\u0438\u044f\u0445).
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0421\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u044c\u0435
    \u0438 \u0432 \u044d\u043f\u043e\u0445\u0443 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0443\u0447\u0435\u043d\u044b\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u043c\u0438, \u0441\u0438\u043b\u044c\u043d\u043e
    \u0437\u0430\u043d\u0438\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u043c\u0438
    \u041f\u043e\u0441\u0438\u0434\u043e\u043d\u0438\u044f (\u043e\u043a\u043e\u043b\u043e 29
    000 \u043a\u043c). \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0438 \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u044b\u0435
    \u0434\u0430\u043d\u043d\u044b\u0435 \u0443\u0431\u0435\u0434\u0438\u043b\u0438 \u0425\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u0440\u0430
    \u041a\u043e\u043b\u0443\u043c\u0431\u0430, \u0447\u0442\u043e \u043f\u043b\u044b\u0442\u044c
    \u043d\u0430 \u0437\u0430\u043f\u0430\u0434 \u0434\u043e \u0410\u0437\u0438\u0438 \u0440\u0443\u043a\u043e\u0439
    \u043f\u043e\u0434\u0430\u0442\u044c. \u0415\u0441\u043b\u0438 \u0431\u044b \u041a\u043e\u043b\u0443\u043c\u0431
    \u0437\u043d\u0430\u043b \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0443\u044e \u0446\u0438\u0444\u0440\u0443
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430, \u043e\u043d \u0431\u044b
    \u0438\u0441\u043f\u0443\u0433\u0430\u043b\u0441\u044f \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0435 \u043e\u0442\u043f\u043b\u044b\u043b
    \u0431\u044b. --- 2. \u0411\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u0447\u043d\u0430\u044f
    \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430: \u00ab\u041a\u043e\u0440\u0430\u0431\u0435\u043b\u044c\u043d\u044b\u0439\u00bb
    \u043d\u0430\u043b\u043e\u0433 \u0411\u0443\u0434\u0443\u0447\u0438 \u0433\u043b\u0430\u0432\u043e\u0439
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438, \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0441\u0435\u0431\u044f \u043a\u0430\u043a \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u044b\u0439
    \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0435\u0440 \u0437\u043d\u0430\u043d\u0438\u0439.
    \u041a\u043e\u043d\u0444\u0438\u0441\u043a\u0430\u0446\u0438\u044f \u043d\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0435:
    \u041e\u043d \u0438\u0437\u0434\u0430\u043b \u0443\u043a\u0430\u0437, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0432\u0441\u0435 \u043a\u043e\u0440\u0430\u0431\u043b\u0438,
    \u043f\u0440\u0438\u0431\u044b\u0432\u0430\u044e\u0449\u0438\u0435 \u0432 \u043f\u043e\u0440\u0442
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438, \u043f\u043e\u0434\u043b\u0435\u0436\u0430\u043b\u0438
    \u043e\u0431\u044b\u0441\u043a\u0443 \u043d\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0435
    \u043a\u043d\u0438\u0433. \u0415\u0441\u043b\u0438 \u043d\u0430 \u0431\u043e\u0440\u0442\u0443
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u0441\u0432\u0438\u0442\u043e\u043a,
    \u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u043b\u0438,
    \u0430 \u043a\u043e\u043d\u0444\u0438\u0441\u043a\u043e\u0432\u0430\u043b\u0438 \u0432 \u043f\u043e\u043b\u044c\u0437\u0443
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438. \u0412\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0443
    \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u043b\u0438 \u043a\u043e\u043f\u0438\u044e,
    \u0441\u0434\u0435\u043b\u0430\u043d\u043d\u0443\u044e \u043c\u0435\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0447\u0438\u043a\u0430\u043c\u0438, \u0430 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0432 \u043a\u043d\u0438\u0433\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435.
    \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0433\u0440\u0430\u0431\u0435\u0436 \u0440\u0430\u0434\u0438 \u043d\u0430\u0443\u043a\u0438:
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0438\u0437 \u0410\u0444\u0438\u043d \u0432
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u044e \u043f\u0440\u0438\u0432\u0435\u0437\u043b\u0438
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0430\u0440\u0445\u0438\u0432 \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0439 (\u042d\u0441\u0445\u0438\u043b\u0430,
    \u0421\u043e\u0444\u043e\u043a\u043b\u0430, \u0415\u0432\u0440\u0438\u043f\u0438\u0434\u0430)
    \u0434\u043b\u044f \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u00ab\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u043b\u0435\u043d\u0438\u044f\u00bb.
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0437\u0430\u043f\u043b\u0430\u0442\u0438\u043b
    \u0430\u0444\u0438\u043d\u044f\u043d\u0430\u043c \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0434\u0435\u043d\u0435\u0436\u043d\u044b\u0439 \u0437\u0430\u043b\u043e\u0433 \u0437\u0430
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u044c
    \u0442\u0435\u043a\u0441\u0442\u044b, \u043d\u043e \u043f\u043e\u0442\u043e\u043c \u0437\u0430\u044f\u0432\u0438\u043b,
    \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044b
    \u0441\u0435\u0431\u0435, \u0430 \u0437\u0430\u043b\u043e\u0433 (\u0432\u0437\u0430\u043c\u0435\u043d
    \u043f\u043e\u0442\u0435\u0440\u0438) \u043e\u043d \u043e\u0442\u0434\u0430\u0435\u0442
    \u0430\u0444\u0438\u043d\u044f\u043d\u0430\u043c. \u042d\u0442\u043e \u0431\u044b\u043b
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044c\u043d\u044b\u0439, \u043d\u043e \u043e\u0447\u0435\u043d\u044c
    \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u043f\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0444\u043e\u043d\u0434\u043e\u0432.
    --- 3. \u0425\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f: \u0421\u043c\u0435\u0445
    \u043d\u0430\u0434 \u0437\u0432\u0435\u0437\u0434\u0430\u043c\u0438 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u043c, \u043a\u0442\u043e \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0432\u044b\u0441\u043c\u0435\u044f\u0442\u044c \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u0432
    \u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u044f
    \u043e \u00ab\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0445 \u0437\u0432\u0435\u0437\u0434\u0430\u0445\u00bb.
    \u0422\u0435\u043e\u0440\u0438\u044f \u00ab\u0421\u043e\u0431\u0430\u0447\u044c\u0435\u0433\u043e
    \u0438\u0441\u043f\u0443\u0433\u0430\u00bb: \u0412 \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u043d \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b,
    \u0447\u0442\u043e \u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0435 \u0437\u0432\u0435\u0437\u0434\u044b
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u0435\u0434\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043d\u0435 \u0434\u0443\u0448\u0438 \u043b\u044e\u0434\u0435\u0439. \u041e\u043d
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b, \u0447\u0442\u043e \u044d\u0442\u043e
    \u0442\u0432\u0435\u0440\u0434\u044b\u0435 \u0447\u0430\u0441\u0442\u0438\u0446\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0433\u043e\u0440\u0430\u044e\u0442 \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0435.
    \u0412 \u0448\u0443\u0442\u043a\u0443 \u043e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0438\u0445 \u00ab\u043a\u0430\u043b\u043e\u043c \u041a\u043e\u0441\u043c\u043e\u0441\u0430\u00bb.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b,
    \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0437\u0432\u0435\u0437\u0434\u0430 \u00ab\u043f\u0430\u0434\u0430\u0435\u0442\u00bb,
    \u0442\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u043e\u043d\u0430
    \u043f\u0440\u043e\u043b\u0435\u0442\u0430\u0435\u0442 \u043c\u0438\u043c\u043e \u043d\u0430\u0441
    \u043d\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438,
    \u0438 \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u043e \u044d\u0442\u043e \u043f\u043e\u0445\u043e\u0436\u0435
    \u043d\u0430 \u0442\u043e, \u043a\u0430\u043a \u0435\u0441\u043b\u0438 \u0431\u044b \u0432\u044b
    \u0431\u0440\u043e\u0441\u0438\u043b\u0438 \u043a\u0430\u043c\u0435\u043d\u044c \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439
    \u0431\u0430\u0448\u043d\u0438. --- 4. \u041e\u0448\u0438\u0431\u043a\u0430 \u0432 \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438:
    \u0421\u043f\u043e\u0440 \u0441 \u0413\u043e\u043c\u0435\u0440\u043e\u043c \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c
    \u0441\u043a\u0435\u043f\u0442\u0438\u0446\u0438\u0437\u043c\u043e\u043c \u043a \u043f\u043e\u044d\u0442\u0430\u043c,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043a \u0413\u043e\u043c\u0435\u0440\u0443.
    \u041a\u0440\u0438\u0442\u0438\u043a\u0430 \u00ab\u041e\u0434\u0438\u0441\u0441\u0435\u0438\u00bb:
    \u041e\u043d \u044f\u0437\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0430\u043c\u0435\u0447\u0430\u043b,
    \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0431\u044b \u0413\u043e\u043c\u0435\u0440
    \u0431\u044b\u043b \u043f\u0440\u0430\u0432, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044f
    \u043f\u043b\u0430\u0432\u0430\u043d\u0438\u044f \u041e\u0434\u0438\u0441\u0441\u0435\u044f,
    \u0442\u043e \u0442\u043e\u0442 \u043f\u0440\u043e\u043f\u043b\u044b\u043b \u0431\u044b
    \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u0441\u0440\u0430\u0432\u043d\u0438\u043c\u044b\u0435
    \u0441 \u043a\u0440\u0443\u0433\u043e\u0441\u0432\u0435\u0442\u043d\u044b\u043c \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435\u043c,
    \u043f\u0440\u0438\u0447\u0435\u043c \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445
    \u043e\u0434\u043d\u043e\u0433\u043e \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e\u0433\u043e
    \u043c\u043e\u0440\u044f. \u00ab\u041e\u0434\u0438\u0441\u0441\u0435\u044f \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u00bb: \u041a\u043e\u0433\u0434\u0430
    \u043a\u0440\u0438\u0442\u0438\u043a\u0438 \u043e\u0431\u0432\u0438\u043d\u044f\u043b\u0438
    \u0435\u0433\u043e \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0435\u0433\u043e \u043a\u0430\u0440\u0442\u0430
    \u0415\u0432\u0440\u043e\u043f\u044b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u00ab\u0441\u0436\u0430\u0442\u0430\u00bb
    \u0438 \u043b\u0438\u0448\u0435\u043d\u0430 \u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0440\u0430\u0441\u043e\u0442\u044b, \u043e\u043d \u043e\u0442\u0432\u0435\u0447\u0430\u043b:
    \u00ab\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0434\u043e\u043b\u0436\u043d\u0430
    \u0431\u044b\u0442\u044c \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0439,
    \u0430 \u043d\u0435 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439.
    \u041a\u0430\u0440\u0442\u0430 \u2014 \u044d\u0442\u043e \u043d\u0435 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0430,
    \u0430 \u0447\u0435\u0440\u0442\u0435\u0436\u00bb. --- 5. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044e\u043c\u043e\u0440: \u041a\u0430\u043a \u043e\u043d \u00ab\u043b\u043e\u0432\u0438\u043b\u00bb
    \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0447\u0438\u0441\u043b\u0430 \u0420\u0435\u0448\u0435\u0442\u043e
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0441\u0430\u043c\u044b\u0439 \u0434\u0440\u0435\u0432\u043d\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c,
    \u043d\u043e \u0435\u0433\u043e \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u00ab\u0420\u0435\u0448\u0435\u0442\u043e\u043c\u00bb
    \u043d\u0435 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e. \u0422\u0435\u0445\u043d\u0438\u043a\u0430
    \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f: \u041e\u043d \u0431\u0440\u0430\u043b
    \u043f\u0430\u043f\u0438\u0440\u0443\u0441, \u043f\u0438\u0441\u0430\u043b \u043d\u0430
    \u043d\u0435\u043c \u0447\u0438\u0441\u043b\u0430 \u043e\u0442 1 \u0434\u043e 100 000, \u0430
    \u0437\u0430\u0442\u0435\u043c \u0431\u0440\u0430\u043b \u043e\u0441\u0442\u0440\u0443\u044e
    \u043f\u0430\u043b\u043e\u0447\u043a\u0443 \u0438 \u0432\u044b\u043a\u0430\u043b\u044b\u0432\u0430\u043b
    (\u0432\u044b\u0440\u0435\u0437\u0430\u043b) \u0432\u0441\u0435 \u0441\u043e\u0441\u0442\u0430\u0432\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430. \u041f\u0430\u043f\u0438\u0440\u0443\u0441 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u043b\u0441\u044f
    \u0432 \u043f\u043e\u0434\u043e\u0431\u0438\u0435 \u0434\u0443\u0440\u0448\u043b\u0430\u0433\u0430.
    \u0412 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c
    \u0442\u0435\u043a\u0441\u0442\u0435 \u043e\u043d \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b
    \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0441 \u043f\u0440\u043e\u0441\u0435\u0438\u0432\u0430\u043d\u0438\u0435\u043c
    \u043c\u0443\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 \u0441\u0438\u0442\u043e, \u0433\u0434\u0435
    \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0447\u0438\u0441\u043b\u0430 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u00ab\u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438\u00bb,
    \u0430 \u0434\u044b\u0440\u043a\u0438 \u0431\u044b\u043b\u0438 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b. --- 6. \u0414\u0440\u0443\u0436\u0431\u0430
    \u0441 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u043c: \u0428\u043f\u0438\u043e\u043d\u0441\u043a\u0438\u0435
    \u0438\u0433\u0440\u044b \u041c\u0435\u0436\u0434\u0443 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0435\u0439
    (\u0433\u0434\u0435 \u0436\u0438\u043b \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d)
    \u0438 \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u0430\u043c\u0438 (\u0433\u0434\u0435
    \u0436\u0438\u043b \u0410\u0440\u0445\u0438\u043c\u0435\u0434) \u0448\u043b\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u0430\u044f
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430. \u00ab\u0417\u0430\u0434\u0430\u0447\u0430
    \u043e \u0431\u044b\u043a\u0430\u0445\u00bb: \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0443
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0441 \u0432\u043e\u0441\u0435\u043c\u044c\u044e
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438 (\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435
    \u043a\u0430\u043a \u00ab\u0417\u0430\u0434\u0430\u0447\u0430 \u043e \u0431\u044b\u043a\u0430\u0445\u00bb).
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430.
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u0433\u043e\u0440\u0434\u0438\u043b\u0441\u044f
    \u0442\u0435\u043c, \u0447\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442
    \u043a\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u0430\u044f, \u043d\u043e \u043d\u0430
    \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c\u0438
    \u0447\u0438\u0441\u043b\u0430\u043c\u0438 (\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0438\u043c\u0435\u0435\u0442
    206 545 \u0446\u0438\u0444\u0440). \u041e\u043d \u0431\u0440\u043e\u0441\u0438\u043b \u0432\u044b\u0437\u043e\u0432
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0443, \u0437\u043d\u0430\u044f,
    \u0447\u0442\u043e \u0442\u043e\u0442 \u043b\u044e\u0431\u0438\u0442 \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u041c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435: \u0412 \u043e\u0442\u0432\u0435\u0442 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u043d\u0435 \u0441\u0442\u0430\u043b \u043c\u0443\u0447\u0438\u0442\u044c\u0441\u044f \u0441
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c\u0438, \u0430 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0440\u0438\u0441\u043b\u0430\u043b \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0443
    \u0447\u0435\u0440\u0442\u0435\u0436 \u0441\u0432\u043e\u0435\u0433\u043e \u043c\u0435\u0437\u043e\u043b\u044f\u0431\u0438\u044f.
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \u00ab\u041b\u043e\u0432\u0438,
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434, \u044d\u0442\u043e \u043b\u0435\u0433\u0447\u0435,
    \u0447\u0435\u043c \u0434\u0443\u043c\u0430\u0442\u044c \u0433\u043e\u043b\u043e\u0432\u043e\u0439
    \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0432\u0438\u0433\u0430\u0439 \u043f\u043b\u0430\u043d\u043a\u0438\u00bb.
    --- 7. \u041b\u0438\u0447\u043d\u044b\u0439 \u0442\u0440\u0430\u0433\u0438\u0437\u043c \u0438
    \u00ab\u0414\u0438\u0435\u0442\u0430\u00bb \u0414\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u044b\u0439
    \u0443\u0445\u043e\u0434 \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0438\u0437-\u0437\u0430
    \u0441\u043b\u0435\u043f\u043e\u0442\u044b \u2014 \u044d\u0442\u043e \u0444\u0430\u043a\u0442,
    \u043d\u043e \u0443 \u043d\u0435\u0433\u043e \u0435\u0441\u0442\u044c \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0434\u0435\u0442\u0430\u043b\u044c. \u0423\u0447\u0435\u043d\u044b\u0439 \u0434\u043e
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0432\u0437\u0434\u043e\u0445\u0430:
    \u0418\u0441\u0442\u043e\u0440\u0438\u043a \u041f\u043b\u0443\u0442\u0430\u0440\u0445 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043f\u0435\u0440\u0435\u0434 \u0442\u0435\u043c \u043a\u0430\u043a
    \u043d\u0430\u0447\u0430\u0442\u044c \u0433\u043e\u043b\u043e\u0434\u043e\u0432\u043a\u0443,
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0437\u0430\u043a\u0430\u0437\u0430\u043b
    \u0441\u0435\u0431\u0435 \u0443 \u0440\u0430\u0431\u043e\u0432 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c
    \u0432\u0441\u043b\u0443\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439, \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0435\u043c\u0443 \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u043a\u043e\u043c\u0435\u0442\u043d\u044b\u0445
    \u043e\u0440\u0431\u0438\u0442\u0430\u0445. \u041a\u043e\u0433\u0434\u0430 \u043a\u043d\u0438\u0433\u0443
    \u0434\u043e\u0447\u0438\u0442\u0430\u043b\u0438, \u043e\u043d \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u0422\u0435\u043f\u0435\u0440\u044c \u044f \u0437\u043d\u0430\u044e \u0432\u0441\u0435,
    \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0437\u043d\u0430\u0442\u044c \u043e
    \u043d\u0435\u0431\u0435, \u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435
    \u0443\u0432\u0438\u0436\u0443 \u0435\u0433\u043e\u00bb \u2014 \u0438 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0435\u0434\u044b. \u0421\u043f\u043e\u0440 \u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435:
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0440\u0430\u0437\u043d\u043e\u0433\u043b\u0430\u0441\u0438\u0435
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0433\u043e\u0434\u0430
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0442,
    \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u0440 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    80 \u043b\u0435\u0442, \u0434\u0440\u0443\u0433\u0438\u0435 \u2014 \u0432 82 \u0433\u043e\u0434\u0430.
    \u0417\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u0447\u0442\u043e
    \u044d\u0442\u0430 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u0430 \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430
    \u0438\u0437-\u0437\u0430 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d \u0441\u0430\u043c
    \u0436\u0435 \u0437\u0430\u043f\u0443\u0442\u0430\u043b \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u0438,
    \u0432\u0432\u0435\u0434\u044f \u043d\u043e\u0432\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u043e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u043b\u0435\u0442\u043e\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f,
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043f\u043e\u0442\u043e\u043c \u043d\u0435
    \u043c\u043e\u0433\u043b\u0438 \u0441\u043e\u0439\u0442\u0438\u0441\u044c \u043d\u0430 \u0442\u043e\u0447\u043d\u043e\u0439
    \u0434\u0430\u0442\u0435 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438. --- 8. \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0435
    \u00ab\u043a\u0443\u0440\u044c\u0435\u0437\u044b\u00bb: \u041b\u0443\u043d\u043d\u044b\u0439
    \u043a\u0440\u0430\u0442\u0435\u0440 \u0438 \u043c\u043e\u0440\u0441\u043a\u0430\u044f \u0433\u043e\u0440\u0430
    \u0412 \u0447\u0435\u0441\u0442\u044c \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430
    \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u043e\u0431\u044a\u0435\u043a\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0432\u0438\u0434\u0435\u043b.
    \u041a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435: \u0423\u0434\u0430\u0440\u043d\u044b\u0439
    \u043a\u0440\u0430\u0442\u0435\u0440 \u0434\u0438\u0430\u043c\u0435\u0442\u0440\u043e\u043c
    \u043e\u043a\u043e\u043b\u043e 60 \u043a\u043c \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f
    \u0432 \u0432\u0438\u0434\u0438\u043c\u043e\u0439 \u0447\u0430\u0441\u0442\u0438 \u041b\u0443\u043d\u044b.
    \u0415\u0433\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432
    \u0442\u043e\u043c, \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e \u043e\u0447\u0435\u043d\u044c
    \u043a\u0440\u0443\u0442\u044b\u0435 \u0441\u0442\u0435\u043d\u043a\u0438 \u0438 \u043c\u043e\u043b\u043e\u0434\u043e\u0439
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442 (\u0432 \u0433\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0441\u043c\u044b\u0441\u043b\u0435 \u2014 \u043e\u043a\u043e\u043b\u043e 1,1 \u043c\u043b\u0440\u0434
    \u043b\u0435\u0442). \u041b\u0443\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0441\u044f,
    \u0442\u0430\u043a \u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u2014
    \u00ab\u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u043e\u0432\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434\u00bb. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u044b
    \u0432\u044b\u0431\u0440\u0430\u043b\u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e
    \u0438\u043c\u044f, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u0438\u0441\u0442\u043e\u0440\u0438\u044e
    \u0417\u0435\u043c\u043b\u0438 \u043d\u0430 \u044d\u0440\u044b (\u043f\u0435\u0440\u0438\u043e\u0434\u044b).
    \u0413\u043e\u0440\u0430 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430: \u0412
    \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e\u043c \u043c\u043e\u0440\u0435,
    \u043a \u044e\u0433\u0443 \u043e\u0442 \u041a\u0440\u0438\u0442\u0430, \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f
    \u043f\u043e\u0434\u0432\u043e\u0434\u043d\u0430\u044f \u0433\u043e\u0440\u0430, \u0432\u0435\u0440\u0448\u0438\u043d\u0430
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0435 \u0434\u043e\u0445\u043e\u0434\u0438\u0442
    \u0434\u043e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0432\u043e\u0434\u044b
    \u043e\u043a\u043e\u043b\u043e 700 \u043c\u0435\u0442\u0440\u043e\u0432. \u0415\u0451 \u043d\u0430\u0437\u0432\u0430\u043b\u0438
    \u0432 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u043e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u043d\u0430\u043d\u0435\u0441
    \u043d\u0430 \u043a\u0430\u0440\u0442\u0443 \u044d\u0442\u0443 \u0437\u043e\u043d\u0443
    \u0438 \u043e\u0442\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u0437\u0434\u0435\u0441\u044c
    \u043c\u043e\u0440\u0435 \u0438\u043c\u0435\u0435\u0442 \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0441\u0438\u043d\u0438\u0439 \u043e\u0442\u0442\u0435\u043d\u043e\u043a (\u0438\u0437-\u0437\u0430
    \u043f\u043e\u0434\u0432\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u0447\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u0431\u0445\u043e\u0434\u0438\u0442 \u0433\u043e\u0440\u0443)."
  interestingFactsEn: "The life and work of Eratosphen are full of amazing nuances that go far beyond a dry academic restatement. Many of these facts reveal it as a witty, practical, and even a little sarcastic. Here is the most detailed collection of interesting facts that shed light on the personality and methods of \"Father of Geography\".Physical geography: \"The deck\" and \"The camel\" as measuring instruments, not a well, but a \"top\" calculation: school textbooks often say that Eratosphene used a well in Siena, where the sun lit the bottom. In fact, it used a different, more witty method. Siena was in the way of caravans, and local residents noticed that at midday summer solstice vertical poles did not cast shadows.But how do you measure the distance between cities without maps? Eratosphene didn't go from city to city. He hired professional bematists -- specially trained slaves who counted the steps -- but most importantly, he adjusted their data. The bematists did not walk straight, but on a windy road along Neil. Eratosphen knew that the path repeated the bends of the river, and mathematically straightened the curve based on the average speed of camel caravans (about 100 steps a day).So he got his famous 5,000 stages. The mistake that saved Columbus: The result that Eratosphene (about 250,000 steps) received was incredibly close to the truth (just ~2% higher, if you count in Egyptian stages). However, in the Middle Ages and the Renaissance, scientists used later, very low estimates of Posidonia (about 29,000 km).It is this erroneous data that convinced Christopher Columbus that to sail west to Asia with his hand. If Columbus knew the correct figure of Eratosphene, he would have been afraid of the distance and probably wouldn't have sailed away. --2 Library policy: \"The Boat Tax\", being the head of the Alexandre Library, Eratosphene has shown himself as an obsessive knowledge collector.Confiscation at the border: He issued a decree stating that all ships arriving at the port of Alexandria were subject to a search for the availability of books; if a scroll was on board, it was not merely copied but confiscated in favour of the library; the owner was returned a copy made by local censusers and the original remained in the book store.State robbery for the sake of science: On one occasion, the State archives of ancient Greek tragedies (Eshila, Sofocla, Euripida) were brought from Athens to Alexandria for temporary \"intelligence.\" Eratosphene paid the Athensns a huge deposit for the opportunity to rewrite the texts, but then claimed to keep the originals, and he gave bail (in exchange for loss) to the Athenians.Chronology: Laughter at the stars of Eratosphene was the first to try to mock astrologers and popular superstitions about \"floating stars.\" The theory of dog scare: In his work, he made it clear that falling stars were not the omens or the souls of people. He assumed that they were particulates that burned in the atmosphere.He also figured out that if a star \"falls\", it actually flies past us at a huge speed, and it's visually similar to you throwing a rock from a high tower. -- 4. A map error: The argument with Homer Eratosfen was known by his skepticism towards poets, especially Homer.Critic Odyssey: He pissed off that if Homer were right describing Odyssey's voyages, he would have sailed the distance comparable to a round-the-world journey, and within a single Mediterranean sea. \"Odyssey is not a geography\": When critics accused him of being too \"compressed\" and deprived of poetic beauty, he said, \"Geography should be reliable, not fascinating. The map is not literature, it is a drawing.\"---5. Mathematical humor: How did he catch the primes of Resheto Eratosphen, perhaps the oldest algorithm, but it was called \"Rechet\" by accident. The execution technique: He took the papyrus, wrote the numbers between 1 and 100,000, then took the sharp stick and he punctured (cut) all the composite numbers. The papyrus became like a silly.In the original Greek text, he compared this process with the sieving of flour through a sieve, where prime numbers remained \"on the surface\", and holes were at the site of complex numbers. -- 6. Friendship with Archimedes: Spy Games between Alexandria (where Eratosphene lived) and Siracusamy (where Archimedes lived) were active correspondence.\"Obster task\": Archimedes sent Eratosphen a famous task that contains an equation with eight unknowns (known as the \"Early task\"). It was not just a mathematical puzzle. Archimedes was proud to have created a task that looked simple but actually required work with huge numbers (the decision has 206,545 digits). He challenged Eratosphene knowing that he loved difficult computations.Mechanical solution: In response, Eratosphene did not suffer with equations, but simply sent Archimedes a drawing of his mesolabia. He wrote: \"Lovy, Archimedes, it's easier than thinking with your head, just move the bar.\" --7 Personal tragedy and \"Dieta\" voluntary retirement from life due to blindness is a fact, but he has an interesting detail.The scientist who made his last breath: Story of Plutarch mentions that before he began a hunger strike, Eratosthenes ordered his slaves to read out the last tract he had not known of the orbits. When the book was finished, he said, \"Now I know everything I need to know about the heavens, but I will never see it again,\" and refused to eat.Some sources say that he died at the age of 80, others at the age of 82, and interestingly that this confusion arose because he himself confused the calendars by introducing a new system of Olympic summer counting, and historians could not then meet the exact date of his own death. --8. Postmortem smokes: Moon crater and seamount.The crater on the moon: The impact crater, about 60 km in diameter, is located in the visible part of the moon, its characteristic being that it has very steep walls and young age (in the geological sense it is about 1.1 billion years), and the moon period, called the Eratosphenian period, is called \"The Eratosphenian period.\" Astronomers chose that name because Eratosphen was the first to try to divide the history of the Earth into an era (periods).Mount Eratosphene: In the Mediterranean, south of Crete, there is an underwater mountain whose top does not reach the surface of the water about 700 metres away, named after him because he was the first to map the area and pointed out that the sea has a strange blue shade (because of the water current that bypasss the mountain)."
