  achievementsRu: "\u041a\u043e\u043d\u0435\u0447\u043d\u043e. \u0415\u0441\u043b\u0438 \u043e\u0442\u0431\u0440\u043e\u0441\u0438\u0442\u044c
    \u043a\u0440\u0430\u0442\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440 \u0438 \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u0442\u044c\u0441\u044f
    \u0432 \u0434\u0435\u0442\u0430\u043b\u0438, \u0442\u043e \u043e\u043a\u0430\u0436\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u00ab\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u043e\u043c\u00bb,
    \u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u043c
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b
    \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044e.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0441\u043f\u0438\u0441\u043e\u043a \u0444\u0430\u043a\u0442\u043e\u0432,
    \u0430 \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u044b\u0445 \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u0432 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043c\u044b \u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u0441\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440. \u041d\u0438\u0436\u0435 \u044f \u0440\u0430\u0437\u0431\u0438\u043b
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043d\u0435
    \u043f\u043e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u043c, \u0430
    \u043f\u043e \u0441\u0443\u0442\u0438 \u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0433\u043b\u0443\u0431\u0438\u043d\u0443
    \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u044f. 1. \u0413\u0435\u043e\u0434\u0435\u0437\u0438\u044f
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f: \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435
    \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043e\u0433\u043e (\u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430) \u0421\u0430\u043c\u043e\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u2014 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435
    \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438 \u0417\u0435\u043c\u043b\u0438
    \u2014 \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439 \u0435\u0433\u043e \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430. \u0417\u0434\u0435\u0441\u044c \u0432\u0430\u0436\u043d\u043e
    \u043d\u0435 \u0447\u0438\u0441\u043b\u043e (\u043f\u0443\u0441\u0442\u044c \u0434\u0430\u0436\u0435
    \u0438 \u0442\u043e\u0447\u043d\u043e\u0435), \u0430 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b.
    \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c:
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0438\u0441\u0445\u043e\u0434\u0438\u043b
    \u0438\u0437 \u043f\u043e\u0441\u0442\u0443\u043b\u0430\u0442\u0430, \u0447\u0442\u043e
    \u0421\u043e\u043b\u043d\u0446\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0430\u043b\u0435\u043a\u043e,
    \u0447\u0442\u043e \u0435\u0433\u043e \u043b\u0443\u0447\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442
    \u043d\u0430 \u0417\u0435\u043c\u043b\u044e \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u043f\u0443\u0447\u043a\u0430\u043c\u0438. \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u0441\u043c\u0435\u043b\u043e\u0435 \u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432 \u0442\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430
    \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u043b\u0438 \u043d\u0435 \u0432\u0441\u0435.
    \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439: \u041e\u043d
    \u043d\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432. \u0415\u0433\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0441\u0442\u0430\u043b \u0441\u043a\u0430\u0444\u0438\u0441 (\u0447\u0430\u0448\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0435 \u0447\u0430\u0441\u044b). \u0412
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u043e\u043d \u0437\u0430\u043c\u0435\u0440\u0438\u043b
    \u0443\u0433\u043e\u043b \u043c\u0435\u0436\u0434\u0443 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c
    \u0448\u0435\u0441\u0442\u043e\u043c (\u0433\u043d\u043e\u043c\u043e\u043d\u043e\u043c)
    \u0438 \u0442\u0435\u043d\u044c\u044e. \u0423\u0433\u043e\u043b \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    1/50 \u0447\u0430\u0441\u0442\u044c \u043a\u0440\u0443\u0433\u0430. \u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0435
    \u043d\u043e\u0443-\u0445\u0430\u0443: \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c \u0448\u0438\u0440\u043e\u0442, \u0430
    \u043d\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u043e \u043a\u0430\u0440\u0442\u0435.
    \u041e\u043d \u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u0432 \u0421\u0438\u0435\u043d\u0435
    (\u0410\u0441\u0443\u0430\u043d) \u0432 \u0434\u0435\u043d\u044c \u0441\u043e\u043b\u043d\u0446\u0435\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u0421\u043e\u043b\u043d\u0446\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432 \u0437\u0435\u043d\u0438\u0442\u0435
    (\u043e\u0441\u0432\u0435\u0449\u0430\u0435\u0442 \u0434\u043d\u043e \u043a\u043e\u043b\u043e\u0434\u0446\u0435\u0432).
    \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e
    \u0421\u0438\u0435\u043d\u0430 \u043b\u0435\u0436\u0438\u0442 \u0442\u043e\u0447\u043d\u043e
    \u043d\u0430 \u043b\u0438\u043d\u0438\u0438 \u0442\u0440\u043e\u043f\u0438\u043a\u0430.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435
    \u043c\u0435\u0436\u0434\u0443 \u0433\u043e\u0440\u043e\u0434\u0430\u043c\u0438 \u2014 \u044d\u0442\u043e
    \u0434\u0443\u0433\u0430 \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d\u0430 \u0432 7,2
    \u0433\u0440\u0430\u0434\u0443\u0441\u0430. \u041f\u043e\u043f\u0440\u0430\u0432\u043a\u0430
    \u043d\u0430 \u0440\u0435\u0430\u043b\u0438\u0438: \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0443\u0441\u043b\u043e\u0436\u043d\u0438\u043b \u0440\u0430\u0441\u0447\u0435\u0442. \u041e\u043d
    \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u044f
    \u0438 \u0421\u0438\u0435\u043d\u0430 \u043d\u0435 \u043b\u0435\u0436\u0430\u0442 \u043d\u0430
    \u043e\u0434\u043d\u043e\u043c \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d\u0435 (\u0440\u0430\u0437\u043d\u0438\u0446\u0430
    \u0432 \u0434\u043e\u043b\u0433\u043e\u0442\u0435 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442
    \u043e\u043a\u043e\u043b\u043e 3\u00b0). \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u043d
    \u043d\u0435 \u0441\u0442\u0430\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438
    \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c 5000 \u0441\u0442\u0430\u0434\u0438\u0435\u0432
    \u043d\u0430 50. \u041e\u043d \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043f\u0440\u043e\u0435\u0446\u0438\u0440\u043e\u0432\u0430\u043b
    \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043c\u0435\u0436\u0434\u0443
    \u0433\u043e\u0440\u043e\u0434\u0430\u043c\u0438 \u043d\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0435\u0432\u0435\u0440-\u044e\u0433, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u0441\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435, \u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u043e\u0442\u043e\u043c \u043c\u043d\u043e\u0436\u0438\u043b. \u042d\u0442\u043e
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0435\u0433\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u043c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0438. --- 2. \u041a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f:
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043d\u043e\u0439
    \u0441\u0435\u0442\u043a\u0438 (\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434)
    \u0414\u043e \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430 \u043a\u0430\u0440\u0442\u044b
    \u0431\u044b\u043b\u0438 \u043f\u043e\u0445\u043e\u0436\u0438 \u043d\u0430 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0435
    \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0430\u0446\u0438\u0438: \u0431\u0435\u0440\u0435\u0433\u0430
    \u0440\u0438\u0441\u043e\u0432\u0430\u043b\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u043e,
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0443\u044f\u0441\u044c \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f\u043c\u0438
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432.
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u041a\u0430\u0440\u0442\u0430 \u0434\u043e\u043b\u0436\u043d\u0430
    \u0441\u0442\u0440\u043e\u0438\u0442\u044c\u0441\u044f \u043f\u043e \u0437\u0430\u043a\u043e\u043d\u0430\u043c
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb. \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u043a\u043b\u0438\u043c\u0430\u0442\u043e\u0432 (\u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u0435\u0439):
    \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0440\u0438\u0441\u043e\u0432\u0430\u043b
    \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043b\u0438\u043d\u0438\u0438.
    \u041e\u043d \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043b \u0438\u0445 \u043a \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u0438
    \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u0441\u0442\u0430, \u0433\u0434\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0441\u0430\u043c\u043e\u0433\u043e \u0434\u043b\u0438\u043d\u043d\u043e\u0433\u043e \u0434\u043d\u044f
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 13, 14, 15 \u0438 16 \u0447\u0430\u0441\u043e\u0432.
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e \u043b\u044e\u0431\u043e\u043c\u0443
    \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u0442\u0435\u043b\u044e, \u0437\u043d\u0430\u044f
    \u0448\u0438\u0440\u043e\u0442\u0443, \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f. \u041f\u044f\u0442\u044c \u0437\u043e\u043d:
    \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u0447\u0435\u0442\u043a\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u043b
    \u0417\u0435\u043c\u043b\u044e \u043d\u0430 \u0436\u0430\u0440\u043a\u0438\u0439, \u0434\u0432\u0430
    \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0445 \u0438 \u0434\u0432\u0430 \u0445\u043e\u043b\u043e\u0434\u043d\u044b\u0445
    \u043f\u043e\u044f\u0441\u0430, \u043e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u044f\u0441\u044c
    \u043d\u0430 \u0443\u0433\u043b\u0435 \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445
    \u043b\u0443\u0447\u0435\u0439. \u041e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b, \u043f\u043e\u0447\u0435\u043c\u0443
    \u0432 \u0436\u0430\u0440\u043a\u043e\u043c \u043f\u043e\u044f\u0441\u0435 (\u043c\u0435\u0436\u0434\u0443
    \u0442\u0440\u043e\u043f\u0438\u043a\u0430\u043c\u0438) \u043b\u044e\u0434\u0438 \u043e\u0431\u0433\u043e\u0440\u0430\u044e\u0442,
    \u0430 \u0432 \u0445\u043e\u043b\u043e\u0434\u043d\u044b\u0445 (\u0437\u0430 \u043f\u043e\u043b\u044f\u0440\u043d\u044b\u043c\u0438
    \u043a\u0440\u0443\u0433\u0430\u043c\u0438) \u2014 \u043f\u043e\u043b\u044f\u0440\u043d\u0430\u044f
    \u043d\u043e\u0447\u044c. \u041c\u0435\u0440\u0438\u0434\u0438\u0430\u043d\u044b: \u041e\u043d
    \u0432\u044b\u0431\u0440\u0430\u043b \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d,
    \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0449\u0438\u0439 \u0447\u0435\u0440\u0435\u0437
    \u043e\u0441\u0442\u0440\u043e\u0432 \u0420\u043e\u0434\u043e\u0441 (\u0432\u0430\u0436\u043d\u044b\u0439
    \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0443\u0437\u0435\u043b),
    \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0437\u043c\u0435\u0440\u044f\u0442\u044c
    \u0434\u043e\u043b\u0433\u043e\u0442\u0443, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0432\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445 \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0439
    (\u0445\u043e\u0442\u044f \u0434\u043b\u044f \u0442\u043e\u0447\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0439
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u044d\u0442\u043e \u0431\u044b\u043b\u043e
    \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043b\u043e\u0436\u043d\u043e,
    \u0438\u0434\u0435\u044f \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u0445\u0440\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438).
    --- 3. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u041e\u0442 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0438
    \u043a \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0443 (\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438) \u0417\u0434\u0435\u0441\u044c
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u0442\u043e\u043c, \u043a\u0430\u043a
    \u043c\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u043c \u0441 \u0447\u0438\u0441\u043b\u0430\u043c\u0438.
    \u00ab\u0420\u0435\u0448\u0435\u0442\u043e \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430\u00bb
    (\u0422\u0435\u043e\u0440\u0438\u044f \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432):
    \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431
    \u043d\u0430\u0439\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0447\u0438\u0441\u043b\u0430.
    \u042d\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430 \u0437\u0430\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u00ab\u043e\u0442\u0441\u0435\u0432\u0430\u00bb
    (sieve algorithm). \u0412 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0435
    \u044d\u0442\u043e\u0442 \u043f\u0440\u0438\u043d\u0446\u0438\u043f (\u043f\u0435\u0440\u0435\u0431\u043e\u0440
    \u0441 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435\u043c \u043b\u0438\u0448\u043d\u0435\u0433\u043e)
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440. \u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u0435\u0442\u0430\u043b\u044c:
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0434\u043e\u0448\u0435\u043b \u0432
    \u0441\u0432\u043e\u0438\u0445 \u0442\u0430\u0431\u043b\u0438\u0446\u0430\u0445 \u043d\u0435
    \u0434\u043e 100 \u0438\u043b\u0438 1000, \u0430 \u0434\u043e 100 000. \u042d\u0442\u043e
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0431\u044a\u0435\u043c
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u0440\u0443\u0447\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430. \u0412\u0430\u0436\u043d\u043e, \u0447\u0442\u043e \u043e\u043d
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0448\u0435\u043b \u0447\u0438\u0441\u043b\u0430,
    \u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0434\u043b\u044f
    \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0447\u0438\u0441\u043b\u0430 `N` \u043d\u0430
    \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u0443 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0434\u0435\u043b\u0438\u0442\u044c \u0435\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0447\u0438\u0441\u043b\u0430,
    \u043d\u0435 \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0435
    \u221aN. \u042d\u0442\u043e \u0440\u0435\u0437\u043a\u043e \u0441\u043e\u043a\u0440\u0430\u0449\u0430\u043b\u043e
    \u0442\u0440\u0443\u0434\u043e\u0437\u0430\u0442\u0440\u0430\u0442\u044b \u0438 \u0431\u044b\u043b\u043e
    \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b \u043a \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u0438
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439. \u041c\u0435\u0437\u043e\u043b\u044f\u0431\u0438\u0439
    (\u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439): \u0417\u0430\u0434\u0430\u0447\u0430
    \u043e\u0431 \u0443\u0434\u0432\u043e\u0435\u043d\u0438\u0438 \u043a\u0443\u0431\u0430 \u0437\u0432\u0443\u0447\u0438\u0442
    \u043a\u0430\u043a `x\u00b3 = 2a\u00b3`. \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0440\u0438\u0431\u043e\u0440 \u0438\u0437 \u0442\u0440\u0435\u0445 \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u044b\u0445
    \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432,
    \u0434\u0432\u0438\u0433\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043f\u043e \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u043c
    \u043f\u0430\u0437\u0430\u043c. \u042d\u0442\u043e\u0442 \u043f\u0440\u0438\u0431\u043e\u0440
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b \u043d\u0430\u0439\u0442\u0438 \u0434\u0432\u0435
    \u0441\u0440\u0435\u0434\u043d\u0438\u0435 \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u043c\u0435\u0436\u0434\u0443 \u043e\u0442\u0440\u0435\u0437\u043a\u0430\u043c\u0438. \u041f\u043e
    \u0441\u0443\u0442\u0438, \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0439
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440, \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u0439
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0442\u0440\u0435\u0442\u044c\u0435\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c. \u042d\u0442\u043e \u0431\u044b\u043b
    \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043b\u0438\u043d\u0435\u0435\u043a \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0442\u043e\u0440\u043e\u0432.
    --- 4. \u0425\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043e\u0441\u0438 (\u0418\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430) \u0414\u043e \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430
    \u0434\u0430\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u0439
    \u0431\u044b\u043b\u0430 \u0445\u0430\u043e\u0442\u0438\u0447\u043d\u043e\u0439: \u00ab\u0432
    \u0433\u043e\u0434 \u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0442\u0430\u043a\u043e\u0433\u043e-\u0442\u043e
    \u0446\u0430\u0440\u044f\u00bb \u0438\u043b\u0438 \u00ab\u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0442\u0430\u043a\u043e\u0439-\u0442\u043e \u041e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u044b\u00bb.
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0443\u044e \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044e.
    \u041e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u0430\u044f \u044d\u0440\u0430: \u041e\u043d
    \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u00ab\u041e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u0438\u0435
    \u043f\u043e\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u0438\u00bb \u2014 \u0441\u043f\u0438\u0441\u043e\u043a,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u0441\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0435\u043c\u0443
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f (\u043e\u0442 \u0422\u0440\u043e\u044f\u043d\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0434\u043e \u043f\u043e\u0445\u043e\u0434\u043e\u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430)
    \u0441 \u0433\u043e\u0434\u0430\u043c\u0438 \u041e\u043b\u0438\u043c\u043f\u0438\u0430\u0434.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u043c\u0438\u0444\u043e\u0432: \u041e\u043d \u043d\u0435 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b
    \u043c\u0438\u0444\u044b \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e. \u041e\u043d
    \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0435 \u0434\u0430\u0442\u044b
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u0435
    \u0422\u0440\u043e\u0438) \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u0430\u0442\u044b, \u0432\u044b\u0447\u0438\u0442\u0430\u044f \u00ab\u0441\u0440\u0435\u0434\u043d\u044e\u044e
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0436\u0438\u0437\u043d\u0438 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439\u00bb
    (\u043e\u043d \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b \u0435\u0451 \u0437\u0430
    40 \u043b\u0435\u0442) \u0438\u0437 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0434\u0430\u0442 \u043f\u043e\u0437\u0434\u043d\u0435\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0438.
    \u0422\u0430\u043a \u043e\u043d \u0432\u044b\u0432\u0435\u043b \u0434\u0430\u0442\u0443
    \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0422\u0440\u043e\u0438 \u2014 1184 \u0433\u043e\u0434
    \u0434\u043e \u043d. \u044d. \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0430\u0440\u0445\u0435\u043e\u043b\u043e\u0433\u0438
    (\u0428\u043b\u0438\u043c\u0430\u043d \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435)
    \u0434\u0430\u0442\u0438\u0440\u0443\u044e\u0442 \u0422\u0440\u043e\u044e VIIa \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    1190\u20131180 \u0433\u043e\u0434\u0430\u043c\u0438 \u0434\u043e \u043d. \u044d. \u041e\u0448\u0438\u0431\u043a\u0430
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430
    \u043c\u0435\u043d\u044c\u0448\u0435 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f!
    --- 5. \u0424\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u044f \u0438 \u043a\u0440\u0438\u0442\u0438\u043a\u0430
    \u0442\u0435\u043a\u0441\u0442\u0430 (\u0413\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u0435
    \u043d\u0430\u0443\u043a\u0438) \u041d\u0430 \u043f\u043e\u0441\u0442\u0443 \u0433\u043b\u0430\u0432\u044b
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0441\u0435\u0431\u044f \u043a\u0430\u043a \u0441\u0442\u0440\u043e\u0433\u0438\u0439
    \u043a\u0440\u0438\u0442\u0438\u043a. \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u043f\u0440\u043e\u0442\u0438\u0432 \u043f\u043e\u044d\u0437\u0438\u0438: \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u041a\u0430\u043b\u043b\u0438\u043c\u0430\u0445\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438\u0441\u043a\u0430\u043b \u043a\u0440\u0430\u0441\u043e\u0442\u0443, \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0437\u0430\u044f\u0432\u043b\u044f\u043b, \u0447\u0442\u043e \u00ab\u043f\u043e\u044d\u0442
    \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0436\u0434\u0435
    \u0432\u0441\u0435\u0433\u043e \u0437\u043d\u0430\u044e\u0449\u0438\u043c\u00bb. \u041e\u043d
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b \u0413\u043e\u043c\u0435\u0440\u0430
    \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u0442\u043e\u0442 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u044b\u0435
    \u044f\u0432\u043b\u0435\u043d\u0438\u044f. \u0410\u0442\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u043e\u043c\u0435\u0434\u0438\u044f: \u041e\u043d \u0438\u0437\u0434\u0430\u043b
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u0430\u0442\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u043e\u043c\u0435\u0434\u0438\u043e\u0433\u0440\u0430\u0444\u043e\u0432 (\u0410\u0440\u0438\u0441\u0442\u043e\u0444\u0430\u043d\u0430
    \u0438 \u0434\u0440.), \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u0432 \u0437\u043d\u0430\u043a\u0438
    \u0443\u0434\u0430\u0440\u0435\u043d\u0438\u0439 \u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0432
    \u0442\u0435\u043a\u0441\u0442 \u043d\u0430 \u0441\u0442\u0440\u043e\u043a\u0438. \u042d\u0442\u043e
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u043e\u043f\u044b\u0442 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e (\u043d\u0435
    \u0441\u0446\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e) \u0442\u0435\u043a\u0441\u0442\u0430.
    \u00ab\u041e \u0434\u0440\u0435\u0432\u043d\u0435\u0439 \u043a\u043e\u043c\u0435\u0434\u0438\u0438\u00bb:
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u0432 12 \u043a\u043d\u0438\u0433\u0430\u0445, \u0433\u0434\u0435 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b,
    \u0447\u0442\u043e \u043a\u043e\u043c\u0435\u0434\u0438\u0438 \u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u0442\u0440\u043e\u0435\u043c \u0410\u0444\u0438\u043d. \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u0437\u0430\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u043e\u0446\u0438\u043e\u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0438
    \u2014 \u0438\u0434\u0435\u0438, \u0447\u0442\u043e \u044f\u0437\u044b\u043a \u0438 \u0436\u0430\u043d\u0440
    \u0437\u0430\u0432\u0438\u0441\u044f\u0442 \u043e\u0442 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430. --- 6. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f:
    \u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u043d\u0435\u0431\u0430 \u041a\u0430\u0442\u0430\u0441\u0442\u0435\u0440\u0438\u0437\u043c\u044b
    (\u03a0\u03b5\u03c1\u03af \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03b5\u03c1\u03b9\u03c3\u03bc\u1ff6\u03bd):
    \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0431\u043e\u0440\u043d\u0438\u043a
    \u043c\u0438\u0444\u043e\u0432 \u043e \u0441\u043e\u0437\u0432\u0435\u0437\u0434\u0438\u044f\u0445.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0432\u043a\u043b\u044e\u0447\u0430\u043b\u0430
    \u0432 \u0441\u0435\u0431\u044f \u0437\u0432\u0435\u0437\u0434\u043d\u044b\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433,
    \u0433\u0434\u0435 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0437\u0432\u0435\u0437\u0434 \u0438
    \u0438\u0445 \u044f\u0440\u043a\u043e\u0441\u0442\u044c. \u0425\u043e\u0442\u044f \u0434\u043e
    \u043d\u0430\u0441 \u0434\u043e\u0448\u0435\u043b \u043b\u0438\u0448\u044c \u043c\u0438\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437 \u0413\u0438\u0433\u0438\u043d\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0434\u0430\u0432\u0430\u043b \u044d\u043a\u0432\u0430\u0442\u043e\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b \u0437\u0432\u0435\u0437\u0434
    \u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u043b \u0438\u0445 \u0446\u0432\u0435\u0442
    (\u043a\u0440\u0430\u0441\u043d\u044b\u0435, \u0436\u0435\u043b\u0442\u044b\u0435, \u0431\u0435\u043b\u044b\u0435).
    \u0422\u0440\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u043e\u0434: \u041e\u043d
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0433\u043e\u0434\u0430 \u0432 365 \u0434\u043d\u0435\u0439 \u0438 6 \u0447\u0430\u0441\u043e\u0432
    (\u0442\u043e\u0447\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u2014
    365 \u0434\u043d\u0435\u0439 5 \u0447\u0430\u0441\u043e\u0432 48 \u043c\u0438\u043d\u0443\u0442).
    \u0418 \u0445\u043e\u0442\u044f \u043e\u043d \u043e\u0448\u0438\u0431\u0441\u044f \u043d\u0430
    12 \u043c\u0438\u043d\u0443\u0442, \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0432\u0438\u0441\u043e\u043a\u043e\u0441\u043d\u044b\u0439
    \u0434\u0435\u043d\u044c (\u043a\u0430\u0436\u0434\u044b\u0435 4 \u0433\u043e\u0434\u0430),
    \u0447\u0435\u043c \u043d\u0430 100 \u043b\u0435\u0442 \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b
    \u044e\u043b\u0438\u0430\u043d\u0441\u043a\u0438\u0439 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c.
    \u0418\u0442\u043e\u0433: \u0427\u0442\u043e \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b
    \u0441 \u043d\u0430\u0443\u043a\u043e\u0439? \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0435\u0440\u0435\u0445\u043e\u0434
    \u043e\u0442 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u044f \u0444\u0430\u043a\u0442\u043e\u0432
    (\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435 \u0441\u043e\u0437\u0435\u0440\u0446\u0430\u043d\u0438\u0435)
    \u043a \u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e (\u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0430\u044f
    \u043d\u0430\u0443\u043a\u0430). \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u044c
    \u0442\u043e, \u0447\u0442\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u043f\u043e\u0442\u0440\u043e\u0433\u0430\u0442\u044c, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0438 \u043b\u043e\u0433\u0438\u043a\u0443.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u2014 \u043d\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0446\u0438\u0444\u0440\u044b
    (\u043e\u043d\u0438 \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b),
    \u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f
    \u043f\u043e\u0437\u043d\u0430\u0432\u0430\u0435\u043c\u0430. \u041e\u043d \u0432\u0432\u0435\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0435\u0439:
    \u0435\u0441\u043b\u0438 \u0442\u0432\u043e\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0443\u0433\u043e\u043b \u0442\u0435\u043d\u0438 \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438
    \u0438 \u0434\u043b\u0438\u043d\u0443 \u0434\u043d\u044f \u0432 \u0421\u0438\u0435\u043d\u0435,
    \u0437\u043d\u0430\u0447\u0438\u0442, \u043c\u043e\u0434\u0435\u043b\u044c \u0432\u0435\u0440\u043d\u0430,
    \u0438 \u0417\u0435\u043c\u043b\u044f \u2014 \u0448\u0430\u0440. \u0418\u043c\u0435\u043d\u043d\u043e
    \u044d\u0442\u043e\u0442 \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0441\u0434\u0435\u043b\u0430\u043b
    \u0435\u0433\u043e \u00ab\u043e\u0442\u0446\u043e\u043c\u00bb \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0438, \u043d\u043e \u0438 \u0432\u0441\u0435\u0433\u043e
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u043e\u0437\u043d\u0430\u043d\u0438\u044f."
  achievementsEn: "Of course, if you put aside the brief and dive into the details, it turns out that Eratosphene was not just a \"universal\" person, but a person who used an innovative methodology in every particular study, and his contribution to science is not a list of facts, but a list of fundamentally new ways of thinking that we still use, and I have broken down his achievements not by discipline, but by essentially solving the problems, to show the depth of his genius.Geodesy and astronomy: Measuring the invisible (Esperimental Physics) is the most famous achievement -- measuring the Earth's circle -- is actually the top of its application. It's not the number (even if it's accurate) that matters here, but the algorithm of the hypotheses. The geometric model: Eratosphene was derived from the postulate that the sun is so far away that its rays come to Earth with parallel beams.It was a bold assumption, which was not shared by everything at the time. The toolbox: He did not invent sophisticated instruments. His tool was a scafis (scaffeine sunglasses). In Alexandria, he measured the angle between a vertical sixth (Nhanmon) and a shadow. The angle was 1/50 part of the circle. The key know-how: He used latitude, not map distance.He knew that the sun stood in the sun on the day of the solstice, and he knew that Siena was on the straight line of the tropic.He first projected the distance between the cities to the north-south direction, with an adjusted value, and then he multiplied, which indicates his brilliant spatial thinking. -- 2. Mapping: The creation of a grid (system approach) to Eratosthenes was like a literary illustration: the banks were sketched at random, based on the descriptions of travelers.He said first, \"The carta should be built according to the laws of geometry.\" The introduction of climates (parallels): He did not merely draw horizontal lines; he tied them to astronomical phenomena; for example, he drew parallels through places where the longest day was 13, 14, 15 and 16 hours; this allowed any seafarer to understand the conditions of the climate, knowing the latitude.Five zones: He was the first to clearly divide the earth into hot, two moderate, and two cold belts, based on the angle of sunfall, and he mathematically explained why people burn in the hot belt (between the trails) and in the cold (out of the polar circles) the polar night.Meridian: He chose a zero meridian passing through Rhodes Island (an important navigation node) and suggested measuring longitude using the time difference of solar eclipses (although it was technically difficult to measure it accurately at that time, the idea became the foundation of future chronometrics). --3 Mathematics: From abstraction to algorithm (Information technology) Here, Eratosphene revolutionized the way we work with numbers.\"Seve algorifen\" (Theory of algorithms): This is not just a way to find simple numbers. This is the first ever documented \"abandonment\" algorithm in human history. It is still used in computer science. The technical detail: Eratosthenes has reached 100 or 1,000 rather than 100,000 in their tables. This is a huge amount of calculations for manual labor.What's important is that he didn't just find the numbers, but he proved that to test the number `N' by simplicity, it would be enough to divide it only by simple numbers that do not exceed GN. This drastically reduced the time and was the first application of the number theory to optimize computations. Mesolabi (Cube Equation Decision): The task of doubling the cube sounds like `x3 = 2a3'.Eratosphene designed a mechanical device of three movable rectangular triangles moving along parallel steps. This device found two average proportions between the segments. In fact, it created an analog computer that determined the third degree equation by graphical means. It was a representation of logarithmic lenses and integrators. -- 4.Chronology: The creation of a time axis (historical statistics) prior to Eratosphen was a chaotic date: \"in the year of such a king's rule\" or \"in the time of such an Olympiad.\" Eratosphene created an absolute timeline. The Olympic era: He compiled \"Olympic winners\", a list in which he synchronized all events known to him (from the Trojan War to Alexander's trips) over the years.Mathematical processing of myths: He didn't take myths literally. He tried to translate legendary dates (e.g. the destruction of Troy) into real historical dates, subtracting \"the average life expectancy of generations\" (he took it in 40 years) from known dates of late history.So he drew the date of Troy's fall - 1184 BCE amazingly, but modern archaeologists (Schliman et al.) date Troy VIIa about 1190 - 1180 BCE's error was less than a decade! --5. Philology and criticism of the text (Humanities) at the head of the Alexandre's library, Eratosphene, proved to be a strict critic.Philosophy versus poetry: Unlike his teacher Kallimach, who was looking for beauty, Eratosphene stated that \"a poet must be first known.\" He criticized Homer for describing impossible natural phenomena. Attic comedy: He published a scientific critical edition of athetic comedians (Aristofan et al.), setting out the signs of impact and dividing the text into lines.This was the first experience of creating an academic (not staged) text. \"On ancient comedy\": He wrote a tract in 12 books that proved that comedy had changed with the political structure of Athens. It was the birth of sociolinguistics, the idea that language and genre depended on the social context. -- 6. Astronomy: Sizing the sky of Catasterism.This work included a star catalog where Eratosthenes described the position of the stars and their brightness. Although we have only learned the mythological recapitulation of Gigin, it is known that in the original, Eratosphene gave the equator coordinates of the stars and marked their colour (red, yellow, white).And although he was wrong for 12 minutes, he suggested using a temple day (every four years) before 100 years ahead of the Julian calendar.His main achievement is not specific numbers (they were approximate), but evidence that the universe is known, and he introduced a principle that is now called verification: if your mathematical model predicts the angle of the shadow in Alexandria and the length of the day in Siena, then the model is true, and the Earth is a ball, which is what made him \"father\" not only of geography, but of all experimental natural knowledge."
  personalLifeRu: "\u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0445\u0443\u0436\u0435. \u041e\u043d\u0430
    \u043d\u0435 \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430
    \u0433\u0440\u043e\u043c\u043a\u0438\u043c\u0438 \u0440\u043e\u043c\u0430\u043d\u0430\u043c\u0438
    \u0438\u043b\u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438\u043d\u0442\u0440\u0438\u0433\u0430\u043c\u0438, \u043d\u043e \u0432 \u043d\u0435\u0439
    \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u0438 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u043e\u043c\u0435\u043d\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u0438\u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442
    \u0437\u0430\u0432\u0435\u0441\u0443 \u043d\u0430\u0434 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c
    \u044d\u0442\u043e\u0433\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e.\n\n\U0001F3DB\ufe0f
    \u0421\u0435\u043c\u044c\u044f \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u043e\u043a\u043e\u043b\u043e 276 \u0433\u043e\u0434\u0430 \u0434\u043e \u043d. \u044d.
    \u0432 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u043e\u043b\u043e\u043d\u0438\u0438
    \u041a\u0438\u0440\u0435\u043d\u0430 (\u043d\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u041b\u0438\u0432\u0438\u0438).
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u0435\u0433\u043e
    \u043e\u0442\u0446\u0430 \u0437\u0432\u0430\u043b\u0438 \u0410\u0433\u043b\u0430\u043e\u0441.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u043c, \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u044f
    \u043d\u0435 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b\u0430 \u043a
    \u0437\u043d\u0430\u0442\u043d\u043e\u043c\u0443 \u0440\u043e\u0434\u0443, \u043e \u0447\u0435\u043c
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0440\u0435\u0434\u043a\u043e\u0441\u0442\u044c
    \u0438\u0445 \u0438\u043c\u0435\u043d. \u041e\u0434\u043d\u0430\u043a\u043e \u0434\u0440\u0443\u0433\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u0441\u0447\u0438\u0442\u0430\u044e\u0442,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0438\u043c\u044f, \u043e\u0437\u043d\u0430\u0447\u0430\u044e\u0449\u0435\u0435
    \"\u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f \u0441\u0438\u043b\u0430\",
    \u043c\u043e\u0436\u0435\u0442 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0430
    \u0431\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435,
    \u043a\u0430\u043a \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0441 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442. \u0411\u0443\u0434\u0443\u0449\u0438\u0439
    \u0443\u0447\u0435\u043d\u044b\u0439 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435: \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u0443 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u0437\u0435\u043c\u043b\u044f\u043a\u0430,
    \u043f\u043e\u044d\u0442\u0430 \u0438 \u043a\u0440\u0438\u0442\u0438\u043a\u0430 \u041a\u0430\u043b\u043b\u0438\u043c\u0430\u0445\u0430,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0432 \u0410\u0444\u0438\u043d\u0430\u0445, \u0433\u0434\u0435
    \u043e\u043d \u043f\u043e\u0441\u0435\u0449\u0430\u043b \u0437\u0430\u043d\u044f\u0442\u0438\u044f
    \u0432 \u043f\u043b\u0430\u0442\u043e\u043d\u043e\u0432\u0441\u043a\u043e\u0439 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438.
    \u0412\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043e\u043d \u0442\u0430\u043a
    \u043f\u0440\u043e\u043d\u0438\u043a\u0441\u044f \u0438\u0434\u0435\u044f\u043c\u0438 \u041f\u043b\u0430\u0442\u043e\u043d\u0430,
    \u0447\u0442\u043e \u0441 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u044c\u044e \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0441\u0435\u0431\u044f \"\u043f\u043b\u0430\u0442\u043e\u043d\u0438\u043a\u043e\u043c\".\n\n\U0001F4DA
    \u0416\u0438\u0437\u043d\u044c, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0430\u044f
    \u0437\u043d\u0430\u043d\u0438\u044f\u043c \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u043c
    \u0441\u043e\u0431\u044b\u0442\u0438\u0435\u043c \u0432 \u0436\u0438\u0437\u043d\u0438 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430
    \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u043e\u043a\u043e\u043b\u043e 245 \u0433\u043e\u0434\u0430 \u0434\u043e \u043d. \u044d.
    \u043e\u0442 \u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u0446\u0430\u0440\u044f
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f III \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u0442\u044c
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0443\u044e
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443. \u041e\u043d \u043f\u0440\u0438\u043d\u044f\u043b
    \u044d\u0442\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u044e,
    \u0433\u0434\u0435 \u043f\u0440\u043e\u0432\u0435\u043b \u0432\u0441\u044e \u043e\u0441\u0442\u0430\u0432\u0448\u0443\u044e\u0441\u044f
    \u0436\u0438\u0437\u043d\u044c. \u041d\u0430 \u043f\u043e\u0441\u0442\u0443 \u0433\u043b\u0430\u0432\u044b
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438 \u043e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u043b \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u043c
    \u043a\u043d\u0438\u0436\u043d\u044b\u043c \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435\u043c
    \u0434\u0440\u0435\u0432\u043d\u043e\u0441\u0442\u0438, \u043d\u043e \u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b
    \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0430
    \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u043c\u043e\u043d\u0430\u0440\u0445\u0430.
    \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0431\u044b\u043b \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u0446\u0430\u0440\u044c \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    IV \u0424\u0438\u043b\u043e\u043f\u0430\u0442\u043e\u0440 \u0438 \u0435\u0433\u043e \u0441\u0435\u0441\u0442\u0440\u0430
    \u0410\u0440\u0441\u0438\u043d\u043e\u044f. \u042d\u0442\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0432\u044b\u0441\u043e\u043a\u043e\u043c
    \u0434\u043e\u0432\u0435\u0440\u0438\u0438 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b
    \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u0435\u0439 \u0415\u0433\u0438\u043f\u0442\u0430.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435
    \u0431\u044b\u043b\u0430 \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443
    \u0432\u0441\u0435\u043f\u043e\u0433\u043b\u043e\u0449\u0430\u044e\u0449\u0435\u0439: \u043e\u043d
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435\u043c
    \u0438 \u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043a\u043d\u0438\u0433,
    \u0441\u0442\u0440\u0435\u043c\u044f\u0441\u044c \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435 \u043b\u0443\u0447\u0448\u0438\u043c \u0432
    \u043c\u0438\u0440\u0435.\n\n\U0001F91D \u0414\u0440\u0443\u0436\u0431\u0430 \u0441 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u043c
    \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0445
    \u044f\u0440\u043a\u0438\u0445 \u0444\u0430\u043a\u0442\u043e\u0432 \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430,
    \u0434\u043e\u0448\u0435\u0434\u0448\u0438\u0445 \u0434\u043e \u043d\u0430\u0441, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0435\u0433\u043e \u0434\u0440\u0443\u0436\u0431\u0430 \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441
    \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u0435\u043c \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u043c.
    \u041e\u043d\u0438 \u043e\u0431\u043c\u0435\u043d\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u0438\u0434\u0435\u044f\u043c\u0438 \u0438 \u0442\u0440\u0443\u0434\u0430\u043c\u0438.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0443
    \u0441\u0432\u043e\u0439 \u0432\u0430\u0436\u043d\u044b\u0439 \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00ab\u041c\u0435\u0442\u043e\u0434 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c\u00bb \u0438 \u043f\u043e\u0441\u044b\u043b\u0430\u043b
    \u0435\u043c\u0443 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u00ab\u0417\u0430\u0434\u0430\u0447\u0430
    \u043e \u0431\u044b\u043a\u0430\u0445\u00bb. \u042d\u0442\u0430 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d
    \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u044d\u043b\u0438\u0442\u044b \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\U0001F948
    \u041f\u0440\u043e\u0437\u0432\u0438\u0449\u0430 \u00ab\u0411\u0435\u0442\u0430\u00bb \u0438
    \u00ab\u041f\u0435\u043d\u0442\u0430\u0442\u043b\u00bb \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0439
    \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0434\u0430\u044e\u0442 \u0435\u0433\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0430.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438, \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u044f
    \u0435\u0433\u043e \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u044d\u0440\u0443\u0434\u0438\u0446\u0438\u044e, \u0434\u0430\u043b\u0438 \u0435\u043c\u0443
    \u0434\u0432\u0430 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0430: \u00ab\u041f\u0435\u043d\u0442\u0430\u0442\u043b\u00bb
    (\u03a0\u03ad\u03bd\u03c4\u03b1\u03b8\u03bb\u03bf\u03c2) \u2014 \u043f\u044f\u0442\u0438\u0431\u043e\u0440\u0435\u0446.
    \u042d\u0442\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435 \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u043b\u043e
    \u0435\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u0431\u043b\u0438\u0441\u0442\u0430\u0442\u044c
    \u0432\u043e \u043c\u043d\u043e\u0433\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439. \u00ab\u0411\u0435\u0442\u0430\u00bb (\u0392\u1fc6\u03c4\u03b1)
    \u2014 \u0432\u0442\u043e\u0440\u0430\u044f \u0431\u0443\u043a\u0432\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043b\u0444\u0430\u0432\u0438\u0442\u0430. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u044d\u0442\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435,
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0435 \u043b\u0438\u0448\u0435\u043d\u043d\u043e\u0435
    \u043b\u0435\u0433\u043a\u043e\u0439 \u0438\u0440\u043e\u043d\u0438\u0438, \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u043e
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e, \u0431\u0443\u0434\u0443\u0447\u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u043c
    \u0432\u043e \u0432\u0441\u0435\u043c, \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0435 \u043e\u043d \u0432\u0441\u0435
    \u0436\u0435 \u0443\u0441\u0442\u0443\u043f\u0430\u043b \u043f\u0435\u0440\u0432\u0435\u043d\u0441\u0442\u0432\u043e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c \"\u0430\u043b\u044c\u0444\u0430\u043c\",
    \u0432\u0440\u043e\u0434\u0435 \u0442\u043e\u0433\u043e \u0436\u0435 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0422\u0435\u043c
    \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u043d\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u00ab\u0432\u0442\u043e\u0440\u044b\u043c\u00bb
    \u0431\u044b\u043b\u043e \u0431\u044b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u043e.\n\n\U0001F305
    \u0421\u0442\u0430\u0440\u043e\u0441\u0442\u044c \u0438 \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u044b\u0439
    \u0443\u0445\u043e\u0434 \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0421\u0430\u043c\u0430\u044f
    \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u0430\u044f \u0438 \u0445\u043e\u0440\u043e\u0448\u043e
    \u0437\u0430\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0434\u0435\u0442\u0430\u043b\u044c \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u2014 \u044d\u0442\u043e \u0435\u0435 \u0444\u0438\u043d\u0430\u043b.
    \u0412 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 \u0443 \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430
    \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u043b\u0438\u0441\u044c \u0433\u043b\u0430\u0437\u0430,
    \u0447\u0442\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u043f\u043e\u043b\u043d\u043e\u0439 \u0441\u043b\u0435\u043f\u043e\u0442\u0435.
    \u0414\u043b\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0432\u0441\u044f
    \u0436\u0438\u0437\u043d\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u044b\u043b\u0430
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430 \u0447\u0442\u0435\u043d\u0438\u044e
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439, \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e
    \u0437\u0432\u0435\u0437\u0434 \u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044e
    \u0437\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u043e\u0439, \u043f\u043e\u0442\u0435\u0440\u044f
    \u0437\u0440\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u043b\u0430 \u043d\u0435\u0432\u044b\u043d\u043e\u0441\u0438\u043c\u044b\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c. \u041d\u0435 \u0436\u0435\u043b\u0430\u044f \u043c\u0438\u0440\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0431\u0435\u0441\u043f\u043e\u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043b\u044e\u0431\u0438\u043c\u044b\u043c
    \u0434\u0435\u043b\u043e\u043c, \u0432 194 \u0433\u043e\u0434\u0443 \u0434\u043e \u043d.
    \u044d., \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u043a\u043e\u043b\u043e
    82 \u043b\u0435\u0442, \u043e\u043d \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u043e
    \u0443\u043c\u043e\u0440\u0438\u043b \u0441\u0435\u0431\u044f \u0433\u043e\u043b\u043e\u0434\u043e\u043c.
    \u042d\u0442\u043e\u0442 \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u043a \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e \u0435\u0433\u043e \u0441\u0438\u043b\u044c\u043d\u043e\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0435
    \u0438 \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0441\u0432\u043e\u0435\u0439
    \u0441\u0442\u0440\u0430\u0441\u0442\u0438 \u2014 \u0437\u043d\u0430\u043d\u0438\u044e.
    \u0427\u0442\u043e \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0433\u043e
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442
    \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f, \u0447\u0442\u043e \u043e\u043d \u0442\u0430\u043a
    \u0438 \u043d\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f, \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u044f
    \u043d\u0430\u0443\u043a\u0443 \u0438 \u043f\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438 \u043c\u0438\u0440\u0430 \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0430
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0441\u0435\u0446\u0435\u043b\u043e \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u0441\u0435\u0431\u044f \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044e \u0437\u043d\u0430\u043d\u0438\u044f\u043c,
    \u0434\u043e\u0441\u0442\u0438\u0433 \u0432 \u044d\u0442\u043e\u043c \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0432\u044b\u0441\u043e\u0442, \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438, \u043d\u043e \u0432 \u0438\u0442\u043e\u0433\u0435
    \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f \u0441 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u0435\u0433\u043e \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438."
  personalLifeEn: "Unlike his scientific achievements, the details of Eratosphen's personal life have been much worse in history, not filled with loud novels or political intrigues, but it has its own dramatic moments that open the veil over the character of this great scientist.\n\n==Eratosphen==The family and origin of Eratosphen was born around 276 in the Greek colony of Kiren (in the territory of modern Libya), and his father was known to be Aglios. According to some sources, his family did not belong to a prominent family, as their names are rare, but other researchers believe that his name, meaning \"beautiful force\", may indicate noble origin, as does the possibility of education from an early age.The future scientist received a wide range of education: first in Alexandria, with his famous countryman, poet and critic Kallimach, and then in Athens, where he attended the Platonic Academy, and then he became so enthralled by Plato's ideas that he proudly called himself a platonist.\n\n♪ The life of knowledge in the Central Event of Eratosphene was invited around 245 BCE from King Ptolemy III of Egypt to head the Alexandria Library. He accepted the offer and moved to Alexandria, where he spent the rest of his life. He was not only the head of the Library, but also the head of the largest book congregation of ancients, but also the mentor of the monarch's children.One of his disciples was the future king of Ptolemy IV, Philopetor, and his sister Arcinoa, who spoke of the high confidence of the rulers of Egypt, and his work in the library was truly all-embracing: he was buying and copying books in an effort to make the congregation the best in the world.\n\nThe friendship with Archimedes is one of the few vivid facts of Eratosphen's personal life that came to us is his friendship and scientific cooperation with the great mathematician and inventor Archimedes. They exchanged ideas and works. For example, Archimedes dedicated his important tract, \"Method mechanical theorem\", to Eratosphen and sent him to solve complex problems, such as the famous \"Earf Task\".This correspondence shows that Eratosphen was a recognized member of the intellectual elite of the time.\n\nThe nickname \"Beth\" and \"Pentatle\" is an interesting view of the personality of a scientist. The term \"Contemporary\" has given him two nicknames, \"Penthal\" ( &quot; Pentatle\" ( &quot; ) &quot; , &quot; Pentatl &quot; , &quot; Pentatl &quot; ) &quot; ( &quot; Pentatl &quot; ) &quot; , &quot; Pentat &quot; ( &quot; Pentat &quot; ) &quot; , &quot; The name &quot; The name &quot; , &quot; Beta &quot; ( &quot; Beta &quot; ) is the second letter of the Greek alphabet &quot; .It is believed that this nickname, perhaps not lacking a slight irony, indicated that, as talented in everything, in every single discipline, he still gave way to the first known Alphas, like the same Archimedes in mathematics; however, it would be too simple to call him simply \"second.\"\n\n▪ Old age and voluntary abandonment is the most dramatic and well-documented part of his personal life. Heratosphene's eyes have become inflammable in his old age, leading to complete blindness. For a person whose whole life was dedicated to reading manuscripts, studying stars and observing nature, the loss of vision has become a unbearable blow.In 194, at the age of 82, BCE voluntarily starved himself to death, and this is a sign of his strong character and devotion to his passion — knowledge, and in the area of marital status, there is evidence that he has never married, choosing science and achieving harmony in the family world.Thus, the personal life of Eratosphen is the story of a man who has devoted himself entirely to the service of knowledge, has reached this outstanding height, has been recognized by colleagues, but has finally faced a tragedy that caused his voluntary death."
  shortBioRu: "\u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d \u041a\u0438\u0440\u0435\u043d\u0441\u043a\u0438\u0439
    \u2014 \u044d\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445 \u0410\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438,
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0447\u044c\u0438 \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0431\u0448\u0438\u0440\u043d\u044b,
    \u0447\u0442\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043f\u0440\u043e\u0437\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \u041f\u0435\u043d\u0442\u0430\u0442\u043b\u043e\u043c
    (\u041c\u043d\u043e\u0433\u043e\u0431\u043e\u0440\u0446\u0435\u043c), \u0430 \u043f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u2014 \u00ab\u043e\u0442\u0446\u043e\u043c
    \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0438\u00bb. \u041e\u043d \u0431\u044b\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c,
