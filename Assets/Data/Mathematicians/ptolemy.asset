  achievementsRu: "\u041a\u043b\u0430\u0432\u0434\u0438\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043d\u0430 \u043f\u043e\u043b\u0442\u043e\u0440\u044b \u0442\u044b\u0441\u044f\u0447\u0438
    \u043b\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438, \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0438 \u043e\u043f\u0442\u0438\u043a\u0438. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0441\u044f
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0431\u0440\u0430\u0442\u044c,
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0442\u0440\u0443\u0434\u044b
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432,
    \u0441\u043e\u0437\u0434\u0430\u0432 \u043d\u0430 \u0438\u0445 \u043e\u0441\u043d\u043e\u0432\u0435
    \u0441\u0442\u0440\u043e\u0439\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438, \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0432\u0448\u0438\u0435
    \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u044b\u0435 \u044f\u0432\u043b\u0435\u043d\u0438\u044f.
    \u0412\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b
    \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b
    \u043d\u0438\u0436\u0435.\n\n\U0001F4DA \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb:
    \u0412\u0435\u043d\u0435\u0446 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0438 \u0441\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f,
    \u043f\u043e\u043b\u043d\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u2014 \u00ab\u0412\u0435\u043b\u0438\u043a\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0432 13 \u043a\u043d\u0438\u0433\u0430\u0445\u00bb. \u0410\u0440\u0430\u0431\u044b, \u0447\u0435\u0439
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u043f\u043e\u043f\u0430\u043b \u0432 \u0415\u0432\u0440\u043e\u043f\u0443,
    \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \u00ab\u0410\u043b\u044c-\u041c\u0430\u0434\u0436\u0438\u0441\u0442\u0438\u00bb
    (\u00ab\u0412\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0439\u00bb), \u0447\u0442\u043e
    \u043f\u043e\u0437\u0436\u0435 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u0432 \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb. \u042d\u0442\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0440\u043e\u0434\u0430 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0435\u0439
    \u0438 \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430.
    \u0415\u0451 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u043f\u043e \u043a\u043d\u0438\u0433\u0430\u043c:
    \u041a\u043d\u0438\u0433\u0430 I: \u0417\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0441\u043d\u043e\u0432\u044b \u0433\u0435\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043c\u0438\u0440\u0430. \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u0444\u0435\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u043d\u0435\u0431\u0430 \u0438 \u0417\u0435\u043c\u043b\u0438, \u0435\u0451 \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0432\u043e \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u0417\u0434\u0435\u0441\u044c
    \u0436\u0435 \u0434\u0430\u0435\u0442\u0441\u044f \u0442\u0430\u0431\u043b\u0438\u0446\u0430
    \u0445\u043e\u0440\u0434 \u2014 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043e\u0441\u043d\u043e\u0432\u0430 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0445
    \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432. \u041a\u043d\u0438\u0433\u0430 II: \u041f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430
    \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    \u0420\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044e\u0442\u0441\u044f
    \u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0417\u0435\u043c\u043b\u0438 \u043d\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u043e\u044f\u0441\u0430, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0434\u043d\u044f \u0438 \u043d\u043e\u0447\u0438 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445
    \u0448\u0438\u0440\u043e\u0442\u0430\u0445, \u0430 \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u0435\u043d\u0438\u044f
    \u0432\u043e\u0441\u0445\u043e\u0434\u0430 \u0438 \u0437\u0430\u0445\u043e\u0434\u0430 \u0441\u0432\u0435\u0442\u0438\u043b.
    \u041a\u043d\u0438\u0433\u0430 III: \u0421\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0432\u0438\u0434\u0438\u043c\u043e\u0433\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u0421\u043e\u043b\u043d\u0446\u0430, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0413\u0438\u043f\u043f\u0430\u0440\u0445\u0430.
    \u0412 \u043d\u0435\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0433\u043e\u0434\u0430 \u0438 \u0441\u0442\u0440\u043e\u0438\u0442 \u043c\u043e\u0434\u0435\u043b\u044c
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0421\u043e\u043b\u043d\u0446\u0430 \u043f\u043e
    \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438. \u041a\u043d\u0438\u0433\u0430
    IV \u0438 V: \u041f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u044b \u0441\u0430\u043c\u043e\u043c\u0443
    \u0441\u043b\u043e\u0436\u043d\u043e\u043c\u0443 \u0434\u043b\u044f \u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u0443
    \u2014 \u041b\u0443\u043d\u0435. \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u0443\u0441\u043b\u043e\u0436\u043d\u044f\u0435\u0442 \u043c\u043e\u0434\u0435\u043b\u044c
    \u0413\u0438\u043f\u043f\u0430\u0440\u0445\u0430, \u0432\u0432\u043e\u0434\u044f \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u044d\u043f\u0438\u0446\u0438\u043a\u043b \u0438 \u00ab\u043f\u0440\u043e\u0441\u043d\u0435\u0432\u0437\u0438\u0441\u00bb
    (\u043a\u043e\u043b\u0435\u0431\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u043b\u0443\u043d\u043d\u043e\u0433\u043e \u044d\u043f\u0438\u0446\u0438\u043a\u043b\u0430).
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u043f\u0440\u0435\u0434\u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u041b\u0443\u043d\u044b \u0441 \u043d\u0435\u0432\u0438\u0434\u0430\u043d\u043d\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u2014 \u0434\u043e 10 \u0443\u0433\u043b\u043e\u0432\u044b\u0445
    \u043c\u0438\u043d\u0443\u0442. \u0412 V \u043a\u043d\u0438\u0433\u0435 \u0442\u0430\u043a\u0436\u0435
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e
    \u0430\u0441\u0442\u0440\u043e\u043b\u044f\u0431\u0438\u0438 \u0438 \u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0442\u0441\u044f
    \u043c\u0435\u0442\u043e\u0434\u044b \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u043f\u0430\u0440\u0430\u043b\u043b\u0430\u043a\u0441\u0430
    \u0438 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0434\u043e \u041b\u0443\u043d\u044b
    \u0438 \u0421\u043e\u043b\u043d\u0446\u0430. \u041a\u043d\u0438\u0433\u0430 VI: \u0418\u0437\u043b\u0430\u0433\u0430\u0435\u0442
    \u0442\u0435\u043e\u0440\u0438\u044e \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0439 \u2014
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445 \u0438 \u043b\u0443\u043d\u043d\u044b\u0445,
    \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044f \u0443\u0441\u043b\u043e\u0432\u0438\u044f
    \u0438\u0445 \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0438 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430. \u041a\u043d\u0438\u0433\u0438 VII \u0438 VIII:
    \u0421\u043e\u0434\u0435\u0440\u0436\u0430\u0442 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0437\u0432\u0435\u0437\u0434\u043d\u044b\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433.
    \u041e\u043d \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    48 \u0441\u043e\u0437\u0432\u0435\u0437\u0434\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0431\u044b\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u0433\u0440\u0435\u043a\u0430\u043c,
    \u0438 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b 1022 \u0437\u0432\u0435\u0437\u0434
    (\u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c \u0434\u0430\u043d\u043d\u044b\u043c
    \u2014 \u0431\u043e\u043b\u0435\u0435 1000). \u0425\u043e\u0442\u044f \u043a\u0430\u0442\u0430\u043b\u043e\u0433
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0413\u0438\u043f\u043f\u0430\u0440\u0445\u0430,
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u043b
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0440\u0435\u0446\u0435\u0441\u0441\u0438\u0438
    (\u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0435\u043d\u0438\u044f \u0440\u0430\u0432\u043d\u043e\u0434\u0435\u043d\u0441\u0442\u0432\u0438\u0439).
    \u041a\u043d\u0438\u0433\u0438 IX\u2014XIII: \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0432\u044b\u0432\u043e\u0434 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f
    \u2014 \u043f\u0435\u0440\u0432\u0430\u044f \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043f\u043e\u043b\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u044f\u0442\u0438 \u043f\u043b\u0430\u043d\u0435\u0442 (\u041c\u0435\u0440\u043a\u0443\u0440\u0438\u0439,
    \u0412\u0435\u043d\u0435\u0440\u0430, \u041c\u0430\u0440\u0441, \u042e\u043f\u0438\u0442\u0435\u0440,
    \u0421\u0430\u0442\u0443\u0440\u043d). \u0427\u0442\u043e\u0431\u044b \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043f\u0435\u0442\u043b\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435
    \u0432\u0438\u0434\u0438\u043c\u044b\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442 \u0441 \u0438\u0434\u0435\u0435\u0439 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u0445
    \u043a\u0440\u0443\u0433\u043e\u0432\u044b\u0445 \u043e\u0440\u0431\u0438\u0442, \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u0432\u0432\u043e\u0434\u0438\u0442 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438
    \u044d\u043f\u0438\u0446\u0438\u043a\u043b\u043e\u0432, \u0434\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043e\u0432
    \u0438, \u0441\u0430\u043c\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435, \u044d\u043a\u0432\u0430\u043d\u0442\u0430.
    \u042d\u043a\u0432\u0430\u043d\u0442 \u2014 \u044d\u0442\u043e \u0442\u043e\u0447\u043a\u0430,
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u0446\u0435\u043d\u0442\u0440\u0430 \u044d\u043f\u0438\u0446\u0438\u043a\u043b\u0430 \u043f\u043e
    \u0434\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u0443 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442
    \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u043c. \u042d\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \"\u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435\",
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043e\u0442\u0445\u043e\u0434
    \u043e\u0442 \u0430\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0435\u0432\u0441\u043a\u0438\u0445
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u0432, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u00ab\u0441\u0442\u0440\u043e\u043f\u0442\u0438\u0432\u043e\u0433\u043e\u00bb
    \u041c\u0430\u0440\u0441\u0430.\n\n\U0001F30D \u00ab\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u00bb:
    \u0421\u0432\u043e\u0434 \u0437\u043d\u0430\u043d\u0438\u0439 \u043e \u0417\u0435\u043c\u043b\u0435
    \u041f\u043e\u043b\u043d\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u2014
    \u00ab\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u00bb \u0432 8 \u043a\u043d\u0438\u0433\u0430\u0445.
    \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u0441\u0442\u0430\u043b \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c \u043f\u043e \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u044d\u043f\u043e\u0445\u0438 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.
    \u041d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435, \u0434\u043e\u0448\u0435\u0434\u0448\u0438\u0439
    \u0434\u043e \u043d\u0430\u0441 \u0442\u0435\u043a\u0441\u0442 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442
    \u0441\u043f\u043e\u0440\u044b \u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432,
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442,
    \u0447\u0442\u043e \u043c\u044b \u0438\u043c\u0435\u0435\u043c \u0434\u0435\u043b\u043e
    \u0441 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0435\u0439 \u043a\u043e\u043c\u043f\u0438\u043b\u044f\u0446\u0438\u0435\u0439,
    \u043e\u0434\u043d\u0430\u043a\u043e \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0441\u043d\u043e\u0432\u044b \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044e.
    \u041a\u043d\u0438\u0433\u0430 I: \u0421\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u043a\u0440\u0438\u0442\u0438\u043a\u0443
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u041c\u0430\u0440\u0438\u043d\u0430 \u0422\u0438\u0440\u0441\u043a\u043e\u0433\u043e)
    \u0438 \u0438\u0437\u043b\u0430\u0433\u0430\u0435\u0442 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043a\u0430\u0440\u0442. \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b
    (\u0448\u0438\u0440\u043e\u0442\u0443 \u0438 \u0434\u043e\u043b\u0433\u043e\u0442\u0443)
    \u0438 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0434\u0432\u0435 \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438: \u043f\u0440\u043e\u0441\u0442\u0443\u044e
    \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0438 \u0431\u043e\u043b\u0435\u0435
    \u0441\u043b\u043e\u0436\u043d\u0443\u044e \u043f\u0441\u0435\u0432\u0434\u043e\u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e.
    \u041a\u043d\u0438\u0433\u0438 II\u2014VII: \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442
    \u0441\u043e\u0431\u043e\u0439 \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0438\u0439
    \u0441\u043f\u0438\u0441\u043e\u043a \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442.
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442
    \u0448\u0438\u0440\u043e\u0442\u0443 \u0438 \u0434\u043e\u043b\u0433\u043e\u0442\u0443 \u0434\u043b\u044f
    \u043e\u043a\u043e\u043b\u043e 8000 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0443\u043d\u043a\u0442\u043e\u0432 \u2014 \u043e\u0442 \u0421\u043a\u0430\u043d\u0434\u0438\u043d\u0430\u0432\u0438\u0438
    \u0434\u043e \u0432\u0435\u0440\u0445\u043e\u0432\u044c\u0435\u0432 \u041d\u0438\u043b\u0430
    \u0438 \u043e\u0442 \u0410\u0442\u043b\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u043a\u0435\u0430\u043d\u0430 \u0434\u043e \u0418\u043d\u0434\u043e\u043a\u0438\u0442\u0430\u044f.
    \u0417\u0430 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438\u0441\u044c \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0435
    \u041e\u0441\u0442\u0440\u043e\u0432\u0430 \u0411\u043b\u0430\u0436\u0435\u043d\u043d\u044b\u0445
    (\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u041a\u0430\u043d\u0430\u0440\u0441\u043a\u0438\u0435).
    \u041a\u043d\u0438\u0433\u0430 VIII: \u0421\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438
    \u043f\u043e \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044e \u043a\u0430\u0440\u0442
    \u0438, \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0440\u0435\u0434\u0430\u043a\u0446\u0438\u044f\u0445,
    26 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u0430\u0440\u0442.
    \u0412\u0430\u0436\u043d\u044b\u0439 \u043d\u044e\u0430\u043d\u0441: \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u043e\u0448\u0438\u0431\u0441\u044f \u0432 \u043e\u0446\u0435\u043d\u043a\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432
    \u0417\u0435\u043c\u043b\u0438, \u043f\u0440\u0435\u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0432
    \u0435\u0451 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 1,4 \u0440\u0430\u0437\u0430, \u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u0440\u0435\u0443\u0432\u0435\u043b\u0438\u0447\u0438\u043b \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0410\u0437\u0438\u0438 \u0441 \u0437\u0430\u043f\u0430\u0434\u0430 \u043d\u0430 \u0432\u043e\u0441\u0442\u043e\u043a.
    \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u043e\u0448\u0438\u0431\u043a\u0430,
    \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439,
    \u043f\u043e\u0434\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430 \u0425\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u0440\u0430
    \u041a\u043e\u043b\u0443\u043c\u0431\u0430 \u043a \u043c\u044b\u0441\u043b\u0438, \u0447\u0442\u043e
    \u0434\u043e \u0418\u043d\u0434\u0438\u0438 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u043f\u043b\u044b\u0442\u044c,
    \u043f\u043b\u044b\u0432\u044f \u043d\u0430 \u0437\u0430\u043f\u0430\u0434.\n\n\U0001F52C
    \u00ab\u041e\u043f\u0442\u0438\u043a\u0430\u00bb: \u0423\u0447\u0435\u043d\u0438\u0435 \u043e
    \u0441\u0432\u0435\u0442\u0435 \u0438 \u0437\u0440\u0435\u043d\u0438\u0438 \u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u0432 \u043f\u044f\u0442\u0438 \u043a\u043d\u0438\u0433\u0430\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0441\u0447\u0438\u0442\u0430\u043b\u0441\u044f
    \u0443\u0442\u0435\u0440\u044f\u043d\u043d\u044b\u043c, \u043d\u043e \u0431\u044b\u043b
    \u043d\u0430\u0439\u0434\u0435\u043d \u0432 \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u043e\u043c
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0435 \u0432 XIX \u0432\u0435\u043a\u0435. \u0421\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435:
    \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u0441\u0432\u0435\u0442\u0430. \u041e\u043d \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442
    \u0442\u0435\u043e\u0440\u0438\u044e \u0437\u0440\u0435\u043d\u0438\u044f, \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044f
    \u043b\u0443\u0447\u0438 \u0441\u0432\u0435\u0442\u0430, \u0438\u0434\u0443\u0449\u0438\u043c\u0438
    \u043e\u0442 \u0433\u043b\u0430\u0437\u0430 \u043a \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0443,
    \u0445\u043e\u0442\u044f \u0438 \u043d\u0435 \u043f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u0441\u0442\u0440\u043e\u0433\u043e \u044d\u0442\u043e\u0439 \u0438\u0434\u0435\u0438.
    \u0417\u0430\u043a\u043e\u043d\u044b \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f:
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
    \u0438 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442 \u0437\u0430\u043a\u043e\u043d\u044b
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u0432\u0435\u0442\u0430 \u043e\u0442
    \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u0438 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0435\u0440\u043a\u0430\u043b, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435
    \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d \u0415\u0432\u043a\u043b\u0438\u0434\u0430.
    \u041f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u0441\u0432\u0435\u0442\u0430:
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u2014 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430. \u041e\u043d \u043f\u0440\u043e\u0432\u0435\u043b \u043e\u043f\u044b\u0442\u044b
    \u0441 \u0434\u0438\u0441\u043a\u043e\u043c, \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u0435\u043c\u044b\u043c
    \u0432 \u0432\u043e\u0434\u0443, \u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0442\u0430\u0431\u043b\u0438\u0446\u0443 \u0443\u0433\u043b\u043e\u0432 \u043f\u0430\u0434\u0435\u043d\u0438\u044f
    \u0438 \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u0434\u043b\u044f
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0430 \u0441\u0432\u0435\u0442\u0430 \u0438\u0437
    \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u0432 \u0432\u043e\u0434\u0443 \u0438 \u0441\u0442\u0435\u043a\u043b\u043e.
    \u0425\u043e\u0442\u044f \u0435\u043c\u0443 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c
    \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0442\u043e\u0447\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0437\u0430\u043a\u043e\u043d (\u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u044e\u0442
    \u0421\u043d\u0435\u043b\u043b\u0438\u0443\u0441 \u0438 \u0414\u0435\u043a\u0430\u0440\u0442
    \u0432 XVII \u0432\u0435\u043a\u0435), \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u043c \u044d\u0442\u0430\u043f\u043e\u043c
    \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043e\u043f\u0442\u0438\u043a\u0438.\n\n\U0001F4AB
    \u00ab\u0422\u0435\u0442\u0440\u0430\u0431\u0438\u0431\u043b\u043e\u0441\u00bb: \u041e\u0441\u043d\u043e\u0432\u044b
    \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0438 \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0430\u043a \u00ab\u0427\u0435\u0442\u0432\u0435\u0440\u043e\u043a\u043d\u0438\u0436\u0438\u0435\u00bb,
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0434\u0440\u0435\u0432\u043d\u0435\u0439\u0448\u0438\u043c
    \u0438\u0437 \u0434\u043e\u0448\u0435\u0434\u0448\u0438\u0445 \u0434\u043e \u043d\u0430\u0441
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432 \u043f\u043e \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0412 \u043d\u0435\u043c \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439, \u043e\u043f\u0438\u0440\u0430\u044f\u0441\u044c
    \u043d\u0430 \u0430\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u0444\u0438\u0437\u0438\u043a\u0443, \u0438\u0437\u043b\u0430\u0433\u0430\u0435\u0442 \u043e\u0441\u043d\u043e\u0432\u044b
    \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0438, \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u0443\u044f
    \u0437\u043d\u0430\u043d\u0438\u044f \u043e \u0432\u043b\u0438\u044f\u043d\u0438\u0438 \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0445
    \u0442\u0435\u043b \u043d\u0430 \u0437\u0435\u043c\u043d\u044b\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u044f
    \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u042d\u0442\u043e\u0442 \u0441\u043f\u0438\u0441\u043e\u043a
    \u0442\u0440\u0443\u0434\u043e\u0432 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043c
    \u0431\u044b\u043b \u0433\u0435\u043d\u0438\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f.
    \u041e\u043d \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u0435\u043b\u0435\u043c,
    \u0430 \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c,
    \u0441\u043e\u0437\u0434\u0430\u0432\u0448\u0438\u043c \u0438\u0437 \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0435\u0434\u0438\u043d\u044b\u0435, \u043b\u043e\u0433\u0438\u0447\u043d\u044b\u0435 \u0438
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0442\u0430\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f
    \u043d\u0430\u0443\u043a\u0438 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f."
  achievementsEn: 
  personalLifeRu: "\u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u0441\u043b\u043e\u0436\u043d\u044b\u0439
    \u0440\u0430\u0437\u0434\u0435\u043b \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0435\u0433\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435,
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0441\u0430\u043c\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e
    \u0441\u043a\u0440\u044b\u0442\u0430 \u0437\u0430\u0432\u0435\u0441\u043e\u0439 \u0442\u0430\u0439\u043d\u044b
    \u2013 \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u043e \u043d\u0435\u043c \u043f\u043e\u0447\u0442\u0438
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0438\u0437
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043a\u043d\u0438\u0433.\n\n\U0001F464
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0438\u043c\u044f \u0422\u043e\u0447\u043d\u0430\u044f \u0434\u0430\u0442\u0430
    \u0438 \u043c\u0435\u0441\u0442\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u041a\u043b\u0430\u0432\u0434\u0438\u044f
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b.
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043e\u043a\u043e\u043b\u043e 100 \u0433\u043e\u0434\u0430
    \u043d. \u044d. (\u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 90-\u0439 \u0433\u043e\u0434). \u0415\u0433\u043e
    \u043f\u043e\u043b\u043d\u043e\u0435 \u0438\u043c\u044f \u2014 \u041a\u043b\u0430\u0432\u0434\u0438\u0439
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u2014 \u0433\u043e\u0432\u043e\u0440\u0438\u0442
    \u043e \u0441\u043b\u043e\u0436\u043d\u043e\u043c \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438:
    \u0418\u043c\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u043d\u0430 \u0435\u0433\u043e \u0433\u0440\u0435\u043a\u043e-\u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u043d\u0438, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d\u043e
    \u0431\u044b\u043b\u043e \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043e
    \u0432 \u0415\u0433\u0438\u043f\u0442\u0435. \u0420\u0438\u043c\u0441\u043a\u0438\u0439
    \u0440\u043e\u0434\u043e\u0432\u043e\u0439 \u043d\u043e\u043c\u0435\u043d \u041a\u043b\u0430\u0432\u0434\u0438\u0439
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u0438\u043b\u0438 \u0435\u0433\u043e
    \u043f\u0440\u0435\u0434\u043a\u0438 \u0431\u044b\u043b\u0438 \u0440\u0438\u043c\u0441\u043a\u0438\u043c\u0438
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0430\u043c\u0438. \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e \u0431\u044b\u043b\u043e
    \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043e \u043e\u0442 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430
    \u041a\u043b\u0430\u0432\u0434\u0438\u044f. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043f\u043e\u0437\u0434\u043d\u0435\u0435 (XIV \u0432\u0435\u043a) \u0438 \u043d\u0435
    \u0432\u043f\u043e\u043b\u043d\u0435 \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0435
    \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u043e\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041f\u0442\u043e\u043b\u0435\u043c\u0430\u0438\u0434\u0430
    \u0413\u0435\u0440\u043c\u0438\u0435\u0432\u0430 \u0432 \u0412\u0435\u0440\u0445\u043d\u0435\u043c
    \u0415\u0433\u0438\u043f\u0442\u0435. \u041d\u0430\u0434\u0435\u0436\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043b\u0438\u0448\u044c \u0442\u043e, \u0447\u0442\u043e \u0432\u0441\u044f \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0435\u0439
    \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439, \u0433\u0434\u0435 \u043e\u043d
    \u0436\u0438\u043b \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b.\n\n\U0001F3DB\ufe0f
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0447\u0430\u043b\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0438 \u041e \u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f\u0445 \u0438 \u044e\u043d\u044b\u0445 \u0433\u043e\u0434\u0430\u0445
    \u043f\u043e\u0447\u0442\u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e.
    \u0415\u0441\u0442\u044c \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430, \u0447\u0442\u043e
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f
    \u043c\u043e\u0433 \u0431\u044b\u0442\u044c \u0422\u0435\u043e\u043d \u0421\u043c\u0438\u0440\u043d\u0441\u043a\u0438\u0439,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444-\u043f\u043b\u0430\u0442\u043e\u043d\u0438\u043a,
    \u0436\u0438\u0432\u0448\u0438\u0439 \u0432 \u043f\u0435\u0440\u0432\u043e\u0439 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0435
    II \u0432\u0435\u043a\u0430 \u043d. \u044d.. \u041a\u043e\u0441\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c \u0438\u0445
    \u0441\u0432\u044f\u0437\u0438 \u0441\u043b\u0443\u0436\u0438\u0442 \u0442\u043e, \u0447\u0442\u043e:
    \u0412 \u0441\u0432\u043e\u0435\u043c \u0433\u043b\u0430\u0432\u043d\u043e\u043c \u0442\u0440\u0443\u0434\u0435
    \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0435\u00bb \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u0441\u0441\u044b\u043b\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f, \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043d\u044b\u0435
    \u00ab\u0422\u0435\u043e\u043d\u043e\u043c-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c\u00bb
    \u0432 127\u2013132 \u0433\u043e\u0434\u0430\u0445 \u043d. \u044d.. \u0422\u0435\u043e\u043d
    \u0431\u044b\u043b \u0430\u0432\u0442\u043e\u0440\u043e\u043c \u0440\u0430\u0431\u043e\u0442\u044b
    \u00ab\u0418\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432, \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u0445
    \u043f\u0440\u0438 \u0447\u0442\u0435\u043d\u0438\u0438 \u041f\u043b\u0430\u0442\u043e\u043d\u0430\u00bb
    \u2014 \u0441\u0432\u043e\u0435\u0433\u043e \u0440\u043e\u0434\u0430 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0432 \u043d\u0430\u0443\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0437\u043d\u0430\u043d\u0438\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f. \u0421\u0430\u043c
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0432 \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0435\u00bb
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u043d\u0435\u043a\u043e\u0435\u0433\u043e
    \u0421\u0438\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043e\u043d
    \u043f\u043e\u0441\u0432\u044f\u0449\u0430\u0435\u0442 \u0441\u0432\u043e\u0439 \u0442\u0440\u0443\u0434,
    \u043d\u043e \u043a\u0442\u043e \u044d\u0442\u043e \u0431\u044b\u043b \u2014 \u0434\u0440\u0443\u0433,
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430 \u0438\u043b\u0438 \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a
    \u2014 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0433\u0430\u0434\u043a\u043e\u0439.\n\n\U0001F3D9\ufe0f
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438
    \u0426\u0435\u043d\u0442\u0440\u043e\u043c \u0436\u0438\u0437\u043d\u0438 \u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f \u0431\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u044f
    \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0430\u044f \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439
    \u0446\u0435\u043d\u0442\u0440 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430.
    \u041f\u0435\u0440\u0438\u043e\u0434 \u0435\u0433\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0442\u043e\u0447\u043d\u043e \u0437\u0430\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u0441 127 \u043f\u043e 151
    \u0433\u043e\u0434 \u043d. \u044d.. \u0414\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u043e\u043d, \u043d\u0435\u0441\u043e\u043c\u043d\u0435\u043d\u043d\u043e, \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u0444\u043e\u043d\u0434\u0430\u043c\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438 (\u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u0447\u0430\u0441\u0442\u044c\u044e \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0430
    \u2014 \u0445\u0440\u0430\u043c\u0430 \u043c\u0443\u0437), \u0433\u0434\u0435, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0443 \u043d\u0435\u0433\u043e \u0441\u043b\u043e\u0436\u0438\u043b\u0438\u0441\u044c \u0440\u0430\u0431\u043e\u0447\u0438\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430\u043c\u0438,
    \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0432\u0448\u0438\u043c\u0438
    \u0435\u043c\u0443 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435.
    \u0411\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430 \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c
    \u0441\u0435\u0440\u0434\u0446\u0435\u043c \u0438\u043c\u043f\u0435\u0440\u0438\u0438, \u0438
    \u043e\u043d \u043c\u043e\u0433 \u0431\u0435\u0441\u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0442\u0440\u0443\u0434\u044b \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432:
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430, \u0413\u0438\u043f\u043f\u0430\u0440\u0445\u0430,
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f \u041f\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e.\n\n\U0001F9D1\u200d\U0001F91D\u200d\U0001F9D1
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438.
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0431\u044b\u043b \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0435\u0440\u0432\u043e\u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u0435\u043b\u0435\u043c,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    (\u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb, \u00ab\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u00bb)
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u044b \u043d\u0430 \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u043a\u0435
    \u0437\u043d\u0430\u043d\u0438\u0439 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0437\u0432\u0435\u0437\u0434\u043d\u044b\u0439
    \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d \u043d\u0430 \u0442\u0440\u0443\u0434\u0430\u0445
    \u0413\u0438\u043f\u043f\u0430\u0440\u0445\u0430 \u041d\u0438\u043a\u0435\u0439\u0441\u043a\u043e\u0433\u043e
    (II \u0432\u0435\u043a \u0434\u043e \u043d. \u044d.), \u0430 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u0435\u0442 \u2014
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f
    \u041f\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e. \u041e\u043d \u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438,
    \u0447\u0442\u043e \u0432 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e
    \u0441\u043f\u043e\u0440\u044b \u043e \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438. \u0412 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043d\u0435\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0438\u043a\u0430\u043a\u0438\u0445
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439 \u043e \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0435.
    \u042d\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u0435\u0442 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435,
    \u0447\u0442\u043e \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438, \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044f
    \u0432 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445 \u0434\u0438\u0441\u043f\u0443\u0442\u0430\u0445,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u044b
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438. \u041c\u044b
    \u0437\u043d\u0430\u0435\u043c \u043e \u043d\u0435\u043c \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u043e \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0430\u043c, \u0430 \u043d\u0435
    \u043f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c
    \u043e\u0447\u0435\u0432\u0438\u0434\u0446\u0435\u0432.\n\n\u26b0\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u041a\u043b\u0430\u0432\u0434\u0438\u0439
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0443\u043c\u0435\u0440 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 170 \u0433\u043e\u0434\u0443 \u043d. \u044d. (\u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c
    \u043e\u0446\u0435\u043d\u043a\u0430\u043c, \u0432 165-\u043c), \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u043e\u043a\u043e\u043b\u043e 70 \u043b\u0435\u0442. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u043d\u0430 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044e \u0447\u0443\u043c\u044b,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432 \u0442\u0435 \u0433\u043e\u0434\u044b
    \u043e\u0445\u0432\u0430\u0442\u0438\u043b\u0430 \u0415\u0433\u0438\u043f\u0435\u0442, \u0410\u0437\u0438\u044e
    \u0438 \u0415\u0432\u0440\u043e\u043f\u0443. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u0431\u043e\u043b\u0435\u0437\u043d\u044c
    \u043e\u0431\u043e\u0440\u0432\u0430\u043b\u0430 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c,
    \u0445\u043e\u0442\u044f \u0442\u043e\u0447\u043d\u044b\u0445 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439
    \u044d\u0442\u043e\u043c\u0443 \u043d\u0435\u0442. \u0412 \u0438\u0442\u043e\u0433\u0435,
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0433\u0435\u043d\u0438\u044f,
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u0432 \u0442\u0435\u043d\u0438 \u0435\u0433\u043e
    \u0431\u0435\u0441\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432.
    \u041c\u044b \u043c\u043e\u0436\u0435\u043c \u043b\u0438\u0448\u044c \u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0434\u043e\u0433\u0430\u0434\u043a\u0438 \u043e \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438, \u043d\u043e \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u0442
    \u0441\u0430\u043c\u043e \u0437\u0430 \u0441\u0435\u0431\u044f."
  personalLifeEn: 
  shortBioRu: "\u041a\u043b\u0430\u0432\u0434\u0438\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u2014 \u043e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445,
    \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0441\u0430\u043c\u044b\u0445
    \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u044b\u0445 \u0444\u0438\u0433\u0443\u0440
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u043d\u0430\u0443\u043a\u0438. \u041e
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u0434\u043e \u043e\u0431\u0438\u0434\u043d\u043e\u0433\u043e \u043c\u0430\u043b\u043e,
    \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u043c
    \u0434\u043b\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0447\u044c\u0438
    \u0442\u0440\u0443\u0434\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u043b\u0438
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0438 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u043d\u0430 \u0446\u0435\u043b\u044b\u0445
    \u043f\u043e\u043b\u0442\u043e\u0440\u044b \u0442\u044b\u0441\u044f\u0447\u0438 \u043b\u0435\u0442.\n\n\u23f3
    \u0416\u0438\u0437\u043d\u044c, \u043e\u043a\u0443\u0442\u0430\u043d\u043d\u0430\u044f \u0442\u0430\u0439\u043d\u043e\u0439:
    \u0444\u0430\u043a\u0442\u044b \u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0413\u043b\u0430\u0432\u043d\u0430\u044f
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e
    \u043d\u0430\u0448\u0438 \u0437\u043d\u0430\u043d\u0438\u044f \u043e \u043d\u0435\u043c
    \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0447\u0435\u0440\u043f\u043d\u0443\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0438
    \u0435\u0433\u043e \u0432 \u0441\u0432\u043e\u0438\u0445 \u0442\u0440\u0443\u0434\u0430\u0445,
    \u0438 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432 \u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438
    \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c. \u0418\u043c\u044f
    \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435. \u0415\u0433\u043e
    \u043f\u043e\u043b\u043d\u043e\u0435 \u0438\u043c\u044f \u2014 \u041a\u043b\u0430\u0432\u0434\u0438\u0439
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u2014 \u0433\u043e\u0432\u043e\u0440\u0438\u0442
    \u043e \u0441\u043b\u043e\u0436\u043d\u043e\u043c \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438.
    \u0418\u043c\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u043d\u0430 \u0435\u0433\u043e \u0433\u0440\u0435\u043a\u043e-\u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u043d\u0438, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d\u043e
    \u0431\u044b\u043b\u043e \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e
    \u0432 \u0415\u0433\u0438\u043f\u0442\u0435. \u0420\u0438\u043c\u0441\u043a\u0438\u0439
    \u0440\u043e\u0434\u043e\u0432\u043e\u0439 \u043d\u043e\u043c\u0435\u043d \u041a\u043b\u0430\u0432\u0434\u0438\u0439
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u0438\u043b\u0438 \u0435\u0433\u043e
    \u043f\u0440\u0435\u0434\u043a\u0438 \u0431\u044b\u043b\u0438 \u0440\u0438\u043c\u0441\u043a\u0438\u043c\u0438
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0430\u043c\u0438. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e \u043c\u043e\u0433
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043e\u0434\u0438\u043d \u0438\u0437 \u0435\u0433\u043e
    \u043f\u0440\u0435\u0434\u043a\u043e\u0432 \u043e\u0442 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430
    \u041a\u043b\u0430\u0432\u0434\u0438\u044f. \u0413\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438.
    \u041f\u0440\u0438\u043d\u044f\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u0442\u044c, \u0447\u0442\u043e
    \u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043e\u043a\u043e\u043b\u043e 100
    \u0433\u043e\u0434\u0430 \u043d.\u044d., \u0430 \u0443\u043c\u0435\u0440 \u043e\u043a\u043e\u043b\u043e
    170 \u0433\u043e\u0434\u0430 \u043d.\u044d.. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u044e\u0442
    \u044d\u0442\u0438 \u0440\u0430\u043c\u043a\u0438 \u0434\u043e 90\u2013168 \u0433\u0433.
    \u043d.\u044d.. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0434\u0430\u0442\u044b
    \u0435\u0433\u043e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0437\u0430\u043f\u0438\u0441\u044f\u043c:
    \u043e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438
    \u0441 127 \u043f\u043e 151 \u0433\u043e\u0434 \u043d.\u044d.. \u041c\u0435\u0441\u0442\u043e
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f. \u0422\u043e\u0447\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e
    \u0435\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e.
    \u0412\u0438\u0437\u0430\u043d\u0442\u0438\u0439\u0441\u043a\u0438\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c
    XIV \u0432\u0435\u043a\u0430 \u0424\u0435\u043e\u0434\u043e\u0440 \u041c\u0435\u043b\u0438\u0442\u0435\u043d\u0438\u043e\u0442
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041f\u0442\u043e\u043b\u0435\u043c\u0430\u0438\u0434\u0430
    \u0413\u0435\u0440\u043c\u0438\u0435\u0432\u0430 \u0432 \u0412\u0435\u0440\u0445\u043d\u0435\u043c
    \u0415\u0433\u0438\u043f\u0442\u0435, \u043d\u043e \u044d\u0442\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f
    \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043b\u0438\u0448\u044c \u0441\u043f\u0443\u0441\u0442\u044f
    \u0431\u043e\u043b\u0435\u0435 \u0442\u044b\u0441\u044f\u0447\u0438 \u043b\u0435\u0442 \u0438
    \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0439.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0435\u0433\u043e
    \u0438\u043c\u044f, \u0432\u043f\u043e\u043b\u043d\u0435 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b
    \u0438\u0437 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0438,
    \u0436\u0438\u0432\u0448\u0435\u0439 \u0432 \u0415\u0433\u0438\u043f\u0442\u0435. \u041c\u0435\u0441\u0442\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b. \u0412\u0441\u044f \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0431\u044b\u043b\u0430
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0435\u0439
    \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439 \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u0444\u043e\u043d\u0434\u0430\u043c\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438, \u0447\u0442\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442
    \u0435\u0433\u043e \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u0443\u044e
    \u044d\u0440\u0443\u0434\u0438\u0446\u0438\u044e. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u0440 \u0438 \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438. \u0423\u0447\u0438\u0442\u0435\u043b\u044f.
    \u0425\u043e\u0442\u044f \u043e \u043d\u0438\u0445 \u043f\u043e\u0447\u0442\u0438 \u043d\u0438\u0447\u0435\u0433\u043e
    \u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0435\u0441\u0442\u044c
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0447\u0442\u043e
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u0432
    \u043c\u043e\u0433 \u0431\u044b\u0442\u044c \u0422\u0435\u043e\u043d \u0421\u043c\u0438\u0440\u043d\u0441\u043a\u0438\u0439,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043d\u0435\u043a\u0438\u0439 \u0421\u0438\u0440, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0432\u043e\u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b.\n\n\U0001F4DA \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435: \u0442\u0440\u0443\u0434\u044b, \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0438\u0435
    \u043c\u0438\u0440 \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u043a\u0443\u0434\u043e\u0441\u0442\u044c
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0445,
    \u0434\u043e \u043d\u0430\u0441 \u0434\u043e\u0448\u043b\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0435
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432,
    \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u0443\u0434\u0430\u0447\u0435\u0439. \u0412 \u043d\u0438\u0445 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0435\u0442
    \u043a\u0430\u043a \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0442\u043e\u0440
    \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0441\u0443\u043c\u0435\u0432\u0448\u0438\u0439 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c
    \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u044c \u0437\u043d\u0430\u043d\u0438\u044f \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432.
    \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435
    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u2014 \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435 \u0432 13 \u043a\u043d\u0438\u0433\u0430\u0445\u00bb.
    \u041f\u043e\u0437\u0436\u0435 \u0435\u0433\u043e \u0441\u0442\u0430\u043b\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u00ab\u0412\u0435\u043b\u0438\u043a\u0438\u043c\u00bb (\u00ab\u041c\u0435\u0433\u0438\u0441\u0442\u0435\u00bb),
    \u0430 \u0430\u0440\u0430\u0431\u044b, \u0447\u0435\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434
    \u043f\u043e\u043f\u0430\u043b \u0432 \u0415\u0432\u0440\u043e\u043f\u0443, \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u044d\u0442\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0432 \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb.
    \u0421\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435: \u042d\u0442\u043e \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0430\u044f
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u0412 \u043d\u0435\u0439 \u0438\u0437\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f
    \u0433\u0435\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043c\u0438\u0440\u0430, \u0433\u0434\u0435
    \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f
    \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0430\u044f \u0417\u0435\u043c\u043b\u044f,
    \u0430 \u0432\u0441\u0435 \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0435 \u0442\u0435\u043b\u0430
    \u0432\u0440\u0430\u0449\u0430\u044e\u0442\u0441\u044f \u0432\u043e\u043a\u0440\u0443\u0433
    \u043d\u0435\u0435 \u043f\u043e \u0441\u043b\u043e\u0436\u043d\u044b\u043c \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f\u043c
    \u043a\u0440\u0443\u0433\u043e\u0432\u044b\u0445 \u043e\u0440\u0431\u0438\u0442 (\u044d\u043f\u0438\u0446\u0438\u043a\u043b\u044b
    \u0438 \u0434\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u044b). \u042d\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0447\u043d\u0430
    \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e XVI \u0432\u0435\u043a\u0430, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430
    \u0437\u0430\u043c\u0435\u043d\u0435\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439
    \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430. \u0417\u0432\u0451\u0437\u0434\u043d\u044b\u0439
    \u043a\u0430\u0442\u0430\u043b\u043e\u0433: \u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 48 \u0441\u043e\u0437\u0432\u0435\u0437\u0434\u0438\u0439
    \u0438 \u0431\u043e\u043b\u0435\u0435 1000 \u0437\u0432\u0435\u0437\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043d \u043c\u043e\u0433 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0438\u0437
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438. \u042d\u0442\u043e\u0442
    \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u0441\u0442\u0430\u043b \u0434\u0440\u0435\u0432\u043d\u0435\u0439\u0448\u0438\u043c
    \u0438\u0437 \u0434\u043e\u0448\u0435\u0434\u0448\u0438\u0445 \u0434\u043e \u043d\u0430\u0441
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0445 \u0437\u0432\u0435\u0437\u0434\u043d\u044b\u0445
    \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u043e\u0432. \u00ab\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u00bb
    \u2014 \u0435\u0449\u0435 \u043e\u0434\u0438\u043d \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0432 8 \u043a\u043d\u0438\u0433\u0430\u0445. \u042d\u0442\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0437\u0435\u043c\u0435\u043b\u044c, \u0430 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043c\u0435\u0442\u043e\u0434\u044b
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u043a\u0430\u0440\u0442 \u0441
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442
    (\u0448\u0438\u0440\u043e\u0442\u044b \u0438 \u0434\u043e\u043b\u0433\u043e\u0442\u044b)
    \u0438 \u043f\u0440\u0438\u0432\u0435\u043b \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b
    \u0434\u043b\u044f \u0442\u044b\u0441\u044f\u0447 \u043c\u0435\u0441\u0442 \u043e\u0442
    \u0411\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0445 \u043e\u0441\u0442\u0440\u043e\u0432\u043e\u0432
    \u0434\u043e \u0418\u043d\u0434\u043e\u043a\u0438\u0442\u0430\u044f. \u0418\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u0440\u043e\u043d\u0438\u044f: \u0415\u0433\u043e \u043a\u0430\u0440\u0442\u0430
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u043e\u0448\u0438\u0431\u043a\u0443
    \u2014 \u043e\u043d \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0435\u0443\u0432\u0435\u043b\u0438\u0447\u0438\u043b
    \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0410\u0437\u0438\u0438
    \u0441 \u0437\u0430\u043f\u0430\u0434\u0430 \u043d\u0430 \u0432\u043e\u0441\u0442\u043e\u043a.
    \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u043e\u0448\u0438\u0431\u043a\u0430,
    \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439,
    \u043f\u043e\u0434\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430 \u0425\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u0440\u0430
    \u041a\u043e\u043b\u0443\u043c\u0431\u0430 \u043a \u043c\u044b\u0441\u043b\u0438, \u0447\u0442\u043e
    \u0434\u043e \u0418\u043d\u0434\u0438\u0438 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u043f\u043b\u044b\u0442\u044c,
    \u043f\u043b\u044b\u0432\u044f \u043d\u0430 \u0437\u0430\u043f\u0430\u0434, \u0447\u0442\u043e
    \u0432 \u0438\u0442\u043e\u0433\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044e \u0410\u043c\u0435\u0440\u0438\u043a\u0438.
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b:
    \u00ab\u041e\u043f\u0442\u0438\u043a\u0430\u00bb \u2014 \u043e\u0434\u043d\u043e \u0438\u0437
    \u043f\u0435\u0440\u0432\u044b\u0445 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439,
    \u0433\u0434\u0435 \u0431\u044b\u043b\u0438 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u044b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043f\u0442\u0438\u043a\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u0430\u043a\u043e\u043d\u044b
    \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u0441\u0432\u0435\u0442\u0430.
    \u00ab\u0422\u0435\u0442\u0440\u0430\u0431\u0438\u0431\u043b\u043e\u0441\u00bb (\u00ab\u0427\u0435\u0442\u0432\u0435\u0440\u043e\u043a\u043d\u0438\u0436\u0438\u0435\u00bb)
    \u2014 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u043f\u043e \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c\u044e
    \u0432 \u0421\u0440\u0435\u0434\u043d\u0438\u0435 \u0432\u0435\u043a\u0430. \u00ab\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u043a\u0430\u00bb
    \u2014 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0443\u0437\u044b\u043a\u0438,
    \u0433\u0434\u0435 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u043f\u0440\u0438\u043c\u0438\u0440\u0438\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438 \u0441
    \u0434\u0430\u043d\u043d\u044b\u043c\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u044f.\n\n\u2696\ufe0f \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u0441\u043f\u043e\u0440\u044b \u041a\u043b\u0430\u0432\u0434\u0438\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439, \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0435\u0439
    \u0433\u043e\u0440\u044f\u0447\u0438\u0435 \u0441\u043f\u043e\u0440\u044b. \u0421 \u043e\u0434\u043d\u043e\u0439
    \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0439
    \u043a\u0430\u043a \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u0430
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043d\u0435\u043e\u0441\u043f\u043e\u0440\u0438\u043c.
    \u0421 \u0434\u0440\u0443\u0433\u043e\u0439, \u0435\u0433\u043e \u043e\u0431\u0432\u0438\u043d\u044f\u044e\u0442
    \u0432 \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435 \u0438 \u0434\u0430\u0436\u0435
    \u0444\u0430\u043b\u044c\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0434\u0430\u043d\u043d\u044b\u0445,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0437\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0431\u0435\u0437 \u0441\u0441\u044b\u043b\u043e\u043a \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0430
    \u0413\u0438\u043f\u043f\u0430\u0440\u0445\u0430 \u0438 \u043f\u043e\u0434\u0433\u043e\u043d\u043a\u0443
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439 \u043f\u043e\u0434 \u0441\u0432\u043e\u0438
    \u0442\u0435\u043e\u0440\u0438\u0438. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438, \u043e\u0434\u043d\u0430\u043a\u043e,
    \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a \u044d\u0442\u043e\u043c\u0443
    \u0431\u043e\u043b\u0435\u0435 \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e,
    \u0432\u0438\u0434\u044f \u0432 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u043f\u0440\u0435\u0436\u0434\u0435 \u0432\u0441\u0435\u0433\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0439
    \u0441\u0432\u043e\u0434 \u0437\u043d\u0430\u043d\u0438\u0439, \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0438\u0439
    \u044d\u043f\u043e\u0445\u0443 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041a\u043b\u0430\u0432\u0434\u0438\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f,
    \u0445\u043e\u0442\u044c \u0438 \u043e\u043a\u0443\u0442\u0430\u043d\u0430 \u0442\u0430\u0439\u043d\u043e\u0439,
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439, \u043a\u0443\u0440\u044c\u0435\u0437\u043e\u0432
    \u0438 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0439.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438\u0437 \u043d\u0438\u0445.\n\n\U0001F575\ufe0f\u200d\u2642\ufe0f \u0427\u0435\u043b\u043e\u0432\u0435\u043a-\u0437\u0430\u0433\u0430\u0434\u043a\u0430:
    \u0438\u043c\u044f \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0421\u0430\u043c\u0430 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f
    \u2014 \u044d\u0442\u043e \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430.
    \u0415\u0433\u043e \u043f\u043e\u043b\u043d\u043e\u0435 \u0438\u043c\u044f, \u041a\u043b\u0430\u0432\u0434\u0438\u0439
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442
    \u0441\u043e\u0431\u043e\u0439 \u043f\u0440\u0438\u0447\u0443\u0434\u043b\u0438\u0432\u0443\u044e
    \u0441\u043c\u0435\u0441\u044c \u043a\u0443\u043b\u044c\u0442\u0443\u0440. \u0413\u0440\u0435\u043a\u043e-\u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u043d\u0438: \u0418\u043c\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u0431\u044b\u043b\u043e \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043e
    \u0432 \u0415\u0433\u0438\u043f\u0442\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0441\u0440\u0435\u0434\u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u043d\u0430\u0442\u0438,
    \u0438 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0430 \u0435\u0433\u043e
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438\u0437
    \u044d\u0442\u043e\u0439 \u0441\u0440\u0435\u0434\u044b. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0432 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445
    \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0435\u0433\u043e \u0438\u043d\u043e\u0433\u0434\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \"\u0412\u0435\u0440\u0445\u043d\u0435\u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u043c\",
    \u0447\u0442\u043e \u043d\u0430\u0432\u043e\u0434\u0438\u0442 \u043d\u0430 \u043c\u044b\u0441\u043b\u044c
    \u043e \u0435\u0433\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u043c \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438
    \u0441 \u044e\u0433\u0430 \u0441\u0442\u0440\u0430\u043d\u044b. \u0420\u0438\u043c\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e: \u0418\u043c\u044f \u041a\u043b\u0430\u0432\u0434\u0438\u0439
    \u2014 \u0440\u0438\u043c\u0441\u043a\u0438\u0439 \u0440\u043e\u0434\u043e\u0432\u043e\u0439
    \u043d\u043e\u043c\u0435\u043d (nomen). \u042d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442,
    \u0447\u0442\u043e \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0438\u043b\u0438 \u0435\u0433\u043e
    \u043f\u0440\u0435\u0434\u043a\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u0440\u0438\u043c\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u043e\u0442 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u041a\u043b\u0430\u0432\u0434\u0438\u044f.
    \u042d\u0442\u043e \u0431\u044b\u043b \u0437\u043d\u0430\u043a \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e
    \u0441\u0442\u0430\u0442\u0443\u0441\u0430, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0438
    \u0442\u0440\u0443\u0434\u044b \u043d\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u0415\u0433\u0438\u043f\u0442\u0435. \u041a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442: \u0414\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043f\u0443\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u0441 \u0446\u0430\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0435\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0435\u0432,
    \u043f\u0440\u0430\u0432\u0438\u0432\u0448\u0435\u0439 \u0415\u0433\u0438\u043f\u0442\u043e\u043c.
    \u042d\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0438\u0437-\u0437\u0430
    \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0438\u043c\u0435\u043d\u0438,
    \u043d\u043e \u041a\u043b\u0430\u0432\u0434\u0438\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u043d\u0435 \u0438\u043c\u0435\u043b \u043a \u0444\u0430\u0440\u0430\u043e\u043d\u0430\u043c
    \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f.\n\n\U0001F4D6
    \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb: \u0432\u0435\u043b\u0438\u0447\u0438\u0435,
    \u043f\u043b\u0430\u0433\u0438\u0430\u0442 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u0432 \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f, \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb,
    \u0441\u0430\u043c \u043f\u043e \u0441\u0435\u0431\u0435 \u043f\u043e\u043b\u043e\u043d
    \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439.
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f:
    \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u043e\u0442 \u0430\u0440\u0430\u0431\u0441\u043a\u043e\u0433\u043e
    \"\u0430\u043b\u044c-\u041c\u0430\u0434\u0436\u0438\u0441\u0442\u0438\", \u0447\u0442\u043e
    \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \"\u0412\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0439\".
    \u0410\u0440\u0430\u0431\u044b \u0442\u0430\u043a \u043d\u0430\u0437\u0432\u0430\u043b\u0438
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0440\u0443\u0434 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f
    \u00ab\u041c\u0435\u0433\u0438\u0441\u0442\u0435 \u0421\u0438\u043d\u0442\u0430\u043a\u0441\u0438\u0441\u00bb
    (\u00ab\u0412\u0435\u043b\u0438\u043a\u043e\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435\u00bb).
    \u041f\u043e\u0434 \u044d\u0442\u0438\u043c \u0438\u043c\u0435\u043d\u0435\u043c \u043e\u043d
    \u0438 \u0432\u043e\u0448\u0435\u043b \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e.
    \u041e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0435 \u0432 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u043c
    \u043d\u0430\u0443\u0447\u043d\u043e\u043c \u043c\u043e\u0448\u0435\u043d\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0435:
    \u0412 1977 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430 \u043d\u0430\u0448\u0443\u043c\u0435\u0432\u0448\u0430\u044f
    \u043a\u043d\u0438\u0433\u0430 \u0444\u0438\u0437\u0438\u043a\u0430 \u0420\u043e\u0431\u0435\u0440\u0442\u0430
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u00ab\u041f\u0440\u0435\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0435
    \u041a\u043b\u0430\u0432\u0434\u0438\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f\u00bb.
    \u0412 \u043d\u0435\u0439 \u041d\u044c\u044e\u0442\u043e\u043d \u0437\u0430\u044f\u0432\u0438\u043b,
    \u0447\u0442\u043e \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043d\u0435 \u0431\u044b\u043b
    \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c-\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u0435\u043b\u0435\u043c,
    \u0430 \u0431\u044b\u043b, \u043f\u043e \u0441\u0443\u0442\u0438, \u0444\u0430\u043b\u044c\u0441\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c.
    \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043d\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439,
    \u0430 \u043f\u043e\u0434\u0433\u043e\u043d\u044f\u043b \u0434\u0430\u043d\u043d\u044b\u0435
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    (\u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c,
    \u0413\u0438\u043f\u043f\u0430\u0440\u0445\u0430) \u043f\u043e\u0434 \u0441\u0432\u043e\u0438
    \u0442\u0435\u043e\u0440\u0438\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u041d\u044c\u044e\u0442\u043e\u043d \u0443\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0435\u043c
    \u043e\u0441\u0435\u043d\u043d\u0435\u0433\u043e \u0440\u0430\u0432\u043d\u043e\u0434\u0435\u043d\u0441\u0442\u0432\u0438\u044f
    \u0432 132 \u0433\u043e\u0434\u0443 \u043d.\u044d., \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b \u0441 \u00ab\u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0439
    \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e\u00bb, \u0431\u044b\u043b\u043e
    \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u044b\u043c \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c
    \u043d\u0430 \u0434\u0435\u043d\u044c. \u0417\u0430\u0449\u0438\u0442\u0430 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f:
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0433\u0440\u043e\u043c\u043a\u0438\u0435
    \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f, \u043c\u043d\u043e\u0433\u0438\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043d\u0430\u0443\u043a\u0438 \u0432\u0441\u0442\u0430\u043b\u0438
    \u043d\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f.
    \u041e\u043d\u0438 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043d\u0430 \u0442\u043e,
    \u0447\u0442\u043e: 1. \u0415\u0433\u043e \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb
    \u0431\u044b\u043b \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0435\u0439,
    \u0441\u0431\u043e\u0440\u043d\u0438\u043a\u043e\u043c \u0432\u0441\u0435\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439, \u0438 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u043d\u0435 \u043e\u0431\u044f\u0437\u0430\u043d \u0431\u044b\u043b \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u0440\u0430 \u2014 \u044d\u0442\u043e
    \u0431\u044b\u043b\u043e \u043e\u0431\u044b\u0447\u043d\u043e\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u043e\u0439
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. 2. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u0440\u0430\u0441\u0447\u0435\u0442\u044b \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u0437\u0432\u0435\u0437\u0434
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0431\u044b\u043b \u043e\u0441\u043d\u043e\u0432\u0430\u043d \u043d\u0430 \u0434\u0430\u043d\u043d\u044b\u0445
    \u0413\u0438\u043f\u043f\u0430\u0440\u0445\u0430, \u043d\u043e \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043b \u0438\u0445 \u0441 \u0443\u0447\u0435\u0442\u043e\u043c
    \u043f\u0440\u0435\u0446\u0435\u0441\u0441\u0438\u0438 (\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u0437\u0435\u043c\u043d\u043e\u0439 \u043e\u0441\u0438).
    \u041e\u0448\u0438\u0431\u043a\u0430 \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430 \u0438\u0437-\u0437\u0430
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043d\u0435\u0432\u0435\u0440\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u043f\u0440\u0435\u0446\u0435\u0441\u0441\u0438\u0438. \u0422\u043e \u0435\u0441\u0442\u044c
    \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u043d\u0435 \u0444\u0430\u043b\u044c\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f,
    \u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043d\u0435\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c. \u0418\u0442\u043e\u0433:
    \u0412\u043e\u043f\u0440\u043e\u0441 \u043e \u00ab\u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438\u00bb
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f \u0442\u0430\u043a \u0438 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c. \u0415\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0442\u043e \u00ab\u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c
    \u0434\u0440\u0435\u0432\u043d\u043e\u0441\u0442\u0438\u00bb, \u0442\u043e \u00ab\u0441\u0430\u043c\u044b\u043c
    \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u043c \u043c\u043e\u0448\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438\u00bb.\n\n\U0001F30D
    \u041a\u0430\u0440\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u0432\u0435\u043b\u0430
    \u043a \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044e \u0410\u043c\u0435\u0440\u0438\u043a\u0438
    \u0421\u0430\u043c\u044b\u0439 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0439 \u0438 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u043a\u0443\u0440\u044c\u0435\u0437 \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0435\u0433\u043e
    \u0442\u0440\u0443\u0434\u043e\u043c \u00ab\u0413\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u00bb.
    \u041e\u0448\u0438\u0431\u043a\u0430, \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0430\u044f
    \u043c\u0438\u0440: \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439, \u043a\u0430\u043a
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0435
    \u0443\u0447\u0435\u043d\u044b\u0435, \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u0440\u0435\u0443\u043c\u0435\u043d\u044c\u0448\u0438\u043b
    \u0440\u0430\u0437\u043c\u0435\u0440\u044b \u0417\u0435\u043c\u043b\u0438 (\u043f\u043e\u0447\u0442\u0438
    \u043d\u0430 30%) \u0438 \u043f\u0440\u0435\u0443\u0432\u0435\u043b\u0438\u0447\u0438\u043b
    \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0410\u0437\u0438\u0438
    \u0441 \u0437\u0430\u043f\u0430\u0434\u0430 \u043d\u0430 \u0432\u043e\u0441\u0442\u043e\u043a.
    \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435, \u043a\u043e\u0433\u0434\u0430
    \u0425\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u0440 \u041a\u043e\u043b\u0443\u043c\u0431
    \u0432 1492 \u0433\u043e\u0434\u0443 \u0437\u0430\u0434\u0443\u043c\u0430\u043b \u043f\u043b\u044b\u0442\u044c
    \u0432 \u0418\u043d\u0434\u0438\u044e \u0437\u0430\u043f\u0430\u0434\u043d\u044b\u043c \u043f\u0443\u0442\u0435\u043c,
    \u043e\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0441\u044f
    \u0438\u043c\u0435\u043d\u043d\u043e \u043a\u0430\u0440\u0442\u043e\u0439 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f.
    \u0415\u0441\u043b\u0438 \u0431\u044b \u043a\u0430\u0440\u0442\u0430 \u0431\u044b\u043b\u0430
    \u0442\u043e\u0447\u043d\u043e\u0439, \u041a\u043e\u043b\u0443\u043c\u0431 \u043f\u043e\u043d\u044f\u043b
    \u0431\u044b, \u0447\u0442\u043e \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435
    \u0434\u043e \u0410\u0437\u0438\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0432\u0435\u043b\u0438\u043a\u043e,
    \u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0435 \u0440\u0438\u0441\u043a\u043d\u0443\u043b
    \u0431\u044b \u043f\u0443\u0441\u0442\u0438\u0442\u044c\u0441\u044f \u0432 \u043f\u043b\u0430\u0432\u0430\u043d\u0438\u0435.
    \u041c\u043e\u0436\u043d\u043e \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e
    \u043e\u0448\u0438\u0431\u043a\u0430 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f \u0441\u0442\u0430\u043b\u0430
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043f\u0440\u0438\u0447\u0438\u043d \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u041d\u043e\u0432\u043e\u0433\u043e \u0421\u0432\u0435\u0442\u0430!.\n\n\U0001F4A1 \u0423\u0447\u0435\u043d\u044b\u0439-\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b
    \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u00ab\u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043d\u044b\u043c\u00bb \u0443\u0447\u0435\u043d\u044b\u043c.
    \u041e\u043d \u0431\u044b\u043b \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u0435\u043c
    \u0438 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u0442\u043e\u0440\u043e\u043c:
    \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u0434\u0432\u0443\u0445 \u0432\u0430\u0436\u043d\u044b\u0445 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432: \u0430\u0440\u043c\u0438\u043b\u043b\u044f\u0440\u043d\u043e\u0439
    \u0441\u0444\u0435\u0440\u044b \u0438 \u0442\u0440\u0438\u043a\u0432\u0435\u0442\u0440\u0430
    (\u0442\u0440\u043e\u0439\u043d\u043e\u0439 \u0440\u0435\u0439\u043a\u0438), \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u0438 \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0438\u0437\u043c\u0435\u0440\u044f\u0442\u044c
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0437\u0432\u0435\u0437\u0434 \u0438
    \u043f\u043b\u0430\u043d\u0435\u0442. \u0412 \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043f\u043e \u043e\u043f\u0442\u0438\u043a\u0435 \u043e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b
    \u043e\u043f\u044b\u0442\u044b \u043f\u043e \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044e
    \u0441\u0432\u0435\u0442\u0430, \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u044b
    \u0443\u0433\u043b\u043e\u0432 \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u0432\u043e\u0434\u044b \u0438 \u0441\u0442\u0435\u043a\u043b\u0430,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e
    \u0434\u043b\u044f \u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\u2753
    \u0417\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u0430\u044f \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e, \u043c\u044b \u043d\u0435
    \u0437\u043d\u0430\u0435\u043c \u043e \u043d\u0435\u043c \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0438\u0447\u0435\u0433\u043e. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0434\u0430\u0436\u0435 \u0442\u043e\u0447\u043d\u0430\u044f
    \u0434\u0430\u0442\u0430 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u2014
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0438\u043e\u0434
    \u043c\u0435\u0436\u0434\u0443 161 \u0438 180 \u0433\u043e\u0434\u0430\u043c\u0438 \u043d.\u044d..
    \u0421\u043e\u0437\u0434\u0430\u0435\u0442\u0441\u044f \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435,
    \u0447\u0442\u043e \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0438\u043b\u0441\u044f \u0432 \u0441\u0432\u043e\u0438\u0445
    \u0442\u0440\u0443\u0434\u0430\u0445."
