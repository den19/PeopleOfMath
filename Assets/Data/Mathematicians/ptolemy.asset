    \u043e \u0441\u043b\u043e\u0436\u043d\u043e\u043c \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438.
    \u0418\u043c\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u043d\u0430 \u0435\u0433\u043e \u0433\u0440\u0435\u043a\u043e-\u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u043d\u0438, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d\u043e
    \u0431\u044b\u043b\u043e \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e
    \u0432 \u0415\u0433\u0438\u043f\u0442\u0435. \u0420\u0438\u043c\u0441\u043a\u0438\u0439
    \u0440\u043e\u0434\u043e\u0432\u043e\u0439 \u043d\u043e\u043c\u0435\u043d \u041a\u043b\u0430\u0432\u0434\u0438\u0439
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u0438\u043b\u0438 \u0435\u0433\u043e
    \u043f\u0440\u0435\u0434\u043a\u0438 \u0431\u044b\u043b\u0438 \u0440\u0438\u043c\u0441\u043a\u0438\u043c\u0438
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0430\u043c\u0438. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e \u043c\u043e\u0433
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043e\u0434\u0438\u043d \u0438\u0437 \u0435\u0433\u043e
    \u043f\u0440\u0435\u0434\u043a\u043e\u0432 \u043e\u0442 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430
    \u041a\u043b\u0430\u0432\u0434\u0438\u044f. \u0413\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438.
    \u041f\u0440\u0438\u043d\u044f\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u0442\u044c, \u0447\u0442\u043e
    \u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043e\u043a\u043e\u043b\u043e 100
    \u0433\u043e\u0434\u0430 \u043d.\u044d., \u0430 \u0443\u043c\u0435\u0440 \u043e\u043a\u043e\u043b\u043e
    170 \u0433\u043e\u0434\u0430 \u043d.\u044d.. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u044e\u0442
    \u044d\u0442\u0438 \u0440\u0430\u043c\u043a\u0438 \u0434\u043e 90\u2013168 \u0433\u0433.
