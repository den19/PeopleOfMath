    \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b \u0438\u0445, \u043d\u0435 \u0433\u043b\u044f\u0434\u044f
    \u043d\u0430 \u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u0435\u0439. \u0420\u0443\u0434\u043e\u043b\u044c\u0444
    \u041a\u0430\u0440\u043d\u0430\u043f, \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444,
    \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b: \u00ab\u0424\u0440\u0435\u0433\u0435
    \u0432\u044b\u0433\u043b\u044f\u0434\u0435\u043b \u0441\u0442\u0430\u0440\u0448\u0435 \u0441\u0432\u043e\u0438\u0445
    \u043b\u0435\u0442. \u041e\u043d \u0431\u044b\u043b \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0433\u043e
    \u0440\u043e\u0441\u0442\u0430, \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0437\u0430\u0441\u0442\u0435\u043d\u0447\u0438\u0432,
    \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u0438\u043d\u0442\u0440\u043e\u0432\u0435\u0440\u0442\u0435\u043d.
    \u041e\u043d \u0440\u0435\u0434\u043a\u043e \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430
    \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044e. \u041e\u0431\u044b\u0447\u043d\u043e
    \u043c\u044b \u0432\u0438\u0434\u0435\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e
    \u0441\u043f\u0438\u043d\u0443\u00bb. \u041d\u0438\u043a\u0442\u043e \u0438\u0437 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u043b
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u2014 \u043d\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043b\u0435\u043a\u0446\u0438\u0438, \u043d\u0438 \u043f\u043e\u0441\u043b\u0435. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0438 \u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u043c\u044b\u0441\u043b\u0438\u043c\u043e\u0439. \u041b\u0438\u0448\u044c \u043d\u0430
    \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u0445
    \u043a\u0443\u0440\u0441\u043e\u0432, \u0433\u0434\u0435 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e
    \u0442\u0440\u0438 \u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u044f, \u043e\u043d
    \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u00ab\u043e\u0442\u0442\u0430\u044f\u043b\u00bb,
    \u043d\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e
    \u043d\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u0438\u0441\u044c.\n\n\U0001F9E9
    \u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u043d\u0435\u0432\u043d\u0438\u043a
    \u0438 \u0442\u0435\u043d\u044c \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c\u0430
    \u0417\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0424\u0440\u0435\u0433\u0435
    \u0438\u043c\u0435\u043b\u043e \u0438 \u0431\u043e\u043b\u0435\u0435 \u043c\u0440\u0430\u0447\u043d\u0443\u044e
    \u0441\u0442\u043e\u0440\u043e\u043d\u0443. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c
    \u0443\u043b\u044c\u0442\u0440\u0430\u043f\u0440\u0430\u0432\u043e\u0439 \u00ab\u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u043f\u0430\u0440\u0442\u0438\u0438\u00bb (Vaterlandspartei) \u0438 \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u043e\u043c.
    \u0415\u0433\u043e \u00ab\u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u00bb, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0439
    \u0437\u0430 \u0433\u043e\u0434 \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438 (1924),
    \u043f\u043e\u043b\u043e\u043d \u0448\u043e\u0432\u0438\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u043f\u0438\u0441\u0435\u0439, \u0433\u0434\u0435 \u043e\u043d, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0441\u0435\u0442\u043e\u0432\u0430\u043b \u043d\u0430 \u00ab\u043f\u043e\u0432\u0441\u0435\u043c\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c
    \u0435\u0432\u0440\u0435\u0435\u0432\u00bb \u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435
    \u0438\u043c\u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u0438\u0445 \u043f\u0440\u0430\u0432.
    \u042d\u0442\u043e \u0437\u043d\u0430\u043d\u0438\u0435, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c
    \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0435\u0433\u043e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    (\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430
    \u0413\u0435\u0440\u0448\u043e\u043c\u0430 \u0428\u043e\u043b\u0435\u043c\u0430), \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442,
    \u043f\u043e\u0447\u0435\u043c\u0443 \u0434\u0430\u0436\u0435 \u043d\u0435\u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0435
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u043d\u0435 \u0440\u0435\u0448\u0430\u043b\u0438\u0441\u044c
    \u043f\u043e\u0434\u043e\u0439\u0442\u0438 \u043a \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0443
    \u0432\u043d\u0435 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u2014 \u0435\u0433\u043e \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044f \u0431\u044b\u043b\u0430
    \u043e\u0431\u0449\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430. \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0447\u0442\u043e \u0432 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043b\u0435\u043a\u0446\u0438\u0439
    \u0424\u0440\u0435\u0433\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u00ab\u043b\u043e\u0433\u0438\u043a\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0430\u0440\u0438\u0439\u0441\u043a\u0430\u044f, \u043d\u043e \u0434\u0430\u0436\u0435
    \u0438 \u043d\u0430\u0434\u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0430\u044f\u00bb,
    \u043e\u0434\u043d\u0430\u043a\u043e \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430 \u043d\u0435 \u043e\u0442\u043c\u0435\u043d\u044f\u043b\u0430
    \u043f\u0440\u0435\u0434\u0432\u0437\u044f\u0442\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f.\n\n\U0001F94A
    \u041a\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043d\u0430\u0434\u0435\u0436\u0434: \u041f\u0438\u0441\u044c\u043c\u043e,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u043e
    \u0424\u0440\u0435\u0433\u0435 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0430\u043c\u044b\u0439
    \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u044d\u043f\u0438\u0437\u043e\u0434
    \u0432 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0424\u0440\u0435\u0433\u0435
    \u2014 \u044d\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0432
    1902 \u0433\u043e\u0434\u0443 \u043f\u0438\u0441\u044c\u043c\u0430 \u043e\u0442 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e
    \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0430 \u0420\u0430\u0441\u0441\u0435\u043b\u0430,
    \u043a\u043e\u0433\u0434\u0430 \u0432\u0442\u043e\u0440\u043e\u0439 \u0442\u043e\u043c \u0435\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0442\u0440\u0443\u0434\u0430 \u00ab\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0437\u0430\u043a\u043e\u043d\u044b \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb
    \u0443\u0436\u0435 \u0431\u044b\u043b \u0432 \u043f\u0435\u0447\u0430\u0442\u0438. \u0420\u0430\u0441\u0441\u0435\u043b
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 (\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435
    \u0432\u0441\u0435\u0445 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u043d\u0435
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0445 \u0441\u0435\u0431\u044f),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u043b
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u0424\u0440\u0435\u0433\u0435, \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0443\u044e
    \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043a\u043b\u0430\u0441\u0441\u043e\u0432.
    \u0420\u0435\u0430\u043a\u0446\u0438\u044f \u0424\u0440\u0435\u0433\u0435 \u0431\u044b\u043b\u0430
    \u0441\u043e\u043a\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439. \u0412
    \u043e\u0442\u0432\u0435\u0442\u043d\u043e\u043c \u043f\u0438\u0441\u044c\u043c\u0435 \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \u00ab\u0412\u0430\u0448\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f \u0443\u0434\u0438\u0432\u0438\u043b\u043e
    \u043c\u0435\u043d\u044f \u0441\u0432\u0435\u0440\u0445 \u043c\u0435\u0440\u044b \u0438,
    \u044f \u0431\u044b \u0441\u043a\u0430\u0437\u0430\u043b, \u043f\u043e\u0447\u0442\u0438
    \u043e\u0433\u043b\u0443\u0448\u0438\u043b\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e
    \u043e\u043d\u043e \u043f\u043e\u043a\u043e\u043b\u0435\u0431\u0430\u043b\u043e \u0442\u0443
    \u043f\u043e\u0447\u0432\u0443, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u044f \u0445\u043e\u0442\u0435\u043b \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443. \u2026 \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430
    \u0448\u0430\u0442\u0430\u0435\u0442\u0441\u044f!\u00bb. \u041e\u043d \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0432 \u043a\u043e\u043d\u0435\u0446 \u0442\u043e\u043c\u0430
    \u0441\u043f\u0435\u0448\u043d\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u043b
    \u043e\u0448\u0438\u0431\u043a\u0443. \u0421\u0430\u043c \u0420\u0430\u0441\u0441\u0435\u043b
    \u043f\u043e\u0437\u0436\u0435 \u0432\u043e\u0441\u0445\u0438\u0449\u0430\u043b\u0441\u044f
    \u044d\u0442\u0438\u043c \u043f\u043e\u0441\u0442\u0443\u043f\u043a\u043e\u043c \u043a\u0430\u043a
    \u0430\u043a\u0442\u043e\u043c \u0432\u044b\u0441\u043e\u0447\u0430\u0439\u0448\u0435\u0439
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0447\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438: \u00ab\u2026 \u043f\u0440\u0438
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0438 \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u0435\u0433\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e, \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b
    \u0441 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435\u043c, \u044f\u0432\u043d\u043e
    \u043f\u043e\u0434\u0430\u0432\u043b\u044f\u044f \u043b\u044e\u0431\u043e\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043e
    \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u042d\u0442\u043e
    \u0431\u044b\u043b\u043e \u043f\u043e\u0447\u0442\u0438 \u0441\u0432\u0435\u0440\u0445\u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u043e\u00bb.\n\n\u270d\ufe0f
    \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u0440\u043e\u043d\u0438\u044f:
    \u00ab\u041b\u043e\u0433\u0438\u043a\u0430\u00bb \u0438\u043b\u0438 \u00ab\u0421\u0438\u043b\u0430\u0447
    \u0413\u043e\u0442\u043b\u0438\u0431\u00bb? \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u043c
