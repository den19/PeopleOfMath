    \u0441\u0430\u043c\u044b\u0445 \u0433\u043e\u0440\u044c\u043a\u0438\u0445 \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043d\u0430\u0443\u043a\u0438. \u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0424\u0440\u0435\u0433\u0435
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0442\u043e\u043b\u043f\u043e\u0432
