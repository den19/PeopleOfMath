  wikiTitleRu: "\u0424\u0440\u0438\u0301\u0434\u0440\u0438\u0445 \u041B\u044E\u0301\u0434\u0432\u0438\u0433
    \u0413\u043E\u0301\u0442\u043B\u043E\u0431 \u0424\u0440\u0435\u0301\u0433\u0435"
  wikidataId: Q60028
  fullNameRu: "\u0424\u0440\u0438\u0301\u0434\u0440\u0438\u0445 \u041B\u044E\u0301\u0434\u0432\u0438\u0433
    \u0413\u043E\u0301\u0442\u043B\u043E\u0431 \u0424\u0440\u0435\u0301\u0433\u0435"
  fullNameEn: Gottlob Frege
  birthDate: 08.11.1848
  deathDate: 26.07.1925
  countryKeys:
  - germany
  centuryKeys:
  - 19
  - 20
  branchKeys:
  - logic
  achievementsRu: "\u0412\u043a\u043b\u0430\u0434 \u0413\u043e\u0442\u043b\u043e\u0431\u0430 \u0424\u0440\u0435\u0433\u0435
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u0447\u0430\u0441\u0442\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044e\u0442
    \u043f\u043e \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443 \u0441 \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438\u043b\u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0432 \u0444\u0438\u0437\u0438\u043a\u0443.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0441\u043b\u0438 \u041d\u044c\u044e\u0442\u043e\u043d
    \u0438 \u0415\u0432\u043a\u043b\u0438\u0434 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0435\u0435 \u0437\u043d\u0430\u043d\u0438\u0435,
    \u0442\u043e \u0424\u0440\u0435\u0433\u0435 \u0441\u043e\u0437\u0434\u0430\u043b \u0437\u0430\u043d\u043e\u0432\u043e
    \u0446\u0435\u043b\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443
    \u2014 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043b\u043e\u0433\u0438\u043a\u0443 \u2014 \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u0440\u0430\u0437\u0443 \u0434\u043b\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439: \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u044f\u0437\u044b\u043a\u0430, \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    \u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445 \u043d\u0430\u0443\u043a.
    \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c \u0433\u043b\u0443\u0431\u0438\u043d\u0443
    \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0430, \u043d\u0443\u0436\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043d\u0430 \u043f\u044f\u0442\u044c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u043e\u0432\u043d\u0435\u0439. \u041d\u0438\u0436\u0435 \u2014 \u0441\u0430\u043c\u043e\u0435
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0435 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0438\u0437 \u043d\u0438\u0445. --- 1. \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0432 \u043b\u043e\u0433\u0438\u043a\u0435: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043b\u043e\u0433\u0438\u043a\u0438 \u043f\u0440\u0435\u0434\u0438\u043a\u0430\u0442\u043e\u0432
    (\u0418\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u0439,
    1879) \u0414\u043e \u0424\u0440\u0435\u0433\u0435 \u043b\u043e\u0433\u0438\u043a\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u043f\u043e\u0447\u0442\u0438 \u0432 \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u043e\u043c
    \u0432\u0438\u0434\u0435 2000 \u043b\u0435\u0442 (\u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d
    \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044f). \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0435\u0432\u0430
    \u0441\u0438\u043b\u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u0430 \u0443\u043c\u0435\u043b\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f\u043c\u0438
    (\u00ab\u0412\u0441\u0435 \u043b\u044e\u0434\u0438 \u0441\u043c\u0435\u0440\u0442\u043d\u044b\u00bb),
    \u043d\u043e \u0431\u044b\u043b\u0430 \u0431\u0435\u0441\u0441\u0438\u043b\u044c\u043d\u0430
    \u043f\u0435\u0440\u0435\u0434 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c\u0438
    \u0441 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c\u0438 (\u00ab\u0410
    \u0431\u043e\u043b\u044c\u0448\u0435 \u0412\u00bb), \u0441 \u043a\u0440\u0430\u0442\u043d\u044b\u043c\u0438
    \u043a\u0432\u0430\u043d\u0442\u043e\u0440\u0430\u043c\u0438 (\u00ab\u041a\u0430\u0436\u0434\u044b\u0439
    \u043b\u044e\u0431\u0438\u0442 \u043a\u043e\u0433\u043e-\u0442\u043e\u00bb) \u0438\u043b\u0438
    \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u0438. \u0427\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b
    \u0424\u0440\u0435\u0433\u0435: - \u0412\u0432\u0435\u043b \u043a\u0432\u0430\u043d\u0442\u043e\u0440\u044b
    (\u2200 \u0438 \u2203). \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438
    \u0438 \u0432\u0441\u0435\u043e\u0431\u0449\u043d\u043e\u0441\u0442\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0444\u0440\u0430\u0437\u0443 \u00ab\u0414\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 X \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0447\u0438\u0441\u043b\u043e Y, \u0431\u043e\u043b\u044c\u0448\u0435\u0435 X\u00bb \u043c\u043e\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u0441\u0442\u0440\u043e\u0433\u043e\u0439
    \u0444\u043e\u0440\u043c\u0443\u043b\u043e\u0439. - \u0421\u043e\u0437\u0434\u0430\u043b
    \u043f\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u043b\u043e\u0433\u0438\u043a\u0443 (\u043b\u043e\u0433\u0438\u043a\u0443 \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u0439)
    \u0441 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u043c\u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u043d\u0438\u044f,
    \u0438\u043c\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u0438, \u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0446\u0438\u0438
    \u0438 \u0434\u0438\u0437\u044a\u044e\u043d\u043a\u0446\u0438\u0438, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a (\u0434\u0432\u0443\u043c\u0435\u0440\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u00abBegriffsschrift\u00bb \u2014 \u00ab\u0418\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u0439\u00bb). - \u0412\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \"\u0444\u0443\u043d\u043a\u0446\u0438\u044f\" \u0432 \u043b\u043e\u0433\u0438\u043a\u0443.
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u043b\u043e\u0436\u0438\u0442\u044c \u043d\u0430
    \u0444\u0443\u043d\u043a\u0446\u0438\u044e (\u0442\u043e, \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u043f\u043e\u0441\u043b\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044f \u0438\u043c\u0435\u043d\u0438)
    \u0438 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442 (\u0438\u043c\u044f). \u042d\u0442\u043e
    \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u043e\u0441\u044c
    \u043e\u0442 \u0430\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0441\u0445\u0435\u043c\u044b \u00ab\u0441\u0443\u0431\u044a\u0435\u043a\u0442-\u043f\u0440\u0435\u0434\u0438\u043a\u0430\u0442\u00bb.
    > \u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0432\u0430\u044f \u0432
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0435\u0434\u0443\u043a\u0446\u0438\u0438, \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f
    \u0434\u043b\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u0432\u0441\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0411\u0435\u0437
    \u044d\u0442\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u044b \u043d\u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432, \u043d\u0438 \u044f\u0437\u044b\u043a\u043e\u0432
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043d\u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430. --- 2. \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438: \u041b\u043e\u0433\u0438\u0446\u0438\u0437\u043c
    \u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0447\u0438\u0441\u0435\u043b
    (\u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438,
    1884) \u0424\u0440\u0435\u0433\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0432\u043e\u043f\u0440\u043e\u0441:
    \u00ab\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0447\u0438\u0441\u043b\u043e?\u00bb
    \u0414\u043e \u043d\u0435\u0433\u043e \u041a\u0430\u043d\u0442 \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u043d\u0430
    (\u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438), \u0430 \u041c\u0438\u043b\u043b\u044c \u2014
    \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u2014 \u044d\u0442\u043e
    \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435
    \u043e\u043f\u044b\u0442\u0430. \u0412\u043a\u043b\u0430\u0434 \u0424\u0440\u0435\u0433\u0435:
    - \u041b\u043e\u0433\u0438\u0446\u0438\u0437\u043c (\u0442\u0435\u0437\u0438\u0441): \u041e\u043d
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e \u0432\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 (\u0432 \u043f\u0435\u0440\u0432\u0443\u044e
    \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430)
    \u2014 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0430\u044f
    \u043b\u043e\u0433\u0438\u043a\u0430. \u0427\u0438\u0441\u043b\u0430 \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0438 \u043d\u0435 \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u0440\u0430\u0437\u044b \u0432 \u0433\u043e\u043b\u043e\u0432\u0435. - \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0447\u0438\u0441\u043b\u0430 \u043a\u0430\u043a \u043a\u043b\u0430\u0441\u0441\u0430 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438:
    \u0424\u0440\u0435\u0433\u0435 \u0434\u0430\u043b \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435: \u0427\u0438\u0441\u043b\u043e
    \u2014 \u044d\u0442\u043e \u043e\u0431\u044a\u0435\u043c \u043f\u043e\u043d\u044f\u0442\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u043e
    \u0434\u0430\u043d\u043d\u043e\u043c\u0443 \u043f\u043e\u043d\u044f\u0442\u0438\u044e. \u041f\u0440\u043e\u0449\u0435
    \u0433\u043e\u0432\u043e\u0440\u044f, \u0447\u0438\u0441\u043b\u043e \u00ab2\u00bb \u2014
    \u044d\u0442\u043e \u043d\u0435 \u0434\u0432\u0430 \u044f\u0431\u043b\u043e\u043a\u0430,
    \u0430 \u043a\u043b\u0430\u0441\u0441 \u0432\u0441\u0435\u0445 \u043f\u043e\u043d\u044f\u0442\u0438\u0439,
    \u043f\u043e\u0434 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0434\u043f\u0430\u0434\u0430\u0435\u0442
    \u0440\u043e\u0432\u043d\u043e \u0434\u0432\u0430 \u043e\u0431\u044a\u0435\u043a\u0442\u0430.
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u0447\u0438\u0441\u043b\u043e 0, 1 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435
    \u0447\u0438\u0441\u043b\u0430 \u0447\u0438\u0441\u0442\u043e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438,
    \u0431\u0435\u0437 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043a \u044d\u043c\u043f\u0438\u0440\u0438\u043a\u0435.
    - \u0411\u043e\u0440\u044c\u0431\u0430 \u0441 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0437\u043c\u043e\u043c:
    \u0424\u0440\u0435\u0433\u0435 \u0436\u0435\u0441\u0442\u043a\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0437\u0430\u043a\u043e\u043d\u044b \u043b\u043e\u0433\u0438\u043a\u0438
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u044b
    (\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u0432 \u00ab\u0442\u0440\u0435\u0442\u044c\u0435\u043c
    \u043c\u0438\u0440\u0435\u00bb \u2014 \u043c\u0438\u0440\u0435 \u043c\u044b\u0441\u043b\u0435\u0439),
    \u0438 \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u044f\u0442 \u043e\u0442 \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a \u0434\u0443\u043c\u0430\u0435\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a.
    \u042d\u0442\u043e \u0441\u043f\u0430\u0441\u043b\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043e\u0442 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u0438\u0437\u043c\u0430.
    > \u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u0443\u044e
    \u043e\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u044e \u0447\u0438\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0438 \u0432\u043f\u043b\u043e\u0442\u043d\u0443\u044e \u043f\u043e\u0434\u043e\u0448\u0435\u043b
    \u043a \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0435 \u041f\u0435\u0430\u043d\u043e
    (\u0445\u043e\u0442\u044f \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0435 \u0441\u0432\u043e\u0438\u043c\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438).
    --- 3. \u0421\u0435\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u043e\u0440\u044b\u0432:
    \u0420\u0430\u0437\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u00ab\u0421\u043c\u044b\u0441\u043b\u0430\u00bb
    \u0438 \u00ab\u0417\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u00bb (1892) \u042d\u0442\u043e,
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0424\u0440\u0435\u0433\u0435 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0443 \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u044f\u0437\u044b\u043a\u0430. \u0414\u043e \u0424\u0440\u0435\u0433\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0441\u043c\u044b\u0441\u043b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u2014 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432, \u043e \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0438\u0434\u0435\u0442 \u0440\u0435\u0447\u044c. \u0414\u0435\u0442\u0430\u043b\u0438
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438: - \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    (Bedeutung) \u2014 \u044d\u0442\u043e \u0441\u0430\u043c \u043e\u0431\u044a\u0435\u043a\u0442,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0435. \u0414\u043b\u044f \u0438\u043c\u0435\u043d\u0438
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u2014 \u044d\u0442\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442.
    \u0414\u043b\u044f \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u2014
    \u044d\u0442\u043e \u0435\u0433\u043e \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0441\u0442\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 (\u0418\u0441\u0442\u0438\u043d\u0430 \u0438\u043b\u0438
    \u041b\u043e\u0436\u044c). - \u0421\u043c\u044b\u0441\u043b (Sinn) \u2014 \u044d\u0442\u043e
    \u0441\u043f\u043e\u0441\u043e\u0431 \u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u0430,
    \u0442\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043d\u0430\u043c \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u044d\u0442\u043e\u0442 \u043e\u0431\u044a\u0435\u043a\u0442. \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440 \u0424\u0440\u0435\u0433\u0435: \u0412\u043e\u0437\u044c\u043c\u0435\u043c
    \u0434\u0432\u0430 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f: \u00ab\u0423\u0442\u0440\u0435\u043d\u043d\u044f\u044f
    \u0437\u0432\u0435\u0437\u0434\u0430\u00bb \u0438 \u00ab\u0412\u0435\u0447\u0435\u0440\u043d\u044f\u044f
    \u0437\u0432\u0435\u0437\u0434\u0430\u00bb. \u0418\u0445 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435 (\u043f\u043b\u0430\u043d\u0435\u0442\u0430
    \u0412\u0435\u043d\u0435\u0440\u0430). \u041d\u043e \u0438\u0445 \u0441\u043c\u044b\u0441\u043b\u044b
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0440\u0430\u0437\u043d\u044b\u0435
    (\u043e\u0434\u0438\u043d \u0432\u0438\u0434\u0435\u043d \u0443\u0442\u0440\u043e\u043c,
    \u0434\u0440\u0443\u0433\u043e\u0439 \u0432\u0435\u0447\u0435\u0440\u043e\u043c). \u041f\u043e\u044d\u0442\u043e\u043c\u0443
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u00ab\u0423\u0442\u0440\u0435\u043d\u043d\u044f\u044f
    \u0437\u0432\u0435\u0437\u0434\u0430 = \u0412\u0435\u0447\u0435\u0440\u043d\u044f\u044f
    \u0437\u0432\u0435\u0437\u0434\u0430\u00bb \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c (\u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430),
    \u0430 \u043d\u0435 \u043f\u0443\u0441\u0442\u043e\u0439 \u0442\u0430\u0432\u0442\u043e\u043b\u043e\u0433\u0438\u0435\u0439
    \u00ab\u0423\u0442\u0440\u0435\u043d\u043d\u044f\u044f \u0437\u0432\u0435\u0437\u0434\u0430
    = \u0423\u0442\u0440\u0435\u043d\u043d\u044f\u044f \u0437\u0432\u0435\u0437\u0434\u0430\u00bb.
    \u0412 \u0447\u0435\u043c \u0435\u0433\u043e \u043f\u0440\u043e\u0440\u044b\u0432: - \u0412\u0432\u0435\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0441\u043b\u043e\u0432\u043e \u0438\u043c\u0435\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f. - \u0421\u043e\u0437\u0434\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u043e\u0439
    \u0440\u0435\u0447\u0438. \u0415\u0441\u043b\u0438 \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c
    \u00ab\u041f\u0435\u0442\u044f \u0441\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043e
    \u0412\u0435\u043d\u0435\u0440\u0430 \u2014 \u044d\u0442\u043e \u0443\u0442\u0440\u0435\u043d\u043d\u044f\u044f
    \u0437\u0432\u0435\u0437\u0434\u0430\u00bb, \u0442\u043e \u0432 \u044d\u0442\u043e\u043c
    \u043f\u0440\u0438\u0434\u0430\u0442\u043e\u0447\u043d\u043e\u043c \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0438
    \u0443 \u0441\u043b\u043e\u0432 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u043e\u043d\u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c
    \u0441\u0432\u043e\u0439 \u0441\u043c\u044b\u0441\u043b, \u0430 \u043d\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442.
    \u042d\u0442\u043e \u0440\u0435\u0448\u0438\u043b\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443
    \u043f\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a (\u0437\u043d\u0430\u043d\u0438\u0439,
    \u0432\u0435\u0440\u043e\u0432\u0430\u043d\u0438\u0439, \u0436\u0435\u043b\u0430\u043d\u0438\u0439),
    \u043d\u0430\u0434 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u0438\u043b\u0438\u0441\u044c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u044b. > \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u043e \u043e\u0441\u043d\u043e\u0432\u0430
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0435\u043c\u0430\u043d\u0442\u0438\u043a\u0438. \u0411\u0435\u0437 \u044d\u0442\u043e\u0433\u043e
    \u0440\u0430\u0437\u043b\u0438\u0447\u0435\u043d\u0438\u044f \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b
    \u0431\u044b\u043b\u0438 \u0431\u044b \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0435
    \u044f\u0437\u044b\u043a\u0438 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432, \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0431\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438 \u0432 \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0435.
    --- 4. \u041f\u0440\u043e\u0440\u044b\u0432 \u0432 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u044f\u0437\u044b\u043a\u0430: \u0420\u0430\u0437\u043b\u0438\u0447\u0435\u043d\u0438\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u0430,
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0438 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442
    \u0424\u0440\u0435\u0433\u0435 \u0432\u0432\u0435\u043b \u043e\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0435: - \u041e\u0431\u044a\u0435\u043a\u0442 \u2014 \u044d\u0442\u043e
    \u0432\u0441\u0435, \u0447\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c
    \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u0438\u043a\u0430\u0442\u043e\u043c (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u00ab\u0412\u0435\u043d\u0435\u0440\u0430\u00bb, \u00ab\u0447\u0438\u0441\u043b\u043e 2\u00bb).
    - \u041f\u043e\u043d\u044f\u0442\u0438\u0435 (\u043a\u043e\u043d\u0446\u0435\u043f\u0442)
    \u2014 \u044d\u0442\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u043e\u0431\u044a\u0435\u043a\u0442\u044b
    \u0432 \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0441\u0442\u043d\u044b\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    (\u0418\u0441\u0442\u0438\u043d\u0430/\u041b\u043e\u0436\u044c). \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u00ab... \u0435\u0441\u0442\u044c \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u00bb \u2014
    \u044d\u0442\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435. - \u0424\u0443\u043d\u043a\u0446\u0438\u044f
    \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u2014 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f
    \u043a \u043e\u0431\u044a\u0435\u043a\u0442\u0430\u043c. - \u0424\u0443\u043d\u043a\u0446\u0438\u044f
    \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u2014 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f
    \u043a \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c \u043f\u0435\u0440\u0432\u043e\u0433\u043e
    \u0443\u0440\u043e\u0432\u043d\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043a\u0432\u0430\u043d\u0442\u043e\u0440 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u00ab\u2203x\u00bb \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a
    \u043f\u043e\u043d\u044f\u0442\u0438\u044e \u00abx \u0435\u0441\u0442\u044c \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u00bb).
    \u042d\u0442\u043e \u0438\u0437\u0431\u0430\u0432\u0438\u043b\u043e \u043b\u043e\u0433\u0438\u043a\u0443
    \u043e\u0442 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u044b: \u0414\u043e \u0424\u0440\u0435\u0433\u0435
    \u043c\u043d\u043e\u0433\u0438\u0435 \u043f\u0443\u0442\u0430\u043b\u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e
    \u043e\u0431\u044a\u0435\u043a\u0442\u0430 (\u043a\u0430\u043a \u00ab\u0431\u044b\u0442\u044c
    \u043b\u043e\u0448\u0430\u0434\u044c\u044e\u00bb) \u0441 \u0441\u0430\u043c\u0438\u043c
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u043c. \u0424\u0440\u0435\u0433\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u044d\u0442\u043e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0448\u0438\u0431\u043a\u0438, \u0438 \u0438\u0445 \u0441\u043c\u0435\u0448\u0435\u043d\u0438\u0435
    \u0432\u0435\u0434\u0435\u0442 \u043a \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043c.
    --- 5. \u041f\u043e\u043f\u044b\u0442\u043a\u0430 \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u00ab\u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441
    \u0420\u0430\u0441\u0441\u0435\u043b\u0430\u00bb (1893\u20131903) \u0412 \u0434\u0432\u0443\u0445\u0442\u043e\u043c\u043d\u0438\u043a\u0435
    \u00ab\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0437\u0430\u043a\u043e\u043d\u044b
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb \u0424\u0440\u0435\u0433\u0435
    \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443,
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c
    \u0432\u044b\u0432\u043e\u0434\u0430 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u0431\u044b \u0434\u0435\u0434\u0443\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0441\u044e
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443. \u0415\u0433\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435
    \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0432 \u044d\u0442\u043e\u043c \u0442\u0440\u0443\u0434\u0435: - \u0421\u043e\u0437\u0434\u0430\u043b
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0443 \u043e\u0431\u044a\u0435\u043c\u0430
    \u043f\u043e\u043d\u044f\u0442\u0438\u0439 (\u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432). - \u0412\u0432\u0435\u043b \u043f\u0440\u0430\u0432\u0438\u043b\u043e,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0435\u0435 \u043f\u043e \u043b\u044e\u0431\u043e\u0439
    \u0444\u043e\u0440\u043c\u0443\u043b\u0435 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432, \u0435\u0439 \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u044e\u0449\u0438\u0445
    (\u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u0430\u044f \u0441\u0445\u0435\u043c\u0430
    \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f). \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f
    \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434: \u041a\u043e\u0433\u0434\u0430
    \u0420\u0430\u0441\u0441\u0435\u043b \u043f\u0440\u0438\u0441\u043b\u0430\u043b \u0435\u043c\u0443
    \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u043c
    (\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043b\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0432\u0441\u0435\u0445 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u043d\u0435
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0445 \u0441\u0430\u043c\u0438\u0445
    \u0441\u0435\u0431\u044f?), \u0424\u0440\u0435\u0433\u0435 \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u044d\u0442\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0432 \u043d\u0430\u0443\u043a\u0443: - \u0424\u0440\u0435\u0433\u0435 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e,
    \u0447\u0435\u0441\u0442\u043d\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043b \u043e\u0448\u0438\u0431\u043a\u0443
    \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043a\u043e \u0432\u0442\u043e\u0440\u043e\u043c\u0443
    \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u044d\u0442\u0438\u043a\u0438. - \u0415\u0433\u043e \u043d\u0435\u0443\u0434\u0430\u0447\u0430
    \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u043f\u0440\u0438\u0432\u0435\u043b\u0430
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0442\u0438\u043f\u043e\u0432 \u0420\u0430\u0441\u0441\u0435\u043b\u0430 \u0438, \u043f\u043e\u0437\u0436\u0435,
    \u043a \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0426\u0435\u0440\u043c\u0435\u043b\u043e-\u0424\u0440\u0435\u043d\u043a\u0435\u043b\u044f
    (ZF), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043f\u0430\u0441\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043e\u0442 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u0432. - \u041e\u043d
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044e
    \u043c\u0435\u0442\u0430\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u2014
    \u043d\u0430\u0443\u043a\u0443 \u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043e\u0437\u0436\u0435 \u0440\u0430\u0437\u0432\u0438\u043b
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442. --- 6. \u0421\u043a\u0440\u044b\u0442\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u0439 \u0438 \u0438\u043c\u043f\u043b\u0438\u043a\u0430\u0442\u0443\u0440\u044b
    \u0412 \u0441\u0432\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u0424\u0440\u0435\u0433\u0435
    \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u0437\u0434\u0430\u043b
    \u043f\u0435\u0440\u0432\u0443\u044e \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0434\u043b\u044f \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 (\u043e\u043d \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0437\u0430\u043a\u043e\u043d \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u043e\u0433\u043e
    \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0432\u044b\u0432\u043e\u0434\u0430\u0445, \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044f,
    \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043e\u0431\u043e\u0439\u0442\u0438\u0441\u044c
    \u0431\u0435\u0437 \u043d\u0435\u0433\u043e, \u0447\u0435\u043c \u043f\u043e\u0437\u0436\u0435
    \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0411\u0440\u0430\u0443\u044d\u0440 \u0438 \u0413\u0435\u0439\u0442\u0438\u043d\u0433).
    \u0422\u0430\u043a\u0436\u0435 \u043e\u043d \u0447\u0435\u0442\u043a\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    (\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0424\u0440\u0435\u0433\u0435): \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0446\u0435\u043b\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439
    \u043e\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u0435\u0439.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u043c \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0438 \u041d\u043e\u0430\u043c\u0430
    \u0425\u043e\u043c\u0441\u043a\u043e\u0433\u043e \u0438 \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430
    (NLP). --- 7. \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 Computer Science (\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0443)
    \u0427\u0430\u0441\u0442\u043e \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0442, \u0447\u0442\u043e
    \u0424\u0440\u0435\u0433\u0435 \u2014 \u043a\u0440\u0435\u0441\u0442\u043d\u044b\u0439 \u043e\u0442\u0435\u0446
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f:
    - \u041b\u044f\u043c\u0431\u0434\u0430-\u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u0427\u0435\u0440\u0447\u0430 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0432\u044b\u0440\u043e\u0441\u043b\u043e
    \u0438\u0437 \u0444\u0440\u0435\u0433\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. - \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u044f\u0437\u044b\u043a\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    (Haskell, Lisp, Prolog) \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u043b\u043e\u0433\u0438\u043a\u0443
    \u043f\u0440\u0435\u0434\u0438\u043a\u0430\u0442\u043e\u0432 \u0424\u0440\u0435\u0433\u0435.
    - \u0421\u0438\u0441\u0442\u0435\u043c\u044b \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0435\u043e\u0440\u0435\u043c
    (Coq, Agda) \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0438\u043c\u0435\u043d\u043d\u043e
    \u0444\u0440\u0435\u0433\u0435\u0432\u0441\u043a\u0438\u0439 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043a \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432
