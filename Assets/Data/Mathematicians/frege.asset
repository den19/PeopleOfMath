    \u043e \u043d\u0435\u043c. ---\n\n\U0001F4D6 \u0424\u0438\u0433\u0443\u0440\u0430 \u0434\u043b\u044f
    \u0437\u043d\u0430\u0442\u043e\u043a\u043e\u0432: \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u0438\u0448\u043b\u043e \u0441\u043b\u0438\u0448\u043a\u043e\u043c
