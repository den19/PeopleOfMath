    \u0435\u0433\u043e \u0438 \u043e\u0442\u0432\u0435\u0442\u0438\u043b\u0430: \"\u0414\u0430,
    \u043f\u0430\u043f\u0430, \u043c\u0430\u043c\u0430 \u0442\u0430\u043a \u0438 \u0434\u0443\u043c\u0430\u043b\u0430,
    \u0447\u0442\u043e \u0442\u044b \u044d\u0442\u043e \u0437\u0430\u0431\u0443\u0434\u0435\u0448\u044c\".\n\n\U0001F914
