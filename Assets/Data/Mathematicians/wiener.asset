    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043b\u0435\u0433\u0435\u043d\u0434.
    \u0412 \u043d\u0438\u0445 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u0435\u0433\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u2014 \u043e\u0442 \u0447\u0443\u0434\u0430\u043a\u043e\u0432\u0430\u0442\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0434\u043e \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f.\n\n\U0001F604 \u0410\u043d\u0435\u043a\u0434\u043e\u0442,
    \u0441\u0442\u0430\u0432\u0448\u0438\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439
