    \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0439, \u0441\u043a\u043e\u0440\u0435\u0435
    \u0442\u0440\u0430\u0433\u0438\u043a\u043e\u043c\u0438\u0447\u043d\u044b\u0439, \u0441\u043b\u0443\u0447\u0430\u0439,
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0439 \u0441 \u0435\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435\u043c.
    \u0412 1950 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \"\u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043f\u0435\u0440\u0447\u0430\u0442\u043a\u0443\" \u2014 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u044b\u0432\u0430\u0442\u044c
    \u0437\u0432\u0443\u043a\u0438 \u0440\u0435\u0447\u0438 \u0432 \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u0438
    \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044c \u0438\u0445 \u043d\u0430
    \u043f\u0430\u043b\u044c\u0446\u044b, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044f \u0433\u043b\u0443\u0445\u0438\u043c
    \"\u0441\u043b\u044b\u0448\u0430\u0442\u044c\" \u043a\u043e\u0436\u0435\u0439. \u042d\u0442\u043e
    \u0431\u044b\u043b \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u0440\u043e\u0435\u043a\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \"\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c
    \u043a\u0438\u0431\u0435\u0440\u043d\u0435\u0442\u0438\u043a\u0438\" \u043f\u043e\u0441\u043b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0434 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u043c\u0438
    \u041f\u0412\u041e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0439\u043d\u044b.
    \u0412\u0438\u043d\u0435\u0440 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b \u0432
    \u0441\u0432\u043e\u044e \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044e
    \u0432 MIT \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u0443\u044e \u0425\u0435\u043b\u0435\u043d
    \u041a\u0435\u043b\u043b\u0435\u0440 \u2014 \u0441\u043b\u0435\u043f\u043e\u0433\u043b\u0443\u0445\u0443\u044e
    \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0443 \u0438 \u0430\u043a\u0442\u0438\u0432\u0438\u0441\u0442\u043a\u0443,
    \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u044b\u0442\u0430\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435.
    \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0447\u0443\u0434\u0430
    \u043d\u0435 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e. \u041f\u043e\u0441\u043b\u0435
    \u0447\u0430\u0441\u0430 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0435\u0435 \u043f\u0430\u043b\u044c\u0446\u0435\u0432 \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0439, \u0447\u0442\u043e\u0431\u044b
    \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u0442\u044c \u0440\u0435\u0447\u044c.
    \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435, \u0447\u0442\u043e
    \u043e\u043d\u0430 \u0441\u043c\u043e\u0433\u043b\u0430 \u0443\u043b\u043e\u0432\u0438\u0442\u044c,
    \u2014 \u044d\u0442\u043e \"\u0437\u0430\u043b\u0438\u0432\u0438\u0441\u0442\u044b\u0439
    \u0441\u043c\u0435\u0445, \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u0432\u0448\u0438\u0439\u0441\u044f
    \u0438\u0437 \u043c\u0430\u0448\u0438\u043d\u044b \u0438\u0437-\u0437\u0430 \u043c\u043e\u0438\u0445
    \u043e\u0448\u0438\u0431\u043e\u043a\". \u041f\u0440\u043e\u0435\u043a\u0442 \"\u0441\u043b\u044b\u0448\u0430\u0449\u0435\u0439
    \u043f\u0435\u0440\u0447\u0430\u0442\u043a\u0438\" \u0432\u0441\u043a\u043e\u0440\u0435
    \u0431\u044b\u043b \u0437\u0430\u043a\u0440\u044b\u0442.\n\n\U0001F463 \u0427\u0435\u043b\u043e\u0432\u0435\u043a-\u043a\u043e\u043c\u043f\u0430\u0441
    \u0415\u0433\u043e \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0441\u0442\u044c
    \u0438\u043d\u043e\u0433\u0434\u0430 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b\u0430\u0441\u044c
    \u0432 \u0441\u0430\u043c\u044b\u0445 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445.
    \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043f\u0440\u043e\u0433\u0443\u043b\u043e\u043a \u043f\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c
    \u043a\u043e\u0440\u0438\u0434\u043e\u0440\u0430\u043c MIT \u043e\u043d \u0432\u0441\u0435\u0433\u0434\u0430
    \u0448\u0435\u043b, \u0441\u043b\u0435\u0433\u043a\u0430 \u043a\u0430\u0441\u0430\u044f\u0441\u044c
    \u043f\u0430\u043b\u044c\u0446\u0435\u043c \u0441\u0442\u0435\u043d\u044b \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435
    \u043f\u043b\u0435\u0447\u0430. \u041e\u0434\u043d\u0430\u0436\u0434\u044b, \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0432
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430, \u043e\u043d \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0441\u044f,
    \u0447\u0442\u043e\u0431\u044b \u0441\u043f\u0440\u043e\u0441\u0438\u0442\u044c \u0435\u0433\u043e
    \u043e \u043a\u0430\u043a\u043e\u043c-\u0442\u043e \u0442\u0430\u043d\u0446\u0435, \u0430
    \u0437\u0430\u0442\u0435\u043c \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e \u0437\u0430\u0434\u0430\u043b
    \u0432\u043e\u043f\u0440\u043e\u0441: \u043e\u043d \u0448\u0435\u043b \u043d\u0430 \u0432\u043e\u0441\u0442\u043e\u043a
    \u0438\u043b\u0438 \u043d\u0430 \u0437\u0430\u043f\u0430\u0434? \u041e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f,
    \u0435\u0441\u043b\u0438 \u043e\u043d \u0448\u0435\u043b \u043d\u0430 \u0432\u043e\u0441\u0442\u043e\u043a,
    \u0442\u043e \u0435\u0449\u0435 \u043d\u0435 \u043e\u0431\u0435\u0434\u0430\u043b, \u0430
    \u0435\u0441\u043b\u0438 \u043d\u0430 \u0437\u0430\u043f\u0430\u0434 \u2014 \u0442\u043e
    \u0443\u0436\u0435 \u043f\u043e\u043e\u0431\u0435\u0434\u0430\u043b. \u0421\u0442\u0443\u0434\u0435\u043d\u0442
    \u043f\u043e\u043c\u043e\u0433 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0443
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044e
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0434\u043d\u044f.\n\n\U0001F4DC \u0418 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u043e
    \u0442\u0449\u0435\u0441\u043b\u0430\u0432\u0438\u0438 \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0432\u0441\u044e \u0441\u0432\u043e\u044e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0441\u0442\u044c, \u0412\u0438\u043d\u0435\u0440
    \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043c\u043e\u0433 \u0431\u044b\u0442\u044c \u0436\u0435\u0441\u0442\u043a\u0438\u043c \u0432
    \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u0445 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430. \u041e\u0434\u043d\u0430\u0436\u0434\u044b,
    \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u0443\u0437\u043d\u0430\u0432 \u043e\u0442
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u043e \u0442\u0435\u043c\u0430\u0445 \u0433\u043e\u0442\u043e\u0432\u044f\u0449\u0438\u0445\u0441\u044f
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0439 \u0435\u0433\u043e \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u0432,
    \u0412\u0438\u043d\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0437\u0430\u0434\u0430\u0447\u0430
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0439
    \u0441 \"\u044d\u0441\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u043e\u0447\u043a\u0438
    \u0437\u0440\u0435\u043d\u0438\u044f\", \u0431\u044b\u0441\u0442\u0440\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043f\u0435\u0440\u0432\u044b\u043c.
    \u041a\u043e\u0433\u0434\u0430 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c
    \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u0432 \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b
    \u0435\u0433\u043e \u043f\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u0442\u044c, \u0412\u0438\u043d\u0435\u0440
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f,
    \u043e\u0442\u0441\u0442\u0430\u0438\u0432\u0430\u044f \u0441\u0432\u043e\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c. \u042d\u0442\u043e\u0442
    \u044d\u043f\u0438\u0437\u043e\u0434 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0437\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0441\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441 \u0441\u0438\u043b\u044c\u043d\u044b\u043c
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c \u0438 \u0431\u0435\u0441\u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043d\u044b\u043c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435\u043c \u043a \u043d\u0430\u0443\u043a\u0435."
  interestingFactsEn: "Norbert Weiner was not only a genius scientist, but also a man with unique, sometimes eccentric habits that have given rise to many legends, revealing his amazing personality, ranging from a strange professor to a scattered genius.\n\n♪ Anecdote, a legend, perhaps the most famous chicken in Viner's life, is the story of moving that perfectly illustrates his phenomenal dispersion. ♪ When the family moved to a new apartment, his prudent wife put him in a wallet with a new address ♪ ♪ but on the same day, caught by another brilliant idea ♪ ♪ Viner used the back of the leaf to calculate and disillusioned with it ♪In the evening, he went to the old address and found the house empty and approached the girl who was playing next to him, asking him where Vinera had moved, and the girl listened to him and said, \"Yes, Daddy, Mom thought you'd forget it.\"\n\n♪ His lectures at MlT were also full of wonders, and students remembered that Winer often entered the audience without any records, and he snorted, then turned silently to the board and started writing with chalk, and then began to mutter: \"Well, that's not the definition at all\", and then quickly washed it up and started over again.This cycle could continue the entire lecture, and the students could barely write something down before it disappeared again. At the end, without saying goodbye, the professor left the audience. On another occasion, he simply rewritten the same expression on the board three times, stating that he had taken \"three different ways\".\n\nIn 1950, he introduced \"Hearing Glove\" to Helen Keller but had a chicken-like, rather tragic case of his invention. He introduced a \"cybernetic glove\" — a device that was supposed to convert speech sounds into vibrations and transmit them to his fingers, allowing deaf people to hear their skins. This was his first project, which he considered \"constructive design\" after working on air defence systems during the war.Winner invited her to his lab at MlT, the legendary Helen Keller, a blindly deaf writer and activist to test the invention. Unfortunately, the miracle didn't happen. After an hour of training, her fingers weren't enough to recognize the speech. The only thing she could catch was \"the grunting laugh that was coming out of the car because of my mistakes.\" The \"hearing glove\" project was soon closed.\n\n♪ The man-compassion was sometimes in the funniest shapes. ♪ For example, while walking along endless corridors MIT, he always walked a little bit touching the wall's finger on the shoulder level. ♪ One day, when he met a student, he stopped to ask him about some dance and then suddenly asked, \"Is he going east or west?\" ♪ Turns out, if he was going east, he hadn't had lunch, and if he was west, he had already had lunch.The student helped the professor restore his own day's timeline.\n\nAnd a little bit of vanity, despite all his genius and his dissension, Viner was a man who could have been tough on scientific priority issues. One day, learning by chance from a colleague about the subjects of his graduate thesis, Viner, who found the task interesting from an \"esthetic point of view\", quickly completed the study and published the results first.When he was asked to wait, Winner categorically refused to defend his scientific independence, and this episode shows that a man with a strong and uncompromising attitude to science was hiding behind a dissociated professor."
