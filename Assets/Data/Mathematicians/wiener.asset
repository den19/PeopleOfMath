    \u0442\u0435\u043E\u0440\u0438\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0438 \u0441\u0432\u044F\u0437\u0438.  \u0412 **1948 \u0433\u043E\u0434\u0443**
    \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0435\u0433\u043E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u0442\u0440\u0443\u0434 \u2014 **\xAB\u041A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0430,
    \u0438\u043B\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
