    \u0432\u043E\u0439\u043D\u0430 \u0441\u0442\u0430\u043B\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C
    \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C. \u0412\u0438\u043D\u0435\u0440
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043D\u0430\u0434 \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0435\u0439
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439 \u2014 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C
