    \u043D\u043E \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u043E\u0435
    \u043E\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u0438\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
    \u043A\u0430\u043A \u0441\u043F\u043E\u0441\u043E\u0431\u0430 \u0431\u043E\u0440\u044C\u0431\u044B
    \u0441 \u044D\u043D\u0442\u0440\u043E\u043F\u0438\u0435\u0439 \u0438 \u0445\u0430\u043E\u0441\u043E\u043C. 
    ### \u041F\u043E\u0437\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B \u0438
    \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435  \u041F\u043E\u0441\u043B\u0435
    \u0432\u043E\u0439\u043D\u044B \u0412\u0438\u043D\u0435\u0440 \u0441\u0442\u0430\u043B
    \u044F\u0440\u044B\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C
    \u043C\u0438\u043B\u0438\u0442\u0430\u0440\u0438\u0437\u0430\u0446\u0438\u0438
    \u043D\u0430\u0443\u043A\u0438 \u0438 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0441\u044F
    \u043E\u0442 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432.
    \u041E\u043D \u043C\u043D\u043E\u0433\u043E \u043F\u0438\u0441\u0430\u043B \u043E
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0443\u0447\u0435\u043D\u043E\u0433\u043E \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044F\u0445
    \u043D\u0435\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u043E\u0433\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439.  \u0417\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u0434\u043E \u0441\u043C\u0435\u0440\u0442\u0438,
    \u0432 1964 \u0433\u043E\u0434\u0443, \u043E\u043D \u0431\u044B\u043B \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D
    \u0432\u044B\u0441\u0448\u0435\u0439 \u043D\u0430\u0443\u0447\u043D\u043E\u0439
    \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u0421\u0428\u0410 \u2014 **\u041D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u043C\u0435\u0434\u0430\u043B\u0438 \u0437\u0430 \u043D\u0430\u0443\u0447\u043D\u044B\u0435
    \u0437\u0430\u0441\u043B\u0443\u0433\u0438**, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u0435\u043C\u0443 \u0432\u0440\u0443\u0447\u0438\u043B \u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442
    \u041B\u0438\u043D\u0434\u043E\u043D \u0414\u0436\u043E\u043D\u0441\u043E\u043D.
    \u041D\u043E\u0440\u0431\u0435\u0440\u0442 \u0412\u0438\u043D\u0435\u0440 \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F
    18 \u043C\u0430\u0440\u0442\u0430 1964 \u0433\u043E\u0434\u0430 \u0432 \u0421\u0442\u043E\u043A\u0433\u043E\u043B\u044C\u043C\u0435
    \u043E\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430. 
    \u0415\u0433\u043E \u043A\u043D\u0438\u0433\u0438, \u0442\u0430\u043A\u0438\u0435
    \u043A\u0430\u043A \xAB\u041A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0430
    \u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E\xBB \u0438 \u0430\u0432\u0442\u043E\u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438
    \xAB\u0411\u044B\u0432\u0448\u0438\u0439 \u0432\u0443\u043D\u0434\u0435\u0440\u043A\u0438\u043D\u0434\xBB
    \u0438 \xAB\u042F \u2014 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\xBB,
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
    \u0432\u0430\u0436\u043D\u044B\u043C\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u043C\u0438
    \u0434\u043B\u044F \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0443\u043A\u0438, \u043D\u043E
    \u0438 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u044D\u0442\u043E\u0433\u043E
    \u0432\u044B\u0434\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
