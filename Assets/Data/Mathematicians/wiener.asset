  achievementsRu: "\u041D\u0430\u0443\u0447\u043D\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435
    \u041D\u043E\u0440\u0431\u0435\u0440\u0442\u0430 \u0412\u0438\u043D\u0435\u0440\u0430
    \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
    \u043D\u0430 \u0434\u0432\u0430 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u044D\u0442\u0430\u043F\u0430:
    \u0435\u0433\u043E \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
    \u043F\u043E \"\u0447\u0438\u0441\u0442\u043E\u0439\" \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435
    \u0432 \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    \u043A\u0430\u0440\u044C\u0435\u0440\u044B \u0438 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u043A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0441\u0442\u0430\u043B\u0430 \u0434\u0435\u043B\u043E\u043C \u0435\u0433\u043E
    \u0436\u0438\u0437\u043D\u0438.  ### \U0001F4D0 \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043E\u0441\u043D\u043E\u0432\u044B: \u043E\u0442 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0434\u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432  \u0414\u043E \u0442\u043E\u0433\u043E
    \u043A\u0430\u043A \u0412\u0438\u043D\u0435\u0440 \u0441\u0442\u0430\u043B \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u043A\u0430\u043A \"\u043E\u0442\u0435\u0446 \u043A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0438\",
    \u043E\u043D \u0431\u044B\u043B \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043D\u044B\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C, \u0432\u043D\u0435\u0441\u0448\u0438\u043C
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u0432\u043A\u043B\u0430\u0434 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043E\u0431\u043B\u0430\u0441\u0442\u0435\u0439.  *   **\u0413\u0430\u0440\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043D\u0430\u043B\u0438\u0437 \u0438 \u0442\u0435\u043E\u0440\u0438\u044F
    \u0424\u0443\u0440\u044C\u0435:** \u0415\u0433\u043E \u0440\u0430\u043D\u043D\u0438\u0435
    \u0440\u0430\u0431\u043E\u0442\u044B \u0431\u044B\u043B\u0438 \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u044B
    \u0440\u044F\u0434\u0430\u043C \u0438 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F\u043C
    \u0424\u0443\u0440\u044C\u0435, \u0442\u0430\u0443\u0431\u0435\u0440\u043E\u0432\u044B\u043C
    \u0442\u0435\u043E\u0440\u0435\u043C\u0430\u043C \u0438 \u043E\u0431\u0449\u0435\u043C\u0443
    \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443
    \u0430\u043D\u0430\u043B\u0438\u0437\u0443. *   **\u0422\u0435\u043E\u0440\u0438\u044F
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432:**
    \u0412\u0438\u043D\u0435\u0440 \u0432\u0432\u0435\u043B **\"\u0432\u0438\u043D\u0435\u0440\u043E\u0432\u0441\u043A\u0443\u044E
    \u043C\u0435\u0440\u0443\"** \u2014 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043E\u0431\u044A\u0435\u043A\u0442 \u0432 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0445 \u0444\u0443\u043D\u043A\u0446\u0438\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u0442\u0430\u043B \u043E\u0441\u043D\u043E\u0432\u043E\u0439
    \u0434\u043B\u044F \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432. \u041C\u043E\u0434\u0435\u043B\u044C
    \u0431\u0440\u043E\u0443\u043D\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F,
    \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0449\u0430\u044F \u0445\u0430\u043E\u0442\u0438\u0447\u043D\u043E\u0435
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0447\u0430\u0441\u0442\u0438\u0446
    \u0432 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438, \u0442\u0430\u043A\u0436\u0435
    \u043D\u043E\u0441\u0438\u0442 \u0435\u0433\u043E \u0438\u043C\u044F \u2014 **\u0432\u0438\u043D\u0435\u0440\u043E\u0432\u0441\u043A\u0438\u0439
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441**, \u0438 \u043E\u043D \u0434\u043E\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0435\u0433\u043E \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043D\u0435\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0440\u0443\u0435\u043C\u044B\u043C\u0438.
    *   **\u0424\u0438\u043B\u044C\u0442\u0440\u0430\u0446\u0438\u044F \u0438 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043D\u0438\u0435:**
    \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0412\u0442\u043E\u0440\u043E\u0439
    \u043C\u0438\u0440\u043E\u0432\u043E\u0439 \u0432\u043E\u0439\u043D\u044B, \u0440\u0430\u0431\u043E\u0442\u0430\u044F
    \u043D\u0430\u0434 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u043C\u0438 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0437\u0435\u043D\u0438\u0442\u043D\u043E\u0433\u043E \u043E\u0433\u043D\u044F,
    \u0412\u0438\u043D\u0435\u0440 (\u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E
    \u043E\u0442 \u0410.\u041D. \u041A\u043E\u043B\u043C\u043E\u0433\u043E\u0440\u043E\u0432\u0430)
    \u0441\u043E\u0437\u0434\u0430\u043B **\u0442\u0435\u043E\u0440\u0438\u044E \u0438\u043D\u0442\u0435\u0440\u043F\u043E\u043B\u044F\u0446\u0438\u0438,
    \u044D\u043A\u0441\u0442\u0440\u0430\u043F\u043E\u043B\u044F\u0446\u0438\u0438
    \u0438 \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u0446\u0438\u0438 \u0441\u0442\u0430\u0446\u0438\u043E\u043D\u0430\u0440\u043D\u044B\u0445
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432**.
    \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C \u0441\u0442\u0430\u043B
    **\u0444\u0438\u043B\u044C\u0442\u0440 \u0412\u0438\u043D\u0435\u0440\u0430**
    \u2014 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0439
    \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439
    \u0441\u0438\u0433\u043D\u0430\u043B \u043E\u0442 \u0448\u0443\u043C\u0430 \u0438
    \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
    \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u043D\u0435\u043F\u043E\u043B\u043D\u044B\u0445 \u0434\u0430\u043D\u043D\u044B\u0445.
    *   **\u0424\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0442\u0435\u043E\u0440\u0435\u043C\u044B:** \u0418\u043C\u044F \u0412\u0438\u043D\u0435\u0440\u0430
    \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438
    \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u043C\u0438 \u0442\u0435\u043E\u0440\u0435\u043C\u0430\u043C\u0438
    \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    **\u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u041F\u044D\u043B\u0438-\u0412\u0438\u043D\u0435\u0440\u0430**
    (\u043E \u0441\u0432\u044F\u0437\u0438 \u0440\u043E\u0441\u0442\u0430 \u0446\u0435\u043B\u044B\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439 \u0438 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0424\u0443\u0440\u044C\u0435) \u0438 **\u0442\u0435\u043E\u0440\u0435\u043C\u0443
    \u0412\u0438\u043D\u0435\u0440\u0430-\u0425\u0438\u043D\u0447\u0438\u043D\u0430**
    (\u043E \u0441\u043F\u0435\u043A\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u0438 \u0441\u0442\u0430\u0446\u0438\u043E\u043D\u0430\u0440\u043D\u044B\u0445
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432). 
    ### \U0001F9E0 \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u043A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0438:
    \u043D\u0430\u0443\u043A\u0430 \u043E\u0431 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u0438 \u0441\u0432\u044F\u0437\u0438  \u041A\u0443\u043B\u044C\u043C\u0438\u043D\u0430\u0446\u0438\u0435\u0439
    \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0439 \u0412\u0438\u043D\u0435\u0440\u0430
    \u0441\u0442\u0430\u043B\u043E \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435,
    \u0447\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F,
    \u0441\u0432\u044F\u0437\u0438 \u0438 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u043F\u043E\u0434\u0447\u0438\u043D\u044F\u044E\u0442\u0441\u044F
    \u0435\u0434\u0438\u043D\u044B\u043C \u0437\u0430\u043A\u043E\u043D\u0430\u043C,
    \u0431\u0443\u0434\u044C \u0442\u043E \u0432 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435, \u0436\u0438\u0432\u043E\u043C
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0435 \u0438\u043B\u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435.
    \u042D\u0442\u0443 \u0438\u0434\u0435\u044E \u043E\u043D \u0438\u0437\u043B\u043E\u0436\u0438\u043B
    \u0432 \u0441\u0432\u043E\u0435\u043C \u0433\u043B\u0430\u0432\u043D\u043E\u043C
    \u0442\u0440\u0443\u0434\u0435 \u2014 \u043A\u043D\u0438\u0433\u0435 **\xAB\u041A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0430,
    \u0438\u043B\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0438 \u0441\u0432\u044F\u0437\u044C \u0432 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u043C
    \u0438 \u043C\u0430\u0448\u0438\u043D\u0435\xBB**, \u0432\u044B\u0448\u0435\u0434\u0448\u0435\u0439
    \u0432 1948 \u0433\u043E\u0434\u0443.  \u0412 \u044D\u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435
    \u0412\u0438\u043D\u0435\u0440 \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u043D\u043E\u0432\u043E\u0439 \u043D\u0430\u0443\u043A\u0438: *   **\u041F\u0440\u0438\u043D\u0446\u0438\u043F
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u0438
    (feedback):** \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439
    \u0434\u043B\u044F \u043A\u043E\u0440\u0440\u0435\u043A\u0446\u0438\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B
    \u0434\u043E\u0441\u0442\u0438\u0447\u044C \u0446\u0435\u043B\u0438. \u042D\u0442\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u0438,
    \u043E\u0431\u0449\u0438\u0439 \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u0441\u0438\u0441\u0442\u0435\u043C.
    *   **\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043A\u0430\u043A
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0430\u044F
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F:** \u0412\u0438\u043D\u0435\u0440
    \u043E\u0442\u043E\u0436\u0434\u0435\u0441\u0442\u0432\u0438\u043B \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
    \u0441 **\u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u044D\u043D\u0442\u0440\u043E\u043F\u0438\u0435\u0439 (\u043D\u0435\u0433\u044D\u043D\u0442\u0440\u043E\u043F\u0438\u0435\u0439)**,
    \u0441\u0434\u0435\u043B\u0430\u0432 \u0435\u0435 \u043E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A
    \u043F\u0440\u0438\u0440\u043E\u0434\u044B, \u043D\u0430\u0440\u044F\u0434\u0443
    \u0441 \u043C\u0430\u0442\u0435\u0440\u0438\u0435\u0439 \u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439.
    \u041A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0430, \u0432 \u0435\u0433\u043E
    \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0438, \u2014 \u044D\u0442\u043E
    \u043D\u0430\u0443\u043A\u0430 \u043E \u0431\u043E\u0440\u044C\u0431\u0435 \u0441
    \u0445\u0430\u043E\u0441\u043E\u043C \u0438 \u0434\u0435\u0437\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0435\u0439.
    *   **\u0415\u0434\u0438\u043D\u0441\u0442\u0432\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
    \u0438 \u043C\u0430\u0448\u0438\u043D\u044B:** \u0412\u0438\u043D\u0435\u0440
    \u043F\u0440\u043E\u0432\u0435\u043B \u0441\u043C\u0435\u043B\u044B\u0435 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u0438
    \u043C\u0435\u0436\u0434\u0443 \u043D\u0435\u0440\u0432\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439
    \u0436\u0438\u0432\u043E\u0433\u043E \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430
    \u0438 \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043C\u0430\u0448\u0438\u043D\u043E\u0439, \u0443\u043A\u0430\u0437\u0430\u0432
    \u043D\u0430 \u043E\u0431\u0449\u0443\u044E \u0434\u043B\u044F \u043D\u0438\u0445
    \u0440\u043E\u043B\u044C \u043F\u0430\u043C\u044F\u0442\u0438 \u0438 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u0432.  ### \U0001F4DA \u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u0442\u0440\u0443\u0434\u044B  \u041F\u043E\u043C\u0438\u043C\u043E \"\u041A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0438\",
    \u0412\u0438\u043D\u0435\u0440 \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u0440\u044F\u0434
    \u0440\u0430\u0431\u043E\u0442, \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0449\u0438\u0445
    \u0438 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u0445
    \u0435\u0433\u043E \u0438\u0434\u0435\u0438. \u0412\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u0435
    \u0438\u0437 \u043D\u0438\u0445 \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043D\u044B
    \u043D\u0430 \u0440\u0443\u0441\u0441\u043A\u0438\u0439 \u044F\u0437\u044B\u043A
    :  *   **\xAB\u041A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0430,
    \u0438\u043B\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0438 \u0441\u0432\u044F\u0437\u044C \u0432 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u043C
    \u0438 \u043C\u0430\u0448\u0438\u043D\u0435\xBB (1948)** \u2014 \u043E\u0441\u043D\u043E\u0432\u043E\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0449\u0438\u0439
    \u0442\u0440\u0443\u0434. *   **\xAB\u041A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0430
    \u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E\xBB (1950)** \u2014 \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F
    \u043E \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F\u0445
    \u043D\u043E\u0432\u043E\u0439 \u043D\u0430\u0443\u043A\u0438, \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0443\u0447\u0435\u043D\u043E\u0433\u043E \u0438 \u044D\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\u0445. *   **\xAB\u0411\u044B\u0432\u0448\u0438\u0439
    \u0432\u0443\u043D\u0434\u0435\u0440\u043A\u0438\u043D\u0434\xBB (1953)** \u0438
    **\xAB\u042F \u2014 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\xBB
    (1956)** \u2014 \u0430\u0432\u0442\u043E\u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u043D\u0438\u0433\u0438, \u0434\u0430\u044E\u0449\u0438\u0435 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0435
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043E \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438
    \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u0438 \u043D\u0430\u0443\u0447\u043D\u044B\u0445
    \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u0432. *   **\xAB\u0422\u0432\u043E\u0440\u0435\u0446
    \u0438 \u0440\u043E\u0431\u043E\u0442\xBB (1964)** \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430, \u0433\u0434\u0435 \u043E\u043D \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442
    \u044D\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438 \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u044B\u0435
    \u0430\u0441\u043F\u0435\u043A\u0442\u044B \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0441 \u043C\u044B\u0441\u043B\u044F\u0449\u0438\u043C\u0438
    \u043C\u0430\u0448\u0438\u043D\u0430\u043C\u0438.  \u0412\u0438\u043D\u0435\u0440
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0437\u0434\u0430\u043B
    \u043D\u043E\u0432\u0443\u044E \u043D\u0430\u0443\u043A\u0443; \u043E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u043D\u043E\u0432\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434 \u043D\u0430
    \u043C\u0438\u0440, \u0433\u0434\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438 \u0441\u0432\u044F\u0437\u044C
    \u0441\u0442\u0430\u043B\u0438 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043F\u043E\u043D\u044F\u0442\u0438\u044F\u043C\u0438 \u0434\u043B\u044F \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F
    \u043F\u0440\u0438\u0440\u043E\u0434\u044B, \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u0438 \u0441\u0430\u043C\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
  achievementsEn: 
  personalLifeRu: "\u0412\u043E\u0442 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u0439
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437 \u043E \u043B\u0438\u0447\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438 \u041D\u043E\u0440\u0431\u0435\u0440\u0442\u0430
    \u0412\u0438\u043D\u0435\u0440\u0430, \u0435\u0433\u043E \u043F\u0443\u0442\u0438
    \u0432 \u043D\u0430\u0443\u043A\u0435, \u0432\u0437\u0430\u0438\u043C\u043E\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u0445
    \u0441 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445
    \u0435\u0433\u043E \u0443\u0445\u043E\u0434\u0430 \u0438\u0437 \u0436\u0438\u0437\u043D\u0438. 
    ### \U0001F476 \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0438 \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u043E\u0435
    \u0434\u0435\u0442\u0441\u0442\u0432\u043E  \u041D\u043E\u0440\u0431\u0435\u0440\u0442
    \u0412\u0438\u043D\u0435\u0440 \u0440\u043E\u0434\u0438\u043B\u0441\u044F 26
    \u043D\u043E\u044F\u0431\u0440\u044F 1894 \u0433\u043E\u0434\u0430 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
    \u041A\u043E\u043B\u0443\u043C\u0431\u0438\u044F, \u0448\u0442\u0430\u0442 \u041C\u0438\u0441\u0441\u0443\u0440\u0438,
    \u0432 \u0441\u0435\u043C\u044C\u0435 \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0438\u0445
    \u0438\u043C\u043C\u0438\u0433\u0440\u0430\u043D\u0442\u043E\u0432. \u0415\u0433\u043E
    \u043E\u0442\u0435\u0446, \u041B\u0435\u043E \u0412\u0438\u043D\u0435\u0440,
    \u0431\u044B\u043B \u0432\u044B\u0445\u043E\u0434\u0446\u0435\u043C \u0438\u0437
    \u0411\u0435\u043B\u043E\u0441\u0442\u043E\u043A\u0430 (\u0442\u043E\u0433\u0434\u0430
    \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0430\u044F \u0438\u043C\u043F\u0435\u0440\u0438\u044F),
    \u0441\u0442\u0430\u0432\u0448\u0438\u043C \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u0441\u043B\u0430\u0432\u044F\u043D\u0441\u043A\u0438\u0445
    \u044F\u0437\u044B\u043A\u043E\u0432 \u0438 \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044B
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u041C\u0430\u0442\u044C, \u0411\u0435\u0440\u0442\u0430 \u041A\u0430\u043D,
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430 \u0438\u0437
    \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0439 \u0441\u0435\u043C\u044C\u0438.
    \u041F\u043E \u0441\u0435\u043C\u0435\u0439\u043D\u043E\u0439 \u043B\u0435\u0433\u0435\u043D\u0434\u0435,
    \u0412\u0438\u043D\u0435\u0440\u044B \u0432\u0435\u043B\u0438 \u0441\u0432\u043E\u0435
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u043E\u0442 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0433\u043E
    \u0441\u0440\u0435\u0434\u043D\u0435\u0432\u0435\u043A\u043E\u0432\u043E\u0433\u043E
    \u0443\u0447\u0435\u043D\u043E\u0433\u043E \u041C\u043E\u0438\u0441\u0435\u044F
    \u041C\u0430\u0439\u043C\u043E\u043D\u0438\u0434\u0430.  \u041E\u0442\u0435\u0446
    \u0441 \u0440\u0430\u043D\u043D\u0438\u0445 \u043B\u0435\u0442 \u0432\u0437\u044F\u043B
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0441\u044B\u043D\u0430
    \u0432 \u0441\u0432\u043E\u0438 \u0440\u0443\u043A\u0438, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
    \u0441\u0442\u0440\u043E\u0433\u0443\u044E, \u0430 \u043F\u043E\u0440\u043E\u0439
    \u0438 \u0434\u0435\u0441\u043F\u043E\u0442\u0438\u0447\u043D\u0443\u044E \u043C\u0435\u0442\u043E\u0434\u0438\u043A\u0443,
    \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0432\u0448\u0443\u044E \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u044B\u0445
    \u043E\u0442\u0432\u0435\u0442\u043E\u0432. \u0412 \u0441\u0432\u043E\u0435\u0439
    \u0430\u0432\u0442\u043E\u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438
    \u041D\u043E\u0440\u0431\u0435\u0440\u0442 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B,
    \u0447\u0442\u043E \u043E\u0442\u0435\u0446 \u0442\u0435\u0440\u044F\u043B \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435
    \u043F\u0440\u0438 \u043B\u044E\u0431\u043E\u0439 \u043E\u0448\u0438\u0431\u043A\u0435.
    \u041E\u0434\u043D\u0430\u043A\u043E \u044D\u0442\u043E\u0442 \"\u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0439
    \u0442\u0435\u0440\u0440\u043E\u0440\" \u0434\u0430\u043B \u0441\u0432\u043E\u0438
    \u043F\u043B\u043E\u0434\u044B:  *   \u0412 **4 \u0433\u043E\u0434\u0430** \u043E\u043D
    \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F \u0447\u0438\u0442\u0430\u0442\u044C
    \u0438 \u0431\u044B\u043B \u0434\u043E\u043F\u0443\u0449\u0435\u043D \u043A \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
    \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435. *   \u0412 **7
    \u043B\u0435\u0442** \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u0441\u0432\u043E\u0439
    \u043F\u0435\u0440\u0432\u044B\u0439 \u043D\u0430\u0443\u0447\u043D\u044B\u0439
    \u0442\u0440\u0430\u043A\u0442\u0430\u0442 \u043F\u043E \u0434\u0430\u0440\u0432\u0438\u043D\u0438\u0437\u043C\u0443.
    *   \u0412 **11 \u043B\u0435\u0442** \u043E\u043A\u043E\u043D\u0447\u0438\u043B
    \u0441\u0440\u0435\u0434\u043D\u044E\u044E \u0448\u043A\u043E\u043B\u0443 \u0438
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u044B\u0439
    \u0422\u0430\u0444\u0442\u0441-\u043A\u043E\u043B\u043B\u0435\u0434\u0436.  \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
    \u0434\u0435\u0442\u0441\u0442\u0432\u043E \u0412\u0438\u043D\u0435\u0440\u0430
    \u0431\u044B\u043B\u043E \u043E\u043C\u0440\u0430\u0447\u0435\u043D\u043E \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E\u043C.
    \u0418\u0437-\u0437\u0430 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439 \u0440\u0430\u0437\u043D\u0438\u0446\u044B
    \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 \u0441\u043E \u0441\u0432\u0435\u0440\u0441\u0442\u043D\u0438\u043A\u0430\u043C\u0438
    \u0438 \u0441\u0438\u043B\u044C\u043D\u043E\u0439 \u0431\u043B\u0438\u0437\u043E\u0440\u0443\u043A\u043E\u0441\u0442\u0438,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0434\u0435\u043B\u0430\u043B\u0430
    \u0435\u0433\u043E \u043D\u0435\u0443\u043A\u043B\u044E\u0436\u0438\u043C, \u043E\u043D
    \u0440\u043E\u0441 \u043D\u0435\u0443\u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u043C
    \u0438 \u043F\u043E\u0434\u0432\u0435\u0440\u0436\u0435\u043D\u043D\u044B\u043C
    \u0434\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u044F\u043C \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C. 
    ### \U0001F393 \u041F\u0443\u0442\u044C \u0432 \u043D\u0430\u0443\u043A\u0443:
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u044B \u0438
    \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0438  \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u0430\u0440\u044C\u0435\u0440\u0430 \u0412\u0438\u043D\u0435\u0440\u0430
    \u0431\u044B\u043B\u0430 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0438 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435\u0439. \u0412 **14 \u043B\u0435\u0442**
    (1909) \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0442\u0435\u043F\u0435\u043D\u044C
    \u0431\u0430\u043A\u0430\u043B\u0430\u0432\u0440\u0430 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432
    \u0432 \u0422\u0430\u0444\u0442\u0441-\u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435.
    \u0417\u0430\u0442\u0435\u043C \u043E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434, \u0433\u0434\u0435 \u0432
    **17 \u043B\u0435\u0442** \u0441\u0442\u0430\u043B \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u043E\u043C
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432, \u0430 \u0432 **18 \u043B\u0435\u0442**
    (1913) \u2014 \u0434\u043E\u043A\u0442\u043E\u0440\u043E\u043C \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438
    \u043F\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \"\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043B\u043E\u0433\u0438\u043A\u0430\". \u0412 \u0441\u0432\u043E\u0435\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u043E\u043D
    \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0442\u044C \u0443\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u0435\u043D\u043D\u0443\u044E
    \u043F\u0430\u0440\u0443 \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u043E\u0440\u0438\u044E
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432 \u2014 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0443\u044E
    \u0438\u0434\u0435\u044E, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u043E\u0437\u0436\u0435
    \u0443\u043F\u0440\u043E\u0441\u0442\u0438\u043B \u041A\u0443\u0440\u0430\u0442\u043E\u0432\u0441\u043A\u0438\u0439. 
    \u041F\u043E\u043B\u0443\u0447\u0438\u0432 \u0441\u0442\u0438\u043F\u0435\u043D\u0434\u0438\u044E,
    \u0412\u0438\u043D\u0435\u0440 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
    \u0432 \u0415\u0432\u0440\u043E\u043F\u0443, \u0447\u0442\u043E\u0431\u044B \u0443\u0447\u0438\u0442\u044C\u0441\u044F
    \u0443 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0443\u043C\u043E\u0432
    \u0442\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 : *   \u0412
    **\u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (\u0410\u043D\u0433\u043B\u0438\u044F)** \u043E\u043D \u0441\u043B\u0443\u0448\u0430\u043B
    \u043B\u0435\u043A\u0446\u0438\u0438 **\u0411\u0435\u0440\u0442\u0440\u0430\u043D\u0430
    \u0420\u0430\u0441\u0441\u0435\u043B\u0430** \u0438 **\u0413. \u0425. \u0425\u0430\u0440\u0434\u0438**.
    \u0420\u0430\u0441\u0441\u0435\u043B \u0432\u043D\u0443\u0448\u0438\u043B \u0435\u043C\u0443
    \u043C\u044B\u0441\u043B\u044C, \u0447\u0442\u043E \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044F
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u043D\u0435\u043C\u044B\u0441\u043B\u0438\u043C\u0430
    \u0431\u0435\u0437 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0433\u043E \u0437\u043D\u0430\u043D\u0438\u044F
    \u0441\u0430\u043C\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.
    *   \u0412 **\u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (\u0413\u0435\u0440\u043C\u0430\u043D\u0438\u044F)**
    \u043E\u043D \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F \u0443 **\u0414\u0430\u0432\u0438\u0434\u0430
    \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430** \u0438 \u0441\u043B\u0443\u0448\u0430\u043B
    \u043B\u0435\u043A\u0446\u0438\u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0430
    **\u042D\u0434\u043C\u0443\u043D\u0434\u0430 \u0413\u0443\u0441\u0441\u0435\u0440\u043B\u044F**. 
    ### \u2694\uFE0F \u0420\u0430\u0431\u043E\u0442\u0430 \u0438 \u0442\u0435\u0440\u043D\u0438\u0441\u0442\u044B\u0439
    \u043F\u0443\u0442\u044C \u0432 MIT  \u0421 \u043D\u0430\u0447\u0430\u043B\u043E\u043C
    \u041F\u0435\u0440\u0432\u043E\u0439 \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0412\u0438\u043D\u0435\u0440 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0432 \u0421\u0428\u0410. \u0418\u0437-\u0437\u0430 \u043F\u043B\u043E\u0445\u043E\u0433\u043E
    \u0437\u0440\u0435\u043D\u0438\u044F \u0435\u0433\u043E \u043D\u0435 \u0432\u0437\u044F\u043B\u0438
    \u0432 \u0430\u0440\u043C\u0438\u044E, \u0438 \u043E\u043D \u043F\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u043B\u0441\u044F
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u043C\u0438 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043A\u0430\u043C\u0438:
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0436\u0443\u0440\u043D\u0430\u043B\u0438\u0441\u0442\u043E\u043C,
    \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0435
    General Electric, \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0430\u0440\u0442\u0438\u043B\u043B\u0435\u0440\u0438\u0439\u0441\u043A\u0438\u0445
    \u0442\u0430\u0431\u043B\u0438\u0446 \u043D\u0430 \u043F\u043E\u043B\u0438\u0433\u043E\u043D\u0435.
    \u041B\u0438\u0448\u044C \u0432 **1919 \u0433\u043E\u0434\u0443**, \u043F\u043E
    \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0438 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430
    \u0424.\u0412. \u041E\u0441\u0433\u0443\u0434\u0430, \u043E\u043D \u0431\u044B\u043B
    \u043F\u0440\u0438\u043D\u044F\u0442 \u043D\u0430 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u0432 **\u041C\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441\u043A\u0438\u0439
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442 (MIT)**. \u0412 \u044D\u0442\u043E\u043C
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0442\u043E\u0433\u0434\u0430 \u0431\u044B\u043B \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u043C
    \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u044B\u043C \u0443\u0447\u0438\u043B\u0438\u0449\u0435\u043C,
    \u0412\u0438\u043D\u0435\u0440 \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0432\u0441\u044E \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C. 
    ### \U0001F496 \u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C
    \u0438 \u0431\u0440\u0430\u043A  \u0412 **1926 \u0433\u043E\u0434\u0443** \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C
    \u0441\u0432\u0430\u0434\u044C\u0431\u0430 \u041D\u043E\u0440\u0431\u0435\u0440\u0442\u0430
    \u0412\u0438\u043D\u0435\u0440\u0430 \u0438 **\u041C\u0430\u0440\u0433\u0430\u0440\u0435\u0442
    \u042D\u043D\u0433\u0435\u043C\u0430\u043D\u043D** (\u0438\u043D\u043E\u0433\u0434\u0430
    \u0444\u0430\u043C\u0438\u043B\u0438\u044F \u043F\u0438\u0448\u0435\u0442\u0441\u044F
    \u043A\u0430\u043A \u042D\u043D\u0434\u0435\u043C\u0430\u043D) \u2014 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u043A\u0438
    \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F.
    \u041F\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0434\u0430\u043D\u043D\u044B\u043C,
    \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E \u0438 \u0441\u0432\u0430\u0442\u043E\u0432\u0441\u0442\u0432\u043E
    \u0431\u044B\u043B\u0438 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u044B \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C\u0438
    \u0412\u0438\u043D\u0435\u0440\u0430. \u0412 \u0431\u0440\u0430\u043A\u0435 \u0440\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u0434\u0432\u0435 \u0434\u043E\u0447\u0435\u0440\u0438: \u0411\u0430\u0440\u0431\u0430\u0440\u0430
    (\u0432 1927 \u0433\u043E\u0434\u0443) \u0438 \u0432\u0442\u043E\u0440\u0430\u044F
    \u0434\u043E\u0447\u044C, \u0438\u043C\u044F \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0440\u0435\u0436\u0435. 
    \u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C \u0412\u0438\u043D\u0435\u0440\u0430
    \u0431\u044B\u043B\u0430 \u0441\u043B\u043E\u0436\u043D\u043E\u0439. \u0412 \u0441\u0432\u043E\u0438\u0445
    \u043C\u0435\u043C\u0443\u0430\u0440\u0430\u0445 \u043E\u043D \u043D\u0435 \u0440\u0430\u0437
    \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u043B\u0441\u044F \u0432 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043D\u0435\u0432\u0440\u043E\u0437\u0430\u0445 \u0438 \u0438\u043F\u043E\u0445\u043E\u043D\u0434\u0440\u0438\u0438.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0442 \u0434\u0430\u043D\u043D\u044B\u0435,
    \u0447\u0442\u043E \u0435\u0433\u043E \u0436\u0435\u043D\u0430 \u041C\u0430\u0440\u0433\u0430\u0440\u0435\u0442,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442 \u043A\u0430\u043A \u0436\u0435\u043D\u0449\u0438\u043D\u0443
    \u0441 \u0442\u044F\u0436\u0435\u043B\u044B\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C,
    \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430 \u043D\u0430 \u043D\u0435\u0433\u043E
    \u0441\u0438\u043B\u044C\u043D\u043E\u0435 \u0432\u043B\u0438\u044F\u043D\u0438\u0435,
    \u0447\u0442\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u043B\u043E
    \u043A \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430\u043C \u0441 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438.
    \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u044D\u0442\u043E,
    \u0441\u0430\u043C \u0412\u0438\u043D\u0435\u0440 \u043E\u0442\u0437\u044B\u0432\u0430\u043B\u0441\u044F
    \u043E \u043D\u0435\u0439 \u043A\u0430\u043A \u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u043C\u043E\u0433 \u0435\u043C\u0443
    \u043E\u0431\u0440\u0435\u0441\u0442\u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0432 \u0441\u0435\u0431\u0435.  ### \U0001F91D \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0443\u0447\u0435\u043D\u044B\u043C\u0438 
    \u0412\u0438\u043D\u0435\u0440 \u0431\u044B\u043B \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
    \u043E\u0431\u0449\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B
    \u0441\u0432\u044F\u0437\u0438 \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043C\u0438
    \u0443\u0447\u0435\u043D\u044B\u043C\u0438 \u043C\u0438\u0440\u0430. \u0421\u0440\u0435\u0434\u0438
    \u0435\u0433\u043E \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u0439 \u0438 \u043A\u043E\u043B\u043B\u0435\u0433
    \u0431\u044B\u043B\u0438 **\u0411\u0435\u0440\u0442\u0440\u0430\u043D \u0420\u0430\u0441\u0441\u0435\u043B,
    \u0414\u0430\u0432\u0438\u0434 \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442,
    \u0414\u0436\u043E\u043D \u0444\u043E\u043D \u041D\u0435\u0439\u043C\u0430\u043D,
    \u041A\u043B\u043E\u0434 \u0428\u0435\u043D\u043D\u043E\u043D, \u041C\u0430\u043A\u0441
    \u0411\u043E\u0440\u043D** \u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435. 
    \u041E\u0434\u043D\u0430\u043A\u043E \u0431\u044B\u043B\u0438 \u0438 \u0441\u043B\u043E\u0436\u043D\u044B\u0435
    \u044D\u043F\u0438\u0437\u043E\u0434\u044B: 1.  **\u041A\u043E\u043D\u0444\u043B\u0438\u043A\u0442
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0435:** \u0412\u0438\u043D\u0435\u0440
    \u0441\u0447\u0438\u0442\u0430\u043B, \u0447\u0442\u043E \u043D\u0435 \u0441\u043C\u043E\u0433
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0443\u044E
    \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0435
    \u0438\u0437-\u0437\u0430 \u0430\u043D\u0442\u0438\u0441\u0435\u043C\u0438\u0442\u0438\u0437\u043C\u0430,
    \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u0438\u0437-\u0437\u0430
    \u043D\u0435\u043F\u0440\u0438\u044F\u0437\u043D\u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u0414\u0436. \u0414. \u0411\u0438\u0440\u043A\u0433\u043E\u0444\u0430. 2.  **\u0421\u0441\u043E\u0440\u0430
    \u0441 \u0433\u0440\u0443\u043F\u043F\u043E\u0439 \u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439:** \u041F\u043E\u0441\u043B\u0435
    \u0432\u043E\u0439\u043D\u044B \u0412\u0438\u043D\u0435\u0440 \u043F\u043E\u043C\u043E\u0433
    \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0432
    MIT \u0441\u0438\u043B\u044C\u043D\u0443\u044E \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0443\u044E
    \u0433\u0440\u0443\u043F\u043F\u0443 \u043F\u043E \u043D\u0435\u0439\u0440\u043E\u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0438.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0432\u0441\u043A\u043E\u0440\u0435 \u043E\u043D
    \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u043F\u043E\u0440\u0432\u0430\u043B
    \u0432\u0441\u0435 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u044B \u0441 \u0435\u0435
    \u0447\u043B\u0435\u043D\u0430\u043C\u0438, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0441 \u0423\u043E\u0440\u0440\u0435\u043D\u043E\u043C \u041C\u0430\u043A-\u041A\u0430\u043B\u043B\u043E\u043A\u043E\u043C.
    \u041F\u043E \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439,
    \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u043E\u0440\u043E\u043C \u0440\u0430\u0437\u0440\u044B\u0432\u0430
    \u0431\u044B\u043B\u0430 \u0435\u0433\u043E \u0436\u0435\u043D\u0430 \u041C\u0430\u0440\u0433\u0430\u0440\u0435\u0442,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F
    \u0431\u043E\u0433\u0435\u043C\u043D\u044B\u0439 \u043E\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043D\u0438 \u043A\u043E\u043B\u043B\u0435\u0433, \u0438 \u043E\u043D\u0430
    \u043E\u0431\u0432\u0438\u043D\u0438\u043B\u0430 \u0438\u0445 \u0432 \u0440\u0430\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438
    \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u0447\u0435\u0440\u0438.  ### \U0001F54A\uFE0F
    \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u0438 \u0441\u043C\u0435\u0440\u0442\u044C  \u0412 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0433\u043E\u0434\u044B \u0412\u0438\u043D\u0435\u0440 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0441\u044F
    \u0432 \u044F\u0440\u043E\u0433\u043E \u043F\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u0430
    \u0438 \u043A\u0440\u0438\u0442\u0438\u043A\u0430 \u043C\u0438\u043B\u0438\u0442\u0430\u0440\u0438\u0437\u0430\u0446\u0438\u0438
    \u043D\u0430\u0443\u043A\u0438. \u041E\u043D \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0441\u044F
    \u043E\u0442 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432,
    \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u044F \u0443\u0447\u0435\u043D\u044B\u0445
    \u043A \u044D\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438. 
    \u0412 1963 \u0433\u043E\u0434\u0443 \u043E\u043D \u0431\u044B\u043B \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D
    \u0432\u044B\u0441\u0448\u0435\u0439 \u043D\u0430\u0433\u0440\u0430\u0434\u044B
    \u0421\u0428\u0410 \u0434\u043B\u044F \u0443\u0447\u0435\u043D\u044B\u0445 \u2014
    **\u041D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u043C\u0435\u0434\u0430\u043B\u0438
    \u0437\u0430 \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0437\u0430\u0441\u043B\u0443\u0433\u0438**,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0435\u043C\u0443 \u0432\u0440\u0443\u0447\u0438\u043B
    \u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442 \u041B\u0438\u043D\u0434\u043E\u043D
    \u0414\u0436\u043E\u043D\u0441\u043E\u043D \u0432 \u044F\u043D\u0432\u0430\u0440\u0435
    1964 \u0433\u043E\u0434\u0430.  \u041D\u043E\u0440\u0431\u0435\u0440\u0442 \u0412\u0438\u043D\u0435\u0440
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F 18 \u043C\u0430\u0440\u0442\u0430
    1964 \u0433\u043E\u0434\u0430 \u0432 \u0421\u0442\u043E\u043A\u0433\u043E\u043B\u044C\u043C\u0435,
    \u0428\u0432\u0435\u0446\u0438\u044F, \u043E\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0433\u043E
    \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430 \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    69 \u043B\u0435\u0442.  \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u2014
    \u044D\u0442\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0433\u0435\u043D\u0438\u044F,
    \u0447\u044C\u0438 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u0432 \u043D\u0430\u0443\u043A\u0435 \u0448\u043B\u0438 \u0440\u0443\u043A\u0430
    \u043E\u0431 \u0440\u0443\u043A\u0443 \u0441 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C\u0438
    \u043B\u0438\u0447\u043D\u044B\u043C\u0438 \u0434\u0440\u0430\u043C\u0430\u043C\u0438
    \u0438 \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u044B\u043C\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u043C\u0438. \u0412\u0438\u043D\u0435\u0440
    \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0435\u0440\u0432\u044B\u043C
    \u043E\u0441\u043E\u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
    \u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0441\u0442\u043E\u043B\u044C \u0436\u0435 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F\u043C\u0438 \u0431\u044B\u0442\u0438\u044F,
    \u043A\u0430\u043A \u043C\u0430\u0442\u0435\u0440\u0438\u044F \u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u044F."
  personalLifeEn: 
  shortBioRu: "\u041D\u043E\u0440\u0431\u0435\u0440\u0442 \u0412\u0438\u043D\u0435\u0440
    \u2014 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A \u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444,
    \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C \u043A\u0438\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u043A\u0438.
    \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u2014 \u044D\u0442\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u0432\u0443\u043D\u0434\u0435\u0440\u043A\u0438\u043D\u0434\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0441\u0442\u0430\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445
    \u0432\u043B\u0438\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043C\u044B\u0441\u043B\u0438\u0442\u0435\u043B\u0435\u0439
    XX \u0432\u0435\u043A\u0430, \u0441\u043E\u0437\u0434\u0430\u0432 \u043D\u0430\u0443\u043A\u0443
    \u043D\u0430 \u0441\u0442\u044B\u043A\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438,
    \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0438 \u0438 \u0442\u0435\u0445\u043D\u0438\u043A\u0438. 
    ### \u0414\u0435\u0442\u0441\u0442\u0432\u043E \u0438 \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438  \u041D\u043E\u0440\u0431\u0435\u0440\u0442
    \u0412\u0438\u043D\u0435\u0440 \u0440\u043E\u0434\u0438\u043B\u0441\u044F 26
    \u043D\u043E\u044F\u0431\u0440\u044F 1894 \u0433\u043E\u0434\u0430 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
    \u041A\u043E\u043B\u0443\u043C\u0431\u0438\u044F, \u0448\u0442\u0430\u0442 \u041C\u0438\u0441\u0441\u0443\u0440\u0438,
    \u0432 \u0441\u0435\u043C\u044C\u0435 \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0438\u0445
    \u0438\u043C\u043C\u0438\u0433\u0440\u0430\u043D\u0442\u043E\u0432. \u0415\u0433\u043E
    \u043E\u0442\u0435\u0446, \u041B\u0435\u043E \u0412\u0438\u043D\u0435\u0440,
    \u0431\u044B\u043B \u0432\u044B\u0445\u043E\u0434\u0446\u0435\u043C \u0438\u0437
    \u0411\u0435\u043B\u043E\u0441\u0442\u043E\u043A\u0430 (\u0442\u043E\u0433\u0434\u0430
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438). \u041E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0432 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438,
    \u0430 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u0430
    \u0432 \u0421\u0428\u0410 \u0441\u0442\u0430\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    \u0441\u043B\u0430\u0432\u044F\u043D\u0441\u043A\u0438\u0445 \u044F\u0437\u044B\u043A\u043E\u0432
    \u0438 \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044B \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u041C\u0430\u0442\u044C,
    \u0411\u0435\u0440\u0442\u0430 \u041A\u0430\u043D, \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430
    \u0438\u0437 \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0439 \u0441\u0435\u043C\u044C\u0438. 
    \u041E\u0442\u0435\u0446 \u0441 \u0440\u0430\u043D\u043D\u0438\u0445 \u043B\u0435\u0442
    \u0432\u0437\u044F\u043B \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0441\u044B\u043D\u0430 \u0432 \u0441\u0432\u043E\u0438 \u0440\u0443\u043A\u0438,
    \u043E\u0431\u0443\u0447\u0430\u044F \u0435\u0433\u043E \u043F\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u043C\u0435\u0442\u043E\u0434\u0438\u043A\u0435. \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
    \u043D\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0441\u0435\u0431\u044F
    \u0436\u0434\u0430\u0442\u044C: *   \u0412 **4 \u0433\u043E\u0434\u0430** \u041D\u043E\u0440\u0431\u0435\u0440\u0442
    \u0431\u044B\u043B \u0434\u043E\u043F\u0443\u0449\u0435\u043D \u043A \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
    \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435. *   \u0412 **7
    \u043B\u0435\u0442** \u043E\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B
    \u0441\u0432\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u043D\u0430\u0443\u0447\u043D\u044B\u0439
    \u0442\u0440\u0430\u043A\u0442\u0430\u0442 \u043F\u043E \u0434\u0430\u0440\u0432\u0438\u043D\u0438\u0437\u043C\u0443.
    *   \u0412 **11 \u043B\u0435\u0442** \u043E\u043D \u043E\u043A\u043E\u043D\u0447\u0438\u043B
    \u0441\u0440\u0435\u0434\u043D\u044E\u044E \u0448\u043A\u043E\u043B\u0443 \u0438
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u044B\u0439
    \u0422\u0430\u0444\u0442\u0441-\u043A\u043E\u043B\u043B\u0435\u0434\u0436.  \u0422\u0430\u043A\u043E\u0435
    \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0438\u043C\u0435\u043B\u043E \u0441\u0432\u043E\u044E \u0446\u0435\u043D\u0443:
    \u0438\u0437-\u0437\u0430 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439 \u0440\u0430\u0437\u043D\u0438\u0446\u044B
    \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 \u0441\u043E \u0441\u0432\u0435\u0440\u0441\u0442\u043D\u0438\u043A\u0430\u043C\u0438
    \u0438 \u0432\u0440\u043E\u0436\u0434\u0435\u043D\u043D\u043E\u0439 \u0431\u043B\u0438\u0437\u043E\u0440\u0443\u043A\u043E\u0441\u0442\u0438
    \u0412\u0438\u043D\u0435\u0440 \u0440\u043E\u0441 \u043D\u0435\u0443\u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u043C
    \u0438 \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u043C \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C. 
    ### \u041F\u0443\u0442\u044C \u0432 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
    \u043D\u0430\u0443\u043A\u0443  \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u0430\u0440\u044C\u0435\u0440\u0430 \u0412\u0438\u043D\u0435\u0440\u0430
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043B\u0430\u0441\u044C \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E:
    *   \u0412 **14 \u043B\u0435\u0442** (1909) \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u0431\u0430\u043A\u0430\u043B\u0430\u0432\u0440\u0430
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432 \u0432 \u0422\u0430\u0444\u0442\u0441-\u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435.
    *   \u0412 **18 \u043B\u0435\u0442** (1913) \u043E\u043D \u0441\u0442\u0430\u043B
    \u0434\u043E\u043A\u0442\u043E\u0440\u043E\u043C \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438
    \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043A\u043E\u0433\u043E \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430,
    \u0437\u0430\u0449\u0438\u0442\u0438\u0432 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E
    \u043F\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043B\u043E\u0433\u0438\u043A\u0435. \u0412 \u0441\u0432\u043E\u0435\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u043E\u043D \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u0441\u043F\u043E\u0441\u043E\u0431 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0443\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u0435\u043D\u043D\u043E\u0439
    \u043F\u0430\u0440\u044B \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u043E\u0440\u0438\u044E
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432 \u2014 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0443\u044E
    \u0438\u0434\u0435\u044E \u0434\u043B\u044F \u0432\u0441\u0435\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.  \u041F\u043E\u043B\u0443\u0447\u0438\u0432
    \u0441\u0442\u0438\u043F\u0435\u043D\u0434\u0438\u044E, \u0412\u0438\u043D\u0435\u0440
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F \u0432 \u0415\u0432\u0440\u043E\u043F\u0443
    \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F. \u041E\u043D
    \u0441\u043B\u0443\u0448\u0430\u043B \u043B\u0435\u043A\u0446\u0438\u0438 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043C\u043E\u0432 \u0442\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438:
    *   \u0412 \u041A\u0435\u043C\u0431\u0440\u0438\u0434\u0436\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (\u0410\u043D\u0433\u043B\u0438\u044F)
    \u043E\u043D \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F \u0443 **\u0411\u0435\u0440\u0442\u0440\u0430\u043D\u0430
    \u0420\u0430\u0441\u0441\u0435\u043B\u0430** \u0438 **\u0413. \u0425. \u0425\u0430\u0440\u0434\u0438**.
    *   \u0412 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (\u0413\u0435\u0440\u043C\u0430\u043D\u0438\u044F)
    \u043E\u043D \u0443\u0447\u0438\u043B\u0441\u044F \u0443 **\u0414\u0430\u0432\u0438\u0434\u0430
    \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430** \u0438 \u0441\u043B\u0443\u0448\u0430\u043B
    \u043B\u0435\u043A\u0446\u0438\u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0430
    **\u042D\u0434\u043C\u0443\u043D\u0434\u0430 \u0413\u0443\u0441\u0441\u0435\u0440\u043B\u044F**. 
    \u0420\u0430\u0441\u0441\u0435\u043B, \u043F\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u044E
    \u0441\u0430\u043C\u043E\u0433\u043E \u0412\u0438\u043D\u0435\u0440\u0430, \u0432\u043D\u0443\u0448\u0438\u043B
    \u0435\u043C\u0443 \u0432\u0430\u0436\u043D\u0443\u044E \u043C\u044B\u0441\u043B\u044C:
    \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0435\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438,
    \u043D\u0443\u0436\u043D\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0437\u043D\u0430\u0442\u044C
    \u0441\u0430\u043C\u0443 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443. 
    ### \u041D\u0435\u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0432\u044B\u0431\u043E\u0440
    \u0438 \u0440\u0430\u0431\u043E\u0442\u0430 \u0432 MIT  \u0421 \u043D\u0430\u0447\u0430\u043B\u043E\u043C
    \u041F\u0435\u0440\u0432\u043E\u0439 \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0412\u0438\u043D\u0435\u0440 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0432 \u0421\u0428\u0410. \u0415\u0433\u043E \u043F\u043E\u043F\u044B\u0442\u043A\u0438
    \u043F\u043E\u0439\u0442\u0438 \u043D\u0430 \u0444\u0440\u043E\u043D\u0442 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C
    \u0438\u0437-\u0437\u0430 \u043F\u043B\u043E\u0445\u043E\u0433\u043E \u0437\u0440\u0435\u043D\u0438\u044F.
    \u041D\u0430\u0447\u0430\u043B\u0441\u044F \u043F\u0435\u0440\u0438\u043E\u0434
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u043C\u0435\u0442\u0430\u043D\u0438\u0439: \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0436\u0443\u0440\u043D\u0430\u043B\u0438\u0441\u0442\u043E\u043C, \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C
    \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0435 General Electric, \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C,
    \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u0430\u0440\u0442\u0438\u043B\u043B\u0435\u0440\u0438\u0439\u0441\u043A\u0438\u0445
    \u0442\u0430\u0431\u043B\u0438\u0446 \u0434\u043B\u044F \u0430\u0440\u043C\u0438\u0438
    \u0421\u0428\u0410.  \u041D\u0430\u043A\u043E\u043D\u0435\u0446, \u0432 **1919
    \u0433\u043E\u0434\u0443**, \u043F\u043E \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0438
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430 \u0424.\u0412. \u041E\u0441\u0433\u0443\u0434\u0430,
    \u043E\u043D \u0431\u044B\u043B \u043F\u0440\u0438\u043D\u044F\u0442 \u043D\u0430
    \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u0432 **\u041C\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441\u043A\u0438\u0439
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442 (MIT)**. \u0412 \u044D\u0442\u043E\u043C
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435, \u0431\u044B\u0432\u0448\u0435\u043C
    \u0442\u043E\u0433\u0434\u0430 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u043C
    \u0443\u0447\u0435\u0431\u043D\u044B\u043C \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C,
    \u0412\u0438\u043D\u0435\u0440 \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0432\u0441\u044E \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C, \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432\u0448\u0438\u0441\u044C
    \u0432 \u0435\u0433\u043E \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C. 
    ### \u0421\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0443\u0447\u0435\u043D\u043E\u0433\u043E
    \u0438 \u043B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C  \u0412
    1920-1930-\u0435 \u0433\u043E\u0434\u044B \u0412\u0438\u043D\u0435\u0440 \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0439,
    \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0432 \u0440\u044F\u0434 \u0432\u0430\u0436\u043D\u044B\u0445
    \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0439 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438:
    *   **\u0422\u0435\u043E\u0440\u0438\u0438 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u0430**
    \u0438 **\u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430**. *   **\u0411\u0440\u043E\u0443\u043D\u043E\u0432\u0441\u043A\u043E\u0433\u043E
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F** (\u0432\u0432\u0435\u043B
    \u043F\u043E\u043D\u044F\u0442\u0438\u0435 \xAB\u0432\u0438\u043D\u0435\u0440\u043E\u0432\u0441\u043A\u043E\u0439
    \u043C\u0435\u0440\u044B\xBB). *   **\u0422\u0435\u043E\u0440\u0438\u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432**.  \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E
    \u0441 \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C
    \u042D. \u0425\u043E\u043F\u0444\u043E\u043C \u043E\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0435 **\u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435
    \u0412\u0438\u043D\u0435\u0440\u0430-\u0425\u043E\u043F\u0444\u0430**. \u0412
    \u044D\u0442\u0438 \u0433\u043E\u0434\u044B \u043E\u043D \u043C\u043D\u043E\u0433\u043E
    \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u043E
    \u0415\u0432\u0440\u043E\u043F\u0435 \u0438 \u0432 1935 \u0433\u043E\u0434\u0443
    \u0447\u0438\u0442\u0430\u0435\u0442 \u043B\u0435\u043A\u0446\u0438\u0438 \u0432
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0426\u0438\u043D\u0445\u0443\u0430
    \u0432 \u041A\u0438\u0442\u0430\u0435, \u0447\u0442\u043E \u0441\u0442\u0430\u043B\u043E
    \u0432\u0430\u0436\u043D\u044B\u043C \u0440\u0443\u0431\u0435\u0436\u043E\u043C
    \u0432 \u0435\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u043E\u0439 \u0437\u0440\u0435\u043B\u043E\u0441\u0442\u0438. 
    \u0412 **1926 \u0433\u043E\u0434\u0443** \u0412\u0438\u043D\u0435\u0440 \u0436\u0435\u043D\u0438\u043B\u0441\u044F
