    \u0432\u044b\u0432\u0435\u043b \u0435\u0433\u043e \"\u0442\u0440\u0435\u043c\u044f \u0440\u0430\u0437\u043d\u044b\u043c\u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438\".\n\n\U0001F4A1 \"\u0421\u043b\u044b\u0448\u0430\u0449\u0430\u044f
    \u043f\u0435\u0440\u0447\u0430\u0442\u043a\u0430\" \u0434\u043b\u044f \u0425\u0435\u043b\u0435\u043d
