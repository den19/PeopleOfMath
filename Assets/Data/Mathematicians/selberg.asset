    \u0441\u0443\u0434\u044c\u0431\u043e\u0439. \u0415\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430
    \u0441 \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439 XX \u0432\u0435\u043a\u0430 \u0438
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u043c\u0438.
    \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0445\u0440\u043e\u043d\u0438\u043a\u0430
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F476 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0421\u0435\u043c\u044c\u044f \u0410\u0442\u043b\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 14 \u0438\u044e\u043d\u044f 1917 \u0433\u043e\u0434\u0430
    \u0432 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435
    \u041b\u0430\u043d\u0433\u0435\u0441\u0443\u043d\u043d (Langesund). \u041e\u043d \u0431\u044b\u043b
    \u0441\u0430\u043c\u044b\u043c \u043c\u043b\u0430\u0434\u0448\u0438\u043c \u0438\u0437 \u0434\u0435\u0432\u044f\u0442\u0438
