    \u0421\u043a\u043e\u043b\u0435\u043c\u0430. \u041e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0432 1939 \u0433\u043e\u0434\u0443. \u041d\u0430\u0447\u0430\u043b\u043e \u0412\u0442\u043e\u0440\u043e\u0439
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b \u043d\u0430\u0440\u0443\u0448\u0438\u043b\u043e
    \u0435\u0433\u043e \u043f\u043b\u0430\u043d\u044b \u043f\u043e\u0435\u0445\u0430\u0442\u044c
    \u0432 \u0413\u0430\u043c\u0431\u0443\u0440\u0433 \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u0441 \u042d\u0440\u0438\u0445\u043e\u043c \u0413\u0435\u043a\u043a\u0435. \u0412\u043c\u0435\u0441\u0442\u043e
    \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0423\u043f\u043f\u0441\u0430\u043b\u0443 (\u0428\u0432\u0435\u0446\u0438\u044f),
    \u0433\u0434\u0435 \u0431\u044b\u043b\u0430 \u043b\u0443\u0447\u0448\u0430\u044f \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430,
    \u0438 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041e\u0441\u043b\u043e
    \u0432 \u0434\u0435\u043a\u0430\u0431\u0440\u0435 1939 \u0433\u043e\u0434\u0430. \u0412\u043e
    \u0432\u0440\u0435\u043c\u044f \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u0438
    \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438
    \u0421\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0440\u0430\u0437 \u0431\u044b\u043b \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d \u0432
    \u0442\u044e\u0440\u044c\u043c\u0443. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u044d\u0442\u043e, \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438.
    \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0442\u0435\u0445 \u043b\u0435\u0442 \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f, \u0447\u0442\u043e,
    \u043a\u043e\u0433\u0434\u0430 \u0434\u0430\u0442\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0425\u0430\u0440\u0430\u043b\u044c\u0434\u0430 \u0411\u043e\u0440\u0430 \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438,
    \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u043e \u0432
    \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0439\u043d\u044b, \u043e\u043d
    \u043a\u0440\u0430\u0442\u043a\u043e \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \"\u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\".
    \u0412 1943 \u0433\u043e\u0434\u0443, \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u041e\u0441\u043b\u043e \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438
    \u0432\u043b\u0430\u0441\u0442\u044f\u043c\u0438, \u043e\u043d \u0443\u0441\u043f\u0435\u0448\u043d\u043e
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e.\n\n\U0001F1FA\U0001F1F8
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0432 \u0421\u0428\u0410 \u0438 \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u041a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u041f\u043e\u0441\u043b\u0435
    \u0432\u043e\u0439\u043d\u044b, \u0432 1947 \u0433\u043e\u0434\u0443, \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410. \u0421\u043d\u0430\u0447\u0430\u043b\u0430
    \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043e\u0446\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u043d\u043e \u0443\u0436\u0435 \u0432 1949 \u0433\u043e\u0434\u0443 \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 (IAS) \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0431\u044b\u043b\u0430 \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u0432\u0441\u044f \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430. \u0412 1951 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0438 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0438\u043c \u0434\u043e \u0432\u044b\u0445\u043e\u0434\u0430 \u043d\u0430 \u043f\u0435\u043d\u0441\u0438\u044e
    \u0432 1987 \u0433\u043e\u0434\u0443. \u0412 1950 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0437\u0430 \u0441\u0432\u043e\u0435 \"\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0435\"
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441
    \u041f\u043e\u043b\u043e\u043c \u042d\u0440\u0434\u0451\u0448\u0435\u043c: \u042d\u0442\u043e
    \u043e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0438 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0445 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u0432 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0412
    1948 \u0433\u043e\u0434\u0443 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0438 \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u041f\u0430\u043b \u042d\u0440\u0434\u0451\u0448
    \u043f\u043e\u0447\u0442\u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e,
    \u043d\u043e \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e, \u043f\u0440\u0438\u0448\u043b\u0438
    \u043a \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u043c\u0443 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b. \u0412\u043e\u0437\u043d\u0438\u043a\u043b\u0430
    \u043e\u0441\u0442\u0440\u0430\u044f \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044f
    \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435. \u0421\u0442\u0430\u0442\u044c\u0438
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430 \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u043f\u0435\u0440\u0432\u044b\u043c\u0438, \u0438 \u043f\u0440\u0435\u043c\u0438\u044e
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043e\u043d \u043e\u0434\u0438\u043d, \u0447\u0442\u043e
    \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u043d\u0435\u0433\u043e\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u042d\u0440\u0434\u0451\u0448\u0430
    \u0438 \u0435\u0433\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u0432.
    \u041c\u043d\u043e\u0433\u0438\u0435 \u043f\u043e\u043b\u0430\u0433\u0430\u043b\u0438, \u0447\u0442\u043e
    \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c. \u041f\u043e \u0441\u043b\u043e\u0432\u0430\u043c
    \u043a\u043e\u043b\u043b\u0435\u0433, \u042d\u0440\u0434\u0451\u0448 \u0431\u044b\u043b
    \"\u043f\u0440\u0438\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c collaborator'\u043e\u043c\"
    (\u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c), \u0430 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u2014 \"\u043e\u0434\u0438\u043d\u043e\u0447\u043a\u043e\u0439\" (loner), \u0447\u0442\u043e
    \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \"\u043f\u0440\u043e\u0432\u0430\u043b\u0443
    \u0432 \u043a\u043e\u043c\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0438\" \u043c\u0435\u0436\u0434\u0443
    \u043d\u0438\u043c\u0438.\n\n\U0001F48D \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0438 \u0421\u043c\u0435\u0440\u0442\u044c \u0412 1947 \u0433\u043e\u0434\u0443 \u0410\u0442\u043b\u0435
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0425\u0435\u0434\u0432\u0438\u0433 \u041b\u0438\u0431\u0435\u0440\u043c\u0430\u043d\u043d,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u0430\u043a\u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u0423 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0434\u0432\u043e\u0435 \u0434\u0435\u0442\u0435\u0439:
    \u0434\u043e\u0447\u044c \u0418\u043d\u0433\u0440\u0438\u0434 \u0438 \u0441\u044b\u043d
    \u041b\u0430\u0440\u0441. \u0425\u0435\u0434\u0432\u0438\u0433 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 1995 \u0433\u043e\u0434\u0443. \u041f\u043e\u0437\u0436\u0435, \u0432 2003 \u0433\u043e\u0434\u0443,
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437 \u043d\u0430 \u0411\u0435\u0442\u0442\u0438
    \u041a\u043e\u043c\u043f\u0442\u043e\u043d \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433.
    \u0410\u0442\u043b\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    6 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2007 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0432\u043e\u0435\u043c
    \u0434\u043e\u043c\u0435 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 \u043e\u0442
    \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 90 \u043b\u0435\u0442. \u041d\u0430\u0434\u0435\u044e\u0441\u044c,
    \u044d\u0442\u043e\u0442 \u0440\u0430\u0441\u0441\u043a\u0430\u0437 \u043f\u043e\u043c\u043e\u0433
    \u0432\u0430\u043c \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0437\u0430 \u0432\u0435\u043b\u0438\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0436\u0438\u0432\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0441\u043e \u0441\u0432\u043e\u0435\u0439
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439.
    \u0415\u0441\u043b\u0438 \u0432\u0430\u0441 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442
    \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0438\u0437 \u044d\u0442\u0438\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435 \u2014 \u044f \u0433\u043e\u0442\u043e\u0432
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c."
  personalLifeEn: "Atle Selberg was not just a genius mathematician, but also a man with a very rich and complex destiny, and his personal history is intertwined with the history of the 20th century and its scientific discoveries. Here is a detailed account of his life.\n\n==Early life==The birth and family of Atle Selberg was born on 14 June 1917 in the Norwegian city of Langesund, where he was the youngest of nine children in the teacher's family, and his father, Ole Michael Ludwigsen Selberg, was a school teacher of mathematics and at the age of 48, was also a teacher.Mathematical abilities were a family feature: three of the brothers Atle — Henrik, Sigmund, and Arne — also became professors of mathematics.\n\nChildren and Youth: The journey to Mathematics Children Atle took place in several cities in Norway, where his father's family moved: Voss, Bergen, and since 1932, Yöwick. It is interesting that, contrary to expectations, the boy was taught math from his rich library, not from his father. His journey to great mathematics began early: At the age of seven, he himself observed that the difference between consecutive squares gave odd numbers.When he was 13 years old, he came across the Leibnic formula for the number pi (`Pi/4 = 1 - 1/3 + 1/5 - ...'). Later, he remembered that it was \"the strange and beautiful relationship\" that he had decided at any rate to understand how it worked. The turning point came at 17 when he read the collection of Indian mathematician Srinivasa Ramanujan.Inspired by Ramanujan, he wrote his first scientific article, \"On arithmetical identities\", which was published in 1936, and in 1935 Selberg graduated from school in Yowick and entered the University of Oslo.\n\nHe studied at the University from famous mathematicians, including Carl Størmer, whose lectures he had studied as a child, and Torstein Skolem, who received a master &apos; s degree in 1939. The beginning of World War II violated his plans to go to Hamburg to work with Erich Gecke. Instead, he went to Uppsala, Sweden, where he had the best library, and returned to Oslo in December 1939.During the German occupation of Norway, Selberg participated in the Resistance movement and was imprisoned several times, but he continued to work in isolation, and his scientific results over the years were so remarkable that when Danish mathematician Harald Bora was asked what was going on in European mathematics during the war, he briefly replied, \"Selberg\".In 1943, shortly before the closure of the University of Oslo by the occupation authorities, he successfully defended his doctoral thesis.\n\n==History==================================================================)==================================================================================================))=============================================================)))))))))))))))))))=====In 1950, he was awarded the Fields Prize for his \"elementary\" proof of the theorem about the distribution of prime numbers. Relations with Paul Erdös: This is one of the most famous and dramatic pages in his biography. In 1948, Selberg and Hungarian mathematician Pal Erdös almost simultaneously, but independently, came to the basic evidence of the theorem about the distribution of primes.Selberg's articles were first published, and he received one award, which caused anger by Erdös and his supporters. Many believed that the award should be shared. According to colleagues, Erdös was a \"born collaborator\" (co-author), and Selberg was a \"sole\" (noner), which led to a \"miss in communication\" between them.\n\nIn 1947, Atle Selberg married Hedwig Liebermann, who also worked at the Institute of Advanced Studies, and had two children: Ingrid's daughter and Lars' son. Hedwig died in 1995. Later, in 2003, Selberg married Betty Compton Selberg for the second time. Atle Selberg died on 6 August 2007 at his home in Princeton from heart failure at the age of 90.I hope this story has helped you to see the great mathematician of a living person with a unique story. If you're interested in one of these episodes in more detail, I'm ready to continue."
  shortBioRu: "\u0410\u0442\u043b\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 (1917\u20132007)
    \u2014 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    XX \u0432\u0435\u043a\u0430. \u041e\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u043a\u0430\u043a \u0430\u0432\u0442\u043e\u0440 \u00ab\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0433\u043e\u00bb
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0441\u043b\u0435\u0434\u0430 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430.\n\n\U0001F9EC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0410\u0442\u043b\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    14 \u0438\u044e\u043d\u044f 1917 \u0433\u043e\u0434\u0430 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c
    \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435
    \u041b\u0430\u043d\u0433\u0435\u0441\u0443\u043d\u043d (\u0422\u0435\u043b\u0435\u043c\u0430\u0440\u043a).
    \u041e\u043d \u0431\u044b\u043b \u0441\u0430\u043c\u044b\u043c \u043c\u043b\u0430\u0434\u0448\u0438\u043c
    \u0438\u0437 \u0434\u0435\u0432\u044f\u0442\u0438 \u0434\u0435\u0442\u0435\u0439 \u0432
    \u0441\u0435\u043c\u044c\u0435 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u0432 \u0410\u043d\u043d\u044b
    \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u044b \u0438 \u041e\u043b\u0435 \u041c\u0438\u0445\u0430\u044d\u043b\u044f
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u043e\u0432. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u0443 \u043d\u0435\u0433\u043e \u0440\u0430\u043d\u043e: \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u043e\u043a\u043e\u043b\u043e \u0441\u0435\u043c\u0438 \u043b\u0435\u0442 \u043e\u043d
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b
    \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c, \u0447\u0442\u043e
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c \u043c\u0435\u0436\u0434\u0443 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430\u043c\u0438 \u0434\u0430\u0435\u0442 \u043d\u0435\u0447\u0435\u0442\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430. \u0414\u0432\u043e\u0435 \u0435\u0433\u043e \u0431\u0440\u0430\u0442\u044c\u0435\u0432,
    \u0421\u0438\u0433\u043c\u0443\u043d\u0434 \u0438 \u0425\u0435\u043d\u0440\u0438\u043a,
    \u0442\u0430\u043a\u0436\u0435 \u0441\u0442\u0430\u043b\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0432 \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u0435
    \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b \u0432 1934 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430
    17-\u043b\u0435\u0442\u043d\u0438\u0439 \u0410\u0442\u043b\u0435 \u043d\u0430\u0448\u0435\u043b
    \u0443 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0431\u0440\u0430\u0442\u044c\u0435\u0432
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435 \u0442\u0440\u0443\u0434\u043e\u0432 \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0421\u0440\u0438\u043d\u0438\u0432\u0430\u0441\u044b
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0430 \u043d\u0430 \u044e\u043d\u043e\u0448\u0443
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435
    \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0445 \u0437\u0430\u043d\u044f\u0442\u0438\u0439.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0441\u0442\u0430\u0442\u044c\u044e \u00ab\u041e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0430\u0445\u00bb.
    \u0412\u0441\u043a\u043e\u0440\u0435 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041e\u0441\u043b\u043e.
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u043e\u0431\u043b\u0430\u0434\u0430\u043b
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439,
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0430\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e\u043d \u043d\u0430\u0448\u0435\u043b \u0442\u043e\u0447\u043d\u0443\u044e \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0434\u043b\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u044f (partition function), \u043d\u043e,
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432, \u0447\u0442\u043e \u0435\u0433\u043e
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b \u0413\u0430\u043d\u0441 \u0420\u0430\u0434\u0435\u043c\u0430\u0445\u0435\u0440,
    \u0440\u0435\u0448\u0438\u043b \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443, \u0445\u043e\u0442\u044f
    \u0435\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0431\u044b\u043b\u0438
    \u0431\u043e\u043b\u0435\u0435 \u0442\u043e\u0447\u043d\u044b\u043c\u0438.\n\n\U0001F4BB
    \u0412\u043e\u0435\u043d\u043d\u044b\u0435 \u0433\u043e\u0434\u044b \u0438 \u043f\u0440\u043e\u0440\u044b\u0432\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0412\u0442\u043e\u0440\u0430\u044f
    \u043c\u0438\u0440\u043e\u0432\u0430\u044f \u0432\u043e\u0439\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u043b\u0430
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430 \u0432 \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438.
    \u041e\u043d \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0438
    \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c\u0443 \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044e
    \u0438 \u0434\u0430\u0436\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437
    \u0431\u044b\u043b \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d \u0432 \u0442\u044e\u0440\u044c\u043c\u0443.
    \u041f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u0432\u043b\u0430\u0441\u0442\u0438 \u0437\u0430\u043a\u0440\u044b\u043b\u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u043e\u043d \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0432 \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u0432 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438
    \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u044f\u0436\u0435\u043b\u044b\u0435
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f, \u044d\u0442\u0438 \u0433\u043e\u0434\u044b
    \u0441\u0442\u0430\u043b\u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c\u0438. \u041e\u043d
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u043b\u0441\u044f \u043d\u0430
    \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0420\u0438\u043c\u0430\u043d\u0430
    \u0438 \u0432 1942 \u0433\u043e\u0434\u0443 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0434\u043e\u043b\u044f \u0432\u0441\u0435\u0445 \u0435\u0435 \u043d\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0443\u043b\u0435\u0439 \u043b\u0435\u0436\u0438\u0442 \u043d\u0430 \u0442\u0430\u043a
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u043e\u0439 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u0440\u044f\u043c\u043e\u0439 Re(s)=1/2. \u042d\u0442\u043e \u0431\u044b\u043b \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0412 1943 \u0433\u043e\u0434\u0443, \u0437\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u0434\u043e
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041e\u0441\u043b\u043e \u0431\u044b\u043b \u0437\u0430\u043a\u0440\u044b\u0442 \u043e\u043a\u043a\u0443\u043f\u0430\u043d\u0442\u0430\u043c\u0438,
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0443\u0441\u043f\u0435\u0448\u043d\u043e
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e. \u0415\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0432\u043e\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u0447\u0442\u043e \u0434\u0430\u0442\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0425\u0430\u0440\u0430\u043b\u044c\u0434 \u0411\u043e\u0440 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u043e
    \u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0439\u043d\u044b, \u043a\u0440\u0430\u0442\u043a\u043e
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u00bb.\n\n\U0001F33F
    \u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b: \u00ab\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0435\u00bb
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0438
    \u043f\u0440\u0435\u043c\u0438\u044f \u0424\u0438\u043b\u0434\u0441\u0430 \u041f\u043e\u0441\u043b\u0435
    \u0432\u043e\u0439\u043d\u044b \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0437\u0430\u043d\u044f\u043b\u0441\u044f
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0440\u0435\u0448\u0435\u0442 (sieve theory),
    \u0441\u043e\u0437\u0434\u0430\u0432 \u0432 1947 \u0433\u043e\u0434\u0443 \u043c\u043e\u0449\u043d\u044b\u0439
    \u00ab\u043c\u0435\u0442\u043e\u0434 \u0440\u0435\u0448\u0435\u0442\u0430 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430\u00bb
    (Selberg sieve), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0448\u0435\u043b
    \u0448\u0438\u0440\u043e\u043a\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u041a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b 1948 \u0433\u043e\u0434,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u00ab\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0435\u00bb \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b. \u042d\u0442\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445, \u0430 \u043d\u0435 \u043d\u0430 \u0441\u043b\u043e\u0436\u043d\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0435, \u043a\u0430\u043a \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u043e\u0441\u044c
    \u0440\u0430\u043d\u0435\u0435, \u0441\u0442\u0430\u043b\u043e \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u0435\u0439.
    \u041a \u044d\u0442\u043e\u043c\u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443
    \u043f\u043e\u0447\u0442\u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e,
    \u043d\u043e \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e, \u043f\u0440\u0438\u0448\u0435\u043b
    \u0438 \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041f\u0430\u043b \u042d\u0440\u0434\u0451\u0448, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0434\u043e\u043b\u0433\u043e\u0439 \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0438 \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435.
    \u0412 \u0438\u0442\u043e\u0433\u0435 \u0441\u0442\u0430\u0442\u044c\u0438 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430
    \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u043f\u0435\u0440\u0432\u044b\u043c\u0438. \u0417\u0430 \u044d\u0442\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432 1950 \u0433\u043e\u0434\u0443
    \u043d\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u043c
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 (\u0421\u0428\u0410) \u0410\u0442\u043b\u0435
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438,
    \u0441\u0430\u043c\u043e\u0439 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0434\u043b\u044f \u043c\u043e\u043b\u043e\u0434\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.\n\n\U0001F3DB\ufe0f
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u0441\u043b\u0435\u0434\u0430 \u0412
    1947 \u0433\u043e\u0434\u0443 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0421\u0428\u0410 \u043f\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e
    \u041a\u0430\u0440\u043b\u0430 \u041b\u044e\u0434\u0432\u0438\u0433\u0430 \u0417\u0438\u0433\u0435\u043b\u044f,
    \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IAS) \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435. \u041d\u0435\u0434\u043e\u043b\u0433\u043e
    \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u0432 \u0432 \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0432 1949 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d,
    \u0433\u0434\u0435 \u0432 1951 \u0433\u043e\u0434\u0443 \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u0412 \u044d\u0442\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0441\u0432\u043e\u0435\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b, \u0441\u0442\u0430\u0432 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    emeritus \u0432 1987 \u0433\u043e\u0434\u0443. \u0412 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0435\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0441\u043c\u0435\u0441\u0442\u0438\u043b\u043e\u0441\u044c \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438. \u0412 1956 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e
    \u0441\u0430\u043c\u0443\u044e \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u0443\u044e,
    \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e \u043a\u043e\u043b\u043b\u0435\u0433,
    \u0440\u0430\u0431\u043e\u0442\u0443, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0443\u044e
    \u00ab\u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0441\u043b\u0435\u0434\u0430 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430\u00bb
    (Selberg Trace Formula). \u042d\u0442\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0430
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443
    \u0434\u043b\u0438\u043d\u0430\u043c\u0438 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0445
    \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u043c\u0438
    \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u041b\u0430\u043f\u043b\u0430\u0441\u0430,
    \u0447\u0442\u043e \u043d\u0430\u0448\u043b\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445
    \u2014 \u043e\u0442 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b
    \u0434\u043e \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438.
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0438 \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438 \u0434\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438.
    \u041e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0434\u0440\u0443\u0433\u0438\u0445 \u043d\u0430\u0433\u0440\u0430\u0434, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u041f\u0440\u0435\u043c\u0438\u044e \u0412\u043e\u043b\u044c\u0444\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0432 1986 \u0433\u043e\u0434\u0443 \u0438 \u043f\u043e\u0447\u0435\u0442\u043d\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e \u0410\u0431\u0435\u043b\u044f \u0432 2002 \u0433\u043e\u0434\u0443
    \u2014 \u0432 \u0433\u043e\u0434 \u0435\u0435 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f.
    \u0415\u0433\u043e \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b
    \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u0432 \u0434\u0432\u0443\u0445 \u0442\u043e\u043c\u0430\u0445.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0412 1947 \u0433\u043e\u0434\u0443
    \u0410\u0442\u043b\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0425\u0435\u0434\u0432\u0438\u0433 \u041b\u0438\u0431\u0435\u0440\u043c\u0430\u043d\u043d,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u0430\u043a\u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u0423 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0434\u0432\u043e\u0435 \u0434\u0435\u0442\u0435\u0439
    \u2014 \u0434\u043e\u0447\u044c \u0418\u043d\u0433\u0440\u0438\u0434 \u0438 \u0441\u044b\u043d
    \u041b\u0430\u0440\u0441. \u0425\u0435\u0434\u0432\u0438\u0433 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 1995 \u0433\u043e\u0434\u0443. \u0412 2003 \u0433\u043e\u0434\u0443 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439
    \u0440\u0430\u0437, \u043d\u0430 \u0411\u0435\u0442\u0442\u0438 \u041a\u043e\u043c\u043f\u0442\u043e\u043d
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433. \u0410\u0442\u043b\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438
    6 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2007 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0432\u043e\u0435\u043c
    \u0434\u043e\u043c\u0435 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 90 \u043b\u0435\u0442."
  shortBioEn: "Atle Selberg (1917–2007) is a Norwegian mathematician whose work in the field of numeral analysis and automorphic shape theory left a deep mark in the mathematics of the 20th century, known as the author of the \"Elementary\" theorem of theorem of the distribution of primes and the creator of the Selberg trace formula.\n\n==Early life==He was born on 14 June 1917 in the small Norwegian town of Langesunne (Telemark), the youngest of nine children in the family of teachers Anna Cristina and Ole Michael Selberg, and his mathematical abilities were early: at the age of seven, he himself noticed the pattern that the difference between the consecutive squares gave odd numbers.His two brothers, Sigmund and Henrik, also became professors of mathematics, and his fate was broken in 1934, when 17-year-old Atle found from one of his brothers a collection of works by Indian mathematician Srinivas Ramanujan, which impressed the young man and set the course for his further studies.He soon entered the University of Oslo, and Selberg had an amazing intuition, pre-empting some of the results; for example, he found a precise analytical formula for the break-up function (partition function), but when he found that he had been ahead of him, Hans Rademacher decided not to publish his work, although the results were more accurate.\n\nThe Second World War caught Selberg in Norway, and he resisted the German invasion and was imprisoned several times, and after the occupation authorities closed the university, he stayed in Norway, working in isolation and continuing his research, and despite the difficult circumstances, these years became incredibly productive.He focused on the reman's dset function and in 1942 proved that the positive part of all its netrival zeros lay on the so-called critical straight Re(s)=1/2. This was one of the most significant results in this field. In 1943, a few days before Oslo University was closed by the occupiers, Selberg successfully defended his Ph.D. dissertation.He had such outstanding achievements in the war that Danish mathematician Harald Bohr, when asked about what was happening in European mathematics during the war, briefly replied: \"Selberg\".\n\nAfter the war, \"Electoral\" proof and the Fields Prize after the war, Selberg took over the theory of the cieve theory, creating in 1947 a powerful \"Selberg sieve method\", which was widely applied in the number theory, and the work culminated in 1948, when he offered \"elemental\" proof of the asymptotic law of the distribution of prime numbers.This evidence, based only on real numbers, and not on complex analysis, as was done in the past, has become sensational. This result was almost simultaneously, but independently, also produced Hungarian mathematician Pal Erdös, which led to a long and well-known debate about priority, and the result was that Selberg's articles were published first.For these fundamental achievements, at the International Congress of Mathematicians in Cambridge, U.S.A., Atla Selberg was awarded the Fields Prize, the most prestigious award for young mathematicians.\n\n==History==The Princeton period and the trace formula in 1947, Selberg moved to the United States at the invitation of Carl Ludwig Zigel, first to the Institute for Advanced Studies (IAS) in Princeton, and after a short period of service at Siracusa University, he returned to Princeton in 1949, where he was appointed professor in 1951.In Princeton, his research has shifted to the theory of automorphic functions and spectral theory, and in 1956, he published his most influential work, in the view of his colleagues, in which he presented the so-called \"Selberg Trace Formula\".This formula established a deep connection between the lengths of closed geodetic on the rhman surface and the personal values of Laplace operator, which has been applied in a wide range of fields, from number theory to quantum physics. Selberg continued to work actively and lecture to deep old age. He received numerous other awards, including the 1986 Wolf Prize in Mathematics and the 2002 Abel Prize in the year of its establishment.His selected writings were published in two volumes.\n\nIn 1947, Atle Selberg married Hedwig Liebermann, who also worked at the Institute of Advanced Studies, and had two children, Ingrid's daughter and Lars' son. Hedwig died in 1995. In 2003, he married for the second time, Betty Compton Selberg, and Atle Selberg died of heart failure on 6 August 2007 at his home in Princeton, aged 90."
  interestingFactsRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0410\u0442\u043b\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430
    \u043f\u043e\u043b\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439,
    \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0443\u0440\u044c\u0435\u0437\u043e\u0432, \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445
    \u043f\u0440\u043e\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0439 \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u0436\u0438\u0432\u044b\u043c \u0438 \u043d\u0435\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c.\n\n\U0001F9E0 \u0412\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434
    \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0435 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435
    - \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0447\u0435\u0440\u0435\u0437
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e: \u041f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u043e \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430
    \u0441 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u043e\u0441\u044c
    \u0447\u0435\u0440\u0435\u0437 \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u042d\u0439\u043b\u0435\u0440\u0430.
    \u0414\u0440\u0443\u0433\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438, \u043e\u043d
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u043d\u0438\u043c\u0438
    \u043a\u0430\u043a \u0441 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u043c\u0438
    \u044d\u043a\u0441\u043f\u043e\u043d\u0435\u043d\u0442\u0430\u043c\u0438, \u043d\u0435 \u0438\u043c\u0435\u044f
    \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430. \u0415\u0433\u043e \"\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u044b\u043b\u043e
    \u043e\u0442\u0440\u044b\u0432\u043e\u0447\u043d\u044b\u043c\" (spotty) \u2014 \u043e\u043d
    \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0437\u044f\u043b \u044d\u0442\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0432\u0435\u0440\u0448\u0438\u043d\u0443 \u0441\u0445\u043e\u0434\u0443, \u043c\u0438\u043d\u0443\u044f
    \u0431\u0430\u0437\u043e\u0432\u044b\u0435 \u0441\u0442\u0443\u043f\u0435\u043d\u0438. -
    \u041f\u0435\u0440\u0432\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435: \u0412
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u043a\u043e\u043b\u043e \u0441\u0435\u043c\u0438
    \u043b\u0435\u0442 \u043e\u043d \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c
    \u043c\u0435\u0436\u0434\u0443 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430\u043c\u0438 \u0434\u0430\u0435\u0442 \u043d\u0435\u0447\u0435\u0442\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430. \u0412 15 \u043b\u0435\u0442 \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b
    \u0437\u0430\u043c\u0435\u0442\u043a\u0443 \u0432 \u043d\u043e\u0440\u0432\u0435\u0436\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0436\u0443\u0440\u043d\u0430\u043b
    Normat \u043e \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430
    \u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0440\u044f\u0434\u0430.
    - \u0421\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435: \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0435\u0433\u043e \u0443\u0447\u0438\u043b\u0438 \u043d\u0435 \u0432 \u0448\u043a\u043e\u043b\u0435,
    \u0430 \u043a\u043d\u0438\u0433\u0438 \u0438\u0437 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438
    \u043e\u0442\u0446\u0430. \u041e\u043d \u043e\u0441\u0432\u043e\u0438\u043b \u043c\u0435\u0442\u043e\u0434\u044b
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u0430
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \u044f\u0437\u044b\u043a\u0438
    \u2014 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0441\u0442\u0430\u0440\u0448\u0435\u0439
    \u0441\u0435\u0441\u0442\u0440\u044b.\n\n\U0001F4DD \u0417\u0430\u0431\u0430\u0432\u043d\u044b\u0435
    \u044d\u043f\u0438\u0437\u043e\u0434\u044b \u0441 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f\u043c\u0438
    - \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d \u0438 \"\u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0435\":
    \u0412\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0442\u0440\u0443\u0434\u0430\u043c\u0438
    \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430, \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e
    \u0441\u0442\u0430\u0442\u044c\u044e \u043e \u0442\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445
    \u043d\u0430 \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u044e \u0441\u0430\u043c\u043e\u043c\u0443
    \u0413. \u041d. \u0423\u043e\u0442\u0441\u043e\u043d\u0443, \u043d\u043e \u0442\u043e\u0442,
    \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430,
    \u0431\u044b\u043b \"\u043e\u0447\u0435\u043d\u044c \u043c\u0435\u0434\u043b\u0438\u0442\u0435\u043b\u0435\u043d\"
    \u0441 \u043e\u0442\u0432\u0435\u0442\u043e\u043c. - \u041e\u043f\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0435
    \u043d\u0430 \u0444\u0438\u043d\u0438\u0448\u0435: \u0421\u0430\u043c\u044b\u043c \u0431\u043e\u043b\u044c\u0448\u0438\u043c
    \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0435\u0433\u043e
    \u044e\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u043b\u043e \u0442\u043e, \u0447\u0442\u043e
    \u043e\u043d \u043d\u0430\u0448\u0435\u043b \u0442\u043e\u0447\u043d\u0443\u044e \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0434\u043b\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u044f (partition function), \u043d\u043e,
    \u043f\u043e\u043a\u0430 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b, \u0413\u0430\u043d\u0441
    \u0420\u0430\u0434\u0435\u043c\u0430\u0445\u0435\u0440 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0432\u0435\u0440\u0441\u0438\u044e. \u0425\u043e\u0442\u044f
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430
    \u0431\u044b\u043b\u0438 \u0442\u043e\u0447\u043d\u0435\u0435, \u043e\u043d \u0440\u0435\u0448\u0438\u043b
    \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0438\u0445,
    \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0432\u0441\u0442\u0443\u043f\u0430\u0442\u044c
    \u0432 \u0441\u043f\u043e\u0440.\n\n\u2694\ufe0f \u0412\u043e\u0435\u043d\u043d\u044b\u0435
    \u0431\u0443\u0434\u043d\u0438 - \"\u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\" \u043a\u0430\u043a
    \u043e\u0442\u0432\u0435\u0442: \u041a\u043e\u0433\u0434\u0430 \u0434\u0430\u0442\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0425\u0430\u0440\u0430\u043b\u044c\u0434\u0430
    \u0411\u043e\u0440\u0430 \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438, \u0447\u0442\u043e
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u043e \u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b,
    \u043e\u043d \u043a\u043e\u0440\u043e\u0442\u043a\u043e \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \"\u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\". \u042d\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u0431\u044b\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430
    \u0432 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u043e\u043a\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438. - \u0421\u043e\u043b\u0434\u0430\u0442
    \u0438 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u0439: \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0431\u043e\u044f\u0445
    \u0441 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u043c\u0438 \u0437\u0430\u0445\u0432\u0430\u0442\u0447\u0438\u043a\u0430\u043c\u0438
    \u0432 \u0413\u0443\u0434\u0431\u0440\u0430\u043d\u0434\u0441\u0434\u0430\u043b\u0435\u043d\u0435
    \u0438 \u043f\u043e\u043f\u0430\u043b \u0432 \u043f\u043b\u0435\u043d \u0432 \u043b\u0430\u0433\u0435\u0440\u0435
    \u0422\u0440\u0430\u043d\u0434\u0443\u043c. \u041f\u043e\u0437\u0436\u0435, \u0437\u0430\u0449\u0438\u0442\u0438\u0432
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u0432 1943 \u0433\u043e\u0434\u0443, \u043e\u043d \u0431\u044b\u043b \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e
    \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u0430\u043d \u0433\u0435\u0441\u0442\u0430\u043f\u043e
    \u0438 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438, \u0447\u0442\u043e \u043f\u043e\u043a\u0438\u043d\u0435\u0442
    \u041e\u0441\u043b\u043e.\n\n\U0001F525 \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u044b
    - \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0430:
    \u0412\u0441\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u0434\u0440\u0430\u043c\u0430
    \u0441 \"\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u043c\" \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b \u0438 \u0441\u043f\u043e\u0440\u043e\u043c
    \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0441 \u041f\u043e\u043b\u043e\u043c
    \u042d\u0440\u0434\u0451\u0448\u0435\u043c, \u043f\u043e \u0441\u0443\u0442\u0438, \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430
    \u0438\u0437-\u0437\u0430 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0434\u0432\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0431\u044b\u043b\u0438 \u043f\u043e\u043b\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044f\u043c\u0438
    \u043f\u043e \u0441\u0442\u0438\u043b\u044e \u0440\u0430\u0431\u043e\u0442\u044b. \u042d\u0440\u0434\u0451\u0448
    \u0431\u044b\u043b \"\u043f\u0440\u0438\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c\", \u0430 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u2014 \"\u043e\u0434\u0438\u043d\u043e\u0447\u043a\u043e\u0439\". \u042d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \"\u043f\u0440\u043e\u0432\u0430\u043b\u0443 \u0432 \u043a\u043e\u043c\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0438\"
    \u0438 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u0435\u0434\u0438\u043d\u043e\u043b\u0438\u0447\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e,
    \u0445\u043e\u0442\u044f \u043c\u043d\u043e\u0433\u0438\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438,
    \u0447\u0442\u043e \u0435\u0435 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c.
    - \u0422\u0440\u0443\u0431\u043a\u0430 \u0438 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0430:
    \u0412 \u043a\u043e\u043d\u0446\u0435 1970-\u0445 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b \u043a \u0441\u0435\u0431\u0435 \u0434\u043e\u043c\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u0437\u0430\u044f\u0434\u043b\u044b\u043c \u043a\u0443\u0440\u0438\u043b\u044c\u0449\u0438\u043a\u043e\u043c
    \u0442\u0440\u0443\u0431\u043a\u0438. \u0416\u0435\u043d\u0430 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430,
    \u0425\u0435\u0434\u0432\u0438\u0433, \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0430
    \u043d\u0435 \u043a\u0443\u0440\u0438\u0442\u044c \u0432 \u0434\u043e\u043c\u0435. \u041f\u043e\u0441\u043b\u0435
    \u0443\u0436\u0438\u043d\u0430, \u043a\u043e\u0433\u0434\u0430 \u0433\u043e\u0441\u0442\u044c
    \u0441\u043e\u0431\u0440\u0430\u043b\u0441\u044f \u0432\u044b\u0439\u0442\u0438 \u043d\u0430
    \u0443\u043b\u0438\u0446\u0443 \u043f\u043e\u043a\u0443\u0440\u0438\u0442\u044c, \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u043d\u0430\u0441\u0442\u043e\u044f\u043b \u043d\u0430 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b
    \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0435\u043c\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044e.
    \u041f\u0440\u043e\u0433\u0443\u043b\u043a\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u0438\u043b\u044c\u043d\u044b\u0439
    \u0445\u043e\u043b\u043e\u0434 \u0438 \u0432\u0435\u0442\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043d\u0430\u0437\u043b\u043e \u0432\u0441\u0435\u043c \u0443\u0441\u0438\u043b\u0438\u044f\u043c
    \u043a\u0443\u0440\u0438\u043b\u044c\u0449\u0438\u043a\u0430, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u043b
    \u0434\u044b\u043c \u043f\u0440\u044f\u043c\u043e \u0432 \u043b\u0438\u0446\u043e \u0441\u0430\u043c\u043e\u043c\u0443
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0443. - \"\u0428\u043f\u0438\u043e\u043d\u0441\u043a\u0430\u044f\"
    \u043c\u0438\u0441\u0441\u0438\u044f: \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0436\u0435\u043d\u044b \u0425\u0435\u0434\u0432\u0438\u0433 \u0432 1995 \u0433\u043e\u0434\u0443,
    \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044e \u0432 \u041a\u0438\u0442\u0430\u0439.
    \u041f\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u043e\u043d
    \u0441 \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u043e\u0439 \u0443\u043b\u044b\u0431\u043a\u043e\u0439
    \u0438 \u0431\u043b\u0435\u0441\u043a\u043e\u043c \u0432 \u0433\u043b\u0430\u0437\u0430\u0445
    \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0441\u044f \u043a\u043e\u043b\u043b\u0435\u0433\u0435,
    \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0441\u044f \u0432
    \u041f\u0430\u043b\u043e-\u0410\u043b\u044c\u0442\u043e \u0432\u043e\u0432\u0441\u0435 \u043d\u0435
    \u0434\u043b\u044f \u043b\u0435\u043a\u0446\u0438\u0439, \u0430 \u0434\u043b\u044f \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0435\u0439 \u0434\u0430\u0432\u043d\u0435\u0439 \u043f\u043e\u0434\u0440\u0443\u0433\u0435
    \u0411\u0435\u0442\u0442\u0438 (\u041c\u0438\u043a\u043a\u0438) \u0424\u0435\u0439\u0442.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u0430
    \u0432\u0440\u0430\u0441\u043f\u043b\u043e\u0445, \u043d\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0430\u0441\u044c.\n\n\U0001F3A9
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \"\u0431\u0430\u0431\u0443\u0448\u043a\u0438\u043d\u044b
    \u0441\u043a\u0430\u0437\u043a\u0438\" \u0412 \u043f\u0440\u0435\u043a\u043b\u043e\u043d\u043d\u043e\u043c
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b, \u0447\u0442\u043e \u0443
    \u043d\u0435\u0433\u043e \u0435\u0441\u0442\u044c \u0446\u0435\u043b\u0430\u044f \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u044f
    \u043d\u0435\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d
    \u0445\u0440\u0430\u043d\u0438\u0442 \u0432 \u0441\u0442\u043e\u043b\u0435. \u042d\u0442\u0438
    \u0441\u043b\u0443\u0445\u0438 \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u0438 \u0442\u0440\u0435\u043f\u0435\u0442
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435, \u0445\u043e\u0442\u044f \u043d\u0438\u043a\u0442\u043e
    \u043d\u0435 \u0437\u043d\u0430\u043b \u043d\u0430\u0432\u0435\u0440\u043d\u044f\u043a\u0430,
    \u043f\u0440\u0430\u0432\u0434\u0430 \u044d\u0442\u043e \u0438\u043b\u0438 \u043d\u0435\u0442.
    \u041d\u0430 90-\u043b\u0435\u0442\u043d\u0438\u0439 \u044e\u0431\u0438\u043b\u0435\u0439
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0443\u0441\u0442\u0440\u043e\u0438\u043b\u0438
    \u0435\u043c\u0443 \u0443\u0436\u0438\u043d \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c
    \u043a\u043b\u0443\u0431\u0435, \u043d\u043e \u0443\u0436\u0435 \u0442\u043e\u0433\u0434\u0430
    \u043e\u043d \u0431\u044b\u043b \u043d\u0435\u0437\u0434\u043e\u0440\u043e\u0432 \u2014
    \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u0438\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430. \u042d\u0442\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0421\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0430
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043e\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0435\u0433\u043e \"\u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u043c\u0438\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\",
    \u043d\u043e \u0438 \u043a\u0430\u043a \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e,
    \u0436\u0438\u0432\u0443\u044e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u043e\u0447\u0435\u0442\u0430\u043b\u0430 \u0432 \u0441\u0435\u0431\u0435 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0443\u044e
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044e, \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u043e,
    \u0443\u043c\u0435\u043d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432
    \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e
    \u044e\u043c\u043e\u0440\u0430. \u0415\u0441\u043b\u0438 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e
    \u0438\u0437 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b
    \u0432\u0430\u0441 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e, \u044f \u043c\u043e\u0433\u0443
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u043e \u043d\u0435\u043c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435."
  interestingFactsEn: "Atle Selberg's biography is full not only of great mathematical achievements, but also of human curies, funny events and amazing details, which show him as a living and extraordinary man.\n\nVunderkind and unusual learning - Geometry through trigonometry: Surprisingly, but Selberg's introduction to trignometry functions was done through the Eulerian formulas. In other words, he met them as complex exhibits without having a preliminary geometric foundation. His \"geometric education was partial\" -- he just took this mathematical top of the descent, bypassing the basic steps.First discovery: At the age of seven, he himself observed that the difference between consecutive squares gave odd numbers. At the age of 15, he sent a note to Norwegian mathematical journal Normat on the relationship between integral and infinite series. - Self-explanatory study: Mathematics was taught not in school, but from his father's library. He learned how to solve equations on his own, and foreign languages with the help of his older sister.\n\n♪ Funny episodes of publications - Ramanujan and \"famousness\": Inspired by Ramanujan's work, Selberg sent his first article on theta functions to the review by G. N. Watson himself, but he was \"very slow,\" according to Selberg, with the answer.The biggest disappointment of his youth was that he found a precise analytical formula for the break-up function (partition function), but while he was working, Hans Rademacher published his version, although the Selberg results were more accurate, he decided not to publish them to avoid arguing.\n\nWhen asked what was going on in European mathematics during World War II, he responded briefly: \"Selberg.\" This shows how outstanding Selberg's work was in the isolation of occupied Norway.Later, after defending his doctoral thesis in 1943, he was immediately arrested by Gestapo and released only on condition that he left Oslo.\n\nThe entire famous drama with \"elementary\" proof of the theorem about the distribution of primes and the priority dispute with Paul Erdös was essentially because the two mathematicians were the exact opposite of the style of work.This led to a \"miss in communication\" and to Selberg receiving the Fields Prize alone, although many thought it should be separated.After dinner, when the guest was about to go outside for a smoke, Selberg insisted on keeping him company, and the walk took place despite the strong cold and wind, which, in spite of all the smoker's efforts, had put smoke in the face of Selberg himself.On his return, he gave a mysterious smile and a bright look to a colleague who told him that he had stopped at Palo Alto not to give lectures, but to propose to her long-standing friend Betty Faith, who was caught off guard but agreed.\n\nIn his early years, Selberg told me that he had a collection of unpublished works he kept on the table, and that the rumors were trembling in the mathematical community, even though no one knew for sure whether it was true or not, and that for the 90th anniversary, he had a dinner at Princeton Club, but he was already unwell -- it was their last meeting.These stories show Selberg not only as a person who left a \"deep trail in the mathematics world\" but as an amazing, living person who combined genius, tenacity, isolation and humor, and if you're particularly interested in one of the episodes, I can tell you more about it."
