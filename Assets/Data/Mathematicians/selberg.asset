    \u0438\u0437 \u0431\u0440\u0430\u0442\u044c\u0435\u0432 \u0410\u0442\u043b\u0435 \u2014
    \u0425\u0435\u043d\u0440\u0438\u043a, \u0421\u0438\u0433\u043c\u0443\u043d\u0434 \u0438
