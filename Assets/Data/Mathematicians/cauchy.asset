    \u0430 \u042d\u0436\u0435\u043d \u0441\u0442\u0430\u043b \u043f\u0443\u0431\u043b\u0438\u0446\u0438\u0441\u0442\u043e\u043c
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u043c \u043f\u0440\u0430\u0432\u0430.
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u041a\u043e\u0448\u0438 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c
