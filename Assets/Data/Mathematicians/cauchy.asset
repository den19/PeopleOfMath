    \u041a\u043e\u0448\u0438 \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c \u0436\u0435
    \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439, \u0441\u043a\u043e\u043b\u044c
    \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0439.
    \u0415\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \u043a\u0430\u043a
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0441 \u043e\u0447\u0435\u043d\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u043c
    \u0438 \u043d\u0435\u0443\u0441\u0442\u0443\u043f\u0447\u0438\u0432\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c.
    \u041e\u043d \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439
    \u043d\u0435\u043f\u043e\u043a\u043e\u043b\u0435\u0431\u0438\u043c\u043e\u0439, \u0434\u0430\u0436\u0435
    \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0439 \u043f\u0440\u0438\u0432\u0435\u0440\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e
    \u0441\u0432\u043e\u0438\u043c \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u043c
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u043c.
    \u041a\u043e\u0448\u0438 \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u043c
    \u043a\u0430\u0442\u043e\u043b\u0438\u043a\u043e\u043c \u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u043c\u043e\u043d\u0430\u0440\u0445\u0438\u0441\u0442\u043e\u043c-\u043b\u0435\u0433\u0438\u0442\u0438\u043c\u0438\u0441\u0442\u043e\u043c,
    \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u043e \u0435\u0433\u043e \u0431\u0435\u0441\u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043d\u044b\u043c
    \u0432 \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u0445 \u0441\u043e\u0432\u0435\u0441\u0442\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f
    \u0441\u0442\u0430\u043b\u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0435\u0433\u043e
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0433\u043e \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u044f.
    \u041f\u043e\u0441\u043b\u0435 \u0418\u044e\u043b\u044c\u0441\u043a\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    1830 \u0433\u043e\u0434\u0430 \u041a\u043e\u0448\u0438, \u043a\u0430\u043a \u0432\u0435\u0440\u043d\u044b\u0439
    \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a \u0441\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u041a\u0430\u0440\u043b\u0430 X, \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043f\u0440\u0438\u0441\u044f\u0433\u0430\u0442\u044c \u043d\u0430 \u0432\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u043d\u043e\u0432\u043e\u043c\u0443 \u043c\u043e\u043d\u0430\u0440\u0445\u0443, \u041b\u0443\u0438-\u0424\u0438\u043b\u0438\u043f\u043f\u0443,
    \u0438 \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0432\u0441\u0435 \u0441\u0432\u043e\u0438
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0438\u0435 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u041e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0435\u043b
    \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u0443\u044e \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044e,
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0432\u0448\u0438\u0441\u044c \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u0411\u0443\u0440\u0431\u043e\u043d\u043e\u0432.
    \u0416\u0438\u043b \u0432 \u0422\u0443\u0440\u0438\u043d\u0435 \u0438 \u041f\u0440\u0430\u0433\u0435,
    \u0433\u0434\u0435 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0431\u044b\u043b \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u043c
    \u0432\u043d\u0443\u043a\u0430 \u041a\u0430\u0440\u043b\u0430 X, \u0433\u0435\u0440\u0446\u043e\u0433\u0430
    \u0411\u043e\u0440\u0434\u043e\u0441\u043a\u043e\u0433\u043e, \u0437\u0430 \u0447\u0442\u043e
    \u0438\u0437\u0433\u043d\u0430\u043d\u043d\u044b\u0439 \u043a\u043e\u0440\u043e\u043b\u044c
    \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u043b \u0435\u043c\u0443 \u0442\u0438\u0442\u0443\u043b
    \u0431\u0430\u0440\u043e\u043d\u0430. \u0422\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u041a\u0430\u0440\u043b\u0430 X \u0432 1836 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u043c\u043e\u0433 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f
    \u0432 \u041f\u0430\u0440\u0438\u0436 \u0432 1838 \u0433\u043e\u0434\u0443, \u043d\u043e
    \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u0438\u0437-\u0437\u0430 \u043d\u0435\u043f\u0440\u0438\u044f\u0437\u043d\u0438
    \u043a \u043d\u043e\u0432\u043e\u043c\u0443 \u0440\u0435\u0436\u0438\u043c\u0443, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u044f
    \u043b\u0438\u0448\u044c \u0432 \u0438\u0435\u0437\u0443\u0438\u0442\u0441\u043a\u043e\u043c
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435. \u041f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u0443\u044e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432 \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043b\u0438\u0448\u044c \u043f\u043e\u0441\u043b\u0435 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    1848 \u0433\u043e\u0434\u0430, \u0438 \u0434\u0430\u0436\u0435 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d
    III \u0432 1852 \u0433\u043e\u0434\u0443 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0435\u0433\u043e
    \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443, \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u044f
    \u043f\u0440\u0438\u0441\u044f\u0433\u0438. \u041e\u0433\u044e\u0441\u0442\u0435\u043d \u041b\u0443\u0438
    \u041a\u043e\u0448\u0438 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 23 \u043c\u0430\u044f
    1857 \u0433\u043e\u0434\u0430 \u0432 \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435 \u0421\u043e
    (\u043f\u043e\u0434 \u041f\u0430\u0440\u0438\u0436\u0435\u043c). \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u044f\u0440\u043a\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0434\u043b\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0435\u0433\u043e \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f, \u0441\u0435\u043c\u044c\u044f
    \u0438 \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u0435 \u043d\u0430\u0443\u043a\u0435 \u0431\u044b\u043b\u0438
    \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b."
  personalLifeEn: "Augustin Louis Kosha's personal life was inextricably linked to his scientific career, but it was determined by deep family and religious values, which influenced all of his life choices.\n\n==Early years, family and upbringing==On August 21, 1789, Kosha was born in Paris, in the family of a high-ranking monarchist, Louis-François Cocha, and Marie-Madlen Deestr, who was the eldest of four sons and two daughters in the family, and two of his brothers became prominent figures: Alexander made a successful career in the judicial system, and Eugene became a publicist and historian of law, and Kosha's childhood was at a difficult time in the French Revolution.The family, fleeing terror, moved to the suburb of Arkoy, where he received his first education from his father, where great scientists such as Laples and Bertolle lived, and the Kosha family was very familiar with the mathematician Lagrange.It is a well-known tradition that Lagrange, after seeing the undozen abilities in young Augusten, advised his father not to introduce the boy to mathematical books under the age of 17, so that he could receive a good classical education, which was a childhood environment that would determine his future.\n\nThe marriage and giving birth of daughters at the age of 28 to Koshi, who had lived with his parents, was married, and was elected by Aloisa de Bur, who was five years younger, and was married on 4 April 1818 at the Church of Saint-Sulpice in Paris, and the ceremony was celebrated with great Catholic observance.Interestingly, Aloysa's family had a direct connection to his scientific career: she was a relative of the publisher, who later published most of his work, and they had two daughters: Marie Françoise Alicia (b. 1819) Marie Matilda (b. 1823) and both daughters subsequently married French aristocracy.\n\nThe character, faith and political beliefs of Kosha were as monumental as they were contradictory, described by his colleagues and contemporaries as being very complex and unconscionable, and known for his unflinching, even aggressive commitment to his religious and political views. Koshi was a deeply religious Catholic and convinced legitimist monarchist, making him uncompromising in matters of conscience.After the July 1830 revolution, Koshi, as a loyal supporter of the overthrown King Charles X, refused to pledge allegiance to the new monarch, Louis Philippa, and lost all his professorships in France. He chose voluntary emigration with the Bourbon family.He lived in Turin and Prague, where he was for some time a teacher of his grandson, Carl X, the Duke of Bordeaux, for which the expelled king gave him the title of baron. Only after the death of Carl X in 1836, he was able to return to Paris in 1838, but for a long time refused to hold public office because of his contempt for the new regime, teaching only at Jesuit College.His full professorship in Sorbonne came only after the revolution of 1848, and even Napoleon III left him in 1852 without a sworn oath. Augustin Louis Kocha died on 23 May 1857 at the site of Seo, Paris. His life is a vivid example of a man for whom his beliefs, family, and the service of science were inseparable."
  shortBioRu: "\u041e\u0433\u044e\u0441\u0442\u0435\u043d \u041b\u0443\u0438 \u041a\u043e\u0448\u0438 (1789\u20131857)
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u041e\u043d \u0431\u044b\u043b \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0441\u0443\u0434\u044c\u0431\u044b, \u0447\u044c\u0438
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0435 \u0440\u0430\u0437 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438\u0441\u044c
    \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432
    \u0441 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c. \u041d\u0438\u0436\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u0435\u0433\u043e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435.\n\n\U0001F4DC
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u044e\u043d\u043e\u0441\u0442\u044c (1789\u20131807)
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435:
    \u041e\u0433\u044e\u0441\u0442\u0435\u043d \u041b\u0443\u0438 \u041a\u043e\u0448\u0438 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 21 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1789 \u0433\u043e\u0434\u0430, \u0440\u043e\u0432\u043d\u043e \u0447\u0435\u0440\u0435\u0437
    \u043c\u0435\u0441\u044f\u0446 \u043f\u043e\u0441\u043b\u0435 \u0432\u0437\u044f\u0442\u0438\u044f
    \u0411\u0430\u0441\u0442\u0438\u043b\u0438\u0438, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0432\u044b\u0441\u043e\u043a\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430-\u043c\u043e\u043d\u0430\u0440\u0445\u0438\u0441\u0442\u0430
    \u0438 \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043a\u0430\u0442\u043e\u043b\u0438\u043a\u0430.
    \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0432\u0448\u0438\u0439
    \u0437\u0430 \u043d\u0435\u0439 \u0442\u0435\u0440\u0440\u043e\u0440 \u0432\u044b\u043d\u0443\u0434\u0438\u043b\u0438
    \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u044e \u0431\u0435\u0436\u0430\u0442\u044c \u0432
    \u043f\u0440\u0438\u0433\u043e\u0440\u043e\u0434 \u0410\u0440\u043a\u0451\u0439, \u0433\u0434\u0435
    \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439 \u041a\u043e\u0448\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0435\u0440\u0432\u044b\u0435 \u0443\u0440\u043e\u043a\u0438 \u043e\u0442 \u043e\u0442\u0446\u0430.
    \u0417\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0441 \u0432\u0435\u043b\u0438\u043a\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438: \u0416\u0438\u0437\u043d\u044c \u0432 \u0410\u0440\u043a\u0451\u0435
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u041a\u043e\u0448\u0438 \u0431\u0435\u0441\u0446\u0435\u043d\u043d\u043e\u0435
    \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e. \u041f\u043e \u0441\u043e\u0441\u0435\u0434\u0441\u0442\u0432\u0443
    \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u0436\u0438\u043b\u0438 \u0442\u0430\u043a\u0438\u0435
    \u0441\u0432\u0435\u0442\u0438\u043b\u0430 \u043d\u0430\u0443\u043a\u0438, \u043a\u0430\u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u041f\u044c\u0435\u0440-\u0421\u0438\u043c\u043e\u043d
    \u041b\u0430\u043f\u043b\u0430\u0441 \u0438 \u0445\u0438\u043c\u0438\u043a \u041a\u043b\u043e\u0434-\u041b\u0443\u0438
    \u0411\u0435\u0440\u0442\u043e\u043b\u043b\u0435. \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e,
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u0437\u043d\u0430\u043a\u043e\u043c
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0416\u043e\u0437\u0435\u0444\u043e\u043c-\u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0435\u043c.
    \u041b\u0435\u0433\u0435\u043d\u0434\u0430 \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e
    \u0438\u043c\u0435\u043d\u043d\u043e \u041b\u0430\u0433\u0440\u0430\u043d\u0436, \u0437\u0430\u043c\u0435\u0442\u0438\u0432
    \u043d\u0435\u0434\u044e\u0436\u0438\u043d\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430, \u043f\u043e\u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u043b
    \u043e\u0442\u0446\u0443 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0435\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043d\u0438\u0433\u0438 \u0434\u043e 17 \u043b\u0435\u0442, \u0447\u0442\u043e\u0431\u044b
    \u0442\u043e\u0442 \u043c\u043e\u0433 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435: \u041f\u043e\u0441\u043b\u0435
    \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0432 \u041f\u0430\u0440\u0438\u0436
    \u041a\u043e\u0448\u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u041f\u0430\u043d\u0442\u0435\u043e\u043d\u0430, \u0433\u0434\u0435
    \u0441 \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c \u0438\u0437\u0443\u0447\u0430\u043b
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u044f\u0437\u044b\u043a\u0438.
    \u0412 1805 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    16 \u043b\u0435\u0442, \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0428\u043a\u043e\u043b\u0435
    \u043c\u043e\u0441\u0442\u043e\u0432 \u0438 \u0434\u043e\u0440\u043e\u0433 (1807).\n\n\U0001F477
    \u0418\u043d\u0436\u0435\u043d\u0435\u0440 \u0438 \u043f\u0443\u0442\u044c \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    (1810\u20131821) \u041a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430:
    \u041f\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f
    \u0432 1810 \u0433\u043e\u0434\u0443 \u041a\u043e\u0448\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0432\u043e\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430 \u0432 \u043f\u043e\u0440\u0442\u043e\u0432\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435 \u0428\u0435\u0440\u0431\u0443\u0440. \u041e\u043d
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u044f\u043c\u0438
    \u0438 \u043f\u043e\u0440\u0442\u043e\u0432\u044b\u043c\u0438 \u0441\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u044f\u043c\u0438
    \u0434\u043b\u044f \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430
    \u0432 \u0410\u043d\u0433\u043b\u0438\u044e. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443,
    \u043e\u043d \u043d\u0435 \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u043b \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f. \u041d\u0430\u0447\u0430\u043b\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b: \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443, \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043d\u0443\u044e
    \u0435\u043c\u0443 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0435\u043c, \u043e \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438
    \u043c\u0435\u0436\u0434\u0443 \u0433\u0440\u0430\u043d\u044f\u043c\u0438, \u0440\u0435\u0431\u0440\u0430\u043c\u0438
    \u0438 \u0432\u0435\u0440\u0448\u0438\u043d\u0430\u043c\u0438 \u0432\u044b\u043f\u0443\u043a\u043b\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u0438\u043a\u043e\u0432, \u0447\u0442\u043e
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e \u0435\u043c\u0443 \u043f\u0435\u0440\u0432\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c. \u0412 1813 \u0433\u043e\u0434\u0443,
    \u043f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0438 \u041b\u0430\u043f\u043b\u0430\u0441\u0430, \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u0443\u044e \u0441\u043b\u0443\u0436\u0431\u0443
    \u0438 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c \u0441\u0435\u0431\u044f
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430\u0443\u043a\u0435.
    \u041f\u0435\u0440\u0432\u044b\u0435 \u0442\u0440\u0438\u0443\u043c\u0444\u044b: \u0412
    1814 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043c\u0435\u043c\u0443\u0430\u0440
    \u043e\u0431 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u0445,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e. \u0412 1816 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0413\u0440\u0430\u043d-\u043f\u0440\u0438
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044e
    \u0432\u043e\u043b\u043d, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0432 \u0433\u0438\u0434\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b
    \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u0437\u0430\u043d\u044f\u0432
    \u043c\u0435\u0441\u0442\u043e \u043e\u043f\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0413\u0430\u0441\u043f\u0430\u0440\u0430 \u041c\u043e\u043d\u0436\u0430.\n\n\U0001F468\u200d\U0001F3EB
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 (1816\u20131830) \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u0441\u0430\u043c\u043e\u0435 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0435
    \u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0432 \u0436\u0438\u0437\u043d\u0438 \u041a\u043e\u0448\u0438.
    \u041e\u043d \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0438\u0435 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438
    \u0432 \u0442\u0440\u0435\u0445 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0443\u0447\u0435\u0431\u043d\u044b\u0445
    \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u0445 \u041f\u0430\u0440\u0438\u0436\u0430:
    \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435, \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u0438 \u041a\u043e\u043b\u043b\u0435\u0436 \u0434\u0435
    \u0424\u0440\u0430\u043d\u0441. \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0432\u043e\u0438
    \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435: \u041e\u043d \u043d\u0430\u0447\u0430\u043b
    \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0441\u0442\u0440\u043e\u0433\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u043d\u0430 \u043f\u043e\u043d\u044f\u0442\u0438\u0438 \u043f\u0440\u0435\u0434\u0435\u043b\u0430.
    \u0412 1821 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u0435\u043b \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u00ab\u041a\u0443\u0440\u0441 \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u00bb (Cours d'analyse),
    \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0438
    \u00ab\u0420\u0435\u0437\u044e\u043c\u0435 \u0443\u0440\u043e\u043a\u043e\u0432 \u043f\u043e
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e\u00bb (1823) \u0438 \u00ab\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb
    (1826\u20131828). \u0412 \u044d\u0442\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u043e\u043d \u0432\u0432\u0435\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430 \u043a\u0430\u043a \u043f\u0440\u0435\u0434\u0435\u043b\u0430
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0443\u043c\u043c
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0445\u0441\u044f \u0440\u044f\u0434\u043e\u0432.
    \u041e\u043d \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443
    \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e,
    \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430
    \u041a\u043e\u0448\u0438, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0432\u044b\u0447\u0435\u0442\u043e\u0432. \u0412 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443
    \u041a\u043e\u0448\u0438. \u0412 1822 \u0433\u043e\u0434\u0443 \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0443\u043f\u0440\u0443\u0433\u043e\u0441\u0442\u0438,
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044f \u0442\u0435\u043b\u043e
    \u043a\u0430\u043a \u0441\u043f\u043b\u043e\u0448\u043d\u0443\u044e \u0441\u0440\u0435\u0434\u0443
    \u0438 \u0432\u0432\u0435\u0434\u044f \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0439 \u0432 \u043a\u0430\u0436\u0434\u043e\u0439
    \u0435\u0433\u043e \u0442\u043e\u0447\u043a\u0435.\n\n\U0001F6B6 \u0418\u0437\u0433\u043d\u0430\u043d\u0438\u0435
    \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 (1830\u20131857)
    \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441 \u0432\u043b\u0430\u0441\u0442\u044c\u044e:
    \u0412 1830 \u0433\u043e\u0434\u0443 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u0418\u044e\u043b\u044c\u0441\u043a\u0430\u044f
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f, \u0441\u0432\u0435\u0440\u0433\u043d\u0443\u0432\u0448\u0430\u044f
    \u043a\u043e\u0440\u043e\u043b\u044f \u041a\u0430\u0440\u043b\u0430 X. \u041a\u043e\u0448\u0438,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u043b\u0435\u0433\u0438\u0442\u0438\u043c\u0438\u0441\u0442\u043e\u043c (\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u043c
    \u0441\u0442\u0430\u0440\u0448\u0435\u0439 \u0432\u0435\u0442\u0432\u0438 \u0411\u0443\u0440\u0431\u043e\u043d\u043e\u0432),
    \u043d\u0430\u043e\u0442\u0440\u0435\u0437 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043f\u0440\u0438\u0441\u044f\u0433\u0430\u0442\u044c \u043d\u0430 \u0432\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u043d\u043e\u0432\u043e\u043c\u0443 \u043a\u043e\u0440\u043e\u043b\u044e \u041b\u0443\u0438-\u0424\u0438\u043b\u0438\u043f\u043f\u0443
    \u0438 \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0432\u0441\u0435 \u0441\u0432\u043e\u0438
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438. \u0414\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u043e\u0435
    \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u0435: \u041e\u043d \u0443\u0435\u0445\u0430\u043b
    \u0438\u0437 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u0422\u0443\u0440\u0438\u043d\u0435 (\u0418\u0442\u0430\u043b\u0438\u044f), \u0430
    \u0437\u0430\u0442\u0435\u043c, \u043f\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e
    \u0441\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u044f
    \u041a\u0430\u0440\u043b\u0430 X, \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u041f\u0440\u0430\u0433\u0443, \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0430\u0442\u044c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0438 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u043c
    \u0435\u0433\u043e \u0432\u043d\u0443\u043a\u0430, \u0433\u0435\u0440\u0446\u043e\u0433\u0430
    \u0411\u043e\u0440\u0434\u043e\u0441\u043a\u043e\u0433\u043e. \u0417\u0430 \u044d\u0442\u0443
    \u0441\u043b\u0443\u0436\u0431\u0443 \u0438\u0437\u0433\u043d\u0430\u043d\u043d\u044b\u0439
    \u043a\u043e\u0440\u043e\u043b\u044c \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u043b
    \u0435\u043c\u0443 \u0442\u0438\u0442\u0443\u043b \u0431\u0430\u0440\u043e\u043d\u0430.
    \u0412 1834 \u0433\u043e\u0434\u0443 \u043a \u043d\u0435\u043c\u0443 \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043b\u0430\u0441\u044c
    \u0435\u0433\u043e \u0436\u0435\u043d\u0430. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435:
    \u0412 1838 \u0433\u043e\u0434\u0443 \u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u041f\u0430\u0440\u0438\u0436. \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443
    \u043e\u0442 \u043d\u0435\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0438 \u043f\u0440\u0438\u0441\u044f\u0433\u0438,
    \u043e\u043d \u0441\u043c\u043e\u0433 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c
    \u0441\u0432\u043e\u0435 \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u043e \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a, \u043d\u043e \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u0439 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438.
    \u041b\u0438\u0448\u044c \u043f\u043e\u0441\u043b\u0435 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    1848 \u0433\u043e\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u0438\u0441\u044f\u0433\u0430
    \u0431\u044b\u043b\u0430 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u0430, \u043e\u043d
    \u0432\u043d\u043e\u0432\u044c \u0437\u0430\u043d\u044f\u043b \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0432 \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435. \u0414\u0430\u0436\u0435 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d
    III \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0435\u0433\u043e \u043d\u0430 \u044d\u0442\u043e\u043c
    \u043f\u043e\u0441\u0442\u0443 \u0432 1852 \u0433\u043e\u0434\u0443, \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u044f
    \u043f\u0440\u0438\u0441\u044f\u0433\u0438.\n\n\U0001F4D6 \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0421\u0435\u043c\u044c\u044f: \u0412 1818 \u0433\u043e\u0434\u0443 \u041a\u043e\u0448\u0438
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0410\u043b\u043e\u0438\u0437\u0435
    \u0434\u0435 \u0411\u044e\u0440, \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u0446\u0435
    \u0441\u0432\u043e\u0435\u0433\u043e \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044f. \u0423
    \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0434\u0432\u0435 \u0434\u043e\u0447\u0435\u0440\u0438.
    \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440: \u0415\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u0447\u0430\u0441\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u0435\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0442\u044f\u0436\u0435\u043b\u044b\u043c
    \u0432 \u043e\u0431\u0449\u0435\u043d\u0438\u0438, \u0441\u0430\u043c\u043e\u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c
    \u0438 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u043c \u0432 \u0441\u0432\u043e\u0438\u0445
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0445 \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u0445. \u042d\u0442\u0430 \u043d\u0435\u043f\u0440\u0438\u043c\u0438\u0440\u0438\u043c\u043e\u0441\u0442\u044c
    \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b.
    \u0413\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0438\u0439 \u0432\u043a\u043b\u0430\u0434:
    \u041a\u043e\u0448\u0438 \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043b\u043e\u0434\u043e\u0432\u0438\u0442\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c.
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043e\u043a\u043e\u043b\u043e 800
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442 \u0438 \u043f\u044f\u0442\u044c
    \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u044b\u0445 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u0432.
    \u0415\u0433\u043e \u043f\u043e\u043b\u043d\u043e\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439 \u0441\u043e\u0441\u0442\u043e\u0438\u0442
    \u0438\u0437 27 \u0442\u043e\u043c\u043e\u0432. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435:
    \u041e\u043d \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
    \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a (\u0441 1851 \u0433.)
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439
    \u0415\u0432\u0440\u043e\u043f\u044b. \u0415\u0433\u043e \u0438\u043c\u044f \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u043e
    \u043d\u0430 \u042d\u0439\u0444\u0435\u043b\u0435\u0432\u043e\u0439 \u0431\u0430\u0448\u043d\u0435
    \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u0447\u0435\u043d\u044b\u0445 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u0421\u043c\u0435\u0440\u0442\u044c:
    \u041e\u0433\u044e\u0441\u0442\u0435\u043d \u041b\u0443\u0438 \u041a\u043e\u0448\u0438 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    23 \u043c\u0430\u044f 1857 \u0433\u043e\u0434\u0430 \u0432 \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435
    \u0421\u043e (\u043f\u043e\u0434 \u041f\u0430\u0440\u0438\u0436\u0435\u043c). \u041f\u043e
    \u043f\u0440\u0435\u0434\u0430\u043d\u0438\u044e, \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c\u0438
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u0431\u044b\u043b\u0438: \u00ab\u042f \u043e\u0431\u044a\u044f\u0441\u043d\u044e \u044d\u0442\u043e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435 \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c
    \u043c\u0435\u043c\u0443\u0430\u0440\u0435\u00bb."
  shortBioEn: "Augustin Louis Koshi (1789-1857) is one of the greatest mathematicians in history whose work has laid the foundation for modern mathematical analysis, and he was not only a genius scientist but also a man of complex fate whose political and religious beliefs have repeatedly led to conflicts with society, and his detailed biography and scientific heritage are presented below.\n\n==Early life==The birth and birth of Augustine Louis Koshi was born in Paris on August 21, 1789, just a month after the Bastille was taken, in the family of a high-ranking monarchist and a passionate Catholic, and the revolution and the terror that followed it forced his family to flee to the suburb of Arkoy, where little Koshi received his first lesson from his father.His father was familiar with another great mathematician, Joseph-Louis Lagrang, who said that it was Lagrang who, after seeing the boy's non-dozen abilities, advised his father not to show him math books until he was 17 years old so that he could begin his classical education.Education: After his return to Paris, Koshi entered the Pantheon Central School, where he studied classical languages with distinction. In 1805, at the age of 16, he entered a prestigious Polytechnic School and then continued his education at the Bridge and Road School (1807).\n\n▪ Engineer and the way to mathematics (1810–1821): After completing his studies in 1810, Koshi was promoted to a position of military engineer in the port city of Cherbour, working on strengthening and port facilities for Napoleon's invasion of England. Despite intensive work, he did not stop doing math in his spare time.The beginning of his scientific career: During this period he decided on the task proposed to him by Lagrang, concerning the relationship between the edges, ribs and the vertebrates of convex multi-dimensionals, which brought him first to his attention. In 1813, at Lagrangian and Laplas' insistence, he left the engineering service and returned to Paris to devote himself exclusively to science.First triumph: In 1814, he published a famous memoir on certain integrals, which became the basis of the theory of the functions of the integrated variable, and in 1816, he received the Grand Prix of the French Academy of Sciences for his work on wave distribution, which is considered classical in hydrodynamics, and in 1816 he was appointed a member of the Paris Academy of Sciences, taking the place of the top mathematician, Gaspar Monge.\n\nThis was the most fruitful and relatively stable time in Kosha's life, and he was simultaneously in the three leading institutions of Paris: Sorbonne, Polytechnic School and College de France.It was during this period that he created his main works, which revolutionized mathematics: he began to give lectures that systematically used strict methods based on the concept of the limit. In 1821 his famous \"Cours d'anallyse\" was published, followed by \"Resumé of Differential Studies\" (1823) and \"Annexes to Geometry\" (1826-1828).In this work, he introduced strict definitions of continuity of function, integration as the limit of integral amounts and developed a theory of matching series; he practically alone created the theory of functions of an integrated variable, introduced the concept of an integral Kosha, developed a theory of deductions; and, in the theory of differential equations, he formulated the famous task of Kosha.In 1822, he laid the foundation for the mathematical theory of turgidity, treating the body as a complete environment and introducing the concepts of stress and deformation at each point.\n\n♪ Exile and return (1830–1857) conflict with power: In 1830, the French revolution broke out in July, overthrowing King Charles X. Koshi, convinced of the legitimist (a member of the Bourbon Senior Branch), refused to swear allegiance to the new King Louis-Philippe and lost all his posts.He taught in Turin, Italy for a while, and then, at the invitation of the overthrown King Carl X, went to Prague to become a teacher and teacher of his grandson, Duke of Bordeaux. For this service, the expelled king gave him the title of baron. His wife joined him in 1834. Return: In 1838 he returned to Paris.Since he was no longer required to take the oath, he was able to regain his membership in the Academy of Sciences, but did not receive a professorial position, until after the 1848 revolution, when the oath was cancelled, he resumed the chair at Sorbonne. Even Napoleon III left him in that post in 1852, without requiring an oath.\n\nIn 1818, Koshi married Aloysa de Bür, a relative of his publisher. They had two daughters.He wrote about 800 scientific papers and five full-fledged textbooks, and his full collection of essays consists of 27 volumes, and his recognition: he was a member of the Royal Society of London, an honorary member of the Petersburg Academy of Sciences (1851) and many other academies of Europe, and his name was inscribed on the Eiffel Tower on the list of the greatest scientists in France.His last words at the Academy were, \"I'll explain this in more detail in the next memoir.\""
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041a\u043e\u0448\u0438 \u043f\u043e\u043b\u043d\u0430 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u044b\u0445
