    \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043b \u0435\u043c\u0443 \u043e\u0431 \u044d\u0442\u043e\u043c,
    \u0433\u043e\u0432\u043e\u0440\u044f, \u0447\u0442\u043e \u041a\u043e\u0448\u0438 \u043d\u0430\u0447\u0430\u043b
    \u0441\u0432\u043e\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0432 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0445
    \u0441\u0442\u043e\u0447\u043d\u044b\u0445 \u0442\u0440\u0443\u0431\u0430\u0445. \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u0418\u043c\u044f \u041a\u043e\u0448\u0438
    \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u043e \u043d\u0430 \u042d\u0439\u0444\u0435\u043b\u0435\u0432\u043e\u0439
    \u0431\u0430\u0448\u043d\u0435 \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 72 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u0447\u0435\u043d\u044b\u0445 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u0412\u0441\u0435\u0433\u043e
    \u0447\u0435\u0442\u044b\u0440\u0435 \u043a\u043d\u0438\u0433\u0438: \u0423\u0435\u0437\u0436\u0430\u044f
    \u043d\u0430 \u043f\u0435\u0440\u0432\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u0432
    \u0428\u0435\u0440\u0431\u0443\u0440, \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u0438\u043d\u0436\u0435\u043d\u0435\u0440
    \u041a\u043e\u0448\u0438 \u0432\u0437\u044f\u043b \u0441 \u0441\u043e\u0431\u043e\u0439
