    \u0434\u0432\u0443\u0445 \u0434\u043e\u0447\u0435\u0440\u0435\u0439 \u0432 \u0441\u0435\u043c\u044c\u0435.
    \u0414\u0432\u043e\u0435 \u0435\u0433\u043e \u0431\u0440\u0430\u0442\u044c\u0435\u0432 \u0442\u0430\u043a\u0436\u0435
    \u0441\u0442\u0430\u043b\u0438 \u0437\u0430\u043c\u0435\u0442\u043d\u044b\u043c\u0438 \u0444\u0438\u0433\u0443\u0440\u0430\u043c\u0438:
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0441\u0434\u0435\u043b\u0430\u043b
