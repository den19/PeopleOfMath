    \u0432 \u043e\u0431\u0449\u0435\u043d\u0438\u0438. \u041e\u043d \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0435\u0439 \u043d\u0435\u043f\u0440\u0438\u043c\u0438\u0440\u0438\u043c\u043e\u0441\u0442\u044c\u044e
    \u0432 \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u0445 \u0440\u0435\u043b\u0438\u0433\u0438\u0438
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438, \u0447\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043b\u043e
    \u0435\u043c\u0443 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0432\u0440\u0430\u0433\u043e\u0432
    \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u0430\u0445.\n\n\U0001F3AD
    \u041a\u0443\u0440\u044c\u0435\u0437\u044b \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438
    \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0435 \u0448\u0443\u0442\u043a\u0438:
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c
    \u041a\u043e\u0448\u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0440\u0435\u043c\u043e\u043d\u0442\u043e\u043c
    \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0445 \u043a\u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0439.
    \u0415\u0433\u043e \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u043d\u0438\u043a, \u044e\u043d\u044b\u0439
    \u0433\u0435\u0440\u0446\u043e\u0433 \u0411\u043e\u0440\u0434\u043e\u0441\u043a\u0438\u0439,
