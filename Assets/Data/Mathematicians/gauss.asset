    \u041a\u043e\u0433\u0434\u0430 \u044d\u0442\u043e\u0442 \u0434\u043d\u0435\u0432\u043d\u0438\u043a
    \u043d\u0430\u0448\u043b\u0438 \u0432 1898 \u0433\u043e\u0434\u0443, \u0443\u0447\u0435\u043d\u044b\u0435
    \u0430\u0445\u043d\u0443\u043b\u0438: \u0413\u0430\u0443\u0441\u0441 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    XIX \u0432\u0435\u043a\u0430, \u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u043b
    \u044d\u0442\u043e \u043a\u0430\u043a \u0437\u0430\u043c\u0435\u0442\u043a\u0438 \u043d\u0430
