  achievementsRu: "\u0415\u0441\u043b\u0438 \u0436\u0438\u0437\u043d\u044c \u0413\u0430\u0443\u0441\u0441\u0430
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0441\u0430\u043c\u043e\u0443\u0447\u043a\u0438, \u043f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0435\u0433\u043e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435, \u0442\u043e \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u2014 \u044d\u0442\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442, \u043d\u0430
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0441\u0442\u043e\u0438\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0442\u043e\u0447\u043d\u0430\u044f \u043d\u0430\u0443\u043a\u0430. \u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0413\u0430\u0443\u0441\u0441\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438; \u043e\u043d \u043a\u0430\u0436\u0434\u044b\u0439
    \u0440\u0430\u0437 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u043b \u043d\u043e\u0432\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442
    \u0434\u043b\u044f \u0438\u0445 \u0440\u0435\u0448\u0435\u043d\u0438\u044f. \u0427\u0442\u043e\u0431\u044b
    \u043e\u0445\u0432\u0430\u0442\u0438\u0442\u044c \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e, \u0440\u0430\u0437\u043e\u0431\u044c\u0435\u043c
    \u0435\u0433\u043e \u043d\u0430 \u043f\u044f\u0442\u044c \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0438\u0445
    \u0431\u043b\u043e\u043a\u043e\u0432: \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b,
    \u0410\u043b\u0433\u0435\u0431\u0440\u0430 \u0438 \u0430\u043d\u0430\u043b\u0438\u0437,
    \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f, \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f
    \u0438 \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u044f, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0424\u0438\u0437\u0438\u043a\u0430. \u041d\u0438\u0436\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d
    \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0441 \u043f\u043e\u044f\u0441\u043d\u0435\u043d\u0438\u044f\u043c\u0438 \u0438\u0445 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0441\u0442\u0438.
    1. \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b (\u00ab\u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb) \u0413\u0430\u0443\u0441\u0441
    \u0441\u0447\u0438\u0442\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b
    \u00ab\u0446\u0430\u0440\u0438\u0446\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb.
    \u0415\u0433\u043e \u0442\u0440\u0443\u0434 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u00bb (1801) \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u043e\u0442,
    \u0441\u0440\u0430\u0432\u043d\u0438\u043c\u044b\u0439 \u0441 \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u043c\u0438\u00bb
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430. \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430
    \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 (Modular arithmetic): \u0413\u0430\u0443\u0441\u0441
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0432\u0432\u0435\u043b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e
    \u0437\u0430\u043f\u0438\u0441\u044c \u0434\u043b\u044f \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043f\u043e \u043c\u043e\u0434\u0443\u043b\u044e (\\( a \\equiv b \\pmod{m} \\)). \u042d\u0442\u043e
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u043e \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u043e \u0434\u0435\u043b\u0438\u043c\u043e\u0441\u0442\u0438
    \u0432 \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0435\u0439\u0447\u0430\u0441
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445 \u043d\u0430\u0443\u043a.
    \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u0437\u0430\u043a\u043e\u043d
    \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438: \u0413\u0430\u0443\u0441\u0441
    \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u044d\u0442\u043e\u0439
    \u00ab\u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b\u00bb
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b (\u0440\u0430\u043d\u0435\u0435
    \u0435\u0451 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u042d\u0439\u043b\u0435\u0440, \u0430 \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c). \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b
    \u0442\u0430\u043a \u043f\u043e\u0440\u0430\u0436\u0435\u043d \u043a\u0440\u0430\u0441\u043e\u0442\u043e\u0439
    \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u0447\u0442\u043e
    \u0437\u0430 \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c \u043d\u0430\u0448\u0435\u043b
    \u0448\u0435\u0441\u0442\u044c \u0440\u0430\u0437\u043d\u044b\u0445 \u0435\u0451 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432,
    \u043a\u0430\u0436\u0434\u043e\u0435 \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u043b\u043e \u043d\u043e\u0432\u044b\u0435 \u0432\u0435\u0442\u0432\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0431\u0438\u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0445 \u0432\u044b\u0447\u0435\u0442\u043e\u0432:
    \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b, \u043d\u043e \u0438
    \u043e\u0442\u043a\u0440\u044b\u043b \u043f\u0443\u0442\u044c \u043a \u0430\u043b\u0433\u0435\u0431\u0440\u0435
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    (\u0433\u0430\u0443\u0441\u0441\u043e\u0432\u044b \u0446\u0435\u043b\u044b\u0435 \u0447\u0438\u0441\u043b\u0430
    \\( a + bi \\)), \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u0437\u0434\u0430\u0432
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u043a\u043e\u043b\u0435\u0446.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445: \u0425\u043e\u0442\u044f \u043e\u043d \u043d\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0435\u0451 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    (\u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u043f\u043e\u0437\u0436\u0435
    \u0427\u0435\u0431\u044b\u0448\u0451\u0432 \u0438 \u0410\u0434\u0430\u043c\u0430\u0440),
    \u0413\u0430\u0443\u0441\u0441 \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u044b\u0432\u0435\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b (\\( \\pi(x) \\sim
    x / \\ln x \\)) \u0438 \u0443\u043a\u0430\u0437\u0430\u043b \u043f\u0443\u0442\u0438 \u043a
    \u0435\u0451 \u0441\u0442\u0440\u043e\u0433\u043e\u043c\u0443 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044e.
    --- 2. \u0410\u043b\u0433\u0435\u0431\u0440\u0430 \u0438 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0417\u0434\u0435\u0441\u044c \u0413\u0430\u0443\u0441\u0441
    \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b \u043a\u0430\u043a \u00ab\u0445\u0438\u0440\u0443\u0440\u0433\u00bb
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0443\u0441\u0442\u0440\u0430\u043d\u044f\u044f
    \u043d\u0435\u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438, \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u043d\u044b\u0435
    \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u0438 \u042d\u0439\u043b\u0435\u0440\u0430. \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u044b: \u0412
    \u0441\u0432\u043e\u0435\u0439 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 (1799) \u0413\u0430\u0443\u0441\u0441
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0438\u043c\u0435\u0435\u0442 \u0445\u043e\u0442\u044f \u0431\u044b \u043e\u0434\u0438\u043d
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0439 \u043a\u043e\u0440\u0435\u043d\u044c.
    \u042d\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e
    \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u043c, \u043d\u043e \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043d\u0435
    \u0431\u044b\u043b\u043e. \u0413\u0430\u0443\u0441\u0441 \u0434\u0430\u043b \u0447\u0435\u0442\u044b\u0440\u0435
    \u0440\u0430\u0437\u043d\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u0436\u0438\u0437\u043d\u0438,
    \u043f\u0440\u0438\u0447\u0435\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435
    \u0431\u044b\u043b\u043e \u0447\u0438\u0441\u0442\u043e \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438 \u043d\u0435 \u043e\u043f\u0438\u0440\u0430\u043b\u043e\u0441\u044c \u043d\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e. \u041c\u0435\u0442\u043e\u0434 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432: \u0425\u043e\u0442\u044f \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u044d\u0442\u043e\u0442
    \u043c\u0435\u0442\u043e\u0434 \u043f\u0435\u0440\u0432\u044b\u043c, \u0413\u0430\u0443\u0441\u0441
    \u0437\u0430\u044f\u0432\u0438\u043b \u043e \u0441\u0432\u043e\u0435\u043c \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435
    (\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0435\u0449\u0435 \u0432 1794 \u0433\u043e\u0434\u0443). \u0421\u0443\u0442\u044c:
    \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0430\u0438\u043b\u0443\u0447\u0448\u0438\u0445
    \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432 \u043c\u043e\u0434\u0435\u043b\u0438
    \u043d\u0443\u0436\u043d\u043e \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0441\u0443\u043c\u043c\u0443 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432 \u043e\u0448\u0438\u0431\u043e\u043a.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0437\u043e\u043b\u043e\u0442\u044b\u043c
    \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043e\u043c \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438,
    \u044d\u043a\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u043a\u0438 \u0438 \u043c\u0430\u0448\u0438\u043d\u043d\u043e\u0433\u043e
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0424\u0443\u0440\u044c\u0435 (\u0411\u041f\u0424): \u0417\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432
    \u0413\u0430\u0443\u0441\u0441 \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0434\u043b\u044f \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0440\u044f\u0434\u043e\u0432
    \u0424\u0443\u0440\u044c\u0435. \u042d\u0442\u043e\u0442 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0431\u044b\u043b \u043f\u0435\u0440\u0435\u043e\u0442\u043a\u0440\u044b\u0442 \u0432 XX
    \u0432\u0435\u043a\u0435 \u041a\u0443\u043b\u0438 \u0438 \u0422\u044c\u044e\u043a\u0438
    \u0438 \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439
    \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432
    (\u0441\u0436\u0430\u0442\u0438\u0435 JPEG, MP3, \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u0441\u0432\u044f\u0437\u044c).
    \u0413\u0438\u043f\u0435\u0440\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0440\u044f\u0434: \u0413\u0430\u0443\u0441\u0441 \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u044d\u0442\u043e\u0442 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439
    \u0440\u044f\u0434 (\\( {}_2F_1 \\)), \u0441\u043e\u0437\u0434\u0430\u0432 \u0442\u0435\u043e\u0440\u0438\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b\u0430
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0432 \u0435\u0434\u0438\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443.
    --- 3. \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f (\u041e\u0442 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u043a \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u044b\u043c \u043c\u0438\u0440\u0430\u043c
    \u0438 \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0435) \u042d\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0434\u0435\u043b\u0430\u043b\u043e \u0413\u0430\u0443\u0441\u0441\u0430 \u043f\u0440\u0435\u0434\u0442\u0435\u0447\u0435\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438 XX \u0432\u0435\u043a\u0430 (\u041e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438).
    \u041f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0433\u043e
    17-\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430: \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u044e\u043d\u043e\u0433\u043e \u0413\u0430\u0443\u0441\u0441\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u043e, \u0447\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0435
    \\( n \\)-\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0438 \u043c\u043e\u0436\u043d\u043e
    \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0446\u0438\u0440\u043a\u0443\u043b\u0435\u043c
    \u0438 \u043b\u0438\u043d\u0435\u0439\u043a\u043e\u0439, \u0435\u0441\u043b\u0438 \\( n
    \\) \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0447\u0438\u0441\u043b\u043e\u043c
    \u0424\u0435\u0440\u043c\u0430. \u042d\u0442\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0440\u0435\u0448\u0438\u043b\u043e \u0432\u043e\u043f\u0440\u043e\u0441, \u043c\u0443\u0447\u0438\u0432\u0448\u0438\u0439
    \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u00ab\u0412\u044b\u0434\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u00bb
    (Theorema Egregium): \u0412 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445
    (1827) \u0413\u0430\u0443\u0441\u0441 \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u0433\u0430\u0443\u0441\u0441\u043e\u0432\u0430 \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0430
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0435\u0451 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u043c \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e\u043c
    \u0438 \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438
    \u0438\u0437\u0433\u0438\u0431\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0435\u0441\u043b\u0438 \u0441\u0432\u0435\u0440\u043d\u0443\u0442\u044c \u043b\u0438\u0441\u0442
    \u0431\u0443\u043c\u0430\u0433\u0438 \u0432 \u0446\u0438\u043b\u0438\u043d\u0434\u0440,
    \u0443\u0433\u043b\u044b \u0438 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u043f\u043e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f
    \u043f\u0440\u0435\u0436\u043d\u0438\u043c\u0438, \u043d\u043e \u0435\u0441\u043b\u0438
    \u0441\u043e\u0433\u043d\u0443\u0442\u044c \u0441\u0444\u0435\u0440\u0443 \u2014 \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f).
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u0413\u0430\u0443\u0441\u0441 \u043f\u0440\u0438\u0448\u0435\u043b
    \u043a \u0438\u0434\u0435\u0435, \u0447\u0442\u043e \u0447\u0435\u0440\u0435\u0437 \u0442\u043e\u0447\u043a\u0443
    \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u043c\u043d\u043e\u0433\u043e \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u044f\u043c\u044b\u0445, \u0438 \u0434\u0430\u0436\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u043b
    \u0443\u0433\u043b\u044b \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430
    \u0432 \u0433\u043e\u0440\u0430\u0445, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c,
    \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u043e \u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u041e\u043d \u0431\u043e\u044f\u043b\u0441\u044f
    \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u043e, \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c
    \u00ab\u043a\u0440\u0438\u043a\u0430 \u0431\u0435\u043e\u0442\u0438\u0439\u0446\u0435\u0432\u00bb
    (\u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u043e\u0432), \u043d\u043e
    \u0438\u043c\u0435\u043d\u043d\u043e \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b\u0438
    \u043f\u043e\u0447\u0432\u0443 \u0434\u043b\u044f \u0420\u0438\u043c\u0430\u043d\u0430 \u0438,
    \u0447\u0435\u0440\u0435\u0437 60 \u043b\u0435\u0442, \u0434\u043b\u044f \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430.
    \u0413\u0430\u0443\u0441\u0441\u043e\u0432\u0430 \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0430
    \u0438 \u043f\u0435\u0440\u0432\u0430\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u0430\u044f
    \u0444\u043e\u0440\u043c\u0430: \u0412\u0432\u0435\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u044b
    \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u0434\u043b\u0438\u043d
    \u0438 \u0443\u0433\u043b\u043e\u0432 \u043d\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445,
    \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430-\u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    --- 4. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f \u0438 \u0413\u0435\u043e\u0434\u0435\u0437\u0438\u044f
    (\u0422\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u0434\u043e \u043c\u0438\u043b\u043b\u0438\u043c\u0435\u0442\u0440\u0430)
    \u0413\u0430\u0443\u0441\u0441 \u043f\u0440\u0438\u0432\u043d\u0435\u0441 \u0432 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043d\u0430\u0443\u043a\u0438 \u043c\u0435\u0442\u043e\u0434\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438. \u0420\u0430\u0441\u0447\u0435\u0442
    \u043e\u0440\u0431\u0438\u0442\u044b \u0426\u0435\u0440\u0435\u0440\u044b (1801): \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u00ab\u0437\u0432\u0435\u0437\u0434\u043d\u044b\u0439
    \u0447\u0430\u0441\u00bb. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043c\u0435\u0442\u043e\u0434
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432
    \u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u0442\u0435\u0445\u043d\u0438\u043a\u0443
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u0447\u0435\u043d\u0438\u0439 \u043f\u043e \u0442\u0440\u0435\u043c \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f\u043c,
    \u043e\u043d \u0441 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u0430\u0448\u0435\u043b \u043f\u043e\u0442\u0435\u0440\u044f\u043d\u043d\u0443\u044e
    \u043a\u0430\u0440\u043b\u0438\u043a\u043e\u0432\u0443\u044e \u043f\u043b\u0430\u043d\u0435\u0442\u0443.
    \u042d\u0442\u043e \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u043c\u043e\u0449\u044c \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0445
    \u0442\u0435\u043b (1809): \u041c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u0433\u0434\u0435 \u043e\u043d \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043b,
    \u043a\u0430\u043a \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0432\u043e\u0437\u043c\u0443\u0449\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442 (\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u042e\u043f\u0438\u0442\u0435\u0440\u0430 \u0438
    \u0421\u0430\u0442\u0443\u0440\u043d\u0430). \u0424\u043e\u0440\u043c\u0443\u043b\u044b
    \u0413\u0430\u0443\u0441\u0441\u0430 \u0434\u043b\u044f \u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430\u043c\u0438 \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440. \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0441\u043a\u0430\u044f
    \u0442\u0440\u0438\u0430\u043d\u0433\u0443\u043b\u044f\u0446\u0438\u044f (1818\u20131832):
    \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u044f \u0441\u044a\u0435\u043c\u043a\u043e\u0439
    \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438, \u0413\u0430\u0443\u0441\u0441
    \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0433\u0435\u043b\u0438\u043e\u0442\u0440\u043e\u043f
    (\u043f\u0440\u0438\u0431\u043e\u0440, \u043e\u0442\u0440\u0430\u0436\u0430\u044e\u0449\u0438\u0439
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0439 \u0441\u0432\u0435\u0442 \u043d\u0430
    \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0434\u043e 100 \u043a\u043c
    \u0434\u043b\u044f \u0441\u0432\u0435\u0440\u0445\u0442\u043e\u0447\u043d\u043e\u0439 \u0444\u0438\u043a\u0441\u0430\u0446\u0438\u0438
    \u0442\u043e\u0447\u0435\u043a). \u0427\u0442\u043e\u0431\u044b \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u043c\u0430\u0441\u0441\u0438\u0432\u044b
    \u0434\u0430\u043d\u043d\u044b\u0445, \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043d\u043e\u0432\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    \u041a\u0430\u0440\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438: \u0412\u043f\u0435\u0440\u0432\u044b\u0435
    \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438
    \u0417\u0435\u043c\u043b\u0438 \u043d\u0430 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u044c,
    \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u044f \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u0438\u044f
    \u0443\u0433\u043b\u043e\u0432 (\u043a\u043e\u043d\u0444\u043e\u0440\u043c\u043d\u0430\u044f
    \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u044f \u0413\u0430\u0443\u0441\u0441\u0430 \u2014
    \u041a\u0440\u044e\u0433\u0435\u0440\u0430), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u0442\u043e\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0430\u0440\u0442\u0430\u0445 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440.
    --- 5. \u0424\u0438\u0437\u0438\u043a\u0430 \u0438 \u041c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c
    (\u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u0442\u043e\u0440
    \u0438 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a) \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    20 \u043b\u0435\u0442 \u0436\u0438\u0437\u043d\u0438 \u0413\u0430\u0443\u0441\u0441 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0442\u043e\u0448\u0435\u043b \u043e\u0442 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u0442\u043e\u0447\u043d\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u043e\u0439.
    \u0417\u0430\u043a\u043e\u043d \u0413\u0430\u0443\u0441\u0441\u0430 (\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0430):
    \u041e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0437\u0430\u043a\u043e\u043d, \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439
    \u043f\u043e\u0442\u043e\u043a \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u043b\u044f \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u0443\u044e
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0441 \u0437\u0430\u0440\u044f\u0434\u043e\u043c
    \u0432\u043d\u0443\u0442\u0440\u0438. \u042d\u0442\u043e \u043e\u0434\u043d\u043e \u0438\u0437
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u041c\u0430\u043a\u0441\u0432\u0435\u043b\u043b\u0430, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0438\u0445
    \u0432\u0441\u0451 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0438 \u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c. (\u041d\u0430 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435 \u044d\u0442\u043e \u0447\u0430\u0441\u0442\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u041e\u0441\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e-\u0413\u0430\u0443\u0441\u0441\u0430).
    \u0415\u0434\u0438\u043d\u0438\u0446\u044b \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f:
    \u0412\u0432\u0435\u043b \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0435\u0434\u0438\u043d\u0438\u0446. \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0438\u0437\u043c\u0435\u0440\u044f\u0442\u044c \u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e\u0435
    \u043f\u043e\u043b\u0435 \u0432 \u0435\u0434\u0438\u043d\u0438\u0446\u0430\u0445 \u0413\u0430\u0443\u0441\u0441
    (\u0413\u0441) (\u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0421\u0413\u0421). \u041f\u0435\u0440\u0432\u044b\u0439
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0438\u0442\u043d\u044b\u0439
    \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u0444 (1833): \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0412\u0435\u0431\u0435\u0440\u043e\u043c \u0413\u0430\u0443\u0441\u0441 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u043f\u0435\u0440\u0432\u0443\u044e \u0432 \u043c\u0438\u0440\u0435 \u043b\u0438\u043d\u0438\u044e
    \u0441\u0432\u044f\u0437\u0438 \u0434\u043b\u0438\u043d\u043e\u0439 \u043e\u043a\u043e\u043b\u043e
    1,5 \u043a\u043c \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438
    \u0431\u0438\u043d\u0430\u0440\u043d\u044b\u0439 \u043a\u043e\u0434, \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u043d\u044b\u0439
    \u0441\u0430\u043c\u0438\u043c \u0413\u0430\u0443\u0441\u0441\u043e\u043c (\u0437\u0430
    5 \u043b\u0435\u0442 \u0434\u043e \u0430\u0437\u0431\u0443\u043a\u0438 \u041c\u043e\u0440\u0437\u0435).
    \u041c\u0430\u0433\u043d\u0438\u0442\u043d\u0430\u044f \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044f:
    \u0413\u0430\u0443\u0441\u0441 \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0441\u0435\u0442\u044c
    \u0441\u0442\u0430\u043d\u0446\u0438\u0439 \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0437\u0430 \u043c\u0430\u0433\u043d\u0438\u0442\u043d\u044b\u043c\u0438
    \u0431\u0443\u0440\u044f\u043c\u0438 (\u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0412\u0435\u0431\u0435\u0440\u043e\u043c).
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e,
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0443\u044e \u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e\u0435
    \u043f\u043e\u043b\u0435 \u0417\u0435\u043c\u043b\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    (\u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437).
    \u041e\u043f\u0442\u0438\u043a\u0430: \u0417\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u043f\u0442\u0438\u043a\u043e\u0439,
    \u0432\u044b\u0432\u0435\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0434\u043b\u044f
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043e\u0432
    (\u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u043e\u0432),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u044e\u0442
    \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0438 \u0445\u0440\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0430\u0431\u0435\u0440\u0440\u0430\u0446\u0438\u0438. --- 6. \u00ab\u0413\u0430\u0443\u0441\u0441\u043e\u0432\u044b
    \u0448\u0442\u0443\u043a\u0438\u00bb: \u0411\u0440\u0435\u043d\u0434\u044b \u0433\u0435\u043d\u0438\u044f
    \u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432 \u043a\u0430\u0436\u0434\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u0438 \u0435\u0441\u0442\u044c
    \u043e\u0431\u044a\u0435\u043a\u0442, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0439
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c. \u0412\u043e\u0442 \u043f\u0435\u0440\u0435\u0447\u0435\u043d\u044c
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u00ab\u0431\u0440\u0435\u043d\u0434\u043e\u0432\u00bb,
    \u043f\u043e\u043c\u0438\u043c\u043e \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e:
    \u0420\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0413\u0430\u0443\u0441\u0441\u0430
    (\u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435):
    \u00ab\u041a\u043e\u043b\u043e\u043a\u043e\u043b\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u0430\u044f
    \u043a\u0440\u0438\u0432\u0430\u044f\u00bb, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0430\u044f
    \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0445
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d. \u041a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0439
    \u043a\u0430\u043c\u0435\u043d\u044c \u0432\u0441\u0435\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438.
    \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u0413\u0430\u0443\u0441\u0441\u0430: \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b \\( \\int_{-\\infty}^{\\infty} e^{-x^2}
    dx = \\sqrt{\\pi} \\), \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0449\u0438\u0439\u0441\u044f
    \u0432 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435.
    \u041c\u0430\u0442\u0440\u0438\u0446\u0430 \u0413\u0430\u0443\u0441\u0441\u0430: \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0432 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041c\u0435\u0442\u043e\u0434
    \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0413\u0430\u0443\u0441\u0441\u0430
    (\u0413\u0430\u0443\u0441\u0441\u043e\u0432\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435):
    \u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0438\u0437\u0443\u0447\u0430\u0435\u043c\u044b\u0439
    \u0432 \u0448\u043a\u043e\u043b\u0430\u0445 \u0438 \u0432\u0443\u0437\u0430\u0445. \u0421\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u0435
    \u0413\u0430\u0443\u0441\u0441\u0430: \u0422\u0435\u0445\u043d\u0438\u043a\u0430 \u0440\u0430\u0437\u043c\u044b\u0442\u0438\u044f
    \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u0432 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439
    \u0433\u0440\u0430\u0444\u0438\u043a\u0435. --- \u0418\u0442\u043e\u0433: \u041f\u043e\u0447\u0435\u043c\u0443
    \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d?
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u0438\u043b\u0438 \u042d\u0439\u043b\u0435\u0440\u0430, \u0413\u0430\u0443\u0441\u0441
    \u0431\u044b\u043b \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u043c \u043f\u0435\u0440\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u043e\u043c.
    \u041e\u043d \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438.
    \u041e\u043d \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043b\u0438\u0448\u044c
    \u0442\u0435 \u0440\u0430\u0431\u043e\u0442\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0434\u043e\u0432\u0435\u043b \u043a\u0430\u0436\u0434\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0434\u043e \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0439 \u044f\u0441\u043d\u043e\u0441\u0442\u0438.
    \u0418\u043d\u043e\u0433\u0434\u0430 \u0448\u0443\u0442\u044f\u0442, \u0447\u0442\u043e
    \u00ab\u0435\u0441\u043b\u0438 \u0432 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0435
    \u0413\u0430\u0443\u0441\u0441\u0430 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442\u0441\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f, \u0437\u043d\u0430\u0447\u0438\u0442,
    \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b \u0438\u0445 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430,
    \u0441\u0442\u0435\u0440 \u0432\u0441\u0435 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b\u0435
    \u0432\u044b\u043a\u043b\u0430\u0434\u043a\u0438 \u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0430\u043c\u044b\u0439 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0439
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u00bb. \u0418\u0437-\u0437\u0430
    \u044d\u0442\u043e\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u0447\u0430\u0441\u0442\u043e \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u043b\u0438,
    \u043a\u0430\u043a \u043e\u043d \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0441\u0432\u043e\u0438\u043c
    \u0432\u044b\u0432\u043e\u0434\u0430\u043c (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0449\u0435 \u043d\u0438\u043a\u0442\u043e
    \u043d\u0435 \u0437\u043d\u0430\u043b). \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u2014 \u044d\u0442\u043e \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f. \u042d\u0442\u043e
    \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f \u043d\u0430\u0443\u043a\u0438:
    \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u043a\u0430\u043a \u0441\u0432\u044f\u0437\u0430\u0442\u044c
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u0443\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0443
    \u0441 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f\u043c\u0438, \u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u2014 \u0441 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u043c \u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c\u043e\u043c
    \u0417\u0435\u043c\u043b\u0438. \u0411\u0435\u0437 \u0413\u0430\u0443\u0441\u0441\u0430
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b \u043d\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u043a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u044f, \u043d\u0438 \u0433\u0435\u043e\u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b (\u0413\u0418\u0421/\u043d\u0430\u0432\u0438\u0433\u0430\u0442\u043e\u0440\u044b),
    \u043d\u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0435."
  achievementsEn: "If the life of Gaussa is the story of a recognized genius, his scientific heritage is the foundation upon which modern, accurate science is based; the uniqueness of Gauss is that he has not merely solved difficult problems; he has every time invented a new mathematical tool to deal with them.To cover its contribution in a systematic way, we will break it into five giant blocks: Theory of Numbers, Algebra and Analysis, Geometry, Astronomia and Geodesy, and Physics, followed by a detailed list of key achievements, with explanations of their revolutionaryness. 1. The Theory of Numbers (King of Mathematics) Gauss considered the number theory to be \"the king of mathematics.\" His work \"Arifmetic Research\" (1801) has made a coup in this area, comparable to Euclid's \"Starters\".The Arifmetics of Comparisons (Modular aristmetic): Gauss has systematized and introduced a modern record for the Mode Comparisons (\\(a \\equiv b \\pmod\\m}). This has turned the fragmented facts about division into a strict algebraic theory that now underlies cryptography and computer science.Quadrant law of reciprocity: Gauss gave the first strict proof of this \"golden theorem\" of number theory (previously formulated by Eiler and tried to prove it) and Gauss was so impressed by the beauty of this theorem that he found six different pieces of evidence in his life, each of which opened up new branches of mathematics.The theory of biquadratic subtractions: In this work, he not only advanced the number theory but also opened the way to algebra of complex numbers (haussows whole numbers \\(a + bi )), actually creating the basis of ring theory. The theory of prime numbers: Although he did not prove it completely (after Chebeshev and Adamar), Gauss empirically produced the formula for the distribution of prime numbers (\\\\\\\\pi(x) \\sim x / \\ln x\\) and pointed the way to its strict justification. --2-2.Algebra and Mathematical Analysis here, Gauss acted as a math surgeon, removing the incoherences accumulated since Newton and Eulera. The main algebra theorem: In his Ph.D. (1799), Gauss proved that any algebra equation has at least one complex root, which seemed intuitively understandable, but there was no hard evidence.Gauss gave four different evidences over the course of his life, the latter being purely analytical and not based on geometry. The method of least squares: although Lejandr published this method first, Gauss stated his priority (and proved that he had used it since 1794) The point is that in order to find the best parameters of the model, the sum of the squares of errors must be minimized.This has become a gold standard for statistics, econometrics and machine learning: The Rapid Transformation Algorithm of Furier (BPF): Long before computers were available, Gauss invented an algorithm for the rapid calculation of the Fourier series coefficients. This algorithm was re-opened in the 20th century by Cooley and Tuki and became the basis for digital signal processing (JPEG, MP3, Internet connection).Hyper geometrical row: Gauss has studied this endless series (\\\\\\\\\\\\\\\\\\2F_1\\) creating a theory that brought together many elementary functions into a common system. --3. Geometry (from Euclid to non-euclidian worlds and crookedness) This direction has made Gaussa predispose physics of the twentieth century (the general theory of relativity).The construction of the right 17-gon: The discovery of the young Gauss, which proved that the right \\(n\\)-columns can be built by a circulatory and a ruler if \\(n\\) is the number of Farms. This has finally solved the issue of the ancient mathematicians.Theorema Egregium: In its work on surfaces (1827), Gauss proved that the Gaussian curvature of the surface is its internal properties and does not change at bend (e.g., if a sheet of paper is folded into a cylinder, the angles and distances on the surface remain the same, but if a sphere is curved, it changes).Nevclide Geometry: Gauss came to the idea that through a dot you could do infinitely many parallel lines, and even figured out the angles of a huge triangle in the mountains to see if the universe was curved. He was afraid to publish it, fearing the \"cry of the Beotians\" (conservatives), but it was his ideas that prepared the ground for Roman and, 60 years later, for Einstein.Gaussian crooked and first quadratic form: introduced formulas for measuring length and angles on random curved surfaces, which is a direct mathematical tool for describing space-time. --4. Astronomy and Geodemia (Total to a millimeter) Gauss introduced mathematical statistics into observational sciences. Calculation of the orbit of the Ceres (1801): its main \"star hour\".Using the method of least squares and special techniques for calculating conical sections from three observations, he found the lost dwarf planet with remarkable accuracy, which demonstrated the power of applied mathematics. The theory of the movement of celestial bodies (1809): Monography, where he described in detail how to take account of the outrages of planets (the gravitational influence of Jupiter and Saturn).The Gaussa formulas for orbital elements are still being used by astronomers. The Hanover triangulation (1818-1832): In directing the survey, Gauss invented the heliotropic (a device that reflects sunlight up to 100 km for super-tube point fixation). In order to process vast data sets, he created new techniques for solving equation systems.Cartographic projections: First met the challenge of displaying the curved surface of the Earth on a plane, minimizing the distortion of angles (the conform projection of Gauss-Kruger) that is still used in topography maps. --5. Physics and Magnetism (Experimentator and Theoretician) has almost moved away from pure mathematics in the last 20 years of Gauss' life and has engaged in exact physics.The Law of Gauss (Electrostatica): He has formulated a fundamental law linking the flow of the electric field through the enclosed surface with the charge within it. This is one of the four equations of McSwell describing all electricity and magnetism. (In fact, this is a private case of the Theorem of Ostrobgrad-Gauss). Units of measurement: Introduction of absolute systems of units. Proposed measurement of the magnetic field in the units of Gauss (Gs) (in the GHS).The first electromagnetic telegraph (1833) was built by Webber Gauss, the world's first line of communication about 1.5 km long in Göttingen, and it is interesting that they used the binary code invented by Gausse himself (5 years before Morse code).He developed a theory describing the Earth &apos; s magnetic field using spherical functions (harmonic analysis).Othtics: Did geometric optics, produced formulas for complex lens (including telescopes) that minimize spherical and chromatical aberrations. ------6. Gaussovs of the thing: The genius brands of almost every field of science have an object named by his name.Here's a list of the most important \"brends\" other than the list listed: The distribution of the Gaussa: \"The ring curve\" describing the distribution of random values. The cornerstone of all statistics. The integrated Gauss: The famous integral \\\\\\\\\\\\int_-infty}\\\\\\\\\\\\\\\\\\-xfty}x = \\sqrt{\\pi}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\The method of excluding Gauss (Gausso exception): The standard method of solving linear equation systems, studied in schools and universities. The smoothing of Gauss: The image-smart technology in computer graphics. ---Achieve: Why is his contribution unique? Unlike Newton or Eyler, Gauss was an absolute performanceist. He did not publish drafts. He only published works that brought every theorem to elegant clarity.Sometimes jokes are that \"if a job by Gauss mentions calculations, then he's done them three times, erased all the intermediates and left only the most beautiful result.\" Because of this, moderns often failed to understand how he came to his conclusions (for example, he used elliptical functions that no one has ever known existed). His scientific heritage is not just discoveries.It's a science methodology: it showed how to link abstract algebra to astronomical observations, and the geometry of curved spaces to the real magnetism of the Earth. Without Gauss, neither modern cosmology nor geoinformation systems (GIS/navigations) nor big data are possible."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041a\u0430\u0440\u043b\u0430
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 \u0413\u0430\u0443\u0441\u0441\u0430 \u2014
    \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f
    \u0441 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u044f\u0441\u043d\u043e\u0441\u0442\u044c\u044e
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b. \u0415\u0441\u043b\u0438 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u2014 \u044d\u0442\u043e \u0442\u043e\u0440\u0436\u0435\u0441\u0442\u0432\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430, \u0442\u043e \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0437\u043c\u0430,
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0439, \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u0432 \u0438 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0445
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432. \u0413\u0430\u0443\u0441\u0441
    \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c,
    \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e \u0441\u0434\u0435\u0440\u0436\u0430\u043d\u043d\u044b\u043c
    \u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0435, \u043d\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0440\u0430\u043d\u0438\u043c\u044b\u043c \u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u044b\u043c
    \u0432 \u043b\u0438\u0447\u043d\u044b\u0445 \u043f\u0438\u0441\u044c\u043c\u0430\u0445.
    \u0427\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043f\u043e\u043b\u043d\u0443\u044e \u043a\u0430\u0440\u0442\u0438\u043d\u0443, \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043c
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c \u043f\u043e
    \u043f\u0435\u0440\u0438\u043e\u0434\u0430\u043c: \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f\u043c\u0438,
    \u043f\u0435\u0440\u0432\u0430\u044f \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u0432\u044c
    \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0431\u0440\u0430\u043a,
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0431\u0440\u0430\u043a \u043f\u043e \u0440\u0430\u0441\u0447\u0435\u0442\u0443,
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0435\u0442\u044c\u043c\u0438
    \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0432 \u0431\u044b\u0442\u0443.
    --- 1. \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e:
    \u0425\u043e\u043b\u043e\u0434\u043d\u044b\u0439 \u043e\u0442\u0435\u0446 \u0438 \u043b\u044e\u0431\u044f\u0449\u0430\u044f
    \u043c\u0430\u0442\u044c \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0413\u0430\u0443\u0441\u0441\u0430
    \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u0441\u044f \u043f\u043e\u0434
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u043f\u043e\u043b\u044f\u0440\u043d\u043e
    \u0440\u0430\u0437\u043d\u044b\u0445 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439.
    \u041e\u0442\u0435\u0446, \u0413\u0435\u0431\u0445\u0430\u0440\u0434 \u0414\u0438\u0442\u0440\u0438\u0445
    \u0413\u0430\u0443\u0441\u0441 (1744\u20131808): \u0411\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441\u0443\u0440\u043e\u0432\u044b\u043c, \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u044b\u043c
    \u0438 \u043d\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u043c.
    \u0420\u0430\u0431\u043e\u0442\u0430\u043b \u0432\u043e\u0434\u043e\u043f\u0440\u043e\u0432\u043e\u0434\u0447\u0438\u043a\u043e\u043c,
    \u0441\u0430\u0434\u043e\u0432\u043d\u0438\u043a\u043e\u043c, \u043c\u044f\u0441\u043d\u0438\u043a\u043e\u043c,
    \u043a\u0430\u043c\u0435\u043d\u0449\u0438\u043a\u043e\u043c. \u041e\u043d \u0431\u044b\u043b
    \u043f\u0435\u0440\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u043e\u043c
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435, \u043d\u043e \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0446\u0430\u0440\u0438\u043b\u0430 \u0436\u0435\u043b\u0435\u0437\u043d\u0430\u044f \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430.
    \u041e\u0442\u0435\u0446 \u0441\u043a\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044e
    \u0441\u044b\u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439,
    \u0441\u0447\u0438\u0442\u0430\u044f, \u0447\u0442\u043e \u0442\u043e\u043c\u0443 \u043b\u0443\u0447\u0448\u0435
    \u043e\u0441\u0432\u043e\u0438\u0442\u044c \u0440\u0435\u043c\u0435\u0441\u043b\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442 \u0434\u0435\u043d\u044c\u0433\u0438. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u0413\u0435\u0431\u0445\u0430\u0440\u0434 \u0437\u0430\u043f\u0440\u0435\u0449\u0430\u043b
    \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u043c\u0443 \u041a\u0430\u0440\u043b\u0443
    \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0430 \u0441\u0432\u043e\u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u044b,
    \u043d\u043e \u043c\u0430\u043b\u044c\u0447\u0438\u043a \u0442\u0430\u0439\u043a\u043e\u043c
    \u043f\u043e\u0434\u0433\u043b\u044f\u0434\u044b\u0432\u0430\u043b \u0438 \u043f\u043e\u043f\u0440\u0430\u0432\u043b\u044f\u043b
    \u043e\u0448\u0438\u0431\u043a\u0438 \u043e\u0442\u0446\u0430 \u0432 \u0441\u0447\u0435\u0442\u0430\u0445.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u043d\u0430\u0442\u044f\u043d\u0443\u0442\u044b\u043c\u0438:
    \u0413\u0430\u0443\u0441\u0441 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b
    \u043e\u0431 \u043e\u0442\u0446\u0435 \u0441 \u0442\u0435\u043f\u043b\u043e\u0442\u043e\u0439,
    \u0430 \u043a\u043e\u0433\u0434\u0430 \u0442\u043e\u0442 \u0443\u043c\u0435\u0440 (\u0432
    1808 \u0433\u043e\u0434\u0443), \u0413\u0430\u0443\u0441\u0441 \u043d\u0435 \u043f\u043e\u0435\u0445\u0430\u043b
    \u043d\u0430 \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u044b, \u0441\u043e\u0441\u043b\u0430\u0432\u0448\u0438\u0441\u044c
    \u043d\u0430 \u0437\u0430\u043d\u044f\u0442\u043e\u0441\u0442\u044c (\u0445\u043e\u0442\u044f
    \u043f\u043e\u0437\u0436\u0435 \u0432 \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0436\u0435\u0441\u0442\u043e\u043a\u043e).
    \u041c\u0430\u0442\u044c, \u0414\u043e\u0440\u043e\u0442\u0435\u044f \u0411\u0435\u043d\u0446\u0435
    (1743\u20131839): \u0411\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u043e\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e
    \u043c\u0443\u0436\u0443. \u041f\u043e\u0447\u0442\u0438 \u043d\u0435\u0433\u0440\u0430\u043c\u043e\u0442\u043d\u0430\u044f
    (\u043d\u0435 \u0443\u043c\u0435\u043b\u0430 \u043f\u0438\u0441\u0430\u0442\u044c, \u0447\u0438\u0442\u0430\u043b\u0430
    \u0441 \u0442\u0440\u0443\u0434\u043e\u043c), \u043d\u043e \u043e\u0431\u043b\u0430\u0434\u0430\u043b\u0430
    \u0436\u0438\u0432\u044b\u043c \u0443\u043c\u043e\u043c, \u044e\u043c\u043e\u0440\u043e\u043c
    \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439.
    \u0418\u043c\u0435\u043d\u043d\u043e \u043e\u043d\u0430 \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b\u0430
    \u0433\u0435\u043d\u0438\u0439 \u0432 \u0441\u044b\u043d\u0435 \u0438 \u0434\u043e \u0441\u0430\u043c\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0439
    \u043e\u043f\u043e\u0440\u043e\u0439. \u0414\u043e\u0440\u043e\u0442\u0435\u044f \u0436\u0438\u043b\u0430
    \u0441 \u0413\u0430\u0443\u0441\u0441\u043e\u043c \u0434\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 (\u0443\u043c\u0435\u0440\u043b\u0430 \u0432
    96 \u043b\u0435\u0442). \u0413\u0430\u0443\u0441\u0441 \u043e\u0431\u043e\u0436\u0430\u043b
    \u043c\u0430\u0442\u044c; \u043e\u043d \u043d\u043e\u0441\u0438\u043b \u0435\u0451 \u043d\u0430
    \u0440\u0443\u043a\u0430\u0445 \u043f\u043e \u043a\u043e\u043c\u043d\u0430\u0442\u0435,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0430 \u0443\u0436\u0435 \u043d\u0435 \u043c\u043e\u0433\u043b\u0430
    \u0445\u043e\u0434\u0438\u0442\u044c, \u0438 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b
    \u043f\u043e\u0434 \u0435\u0451 \u0434\u0438\u043a\u0442\u043e\u0432\u043a\u0443 \u043f\u0438\u0441\u044c\u043c\u0430.
    \u041f\u043e\u0441\u043b\u0435 \u0435\u0451 \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \u00ab\u041c\u0438\u0440 \u043e\u043f\u0443\u0441\u0442\u0435\u043b
    \u0434\u043b\u044f \u043c\u0435\u043d\u044f\u00bb. --- 2. \u041f\u0435\u0440\u0432\u0430\u044f
    \u043b\u044e\u0431\u043e\u0432\u044c: \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u041e\u0441\u0442\u0445\u043e\u0444\u0444
    (\u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f 1809 \u0433\u043e\u0434\u0430) \u042d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u0441\u0430\u043c\u0430\u044f \u044f\u0440\u043a\u0430\u044f \u0438
    \u0441\u0430\u043c\u0430\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u0430\u044f
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438. \u0417\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e:
    \u0413\u0430\u0443\u0441\u0441 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0418\u043e\u0433\u0430\u043d\u043d\u043e\u0439 (\u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445 \u2014 \u0419\u043e\u0445\u0430\u043d\u043d\u0430)
    \u041e\u0441\u0442\u0445\u043e\u0444\u0444 \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435
    \u0432 \u043a\u043e\u043d\u0446\u0435 1790-\u0445 \u0433\u043e\u0434\u043e\u0432. \u041e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u043a\u043e\u0436\u0435\u0432\u043d\u0438\u043a\u0430,
    \u0438\u0437\u044f\u0449\u043d\u043e\u0439, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0438 \u0436\u0438\u0432\u043e\u0439 \u0434\u0435\u0432\u0443\u0448\u043a\u043e\u0439.
    \u0414\u043e\u043b\u0433\u0430\u044f \u043f\u043e\u043c\u043e\u043b\u0432\u043a\u0430: \u0418\u0437-\u0437\u0430
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0439 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0413\u0430\u0443\u0441\u0441\u0430 (\u043e\u043d \u0435\u0449\u0435 \u043d\u0435 \u0438\u043c\u0435\u043b
    \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b)
    \u043e\u043d\u0438 \u043d\u0435 \u043c\u043e\u0433\u043b\u0438 \u043f\u043e\u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f
    \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b. \u0413\u0430\u0443\u0441\u0441
    \u0431\u043e\u0433\u043e\u0442\u0432\u043e\u0440\u0438\u043b \u0418\u043e\u0433\u0430\u043d\u043d\u0443.
    \u0412 \u0435\u0433\u043e \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u044d\u0442\u043e\u0433\u043e
    \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u043e\u043d\u0430 \u0444\u0438\u0433\u0443\u0440\u0438\u0440\u0443\u0435\u0442
    \u043a\u0430\u043a \u00ab\u043c\u043e\u044f \u0437\u0432\u0435\u0437\u0434\u0430\u00bb \u0438
    \u00ab\u043c\u043e\u0435 \u0432\u0441\u0451\u00bb. \u041e\u043d \u043f\u0438\u0441\u0430\u043b:
    \u00ab\u0415\u0451 \u043b\u044e\u0431\u043e\u0432\u044c \u043d\u0430\u043f\u043e\u043b\u043d\u0438\u043b\u0430
    \u043c\u043e\u044e \u0436\u0438\u0437\u043d\u044c \u0441\u043c\u044b\u0441\u043b\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0435 \u043c\u043e\u0433\u043b\u0438
    \u0434\u0430\u0442\u044c \u0434\u0430\u0436\u0435 \u0441\u0430\u043c\u044b\u0435 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b\u00bb. \u0411\u0440\u0430\u043a: \u041e\u043d\u0438
    \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c 9 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1805 \u0433\u043e\u0434\u0430. \u042d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u0431\u044b\u043b
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c,
    \u0445\u043e\u0442\u044f \u0438 \u043d\u0435\u0434\u043e\u043b\u0433\u0438\u043c. \u0423
    \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0442\u0440\u043e\u0435
    \u0434\u0435\u0442\u0435\u0439: \u0418\u043e\u0441\u0438\u0444 (1806\u20131873) \u2014 \u043d\u0430\u0437\u0432\u0430\u043d
    \u0432 \u0447\u0435\u0441\u0442\u044c \u043e\u0442\u0446\u0430 \u0413\u0430\u0443\u0441\u0441\u0430?
    \u041d\u0435\u0442, \u0432 \u0447\u0435\u0441\u0442\u044c \u0434\u0440\u0443\u0433\u0430
    \u0441\u0435\u043c\u044c\u0438. \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0438\u043d\u0430
    (\u041c\u0438\u043d\u043d\u0430) (1808\u20131840) \u2014 \u043b\u044e\u0431\u0438\u043c\u0430\u044f
    \u0434\u043e\u0447\u044c \u0413\u0430\u0443\u0441\u0441\u0430, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432 \u0447\u0435\u0441\u0442\u044c \u0441\u0435\u0441\u0442\u0440\u044b \u0418\u043e\u0433\u0430\u043d\u043d\u044b
    (\u041c\u0438\u043d\u044b \u0412\u0430\u043b\u044c\u0434\u0435\u043a, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043d\u0435\u0442 \u0435\u0433\u043e \u0432\u0442\u043e\u0440\u043e\u0439
    \u0436\u0435\u043d\u043e\u0439). \u041b\u044e\u0434\u0432\u0438\u0433 (1809) \u2014 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439
    \u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438. \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f:
    \u0412 1809 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0440\u0435\u0431\u0435\u043d\u043a\u0430,
    \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u043b\u0430
    (\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043f\u043e\u0441\u043b\u0435\u0440\u043e\u0434\u043e\u0432\u043e\u0439 \u0441\u0435\u043f\u0441\u0438\u0441
    \u0438\u043b\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437). \u0413\u0430\u0443\u0441\u0441
    \u0431\u044b\u043b \u0432 \u043e\u0442\u0447\u0430\u044f\u043d\u0438\u0438. \u041e\u043d
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u043e\u0442\u0445\u043e\u0434\u0438\u043b
    \u043e\u0442 \u0435\u0451 \u043f\u043e\u0441\u0442\u0435\u043b\u0438. 11 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1809 \u0433\u043e\u0434\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u0443\u043c\u0435\u0440\u043b\u0430
    \u0443 \u043d\u0435\u0433\u043e \u043d\u0430 \u0440\u0443\u043a\u0430\u0445. \u0421\u043f\u0443\u0441\u0442\u044f
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u0435\u043b\u044c,
    \u0432 \u0434\u0435\u043a\u0430\u0431\u0440\u0435, \u0443\u043c\u0435\u0440 \u0438 \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439
    \u041b\u044e\u0434\u0432\u0438\u0433. \u0414\u043b\u044f \u0413\u0430\u0443\u0441\u0441\u0430
    \u044d\u0442\u043e \u0431\u044b\u043b \u0441\u043e\u043a\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0443\u0434\u0430\u0440. \u041e\u043d \u0432\u043f\u0430\u043b \u0432 \u0442\u044f\u0436\u0435\u043b\u0443\u044e
    \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044e, \u0434\u043b\u0438\u0432\u0448\u0443\u044e\u0441\u044f
    \u043f\u043e\u0447\u0442\u0438 \u0434\u0432\u0430 \u0433\u043e\u0434\u0430. \u0412 \u043f\u0438\u0441\u044c\u043c\u0435
    \u0434\u0440\u0443\u0433\u0443 \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b:
    \u00ab\u041c\u043e\u0439 \u0434\u043e\u043c \u2014 \u044d\u0442\u043e \u043c\u043e\u0433\u0438\u043b\u0430.
    \u0412\u0441\u0451, \u0447\u0442\u043e \u044f \u043b\u044e\u0431\u0438\u043b, \u043e\u0442\u043d\u044f\u0442\u043e
    \u0443 \u043c\u0435\u043d\u044f. \u0422\u0435\u043f\u0435\u0440\u044c \u043c\u043e\u044f
    \u0436\u0438\u0437\u043d\u044c \u2014 \u043b\u0438\u0448\u044c \u0442\u0443\u043f\u043e\u0435
    \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0434\u043e\u043b\u0433\u0430
    \u043f\u0435\u0440\u0435\u0434 \u043d\u0430\u0443\u043a\u043e\u0439, \u0447\u0442\u043e\u0431\u044b
    \u043d\u0435 \u0441\u043e\u0439\u0442\u0438 \u0441 \u0443\u043c\u0430\u00bb. \u041e\u043d
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0440\u0430\u0431\u043e\u0442\u044b \u0438 \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u043d\u0435 \u043c\u043e\u0433 \u043f\u0438\u0441\u0430\u0442\u044c \u043f\u0438\u0441\u044c\u043c\u0430
    \u0431\u0435\u0437 \u0441\u043b\u0435\u0437. --- 3. \u0412\u0442\u043e\u0440\u043e\u0439
    \u0431\u0440\u0430\u043a: \u041c\u0438\u043d\u0430 \u0412\u0430\u043b\u044c\u0434\u0435\u043a
    (\u0411\u0440\u0430\u043a \u043f\u043e \u0440\u0430\u0441\u0447\u0435\u0442\u0443 \u0438
    \u0434\u043e\u043b\u0433\u0443) \u0427\u0435\u0440\u0435\u0437 \u0433\u043e\u0434 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0418\u043e\u0433\u0430\u043d\u043d\u044b, \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c
    \u0441 \u0434\u0432\u0443\u043c\u044f \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c\u0438
    \u0434\u0435\u0442\u044c\u043c\u0438 \u0438 \u0431\u043e\u043b\u044c\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u0440\u044c\u044e,
    \u0413\u0430\u0443\u0441\u0441 \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043d\u0435
    \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441 \u0431\u044b\u0442\u043e\u043c.
    \u0412\u044b\u0431\u043e\u0440: \u041e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041c\u0438\u043d\u043d\u0435 \u0412\u0430\u043b\u044c\u0434\u0435\u043a (\u0432
    \u0434\u0435\u0432\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u041e\u0441\u0442\u0445\u043e\u0444\u0444)
    \u2014 \u0440\u043e\u0434\u043d\u043e\u0439 \u0441\u0435\u0441\u0442\u0440\u0435 \u0441\u0432\u043e\u0435\u0439
    \u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0439 \u0436\u0435\u043d\u044b. \u042d\u0442\u043e
    \u0431\u044b\u043b \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0439,
    \u0430 \u043d\u0435 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0448\u0430\u0433. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f: \u0412\u0435\u043d\u0447\u0430\u043d\u0438\u0435
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u043e\u0441\u044c 4 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1810 \u0433\u043e\u0434\u0430. \u041c\u0438\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u043e\u0439
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e
    \u0418\u043e\u0433\u0430\u043d\u043d\u044b: \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0430\u044f,
    \u0432\u043e\u043b\u0435\u0432\u0430\u044f, \u043d\u043e \u043c\u0435\u043d\u0435\u0435
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e
    \u0440\u0430\u0437\u0432\u0438\u0442\u0430\u044f. \u0413\u0430\u0443\u0441\u0441 \u043d\u0435
    \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u043b \u043a \u043d\u0435\u0439 \u0442\u043e\u0439
    \u0441\u0442\u0440\u0430\u0441\u0442\u0438, \u0447\u0442\u043e \u043a \u043f\u0435\u0440\u0432\u043e\u0439
    \u0436\u0435\u043d\u0435. \u0412 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435
    \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u043e\u043d \u043e\u0442\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \u043e \u0431\u0440\u0430\u043a\u0435 \u043a\u0430\u043a \u043e \u00ab\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u043c
    \u0441\u043e\u044e\u0437\u0435\u00bb \u0438 \u00ab\u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u043e\u043c
    \u0440\u0435\u0448\u0435\u043d\u0438\u0438\u00bb. \u0414\u0435\u0442\u0438: \u0412 \u044d\u0442\u043e\u043c
    \u0431\u0440\u0430\u043a\u0435 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0435\u0449\u0435
    \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439: \u042d\u0436\u0435\u043d (1811\u20131896)
    \u2014 \u043f\u043e\u0437\u0436\u0435 \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432 \u0421\u0428\u0410. \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c (1813\u20131879)
    \u2014 \u0442\u043e\u0436\u0435 \u0443\u0435\u0445\u0430\u043b \u0432 \u0410\u043c\u0435\u0440\u0438\u043a\u0443.
    \u0422\u0435\u0440\u0435\u0437\u0430 (1816\u20131864) \u2014 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c
    \u0441 \u043e\u0442\u0446\u043e\u043c \u0438 \u0432\u0435\u043b\u0430 \u0435\u0433\u043e
    \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u043e \u0434\u043e \u0441\u0430\u043c\u043e\u0439
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438. \u0425\u043e\u043b\u043e\u0434\u043d\u043e\u0441\u0442\u044c:
    \u0411\u0440\u0430\u043a \u0441 \u041c\u0438\u043d\u043e\u0439 \u0431\u044b\u043b \u043d\u0435\u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c.
    \u041e\u043d\u0438 \u0436\u0438\u043b\u0438 \u043a\u0430\u043a \u0441\u043e\u0441\u0435\u0434\u0438,
    \u0430 \u043d\u0435 \u043a\u0430\u043a \u0441\u0443\u043f\u0440\u0443\u0433\u0438. \u041c\u0438\u043d\u043d\u0430
    \u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043b\u0430 \u0413\u0430\u0443\u0441\u0441\u0430
    \u043a \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438
    \u043a \u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0439 \u0441\u0435\u0441\u0442\u0440\u0435.
    \u0413\u0430\u0443\u0441\u0441 \u0436\u0435, \u0441\u043e \u0441\u0432\u043e\u0435\u0439
    \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u0441\u0447\u0438\u0442\u0430\u043b \u0436\u0435\u043d\u0443
    \u043d\u0435\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0439 \u043f\u043e\u043d\u044f\u0442\u044c
    \u0435\u0433\u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043c\u0438\u0440.
    \u0412 1831 \u0433\u043e\u0434\u0443 \u041c\u0438\u043d\u043d\u0430 \u0442\u044f\u0436\u0435\u043b\u043e
    \u0437\u0430\u0431\u043e\u043b\u0435\u043b\u0430 (\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043e\u043c \u0438 \u043d\u0435\u0440\u0432\u043d\u044b\u043c
    \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u043c) \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0434\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u043c\u0435\u0440\u0442\u0438 \u0432
    1839 \u0433\u043e\u0434\u0443 \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u043a\u043e\u0432\u0430\u043d\u0430
    \u043a \u043f\u043e\u0441\u0442\u0435\u043b\u0438. \u0413\u0430\u0443\u0441\u0441 \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u043b
    \u0437\u0430 \u043d\u0435\u0439, \u043d\u043e \u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e
    \u0441\u043a\u043e\u0440\u0435\u0435 \u0438\u0437 \u0447\u0443\u0432\u0441\u0442\u0432\u0430
    \u0434\u043e\u043b\u0433\u0430, \u0447\u0435\u043c \u0438\u0437 \u043b\u044e\u0431\u0432\u0438.
    \u0412 \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u044d\u0442\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430
    \u043e\u043d \u0436\u0430\u043b\u0443\u0435\u0442\u0441\u044f \u043d\u0430 \u00ab\u0442\u044f\u0436\u0435\u043b\u044b\u0439
    \u043a\u0440\u0435\u0441\u0442\u00bb \u0438 \u00ab\u0432\u0435\u0447\u043d\u044b\u0435 \u0441\u0442\u0435\u043d\u0430\u043d\u0438\u044f\u00bb
    \u0432 \u0434\u043e\u043c\u0435. --- 4. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0435\u0442\u044c\u043c\u0438: \u0416\u0435\u0441\u0442\u043a\u0438\u0439
    \u043e\u0442\u0435\u0446 \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b \u0441\u043b\u043e\u0436\u043d\u044b\u043c,
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0438
    \u0447\u0430\u0441\u0442\u043e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u044b\u043c
    \u043e\u0442\u0446\u043e\u043c. \u0421\u044b\u043d\u043e\u0432\u044c\u044f: \u041e\u043d
    \u0445\u043e\u0442\u0435\u043b, \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0435 \u0435\u0433\u043e
    \u0441\u044b\u043d\u043e\u0432\u044c\u044f \u043f\u043e\u0448\u043b\u0438 \u043f\u043e \u0435\u0433\u043e
    \u0441\u0442\u043e\u043f\u0430\u043c \u0438 \u0441\u0442\u0430\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438
    \u0438\u043b\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438. \u041d\u043e \u043d\u0438
    \u043e\u0434\u0438\u043d \u0438\u0437 \u043d\u0438\u0445 \u043d\u0435 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b \u0436\u0435\u0441\u0442\u043e\u043a \u0432
    \u0441\u0432\u043e\u0438\u0445 \u043e\u0446\u0435\u043d\u043a\u0430\u0445. \u041e\u043d
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u00ab\u0442\u0443\u043f\u0438\u0446\u0430\u043c\u0438\u00bb
    \u0432 \u043b\u0438\u0447\u043d\u044b\u0445 \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u0438
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u0443\u043d\u0438\u0436\u0430\u043b \u0438\u0445
    \u0437\u0430 \u043d\u0435\u0443\u0441\u043f\u0435\u0445\u0438 \u0432 \u0443\u0447\u0435\u0431\u0435.
    \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441 \u0441\u044b\u043d\u043e\u0432\u044c\u044f\u043c\u0438:
    \u0418\u0437-\u0437\u0430 \u0436\u0435\u0441\u0442\u043a\u043e\u0433\u043e \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0432\u0441\u0435 \u0442\u0440\u043e\u0435 \u0441\u044b\u043d\u043e\u0432\u0435\u0439 (\u0418\u043e\u0441\u0438\u0444,
    \u042d\u0436\u0435\u043d \u0438 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c)
    \u0432\u043e\u0437\u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u042d\u0436\u0435\u043d \u0438 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c,
    \u043a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0438
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e\u043b\u0435\u0442\u0438\u044f,
    \u0441\u0431\u0435\u0436\u0430\u043b\u0438 \u043e\u0442 \u043e\u0442\u0446\u0430 \u0432
    \u0410\u043c\u0435\u0440\u0438\u043a\u0443 (\u043e\u0431\u0430 \u0441\u0442\u0430\u043b\u0438
    \u0432\u043f\u043e\u043b\u043d\u0435 \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u043c\u0438
    \u0431\u0438\u0437\u043d\u0435\u0441\u043c\u0435\u043d\u0430\u043c\u0438). \u0413\u0430\u0443\u0441\u0441
    \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u0435\u043d
    \u0438\u0445 \u0443\u0445\u043e\u0434\u043e\u043c \u0438 \u0437\u0430\u043f\u0440\u0435\u0442\u0438\u043b
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c \u0438\u0445 \u0438\u043c\u0435\u043d\u0430
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0434\u043e\u043c\u0435. \u0421 \u0418\u043e\u0441\u0438\u0444\u043e\u043c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0442\u043e\u0436\u0435 \u0431\u044b\u043b\u0438
    \u043d\u0430\u0442\u044f\u043d\u0443\u0442\u044b\u043c\u0438, \u0445\u043e\u0442\u044f \u043e\u043d
    \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0438
    \u0441\u043b\u0443\u0436\u0438\u043b \u0432 \u0430\u0440\u043c\u0438\u0438. \u041b\u044e\u0431\u0438\u043c\u044b\u0439
    \u0432\u043d\u0443\u043a: \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c,
    \u043a\u043e\u0433\u043e \u0413\u0430\u0443\u0441\u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043b\u044e\u0431\u0438\u043b \u0441\u0440\u0435\u0434\u0438 \u043c\u043b\u0430\u0434\u0448\u0435\u0433\u043e
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f, \u0431\u044b\u043b \u0432\u043d\u0443\u043a
    (\u0441\u044b\u043d \u042d\u0436\u0435\u043d\u0430), \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0442\u0430\u043a\u0436\u0435 \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u041a\u0430\u0440\u043b\u043e\u043c.
    \u0413\u0430\u0443\u0441\u0441 \u0442\u0430\u0439\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0441\u044f
    \u0441 \u043d\u0438\u043c \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u0441\u0440\u0435\u0434\u043d\u0438\u043a\u043e\u0432,
    \u043d\u043e \u0442\u0430\u043a \u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u0438\u043b
    \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u044b\u043d\u0430. \u0414\u043e\u0447\u0435\u0440\u0438:
    \u0421 \u0434\u043e\u0447\u0435\u0440\u044f\u043c\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u0442\u0435\u043f\u043b\u0435\u0435, \u043d\u043e \u0442\u043e\u0436\u0435
    \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u044b. \u041c\u0438\u043d\u043d\u0430
    (\u043e\u0442 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0431\u0440\u0430\u043a\u0430)
    \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u0438\u0446\u0435\u0439.
    \u041e\u043d\u0430 \u043e\u0431\u043b\u0430\u0434\u0430\u043b\u0430 \u0436\u0438\u0432\u044b\u043c
    \u0443\u043c\u043e\u043c \u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0430\u0443\u043a\u043e\u0439. \u041d\u043e \u043e\u043d\u0430 \u0441\u0442\u0440\u0430\u0434\u0430\u043b\u0430
    \u043e\u0442 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    (\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043f\u043e\u0440\u043e\u043a\u0430
    \u0441\u0435\u0440\u0434\u0446\u0430 \u0438\u043b\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430)
    \u0438 \u0443\u043c\u0435\u0440\u043b\u0430 \u0432 1840 \u0433\u043e\u0434\u0443 \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 32 \u043b\u0435\u0442, \u0437\u0430 \u0433\u043e\u0434
    \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u043c\u0430\u0447\u0435\u0445\u0438.
    \u0415\u0451 \u0441\u043c\u0435\u0440\u0442\u044c \u0441\u0442\u0430\u043b\u0430 \u0432\u0442\u043e\u0440\u044b\u043c
    \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u043c \u0443\u0434\u0430\u0440\u043e\u043c
    \u0432 \u0436\u0438\u0437\u043d\u0438 \u0413\u0430\u0443\u0441\u0441\u0430. \u041e\u043d
    \u0431\u044b\u043b \u0431\u0435\u0437\u0443\u0442\u0435\u0448\u0435\u043d. \u0422\u0435\u0440\u0435\u0437\u0430
    (\u043e\u0442 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u0440\u0430\u043a\u0430)
    \u0441\u0442\u0430\u043b\u0430 \u00ab\u0430\u043d\u0433\u0435\u043b\u043e\u043c-\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u0435\u043c\u00bb
    \u0441\u0442\u0430\u0440\u0435\u044e\u0449\u0435\u0433\u043e \u0413\u0430\u0443\u0441\u0441\u0430.
    \u041e\u043d\u0430 \u0432\u0435\u043b\u0430 \u0435\u0433\u043e \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u043e,
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0430 \u0433\u043e\u0441\u0442\u0435\u0439,
    \u0437\u0430\u0431\u043e\u0442\u0438\u043b\u0430\u0441\u044c \u043e \u043d\u0435\u043c,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043e\u0441\u043b\u0435\u043f \u043d\u0430
    \u043e\u0434\u0438\u043d \u0433\u043b\u0430\u0437 \u0432 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438.
    \u041e\u043d\u0430 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u044c\u044e \u0440\u0430\u0434\u0438
    \u043e\u0442\u0446\u0430, \u0442\u0430\u043a \u0438 \u043d\u0435 \u0432\u044b\u0439\u0434\u044f
    \u0437\u0430\u043c\u0443\u0436, \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u043e
    \u0435\u0451 \u0432 \u0433\u043b\u0430\u0437\u0430\u0445 \u0413\u0430\u0443\u0441\u0441\u0430
    \u00ab\u0441\u043f\u0430\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439\u00bb
    \u0435\u0433\u043e \u0434\u043e\u043c\u0430. --- 5. \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440,
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435
    \u0418\u043d\u0442\u0440\u043e\u0432\u0435\u0440\u0442 \u0438 \u043c\u0438\u0437\u0430\u043d\u0442\u0440\u043e\u043f:
    \u0413\u0430\u0443\u0441\u0441 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u0441\u0432\u0435\u0442\u0441\u043a\u0438\u0435
    \u0440\u0430\u0443\u0442\u044b \u0438 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0435
    \u043b\u0435\u043a\u0446\u0438\u0438. \u041e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e \u0432 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0435
    \u0438\u043b\u0438 \u0432 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u043b
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e
    \u0440\u0430\u0432\u043d\u043e\u0433\u043e \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a\u0430
    (\u043a\u0430\u043a \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0444\u043e\u043d
    \u0413\u0443\u043c\u0431\u043e\u043b\u044c\u0434\u0442 \u0438\u043b\u0438 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c
    \u0412\u0435\u0431\u0435\u0440), \u043e\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0441\u044f
    \u043e\u0436\u0438\u0432\u043b\u0435\u043d\u043d\u044b\u043c, \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u043c
    \u0438 \u0449\u0435\u0434\u0440\u044b\u043c \u043d\u0430 \u0438\u0434\u0435\u0438. \u0414\u0440\u0443\u0436\u0431\u0430
    \u0441 \u0412\u0435\u0431\u0435\u0440\u043e\u043c: \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0441 \u0444\u0438\u0437\u0438\u043a\u043e\u043c \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u043e\u043c
    \u0412\u0435\u0431\u0435\u0440\u043e\u043c (\u0441 1831 \u0433\u043e\u0434\u0430) \u0431\u044b\u043b\u0430
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0442\u0440\u0430\u0434\u043e\u0439
    \u0432 \u043f\u043e\u0437\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b. \u0412\u0435\u0431\u0435\u0440
    \u0431\u044b\u043b \u043c\u043e\u043b\u043e\u0436\u0435 \u0438 \u0442\u0435\u0440\u043f\u0435\u043b\u0438\u0432\u043e
    \u0441\u043d\u043e\u0441\u0438\u043b \u0432\u0441\u043f\u044b\u043b\u044c\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u0413\u0430\u0443\u0441\u0441\u0430. \u041e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0438\u0433\u0440\u0430\u043b\u0438 \u043d\u0430 \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0445 (\u0413\u0430\u0443\u0441\u0441
    \u043b\u044e\u0431\u0438\u043b \u0444\u043e\u0440\u0442\u0435\u043f\u0438\u0430\u043d\u043e)
    \u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b\u0438 \u0444\u0438\u0437\u0438\u043a\u0443.
    \u041d\u0435\u0432\u0440\u043e\u0437\u044b \u0438 \u0441\u0442\u0440\u0430\u0445\u0438:
    \u0413\u0430\u0443\u0441\u0441 \u043f\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u043e\u044f\u043b\u0441\u044f
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d \u0438 \u043a\u043b\u0430\u0434\u0431\u0438\u0449.
    \u041e\u043d \u0437\u0430\u043f\u0440\u0435\u0449\u0430\u043b \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c
    \u0441\u043b\u043e\u0432\u043e \u00ab\u0441\u043c\u0435\u0440\u0442\u044c\u00bb \u0432 \u0441\u0432\u043e\u0435\u043c
    \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438. \u0412 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438
    \u043e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0435\u0439
    \u0438 \u043e\u0431\u0441\u0435\u0441\u0441\u0438\u0432\u043d\u043e-\u043a\u043e\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u044b\u043c\u0438
    \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438: \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b \u0448\u0430\u0433\u0438,
    \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u043b \u0437\u0430\u043c\u043a\u0438 \u0438 \u0441\u043b\u0435\u0434\u0438\u043b
    \u0437\u0430 \u0447\u0438\u0441\u0442\u043e\u0442\u043e\u0439 \u0440\u0443\u043a. \u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0430:
    \u041e\u043d \u0431\u044b\u043b \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u043e\u043c,
    \u043d\u043e \u043a\u0440\u0430\u0439\u043d\u0435 \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u044b\u043c.
    \u041d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430
    (\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043a\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043b
    \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440) \u0438 \u0432\u043e\u0439\u043d\u0443.
    \u0412 1813 \u0433\u043e\u0434\u0443, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0432\u043e\u0439\u043d, \u043e\u043d \u0441\u043f\u0440\u044f\u0442\u0430\u043b \u0441\u0432\u043e\u0438
    \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f \u0432 \u043f\u043e\u0434\u0432\u0430\u043b\u0435
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438 \u0438 \u0441\u0438\u0434\u0435\u043b
    \u0441 \u043f\u0438\u0441\u0442\u043e\u043b\u0435\u0442\u043e\u043c \u043d\u0430\u0433\u043e\u0442\u043e\u0432\u0435,
    \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c \u043c\u0430\u0440\u043e\u0434\u0435\u0440\u043e\u0432.
    \u0424\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0430\u044f \u0441\u043a\u0443\u043f\u043e\u0441\u0442\u044c:
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0438\u0439
    \u0441\u0442\u0430\u0442\u0443\u0441, \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0431\u0435\u0440\u0435\u0436\u043b\u0438\u0432. \u041e\u043d
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043b \u043d\u0430 \u043e\u0434\u0435\u0436\u0434\u0435,
    \u0435\u0434\u0435 \u0438 \u043e\u0442\u043e\u043f\u043b\u0435\u043d\u0438\u0438, \u0447\u0430\u0441\u0442\u043e
    \u0441\u0438\u0434\u0435\u043b \u0432 \u043f\u0430\u043b\u044c\u0442\u043e \u0438 \u0448\u0430\u0440\u0444\u0435
    \u0432 \u043d\u0435\u0442\u043e\u043f\u043b\u0435\u043d\u043e\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435.
    \u042d\u0442\u0430 \u0447\u0435\u0440\u0442\u0430, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0430 \u043e\u0442 \u043e\u0442\u0446\u0430
    \u0438 \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0430 \u0434\u0435\u0442\u0441\u043a\u043e\u0439
    \u043d\u0443\u0436\u0434\u043e\u0439. --- 6. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0443\u0445\u043e\u0434 \u0438\u0437 \u0436\u0438\u0437\u043d\u0438
    \u0412 1848 \u0433\u043e\u0434\u0443 \u0443 \u0413\u0430\u0443\u0441\u0441\u0430 \u0440\u0435\u0437\u043a\u043e
    \u0443\u0445\u0443\u0434\u0448\u0438\u043b\u043e\u0441\u044c \u0437\u0440\u0435\u043d\u0438\u0435.
    \u041a 1854 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0441\u043b\u0435\u043f \u043d\u0430 \u043b\u0435\u0432\u044b\u0439 \u0433\u043b\u0430\u0437,
    \u043d\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0438 \u043b\u0443\u043f\u0443. \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435
    \u043f\u043e\u0434\u043a\u043e\u0441\u0438\u043b\u0430 \u0431\u0435\u0441\u0441\u043e\u043d\u043d\u0438\u0446\u0430,
    \u043f\u043e\u0434\u0430\u0433\u0440\u0430 \u0438 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u0430\u044f
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c.
    \u041e\u043d \u0443\u043c\u0435\u0440 \u0440\u0430\u043d\u043e \u0443\u0442\u0440\u043e\u043c
    23 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1855 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0432\u043e\u0435\u043c
    \u043a\u0440\u0435\u0441\u043b\u0435, \u0432\u043e \u0441\u043d\u0435. \u0421 \u043d\u0438\u043c
    \u0432 \u043a\u043e\u043c\u043d\u0430\u0442\u0435 \u0431\u044b\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0434\u043e\u0447\u044c \u0422\u0435\u0440\u0435\u0437\u0430 \u0438 \u0432\u0435\u0440\u043d\u044b\u0439
    \u0441\u043b\u0443\u0433\u0430. \u041d\u0430 \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u043e\u043c
    \u043a\u0430\u043c\u043d\u0435 \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430 \u0437\u043e\u043b\u043e\u0442\u0430\u044f
    \u043f\u0435\u043d\u0442\u0430\u0433\u0440\u0430\u043c\u043c\u0430 \u2014 \u0441\u0438\u043c\u0432\u043e\u043b
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u044e\u043d\u043e\u0448\u0435\u0441\u043a\u043e\u0433\u043e
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f (\u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435
    17-\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430), \u0445\u043e\u0442\u044f \u043e\u043d
    \u0437\u0430\u0432\u0435\u0449\u0430\u043b \u0432\u044b\u0441\u0435\u0447\u044c \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0440\u043e\u0441\u0442\u0443\u044e \u0437\u0432\u0435\u0437\u0434\u0443. \u0418\u0442\u043e\u0433:
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0413\u0430\u0443\u0441\u0441\u0430
    \u0431\u044b\u043b\u0430 \u0442\u0440\u0430\u0433\u0438\u043a\u043e\u043c\u0438\u0447\u043d\u043e\u0439:
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0439 \u0443\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0438\u0434\u0435\u043b \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439, \u043d\u0435 \u043c\u043e\u0433
    \u043d\u0430\u0432\u0435\u0441\u0442\u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0432
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c \u0434\u043e\u043c\u0435.
    \u041e\u043d \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0441\u043c\u0435\u0440\u0442\u044c
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0436\u0435\u043d\u044b \u0438 \u043b\u044e\u0431\u0438\u043c\u043e\u0439
    \u0434\u043e\u0447\u0435\u0440\u0438, \u043f\u043e\u0441\u0441\u043e\u0440\u0438\u043b\u0441\u044f
    \u0441 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u0434\u0435\u0442\u044c\u043c\u0438,
    \u0436\u0438\u043b \u0432 \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u043c \u0431\u0440\u0430\u043a\u0435
    \u0441 \u043d\u0435\u043b\u044e\u0431\u0438\u043c\u043e\u0439 \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439
    \u0438 \u0443\u043c\u0435\u0440 \u0432 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0438
    \u043b\u0438\u0448\u044c \u043e\u0434\u043d\u043e\u0439 \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0439
    \u0434\u043e\u0447\u0435\u0440\u0438, \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0435\u0439 \u0441\u0432\u043e\u0435\u0439
    \u0436\u0438\u0437\u043d\u044c\u044e \u0440\u0430\u0434\u0438 \u0435\u0433\u043e \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0430."
  personalLifeEn: "The personal life of Carl Friedrich Gauss is a story in stark contrast to the crystal clearness of his mathematical formulas. If his scientific works are a triumph of order, his private life was full of drama, tragedies, complex features and family conflicts.In order to present the full picture, we will examine his personal life by the periods of origin and relationship with his parents, first great love and tragic marriage, second marriage by calculation, relationship with children, and family nature. -- 1. Parents and childhood: The cold father and loving mother of Gauss formed under the influence of polarally different parents. Father, Gebhard Dietrich Gauss (1744-1808) was a man who was harsh, practical and uneducated.He worked as a plumber, gardener, butcher, mason, and puncturer, and he was a perfectionist in his work, but the family was in iron discipline.The relationship was tense: Gauss never spoke of his father with warmth, and when he died (in 1808), Gauss did not go to the funeral, citing employment (although later in the diary he admitted it was cruel). Mother, Dorotea Benze (1743-1839), was the complete opposite of her husband. Almost illiterate (unable to write, read) but possessed living intelligence, humor, and incredible intuition.She was the one who saw the genius in her son and until her death was his main pillar. Dorotea lived with Gausey until she was 96 years old. Gauss loved the mother; he carried her in his arms around the room when she couldn't walk anymore and wrote under her dictation letters. After her death, he wrote: \"The world is empty for me.\" -- 2. First love: Johanna Osthoff (Tragedia 1809) It was the brightest and most painful page of his personal life.Introduction: Gauss met Johanna (some sources - Johanna) Easthoff in Brownschweig in the late 1790s, who was the daughter of a skinny, elegant, educated, and living girl. Long engagement: Due to the financial instability of Gaussa (he had not yet had a permanent job), they could not get married for many years. Gauss worshipped Johanna. In his letters this period, she appears as \"my star\" and \"my everything.\"He wrote: \"The love of my life filled my life with a meaning that even the most beautiful theorems could not give.\" Marriage: They married on October 9, 1805, and this marriage was incredibly happy, albeit short-lived. They had three children: Joseph (1806 - 1873), named after the father of Gauss? No, in honor of a family friend. Wilhelmin (Minna) (1808 - 1840), the beloved daughter of Gaussa, named after her sister Johanna (Mina Valdek, who will later become his second wife).Ludwig (1809) was born a few days after the tragedy. Tragedy: In 1809, after the birth of the third child, Johanna became seriously ill (probably post-natal septicsis or tuberculosis), Gauss was desperate, and he almost never left her bed. On 11 October 1809, Johanna died in his arms. A few weeks later, in December, Ludwig's newborn died.He became depressed for almost two years and wrote to a friend: \"My house is a grave, everything I loved is taken away from me. Now my life is just a stupid performance of my duty to science to keep him from going mad.\" He stopped publishing his work and for a long time he couldn't write letters without crying. ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------The second marriage: Mina Valdek (Bracken for account and debt) One year after Johanna died, who remained with two young children and a sick mother, Gauss realized that he was not able to live. The choice was: he married Minna Valdek (in the maidenhood of Osthoff), the sister of his late wife, which was a pragmatic step, not a romantic one.Minna was the exact opposite of Johanna: practical, voluntarily, but less intellectually developed; Gauss did not have the passion for her first wife; in his correspondence with his friends, he referred to marriage as a \"needy union\" and \"forced decision.\" Children: In this marriage, three more children were born: Eugene (1811–1896), later emigrated to the United States; Wilhelm (1813–1879) also went to America.Theresa (1816-1864), who stayed with his father until his death, was cold: marriage to Mina was unhappy, they lived as neighbours rather than as spouses, Minna was jealous of his math and his late sister, and Gauss thought that his wife was incapable of understanding his inner world.In 1831, Minna became seriously ill (probably tuberculosis and nervous disorder) and was almost bedridden until her death in 1839.He said: O my sons! surely Allah is Mighty, Wise.Eugene and Wilhelm, as soon as they reached the age of majority, fled from their father to America (both became successful businessmen).Gauss was secretly communicating with him through intermediaries, but never forgave his son.Theresa (from the second marriage) became the guardian angel of the ageing Gauss, who ran his household, received guests, took care of him when he was blinded in his old age, who sacrificed her personal life for her father and never married, which made her \"saver\" in the eyes of Gauss at his house.He preferred loneliness in his office or in the observatory, but when he found an intellectually equal contact (like Alexander von Humboldt or Wilhelm Weber), he became lively, witty and generous in ideas.They played musical instruments together, and discussed physics.He hated Napoleon (who occupied Hanover) and the war. In 1813, during the liberation wars, he hid his savings in the basement of the observatory and sat with a gun ready for fear of looters.In 1848, Goose's vision deteriorated dramatically. By 1854, he was practically blind to his left eye, but kept working using huge tables and lupus. His health was cut off by insomnia, gambling and heart failure. He died early on the morning of February 23, 1855 in his chair, in his sleep.On his tombstone is a gold pentagram, a symbol of his main youth achievement (building a 17-column), although he had made a simple star to be cut out. The result is that Gauss' personal life was tragic: the greatest mind of mankind, which saw the structure of the universe, could not bring order to its own home.He survived the death of his first wife and daughter, argued with his own children, lived in a cold marriage with an unloved woman, and died surrounded by only one loyal daughter who actually sacrificed her life for his comfort."
  shortBioRu: "\u0418\u043e\u0433\u0430\u043d\u043d \u041a\u0430\u0440\u043b \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    \u0413\u0430\u0443\u0441\u0441 (1777\u20131855) \u2014 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c,
    \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0441\u0442 \u0438 \u0444\u0438\u0437\u0438\u043a,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0435\u0449\u0435 \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438
    \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0438 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0443\u0434\u043e\u0441\u0442\u043e\u0438\u043b\u0438
    \u0442\u0438\u0442\u0443\u043b\u0430 \u00abPrinceps Mathematicorum\u00bb (\u041a\u043d\u044f\u0437\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432). \u0415\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0433\u0435\u043d\u0438\u044f, \u0440\u043e\u0434\u0438\u0432\u0448\u0435\u0433\u043e\u0441\u044f
    \u0432 \u0431\u0435\u0434\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0435 \u0438 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0442\u0430\u043b\u0430\u043d\u0442\u0443 \u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0441\u0443\u043c\u0435\u0432\u0448\u0435\u0433\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u0442\u044c
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432\u043e \u043c\u043d\u043e\u0433\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u043d\u0430\u0443\u043a\u0438. \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 (1777\u20131798)
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0413\u0430\u0443\u0441\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 30 \u0430\u043f\u0440\u0435\u043b\u044f
    1777 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u043d\u0435\u0431\u043e\u0433\u0430\u0442\u044b\u0445
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439. \u0415\u0433\u043e \u043e\u0442\u0435\u0446,
    \u0413\u0435\u0431\u0445\u0430\u0440\u0434 \u0414\u0438\u0442\u0440\u0438\u0445 \u0413\u0430\u0443\u0441\u0441,
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u044f\u0441\u043d\u0438\u043a\u043e\u043c,
    \u0441\u0430\u0434\u043e\u0432\u043d\u0438\u043a\u043e\u043c, \u043a\u0430\u043c\u0435\u043d\u0449\u0438\u043a\u043e\u043c
    \u0438 \u043a\u0430\u0437\u043d\u0430\u0447\u0435\u0435\u043c. \u041c\u0430\u0442\u044c,
    \u0414\u043e\u0440\u043e\u0442\u0435\u044f \u0411\u0435\u043d\u0446\u0435, \u0431\u044b\u043b\u0430
    \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u043a\u0430\u043c\u0435\u043d\u043e\u0442\u0435\u0441\u0430
    \u0438, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043e\u0442\u0446\u0430,
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0447\u0442\u0438 \u043d\u0435\u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0439,
    \u043d\u043e \u0441\u043b\u0430\u0432\u0438\u043b\u0430\u0441\u044c \u0443\u043c\u043e\u043c
    \u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0413\u0430\u0443\u0441\u0441\u0430
    \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u043e\u0447\u0435\u043d\u044c \u0442\u0435\u043f\u043b\u044b\u043c\u0438 \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u0432\u0441\u0435\u0439 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u0412\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434
    \u0421\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0413\u0430\u0443\u0441\u0441\u0430
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0440\u0430\u043d\u043e. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430, \u0447\u0442\u043e \u0432 \u0442\u0440\u0435\u0445\u043b\u0435\u0442\u043d\u0435\u043c
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u043d \u0437\u0430\u043c\u0435\u0442\u0438\u043b
    \u043e\u0448\u0438\u0431\u043a\u0443 \u0432 \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445
    \u0441\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430. \u0412 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435, \u043a\u043e\u0433\u0434\u0430 \u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0441\u043b\u043e\u0436\u0438\u0442\u044c \u0447\u0438\u0441\u043b\u0430 \u043e\u0442 1
    \u0434\u043e 100, \u044e\u043d\u044b\u0439 \u0413\u0430\u0443\u0441\u0441 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e
    \u0434\u0430\u043b \u043e\u0442\u0432\u0435\u0442 \u2014 5050. \u0412\u043c\u0435\u0441\u0442\u043e
    \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043e\u043d \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0447\u0438\u0441\u043b\u0430
    \u0432 50 \u043f\u0430\u0440: 1+100, 2+99 \u0438 \u0442.\u0434., \u043a\u0430\u0436\u0434\u0430\u044f
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0434\u0430\u0435\u0442 101. \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0423\u0447\u0438\u0442\u0435\u043b\u044f \u0438 \u0435\u0433\u043e \u043c\u0430\u0442\u044c
    \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0438 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u043d\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0434\u0430\u0440 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430. \u0412 1791 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u0433\u0435\u0440\u0446\u043e\u0433\u0443
    \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0441\u043a\u043e\u043c\u0443,
    \u041a\u0430\u0440\u043b\u0443 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0443
    \u0424\u0435\u0440\u0434\u0438\u043d\u0430\u043d\u0434\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d,
    \u0447\u0442\u043e \u0432\u0437\u044f\u043b \u043d\u0430 \u0441\u0435\u0431\u044f \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f. \u0421
    1792 \u043f\u043e 1795 \u0433\u043e\u0434 \u0413\u0430\u0443\u0441\u0441 \u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 Collegium Carolinum \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c, \u0441 1795 \u043f\u043e 1798 \u0433\u043e\u0434,
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u0412 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u043e\u043d
    \u0441\u043b\u0443\u0448\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u0441\u0434\u0435\u043b\u0430\u043d\u043d\u043e\u0435 \u0438\u043c \u0432 18 \u043b\u0435\u0442,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u043e \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439
    \u043f\u0443\u0442\u044c: \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0433\u043e 17-\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0446\u0438\u0440\u043a\u0443\u043b\u044f
    \u0438 \u043b\u0438\u043d\u0435\u0439\u043a\u0438. \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u043f\u0435\u0440\u0432\u043e\u0435 \u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0441\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438,
    \u0438 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0433\u043e \u0413\u0430\u0443\u0441\u0441
    \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0432\u044b\u0431\u0440\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 (1798\u20131807) \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433, \u0413\u0430\u0443\u0441\u0441
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u043e\u0442 \u0433\u0435\u0440\u0446\u043e\u0433\u0430,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0435\u043c\u0443
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043d\u0430\u0443\u043a\u043e\u0439,
    \u043d\u0435 \u0438\u043c\u0435\u044f \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438. \u0412 1799 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0425\u0435\u043b\u044c\u043c\u0448\u0442\u0435\u0434\u0442\u0430, \u0437\u0430\u0449\u0438\u0442\u0438\u0432
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u043e\u0441\u044c \u043f\u0435\u0440\u0432\u043e\u0435
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u00bb \u0438 \u043c\u0438\u0440\u043e\u0432\u0430\u044f
    \u0441\u043b\u0430\u0432\u0430 \u0412 1801 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u043e
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435, Disquisitiones
    Arithmeticae (\u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u00bb). \u042d\u0442\u0430
    \u043a\u043d\u0438\u0433\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u044b
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b, \u0432\u0432\u0435\u0434\u044f, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043c\u043e\u0434\u0443\u043b\u044c\u043d\u043e\u0439
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438. \u0422\u0440\u0438\u0443\u043c\u0444
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430 \u041d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e
    \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443 \u0413\u0430\u0443\u0441\u0441\u0443
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u043d\u0435 \u0447\u0438\u0441\u0442\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u0430 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f.
    \u0412 \u044f\u043d\u0432\u0430\u0440\u0435 1801 \u0433\u043e\u0434\u0430 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435
    \u041f\u044c\u044f\u0446\u0446\u0438 \u043e\u0442\u043a\u0440\u044b\u043b \u043a\u0430\u0440\u043b\u0438\u043a\u043e\u0432\u0443\u044e
    \u043f\u043b\u0430\u043d\u0435\u0442\u0443 \u0426\u0435\u0440\u0435\u0440\u0443, \u043d\u043e
    \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0435\u0435
    \u0438\u0437 \u0432\u0438\u0434\u0443. \u041c\u043d\u043e\u0433\u0438\u0435 \u0443\u0447\u0435\u043d\u044b\u0435
    \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c
    \u0435\u0435 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435,
    \u043d\u043e \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e. \u0413\u0430\u0443\u0441\u0441,
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e
    24 \u0433\u043e\u0434\u0430, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u0441\u0432\u043e\u0439
    \u043d\u043e\u0432\u044b\u0439 \u043c\u0435\u0442\u043e\u0434 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432 \u0434\u043b\u044f \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438
    \u0441\u043a\u0443\u0434\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u0441
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043b \u043e\u0440\u0431\u0438\u0442\u0443
    \u0426\u0435\u0440\u0435\u0440\u044b. \u0412 \u0434\u0435\u043a\u0430\u0431\u0440\u0435
    1801 \u0433\u043e\u0434\u0430 \u0435\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0438
    \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c, \u0433\u0434\u0435 \u043e\u043d
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b. \u042d\u0442\u043e\u0442 \u0442\u0440\u0438\u0443\u043c\u0444
    \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u043b
    \u0413\u0430\u0443\u0441\u0441\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c
    \u0438 \u0443\u043a\u0440\u0435\u043f\u0438\u043b \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438. \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 (1807\u20131855) \u0412 1807 \u0433\u043e\u0434\u0443
    \u0413\u0430\u0443\u0441\u0441 \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u0442\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u0438 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0433\u0434\u0435
    \u0438 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0436\u0438\u0437\u043d\u0438. \u041b\u0438\u0447\u043d\u044b\u0435 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438
    \u0412 1805 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0435 \u041e\u0441\u0442\u0445\u043e\u0444\u0444,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u0435\u0433\u043e
    \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u044c\u044e. \u0423
    \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0442\u0440\u043e\u0435
    \u0434\u0435\u0442\u0435\u0439, \u043d\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0435
    \u0441\u0447\u0430\u0441\u0442\u044c\u0435 \u0431\u044b\u043b\u043e \u043d\u0435\u0434\u043e\u043b\u0433\u0438\u043c.
    \u0412 1809 \u0433\u043e\u0434\u0443 \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u0443\u043c\u0435\u0440\u043b\u0430
    \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u0440\u043e\u0434\u043e\u0432,
    \u0430 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0438 \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0441\u044b\u043d.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0442\u044f\u0436\u0435\u043b\u044b\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c \u0434\u043b\u044f \u0443\u0447\u0435\u043d\u043e\u0433\u043e.
    \u0412 1810 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437 \u2014 \u043d\u0430
    \u041c\u0438\u043d\u0435 \u0412\u0430\u043b\u044c\u0434\u0435\u043a, \u043b\u0443\u0447\u0448\u0435\u0439
    \u043f\u043e\u0434\u0440\u0443\u0433\u0435 \u0418\u043e\u0433\u0430\u043d\u043d\u044b. \u0412
    \u044d\u0442\u043e\u043c \u0431\u0440\u0430\u043a\u0435 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0435\u0449\u0435 \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439, \u043d\u043e,
    \u043f\u043e \u043e\u0442\u0437\u044b\u0432\u0430\u043c, \u043e\u043d \u0431\u044b\u043b
    \u043d\u0435 \u0442\u0430\u043a\u0438\u043c \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c.
    \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u0432\u0435\u0445\u0438 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f: \u0412 1809 \u0433\u043e\u0434\u0443
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 Theoria motus corporum coelestium (\u00ab\u0422\u0435\u043e\u0440\u0438\u044f
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0445
    \u0442\u0435\u043b\u00bb), \u0433\u0434\u0435 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u0439 \u043c\u0435\u0442\u043e\u0434
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u043e\u0440\u0431\u0438\u0442. \u0413\u0435\u043e\u0434\u0435\u0437\u0438\u044f:
    \u0421 1818 \u043f\u043e 1832 \u0433\u043e\u0434 \u0413\u0430\u0443\u0441\u0441 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u043e\u0439 \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u044a\u0435\u043c\u043a\u043e\u0439 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u0442\u0432\u0430
    \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440. \u0414\u043b\u044f \u044d\u0442\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043d \u0438\u0437\u043e\u0431\u0440\u0451\u043b
    \u0433\u0435\u043b\u0438\u043e\u0442\u0440\u043e\u043f \u2014 \u043f\u0440\u0438\u0431\u043e\u0440
    \u0434\u043b\u044f \u0442\u043e\u0447\u043d\u043e\u0439 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438
    \u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f\u0445.
    \u0417\u0430\u043d\u044f\u0442\u0438\u044f \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0435\u0439
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u0435\u0433\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u2014 Disquisitiones generales circa
    superficies curvas (\u00ab\u041e\u0431\u0449\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u043e \u043a\u0440\u0438\u0432\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445\u00bb,
    1827). \u0412 \u043d\u0435\u0439 \u043e\u043d \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u0433\u0430\u0443\u0441\u0441\u043e\u0432\u043e\u0439 \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u044b
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    Theorema Egregium (\u0412\u044b\u0434\u0430\u044e\u0449\u0443\u044e\u0441\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0443),
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438
    \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0435\u0435
    \u0438\u0437\u0433\u0438\u0431\u0430\u043d\u0438\u0438 \u0431\u0435\u0437 \u0440\u0430\u0441\u0442\u044f\u0436\u0435\u043d\u0438\u044f.
    \u0424\u0438\u0437\u0438\u043a\u0430 \u0438 \u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c:
    \u0412 1830-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0413\u0430\u0443\u0441\u0441 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u0444\u0438\u0437\u0438\u043a\u043e\u043c
    \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u043e\u043c \u0412\u0435\u0431\u0435\u0440\u043e\u043c
    \u043d\u0430\u0447\u0430\u043b \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0437\u0435\u043c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c\u0430. \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e\u0433\u043e
    \u043f\u043e\u043b\u044f \u0417\u0435\u043c\u043b\u0438 \u0438 \u0432 1833 \u0433\u043e\u0434\u0443
    \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u043c\u0438\u0440\u0435
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0438\u0442\u043d\u044b\u0439
    \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u0444, \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0432\u0448\u0438\u0439
    \u0438\u0445 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435.
    \u041e\u043d\u0438 \u0442\u0430\u043a\u0436\u0435 \u0441\u043e\u0437\u0434\u0430\u043b\u0438
    \u043c\u0430\u0433\u043d\u0438\u0442\u043e\u043c\u0435\u0442\u0440 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e\u0433\u043e
    \u043f\u043e\u043b\u044f. \u041d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d \u0432 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438
    \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u043d\u043e \u0431\u043e\u044f\u043b\u0441\u044f \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438, \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c
    \u00ab\u043a\u0440\u0438\u043a\u0430 \u0431\u0435\u043e\u0442\u0438\u0439\u0446\u0435\u0432\u00bb,
    \u043a\u0430\u043a \u043e\u043d \u043f\u0438\u0441\u0430\u043b. \u041a\u043e\u0433\u0434\u0430
    \u043e\u043d \u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438
    \u042f\u043d\u043e\u0448\u0430 \u0411\u043e\u0439\u044f\u0438 \u0438 \u041d\u0438\u043a\u043e\u043b\u0430\u044f
    \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u043e\u0433\u043e, \u043e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u043b
    \u0438\u0445, \u043d\u043e \u043e\u0442\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e
    \u0441\u0430\u043c \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0442\u0435\u043c \u0436\u0435
    \u0432\u044b\u0432\u043e\u0434\u0430\u043c \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u0440\u0430\u043d\u044c\u0448\u0435.
    \u041b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u043a\u043e\u043d\u0447\u0438\u043d\u0430
    \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441\u043b\u043e\u0436\u043d\u044b\u043c: \u043e\u043d \u043d\u0435 \u043b\u044e\u0431\u0438\u043b
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u0443\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0443\u0447\u0435\u043d\u0438\u043a\u0438, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0420\u0438\u043c\u0430\u043d \u0438 \u0420\u0438\u0445\u0430\u0440\u0434
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434. \u041e\u043d \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043d \u043a \u0441\u0435\u0431\u0435
    \u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b, \u0438\u0437-\u0437\u0430
    \u0447\u0435\u0433\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0431\u044b\u0441\u0442\u0440\u043e\u0435
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0424\u0443\u0440\u044c\u0435)
    \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u043d\u0435\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438
    \u0438 \u0431\u044b\u043b\u0438 \u043f\u0435\u0440\u0435\u043e\u0442\u043a\u0440\u044b\u0442\u044b
    \u043f\u043e\u0437\u0436\u0435. \u041a\u0430\u0440\u043b \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    \u0413\u0430\u0443\u0441\u0441 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 23
    \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1855 \u0433\u043e\u0434\u0430 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 77 \u043b\u0435\u0442 \u043e\u0442
    \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439 \u0438 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438.
    \u041e\u043d \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435 \u0410\u043b\u044c\u0431\u0430\u043d\u0438
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0413\u0430\u0443\u0441\u0441\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e: \u0435\u0433\u043e
    \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0441\u043e\u0442\u043d\u0438
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043f\u043e\u043d\u044f\u0442\u0438\u0439, \u0435\u0434\u0438\u043d\u0438\u0446
    \u0438 \u0442\u0435\u043e\u0440\u0435\u043c. \u041f\u043e \u0448\u0438\u0440\u043e\u0442\u0435
    \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0430
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u0435\u0433\u043e \u0441\u0442\u0430\u0432\u044f\u0442
    \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434 \u0441 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u043c
    \u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c."
  shortBioEn: "Johann Carl Friedrich Gauss (1777–1855) is a German mathematician, astronomer, surveyor and physicist who was once recognized as the greatest mathematician of his time and was awarded the title \"Princeps Mathematicum\" (King of Mathematics), and his life is a story of a genius born in a poor family and thanks to his talent and his patronymics in many fields of science.==Early years and education==Gowss was born on April 30, 1777 in Brownschweig, a family of poor parents, and his father, Gebhard Dietrich Gauss, worked as a butcher, gardener, stonemaker and treasurer.The Vunderkind of Power of Gauss showed up surprisingly early. There is a legend that at the age of three, he noticed a mistake in his father's calculations. At the elementary school, when the teacher asked the students to add the numbers from 1 to 100, young Gauss answered instantly - 5050. Instead of adding consecutively, he realized that it was possible to combine the numbers into 50 pairs: 1+100, 2+99, etc., each of which gives 101.In 1791, he was presented to the Duke of Brownschweig, Carl Wilhelm Ferdinand, who was so impressed that he took over the funding of his education.At the university, he attended lectures on classical philology and mathematics, but it was the discovery he made at age 18 that determined his way: proof of the possibility of building the right 17-column with a circus and a line; this was the first major achievement in this field since antiquity, and after that, Gauss finally chose mathematics.===Bronschweig period===In 1798–1807, Gaussa returned to Brownschweig and continued to receive a scholarship from the Duke, enabling him to study science without an official position, and in 1799 he received a Ph.D. from Helmstedt University, protecting his dissertation, which contained the first strict proof of the algebra's basic theorem.\"Arhymetic Research\" and world fame was published in 1801 by his main mathematical work, Disquisions Arichmeticae, which laid the foundation for modern numbers theory, including modular arithmetic, and the triumph of astronomers brought the true world glory to Gausus not pure mathematics, but astronomy.In January 1801, Italian astronomer Giuseppe Pyazzi discovered the dwarf planet Cerera, but soon lost sight of it. Many scientists tried to predict its future position, but failed. Gauss, who was only 24 years old, used his new method of least squares to process scarce data and calculated Cerera's orbit with incredible accuracy.In 1807, Göttingen's professor accepted an invitation to become a professor of astronomy and director of the observatory at Göttingen University, where he worked for the rest of his life.In 1809, Johanna died shortly after childbirth, and a few months later, a newborn son died as a severe blow to the scientist. In 1810, he married for the second time, Mina Valdek, the best friend of Johanna, and three more children were born in that marriage, but he was not, according to reports, so happy.In 1809, he published the fundamental work of Theoria motus corporum coelestium, which detailed his orbital method.The survey led to the creation of an outstanding work on differential geometry, Disquisions generales circa superficies curvas, 1827. In it he introduced the concept of Gaussian crookedity and proved his famous Theorema Egregium, which claims that the surface crookedness does not change when it is bent without stretch.Physics and magnetism: In the 1830s, Gauss, together with young physicist Wilhelm Weber, began intensive research on the Earth's magnetism and developed the Earth's magnetic field theory and, in 1833, invented the world's first electromagnetic telegraph to connect them to the laboratories in Göttingen, and created a magnetometer to measure magnetic field tension.Neeuclida Geometry: Throughout his life, Gauss was convinced of the existence of non-euclidian geometry, but was afraid to publish his ideas, fearing the \"cry of the Beotians,\" as he wrote. When he read the works of Janos Boyai and Nikolai Lobachevsky, he acknowledged them, but noted that he himself had come to the same conclusion much earlier.The personality and death of Gauss was a complex man: he did not like teaching and preferred private work, even though he had distinguished students such as Bernhard Riman and Richard Dedecind, who were incredibly demanding and published only carefully tested results, so that many of his discoveries (e.g. the rapid transformation of Furier) were left unpublished and re-opened later.He died on 23 February 1855 in Göttingen, aged 77, of heart and lung failure, and was buried in the Albany cemetery in Göttingen, and his legacy is enormous, with hundreds of scientific concepts, units and theorem named after him, and he is placed in the same row as Archimedes and Newton in the breadth and depth of his contribution to science."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041a\u0430\u0440\u043b\u0430 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430
    \u0413\u0430\u0443\u0441\u0441\u0430 \u043f\u043e\u043b\u043d\u0430 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u0432:
    \u0433\u0435\u043d\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0438\u0434\u0435\u043b
    \u0437\u0430\u043a\u043e\u043d\u044b \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439,
    \u043d\u043e \u043d\u0435 \u043c\u043e\u0433 \u043d\u0430\u0439\u0442\u0438 \u043e\u0431\u0449\u0438\u0439
    \u044f\u0437\u044b\u043a \u0441 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u0434\u0435\u0442\u044c\u043c\u0438; \u043f\u0435\u0440\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442,
    \u0431\u043e\u044f\u0432\u0448\u0438\u0439\u0441\u044f \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438, \u043d\u043e \u043f\u0440\u0438
    \u044d\u0442\u043e\u043c \u0441\u0434\u0435\u043b\u0430\u0432\u0448\u0438\u0439 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f \u0432\u043f\u0435\u0440\u0435\u0434.
    \u0427\u0442\u043e\u0431\u044b \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u044d\u0442\u043e \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u044f \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u043b
    \u0444\u0430\u043a\u0442\u044b \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439: \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u0447\u0443\u0434\u0430\u0447\u0435\u0441\u0442\u0432\u0430, \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u043a\u0443\u0440\u044c\u0435\u0437\u044b, \u0431\u044b\u0442\u043e\u0432\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u0438,
    \u0432\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0438 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0435
    \u0437\u0430\u0433\u0430\u0434\u043a\u0438. --- 1. \u0414\u0435\u0442\u0441\u0442\u0432\u043e:
    \u0413\u0435\u043d\u0438\u0439 \u0432 \u043a\u043e\u043b\u044b\u0431\u0435\u043b\u0438 -
    \u041f\u043e\u043f\u0440\u0430\u0432\u043a\u0430 \u043e\u0442\u0446\u0443 \u0432 3 \u0433\u043e\u0434\u0430:
    \u0421\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043b\u0435\u0433\u0435\u043d\u0434\u0430
    \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e \u043a\u043e\u0433\u0434\u0430
    \u043e\u0442\u0435\u0446 \u0413\u0435\u0431\u0445\u0430\u0440\u0434 \u043f\u043e\u0434\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b
    \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u0443 \u0440\u0430\u0431\u043e\u0447\u0438\u043c,
    \u0442\u0440\u0435\u0445\u043b\u0435\u0442\u043d\u0438\u0439 \u041a\u0430\u0440\u043b, \u0441\u0438\u0434\u044f
    \u043d\u0430 \u043f\u043e\u043b\u0443 \u0438 \u0438\u0433\u0440\u0430\u044f, \u0432\u0434\u0440\u0443\u0433
    \u0437\u0430\u044f\u0432\u0438\u043b: \u00ab\u041f\u0430\u043f\u0430, \u0440\u0430\u0441\u0447\u0435\u0442
    \u043d\u0435\u0432\u0435\u0440\u0435\u043d, \u0442\u0430\u043c \u0434\u043e\u043b\u0436\u043d\u043e
    \u0431\u044b\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435\u00bb. \u041e\u0442\u0435\u0446
    \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043b \u0438, \u043a \u0441\u0432\u043e\u0435\u043c\u0443
    \u0438\u0437\u0443\u043c\u043b\u0435\u043d\u0438\u044e, \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b
    \u043e\u0448\u0438\u0431\u043a\u0443. \u0413\u0430\u0443\u0441\u0441 \u0432\u0441\u044e
    \u0436\u0438\u0437\u043d\u044c \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b \u044d\u0442\u043e\u0442
    \u044d\u043f\u0438\u0437\u043e\u0434 \u043a\u0430\u043a \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u043b \u0441\u0447\u0438\u0442\u0430\u0442\u044c
    \u0440\u0430\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c.
    - \u0421\u043f\u0430\u0441\u0435\u043d\u0438\u0435 \u043e\u0442 \u043d\u0438\u0449\u0435\u0442\u044b
    \u0447\u0435\u0440\u0435\u0437 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443:
    \u0423\u0447\u0438\u0442\u0435\u043b\u044c \u0413\u0430\u0443\u0441\u0441\u0430 \u0432 \u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435, \u0411\u044e\u0442\u0442\u043d\u0435\u0440, \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u0434\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0443 \u0441\u043b\u043e\u0436\u0438\u0442\u044c
    \u0447\u0438\u0441\u043b\u0430 \u043e\u0442 1 \u0434\u043e 100, \u0447\u0442\u043e\u0431\u044b
    \u0437\u0430\u043d\u044f\u0442\u044c \u043a\u043b\u0430\u0441\u0441 \u043d\u0430 \u043f\u0430\u0440\u0443
    \u0447\u0430\u0441\u043e\u0432. \u0413\u0430\u0443\u0441\u0441 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u0433\u0440\u0438\u0444\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u043e\u0441\u043a\u0435 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e. \u0411\u044e\u0442\u0442\u043d\u0435\u0440,
    \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439, \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b:
    \u00ab\u0418\u0437 \u044d\u0442\u043e\u0433\u043e \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430
    \u043d\u0435 \u0432\u044b\u0439\u0434\u0435\u0442 \u043e\u0431\u044b\u0447\u043d\u044b\u0439
    \u043c\u044f\u0441\u043d\u0438\u043a!\u00bb \u0418\u043c\u0435\u043d\u043d\u043e \u0411\u044e\u0442\u0442\u043d\u0435\u0440
    \u0438 \u0435\u0433\u043e \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442 \u0411\u0430\u0440\u0442\u0435\u043b\u044c\u0441
    \u0443\u0431\u0435\u0434\u0438\u043b\u0438 \u0433\u0435\u0440\u0446\u043e\u0433\u0430 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0441\u043a\u043e\u0433\u043e
    \u043e\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435
    \u0413\u0430\u0443\u0441\u0441\u0430. \u0415\u0441\u043b\u0438 \u0431\u044b \u043d\u0435
    \u044d\u0442\u0430 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430,
    \u0413\u0430\u0443\u0441\u0441, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e,
    \u0441\u0442\u0430\u043b \u0431\u044b \u043a\u0430\u043c\u0435\u043d\u0449\u0438\u043a\u043e\u043c,
    \u043a\u0430\u043a \u0435\u0433\u043e \u0434\u0435\u0434. - \u042f\u0437\u044b\u043a\u043e\u0432\u043e\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442: \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
    \u0413\u0430\u0443\u0441\u0441 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b \u043d\u0435
    \u043c\u0435\u043d\u044c\u0448\u0438\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a
    \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0438, \u0447\u0435\u043c \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041f\u043e\u0441\u0442\u0443\u043f\u0438\u0432 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u043e\u043d \u0434\u043e\u043b\u0433\u043e \u043a\u043e\u043b\u0435\u0431\u0430\u043b\u0441\u044f
    \u043c\u0435\u0436\u0434\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u044f\u0437\u044b\u043a\u0430\u043c\u0438
    (\u043b\u0430\u0442\u044b\u043d\u044c\u044e \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c).
    \u0414\u0430\u0436\u0435 \u0441\u0442\u0430\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043e\u043d \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u0447\u0438\u0442\u0430\u043b
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u0432
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435 \u0438 \u0432\u0435\u043b \u0441\u0432\u043e\u0438
    \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0438 \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438
    \u2014 \u043e\u0442\u0447\u0430\u0441\u0442\u0438 \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043d\u0435 \u043c\u043e\u0433\u043b\u0438 \u0435\u0433\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c.
    --- 2. \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u043a\u0443\u0440\u044c\u0435\u0437\u044b:
    \u041e\u043f\u0435\u0440\u0435\u0436\u0430\u044f \u0432\u0440\u0435\u043c\u044f \u043d\u0430
    \u0432\u0435\u043a\u0430 - \u041f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u00ab\u041a\u043d\u044f\u0437\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432\u00bb:
    \u0425\u043e\u0442\u044f \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u0435\u0433\u043e
    \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u0435\u0433\u043e
    \u043f\u0435\u0440\u0432\u0430\u044f \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u0430\u044f
    \u0441\u043b\u0430\u0432\u0430 \u0431\u044b\u043b\u0430... \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439.
    \u041a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043b
    \u043e\u0440\u0431\u0438\u0442\u0443 \u0426\u0435\u0440\u0435\u0440\u044b, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c \u0416\u043e\u0437\u0435\u0444 \u041b\u0430\u043b\u0430\u043d\u0434
    \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b: \u00ab\u042d\u0442\u043e\u0442
    \u043d\u0435\u043c\u0435\u0446 \u043d\u0430\u0448\u0435\u043b \u043f\u043b\u0430\u043d\u0435\u0442\u0443,
    \u0441\u0438\u0434\u044f \u0432 \u043a\u0440\u0435\u0441\u043b\u0435, \u043d\u0435 \u0433\u043b\u044f\u0434\u044f
    \u0432 \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f!\u00bb \u0418\u043c\u0435\u043d\u043d\u043e
    \u0437\u0430 \u044d\u0442\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0435\u0433\u043e \u043f\u0440\u043e\u0437\u0432\u0430\u043b\u0438 Princeps Mathematicorum,
    \u0445\u043e\u0442\u044f \u0442\u0438\u0442\u0443\u043b \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f
    \u043a\u043e \u0432\u0441\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    - \u0428\u0438\u0444\u0440 \u0434\u043b\u044f \u0432\u043e\u0435\u043d\u043d\u044b\u0445:
    \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0430\u0440\u0430\u043d\u043e\u0438\u0434\u0430\u043b\u0435\u043d \u0432 \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u0445
    \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0441\u0442\u0438, \u0447\u0442\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u043b\u043e\u0436\u043d\u044b\u0439
    \u0448\u0438\u0444\u0440 \u0434\u043b\u044f \u043b\u0438\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438
    \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438. \u0410 \u0432 1810-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u044b \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0434\u043b\u044f \u0432\u043e\u0435\u043d\u043d\u043e\u0439 \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0446\u0438\u0438,
    \u043d\u043e \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0438 \u0441\u043e\u0447\u043b\u0438
    \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u00ab\u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f\u00bb.
    - \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0430\u0448\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 150 \u043b\u0435\u0442: \u0412
    1805 \u0433\u043e\u0434\u0443 \u0413\u0430\u0443\u0441\u0441 \u0438\u0437\u043e\u0431\u0440\u0435\u043b
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0411\u044b\u0441\u0442\u0440\u043e\u0433\u043e
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0424\u0443\u0440\u044c\u0435
    (\u0411\u041f\u0424), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u0432 \u0440\u0430\u0437\u044b \u0443\u0441\u043a\u043e\u0440\u0438\u0442\u044c \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0443
    \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432. \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432, \u043d\u043e \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043b
    \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0438 \u043d\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b.
    \u041a\u043e\u0433\u0434\u0430 \u0432 1965 \u0433\u043e\u0434\u0443 \u041a\u0443\u043b\u0438
    \u0438 \u0422\u044c\u044e\u043a\u0438 \u00ab\u043f\u0435\u0440\u0435\u043e\u0442\u043a\u0440\u044b\u043b\u0438\u00bb
    \u0411\u041f\u0424, \u044d\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439
    \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0435 (\u0431\u0435\u0437 \u044d\u0442\u043e\u0433\u043e
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u044b JPEG, MP3 \u0438 \u0441\u043e\u0442\u043e\u0432\u043e\u0439
    \u0441\u0432\u044f\u0437\u0438). \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043d\u0430\u0448\u043b\u0438
    \u0437\u0430\u043f\u0438\u0441\u0438 \u0413\u0430\u0443\u0441\u0441\u0430 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f.
    - \u0422\u0430\u0439\u043d\u0430 \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438: \u0413\u0430\u0443\u0441\u0441 \u0437\u043d\u0430\u043b
    \u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0443\u0436\u0435 \u0432 1810-\u0445 \u0433\u043e\u0434\u0430\u0445, \u043d\u043e \u0438\u0441\u043f\u0443\u0433\u0430\u043b\u0441\u044f
    \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c. \u041e\u043d \u043f\u0438\u0441\u0430\u043b
    \u0434\u0440\u0443\u0433\u0443 \u0411\u0435\u0441\u0441\u0435\u043b\u044e: \u00ab\u042f
    \u0431\u043e\u044e\u0441\u044c \u043a\u0440\u0438\u043a\u0430 \u0431\u0435\u043e\u0442\u0438\u0439\u0446\u0435\u0432\u00bb
    (\u0442\u0430\u043a \u0434\u0440\u0435\u0432\u043d\u0438\u0435 \u0433\u0440\u0435\u043a\u0438
    \u043f\u0440\u0435\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u0433\u043b\u0443\u043f\u0446\u043e\u0432). \u041a\u043e\u0433\u0434\u0430 \u043c\u043e\u043b\u043e\u0434\u043e\u0439
    \u0432\u0435\u043d\u0433\u0440 \u042f\u043d\u043e\u0448 \u0411\u043e\u0439\u044f\u0438 \u0432
    1830-\u0445 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0413\u0430\u0443\u0441\u0441 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0435\u043c\u0443: \u00ab\u0425\u0432\u0430\u043b\u0438\u0442\u044c \u044d\u0442\u0443
    \u0440\u0430\u0431\u043e\u0442\u0443 \u2014 \u0437\u043d\u0430\u0447\u0438\u0442 \u0445\u0432\u0430\u043b\u0438\u0442\u044c
    \u0441\u0435\u0431\u044f \u0441\u0430\u043c\u043e\u0433\u043e, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u044f \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0442\u043e\u043c\u0443
    \u0436\u0435 30 \u043b\u0435\u0442 \u043d\u0430\u0437\u0430\u0434\u00bb. \u0411\u043e\u0439\u044f\u0438
    \u0431\u044b\u043b \u0440\u0430\u0437\u0434\u0430\u0432\u043b\u0435\u043d \u0438 \u0431\u043e\u043b\u044c\u0448\u0435
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0440\u0443\u0434\u043e\u0432.
    --- 3. \u0411\u044b\u0442\u043e\u0432\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0447\u0443\u0434\u0430\u0447\u0435\u0441\u0442\u0432\u0430 (\u0418\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u044f)
    - \u041f\u0430\u0440\u0430\u043d\u043e\u0439\u044f \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443
    \u0437\u0443\u0431\u043d\u043e\u0439 \u0431\u043e\u043b\u0438: \u0413\u0430\u0443\u0441\u0441
    \u043f\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u043e\u044f\u043b\u0441\u044f
    \u0441\u0442\u043e\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u043e\u0432. \u0423 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u0438 \u0443\u0436\u0430\u0441\u043d\u044b\u0435 \u0437\u0443\u0431\u044b,
    \u0438 \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u043b\u0438
    \u0431\u043e\u043b\u0435\u0442\u044c, \u043e\u043d \u043d\u0435 \u0448\u0435\u043b \u043a
    \u0432\u0440\u0430\u0447\u0443, \u0430 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0431\u043e\u043b\u0438. \u041e\u043d \u043d\u043e\u0441\u0438\u043b \u0441 \u0441\u043e\u0431\u043e\u0439
    \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u043d\u0443\u044e
    \u043a\u043d\u0438\u0436\u043a\u0443, \u0432 \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b, \u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u0438\u043d\u0443\u0442 \u0434\u043b\u0438\u0442\u0441\u044f \u043f\u0440\u0438\u0441\u0442\u0443\u043f,
    \u0438 \u0432\u044b\u0432\u043e\u0434\u0438\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u00ab\u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u043e\u0441\u0442\u0438\u00bb
    \u0437\u0443\u0431\u043d\u043e\u0439 \u0431\u043e\u043b\u0438, \u043f\u044b\u0442\u0430\u044f\u0441\u044c
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0440\u0430\u043d\u0435\u0435
    \u0432\u044b\u043f\u0438\u0442\u044c \u043e\u043f\u0438\u0439. - \u0422\u0435\u0440\u043c\u043e\u043c\u0435\u0442\u0440
    \u0432 \u0434\u043e\u043c\u0435: \u0413\u0430\u0443\u0441\u0441 \u043d\u0435 \u0432\u044b\u043d\u043e\u0441\u0438\u043b
    \u0441\u043a\u0432\u043e\u0437\u043d\u044f\u043a\u043e\u0432. \u0423 \u0441\u0435\u0431\u044f
    \u0432 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0435 \u043e\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043d\u0435 \u0432\u044b\u0448\u0435
    14\u00b0C \u0437\u0438\u043c\u043e\u0439, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u0445\u043e\u043b\u043e\u0434\u043d\u044b\u0435
    \u043d\u043e\u0433\u0438. \u041e\u043d \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443: \u0441\u0438\u0434\u0435\u0442\u044c \u0437\u0430
    \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u043c \u0441\u0442\u043e\u043b\u043e\u043c
    \u0441 \u043d\u043e\u0433\u0430\u043c\u0438, \u0437\u0430\u043a\u0443\u0442\u0430\u043d\u043d\u044b\u043c\u0438
    \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u043e\u0435\u0432
    \u0448\u0435\u0440\u0441\u0442\u044f\u043d\u044b\u0445 \u043e\u0434\u0435\u044f\u043b, \u0438
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043d\u043e\u0441\u0438\u0442\u044c
    \u043c\u0435\u0445\u043e\u0432\u0443\u044e \u0448\u0430\u043f\u043a\u0443 \u0432 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0438.
    \u0421\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u043f\u0440\u043e\u0437\u0432\u0430\u043b\u0438
    \u0435\u0433\u043e \u00ab\u043c\u0435\u0434\u0432\u0435\u0434\u0435\u043c \u0432 \u0431\u0435\u0440\u043b\u043e\u0433\u0435\u00bb.
    - \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043f\u0435\u0440\u0435\u0434
    \u0441\u043d\u043e\u043c: \u0427\u0442\u043e\u0431\u044b \u0443\u0441\u043d\u0443\u0442\u044c,
    \u0413\u0430\u0443\u0441\u0441 \u043d\u0435 \u0447\u0438\u0442\u0430\u043b \u0440\u043e\u043c\u0430\u043d\u043e\u0432,
    \u0430 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u043b \u0432 \u0443\u043c\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430 \u0438\u043b\u0438 \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0442\u0443 \u0438\u043b\u0438 \u0438\u043d\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443.
    \u0412 \u043f\u0438\u0441\u044c\u043c\u0435 \u0434\u0440\u0443\u0433\u0443 \u043e\u043d
    \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0441\u044f, \u0447\u0442\u043e \u043d\u043e\u0447\u044c\u044e
    \u0432 \u043f\u043e\u043b\u0443\u0434\u0440\u0435\u043c\u0435 \u0435\u043c\u0443 \u0447\u0430\u0441\u0442\u043e
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043d\u0435\u043c
    \u043e\u043d \u043d\u0435 \u043c\u043e\u0433 \u043e\u0441\u0438\u043b\u0438\u0442\u044c.
    - \u041f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u043a \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0439
    \u043f\u0438\u0449\u0435: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u043e\u0433\u0440\u043e\u043c\u043d\u0443\u044e \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u0443
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430, \u0413\u0430\u0443\u0441\u0441
    \u043f\u0438\u0442\u0430\u043b\u0441\u044f \u043a\u0430\u043a \u0431\u0435\u0434\u043d\u044f\u043a.
    \u041e\u043d \u043c\u043e\u0433 \u0435\u0441\u0442\u044c \u043e\u0434\u0438\u043d \u0438
    \u0442\u043e\u0442 \u0436\u0435 \u0441\u0443\u043f \u0438\u0437 \u043a\u0430\u0440\u0442\u043e\u0444\u0435\u043b\u044f
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u043f\u043e\u0434\u0440\u044f\u0434,
    \u0441\u0447\u0438\u0442\u0430\u044f, \u0447\u0442\u043e \u0442\u0440\u0430\u0442\u0438\u0442\u044c
    \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0430 \u0434\u0435\u043b\u0438\u043a\u0430\u0442\u0435\u0441\u044b
    \u2014 \u044d\u0442\u043e \u00ab\u0440\u0430\u0441\u0442\u043e\u0447\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e,
    \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u044f\u044e\u0449\u0435\u0435 \u0440\u0430\u0437\u0443\u043c\u00bb.
    \u041a\u043e\u043b\u043b\u0435\u0433\u0438 \u0448\u0443\u0442\u0438\u043b\u0438, \u0447\u0442\u043e
    \u0413\u0430\u0443\u0441\u0441 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442 \u043d\u0430
    \u0435\u0434\u0435, \u0447\u0442\u043e\u0431\u044b \u043a\u0443\u043f\u0438\u0442\u044c
    \u043d\u043e\u0432\u044b\u0439 \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f. --- 4.
    \u0412\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438:
    \u00ab\u042f \u2014 \u0433\u043e\u0440\u0430, \u043e\u043d\u0438 \u2014 \u0432\u0435\u0442\u0435\u0440\u00bb
    - \u041d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u044c \u043a \u00ab\u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0439\u00bb
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435: \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b
    \u0443\u0436\u0430\u0441\u043d\u044b\u043c \u043b\u0435\u043a\u0442\u043e\u0440\u043e\u043c.
    \u041e\u043d \u0447\u0438\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b
    \u043c\u043e\u043d\u043e\u0442\u043e\u043d\u043d\u044b\u043c \u0433\u043e\u043b\u043e\u0441\u043e\u043c,
    \u0447\u0430\u0441\u0442\u043e \u0431\u0443\u0431\u043d\u0438\u043b \u0441\u0435\u0431\u0435
    \u043f\u043e\u0434 \u043d\u043e\u0441 \u0438 \u0434\u0435\u043b\u0430\u043b \u043e\u0448\u0438\u0431\u043a\u0438
    \u043d\u0430 \u0434\u043e\u0441\u043a\u0435. \u041e\u0434\u043d\u0430\u043a\u043e, \u0435\u0441\u043b\u0438
    \u0432 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438 \u0441\u0438\u0434\u0435\u043b
    \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0439 \u0441\u0442\u0443\u0434\u0435\u043d\u0442
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043c\u043e\u043b\u043e\u0434\u043e\u0439
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0420\u0438\u043c\u0430\u043d), \u0413\u0430\u0443\u0441\u0441
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0436\u0430\u043b\u0441\u044f, \u043d\u0430\u0447\u0438\u043d\u0430\u043b
    \u0431\u043b\u0435\u0441\u0442\u0435\u0442\u044c \u0433\u043b\u0430\u0437\u0430\u043c\u0438
    \u0438 \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438 \u0442\u0430\u043a
    \u0441\u043b\u043e\u0436\u043d\u043e, \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435
    \u043f\u043e\u043d\u0438\u043c\u0430\u043b\u0438. \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e
    \u0435\u0433\u043e \u043a\u0443\u0440\u0441 \u0441\u043b\u0443\u0448\u0430\u043b\u0438 \u0435\u0434\u0438\u043d\u0438\u0446\u044b.
    - \u0412\u043e\u0439\u043d\u0430 \u0441 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u043e\u043c:
    \u0413\u0430\u0443\u0441\u0441 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u043e\u0432
    \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0432 1806
    \u0433\u043e\u0434\u0443 \u0432\u043e\u0439\u0441\u043a\u0430 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430
    \u043e\u043a\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433
    \u0438 \u0443\u0431\u0438\u043b\u0438 \u0435\u0433\u043e \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044f,
    \u0433\u0435\u0440\u0446\u043e\u0433\u0430. \u0413\u0430\u0443\u0441\u0441 \u0432\u043f\u0430\u043b
    \u0432 \u044f\u0440\u043e\u0441\u0442\u044c, \u043a\u043e\u0433\u0434\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u043f\u0440\u0438\u0441\u043b\u0430\u043b
    \u0435\u043c\u0443 \u043b\u0435\u0441\u0442\u043d\u043e\u0435 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u0442\u044c \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e. \u0413\u0430\u0443\u0441\u0441 \u043e\u0442\u0432\u0435\u0442\u0438\u043b
    \u0432\u0435\u0436\u043b\u0438\u0432\u044b\u043c, \u043d\u043e \u043b\u0435\u0434\u044f\u043d\u044b\u043c
    \u043e\u0442\u043a\u0430\u0437\u043e\u043c, \u0430 \u0432 \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0435
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \u00ab\u041f\u0443\u0441\u0442\u044c \u043a\u043e\u0440\u0441\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439
    \u0432\u044b\u0441\u043a\u043e\u0447\u043a\u0430 \u0443\u043c\u0440\u0435\u0442 \u0432 \u0441\u043d\u0435\u0433\u0430\u0445
    \u0420\u043e\u0441\u0441\u0438\u0438\u00bb (\u044d\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e\u043c). - \u0421\u043e\u043f\u0435\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u043e\u043c: \u0410\u0434\u0440\u0438\u0435\u043d-\u041c\u0430\u0440\u0438
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0438 \u0413\u0430\u0443\u0441\u0441 \u043f\u043e\u0447\u0442\u0438
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u043b\u0438
    \u041c\u0435\u0442\u043e\u0434 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432. \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c,
    \u043d\u043e \u0413\u0430\u0443\u0441\u0441 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0432
    \u043f\u0440\u0435\u0434\u0438\u0441\u043b\u043e\u0432\u0438\u0438 \u043a \u0441\u0432\u043e\u0435\u0439
    \u043a\u043d\u0438\u0433\u0435, \u0447\u0442\u043e \u00ab\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0435\u0449\u0435 \u0432 1794 \u0433\u043e\u0434\u0443\u00bb.
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0431\u044b\u043b \u0432\u0437\u0431\u0435\u0448\u0435\u043d
    \u0438 \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0413\u0430\u0443\u0441\u0441\u0430 \u0432
    \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435, \u043d\u0430 \u0447\u0442\u043e \u0413\u0430\u0443\u0441\u0441
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u0415\u0441\u043b\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u043c\u043e\u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u044b \u0426\u0435\u0440\u0435\u0440\u044b
    \u0431\u044b\u043b\u0438 \u0441\u0434\u0435\u043b\u0430\u043d\u044b \u043f\u043e\u0437\u0436\u0435,
    \u043f\u0443\u0441\u0442\u044c \u0437\u0430\u043c\u043e\u043b\u0447\u0438\u0442\u00bb. \u041e\u043d\u0438
    \u0442\u0430\u043a \u0438 \u043d\u0435 \u043f\u043e\u043c\u0438\u0440\u0438\u043b\u0438\u0441\u044c,
    \u0445\u043e\u0442\u044f \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b \u043f\u0440\u0430\u0432
    \u2014 \u0435\u0433\u043e \u0441\u0442\u0430\u0440\u044b\u0435 \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0438
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u0438 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442.
    - \u0414\u0440\u0443\u0436\u0431\u0430 \u0441 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u043c
    \u0413\u0443\u043c\u0431\u043e\u043b\u044c\u0434\u0442\u043e\u043c: \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a \u0413\u0443\u043c\u0431\u043e\u043b\u044c\u0434\u0442
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0445,
    \u043a\u0442\u043e \u043c\u043e\u0433 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c
    \u0413\u0430\u0443\u0441\u0441\u0430. \u041a\u043e\u0433\u0434\u0430 \u0413\u0443\u043c\u0431\u043e\u043b\u044c\u0434\u0442
    \u043f\u0440\u0438\u0435\u0437\u0436\u0430\u043b \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d,
    \u043e\u043d\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u043b\u0438\u0441\u044c \u0432 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0435
    \u043d\u0430 12 \u0447\u0430\u0441\u043e\u0432, \u043f\u0438\u043b\u0438 \u043a\u043e\u0444\u0435
    \u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438 \u043e \u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c\u0435
    \u0417\u0435\u043c\u043b\u0438. \u0413\u0443\u043c\u0431\u043e\u043b\u044c\u0434\u0442 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u0432\u0430\u0436\u0430\u043b \u0413\u0430\u0443\u0441\u0441\u0430, \u0447\u0442\u043e
    \u043f\u0440\u043e\u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0435\u0433\u043e
    \u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e\u0439 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438
    \u0438\u0437 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u0430\u0440\u043c\u0430\u043d\u0430.
    --- 5. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044e\u043c\u043e\u0440 \u0438 \u0430\u0444\u043e\u0440\u0438\u0437\u043c\u044b - \u00ab\u041c\u0430\u043b\u043e,
    \u043d\u043e \u0433\u0440\u044f\u0437\u043d\u043e\u00bb: \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442
    \u0442\u0430\u043a \u043c\u0430\u043b\u043e \u0440\u0430\u0431\u043e\u0442 (\u043f\u043e
    \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u042d\u0439\u043b\u0435\u0440\u043e\u043c,
    \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0442\u044b\u0441\u044f\u0447\u0438
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446), \u0413\u0430\u0443\u0441\u0441 \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u041a\u043e\u0433\u0434\u0430 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c
    \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u043e\u043c, \u043e\u043d
    \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0432 \u043d\u0435\u043c
    \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043b\u0435\u0441\u0430
    \u0438 \u043a\u0443\u0447\u0443 \u043c\u0443\u0441\u043e\u0440\u0430. \u042f \u0443\u0431\u0438\u0440\u0430\u044e
    \u0437\u0430 \u0441\u043e\u0431\u043e\u0439\u00bb. - \u0422\u0435\u043e\u0440\u0438\u044f
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0432 \u0448\u0443\u0442\u043a\u0443: \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e
    \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438, \u0447\u0442\u043e \u0431\u044b \u043e\u043d
    \u0434\u0435\u043b\u0430\u043b, \u0435\u0441\u043b\u0438 \u0431\u044b \u043d\u0430\u0448\u0435\u043b
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b
    \u0447\u0435\u0440\u0435\u0437 10 \u043b\u0435\u0442, \u043e\u043d \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u042f \u0431\u044b \u0437\u0430\u043f\u0435\u0440 \u0435\u0433\u043e \u0432 \u0441\u0435\u0439\u0444
    \u043d\u0430 10 \u043b\u0435\u0442 \u0438 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0439
    \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e, \u0430 \u043d\u0435 \u0447\u0435\u0440\u0435\u0437
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0435\u00bb. - \u041e \u00ab\u0433\u043b\u0443\u043f\u044b\u0445\u00bb
    \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u0445: \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043d\u0435\u043a\u0438\u0439 \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a \u0441\u043f\u0440\u043e\u0441\u0438\u043b
    \u0413\u0430\u0443\u0441\u0441\u0430, \u0435\u0441\u0442\u044c \u043b\u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043f\u043e\u043b\u044c\u0437\u0430 \u043e\u0442 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b.
    \u0413\u0430\u0443\u0441\u0441 \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u042d\u0442\u043e
    \u0446\u0430\u0440\u0438\u0446\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0441\u043b\u0438 \u0432\u0430\u043c \u043d\u0443\u0436\u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430,
    \u0438\u0434\u0438\u0442\u0435 \u0432 \u043a\u0443\u0437\u043d\u0438\u0446\u0443\u00bb.
    --- 6. \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0435 \u0437\u0430\u0433\u0430\u0434\u043a\u0438
    \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u044b - \u0417\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435
    \u0438 \u0432\u043e\u0441\u043a\u043e\u0432\u044b\u0435 \u0441\u043b\u0435\u043f\u043a\u0438:
    \u0413\u0430\u0443\u0441\u0441 \u0437\u0430\u0432\u0435\u0449\u0430\u043b, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u0441
    \u0435\u0433\u043e \u043b\u0438\u0446\u0430 \u0438 \u0440\u0443\u043a \u0441\u043d\u044f\u043b\u0438
    \u0433\u0438\u043f\u0441\u043e\u0432\u044b\u0435 \u043c\u0430\u0441\u043a\u0438 (\u044d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u043c\u043e\u0434\u0430 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438).
    \u041e\u0434\u043d\u0430\u043a\u043e \u0441\u043b\u0443\u0433\u0430, \u0431\u043e\u044f\u0441\u044c,
    \u0447\u0442\u043e \u0443\u0447\u0435\u043d\u044b\u0439 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0441\u043d\u0443\u0442\u044c\u0441\u044f,
    \u043a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u043b\u0438\u0432\u0430\u0442\u044c
    \u0433\u0438\u043f\u0441, \u043d\u0430\u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443 \u0438\u0441\u043f\u043e\u0440\u0442\u0438\u043b
    \u043c\u0430\u0441\u043a\u0443. \u0412 \u0438\u0442\u043e\u0433\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0441\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u0435\u043f\u043e\u043a \u043f\u0440\u0430\u0432\u043e\u0439
    \u0440\u0443\u043a\u0438 \u0441 \u0432\u0435\u0447\u043d\u044b\u043c \u043f\u0435\u0440\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0435\u0439\u0447\u0430\u0441 \u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. - \u041c\u043e\u0437\u0433
    \u0413\u0430\u0443\u0441\u0441\u0430: \u0415\u0433\u043e \u043c\u043e\u0437\u0433 \u0431\u044b\u043b
    \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d \u043f\u0440\u0438 \u0432\u0441\u043a\u0440\u044b\u0442\u0438\u0438
    \u0438 \u0432\u0435\u0441\u0438\u043b 1492 \u0433\u0440\u0430\u043c\u043c\u0430 \u2014 \u044d\u0442\u043e
    \u0431\u044b\u043b \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u043c\u043e\u0437\u0433\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438,
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u044e\u0449\u0438\u0439
    \u0441\u0440\u0435\u0434\u043d\u0438\u0439 \u0432\u0435\u0441 (\u043e\u043a\u043e\u043b\u043e
    1350 \u0433). \u041e\u0434\u043d\u0430\u043a\u043e, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043e\u0437\u0433\u0430 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430,
    \u043c\u043e\u0437\u0433 \u0413\u0430\u0443\u0441\u0441\u0430 \u043d\u0435 \u0431\u044b\u043b
    \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0438\u0437\u0443\u0447\u0435\u043d
    \u2014 \u0435\u0433\u043e \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0445\u0440\u0430\u043d\u0438\u043b\u0438 \u0432 \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u043d\u0435,
    \u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 1998 \u0433\u043e\u0434\u0443 \u0443\u0447\u0435\u043d\u044b\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u0430 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0430\u044f
    \u0438\u0437\u0432\u0438\u043b\u0438\u043d\u0430, \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0449\u0430\u044f
    \u0437\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435. - \u041a\u043b\u0430\u0434\u0431\u0438\u0449\u0435\u043d\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u0438\u0435: \u041d\u0430 \u043c\u043e\u0433\u0438\u043b\u0435
    \u0413\u0430\u0443\u0441\u0441\u0430 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435
    \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430 \u043d\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u0438 \u043d\u0435 \u043f\u043e\u0440\u0442\u0440\u0435\u0442, \u0430 \u0437\u043e\u043b\u043e\u0442\u0430\u044f
    \u043f\u044f\u0442\u0438\u043a\u043e\u043d\u0435\u0447\u043d\u0430\u044f \u0437\u0432\u0435\u0437\u0434\u0430
    (\u043f\u0435\u043d\u0442\u0430\u0433\u0440\u0430\u043c\u043c\u0430). \u041d\u043e \u0441\u0430\u043c\u043e\u0435
    \u0437\u0430\u0431\u0430\u0432\u043d\u043e\u0435, \u0447\u0442\u043e \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u0438,
    \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0432\u0448\u0438\u0435
    \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a, \u043f\u0435\u0440\u0435\u043f\u0443\u0442\u0430\u043b\u0438
    \u0447\u0435\u0440\u0442\u0435\u0436 \u0438 \u0432\u044b\u0441\u0435\u043a\u043b\u0438 \u043f\u044f\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u0443\u044e
    \u043f\u0440\u0438\u0437\u043c\u0443, \u0430 \u043d\u0435 \u043f\u043b\u043e\u0441\u043a\u0443\u044e
    \u0437\u0432\u0435\u0437\u0434\u0443. \u0413\u0430\u0443\u0441\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
