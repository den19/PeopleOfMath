    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0438 \u0441\u0442\u0430\u043b\u0430
    \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438. \u0412
    \u0441\u0432\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u043e\u043d \u043d\u0435\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e
    \u0436\u0430\u043b\u043e\u0432\u0430\u043b\u0441\u044f \u043d\u0430 \u043f\u043b\u043e\u0445\u043e\u0435
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0438 \u043d\u0435\u043c\u043e\u0449\u044c.
    \u0415\u0433\u043e \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435 \u0431\u044b\u043b\u043e
    \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043d\u043e \u0437\u0430 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0434\u043d\u044f \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438. \u041c\u0435\u0441\u0442\u043e
    \u0435\u0433\u043e \u0437\u0430\u0445\u043e\u0440\u043e\u043d\u0435\u043d\u0438\u044f \u0442\u043e\u0447\u043d\u043e
    \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e: \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043d
    \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u0432 \u0446\u0435\u0440\u043a\u0432\u0438
    \u0421\u0432. \u042d\u0433\u0438\u0434\u0438\u044f \u0432 \u042d\u0434\u0438\u043d\u0431\u0443\u0440\u0433\u0435,
    \u043d\u043e \u0435\u0441\u0442\u044c \u0432\u0435\u0441\u043a\u0438\u0435 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f
    \u043f\u043e\u043b\u0430\u0433\u0430\u0442\u044c, \u0447\u0442\u043e \u0435\u0433\u043e
    \u043e\u0441\u0442\u0430\u043d\u043a\u0438 \u043f\u043e\u043a\u043e\u044f\u0442\u0441\u044f
    \u0432 \u0441\u0442\u0430\u0440\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438 \u0421\u0432.
    \u041a\u0430\u0442\u0431\u0435\u0440\u0442\u0430, \u0432 \u043f\u0440\u0438\u0445\u043e\u0434\u0435
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f
    \u0437\u0430\u043c\u043e\u043a \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d."
  personalLifeEn: 
  shortBioRu: "\u0414\u0436\u043e\u043d \u041d\u0435\u043f\u0435\u0440 (1550\u20131617) \u0431\u044b\u043b
    \u0448\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u043c \u0431\u0430\u0440\u043e\u043d\u043e\u043c,
    \u0447\u044c\u0451 \u0438\u043c\u044f \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d\u043e \u0441 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u0438\u0435\u043c \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438 \u2014
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435\u043c \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430
    \u043f\u043e\u043b\u043d\u0430 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432:
    \u043d\u0430\u0431\u043e\u0436\u043d\u044b\u0439 \u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0438\u043d,
    \u043e\u043d \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0435\u0439
    \u0438 \u0430\u043b\u0445\u0438\u043c\u0438\u0435\u0439; \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \u0441\u0432\u043e\u0435\u0439 \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439
    \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u0438\u0439 \u0442\u0440\u0430\u043a\u0442\u0430\u0442.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0438\u0437 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F3F0
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0414\u0436\u043e\u043d \u041d\u0435\u043f\u0435\u0440 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 1550 \u0433\u043e\u0434\u0443 \u0432 \u0440\u043e\u0434\u043e\u0432\u043e\u043c \u0437\u0430\u043c\u043a\u0435
    \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u0444\u0430\u043c\u0438\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u0435\u0439
    \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0438 \u0441 XV \u0432\u0435\u043a\u0430 \u0438
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e
    \u043e\u0442 \u042d\u0434\u0438\u043d\u0431\u0443\u0440\u0433\u0430. \u041e\u043d \u0431\u044b\u043b
    \u0441\u044b\u043d\u043e\u043c \u0441\u044d\u0440\u0430 \u0410\u0440\u0447\u0438\u0431\u0430\u043b\u044c\u0434\u0430
    \u041d\u0435\u043f\u0435\u0440\u0430, 7-\u0433\u043e \u043b\u044d\u0440\u0434\u0430 \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d\u0430,
    \u0438 \u0414\u0436\u0435\u043d\u0435\u0442 \u0411\u043e\u0441\u0443\u044d\u043b\u043b.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0438 \u0437\u043d\u0430\u0442\u043e\u043a \u043b\u0430\u0442\u044b\u043d\u0438,
    \u043f\u043e\u0437\u0436\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u043f\u043e\u0441\u0442
    \u0433\u043b\u0430\u0432\u044b \u041c\u043e\u043d\u0435\u0442\u043d\u043e\u0433\u043e \u0434\u0432\u043e\u0440\u0430
    \u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0438\u0438. \u0421\u0430\u043c \u0414\u0436\u043e\u043d
    \u041d\u0435\u043f\u0435\u0440 \u0441\u0442\u0430\u043b 8-\u043c \u043b\u044d\u0440\u0434\u043e\u043c
    \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d\u0430 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430 \u0432 1608 \u0433\u043e\u0434\u0443.
    \u0412 13 \u043b\u0435\u0442, \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u043c\u0430\u0442\u0435\u0440\u0438 \u0432 1563 \u0433\u043e\u0434\u0443, \u041d\u0435\u043f\u0435\u0440
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0421\u0435\u043d\u0442-\u042d\u043d\u0434\u0440\u044e\u0441\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043e\u043d \u043d\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b \u0435\u0433\u043e,
    \u0438, \u043a\u0430\u043a \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u043e
    \u0441\u0440\u0435\u0434\u0438 \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0448\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0433\u043e
    \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u0442\u0432\u0430, \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u043f\u043e \u0415\u0432\u0440\u043e\u043f\u0435.
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043d
    \u043f\u043e\u0441\u0435\u0442\u0438\u043b \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e,
    \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u0438, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0418\u0442\u0430\u043b\u0438\u044e, \u0433\u0434\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u044b\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0442\u0430\u043a\u0438\u043c\u0438
    \u043a\u0430\u043a \u0421\u0438\u043c\u043e\u043d \u0421\u0442\u0435\u0432\u0438\u043d,
    \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 \u0438 \u041c\u0438\u0445\u0430\u044d\u043b\u044c
    \u0428\u0442\u0438\u0444\u0435\u043b\u044c.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F466
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0438\u044e,
    \u0431\u0440\u0430\u043a \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f
    \u0412 1571 \u0433\u043e\u0434\u0443 \u041d\u0435\u043f\u0435\u0440 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0443 \u0438 \u043f\u043e\u0441\u0435\u043b\u0438\u043b\u0441\u044f
    \u0432 \u0440\u043e\u0434\u043e\u0432\u043e\u043c \u0437\u0430\u043c\u043a\u0435, \u0438\u0437
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435
    \u0432\u044b\u0435\u0437\u0436\u0430\u043b \u043d\u0430\u0434\u043e\u043b\u0433\u043e. \u0421
    \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0438 \u0434\u043e
    \u043a\u043e\u043d\u0446\u0430 \u0441\u0432\u043e\u0438\u0445 \u0434\u043d\u0435\u0439 \u043e\u043d
    \u0436\u0438\u043b \u0432 \u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0438\u0438. \u0412
    1572 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430
    \u042d\u043b\u0438\u0437\u0430\u0431\u0435\u0442 \u0421\u0442\u0438\u0440\u043b\u0438\u043d\u0433,
    \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0443 \u043d\u0435\u0433\u043e
    \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0441\u044b\u043d \u0438 \u0434\u043e\u0447\u044c.
    \u041f\u043e\u0441\u043b\u0435 \u0435\u0451 \u0441\u043c\u0435\u0440\u0442\u0438 \u0432
    1579 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e
    \u2014 \u043d\u0430 \u0410\u0433\u043d\u0435\u0441 \u0427\u0438\u0437\u0445\u043e\u043b\u043c,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u043e\u0434\u0438\u043b\u0430 \u0435\u043c\u0443
    \u0435\u0449\u0451 \u0434\u0435\u0441\u044f\u0442\u044c \u0434\u0435\u0442\u0435\u0439.
    \u041d\u0435\u043f\u0435\u0440 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0441\u0432\u043e\u0438\u043c\u0438 \u043f\u043e\u043c\u0435\u0441\u0442\u044c\u044f\u043c\u0438
    \u0438 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u043c \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u043e\u043c,
    \u043d\u043e \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u043c\u0438
    \u0431\u044b\u043b\u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u044f \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.
    \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b \u043b\u0438\u0448\u044c \u043e\u0442\u0434\u044b\u0445\u043e\u043c
    \u043e\u0442 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0434\u0435\u043b\u0430
    \u2014 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u0438. \u041e\u043d \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u044c
    \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a.
    \u0421\u0440\u0435\u0434\u0438 \u0435\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0439
    \u0431\u044b\u043b\u0438 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0434\u043b\u044f
    \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0441\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0430 \u0438 \u0434\u0430\u0436\u0435 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0435
    \u0432\u043e\u0435\u043d\u043d\u044b\u0435 \u043c\u0430\u0448\u0438\u043d\u044b \u0434\u043b\u044f
    \u0437\u0430\u0449\u0438\u0442\u044b \u0441\u0442\u0440\u0430\u043d\u044b \u043e\u0442 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \"\u0433\u043e\u0440\u044f\u0449\u0438\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430\"
    \u0438 \"\u043c\u0435\u0442\u0430\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u043e\u043b\u0435\u0441\u043d\u0438\u0446\u0443\". \u0422\u0430\u043a\u0436\u0435
    \u0441 \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u0441\u0432\u044f\u0437\u0430\u043d\u044b
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043d\u044f\u0442\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439, \u0443\u043a\u0440\u0435\u043f\u0438\u0432\u0448\u0438\u0445
    \u0435\u0433\u043e \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e \u043c\u0430\u0433\u0430
    \u0438 \u0447\u0430\u0440\u043e\u0434\u0435\u044f: \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u0439\u043c\u0430\u0442\u044c
    \u0432\u043e\u0440\u0430 \u0441\u0440\u0435\u0434\u0438 \u0441\u043b\u0443\u0433, \u043e\u043d
    \u044f\u043a\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043f\u0435\u0442\u0443\u0445\u0430, \u0432\u044b\u043c\u0430\u0437\u0430\u043d\u043d\u043e\u0433\u043e
    \u0441\u0430\u0436\u0435\u0439: \u0432\u043e\u0440, \u0431\u043e\u044f\u0441\u044c \u043f\u0440\u0438\u043a\u043e\u0441\u043d\u0443\u0442\u044c\u0441\u044f
    \u043a \u043f\u0442\u0438\u0446\u0435, \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0441
    \u0447\u0438\u0441\u0442\u044b\u043c\u0438 \u0440\u0443\u043a\u0430\u043c\u0438, \u0447\u0435\u043c
    \u0438 \u0432\u044b\u0434\u0430\u043b \u0441\u0435\u0431\u044f. \u0427\u0442\u043e\u0431\u044b
    \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u0433\u043e\u043b\u0443\u0431\u0435\u0439
    \u0441\u043e\u0441\u0435\u0434\u0430, \u043f\u043e\u0435\u0434\u0430\u0432\u0448\u0438\u0445
    \u0435\u0433\u043e \u0437\u0435\u0440\u043d\u043e, \u043e\u043d \u043d\u0430\u043c\u043e\u0447\u0438\u043b
    \u0433\u043e\u0440\u043e\u0445 \u0432 \u0431\u0440\u0435\u043d\u0434\u0438 \u0438 \u0440\u0430\u0437\u0431\u0440\u043e\u0441\u0430\u043b
    \u043f\u043e \u043f\u043e\u043b\u044e. \u041f\u0442\u0438\u0446\u044b, \u043f\u043e\u043a\u043b\u0435\u0432\u0430\u0432
    \u0435\u0433\u043e, \u043d\u0435 \u043c\u043e\u0433\u043b\u0438 \u0432\u0437\u043b\u0435\u0442\u0435\u0442\u044c.\n\n\U0001F4D6
    \u0411\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u0435 \u0438 \"\u041e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u0435\"
    \u041a\u0430\u043a \u0438\u0441\u0442\u043e\u0432\u044b\u0439 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442-\u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0438\u043d,
    \u041d\u0435\u043f\u0435\u0440 \u0431\u044b\u043b \u0441\u0438\u043b\u044c\u043d\u043e \u0432\u043e\u0432\u043b\u0435\u0447\u0451\u043d
    \u0432 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c
    \u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0438\u0438 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u043e\u0440\u043e\u043b\u0430\u0441\u044c
    \u0441 \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0435\u0439
    \u0438 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0430\u043d\u0433\u043b\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0439
    \u0446\u0435\u0440\u043a\u0432\u0438. \u0412 1588 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0434\u0435\u043b\u0435\u0433\u0430\u0442\u043e\u043c
    \u0432 \u0413\u0435\u043d\u0435\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u0430\u0441\u0441\u0430\u043c\u0431\u043b\u0435\u044e
    \u0448\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438.
    \u0412 1593 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439, \u043a\u0430\u043a
    \u043e\u043d \u0441\u0430\u043c \u0441\u0447\u0438\u0442\u0430\u043b, \u0442\u0440\u0443\u0434
    \u2014 \"\u041f\u043e\u043d\u044f\u0442\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0432\u0441\u0435\u0433\u043e \u041e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u044f
    \u0441\u0432\u044f\u0442\u043e\u0433\u043e \u0418\u043e\u0430\u043d\u043d\u0430\" (A Plaine
    Discovery of the Whole Revelation of Saint John). \u0412 \u044d\u0442\u043e\u043c \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u043e\u043c
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0438 \u043e\u043d \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u0430,
    \u044f\u0440\u043e\u0441\u0442\u043d\u043e \u043e\u0431\u043b\u0438\u0447\u0430\u043b \u043f\u0430\u043f\u0441\u0442\u0432\u043e
    \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u043a\u043e\u043d\u0435\u0446
    \u0441\u0432\u0435\u0442\u0430 \u043d\u0430 1688 \u0438\u043b\u0438 1700 \u0433\u043e\u0434.
    \u041a\u043d\u0438\u0433\u0430 \u0438\u043c\u0435\u043b\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0443\u0441\u043f\u0435\u0445 \u0438 \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u0430
    \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044f\u0437\u044b\u043a\u043e\u0432.\n\n\u2728
    \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435: \u041b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u044b
    \u041f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u044c \u0432 \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u0438\u0438
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u0432\u0435\u043b\u0430
    \u041d\u0435\u043f\u0435\u0440\u0430 \u043a \u0433\u043b\u0430\u0432\u043d\u043e\u043c\u0443
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.
    \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f \u0438\u0434\u0435\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0438\u0448\u043b\u0430 \u0435\u043c\u0443 \u0432 \u0433\u043e\u043b\u043e\u0432\u0443,
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c \u0432 \u0437\u0430\u043c\u0435\u043d\u0435
    \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u0435 \u0447\u0435\u0440\u0435\u0437
    \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0439. \u0412 1614 \u0433\u043e\u0434\u0443
    \u041d\u0435\u043f\u0435\u0440 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 magnum opus \u2014 \u043a\u043d\u0438\u0433\u0443 \"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0430\u0431\u043b\u0438\u0446\u044b
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432\" (Mirifici Logarithmorum Canonis
    Descriptio). \u0412 \u044d\u0442\u043e\u043c \u0442\u0440\u0443\u0434\u0435 \u043e\u0431\u044a\u0451\u043c\u043e\u043c
    56 \u0441\u0442\u0440\u0430\u043d\u0438\u0446 \u0442\u0435\u043a\u0441\u0442\u0430 \u0438
    90 \u0441\u0442\u0440\u0430\u043d\u0438\u0446 \u0442\u0430\u0431\u043b\u0438\u0446 \u043e\u043d:
    \u0434\u0430\u043b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0430;
    \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b \u0435\u0433\u043e \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430;
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u0435
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0442\u0430\u0431\u043b\u0438\u0446\u044b
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432 \u0434\u043b\u044f \u0441\u0438\u043d\u0443\u0441\u043e\u0432,
    \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432 \u0438 \u0442\u0430\u043d\u0433\u0435\u043d\u0441\u043e\u0432
    (\u0441 \u0448\u0430\u0433\u043e\u043c 1 \u043c\u0438\u043d\u0443\u0442\u0430). \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b, \u043d\u0435 \u0431\u044b\u043b\u0430
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u043c
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u043c. \u041d\u0435\u043f\u0435\u0440
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c
    \u043a\u0438\u043d\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438, \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044f
    \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0435 \u0438 \u0437\u0430\u043c\u0435\u0434\u043b\u044f\u044e\u0449\u0435\u0435\u0441\u044f
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435. \u0415\u0433\u043e \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c
    \u0447\u0438\u0441\u043b\u0430 10 000 000 \u0431\u044b\u043b \u0440\u0430\u0432\u0435\u043d
    \u043d\u0443\u043b\u044e, \u0430 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c \u043d\u0443\u043b\u044f
    \u2014 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u0438\u0434\u0435\u044f \u0431\u044b\u043b\u0430 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0439.
    \u0412 1615 \u0433\u043e\u0434\u0443 \u041d\u0435\u043f\u0435\u0440\u0430 \u043f\u043e\u0441\u0435\u0442\u0438\u043b
    \u0413\u0435\u043d\u0440\u0438 \u0411\u0440\u0438\u0433\u0433\u0441 \u2014 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438\u0437 \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0430.
    \u041e\u043d\u0438 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0440\u0435\u0448\u0438\u043b\u0438,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0431\u044b \u0443\u0434\u043e\u0431\u043d\u0435\u0435,
    \u0435\u0441\u043b\u0438 \u0431\u044b \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c \u0435\u0434\u0438\u043d\u0438\u0446\u044b
    \u0431\u044b\u043b \u0440\u0430\u0432\u0435\u043d \u043d\u0443\u043b\u044e, \u0430 \u043d\u0435
    10 000 000. \u0418\u043c\u0435\u043d\u043d\u043e \u0411\u0440\u0438\u0433\u0433\u0441 \u043f\u043e\u0437\u0436\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0445
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432 (\u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432
    \u0411\u0440\u0438\u0433\u0433\u0441\u0430). \u0412 1617 \u0433\u043e\u0434\u0443, \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438, \u041d\u0435\u043f\u0435\u0440 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0435\u0449\u0451 \u043e\u0434\u043d\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u2014 \"\u041f\u0430\u043b\u043e\u0447\u043a\u0438 \u041d\u0435\u043f\u0435\u0440\u0430\"
    (Rabdologiae), \u043f\u0440\u0438\u0431\u043e\u0440 \u0434\u043b\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0434\u0435\u043b\u0435\u043d\u0438\u044f.
    \u041d\u0430\u0431\u043e\u0440 \u043f\u0430\u043b\u043e\u0447\u0435\u043a \u0441 \u043d\u0430\u043d\u0435\u0441\u0451\u043d\u043d\u044b\u043c\u0438
    \u0446\u0438\u0444\u0440\u0430\u043c\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b
    \u0431\u044b\u0441\u0442\u0440\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0432\u043d\u0451\u0441 \u0432\u0430\u0436\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e,
    \u0432\u044b\u0432\u0435\u0434\u044f \"\u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043a\u0440\u0443\u0433\u043e\u0432\u044b\u0445
    \u0447\u0430\u0441\u0442\u0435\u0439\" \u0434\u043b\u044f \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432.\n\n\U0001F56F\ufe0f
    \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1617 \u0433\u043e\u0434\u0430 \u0414\u0436\u043e\u043d
    \u041d\u0435\u043f\u0435\u0440 \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u043b
    \u0438 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 4 \u0430\u043f\u0440\u0435\u043b\u044f
    \u0432 \u0441\u0432\u043e\u0451\u043c \u0437\u0430\u043c\u043a\u0435 \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d.
    \u041f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u0441\u044b\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0432\u0442\u043e\u0440\u043e\u0439
    \u0442\u0440\u0443\u0434 \u2014 \"\u041f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0430\u0431\u043b\u0438\u0446\u044b
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432\" (1619), \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u041d\u0435\u043f\u0435\u0440 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0443 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0441\u0432\u043e\u0438\u0445 \u0442\u0430\u0431\u043b\u0438\u0446. \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u041d\u0435\u043f\u0435\u0440\u0430 \u0438\u043c\u0435\u043b\u043e \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435. \u041a\u0430\u043a \u043f\u043e\u0437\u0436\u0435
    \u0441\u043a\u0430\u0437\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041f\u044c\u0435\u0440-\u0421\u0438\u043c\u043e\u043d \u041b\u0430\u043f\u043b\u0430\u0441,
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u044b \"\u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0438
    \u0436\u0438\u0437\u043d\u044c \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430\u043c\",
    \u0438\u0437\u0431\u0430\u0432\u0438\u0432 \u0438\u0445 \u043e\u0442 \u0443\u0442\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u0434\u043e\u043b\u0433\u0438\u0445 \u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432.
    \u0412 \u0447\u0435\u0441\u0442\u044c \u0414\u0436\u043e\u043d\u0430 \u041d\u0435\u043f\u0435\u0440\u0430
    \u043d\u0430\u0437\u0432\u0430\u043d\u044b: \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430
    \u041b\u0443\u043d\u0435 \u0438 \u0430\u0441\u0442\u0435\u0440\u043e\u0438\u0434; \u0435\u0434\u0438\u043d\u0438\u0446\u0430
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d \u2014 \u043d\u0435\u043f\u0435\u0440 (Neper);
    \u042d\u0434\u0438\u043d\u0431\u0443\u0440\u0433\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041d\u0435\u043f\u0435\u0440\u0430 (Edinburgh Napier University), \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0439
    \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u0435\u0433\u043e \u0440\u043e\u0434\u043e\u0432\u043e\u0433\u043e
    \u0437\u0430\u043c\u043a\u0430."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0414\u0436\u043e\u043d\u0430 \u041d\u0435\u043f\u0435\u0440\u0430
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432: \u043e\u043d \u0431\u044b\u043b
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u043c
    \u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0438\u043d\u043e\u043c \u0438... \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u0432\u0441\u0435\u0440\u044c\u0435\u0437 \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u043c\u0430\u0433\u043e\u043c
    \u0438 \u043a\u043e\u043b\u0434\u0443\u043d\u043e\u043c. \u0421\u043b\u0430\u0432\u0430
    \u043e \u0435\u0433\u043e \"\u0447\u0443\u0434\u0435\u0441\u0430\u0445\" \u0431\u044b\u043b\u0430
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0438\u043b\u044c\u043d\u0430,
    \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \"\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d\"
    (Marvellous Merchiston). \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u044b\u0435
    \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0438\u0437 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044e\u0442 \u044d\u0442\u0443 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e.\n\n\U0001F413
    \"\u0413\u0430\u0434\u0430\u044e\u0449\u0438\u0439\" \u043f\u0435\u0442\u0443\u0445 \u0438
    \u043b\u043e\u0432\u043b\u044f \u0432\u043e\u0440\u0430 \u0421\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u041d\u0435\u043f\u0435\u0440\u0435-\u043c\u0430\u0433\u0435
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0435\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u0446\u0435\u043c
    \u2014 \u0447\u0435\u0440\u043d\u044b\u043c \u043f\u0435\u0442\u0443\u0445\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u0443\u0435\u0432\u0435\u0440\u043d\u044b\u0435
    \u0441\u043e\u0441\u0435\u0434\u0438 \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u0435\u0433\u043e
    \"\u0444\u0430\u043c\u0438\u043b\u044c\u044f\u0440\u043e\u043c\", \u0442\u043e \u0435\u0441\u0442\u044c
    \u0434\u0443\u0445\u043e\u043c-\u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c
    \u0432 \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u0435. \u041a\u043e\u0433\u0434\u0430
    \u0432 \u0437\u0430\u043c\u043a\u0435 \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c \u043a\u0440\u0430\u0436\u0438,
    \u041d\u0435\u043f\u0435\u0440 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u0445\u0438\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u0439
    \u043f\u043b\u0430\u043d. \u041e\u043d \u0437\u0430\u044f\u0432\u0438\u043b \u0441\u043b\u0443\u0433\u0430\u043c,
    \u0447\u0442\u043e \u0435\u0433\u043e \u043f\u0435\u0442\u0443\u0445 \u043c\u043e\u0436\u0435\u0442
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0432\u043e\u0440\u0430, \u0438
    \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438
    \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435. \u041d\u0435\u043f\u0435\u0440 \u0442\u0430\u0439\u043d\u043e
    \u0432\u044b\u043c\u0430\u0437\u0430\u043b \u043f\u0442\u0438\u0446\u0443 \u0441\u0430\u0436\u0435\u0439,
    \u0437\u0430\u043f\u0435\u0440 \u0435\u0435 \u0432 \u0442\u0435\u043c\u043d\u043e\u0439
    \u043a\u043e\u043c\u043d\u0430\u0442\u0435 \u0438 \u0432\u0435\u043b\u0435\u043b \u043a\u0430\u0436\u0434\u043e\u043c\u0443
    \u0438\u0437 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u0435\u043c\u044b\u0445
    \u043f\u043e \u043e\u0447\u0435\u0440\u0435\u0434\u0438 \u0437\u0430\u0439\u0442\u0438 \u0438
    \u043f\u043e\u0433\u043b\u0430\u0434\u0438\u0442\u044c \u043f\u0435\u0442\u0443\u0445\u0430.
    \u041f\u043e \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c, \u043f\u0442\u0438\u0446\u0430
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u043a\u0440\u0438\u0447\u0430\u0442\u044c,
    \u043a\u043e\u0433\u0434\u0430 \u0434\u043e \u043d\u0435\u0435 \u0434\u043e\u0442\u0440\u043e\u043d\u0435\u0442\u0441\u044f
    \u0432\u0438\u043d\u043e\u0432\u043d\u044b\u0439. \u0420\u0430\u0437\u0443\u043c\u0435\u0435\u0442\u0441\u044f,
    \u043f\u0435\u0442\u0443\u0445 \u043c\u043e\u043b\u0447\u0430\u043b, \u043d\u043e \u0432\u043e\u0440,
    \u0438\u0441\u043f\u0443\u0433\u0430\u0432\u0448\u0438\u0441\u044c \u0440\u0430\u0437\u043e\u0431\u043b\u0430\u0447\u0435\u043d\u0438\u044f,
    \u043f\u043e\u0431\u043e\u044f\u043b\u0441\u044f \u043a \u043d\u0435\u043c\u0443 \u043f\u0440\u0438\u043a\u0430\u0441\u0430\u0442\u044c\u0441\u044f
    \u0438 \u043b\u0438\u0448\u044c \u0441\u0434\u0435\u043b\u0430\u043b \u0432\u0438\u0434,
    \u0447\u0442\u043e \u0433\u043b\u0430\u0434\u0438\u0442. \u0412\u044b\u0439\u0434\u044f
    \u0438\u0437 \u043a\u043e\u043c\u043d\u0430\u0442\u044b, \u0432\u0441\u0435 \u0441\u043b\u0443\u0433\u0438
    \u043f\u0435\u0440\u0435\u043f\u0430\u0447\u043a\u0430\u043b\u0438 \u0440\u0443\u043a\u0438
    \u0441\u0430\u0436\u0435\u0439... \u043a\u0440\u043e\u043c\u0435 \u043e\u0434\u043d\u043e\u0433\u043e.
    \u0418\u043c\u0435\u043d\u043d\u043e \u043e\u043d \u0438 \u0431\u044b\u043b \u0443\u043b\u0438\u0447\u0435\u043d
    \u0432 \u0432\u043e\u0440\u043e\u0432\u0441\u0442\u0432\u0435.\n\n\U0001F377 \u041f\u044c\u044f\u043d\u044b\u0435
    \u0433\u043e\u043b\u0443\u0431\u0438 \u0438 \u0441\u043f\u043e\u0440 \u0441 \u0441\u043e\u0441\u0435\u0434\u043e\u043c
    \u0415\u0449\u0435 \u043e\u0434\u0438\u043d \u0441\u043b\u0443\u0447\u0430\u0439 \u043b\u0438\u0448\u044c
    \u0443\u043a\u0440\u0435\u043f\u0438\u043b \u0435\u0433\u043e \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e
    \u0447\u0430\u0440\u043e\u0434\u0435\u044f. \u0421\u043e\u0441\u0435\u0434\u0441\u043a\u0438\u0435
    \u0433\u043e\u043b\u0443\u0431\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u043f\u043e\u0435\u0434\u0430\u043b\u0438 \u0437\u0435\u0440\u043d\u043e \u043d\u0430 \u043f\u043e\u043b\u044f\u0445
    \u041d\u0435\u043f\u0435\u0440\u0430. \u041d\u0430 \u0432\u0441\u0435 \u0436\u0430\u043b\u043e\u0431\u044b
    \u0441\u043e\u0441\u0435\u0434 \u043e\u0442\u0432\u0435\u0447\u0430\u043b, \u0447\u0442\u043e
    \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0434\u0435\u043b\u0430\u0442\u044c
    \u0441 \u043f\u0442\u0438\u0446\u0430\u043c\u0438, \u0438 \u0432 \u043d\u0430\u0441\u043c\u0435\u0448\u043a\u0443
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u041d\u0435\u043f\u0435\u0440\u0443
    \u0441\u0430\u043c\u043e\u043c\u0443 \u0438\u0445 \u043e\u0442\u043b\u043e\u0432\u0438\u0442\u044c,
    \u0435\u0441\u043b\u0438 \u0442\u043e\u0442 \u0441\u043c\u043e\u0436\u0435\u0442. \u041d\u0430
    \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0434\u0435\u043d\u044c \u0441\u043e\u0441\u0435\u0434
    \u0441 \u0438\u0437\u0443\u043c\u043b\u0435\u043d\u0438\u0435\u043c \u0443\u0432\u0438\u0434\u0435\u043b,
    \u043a\u0430\u043a \u041d\u0435\u043f\u0435\u0440 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e
    \u0445\u043e\u0434\u0438\u0442 \u043f\u043e \u043f\u043e\u043b\u044e, \u043f\u043e\u0434\u0431\u0438\u0440\u0430\u0435\u0442
    \u0431\u0435\u0441\u043f\u043e\u043c\u043e\u0449\u043d\u044b\u0445 \u0433\u043e\u043b\u0443\u0431\u0435\u0439
    \u0438 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0438\u0445 \u0432
    \u043c\u0435\u0448\u043e\u043a. \u041e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u043d\u043e\u0447\u044c\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0437\u0430\u043c\u043e\u0447\u0438\u043b \u0433\u043e\u0440\u043e\u0445 \u0432 \u0431\u0440\u0435\u043d\u0434\u0438
    \u0438 \u0440\u0430\u0437\u0431\u0440\u043e\u0441\u0430\u043b \u0435\u0433\u043e \u043f\u043e
    \u043f\u043e\u043b\u044e. \u0421\u043a\u043b\u0435\u0432\u0430\u0432\u0448\u0438\u0435 \u0443\u0433\u043e\u0449\u0435\u043d\u0438\u0435
    \u043f\u0442\u0438\u0446\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u043c\u043e\u0433\u043b\u0438
    \u0432\u0437\u043b\u0435\u0442\u0435\u0442\u044c.\n\n\U0001F52E \u041f\u0440\u043e\u0440\u043e\u043a,
    \u043d\u0435\u043a\u0440\u043e\u043c\u0430\u043d\u0442 \u0438 \u0430\u043b\u0445\u0438\u043c\u0438\u043a
    \u041f\u0440\u043e\u0437\u0432\u0438\u0449\u0435 \"\u0432\u043e\u043b\u0448\u0435\u0431\u043d\u0438\u043a\"
    \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0443\u0441\u0442\u044b\u043c \u0437\u0432\u0443\u043a\u043e\u043c.
    \u041e\u043d\u043e \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u043b\u044f\u043b\u043e\u0441\u044c
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u0443\u0445\u0430\u043c\u0438,
    \u043d\u043e \u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u043a\u0430\u043c\u0438
    \u041d\u0435\u043f\u0435\u0440\u0430: \u041f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435
    \u043a\u043e\u043d\u0446\u0430 \u0441\u0432\u0435\u0442\u0430: \u041d\u0435\u043f\u0435\u0440
    \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u0435\u043d
    \u0438 \u0432\u0441\u0435\u0440\u044c\u0435\u0437 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0442\u043e\u043b\u043a\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u041e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u044f
    \u0418\u043e\u0430\u043d\u043d\u0430 \u0411\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0430.
    \u0412 \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0443\u0434\u0435 1594 \u0433\u043e\u0434\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0434\u0435\u043b\u043e\u043c \u0441\u0432\u043e\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438, \u043e\u043d \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u044b\u043a\u043b\u0430\u0434\u043e\u043a
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043a\u043e\u043d\u0435\u0446
    \u0441\u0432\u0435\u0442\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u0442 \u043c\u0435\u0436\u0434\u0443
    1688 \u0438 1700 \u0433\u043e\u0434\u0430\u043c\u0438. \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e,
    \u0435\u0433\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u0432 \u044d\u0442\u043e\u0442
    \u0440\u0430\u0437 \u043f\u043e\u0434\u0432\u0435\u043b\u0430. \u041f\u043e\u0438\u0441\u043a
    \u043a\u043b\u0430\u0434\u0430: \u0412 1594 \u0433\u043e\u0434\u0443 \u041d\u0435\u043f\u0435\u0440
    \u0437\u0430\u043a\u043b\u044e\u0447\u0438\u043b \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442 \u0441 \u043d\u0435\u043a\u0438\u043c \u0420\u043e\u0431\u0435\u0440\u0442\u043e\u043c
    \u041b\u043e\u0433\u0430\u043d\u043e\u043c \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430
    \u0441\u043f\u0440\u044f\u0442\u0430\u043d\u043d\u043e\u0433\u043e \u0441\u043e\u043a\u0440\u043e\u0432\u0438\u0449\u0430
    \u0432 \u0437\u0430\u043c\u043a\u0435 \u0424\u0430\u0441\u0442\u043a\u0430\u0441\u043b.
    \u0412 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0435 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u043e,
    \u0447\u0442\u043e \u041d\u0435\u043f\u0435\u0440 \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u0442\u044c
    \"\u0432\u0441\u0435 \u0443\u0441\u0438\u043b\u0438\u044f, \u0447\u0442\u043e\u0431\u044b
    \u0438\u0441\u043a\u0430\u0442\u044c \u0438 \u043d\u0430\u0439\u0442\u0438\" \u043a\u043b\u0430\u0434,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \"\u0432\u0441\u0435 \u0443\u0445\u0438\u0449\u0440\u0435\u043d\u0438\u044f
    \u0438 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e\". \u0418\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u0430\u043b\u0445\u0438\u043c\u0438\u0438: \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442
    \u0437\u0430\u043f\u0438\u0441\u0438 \u043e \u0435\u0433\u043e \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f\u0445
    \u0441 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u043c \u0430\u043b\u0445\u0438\u043c\u0438\u043a\u043e\u043c,
    \u0430 \u0435\u0433\u043e \u0441\u044b\u043d \u0420\u043e\u0431\u0435\u0440\u0442, \u0441\u0442\u0430\u0432\u0448\u0438\u0439
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u043c \u0434\u0443\u0448\u0435\u043f\u0440\u0438\u043a\u0430\u0437\u0447\u0438\u043a\u043e\u043c,
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u0442\u0440\u0443\u0434\u044b \u043d\u0430 \u044d\u0442\u0443 \u0442\u0435\u043c\u0443.\n\n\u2694\ufe0f
    \u0424\u0443\u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \"\u0441\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f\"
    \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f\u044b
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0432\u0438\u0434\u043e\u0432
    \u043e\u0440\u0443\u0436\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u041d\u0435\u043f\u0435\u0440
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b \u0432 \u0441\u0432\u043e\u0438\u0445 \u0437\u0430\u043f\u0438\u0441\u044f\u0445,
    \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043b\u0435\u0433\u0435\u043d\u0434. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0432 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0435 1596 \u0433\u043e\u0434\u0430,
    \u043a\u043e\u0433\u0434\u0430 \u0443\u0433\u0440\u043e\u0437\u0430 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u0430,
    \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0432\u043e\u0435\u043d\u043d\u044b\u0445 \u043c\u0430\u0448\u0438\u043d: \"\u041a\u0440\u0443\u0433\u043b\u0430\u044f
    \u043c\u0435\u0442\u0430\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043e\u043b\u0435\u0441\u043d\u0438\u0446\u0430\",
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u043b\u0430
    \u0434\u0432\u0438\u0433\u0430\u0442\u044c\u0441\u044f \u0438\u0437\u043d\u0443\u0442\u0440\u0438
    \u0438 \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u0442\u044c \u0440\u044f\u0434\u044b \u0432\u0440\u0430\u0433\u0430,
    \u0441\u0442\u0440\u0435\u043b\u044f\u044f \u0447\u0435\u0440\u0435\u0437 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f. \u042d\u0442\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0442\u0430\u043d\u043a.
    \u041e\u0440\u0443\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0442\u0440\u0435\u043b\u044f\u043b\u043e
    \u0431\u044b \u043d\u0435 \u043f\u043e \u043f\u0440\u044f\u043c\u043e\u0439 \u043b\u0438\u043d\u0438\u0438,
    \u0430 \"\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u043e, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044f
    \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u0432\u0441\u0435\u0433\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u043e\u0433\u043e
    \u043c\u0435\u0441\u0442\u0430\", \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u044f
    \u0432\u0441\u0435\u0445 \u0432\u0440\u0430\u0433\u043e\u0432 \u043d\u0430 \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0439
    \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438. \u041e\u0434\u0438\u043d \u0438\u0437
    \u0435\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e \u041d\u0435\u043f\u0435\u0440
    \u0434\u0430\u0436\u0435 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0432
    \u0441\u0442\u0430\u0434\u0430 \u0441\u043a\u043e\u0442\u0430 \u0438 \u043e\u0432\u0435\u0446
    \u043d\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438.
    \u0412 \u0438\u0442\u043e\u0433\u0435, \u043e\u043d \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u044d\u043f\u043e\u0445\u0438 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u0441\u043e\u0447\u0435\u0442\u0430\u0432\u0448\u0438\u043c \u0432 \u0441\u0435\u0431\u0435
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0441\u0442\u044c,
    \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u043c\u044b\u0441\u043b\u044c \u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a
    \u044d\u0437\u043e\u0442\u0435\u0440\u0438\u043a\u0435. \u042d\u0442\u043e \u043f\u0440\u0438\u0447\u0443\u0434\u043b\u0438\u0432\u043e\u0435
    \u0441\u043c\u0435\u0448\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u043e
