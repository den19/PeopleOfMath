  achievementsRu: "\u0414\u0436\u043e\u043d \u041d\u0435\u043f\u0435\u0440 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0437\u0430\u043c\u0435\u0442\u043d\u044b\u0439 \u0441\u043b\u0435\u0434 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043d\u0430\u0443\u043a\u0438, \u0438 \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c, \u043f\u0443\u0441\u0442\u044c \u0438 \u0432\u0435\u043b\u0438\u043a\u0438\u043c,
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c. \u0415\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430
    \u0442\u0440\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0441\u0444\u0435\u0440\u044b,
    \u043a\u0430\u0436\u0434\u0430\u044f \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043f\u043e-\u0441\u0432\u043e\u0435\u043c\u0443 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430
    \u043c\u0438\u0440 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439.\n\n\u2728
    \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432:
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0432 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u0445
    \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0438 \u0441\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u041d\u0435\u043f\u0435\u0440\u0430, \u043d\u0430\u0434 \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043e\u043a\u043e\u043b\u043e 20
    \u043b\u0435\u0442, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043d\u0430\u0447\u0438\u043d\u0430\u044f
    \u0441 1594 \u0433\u043e\u0434\u0430. \u0415\u0433\u043e \u0446\u0435\u043b\u044c\u044e
    \u0431\u044b\u043b\u043e \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u0438\u0435 \u0442\u0440\u0443\u0434\u043e\u0435\u043c\u043a\u0438\u0445
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c
    \u0441\u0442\u0430\u043b\u0438 \u0434\u0432\u0430 \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u0430: \u00ab\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432\u00bb
    (Mirifici Logarithmorum Canonis Descriptio, 1614): \u0412 \u044d\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435,
    \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u0438\u0437 57 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0439 \u0438 90 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u0442\u0430\u0431\u043b\u0438\u0446, \u041d\u0435\u043f\u0435\u0440 \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u0432\u043e\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u043c\u0438\u0440\u0443. \u041e\u043d \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b
    \u043f\u0440\u0438\u0440\u043e\u0434\u0443 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432
    \u0438, \u0447\u0442\u043e \u0441\u0430\u043c\u043e\u0435 \u0432\u0430\u0436\u043d\u043e\u0435,
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u043a\u0430\u043a \u0438\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c,
    \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u043b\u043e\u0436\u043d\u043e\u0435
    \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u0435. \u041a\u043d\u0438\u0433\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u043c\u0443
    \u043a\u043e\u0440\u043e\u043b\u044e \u041a\u0430\u0440\u043b\u0443 I. \u00ab\u041f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0430\u0431\u043b\u0438\u0446\u044b
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432\u00bb (Mirifici Logarithmorum
    Canonis Constructio, 1619): \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u0431\u044b\u043b
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0443\u0447\u0435\u043d\u043e\u0433\u043e. \u0412
    \u043d\u0435\u043c \u041d\u0435\u043f\u0435\u0440 \u0440\u0430\u0441\u043a\u0440\u044b\u043b
    \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044e, \u043b\u0435\u0436\u0430\u0449\u0443\u044e
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u0435\u0433\u043e \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432,
    \u0438 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043b,
    \u043a\u0430\u043a \u043e\u043d \u0441\u0442\u0440\u043e\u0438\u043b \u0441\u0432\u043e\u0438
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b. \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u0442\u0430\u043a\u0436\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u0430\u044f
    \u0442\u043e\u0447\u043a\u0430 \u0434\u043b\u044f \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u0434\u0440\u043e\u0431\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438 \u0447\u0438\u0441\u043b\u0430,
    \u0447\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u0438 \u044d\u0442\u043e\u0439
    \u043d\u043e\u0442\u0430\u0446\u0438\u0438. \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0434\u0435\u0442\u0430\u043b\u0438: \u0412\u043b\u0438\u044f\u043d\u0438\u0435: \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u043e \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e
    \u0438 \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0437\u043c\u043e\u043c.
    \u0410\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0413\u0435\u043d\u0440\u0438 \u0411\u0440\u0438\u0433\u0433\u0441 \u043f\u043e\u0441\u0435\u0442\u0438\u043b
    \u041d\u0435\u043f\u0435\u0440\u0430 \u0432 1615 \u0433\u043e\u0434\u0443, \u0438 \u043e\u043d\u0438
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0440\u0435\u0448\u0438\u043b\u0438
    \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443, \u0441\u043e\u0437\u0434\u0430\u0432 \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0435
    (\u0431\u0440\u0438\u0433\u0433\u043e\u0432\u044b) \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u044b,
    \u0433\u0434\u0435 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c \u0435\u0434\u0438\u043d\u0438\u0446\u044b
    \u0440\u0430\u0432\u0435\u043d \u043d\u0443\u043b\u044e. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435:
    \u041a\u0430\u043a \u043f\u043e\u0437\u0436\u0435 \u0441\u043a\u0430\u0437\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041f\u044c\u0435\u0440-\u0421\u0438\u043c\u043e\u043d \u041b\u0430\u043f\u043b\u0430\u0441,
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u044b, \u00ab\u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0438
    \u0436\u0438\u0437\u043d\u044c \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430\u043c\u00bb,
    \u0438\u0437\u0431\u0430\u0432\u0438\u0432 \u0438\u0445 \u043e\u0442 \u0443\u0442\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u0434\u043e\u043b\u0433\u0438\u0445 \u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432.
    \u0425\u043e\u0442\u044f \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u043e\u043d\u0438
    \u0431\u044b\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u044b \u0434\u043b\u044f \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438, \u0438\u0445 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0434\u043b\u044f \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u0442\u0430\u043a\u0436\u0435
    \u0431\u044b\u043b\u0430 \u043d\u0435\u043e\u0446\u0435\u043d\u0438\u043c\u0430.\n\n\U0001F9B4
    \u041c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u041f\u043e\u043c\u0438\u043c\u043e
    \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u043e\u0432, \u041d\u0435\u043f\u0435\u0440
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0434\u043b\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u0447\u0435\u0442\u0430,
    \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445 \u0432 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0435
    \u00ab\u0420\u0430\u0431\u0434\u043e\u043b\u043e\u0433\u0438\u044f\u00bb (Rabdologiae, 1617).
    \u042d\u0442\u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u043b\u0438
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438
    \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u043e\u0432 \u0438 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0438\u043d\u0435\u0439\u043a\u0438. \u00ab\u041f\u0430\u043b\u043e\u0447\u043a\u0438
    \u041d\u0435\u043f\u0435\u0440\u0430\u00bb (Napier's Bones): \u042d\u0442\u043e \u043d\u0430\u0431\u043e\u0440
    \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445 \u043f\u0430\u043b\u043e\u0447\u0435\u043a
    (\u0438\u0437 \u043a\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u0434\u0435\u0440\u0435\u0432\u0430),
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u044b
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f
    \u0432 \u0432\u0438\u0434\u0435 \u0440\u0435\u0448\u0435\u0442\u043a\u0438. \u0421 \u0438\u0445
    \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435
    \u0438 \u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043c\u043d\u043e\u0433\u043e\u0437\u043d\u0430\u0447\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0441\u0432\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u043a
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u043c \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u043c
    \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u044f.
    \u042d\u0442\u043e \u0431\u044b\u043b \u0441\u0432\u043e\u0435\u0433\u043e \u0440\u043e\u0434\u0430
    \u00ab\u043a\u0430\u0440\u043c\u0430\u043d\u043d\u044b\u0439 \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u00bb
    XVII \u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c.
    \u041f\u0440\u043e\u043c\u043f\u0442\u0443\u0430\u0440\u0438\u0439 (Promptuary): \u0411\u043e\u043b\u0435\u0435
    \u0441\u043b\u043e\u0436\u043d\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e,
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0435\u0435 \u0441\u043e\u0431\u043e\u0439
    \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u0432\u0435\u0440\u0441\u0438\u044e \u043f\u0430\u043b\u043e\u0447\u0435\u043a \u0434\u043b\u044f
    \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f. \u041e\u043d\u043e \u0434\u043e\u043b\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044c \u043e\u0442 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b, \u043d\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0438\u0437-\u0437\u0430 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f
    \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f.
    \u00ab\u0428\u0430\u0445\u043c\u0430\u0442\u043d\u044b\u0439 \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u00bb
    (Chessboard Calculator): \u0422\u0440\u0435\u0442\u044c\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e,
    \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0435 \u0432 \u00ab\u0420\u0430\u0431\u0434\u043e\u043b\u043e\u0433\u0438\u0438\u00bb,
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043e\u0431\u043e\u0439
    \u0441\u0430\u043c\u0443\u044e \u0440\u0430\u043d\u043d\u044e\u044e \u0438\u0437 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0448\u0438\u043d,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0449\u0438\u0445 \u0434\u0432\u043e\u0438\u0447\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u041d\u0435\u043f\u0435\u0440 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c
    \u0447\u0438\u0441\u043b\u0430 \u043d\u0430 \u0448\u0430\u0445\u043c\u0430\u0442\u043d\u043e\u0439
    \u0434\u043e\u0441\u043a\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0444\u0438\u0448\u0435\u043a,
    \u0433\u0434\u0435 \u043a\u0430\u0436\u0434\u0430\u044f \u043a\u043b\u0435\u0442\u043a\u0430
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0434\u0432\u043e\u0439\u043a\u0438. \u042d\u0442\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u043e
    \u0434\u0432\u043e\u0438\u0447\u043d\u043e\u0439 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435
    \u043f\u043e\u0447\u0442\u0438 \u043d\u0430 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0435.\n\n\U0001F4D0
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u041d\u0435\u043f\u0435\u0440 \u0432\u043d\u0435\u0441 \u0432\u0430\u0436\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u2014 \u0440\u0430\u0437\u0434\u0435\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0430\u0436\u043d\u044b\u0439 \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0438 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438. \u041e\u043d \u0441\u0432\u0435\u043b
    \u0434\u0435\u0441\u044f\u0442\u044c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0445
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432, \u043a \u0434\u0432\u0443\u043c
    \u043e\u0431\u0449\u0438\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u043a\u0430\u043a \u00ab\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u043a\u0440\u0443\u0433\u043e\u0432\u044b\u0445
    \u0447\u0430\u0441\u0442\u0435\u0439 \u041d\u0435\u043f\u0435\u0440\u0430\u00bb (Napier's
    Rules of Circular Parts). \u0415\u043c\u0443 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0435 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0432 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0435 \u00ab\u0430\u043d\u0430\u043b\u043e\u0433\u0438\u044f\u043c\u0438
    \u041d\u0435\u043f\u0435\u0440\u0430\u00bb, \u0445\u043e\u0442\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0441\u0447\u0438\u0442\u0430\u044e\u0442,
    \u0447\u0442\u043e \u0432 \u0438\u0445 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u043c\u043e\u0433 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0438
    \u0413\u0435\u043d\u0440\u0438 \u0411\u0440\u0438\u0433\u0433\u0441. \u041f\u043e\u043c\u0438\u043c\u043e
    \u044d\u0442\u0438\u0445 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439,
    \u041d\u0435\u043f\u0435\u0440 \u0442\u0430\u043a\u0436\u0435 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u0443\u044e \u043d\u043e\u0442\u0430\u0446\u0438\u044e
    \u0421\u0442\u0435\u0432\u0438\u043d\u0430, \u0432\u0432\u0435\u0434\u044f \u0442\u043e\u0447\u043a\u0443
    \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044f,
    \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u043b\u044f
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0438\u043d\u0435\u0439\u043a\u0438. \u041a\u0430\u043a \u0432\u0438\u0434\u0438\u0442\u0435,
    \u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u043e
    \u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0440\u044b\u0432\u044b,
    \u043d\u043e \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0432\u0435\u043a\u0430\u043c\u0438 \u0441\u043b\u0443\u0436\u0438\u043b\u0438 \u043b\u044e\u0434\u044f\u043c
    \u043d\u0430\u0443\u043a\u0438."
  achievementsEn: 
  personalLifeRu: "\U0001F3F0 \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0414\u0436\u043e\u043d \u041d\u0435\u043f\u0435\u0440
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 1550 \u0433\u043e\u0434\u0443 \u0432 \u0440\u043e\u0434\u043e\u0432\u043e\u043c
    \u0437\u0430\u043c\u043a\u0435 \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e
    \u043e\u0442 \u042d\u0434\u0438\u043d\u0431\u0443\u0440\u0433\u0430. \u0415\u0433\u043e
    \u043e\u0442\u0446\u043e\u043c \u0431\u044b\u043b \u0441\u044d\u0440 \u0410\u0440\u0447\u0438\u0431\u0430\u043b\u044c\u0434
    \u041d\u0435\u043f\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043d\u0430
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0441\u044b\u043d\u0430
    \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e 16 \u043b\u0435\u0442, \u0430 \u043c\u0430\u0442\u0435\u0440\u044c\u044e
    \u2014 \u0414\u0436\u0435\u043d\u0435\u0442 \u0411\u043e\u0441\u0443\u044d\u043b\u043b,
    \u0434\u043e\u0447\u044c \u0447\u043b\u0435\u043d\u0430 \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430
    \u0438 \u0441\u0435\u0441\u0442\u0440\u0430 \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u0430
    \u041e\u0440\u043a\u043d\u0435\u0439\u0441\u043a\u043e\u0433\u043e. \u0421\u0435\u043c\u044c\u044f
    \u0432\u043b\u0430\u0434\u0435\u043b\u0430 \u043f\u043e\u043c\u0435\u0441\u0442\u044c\u0435\u043c
    \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d \u0441 1430-\u0445 \u0433\u043e\u0434\u043e\u0432,
    \u0438 \u0414\u0436\u043e\u043d \u0441\u0442\u0430\u043b 8-\u043c \u043b\u044d\u0440\u0434\u043e\u043c
    \u041c\u0435\u0440\u0447\u0438\u0441\u0442\u043e\u043d\u0430 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430 \u0432 1608 \u0433\u043e\u0434\u0443.\n\n\U0001F4DA
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f
    \u041e \u0440\u0430\u043d\u043d\u0438\u0445 \u0433\u043e\u0434\u0430\u0445 \u041d\u0435\u043f\u0435\u0440\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043d\u0435\u043c\u043d\u043e\u0433\u043e.
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0434\u043e
    13 \u043b\u0435\u0442 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u043b \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u0412 1563 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0421\u0435\u043d\u0442-\u042d\u043d\u0434\u0440\u044e\u0441\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0432 \u043a\u043e\u043b\u043b\u0435\u0434\u0436
    St Salvator's, \u0433\u0434\u0435 \u0435\u0433\u043e \u043c\u0430\u0442\u044c \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430\u0441\u044c,
