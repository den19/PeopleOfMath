  wikiTitleRu: "\u0412\u0435\u0439\u043B\u044C, \u0413\u0435\u0301\u0440\u043C\u0430\u043D
    \u041A\u043B\u0430\u0301\u0443\u0441 \u0413\u0443\u0301\u0433\u043E"
  wikidataId: Q71029
  fullNameRu: "\u0412\u0435\u0439\u043B\u044C, \u0413\u0435\u0301\u0440\u043C\u0430\u043D
    \u041A\u043B\u0430\u0301\u0443\u0441 \u0413\u0443\u0301\u0433\u043E"
  fullNameEn: Hermann Klaus Hugo Weyl
  birthDate: 09.11.1885
  deathDate: 08.12.1955
  countryKeys:
  - germany
  - usa
  centuryKeys:
  - 20
  branchKeys:
  - algebra
  - mathematical_physics
  achievementsRu: "\u0412\u0435\u0439\u043b\u044c \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0435, \u043f\u0440\u0438\u0447\u0435\u043c \u0435\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0440\u043e\u043b\u044c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043c\u043e\u0441\u0442\u043e\u0432
    \u043c\u0435\u0436\u0434\u0443 \u044d\u0442\u0438\u043c\u0438, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0431\u044b, \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c\u0438.
    \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0430\u043b
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0430 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u043d\u043e\u0432\u044b\u0435 \u044f\u0437\u044b\u043a\u0438
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u043e\u0442 \u043c\u0438\u043a\u0440\u043e\u043c\u0438\u0440\u0430 \u0434\u043e \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\n\U0001F4D0 \"\u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e,
    \u0432\u0440\u0435\u043c\u044f, \u043c\u0430\u0442\u0435\u0440\u0438\u044f\": \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0437\u0430\u0446\u0438\u044f
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0412 1918 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430
    \u0435\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u0430\u044f \u043a\u043d\u0438\u0433\u0430
    \"\u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e, \u0432\u0440\u0435\u043c\u044f,
    \u043c\u0430\u0442\u0435\u0440\u0438\u044f\" (Raum, Zeit, Materie), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u044b\u043c \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c
    \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430. \u041d\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435,
    \u0412\u0435\u0439\u043b\u044c \u043f\u043e\u0448\u0435\u043b \u0434\u0430\u043b\u044c\u0448\u0435:
    \u043e\u043d \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044e \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c
    \u0432 \u0435\u0434\u0438\u043d\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438. \u041e\u043d \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u043b
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u0443 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438 \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043e\u0447\u043d\u043e\u0439
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u0438 (gauge
    invariance), \u043a\u043e\u0442\u043e\u0440\u043e\u0435, \u0445\u043e\u0442\u044f \u0438
    \u043d\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0435\u0434\u0438\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438, \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0438 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043b\u043e \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u044f \u0438 \u0444\u0438\u0437\u0438\u043a\u0438
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0438\u0446
    (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044e \u042f\u043d\u0433\u0430-\u041c\u0438\u043b\u043b\u0441\u0430).\n\n\U0001F9EE
    \u0422\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0443\u043f\u043f \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0412 1920\u20131930-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u0412\u0435\u0439\u043b\u044c \u0441\u043e\u0437\u0434\u0430\u043b \u043e\u0431\u0449\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f (\u0433\u0440\u0443\u043f\u043f \u041b\u0438) \u0438 \u0438\u0445
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439. \u041e\u043d
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043e\u0441\u043e\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0438, \u0441\u043a\u0440\u044b\u0442\u044b\u0435
    \u0432 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u043c \u043c\u0438\u0440\u0435,
    \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442\u0441\u044f
    \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f.
    \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u044d\u0442\u043e\u0433\u043e
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0433\u043e \u0442\u0440\u0443\u0434\u0430
    \u0431\u044b\u043b\u0438 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u044b \u0432 \u0435\u0433\u043e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435
    \"\u0422\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0443\u043f\u043f \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\" (1928), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e-\u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043c\u0430.\n\n\U0001F4DA \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b \u0415\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \"\u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b, \u0438\u0445 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b
    \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f\"
    (1939) \u043f\u043e\u0434\u0432\u0435\u043b \u0438\u0442\u043e\u0433 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0435 \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438,
    \u0441\u0442\u0430\u0432 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u043e\u0439
    \u0434\u043b\u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432
    \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\n\U0001F4DD
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0412\u043e\u0442 \u0441\u043f\u0438\u0441\u043e\u043a \u0435\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0442\u0430\u043b\u0438 \u0432\u0435\u0445\u0430\u043c\u0438
    \u0432 \u043d\u0430\u0443\u043a\u0435: \"Die Idee der Riemannschen Fl\u00e4che\" (1913):
    \u0421\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434
    \u043d\u0430 \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438,
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e. \"Raum, Zeit, Materie\" (1918):
    \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0440\u0443\u0434
    \u043f\u043e \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043f\u0435\u0440\u0432\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0435\u0434\u0438\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u043e\u043b\u044f.
    \"Das Kontinuum\" (1918): \u0420\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u043e\u0439\u043a\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043d\u0430 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u0441\u043d\u043e\u0432\u0435, \u0431\u043b\u0438\u0437\u043a\u0430\u044f \u043a
    \u0438\u0434\u0435\u044f\u043c \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u043e\u043d\u0438\u0437\u043c\u0430.
    \"Gruppentheorie und Quantenmechanik\" (1928): \u041a\u043d\u0438\u0433\u0430, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432\u0448\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044e \u0433\u0440\u0443\u043f\u043f \u0434\u043b\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438. \"The Classical Groups\" (1939): \u0418\u0441\u0447\u0435\u0440\u043f\u044b\u0432\u0430\u044e\u0449\u0435\u0435
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f.
    \"Philosophy of Mathematics and Natural Science\" (1949): \u0413\u043b\u0443\u0431\u043e\u043a\u043e\u0435
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u043e\u0437\u043d\u0430\u043d\u0438\u044f.
    \"Symmetry\" (1952): \u0411\u043b\u0435\u0441\u0442\u044f\u0449\u0430\u044f \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430, \u0433\u0434\u0435 \u0412\u0435\u0439\u043b\u044c
    \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0438 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0435.\n\n\U0001F48E
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442
    \u0412\u0430\u0436\u043d\u043e \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e
    \u0434\u043b\u044f \u0412\u0435\u0439\u043b\u044f \u0432\u0441\u0435 \u044d\u0442\u0438
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u043d\u0435\u043e\u0442\u0434\u0435\u043b\u0438\u043c\u044b
    \u043e\u0442 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0438 \u044d\u0441\u0442\u0435\u0442\u0438\u043a\u0438.
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u043c \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e\u043c,
    \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0443.
    \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u0444\u0440\u0430\u0437\u0430:
    \"\u041c\u043e\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0430\u0441\u044c \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c
    \u0438\u0441\u0442\u0438\u043d\u0443 \u0441 \u043a\u0440\u0430\u0441\u043e\u0442\u043e\u0439,
    \u043d\u043e \u043a\u043e\u0433\u0434\u0430 \u043c\u043d\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c \u043e\u0434\u043d\u043e \u0438\u0437 \u0434\u0432\u0443\u0445,
    \u044f \u043e\u0431\u044b\u0447\u043d\u043e \u0432\u044b\u0431\u0438\u0440\u0430\u043b \u043a\u0440\u0430\u0441\u043e\u0442\u0443\"
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u0444\u043e\u0440\u0438\u0437\u043c,
    \u0430 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432\u0448\u0430\u044f
    \u0435\u043c\u0443 \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0433\u043b\u0443\u0431\u0438\u043d\u043d\u044b\u0435
    \u0441\u0432\u044f\u0437\u0438 \u0442\u0430\u043c, \u0433\u0434\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0432\u0438\u0434\u0435\u043b\u0438 \u043b\u0438\u0448\u044c \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b."
  achievementsEn: "Weil left a deep mark in mathematics and physics, and his key role was to build bridges between these seemingly different areas, and he did not just solve separate problems, but created new languages to describe reality, from microworld to universe design.\n\n♪ Space, Time, Matter: Geometricization of Physics in 1918: His program book, Space, Time, Matter (Raum, Zeit, Materie), which was the first comprehensive mathematical statement of Einstein's general theory of relativity, went on to try to combine gravity and electromagnetism into a single geometric theory.It expanded the rimana geometry and introduced the concept of calibration invariance, which, although it did not lead to a final unified theory, proved revolutionary and subsequently became the cornerstone of quantum field theory and particle physics (including the Young Mills theory).\n\n===Geography===The theory of groups and quantum mechanics in the 1920s and 1930s, Weil created a general theory of continuous groups (Le groups) and their perceptions, and he was one of the first to realize that the symmetry hidden in the quantum world is best described in group theory.The results of this long-standing work have been summarized in his famous book \"Theory of Groups and Quantum Mechanics\" (1928), which has had a tremendous impact on the formation of modern quantum-méchanical formalism.\n\nHis fundamental work \"Classical Groups, Their Invariants and Representations\" (1939) summarized his work in this field by becoming a desk book for algebra specialists and the theory of perception.\n\n==Career==The main scientific works here are a list of its key monographs, which have become landmarks in science: \"Die Idee der Riemannschen Fläche\" (1913): created a new view of the rimanas of the surface, combining the theory of function, geometry and topology. \"Raum, Zeit, Materie\" (1918): Classic work on general relativity theory and the first geometric unified field theory.\"Das Kontinuum\" (1918): Work on the restructuring of mathematical analysis on an arithmetic basis, close to intuitive ideas. \"Gruppentheorie und Quantenmechanik\" (1928): A book that applied group theory to systematize and understand quantum mechanics. \"The Classical Groupes\" (1939): A comprehensive presentation of the theory of invariants and the ideas of classical groups.\"Philosophy of Mathematics and Natural Science\" (1949): In-depth Philosophy Study of the Basis of Mathematics and Natural Science. \"Symmetal\" (1952): A brilliant and accessible work where Weil explores the manifestation of symmetry in mathematics, art and nature.\n\n* The Philosophical Bridge is important to note that for Weil, all these achievements were inseparable from philosophy and aesthetics, and he considered mathematics to be free art, related art.His famous phrase, \"My work has always sought to combine truth with beauty, but when I had to choose one of the two, I usually chose beauty,\" is not just an aphorism, but a methodology that allowed him to see deep connections where others saw only isolated facts."
  personalLifeRu: "\u0413\u0435\u0440\u043c\u0430\u043d \u0412\u0435\u0439\u043b\u044c \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u043c\u044b\u0441\u043b\u0438 \u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0441\u0443\u0434\u044c\u0431\u044b, \u0438 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0442\u0430\u043a \u0436\u0435 \u0442\u0435\u0441\u043d\u043e
    \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430 \u0441 \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439,
    \u043a\u0430\u043a \u0438 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b. \u0415\u0433\u043e \u043f\u0443\u0442\u044c \u043e\u0442\u043c\u0435\u0447\u0435\u043d
    \u0442\u0435\u0441\u043d\u044b\u043c\u0438 \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0441\u0432\u044f\u0437\u044f\u043c\u0438
    \u0441 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c\u0438 \u0443\u043c\u0430\u043c\u0438
    \u044d\u043f\u043e\u0445\u0438, \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438 \u043c\u0438\u0440\u043e\u0432\u044b\u0445
    \u0432\u043e\u0439\u043d \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u043b\u0438\u0447\u043d\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F466
    \u0421\u0435\u043c\u044c\u044f, \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438
    \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0413\u0435\u0440\u043c\u0430\u043d
    \u041a\u043b\u0430\u0443\u0441 \u0413\u0443\u0433\u043e \u0412\u0435\u0439\u043b\u044c \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    9 \u043d\u043e\u044f\u0431\u0440\u044f 1885 \u0433\u043e\u0434\u0430 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u042d\u043b\u044c\u043c\u0441\u0445\u043e\u0440\u043d
    \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e \u043e\u0442 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0430
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0431\u0430\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0441\u043b\u0443\u0436\u0430\u0449\u0435\u0433\u043e \u041b\u044e\u0434\u0432\u0438\u0433\u0430
    \u0412\u0435\u0439\u043b\u044f \u0438 \u0410\u043d\u043d\u044b \u0412\u0435\u0439\u043b\u044c
    (\u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0439 \u0414\u0438\u043a), \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0432\u0448\u0435\u0439
    \u0438\u0437 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0438. \u0415\u0433\u043e \u044e\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0448\u043b\u0430 \u0432 \u0410\u043b\u044c\u0442\u043e\u043d\u0435,
    \u0433\u0434\u0435 \u043e\u043d \u043f\u043e\u0441\u0435\u0449\u0430\u043b \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e
    \u041a\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0438\u0443\u043c, \u043f\u0440\u043e\u044f\u0432\u0438\u0432
    \u0440\u0430\u043d\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412 1904 \u0433\u043e\u0434\u0443 \u0412\u0435\u0439\u043b\u044c \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435 \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c
    \u0441\u0442\u0430\u043b \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0414\u0430\u0432\u0438\u0434
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442. \u041f\u043e\u0434 \u0435\u0433\u043e
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u0412\u0435\u0439\u043b\u044c
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0432 1908 \u0433\u043e\u0434\u0443,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u0412 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u0435
    1913 \u0433\u043e\u0434\u0430 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430
    \u0424\u0440\u0438\u0434\u0435\u0440\u0438\u043a\u0435 \u0411\u0435\u0440\u0442\u0435 \u0425\u0435\u043b\u0435\u043d\u0435
    \u0419\u043e\u0437\u0435\u0444 (\u043f\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0443
    \"\u0425\u0435\u043b\u043b\u0430\"). \u0425\u0435\u043b\u043b\u0430 \u0431\u044b\u043b\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c, \u0443\u0447\u0435\u043d\u0438\u0446\u0435\u0439
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043b\u043e\u0433\u0430 \u042d\u0434\u043c\u0443\u043d\u0434\u0430
    \u0413\u0443\u0441\u0441\u0435\u0440\u043b\u044f, \u0447\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435
    \u0412\u0435\u0439\u043b\u044f. \u0423 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0434\u0432\u043e\u0435 \u0441\u044b\u043d\u043e\u0432\u0435\u0439: \u0424\u0440\u0438\u0446
    \u0418\u043e\u0430\u0445\u0438\u043c (1915) \u0438 \u041c\u0438\u0445\u0430\u044d\u043b\u044c
    (1917).\n\n\U0001F468\u200d\U0001F52C \u041a\u0430\u0440\u044c\u0435\u0440\u0430, \u0434\u0440\u0443\u0436\u0431\u0430
    \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u0426\u044e\u0440\u0438\u0445\u0435
    \u0412 1913 \u0433\u043e\u0434\u0443 \u0412\u0435\u0439\u043b\u044c \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0435\u0442
    \u0432 \u0426\u044e\u0440\u0438\u0445, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0432 \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u043e\u043c
    \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c\u0435 (ETH). \u042d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c
    \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0438 \u043a\u0430\u0440\u044c\u0435\u0440\u0435.
    \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0438 \u0442\u0435\u0441\u043d\u043e \u043e\u0431\u0449\u0430\u043b\u0441\u044f \u0441
    \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u0432\u043b\u0435\u043a \u0435\u0433\u043e
    \u0441\u0432\u043e\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u0412 \u0426\u044e\u0440\u0438\u0445\u0435 \u043e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0441\u044f \u0441 \u042d\u0440\u0432\u0438\u043d\u043e\u043c
    \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0418\u0445 \u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u043e
    \u0432 \u0431\u043b\u0438\u0437\u043a\u0443\u044e \u0434\u0440\u0443\u0436\u0431\u0443,
    \u0445\u043e\u0442\u044f \u0438 \u043e\u0441\u043b\u043e\u0436\u043d\u044f\u043b\u0430\u0441\u044c
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u043c\u0438 \u043b\u0438\u0447\u043d\u044b\u043c\u0438
    \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c\u0438:
    \u0443 \u0412\u0435\u0439\u043b\u044f \u0431\u044b\u043b \u0440\u043e\u043c\u0430\u043d
    \u0441 \u0436\u0435\u043d\u043e\u0439 \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u0430
    \u0410\u043d\u043d\u0435\u043c\u0430\u0440\u0438, \u0447\u0442\u043e \u043d\u0435 \u043f\u043e\u043c\u0435\u0448\u0430\u043b\u043e
    \u0438\u0445 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438 \u043b\u0438\u0447\u043d\u043e\u043c\u0443 \u043e\u0431\u0449\u0435\u043d\u0438\u044e.\n\n\U0001F3AD
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d
    \u0438 \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f \u0412 1930 \u0433\u043e\u0434\u0443
    \u0412\u0435\u0439\u043b\u044c \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d,
    \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043d\u044f\u0442\u044c \u043c\u0435\u0441\u0442\u043e
    \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u0448\u0435\u043b \u043d\u0430 \u043f\u0435\u043d\u0441\u0438\u044e.
    \u042d\u0442\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0447\u0435\u0441\u0442\u044c\u044e.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438
    \u0431\u044b\u0441\u0442\u0440\u043e \u043c\u0435\u043d\u044f\u043b\u0430\u0441\u044c. \u0421
    \u043f\u0440\u0438\u0445\u043e\u0434\u043e\u043c \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u0432 1933 \u0433\u043e\u0434\u0443, \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0412\u0435\u0439\u043b\u044f \u0438 \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0438
    \u0441\u0442\u0430\u043b\u043e \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c.
    \u0415\u0433\u043e \u0436\u0435\u043d\u0430 \u0425\u0435\u043b\u043b\u0430 \u0431\u044b\u043b\u0430
    \u0435\u0432\u0440\u0435\u0439\u043a\u043e\u0439, \u0438 \u0438\u0445 \u0434\u0435\u0442\u0438
    \u0442\u0430\u043a\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c \u0435\u0432\u0440\u0435\u044f\u043c\u0438
    \u043f\u043e \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u0438\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c.
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u0443\u0448\u0435\u043b, \u0438 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0442\u0435\u0440\u044f\u043b \u0441\u0432\u043e\u0438 \u043f\u043e\u0437\u0438\u0446\u0438\u0438,
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0443\u0447\u0435\u043d\u044b\u0435 \u0431\u044b\u043b\u0438 \u0443\u0432\u043e\u043b\u0435\u043d\u044b.
    \u041e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IAS) \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 \u0410\u0432\u0440\u0430\u0430\u043c
    \u0424\u043b\u0435\u043a\u0441\u043d\u0435\u0440 \u0441\u0434\u0435\u043b\u0430\u043b \u0412\u0435\u0439\u043b\u044e
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043e \u0440\u0430\u0431\u043e\u0442\u0435
    \u0435\u0449\u0435 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 1932 \u0433\u043e\u0434\u0430.
    \u0412\u0435\u0439\u043b\u044c, \u043b\u044e\u0431\u0438\u0432\u0448\u0438\u0439 \u0441\u0432\u043e\u044e
    \u0440\u043e\u0434\u0438\u043d\u0443, \u043a\u043e\u043b\u0435\u0431\u0430\u043b\u0441\u044f
    \u0438 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f.
    \u041e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0441\u044f: \"\u041a\u043e\u0433\u0434\u0430
    \u043c\u043d\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435
    1932 \u0433\u043e\u0434\u0430, \u0441\u0443\u0434\u044c\u0431\u0430 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438
    \u0432\u0441\u0435 \u0435\u0449\u0435 \u0432\u0438\u0441\u0435\u043b\u0430 \u043d\u0430
    \u0432\u043e\u043b\u043e\u0441\u043a\u0435\". \u041e\u0434\u043d\u0430\u043a\u043e \u0432
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0435\u0433\u043e
    \u0443\u0436\u0430\u0441\u0430 \u043e\u043d \u043f\u0435\u0440\u0435\u0434\u0443\u043c\u0430\u043b,
    \u0438 \u0432 \u043e\u043a\u0442\u044f\u0431\u0440\u0435 1933 \u0433\u043e\u0434\u0430 \u0412\u0435\u0439\u043b\u044c
    \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432 \u0421\u0428\u0410 \u0438 \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432
    IAS \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435.\n\n\U0001F1FA\U0001F1F8
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d, \u0432\u0442\u043e\u0440\u044b\u0435 \u0431\u0440\u0430\u043a
    \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u0412 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u0412\u0435\u0439\u043b\u044c \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0434\u043e \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u044b\u0445\u043e\u0434\u0430 \u043d\u0430
    \u043f\u0435\u043d\u0441\u0438\u044e \u0432 1951 \u0433\u043e\u0434\u0443. \u0415\u0433\u043e
    \u0436\u0435\u043d\u0430 \u0425\u0435\u043b\u043b\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 5 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1948 \u0433\u043e\u0434\u0430. \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0433\u043e\u0434\u0430,
    \u0432 1950 \u0433\u043e\u0434\u0443, \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0441\u043a\u0443\u043b\u044c\u043f\u0442\u043e\u0440\u0435 \u042d\u043b\u043b\u0435\u043d
    \u0411\u044d\u0440 (\u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f \u041b\u043e\u043d\u0448\u0442\u0435\u0439\u043d)
    \u0438\u0437 \u0426\u044e\u0440\u0438\u0445\u0430. \u0412\u044b\u0439\u0434\u044f \u043d\u0430
    \u043f\u0435\u043d\u0441\u0438\u044e, \u0412\u0435\u0439\u043b\u044c \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u043b
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043c\u0435\u0436\u0434\u0443 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u043e\u043c
    \u0438 \u0426\u044e\u0440\u0438\u0445\u043e\u043c. \u0422\u0430\u043c, \u0432 \u0426\u044e\u0440\u0438\u0445\u0435,
    \u043e\u043d \u0441\u043a\u043e\u0440\u043e\u043f\u043e\u0441\u0442\u0438\u0436\u043d\u043e
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 8 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1955 \u0433\u043e\u0434\u0430 \u043d\u0430 71-\u043c \u0433\u043e\u0434\u0443 \u0436\u0438\u0437\u043d\u0438.
    \u0415\u0433\u043e \u043f\u0440\u0430\u0445 \u0431\u044b\u043b \u043a\u0440\u0435\u043c\u0438\u0440\u043e\u0432\u0430\u043d
    \u0432 \u0426\u044e\u0440\u0438\u0445\u0435, \u0430 \u0441\u043f\u0443\u0441\u0442\u044f
    \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442, \u0432 1999 \u0433\u043e\u0434\u0443,
    \u0437\u0430\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u0432 \u043a\u043e\u043b\u0443\u043c\u0431\u0430\u0440\u0438\u0438
    \u043d\u0430 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435,
    \u0440\u044f\u0434\u043e\u043c \u0441 \u043d\u0438\u043c \u043f\u043e\u0437\u0436\u0435
    \u0431\u044b\u043b \u0437\u0430\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u0438 \u0435\u0433\u043e
    \u0441\u044b\u043d \u041c\u0438\u0445\u0430\u044d\u043b\u044c.\n\n\U0001F48E \u0412\u043b\u0438\u044f\u043d\u0438\u0435
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u0412\u0435\u0439\u043b\u044c
    \u0431\u044b\u043b \u043f\u0430\u043d\u0442\u0435\u0438\u0441\u0442\u043e\u043c, \u0447\u0435\u0440\u043f\u0430\u0432\u0448\u0438\u043c
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u0435 \u0432 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u0412\u0441\u0435 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u044b
    \u0441 \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c\u0438
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438, \u0442\u0430\u043a\u0438\u043c\u0438
    \u043a\u0430\u043a \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442, \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d
    \u0438 \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440, \u0430 \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u044f\u0440\u043a\u0438\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043b\u0438\u0447\u043d\u044b\u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0430\u0442\u0430\u043a\u043b\u0438\u0437\u043c\u044b
    \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0442 \u0441\u0443\u0434\u044c\u0431\u0443
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e."
  personalLifeEn: "Herman Weil was a man of deep thought and difficult destiny, and his personal life is as closely intertwined with history as his scientific work, and his journey is marked by close friendship and creativity with the greatest minds of the era, dramatic events of world wars and deep personal philosophy.\n\n==Early life==Herman Klaus Hugo Weil was born on November 9, 1885 in the small town of Elmshorn, near Hamburg, in the family of a banker, Ludwig Weil, and Anna Weil (born Dick), from a wealthy family, and his youth was in Alton, where he attended the Christianiaum Gymnasium, showing early interest in mathematics.In 1904, Weil joined the University of Göttingen, where he was mentored by the great David Gilbert, and under his leadership he defended his Ph.D. in 1908 and then taught at Göttingen, and in September 1913 he married Friederick Bertha Helena Joseph (known as \"Hella\"), a philosopher, a student of phenomenalology, Edmund Gusserl, which had a significant influence on Veil's worldview.They had two sons, Fritz Joachim (1915) and Michael (1917).\n\nIn 1913, Weil moved to Zurich, where he received a professorship at the Zurich Polytechnic (ETH). This period became the key to his life and career, where he met Albert Einstein and had a close contact with him, and he also became a friend of Erwin Schroedinger, who was then a professor at the University of Zurich.Their association became a close friendship, albeit complicated by certain personal circumstances: Veil was having an affair with Schroedinger's wife, Annemarie, which did not prevent their professional and personal communication.\n\n♪ Return to Göttingen and emigration in 1930 Weil returned to Göttingen to take over the position of his retired teacher Gilbert. This appointment was a great honour to him. However, the political situation in Germany changed rapidly. With the Nazis taking power in 1933, the situation of Weil and his family became critical. His wife, Hell, was Jewish, and their children were also considered Jews under Nazi law.Gilbert left, and Göttingen University was rapidly losing his position, many outstanding scientists were dismissed, and the founder of the Institute of Advanced Studies (IAS) at Princeton, Abraham Flexner, made a job offer to Weil as early as 1932, and Veil, who loved his home country, hesitated and refused at first, admitted: \"When I was offered a position at the Institute in early 1932, the fate of Germany was still hanging by the hair.\"However, in a growing state of horror, he changed his mind, and in October 1933, Weil emigrated to the United States with his family and became one of the first IAS professors in Princeton.\n\n==Career=====Career=========Career======Career========Career====Career=====Careers======Careers=======Careers=======Careers=========Careers=========Careers=====In 1950, he married the Sculptor Ellen Bare (born Lonstein) from Zurich, who retired, Weil shared his time between Princeton and Zurich.His ashes were cremated in Zurich, and many years later, in 1999, he was buried in a columbia at Princeton Cemetery, and his son Michael was later buried near him.\n\nWeil was a pantheist who was inspired in philosophy, and all of his research was closely linked to his personal relationships with colleagues such as Gilbert, Einstein and Schroedinger, and his life was a vivid example of how personal beliefs and historical disasters shape a scientist's destiny."
  shortBioRu: "\u0413\u0435\u0440\u043c\u0430\u043d \u0412\u0435\u0439\u043b\u044c (1885\u20131955) \u2014
    \u043e\u0434\u0438\u043d \u0438\u0437 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432-\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u043e\u0432,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u043b\u0438
    \u0442\u0435\u043e\u0440\u0438\u044e \u0433\u0440\u0443\u043f\u043f, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0443\u044e
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443, \u0442\u0435\u043e\u0440\u0438\u044e \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043f\u0443\u0442\u044c \u0431\u044b\u043b
    \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0451\u043d
    \u0441 \u0431\u0443\u0440\u043d\u044b\u043c\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438
    XX \u0432\u0435\u043a\u0430.\n\n\U0001F9EC \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 (1885\u20131913)
    \u0413\u0435\u0440\u043c\u0430\u043d \u041a\u043b\u0430\u0443\u0441 \u0413\u0443\u0433\u043e
    \u0412\u0435\u0439\u043b\u044c \u0440\u043e\u0434\u0438\u043b\u0441\u044f 9 \u043d\u043e\u044f\u0431\u0440\u044f
    1885 \u0433\u043e\u0434\u0430 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u042d\u043b\u044c\u043c\u0441\u0445\u043e\u0440\u043d
    \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e \u043e\u0442 \u0413\u0430\u043c\u0431\u0443\u0440\u0433\u0430,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0431\u0430\u043d\u043a\u0438\u0440\u0430 \u041b\u044e\u0434\u0432\u0438\u0433\u0430
    \u0412\u0435\u0439\u043b\u044f \u0438 \u0410\u043d\u043d\u044b \u0412\u0435\u0439\u043b\u044c
    (\u0443\u0440\u043e\u0436\u0434\u0451\u043d\u043d\u043e\u0439 \u0414\u0438\u043a). \u0415\u0433\u043e
    \u043f\u0443\u0442\u044c \u0432 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043d\u0430\u0443\u043a\u0443
    \u043d\u0430\u0447\u0430\u043b\u0441\u044f \u0432 1904 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0446\u0435\u043d\u0442\u0440\u043e\u0432 \u043c\u0438\u0440\u0430. \u0412 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435
    \u0412\u0435\u0439\u043b\u044c \u043f\u043e\u043f\u0430\u043b \u043f\u043e\u0434 \u0441\u0438\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0433\u043e
    \u0414\u0430\u0432\u0438\u0434\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430.
    \u0412\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c,
    \u0447\u0442\u043e \u0412\u0435\u0439\u043b\u044c, \u043f\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e, \u0440\u0435\u0448\u0438\u043b \u0438\u0437\u0443\u0447\u0438\u0442\u044c
    \u0432\u0441\u0451, \u0447\u0442\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e
    \u043a\u0443\u043c\u0438\u0440. \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0435\u0433\u043e
    \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043b \"Zahlbericht\" (\u043e\u0442\u0447\u0451\u0442
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u043e\u0441\u0432\u043e\u0438\u043b \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043b\u0435\u0442\u043d\u0438\u0445 \u043a\u0430\u043d\u0438\u043a\u0443\u043b,
    \u043d\u0430\u0437\u0432\u0430\u0432 \u044d\u0442\u0438 \u043c\u0435\u0441\u044f\u0446\u044b
    \"\u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u0435\u0439\u0448\u0438\u043c\u0438 \u0432
    \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438\". \u0412 1908 \u0433\u043e\u0434\u0443
    \u0412\u0435\u0439\u043b\u044c \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430, \u043f\u043e\u0441\u0432\u044f\u0449\u0451\u043d\u043d\u0443\u044e
    \u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u043c \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c. \u0412 1910 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u0430 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435,
    \u0430 \u0432 1913 \u0433\u043e\u0434\u0443 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043a\u043d\u0438\u0433\u0443 \"\u041a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438\"
    (Die Idee der Riemannschen Fl\u00e4che). \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u043d \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e, \u0441\u043e\u0437\u0434\u0430\u0432
    \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435
    \u0438 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0433\u043e \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f.\n\n\U0001F3D4\ufe0f
    \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434:
    \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u0438 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438 (1913\u20131930) \u0412 1913 \u0433\u043e\u0434\u0443 \u0412\u0435\u0439\u043b\u044c
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0437\u0430\u043d\u044f\u0442\u044c \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0426\u044e\u0440\u0438\u0445\u0441\u043a\u043e\u043c \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c\u0435
    (ETH). \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c. \u0421\u0435\u043c\u044c\u044f:
    \u0412 1913 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u0442\u0441\u044f
    \u043d\u0430 \u0425\u0435\u043b\u0435\u043d\u0435 (\u0425\u0435\u043b\u043b\u0435) \u0419\u043e\u0437\u0435\u0444,
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0435 \u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0447\u0438\u0446\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0435\u0439
    \u042d\u0434\u043c\u0443\u043d\u0434\u0430 \u0413\u0443\u0441\u0441\u0435\u0440\u043b\u044f.
    \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0436\u0435\u043d\u0435 \u0412\u0435\u0439\u043b\u044c
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0435\u0439,
    \u0447\u0442\u043e \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u043e
    \u043d\u0430 \u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435
    \u0432\u0437\u0433\u043b\u044f\u0434\u044b. \u0423 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0434\u0432\u043e\u0435 \u0441\u044b\u043d\u043e\u0432\u0435\u0439: \u0424\u0440\u0438\u0446
    \u0418\u043e\u0430\u0445\u0438\u043c (1915) \u0438 \u041c\u0438\u0445\u0430\u044d\u043b\u044c
    (1917). \u0424\u0438\u0437\u0438\u043a\u0430 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f:
    \u0412 \u0426\u044e\u0440\u0438\u0445\u0435 \u0412\u0435\u0439\u043b\u044c \u0431\u044b\u043b
    \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430, \u0447\u0442\u043e \u043f\u043e\u0434\u043e\u0433\u0440\u0435\u043b\u043e
    \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0444\u0438\u0437\u0438\u043a\u0435.
    \u0412 1918 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442
    \u0441\u0432\u043e\u0439 magnum opus \"\u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u2014 \u0432\u0440\u0435\u043c\u044f \u2014 \u043c\u0430\u0442\u0435\u0440\u0438\u044f\"
    (Raum, Zeit, Materie). \u0412 \u044d\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435 \u043e\u043d
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043f\u0435\u0440\u0432\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0435\u0434\u0438\u043d\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u043e\u043b\u044f, \u043f\u043e\u043f\u044b\u0442\u0430\u0432\u0448\u0438\u0441\u044c
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044e
    \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c.
    \u0421\u0430\u043c\u044b\u043c \u0432\u0430\u0436\u043d\u044b\u043c \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u043c
    \u0432 \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u0431\u044b\u043b\u043e
    \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u044f
    \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043e\u0447\u043d\u043e\u0439 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u0438
    (gauge invariance). \u0418\u0434\u0435\u044f \u0431\u044b\u043b\u0430 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    (\u0445\u043e\u0442\u044f \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043d\u0435\u0432\u0435\u0440\u043d\u044b\u043c), \u0438 \u043f\u043e\u0437\u0436\u0435
    \u043e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u044f \u0438 \u0444\u0438\u0437\u0438\u043a\u0438
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0438\u0446.
    \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438:
    \u0412 \u0442\u043e\u043c \u0436\u0435 1918 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \"\u041a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c\"
    (Das Kontinuum), \u043f\u043e\u0441\u0432\u044f\u0449\u0451\u043d\u043d\u0430\u044f \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0443 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0412\u0435\u0439\u043b\u044c \u0431\u044b\u043b
    \u0431\u043b\u0438\u0437\u043e\u043a \u043a \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u043e\u043d\u0438\u0437\u043c\u0443
    \u041b\u0435\u0439\u0442\u0437\u0435\u043d\u0430 \u0411\u0440\u0430\u0443\u044d\u0440\u0430
    \u0438 \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0430\u043d\u0430\u043b\u0438\u0437 \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0439,
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0443\u043f\u043f \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430: \u0421 1923 \u043f\u043e 1938 \u0433\u043e\u0434
    \u0412\u0435\u0439\u043b\u044c \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b
    \u043e\u0431\u0449\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f \u0438 \u0438\u0445 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439.
    \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c \u043e\u0441\u043e\u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0438 \u0432 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a
    \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435, \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f. \u042d\u0442\u0438
    \u0438\u0434\u0435\u0438 \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0435\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u043d\u0438\u0433\u0438 \"\u0422\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0443\u043f\u043f
    \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\"
    (1928), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439
    \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u043e\u0432-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u0432.\n\n\U0001F534
    \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d, \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f
    \u0438 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d (1930\u20131955) \u0412 1930 \u0433\u043e\u0434\u0443
    \u0412\u0435\u0439\u043b\u044c \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d, \u0447\u0442\u043e\u0431\u044b
    \u0437\u0430\u043d\u044f\u0442\u044c \u043c\u0435\u0441\u0442\u043e \u0441\u0432\u043e\u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0435
    \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0435\u0434\u043e\u043b\u0433\u0438\u043c.
    \u0411\u0435\u0433\u0441\u0442\u0432\u043e \u043e\u0442 \u043d\u0430\u0446\u0438\u0437\u043c\u0430:
    \u0421 \u043f\u0440\u0438\u0445\u043e\u0434\u043e\u043c \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u0432 1933 \u0433\u043e\u0434\u0443 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438 \u0441\u0442\u0430\u043b\u0430 \u043e\u043f\u0430\u0441\u043d\u043e\u0439.
    \u0416\u0435\u043d\u0430 \u0412\u0435\u0439\u043b\u044f, \u0425\u0435\u043b\u043b\u0430,
    \u0431\u044b\u043b\u0430 \u0435\u0432\u0440\u0435\u0439\u043a\u043e\u0439, \u0438 \u0438\u0445
    \u0434\u0435\u0442\u0438 \u0442\u0430\u043a\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c
    \u0435\u0432\u0440\u0435\u044f\u043c\u0438 \u043f\u043e \u0437\u0430\u043a\u043e\u043d\u0430\u043c
    \u0422\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0440\u0435\u0439\u0445\u0430. \u0412\u0435\u0439\u043b\u044c
    \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432\u043e\u0437\u043c\u0443\u0449\u0451\u043d
    \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0439 \u0440\u0435\u0436\u0438\u043c\u0430.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0410\u0432\u0440\u0430\u0430\u043c\u0430
    \u0424\u043b\u0435\u043a\u0441\u043d\u0435\u0440\u0430 \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432
    \u043d\u0435\u0434\u0430\u0432\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0433\u043e
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0433\u0434\u0435 \u0443\u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d.
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u0438\u0435 \u0433\u043e\u0434\u044b:
    \u0412 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0412\u0435\u0439\u043b\u044c
    \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043e 1951 \u0433\u043e\u0434\u0430.
    \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u0441\u0432\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f,
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0432 \u0432 1939 \u0433\u043e\u0434\u0443
    \u043a\u043d\u0438\u0433\u0443 \"\u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b, \u0438\u0445 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b
    \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f\".
    \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u043b\u0438
    \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0441\u043f\u0435\u043a\u0442\u0440: \u043e\u0442
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0434\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c: \u0412 1948 \u0433\u043e\u0434\u0443 \u0435\u0433\u043e
    \u0436\u0435\u043d\u0430 \u0425\u0435\u043b\u043b\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c.
    \u0412 1950 \u0433\u043e\u0434\u0443 \u0412\u0435\u0439\u043b\u044c \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0441\u043a\u0443\u043b\u044c\u043f\u0442\u043e\u0440\u0435 \u042d\u043b\u043b\u0435\u043d
    \u0411\u044d\u0440 \u0438\u0437 \u0426\u044e\u0440\u0438\u0445\u0430. \u0412\u044b\u0439\u0434\u044f
    \u043d\u0430 \u043f\u0435\u043d\u0441\u0438\u044e \u0432 1951 \u0433\u043e\u0434\u0443,
    \u0412\u0435\u0439\u043b\u044c \u0434\u0435\u043b\u0438\u043b \u0432\u0440\u0435\u043c\u044f
    \u043c\u0435\u0436\u0434\u0443 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u043e\u043c
    \u0438 \u0426\u044e\u0440\u0438\u0445\u043e\u043c. \u0412 1952 \u0433\u043e\u0434\u0443
    \u0432\u044b\u0448\u043b\u0430 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430\u044f \u0448\u0438\u0440\u043e\u043a\u043e\u0439
    \u043f\u0443\u0431\u043b\u0438\u043a\u0435 \u043a\u043d\u0438\u0433\u0430 \"\u0421\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f\",
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u044d\u0442\u043e\u0433\u043e
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0435.
    \u0413\u0435\u0440\u043c\u0430\u043d \u0412\u0435\u0439\u043b\u044c \u0441\u043a\u043e\u0440\u043e\u043f\u043e\u0441\u0442\u0438\u0436\u043d\u043e
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 8 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1955 \u0433\u043e\u0434\u0430 \u0432 \u0426\u044e\u0440\u0438\u0445\u0435. \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0444\u0438\u0437\u0438\u043a \u0424\u0440\u0438\u043c\u0435\u043d
    \u0414\u0430\u0439\u0441\u043e\u043d \u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u0437\u0432\u0430\u043b
    \u0435\u0433\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c XX \u0432\u0435\u043a\u0430,
    \u043a\u043e\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434 \u0441 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u0438 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c.\n\n\U0001F9E0 \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435
    \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u0438 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0412\u0435\u0439\u043b\u044c \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c.
    \u0415\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u043e\u0442 \u043a\u0430\u043d\u0442\u0438\u0430\u043d\u0441\u0442\u0432\u0430 \u043f\u043e\u0434
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u043a \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0438 \u0413\u0443\u0441\u0441\u0435\u0440\u043b\u044f,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u043a \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u043c\u0443 \u0424\u0438\u0445\u0442\u0435. \u041e\u043d
    \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0451\u043d, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u044d\u0442\u043e \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0434\u0443\u0445\u0430,
    \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0443
    \u0438 \u043c\u0443\u0437\u044b\u043a\u0435. \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0444\u0440\u0430\u0437\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043a\u0430\u043a
    \u043d\u0435\u043b\u044c\u0437\u044f \u043b\u0443\u0447\u0448\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442
    \u0435\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043d\u0430\u0443\u043a\u0435:
    > \"\u041c\u043e\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0430\u0441\u044c \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c
    \u0438\u0441\u0442\u0438\u043d\u0443 \u0441 \u043a\u0440\u0430\u0441\u043e\u0442\u043e\u0439,
    \u043d\u043e \u043a\u043e\u0433\u0434\u0430 \u043c\u043d\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c \u043e\u0434\u043d\u043e \u0438\u0437 \u0434\u0432\u0443\u0445,
    \u044f \u043e\u0431\u044b\u0447\u043d\u043e \u0432\u044b\u0431\u0438\u0440\u0430\u043b \u043a\u0440\u0430\u0441\u043e\u0442\u0443\"."
  shortBioEn: "Herman Weil (1885–55) is one of the most recent universal mathematicians whose work covered group theory, differential geometry, quantum mechanics, relativity and mathematics philosophy, and his scientific path was closely linked to the violent events of the twentieth century.\n\n==History==Herman Klaus Hugo Weil was born on November 9, 1885 in the small town of Elmshorn, near Hamburg, in the family of banker Ludwig Veil and Anna Weil (born Dick), and his journey to great science began in 1904 when he entered Göttingen University, one of the world's leading mathematical centres, and was heavily influenced by legendary David Gilbert in Göttingen.The impression was so deep that he admitted that Weil decided to study everything he wrote, especially that he was captured by the \"Zahlbegericht\" (the number theory report), which he learned on his own during the summer vacation, calling these months \"the happiest in his life.\" In 1908, Weil defended a doctoral thesis under Gilbert's leadership, dedicated to the singular integrated equations.In 1910, he received a position as a private assistant in Göttingen, and in 1913, he published his first fundamental book, \"De Idee der Riemannschen Fläche\", in which he brilliantly combined the theory of functions, geometry and topology, creating the first modern and strict definition of abstract diversity.\n\nIn 1913, Weil accepted the invitation to take up the Department of Mathematics at the Zurich Polytechnic (ETH). This period became incredibly fruitful for him.They had two sons, Fritz Joachim (1915) and Michael (1917). Physics and Geometry: in Zurich, Weil was a colleague of Albert Einstein, which warmed his interest in physics. In 1918, he published his magnum opus, \"Space — Time — Matter\" (Raum, Zeit, Materie), in which he proposed the first geometrical unified field theory, attempting to combine gravity and electromagnetism.The most important and innovative concept in this theory was the introduction of the concept of calibration invariance; the idea was revolutionary for its time (although the original version of the theory proved to be wrong), and later became the cornerstone of quantum field theory and particle physics.Mathematics: In 1918, his work \"Das Kontinuum\" was published, focusing on a critical revision of the basis of the mathematical analysis, and Veil was close to Leitzen Brauer's intuitiveism and sought to build the analysis on a more rigorous, constructive basis, and group theory and quantum mechanics: from 1923 to 1938, Weil developed a common theory of continuous groups and their representations.He first realized that the symmetry in quantum mechanics, such as spinning, was best described through group theory, which formed the basis of his classic book \"Theory of Groups and Quantum Mechanics\" (1928), which became a desk for theoretical physicists.\n\nIn 1930, Weil returned to Göttingen to take the place of his teacher Gilbert, but his stay in his home country was short-lived.In the same year, he accepted Abraham Flexner's offer and became one of the first professors of the newly established Institute of Advanced Studies in Princeton, where Einstein had already worked.His scientific interests continued to range from mathematics philosophy to algebraic numbers theory. Personal life: in 1948, his wife Hella died. In 1950, Weil married Ellen Bare of Zurich, retired in 1951, and Weil shared time between Princeton and Zurich.In 1952, his famous and widely available book, \"Symmetry\", was published, in which he examined the manifestation of this principle in mathematics, art and nature, and Herman Weil died of a heart attack on 8 December 1955 in Zurich, and the world-famous physicist Freeman Dyson later called him the only mathematician in the 20th century who could be placed in the same row as Poancar and Gilbert.\n\nHe was not only a mathematician, but also a deep philosopher, and his views evolved from canthianism, influenced by Gilbert's axiomatic method to Guzserl's phenomenalology, and then to Ficht's metaphysical idealism. He was convinced that mathematics was a creative activity of the human spirit, related art and music.His famous phrase, which best describes his approach to science: > \"My work has always sought to combine truth with beauty, but when I had to choose one of the two, I usually chose beauty.\""
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0413\u0435\u0440\u043c\u0430\u043d\u0430 \u0412\u0435\u0439\u043b\u044f
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0439, \u043d\u043e \u0438 \u044f\u0440\u043a\u0438\u0445
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u0441\u0442\u0443\u043f\u043a\u043e\u0432,
    \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u0435\u0432
    \u0438 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u0432. \u0417\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u043c
    \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0441\u044f \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u044b\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444, \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u044b\u0439
    \u043f\u043e\u043a\u043b\u043e\u043d\u043d\u0438\u043a \u043f\u0440\u0438\u0440\u043e\u0434\u044b
    \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u043d\u0435 \u0447\u0443\u0436\u0434\u044b\u0439
    \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445:
    1.\n\n\U0001F48D \u041b\u044e\u0431\u043e\u0432\u043d\u044b\u0439 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a
    \u0441 \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u043e\u043c \u041f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u044b\u0439 \u043f\u0438\u043a\u0430\u043d\u0442\u043d\u044b\u0439 \u0441\u044e\u0436\u0435\u0442
    \u0432 \u0436\u0438\u0437\u043d\u0438 \u0412\u0435\u0439\u043b\u044f \u0441\u0432\u044f\u0437\u0430\u043d
