    \u2014 \u0444\u0438\u0437\u0438\u043a\u043e\u043c \u042d\u0440\u0432\u0438\u043d\u043e\u043c
    \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u043e\u043c. \u041a\u043e\u0433\u0434\u0430
    \u0412\u0435\u0439\u043b\u044c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u0426\u044e\u0440\u0438\u0445\u0435, \u043e\u043d \u0442\u0435\u0441\u043d\u043e
    \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0441\u044f \u0441\u043e \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u043e\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0438\u0445 \u0434\u0440\u0443\u0436\u0431\u0430 \u0431\u044b\u043b\u0430
    \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0430 \u0442\u0435\u043c, \u0447\u0442\u043e
    \u0443 \u0412\u0435\u0439\u043b\u044f \u0437\u0430\u0432\u044f\u0437\u0430\u043b\u0441\u044f
    \u0440\u043e\u043c\u0430\u043d \u0441 \u0436\u0435\u043d\u043e\u0439 \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u0430
    \u2014 \u0410\u043d\u043d\u0435\u043c\u0430\u0440\u0438. \u0421\u0430\u043c\u043e\u0435
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435, \u0447\u0442\u043e
    \u044d\u0442\u0430 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u043d\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u0430
    \u043a \u0440\u0430\u0437\u0440\u044b\u0432\u0443: \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u043b\u043e\u0432\u0435\u043b\u0430\u0441\u043e\u043c,
    \u0438, \u043f\u043e-\u0432\u0438\u0434\u0438\u043c\u043e\u043c\u0443, \u0432\u0441\u0435
    \u0442\u0440\u043e\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438 \u0434\u0430\u0436\u0435 \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f.
    \u041f\u043e\u0437\u0436\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043d\u0430\u0443\u043a\u0438
    \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438, \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e \u0431\u0443\u0440\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
