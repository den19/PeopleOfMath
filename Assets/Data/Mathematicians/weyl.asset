    \u0433\u043e\u0440\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438. \u041e\u0434\u043d\u0430\u0436\u0434\u044b,
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0442\u043f\u0443\u0441\u043a\u0430 \u0432
    \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f\u0430\u0445,
    \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u043a\u0443\u043f\u0438\u0442\u044c \u0441\u0435\u0431\u0435
    \u0430\u043b\u044c\u043f\u0435\u043d\u0448\u0442\u043e\u043a (\u0434\u043b\u0438\u043d\u043d\u0443\u044e
    \u0433\u043e\u0440\u043d\u0443\u044e \u043f\u0430\u043b\u043a\u0443) \u0438 \u043a\u043d\u0443\u0442.
    \u041e\u0441\u043c\u043e\u0442\u0440\u0435\u0432 \u0442\u043e\u0432\u0430\u0440 \u0432 \u043c\u0435\u0441\u0442\u043d\u043e\u0439
    \u043b\u0430\u0432\u043a\u0435, \u0412\u0435\u0439\u043b\u044c \u0441 \u043f\u0440\u0438\u0441\u0443\u0449\u0435\u0439
    \u0435\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u043e\u0442\u043e\u0448\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0435\u0448\u0438\u043b
    \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e
    \u043a\u043d\u0443\u0442\u0430: \u043e\u043d \u0445\u043b\u0435\u0441\u0442\u043d\u0443\u043b
    \u0438\u043c \u043f\u043e \u043f\u0440\u0438\u043b\u0430\u0432\u043a\u0443, \u0447\u0442\u043e\u0431\u044b
    \u0443\u0441\u043b\u044b\u0448\u0430\u0442\u044c \u0437\u0432\u043e\u043d\u043a\u0438\u0439
    \u0449\u0435\u043b\u0447\u043e\u043a. \u0429\u0435\u043b\u0447\u043e\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0441\u044f
    \u043e\u0433\u043b\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c, \u043d\u043e
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043d\u0438\u043c \u0440\u0430\u0437\u0434\u0430\u043b\u0441\u044f
    \u0437\u0432\u043e\u043d \u0440\u0430\u0437\u0431\u0438\u0442\u043e\u0433\u043e \u0441\u0442\u0435\u043a\u043b\u0430
    \u2014 \u043e\u043d \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u0437\u0430\u0434\u0435\u043b
    \u0432\u0438\u0442\u0440\u0438\u043d\u0443. \u0421\u043a\u043e\u043d\u0444\u0443\u0436\u0435\u043d\u043d\u044b\u0439
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0431\u044b\u043b \u0437\u0430\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0437\u0430 \u0440\u0430\u0437\u0431\u0438\u0442\u043e\u0435
    \u0441\u0442\u0435\u043a\u043b\u043e, \u043d\u043e \u043a\u043d\u0443\u0442 \u0432\u0441\u0435-\u0442\u0430\u043a\u0438
    \u043a\u0443\u043f\u0438\u043b \u0438 \u043f\u043e\u0442\u043e\u043c \u0441 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u044c\u044e
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u044d\u0442\u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u044e
    \u043a\u0430\u043a \u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0441\u043f\u0430\u0441\u0430\u0435\u0442 \u043e\u0442 \u0444\u0438\u0437\u0438\u043a\u0438.
    3.\n\n\U0001F3A8 \u0421\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f \u0438 \"\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\"
    \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u043a\u043d\u0438\u0433\u0430
    \"\u0421\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f\" \u0432\u044b\u0440\u043e\u0441\u043b\u0430
    \u0438\u0437 \u043b\u0435\u043a\u0446\u0438\u0439, \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043d\u044b\u0445
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u0412\u0435\u0439\u043b\u044c
    \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0443\u0431\u0435\u0436\u0434\u0435\u043d,
    \u0447\u0442\u043e \u043a\u0440\u0430\u0441\u043e\u0442\u0430 \u2014 \u044d\u0442\u043e
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f.
    \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442 \u043a\u0440\u0430\u0441\u043e\u0442\u0443,
    \u0435\u0441\u043b\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c
    \u043c\u0435\u0436\u0434\u0443 \u043a\u0440\u0430\u0441\u043e\u0442\u043e\u0439 \u0438 \u0438\u0441\u0442\u0438\u043d\u043e\u0439.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u043d \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u0438 \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u043d\u0435 \u0438\u0437
    \u0441\u0443\u0445\u0438\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432, \u0430
    \u0438\u0437 \u044d\u0441\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u044f \u043e\u0442 \u0438\u0437\u044f\u0449\u0435\u0441\u0442\u0432\u0430
    \u0444\u043e\u0440\u043c\u0443\u043b. \u041e\u043d \u043e\u0431\u043e\u0436\u0430\u043b
    \u0432\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u0438 \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u0441\u0435\u0449\u0430\u043b \u043c\u0443\u0437\u0435\u0439
    \u041c\u0435\u0442\u0440\u043e\u043f\u043e\u043b\u0438\u0442\u0435\u043d \u0432 \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0435,
    \u0447\u0442\u043e\u0431\u044b \u0440\u0438\u0441\u043e\u0432\u0430\u0442\u044c \u043d\u0430\u0431\u0440\u043e\u0441\u043a\u0438
    \u0430\u0440\u0430\u0431\u0435\u0441\u043e\u043a \u0438 \u043e\u0440\u043d\u0430\u043c\u0435\u043d\u0442\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u043a\u0430\u043a \u043e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \"\u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u0435\u043c\u0443
    \u043e \u0433\u0440\u0443\u043f\u043f\u0430\u0445 \u0431\u043e\u043b\u044c\u0448\u0435,
    \u0447\u0435\u043c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438\". 4.\n\n\u2712\ufe0f
    \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b \u0441 \"\u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438\" \u041a\u043e\u0433\u0434\u0430 \u0412\u0435\u0439\u043b\u044c
    \u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0439 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \"\u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b\", \u043e\u043d \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e
    \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u043a\u043d\u0438\u0433\u0443 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e
    \u0441\u0436\u0430\u0442\u043e\u0439 \u0438 \u0441\u0442\u0440\u043e\u0433\u043e\u0439.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u043f\u0440\u0438\u043c\u0435\u0440\u0430\u043c\u0438
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u044d\u043a\u0441\u043a\u0443\u0440\u0441\u0430\u043c\u0438,
    \u0447\u0442\u043e \u043e\u0431\u044a\u0435\u043c \u0442\u0435\u043a\u0441\u0442\u0430 \u0432\u044b\u0440\u043e\u0441
    \u0432 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u043f\u0440\u043e\u0442\u0438\u0432
    \u0437\u0430\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e.
    \u0418\u0437\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0431\u044b\u043b\u043e
    \u0432 \u0448\u043e\u043a\u0435, \u043d\u043e \u0412\u0435\u0439\u043b\u044c \u043d\u0430\u0441\u0442\u043e\u044f\u043b
    \u043d\u0430 \u0441\u0432\u043e\u0435\u043c, \u0441\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e
    \"\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0431\u0435\u0437 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043f\u043e\u0434\u043e\u0431\u043d\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443
    \u0431\u0435\u0437 \u043f\u0430\u043c\u044f\u0442\u0438\". \u0412 \u0438\u0442\u043e\u0433\u0435
    \u044d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430, \u0432\u043e\u043f\u0440\u0435\u043a\u0438
    \u043e\u043f\u0430\u0441\u0435\u043d\u0438\u044f\u043c \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u0439,
    \u0441\u0442\u0430\u043b\u0430 \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440\u043e\u043c
    \u0441\u0440\u0435\u0434\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0438 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u043d\u0438\u0439. 5.\n\n\U0001F1FA\U0001F1F8
    \u041a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434 \u043e\u0442\u044a\u0435\u0437\u0434\u043e\u043c
    \u0432 \u0421\u0428\u0410 \u0412 1932 \u0433\u043e\u0434\u0443 \u0412\u0435\u0439\u043b\u044e
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u0442\u044c \u0432 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0442\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435. \u041e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f,
    \u043d\u0430\u043f\u0438\u0441\u0430\u0432, \u0447\u0442\u043e \"\u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f
    \u2014 \u0435\u0433\u043e \u0434\u0443\u0445\u043e\u0432\u043d\u0430\u044f \u0440\u043e\u0434\u0438\u043d\u0430,
    \u0438 \u043e\u043d \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u0440\u043e\u0441\u0438\u0442\u044c
    \u0435\u0435 \u0432 \u0442\u0440\u0443\u0434\u043d\u044b\u0439 \u0447\u0430\u0441\". \u041e\u0434\u043d\u0430\u043a\u043e
    \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 \u0433\u043e\u0434, \u043a\u043e\u0433\u0434\u0430
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u0438\u0448\u043b\u0438 \u043d\u0430\u0446\u0438\u0441\u0442\u044b,
    \u043e\u043d \u0441 \u0433\u043e\u0440\u0435\u0447\u044c\u044e \u043f\u0440\u0438\u0437\u043d\u0430\u043b
    \u0441\u0432\u043e\u044e \u043e\u0448\u0438\u0431\u043a\u0443. \u0412 \u043f\u0438\u0441\u044c\u043c\u0435
    \u0434\u0440\u0443\u0433\u0443 \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b:
    \"\u042f \u0434\u0443\u043c\u0430\u043b, \u0447\u0442\u043e \u0441\u043f\u0430\u0441\u0443
    \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0443\u043a\u0438 \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438,
    \u043d\u043e \u043d\u0430\u0443\u043a\u0430 \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u0431\u0435\u0441\u0441\u0438\u043b\u044c\u043d\u0430 \u043f\u0435\u0440\u0435\u0434 \u0437\u043b\u043e\u043c.
    \u0422\u0435\u043f\u0435\u0440\u044c \u044f \u0431\u0435\u0433\u0443 \u043d\u0435 \u043e\u0442
    \u043d\u0435\u043c\u0446\u0435\u0432, \u0430 \u043e\u0442 \u0438\u0445 \u0431\u0435\u0437\u0443\u043c\u0438\u044f\".
    \u042d\u0442\u043e\u0442 \u043e\u0442\u044a\u0435\u0437\u0434 \u0441\u043f\u0430\u0441 \u0435\u043c\u0443
    \u0436\u0438\u0437\u043d\u044c \u2014 \u043c\u043d\u043e\u0433\u0438\u0435 \u0435\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438, \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435, \u043f\u043e\u0433\u0438\u0431\u043b\u0438
    \u0432 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445
    \u043b\u0430\u0433\u0435\u0440\u044f\u0445. 6.\n\n\U0001F3D4\ufe0f \u0421\u0442\u0440\u0430\u0441\u0442\u044c
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0432 \u043f\u043e\u043b\u0435\u0442\u0435
    \u0412\u0435\u0439\u043b\u044c \u043e\u0431\u043e\u0436\u0430\u043b \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u043d\u0430 \u043f\u0430\u0440\u043e\u0445\u043e\u0434\u0430\u0445 \u0438 \u043f\u043e\u0435\u0437\u0434\u0430\u0445.
    \u0415\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0438,
    \u0447\u0442\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0442\u0440\u0430\u043d\u0441\u0430\u0442\u043b\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u043e\u0432 \u0438\u0437 \u0415\u0432\u0440\u043e\u043f\u044b
    \u0432 \u0410\u043c\u0435\u0440\u0438\u043a\u0443 \u043e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0441\u0438\u0434\u0435\u043b \u0432 \u043a\u0430\u044e\u0442\u0435 \u0437\u0430
    \u0441\u0442\u043e\u043b\u043e\u043c. \u041e\u043d \u0432\u044b\u0445\u043e\u0434\u0438\u043b
    \u043d\u0430 \u043f\u0430\u043b\u0443\u0431\u0443, \u0441\u0430\u0434\u0438\u043b\u0441\u044f
    \u0432 \u0448\u0435\u0437\u043b\u043e\u043d\u0433, \u043d\u0430\u043a\u0440\u044b\u0432\u0430\u043b
    \u043d\u043e\u0433\u0438 \u043f\u043b\u0435\u0434\u043e\u043c \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u043b
    \u043f\u0438\u0441\u0430\u0442\u044c \u043f\u0440\u044f\u043c\u043e \u0432 \u0431\u043b\u043e\u043a\u043d\u043e\u0442\u0435,
    \u0433\u043b\u044f\u0434\u044f \u043d\u0430 \u043e\u043a\u0435\u0430\u043d. \u041d\u0430
    \u0432\u043e\u043f\u0440\u043e\u0441, \u0437\u0430\u0447\u0435\u043c \u043e\u043d \u044d\u0442\u043e
    \u0434\u0435\u043b\u0430\u0435\u0442, \u0412\u0435\u0439\u043b\u044c \u043e\u0442\u0432\u0435\u0447\u0430\u043b:
    \"\u0412\u043e\u043b\u043d\u044b \u0438 \u0432\u0435\u0442\u0435\u0440 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442
    \u043c\u043d\u0435 \u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445, \u043e\u043d\u0438 \u0443\u0441\u043f\u043e\u043a\u0430\u0438\u0432\u0430\u044e\u0442
    \u0443\u043c \u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u0432\u0438\u0434\u0435\u0442\u044c
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043e\u0431\u044a\u0435\u043c\u043d\u043e\".
    \u041c\u043d\u043e\u0433\u0438\u0435 \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u043f\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f \u0431\u044b\u043b\u0438
    \u0440\u043e\u0436\u0434\u0435\u043d\u044b \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u0442\u0430\u043a\u0438\u0445
    \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f\u0445.
    7.\n\n\U0001F52C \u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u044d\u0432\u0442\u0430\u043d\u0430\u0437\u0438\u0438
    \u0411\u0443\u0434\u0443\u0447\u0438 \u0442\u044f\u0436\u0435\u043b\u043e \u0431\u043e\u043b\u044c\u043d\u044b\u043c
    \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438,
    \u0412\u0435\u0439\u043b\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b \u044f\u0441\u043d\u043e\u0441\u0442\u044c
    \u0443\u043c\u0430 \u0434\u043e \u0441\u0430\u043c\u043e\u0433\u043e \u043a\u043e\u043d\u0446\u0430.
    \u041e\u043d \u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e
    \u0441\u043b\u0430\u0431\u043e\u0435 \u0441\u0435\u0440\u0434\u0446\u0435, \u0438 \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u0432 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0435 \u0441 \u0432\u0440\u0430\u0447\u043e\u043c
    \u043f\u043e\u0448\u0443\u0442\u0438\u043b: \"\u0415\u0441\u043b\u0438 \u043c\u043e\u0435
    \u0441\u0435\u0440\u0434\u0446\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f,
    \u043d\u0435 \u043f\u044b\u0442\u0430\u0439\u0442\u0435\u0441\u044c \u0435\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c
    \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c. \u0423
    \u043c\u0435\u043d\u044f \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c, \u0438 \u044f \u043d\u0435 \u0445\u043e\u0447\u0443, \u0447\u0442\u043e\u0431\u044b
    \u043c\u0435\u043d\u044f \u043d\u0430\u0441\u0438\u043b\u044c\u043d\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u043b\u0438
    \u0432 \u044d\u0442\u043e\u0442 \u043c\u0438\u0440 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c,
    \u043a\u0430\u043a \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0442\u0435\u043e\u0440\u0435\u043c\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u044f \u0443\u0436\u0435 \u043f\u043e\u043d\u044f\u043b\".
    \u042d\u0442\u0430 \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u0430\u044f \u0444\u0440\u0430\u0437\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c
    \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435\u043c \u2014 \u043e\u043d \u0443\u043c\u0435\u0440
    \u043e\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430
    \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e, \u043d\u043e \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e,
    \u043a\u0430\u043a \u0438 \u0445\u043e\u0442\u0435\u043b. 8.\n\n\U0001F4D5 \u0421\u0435\u043a\u0440\u0435\u0442
    \"\u041a\u0440\u0430\u0441\u0438\u0432\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\"
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0435\u0433\u043e \u0441\u0442\u0443\u0434\u0435\u043d\u0442
    \u0441\u043f\u0440\u043e\u0441\u0438\u043b, \u043a\u0430\u043a \u043e\u0442\u043b\u0438\u0447\u0438\u0442\u044c
    \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043e\u0442 \u043f\u043b\u043e\u0445\u043e\u0433\u043e. \u0412\u0435\u0439\u043b\u044c
    \u0437\u0430\u0434\u0443\u043c\u0430\u043b\u0441\u044f \u043d\u0430 \u043c\u0438\u043d\u0443\u0442\u0443
    \u0438 \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \"\u0415\u0441\u043b\u0438 \u0432\u044b
    \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e,
    \u0438 \u0443 \u0432\u0430\u0441 \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u043e \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435,
    \u0447\u0442\u043e \u0430\u0432\u0442\u043e\u0440 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0438\u043b
    \u0441\u043b\u043e\u0432\u0430 \u0432 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u043c
    \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u2014 \u044d\u0442\u043e \u043f\u043b\u043e\u0445\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e. \u0415\u0441\u043b\u0438
    \u0436\u0435 \u0432\u044b \u0434\u043e\u0447\u0438\u0442\u0430\u043b\u0438 \u0438 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043c\u043e\u0433\u043b\u0438 \u0431\u044b \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u0442\u044c
    \u044d\u0442\u043e \u0441\u0430\u043c\u0438, \u0442\u043e\u043b\u044c\u043a\u043e \u0443
    \u0432\u0430\u0441 \u043d\u0435 \u0445\u0432\u0430\u0442\u0438\u043b\u043e \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u0438
    \u2014 \u044d\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\".
    \u0421\u0430\u043c \u0412\u0435\u0439\u043b\u044c \u0441\u0442\u0430\u0440\u0430\u043b\u0441\u044f
    \u043f\u0438\u0441\u0430\u0442\u044c \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043a,
    \u0447\u0442\u043e\u0431\u044b \u043a\u0430\u0436\u0434\u044b\u0439 \u0435\u0433\u043e \u0432\u044b\u0432\u043e\u0434
    \u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u044e
    \"\u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c \u0438 \u043d\u0435\u0438\u0437\u0431\u0435\u0436\u043d\u044b\u043c\",
    \u0445\u043e\u0442\u044f \u0437\u0430 \u044d\u0442\u0438\u043c \u0441\u0442\u043e\u044f\u043b\u0438
    \u0433\u043e\u0434\u044b \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u044b."
  interestingFactsEn: "Herman Weil's life was filled not only with deep scientific insight, but also with vivid human actions, funny times and paradoxes, and behind this strict mathematician was an ironic philosopher, a passionate fan of nature and a man who was not a stranger to romantic adventures.\n\nThe love triangle with Schroedinger, I think, is the most spicy story in Weil's life, connected to his friend and colleague, physicist Ervin Schroedinger. When Weil taught in Zurich, he became very close friends with Schroedinger, but their friendship was complicated by the fact that Weil had an affair with Schroedinger's wife, Annemary.The most surprising thing is that this situation did not lead to a break-up: Schroedinger was a famous fishing man, and apparently all three kept intellectual and even friendly relations. Later, the historians of science noted that it was during this stormy time that both scientists made their greatest discoveries in quantum mechanics and group theory.\n\n♪ Knut, who wasn't just a theoryr, but also a practicer who loved to go on a mountain trip, one day, during his holiday in the Swiss Alps, he decided to buy himself an alpentoke (long mountain stick) and a whip. ♪ When he checked the goods in the local shop, Veil, with his own mathematical precision, decided to check the whip's quality: he clapped them on the counter to hear the bell clicks.The click came out deafening, but with it a ring of broken glass, he accidentally hit the window, and the confused professor had to pay for the broken glass, but the whip did buy and then proudly told the story as an example of how math doesn't always save from physics.\n\nHis famous book \"Symmetry\" grew out of lectures given at the Institute of Advanced Studies. Weil was deeply convinced that beauty was an instrument of knowledge. He argued that he always chose beauty between beauty and truth. He once noticed that many of his mathematical ideas were born not from sound calculations, but from the aesthetic pleasure of the grace of formulas.He loved East Art and often visited the Metropolitan Museum in New York to paint sketches of Arab and ornaments that he said \"told him more about groups than textbooks.\" 4.\n\nThe irony of fate with \"Classic Groups\" when Weil wrote his fundamental work, \"Classic Groups\", he originally planned to make the book as concise and rigorous as possible. However, in the course of his work, he was so enthralled with examples and historical tours that the length of the text had tripled, and the publishing house was shocked, but Veil insisted that \"mathematics without history is like a man without memory\".So this book, despite the publishers' fears, became a bestseller among the mathematicians and survived many overplays. 5.\n\nIn 1932, Weil was first offered a move to a newly founded Institute in Princeton, and he refused to write that \"Germany is his spiritual homeland and he cannot abandon it at a difficult hour.\" However, a year later, when the Nazis came to power, he confessed his mistake with sorrow. In a letter to a friend, he wrote: \"I thought I would save the honour of science in Germany, but science was powerless before evil.Now I'm not running away from the Germans, but from their madness.\" This departure saved his life -- many of his colleagues left in Göttingen died in concentration camps.\n\n▪ The passion for mathematics in the flight of Veil loved to travel by boat and train. His colleagues recalled that during the transatlantic transitions from Europe to America he never sat in a cabin at a table. He went out to the deck, sat on a helmet, covered his feet with a palette, and began writing right in a notebook, looking at the ocean.When asked why he was doing it, Weil said, \"The waves and the wind remind me of differential equations, they calm the mind and allow us to see solutions in a volumetric way.\" Many of his ideas about group theory were born in these sea travels.\n\nHe said, \"If my heart stops, don't try to turn it on.\"This ironic phrase became a will — he died of a heart attack suddenly, but calmly, as he wanted. 8.\n\nThe secret of \"Beautiful Evidence\" once asked his student how to distinguish good evidence from bad. Veil thought for a minute and replied, \"If you read the evidence and you had the feeling that the author simply translated the words in the right order, it was bad proof; but if you read it and felt that you could come up with it yourself, only you didn't have the courage to do it, it was brilliant proof.\"Weil himself tried to write in such a way that each of his findings seemed \"obvious and inevitable\" to the reader, even though it had been behind it years of hard work."
