  achievementsRu: "\u0412\u0435\u0439\u043B\u044C \u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u0441\u043B\u0435\u0434 \u0432
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u0438 \u0444\u0438\u0437\u0438\u043A\u0435,
    \u043F\u0440\u0438\u0447\u0435\u043C \u0435\u0433\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u0430\u044F
    \u0440\u043E\u043B\u044C \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u043B\u0430\u0441\u044C
    \u0432 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043C\u043E\u0441\u0442\u043E\u0432
    \u043C\u0435\u0436\u0434\u0443 \u044D\u0442\u0438\u043C\u0438, \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u0431\u044B, \u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u043E\u0431\u043B\u0430\u0441\u0442\u044F\u043C\u0438.
    \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0435\u0448\u0430\u043B
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0430 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u043B \u043D\u043E\u0432\u044B\u0435
    \u044F\u0437\u044B\u043A\u0438 \u0434\u043B\u044F \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F
    \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438, \u043E\u0442 \u043C\u0438\u043A\u0440\u043E\u043C\u0438\u0440\u0430
    \u0434\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u0412\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439.
    \u0415\u0433\u043E \u0432\u043A\u043B\u0430\u0434 \u043C\u043E\u0436\u043D\u043E
    \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439.  ### \U0001F4D0
    \"\u041F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E, \u0432\u0440\u0435\u043C\u044F,
    \u043C\u0430\u0442\u0435\u0440\u0438\u044F\": \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0437\u0430\u0446\u0438\u044F
    \u0444\u0438\u0437\u0438\u043A\u0438  \u0412 1918 \u0433\u043E\u0434\u0443 \u0432\u044B\u0448\u043B\u0430
    \u0435\u0433\u043E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u0430\u044F
    \u043A\u043D\u0438\u0433\u0430 **\"\u041F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E,
    \u0432\u0440\u0435\u043C\u044F, \u043C\u0430\u0442\u0435\u0440\u0438\u044F\"**
    (Raum, Zeit, Materie), \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u0442\u0430\u043B\u0430
    \u043F\u0435\u0440\u0432\u044B\u043C \u0432\u0441\u0435\u043E\u0431\u044A\u0435\u043C\u043B\u044E\u0449\u0438\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C \u043E\u0431\u0449\u0435\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D\u0430. \u041D\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435,
    \u0412\u0435\u0439\u043B\u044C \u043F\u043E\u0448\u0435\u043B \u0434\u0430\u043B\u044C\u0448\u0435:
    \u043E\u043D \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044E \u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0435\u0442\u0438\u0437\u043C
    \u0432 \u0435\u0434\u0438\u043D\u043E\u0439 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438. \u041E\u043D \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u043B
    \u0440\u0438\u043C\u0430\u043D\u043E\u0432\u0443 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044E
    \u0438 \u0432\u0432\u0435\u043B \u043F\u043E\u043D\u044F\u0442\u0438\u0435 **\u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0439
    \u0438\u043D\u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043D\u043E\u0441\u0442\u0438**
    (gauge invariance), \u043A\u043E\u0442\u043E\u0440\u043E\u0435, \u0445\u043E\u0442\u044F
    \u0438 \u043D\u0435 \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u043A \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0435\u0434\u0438\u043D\u043E\u0439 \u0442\u0435\u043E\u0440\u0438\u0438, \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u0438 \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043B\u043E \u043A\u0440\u0430\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u043C
    \u043A\u0430\u043C\u043D\u0435\u043C \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u043F\u043E\u043B\u044F \u0438 \u0444\u0438\u0437\u0438\u043A\u0438
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u044B\u0445 \u0447\u0430\u0441\u0442\u0438\u0446
    (\u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0442\u0435\u043E\u0440\u0438\u044E
    \u042F\u043D\u0433\u0430-\u041C\u0438\u043B\u043B\u0441\u0430).  ### \U0001F9EE
    \u0422\u0435\u043E\u0440\u0438\u044F \u0433\u0440\u0443\u043F\u043F \u0438 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u0430\u044F
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430  \u0412 1920\u20131930-\u0445
    \u0433\u043E\u0434\u0430\u0445 \u0412\u0435\u0439\u043B\u044C \u0441\u043E\u0437\u0434\u0430\u043B
    \u043E\u0431\u0449\u0443\u044E \u0442\u0435\u043E\u0440\u0438\u044E \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0445
    \u0433\u0440\u0443\u043F\u043F (\u0433\u0440\u0443\u043F\u043F \u041B\u0438)
    \u0438 \u0438\u0445 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439.
    \u041E\u043D \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445
    \u043E\u0441\u043E\u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0438,
    \u0441\u043A\u0440\u044B\u0442\u044B\u0435 \u0432 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u043C
    \u043C\u0438\u0440\u0435, \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E
    \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043D\u0430
    \u044F\u0437\u044B\u043A\u0435 \u0442\u0435\u043E\u0440\u0438\u0438 \u0433\u0440\u0443\u043F\u043F.
    \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u044D\u0442\u043E\u0433\u043E
    \u043C\u043D\u043E\u0433\u043E\u043B\u0435\u0442\u043D\u0435\u0433\u043E \u0442\u0440\u0443\u0434\u0430
    \u0431\u044B\u043B\u0438 \u043E\u0431\u043E\u0431\u0449\u0435\u043D\u044B \u0432
    \u0435\u0433\u043E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0439
    \u043A\u043D\u0438\u0433\u0435 **\"\u0422\u0435\u043E\u0440\u0438\u044F \u0433\u0440\u0443\u043F\u043F
    \u0438 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u0430\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430\"**
    (1928), \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u043A\u0430\u0437\u0430\u043B\u0430
    \u043A\u043E\u043B\u043E\u0441\u0441\u0430\u043B\u044C\u043D\u043E\u0435 \u0432\u043B\u0438\u044F\u043D\u0438\u0435
    \u043D\u0430 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E-\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0444\u043E\u0440\u043C\u0430\u043B\u0438\u0437\u043C\u0430.  ### \U0001F4DA
    \u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0433\u0440\u0443\u043F\u043F\u044B 
    \u0415\u0433\u043E \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u0442\u0440\u0443\u0434 **\"\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0433\u0440\u0443\u043F\u043F\u044B, \u0438\u0445 \u0438\u043D\u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B
    \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F\"**
    (1939) \u043F\u043E\u0434\u0432\u0435\u043B \u0438\u0442\u043E\u0433 \u0435\u0433\u043E
    \u0440\u0430\u0431\u043E\u0442\u0435 \u0432 \u044D\u0442\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438,
    \u0441\u0442\u0430\u0432 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u043E\u0439
    \u043A\u043D\u0438\u0433\u043E\u0439 \u0434\u043B\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u043E\u0432
    \u043F\u043E \u0430\u043B\u0433\u0435\u0431\u0440\u0435 \u0438 \u0442\u0435\u043E\u0440\u0438\u0438
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439. 
    ### \U0001F4DD \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u043D\u0430\u0443\u0447\u043D\u044B\u0435
    \u0442\u0440\u0443\u0434\u044B  \u0412\u043E\u0442 \u0441\u043F\u0438\u0441\u043E\u043A
    \u0435\u0433\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u043C\u043E\u043D\u043E\u0433\u0440\u0430\u0444\u0438\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u0430\u043B\u0438 \u0432\u0435\u0445\u0430\u043C\u0438
    \u0432 \u043D\u0430\u0443\u043A\u0435:  *   **\"Die Idee der Riemannschen Fl\xE4che\"
    (1913)**: \u0421\u043E\u0437\u0434\u0430\u043B \u043D\u043E\u0432\u044B\u0439
    \u0432\u0437\u0433\u043B\u044F\u0434 \u043D\u0430 \u0440\u0438\u043C\u0430\u043D\u043E\u0432\u044B
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438, \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0432
    \u0442\u0435\u043E\u0440\u0438\u044E \u0444\u0443\u043D\u043A\u0446\u0438\u0439,
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044E \u0438 \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u044E.
    *   **\"Raum, Zeit, Materie\" (1918)**: \u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u0440\u0443\u0434 \u043F\u043E \u043E\u0431\u0449\u0435\u0439 \u0442\u0435\u043E\u0440\u0438\u0438
    \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0438 \u043F\u0435\u0440\u0432\u0430\u044F \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0435\u0434\u0438\u043D\u0430\u044F \u0442\u0435\u043E\u0440\u0438\u044F \u043F\u043E\u043B\u044F.
    *   **\"Das Kontinuum\" (1918)**: \u0420\u0430\u0431\u043E\u0442\u0430 \u043F\u043E
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u043D\u0430 \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043E\u0441\u043D\u043E\u0432\u0435, \u0431\u043B\u0438\u0437\u043A\u0430\u044F
    \u043A \u0438\u0434\u0435\u044F\u043C \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u043E\u043D\u0438\u0437\u043C\u0430.
    *   **\"Gruppentheorie und Quantenmechanik\" (1928)**: \u041A\u043D\u0438\u0433\u0430,
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0432\u0448\u0430\u044F \u0442\u0435\u043E\u0440\u0438\u044E
    \u0433\u0440\u0443\u043F\u043F \u0434\u043B\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438. *   **\"The Classical Groups\"
    (1939)**: \u0418\u0441\u0447\u0435\u0440\u043F\u044B\u0432\u0430\u044E\u0449\u0435\u0435
    \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0438\u043D\u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432 \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439
    \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0433\u0440\u0443\u043F\u043F.
    *   **\"Philosophy of Mathematics and Natural Science\" (1949)**: \u0413\u043B\u0443\u0431\u043E\u043A\u043E\u0435
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u043E\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u043E\u0437\u043D\u0430\u043D\u0438\u044F.
    *   **\"Symmetry\" (1952)**: \u0411\u043B\u0435\u0441\u0442\u044F\u0449\u0430\u044F
    \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
    \u0433\u0434\u0435 \u0412\u0435\u0439\u043B\u044C \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u0435\u0442
    \u043F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0438
    \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435, \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435
    \u0438 \u043F\u0440\u0438\u0440\u043E\u0434\u0435.  ### \U0001F48E \u0424\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u0438\u0439
    \u043C\u043E\u0441\u0442  \u0412\u0430\u0436\u043D\u043E \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C,
    \u0447\u0442\u043E \u0434\u043B\u044F \u0412\u0435\u0439\u043B\u044F \u0432\u0441\u0435
    \u044D\u0442\u0438 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u0431\u044B\u043B\u0438 \u043D\u0435\u043E\u0442\u0434\u0435\u043B\u0438\u043C\u044B
    \u043E\u0442 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438 \u0438 \u044D\u0441\u0442\u0435\u0442\u0438\u043A\u0438.
    \u041E\u043D \u0441\u0447\u0438\u0442\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u043E\u043C,
    \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0443.
    \u0415\u0433\u043E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0430\u044F
    \u0444\u0440\u0430\u0437\u0430: *\"\u041C\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0442\u0440\u0435\u043C\u0438\u043B\u0430\u0441\u044C
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u0438\u0441\u0442\u0438\u043D\u0443
    \u0441 \u043A\u0440\u0430\u0441\u043E\u0442\u043E\u0439, \u043D\u043E \u043A\u043E\u0433\u0434\u0430
    \u043C\u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043E\u0434\u043D\u043E \u0438\u0437
    \u0434\u0432\u0443\u0445, \u044F \u043E\u0431\u044B\u0447\u043D\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u043B
    \u043A\u0440\u0430\u0441\u043E\u0442\u0443\"*  \u2014 \u044D\u0442\u043E \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u0430\u0444\u043E\u0440\u0438\u0437\u043C,
    \u0430 \u043C\u0435\u0442\u043E\u0434\u043E\u043B\u043E\u0433\u0438\u044F, \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0432\u0448\u0430\u044F
    \u0435\u043C\u0443 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0433\u043B\u0443\u0431\u0438\u043D\u043D\u044B\u0435
    \u0441\u0432\u044F\u0437\u0438 \u0442\u0430\u043C, \u0433\u0434\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0432\u0438\u0434\u0435\u043B\u0438 \u043B\u0438\u0448\u044C \u0440\u0430\u0437\u0440\u043E\u0437\u043D\u0435\u043D\u043D\u044B\u0435
    \u0444\u0430\u043A\u0442\u044B."
  achievementsEn: 
  personalLifeRu: "\u0413\u0435\u0440\u043C\u0430\u043D \u0412\u0435\u0439\u043B\u044C
    \u0431\u044B\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
    \u043C\u044B\u0441\u043B\u0438 \u0438 \u0441\u043B\u043E\u0436\u043D\u043E\u0439
    \u0441\u0443\u0434\u044C\u0431\u044B, \u0438 \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u0430\u044F
    \u0436\u0438\u0437\u043D\u044C \u0442\u0430\u043A \u0436\u0435 \u0442\u0435\u0441\u043D\u043E
    \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0435\u043D\u0430 \u0441 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439,
    \u043A\u0430\u043A \u0438 \u0435\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u0435
    \u0442\u0440\u0443\u0434\u044B. \u0415\u0433\u043E \u043F\u0443\u0442\u044C \u043E\u0442\u043C\u0435\u0447\u0435\u043D
    \u0442\u0435\u0441\u043D\u044B\u043C\u0438 \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u0438\u043C\u0438
    \u0438 \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0441\u0432\u044F\u0437\u044F\u043C\u0438
    \u0441 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u043C\u0438 \u0443\u043C\u0430\u043C\u0438
    \u044D\u043F\u043E\u0445\u0438, \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438 \u043C\u0438\u0440\u043E\u0432\u044B\u0445
    \u0432\u043E\u0439\u043D \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
    \u043B\u0438\u0447\u043D\u043E\u0439 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0435\u0439. 
    ### \U0001F468\u200D\U0001F469\u200D\U0001F466 \u0421\u0435\u043C\u044C\u044F,
    \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0438 \u0440\u0430\u043D\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B  \u0413\u0435\u0440\u043C\u0430\u043D \u041A\u043B\u0430\u0443\u0441
    \u0413\u0443\u0433\u043E \u0412\u0435\u0439\u043B\u044C \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    **9 \u043D\u043E\u044F\u0431\u0440\u044F 1885 \u0433\u043E\u0434\u0430** \u0432
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u043A\u0435
    **\u042D\u043B\u044C\u043C\u0441\u0445\u043E\u0440\u043D** \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E
    \u043E\u0442 \u0413\u0430\u043C\u0431\u0443\u0440\u0433\u0430 \u0432 \u0441\u0435\u043C\u044C\u0435
    \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u0441\u043B\u0443\u0436\u0430\u0449\u0435\u0433\u043E
    \u041B\u044E\u0434\u0432\u0438\u0433\u0430 \u0412\u0435\u0439\u043B\u044F \u0438
    \u0410\u043D\u043D\u044B \u0412\u0435\u0439\u043B\u044C (\u0443\u0440\u043E\u0436\u0434\u0435\u043D\u043D\u043E\u0439
    \u0414\u0438\u043A), \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0432\u0448\u0435\u0439
    \u0438\u0437 \u0441\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u043C\u044C\u0438. \u0415\u0433\u043E \u044E\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u043E\u0448\u043B\u0430 \u0432 \u0410\u043B\u044C\u0442\u043E\u043D\u0435,
    \u0433\u0434\u0435 \u043E\u043D \u043F\u043E\u0441\u0435\u0449\u0430\u043B \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044E
    \u041A\u0440\u0438\u0441\u0442\u0438\u0430\u043D\u0438\u0443\u043C, \u043F\u0440\u043E\u044F\u0432\u0438\u0432
    \u0440\u0430\u043D\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435. 
    \u0412 1904 \u0433\u043E\u0434\u0443 \u0412\u0435\u0439\u043B\u044C \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0433\u0434\u0435
    \u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u043C
    \u0441\u0442\u0430\u043B \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0414\u0430\u0432\u0438\u0434
    \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442. \u041F\u043E\u0434 \u0435\u0433\u043E
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0412\u0435\u0439\u043B\u044C
    \u0437\u0430\u0449\u0438\u0442\u0438\u043B \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E \u0432 1908
    \u0433\u043E\u0434\u0443, \u0430 \u0437\u0430\u0442\u0435\u043C \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0435.  \u0412
    \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u0435 1913 \u0433\u043E\u0434\u0430
    \u043E\u043D \u0436\u0435\u043D\u0438\u043B\u0441\u044F \u043D\u0430 **\u0424\u0440\u0438\u0434\u0435\u0440\u0438\u043A\u0435
    \u0411\u0435\u0440\u0442\u0435 \u0425\u0435\u043B\u0435\u043D\u0435 \u0419\u043E\u0437\u0435\u0444**
    (\u043F\u043E \u043F\u0440\u043E\u0437\u0432\u0438\u0449\u0443 \"\u0425\u0435\u043B\u043B\u0430\").
    \u0425\u0435\u043B\u043B\u0430 \u0431\u044B\u043B\u0430 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u043E\u043C,
    \u0443\u0447\u0435\u043D\u0438\u0446\u0435\u0439 \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u043E\u043B\u043E\u0433\u0430
    \u042D\u0434\u043C\u0443\u043D\u0434\u0430 \u0413\u0443\u0441\u0441\u0435\u0440\u043B\u044F,
    \u0447\u0442\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043D\u0430 \u043C\u0438\u0440\u043E\u0432\u043E\u0437\u0437\u0440\u0435\u043D\u0438\u0435
    \u0412\u0435\u0439\u043B\u044F. \u0423 \u043D\u0438\u0445 \u0440\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u0434\u0432\u043E\u0435 \u0441\u044B\u043D\u043E\u0432\u0435\u0439: **\u0424\u0440\u0438\u0446
    \u0418\u043E\u0430\u0445\u0438\u043C** (1915) \u0438 **\u041C\u0438\u0445\u0430\u044D\u043B\u044C**
    (1917).  ### \U0001F468\u200D\U0001F52C \u041A\u0430\u0440\u044C\u0435\u0440\u0430,
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0438 \u0440\u0430\u0431\u043E\u0442\u0430
    \u0432 \u0426\u044E\u0440\u0438\u0445\u0435  \u0412 1913 \u0433\u043E\u0434\u0443
    \u0412\u0435\u0439\u043B\u044C \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0435\u0442
    \u0432 \u0426\u044E\u0440\u0438\u0445, \u043F\u043E\u043B\u0443\u0447\u0438\u0432
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0441\u043A\u0443\u044E
    \u043A\u0430\u0444\u0435\u0434\u0440\u0443 \u0432 **\u0426\u044E\u0440\u0438\u0445\u0441\u043A\u043E\u043C
    \u043F\u043E\u043B\u0438\u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C\u0435
    (ETH)**. \u042D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434 \u0441\u0442\u0430\u043B
    \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u043C \u0432 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438
    \u0438 \u043A\u0430\u0440\u044C\u0435\u0440\u0435. \u0417\u0434\u0435\u0441\u044C
    \u043E\u043D \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F
    \u0438 \u0442\u0435\u0441\u043D\u043E \u043E\u0431\u0449\u0430\u043B\u0441\u044F
    \u0441 **\u0410\u043B\u044C\u0431\u0435\u0440\u0442\u043E\u043C \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D\u043E\u043C**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0432\u043B\u0435\u043A \u0435\u0433\u043E
    \u0441\u0432\u043E\u0435\u0439 \u0442\u0435\u043E\u0440\u0438\u0435\u0439 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
    \u0412 \u0426\u044E\u0440\u0438\u0445\u0435 \u043E\u043D \u0442\u0430\u043A\u0436\u0435
    \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u043B\u0441\u044F \u0441 **\u042D\u0440\u0432\u0438\u043D\u043E\u043C
    \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440\u043E\u043C**, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0431\u044B\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    \u0426\u044E\u0440\u0438\u0445\u0441\u043A\u043E\u0433\u043E \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0418\u0445 \u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0440\u043E\u0441\u043B\u043E
    \u0432 \u0431\u043B\u0438\u0437\u043A\u0443\u044E \u0434\u0440\u0443\u0436\u0431\u0443,
    \u0445\u043E\u0442\u044F \u0438 \u043E\u0441\u043B\u043E\u0436\u043D\u044F\u043B\u0430\u0441\u044C
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u043C\u0438
    \u043B\u0438\u0447\u043D\u044B\u043C\u0438 \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C\u0438:
    \u0443 \u0412\u0435\u0439\u043B\u044F \u0431\u044B\u043B \u0440\u043E\u043C\u0430\u043D
    \u0441 \u0436\u0435\u043D\u043E\u0439 \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440\u0430
    \u0410\u043D\u043D\u0435\u043C\u0430\u0440\u0438, \u0447\u0442\u043E \u043D\u0435
    \u043F\u043E\u043C\u0435\u0448\u0430\u043B\u043E \u0438\u0445 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C\u0443
    \u0438 \u043B\u0438\u0447\u043D\u043E\u043C\u0443 \u043E\u0431\u0449\u0435\u043D\u0438\u044E. 
    ### \U0001F3AD \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D \u0438 \u044D\u043C\u0438\u0433\u0440\u0430\u0446\u0438\u044F 
    \u0412 1930 \u0433\u043E\u0434\u0443 \u0412\u0435\u0439\u043B\u044C \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D, \u0447\u0442\u043E\u0431\u044B
    \u0437\u0430\u043D\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043E \u0441\u0432\u043E\u0435\u0433\u043E
    \u0443\u0447\u0438\u0442\u0435\u043B\u044F **\u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0448\u0435\u043B \u043D\u0430
    \u043F\u0435\u043D\u0441\u0438\u044E. \u042D\u0442\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u0431\u044B\u043B\u043E \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0447\u0435\u0441\u0442\u044C\u044E.  \u041E\u0434\u043D\u0430\u043A\u043E \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0432 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438
    \u0431\u044B\u0441\u0442\u0440\u043E \u043C\u0435\u043D\u044F\u043B\u0430\u0441\u044C.
    \u0421 \u043F\u0440\u0438\u0445\u043E\u0434\u043E\u043C \u043D\u0430\u0446\u0438\u0441\u0442\u043E\u0432
    \u043A \u0432\u043B\u0430\u0441\u0442\u0438 \u0432 1933 \u0433\u043E\u0434\u0443,
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0412\u0435\u0439\u043B\u044F
    \u0438 \u0435\u0433\u043E \u0441\u0435\u043C\u044C\u0438 \u0441\u0442\u0430\u043B\u043E
    \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C. \u0415\u0433\u043E
    \u0436\u0435\u043D\u0430 \u0425\u0435\u043B\u043B\u0430 \u0431\u044B\u043B\u0430
    \u0435\u0432\u0440\u0435\u0439\u043A\u043E\u0439, \u0438 \u0438\u0445 \u0434\u0435\u0442\u0438
    \u0442\u0430\u043A\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u043B\u0438\u0441\u044C
    \u0435\u0432\u0440\u0435\u044F\u043C\u0438 \u043F\u043E \u043D\u0430\u0446\u0438\u0441\u0442\u0441\u043A\u0438\u043C
    \u0437\u0430\u043A\u043E\u043D\u0430\u043C. \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442
    \u0443\u0448\u0435\u043B, \u0438 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0442\u0435\u0440\u044F\u043B \u0441\u0432\u043E\u0438 \u043F\u043E\u0437\u0438\u0446\u0438\u0438,
    \u043C\u043D\u043E\u0433\u0438\u0435 \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0435\u0441\u044F
    \u0443\u0447\u0435\u043D\u044B\u0435 \u0431\u044B\u043B\u0438 \u0443\u0432\u043E\u043B\u0435\u043D\u044B. 
    \u041E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 (IAS)
    \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 **\u0410\u0432\u0440\u0430\u0430\u043C
    \u0424\u043B\u0435\u043A\u0441\u043D\u0435\u0440** \u0441\u0434\u0435\u043B\u0430\u043B
    \u0412\u0435\u0439\u043B\u044E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u043E \u0440\u0430\u0431\u043E\u0442\u0435 \u0435\u0449\u0435 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
    1932 \u0433\u043E\u0434\u0430. \u0412\u0435\u0439\u043B\u044C, \u043B\u044E\u0431\u0438\u0432\u0448\u0438\u0439
    \u0441\u0432\u043E\u044E \u0440\u043E\u0434\u0438\u043D\u0443, \u043A\u043E\u043B\u0435\u0431\u0430\u043B\u0441\u044F
    \u0438 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F.
    \u041E\u043D \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u043B\u0441\u044F:
    \"\u041A\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438
    \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 1932 \u0433\u043E\u0434\u0430, \u0441\u0443\u0434\u044C\u0431\u0430
    \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438 \u0432\u0441\u0435 \u0435\u0449\u0435
    \u0432\u0438\u0441\u0435\u043B\u0430 \u043D\u0430 \u0432\u043E\u043B\u043E\u0441\u043A\u0435\".
    \u041E\u0434\u043D\u0430\u043A\u043E \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u044E\u0449\u0435\u0433\u043E \u0443\u0436\u0430\u0441\u0430
    \u043E\u043D \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B, \u0438 \u0432
    \u043E\u043A\u0442\u044F\u0431\u0440\u0435 1933 \u0433\u043E\u0434\u0430 \u0412\u0435\u0439\u043B\u044C
    \u0441 \u0441\u0435\u043C\u044C\u0435\u0439 \u044D\u043C\u0438\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043B
    \u0432 \u0421\u0428\u0410 \u0438 \u0441\u0442\u0430\u043B \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u0432
    IAS \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435.  ### \U0001F1FA\U0001F1F8
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D, \u0432\u0442\u043E\u0440\u044B\u0435
    \u0431\u0440\u0430\u043A \u0438 \u0441\u043C\u0435\u0440\u0442\u044C  \u0412
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 \u0412\u0435\u0439\u043B\u044C
    \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0434\u043E \u0441\u0432\u043E\u0435\u0433\u043E
    \u0432\u044B\u0445\u043E\u0434\u0430 \u043D\u0430 \u043F\u0435\u043D\u0441\u0438\u044E
    \u0432 1951 \u0433\u043E\u0434\u0443. \u0415\u0433\u043E \u0436\u0435\u043D\u0430
    \u0425\u0435\u043B\u043B\u0430 \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0430\u0441\u044C
    \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 **5 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F
    1948 \u0433\u043E\u0434\u0430**. \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430
    \u0433\u043E\u0434\u0430, \u0432 1950 \u0433\u043E\u0434\u0443, \u043E\u043D
    \u0436\u0435\u043D\u0438\u043B\u0441\u044F \u043D\u0430 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u0435
    **\u042D\u043B\u043B\u0435\u043D \u0411\u044D\u0440** (\u0443\u0440\u043E\u0436\u0434\u0435\u043D\u043D\u0430\u044F
    \u041B\u043E\u043D\u0448\u0442\u0435\u0439\u043D) \u0438\u0437 \u0426\u044E\u0440\u0438\u0445\u0430. 
    \u0412\u044B\u0439\u0434\u044F \u043D\u0430 \u043F\u0435\u043D\u0441\u0438\u044E,
    \u0412\u0435\u0439\u043B\u044C \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u043B
    \u0441\u0432\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043C\u0435\u0436\u0434\u0443
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u043E\u043C \u0438 \u0426\u044E\u0440\u0438\u0445\u043E\u043C.
    \u0422\u0430\u043C, \u0432 \u0426\u044E\u0440\u0438\u0445\u0435, \u043E\u043D
    \u0441\u043A\u043E\u0440\u043E\u043F\u043E\u0441\u0442\u0438\u0436\u043D\u043E
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F \u043E\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0433\u043E
    \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430 **8 \u0434\u0435\u043A\u0430\u0431\u0440\u044F
    1955 \u0433\u043E\u0434\u0430** \u043D\u0430 71-\u043C \u0433\u043E\u0434\u0443
    \u0436\u0438\u0437\u043D\u0438. \u0415\u0433\u043E \u043F\u0440\u0430\u0445 \u0431\u044B\u043B
    \u043A\u0440\u0435\u043C\u0438\u0440\u043E\u0432\u0430\u043D \u0432 \u0426\u044E\u0440\u0438\u0445\u0435,
    \u0430 \u0441\u043F\u0443\u0441\u0442\u044F \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442,
    \u0432 1999 \u0433\u043E\u0434\u0443, \u0437\u0430\u0445\u043E\u0440\u043E\u043D\u0435\u043D
    \u0432 \u043A\u043E\u043B\u0443\u043C\u0431\u0430\u0440\u0438\u0438 \u043D\u0430
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0441\u043A\u043E\u043C \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435,
    \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0438\u043C \u043F\u043E\u0437\u0436\u0435
    \u0431\u044B\u043B \u0437\u0430\u0445\u043E\u0440\u043E\u043D\u0435\u043D \u0438
    \u0435\u0433\u043E \u0441\u044B\u043D \u041C\u0438\u0445\u0430\u044D\u043B\u044C. 
    ### \U0001F48E \u0412\u043B\u0438\u044F\u043D\u0438\u0435 \u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044F 
    \u0412\u0435\u0439\u043B\u044C \u0431\u044B\u043B \u043F\u0430\u043D\u0442\u0435\u0438\u0441\u0442\u043E\u043C,
    \u0447\u0435\u0440\u043F\u0430\u0432\u0448\u0438\u043C \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \u0432 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438. \u0412\u0441\u0435
    \u0435\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u0438\u044F
    \u0431\u044B\u043B\u0438 \u0442\u0435\u0441\u043D\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u044B
    \u0441 \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u044B\u043C\u0438 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u043C\u0438
    \u0441 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438, \u0442\u0430\u043A\u0438\u043C\u0438
    \u043A\u0430\u043A \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442, \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D
    \u0438 \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440, \u0430 \u0435\u0433\u043E
    \u0436\u0438\u0437\u043D\u044C \u0431\u044B\u043B\u0430 \u044F\u0440\u043A\u0438\u043C
    \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u043C \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
    \u043B\u0438\u0447\u043D\u044B\u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043D\u0438\u044F
    \u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u0430\u0442\u0430\u043A\u043B\u0438\u0437\u043C\u044B \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E\u0442
    \u0441\u0443\u0434\u044C\u0431\u0443 \u0443\u0447\u0435\u043D\u043E\u0433\u043E."
  personalLifeEn: 
  shortBioRu: "\u0413\u0435\u0440\u043C\u0430\u043D \u0412\u0435\u0439\u043B\u044C
    (1885\u20131955) \u2014 \u043E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432-\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u043E\u0432,
    \u0447\u044C\u0438 \u0440\u0430\u0431\u043E\u0442\u044B \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u043B\u0438
    \u0442\u0435\u043E\u0440\u0438\u044E \u0433\u0440\u0443\u043F\u043F, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044E, \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u0443\u044E
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0443, \u0442\u0435\u043E\u0440\u0438\u044E
    \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.
    \u0415\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
    \u0431\u044B\u043B \u0442\u0435\u0441\u043D\u043E \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0451\u043D
    \u0441 \u0431\u0443\u0440\u043D\u044B\u043C\u0438 \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438
    XX \u0432\u0435\u043A\u0430.  ### \U0001F9EC \u0420\u0430\u043D\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B \u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    (1885\u20131913)  \u0413\u0435\u0440\u043C\u0430\u043D \u041A\u043B\u0430\u0443\u0441
    \u0413\u0443\u0433\u043E \u0412\u0435\u0439\u043B\u044C \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    **9 \u043D\u043E\u044F\u0431\u0440\u044F 1885 \u0433\u043E\u0434\u0430** \u0432
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u043A\u0435
    **\u042D\u043B\u044C\u043C\u0441\u0445\u043E\u0440\u043D** \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E
    \u043E\u0442 \u0413\u0430\u043C\u0431\u0443\u0440\u0433\u0430, \u0432 \u0441\u0435\u043C\u044C\u0435
    \u0431\u0430\u043D\u043A\u0438\u0440\u0430 \u041B\u044E\u0434\u0432\u0438\u0433\u0430
    \u0412\u0435\u0439\u043B\u044F \u0438 \u0410\u043D\u043D\u044B \u0412\u0435\u0439\u043B\u044C
    (\u0443\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0439 \u0414\u0438\u043A).
    \u0415\u0433\u043E \u043F\u0443\u0442\u044C \u0432 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
    \u043D\u0430\u0443\u043A\u0443 \u043D\u0430\u0447\u0430\u043B\u0441\u044F \u0432
    1904 \u0433\u043E\u0434\u0443, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 **\u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442**, \u043E\u0434\u0438\u043D
    \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0446\u0435\u043D\u0442\u0440\u043E\u0432 \u043C\u0438\u0440\u0430.  \u0412
    \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0435 \u0412\u0435\u0439\u043B\u044C
    \u043F\u043E\u043F\u0430\u043B \u043F\u043E\u0434 \u0441\u0438\u043B\u044C\u043D\u043E\u0435
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E
    **\u0414\u0430\u0432\u0438\u0434\u0430 \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430**.
    \u0412\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C,
    \u0447\u0442\u043E \u0412\u0435\u0439\u043B\u044C, \u043F\u043E \u0435\u0433\u043E
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u044E,
    \u0440\u0435\u0448\u0438\u043B \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u0432\u0441\u0451,
    \u0447\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u0435\u0433\u043E
    \u043A\u0443\u043C\u0438\u0440. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0435\u0433\u043E \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043B \"Zahlbericht\"
    (\u043E\u0442\u0447\u0451\u0442 \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B), \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D
    \u043E\u0441\u0432\u043E\u0438\u043B \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043B\u0435\u0442\u043D\u0438\u0445
    \u043A\u0430\u043D\u0438\u043A\u0443\u043B, \u043D\u0430\u0437\u0432\u0430\u0432
    \u044D\u0442\u0438 \u043C\u0435\u0441\u044F\u0446\u044B \"\u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0435\u0439\u0448\u0438\u043C\u0438
    \u0432 \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438\". \u0412
    1908 \u0433\u043E\u0434\u0443 \u0412\u0435\u0439\u043B\u044C \u0437\u0430\u0449\u0438\u0442\u0438\u043B
    \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E
    \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430, \u043F\u043E\u0441\u0432\u044F\u0449\u0451\u043D\u043D\u0443\u044E
    \u0441\u0438\u043D\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u043C \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u044C\u043D\u044B\u043C
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F\u043C.  \u0412 1910 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u0438\u0432\u0430\u0442-\u0434\u043E\u0446\u0435\u043D\u0442\u0430
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0435, \u0430 \u0432
    1913 \u0433\u043E\u0434\u0443 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B
    \u0441\u0432\u043E\u044E \u043F\u0435\u0440\u0432\u0443\u044E \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0443\u044E
    \u043A\u043D\u0438\u0433\u0443 **\"\u041A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u044F
    \u0440\u0438\u043C\u0430\u043D\u043E\u0432\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438\"**
    (Die Idee der Riemannschen Fl\xE4che). \u0412 \u044D\u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435
    \u043E\u043D \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B
    \u0442\u0435\u043E\u0440\u0438\u044E \u0444\u0443\u043D\u043A\u0446\u0438\u0439,
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044E \u0438 \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u044E,
    \u0441\u043E\u0437\u0434\u0430\u0432 \u043F\u0435\u0440\u0432\u043E\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0435
    \u0438 \u0441\u0442\u0440\u043E\u0433\u043E\u0435 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0430\u0431\u0441\u0442\u0440\u0430\u043A\u0442\u043D\u043E\u0433\u043E \u043C\u043D\u043E\u0433\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u044F. 
    ### \U0001F3D4\uFE0F \u0426\u044E\u0440\u0438\u0445\u0441\u043A\u0438\u0439 \u043F\u0435\u0440\u0438\u043E\u0434:
    \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u0438 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0438\u0434\u0435\u0438 (1913\u20131930)  \u0412 1913 \u0433\u043E\u0434\u0443
    \u0412\u0435\u0439\u043B\u044C \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u0442\u044C
    \u043A\u0430\u0444\u0435\u0434\u0440\u0443 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0432 **\u0426\u044E\u0440\u0438\u0445\u0441\u043A\u043E\u043C \u043F\u043E\u043B\u0438\u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C\u0435
    (ETH)**. \u042D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434 \u0441\u0442\u0430\u043B
    \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
    \u043F\u043B\u043E\u0434\u043E\u0442\u0432\u043E\u0440\u043D\u044B\u043C.  *  
    **\u0421\u0435\u043C\u044C\u044F:** \u0412 1913 \u0433\u043E\u0434\u0443 \u043E\u043D
    \u0436\u0435\u043D\u0438\u0442\u0441\u044F \u043D\u0430 **\u0425\u0435\u043B\u0435\u043D\u0435
    (\u0425\u0435\u043B\u043B\u0435) \u0419\u043E\u0437\u0435\u0444**, \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0435
    \u0438 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u0446\u0435, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0431\u044B\u043B\u0430 \u0443\u0447\u0435\u043D\u0438\u0446\u0435\u0439 \u042D\u0434\u043C\u0443\u043D\u0434\u0430
    \u0413\u0443\u0441\u0441\u0435\u0440\u043B\u044F. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0436\u0435\u043D\u0435 \u0412\u0435\u0439\u043B\u044C \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F
    \u0441 \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u043E\u043B\u043E\u0433\u0438\u0435\u0439,
    \u0447\u0442\u043E \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u043B\u0438\u044F\u043B\u043E
    \u043D\u0430 \u0435\u0433\u043E \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u0438\u0435
    \u0432\u0437\u0433\u043B\u044F\u0434\u044B. \u0423 \u043D\u0438\u0445 \u0440\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u0434\u0432\u043E\u0435 \u0441\u044B\u043D\u043E\u0432\u0435\u0439: \u0424\u0440\u0438\u0446
    \u0418\u043E\u0430\u0445\u0438\u043C (1915) \u0438 \u041C\u0438\u0445\u0430\u044D\u043B\u044C
    (1917). *   **\u0424\u0438\u0437\u0438\u043A\u0430 \u0438 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F:**
    \u0412 \u0426\u044E\u0440\u0438\u0445\u0435 \u0412\u0435\u0439\u043B\u044C \u0431\u044B\u043B
    \u043A\u043E\u043B\u043B\u0435\u0433\u043E\u0439 **\u0410\u043B\u044C\u0431\u0435\u0440\u0442\u0430
    \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D\u0430**, \u0447\u0442\u043E
    \u043F\u043E\u0434\u043E\u0433\u0440\u0435\u043B\u043E \u0435\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441
    \u043A \u0444\u0438\u0437\u0438\u043A\u0435. \u0412 1918 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0435\u0442 \u0441\u0432\u043E\u0439
    magnum opus **\"\u041F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
    \u2014 \u0432\u0440\u0435\u043C\u044F \u2014 \u043C\u0430\u0442\u0435\u0440\u0438\u044F\"**
    (Raum, Zeit, Materie). \u0412 \u044D\u0442\u043E\u0439 \u043A\u043D\u0438\u0433\u0435
    \u043E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043F\u0435\u0440\u0432\u0443\u044E
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0435\u0434\u0438\u043D\u0443\u044E \u0442\u0435\u043E\u0440\u0438\u044E \u043F\u043E\u043B\u044F,
    \u043F\u043E\u043F\u044B\u0442\u0430\u0432\u0448\u0438\u0441\u044C \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044E \u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0435\u0442\u0438\u0437\u043C.
    \u0421\u0430\u043C\u044B\u043C \u0432\u0430\u0436\u043D\u044B\u043C \u0438 \u043D\u043E\u0432\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u043C
    \u0432 \u044D\u0442\u043E\u0439 \u0442\u0435\u043E\u0440\u0438\u0438 \u0431\u044B\u043B\u043E
    \u0432\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u043F\u043E\u043D\u044F\u0442\u0438\u044F
    **\u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0439
    \u0438\u043D\u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043D\u043E\u0441\u0442\u0438**
    (gauge invariance). \u0418\u0434\u0435\u044F \u0431\u044B\u043B\u0430 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    (\u0445\u043E\u0442\u044F \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0439
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0442\u0435\u043E\u0440\u0438\u0438
    \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u043C),
    \u0438 \u043F\u043E\u0437\u0436\u0435 \u043E\u043D\u0430 \u0441\u0442\u0430\u043B\u0430
    \u043A\u0440\u0430\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C
    \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u0442\u0435\u043E\u0440\u0438\u0438
    \u043F\u043E\u043B\u044F \u0438 \u0444\u0438\u0437\u0438\u043A\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u044B\u0445
    \u0447\u0430\u0441\u0442\u0438\u0446. *   **\u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438:** \u0412 \u0442\u043E\u043C
    \u0436\u0435 1918 \u0433\u043E\u0434\u0443 \u0432\u044B\u0448\u043B\u0430 \u0435\u0433\u043E
    \u0440\u0430\u0431\u043E\u0442\u0430 **\"\u041A\u043E\u043D\u0442\u0438\u043D\u0443\u0443\u043C\"**
    (Das Kontinuum), \u043F\u043E\u0441\u0432\u044F\u0449\u0451\u043D\u043D\u0430\u044F
    \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0443
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430. \u0412\u0435\u0439\u043B\u044C \u0431\u044B\u043B
    \u0431\u043B\u0438\u0437\u043E\u043A \u043A \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u043E\u043D\u0438\u0437\u043C\u0443
    \u041B\u0435\u0439\u0442\u0437\u0435\u043D\u0430 \u0411\u0440\u0430\u0443\u044D\u0440\u0430
    \u0438 \u0441\u0442\u0440\u0435\u043C\u0438\u043B\u0441\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u0430\u043D\u0430\u043B\u0438\u0437 \u043D\u0430 \u0431\u043E\u043B\u0435\u0435
    \u0441\u0442\u0440\u043E\u0433\u043E\u0439, \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0439
    \u043E\u0441\u043D\u043E\u0432\u0435. *   **\u0422\u0435\u043E\u0440\u0438\u044F
    \u0433\u0440\u0443\u043F\u043F \u0438 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u0430\u044F
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430:** \u0421 1923 \u043F\u043E
    1938 \u0433\u043E\u0434 \u0412\u0435\u0439\u043B\u044C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043B
    \u043E\u0431\u0449\u0443\u044E \u0442\u0435\u043E\u0440\u0438\u044E \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0445
    \u0433\u0440\u0443\u043F\u043F \u0438 \u0438\u0445 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439.
    \u041E\u043D \u043F\u0435\u0440\u0432\u044B\u043C \u043E\u0441\u043E\u0437\u043D\u0430\u043B,
    \u0447\u0442\u043E \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0438 \u0432
    \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0435,
    \u0442\u0430\u043A\u0438\u0435 \u043A\u0430\u043A \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435,
    \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0442\u0435\u043E\u0440\u0438\u0438
    \u0433\u0440\u0443\u043F\u043F. \u042D\u0442\u0438 \u0438\u0434\u0435\u0438 \u043B\u0435\u0433\u043B\u0438
    \u0432 \u043E\u0441\u043D\u043E\u0432\u0443 \u0435\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043A\u043D\u0438\u0433\u0438 **\"\u0422\u0435\u043E\u0440\u0438\u044F \u0433\u0440\u0443\u043F\u043F
    \u0438 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u0430\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430\"**
    (1928), \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u0442\u0430\u043B\u0430
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u043E\u0439 \u0434\u043B\u044F
    \u0444\u0438\u0437\u0438\u043A\u043E\u0432-\u0442\u0435\u043E\u0440\u0435\u0442\u0438\u043A\u043E\u0432. 
    ### \U0001F534 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D, \u044D\u043C\u0438\u0433\u0440\u0430\u0446\u0438\u044F
    \u0438 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D (1930\u20131955)  \u0412
    1930 \u0433\u043E\u0434\u0443 \u0412\u0435\u0439\u043B\u044C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D, \u0447\u0442\u043E\u0431\u044B
    \u0437\u0430\u043D\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043E \u0441\u0432\u043E\u0435\u0433\u043E
    \u0443\u0447\u0438\u0442\u0435\u043B\u044F \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0435\u0433\u043E \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u0435
    \u043D\u0430 \u0440\u043E\u0434\u0438\u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0435\u0434\u043E\u043B\u0433\u0438\u043C. 
    *   **\u0411\u0435\u0433\u0441\u0442\u0432\u043E \u043E\u0442 \u043D\u0430\u0446\u0438\u0437\u043C\u0430:**
    \u0421 \u043F\u0440\u0438\u0445\u043E\u0434\u043E\u043C \u043D\u0430\u0446\u0438\u0441\u0442\u043E\u0432
    \u043A \u0432\u043B\u0430\u0441\u0442\u0438 \u0432 1933 \u0433\u043E\u0434\u0443
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F \u0432 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438
    \u0441\u0442\u0430\u043B\u0430 \u043E\u043F\u0430\u0441\u043D\u043E\u0439. \u0416\u0435\u043D\u0430
    \u0412\u0435\u0439\u043B\u044F, \u0425\u0435\u043B\u043B\u0430, \u0431\u044B\u043B\u0430
    \u0435\u0432\u0440\u0435\u0439\u043A\u043E\u0439, \u0438 \u0438\u0445 \u0434\u0435\u0442\u0438
    \u0442\u0430\u043A\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u043B\u0438\u0441\u044C
    \u0435\u0432\u0440\u0435\u044F\u043C\u0438 \u043F\u043E \u0437\u0430\u043A\u043E\u043D\u0430\u043C
    \u0422\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u0440\u0435\u0439\u0445\u0430.
    \u0412\u0435\u0439\u043B\u044C \u0431\u044B\u043B \u0433\u043B\u0443\u0431\u043E\u043A\u043E
    \u0432\u043E\u0437\u043C\u0443\u0449\u0451\u043D \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u043E\u0439
    \u0440\u0435\u0436\u0438\u043C\u0430. \u0412 \u0442\u043E\u043C \u0436\u0435
    \u0433\u043E\u0434\u0443 \u043E\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 **\u0410\u0432\u0440\u0430\u0430\u043C\u0430
    \u0424\u043B\u0435\u043A\u0441\u043D\u0435\u0440\u0430** \u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u0432 \u043D\u0435\u0434\u0430\u0432\u043D\u043E
    \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u043E\u0433\u043E **\u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439** \u0432
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435, \u0433\u0434\u0435 \u0443\u0436\u0435
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D.
    *   **\u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0441\u043A\u0438\u0435
    \u0433\u043E\u0434\u044B:** \u0412 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u0412\u0435\u0439\u043B\u044C \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0434\u043E 1951 \u0433\u043E\u0434\u0430. \u0417\u0434\u0435\u0441\u044C \u043E\u043D
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443
    \u043D\u0430\u0434 \u0442\u0435\u043E\u0440\u0438\u0435\u0439 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0433\u0440\u0443\u043F\u043F, \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0432
    \u0432 1939 \u0433\u043E\u0434\u0443 \u043A\u043D\u0438\u0433\u0443 **\"\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0433\u0440\u0443\u043F\u043F\u044B, \u0438\u0445 \u0438\u043D\u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B
    \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F\"**.
    \u0415\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B
    \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u043B\u0438
    \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u0441\u043F\u0435\u043A\u0442\u0440:
    \u043E\u0442 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0434\u043E \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B. *   **\u041B\u0438\u0447\u043D\u0430\u044F
    \u0436\u0438\u0437\u043D\u044C:** \u0412 1948 \u0433\u043E\u0434\u0443 \u0435\u0433\u043E
    \u0436\u0435\u043D\u0430 \u0425\u0435\u043B\u043B\u0430 \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0430\u0441\u044C.
    \u0412 1950 \u0433\u043E\u0434\u0443 \u0412\u0435\u0439\u043B\u044C \u0436\u0435\u043D\u0438\u043B\u0441\u044F
    \u043D\u0430 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u0435 **\u042D\u043B\u043B\u0435\u043D
    \u0411\u044D\u0440** \u0438\u0437 \u0426\u044E\u0440\u0438\u0445\u0430.  \u0412\u044B\u0439\u0434\u044F
    \u043D\u0430 \u043F\u0435\u043D\u0441\u0438\u044E \u0432 1951 \u0433\u043E\u0434\u0443,
    \u0412\u0435\u0439\u043B\u044C \u0434\u0435\u043B\u0438\u043B \u0432\u0440\u0435\u043C\u044F
    \u043C\u0435\u0436\u0434\u0443 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u043E\u043C
    \u0438 \u0426\u044E\u0440\u0438\u0445\u043E\u043C. \u0412 1952 \u0433\u043E\u0434\u0443
    \u0432\u044B\u0448\u043B\u0430 \u0435\u0433\u043E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0430\u044F
    \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430\u044F \u0448\u0438\u0440\u043E\u043A\u043E\u0439
    \u043F\u0443\u0431\u043B\u0438\u043A\u0435 \u043A\u043D\u0438\u0433\u0430 **\"\u0421\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u044F\"**,
    \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u043D \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
    \u043F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u044D\u0442\u043E\u0433\u043E
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435,
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435 \u0438 \u043F\u0440\u0438\u0440\u043E\u0434\u0435.
    \u0413\u0435\u0440\u043C\u0430\u043D \u0412\u0435\u0439\u043B\u044C \u0441\u043A\u043E\u0440\u043E\u043F\u043E\u0441\u0442\u0438\u0436\u043D\u043E
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F \u043E\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0433\u043E
    \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430 **8 \u0434\u0435\u043A\u0430\u0431\u0440\u044F
    1955 \u0433\u043E\u0434\u0430** \u0432 \u0426\u044E\u0440\u0438\u0445\u0435.
    \u0412\u0441\u0435\u043C\u0438\u0440\u043D\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u0444\u0438\u0437\u0438\u043A **\u0424\u0440\u0438\u043C\u0435\u043D \u0414\u0430\u0439\u0441\u043E\u043D**
    \u043F\u043E\u0437\u0436\u0435 \u043D\u0430\u0437\u0432\u0430\u043B \u0435\u0433\u043E
    \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C
    XX \u0432\u0435\u043A\u0430, \u043A\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u043E
    \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0432 \u043E\u0434\u0438\u043D \u0440\u044F\u0434 \u0441 \u041F\u0443\u0430\u043D\u043A\u0430\u0440\u0435
    \u0438 \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u043E\u043C.  ### \U0001F9E0
    \u0424\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u0438\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u044B
    \u0438 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C  \u0412\u0435\u0439\u043B\u044C
    \u0431\u044B\u043B \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C,
    \u043D\u043E \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u043E\u043C.
    \u0415\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u044B \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u0438
    \u043E\u0442 \u043A\u0430\u043D\u0442\u0438\u0430\u043D\u0441\u0442\u0432\u0430
    \u043F\u043E\u0434 \u0432\u043B\u0438\u044F\u043D\u0438\u0435\u043C \u0430\u043A\u0441\u0438\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u0435\u0442\u043E\u0434\u0430 \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430
    \u043A \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u043E\u043B\u043E\u0433\u0438\u0438
    \u0413\u0443\u0441\u0441\u0435\u0440\u043B\u044F, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u043A \u043C\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443
    \u0438\u0434\u0435\u0430\u043B\u0438\u0437\u043C\u0443 \u0424\u0438\u0445\u0442\u0435.
    \u041E\u043D \u0431\u044B\u043B \u0443\u0431\u0435\u0436\u0434\u0451\u043D, \u0447\u0442\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430 \u2014 \u044D\u0442\u043E
    \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u0430\u044F \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0434\u0443\u0445\u0430, \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0443 \u0438 \u043C\u0443\u0437\u044B\u043A\u0435. 
    \u0415\u0433\u043E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0430\u044F
    \u0444\u0440\u0430\u0437\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043A\u0430\u043A
    \u043D\u0435\u043B\u044C\u0437\u044F \u043B\u0443\u0447\u0448\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442
    \u0435\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434 \u043A \u043D\u0430\u0443\u043A\u0435:
    > *\"\u041C\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0441\u0442\u0440\u0435\u043C\u0438\u043B\u0430\u0441\u044C \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C
    \u0438\u0441\u0442\u0438\u043D\u0443 \u0441 \u043A\u0440\u0430\u0441\u043E\u0442\u043E\u0439,
    \u043D\u043E \u043A\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043E\u0434\u043D\u043E \u0438\u0437
    \u0434\u0432\u0443\u0445, \u044F \u043E\u0431\u044B\u0447\u043D\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u043B
    \u043A\u0440\u0430\u0441\u043E\u0442\u0443\"*."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043D\u044C \u0413\u0435\u0440\u043C\u0430\u043D\u0430
    \u0412\u0435\u0439\u043B\u044F \u0431\u044B\u043B\u0430 \u043F\u043E\u043B\u043D\u0430
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445
    \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u043E\u0437\u0430\u0440\u0435\u043D\u0438\u0439,
    \u043D\u043E \u0438 \u044F\u0440\u043A\u0438\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u043E\u0432, \u0437\u0430\u0431\u0430\u0432\u043D\u044B\u0445
    \u0441\u043B\u0443\u0447\u0430\u0435\u0432 \u0438 \u043F\u0430\u0440\u0430\u0434\u043E\u043A\u0441\u043E\u0432.
    \u0417\u0430 \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u0441\u0442\u0440\u043E\u0433\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430 \u0441\u043A\u0440\u044B\u0432\u0430\u043B\u0441\u044F
    \u0438\u0440\u043E\u043D\u0438\u0447\u043D\u044B\u0439 \u0444\u0438\u043B\u043E\u0441\u043E\u0444,
    \u0441\u0442\u0440\u0430\u0441\u0442\u043D\u044B\u0439 \u043F\u043E\u043A\u043B\u043E\u043D\u043D\u0438\u043A
    \u043F\u0440\u0438\u0440\u043E\u0434\u044B \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
    \u043D\u0435 \u0447\u0443\u0436\u0434\u044B\u0439 \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439.  \u0412\u043E\u0442
    \u0441\u0430\u043C\u044B\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0438 \u043A\u0443\u0440\u044C\u0435\u0437\u043D\u044B\u0435 \u0444\u0430\u043A\u0442\u044B
    \u0438\u0437 \u0435\u0433\u043E \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445: 
    ### 1. \U0001F48D \u041B\u044E\u0431\u043E\u0432\u043D\u044B\u0439 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A
    \u0441 \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440\u043E\u043C \u041F\u043E\u0436\u0430\u043B\u0443\u0439,
    \u0441\u0430\u043C\u044B\u0439 \u043F\u0438\u043A\u0430\u043D\u0442\u043D\u044B\u0439
    \u0441\u044E\u0436\u0435\u0442 \u0432 \u0436\u0438\u0437\u043D\u0438 \u0412\u0435\u0439\u043B\u044F
    \u0441\u0432\u044F\u0437\u0430\u043D \u0441 \u0435\u0433\u043E \u0434\u0440\u0443\u0433\u043E\u043C
    \u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u043E\u0439 \u2014 \u0444\u0438\u0437\u0438\u043A\u043E\u043C
    \u042D\u0440\u0432\u0438\u043D\u043E\u043C \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440\u043E\u043C.
    \u041A\u043E\u0433\u0434\u0430 \u0412\u0435\u0439\u043B\u044C \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B
    \u0432 \u0426\u044E\u0440\u0438\u0445\u0435, \u043E\u043D \u0442\u0435\u0441\u043D\u043E
    \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u043B\u0441\u044F \u0441\u043E \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440\u043E\u043C.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0438\u0445 \u0434\u0440\u0443\u0436\u0431\u0430
    \u0431\u044B\u043B\u0430 \u043E\u0441\u043B\u043E\u0436\u043D\u0435\u043D\u0430
    \u0442\u0435\u043C, \u0447\u0442\u043E \u0443 \u0412\u0435\u0439\u043B\u044F
    \u0437\u0430\u0432\u044F\u0437\u0430\u043B\u0441\u044F \u0440\u043E\u043C\u0430\u043D
    \u0441 \u0436\u0435\u043D\u043E\u0439 \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440\u0430
    \u2014 **\u0410\u043D\u043D\u0435\u043C\u0430\u0440\u0438**.  \u0421\u0430\u043C\u043E\u0435
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435, \u0447\u0442\u043E
    \u044D\u0442\u0430 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F \u043D\u0435
    \u043F\u0440\u0438\u0432\u0435\u043B\u0430 \u043A \u0440\u0430\u0437\u0440\u044B\u0432\u0443:
    \u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440 \u0431\u044B\u043B \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
    \u043B\u043E\u0432\u0435\u043B\u0430\u0441\u043E\u043C, \u0438, \u043F\u043E-\u0432\u0438\u0434\u0438\u043C\u043E\u043C\u0443,
    \u0432\u0441\u0435 \u0442\u0440\u043E\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0435
    \u0438 \u0434\u0430\u0436\u0435 \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u0438\u0435
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F. \u041F\u043E\u0437\u0436\u0435
    \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u0438 \u043D\u0430\u0443\u043A\u0438
    \u043E\u0442\u043C\u0435\u0447\u0430\u043B\u0438, \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E
    \u0432 \u044D\u0442\u043E \u0431\u0443\u0440\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043E\u0431\u0430 \u0443\u0447\u0435\u043D\u044B\u0445 \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B\u0438
    \u0441\u0432\u043E\u0438 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0435
    \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438
    \u0438 \u0442\u0435\u043E\u0440\u0438\u0438 \u0433\u0440\u0443\u043F\u043F. \u0426\u044E\u0440\u0438\u0445
    \u0432 1920-\u0445 \u0433\u043E\u0434\u0430\u0445 \u0441\u0442\u0430\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C
    \"\u043F\u043E\u043B\u0435\u043C \u0431\u0438\u0442\u0432\u044B\" \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u043E\u0432
    \u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u0435\u0439.  ### 2. \U0001F45E \u041A\u043D\u0443\u0442,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u043D\u0435 \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0443 \u0412\u0435\u0439\u043B\u044C
    \u0431\u044B\u043B \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u043A\u043E\u043C,
    \u043D\u043E \u0438 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u043E\u043C, \u043E\u0431\u043E\u0436\u0430\u0432\u0448\u0438\u043C
    \u0433\u043E\u0440\u043D\u044B\u0435 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438.
    \u041E\u0434\u043D\u0430\u0436\u0434\u044B, \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u043E\u0442\u043F\u0443\u0441\u043A\u0430 \u0432 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0438\u0445
    \u0410\u043B\u044C\u043F\u0430\u0445, \u043E\u043D \u0440\u0435\u0448\u0438\u043B
    \u043A\u0443\u043F\u0438\u0442\u044C \u0441\u0435\u0431\u0435 \u0430\u043B\u044C\u043F\u0435\u043D\u0448\u0442\u043E\u043A
    (\u0434\u043B\u0438\u043D\u043D\u0443\u044E \u0433\u043E\u0440\u043D\u0443\u044E
    \u043F\u0430\u043B\u043A\u0443) \u0438 \u043A\u043D\u0443\u0442. \u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0432
    \u0442\u043E\u0432\u0430\u0440 \u0432 \u043C\u0435\u0441\u0442\u043D\u043E\u0439
    \u043B\u0430\u0432\u043A\u0435, \u0412\u0435\u0439\u043B\u044C \u0441 \u043F\u0440\u0438\u0441\u0443\u0449\u0435\u0439
    \u0435\u043C\u0443 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0434\u043E\u0442\u043E\u0448\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0435\u0448\u0438\u043B
    \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E
    \u043A\u043D\u0443\u0442\u0430: \u043E\u043D \u0445\u043B\u0435\u0441\u0442\u043D\u0443\u043B
    \u0438\u043C \u043F\u043E \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0443, \u0447\u0442\u043E\u0431\u044B
    \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0437\u0432\u043E\u043D\u043A\u0438\u0439
    \u0449\u0435\u043B\u0447\u043E\u043A. \u0429\u0435\u043B\u0447\u043E\u043A \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0441\u044F
    \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C,
    \u043D\u043E \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
    \u0437\u0432\u043E\u043D \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0433\u043E
    \u0441\u0442\u0435\u043A\u043B\u0430 \u2014 \u043E\u043D \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
    \u0437\u0430\u0434\u0435\u043B \u0432\u0438\u0442\u0440\u0438\u043D\u0443. \u0421\u043A\u043E\u043D\u0444\u0443\u0436\u0435\u043D\u043D\u044B\u0439
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D
    \u0431\u044B\u043B \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
    \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0435 \u0441\u0442\u0435\u043A\u043B\u043E,
    \u043D\u043E \u043A\u043D\u0443\u0442 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
    \u043A\u0443\u043F\u0438\u043B \u0438 \u043F\u043E\u0442\u043E\u043C \u0441 \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C\u044E
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u044D\u0442\u0443
    \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u043A\u0430\u043A \u043F\u0440\u0438\u043C\u0435\u0440
    \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043F\u0430\u0441\u0430\u0435\u0442
    \u043E\u0442 \u0444\u0438\u0437\u0438\u043A\u0438.  ### 3. \U0001F3A8 \u0421\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u044F
    \u0438 \"\u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\" \u0415\u0433\u043E
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0430\u044F \u043A\u043D\u0438\u0433\u0430
    \"\u0421\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u044F\" \u0432\u044B\u0440\u043E\u0441\u043B\u0430
    \u0438\u0437 \u043B\u0435\u043A\u0446\u0438\u0439, \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u0445
    \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439. \u0412\u0435\u0439\u043B\u044C
    \u0431\u044B\u043B \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0443\u0431\u0435\u0436\u0434\u0435\u043D,
    \u0447\u0442\u043E \u043A\u0440\u0430\u0441\u043E\u0442\u0430 \u2014 \u044D\u0442\u043E
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u043F\u043E\u0437\u043D\u0430\u043D\u0438\u044F.
    \u041E\u043D \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B, \u0447\u0442\u043E
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
    \u043A\u0440\u0430\u0441\u043E\u0442\u0443, \u0435\u0441\u043B\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043C\u0435\u0436\u0434\u0443
    \u043A\u0440\u0430\u0441\u043E\u0442\u043E\u0439 \u0438 \u0438\u0441\u0442\u0438\u043D\u043E\u0439.
    \u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043E\u043D \u0437\u0430\u043C\u0435\u0442\u0438\u043B,
    \u0447\u0442\u043E \u043C\u043D\u043E\u0433\u0438\u0435 \u0435\u0433\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0438\u0434\u0435\u0438 \u0440\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u043D\u0435
    \u0438\u0437 \u0441\u0443\u0445\u0438\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043E\u0432,
    \u0430 \u0438\u0437 \u044D\u0441\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u044F \u043E\u0442
    \u0438\u0437\u044F\u0449\u0435\u0441\u0442\u0432\u0430 \u0444\u043E\u0440\u043C\u0443\u043B.
    \u041E\u043D \u043E\u0431\u043E\u0436\u0430\u043B \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0435
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E \u0438 \u0447\u0430\u0441\u0442\u043E
    \u043F\u043E\u0441\u0435\u0449\u0430\u043B \u043C\u0443\u0437\u0435\u0439 \u041C\u0435\u0442\u0440\u043E\u043F\u043E\u043B\u0438\u0442\u0435\u043D
    \u0432 \u041D\u044C\u044E-\u0419\u043E\u0440\u043A\u0435, \u0447\u0442\u043E\u0431\u044B
    \u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u043D\u0430\u0431\u0440\u043E\u0441\u043A\u0438
    \u0430\u0440\u0430\u0431\u0435\u0441\u043E\u043A \u0438 \u043E\u0440\u043D\u0430\u043C\u0435\u043D\u0442\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435, \u043A\u0430\u043A \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B,
    \"\u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438 \u0435\u043C\u0443
    \u043E \u0433\u0440\u0443\u043F\u043F\u0430\u0445 \u0431\u043E\u043B\u044C\u0448\u0435,
    \u0447\u0435\u043C \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438\".  ### 4.
    \u2712\uFE0F \u0418\u0440\u043E\u043D\u0438\u044F \u0441\u0443\u0434\u044C\u0431\u044B
    \u0441 \"\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0433\u0440\u0443\u043F\u043F\u0430\u043C\u0438\" \u041A\u043E\u0433\u0434\u0430
    \u0412\u0435\u0439\u043B\u044C \u043F\u0438\u0441\u0430\u043B \u0441\u0432\u043E\u0439
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u0442\u0440\u0443\u0434 \"\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0433\u0440\u0443\u043F\u043F\u044B\", \u043E\u043D \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u043A\u043D\u0438\u0433\u0443 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
    \u0441\u0436\u0430\u0442\u043E\u0439 \u0438 \u0441\u0442\u0440\u043E\u0433\u043E\u0439.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435
    \u0440\u0430\u0431\u043E\u0442\u044B \u043E\u043D \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u0443\u0432\u043B\u0435\u043A\u0441\u044F \u043F\u0440\u0438\u043C\u0435\u0440\u0430\u043C\u0438
    \u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u044D\u043A\u0441\u043A\u0443\u0440\u0441\u0430\u043C\u0438, \u0447\u0442\u043E
    \u043E\u0431\u044A\u0435\u043C \u0442\u0435\u043A\u0441\u0442\u0430 \u0432\u044B\u0440\u043E\u0441
    \u0432 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u043F\u0440\u043E\u0442\u0438\u0432
    \u0437\u0430\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E.
    \u0418\u0437\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E \u0431\u044B\u043B\u043E
    \u0432 \u0448\u043E\u043A\u0435, \u043D\u043E \u0412\u0435\u0439\u043B\u044C
    \u043D\u0430\u0441\u0442\u043E\u044F\u043B \u043D\u0430 \u0441\u0432\u043E\u0435\u043C,
    \u0441\u043A\u0430\u0437\u0430\u0432, \u0447\u0442\u043E \"\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u0431\u0435\u0437 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u043F\u043E\u0434\u043E\u0431\u043D\u0430
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u0431\u0435\u0437 \u043F\u0430\u043C\u044F\u0442\u0438\".
    \u0412 \u0438\u0442\u043E\u0433\u0435 \u044D\u0442\u0430 \u043A\u043D\u0438\u0433\u0430,
    \u0432\u043E\u043F\u0440\u0435\u043A\u0438 \u043E\u043F\u0430\u0441\u0435\u043D\u0438\u044F\u043C
    \u0438\u0437\u0434\u0430\u0442\u0435\u043B\u0435\u0439, \u0441\u0442\u0430\u043B\u0430
    \u0431\u0435\u0441\u0442\u0441\u0435\u043B\u043B\u0435\u0440\u043E\u043C \u0441\u0440\u0435\u0434\u0438
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 \u0438 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0430
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u043F\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u043D\u0438\u0439. 
    ### 5. \U0001F1FA\U0001F1F8 \u041A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F
    \u043F\u0435\u0440\u0435\u0434 \u043E\u0442\u044A\u0435\u0437\u0434\u043E\u043C
    \u0432 \u0421\u0428\u0410 \u0412 1932 \u0433\u043E\u0434\u0443 \u0412\u0435\u0439\u043B\u044E
    \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438
    \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u0442\u044C \u0432 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0447\u0442\u043E \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435.
    \u041E\u043D \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F, \u043D\u0430\u043F\u0438\u0441\u0430\u0432,
    \u0447\u0442\u043E \"\u0413\u0435\u0440\u043C\u0430\u043D\u0438\u044F \u2014
    \u0435\u0433\u043E \u0434\u0443\u0445\u043E\u0432\u043D\u0430\u044F \u0440\u043E\u0434\u0438\u043D\u0430,
    \u0438 \u043E\u043D \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u0440\u043E\u0441\u0438\u0442\u044C
    \u0435\u0435 \u0432 \u0442\u0440\u0443\u0434\u043D\u044B\u0439 \u0447\u0430\u0441\".
    \u041E\u0434\u043D\u0430\u043A\u043E \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437
    \u0433\u043E\u0434, \u043A\u043E\u0433\u0434\u0430 \u043A \u0432\u043B\u0430\u0441\u0442\u0438
    \u043F\u0440\u0438\u0448\u043B\u0438 \u043D\u0430\u0446\u0438\u0441\u0442\u044B,
    \u043E\u043D \u0441 \u0433\u043E\u0440\u0435\u0447\u044C\u044E \u043F\u0440\u0438\u0437\u043D\u0430\u043B
    \u0441\u0432\u043E\u044E \u043E\u0448\u0438\u0431\u043A\u0443. \u0412 \u043F\u0438\u0441\u044C\u043C\u0435
    \u0434\u0440\u0443\u0433\u0443 \u043E\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B:
    \"\u042F \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0441\u043F\u0430\u0441\u0443
    \u0447\u0435\u0441\u0442\u044C \u043D\u0430\u0443\u043A\u0438 \u0432 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438,
    \u043D\u043E \u043D\u0430\u0443\u043A\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
    \u0431\u0435\u0441\u0441\u0438\u043B\u044C\u043D\u0430 \u043F\u0435\u0440\u0435\u0434
    \u0437\u043B\u043E\u043C. \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u0431\u0435\u0433\u0443
    \u043D\u0435 \u043E\u0442 \u043D\u0435\u043C\u0446\u0435\u0432, \u0430 \u043E\u0442
    \u0438\u0445 \u0431\u0435\u0437\u0443\u043C\u0438\u044F\". \u042D\u0442\u043E\u0442
    \u043E\u0442\u044A\u0435\u0437\u0434 \u0441\u043F\u0430\u0441 \u0435\u043C\u0443
    \u0436\u0438\u0437\u043D\u044C \u2014 \u043C\u043D\u043E\u0433\u0438\u0435 \u0435\u0433\u043E
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438, \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043D\u0433\u0435\u043D\u0435, \u043F\u043E\u0433\u0438\u0431\u043B\u0438
    \u0432 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u043B\u0430\u0433\u0435\u0440\u044F\u0445.  ### 6. \U0001F3D4\uFE0F \u0421\u0442\u0440\u0430\u0441\u0442\u044C
    \u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u0432 \u043F\u043E\u043B\u0435\u0442\u0435
    \u0412\u0435\u0439\u043B\u044C \u043E\u0431\u043E\u0436\u0430\u043B \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u043D\u0430 \u043F\u0430\u0440\u043E\u0445\u043E\u0434\u0430\u0445 \u0438 \u043F\u043E\u0435\u0437\u0434\u0430\u0445.
    \u0415\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u0433\u0438 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0438,
    \u0447\u0442\u043E \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0442\u0440\u0430\u043D\u0441\u0430\u0442\u043B\u0430\u043D\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u0432 \u0438\u0437 \u0415\u0432\u0440\u043E\u043F\u044B
    \u0432 \u0410\u043C\u0435\u0440\u0438\u043A\u0443 \u043E\u043D \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u0441\u0438\u0434\u0435\u043B \u0432 \u043A\u0430\u044E\u0442\u0435
    \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C. \u041E\u043D \u0432\u044B\u0445\u043E\u0434\u0438\u043B
    \u043D\u0430 \u043F\u0430\u043B\u0443\u0431\u0443, \u0441\u0430\u0434\u0438\u043B\u0441\u044F
    \u0432 \u0448\u0435\u0437\u043B\u043E\u043D\u0433, \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u043B
    \u043D\u043E\u0433\u0438 \u043F\u043B\u0435\u0434\u043E\u043C \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u043B
    \u043F\u0438\u0441\u0430\u0442\u044C \u043F\u0440\u044F\u043C\u043E \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435,
    \u0433\u043B\u044F\u0434\u044F \u043D\u0430 \u043E\u043A\u0435\u0430\u043D. \u041D\u0430
    \u0432\u043E\u043F\u0440\u043E\u0441, \u0437\u0430\u0447\u0435\u043C \u043E\u043D
    \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442, \u0412\u0435\u0439\u043B\u044C
    \u043E\u0442\u0432\u0435\u0447\u0430\u043B: \"\u0412\u043E\u043B\u043D\u044B
    \u0438 \u0432\u0435\u0442\u0435\u0440 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
    \u043C\u043D\u0435 \u043E \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F\u0445, \u043E\u043D\u0438
    \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u044E\u0442 \u0443\u043C
    \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0432\u0438\u0434\u0435\u0442\u044C
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u043E\u0431\u044A\u0435\u043C\u043D\u043E\".
    \u041C\u043D\u043E\u0433\u0438\u0435 \u0435\u0433\u043E \u0438\u0434\u0435\u0438
    \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438 \u0433\u0440\u0443\u043F\u043F
    \u0431\u044B\u043B\u0438 \u0440\u043E\u0436\u0434\u0435\u043D\u044B \u0438\u043C\u0435\u043D\u043D\u043E
    \u0432 \u0442\u0430\u043A\u0438\u0445 \u043C\u043E\u0440\u0441\u043A\u0438\u0445
    \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F\u0445.  ###
    7. \U0001F52C \u041E\u0442\u043A\u0430\u0437 \u043E\u0442 \u044D\u0432\u0442\u0430\u043D\u0430\u0437\u0438\u0438
    \u0411\u0443\u0434\u0443\u0447\u0438 \u0442\u044F\u0436\u0435\u043B\u043E \u0431\u043E\u043B\u044C\u043D\u044B\u043C
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u0436\u0438\u0437\u043D\u0438, \u0412\u0435\u0439\u043B\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B
    \u044F\u0441\u043D\u043E\u0441\u0442\u044C \u0443\u043C\u0430 \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E
    \u043A\u043E\u043D\u0446\u0430. \u041E\u043D \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
    \u0443 \u043D\u0435\u0433\u043E \u0441\u043B\u0430\u0431\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435,
    \u0438 \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u0432 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0435
    \u0441 \u0432\u0440\u0430\u0447\u043E\u043C \u043F\u043E\u0448\u0443\u0442\u0438\u043B:
    \"\u0415\u0441\u043B\u0438 \u043C\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F, \u043D\u0435
    \u043F\u044B\u0442\u0430\u0439\u0442\u0435\u0441\u044C \u0435\u0433\u043E \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C.
    \u0423 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u0430 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0430\u044F
    \u0436\u0438\u0437\u043D\u044C, \u0438 \u044F \u043D\u0435 \u0445\u043E\u0447\u0443,
    \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u043D\u044F \u043D\u0430\u0441\u0438\u043B\u044C\u043D\u043E
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438 \u0432 \u044D\u0442\u043E\u0442
    \u043C\u0438\u0440 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
    \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C, \u043A\u0430\u043A
    \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0442\u0435\u043E\u0440\u0435\u043C\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u044F \u0443\u0436\u0435 \u043F\u043E\u043D\u044F\u043B\".
    \u042D\u0442\u0430 \u0438\u0440\u043E\u043D\u0438\u0447\u043D\u0430\u044F \u0444\u0440\u0430\u0437\u0430
    \u0441\u0442\u0430\u043B\u0430 \u0441\u0432\u043E\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C
    \u0437\u0430\u0432\u0435\u0449\u0430\u043D\u0438\u0435\u043C \u2014 \u043E\u043D
    \u0443\u043C\u0435\u0440 \u043E\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0433\u043E
    \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E,
    \u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E, \u043A\u0430\u043A
    \u0438 \u0445\u043E\u0442\u0435\u043B.  ### 8. \U0001F4D5 \u0421\u0435\u043A\u0440\u0435\u0442
    \"\u041A\u0440\u0430\u0441\u0438\u0432\u043E\u0433\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\"
    \u041E\u0434\u043D\u0430\u0436\u0434\u044B \u0435\u0433\u043E \u0441\u0442\u0443\u0434\u0435\u043D\u0442
    \u0441\u043F\u0440\u043E\u0441\u0438\u043B, \u043A\u0430\u043A \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C
    \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043E\u0442 \u043F\u043B\u043E\u0445\u043E\u0433\u043E. \u0412\u0435\u0439\u043B\u044C
    \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F \u043D\u0430 \u043C\u0438\u043D\u0443\u0442\u0443
    \u0438 \u043E\u0442\u0432\u0435\u0442\u0438\u043B: \"\u0415\u0441\u043B\u0438
    \u0432\u044B \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B\u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E,
    \u0438 \u0443 \u0432\u0430\u0441 \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u043E
    \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435, \u0447\u0442\u043E \u0430\u0432\u0442\u043E\u0440
    \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0438\u043B
    \u0441\u043B\u043E\u0432\u0430 \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
    \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u2014 \u044D\u0442\u043E \u043F\u043B\u043E\u0445\u043E\u0435
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.
    \u0415\u0441\u043B\u0438 \u0436\u0435 \u0432\u044B \u0434\u043E\u0447\u0438\u0442\u0430\u043B\u0438
    \u0438 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438,
    \u0447\u0442\u043E \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u044C
    \u044D\u0442\u043E \u0441\u0430\u043C\u0438, \u0442\u043E\u043B\u044C\u043A\u043E
    \u0443 \u0432\u0430\u0441 \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E
    \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u0438 \u2014 \u044D\u0442\u043E \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\".
    \u0421\u0430\u043C \u0412\u0435\u0439\u043B\u044C \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F
    \u043F\u0438\u0441\u0430\u0442\u044C \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A,
    \u0447\u0442\u043E\u0431\u044B \u043A\u0430\u0436\u0434\u044B\u0439 \u0435\u0433\u043E
    \u0432\u044B\u0432\u043E\u0434 \u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044E
    \"\u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u043C \u0438 \u043D\u0435\u0438\u0437\u0431\u0435\u0436\u043D\u044B\u043C\",
    \u0445\u043E\u0442\u044F \u0437\u0430 \u044D\u0442\u0438\u043C \u0441\u0442\u043E\u044F\u043B\u0438
    \u0433\u043E\u0434\u044B \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0435\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B."
