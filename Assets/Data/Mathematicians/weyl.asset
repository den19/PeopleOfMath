    \u0433\u0440\u0443\u043f\u043f. \u0426\u044e\u0440\u0438\u0445 \u0432 1920-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u0441\u0442\u0430\u043b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \"\u043f\u043e\u043b\u0435\u043c
    \u0431\u0438\u0442\u0432\u044b\" \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u043e\u0432
    \u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u0435\u0439. 2.\n\n\U0001F45E \u041a\u043d\u0443\u0442,
