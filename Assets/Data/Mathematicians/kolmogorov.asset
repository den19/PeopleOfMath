  achievementsRu: "\u0410\u043d\u0434\u0440\u0435\u0439 \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u043e \u0441\u0432\u043e\u0435\u043c\u0443 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443
    \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u0441\u0440\u0430\u0432\u043d\u0438\u043c\u043e
    \u0441 \u0442\u0440\u0443\u0434\u0430\u043c\u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u0430,
    \u042d\u0439\u043b\u0435\u0440\u0430 \u0438\u043b\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e \u2014 \u043e\u043d
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439,
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443, \u043b\u043e\u0433\u0438\u043a\u0443 \u0438
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b,
    \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u0432
    \u043d\u043e\u0432\u044b\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u043d\u0430\u0443\u043a\u0438.\n\n\U0001F3B2
    \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439:
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430 \u0413\u043b\u0430\u0432\u043d\u044b\u043c
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u043f\u043e\u0434\u0432\u0438\u0433\u043e\u043c
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0412 1933 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430 \u0435\u0433\u043e \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u00ab\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0430
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.
    \u0414\u043e \u044d\u0442\u043e\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0431\u044b\u043b\u0430 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435\u043c \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0445
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432. \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0436\u0435, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432 \u043c\u043e\u0449\u043d\u044b\u0439
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0435\u0440\u044b,
    \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0435\u0451 \u043a\u0430\u043a \u0441\u0442\u0440\u043e\u0433\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443
    \u043d\u0430\u0440\u0430\u0432\u043d\u0435 \u0441 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439
    \u0438\u043b\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u043e\u0439. \u042d\u0442\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0447\u0430\u0441\u0442\u043e \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u043a\u0430\u043a \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0448\u0435\u0441\u0442\u043e\u0439
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u043a\u0430\u0441\u0430\u044e\u0449\u0435\u0439\u0441\u044f \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d.
    \u0421\u0443\u0442\u044c \u0435\u0433\u043e \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0438
    \u043f\u0440\u043e\u0441\u0442\u0430 \u0438 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u0430.
    \u041e\u043d \u0432\u0432\u0435\u043b \u0431\u0430\u0437\u043e\u0432\u0443\u044e \u0442\u0440\u043e\u0439\u043a\u0443
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432: \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0445 \u0441\u043e\u0431\u044b\u0442\u0438\u0439
    (\u03a9): \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0432\u0441\u0435\u0445
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u0438\u0441\u0445\u043e\u0434\u043e\u0432
    \u043e\u043f\u044b\u0442\u0430. \u0421\u0438\u0433\u043c\u0430-\u0430\u043b\u0433\u0435\u0431\u0440\u0430
    \u0441\u043e\u0431\u044b\u0442\u0438\u0439 (F): \u0441\u0438\u0441\u0442\u0435\u043c\u0430
    \u0432\u0441\u0435\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u044e\u0449\u0438\u0445
    \u043d\u0430\u0441 \u043f\u043e\u0434\u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u03a9
    (\u0441\u043e\u0431\u044b\u0442\u0438\u0439), \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043a\u0430\u043a
    \u0441 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430\u043c\u0438. \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u0430\u044f
    \u043c\u0435\u0440\u0430 (P): \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0441\u043e\u0431\u044b\u0442\u0438\u044e \u0438\u0437
    F \u0441\u0442\u0430\u0432\u0438\u0442 \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435
    \u0447\u0438\u0441\u043b\u043e \u043e\u0442 0 \u0434\u043e 1, \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u044e\u0449\u0435\u0435
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u043c. \u042d\u0442\u0430 \u0441\u0445\u0435\u043c\u0430,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043a\u0430\u043a \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u043e\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e `(\u03a9, F, P)`,
    \u0441\u0442\u0430\u043b\u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c
    \u044f\u0437\u044b\u043a\u043e\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u041d\u043e \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b\u0441\u044f
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u043e\u0439. \u041e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0430\u0440\u043a\u043e\u0432\u0441\u043a\u0438\u0445
    \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432
    \u0441 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c.
    \u0412 \u0440\u0430\u0431\u043e\u0442\u0435 1931 \u0433\u043e\u0434\u0430 \u043e\u043d \u0432\u044b\u0432\u0435\u043b
    \u043f\u0440\u044f\u043c\u044b\u0435 \u0438 \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f (\u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430\u2013\u0424\u043e\u043a\u043a\u0435\u0440\u0430\u2013\u041f\u043b\u0430\u043d\u043a\u0430),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0432 \u0442\u0430\u043a\u0438\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430\u0445,
    \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0432 \u0438\u0434\u0435\u0438 \u0438\u0437 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0442\u0435\u043f\u043b\u043e\u0442\u044b, \u0431\u0440\u043e\u0443\u043d\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0445
    \u0431\u043b\u0443\u0436\u0434\u0430\u043d\u0438\u0439. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u043e\u0439
    \u0434\u043b\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.\n\n\U0001F30C
    \u041a\u0410\u041c-\u0442\u0435\u043e\u0440\u0438\u044f: \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0432 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435
    \u0412\u0442\u043e\u0440\u044b\u043c, \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u043c
    \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u043c \u0441\u0442\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u043a\u0430\u043a \u041a\u0410\u041c-\u0442\u0435\u043e\u0440\u0438\u044f (\u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u2013\u0410\u0440\u043d\u043e\u043b\u044c\u0434\u2013\u041c\u043e\u0437\u0435\u0440).
    \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u0421\u043e\u043b\u043d\u0435\u0447\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u043c\u0443\u0447\u0438\u043b\u0430 \u0443\u0447\u0435\u043d\u044b\u0445 \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430. \u041c\u043e\u0436\u043d\u043e \u043b\u0438
    \u0431\u044b\u0442\u044c \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c, \u0447\u0442\u043e
    \u043f\u043b\u0430\u043d\u0435\u0442\u044b \u043d\u0435 \u0443\u043f\u0430\u0434\u0443\u0442
    \u043d\u0430 \u0421\u043e\u043b\u043d\u0446\u0435 \u0438\u043b\u0438 \u043d\u0435 \u0431\u0443\u0434\u0443\u0442
    \u0432\u044b\u0431\u0440\u043e\u0448\u0435\u043d\u044b \u0432 \u043a\u043e\u0441\u043c\u043e\u0441
    \u0447\u0435\u0440\u0435\u0437 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u044b \u043b\u0435\u0442?
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u044d\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0441\u043b\u043e\u0436\u043d\u0430. \u0412 1954 \u0433\u043e\u0434\u0443 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432. \u041e\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u0434\u043b\u044f
    \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0441\u043b\u043e\u0432\u0438\u0439 (\u0432 \u0441\u043c\u044b\u0441\u043b\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0435\u0440\u044b) \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438
    \u0441\u0438\u0441\u0442\u0435\u043c, \u0431\u043b\u0438\u0437\u043a\u0438\u0445 \u043a
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0435\u043c\u044b\u043c (\u0442.\u0435.
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0435\u0448\u0430\u0435\u043c\u044b\u043c),
    \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u043c\u0438
    \u0438 \u043d\u0435 \u043f\u043e\u043a\u0438\u0434\u0430\u044e\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u0444\u0430\u0437\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u0430\u043b\u0430 \u043d\u0430\u0434\u0435\u0436\u0434\u0443
    \u043d\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u00ab\u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438\u00bb,
    \u043a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0435\u0451 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u0437\u0436\u0435
    \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u0412.\u0418. \u0410\u0440\u043d\u043e\u043b\u044c\u0434\u043e\u043c \u0438 \u042e. \u041c\u043e\u0437\u0435\u0440\u043e\u043c,
    \u0438 \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u043e\u0441\u0438\u0442 \u0438\u0445
    \u043e\u0431\u0449\u0438\u0435 \u0438\u043c\u0435\u043d\u0430.\n\n\U0001F30A \u0422\u0435\u043e\u0440\u0438\u044f
    \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438: \u0437\u0430\u043a\u043e\u043d
    \u00ab\u0434\u0432\u0435 \u043f\u044f\u0442\u044b\u0445\u00bb \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0442\u0430\u043a\u0436\u0435 \u0432\u043d\u0435\u0441 \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0444\u0438\u0437\u0438\u043a\u0443, \u0441\u043e\u0437\u0434\u0430\u0432
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438. \u0412
    1941 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b
    \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0433\u043e \u043f\u043e\u0442\u043e\u043a\u0430.
    \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0437\u0430\u043a\u043e\u043d
    \u00ab4/5\u00bb (\u0438\u043b\u0438 \u00ab\u0434\u0432\u0435 \u043f\u044f\u0442\u044b\u0445\u00bb)
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u0434\u043b\u044f
    \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u043e\u0433\u043e
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438
    \u0432 \u0438\u0437\u043e\u0442\u0440\u043e\u043f\u043d\u043e\u0439 \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u044f
    \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u043c\u0430\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e
    \u0434\u0438\u0441\u0441\u0438\u043f\u0430\u0446\u0438\u0438 \u044d\u043d\u0435\u0440\u0433\u0438\u0438.
    \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u0438 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0439
    \u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u043c\u043d\u043e\u0433\u0438\u0445
    \u043c\u043e\u0434\u0435\u043b\u0435\u0439.\n\n\U0001F9E0 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043b\u043e\u0433\u0438\u043a\u0430, \u0442\u0435\u043e\u0440\u0438\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b \u041a\u0440\u0443\u0433 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u0438\u0440\u0430\u043b\u0441\u044f
    \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043b\u043e\u0433\u0438\u043a\u0430: \u0415\u0449\u0451 \u0432 1925 \u0433\u043e\u0434\u0443,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c,
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0443,
    \u0433\u0434\u0435 \u0434\u0430\u043b \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u0441\u043a\u0443\u044e
    \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u043e\u0434\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044e
    \u043a \u0434\u0440\u0443\u0433\u043e\u0439, \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u0432
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0413\u0451\u0434\u0435\u043b\u044f. \u041f\u043e\u0437\u0436\u0435 \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044e \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u043a\u0430\u043a \u00ab\u043b\u043e\u0433\u0438\u043a\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447\u00bb, \u0432\u0432\u0435\u0434\u044f
    \u0432 \u0434\u0438\u0441\u043a\u0443\u0440\u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    (\u0437\u0430\u0434\u0430\u0447\u0438). \u0422\u0435\u043e\u0440\u0438\u044f \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438:
    \u0412 1960-\u0445 \u0433\u043e\u0434\u0430\u0445 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438,
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u0432 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e
    \u043e\u0431\u044a\u0435\u043a\u0442\u0430 (\u043a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0441\u043a\u0430\u044f
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c). \u042d\u0442\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0435
    \u0434\u043b\u044f \u0435\u0433\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f (\u0442.\u0435.
    \u0434\u043b\u0438\u043d\u0430 \u043a\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0435\u0439
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043c\u043e\u0436\u0435\u0442 \u044d\u0442\u043e\u0442 \u043e\u0431\u044a\u0435\u043a\u0442
    \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438). \u042d\u0442\u0430
    \u0442\u0435\u043e\u0440\u0438\u044f \u043d\u0430\u0448\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445
    \u2014 \u043e\u0442 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u0434\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438. \u0422\u0435\u043e\u0440\u0438\u044f
    \u043d\u0443\u043c\u0435\u0440\u0430\u0446\u0438\u0439: \u0412 1954 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u043d\u0443\u043c\u0435\u0440\u0430\u0446\u0438\u0439,
