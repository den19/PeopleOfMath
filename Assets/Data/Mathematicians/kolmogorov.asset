    \u0438 \u0434\u0435\u0432\u043e\u0447\u0435\u043a. \u0422\u0430\u043c \u043e\u043d \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u043d\u0435\u0434\u044e\u0436\u0438\u043d\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438:
    \"\u0443\u0447\u0438\u0442\u0435\u043b\u044f \u043d\u0435 \u0443\u0441\u043f\u0435\u0432\u0430\u043b\u0438
    \u0435\u0433\u043e \u0443\u0447\u0438\u0442\u044c\", \u0430 \u0432\u044b\u0441\u0448\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u043f\u043e \u0441\u0442\u0430\u0442\u044c\u044f\u043c \u0438\u0437 \u00ab\u042d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043b\u043e\u0432\u0430\u0440\u044f \u0411\u0440\u043e\u043a\u0433\u0430\u0443\u0437\u0430
    \u0438 \u0415\u0444\u0440\u043e\u043d\u0430\u00bb. \u0412 17 \u043b\u0435\u0442 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0443\u0436\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u0443\u044e
    \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0443\u044e
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0430\u043d\u0430\u043b\u0438\u0437\u0443 \u043d\u043e\u0432\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0433\u043e
    \u0437\u0435\u043c\u043b\u0435\u0432\u043b\u0430\u0434\u0435\u043d\u0438\u044f. \u0412 1920
    \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u043d\u0430 \u0434\u0432\u0430 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f:
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u2014
    \u0432 \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0438 \u043c\u0435\u0442\u0430\u043b\u043b\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u2014 \u0432 \u0425\u0438\u043c\u0438\u043a\u043e-\u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0438\u043c. \u041c\u0435\u043d\u0434\u0435\u043b\u0435\u0435\u0432\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u0447\u0435\u043d\u044c \u0441\u043a\u043e\u0440\u043e
    \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0432\u044b\u0431\u043e\u0440 \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u041c\u0413\u0423,
    \u0438 \u0443\u0436\u0435 \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u043c\u0435\u0441\u044f\u0446
    \u0441\u0434\u0430\u043b \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u044b \u0437\u0430 \u0432\u0435\u0441\u044c
    \u043f\u0435\u0440\u0432\u044b\u0439 \u043a\u0443\u0440\u0441, \u043f\u0435\u0440\u0435\u0439\u0434\u044f
    \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u0439. \u0417\u0430 \u0443\u0441\u043f\u0435\u0445\u0438
    \u0432 \u0443\u0447\u0435\u0431\u0435 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u0430\u0432\u043e \u043d\u0430 16 \u043a\u0433 \u0445\u043b\u0435\u0431\u0430
    \u0438 1 \u043a\u0433 \u043c\u0430\u0441\u043b\u0430 \u0432 \u043c\u0435\u0441\u044f\u0446
    \u2014 \u043f\u043e \u0442\u0435\u043c \u0433\u043e\u043b\u043e\u0434\u043d\u044b\u043c
    \u0432\u0440\u0435\u043c\u0435\u043d\u0430\u043c \u044d\u0442\u043e \u0431\u044b\u043b\u043e
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u0438\u0435\u043c.\n\n\U0001F468\u200d\U0001F3EB
    \u041f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0435 \u0438 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0438
    \u041d\u0430 \u0432\u0442\u043e\u0440\u043e\u043c \u043a\u0443\u0440\u0441\u0435 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u044f\u0440\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u041d\u0438\u043a\u043e\u043b\u0430\u044f
    \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447\u0430 \u041b\u0443\u0437\u0438\u043d\u0430.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f: \u043d\u0430 \u043b\u0435\u043a\u0446\u0438\u0438
    \u041b\u0443\u0437\u0438\u043d \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043b \u043d\u0435\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c
    \u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435,
    \u0438 \u043f\u0435\u0440\u0432\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u043f\u043e\u0434\u043d\u044f\u043b \u0440\u0443\u043a\u0443 \u0438 \u0437\u0430\u044f\u0432\u0438\u043b:
    \"\u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u044d\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435
    \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e\". \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0435\u0433\u043e \u043d\u0430 \u0441\u0432\u043e\u0439 \u0441\u0435\u043c\u0438\u043d\u0430\u0440.
    \u0412 1922 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    19 \u043b\u0435\u0442, \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0441\u0432\u043e\u0435 \u043f\u0435\u0440\u0432\u043e\u0435 \u043c\u0438\u0440\u043e\u0432\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435, \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0432
    \u043f\u0440\u0438\u043c\u0435\u0440 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0435\u043c\u043e\u0439
    \u043f\u043e \u041b\u0435\u0431\u0435\u0433\u0443 \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u0440\u044f\u0434 \u0424\u0443\u0440\u044c\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0440\u0430\u0441\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e\u0447\u0442\u0438
    \u0432\u0441\u044e\u0434\u0443. \u042d\u0442\u043e \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e
    \u0435\u043c\u0443 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0443\u044e
    \u0441\u043b\u0430\u0432\u0443. \u041e\u043a\u043e\u043d\u0447\u0438\u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0432 1925 \u0433\u043e\u0434\u0443, \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443
    \u043a \u041b\u0443\u0437\u0438\u043d\u0443. \u041d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u043d \u0443\u0441\u043f\u0435\u0448\u043d\u043e
    \u0441\u043e\u0447\u0435\u0442\u0430\u043b \u0441 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u0441 1922 \u043f\u043e 1925 \u0433\u043e\u0434
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0438 \u0432 \u041f\u043e\u0442\u044b\u043b\u0438\u0445\u0438\u043d\u0441\u043a\u043e\u0439
    \u043e\u043f\u044b\u0442\u043d\u043e-\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435, \u0447\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0435\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u043d\u0430
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.\n\n\U0001F30D \u0421\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0412 1929 \u0433\u043e\u0434\u0443 \u0432 \u0436\u0438\u0437\u043d\u0438 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0432\u0430\u0436\u043d\u043e\u0435
    \u0441\u043e\u0431\u044b\u0442\u0438\u0435, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432\u0448\u0435\u0435
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0435 \u0441\u0447\u0430\u0441\u0442\u044c\u0435
    \u043d\u0430 \u043f\u043e\u043b\u0432\u0435\u043a\u0430. \u041e\u043d \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043b
    \u043b\u043e\u0434\u043e\u0447\u043d\u043e\u0435 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u043f\u043e \u0412\u043e\u043b\u0433\u0435 \u0438 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0432 \u043f\u043e\u043f\u0443\u0442\u0447\u0438\u043a\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u041f\u0430\u0432\u043b\u0430 \u0421\u0435\u0440\u0433\u0435\u0435\u0432\u0438\u0447\u0430
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u0430. \u0421 \u044d\u0442\u043e\u0439
    \u043f\u043e\u0435\u0437\u0434\u043a\u0438 \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c
    \u0438\u0445 \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u0430\u044f \u0438 \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0434\u0440\u0443\u0436\u0431\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0441\u0430\u043c
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \"\u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u043f\u0440\u0435\u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0441\u0447\u0430\u0441\u0442\u044c\u044f\".
    \u0412 1930\u20131931 \u0433\u043e\u0434\u0430\u0445 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e
    \u0437\u0430\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u0443\u044e \u043f\u043e\u0435\u0437\u0434\u043a\u0443,
    \u043f\u043e\u0441\u0435\u0442\u0438\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0446\u0435\u043d\u0442\u0440\u044b \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435,
    \u041c\u044e\u043d\u0445\u0435\u043d\u0435 \u0438 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u0433\u0434\u0435 \u043e\u0431\u0449\u0430\u043b\u0441\u044f \u0441 \u0414\u0430\u0432\u0438\u0434\u043e\u043c
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c, \u0420\u0438\u0445\u0430\u0440\u0434\u043e\u043c
    \u041a\u0443\u0440\u0430\u043d\u0442\u043e\u043c, \u041c\u043e\u0440\u0438\u0441\u043e\u043c
    \u0424\u0440\u0435\u0448\u0435 \u0438 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0441\u0432\u0435\u0442\u0438\u043b\u0430\u043c\u0438
    \u043d\u0430\u0443\u043a\u0438. \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c,
    \u043e\u043d \u0443\u0436\u0435 \u0432 28 \u043b\u0435\u0442 \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041c\u0413\u0423, \u0430 \u0432 1935 \u0433\u043e\u0434\u0443 \u2014 \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u043c
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0432 \u0421\u0421\u0421\u0420 \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0412 1939 \u0433\u043e\u0434\u0443, \u0432 35 \u043b\u0435\u0442, \u043e\u043d \u0431\u044b\u043b
    \u0438\u0437\u0431\u0440\u0430\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a
    \u0421\u0421\u0421\u0420.\n\n\U0001F48D \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c:
    \u0431\u0440\u0430\u043a, \u0434\u0440\u0443\u0436\u0431\u0430 \u0438 \u0441\u0435\u043c\u044c\u044f
    \u0412 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u0435 1942 \u0433\u043e\u0434\u0430, \u0432
    \u0440\u0430\u0437\u0433\u0430\u0440 \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b, \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0410\u043d\u043d\u0435 \u0414\u043c\u0438\u0442\u0440\u0438\u0435\u0432\u043d\u0435
    \u0415\u0433\u043e\u0440\u043e\u0432\u043e\u0439. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u0435\u0433\u043e \u043e\u0434\u043d\u043e\u043a\u043b\u0430\u0441\u0441\u043d\u0438\u0446\u0435\u0439
    \u043f\u043e \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438 \u0420\u0435\u043f\u043c\u0430\u043d
    \u0438 \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0430, \u0447\u043b\u0435\u043d\u0430-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u0430
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0414\u043c\u0438\u0442\u0440\u0438\u044f
    \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447\u0430 \u0415\u0433\u043e\u0440\u043e\u0432\u0430.
    \u0418\u0445 \u0431\u0440\u0430\u043a \u0434\u043b\u0438\u043b\u0441\u044f 45 \u043b\u0435\u0442.
    \u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439
    \u0443 \u043d\u0438\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e, \u043d\u043e \u043e\u043d\u0438
    \u0432\u043e\u0441\u043f\u0438\u0442\u044b\u0432\u0430\u043b\u0438 \u043f\u0430\u0441\u044b\u043d\u043a\u0430
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430, \u041e. \u0421. \u0418\u0432\u0430\u0448\u0451\u0432\u0430-\u041c\u0443\u0441\u0430\u0442\u043e\u0432\u0430.
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u044d\u043f\u043e\u0445\u0438 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f:
    \u043e\u043d \u0445\u043e\u0434\u0438\u043b \u0432 \u043f\u043e\u0445\u043e\u0434\u044b,
    \u0441\u043f\u043b\u0430\u0432\u043b\u044f\u043b\u0441\u044f \u043d\u0430 \u0431\u0430\u0439\u0434\u0430\u0440\u043a\u0430\u0445,
    \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b \u043d\u0430 \u043b\u044b\u0436\u0430\u0445
    \u043f\u043e 40-50 \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u043e\u0432 \u0438 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b
    \u0437\u0430\u043f\u043b\u044b\u0432\u044b \u0432 \u043b\u0435\u0434\u044f\u043d\u043e\u0439
    \u0432\u043e\u0434\u0435.\n\n\U0001F468\u200d\U0001F3EB \u0423\u0447\u0451\u043d\u044b\u0439-\u043f\u0440\u043e\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043b\u044c:
    \u0448\u043a\u043e\u043b\u0430, \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u044b \u0438
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u041f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0431\u044b\u043b\u0430
    \u0434\u043b\u044f \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430 \u043d\u0435
    \u043c\u0435\u043d\u0435\u0435 \u0432\u0430\u0436\u043d\u0430, \u0447\u0435\u043c \u043d\u0430\u0443\u0447\u043d\u0430\u044f.
    \u0412 1963 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u043e\u0440\u043e\u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b-\u0438\u043d\u0442\u0435\u0440\u043d\u0430\u0442\u0430 \u211618
    \u043f\u0440\u0438 \u041c\u0413\u0423 (\u043d\u044b\u043d\u0435 \u0421\u0423\u041d\u0426
    \u041c\u0413\u0423). \u041e\u043d \u043b\u0438\u0447\u043d\u043e \u0447\u0438\u0442\u0430\u043b
    \u0442\u0430\u043c \u043b\u0435\u043a\u0446\u0438\u0438, \u0432\u043e\u0434\u0438\u043b
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 \u0432 \u043f\u043e\u0445\u043e\u0434\u044b
    \u0438 \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u043b
    \u041f\u043e\u043f\u0435\u0447\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0441\u043e\u0432\u0435\u0442.
    \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u0443 \u043d\u0435\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u043b\u0430\u0441\u044c \u0431\u043e\u043b\u0435\u0437\u043d\u044c
    \u041f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0430: \u043e\u043d \u043b\u0438\u0448\u0438\u043b\u0441\u044f
    \u0437\u0440\u0435\u043d\u0438\u044f, \u0440\u0435\u0447\u0438 \u0438 \u0431\u044b\u043b
    \u043e\u0431\u0435\u0437\u0434\u0432\u0438\u0436\u0435\u043d. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0434\u0430\u0436\u0435 \u0432 \u0442\u0430\u043a\u043e\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438
    \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u043c
    \u0441\u0432\u043e\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438
    \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0431\u044b\u0442\u044c \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0441\u0432\u043e\u0435\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b. \u0410\u043d\u0434\u0440\u0435\u0439 \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0443\u0448\u0435\u043b \u0438\u0437
    \u0436\u0438\u0437\u043d\u0438 20 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1987 \u0433\u043e\u0434\u0430
    \u0432 \u041c\u043e\u0441\u043a\u0432\u0435, \u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0438 \u0446\u0435\u043b\u0443\u044e \u043f\u043b\u0435\u044f\u0434\u0443
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432,
    \u0441\u0440\u0435\u0434\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0431\u043e\u043b\u0435\u0435
    20 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u0432 \u0438 \u0447\u043b\u0435\u043d\u043e\u0432-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u0432."
  personalLifeEn: 
  shortBioRu: "\u0410\u043d\u0434\u0440\u0435\u0439 \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    XX \u0432\u0435\u043a\u0430, \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0448\u0438\u0440\u043e\u043a\u0438\u0439
    \u0441\u043f\u0435\u043a\u0442\u0440 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u043f\u043e\u043b\u043d\u044b \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0445
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432 \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445
    \u043f\u0440\u043e\u0437\u0440\u0435\u043d\u0438\u0439.\n\n\U0001F4DC \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0410\u043d\u0434\u0440\u0435\u0439
    \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    12 (25 \u043f\u043e \u043d\u043e\u0432\u043e\u043c\u0443 \u0441\u0442\u0438\u043b\u044e)
    \u0430\u043f\u0440\u0435\u043b\u044f 1903 \u0433\u043e\u0434\u0430 \u0432 \u0422\u0430\u043c\u0431\u043e\u0432\u0435.
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c, \u041c\u0430\u0440\u0438\u044f \u042f\u043a\u043e\u0432\u043b\u0435\u0432\u043d\u0430
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430, tragically \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c
    \u043f\u0440\u0438 \u0440\u043e\u0434\u0430\u0445. \u041e\u0442\u0435\u0446, \u041d\u0438\u043a\u043e\u043b\u0430\u0439
    \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447 \u041a\u0430\u0442\u0430\u0435\u0432,
    \u0431\u044b\u043b \u0430\u0433\u0440\u043e\u043d\u043e\u043c\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u0432
    \u0440\u0430\u0437\u044a\u0435\u0437\u0434\u0430\u0445 \u0438 \u043f\u043e\u0433\u0438\u0431
    \u0432 1919 \u0433\u043e\u0434\u0443 \u043d\u0430 \u042e\u0436\u043d\u043e\u043c \u0444\u0440\u043e\u043d\u0442\u0435
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b. \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u043d\u0435
    \u0431\u044b\u043b\u0438 \u0432\u0435\u043d\u0447\u0430\u043d\u044b, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430 \u043a\u0440\u0435\u0441\u0442\u0438\u043b
    \u0434\u044f\u0434\u044f, \u0437\u0430\u043f\u0438\u0441\u0430\u0432 \u0435\u0433\u043e
    \u043f\u043e\u0434 \u0441\u0432\u043e\u0435\u0439 \u0444\u0430\u043c\u0438\u043b\u0438\u0435\u0439
    \u2014 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432. \u0412\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435\u043c
    \u0410\u043d\u0434\u0440\u0435\u044f \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0430\u0441\u044c
    \u0441\u0435\u0441\u0442\u0440\u0430 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u0440\u0438,
    \u0412\u0435\u0440\u0430 \u042f\u043a\u043e\u0432\u043b\u0435\u0432\u043d\u0430 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0436\u0435 \u0443\u0441\u044b\u043d\u043e\u0432\u0438\u043b\u0430
    \u0435\u0433\u043e, \u0438 \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d
    \u043f\u0440\u043e\u0436\u0438\u043b \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0435\u0451
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0432 1951 \u0433\u043e\u0434\u0443. \u0420\u0430\u043d\u043d\u0435\u0435
    \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0448\u043b\u043e \u0432 \u0440\u043e\u0434\u043e\u0432\u043e\u043c
    \u0438\u043c\u0435\u043d\u0438\u0438 \u0434\u0435\u0434\u0430 \u0432 \u0441\u0435\u043b\u0435
    \u0422\u0443\u043d\u043e\u0448\u043d\u0430 \u043f\u043e\u0434 \u042f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u0435\u043c.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c, \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0435,
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0439 \u0442\u0435\u0442\u0443\u0448\u043a\u0430\u043c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0441\u0442\u0440\u043e\u0438\u043b\u0438
    \u0434\u043b\u044f \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439
    \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0448\u043a\u043e\u043b\u0443 \u043f\u043e
    \u043d\u043e\u0432\u0435\u0439\u0448\u0438\u043c \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0430\u043c, \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u0435\u0433\u043e \u0440\u0430\u043d\u043d\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0434\u0430\u0440. \u0412 \u043f\u044f\u0442\u044c \u043b\u0435\u0442 \u043e\u043d \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u0441\u0443\u043c\u043c\u044b \u043d\u0435\u0447\u0451\u0442\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b:
    1 = 1\u00b2, 1 + 3 = 2\u00b2, 1 + 3 + 5 = 3\u00b2 \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435,
    \u0447\u0442\u043e \u0441\u0430\u043c \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0441\u0432\u043e\u0435\u0439 \u043f\u0435\u0440\u0432\u043e\u0439
    \u00ab\u0440\u0430\u0434\u043e\u0441\u0442\u044c\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u00bb.\n\n\U0001F393 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u043a
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e \u0412 1910 \u0433\u043e\u0434\u0443 \u0412\u0435\u0440\u0430
    \u042f\u043a\u043e\u0432\u043b\u0435\u0432\u043d\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u043b\u0430
    \u0410\u043d\u0434\u0440\u0435\u044f \u0432 \u041c\u043e\u0441\u043a\u0432\u0443, \u0433\u0434\u0435
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0447\u0430\u0441\u0442\u043d\u0443\u044e
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044e \u0415.\u0410. \u0420\u0435\u043f\u043c\u0430\u043d.
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u0447\u0435\u0431\u043d\u043e\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0435,
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043a\u0440\u0443\u0436\u043a\u043e\u043c
    \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0438\u0433\u0435\u043d\u0446\u0438\u0438,
    \u0433\u0434\u0435 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0438 \u0438 \u0434\u0435\u0432\u043e\u0447\u043a\u0438
    \u0443\u0447\u0438\u043b\u0438\u0441\u044c \u0432\u043c\u0435\u0441\u0442\u0435 \u043f\u043e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435 \u043c\u0443\u0436\u0441\u043a\u043e\u0439
    \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438. \u0413\u0438\u043c\u043d\u0430\u0437\u0438\u044f
    \u0434\u0430\u043b\u0430 \u0435\u043c\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0440\u043e\u0447\u043d\u044b\u0435 \u0437\u043d\u0430\u043d\u0438\u044f, \u043d\u043e
    \u0438 \u0448\u0438\u0440\u043e\u0442\u0443 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432.
    \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0443\u0441\u043f\u0435\u0445\u0430\u043c
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u044d\u0442\u0438\u043c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u043c \u043d\u0430
    \u043a\u043b\u0430\u0441\u0441 \u0441\u0442\u0430\u0440\u0448\u0435, \u043e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u0442\u043e\u0447\u043d\u044b\u043c\u0438 \u043d\u0430\u0443\u043a\u0430\u043c\u0438. \u041e\u043d
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439,
    \u0441\u043e\u0446\u0438\u043e\u043b\u043e\u0433\u0438\u0435\u0439, \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0435\u0439
    \u0438 \u0434\u0430\u0436\u0435 \u043c\u0435\u0447\u0442\u0430\u043b \u0441\u0442\u0430\u0442\u044c
    \u043b\u0435\u0441\u043d\u0438\u0447\u0438\u043c. \u041f\u0435\u0440\u0432\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0434\u043e\u043a\u043b\u0430\u0434 17-\u043b\u0435\u0442\u043d\u0438\u0439 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0441\u0434\u0435\u043b\u0430\u043b \u043d\u0435 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0430 \u043d\u0430 \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0430
    \u0421.\u0412. \u0411\u0430\u0445\u0440\u0443\u0448\u0438\u043d\u0430, \u0433\u0434\u0435
    \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b \u0441 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u043f\u043e \u043d\u043e\u0432\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u043c\u0443
    \u0437\u0435\u043c\u043b\u0435\u0432\u043b\u0430\u0434\u0435\u043d\u0438\u044e XV\u2013XVI
    \u0432\u0435\u043a\u043e\u0432, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432 \u0434\u043b\u044f
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b. \u0412 1920 \u0433\u043e\u0434\u0443, \u0432 \u044d\u043f\u043e\u0445\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u0432 \u0432\u0443\u0437\u044b \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438
    \u0431\u0435\u0437 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u043e\u0432, \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u043d\u0430 \u0434\u0432\u0430 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f:
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u2014
    \u0432 \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0438 \u043c\u0435\u0442\u0430\u043b\u043b\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u2014 \u0432 \u041c\u0435\u043d\u0434\u0435\u043b\u0435\u0435\u0432\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442. \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0432\u0441\u043a\u043e\u0440\u0435
    \u0432\u0437\u044f\u043b\u043e \u0432\u0435\u0440\u0445, \u0438 \u043e\u043d \u0446\u0435\u043b\u0438\u043a\u043e\u043c
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u043b\u0441\u044f \u043d\u0430
    \u0443\u0447\u0451\u0431\u0435 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u0412 \u041c\u0413\u0423 \u0435\u043c\u0443 \u043f\u043e\u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u0438\u043b\u043e\u0441\u044c
    \u0443\u0447\u0438\u0442\u044c\u0441\u044f \u0443 \u0446\u0435\u043b\u043e\u0439 \u043f\u043b\u0435\u044f\u0434\u044b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0443 \u041d.\u041d. \u041b\u0443\u0437\u0438\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0432\u043e\u0438\u043c \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c. \u0423\u0436\u0435 \u0432 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c, \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0432
    \u0432 1922 \u0433\u043e\u0434\u0443 \u043f\u0440\u0438\u043c\u0435\u0440 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0435\u043c\u043e\u0439
    \u043f\u043e \u041b\u0435\u0431\u0435\u0433\u0443 \u0444\u0443\u043d\u043a\u0446\u0438\u0438,
    \u0440\u044f\u0434 \u0424\u0443\u0440\u044c\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0440\u0430\u0441\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e\u0447\u0442\u0438
    \u0432\u0441\u044e\u0434\u0443. \u041e\u043a\u043e\u043d\u0447\u0438\u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0432 1925 \u0433\u043e\u0434\u0443, \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443,
    \u0433\u0434\u0435 \u043d\u0430\u0447\u0430\u043b \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u0442\u044c \u0441 \u0410.\u042f.
    \u0425\u0438\u043d\u0447\u0438\u043d\u044b\u043c, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0432
    \u043c\u0435\u0442\u043e\u0434\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u043a \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u042d\u0442\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u043e\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043b\u043e \u043d\u0430\u0447\u0430\u043b\u043e
    \u043d\u043e\u0432\u043e\u0439 \u044d\u0440\u044b \u0432 \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u0435.\n\n\U0001F680
    \u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u043f\u0443\u0442\u044c \u0438 \u043c\u0438\u0440\u043e\u0432\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0412 1930\u20131931 \u0433\u043e\u0434\u0430\u0445
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0441\u0442\u0430\u0436\u0438\u0440\u043e\u0432\u0430\u043b\u0441\u044f
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0430,
    \u041c\u044e\u043d\u0445\u0435\u043d\u0430 \u0438 \u041f\u0430\u0440\u0438\u0436\u0430,
    \u0433\u0434\u0435 \u043e\u0431\u0449\u0430\u043b\u0441\u044f \u0441 \u0442\u0430\u043a\u0438\u043c\u0438
    \u043a\u043e\u0440\u0438\u0444\u0435\u044f\u043c\u0438, \u043a\u0430\u043a \u0414. \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u0438 \u0420. \u041a\u0443\u0440\u0430\u043d\u0442. \u0412 1931 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041c\u0413\u0423, \u0430 \u0432 1939 \u0433\u043e\u0434\u0443 \u2014 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c
    \u0410\u041d \u0421\u0421\u0421\u0420. \u0412 1933 \u0433\u043e\u0434\u0443 \u0443\u0432\u0438\u0434\u0435\u043b
    \u0441\u0432\u0435\u0442 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u2014 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u00ab\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439\u00bb,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u044d\u0442\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u0435\u0440\u044b. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c
    \u0448\u0435\u0441\u0442\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430
    \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439,
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432 \u0435\u0451 \u0432 \u0441\u0442\u0440\u043e\u0433\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443.
    \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430 \u0431\u044b\u043b\u0438
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0447\u043d\u044b.
    \u0412\u043e\u0442 \u043b\u0438\u0448\u044c \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043d \u0432\u043d\u0451\u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434: - \u0422\u0435\u043e\u0440\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f: \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0440\u044f\u0434\u0430\u043c, \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0435\u0440\u044b,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 (\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0414\u0436. \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0435\u0440\u043e\u043c)
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0439.
    - \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u043a\u0430:
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e-\u0438\u0437\u043e\u0442\u0440\u043e\u043f\u043d\u043e\u0439
    \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u0438
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u0430
    \u00ab\u0434\u0432\u0435 \u043f\u044f\u0442\u044b\u0445\u00bb (\u0437\u0430\u043a\u043e\u043d
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430\u2013\u041e\u0431\u0443\u0445\u043e\u0432\u0430)
    \u0434\u043b\u044f \u0441\u043f\u0435\u043a\u0442\u0440\u0430 \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438.
    - \u0422\u0435\u043e\u0440\u0438\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c \u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430: \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u043e\u0441\u043d\u043e\u0432 \u041a\u0410\u041c-\u0442\u0435\u043e\u0440\u0438\u0438 (\u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430\u2013\u0410\u0440\u043d\u043e\u043b\u044c\u0434\u0430\u2013\u041c\u043e\u0437\u0435\u0440\u0430),
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0412.\u0418. \u0410\u0440\u043d\u043e\u043b\u044c\u0434\u043e\u043c 13-\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u043e \u0441\u0443\u043f\u0435\u0440\u043f\u043e\u0437\u0438\u0446\u0438\u044f\u0445
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.
    - \u0422\u0435\u043e\u0440\u0438\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432: \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432,
    \u0447\u0442\u043e \u043d\u0430\u0448\u043b\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438. - \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043b\u043e\u0433\u0438\u043a\u0430 \u0438 \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0430:
    \u0432\u043d\u0451\u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u0441\u043a\u0443\u044e
    \u043b\u043e\u0433\u0438\u043a\u0443 \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u043d\u0443\u043c\u0435\u0440\u0430\u0446\u0438\u0439,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u043a \u0430\u043d\u0430\u043b\u0438\u0437\u0443 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438
    \u0440\u0435\u0447\u0438 \u0438 \u0441\u0442\u0438\u0445\u043e\u0441\u043b\u043e\u0436\u0435\u043d\u0438\u044f.\n\n\U0001F3C6
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435, \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u043a\u0430
    \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439
    \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043e\u0431\u0449\u0435\u0441\u0442\u0432,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0435
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e
    \u0438 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0443\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e
    \u043d\u0430\u0443\u043a. \u0415\u0433\u043e \u0437\u0430\u0441\u043b\u0443\u0433\u0438
    \u0431\u044b\u043b\u0438 \u043e\u0442\u043c\u0435\u0447\u0435\u043d\u044b \u0432\u044b\u0441\u0448\u0438\u043c\u0438
    \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u043d\u0430\u0433\u0440\u0430\u0434\u0430\u043c\u0438 \u0421\u0421\u0421\u0420: \u043e\u043d
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0437\u0432\u0430\u043d\u0438\u044f
    \u0413\u0435\u0440\u043e\u044f \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430, \u0441\u0435\u043c\u0438 \u043e\u0440\u0434\u0435\u043d\u043e\u0432
    \u041b\u0435\u043d\u0438\u043d\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435 \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u043e\u0439
    \u0438 \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0439. \u041f\u043e\u043c\u0438\u043c\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b, \u043e\u043d \u0432\u043d\u0451\u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    - \u0411\u044b\u043b \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u043e\u0440\u043e\u043c
    \u0438 \u0431\u0435\u0441\u0441\u043c\u0435\u043d\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u043f\u043e\u043f\u0435\u0447\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0432\u0435\u0442\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b-\u0438\u043d\u0442\u0435\u0440\u043d\u0430\u0442\u0430 \u211618
    \u043f\u0440\u0438 \u041c\u0413\u0423 (\u043d\u044b\u043d\u0435 \u0421\u0423\u041d\u0426
    \u041c\u0413\u0423), \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0439 \u0432 1963
    \u0433\u043e\u0434\u0443. - \u041e\u0441\u043d\u043e\u0432\u0430\u043b \u0438 \u0431\u044b\u043b
    \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u0435\u043c \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e
    \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0430 \u043d\u0430\u0443\u0447\u043d\u043e-\u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e
    \u0436\u0443\u0440\u043d\u0430\u043b\u0430 \u0434\u043b\u044f \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432
    \u00ab\u041a\u0432\u0430\u043d\u0442\u00bb. - \u0410\u0432\u0442\u043e\u0440 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0445
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u0432 \u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432
    \u0411\u043e\u043b\u044c\u0448\u043e\u0439 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0438. - \u0421\u043e\u0437\u0434\u0430\u043b
    \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443, \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0432 \u043f\u043b\u0435\u044f\u0434\u0443
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0412.\u0418. \u0410\u0440\u043d\u043e\u043b\u044c\u0434\u0430,
    \u0418.\u041c. \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430, \u042f.\u0413. \u0421\u0438\u043d\u0430\u044f
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445. \u0410\u043d\u0434\u0440\u0435\u0439
    \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041c\u043e\u0441\u043a\u0432\u0435
    20 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1987 \u0433\u043e\u0434\u0430, \u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c\u043e\u0435
    \u043f\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044e \u0441 \u0442\u0440\u0443\u0434\u0430\u043c\u0438
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0443\u043c\u043e\u0432 \u0432
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430.
    \u0412 1994 \u0433\u043e\u0434\u0443 \u0420\u0410\u041d \u0443\u0447\u0440\u0435\u0434\u0438\u043b\u0430
    \u043f\u0440\u0435\u043c\u0438\u044e \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0438 \u0437\u0430
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0410\u043d\u0434\u0440\u0435\u044f \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447\u0430
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430 \u0431\u044b\u043b\u0430
    \u043f\u043e\u043b\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043f\u0440\u043e\u0437\u0440\u0435\u043d\u0438\u0439,
    \u043d\u043e \u0438 \u044f\u0440\u043a\u0438\u0445, \u0430 \u043f\u043e\u0440\u043e\u0439
    \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u043f\u0440\u044f\u043c\u043e\u0442\u044b \u0438
    \u0448\u0438\u0440\u043e\u0442\u044b \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432.\n\n\U0001F4A1
    \u041f\u0435\u0440\u0432\u043e\u0435 \u00ab\u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u00bb
    \u0438 \u044e\u043d\u043e\u0448\u0435\u0441\u043a\u0438\u0439 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u0438\u0437\u043c
    \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u043e\u0447\u0435\u043d\u044c
    \u0440\u0430\u043d\u043e. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043f\u044f\u0442\u0438-\u0448\u0435\u0441\u0442\u0438
    \u043b\u0435\u0442 \u043e\u043d \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0442\u043a\u0440\u044b\u043b \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u0441\u0443\u043c\u043c\u044b \u043d\u0435\u0447\u0435\u0442\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u0437\u0430\u043c\u0435\u0442\u0438\u0432, \u0447\u0442\u043e `1 = 1\u00b2`, `1 + 3 = 2\u00b2`,
    `1 + 3 + 5 = 3\u00b2`. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0431\u044b\u043b\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e
    \u0432 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u043c \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u043d\u043e\u043c
    \u0436\u0443\u0440\u043d\u0430\u043b\u0435 \u00ab\u0412\u0435\u0441\u0435\u043d\u043d\u0438\u0435
    \u043b\u0430\u0441\u0442\u043e\u0447\u043a\u0438\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0435\u0433\u043e \u0442\u0435\u0442\u044f \u0438\u0437\u0434\u0430\u0432\u0430\u043b\u0430
    \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0432 \u0438\u043c\u0435\u043d\u0438\u0438.
    \u0412 \u044e\u043d\u043e\u0441\u0442\u0438 \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439. \u0412 17 \u043b\u0435\u0442
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u0443\u044e
    \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e
