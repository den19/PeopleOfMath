    \u043f\u0440\u0430\u0432\u043e \u043d\u0430 16 \u043a\u0438\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0432
    \u0445\u043b\u0435\u0431\u0430 \u0438 1 \u043a\u0438\u043b\u043e\u0433\u0440\u0430\u043c\u043c
