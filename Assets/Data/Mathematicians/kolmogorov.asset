    \u0432 1939 \u0433\u043e\u0434\u0443 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u044b\u0431\u043e\u0440\u043e\u0432
    \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a. \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432,
    \u0434\u0440\u0443\u0433 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430,
    \u0431\u0430\u043b\u043b\u043e\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0441\u044f \u0432
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0438. \u041b\u0443\u0437\u0438\u043d \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e
    \u043f\u043e\u043e\u0431\u0435\u0449\u0430\u043b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044c
    \u0435\u0433\u043e, \u043d\u043e \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e
    \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441 \u0440\u0435\u0447\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0431\u044b\u043b\u0430 \u0438\u0437\u0434\u0435\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0439,
    \u043d\u0430\u0437\u0432\u0430\u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u0430
    \u00ab\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c\u00bb \u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0435\u0441
    \u00ab\u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u0438 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0438\u043a\u0430\u043c\u00bb. \u0420\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043d\u043d\u044b\u0439
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0432 \u043a\u043e\u0440\u0438\u0434\u043e\u0440\u0435
    \u043d\u0430\u0447\u0430\u043b \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u041b\u0443\u0437\u0438\u043d\u0443 \u043f\u0440\u0435\u0442\u0435\u043d\u0437\u0438\u0438,
    \u043d\u0430 \u0447\u0442\u043e \u0442\u043e\u0442, \u043a\u0430\u043a \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b
    \u041b.\u0421. \u041f\u043e\u043d\u0442\u0440\u044f\u0433\u0438\u043d, \u0441 \u043d\u0435\u0432\u043e\u0437\u043c\u0443\u0442\u0438\u043c\u044b\u043c
    \u0432\u0438\u0434\u043e\u043c \u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u043b \u0435\u043c\u0443
    \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u043a \u0432\u0440\u0430\u0447\u0443
    \u0438 \u043f\u043e\u0445\u043b\u043e\u043f\u044b\u0432\u0430\u043b \u043f\u043e \u043f\u043b\u0435\u0447\u0443.
    \u041f\u043e\u0442\u0435\u0440\u044f\u0432\u0448\u0438\u0439 \u0441\u0430\u043c\u043e\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u0435
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0443\u0434\u0430\u0440\u0438\u043b
    \u0441\u0432\u043e\u0435\u0433\u043e \u0431\u044b\u0432\u0448\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u043f\u043e \u043b\u0438\u0446\u0443. \u041b\u0443\u0437\u0438\u043d \u043d\u0430\u0434\u0435\u043b
    \u043f\u043e\u0432\u044f\u0437\u043a\u0443 \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0443
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e
    \u043d\u0430 \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430 \u0431\u044b\u043b\u0438
    \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u044b \u0441\u0430\u043d\u043a\u0446\u0438\u0438
    \u2014 \u0435\u0433\u043e \u043d\u0430 \u0442\u0440\u0438 \u043c\u0435\u0441\u044f\u0446\u0430
    \u043f\u043e\u043d\u0438\u0437\u0438\u043b\u0438 \u0432 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438
    \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u043e\u043c
    \u0434\u043e \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430.\n\n\U0001F9D0 \u0418\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0435 \u0438 \u0441\u0442\u0438\u0445\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044e
    \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u0438\u0440\u0430\u043b\u0438\u0441\u044c
    \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u0441\u0442\u0438\u0445\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f. \u0412
    1960 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u043e\u0447\u0435\u043b \u0446\u0438\u043a\u043b
    \u043b\u0435\u043a\u0446\u0438\u0439 \u043d\u0430 \u0442\u0435\u043c\u0443 \u00ab\u0422\u0435\u043e\u0440\u0438\u044f
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0440\u0438\u0442\u043c\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e \u0441\u0442\u0438\u0445\u0430\u00bb.
    \u0412 1962 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0443\u044e \u0441\u0442\u0430\u0442\u044c\u044e
    \u043e \u0440\u0438\u0442\u043c\u0438\u043a\u0435 \u043f\u043e\u044d\u043c \u041c\u0430\u044f\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u044d\u0442\u0438\u043c \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c \u0434\u043e 1968
    \u0433\u043e\u0434\u0430. \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439
    \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0438 \u043d\u0430 \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0435 \u041c\u0413\u0423 \u0438 \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b
    \u043d\u0430 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043a\u0443\u0440\u0441\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0434\u043b\u044f \u0432\u0441\u0435\u0445
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432-\u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u043e\u0432,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f, \u0447\u0442\u043e \u0434\u043b\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043d\u0443\u0436\u043d\u044b \u0437\u043d\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438, \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438."
  interestingFactsEn: "Andrei Nikolaevich Kolmogorov's life was filled not only with great scientific vision, but also with bright and sometimes chickenic episodes that reveal him as a man of remarkable energy, integrity, and breadth of interest.\n\nThe first \"opening\" and young maximalism of Geniality of Kolmogorov was very early. At the age of five to six years, he himself discovered the pattern of the sum of odd numbers, noting that `1 = 12', `1 + 3 = 22', `1 + 3 + 5 = 32'. This discovery was published in the home-handed magazine \"Spring Caretakes\", which his aunt published for children in their homes. His interests were not limited to mathematics at his youth.At the age of 17, he wrote a serious scientific paper on history, a study of land relations in the Novgorod Republic, based on the written books of the XV–XVI centuries, but when he weighed down, he chose mathematics, saying to the students, \"I decided to go to science, where there was only one piece of evidence, not just a few, as in historical science.\"\n\nThe student who broke the system and received a \"social package\" after the revolution was a difficult life in Moscow, and Kolmogorov had to leave for the construction of the Kazan-Ekaterinburg railway. He continued to prepare for the examinations on his own, and when he returned, he was given a secondary school certificate \"even though he had not bothered to test\".In 1920, he joined both the Mathematical Department of the MGU and the Metallurgical Department of the Institute of Chemical Technology, but he soon chose math, and in the first month of his studies he passed his first year of examinations and was transferred to a second year, and in those hungry years he received a unique \"reward\": the right to 16 kilograms of bread and 1 kilo of oil per month, which at the time meant complete material well-being.\n\n~ \"Professor, it is wrong...\" is a bold debut famous story that determined his scientific fate that occurred at a lecture by Professor Nikolai Luzin. When the mathematician suggested building evidence of the theorem based on one assumption, the first-year student Kolmogorov raised his hand and made it clear: \"Professor, it is wrong...\" He explained his point immediately.So Colmogorov was in Luzitania, an informal association of talented students of Lusin, where a special creative atmosphere prevailed. The joke anthem of Luzitania read: \"Our god is Lebeg, Kumir is an integral one. Our framework of life is narrow, as our commander Lusin told us.\" At the age of 19, he built an example of a Lebeg integrated function whose series of Furiers are scattered almost everywhere, disproved the idea of Fourier himself and instantly became world-famous.\n\nIn 1935, he and his closest friend, the mathematician Pavel Alexandrov, bought a large white house, owned by Sister Constantin Stanislawski, which became not just a gift, but a center of attraction for the mathematical elite.There was a strict schedule of days, which friends observed for years: the 7:00 a.m. rise, the morning mental work until 2:00 p.m. After lunch, it was a mandatory walk or skiing for 40-50 kilometres, followed by rest, reading, music, and conversation, and only in two cases, when scientific research was gambling and took time, or on the sunny days of March, when skiing was the main activity.\n\n==Career==The slap of the academicist History revealed the complex nature of the scientist in 1939 during the elections to the Academy of Sciences. Alexandrov, a friend of Kolmogorov, ran for the Academy. Lusin publicly promised to support him, but instead gave a speech that was in fact defiant, calling Alexandrov \"Philosophism\" as opposed to \"excellent mathematicians and appliedists\".The angry Kolmogorov in the hallway began to complain to Luzin that the man who remembered L.S. Pontrágin had advised him to go to a doctor with an unforgivable look and pat on his shoulder, and the one who lost control of the Kolmogors hit his former teacher in the face.Lusin was wearing a blindfold and went to complain to the President of the Academy, after which Kolmogorov was sanctioned for three months, being demoted as head of the department to a senior researcher.\n\nIn 1960, he gave a series of lectures on the topic \"Theory of Probability and Analysis of the Rhythm of the Russian poem.\" In 1962, he published a joint article on the rhythm of the Mayakovsky poem and was actively involved in the subject until 1968.Kolmogorov was actively involved in the creation of an applied linguistics department at the Philology Faculty of the MGU and insisted on a compulsory course in mathematics for all linguistic students, arguing that work in this field required knowledge of mathematical logic, probability theory and information theory."
