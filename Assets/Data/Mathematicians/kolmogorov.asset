    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0440\u0438\u0442\u043c\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e \u0441\u0442\u0438\u0445\u0430\u00bb.
    \u0412 1962 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0443\u044e \u0441\u0442\u0430\u0442\u044c\u044e
    \u043e \u0440\u0438\u0442\u043c\u0438\u043a\u0435 \u043f\u043e\u044d\u043c \u041c\u0430\u044f\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u044d\u0442\u0438\u043c \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c \u0434\u043e 1968
    \u0433\u043e\u0434\u0430. \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439
    \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0438 \u043d\u0430 \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0435 \u041c\u0413\u0423 \u0438 \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b
    \u043d\u0430 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043a\u0443\u0440\u0441\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0434\u043b\u044f \u0432\u0441\u0435\u0445
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432-\u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u043e\u0432,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f, \u0447\u0442\u043e \u0434\u043b\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043d\u0443\u0436\u043d\u044b \u0437\u043d\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438, \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438."
