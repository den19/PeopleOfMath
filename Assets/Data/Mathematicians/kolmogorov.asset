    \u0436\u0435\u043b\u0435\u0437\u043d\u043e\u0439 \u0434\u043e\u0440\u043e\u0433\u0438 \u041a\u0430\u0437\u0430\u043d\u044c-\u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433.
    \u041e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c\u0441\u044f
    \u043a \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u043c \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0430 \u043a\u043e\u0433\u0434\u0430 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f,
    \u0435\u043c\u0443 \u0432\u044b\u0434\u0430\u043b\u0438 \u0430\u0442\u0442\u0435\u0441\u0442\u0430\u0442
    \u043e \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438,
    \u00ab\u0434\u0430\u0436\u0435 \u043d\u0435 \u043f\u043e\u0442\u0440\u0443\u0434\u0438\u0432\u0448\u0438\u0441\u044c
