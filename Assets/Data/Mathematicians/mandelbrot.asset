  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0411\u0435\u043d\u0443\u0430 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043d\u043e\u0432\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0439
    \u043c\u0438\u0440. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0438\u0434\u0435\u0439.\n\n\U0001F9EC
    \"\u0424\u0440\u0430\u043a\u0442\u0430\u043b\": \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u043d\u043e\u0432\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430 \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430 \u2014 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0438 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e\u043d\u044f\u0442\u0438\u044f
    \u0444\u0440\u0430\u043a\u0442\u0430\u043b \u0432 1975 \u0433\u043e\u0434\u0443. \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0442\u0435\u0440\u043c\u0438\u043d\u0430 \u0438 \u0435\u0433\u043e \u0441\u0443\u0442\u044c:
    \u0422\u0435\u0440\u043c\u0438\u043d \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d
    \u043e\u0442 \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u043b\u0430\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    fractus (\u00ab\u0441\u043b\u043e\u043c\u0430\u043d\u043d\u044b\u0439, \u0440\u0430\u0437\u0431\u0438\u0442\u044b\u0439\u00bb),
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0433\u043e \u043e\u0442 \u0433\u043b\u0430\u0433\u043e\u043b\u0430
    frangere (\u00ab\u043b\u043e\u043c\u0430\u0442\u044c\u00bb). \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u043b, \u0447\u0442\u043e \u044d\u0442\u043e
    \u0441\u043b\u043e\u0432\u043e \u0434\u043e\u043b\u0436\u043d\u043e \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u00ab\u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0441\u0442\u044c\u00bb,
    \u043d\u043e \u0438 \u00ab\u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0444\u043e\u0440\u043c\u044b\u00bb. \u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e
    \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u0430 \u2014 \u0441\u0430\u043c\u043e\u043f\u043e\u0434\u043e\u0431\u0438\u0435:
    \u043e\u0434\u043d\u0430 \u0438 \u0442\u0430 \u0436\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430
    \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442\u0441\u044f \u0432 \u0440\u0430\u0437\u043d\u044b\u0445
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430\u0445. \u0421\u043c\u0435\u043d\u0430 \u043f\u0430\u0440\u0430\u0434\u0438\u0433\u043c\u044b:
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u0431\u0440\u043e\u0441\u0438\u043b
    \u0432\u044b\u0437\u043e\u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f, \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e,
    \u043d\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b. \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0444\u0440\u0430\u0437\u0430: \u00ab\u041e\u0431\u043b\u0430\u043a\u0430 \u2014 \u043d\u0435
    \u0441\u0444\u0435\u0440\u044b, \u0433\u043e\u0440\u044b \u2014 \u043d\u0435 \u043a\u043e\u043d\u0443\u0441\u044b,
    \u0431\u0435\u0440\u0435\u0433\u043e\u0432\u044b\u0435 \u043b\u0438\u043d\u0438\u0438 \u2014
    \u043d\u0435 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438...\u00bb \u0441\u0442\u0430\u043b\u0430
    \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u043e\u043c \u043d\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0448\u0435\u0440\u043e\u0445\u043e\u0432\u0430\u0442\u043e\u0441\u0442\u044c,
    \u0438\u0437\u0440\u0435\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u0438 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0441\u0442\u044c
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0435
    \u0434\u0435\u0444\u0435\u043a\u0442\u044b, \u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u044b\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432.\n\n\U0001F4D0 \"\u0414\u043b\u0438\u043d\u0430
    \u0431\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0439 \u043b\u0438\u043d\u0438\u0438\"
    \u0438 \u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u0432, \u043f\u0440\u0438\u0432\u0435\u0434\u0448\u0438\u0445
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430 \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438, \u0441\u0442\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043d\u0430\u0434, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0431\u044b, \u043f\u0440\u043e\u0441\u0442\u044b\u043c
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c. \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430:
    \u0412 1967 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c\u044e \u00ab\u041a\u0430\u043a\u043e\u0432\u0430 \u0434\u043b\u0438\u043d\u0430
    \u043f\u043e\u0431\u0435\u0440\u0435\u0436\u044c\u044f \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u0438?\u00bb.
    \u041e\u0442\u0432\u0435\u0442 \u0431\u044b\u043b \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u0435\u043d:
    \u0434\u043b\u0438\u043d\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0442\u043e\u0433\u043e,
    \u043a\u0430\u043a\u043e\u0439 \u043b\u0438\u043d\u0435\u0439\u043a\u043e\u0439 \u0432\u044b
    \u0438\u0437\u043c\u0435\u0440\u044f\u0435\u0442\u0435. \u0427\u0435\u043c \u043c\u0435\u043d\u044c\u0448\u0435
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431, \u0442\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439 (\u0431\u0443\u0445\u0442, \u043c\u044b\u0441\u043e\u0432,
    \u043a\u0430\u043c\u043d\u0435\u0439) \u0432\u044b \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0435
    \u0438 \u0442\u0435\u043c \u0434\u043b\u0438\u043d\u043d\u0435\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u0431\u0435\u0440\u0435\u0433\u043e\u0432\u0430\u044f \u043b\u0438\u043d\u0438\u044f, \u0441\u0442\u0440\u0435\u043c\u044f\u0441\u044c
    \u043a \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438. \u0420\u0435\u0448\u0435\u043d\u0438\u0435
    \u0447\u0435\u0440\u0435\u0437 \u0434\u0440\u043e\u0431\u043d\u0443\u044e \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c:
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u0440\u0430\u0437\u0432\u0438\u043b
    \u0438\u0434\u0435\u0438 \u041b\u044c\u044e\u0438\u0441\u0430 \u0424\u0440\u0430\u044f \u0420\u0438\u0447\u0430\u0440\u0434\u0441\u043e\u043d\u0430
    \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0437\u043c\u0435\u0440\u044f\u0442\u044c
    \u043d\u0435 \u0434\u043b\u0438\u043d\u0443, \u0430 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u0442\u0430\u043a\u0438\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432. \u0412
    \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0433\u043b\u0430\u0434\u043a\u043e\u0439
    \u043b\u0438\u043d\u0438\u0438 (\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    1) \u0438\u043b\u0438 \u0433\u043b\u0430\u0434\u043a\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438
    (\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c 2), \u0431\u0435\u0440\u0435\u0433\u043e\u0432\u0430\u044f
    \u043b\u0438\u043d\u0438\u044f \u0438\u043c\u0435\u0435\u0442 \u0434\u0440\u043e\u0431\u043d\u0443\u044e
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c \u043c\u0435\u0436\u0434\u0443
    1 \u0438 2. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u043f\u043e\u0431\u0435\u0440\u0435\u0436\u044c\u044f \u041d\u043e\u0440\u0432\u0435\u0433\u0438\u0438
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u043a\u043e\u043b\u043e
    1.52. \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043e
    \u043e\u043d\u0430 \u00ab\u0437\u0430\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u00bb \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0441\u0438\u043b\u044c\u043d\u0435\u0435, \u0447\u0435\u043c \u043b\u0438\u043d\u0438\u044f,
    \u043d\u043e \u0441\u043b\u0430\u0431\u0435\u0435, \u0447\u0435\u043c \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u044c.\n\n\U0001F4BB
    \u0412\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438:
    \u041c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438, \u043d\u043e \u0438 \u0432 \u0441\u043f\u043e\u0441\u043e\u0431\u0435
    \u043f\u043e\u0434\u0430\u0447\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0434\u0435\u0439. \u041e\u0442 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0438
    \u043a \u043e\u0431\u0440\u0430\u0437\u0443: \u0421\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u2014 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430 \u2014 \u043d\u0430
    \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e
    \u0435\u0433\u043e \u0447\u0438\u0441\u0442\u044b\u043c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 (\u0413\u0430\u0441\u0442\u043e\u043d
    \u0416\u044e\u043b\u0438\u0430, \u041f\u044c\u0435\u0440 \u0424\u0430\u0442\u0443) \u0438\u0437\u0443\u0447\u0430\u043b\u0438
    \u0435\u0433\u043e \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u0435\u0449\u0435 \u0432
    \u043d\u0430\u0447\u0430\u043b\u0435 XX \u0432\u0435\u043a\u0430, \u043d\u043e \u0438\u0445
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u0441\u0443\u0433\u0443\u0431\u043e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u043c\u0438. \u0420\u043e\u043b\u044c
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432 IBM: \u0420\u0430\u0431\u043e\u0442\u0430\u044f
    \u0432 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 IBM \u0432 1958\u20131993 \u0433\u043e\u0434\u0430\u0445,
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043c\u043e\u0449\u043d\u044b\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u043c.
    \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0438\u0445 \u0434\u043b\u044f \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u0438\u0442\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430
    \\( z \\to z^2 + c \\), \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u043e\u0437\u0434\u0430\u043b
    \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u044d\u0442\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430. \u0418\u043c\u0435\u043d\u043d\u043e
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0430\u044f \u0433\u0440\u0430\u0444\u0438\u043a\u0430
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0430 \u0441\u043b\u043e\u0436\u043d\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0432 \u0437\u0430\u0432\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u044e\u0449\u0443\u044e
    \u043a\u0440\u0430\u0441\u043e\u0442\u0443, \u043f\u043e\u043a\u0430\u0437\u0430\u0432 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u0443\u044e
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0438 \u0441\u0430\u043c\u043e\u043f\u043e\u0434\u043e\u0431\u0438\u0435
    \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430.
    \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u0432\u0441\u0435\u0439 \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u043e,
    \u043a\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u0430\u044f \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0440\u043e\u0436\u0434\u0430\u0442\u044c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u0443\u044e
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b\u043e \u043d\u043e\u0432\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044e
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.\n\n\U0001F4B0
    \u0424\u0440\u0430\u043a\u0442\u0430\u043b\u044b \u0432 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043d\u0430\u0443\u043a\u0430\u0445 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b
    \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438
    \u00ab\u0447\u0438\u0441\u0442\u043e\u0439\u00bb \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0432
    \u0438\u0445 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    \u0424\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435 \u0440\u044b\u043d\u043a\u0438:
    \u041e\u043d \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u044f
    \u0446\u0435\u043d \u043d\u0430 \u0445\u043b\u043e\u043f\u043e\u043a \u0437\u0430 100 \u043b\u0435\u0442
    \u0438\u043c\u0435\u044e\u0442 \u0441\u0430\u043c\u043e\u043f\u043e\u0434\u043e\u0431\u043d\u0443\u044e
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443: \u0434\u043d\u0435\u0432\u043d\u044b\u0435
    \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u043e\u0442\u043b\u0438\u0447\u0438\u043c\u044b \u043e\u0442 \u0433\u043e\u0434\u043e\u0432\u044b\u0445.
    \u042d\u0442\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u043b\u043e
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043c\u043e\u0434\u0435\u043b\u044f\u043c \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044e, \u0447\u0442\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435
    \u0440\u044b\u043d\u043a\u0438 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u0435\u0435
    \u00ab\u0434\u0438\u043a\u0438\u0435\u00bb \u0438 \u043f\u043e\u0434\u0432\u0435\u0440\u0436\u0435\u043d\u044b
    \u0440\u0438\u0441\u043a\u0430\u043c, \u0447\u0435\u043c \u0441\u0447\u0438\u0442\u0430\u043b\u043e\u0441\u044c.
    \u0414\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u0438\u043c\u0435\u0440\u044b: \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u0438\u043b\u0438 \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0438 \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u043f\u043e\u0432\u0441\u0435\u043c\u0435\u0441\u0442\u043d\u043e:
    \u0432 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435 \u043b\u0435\u0433\u043a\u0438\u0445
    \u0438 \u043a\u0440\u043e\u0432\u0435\u043d\u043e\u0441\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    (\u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0435\u0440\u0435\u0432\u043e,
    \u0441\u0435\u0442\u044c \u0441\u043e\u0441\u0443\u0434\u043e\u0432), \u0432 \u044f\u0437\u044b\u043a\u043e\u0437\u043d\u0430\u043d\u0438\u0438
    (\u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b
    \u0441\u043b\u043e\u0432 \u0432 \u0442\u0435\u043a\u0441\u0442\u0435), \u0432 \u0430\u043d\u0430\u043b\u0438\u0437\u0435
    \u0432\u043e\u0434\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 \u041d\u0438\u043b\u0430,
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0434\u0430\u0436\u0435 \u0432 \u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0438
    \u043e\u0432\u043e\u0449\u0435\u0439, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a
    \u0431\u0440\u043e\u043a\u043a\u043e\u043b\u0438.\n\n\U0001F4DA \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0441\u0432\u043e\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u0432 \u0440\u044f\u0434\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442, \u0441\u0440\u0435\u0434\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u0441\u043e\u0431\u043e\u0435 \u043c\u0435\u0441\u0442\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0442:
    1. \u00ab\u0424\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b\u00bb (The Fractal Geometry of Nature, 1982)
    \u2014 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0438 \u0441\u0430\u043c\u0430\u044f
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043a\u043d\u0438\u0433\u0430, \u0441\u0442\u0430\u0432\u0448\u0430\u044f
    \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u043e\u043c \u043d\u043e\u0432\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u0412 \u043d\u0435\u0439 \u043e\u043d \u0441\u043e\u0431\u0440\u0430\u043b
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438, \u0441\u043d\u0430\u0431\u0434\u0438\u0432
    \u0438\u0445 \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u043c. 2. \u00ab(\u041d\u0435)\u043f\u043e\u0441\u043b\u0443\u0448\u043d\u044b\u0435
    \u0440\u044b\u043d\u043a\u0438: \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0432 \u0444\u0438\u043d\u0430\u043d\u0441\u0430\u0445\u00bb
    (The (Mis)behavior of Markets, 2004) \u2014 \u0440\u0430\u0431\u043e\u0442\u0430, \u0432
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u0435 \u0432\u0438\u0434\u0435\u043d\u0438\u0435
    \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u0438\u0440\u043e\u0434\u044b
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432 \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0441\u0432\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0440\u0438\u0441\u043a\u043e\u0432. 3. \u00ab\u0424\u0440\u0430\u043a\u0442\u0430\u043b\u044b,
    \u0441\u043b\u0443\u0447\u0430\u0439 \u0438 \u0444\u0438\u043d\u0430\u043d\u0441\u044b\u00bb
    (Fractals, Chance and Finance, 2004) \u2014 \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0435\u0433\u043e
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u0431\u043e\u0442
    \u043f\u043e \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u0438, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445
    \u0435\u0449\u0435 \u0432 1960-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0438 \u0441\u0442\u0430\u0432\u0448\u0438\u0445
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0445
    \u0442\u0435\u043e\u0440\u0438\u0439.\n\n\U0001F3DB\ufe0f \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u0417\u0430 \u0441\u0432\u043e\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432\u044b\u0441\u0448\u0435\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435.
    \u041e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u041f\u0440\u0435\u043c\u0438\u0438
    \u0412\u043e\u043b\u044c\u0444\u0430 \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435 (1993)
    \u0438 \u041f\u0440\u0435\u043c\u0438\u0438 \u042f\u043f\u043e\u043d\u0438\u0438 (2003).
    \u0415\u0433\u043e \u0438\u0434\u0435\u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u043d\u043e
    \u0438 \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u0443, \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044e,
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443, \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0443\u044e
    \u0433\u0440\u0430\u0444\u0438\u043a\u0443 \u0438 \u0434\u0430\u0436\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e.
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0437\u0430
    \u0432\u043d\u0435\u0448\u043d\u0438\u043c \u0445\u0430\u043e\u0441\u043e\u043c \u043f\u0440\u0438\u0440\u043e\u0434\u044b
    \u0441\u0442\u043e\u0438\u0442 \u0441\u0442\u0440\u043e\u0433\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u0440\u044f\u0434\u043e\u043a, \u0430 \u0434\u043b\u044f \u0435\u0433\u043e
    \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u043d\u0443\u0436\u0435\u043d \u043d\u043e\u0432\u044b\u0439
    \u044f\u0437\u044b\u043a \u2014 \u044f\u0437\u044b\u043a \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u043e\u0432."
  achievementsEn: "Benoua Mandelbrot's scientific legacy is not just a new field of mathematics, but a profound re-examination of how mathematics describes the real world, and its contribution can be divided into several interrelated revolutionary ideas.\n\n==History==The origin of the term and its essence: The term is derived from the Latin adjective fractal (\"broken, broken\"), derived from the verb frangere (\"break\").The key property of fractal is self-like: the same structure is repeated on different scales. The paradigm shift: Mandelbrot challenged classical euclidic geometry, which he thought was not suitable for describing nature. His famous phrase: \"Clouds are not spheres, mountains are not cones, coastlines are not circles...\" was a manifesto of new geometry.He showed that roughness, cutness, and fragmentation were not random defects, but a fundamental property of natural objects.\n\nThe problem is: in 1967, he published an article entitled \"What is the length of the British coast?\" The answer was paradoxical: the length depends on what line you measure.The smaller the scale, the bigger the detail (paper, mouse, stone) you take into account and the longer the coastline becomes, seeking infinity. The solution through fractional dimension: Mandelbrot developed Lewis Fry Richardson's ideas and suggested measuring not the length but the dimension of such objects. Unlike a smooth line (size 1) or smooth surface (size 2), the coastline has a fractional dimension between 1 and 2.For example, the size of the Norwegian coast is about 1.52. This means that it \"fills\" space stronger than the line but weaker than the plane.\n\n♪ Visualization of mathematics: Mandelbrot Mandelbrot revolutionized not only in theory, but also in the way of presenting mathematical ideas. From abstraction to image: The most famous visualization, the many Mandelbrots, was not really a pure discovery. Mathematics (Haston Julia, Pierre Fatou) studied its properties as early as the 20th century, but their descriptions were purely abstract.The role of IBM computers: While working at the IBM research centre in 1958-1993, Mandelbrot gained access to powerful computers. Using them to visualize the iterative process \\(z \\to z2 + c\\), he first created a detailed image of this multitude. It was the computer graph that turned complex theory into enthralling beauty, showing the infinite complexity and self-likeness of the many boundary.Significance: This has become a symbol of the entire fractal geometry and has shown how a simple formula can create infinite complexity and has stimulated new interest in the use of computers in mathematics.\n\n♪ Fractals in the economy and other sciences Mandelbrot actively applied his ideas beyond pure mathematics, demonstrating their universality. ♪ Financial markets: He was one of the first to notice that 100-year swings in cotton prices have a similar pattern: day swings are statistically indistinguishable from annual.This was contrary to classical economic models and led to the realization that financial markets were much more \"wild\" and risk-prone than thought.Other examples: Mandelbrot or his followers found fractal structures everywhere: in the structure of the lung and blood system (bronchial tree, vessel network), in linguistics (distribution of word frequency in text), in the analysis of the Nile water regime, in the theory of turbulence and even in the building of vegetables such as broccoli.\n\nThe basic scientific work The results of Mandelbrot's research have been described in a number of fundamental works, including the following: 1. \"Fractal Geometry of Nature\" (The Fractal Geometry of Nature, 1982) is his main and most famous book, which has become a manifesto of the new science, and he has gathered and systematized his ideas with rich illustrative material. 2.(The (Mis)behavior of Markets, 2004) is a work in which he detailed his vision of the fractal nature of finance and applied his models for risk analysis. 3. \"Fractals, Case and Finance\" (Fractals, Chance and Finance, 2004) is a compilation of his classic work on economics and the theory of accidents written back in the 1960s and formed the basis for many modern financial theories.\n\nThe recognition and influence of Mandelbrot's work has been given the highest recognition. He was awarded the Wolfe Prize in Physics (1993) and the Japan Prize (2003). (2003) His ideas have had a tremendous impact not only on mathematics, but also on physics, biology, economics, computer graphics and even art. He has shown that the external chaos of nature is accompanied by a strict mathematical order and that it requires a new language, the language of fractals."
  personalLifeRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0411\u0435\u043d\u0443\u0430 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0448\u0451\u043b \u0447\u0435\u0440\u0435\u0437
    \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f,
    \u0447\u0442\u043e\u0431\u044b \u0432 \u0438\u0442\u043e\u0433\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c
    \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u043a\u0430\u0440\u0442\u0438\u043d\u0443 \u043c\u0438\u0440\u0430,
    \u043e\u0441\u0442\u0430\u0432\u0430\u044f\u0441\u044c \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u0432\u043e\u043b\u044c\u043d\u043e\u0434\u0443\u043c\u0446\u0435\u043c \u0438 \u0431\u0443\u043d\u0442\u0430\u0440\u0451\u043c.\n\n\U0001F9EC
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u043c\u044c\u044f.
    \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u0434\u044f\u0434\u0438-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0411\u0435\u043d\u0443\u0430 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 20 \u043d\u043e\u044f\u0431\u0440\u044f 1924
    \u0433\u043e\u0434\u0430 \u0432 \u0412\u0430\u0440\u0448\u0430\u0432\u0435, \u041f\u043e\u043b\u044c\u0448\u0430.
    \u0415\u0433\u043e \u0441\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439,
    \u0440\u043e\u0434\u043e\u043c \u0438\u0437 \u041b\u0438\u0442\u0432\u044b. \u041e\u0442\u0435\u0446,
    \u041a\u0430\u0440\u043b \u0421\u043e\u043b\u043e\u043c\u043e\u043d\u043e\u0432\u0438\u0447
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0439\u0442, \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435\u0439 \u043e\u0434\u0435\u0436\u0434\u043e\u0439,
    \u0430 \u043c\u0430\u0442\u044c, \u0411\u0435\u043b\u043b\u0430 \u041b\u0443\u0440\u044c\u0435,
    \u0431\u044b\u043b\u0430 \u0432\u0440\u0430\u0447\u043e\u043c. \u041e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u0443
    \u0438 \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435 \u043e\u043a\u0430\u0437\u0430\u043b
    \u0434\u044f\u0434\u044f, \u0428\u043e\u043b\u0435\u043c (\u0421\u043e\u043b\u0435\u043c)
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0439\u0442 \u2014 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u043e\u0434\u0438\u043d \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0433\u0440\u0443\u043f\u043f\u044b \u00ab\u041d\u0438\u043a\u043e\u043b\u044f \u0411\u0443\u0440\u0431\u0430\u043a\u0438\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u043f\u0430\u0433\u0430\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043b\u0430
    \u0441\u0442\u0440\u043e\u0433\u0443\u044e, \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u0443\u044e
    \u0438 \u043b\u0438\u0448\u0451\u043d\u043d\u0443\u044e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u043e\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0434\u044f\u0434\u044f \u0432\u0437\u044f\u043b \u043d\u0430
    \u0441\u0435\u0431\u044f \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u043a\u0430,
    \u043d\u043e \u043f\u0440\u0438\u0432\u0438\u0432\u0430\u043b \u0435\u043c\u0443 \u0441\u0443\u0433\u0443\u0431\u043e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0435 \u0432\u0438\u0434\u0435\u043d\u0438\u0435,
    \u0447\u0442\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u0441\u043f\u0440\u043e\u0432\u043e\u0446\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0443 \u0411\u0435\u043d\u0443\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u0443\u044e \u0440\u0435\u0430\u043a\u0446\u0438\u044e
    \u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043c\u0435\u0442\u043e\u0434\u0430\u043c.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F466
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e, \u0432\u043e\u0439\u043d\u0430 \u0438 \u043f\u043e\u0431\u0435\u0433
    \u043e\u0442 \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432 \u0412 1936 \u0433\u043e\u0434\u0443,
    \u043f\u0440\u0435\u0434\u0432\u0438\u0434\u044f \u0443\u0433\u0440\u043e\u0437\u0443 \u0441\u043e
    \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u043e\u0439
    \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438, \u0441\u0435\u043c\u044c\u044f \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0430
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u0438 \u043f\u043e\u0441\u0435\u043b\u0438\u043b\u0430\u0441\u044c
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435. \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0438 \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u0435\u0439 \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u044b \u0431\u0435\u0436\u0430\u043b\u0438
    \u043d\u0430 \u044e\u0433 \u0441\u0442\u0440\u0430\u043d\u044b, \u0432 \u0433\u043e\u0440\u043e\u0434\u043e\u043a
    \u0422\u044e\u043b\u044c. \u0422\u0430\u043c \u0436\u0438\u0437\u043d\u044c \u0441\u0435\u043c\u044c\u0438
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0435\u0439,
    \u0438 \u0411\u0435\u043d\u0443\u0430 \u043d\u0435 \u0440\u0430\u0437 \u0431\u044b\u043b
    \u043d\u0430 \u0432\u043e\u043b\u043e\u0441\u043e\u043a \u043e\u0442 \u0433\u0438\u0431\u0435\u043b\u0438.
    \u0415\u0433\u043e \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u043e, \u0438 \u043e\u043d
    \u0447\u0430\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u043b\u0441\u044f
    \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u043c\u0438 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0430\u043c\u0438,
    \u0431\u044b\u043b \u043a\u043e\u043d\u044e\u0445\u043e\u043c \u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u0441\u043b\u0435\u0441\u0430\u0440\u044f. \u041a\u0430\u043a \u043d\u0438 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u043e,
    \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0438 \u0433\u043e\u0434\u044b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u043e\u0433\u043e
    \u0441\u0430\u043c\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0435\u0433\u043e
    \u043a\u0430\u043a \u0443\u0447\u0451\u043d\u043e\u0433\u043e. \u041e\u043d \u043f\u043e\u0437\u0436\u0435
    \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e \u043d\u0435\u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0435
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0434\u0430\u043b\u043e \u0435\u043c\u0443
    \u0441\u0432\u043e\u0431\u043e\u0434\u0443 \u043c\u044b\u0441\u043b\u0438\u0442\u044c \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e
    \u0438 \u0440\u0430\u0437\u0432\u0438\u043b\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435. \u0421\u0432\u043e\u0439
    \u0434\u0430\u0440 \u043e\u043d \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0443\u0436\u0435 \u0442\u043e\u0433\u0434\u0430, \u0440\u0435\u0448\u0430\u044f \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c,
    \u0447\u0442\u043e \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u043e \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435
    \u0443 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439.\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430:
    \u0411\u0443\u043d\u0442 \u043f\u0440\u043e\u0442\u0438\u0432 \u0411\u0443\u0440\u0431\u0430\u043a\u0438
    \u0438 \u043f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0443 \u041f\u043e\u0441\u043b\u0435
    \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u0432 1944 \u0433\u043e\u0434\u0443 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436.
    \u0415\u0433\u043e \u043f\u0443\u0442\u044c \u0432 \u0432\u044b\u0441\u0448\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443 \u0431\u044b\u043b \u0442\u0435\u0440\u043d\u0438\u0441\u0442\u044b\u043c:
    \u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u042d\u043a\u043e\u043b\u044c \u041d\u043e\u0440\u043c\u0430\u043b\u044c:
    \u041f\u043e \u0441\u043e\u0432\u0435\u0442\u0443 \u0434\u044f\u0434\u0438 \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u0412\u044b\u0441\u0448\u0443\u044e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 (\u00c9cole Normale Sup\u00e9rieure), \u043e\u043f\u043b\u043e\u0442
    \u0433\u0440\u0443\u043f\u043f\u044b \u0411\u0443\u0440\u0431\u0430\u043a\u0438. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0441\u044c
    \u0432 \u0438\u0445 \u0434\u043e\u0433\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0434\u0445\u043e\u0434\u0435 \u0438 \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043d\u043e\u0441\u0442\u0438
    \u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0411\u0435\u043d\u0443\u0430
    \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0435\u0451 \u0432\u0441\u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437
    \u043e\u0434\u0438\u043d \u0434\u0435\u043d\u044c. \u041f\u043e\u0437\u0436\u0435 \u043e\u043d
    \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0441\u044f, \u0447\u0442\u043e \u0434\u044f\u0434\u044f
    \u0441\u0430\u043c \u043f\u043e\u043c\u043e\u0433 \u0435\u043c\u0443 \u043e\u0441\u043e\u0437\u043d\u0430\u0442\u044c,
    \u0447\u0442\u043e \"\u044d\u0442\u043e \u0432\u043e\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0433\u0440\u0443\u043f\u043f\u0430 \u0441 \u0441\u0438\u043b\u044c\u043d\u044b\u043c\u0438
    \u043f\u0440\u0435\u0434\u0440\u0430\u0441\u0441\u0443\u0434\u043a\u0430\u043c\u0438 \u043f\u0440\u043e\u0442\u0438\u0432
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\". \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430: \u0412 1945\u20131947 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0443\u044e
    \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435, \u0433\u0434\u0435
    \u0443\u0447\u0438\u043b\u0441\u044f \u0443 \u0442\u0430\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043a\u0430\u043a \u0413\u0430\u0441\u0442\u043e\u043d \u0416\u044e\u043b\u0438\u0430 \u0438
    \u041f\u043e\u043b\u044c \u041b\u0435\u0432\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0441\u0438\u043b\u044c\u043d\u043e
    \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438 \u043d\u0430 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0421\u0428\u0410
    \u0438 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c:
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0421\u0428\u0410, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430 \u043f\u043e \u0430\u044d\u0440\u043e\u043d\u0430\u0432\u0442\u0438\u043a\u0435
    \u0432 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u043e\u043c
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 (1947\u20131949). \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e, \u0432 1952 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0415\u0433\u043e
    \u0442\u0435\u043c\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u0430
    \u0434\u043b\u044f \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u2014
    \u043e\u043d\u0430 \u043a\u0430\u0441\u0430\u043b\u0430\u0441\u044c \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u0447\u0430\u0441\u0442\u043e\u0442 \u0441\u043b\u043e\u0432 \u0432 \u044f\u0437\u044b\u043a\u0435
    (\u0437\u0430\u043a\u043e\u043d \u0426\u0438\u043f\u0444\u0430-\u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430).\n\n\U0001F4BC
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u041a\u0430\u0440\u044c\u0435\u0440\u0430
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u0432\u043d\u0435 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u0445
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0443\u0433\u043e\u0432,
    \u0447\u0442\u043e \u043f\u043e\u0440\u043e\u0439 \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u043e
    \u043d\u0435\u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435: \u041d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0430\u0443\u0442\u0441\u0430\u0439\u0434\u0435\u0440: \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0432 \u0416\u0435\u043d\u0435\u0432\u0435
    (\u0433\u0434\u0435 \u0432 1955 \u0433\u043e\u0434\u0443 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0410\u043b\u044c\u0435\u0442\u0442 \u041a\u0430\u0433\u0430\u043d ) \u0438
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435, \u0433\u0434\u0435 \u0431\u044b\u043b
    \u043f\u043e\u0441\u0442\u0434\u043e\u043a\u043e\u043c \u0443 \u0414\u0436\u043e\u043d\u0430
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430. \u0415\u0433\u043e \u044d\u043a\u043b\u0435\u043a\u0442\u0438\u0447\u043d\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u043d\u0435 \u0432\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0440\u0430\u043c\u043a\u0438 \"\u0447\u0438\u0441\u0442\u043e\u0439\" \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441 \u0434\u044f\u0434\u0435\u0439:
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u044f\u0434\u0435\u0439
    \u0428\u043e\u043b\u0435\u043c\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443
    \u0431\u044b\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c,
    \u0438\u0441\u043f\u043e\u0440\u0442\u0438\u043b\u0438\u0441\u044c. \u041a\u043e\u0433\u0434\u0430
    \u0411\u0435\u043d\u0443\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0442\u0435\u043c\u0443
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u0434\u044f\u0434\u0435 \"\u0435\u0440\u0443\u043d\u0434\u043e\u0439\",
    \u0442\u043e\u0442 \u0432 \u0441\u0435\u0440\u0434\u0446\u0430\u0445 \u0432\u044b\u0443\u0434\u0438\u043b
    \u0438\u0437 \u043c\u0443\u0441\u043e\u0440\u043d\u043e\u0439 \u043a\u043e\u0440\u0437\u0438\u043d\u044b
    \u0438\u0441\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0435 \u043b\u0438\u0441\u0442\u044b
    \u0438 \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u042d\u0442\u043e \u0442\u0435\u0431\u0435,
    \u0442\u0435\u0431\u0435, \u0441\u0443\u0434\u044f \u043f\u043e \u0432\u0441\u0435\u043c\u0443,
    \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f\u00bb. \u0412 \u044d\u0442\u0438\u0445
    \u043b\u0438\u0441\u0442\u0430\u0445 \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c
    \u0438\u0434\u0435\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0436\u0435
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u043e\u0432.
    \"\u0417\u043e\u043b\u043e\u0442\u043e\u0439 \u0432\u0435\u043a\" \u0432 IBM: \u0412 1958
    \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0421\u0428\u0410 \u0438 \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 IBM \u0432 \u0419\u043e\u0440\u043a\u0442\u0430\u0443\u043d\u0435.
    IBM \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0435\u043c\u0443
    \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u043b\u043d\u0443\u044e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u0432\u043e\u0431\u043e\u0434\u0443, \u0447\u0442\u043e \u0431\u044b\u043b\u043e
    \u043d\u0435\u043c\u044b\u0441\u043b\u0438\u043c\u043e \u0434\u043b\u044f \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u041e\u043d \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0432\u0441\u0451 \u043f\u043e\u0434\u0440\u044f\u0434 \u2014 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443,
    \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0443, \u0442\u0443\u0440\u0431\u0443\u043b\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u044c,
    \u2014 \u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c, \u0438\u043c\u0435\u044f
    \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043c\u043e\u0449\u043d\u044b\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u043c,
    \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f. \u041f\u043e\u0437\u0434\u043d\u0435\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u0412 1987 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u0441\u043b\u0435 \u0443\u0445\u043e\u0434\u0430 \u0438\u0437 IBM, \u043e\u043d
    \u0441\u0442\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 \u0419\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0438 \u043b\u0438\u0448\u044c \u0432 1999 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    75 \u043b\u0435\u0442, \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0432\u043e\u044e
    \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u2014 \u0421\u0442\u0435\u0440\u043b\u0438\u043d\u0433\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a.\n\n\U0001F56F\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c \u0411\u0435\u043d\u0443\u0430
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    14 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 2010 \u0433\u043e\u0434\u0430 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0448\u0442\u0430\u0442 \u041c\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 85 \u043b\u0435\u0442 \u043e\u0442
    \u0440\u0430\u043a\u0430 \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439
    \u0436\u0435\u043b\u0435\u0437\u044b."
  personalLifeEn: "Benoua Mandelbrot's biography is the story of a man who went through the most difficult tests to eventually change the scientific picture of the world while remaining a free-thinker and a rebel.\n\n* Birth and family: The influence of the mathematical uncle Benoit Mandelbrot was born on 20 November 1924 in Warsaw, Poland, and his family was Jewish, from Lithuania.His fate and outlook were greatly influenced by his uncle, Mr. Scholem (Solem), Mandelbright, a well-known Parisian mathematician and one of the founding members of the Nikola Burbaki group, who promoted strict, abstract, and non-geometric maths, and it was the uncle who took over the education of his nephew, but he gave him a purely abstract vision, which ultimately provoked Benoua's backlash and interest in geometric methods.\n\nThe family emigrated to France and settled in Paris in 1936 with the outbreak of World War II and the French occupation of Mandelbrots fled to the south of the country, the town of Tuhl.His formal education was interrupted, and he was often interrupted by casual earnings, a stablesman and a locksmith student, and paradoxically, it was these years of forced self-education that formed him as a scientist; he later said that irregular learning gave him freedom to think outside the box and developed a unique spatial imagination.He showed his gift at that time, solving complex algebraic problems geometrically, which was surprising to the teachers.\n\n==History======================Burbaca======Burbaki==========Burtelbroth========================================================================================================================================================================================================He later admitted that his uncle himself had helped him to realize that \"it was a militant group with strong prejudices against geometry.\" Polytechnic school: From 1945 to 1947, he entered a more applied polytechnic school in Paris, where he studied with mathematicians such as Gaston Julia and Paul Levy, who subsequently had a major impact on his work.He went to the United States for a master's degree in aeronautics from the California Institute of Technology (1947–1949) and returned to France in 1952 to defend his Ph.D. in the University of Paris, and his subject was unusual at the time, with regard to the distribution of language frequencies (the Tsipfa-Mandelbrot Act).\n\n♪ Work and relationships with career Mandelbrot's colleagues have developed outside of the traditional academic community, which has sometimes caused misunderstanding: Scientific outsider: he worked in France, in Geneva (where he married Alette Kagan in 1955) and in Princeton, where he was a post-doctor with John von Neyman, and his eclectic interests were not part of pure mathematics.The conflict with his uncle: The relationship with Uncle Schalom, who was still his mentor, was ruined. When Benoua suggested the subject of the dissertation, which seemed like \"nothing\" to his uncle, the man in his heart took out written sheets from the trash basket and said, \"You're the one who's gonna like it.\" These sheets have ideas that later led to the theory of fractals.\"Golden Age\" in IBM: In 1958, he moved permanently to the United States and began working at the IBM research centre in Yorktown. IBM gave him almost complete intellectual freedom, which was inconceivable for the university of the time. He explored everything in a row — economics, linguistics, turbulence — and that is where he made his major discoveries with access to powerful computers.Later admission: In 1987, after leaving IBM, he began teaching at Yale University, and only in 1999, at the age of 75, was he given his first permanent academic position, the Sterling Professor of Mathematics.\n\n==Death==Benoit Mandelbrot died on 14 October 2010 in Cambridge, Massachusetts, at the age of 85 from pancreatic cancer."
  shortBioRu: "\u0411\u0435\u043d\u0443\u0430 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    (1924\u20132010) \u2014 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u0438 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u043d\u0430\u0448\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u043e \u0444\u043e\u0440\u043c\u0435 \u0438 \u0445\u0430\u043e\u0441\u0435, \u0441\u043e\u0437\u0434\u0430\u0432
    \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u0443\u044e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0438 \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0431\u044b\u043b\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b,
    \u0447\u0435\u043c \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u0438\u043c \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b,
    \u0438 \u043e\u043d \u0447\u0430\u0441\u0442\u043e \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \"\u0447\u0443\u0434\u0430\u043a\u043e\u043c\" \u0432 \u0433\u043b\u0430\u0437\u0430\u0445
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u0442\u0435\u0431\u043b\u0438\u0448\u043c\u0435\u043d\u0442\u0430.\n\n\U0001F9EC
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u0441\u0435\u043c\u044c\u044f \u0411\u0435\u043d\u0443\u0430
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    20 \u043d\u043e\u044f\u0431\u0440\u044f 1924 \u0433\u043e\u0434\u0430 \u0432 \u0412\u0430\u0440\u0448\u0430\u0432\u0435,
    \u041f\u043e\u043b\u044c\u0448\u0430, \u0432 \u0441\u0435\u043c\u044c\u0435 \u043b\u0438\u0442\u043e\u0432\u0441\u043a\u0438\u0445
    \u0435\u0432\u0440\u0435\u0435\u0432. \u0421\u0435\u043c\u044c\u044f: \u0415\u0433\u043e
    \u043c\u0430\u0442\u044c, \u0411\u0435\u043b\u043b\u0430 \u041b\u0443\u0440\u044c\u0435,
    \u0431\u044b\u043b\u0430 \u0432\u0440\u0430\u0447\u043e\u043c, \u0430 \u043e\u0442\u0435\u0446,
    \u041a\u0430\u0440\u043b \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442,
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435\u0439
    \u043e\u0434\u0435\u0436\u0434\u043e\u0439. \u041e\u0434\u043d\u0430\u043a\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0411\u0435\u043d\u0443\u0430 \u043e\u043a\u0430\u0437\u0430\u043b
    \u0435\u0433\u043e \u0434\u044f\u0434\u044f, \u0428\u043e\u043b\u0435\u043c \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0439\u0442
    \u2014 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0433\u0440\u0443\u043f\u043f\u044b \"\u041d\u0438\u043a\u043e\u043b\u044f \u0411\u0443\u0440\u0431\u0430\u043a\u0438\".
    \u041f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e:
    \u0412 1936 \u0433\u043e\u0434\u0443, \u043f\u0440\u0435\u0434\u0432\u0438\u0434\u044f \u0443\u0433\u0440\u043e\u0437\u0443
    \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u043e\u0439
    \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438, \u0441\u0435\u043c\u044c\u044f \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0430
    \u0438\u0437 \u041f\u043e\u043b\u044c\u0448\u0438 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e
    \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0432 \u041f\u0430\u0440\u0438\u0436\u0435.\n\n\U0001F9D1\u200d\U0001F393
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0432\u043e\u0439\u043d\u0430
    \u0412 \u0433\u043e\u0434\u044b \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0436\u0438\u0437\u043d\u044c \u0441\u0435\u043c\u044c\u0438
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c.
    \u0411\u0435\u0433\u0441\u0442\u0432\u043e \u043e\u0442 \u0432\u043e\u0439\u043d\u044b:
    \u041f\u043e\u0441\u043b\u0435 \u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u0438
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u044b \u0431\u0435\u0436\u0430\u043b\u0438
    \u043d\u0430 \u044e\u0433 \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0432 \u0433\u043e\u0440\u043e\u0434\u043e\u043a
    \u0422\u044e\u043b\u044c. \u0422\u0430\u043c \u0411\u0435\u043d\u0443\u0430 \u043f\u043e\u0448\u0435\u043b
    \u0432 \u0448\u043a\u043e\u043b\u0443, \u043d\u043e \u0435\u0433\u043e \u0443\u0441\u043f\u0435\u0445\u0438
    \u0431\u044b\u043b\u0438 \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u043c\u0438. \u0421\u043e\u043e\u0431\u0449\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043a 16 \u0433\u043e\u0434\u0430\u043c \u043e\u043d \u0435\u0434\u0432\u0430
    \u0437\u043d\u0430\u043b \u0430\u043b\u0444\u0430\u0432\u0438\u0442 \u0438 \u0442\u0430\u0431\u043b\u0438\u0446\u0443
    \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f \u0434\u043e \u043f\u044f\u0442\u0438.
    \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438 \u0441 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0443\u0447\u0435\u0431\u043e\u0439, \u0443 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0430\u0440,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0438. \u041e\u043d \u043c\u043e\u0433
    \u0440\u0435\u0448\u0430\u0442\u044c \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c, \u0447\u0442\u043e \u0431\u044b\u043b\u043e
    \u043e\u0447\u0435\u043d\u044c \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e. \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b, \u0432 1945\u20131947 \u0433\u043e\u0434\u0430\u0445,
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435, \u0433\u0434\u0435
    \u0443\u0447\u0438\u043b\u0441\u044f \u0443 \u0442\u0430\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043a\u0430\u043a \u0413\u0430\u0441\u0442\u043e\u043d \u0416\u044e\u043b\u0438\u0430 \u0438
    \u041f\u043e\u043b\u044c \u041b\u0435\u0432\u0438. \u0417\u0430\u0442\u0435\u043c \u043e\u043d
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u043f\u043e \u0430\u044d\u0440\u043e\u043d\u0430\u0432\u0442\u0438\u043a\u0435 \u0432 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u043e\u043c
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 (1947\u20131949). \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e, \u0432 1952 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.\n\n\U0001F52C
    \u041f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0435: \u043e\u0442 \"\u0438\u0437\u0433\u043e\u044f\"
    \u0434\u043e \u043e\u0442\u0446\u0430 \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u043e\u0432
    \u0415\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u043e, \u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u044f
    \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d.
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u0435\u043c\u044c\u044f:
    \u0421 1949 \u043f\u043e 1958 \u0433\u043e\u0434 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u0446\u0435\u043d\u0442\u0440\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (CNRS) \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u0412 \u044d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b \u0433\u043e\u0434
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0433\u0434\u0435 \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c
    \u0431\u044b\u043b \u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d.
    \u0412 1955 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0410\u043b\u044c\u0435\u0442\u0442 \u041a\u0430\u0433\u0430\u043d. \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442: IBM (1958): \u0412 1958 \u0433\u043e\u0434\u0443 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0421\u0428\u0410 \u0438 \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0443
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 IBM \u0432 \u0419\u043e\u0440\u043a\u0442\u0430\u0443\u043d\u0435.
    IBM \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0435\u043c\u0443
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f:
    \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043c\u043e\u0449\u043d\u044b\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u043c
    \u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u0443 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438, \u0434\u0430\u043b\u0435\u043a\u043e
    \u0432\u044b\u0445\u043e\u0434\u044f\u0449\u0438\u043c\u0438 \u0437\u0430 \u0440\u0430\u043c\u043a\u0438
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447
    \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438. \u0412 IBM \u043e\u043d \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    35 \u043b\u0435\u0442, \u0441\u0442\u0430\u0432 IBM Fellow \u0432 1974 \u0433\u043e\u0434\u0443.
    \u041c\u0435\u0436\u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0440\u043d\u043e\u0441\u0442\u044c:
    \u0420\u0430\u0431\u043e\u0442\u0430\u044f \u0432 IBM, \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0443,
    \u0442\u0435\u043e\u0440\u0438\u044e \u0438\u0433\u0440, \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443,
    \u0430\u044d\u0440\u043e\u043d\u0430\u0432\u0442\u0438\u043a\u0443, \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044e,
    \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u044e, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0443. \u0415\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434
    \u0431\u044b\u043b \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u044b\u043c: \"\u042f
    \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u043c\u043e\u0438\u043c \u0438\u043d\u0441\u0442\u0438\u043d\u043a\u0442\u0430\u043c...\".\n\n\U0001F4A1
    \u0413\u043b\u0430\u0432\u043d\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0438\u0434\u0435\u0438 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430
    \u0440\u043e\u0436\u0434\u0430\u043b\u0438\u0441\u044c \u043d\u0430 \u0441\u0442\u044b\u043a\u0435
    \u043d\u0430\u0443\u043a. \u042d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430: \u0418\u0437\u0443\u0447\u0430\u044f
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0446\u0435\u043d \u043d\u0430
    \u0445\u043b\u043e\u043f\u043e\u043a \u0437\u0430 100 \u043b\u0435\u0442, \u043e\u043d \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b,
    \u0447\u0442\u043e \u0438\u0445 \u0445\u0430\u043e\u0442\u0438\u0447\u043d\u044b\u0435 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u044f
    \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u044e\u0442\u0441\u044f \u0441\u043a\u0440\u044b\u0442\u043e\u043c\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u043f\u043e\u0440\u044f\u0434\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c\u0438
    \u043a\u0440\u0438\u0432\u044b\u043c\u0438. \u041e\u043d \u043d\u0430\u0448\u0435\u043b
    \u0441\u0430\u043c\u043e\u043f\u043e\u0434\u043e\u0431\u0438\u0435 \u0432 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u044f\u0445
    \u0446\u0435\u043d, \u0441\u0434\u0435\u043b\u0430\u0432 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0432 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435.
    \u0412\u043e\u043f\u0440\u043e\u0441 \u043e \u0434\u043b\u0438\u043d\u0435 \u0431\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0439
    \u043b\u0438\u043d\u0438\u0438: \u0412 1967 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c\u044e \"\u041a\u0430\u043a\u043e\u0432\u0430 \u0434\u043b\u0438\u043d\u0430
    \u043f\u043e\u0431\u0435\u0440\u0435\u0436\u044c\u044f \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u0438?\",
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u043e\u0439 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u0438.
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0434\u043b\u0438\u043d\u0430
    \u043f\u043e\u0431\u0435\u0440\u0435\u0436\u044c\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043e\u0442 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f,
    \u0438 \u044d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442 \u043c\u043e\u0436\u043d\u043e
    \u043e\u043f\u0438\u0441\u0430\u0442\u044c \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043d\u043e\u0432\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0422\u0435\u0440\u043c\u0438\u043d \"\u0424\u0440\u0430\u043a\u0442\u0430\u043b\": \u0412
    1975 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b
    \u0441\u043b\u043e\u0432\u043e \"\u0444\u0440\u0430\u043a\u0442\u0430\u043b\" (\u043e\u0442
    \u043b\u0430\u0442. fractus \u2014 \"\u0441\u043b\u043e\u043c\u0430\u043d\u043d\u044b\u0439,
    \u0440\u0430\u0437\u0431\u0438\u0442\u044b\u0439\") \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0438\u0433\u0443\u0440,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0442
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e\u043c \u0441\u0430\u043c\u043e\u043f\u043e\u0434\u043e\u0431\u0438\u044f
    (\u043a\u0430\u0436\u0434\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442
    \u0446\u0435\u043b\u043e\u0435). \"\u0424\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u043f\u0440\u0438\u0440\u043e\u0434\u044b\"
    (1982): \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u043a\u043d\u0438\u0433\u0430.
    \u041e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043d\u043e\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u0443:
    \"\u041e\u0431\u043b\u0430\u043a\u0430 \u2014 \u043d\u0435 \u0441\u0444\u0435\u0440\u044b,
    \u0433\u043e\u0440\u044b \u2014 \u043d\u0435 \u043a\u043e\u043d\u0443\u0441\u044b, \u0431\u0435\u0440\u0435\u0433\u043e\u0432\u044b\u0435
    \u043b\u0438\u043d\u0438\u0438 \u2014 \u043d\u0435 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438...\",
    \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044f, \u0447\u0442\u043e \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u044b
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u0443\u0440\u044c\u0435\u0437\u044b, \u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430
    \u043c\u0438\u0440\u0430. \u041c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430:
    \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432
    IBM \u043e\u043d \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u043e\u0441\u0438\u0442
    \u0435\u0433\u043e \u0438\u043c\u044f. \u0425\u043e\u0442\u044f \u0435\u0433\u043e \u0438\u0437\u0443\u0447\u0430\u043b\u0438
    \u0438 \u0434\u043e \u043d\u0435\u0433\u043e (\u041f\u044c\u0435\u0440 \u0424\u0430\u0442\u0443,
    \u0413\u0430\u0441\u0442\u043e\u043d \u0416\u044e\u043b\u0438\u0430), \u0438\u043c\u0435\u043d\u043d\u043e
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439 \u0433\u0440\u0430\u0444\u0438\u043a\u0438
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0435\u0433\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e
    \u043a\u0440\u0430\u0441\u043e\u0442\u0443 \u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c,
    \u0441\u0434\u0435\u043b\u0430\u0432 \u0435\u0433\u043e \u0441\u0430\u043c\u044b\u043c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u043e\u043c \u0432 \u043c\u0438\u0440\u0435.\n\n\U0001F3DB\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0412 1987 \u0433\u043e\u0434\u0443 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u0443\u0448\u0435\u043b \u0438\u0437 IBM \u0438 \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 \u0419\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0433\u0434\u0435 \u0432 1999 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    75 \u043b\u0435\u0442, \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0432\u043e\u044e
    \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u2014 \u0421\u0442\u0435\u0440\u043b\u0438\u043d\u0433\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a. \u041e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043d\u0430\u0433\u0440\u0430\u0434, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041f\u0440\u0435\u043c\u0438\u044e
    \u0412\u043e\u043b\u044c\u0444\u0430 \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435 (1993)
    \u0438 \u041f\u0440\u0435\u043c\u0438\u044e \u042f\u043f\u043e\u043d\u0438\u0438 (2003).
    \u0411\u0435\u043d\u0443\u0430 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 14 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    2010 \u0433\u043e\u0434\u0430 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435,
    \u0448\u0442\u0430\u0442 \u041c\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441,
    \u043e\u0442 \u0440\u0430\u043a\u0430 \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439
    \u0436\u0435\u043b\u0435\u0437\u044b. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u0442\u043e\u043c,
    \u043a\u0430\u043a \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0435
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435, \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u044c
    \u0438 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u043c\u043e\u0433\u0443\u0442 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u044c
    \u043d\u043e\u0432\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043d\u0430\u0443\u043a\u0438,
    \u043d\u043e \u0438 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043d\u0430\u0448\u0435
    \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u0435 \u0432\u0441\u0435\u0433\u043e
    \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0433\u043e \u043c\u0438\u0440\u0430."
  shortBioEn: "Benoit Mandelbrot (1924–2010) is a French and American mathematician who has permanently changed our perception of form and chaos by creating fractal geometry; his life and career were no less unusual than the structures he discovered, and he has often remained a \"monger\" in the eyes of an academic establishment.\n\n==Early life==The family of Benoua Mandelbrot was born on November 20, 1924 in Warsaw, Poland, in the family of Lithuanian Jews.The family: His mother, Bella Lurier, was a doctor, and his father, Carl Mandelbrot, was involved in the clothing trade.Moving to France: In 1936, the family emigrated from Poland to France and settled in Paris, in anticipation of a threat from Nazi Germany.\n\nThe family's life changed dramatically during World War II. The escape from war: After the occupation of Mandelbrots fled to the south of France, to the town of Tuhl. Benoua went to school there, but his progress was modest. By the age of 16, he was reported to have barely known the alphabet and the multiplication table to five.Spatial imagination: Despite difficulties with traditional learning, Mandelbrot has a remarkable mathematical gift based on spatial imagination, which could solve algebraic problems geometrically, which was very unusual. Education: After the war, 1945-1947, he entered a prestigious Polytechnic School in Paris, where he studied from mathematicians such as Gaston Julia and Paul Levy.He then moved to the United States and received a master's degree in aeronauticals from the California Institute of Technology (1947–1949).\n\nThe journey in science: from the outcast to the father of the fractals, his career was untrivial, crossing the boundaries of disciplines. Early years and family: from 1949 to 1958, he worked at the National Research Centre (CNRS) in France, and spent a year at the Princeton Institute of Advanced Studies, where he was mentored by John von Neyman, and married Alette Kagan in 1955.IBM (1958): In 1958, Mandelbrot permanently moved to the United States and began working at the IBM research centre in Yorktown. IBM gave him ideal conditions: access to powerful computers and freedom to engage in fundamental research far beyond the company's applications.Interdisciplinary: While working at IBM, he actively explored linguistics, game theory, economics, aeronautics, geography, physiology, astronomy and physics, and his approach was intuitive, \"I followed my instincts...\"\n\n==History==The main discoveries and legacy of Mandelbrot's key ideas were born at the interface of science.The question of the length of the coastline: In 1967, he published an article entitled \"What is the length of the British coast?\", which became the starting point of his theory. He showed that the length of the coast depended on the extent of the measurement, a fact that could be described by a new kind of geometry.Fractus is \"broken, broken\" to describe geometric figures that have a characteristic of self-likeness (each part repeats the whole). \"Fractal geometry of nature\" (1982): His main book. He formulated a new view of nature: \"The clouds are not spheres, mountains are not cones, coastlines are not circles...\", proving that fractals are not mathematical chickens, but the fundamental principle of the world.Many Mandelbrots: Using IBM computers, he visualized the famous crowd that now bears his name, although he was studied before him (Pier Fatou, Gaston Julia), it was Mandelbrot, using computer graphics, that showed his incredible beauty and complexity, making him the most famous fractal in the world.\n\n===Recent years and recognition===In 1987, Mandelbrot left IBM and began teaching at Yale University, where, at the age of 75, he received his first permanent position as Sterling Professor of Mathematics, and received many awards, including the Wolf Prize for Physics (1993) and the Japan Prize (2003). (2003) Benoua Mandelbrot died on 14 October 2010 in Cambridge, Massachusetts, from pancreatic cancer.His life is a story about how unorthodox thinking, courage, and unique imagination can not only reveal a new field of science, but also change our perception of the world around us."
  interestingFactsRu: "\u0411\u0435\u043d\u0443\u0430 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043f\u043e\u043b\u043d\u044b\u043c
    \u0437\u0430\u0433\u0430\u0434\u043e\u043a \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0445
    \u0447\u0435\u0440\u0442. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445, \u0430 \u043f\u043e\u0440\u043e\u0439
    \u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439.\n\n\U0001F9E9
    \"\u0424\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u043e\u0435\" \u0438\u043c\u044f:
    \u0421\u0435\u043a\u0440\u0435\u0442 \u0431\u0443\u043a\u0432\u044b \"\u0411\" \u041f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0443\u0440\u044c\u0451\u0437
    \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c.
    \u041f\u043e\u043b\u043d\u043e\u0435 \u0438\u043c\u044f \u0443\u0447\u0451\u043d\u043e\u0433\u043e
    \u2014 \u0411\u0435\u043d\u0443\u0430 \u0411. \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442.
    \u0418\u043d\u0438\u0446\u0438\u0430\u043b \"\u0411.\" \u0432 \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0441\u0430\u043c \u0434\u043e\u0431\u0430\u0432\u0438\u043b,
    \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c
    \u043a\u0430\u043a\u043e\u0433\u043e-\u043b\u0438\u0431\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0433\u043e
    \u0438\u043c\u0435\u043d\u0438. \u042d\u0442\u043e \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0448\u0443\u0442\u043a\u0443,
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0449\u0443\u044e
    \u0441\u0443\u0442\u044c \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f.
    \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \"\u0427\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442
    \u0441\u0440\u0435\u0434\u043d\u044f\u044f \u0431\u0443\u043a\u0432\u0430 \u00ab\u0411\u00bb
    \u0432 \u0438\u043c\u0435\u043d\u0438 \u0411\u0435\u043d\u0443\u0430 \u0411. \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430?\"
    \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043e\u0442\u0432\u0435\u0442: \"\u0411\u0435\u043d\u0443\u0430
    \u0411. \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\". \u0422\u0430\u043a
    \u0435\u0433\u043e \u0438\u043c\u044f \u0441\u0442\u0430\u043b\u043e \u0440\u0435\u043a\u0443\u0440\u0441\u0438\u0432\u043d\u044b\u043c
    \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u043e\u043c: \u0447\u0430\u0441\u0442\u044c \u0438\u043c\u0435\u043d\u0438
    (\"\u0411.\") \u043e\u0442\u0441\u044b\u043b\u0430\u0435\u0442 \u043a \u0446\u0435\u043b\u043e\u043c\u0443,
    \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u0443\u044e
    \u043f\u0435\u0442\u043b\u044e \u0441\u0430\u043c\u043e\u043f\u043e\u0434\u043e\u0431\u0438\u044f.\n\n\U0001F9E0
    \u042d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438
    \u0438 \"\u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0435
    \u0445\u0443\u043b\u0438\u0433\u0430\u043d\u0441\u0442\u0432\u043e\" \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c
    \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435\u043c
    \u0438 \u043d\u0435\u0443\u0441\u0442\u0443\u043f\u0447\u0438\u0432\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c.
    \u0411\u043e\u0440\u0435\u0446 \u0441 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c\u0438:
    \u041e\u043d \u0442\u0435\u0440\u043f\u0435\u0442\u044c \u043d\u0435 \u043c\u043e\u0433
    \u0443\u0437\u043a\u0443\u044e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e
    \u0438 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0432\u043e\u0438\u043c \u0438\u043d\u0441\u0442\u0438\u043d\u043a\u0442\u0430\u043c.
    \u041e\u043d \u043c\u043e\u0433 \u0431\u0440\u043e\u0441\u0438\u0442\u044c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u0442\u044c\u0441\u044f \u0432 \u043d\u043e\u0432\u0443\u044e
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u0433\u0434\u0435 \u043e\u043d \u043d\u0438\u0447\u0435\u0433\u043e
    \u043d\u0435 \u0437\u043d\u0430\u043b. \u0415\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u0447\u0430\u0441\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438 \u0435\u043c\u0443:
    \"\u041e\u0441\u0442\u0435\u043f\u0435\u043d\u0438\u0441\u044c, \u043e\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f
    \u0432 \u043e\u0434\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438\", \u043d\u043e
    \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u044c \u043e\u0442 \u043e\u0434\u043d\u043e\u0433\u043e
    \u043a \u0434\u0440\u0443\u0433\u043e\u043c\u0443. \u041d\u0435\u0443\u0434\u043e\u0431\u043d\u044b\u0439
    \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440: \u041e\u0434\u043d\u0430\u0436\u0434\u044b,
    \u043d\u0430\u0445\u043e\u0434\u044f\u0441\u044c \u0432 \u0442\u0430\u043a\u0441\u0438 \u0432
    \u041c\u0430\u043d\u0445\u044d\u0442\u0442\u0435\u043d\u0435, \u043e\u043d \u043f\u0440\u0438\u043d\u044f\u043b\u0441\u044f
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u043c\u0430\u0440\u0448\u0440\u0443\u0442
    \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f. \u041d\u0430 \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u0435,
    \u0447\u0442\u043e \u043e\u043d \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f \u0440\u0435\u0448\u0438\u0442\u044c
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043a\u043e\u043c\u043c\u0438\u0432\u043e\u044f\u0436\u0451\u0440\u0430
    \u043d\u0430 \u0437\u0430\u0434\u043d\u0435\u043c \u0441\u0438\u0434\u0435\u043d\u044c\u0435,
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u0440\u0430\u0441\u0441\u043c\u0435\u044f\u043b\u0441\u044f
    \u0438 \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \"\u042f \u0443\u0436\u0435 \u0440\u0435\u0448\u0438\u043b
    \u0435\u0451\". \u0415\u0433\u043e \u0434\u0435\u0432\u0438\u0437\u043e\u043c \u0431\u044b\u043b\u043e
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \"\u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435\" \u0441 \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u043e\u043c
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439. \u0411\u0443\u043d\u0442\u0430\u0440\u044c
    \u043e\u0442 \u043d\u0430\u0443\u043a\u0438: \u041e\u043d \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e
    \u0441\u043f\u043e\u0440\u0438\u043b \u0441 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u0441\u0442\u0435\u0431\u043b\u0438\u0448\u043c\u0435\u043d\u0442\u043e\u043c, \u0437\u0430
    \u0447\u0442\u043e \u0435\u0433\u043e \"\u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e
    \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u044f\u043b\u0438, \u0433\u043e\u0432\u043e\u0440\u044f,
    \u0447\u0442\u043e \u0442\u043e, \u0447\u0442\u043e \u044f \u0434\u0435\u043b\u0430\u044e,
    \u2014 \u044d\u0442\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b\". \u0421\u0432\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u0432 IBM \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043a\u0430\u043a \u0431\u0430\u0437\u0443 \u0434\u043b\u044f \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e\u0431\u044b \"\u0434\u0440\u0430\u0437\u043d\u0438\u0442\u044c \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0435\u0440\u043d\u044b\u0435
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u043e\u0441\u044b\"
    \u0438 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u044e
    \u043f\u0440\u0430\u0432\u043e\u0442\u0443 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u043f\u043e\u043b\u0443\u0432\u0435\u043a\u0430.\n\n\U0001F3AD \u0424\u0440\u0430\u043a\u0442\u0430\u043b\u044b
    \u0432 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435, \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435
    \u0438 \u0437\u0430 \u0435\u0451 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438
    \u0418\u0434\u0435\u0438 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430
    \u0431\u044b\u0441\u0442\u0440\u043e \u0432\u044b\u0448\u043b\u0438 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b
    \u0441\u0443\u0445\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043d\u0430\u0448\u043b\u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0435
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435: \u041f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c
    \u043a\u0440\u0430\u0445\u043e\u0432: \u0415\u0449\u0451 \u0432 1962 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u043e\u0434\u0435\u043b\u0438
    \u0423\u043e\u043b\u043b-\u0441\u0442\u0440\u0438\u0442 \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u044b
    \u0438 \u043f\u0440\u0438\u0432\u0435\u0434\u0443\u0442 \u043a \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u043c
    \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0430\u043c. \u0415\u0433\u043e \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u0430
    \u0441\u0431\u044b\u043b\u0438\u0441\u044c \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0440\u0430\u0445\u043e\u0432
    1987 \u0438 2008 \u0433\u043e\u0434\u043e\u0432. \u0417\u0432\u0435\u0437\u0434\u0430 \u043f\u043e\u043f-\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b:
    \u0421\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0438\u043c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430
    \u0441 \u0438\u0445 \u044f\u0440\u043a\u0438\u043c\u0438 \u0446\u0432\u0435\u0442\u0430\u043c\u0438
    \u0438 \u0437\u0430\u0432\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u044e\u0449\u0435\u0439
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u0442\u0430\u043b\u0438
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \"\u043f\u043e\u043f-\u0430\u0440\u0442\u0430\"
    1970-\u0445 \u0438 1980-\u0445 \u0433\u043e\u0434\u043e\u0432. \u041e\u043d\u0438 \u0443\u043a\u0440\u0430\u0448\u0430\u043b\u0438
    \u0437\u0430\u0441\u0442\u0430\u0432\u043a\u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432,
    \u0444\u0443\u0442\u0431\u043e\u043b\u043a\u0438 \u0438 \u0434\u0430\u0436\u0435 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u043b\u0438
    \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u043f\u0435\u0446\u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432
    \u0432 \u043a\u0438\u043d\u043e (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0434\u043b\u044f
    \"\u0417\u0432\u0451\u0437\u0434\u043d\u044b\u0445 \u0432\u043e\u0439\u043d\"). \u041a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u0439
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d: \u0415\u043c\u0443 \u0434\u0430\u0436\u0435
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b\u0438 \u043f\u0435\u0441\u043d\u044e. \u0410\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439
    \u0430\u0432\u0442\u043e\u0440 \u0438 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c
    \u0414\u0436\u043e\u043d\u0430\u0442\u0430\u043d \u041a\u043e\u043b\u0442\u043e\u043d \u0441\u043e\u0447\u0438\u043d\u0438\u043b
    \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0446\u0438\u044e \"\u041c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442\u0430\", \u0432 \u043e\u0434\u043d\u043e\u043c
    \u0438\u0437 \u043a\u0443\u043f\u043b\u0435\u0442\u043e\u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0435\u0441\u0442\u044c \u0442\u0430\u043a\u0438\u0435 \u0441\u0442\u0440\u043e\u043a\u0438:
    > \"\u041c\u0430\u043d\u0434\u0435\u043b\u044c\u0431\u0440\u043e\u0442 \u043d\u0430 \u043d\u0435\u0431\u0435\u0441\u0430\u0445.
    > \u041e\u043d \u0432\u0435\u043b\u0435\u043b \u043d\u0430\u043c \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c\u0441\u044f
    \u0438\u0437 \u0445\u0430\u043e\u0441\u0430...\"\n\n\U0001F4DA \u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438
    \u043a\u0443\u0440\u044c\u0451\u0437\u043e\u0432 \u0412\u0441\u0435 \u044d\u0442\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0441\u043e\u0431\u0440\u0430\u043d\u044b \u0438\u0437 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0441\u0442\u0430\u0442\u0435\u0439 \u0438 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043d\u0435\u043a\u0440\u043e\u043b\u043e\u0433\u0438
    \u0432 \u0413\u0430\u0437\u0435\u0442\u0430.Ru, \u0434\u0430\u043d\u043d\u044b\u0435 \u0412\u0438\u043a\u0438\u043f\u0435\u0434\u0438\u0438,
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0436\u0443\u0440\u043d\u0430\u043b\u043e\u0432 \u0438 \u0434\u0430\u0436\u0435 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u043c\u0435\u043c\u044b, \u043e\u0431\u044b\u0433\u0440\u044b\u0432\u0430\u044e\u0449\u0438\u0435
    \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u0440\u0438\u0440\u043e\u0434\u0443
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0438."
  interestingFactsEn: "Benoit Mandelbrot was not just a genius mathematician, but a man full of mystery and eccentric features, and his life and creativity were left behind by a lot of amazing and sometimes funny stories.\n\nThe secret to the letter \"B\" is probably the most famous smoker with his name. The full name of the scientist is Benoua B. Mandelbrot. The initial \"B.\" in his name, which he himself added, is not a reduction of any particular name. This gave rise to a famous joke that perfectly illustrated the essence of his discovery. The question \"What does the middle letter \"B\" mean in the name of Benoua B. Mandelbrot?\" is the answer: \"Benua B. Mandelbrot\".So his name became a recursive fractal: a part of his name (B.) refers to the whole, creating an endless loop of self - resemblance.\n\nMandelbrot was known for his unorthodox thinking and uncooperative character, a rules fighter: he hated a narrow specialization and followed only his instincts. He could drop the research in the middle to sink into a new area where he knew nothing.His colleagues often told him, \"Stay in one area,\" but he was just forced to move from one to another.He was publicly arguing with an academic institution, for which he was \"publicly insulted by saying that what I'm doing is an intellectual scandal.\" He used his work at IBM as a basis for \"disguising arrogant academic noses\" and proving himself right for half a century.\n\n♪ Fractals in art, economics, and beyond Mandelbrot's Idea quickly went beyond dry mathematics and found unexpected applications: The Destroyer: Back in 1962, he claimed that Wall Street's mathematical models were wrong and would lead to financial disasters. His prophecies came true during the 1987 and 2008 collapses.The pop culture star: his images of the multitude of Mandelbrots with their bright colors and enveloping complexity have become the symbol of \"pop art\" in the 1970s and 1980s, and they have decorated the content of computers, T-shirts, and even inspired special effect makers in movies (for example, for \"Star Wars\").American author and performer Jonathan Colton composed \"The Mandelbrot's Multiple\" in a verse that says, > \"Mandelbrot in Heaven.\" > He told us to get out of chaos...\"\n\nThe sources of the chickens All these stories are collected from various articles and interviews, including obituaries in the newspaper.Ru, Wikipedia data, scientific journals and even popular Internet memes that beat the fractal nature of his name."
