    \u0432 \u0447\u0435\u0441\u0442\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u0430
    \u0433\u043e\u0440\u0430. \u0420\u0430\u0437\u043d\u0438\u0446\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0430 \u0443\u0447\u0451\u043d\u043e\u0433\u043e:
    \u043d\u0430 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u0414\u0436\u043e\u0440\u0434\u0436\u0443
    \u0431\u044b\u043b\u043e 35, \u0430 \u041c\u044d\u0440\u0438 \u0432\u0441\u0435\u0433\u043e
