    \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f \u0443\u0441\u0443\u0433\u0443\u0431\u0438\u043b\u0430\u0441\u044c
    \u0444\u0430\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0448\u0438\u0431\u043a\u043e\u0439:
    \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u041c\u044d\u0440\u0438, \u0443\u0432\u043b\u0435\u043a\u0430\u0432\u0448\u0430\u044f\u0441\u044f
    \u0433\u043e\u043c\u0435\u043e\u043f\u0430\u0442\u0438\u0435\u0439, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b\u0430
    \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0441\u0432\u043e\u0435\u0433\u043e
    \u043c\u0443\u0436\u0430 \u043c\u0435\u0442\u043e\u0434 \u0437\u0430\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043d\u0438\u044f
    \u0432 \u0445\u043e\u043b\u043e\u0434\u043d\u044b\u0435 \u043c\u043e\u043a\u0440\u044b\u0435
    \u043f\u0440\u043e\u0441\u0442\u044b\u043d\u0438. \u042d\u0442\u043e \u00ab\u043b\u0435\u0447\u0435\u043d\u0438\u0435\u00bb
    \u043b\u0438\u0448\u044c \u0443\u0441\u043a\u043e\u0440\u0438\u043b\u043e \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u0441\u0445\u043e\u0434. 8 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1864 \u0433\u043e\u0434\u0430,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 49 \u043b\u0435\u0442, \u0414\u0436\u043e\u0440\u0434\u0436
    \u0411\u0443\u043b\u044c \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f.\n\n\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0416\u0438\u0437\u043d\u044c \u043f\u043e\u0441\u043b\u0435 \u0411\u0443\u043b\u044f \u0438
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0434\u043e\u0447\u0435\u0440\u0438
    \u0421\u043c\u0435\u0440\u0442\u044c \u043c\u0443\u0436\u0430 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430
    \u041c\u044d\u0440\u0438 \u0441 \u043f\u044f\u0442\u044c\u044e \u0434\u043e\u0447\u0435\u0440\u044c\u043c\u0438
    \u043d\u0430 \u0440\u0443\u043a\u0430\u0445, \u0441\u0442\u0430\u0440\u0448\u0435\u0439
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0431\u044b\u043b\u043e \u0432\u043e\u0441\u0435\u043c\u044c
    \u043b\u0435\u0442, \u0430 \u043c\u043b\u0430\u0434\u0448\u0435\u0439 \u2014 \u0432\u0441\u0435\u0433\u043e
    \u0448\u0435\u0441\u0442\u044c \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u0438 \u0431\u0435\u0437
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u043a \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044e.
    \u0414\u0440\u0443\u0437\u044c\u044f \u043c\u0443\u0436\u0430 \u0441\u043c\u043e\u0433\u043b\u0438
    \u0432\u044b\u0445\u043b\u043e\u043f\u043e\u0442\u0430\u0442\u044c \u0435\u0439 \u043b\u0438\u0448\u044c
    \u043a\u0440\u043e\u0445\u043e\u0442\u043d\u0443\u044e \u043f\u0435\u043d\u0441\u0438\u044e.
    \u0427\u0442\u043e\u0431\u044b \u0432\u044b\u0436\u0438\u0442\u044c, \u041c\u044d\u0440\u0438
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u0441 \u0441\u0435\u043c\u044c\u0451\u0439
    \u0432 \u041b\u043e\u043d\u0434\u043e\u043d, \u0433\u0434\u0435 \u0443\u0441\u0442\u0440\u043e\u0438\u043b\u0430\u0441\u044c
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430\u0440\u0435\u043c \u0432 \u043f\u0435\u0440\u0432\u044b\u0439
    \u0436\u0435\u043d\u0441\u043a\u0438\u0439 \u043a\u043e\u043b\u043b\u0435\u0434\u0436 \u0438
    \u0434\u0430\u0432\u0430\u043b\u0430 \u0447\u0430\u0441\u0442\u043d\u044b\u0435 \u0443\u0440\u043e\u043a\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043a\u0440\u0430\u0439\u043d\u044e\u044e \u043d\u0443\u0436\u0434\u0443,
    \u0436\u0438\u0437\u043d\u044c \u0432 \u043a\u0440\u043e\u0445\u043e\u0442\u043d\u043e\u0439
    \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u043a\u0435 \u0438 \u043f\u0440\u043e\u0434\u0430\u0436\u0443
    \u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u043c\u0435\u0434\u0430\u043b\u0438 \u043c\u0443\u0436\u0430,
    \u0447\u0442\u043e\u0431\u044b \u043a\u0443\u043f\u0438\u0442\u044c \u0434\u0435\u0442\u044f\u043c
    \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442,
    \u041c\u044d\u0440\u0438 \u0441\u0443\u043c\u0435\u043b\u0430 \u0434\u0430\u0442\u044c \u0434\u043e\u0447\u0435\u0440\u044f\u043c
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.
    \u0412\u0441\u0435 \u043f\u044f\u0442\u044c \u0434\u043e\u0447\u0435\u0440\u0435\u0439 \u0411\u0443\u043b\u044f
    \u0441\u0442\u0430\u043b\u0438 \u043d\u0435\u0437\u0430\u0443\u0440\u044f\u0434\u043d\u044b\u043c\u0438
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044f\u043c\u0438: \u041c\u044d\u0440\u0438 \u042d\u043b\u043b\u0435\u043d
    (\u0441\u0442\u0430\u0440\u0448\u0430\u044f \u0434\u043e\u0447\u044c) \u0432\u044b\u0448\u043b\u0430
    \u0437\u0430\u043c\u0443\u0436 \u0437\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0438 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044f \u0427\u0430\u0440\u043b\u044c\u0437\u0430
    \u0413\u043e\u0432\u0430\u0440\u0434\u0430 \u0425\u0438\u043d\u0442\u043e\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c\u0438
    \u0438\u0434\u0435\u044f\u043c\u0438 \u043e \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043e\u043c
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438. \u041c\u0430\u0440\u0433\u0430\u0440\u0435\u0442
    \u0441\u0442\u0430\u043b\u0430 \u043c\u0430\u0442\u0435\u0440\u044c\u044e \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u043a\u0430
    \u0414\u0436. \u0418. \u0422\u0435\u0439\u043b\u043e\u0440\u0430. \u0410\u043b\u0438\u0441\u0438\u044f
    (1860\u20131940) \u0441\u0442\u0430\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c-\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u043e\u043c
    \u0438 \u0432\u043d\u0435\u0441\u043b\u0430 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435
    \u0447\u0435\u0442\u044b\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u041b\u044e\u0441\u0438 (1862\u20131904) \u043f\u043e\u0448\u043b\u0430 \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c
    \u043e\u0442\u0446\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443 \u0438 \u0441\u0442\u0430\u043b\u0430
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0445\u0438\u043c\u0438\u0438.
    \u042d\u0442\u0435\u043b\u044c \u041b\u0438\u043b\u0438\u0430\u043d (1864\u20131960) \u2014
    \u0441\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0438\u0437
    \u0441\u0435\u0441\u0442\u0451\u0440. \u041e\u043d\u0430 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0430\u0441\u044c
    \u043a\u0430\u043a \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430
    \u043f\u043e\u0434 \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c\u043e\u043c \u042d\u0442\u0435\u043b\u044c
    \u041b\u0438\u043b\u0438\u0430\u043d \u0412\u043e\u0439\u043d\u0438\u0447, \u0430\u0432\u0442\u043e\u0440
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u0440\u043e\u043c\u0430\u043d\u0430
    \u00ab\u041e\u0432\u043e\u0434\u00bb. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u043c\u0443\u0436\u0435\u043c
    \u0437\u0430 \u041c\u0438\u0445\u0430\u0438\u043b\u043e\u043c \u0412\u043e\u0439\u043d\u0438\u0447\u0435\u043c,
    \u043f\u0435\u0440\u0432\u043e\u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u00ab\u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438
    \u0412\u043e\u0439\u043d\u0438\u0447\u0430\u00bb. \u0421\u0430\u043c \u0414\u0436\u043e\u0440\u0434\u0436
    \u0411\u0443\u043b\u044c \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0442\u043e\u0440\u043e\u043c. \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u0431\u0435\u0434\u043d\u044b\u043c, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u0432\u0435\u0447\u0435\u0440\u043d\u0435\u0439 \u0448\u043a\u043e\u043b\u0435 \u0434\u043b\u044f
    \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438, \u043f\u043e\u043c\u043e\u0433\u0430\u0432\u0448\u0438\u0435
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430\u043c \u043d\u0430\u0439\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u0443.
    \u042d\u0442\u0438 \u0447\u0435\u0440\u0442\u044b \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430
    \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438
    \u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u044c \u0438 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u0438
    \u0434\u043e\u0447\u0435\u0440\u0438 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438 \u043f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438."
  personalLifeEn: "George Bull's personal life, despite her external decency, was filled with deep and unusual affections, tragic circumstances and left a remarkable legacy in the face of his wife and daughters.\n\n==Recognition and marriage==In 1849, he received a professorship in Queen's College in Irish Cork, George Boul, who was already in his 30 ' s, and met the family of his colleague, Professor of Greek Philology, where he met the niece of Professor Mary Everest, who was the niece of the famous geographer Sir George Everest, who was named after the mountain.The difference in age did not stop the scientist: George was then 35, and Mary was only 17 years old, and Bull, impressed by her mathematical abilities, began to give her private lessons, which eventually grew into deep mutual affection, but Bull was long overdue in making an offer, considering the difference in age as a major obstacle.The marriage was not concluded until 1855, after Mary's father died, who was opposed to the union. Despite all doubts, their marriage proved to be happy. Mary herself will later call nine years of shared life \"light sleep\".\n\nTheir first child, Margaret's daughter, was born nine months after the wedding, and Beauul was very excited and loving about his fatherhood and was described as a loving husband and a devoted father who devoted himself entirely to the family.The people of Bull described him as a man of almost impeccable behavior, generous, responsive, and always willing to come to the aid, complementing the image of a perfect family man, with five daughters born to the couple.\n\nThe tragic death of the family ended in late November 1864. On his way to college, George Boul fell under heavy heavy rain and, as he was faithful to his duty, gave all the lectures without removing wet clothes. This resulted in a severe cold that turned into an inflammation of the lungs.Tragedy was compounded by a fatal mistake: his wife Mary, who had a history of homopathy, used the method of wrapping her husband in cold wet sheets to treat her husband. This \"treatment\" only accelerated the tragic outcome. On 8 December 1864, at the age of 49, George Boul died.\n\nAfter Bull and her distinguished daughters, her husband's death left Mary with five daughters in her arms, the oldest of whom was eight years old and the youngest only six months, and no means of subsistence. The husband's friends were only able to make her a tiny pension. To survive, Mary moved with her family to London, where she was a librarian at the first female college and gave her private math classes.Despite extreme need, living in a tiny apartment and selling a husband's gold medal to buy children a musical instrument, Mary was able to give her daughters a brilliant education. All five of her daughters, Bull, became extraordinary individuals: Mary Ellen (the eldest daughter) married mathematician and writer Charles Howard Hinton, who was famous for her ideas of the fourth dimension. Margaret became the mother of outstanding mathematician and physicist J. I. Taylor.Alicia (1860–1940) became a famous mathematician geometer and contributed to the study of four-dimensional geometry. Lucy (1862–1904) followed in her father's footsteps in science and became a professor of chemistry. Ethel Lillian (1864–1960), the most famous sister, was famous as a writer under the pseudonym Ethel Lillian Voinich, author of the famous novel \"Ovod.\" She was married to Michael Voinich, the pioneer of the famous \"Woynich Book\".George Boul himself was a deeply believing man and a social reformer who actively helped the poor, taught at evening adult school, and supported organizations that helped women find work, and these characteristics of character largely determined the persistence and autonomy that his wife and daughters showed after his death."
  shortBioRu: "\u0414\u0436\u043e\u0440\u0434\u0436 \u0411\u0443\u043b\u044c (1815\u20131864) \u2014 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0438 \u043b\u043e\u0433\u0438\u043a,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438
    \u0438, \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c \u0441\u0447\u0451\u0442\u0435,
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u2014 \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0441\u0430\u043c\u043e\u0443\u0447\u043a\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0433\u0435\u043d\u0438\u044e \u0438 \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u0443
    \u0441\u0442\u0430\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0438 \u0447\u043b\u0435\u043d\u043e\u043c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.\n\n\U0001F4DC \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043f\u0443\u0442\u044c \u043a \u0437\u043d\u0430\u043d\u0438\u044f\u043c
    \u0414\u0436\u043e\u0440\u0434\u0436 \u0411\u0443\u043b\u044c \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    2 \u043d\u043e\u044f\u0431\u0440\u044f 1815 \u0433\u043e\u0434\u0430 \u0432 \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0435,
    \u0410\u043d\u0433\u043b\u0438\u044f, \u0432 \u0441\u0435\u043c\u044c\u0435 \u043d\u0435\u0431\u043e\u0433\u0430\u0442\u043e\u0433\u043e
    \u0441\u0430\u043f\u043e\u0436\u043d\u0438\u043a\u0430 \u0414\u0436\u043e\u043d\u0430 \u0411\u0443\u043b\u044f.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0435
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043e\u0442\u0435\u0446, \u0443\u0432\u043b\u0435\u043a\u0430\u0432\u0448\u0438\u0439\u0441\u044f
    \u043d\u0430\u0443\u043a\u043e\u0439, \u0434\u0430\u043b \u0441\u044b\u043d\u0443 \u043f\u0435\u0440\u0432\u044b\u0435
    \u0443\u0440\u043e\u043a\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043e\u0431\u0443\u0447\u0438\u043b \u0435\u0433\u043e \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044e
    \u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432.
    \u0418\u0437-\u0437\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0445 \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0435\u0439
    \u0441\u0435\u043c\u044c\u0438 \u0411\u0443\u043b\u044c \u043d\u0435 \u0441\u043c\u043e\u0433
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u043e\u043a\u043e\u043d\u0447\u0438\u0432
    \u043b\u0438\u0448\u044c \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443.
    \u0421 16 \u043b\u0435\u0442 \u043e\u043d \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u0432 \u0414\u043e\u043d\u043a\u0430\u0441\u0442\u0435\u0440\u0435,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c
    \u0441\u0435\u043c\u044c\u044e. \u041e\u0434\u043d\u0430\u043a\u043e \u0436\u0430\u0436\u0434\u0430
    \u0437\u043d\u0430\u043d\u0438\u0439 \u0443 \u0411\u0443\u043b\u044f \u0431\u044b\u043b\u0430
    \u043e\u0433\u0440\u043e\u043c\u043d\u0430. \u041e\u043d \u0431\u044b\u043b \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0432\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434\u043e\u043c: \u043a 12 \u0433\u043e\u0434\u0430\u043c
    \u043e\u043d \u0443\u0436\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u043b \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0443\u044e
    \u043f\u043e\u044d\u0437\u0438\u044e, \u0430 \u043a 14 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e
    \u0432\u043b\u0430\u0434\u0435\u043b \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c,
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c, \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u043c
    \u0438 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c \u044f\u0437\u044b\u043a\u0430\u043c\u0438.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e. \u0412
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u043d
    \u0447\u0438\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0436\u0443\u0440\u043d\u0430\u043b\u044b \u0432 \u041c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0430,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u041d\u044c\u044e\u0442\u043e\u043d\u0430, \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0438 \u041b\u0430\u043f\u043b\u0430\u0441\u0430. \u0415\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442
    \u0432 \u0432\u044b\u0441\u0448\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u043b\u0438\u0448\u044c \u0432 17
    \u043b\u0435\u0442, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438 \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e.
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 20 \u043b\u0435\u0442 \u043e\u043d
    \u043e\u0442\u043a\u0440\u044b\u043b \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0435.\n\n\u2797
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438
    \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u041d\u0435 \u0438\u043c\u0435\u044f
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u043e\u0433\u043e
    \u0434\u0438\u043f\u043b\u043e\u043c\u0430, \u0411\u0443\u043b\u044c \u043d\u0430\u0447\u0430\u043b
    \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0436\u0443\u0440\u043d\u0430\u043b\u0430\u0445.
    \u041f\u0435\u0440\u0432\u044b\u0435 \u0443\u0441\u043f\u0435\u0445\u0438: \u0412 1839 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e
    \u043f\u0435\u0440\u0432\u0443\u044e \u0441\u0442\u0430\u0442\u044c\u044e \u00ab\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439\u00bb
    \u0432 \u00ab\u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0436\u0443\u0440\u043d\u0430\u043b\u0435\u00bb. \u0412 1844 \u0433\u043e\u0434\u0443 \u0437\u0430
    \u0440\u0430\u0431\u043e\u0442\u0443 \u00ab\u041e\u0431 \u043e\u0431\u0449\u0435\u043c \u043c\u0435\u0442\u043e\u0434\u0435
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u00bb \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u043c\u0435\u0434\u0430\u043b\u0438
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u0437\u0430 \u0432\u043a\u043b\u0430\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438: \u0412 1847 \u0433\u043e\u0434\u0443 \u0411\u0443\u043b\u044c
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u044d\u043f\u043e\u0445\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u0430\u043c\u0444\u043b\u0435\u0442 \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u043b\u043e\u0433\u0438\u043a\u0438, \u0438\u043b\u0438
    \u041e\u043f\u044b\u0442 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0434\u0435\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0443\u043c\u043e\u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439\u00bb. \u0412
    \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043b\u043e\u0433\u0438\u043a\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0438 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c
    \u0441\u043e\u044e\u0437\u043d\u0438\u0446\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u042d\u0442\u043e \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e \u0435\u043c\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u043b\u043e\u0433\u0438\u043a\u0430
    \u041e\u0433\u0430\u0441\u0442\u0435\u0441\u0430 \u0414\u0435 \u041c\u043e\u0440\u0433\u0430\u043d\u0430.
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0430: \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u044d\u0442\u043e\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0432
    1849 \u0433\u043e\u0434\u0443 \u0411\u0443\u043b\u044c \u0431\u0435\u0437 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u041a\u0443\u0438\u043d\u0437-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435
    \u0432 \u041a\u043e\u0440\u043a\u0435, \u0418\u0440\u043b\u0430\u043d\u0434\u0438\u044f
    (\u043d\u044b\u043d\u0435 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0439
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436 \u041a\u043e\u0440\u043a). \u0413\u043b\u0430\u0432\u043d\u044b\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0441\u0442\u0430\u043b\u0430
    \u043a\u043d\u0438\u0433\u0430 \u00ab\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u0437\u0430\u043a\u043e\u043d\u043e\u0432 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439\u00bb,
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0432
    1854 \u0433\u043e\u0434\u0443. \u0412 \u043d\u0435\u0439 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0437\u0440\u0435\u043b\u043e\u0435 \u0438 \u043f\u043e\u043b\u043d\u043e\u0435 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0435\u0439 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0436\u0435
    \u0441\u0442\u0430\u043d\u0435\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043a\u0430\u043a
    \u0431\u0443\u043b\u0435\u0432\u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u0430. \u0411\u0443\u043b\u044c
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442, \u0433\u0434\u0435 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u044f \u0438 \u043a\u043b\u0430\u0441\u0441\u044b
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438\u0441\u044c
    \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438, \u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438
    \u043d\u0430\u0434 \u043d\u0438\u043c\u0438 (\u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a
    \u0418, \u0418\u041b\u0418, \u041d\u0415) \u2014 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u043c\u0438. \u042d\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c
    \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0441\u0442\u044c \u0438\u043b\u0438 \u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439
    \u043f\u0443\u0442\u0451\u043c \u0447\u0438\u0441\u0442\u043e \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u044f\u0446\u0438\u0439. \u041f\u043e\u043c\u0438\u043c\u043e
    \u043b\u043e\u0433\u0438\u043a\u0438, \u0411\u0443\u043b\u044c \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435:
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445\u00bb (1859) \u0438 \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u043e \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445 \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044f\u0445\u00bb
    (1860), \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e\u043b\u0433\u0438\u0435
    \u0433\u043e\u0434\u044b \u0441\u043b\u0443\u0436\u0438\u043b\u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043f\u043e\u0441\u043e\u0431\u0438\u044f\u043c\u0438.\n\n\U0001F4A1 \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439
    \u043c\u0438\u0440 \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0442\u0440\u0443\u0434\u044b
    \u0411\u0443\u043b\u044f \u0446\u0435\u043d\u0438\u043b\u0438\u0441\u044c \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u0443\u0437\u043a\u0438\u043c \u043a\u0440\u0443\u0433\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u0418\u0445 \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0440\u0430\u0441\u043a\u0440\u044b\u043b\u043e\u0441\u044c \u043f\u043e\u0437\u0436\u0435,
    \u043a\u043e\u0433\u0434\u0430: \u0412 \u043a\u043e\u043d\u0446\u0435 XIX \u0432\u0435\u043a\u0430
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0441\u0442\u0430\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0431\u0443\u043b\u0435\u0432\u0443 \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0434\u043b\u044f
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u0445\u0435\u043c. \u0412 XX \u0432\u0435\u043a\u0435 \u044d\u0442\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0434\u043b\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0445 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432. \u0414\u0432\u043e\u0438\u0447\u043d\u044b\u0439
    \u043a\u043e\u0434, \u043b\u0435\u0436\u0430\u0449\u0438\u0439 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435
    \u0432\u0441\u0435\u0439 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u0438,
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u044b\u043c \u0432\u043e\u043f\u043b\u043e\u0449\u0435\u043d\u0438\u0435\u043c
    \u0431\u0443\u043b\u0435\u0432\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0441\u0435\u043c\u044c\u044f
    \u0412 1855 \u0433\u043e\u0434\u0443 \u0411\u0443\u043b\u044c \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041c\u044d\u0440\u0438 \u042d\u0432\u0435\u0440\u0435\u0441\u0442, \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u0446\u0435
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0430
    \u0441\u044d\u0440\u0430 \u0414\u0436\u043e\u0440\u0434\u0436\u0430 \u042d\u0432\u0435\u0440\u0435\u0441\u0442\u0430,
    \u0432 \u0447\u0435\u0441\u0442\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u0430
    \u0432\u044b\u0441\u043e\u0447\u0430\u0439\u0448\u0430\u044f \u0433\u043e\u0440\u0430 \u043c\u0438\u0440\u0430.
    \u0423 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u043f\u044f\u0442\u044c
    \u0434\u043e\u0447\u0435\u0440\u0435\u0439, \u043a\u0430\u0436\u0434\u0430\u044f \u0438\u0437
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u0442\u0430\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0432 \u0441\u0432\u043e\u0435\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438: \u0410\u043b\u0438\u0441\u0438\u044f (1860\u20131940)
    \u2014 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a-\u0433\u0435\u043e\u043c\u0435\u0442\u0440.
    \u041b\u044e\u0441\u0438 (1862\u20131904) \u2014 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0445\u0438\u043c\u0438\u0438. \u042d\u0442\u0435\u043b\u044c \u041b\u0438\u043b\u0438\u0430\u043d
    (1864\u20131960) \u2014 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043a\u0430\u043a \u0430\u0432\u0442\u043e\u0440
    \u0440\u043e\u043c\u0430\u043d\u0430 \u00ab\u041e\u0432\u043e\u0434\u00bb (\u043f\u043e\u0434
    \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c\u043e\u043c \u042d\u0442\u0435\u043b\u044c
    \u041b\u0438\u043b\u0438\u0430\u043d \u0412\u043e\u0439\u043d\u0438\u0447).\n\n\U0001F4D6
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043f\u0430\u043c\u044f\u0442\u044c
    \u0414\u0436\u043e\u0440\u0434\u0436 \u0411\u0443\u043b\u044c \u0443\u043c\u0435\u0440 8
    \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1864 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    49 \u043b\u0435\u0442 \u043e\u0442 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f
    \u043b\u0435\u0433\u043a\u0438\u0445. \u041e\u043d \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0438\u043b\u0441\u044f,
    \u043a\u043e\u0433\u0434\u0430 \u0432 \u043f\u0440\u043e\u043c\u043e\u043a\u0448\u0435\u0439
    \u043e\u0434\u0435\u0436\u0434\u0435 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u044e
    \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043f\u043e\u043f\u0430\u043b
    \u043f\u043e\u0434 \u043f\u0440\u043e\u043b\u0438\u0432\u043d\u043e\u0439 \u0434\u043e\u0436\u0434\u044c
    \u043f\u043e \u043f\u0443\u0442\u0438 \u0432 \u043a\u043e\u043b\u043b\u0435\u0434\u0436.
    \u0412 \u0447\u0435\u0441\u0442\u044c \u0414\u0436\u043e\u0440\u0434\u0436\u0430 \u0411\u0443\u043b\u044f
    \u043d\u0430\u0437\u0432\u0430\u043d \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435,
    \u0430 \u0435\u0433\u043e \u0438\u043c\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043a\u0430\u043a \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0446\u0438\u0444\u0440\u043e\u0432\u0430\u044f \u044d\u043f\u043e\u0445\u0430."
  shortBioEn: "George Boul (1815–1864) is an English mathematician whose work has laid the foundation for modern mathematical logic and, ultimately, informatics, and his life course is a remarkable story of self-scientific science, which, thanks to its genius and persistence, has become a recognized professor and member of the Royal Society.\n\n==Early years and the journey to knowledge==George Boul was born on November 2, 1815 in Lincoln, England, in the family of the unrich cobbler John Bull.From the age of 16, he had to work as a teacher's assistant at a private school in Doncaster to support his family, but Bull's thirst for knowledge was enormous, and he was a linguistic wunderkind: by the age of 12, he had already translated Latin poetry, and by the age of 14, he was fluent in Greek, French, German and Italian.In his spare time, he read the mathematical magazines at Lincoln Institute of Mechanical Engineering, as well as the fundamental works of Newton, Lagrang and Laplaces, and his talent in higher mathematics was not revealed until he was 17 years old when he was introduced to the work of differential and integrated calculation, and at the age of 20 he opened his own school in Lincoln.\n\n==Career========Career========Career====In 1839, he published his first article, \"Research on the theory of analytical change\", in the Cambridge Mathematical Journal.==In 1844, he was awarded the first gold medal by the Royal Society for his contribution to mathematics for his work on the Common Method of Analysis.The birth of mathematical logic: In 1847, Bouhl published an epic pamphlet, \"Mathematic analysis of logic, or experience in calculating deductive reasoning\", in which he made it clear that logic can and should be an ally of mathematics, not just philosophy, and that it has given him recognition of the well-known logic of Augustes de Morgan.Prof.: This publication led to Bool being promoted to a post of Mathematics Professor in Queens College in Cork, Ireland (now Cork University College) in 1849, and his main work was the book Researching the Laws of Thinking on which the mathematical theories of logic and probabilities are based, published in 1854.In it, he presented a mature and complete statement of his symbolic logic, which will later be known as the algebra boulder, and Bull developed a mathematical tool where the logical expressions and classes of objects were represented by symbols and their operations (such as I, OR, NE) by algebraic actions, which enabled us to determine the authenticity or perjury of complex statements through purely symbolic manipulation.In addition to logic, Bouhl wrote fundamental books on mathematics: \"Tactat on differential equations\" (1859) and \"Tactate on end differences\" (1860), which have served as classical aids for years.\n\nThe legacy and influence of modern life The work of Bull was mainly valued by a narrow circle of mathematicians, and its true meaning was revealed later when, at the end of the 19th century, physicists began to use boulder algebra to describe electrical switches. In the 20th century, this mathematical system became fundamental to digital computer design.The binary code underlying all digital technology is a direct expression of bald logic.\n\nIn 1855, they married Mary Everest, the niece of the famous geographer Sir George Everest, who was named the highest mountain in the world, and they had five daughters, each of whom became a known figure in their field: Alicia (1860–1940), a mathematician hegeometer.Ethel Lillian (1864–1960) is a writer and novelist of the novel \"Ovod\" (under the alias Ethel Lillian Voinich).\n\n==Death and memory==On December 8, 1864, George Boul died of lung inflammation at the age of 49. He caught a cold when he gave a lecture in wet clothes after it had rained under heavy rain on his way to college. George Bull was named after the crater on the moon, and his name was forever in history as the creator of a mathematical language spoken by the modern digital age."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0414\u0436\u043e\u0440\u0434\u0436\u0430 \u0411\u0443\u043b\u044f
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0438\u0441\u0443\u044e\u0442 \u0435\u0433\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u043a \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e\u0433\u043e
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e, \u043d\u043e \u043a\u0430\u043a \u043e\u0447\u0435\u043d\u044c
    \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e, \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u043e\u0433\u043e
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u0430\u044f \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0430\u044f
    \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430 \u0444\u0430\u043a\u0442\u043e\u0432 \u043e
    \u043d\u0451\u043c.\n\n\U0001F476 \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043e\u043a \u0438 \u0441\u043a\u0443\u043f\u043e\u0441\u0442\u044c
    \u043d\u0430 \u043a\u043d\u0438\u0433\u0438 \u042e\u043d\u044b\u0439 \u043f\u043e\u043b\u0438\u0433\u043b\u043e\u0442
    \u0438 \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0435 \u0432 \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435:
    \u041a 14 \u0433\u043e\u0434\u0430\u043c \u0411\u0443\u043b\u044c \u0443\u0436\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e
    \u0432\u043b\u0430\u0434\u0435\u043b \u043b\u0430\u0442\u044b\u043d\u044c\u044e, \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c,
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c, \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u043c
    \u0438 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c \u044f\u0437\u044b\u043a\u0430\u043c\u0438.
    \u0415\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0447\u0435\u0432\u0438\u0434\u0435\u043d, \u0447\u0442\u043e, \u043a\u043e\u0433\u0434\u0430
    \u0432 1830 \u0433\u043e\u0434\u0443 \u043c\u0435\u0441\u0442\u043d\u0430\u044f \u0433\u0430\u0437\u0435\u0442\u0430
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0430 \u0435\u0433\u043e
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043e\u044d\u043c\u044b, \u043e\u0434\u0438\u043d \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u044c
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0435\u0433\u043e \u0432 \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435,
    \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u044f\u0441\u044c \u0432\u0435\u0440\u0438\u0442\u044c,
    \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0439 \u0441\u043b\u043e\u0436\u043d\u044b\u0439
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u043c\u043e\u0433 \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043e\u043a. \u042d\u043a\u043e\u043d\u043e\u043c\u0438\u044f
    \u043d\u0430 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435: \u0412 \u044e\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0433\u0434\u0430 \u0411\u0443\u043b\u044c \u043d\u0430\u0447\u0430\u043b \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u044c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439, \u043e\u043d \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e
    \u043f\u043e\u043a\u0443\u043f\u0430\u043b \u0438\u043c\u0435\u043d\u043d\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043d\u0438\u0433\u0438, \u0430 \u043d\u0435 \u0445\u0443\u0434\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443. \u0421\u0432\u043e\u0435\u0439
    \u0436\u0435\u043d\u0435 \u043e\u043d \u043f\u043e\u0437\u0436\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0441\u044f,
    \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u0438\u0437
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439:
    \u043d\u0430 \u043f\u0440\u043e\u0447\u0442\u0435\u043d\u0438\u0435 \u0438 \u0443\u0441\u0432\u043e\u0435\u043d\u0438\u0435
    \u043e\u0434\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0430 \u0443\u0445\u043e\u0434\u0438\u043b\u043e
    \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u0447\u0435\u043c \u043d\u0430 \u0440\u043e\u043c\u0430\u043d \u0438\u043b\u0438 \u043f\u043e\u044d\u043c\u0443.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043e\u043d
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043b \u0434\u0435\u043d\u044c\u0433\u0438, \u0440\u0435\u0436\u0435
    \u043f\u043e\u043a\u0443\u043f\u0430\u044f \u043d\u043e\u0432\u044b\u0435 \u043a\u043d\u0438\u0433\u0438.\n\n\U0001F3EB
    \u0427\u0443\u0434\u0430\u043a\u043e\u0432\u0430\u0442\u044b\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0439 \u0430\u0440\u0442\u0438\u0441\u0442
    \u0423\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u0435 \u0437\u0430 \u0447\u0442\u0435\u043d\u0438\u0435
    \u0432 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0435\u043d\u044c\u0435: \u041d\u0430\u0447\u0430\u0432
    \u0441\u0432\u043e\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u0432 16 \u043b\u0435\u0442, \u0411\u0443\u043b\u044c \u0431\u044b\u043b \u0443\u0432\u043e\u043b\u0435\u043d
    \u0438\u0437 \u043f\u0435\u0440\u0432\u043e\u0439 \u0436\u0435 \u0447\u0430\u0441\u0442\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u0437\u0430... \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0443\u044e
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0441\u0442\u044c. \u0415\u0433\u043e
    \u043f\u0440\u043e\u0432\u0438\u043d\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b
    \u0441\u0435\u0431\u0435 \u0447\u0438\u0442\u0430\u0442\u044c \u043a\u043d\u0438\u0433\u0438
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u043f\u043e \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0435\u043d\u044c\u044f\u043c,
    \u0438 \u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u043e
    \u0432 \u0447\u0430\u0441\u043e\u0432\u043d\u0435. \u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430 \u0438 \u00ab\u043d\u0435\u0438\u0441\u043f\u043e\u0440\u0447\u0435\u043d\u043d\u044b\u0435\u00bb
    \u0434\u0435\u0442\u0438: \u0412 20 \u043b\u0435\u0442 \u043e\u043d \u043e\u0442\u043a\u0440\u044b\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443-\u043f\u0430\u043d\u0441\u0438\u043e\u043d.
    \u0415\u0433\u043e \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0431\u044b\u043b \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435\u043d:
    \u043e\u043d \u0431\u0440\u0430\u043b \u043d\u0430 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0430\u043c\u044b\u0445 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u043e\u0432, \u043f\u043e\u0442\u043e\u043c\u0443
    \u0447\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u043e\u043d\u0438
    \u00ab\u0435\u0449\u0451 \u043d\u0435 \u0438\u0441\u043f\u043e\u0440\u0447\u0435\u043d\u044b
    \u043f\u043b\u043e\u0445\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c\u00bb.
    \u041c\u0430\u0441\u0442\u0435\u0440 \u043f\u043e \u0447\u0430\u0441\u0442\u0438 \u043b\u044c\u0432\u0438\u043d\u043e\u0433\u043e
    \u0440\u044b\u043a\u0430: \u0411\u0443\u043b\u044c \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0435\u043d \u0443 \u0434\u0435\u0442\u0435\u0439
    \u0432 \u0441\u0432\u043e\u0451\u043c \u0440\u043e\u0434\u043d\u043e\u043c \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0435.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438,
    \u0447\u0442\u043e \u0441\u043e\u0441\u0435\u0434\u0441\u043a\u0438\u0435 \u043c\u0430\u043b\u044c\u0447\u0438\u0448\u043a\u0438
    \u0447\u0430\u0441\u0442\u043e \u0437\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u0435\u0433\u043e
    \u043f\u043e\u0438\u0433\u0440\u0430\u0442\u044c \u0441 \u043d\u0438\u043c\u0438. \u0415\u0433\u043e
    \u00ab\u043a\u043e\u0440\u043e\u043d\u043d\u044b\u043c \u043d\u043e\u043c\u0435\u0440\u043e\u043c\u00bb
    \u0431\u044b\u043b\u043e \u0443\u043c\u0435\u043d\u0438\u0435 \u0442\u0430\u043a \u043f\u0440\u0430\u0432\u0434\u043e\u043f\u043e\u0434\u043e\u0431\u043d\u043e
    \u043f\u043e\u0434\u0440\u0430\u0436\u0430\u0442\u044c \u043b\u044c\u0432\u0438\u043d\u043e\u043c\u0443
    \u0440\u044b\u043a\u0443, \u0447\u0442\u043e \u0434\u0435\u0442\u0438 \u0432 \u043f\u0440\u0438\u0442\u0432\u043e\u0440\u043d\u043e\u043c
    \u0443\u0436\u0430\u0441\u0435 \u0440\u0430\u0437\u0431\u0435\u0433\u0430\u043b\u0438\u0441\u044c,
    \u0432\u0438\u0437\u0436\u0430 \u043e\u0442 \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u0430.
    \u042d\u0442\u043e\u0442 \u044d\u043f\u0438\u0437\u043e\u0434 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u044b\u043c \u0443\u0447\u0451\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u043e\u0447\u0435\u043d\u044c \u0436\u0438\u0432\u044b\u043c, \u043b\u044e\u0431\u044f\u0449\u0438\u043c
    \u0434\u0435\u0442\u0435\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c.\n\n\U0001F468\u200d\U0001F467\u200d\U0001F466
    \u0421\u0435\u043c\u044c\u044f, \u043e\u0442\u0440\u0430\u0436\u0451\u043d\u043d\u0430\u044f
    \u0432 \u0432\u0438\u0442\u0440\u0430\u0436\u0435 \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u044f\u043d\u044b\u0445
    \u043b\u043e\u0436\u043a\u0430\u0445 \u0412\u0438\u0442\u0440\u0430\u0436 \u0432 \u0447\u0435\u0441\u0442\u044c
    \u043b\u044e\u0431\u0438\u043c\u043e\u0433\u043e \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u043e\u0433\u043e
    \u0441\u044e\u0436\u0435\u0442\u0430: \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u044b\u0435
    \u0436\u0438\u0442\u0435\u043b\u0438 \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0430
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0446\u0435\u043d\u0438\u043b\u0438
    \u0411\u0443\u043b\u044f, \u0447\u0442\u043e \u0440\u0435\u0448\u0438\u043b\u0438 \u0443\u0432\u0435\u043a\u043e\u0432\u0435\u0447\u0438\u0442\u044c
    \u0435\u0433\u043e \u043f\u0430\u043c\u044f\u0442\u044c \u0432 \u043c\u0435\u0441\u0442\u043d\u043e\u043c
    \u0441\u043e\u0431\u043e\u0440\u0435. \u041d\u0430 \u0432\u0438\u0442\u0440\u0430\u0436\u0435,
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u043c \u0432 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c,
    \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0451\u043d \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0438\u0439
    \u0441\u044e\u0436\u0435\u0442 \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u0440\u043e\u043a\u0430
    \u0421\u0430\u043c\u0443\u0438\u043b\u0430 \u2014 \u043e\u0434\u0438\u043d \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u043b\u044e\u0431\u0438\u043c\u044b\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432
    \u0411\u0443\u043b\u044f. \u042d\u0442\u043e\u0442 \u0432\u0438\u0442\u0440\u0430\u0436
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0441\u044f \u0438 \u043f\u043e \u0441\u0435\u0439
    \u0434\u0435\u043d\u044c. \u041d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e \u043f\u0440\u0430\u0434\u0435\u0434\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430: \u041e\u0442\u0435\u0446 \u0414\u0436\u043e\u0440\u0434\u0436\u0430,
    \u0414\u0436\u043e\u043d \u0411\u0443\u043b\u044c, \u0431\u044b\u043b \u0441\u0430\u043f\u043e\u0436\u043d\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0443\u043a\u0430 \u0438 \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432.
    \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f
    \u0438 \u0434\u0430\u0436\u0435 \u0432\u044b\u0441\u0442\u0430\u0432\u0438\u043b \u0435\u0433\u043e
    \u0432 \u0432\u0438\u0442\u0440\u0438\u043d\u0435 \u0441\u0432\u043e\u0435\u0439 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439
    \u0441 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435\u043c \u0434\u043b\u044f
    \u0432\u0441\u0435\u0445 \u0436\u0435\u043b\u0430\u044e\u0449\u0438\u0445. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u044d\u0442\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u043e\u0440\u0438\u043b\u043e
    \u0435\u0433\u043e, \u0438 \u043e\u043d \u043e\u0431\u0430\u043d\u043a\u0440\u043e\u0442\u0438\u043b\u0441\u044f.
    \u0421\u043f\u0443\u0441\u0442\u044f \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442,
    \u0443\u0436\u0435 \u0431\u0443\u0434\u0443\u0447\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c
    \u0443\u0447\u0451\u043d\u044b\u043c, \u0432\u043d\u0443\u043a \u0414\u0436\u043e\u0440\u0434\u0436\u0430
    \u0411\u0443\u043b\u044f, \u0441\u044d\u0440 \u0414\u0436\u0435\u0444\u0444\u0440\u0438
    \u0422\u0435\u0439\u043b\u043e\u0440, \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432
    \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e \u044f\u0449\u0438\u0447\u0435\u043a
    \u043e\u0442 \u0442\u043e\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u043e \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430.
    \u041d\u0430 \u0435\u0433\u043e \u0434\u043d\u0435 \u0440\u0443\u043a\u043e\u0439 \u0435\u0433\u043e
    \u0431\u0430\u0431\u0443\u0448\u043a\u0438, \u0432\u0434\u043e\u0432\u044b \u0414\u0436\u043e\u0440\u0434\u0436\u0430,
    \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043e: \u00ab\u041f\u043e\u0445\u043e\u0436\u0435,
    \u043e\u043d \u0432\u0441\u0451 \u043c\u043e\u0433 \u0434\u0435\u043b\u0430\u0442\u044c
    \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e, \u0432\u0441\u0451, \u043a\u0440\u043e\u043c\u0435
    \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u044b\u00bb. \u041f\u0440\u0438
    \u044d\u0442\u043e\u043c \u0422\u0435\u0439\u043b\u043e\u0440 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u044f\u043d\u044b\u0435 \u043b\u043e\u0436\u0435\u0447\u043a\u0438
    \u0441 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0439 \u043f\u0440\u0430\u0434\u0435\u0434\u0430,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0442\u043e\u043c,
    \u0447\u0442\u043e \u0441\u0435\u043c\u044c\u044f \u0437\u043d\u0430\u0432\u0430\u043b\u0430
    \u0438 \u043b\u0443\u0447\u0448\u0438\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430.\n\n\u2764\ufe0f
    \u0420\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u0430\u044f \u0436\u0435\u043d\u0430 \u0421\u0432\u0430\u0442\u043e\u0432\u0441\u0442\u0432\u043e
    \u0447\u0435\u0440\u0435\u0437 \u0430\u043b\u0433\u0435\u0431\u0440\u0443: \u0411\u0443\u043b\u044c
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    40 \u043b\u0435\u0442 \u043d\u0430 \u041c\u044d\u0440\u0438 \u042d\u0432\u0435\u0440\u0435\u0441\u0442,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u043d\u0430 17 \u043b\u0435\u0442
    \u0435\u0433\u043e \u043c\u043e\u043b\u043e\u0436\u0435. \u0418\u0445 \u0440\u043e\u043c\u0430\u043d
    \u043d\u0430\u0447\u0430\u043b\u0441\u044f \u0441 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e
    \u0411\u0443\u043b\u044c \u0434\u0430\u0432\u0430\u043b \u0435\u0439 \u0447\u0430\u0441\u0442\u043d\u044b\u0435
    \u0443\u0440\u043e\u043a\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u0421\u0430\u043c\u0430
    \u041c\u044d\u0440\u0438 \u0441 \u043f\u0440\u0438\u0441\u0443\u0449\u0435\u0439 \u0435\u0439
    \u044d\u043a\u0437\u0430\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0437\u0436\u0435 \u043f\u0438\u0441\u0430\u043b\u0430: \u00ab\u042f \u043d\u0438\u0447\u0435\u0433\u043e
    \u043d\u0435 \u0437\u043d\u0430\u043b\u0430 \u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0435,
    \u043a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u0410\u043b\u0433\u0435\u0431\u0440\u0443. \u042f
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0447\u0438\u0442\u0430\u043b\u0430 \u044d\u0442\u043e
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0439 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u043b\u044e\u0431\u0438\u0442\u044c \u0435\u0433\u043e \u0432\u0441\u0435\u0439 \u0434\u0443\u0448\u043e\u0439
    \u0438 \u0432\u0441\u0435\u043c \u0441\u0435\u0440\u0434\u0446\u0435\u043c\u00bb. \u041e\u0442\u0437\u044b\u0432\u044b
    \u00ab\u043f\u043e\u0447\u0442\u0438 \u043a\u0430\u043a \u0443 \u0441\u0432\u044f\u0442\u043e\u0433\u043e\u00bb:
    \u041f\u0435\u0440\u0435\u0434 \u0441\u0432\u0430\u0434\u044c\u0431\u043e\u0439 \u041c\u044d\u0440\u0438
    \u0440\u0435\u0448\u0438\u043b\u0430 \u043d\u0430\u0432\u0435\u0441\u0442\u0438 \u0441\u043f\u0440\u0430\u0432\u043a\u0438
    \u043e \u0441\u0432\u043e\u0451\u043c \u0436\u0435\u043d\u0438\u0445\u0435. \u041e\u0434\u043d\u0430
    \u0438\u0437 \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0445 \u0434\u0430\u043c \u0434\u0430\u043b\u0430
    \u0435\u043c\u0443 \u0432\u0435\u0441\u044c\u043c\u0430 \u0434\u0432\u0443\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0443\u044e
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0443: \u00ab\u041e\u043d
    \u043c\u043d\u0435 \u043d\u0435 \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f... \u042f
    \u043d\u0435 \u043b\u044e\u0431\u043b\u044e \u0442\u0430\u043a\u0438\u0445 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0443\u0436 \u0445\u043e\u0440\u043e\u0448\u0438\u0445 \u043b\u044e\u0434\u0435\u0439...
    \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0435\u0441\u044c
    \u0440\u044f\u0434\u043e\u043c \u0441 \u0442\u0430\u043a\u0438\u043c \u043f\u043e\u0447\u0442\u0438
    \u0447\u0442\u043e \u0441\u0432\u044f\u0442\u044b\u043c, \u043d\u0435\u0432\u043e\u043b\u044c\u043d\u043e
    \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435,
    \u0447\u0442\u043e \u043e\u043d \u0448\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d \u0432\u0430\u0448\u0438\u043c
    \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043c\u00bb. \u0414\u0440\u0443\u0433\u0430\u044f
    \u0434\u0430\u043c\u0430 \u0443\u0441\u043f\u043e\u043a\u043e\u0438\u043b\u0430 \u041c\u044d\u0440\u0438,
    \u0441\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0441 \u043d\u0438\u043c \u043c\u043e\u0436\u043d\u043e
    \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u043e\u0442\u043f\u0443\u0441\u0442\u0438\u0442\u044c
    \u043d\u0430 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0443 \u0441\u0432\u043e\u044e \u043d\u0435\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e\u043b\u0435\u0442\u043d\u044e\u044e
    \u0434\u043e\u0447\u044c, \u043d\u0435 \u0431\u043e\u044f\u0441\u044c \u0437\u0430 \u0435\u0451
    \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e. \u0422\u0430\u043a\u0438\u0435 \u043e\u0442\u0437\u044b\u0432\u044b,
    \u0432\u0438\u0434\u0438\u043c\u043e, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0443\u0431\u0435\u0434\u0438\u043b\u0438 \u041c\u044d\u0440\u0438 \u0432 \u043d\u0430\u0434\u0451\u0436\u043d\u043e\u0441\u0442\u0438
    \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u043c\u0443\u0436\u0430. \u0413\u043e\u0440\u0430
    \u042d\u0432\u0435\u0440\u0435\u0441\u0442: \u041c\u044d\u0440\u0438 \u0431\u044b\u043b\u0430
    \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u0446\u0435\u0439 \u0441\u044d\u0440\u0430
    \u0414\u0436\u043e\u0440\u0434\u0436\u0430 \u042d\u0432\u0435\u0440\u0435\u0441\u0442\u0430,
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0430,
    \u0432 \u0447\u0435\u0441\u0442\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u0430
    \u0432\u044b\u0441\u043e\u0447\u0430\u0439\u0448\u0430\u044f \u0433\u043e\u0440\u0430 \u043c\u0438\u0440\u0430.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0438\u043c\u044f
    \u0411\u0443\u043b\u044f \u0441\u0432\u044f\u0437\u0430\u043d\u043e \u0441 \u044d\u0442\u043e\u0439
    \u0433\u043e\u0440\u043e\u0439 \u0447\u0435\u0440\u0435\u0437 \u0435\u0433\u043e \u0436\u0435\u043d\u0443.\n\n\U0001F3A8
    \u0418\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b \u0438 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u043a
    \u041f\u043e\u044d\u0442 \u0432 \u0434\u0443\u0448\u0435 \u0438 \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044c
    \u00ab\u0420\u0430\u044f\u00bb: \u0411\u0443\u043b\u044c \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441 \u0448\u0438\u0440\u043e\u043a\u0438\u043c\u0438 \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u043c\u0438
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u043c\u0438. \u0415\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u044b\u043c
    \u043f\u043e\u044d\u0442\u043e\u043c \u0431\u044b\u043b \u0414\u0430\u043d\u0442\u0435,
    \u043d\u043e, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445,
    \u00ab\u0420\u0430\u0439\u00bb \u043d\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0435\u043c\u0443
    \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c
    \u00ab\u0410\u0434\u00bb. \u041e\u043d \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0438\u0437\u0443\u0447\u0430\u043b
    \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u0438\u043a\u0443 \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044f,
    \u044d\u0442\u0438\u043a\u0443 \u0421\u043f\u0438\u043d\u043e\u0437\u044b \u0438 \u0442\u0440\u0443\u0434\u044b
    \u0426\u0438\u0446\u0435\u0440\u043e\u043d\u0430. \u041f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f
    \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u043f\u043e\u0434 \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c\u043e\u043c:
    \u0411\u0443\u043b\u044c \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0441\u0442\u0430\u0442\u044c\u0438 \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0445,
    \u043d\u043e \u0438 \u0432 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0445
    \u0436\u0443\u0440\u043d\u0430\u043b\u0430\u0445. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0437 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442 \u0431\u044b\u043b\u0438
    \u043d\u0430\u043f\u0435\u0447\u0430\u0442\u0430\u043d\u044b \u0432 \u00ab\u0412\u0435\u0441\u0442\u043d\u0438\u043a\u0435
    \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a\u00bb, \u043f\u0440\u0438\u0447\u0451\u043c
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c
    G. Boldt. \u042d\u0442\u0438 \u0444\u0430\u043a\u0442\u044b \u0441\u043e\u0437\u0434\u0430\u044e\u0442
    \u043e\u0431\u0440\u0430\u0437 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u00ab\u043e\u0442\u0446\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438\u00bb,
    \u043d\u043e \u0438 \u0436\u0438\u0432\u044b\u043c, \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043c
    \u0438 \u043e\u0447\u0435\u043d\u044c \u043e\u0431\u0430\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432, \u0441\u0442\u043e\u043b\u044c \u0436\u0435
    \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0445, \u043a\u0430\u043a \u0438 \u0435\u0433\u043e
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430."
  interestingFactsEn: "George Bull's life is full of amazing and funny episodes that paint him not just as a serious scientist, but as a very unusual, witty and deep man, and this is the most interesting collection of facts about him.\n\n* Genius teenager and stingyness to the books Young Polyglot and the charge of plagiarism: By the age of 14, Buul had been fluent in Latin, Greek, French, German and Italian. His talent was so obvious that when a local newspaper published his translation of an ancient Greek poem in 1830, a reader accused him of plagiarism, refusing to believe that such a complex translation could have been done by a teenager.Savings in literature: When he began to engage in mathematics, he knowingly bought math books rather than art literature, and later admitted to his wife that he had done so for practical reasons: reading and learning one mathematical tract took much longer than having a novel or poem, so he saved money by less buying new books.\n\n♪ Wonderful teacher and talented artist Dismissed from reading on Sunday: After starting his teacher career at 16, Bull was dismissed from the first private school for... lack of religion, his fault was that he was able to read books on mathematics on Sundays and did so right in the chapel.His pedagogical method was original: he only took the youngest boys to study because he thought they were \"not spoiled by bad education.\" The master of lion's breeze: Bull was incredibly popular with the children in his home Lincoln, and the contemporaries said that the neighboring boys often called him to play with them.His \"soon number\" was so credible that the children in their fake horror would run away, screaming with joy, and this episode confirms that he was not only a serious scientist, but also a very living, loving person.\n\n♪ The household reflected in the glass and silver spoons of the Miracle in honor of the favorite Bible story: The grateful people of Lincoln so valued Bull that they decided to perpetuate his memory in the local cathedral. The glass created in his honor depicts the Bible's calling of Samuel, one of the most beloved episodes of Bull, and this glass is still present today.The legacy of the great-grandfather telescope: George's father, John Boul, was a shoemaker, but his real passion was the science and the manufacture of optical instruments, and he created the telescope and even put it in his workshop window with an invitation for everyone who wanted it, but ironically, it was a passion that ruined him, and he went bankrupt.Many years later, as a famous scientist, George Bull's grandson, Sir Jeffrey Taylor, inherited crates from the same telescope, and on his bottom, his grandmother, the widow of George, said, \"It seems that he could do everything perfectly, except for his job.\" Taylor also inherited silver spoons with the monogram of the great-grandfather, which indicates that the family knew better times.\n\n♪ Romantic history and the unusual wife of Slavova through algebra: Bull married Mary Everest at the age of 40, who was 17 years younger than him. Their novel began with Bull giving her private algebra lessons. Mary herself, with her own exaltation, later wrote: \"I knew nothing about the Lord except that he created Algebra. I always thought it was a good reason to love him with all my soul and all my heart.\"The response of \"nearly like a saint\": Before the wedding, Mary decided to look into her fiancees. One of the ladies she knew gave him a very ambiguous description: \"I don't like him... I don't like such very good people... when you're around so much as a saint, there's a feeling that he's shocked by your presence.\"Another lady calmed Mary down, saying that he was safe to let her minor daughter go for a walk without being afraid of her reputation, and those reviews seem to have convinced Mary fully of the future husband's credibility. Mountain Everest: Mary was the niece of Sir George Everest, a famous geographer named after whom the highest mountain of the world is named, so the name of Bull is linked to this mountain through his wife.\n\n♪ Intellectual and romantic poet in the soul and amateur of Paradise: Bull was a man with broad humanitarian interests. His favorite poet was Dante, but unlike many, \"Rai\" liked him much more than \"Ad.\" He studied the metaphysics of Aristotel, the ethics of Spinoza and Cicero's works. Publication in Russia under a pseudonym: Bull published his scientific articles not only in leading British magazines, but also in European journals.Some of his works were published in the Journal of the St. Petersburg Academy of Sciences, and he used the pseudonym G. Goldt. These facts create an image of a man who was not just the father of mathematical logic, but also a living, diverse and very charming man whose life was full of amazing turns, as unusual as his own algebra."
