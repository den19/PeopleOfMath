  achievementsRu: "\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0432\u043a\u043b\u0430\u0434 \u0414\u0436\u043e\u0440\u0434\u0436\u0430
    \u0411\u0443\u043b\u044f \u0432 \u043d\u0430\u0443\u043a\u0443 \u2014 \u044d\u0442\u043e
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u043b\u043e\u0433\u0438\u043a\u0438, \u0447\u0442\u043e \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c
    \u0441\u0447\u0451\u0442\u0435 \u0441\u0434\u0435\u043b\u0430\u043b\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c
    \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432. \u0415\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0434\u0435\u043b\u044f\u0442\u0441\u044f \u043d\u0430 \u0442\u0440\u0438 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438: \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u043b\u043e\u0433\u0438\u043a\u0438, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u043e\u0431\u0449\u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u044b\u0432\u043e\u0434\u0430 \u0438 \u0432\u0430\u0436\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.\n\n\U0001F9E0
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u043b\u043e\u0433\u0438\u043a\u0438 (\u0411\u0443\u043b\u0435\u0432\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b)
    \u0413\u043b\u0430\u0432\u043d\u0430\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u0438\u0434\u0435\u044f \u0411\u0443\u043b\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438
    \u0432 \u0432\u0438\u0434\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0413\u043b\u0430\u0432\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b: \u0421\u0432\u043e\u0438 \u0438\u0434\u0435\u0438 \u043e\u043d
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0432 \u0434\u0432\u0443\u0445 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442\u0430\u0445. \u0412 1847 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u0435\u043b
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u044b\u0439 \u043f\u0430\u043c\u0444\u043b\u0435\u0442
    \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u043b\u043e\u0433\u0438\u043a\u0438\u00bb, \u0430
    \u0432 1854-\u043c \u2014 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u00ab\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435
    \u0437\u0430\u043a\u043e\u043d\u043e\u0432 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \u0437\u0440\u0435\u043b\u044b\u043c \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c
    \u0441\u0432\u043e\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b. \u0421\u0443\u0442\u044c
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b: \u0411\u0443\u043b\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043c\u0435\u0436\u0434\u0443 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u043c\u0438
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f
    \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u044f. \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0438\u043c\u0432\u043e\u043b\u044b
    \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043a\u043b\u0430\u0441\u0441\u043e\u0432
    (\u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432) \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432,
    \u0433\u0434\u0435 `1` \u2014 \u044d\u0442\u043e \u00ab\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u043a\u043b\u0430\u0441\u0441\u00bb (\u0432\u0441\u0451 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u043c\u044b\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432), \u0430 `0` \u2014 \u00ab\u043f\u0443\u0441\u0442\u043e\u0439
    \u043a\u043b\u0430\u0441\u0441\u00bb. \u041a \u044d\u0442\u0438\u043c \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c
    \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c
    \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438, \u043f\u043e\u0445\u043e\u0436\u0438\u0435
    \u043d\u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435:
    \u041b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435
    (\u0418, `\u2227`) \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u044e \u043a\u043b\u0430\u0441\u0441\u043e\u0432.
    \u041b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    (\u0418\u041b\u0418, `\u2228`) \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044e \u043a\u043b\u0430\u0441\u0441\u043e\u0432
    (\u0445\u043e\u0442\u044f \u0432 \u0435\u0433\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0435
    \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f,
    \u0431\u043b\u0438\u0437\u043a\u0430\u044f \u043a \u0441\u0442\u0440\u043e\u0433\u043e\u0439
    \u0434\u0438\u0437\u044a\u044e\u043d\u043a\u0446\u0438\u0438, \u0438\u0441\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0435\u0439
    \u043e\u0431\u0449\u0443\u044e \u0447\u0430\u0441\u0442\u044c). \u041b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0442\u0440\u0438\u0446\u0430\u043d\u0438\u0435 (\u041d\u0415, `\u00ac`) \u0432\u044b\u0440\u0430\u0436\u0430\u043b\u043e\u0441\u044c
    \u0447\u0435\u0440\u0435\u0437 \u00ab\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u0435\u00bb \u0438\u0437 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u043b\u0430\u0441\u0441\u0430, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435
    \u043a\u043b\u0430\u0441\u0441\u0430. \u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e:
    \u0412 \u044d\u0442\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043b\u044e\u0431\u044b\u0435 \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u044f
    \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u043e\u043f\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u043c\u0438 \u043f\u043e
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c, \u0441\u0445\u043e\u0436\u0438\u043c \u0441
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    \u0411\u0443\u043b\u044c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b, \u0447\u0442\u043e
    \u0432 \u0435\u0433\u043e \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u0435
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u044e\u0442\u0441\u044f
    \u0437\u0430\u043a\u043e\u043d\u0443 `x\u00b2 = x`. \u0412 \u043e\u0431\u044b\u0447\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u044d\u0442\u043e\u043c\u0443
    \u0443\u0441\u043b\u043e\u0432\u0438\u044e \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u044e\u0442
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0438\u0441\u043b\u0430 0 \u0438 1, \u0447\u0442\u043e
    \u0441\u0434\u0435\u043b\u0430\u043b\u043e \u0434\u0432\u043e\u0438\u0447\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0435\u0433\u043e
    \u043b\u043e\u0433\u0438\u043a\u0438.\n\n\U0001F9E9 \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u043e\u0431\u0449\u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u044b\u0432\u043e\u0434\u0430 \u0411\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439 \u044f\u0437\u044b\u043a
    \u0434\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0438 \u043b\u043e\u0433\u0438\u043a\u0438.
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u0439 \u0434\u0435\u043b\u0430\u0442\u044c
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u0442\u0440\u043e\u0433\u0438\u0435 \u0432\u044b\u0432\u043e\u0434\u044b. \u041e\u0442
    \u043f\u043e\u0441\u044b\u043b\u043e\u043a \u043a \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044e:
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u043a\u0430\u043a \u043b\u044e\u0431\u043e\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u0439
    (\u043f\u043e\u0441\u044b\u043b\u043e\u043a) \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0417\u0430\u0442\u0435\u043c,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043c\u0435\u0442\u043e\u0434\u044b,
    \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0449\u0438\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445),
    \u043c\u043e\u0436\u043d\u043e \u0447\u0438\u0441\u0442\u043e \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u043b\u044e\u0431\u043e\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0438\u0437 \u044d\u0442\u0438\u0445 \u043f\u043e\u0441\u044b\u043b\u043e\u043a.
    \u042d\u0442\u043e \u0431\u044b\u043b \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u0448\u0430\u0433 \u0432\u043f\u0435\u0440\u0451\u0434 \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e
    \u0441 \u0430\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0435\u0432\u043e\u0439 \u0441\u0438\u043b\u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u043e\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u0431\u043e\u043b\u0435\u0435 \u0434\u0432\u0443\u0445 \u0442\u044b\u0441\u044f\u0447 \u043b\u0435\u0442.
    \u0421\u0432\u044f\u0437\u044c \u0441 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0435\u0439
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f: \u0411\u0443\u043b\u044c \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e,
    \u043d\u043e \u0438 \u043a\u0430\u043a \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u043e\u043f\u0438\u0441\u0430\u0442\u044c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u00ab\u0437\u0430\u043a\u043e\u043d\u044b \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f\u00bb.
    \u0412 \u0441\u0432\u043e\u0438\u0445 \u0437\u0430\u043c\u0435\u0442\u043a\u0430\u0445 \u043e\u043d
    \u043f\u043e\u0434\u0447\u0451\u0440\u043a\u0438\u0432\u0430\u043b, \u0447\u0442\u043e \u043f\u0440\u0435\u0436\u0434\u0435
    \u0447\u0435\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u043e\u043d\u044f\u0442\u044c
    \u0437\u0430\u043a\u043e\u043d\u044b \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f,
    \u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u043d\u044f\u0442\u0438\u044f.\n\n\u2795
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u0447\u0438\u0441\u0442\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0412\u043a\u043b\u0430\u0434 \u0411\u0443\u043b\u044f \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0441\u044f
    \u043b\u043e\u0433\u0438\u043a\u043e\u0439. \u041e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u041d\u0430\u0433\u0440\u0430\u0434\u044b \u0438
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u0412 1844 \u0433\u043e\u0434\u0443
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e
    \u043d\u0430\u0433\u0440\u0430\u0434\u0438\u043b\u043e \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u043e\u0439
    \u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u043c\u0435\u0434\u0430\u043b\u044c\u044e \u0437\u0430
    \u0440\u0430\u0431\u043e\u0442\u0443 \u00ab\u041e\u0431 \u043e\u0431\u0449\u0435\u043c \u043c\u0435\u0442\u043e\u0434\u0435
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u00bb, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u043d \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0441\u043f\u043e\u0441\u043e\u0431\u044b
    \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u0412 1857 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438: \u0415\u0433\u043e \u0442\u0440\u0443\u0434\u044b
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445\u00bb (1859) \u0438 \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u043e \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445 \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044f\u0445\u00bb
    (1860) \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u044d\u0442\u0438\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439: \u0412\u043e \u0432\u0442\u043e\u0440\u043e\u0439
    \u0447\u0430\u0441\u0442\u0438 \u00ab\u0417\u0430\u043a\u043e\u043d\u043e\u0432 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f\u00bb
    \u043e\u043d \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u043b \u043f\u043e\u043f\u044b\u0442\u043a\u0443
    \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u043e\u0431\u0449\u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u0432 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439. \u0415\u0433\u043e
    \u0446\u0435\u043b\u044c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044f\u043c \u043e\u0434\u043d\u0438\u0445
    \u0441\u043e\u0431\u044b\u0442\u0438\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u043b\u044e\u0431\u043e\u0433\u043e
    \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u044f, \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441 \u043d\u0438\u043c\u0438 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0433\u043e.\n\n\U0001F4A1
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u043d \u043d\u0435 \u043c\u043e\u0433 \u043f\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u0442\u044c
    \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0411\u0443\u043b\u044c \u0432\u0440\u044f\u0434
    \u043b\u0438 \u043c\u043e\u0433 \u0432\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0442\u044c,
    \u043a \u043a\u0430\u043a\u0438\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u043c
    \u043f\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043d\u0430 \u0440\u0443\u0431\u0435\u0436\u0435
    XIX\u2013XX \u0432\u0435\u043a\u043e\u0432 \u0444\u0438\u0437\u0438\u043a\u0438 \u043d\u0430\u0447\u0430\u043b\u0438
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0435\u0433\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0443
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u0445\u0435\u043c. \u0410 \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435
    XX \u0432\u0435\u043a\u0430 \u0431\u0443\u043b\u0435\u0432\u0430 \u0430\u043b\u0433\u0435\u0431\u0440\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0445
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0445 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0434\u0432\u0430 \u0435\u0451 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    (`\u0418\u0421\u0422\u0418\u041d\u0410`/`\u041b\u041e\u0416\u042c`, `1`/`0`) \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438
    \u0434\u0432\u0443\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\u043c \u0442\u0440\u0430\u043d\u0437\u0438\u0441\u0442\u043e\u0440\u0430
    (\u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e/\u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e).
    \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043c\u044b
    \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c
    \u0442\u0430\u043a\u0438\u0435 \u0442\u0435\u0440\u043c\u0438\u043d\u044b, \u043a\u0430\u043a
    \u00ab\u0431\u0443\u043b\u0435\u0432\u0430 \u043b\u043e\u0433\u0438\u043a\u0430\u00bb \u0438
    \u00ab\u0431\u0443\u043b\u0435\u0432\u044b \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b\u00bb
    \u0432 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0438 \u043f\u043e\u0438\u0441\u043a\u043e\u0432\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445."
  achievementsEn: "George Bull's main contribution to science is the creation of a fundamentally new mathematical language to describe logic, which ultimately made it possible to create digital computers, and his achievements are divided into three key areas: creation of algebra logic, development of a common method of logical output, and important work in pure mathematics.\n\nThe main revolutionary idea of Bull was to present logical operations in the form of mathematical equations.In 1847, the program pamphlet \"Mathematical Analysis of Logic\" was released, and in 1854, the fundamental work \"Researching the Laws of Thinking on which mathematical theories of logic and probabilities are based\", which he considered to be a mature statement of his system, the essence of the system: Bull showed that there was a profound analogy between algebraic and logical action.He suggested that symbols should be used to indicate the classes (multiple) of objects where `1' is the \"universal class\" (all the objects considered) and `0' is the \"empty class.\" These symbols could be used to refer to operations similar to algebraic ones: Logic multiplication (I, , ) corresponds to class intersections.The logical addition (or, `, `, `) corresponds to the combination of classes (although in his system it was an operation close to a strict dissuncture excluding the general part).Key property: In this system, it was possible to code any phrases by symbols and then operate them by rules similar to the solution of equations. Bull found that in his logical algebra, variables were subject to the law `x2 = x'. In ordinary mathematics, only the numbers 0 and 1 satisfy this condition, which made the binary system the ideal foundation for its logic.\n\nThe development of a common method of logical conclusion, Bull, did not simply create a new language for recording logic. It developed a method to make formal, mathematically strict conclusions. From assumptions to conclusions: It showed how any many words (sents) can be represented in a logical equation system.Then, using methods similar to conventional algebraic equations (e.g. the deletion of variables), you can simply symbolically extract any conclusion that logically follows from these assumptions. This was a huge step forward from the aristoteleology that has been the basis of logic for more than 2,000 years.Relationship to psychology: Bull viewed his work not only as mathematical, but also as an attempt to describe fundamental \"law of thought.\" He stressed in his notes that before analysing the reasoning process, it was necessary to understand the laws of thinking, judgment and concepts.\n\nIn 1844, the Royal Society awarded him the first gold medal for \"On the Common Method of Analysis\", in which he explored ways to combine algebra and computational methods.Classic textbooks: His works \"Tactat on Differential Equations\" (1859) and \"Tactate on Final Diversities\" (1860) were considered classic for years and had a significant impact on the development of these parts of mathematics, and he is also considered to be a founder of the theory of invariants.Probability theory: In the second part of \"Laws of thought\", he attempted to use his symbolic method to create a common method in calculating probability, and its purpose was to determine, by the intended probabilities of some events, the probability of any other event logically related to them.\n\nThe legacy that he could not have foreseen in his lifetime was unlikely to have imagined the consequences of his work. However, at the turn of the 19th to XXth centuries, physicists began to use his algebra to describe electrical switches.And in the middle of the 20th century, the algebra boulder became the basis for the design of digital electronic computers, because its two states ( \"ISTINA `/ `LAUGH', `1'/ `0') perfectly matched the two transistor states (on/off), which is why we now use terms such as \"logic bulls\" and \"operator bells\" in programming and search systems."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0414\u0436\u043e\u0440\u0434\u0436\u0430
    \u0411\u0443\u043b\u044f, \u043f\u0440\u0438 \u0432\u0441\u0435\u0439 \u0435\u0451 \u0432\u043d\u0435\u0448\u043d\u0435\u0439
    \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u0441\u0442\u043e\u0439\u043d\u043e\u0441\u0442\u0438,
    \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u0438 \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c\u044e,
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c\u0438
    \u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0432 \u043b\u0438\u0446\u0435 \u0435\u0433\u043e \u0436\u0435\u043d\u044b \u0438 \u0434\u043e\u0447\u0435\u0440\u0435\u0439.\n\n\U0001F496
    \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430
    \u0438 \u0431\u0440\u0430\u043a\u0430 \u0412 1849 \u0433\u043e\u0434\u0443, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432 \u041a\u0443\u0438\u043d\u0437-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0435 \u0432
    \u0438\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u043c \u041a\u043e\u0440\u043a\u0435,
    \u0414\u0436\u043e\u0440\u0434\u0436 \u0411\u0443\u043b\u044c, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u0431\u044b\u043b\u043e \u0443\u0436\u0435 \u0437\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044c,
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u0441\u0435\u043c\u044c\u0451\u0439
    \u0441\u0432\u043e\u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c \u043e\u043d \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b
