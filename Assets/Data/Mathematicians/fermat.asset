  achievementsRu: "\u0425\u043e\u0442\u044f \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u043c \u043e\u0442\u0432\u0435\u0442\u0435
    \u043c\u044b \u0443\u0436\u0435 \u043a\u043e\u0441\u043d\u0443\u043b\u0438\u0441\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445
    \u0432\u0435\u0445, \u0437\u0434\u0435\u0441\u044c \u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439,
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u0438 \u0441\u0442\u0440\u043e\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u041f\u044c\u0435\u0440\u0430
    \u0424\u0435\u0440\u043c\u0430. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d
    \u0442\u0435\u043c, \u0447\u0442\u043e \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u0440\u0430\u0437\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u0432\u044b\u0441\u0448\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0447\u0430\u0441\u0442\u043e \u043e\u043f\u0435\u0440\u0435\u0436\u0430\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f. \u0412\u043e\u0442
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f, \u0440\u0430\u0437\u0431\u0438\u0442\u044b\u0435
    \u043f\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c \u043d\u0430\u0443\u043a\u0438
    \u0441 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u044b\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435\u043c
    \u0441\u0443\u0442\u0438 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430.
    1. \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b (\u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434) \u0424\u0435\u0440\u043c\u0430 \u043f\u043e \u043f\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u00ab\u043e\u0442\u0446\u043e\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b\u00bb. \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0438, \u0430 \u0441\u043e\u0437\u0434\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044e \u0434\u043b\u044f \u0438\u0445
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430. \u0412\u0435\u043b\u0438\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430 (\u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f):
    \u0421\u0443\u0442\u044c: \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \\( a^n + b^n = c^n \\) \u043d\u0435
    \u0438\u043c\u0435\u0435\u0442 \u043d\u0435\u043d\u0443\u043b\u0435\u0432\u044b\u0445 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438 \\( n > 2 \\). \u0414\u0435\u0442\u0430\u043b\u0438:
    \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u043f\u0438\u0441\u0430\u043b \u044d\u0442\u043e
    \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0441 \u043f\u043e\u043c\u0435\u0442\u043a\u043e\u0439,
    \u0447\u0442\u043e \u043d\u0430\u0448\u0435\u043b \u00ab\u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0447\u0443\u0434\u0435\u0441\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u00bb.
    \u042d\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b \u043d\u0430 350 \u043b\u0435\u0442.
    \u0414\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441\u043e\u043c
    \u0432 1994 \u0433\u043e\u0434\u0443 \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445
    \u0438 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c
    (\u0442\u043e\u0433\u043e, \u0447\u0435\u0433\u043e \u0432 XVII \u0432\u0435\u043a\u0435
    \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e).
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442, \u0447\u0442\u043e \u0441\u0430\u043c \u0424\u0435\u0440\u043c\u0430
    \u043c\u043e\u0433 \u0438\u043c\u0435\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \\( n=4 \\), \u043d\u043e \u043e\u0448\u0438\u0431\u0441\u044f
    \u0432 \u043e\u0431\u0449\u0435\u043c \u0441\u043b\u0443\u0447\u0430\u0435. \u041c\u0430\u043b\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430: \u0421\u0443\u0442\u044c:
    \u0415\u0441\u043b\u0438 \\( p \\) \u2014 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0447\u0438\u0441\u043b\u043e,
    \u0430 \\( a \\) \u2014 \u0446\u0435\u043b\u043e\u0435 \u0447\u0438\u0441\u043b\u043e, \u043d\u0435
    \u0434\u0435\u043b\u044f\u0449\u0435\u0435\u0441\u044f \u043d\u0430 \\( p \\), \u0442\u043e
    \\( a^{p-1} \\equiv 1 \\pmod{p} \\). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430 \u0434\u043b\u044f \u0442\u0435\u0441\u0442\u043e\u0432
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u0443 \u0447\u0438\u0441\u0435\u043b
    (\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043b\u0438 \u0447\u0438\u0441\u043b\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u043c)
    \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0441 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c \u043a\u043b\u044e\u0447\u043e\u043c
    (\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c RSA). \u0424\u0435\u0440\u043c\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0451 \u0434\u043b\u044f \u0444\u0430\u043a\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u0438
    \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0447\u0438\u0441\u0435\u043b. \u041c\u0435\u0442\u043e\u0434
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0441\u043f\u0443\u0441\u043a\u0430:
    \u0421\u0443\u0442\u044c: \u042d\u0442\u043e \u043c\u043e\u0449\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043e\u0442
    \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u043e\u0433\u043e. \u0424\u0435\u0440\u043c\u0430
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b, \u0447\u0442\u043e \u0435\u0441\u043b\u0438
    \u0434\u043b\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u0442\u043e \u0432\u0441\u0435\u0433\u0434\u0430
    \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043c\u0435\u043d\u044c\u0448\u0435\u0435
    \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435.
    \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0442\u044c \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430 \u043d\u0435\u043b\u044c\u0437\u044f, \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c
    \u043a \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044e. \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435:
    \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u044d\u0442\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430
    \u043e\u043d \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 \u0441 \u0446\u0435\u043b\u044b\u043c\u0438
    \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u043c (\u043e\u0442\u0441\u044e\u0434\u0430
    \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0430 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \\( n=4 \\) \u0432 \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u0435).
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u0441\u0443\u043c\u043c\u0435 \u0434\u0432\u0443\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432: \u0421\u0443\u0442\u044c: \u041f\u0440\u043e\u0441\u0442\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \\( p \\) \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043c\u043e
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \u0434\u0432\u0443\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432 \\( p = x^2 + y^2 \\) \u0442\u043e\u0433\u0434\u0430
    \u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \\( p = 2 \\) \u0438\u043b\u0438 \\( p \\equiv 1 \\pmod{4} \\). \u0414\u0435\u0442\u0430\u043b\u0438:
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0447\u0438\u0441\u0435\u043b
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u043c\u0438 \u0444\u043e\u0440\u043c\u0430\u043c\u0438.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430 \u043e \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445 (\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430):
    \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u043b\u044e\u0431\u043e\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0443\u043c\u043c\u043e\u0439
    \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 \\( n \\) \\( n \\)-\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043b\u044e\u0431\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u2014 \u0441\u0443\u043c\u043c\u0430 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435
    4 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435
    5 \u043f\u044f\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445 \u0438 \u0442.\u0434.).
    \u042d\u0442\u043e \u043f\u043e\u0437\u0436\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u041a\u043e\u0448\u0438. --- 2. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 (\u0418\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445)
    \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b \u043f\u0440\u044f\u043c\u044b\u043c \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430.
    \u041e\u043d \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u0437\u0434\u0430\u043b
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432
    \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0439
    \u0434\u043e \u043d\u0438\u0445. \u041c\u0435\u0442\u043e\u0434 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u043e\u0432, \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u043e\u0432
    \u0438 \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 (\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435):
    \u0421\u0443\u0442\u044c: \u0424\u0435\u0440\u043c\u0430 \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u00ab\u043f\u0440\u0438\u0440\u0430\u0449\u0435\u043d\u0438\u044f\u00bb (\u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0438\u043c
    \u0435\u0433\u043e \\( e \\)). \u0427\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438
    \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0443\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \\( f(x) \\), \u043e\u043d \u043f\u0440\u0438\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u0432 \u0442\u043e\u0447\u043a\u0430\u0445 \\( x \\) \u0438 \\( x+e \\), \u0434\u0435\u043b\u0438\u043b
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c \u043d\u0430 \\( e \\), \u0430 \u0437\u0430\u0442\u0435\u043c
    \u043f\u0440\u0438\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b \\( e \\) \u043a \u043d\u0443\u043b\u044e.
    \u041f\u0440\u0438\u043c\u0435\u0440: \u0414\u043b\u044f \\( f(x) = x^2 \\): \\( (x+e)^2
    = x^2 \\Rightarrow 2xe + e^2 = 0 \\Rightarrow e(2x+e)=0 \\). \u0421\u043e\u043a\u0440\u0430\u0449\u0430\u044f
    \u043d\u0430 \\( e \\) \u0438 \u043e\u0442\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u044f
    \u0435\u0433\u043e (\u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0445\u043e\u0434),
    \u043f\u043e\u043b\u0443\u0447\u0430\u043b \\( 2x=0 \\). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0442\u043e\u0447\u043d\u043e\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439.
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u0440\u044f\u043c\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b,
    \u0447\u0442\u043e \u043e\u043f\u0438\u0440\u0430\u043b\u0441\u044f \u043d\u0430 \u00ab\u043c\u0435\u0442\u043e\u0434
    \u0424\u0435\u0440\u043c\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445\u00bb. \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u044b
    (\u0418\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435):
    \u0421\u0443\u0442\u044c: \u0424\u0435\u0440\u043c\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043e\u0431\u0449\u0438\u0439 \u043c\u0435\u0442\u043e\u0434 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043f\u043b\u043e\u0449\u0430\u0434\u0435\u0439 \u043f\u043e\u0434 \u043a\u0440\u0438\u0432\u044b\u043c\u0438
    \u0432\u0438\u0434\u0430 \\( y = x^n \\), \u0433\u0434\u0435 \\( n \\) \u2014 \u043b\u044e\u0431\u043e\u0435
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e
    (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u0438
    \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435, \u043a\u0440\u043e\u043c\u0435
    -1). \u0414\u0435\u0442\u0430\u043b\u0438: \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u044e
    \u0434\u043b\u044f \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u044f \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430
    \u043d\u0430 \u043d\u0435\u0440\u0430\u0432\u043d\u044b\u0435 \u0447\u0430\u0441\u0442\u0438
    (\u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043c\u0435\u0442\u043e\u0434\u0430
    \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445 \u041a\u0430\u0432\u0430\u043b\u044c\u0435\u0440\u0438),
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0435\u043c\u0443
    \u0442\u043e\u0447\u043d\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b
    \\( \\int_0^a x^n dx = \\frac{a^{n+1}}{n+1} \\). \u042d\u0442\u043e \u0431\u044b\u043b \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0439
    \u0448\u0430\u0433 \u043a \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e. --- 3. \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0424\u0435\u0440\u043c\u0430 \u0441\u043e\u0437\u0434\u0430\u043b
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0441 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c, \u043d\u043e \u0435\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434 \u0431\u044b\u043b \u0431\u043e\u043b\u0435\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u043d\u044b\u043c
    \u0438 \u0443\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u043b\u043e\u0441\u043a\u0438\u0445
    \u0438 \u0442\u0435\u043b\u0435\u0441\u043d\u044b\u0445 \u043c\u0435\u0441\u0442\u00bb (1636):
    \u0421\u0443\u0442\u044c: \u0424\u0435\u0440\u043c\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u043f\u0440\u0430\u0432\u0438\u043b\u043e: \u043b\u044e\u0431\u043e\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0441 \u0434\u0432\u0443\u043c\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u043a\u0440\u0438\u0432\u0443\u044e
    \u043d\u0430 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438. \u041e\u043d \u0432\u0432\u0435\u043b
    \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b
    (\u043f\u0440\u0430\u0432\u0434\u0430, \u043e\u0441\u044c \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u0430 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439,
    \u0430 \u043d\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439,
    \u043a\u0430\u043a \u0441\u0435\u0439\u0447\u0430\u0441). \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f:
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432\u0441\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432\u0438\u0434\u0430 \\( Ax +
    By = C \\) \u2014 \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u044b\u0435, \u0430 \u0432\u0441\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432\u0438\u0434\u0430 \\( x^2
    = py \\), \\( xy = c \\) \u0438 \\( x^2 \\pm y^2 = r^2 \\) \u2014 \u044d\u0442\u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f (\u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b,
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u044b \u0438 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438/\u044d\u043b\u043b\u0438\u043f\u0441\u044b).
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0440\u0435\u0448\u0430\u0442\u044c
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0447\u0438\u0441\u0442\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438.
    --- 4. \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    (\u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c)
    \u0412 1654 \u0433\u043e\u0434\u0443 \u0432 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435
    \u0441 \u0411\u043b\u0435\u0437\u043e\u043c \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c
    \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0417\u0430\u0434\u0430\u0447\u0430 \u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u0441\u0442\u0430\u0432\u043e\u043a
    (Problem of Points): \u0423\u0441\u043b\u043e\u0432\u0438\u0435: \u0414\u0432\u0430 \u0438\u0433\u0440\u043e\u043a\u0430
    \u0438\u0433\u0440\u0430\u044e\u0442 \u0432 \u043a\u043e\u0441\u0442\u0438. \u0418\u0433\u0440\u0430
    \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u0434\u043d\u043e\u043c\u0443 \u0438\u0437 \u0438\u0433\u0440\u043e\u043a\u043e\u0432
    \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \\( n \\) \u043f\u043e\u0431\u0435\u0434,
    \u0430 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \\( m \\). \u041a\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u0431\u0430\u043d\u043a? \u0420\u0435\u0448\u0435\u043d\u0438\u0435
    \u0424\u0435\u0440\u043c\u0430: \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0432\u0448\u0435\u0433\u043e
    \u0440\u0435\u043a\u0443\u0440\u0440\u0435\u043d\u0442\u043d\u044b\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f,
    \u0424\u0435\u0440\u043c\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0443.
    \u041e\u043d \u043f\u043e\u0434\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b \u0432\u0441\u0435
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u0438\u0441\u0445\u043e\u0434\u044b
    \u0433\u0438\u043f\u043e\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f \u0438\u0433\u0440\u044b
    (\u043f\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u043b \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438)
    \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u043b \u0434\u043e\u043b\u044e \u043a\u0430\u0436\u0434\u043e\u0433\u043e
    \u0438\u0433\u0440\u043e\u043a\u0430 \u043a\u0430\u043a \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0445 \u0438\u0441\u0445\u043e\u0434\u043e\u0432
    \u043a \u043e\u0431\u0449\u0435\u043c\u0443 \u0447\u0438\u0441\u043b\u0443. \u042d\u0442\u043e
    \u0432\u0432\u0435\u043b\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f. --- 5. \u0424\u0438\u0437\u0438\u043a\u0430
    (\u041f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438) \u0424\u0435\u0440\u043c\u0430 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043f\u0442\u0438\u043a\u0435, \u043e\u0442\u043a\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044c
    \u043e\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0439 \u0414\u0435\u043a\u0430\u0440\u0442\u0430.
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u0424\u0435\u0440\u043c\u0430 (1662): \u0421\u0443\u0442\u044c:
    \u0421\u0432\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f
    \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f \u0442\u043e\u0447\u043a\u0430\u043c\u0438
    \u043f\u043e \u043f\u0443\u0442\u0438, \u0434\u043b\u044f \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0435 \u0432\u0440\u0435\u043c\u044f.
    \u041e\u043f\u0440\u043e\u0432\u0435\u0440\u0436\u0435\u043d\u0438\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u0430:
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e
    \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0441\u0432\u0435\u0442\u0430 \u0432 \u043f\u043b\u043e\u0442\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u0435 \u0432\u044b\u0448\u0435. \u0424\u0435\u0440\u043c\u0430,
    \u0438\u0441\u0445\u043e\u0434\u044f \u0438\u0437 \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0442\u0440\u043e\u0433\u043e
    \u0432\u044b\u0432\u0435\u043b \u0437\u0430\u043a\u043e\u043d \u0421\u043d\u0435\u043b\u043b\u0438\u0443\u0441\u0430
    (\u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f) \u0438 \u043f\u0440\u0438\u0448\u0435\u043b
    \u043a \u0432\u044b\u0432\u043e\u0434\u0443, \u0447\u0442\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c
    \u0441\u0432\u0435\u0442\u0430 \u0432 \u0431\u043e\u043b\u0435\u0435 \u043f\u043b\u043e\u0442\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u0435 \u043d\u0438\u0436\u0435, \u0447\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0432\u0435\u0440\u043d\u044b\u043c. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e\u0442 \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043f\u043e\u0437\u0436\u0435
    \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0432 \u0444\u0438\u0437\u0438\u043a\u0435
    (\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430).
    --- 6. \u041c\u0435\u0442\u043e\u0434\u044b \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0434\u043b\u0438\u043d \u043a\u0440\u0438\u0432\u044b\u0445 (\u0421\u043f\u0440\u044f\u043c\u043b\u0435\u043d\u0438\u0435)
    \u0424\u0435\u0440\u043c\u0430 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u043d\u0430\u0448\u0435\u043b \u0442\u043e\u0447\u043d\u0443\u044e \u0434\u043b\u0438\u043d\u0443
    \u0434\u0443\u0433\u0438 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043a\u0440\u0438\u0432\u044b\u0445.
    \u041e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u0434\u043b\u0438\u043d\u0443
    \u0434\u0443\u0433\u0438 \u043f\u043e\u043b\u0443\u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b \\( y = x^{3/2} \\). \u0414\u043b\u044f
    \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u0441\u0443\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445
    \u043e\u0442\u0440\u0435\u0437\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e \u0441\u0443\u0442\u0438 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0435\u043d
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0443\u043b\u0435
    \u0434\u043b\u0438\u043d\u044b \u0434\u0443\u0433\u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430
    \\( \\int \\sqrt{1+(y')^2} dx \\). \u042d\u0442\u043e \u0431\u044b\u043b \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0440\u0430\u043d\u043d\u0438\u0445 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. --- \u0418\u0442\u043e\u0433\u043e\u0432\u043e\u0435
    \u0440\u0435\u0437\u044e\u043c\u0435 \u0432\u043a\u043b\u0430\u0434\u0430 | \u041e\u0431\u043b\u0430\u0441\u0442\u044c
    \u043d\u0430\u0443\u043a\u0438 | \u041a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 | \u0412\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 | |:--- |:--- |:--- | | \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b | \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430,
    \u041c\u0430\u043b\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430, \u043c\u0435\u0442\u043e\u0434
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0441\u043f\u0443\u0441\u043a\u0430.
    | \u0421\u043e\u0437\u0434\u0430\u043b \u0447\u0438\u0441\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b \u043a\u0430\u043a \u043d\u0430\u0443\u043a\u0443; \u0434\u0430\u043b
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0434\u043b\u044f \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    (RSA). | | \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 | \u041c\u0435\u0442\u043e\u0434
    \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438 \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0443\u043c\u043e\u0432
    \u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u0438\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u0435
    \u043f\u0440\u0438\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043a \u043d\u0443\u043b\u044e.
    | \u041f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439; \u043f\u043e\u0432\u043b\u0438\u044f\u043b
    \u043d\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430. | | \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 | \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u0430
    \u043f\u0430\u0440\u0430\u0431\u043e\u043b \u043b\u044e\u0431\u043e\u0433\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430. | \u0420\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443,
    \u043d\u0435\u043f\u043e\u0434\u0432\u043b\u0430\u0441\u0442\u043d\u0443\u044e \u0433\u0440\u0435\u043a\u0430\u043c;
    \u0434\u0430\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438.
    | | \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    | \u041e\u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043b\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0441 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043c\u0435\u0441\u0442\u0430\u043c\u0438 \u0442\u043e\u0447\u0435\u043a. | \u0421\u0432\u044f\u0437\u0430\u043b
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0440\u0435\u0448\u0430\u0442\u044c
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0447\u0435\u0440\u0442\u0435\u0436\u0435\u0439 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c\u0438.
    | | \u0424\u0438\u0437\u0438\u043a\u0430 (\u041e\u043f\u0442\u0438\u043a\u0430) | \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    + \u0432\u044b\u0432\u043e\u0434 \u0437\u0430\u043a\u043e\u043d\u0430 \u0421\u043d\u0435\u043b\u043b\u0438\u0443\u0441\u0430.
    | \u041e\u0441\u043d\u043e\u0432\u0430 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f; \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435
    \u043a\u043e\u0440\u043f\u0443\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u043e-\u0432\u043e\u043b\u043d\u043e\u0432\u043e\u0433\u043e
    \u0434\u0443\u0430\u043b\u0438\u0437\u043c\u0430 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c.
    | | \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c | \u041a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u044b\u0439
    \u0440\u0430\u0441\u0447\u0435\u0442 \u0448\u0430\u043d\u0441\u043e\u0432 \u043f\u0440\u0438
    \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u043c \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u043d\u0438\u0438
    \u0438\u0433\u0440\u044b. | \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u043e\u0439
    \u0431\u0430\u0437\u044b \u0434\u043b\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u0433\u0440. | \u0412\u0430\u0436\u043d\u043e\u0435
    \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u0435: \u0424\u0435\u0440\u043c\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430.
    \u041e\u043d \u043f\u043e\u0441\u044b\u043b\u0430\u043b \u043b\u0438\u0448\u044c \u0437\u0430\u0434\u0430\u0447\u0438
    \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0441\u0432\u043e\u0438\u043c
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c (\u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0432 \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u043a \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u044e
    \u0438 \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443), \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044f
    \u0438\u0445. \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430
    \u00ab\u0431\u0440\u043e\u0441\u0430\u0442\u044c \u0432\u044b\u0437\u043e\u0432\u00bb \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c
    \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u0435\u0433\u043e \u0441\u0430\u043c\u044b\u043c
    \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u044b\u043c \u0433\u0435\u043d\u0438\u0435\u043c
    XVII \u0432\u0435\u043a\u0430."
  achievementsEn: 
  personalLifeRu: "\u0412\u043d\u0435\u0448\u043d\u0435 \u0436\u0438\u0437\u043d\u044c \u041f\u044c\u0435\u0440\u0430
    \u0424\u0435\u0440\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u0432\u0435\u043b \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0431\u044b\u043b\u0430 \u0431\u044b \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0441\u043a\u0443\u0447\u043d\u0430 \u0434\u043b\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0430,
    \u0435\u0441\u043b\u0438 \u0431\u044b \u043d\u0435 \u0435\u0433\u043e \u0442\u0430\u0439\u043d\u0430\u044f,
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u0441\u0442\u044c.
    \u041e\u043d \u0431\u044b\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \"\u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0434\u0432\u0443\u0445 \u0436\u0438\u0437\u043d\u0435\u0439\":
    \u0434\u043d\u0435\u043c \u2014 \u0434\u043e\u0431\u0440\u043e\u0441\u043e\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u044e\u0440\u0438\u0441\u0442, \u043d\u043e\u0447\u044c\u044e \u0438 \u0432 \u0447\u0430\u0441\u044b
    \u0434\u043e\u0441\u0443\u0433\u0430 \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043c\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u0435\u0433\u043e \"\u0437\u0435\u043c\u043d\u043e\u0439\" \u0436\u0438\u0437\u043d\u0438.
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0421\u0435\u043c\u044c\u044f \u0438
    \u0417\u0430\u0433\u0430\u0434\u043a\u0430 \u0414\u0430\u0442\u044b \u041f\u044c\u0435\u0440
    \u0424\u0435\u0440\u043c\u0430 \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0431\u043e\u0433\u0430\u0442\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435 \u0432 \u0433\u0430\u0441\u043a\u043e\u043d\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u0411\u043e\u043c\u043e\u043d-\u0434\u0435-\u041b\u043e\u043c\u0430\u043d\u044c
    \u043d\u0430 \u044e\u0433\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0442\u043e\u0447\u043d\u0430\u044f \u0434\u0430\u0442\u0430 \u0435\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442
    \u0441\u043f\u043e\u0440\u044b \u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432.
    \u0422\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    17 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1601 \u0433\u043e\u0434\u0430, \u043e\u043f\u0438\u0440\u0430\u044f\u0441\u044c
    \u043d\u0430 \u0437\u0430\u043f\u0438\u0441\u044c \u043e \u043a\u0440\u0435\u0449\u0435\u043d\u0438\u0438.
    \u041d\u043e \u0435\u0441\u0442\u044c \u0438 \u0434\u0440\u0443\u0433\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f:
    \u043d\u0430 \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0438 \u0443\u043a\u0430\u0437\u0430\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u0440 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    57 \u043b\u0435\u0442, \u0447\u0442\u043e \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442
    \u0434\u0430\u0442\u0443 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0430 1607
    \u0438\u043b\u0438 \u0434\u0430\u0436\u0435 1608 \u0433\u043e\u0434. \u041f\u0443\u0442\u0430\u043d\u0438\u0446\u0443
    \u0432\u043d\u043e\u0441\u0438\u0442 \u0442\u043e\u0442 \u0444\u0430\u043a\u0442, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446, \u0414\u043e\u043c\u0438\u043d\u0438\u043a
    \u0424\u0435\u0440\u043c\u0430 (\u0431\u043e\u0433\u0430\u0442\u044b\u0439 \u0442\u043e\u0440\u0433\u043e\u0432\u0435\u0446
    \u043a\u043e\u0436\u0435\u0439 \u0438 \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439
    \u043a\u043e\u043d\u0441\u0443\u043b), \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0434\u0432\u0430\u0436\u0434\u044b,
    \u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u0435\u0440\u0432\u044b\u0439
    \u0440\u0435\u0431\u0435\u043d\u043e\u043a \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u041f\u044c\u0435\u0440
    \u0443\u043c\u0435\u0440, \u0430 \u0438\u043c\u044f \u0431\u044b\u043b\u043e \u0434\u0430\u043d\u043e
    \u0432\u0442\u043e\u0440\u043e\u043c\u0443 \u0441\u044b\u043d\u0443 \u043e\u0442 \u0434\u0440\u0443\u0433\u043e\u0439
    \u043c\u0430\u0442\u0435\u0440\u0438. \u041c\u0430\u0442\u0435\u0440\u044c\u044e \u041f\u044c\u0435\u0440\u0430
    \u0431\u044b\u043b\u0430 \u041a\u043b\u0435\u0440 \u0434\u0435 \u041b\u043e\u043d\u0433.
    \u0412 \u0441\u0435\u043c\u044c\u0435, \u043a\u0440\u043e\u043c\u0435 \u043d\u0435\u0433\u043e,
    \u0431\u044b\u043b\u043e \u0435\u0449\u0435 \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439.
    \u0424\u0435\u0440\u043c\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0445\u043e\u0440\u043e\u0448\u0435\u0435
    \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u043e\u043d \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0437\u043d\u0430\u043b \u043b\u0430\u0442\u044b\u043d\u044c,
    \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439,
    \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439 \u0438 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a\u0438, \u043f\u0438\u0441\u0430\u043b \u0441\u0442\u0438\u0445\u0438
    \u0438 \u0441\u0447\u0438\u0442\u0430\u043b\u0441\u044f \u0442\u043e\u043d\u043a\u0438\u043c
    \u0437\u043d\u0430\u0442\u043e\u043a\u043e\u043c \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u043e\u0431\u0440\u0430\u0449\u0430\u043b\u0438\u0441\u044c \u0437\u0430 \u0441\u043e\u0432\u0435\u0442\u043e\u043c
    \u043f\u0440\u0438 \u0438\u0437\u0434\u0430\u043d\u0438\u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u043a\u043e\u0432.
    \u0411\u0440\u0430\u043a \u0438 \u0414\u0435\u0442\u0438 \u0412 1631 \u0433\u043e\u0434\u0443,
    \u0432 \u0433\u043e\u0434 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u0432\u043e\u0435\u0439
    \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b,
    \u0424\u0435\u0440\u043c\u0430 \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041b\u0443\u0438\u0437\u0435
    \u0434\u0435 \u041b\u043e\u043d\u0433 (Louise de Long), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u0435\u043c\u0443 \u0434\u0430\u043b\u044c\u043d\u0435\u0439
    \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u0446\u0435\u0439 \u043f\u043e
    \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u043e\u0439 \u043b\u0438\u043d\u0438\u0438.
    \u0418\u0445 \u0431\u0440\u0430\u043a \u0431\u044b\u043b, \u043f\u043e \u0432\u0441\u0435\u0439
    \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438, \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u044b\u043c
    \u0438 \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u043d\u044b\u043c, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c
    \u0435\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u043c\u0443
    \u043e\u0431\u0440\u0430\u0437\u0443 \u0436\u0438\u0437\u043d\u0438. \u0423 \u041f\u044c\u0435\u0440\u0430
    \u0438 \u041b\u0443\u0438\u0437\u044b \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u043f\u044f\u0442\u0435\u0440\u043e
    \u0434\u0435\u0442\u0435\u0439, \u0445\u043e\u0442\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442
    \u0441\u0435\u043c\u044c \u0438\u043b\u0438 \u0432\u043e\u0441\u0435\u043c\u044c. \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0438\u0437 \u043d\u0438\u0445 \u0431\u044b\u043b
    \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d, \u041a\u043b\u0435\u043c\u0430\u043d-\u0421\u0430\u043c\u044e\u044d\u043b\u044c
    (Cl\u00e9ment-Samuel). \u0418\u043c\u0435\u043d\u043d\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0435\u043c\u0443 \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u0445 \u0424\u0435\u0440\u043c\u0430: \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430 \u0421\u0430\u043c\u044e\u044d\u043b\u044c
    \u0441\u043e\u0431\u0440\u0430\u043b \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u043f\u0438\u0441\u044c\u043c\u0430 \u0438 \u0437\u0430\u043c\u0435\u0442\u043a\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \"\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\"
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u043e \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u0435. \u041a\u0430\u0440\u044c\u0435\u0440\u0430 \u042e\u0440\u0438\u0441\u0442\u0430
    \u0438 \"\u0412\u0442\u043e\u0440\u0430\u044f\" \u0416\u0438\u0437\u043d\u044c \u0424\u0435\u0440\u043c\u0430
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u043f\u0440\u0430\u0432\u0430 \u0432 \u041e\u0440\u043b\u0435\u0430\u043d\u0435 \u0438
    \u0432 1631 \u0433\u043e\u0434\u0443 \u0432\u044b\u043a\u0443\u043f\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430
    (conseiller) \u0432 \u041f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0435 \u0422\u0443\u043b\u0443\u0437\u044b
    \u2014 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0432\u044b\u0441\u0448\u0438\u0445
    \u0441\u0443\u0434\u043e\u0432 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u042d\u0442\u0430
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u0430\u0432\u0430\u043b\u0430
    \u0435\u043c\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e\u0445\u043e\u0434
    \u0438 \u0441\u0442\u0430\u0442\u0443\u0441, \u043d\u043e \u0438 \u043f\u0440\u0430\u0432\u043e
    \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043a \u0444\u0430\u043c\u0438\u043b\u0438\u0438
    \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u043a\u0443\u044e \u0447\u0430\u0441\u0442\u0438\u0446\u0443
    \"\u0434\u0435\", \u0441\u0442\u0430\u0432 \u041f\u044c\u0435\u0440\u043e\u043c \u0434\u0435
    \u0424\u0435\u0440\u043c\u0430. \u041e\u043d \u0431\u044b\u043b \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u0432\u044b\u043c
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u043e\u043c: \u0434\u043e\u0431\u0440\u043e\u0441\u043e\u0432\u0435\u0441\u0442\u043d\u044b\u043c,
    \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u044b\u043c \u0438 \u0447\u0435\u0441\u0442\u043d\u044b\u043c.
    \u042d\u0442\u043e \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u043b\u043e \u0435\u043c\u0443
    \u043a\u0430\u0440\u044c\u0435\u0440\u043d\u044b\u0439 \u0440\u043e\u0441\u0442: \u0432
    1638 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c
    \u0443\u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u0441\u0443\u0434\u0430, \u0430
    \u0432 1648-\u043c \u2014 \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u043b\u0430\u0442\u044b
    \u044d\u0434\u0438\u043a\u0442\u043e\u0432 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041a\u0430\u0441\u0442\u0440.
    \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u0435\u0433\u043e \u043a\u0430\u043a
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e, \u043d\u043e
    \"\u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0433\u043e \u0438 \u043f\u043e\u0433\u043b\u043e\u0449\u0435\u043d\u043d\u043e\u0433\u043e
    \u0441\u0432\u043e\u0438\u043c\u0438 \u043c\u044b\u0441\u043b\u044f\u043c\u0438\" \u0441\u0443\u0434\u044c\u044e.
    \u0412\u0441\u044f \u0435\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u043e\u0448\u043b\u0430 \u0432 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0438.
    \u041e\u043d \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    (\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0434\u0430\u043b\u044c\u043d\u0435\u0435
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u043e\u0441\u044c
    \u0432 1654 \u0433\u043e\u0434\u0443), \u0440\u0435\u0434\u043a\u043e \u043f\u043e\u043a\u0438\u0434\u0430\u043b
    \u0422\u0443\u043b\u0443\u0437\u0443 \u0438 \u0435\u0435 \u043e\u043a\u0440\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0432
    \u041f\u0430\u0440\u0438\u0436\u0435, \u0446\u0435\u043d\u0442\u0440\u0435 \u0442\u043e\u0433\u0434\u0430\u0448\u043d\u0435\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438. \u0418\u043c\u0435\u043d\u043d\u043e
    \u044d\u0442\u0430 \u0440\u0430\u0437\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0430 \u0435\u043c\u0443 \u0432\u0435\u0447\u0435\u0440\u0430
    \u0438 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435 \u0434\u043b\u044f \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0436\u0438\u0437\u043d\u0438 \u2014
    \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c, \u0421\u043c\u0435\u0440\u0442\u044c \u0438
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0412 1652 \u0433\u043e\u0434\u0443 \u043d\u0430
    \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u043e\u0431\u0440\u0443\u0448\u0438\u043b\u0430\u0441\u044c
    \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044f \u0447\u0443\u043c\u044b. \u0424\u0435\u0440\u043c\u0430
    \u0437\u0430\u0440\u0430\u0437\u0438\u043b\u0441\u044f, \u043d\u043e, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u043a\u043e\u043b\u043b\u0435\u0433-\u0441\u0443\u0434\u0435\u0439,
    \u0447\u0443\u0434\u043e\u043c \u0432\u044b\u0436\u0438\u043b. \u0415\u0433\u043e \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0441\u043c\u0435\u0440\u0442\u0435\u0439
    \u0432 \u0441\u0443\u0434\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438 \u0435\u043c\u0443
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432\u044b\u0441\u0448\u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0438 \u041f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430.
    \u041f\u044c\u0435\u0440 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    12 \u044f\u043d\u0432\u0430\u0440\u044f 1665 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u0430\u0441\u0442\u0440, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439
    \u0432\u044b\u0435\u0437\u0434\u043d\u043e\u0439 \u0441\u0435\u0441\u0441\u0438\u0438 \u0441\u0443\u0434\u0430.
    \u0415\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0438\u043b\u0438 \u0432 \u041a\u0430\u0441\u0442\u0440\u0435,
    \u043d\u043e \u043f\u043e\u0437\u0436\u0435 \u043f\u0440\u0430\u0445 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u043b\u0438
    \u0432 \u0441\u0435\u043c\u0435\u0439\u043d\u0443\u044e \u0443\u0441\u044b\u043f\u0430\u043b\u044c\u043d\u0438\u0446\u0443
    \u0432 \u0422\u0443\u043b\u0443\u0437\u0435. \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    \u0435\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0430 \u0431\u044b\u043b\u0430 \u0443\u0442\u0435\u0440\u044f\u043d\u0430.
    \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432, \u0438\u0437\u0434\u0430\u043d\u043d\u043e\u0435
    \u0441\u044b\u043d\u043e\u043c, \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043c\u0438\u0440: \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c, \u0447\u0442\u043e
    \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u0439 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u044e\u0440\u0438\u0441\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0415\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u0424\u0435\u0440\u043c\u0430 \u043a\u0430\u043a
    \u043f\u0440\u0438\u0432\u0435\u0442\u043b\u0438\u0432\u043e\u0433\u043e, \u0443\u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0448\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u044d\u0440\u0443\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432 \u043e\u0434\u043d\u043e\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0435 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043b
    \u0434\u043e\u0431\u0440\u043e\u0441\u043e\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430-\u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044f."
  personalLifeEn: 
  shortBioRu: "\u041f\u044c\u0435\u0440 \u0424\u0435\u0440\u043c\u0430 \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u0445\u043e\u0442\u044f \u043f\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0438 \u043e\u043d \u0431\u044b\u043b \u044e\u0440\u0438\u0441\u0442\u043e\u043c
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043d\u0430\u0443\u043a\u043e\u0439
    \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.
    \u041e\u043d \u0441\u0442\u043e\u044f\u043b \u0443 \u0438\u0441\u0442\u043e\u043a\u043e\u0432
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0412\u043e\u0442 \u0435\u0433\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f. \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 (1601-1631) \u041f\u044c\u0435\u0440
    \u0424\u0435\u0440\u043c\u0430 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 17 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1601 \u0433\u043e\u0434\u0430 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u0411\u043e\u043c\u043e\u043d-\u0434\u0435-\u041b\u043e\u043c\u0430\u043d\u044c
    \u043d\u0430 \u044e\u0433\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446, \u0414\u043e\u043c\u0438\u043d\u0438\u043a \u0424\u0435\u0440\u043c\u0430,
    \u0431\u044b\u043b \u0437\u0430\u0436\u0438\u0442\u043e\u0447\u043d\u044b\u043c \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0435\u043c
    \u043a\u043e\u0436\u0435\u0439 \u0438 \u0432\u0442\u043e\u0440\u044b\u043c \u043a\u043e\u043d\u0441\u0443\u043b\u043e\u043c
    (\u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c \u043c\u044d\u0440\u0430)
    \u0433\u043e\u0440\u043e\u0434\u0430. \u041c\u0430\u0442\u044c, \u041a\u043b\u0435\u0440
    \u0434\u0435 \u041b\u043e\u043d\u0433, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u044e\u0440\u0438\u0441\u0442\u043e\u0432.
    \u041c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c
    \u043e \u0435\u0433\u043e \u043a\u0440\u0435\u0449\u0435\u043d\u0438\u0438 \u0434\u0430\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430
    20 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1601 \u0433\u043e\u0434\u0430. \u041e \u0440\u0430\u043d\u043d\u0438\u0445
    \u0433\u043e\u0434\u0430\u0445 \u0424\u0435\u0440\u043c\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043d\u0435\u043c\u043d\u043e\u0433\u043e. \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432 \u043c\u0435\u0441\u0442\u043d\u043e\u043c
    \u0444\u0440\u0430\u043d\u0446\u0438\u0441\u043a\u0430\u043d\u0441\u043a\u043e\u043c \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435.
    \u041f\u043e\u0437\u0436\u0435 \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f \u0432
    \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0422\u0443\u043b\u0443\u0437\u044b,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432
    \u0411\u043e\u0440\u0434\u043e, \u0433\u0434\u0435 \u0432 \u043a\u043e\u043d\u0446\u0435
    1620-\u0445 \u0433\u043e\u0434\u043e\u0432 \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u0438
    \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.
    \u0412 1629 \u0433\u043e\u0434\u0443 \u043e\u043d \u0443\u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435\u043c
    \u0443\u0442\u0435\u0440\u044f\u043d\u043d\u043e\u0433\u043e \u0442\u0440\u0443\u0434\u0430
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f \u041f\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e
    \u00ab\u041e \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u043c\u0435\u0441\u0442\u0430\u0445\u00bb
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u043e\u0432
    \u0438 \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u043e\u0432. \u041f\u043e\u0441\u043b\u0435
    \u0411\u043e\u0440\u0434\u043e \u0424\u0435\u0440\u043c\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u041e\u0440\u043b\u0435\u0430\u043d, \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b
    \u043f\u0440\u0430\u0432\u043e \u0438 \u0432 1631 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u043a\u0443\u043f\u0438\u043b
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430
    \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430 (\u0441\u0443\u0434\u0430)
    \u0432 \u0422\u0443\u043b\u0443\u0437\u0435 \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u044d\u0442\u043e\u0442 \u0433\u043e\u0440\u043e\u0434. \u041f\u043e\u043b\u0443\u0447\u0438\u0432
    \u044d\u0442\u0443 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c, \u043e\u043d
    \u0441\u0442\u0430\u043b \u0438\u043c\u0435\u0442\u044c \u043f\u0440\u0430\u0432\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c
    \u0438\u043c\u044f \u0441 \u041f\u044c\u0435\u0440 \u0424\u0435\u0440\u043c\u0430 \u043d\u0430
    \u041f\u044c\u0435\u0440 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430. \u041a\u0430\u0440\u044c\u0435\u0440\u0430
    \u044e\u0440\u0438\u0441\u0442\u0430 \u0438 \u0436\u0438\u0437\u043d\u044c \u0432 \u0422\u0443\u043b\u0443\u0437\u0435
    \u0421 1631 \u0433\u043e\u0434\u0430 \u0438 \u0434\u043e \u0441\u0430\u043c\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0424\u0435\u0440\u043c\u0430 \u0441\u043b\u0443\u0436\u0438\u043b
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430
    \u0432 \u0422\u0443\u043b\u0443\u0437\u0435. \u041e\u043d \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u043a\u0430\u043a \u0434\u043e\u0431\u0440\u043e\u0441\u043e\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0438 \u0443\u043c\u0435\u043b\u044b\u0439 \u044e\u0440\u0438\u0441\u0442, \u043e\u0434\u0438\u043d
    \u0438\u0437 \u043b\u0443\u0447\u0448\u0438\u0445 \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u041e\u043d \u043f\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u043b\u0441\u044f \u043f\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u043d\u043e\u0439 \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435:
    \u0432 1634 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c,
    \u0432 1638 \u0433\u043e\u0434\u0443 \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u0432 \u0443\u0433\u043e\u043b\u043e\u0432\u043d\u044b\u0439 \u0441\u0443\u0434, \u0430
    \u0432 1652 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432\u044b\u0441\u0448\u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u0432 \u0441\u0443\u0434\u0435.
    \u0412 1631 \u0433\u043e\u0434\u0443 \u0424\u0435\u0440\u043c\u0430 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0441\u0432\u043e\u0435\u0439 \u0434\u0430\u043b\u044c\u043d\u0435\u0439 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u0446\u0435
    \u041b\u0443\u0438\u0437\u0435 \u0434\u0435 \u041b\u043e\u043d\u0433. \u0423 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u043f\u044f\u0442\u0435\u0440\u043e \u0434\u0435\u0442\u0435\u0439,
    \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0437\u0432\u0430\u043b\u0438 \u0421\u0430\u043c\u044e\u044d\u043b\u044c. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0421\u0430\u043c\u044e\u044d\u043b\u044c \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u043e\u0442\u0446\u0430 \u0441\u043e\u0431\u0440\u0430\u043b \u0438 \u0438\u0437\u0434\u0430\u043b
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0440\u0443\u0434\u044b \u0432 1679 \u0433\u043e\u0434\u0443. \u0412 1650-\u0445
    \u0433\u043e\u0434\u0430\u0445 \u0424\u0435\u0440\u043c\u0430 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e
    \u043f\u0435\u0440\u0435\u0431\u043e\u043b\u0435\u043b \u0447\u0443\u043c\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0432\u0438\u0440\u0435\u043f\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0432
    \u0440\u0435\u0433\u0438\u043e\u043d\u0435. \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0431\u044b\u043b\u0430
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0442\u044f\u0436\u0435\u043b\u043e\u0439,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u044c \u0434\u0430\u0436\u0435
    \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e \u0441\u043e\u043e\u0431\u0449\u0438\u043b\u0438
    \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c \u0432 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u043e\u0434\u043d\u0430\u043a\u043e \u043e\u043d \u0432\u044b\u0436\u0438\u043b. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0438 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430
    \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0424\u0435\u0440\u043c\u0430 \u043f\u043e\u0447\u0442\u0438
    \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b. \u041e \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043c\u0438\u0440 \u0443\u0437\u043d\u0430\u0432\u0430\u043b
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0447\u0435\u0440\u0435\u0437
    \u043e\u0431\u0448\u0438\u0440\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438,
    \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442,
    \u0411\u043b\u0435\u0437 \u041f\u0430\u0441\u043a\u0430\u043b\u044c, \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441, \u042d\u0432\u0430\u043d\u0434\u0436\u0435\u043b\u0438\u0441\u0442\u0430
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435.
    \u041f\u043e\u0441\u0440\u0435\u0434\u043d\u0438\u043a\u043e\u043c \u0432 \u044d\u0442\u043e\u0439
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u0430\u0431\u0431\u0430\u0442 \u041c\u0430\u0440\u0435\u043d \u041c\u0435\u0440\u0441\u0435\u043d\u043d,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0431\u0438\u0440\u0430\u043b \u0438
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u043b \u043f\u0438\u0441\u044c\u043c\u0430
    \u0441\u0440\u0435\u0434\u0438 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432. \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u0424\u0435\u0440\u043c\u0430
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0412 \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0443\u0434\u0435 \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0432 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u043b\u043e\u0441\u043a\u0438\u0445
    \u0438 \u0442\u0435\u043b\u0435\u0441\u043d\u044b\u0445 \u043c\u0435\u0441\u0442\u00bb (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e) \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u043a\u0430\u043a \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u043a\u0440\u0438\u0432\u044b\u0435
    \u043b\u0438\u043d\u0438\u0438. \u041e\u043d \u0434\u0430\u043b \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u043f\u0440\u044f\u043c\u043e\u0439 \u0438 \u043a\u0440\u0438\u0432\u044b\u0445 \u0432\u0442\u043e\u0440\u043e\u0433\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430, \u0434\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u043e\u043d\u0438 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u043c\u0438.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437:
    \u0424\u0435\u0440\u043c\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u043e\u0432 \u0438 \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u043e\u0432
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043c\u0435\u0442\u043e\u0434
    \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043a \u043a\u0440\u0438\u0432\u044b\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0431\u044b\u043b \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u0415\u0433\u043e \u043c\u0435\u0442\u043e\u0434
    \"\u0430\u0434\u0435\u043a\u0432\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438\" \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435
    \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0434\u043b\u044f \u043b\u044e\u0431\u044b\u0445 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439. \u0418\u0441\u0430\u0430\u043a
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u043e\u0437\u0436\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0438 \u0438\u0437 \"\u043c\u0435\u0442\u043e\u0434\u0430
    \u0424\u0435\u0440\u043c\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445\". \u041a\u0440\u043e\u043c\u0435
    \u0442\u043e\u0433\u043e, \u0424\u0435\u0440\u043c\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043e\u0431\u0449\u0435\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439,
    \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u0430\u0436\u043d\u043e\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439: \u0412 1654 \u0433\u043e\u0434\u0443
    \u0432 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0441 \u0411\u043b\u0435\u0437\u043e\u043c
    \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u041e\u043d\u0438 \u0440\u0435\u0448\u0430\u043b\u0438 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u043c\u0438
    \u0438\u0433\u0440\u0430\u043c\u0438, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \"\u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435
    \u0441\u0442\u0430\u0432\u043e\u043a\". \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u044d\u0442\u043e\u043c\u0443 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0443
    \u0438\u0445 \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c\u0438
    \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u0438. \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0438
    \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b \u0424\u0435\u0440\u043c\u0430
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u043e\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0431\u044b\u043b\u0438 \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u044b
    \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \u0435\u0433\u043e \u044d\u043a\u0437\u0435\u043c\u043f\u043b\u044f\u0440\u0430
    \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430.
    \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430:
    \u0421\u0430\u043c\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u0435\u0433\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435: `x\u207f
    + y\u207f = z\u207f` \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438 `n > 2`. \u0420\u044f\u0434\u043e\u043c
    \u0441 \u044d\u0442\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \"\u042f \u043d\u0430\u0448\u0435\u043b \u044d\u0442\u043e\u043c\u0443
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u043d\u043e
    \u043f\u043e\u043b\u044f \u043a\u043d\u0438\u0433\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0443\u0437\u043a\u0438 \u0434\u043b\u044f \u043d\u0435\u0433\u043e\". \u042d\u0442\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0439 \u0431\u043e\u043b\u0435\u0435
    350 \u043b\u0435\u0442 \u0438 \u0431\u044b\u043b\u0430 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0432
    1994 \u0433\u043e\u0434\u0443 \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441\u043e\u043c.
    \u041c\u0430\u043b\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430:
    \u0412 1640 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u0430\u0436\u043d\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443: \u0435\u0441\u043b\u0438
    `p` \u2014 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0447\u0438\u0441\u043b\u043e, \u0430
    `a` \u2014 \u043b\u044e\u0431\u043e\u0435 \u0446\u0435\u043b\u043e\u0435 \u0447\u0438\u0441\u043b\u043e,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043d\u0435 \u0434\u0435\u043b\u0438\u0442\u0441\u044f
    \u043d\u0430 `p`, \u0442\u043e `a\u1d56\u207b\u00b9 \u2014 1` \u0434\u0435\u043b\u0438\u0442\u0441\u044f
    \u043d\u0430 `p`. \u042d\u0442\u0430 \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0439
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u041c\u0435\u0442\u043e\u0434 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e
    \u0441\u043f\u0443\u0441\u043a\u0430: \u0424\u0435\u0440\u043c\u0430 \u0438\u0437\u043e\u0431\u0440\u0435\u043b
    \u043c\u043e\u0449\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \"\u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c \u0441\u043f\u0443\u0441\u043a\u043e\u043c\".
    \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0435\u043c,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 \u0441 \u0446\u0435\u043b\u044b\u043c\u0438
    \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u043c. \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0424\u0435\u0440\u043c\u0430 \u0432 \u0444\u0438\u0437\u0438\u043a\u0435 \u0424\u0435\u0440\u043c\u0430
    \u0442\u0430\u043a\u0436\u0435 \u0432\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434 \u0432
    \u0444\u0438\u0437\u0438\u043a\u0443. \u0412 1657 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0434\u043b\u044f \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u044d\u0442\u043e\u043c\u0443
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0443, \u0441\u0432\u0435\u0442 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f \u043f\u043e \u043f\u0443\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 \u0424\u0435\u0440\u043c\u0430
    \u0441\u043c\u043e\u0433 \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u043a\u043e\u043d
    \u0421\u043d\u0435\u043b\u043b\u0438\u0443\u0441\u0430 \u0434\u043b\u044f \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u0435\u0433\u043e \u043a \u0441\u043f\u043e\u0440\u0443 \u0441 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c
    \u043f\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c \u043e\u043f\u0442\u0438\u043a\u0438.
    \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041f\u044c\u0435\u0440 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    12 \u044f\u043d\u0432\u0430\u0440\u044f 1665 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u0430\u0441\u0442\u0440. \u041f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438
    \u0435\u0433\u043e \u0441\u044b\u043d \u0421\u0430\u043c\u044e\u044d\u043b\u044c \u0432
    1679 \u0433\u043e\u0434\u0443 \u0438\u0437\u0434\u0430\u043b \u0441\u0431\u043e\u0440\u043d\u0438\u043a
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432 \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c
    \"\u0420\u0430\u0437\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f\" (Varia opera mathematica), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u043c\u0438\u0440\u0443 \u043f\u043e \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u0443
    \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u0435\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f. \u0424\u0435\u0440\u043c\u0430, \u0431\u0443\u0434\u0443\u0447\u0438
    \u043f\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0438 \u044e\u0440\u0438\u0441\u0442\u043e\u043c,
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    XVII \u0432\u0435\u043a\u0430. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u0438
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d. \u0412 \u0422\u0443\u043b\u0443\u0437\u0435
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d
    \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0439 \u0438 \u0441\u0430\u043c\u044b\u0439
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439 \u043b\u0438\u0446\u0435\u0439,
    \u0430 \u0434\u043e\u043c, \u0433\u0434\u0435 \u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f,
    \u043d\u044b\u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043c\u0443\u0437\u0435\u0435\u043c."
  shortBioEn: 
  interestingFactsRu: "\u041f\u044c\u0435\u0440 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430 \u2014 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c,
    \u043e\u043a\u0443\u0442\u0430\u043d\u043d\u0430\u044f \u043e\u0440\u0435\u043e\u043b\u043e\u043c
    \u0442\u0430\u0439\u043d, \u043e\u0448\u0438\u0431\u043e\u043a, \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0437\u0440\u0435\u043d\u0438\u0439 \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u0435\u0439. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u0441\u043f\u043b\u043e\u0448\u043d\u043e\u0439 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435,
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a
    \u0433\u0435\u043d\u0438\u044f, \u043d\u043e \u0438 \u043a\u0430\u043a \u0436\u0438\u0432\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. 1. \u00ab\u0412\u0435\u043b\u0438\u043a\u0438\u0439
    \u041c\u043e\u043b\u0447\u0443\u043d\u00bb: \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d
    \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438.
    \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0424\u0435\u0440\u043c\u0430 \u043d\u0435
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043d\u0438 \u043e\u0434\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e\u0434 \u0441\u0432\u043e\u0438\u043c \u0438\u043c\u0435\u043d\u0435\u043c (\u043b\u0438\u0448\u044c
    \u043f\u0430\u0440\u0443 \u0441\u0442\u0430\u0442\u0435\u0439 \u043f\u043e \u043e\u043f\u0442\u0438\u043a\u0435).
    \u041f\u0440\u0438\u0447\u0438\u043d\u0430: \u041e\u043d \u043d\u0435 \u0431\u044b\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c \u0438 \u043d\u0435 \u043d\u0443\u0436\u0434\u0430\u043b\u0441\u044f
    \u0432 \u0434\u0435\u043d\u044c\u0433\u0430\u0445 \u0438\u043b\u0438 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0432\u0430\u043d\u0438\u044f\u0445. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u00ab\u0445\u043e\u0431\u0431\u0438\u00bb
    \u0438 \u0444\u043e\u0440\u043c\u043e\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0434\u043e\u0441\u0443\u0433\u0430. \u0421\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441: \u0424\u0435\u0440\u043c\u0430 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043a\u0430\u043a \u0438\u0433\u0440\u0443.
    \u041e\u043d \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u0441\u044b\u043b\u0430\u043b \u043f\u0438\u0441\u044c\u043c\u0430
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c (\u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443,
    \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u044e, \u041f\u0430\u0441\u043a\u0430\u043b\u044e),
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0434\u0430\u0432\u0430\u043b \u043d\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u0430 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043e\u0442\u0432\u0435\u0442\u044b
    \u0438\u043b\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0438
    \u0437\u0430\u0434\u0430\u0447, \u0441\u043b\u043e\u0432\u043d\u043e \u0431\u0440\u043e\u0441\u0430\u044f
    \u0432\u044b\u0437\u043e\u0432: \u00ab\u0410 \u0441\u043b\u0430\u0431\u043e \u0432\u0430\u043c
    \u043d\u0430\u0439\u0442\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e?\u00bb
    \u041e\u043d \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u043b\u0441\u044f \u0442\u0435\u043c,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0437\u0430\u0434\u0430\u0447\u0438 \u043d\u0438\u043a\u0442\u043e
    \u043d\u0435 \u043c\u043e\u0433 \u0440\u0435\u0448\u0438\u0442\u044c \u0433\u043e\u0434\u0430\u043c\u0438.
    \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b: \u0415\u0441\u043b\u0438
    \u0431\u044b \u0435\u0433\u043e \u0441\u044b\u043d \u0421\u0430\u043c\u044e\u044d\u043b\u044c
    \u043d\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0435\u0433\u043e
    \u043f\u0438\u0441\u044c\u043c\u0430 \u0438 \u0437\u0430\u043c\u0435\u0442\u043a\u0438 \u0432
    1679 \u0433\u043e\u0434\u0443, \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043e
    \u043c\u043e\u0433\u043b\u043e \u0431\u044b \u043f\u043e\u0442\u0435\u0440\u044f\u0442\u044c
    \u0446\u0435\u043b\u044b\u0439 \u043f\u043b\u0430\u0441\u0442 \u0432\u0435\u043b\u0438\u043a\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f.
    2. \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0438 \u00ab\u0421\u0430\u043c\u044b\u0439 \u0434\u0435\u0440\u0437\u043a\u0438\u0439 \u0440\u043e\u0437\u044b\u0433\u0440\u044b\u0448\u00bb
    \u0412 1637 \u0433\u043e\u0434\u0443 \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u043f\u0438\u0441\u0430\u043b
    \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \u043a\u043d\u0438\u0433\u0438 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0444\u0440\u0430\u0437\u0443:
    \u00ab\u042f \u043d\u0430\u0448\u0435\u043b \u044d\u0442\u043e\u043c\u0443 \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e,
    \u043d\u043e \u043f\u043e\u043b\u044f \u043a\u043d\u0438\u0433\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0443\u0437\u043a\u0438 \u0434\u043b\u044f \u043d\u0435\u0433\u043e\u00bb. \u041c\u0438\u0441\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f
    \u0438\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0430? \u0411\u043e\u043b\u0435\u0435
    350 \u043b\u0435\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043b\u043e\u043c\u0430\u043b\u0438
    \u0433\u043e\u043b\u043e\u0432\u0443, \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u043d\u0430\u0439\u0442\u0438
    \u044d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e.
    \u0412 1994 \u0433\u043e\u0434\u0443 \u0423\u0430\u0439\u043b\u0441 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442
    (\u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0432\u044b\u0435
    \u0438 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b),
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0432 XVII \u0432\u0435\u043a\u0435. \u0412\u044b\u0432\u043e\u0434 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432:
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043d\u0430\u0443\u043a\u0438 \u0441\u043e\u0448\u043b\u0438\u0441\u044c \u0432\u043e \u043c\u043d\u0435\u043d\u0438\u0438,
    \u0447\u0442\u043e \u0424\u0435\u0440\u043c\u0430 \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f.
    \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0441\u0432\u043e\u0439 \u043c\u0435\u0442\u043e\u0434 \u00ab\u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e
    \u0441\u043f\u0443\u0441\u043a\u0430\u00bb \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430,
    \u043d\u043e \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \\( n=4 \\). \u0420\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u0432
    \u0435\u0433\u043e \u043d\u0430 \u0432\u0441\u0435 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \u0432 \u0443\u043c\u0435, \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043e\u0448\u0438\u0431\u043a\u0443.
    \u0422\u0430\u043a \u0447\u0442\u043e \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    350 \u043b\u0435\u0442 \u043c\u0438\u0440 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043d\u0430\u0439\u0442\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u043e\u0433\u043e,
    \u0447\u0435\u0433\u043e \u0443 \u0424\u0435\u0440\u043c\u0430 \u043f\u043e\u043f\u0440\u043e\u0441\u0442\u0443
    \u043d\u0435 \u0431\u044b\u043b\u043e! \u042d\u0442\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0430\u044f
    \u00ab\u0448\u0443\u0442\u043a\u0430\u00bb \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. 3. \u00ab\u0422\u0435\u043b\u0435\u043f\u043e\u0440\u0442\u00bb
    \u0438\u0434\u0435\u0439: \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 \u0447\u0435\u0440\u0435\u0437
    \u043e\u043a\u0435\u0430\u043d \u0412 1640-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0443
    \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b \u044d\u043f\u0438\u0441\u0442\u043e\u043b\u044f\u0440\u043d\u044b\u0439
    \u0441\u043f\u043e\u0440 \u0441 \u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c
    \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443 \u043e\u043f\u0442\u0438\u043a\u0438 \u0438
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0435\u0440\u043d\u043e
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u0424\u0435\u0440\u043c\u0430,
    \u043d\u0430\u0437\u044b\u0432\u0430\u044f \u0435\u0433\u043e \u00ab\u0430\u0434\u0432\u043e\u043a\u0430\u0442\u043e\u043c\u00bb
    (\u0432 \u0443\u043d\u0438\u0447\u0438\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c
    \u0441\u043c\u044b\u0441\u043b\u0435) \u0438 \u00ab\u0445\u0432\u0430\u0441\u0442\u0443\u043d\u043e\u043c\u00bb.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u0440\u0438\u0441\u043b\u0430\u043b
    \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u0434\u0430\u0447\u0443 \u043d\u0430 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043a \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u043a\u0440\u0438\u0432\u043e\u0439, \u0431\u0443\u0434\u0443\u0447\u0438 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c,
    \u0447\u0442\u043e \u0442\u043e\u0442 \u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u0441\u044f.
    \u0424\u0435\u0440\u043c\u0430 \u0432 \u043e\u0442\u0432\u0435\u0442\u043d\u043e\u043c \u043f\u0438\u0441\u044c\u043c\u0435
    \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443 \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u0442\u0440\u043e\u043a. \u0414\u0435\u043a\u0430\u0440\u0442, \u0432\u0437\u0431\u0435\u0448\u0435\u043d\u043d\u044b\u0439,
    \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0424\u0435\u0440\u043c\u0430 \u2014 \u044d\u0442\u043e \u00ab\u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u044c\u00bb
    \u0438 \u00ab\u0438\u0433\u0440\u0430 \u0443\u043c\u0430, \u043b\u0438\u0448\u0435\u043d\u043d\u0430\u044f
    \u0441\u043c\u044b\u0441\u043b\u0430\u00bb. \u041f\u043e\u0437\u0436\u0435 \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u043f\u0440\u0430\u0432, \u0430 \u0414\u0435\u043a\u0430\u0440\u0442 \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f
    \u0432 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439.
    4. \u0414\u0432\u043e\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u0447\u0443\u043c\u044b \u0412 1652 \u0433\u043e\u0434\u0443
    \u0422\u0443\u043b\u0443\u0437\u0443 \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u0430 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044f
    \u0447\u0443\u043c\u044b. \u0412\u044b\u0436\u0438\u0432\u0430\u0435\u043c\u043e\u0441\u0442\u044c
    \u0431\u044b\u043b\u0430 \u043a\u0440\u0430\u0439\u043d\u0435 \u043d\u0438\u0437\u043a\u043e\u0439,
    \u0438 \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442 (\u0441\u0443\u0434) \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u043c\u043d\u043e\u0433\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432.
    \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u0440\u0430\u0437\u0438\u043b\u0441\u044f \u0438
    \u0431\u044b\u043b \u043f\u0440\u0438 \u0441\u043c\u0435\u0440\u0442\u0438. \u0415\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0416\u0430\u043d\u0430 \u0434\u0435 \u0411\u043e\u043a\u043a\u0430\u0440\u0430, \u043e\u0431\u044a\u044f\u0432\u0438\u043b\u0438
    \u0435\u0433\u043e \u0443\u043c\u0435\u0440\u0448\u0438\u043c \u0438 \u0434\u0430\u0436\u0435
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0430\u043d\u0435\u0433\u0438\u0440\u0438\u043a \u0432 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0424\u0435\u0440\u043c\u0430 \u0432\u044b\u0436\u0438\u043b.
    \u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043f\u043e\u043a\u043e\u0439\u043d\u0438\u043a\u043e\u043c,
    \u043e\u043d, \u043e\u0431\u043b\u0430\u0434\u0430\u044f \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c \u044e\u043c\u043e\u0440\u0430, \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043f\u0438\u0441\u044c\u043c\u043e \u0411\u043e\u043a\u043a\u0430\u0440\u0443 \u0441\u043e
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438: \u00ab\u042f \u0436\u0438\u0432 \u0438 \u0437\u0434\u043e\u0440\u043e\u0432,
    \u0432\u043e\u043f\u0440\u0435\u043a\u0438 \u0432\u0430\u0448\u0438\u043c \u043d\u0435\u043a\u0440\u043e\u043b\u043e\u0433\u0430\u043c.
    \u0421\u043c\u0435\u0440\u0442\u044c \u043d\u0435 \u043f\u043e\u0436\u0435\u043b\u0430\u043b\u0430
    \u043d\u0430\u0440\u0443\u0448\u0438\u0442\u044c \u043c\u043e\u0439 \u0434\u043e\u0441\u0443\u0433\u00bb.
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u043a\u043e\u043b\u043b\u0435\u0433
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e
    \u0432 1653 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043f\u043e \u0441\u043b\u0443\u0436\u0431\u0435,
    \u0441\u0442\u0430\u0432 \u0441\u0443\u0434\u044c\u0435\u0439 \u0432\u044b\u0441\u0448\u0435\u0433\u043e
    \u0440\u0430\u043d\u0433\u0430. 5. \u00ab\u041d\u0435\u0443\u0434\u043e\u0431\u043d\u044b\u0439\u00bb
    \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a \u0412 1660 \u0433\u043e\u0434\u0443, \u043f\u043e
    \u0441\u043b\u0443\u0447\u0430\u044e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0434\u043e\u0444\u0438\u043d\u0430
    (\u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0438\u043a\u0430 \u043f\u0440\u0435\u0441\u0442\u043e\u043b\u0430),
    \u0432 \u0422\u0443\u043b\u0443\u0437\u0435 \u0443\u0441\u0442\u0440\u043e\u0438\u043b\u0438
    \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0439 \u0444\u0435\u0439\u0435\u0440\u0432\u0435\u0440\u043a
    \u0438 \u043a\u0430\u0440\u043d\u0430\u0432\u0430\u043b. \u0412\u0441\u0435 \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0438
    \u043e\u0431\u044f\u0437\u0430\u043d\u044b \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c.
    \u0424\u0435\u0440\u043c\u0430 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u0448\u0443\u043c\u043d\u044b\u0435
    \u0441\u0431\u043e\u0440\u0438\u0449\u0430 \u0438 \u0441\u0432\u0435\u0442\u0441\u043a\u0443\u044e
    \u0441\u0443\u0435\u0442\u0443. \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0440\u0430\u043f\u043e\u0440\u0442, \u0447\u0442\u043e \u0431\u043e\u043b\u0435\u043d,
    \u0430 \u0441\u0430\u043c \u0432 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u0438\u0434\u0435\u043b
    \u0434\u043e\u043c\u0430 \u0438... \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u043b \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b.
    \u0421\u043e\u0441\u0435\u0434\u0438 \u0434\u043e\u043d\u0435\u0441\u043b\u0438 \u043d\u0430
    \u043d\u0435\u0433\u043e, \u0438 \u0435\u0433\u043e \u043e\u0448\u0442\u0440\u0430\u0444\u043e\u0432\u0430\u043b\u0438
    \u0437\u0430 \u043f\u0440\u043e\u0433\u0443\u043b \u0441\u043b\u0443\u0436\u0431\u044b.
    \u041e\u043d \u0441 \u044e\u043c\u043e\u0440\u043e\u043c \u0437\u0430\u043f\u043b\u0430\u0442\u0438\u043b
    \u0448\u0442\u0440\u0430\u0444, \u043e\u0442\u043c\u0435\u0442\u0438\u0432 \u0432 \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0435,
    \u0447\u0442\u043e \u00ab\u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0434\u0435\u0448\u0435\u0432\u043b\u0435,
    \u0447\u0435\u043c \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0432\u0435\u0447\u0435\u0440
    \u0432 \u0442\u043e\u043b\u043f\u0435\u00bb. 6. \u041f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0437\u043d\u0430\u043b \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439?
    \u0424\u0435\u0440\u043c\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u043d\u0430\u043b
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439 \u2014 \u043e\u043d \u0431\u044b\u043b
    \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u043e\u043c-\u043a\u043b\u0430\u0441\u0441\u0438\u043a\u043e\u043c.
    \u0415\u0433\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u043b\u0438 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u043f\u0440\u0438 \u0438\u0437\u0434\u0430\u043d\u0438\u0438
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 \u0438 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u044d\u0442\u043e\u043c\u0443 \u043e\u043d \u0447\u0438\u0442\u0430\u043b \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443\u00bb
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435.
    \u0410\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0435 \u0438 \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u0435
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0431\u044b\u043b\u0438 \u043f\u043e\u043b\u043d\u044b \u043e\u0448\u0438\u0431\u043e\u043a.
    \u0415\u0441\u043b\u0438 \u0431\u044b \u0424\u0435\u0440\u043c\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u043f\u043b\u043e\u0445\u0438\u043c \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u043c,
    \u043e\u043d, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u0431\u044b \u043d\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0412\u0435\u043b\u0438\u043a\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432 \u043f\u043b\u043e\u0445\u0438\u0445
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0431\u044b\u043b\u0438 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u044b.
    7. \u00ab\u0427\u0438\u0441\u043b\u0430 \u0424\u0435\u0440\u043c\u0430\u00bb \u0438 \u043e\u0448\u0438\u0431\u043a\u0430
    \u0432 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u0435 \u0424\u0435\u0440\u043c\u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u0447\u0438\u0441\u043b\u0430 \u0432\u0438\u0434\u0430
    \\( F_n = 2^{2^n} + 1 \\) \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438
    (\u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u043c\u0438). \u0414\u043b\u044f \\( n=0,1,2,3,4
    \\) \u044d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0442\u0430\u043a (3, 5, 17, 257, 65537). \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b
    \u0443\u0432\u0435\u0440\u0435\u043d, \u0447\u0442\u043e \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \\( n \\). \u0427\u0435\u0440\u0435\u0437 100
    \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u042d\u0439\u043b\u0435\u0440 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b
    \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0447\u0438\u0441\u043b\u043e \\(
    F_5 \\) \u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b, \u0447\u0442\u043e
    \u043e\u043d\u043e \u0434\u0435\u043b\u0438\u0442\u0441\u044f \u043d\u0430 641. \u0424\u0435\u0440\u043c\u0430
    \u043e\u0448\u0438\u0431\u0441\u044f! \u042d\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437
    \u0440\u0435\u0434\u043a\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u0435\u0432, \u043a\u043e\u0433\u0434\u0430
    \u0435\u0433\u043e \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f \u043f\u043e\u0434\u0432\u0435\u043b\u0430
    \u0435\u0433\u043e \u0432 \u0447\u0438\u0441\u043b\u0430\u0445, \u043d\u043e \u0441\u0430\u043c
    \u0444\u0430\u043a\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u044d\u0442\u0438\u0445 \u0447\u0438\u0441\u0435\u043b \u0441\u0435\u0439\u0447\u0430\u0441
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0446\u0438\u0440\u043a\u0443\u043b\u044f
    \u0438 \u043b\u0438\u043d\u0435\u0439\u043a\u0438. 8. \u0421\u043c\u0435\u0440\u0442\u044c
    \u0432 \u0441\u0443\u0434\u0435\u0439\u0441\u043a\u043e\u043c \u043a\u0440\u0435\u0441\u043b\u0435
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430
    \u0443\u0447\u0435\u043d\u044b\u0445, \u0443\u043c\u0435\u0440\u0448\u0438\u0445 \u0432
    \u0442\u0438\u0448\u0438\u043d\u0435 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043e\u0432,
    \u0424\u0435\u0440\u043c\u0430 \u0443\u0448\u0435\u043b \u0438\u0437 \u0436\u0438\u0437\u043d\u0438
    \u043f\u0440\u044f\u043c\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u044b.
    \u0412 \u044f\u043d\u0432\u0430\u0440\u0435 1665 \u0433\u043e\u0434\u0430 \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0440\u043e\u0432\u043a\u0435 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u0430\u0441\u0442\u0440, \u0433\u0434\u0435 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b\u0430
    \u0441\u0443\u0434\u0435\u0431\u043d\u0430\u044f \u0441\u0435\u0441\u0441\u0438\u044f. \u0412
    \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u0435 \u043c\u0435\u0436\u0434\u0443 \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u044f\u043c\u0438
    \u043e\u043d \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f
    \u043f\u043b\u043e\u0445\u043e (\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0443 \u043d\u0435\u0433\u043e \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u0438\u043d\u0441\u0443\u043b\u044c\u0442).
    \u041e\u043d \u0443\u043f\u0430\u043b \u043f\u0440\u044f\u043c\u043e \u0432 \u043c\u0430\u043d\u0442\u0438\u0438
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430. \u0415\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0438\u043b\u0438
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e, \u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0435\u0440\u0435\u0437 14 \u043b\u0435\u0442 \u043c\u0438\u0440 \u0443\u0437\u043d\u0430\u043b,
    \u043a\u043e\u0433\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u043b.
    9. \u0421\u044b\u043d-\u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044c: \u00ab\u0421\u0434\u0435\u043b\u0430\u043b
    \u044d\u0442\u043e \u043d\u0430\u0437\u043b\u043e\u00bb \u0421\u0430\u043c\u044e\u044d\u043b\u044c
    \u0424\u0435\u0440\u043c\u0430, \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d,
    \u0442\u043e\u0436\u0435 \u0431\u044b\u043b \u044e\u0440\u0438\u0441\u0442\u043e\u043c.
    \u041e\u043d \u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043b\u0441\u044f
    \u0432 \u0432\u044b\u0441\u0448\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0415\u0433\u043e \u043e\u0442\u0446\u0430 \u0443\u0436\u0435 \u043f\u043e\u0447\u0442\u0438
    \u0437\u0430\u0431\u044b\u043b\u0438 \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u0430\u0445
    (\u043f\u0440\u043e\u0448\u043b\u043e 14 \u043b\u0435\u0442), \u043a\u043e\u0433\u0434\u0430
    \u0421\u0430\u043c\u044e\u044d\u043b\u044c \u0440\u0435\u0448\u0438\u043b \u0438\u0437\u0434\u0430\u0442\u044c
    \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u00ab\u0420\u0430\u0437\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f\u00bb (Varia Opera Mathematica).
    \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u0441\u0447\u0438\u0442\u0430\u044e\u0442,
    \u0447\u0442\u043e \u0421\u0430\u043c\u044e\u044d\u043b\u044c \u0441\u0434\u0435\u043b\u0430\u043b
    \u044d\u0442\u043e \u0438\u0437 \u0447\u0438\u0441\u0442\u043e\u0433\u043e \u0443\u043f\u0440\u044f\u043c\u0441\u0442\u0432\u0430,
    \u0447\u0442\u043e\u0431\u044b \u00ab\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043e\u0442\u0446\u0430 \u043d\u0430 \u043e\u0434\u0438\u043d \u0443\u0440\u043e\u0432\u0435\u043d\u044c
    \u0441 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c\u00bb. \u0415\u0441\u043b\u0438
    \u0431\u044b \u043d\u0435 \u0430\u043c\u0431\u0438\u0446\u0438\u0438 \u0441\u044b\u043d\u0430,
    \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430
    \u043c\u043e\u0433\u043b\u0430 \u0431\u044b \u043a\u0430\u043d\u0443\u0442\u044c \u0432
    \u041b\u0435\u0442\u0443 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430. 10. \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0432 \u044f\u0437\u044b\u043a\u0435 \u0438 \u0431\u044b\u0442\u0443 \u0418\u043c\u044f
    \u0424\u0435\u0440\u043c\u0430 \u0432\u043e\u0448\u043b\u043e \u0432 \u043e\u0431\u0438\u0445\u043e\u0434
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043d\u0430\u0443\u043a\u0435.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u00ab\u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0424\u0435\u0440\u043c\u0430\u00bb \u0432 \u043e\u043f\u0442\u0438\u043a\u0435, \u00ab\u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0424\u0435\u0440\u043c\u0430\u00bb, \u00ab\u0427\u0438\u0441\u043b\u0430 \u0424\u0435\u0440\u043c\u0430\u00bb.
    \u0412 \u0422\u0443\u043b\u0443\u0437\u0435 \u0435\u0433\u043e \u0434\u043e\u043c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0441\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043c\u0443\u0437\u0435\u0435\u043c, \u0430 \u043d\u0430 \u0444\u0430\u0441\u0430\u0434\u0435
    \u0432\u0438\u0441\u0438\u0442 \u0442\u0430\u0431\u043b\u0438\u0447\u043a\u0430: \u00ab\u0417\u0434\u0435\u0441\u044c
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u041f\u044c\u0435\u0440 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c
    \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430, \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b
    \u0422\u0443\u043b\u0443\u0437\u0443 \u0441\u0432\u043e\u0438\u043c \u0433\u0435\u043d\u0438\u0435\u043c\u00bb.
    \u0412 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d
    \u041b\u0438\u0446\u0435\u0439 \u041f\u044c\u0435\u0440\u0430 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430
    \u2014 \u043e\u0434\u043d\u043e \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445
    \u0443\u0447\u0435\u0431\u043d\u044b\u0445 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0439
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u0420\u0435\u0437\u044e\u043c\u0438\u0440\u0443\u044e\u0449\u0438\u0439
    \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441: \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c,
    \u0430\u0432\u0442\u043e\u0440\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0438\u0447\u0435\u0433\u043e
    \u043d\u0435 \u043f\u0435\u0447\u0430\u0442\u0430\u043b, \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0447\u0430\u0441\u0442\u043e \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f
    \u0432 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430\u0445, \u043d\u043e \u0435\u0433\u043e
    \u043e\u0448\u0438\u0431\u043a\u0438 (\u043a\u0430\u043a \u0441 \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u043e\u0439) \u0434\u0432\u0438\u0433\u0430\u043b\u0438
    \u043d\u0430\u0443\u043a\u0443 \u0432\u043f\u0435\u0440\u0435\u0434 \u0433\u043e\u0440\u0430\u0437\u0434\u043e
    \u0441\u0438\u043b\u044c\u043d\u0435\u0435, \u0447\u0435\u043c \u0432\u0435\u0440\u043d\u044b\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433.
    \u041e\u043d \u2014 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0441\u0442\u0430\u0442\u0443\u0441\u0430, \u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u043b\u0438\u0448\u044c \u0441\u0442\u0440\u0430\u0441\u0442\u0438 \u043a \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044e."
