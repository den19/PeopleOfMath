    \u043e\u0434\u043d\u0430\u043a\u043e \u043e\u043d \u0432\u044b\u0436\u0438\u043b. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0438 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430
    \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0424\u0435\u0440\u043c\u0430 \u043f\u043e\u0447\u0442\u0438
    \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b. \u041e \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043c\u0438\u0440 \u0443\u0437\u043d\u0430\u0432\u0430\u043b
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0447\u0435\u0440\u0435\u0437
    \u043e\u0431\u0448\u0438\u0440\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438,
    \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442,
    \u0411\u043b\u0435\u0437 \u041f\u0430\u0441\u043a\u0430\u043b\u044c, \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043d
    \u0413\u044e\u0439\u0433\u0435\u043d\u0441, \u042d\u0432\u0430\u043d\u0434\u0436\u0435\u043b\u0438\u0441\u0442\u0430
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435.
    \u041f\u043e\u0441\u0440\u0435\u0434\u043d\u0438\u043a\u043e\u043c \u0432 \u044d\u0442\u043e\u0439
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u0430\u0431\u0431\u0430\u0442 \u041c\u0430\u0440\u0435\u043d \u041c\u0435\u0440\u0441\u0435\u043d\u043d,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0431\u0438\u0440\u0430\u043b \u0438
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u043b \u043f\u0438\u0441\u044c\u043c\u0430
    \u0441\u0440\u0435\u0434\u0438 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432. \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u0424\u0435\u0440\u043c\u0430
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0412 \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0443\u0434\u0435 \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0432 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u043b\u043e\u0441\u043a\u0438\u0445
    \u0438 \u0442\u0435\u043b\u0435\u0441\u043d\u044b\u0445 \u043c\u0435\u0441\u0442\u00bb (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e) \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u043a\u0430\u043a \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u043a\u0440\u0438\u0432\u044b\u0435
    \u043b\u0438\u043d\u0438\u0438. \u041e\u043d \u0434\u0430\u043b \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u043f\u0440\u044f\u043c\u043e\u0439 \u0438 \u043a\u0440\u0438\u0432\u044b\u0445 \u0432\u0442\u043e\u0440\u043e\u0433\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430, \u0434\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u043e\u043d\u0438 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u043c\u0438.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437:
    \u0424\u0435\u0440\u043c\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u043e\u0432 \u0438 \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u043e\u0432
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043c\u0435\u0442\u043e\u0434
    \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043a \u043a\u0440\u0438\u0432\u044b\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0431\u044b\u043b \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u0415\u0433\u043e \u043c\u0435\u0442\u043e\u0434
    \"\u0430\u0434\u0435\u043a\u0432\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438\" \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435
    \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0434\u043b\u044f \u043b\u044e\u0431\u044b\u0445 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439. \u0418\u0441\u0430\u0430\u043a
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u043e\u0437\u0436\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0438 \u0438\u0437 \"\u043c\u0435\u0442\u043e\u0434\u0430
    \u0424\u0435\u0440\u043c\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445\". \u041a\u0440\u043e\u043c\u0435
    \u0442\u043e\u0433\u043e, \u0424\u0435\u0440\u043c\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043e\u0431\u0449\u0435\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439,
    \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u0430\u0436\u043d\u043e\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439: \u0412 1654 \u0433\u043e\u0434\u0443
    \u0432 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0441 \u0411\u043b\u0435\u0437\u043e\u043c
    \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u041e\u043d\u0438 \u0440\u0435\u0448\u0430\u043b\u0438 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u043c\u0438
    \u0438\u0433\u0440\u0430\u043c\u0438, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \"\u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435
    \u0441\u0442\u0430\u0432\u043e\u043a\". \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u044d\u0442\u043e\u043c\u0443 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0443
    \u0438\u0445 \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c\u0438
    \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u0438. \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0438
    \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b \u0424\u0435\u0440\u043c\u0430
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u043e\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0431\u044b\u043b\u0438 \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u044b
    \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \u0435\u0433\u043e \u044d\u043a\u0437\u0435\u043c\u043f\u043b\u044f\u0440\u0430
    \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430.
    \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430:
    \u0421\u0430\u043c\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u0435\u0433\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435: `x\u207f
    + y\u207f = z\u207f` \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438 `n > 2`. \u0420\u044f\u0434\u043e\u043c
    \u0441 \u044d\u0442\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \"\u042f \u043d\u0430\u0448\u0435\u043b \u044d\u0442\u043e\u043c\u0443
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u043d\u043e
    \u043f\u043e\u043b\u044f \u043a\u043d\u0438\u0433\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0443\u0437\u043a\u0438 \u0434\u043b\u044f \u043d\u0435\u0433\u043e\". \u042d\u0442\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0439 \u0431\u043e\u043b\u0435\u0435
    350 \u043b\u0435\u0442 \u0438 \u0431\u044b\u043b\u0430 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0432
    1994 \u0433\u043e\u0434\u0443 \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441\u043e\u043c.
    \u041c\u0430\u043b\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430:
    \u0412 1640 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u0430\u0436\u043d\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443: \u0435\u0441\u043b\u0438
    `p` \u2014 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0447\u0438\u0441\u043b\u043e, \u0430
    `a` \u2014 \u043b\u044e\u0431\u043e\u0435 \u0446\u0435\u043b\u043e\u0435 \u0447\u0438\u0441\u043b\u043e,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043d\u0435 \u0434\u0435\u043b\u0438\u0442\u0441\u044f
    \u043d\u0430 `p`, \u0442\u043e `a\u1d56\u207b\u00b9 \u2014 1` \u0434\u0435\u043b\u0438\u0442\u0441\u044f
    \u043d\u0430 `p`. \u042d\u0442\u0430 \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0439
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u041c\u0435\u0442\u043e\u0434 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e
    \u0441\u043f\u0443\u0441\u043a\u0430: \u0424\u0435\u0440\u043c\u0430 \u0438\u0437\u043e\u0431\u0440\u0435\u043b
    \u043c\u043e\u0449\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \"\u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c \u0441\u043f\u0443\u0441\u043a\u043e\u043c\".
    \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0435\u043c,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 \u0441 \u0446\u0435\u043b\u044b\u043c\u0438
    \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u043c. \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0424\u0435\u0440\u043c\u0430 \u0432 \u0444\u0438\u0437\u0438\u043a\u0435 \u0424\u0435\u0440\u043c\u0430
    \u0442\u0430\u043a\u0436\u0435 \u0432\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434 \u0432
