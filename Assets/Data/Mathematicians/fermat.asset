    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 \u0424\u0435\u0440\u043c\u0430
    \u0441\u043c\u043e\u0433 \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u043a\u043e\u043d
    \u0421\u043d\u0435\u043b\u043b\u0438\u0443\u0441\u0430 \u0434\u043b\u044f \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u0435\u0433\u043e \u043a \u0441\u043f\u043e\u0440\u0443 \u0441 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c
    \u043f\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c \u043e\u043f\u0442\u0438\u043a\u0438.
    \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041f\u044c\u0435\u0440 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    12 \u044f\u043d\u0432\u0430\u0440\u044f 1665 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u0430\u0441\u0442\u0440. \u041f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438
    \u0435\u0433\u043e \u0441\u044b\u043d \u0421\u0430\u043c\u044e\u044d\u043b\u044c \u0432
    1679 \u0433\u043e\u0434\u0443 \u0438\u0437\u0434\u0430\u043b \u0441\u0431\u043e\u0440\u043d\u0438\u043a
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432 \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c
    \"\u0420\u0430\u0437\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f\" (Varia opera mathematica), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u043c\u0438\u0440\u0443 \u043f\u043e \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u0443
    \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u0435\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f. \u0424\u0435\u0440\u043c\u0430, \u0431\u0443\u0434\u0443\u0447\u0438
    \u043f\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0438 \u044e\u0440\u0438\u0441\u0442\u043e\u043c,
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    XVII \u0432\u0435\u043a\u0430. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u0438
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d. \u0412 \u0422\u0443\u043b\u0443\u0437\u0435
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043d
    \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0439 \u0438 \u0441\u0430\u043c\u044b\u0439
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439 \u043b\u0438\u0446\u0435\u0439,
    \u0430 \u0434\u043e\u043c, \u0433\u0434\u0435 \u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f,
    \u043d\u044b\u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043c\u0443\u0437\u0435\u0435\u043c."
  shortBioEn: "Pierre Ferma is one of the greatest mathematicians in history, although he was a lawyer and a scientist in his free time, and he was at the origin of numbers theory, analytical geometry, differential and integrated computation, and probability theory. This is his detailed biography, and his childhood and education (1601-1631), Pierre Ferma was born on August 17, 1601 in the small town of Bomont de Loman, southern France.His father, Dominic Ferma, was a wealthy leather dealer and second consul (the mayor &apos; s assistant) of the city.Later, he studied at the University of Toulouse and then moved to Bordeaux, where he began his first major mathematical research in the late 1620s. In 1629, he was already working on the restoration of the lost work of Apollonia of the Pergian \"On flats\" and developed a method for finding maximum and minimums.In the same year, he bought the position of Parliamentary Adviser (court) in Toulouse and moved to that city, and he was given the right to change his name from Pierre Ferma to Pierre de Ferma, a lawyer and life in Toulouse from 1631 until the death of Ferm served as Parliamentary Adviser in Toulouse, known as a good lawyer, one of the best of his time.In 1634 he became a counsellor, in 1638 he was appointed to the criminal court, and in 1652 he was promoted to the highest level in the court; in 1631, Ferma married his distant relative Louise de Long, and had five children, the eldest of whom was Samuel, who, after his father &apos; s death, he gathered and published his maths in 1679.In the 1650's, the Farm was seriously ill by a plague that raged in the region, and the disease was so severe that his death was even mistakenly reported to his colleagues in Paris, but he survived, and the mathematical discoveries and correspondence in Farm's lifetime were hardly published.The scientific world has learned about his achievements mainly through extensive correspondence with other scientists such as René Descartes, Blaise Pascal, Christian Guygens, Evangelist Torricelli and others, which was often facilitated by Abbot Marin Mercenn, who collected and distributed letters to interested mathematicians.In his paper \"Introducing flat and physical places\" (postmortem published), he showed how curves of lines can be described by equations.Mathematical analysis: The farm developed a method for finding maximum and minimum functions and a method for conducting curves that were essentially the precursor to differential calculation. Its \"accealability\" method allowed for the identification of derivatives of degrees for any rational indicators. Isaac Newton later acknowledged that his own analytical ideas were derived from \"the Ferm method for conducting tangential measures\".In addition, the Farm has developed a general rule for the integration of degrees, which is an important part of the integrated calculation. The probability theory: In 1654, in correspondence with Blaise Pascal Ferma, laid the foundations of probability theory, and addressed the challenges of gambling, in particular the \"striking problem.\" Through this cooperation, they are considered to be the founders of this science.The famous Great Theorem and the Ferma Number Theorem theory are rightly considered to be the foundation of modern number theory. Most of its discoveries in this field have been recorded in the fields of its \"Arifmetics\" Diofant. The Greatest Theorem of Ferma: The most famous claim is: `xn + yn = zn' has no number of decisions at `n > 2'.Next to this, he wrote: \"I found this truly remarkable proof, but the fields of the book are too narrow for him.\" This theorem has remained unproven for more than 350 years and was finally proven only in 1994 by Andrew Wyls. The small theorem of Ferma: In 1640, he formulated an important theory: if `p' is a simple number and `a' is any whole number that is not divided by `p', then `ap-1-1-1' is divided by `p'.This theorem has become the foundation for all the elementary number theory. The method of endless descent: The Farm has invented a powerful method of proof, which it called \"continuous descent.\" This method has been used to prove to many of its theorems, in particular that the area of a rectangular triangle with whole sides cannot be a square. The Ferma principle in physics has also contributed to physics.In 1657, he formulated the principle of the least time for the spread of light, according to which light always moves along a path that takes the least time, and with this principle, the Farm was able to remove the Snellius law to break the light, which led to a dispute with Decart over optics, and Pierre de Ferma's death and legacy died on January 12, 1665 in Castr.After his death in 1679, his son Samuel published a compilation of his writings, \"Varia opera mathematica\", which allowed the world to appreciate the extent of his genius.In Toulouse, his name is named the oldest and most prestigious lyceum, and the house where he was born is now a museum."
  interestingFactsRu: "\u041f\u044c\u0435\u0440 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430 \u2014 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c,
    \u043e\u043a\u0443\u0442\u0430\u043d\u043d\u0430\u044f \u043e\u0440\u0435\u043e\u043b\u043e\u043c
    \u0442\u0430\u0439\u043d, \u043e\u0448\u0438\u0431\u043e\u043a, \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0437\u0440\u0435\u043d\u0438\u0439 \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u0435\u0439. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u0441\u043f\u043b\u043e\u0448\u043d\u043e\u0439 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435,
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a
    \u0433\u0435\u043d\u0438\u044f, \u043d\u043e \u0438 \u043a\u0430\u043a \u0436\u0438\u0432\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. 1. \u00ab\u0412\u0435\u043b\u0438\u043a\u0438\u0439
    \u041c\u043e\u043b\u0447\u0443\u043d\u00bb: \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d
    \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438.
    \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0424\u0435\u0440\u043c\u0430 \u043d\u0435
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u043d\u0438 \u043e\u0434\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e\u0434 \u0441\u0432\u043e\u0438\u043c \u0438\u043c\u0435\u043d\u0435\u043c (\u043b\u0438\u0448\u044c
    \u043f\u0430\u0440\u0443 \u0441\u0442\u0430\u0442\u0435\u0439 \u043f\u043e \u043e\u043f\u0442\u0438\u043a\u0435).
    \u041f\u0440\u0438\u0447\u0438\u043d\u0430: \u041e\u043d \u043d\u0435 \u0431\u044b\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c \u0438 \u043d\u0435 \u043d\u0443\u0436\u0434\u0430\u043b\u0441\u044f
    \u0432 \u0434\u0435\u043d\u044c\u0433\u0430\u0445 \u0438\u043b\u0438 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0432\u0430\u043d\u0438\u044f\u0445. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u00ab\u0445\u043e\u0431\u0431\u0438\u00bb
    \u0438 \u0444\u043e\u0440\u043c\u043e\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0434\u043e\u0441\u0443\u0433\u0430. \u0421\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441: \u0424\u0435\u0440\u043c\u0430 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043a\u0430\u043a \u0438\u0433\u0440\u0443.
    \u041e\u043d \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u0441\u044b\u043b\u0430\u043b \u043f\u0438\u0441\u044c\u043c\u0430
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c (\u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443,
    \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u044e, \u041f\u0430\u0441\u043a\u0430\u043b\u044e),
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0434\u0430\u0432\u0430\u043b \u043d\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u0430 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043e\u0442\u0432\u0435\u0442\u044b
    \u0438\u043b\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0438
    \u0437\u0430\u0434\u0430\u0447, \u0441\u043b\u043e\u0432\u043d\u043e \u0431\u0440\u043e\u0441\u0430\u044f
    \u0432\u044b\u0437\u043e\u0432: \u00ab\u0410 \u0441\u043b\u0430\u0431\u043e \u0432\u0430\u043c
    \u043d\u0430\u0439\u0442\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e?\u00bb
    \u041e\u043d \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u043b\u0441\u044f \u0442\u0435\u043c,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0437\u0430\u0434\u0430\u0447\u0438 \u043d\u0438\u043a\u0442\u043e
    \u043d\u0435 \u043c\u043e\u0433 \u0440\u0435\u0448\u0438\u0442\u044c \u0433\u043e\u0434\u0430\u043c\u0438.
    \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b: \u0415\u0441\u043b\u0438
    \u0431\u044b \u0435\u0433\u043e \u0441\u044b\u043d \u0421\u0430\u043c\u044e\u044d\u043b\u044c
    \u043d\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0435\u0433\u043e
    \u043f\u0438\u0441\u044c\u043c\u0430 \u0438 \u0437\u0430\u043c\u0435\u0442\u043a\u0438 \u0432
    1679 \u0433\u043e\u0434\u0443, \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043e
    \u043c\u043e\u0433\u043b\u043e \u0431\u044b \u043f\u043e\u0442\u0435\u0440\u044f\u0442\u044c
    \u0446\u0435\u043b\u044b\u0439 \u043f\u043b\u0430\u0441\u0442 \u0432\u0435\u043b\u0438\u043a\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f.
    2. \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0438 \u00ab\u0421\u0430\u043c\u044b\u0439 \u0434\u0435\u0440\u0437\u043a\u0438\u0439 \u0440\u043e\u0437\u044b\u0433\u0440\u044b\u0448\u00bb
    \u0412 1637 \u0433\u043e\u0434\u0443 \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u043f\u0438\u0441\u0430\u043b
    \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \u043a\u043d\u0438\u0433\u0438 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0444\u0440\u0430\u0437\u0443:
    \u00ab\u042f \u043d\u0430\u0448\u0435\u043b \u044d\u0442\u043e\u043c\u0443 \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e,
    \u043d\u043e \u043f\u043e\u043b\u044f \u043a\u043d\u0438\u0433\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0443\u0437\u043a\u0438 \u0434\u043b\u044f \u043d\u0435\u0433\u043e\u00bb. \u041c\u0438\u0441\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f
    \u0438\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0430? \u0411\u043e\u043b\u0435\u0435
    350 \u043b\u0435\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043b\u043e\u043c\u0430\u043b\u0438
    \u0433\u043e\u043b\u043e\u0432\u0443, \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u043d\u0430\u0439\u0442\u0438
    \u044d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e.
    \u0412 1994 \u0433\u043e\u0434\u0443 \u0423\u0430\u0439\u043b\u0441 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442
    (\u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0432\u044b\u0435
    \u0438 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b),
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0432 XVII \u0432\u0435\u043a\u0435. \u0412\u044b\u0432\u043e\u0434 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432:
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043d\u0430\u0443\u043a\u0438 \u0441\u043e\u0448\u043b\u0438\u0441\u044c \u0432\u043e \u043c\u043d\u0435\u043d\u0438\u0438,
    \u0447\u0442\u043e \u0424\u0435\u0440\u043c\u0430 \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f.
    \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0441\u0432\u043e\u0439 \u043c\u0435\u0442\u043e\u0434 \u00ab\u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e
    \u0441\u043f\u0443\u0441\u043a\u0430\u00bb \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430,
    \u043d\u043e \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \\( n=4 \\). \u0420\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u0432
    \u0435\u0433\u043e \u043d\u0430 \u0432\u0441\u0435 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \u0432 \u0443\u043c\u0435, \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043e\u0448\u0438\u0431\u043a\u0443.
    \u0422\u0430\u043a \u0447\u0442\u043e \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    350 \u043b\u0435\u0442 \u043c\u0438\u0440 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043d\u0430\u0439\u0442\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u043e\u0433\u043e,
    \u0447\u0435\u0433\u043e \u0443 \u0424\u0435\u0440\u043c\u0430 \u043f\u043e\u043f\u0440\u043e\u0441\u0442\u0443
    \u043d\u0435 \u0431\u044b\u043b\u043e! \u042d\u0442\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0430\u044f
    \u00ab\u0448\u0443\u0442\u043a\u0430\u00bb \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. 3. \u00ab\u0422\u0435\u043b\u0435\u043f\u043e\u0440\u0442\u00bb
    \u0438\u0434\u0435\u0439: \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 \u0447\u0435\u0440\u0435\u0437
    \u043e\u043a\u0435\u0430\u043d \u0412 1640-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0443
    \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b \u044d\u043f\u0438\u0441\u0442\u043e\u043b\u044f\u0440\u043d\u044b\u0439
    \u0441\u043f\u043e\u0440 \u0441 \u0420\u0435\u043d\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c
    \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443 \u043e\u043f\u0442\u0438\u043a\u0438 \u0438
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0435\u0440\u043d\u043e
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u0424\u0435\u0440\u043c\u0430,
    \u043d\u0430\u0437\u044b\u0432\u0430\u044f \u0435\u0433\u043e \u00ab\u0430\u0434\u0432\u043e\u043a\u0430\u0442\u043e\u043c\u00bb
    (\u0432 \u0443\u043d\u0438\u0447\u0438\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c
    \u0441\u043c\u044b\u0441\u043b\u0435) \u0438 \u00ab\u0445\u0432\u0430\u0441\u0442\u0443\u043d\u043e\u043c\u00bb.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0414\u0435\u043a\u0430\u0440\u0442 \u043f\u0440\u0438\u0441\u043b\u0430\u043b
    \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u0434\u0430\u0447\u0443 \u043d\u0430 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043a \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u043a\u0440\u0438\u0432\u043e\u0439, \u0431\u0443\u0434\u0443\u0447\u0438 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c,
    \u0447\u0442\u043e \u0442\u043e\u0442 \u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u0441\u044f.
    \u0424\u0435\u0440\u043c\u0430 \u0432 \u043e\u0442\u0432\u0435\u0442\u043d\u043e\u043c \u043f\u0438\u0441\u044c\u043c\u0435
    \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443 \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u0442\u0440\u043e\u043a. \u0414\u0435\u043a\u0430\u0440\u0442, \u0432\u0437\u0431\u0435\u0448\u0435\u043d\u043d\u044b\u0439,
    \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0424\u0435\u0440\u043c\u0430 \u2014 \u044d\u0442\u043e \u00ab\u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u044c\u00bb
    \u0438 \u00ab\u0438\u0433\u0440\u0430 \u0443\u043c\u0430, \u043b\u0438\u0448\u0435\u043d\u043d\u0430\u044f
    \u0441\u043c\u044b\u0441\u043b\u0430\u00bb. \u041f\u043e\u0437\u0436\u0435 \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u043f\u0440\u0430\u0432, \u0430 \u0414\u0435\u043a\u0430\u0440\u0442 \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f
    \u0432 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439.
    4. \u0414\u0432\u043e\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u0447\u0443\u043c\u044b \u0412 1652 \u0433\u043e\u0434\u0443
    \u0422\u0443\u043b\u0443\u0437\u0443 \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u0430 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044f
    \u0447\u0443\u043c\u044b. \u0412\u044b\u0436\u0438\u0432\u0430\u0435\u043c\u043e\u0441\u0442\u044c
    \u0431\u044b\u043b\u0430 \u043a\u0440\u0430\u0439\u043d\u0435 \u043d\u0438\u0437\u043a\u043e\u0439,
    \u0438 \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442 (\u0441\u0443\u0434) \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u043c\u043d\u043e\u0433\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432.
    \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u0440\u0430\u0437\u0438\u043b\u0441\u044f \u0438
    \u0431\u044b\u043b \u043f\u0440\u0438 \u0441\u043c\u0435\u0440\u0442\u0438. \u0415\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0416\u0430\u043d\u0430 \u0434\u0435 \u0411\u043e\u043a\u043a\u0430\u0440\u0430, \u043e\u0431\u044a\u044f\u0432\u0438\u043b\u0438
    \u0435\u0433\u043e \u0443\u043c\u0435\u0440\u0448\u0438\u043c \u0438 \u0434\u0430\u0436\u0435
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0430\u043d\u0435\u0433\u0438\u0440\u0438\u043a \u0432 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0424\u0435\u0440\u043c\u0430 \u0432\u044b\u0436\u0438\u043b.
    \u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043f\u043e\u043a\u043e\u0439\u043d\u0438\u043a\u043e\u043c,
    \u043e\u043d, \u043e\u0431\u043b\u0430\u0434\u0430\u044f \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c \u044e\u043c\u043e\u0440\u0430, \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043f\u0438\u0441\u044c\u043c\u043e \u0411\u043e\u043a\u043a\u0430\u0440\u0443 \u0441\u043e
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438: \u00ab\u042f \u0436\u0438\u0432 \u0438 \u0437\u0434\u043e\u0440\u043e\u0432,
    \u0432\u043e\u043f\u0440\u0435\u043a\u0438 \u0432\u0430\u0448\u0438\u043c \u043d\u0435\u043a\u0440\u043e\u043b\u043e\u0433\u0430\u043c.
    \u0421\u043c\u0435\u0440\u0442\u044c \u043d\u0435 \u043f\u043e\u0436\u0435\u043b\u0430\u043b\u0430
    \u043d\u0430\u0440\u0443\u0448\u0438\u0442\u044c \u043c\u043e\u0439 \u0434\u043e\u0441\u0443\u0433\u00bb.
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u043a\u043e\u043b\u043b\u0435\u0433
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e
    \u0432 1653 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043f\u043e \u0441\u043b\u0443\u0436\u0431\u0435,
    \u0441\u0442\u0430\u0432 \u0441\u0443\u0434\u044c\u0435\u0439 \u0432\u044b\u0441\u0448\u0435\u0433\u043e
    \u0440\u0430\u043d\u0433\u0430. 5. \u00ab\u041d\u0435\u0443\u0434\u043e\u0431\u043d\u044b\u0439\u00bb
    \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a \u0412 1660 \u0433\u043e\u0434\u0443, \u043f\u043e
    \u0441\u043b\u0443\u0447\u0430\u044e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0434\u043e\u0444\u0438\u043d\u0430
    (\u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0438\u043a\u0430 \u043f\u0440\u0435\u0441\u0442\u043e\u043b\u0430),
    \u0432 \u0422\u0443\u043b\u0443\u0437\u0435 \u0443\u0441\u0442\u0440\u043e\u0438\u043b\u0438
    \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0439 \u0444\u0435\u0439\u0435\u0440\u0432\u0435\u0440\u043a
    \u0438 \u043a\u0430\u0440\u043d\u0430\u0432\u0430\u043b. \u0412\u0441\u0435 \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0438
    \u043e\u0431\u044f\u0437\u0430\u043d\u044b \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c.
    \u0424\u0435\u0440\u043c\u0430 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u0448\u0443\u043c\u043d\u044b\u0435
    \u0441\u0431\u043e\u0440\u0438\u0449\u0430 \u0438 \u0441\u0432\u0435\u0442\u0441\u043a\u0443\u044e
    \u0441\u0443\u0435\u0442\u0443. \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0440\u0430\u043f\u043e\u0440\u0442, \u0447\u0442\u043e \u0431\u043e\u043b\u0435\u043d,
    \u0430 \u0441\u0430\u043c \u0432 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u0438\u0434\u0435\u043b
    \u0434\u043e\u043c\u0430 \u0438... \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u043b \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b.
    \u0421\u043e\u0441\u0435\u0434\u0438 \u0434\u043e\u043d\u0435\u0441\u043b\u0438 \u043d\u0430
    \u043d\u0435\u0433\u043e, \u0438 \u0435\u0433\u043e \u043e\u0448\u0442\u0440\u0430\u0444\u043e\u0432\u0430\u043b\u0438
    \u0437\u0430 \u043f\u0440\u043e\u0433\u0443\u043b \u0441\u043b\u0443\u0436\u0431\u044b.
    \u041e\u043d \u0441 \u044e\u043c\u043e\u0440\u043e\u043c \u0437\u0430\u043f\u043b\u0430\u0442\u0438\u043b
    \u0448\u0442\u0440\u0430\u0444, \u043e\u0442\u043c\u0435\u0442\u0438\u0432 \u0432 \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0435,
    \u0447\u0442\u043e \u00ab\u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0434\u0435\u0448\u0435\u0432\u043b\u0435,
    \u0447\u0435\u043c \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0432\u0435\u0447\u0435\u0440
    \u0432 \u0442\u043e\u043b\u043f\u0435\u00bb. 6. \u041f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0437\u043d\u0430\u043b \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439?
    \u0424\u0435\u0440\u043c\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u043d\u0430\u043b
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439 \u2014 \u043e\u043d \u0431\u044b\u043b
    \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u043e\u043c-\u043a\u043b\u0430\u0441\u0441\u0438\u043a\u043e\u043c.
    \u0415\u0433\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u043b\u0438 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u043f\u0440\u0438 \u0438\u0437\u0434\u0430\u043d\u0438\u0438
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 \u0438 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u044d\u0442\u043e\u043c\u0443 \u043e\u043d \u0447\u0438\u0442\u0430\u043b \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443\u00bb
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435.
    \u0410\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0435 \u0438 \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u0435
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0431\u044b\u043b\u0438 \u043f\u043e\u043b\u043d\u044b \u043e\u0448\u0438\u0431\u043e\u043a.
    \u0415\u0441\u043b\u0438 \u0431\u044b \u0424\u0435\u0440\u043c\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u043f\u043b\u043e\u0445\u0438\u043c \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u043c,
    \u043e\u043d, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u0431\u044b \u043d\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0412\u0435\u043b\u0438\u043a\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432 \u043f\u043b\u043e\u0445\u0438\u0445
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0431\u044b\u043b\u0438 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u044b.
    7. \u00ab\u0427\u0438\u0441\u043b\u0430 \u0424\u0435\u0440\u043c\u0430\u00bb \u0438 \u043e\u0448\u0438\u0431\u043a\u0430
    \u0432 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u0435 \u0424\u0435\u0440\u043c\u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u0447\u0438\u0441\u043b\u0430 \u0432\u0438\u0434\u0430
    \\( F_n = 2^{2^n} + 1 \\) \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438
    (\u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u043c\u0438). \u0414\u043b\u044f \\( n=0,1,2,3,4
    \\) \u044d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0442\u0430\u043a (3, 5, 17, 257, 65537). \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b
    \u0443\u0432\u0435\u0440\u0435\u043d, \u0447\u0442\u043e \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \\( n \\). \u0427\u0435\u0440\u0435\u0437 100
    \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u042d\u0439\u043b\u0435\u0440 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b
    \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0447\u0438\u0441\u043b\u043e \\(
    F_5 \\) \u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b, \u0447\u0442\u043e
    \u043e\u043d\u043e \u0434\u0435\u043b\u0438\u0442\u0441\u044f \u043d\u0430 641. \u0424\u0435\u0440\u043c\u0430
    \u043e\u0448\u0438\u0431\u0441\u044f! \u042d\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437
    \u0440\u0435\u0434\u043a\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u0435\u0432, \u043a\u043e\u0433\u0434\u0430
    \u0435\u0433\u043e \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f \u043f\u043e\u0434\u0432\u0435\u043b\u0430
    \u0435\u0433\u043e \u0432 \u0447\u0438\u0441\u043b\u0430\u0445, \u043d\u043e \u0441\u0430\u043c
    \u0444\u0430\u043a\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u044d\u0442\u0438\u0445 \u0447\u0438\u0441\u0435\u043b \u0441\u0435\u0439\u0447\u0430\u0441
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0446\u0438\u0440\u043a\u0443\u043b\u044f
    \u0438 \u043b\u0438\u043d\u0435\u0439\u043a\u0438. 8. \u0421\u043c\u0435\u0440\u0442\u044c
    \u0432 \u0441\u0443\u0434\u0435\u0439\u0441\u043a\u043e\u043c \u043a\u0440\u0435\u0441\u043b\u0435
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430
    \u0443\u0447\u0435\u043d\u044b\u0445, \u0443\u043c\u0435\u0440\u0448\u0438\u0445 \u0432
    \u0442\u0438\u0448\u0438\u043d\u0435 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043e\u0432,
    \u0424\u0435\u0440\u043c\u0430 \u0443\u0448\u0435\u043b \u0438\u0437 \u0436\u0438\u0437\u043d\u0438
    \u043f\u0440\u044f\u043c\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u044b.
    \u0412 \u044f\u043d\u0432\u0430\u0440\u0435 1665 \u0433\u043e\u0434\u0430 \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0440\u043e\u0432\u043a\u0435 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u0430\u0441\u0442\u0440, \u0433\u0434\u0435 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b\u0430
    \u0441\u0443\u0434\u0435\u0431\u043d\u0430\u044f \u0441\u0435\u0441\u0441\u0438\u044f. \u0412
    \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u0435 \u043c\u0435\u0436\u0434\u0443 \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u044f\u043c\u0438
    \u043e\u043d \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f
    \u043f\u043b\u043e\u0445\u043e (\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0443 \u043d\u0435\u0433\u043e \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u0438\u043d\u0441\u0443\u043b\u044c\u0442).
    \u041e\u043d \u0443\u043f\u0430\u043b \u043f\u0440\u044f\u043c\u043e \u0432 \u043c\u0430\u043d\u0442\u0438\u0438
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430. \u0415\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0438\u043b\u0438
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e, \u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0435\u0440\u0435\u0437 14 \u043b\u0435\u0442 \u043c\u0438\u0440 \u0443\u0437\u043d\u0430\u043b,
    \u043a\u043e\u0433\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u043b.
    9. \u0421\u044b\u043d-\u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044c: \u00ab\u0421\u0434\u0435\u043b\u0430\u043b
    \u044d\u0442\u043e \u043d\u0430\u0437\u043b\u043e\u00bb \u0421\u0430\u043c\u044e\u044d\u043b\u044c
    \u0424\u0435\u0440\u043c\u0430, \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d,
    \u0442\u043e\u0436\u0435 \u0431\u044b\u043b \u044e\u0440\u0438\u0441\u0442\u043e\u043c.
    \u041e\u043d \u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043b\u0441\u044f
    \u0432 \u0432\u044b\u0441\u0448\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0415\u0433\u043e \u043e\u0442\u0446\u0430 \u0443\u0436\u0435 \u043f\u043e\u0447\u0442\u0438
    \u0437\u0430\u0431\u044b\u043b\u0438 \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u0430\u0445
    (\u043f\u0440\u043e\u0448\u043b\u043e 14 \u043b\u0435\u0442), \u043a\u043e\u0433\u0434\u0430
    \u0421\u0430\u043c\u044e\u044d\u043b\u044c \u0440\u0435\u0448\u0438\u043b \u0438\u0437\u0434\u0430\u0442\u044c
    \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u00ab\u0420\u0430\u0437\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f\u00bb (Varia Opera Mathematica).
    \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u0441\u0447\u0438\u0442\u0430\u044e\u0442,
    \u0447\u0442\u043e \u0421\u0430\u043c\u044e\u044d\u043b\u044c \u0441\u0434\u0435\u043b\u0430\u043b
    \u044d\u0442\u043e \u0438\u0437 \u0447\u0438\u0441\u0442\u043e\u0433\u043e \u0443\u043f\u0440\u044f\u043c\u0441\u0442\u0432\u0430,
    \u0447\u0442\u043e\u0431\u044b \u00ab\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c
