  achievementsRu: "\u0425\u043e\u0442\u044f \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u043c \u043e\u0442\u0432\u0435\u0442\u0435
    \u043c\u044b \u0443\u0436\u0435 \u043a\u043e\u0441\u043d\u0443\u043b\u0438\u0441\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445
    \u0432\u0435\u0445, \u0437\u0434\u0435\u0441\u044c \u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439,
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u0438 \u0441\u0442\u0440\u043e\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u041f\u044c\u0435\u0440\u0430
    \u0424\u0435\u0440\u043c\u0430. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d
    \u0442\u0435\u043c, \u0447\u0442\u043e \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u0440\u0430\u0437\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u0432\u044b\u0441\u0448\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0447\u0430\u0441\u0442\u043e \u043e\u043f\u0435\u0440\u0435\u0436\u0430\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f. \u0412\u043e\u0442
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f, \u0440\u0430\u0437\u0431\u0438\u0442\u044b\u0435
    \u043f\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c \u043d\u0430\u0443\u043a\u0438
    \u0441 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u044b\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435\u043c
    \u0441\u0443\u0442\u0438 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430.
    1. \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b (\u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434) \u0424\u0435\u0440\u043c\u0430 \u043f\u043e \u043f\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u00ab\u043e\u0442\u0446\u043e\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b\u00bb. \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0438, \u0430 \u0441\u043e\u0437\u0434\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044e \u0434\u043b\u044f \u0438\u0445
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430. \u0412\u0435\u043b\u0438\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430 (\u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f):
    \u0421\u0443\u0442\u044c: \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \\( a^n + b^n = c^n \\) \u043d\u0435
    \u0438\u043c\u0435\u0435\u0442 \u043d\u0435\u043d\u0443\u043b\u0435\u0432\u044b\u0445 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438 \\( n > 2 \\). \u0414\u0435\u0442\u0430\u043b\u0438:
    \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u043f\u0438\u0441\u0430\u043b \u044d\u0442\u043e
    \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0441 \u043f\u043e\u043c\u0435\u0442\u043a\u043e\u0439,
    \u0447\u0442\u043e \u043d\u0430\u0448\u0435\u043b \u00ab\u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0447\u0443\u0434\u0435\u0441\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u00bb.
    \u042d\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b \u043d\u0430 350 \u043b\u0435\u0442.
    \u0414\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441\u043e\u043c
    \u0432 1994 \u0433\u043e\u0434\u0443 \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445
    \u0438 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c
    (\u0442\u043e\u0433\u043e, \u0447\u0435\u0433\u043e \u0432 XVII \u0432\u0435\u043a\u0435
    \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e).
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442, \u0447\u0442\u043e \u0441\u0430\u043c \u0424\u0435\u0440\u043c\u0430
    \u043c\u043e\u0433 \u0438\u043c\u0435\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \\( n=4 \\), \u043d\u043e \u043e\u0448\u0438\u0431\u0441\u044f
    \u0432 \u043e\u0431\u0449\u0435\u043c \u0441\u043b\u0443\u0447\u0430\u0435. \u041c\u0430\u043b\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430: \u0421\u0443\u0442\u044c:
    \u0415\u0441\u043b\u0438 \\( p \\) \u2014 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0447\u0438\u0441\u043b\u043e,
    \u0430 \\( a \\) \u2014 \u0446\u0435\u043b\u043e\u0435 \u0447\u0438\u0441\u043b\u043e, \u043d\u0435
    \u0434\u0435\u043b\u044f\u0449\u0435\u0435\u0441\u044f \u043d\u0430 \\( p \\), \u0442\u043e
    \\( a^{p-1} \\equiv 1 \\pmod{p} \\). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430 \u0434\u043b\u044f \u0442\u0435\u0441\u0442\u043e\u0432
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u0443 \u0447\u0438\u0441\u0435\u043b
    (\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043b\u0438 \u0447\u0438\u0441\u043b\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u043c)
    \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0441 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c \u043a\u043b\u044e\u0447\u043e\u043c
    (\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c RSA). \u0424\u0435\u0440\u043c\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0451 \u0434\u043b\u044f \u0444\u0430\u043a\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u0438
    \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0447\u0438\u0441\u0435\u043b. \u041c\u0435\u0442\u043e\u0434
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0441\u043f\u0443\u0441\u043a\u0430:
    \u0421\u0443\u0442\u044c: \u042d\u0442\u043e \u043c\u043e\u0449\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043e\u0442
    \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u043e\u0433\u043e. \u0424\u0435\u0440\u043c\u0430
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b, \u0447\u0442\u043e \u0435\u0441\u043b\u0438
    \u0434\u043b\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u0442\u043e \u0432\u0441\u0435\u0433\u0434\u0430
    \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043c\u0435\u043d\u044c\u0448\u0435\u0435
    \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435.
    \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0442\u044c \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430 \u043d\u0435\u043b\u044c\u0437\u044f, \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c
    \u043a \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044e. \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435:
    \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u044d\u0442\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430
    \u043e\u043d \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 \u0441 \u0446\u0435\u043b\u044b\u043c\u0438
    \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u043c (\u043e\u0442\u0441\u044e\u0434\u0430
    \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0430 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \\( n=4 \\) \u0432 \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u0435).
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u0441\u0443\u043c\u043c\u0435 \u0434\u0432\u0443\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432: \u0421\u0443\u0442\u044c: \u041f\u0440\u043e\u0441\u0442\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \\( p \\) \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043c\u043e
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \u0434\u0432\u0443\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432 \\( p = x^2 + y^2 \\) \u0442\u043e\u0433\u0434\u0430
    \u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \\( p = 2 \\) \u0438\u043b\u0438 \\( p \\equiv 1 \\pmod{4} \\). \u0414\u0435\u0442\u0430\u043b\u0438:
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0447\u0438\u0441\u0435\u043b
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u043c\u0438 \u0444\u043e\u0440\u043c\u0430\u043c\u0438.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0435\u0440\u043c\u0430 \u043e \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445 (\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430):
    \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u043b\u044e\u0431\u043e\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0443\u043c\u043c\u043e\u0439
    \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 \\( n \\) \\( n \\)-\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043b\u044e\u0431\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u2014 \u0441\u0443\u043c\u043c\u0430 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435
    4 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435
    5 \u043f\u044f\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445 \u0438 \u0442.\u0434.).
    \u042d\u0442\u043e \u043f\u043e\u0437\u0436\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u041a\u043e\u0448\u0438. --- 2. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 (\u0418\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445)
    \u0424\u0435\u0440\u043c\u0430 \u0431\u044b\u043b \u043f\u0440\u044f\u043c\u044b\u043c \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430.
    \u041e\u043d \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u0437\u0434\u0430\u043b
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432
    \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0439
    \u0434\u043e \u043d\u0438\u0445. \u041c\u0435\u0442\u043e\u0434 \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u043e\u0432, \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u043e\u0432
    \u0438 \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 (\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435):
    \u0421\u0443\u0442\u044c: \u0424\u0435\u0440\u043c\u0430 \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u00ab\u043f\u0440\u0438\u0440\u0430\u0449\u0435\u043d\u0438\u044f\u00bb (\u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0438\u043c
    \u0435\u0433\u043e \\( e \\)). \u0427\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438
    \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0443\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \\( f(x) \\), \u043e\u043d \u043f\u0440\u0438\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u0432 \u0442\u043e\u0447\u043a\u0430\u0445 \\( x \\) \u0438 \\( x+e \\), \u0434\u0435\u043b\u0438\u043b
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c \u043d\u0430 \\( e \\), \u0430 \u0437\u0430\u0442\u0435\u043c
    \u043f\u0440\u0438\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b \\( e \\) \u043a \u043d\u0443\u043b\u044e.
    \u041f\u0440\u0438\u043c\u0435\u0440: \u0414\u043b\u044f \\( f(x) = x^2 \\): \\( (x+e)^2
    = x^2 \\Rightarrow 2xe + e^2 = 0 \\Rightarrow e(2x+e)=0 \\). \u0421\u043e\u043a\u0440\u0430\u0449\u0430\u044f
    \u043d\u0430 \\( e \\) \u0438 \u043e\u0442\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u044f
    \u0435\u0433\u043e (\u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0445\u043e\u0434),
    \u043f\u043e\u043b\u0443\u0447\u0430\u043b \\( 2x=0 \\). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0442\u043e\u0447\u043d\u043e\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439.
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u0440\u044f\u043c\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b,
    \u0447\u0442\u043e \u043e\u043f\u0438\u0440\u0430\u043b\u0441\u044f \u043d\u0430 \u00ab\u043c\u0435\u0442\u043e\u0434
    \u0424\u0435\u0440\u043c\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445\u00bb. \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u044b
    (\u0418\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435):
    \u0421\u0443\u0442\u044c: \u0424\u0435\u0440\u043c\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043e\u0431\u0449\u0438\u0439 \u043c\u0435\u0442\u043e\u0434 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043f\u043b\u043e\u0449\u0430\u0434\u0435\u0439 \u043f\u043e\u0434 \u043a\u0440\u0438\u0432\u044b\u043c\u0438
    \u0432\u0438\u0434\u0430 \\( y = x^n \\), \u0433\u0434\u0435 \\( n \\) \u2014 \u043b\u044e\u0431\u043e\u0435
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e
    (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u0438
    \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435, \u043a\u0440\u043e\u043c\u0435
    -1). \u0414\u0435\u0442\u0430\u043b\u0438: \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u044e
    \u0434\u043b\u044f \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u044f \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430
    \u043d\u0430 \u043d\u0435\u0440\u0430\u0432\u043d\u044b\u0435 \u0447\u0430\u0441\u0442\u0438
    (\u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043c\u0435\u0442\u043e\u0434\u0430
    \u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445 \u041a\u0430\u0432\u0430\u043b\u044c\u0435\u0440\u0438),
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0435\u043c\u0443
    \u0442\u043e\u0447\u043d\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b
    \\( \\int_0^a x^n dx = \\frac{a^{n+1}}{n+1} \\). \u042d\u0442\u043e \u0431\u044b\u043b \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0439
    \u0448\u0430\u0433 \u043a \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e. --- 3. \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0424\u0435\u0440\u043c\u0430 \u0441\u043e\u0437\u0434\u0430\u043b
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0441 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c, \u043d\u043e \u0435\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434 \u0431\u044b\u043b \u0431\u043e\u043b\u0435\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u043d\u044b\u043c
    \u0438 \u0443\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u043b\u043e\u0441\u043a\u0438\u0445
    \u0438 \u0442\u0435\u043b\u0435\u0441\u043d\u044b\u0445 \u043c\u0435\u0441\u0442\u00bb (1636):
    \u0421\u0443\u0442\u044c: \u0424\u0435\u0440\u043c\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u043f\u0440\u0430\u0432\u0438\u043b\u043e: \u043b\u044e\u0431\u043e\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0441 \u0434\u0432\u0443\u043c\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u043a\u0440\u0438\u0432\u0443\u044e
    \u043d\u0430 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438. \u041e\u043d \u0432\u0432\u0435\u043b
    \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b
    (\u043f\u0440\u0430\u0432\u0434\u0430, \u043e\u0441\u044c \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b\u0430 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439,
    \u0430 \u043d\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439,
    \u043a\u0430\u043a \u0441\u0435\u0439\u0447\u0430\u0441). \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f:
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432\u0441\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432\u0438\u0434\u0430 \\( Ax +
    By = C \\) \u2014 \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u044b\u0435, \u0430 \u0432\u0441\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432\u0438\u0434\u0430 \\( x^2
    = py \\), \\( xy = c \\) \u0438 \\( x^2 \\pm y^2 = r^2 \\) \u2014 \u044d\u0442\u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f (\u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b,
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u044b \u0438 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438/\u044d\u043b\u043b\u0438\u043f\u0441\u044b).
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0440\u0435\u0448\u0430\u0442\u044c
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0447\u0438\u0441\u0442\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438.
    --- 4. \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    (\u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c)
    \u0412 1654 \u0433\u043e\u0434\u0443 \u0432 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435
    \u0441 \u0411\u043b\u0435\u0437\u043e\u043c \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c
    \u0424\u0435\u0440\u043c\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0417\u0430\u0434\u0430\u0447\u0430 \u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u0441\u0442\u0430\u0432\u043e\u043a
    (Problem of Points): \u0423\u0441\u043b\u043e\u0432\u0438\u0435: \u0414\u0432\u0430 \u0438\u0433\u0440\u043e\u043a\u0430
    \u0438\u0433\u0440\u0430\u044e\u0442 \u0432 \u043a\u043e\u0441\u0442\u0438. \u0418\u0433\u0440\u0430
    \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u0434\u043d\u043e\u043c\u0443 \u0438\u0437 \u0438\u0433\u0440\u043e\u043a\u043e\u0432
    \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \\( n \\) \u043f\u043e\u0431\u0435\u0434,
    \u0430 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \\( m \\). \u041a\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u0431\u0430\u043d\u043a? \u0420\u0435\u0448\u0435\u043d\u0438\u0435
    \u0424\u0435\u0440\u043c\u0430: \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0432\u0448\u0435\u0433\u043e
    \u0440\u0435\u043a\u0443\u0440\u0440\u0435\u043d\u0442\u043d\u044b\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f,
    \u0424\u0435\u0440\u043c\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0443.
    \u041e\u043d \u043f\u043e\u0434\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b \u0432\u0441\u0435
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u0438\u0441\u0445\u043e\u0434\u044b
    \u0433\u0438\u043f\u043e\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f \u0438\u0433\u0440\u044b
    (\u043f\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u043b \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438)
    \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u043b \u0434\u043e\u043b\u044e \u043a\u0430\u0436\u0434\u043e\u0433\u043e
    \u0438\u0433\u0440\u043e\u043a\u0430 \u043a\u0430\u043a \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0445 \u0438\u0441\u0445\u043e\u0434\u043e\u0432
    \u043a \u043e\u0431\u0449\u0435\u043c\u0443 \u0447\u0438\u0441\u043b\u0443. \u042d\u0442\u043e
    \u0432\u0432\u0435\u043b\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f. --- 5. \u0424\u0438\u0437\u0438\u043a\u0430
    (\u041f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438) \u0424\u0435\u0440\u043c\u0430 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043f\u0442\u0438\u043a\u0435, \u043e\u0442\u043a\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044c
    \u043e\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0439 \u0414\u0435\u043a\u0430\u0440\u0442\u0430.
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \u0424\u0435\u0440\u043c\u0430 (1662): \u0421\u0443\u0442\u044c:
    \u0421\u0432\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f
    \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f \u0442\u043e\u0447\u043a\u0430\u043c\u0438
    \u043f\u043e \u043f\u0443\u0442\u0438, \u0434\u043b\u044f \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0435 \u0432\u0440\u0435\u043c\u044f.
    \u041e\u043f\u0440\u043e\u0432\u0435\u0440\u0436\u0435\u043d\u0438\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u0430:
    \u0414\u0435\u043a\u0430\u0440\u0442 \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e
    \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0441\u0432\u0435\u0442\u0430 \u0432 \u043f\u043b\u043e\u0442\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u0435 \u0432\u044b\u0448\u0435. \u0424\u0435\u0440\u043c\u0430,
    \u0438\u0441\u0445\u043e\u0434\u044f \u0438\u0437 \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0442\u0440\u043e\u0433\u043e
    \u0432\u044b\u0432\u0435\u043b \u0437\u0430\u043a\u043e\u043d \u0421\u043d\u0435\u043b\u043b\u0438\u0443\u0441\u0430
    (\u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f) \u0438 \u043f\u0440\u0438\u0448\u0435\u043b
    \u043a \u0432\u044b\u0432\u043e\u0434\u0443, \u0447\u0442\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c
    \u0441\u0432\u0435\u0442\u0430 \u0432 \u0431\u043e\u043b\u0435\u0435 \u043f\u043b\u043e\u0442\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u0435 \u043d\u0438\u0436\u0435, \u0447\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0432\u0435\u0440\u043d\u044b\u043c. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e\u0442 \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043f\u043e\u0437\u0436\u0435
    \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0432 \u0444\u0438\u0437\u0438\u043a\u0435
    (\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430).
    --- 6. \u041c\u0435\u0442\u043e\u0434\u044b \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0434\u043b\u0438\u043d \u043a\u0440\u0438\u0432\u044b\u0445 (\u0421\u043f\u0440\u044f\u043c\u043b\u0435\u043d\u0438\u0435)
    \u0424\u0435\u0440\u043c\u0430 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u043d\u0430\u0448\u0435\u043b \u0442\u043e\u0447\u043d\u0443\u044e \u0434\u043b\u0438\u043d\u0443
    \u0434\u0443\u0433\u0438 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043a\u0440\u0438\u0432\u044b\u0445.
    \u041e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u0434\u043b\u0438\u043d\u0443
    \u0434\u0443\u0433\u0438 \u043f\u043e\u043b\u0443\u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b \\( y = x^{3/2} \\). \u0414\u043b\u044f
    \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u0441\u0443\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445
    \u043e\u0442\u0440\u0435\u0437\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e \u0441\u0443\u0442\u0438 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0435\u043d
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0443\u043b\u0435
    \u0434\u043b\u0438\u043d\u044b \u0434\u0443\u0433\u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430
    \\( \\int \\sqrt{1+(y')^2} dx \\). \u042d\u0442\u043e \u0431\u044b\u043b \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0440\u0430\u043d\u043d\u0438\u0445 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. --- \u0418\u0442\u043e\u0433\u043e\u0432\u043e\u0435
    \u0440\u0435\u0437\u044e\u043c\u0435 \u0432\u043a\u043b\u0430\u0434\u0430 | \u041e\u0431\u043b\u0430\u0441\u0442\u044c
    \u043d\u0430\u0443\u043a\u0438 | \u041a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 | \u0412\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 | |:--- |:--- |:--- | | \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b | \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430,
    \u041c\u0430\u043b\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430, \u043c\u0435\u0442\u043e\u0434
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0441\u043f\u0443\u0441\u043a\u0430.
    | \u0421\u043e\u0437\u0434\u0430\u043b \u0447\u0438\u0441\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b \u043a\u0430\u043a \u043d\u0430\u0443\u043a\u0443; \u0434\u0430\u043b
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0434\u043b\u044f \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    (RSA). | | \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 | \u041c\u0435\u0442\u043e\u0434
    \u043a\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438 \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0443\u043c\u043e\u0432
    \u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u0438\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u0435
    \u043f\u0440\u0438\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043a \u043d\u0443\u043b\u044e.
    | \u041f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0439; \u043f\u043e\u0432\u043b\u0438\u044f\u043b
    \u043d\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430. | | \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 | \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0443\u0440\u0430
    \u043f\u0430\u0440\u0430\u0431\u043e\u043b \u043b\u044e\u0431\u043e\u0433\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430. | \u0420\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0443,
    \u043d\u0435\u043f\u043e\u0434\u0432\u043b\u0430\u0441\u0442\u043d\u0443\u044e \u0433\u0440\u0435\u043a\u0430\u043c;
    \u0434\u0430\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438.
    | | \u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    | \u041e\u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u043b\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0441 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043c\u0435\u0441\u0442\u0430\u043c\u0438 \u0442\u043e\u0447\u0435\u043a. | \u0421\u0432\u044f\u0437\u0430\u043b
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0440\u0435\u0448\u0430\u0442\u044c
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0447\u0435\u0440\u0442\u0435\u0436\u0435\u0439 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c\u0438.
    | | \u0424\u0438\u0437\u0438\u043a\u0430 (\u041e\u043f\u0442\u0438\u043a\u0430) | \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    + \u0432\u044b\u0432\u043e\u0434 \u0437\u0430\u043a\u043e\u043d\u0430 \u0421\u043d\u0435\u043b\u043b\u0438\u0443\u0441\u0430.
    | \u041e\u0441\u043d\u043e\u0432\u0430 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f; \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435
    \u043a\u043e\u0440\u043f\u0443\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u043e-\u0432\u043e\u043b\u043d\u043e\u0432\u043e\u0433\u043e
    \u0434\u0443\u0430\u043b\u0438\u0437\u043c\u0430 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c.
    | | \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c | \u041a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u044b\u0439
    \u0440\u0430\u0441\u0447\u0435\u0442 \u0448\u0430\u043d\u0441\u043e\u0432 \u043f\u0440\u0438
    \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u043c \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u043d\u0438\u0438
    \u0438\u0433\u0440\u044b. | \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u043e\u0439
    \u0431\u0430\u0437\u044b \u0434\u043b\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u0433\u0440. | \u0412\u0430\u0436\u043d\u043e\u0435
    \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u0435: \u0424\u0435\u0440\u043c\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430.
    \u041e\u043d \u043f\u043e\u0441\u044b\u043b\u0430\u043b \u043b\u0438\u0448\u044c \u0437\u0430\u0434\u0430\u0447\u0438
    \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0441\u0432\u043e\u0438\u043c
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c (\u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0432 \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u043a \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u044e
    \u0438 \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0443), \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044f
    \u0438\u0445. \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430
    \u00ab\u0431\u0440\u043e\u0441\u0430\u0442\u044c \u0432\u044b\u0437\u043e\u0432\u00bb \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c
    \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u0435\u0433\u043e \u0441\u0430\u043c\u044b\u043c
    \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u044b\u043c \u0433\u0435\u043d\u0438\u0435\u043c
    XVII \u0432\u0435\u043a\u0430."
  achievementsEn: "Although in the past we have touched upon the main milestones, I will present a systematic, as detailed as possible and as rigorous a scientific review of Pierre Ferm's achievements, his contribution is unique in that he laid the foundations for several sections of higher mathematics, often ahead of the moderns by decades, and his achievements, broken down by fields of science, explaining in detail the essence of each method.The number theory (Fundamental Contribution) of the Farm is rightly considered \"the father of modern number theory.\" It did not simply solve problems but created a methodology to prove them. The great Ferma theorem (last): The essence: To prove that the equation \\(a)n + bxn = c\\n\\) does not have a non-zero number of solutions at \\(n > 2 \\).This statement stimulated the development of the algebraic number theory for 350 years, proved by Andrew Wyles in 1994 using elliptical curves and modular forms (which did not exist in the 17th century).====Simple number====The farm used it to factor large numbers.==The method of endless descent: Sust: This is a powerful method of proof of disgust.The farm showed that if there is a whole solution for some equation, it is always possible to build a smaller whole solution. Since natural numbers cannot be reduced indefinitely, we are in conflict. Application: Using this method, it has strictly proven that the square of a rectangular triangle with whole sides cannot be square (this is where the impossibility of \\(n=4\\) in the Great Theorem followed).The theory of the sum of two squares: The essence: The simple number \\(p\\) is represented as the sum of two squares \\(p = x2 + y2 \\) when and only when \\(p = 2 \\) or \\(p\\equiv 1 \\pmod}\\). The details: This was the first major achievement in the theory of the representation of numbers in square forms.The Farm's Multi-angle Number Theorem (hypothesis): He argued that any natural number was the sum not more than \\(n\\) \\(n\\)-coal numbers (e.g. any number is the sum of not more than 4 squares, not more than 5 pentagons, etc.) which Kosha later proved. ---2.Mathematic analysis (Excuse of infinitely small) Farm was the direct predecessor of Newton and Leibnicus.He actually created an algorithm for finding derivatives and integrals a few decades before them. The method of finding the maximums, minimums and tangents (Difference): The farm introduced the concept of \"hence\" (i.e., to identify the extreme function \\(fx)\\), he equated the function values at points \\(x\\) and \\(x+e\\), divided the difference by \\(e\\) and then equated \\(e\\) to zero.Example: For \\(f(x) = x2 \\): \\(x+e)2 = x2 \\Rightarrow 2xe + e\\2 = 0 \\Rightarrow e(2x+e) = 0 \\). By reducing it by \\(e\\) and throwing it away (deciding transition), \\(2x=0 \\). The value: This was an accurate algebraic anticipation of derivative. Newton explicitly acknowledged that it was based on the \"Ferm method for conducting tangentials\".Quadrations (Integrating): The Farm developed a common method for calculating the area under the curves of the species \\(y = x~n\\), where \\(n\\) is any rational number (including fractions and negatives except -1). Details: He used geometric progress to break the interval into unequal parts (as opposed to the method of indivisible Cavalry), which enabled him to calculate accurately the integral \\(int_0\\a x\\n dx = \\frac{a\\n+1}}.This was a major step towards integrated calculation. ---------Ferm's analytical geometry created analytical geometry almost at the same time as Decart, but its approach was more algebraic and user-friendly to the number theory. \"Introduction to the study of flat and physical places\" (1636)--The essence: Farm has established a rule: any equation with two unknowns defines the curve on the plane.He introduced rectangular coordinates (truth, his axis was vertical, not horizontal, as it is now). Classification: He showed that all equations of the species \\(Ax + By = C \\) are straight, and all equations of the species \\(xx2 = py \\), \\(xy = c\\) and \\(xx2 \\pm y2 = r·2 \\) are conical sections (parabols, hyperbolas, and circumference/ellipse). This allowed geometric problems to be solved in algebraically.---4.In 1654, the probability theory (jointly with Pascal) in correspondence with Blaise Pascal Ferma laid down a strict mathematical basis for probability theory. The task of sharing rates (Problem of Points): The two players play in bones. The game is interrupted early when one player lacks \\(n\\) victory and the other \\(m\\).How is it fair to separate the bank? Ferm's decision: Unlike Pascal, who used the recurring equations, the Ferma used the combination. He calculated all possible outcomes of a hypothetical continuation of the game (choosing combinations) and defined each player's share as the ratio of favourable outcomes to total number. This introduced the notion of mathematical expectation. --5.Physics (Last-Time Principle) The Farm revolution in physical optics, abandoning the mechanistic explanations of Decart, the principle of Farm (1662): The essence: Light spreads between two points along the path that takes the least time to pass. Decart's rebuttal: Decart believed that the speed of light in a dense environment was higher.The farm, on the basis of its principle, mathematically strictly removed the Snellius (refrigeration) law and concluded that the speed of light in a denser environment was lower, which proved to be true. The significance: This principle later became the basis of the variation in physics (the principle of Hamilton's least action). --6 The methods of finding the length of curves (Straightening) the Farm was one of the first to find the exact length of the arc of some curves.He calculated the length of the arc of the semi-cubic parabola.-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------The quadratur of the parabol of any rational order. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .The basis of the variable calculation; the approval of the future volcular-wave dualism. ♪ ♪ The probability of a combination of the chances of early interrupting the game. ♪ The creation of a combination base for statistics and game theory. ♪ The point is that the Farm has almost never published its evidence. He only sent the results to his colleagues (in particular in letters to Robertval and Mercenn) to check them out.It is this habit of \"throwing a challenge\" to moderns that made him the most mysterious genius of the 17th century."
  personalLifeRu: "\u0412\u043d\u0435\u0448\u043d\u0435 \u0436\u0438\u0437\u043d\u044c \u041f\u044c\u0435\u0440\u0430
    \u0424\u0435\u0440\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u0432\u0435\u043b \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0431\u044b\u043b\u0430 \u0431\u044b \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0441\u043a\u0443\u0447\u043d\u0430 \u0434\u043b\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0430,
    \u0435\u0441\u043b\u0438 \u0431\u044b \u043d\u0435 \u0435\u0433\u043e \u0442\u0430\u0439\u043d\u0430\u044f,
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u0441\u0442\u044c.
    \u041e\u043d \u0431\u044b\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \"\u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0434\u0432\u0443\u0445 \u0436\u0438\u0437\u043d\u0435\u0439\":
    \u0434\u043d\u0435\u043c \u2014 \u0434\u043e\u0431\u0440\u043e\u0441\u043e\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u044e\u0440\u0438\u0441\u0442, \u043d\u043e\u0447\u044c\u044e \u0438 \u0432 \u0447\u0430\u0441\u044b
    \u0434\u043e\u0441\u0443\u0433\u0430 \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043c\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u0435\u0433\u043e \"\u0437\u0435\u043c\u043d\u043e\u0439\" \u0436\u0438\u0437\u043d\u0438.
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0421\u0435\u043c\u044c\u044f \u0438
    \u0417\u0430\u0433\u0430\u0434\u043a\u0430 \u0414\u0430\u0442\u044b \u041f\u044c\u0435\u0440
    \u0424\u0435\u0440\u043c\u0430 \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0431\u043e\u0433\u0430\u0442\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435 \u0432 \u0433\u0430\u0441\u043a\u043e\u043d\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u0411\u043e\u043c\u043e\u043d-\u0434\u0435-\u041b\u043e\u043c\u0430\u043d\u044c
    \u043d\u0430 \u044e\u0433\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0442\u043e\u0447\u043d\u0430\u044f \u0434\u0430\u0442\u0430 \u0435\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442
    \u0441\u043f\u043e\u0440\u044b \u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432.
    \u0422\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    17 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1601 \u0433\u043e\u0434\u0430, \u043e\u043f\u0438\u0440\u0430\u044f\u0441\u044c
    \u043d\u0430 \u0437\u0430\u043f\u0438\u0441\u044c \u043e \u043a\u0440\u0435\u0449\u0435\u043d\u0438\u0438.
    \u041d\u043e \u0435\u0441\u0442\u044c \u0438 \u0434\u0440\u0443\u0433\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f:
    \u043d\u0430 \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0438 \u0443\u043a\u0430\u0437\u0430\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0435\u0440 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    57 \u043b\u0435\u0442, \u0447\u0442\u043e \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442
    \u0434\u0430\u0442\u0443 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0430 1607
    \u0438\u043b\u0438 \u0434\u0430\u0436\u0435 1608 \u0433\u043e\u0434. \u041f\u0443\u0442\u0430\u043d\u0438\u0446\u0443
    \u0432\u043d\u043e\u0441\u0438\u0442 \u0442\u043e\u0442 \u0444\u0430\u043a\u0442, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446, \u0414\u043e\u043c\u0438\u043d\u0438\u043a
    \u0424\u0435\u0440\u043c\u0430 (\u0431\u043e\u0433\u0430\u0442\u044b\u0439 \u0442\u043e\u0440\u0433\u043e\u0432\u0435\u0446
    \u043a\u043e\u0436\u0435\u0439 \u0438 \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439
    \u043a\u043e\u043d\u0441\u0443\u043b), \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0434\u0432\u0430\u0436\u0434\u044b,
    \u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u0435\u0440\u0432\u044b\u0439
    \u0440\u0435\u0431\u0435\u043d\u043e\u043a \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u041f\u044c\u0435\u0440
    \u0443\u043c\u0435\u0440, \u0430 \u0438\u043c\u044f \u0431\u044b\u043b\u043e \u0434\u0430\u043d\u043e
    \u0432\u0442\u043e\u0440\u043e\u043c\u0443 \u0441\u044b\u043d\u0443 \u043e\u0442 \u0434\u0440\u0443\u0433\u043e\u0439
    \u043c\u0430\u0442\u0435\u0440\u0438. \u041c\u0430\u0442\u0435\u0440\u044c\u044e \u041f\u044c\u0435\u0440\u0430
    \u0431\u044b\u043b\u0430 \u041a\u043b\u0435\u0440 \u0434\u0435 \u041b\u043e\u043d\u0433.
    \u0412 \u0441\u0435\u043c\u044c\u0435, \u043a\u0440\u043e\u043c\u0435 \u043d\u0435\u0433\u043e,
    \u0431\u044b\u043b\u043e \u0435\u0449\u0435 \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439.
    \u0424\u0435\u0440\u043c\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0445\u043e\u0440\u043e\u0448\u0435\u0435
    \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u043e\u043d \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0437\u043d\u0430\u043b \u043b\u0430\u0442\u044b\u043d\u044c,
    \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439,
    \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439 \u0438 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a\u0438, \u043f\u0438\u0441\u0430\u043b \u0441\u0442\u0438\u0445\u0438
    \u0438 \u0441\u0447\u0438\u0442\u0430\u043b\u0441\u044f \u0442\u043e\u043d\u043a\u0438\u043c
    \u0437\u043d\u0430\u0442\u043e\u043a\u043e\u043c \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u043e\u0431\u0440\u0430\u0449\u0430\u043b\u0438\u0441\u044c \u0437\u0430 \u0441\u043e\u0432\u0435\u0442\u043e\u043c
    \u043f\u0440\u0438 \u0438\u0437\u0434\u0430\u043d\u0438\u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u043a\u043e\u0432.
    \u0411\u0440\u0430\u043a \u0438 \u0414\u0435\u0442\u0438 \u0412 1631 \u0433\u043e\u0434\u0443,
    \u0432 \u0433\u043e\u0434 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u0432\u043e\u0435\u0439
    \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b,
    \u0424\u0435\u0440\u043c\u0430 \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041b\u0443\u0438\u0437\u0435
    \u0434\u0435 \u041b\u043e\u043d\u0433 (Louise de Long), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u0435\u043c\u0443 \u0434\u0430\u043b\u044c\u043d\u0435\u0439
    \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u0446\u0435\u0439 \u043f\u043e
    \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u043e\u0439 \u043b\u0438\u043d\u0438\u0438.
    \u0418\u0445 \u0431\u0440\u0430\u043a \u0431\u044b\u043b, \u043f\u043e \u0432\u0441\u0435\u0439
    \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438, \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u044b\u043c
    \u0438 \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u043d\u044b\u043c, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c
    \u0435\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u043c\u0443
    \u043e\u0431\u0440\u0430\u0437\u0443 \u0436\u0438\u0437\u043d\u0438. \u0423 \u041f\u044c\u0435\u0440\u0430
    \u0438 \u041b\u0443\u0438\u0437\u044b \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u043f\u044f\u0442\u0435\u0440\u043e
    \u0434\u0435\u0442\u0435\u0439, \u0445\u043e\u0442\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442
    \u0441\u0435\u043c\u044c \u0438\u043b\u0438 \u0432\u043e\u0441\u0435\u043c\u044c. \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0438\u0437 \u043d\u0438\u0445 \u0431\u044b\u043b
    \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d, \u041a\u043b\u0435\u043c\u0430\u043d-\u0421\u0430\u043c\u044e\u044d\u043b\u044c
    (Cl\u00e9ment-Samuel). \u0418\u043c\u0435\u043d\u043d\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0435\u043c\u0443 \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u0445 \u0424\u0435\u0440\u043c\u0430: \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430 \u0421\u0430\u043c\u044e\u044d\u043b\u044c
    \u0441\u043e\u0431\u0440\u0430\u043b \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u043f\u0438\u0441\u044c\u043c\u0430 \u0438 \u0437\u0430\u043c\u0435\u0442\u043a\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0430 \u043f\u043e\u043b\u044f\u0445 \"\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\"
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u043e \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u0435. \u041a\u0430\u0440\u044c\u0435\u0440\u0430 \u042e\u0440\u0438\u0441\u0442\u0430
    \u0438 \"\u0412\u0442\u043e\u0440\u0430\u044f\" \u0416\u0438\u0437\u043d\u044c \u0424\u0435\u0440\u043c\u0430
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u043f\u0440\u0430\u0432\u0430 \u0432 \u041e\u0440\u043b\u0435\u0430\u043d\u0435 \u0438
    \u0432 1631 \u0433\u043e\u0434\u0443 \u0432\u044b\u043a\u0443\u043f\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430
    (conseiller) \u0432 \u041f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0435 \u0422\u0443\u043b\u0443\u0437\u044b
    \u2014 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0432\u044b\u0441\u0448\u0438\u0445
    \u0441\u0443\u0434\u043e\u0432 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u042d\u0442\u0430
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u0430\u0432\u0430\u043b\u0430
    \u0435\u043c\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e\u0445\u043e\u0434
    \u0438 \u0441\u0442\u0430\u0442\u0443\u0441, \u043d\u043e \u0438 \u043f\u0440\u0430\u0432\u043e
    \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043a \u0444\u0430\u043c\u0438\u043b\u0438\u0438
    \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u043a\u0443\u044e \u0447\u0430\u0441\u0442\u0438\u0446\u0443
    \"\u0434\u0435\", \u0441\u0442\u0430\u0432 \u041f\u044c\u0435\u0440\u043e\u043c \u0434\u0435
    \u0424\u0435\u0440\u043c\u0430. \u041e\u043d \u0431\u044b\u043b \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u0432\u044b\u043c
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u043e\u043c: \u0434\u043e\u0431\u0440\u043e\u0441\u043e\u0432\u0435\u0441\u0442\u043d\u044b\u043c,
    \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u044b\u043c \u0438 \u0447\u0435\u0441\u0442\u043d\u044b\u043c.
    \u042d\u0442\u043e \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u043b\u043e \u0435\u043c\u0443
    \u043a\u0430\u0440\u044c\u0435\u0440\u043d\u044b\u0439 \u0440\u043e\u0441\u0442: \u0432
    1638 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c
    \u0443\u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u0441\u0443\u0434\u0430, \u0430
    \u0432 1648-\u043c \u2014 \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u043b\u0430\u0442\u044b
    \u044d\u0434\u0438\u043a\u0442\u043e\u0432 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041a\u0430\u0441\u0442\u0440.
    \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u0435\u0433\u043e \u043a\u0430\u043a
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e, \u043d\u043e
    \"\u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0433\u043e \u0438 \u043f\u043e\u0433\u043b\u043e\u0449\u0435\u043d\u043d\u043e\u0433\u043e
    \u0441\u0432\u043e\u0438\u043c\u0438 \u043c\u044b\u0441\u043b\u044f\u043c\u0438\" \u0441\u0443\u0434\u044c\u044e.
    \u0412\u0441\u044f \u0435\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u043e\u0448\u043b\u0430 \u0432 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0438.
    \u041e\u043d \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    (\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0434\u0430\u043b\u044c\u043d\u0435\u0435
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u043e\u0441\u044c
    \u0432 1654 \u0433\u043e\u0434\u0443), \u0440\u0435\u0434\u043a\u043e \u043f\u043e\u043a\u0438\u0434\u0430\u043b
    \u0422\u0443\u043b\u0443\u0437\u0443 \u0438 \u0435\u0435 \u043e\u043a\u0440\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0432
    \u041f\u0430\u0440\u0438\u0436\u0435, \u0446\u0435\u043d\u0442\u0440\u0435 \u0442\u043e\u0433\u0434\u0430\u0448\u043d\u0435\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438. \u0418\u043c\u0435\u043d\u043d\u043e
    \u044d\u0442\u0430 \u0440\u0430\u0437\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0430 \u0435\u043c\u0443 \u0432\u0435\u0447\u0435\u0440\u0430
    \u0438 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435 \u0434\u043b\u044f \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0436\u0438\u0437\u043d\u0438 \u2014
    \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c, \u0421\u043c\u0435\u0440\u0442\u044c \u0438
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0412 1652 \u0433\u043e\u0434\u0443 \u043d\u0430
    \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u043e\u0431\u0440\u0443\u0448\u0438\u043b\u0430\u0441\u044c
    \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044f \u0447\u0443\u043c\u044b. \u0424\u0435\u0440\u043c\u0430
    \u0437\u0430\u0440\u0430\u0437\u0438\u043b\u0441\u044f, \u043d\u043e, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u043a\u043e\u043b\u043b\u0435\u0433-\u0441\u0443\u0434\u0435\u0439,
    \u0447\u0443\u0434\u043e\u043c \u0432\u044b\u0436\u0438\u043b. \u0415\u0433\u043e \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0441\u043c\u0435\u0440\u0442\u0435\u0439
    \u0432 \u0441\u0443\u0434\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438 \u0435\u043c\u0443
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432\u044b\u0441\u0448\u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0438 \u041f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430.
    \u041f\u044c\u0435\u0440 \u0434\u0435 \u0424\u0435\u0440\u043c\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    12 \u044f\u043d\u0432\u0430\u0440\u044f 1665 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u0430\u0441\u0442\u0440, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439
    \u0432\u044b\u0435\u0437\u0434\u043d\u043e\u0439 \u0441\u0435\u0441\u0441\u0438\u0438 \u0441\u0443\u0434\u0430.
    \u0415\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0438\u043b\u0438 \u0432 \u041a\u0430\u0441\u0442\u0440\u0435,
    \u043d\u043e \u043f\u043e\u0437\u0436\u0435 \u043f\u0440\u0430\u0445 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u043b\u0438
    \u0432 \u0441\u0435\u043c\u0435\u0439\u043d\u0443\u044e \u0443\u0441\u044b\u043f\u0430\u043b\u044c\u043d\u0438\u0446\u0443
    \u0432 \u0422\u0443\u043b\u0443\u0437\u0435. \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    \u0435\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0430 \u0431\u044b\u043b\u0430 \u0443\u0442\u0435\u0440\u044f\u043d\u0430.
    \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432, \u0438\u0437\u0434\u0430\u043d\u043d\u043e\u0435
    \u0441\u044b\u043d\u043e\u043c, \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043c\u0438\u0440: \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c, \u0447\u0442\u043e
    \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u0439 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u044e\u0440\u0438\u0441\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0415\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u0424\u0435\u0440\u043c\u0430 \u043a\u0430\u043a
    \u043f\u0440\u0438\u0432\u0435\u0442\u043b\u0438\u0432\u043e\u0433\u043e, \u0443\u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0448\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u044d\u0440\u0443\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432 \u043e\u0434\u043d\u043e\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0435 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043b
    \u0434\u043e\u0431\u0440\u043e\u0441\u043e\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430-\u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044f."
  personalLifeEn: "The life of Pierre Ferm outside, which he spent most of his time, would have been surprisingly boring for the biographer if it hadn't been for his secret, genius passion. He was a classic \"two-life man\": during the day, a lawyer of good faith, at night, and during leisure hours, one of the greatest minds in the history of mathematics. This is a detailed portrait of his \"earth\" life.The birth, the family and the Mystery of Dana Pierre Ferma was born in a wealthy family in the town of Bomont de Loman in southern France, but the exact date of his birth is still controversial among historians, traditionally referred to as 17 August 1601, based on a record of baptism, but there is another theory: his tombstone indicates that he died at the age of 57, which brings the date of birth back to 1607 or even 1608.His father, Dominic Ferma (rich leather merchant and town consul), was married twice, and perhaps the first child named Pierre died and the name was given to the second son by another mother.The farm received a good human education: he was brilliant in Latin, ancient Greek, Italian, and Spanish, and wrote poems and was considered a thin expert of antiquities who had been consulted for advice in the publication of classics.Their marriage seemed to have been calm and well-being in line with his regular way of life, and Pierre and Louise had five children, although some sources mentioned seven or eight, the most famous of which was the eldest son, Clément-Samuel.It is because of him that we know of the mathematical discoveries of the Farm: after his father's death, Samuel collected and published his letters and notes, including the famous record in the fields of Arifmetics of the Great Theorem, the career of Jurist and the Second Life of Ferma received a Bachelor of Laws degree in Orleans and, in 1631, he bought the position of King's Adviser (conseiller) in the Toulouse Parliament, one of the highest courts in France.This position gave him not only income and status, but also the right to add to the name of the noble part of de de, becoming Pierre de Ferma, an exemplary official: honest, careful and honest, which ensured his career: in 1638 he became a member of the criminal court and in 1648 he became a member of the House of Edicts in the city of Custre, and the documents of the time described him as an educated but \"dissenting and thought-absorbed\" judge.His entire professional life has been in the province, he has hardly travelled (the only long journey took place in 1654), rarely left Toulouse and her surroundings, and never been in Paris, the center of the then scientific life, which left him nights and weekends for his main life - mathematics - disease, death, and legacy in 1652, an epidemic of plague struck France.The farm was infected, but, unlike many of its colleagues, he survived by miracle, and his recovery and numerous deaths in court enabled him to become the highest judge of Parliament. Pierre de Ferma died on 12 January 1665 in Castr, during another court session, and was buried in Castre, but later in the family tomb in Toulouse, and his grave was lost during the French Revolution.The postmortem of his work, published by his son, shocked the scientific world by the fact that a modest provincial lawyer had revolutionized the theory of numbers, laid the foundations for analytical geometry and calculation of infinitely small, and founded a theory of probabilities with Pascal.His contemporaries described the Farm as a friendly, balanced and incredibly erudian man who, in one person, combined a good official and a genius amateur mathematician."
  shortBioRu: "\u041f\u044c\u0435\u0440 \u0424\u0435\u0440\u043c\u0430 \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u0445\u043e\u0442\u044f \u043f\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0438 \u043e\u043d \u0431\u044b\u043b \u044e\u0440\u0438\u0441\u0442\u043e\u043c
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043d\u0430\u0443\u043a\u043e\u0439
    \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.
