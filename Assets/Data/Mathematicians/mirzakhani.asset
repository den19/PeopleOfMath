    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432 \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u044b\u0445,
    \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u0435\u0442\u0430\u043b\u0435\u0439.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u044b \u0438\u0437
    \u0435\u0451 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0435\u0451 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043a\u0430\u043a \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u043d\u043e \u0438 \u043a\u0430\u043a \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e
