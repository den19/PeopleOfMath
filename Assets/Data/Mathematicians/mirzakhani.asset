  achievementsRu: "\u041c\u0430\u0440\u0438\u0430\u043c \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u043d\u0430 \u0441\u0442\u044b\u043a\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0415\u0451 \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c
    \u043d\u0430 \u0434\u0432\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438:
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u043c\u043e\u0434\u0443\u043b\u0435\u0439 \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439, \u0433\u0434\u0435
    \u043e\u043d\u0430 \u0440\u0435\u0448\u0438\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435
    \u0431\u0438\u043b\u044c\u044f\u0440\u0434\u043e\u0432, \u043a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u0442\u0430\u043b\u0430 \u00ab\u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0430\u043b\u043e\u0447\u043a\u0435\u00bb.\n\n\U0001F4D0
    \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043c\u043e\u0434\u0443\u043b\u0435\u0439
    \u0438 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u042d\u0442\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0432 \u0435\u0451
    \u043a\u0430\u0440\u044c\u0435\u0440\u0435. \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442:
    \u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u0434\u043b\u044f \u043e\u0431\u044a\u0451\u043c\u0430
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432 \u043c\u043e\u0434\u0443\u043b\u0435\u0439:
    \u0412 \u0434\u0432\u0443\u0445 \u0441\u0432\u043e\u0438\u0445 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442\u0430\u0445 2007 \u0433\u043e\u0434\u0430 \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u0432\u044b\u0432\u0435\u043b\u0430 \u044f\u0432\u043d\u0443\u044e \u0440\u0435\u043a\u0443\u0440\u0441\u0438\u0432\u043d\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043e\u0431\u044a\u0451\u043c\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u043c\u043e\u0434\u0443\u043b\u0435\u0439 \\( \\mathcal{M}_{g,n}(L) \\) \u2014 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0432\u0441\u0435\u0445 \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439
    \u0440\u043e\u0434\u0430 \\( g \\) \u0441 \\( n \\) \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0433\u0440\u0430\u043d\u0438\u0447\u043d\u044b\u043c\u0438 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430\u043c\u0438
    \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0439 \u0434\u043b\u0438\u043d\u044b \\( L \\).
    \u0420\u0430\u043d\u0435\u0435 \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0431\u044b\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u043b\u0438\u0448\u044c
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b,
    \u0438 \u0435\u0451 \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0430
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c
    \u044d\u0442\u0438 \u043e\u0431\u044a\u0451\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u043e\u0439
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0422\u0435\u0439\u0445\u043c\u044e\u043b\u043b\u0435\u0440\u0430.
    \u041e\u043d\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0430, \u0447\u0442\u043e
    \u044d\u0442\u0438 \u043e\u0431\u044a\u0451\u043c\u044b \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u043f\u043e\u043b\u0438\u043d\u043e\u043c\u0430\u043c\u0438 \u043e\u0442 \u0434\u043b\u0438\u043d
    \u0433\u0440\u0430\u043d\u0438\u0446, \u0430 \u0438\u0445 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u044b
    \u0441\u0432\u044f\u0437\u0430\u043d\u044b \u0441 \u0447\u0438\u0441\u043b\u0430\u043c\u0438
    \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0439 \u043d\u0430 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435 \u043c\u043e\u0434\u0443\u043b\u0435\u0439.
    \u041d\u043e\u0432\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0412\u0438\u0442\u0442\u0435\u043d\u0430:
    \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0441\u0432\u043e\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u0434\u043b\u044f \u043e\u0431\u044a\u0451\u043c\u043e\u0432, \u043e\u043d\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0430
    \u043d\u043e\u0432\u043e\u0435, \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0412\u0438\u0442\u0442\u0435\u043d\u0430 (\u043f\u0435\u0440\u0432\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u041c\u0430\u043a\u0441\u0438\u043c\u0443
    \u041a\u043e\u043d\u0446\u0435\u0432\u0438\u0447\u0443). \u042d\u0442\u0430 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442 \u0447\u0438\u0441\u043b\u0430 \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0439
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u0445
    \u043c\u043e\u0434\u0443\u043b\u0435\u0439 \u0441 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0435\u0439 \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435.
    \u0410\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u043a\u0430 \u0447\u0438\u0441\u043b\u0430
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445:
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    (2004) \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u043e\u043d\u0430 \u0440\u0435\u0448\u0438\u043b\u0430 \u0437\u0430\u0434\u0430\u0447\u0443
    \u043f\u043e\u0434\u0441\u0447\u0451\u0442\u0430 \u0447\u0438\u0441\u043b\u0430 \\( N(X,
    L) \\) \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0445
    \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 (\u043d\u0435
    \u0438\u043c\u0435\u044e\u0449\u0438\u0445 \u0441\u0430\u043c\u043e\u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0439)
    \u043d\u0430 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \\( X \\), \u0434\u043b\u0438\u043d\u0430
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0435 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442
    \\( L \\). \u041e\u043d\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0430, \u0447\u0442\u043e
    \u044d\u0442\u043e \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0441\u0442\u0451\u0442 \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043a\u0430\u043a: \\( N(X, L) \\sim c(X) \\cdot L^{6g-6} \\) \u043f\u0440\u0438 \\( L
    \\to \\infty \\), \u0433\u0434\u0435 \\( c(X) \\) \u2014 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430,
    \u0437\u0430\u0432\u0438\u0441\u044f\u0449\u0430\u044f \u043e\u0442 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438.
    \u042d\u0442\u043e\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0440\u043e\u0441\u0442 \u0447\u0438\u0441\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u0435\u0435, \u0447\u0435\u043c \u0440\u043e\u0441\u0442
    \u0432\u0441\u0435\u0445 \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    (\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044d\u043a\u0441\u043f\u043e\u043d\u0435\u043d\u0446\u0438\u0430\u043b\u0435\u043d),
    \u0447\u0442\u043e \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u043b\u043e\u0436\u043d\u0443\u044e
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u043f\u0435\u0442\u0435\u043b\u044c \u043d\u0430
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438.\n\n\U0001FA84 \u00ab\u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0430\u043b\u043e\u0447\u043a\u0435\u00bb
    \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u042d\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
