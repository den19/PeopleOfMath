    \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0414\u0440\u0443\u0433\u043e\u0439
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439:
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0430 \u0443\u0437\u043d\u0430\u043b\u0430,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u0430 \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    \u043f\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u0435,
    \u043e\u043d\u0430 \u043f\u0440\u0438\u043d\u044f\u043b\u0430 \u044d\u0442\u043e \u0437\u0430
    \u0448\u0443\u0442\u043a\u0443. \u0421\u0430\u043c\u0430 \u043e\u043d\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430,
    \u0447\u0442\u043e \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    \u043b\u0438\u0448\u044c \u0432 \u043d\u0430\u0434\u0435\u0436\u0434\u0435, \u0447\u0442\u043e
    \u044d\u0442\u043e \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u0442 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0438\u0434\u0442\u0438 \u043f\u043e \u0435\u0451 \u0441\u0442\u043e\u043f\u0430\u043c.\n\n\U0001F3B1
    \u0422\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0435
    \u0412 \u0435\u0451 \u0441\u0443\u0434\u044c\u0431\u0435 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0438
    \u0434\u0432\u0430 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u043e\u0431\u044b\u0442\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u0435\u0442
    \u0440\u043e\u0432\u043d\u043e 15 \u043b\u0435\u0442: 1. \u0412 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b \u0432 \u0418\u0440\u0430\u043d\u0435 \u043e\u043d\u0430 \u0447\u0443\u0434\u043e\u043c
    \u0432\u044b\u0436\u0438\u043b\u0430 \u0432 \u0441\u0442\u0440\u0430\u0448\u043d\u043e\u0439
    \u0430\u0432\u0430\u0440\u0438\u0438, \u043a\u043e\u0433\u0434\u0430 \u0430\u0432\u0442\u043e\u0431\u0443\u0441
    \u0441 \u043e\u0434\u043d\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u0430\u043c\u0438
    \u0443\u043f\u0430\u043b \u0432 \u043e\u0432\u0440\u0430\u0433, \u0438 \u0441\u0435\u043c\u044c
    \u0435\u0451 \u0434\u0440\u0443\u0437\u0435\u0439 \u043f\u043e\u0433\u0438\u0431\u043b\u0438.
    2. \u0420\u043e\u0432\u043d\u043e \u0447\u0435\u0440\u0435\u0437 15 \u043b\u0435\u0442 \u0435\u0439
    \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u0440\u0430\u043a \u0433\u0440\u0443\u0434\u0438, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043e\u043d\u0430 \u0431\u043e\u0440\u043e\u043b\u0430\u0441\u044c \u0447\u0435\u0442\u044b\u0440\u0435
    \u0433\u043e\u0434\u0430.\n\n\U0001F4A1 \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043d\u0438\u043a\u0442\u043e
    \u043d\u0435 \u043f\u043e\u043d\u044f\u043b \u0411\u0443\u0434\u0443\u0447\u0438 \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u0446\u0435\u0439,
    \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438 \u0443\u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u0441 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0430\u043c\u0438 \u043f\u043e
    \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041e\u0434\u0438\u043d \u0438\u0437 \u043d\u0438\u0445, \u041a\u0430\u0441\u0440\u0430
    \u0420\u0430\u0444\u0438, \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b, \u0447\u0442\u043e
    \u0434\u0430\u043b \u0435\u0439 \u0437\u0430\u0434\u0430\u0447\u0443, \u0430 \u043e\u043d\u0430
    \u043f\u0440\u0438\u0448\u043b\u0430 \u0441 \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c.
    \u041e\u043d \u043d\u0435 \u0441\u043c\u043e\u0433 \u0435\u0433\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c
    \u2014 \u043e\u043d\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u043b\u043e\u0436\u043d\u044b\u043c \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u043e
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u043d\u0430, \u043f\u043e \u0438\u0434\u0435\u0435, \u0435\u0449\u0451 \u043d\u0435
    \u0437\u043d\u0430\u043b\u0430. \u0415\u043c\u0443 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c
    \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0438\u0437\u0443\u0447\u0438\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c, \u0447\u0442\u043e
    \u0435\u0451 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u0440\u043d\u044b\u043c, \u043d\u043e
    \u0438 \u00ab\u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u0443\u043c\u043d\u044b\u043c\u00bb."
  interestingFactsEn: "Mariam Mirzahani's life is full of amazing contrasts and human, touching details, and these are the most interesting facts and chickens from her biography, which show her not only as a genius mathematician, but also as an unusual person.\n\nInstead of the formulas and the love of literature, perhaps the most famous chicken is her creative method of working. She didn't write the board with formulas, but rather with drawing. Mirzahani liked to spread huge sheets of paper on the floor and fill them with elaborate \"dudles\" — figures that look like characters of anime and bizarre patterns. Her daughter called it \"painting.\"For Mirzahani, this process was a way of \"staying together\" with the mathematical universe that she saw as a living, moving world, and her colleague pointed out that she did not see the challenges as complex logical puzzles, but as if she had \"observed out the window of how the inhabitants of the mathematical landscape live and interact\".It is worth noting that as a child, she dreamed of becoming a writer, and later admitted that math was like writing a novel with developing characters.\n\nFrom \"Dwin\" to the Olympic Championship Path to the top of mathematics was not sunk by roses. In the sixth grade of the school for gifted children, she was the best in all subjects except mathematics, where she received 16 points out of 20. As a perfectionist, she was so upset that she broke control and declared that she would no longer try to do so.However, the following year, thanks to her change of teacher, she not only fell in love with mathematics, but also became the first girl in Iran's International Mathematical Olympics in 1994 and won a gold medal with an ideal result in 1995, and her older brother became interested in science, telling her the story of how young Gauss instantly folded the numbers from 1 to 100.\n\nThe system's opposition and postmortem recognition of Mirzahani's life was closely associated with Iranian laws and customs, which produced several notable episodes: marriage to a non-Muslim: her husband, Jan Vondrack, is a Czech scientist; according to Iranian law, Iran's marriage to a non-Muslim does not admit that it created difficulties for their daughter Anahita when travelling to Iran.Photo without hijab: Since her death, Iranian newspapers have for the first time violated the strict ban on the publication of images of women with their heads unshielded, and have appeared on the front page with her photograph without hijab as a sign of grief.Calls for reforms: Her death was public and a group of Iranian parliamentarians demanded accelerated amendments that would allow the children of Iranian women from foreign husbands to acquire Iranian citizenship.\n\nHer husband, Jan Wondrack, admitted that he had not known that \"she is a superstar\" was learning many of her achievements from her friends, and that she had \"100-year-old plans\" for research in a variety of fields of mathematics.Another example is that when she found out she was an e-mail winner of the Fields Prize, she took it as a joke, and she said that she only accepted the awards in the hope that it would inspire others to follow her footsteps.\n\n♪ Tragic coincidences in her fate are two tragic events that divide her exactly 15 years: 1. In her student years in Iran, she died in a terrible accident when a bus with one-year-olds fell into a ravine and seven of her friends died. 2. 15 years later, she was diagnosed with breast cancer, which she fought for four years.\n\nThe brilliant solution that no one understood, being a schoolgirl, Mirzahani had already worked with the teachers of the olympic mathematics, one of them, Kasra Rafi, remembered that he gave her the task and she came up with the solution. He couldn't read it -- it was so complicated and used a complex analysis machine she didn't know yet.He had to first study the math she used to understand that her decision was not only true, but also \"excrucially smart\"."
