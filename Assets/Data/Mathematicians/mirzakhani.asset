    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u00ab\u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0430\u043b\u043e\u0447\u043a\u0435\u00bb,
    \u0441\u0442\u0430\u043b\u0430 \u043c\u043e\u0449\u043d\u0435\u0439\u0448\u0438\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c.
    \u041e\u043d\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0440\u0435\u0448\u0430\u0442\u044c
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0440\u0430\u043d\u0435\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438 \u0431\u0438\u043b\u044c\u044f\u0440\u0434\u043d\u043e\u0433\u043e
    \u0448\u0430\u0440\u0430 \u0432 \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430\u0445
    \u0441 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0443\u0433\u043b\u0430\u043c\u0438.
    \u042d\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u043c\u0438 \u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439
    \u043c\u043d\u043e\u0433\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0432\u0441\u0435\u0445 \u0442\u0430\u043a\u0438\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0415\u0451 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438: \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043d\u0430\u0447\u0430\u0442\u044b\u0435 \u041c\u0430\u0440\u0438\u0430\u043c, \u043e\u0442\u043a\u0440\u044b\u043b\u0438
    \u043d\u043e\u0432\u044b\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445,
    \u0430 \u0435\u0451 \u043c\u0435\u0442\u043e\u0434\u044b \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0442\u0441\u044f
    \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0451\u043d\u044b\u043c\u0438. \u041e\u0431\u0449\u0435\u0435
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0446\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0439
    \u0435\u0451 \u0440\u0430\u0431\u043e\u0442 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442
    1200."
  achievementsEn: "Mariam Mirzahani left a huge legacy working at the intersection of geometry, dynamics and topology, and her contribution can be divided into two key areas: the study of the space of the reman surface modules, where she has addressed the fundamental challenges of hyperbolic geometry, and innovative billiard dynamics, culminating in the \"magic stick theory\".\n\nThe key achievements include: the module space formula: in its two most important 2007 works, Mirzahani produced a clear recursive formula to calculate the size of modules \\(\\\\\\mathcal\\M}_\\g,n}(L)\\) — the space of all the rhman surfaces of the \\(g\\) with \\(n\\) the geodetic boundary components of the specified length \\(L\\).Previously, only a few results were known in this area, and its formula allowed for the systematic calculation of these volumes, which are a fundamental characteristic in Teichmüller theory, and it has shown that these volumes are polynomes from the length of the boundary and their coefficients are related to the numbers of intersections on the compacted space of the modules.New evidence of the Witten hypothesis: Using her formula for volume, she offered a new, unexpected proof of the Vitten hypothesis (the first piece of evidence is Maxim Kontevich). This hypothesis links the number of intersections in the modules to quantum gravity and is one of the central results in modern mathematical physics.Asymptotics of the number of simple geodetics: In its dissertation (2004) and subsequent work, it solved the task of counting the number \\(N(X, L)\\) of simple closed geodetic (without self-disclining) on the hyperbolic surface \\(X ) whose length does not exceed \\(L \\) \\(L \\) \\. It proved that this number is growing asymptotically as:(N(X, L) \\(sim c(X) \\cdot L\\6g-6}\\) at \\(L\\to \\infty \\) where \\(c(X) \\) is a surface-dependent constant.This result showed that the number of simple geodetics is much slower than that of all geodetics (which are exponential), reflecting the complex structure of many simple hinges on the surface.\n\nThe \"Theorem on the magic wand\" and the dynamics this direction links geometry to physical objectives and dynamic systems.The Orbit Classification Theorem: In working with Alex Eskin and Amir Mohammadi (published in 2014), it proved the fundamental theory of invariant and fixed measures for the action of the group \\(SL(2, \\matbb{R})\\) on the space of the Abel Differential modules (also known as \"translation surface space\"). This space is closely related to the dynamics of the pool in polygons.Their work, which is about 200 pages long, has solved a problem that mathematicians have been struggling on for over a century. Closing complex geodetics: together with her co-author Alex Eskin, she has proved that, unlike the physical geodetic, locking complex geodetic modules in space is always an algebraic sub-species. This discovery is surprisingly strong and unsuspicious, it has brought a structure to a place where only chaos has previously been seen.Application to billiards: The combination of these results, which has been informally referred to as \"the magic wand theory\", has become a powerful tool, and it can solve many previously unaffordable problems, such as predicting the trajectory of the pool ball in rational angle polygons; this has shown a deep connection between dynamic systems on a separate surface and the geometry of all such surfaces.Its work has had a tremendous impact on several fields of mathematics: the research that Mariam has initiated has opened new directions in geometry, topology and dynamic systems, and its methods are being actively used and developed by other scientists."
  personalLifeRu: "\u041c\u0430\u0440\u0438\u0430\u043c \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438,
    \u043f\u0440\u0438 \u0432\u0441\u0435\u0439 \u0441\u0432\u043e\u0435\u0439 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u0431\u044b\u043b\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u044b\u043c, \u0441\u0442\u043e\u0439\u043a\u0438\u043c
    \u0438 \u043e\u0447\u0435\u043d\u044c \u043b\u0438\u0447\u043d\u044b\u043c \u0432 \u0441\u0432\u043e\u0435\u043c
    \u043f\u043e\u0434\u0445\u043e\u0434\u0435 \u043a \u043d\u0430\u0443\u043a\u0435. \u0415\u0435
    \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0441\u0442\u0440\u0430\u0441\u0442\u044c
    \u0438 \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u043e, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430
    \u0431\u043b\u0438\u0437\u043a\u0438\u0445 \u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c
    \u0432\u0438\u0434\u0435\u0442\u044c \u043a\u0440\u0430\u0441\u043e\u0442\u0443 \u0432 \u0441\u043b\u043e\u0436\u043d\u043e\u043c
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0432\u0435\u0440\u0448\u0438\u043d\u0430\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c
    \u043d\u0435\u0434\u043e\u0441\u0442\u0438\u0436\u0438\u043c\u044b\u043c\u0438.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0441\u0435\u043c\u044c\u044f \u0438
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u041c\u0430\u0440\u0438\u0430\u043c
    \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    12 \u043c\u0430\u044f 1977 \u0433\u043e\u0434\u0430 \u0432 \u0422\u0435\u0433\u0435\u0440\u0430\u043d\u0435,
    \u0418\u0440\u0430\u043d, \u0438 \u0431\u044b\u043b\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044b\u043c
    \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c \u0432 \u0441\u0435\u043c\u044c\u0435.
    \u0415\u0435 \u043e\u0442\u0435\u0446, \u0410\u0445\u043c\u0430\u0434 \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438,
    \u0431\u044b\u043b \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c-\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u043a\u043e\u043c.
    \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043e\u043d\u0430 \u043c\u0435\u0447\u0442\u0430\u043b\u0430
    \u043d\u0435 \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0430
    \u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044f
    \u0438 \u043e\u0431\u043e\u0436\u0430\u043b\u0430 \u0447\u0438\u0442\u0430\u0442\u044c \u0440\u043e\u043c\u0430\u043d\u044b,
    \u0447\u0442\u043e \u0440\u0430\u0437\u0432\u0438\u043b\u043e \u0435\u0435 \u0431\u043e\u0433\u0430\u0442\u043e\u0435
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043d\u0430\u0443\u043a\u0435 \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b \u0435\u0435
    \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0431\u0440\u0430\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b \u0435\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u044e
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u041a\u0430\u0440\u043b \u0413\u0430\u0443\u0441\u0441
    \u0432 \u044e\u043d\u043e\u0441\u0442\u0438 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e
    \u0441\u043b\u043e\u0436\u0438\u043b \u0447\u0438\u0441\u043b\u0430 \u043e\u0442 1 \u0434\u043e
    100, \u0438 \u044d\u0442\u043e \u0443\u0432\u043b\u0435\u043a\u043b\u043e \u0435\u0435.\n\n\U0001F3EB
    \u0428\u043a\u043e\u043b\u044c\u043d\u044b\u0435 \u0433\u043e\u0434\u044b: \u043f\u0443\u0442\u044c
    \u043e\u0442 \u043d\u0435\u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0434\u043e \u0437\u043e\u043b\u043e\u0442\u0430 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434
    \u0412 \u0448\u0435\u0441\u0442\u043e\u043c \u043a\u043b\u0430\u0441\u0441\u0435, \u043a\u043e\u0433\u0434\u0430
    \u041c\u0430\u0440\u0438\u0430\u043c \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b\u0430
    \u0432 \u044d\u043b\u0438\u0442\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443 \u0424\u0430\u0440\u0437\u0430\u043d\u0435\u0433\u0430\u043d
    \u0434\u043b\u044f \u043e\u0434\u0430\u0440\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0432\u043e\u0447\u0435\u043a,
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0435\u0439 \u043d\u0435
    \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439
    \u0433\u043e\u0434 \u0441\u043c\u0435\u043d\u0438\u043b\u0441\u044f \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0432\u0435\u0440\u0438\u043b \u0432
    \u043d\u0435\u0435, \u0438 \u0442\u0430\u043b\u0430\u043d\u0442 \u041c\u0430\u0440\u0438\u0430\u043c
    \u0440\u0430\u0441\u043a\u0440\u044b\u043b\u0441\u044f. \u0412 \u0448\u043a\u043e\u043b\u0435
    \u043e\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0430\u0441\u044c \u0441
    \u0420\u043e\u0439\u0435\u0439 \u0411\u0435\u0445\u0435\u0448\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0442\u0430\u043a\u0436\u0435 \u0441\u0442\u0430\u043b\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c. \u0412\u043c\u0435\u0441\u0442\u0435
    \u043e\u043d\u0438 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043b\u0438
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u0448\u043a\u043e\u043b\u0435 \u043a\u0440\u0443\u0436\u043e\u043a
    \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0435 \u0434\u043b\u044f
    \u0434\u0435\u0432\u043e\u0447\u0435\u043a. \u0418\u0445 \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u043e
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e
    \u0432 1994 \u0433\u043e\u0434\u0443 \u043e\u043d\u0438 \u0441\u0442\u0430\u043b\u0438 \u043f\u0435\u0440\u0432\u044b\u043c\u0438
    \u0434\u0435\u0432\u0443\u0448\u043a\u0430\u043c\u0438 \u0432 \u0441\u0431\u043e\u0440\u043d\u043e\u0439
    \u0418\u0440\u0430\u043d\u0430 \u043d\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0435.
    \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438 \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043b\u0430
    \u0442\u0430\u043c \u0437\u043e\u043b\u043e\u0442\u0443\u044e \u043c\u0435\u0434\u0430\u043b\u044c,
    \u043d\u0430\u0431\u0440\u0430\u0432 41 \u0431\u0430\u043b\u043b \u0438\u0437 42, \u0430
    \u0432 1995 \u0433\u043e\u0434\u0443 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u043b\u0430
    \u0443\u0441\u043f\u0435\u0445, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0432\u0442\u043e\u0440\u0443\u044e
    \u0437\u043e\u043b\u043e\u0442\u0443\u044e \u043c\u0435\u0434\u0430\u043b\u044c \u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u043c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u0432 42 \u0431\u0430\u043b\u043b\u0430.\n\n\U0001F393
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0447\u0430\u043b\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0438 \u0412 1999 \u0433\u043e\u0434\u0443
    \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438 \u043e\u043a\u043e\u043d\u0447\u0438\u043b\u0430
    \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438
    \u0428\u0430\u0440\u0438\u0444\u0430 \u0432 \u0422\u0435\u0433\u0435\u0440\u0430\u043d\u0435
    \u0441\u043e \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0443\u0447\u0435\u0431\u044b \u043e\u043d\u0430
    \u043f\u0435\u0440\u0435\u0436\u0438\u043b\u0430 \u0442\u044f\u0436\u0435\u043b\u0443\u044e
    \u0430\u0432\u0430\u0440\u0438\u044e: \u0432 1998 \u0433\u043e\u0434\u0443 \u0430\u0432\u0442\u043e\u0431\u0443\u0441
    \u0441 \u043e\u0434\u043d\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u0430\u043c\u0438
    \u0443\u043f\u0430\u043b \u0432 \u043e\u0432\u0440\u0430\u0433, \u0441\u0435\u043c\u044c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u0433\u0438\u0431\u043b\u0438, \u043d\u043e
    \u041c\u0430\u0440\u0438\u0430\u043c \u0447\u0443\u0434\u043e\u043c \u0432\u044b\u0436\u0438\u043b\u0430.
    \u0412 \u0442\u043e\u043c \u0436\u0435 1999 \u0433\u043e\u0434\u0443 \u043e\u043d\u0430
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u0432 \u0421\u0428\u0410 \u0434\u043b\u044f
    \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443
    \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0415\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c
    \u0441\u0442\u0430\u043b \u041a\u0451\u0440\u0442\u0438\u0441 \u041c\u0430\u043a\u043c\u0443\u043b\u043b\u0435\u043d,
    \u0441\u0430\u043c \u043b\u0430\u0443\u0440\u0435\u0430\u0442 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438.\n\n\U0001F52C \u0420\u0430\u0431\u043e\u0442\u0430
    \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438
    \u0412 2004 \u0433\u043e\u0434\u0443 \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0437\u0430\u0449\u0438\u0442\u0438\u043b\u0430
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0435. \u041f\u043e\u0441\u043b\u0435
    \u044d\u0442\u043e\u0433\u043e \u043e\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0430 \u0441 2008 \u0433\u043e\u0434\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0412 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0435
    \u043e\u043d\u0430 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0430\u0441\u044c
    \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u0431\u0443\u0434\u0443\u0449\u0438\u043c \u043c\u0443\u0436\u0435\u043c,
    \u042f\u043d\u043e\u043c \u0412\u043e\u043d\u0434\u0440\u0430\u043a\u043e\u043c, \u0443\u0447\u0435\u043d\u044b\u043c
    \u0447\u0435\u0448\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u043c \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438. \u041e\u043d\u0438 \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c
    \u0432 2009 \u0433\u043e\u0434\u0443, \u0430 \u0432 2011 \u0433\u043e\u0434\u0443 \u0443
    \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u0434\u043e\u0447\u044c
    \u0410\u043d\u0430\u0445\u0438\u0442\u0430. \u0412\u043e\u043d\u0434\u0440\u0430\u043a \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b
    \u043e \u0435\u0435 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0446\u0435\u043b\u0435\u0443\u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0434\u0430\u0436\u0435 \u0432 \u043c\u0435\u043b\u043e\u0447\u0430\u0445: \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0435\u0439 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0443\u044e
    \u043f\u0440\u043e\u0431\u0435\u0436\u043a\u0443, \u043d\u043e \u0447\u0435\u0440\u0435\u0437
    \u043f\u043e\u043b\u0442\u043e\u0440\u0430 \u0447\u0430\u0441\u0430 \u043e\u043d \u0432\u044b\u0434\u043e\u0445\u0441\u044f,
    \u0430 \u043e\u043d\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b\u0430 \u0431\u0435\u0436\u0430\u0442\u044c
    \u0432 \u0442\u043e\u043c \u0436\u0435 \u0442\u0435\u043c\u043f\u0435. \u041a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438 \u0435\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u043d\u043e \u0438
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u041c\u0430\u043d\u0436\u0443\u043b
    \u0411\u0445\u0430\u0440\u0433\u0430\u0432\u0430, \u0432\u043c\u0435\u0441\u0442\u0435 \u0441
    \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043e\u043d\u0430 \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u0430
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e,
    \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439: \u043d\u0430 \u0446\u0435\u0440\u0435\u043c\u043e\u043d\u0438\u0438
    \u043c\u0435\u0434\u0430\u043b\u0438 \u043f\u0435\u0440\u0435\u043f\u0443\u0442\u0430\u043b\u0438,
    \u0438 \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u0447\u0443\u0436\u0430\u044f. \u041e\u043d\u0438 \u0441 \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0440\u0435\u0448\u0438\u043b\u0438
    \u044d\u0442\u0443 \"\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443\", \u043e\u0431\u043c\u0435\u043d\u044f\u0432\u0448\u0438\u0441\u044c
    \u043c\u0435\u0434\u0430\u043b\u044f\u043c\u0438 \u0438 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u0432\u0448\u0438\u0441\u044c
    \u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u043e\u0431\u043c\u0435\u043d\u0435,
    \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438
    \u0441\u0432\u043e\u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b. \u0415\u0435 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043d\u0430\u0434 \u00ab\u0442\u0435\u043e\u0440\u0435\u043c\u043e\u0439 \u043e \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u0430\u043b\u043e\u0447\u043a\u0435\u00bb \u0441 \u0410\u043b\u0435\u043a\u0441\u043e\u043c
    \u042d\u0441\u043a\u0438\u043d\u043e\u043c \u0431\u044b\u043b\u0430 \u043e\u043f\u0438\u0441\u0430\u043d\u0430
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u043a\u0430\u043a \u00ab\u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u043a\u0430\u00bb; \u043e\u043d\u0430 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0430
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u043d\u043e \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c
    \u042d\u0441\u043a\u0438\u043d\u0430, \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435
    \u043f\u0430\u043d\u0438\u043a\u043e\u0432\u0430\u043b\u0430, \u0434\u0430\u0436\u0435 \u043a\u043e\u0433\u0434\u0430
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c
    \u043d\u0435\u0434\u043e\u0441\u0442\u0438\u0436\u0438\u043c\u044b\u043c\u0438.\n\n\U0001F396
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f \u0412 2014 \u0433\u043e\u0434\u0443 \u041c\u0430\u0440\u0438\u0430\u043c
    \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438 \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439 \u0438 \u043f\u0435\u0440\u0432\u044b\u043c
    \u0438\u0440\u0430\u043d\u0446\u0435\u043c, \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u043c
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    \u2014 \u0441\u0430\u043c\u043e\u0439 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u0440\u0443\u0447\u0430\u0435\u0442\u0441\u044f
    \u0440\u0430\u0437 \u0432 \u0447\u0435\u0442\u044b\u0440\u0435 \u0433\u043e\u0434\u0430
    \u0443\u0447\u0435\u043d\u044b\u043c \u043d\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 40
    \u043b\u0435\u0442. \u041f\u043e\u043b\u0443\u0447\u0438\u0432 \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u0435
    \u043e \u043f\u0440\u0435\u043c\u0438\u0438 \u043f\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439
    \u043f\u043e\u0447\u0442\u0435, \u043e\u043d\u0430 \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u043f\u0440\u0438\u043d\u044f\u043b\u0430 \u0435\u0433\u043e \u0437\u0430 \u0448\u0443\u0442\u043a\u0443.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0431\u043e\u043b\u0435\u0437\u043d\u044c,
    \u043e\u043d\u0430 \u0441\u043c\u043e\u0433\u043b\u0430 \u043f\u0440\u0438\u0435\u0445\u0430\u0442\u044c
    \u043d\u0430 \u0446\u0435\u0440\u0435\u043c\u043e\u043d\u0438\u044e \u0432\u0440\u0443\u0447\u0435\u043d\u0438\u044f
    \u0432 \u0421\u0435\u0443\u043b. \u0413\u0440\u0443\u043f\u043f\u0430 \u0436\u0435\u043d\u0449\u0438\u043d-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0434\u0430\u0436\u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043b\u0430
    \u0434\u043b\u044f \u043d\u0435\u0435 \u043d\u0435\u0433\u043b\u0430\u0441\u043d\u0443\u044e
    \u043e\u0445\u0440\u0430\u043d\u0443, \"\u0449\u0438\u0442 \u041c.\u041c.\", \u0447\u0442\u043e\u0431\u044b
    \u043e\u0433\u0440\u0430\u0434\u0438\u0442\u044c \u043e\u0442 \u0438\u0437\u043b\u0438\u0448\u043d\u0435\u0433\u043e
    \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u043f\u0440\u0435\u0441\u0441\u044b \u0438
    \u043f\u043e\u043c\u043e\u0447\u044c \u0435\u0439 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e
    \u043d\u0430\u0441\u043b\u0430\u0434\u0438\u0442\u044c\u0441\u044f \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c.\n\n\u2626\ufe0f
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u0412
    2013 \u0433\u043e\u0434\u0443, \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e \u0434\u043e
    \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438, \u0443 \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u0440\u0430\u043a \u0433\u0440\u0443\u0434\u0438. \u041e\u043d\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430\u0434 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0434\u0430\u0436\u0435 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0442\u044f\u0436\u0435\u043b\u043e\u0433\u043e
    \u043b\u0435\u0447\u0435\u043d\u0438\u044f. \u041a 2017 \u0433\u043e\u0434\u0443 \u0431\u043e\u043b\u0435\u0437\u043d\u044c
    \u0434\u0430\u043b\u0430 \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u044b \u0432 \u043f\u0435\u0447\u0435\u043d\u044c
    \u0438 \u043a\u043e\u0441\u0442\u043d\u044b\u0439 \u043c\u043e\u0437\u0433. \u041c\u0430\u0440\u0438\u0430\u043c
    \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c
    14 \u0438\u044e\u043b\u044f 2017 \u0433\u043e\u0434\u0430 \u0432 \u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    40 \u043b\u0435\u0442."
  personalLifeEn: "Mariam Mirzahani, despite her genius, was a man deeply engaged, steadfast, and very personal in her approach to science, her life being a story about how passion and perseverance, support for loved ones and the ability to see beauty in complex things led to the tops that seemed impossible.\n\n==Early life==The birth, family and passion of Mariam Mirzahani was born on 12 May 1977 in Tehran, Iran, and was the fourth child in the family. Her father, Ahmad Mirzahani, was an electric engineer. She was a child who dreamed of a career in writing, rather than mathematics, and loved reading novels, which developed her imagination.Her older brother, who told her the story of Carl Gauss, as a young man, instantly folded the numbers from 1 to 100, and it attracted her.\n\n♪ School years: the way from uncertainty to gold olimpiad 6th grade when Mariam entered the elite school of Farzanegan for gifted girls, the first math teacher thought she lacked the ability, but the next year, a teacher who believed in her, and Mariam's talent opened up, and at school, she became a friend of Roya Beheshti, who also became an outstanding mathematician.Together, they organized the first computer science group for girls at the school, and their persistence led to their becoming Iran's first girls on the International Mathematical Olympics in 1994, winning the gold medal there, winning 41 out of 42, and repeating in 1995 the second gold medal with a maximum score of 42.\n\n==Early life============================================================================================================)===========================================)=================================================================================================Curtis McMullen, the winner of the Fields Prize, was the research director.\n\n==Career==Mirzahani worked and worked with her colleagues in 2004 to provide excellent protection for her Ph.D. in Harvard, and then she worked at Princeton University, and since 2008 she has become a professor of mathematics at Stanford University, and in Stanford she met her future husband, Ian Wondrak, a scientist of Czech origin, who was married in 2009 and had a daughter of Anahita in 2011.Vondrac recalled her incredible purpose, even in small matters: he offered her a joint run, but after an hour and a half, he was exhausted and she continued running at the same pace, and the colleagues celebrated her not only genius but also incredible modesty, and Mathematician Manjul Bhargawa, with whom she received the Fields Prize, recalled a funny case: the medals were confused, and everyone had a stranger.They and Mirzahani worked together to solve this \"combinatorial problem\" by exchanging medals and agreeing on the next exchange so that everyone would receive their awards. Her work on the \"magic stick theory\" with Alex Eskin was described by her colleagues as \"scientific fiction\"; she demanded great concentration, but Mirzahani, according to Eskin, never panicked, even when the results seemed impossible.\n\nRecognition: The Fields Award in 2014 was the first woman and the first Iranian to be awarded the Fields Prize, the most prestigious award in mathematics, which is awarded every four years to scientists under 40 years of age. After receiving an e-mail announcement of the Award, she first took it for a joke. Despite the illness, she was able to come to the Seoul ceremony.A group of women mathematicians even set up an unspoken security detail for her, \"Protection of M.M.,\" to protect her from undue press attention and help her enjoy the moment in peace.\n\n==Death==In 2013, shortly before receiving the Fields Prize, Mirzahani was diagnosed with breast cancer and continued to work on mathematics even during severe treatment. By 2017, the disease had metastases in her liver and bone marrow. Mariam Mirzahani died on July 14, 2017 at Stanford University Medical Center at the age of 40."
  shortBioRu: "\u041c\u0430\u0440\u0438\u0430\u043c \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u2014 \u0438\u0440\u0430\u043d\u0441\u043a\u0438\u0439 \u0438 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430 \u0438 \u043f\u0435\u0440\u0432\u044b\u0439 \u0438\u0440\u0430\u043d\u0435\u0446,
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u0435 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 (2014) \u0437\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u0438\u0445 \u043c\u043e\u0434\u0443\u043b\u0435\u0439. \u0415\u0451 \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0430\u043b\u0430\u043d\u0442\u0430, \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u043d\u0438\u044f
    \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0440\u0430\u043d\u043d\u0435\u0433\u043e
    \u0443\u0445\u043e\u0434\u0430, \u043d\u043e \u0435\u0451 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0442\u044c
    \u0443\u0447\u0451\u043d\u044b\u0445 \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443.\n\n\U0001F4DC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043f\u0443\u0442\u044c
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u041c\u0430\u0440\u0438\u0430\u043c
    \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    3 \u0438\u043b\u0438 12 \u043c\u0430\u044f 1977 \u0433\u043e\u0434\u0430 \u0432 \u0422\u0435\u0433\u0435\u0440\u0430\u043d\u0435,
    \u0418\u0440\u0430\u043d. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044b\u043c
    \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c \u0432 \u0441\u0435\u043c\u044c\u0435 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430-\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u043a\u0430
    \u0410\u0445\u043c\u0430\u0434\u0430 \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u0438 \u0417\u0430\u0445\u0440\u044b \u0425\u0430\u0433\u0438\u0433\u0438. \u0421 \u0440\u0430\u043d\u043d\u0438\u0445
    \u043b\u0435\u0442 \u041c\u0430\u0440\u0438\u0430\u043c \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0430\u0441\u044c
    \u0447\u0442\u0435\u043d\u0438\u0435\u043c \u0438 \u043c\u0435\u0447\u0442\u0430\u043b\u0430
    \u0441\u0442\u0430\u0442\u044c \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u0435\u043c. \u0418\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u043f\u0440\u043e\u0441\u043d\u0443\u043b\u0441\u044f
    \u0432 \u043d\u0435\u0439 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u0442\u0430\u0440\u0448\u0435\u043c\u0443
    \u0431\u0440\u0430\u0442\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0435\u0439 \u043e\u0431 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u0445 \u041a\u0430\u0440\u043b\u0430
    \u0413\u0430\u0443\u0441\u0441\u0430. \u0412 \u0448\u043a\u043e\u043b\u0435 \u0424\u0430\u0440\u0437\u0430\u043d\u0435\u0433\u0430\u043d,
    \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u043e\u0439
    \u0434\u043b\u044f \u043e\u0434\u0430\u0440\u0451\u043d\u043d\u044b\u0445 \u0434\u0435\u0432\u043e\u0447\u0435\u043a,
    \u0435\u0451 \u043f\u0443\u0442\u044c \u043d\u0435 \u0431\u044b\u043b \u043f\u0440\u043e\u0441\u0442\u044b\u043c:
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0443 \u043d\u0435\u0451 \u043d\u0435\u0442 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0441\u043c\u0435\u043d\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f
    \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u043f\u043e\u0434\u0440\u0443\u0433\u0438
    \u0420\u043e\u0438 \u0411\u0435\u0445\u0435\u0448\u0442\u0438 \u043f\u043e\u043c\u043e\u0433\u043b\u0438
    \u0435\u0439 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u0442\u044c
    \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u044f, \u043d\u043e \u0438 \u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0443\u0441\u043f\u0435\u0445\u043e\u0432.
    \u0423\u0436\u0435 \u0432 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0435 \u0433\u043e\u0434\u044b
    \u043e\u043d\u0430 \u043d\u0430\u0447\u0430\u043b\u0430 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438, \u0430
    \u0435\u0451 \u043f\u0435\u0440\u0432\u0430\u044f \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0430\u044f
    \u0432 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u0441\u0442\u0432\u0435, \u0431\u044b\u043b\u0430
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0430\u0444\u043e\u0432.\n\n\U0001F3C5 \u041e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u0438\u0435
    \u043f\u043e\u0431\u0435\u0434\u044b \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0412 1994 \u0438 1995 \u0433\u043e\u0434\u0430\u0445 \u041c\u0430\u0440\u0438\u0430\u043c
    \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u043e\u0439 \u0438\u0440\u0430\u043d\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u0446\u0435\u0439, \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u0432\u0448\u0435\u0439
    \u0437\u043e\u043b\u043e\u0442\u044b\u0435 \u043c\u0435\u0434\u0430\u043b\u0438 \u043d\u0430
    \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0435, \u043f\u0440\u0438\u0447\u0451\u043c
    \u0432 1995 \u0433\u043e\u0434\u0443 \u043e\u043d\u0430 \u0440\u0435\u0448\u0438\u043b\u0430
    \u0432\u0441\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u043c
    \u0431\u0430\u043b\u043b\u043e\u043c. \u0415\u0451 \u0442\u0430\u043b\u0430\u043d\u0442
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0438 \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438
    \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438 \u043f\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0440\u0430\u0441\u043a\u0440\u0430\u0441\u043a\u0438
    \u0433\u0440\u0430\u0444\u043e\u0432, \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0440\u0438\u0437 \u0432 10 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u043e\u0442
    \u0441\u0432\u043e\u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0430.
    \u0412 1999 \u0433\u043e\u0434\u0443 \u043e\u043d\u0430 \u043e\u043a\u043e\u043d\u0447\u0438\u043b\u0430
    \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438
    \u0428\u0430\u0440\u0438\u0444\u0430 \u0432 \u0422\u0435\u0433\u0435\u0440\u0430\u043d\u0435
    \u0441\u043e \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0412 \u0442\u043e\u043c
    \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d\u0430 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430
    \u0432 \u0421\u0428\u0410 \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f. \u0412 2004 \u0433\u043e\u0434\u0443
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u041a\u0451\u0440\u0442\u0438\u0441\u0430 \u041c\u0430\u043a\u043c\u0443\u043b\u043b\u0435\u043d\u0430
    \u043e\u043d\u0430 \u0437\u0430\u0449\u0438\u0442\u0438\u043b\u0430 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0440\u0430\u0437\u0443 \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0430
    \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439.\n\n\U0001F52C \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u041d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u043b\u0435\u0436\u0430\u043b\u0438 \u043d\u0430 \u0441\u0442\u044b\u043a\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u043e\u0433\u043e, \u0442\u0435\u043e\u0440\u0438\u0438
    \u0422\u0435\u0439\u0445\u043c\u044e\u043b\u043b\u0435\u0440\u0430, \u044d\u0440\u0433\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0438 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0415\u0451 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u043f\u043e\u0434\u0445\u043e\u0434 \u043a
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u0438\u0445 \u043c\u043e\u0434\u0443\u043b\u0435\u0439. \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0432\u0435\u0445\u0438 \u0435\u0451 \u043a\u0430\u0440\u044c\u0435\u0440\u044b: 2004\u20132008:
    \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0430\u0442 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u041a\u043b\u044d\u044f \u0438 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442-\u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u0421 2008: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    2014: \u0421\u0442\u0430\u043b\u0430 \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    \u2014 \u0441\u0430\u043c\u043e\u0439 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0432\u0440\u0443\u0447\u0430\u0435\u043c\u043e\u0439 \u0443\u0447\u0451\u043d\u044b\u043c
    \u0434\u043e 40 \u043b\u0435\u0442. \u041d\u0430\u0433\u0440\u0430\u0434\u0430 \u0431\u044b\u043b\u0430
    \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0430 \u0437\u0430 \u00ab\u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0443 \u0438
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u0442\u0435\u043e\u0440\u0438\u044e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432 \u0438\u0445 \u043c\u043e\u0434\u0443\u043b\u0435\u0439\u00bb.
    \u041f\u043e\u043c\u0438\u043c\u043e \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438, \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u0430
    \u041f\u0440\u0435\u043c\u0438\u0438 \u0411\u043b\u044e\u043c\u0435\u043d\u0442\u0430\u043b\u044f
    (2009), \u041f\u0440\u0435\u043c\u0438\u0438 \u0420\u0443\u0444\u044c \u0421\u0430\u0442\u0442\u0435\u0440
    (2013) \u0438 \u041f\u0440\u0435\u043c\u0438\u0438 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u041a\u043b\u044d\u044f (2014). \u0412 2016 \u0433\u043e\u0434\u0443 \u0435\u0451 \u0438\u0437\u0431\u0440\u0430\u043b\u0438
    \u0447\u043b\u0435\u043d\u043e\u043c \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0421\u0428\u0410.\n\n\U0001F4D6
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0434\u0432\u0443\u043c\u044f \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438: 1. \u0424\u043e\u0440\u043c\u0443\u043b\u0430
    \u0434\u043b\u044f \u043e\u0431\u044a\u0451\u043c\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u043c\u043e\u0434\u0443\u043b\u0435\u0439: \u0412 \u0441\u0432\u043e\u0435\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u043e\u043d\u0430 \u043d\u0430\u0448\u043b\u0430 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u0443\u044e
    \u0440\u0435\u043a\u0443\u0440\u0441\u0438\u0432\u043d\u0443\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u043e\u0431\u044a\u0451\u043c\u0430
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043c\u043e\u0434\u0443\u043b\u0435\u0439
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439.
