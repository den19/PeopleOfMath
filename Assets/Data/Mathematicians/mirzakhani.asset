    \u043d\u043e \u0438 \u043a\u0430\u043a \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.\n\n\u270d\ufe0f \u00ab\u0420\u0438\u0441\u043e\u0432\u0430\u043d\u0438\u0435\u00bb
