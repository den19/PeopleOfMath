    \u043f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0430\u044f \u043d\u0435\u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u00ab\u0442\u0435\u043e\u0440\u0435\u043c\u0430
