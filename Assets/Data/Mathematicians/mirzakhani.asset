    \u043d\u0430 \u0441\u0432\u044f\u0437\u0438\u00bb \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d\u0430 \u0432\u0438\u0434\u0435\u043b\u0430 \u043a\u0430\u043a \u0436\u0438\u0432\u043e\u0439,
    \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0439\u0441\u044f \u043c\u0438\u0440. \u0415\u0451
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430 \u043e\u0442\u043c\u0435\u0447\u0430\u043b, \u0447\u0442\u043e
    \u043e\u043d\u0430 \u043d\u0435 \u0432\u0438\u0434\u0435\u043b\u0430 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043a\u0430\u043a \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438, \u0430 \u0441\u043b\u043e\u0432\u043d\u043e
    \u00ab\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b\u0430 \u0432 \u043e\u043a\u043d\u043e
    \u0437\u0430 \u0442\u0435\u043c, \u043a\u0430\u043a \u0436\u0438\u0432\u0443\u0442 \u0438
    \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442
    \u043e\u0431\u0438\u0442\u0430\u0442\u0435\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043b\u0430\u043d\u0434\u0448\u0430\u0444\u0442\u0430\u00bb. \u0421\u0442\u043e\u0438\u0442
    \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
    \u043e\u043d\u0430 \u043c\u0435\u0447\u0442\u0430\u043b\u0430 \u0441\u0442\u0430\u0442\u044c
    \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u0435\u043c, \u0438 \u043f\u043e\u0437\u0436\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0430\u0441\u044c, \u0447\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0434\u043b\u044f \u043d\u0435\u0451
    \u043f\u043e\u0445\u043e\u0436\u0430 \u043d\u0430 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0440\u043e\u043c\u0430\u043d\u0430 \u0441 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f
    \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430\u043c\u0438.\n\n\U0001F4AA \u041e\u0442
    \u00ab\u0434\u0432\u043e\u0435\u0447\u043d\u0438\u0446\u044b\u00bb \u0434\u043e \u043e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u043e\u0439
    \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u043a\u0438 \u041f\u0443\u0442\u044c \u043a \u0432\u0435\u0440\u0448\u0438\u043d\u0430\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043d\u0435 \u0431\u044b\u043b
    \u0443\u0441\u044b\u043f\u0430\u043d \u0440\u043e\u0437\u0430\u043c\u0438. \u0412 \u0448\u0435\u0441\u0442\u043e\u043c
    \u043a\u043b\u0430\u0441\u0441\u0435 \u0432 \u0448\u043a\u043e\u043b\u0435 \u0434\u043b\u044f
    \u043e\u0434\u0430\u0440\u0451\u043d\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439 \u043e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043b\u0443\u0447\u0448\u0435\u0439 \u043f\u043e \u0432\u0441\u0435\u043c
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c, \u043a\u0440\u043e\u043c\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0433\u0434\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 16 \u0431\u0430\u043b\u043b\u043e\u0432
    \u0438\u0437 20. \u0411\u0443\u0434\u0443\u0447\u0438 \u043f\u0435\u0440\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u043a\u043e\u0439,
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0442\u0430\u043a \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0435\u043d\u0430,
    \u0447\u0442\u043e \u0440\u0430\u0437\u043e\u0440\u0432\u0430\u043b\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0438 \u0437\u0430\u044f\u0432\u0438\u043b\u0430,
    \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442
    \u0441\u0442\u0430\u0440\u0430\u0442\u044c\u0441\u044f \u043f\u043e \u044d\u0442\u043e\u043c\u0443
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0443. \u041e\u0434\u043d\u0430\u043a\u043e \u0443\u0436\u0435
    \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0433\u043e\u0434,
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u043c\u0435\u043d\u0435 \u0443\u0447\u0438\u0442\u0435\u043b\u044f,
    \u043e\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043b\u044e\u0431\u0438\u043b\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u043d\u043e \u0438 \u0441\u0442\u0430\u043b\u0430
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0434\u0435\u0432\u0443\u0448\u043a\u043e\u0439 \u0432
    \u0441\u0431\u043e\u0440\u043d\u043e\u0439 \u0418\u0440\u0430\u043d\u0430 \u043d\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0435
    \u0432 1994 \u0433\u043e\u0434\u0443, \u0430 \u0432 1995 \u0433\u043e\u0434\u0443 \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043b\u0430
    \u0437\u043e\u043b\u043e\u0442\u0443\u044e \u043c\u0435\u0434\u0430\u043b\u044c \u0441 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u0415\u0451 \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u0431\u0440\u0430\u0442 \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043d\u0430\u0443\u043a\u0435, \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u0432
    \u0435\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043e \u0442\u043e\u043c, \u043a\u0430\u043a
    \u044e\u043d\u044b\u0439 \u0413\u0430\u0443\u0441\u0441 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e
    \u0441\u043b\u043e\u0436\u0438\u043b \u0447\u0438\u0441\u043b\u0430 \u043e\u0442 1 \u0434\u043e
    100.\n\n\u2764\ufe0f \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0438 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0416\u0438\u0437\u043d\u044c \u041c\u0438\u0440\u0437\u0430\u0445\u0430\u043d\u0438
    \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u043b\u0430\u0441\u044c
    \u0441 \u0438\u0440\u0430\u043d\u0441\u043a\u0438\u043c\u0438 \u0437\u0430\u043a\u043e\u043d\u0430\u043c\u0438
    \u0438 \u043e\u0431\u044b\u0447\u0430\u044f\u043c\u0438, \u0447\u0442\u043e \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432: \u0411\u0440\u0430\u043a \u0441 \u043d\u0435\u043c\u0443\u0441\u0443\u043b\u044c\u043c\u0430\u043d\u0438\u043d\u043e\u043c:
    \u0415\u0451 \u043c\u0443\u0436 \u042f\u043d \u0412\u043e\u043d\u0434\u0440\u0430\u043a
    \u2014 \u0443\u0447\u0451\u043d\u044b\u0439 \u0447\u0435\u0448\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f. \u041f\u043e
    \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0418\u0440\u0430\u043d\u0430, \u0431\u0440\u0430\u043a
    \u0438\u0440\u0430\u043d\u043a\u0438 \u0441 \u043d\u0435\u043c\u0443\u0441\u0443\u043b\u044c\u043c\u0430\u043d\u0438\u043d\u043e\u043c
    \u043d\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0451\u0442\u0441\u044f, \u0447\u0442\u043e
    \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b\u043e \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u0434\u043b\u044f \u0438\u0445 \u0434\u043e\u0447\u0435\u0440\u0438 \u0410\u043d\u0430\u0445\u0438\u0442\u044b
    \u043f\u0440\u0438 \u043f\u043e\u0435\u0437\u0434\u043a\u0430\u0445 \u0432 \u0418\u0440\u0430\u043d.
    \u0424\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0431\u0435\u0437 \u0445\u0438\u0434\u0436\u0430\u0431\u0430:
    \u041f\u043e\u0441\u043b\u0435 \u0435\u0451 \u0441\u043c\u0435\u0440\u0442\u0438 \u0438\u0440\u0430\u043d\u0441\u043a\u0438\u0435
    \u0433\u0430\u0437\u0435\u0442\u044b \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0438\u043b\u0438
    \u0441\u0442\u0440\u043e\u0433\u0438\u0439 \u0437\u0430\u043f\u0440\u0435\u0442 \u043d\u0430
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d \u0441 \u043d\u0435\u043f\u043e\u043a\u0440\u044b\u0442\u043e\u0439
    \u0433\u043e\u043b\u043e\u0432\u043e\u0439 \u0438 \u0432\u044b\u0448\u043b\u0438 \u043d\u0430
    \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0446\u0430\u0445 \u0441 \u0435\u0451 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439
    \u0431\u0435\u0437 \u0445\u0438\u0434\u0436\u0430\u0431\u0430 \u0432 \u0437\u043d\u0430\u043a
    \u0441\u043a\u043e\u0440\u0431\u0438. \u0427\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0432 2014 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0430
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e, \u0442\u0435 \u0436\u0435 \u0433\u0430\u0437\u0435\u0442\u044b
    \u043b\u0438\u0431\u043e \u043e\u0431\u0440\u0435\u0437\u0430\u043b\u0438 \u0435\u0451 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u043b\u0438\u0431\u043e \u043f\u0440\u0438\u0440\u0438\u0441\u043e\u0432\u044b\u0432\u0430\u043b\u0438
    \u043a \u043d\u0438\u043c \u0445\u0438\u0434\u0436\u0430\u0431. \u041f\u0440\u0438\u0437\u044b\u0432\u044b
    \u043a \u0440\u0435\u0444\u043e\u0440\u043c\u0430\u043c: \u0415\u0451 \u0441\u043c\u0435\u0440\u0442\u044c
    \u0432\u044b\u0437\u0432\u0430\u043b\u0430 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0440\u0435\u0437\u043e\u043d\u0430\u043d\u0441, \u0438 \u0433\u0440\u0443\u043f\u043f\u0430
    \u0438\u0440\u0430\u043d\u0441\u043a\u0438\u0445 \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432
    \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0430 \u0443\u0441\u043a\u043e\u0440\u0438\u0442\u044c
    \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u0435 \u043f\u043e\u043f\u0440\u0430\u0432\u043e\u043a,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438
    \u0431\u044b \u0434\u0435\u0442\u044f\u043c \u0438\u0440\u0430\u043d\u0441\u043a\u0438\u0445
    \u0436\u0435\u043d\u0449\u0438\u043d \u043e\u0442 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445
    \u043c\u0443\u0436\u0435\u0439 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0438\u0440\u0430\u043d\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e.\n\n\U0001F3AD \u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0430\u044f \u0446\u0435\u043b\u0435\u0443\u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u041a\u043e\u043b\u043b\u0435\u0433\u0438 \u0438 \u0434\u0440\u0443\u0437\u044c\u044f \u0435\u0434\u0438\u043d\u043e\u0434\u0443\u0448\u043d\u043e
    \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438 \u0435\u0451 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c. \u0415\u0451 \u043c\u0443\u0436,
    \u042f\u043d \u0412\u043e\u043d\u0434\u0440\u0430\u043a, \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0441\u044f,
    \u0447\u0442\u043e, \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0432\u0448\u0438\u0441\u044c
    \u0441 \u043d\u0435\u0439 \u0432 2003 \u0433\u043e\u0434\u0443, \u043d\u0435 \u0437\u043d\u0430\u043b,
    \u0447\u0442\u043e \u00ab\u043e\u043d\u0430 \u0441\u0443\u043f\u0435\u0440\u0437\u0432\u0435\u0437\u0434\u0430\u00bb
    \u2014 \u043c\u043d\u043e\u0433\u0438\u0435 \u0435\u0451 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043e\u043d \u0443\u0437\u043d\u0430\u0432\u0430\u043b \u043e\u0442 \u043e\u0431\u0449\u0438\u0445
