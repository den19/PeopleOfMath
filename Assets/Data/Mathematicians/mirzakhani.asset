    \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043d\u0430 \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0438\u043b\u044c\u043d\u043e\u0435 \u0438 \u043d\u0435\u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e\u0435,
    \u043e\u043d\u043e \u0432\u043d\u0435\u0441\u043b\u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443
    \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0440\u0430\u043d\u0435\u0435 \u0432\u0438\u0434\u0435\u043b\u0438
    \u043b\u0438\u0448\u044c \u0445\u0430\u043e\u0441. \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
