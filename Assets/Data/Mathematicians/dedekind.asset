  achievementsRu: "\u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u0431\u044b\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e\u043c
    \u0441\u043c\u044b\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0438\u043b\u0438
    \u044f\u0437\u044b\u043a \u0441\u0432\u043e\u0435\u0439 \u043d\u0430\u0443\u043a\u0438.
    \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u043c\u0438
    \u2014 \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u0438 \u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043f\u043e\u043d\u044f\u0442\u0438\u044f\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e \u043d\u0435\u0433\u043e \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c
    \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e \u044f\u0441\u043d\u044b\u043c\u0438.
    \u0412\u043a\u043b\u0430\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430 \u043f\u0440\u043e\u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0441\u044f
    \u043e\u0442 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u0435\u0440\u0434\u0446\u0435\u0432\u0438\u043d\u044b
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b.\n\n\U0001F4D0
    \u0421\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u044b
    XIX \u0432\u0435\u043a\u0430 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u043e\u043f\u043e\u0440\u0430
    \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044e, \u0430 \u043d\u0435 \u043d\u0430 \u0441\u0442\u0440\u043e\u0433\u0443\u044e
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443. \u0420\u0430\u0431\u043e\u0442\u0430\u044f
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0432 \u0426\u044e\u0440\u0438\u0445\u0435,
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043e\u0449\u0443\u0442\u0438\u043b \u044d\u0442\u0443
    \u043d\u0435\u0445\u0432\u0430\u0442\u043a\u0443 \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438
    \u043f\u0440\u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435 \u043b\u0435\u043a\u0446\u0438\u0439
    \u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u0435\u0440\u0435\u0434 \u0441\u043e\u0431\u043e\u0439
    \u0446\u0435\u043b\u044c \u0434\u0430\u0442\u044c \u0447\u0438\u0441\u0442\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438.
    \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u0435\u0433\u043e \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439
    \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0440\u044b\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u043e\u0441\u043e\u0437\u043d\u0430\u043b 24 \u043d\u043e\u044f\u0431\u0440\u044f
    1858 \u0433\u043e\u0434\u0430 \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0432 1872 \u0433\u043e\u0434\u0443 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430\u00bb (Stetigkeit und Irrationalzahlen). \u0415\u0433\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0438\u0434\u0435\u044f \u2014 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u0432\u043e
    \u0441\u0435\u0447\u0435\u043d\u0438\u0435. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e
    \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c
    \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430
    \u0447\u0435\u0440\u0435\u0437 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0435 \u0434\u0440\u043e\u0431\u0438,
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435:
    \u0435\u0441\u043b\u0438 \u0440\u0430\u0437\u0431\u0438\u0442\u044c \u0432\u0441\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \u043d\u0430 \u0434\u0432\u0430 \u043d\u0435\u043f\u0443\u0441\u0442\u044b\u0445 \u043a\u043b\u0430\u0441\u0441\u0430
    `A` \u0438 `B` \u0442\u0430\u043a, \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0438\u0437 `A` \u043c\u0435\u043d\u044c\u0448\u0435 \u043b\u044e\u0431\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u0438\u0437 `B`, \u0442\u043e \u0442\u0430\u043a\u043e\u0435
    \u0441\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442
    \u043e\u0434\u043d\u043e \u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u043d\u043e
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e.
    \u0415\u0441\u043b\u0438 \u0432 \u043a\u043b\u0430\u0441\u0441\u0435 `A` \u0435\u0441\u0442\u044c
    \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u0435 \u0447\u0438\u0441\u043b\u043e
    (\u0438\u043b\u0438 \u0432 `B` \u2014 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0435),
    \u0442\u043e \u044d\u0442\u043e \u0441\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0438\u0441\u043b\u0443.
    \u0415\u0441\u043b\u0438 \u0436\u0435 \u043d\u0438 \u043e\u0434\u0438\u043d \u0438\u0437
    \u043a\u043b\u0430\u0441\u0441\u043e\u0432 \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u043a\u0440\u0430\u0439\u043d\u0435\u0433\u043e
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430, \u0442\u043e \u0441\u0435\u0447\u0435\u043d\u0438\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u043d\u043e\u0432\u043e\u0435,
    \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e.
    \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0434\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u043e \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438
    \u0438 \u00ab\u0437\u0430\u043f\u043e\u043b\u043d\u0438\u043b\u00bb \u0432\u0441\u0435 \u043f\u0440\u043e\u0431\u0435\u043b\u044b,
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u0435 \u0432
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u0430\u043a\u0441\u0438\u043e\u043c\u043e\u0439
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430-\u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430,
    \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0439
    \u0432\u0437\u0430\u0438\u043c\u043d\u043e-\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0435
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u043c\u0435\u0436\u0434\u0443
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438
    \u0438 \u0442\u043e\u0447\u043a\u0430\u043c\u0438 \u043f\u0440\u044f\u043c\u043e\u0439,
    \u044d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430.\n\n\U0001F9F1 \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b:
    \u041a\u043e\u043b\u044c\u0446\u0430 \u0438 \u0418\u0434\u0435\u0430\u043b\u044b \u0412\u0442\u043e\u0440\u044b\u043c
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430 \u0441\u0442\u0430\u043b\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043e\u0441\u043d\u043e\u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043d \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u043b
    \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u0440\u0430\u0431\u043e\u0442 \u043f\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u0413\u043b\u0430\u0432\u043d\u0430\u044f
    \u0437\u0430\u0434\u0430\u0447\u0430 \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430 \u0438\u0437
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b, \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439
    \u041a\u0443\u043c\u043c\u0435\u0440\u043e\u043c: \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0447\u0438\u0441\u0435\u043b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432
    \u043a\u043e\u043b\u044c\u0446\u0435 \u0447\u0438\u0441\u0435\u043b \u0432\u0438\u0434\u0430
    `a + b\u221a-5`) \u043d\u0430\u0440\u0443\u0448\u0430\u0435\u0442\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438,
    \u0438 \u0447\u0438\u0441\u043b\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0440\u0430\u0437\u043b\u043e\u0436\u0438\u0442\u044c
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0438.
    \u041a\u0443\u043c\u043c\u0435\u0440 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0434\u043b\u044f \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438
    \u0432\u0432\u0435\u0441\u0442\u0438 \u00ab\u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430\u00bb. \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043f\u043e\u0434\u043e\u0448\u0435\u043b
    \u043a \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435 \u0441 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u043e\u0439, \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u043f\u043e\u0437\u0438\u0446\u0438\u0438.
    \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b
    \u0432\u0432\u043e\u0434\u0438\u0442\u044c \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u00ab\u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0435\u00bb \u0447\u0438\u0441\u043b\u0430,
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u043d\u0435 \u0441\u0430\u043c\u0438 \u0447\u0438\u0441\u043b\u0430, \u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0447\u0438\u0441\u0435\u043b, \u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0449\u0438\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u043c\u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438.
    \u0412 1871 \u0433\u043e\u0434\u0443 \u0432 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f\u0445
    \u043a \u00ab\u0422\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b\u00bb \u0414\u0438\u0440\u0438\u0445\u043b\u0435
    \u043e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u044d\u0442\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043a\u0430\u043a \u00ab\u0438\u0434\u0435\u0430\u043b\u044b\u00bb \u0438 \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u043a\u043e\u043b\u044c\u0446\u0430\u00bb
    (\u0445\u043e\u0442\u044f \u0441\u0430\u043c \u0442\u0435\u0440\u043c\u0438\u043d \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u043f\u043e\u0437\u0436\u0435). \u041f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430
    \u0431\u044b\u043b\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c: 1. \u0421\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c:
    \u0418\u0434\u0435\u0430\u043b \u2014 \u044d\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0447\u0438\u0441\u0435\u043b \u0432 \u0438\u0437\u0443\u0447\u0430\u0435\u043c\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0435, \u0430 \u043d\u0435 \u0433\u0438\u043f\u043e\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043e\u0431\u044a\u0435\u043a\u0442 \u0438\u0437\u0432\u043d\u0435. \u0421\u0430\u043c
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0438\u0434\u0435\u0430\u043b\u044b \u00ab\u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u044e\u0442\u0441\u044f
    \u044f\u0441\u043d\u044b\u043c \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u043c \u0441\u0432\u0435\u0442\u043e\u043c
    \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f\u00bb.
    2. \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438: \u0412 \u0442\u0435\u043e\u0440\u0438\u0438,
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0439 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u043c,
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e, \u0445\u043e\u0442\u044f
    \u0447\u0438\u0441\u043b\u0430 \u043c\u043e\u0433\u0443\u0442 \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0438
    \u043d\u0435 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u043b\u044e\u0431\u043e\u0439 \u043d\u0435\u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0438\u0434\u0435\u0430\u043b
    \u0432 \u043a\u043e\u043b\u044c\u0446\u0435 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0438\u0434\u0435\u0430\u043b\u044b.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438
    \u0431\u044b\u043b\u043e \u0441\u043f\u0430\u0441\u0435\u043d\u043e \u043d\u0430 \u043d\u043e\u0432\u043e\u043c,
    \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435.
    3. \u041e\u0431\u0449\u043d\u043e\u0441\u0442\u044c: \u0415\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u044b
    \u0438 \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0435\u043b\u0438 \u043e\u0442 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0438\u0445 \u043a \u0441\u0430\u043c\u044b\u043c
    \u0440\u0430\u0437\u043d\u044b\u043c \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u042d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434 \u0441\u0442\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u042d\u043c\u043c\u0438 \u041d\u0451\u0442\u0435\u0440,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0430
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432 XX \u0432\u0435\u043a\u0435, \u0447\u0430\u0441\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430
    \u0441\u0432\u043e\u0438\u043c \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c: \u00ab\u042d\u0442\u043e
    \u0443\u0436\u0435 \u0435\u0441\u0442\u044c \u0443 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430\u00bb,
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u044f, \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435
    \u0431\u0430\u0437\u043e\u0432\u044b\u0435 \u0438\u0434\u0435\u0438 \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0432 \u0437\u0430\u0447\u0430\u0442\u043a\u0435
    \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0432
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0445.\n\n\U0001F522 \u0410\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0430
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u0412 \u0440\u0430\u0431\u043e\u0442\u0435
    \u00ab\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0447\u0438\u0441\u043b\u0430 \u0438
    \u0434\u043b\u044f \u0447\u0435\u0433\u043e \u043e\u043d\u0438 \u0441\u043b\u0443\u0436\u0430\u0442?\u00bb
    (Was sind und was sollen die Zahlen?, 1888) \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0441\u044f \u043a \u0441\u0430\u043c\u043e\u043c\u0443
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0443 \u2014 \u043f\u043e\u043d\u044f\u0442\u0438\u044e
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430.
    \u0412 \u044d\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435 \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0440\u044f\u0434\u0430. \u0412 \u0435\u0433\u043e \u043e\u0441\u043d\u043e\u0432\u0435
    \u043b\u0435\u0436\u0430\u043b\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u0441\u0438\u0441\u0442\u0435\u043c\u044b\u00bb
    (\u0442\u043e \u0435\u0441\u0442\u044c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430)
    \u0438 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f. \u041e\u043d
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043a\u0430\u043a \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e,
    \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u043e\u0435 \u0441\u0432\u043e\u0435\u0439
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438,
    \u0438 \u043d\u0430 \u044d\u0442\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u0434\u043b\u044f \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u00ab\u0446\u0435\u043f\u044c\u00bb \u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044e
    \u00ab\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u00bb. \u0413\u043e\u0434
    \u0441\u043f\u0443\u0441\u0442\u044f \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041f\u0435\u0430\u043d\u043e
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e,
    \u0441\u043b\u0435\u0433\u043a\u0430 \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u0443\u044e,
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0430\u043a\u0441\u0438\u043e\u043c, \u0441\u043e\u0441\u043b\u0430\u0432\u0448\u0438\u0441\u044c
    \u043d\u0430 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430, \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u044d\u0442\u0438 \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u043a\u0430\u043a \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u041f\u0435\u0430\u043d\u043e.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0442\u0430\u043a\u0436\u0435 \u044f\u0440\u043a\u043e
    \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0443\u044e
    \u043f\u043e\u0437\u0438\u0446\u0438\u044e \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430:
    \u043e\u043d \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d, \u0447\u0442\u043e
    \u0447\u0438\u0441\u043b\u0430 \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u043b\u0430\u0442\u043e\u043d\u043e\u0432\u0441\u043a\u0438\u0435
    \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435
    \u0432 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u043c\u0438\u0440\u0435,
    \u0430 \u00ab\u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0435 \u0442\u0432\u043e\u0440\u0435\u043d\u0438\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u0443\u043c\u0430\u00bb,
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c
    \u0442\u043e\u0447\u043d\u043e\u0435 \u0438 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435.\n\n\U0001F9E9
    \u0414\u0440\u0443\u0433\u0438\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u041f\u043e\u043c\u0438\u043c\u043e \u0442\u0440\u0435\u0445 \u0441\u0442\u043e\u043b\u043f\u043e\u0432,
    \u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442:
    \u0422\u0435\u043e\u0440\u0438\u044f \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439: \u0412 \u043f\u0438\u0441\u044c\u043c\u0435
    \u0411\u043e\u0440\u0445\u0430\u0440\u0434\u0442\u0443 (1877) \u043e\u043d \u0443\u043a\u0430\u0437\u0430\u043b
    \u043d\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0432\u0430\u0436\u043d\u043e\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    `j` (\u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442), \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. \u0422\u0435\u043e\u0440\u0438\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439: \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0413. \u0412\u0435\u0431\u0435\u0440\u043e\u043c (1882) \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0430\u043b\u044b \u043a \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c, \u0441\u043e\u0437\u0434\u0430\u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u00ab\u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435\u0439\u00bb, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443 \u043f\u043e\u0434\u043e\u0439\u0442\u0438
    \u043a \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0420\u0438\u043c\u0430\u043d\u0430-\u0420\u043e\u0445\u0430.
    \u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435:
    \u041e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u043c\u043d\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438\u0437\u0434\u0430\u043d\u0438\u044e \u0438
    \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0439 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439
    \u0441\u0432\u043e\u0438\u0445 \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439
    \u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u2014 \u0413\u0430\u0443\u0441\u0441\u0430,
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u0438 \u0420\u0438\u043c\u0430\u043d\u0430,
    \u0447\u0435\u043c \u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0435\u043e\u0446\u0435\u043d\u0438\u043c\u0443\u044e
    \u0443\u0441\u043b\u0443\u0433\u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438.
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043d\u0435 \u0438\u0441\u043a\u0430\u043b
    \u0432\u043d\u0435\u0448\u043d\u0435\u0433\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f,
    \u043d\u043e \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u0438
    \u0442\u0435\u043c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c, \u043d\u0430
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 XX \u0432\u0435\u043a\u0430.
    \u0415\u0433\u043e \u0438\u0434\u0435\u0438 \u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430\u0445,
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0445 \u0438 \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438
    \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b, \u043d\u043e \u0438
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438 \u0441\u0430\u043c \u043c\u0435\u0442\u043e\u0434
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0420\u0438\u0445\u0430\u0440\u0434\u0430
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0436\u0435 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0439 \u0438 \u0440\u0430\u0437\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439,
    \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0431\u044b\u043b\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439. \u041e\u043d
    \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0447\u0435\u0440\u043f\u0430\u043b \u0441\u0438\u043b\u044b \u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u043b
    \u043f\u043e\u043b\u043d\u043e\u0435 \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0435
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u043c \u043a\u0440\u0443\u0433\u0443,
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u0438 \u0440\u043e\u0434\u043d\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435, \u043d\u0435 \u0441\u0442\u0440\u0435\u043c\u044f\u0441\u044c
    \u043a \u0432\u043d\u0435\u0448\u043d\u0435\u043c\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e
    \u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u0430\u043c.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0421\u0435\u043c\u044c\u044f \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434, \u043f\u043e\u043b\u043d\u043e\u0435
    \u0438\u043c\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u044b\u043b\u043e
    \u042e\u043b\u0438\u0443\u0441 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c \u0420\u0438\u0445\u0430\u0440\u0434,
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 6 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1831 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0441 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c\u0438
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043a\u043e\u0440\u043d\u044f\u043c\u0438.
    \u041e\u043d \u0431\u044b\u043b \u043c\u043b\u0430\u0434\u0448\u0438\u043c \u0438\u0437
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u0434\u0435\u0442\u0435\u0439. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446, \u042e\u043b\u0438\u0443\u0441 \u041b\u0435\u0432\u0438\u043d
    \u0423\u043b\u044c\u0440\u0438\u0445 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434, \u0431\u044b\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043f\u0440\u0430\u0432\u0430
    \u0438 \u0432\u0438\u0434\u043d\u044b\u043c \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c
    \u0432 \u043c\u0435\u0441\u0442\u043d\u043e\u043c \u041a\u043e\u043b\u043b\u0435\u0433\u0438\u0443\u043c\u0435
    \u041a\u0430\u0440\u043e\u043b\u0438\u043d\u0443\u043c. \u041c\u0430\u0442\u044c, \u041a\u0430\u0440\u043e\u043b\u0438\u043d\u0430
    \u0413\u0435\u043d\u0440\u0438\u0435\u0442\u0442\u0430 (\u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f
    \u042d\u043c\u043f\u0435\u0440\u0438\u0443\u0441), \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430, \u0442\u0430\u043a\u0436\u0435
    \u0440\u0430\u0431\u043e\u0442\u0430\u0432\u0448\u0435\u0433\u043e \u0432 \u044d\u0442\u043e\u043c
    \u0436\u0435 \u043a\u043e\u043b\u043b\u0435\u0433\u0438\u0443\u043c\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u043f\u043e\u0432\u0437\u0440\u043e\u0441\u043b\u0435\u0432, \u0420\u0438\u0445\u0430\u0440\u0434
    \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0438\u043c\u0435\u043d\u0430
    \u2014 \u042e\u043b\u0438\u0443\u0441 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c,
    \u0438 \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043f\u0440\u043e\u0441\u0442\u043e
    \u043a\u0430\u043a \u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434.
    \u0415\u0433\u043e \u0431\u0440\u0430\u0442 \u0410\u0434\u043e\u043b\u044c\u0444 \u0441\u0442\u0430\u043b
    \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0433\u043e
    \u0441\u0443\u0434\u0430 \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435.
    \u041e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0435\u0441\u0442\u0435\u0440, \u041c\u0430\u0442\u0438\u043b\u044c\u0434\u0430,
    \u0443\u043c\u0435\u0440\u043b\u0430 \u0432 1860 \u0433\u043e\u0434\u0443. \u0421\u0443\u0434\u044c\u0431\u0430
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0441\u0435\u0441\u0442\u0440\u044b, \u042e\u043b\u0438\u0438,
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430
    \u0441 \u0436\u0438\u0437\u043d\u044c\u044e \u0441\u0430\u043c\u043e\u0433\u043e \u0420\u0438\u0445\u0430\u0440\u0434\u0430.\n\n\U0001F3E0
    \u0416\u0438\u0437\u043d\u044c \u0441 \u0441\u0435\u0441\u0442\u0440\u043e\u0439 \u0438
    \u043b\u0438\u0447\u043d\u044b\u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f
    \u0412\u0441\u044e \u0441\u0432\u043e\u044e \u0432\u0437\u0440\u043e\u0441\u043b\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c \u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0445\u043e\u043b\u043e\u0441\u0442\u044f\u043a\u043e\u043c.
    \u041c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b \u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u043d\u0430
    \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b
    \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u043d\u0435\u0437\u0430\u043c\u0443\u0436\u043d\u0435\u0439
    \u0441\u0435\u0441\u0442\u0440\u043e\u0439 \u042e\u043b\u0438\u0435\u0439 (Julie). \u0418\u0445
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b\u0430\u0441\u044c \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438 \u042e\u043b\u0438\u0438
    \u0432 1914 \u0433\u043e\u0434\u0443. \u0421\u0435\u043c\u044c\u044f \u0438, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0441\u0435\u0441\u0442\u0440\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0437\u0430\u043c\u0435\u043d\u044f\u043b\u0438 \u0435\u043c\u0443 \u0436\u0435\u043d\u0443
    \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439.
    \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043d\u0430\u0443\u043a\u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u044e\u0442,
    \u0447\u0442\u043e \u0435\u0433\u043e \u00ab\u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439,
    \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0439 \u043c\u0438\u0440\u00bb \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u043b \u0435\u0433\u043e
    \u0437\u0430\u043f\u0440\u043e\u0441\u044b, \u0438 \u0432 \u043d\u0435\u043c \u043e\u043d
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0434\u043e\u0441\u0443\u0433\u0430 \u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u044b \u0434\u043b\u044f
    \u0441\u0432\u043e\u0438\u0445 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u044b
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u044e\u0442, \u0447\u0442\u043e
    \u043e\u043d \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u0441\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d \u0438\u043b\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f,
    \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u044f \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f
    \u0432 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u043e\u0439 \u0441\u0440\u0435\u0434\u0435.
    \u041e\u043d \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0438
    \u0432 \u0441\u0430\u043c\u043e\u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0438
    \u0432\u043e \u0432\u043d\u0435\u0448\u043d\u0435\u043c \u043c\u0438\u0440\u0435, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u044b\u0432\u0430\u043b
    \u0441\u0435\u0431\u044f \u0432 \u043d\u0430\u0443\u043a\u0435. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0441\u0435\u0441\u0442\u0440\u0430 \u042e\u043b\u0438\u044f
    \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b\u0430 \u0443\u0432\u0430\u0436\u0430\u0435\u043c\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435
    \u2014 \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439
    \u0438 \u0432 1893 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430
    \u043c\u0435\u0441\u0442\u043d\u0443\u044e \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e.\n\n\U0001F4CD \u041d\u0435\u0441\u043f\u0435\u0448\u043d\u044b\u0439
    \u0445\u043e\u0434 \u0436\u0438\u0437\u043d\u0438 \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435
    \u0412\u0441\u044f \u0436\u0438\u0437\u043d\u044c \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430
    \u0431\u044b\u043b\u0430 \u043f\u0440\u043e\u0447\u043d\u043e \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u0430
    \u043a \u0435\u0433\u043e \u0440\u043e\u0434\u043d\u043e\u043c\u0443 \u0433\u043e\u0440\u043e\u0434\u0443
    \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0443, \u0433\u0434\u0435 \u043e\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f, \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438 \u0438 \u0443\u043c\u0435\u0440.
    \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435
    \u0438 \u0426\u044e\u0440\u0438\u0445\u0435, \u0432 1862 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433,
    \u043f\u0440\u0438\u043d\u044f\u0432 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c\u0435 (\u043d\u044b\u043d\u0435
    \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0441\u043a\u0438\u0439 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442), \u0433\u0434\u0435
    \u043a\u043e\u0433\u0434\u0430-\u0442\u043e \u0443\u0447\u0438\u043b\u0441\u044f \u0435\u0433\u043e
    \u043e\u0442\u0435\u0446. \u041e\u043d \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0434\u043e 1894 \u0433\u043e\u0434\u0430,
    \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u0432\u044b\u0448\u0435\u043b \u043d\u0430
    \u043f\u0435\u043d\u0441\u0438\u044e, \u043d\u043e \u0434\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u044d\u0442\u043e\u0433\u043e \u0438\u043d\u043e\u0433\u0434\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f\u043c\u0438. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0439 \u044d\u043f\u0438\u0437\u043e\u0434
    \u043f\u043b\u043e\u0445\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u0441 \u043d\u0438\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0447\u0435\u0440\u0435\u0437 10 \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0441\u043a\u0438\u0439
    \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0443\u043c, \u0432\u0441\u043a\u043e\u0440\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430.
    \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e, \u043e\u043d \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0438 \u0432 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u043c,
    \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438, \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b
    \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435.
    \u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    12 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1916 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 84 \u043b\u0435\u0442."
  personalLifeEn: 
  shortBioRu: "\u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 (\u043f\u043e\u043b\u043d\u043e\u0435
    \u0438\u043c\u044f \u2014 \u042e\u043b\u0438\u0443\u0441 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c
    \u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434) \u2014
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    XIX \u0432\u0435\u043a\u0430, \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438 \u043e\u0431\u043b\u0438\u043a
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f 6 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1831 \u0433\u043e\u0434\u0430 \u0438 \u0443\u043c\u0435\u0440 12 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1916 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435,
    \u0433\u0434\u0435 \u0438 \u043f\u0440\u043e\u0448\u043b\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u044f
    \u0447\u0430\u0441\u0442\u044c \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F9EC
    \u0421\u0435\u043c\u044c\u044f \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0420\u0438\u0445\u0430\u0440\u0434 \u0431\u044b\u043b \u043c\u043b\u0430\u0434\u0448\u0438\u043c
    \u0438\u0437 \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u0434\u0435\u0442\u0435\u0439 \u0432
    \u0443\u0432\u0430\u0436\u0430\u0435\u043c\u043e\u0439 \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u042e\u043b\u0438\u0443\u0441
    \u041b\u0435\u0432\u0438\u043d \u0423\u043b\u044c\u0440\u0438\u0445 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434,
    \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u044e\u0440\u0438\u0441\u043f\u0440\u0443\u0434\u0435\u043d\u0446\u0438\u0438
    \u0438 \u0432\u0438\u0434\u043d\u044b\u043c \u0434\u0435\u044f\u0442\u0435\u043b\u0435\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u043e\u043d \u044f\u0432\u043b\u044f\u043b\u0441\u044f
    \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c
    \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u041a\u043e\u043b\u043b\u0435\u0433\u0438\u0443\u043c\u0430
    \u041a\u0430\u0440\u043e\u043b\u0438\u043d\u0443\u043c. \u041c\u0430\u0442\u044c, \u041a\u0430\u0440\u043e\u043b\u0438\u043d\u0430
    \u0413\u0435\u043d\u0440\u0438\u0435\u0442\u0442\u0430 (\u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f
    \u042d\u043c\u043f\u0435\u0440\u0438\u0443\u0441), \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430, \u0442\u0430\u043a\u0436\u0435
    \u0440\u0430\u0431\u043e\u0442\u0430\u0432\u0448\u0435\u0433\u043e \u0432 \u044d\u0442\u043e\u043c
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438\u0443\u043c\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0442\u043e\u0447\u043d\u044b\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u0443 \u043d\u0435\u0433\u043e \u043d\u0435 \u0441\u0440\u0430\u0437\u0443. \u0412 \u0448\u043a\u043e\u043b\u0435
    \u0435\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u043b\u0438
    \u0444\u0438\u0437\u0438\u043a\u0430 \u0438 \u0445\u0438\u043c\u0438\u044f, \u043e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u043d\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b\u0430
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c \u044d\u0442\u0438\u0445 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d,
    \u0447\u0442\u043e \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u0435\u0433\u043e
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.\n\n\U0001F393 \u041f\u0443\u0442\u044c
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435: \u0423\u0447\u0435\u043d\u0438\u043a
    \u0413\u0430\u0443\u0441\u0441\u0430 \u0412 1848 \u0433\u043e\u0434\u0443 \u0448\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u0438\u043b\u0435\u0442\u043d\u0438\u0439
    \u0420\u0438\u0445\u0430\u0440\u0434 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    \u041a\u043e\u043b\u043b\u0435\u0433\u0438\u0443\u043c \u041a\u0430\u0440\u043e\u043b\u0438\u043d\u0443\u043c
    \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435, \u0433\u0434\u0435
    \u0438\u0437\u0443\u0447\u0430\u043b \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435,
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438 \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043d\u0430\u043b\u0438\u0437\u0430.
    \u0412 1850 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043d\u0435 \u0431\u044b\u043b \u0432\u0435\u0434\u0443\u0449\u0438\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 (\u0442\u0430\u043a\u043e\u0432\u044b\u043c
    \u0441\u0447\u0438\u0442\u0430\u043b\u0441\u044f \u0411\u0435\u0440\u043b\u0438\u043d),
    \u043d\u043e \u0442\u0430\u043c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u041a\u0430\u0440\u043b \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    \u0413\u0430\u0443\u0441\u0441. \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u0441\u0442\u0430\u043b
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u0413\u0430\u0443\u0441\u0441\u0430. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    21 \u0433\u043e\u0434\u0430, \u0432 1852 \u0433\u043e\u0434\u0443, \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0437\u0430 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043f\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u044d\u0439\u043b\u0435\u0440\u043e\u0432\u044b\u0445
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043f\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u044d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043d\u0435 \u0432 \u043f\u043e\u043b\u043d\u043e\u0439 \u043c\u0435\u0440\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u043b\u0430
    \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442. \u041e\u0441\u043e\u0437\u043d\u0430\u0432
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043a\u0438 \u0441\u0432\u043e\u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u043f\u0440\u043e\u0432\u0435\u043b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435
    \u0434\u0432\u0430 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435,
    \u0433\u0434\u0435 \u0441\u043b\u0443\u0448\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u2014 \u042d\u0440\u043d\u0441\u0442\u0430
    \u041a\u0443\u043c\u043c\u0435\u0440\u0430 \u0438 \u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434\u0430
    \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u0430. \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d, \u0432 1854 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0445\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044e
    (\u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u0438\u0439 \u0434\u0438\u043f\u043b\u043e\u043c,
    \u0434\u0430\u044e\u0449\u0438\u0439 \u043f\u0440\u0430\u0432\u043e \u043d\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435) \u0438
    \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u043e\u043c,
    \u0447\u0438\u0442\u0430\u044f \u043a\u0443\u0440\u0441\u044b \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430
    \u0441\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u0430\u044f \u0432\u0441\u0442\u0440\u0435\u0447\u0430.
    \u0412 1855 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0413\u0430\u0443\u0441\u0441\u0430, \u0435\u0433\u043e \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435 \u0437\u0430\u043d\u044f\u043b
    \u041f\u0435\u0442\u0435\u0440 \u0413\u0443\u0441\u0442\u0430\u0432 \u041b\u0435\u0436\u0451\u043d-\u0414\u0438\u0440\u0438\u0445\u043b\u0435.
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u043e\u0441\u0435\u0449\u0430\u043b \u0435\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438,
    \u043d\u043e \u0438 \u0441\u0442\u0430\u043b \u0435\u0433\u043e \u0431\u043b\u0438\u0437\u043a\u0438\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c. \u041e\u043d \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e
    \u0438\u043c\u0435\u043d\u043d\u043e \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u00ab\u0441\u0434\u0435\u043b\u0430\u043b
    \u0435\u0433\u043e \u043d\u043e\u0432\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c\u00bb,
    \u0443\u043a\u0430\u0437\u0430\u043b \u043d\u0430 \u043f\u0440\u043e\u0431\u0435\u043b\u044b
    \u0432 \u0437\u043d\u0430\u043d\u0438\u044f\u0445 \u0438 \u043f\u043e\u043c\u043e\u0433
    \u0438\u0445 \u0432\u043e\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u044c. \u0412\u043b\u0438\u044f\u043d\u0438\u0435
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u043d\u0430 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430
    \u0442\u0440\u0443\u0434\u043d\u043e \u043f\u0435\u0440\u0435\u043e\u0446\u0435\u043d\u0438\u0442\u044c,
    \u0438 \u043f\u043e\u0437\u0436\u0435 \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442
    \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442 \u0438\u0437\u0434\u0430\u043d\u0438\u044e
    \u0438 \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u043a\u0435 \u0435\u0433\u043e
    \u0442\u0440\u0443\u0434\u043e\u0432.\n\n\U0001F468\u200d\U0001F3EB \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0437\u0440\u0435\u043b\u044b\u0435
    \u0433\u043e\u0434\u044b \u0412 1858 \u0433\u043e\u0434\u0443 \u043f\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0432 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u0426\u044e\u0440\u0438\u0445\u0430 (\u043d\u044b\u043d\u0435
    \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u0430\u044f \u0432\u044b\u0441\u0448\u0430\u044f
    \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0448\u043a\u043e\u043b\u0430
    \u0426\u044e\u0440\u0438\u0445\u0430). \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c,
    \u043f\u0440\u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435 \u043a \u043b\u0435\u043a\u0446\u0438\u044f\u043c
    \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e, \u043e\u043d \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f
    \u0441 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043c \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0430\u043d\u0430\u043b\u0438\u0437\u0430.
    \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u0435\u0433\u043e \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439
    \u0441\u0442\u0430\u043b\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u0432\u0430
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u00bb, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043e\u043d \u043e\u0441\u043e\u0437\u043d\u0430\u043b 24 \u043d\u043e\u044f\u0431\u0440\u044f
    1858 \u0433\u043e\u0434\u0430. \u0412 1862 \u0433\u043e\u0434\u0443 \u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u0440\u043e\u0434\u043d\u043e\u0439 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433,
    \u043f\u0440\u0438\u043d\u044f\u0432 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043e\u0442 \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u0442\u0430\u0440\u043e\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043a \u0442\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0431\u044b\u043b
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0412\u044b\u0441\u0448\u0443\u044e
    \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0448\u043a\u043e\u043b\u0443
    (Braunschweig Polytechnikum). \u0412 \u044d\u0442\u043e\u043c \u0443\u0447\u0435\u0431\u043d\u043e\u043c
    \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0434\u043e 1894 \u0433\u043e\u0434\u0430, \u0430 \u0437\u0430\u0442\u0435\u043c \u0432\u044b\u0448\u0435\u043b
    \u043d\u0430 \u043f\u0435\u043d\u0441\u0438\u044e, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f
    \u0438\u0437\u0440\u0435\u0434\u043a\u0430 \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430\u0443\u043a\u043e\u0439. \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430 \u0431\u044b\u043b\u0430 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0439
    \u0438 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u0430 \u0432\u043e\u043a\u0440\u0443\u0433
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u0441\u0435\u043c\u044c\u0438. \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0438 \u0432\u0441\u044e
    \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u043e\u0436\u0438\u043b \u0441\u043e \u0441\u0432\u043e\u0435\u0439
    \u0441\u0435\u0441\u0442\u0440\u043e\u0439 \u042e\u043b\u0438\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0442\u0430\u043a\u0436\u0435 \u043d\u0435 \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436.\n\n\U0001F4A1
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0420\u0438\u0445\u0430\u0440\u0434\u0430 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043b\u0435\u0436\u0430\u0442 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445: \u0421\u0442\u0440\u043e\u0433\u043e\u0435
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b (\u00ab\u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u0432\u044b
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u00bb): \u0412 \u0441\u0432\u043e\u0435\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430\u00bb (1872) \u043e\u043d \u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u043a\u0430\u043a \u00ab\u0441\u0435\u0447\u0435\u043d\u0438\u044f\u00bb
    (\u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u044f) \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0432\u0441\u0435\u0445 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u043d\u0430 \u0434\u0432\u0430 \u043a\u043b\u0430\u0441\u0441\u0430.
    \u042d\u0442\u0430 \u0438\u0434\u0435\u044f \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u0430 \u0441\u0430\u043c \u043c\u0435\u0442\u043e\u0434,
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \u00ab\u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u0432\u044b\u043c
    \u0441\u0435\u0447\u0435\u043d\u0438\u0435\u043c\u00bb, \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043e\u0441\u043d\u043e\u0432
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b:
    \u0412 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f\u0445
    \u043a \u043b\u0435\u043a\u0446\u0438\u044f\u043c \u0414\u0438\u0440\u0438\u0445\u043b\u0435
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b (\u0438\u0437\u0434\u0430\u043d\u0438\u044f
    1879 \u0438 1894 \u0433\u043e\u0434\u043e\u0432) \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u0432\u0432\u0435\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u2014 \u0438\u0434\u0435\u0430\u043b \u0438
    \u043a\u043e\u043b\u044c\u0446\u043e (\u0445\u043e\u0442\u044f \u0442\u0435\u0440\u043c\u0438\u043d
    \u00ab\u043a\u043e\u043b\u044c\u0446\u043e\u00bb \u0431\u044b\u043b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d
    \u043f\u043e\u0437\u0436\u0435 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c).
    \u0422\u0435\u043e\u0440\u0438\u044f \u0438\u0434\u0435\u0430\u043b\u043e\u0432 \u0431\u044b\u043b\u0430
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u0430 \u0438\u043c \u0434\u043b\u044f
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0440\u0430\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0435
    \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0438 \u0432 \u043f\u043e\u043b\u044f\u0445
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u0433\u0434\u0435 \u044d\u0442\u0430 \u0442\u0435\u043e\u0440\u0435\u043c\u0430, \u0432\u043e\u043e\u0431\u0449\u0435
    \u0433\u043e\u0432\u043e\u0440\u044f, \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442.
    \u0410\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b: \u0412 \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u0427\u0442\u043e
    \u0442\u0430\u043a\u043e\u0435 \u0447\u0438\u0441\u043b\u0430 \u0438 \u0434\u043b\u044f
    \u0447\u0435\u0433\u043e \u043e\u043d\u0438 \u0441\u043b\u0443\u0436\u0430\u0442?\u00bb
    (1888) \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u0432\u0432\u0435\u0434\u044f \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u00ab\u0435\u0434\u0438\u043d\u0438\u0446\u044b\u00bb
    \u0438 \u00ab\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u00bb.
    \u042d\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430, \u043d\u0435\u043c\u043d\u043e\u0433\u043e
    \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u0430\u044f, \u0431\u044b\u043b\u0430 \u0432\u0441\u043a\u043e\u0440\u0435
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0430 \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435
    \u041f\u0435\u0430\u043d\u043e \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u043a\u0430\u043a \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u041f\u0435\u0430\u043d\u043e.
    \u0420\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432:
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u0438\u0437\u043d\u0430\u043b \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0413\u0435\u043e\u0440\u0433\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0430.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430:
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e,
    \u0435\u0441\u043b\u0438 \u043e\u043d\u043e \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u043e
    (\u043f\u043e\u0434\u043e\u0431\u043d\u043e) \u0441\u0432\u043e\u0435\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0447\u0430\u0441\u0442\u0438. \u041f\u043e\u043c\u0438\u043c\u043e \u044d\u0442\u0438\u0445
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432, \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u0432\u043d\u0435\u0441
    \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u0442\u0435\u043e\u0440\u0438\u044e \u0413\u0430\u043b\u0443\u0430 (\u043e\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u043d\u0430\u0447\u0430\u043b \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438
    \u043f\u043e \u044d\u0442\u043e\u0439 \u0442\u0435\u043c\u0435 \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435),
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u043e\u043c
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0445 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0439
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439 \u0413\u0430\u0443\u0441\u0441\u0430,
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u0438 \u0420\u0438\u043c\u0430\u043d\u0430.
    \u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    12 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 1916 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435,
    \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e
    \u044f\u0437\u044b\u043a \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0412\u043d\u0435\u0448\u043d\u0435 \u0436\u0438\u0437\u043d\u044c \u0420\u0438\u0445\u0430\u0440\u0434\u0430
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430, \u043f\u0440\u043e\u0448\u0435\u0434\u0448\u0430\u044f
    \u0432 \u0435\u0433\u043e \u0440\u043e\u0434\u043d\u043e\u043c \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435,
    \u0431\u044b\u043b\u0430 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0439 \u0438 \u0440\u0430\u0437\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439.
    \u0417\u0430 \u044d\u0442\u043e\u0439 \u0432\u043d\u0435\u0448\u043d\u0435\u0439 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u043e\u0439
    \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u044c \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c,
    \u043f\u043e\u043b\u043d\u0430\u044f \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u0438\u044f,
    \u0442\u043e\u043d\u043a\u0438\u0445 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439
    \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0445 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445
    \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432 \u043d\u0430 \u0441\u0430\u043c\u0443 \u0441\u0443\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\U0001F9E0 \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0447\u0435\u0440\u0435\u0437...
    \u0441\u0430\u043c\u043e\u0433\u043e \u0441\u0435\u0431\u044f \u0412 \u0441\u0432\u043e\u0435\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435
    \u0447\u0438\u0441\u043b\u0430 \u0438 \u0434\u043b\u044f \u0447\u0435\u0433\u043e \u043e\u043d\u0438
    \u0441\u043b\u0443\u0436\u0430\u0442?\u00bb (1888) \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u00ab\u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u00bb
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. \u041e\u043d\u043e \u043d\u0435 \u043e\u043f\u0438\u0440\u0430\u043b\u043e\u0441\u044c
    \u043d\u0430 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435 \u0430\u043a\u0441\u0438\u043e\u043c\u044b,
    \u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u043b\u043e\u0441\u044c \u0441 \u0441\u0430\u043c\u043e\u0433\u043e
    \u043b\u0438\u0447\u043d\u043e\u0433\u043e \u0438 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e.
    \u041e\u043d \u043f\u0438\u0441\u0430\u043b: \u00ab\u041c\u043e\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043c\u0438\u0440 \u043c\u044b\u0441\u043b\u0435\u0439, \u0442\u043e \u0435\u0441\u0442\u044c
    \u0441\u043e\u0432\u043e\u043a\u0443\u043f\u043d\u043e\u0441\u0442\u044c S \u0432\u0441\u0435\u0445
    \u0432\u0435\u0449\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u0443\u0442
    \u0431\u044b\u0442\u044c \u043e\u0431\u044a\u0435\u043a\u0442\u0430\u043c\u0438 \u043c\u043e\u0435\u0439
    \u043c\u044b\u0441\u043b\u0438, \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u0435\u043d.
    \u0418\u0431\u043e \u0435\u0441\u043b\u0438 s \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442 S, \u0442\u043e \u043c\u044b\u0441\u043b\u044c
    s' \u043e \u0442\u043e\u043c, \u0447\u0442\u043e s \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u043c \u043c\u043e\u0435\u0439 \u043c\u044b\u0441\u043b\u0438,
    \u0441\u0430\u043c\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u043c
    S\u00bb. \u041f\u0440\u043e\u0441\u0442\u044b\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438,
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043c\u0435\u0442\u0430-\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435:
    \u043a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u044b \u0434\u0443\u043c\u0430\u0435\u0442\u0435
    \u043e \u043a\u0430\u043a\u043e\u0439-\u043b\u0438\u0431\u043e \u043c\u044b\u0441\u043b\u0438,
    \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043d\u043e\u0432\u0430\u044f \u043c\u044b\u0441\u043b\u044c
    \u2014 \u043c\u044b\u0441\u043b\u044c \u043e\u0431 \u044d\u0442\u043e\u0439 \u043c\u044b\u0441\u043b\u0438.
    \u042d\u0442\u043e\u0442 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043c\u043e\u0436\u043d\u043e
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e,
    \u0447\u0442\u043e, \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e,
    \u0441\u043b\u0443\u0436\u0438\u043b\u043e \u00ab\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u043c\u00bb
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438.
    \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440
    \u041b\u0451\u0439\u0442\u0446\u0435\u043d \u042d\u0433\u0431\u0435\u0440\u0442 \u042f\u043d
    \u0411\u0440\u0430\u0443\u044d\u0440, \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b\u0438
    \u044d\u0442\u043e\u0442 \u0445\u043e\u0434, \u0441\u0447\u0438\u0442\u0430\u044f \u0435\u0433\u043e
    \u043f\u043e\u043f\u044b\u0442\u043a\u043e\u0439 \u0432\u044b\u0432\u0435\u0441\u0442\u0438
    \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438\u0441\u0442\u0438\u043d\u0443 \u0438\u0437 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0433\u043e
    \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0430\u043a\u0442\u0430
    (\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f).
    \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u044d\u0442\u043e\u0442
    \u043f\u0430\u0441\u0441\u0430\u0436 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u0432
    \u0432 \u0435\u0433\u043e \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0435.\n\n\U0001F602
    \u041e\u0441\u0442\u0440\u043e\u0443\u043c\u0438\u0435 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e
    \u044e\u043c\u043e\u0440\u0430 \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438,
    \u0447\u0442\u043e \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434, \u043f\u0440\u0438
    \u0432\u0441\u0435\u0439 \u0441\u0432\u043e\u0435\u0439 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u0438,
    \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0442\u043e\u043d\u043a\u0438\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b\u043e\u0441\u044c
    \u0432 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0438 \u0434\u0430\u0436\u0435
    \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u044f\u0445.
    \u041e\u0442\u0432\u0435\u0442 \u043d\u0430 \u043d\u0435\u043a\u0440\u043e\u043b\u043e\u0433:
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u0438
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e
    \u0441\u043e\u043e\u0431\u0449\u0438\u043b\u0438 \u043e \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    \u0443\u043a\u0430\u0437\u0430\u0432 \u043d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 \u0433\u043e\u0434.
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434, \u0436\u0438\u0432\u043e\u0439 \u0438
    \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0439, \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0438\u043c \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u0441\u0443\u0445\u0438\u043c
    \u0438 \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u044b\u043c \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u0435\u043c:
    \u00ab\u0414\u0430\u0442\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0439,
    \u0430 \u0433\u043e\u0434 \u2014 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0442\u043e\u0447\u043d\u043e \u043d\u0435\u0442\u00bb. \u042d\u0442\u043e\u0442 \u044d\u043f\u0438\u0437\u043e\u0434
    \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0435\u0433\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u0443\u0442\u0438\u043c\u043e\u0441\u0442\u044c
    \u0438 \u044f\u0441\u043d\u043e\u0441\u0442\u044c \u0443\u043c\u0430. \u0412\u0437\u0433\u043b\u044f\u0434
    \u043d\u0430 \u0434\u043e\u0436\u0434\u043b\u0438\u0432\u0443\u044e \u043f\u043e\u0433\u043e\u0434\u0443:
    \u0412 \u043f\u0438\u0441\u044c\u043c\u0435 \u043a \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u0435
    \u042e\u043b\u0438\u0438 \u043e\u043d \u0441 \u043b\u0435\u0433\u043a\u043e\u0439 \u0438\u0440\u043e\u043d\u0438\u0435\u0439
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b: \u00ab\u0414\u043e\u0436\u0434\u043b\u0438\u0432\u044b\u0439
    \u0434\u0435\u043d\u044c = \u0441\u0435\u0440\u044b\u0439 \u0434\u0435\u043d\u044c = \u0445\u043e\u0440\u043e\u0448\u0438\u0439
    \u0434\u0435\u043d\u044c\u00bb. \u0412\u0438\u0434\u0438\u043c\u043e, \u0434\u043b\u044f
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0441\u043a\u0430\u043b
    \u0443\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445
    \u043c\u044b\u0441\u043b\u0435\u0439, \u043d\u0435\u043f\u043e\u0433\u043e\u0434\u0430 \u0431\u044b\u043b\u0430
    \u043f\u043e\u0432\u043e\u0434\u043e\u043c \u043e\u0441\u0442\u0430\u0442\u044c\u0441\u044f
    \u0434\u043e\u043c\u0430 \u0438 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.\n\n\U0001F4DC \u0420\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u0430\u044f
    \u0442\u0435\u0440\u043f\u0438\u043c\u043e\u0441\u0442\u044c \u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u0447\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c \u0413\u043b\u0443\u0431\u043e\u043a\u043e
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434, \u0442\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435,
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    (1870-\u0435 \u0433\u043e\u0434\u044b, \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f)
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0441\u0442\u044c \u0438 \u0441\u0432\u0435\u0442\u0441\u043a\u043e\u0441\u0442\u044c.
    \u041a\u043e\u0433\u0434\u0430 \u043e\u043d \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u0441\u0432\u043e\u0435\u0433\u043e
    \u0434\u0440\u0443\u0433\u0430 \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434\u0430 \u0420\u0438\u043c\u0430\u043d\u0430,
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043f\u0438\u0441\u044c\u043c\u0430
    \u0435\u0433\u043e \u0432\u0434\u043e\u0432\u044b \u042d\u043b\u0438\u0437\u044b. \u0412
    \u043d\u0438\u0445 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0438\u0441\u044c \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435 \u0444\u0440\u0430\u0437\u044b,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e \u0442\u043e\u043c, \u043a\u0430\u043a
    \u0434\u0443\u0448\u0430 \u0420\u0438\u043c\u0430\u043d\u0430 \u00ab\u0432\u043e\u0437\u043d\u0435\u0441\u043b\u0430\u0441\u044c
    \u043a \u0411\u043e\u0433\u0443\u00bb (aufgegangen in Gott). \u0412 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0437\u0430\u043c\u0435\u043d\u0438\u043b \u044d\u0442\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u043d\u0430 \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0438 \u0441\u0432\u0435\u0442\u0441\u043a\u043e\u0435
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435: \u00ab\u0435\u0433\u043e \u0447\u0438\u0441\u0442\u043e\u0435,
    \u0431\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0441\u0435\u0440\u0434\u0446\u0435
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u043e \u0431\u0438\u0442\u044c\u0441\u044f\u00bb.
    \u041e\u043d \u043f\u043e\u0448\u0435\u043b \u043d\u0430 \u044d\u0442\u043e, \u0436\u0435\u043b\u0430\u044f,
    \u0447\u0442\u043e\u0431\u044b \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0431\u044b\u043b\u0430
    \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0438 \u043f\u043e\u043d\u044f\u0442\u043d\u0430
    \u0432\u0441\u0435\u043c \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u044f\u043c, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u0438\u0445 \u0432\u0435\u0440\u043e\u0438\u0441\u043f\u043e\u0432\u0435\u0434\u0430\u043d\u0438\u044f,
    \u0438 \u043d\u0435 \u043d\u0430\u0432\u044f\u0437\u044b\u0432\u0430\u043b\u0430 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435
    \u0432\u0437\u0433\u043b\u044f\u0434\u044b. \u042d\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0435\u0433\u043e \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u0443\u043a\u0435
    \u043a\u0430\u043a \u043a \u043e\u0431\u0449\u0435\u043c\u0443 \u0434\u0435\u043b\u0443,
    \u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u0432\u044b\u0448\u0435 \u043b\u0438\u0447\u043d\u044b\u0445
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u0439. \u0415\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435 \u043d\u0430 \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u043e\u043c
    \u043a\u0430\u043c\u043d\u0435 \u0446\u0438\u0442\u0438\u0440\u0443\u0435\u0442 \u0412\u0442\u043e\u0440\u043e\u0435
    \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u0435 \u043a \u0422\u0438\u043c\u043e\u0444\u0435\u044e
    4:7-8: \u00ab\u041f\u043e\u0434\u0432\u0438\u0433\u043e\u043c \u0434\u043e\u0431\u0440\u044b\u043c
    \u044f \u043f\u043e\u0434\u0432\u0438\u0437\u0430\u043b\u0441\u044f, \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b, \u0432\u0435\u0440\u0443 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u00bb,
    \u0447\u0442\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u043b\u0438\u0447\u043d\u043e\u0439,
    \u043d\u043e \u043d\u0435 \u043d\u0430\u0432\u044f\u0437\u0447\u0438\u0432\u043e\u0439 \u0432\u0435\u0440\u0435.\n\n\U0001F468\u200d\U0001F3EB
    \u0412\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u043e \u0432\u0435\u043b\u0438\u043a\u043e\u043c
    \u0413\u0430\u0443\u0441\u0441\u0435 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0431\u0435\u0441\u0446\u0435\u043d\u043d\u044b\u0435, \u0436\u0438\u0432\u044b\u0435 \u043c\u0435\u043c\u0443\u0430\u0440\u044b
    \u043e \u0441\u0432\u043e\u0435\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435, \u041a\u0430\u0440\u043b\u0435
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0435 \u0413\u0430\u0443\u0441\u0441\u0435, \u0441
    \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435. \u042d\u0442\u0438
    \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u0440\u0438\u0441\u0443\u044e\u0442
    \u043e\u0431\u0440\u0430\u0437 \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043d\u0435 \u043a\u0430\u043a \u043d\u0435\u0434\u043e\u0441\u044f\u0433\u0430\u0435\u043c\u043e\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f, \u0430 \u043a\u0430\u043a \u0436\u0438\u0432\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u041e\u043d \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u0438\u0437\u0438\u0442
    \u043a \u0413\u0430\u0443\u0441\u0441\u0443: \u00ab\u0441 \u0437\u0430\u043c\u0438\u0440\u0430\u043d\u0438\u0435\u043c
    \u0441\u0435\u0440\u0434\u0446\u0430, \u044f \u0432\u043e\u0448\u0435\u043b \u0432 \u0435\u0433\u043e
    \u0436\u0438\u043b\u0443\u044e \u043a\u043e\u043c\u043d\u0430\u0442\u0443\u00bb. \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u043b \u043c\u0430\u043d\u0435\u0440\u0443 \u0413\u0430\u0443\u0441\u0441\u0430
    \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438 \u2014 \u0441\u0438\u0434\u0435\u0442\u044c
    \u0432 \u043a\u043e\u0440\u0438\u0447\u043d\u0435\u0432\u043e\u043c \u0441\u044e\u0440\u0442\u0443\u043a\u0435
    \u0438 \u0441\u0435\u0440\u044b\u0445 \u0431\u0440\u044e\u043a\u0430\u0445, \u0432 \u0447\u0435\u0440\u043d\u043e\u0439
    \u0448\u0430\u043f\u043e\u0447\u043a\u0435, \u0438 \u043a\u043e\u0433\u0434\u0430 \u043e\u043d
    \u0445\u043e\u0442\u0435\u043b \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u043d\u0443\u0442\u044c
    \u0432\u0430\u0436\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442, \u043e\u043d
    \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u043b \u0433\u043e\u043b\u043e\u0432\u0443 \u0438
    \u00ab\u043f\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e \u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u043d\u0430 \u043d\u0435\u0433\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u0433\u043e\u043b\u0443\u0431\u044b\u043c\u0438 \u0433\u043b\u0430\u0437\u0430\u043c\u0438\u00bb.
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u0413\u0430\u0443\u0441\u0441, \u0432 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u0435
    \u0432\u043b\u0430\u0434\u0435\u044f \u044f\u0437\u044b\u043a\u043e\u043c, \u0438\u043d\u043e\u0433\u0434\u0430
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0435\u0447\u0438\u044f
    \u0438\u0437 \u0431\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0441\u043a\u043e\u0433\u043e
    \u0434\u0438\u0430\u043b\u0435\u043a\u0442\u0430, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0441\u0447\u0438\u0442\u0430\u043b \"eine, zweie, dreie\" \u0432\u043c\u0435\u0441\u0442\u043e
    \"eins, zwei, drei\", \u043a\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0433\u043e\u0440\u043e\u0436\u0430\u043d\u0435
    \u043d\u0430 \u0440\u044b\u043d\u043a\u0435. \u0421\u0430\u043c \u0413\u0430\u0443\u0441\u0441
    \u043d\u0430\u0437\u0432\u0430\u043b \u0441\u0432\u043e\u0438 \u043b\u0435\u043a\u0446\u0438\u0438
    \u00ab\u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0441\u0443\u0445\u0438\u043c\u0438\u00bb,
    \u043d\u043e \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u043b \u0438\u0445 \u043a\u0430\u043a \u043e\u0434\u043d\u0438
    \u0438\u0437 \u043b\u0443\u0447\u0448\u0438\u0445 \u0432 \u0441\u0432\u043e\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F3B5 \u0427\u0435\u043b\u043e\u0432\u0435\u043a
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430 \u0414\u0430\u043b\u0435\u043a\u043e
    \u043d\u0435 \u0432\u0441\u0435 \u0437\u043d\u0430\u044e\u0442, \u0447\u0442\u043e \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434
    \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u043c \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u043e\u043c.
    \u0412 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438 \u043e\u043d \u0438\u0433\u0440\u0430\u043b
    \u043d\u0430 \u0432\u0438\u043e\u043b\u043e\u043d\u0447\u0435\u043b\u0438, \u0430 \u0432
    \u0431\u043e\u043b\u0435\u0435 \u0437\u0440\u0435\u043b\u044b\u0435 \u0433\u043e\u0434\u044b
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f \u043d\u0430 \u0444\u043e\u0440\u0442\u0435\u043f\u0438\u0430\u043d\u043e.
    \u042d\u0442\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u044f\u043b\u043e
    \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0433\u043e
    \u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0438\u0433\u0435\u043d\u0442\u043d\u043e\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0441 \u0442\u043e\u043d\u043a\u043e\u0439
    \u0434\u0443\u0448\u0435\u0432\u043d\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0435\u0439.\n\n\u2709\ufe0f
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u0432\u043e\u044e \u0441\u043a\u0440\u043e\u043c\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c \u0432 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0435,
    \u0432\u043a\u043b\u0430\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430 \u0431\u044b\u043b
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u043c\u0438\u0440\u043e\u043c.
    \u041e\u043d \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a (\u0441 1880 \u0433\u043e\u0434\u0430)
    \u0438 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c \u0447\u043b\u0435\u043d\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a (\u0441 1910 \u0433\u043e\u0434\u0430), \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u0435
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0438\u0435 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u043e\u0432 \u041e\u0441\u043b\u043e,
    \u0426\u044e\u0440\u0438\u0445\u0430 \u0438 \u0411\u0440\u0430\u0443\u043d\u0448\u0432\u0435\u0439\u0433\u0430.
    \u0410 \u0432 1981 \u0433\u043e\u0434\u0443, \u043a 150-\u043b\u0435\u0442\u0438\u044e \u0441\u043e
    \u0434\u043d\u044f \u0435\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u0432 \u0413\u0414\u0420 \u0431\u044b\u043b\u0430 \u0432\u044b\u043f\u0443\u0449\u0435\u043d\u0430
    \u043f\u043e\u0447\u0442\u043e\u0432\u0430\u044f \u043c\u0430\u0440\u043a\u0430 \u0441 \u0435\u0433\u043e
    \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c. \u042d\u0442\u0438
    \u0444\u0430\u043a\u0442\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442,
    \u0447\u0442\u043e \u0437\u0430 \u0444\u0430\u0441\u0430\u0434\u043e\u043c \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0441\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u0447\u044c\u0438 \u0438\u0434\u0435\u0438 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438
    \u043c\u0438\u0440, \u0430 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0431\u044b\u043b
    \u043f\u043e\u043b\u043e\u043d \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0445
    \u0433\u0440\u0430\u043d\u0435\u0439: \u043e\u0442 \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438
    \u043c\u044b\u0441\u043b\u0438 \u0434\u043e \u0442\u043e\u043d\u043a\u043e\u0433\u043e \u044e\u043c\u043e\u0440\u0430
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u043e\u0441\u0442\u0438."
