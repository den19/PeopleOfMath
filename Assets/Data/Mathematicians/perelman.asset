  fullNameRu: "\u041F\u0435\u0440\u0435\u043B\u044C\u043C\u0430\u043D, \u0413\u0440\u0438\u0433\u043E\u0440\u0438\u0439
    \u042F\u043A\u043E\u0432\u043B\u0435\u0432\u0438\u0447"
  fullNameEn: Grigori Perelman
