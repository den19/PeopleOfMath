  achievementsRu: "\u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u044f \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430
    \u0438 \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    1. \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u043e \u0434\u0443\u0448\u0435 (1994)
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u043e\u0439
    \u043a\u0440\u0443\u043f\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439, \u043f\u0440\u0438\u043d\u0435\u0441\u0448\u0435\u0439
    \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0440\u0443\u0433\u0430\u0445. \u0412 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0435\u0441\u0442\u044c \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u00ab\u0434\u0443\u0448\u0438\u00bb \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f
    \u2014 \u0435\u0433\u043e \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0433\u043e
    \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0433\u043e \u00ab\u0441\u043a\u0435\u043b\u0435\u0442\u0430\u00bb.
    \u0412 1972 \u0433\u043e\u0434\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0414\u0436\u0435\u0444\u0444 \u0427\u0438\u0433\u0435\u0440 \u0438 \u0414\u0435\u0442\u043b\u0435\u0444
    \u0413\u0440\u043e\u043c\u043e\u043b \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u043e \u0434\u0443\u0448\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u0430: \u0435\u0441\u043b\u0438 \u0432
    \u043a\u0430\u0436\u0434\u043e\u0439 \u0442\u043e\u0447\u043a\u0435 \u043f\u043e\u043b\u043d\u043e\u0433\u043e
    \u043d\u0435\u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0433\u043e \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u0430
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f \u0441 \u043d\u0435\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u043e\u0439 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u0433\u0434\u0435 \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0430
    \u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0430,
    \u0442\u043e \u0435\u0433\u043e \u00ab\u0434\u0443\u0448\u0430\u00bb \u0432\u044b\u0440\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0442\u043e\u0447\u043a\u0443, \u0430 \u0441\u0430\u043c\u043e \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435
    \u0443\u0441\u0442\u0440\u043e\u0435\u043d\u043e \u043a\u0430\u043a \u043e\u0431\u044b\u0447\u043d\u043e\u0435
    \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e.
    \u0412\u043a\u043b\u0430\u0434 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430:
    \u041a\u0440\u0430\u0442\u043a\u043e\u0441\u0442\u044c \u0438 \u0438\u0437\u044f\u0449\u0435\u0441\u0442\u0432\u043e:
    \u0412 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u0434\u0440\u0443\u0433\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043f\u0438\u0441\u0430\u043b\u0438
    \u043e\u0431\u044a\u0451\u043c\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b, \u043f\u044b\u0442\u0430\u044f\u0441\u044c
    \u0440\u0435\u0448\u0438\u0442\u044c \u044d\u0442\u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443,
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u0437\u0430\u043d\u044f\u0432\u0448\u0435\u0435
    \u0432\u0441\u0435\u0433\u043e \u0447\u0435\u0442\u044b\u0440\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b.
    \u041d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434:
    \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0442\u0435\u0445\u043d\u0438\u043a\u0443
    \u0440\u0435\u0442\u0440\u0430\u043a\u0446\u0438\u0438 \u0428\u0430\u0440\u0430\u0444\u0443\u0442\u0434\u0438\u043d\u043e\u0432\u0430,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u043e\u043d\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0441\u0443\u0431\u043c\u0435\u0440\u0441\u0438\u0435\u0439, \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u00ab\u0434\u0443\u0448\u0430\u00bb \u043e\u0431\u044f\u0437\u0430\u043d\u0430 \u0431\u044b\u0442\u044c
    \u0442\u043e\u0447\u043a\u043e\u0439. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u042d\u0442\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0435\u0433\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0430\u043b\u0430\u043d\u0442
    \u0432\u0438\u0434\u0435\u0442\u044c \u0441\u0443\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0438
    \u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e
    \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0442\u0430\u043c,
    \u0433\u0434\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0432\u0438\u0434\u0435\u043b\u0438
    \u043b\u0438\u0448\u044c \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438. 2. \u0413\u043b\u0430\u0432\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435: \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    (2002\u20132003) \u042d\u0442\u043e \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u043d\u0430\u0443\u043a\u0443.
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435,
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432 1904 \u0433\u043e\u0434\u0443, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438 \u2014
    \u043d\u0430\u0443\u043a\u0438 \u043e \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u0445
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432, \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0449\u0438\u0445\u0441\u044f
    \u043f\u0440\u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f\u0445.
    \u041e\u043d\u0430 \u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043a: \u0432\u0441\u044f\u043a\u043e\u0435
    \u043e\u0434\u043d\u043e\u0441\u0432\u044f\u0437\u043d\u043e\u0435 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0435
    \u0442\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u0435 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435
    \u0431\u0435\u0437 \u043a\u0440\u0430\u044f \u0433\u043e\u043c\u0435\u043e\u043c\u043e\u0440\u0444\u043d\u043e
    \u0442\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u0439 \u0441\u0444\u0435\u0440\u0435.
    \u041f\u0440\u043e\u0441\u0442\u044b\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438:
    \u0435\u0441\u043b\u0438 \u0432\u0437\u044f\u0442\u044c \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u044b\u0439
    \u043e\u0431\u044a\u0435\u043a\u0442, \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043d\u0435\u0442 \u0434\u044b\u0440, \u0438 \u043b\u044e\u0431\u0443\u044e \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u0443\u044e
    \u043f\u0435\u0442\u043b\u044e \u043d\u0430 \u043d\u0451\u043c \u043c\u043e\u0436\u043d\u043e
    \u0441\u0442\u044f\u043d\u0443\u0442\u044c \u0432 \u0442\u043e\u0447\u043a\u0443, \u0442\u043e
    \u044d\u0442\u043e\u0442 \u043e\u0431\u044a\u0435\u043a\u0442 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0435\u043d \u0442\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u0439
    \u0441\u0444\u0435\u0440\u0435. \u042d\u0442\u0430 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u0431\u044b\u043b\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0435\u043c\u0438
    \u00ab\u0437\u0430\u0434\u0430\u0447 \u0442\u044b\u0441\u044f\u0447\u0435\u043b\u0435\u0442\u0438\u044f\u00bb,
    \u0437\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u041a\u043b\u044d\u044f \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u043f\u0440\u0435\u043c\u0438\u044e
    \u0432 1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432.
    \u0412\u043a\u043b\u0430\u0434 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430:
    \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u0430 \u043f\u043e\u0442\u043e\u043a\u0430
    \u0420\u0438\u0447\u0447\u0438: \u0418\u0441\u0445\u043e\u0434\u043d\u0443\u044e \u0438\u0434\u0435\u044e
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0420\u0438\u0447\u0430\u0440\u0434 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0432 1981 \u0433\u043e\u0434\u0443. \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u043f\u043e\u0442\u043e\u043a\u0430
    \u0420\u0438\u0447\u0447\u0438 \u2014 \u043f\u0440\u043e\u0446\u0435\u0441\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u00ab\u0441\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u00bb \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f, \u043f\u043e\u0434\u043e\u0431\u043d\u043e
    \u0442\u043e\u043c\u0443, \u043a\u0430\u043a \u0442\u0435\u043f\u043b\u043e \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u0435\u0442
    \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0432 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0442\u0435\u043b\u0435. \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u043d\u0430\u0434\u0435\u044f\u043b\u0441\u044f,
    \u0447\u0442\u043e \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442
    \u043b\u044e\u0431\u043e\u0435 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435
    \u0432 \u0441\u0444\u0435\u0440\u0443, \u043d\u043e \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f
    \u0441 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u00ab\u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0435\u0439\u00bb
    \u2014 \u043e\u0441\u043e\u0431\u044b\u0445 \u0442\u043e\u0447\u0435\u043a, \u0433\u0434\u0435
    \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439, \u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441
    \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f.
    \u041c\u0435\u0442\u043e\u0434 \u00ab\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb:
    \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u0432 \u0442\u043e\u043c,
    \u0447\u0442\u043e \u043e\u043d \u043d\u0430\u0448\u0451\u043b \u0441\u043f\u043e\u0441\u043e\u0431
    \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u0438
    \u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438. \u041e\u043d
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u0445\u043d\u0438\u043a\u0443
    \u00ab\u043f\u043e\u0442\u043e\u043a\u0430 \u0420\u0438\u0447\u0447\u0438 \u0441 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0435\u0439\u00bb:
    \u043f\u0440\u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0438 \u043a
    \u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438 \u043e\u043d
    \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u043b \u043f\u0440\u043e\u0446\u0435\u0441\u0441,
    \u00ab\u0432\u044b\u0440\u0435\u0437\u0430\u043b\u00bb \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043d\u0443\u044e
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c (\u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c)
    \u0438 \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e \u00ab\u0441\u0448\u0438\u0432\u0430\u043b\u00bb
    \u043a\u0440\u0430\u044f, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u044e. \u041d\u043e\u0432\u044b\u0435 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b: \u0414\u043b\u044f \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u0432\u043e\u0435\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0432\u0432\u0451\u043b \u043d\u043e\u0432\u044b\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438,
    \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u00ab\u044d\u043d\u0442\u0440\u043e\u043f\u0438\u044f
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430\u00bb \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b
    F. \u042d\u0442\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0434\u043b\u0438\u0442\u044c\u0441\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u0438 \u0432 \u0438\u0442\u043e\u0433\u0435 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0442\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u0443\u044e \u0441\u0444\u0435\u0440\u0443.
    \u0424\u043e\u0440\u043c\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438:
    \u041e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0435 \u0432 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u043c
    \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u0440\u0443\u0435\u043c\u043e\u043c \u0436\u0443\u0440\u043d\u0430\u043b\u0435,
    \u0430 \u0432 \u0432\u0438\u0434\u0435 \u0442\u0440\u0451\u0445 \u043f\u0440\u0435\u043f\u0440\u0438\u043d\u0442\u043e\u0432
    \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 arXiv.org \u0432 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441 \u043d\u043e\u044f\u0431\u0440\u044f 2002 \u043f\u043e \u0438\u044e\u043b\u044c 2003
    \u0433\u043e\u0434\u0430. \u0422\u0435\u043a\u0441\u0442 \u0431\u044b\u043b \u043a\u0440\u0430\u0439\u043d\u0435
    \u0441\u0436\u0430\u0442\u044b\u043c \u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b
    \u043b\u0438\u0448\u044c \u043e\u0431\u0449\u0443\u044e \u0441\u0445\u0435\u043c\u0443 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430,
    \u0447\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c
    \u0432 \u0435\u0433\u043e \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0435
    \u043c\u0438\u0440\u043e\u0432\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435:
    \u041a 2006 \u0433\u043e\u0434\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445 \u0433\u0440\u0443\u043f\u043f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430,
    \u043d\u0435 \u043d\u0430\u0439\u0434\u044f \u0432 \u043d\u0451\u043c \u043e\u0448\u0438\u0431\u043e\u043a,
    \u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u0438 \u0435\u0433\u043e
    \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e\u0441\u0442\u044c. \u041d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043f\u0440\u043e\u0440\u044b\u0432 \u0433\u043e\u0434\u0430: \u0412 2006 \u0433\u043e\u0434\u0443
    \u0436\u0443\u0440\u043d\u0430\u043b Science \u043d\u0430\u0437\u0432\u0430\u043b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u043c
    \u0433\u043e\u0434\u0430. \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439, \u043a\u043e\u0433\u0434\u0430 \u0442\u0430\u043a\u0430\u044f
    \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0430
    \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f \u043f\u0440\u0435\u043c\u0438\u044f
    (2006): \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0443 \u0431\u044b\u043b\u0430
    \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0430 \u0432\u044b\u0441\u0448\u0430\u044f
    \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u2014 \u043c\u0435\u0434\u0430\u043b\u044c \u0424\u0438\u043b\u0434\u0441\u0430, \u043d\u043e
    \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0435\u0451 \u043f\u0440\u0438\u043d\u044f\u0442\u044c.
    \u041f\u0440\u0435\u043c\u0438\u044f \u0442\u044b\u0441\u044f\u0447\u0435\u043b\u0435\u0442\u0438\u044f
    (2010): \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u041a\u043b\u044d\u044f \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b \u0435\u043c\u0443 \u043f\u0440\u0435\u043c\u0438\u044e
    \u0432 1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432
    \u0437\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435. \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0438 \u043e\u0442 \u044d\u0442\u043e\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b, \u0437\u0430\u044f\u0432\u0438\u0432, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043d\u0435 \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u0432\u043a\u043b\u0430\u0434
    \u0420\u0438\u0447\u0430\u0440\u0434\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430.
    \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u0441\u0442\u0430\u043b\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c
    \u0441\u0442\u043e\u043b\u0435\u0442\u043d\u0435\u0439 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u041e\u043d\u043e \u0437\u0430\u043a\u0440\u044b\u043b\u043e \u0446\u0435\u043b\u0443\u044e
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0443\u044e \u0441 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0435\u0439
    \u0442\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439,
    \u0438 \u043e\u0442\u043a\u0440\u044b\u043b\u043e \u043d\u043e\u0432\u044b\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u044b
    \u0434\u043b\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u043c\u0435\u0442\u043e\u0434\u0430 \u043f\u043e\u0442\u043e\u043a\u0430 \u0420\u0438\u0447\u0447\u0438
    \u0432 \u0441\u043c\u0435\u0436\u043d\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445."
  achievementsEn: 
  personalLifeRu: "\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439 \u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u044f \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430
    \u043e\u0447\u0435\u043d\u044c \u043c\u0430\u043b\u043e, \u0438 \u0432\u0441\u0435 \u043e\u043d\u0438
    \u0432\u0437\u044f\u0442\u044b \u0438\u0437 \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432 \u2014 \u0440\u0435\u0434\u043a\u0438\u0445
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439 \u0441\u043e\u0441\u0435\u0434\u0435\u0439
    \u0438 \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u043e\u0432, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0441\u043b\u0443\u0445\u043e\u0432. \u0421\u0430\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u043e\u0431\u0449\u0430\u0435\u0442\u0441\u044f
    \u0441 \u0432\u043d\u0435\u0448\u043d\u0438\u043c \u043c\u0438\u0440\u043e\u043c \u0438
    \u043d\u0435 \u0434\u0430\u0435\u0442 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e.
    \u0412\u043e\u0442 \u0447\u0442\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e.
    \u0421\u0435\u043c\u044c\u044f \u0438 \u0431\u043b\u0438\u0437\u043a\u0438\u0435 \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u0439
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d \u043d\u0435 \u0436\u0435\u043d\u0430\u0442
    \u0438 \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0434\u0435\u0442\u0435\u0439. \u0412\u0441\u044e
    \u0441\u0432\u043e\u044e \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u0432\u0430\u0435\u0442
    \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u043c\u0430\u0442\u0435\u0440\u044c\u044e,
    \u041b\u044e\u0431\u043e\u0432\u044c\u044e \u041b\u0435\u0439\u0431\u043e\u0432\u043d\u043e\u0439
    \u0428\u0442\u0435\u0439\u043d\u0433\u043e\u043b\u044c\u0446, \u043a\u043e\u0442\u043e\u0440\u0430\u044f,
    \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c,
    \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u0442\u0430\u0440\u0448\u0435 90 \u043b\u0435\u0442
    \u0438 \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u0443\u0445\u043e\u0434\u0435.
    \u041e\u0442\u0435\u0446, \u042f\u043a\u043e\u0432 \u041d\u0430\u0443\u043c\u043e\u0432\u0438\u0447,
    \u0431\u044b\u043b \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c-\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u043a\u043e\u043c.
    \u0412 1993 \u0433\u043e\u0434\u0443 \u043e\u043d \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u044c \u0438 \u043f\u043e\u0440\u0432\u0430\u043b
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0441\u0435\u043c\u044c\u0435\u0439,
    \u0447\u0442\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0447\u0438\u0442\u0430\u044e\u0442
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u043b\u0438\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0432\u043c\u043e\u0439
    \u0434\u043b\u044f \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430. \u041f\u043e\u0437\u0436\u0435
    \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u0440\u0430\u043a\u0430.
    \u041c\u0430\u0442\u044c, \u041b\u044e\u0431\u043e\u0432\u044c \u041b\u0435\u0439\u0431\u043e\u0432\u043d\u0430,
    \u2014 \u0431\u044b\u0432\u0448\u0430\u044f \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0438\u0432\u0438\u043b\u0430 \u0441\u044b\u043d\u0443 \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u0442\u043e\u0447\u043d\u044b\u043c \u043d\u0430\u0443\u043a\u0430\u043c \u0438
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0443\u0437\u044b\u043a\u0435.
    \u041f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0441\u043e\u0441\u0435\u0434\u0435\u0439,
    \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u0439 \u0437\u0430\u0431\u043e\u0442\u0438\u0442\u0441\u044f
    \u043e \u043d\u0435\u0439 \u0438 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u043e\u0442 \u043f\u043e\u043c\u043e\u0449\u0438 \u0441\u043e\u0446\u0441\u043b\u0443\u0436\u0431.
    \u0421\u0435\u0441\u0442\u0440\u0430, \u0415\u043b\u0435\u043d\u0430, \u0442\u0430\u043a\u0436\u0435
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c.
    \u041e\u043d\u0430 \u043e\u043a\u043e\u043d\u0447\u0438\u043b\u0430 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0437\u0430\u0449\u0438\u0442\u0438\u043b\u0430
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u0435,
    \u0430 \u0441 2007 \u0433\u043e\u0434\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u043e\u043c \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435.
    \u0421\u0432\u044f\u0437\u044c \u0441 \u0431\u0440\u0430\u0442\u043e\u043c, \u0441\u043a\u043e\u0440\u0435\u0435
    \u0432\u0441\u0435\u0433\u043e, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u0440\u0435\u0434\u043a\u043e. \u041e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438
    \u0438 \u0431\u044b\u0442 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0432\u0435\u0434\u0435\u0442 \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u043d\u044b\u0439
    \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438, \u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0449\u0438\u0439
    \u0441 \u0437\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c.
    \u041e\u043d \u0436\u0438\u0432\u0435\u0442 \u0432 \u043e\u0431\u044b\u0447\u043d\u043e\u0439
    \u043f\u0430\u043d\u0435\u043b\u044c\u043d\u043e\u0439 \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0435
    \u0432 \u0441\u043f\u0430\u043b\u044c\u043d\u043e\u043c \u0440\u0430\u0439\u043e\u043d\u0435
    \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0430
    \u2014 \u041a\u0443\u043f\u0447\u0438\u043d\u043e. \u041f\u0438\u0442\u0430\u043d\u0438\u0435
    \u0438 \u043f\u043e\u043a\u0443\u043f\u043a\u0438: \u041e\u043d \u043f\u043e\u043a\u0443\u043f\u0430\u0435\u0442
    \u0441\u0430\u043c\u044b\u0435 \u0434\u0435\u0448\u0435\u0432\u044b\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b:
    \u0432\u0435\u0440\u043c\u0438\u0448\u0435\u043b\u044c, \u0442\u0432\u043e\u0440\u043e\u0433,
    \u044f\u0431\u043b\u043e\u043a\u0438, \u043a\u0440\u0443\u043f\u044b \u0438 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u044b.
    \u041e\u0434\u0435\u0436\u0434\u0430: \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u043e\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u0440\u0430\u0439\u043d\u0435
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e \u0438 \u043d\u0435 \u0441\u043b\u0435\u0434\u0438\u0442
    \u0437\u0430 \u0441\u0435\u0437\u043e\u043d\u0430\u043c\u0438. \u0421\u043e\u043e\u0431\u0449\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0434\u043e\u043d\u0430\u0448\u0438\u0432\u0430\u0435\u0442
    \u043e\u0434\u0435\u0436\u0434\u0443 \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0433\u043e
    \u043e\u0442\u0446\u0430, \u0430 \u0435\u0433\u043e \u0432\u0438\u0437\u0438\u0442\u043d\u0430\u044f
    \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u2014 \u0440\u0435\u0437\u0438\u043d\u043e\u0432\u044b\u0435
    \u0433\u0430\u043b\u043e\u0448\u0438 \u0438 \u043f\u043e\u0442\u0435\u0440\u0442\u044b\u0435
    \u0431\u0440\u044e\u043a\u0438. \u041e\u0431\u0449\u0435\u043d\u0438\u0435: \u041e\u043d
    \u0441\u0442\u043e\u0440\u043e\u043d\u0438\u0442\u0441\u044f \u043b\u044e\u0434\u0435\u0439,
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u044f\u0441\u044c \u043b\u0438\u0448\u044c
    \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u043c\u0438 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f\u043c\u0438
    \u0441 \u0441\u043e\u0441\u0435\u0434\u044f\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0437\u043d\u0430\u044e\u0442 \u0435\u0433\u043e \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430.
    \u0412 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430\u0445 \u0438 \u043d\u0430 \u0443\u043b\u0438\u0446\u0435
    \u043e\u043d \u043f\u0440\u043e\u0441\u0438\u0442 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u043e\u0432
    \u0438 \u043d\u0430\u0437\u043e\u0439\u043b\u0438\u0432\u044b\u0445 \u043f\u0440\u043e\u0445\u043e\u0436\u0438\u0445
    \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0435\u0433\u043e \u0432 \u043f\u043e\u043a\u043e\u0435.
    \u0421\u043b\u0443\u0445\u0438 \u0438 \u0438\u0445 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0436\u0435\u043d\u0438\u0435
    \u0417\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430
    \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0441\u043b\u0443\u0445\u043e\u0432. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0432 \u0441\u043e\u0446\u0441\u0435\u0442\u044f\u0445 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u043b\u0430\u0441\u044c
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0442\u043e\u043c,
    \u0447\u0442\u043e \u043e\u043d \u00ab\u043f\u043e\u0433\u0438\u0431\u0430\u0435\u0442 \u0432
    \u043d\u0438\u0449\u0435\u0442\u0435\u00bb. \u0417\u043d\u0430\u043a\u043e\u043c\u044b\u0435
    \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u0438,
    \u043e\u0434\u043d\u0430\u043a\u043e, \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u0430\u044e\u0442
    \u044d\u0442\u043e, \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u0435\u043b
    \u0442\u0430\u043a\u043e\u0439 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438,
    \u0430 \u0435\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043d\u0435 \u0441\u0442\u043e\u043b\u044c \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0438\u0447\u043d\u043e,
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u043b \u0434\u0435\u043d\u044c\u0433\u0438
    \u0437\u0430 \u043b\u0435\u043a\u0446\u0438\u0438. \u0422\u0430\u043a\u0436\u0435 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b
    \u0441\u043b\u0443\u0445\u0438 \u043e \u0435\u0433\u043e \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0435
    \u0432 \u0428\u0432\u0435\u0446\u0438\u044e."
  personalLifeEn: 
  shortBioRu: "\u0413\u0440\u0438\u0433\u043e\u0440\u0438\u0439 \u042f\u043a\u043e\u0432\u043b\u0435\u0432\u0438\u0447
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d \u2014 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0434\u043e\u043a\u0430\u0437\u0430\u0432\u0448\u0438\u0439
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435,
    \u043e\u0434\u043d\u0443 \u0438\u0437 \u0441\u0435\u043c\u0438 \u00ab\u0437\u0430\u0434\u0430\u0447
    \u0442\u044b\u0441\u044f\u0447\u0435\u043b\u0435\u0442\u0438\u044f\u00bb. \u041e\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u043e\u0438\u043c \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0432\u043a\u043b\u0430\u0434\u043e\u043c \u0432 \u043d\u0430\u0443\u043a\u0443, \u043d\u043e
    \u0438 \u043a\u0440\u0430\u0439\u043d\u0435 \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u043d\u044b\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0436\u0438\u0437\u043d\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043e\u0442\u043a\u0430\u0437\u043e\u043c \u043e\u0442 \u0432\u0441\u0435\u0445 \u043a\u0440\u0443\u043f\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043c\u0438\u0439
    \u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u0435\u043d\u0435\u0436\u043d\u044b\u0445
    \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0439. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0432\u0435\u0445\u0438 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 - \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u044e\u043d\u043e\u0441\u0442\u044c: \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u0439
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    13 \u0438\u044e\u043d\u044f 1966 \u0433\u043e\u0434\u0430 \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435
    \u0432 \u0438\u043d\u0442\u0435\u043b\u043b\u0438\u0433\u0435\u043d\u0442\u043d\u043e\u0439
    \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c-\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u043a\u043e\u043c,
    \u043c\u0430\u0442\u044c \u2014 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0421 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442 \u043c\u0430\u0442\u044c
    \u043f\u0440\u0438\u0432\u0438\u043b\u0430 \u0435\u043c\u0443 \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0443\u0437\u044b\u043a\u0435,
    \u0430 \u043e\u0442\u0435\u0446 \u043f\u043e\u043e\u0449\u0440\u044f\u043b \u0437\u0430\u043d\u044f\u0442\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0438 \u0448\u0430\u0445\u043c\u0430\u0442\u0430\u043c\u0438.
    - \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435: \u0412 5-\u043c \u043a\u043b\u0430\u0441\u0441\u0435
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d \u043d\u0430\u0447\u0430\u043b \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0446\u0435\u043d\u0442\u0440\u0435 \u043f\u0440\u0438 \u0414\u0432\u043e\u0440\u0446\u0435
    \u043f\u0438\u043e\u043d\u0435\u0440\u043e\u0432. \u041f\u043e\u0441\u043b\u0435 8-\u0433\u043e
    \u043a\u043b\u0430\u0441\u0441\u0430 \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u2116 239. \u0412 1982 \u0433\u043e\u0434\u0443 \u0432 \u0441\u043e\u0441\u0442\u0430\u0432\u0435
    \u0441\u0431\u043e\u0440\u043d\u043e\u0439 \u0421\u0421\u0421\u0420 \u043e\u043d \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043b
    \u0437\u043e\u043b\u043e\u0442\u0443\u044e \u043c\u0435\u0434\u0430\u043b\u044c \u043d\u0430
    \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0435 \u0432 \u0411\u0443\u0434\u0430\u043f\u0435\u0448\u0442\u0435,
    \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439
    \u0431\u0430\u043b\u043b \u0437\u0430 \u0431\u0435\u0437\u0443\u043a\u043e\u0440\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0445 \u0437\u0430\u0434\u0430\u0447.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0443\u044e
    \u0443\u0447\u0435\u0431\u0443, \u0448\u043a\u043e\u043b\u0443 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0431\u0435\u0437 \u0437\u043e\u043b\u043e\u0442\u043e\u0439
    \u043c\u0435\u0434\u0430\u043b\u0438 \u0438\u0437-\u0437\u0430 \u043d\u0435\u0441\u0434\u0430\u043d\u043d\u044b\u0445
    \u043d\u043e\u0440\u043c\u0430\u0442\u0438\u0432\u043e\u0432 \u0413\u0422\u041e \u043f\u043e
    \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0435. - \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b:
    \u0412 1982 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u0437\u0430\u0447\u0438\u0441\u043b\u0435\u043d
    \u0431\u0435\u0437 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u043e\u0432 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e-\u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u041b\u0413\u0423, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0441 \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c.
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443 \u043f\u0440\u0438
    \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u043c \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0438\u043c. \u0412. \u0410. \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430
    (\u041f\u041e\u041c\u0418). \u0412 1990 \u0433\u043e\u0434\u0443 \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430 \u0410.\u0414. \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u0430
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e, \u043f\u043e\u0441\u043b\u0435
    \u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0440\u0430\u0431\u043e\u0442\u0443
    \u0432 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430. \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 - \u0420\u0430\u0431\u043e\u0442\u0430
    \u0432 \u0421\u0428\u0410: \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1990-\u0445 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445 \u0421\u0428\u0410:
    \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0441\u043a\u043e\u043c, \u0421\u0442\u043e\u043d\u0438-\u0411\u0440\u0443\u043a
    \u0438 \u0411\u0435\u0440\u043a\u043b\u0438. \u0412 1994 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0443\u044e
    \u00ab\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u043e \u0434\u0443\u0448\u0435\u00bb
    \u0432 \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c
    \u0432\u0430\u0436\u043d\u044b\u043c \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0420\u0438\u0447\u0430\u0440\u0434\u043e\u043c
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u043e\u043c, \u0447\u044c\u0438 \u0438\u0434\u0435\u0438
    \u043e \u043f\u043e\u0442\u043e\u043a\u0435 \u0420\u0438\u0447\u0447\u0438 \u043b\u0435\u0433\u043b\u0438
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0435\u0433\u043e \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u043f\u0440\u043e\u0440\u044b\u0432\u0430. \u0412 1995 \u0433\u043e\u0434\u0443 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433.
    - \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435: \u0421 \u043d\u043e\u044f\u0431\u0440\u044f
    2002 \u043f\u043e \u0438\u044e\u043b\u044c 2003 \u0433\u043e\u0434\u0430 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0442\u0440\u0438 \u0441\u0442\u0430\u0442\u044c\u0438
    \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 arXiv.org, \u0433\u0434\u0435 \u0432 \u0441\u0436\u0430\u0442\u043e\u0439
    \u0444\u043e\u0440\u043c\u0435 \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435.
    \u042d\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430, \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0432 1904 \u0433\u043e\u0434\u0443,
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438. \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0440\u0430\u0437\u0432\u0438\u043b \u043c\u0435\u0442\u043e\u0434 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    (\u0442\u0435\u043e\u0440\u0438\u044f \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430\u2014\u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430),
    \u0447\u0442\u043e\u0431\u044b \u0440\u0435\u0448\u0438\u0442\u044c \u044d\u0442\u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443.
    \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0431\u044b\u043b\u043e
    \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438
    \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0438 \u043a 2006 \u0433\u043e\u0434\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043e
    \u0432\u0435\u0440\u043d\u044b\u043c. - \u0423\u0445\u043e\u0434 \u0438\u0437 \u043d\u0430\u0443\u043a\u0438:
    \u0412 \u0434\u0435\u043a\u0430\u0431\u0440\u0435 2005 \u0433\u043e\u0434\u0430, \u043f\u043e\u0441\u043b\u0435
    \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c, \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0443\u0432\u043e\u043b\u0438\u043b\u0441\u044f \u0438\u0437 \u041f\u041e\u041c\u0418 \u0438
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u043b \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438, \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0432
    \u044d\u0442\u043e \u043d\u0435\u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435\u043c \u0441
    \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043d\u043e\u0440\u043c\u0430\u043c\u0438
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435. \u041e\u0442\u043a\u0430\u0437\u044b
    \u043e\u0442 \u043f\u0440\u0435\u043c\u0438\u0439 - \u041f\u0440\u0435\u043c\u0438\u044f
    \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (1996): \u041e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u043d\u0435\u0451. - \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (2006): \u042d\u0442\u043e \u0432\u044b\u0441\u0448\u0430\u044f
    \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0443
    \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b\u0438 \u0437\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435.
    \u041e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0435\u0451 \u043f\u0440\u0438\u043d\u044f\u0442\u044c,
    \u0438 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u044e\u0437\u0430 \u043b\u0438\u0447\u043d\u043e \u043f\u0440\u0438\u0435\u0437\u0436\u0430\u043b
    \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, \u0447\u0442\u043e\u0431\u044b
    \u0443\u0431\u0435\u0434\u0438\u0442\u044c \u0435\u0433\u043e, \u043d\u043e \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e.
    - \u041f\u0440\u0435\u043c\u0438\u044f \u0442\u044b\u0441\u044f\u0447\u0435\u043b\u0435\u0442\u0438\u044f
    (2010): \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u041a\u043b\u044d\u044f \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0443 \u043f\u0440\u0435\u043c\u0438\u044e
    \u0432 1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432
    \u0437\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435.
    \u0412 \u0438\u044e\u043b\u0435 2010 \u0433\u043e\u0434\u0430 \u043e\u043d \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442 \u043d\u0430\u0433\u0440\u0430\u0434\u044b.
    \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b \u043d\u0435\u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435
    \u0441 \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0441\u0447\u0438\u0442\u0430\u044f,
    \u0447\u0442\u043e \u0432\u043a\u043b\u0430\u0434 \u0420\u0438\u0447\u0430\u0440\u0434\u0430
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430 \u0431\u044b\u043b \u043d\u0435
    \u043c\u0435\u043d\u044c\u0448\u0438\u043c, \u0447\u0435\u043c \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439.
    \u041d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u041f\u043e\u0441\u043b\u0435
    \u0443\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u044f \u0438\u0437 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u0439 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0432\u0435\u0434\u0435\u0442 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0439, \u043f\u043e\u0447\u0442\u0438
    \u0437\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043d\u0438. \u041e\u043d \u0436\u0438\u0432\u0435\u0442 \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e
    \u0432 \u043e\u0431\u044b\u0447\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u044c\u043d\u043e\u0439
    \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u0432 \u043f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u043c
    \u0440\u0430\u0439\u043e\u043d\u0435 \u041a\u0443\u043f\u0447\u0438\u043d\u043e. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438\u0437\u0431\u0435\u0433\u0430\u0435\u0442 \u043e\u0431\u0449\u0435\u043d\u0438\u044f
    \u0441 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0430\u043c\u0438 \u0438 \u0441\u043e\u0441\u0435\u0434\u044f\u043c\u0438,
    \u0432\u0435\u0434\u0435\u0442 \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u043d\u044b\u0439
    \u0431\u044b\u0442. \u041f\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e
    \u043d\u0430 2011 \u0433\u043e\u0434, \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u0442\u044c
    \u0447\u043b\u0435\u043d\u043e\u043c \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a."
  shortBioEn: 
  interestingFactsRu: "\u041f\u043e\u043c\u0438\u043c\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u043c\u0430, \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u0439 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0438\u043c \u043a\u0440\u0430\u0439\u043d\u0435
    \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c,
    \u0430\u0441\u043a\u0435\u0442\u0438\u0437\u043c\u043e\u043c \u0438 \u043f\u043e\u043b\u043d\u044b\u043c
    \u0440\u0430\u0432\u043d\u043e\u0434\u0443\u0448\u0438\u0435\u043c \u043a \u043c\u0438\u0440\u0441\u043a\u043e\u0439
    \u0441\u043b\u0430\u0432\u0435. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u043f\u043e\u043b\u043d\u0430
    \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u043e\u0432 \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u043a\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a\u0438\u043c \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u0433\u0435\u043d\u0438\u0439.\n\n\U0001F4DA \u041d\u0435\u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0445 \u0437\u0430\u0441\u043b\u0443\u0433: \"\u041f\u0440\u043e\u0432\u0430\u043b\"
    \u043d\u0430 \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0435 \u041f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430 \u2014 \u044d\u0442\u043e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u043c\u0435\u0434\u0430\u043b\u0438. \u041e\u043d
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u2116239 \u0441 \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u043c\u0438
    \u043e\u0446\u0435\u043d\u043a\u0430\u043c\u0438 \u043f\u043e \u0432\u0441\u0435\u043c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c,
    \u043d\u043e \u0442\u0430\u043a \u0438 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0437\u0430\u0432\u0435\u0442\u043d\u0443\u044e \u043c\u0435\u0434\u0430\u043b\u044c. \u041f\u0440\u0438\u0447\u0438\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0434\u0430\u043b\u0435\u043a\u0430 \u043e\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438:
    \u043e\u043d \u043d\u0435 \u0441\u043c\u043e\u0433 \u0441\u0434\u0430\u0442\u044c \u043d\u043e\u0440\u043c\u0430\u0442\u0438\u0432\u044b
    \u043f\u043e \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0435. \u0414\u043b\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0437\u0436\u0435 \u043e\u0442\u043a\u0430\u0436\u0435\u0442\u0441\u044f \u043e\u0442
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0432 1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d
    \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432, \u044d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043f\u0435\u0440\u0432\u044b\u043c, \u043d\u043e \u043d\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c
    \u043e\u0442\u043a\u0430\u0437\u043e\u043c \u043e\u0442 \"\u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445\"
    \u043d\u0430\u0433\u0440\u0430\u0434.\n\n\U0001F3BB \u0420\u0430\u0437\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044f\u044f
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0425\u043e\u0442\u044f \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d \u0438 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u043a\u0430\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
    \u0438 \u044e\u043d\u043e\u0441\u0442\u0438 \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0431\u044b\u043b\u0438 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0448\u0438\u0440\u0435.
    \u041e\u043d \u0445\u043e\u0440\u043e\u0448\u043e \u0438\u0433\u0440\u0430\u043b \u0432
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u043d\u043d\u0438\u0441,
    \u0430 \u0435\u0433\u043e \u043c\u0430\u0442\u044c, \u0438\u0433\u0440\u0430\u0432\u0448\u0430\u044f
    \u043d\u0430 \u0441\u043a\u0440\u0438\u043f\u043a\u0435, \u043f\u0440\u0438\u0432\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0443\u0437\u044b\u043a\u0435. \u041f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c, \u043e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043a \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0438, \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0438 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c\u0443 \u044f\u0437\u044b\u043a\u0443,
    \u043f\u043e\u043f\u0440\u0430\u0432\u043b\u044f\u044f \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439
    \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0434\u0435\u043b\u0438\u043a\u0430\u0442\u043d\u043e\u0441\u0442\u044c\u044e.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e, \u0432\u043e\u043f\u0440\u0435\u043a\u0438
    \u0447\u0430\u0441\u0442\u043e\u043c\u0443 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u044e,
    \u0435\u0433\u043e \u043e\u0442\u0446\u043e\u043c \u0431\u044b\u043b \u043d\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0442\u043e\u0440 \u043d\u0430\u0443\u043a\u0438
    \u042f\u043a\u043e\u0432 \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d, \u0430
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440-\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u043a
    \u042f\u043a\u043e\u0432 \u041d\u0430\u0443\u043c\u043e\u0432\u0438\u0447.\n\n\U0001F35E
    \u0410\u0441\u043a\u0435\u0442\u0438\u0437\u043c \u0432 \u0431\u044b\u0442\u0443 \u0438
    \"\u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\"
    \u043d\u0430\u0443\u043a\u0438 \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1990-\u0445,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u0432 \u0421\u0428\u0410, \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u043f\u043e\u0440\u0430\u0436\u0430\u043b \u043a\u043e\u043b\u043b\u0435\u0433 \u0441\u0432\u043e\u0438\u043c
    \u0430\u0441\u043a\u0435\u0442\u0438\u0437\u043c\u043e\u043c. \u0412 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u0430\u043a \u043c\u043d\u043e\u0433\u0438\u0435 \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u043b\u0438\u0441\u044c
    \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u043c \"\u043e\u0431\u0440\u0430\u0437\u043e\u043c
    \u0436\u0438\u0437\u043d\u0438\", \u0435\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u043e\u0439
    \u0435\u0434\u043e\u0439 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c \u0441\u0430\u043c\u044b\u0435
    \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b:
    \u043c\u043e\u043b\u043e\u043a\u043e, \u0445\u043b\u0435\u0431 \u0438 \u0441\u044b\u0440.
    \u041e\u043d \u0445\u043e\u0434\u0438\u043b \u0432 \u043e\u0434\u043d\u043e\u043c \u0438
    \u0442\u043e\u043c \u0436\u0435 \u0432\u0435\u043b\u044c\u0432\u0435\u0442\u043e\u0432\u043e\u043c
    \u043f\u0438\u0434\u0436\u0430\u043a\u0435 \u0438 \u0442\u0440\u0430\u0442\u0438\u043b \u0432\u0441\u0435
    \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438
    \u043d\u0435 \u043d\u0430 \u0431\u043b\u0430\u0433\u0430, \u0430 \u043d\u0430 \u0441\u0432\u043e\u0438
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f. \u0421\u0430\u043c
    \u0444\u0430\u043a\u0442, \u0447\u0442\u043e \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435, \u043d\u0435 \u0438\u043c\u0435\u044f
    \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u0435\u043d. \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u0436\u0438\u043b \u043d\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f, \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u043d\u044b\u0435
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u0440\u0443\u0431\u0435\u0436\u043d\u044b\u0445
    \u0441\u0442\u0430\u0436\u0438\u0440\u043e\u0432\u043e\u043a. \u041f\u043e\u0437\u0436\u0435,
    \u0432 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0432\u043e\u0438\u0445 \u0441\u0442\u0430\u0442\u0435\u0439,
    \u043e\u043d \u0441 \u044e\u043c\u043e\u0440\u043e\u043c \u043e\u0442\u043c\u0435\u0442\u0438\u043b
    \u0432 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044f\u0445,
    \u0447\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \"\u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e
    \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043b\u0430\u0441\u044c\"
    \u0437\u0430 \u0441\u0447\u0435\u0442 \u043b\u0438\u0447\u043d\u044b\u0445 \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0439,
    \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u043b\u0435\u043d\u043d\u044b\u0445 \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0435\u0437\u0434\u043e\u043a \u0432 \u0421\u0428\u0410.\n\n\U0001F4DC
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u043a\u0430\u0437
    \u043e\u0442 \"\u0431\u0443\u043c\u0430\u0436\u0435\u043a\" \u0438 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e
    \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0441 \u043e\u0442\u043a\u0430\u0437\u043e\u043c
    \u043e\u0442 \u0440\u0435\u0437\u044e\u043c\u0435 \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c
    \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u041a\u043e\u0433\u0434\u0430 \u0432 \u0421\u0442\u044d\u043d\u0444\u043e\u0440\u0434\u0441\u043a\u043e\u043c
    \u0438\u043b\u0438 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0443 \u043d\u0435\u0433\u043e \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b\u0438 \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043f\u0438\u0441\u044c\u043c\u0430, \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u0444\u0440\u0430\u0437\u043e\u0439:
    \"\u0415\u0441\u043b\u0438 \u043e\u043d\u0438 \u0437\u043d\u0430\u044e\u0442 \u043c\u043e\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b, \u0438\u043c \u043d\u0435 \u043d\u0443\u0436\u043d\u043e
    \u043c\u043e\u0435 C.V. \u0415\u0441\u043b\u0438 \u0438\u043c \u043d\u0443\u0436\u043d\u043e
    \u043c\u043e\u0435 C.V., \u0437\u043d\u0430\u0447\u0438\u0442, \u043e\u043d\u0438 \u043d\u0435
    \u0437\u043d\u0430\u044e\u0442 \u043c\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\".
    \u0412 \u0438\u0442\u043e\u0433\u0435 \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0432\u0441\u0435\u0445 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0443\u0435\u0445\u0430\u043b \u0432 \u0420\u043e\u0441\u0441\u0438\u044e. \u0422\u0430\u043a\u0436\u0435
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0430
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0441 \u0435\u0433\u043e \"\u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e\".
    \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u044b
    \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u044f
    \u0432 \u043f\u043e\u0434\u043b\u0438\u043d\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u0445
    \u0440\u0435\u0434\u043a\u0438\u0445 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0435\u043c\u0443 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438, \u043d\u0430\u0445\u043e\u0434\u044f
    \u0432 \u043d\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0448\u0438\u0431\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b
    \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c. \u0421\u0430\u043c \u043e\u043d
    \u044d\u0442\u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043b.\n\n\U0001F300
    \u0411\u043e\u0440\u044c\u0431\u0430 \u0437\u0430 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442
    \u0438 \"\u0438\u0433\u043d\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\"
    \u043a\u043e\u043b\u043b\u0435\u0433 \u0412\u044b\u043b\u043e\u0436\u0438\u0432 \u0432 2002
    \u0433\u043e\u0434\u0443 \u0441\u0432\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0432 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442, \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b\u0441\u044f \u043b\u0438\u0448\u044c
    \u043e\u0431\u0449\u0435\u0439 \u0441\u0445\u0435\u043c\u043e\u0439, \u043d\u0435 \u0440\u0430\u0437\u0436\u0435\u0432\u044b\u0432\u0430\u044f
    \u0435\u0435 \u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u044c\u043d\u043e. \u041a\u043e\u0433\u0434\u0430
    \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432\u043e \u0433\u043b\u0430\u0432\u0435 \u0441 \u042f\u0443 \u0428\u0438\u043d\u0442\u0443\u043d\u043e\u043c
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0438 \u0431\u043e\u043b\u0435\u0435
    \u043e\u0431\u044a\u0435\u043c\u043d\u0443\u044e \u0438 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0443\u044e
    \u0441\u0442\u0430\u0442\u044c\u044e, \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \"\u0440\u0430\u0437\u0436\u0435\u0432\u0430\u0432\" \u0435\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0438 \u043d\u0435 \u0443\u043f\u043e\u043c\u044f\u043d\u0443\u0432 \u0434\u043e\u043b\u0436\u043d\u044b\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u0430, \u043e\u043d \u043f\u0440\u043e\u043c\u043e\u043b\u0447\u0430\u043b.
    \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u043e\u0432
    \u043e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e\u0441\u0442\u0438
    \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u0441 \u0433\u043e\u0440\u0435\u0447\u044c\u044e,
    \u0447\u0442\u043e \u0432 \u043d\u0430\u0443\u043a\u0435 \u0447\u0443\u0436\u0430\u043a\u0430\u043c\u0438
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043d\u0435 \u043d\u0430\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u0435\u0439
    \u044d\u0442\u0438\u043a\u0438, \u0430 \u0442\u0430\u043a\u0438\u0445, \u043a\u0430\u043a
    \u043e\u043d.\n\n\U0001F3AC \"\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439\" \u0438 \u043c\u0438\u043b\u043b\u0438\u043e\u043d
    \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0435\u0433\u043e \u0444\u0440\u0430\u0437\u0430, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f
    \u0441 \u043e\u0442\u043a\u0430\u0437\u043e\u043c \u043e\u0442 \u043f\u0440\u0435\u043c\u0438\u0438,
    \u2014 \u043e\u043d \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0437\u043d\u0430\u0435\u0442,
    \u043a\u0430\u043a \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439,
    \u0438 \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \"\u043d\u0435 \u0432\u0438\u0434\u0438\u0442
    \u0441\u043c\u044b\u0441\u043b\u0430 \u0431\u0435\u0436\u0430\u0442\u044c \u0437\u0430 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u043c\".
    \u0415\u0433\u043e \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430
    \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u041a\u043b\u044d\u044f \u0431\u044b\u043b
    \u043c\u043e\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0435\u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435\u043c \u0441 \"\u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u044b\u043c\"
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
    \u043d\u043e \u0438 \u0442\u0435\u043c, \u0447\u0442\u043e, \u043f\u043e \u0435\u0433\u043e
    \u043c\u043d\u0435\u043d\u0438\u044e, \u0432\u043a\u043b\u0430\u0434 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0420\u0438\u0447\u0430\u0440\u0434\u0430
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430 \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u043d\u0435 \u043c\u0435\u043d\u044c\u0448\u0435 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e.\n\n\u2728
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0438 \u043c\u0435\u0441\u0442\u043e
    \u0432 \u043f\u0430\u043d\u0442\u0435\u043e\u043d\u0435 \u0433\u0435\u043d\u0438\u0435\u0432
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0437\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e,
    \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u0437\u043d\u0430\u043d
    \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435.
    \u0412 2006 \u0433\u043e\u0434\u0443 \u0436\u0443\u0440\u043d\u0430\u043b Science \u043d\u0430\u0437\u0432\u0430\u043b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u043c
    \u0433\u043e\u0434\u0430, \u0430 \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0430\u044f
    \u0433\u0430\u0437\u0435\u0442\u0430 The Daily Telegraph \u0432\u043a\u043b\u044e\u0447\u0438\u043b\u0430
    \u0435\u0433\u043e \u0432 \u0441\u043f\u0438\u0441\u043e\u043a 100 \u043d\u044b\u043d\u0435
    \u0436\u0438\u0432\u0443\u0449\u0438\u0445 \u0433\u0435\u043d\u0438\u0435\u0432, \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u043d\u0430 9-\u0435 \u043c\u0435\u0441\u0442\u043e (\u0432\u044b\u0448\u0435 \u0413\u0430\u0440\u0440\u0438
    \u041a\u0430\u0441\u043f\u0430\u0440\u043e\u0432\u0430 \u0438 \u041c\u0438\u0445\u0430\u0438\u043b\u0430
    \u041a\u0430\u043b\u0430\u0448\u043d\u0438\u043a\u043e\u0432\u0430). \u041e\u043d \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u0435\u043c
    \u0420\u043e\u0441\u0441\u0438\u0438 \u0432 \u044d\u0442\u043e\u043c \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0435.\n\n\U0001F370
    \u041d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435 \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u0438
    \u0423 \u0433\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0438\u0442\u0430\u043b\u0441\u044f
    \u0445\u043b\u0435\u0431\u043e\u043c \u0438 \u0441\u044b\u0440\u043e\u043c, \u0432\u0441\u0451
    \u0436\u0435 \u0431\u044b\u043b\u0430 \u043e\u0434\u043d\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u2014 \u043e\u043d \u043e\u0447\u0435\u043d\u044c
    \u043b\u044e\u0431\u0438\u043b \u043f\u0438\u0440\u043e\u0436\u043d\u044b\u0435-\u043a\u043e\u0440\u0437\u0438\u043d\u043e\u0447\u043a\u0438
    \u0441 \u043a\u0440\u0435\u043c\u043e\u043c. \u042d\u0442\u043e\u0442 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439
    \u0448\u0442\u0440\u0438\u0445 \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437
    \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u043d\u044b\u043c
    \u0438 \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u0435\u0449\u0435 \u0431\u043e\u043b\u0435\u0435
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043d\u044b\u043c \u0441 \u0435\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0430\u0441\u043a\u0435\u0442\u0430-\u0437\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u043a\u0430."
