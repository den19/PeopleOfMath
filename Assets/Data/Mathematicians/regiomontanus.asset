  achievementsRu: "\u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043f\u0440\u043e\u0440\u044b\u0432
    \u0432 \u043d\u0430\u0443\u043a\u0435, \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u043d\u0430 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f
    \u0432\u043f\u0435\u0440\u0435\u0434. \u0415\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439.\n\n\U0001F4D0 \u00ab\u041e \u0432\u0441\u0435\u0445
    \u0432\u0438\u0434\u0430\u0445 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432\u00bb
    (De triangulis omnimodis, 1464) \u042d\u0442\u043e\u0442 \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u2014 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0440\u0443\u0434 \u0438, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u0441\u0430\u043c\u044b\u0439 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443. \u041a\u043d\u0438\u0433\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u043e\u0439
    \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u043a\u0430\u043a \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b \u0432 \u0415\u0432\u0440\u043e\u043f\u0435.
    \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0442\u0440\u0443\u0434\u0430: \u041a\u043d\u0438\u0433\u0430
    \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u043f\u044f\u0442\u0438 \u0447\u0430\u0441\u0442\u0435\u0439.
    \u041f\u0435\u0440\u0432\u044b\u0435 \u0434\u0432\u0435 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u044b
    \u043f\u043b\u043e\u0441\u043a\u043e\u0439 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0430 \u0442\u0440\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u2014
    \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432. \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0438\u043d\u043d\u043e\u0432\u0430\u0446\u0438\u0438: \u0412 \u044d\u0442\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u0434\u043b\u044f \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432
    \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u043a\u043d\u0438\u0433\u0435, \u0430
    \u0432 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0435
    \u2014 \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u0434\u043b\u044f \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432.
    \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u0432 \u043f\u044f\u0442\u043e\u0439
    \u043a\u043d\u0438\u0433\u0435 \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u0434\u043b\u044f \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432.
    \u042d\u0442\u043e \u0431\u044b\u043b \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0448\u0430\u0433
    \u0432\u043f\u0435\u0440\u0435\u0434 \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e
    \u0441 \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u043c\u0438 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u043c\u0438.
    \u0420\u043e\u043b\u044c \u0430\u043b\u0433\u0435\u0431\u0440\u044b: \u0412 \u0441\u0432\u043e\u0438\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u0445 \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b,
    \u043d\u0430\u0437\u044b\u0432\u0430\u044f \u044d\u0442\u043e \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    `ars rei et census` (\u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e \u0432\u0435\u0449\u0438
    \u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430). \u041e\u043d \u0440\u0435\u0448\u0430\u043b
    \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u043d\u0435\u0435
    \u043d\u0435 \u0431\u044b\u043b\u0438 \u043e\u043f\u0438\u0441\u0430\u043d\u044b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438,
    \u0441\u0432\u043e\u0434\u044f \u0438\u0445 \u043a \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c, \u0445\u043e\u0442\u044f \u0438
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b \u0432\u0441\u0435 \u044d\u0442\u043e
    \u0441\u043b\u043e\u0432\u0435\u0441\u043d\u043e, \u0431\u0435\u0437 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432.\n\n\U0001F30C
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f \u0438 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a, \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b,
    \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0438\u0435 \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u043d\u0438\u0435.
    \u00ab\u042d\u0444\u0435\u043c\u0435\u0440\u0438\u0434\u044b\u00bb (Ephemerides, 1474):
    \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043f\u0435\u0447\u0430\u0442\u043d\u044b\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0432\u0448\u0438\u0439
    \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442, \u0421\u043e\u043b\u043d\u0446\u0430 \u0438 \u041b\u0443\u043d\u044b
    \u043d\u0430 1475-1506 \u0433\u043e\u0434\u044b. \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439
    \u0434\u043b\u044f \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439.
    \u0425\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u0440 \u041a\u043e\u043b\u0443\u043c\u0431
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u044d\u0444\u0435\u043c\u0435\u0440\u0438\u0434\u044b
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u0432\u043e\u0438\u0445 \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0439.
    \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u0438\u043c\u0435\u043d\u043d\u043e
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0433\u043e
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d\u043e\u043c \u043b\u0443\u043d\u043d\u043e\u0433\u043e
    \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u044f \u043d\u0430 29 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1504 \u0433\u043e\u0434\u0430 \u041a\u043e\u043b\u0443\u043c\u0431 \u0441\u043c\u043e\u0433
    \u0437\u0430\u043f\u0443\u0433\u0430\u0442\u044c \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043d\u043e
    \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0445 \u0436\u0438\u0442\u0435\u043b\u0435\u0439
    \u042f\u043c\u0430\u0439\u043a\u0438 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043f\u0440\u043e\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435. \u00ab\u0422\u0430\u0431\u043b\u0438\u0446\u044b
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439\u00bb (Tabulae directionum,
    1467): \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b
    \u043d\u043e\u0432\u044b\u0435 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0441 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0434\u043b\u044f \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e.
    \u041e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0441\u0438\u043d\u0443\u0441\u044b
    \u0441 \u0440\u0430\u0434\u0438\u0443\u0441\u0430\u043c\u0438 \u0434\u043e 10 000 000 \u0438
    \u0432\u0432\u0435\u043b \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0442\u0430\u043d\u0433\u0435\u043d\u0441\u043e\u0432,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0445
    \u0442\u0435\u043b. \u041d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f: \u0412
    \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433\u0435 \u043e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0439
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0438 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434\u043e\u043c \u0412\u0430\u043b\u044c\u0442\u0435\u0440\u043e\u043c
    \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f, \u0432 \u0442\u043e\u043c
    \u0447\u0438\u0441\u043b\u0435 \u0437\u0430 \u043a\u043e\u043c\u0435\u0442\u043e\u0439 1472
    \u0433\u043e\u0434\u0430, \u0438 \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0443
    \u0441 \u0430\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0435\u0432\u0441\u043a\u0438\u043c
    \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u043c \u043d\u0430 \u043a\u043e\u043c\u0435\u0442\u044b
    \u043a\u0430\u043a \u043d\u0430 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u044b\u0435
    \u044f\u0432\u043b\u0435\u043d\u0438\u044f.\n\n\U0001F4D6 \u00ab\u042d\u043f\u0438\u0442\u043e\u043c\u0430
    \u201e\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0430\u201c\u00bb (Epytoma
    in almagesti Ptolemei, 1462) \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u0441\u0442\u0430\u043b
    \u0438\u0442\u043e\u0433\u043e\u043c \u0440\u0430\u0431\u043e\u0442\u044b, \u043d\u0430\u0447\u0430\u0442\u043e\u0439
    \u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0413\u0435\u043e\u0440\u0433\u043e\u043c
    \u041f\u0443\u0440\u0431\u0430\u0445\u043e\u043c, \u0438 \u0431\u044b\u043b \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d
    \u043f\u043e \u0437\u0430\u0434\u0430\u043d\u0438\u044e \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u0430
    \u0412\u0438\u0441\u0441\u0430\u0440\u0438\u043e\u043d\u0430. \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u043e\u0448\u0438\u0431\u043e\u043a: \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u0430\u043b
    \u0442\u0440\u0443\u0434 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f, \u043e\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u0435\u0433\u043e \u0441\u0436\u0430\u0442\u043e\u0435
    \u0438 \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435.
    \u041f\u0435\u0440\u0432\u0430\u044f \u043a\u0440\u0438\u0442\u0438\u043a\u0430: \u0412
    \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f
    \u043e\u0434\u043d\u0430 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435
    \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0446\u0435\u043d\u043e\u043a
    \u043c\u043e\u0434\u0435\u043b\u0438 \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0434\u0438\u0430\u043c\u0435\u0442\u0440
    \u041b\u0443\u043d\u044b \u0432 \u043f\u0435\u0440\u0432\u043e\u0439 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438
    \u0432\u0434\u0432\u043e\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u0439, \u0447\u0435\u043c
    \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u044b\u0439. \u041f\u043e\u0437\u0436\u0435
    \u044d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u043e\u043a\u0430\u0437\u0430\u043b \u0441\u0438\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u041d\u0438\u043a\u043e\u043b\u0430\u044f
    \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430.\n\n\U0001F5A8\ufe0f \u041f\u0438\u043e\u043d\u0435\u0440
    \u043a\u043d\u0438\u0433\u043e\u043f\u0435\u0447\u0430\u0442\u0430\u043d\u0438\u044f \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043e\u0441\u043e\u0437\u043d\u0430\u043b
    \u0441\u0438\u043b\u0443 \u043f\u0435\u0447\u0430\u0442\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u043d\u043a\u0430
    \u0434\u043b\u044f \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u043d\u0438\u044f. \u0412
    \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433\u0435 \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u044b\u0439
    \u0441\u043f\u0438\u0441\u043e\u043a \u043a\u043d\u0438\u0433 (`Haec opera`), \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b \u0438\u0437\u0434\u0430\u0442\u044c:
    \u043e\u0442 \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0438 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430
    \u0434\u043e \u0441\u0432\u043e\u0438\u0445 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432. \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u0435\u0433\u043e \u0440\u0430\u043d\u043d\u044f\u044f \u0441\u043c\u0435\u0440\u0442\u044c
    \u043f\u043e\u043c\u0435\u0448\u0430\u043b\u0430 \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044c
    \u0432\u0441\u0435 \u043f\u043b\u0430\u043d\u044b. \u041c\u043d\u043e\u0433\u0438\u0435
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0442\u0440\u0443\u0434 \u043f\u043e \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0431\u044b\u043b\u0438 \u0438\u0437\u0434\u0430\u043d\u044b \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e,
    \u0443\u0436\u0435 \u0432 XVI \u0432\u0435\u043a\u0435."
  achievementsEn: 
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439,
    \u043a\u0430\u043a \u043a\u043e\u043c\u0435\u0442\u0430, \u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435
    \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u043e\u0439. \u0420\u043e\u0434\u0438\u0432\u0448\u0438\u0441\u044c
    \u0441\u044b\u043d\u043e\u043c \u043c\u0435\u043b\u044c\u043d\u0438\u043a\u0430, \u043e\u043d
    \u0441\u0442\u0430\u043b \u00ab\u043a\u043e\u0440\u043e\u043b\u0435\u043c \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u0432\u00bb
    XV \u0432\u0435\u043a\u0430, \u043d\u043e \u0435\u0433\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439
    \u043f\u0443\u0442\u044c \u043e\u0431\u043e\u0440\u0432\u0430\u043b\u0441\u044f \u0442\u0430\u043a
    \u0436\u0435 \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e, \u043a\u0430\u043a \u0438
    \u043d\u0430\u0447\u0430\u043b\u0441\u044f.\n\n\U0001F4DC \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0418\u043c\u044f \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435:
    \u041e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f 6 \u0438\u044e\u043d\u044f 1436
    \u0433\u043e\u0434\u0430 \u0432 \u0431\u0430\u0432\u0430\u0440\u0441\u043a\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433 (K\u00f6nigsberg in Bayern),
    \u0447\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0433\u043e\u0440\u0430\u00bb. \u041d\u0435 \u043f\u0443\u0442\u0430\u0442\u044c \u0441
    \u043e\u0434\u043d\u043e\u0438\u043c\u0435\u043d\u043d\u044b\u043c \u0433\u043e\u0440\u043e\u0434\u043e\u043c
    \u0432 \u041f\u0440\u0443\u0441\u0441\u0438\u0438 (\u043d\u044b\u043d\u0435 \u041a\u0430\u043b\u0438\u043d\u0438\u043d\u0433\u0440\u0430\u0434).
    \u0415\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0438\u043c\u0435\u043d\u0435\u043c
    \u0431\u044b\u043b\u043e \u0418\u043e\u0433\u0430\u043d\u043d \u041c\u044e\u043b\u043b\u0435\u0440
    (Johannes M\u00fcller). \u0418\u043c\u044f \u00ab\u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d\u00bb
    \u2014 \u044d\u0442\u043e \u043b\u0430\u0442\u0438\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c (\u043e\u0442 Regiomontanus \u2014
    \u00ab\u0441 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u0433\u043e\u0440\u044b\u00bb),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u043e\u043d \u0441\u0430\u043c \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438; \u043e\u043d \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u043f\u043e\u0437\u0436\u0435, \u0432 1531 \u0433\u043e\u0434\u0443, \u0432 \u0442\u0440\u0443\u0434\u0430\u0445
    \u0424\u0438\u043b\u0438\u043f\u043f\u0430 \u041c\u0435\u043b\u0430\u043d\u0445\u0442\u043e\u043d\u0430.
    \u0421\u0435\u043c\u044c\u044f: \u041e\u043d \u0431\u044b\u043b \u0441\u044b\u043d\u043e\u043c
    \u043c\u0435\u043b\u044c\u043d\u0438\u043a\u0430 (M\u00fcller \u2014 \u043f\u043e-\u043d\u0435\u043c\u0435\u0446\u043a\u0438
    \u00ab\u043c\u0435\u043b\u044c\u043d\u0438\u043a\u00bb). \u0421\u0435\u043c\u044c\u044f,
    \u0441\u0443\u0434\u044f \u043f\u043e \u0432\u0441\u0435\u043c\u0443, \u0431\u044b\u043b\u0430
    \u0437\u0430\u0436\u0438\u0442\u043e\u0447\u043d\u043e\u0439: \u0435\u0433\u043e \u043e\u0442\u0435\u0446,
    \u0418\u043e\u0433\u0430\u043d\u043d \u041c\u044e\u043b\u043b\u0435\u0440-\u0441\u0442\u0430\u0440\u0448\u0438\u0439,
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u0447\u043b\u0435\u043d
    \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u0432\u0435\u0442\u0430
    \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0430, \u0430 \u0435\u0433\u043e
    \u0441\u0435\u0441\u0442\u0440\u0430 \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430 \u0432\u044b\u0448\u043b\u0430
    \u0437\u0430\u043c\u0443\u0436 \u0437\u0430 \u0431\u0443\u0440\u0433\u043e\u043c\u0438\u0441\u0442\u0440\u0430
    \u044d\u0442\u043e\u0433\u043e \u0436\u0435 \u0433\u043e\u0440\u043e\u0434\u0430.\n\n\U0001F393
    \u041e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0412\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434: \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u044b\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043e\u0447\u0435\u043d\u044c
    \u0440\u0430\u043d\u043e. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 11 \u043b\u0435\u0442
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430, \u0447\u0442\u043e \u0432 12 \u043b\u0435\u0442
    \u043e\u043d \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0440\u0443\u0447\u043d\u043e
    \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0431\u043e\u043b\u0435\u0435 \u0442\u043e\u0447\u043d\u044b\u0439
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043b\u044c\u043c\u0430\u043d\u0430\u0445, \u0447\u0435\u043c \u0442\u043e\u0442,
    \u0447\u0442\u043e \u043d\u0435\u0434\u0430\u0432\u043d\u043e \u043d\u0430\u043f\u0435\u0447\u0430\u0442\u0430\u043b
    \u0413\u0443\u0442\u0435\u043d\u0431\u0435\u0440\u0433. \u0412\u0435\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434: \u0412 1450 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    14 \u043b\u0435\u0442, \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u0432 \u0412\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438. \u0412 1452 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430,
    \u043d\u043e \u0438\u0437-\u0437\u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0445
    \u043f\u0440\u0430\u0432\u0438\u043b \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0436\u0434\u0430\u0442\u044c \u0434\u043e 21 \u0433\u043e\u0434\u0430, \u0447\u0442\u043e\u0431\u044b
    \u0432 1457 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432
    \u0438 \u043d\u0430\u0447\u0430\u0442\u044c \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438.\n\n\U0001F468\u200d\U0001F3EB
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u041d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u041f\u0443\u0440\u0431\u0430\u0445\u0430:
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0441 \u0413\u0435\u043e\u0440\u0433\u043e\u043c \u041f\u0443\u0440\u0431\u0430\u0445\u043e\u043c
    (Georg von Peuerbach), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0438 \u0434\u0440\u0443\u0433\u043e\u043c.
    \u041e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0432\u0435\u043b\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f,
    \u0434\u0435\u043b\u0430\u043b\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b
    \u0438 \u043c\u0435\u0447\u0442\u0430\u043b\u0438 \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c
    \u043d\u0435\u0442\u043e\u0447\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432. \u041a\u0430\u0440\u0434\u0438\u043d\u0430\u043b
    \u0412\u0438\u0441\u0441\u0430\u0440\u0438\u043e\u043d \u0438 \u043f\u043e\u0435\u0437\u0434\u043a\u0430
    \u0432 \u0418\u0442\u0430\u043b\u0438\u044e: \u0412 1460 \u0433\u043e\u0434\u0443 \u0432
    \u0412\u0435\u043d\u0443 \u043f\u0440\u0438\u0431\u044b\u043b \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b
    \u0412\u0438\u0441\u0441\u0430\u0440\u0438\u043e\u043d (Basilios Bessarion), \u0433\u0440\u0435\u043a
    \u043f\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044e
    \u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u044b\u0439 \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0435\u0440
    \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439.
    \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u041f\u0443\u0440\u0431\u0430\u0445\u0443
    \u043f\u043e\u0435\u0445\u0430\u0442\u044c \u0441 \u043d\u0438\u043c \u0432 \u0418\u0442\u0430\u043b\u0438\u044e,
    \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0439,
    \u0442\u043e\u0447\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0430\u00bb
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f. \u041f\u0443\u0440\u0431\u0430\u0445 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0441\u044f
    \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438, \u0447\u0442\u043e \u0432\u043e\u0437\u044c\u043c\u0435\u0442
    \u0441 \u0441\u043e\u0431\u043e\u0439 \u0443\u0447\u0435\u043d\u0438\u043a\u0430. \u041e\u0434\u043d\u0430\u043a\u043e
    \u041f\u0443\u0440\u0431\u0430\u0445 \u0443\u043c\u0435\u0440 \u0432 1461 \u0433\u043e\u0434\u0443,
    \u0438 \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0418\u0442\u0430\u043b\u0438\u044e \u043e\u0434\u0438\u043d, \u0432\u043e\u0439\u0434\u044f
    \u0432 \u0441\u0432\u0438\u0442\u0443 \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u0430.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u0438 \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0430:
    \u0412 \u0418\u0442\u0430\u043b\u0438\u0438 \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0432 \u0446\u0435\u043d\u0442\u0440\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0431\u0430\u0442\u0430\u043b\u0438\u0439. \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u043c
    \u0441\u0442\u0430\u043b \u0413\u0435\u043e\u0440\u0433\u0438\u0439 \u0422\u0440\u0430\u043f\u0435\u0437\u0443\u043d\u0434\u0441\u043a\u0438\u0439
    (George of Trebizond), \u0447\u0435\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0430\u00bb
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u0436\u0435\u0441\u0442\u043a\u043e
    \u0440\u0430\u0441\u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b. \u042d\u0442\u0430
    \u0432\u0440\u0430\u0436\u0434\u0430, \u043a\u0430\u043a \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442,
    \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u043e\u0438\u043b\u0430 \u0435\u043c\u0443 \u0436\u0438\u0437\u043d\u0438.
    \u0412 \u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u0437\u0430\u0432\u044f\u0437\u0430\u043b
    \u043f\u0440\u043e\u0447\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0441\u0432\u044f\u0437\u0438
    \u0441 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438,
    \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0414\u0436\u043e\u0432\u0430\u043d\u043d\u0438
    \u0411\u044c\u044f\u043d\u043a\u0438\u043d\u0438 (Giovanni Bianchini). \u0412\u0435\u043d\u0433\u0440\u0438\u044f:
    \u0421 1467 \u043f\u043e 1471 \u0433\u043e\u0434 \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435
    \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u044f
    \u041c\u0430\u0442\u0432\u0435\u044f \u041a\u043e\u0440\u0432\u0438\u043d\u0430, \u0433\u0434\u0435
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0435\u0439. \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433
    \u0438 \u0434\u0440\u0443\u0436\u0431\u0430 \u0441 \u0412\u0430\u043b\u044c\u0442\u0435\u0440\u043e\u043c:
    \u0412 1471 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433, \u0433\u0434\u0435 \u0435\u0433\u043e
    \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c \u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u0435\u043c
    \u0441\u0442\u0430\u043b \u0431\u043e\u0433\u0430\u0442\u044b\u0439 \u043a\u0443\u043f\u0435\u0446
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0412\u0430\u043b\u044c\u0442\u0435\u0440
    (Bernhard Walther). \u0412\u043c\u0435\u0441\u0442\u0435 \u043e\u043d\u0438 \u0441\u043e\u0437\u0434\u0430\u043b\u0438
    \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0439 \u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u043b\u0438
    \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u044e.\n\n\u2620\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u0412\u044b\u0437\u043e\u0432 \u0432 \u0420\u0438\u043c: \u0412 1475 \u0433\u043e\u0434\u0443
    \u043f\u0430\u043f\u0430 \u0421\u0438\u043a\u0441\u0442 IV \u043f\u0440\u0438\u0437\u0432\u0430\u043b
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d\u0430 \u0432 \u0420\u0438\u043c
    \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0434 \u0440\u0435\u0444\u043e\u0440\u043c\u043e\u0439
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f, \u043f\u043e\u043e\u0431\u0435\u0449\u0430\u0432
    \u0435\u043c\u0443 \u0441\u0430\u043d \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u0430 \u0420\u0435\u0433\u0435\u043d\u0441\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0433\u043e.
    \u0422\u0430\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043a\u043e\u043d\u0447\u0438\u043d\u0430:
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u043f\u0440\u0438\u0431\u044b\u043b
    \u0432 \u0420\u0438\u043c, \u043d\u043e \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432,
    6 \u0438\u044e\u043b\u044f 1476 \u0433\u043e\u0434\u0430, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    40 \u043b\u0435\u0442 \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f.
    \u041e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0438 \u0434\u0432\u0435
    \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0432\u0435\u0440\u0441\u0438\u0438: 1.
    \u0427\u0443\u043c\u0430: \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0430\u044f
    \u043f\u0440\u0438\u0447\u0438\u043d\u0430. \u0412 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u0432 \u0420\u0438\u043c\u0435 \u0441\u0432\u0438\u0440\u0435\u043f\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044f \u0447\u0443\u043c\u044b, \u0443\u0441\u0443\u0433\u0443\u0431\u043b\u0435\u043d\u043d\u0430\u044f
    \u0440\u0430\u0437\u043b\u0438\u0432\u043e\u043c \u0422\u0438\u0431\u0440\u0430. 2. \u041e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435:
    \u0423\u043f\u043e\u0440\u043d\u0430\u044f \u043b\u0435\u0433\u0435\u043d\u0434\u0430, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043e\u0442\u0440\u0430\u0432\u0438\u043b\u0438 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0438
    \u0413\u0435\u043e\u0440\u0433\u0438\u044f \u0422\u0440\u0430\u043f\u0435\u0437\u0443\u043d\u0434\u0441\u043a\u043e\u0433\u043e
    \u0438\u0437 \u043c\u0435\u0441\u0442\u0438 \u0437\u0430 \u0435\u0433\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u0443.
    \u042d\u0442\u0430 \u0432\u0435\u0440\u0441\u0438\u044f, \u0445\u043e\u0442\u044f \u0438
    \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u043d\u0430, \u043d\u0435 \u0438\u043c\u0435\u0435\u0442
    \u043f\u0440\u044f\u043c\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u0438 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c
    \u043b\u0438\u0448\u044c \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438.
    \u0415\u0441\u043b\u0438 \u0432\u0430\u0441 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u044e\u0442
    \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435
    \u0434\u0435\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0438\u043b\u0438
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0442\u0435\u043c \u0438\u043b\u0438
    \u0438\u043d\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c, \u044f \u0433\u043e\u0442\u043e\u0432
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u043e\u0431 \u044d\u0442\u043e\u043c
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435."
  personalLifeEn: 
  shortBioRu: "\u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d (\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435
    \u0438\u043c\u044f \u0418\u043e\u0433\u0430\u043d\u043d \u041c\u044e\u043b\u043b\u0435\u0440)
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043c\u043e\u0432 XV \u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u00ab\u043e\u0442\u0446\u043e\u043c \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb \u0438
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c, \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0432\u0448\u0438\u043c
    \u043f\u043e\u0447\u0432\u0443 \u0434\u043b\u044f \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430, \u043f\u043e\u043b\u043d\u0430\u044f \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0439,
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439
    \u0438 \u0438\u043d\u0442\u0440\u0438\u0433.\n\n\U0001F4DC \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    (1436\u20131461) \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435:
    \u041e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f 6 \u0438\u044e\u043d\u044f 1436
    \u0433\u043e\u0434\u0430 \u0432 \u0431\u0430\u0432\u0430\u0440\u0441\u043a\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433 (\u0447\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442
    \u00ab\u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u0433\u043e\u0440\u0430\u00bb,
    \u043e\u0442\u0441\u044e\u0434\u0430 \u0435\u0433\u043e \u043b\u0430\u0442\u0438\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u0438\u043c\u044f Regiomontanus) \u0432 \u0441\u0435\u043c\u044c\u0435 \u043c\u0435\u043b\u044c\u043d\u0438\u043a\u0430.
    \u0412\u043e\u043f\u0440\u0435\u043a\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u043c\u0443
    \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u044e, \u043e\u043d \u043d\u0435
    \u0438\u043c\u0435\u0435\u0442 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043a
    \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0443 \u0432 \u041f\u0440\u0443\u0441\u0441\u0438\u0438
    (\u043d\u044b\u043d\u0435 \u041a\u0430\u043b\u0438\u043d\u0438\u043d\u0433\u0440\u0430\u0434).
    \u0412\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434: \u041f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0443\u0436\u0435 \u0432 11 \u043b\u0435\u0442, \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u0432
    \u0432 \u041b\u0435\u0439\u043f\u0446\u0438\u0433\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    (1447\u20131450). \u0412 1450 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0412\u0435\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0442\u043e\u0433\u0434\u0430 \u0431\u044b\u043b \u0446\u0435\u043d\u0442\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u044b\u0441\u043b\u0438.
    \u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c:
    \u0412 \u0412\u0435\u043d\u0435 \u043e\u043d \u0441\u0442\u0430\u043b \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u0438 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u043c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c
    \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430
    \u0413\u0435\u043e\u0440\u0433\u0430 \u041f\u0443\u0440\u0431\u0430\u0445\u0430. \u042d\u0442\u0430
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438 \u0432\u0441\u044e \u0435\u0433\u043e
    \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0443\u044e \u0436\u0438\u0437\u043d\u044c.
    \u0412\u043c\u0435\u0441\u0442\u0435 \u043e\u043d\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b\u0438
    \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0435 \u0442\u0435\u043b\u0430, \u0438\u0437\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u043b\u0438
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0438 \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b\u0438
    \u043d\u0435\u0442\u043e\u0447\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432. \u041f\u0435\u0440\u0432\u044b\u0435
    \u0443\u0441\u043f\u0435\u0445\u0438: \u0412 1452 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430,
    \u0430 \u0432 1457 \u0433\u043e\u0434\u0443, \u043f\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0438
    21 \u0433\u043e\u0434\u0430, \u2014 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432 \u0438 \u0431\u044b\u043b \u0437\u0430\u0447\u0438\u0441\u043b\u0435\u043d
    \u0432 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439
    \u0441\u043e\u0441\u0442\u0430\u0432 \u0412\u0435\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.\n\n\U0001F1EE\U0001F1F9
    \u0418\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0438 \u0442\u0440\u0438\u0443\u043c\u0444 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    (1461\u20131467) \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b
    \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c \u0432 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0435.
    \u041c\u0438\u0441\u0441\u0438\u044f \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u0430:
    \u0412 1460 \u0433\u043e\u0434\u0443 \u0432 \u0412\u0435\u043d\u0443 \u043f\u0440\u0438\u0431\u044b\u043b
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b \u0412\u0438\u0441\u0441\u0430\u0440\u0438\u043e\u043d,
    \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c \u043d\u0430\u0443\u043a.
    \u041e\u043d \u043f\u043e\u0440\u0443\u0447\u0438\u043b \u041f\u0443\u0440\u0431\u0430\u0445\u0443
    \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0439, \u0431\u043e\u043b\u0435\u0435
    \u0442\u043e\u0447\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0438 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439
    \u043a \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0443\u00bb \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f.
    \u041f\u0443\u0440\u0431\u0430\u0445 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0441\u044f,
    \u043d\u043e \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438, \u0447\u0442\u043e
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u043f\u043e\u0435\u0434\u0435\u0442 \u0441 \u043d\u0438\u043c \u0432 \u0418\u0442\u0430\u043b\u0438\u044e.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 1461 \u0433\u043e\u0434\u0443 \u041f\u0443\u0440\u0431\u0430\u0445
    \u0443\u043c\u0435\u0440, \u0443\u0441\u043f\u0435\u0432 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c
    \u043b\u0438\u0448\u044c \u0447\u0430\u0441\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b.
    \u0423\u043c\u0438\u0440\u0430\u044f, \u043e\u043d \u0437\u0430\u0432\u0435\u0449\u0430\u043b
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0443\u0447\u0435\u043d\u0438\u043a\u0443 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c
    \u044d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434. \u0416\u0438\u0437\u043d\u044c \u0432
    \u0418\u0442\u0430\u043b\u0438\u0438: \u0421\u0434\u0435\u0440\u0436\u0430\u0432 \u0441\u043b\u043e\u0432\u043e,
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0418\u0442\u0430\u043b\u0438\u044e, \u0432\u043e\u0439\u0434\u044f \u0432 \u0441\u0432\u0438\u0442\u0443
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u0430 \u0412\u0438\u0441\u0441\u0430\u0440\u0438\u043e\u043d\u0430.
    \u041e\u043d \u0436\u0438\u043b \u0432 \u0420\u0438\u043c\u0435, \u0412\u0438\u0442\u0435\u0440\u0431\u043e,
    \u0412\u0435\u043d\u0435\u0446\u0438\u0438, \u041f\u0430\u0434\u0443\u0435 \u0438 \u0424\u0435\u0440\u0440\u0430\u0440\u0435.
    \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u0432 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u0435
    \u043e\u0432\u043b\u0430\u0434\u0435\u043b \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c
    \u044f\u0437\u044b\u043a\u043e\u043c \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0424\u0435\u043e\u0434\u043e\u0440\u0430 \u0413\u0430\u0437\u0441\u043a\u043e\u0433\u043e,
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043b\u0443\u0447\u0448\u0438\u043c
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430\u043c \u0415\u0432\u0440\u043e\u043f\u044b
    \u0438 \u0441\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439. \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434: \u0412 1462\u20131464 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0439 magnum opus \u2014 \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00ab\u041e \u0432\u0441\u0435\u0445 \u0432\u0438\u0434\u0430\u0445 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432\u00bb
    (De triangulis omnimodis). \u042d\u0442\u043e\u0442 \u043f\u044f\u0442\u0438\u0442\u043e\u043c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    (\u043f\u043b\u043e\u0441\u043a\u043e\u0439 \u0438 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439)
    \u043a\u0430\u043a \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b,
    \u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430 \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    \u041e\u043d \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0442\u043e\u0447\u043d\u044b\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0441\u0438\u043d\u0443\u0441\u043e\u0432 \u0438
    \u0442\u0430\u043d\u0433\u0435\u043d\u0441\u043e\u0432. \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435
    \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0430\u00bb: \u041a 1463 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u0430\u0431\u043e\u0442\u0443
    \u043d\u0430\u0434 \u00ab\u042d\u043f\u0438\u0442\u043e\u043c\u043e\u0439 \u201e\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0430\u201c\u00bb
    (Epytoma in almagesti Ptolemei), \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0432 \u043e\u0448\u0438\u0431\u043a\u0438
    \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0445 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u0432.
    \u041f\u043e\u0437\u0436\u0435 \u044d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u0441\u0442\u0430\u043b
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u043e\u0439
    \u0434\u043b\u044f \u041d\u0438\u043a\u043e\u043b\u0430\u044f \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430.\n\n\U0001F451
    \u041f\u0440\u0438 \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u043c \u0434\u0432\u043e\u0440\u0435
    \u0438 \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u0432 \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433\u0435
    (1467\u20131475) \u0412\u0435\u043d\u0433\u0440\u0438\u044f (1467\u20131471): \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u044f
    \u041c\u0430\u0442\u0432\u0435\u044f \u041a\u043e\u0440\u0432\u0438\u043d\u0430 \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0411\u0443\u0434\u0443, \u0433\u0434\u0435 \u0437\u0430\u0432\u0435\u0434\u043e\u0432\u0430\u043b
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u043e\u0439
    \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043a\u0430\u043a \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a. \u0422\u0430\u043c \u043e\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b Tabulae directionum \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432. \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433
    (1471\u20131475): \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0438\u043a \u0435\u0433\u043e
    \u0441\u043b\u0430\u0432\u044b. \u0412 1471 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433 \u2014 \u0446\u0435\u043d\u0442\u0440
    \u0440\u0435\u043c\u0435\u0441\u0435\u043b \u0438 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0438.
    \u0417\u0434\u0435\u0441\u044c \u0435\u0433\u043e \u0431\u043e\u0433\u0430\u0442\u044b\u0439
    \u0434\u0440\u0443\u0433 \u0438 \u0443\u0447\u0435\u043d\u0438\u043a, \u043a\u0443\u043f\u0435\u0446
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0412\u0430\u043b\u044c\u0442\u0435\u0440,
    \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u043f\u0435\u0440\u0432\u0443\u044e \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044e \u0438 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043b
    \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0443\u044e \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u0442\u043e\u0447\u043d\u0435\u0439\u0448\u0438\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432.
    \u041f\u0435\u0447\u0430\u0442\u043d\u0438\u043a \u0438 \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044c:
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u044e, \u0441\u0442\u0430\u0432 \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0438\u043e\u043d\u0435\u0440\u043e\u0432 \u043a\u043d\u0438\u0433\u043e\u043f\u0435\u0447\u0430\u0442\u0430\u043d\u0438\u044f.
    \u041e\u043d \u0438\u0437\u0434\u0430\u0432\u0430\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b, \u043d\u043e \u0438 \u0442\u0440\u0443\u0434\u044b
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445 \u0443\u0447\u0435\u043d\u044b\u0445, \u043d\u0430\u043f\u0435\u0447\u0430\u0442\u0430\u043b
    \u00ab\u0422\u0435\u043e\u0440\u0438\u0438 \u043f\u043b\u0430\u043d\u0435\u0442\u00bb \u0441\u0432\u043e\u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u041f\u0443\u0440\u0431\u0430\u0445\u0430 \u0438
    \u0441\u0432\u043e\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u044d\u0444\u0435\u043c\u0435\u0440\u0438\u0434\u044b
    (\u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u043d\u0430 1475\u20131506 \u0433\u043e\u0434\u044b),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0442\u0430\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439
    \u043a\u043d\u0438\u0433\u043e\u0439 \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    (\u0438\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0434\u0430\u0436\u0435
    \u0425\u0440\u0438\u0441\u0442\u043e\u0444\u043e\u0440 \u041a\u043e\u043b\u0443\u043c\u0431!).\n\n\U0001F56F\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u0430\u044f
    \u0441\u043c\u0435\u0440\u0442\u044c (1475\u20131476) \u0412\u044b\u0437\u043e\u0432 \u0432
    \u0420\u0438\u043c: \u0412 1475 \u0433\u043e\u0434\u0443 \u043f\u0430\u043f\u0430 \u0421\u0438\u043a\u0441\u0442
    IV \u043f\u0440\u0438\u0437\u0432\u0430\u043b \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d\u0430
    \u0432 \u0420\u0438\u043c \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0434
    \u0440\u0435\u0444\u043e\u0440\u043c\u043e\u0439 \u044e\u043b\u0438\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f, \u043f\u043e\u043e\u0431\u0435\u0449\u0430\u0432
    \u0435\u043c\u0443 \u0441\u0430\u043d \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u0430 \u0420\u0435\u0433\u0435\u043d\u0441\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0433\u043e.
    \u0422\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u043d\u0435\u0446:
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u043f\u0440\u0438\u0431\u044b\u043b
    \u0432 \u0420\u0438\u043c, \u043d\u043e \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432,
    6 \u0438\u044e\u043b\u044f 1476 \u0433\u043e\u0434\u0430, \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f.
    \u0415\u043c\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e 40 \u043b\u0435\u0442.
    \u041e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0438 \u0441\u043b\u0443\u0445\u0438.
    \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f: \u0427\u0443\u043c\u0430
    (\u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0432 \u0420\u0438\u043c\u0435 \u0431\u044b\u043b\u0430
    \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044f). \u041b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u0430\u044f
    \u0432\u0435\u0440\u0441\u0438\u044f: \u041e\u0442\u0440\u0430\u0432\u0430. \u0425\u043e\u0434\u0438\u043b\u0438
    \u0443\u043f\u043e\u0440\u043d\u044b\u0435 \u0441\u043b\u0443\u0445\u0438, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043e\u0442\u0440\u0430\u0432\u0438\u043b\u0438 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0438
    \u0413\u0435\u043e\u0440\u0433\u0430 \u0422\u0440\u0430\u043f\u0435\u0437\u0443\u043d\u0434\u0441\u043a\u043e\u0433\u043e
    \u2014 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430, \u0447\u0435\u0439 \u043d\u0435\u0442\u043e\u0447\u043d\u044b\u0439
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0430\u00bb
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u0436\u0435\u0441\u0442\u043a\u043e
    \u0440\u0430\u0441\u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b \u0432 \u0441\u0432\u043e\u0438\u0445
    \u0442\u0440\u0443\u0434\u0430\u0445.\n\n\U0001F31F \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430:
    \u041f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0432 \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u0443\u044e \u043d\u0430\u0443\u043a\u0443.
    \u0412\u0432\u0435\u043b \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u044b
    \u0442\u0430\u043d\u0433\u0435\u043d\u0441\u043e\u0432 \u0438 \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0435
    \u0434\u0440\u043e\u0431\u0438. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f:
    \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0432 \u043f\u0435\u0440\u0435\u0432\u043e\u0434
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f, \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0435 \u0437\u043d\u0430\u043d\u0438\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c.
    \u0415\u0433\u043e \u043c\u0435\u0442\u043e\u0434 \u00ab\u043b\u0443\u043d\u043d\u044b\u0445
