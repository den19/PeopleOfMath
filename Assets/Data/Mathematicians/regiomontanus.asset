  fullNameRu: "\u0420\u0435\u0433\u0438\u043E\u043C\u043E\u043D\u0442\u0430\u043D
    (\u0418\u043E\u0433\u0430\u043D\u043D \u041C\u044E\u043B\u043B\u0435\u0440)"
  fullNameEn: Regiomontanus
