    \u0432 \u0441\u0432\u0438\u0442\u0435 \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u0430
    \u0412\u0438\u0441\u0441\u0430\u0440\u0438\u043e\u043d\u0430, \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u043e\u0438\u0441\u043a\u0443
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0435\u043c\u0443, \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c
    \u0433\u0443\u043c\u0430\u043d\u0438\u0441\u0442\u0430\u043c, \u0443\u0434\u0430\u043b\u043e\u0441\u044c
    \u043f\u0435\u0440\u0432\u044b\u043c \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0442\u044c
    \u0442\u0435\u043a\u0441\u0442 \u0443\u0446\u0435\u043b\u0435\u0432\u0448\u0438\u0445 \u0448\u0435\u0441\u0442\u0438
    \u043a\u043d\u0438\u0433 \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438\u00bb
    \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u2014 \u0442\u0440\u0443\u0434\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0436\u0435 \u043e\u043a\u0430\u0436\u0435\u0442
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u044b.
    \u0427\u0442\u043e\u0431\u044b \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u0432\u043e\u0434
    \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0430\u00bb \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f,
    \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u043d\u044b\u0439 \u0443\u043c\u0438\u0440\u0430\u044e\u0449\u0438\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c, \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d
    \u0432 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u0435 \u043e\u0432\u043b\u0430\u0434\u0435\u043b
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c \u044f\u0437\u044b\u043a\u043e\u043c
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0424\u0435\u043e\u0434\u043e\u0440\u0430 \u0413\u0430\u0437\u0441\u043a\u043e\u0433\u043e.
    \u0412\u043b\u0430\u0434\u0435\u043d\u0438\u0435 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c
    \u0431\u044b\u043b\u043e \u0440\u0435\u0434\u043a\u043e\u0441\u0442\u044c\u044e \u0434\u043b\u044f
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0421\u0435\u0432\u0435\u0440\u043d\u043e\u0439
    \u0415\u0432\u0440\u043e\u043f\u044b \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\U0001F4D6
    \u041d\u043e\u0432\u0430\u0442\u043e\u0440 \u043a\u043d\u0438\u0433\u043e\u043f\u0435\u0447\u0430\u0442\u0430\u043d\u0438\u044f
    \u041f\u0435\u0440\u0435\u0435\u0445\u0430\u0432 \u0432 \u041d\u044e\u0440\u043d\u0431\u0435\u0440\u0433,
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u044e,
    \u0430 \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0440\u043e\u0434\u0435. \u0415\u0433\u043e \u0446\u0435\u043b\u044c\u044e
    \u0431\u044b\u043b\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0447\u0430\u0442\u0430\u0442\u044c
    \u043a\u043d\u0438\u0433\u0438, \u0430 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u043d\u0430\u043d\u0438\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0438
    \u0434\u043b\u044f \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u043a\u0440\u0443\u0433\u0430
    \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u0439 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f
    \u2014 \u043f\u0435\u0447\u0430\u0442\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u043d\u043a\u0430.
    \u0415\u0433\u043e \u043a\u043d\u0438\u0433\u0438 \u0431\u044b\u043b\u0438 \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0435\u043a\u0441\u0442\u043e\u043c. \u041e\u043d
    \u0432\u0432\u0435\u043b \u0432 \u043d\u0438\u0445 \u0438\u043d\u043d\u043e\u0432\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u0434\u043b\u044f \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0435\u0447\u0430\u0442\u043d\u044b\u0435
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u044b \u0438 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b, \u0430 \u0432 \u043a\u043e\u043d\u0446\u0435
    \u0435\u0433\u043e \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f \u0431\u044b\u043b\u0438
    \u0434\u0430\u0436\u0435 \u0432\u043a\u043b\u0430\u0434\u043a\u0438 \u0441 \u0431\u0443\u043c\u0430\u0436\u043d\u044b\u043c\u0438
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0432\u044b\u0440\u0435\u0437\u0430\u0442\u044c
    \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c!\n\n\U0001F92B
    \u0422\u0430\u0439\u043d\u0430, \u043e\u043a\u0443\u0442\u0430\u043d\u043d\u0430\u044f \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439
    \u0421\u043c\u0435\u0440\u0442\u044c \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d\u0430
    \u0432 \u0420\u0438\u043c\u0435 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    40 \u043b\u0435\u0442, \u043a\u0443\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u0432\u0430\u043d
    \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0434 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439
    \u0440\u0435\u0444\u043e\u0440\u043c\u043e\u0439, \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0430
    \u043e\u0434\u043d\u0443 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0436\u0438\u0432\u0443\u0447\u0438\u0445
    \u043b\u0435\u0433\u0435\u043d\u0434. \u041f\u043e\u043c\u0438\u043c\u043e \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0432\u0435\u0440\u0441\u0438\u0438 \u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442
    \u0447\u0443\u043c\u044b (\u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u043a\u0430\u043a
    \u0440\u0430\u0437 \u0431\u044b\u043b\u0430 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044f),
    \u0445\u043e\u0434\u0438\u043b\u0438 \u0443\u043f\u043e\u0440\u043d\u044b\u0435 \u0441\u043b\u0443\u0445\u0438
    \u043e\u0431 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438. \u041c\u043e\u043b\u0432\u0430
    \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0430 \u043d\u0430 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0435\u0433\u043e \u0434\u0430\u0432\u043d\u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u043e\u043f\u043f\u043e\u043d\u0435\u043d\u0442\u0430, \u0413\u0435\u043e\u0440\u0433\u0438\u044f
    \u0422\u0440\u0430\u043f\u0435\u0437\u0443\u043d\u0434\u0441\u043a\u043e\u0433\u043e, \u0447\u0435\u0439
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0430\u00bb
    \u0420\u0435\u0433\u0438\u043e\u043c\u043e\u043d\u0442\u0430\u043d \u0436\u0435\u0441\u0442\u043a\u043e
    \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u043b. \u0425\u043e\u0442\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u044d\u0442\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u043d\u0435\u0442, \u043e\u043d\u0430
    \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u043f\u043e\u0445\u043e\u0436\u0435\u0439 \u043d\u0430 \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439
    \u0440\u043e\u043c\u0430\u043d. \u0415\u0441\u043b\u0438 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e
    \u0438\u0437 \u044d\u0442\u0438\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b
    \u0432\u0430\u0441 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e, \u044f \u043c\u043e\u0433\u0443
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u043e \u043d\u0435\u043c \u0435\u0449\u0435
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435."
