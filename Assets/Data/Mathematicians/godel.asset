  fullNameRu: "\u0413\u0451\u0434\u0435\u043B\u044C, \u041A\u0443\u0440\u0442 \u0424\u0440\u0438\u0301\u0434\u0440\u0438\u0445"
  fullNameEn: "Kurt Friedrich G\xF6del"
