  achievementsRu: "\u041f\u043e\u043c\u0438\u043c\u043e \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435,
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041a\u0443\u0440\u0442\u0430 \u0413\u0451\u0434\u0435\u043b\u044f \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c
    \u0438\u0445 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e.\n\n\U0001F3D7\ufe0f \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0413\u0451\u0434\u0435\u043b\u044f \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    \u0441\u0442\u0430\u043b\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u0447\u0430\u0441\u0442\u043e \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0435\u043c\u043e\u0439
    \u043a\u0430\u043a \u043a\u043b\u0430\u0441\u0441 `L`. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u0430\u044f \u0438\u0434\u0435\u044f,
    \u0430 \u0441\u0442\u0440\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u0430\u044f
    \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u044f \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0430\u044f \"\u0441\u043d\u0438\u0437\u0443
    \u0432\u0432\u0435\u0440\u0445\": 1. \u041d\u0430\u0447\u0438\u043d\u0430\u0435\u043c \u0441
    \u043f\u0443\u0441\u0442\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430.
    2. \u041d\u0430 \u043a\u0430\u0436\u0434\u043e\u043c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c
    \u0448\u0430\u0433\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u043c \u0432\u0441\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0444\u043e\u0440\u043c\u0443\u043b \u043b\u043e\u0433\u0438\u043a\u0438
    \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0430, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0443\u0436\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430.
    3. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u043c \u044d\u0442\u043e\u0442
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u043f\u043e\u0440\u044f\u0434\u043a\u043e\u0432\u044b\u0445 \u0447\u0438\u0441\u0435\u043b.
    \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f `L`, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0439
    \u043c\u043e\u0434\u0435\u043b\u044c\u044e \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    \u0426\u0435\u0440\u043c\u0435\u043b\u043e-\u0424\u0440\u0435\u043d\u043a\u0435\u043b\u044f
    (ZF) \u0438 \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438.\n\n\U0001F6E1\ufe0f \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u0446\u0435\u043b\u044c\u044e \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 `L` \u0431\u044b\u043b\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0434\u0432\u0443\u0445 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c,
    \u0441\u0442\u043e\u044f\u0432\u0448\u0438\u0445 \u043f\u0435\u0440\u0435\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435
    XX \u0432\u0435\u043a\u0430. \u0413\u0451\u0434\u0435\u043b\u044c \u0434\u043e\u0431\u0438\u043b\u0441\u044f
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0433\u043e \u0443\u0441\u043f\u0435\u0445\u0430:
    \u0410\u043a\u0441\u0438\u043e\u043c\u0430 \u0432\u044b\u0431\u043e\u0440\u0430: \u0413\u0451\u0434\u0435\u043b\u044c
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0439
    \u0438\u043c \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 `L` \u0430\u043a\u0441\u0438\u043e\u043c\u0430
    \u0432\u044b\u0431\u043e\u0440\u0430 (AC) \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0441\u0442\u0438\u043d\u043d\u0430.
    \u0418\u0437 \u044d\u0442\u043e\u0433\u043e \u0441\u043b\u0435\u0434\u0443\u0435\u0442,
    \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 ZF
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430,
    \u0442\u043e \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 ZFC (ZF + \u0430\u043a\u0441\u0438\u043e\u043c\u0430
    \u0432\u044b\u0431\u043e\u0440\u0430). \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u044d\u0442\u043e\u0439 \u0430\u043a\u0441\u0438\u043e\u043c\u044b
    \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438
    \u043a \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e.
    \u041a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430:
    \u0415\u0449\u0435 \u0431\u043e\u043b\u0435\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u043c
    \u0431\u044b\u043b\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0432 \u044d\u0442\u043e\u0439 \u0436\u0435
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 `L` \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f
    \u0438 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u0430\u044f \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    (GCH). \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e
    GCH \u0442\u0430\u043a\u0436\u0435 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430
    \u0441 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u043c\u0438 ZF. \u0418\u0442\u043e\u0433
    \u044d\u0442\u0438\u0445 \u0434\u0432\u0443\u0445 \u0440\u0430\u0431\u043e\u0442 \u0431\u044b\u043b
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d \u0432 \u0435\u0433\u043e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \"The Consistency of the Continuum Hypothesis\", \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0432 1940 \u0433\u043e\u0434\u0443. \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043d\u0438 \u0430\u043a\u0441\u0438\u043e\u043c\u0430 \u0432\u044b\u0431\u043e\u0440\u0430,
    \u043d\u0438 \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b
    \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u0435\u0441\u043b\u0438
    \u043e\u043d\u0430 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430.\n\n\U0001F570\ufe0f
    \u041e\u0442 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043a \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438:
    \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u043f\u0443\u0442\u044c \u041f\u0443\u0442\u044c
    \u043a \u044d\u0442\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c
    \u0431\u044b\u043b \u0434\u043e\u043b\u0433\u0438\u043c \u0438 \u0442\u0435\u0440\u043d\u0438\u0441\u0442\u044b\u043c.
    \u041f\u0435\u0440\u0432\u044b\u0435 \u0438\u0434\u0435\u0438 \u0438 \u043d\u0430\u0431\u0440\u043e\u0441\u043a\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u0443 \u0413\u0451\u0434\u0435\u043b\u044f \u0435\u0449\u0435 \u0432 1935 \u0433\u043e\u0434\u0443
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0435\u0433\u043e \u0432\u0438\u0437\u0438\u0442\u0430
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u043f\u043b\u0430\u043d\u044b \u043d\u0430\u0440\u0443\u0448\u0438\u043b
    \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u043d\u0435\u0440\u0432\u043d\u044b\u0439 \u0441\u0440\u044b\u0432
    \u0432 \u043a\u043e\u043d\u0446\u0435 \u0442\u043e\u0433\u043e \u0436\u0435 \u0433\u043e\u0434\u0430.
    \u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430: \u0418\u0437-\u0437\u0430 \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438
    \u0413\u0451\u0434\u0435\u043b\u044c \u0441\u043c\u043e\u0433 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f
    \u043a \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043b\u0438\u0448\u044c
    \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442.
    \u0420\u0435\u0448\u0430\u044e\u0449\u0438\u0439 \u043c\u043e\u043c\u0435\u043d\u0442: \u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0435
    \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0435, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432\u0448\u0435\u0435
    \u0435\u043c\u0443 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b,
    \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b\u043e, \u043f\u043e \u0435\u0433\u043e
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c,
    \"\u043d\u043e\u0447\u044c\u044e \u0441 14 \u043d\u0430 15 \u0438\u044e\u043d\u044f 1937
    \u0433\u043e\u0434\u0430\". \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u2014 \u044d\u0442\u043e \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0440\u0438\u0443\u043c\u0444 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438, \u043d\u043e \u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u043f\u0435\u0440\u0435\u0434 \u043b\u0438\u0446\u043e\u043c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445
    \u043b\u0438\u0447\u043d\u044b\u0445 \u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0435\u0439. \u042d\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0442\u043e\u0447\u043a\u0443 \u0432 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0445
    \u0434\u0435\u0431\u0430\u0442\u0430\u0445 \u043e \u0441\u0442\u0430\u0442\u0443\u0441\u0435
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u0432\u044b\u0431\u043e\u0440\u0430 \u0438 \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0438\u0445 \u043d\u0435\u043b\u044c\u0437\u044f
    \u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u043d\u0438 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043e\u0431\u0449\u0435\u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0435
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b."
  achievementsEn: "In addition to the world-famous theory of incompleteness, Kurt Godel's scientific legacy includes fundamental advances in the theory of multiples that have had a significant impact on the development of modern mathematics.\n\nThe creation of the constructive universe as the key contribution of Godel to the theory of multiples was the creation of the concept of design sets, often referred to as the `L' class. This is not just an abstract idea, but a strictly defined hierarchy of multiples built from the bottom up: 1. Start with an empty set. 2.At each next step, we add all the sets that can be defined by first order logic formulas using the many already built. 3. We continue this process for all the endless numbers. The result is the universe `L', which is the lowest model for the theory of the multiples of Cermelo-Frenkel (ZF) and has remarkable properties.\n\nThe proof of relative consistency was the main purpose of building the universe `L' was to solve two key problems facing the theory of multiples in the early 20th century. Godel was a brilliant success: Axiom of choice: Goedel proved that in the universe he built `L' axiom of choice (AC) was always true. It follows that if the ZF system is consistent, then the ZFC system (ZF + axiom of choice) is consistent.The addition of this axiom cannot therefore lead to a contradiction that was not originally the case. The continuum hypothesis: Even more significant was the evidence that the same universe `L' was being implemented and the consolidated continuum hypothese (GCH). This meant that GCH was also consistent with ZF axioms. The outcome of these two works was set out in its famous monograph \"The Consistency of the Continuum Hypothesis\", published in 1940.Gödel has shown that neither the axiom of choice nor the continuum hypothesis can be refuted in a standard set of multiple theory if it is consistent.\n\nFrom discovery to publication: The road to these results was long and difficult. The first ideas and sketches of evidence came to Godel as early as 1935 during his visit to Princeton. However, his plans were disrupted by a severe nervous breakdown at the end of the same year. Delay: Due to illness and subsequent rehabilitation, Godel was not able to return to this work until a few years later.The key lesson that enabled him to complete the evidence for the continuum hypothesis came, according to his own words, \"at night from 14 to 15 June 1937.\" Thus, his achievements in the theory of multiples are not only a triumph of mathematical thought, but also a testimony of incredible persistence in the face of serious personal and psychological difficulties.These works have been the final point in the multi-year debate on the status of the axiom of choice and continuum hypotheses, showing that they cannot be proved or denied using commonly accepted axioms."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041a\u0443\u0440\u0442\u0430
    \u0413\u0451\u0434\u0435\u043b\u044f \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432: \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0432\u0437\u043b\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u043e\u0441\u0435\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0434\u0440\u0430\u043c\u043e\u0439, \u0438 \u0432\u0441\u0435\u043f\u043e\u0433\u043b\u043e\u0449\u0430\u044e\u0449\u0435\u0439
    \u043b\u044e\u0431\u0432\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0430\u0441\u044c
    \u0432 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043b\u0438\u043d\u0438\u044e
    \u043e\u0431\u043e\u0440\u043e\u043d\u044b \u043f\u0440\u043e\u0442\u0438\u0432 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044e\u0449\u0435\u0433\u043e
    \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0435\u0434\u0443\u0433\u0430.
    \u042d\u0442\u043e \u0440\u0430\u0441\u0441\u043a\u0430\u0437 \u043e \u0441\u043b\u043e\u0436\u043d\u043e\u043c
    \u0433\u0435\u043d\u0438\u0438 \u0438 \u0436\u0435\u043d\u0449\u0438\u043d\u0435, \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0432\u0448\u0435\u0439
    \u0435\u043c\u0443 \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F496 \u0410\u0434\u0435\u043b\u044c:
    \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0432\u043e\u043f\u0440\u0435\u043a\u0438 \u0432\u0441\u0435\u043c\u0443
    \u0421\u0430\u043c\u043e\u0439 \u044f\u0440\u043a\u043e\u0439 \u0438 \u0432\u0430\u0436\u043d\u043e\u0439
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435\u0439 \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0413\u0451\u0434\u0435\u043b\u044f \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u0431\u0440\u0430\u043a \u0441 \u0410\u0434\u0435\u043b\u044c \u041f\u043e\u0440\u043a\u0435\u0440\u0442
    (\u0432 \u0434\u0435\u0432\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u041d\u0438\u043c\u0431\u0443\u0440\u0441\u043a\u0438).
    \u0418\u0445 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0432 1927 \u0433\u043e\u0434\u0443
    \u0432 \u0432\u0435\u043d\u0441\u043a\u043e\u043c \u043d\u043e\u0447\u043d\u043e\u043c \u043a\u043b\u0443\u0431\u0435,
    \u0433\u0434\u0435 \u0410\u0434\u0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u0442\u0430\u043d\u0446\u043e\u0432\u0449\u0438\u0446\u0435\u0439, \u0431\u044b\u043b\u043e
    \u043f\u043e\u0447\u0442\u0438 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044c\u043d\u044b\u043c:
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430 \u0448\u0435\u0441\u0442\u044c
    \u043b\u0435\u0442 \u0441\u0442\u0430\u0440\u0448\u0435, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u044b \u0438 \u043a \u0442\u043e\u043c\u0443 \u043c\u043e\u043c\u0435\u043d\u0442\u0443
    \u0443\u0436\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430 \u0432 \u0431\u0440\u0430\u043a\u0435.
    \u0421\u0435\u043c\u044c\u044f \u0413\u0451\u0434\u0435\u043b\u044f, \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0432\u0448\u0430\u044f
    \u043a \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u043d\u043e\u0439 \u0431\u0443\u0440\u0436\u0443\u0430\u0437\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u0435, \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435 \u043e\u0434\u043e\u0431\u0440\u044f\u043b\u0430 \u044d\u0442\u043e\u0442 \u0441\u043e\u044e\u0437.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u043e, \u0413\u0451\u0434\u0435\u043b\u044c
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u043d\u0435\u043f\u0440\u0435\u043a\u043b\u043e\u043d\u0435\u043d.
    \u041f\u043e\u0441\u043b\u0435 \u0440\u0430\u0437\u0432\u043e\u0434\u0430 \u0410\u0434\u0435\u043b\u044c
    \u043e\u043d\u0438 \u0441\u043c\u043e\u0433\u043b\u0438 \u043f\u043e\u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 1938 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439.
    \u042d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u0441\u0442\u0430\u043b \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u043b\u0438\u0447\u043d\u044b\u043c \u0432\u044b\u0431\u043e\u0440\u043e\u043c,
    \u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0430\u043a\u0442\u043e\u043c
    \u0432\u043e\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0432\u0441\u044e \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c.\n\n\u2694\ufe0f \u0411\u0438\u0442\u0432\u0430 \u0441 \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0435\u0439:
    \u0436\u0435\u043d\u0430 \u0438 \u0441\u0438\u0434\u0435\u043b\u043a\u0430 \u0432 \u043e\u0434\u043d\u043e\u043c
    \u043b\u0438\u0446\u0435 \u0412\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0413\u0451\u0434\u0435\u043b\u044f \u0438 \u0410\u0434\u0435\u043b\u044c \u043d\u0435\u043b\u044c\u0437\u044f
    \u0431\u044b\u043b\u043e \u043d\u0430\u0437\u0432\u0430\u0442\u044c \u043e\u0431\u044b\u0447\u043d\u044b\u043c\u0438.
    \u0421 \u0441\u0430\u043c\u043e\u0433\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0438\u0445
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u0435\u0449\u0435 \u0432 1930-\u0445 \u0433\u043e\u0434\u0430\u0445, \u0443 \u0413\u0451\u0434\u0435\u043b\u044f
    \u043d\u0430\u0447\u0430\u043b\u0438 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438
    \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430.
    \u041e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0438
    \u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0438.
    \u0413\u043b\u0430\u0432\u043d\u044b\u043c \u043d\u0430\u0432\u044f\u0437\u0447\u0438\u0432\u044b\u043c
    \u0441\u0442\u0440\u0430\u0445\u043e\u043c \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u043b
    \u0441\u0442\u0440\u0430\u0445 \u0431\u044b\u0442\u044c \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c.
    \u042d\u0442\u043e\u0442 \u0441\u0442\u0440\u0430\u0445 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b
    \u0431\u044b\u0442 \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0431\u043e\u0440\u044c\u0431\u0443.
    \u0410\u0434\u0435\u043b\u044c \u0441\u0442\u0430\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0436\u0435\u043d\u043e\u0439, \u0430 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u0413\u0451\u0434\u0435\u043b\u044c \u0434\u043e\u0432\u0435\u0440\u044f\u043b. \u041e\u043d
    \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043e\u0442 \u043b\u044e\u0431\u043e\u0439
    \u0435\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d\u0430 \u043b\u0438\u0447\u043d\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b\u0430 \u043f\u0440\u0438 \u043d\u0435\u043c.
    \u0415\u0433\u043e \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
