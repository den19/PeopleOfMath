    \u043c\u0438\u0440\u0430. \u0423 \u043f\u0430\u0440\u044b \u043d\u0435 \u0431\u044b\u043b\u043e
    \u0434\u0435\u0442\u0435\u0439, \u0438, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c, \u0413\u0451\u0434\u0435\u043b\u044c
