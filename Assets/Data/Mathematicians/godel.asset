  achievementsRu: "\u041f\u043e\u043c\u0438\u043c\u043e \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435,
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041a\u0443\u0440\u0442\u0430 \u0413\u0451\u0434\u0435\u043b\u044f \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c
    \u0438\u0445 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e.\n\n\U0001F3D7\ufe0f \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0413\u0451\u0434\u0435\u043b\u044f \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    \u0441\u0442\u0430\u043b\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u0447\u0430\u0441\u0442\u043e \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0435\u043c\u043e\u0439
    \u043a\u0430\u043a \u043a\u043b\u0430\u0441\u0441 `L`. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u0430\u044f \u0438\u0434\u0435\u044f,
    \u0430 \u0441\u0442\u0440\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u0430\u044f
    \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u044f \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0430\u044f \"\u0441\u043d\u0438\u0437\u0443
    \u0432\u0432\u0435\u0440\u0445\": 1. \u041d\u0430\u0447\u0438\u043d\u0430\u0435\u043c \u0441
    \u043f\u0443\u0441\u0442\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430.
    2. \u041d\u0430 \u043a\u0430\u0436\u0434\u043e\u043c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c
    \u0448\u0430\u0433\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u043c \u0432\u0441\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0444\u043e\u0440\u043c\u0443\u043b \u043b\u043e\u0433\u0438\u043a\u0438
    \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0430, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0443\u0436\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430.
    3. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u043c \u044d\u0442\u043e\u0442
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u043f\u043e\u0440\u044f\u0434\u043a\u043e\u0432\u044b\u0445 \u0447\u0438\u0441\u0435\u043b.
    \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f `L`, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0439
    \u043c\u043e\u0434\u0435\u043b\u044c\u044e \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    \u0426\u0435\u0440\u043c\u0435\u043b\u043e-\u0424\u0440\u0435\u043d\u043a\u0435\u043b\u044f
    (ZF) \u0438 \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438.\n\n\U0001F6E1\ufe0f \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u0446\u0435\u043b\u044c\u044e \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 `L` \u0431\u044b\u043b\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0434\u0432\u0443\u0445 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c,
    \u0441\u0442\u043e\u044f\u0432\u0448\u0438\u0445 \u043f\u0435\u0440\u0435\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435
    XX \u0432\u0435\u043a\u0430. \u0413\u0451\u0434\u0435\u043b\u044c \u0434\u043e\u0431\u0438\u043b\u0441\u044f
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0433\u043e \u0443\u0441\u043f\u0435\u0445\u0430:
    \u0410\u043a\u0441\u0438\u043e\u043c\u0430 \u0432\u044b\u0431\u043e\u0440\u0430: \u0413\u0451\u0434\u0435\u043b\u044c
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0439
    \u0438\u043c \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 `L` \u0430\u043a\u0441\u0438\u043e\u043c\u0430
    \u0432\u044b\u0431\u043e\u0440\u0430 (AC) \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0441\u0442\u0438\u043d\u043d\u0430.
    \u0418\u0437 \u044d\u0442\u043e\u0433\u043e \u0441\u043b\u0435\u0434\u0443\u0435\u0442,
    \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 ZF
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430,
    \u0442\u043e \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 ZFC (ZF + \u0430\u043a\u0441\u0438\u043e\u043c\u0430
    \u0432\u044b\u0431\u043e\u0440\u0430). \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u044d\u0442\u043e\u0439 \u0430\u043a\u0441\u0438\u043e\u043c\u044b
    \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438
    \u043a \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e.
    \u041a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430:
    \u0415\u0449\u0435 \u0431\u043e\u043b\u0435\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u043c
    \u0431\u044b\u043b\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0432 \u044d\u0442\u043e\u0439 \u0436\u0435
    \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 `L` \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f
    \u0438 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u0430\u044f \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    (GCH). \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e
    GCH \u0442\u0430\u043a\u0436\u0435 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430
    \u0441 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u043c\u0438 ZF. \u0418\u0442\u043e\u0433
    \u044d\u0442\u0438\u0445 \u0434\u0432\u0443\u0445 \u0440\u0430\u0431\u043e\u0442 \u0431\u044b\u043b
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d \u0432 \u0435\u0433\u043e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \"The Consistency of the Continuum Hypothesis\", \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0432 1940 \u0433\u043e\u0434\u0443. \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043d\u0438 \u0430\u043a\u0441\u0438\u043e\u043c\u0430 \u0432\u044b\u0431\u043e\u0440\u0430,
    \u043d\u0438 \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b
    \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u0435\u0441\u043b\u0438
    \u043e\u043d\u0430 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430.\n\n\U0001F570\ufe0f
    \u041e\u0442 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043a \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438:
    \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u043f\u0443\u0442\u044c \u041f\u0443\u0442\u044c
    \u043a \u044d\u0442\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c
    \u0431\u044b\u043b \u0434\u043e\u043b\u0433\u0438\u043c \u0438 \u0442\u0435\u0440\u043d\u0438\u0441\u0442\u044b\u043c.
    \u041f\u0435\u0440\u0432\u044b\u0435 \u0438\u0434\u0435\u0438 \u0438 \u043d\u0430\u0431\u0440\u043e\u0441\u043a\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u0443 \u0413\u0451\u0434\u0435\u043b\u044f \u0435\u0449\u0435 \u0432 1935 \u0433\u043e\u0434\u0443
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0435\u0433\u043e \u0432\u0438\u0437\u0438\u0442\u0430
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u043f\u043b\u0430\u043d\u044b \u043d\u0430\u0440\u0443\u0448\u0438\u043b
    \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u043d\u0435\u0440\u0432\u043d\u044b\u0439 \u0441\u0440\u044b\u0432
    \u0432 \u043a\u043e\u043d\u0446\u0435 \u0442\u043e\u0433\u043e \u0436\u0435 \u0433\u043e\u0434\u0430.
    \u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430: \u0418\u0437-\u0437\u0430 \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438
    \u0413\u0451\u0434\u0435\u043b\u044c \u0441\u043c\u043e\u0433 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f
    \u043a \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043b\u0438\u0448\u044c
    \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442.
    \u0420\u0435\u0448\u0430\u044e\u0449\u0438\u0439 \u043c\u043e\u043c\u0435\u043d\u0442: \u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0435
    \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0435, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432\u0448\u0435\u0435
    \u0435\u043c\u0443 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b,
    \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b\u043e, \u043f\u043e \u0435\u0433\u043e
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c,
    \"\u043d\u043e\u0447\u044c\u044e \u0441 14 \u043d\u0430 15 \u0438\u044e\u043d\u044f 1937
    \u0433\u043e\u0434\u0430\". \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u2014 \u044d\u0442\u043e \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0440\u0438\u0443\u043c\u0444 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438, \u043d\u043e \u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u043f\u0435\u0440\u0435\u0434 \u043b\u0438\u0446\u043e\u043c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445
    \u043b\u0438\u0447\u043d\u044b\u0445 \u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0435\u0439. \u042d\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0442\u043e\u0447\u043a\u0443 \u0432 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0445
    \u0434\u0435\u0431\u0430\u0442\u0430\u0445 \u043e \u0441\u0442\u0430\u0442\u0443\u0441\u0435
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u0432\u044b\u0431\u043e\u0440\u0430 \u0438 \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0438\u0445 \u043d\u0435\u043b\u044c\u0437\u044f
    \u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u043d\u0438 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043e\u0431\u0449\u0435\u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0435
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041a\u0443\u0440\u0442\u0430
    \u0413\u0451\u0434\u0435\u043b\u044f \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432: \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0432\u0437\u043b\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u043e\u0441\u0435\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0434\u0440\u0430\u043c\u043e\u0439, \u0438 \u0432\u0441\u0435\u043f\u043e\u0433\u043b\u043e\u0449\u0430\u044e\u0449\u0435\u0439
    \u043b\u044e\u0431\u0432\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0430\u0441\u044c
    \u0432 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043b\u0438\u043d\u0438\u044e
    \u043e\u0431\u043e\u0440\u043e\u043d\u044b \u043f\u0440\u043e\u0442\u0438\u0432 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044e\u0449\u0435\u0433\u043e
    \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0435\u0434\u0443\u0433\u0430.
    \u042d\u0442\u043e \u0440\u0430\u0441\u0441\u043a\u0430\u0437 \u043e \u0441\u043b\u043e\u0436\u043d\u043e\u043c
    \u0433\u0435\u043d\u0438\u0438 \u0438 \u0436\u0435\u043d\u0449\u0438\u043d\u0435, \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0432\u0448\u0435\u0439
    \u0435\u043c\u0443 \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F496 \u0410\u0434\u0435\u043b\u044c:
    \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0432\u043e\u043f\u0440\u0435\u043a\u0438 \u0432\u0441\u0435\u043c\u0443
    \u0421\u0430\u043c\u043e\u0439 \u044f\u0440\u043a\u043e\u0439 \u0438 \u0432\u0430\u0436\u043d\u043e\u0439
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435\u0439 \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0413\u0451\u0434\u0435\u043b\u044f \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u0431\u0440\u0430\u043a \u0441 \u0410\u0434\u0435\u043b\u044c \u041f\u043e\u0440\u043a\u0435\u0440\u0442
    (\u0432 \u0434\u0435\u0432\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u041d\u0438\u043c\u0431\u0443\u0440\u0441\u043a\u0438).
    \u0418\u0445 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0432 1927 \u0433\u043e\u0434\u0443
    \u0432 \u0432\u0435\u043d\u0441\u043a\u043e\u043c \u043d\u043e\u0447\u043d\u043e\u043c \u043a\u043b\u0443\u0431\u0435,
    \u0433\u0434\u0435 \u0410\u0434\u0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u0442\u0430\u043d\u0446\u043e\u0432\u0449\u0438\u0446\u0435\u0439, \u0431\u044b\u043b\u043e
    \u043f\u043e\u0447\u0442\u0438 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044c\u043d\u044b\u043c:
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430 \u0448\u0435\u0441\u0442\u044c
    \u043b\u0435\u0442 \u0441\u0442\u0430\u0440\u0448\u0435, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u044b \u0438 \u043a \u0442\u043e\u043c\u0443 \u043c\u043e\u043c\u0435\u043d\u0442\u0443
    \u0443\u0436\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430 \u0432 \u0431\u0440\u0430\u043a\u0435.
    \u0421\u0435\u043c\u044c\u044f \u0413\u0451\u0434\u0435\u043b\u044f, \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0432\u0448\u0430\u044f
    \u043a \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u043d\u043e\u0439 \u0431\u0443\u0440\u0436\u0443\u0430\u0437\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u0435, \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435 \u043e\u0434\u043e\u0431\u0440\u044f\u043b\u0430 \u044d\u0442\u043e\u0442 \u0441\u043e\u044e\u0437.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u043e, \u0413\u0451\u0434\u0435\u043b\u044c
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u043d\u0435\u043f\u0440\u0435\u043a\u043b\u043e\u043d\u0435\u043d.
    \u041f\u043e\u0441\u043b\u0435 \u0440\u0430\u0437\u0432\u043e\u0434\u0430 \u0410\u0434\u0435\u043b\u044c
    \u043e\u043d\u0438 \u0441\u043c\u043e\u0433\u043b\u0438 \u043f\u043e\u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 1938 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439.
    \u042d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u0441\u0442\u0430\u043b \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u043b\u0438\u0447\u043d\u044b\u043c \u0432\u044b\u0431\u043e\u0440\u043e\u043c,
    \u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0430\u043a\u0442\u043e\u043c
    \u0432\u043e\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0432\u0441\u044e \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c.\n\n\u2694\ufe0f \u0411\u0438\u0442\u0432\u0430 \u0441 \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0435\u0439:
    \u0436\u0435\u043d\u0430 \u0438 \u0441\u0438\u0434\u0435\u043b\u043a\u0430 \u0432 \u043e\u0434\u043d\u043e\u043c
    \u043b\u0438\u0446\u0435 \u0412\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0413\u0451\u0434\u0435\u043b\u044f \u0438 \u0410\u0434\u0435\u043b\u044c \u043d\u0435\u043b\u044c\u0437\u044f
    \u0431\u044b\u043b\u043e \u043d\u0430\u0437\u0432\u0430\u0442\u044c \u043e\u0431\u044b\u0447\u043d\u044b\u043c\u0438.
    \u0421 \u0441\u0430\u043c\u043e\u0433\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0438\u0445
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u0435\u0449\u0435 \u0432 1930-\u0445 \u0433\u043e\u0434\u0430\u0445, \u0443 \u0413\u0451\u0434\u0435\u043b\u044f
    \u043d\u0430\u0447\u0430\u043b\u0438 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438
    \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430.
    \u041e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0438
    \u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0438.
    \u0413\u043b\u0430\u0432\u043d\u044b\u043c \u043d\u0430\u0432\u044f\u0437\u0447\u0438\u0432\u044b\u043c
    \u0441\u0442\u0440\u0430\u0445\u043e\u043c \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u043b
    \u0441\u0442\u0440\u0430\u0445 \u0431\u044b\u0442\u044c \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c.
    \u042d\u0442\u043e\u0442 \u0441\u0442\u0440\u0430\u0445 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b
    \u0431\u044b\u0442 \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0431\u043e\u0440\u044c\u0431\u0443.
    \u0410\u0434\u0435\u043b\u044c \u0441\u0442\u0430\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0436\u0435\u043d\u043e\u0439, \u0430 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u0413\u0451\u0434\u0435\u043b\u044c \u0434\u043e\u0432\u0435\u0440\u044f\u043b. \u041e\u043d
    \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043e\u0442 \u043b\u044e\u0431\u043e\u0439
    \u0435\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d\u0430 \u043b\u0438\u0447\u043d\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b\u0430 \u043f\u0440\u0438 \u043d\u0435\u043c.
    \u0415\u0433\u043e \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u043b\u0430\u0441\u044c
    \u0438 \u043d\u0430 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b:
    \u0432 \u0438\u0445 \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u043f\u043e \u0435\u0433\u043e \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044e
    \u0431\u044b\u043b\u0438 \u0443\u0434\u0430\u043b\u0435\u043d\u044b \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a
    \u0438 \u0440\u0430\u0434\u0438\u0430\u0442\u043e\u0440, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u043d \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u043b \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a
    \u043e\u0442\u0440\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0445 \u0433\u0430\u0437\u043e\u0432.
    \u0410\u0434\u0435\u043b\u044c \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b\u0430 \u0441\u0432\u043e\u044e
    \u0436\u0438\u0437\u043d\u044c \u0443\u0445\u043e\u0434\u0443 \u0437\u0430 \u043c\u0443\u0436\u0435\u043c.
    \u0412 \u043f\u0435\u0440\u0438\u043e\u0434\u044b \u0442\u044f\u0436\u0435\u043b\u044b\u0445
    \u043a\u0440\u0438\u0437\u0438\u0441\u043e\u0432, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432 \u043a\u043e\u043d\u0446\u0435 \u0436\u0438\u0437\u043d\u0438, \u043a\u043e\u0433\u0434\u0430
    \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u044f \u0441\u0442\u0430\u043b\u0430 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0442\u044c\u0441\u044f
    \u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u044f\u043c\u0438, \u043e\u043d\u0430
    \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b\u0430
    \u0440\u043e\u043b\u044c \u0441\u0438\u0434\u0435\u043b\u043a\u0438, \u043a\u043e\u0440\u043c\u0438\u043b\u0430
    \u043c\u0443\u0436\u0430 \u0441 \u043b\u043e\u0436\u043a\u0438 \u0438 \u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044c
    \u043e\u0433\u0440\u0430\u0434\u0438\u0442\u044c \u0435\u0433\u043e \u043e\u0442 \u0432\u043d\u0435\u0448\u043d\u0435\u0433\u043e
    \u043c\u0438\u0440\u0430. \u0423 \u043f\u0430\u0440\u044b \u043d\u0435 \u0431\u044b\u043b\u043e
    \u0434\u0435\u0442\u0435\u0439, \u0438, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c, \u0413\u0451\u0434\u0435\u043b\u044c
    \u043d\u0435 \u0445\u043e\u0442\u0435\u043b \u0434\u0435\u043b\u0438\u0442\u044c \u0437\u0430\u0431\u043e\u0442\u0443
    \u0436\u0435\u043d\u044b \u043d\u0438 \u0441 \u043a\u0435\u043c. \u0412\u0441\u044f \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f
    \u0410\u0434\u0435\u043b\u044c \u0441\u0443\u0437\u0438\u043b\u0430\u0441\u044c \u0434\u043e
    \u0437\u0430\u0431\u043e\u0442\u044b \u043e \u0441\u0432\u043e\u0435\u043c \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u043c,
    \u043d\u043e \u0431\u043e\u043b\u044c\u043d\u043e\u043c \u043c\u0443\u0436\u0435.\n\n\U0001F9E0
    \u041a\u0440\u0443\u0433 \u0434\u0440\u0443\u0437\u0435\u0439 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439
    \u0443\u0434\u0430\u0440 \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0441\u0442\u044c,
    \u0443 \u0413\u0451\u0434\u0435\u043b\u044f \u0431\u044b\u043b\u0438 \u0431\u043b\u0438\u0437\u043a\u0438\u0435
    \u0434\u0440\u0443\u0437\u044c\u044f. \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u043e\u0439
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u0442\u0430\u043b\u0430 \u0434\u0440\u0443\u0436\u0431\u0430
    \u0441 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435. \u0418\u0445 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435
    \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438 \u043a \u0434\u043e\u043c\u0443 \u0441\u0442\u0430\u043b\u0438
    \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430.
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0441\u0432\u043e\u0439 \u0436\u0438\u0437\u043d\u0435\u0440\u0430\u0434\u043e\u0441\u0442\u043d\u044b\u0439
    \u0438 \u043e\u0431\u0449\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440,
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b \u0432 \u0413\u0451\u0434\u0435\u043b\u0435 \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e
    \u043f\u043e \u0434\u0443\u0445\u0443 \u043c\u044b\u0441\u043b\u0438\u0442\u0435\u043b\u044f.
    \u041e\u043d \u0436\u0435 \u043f\u043e\u043c\u043e\u0433 \u0435\u043c\u0443 \u0432 1940
    \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043c\u0435\u0441\u0442\u043e
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d
    \u0432\u044b\u0441\u043e\u043a\u043e \u0446\u0435\u043d\u0438\u043b \u043e\u0431\u0449\u0435\u043d\u0438\u0435
    \u0441 \u0413\u0451\u0434\u0435\u043b\u0435\u043c, \u0438 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u044c
    \u0432 1955 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u0443\u0447\u0435\u043d\u043e\u0433\u043e
    \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u0443\u0434\u0430\u0440\u043e\u043c. \u0415\u0449\u0435
    \u043e\u0434\u043d\u0438\u043c \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c
    \u0431\u044b\u043b \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442 \u041e\u0441\u043a\u0430\u0440
    \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u0441\u0435\u043c\u044c\u0435 \u043e\u0433\u0440\u043e\u043c\u043d\u0443\u044e
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435, \u0441\u0430\u043c\u044b\u0435
    \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0433\u043e\u0434\u044b. \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f
    \u0440\u0430\u0437\u044b\u0433\u0440\u0430\u043b\u0430\u0441\u044c \u0432 1977 \u0433\u043e\u0434\u0443.
    \u041b\u0435\u0442\u043e\u043c \u044d\u0442\u043e\u0433\u043e \u0433\u043e\u0434\u0430 \u0410\u0434\u0435\u043b\u044c
    \u0431\u044b\u043b\u0430 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0430
    \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432,
    \u0430 \u0432 \u043a\u043e\u043d\u0446\u0435 \u0438\u044e\u043b\u044f \u0443\u043c\u0435\u0440
    \u0435\u0433\u043e \u0434\u0440\u0443\u0433 \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d.
    \u041b\u0438\u0448\u0438\u0432\u0448\u0438\u0441\u044c \u0434\u0432\u0443\u0445 \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043e\u043f\u043e\u0440, \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u043b\u0441\u044f \u0432 \u043f\u0443\u0447\u0438\u043d\u0443
    \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0438. \u0411\u0435\u0437 \u0436\u0435\u043d\u044b,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043c\u043e\u0433\u043b\u0430 \u0431\u044b \"\u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0442\u044c\"
    \u0435\u0433\u043e \u0435\u0434\u0443, \u043e\u043d \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u0435\u0441\u0442\u044c. \u0423 \u043d\u0435\u0433\u043e
    \u0440\u0430\u0437\u0432\u0438\u043b\u0430\u0441\u044c \u0442\u044f\u0436\u0435\u043b\u0430\u044f
    \u0430\u043d\u043e\u0440\u0435\u043a\u0441\u0438\u044f. 14 \u044f\u043d\u0432\u0430\u0440\u044f
    1978 \u0433\u043e\u0434\u0430 \u041a\u0443\u0440\u0442 \u0413\u0451\u0434\u0435\u043b\u044c
    \u0443\u043c\u0435\u0440 \u0432 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0435 \u0432
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 \u043e\u0442 \u0438\u0441\u0442\u043e\u0449\u0435\u043d\u0438\u044f.
    \u0415\u0433\u043e \u0432\u0435\u0441 \u043d\u0430 \u043c\u043e\u043c\u0435\u043d\u0442
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0432\u0441\u0435\u0433\u043e 29 \u043a\u0438\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0432.
    \u041f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438 \u0441\u0442\u0430\u043b\u0430
    \"\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c
    \u043f\u0438\u0442\u0430\u043d\u0438\u044f \u0438 \u0438\u0441\u0442\u043e\u0449\u0435\u043d\u0438\u0435\",
    \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u044b\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u043c
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438."
  personalLifeEn: 
  shortBioRu: "\u041a\u0443\u0440\u0442 \u0424\u0440\u0438\u0434\u0440\u0438\u0445 \u0413\u0451\u0434\u0435\u043b\u044c
    (1906\u20131978) \u2014 \u0430\u0432\u0441\u0442\u0440\u0438\u0439\u0441\u043a\u0438\u0439
    \u0438 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439 \u043b\u043e\u0433\u0438\u043a,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043b\u043e\u0433\u0438\u043a\u0435
    \u043f\u043e \u0441\u0432\u043e\u0435\u043c\u0443 \u0432\u043b\u0438\u044f\u043d\u0438\u044e
    \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c\u044b \u0441 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430. \u0413\u043b\u0430\u0432\u043d\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0413\u0451\u0434\u0435\u043b\u044f \u2014
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435
    \u2014 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043e \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c
    \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044f\u0445 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f.\n\n\U0001F4DC \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0413\u0451\u0434\u0435\u043b\u044c \u0440\u043e\u0434\u0438\u043b\u0441\u044f 28 \u0430\u043f\u0440\u0435\u043b\u044f
    1906 \u0433\u043e\u0434\u0430 \u0432 \u043c\u043e\u0440\u0430\u0432\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u0440\u044e\u043d\u043d (\u043d\u044b\u043d\u0435
    \u0411\u0440\u043d\u043e, \u0427\u0435\u0445\u0438\u044f), \u0432 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0420\u0443\u0434\u043e\u043b\u044c\u0444
    \u0413\u0451\u0434\u0435\u043b\u044c, \u0431\u044b\u043b \u0441\u043e\u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0435\u043c
    \u0442\u0435\u043a\u0441\u0442\u0438\u043b\u044c\u043d\u043e\u0439 \u0444\u0430\u0431\u0440\u0438\u043a\u0438,
    \u0447\u0442\u043e \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u043b\u043e \u0441\u0435\u043c\u044c\u0435
    \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c.
    \u0421 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u041a\u0443\u0440\u0442 \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0441\u044f
    \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0441\u0442\u044c\u044e, \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0435\u0439
    \u0438 \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e\u0439 \u043c\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e.
    \u0415\u0433\u043e \u0434\u0430\u0436\u0435 \u043f\u0440\u043e\u0437\u0432\u0430\u043b\u0438
    \u00abder Herr Warum\u00bb (\u00ab\u0413\u043e\u0441\u043f\u043e\u0434\u0438\u043d \u041f\u043e\u0447\u0435\u043c\u0443\u00bb)
    \u0437\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b
    \u043e\u0431 \u043e\u0441\u043d\u043e\u0432\u0430\u0445 \u0432\u0435\u0449\u0435\u0439.
    \u041e\u043d \u0440\u0430\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043a \u044f\u0437\u044b\u043a\u0430\u043c: \u043f\u043e\u043c\u0438\u043c\u043e \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0433\u043e,
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b
    \u043f\u043e-\u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438 \u0438 \u043f\u043e-\u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438.
    \u0412 1923 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0412\u0435\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0438\u0437\u0443\u0447\u0430\u043b
    \u0444\u0438\u0437\u0438\u043a\u0443, \u043d\u043e \u043f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c
    \u043a\u0443\u0440\u0441\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u0438\u0434\u0435\u0439 \u0411\u0435\u0440\u0442\u0440\u0430\u043d\u0430
    \u0420\u0430\u0441\u0441\u0435\u043b\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041a\u043b\u044e\u0447\u0435\u0432\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u0435\u0433\u043e \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0441\u044b\u0433\u0440\u0430\u043b\u043e \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u0430\u0445 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0412\u0435\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u0440\u0443\u0436\u043a\u0430 \u2014
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432
    \u0438 \u0443\u0447\u0435\u043d\u044b\u0445-\u043d\u0435\u043e\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u0438\u0441\u0442\u043e\u0432.
    \u0425\u043e\u0442\u044f \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u043e\u0441\u0435\u0449\u0430\u043b
    \u0435\u0433\u043e \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u044f, \u043e\u043d
    \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f
    \u043a \u0438\u0445 \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u043c, \u043d\u0430\u0445\u043e\u0434\u044f
    \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c\u0438.\n\n\U0001F4A1 \u0422\u0440\u0438\u0443\u043c\u0444
    \u0438 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f: \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435 \u0413\u043b\u0430\u0432\u043d\u044b\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0413\u0451\u0434\u0435\u043b\u044f \u0431\u044b\u043b\u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u044b
    \u0432 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043c\u043e\u043b\u043e\u0434\u043e\u043c
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043f\u043e\u043b\u043d\u043e\u0442\u0435 (1930): \u0412 \u0441\u0432\u043e\u0435\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u0413\u0451\u0434\u0435\u043b\u044c
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043b\u043e\u0433\u0438\u043a\u0430
    \u043f\u0440\u0435\u0434\u0438\u043a\u0430\u0442\u043e\u0432 \u043f\u0435\u0440\u0432\u043e\u0433\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u043e\u043b\u043d\u043e\u0439: \u043b\u044e\u0431\u0430\u044f \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u0438\u0441\u0442\u0438\u043d\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430
    \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u044d\u0442\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b.
    \u042d\u0442\u043e \u0431\u044b\u043b \u0432\u0430\u0436\u043d\u044b\u0439 \u00ab\u043e\u043f\u0442\u0438\u043c\u0438\u0441\u0442\u0438\u0447\u043d\u044b\u0439\u00bb
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u0443\u043a\u0440\u0435\u043f\u0438\u0432\u0448\u0438\u0439
    \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043c\u0430.
    \u0422\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435
    (1931): 7 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1930 \u0433\u043e\u0434\u0430
    \u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438 \u0432 \u041a\u0451\u043d\u0438\u0433\u0441\u0431\u0435\u0440\u0433\u0435
    24-\u043b\u0435\u0442\u043d\u0438\u0439 \u0413\u0451\u0434\u0435\u043b\u044c \u0441\u0434\u0435\u043b\u0430\u043b
    \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0434\u043e\u043a\u043b\u0430\u0434,
    \u0430 \u0432 1931 \u0433\u043e\u0434\u0443 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0430
    \u044d\u0444\u0444\u0435\u043a\u0442 \u0440\u0430\u0437\u043e\u0440\u0432\u0430\u0432\u0448\u0435\u0439\u0441\u044f
    \u0431\u043e\u043c\u0431\u044b. \u041f\u0435\u0440\u0432\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435 \u0433\u043b\u0430\u0441\u0438\u0442:
    \u0432 \u043b\u044e\u0431\u043e\u0439 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0439
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435,
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0435\u0439 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u043d\u0438 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c
    \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u044d\u0442\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b.
    \u0418\u043d\u044b\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438, \u043b\u044e\u0431\u0430\u044f
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0441\u043b\u043e\u0436\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u0435\u043f\u043e\u043b\u043d\u0430. \u0412\u0442\u043e\u0440\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435 \u043d\u0430\u043d\u043e\u0441\u0438\u043b\u0430
    \u0435\u0449\u0435 \u0431\u043e\u043b\u0435\u0435 \u0441\u043e\u043a\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0443\u0434\u0430\u0440 \u043f\u043e \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u043e\u0439
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435 \u0414\u0430\u0432\u0438\u0434\u0430
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0435\u0435 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c.
    \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u0442\u0430\u043a\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438
    \u0441\u0430\u043c\u043e\u0439 \u044d\u0442\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b.
    \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0441\u043b\u0443\u0436\u0438\u0442\u044c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u044b\u043c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c.\n\n\U0001F6E4\ufe0f
    \u042d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f \u0438 \u0436\u0438\u0437\u043d\u044c
    \u0432 \u0421\u0428\u0410 \u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0432 \u0415\u0432\u0440\u043e\u043f\u0435
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0436\u0438\u0437\u043d\u044c \u0443\u0447\u0435\u043d\u043e\u0433\u043e.
    \u0412 1938 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0430\u043d\u0448\u043b\u044e\u0441\u0430
    (\u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0410\u0432\u0441\u0442\u0440\u0438\u0438
    \u043a \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u043e\u0439 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438),
    \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0440\u0430\u0431\u043e\u0442\u0443
    \u0438 \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d \u0433\u043e\u0434\u043d\u044b\u043c
    \u043a \u0432\u043e\u0435\u043d\u043d\u043e\u0439 \u0441\u043b\u0443\u0436\u0431\u0435.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0410\u0434\u0435\u043b\u044c \u041f\u043e\u0440\u043a\u0435\u0440\u0442,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u0435\u0433\u043e
    \u0432\u0435\u0440\u043d\u043e\u0439 \u0441\u043f\u0443\u0442\u043d\u0438\u0446\u0435\u0439
    \u0438 \u043e\u043f\u043e\u0440\u043e\u0439 \u043d\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c.
    \u0412 1940 \u0433\u043e\u0434\u0443, \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c \u043f\u0440\u0438\u0437\u044b\u0432\u0430,
    \u0413\u0451\u0434\u0435\u043b\u044c \u0441 \u0436\u0435\u043d\u043e\u0439 \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432 \u0421\u0428\u0410. \u041f\u0443\u0442\u044c \u0431\u044b\u043b \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u043c:
    \u0438\u0437-\u0437\u0430 \u0432\u043e\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u0432 \u0410\u0442\u043b\u0430\u043d\u0442\u0438\u043a\u0435 \u043e\u043d\u0438 \u0434\u043e\u0431\u0440\u0430\u043b\u0438\u0441\u044c
    \u0447\u0435\u0440\u0435\u0437 \u0421\u0421\u0421\u0420 \u043f\u043e \u0422\u0440\u0430\u043d\u0441\u0441\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0439
    \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043b\u0438 \u0438 \u042f\u043f\u043e\u043d\u0438\u044e.
    \u0412 \u0410\u043c\u0435\u0440\u0438\u043a\u0435 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u043c
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0433\u0434\u0435 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043e
    \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438. \u0417\u0434\u0435\u0441\u044c
    \u043e\u043d \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0441\u044f \u0441 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c, \u0438 \u0438\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0435
    \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438 \u0441\u0442\u0430\u043b\u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0430. \u0412 1948 \u0433\u043e\u0434\u0443
    \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e. \u041d\u0430 \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438
    \u043e\u043d, \u043a \u0443\u0436\u0430\u0441\u0443 \u0434\u0440\u0443\u0437\u0435\u0439,
    \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0441\u0443\u0434\u044c\u0435, \u0447\u0442\u043e \u0438\u0437 \u041a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0438
    \u0421\u0428\u0410 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043b\u0435\u0434\u0443\u0435\u0442
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f
    \u0434\u0438\u043a\u0442\u0430\u0442\u0443\u0440\u044b. \u0422\u043e\u043b\u044c\u043a\u043e
    \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043f\u043e\u0440\u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439
    (\u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 \u0438 \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d\u0430)
    \u043f\u043e\u043c\u043e\u0433\u043b\u043e \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u043d\u043e
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443.\n\n\u2728
    \u0414\u0440\u0443\u0433\u0438\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u0413\u0451\u0434\u0435\u043b\u044f \u043d\u0435
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043b\u043e\u0433\u0438\u043a\u043e\u0439.
    \u041e\u043d \u0432\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u0434\u043e\u043a\u0430\u0437\u0430\u0432
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u044c \u0430\u043a\u0441\u0438\u043e\u043c\u044b
    \u0432\u044b\u0431\u043e\u0440\u0430 \u0438 \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0441 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0426\u0435\u0440\u043c\u0435\u043b\u043e-\u0424\u0440\u0435\u043d\u043a\u0435\u043b\u044f.
    \u041e\u0431\u0441\u0443\u0436\u0434\u0430\u044f \u0441 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0444\u0438\u0437\u0438\u043a\u0438, \u0413\u0451\u0434\u0435\u043b\u044c
    \u0432 1949 \u0433\u043e\u0434\u0443 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u043b\u043e
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0445
    \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0445
    \u043b\u0438\u043d\u0438\u0439 \u2014 \u0442\u043e \u0435\u0441\u0442\u044c \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0439
    \u0432\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u042d\u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u044c,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043a\u0430\u043a \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f
    \u0413\u0451\u0434\u0435\u043b\u044f, \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u0435\u043c\u0443
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    \u0432 1951 \u0433\u043e\u0434\u0443.\n\n\U0001F9E0 \u0422\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0438\u043d\u0430\u043b \u0412\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u0413\u0451\u0434\u0435\u043b\u044c
    \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445
    \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432.
    \u0423\u0436\u0435 \u0432 1930-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0443 \u043d\u0435\u0433\u043e
    \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u044b
    \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0438
    \u0438 \u043f\u0430\u0440\u0430\u043d\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u0442\u0440\u0430\u0445\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0431\u043e\u044f\u0437\u043d\u044c \u0431\u044b\u0442\u044c \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c).
    \u0412 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 \u043e\u043d \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0435\u0434\u044b, \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439
    \u043d\u0435 \u0435\u0433\u043e \u0436\u0435\u043d\u043e\u0439, \u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u044f \u0432 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0435
    \u0432 1970-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0443 \u043d\u0435\u0433\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b\u0438\u0441\u044c
    \u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0438. \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f
    \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b\u0430 \u0432 \u043a\u043e\u043d\u0446\u0435
    \u0436\u0438\u0437\u043d\u0438. \u0415\u0433\u043e \u0436\u0435\u043d\u0430 \u0410\u0434\u0435\u043b\u044c
    \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u043b\u0430 \u0438
    \u0431\u044b\u043b\u0430 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0430,
    \u0430 \u0432 \u0438\u044e\u043b\u0435 1977 \u0433\u043e\u0434\u0430 \u0443\u043c\u0435\u0440
    \u0438\u0445 \u0431\u043b\u0438\u0437\u043a\u0438\u0439 \u0434\u0440\u0443\u0433 \u041e\u0441\u043a\u0430\u0440
    \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d. \u041b\u0438\u0448\u0438\u0432\u0448\u0438\u0441\u044c
    \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043e\u043f\u043e\u0440, \u0413\u0451\u0434\u0435\u043b\u044c,
    \u0441\u0442\u0440\u0430\u0434\u0430\u044f \u043e\u0442 \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0438
    \u0438 \u0430\u043d\u043e\u0440\u0435\u043a\u0441\u0438\u0438, \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u0435\u0441\u0442\u044c, \u0431\u043e\u044f\u0441\u044c
    \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u0412 \u0434\u0435\u043a\u0430\u0431\u0440\u0435
    1977 \u0433\u043e\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d,
    \u043d\u043e \u0431\u044b\u043b\u043e \u0443\u0436\u0435 \u043f\u043e\u0437\u0434\u043d\u043e.
    \u041a\u0443\u0440\u0442 \u0413\u0451\u0434\u0435\u043b\u044c \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 14 \u044f\u043d\u0432\u0430\u0440\u044f
    1978 \u0433\u043e\u0434\u0430 \u043e\u0442 \u0438\u0441\u0442\u043e\u0449\u0435\u043d\u0438\u044f."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041a\u0443\u0440\u0442\u0430 \u0413\u0451\u0434\u0435\u043b\u044f
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u044f\u0440\u043a\u043e
    \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0442 \u0435\u0433\u043e
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0433\u0435\u043d\u0438\u0439
    \u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440.
    \u0412\u043e\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437 \u043d\u0438\u0445.\n\n\U0001F9D2
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \"\u0413\u043e\u0441\u043f\u043e\u0434\u0438\u043d \u041f\u043e\u0447\u0435\u043c\u0443\"
    \u0421 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442 \u0413\u0451\u0434\u0435\u043b\u044c
    \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b \u043d\u0435\u0443\u0442\u043e\u043b\u0438\u043c\u0443\u044e
    \u0436\u0430\u0436\u0434\u0443 \u0437\u043d\u0430\u043d\u0438\u0439 \u0438 \u0434\u043e\u0442\u043e\u0448\u043d\u043e\u0441\u0442\u044c.
    \u0415\u0433\u043e \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c
    \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c \u043e\u0431 \u043e\u0441\u043d\u043e\u0432\u0430\u0445
    \u0432\u0435\u0449\u0435\u0439 \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u0435\u043b\u0438\u043a\u0430, \u0447\u0442\u043e \u0432 \u0441\u0435\u043c\u044c\u0435
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430 \u043b\u0430\u0441\u043a\u043e\u0432\u043e
    \u043f\u0440\u043e\u0437\u0432\u0430\u043b\u0438 \"der Herr Warum\" \u2014 \"\u0413\u043e\u0441\u043f\u043e\u0434\u0438\u043d
    \u041f\u043e\u0447\u0435\u043c\u0443\". \u042d\u0442\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043e\u0442\u0440\u0430\u0436\u0430\u043b\u043e
    \u0435\u0433\u043e \u0431\u0443\u0434\u0443\u0449\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443, \u0432\u0435\u0434\u044c \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u0436\u0438\u0437\u043d\u044c \u043f\u043e\u0438\u0441\u043a\u0443 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043e\u0441\u043d\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043b\u043e\u0433\u0438\u043a\u0438.\n\n\U0001F4DC \u0422\u0430\u0439\u043d\u0430
    \"\u041b\u0430\u0437\u0435\u0439\u043a\u0438 \u0413\u0451\u0434\u0435\u043b\u044f\" \u041f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0438
    \u0437\u0430\u0431\u0430\u0432\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435\u043c
    \u0413\u0451\u0434\u0435\u043b\u0435\u043c \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u0430 \u0432 1947 \u0433\u043e\u0434\u0443.
    \u041a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043e\u043d\u043d\u044b\u0439
    \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441: \u0413\u043e\u0442\u043e\u0432\u044f\u0441\u044c
    \u043a \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0443 \u043d\u0430 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e,
    \u0413\u0451\u0434\u0435\u043b\u044c, \u043f\u043e \u0441\u0432\u043e\u0435\u043c\u0443
    \u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044e, \u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u0443\u0447\u0438\u043b \u041a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u044e
    \u0421\u0428\u0410 \u0438, \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u0443\u0436\u0430\u0441\u0443,
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b \u0432 \u043d\u0435\u0439 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \"\u043b\u0430\u0437\u0435\u0439\u043a\u0443\". \u041e\u043d \u043f\u0440\u0438\u0448\u0435\u043b
    \u043a \u0432\u044b\u0432\u043e\u0434\u0443, \u0447\u0442\u043e \u044d\u0442\u043e\u0442
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u043a \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043b\u0435\u0433\u0430\u043b\u044c\u043d\u043e
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0443\u044e
    \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0443 \u0432 \u0434\u0438\u043a\u0442\u0430\u0442\u0443\u0440\u0443.
    \u0422\u0440\u0435\u0432\u043e\u0433\u0430 \u0434\u0440\u0443\u0437\u0435\u0439: \u0421\u0432\u043e\u0438\u043c
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c \u043e\u043d \u043f\u043e\u0434\u0435\u043b\u0438\u043b\u0441\u044f
    \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u2014 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c \u0438 \u041e\u0441\u043a\u0430\u0440\u043e\u043c
    \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d\u043e\u043c. \u0422\u0435
    \u043f\u0440\u0438\u0448\u043b\u0438 \u0432 \u0443\u0436\u0430\u0441, \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e
    \u0437\u043d\u0430\u044f \u043f\u0435\u0434\u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0413\u0451\u0434\u0435\u043b\u044f. \u041e\u043d\u0438 \u0431\u043e\u044f\u043b\u0438\u0441\u044c,
    \u0447\u0442\u043e \u043d\u0430 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0435 \u043e\u043d
    \u043d\u0430\u0447\u043d\u0435\u0442 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u044d\u0442\u043e \u0441\u0443\u0434\u044c\u0435, \u0447\u0442\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u043e
    \u0431\u044b \u043f\u043e\u0434 \u0443\u0433\u0440\u043e\u0437\u0443 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u0430. \u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0430\u0442\u0430\u043a\u0430 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430: \u041f\u043e
    \u0434\u043e\u0440\u043e\u0433\u0435 \u0432 \u0441\u0443\u0434 \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d
    \u0441\u0438\u0434\u0435\u043b \u0437\u0430 \u0440\u0443\u043b\u0435\u043c, \u0430 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d
    \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u043b
    \u0413\u0451\u0434\u0435\u043b\u044f \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0430\u043c\u0438
    \u043d\u0430 \u043e\u0442\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u044b\u0435 \u0442\u0435\u043c\u044b,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0431 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0440\u0443\u0441\u0441\u043a\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438, \u0447\u0442\u043e\u0431\u044b
    \u0432\u044b\u0431\u0438\u0442\u044c \u0438\u0437 \u0433\u043e\u043b\u043e\u0432\u044b \u043c\u044b\u0441\u043b\u0438
    \u043e \u041a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0438. \u0418\u043d\u0446\u0438\u0434\u0435\u043d\u0442
    \u0432 \u0441\u0443\u0434\u0435: \u041e\u0434\u043d\u0430\u043a\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430 \u0441\u0443\u0434\u044c\u044f \u0441\u043f\u0440\u043e\u0441\u0438\u043b
    \u0413\u0451\u0434\u0435\u043b\u044f, \u043a\u0430\u043a\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u043e \u0432 \u0410\u0432\u0441\u0442\u0440\u0438\u0438. \u0413\u0451\u0434\u0435\u043b\u044c
    \u0447\u0435\u0441\u0442\u043d\u043e \u043e\u0442\u0432\u0435\u0442\u0438\u043b, \u0447\u0442\u043e
    \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0430
    \u0432 \u0434\u0438\u043a\u0442\u0430\u0442\u0443\u0440\u0443. \u041a\u043e\u0433\u0434\u0430
    \u0441\u0443\u0434\u044c\u044f \u0437\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e
    \u0432 \u0421\u0428\u0410 \u0442\u0430\u043a\u043e\u0435 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0413\u0451\u0434\u0435\u043b\u044c \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b:
    \"\u041e, \u0434\u0430, \u044f \u043c\u043e\u0433\u0443 \u044d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c!\"
    \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e, \u0441\u0443\u0434\u044c\u044f \u0431\u044b\u043b
    \u0437\u043d\u0430\u043a\u043e\u043c \u0441 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c
    \u0438, \u043d\u0435 \u0436\u0435\u043b\u0430\u044f \u0432\u0432\u044f\u0437\u044b\u0432\u0430\u0442\u044c\u0441\u044f
    \u0432 \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044e, \u0431\u044b\u0441\u0442\u0440\u043e
    \u043f\u0435\u0440\u0435\u0432\u0435\u043b \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440
    \u0432 \u0434\u0440\u0443\u0433\u043e\u0435 \u0440\u0443\u0441\u043b\u043e. \u0422\u043e\u0447\u043d\u0430\u044f
    \u043f\u0440\u0438\u0440\u043e\u0434\u0430 \u044d\u0442\u043e\u0439 \"\u043b\u0430\u0437\u0435\u0439\u043a\u0438\"
    \u0442\u0430\u043a \u0438 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u043d\u0435\u0440\u0430\u0437\u0433\u0430\u0434\u0430\u043d\u043d\u043e\u0439,
    \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u0441\u043f\u043e\u0440\u044f\u0442
    \u043e \u043d\u0435\u0439 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440.\n\n\U0001F3B2
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u0435\u0440\u0438\u043b \u0432 \u043f\u0440\u0438\u0432\u0438\u0434\u0435\u043d\u0438\u044f?
    \u0413\u0451\u0434\u0435\u043b\u044c \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u043f\u043b\u0430\u0442\u043e\u043d\u0438\u043a\u043e\u043c \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041e\u043d \u0432\u0435\u0440\u0438\u043b, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0447\u0438\u0441\u043b\u0430 \u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430)
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e
    \u0438 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u043d\u0430\u0448\u0435\u0433\u043e
    \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f, \u043f\u043e\u0434\u043e\u0431\u043d\u043e
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u043c\u0438\u0440\u0443.
    \u041c\u044b \u043d\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0435\u043c \u0438\u0445,
    \u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u043c, \u043a\u0430\u043a \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442
    \u043d\u043e\u0432\u044b\u0435 \u0432\u0438\u0434\u044b \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445.
    \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u043e\u043d \u0431\u044b\u043b
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d, \u0447\u0442\u043e \u0443 \u043d\u0430\u0441
    \u0435\u0441\u0442\u044c \u043e\u0441\u043e\u0431\u0430\u044f \"\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f\", \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f
    \"\u0432\u0438\u0434\u0435\u0442\u044c\" \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0441\u0442\u044c
    \u0430\u043a\u0441\u0438\u043e\u043c. \u0412 \u043a\u0430\u043a\u043e\u043c-\u0442\u043e
    \u0441\u043c\u044b\u0441\u043b\u0435 \u044d\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0437\u0432\u0430\u0442\u044c
    \u0432\u0435\u0440\u043e\u0439 \u0432 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u043c\u0438\u0440\u0430 \u0438\u0434\u0435\u0439, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442
    \u0435\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u043f\u043e\u0447\u0442\u0438
    \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0434\u043b\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u0432\u0448\u0435\u0433\u043e\u0441\u044f
    \u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c\u0438.\n\n\U0001F570\ufe0f
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f, \u0433\u0434\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u0432\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0412 1949 \u0433\u043e\u0434\u0443, \u0432 \u043f\u043e\u0434\u0430\u0440\u043e\u043a
    \u043d\u0430 70-\u043b\u0435\u0442\u0438\u0435 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430,
    \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u0440\u0435\u043f\u043e\u0434\u043d\u0435\u0441
    \u0435\u043c\u0443 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u0441\u044e\u0440\u043f\u0440\u0438\u0437.
    \u041e\u043d \u043d\u0430\u0448\u0435\u043b \u0442\u043e\u0447\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u043e
    \u0432\u0440\u0430\u0449\u0430\u044e\u0449\u0443\u044e\u0441\u044f \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u0443\u044e.
    \u0412 \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439
    \u043a\u0430\u043a \"\u0412\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f \u0413\u0451\u0434\u0435\u043b\u044f\",
    \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438 \u0441\u0432\u0435\u0442\u0430
    \u0438 \u043c\u0430\u0442\u0435\u0440\u0438\u0438 \u0437\u0430\u043a\u0440\u0443\u0447\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u0442\u0430\u043a \u0441\u0438\u043b\u044c\u043d\u043e, \u0447\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b\u0438
    \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0435
    \u043b\u0438\u043d\u0438\u0438. \u041f\u0440\u043e\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u044f,
    \u0432 \u0442\u0430\u043a\u043e\u0439 \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043c\u043e\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u0431\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f
    \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u0435. \u0425\u043e\u0442\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043d\u0430\u0448\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u0430\u044f
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f \u043d\u0435 \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u0442\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u044d\u0442\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0430
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e \u0433\u043b\u0443\u0431\u0438\u043d\u0443
    \u0438 \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u044c \u0435\u0433\u043e \u043c\u044b\u0441\u043b\u0438.
    \u0417\u0430 \u044d\u0442\u043e\u0442 \u0432\u043a\u043b\u0430\u0434 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 \u0432 1951 \u0433\u043e\u0434\u0443.\n\n\U0001F4AC
    \u0412\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430
    \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0442\u0435\u0445, \u043a\u0442\u043e \u043b\u0438\u0447\u043d\u043e
    \u043e\u0431\u0449\u0430\u043b\u0441\u044f \u0441 \u0413\u0451\u0434\u0435\u043b\u0435\u043c,
    \u0431\u044b\u043b \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044c-\u0444\u0430\u043d\u0442\u0430\u0441\u0442
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0420\u0443\u0434\u0438 \u0420\u0430\u043a\u0435\u0440.
    \u0412 1972 \u0433\u043e\u0434\u0443, \u0431\u0443\u0434\u0443\u0447\u0438 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u043c,
    \u043e\u043d \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u043f\u043e\u0441\u0435\u0449\u0430\u043b
    \u0413\u0451\u0434\u0435\u043b\u044f \u0432 \u0435\u0433\u043e \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0441\u043a\u043e\u043c
    \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0435. \u0410\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430:
    \u041a\u0430\u0431\u0438\u043d\u0435\u0442 \u0413\u0451\u0434\u0435\u043b\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u043b
    \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435
    \u2014 \u043e\u043d \u0431\u044b\u043b \u043f\u043e\u043b\u0443\u0442\u0435\u043c\u043d\u044b\u043c,
    \u0441 \u043a\u043e\u0432\u0440\u0430\u043c\u0438 \u0438 \u043c\u044f\u0433\u043a\u043e\u0439
    \u043c\u0435\u0431\u0435\u043b\u044c\u044e. \u041d\u0430 \u043f\u0443\u0441\u0442\u043e\u043c
    \u0441\u0442\u043e\u043b\u0435 \u0441\u0442\u043e\u044f\u043b \u043f\u0443\u0441\u0442\u043e\u0439
    \u0441\u0442\u0430\u043a\u0430\u043d \u0438\u0437-\u043f\u043e\u0434 \u043c\u043e\u043b\u043e\u043a\u0430.
    \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440: \u0420\u0430\u043a\u0435\u0440 \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u043b
    \u0435\u0433\u043e \u0432\u044b\u0441\u043e\u043a\u0438\u0439, \u043f\u0435\u0432\u0443\u0447\u0438\u0439
    \u0433\u043e\u043b\u043e\u0441 \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0439,
    \u0441\u043b\u043e\u0436\u043d\u043e \u0440\u0438\u0442\u043c\u0438\u0447\u043d\u044b\u0439
    \u0441\u043c\u0435\u0445. \u0420\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441 \u0413\u0451\u0434\u0435\u043b\u0435\u043c,
    \u043f\u043e \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c, \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043b
    \u0442\u0435\u043b\u0435\u043f\u0430\u0442\u0438\u044e \u2014 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0431\u044b\u0441\u0442\u0440\u043e \u0438 \u0442\u043e\u0447\u043d\u043e \u0442\u043e\u0442
    \u0441\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u043b \u043b\u044e\u0431\u0443\u044e \u043c\u044b\u0441\u043b\u044c
    \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a\u0430. \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441
    \u0441\u0432\u043e\u0431\u043e\u0434\u044b \u0432\u043e\u043b\u0438: \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0438\u0445 \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0439 \u0413\u0451\u0434\u0435\u043b\u044c
    \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u043b \u043e \u0441\u0432\u043e\u0431\u043e\u0434\u0435
    \u0432\u043e\u043b\u0438 \u0438 \u043f\u0440\u0435\u0434\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438.
    \u041e\u043d \u043f\u043e\u043b\u0430\u0433\u0430\u043b, \u0447\u0442\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430
    \u043f\u043e\u043b\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0432\u0441\u0435 \u043d\u0430\u0448\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f.
    \u041d\u043e \u0435\u0441\u043b\u0438 \"\u043e\u0437\u043e\u0440\u043d\u043e\u0439\" \u0447\u0435\u043b\u043e\u0432\u0435\u043a
    \u0443\u0437\u043d\u0430\u0435\u0442 \u044d\u0442\u0443 \u0442\u0435\u043e\u0440\u0438\u044e,
    \u043e\u043d \u0441\u043c\u043e\u0436\u0435\u0442 \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442, \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c
    \u0435\u0435. \u0413\u0451\u0434\u0435\u043b\u044c \u043f\u0440\u0438\u0448\u0435\u043b
    \u043a \u0443\u0442\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c\u0443 \u0432\u044b\u0432\u043e\u0434\u0443:
    \"\u0422\u0435\u043e\u0440\u0438\u044f \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442,
    \u043d\u043e \u043d\u0438 \u043e\u0434\u0438\u043d \u043e\u0437\u043e\u0440\u043d\u043e\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0435 \u0443\u0437\u043d\u0430\u0435\u0442
    \u043e \u043d\u0435\u0439\".\n\n\U0001F37D\ufe0f \u0422\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0438\u043d\u0430\u043b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u043e\u0442
    \u0441\u0442\u0440\u0430\u0445\u0430 \u0421\u0430\u043c\u0430\u044f \u043f\u0435\u0447\u0430\u043b\u044c\u043d\u0430\u044f
    \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0434\u0435\u0442\u0430\u043b\u044c
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u2014
    \u044d\u0442\u043e \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u043c\u0435\u0440\u0442\u044c.
    \u0412\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u0413\u0451\u0434\u0435\u043b\u044c \u0441\u0442\u0440\u0430\u0434\u0430\u043b
    \u043e\u0442 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0438,
    \u0438 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043d\u0430\u0432\u044f\u0437\u0447\u0438\u0432\u044b\u043c
    \u0441\u0442\u0440\u0430\u0445\u043e\u043c \u0431\u044b\u043b \u0441\u0442\u0440\u0430\u0445
    \u0431\u044b\u0442\u044c \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c.
    \u041e\u043d \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043e\u0442
    \u043b\u044e\u0431\u043e\u0439 \u0435\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043d\u0435 \u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b\u0430 \u043b\u0438\u0447\u043d\u043e
    \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u0410\u0434\u0435\u043b\u044c. \u0412 \u043a\u043e\u043d\u0446\u0435
    1977 \u0433\u043e\u0434\u0430 \u0410\u0434\u0435\u043b\u044c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e
    \u0437\u0430\u0431\u043e\u043b\u0435\u043b\u0430 \u0438 \u043f\u043e\u043f\u0430\u043b\u0430
    \u0432 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0443 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432. \u041b\u0438\u0448\u0438\u0432\u0448\u0438\u0441\u044c
    \u0441\u0432\u043e\u0435\u0439 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \"\u0434\u0435\u0433\u0443\u0441\u0442\u0430\u0442\u043e\u0440\u0448\u0438\", \u0413\u0451\u0434\u0435\u043b\u044c
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b
    \u0435\u0441\u0442\u044c, \u0443\u043c\u0435\u0440\u0435\u0432 \u043e\u0442 \u0438\u0441\u0442\u043e\u0449\u0435\u043d\u0438\u044f
    \u0432 \u044f\u043d\u0432\u0430\u0440\u0435 1978 \u0433\u043e\u0434\u0430. \u041d\u0430
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u043d \u0432\u0435\u0441\u0438\u043b
    \u0432\u0441\u0435\u0433\u043e \u043e\u043a\u043e\u043b\u043e 29-30 \u043a\u0438\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0432."
