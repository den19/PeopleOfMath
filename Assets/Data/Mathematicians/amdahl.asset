  achievementsRu: "\u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C
    \u0438 \u0441\u0430\u043C\u044B\u043C \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u043D\u0430\u0443\u0447\u043D\u044B\u043C \u0432\u043A\u043B\u0430\u0434\u043E\u043C
    \u0414\u0436\u0438\u043D\u0430 \u0410\u043C\u0434\u0430\u043B\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0438\u043C \u0432 1967 \u0433\u043E\u0434\u0443 **\u0437\u0430\u043A\u043E\u043D
    \u0410\u043C\u0434\u0430\u043B\u0430** (Amdahl's Law). \u0412 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0438,
    \u044D\u0442\u043E \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0435
    \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043B\u0435\u0436\u0438\u0442
    \u0432 \u043E\u0441\u043D\u043E\u0432\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432\u0441\u0435\u0445 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0441\u0438\u0441\u0442\u0435\u043C \u2014 \u043E\u0442 \u043C\u043D\u043E\u0433\u043E\u044F\u0434\u0435\u0440\u043D\u044B\u0445
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u0432 \u0434\u043E
    \u0441\u0443\u043F\u0435\u0440\u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u0432. 
    ### \u0421\u0443\u0442\u044C \u0437\u0430\u043A\u043E\u043D\u0430 \u0410\u043C\u0434\u0430\u043B\u0430:
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0435
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 
    \u0412 1967 \u0433\u043E\u0434\u0443 \u043D\u0430 \u0412\u0435\u0441\u0435\u043D\u043D\u0435\u0439
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u043D\u043E\u0439 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u043E\u0439
    \u043A\u043E\u043D\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0438 \u0410\u043C\u0434\u0430\u043B
    \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u043F\u0440\u043E\u0441\u0442\u043E\u0435, \u043D\u043E \u043A\u0440\u0430\u0439\u043D\u0435
    \u0432\u0430\u0436\u043D\u043E\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435.
    \u041E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0440\u0430\u0441\u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435
    \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0439 \u0438\u043C\u0435\u0435\u0442
    \u0441\u0432\u043E\u0439 **\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043F\u0440\u0435\u0434\u0435\u043B**, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0442\u044C,
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044F \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u0432 .  \u0417\u0430\u043A\u043E\u043D
    \u0433\u043B\u0430\u0441\u0438\u0442: \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
    \u0437\u0430 \u0441\u0447\u0435\u0442 \u0440\u0430\u0441\u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F
    \u0435\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0439 \u043D\u0430
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435 \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u0435\u0439
    **\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043E** \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C,
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u043C \u0434\u043B\u044F
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0435\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0439 . \u0418\u043D\u044B\u043C\u0438
    \u0441\u043B\u043E\u0432\u0430\u043C\u0438, \u0431\u044B\u0441\u0442\u0440\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0432\u0441\u0435\u0439 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u0435\u0435 \u0441\u0430\u043C\u044B\u043C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u043C
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u043C \u2014 \u0442\u043E\u0439
    \u0447\u0430\u0441\u0442\u044C\u044E \u0437\u0430\u0434\u0430\u0447\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0430
    \u043D\u0430 \u0447\u0430\u0441\u0442\u0438 .  ### \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0437\u0430\u043A\u043E\u043D\u0430 
    \u0417\u0430\u043A\u043E\u043D \u0410\u043C\u0434\u0430\u043B\u0430 \u0438\u043C\u0435\u0435\u0442
    \u0441\u0442\u0440\u043E\u0433\u0443\u044E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0443. \u0415\u0441\u043B\u0438
    \u0432 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0435 \u0434\u043E\u043B\u044F
    \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    **\u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C\u0441\u044F
    \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E** (\u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C), \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    `\u03B1`, \u0430 \u0434\u043E\u043B\u044F \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0439,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0436\u043D\u043E \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
    \u0440\u0430\u0441\u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u0438\u0442\u044C,
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 `(1-\u03B1)`, \u0442\u043E
    \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435
    `S_p` \u043F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    `p` \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u0432 \u043D\u0435
    \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0435\u0432\u044B\u0441\u0438\u0442\u044C: 
    `S_p = 1 / (\u03B1 + (1-\u03B1)/p)`   ### \u041F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0438 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F  \u0417\u0430\u043A\u043E\u043D
    \u0410\u043C\u0434\u0430\u043B\u0430 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0434\u0432\u0430 \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u0445 \u043D\u0430
    \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435 \u0432\u044B\u0432\u043E\u0434\u0430: 
    1.  **\u0423\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435 \u0438\u043C\u0435\u0435\u0442
    \u043F\u043E\u0442\u043E\u043B\u043E\u043A.** \u041F\u0440\u0438 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u043C
    \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0438 \u0447\u0438\u0441\u043B\u0430
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u0432 (`p \u2192
    \u221E`) \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
    \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0441\u044F
    \u043A \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u0435 `1/\u03B1` . \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0435\u0441\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 25% (`\u03B1 = 0.25`),
    \u0442\u043E \u0434\u0430\u0436\u0435 \u043F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u0432 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435
    \u043D\u0435 \u043F\u0440\u0435\u0432\u044B\u0441\u0438\u0442 4 \u0440\u0430\u0437.
    2.  **\u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0440\u0435\u0437\u043A\u043E \u043F\u0430\u0434\u0430\u0435\u0442.** \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u0432 \u0434\u0430\u0435\u0442
    \u0432\u0441\u0435 \u043C\u0435\u043D\u044C\u0448\u0438\u0439 \u043F\u0440\u0438\u0440\u043E\u0441\u0442
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
    \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u043C,
    \u043F\u0440\u0438 \u0434\u043E\u043B\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u0432 25% \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    10 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u0432 \u0434\u0430\u0435\u0442
    \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435 \u0432\u0441\u0435\u0433\u043E
    \u0432 3,077 \u0440\u0430\u0437\u0430, \u0430 1000 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u0432
    \u2014 \u043B\u0438\u0448\u044C \u0432 3,988 \u0440\u0430\u0437\u0430 . \u042D\u0442\u043E
    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u0447\u0442\u043E
    \u043D\u0435 \u0434\u043B\u044F \u0432\u0441\u044F\u043A\u043E\u0439 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0438\u043C\u0435\u0435\u0442 \u0441\u043C\u044B\u0441\u043B \u043D\u0430\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u0435\u0439. 
    ### \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0438\u0434\u0435\u0438:
    \u0421\u0435\u0442\u0435\u0432\u043E\u0439 \u0437\u0430\u043A\u043E\u043D \u0410\u043C\u0434\u0430\u043B\u0430 
    \u0412\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0437\u0430\u043A\u043E\u043D \u0431\u044B\u043B \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D,
    \u0447\u0442\u043E\u0431\u044B \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C
    \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u0430\u0442\u0440\u0430\u0442\u044B
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443
    \u0434\u0430\u043D\u043D\u044B\u0445 \u043C\u0435\u0436\u0434\u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u0430\u043C\u0438,
    \u0447\u0442\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E
    \u0434\u043B\u044F \u0441\u0443\u043F\u0435\u0440\u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u0432
    \u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0445
    \u0441\u0438\u0441\u0442\u0435\u043C. \u042D\u0442\u0430 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    **\u0421\u0435\u0442\u0435\u0432\u043E\u0439 \u0437\u0430\u043A\u043E\u043D \u0410\u043C\u0434\u0430\u043B\u0430**.
    \u041E\u043D \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u0438
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u043C\u0435\u0436\u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043D\u044B\u0439
    \u043E\u0431\u043C\u0435\u043D \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043D\u0438\u0437\u0438\u0442\u044C
    \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435, \u043D\u043E \u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435,
    \u0447\u0435\u043C \u043D\u0430 \u043E\u0434\u043D\u043E\u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u0435 . \u041A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442
    \"\u0441\u0435\u0442\u0435\u0432\u043E\u0439 \u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0438\u0438\"
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043A\u0430\u043A \u043E\u0442 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0430
    \u0437\u0430\u0434\u0430\u0447\u0438, \u0442\u0430\u043A \u0438 \u043E\u0442
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A
    \u0441\u0435\u0442\u0438 .  ### \u0418\u0442\u043E\u0433\u043E\u0432\u043E\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435  \u0417\u0430\u043A\u043E\u043D
    \u0410\u043C\u0434\u0430\u043B\u0430 \u0441\u0442\u0430\u043B \u043A\u0440\u0430\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u043C
    \u043A\u0430\u043C\u043D\u0435\u043C \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u044B\u0445 \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0439.
    \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0430\u0435\u0442
    \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430\u043C \u0444\u043E\u0440\u043C\u0443\u043B\u0443
    \u0434\u043B\u044F \u0440\u0430\u0441\u0447\u0435\u0442\u0430, \u043E\u043D \u0441\u043C\u0435\u0449\u0430\u0435\u0442
    \u0444\u043E\u043A\u0443\u0441 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u0432
    \u0441 \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043D\u043E\u0433\u043E \u043D\u0430\u0440\u0430\u0449\u0438\u0432\u0430\u043D\u0438\u044F
    \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438 \u043D\u0430 **\u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044E
    \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u043E\u0432**, \u043F\u043E\u0434\u0447\u0435\u0440\u043A\u0438\u0432\u0430\u044F,
    \u0447\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0440\u0435\u0437\u0435\u0440\u0432
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043B\u0435\u0436\u0438\u0442 \u0432 \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0438\u0438
    \u0434\u043E\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u043E\u0434\u0430. \u042D\u0442\u043E\u0442 \u043F\u0440\u0438\u043D\u0446\u0438\u043F
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0438 \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u0432\u043F\u0435\u0440\u0435\u0434."
  achievementsEn: "Gene Myron Amdahl's contributions to computer science and engineering
    are profound, spanning both theoretical breakthroughs and the practical creation
    of industry-defining hardware. His legacy is built on two main pillars: the formulation
    of **Amdahl's Law**, a fundamental limit of parallel computing, and his architectural
    leadership on the **IBM System/360**, which set the standard for mainframe computing
    for decades.  ### \U0001F4DC The Formulation of Amdahl's Law (1967)  The most
    enduring of Amdahl's contributions is the observation now known as **Amdahl's
    Law**. He presented this concept at the American Federation of Information Processing
    Societies (AFIPS) Spring Joint Computer Conference in 1967.  *   **Core Principle**:
    The law states that the maximum possible speedup of a program when parallelized
    is fundamentally limited by the portion of the code that must execute sequentially
    and cannot be parallelized. In essence, no matter how many processors you add,
    the program's speed will always be constrained by its serial part. *   **The
    Mathematical Model**: If `p` is the fraction of a program that can be parallelized,
    and `(1-p)` is the inherently serial fraction, the theoretical speedup `S` using
    `N` processors is given by the formula:     **`S = 1 / ((1-p) + p/N)`** *   **Practical
    Implications**: The law has several crucial consequences for software and hardware
    design:     *   **Diminishing Returns**: The speedup from adding more processors
    diminishes quickly. For example, even if 95% of a program is parallelizable,
    the speedup is still limited to a factor of 20, regardless of the number of processors.    
    *   **Focus on the Bottleneck**: It shifts the focus of performance optimization
    toward identifying and reducing the \"unparallelizable\" serial parts of a program.
    According to the law, optimizing the parallel portion has a limited effect if
    the serial portion remains large.     *   **Problem Size Caveat**: The law is
    based on a fixed problem size. This is an important distinction later addressed
    by Gustafson's Law, which observes that with more processors, programmers tend
    to scale up the problem size, effectively increasing the parallelizable portion
    of the work.  ### \U0001F3D7\uFE0F Practical Achievements in Computer Architecture 
    While Amdahl's Law is a cornerstone of theoretical computer science, his practical
    work at IBM resulted in the machines that powered the industry for a generation. 
    #### The IBM System/360 (1964)  This project is considered one of the most significant
    turning points in computing history. As the chief architect of the System/360
    family, Amdahl was responsible for its revolutionary design.  *   **A Unified
    Family**: The System/360 was not one computer but a **compatible family of machines**.
    They ranged from small business systems to large scientific mainframes, but all
    could run the same software. This was a radical departure from previous models
    where each machine was incompatible. *   **The \"Father\" of a Revolution**:
    Thomas J. Watson Jr., then IBM's chairman, publicly named Amdahl the \"father\"
    of the new computer at the 1964 shareholders' meeting. *   **Enduring Legacy**:
    The architecture he helped design was so successful that it remains foundational
    to IBM's modern System Z mainframes, which can still run applications written
    for the System/360. This compatibility has generated billions of dollars in revenue
    for decades. His ability to maintain architectural consistency across multiple
    engineering teams was described as a feat of \"sheer intellectual force\" by
    project manager Fred Brooks.  #### Early IBM Innovations (1950s)  Before the
    System/360, Amdahl made significant contributions to early computing as the chief
    design engineer for the **IBM 704**. This machine was groundbreaking for incorporating
    **floating-point hardware** and employing an **index register**, which were novel
    features at the time. It was also the platform for which the high-level programming
    language **FORTRAN** was first developed.  ### \U0001F4DA Key Publications and
    Written Works  Amdahl's ideas are recorded in several pivotal publications. His
    most famous paper, where he first articulated Amdahl's Law, is:  *   **\"Validity
    of the single processor approach to achieving large scale computing capabilities\"**
    (1967). This paper was presented at the AFIPS Spring Joint Computer Conference
    and contains his famous arguments on the limits of parallel processing.  He was
    also the lead author on seminal papers detailing the IBM System/360 architecture: 
    *   **\"Architecture of the IBM System/360\"** (1964, with G. Blaauw and F. P.
    Brooks Jr.). *   **\"The Structure of SYSTEM/360 Part III: Processing Unit Design
    Considerations\"** (1964).  His other works include papers on high-performance
    computing concepts and reflections on early computer development.  ### \U0001F3C5
    Recognition and Awards  Amdahl's contributions were widely recognized by his
    peers and the industry:  *   **IBM Fellow** (1965) *   **Member of the National
    Academy of Engineering** (1967) *   **ACM/IEEE Eckert-Mauchly Award** (1987)
    for outstanding innovations in computer architecture, including pipelining, instruction
    lookahead, and cache memory *   **IEEE Computer Society Harry H. Goode Memorial
    Award** (1983) *   **Fellow of the Computer History Museum** (1998) for his fundamental
    work in computer architecture, design, project management, and leadership  In
    summary, Gene Amdahl's work provides a link between theoretical limits and practical
    engineering. His law guides the fundamental understanding of parallel performance,
    while the computers he designed set a standard for reliability and compatibility
    that is still influential in enterprise computing today."
  personalLifeRu: "\u0414\u0436\u0438\u043D \u041C\u0430\u0439\u0440\u043E\u043D
    \u0410\u043C\u0434\u0430\u043B (Gene Myron Amdahl) \u043F\u0440\u043E\u0436\u0438\u043B
    \u0434\u043E\u043B\u0433\u0443\u044E \u0438 \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u0443\u044E
    \u0436\u0438\u0437\u043D\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0431\u044B\u043B\u0430
    \u043D\u0435\u0440\u0430\u0437\u0440\u044B\u0432\u043D\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u0430
    \u0441 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0438. \u0415\u0433\u043E \u043F\u0443\u0442\u044C
    \u043E\u0442 \u0441\u043A\u0440\u043E\u043C\u043D\u043E\u0439 \u0444\u0435\u0440\u043C\u044B
    \u0432 \u042E\u0436\u043D\u043E\u0439 \u0414\u0430\u043A\u043E\u0442\u0435 \u0434\u043E
    \u0432\u0435\u0440\u0448\u0438\u043D \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0439
    \u043C\u044B\u0441\u043B\u0438 \u0438 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438
    \u043F\u043E\u043B\u043E\u043D \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445
    \u0434\u0435\u0442\u0430\u043B\u0435\u0439.  ### \U0001F476 \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0438 \u0440\u0430\u043D\u043D\u0438\u0435 \u0433\u043E\u0434\u044B  \u0414\u0436\u0438\u043D
    \u0410\u043C\u0434\u0430\u043B \u0440\u043E\u0434\u0438\u043B\u0441\u044F **16
    \u043D\u043E\u044F\u0431\u0440\u044F 1922 \u0433\u043E\u0434\u0430** \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C
    \u0433\u043E\u0440\u043E\u0434\u043A\u0435 **\u0424\u043B\u0430\u043D\u0434\u0440\u043E,
    \u042E\u0436\u043D\u0430\u044F \u0414\u0430\u043A\u043E\u0442\u0430** . \u0415\u0433\u043E
    \u0441\u0435\u043C\u044C\u044F \u0438\u043C\u0435\u043B\u0430 \u043D\u043E\u0440\u0432\u0435\u0436\u0441\u043A\u0438\u0435
    \u0438 \u0448\u0432\u0435\u0434\u0441\u043A\u0438\u0435 \u043A\u043E\u0440\u043D\u0438
    \u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C \u0444\u0435\u0440\u043C\u0435\u0440\u0441\u0442\u0432\u043E\u043C.
    \u0414\u0435\u0442\u0441\u0442\u0432\u043E \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430 \u043F\u0440\u043E\u0448\u043B\u043E
    \u0432 \u043E\u0447\u0435\u043D\u044C \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u041E\u043D \u0445\u043E\u0434\u0438\u043B
    \u0432 \u0448\u043A\u043E\u043B\u0443, \u0433\u0434\u0435 \u0431\u044B\u043B\u0430
    \u0432\u0441\u0435\u0433\u043E \u043E\u0434\u043D\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0430,
    \u0430 \u0432 \u0434\u043E\u043C\u0435 **\u043D\u0435 \u0431\u044B\u043B\u043E
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430**
    \u0432\u043F\u043B\u043E\u0442\u044C \u0434\u043E \u0435\u0433\u043E \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u043E\u0432\u044B\u0445
    \u043B\u0435\u0442, \u043A\u043E\u0433\u0434\u0430 \u0432 \u043E\u043A\u0440\u0443\u0433\u0435
    \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043F\u0440\u043E\u0432\u0435\u043B\u0438
    \u0441\u0435\u043B\u044C\u0441\u043A\u0443\u044E \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044E
    .  ### \U0001F393 \u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438 \u043D\u0430\u0447\u0430\u043B\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u044B 
    \u041F\u043E\u0441\u043B\u0435 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044F
    \u043D\u0430 \u041F\u0435\u0440\u043B-\u0425\u0430\u0440\u0431\u043E\u0440 \u0432
    1941 \u0433\u043E\u0434\u0443 \u0410\u043C\u0434\u0430\u043B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
    \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0435\u043C
    \u0432 \u0430\u0440\u043C\u0438\u044E, \u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u043E\u0442\u043A\u0430\u0437, \u0442\u0430\u043A \u043A\u0430\u043A \u0435\u0433\u043E
    \u043D\u0430\u0432\u044B\u043A\u0438 \u0444\u0435\u0440\u043C\u0435\u0440\u0430
    \u0441\u043E\u0447\u043B\u0438 \u0431\u043E\u043B\u0435\u0435 \u0432\u0430\u0436\u043D\u044B\u043C\u0438
    \u0434\u043B\u044F \u0441\u0442\u0440\u0430\u043D\u044B . \u041F\u043E\u0437\u0436\u0435,
    \u0432 1944 \u0433\u043E\u0434\u0443, \u043E\u043D \u0432\u0441\u0435 \u0436\u0435
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0430 \u0441\u043B\u0443\u0436\u0431\u0443
    \u0432 **\u0412\u043E\u0435\u043D\u043D\u043E-\u043C\u043E\u0440\u0441\u043A\u043E\u0439
