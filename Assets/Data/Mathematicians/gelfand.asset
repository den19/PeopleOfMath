    \u0435\u0433\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c\u0438.
    \u0422\u0430\u043a, \u0432 1932 \u0433\u043e\u0434\u0443, 19-\u043b\u0435\u0442\u043d\u0438\u0439
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434, \u043d\u0435 \u0438\u043c\u0435\u044f
    \u0434\u0430\u0436\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f,
    \u0441\u0442\u0430\u043b \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u043c \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0430
    \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u041c\u0413\u0423.\n\n\U0001F3AD \u00ab\u041c\u043e\u0446\u0430\u0440\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb
    \u0438 \u0435\u0433\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043f\u043e\u0434\u043e\u0431\u043d\u0430
