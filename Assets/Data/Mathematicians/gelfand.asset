    \u0438\u043d\u043e\u0435 \u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435.
    \u0412\u0435\u043b\u0438\u043a\u0438\u043c \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u043e\u043c
    \u0435\u0433\u043e \u0434\u0435\u043b\u0430\u044e\u0442 \u0432\u0441\u044f \u0441\u043e\u0432\u043e\u043a\u0443\u043f\u043d\u043e\u0441\u0442\u044c
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442 \u0438 \u0438\u0445 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0435
    \u0432\u0435\u043b\u0438\u043a\u043e\u043b\u0435\u043f\u0438\u0435\u00bb.\n\n\U0001F4AC
    \u041b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0439 \u0441\u0435\u043c\u0438\u043d\u0430\u0440:
    \u0442\u0435\u0430\u0442\u0440 \u043e\u0434\u043d\u043e\u0433\u043e \u0430\u043a\u0442\u0435\u0440\u0430
    \u0412 1943 \u0433\u043e\u0434\u0443 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0441\u044f
    \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u043b\u0432\u0435\u043a\u0430 \u0432 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438
    1408 \u043d\u0430 14-\u043c \u044d\u0442\u0430\u0436\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e
    \u0437\u0434\u0430\u043d\u0438\u044f \u041c\u0413\u0423. \u0410\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430
    \u0442\u0430\u043c \u0431\u044b\u043b\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439
    \u0438 \u043e\u0447\u0435\u043d\u044c \u0436\u0435\u0441\u0442\u043a\u043e\u0439: \u0420\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u043e
    \u0438 \u0442\u0438\u0440\u0430\u043d\u0438\u044f: \u0421\u0442\u0443\u0434\u0435\u043d\u0442\u044b
    \u0438 \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u0438 \u0438\u043c\u0435\u043b\u0438
    \u0440\u0430\u0432\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0430 \u0441 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430\u043c\u0438,
    \u043d\u043e \u00ab\u0434\u0438\u043a\u0442\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0439\u00bb
    \u0441\u0442\u0438\u043b\u044c \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u0430
    \u0431\u044b\u043b \u0431\u0435\u0437\u0436\u0430\u043b\u043e\u0441\u0442\u043d\u044b\u043c.
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u043c\u043e\u0433 \u043f\u0440\u0435\u0440\u0432\u0430\u0442\u044c
    \u0434\u043e\u043a\u043b\u0430\u0434\u0447\u0438\u043a\u0430 \u0447\u0435\u0440\u0435\u0437
    \u043f\u044f\u0442\u044c \u043c\u0438\u043d\u0443\u0442, \u0437\u0430\u044f\u0432\u0438\u0432,
    \u0447\u0442\u043e \u0442\u043e\u0442 \u043d\u0435\u0441\u0435\u0442 \u0447\u0443\u0448\u044c,
    \u0438 \u0441\u0430\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c, \u00ab\u043a\u0430\u043a
    \u043d\u0430\u0434\u043e\u00bb. \u0422\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430
    \u0433\u0435\u043d\u0438\u0435\u0432: \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u043d
    \u043f\u0440\u0435\u0440\u0432\u0430\u043b \u0434\u043e\u043a\u043b\u0430\u0434 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u043a \u0441\u0438\u0434\u0435\u0432\u0448\u0435\u043c\u0443 \u0432 \u0437\u0430\u043b\u0435
    \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u0443 \u041c\u0430\u043a\u0441\u0438\u043c\u0443
    \u041a\u043e\u043d\u0446\u0435\u0432\u0438\u0447\u0443 \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b,
    \u043a\u0430\u043a \u043d\u0430\u0434\u043e \u0440\u0435\u0448\u0430\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0443.
    \u041d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043d\u0435\u0434\u0435\u043b\u0435
    \u044d\u0442\u043e\u0442 \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a \u0441\u0434\u0435\u043b\u0430\u043b
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439 \u0434\u043e\u043a\u043b\u0430\u0434
    \u043d\u0430 \u0442\u0443 \u0436\u0435 \u0442\u0435\u043c\u0443. \u041c\u0430\u043a\u0441\u0438\u043c
    \u041a\u043e\u043d\u0446\u0435\u0432\u0438\u0447 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438. \u00ab\u0413\u043b\u0430\u0432\u043d\u0430\u044f \u0441\u0438\u043d\u0430\u0433\u043e\u0433\u0430\u00bb:
    \u0421\u0435\u043c\u0438\u043d\u0430\u0440 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u043c \u0446\u0435\u043d\u0442\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u0447\u0442\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u043b \u043c\u043e\u043b\u043e\u0434\u043e\u043c\u0443
    \u0443\u0447\u0435\u043d\u043e\u043c\u0443, \u043f\u043e\u0442\u0435\u0440\u044f\u0432\u0448\u0435\u043c\u0443\u0441\u044f
    \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u0430\u0445:
    \u00ab\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u0441\u0435\u043c\u0438\u043d\u0430\u0440
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430. \u0415\u0441\u043b\u0438 \u0445\u043e\u0434\u0438\u0448\u044c
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u043e\u043b\u0438\u0442\u044c\u0441\u044f,
    \u0442\u043e \u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0432 \u0433\u043b\u0430\u0432\u043d\u043e\u0439
    \u0441\u0438\u043d\u0430\u0433\u043e\u0433\u0435\u00bb.\n\n\U0001F9EC \u0414\u0432\u0430
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430: \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0431\u0438\u043e\u043b\u043e\u0433 \u0412 \u043d\u0430\u0447\u0430\u043b\u0435
    1960-\u0445 \u0433\u043e\u0434\u043e\u0432, \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0441\u044b\u043d\u0430 \u043e\u0442 \u043b\u0435\u0439\u043a\u0435\u043c\u0438\u0438,
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u043d\u0430\u0447\u0430\u043b \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044e
    \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443. \u0415\u0433\u043e \u0443\u0441\u043f\u0435\u0445\u0438
    \u0431\u044b\u043b\u0438 \u0441\u0442\u043e\u043b\u044c \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b,
    \u0447\u0442\u043e \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u043c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435
    \u0434\u043e\u043b\u0433\u043e \u0445\u043e\u0434\u0438\u043b\u0430 \u0448\u0443\u0442\u043a\u0430,
    \u0431\u0443\u0434\u0442\u043e \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434-\u0431\u0438\u043e\u043b\u043e\u0433
    \u2014 \u044d\u0442\u043e \u0434\u0432\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u043c
    \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u043e\u0434\u0438\u043d
    \u0443\u0447\u0435\u043d\u044b\u0439 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c
    \u0441\u0442\u043e\u043b\u044c \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u043e\u043c
    \u0432 \u0442\u0430\u043a\u0438\u0445 \u0434\u0430\u043b\u0435\u043a\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445.\n\n\U0001F331
    \u041f\u0440\u043e\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043b\u044c \u0438 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u0447\u0435\u043d\u044b\u043c, \u043d\u043e \u0438 \u0432\u0435\u043b\u0438\u043a\u0438\u043c
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u043c. \u0412 1964 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0412\u0441\u0435\u0441\u043e\u044e\u0437\u043d\u0443\u044e
    \u0437\u0430\u043e\u0447\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 (\u0412\u0417\u041c\u0428), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u0430\u043b\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0441\u043e\u0442\u043d\u044f\u043c \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0445
    \u0434\u0435\u0442\u0435\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043e\u0442\u0434\u0430\u043b\u0435\u043d\u043d\u044b\u0445
    \u0443\u0433\u043e\u043b\u043a\u043e\u0432 \u0421\u0421\u0421\u0420 \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0443 \u043b\u0443\u0447\u0448\u0438\u0445
    \u043c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432
    \u043f\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435. \u041c\u043d\u043e\u0433\u0438\u0435
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442, \u0447\u0442\u043e \u0435\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0441\u0442\u0440\u0430\u043d\u0435
    \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u0443
    \u0432\u0441\u0435\u0445 \u044d\u043b\u0438\u0442\u043d\u044b\u0445 \u0441\u043f\u0435\u0446\u0448\u043a\u043e\u043b
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0432\u0437\u044f\u0442\u044b\u0445.\n\n\U0001F3DB\ufe0f
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u043a \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u043e\u0439
    \u0438 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u041d \u0421\u0421\u0421\u0420 \u0432 1953 \u0433\u043e\u0434\u0443, \u043d\u043e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 1984-\u043c, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 71 \u0433\u043e\u0434\u0430.
    \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439
    \u0441 1964 \u0433\u043e\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0441\u0442\u0430\u043b \u0443\u0447\u0435\u043d\u044b\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f. \u041c\u043d\u043e\u0433\u0438\u0435
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u043b\u0438 \u044d\u0442\u0443 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0443
    \u043a\u0430\u043a \u0441 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c\u043e\u043c, \u0442\u0430\u043a
    \u0438 \u0441 \u0435\u0433\u043e \u0441\u043b\u043e\u0436\u043d\u044b\u043c, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u043c
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c. \u041f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u0437\u0430 \u0440\u0443\u0431\u0435\u0436\u043e\u043c \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0439
    \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d \u043d\u0430\u043c\u043d\u043e\u0433\u043e
    \u0440\u0430\u043d\u044c\u0448\u0435. \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0431\u044b\u043b
    \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u043c \u0434\u043e\u043a\u0442\u043e\u0440\u043e\u043c
    \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0430, \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0430,
    \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u044b \u0438 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u043e\u0432
    \u043c\u0438\u0440\u0430, \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439 \u043d\u0430\u0443\u043a, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041f\u0440\u0435\u043c\u0438\u044e
    \u0412\u043e\u043b\u044c\u0444\u0430 \u0438 \u00ab\u0433\u0440\u0430\u043d\u0442 \u0434\u043b\u044f
    \u0433\u0435\u043d\u0438\u0435\u0432\u00bb \u041c\u0430\u043a\u0430\u0440\u0442\u0443\u0440\u0430.\n\n\U0001F33F
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0412 1989 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432\u044b\u0435\u0437\u0434\u0430, \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0421\u0428\u0410, \u0433\u0434\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u0420\u0430\u0442\u0433\u0435\u0440\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438, \u043d\u0430\u0447\u0438\u043d\u0430\u044f
    \u0441 1994 \u0433\u043e\u0434\u0430, \u043e\u043d \u0438 \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u044f
    \u0441\u0442\u0430\u043b\u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c\u0438
    \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0446\u0430\u043c\u0438, \u0430
    \u0441 2000 \u0433\u043e\u0434\u0430 \u2014 \u0432\u0435\u0433\u0430\u043d\u0430\u043c\u0438."
  interestingFactsEn: "Israel's life in Helphand is full of incredible stories that make its identity truly legendary, and these are the most interesting and illustrative facts from his biography.\n\nFrom wardrobe to genius, the most famous fact of Helphand's biography is his incredible journey to science. At the age of 16, with only nine grades behind his shoulders, he came to Moscow from the Ukrainian location of the Window, where he was not accepted because of the lack of a certificate, and he took a wardrobe to the Lenin Library to have access to books and to survive.\n\n♪ The meeting that once made a decision in the library of a young man reading complex mathematical work noticed the great mathematician Andrei Nikolaevich Colmogorov. The professor gave him several tasks to test his knowledge and left. When Kolmogorov returned, he not only solved all the problems, but also one of them, the impossible at the time, decided in an extraordinaryly elegant way. > It is important: This story is one of the most famous legends about Helfand.He himself said he didn't remember whether or not he had solved the problem, but admitted that Kolmogorov was shocked by his abilities, for example, in 1932, 19-year-old Helfand, without even secondary education, became a graduate student of Kolmogorov and a teacher of the MGU.\n\n♪ The Mozart of Mathematics and his unique comparison of Gelfand thought that math was like music, and every scientist could be compared to a certain composer. He saw himself as Mozart because, according to him, \"We love Mozart not for any of his works. The great composers make him all of his works and their greatness.\"\n\nLegendary seminar: The theatre of an actor in 1943, Gelfand founded his famous math seminar, which was held for almost half a century in room 1408 on the 14th floor of the main building of the MGU. The atmosphere was unique and very rigid: Equality and tyranny: Students and students had equal rights with academics, but the \"dictator\" style of the seminar was ruthless.Helfand could have interrupted the speaker five minutes later, saying he was talking nonsense and explaining himself \"how to do.\" The geniuses' training: he once interrupted a report from a well-known scientist, turned to the student who was sitting in the room, Maxim Kontević, and explained how to solve the problem, and the next week, the student made a brilliant report on the same subject.Maxim Kontevich later became one of the greatest mathematicians of our time, the winner of the Fields Prize. \"Major synagogue\": The Seminar was such an important center of mathematical life that a famous mathematician advised a young scientist lost in other seminars: \"Try the Helphand seminar. If you go to math seminars just pray, do it in the main synagogue.\"\n\nTwo Helphandas: a mathematician and a biologist in the early 1960s, after his son died of leukaemia, he began to study biology and medicine actively, and his achievements were so significant that there was a long-term joke in the scientific community, that he was a Geland Mathematician and a Helphand Biologist, two different people, so incredible that one scientist could be such a deep professional in such distant fields.\n\nIn 1964, he created the All-Union Internial Mathematical School (UMMS), which enabled hundreds of talented children from the most distant corners of the USSR to study mathematics from the best Moscow correspondence professors, and many believe that its influence on mathematics education in the country was greater than that of all elite special schools combined.\n\nThe academic was delayed and worldwide recognized by Helfand as a member of the Soviet Union's ANA in 1953, but the actual academic was only elected in 1984, at the age of 71, the first time since 1964, when the academic mathematician became a Jewish scientist, many of whom linked the delay to both State anti-Semitism and its complex, independent nature.He was recognized abroad as a genius, and he was an honorary doctor of Oxford, Harvard, Sorbonne and other leading universities in the world, a foreign member of many academies of science, and a winner of the most prestigious awards, including the Wolf Award and the MacArthur Geniuse Grant.\n\nIn 1989, after having the opportunity to leave, Gelfand moved to the United States, where he continued to work at the University of Rutger, and in the last years of his life since 1994, he and his family became convinced vegetarians and vegans since 2000."
