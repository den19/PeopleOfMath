  achievementsRu: "\u0418\u0437\u0440\u0430\u0438\u043b\u044c \u041c\u043e\u0438\u0441\u0435\u0435\u0432\u0438\u0447
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c, \u0447\u044c\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e \u043e\u0431\u043b\u0438\u043a \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043f\u0440\u043e\u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0441\u044f
    \u043e\u0442 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0434\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b,
    \u0438 \u0435\u0433\u043e \u0438\u043c\u044f \u0443\u0432\u0435\u043a\u043e\u0432\u0435\u0447\u0435\u043d\u043e
    \u0432 \u0434\u0435\u0441\u044f\u0442\u043a\u0430\u0445 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c \u0438 \u043f\u043e\u043d\u044f\u0442\u0438\u0439.
    \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0432\u043a\u043b\u0430\u0434\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443:\n\n\U0001F9EC
    \u0413\u043b\u0443\u0431\u0438\u043d\u043d\u0430\u044f \u043e\u0441\u043d\u043e\u0432\u0430:
    \u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0441 \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u2014 \u0440\u0430\u0437\u0434\u0435\u043b\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0435\u0433\u043e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430. \u0415\u0433\u043e
    \u0440\u0430\u043d\u043d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0446\u0435\u043b\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u044d\u0442\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u0422\u0435\u043e\u0440\u0438\u044f \u0431\u0430\u043d\u0430\u0445\u043e\u0432\u044b\u0445
    \u0430\u043b\u0433\u0435\u0431\u0440 (\u043d\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u043a\u043e\u043b\u0435\u0446): \u042d\u0442\u043e \u0431\u044b\u043b \u0435\u0433\u043e
    \u043f\u0435\u0440\u0432\u044b\u0439 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u043f\u0440\u043e\u0440\u044b\u0432
    \u0432 \u043a\u043e\u043d\u0446\u0435 1930-\u0445 \u2014 \u043d\u0430\u0447\u0430\u043b\u0435
    1940-\u0445 \u0433\u043e\u0434\u043e\u0432. \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0441\u0442\u0440\u043e\u0439\u043d\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u044b\u0445
    \u0431\u0430\u043d\u0430\u0445\u043e\u0432\u044b\u0445 \u0430\u043b\u0433\u0435\u0431\u0440,
    \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0443\u044e \u0432\u043e\u043a\u0440\u0443\u0433
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0434\u0435\u0430\u043b\u043e\u0432. \u042d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u043f\u0440\u043e\u0441\u0442\u0438\u0442\u044c \u0438 \u043e\u0431\u043e\u0431\u0449\u0438\u0442\u044c
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0412\u0438\u043d\u0435\u0440\u0430, \u043d\u043e \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f \u0433\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u2014 \u043c\u043e\u0449\u043d\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0432\u044f\u0437\u0430\u043b \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0441 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u043c\u0438
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043e
    \u043f\u0435\u0440\u0432\u044b\u043c \u0442\u0440\u0438\u0443\u043c\u0444\u043e\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0422\u0435\u043e\u0440\u0438\u044f C-\u0430\u043b\u0433\u0435\u0431\u0440:
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u041c.\u0410. \u041d\u0430\u0439\u043c\u0430\u0440\u043a\u043e\u043c \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b
    \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u0439 \u0448\u0430\u0433 \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 C-\u0430\u043b\u0433\u0435\u0431\u0440, \u0434\u043e\u043a\u0430\u0437\u0430\u0432
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430-\u041d\u0430\u0439\u043c\u0430\u0440\u043a\u0430
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u0432 GNS-\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e
    (\u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430-\u041d\u0430\u0439\u043c\u0430\u0440\u043a\u0430-\u0421\u0438\u0433\u0430\u043b\u0430).
    \u042d\u0442\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0441\u0442\u0430\u043b\u0438
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.\n\n\U0001FA9E \u041c\u043e\u0441\u0442
    \u0432 \u0444\u0438\u0437\u0438\u043a\u0443: \u0422\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    \u0438 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445, \u043a\u0442\u043e \u043e\u0441\u043e\u0437\u043d\u0430\u043b
    \u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u044f\u0437\u044b\u043a, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u043a\u0430
    \u043c\u043e\u0433\u0443\u0442 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043d\u0430
    \u0440\u0430\u0432\u043d\u044b\u0445. \u0422\u0435\u043e\u0440\u0438\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u0445
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0433\u0440\u0443\u043f\u043f
    \u041b\u0438: \u042d\u0442\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0435\u0433\u043e
    \u0441\u0430\u043c\u043e\u0435 \u0432\u0430\u0436\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435.
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f
    \u041b\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u043c\u0435\u0435\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0445
    \u0447\u0430\u0441\u0442\u0438\u0446. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u043d\u0430\u0434 \u0441\u0445\u0435\u043c\u0430\u043c\u0438 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430-\u0426\u0435\u0442\u043b\u0438\u043d\u0430
    (Gelfand\u2013Tsetlin patterns) \u0441\u0442\u0430\u043b\u0430 \u0448\u0438\u0440\u043e\u043a\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435.
    \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 (\u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0439):
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0438 \u0413.\u0415. \u0428\u0438\u043b\u043e\u0432
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b\u0438 \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0448\u0435\u0441\u0442\u0438\u0442\u043e\u043c\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u00ab\u041e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\u00bb
    (1958-1968 \u0433\u0433.), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u043e\u0439
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0438
    \u0444\u0438\u0437\u0438\u043a\u043e\u0432 \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435.
    \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0440\u0430\u0437\u0432\u0438\u043b \u0442\u0435\u043e\u0440\u0438\u044e, \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043d\u0443\u044e
    \u041b\u043e\u0440\u0430\u043d\u043e\u043c \u0428\u0432\u0430\u0440\u0446\u0435\u043c, \u0438
    \u0441\u0434\u0435\u043b\u0430\u043b \u0435\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447.\n\n\U0001F9E9 \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u044f,
    \u0440\u0430\u0437\u0431\u0440\u043e\u0441\u0430\u043d\u043d\u044b\u0435 \u043f\u043e \u0432\u0441\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0421\u043f\u0438\u0441\u043e\u043a
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432,
    \u043d\u043e\u0441\u044f\u0449\u0438\u0445 \u0438\u043c\u044f \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430,
    \u043e\u0433\u0440\u043e\u043c\u0435\u043d \u0438 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0443\u044e \u0448\u0438\u0440\u043e\u0442\u0443
    \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b \u044d\u0442\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u0432 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443, \u043e\u0431\u043e\u0431\u0449\u0438\u0432
    \u0438\u0434\u0435\u0438 \u0420\u0430\u0434\u043e\u043d\u0430. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432 \u044d\u0442\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438
    \u0441\u0442\u0430\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439 \u0438 \u043f\u043e\u0437\u0438\u0442\u0440\u043e\u043d\u043d\u043e-\u044d\u043c\u0438\u0441\u0441\u0438\u043e\u043d\u043d\u043e\u0439
    \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u0438 (\u041a\u0422 \u0438 \u041f\u042d\u0422).
    \u0422\u0435\u043e\u0440\u0438\u044f \u0441\u043e\u043b\u0438\u0442\u043e\u043d\u043e\u0432
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0435\u043c\u044b\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b:
    \u041e\u043d \u0432\u043d\u0435\u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445
    \u0432\u043e\u043b\u043d (\u0441\u043e\u043b\u0438\u0442\u043e\u043d\u043e\u0432), \u0432
    \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430-\u0414\u0438\u043a\u043e\u0433\u043e
    (Gelfand\u2013Dikii equations). \u041a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438
    \u0430\u043b\u0433\u0435\u0431\u0440 \u041b\u0438: \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0414.\u0411. \u0424\u0443\u043a\u0441\u043e\u043c \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440 \u041b\u0438 \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0445
    \u043f\u043e\u043b\u0435\u0439 (\u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430-\u0424\u0443\u043a\u0441\u0430),
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0432\u0430\u0436\u043d\u044b\u043c \u0448\u0430\u0433\u043e\u043c
    \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438.
    \u041e\u0431\u0440\u0430\u0442\u043d\u044b\u0435 \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438: \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u043d\u0430\u0434 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439
    \u0428\u0442\u0443\u0440\u043c\u0430-\u041b\u0438\u0443\u0432\u0438\u043b\u043b\u044f (\u0442\u0435\u043e\u0440\u0438\u044f
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430-\u041b\u0435\u0432\u0438\u0442\u0430\u043d\u0430)
    \u043d\u0430\u0448\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u0438\u044f.
    \u0420\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430-\u041a\u0438\u0440\u0438\u043b\u043b\u043e\u0432\u0430:
    \u042d\u0442\u043e\u0442 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0434\u043b\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u0445
    \u0430\u043b\u0433\u0435\u0431\u0440. \u0414\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438:
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0442\u0430\u043a\u0436\u0435 \u0432\u043d\u0435\u0441
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u0443\u044e
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e, \u0442\u0435\u043e\u0440\u0438\u044e
    \u0433\u0438\u043f\u0435\u0440\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u043d\u0435\u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u0443\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443.\n\n\U0001F9EA \u041e\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043a \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0435
    \u0412\u043a\u043b\u0430\u0434 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430 \u043d\u0435
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0441\u044f \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439. \u041b\u0438\u0447\u043d\u0430\u044f
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f (\u0441\u043c\u0435\u0440\u0442\u044c \u0441\u044b\u043d\u0430
    \u043e\u0442 \u043b\u0435\u0439\u043a\u0435\u043c\u0438\u0438) \u043f\u043e\u0434\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430
    \u0435\u0433\u043e \u043a \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044f: \u041e\u043d \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043b
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0435\u043c\u0438\u043d\u0430\u0440
    \u0438 \u043c\u0435\u0436\u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0441\u043a\u0443\u044e
    \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044e \u0432 \u041c\u0413\u0423,
    \u0433\u0434\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c\u0438
    \u043d\u0435\u0439\u0440\u043e\u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0438,
    \u043a\u043b\u0435\u0442\u043e\u0447\u043d\u043e\u0439 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0438. \u0415\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0441\u044f
    \u0432 \u043f\u043e\u0438\u0441\u043a\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440 \u0432 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430\u0445, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a
    \u043c\u043e\u0440\u0444\u043e\u0433\u0435\u043d\u0435\u0437 \u043a\u043b\u0435\u0442\u043e\u043a
    \u0438\u043b\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438.
    \u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430:
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e
    \u043f\u0440\u0438\u0432\u0435\u043b\u0430 \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432 \u0434\u043b\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439
    \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u041a\u0440\u043e\u043c\u0435
    \u0442\u043e\u0433\u043e, \u043e\u043d \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438, \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044f
    \u00ab\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0433\u0440\u044b\u00bb \u2014 \u043c\u0435\u0442\u043e\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.\n\n\U0001F9D1\u200d\U0001F3EB \u041f\u0435\u0434\u0430\u0433\u043e\u0433
    \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u0448\u043a\u043e\u043b \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0447\u0435\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u043c
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u041e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u044d\u0442\u043e \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043d\u0443\u0436\u043d\u043e \u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u0441\u043e
    \u0432\u0441\u0435\u043c\u0438. \u041b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0439
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440: \u0415\u0433\u043e \u0441\u0435\u043c\u0438\u043d\u0430\u0440
    \u0432 \u041c\u0413\u0423, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0441\u044f
    \u043d\u0430 14-\u043c \u044d\u0442\u0430\u0436\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e
    \u0437\u0434\u0430\u043d\u0438\u044f \u043f\u043e\u0447\u0442\u0438 50 \u043b\u0435\u0442,
    \u0441\u0442\u0430\u043b \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u043f\u0440\u0438\u0442\u044f\u0436\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432. \u041d\u0430 \u043d\u0435\u043c
    \u0446\u0430\u0440\u0438\u043b\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430,
    \u0438 \u0432\u0435\u043b\u0438\u043a\u0438\u0435 \u0443\u0447\u0435\u043d\u044b\u0435 \u043e\u0431\u0449\u0430\u043b\u0438\u0441\u044c
    \u0441\u043e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c\u0438 \u043d\u0430 \u0440\u0430\u0432\u043d\u044b\u0445.
    \u0412\u0441\u0435\u0441\u043e\u044e\u0437\u043d\u0430\u044f \u0437\u0430\u043e\u0447\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0448\u043a\u043e\u043b\u0430
    (\u0412\u0417\u041c\u0428): \u0412 1964 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u044d\u0442\u0443 \u0448\u043a\u043e\u043b\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u0430\u043b\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0442\u044b\u0441\u044f\u0447\u0430\u043c \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0445
    \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043e\u0442\u0434\u0430\u043b\u0435\u043d\u043d\u044b\u0445 \u0443\u0433\u043e\u043b\u043a\u043e\u0432
    \u0421\u0421\u0421\u0420 \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0432\u044b\u0441\u0448\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u042d\u0442\u043e \u0431\u044b\u043b
    \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u043f\u0440\u043e\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439
    \u043f\u043e\u0434\u0432\u0438\u0433.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u041e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430 \u0431\u044b\u043b
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443.
    \u041e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u043d\u0430\u0433\u0440\u0430\u0434:
    \u041f\u0440\u0435\u043c\u0438\u044f \u0412\u043e\u043b\u044c\u0444\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    (1978) \u2014 \u043e\u0434\u043d\u0430 \u0438\u0437 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041a\u0438\u043e\u0442\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (1989) \u2014 \u0437\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u043d\u0430\u0443\u043a\u0438.
    \u041f\u0440\u0435\u043c\u0438\u044f \u0421\u0442\u0438\u043b\u0430 (2005) \u2014 \u0437\u0430
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041f\u0440\u0435\u043c\u0438\u044f
    \u041c\u0430\u043a\u0410\u0440\u0442\u0443\u0440\u0430 (\u00ab\u0433\u0440\u0430\u043d\u0442
    \u0434\u043b\u044f \u0433\u0435\u043d\u0438\u0435\u0432\u00bb, 1994). \u0422\u0440\u0438
    \u043e\u0440\u0434\u0435\u043d\u0430 \u041b\u0435\u043d\u0438\u043d\u0430 (\u0421\u0421\u0421\u0420).
    \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u0430\u044f \u0438 \u0434\u0432\u0435 \u0421\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u0438\u0435
    \u043f\u0440\u0435\u043c\u0438\u0438. \u0427\u043b\u0435\u043d\u0441\u0442\u0432\u043e \u0432
    \u0434\u0435\u0441\u044f\u0442\u043a\u0430\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439
    \u043c\u0438\u0440\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0435
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e
    \u0438 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e
    \u043d\u0430\u0443\u043a \u0421\u0428\u0410.\n\n\U0001F4DC \u041a\u0440\u0430\u0442\u043a\u043e\u0435
    \u0440\u0435\u0437\u044e\u043c\u0435 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0431\u044b\u043b
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043b, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0431\u044b, \u043d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u044b\u0435
    \u043c\u0438\u0440\u044b. \u041e\u043d \u043c\u043e\u0433 \u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0447\u0435\u0440\u0435\u0437
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0438
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432 \u0444\u0438\u0437\u0438\u043a\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0441\u0430\u043c \u0436\u0435 \u0431\u0440\u0430\u043b\u0441\u044f
    \u0437\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447 \u0432 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0438
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0435. \u0415\u0433\u043e \u0441\u0442\u0438\u043b\u044c
    \u0440\u0430\u0431\u043e\u0442\u044b, \u0435\u0433\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0439
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440 \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0430\u044f
    \u0438\u043c \u0448\u043a\u043e\u043b\u0430 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438
    \u0446\u0435\u043b\u044b\u0435 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f \u0443\u0447\u0435\u043d\u044b\u0445,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442
    \u0435\u0433\u043e \u0434\u0435\u043b\u043e \u043f\u043e \u0432\u0441\u0435\u043c\u0443
    \u043c\u0438\u0440\u0443."
  achievementsEn: "Israel of Moses' Gelfand was not just a mathematician, but a universal scientist whose legacy changed the shape of modern science, whose contribution extends from pure mathematics to practical medicine, and his name is perpetuated in dozens of fundamental theorems and concepts.\n\nDeep foundation: The functional analysis of Helfand began his career by rethinking the functional analysis, a division of mathematics that explores infinite space. His early works laid the foundation for entire fields of science. The theory of banana algebra (normal rings): This was his first major breakthrough in the late 1930s and early 1940s.He created a coherent theory of commutable banana algebras, built around the concept of maximum ideals, which not only simplified and synthesized the classic theory of Winer, but also laid the foundation for a helfandian representation, a powerful tool that linked abstract algebras to the spaces of continuous function, which was recognized as the first triumph of modern functional analysis.C-algebra theory: Together with his apprentice M.A. Naimark, he took a decisive step towards the creation of C-Algebra theory by proving the famous Helfand-Nimark Theorem and developing the GNS design (Gelfanda-Nimarka-Sigala), which was the cornerstone of the quantum mechanics mathematical machine.\n\n♪ A bridge in physics: The theory of the concepts and the general functions of Helfand was one of the first to understand and create a language in which mathematics and physics can speak on an equal footing. ♪ The theory of the infinite representations of Lee's groups: This may be his most important legacy. ♪ He developed the theory of the ideas of the complex classic groups Lee, which is fundamental to quantum physics and elementary particle theory ♪His work on the Helfand-Tsetlin Patterns (Gelfand-Tsetlin Patterns) has become a widely used tool in theoretical physics. The theory of generic functions (distributions): Helphand and G.E. Shelov wrote a monumental six-volume work, \"General Functions\" (1958-1968), which became a desktop book for mathematicians and physicists worldwide.This work has systematized and developed the theory put forward by Laurent Schwartz and made it available for application purposes.\n\nOpens spread throughout mathematics List of discoveries and objects named Helphand is huge and demonstrates the incredible breadth of his interests: Integrated Geometry: Helphand has turned this area into a self-contained discipline, bringing together Radon's ideas, and his work in this direction has become the mathematical basis for modern computer and positronic mission tomography (CT and PET).Solitone theory and integrated systems: He has made a fundamental contribution to the study of non-linear waves (solitons), particularly through the Gelfand-Dikii equations (Gelfand-Dikii equations). Lee's cogomology: Together with D. B. Fooks, he has created the theory of the chamology of Lee's algebra vector fields (Gelfand-Fux), which was an important step in geometry and topology.Inverse Specular Tasks: His work on the reverse task of Storm-Liuville (Gelphanda-Levitania) has been applied to quantum mechanics and dispersing theory. The size of the Helphand-Kirillov: This algebraic invariant is used to classify infinite algebra. Other areas: Gelfand has also contributed to automorphic function theory, combinator topology, hypergeometric function theory and non-commutative algebra.\n\nFrom mathematics to biology and medicine, Helphand &apos; s contribution was not limited to pure mathematics; his personal tragedy (the death of his son from leukemia) led him to a systematic study of biology and medicine; and Mathematic biology: He organized a biological seminar and an inter-faculty laboratory at the MGU, which dealt with neurophysiology, cellular biology and immunology.His approach was to look for mathematical structures in biological processes, such as morphogenesis of cells or motion management. Medical diagnostics: His work on integrated geometry directly led to the creation of algorithms for medical tomography, and he also tried to formalize clinical diagnostics by developing diagnostic games, methods that far ahead of his time.\n\nHe thought that mathematics was an art to be shared with everyone. The legendary seminar: His seminar in the MGU, which was held on the 14th floor of the main building for almost 50 years, was the center of attraction for several generations of mathematicians. It was a unique creative atmosphere, and great scientists were talking to students on an equal footing.All-Union Distance Mathematical School (UMMS): In 1964, he founded this school, which enabled thousands of talented students from the most remote corners of the USSR to study higher mathematics, a truly educational feat.\n\n▪ Recognition and awards of Helphand's tremendous contribution have been recognized worldwide. He has received many of the most prestigious awards: the Wolf Prize for Mathematics (1978), one of the most prestigious awards in mathematics. The Kyoto Prize (1989), for significant contributions to science. The Steel Prize (2005), for outstanding contributions to mathematics. The MacArthur Award (Genius Grant, 1994), the three Orders of Lenin (USSR), the Lenin Prize and the two Stalin Prizes.Membership in dozens of world academies, including the Royal Society of London and the National Academy of Sciences.\n\nThe short summary of Gelfand was a man who combined seemingly incompatible worlds, and he could build abstract mathematical theories that over decades were applied in physics and then he took up his own applications in biology and medicine, and his style of work, his legendary seminar and his school raised generations of scientists who continued to do his work around the world."
  personalLifeRu: "\u0418\u0437\u0440\u0430\u0438\u043b\u044c \u041c\u043e\u0438\u0441\u0435\u0435\u0432\u0438\u0447
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0441 \u0431\u043e\u0433\u0430\u0442\u043e\u0439
    \u0438 \u0432 \u0447\u0435\u043c-\u0442\u043e \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u044c\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430
    \u0441 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438 \u0438\u0441\u043a\u0430\u043d\u0438\u044f\u043c\u0438.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F466
    \u0421\u0435\u043c\u044c\u044f \u0438 \u0434\u0435\u0442\u0438 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434
    \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0442\u0440\u0438\u0436\u0434\u044b,
    \u0438 \u0435\u0433\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u043a\u0430\u043a \u0441 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435\u043c
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0438,
    \u0442\u0430\u043a \u0438 \u0441 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u043b\u0438\u0447\u043d\u043e\u0439
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439. \u041f\u0435\u0440\u0432\u0430\u044f
    \u0436\u0435\u043d\u0430 \u2014 \u0424\u043b\u043e\u0440\u0430 \u041f\u0430\u0432\u043b\u043e\u0432\u043d\u0430
    \u042f\u0441\u0438\u043d\u043e\u0432\u0441\u043a\u0430\u044f (1918\u20132020). \u041e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043a\u043e\u0439, \u0430
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u043e\u043c.
    \u042d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u0440\u0430\u0441\u043f\u0430\u043b\u0441\u044f,
    \u0438 \u043f\u043e\u0437\u0436\u0435 \u043e\u043d\u0430 \u0432\u044b\u0448\u043b\u0430
    \u0437\u0430\u043c\u0443\u0436 \u0437\u0430 \u041c\u0438\u0445\u0430\u0438\u043b\u0430 \u041b\u0438\u0442\u0432\u0438\u043d\u043e\u0432\u0430,
    \u0441\u044b\u043d\u0430 \u043d\u0430\u0440\u043a\u043e\u043c\u0430 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445
    \u0434\u0435\u043b \u0421\u0421\u0421\u0420 \u041c.\u041c. \u041b\u0438\u0442\u0432\u0438\u043d\u043e\u0432\u0430.
    \u0412\u0442\u043e\u0440\u0430\u044f \u0436\u0435\u043d\u0430 \u2014 \u0417\u043e\u0440\u044f
    (\u0417\u0438\u043d\u0430\u0438\u0434\u0430) \u042f\u043a\u043e\u0432\u043b\u0435\u0432\u043d\u0430
    \u0428\u0430\u043f\u0438\u0440\u043e (1914\u20132013). \u041e\u043d\u0438 \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c
    \u0432 1942 \u0433\u043e\u0434\u0443. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u0438\u0446\u0435\u0439 \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u043c\u0435\u0445\u043c\u0430\u0442\u0430 \u041c\u0413\u0423, \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u043e\u043c
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a. \u0417\u043e\u0440\u044f \u042f\u043a\u043e\u0432\u043b\u0435\u0432\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043f\u0443\u0442\u043d\u0438\u0446\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438, \u043d\u043e \u0438 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430, \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044f
    \u0432 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u0438 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0439.
    \u0412 \u044d\u0442\u043e\u043c \u0431\u0440\u0430\u043a\u0435 \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c
    \u0442\u0440\u043e\u0435 \u0441\u044b\u043d\u043e\u0432\u0435\u0439: \u0421\u0435\u0440\u0433\u0435\u0439
    \u0418\u0437\u0440\u0430\u0438\u043b\u0435\u0432\u0438\u0447 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434
    (\u0440\u043e\u0434. 1944) \u2014 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0434\u043e\u043b\u0433\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c \u0410\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440
    \u0418\u0437\u0440\u0430\u0438\u043b\u0435\u0432\u0438\u0447 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434
    (\u0440\u043e\u0434. 1948) \u2014 \u0431\u0438\u043e\u0445\u0438\u043c\u0438\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u043a\u043b\u0435\u0442\u043e\u0447\u043d\u043e\u0439 \u0438 \u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0439
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0432 \u0421\u0435\u0432\u0435\u0440\u043e-\u0417\u0430\u043f\u0430\u0434\u043d\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0432 \u0427\u0438\u043a\u0430\u0433\u043e.
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0418\u0437\u0440\u0430\u0438\u043b\u0435\u0432\u0438\u0447
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u2014 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u0443\u043c\u0435\u0440 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043e\u0442
    \u043e\u0441\u0442\u0440\u043e\u0433\u043e \u043b\u0435\u0439\u043a\u043e\u0437\u0430. \u042d\u0442\u0430
    \u043f\u043e\u0442\u0435\u0440\u044f \u0441\u0442\u0430\u043b\u0430 \u0433\u043b\u0443\u0431\u043e\u0447\u0430\u0439\u0448\u0435\u0439
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f, \u043f\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c
    \u043a\u043e\u043b\u043b\u0435\u0433, \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u043b\u0430
    \u0436\u0438\u0437\u043d\u044c \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430 \u0438
    \u043f\u043e\u0434\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430 \u0435\u0433\u043e \u043a
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b.
    \u0422\u0440\u0435\u0442\u044c\u044f \u0436\u0435\u043d\u0430 \u2014 \u0422\u0430\u0442\u044c\u044f\u043d\u0430
    \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u043e\u0432\u043d\u0430 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434
    (\u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f \u0410\u043b\u0435\u043a\u0441\u0435\u0435\u0432\u0441\u043a\u0430\u044f,
    \u0440\u043e\u0434. 1952). \u041e\u043d\u0438 \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c
    \u0432 1979 \u0433\u043e\u0434\u0443. \u041e\u043d\u0430 \u0442\u0430\u043a\u0436\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b\u0430
    \u0432 \u0420\u0430\u0442\u0433\u0435\u0440\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0432 \u0421\u0428\u0410. \u0412 \u044d\u0442\u043e\u043c \u0431\u0440\u0430\u043a\u0435
    \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u0434\u043e\u0447\u044c \u0422\u0430\u0442\u044c\u044f\u043d\u0430
    \u0418\u0437\u0440\u0430\u0438\u043b\u0435\u0432\u043d\u0430 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434,
    \u0441\u0442\u0430\u0432\u0448\u0430\u044f \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u043e\u043c.\n\n\U0001F9EC
    \u0421\u0432\u044f\u0437\u044c \u0441 \u043d\u0430\u0443\u043a\u043e\u0439 \u0438 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440 \u041b\u0438\u0447\u043d\u0430\u044f \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f,
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f \u0441\u043e \u0441\u043c\u0435\u0440\u0442\u044c\u044e
    \u0441\u044b\u043d\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430 \u043e\u0442
    \u043b\u0435\u0439\u043a\u0435\u043c\u0438\u0438 \u0432 \u043a\u043e\u043d\u0446\u0435 1950-\u0445
    \u2014 \u043d\u0430\u0447\u0430\u043b\u0435 1960-\u0445 \u0433\u043e\u0434\u043e\u0432,
    \u0441\u0442\u0430\u043b\u0430 \u043c\u043e\u0449\u043d\u044b\u043c \u043a\u0430\u0442\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c
    \u0434\u043b\u044f \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u0438.
    \u041d\u0435 \u0438\u043c\u0435\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f,
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434, \u0434\u0432\u0438\u0436\u0438\u043c\u044b\u0439
    \u043e\u0442\u0447\u0430\u044f\u043d\u0438\u0435\u043c \u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u0435\u043c
    \u043f\u043e\u043d\u044f\u0442\u044c \u0441\u0443\u0442\u044c \u0431\u043e\u043b\u0435\u0437\u043d\u0438,
    \u043d\u0430\u0447\u0430\u043b \u0438\u0441\u043a\u0430\u0442\u044c \u0432\u0441\u0442\u0440\u0435\u0447
    \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430\u043c\u0438
    \u0438 \u0431\u0438\u043e\u043b\u043e\u0433\u0430\u043c\u0438 \u0421\u0421\u0421\u0420.
    \u041e\u043d \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0435
    \u043f\u043e\u0434\u0445\u043e\u0434\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0434\u0430\u0442\u044c
    \u043e\u0442\u0432\u0435\u0442\u043e\u0432, \u0438 \u043d\u0430\u0447\u0430\u043b \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u0435\u0431\u044f \u043a\u0440\u0443\u0433 \u0443\u0447\u0435\u043d\u044b\u0445
    \u0438\u0437 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439.
    \u0422\u0430\u043a \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0435\u043c\u0438\u043d\u0430\u0440,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u044b\u0433\u0440\u0430\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0443\u044e\u0441\u044f
    \u0440\u043e\u043b\u044c \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438, \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u0431\u0438\u043e\u043b\u043e\u0433\u043e\u0432
    \u0438 \u0432\u0440\u0430\u0447\u0435\u0439 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c.\n\n\U0001F30F \u041f\u043e\u0437\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f \u0412
    1989 \u0433\u043e\u0434\u0443, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432\u044b\u0435\u0437\u0434\u0430 \u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0443,
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0441 \u0441\u0435\u043c\u044c\u0435\u0439
    (\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0441 \u0442\u0440\u0435\u0442\u044c\u0435\u0439
    \u0436\u0435\u043d\u043e\u0439 \u0422\u0430\u0442\u044c\u044f\u043d\u043e\u0439 \u0438 \u0434\u043e\u0447\u0435\u0440\u044c\u044e)
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410. \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u0436\u0438\u043b
    \u0432 \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u041f\u0438\u0441\u043a\u0430\u0442\u0430\u0443\u044d\u0439,
    \u0448\u0442\u0430\u0442 \u041d\u044c\u044e-\u0414\u0436\u0435\u0440\u0441\u0438, \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e
    \u043e\u0442 \u0420\u0430\u0442\u0433\u0435\u0440\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430,
    \u0433\u0434\u0435 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0441\u0432\u043e\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438.
    \u041e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    96 \u043b\u0435\u0442 5 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 2009 \u0433\u043e\u0434\u0430
    \u0432 \u041d\u044c\u044e-\u0411\u0440\u0430\u043d\u0441\u0443\u0438\u043a\u0435, \u0448\u0442\u0430\u0442
    \u041d\u044c\u044e-\u0414\u0436\u0435\u0440\u0441\u0438. \u0423 \u043d\u0435\u0433\u043e
    \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u0432\u0442\u043e\u0440\u0430\u044f \u0436\u0435\u043d\u0430
    \u0417\u043e\u0440\u044f \u0428\u0430\u043f\u0438\u0440\u043e (\u0443\u043c\u0435\u0440\u043b\u0430
    \u0432 2013 \u0433\u043e\u0434\u0443), \u0442\u0440\u0435\u0442\u044c\u044f \u0436\u0435\u043d\u0430
    \u0422\u0430\u0442\u044c\u044f\u043d\u0430, \u0434\u0435\u0442\u0438 \u0438 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435
    \u0432\u043d\u0443\u043a\u0438."
  personalLifeEn: "Israel was not only a genius scientist, but also a man with a rich and tragic personal life that was closely intertwined with his scientific quests.\n\n==Personal history==The first wife, Flora Pavlovna Yasinovsky (1918–2020), was a student and later a physiologist, who broke up, and later married Michael Litwinov, son of the Soviet Union of Foreign Affairs, M. M. Litwinov, and the second wife, Zor (Zinaida) Yakovlev Shapiro (1914–2013).She was a mathematician, a graduate and a teacher of Mechmat, a candidate for physics and mathematics, and Jakovlevna was not only a companion of life, but also a co-author of Gelfand, who was involved in the writing of monographs, and three sons were born in this marriage: Sergei Israelwich Gelfand (b. 1944), a well-known mathematician, who worked for a long time as a responsible publisher of American Mathematic Society.Vladimir Israelwich Gelfand (born 1948) is a biochemist, a professor of cellular and molecular biology at Northwest University in Chicago, Alexander Israelwich Gelfand, who died of acute leukemia as a tragic childhood, and this loss was the deepest personal tragedy that, according to colleagues, turned the life of Helphand into an active study of biology and medicine.A third wife, Tatiana Vladimirovna Gelfand (born Alexeev, born 1952), married in 1979 and also a mathematician who taught at Rutger University in the United States, and who gave birth to the daughter of Tatiana Israeln Gelfand, who became a psychologist.\n\nThe personal tragedy associated with Alexander's death from leukemia in the late 1950s and early 1960s was a powerful catalyst for his scientific evolution, with no formal biological education, and helfand, driven by despair and a desire to understand the disease, began to look for meetings with leading hematologists and biologists of the USSR.He quickly realized that existing medical approaches could not respond, and he began to form a circle of scientists from different fields, and this was the birth of his famous biological seminar, which played an outstanding role in the development of Soviet biology, bringing together mathematicians, biologists and doctors to solve complex fundamental problems.\n\n==Death================Death========Death==========Death and migration========Later years============Later years============In 1989, Gelfand and his family moved to the United States with his third wife, Tatyana and daughter.He still has his second wife, Zorah Shapiro (died in 2013), Tatiana's third wife, children, and numerous grandchildren."
  shortBioRu: "\u0418\u0437\u0440\u0430\u0438\u043b\u044c \u041c\u043e\u0438\u0441\u0435\u0435\u0432\u0438\u0447
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 (1913\u20132009) \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    XX \u0432\u0435\u043a\u0430, \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e \u0431\u044b\u043b\u0438 \u0441\u0442\u043e\u043b\u044c
    \u0436\u0435 \u043d\u0435\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c\u0438,
    \u043a\u0430\u043a \u0438 \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f.
    \u041e\u043d \u0432\u043e\u0448\u0435\u043b \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a \u0430\u0432\u0442\u043e\u0440
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432 \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043d\u043e \u0438 \u043a\u0430\u043a \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f.\n\n\U0001F9EC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043f\u0443\u0442\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    2 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1913 \u0433\u043e\u0434\u0430 \u0432
    \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435 \u041e\u043a\u043d\u044b (\u043f\u043e\u0437\u0436\u0435
    \u041a\u0440\u0430\u0441\u043d\u044b\u0435 \u041e\u043a\u043d\u044b) \u043d\u0430 \u044e\u0433\u0435
    \u0423\u043a\u0440\u0430\u0438\u043d\u044b, \u0432 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435 \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0430.
    \u0415\u0433\u043e \u043f\u0443\u0442\u044c \u0432 \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443 \u0431\u044b\u043b \u043f\u043e\u043b\u043e\u043d \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0439
    \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u043b\u044b
    \u0442\u0430\u043b\u0430\u043d\u0442\u0430 \u0438 \u0446\u0435\u043b\u0435\u0443\u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438.
    \u0422\u0440\u0443\u0434\u043d\u043e\u0435 \u0434\u0435\u0442\u0441\u0442\u0432\u043e: \u0412
    1928 \u0433\u043e\u0434\u0443, \u0432 \u0440\u0430\u0437\u0433\u0430\u0440 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432\u0438\u0437\u0430\u0446\u0438\u0438,
    \u043e\u043d \u0431\u044b\u043b \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d \u0438\u0437
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u0432 9-\u043c \u043a\u043b\u0430\u0441\u0441\u0435 \u043a\u0430\u043a
    \u0441\u044b\u043d \u00ab\u043d\u0435\u0442\u0440\u0443\u0434\u043e\u0432\u043e\u0433\u043e
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u00bb (\u0435\u0433\u043e \u043e\u0442\u0435\u0446
    \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u043b \u043c\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439).
    \u041f\u0443\u0442\u044c \u0432 \u041c\u043e\u0441\u043a\u0432\u0443: \u041d\u0435 \u0438\u043c\u0435\u044f
    \u0437\u0430\u043a\u043e\u043d\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u0432 1930 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0443\u0435\u0445\u0430\u043b \u0432 \u041c\u043e\u0441\u043a\u0432\u0443.
    \u0420\u0430\u0431\u043e\u0442\u0430\u043b \u0432\u0430\u0445\u0442\u0435\u0440\u043e\u043c
    \u0432 \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u043e\u0439 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435,
    \u0433\u0434\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0441\u0430\u043c\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u0438 \u0447\u0438\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043d\u0438\u0433\u0438. \u0421\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439: \u0412 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435
    \u0435\u0433\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u041c\u0413\u0423, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0430\u043b \u0435\u043c\u0443
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0434\u0430\u0447. \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434
    \u0438\u0445 \u0440\u0435\u0448\u0438\u043b, \u043f\u0440\u0438\u0447\u0435\u043c \u043e\u0434\u043d\u0430
    \u0438\u0437 \u0437\u0430\u0434\u0430\u0447 \u0431\u044b\u043b\u0430 \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u043e\u0439.
    \u0412\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b \u0435\u0433\u043e \u043f\u043e\u0441\u0435\u0449\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438. \u042d\u0442\u0438\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0431\u044b\u043b \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0410\u043d\u0434\u0440\u0435\u0439 \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432. \u0422\u0430\u043a, \u0432
    1932 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19
    \u043b\u0435\u0442, \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0431\u044b\u043b
    \u043f\u0440\u0438\u043d\u044f\u0442 \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443
    \u041c\u0413\u0423 \u043a \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432\u0443
    \u0438 \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u043d\u0430 \u043a\u0430\u0444\u0435\u0434\u0440\u0435. \u041f\u043e\u0437\u0436\u0435
    \u041a\u043e\u043b\u043c\u043e\u0433\u043e\u0440\u043e\u0432 \u0441\u043a\u0430\u0436\u0435\u0442,
    \u0447\u0442\u043e \u0435\u0441\u0442\u044c \u043b\u0438\u0448\u044c \u0434\u0432\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u0432 \u0431\u0435\u0441\u0435\u0434\u0435
    \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043e\u043d \u00ab\u043e\u0449\u0443\u0449\u0430\u043b
    \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u044b\u0441\u0448\u0435\u0433\u043e
    \u0440\u0430\u0437\u0443\u043c\u0430\u00bb, \u0438 \u043e\u0434\u0438\u043d \u0438\u0437
    \u043d\u0438\u0445 \u2014 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434.\n\n\U0001F52C
    \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434
    \u0431\u044b\u043b \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u043e\u043c \u0432
    \u044d\u043f\u043e\u0445\u0443 \u0432\u0441\u0435 \u0431\u043e\u043b\u0435\u0435 \u0443\u0437\u043a\u043e\u0439
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438. \u041e\u043d
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c
    \u0432 \u0434\u0435\u0441\u044f\u0442\u043a\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439,
    \u0435\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u00ab\u041c\u043e\u0446\u0430\u0440\u0442\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb \u0437\u0430 \u043a\u0440\u0430\u0441\u043e\u0442\u0443
    \u0438 \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u0435\u0433\u043e \u0438\u0434\u0435\u0439.
    \u041e\u043d \u0430\u0432\u0442\u043e\u0440 \u0431\u043e\u043b\u0435\u0435 800 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0441\u0442\u0430\u0442\u0435\u0439 \u0438 \u043e\u043a\u043e\u043b\u043e 30 \u043a\u043d\u0438\u0433.
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442:
    \u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437:
    \u0421\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u044b\u0445
    \u0431\u0430\u043d\u0430\u0445\u043e\u0432\u044b\u0445 \u0430\u043b\u0433\u0435\u0431\u0440
    (\u043d\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043e\u043b\u0435\u0446),
    \u0447\u0442\u043e \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c. C-\u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439:
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041c.\u0410. \u041d\u0430\u0439\u043c\u0430\u0440\u043a\u043e\u043c
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438
    C-\u0430\u043b\u0433\u0435\u0431\u0440 \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u0445
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0433\u0440\u0443\u043f\u043f
    \u041b\u0438, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043c\u043e\u0441\u0442\u043e\u043c
    \u043c\u0435\u0436\u0434\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u043e\u0439.
    \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439: \u0410\u0432\u0442\u043e\u0440 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u0435\u0441\u0442\u0438\u0442\u043e\u043c\u043d\u043e\u0439 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u00ab\u041e\u0431\u043e\u0431\u0449\u0435\u043d\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\u00bb,
    \u0441\u0442\u0430\u0432\u0448\u0435\u0439 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439
    \u043a\u043d\u0438\u0433\u043e\u0439 \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0438 \u0444\u0438\u0437\u0438\u043a\u043e\u0432 \u043f\u043e \u0432\u0441\u0435\u043c\u0443
    \u043c\u0438\u0440\u0443. \u0414\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438:
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u0442\u0440\u043e\u043d\u0443\u043b\u0438
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e,
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e (\u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430-\u0424\u0443\u043a\u0441\u0430),
    \u0442\u0435\u043e\u0440\u0438\u044e \u0441\u043e\u043b\u0438\u0442\u043e\u043d\u043e\u0432,
    \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u0415\u0433\u043e \u0438\u0434\u0435\u0438
    \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0434\u043b\u044f \u041c\u0420\u0422 \u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439
    \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0412 1953 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u041d \u0421\u0421\u0421\u0420, \u043d\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c \u0441\u0442\u0430\u043b \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 1984 \u0433\u043e\u0434\u0443 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    71 \u0433\u043e\u0434\u0430. \u041f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0442\u0430\u043a\u043e\u0439
    \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0438, \u043f\u043e \u043e\u0431\u0449\u0435\u043c\u0443
    \u043c\u043d\u0435\u043d\u0438\u044e, \u0431\u044b\u043b \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c
    \u0432 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0440\u0435\u0434\u0435 \u0438 \u0435\u0433\u043e \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u043e\u0439,
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440.\n\n\U0001F9D1\u200d\U0001F3EB
    \u041f\u0435\u0434\u0430\u0433\u043e\u0433, \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a
    \u0438 \u0431\u043e\u0440\u0435\u0446 \u0437\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0443\u0447\u0435\u043d\u044b\u043c, \u043d\u043e \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0432\u043e\u0435\u0439 \u043c\u0438\u0441\u0441\u0438\u0435\u0439
    \u043f\u0440\u0438\u043e\u0431\u0449\u0430\u0442\u044c \u043a \u043a\u0440\u0430\u0441\u043e\u0442\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e
    \u0431\u043e\u043b\u044c\u0448\u0435 \u043b\u044e\u0434\u0435\u0439. \u041b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0439
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440: \u0412 1943 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0435\u043c\u0438\u043d\u0430\u0440,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b
    \u043f\u043e\u0447\u0442\u0438 50 \u043b\u0435\u0442 \u043d\u0430 14-\u043c \u044d\u0442\u0430\u0436\u0435
    \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u0434\u0430\u043d\u0438\u044f \u041c\u0413\u0423.
    \u041d\u0430 \u043d\u0435\u043c \u0446\u0430\u0440\u0438\u043b\u0430 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u043d\u0430\u044f
    \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430,
    \u0433\u0434\u0435 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u0438 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u044b
    \u043d\u0430 \u0440\u0430\u0432\u043d\u044b\u0445 \u043e\u0431\u0449\u0430\u043b\u0438\u0441\u044c
    \u0441 \u043c\u0430\u0441\u0442\u0438\u0442\u044b\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438.
    \u0421\u0435\u043c\u0438\u043d\u0430\u0440 \u0441\u0442\u0430\u043b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439
    \u0448\u043a\u043e\u043b\u043e\u0439 \u0438 \u00ab\u043e\u043a\u043d\u043e\u043c \u0432
    \u043d\u0430\u0443\u043a\u0443\u00bb \u0434\u043b\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u0412\u0441\u0435\u0441\u043e\u044e\u0437\u043d\u0430\u044f \u0437\u0430\u043e\u0447\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0448\u043a\u043e\u043b\u0430
    (\u0412\u0417\u041c\u0428): \u0412 1964 \u0433\u043e\u0434\u0443 \u043f\u043e \u0435\u0433\u043e
    \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435 \u0431\u044b\u043b\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0430
    \u0412\u0417\u041c\u0428. \u041e\u043d\u0430 \u0434\u0430\u043b\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u043c \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u0430\u043c
    \u0438\u0437 \u043e\u0442\u0434\u0430\u043b\u0435\u043d\u043d\u044b\u0445 \u0443\u0433\u043e\u043b\u043a\u043e\u0432
    \u0421\u0421\u0421\u0420 \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439.
    \u041e\u043a\u043e\u043b\u043e 70 \u0442\u044b\u0441\u044f\u0447 \u0447\u0435\u043b\u043e\u0432\u0435\u043a
    \u043f\u0440\u043e\u0448\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 \u044d\u0442\u0443 \u0448\u043a\u043e\u043b\u0443,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c
    \u0432\u043a\u043b\u0430\u0434\u043e\u043c \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u0441\u0442\u0440\u0430\u043d\u0435.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438:
    \u041b\u0438\u0447\u043d\u0430\u044f \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f (\u0441\u043c\u0435\u0440\u0442\u044c
    \u0441\u044b\u043d\u0430 \u043e\u0442 \u043b\u0435\u0439\u043a\u0435\u043c\u0438\u0438)
    \u043f\u043e\u0434\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430 \u0435\u0433\u043e \u043a
    \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0435\u0439
    \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u043e\u0439. \u041e\u043d \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043b
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0435\u043c\u0438\u043d\u0430\u0440
    \u0438 \u043c\u0435\u0436\u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0441\u043a\u0443\u044e
    \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044e, \u0432\u043d\u0435\u0441
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0435\u0439\u0440\u043e\u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u044e,
    \u043a\u043b\u0435\u0442\u043e\u0447\u043d\u0443\u044e \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044e
    \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438.\n\n\U0001F30D \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0412
    1989 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u043c\u043d\u043e\u0433\u0438\u0445
    \u043b\u0435\u0442 \u043d\u0435\u0432\u044b\u0435\u0437\u0434\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u0442\u0443\u0441\u0430,
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0443\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410.
    \u041e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0435
    \u0438 MIT, \u0430 \u0441 1991 \u0433\u043e\u0434\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u0420\u0430\u0442\u0433\u0435\u0440\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0432 \u041d\u044c\u044e-\u0414\u0436\u0435\u0440\u0441\u0438, \u0433\u0434\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0441\u0432\u043e\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0438 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u0415\u0433\u043e
    \u0442\u0430\u043b\u0430\u043d\u0442 \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d
    \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435: \u041f\u0440\u0435\u043c\u0438\u0438:
    \u041b\u0430\u0443\u0440\u0435\u0430\u0442 \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 (1961), \u0434\u0432\u0443\u0445 \u0421\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u0438\u0445
    \u043f\u0440\u0435\u043c\u0438\u0439 (1951, 1953), \u041f\u0440\u0435\u043c\u0438\u0438
    \u0412\u043e\u043b\u044c\u0444\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    (1978), \u041a\u0438\u043e\u0442\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    (1989), \u043f\u0440\u0435\u043c\u0438\u0438 \u0421\u0442\u0438\u043b\u0430 (2005), \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438
    \u0424\u043e\u043d\u0434\u0430 \u041c\u0430\u043a\u0430\u0440\u0442\u0443\u0440\u043e\u0432
    (\u00ab\u0433\u0440\u0430\u043d\u0442 \u0434\u043b\u044f \u0433\u0435\u043d\u0438\u0435\u0432\u00bb,
    1994). \u0427\u043b\u0435\u043d\u0441\u0442\u0432\u0430: \u0418\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
    \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0421\u0428\u0410, \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0438 \u043c\u043d\u043e\u0433\u0438\u0445
    \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439 \u043c\u0438\u0440\u0430.
    \u0418\u0437\u0440\u0430\u0438\u043b\u044c \u041c\u043e\u0438\u0441\u0435\u0435\u0432\u0438\u0447
    \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    5 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 2009 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    96 \u043b\u0435\u0442 \u0432 \u041d\u044c\u044e-\u0414\u0436\u0435\u0440\u0441\u0438, \u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u0446\u0435\u043b\u0443\u044e \u043f\u043b\u0435\u044f\u0434\u0443 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0445 \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445 \u043c\u0438\u0440\u0430."
  shortBioEn: "Israel is one of the largest mathematicians in the 20th century, whose life and scientific creativity were as extraordinary as its discovery, and has entered history not only as a author of fundamental works in all fields of mathematics, but also as a creator of a unique science school and education system.\n\n==Early years and journeys to science==Helfand was born on September 2, 1913 in the area of the Window (later the Red Windows) in southern Ukraine, in the Jewish family of an accountant. His journey to great science was full of obstacles and was an example of the amazing power of talent and purpose.The road to Moscow: Without a secondary education, he left for Moscow in 1930, worked as a janitor at the Lenin Library, where he studied himself and read mathematical books. He was happy to be noticed in the library by a professor of the MGU who gave him several tasks.This professor was a great mathematician named Andrei Nikolaevich Kolmogorov, and in 1932, at the age of 19, he was admitted to the post-graduate degree of the MGU to Kolmogorov and began teaching in the faculty. Later, Kolmogorov will say that there are only two mathematicians with whom he \"gave for the presence of the higher mind,\" and one of them is Gelfand.\n\nHe worked in more than a dozen fields, called the \"Mozart of Mathematics\" for his beauty and scope of ideas. He authored over 800 scientific articles and about 30 books. Key scientific results include: Functional analysis: Created a theory of commutative banana algebra (normal rings) that brought him world-renowned.C-algebras and the theory of performance: Together with M.A. Naimark laid the foundations of C-Algebra theory and developed the theory of infinity of Lee's group, which became a bridge between mathematics and quantum physics. The theory of general functions: Author of the fundamental six-volume monograph, \"General Functions\", which became a desktop book for mathematicians and physicists around the world.Other areas: its work touched on integrated geometry, topology (Gelphanda-Fux) and the theory of solitones and the reverse tasks of spectral analysis; its ideas formed the basis of MRI techniques and computer tomography; in 1953, he was elected as a member of the U.S.S.A., but he became a real academic only in 1984, at the age of 71.The reason for the delay was generally felt to be anti-Semitism in the Soviet academic environment and its complex, independent nature.\n\nThe teacher, mentor and education activist Gelfand was not only a scientist but also a distinguished teacher who considered it his mission to include as many people as possible in the beauty of mathematics.It was a democratic and creative environment in which students and graduate students interacted on an equal footing with mathematicians; it became a real school and a science window for several generations of mathematicians; and the All-Union Mathematical School (UMMS) was established in 1964 by the WSMS, which provided an opportunity for talented students from remote areas of the USSR to study mathematics under the guidance of leading teachers.Some 70,000 people have passed through this school, which has made a huge contribution to the development of education in the country, and the interest in biology: the personal tragedy (the death of a son from leukemia) prompted him to study biology and medicine, organized a biological seminar and an inter-faculty laboratory, contributed to neurophysiology, cellular biology and diagnostic techniques.\n\n==Reception and recognition=================================================================================)==================================================)==============)==================)==================================================================================His talents were recognized worldwide: the Laureate of the Lenin Prize (1961), the Two Stalin Awards (1951, 1953), the Wolfe Prize for Mathematics (1978), the Kyoto Prize (1989), the Steel Prize (2005), the MacArthur Foundation (Genius Grant, 1994), and memberships: Foreign Member of the Royal Society of London, the National Academy of Sciences of the United States, the French Academy of Sciences and many other peace academies.Israel died on October 5, 2009 at the age of 96 in New Jersey, leaving behind a huge scientific legacy and a clique of students working at the world's leading universities."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0418\u0437\u0440\u0430\u0438\u043b\u044f \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430
    \u043f\u043e\u043b\u043d\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.\n\n\U0001F4D6
    \u041e\u0442 \u0433\u0430\u0440\u0434\u0435\u0440\u043e\u0431\u0449\u0438\u043a\u0430 \u0434\u043e
    \u0433\u0435\u043d\u0438\u044f \u0421\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0413\u0435\u043b\u044c\u0444\u0430\u043d\u0434\u0430
    \u2014 \u0435\u0433\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0443. \u0412 16 \u043b\u0435\u0442,
    \u0438\u043c\u0435\u044f \u0437\u0430 \u043f\u043b\u0435\u0447\u0430\u043c\u0438 \u0432\u0441\u0435\u0433\u043e
    9 \u043a\u043b\u0430\u0441\u0441\u043e\u0432, \u043e\u043d \u043f\u0440\u0438\u0435\u0445\u0430\u043b
    \u0432 \u041c\u043e\u0441\u043a\u0432\u0443 \u0438\u0437 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u043e\u0433\u043e
    \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0430 \u041e\u043a\u043d\u044b. \u0412 \u0441\u0442\u043e\u043b\u0438\u0447\u043d\u043e\u043c
    \u041c\u0413\u0423 \u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u0438\u043d\u044f\u043b\u0438
