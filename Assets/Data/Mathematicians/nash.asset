  achievementsRu: "\u0414\u0436\u043e\u043d \u041d\u044d\u0448 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435
    \u0441\u0435\u0431\u044f \u043d\u0435 \u043e\u0434\u043d\u043e, \u0430, \u043f\u043e \u0441\u0443\u0442\u0438,
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0439.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u043c\u043e\u0436\u043d\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c \u0441 \u0441\u0435\u0440\u0438\u0435\u0439
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432 \u0432 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445, \u043a\u0430\u0436\u0434\u044b\u0439
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0438\u043b
    \u043b\u0438\u0446\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0438.
    \u0417\u0430 \u0441\u0432\u043e\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0432\u0441\u0435\u0433\u043e
    \u043e\u043a\u043e\u043b\u043e \u0434\u0432\u0443\u0445 \u0434\u0435\u0441\u044f\u0442\u043a\u043e\u0432
    \u0440\u0430\u0431\u043e\u0442, \u043d\u043e \u0438\u0445 \u0433\u043b\u0443\u0431\u0438\u043d\u0430
    \u0438 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u0442\u0430\u043a\u043e\u0432\u044b,
    \u0447\u0442\u043e \u0434\u0435\u043b\u044f\u0442 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u043d\u0430 \u0434\u0432\u0435 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435,
    \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438: \u0442\u0435\u043e\u0440\u0438\u044e \u0438\u0433\u0440
    \u0438 \u0447\u0438\u0441\u0442\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.\n\n\U0001F3B2
    \u0422\u0435\u043e\u0440\u0438\u044f \u0438\u0433\u0440: \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0432 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435 \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a\u0430\u0445 \u0418\u043c\u0435\u043d\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430
    \u041d\u044d\u0448\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443
    \u0438 \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e.
    \u0414\u043e \u041d\u044d\u0448\u0430 \u0442\u0435\u043e\u0440\u0438\u044f \u0438\u0433\u0440,
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0430\u044f \u0414\u0436\u043e\u043d\u043e\u043c
    \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u043e\u043c \u0438 \u041e\u0441\u043a\u0430\u0440\u043e\u043c
    \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d\u043e\u043c, \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0430\u0441\u044c \"\u0438\u0433\u0440\u0430\u043c\u0438
    \u0441 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0441\u0443\u043c\u043c\u043e\u0439\"
    \u0434\u043b\u044f \u0434\u0432\u0443\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432,
    \u0433\u0434\u0435 \u0432\u044b\u0438\u0433\u0440\u044b\u0448 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0440\u0430\u0432\u0435\u043d \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448\u0443 \u0434\u0440\u0443\u0433\u043e\u0433\u043e.
    \u041d\u044d\u0448 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432,
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u044b\u0435
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438.\n\n\U0001F4DC \"\u0420\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435
    \u041d\u044d\u0448\u0430\" (Nash Equilibrium) \u0412 1950 \u0433\u043e\u0434\u0443, \u0431\u0443\u0434\u0443\u0447\u0438
    22-\u043b\u0435\u0442\u043d\u0438\u043c \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u043c
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0430, \u041d\u044d\u0448 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c\u044e \"Equilibrium Points in N-person Games\" \u0432 Proceedings
    of the National Academy of Sciences (PNAS). \u042d\u0442\u043e \u0431\u044b\u043b\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0432\u0441\u0435\u0433\u043e \u043d\u0430 \u043e\u0434\u043d\u0443
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043d\u0430\u0443\u043a\u0443.
    \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f \u0438\u0434\u0435\u044f: \u041d\u044d\u0448
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435
    \u043a\u0430\u043a \u043d\u0430\u0431\u043e\u0440 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0439,
    \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e
    \u0438\u0433\u0440\u043e\u043a\u0430, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u043d\u0438 \u043e\u0434\u0438\u043d \u0438\u0437 \u0438\u0433\u0440\u043e\u043a\u043e\u0432
    \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c
    \u0441\u0432\u043e\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u0438\u0437\u043c\u0435\u043d\u0438\u0432
    \u0441\u0432\u043e\u044e \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044e \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443,
    \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438, \u0447\u0442\u043e \u0434\u0440\u0443\u0433\u0438\u0435
    \u0438\u0433\u0440\u043e\u043a\u0438 \u0441\u0432\u043e\u0438\u0445 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0439
    \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0442. \u041f\u0440\u043e\u0441\u0442\u044b\u043c\u0438
    \u0441\u043b\u043e\u0432\u0430\u043c\u0438, \u044d\u0442\u043e \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0438\u043a\u043e\u043c\u0443 \u043d\u0435
    \u0432\u044b\u0433\u043e\u0434\u043d\u043e \u043e\u0442\u043a\u043b\u043e\u043d\u044f\u0442\u044c\u0441\u044f
    \u043e\u0442 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0439 \u043b\u0438\u043d\u0438\u0438
    \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f, \u0435\u0441\u043b\u0438 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u0442\u0430\u043a \u0436\u0435.
    \u042d\u0442\u043e \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435
    \u0438\u0433\u0440\u044b, \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u044b\u0439
    \u0438\u0441\u0445\u043e\u0434 \u0434\u043b\u044f \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0433\u0440\u043e\u043a\u043e\u0432. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f:
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c
    \u041d\u044d\u0448\u0430 \u0441\u0442\u0430\u043b\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435, \u043d\u043e \u0438
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0439 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439
    \u0438\u0433\u0440\u044b (\u0441 \u043b\u044e\u0431\u044b\u043c \u0447\u0438\u0441\u043b\u043e\u043c
    \u0438\u0433\u0440\u043e\u043a\u043e\u0432) \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043e\u0434\u043d\u043e \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435,
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 \"\u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0445
    \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f\u0445\" (\u043a\u043e\u0433\u0434\u0430
    \u0438\u0433\u0440\u043e\u043a \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c
    \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442 \u043c\u0435\u0436\u0434\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u043c\u0438 \u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0439
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\u044e).\n\n\U0001F48E
    \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \"\u0420\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u044f
    \u041d\u044d\u0448\u0430\" \u041a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f \u041d\u044d\u0448\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438.
    \u041e\u043d\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043b\u044e\u0431\u044b\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u2014
    \u043e\u0442 \u0440\u044b\u043d\u043e\u0447\u043d\u043e\u0439 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0446\u0438\u0438
    \u0438 \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u043e\u0432 \u0434\u043e \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u043e\u0432 \u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432. \u042d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442
    \u0420\u043e\u0434\u0436\u0435\u0440 \u041c\u0430\u0439\u0435\u0440\u0441\u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u0435\u0435 \"\u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 XX \u0432\u0435\u043a\u0430...
    \u0441\u0440\u0430\u0432\u043d\u0438\u043c\u044b\u043c \u0441 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c
    \u0434\u0432\u043e\u0439\u043d\u043e\u0439 \u0441\u043f\u0438\u0440\u0430\u043b\u0438 \u0414\u041d\u041a\".\n\n\U0001F9E9
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u0433\u0440 \u0412\u0441\u043b\u0435\u0434 \u0437\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0441\u0442\u0430\u0442\u044c\u0435\u0439 \u041d\u044d\u0448 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u044f\u0434 \u0434\u0440\u0443\u0433\u0438\u0445 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442: \"The Bargaining Problem\" (1950): \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u043e\u0432,
    \u0433\u0434\u0435 \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u0432\u044b\u0433\u043e\u0434\u044b
    \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438.
    \"Non-cooperative Games\" (1951): \u0420\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0430\u044f
    \u0432\u0435\u0440\u0441\u0438\u044f \u0435\u0433\u043e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u0432 Annals of Mathematics, \u0433\u0434\u0435 \u0431\u044b\u043b\u0430 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0430 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f
    \u0434\u043b\u044f \u0438\u0433\u0440 \u0441 \u043b\u044e\u0431\u044b\u043c \u0447\u0438\u0441\u043b\u043e\u043c
    \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432. \"Two-person Cooperative Games\"
    (1953): \u0420\u0430\u0431\u043e\u0442\u0430, \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0430\u044f
    \u043a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u043c \u0438\u0433\u0440\u0430\u043c,
    \u0433\u0434\u0435 \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043a\u0430\u043a \"\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430
    \u041d\u044d\u0448\u0430\" \u2014 \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0441\u0432\u0435\u0441\u0442\u0438
    \u0432\u0441\u0435 \u043a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043a \u043d\u0435\u043a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u043e\u0441\u043d\u043e\u0432\u0435.\n\n\U0001F9CA \u0427\u0438\u0441\u0442\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0413\u0435\u043d\u0438\u0439
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e \u0441 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0438\u0433\u0440, \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 1950-\u0445 \u0433\u043e\u0434\u043e\u0432
    \u041d\u044d\u0448 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u043d\u0435 \u0443\u0441\u0442\u0443\u043f\u0430\u044e\u0442
    \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c \u0432
    \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435 \u0438, \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e
    \u043c\u043d\u043e\u0433\u0438\u0445, \u0441\u0442\u0430\u0432\u044f\u0442 \u0435\u0433\u043e
    \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434 \u0441 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f.\n\n\U0001F4D0
    \u0422\u0435\u043e\u0440\u0435\u043c\u044b \u041d\u044d\u0448\u0430 \u043e \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u0438
    (Nash Embedding Theorems) \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c\u0442\u0435,
    \u0447\u0442\u043e \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u043d\u043e\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0441\u0444\u0435\u0440\u044b).
    \u0422\u0435\u043e\u0440\u0435\u043c\u044b \u041d\u044d\u0448\u0430, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u0432 1954 \u0438 1956 \u0433\u043e\u0434\u0430\u0445, \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0442
    \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441: \u043c\u043e\u0436\u043d\u043e \u043b\u0438
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u044c \u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e,
    \u043f\u043b\u043e\u0441\u043a\u043e\u0433\u043e \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430, \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0432\u0441\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    (\u0442\u043e \u0435\u0441\u0442\u044c \u0431\u0435\u0437 \u0440\u0430\u0441\u0442\u044f\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0441\u0436\u0430\u0442\u0438\u0439)?. \u041d\u044d\u0448 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0434\u0430, \u043b\u044e\u0431\u043e\u0435 \u0442\u0430\u043a\u043e\u0435
    \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    (\u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435)
    \u043c\u043e\u0436\u043d\u043e \"\u0432\u043b\u043e\u0436\u0438\u0442\u044c\" \u0432 \u043f\u043b\u043e\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u0439
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438, \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432
    \u0432\u0441\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0434\u043b\u044f C\u00b9-\u0433\u043b\u0430\u0434\u043a\u0438\u0445 \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u0439
    (1954): \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u043a\u0430\u043a \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u041d\u044d\u0448\u0430-\u041a\u043e\u0439\u043f\u0435\u0440\u0430,
    \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u041e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f,
    \u043b\u044e\u0431\u043e\u0435 \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u043d\u043e\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u043c\u043e\u0436\u043d\u043e
    \u043e\u0447\u0435\u043d\u044c \u0433\u043b\u0430\u0434\u043a\u043e (C\u00b9) \u0432\u043b\u043e\u0436\u0438\u0442\u044c
    \u0432 \u043f\u043b\u043e\u0441\u043a\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e,
    \u043f\u0440\u0438\u0447\u0435\u043c \u0434\u0430\u0436\u0435 \u0432 \u0441\u043a\u043e\u043b\u044c
    \u0443\u0433\u043e\u0434\u043d\u043e \u043c\u0430\u043b\u0443\u044e \u0435\u0433\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u044c.
    \u042d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438 (\u043a\u043e\u0442\u043e\u0440\u0430\u044f,
    \u043a\u0430\u043a \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u0433\u043b\u0430\u0434\u043a\u043e \u0432\u043b\u043e\u0436\u0435\u043d\u0430
    \u0432 \u0442\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0431\u0435\u0437 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u0438\u0439) \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u0421\u00b9-\u0432\u043b\u043e\u0436\u0435\u043d\u0430 \u0432
    \u0432\u0438\u0434\u0435 \u0433\u043b\u0430\u0434\u043a\u043e\u0439, \u043d\u043e \"\u0441\u043c\u043e\u0440\u0449\u0435\u043d\u043d\u043e\u0439\"
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0432\u043d\u0443\u0442\u0440\u0438
    \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u0448\u0430\u0440\u0430. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0434\u043b\u044f C\u1d4f-\u0433\u043b\u0430\u0434\u043a\u0438\u0445 \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u0439
    (1956, k\u22653): \u042d\u0442\u043e \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438
    \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u0435\u0435 \u0441\u043b\u043e\u0436\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430. \u041e\u043d\u0430 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u043e\u043b\u0435\u0435
    \u0433\u043b\u0430\u0434\u043a\u0438\u0445 (\u0434\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439
    \u0433\u043b\u0430\u0434\u043a\u043e\u0441\u0442\u0438) \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u0439,
    \u043d\u043e \u0443\u0436\u0435 \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438. \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e
    \u043e\u0442 \u041d\u044d\u0448\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a...\n\n\U0001F6E0\ufe0f
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u041d\u044d\u0448\u0430 \u2014 \u041c\u043e\u0437\u0435\u0440\u0430
    (Nash\u2013Moser theorem) \u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u0433\u043b\u0430\u0434\u043a\u0438\u0445
    \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u0445 \u041d\u044d\u0448 \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0441\u044f
    \u0441 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439 \"\u043f\u043e\u0442\u0435\u0440\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445\" \u2014 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438.
    \u0422\u043e\u0433\u0434\u0430 \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043c\u043e\u0449\u043d\u044b\u0439 \u043d\u043e\u0432\u044b\u0439 \u043c\u0435\u0442\u043e\u0434,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 \u043c\u043e\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c
    \u043c\u0435\u0442\u043e\u0434\u0435 \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0441\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u044f.
    \u042d\u0442\u0430 \u0442\u0435\u0445\u043d\u0438\u043a\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u0437\u0436\u0435
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0430 \u042e\u0440\u0433\u0435\u043d\u043e\u043c
    \u041c\u043e\u0437\u0435\u0440\u043e\u043c (\u0434\u043b\u044f \u0437\u0430\u0434\u0430\u0447
    \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438)
    \u0438 \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u043a\u0430\u043a \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u041d\u044d\u0448\u0430 \u2014
    \u041c\u043e\u0437\u0435\u0440\u0430 \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0434\u043b\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445.\n\n\U0001F525 \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0414\u0435 \u0414\u0436\u043e\u0440\u0434\u0436\u0438 \u2014 \u041d\u044d\u0448\u0430
    \u2014 \u041c\u043e\u0437\u0435\u0440\u0430 (1958) \u0412 1958 \u0433\u043e\u0434\u0443
    \u041d\u044d\u0448 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0443
    \"Continuity of solutions of parabolic and elliptic equations\". \u0412 \u043d\u0435\u0439
    \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043e \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445 \u0441 \u0440\u0430\u0437\u0440\u044b\u0432\u043d\u044b\u043c\u0438
    \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438. \u041e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0442\u0430\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0434\u0430\u0436\u0435 \u043f\u0440\u0438
    \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0433\u043b\u0430\u0434\u043a\u043e\u0441\u0442\u0438
    \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u043c\u0438
    \u0438 \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u044e\u0442 \u0443\u0441\u043b\u043e\u0432\u0438\u044e
    \u0413\u0451\u043b\u044c\u0434\u0435\u0440\u0430. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u0441\u0434\u0435\u043b\u0430\u043d\u043d\u043e\u0435 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u042d\u043d\u043d\u0438\u043e \u0414\u0435 \u0414\u0436\u043e\u0440\u0434\u0436\u0438,
    \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u043a\u0430\u043c\u043d\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0438 \u043d\u0430\u0448\u043b\u043e
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432\u043e \u043c\u043d\u043e\u0433\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u0444\u0438\u0437\u0438\u043a\u0438 \u0438
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438. \u0414\u0436\u043e\u043d \u041d\u044d\u0448
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0441\u043b\u0435\u0434 \u0432 \u043d\u0430\u0443\u043a\u0435. \u0412 \u043a\u0430\u0436\u0434\u043e\u0439
    \u0438\u0437 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u043d \u043a\u0430\u0441\u0430\u043b\u0441\u044f, \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0446\u0435\u043b\u044b\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f
    \u0442\u044b\u0441\u044f\u0447\u0438 \u0443\u0447\u0435\u043d\u044b\u0445 \u043f\u043e \u0441\u0435\u0439
    \u0434\u0435\u043d\u044c. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u2014
    \u044d\u0442\u043e \u0440\u0435\u0434\u043a\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u044f \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438, \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0438 \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u0438
    \u0432 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u0437\u0430\u0434\u0430\u0447.
    \u041e\u0442 \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043d\u0430 \u0440\u044b\u043d\u043a\u0435 \u0434\u043e
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u2014 \u0435\u0433\u043e \u0438\u0434\u0435\u0438
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0438 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0442\u044c."
  achievementsEn: "John Cesh left behind not one but, indeed, several great scientific legacys, his contribution to science can be compared to a series of fundamental breakthroughs in very different fields, each of which has changed the face of modern mathematics and economics.In his career, he published only about two dozen works, but their depth and influence are such that his scientific heritage is divided into two vast, almost non-cross-cutting areas: game theory and pure mathematics.\n\n==========================================================)==========)===========)======)=======)=============)============)============)========)===========)===============)==================================================================================\n\nIn 1950, as a 22-year-old graduate student of Princeton, Cesh published an article entitled \"Equilibrium Points in N-Person Games\" in Proceedings of the National Academy of Sciences (PNAS).The basic idea is that Cesh has defined balance as a set of strategies, one for each player, where no player can improve his or her performance by changing his or her strategy on his or her own, provided that the other players do not change their strategies. Simply put, this is a situation where no one can be expected to deviate from the chosen course of action if the others do the same.This is a stable state of play, a predictable outcome for rational players. The theory of existence: The key achievement of Cesh was not only to define, but also to provide strict mathematical proof that for any final game (with any number of players) there is at least one balance, perhaps in \"mixed strategies\" (when the player randomly chooses between several actions with a certain probability).\n\nThe Cesh concept has become the cornerstone of modern economic theory, allowing analysis of any strategic interaction from market competition and auctions to political negotiations and international conflicts.\n\nOther works on game theory Following a famous article by CEsh published a number of other fundamental works: \"The Bargaining Problem\" (1950): Classic work on negotiating theory, where he proposed a solution to the problem of sharing benefits between the two sides. \"Non-cooperative Games\" (1951): The unveiled version of his thesis at Annals of Mathematics, where his theory was detailed for games with any number of participants.\"Two-person Cooperative Games\" (1953): Work on cooperative games, where he laid the foundation for what later became known as the \"Cesh programme\", an attempt to bring all cooperative solutions to a non-cooperative basis.\n\n♪ Clean Mathematics: Genius Differential Geometry and Analysis parallels Game Theory, in the early 1950s Cesh revolutionized pure mathematics, and its work in this field is not as complex and deep as its achievements in the economy and, in the view of many, it is in line with the greatest mathematicians of the century.\n\nThe Cesh's in-house theorems (Nash Embedding Theorems) Imagine that you have curved space (e.g. sphere surface). The Cesh's theorems published in 1954 and 1956 answer the question: can you imagine this space as part of a normal, flat euclides of space while preserving all distances (i.e. without stretching and compressions)?Cesh proved that, yes, any such curved space (remanic diversity) can be \"into a flat space of larger dimensions, keeping all distances. The theory for C1-glazed investments (1954): This work, known as the Cesh-Coyper Theorem, contains a paradoxical result. It turns out that any curved space can be very smooth (C1) into a flat space, even in a small area.This means, for example, that the surface of the hyperbolic plane (which is known to be unsustained in a three-dimensional space without distortion) can be inserted in a smooth but \"slipped\" surface within a tiny ball. Theorem for Ck-stripping investments (1956, k≥3): It is technically much more complex.It guarantees the existence of smoother (up to infinite smoothness) investments, but already in space large enough size. The proof of this theorem required Cesh to create a fundamentally new mathematical apparatus, now known as...\n\nThe Cesh - Moser (Nash - Moser Theorem) Theorem was the problem of \"lost derivatives\" – the standard methods – when it developed a powerful new method based on Newton's modified method using smoothing operators.This technique was later consolidated by Jürgen Mozer (for tasks of celestial mechanics) and is now known as the Cesh-Moser Theorem, one of the most important tools to prove the existence of solutions to complex non-linear differential equations in private derivatives.\n\nIn 1958, Cesh published \"Continuity of solutions of parabolic and elliptical dimensions\", in which he proved the fundamental result of the regularity of solutions to equal elliptical and parabolic equations in private derivatives with bursting coefficients.It turns out that solutions to such equations, even if the coefficients were not smooth, are necessarily continuous and satisfy the Goelder condition. This discovery, made independently of Ennio De Georgie, became one of the cornerstones of modern differential equation theory and found application in many fields of physics and mechanics.In each of the areas he addressed, he created a whole set of directions that thousands of scientists have been doing to date, his work is a rare example of a combination of deep intuition, technical skill, and courage in setting tasks. From analysing the behavior of the players in the market to describing the geometry of the universe, his ideas continue to work and inspire."
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u0414\u0436\u043e\u043d\u0430 \u041d\u044d\u0448\u0430 \u0431\u044b\u043b\u0430
    \u043f\u043e\u043b\u043d\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445
    \u0432\u0437\u043b\u0435\u0442\u043e\u0432, \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0430\u0434\u0435\u043d\u0438\u0439 \u0438 \u0441\u0442\u043e\u043b\u044c \u0436\u0435
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f.
    \u042d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0433\u0435\u043d\u0438\u044f,
    \u0447\u044c\u044f \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c,
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0438 \u0431\u043e\u0440\u044c\u0431\u0430
    \u0441 \u0431\u043e\u043b\u0435\u0437\u043d\u044c\u044e \u0431\u044b\u043b\u0438 \u0442\u0430\u043a
    \u0436\u0435 \u0441\u043b\u043e\u0436\u043d\u044b, \u043a\u0430\u043a \u0438 \u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438.\n\n\U0001F3E1
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u0441\u0435\u043c\u044c\u044f \u0414\u0436\u043e\u043d
    \u0424\u043e\u0440\u0431\u0441 \u041d\u044d\u0448-\u043c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 13 \u0438\u044e\u043d\u044f 1928 \u0433\u043e\u0434\u0430
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u043b\u0443\u0444\u0438\u043b\u0434,
    \u0448\u0442\u0430\u0442 \u0417\u0430\u043f\u0430\u0434\u043d\u0430\u044f \u0412\u0438\u0440\u0433\u0438\u043d\u0438\u044f.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0414\u0436\u043e\u043d \u0424\u043e\u0440\u0431\u0441
    \u041d\u044d\u0448-\u0441\u0442\u0430\u0440\u0448\u0438\u0439, \u0431\u044b\u043b \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c-\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u043a\u043e\u043c,
    \u0430 \u043c\u0430\u0442\u044c, \u041c\u0430\u0440\u0442\u0430 \u0412\u0438\u0440\u0434\u0436\u0438\u043d\u0438\u044f
    \u041c\u0430\u0440\u0442\u0438\u043d, \u0434\u043e \u0437\u0430\u043c\u0443\u0436\u0435\u0441\u0442\u0432\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u0439
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439. \u0412 1930 \u0433\u043e\u0434\u0443
    \u0443 \u043d\u0435\u0433\u043e \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u043c\u043b\u0430\u0434\u0448\u0430\u044f
    \u0441\u0435\u0441\u0442\u0440\u0430 \u041c\u0430\u0440\u0442\u0430. \u0421\u0435\u043c\u044c\u044f
    \u0436\u0438\u043b\u0430 \u0432 \u0434\u043e\u0441\u0442\u0430\u0442\u043a\u0435, \u0442\u0430\u043a
    \u043a\u0430\u043a \u043e\u0442\u0435\u0446 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0434\u0430\u0436\u0435 \u0432 \u0433\u043e\u0434\u044b
    \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438.
    \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u041d\u044d\u0448 \u0431\u044b\u043b
    \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c \u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u043a\u043d\u0438\u0433\u0438 \u0438\u0433\u0440\u0430\u043c \u0441\u043e \u0441\u0432\u0435\u0440\u0441\u0442\u043d\u0438\u043a\u0430\u043c\u0438.
    \u041e\u043d \u0431\u044b\u043b \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043d\u0430\u0441\u0432\u0438\u0441\u0442\u044b\u0432\u0430\u0442\u044c \u0446\u0435\u043b\u044b\u0435
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f.
    \u0412 \u0448\u043a\u043e\u043b\u0435 \u0435\u0433\u043e \u0434\u0430\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438
    \u043c\u0435\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c, \u043d\u043e,
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u044d\u0442\u043e \u0431\u044b\u043b\u043e
    \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435\u043c \u0441\u043a\u0443\u043a\u0438.
    \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442
    \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b \u0432 14 \u043b\u0435\u0442, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b \u043a\u043d\u0438\u0433\u0443
    \u042d\u0440\u0438\u043a\u0430 \u0422. \u0411\u0435\u043b\u043b\u0430 \"\u0412\u0435\u043b\u0438\u043a\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\". \u042d\u0442\u043e \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b\u043e
    \u0432 \u043d\u0435\u043c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0438 \u043e\u043d
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u043c\u0430\u043b\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0424\u0435\u0440\u043c\u0430.
    \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0438
    \u0435\u0433\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435, \u0437\u0430\u043f\u0438\u0441\u0430\u0432
    \u043d\u0430 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043a\u0443\u0440\u0441\u044b \u0432 \u043c\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u043e\u043b\u043b\u0435\u0434\u0436.\n\n\U0001F393
    \u0423\u0447\u0451\u0431\u0430 \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0412 1945 \u0433\u043e\u0434\u0443 \u041d\u044d\u0448 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u041a\u0430\u0440\u043d\u0435\u0433\u0438
    (\u043d\u044b\u043d\u0435 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041a\u0430\u0440\u043d\u0435\u0433\u0438-\u041c\u0435\u043b\u043b\u043e\u043d) \u043f\u043e
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438 \u0414\u0436\u043e\u0440\u0434\u0436\u0430
    \u0412\u0435\u0441\u0442\u0438\u043d\u0433\u0430\u0443\u0437\u0430. \u041e\u043d \u043d\u0430\u0447\u0430\u043b
    \u0441 \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0448\u0438\u043d\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f,
    \u043d\u043e \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0445\u0438\u043c\u0438\u044e, \u0430 \u0437\u0430\u0442\u0435\u043c, \u043f\u043e
    \u0441\u043e\u0432\u0435\u0442\u0443 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0414\u0436\u043e\u043d\u0430 \u041b\u0430\u0439\u0442\u0442\u043e\u043d\u0430 \u0421\u0438\u043d\u0434\u0436\u0430,
    \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0417\u0430
    \u0442\u0440\u0438 \u0433\u043e\u0434\u0430 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430 \u0438 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430.
    \u0415\u0433\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c,
    \u0420\u0438\u0447\u0430\u0440\u0434 \u0414\u0430\u0444\u0444\u0438\u043d, \u0434\u0430\u043b
    \u0435\u043c\u0443 \u0441\u0430\u043c\u0443\u044e \u043b\u0430\u043a\u043e\u043d\u0438\u0447\u043d\u0443\u044e
    \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044e \u0434\u043b\u044f
    \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443,
    \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0438\u0437 \u043e\u0434\u043d\u043e\u0433\u043e
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f: \"\u042d\u0442\u043e\u0442
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u2014 \u0433\u0435\u043d\u0438\u0439\". \u041d\u044d\u0448
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u043e\u0442 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0430 \u0438 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0430
    \u0438 \u0432\u044b\u0431\u0440\u0430\u043b \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439.
    \u0412 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435, \u0433\u0434\u0435 \u0446\u0430\u0440\u0438\u043b\u0430
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \"\u0437\u043e\u043b\u043e\u0442\u043e\u0433\u043e \u0432\u0435\u043a\u0430\", \u043e\u043d
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b \u0442\u0430\u043a\u0438\u0445 \u0441\u0432\u0435\u0442\u0438\u043b,
    \u043a\u0430\u043a \u0410\u043b\u044c\u0431\u0435\u0440\u0442 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d
    \u0438 \u0414\u0436\u043e\u043d \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d.
    \u0412 1950 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    22 \u043b\u0435\u0442, \u043e\u043d \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043e\u0431\u044a\u0435\u043c\u043e\u043c
    \u0432\u0441\u0435\u0433\u043e 28 \u0441\u0442\u0440\u0430\u043d\u0438\u0446, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \"\u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u044f \u041d\u044d\u0448\u0430\".\n\n\U0001F4BC
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0451\u043d\u044b\u043c\u0438
    \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0449\u0438\u0442\u044b \u041d\u044d\u0448 \u043d\u0435\u0434\u043e\u043b\u0433\u043e
    \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0441\u0442\u0430\u043b \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u043e\u043c
    \u0432 RAND Corporation \u2014 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0446\u0435\u043d\u0442\u0440\u0435
    \u0432\u0440\u0435\u043c\u0435\u043d \u0425\u043e\u043b\u043e\u0434\u043d\u043e\u0439 \u0432\u043e\u0439\u043d\u044b.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0440\u0430\u0437\u0433\u0430\u0440 \u043c\u0430\u043a\u043a\u0430\u0440\u0442\u0438\u0437\u043c\u0430
    \u0435\u0433\u043e \u0443\u0432\u043e\u043b\u0438\u043b\u0438 \u043e\u0442\u0442\u0443\u0434\u0430
    \u043a\u0430\u043a \"\u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e
    \u0443\u0433\u0440\u043e\u0437\u0443 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438\".
    \u0412 1951 \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 \u041c\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441\u043a\u043e\u043c
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 (MIT). \u0412 MIT, \u0431\u0443\u0434\u0443\u0447\u0438
    \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c,
    \u041d\u044d\u0448 \u0431\u043b\u0438\u0441\u0442\u0430\u043b, \u0440\u0435\u0448\u0430\u044f
    \u0437\u0430\u0434\u0430\u0447\u0438, \u0441\u0447\u0438\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044f
    \"\u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c\u0438\". \u0415\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u043f\u043e \u0446\u0435\u0445\u0443
    \u0431\u044b\u043b\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u044b \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438: \u041d\u043e\u0440\u0431\u0435\u0440\u0442 \u0412\u0438\u043d\u0435\u0440,
    \u0414\u0436\u043e\u043d \u041c\u0438\u043b\u043d\u043e\u0440, \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a, \u041a\u0435\u043d\u043d\u0435\u0442
    \u042d\u0440\u0440\u043e\u0443, \u0420\u043e\u0431\u0435\u0440\u0442 \u0421\u043e\u043b\u043e\u0443
    \u0438 \u041f\u043e\u043b \u0421\u0430\u043c\u0443\u044d\u043b\u044c\u0441\u043e\u043d.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435, \u0435\u0433\u043e \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0435
    \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0432\u044b\u043a\u043e\u0432
    \u0447\u0430\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u0438 \u0435\u0433\u043e \u043e\u0434\u0438\u043d\u043e\u043a\u0438\u043c
    \u0438 \u0434\u0430\u0436\u0435 \"\u043d\u0435\u0432\u044b\u043d\u043e\u0441\u0438\u043c\u044b\u043c\"
    \u0432 \u0433\u043b\u0430\u0437\u0430\u0445 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0445.\n\n\u2764\ufe0f
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438 \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u041d\u044d\u0448\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u043f\u0443\u0442\u0430\u043d\u043d\u043e\u0439:
    \u0412 1953 \u0433\u043e\u0434\u0443 \u0443 \u043d\u0435\u0433\u043e \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0441\u044b\u043d \u0414\u0436\u043e\u043d \u0414\u044d\u0432\u0438\u0434 \u0421\u0442\u0438\u0440
    \u043e\u0442 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439 \u0441 \u042d\u043b\u0435\u043e\u043d\u043e\u0440
    \u0421\u0442\u0438\u0440, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d
    \u0442\u0430\u043a \u0438 \u043d\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f. \u0412
    \u0444\u0435\u0432\u0440\u0430\u043b\u0435 1957 \u0433\u043e\u0434\u0430 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0410\u043b\u0438\u0441\u0438\u0438 \u041b\u043e\u043f\u0435\u0441-\u0425\u0430\u0440\u0440\u0438\u0441\u043e\u043d
    \u0434\u0435 \u041b\u0430\u0440\u0434\u0435, \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u043e\u0439
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043a\u0435-\u0444\u0438\u0437\u0438\u043a\u0435
    \u0438\u0437 \u0421\u0430\u043b\u044c\u0432\u0430\u0434\u043e\u0440\u0430, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0432 MIT. \u0412
    1959 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0410\u043b\u0438\u0441\u0438\u044f
    \u0431\u044b\u043b\u0430 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0430 \u0438\u0445
    \u0441\u044b\u043d\u043e\u043c \u0414\u0436\u043e\u043d\u043e\u043c \u0427\u0430\u0440\u043b\u044c\u0437\u043e\u043c
    \u041c\u0430\u0440\u0442\u0438\u043d\u043e\u043c, \u0443 \u041d\u044d\u0448\u0430 \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c
    \u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430. \u0411\u043e\u043b\u0435\u0437\u043d\u044c
    \u041d\u044d\u0448\u0430, \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u043a\u0430\u043a \u043f\u0430\u0440\u0430\u043d\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u0430\u044f
    \u0448\u0438\u0437\u043e\u0444\u0440\u0435\u043d\u0438\u044f, \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043b\u0430
    \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0438 \u0431\u0440\u0430\u043a.
    \u0412 1963 \u0433\u043e\u0434\u0443 \u043e\u043d\u0438 \u0441 \u0410\u043b\u0438\u0441\u0438\u0435\u0439
    \u0440\u0430\u0437\u0432\u0435\u043b\u0438\u0441\u044c. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u043f\u0438\u0441\u043a\u0438 \u0438\u0437 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u044b
    \u0432 1970 \u0433\u043e\u0434\u0443 \u0410\u043b\u0438\u0441\u0438\u044f, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0434, \u043f\u0440\u0438\u043d\u044f\u043b\u0430
    \u0435\u0433\u043e \u0432 \u0441\u0432\u043e\u0439 \u0434\u043e\u043c \u043a\u0430\u043a
    \"\u0436\u0438\u043b\u044c\u0446\u0430\" (boarder), \u0447\u0442\u043e \u0441\u043f\u0430\u0441\u043b\u043e
    \u0435\u0433\u043e \u043e\u0442 \u0431\u0435\u0437\u0434\u043e\u043c\u043d\u043e\u0441\u0442\u0438.
    \u0418\u0445 \u0441\u044b\u043d, \u0442\u043e\u0436\u0435 \u043e\u0434\u0430\u0440\u0435\u043d\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0432 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432\u043e\u043c
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u043b
    \u0448\u0438\u0437\u043e\u0444\u0440\u0435\u043d\u0438\u0435\u0439. \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u041d\u044d\u0448\u0430 \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u043f\u043e\u0441\u043b\u0435
    \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438\u0441\u044c.
    \u041e\u043d \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0441\u044f \u0432 \"\u043f\u0440\u0438\u0437\u0440\u0430\u0447\u043d\u0443\u044e\"
    \u0444\u0438\u0433\u0443\u0440\u0443 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0430,
    \u0433\u0434\u0435 \u0435\u0433\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u0438
    \u0442\u0435\u0440\u043f\u0435\u043b\u0438, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044f
    \u0431\u0440\u043e\u0434\u0438\u0442\u044c \u043f\u043e \u043a\u0430\u043c\u043f\u0443\u0441\u0443
    \u0438 \u043f\u0438\u0441\u0430\u0442\u044c \u043d\u0430 \u0434\u043e\u0441\u043a\u0430\u0445.
    \u0413\u043e\u0434\u044b \u0448\u043b\u0438, \u0438 \u0435\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435
    \u043d\u0430\u0447\u0430\u043b\u043e \u0443\u043b\u0443\u0447\u0448\u0430\u0442\u044c\u0441\u044f.
    \u0412 2001 \u0433\u043e\u0434\u0443, \u0447\u0435\u0440\u0435\u0437 38 \u043b\u0435\u0442
    \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0437\u0432\u043e\u0434\u0430, \u043e\u043d\u0438
    \u0441 \u0410\u043b\u0438\u0441\u0438\u0435\u0439 \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c
    \u0432\u043d\u043e\u0432\u044c.\n\n\U0001F31F \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u043c\u0435\u0440\u0442\u044c
    \u0412\u0435\u0440\u0448\u0438\u043d\u043e\u0439 \u0435\u0433\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435
    \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    \u043f\u043e \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435 \u0432 1994 \u0433\u043e\u0434\u0443
    \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u0433\u0440, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0443\u044e \u0435\u0449\u0451
    \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0435. \u0417\u0430
    \u043a\u0443\u043b\u0438\u0441\u0430\u043c\u0438 \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u043c\u0438\u0442\u0435\u0442\u0430 \u0448\u043b\u0430 \u0431\u043e\u0440\u044c\u0431\u0430
    \u0437\u0430 \u0442\u043e, \u0441\u0442\u043e\u0438\u0442 \u043b\u0438 \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0430\u0442\u044c
    \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u0447\u0438\u0442\u0430\u043b\u0438
    \"\u0431\u0435\u0437\u0443\u043c\u043d\u044b\u043c\". \u041e\u043d \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u043b
    \u043f\u0440\u0435\u043c\u0438\u044e \u0441 \u0420\u0435\u0439\u043d\u0445\u0430\u0440\u0434\u043e\u043c
    \u0417\u0435\u043b\u044c\u0442\u0435\u043d\u043e\u043c \u0438 \u0414\u0436\u043e\u043d\u043e\u043c
    \u0425\u0430\u0440\u0441\u0430\u043d\u044c\u0438. \u0412 2015 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e \u2014 \u043e\u0434\u043d\u0443 \u0438\u0437 \u0432\u044b\u0441\u0448\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    23 \u043c\u0430\u044f 2015 \u0433\u043e\u0434\u0430, \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044f\u0441\u044c
    \u0438\u0437 \u041e\u0441\u043b\u043e, \u0433\u0434\u0435 \u0435\u043c\u0443 \u0432\u0440\u0443\u0447\u0438\u043b\u0438
    \u043f\u0440\u0435\u043c\u0438\u044e, 86-\u043b\u0435\u0442\u043d\u0438\u0439 \u0414\u0436\u043e\u043d
    \u041d\u044d\u0448 \u0438 \u0435\u0433\u043e 82-\u043b\u0435\u0442\u043d\u044f\u044f \u0436\u0435\u043d\u0430
    \u0410\u043b\u0438\u0441\u0438\u044f \u043f\u043e\u0433\u0438\u0431\u043b\u0438 \u0432 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0439
    \u0430\u0432\u0430\u0440\u0438\u0438 \u0432 \u041d\u044c\u044e-\u0414\u0436\u0435\u0440\u0441\u0438."
  personalLifeEn: "John Cesh's life was full of incredible ups, tragic falls and as amazing a return as his genius's story, whose personal life, relationships and struggle with the disease were as complex as his mathematical theories.\n\n==Early life==The family was born on June 13, 1928, in Blufield, West Virginia, and his father, John Forbes Cesch Sr., was an electric engineer, and his mother, Martha Virginia Martin, worked as a schoolteacher before his marriage.When he was a kid, Cesh was a closed man and preferred books to play games with peers. He was able, for example, to whistle whole classics. He was even thought to be slow at school, but probably because of boredom. The break was 14 years old when he read Eric T. Bell's book Great Mathematics, which inspired him to have a serious interest in mathematics, and he himself proved the small theorem of Farm.His parents supported his passion by enrolling in additional courses at the local college.\n\n==Chess=======Career=========Career=====Cesch entered the Carnegie Institute of Technology (now Carnegie-Mellon University) on a scholarship from George Westingus in 1945, starting with a chemical engineering project, but moving quickly to chemistry, and then, on the advice of Professor John Lightton Singe, he finally stopped at the math level, and in three years he received a bachelor's and master's degree.His teacher, Richard Daphine, gave him the most concise recommendation for his post-graduate studies, which consisted of one sentence: \"This man is a genius.\" Cesh received offers from Harvard and Princeton and chose the last one, and in Princeton, where a mathematical \"golden age\" atmosphere prevailed, he met a radiant like Albert Einstein and John von Neuman.In 1950, at the age of 22, he defended a doctoral thesis of only 28 pages, which contained the definition of \"Cesh balance\".\n\nAfter protecting him, Cesh worked briefly in Princeton and then became a consultant at RAND Corporation, a strategic analysis centre of the Cold War, but in the midst of the macartism, he was fired as a potential security threat.At the MlT, as a young professor, Cesh was brilliant in dealing with \"unable\" tasks, and his colleagues at the workshop were distinguished mathematicians and economists at the time: Norbert Winer, John Milnor, Alexander Grotendick, Kenneth Arrow, Robert Solow and Paul Samuelson. Despite his professional recognition, his eccentric behaviour and lack of social skills often made him lonely and even \"unable\" in the eyes of others.\n\nIn 1953, he had a son, John David Stir, born of a relationship with Eleanor Styr, whom he never married. In February 1957, he married Alicia López Harrison de Larde, a talented physical student from El Salvador, who he met at MIT.In 1959, when Alicia was pregnant with their son, John Charles Martin, Cesh began to have the first signs of mental disorder: Cesh's disease, diagnosed as paranoid schizophrenia, destroyed his career and marriage; in 1963, he and Alicia divorced; however, after his discharge from hospital in 1970, Alicia, despite the divorce, accepted him into his home as a \"hospital\" (boarder), which saved him from homelessness.Their son, also a gifted mathematician, also suffered schizophrenia in his adolescence, and Cesha's relationship with his colleagues changed after his illness, and he became a ghost figure of Princeton, where his strangeness was tolerated, allowing him to wander around campus and write on boards, and years passed and his condition began to improve. In 2001, 38 years after his divorce, he and Alicia remarried.\n\nThe recognition and tragic death of Versailles' return was the award of the 1994 Nobel Prize for Economics for work on the theory of games, written at the post-graduate level, and there was a struggle behind the scenes of the Nobel Committee for whether to award an award to a man who was considered \"crazy.\" He shared the award with Reinhard Zelten and John Harsanya. In 2015, he received the Abel Prize, one of the highest awards in mathematics.On May 23, 2015, when he returned from Oslo, where he was awarded the award, John Cesh, aged 86, and his 82-year-old wife Alicia died in a car accident in New Jersey."
  shortBioRu: "\u0414\u0436\u043e\u043d \u0424\u043e\u0440\u0431\u0441 \u041d\u044d\u0448-\u043c\u043b\u0430\u0434\u0448\u0438\u0439
    (13 \u0438\u044e\u043d\u044f 1928 \u2014 23 \u043c\u0430\u044f 2015) \u2014 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438. \u041e\u043d
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u0433\u0440, \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e,
    \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u043f\u0430\u0440\u0430\u043d\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u0438\u0437\u043e\u0444\u0440\u0435\u043d\u0438\u0435\u0439 \u0438 \u0441\u043c\u043e\u0433
    \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043a \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435. \u0415\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u0430,
    \u043f\u043e\u043b\u043d\u0430\u044f \u0432\u0437\u043b\u0435\u0442\u043e\u0432 \u0438 \u043f\u0430\u0434\u0435\u043d\u0438\u0439,
    \u0431\u044b\u043b\u0430 \u0443\u0432\u0435\u043a\u043e\u0432\u0435\u0447\u0435\u043d\u0430
    \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c \u0444\u0438\u043b\u044c\u043c\u0435
    \u00ab\u0418\u0433\u0440\u044b \u0440\u0430\u0437\u0443\u043c\u0430\u00bb.\n\n\U0001F4DC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0433\u0435\u043d\u0438\u044f \u0414\u0436\u043e\u043d \u041d\u044d\u0448 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u0411\u043b\u0443\u0444\u0438\u043b\u0434\u0435, \u0448\u0442\u0430\u0442 \u0417\u0430\u043f\u0430\u0434\u043d\u0430\u044f
    \u0412\u0438\u0440\u0433\u0438\u043d\u0438\u044f, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430-\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u043a\u0430
    \u0438 \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u044b.
    \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043e\u043d \u0431\u044b\u043b \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c
    \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c, \u0431\u043e\u043b\u044c\u0448\u0435 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u044b\u043c
    \u043a\u043d\u0438\u0433\u0430\u043c\u0438 \u0438 \u0448\u0430\u0445\u043c\u0430\u0442\u0430\u043c\u0438,
    \u0447\u0435\u043c \u0438\u0433\u0440\u0430\u043c\u0438 \u0441\u043e \u0441\u0432\u0435\u0440\u0441\u0442\u043d\u0438\u043a\u0430\u043c\u0438.
    \u0412 \u0448\u043a\u043e\u043b\u0435 \u043e\u043d \u043d\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0443\u0441\u043f\u0435\u0445\u043e\u0432
    \u0438 \u0434\u0430\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0441\u044f \u043c\u0435\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c,
    \u043f\u043e\u043a\u0430 \u0432 14 \u043b\u0435\u0442 \u0435\u043c\u0443 \u043d\u0435 \u043f\u043e\u043f\u0430\u043b\u0430\u0441\u044c
    \u043a\u043d\u0438\u0433\u0430 \u042d\u0440\u0438\u043a\u0430 \u0422. \u0411\u0435\u043b\u043b\u0430
    \u00ab\u0412\u0435\u043b\u0438\u043a\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb.
    \u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0432 \u0435\u0435, \u041d\u044d\u0448 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043c\u0430\u043b\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0424\u0435\u0440\u043c\u0430, \u0438 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0433\u0435\u043d\u0438\u0439 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0432
    \u043f\u043e\u043b\u043d\u043e\u0439 \u043c\u0435\u0440\u0435. \u0412 1945 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u041a\u0430\u0440\u043d\u0435\u0433\u0438
    (\u043d\u044b\u043d\u0435 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041a\u0430\u0440\u043d\u0435\u0433\u0438-\u041c\u0435\u043b\u043b\u043e\u043d\u0430),
    \u0433\u0434\u0435 \u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u0445\u0438\u043c\u0438\u044e \u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443,
    \u043d\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0431\u044b\u0441\u0442\u0440\u043e \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b\u0438
    \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442. \u0420\u0438\u0447\u0430\u0440\u0434
    \u0414\u0430\u0444\u0444\u0438\u043d, \u0435\u0433\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c,
    \u0434\u0430\u043b \u0435\u043c\u0443 \u0441\u0430\u043c\u0443\u044e \u043b\u0430\u043a\u043e\u043d\u0438\u0447\u043d\u0443\u044e
    \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044e \u0434\u043b\u044f
    \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443:
    \u00ab\u042d\u0442\u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u2014 \u0433\u0435\u043d\u0438\u0439!\u00bb.
    \u0412 1948 \u0433\u043e\u0434\u0443 \u041d\u044d\u0448 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435, \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0439
    \u043d\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0438\u0433\u0440
    \u0414\u0436\u043e\u043d\u0430 \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d\u0430
    \u0438 \u041e\u0441\u043a\u0430\u0440\u0430 \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d\u0430,
    \u0440\u0435\u0448\u0438\u043b \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c \u0441\u0435\u0431\u044f
    \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u041e\u043d \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435 \u043f\u043e\u0441\u0435\u0449\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438,
    \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u044f \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u0438 \u0443\u0436\u0435
    \u0432 1950 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    22 \u043b\u0435\u0442, \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043e\u0431\u044a\u0435\u043c\u043e\u043c \u0432\u0441\u0435\u0433\u043e 28 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u043d\u0430 \u0442\u0435\u043c\u0443 \u00ab\u041d\u0435\u043a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435
    \u0438\u0433\u0440\u044b\u00bb. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0436\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430
    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u00ab\u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435
    \u041d\u044d\u0448\u0430\u00bb.\n\n\U0001F4A1 \u00ab\u0420\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435
    \u041d\u044d\u0448\u0430\u00bb \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u0433\u0440: \u0414\u043e \u041d\u044d\u0448\u0430
    \u0442\u0435\u043e\u0440\u0438\u044f \u0438\u0433\u0440 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b\u0430 \u00ab\u0438\u0433\u0440\u044b
    \u0441 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0441\u0443\u043c\u043c\u043e\u0439\u00bb
    (\u0432\u044b\u0438\u0433\u0440\u044b\u0448 \u043e\u0434\u043d\u043e\u0433\u043e \u0440\u0430\u0432\u0435\u043d
    \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448\u0443 \u0434\u0440\u0443\u0433\u043e\u0433\u043e).
    \u041d\u044d\u0448 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432,
    \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0432
    \u00ab\u0438\u0433\u0440\u044b \u0441 \u043d\u0435\u043d\u0443\u043b\u0435\u0432\u043e\u0439
    \u0441\u0443\u043c\u043c\u043e\u0439\u00bb, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0432\u0441\u0435 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442
    \u043a\u0430\u043a \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c, \u0442\u0430\u043a
    \u0438 \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u0442\u044c. \u0415\u0433\u043e \u00ab\u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435
    \u041d\u044d\u0448\u0430\u00bb \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0438 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u0441\u0432\u043e\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e,
    \u0438\u0437\u043c\u0435\u043d\u0438\u0432 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044e
    \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443, \u0442\u0430\u043a \u043a\u0430\u043a
    \u044d\u0442\u043e \u0443\u0445\u0443\u0434\u0448\u0438\u0442 \u0435\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435.
    \u042d\u0442\u0430 \u0438\u0434\u0435\u044f \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0438 \u043d\u0430\u0448\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0431\u0438\u0437\u043d\u0435\u0441-\u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f\u0445,
    \u043f\u043e\u043b\u0438\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0412\u043a\u043b\u0430\u0434 \u0432 \u00ab\u0447\u0438\u0441\u0442\u0443\u044e\u00bb \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443:
    \u041f\u043e\u043c\u0438\u043c\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0438\u0433\u0440,
    \u041d\u044d\u0448 \u0432\u043d\u0435\u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0438 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0412 1950-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u041d\u044d\u0448\u0430 \u043e \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c\u0438
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0435 XX \u0432\u0435\u043a\u0430. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0440\u0435\u0448\u0438\u043b \u043e\u0434\u043d\u0443 \u0438\u0437 \u0444\u043e\u0440\u043c
    19-\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043d\u0430\u0434 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c\u0438
    \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445.
    \u0415\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u044b \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u041d\u044d\u0448\u0430 \u2014 \u041c\u043e\u0437\u0435\u0440\u0430 \u2014 \u0432\u0430\u0436\u043d\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0435. \u041a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f:
    \u041d\u044d\u0448 \u0442\u0430\u043a\u0436\u0435 \u043e\u0431\u043b\u0430\u0434\u0430\u043b
    \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439
    \u0432 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0412
    1950-\u0445 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0438\u0434\u0435\u044e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f,
    \u0447\u0442\u043e \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u043e \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.
    \u042d\u0442\u0438 \u043f\u0438\u0441\u044c\u043c\u0430 \u0431\u044b\u043b\u0438 \u0440\u0430\u0441\u0441\u0435\u043a\u0440\u0435\u0447\u0435\u043d\u044b
    \u0410\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u043e\u043c \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0421\u0428\u0410
    \u0442\u043e\u043b\u044c\u043a\u043e \u0432 2011 \u0433\u043e\u0434\u0443.\n\n\U0001F494
    \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f \u0438 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u044f\u044f
    \u0431\u043e\u0440\u044c\u0431\u0430 \u0441 \u0431\u043e\u043b\u0435\u0437\u043d\u044c\u044e
    \u041d\u0430 \u043f\u0438\u043a\u0435 \u043a\u0430\u0440\u044c\u0435\u0440\u044b, \u0432
    \u043a\u043e\u043d\u0446\u0435 1950-\u0445 \u0433\u043e\u0434\u043e\u0432, \u0443 30-\u043b\u0435\u0442\u043d\u0435\u0433\u043e
    \u041d\u044d\u0448\u0430 \u043d\u0430\u0447\u0430\u043b\u0438 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f
    \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u043f\u0430\u0440\u0430\u043d\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u0438\u0437\u043e\u0444\u0440\u0435\u043d\u0438\u0438. \u0412 1959 \u0433\u043e\u0434\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u0410\u043b\u0438\u0441\u0438\u044f
    \u0431\u044b\u043b\u0430 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0430 \u0438\u0445
    \u043f\u0435\u0440\u0432\u044b\u043c \u0441\u044b\u043d\u043e\u043c, \u043e\u043d \u0431\u044b\u043b
    \u043d\u0430\u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u043c\u0435\u0449\u0435\u043d
    \u0432 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u043b\u0438\u043d\u0438\u043a\u0443. \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043b\u0430
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c \u0438
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443. \u041d\u044d\u0448 \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0443\u0439\u0442\u0438 \u0438\u0437 \u041c\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441\u043a\u043e\u0433\u043e
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 (MIT). \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \u0441\u0435\u0431\u044f \u00ab\u043c\u0435\u0441\u0441\u0438\u0430\u043d\u0441\u043a\u043e\u0439
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439\u00bb, \u0438\u0441\u043a\u0430\u043b \u0441\u043a\u0440\u044b\u0442\u044b\u0435
    \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u044f \u0432 \u0447\u0438\u0441\u043b\u0430\u0445
    \u0438 \u0433\u0430\u0437\u0435\u0442\u0430\u0445, \u0430 \u0432 1962 \u0433\u043e\u0434\u0443
    \u0410\u043b\u0438\u0441\u0438\u044f, \u043d\u0435 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u0432,
    \u043f\u043e\u0434\u0430\u043b\u0430 \u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0434.
    \u0421 1966 \u043f\u043e 1996 \u0433\u043e\u0434 \u041d\u044d\u0448 \u043d\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043d\u0438 \u043e\u0434\u043d\u043e\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b.
    \u041e\u043d \u0441\u0442\u0430\u043b \u00ab\u043f\u0440\u0438\u0437\u0440\u0430\u043a\u043e\u043c\u00bb
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430,
    \u0433\u0434\u0435 \u0435\u043c\u0443 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u0438
    \u0431\u0440\u043e\u0434\u0438\u0442\u044c \u043f\u043e \u043a\u0430\u043c\u043f\u0443\u0441\u0443,
    \u043f\u0438\u0441\u0430\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b
    \u043d\u0430 \u0434\u043e\u0441\u043a\u0430\u0445, \u0430 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b
    \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0438\u0441\u044c
    \u043a \u043d\u0435\u043c\u0443 \u0441 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c
    \u0438 \u0441\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435\u043c.\n\n\U0001F305
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0412 1970 \u0433\u043e\u0434\u0443 \u0410\u043b\u0438\u0441\u0438\u044f, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0434, \u0432\u043d\u043e\u0432\u044c \u043f\u0440\u0438\u043d\u044f\u043b\u0430
    \u0435\u0433\u043e \u0432 \u0441\u0432\u043e\u0439 \u0434\u043e\u043c, \u0447\u0442\u043e
    \u0441\u043f\u0430\u0441\u043b\u043e \u0435\u0433\u043e \u043e\u0442 \u0431\u0435\u0437\u0434\u043e\u043c\u043d\u043e\u0441\u0442\u0438.
    \u0412 1980-\u0445 \u0433\u043e\u0434\u0430\u0445, \u0432\u043e\u043f\u0440\u0435\u043a\u0438
    \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430\u043c \u0432\u0440\u0430\u0447\u0435\u0439,
    \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u041d\u044d\u0448\u0430 \u043d\u0430\u0447\u0430\u043b\u0430
    \u043e\u0442\u0441\u0442\u0443\u043f\u0430\u0442\u044c. \u041e\u043d \u043d\u0430\u0443\u0447\u0438\u043b\u0441\u044f
    \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438
    \u0431\u0440\u0435\u0434\u043e\u0432\u044b\u0435 \u043c\u044b\u0441\u043b\u0438 \u0438 \u0441\u043c\u043e\u0433
    \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043a \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439. \u0412 1994 \u0433\u043e\u0434\u0443,
    \u0441\u043f\u0443\u0441\u0442\u044f 45 \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0441\u0432\u043e\u0435\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438,
    \u0414\u0436\u043e\u043d \u041d\u044d\u0448 \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    \u043f\u043e \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435 (\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0414\u0436. \u0425\u0430\u0440\u0441\u0430\u043d\u044c\u0438 \u0438 \u0420. \u0417\u0435\u043b\u044c\u0442\u0435\u043d\u043e\u043c)
    \u00ab\u0437\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u044f
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u043d\u0435\u043a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0433\u0440\u00bb. \u041e\u043d \u0438 \u0410\u043b\u0438\u0441\u0438\u044f \u0432\u043d\u043e\u0432\u044c
    \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c \u0432 2001 \u0433\u043e\u0434\u0443.
    \u041a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439 \u0435\u0433\u043e
    \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u043b\u043e
    \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0432 2015 \u0433\u043e\u0434\u0443
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    \u2014 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0432\u044b\u0441\u0448\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u043c\u0438\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u0437\u0430 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0422\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438,
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u0441\u043f\u0443\u0441\u0442\u044f,
    \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044f\u0441\u044c \u0438\u0437 \u041e\u0441\u043b\u043e,
    \u0433\u0434\u0435 \u0435\u043c\u0443 \u0432\u0440\u0443\u0447\u0438\u043b\u0438 \u043f\u0440\u0435\u043c\u0438\u044e,
    86-\u043b\u0435\u0442\u043d\u0438\u0439 \u0414\u0436\u043e\u043d \u041d\u044d\u0448 \u0438
    \u0435\u0433\u043e 82-\u043b\u0435\u0442\u043d\u044f\u044f \u0436\u0435\u043d\u0430 \u0410\u043b\u0438\u0441\u0438\u044f
    \u043f\u043e\u0433\u0438\u0431\u043b\u0438 \u0432 \u0430\u0432\u0430\u0440\u0438\u0438 \u0442\u0430\u043a\u0441\u0438
    \u0432 \u041d\u044c\u044e-\u0414\u0436\u0435\u0440\u0441\u0438.\n\n\U0001F3AC \u0414\u0436\u043e\u043d
    \u041d\u044d\u0448 \u0432 \u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0439 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0435
    \u0416\u0438\u0437\u043d\u044c \u041d\u044d\u0448\u0430 \u0441\u0442\u0430\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u0448\u0438\u0440\u043e\u043a\u043e\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440\u0443 \u0421\u0438\u043b\u044c\u0432\u0438\u0438
    \u041d\u0430\u0437\u0430\u0440 \u00ab\u0418\u0433\u0440\u044b \u0440\u0430\u0437\u0443\u043c\u0430\u00bb
    (1998) \u0438 \u043e\u0434\u043d\u043e\u0438\u043c\u0435\u043d\u043d\u043e\u043c\u0443 \u0444\u0438\u043b\u044c\u043c\u0443
    \u0420\u043e\u043d\u0430 \u0425\u043e\u0432\u0430\u0440\u0434\u0430 (2001), \u0433\u0434\u0435
    \u0435\u0433\u043e \u0440\u043e\u043b\u044c \u0441\u044b\u0433\u0440\u0430\u043b \u0420\u0430\u0441\u0441\u0435\u043b
    \u041a\u0440\u043e\u0443. \u0412\u0430\u0436\u043d\u043e \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c,
    \u0447\u0442\u043e \u0444\u0438\u043b\u044c\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442
    \u0445\u0443\u0434\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0432\u044b\u043c\u044b\u0441\u0435\u043b
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0438, \u0432 \u0442\u043e
    \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u0443 \u041d\u044d\u0448\u0430 \u0431\u044b\u043b\u0438
    \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u0441\u043b\u0443\u0445\u043e\u0432\u044b\u0435
    \u0433\u043e\u043b\u043e\u0441\u0430), \u043d\u043e \u0432\u0435\u0440\u043d\u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442
    \u0441\u0443\u0442\u044c \u0435\u0433\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0431\u043e\u0440\u044c\u0431\u044b \u0438 \u0442\u0440\u0438\u0443\u043c\u0444\u0430."
  shortBioEn: "John Forbes CEsch Jr. (13 June 1928 – 23 May 2015) was an American mathematician whose life was one of the most incredible stories in the history of science. He revolutionized game theory, won the Nobel Prize, survived decades of severe struggles against paranoid schizophrenia, and was able to return to scientific work.\n\n==Early years and genius==John Cesh was born in Bluefield, West Virginia, in the family of an electric engineer and a schoolteacher, a child who was more engaged in books and chess than in games with peers, and who wasn't very successful at school, and was even considered slow until he was 14 years old, he had a book by Eric T. Bell, \"Great Mathematics\".After reading it, Cesh himself proved the small theorem of Ferm, and his math genius was fully demonstrated. In 1945, he entered the Carnegie Institute of Technology (now Carnegie-Mellon University), where he tried to study chemistry and economics, but eventually stopped at mathematics, and the professors quickly saw his talent.Richard Daphine, his teacher, gave him the most concise recommendation for his postgraduate studies: \"This man is a genius!\" In 1948, Cesh went to Princeton University, where, inspired by the new game theory of John von Neumann and Oscar Morgenstern, decided to devote himself to this area.He had hardly attended a lecture, preferred a study of his own, and as early as 1950, at the age of 22, he had protected a thesis of only 28 pages on the topic \"Non-operative Games\", which contained a definition and properties of the concept, which was later referred to as \"Cesh Balance\".\n\n===\"Equity Cesh\"====The game theory revolution: BCEsha's game theory mainly considered \"zero-sum games\" (wins of one is equal to lose of the other).Cesh made a breakthrough by analysing \"non-zero-sum games\" in which all players can win and lose.His \"Cesha Balance\" describes a situation in which no player can improve his position by changing his strategy alone because it will make his position worse. This idea has become the basis for modern economic theory and has been applied in business strategies, political science and biology. Contribution to \"clean\" mathematics: besides game theory, Cesh has made a huge contribution to differential geometry and differential equation theory.In the 1950s, he proved Cesh's investment theorems, which are considered to be one of the most original results in the 20th century geometric analysis, and he solved one of Gilbert's 19th problems by working on equations in private derivatives, and his methods in this field led to the creation of the Cesh-Moser theorem, an important tool in mathematical analysis. Cryptography: Cesh also had amazing intuition in cryptography.In the 1950s, he proposed the idea of using the theory of computational complexity to encrypt, which was decades ahead of its time, and these letters were declassified by the US National Security Agency only in 2011.\n\nIn 1959, when his wife Alicia was pregnant with their first son, he was forcibly placed in a psychiatric clinic, and the disease destroyed his privacy and career.He thought he was a \"Messian figure\", looking for hidden messages in numbers and newspapers, and in 1962, Alicia failed to stand up to divorce. From 1966 to 1996, Cesh did not publish any research; he became a \"ghost\" at Princeton University, where he was allowed to wander around campus, write strange formulas on the boards, and students and teachers treated him with respect and compassion.\n\nIn 1970, Alicia returned to his home despite his divorce, which saved him from homelessness. In the 1980s, contrary to medical estimates, Cesha's disease began to retreat. He learned to ignore his delusional thoughts and was able to return to math. In 1994, 45 years after writing his thesis, John Cesh was awarded the Nobel Prize in Economics (with J. Harsanya and R.He and Alicia were remarried in 2001 and his return culminated in the award of the Abel Prize in 2015, one of the world's highest math awards, for contributing to the theory of differential equations.Tragically, a few days later, returning from Oslo, where he was awarded a bonus, his 86-year-old John Cesh and his 82-year-old wife Alicia died in a taxi accident in New Jersey.\n\n===Chess===John Cesh in the mass culture, Cesha's life has become known to the general public thanks to the best-selling host, Sylvia Nazar, \"The Games of Mind\" (1998), and Ron Howard (2001), where he played his role. It is important to note that the film contains artistic fiction (e.g. visual hallucinations, while Cesha had mainly hearing voices) but rightly conveys the essence of his amazing struggle and triumph."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0414\u0436\u043e\u043d\u0430 \u041d\u044d\u0448\u0430,
    \u0434\u0430\u0436\u0435 \u043f\u043e\u043c\u0438\u043c\u043e \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432, \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445,
    \u0430 \u043f\u043e\u0440\u043e\u0439 \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439. \u041e\u043d\u0438 \u0440\u0438\u0441\u0443\u044e\u0442
    \u043e\u0431\u0440\u0430\u0437 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0447\u0435\u0439
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u043c \u0432\u0441\u0435\u0433\u0434\u0430
    \u0448\u0435\u043b \u0441\u0432\u043e\u0438\u043c, \u043d\u0435\u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u044b\u043c
    \u043f\u0443\u0442\u0435\u043c, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432
    \u043f\u0435\u0440\u0438\u043e\u0434\u044b \u0435\u0433\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u0438.
    \u0412\u043e\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432.\n\n\U0001F9E0
    \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0432 \u044e\u043d\u043e\u0441\u0442\u0438 \u0415\u0433\u043e \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u043b\u0430\u0441\u044c \u0441 \u0440\u0430\u043d\u043d\u0438\u0445
    \u043b\u0435\u0442. \u0423\u0447\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f:
    \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0434\u0435\u0442\u0430\u043b\u044c \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u2014 \u044d\u0442\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f
    \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0430
    \u043e\u0442 \u0435\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0438\u0437 \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u041a\u0430\u0440\u043d\u0435\u0433\u0438
    \u0420.\u0414\u0436. \u0414\u0430\u0444\u0444\u0438\u043d\u0430. \u0412 \u043d\u0435\u043c
    \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e \u043e\u0434\u043d\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435:
    \u00ab\u042d\u0442\u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u2014 \u0433\u0435\u043d\u0438\u0439\u00bb.
    \"\u0418\u0433\u0440\u044b \u0440\u0430\u0437\u0443\u043c\u0430\" \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u0441\u0446\u0435\u043d\u0430
    \u0432 \u0444\u0438\u043b\u044c\u043c\u0435, \u0433\u0434\u0435 \u041d\u044d\u0448 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442
    \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435 \u0432 \u0431\u0430\u0440\u0435,
    \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0432\u044b\u0434\u0443\u043c\u0430\u043d\u0430.
    \u0412 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043e\u043d \u043f\u0440\u0438\u0448\u0435\u043b
    \u043a \u0441\u0432\u043e\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438, \u0438\u0437\u0443\u0447\u0430\u044f
    \u0431\u043e\u043b\u0435\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438,
    \u0430 \u043d\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u044f \u0437\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f\u043c\u0438
    \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432. \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u044c
    \u0438\u0433\u0440\u044b: \u0412 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u041d\u044d\u0448 \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u043e\u0447\u0435\u043d\u044c
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u0443\u044e \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u0443\u044e \u0438\u0433\u0440\u0443 \u043d\u0430
    \u0434\u043e\u0441\u043a\u0435 \u0441 \u0448\u0435\u0441\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c\u0438
    \u043a\u043b\u0435\u0442\u043a\u0430\u043c\u0438. \u041e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430
    \u0445\u0438\u0442\u043e\u043c \u0432 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u043e\u043c
    \u043e\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0438, \u0438 \u0432\u0441\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u0435\u0451 \u043f\u0440\u043e\u0441\u0442\u043e \"\u041d\u044d\u0448\" \u0438\u043b\u0438
    \"\u0414\u0436\u043e\u043d\". \u041f\u043e\u0437\u0436\u0435 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f
    Parker Brothers \u0432\u044b\u043f\u0443\u0441\u0442\u0438\u043b\u0430 \u0435\u0451 \u043f\u043e\u0434
    \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c \u00ab\u0413\u0435\u043a\u0441\u00bb
    (Hex). \u0420\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c:
    \u0411\u0443\u0434\u0443\u0447\u0438 \u0435\u0449\u0435 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u043c,
    \u041d\u044d\u0448, \u043f\u043e\u043b\u043d\u044b\u0439 \u0434\u0435\u0440\u0437\u043e\u0441\u0442\u0438,
    \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b \u0430\u0443\u0434\u0438\u0435\u043d\u0446\u0438\u0438
    \u0443 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u041e\u043d \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u0435\u043c\u0443 \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438 \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435,
    \u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u0447\u0430\u0441\u0430 \u0431\u0435\u0441\u0435\u0434\u044b
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0443\u0447\u0435\u043d\u044b\u0439 \u043f\u043e\u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u043b
    \u0435\u043c\u0443 \u043b\u0443\u0447\u0448\u0435 \u0432\u044b\u0443\u0447\u0438\u0442\u044c
    \u0444\u0438\u0437\u0438\u043a\u0443.\n\n\U0001F3AD \"\u041f\u0440\u0438\u0437\u0440\u0430\u043a\"
    \u0438 \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    \u041f\u0435\u0440\u0438\u043e\u0434\u044b \u0435\u0433\u043e \u0442\u044f\u0436\u0435\u043b\u043e\u0439
    \u0431\u043e\u043b\u0435\u0437\u043d\u0438, \u0434\u043b\u0438\u0432\u0448\u0438\u0435\u0441\u044f
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f\u043c\u0438, \u043e\u043a\u0443\u0442\u0430\u043d\u044b
    \u043f\u043e\u0447\u0442\u0438 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438 \u0442\u0440\u0430\u0433\u0438\u043a\u043e\u043c\u0438\u0447\u043d\u044b\u043c\u0438
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f\u043c\u0438. \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440
    \u0410\u043d\u0442\u0430\u0440\u043a\u0442\u0438\u0434\u044b: \u041a\u043e\u0433\u0434\u0430
    \u041d\u044d\u0448\u0430 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u043d\u0430
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u0427\u0438\u043a\u0430\u0433\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u043e\u043d \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0442\u0430\u043a \u043a\u0430\u043a
    \u0431\u044b\u043b \u0443\u0432\u0435\u0440\u0435\u043d, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0432\u043e\u0442-\u0432\u043e\u0442 \u043a\u043e\u0440\u043e\u043d\u0443\u044e\u0442 \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c
    \u0410\u043d\u0442\u0430\u0440\u043a\u0442\u0438\u0434\u044b. \u0412\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0430
    \u0432 \u043f\u043e\u0434\u0433\u0443\u0437\u043d\u0438\u043a\u0435: \u041d\u0430 \u043d\u043e\u0432\u043e\u0433\u043e\u0434\u043d\u0435\u043c
    \u0431\u0430\u043b\u0443 \u0432 1958 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u0432 \u043e\u0434\u043d\u043e\u043c \u043f\u043e\u0434\u0433\u0443\u0437\u043d\u0438\u043a\u0435
    \u0438 \u043b\u0435\u043d\u0442\u0435, \u0441 \u0434\u0435\u0442\u0441\u043a\u043e\u0439
    \u0431\u0443\u0442\u044b\u043b\u043e\u0447\u043a\u043e\u0439 \u0431\u0443\u0440\u0431\u043e\u043d\u0430
    \u0441 \u043c\u043e\u043b\u043e\u043a\u043e\u043c, \u0441\u0438\u0434\u044f \u043d\u0430
    \u043a\u043e\u043b\u0435\u043d\u044f\u0445 \u0443 \u0441\u0432\u043e\u0435\u0439 \u0436\u0435\u043d\u044b
    \u0410\u043b\u0438\u0441\u0438\u0438. \u0421\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \u043d\u0430\u0434\u043f\u0438\u0441\u0438:
    \u0421\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0430
    \u043f\u0440\u043e\u0437\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \u00ab\u041f\u0440\u0438\u0437\u0440\u0430\u043a\u043e\u043c
