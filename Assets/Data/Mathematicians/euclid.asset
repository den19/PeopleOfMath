  achievementsRu: "\u0413\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0445
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u2014 \u0437\u043d\u0430\u0447\u0438\u0442 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e \u043d\u0430\u0431\u043e\u0440\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c, \u0430 \u043e \u0441\u043c\u0435\u043d\u0435 \u043f\u0430\u0440\u0430\u0434\u0438\u0433\u043c\u044b
    \u0432 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u043c \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0438.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b (\u043c\u043d\u043e\u0433\u0438\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438
    \u0434\u043e \u043d\u0435\u0433\u043e), \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043a\u0430\u043a \u0441\u0442\u0440\u043e\u0433\u043e\u0439 \u0434\u0435\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0438
    \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f. \u0427\u0442\u043e\u0431\u044b \u043e\u0442\u0432\u0435\u0442
    \u0431\u044b\u043b \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u043c,
    \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043c \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043e \u0442\u0440\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u044f\u043c: \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442, \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u043c\u0435\u0436\u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435
    \u043d\u0430\u0443\u043a\u0438. 1. \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u0432 \u043c\u0435\u0442\u043e\u0434\u0435: \u0410\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u043e-\u0434\u0435\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430 (\u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434)
    \u0414\u043e \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0430\u0432\u0438\u043b (\u043a\u0430\u043a \u0443 \u0435\u0433\u0438\u043f\u0442\u044f\u043d
    \u0438\u043b\u0438 \u0432\u0430\u0432\u0438\u043b\u043e\u043d\u044f\u043d) \u0438 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0447\u0438\u0441\u0435\u043b (\u043a\u0430\u043a \u0443 \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u0435\u0432).
    \u0415\u0432\u043a\u043b\u0438\u0434 \u0441\u043e\u0437\u0434\u0430\u043b \u00ab\u0447\u0438\u0441\u0442\u0443\u044e\u00bb
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u0433\u0434\u0435 \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0441\u0442\u044c
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439 \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043e\u0442 \u043e\u043f\u044b\u0442\u0430, \u0430 \u0432\u044b\u0442\u0435\u043a\u0430\u0435\u0442
    \u0438\u0437 \u043b\u043e\u0433\u0438\u043a\u0438. - \u0418\u0435\u0440\u0430\u0440\u0445\u0438\u044f
    \u0437\u043d\u0430\u043d\u0438\u0439: \u041e\u043d \u0432\u0432\u0435\u043b \u0436\u0435\u0441\u0442\u043a\u0443\u044e
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443: \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f\n\n\u2192
    \u0410\u043a\u0441\u0438\u043e\u043c\u044b (\u041e\u0431\u0449\u0438\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u044f)\n\n\u2192
    \u041f\u043e\u0441\u0442\u0443\u043b\u0430\u0442\u044b\n\n\u2192 \u0422\u0435\u043e\u0440\u0435\u043c\u044b.
    - 5 \u041f\u043e\u0441\u0442\u0443\u043b\u0430\u0442\u043e\u0432: \u0415\u0432\u043a\u043b\u0438\u0434
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e
    \u0432\u0441\u0435 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438
    \u0438\u0437 \u043f\u044f\u0442\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439.
    \u0421\u0430\u043c\u044b\u043c \u0441\u043f\u043e\u0440\u043d\u044b\u043c \u0438\u0437 \u043d\u0438\u0445
    \u0441\u0442\u0430\u043b \u041f\u044f\u0442\u044b\u0439 \u043f\u043e\u0441\u0442\u0443\u043b\u0430\u0442
    (\u043e \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u044f\u043c\u044b\u0445).
    \u0414\u0432\u0435 \u0442\u044b\u0441\u044f\u0447\u0438 \u043b\u0435\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0435\u0433\u043e, \u043f\u043e\u043a\u0430
    \u0432 XIX \u0432\u0435\u043a\u0435 \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u0438\u0439,
    \u0413\u0430\u0443\u0441\u0441 \u0438 \u0411\u043e\u0439\u044f\u0438 \u043d\u0435 \u0437\u0430\u043c\u0435\u043d\u0438\u043b\u0438
    \u0435\u0433\u043e \u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u044b\u0439,
    \u043e\u0442\u043a\u0440\u044b\u0432 \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0443
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u0415\u0432\u043a\u043b\u0438\u0434 \u043d\u0435\u0432\u043e\u043b\u044c\u043d\u043e \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430, \u0445\u043e\u0442\u044f \u0441\u0430\u043c
    \u043e\u0431 \u044d\u0442\u043e\u043c \u043d\u0435 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u043b.
    --- 2. \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    (\u043f\u043e \u043a\u043d\u0438\u0433\u0430\u043c \u00ab\u041d\u0430\u0447\u0430\u043b\u00bb)
    \u0412 13 \u043a\u043d\u0438\u0433\u0430\u0445 \u00ab\u041d\u0430\u0447\u0430\u043b\u00bb
    \u0415\u0432\u043a\u043b\u0438\u0434 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043b
    \u0447\u0443\u0436\u0438\u0435 \u0438\u0434\u0435\u0438; \u043e\u043d \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0438\u0445, \u043f\u0440\u0438\u0434\u0430\u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c. \u0412\u043e\u0442 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0431\u043b\u043e\u043a\u0438: \u0410. \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b
    (\u041a\u043d\u0438\u0433\u0438 VII\u2013IX) - \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438:
    \u0415\u0432\u043a\u043b\u0438\u0434 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0442\u0440\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435
    \u0446\u0435\u043b\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0438
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c
    (\u0445\u043e\u0442\u044f \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e \u0432 \u0432\u0438\u0434\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439). - \u0411\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b: \u041e\u043d
    \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e.
    \u042d\u0442\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043e\u0442
    \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u043e\u0433\u043e (\u0435\u0441\u043b\u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c
    \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u043f\u0435\u0440\u0435\u043c\u043d\u043e\u0436\u0438\u0442\u044c
    \u0438\u0445, \u043f\u0440\u0438\u0431\u0430\u0432\u0438\u0432 1, \u043c\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u043c
    \u043d\u043e\u0432\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0435) \u0434\u043e
    \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438\u0437\u0443\u0447\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0448\u043a\u043e\u043b\u0430\u0445. - \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 (\u041a\u043d\u0438\u0433\u0430 VII): \u0412\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u2014 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c
    \u0434\u043b\u044f \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e
    \u043e\u0431\u0449\u0435\u0433\u043e \u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044f (\u041d\u041e\u0414)
    \u0434\u0432\u0443\u0445 \u0447\u0438\u0441\u0435\u043b. \u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439
    \u0434\u0440\u0435\u0432\u043d\u0438\u0439 \u0438\u0437 \u0434\u043e\u0448\u0435\u0434\u0448\u0438\u0445
    \u0434\u043e \u043d\u0430\u0441 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435. \u0411. \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438 \u0438 \u0441\u0442\u0435\u0440\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    (\u041a\u043d\u0438\u0433\u0438 I\u2013VI, XI\u2013XIII) - \u041f\u0440\u0438\u0437\u043d\u0430\u043a\u0438
    \u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432:
    \u0421\u0442\u0440\u043e\u0433\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f \u043d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c
    \u0444\u0438\u0433\u0443\u0440\u044b \u0434\u0440\u0443\u0433 \u043d\u0430 \u0434\u0440\u0443\u0433\u0430
    \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e, \u0430 \u043d\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438.
    - \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430
    (\u041a\u043d\u0438\u0433\u0430 I): \u0425\u043e\u0442\u044f \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u043e\u0442\u043a\u0440\u044b\u043b \u0435\u0451 \u0440\u0430\u043d\u044c\u0448\u0435,
    \u0415\u0432\u043a\u043b\u0438\u0434 \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435
    \u0434\u043e\u0448\u0435\u0434\u0448\u0435\u0435 \u0434\u043e \u043d\u0430\u0441 \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u043f\u0440\u0438\u0447\u0435\u043c
    \u0441\u0440\u0430\u0437\u0443 \u0434\u0432\u0443\u043c\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438.
    \u041e\u043d \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0441\u0447\u0435\u0442\u0430, \u0430 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u043e \u043f\u043b\u043e\u0449\u0430\u0434\u0435\u0439
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432, \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0445
    \u043d\u0430 \u043a\u0430\u0442\u0435\u0442\u0430\u0445 \u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0443\u0437\u0435.
    - \u0417\u043e\u043b\u043e\u0442\u043e\u0435 \u0441\u0435\u0447\u0435\u043d\u0438\u0435
    (\u041a\u043d\u0438\u0433\u0430 VI): \u041e\u043d \u0441\u0442\u0440\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043e\u0442\u0440\u0435\u0437\u043a\u0430 \u0432
    \u043a\u0440\u0430\u0439\u043d\u0435\u043c \u0438 \u0441\u0440\u0435\u0434\u043d\u0435\u043c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 (\u0447\u0438\u0441\u043b\u043e \u03c6
    \u2248 1,618) \u0438 \u0432\u0432\u0435\u043b \u0435\u0433\u043e \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432.
    - \u041f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u0438\u043a\u043e\u0432 (\u041a\u043d\u0438\u0433\u0430
    XIII): \u041a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u044f \u00ab\u041d\u0430\u0447\u0430\u043b\u00bb.
    \u0415\u0432\u043a\u043b\u0438\u0434 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b, \u0447\u0442\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0440\u043e\u0432\u043d\u043e \u043f\u044f\u0442\u044c \u041f\u043b\u0430\u0442\u043e\u043d\u043e\u0432\u044b\u0445
    \u0442\u0435\u043b (\u0442\u0435\u0442\u0440\u0430\u044d\u0434\u0440, \u043a\u0443\u0431,
    \u043e\u043a\u0442\u0430\u044d\u0434\u0440, \u0434\u043e\u0434\u0435\u043a\u0430\u044d\u0434\u0440,
    \u0438\u043a\u043e\u0441\u0430\u044d\u0434\u0440) \u0438 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0431\u043e\u043b\u044c\u0448\u0435. \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u043a\u0430\u043a \u0432\u043f\u0438\u0441\u0430\u0442\u044c \u0438\u0445 \u0432 \u0441\u0444\u0435\u0440\u0443,
    \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0438\u0445 \u0441\u0442\u043e\u0440\u043e\u043d. --- 3. \u0412\u043a\u043b\u0430\u0434
    \u0432 \u0441\u043c\u0435\u0436\u043d\u044b\u0435 \u043d\u0430\u0443\u043a\u0438 (\u041e\u043f\u0442\u0438\u043a\u0430,
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f, \u041c\u0443\u0437\u044b\u043a\u0430)
    \u0415\u0432\u043a\u043b\u0438\u0434 \u0431\u044b\u043b \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0441\u0442\u043e\u043c,
    \u0438 \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0432\u044b\u0445\u043e\u0434\u044f\u0442
    \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    - \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043e\u043f\u0442\u0438\u043a\u0430
    (\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041e\u043f\u0442\u0438\u043a\u0430\u00bb):
    \u042d\u0442\u043e \u043e\u0434\u043d\u0430 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442 \u043f\u043e \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435.
    - \u0415\u0432\u043a\u043b\u0438\u0434 \u043f\u043e\u0441\u0442\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b,
    \u0447\u0442\u043e \u0441\u0432\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f
    \u043f\u0440\u044f\u043c\u043e\u043b\u0438\u043d\u0435\u0439\u043d\u043e (\u043b\u0443\u0447\u0438
    \u2014 \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u044b\u0435 \u043b\u0438\u043d\u0438\u0438).
    - \u041e\u043d \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c
    \u0437\u0440\u0435\u043d\u0438\u044f \u043d\u0435 \u043a\u0430\u043a \u00ab\u0432\u044b\u0445\u043e\u0434
    \u043b\u0443\u0447\u0435\u0439 \u0438\u0437 \u0433\u043b\u0430\u0437\u0430\u00bb (\u043a\u0430\u043a
    \u0443\u0447\u0438\u043b \u041f\u043b\u0430\u0442\u043e\u043d), \u0430 \u043a\u0430\u043a
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043e\u043f\u0442\u0438\u043a\u0443,
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438
    \u043b\u0438\u043d\u0435\u0439\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u044b,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0447\u0435\u0440\u0435\u0437 1500 \u043b\u0435\u0442
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0430\u043c
    \u0420\u0435\u043d\u0435\u0441\u0441\u0430\u043d\u0441\u0430 \u043f\u0438\u0441\u0430\u0442\u044c
    \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u044b\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u044b.
    - \u0422\u0435\u043e\u0440\u0438\u044f \u0437\u0435\u0440\u043a\u0430\u043b (\u00ab\u041a\u0430\u0442\u043e\u043f\u0442\u0440\u0438\u043a\u0430\u00bb):
    \u041e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0437\u0430\u043a\u043e\u043d \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f: \u0443\u0433\u043e\u043b
    \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0440\u0430\u0432\u0435\u043d \u0443\u0433\u043b\u0443
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0432 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438
    \u043a \u043f\u043b\u043e\u0441\u043a\u0438\u043c \u0438 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0437\u0435\u0440\u043a\u0430\u043b\u0430\u043c, \u043f\u0440\u043e\u0441\u0447\u0438\u0442\u0430\u0432,
    \u0433\u0434\u0435 \u0441\u043e\u0439\u0434\u0443\u0442\u0441\u044f \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435
    \u043b\u0443\u0447\u0438 (\u0444\u043e\u043a\u0443\u0441). - \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u043c\u0443\u0437\u044b\u043a\u0438 (\u00ab\u0421\u0435\u0447\u0435\u043d\u0438\u044f
    \u043a\u0430\u043d\u043e\u043d\u0430\u00bb): \u0415\u0432\u043a\u043b\u0438\u0434 \u043f\u0435\u0440\u0435\u0432\u0435\u043b
    \u043c\u0443\u0437\u044b\u043a\u0443 \u0432 \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u044c
    \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u0439.
    \u041e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b
    (\u043e\u043a\u0442\u0430\u0432\u0430, \u043a\u0432\u0438\u043d\u0442\u0430, \u043a\u0432\u0430\u0440\u0442\u0430)
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043a\u043e\u043d\u0441\u043e\u043d\u0430\u043d\u0441
    (\u0431\u043b\u0430\u0433\u043e\u0437\u0432\u0443\u0447\u0438\u0435) \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442
    \u043f\u0440\u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0445
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445 \u0434\u043b\u0438\u043d \u0441\u0442\u0440\u0443\u043d
    (2:1, 3:2, 4:3). --- 4. \u0412\u043b\u0438\u044f\u043d\u0438\u0435, \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0435\u0435
    \u0432\u0440\u0435\u043c\u044f (\u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435) \u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0441\u0442\u0430\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430
    \u0432 \u0446\u0435\u043b\u043e\u043c: - \u0421\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0442\u0438\u0432 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438: \u041e\u043d
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u0434\u043b\u044f \u0432\u0441\u0435\u0433\u043e, \u0447\u0442\u043e \u043a\u0430\u0436\u0435\u0442\u0441\u044f
    \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c. \u042d\u0442\u043e \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u043e
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f \u0443\u0447\u0435\u043d\u044b\u0445,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0432\u0435\u0440\u044f\u0442 \u00ab\u043d\u0430
    \u0433\u043b\u0430\u0437\u00bb, \u0430 \u0442\u0440\u0435\u0431\u0443\u044e\u0442 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u044b\u0432\u043e\u0434\u0430. - \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f
    \u0444\u0438\u0437\u0438\u043a\u0438: \u0418\u043c\u0435\u043d\u043d\u043e \u0415\u0432\u043a\u043b\u0438\u0434
    \u0441\u043e\u0437\u0434\u0430\u043b \u044f\u0437\u044b\u043a, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0444\u0438\u0437\u0438\u043a\u0430.
    \u041a\u043e\u0433\u0434\u0430 \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a, \u041a\u0435\u043f\u043b\u0435\u0440,
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0438 \u041d\u044c\u044e\u0442\u043e\u043d \u043d\u0430\u0447\u043d\u0443\u0442
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u043f\u043b\u0430\u043d\u0435\u0442, \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0443 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    (\u043f\u0440\u044f\u043c\u044b\u0435, \u043a\u0440\u0443\u0433\u0438, \u044d\u043b\u043b\u0438\u043f\u0441\u044b,
    \u043a\u043e\u043d\u0443\u0441\u044b). \u0411\u0435\u0437 \u00ab\u041d\u0430\u0447\u0430\u043b\u00bb
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u044b
    \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.
    \u0418\u0442\u043e\u0433\u043e\u0432\u0430\u044f \u0441\u0443\u0442\u044c \u0435\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434\u0430: \u041e\u043d \u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u043b
    \u0447\u0442\u043e-\u0442\u043e \u043e\u0434\u043d\u043e. \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043c\u0430\u0448\u0438\u043d\u0443 \u0434\u043b\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430
    \u043d\u043e\u0432\u044b\u0445 \u0438\u0441\u0442\u0438\u043d. \u041f\u043e\u043a\u0430
    \u0434\u0440\u0443\u0433\u0438\u0435 \u0446\u0438\u0432\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u043d\u0430\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u043b\u0438 \u0444\u0430\u043a\u0442\u044b,
    \u0415\u0432\u043a\u043b\u0438\u0434 \u0434\u0430\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0443
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u0439
    \u0438\u0437 \u0433\u043e\u0440\u0441\u0442\u043a\u0438 \u0430\u043a\u0441\u0438\u043e\u043c
    \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u0437\u043d\u0430\u043d\u0438\u0435 \u043e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c \u043a\u043e\u0441\u043c\u043e\u0441\u0435.
    \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u00ab\u0415\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f\u00bb
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u2014 \u0441\u0438\u043d\u043e\u043d\u0438\u043c
    \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0439, \u043d\u0435\u0437\u044b\u0431\u043b\u0435\u043c\u043e\u0439
    \u043b\u043e\u0433\u0438\u043a\u0438."
  achievementsEn: "Talking about Euclid's achievements is not just about a set of theorems, but about a paradigm shift in human thinking, its main contribution is not so much to the discovery of specific formulas (many before him) but to the creation of mathematics as a strict deductive science and knowledge methodology.In order to be as detailed as possible, let us examine its achievements in three levels: axiomatic foundation, specific mathematics and interdisciplinary sciences. 1. The revolution in method: Axiomatic-deductive system (the main contribution) prior to Euclida math was a set of empirical rules (like Egyptians or Babylonians) and mystical numbers (like the Pythagoreans).Euclid created a \"clean\" geometry, where the truth of the statements does not depend on experience but comes from logic.\n\nAxioms (General concepts)\n\n♪ Posthumes\n\n5 Postulats: Euclid geniusly understood that all the diversity of geometry can be inferred from five allegations, the most controversial of which was the Fifth Posture (on parallel lines). Two thousand years of mathematics failed to prove it until in the nineteenth century Lobachevsky, Gauss and Boyai replaced it with the opposite, opening up non-euclide geometry.Thus, Euclid inadvertently laid the foundation for Einstein's relativity theory, although he himself did not suspect it. -- 2. Fundamental mathematical achievements (on the books \"The Start\") in 13 of Euclid's \"Starting\" books were not just rewriting other people's ideas; he reworked them with universal stringency.The number theory (Listen VII-IX) is the basic theorem of arithmetic: for the first time, Euclid has strictly proved that any whole number is divided into simple multipliers in the only way (although it was formulated as a relationship theory). The infiniteness of primes: He has given the first proof in history that many primes are infinite.This is classic evidence from the opposite (if you assume the final list of primes and multiply them by adding 1, we get a new prime) still being studied in schools. - Euclid's algorithm (List VII): The greatest achievement is the algorithm for finding the largest common divider (NOD) of two. This is the oldest algorithm ever used in computer cryptography and modern algebra.Geometry of the plane and stereometry (Books I-VI, XI-XIII) - Signs of equality of triangles: A strict system of proof that allows shapes to be placed on each other in mind rather than physically. - The Pythagorean Theorem (Line I): Although Pythagoras discovered it earlier, Euclid gave the first hard evidence that came to us, in two ways at once.He did not use the accounts, but proved through equality the squares built on cathetes and hypotenuses. - Golden Section (Knowle VI): He strictly determined the division of the segment in extreme and medium terms (number ~ ~ ~ 1.618) and introduced it into the geometry of the right polygons. - Building the right multidimensionals (Kbook XIII): The \"Pent\" cult.The Euclid mathematically established that there are exactly five Platonic bodies (tetraeder, cube, octaedre, dodecaedre, ikosaedre) and none more. He showed how to put them into the sphere and calculated the relationship between their parties. --3: Contribution to related sciences (Optica, Astronomia, Music) Euclid was an encyclopedia, and his achievements go far beyond pure mathematics.- Geometric optics (Optica Traactate): This is one of the first scientific works in history in the future. - Euclid postulated that light spreads directly (rays are straight lines). - He explained the mechanism of vision not as an \"outcast\" (as Plato taught), but as a physical optic, laying the foundations of a linear perspective theory that would allow Renaissance artists to write realistic paintings in 1,500 years.- Mirror theory (Catoptrica): He formulated the law of reflection: the angle of fall is equal to the angle of reflection in the application to flat and spherical mirrors, calculating where the reflected beams (focus) would fit. - Mathematical theory of music (Canon sections): Euclid converted the music into a plane of numerical proportions.He mathematically justified the intervals (octava, quintt, quart) and proved that consonance (beauty) arose in simple numerical relationships of string length (2:1, 3:2, 4:3). -- 4. The influence ahead of time (Philosophical Heritage) Euclid's achievements became the basis for the scientific method as a whole: - Strugality against intuition: He required evidence for anything that seemed obvious.This has brought up generations of scientists who do not believe in the eye, but require a logical conclusion. - Mathematics of physics: It is Euclid who created the language in which physics will speak. When Copernicus, Kepler, Galileo, and Newton begin to describe the movement of the planets, they will use only the euclide geometry (direct, circles, ellipses, cones). Without \"Starting\", Euclid would not have been a heavenly mechanic.He created a machine to produce new truths. While other civilizations have accumulated facts, Euclid has given mankind an instrument that allows a handful of axioms to extract knowledge of infinite space, which is why the expression \"Euclidova geometry\" is still synonymous with absolute, indistinguishable logic."
  personalLifeRu: "\u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u0441\u043b\u043e\u0436\u043d\u044b\u0439
    \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0415\u0432\u043a\u043b\u0438\u0434\u0435,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u0440\u043e\u0432\u043d\u043e \u043d\u0438\u0447\u0435\u0433\u043e. \u0412 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u043e
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0447\u0430\u0441\u0442\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c \u0443\u0447\u0435\u043d\u044b\u0445 \u2014 \u0438\u0445
    \u0446\u0435\u043d\u0438\u043b\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0437\u0430 \u0442\u0440\u0443\u0434\u044b, \u0430 \u043d\u0435 \u0437\u0430 \u0431\u044b\u0442.
    \u0411\u0438\u043e\u0433\u0440\u0430\u0444\u044b \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445
    \u0432\u0435\u043a\u043e\u0432 (\u0440\u0438\u043c\u0441\u043a\u0438\u0435, \u0432\u0438\u0437\u0430\u043d\u0442\u0438\u0439\u0441\u043a\u0438\u0435,
    \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0435) \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u043b\u0438
    \u043e\u0431\u043b\u0438\u043a \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432 \u043f\u043e
    \u0438\u0445 \u043a\u043d\u0438\u0433\u0430\u043c, \u0430 \u043d\u0435 \u043f\u043e \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0430\u043c
    \u0438\u043b\u0438 \u043f\u0438\u0441\u044c\u043c\u0430\u043c. \u0422\u043e, \u0447\u0442\u043e
    \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0432\u044b\u0434\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0435 \u0437\u0430 \u00ab\u0444\u0430\u043a\u0442\u044b
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0415\u0432\u043a\u043b\u0438\u0434\u0430\u00bb
    (\u0436\u0435\u043d\u0430, \u0434\u0435\u0442\u0438, \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438)
    \u2014 \u044d\u0442\u043e \u0447\u0438\u0441\u0442\u044b\u0439 \u0432\u044b\u043c\u044b\u0441\u0435\u043b
    \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u0435\u0439 \u041d\u043e\u0432\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438\u043b\u0438 \u0440\u0430\u043d\u043d\u0435\u0433\u043e
    \u0421\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u044c\u044f, \u043d\u0435
    \u0438\u043c\u0435\u044e\u0449\u0438\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439. \u041e\u0434\u043d\u0430\u043a\u043e
    \u044f \u043c\u043e\u0433\u0443 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0432\u0430\u043c \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u043e\u0431\u0437\u043e\u0440 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0414\u041e\u0421\u0422\u041e\u0412\u0415\u0420\u041d\u041e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438,
    \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0438 \u0438 \u0431\u044b\u0442\u0435,
    \u0438\u0441\u0445\u043e\u0434\u044f \u0438\u0437 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430 \u0438 \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u044b\u0445
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439: 1. \u0421\u0435\u043c\u0435\u0439\u043d\u043e\u0435
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    (\u0421\u043f\u043b\u043e\u0448\u043d\u044b\u0435 \u0434\u043e\u0433\u0430\u0434\u043a\u0438)
    - \u0418\u043c\u044f: \u0415\u0433\u043e \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u043c\u044f \u2014 \u0395\u1f50\u03ba\u03bb\u03b5\u03af\u03b4\u03b7\u03c2 (\u042d\u0432\u043a\u043b\u0438\u0434\u0435\u0441),
    \u0447\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u0421\u043b\u0430\u0432\u043d\u044b\u0439\u00bb
    \u0438\u043b\u0438 \u00ab\u041f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439\u00bb.
    \u042d\u0442\u043e \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0435
    \u0438\u043c\u044f \u0432 \u0414\u0440\u0435\u0432\u043d\u0435\u0439 \u0413\u0440\u0435\u0446\u0438\u0438,
    \u0447\u0442\u043e \u0443\u0441\u043b\u043e\u0436\u043d\u044f\u0435\u0442 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e.
    - \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435: \u0413\u0434\u0435
    \u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u2014 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e.
    \u041f\u043e\u0437\u0434\u043d\u0438\u0435 \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444 \u0418\u0431\u043d \u0430\u043b\u044c-\u041a\u0438\u0444\u0442\u0438
    \u0432 XIII \u0432\u0435\u043a\u0435) \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0442,
    \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u0440\u043e\u0434\u043e\u043c \u0438\u0437
    \u0422\u0438\u0440\u0430 (\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439
    \u041b\u0438\u0432\u0430\u043d) \u0438\u043b\u0438 \u0438\u0437 \u0414\u0430\u043c\u0430\u0441\u043a\u0430
    (\u0421\u0438\u0440\u0438\u044f). \u041e\u0434\u043d\u0430\u043a\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432 \u0441\u043a\u043b\u043e\u043d\u044f\u044e\u0442\u0441\u044f
    \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u0433\u0440\u0435\u043a\u043e\u043c
    \u043f\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044e,
    \u043d\u043e \u0440\u043e\u0434\u0438\u043b\u0441\u044f, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u0413\u0440\u0435\u0446\u0438\u0438,
    \u0432 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u044d\u043b\u043b\u0438\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u043e\u043b\u043e\u043d\u0438\u0439. - \u0421\u0435\u043c\u044c\u044f: \u041d\u0435\u0442
    \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f
    \u043e \u0435\u0433\u043e \u043e\u0442\u0446\u0435, \u043c\u0430\u0442\u0435\u0440\u0438,
    \u0431\u0440\u0430\u0442\u044c\u044f\u0445 \u0438\u043b\u0438 \u0441\u0435\u0441\u0442\u0440\u0430\u0445.
    \u041d\u0435\u0442 \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u043e \u0442\u043e\u043c,
    \u0431\u044b\u043b \u043b\u0438 \u043e\u043d \u0436\u0435\u043d\u0430\u0442 \u0438\u043b\u0438
    \u0438\u043c\u0435\u043b \u0434\u0435\u0442\u0435\u0439. \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 \u0438\u043b\u0438 \u041f\u043b\u0430\u0442\u043e\u043d\u0430,
    \u043e \u0440\u043e\u0434\u043e\u0441\u043b\u043e\u0432\u043d\u043e\u0439 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u043d\u0435\u0442 \u043d\u0438 \u0441\u0442\u0440\u043e\u0447\u043a\u0438. 2. \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440
    \u0438 \u043c\u0430\u043d\u0435\u0440\u0430 \u043e\u0431\u0449\u0435\u043d\u0438\u044f (\u041f\u043e
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u0430\u043c) \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u00ab\u043b\u0438\u0447\u043d\u044b\u0435\u00bb \u0447\u0435\u0440\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u043e \u043d\u0430\u0441 \u0434\u043e\u0448\u043b\u0438, \u2014 \u044d\u0442\u043e
    \u0435\u0433\u043e \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0441 \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438 \u0438 \u0446\u0430\u0440\u0435\u043c,
    \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u0432 \u0434\u0432\u0443\u0445 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0445: - \u0426\u0430\u0440\u0441\u043a\u0438\u0439
    \u043f\u0443\u0442\u044c (\u0421\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0447\u0435\u0440\u0442\u0430 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430):
    \u041a\u0430\u043a \u0443\u0436\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u043e\u0441\u044c,
    \u0446\u0430\u0440\u044c \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439 I \u0441\u043f\u0440\u043e\u0441\u0438\u043b
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u043b\u0435\u0433\u043a\u0438\u0439 \u0441\u043f\u043e\u0441\u043e\u0431
    \u0432\u044b\u0443\u0447\u0438\u0442\u044c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e,
    \u0447\u0435\u043c \u0447\u0438\u0442\u0430\u0442\u044c \u0435\u0433\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435
    \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb. \u0415\u0432\u043a\u043b\u0438\u0434 \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u0412 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043d\u0435\u0442 \u0446\u0430\u0440\u0441\u043a\u043e\u0439
    \u0434\u043e\u0440\u043e\u0433\u0438\u00bb. \u042d\u0442\u043e\u0442 \u043e\u0442\u0432\u0435\u0442
    \u0440\u0438\u0441\u0443\u0435\u0442 \u0435\u0433\u043e \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e, \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438 \u0431\u0435\u0441\u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043d\u043e\u0433\u043e
    \u0432 \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u0445 \u043d\u0430\u0443\u043a\u0438.
    \u041e\u043d \u043d\u0435 \u043b\u044c\u0441\u0442\u0438\u043b \u043c\u043e\u043d\u0430\u0440\u0445\u0443
    \u0438 \u043d\u0435 \u0443\u043f\u0440\u043e\u0449\u0430\u043b \u043d\u0430\u0443\u043a\u0443
    \u0440\u0430\u0434\u0438 \u0443\u0433\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u043b\u0430\u0441\u0442\u0438.
    - \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u0434\u0435\u043d\u044c\u0433\u0430\u043c
    (\u041f\u043e \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0443 \u0421\u0442\u043e\u0431\u0435\u044f):
    \u0414\u0440\u0443\u0433\u043e\u0439 \u0430\u043d\u0435\u043a\u0434\u043e\u0442 (\u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0439
    \u0418\u043e\u0430\u043d\u043d\u043e\u043c \u0421\u0442\u043e\u0431\u0435\u0435\u043c) \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u0415\u0432\u043a\u043b\u0438\u0434\u0430: \u00ab\u041a\u0430\u043a\u043e\u0439
    \u043f\u0440\u043e\u043a \u043e\u0442 \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439?\u00bb
    \u0412\u043c\u0435\u0441\u0442\u043e \u043b\u0435\u043a\u0446\u0438\u0438 \u043e \u043f\u043e\u043b\u044c\u0437\u0435,
    \u0415\u0432\u043a\u043b\u0438\u0434 \u043f\u043e\u0437\u0432\u0430\u043b \u0440\u0430\u0431\u0430
    \u0438 \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u0414\u0430\u0439 \u0435\u043c\u0443
    \u0442\u0440\u0438 \u043e\u0431\u043e\u043b\u0430 (\u043c\u0435\u043b\u043a\u0438\u0435
    \u043c\u043e\u043d\u0435\u0442\u044b), \u0440\u0430\u0437 \u043e\u043d \u043d\u0435\u043f\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0445\u043e\u0447\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u043f\u0440\u0438\u0431\u044b\u043b\u044c
    \u043e\u0442 \u0441\u0432\u043e\u0438\u0445 \u0437\u043d\u0430\u043d\u0438\u0439\u00bb.
    \u042d\u0442\u043e\u0442 \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u043a \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442
    \u0435\u0433\u043e \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u043e\u0433\u043e,
    \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e
    \u0443\u043c\u0430, \u0434\u043b\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0437\u043d\u0430\u043d\u0438\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0430\u043c\u043e\u0446\u0435\u043b\u044c\u044e,
    \u0430 \u043d\u0435 \u0440\u0435\u043c\u0435\u0441\u043b\u043e\u043c \u0434\u043b\u044f
    \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0430. \u041e\u043d \u043f\u0440\u0435\u0437\u0438\u0440\u0430\u043b
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043c\u0435\u0440\u043a\u0430\u043d\u0442\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    3. \u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0442\u0430\u0442\u0443\u0441
    \u0438 \u0431\u044b\u0442 \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438
    \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043e\u043d \u0436\u0438\u043b \u0432
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u043e\u043a\u043e\u043b\u043e
    300 \u0433\u043e\u0434\u0430 \u0434\u043e \u043d. \u044d., \u043c\u044b \u043c\u043e\u0436\u0435\u043c
    \u0440\u0435\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0435\u0433\u043e \u0431\u044b\u0442, \u043e\u043f\u0438\u0440\u0430\u044f\u0441\u044c
    \u043d\u0430 \u043e\u0431\u0449\u0443\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u0433\u043e\u0440\u043e\u0434\u0430:
    - \u041c\u0435\u0441\u0442\u043e \u0436\u0438\u0437\u043d\u0438: \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043f\u0440\u0438 \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0435 (\u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u043c
    \u043c\u0443\u0437\u0435\u0435) \u2014 \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0435\u0447\u0442\u043e
    \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u043c\u0435\u0436\u0434\u0443 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u043e\u043c,
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0438 \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435\u043c.
    \u0423\u0447\u0435\u043d\u044b\u0435 \u0442\u0430\u043c \u0436\u0438\u043b\u0438 \u043d\u0430
    \u043f\u043e\u043b\u043d\u043e\u043c \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u0438, \u0435\u043b\u0438 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439
    \u043e\u0431\u0435\u0434 \u0438 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0430\u043b\u0438\u0441\u044c
    \u043e\u0442 \u043d\u0430\u043b\u043e\u0433\u043e\u0432. \u0415\u0432\u043a\u043b\u0438\u0434,
    \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0436\u0438\u043b
    \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043c\u043d\u0430\u0442\u0430\u0445
    \u043f\u0440\u0438 \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0435 \u0438\u043b\u0438 \u0440\u044f\u0434\u043e\u043c
    \u0441 \u0446\u0430\u0440\u0441\u043a\u0438\u043c \u043a\u0432\u0430\u0440\u0442\u0430\u043b\u043e\u043c
    \u0411\u0440\u0443\u0445\u0435\u0439\u043e\u043d. - \u041c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435: \u0411\u0443\u0434\u0443\u0447\u0438
    \u0433\u043b\u0430\u0432\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b, \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u043b
    \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442 \u043a\u0430\u0437\u043d\u044b
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f. \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432-\u0441\u0442\u043e\u0438\u043a\u043e\u0432,
    \u043e\u043d \u043d\u0435 \u0431\u0435\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0438
    \u043c\u043e\u0433 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c \u0441\u0435\u0431\u0435
    \u0440\u0430\u0431\u043e\u0432 (\u043a\u0430\u043a \u0441\u043b\u0435\u0434\u0443\u0435\u0442
    \u0438\u0437 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0441 \u0442\u0440\u0435\u043c\u044f
    \u043e\u0431\u043e\u043b\u0430\u043c\u0438) \u0434\u043b\u044f \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u043d\u0443\u0436\u0434, \u0447\u0442\u043e\u0431\u044b \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u044c
    \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439.
    - \u0420\u0430\u0441\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0434\u043d\u044f: \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u0435\u0435
    \u0432\u0441\u0435\u0433\u043e, \u0435\u0433\u043e \u0434\u0435\u043d\u044c \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b
    \u0441\u0442\u0440\u043e\u0433\u043e \u0440\u0435\u0433\u043b\u0430\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e:
    \u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u043b\u0435\u043a\u0446\u0438\u0438 (\u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438
    \u0432 \u043f\u043e\u0440\u0442\u0438\u043a\u0430\u0445 \u0438\u043b\u0438 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044f\u0445
    \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0430) \u0438 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043d\u0430\u0434 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044f\u043c\u0438 \u0432 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435.
    4. \u0412\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u044c \u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435
    (\u041f\u043e\u043b\u043d\u043e\u0435 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0434\u0430\u043d\u043d\u044b\u0445) - \u041d\u0435\u0442 \u043d\u0438 \u043e\u0434\u043d\u043e\u0439
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u0443\u0438 \u0438\u043b\u0438
    \u0431\u044e\u0441\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b
    \u0442\u043e\u0447\u043d\u043e \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b\u0438
    \u0415\u0432\u043a\u043b\u0438\u0434\u0443. \u0422\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u044b \u0432\u0438\u0434\u0438\u043c \u0432
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430\u0445 (\u0431\u043e\u0440\u043e\u0434\u0430\u0442\u044b\u0439
    \u0441\u0442\u0430\u0440\u0435\u0446 \u0441 \u0446\u0438\u0440\u043a\u0443\u043b\u0435\u043c),
    \u2014 \u044d\u0442\u043e \u043f\u043b\u043e\u0434 \u0444\u0430\u043d\u0442\u0430\u0437\u0438\u0438
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u043e\u0432 \u044d\u043f\u043e\u0445\u0438
    \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0438 \u041d\u043e\u0432\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. - \u041d\u0435\u0442 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439
    \u043e \u0442\u043e\u043c, \u0431\u043e\u043b\u0435\u043b \u043b\u0438 \u043e\u043d, \u043a\u0430\u043a
    \u0443\u043c\u0435\u0440 \u0438 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0447\u043d\u043e
    \u043f\u0440\u043e\u0436\u0438\u043b. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0434\u043e\u0436\u0438\u043b \u0434\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 (\u0438\u0441\u0445\u043e\u0434\u044f \u0438\u0437
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0435\u0433\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442
    \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u043a\u0430\u043a
    \u0443\u0436\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u0432\u0448\u0435\u0433\u043e\u0441\u044f
    \u043c\u044d\u0442\u0440\u0430), \u043d\u043e \u0434\u0430\u0442\u0430 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438 (\u043e\u043a\u043e\u043b\u043e 265\u2013260 \u0433\u0433.
    \u0434\u043e \u043d. \u044d.) \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043b\u0438\u0448\u044c \u0440\u0435\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0435\u0439.
    5. \u041f\u0443\u0442\u0430\u043d\u0438\u0446\u0430 \u0441 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    (\u0412\u0430\u0436\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0442) \u0427\u0442\u043e\u0431\u044b \u043e\u0442\u0432\u0435\u0442
    \u0431\u044b\u043b \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u043c,
    \u043d\u0443\u0436\u043d\u043e \u0443\u043f\u043e\u043c\u044f\u043d\u0443\u0442\u044c \u043e\u0431
    \u043e\u0434\u043d\u043e\u0439 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u0432\u0438\u0442 \u043f\u043e\u0434
    \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u0435 \u0434\u0430\u0436\u0435 \u0435\u0433\u043e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e: - \u0412 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0445\u0440\u043e\u043d\u0438\u043a\u0430\u0445 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442\u0441\u044f
    \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0442\u0440\u0438 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u0438\u0437 \u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430:
    \u043d\u0430\u0448 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0444\u0438\u043b\u043e\u0441\u043e\u0444-\u043c\u0435\u0433\u0430\u0440\u0438\u043a
    (\u0443\u0447\u0435\u043d\u0438\u043a \u0421\u043e\u043a\u0440\u0430\u0442\u0430) \u0438
    \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440. - \u0412 \u0441\u0440\u0435\u0434\u043d\u0438\u0435
    \u0432\u0435\u043a\u0430 \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    (\u0418\u0431\u043d \u0430\u043b\u044c-\u041a\u0438\u0444\u0442\u0438) \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e
    \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043b\u0438 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u0438\u0437 \u041c\u0435\u0433\u0430\u0440\u044b, \u043f\u0440\u0438\u043f\u0438\u0441\u0430\u0432
    \u043d\u0430\u0448\u0435\u043c\u0443 \u0443\u0447\u0435\u043d\u043e\u043c\u0443 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u0434\u043e\u043b\u0433\u0443\u044e \u0436\u0438\u0437\u043d\u044c (\u043f\u043e\u0447\u0442\u0438
    400 \u043b\u0435\u0442) \u0438 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f.
    \u041b\u0438\u0448\u044c \u0432 \u044d\u043f\u043e\u0445\u0443 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 (\u041f\u044c\u0435\u0442\u0440\u043e \u0422\u0430\u043a\u043a\u043e\u043b\u0430)
    \u0440\u0430\u0437\u043e\u0431\u0440\u0430\u043b\u0438 \u044d\u0442\u0443 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u0443,
    \u043d\u043e \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438
    \u0444\u0430\u043a\u0442\u043e\u0432 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u0438\u0431\u0430\u0432\u0438\u043b\u043e.
    --- \u0420\u0435\u0437\u044e\u043c\u0438\u0440\u0443\u044f: \u0415\u0441\u043b\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c
    \u0441\u0442\u0440\u043e\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e, \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0443 \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0434\u043b\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e.
    \u041e\u043d \u043f\u0440\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c
    \u0432\u043d\u0443\u0442\u0440\u0438 \u0441\u0432\u043e\u0438\u0445 \u0447\u0435\u0440\u0442\u0435\u0436\u0435\u0439
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432. \u041e\u043d
    \u043d\u0435 \u043f\u0438\u0441\u0430\u043b \u043c\u0435\u043c\u0443\u0430\u0440\u043e\u0432,
    \u043d\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b \u0432 \u043b\u0438\u0447\u043d\u043e\u0439
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 (\u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c), \u0438
    \u0435\u0433\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043d\u0435 \u0441\u043e\u0447\u043b\u0438 \u043d\u0443\u0436\u043d\u044b\u043c \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c,
    \u0435\u043b \u043b\u0438 \u043e\u043d \u043e\u043b\u0438\u0432\u043a\u0438 \u0438\u043b\u0438
    \u043b\u044e\u0431\u0438\u043b \u043b\u0438 \u0432\u0438\u043d\u043e. \u0412\u0441\u0435,
    \u0447\u0442\u043e \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u043e \u043d\u0435\u043c
    \u043a\u0430\u043a \u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0435, \u0443\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0434\u0432\u0430 \u0435\u0433\u043e \u043a\u0440\u044b\u043b\u0430\u0442\u044b\u0445
    \u043e\u0442\u0432\u0435\u0442\u0430: \u00ab\u041d\u0435\u0442 \u0446\u0430\u0440\u0441\u043a\u043e\u0433\u043e
    \u043f\u0443\u0442\u0438\u00bb \u0438 \u00ab\u0414\u0430\u0439 \u0435\u043c\u0443 \u0442\u0440\u0438
    \u043e\u0431\u043e\u043b\u0430\u00bb. \u0418\u0441\u0445\u043e\u0434\u044f \u0438\u0437
    \u043d\u0438\u0445, \u043c\u043e\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u0432\u044b\u0432\u043e\u0434, \u0447\u0442\u043e \u044d\u0442\u043e \u0431\u044b\u043b
    \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u044b\u0439, \u0441\u0442\u0440\u043e\u0433\u0438\u0439,
    \u0431\u0435\u0441\u043a\u043e\u0440\u044b\u0441\u0442\u043d\u044b\u0439 \u0438 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0439
    \u0434\u0443\u0445\u043e\u043c \u0433\u0440\u0435\u043a, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0432\u0448\u0438\u0439 \u0441\u0435\u0431\u044f
    \u041b\u043e\u0433\u043e\u0441\u0443 (\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0437\u043d\u0430\u043d\u0438\u044e). \u0412\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u2014 \u0432\u044b\u043c\u044b\u0441\u0435\u043b."
  personalLifeEn: "This is the most difficult question about Euclid, because his personal life is not known at all. In antiquity, it was not customary to describe the privacy of scientists — they were valued solely for their work, not for their time.What's now on the Internet for \"the facts of Euclid's personal life\" (wives, children, habits) is the pure fiction of writers of the New Time or early Middle Ages without documentary evidence, but I can give you a very detailed overview of what DOSTVEREVER knows about his personality, environment and existence, based on historical context and implicit references: 1.Family status and origin (Called guesses) - Name: His Greek name is , which means \"Great\" or \"Glorious.\" This is a rather common name in ancient Greece, which complicates identification. - Origin: Where he was born is unknown. Late Arab sources (e.g. biographer Ibn al-Kifty in the 13th century) claim that he was from Tyre (modern Lebanon) or Damascus (Siriah).However, most historians tend to think that he was Greek by origin but was born, probably outside Greece, in one of the ellinic colonies.The character and manner of communication (by anecdotes) is the only \"personal\" features that have reached us are his interaction with his disciples and king, as recorded in two legends: - The Czar's Way (The most famous characteristic): As already mentioned, King Ptolemy I asked Euclid whether there is an easier way to learn geometry than to read its huge \"Start.\" Euclid replied: \"There is no king's way in geometry.\"This answer draws him as a man of strict, principled and uncompromising science, and he did not flatter the monarch or simplify science for the sake of power.- Treatment of money (Stobeian account): Another joke (saved by John Stobey) says that one of the disciples asked Euclid: \"What is the use of geometry?\" Instead of giving a lecture on utility, Euclid called a slave and said: \"Give him three pegs (small coins) if he wants to profit from his knowledge.\"This is what characterizes him as an ironic, aristocratic mind, for which knowledge is an end in itself, not a trade for earnings. He despises practical mercanticity.Since he lived in Alexandria around 300 BCE, we can rebuild his life on the basis of the city's common history: - Place of life: He worked at Museyon (Alexandria Museum) - it was a midway between the university, the research centre and the monastery.Euclid probably lived in special rooms near Musayon or the royal quarter of Bruheyon.- Order of the day: His day was probably strictly regulated: morning lectures (walks in the pores or in the audience of Musayon) and works on manuscripts in the library. 4. Appearance and health (full lack of data) - There are no antiquated statues or busts that are exactly Euclid's.The images that we see in textbooks (the bearded old man with the circus) are the result of the fantasy of the artists of the Renaissance and the New Time era.To be as detailed as possible, one major problem that calls into question even his biography is the following: - The historical chronicles mention at least three Euclids from the same period: our mathematician, the Megaric philosopher (Sokrat's student) and the architect.- In the Middle Ages, Arab historians (Ibn al-Kifty) mistakenly combined the biographies of Euclid's mathematician and philosopher Euclid of Megara, giving our scientist an incredibly long life (nearly 400 years) and a journey. Only in the Renaissance of historians (Pietro Takkola) did historians deal with this confusion, but the certainty of the facts did not add to it. --Summarizing: There was no history in Euclid's strictly scientific, personal life.He lived his life inside his drawings and evidence, and he didn't write memoirs, and he didn't write personal correspondence, and his contemporaries didn't think it was necessary to write down whether he had eaten olives or loved wine, and everything we know about him as a man falls into his two winged answers, \"No royal way\" and \"Give him three eyes.\"From these, it can be concluded that it was ironic, strict, selfless and aristocratic Greek, fully dedicated to Logos (rational knowledge), the rest being fiction."
  shortBioRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439
    \u043e \u0415\u0432\u043a\u043b\u0438\u0434\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u043e\u0447\u0435\u043d\u044c \u043c\u0430\u043b\u043e, \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0438\u0437 \u043d\u0438\u0445 \u2014 \u044d\u0442\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u044b
    \u0438 \u043e\u0442\u0440\u044b\u0432\u043e\u0447\u043d\u044b\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f,
    \u0434\u043e\u0448\u0435\u0434\u0448\u0438\u0435 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f.
    \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0435\u0433\u043e \u0444\u0438\u0433\u0443\u0440\u0430
    \u043a\u0430\u043a \u00ab\u043e\u0442\u0446\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb
    \u0438 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434,
    \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb, \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0432\u0441\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043d\u0430\u0443\u043a\u0438.\n\n\U0001F4DC
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0432\u0435\u0445\u0438 \u0436\u0438\u0437\u043d\u0438
    \u0411\u043e\u043b\u044c\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u043c\u044b \u00ab\u0437\u043d\u0430\u0435\u043c\u00bb \u043e \u0415\u0432\u043a\u043b\u0438\u0434\u0435,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0430 \u043d\u0430 \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u044b\u0445
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445. \u0412\u0440\u0435\u043c\u044f
    \u0436\u0438\u0437\u043d\u0438: \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0436\u0438\u043b \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 325\u2013265 \u0433\u043e\u0434\u0430\u0445 \u0434\u043e \u043d. \u044d.. \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c
    \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u043e\u043c \u0441\u043b\u0443\u0436\u0438\u0442
    \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430
    \u041f\u0440\u043e\u043a\u043b\u0430 (V \u0432\u0435\u043a \u043d. \u044d.), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u0415\u0432\u043a\u043b\u0438\u0434
    \u0436\u0438\u043b \u0432\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0446\u0430\u0440\u044f
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f I \u0421\u043e\u0442\u0435\u0440\u0430
    (\u043f\u0440\u0430\u0432\u0438\u043b \u0432 306\u2013283 \u0433\u0433. \u0434\u043e \u043d.
    \u044d.), \u0431\u044b\u043b \u043c\u043e\u043b\u043e\u0436\u0435 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u041f\u043b\u0430\u0442\u043e\u043d\u0430, \u043d\u043e \u0441\u0442\u0430\u0440\u0448\u0435
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 (\u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u043e\u043a. 287 \u0433. \u0434\u043e \u043d. \u044d.). \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u0432 \u0441\u0432\u043e\u0438\u0445 \u0442\u0440\u0443\u0434\u0430\u0445 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430, \u0447\u0442\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
    \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044e. \u041c\u0435\u0441\u0442\u043e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438: \u0415\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b\u0430
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0446\u0435\u043d\u0442\u0440\u043e\u043c
    \u044d\u043b\u043b\u0438\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0435\u043c I \u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0442\u0430\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u043c
    \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0435 (\u0445\u0440\u0430\u043c\u0435 \u043c\u0443\u0437)
    \u043f\u0440\u0438 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435. \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435: \u0422\u043e\u0447\u043d\u043e\u0435
    \u043c\u0435\u0441\u0442\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e.
    \u041e\u0434\u043d\u0430 \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439 (\u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0430\u044f\u0441\u044f
    \u0432 \u0430\u0440\u0430\u0431\u0441\u043a\u043e\u0439 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438
    XII \u0432\u0435\u043a\u0430) \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e \u043e\u043d
    \u0431\u044b\u043b \u0433\u0440\u0435\u043a\u043e\u043c, \u0440\u043e\u0434\u043e\u043c
    \u0438\u0437 \u0422\u0438\u0440\u0430, \u0438 \u0436\u0438\u043b \u0432 \u0421\u0438\u0440\u0438\u0438.
    \u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435,
    \u0447\u0442\u043e \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f \u0432 \u0410\u0444\u0438\u043d\u0430\u0445
    \u0443 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u041f\u043b\u0430\u0442\u043e\u043d\u0430, \u0447\u0442\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u043e
    \u043d\u0430 \u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0430\u043d\u0435\u043a\u0434\u043e\u0442:
    \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e\u043c\u0443 \u043f\u0435\u0440\u0438\u043e\u0434\u0443
    \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0434\u0438\u0430\u043b\u043e\u0433. \u0426\u0430\u0440\u044c \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u0439
    \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u0415\u0432\u043a\u043b\u0438\u0434\u0430, \u0435\u0441\u0442\u044c
    \u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439
    \u043f\u0443\u0442\u044c \u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0447\u0435\u043c \u0435\u0433\u043e \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb.
    \u041d\u0430 \u0447\u0442\u043e \u0443\u0447\u0435\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442\u0438\u043b
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439 \u0444\u0440\u0430\u0437\u043e\u0439:
    \u00ab\u0412 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043d\u0435\u0442 \u0446\u0430\u0440\u0441\u043a\u043e\u0433\u043e
    \u043f\u0443\u0442\u0438\u00bb.\n\n\U0001F4DA \u0413\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434: \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0415\u0432\u043a\u043b\u0438\u0434\u0430
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e, \u0445\u043e\u0442\u044f \u0431\u043e\u043b\u044c\u0448\u0430\u044f
    \u0447\u0430\u0441\u0442\u044c \u0435\u0433\u043e \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439
    \u0443\u0442\u0435\u0440\u044f\u043d\u0430 \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0430\u043c
    \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432. \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb
    (\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u044b): \u042d\u0442\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0432 13 \u043a\u043d\u0438\u0433\u0430\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0430 \u0434\u0432\u0435 \u0442\u044b\u0441\u044f\u0447\u0438 \u043b\u0435\u0442
    \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412 \u043d\u0435\u043c \u0415\u0432\u043a\u043b\u0438\u0434 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u0432\u0441\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 (\u0424\u0430\u043b\u0435\u0441,
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440, \u0415\u0432\u0434\u043e\u043a\u0441, \u0422\u0435\u044d\u0442\u0435\u0442).
    \u041e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u043a\u0430\u043a \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u0434\u0435\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443, \u0438\u0441\u0445\u043e\u0434\u044f \u0438\u0437
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0439, 5 \u043f\u043e\u0441\u0442\u0443\u043b\u0430\u0442\u043e\u0432
    \u0438 5 \u0430\u043a\u0441\u0438\u043e\u043c, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0432\u044b\u0432\u0435\u043b 465 \u0442\u0435\u043e\u0440\u0435\u043c. \u0414\u0440\u0443\u0433\u0438\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f:
    \u00ab\u0414\u0430\u043d\u043d\u044b\u0435\u00bb \u2014 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437. \u00ab\u041e\u043f\u0442\u0438\u043a\u0430\u00bb \u0438
    \u00ab\u041a\u0430\u0442\u043e\u043f\u0442\u0440\u0438\u043a\u0430\u00bb \u2014 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043f\u0442\u0438\u043a\u0435, \u0433\u0434\u0435 \u043e\u043d \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u044b
    \u0438 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0432 \u0437\u0435\u0440\u043a\u0430\u043b\u0430\u0445.
    \u00ab\u0421\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u0430\u043d\u043e\u043d\u0430\u00bb
    (\u0438\u043b\u0438 \u00ab\u0414\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u0430\u043d\u043e\u043d\u0430\u00bb)
    \u2014 \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u0443\u0437\u044b\u043a\u0438, \u0433\u0434\u0435 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044e\u0442\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0441\u043d\u043e\u0432\u044b
    \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u0432.
    \u00ab\u041e \u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0444\u0438\u0433\u0443\u0440\u00bb
    \u2014 \u0434\u043e\u0448\u0435\u0434\u0448\u0435\u0435 \u0434\u043e \u043d\u0430\u0441
    \u0432 \u0430\u0440\u0430\u0431\u0441\u043a\u043e\u043c \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0435. \u0423\u0442\u0435\u0440\u044f\u043d\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b: \u0415\u0432\u043a\u043b\u0438\u0434 \u0442\u0430\u043a\u0436\u0435
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0447\u0435\u0442\u044b\u0440\u0435 \u043a\u043d\u0438\u0433\u0438
    \u043e \u00ab\u041a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u0445\u00bb
    (\u0442\u0435\u043c\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u0437\u0436\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0430
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u0435\u043c \u041f\u0435\u0440\u0433\u0441\u043a\u0438\u043c)
    \u0438 \u00ab\u041f\u043e\u0440\u0438\u0437\u043c\u044b\u00bb, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043c\u043e\u0436\u043d\u043e
    \u0440\u0435\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043b\u0438\u0448\u044c \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u043f\u043e \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u044f\u043c
    \u041f\u0430\u043f\u043f\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e.
    \u0417\u0430 \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c \u0415\u0432\u043a\u043b\u0438\u0434
    \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a\u043e\u043c
    \u0430\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u044b
    \u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0440\u0443\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043d\u0430 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0432\u0435\u043a\u0430 \u0432\u043f\u0435\u0440\u0435\u0434. \u0415\u0433\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439,
    \u0438\u0437\u0443\u0447\u0430\u0435\u0442 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0438 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u0443\u0440\u0441\u0430 \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435."
  shortBioEn: "The biographical information on Euclid is very limited, and most of it is legends and clippings that have come to pass over centuries, yet his figure as \"father of geometry\" and his main work, \"Starting\", has had a tremendous impact on the history of science.\n\nThe main features of life are most of what we \"know\" about Euclid, based on circumstantial evidence. Lifetime: It is believed that he lived between 325 and 265 BCE. The key reference is the commentary by the philosopher Prokla (Vst century CE), who wrote that Euclid lived during the time of King Ptolemy I Soter (rules 306 - 283, BCE), was younger than the students of Plato but older than Archimedes (born from 287 BCE).Archimedes in his writings mentions Euclid, which confirms the timeline, where his scientific career was held in Alexandria of Egypt, which was the center of ellinistic science. He is believed to have been invited by Ptolemy I and founded a mathematical school there, perhaps at the famous Alexandri Museyon (Chram of the Museum) at the library. Origin and education: The exact place of birth is unknown.One of the versions (saved in the Arabic manuscript of the 12th century) says that he was a Greek, from Tyre, and lived in Syria, and there is evidence that he was studying in Athens with Plato's followers, which influenced his philosophical approach to mathematics.To which the scientist responded with a legendary phrase, \"There is no royal path in geometry.\"\n\n==Career==The main work: \"First\" and other works: Euclid's legacy is enormous, although most of its writings have been lost and are known only by reference to other authors. \"Start\" (Elements): This is a fundamental work in 13 books, which for 2,000 years has become the main textbook in geometry and mathematics, and in which Euclid has systematized and summarized all the achievements of the previous Greek mathematics (Fales, Pythagoras, Evdox, Theette).He built geometry as a strict deduction system based on definitions, 5 postulates and 5 axioms, of which 465 theorem were derived. Other famous essays: \"Danish\" is an introduction to geometric analysis. \"Optica\" and \"Catoptrica\" are geometric optic work, where he presented the theory of perspective and reflection in mirrors.Canon sections (or Canon Division) are a tract on the theory of music, which deals with the mathematical basis of musical intervals. \"On the division of figures\", which has reached us in Arabic. Lost works: Euclid also wrote four books on \"Cony Sections\" (the topic was later developed by Apollony Perg) and \"Prizma\", whose content can only be reconstructed today in part according to Pappa's comments.In his lifetime, Euclid became the founder of the Alexandrian Mathematical School and created a work that defined mathematics development for centuries to come, and its geometry, called Euclidian, studies the properties of space and remains the foundation of the school course around the world."
  interestingFactsRu: "\u041e \u0436\u0438\u0437\u043d\u0438 \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u0442\u0430\u043a \u043c\u0430\u043b\u043e, \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u0430\u044f
    \u0434\u043e\u0448\u0435\u0434\u0448\u0430\u044f \u0434\u043e \u043d\u0430\u0441 \u0434\u0435\u0442\u0430\u043b\u044c
    \u2014 \u0443\u0436\u0435 \u0441\u043e\u043a\u0440\u043e\u0432\u0438\u0449\u0435. \u0414\u0430\u0436\u0435
    \u0435\u0433\u043e \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u044b \u2014 \u043f\u043b\u043e\u0434
    \u0444\u0430\u043d\u0442\u0430\u0437\u0438\u0438 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u043e\u0432,
    \u0432\u0435\u0434\u044c \u043d\u0438 \u043e\u0434\u043d\u043e\u0439 \u043f\u0440\u0438\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0439
    \u0441\u0442\u0430\u0442\u0443\u0438 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c.
    \u041d\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445, \u0430 \u043f\u043e\u0440\u043e\u0439
    \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438\u0437 \u043d\u0438\u0445.\n\n\U0001F4DC \u0422\u0430\u0439\u043d\u0430 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438:
    \u041e\u0448\u0438\u0431\u043a\u0430, \u0434\u043b\u0438\u0432\u0448\u0430\u044f\u0441\u044f
    \u0432\u0435\u043a\u0430 \u041d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0439 \u0443\u0447\u0435\u043d\u044b\u0445
    \u043c\u0443\u0447\u0438\u043b \u0432\u043e\u043f\u0440\u043e\u0441: \u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043b\u0438 \u043d\u0430\u0448 \u0415\u0432\u043a\u043b\u0438\u0434 \u043d\u0430 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435? \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0431\u044b\u043b\u0430
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0432 \u0414\u0440\u0435\u0432\u043d\u0435\u0439
    \u0413\u0440\u0435\u0446\u0438\u0438 \u0431\u044b\u043b\u043e \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c
    \u0434\u0432\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441 \u044d\u0442\u0438\u043c \u0438\u043c\u0435\u043d\u0435\u043c: \u0415\u0432\u043a\u043b\u0438\u0434-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0438 \u0415\u0432\u043a\u043b\u0438\u0434 \u0438\u0437 \u041c\u0435\u0433\u0430\u0440\u044b,
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444-\u0441\u043e\u043a\u0440\u0430\u0442\u0438\u043a,
    \u0436\u0438\u0432\u0448\u0438\u0439 \u043d\u0430 \u0441\u0442\u043e \u043b\u0435\u0442
    \u0440\u0430\u043d\u044c\u0448\u0435. \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e
    \u0441\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u043a\u043e\u0432\u044b\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0447\u0438\u043a\u0438
    \u0438 \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
