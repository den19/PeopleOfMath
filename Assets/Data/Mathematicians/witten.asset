    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    AdS/CFT-\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435: \u041f\u043e\u0441\u043b\u0435
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0425\u0443\u0430\u043d\u0430 \u041c\u0430\u043b\u0434\u0430\u0441\u0435\u043d\u044b \u043e
    \u0433\u043e\u043b\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435, \u0412\u0438\u0442\u0442\u0435\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0440\u044f\u0434 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0441\u0442\u0430\u0442\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043c\u043e\u0433\u043b\u0438 \u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0442\u044c
    \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u044c \u044d\u0442\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435
    \u043c\u0435\u0436\u0434\u0443 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0435\u0439
    \u0432 \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435
    \u0438 \u043e\u0431\u044b\u0447\u043d\u044b\u043c\u0438 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u043c\u0438
    \u0442\u0435\u043e\u0440\u0438\u044f\u043c\u0438 \u043f\u043e\u043b\u044f \u043d\u0430 \u0435\u0433\u043e
    \u0433\u0440\u0430\u043d\u0438\u0446\u0435. \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0436\u0438\u0442\u044c \u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044c\u0441\u044f.
    \u0414\u0430\u0436\u0435 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442\u0441\u044f
    \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0436\u0443\u0440\u043d\u0430\u043b\u0430\u0445,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043d\u0430\u0434 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0435\u0439, \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0441\u0442\u0440\u0443\u043d \u0438 \u0447\u0435\u0440\u043d\u044b\u043c\u0438 \u0434\u044b\u0440\u0430\u043c\u0438.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0434\u0430\u043d\u043d\u044b\u043c Scopus,
    \u0435\u0433\u043e \u0438\u043d\u0434\u0435\u043a\u0441 \u0425\u0438\u0440\u0448\u0430 (h-index)
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 157, \u0430 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u0446\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0431\u043e\u043b\u0435\u0435 138 000 \u0440\u0430\u0437, \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u044b\u0441\u043e\u043a\u0438\u0445
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u0440\u0435\u0434\u0438
    \u0444\u0438\u0437\u0438\u043a\u043e\u0432-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u0432."
  achievementsEn: 
  personalLifeRu: "\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435,
    \u0441\u0435\u043c\u044c\u044f \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u042d\u0434\u0432\u0430\u0440\u0434 \u0412\u0438\u0442\u0442\u0435\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    26 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1951 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0430\u043b\u0442\u0438\u043c\u043e\u0440\u0435,
    \u0448\u0442\u0430\u0442 \u041c\u044d\u0440\u0438\u043b\u0435\u043d\u0434, \u0432 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041b\u044c\u044e\u0438\u0441
    \u0412\u0438\u0442\u0442\u0435\u043d, \u0431\u044b\u043b \u0444\u0438\u0437\u0438\u043a\u043e\u043c-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c,
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u043c \u043f\u043e \u043e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u0447\u0442\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043e\u043a\u0430\u0437\u0430\u043b\u043e
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0431\u0443\u0434\u0443\u0449\u0438\u0439
    \u0432\u044b\u0431\u043e\u0440 \u0441\u044b\u043d\u0430. \u0415\u0433\u043e \u043c\u0430\u0442\u044c,
    \u041b\u043e\u0440\u0440\u0435\u0439\u043d \u0412\u0438\u0442\u0442\u0435\u043d (\u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f
    \u0412\u043e\u043b\u0430\u0445), \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u044d\u043c\u0438\u0433\u0440\u0430\u043d\u0442\u043e\u0432
    \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u0432 \u044e\u043d\u043e\u0441\u0442\u0438
    \u0412\u0438\u0442\u0442\u0435\u043d \u043d\u0435 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u0444\u0438\u0437\u0438\u043a\u043e\u043c.
    \u041e\u043d \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0439
    \u0438 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0438\u043a\u043e\u0439. \u0412
    1971 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430 \u043f\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0411\u0440\u0430\u043d\u0434\u0435\u0439\u0441\u0430
    \u0438 \u0434\u0430\u0436\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c\u0438 \u0432 \u0442\u0430\u043a\u0438\u0445 \u0438\u0437\u0434\u0430\u043d\u0438\u044f\u0445,
    \u043a\u0430\u043a The New Republic \u0438 The Nation. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0441\u043a\u043e\u0439
    \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438 \u0414\u0436\u043e\u0440\u0434\u0436\u0430
    \u041c\u0430\u043a\u0433\u043e\u0432\u0435\u0440\u043d\u0430 \u0432 1972 \u0433\u043e\u0434\u0443.\n\n\U0001F9D1\u200d\U0001F393
    \u0423\u0447\u0451\u0431\u0430 \u0438 \u043f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0443
    \u041f\u0443\u0442\u044c \u0412\u0438\u0442\u0442\u0435\u043d\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u0431\u044b\u043b \u043d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u043c: - \u041f\u043e\u0441\u043b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443
    \u041c\u0438\u0447\u0438\u0433\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u043d\u0430 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443, \u043d\u043e \u0431\u0440\u043e\u0441\u0438\u043b
    \u0447\u0435\u0440\u0435\u0437 \u043e\u0434\u0438\u043d \u0441\u0435\u043c\u0435\u0441\u0442\u0440.
    - \u0412 1973 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u043d\u0430 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u00ab\u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb,
    \u043d\u043e \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u043d\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442.
    - \u0412 1976 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    (Ph.D.) \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0437\u0430\u0449\u0438\u0442\u0438\u0432 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0414\u044d\u0432\u0438\u0434\u0430 \u0413\u0440\u043e\u0441\u0441\u0430 (\u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u043d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u0430).\n\n\U0001F468\u200d\U0001F3EB
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0412\u0438\u0442\u0442\u0435\u043d\u0430
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e:
    - 1976\u20131977: \u041f\u043e\u0441\u0442\u0434\u043e\u043a\u0442\u043e\u0440\u0430\u043d\u0442
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    - 1977\u20131980: \u041c\u043b\u0430\u0434\u0448\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043a\u043e\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0430\u0442\u043e\u0432
    (Harvard Society of Fellows). - 1980\u20131987: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. - \u0421 1987
    \u0433\u043e\u0434\u0430 \u043f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435
    \u0432\u0440\u0435\u043c\u044f: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u043c \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (Institute for Advanced Study) \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435.
    - 1999\u20132001: \u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u043d\u044b\u0439
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u043e\u043c
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 (\u041a\u0430\u043b\u0442\u0435\u0445).\n\n\U0001F495
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0421 1979 \u0433\u043e\u0434\u0430
    \u042d\u0434\u0432\u0430\u0440\u0434 \u0412\u0438\u0442\u0442\u0435\u043d \u0436\u0435\u043d\u0430\u0442
    \u043d\u0430 \u041a\u044c\u044f\u0440\u0435 \u041d\u0430\u043f\u043f\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0444\u0438\u0437\u0438\u043a\u043e\u043c
    \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0423 \u043d\u0438\u0445
    \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u043e\u0448\u043b\u0438 \u043f\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0441\u0442\u0435\u0437\u0435:
    - \u0418\u043b\u0430\u043d\u0430 \u0411. \u0412\u0438\u0442\u0442\u0435\u043d \u2014 \u043d\u0435\u0439\u0440\u043e\u0431\u0438\u043e\u043b\u043e\u0433,
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435.
    - \u0414\u0430\u043d\u0438\u044d\u043b\u0430 \u0412\u0438\u0442\u0442\u0435\u043d \u2014
    \u0431\u0438\u043e\u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    - \u0421\u044b\u043d \u2014 \u0420\u0430\u0444\u0430\u044d\u043b\u044c. \u0415\u0433\u043e
    \u0431\u0440\u0430\u0442, \u041c\u044d\u0442\u0442 \u0412\u0438\u0442\u0442\u0435\u043d,
    \u2014 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0441\u0442
    \u0438 \u043f\u0440\u043e\u0434\u044e\u0441\u0435\u0440 \u0442\u0435\u043b\u0435\u0441\u0435\u0440\u0438\u0430\u043b\u043e\u0432.
    \u0412\u0438\u0442\u0442\u0435\u043d \u0442\u0430\u043a\u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0435\u0439 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043e\u0437\u0438\u0446\u0438\u0435\u0439: \u043e\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043e \u0434\u0432\u0443\u0445 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u0445
    \u0434\u043b\u044f \u0418\u0437\u0440\u0430\u0438\u043b\u044f \u0438 \u041f\u0430\u043b\u0435\u0441\u0442\u0438\u043d\u044b
    \u0438 \u0432\u0445\u043e\u0434\u0438\u0442 \u0432 \u0441\u043e\u0432\u0435\u0442\u044b
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0439 Americans for Peace Now
    \u0438 J Street.\n\n\U0001F91D \u0412\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0451\u043d\u044b\u043c\u0438
    \u0412\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0412\u0438\u0442\u0442\u0435\u043d\u0430
    \u0441 \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432. \u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e:
    \u041e\u043d \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0441 \u0442\u0430\u043a\u0438\u043c\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430\u043c\u0438, \u043a\u0430\u043a \u041d\u0430\u0442\u0430\u043d
    \u0417\u0430\u0439\u0431\u0435\u0440\u0433 (\u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0417\u0430\u0439\u0431\u0435\u0440\u0433\u0430-\u0412\u0438\u0442\u0442\u0435\u043d\u0430
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0439 \u043f\u043e\u043b\u044f) \u0438 \u0410\u043d\u0442\u043e\u043d
    \u041a\u0430\u043f\u0443\u0441\u0442\u0438\u043d (\u0441\u0432\u044f\u0437\u044c S-\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0439 \u041b\u044d\u043d\u0433\u043b\u044d\u043d\u0434\u0441\u0430).
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0442\u0430\u043a\u0436\u0435 \u0442\u0435\u0441\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d\u044b \u0441 \u0438\u0434\u0435\u044f\u043c\u0438 \u0425\u0443\u0430\u043d\u0430
    \u041c\u0430\u043b\u0434\u0430\u0441\u0435\u043d\u044b (AdS/CFT-\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435).
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435: \u0421\u0430\u043c\u044b\u043c
    \u044f\u0440\u043a\u0438\u043c \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0435\u0433\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u044f \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0432 1990 \u0433\u043e\u0434\u0443 \u2014 \u0432\u044b\u0441\u0448\u0435\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0435\u0434\u043a\u043e \u0434\u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430\u043c. \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0441\u044d\u0440 \u041c\u0430\u0439\u043a\u043b
    \u0410\u0442\u044c\u044f, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044f
    \u0412\u0438\u0442\u0442\u0435\u043d\u0430 \u043a \u043d\u0430\u0433\u0440\u0430\u0434\u0435,
    \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e
    \u0444\u0438\u0437\u0438\u043a, \u043f\u043e\u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u0432\u043e \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043e\u043c \u0441 \u043d\u0438\u043c \u043c\u043e\u0433\u0443\u0442
    \u043e\u0447\u0435\u043d\u044c \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u2026
    \u0412 \u0435\u0433\u043e \u0440\u0443\u043a\u0430\u0445 \u0444\u0438\u0437\u0438\u043a\u0430
    \u0441\u043d\u043e\u0432\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u044f \u0438 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb.\n\n\u2753 \u0412\u043e\u043f\u0440\u043e\u0441
    \u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u042d\u0434\u0432\u0430\u0440\u0434 \u0412\u0438\u0442\u0442\u0435\u043d
    \u0436\u0438\u0432. \u041e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0441\u0432\u043e\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u0438 \u043d\u0430 \u043c\u043e\u043c\u0435\u043d\u0442 \u044d\u0442\u0438\u0445 \u043f\u043e\u0438\u0441\u043a\u043e\u0432
    \u043d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438
    \u043e \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438."
  personalLifeEn: 
  shortBioRu: "\u042d\u0434\u0432\u0430\u0440\u0434 \u0412\u0438\u0442\u0442\u0435\u043d \u2014 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439
    \u0444\u0438\u0437\u0438\u043a-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u0444\u0438\u0437\u0438\u043a\u0443
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u0415\u0433\u043e
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0445 \u0443\u043c\u043e\u0432
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438 \u0434\u0430\u0436\u0435
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c \u043f\u0440\u0435\u0435\u043c\u043d\u0438\u043a\u043e\u043c
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u0435\u0433\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f.
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u044d\u0442\u0430\u043f\u044b \u0436\u0438\u0437\u043d\u0438
    \u0438 \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u042d\u0434\u0432\u0430\u0440\u0434 \u0412\u0438\u0442\u0442\u0435\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 26 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1951 \u0433\u043e\u0434\u0430 \u0432 \u0411\u0430\u043b\u0442\u0438\u043c\u043e\u0440\u0435,
    \u0448\u0442\u0430\u0442 \u041c\u044d\u0440\u0438\u043b\u0435\u043d\u0434, \u0432 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041b\u044c\u044e\u0438\u0441
    \u0412\u0438\u0442\u0442\u0435\u043d, \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u0444\u0438\u0437\u0438\u043a\u043e\u043c-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c,
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u043c\u0441\u044f
    \u043d\u0430 \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438. \u041c\u0430\u0442\u044c,
    \u041b\u043e\u0440\u0440\u0435\u0439\u043d \u0412\u0438\u0442\u0442\u0435\u043d (\u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f
    \u0412\u043e\u043b\u0430\u0445), \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u044d\u043c\u0438\u0433\u0440\u0430\u043d\u0442\u043e\u0432
    \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0438\u043c\u043f\u0435\u0440\u0438\u0438.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u0412\u043e\u043f\u0440\u0435\u043a\u0438
    \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f\u043c, \u0412\u0438\u0442\u0442\u0435\u043d
    \u043d\u0435 \u043f\u043e\u0448\u0435\u043b \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c
    \u043e\u0442\u0446\u0430 \u0441\u0440\u0430\u0437\u0443. \u041e\u043d \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f
    \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0439 \u0438 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0438\u043a\u043e\u0439.
    \u0412 1968 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    17 \u043b\u0435\u0442, \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c\u044e \u0432 \u0436\u0443\u0440\u043d\u0430\u043b\u0435 The
    Nation. \u0412 1971 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u0445 \u043d\u0430\u0443\u043a
    \u043f\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438 (\u0441 \u0432\u0442\u043e\u0440\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c
    \u0443\u043a\u043b\u043e\u043d\u043e\u043c \u0432 \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0443)
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0411\u0440\u0430\u043d\u0434\u0435\u0439\u0441\u0430.
    - \u0415\u0433\u043e \u043f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0443 \u0431\u044b\u043b
    \u0438\u0437\u0432\u0438\u043b\u0438\u0441\u0442\u044b\u043c: \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0441\u043a\u043e\u0439 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438
    \u0414\u0436\u043e\u0440\u0434\u0436\u0430 \u041c\u0430\u043a\u0433\u043e\u0432\u0435\u0440\u043d\u0430
    \u0432 1972 \u0433\u043e\u0434\u0443 \u0438 \u0434\u0430\u0436\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443 \u041c\u0438\u0447\u0438\u0433\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u043f\u043e \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435,
    \u043d\u043e \u0431\u0440\u043e\u0441\u0438\u043b \u0443\u0447\u0435\u0431\u0443 \u0447\u0435\u0440\u0435\u0437
    \u043e\u0434\u0438\u043d \u0441\u0435\u043c\u0435\u0441\u0442\u0440. - \u0412 1973 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043d\u0430 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u00ab\u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u00bb,
    \u043d\u043e \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u0435\u0440\u0435\u0432\u0435\u043b\u0441\u044f
    \u043d\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442.
    - \u0412 1976 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    (Ph.D.) \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0437\u0430\u0449\u0438\u0442\u0438\u0432 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u043d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u0430 \u0414\u044d\u0432\u0438\u0434\u0430 \u0413\u0440\u043e\u0441\u0441\u0430.
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430:
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0412\u0438\u0442\u0442\u0435\u043d\u0430
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e:
    - 1976\u20131977: \u041f\u043e\u0441\u0442\u0434\u043e\u043a\u0442\u043e\u0440\u0430\u043d\u0442
    \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    - 1977\u20131980: \u041c\u043b\u0430\u0434\u0448\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043a\u043e\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0430\u0442\u043e\u0432
    (Harvard Society of Fellows). - 1980\u20131987: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0423\u0436\u0435
    \u0432 1980 \u0433\u043e\u0434\u0443, \u0431\u0443\u0434\u0443\u0447\u0438 \u043c\u043e\u043b\u043e\u0434\u044b\u043c
    \u043f\u043e\u0441\u0442\u0434\u043e\u043a\u043e\u043c, \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438
    \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u043e\u0432,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0441\u043b\u0443\u0447\u0430\u0435\u043c. - \u0421 1987 \u0433\u043e\u0434\u0430 \u043f\u043e
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u043c \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (Institute for Advanced Study) \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0448\u0442\u0430\u0442 \u041d\u044c\u044e-\u0414\u0436\u0435\u0440\u0441\u0438. \u0412
    1999-2001 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u041a\u0430\u043b\u0438\u0444\u043e\u0440\u043d\u0438\u0439\u0441\u043a\u043e\u043c
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 (\u041a\u0430\u043b\u0442\u0435\u0445).
    \u0421\u0435\u043c\u044c\u044f \u0438 \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0421 1979 \u0433\u043e\u0434\u0430 \u042d\u0434\u0432\u0430\u0440\u0434 \u0412\u0438\u0442\u0442\u0435\u043d
    \u0436\u0435\u043d\u0430\u0442 \u043d\u0430 \u041a\u044c\u044f\u0440\u0435 \u041d\u0430\u043f\u043f\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0444\u0438\u0437\u0438\u043a\u043e\u043c \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0423 \u043d\u0438\u0445 \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439: - \u0418\u043b\u0430\u043d\u0430
    \u0411. \u0412\u0438\u0442\u0442\u0435\u043d \u2014 \u043d\u0435\u0439\u0440\u043e\u0431\u0438\u043e\u043b\u043e\u0433,
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435.
    - \u0414\u0430\u043d\u0438\u044d\u043b\u0430 \u0412\u0438\u0442\u0442\u0435\u043d \u2014
    \u0431\u0438\u043e\u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    - \u0421\u044b\u043d \u2014 \u0420\u0430\u0444\u0430\u044d\u043b\u044c. \u0415\u0433\u043e
    \u0431\u0440\u0430\u0442, \u041c\u044d\u0442\u0442 \u0412\u0438\u0442\u0442\u0435\u043d,
    \u2014 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0441\u0442
    \u0438 \u043f\u0440\u043e\u0434\u044e\u0441\u0435\u0440 \u0442\u0435\u043b\u0435\u0441\u0435\u0440\u0438\u0430\u043b\u043e\u0432,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u00ab\u0417\u0430\u043a\u043e\u043d \u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a\u00bb
    \u0438 \u00ab\u0414\u043e\u043a\u0442\u043e\u0440 \u0425\u0430\u0443\u0441\u00bb. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0412\u0438\u0442\u0442\u0435\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438 \u0438 \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u044b\u043c
    \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435\u043c \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043e\u043c.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0438\u0440\u0430\u044e\u0442
    \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043c\u0435\u0436\u0434\u0443 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u043e\u0439 \u0438 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    1. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438 (1981): \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043f\u043e\u043b\u043d\u043e\u0439 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0433\u0440\u0430\u0432\u0438\u0442\u0438\u0440\u0443\u044e\u0449\u0435\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432 \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0438\u0434\u0435\u0438 \u0441\u0443\u043f\u0435\u0440\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0439 \u0434\u043b\u044f \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f
    \u0435\u043c\u0443 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438.
    2. \u0421\u0443\u043f\u0435\u0440\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u041c\u043e\u0440\u0441\u0430 (1982): \u0412
    \u0441\u0432\u043e\u0435\u0439 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u0421\u0443\u043f\u0435\u0440\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u041c\u043e\u0440\u0441\u0430\u00bb \u043e\u043d
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0444\u0438\u0437\u0438\u043a\u043e\u0439
    \u0441\u0443\u043f\u0435\u0440\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u044b\u0445
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0435\u0439 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439,
    \u0434\u0430\u0432 \u043d\u043e\u0432\u043e\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432 \u041c\u043e\u0440\u0441\u0430.
    3. \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
    \u043f\u043e\u043b\u044f (\u043a\u043e\u043d\u0435\u0446 1980-\u0445): \u0412\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u043e\u043b\u044f (TQFT). \u0412 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0442\u0435\u043e\u0440\u0438\u044f
    \u0427\u0435\u0440\u043d\u0430-\u0421\u0430\u0439\u043c\u043e\u043d\u0441\u0430 \u043c\u043e\u0436\u0435\u0442
    \u0441\u043b\u0443\u0436\u0438\u0442\u044c \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u043f\u043e\u043b\u0438\u043d\u043e\u043c\u0430
    \u0414\u0436\u043e\u043d\u0441\u0430 \u2014 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430
    \u0443\u0437\u043b\u043e\u0432, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0412\u0438\u0442\u0442\u0435\u043d\u0430-\u0420\u0435\u0448\u0435\u0442\u0438\u0445\u0438\u043d\u0430-\u0422\u0443\u0440\u0430\u0435\u0432\u0430
    \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u043d\u0438\u0437\u043a\u043e\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438. 4. \u041c-\u0442\u0435\u043e\u0440\u0438\u044f
    (1995): \u042d\u0442\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0435\u0433\u043e
    \u0441\u0430\u043c\u043e\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435.
    \u041d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438 Strings
    '95 \u043e\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b \u0441 \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c, \u0447\u0442\u043e
    \u043f\u044f\u0442\u044c \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445
    \u043d\u0430 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u0432\u0435\u0440\u0441\u0438\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u0442\u0440\u0443\u043d \u043d\u0430 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0440\u0430\u0437\u043d\u044b\u043c\u0438
    \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u043e\u0434\u043d\u043e\u0439 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u043d\u0430\u0437\u0432\u0430\u043b \u041c-\u0442\u0435\u043e\u0440\u0438\u0435\u0439.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043b\u0430
    \u043d\u0430\u0447\u0430\u043b\u043e \u00ab\u0432\u0442\u043e\u0440\u043e\u0439 \u0441\u0443\u043f\u0435\u0440\u0441\u0442\u0440\u0443\u043d\u043d\u043e\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438\u00bb. 5. \u0414\u0440\u0443\u0433\u0438\u0435
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0432\u043a\u043b\u0430\u0434\u044b:
    - \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041d\u0430\u0442\u0430\u043d\u043e\u043c
    \u0417\u0430\u0439\u0431\u0435\u0440\u0433\u043e\u043c \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0417\u0430\u0439\u0431\u0435\u0440\u0433\u0430-\u0412\u0438\u0442\u0442\u0435\u043d\u0430
    \u0434\u043b\u044f \u0441\u0443\u043f\u0435\u0440\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u044b\u0445
    \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043e\u0447\u043d\u044b\u0445 \u0442\u0435\u043e\u0440\u0438\u0439,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e
    \u043d\u043e\u0432\u044b\u0445 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438 4-\u043c\u0435\u0440\u043d\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439. - \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0410\u043d\u0442\u043e\u043d\u043e\u043c \u041a\u0430\u043f\u0443\u0441\u0442\u0438\u043d\u044b\u043c
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u0441\u0432\u044f\u0437\u0438 \u043c\u0435\u0436\u0434\u0443 S-\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0439 \u041b\u044d\u043d\u0433\u043b\u044d\u043d\u0434\u0441\u0430
    \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. - \u0412\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0433\u043e\u043b\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 (AdS/CFT-\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435)
    \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u0425\u0443\u0430\u043d\u0430
    \u041c\u0430\u043b\u0434\u0430\u0441\u0435\u043d\u044b. \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u042d\u0434\u0432\u0430\u0440\u0434 \u0412\u0438\u0442\u0442\u0435\u043d
    \u2014 \u043e\u0431\u043b\u0430\u0434\u0430\u0442\u0435\u043b\u044c \u0431\u0435\u0441\u043f\u0440\u0435\u0446\u0435\u0434\u0435\u043d\u0442\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0444\u0438\u0437\u0438\u043a\u0438
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438: - \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (1990): \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0444\u0438\u0437\u0438\u043a \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u0439
    \u044d\u0442\u043e\u0439 \u0432\u044b\u0441\u0448\u0435\u0439 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. - \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u043c\u0435\u0434\u0430\u043b\u044c \u0421\u0428\u0410
    (2002). - \u041f\u0440\u0435\u043c\u0438\u044f \u041a\u0440\u0430\u0444\u043e\u0440\u0434\u0430
    (2008). - \u041c\u0435\u0434\u0430\u043b\u044c \u041b\u043e\u0440\u0435\u043d\u0446\u0430
    (2010). - \u041c\u0435\u0434\u0430\u043b\u044c \u0418\u0441\u0430\u0430\u043a\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    (2010). - \u041f\u0440\u0435\u043c\u0438\u044f \u043f\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435 (Breakthrough Prize) (2012). - \u041f\u0440\u0435\u043c\u0438\u044f
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 (2006), \u041f\u0440\u0435\u043c\u0438\u044f
    \u041d\u0435\u043c\u043c\u0435\u0440\u0441\u0430 (2000), \u041f\u0440\u0435\u043c\u0438\u044f
    \u0425\u0430\u0440\u0432\u0438 (2005) \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435.
    \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0447\u043b\u0435\u043d\u043e\u043c
    \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0421\u0428\u0410, \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
    \u041f\u0430\u043f\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439 \u043c\u0438\u0440\u0430. \u0412 2004 \u0433\u043e\u0434\u0443
    \u0436\u0443\u0440\u043d\u0430\u043b Time \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0435\u0433\u043e
    \u0432 \u0441\u043f\u0438\u0441\u043e\u043a 100 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043b\u044e\u0434\u0435\u0439 \u043c\u0438\u0440\u0430. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0441\u0430\u043c\u044b\u043c \u0432\u044b\u0441\u043e\u043a\u0438\u043c
    \u0438\u043d\u0434\u0435\u043a\u0441\u043e\u043c \u0446\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    (h-index) \u0441\u0440\u0435\u0434\u0438 \u043d\u044b\u043d\u0435 \u0436\u0438\u0432\u0443\u0449\u0438\u0445
    \u0444\u0438\u0437\u0438\u043a\u043e\u0432. \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0441\u044d\u0440 \u041c\u0430\u0439\u043a\u043b
    \u0410\u0442\u044c\u044f \u043d\u0430 \u0432\u0440\u0443\u0447\u0435\u043d\u0438\u0438 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0441\u043a\u0430\u0437\u0430\u043b \u043e \u0412\u0438\u0442\u0442\u0435\u043d\u0435:
    \u00ab\u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u043e\u043d \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e \u0444\u0438\u0437\u0438\u043a,
    \u043f\u043e\u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u0432\u043e \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043e\u043c \u0441 \u043d\u0438\u043c \u043c\u043e\u0433\u0443\u0442
    \u043e\u0447\u0435\u043d\u044c \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u2026
    \u0412 \u0435\u0433\u043e \u0440\u0443\u043a\u0430\u0445 \u0444\u0438\u0437\u0438\u043a\u0430
    \u0441\u043d\u043e\u0432\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u044f \u0438 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb."
  shortBioEn: 
  interestingFactsRu: "\u042d\u0434\u0432\u0430\u0440\u0434 \u0412\u0438\u0442\u0442\u0435\u043d \u2014 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c,
    \u043f\u043e\u043b\u043d\u0430\u044f \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0435\u0439.
    \u041f\u0443\u0442\u044c \u043e\u0442 \u044e\u043d\u043e\u0433\u043e \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0430
    \u0434\u043e \u00ab\u043f\u0440\u0435\u0435\u043c\u043d\u0438\u043a\u0430 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430\u00bb
    \u043f\u043e\u0440\u043e\u0434\u0438\u043b \u043d\u0435\u043c\u0430\u043b\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439, \u043a\u0443\u0440\u044c\u0435\u0437\u043e\u0432
    \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432.\n\n\U0001F92F
    \u041e\u0442 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0438\u043a\u0438 \u2014
    \u043a \u0432\u0435\u0440\u0448\u0438\u043d\u0430\u043c \u0444\u0438\u0437\u0438\u043a\u0438
    \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0430\u043c\u044b\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u2014 \u043e\u043d \u043d\u0435 \u0431\u044b\u043b \u0432\u0443\u043d\u0434\u0435\u0440\u043a\u0438\u043d\u0434\u043e\u043c,
    \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0440\u0435\u0448\u0430\u0432\u0448\u0438\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. \u0412 \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u0438
    \u0412\u0438\u0442\u0442\u0435\u043d \u0433\u0440\u0435\u0437\u0438\u043b \u0441\u043e\u0432\u0441\u0435\u043c
    \u0438\u043d\u044b\u043c \u043f\u043e\u043f\u0440\u0438\u0449\u0435\u043c. \u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043a\u0442\u0438\u0432\u0438\u0441\u0442: \u0412\u0438\u0442\u0442\u0435\u043d \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u043e\u043c. \u0412 17 \u043b\u0435\u0442
    (!) \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0442\u0430\u0442\u044c\u044e
    \u0432 \u043b\u0435\u0432\u043e\u043c \u0436\u0443\u0440\u043d\u0430\u043b\u0435 The Nation,
    \u0430 \u0432 1972 \u0433\u043e\u0434\u0443 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432
    \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0441\u043a\u043e\u0439 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438
    \u0414\u0436\u043e\u0440\u0434\u0436\u0430 \u041c\u0430\u043a\u0433\u043e\u0432\u0435\u0440\u043d\u0430.
    \u041c\u0435\u0442\u0430\u043d\u0438\u044f \u0432 \u043f\u043e\u0438\u0441\u043a\u0430\u0445
    \u0441\u0435\u0431\u044f: \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u0434\u0438\u043f\u043b\u043e\u043c\u0430 \u043f\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u0443\u0440\u0443
    \u043d\u0430 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443, \u043d\u043e \u0431\u0440\u043e\u0441\u0438\u043b
    \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u043c\u0435\u0441\u0442\u0440. \u0422\u043e\u043b\u044c\u043a\u043e
    \u0437\u0430\u0442\u0435\u043c \u043e\u043d \u043f\u043e\u043f\u0430\u043b \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d
    \u043d\u0430 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u0443.\n\n\U0001F9E0 \u0413\u0435\u043d\u0438\u0439
    \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u043e\u0439: \u043a\u0430\u043a \u0443\u0441\u0442\u0440\u043e\u0435\u043d
    \u0435\u0433\u043e \u043c\u043e\u0437\u0433 \u0420\u0430\u0441\u0441\u043a\u0430\u0437\u044b
    \u043a\u043e\u043b\u043b\u0435\u0433 \u0440\u0438\u0441\u0443\u044e\u0442 \u043e\u0431\u0440\u0430\u0437
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0447\u0435\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442
    \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u043e\u0439
    \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438. \u041c\u0430\u0448\u0438\u043d\u0430 \u0434\u043b\u044f
    \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0438\u0434\u0435\u0439: \u0415\u0433\u043e
    \u0436\u0435\u043d\u0430, \u0444\u0438\u0437\u0438\u043a \u041a\u044c\u044f\u0440\u0430
    \u041d\u0430\u043f\u043f\u0438, \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0430,
    \u0447\u0442\u043e \u0412\u0438\u0442\u0442\u0435\u043d \u043c\u043e\u0436\u0435\u0442 \u0447\u0430\u0441\u0430\u043c\u0438
    \u0441\u0438\u0434\u0435\u0442\u044c \u043d\u0430 \u043a\u0443\u0445\u043d\u0435, \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e
    \u043f\u0440\u043e\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044f \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438, \u0438 \u043b\u0438\u0448\u044c \u0438\u0437\u0440\u0435\u0434\u043a\u0430
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0434\u0435\u0442\u0430\u043b\u0438. \u0417\u0432\u0443\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0443\u0433\u0430\u0435\u0442 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u0432:
    \u041e\u0434\u0438\u043d \u0441\u0442\u0430\u0436\u0435\u0440 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b,
    \u043a\u0430\u043a \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u043c\u0438, \u0441\u043b\u0443\u0448\u0430\u044f
    \u0438\u0437 \u0441\u043e\u0441\u0435\u0434\u043d\u0435\u0433\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430
    \u043d\u0435\u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u0441\u0442\u0443\u043a \u043a\u043b\u0430\u0432\u0438\u0448 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430
    \u0412\u0438\u0442\u0442\u0435\u043d\u0430. \u042d\u0442\u043e\u0442 \u0440\u0438\u0442\u043c
    \u043e\u0437\u043d\u0430\u0447\u0430\u043b, \u0447\u0442\u043e \u0438\u0437 \u0433\u043e\u043b\u043e\u0432\u044b
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u043f\u0440\u044f\u043c\u043e \u0432 \u0444\u0430\u0439\u043b\u044b
    \u043b\u043e\u0436\u0438\u0442\u0441\u044f \u043d\u043e\u0432\u0430\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u0441\u0442\u0430\u0442\u044c\u044f.\n\n\U0001F3C6 \u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0438 \u00ab\u0441\u0443\u0445\u0430\u044f\u00bb
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0412\u0438\u0442\u0442\u0435\u043d
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0432\u043e\u0438\u043c\u0438 \u0442\u0435\u043e\u0440\u0438\u044f\u043c\u0438, \u043d\u043e
    \u0438 \u043c\u0435\u0441\u0442\u0430\u043c\u0438 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0438 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430\u0445. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0444\u0438\u0437\u0438\u043a \u0441 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0435\u0439: \u0412 1990 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u0438 \u043f\u043e\u043a\u0430
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0444\u0438\u0437\u0438\u043a\u043e\u043c,
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u043c \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u2014 \u0441\u0430\u043c\u043e\u0439 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041a\u043e\u0440\u043e\u043b\u044c \u0446\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0439:
    \u041f\u043e \u0434\u0430\u043d\u043d\u044b\u043c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432, \u0412\u0438\u0442\u0442\u0435\u043d
    \u0438\u043c\u0435\u0435\u0442 \u0441\u0430\u043c\u044b\u0439 \u0432\u044b\u0441\u043e\u043a\u0438\u0439
    \u0438\u043d\u0434\u0435\u043a\u0441 \u0425\u0438\u0440\u0448\u0430 (h-index) \u0441\u0440\u0435\u0434\u0438
    \u0432\u0441\u0435\u0445 \u043d\u044b\u043d\u0435 \u0436\u0438\u0432\u0443\u0449\u0438\u0445
    \u0444\u0438\u0437\u0438\u043a\u043e\u0432, \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442
    \u043e\u0431 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u043c \u0432\u043b\u0438\u044f\u043d\u0438\u0438
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442.\n\n\U0001F9E9 \u0415\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434
    \u043d\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u043d\u0430\u0443\u043a\u0438 \u0416\u0438\u0437\u043d\u044c
    \u0412\u0438\u0442\u0442\u0435\u043d\u0430 \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u043d\u043e \u0438 \u0432\u0437\u0433\u043b\u044f\u0434
    \u043d\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f.
    \u0412 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e
    \u043e\u043d \u043f\u043e\u0434\u0435\u043b\u0438\u043b\u0441\u044f \u043e\u0447\u0435\u043d\u044c
    \u043b\u0438\u0447\u043d\u044b\u043c \u043c\u043d\u0435\u043d\u0438\u0435\u043c: > \u041e\u043d
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d, \u0447\u0442\u043e \u0442\u0430\u0439\u043d\u0430
    \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f
    \u0434\u043b\u044f \u043d\u0430\u0443\u043a\u0438 \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0439
    \u0437\u0430\u0433\u0430\u0434\u043a\u043e\u0439. \u041f\u043e \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c,
    \u0435\u043c\u0443 \u00ab\u0433\u043e\u0440\u0430\u0437\u0434\u043e \u043b\u0435\u0433\u0447\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c, \u043a\u0430\u043a \u043c\u044b
    \u043f\u043e\u0439\u043c\u0435\u043c \u0411\u043e\u043b\u044c\u0448\u043e\u0439 \u0412\u0437\u0440\u044b\u0432,
    \u0447\u0435\u043c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c, \u043a\u0430\u043a
    \u043c\u044b \u0441\u043c\u043e\u0436\u0435\u043c \u043f\u043e\u043d\u044f\u0442\u044c \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435\u00bb.
    \u042d\u0442\u0438 \u0444\u0430\u043a\u0442\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442,
    \u0447\u0442\u043e \u043f\u0435\u0440\u0435\u0434 \u043d\u0430\u043c\u0438 \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u00ab\u0441\u0443\u0445\u043e\u0439\u00bb \u0433\u0435\u043d\u0438\u0439,
    \u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u0443\u0434\u044c\u0431\u043e\u0439, \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u044b\u043c
    \u043f\u0443\u0442\u0435\u043c \u0432 \u043d\u0430\u0443\u043a\u0443 \u0438 \u043e\u0447\u0435\u043d\u044c
    \u0447\u0435\u0442\u043a\u0438\u043c\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0435\u043c\u0443 \u043f\u043e\u0434 \u0441\u0438\u043b\u0443,
    \u0430 \u0447\u0442\u043e \u2014 \u043d\u0435\u0442."
