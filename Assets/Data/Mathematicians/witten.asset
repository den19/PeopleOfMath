  achievementsRu: "\u0413\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442 \u042d\u0434\u0432\u0430\u0440\u0434\u0430 \u0412\u0438\u0442\u0442\u0435\u043d\u0430
    \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u0443 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0447\u0430\u0441\u0442\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044e\u0442
    \u0441 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0445
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432.
    \u0415\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f, \u043f\u043e
    \u0441\u0443\u0442\u0438, \u0441\u0442\u0435\u0440\u043b\u0438 \u0433\u0440\u0430\u043d\u044c
    \u043c\u0435\u0436\u0434\u0443 \u044d\u0442\u0438\u043c\u0438 \u0434\u0432\u0443\u043c\u044f
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u043c\u0438, \u0441\u043e\u0437\u0434\u0430\u0432
    \u043d\u043e\u0432\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u0412\u043e\u0442 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0432\u0435\u0445\u0438
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0438
    \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445.\n\n\U0001F9E9 \u0420\u0430\u0431\u043e\u0442\u044b,
    \u043f\u0440\u0438\u043d\u0435\u0441\u0448\u0438\u0435 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e (1990) \u0412 1990 \u0433\u043e\u0434\u0443 \u0412\u0438\u0442\u0442\u0435\u043d
    \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u0438 \u043f\u043e\u043a\u0430
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0444\u0438\u0437\u0438\u043a\u043e\u043c,
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u043c \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u2014 \u0432\u044b\u0441\u0448\u0435\u0439 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041f\u0440\u0435\u043c\u0438\u044f
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0430 \u0437\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432: \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438 (1981): \u0412 \u043e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u0431\u044b\u043b \u0432\u043e\u043f\u0440\u043e\u0441
    \u043e \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430-\u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043f\u043e\u043b\u043d\u0430\u044f \u044d\u043d\u0435\u0440\u0433\u0438\u044f
    \u0433\u0440\u0430\u0432\u0438\u0442\u0438\u0440\u0443\u044e\u0449\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0435\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u0430
    \u0438 \u0440\u0430\u0432\u043d\u0430 \u043d\u0443\u043b\u044e \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043f\u043b\u043e\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u041c\u0438\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e.
    \u0412\u0438\u0442\u0442\u0435\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0438\u0434\u0435\u0438 \u0438\u0437 \u0441\u0443\u043f\u0435\u0440\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u043f\u0440\u043e\u0449\u0435
    \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u0434\u0445\u043e\u0434\u043e\u0432. \u0421\u0443\u043f\u0435\u0440\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u041c\u043e\u0440\u0441\u0430 (1982): \u0412\u0438\u0442\u0442\u0435\u043d
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0444\u0438\u0437\u0438\u043a\u043e\u0439
    \u0441\u0443\u043f\u0435\u0440\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u044b\u0445
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0435\u0439, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0441 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u041c\u043e\u0440\u0441\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0438\u0437\u0443\u0447\u0430\u0435\u0442 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439 \u0447\u0435\u0440\u0435\u0437
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u043d\u0430 \u043d\u0438\u0445. \u041e\u043d \u0434\u0430\u043b \u043d\u043e\u0432\u043e\u0435
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432
    \u041c\u043e\u0440\u0441\u0430, \u0447\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432
    \u00ab\u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb.
    \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u043e\u043b\u044f \u0438 \u0442\u0435\u043e\u0440\u0438\u044f
    \u0443\u0437\u043b\u043e\u0432 (\u043a\u043e\u043d\u0435\u0446 1980-\u0445): \u0412\u0438\u0442\u0442\u0435\u043d
    \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u043e\u043b\u044f (TQFT). \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043e\u0447\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0427\u0435\u0440\u043d\u0430-\u0421\u0430\u0439\u043c\u043e\u043d\u0441\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0430
    \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0443\u0437\u043b\u043e\u0432 \u0438 3-\u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u043d\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438,
    \u0434\u0430\u043b\u0430 \u043d\u043e\u0432\u043e\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u043f\u043e\u043b\u0438\u043d\u043e\u043c\u0430 \u0414\u0436\u043e\u043d\u0441\u0430, \u0447\u0442\u043e
    \u043f\u043e\u0437\u0436\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0442\u0440\u043e\u0433\u0438\u0445
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0420\u0435\u0448\u0435\u0442\u0438\u0445\u0438\u043d\u0430-\u0422\u0443\u0440\u0430\u0435\u0432\u0430.
    \u042d\u0442\u043e, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u041c\u0430\u0439\u043a\u043b\u0430
    \u0410\u0442\u044c\u0438, \u0441\u0442\u0430\u043b\u043e \u044f\u0440\u043a\u0438\u043c
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u0442\u043e\u0433\u043e, \u043a\u0430\u043a
    \u0444\u0438\u0437\u0438\u043a\u0430 \u0441\u0442\u0430\u043b\u0430 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\U0001F9F5 \u041c-\u0442\u0435\u043e\u0440\u0438\u044f
    \u0438 \u0432\u0442\u043e\u0440\u0430\u044f \u0441\u0443\u043f\u0435\u0440\u0441\u0442\u0440\u0443\u043d\u043d\u0430\u044f
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u041a \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435
    1990-\u0445 \u0433\u043e\u0434\u043e\u0432 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u043f\u044f\u0442\u044c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0432\u0435\u0440\u0441\u0438\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u0442\u0440\u0443\u043d, \u0438 \u0444\u0438\u0437\u0438\u043a\u0438
    \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c \u043f\u043e\u043d\u044f\u0442\u044c, \u043a\u0430\u043a\u0430\u044f
    \u0438\u0437 \u043d\u0438\u0445 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0439.
    \u0412 1995 \u0433\u043e\u0434\u0443 \u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438
    Strings '95 \u0412\u0438\u0442\u0442\u0435\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u043b
    \u0441 \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c.
    \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b, \u0447\u0442\u043e
    \u0432\u0441\u0435 \u043f\u044f\u0442\u044c \u0442\u0435\u043e\u0440\u0438\u0439 \u2014
    \u044d\u0442\u043e \u043d\u0435 \u0440\u0430\u0437\u043d\u044b\u0435 \u0442\u0435\u043e\u0440\u0438\u0438,
    \u0430 \u043b\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u0435\u043b\u044b
    \u043e\u0434\u043d\u043e\u0439, \u0431\u043e\u043b\u0435\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u043d\u0430\u0437\u0432\u0430\u043b \u041c-\u0442\u0435\u043e\u0440\u0438\u044f. \u042d\u0442\u043e
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u043d\u0430 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0445 \u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044f\u0445
    (\u043f\u0440\u0430\u0432\u0438\u043b\u0430\u0445 \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0433\u043e
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f), \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b\u043e
    \u0432\u0441\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044b \u0438 \u043f\u043e\u043b\u043e\u0436\u0438\u043b\u043e
    \u043d\u0430\u0447\u0430\u043b\u043e \u00ab\u0432\u0442\u043e\u0440\u043e\u0439 \u0441\u0443\u043f\u0435\u0440\u0441\u0442\u0440\u0443\u043d\u043d\u043e\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438\u00bb, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043d\u0430 \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438.\n\n\U0001F9EC
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0432\u043a\u043b\u0430\u0434\u044b \u041f\u043e\u043c\u0438\u043c\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432, \u0412\u0438\u0442\u0442\u0435\u043d \u0432\u043d\u0435\u0441
