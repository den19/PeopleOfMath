    \u0418\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0417\u0430\u0439\u0431\u0435\u0440\u0433\u0430-\u0412\u0438\u0442\u0442\u0435\u043d\u0430:
    \u0412 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0435
