  achievementsRu: "\u0413\u0435\u0440\u0434 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0438 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u043c\u043e\u0449\u043d\u044b\u0445
    \u043d\u043e\u0432\u044b\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438
    \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c \u0434\u0430\u0432\u043d\u0438\u0435
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b, \u043e\u0442\u043a\u0440\u044b\u0432 \u043d\u043e\u0432\u044b\u0435
    \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u044b \u0434\u043b\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u0417\u0430 \u044d\u0442\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0432\u044b\u0441\u0448\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u0440\u0435\u043c\u0438\u044e \u0410\u0431\u0435\u043b\u044f
    2026 \u0433\u043e\u0434\u0430.\n\n\U0001F9E9 \u0420\u0435\u0448\u0435\u043d\u0438\u0435
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430
    (\u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430)
    \u0421\u0430\u043c\u044b\u043c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430 \u0432 1983 \u0433\u043e\u0434\u0443. \u042d\u0442\u0430
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430, \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u0442\u0430\u044f
    \u0432 1922 \u0433\u043e\u0434\u0443, \u0431\u043e\u043b\u0435\u0435 60 \u043b\u0435\u0442
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0432 \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0412 \u0447\u0435\u043c \u0441\u0443\u0442\u044c
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b: \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u0434\u043b\u044f
    \u0433\u043b\u0430\u0434\u043a\u043e\u0439 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043a\u0440\u0438\u0432\u043e\u0439 \u0440\u043e\u0434\u0430 \u0431\u043e\u043b\u044c\u0448\u0435
    \u0435\u0434\u0438\u043d\u0438\u0446\u044b, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0434 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u043c \u043f\u043e\u043b\u0435\u043c,
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043b\u0438\u0448\u044c \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u043e\u0447\u0435\u043a. \u041f\u0440\u043e\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u044f,
    \u0434\u043b\u044f \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043b\u0438\u0448\u044c \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0432 \u0432\u0438\u0434\u0435
    \u0434\u0440\u043e\u0431\u0435\u0439 (\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0424\u0435\u0440\u043c\u0430: \u0427\u0442\u043e\u0431\u044b
    \u043f\u043e\u043d\u044f\u0442\u044c \u0432\u0430\u0436\u043d\u043e\u0441\u0442\u044c \u044d\u0442\u043e\u0433\u043e
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430, \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u0412\u0435\u043b\u0438\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0424\u0435\u0440\u043c\u0430 (x\u207f + y\u207f
    = z\u207f). \u0414\u043b\u044f n \u2265 4 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0424\u0435\u0440\u043c\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442
    \u043a\u0440\u0438\u0432\u0443\u044e \u0440\u043e\u0434\u0430 > 1. \u0418\u0437 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e
    \u0441\u043b\u0435\u0434\u0443\u0435\u0442, \u0447\u0442\u043e \u044d\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u043c\u043e\u0436\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u043b\u0438\u0448\u044c \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0446\u0435\u043b\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 (\u043f\u0440\u0438 n > 3). \u042d\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u043c \u0448\u0430\u0433\u043e\u043c
    \u043d\u0430 \u043f\u0443\u0442\u0438 \u043a \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c\u0443
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0424\u0435\u0440\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0437\u0436\u0435
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0432 \u0432 \u0442\u043e\u043c
    \u0447\u0438\u0441\u043b\u0435 \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b,
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0435 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u043e\u043c.
    \u041d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0439 \u043c\u0435\u0442\u043e\u0434:
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430,
    \u043e\u043f\u0438\u0440\u0430\u044f\u0441\u044c \u043d\u0430 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u043d\u043e\u0432\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434. \u0412\u043c\u0435\u0441\u0442\u043e
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b\u0445 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0439
    \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0434\u0432\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u2014 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0428\u0430\u0444\u0430\u0440\u0435\u0432\u0438\u0447\u0430 \u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0422\u0435\u0439\u0442\u0430 \u0434\u043b\u044f \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439 \u043d\u0430\u0434
    \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u043c\u0438 \u043f\u043e\u043b\u044f\u043c\u0438.
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u044b\u0442\u0435\u043a\u0430\u0435\u0442 \u0438\u0437 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0428\u0430\u0444\u0430\u0440\u0435\u0432\u0438\u0447\u0430, \u0438 \u0437\u0430\u0442\u0435\u043c
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u044d\u0442\u0443 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044e\u044e. \u042d\u0442\u043e
    \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u0439 \u0438 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u043e\u0439.\n\n\U0001F9ED
    \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0438 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044f:
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430-\u041b\u0430\u043d\u0433\u0430
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430
    \u043d\u0430 \u044d\u0442\u043e\u043c \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0430\u0441\u044c.
    \u0412\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u0432\u0448\u0438\u0441\u044c \u043d\u043e\u0432\u044b\u043c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430,
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u043c \u041f\u043e\u043b\u043e\u043c
    \u0412\u043e\u0439\u0442\u043e\u0439 \u0432 1991 \u0433\u043e\u0434\u0443, \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043b \u0438 \u0440\u0430\u0437\u0432\u0438\u043b
    \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u044b. \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u0432 1991 \u0433\u043e\u0434\u0443 \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430-\u041b\u0430\u043d\u0433\u0430.
    \u042d\u0442\u043e \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u0435\u0435
    \u043e\u0431\u0449\u0435\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u043e\u0447\u0435\u043a \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430
    \u043a\u0440\u0438\u0432\u044b\u0445, \u0430 \u043d\u0430 \u043b\u044e\u0431\u044b\u0445
    \u043f\u043e\u0434\u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f\u0445
    \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439
    (\u043c\u043d\u043e\u0433\u043e\u043c\u0435\u0440\u043d\u044b\u0445 \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445).\n\n\U0001F9EC
    \u0412\u043a\u043b\u0430\u0434 \u0432 p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0425\u043e\u0434\u0436\u0430 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u0432\u043d\u0435\u0441 \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0425\u043e\u0434\u0436\u0430 \u2014 \u043e\u0431\u043b\u0430\u0441\u0442\u044c,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u0449\u0435\u0442 \u0430\u043d\u0430\u043b\u043e\u0433\u0438
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0425\u043e\u0434\u0436\u0430 (\u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0449\u0435\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439)
    \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439
    \u043d\u0430\u0434 p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043f\u043e\u043b\u044f\u043c\u0438.
    \u041e\u043d \u0434\u0430\u043b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0433\u0438\u043f\u043e\u0442\u0435\u0437,
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0414\u0436\u043e\u043d\u043e\u043c \u0422\u0435\u0439\u0442\u043e\u043c \u0438 \u0416\u0430\u043d-\u041c\u0430\u0440\u043a\u043e\u043c
    \u0424\u043e\u043d\u0442\u0435\u043d\u043e\u043c, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0432
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443
    p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u044d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u044f\u043c\u0438 \u0438 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u044f\u043c\u0438
    \u0434\u0435 \u0420\u0430\u043c\u0430. \u041e\u043d \u0432\u0432\u0435\u043b \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435
    \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b,
    \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \"\u043f\u043e\u0447\u0442\u0438 \u044d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f\", \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0442\u0430\u043b\u0438 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c\u0438 \u0434\u043b\u044f
    \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f
    \u0432\u0441\u0435\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0415\u0433\u043e
    \u0438\u0434\u0435\u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0434\u043b\u044f p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f
    \u0421\u0438\u043c\u043f\u0441\u043e\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u0430\u0431\u0435\u043b\u0435\u0432\u044b\u043c
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435\u043c p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0425\u043e\u0434\u0436\u0430 \u0438 \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442
    p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0440\u0443\u043f\u043f\u044b \u0441 \u0440\u0430\u0441\u0441\u043b\u043e\u0435\u043d\u0438\u044f\u043c\u0438
    \u0425\u0438\u0433\u0433\u0441\u0430.\n\n\U0001F6E0\ufe0f \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u041f\u043e\u043c\u0438\u043c\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437, \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u0441\u043e\u0437\u0434\u0430\u043b \u0446\u0435\u043b\u044b\u0439 \u0440\u044f\u0434 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0438 \u0442\u0435\u043e\u0440\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438 \u043f\u043e \u0432\u0441\u0435\u043c\u0443
    \u043c\u0438\u0440\u0443: \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0438
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430 (Product Theorem): \u0411\u044b\u043b
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430-\u041b\u0430\u043d\u0433\u0430
    \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043c\u043e\u0449\u043d\u044b\u043c
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435\u043c \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0420\u043e\u0442\u0430 \u043e \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u044b\u0445
    \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044f\u0445. \u041f\u043e\u0437\u0436\u0435,
    \u0432 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u0441 \u0413\u0438\u0441\u0431\u0435\u0440\u0442\u043e\u043c \u0412\u044e\u0441\u0442\u0445\u043e\u043b\u044c\u0446\u0435\u043c,
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u044d\u0442\u0443
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0433\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0420\u043e\u0442\u0430 \u0438 \u0435\u0435 \u043c\u043d\u043e\u0433\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u2014 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u043e \u043f\u043e\u0434\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u0445
    \u0428\u043c\u0438\u0434\u0442\u0430. \u041a\u043e\u043c\u043f\u0430\u043a\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f
    \u043c\u043e\u0434\u0443\u043b\u0435\u0439 \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439: \u0412 1990 \u0433\u043e\u0434\u0443
    \u0432 \u0441\u0432\u043e\u0435\u0439 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0439 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0427\u0438\u043d-\u041b\u0438 \u0427\u0430\u0435\u043c, \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439 \u0417\u0438\u0433\u0435\u043b\u044f.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439
    \u0438 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0439
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439 \u0428\u0438\u043c\u0443\u0440\u044b.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0445
    \u0440\u0430\u0441\u0441\u043b\u043e\u0435\u043d\u0438\u0439 \u043d\u0430 \u043a\u0440\u0438\u0432\u044b\u0445:
    \u0412\u043d\u0435\u0441 \u0432\u0430\u0436\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u044d\u0442\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u0432 \u0442\u043e\u043c
    \u0447\u0438\u0441\u043b\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u0432 \u0441\u0432\u043e\u0439
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0412\u0435\u0440\u043b\u0438\u043d\u0434\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u043c\u0435\u0435\u0442 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u0441\u0432\u044f\u0437\u0438 \u0441 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u043f\u043e\u043b\u044f \u0438 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0441\u0442\u0440\u0443\u043d.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0421\u043f\u0438\u0441\u043e\u043a \u043d\u0430\u0433\u0440\u0430\u0434 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430
    \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u0435\u0433\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u044f:
    \u041f\u0440\u0435\u043c\u0438\u044f \u0410\u0431\u0435\u043b\u044f (2026) \u2014 \u0437\u0430
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437 \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430
    \u0438 \u041b\u0430\u043d\u0433\u0430. \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (1986) \u2014 \u0437\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430.
    \u041f\u0440\u0435\u043c\u0438\u044f \u0428\u0430\u043e (2015) \u2014 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0425\u0435\u043d\u0440\u0438\u043a\u043e\u043c \u0418\u0432\u0430\u043d\u0435\u0446\u0435\u043c.
    \u041f\u0440\u0435\u043c\u0438\u044f \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0430 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 (1996) \u2014 \u0432\u044b\u0441\u0448\u0430\u044f
    \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438
    \u0434\u043b\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439.
    \u0413\u0435\u0440\u0434 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0438\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447; \u043e\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u044f\u0437\u044b\u043a \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0433\u043e\u0432\u043e\u0440\u0438\u0442
    \u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b \u0432 \u0435\u0434\u0438\u043d\u0443\u044e
    \u043c\u043e\u0449\u043d\u0443\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443,
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0449\u0443\u044e \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u044c
    \u043d\u043e\u0432\u044b\u0435 \u043f\u043b\u043e\u0434\u044b."
  achievementsEn: 
  personalLifeRu: "\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0438 \u0441\u0435\u043c\u044c\u0435 \u0413\u0435\u0440\u0434\u0430
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430,
    \u043e\u0434\u043d\u0430\u043a\u043e \u043e\u043d\u0430, \u043a\u0430\u043a \u0438 \u0443
    \u043c\u043d\u043e\u0433\u0438\u0445 \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u0443\u0447\u0435\u043d\u044b\u0445,
    \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0441\u043a\u0443\u043f\u0430 \u0438 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u0430
    \u0432\u043e\u043a\u0440\u0443\u0433 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0421\u0435\u043c\u044c\u044f \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0413\u0435\u0440\u0434 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    28 \u0438\u044e\u043b\u044f 1954 \u0433\u043e\u0434\u0430 \u0432 \u0440\u0430\u0439\u043e\u043d\u0435
    \u0411\u044e\u0440 \u0433\u043e\u0440\u043e\u0434\u0430 \u0413\u0435\u043b\u044c\u0437\u0435\u043d\u043a\u0438\u0440\u0445\u0435\u043d
    (\u0444\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0437\u0435\u043c\u043b\u044f
    \u0421\u0435\u0432\u0435\u0440\u043d\u044b\u0439 \u0420\u0435\u0439\u043d-\u0412\u0435\u0441\u0442\u0444\u0430\u043b\u0438\u044f).
    \u041e\u043d \u0432\u044b\u0440\u043e\u0441 \u0432 \u0441\u0435\u043c\u044c\u0435 \u0443\u0447\u0435\u043d\u044b\u0445:
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u0444\u0438\u0437\u0438\u043a\u043e\u043c,
    \u0430 \u043c\u0430\u0442\u044c \u2014 \u0445\u0438\u043c\u0438\u043a\u043e\u043c, \u0438
    \u043e\u0431\u0430 \u0438\u043c\u0435\u043b\u0438 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0438\u0435
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u044d\u0442\u0430 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0440\u0435\u0434\u0430 \u0441 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442
    \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0430 \u043d\u0430 \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u0442\u043e\u0447\u043d\u044b\u043c \u043d\u0430\u0443\u043a\u0430\u043c.\n\n\u2764\ufe0f
    \u0411\u0440\u0430\u043a \u0438 \u0434\u0435\u0442\u0438 \u0416\u0438\u0437\u043d\u044c
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0431\u044b\u043b\u0430 \u0442\u0435\u0441\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0435\u0433\u043e \u0441\u0443\u043f\u0440\u0443\u0433\u043e\u0439,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0410\u043d\u0433\u0435\u043b\u0438\u043a\u043e\u0439
    \u0427\u0438\u043c\u043c\u0435\u043b\u044c (Angelika Tschimmel). \u041e\u043d\u0438 \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c
    \u0432 1984 \u0433\u043e\u0434\u0443. \u0412 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c
    \u0433\u043e\u0434\u0443, \u0432 1985-\u043c, \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043e\u0442 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0441 \u0436\u0435\u043d\u043e\u0439 \u0432 \u0421\u0428\u0410. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0442\u0430\u043c, \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435, \u0443
    \u043f\u0430\u0440\u044b \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0434\u0432\u0435
    \u0434\u043e\u0447\u0435\u0440\u0438 \u2014 \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430
    \u0438 \u0423\u043b\u044c\u0440\u0438\u043a\u0435.\n\n\u23f3 \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e \u0438 \u043f\u043e\u0442\u0435\u0440\u044f
    \u0412 1994 \u0433\u043e\u0434\u0443 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e, \u0447\u0442\u043e\u0431\u044b
    \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u0442\u044c \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u041e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u041c\u0430\u043a\u0441\u0430 \u041f\u043b\u0430\u043d\u043a\u0430 \u0432 \u0411\u043e\u043d\u043d\u0435.
    \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0432 2011 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u0410\u043d\u0433\u0435\u043b\u0438\u043a\u0430
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u0448\u043b\u0430 \u0438\u0437
    \u0436\u0438\u0437\u043d\u0438 \u0438\u0437-\u0437\u0430 \u0440\u0430\u043a\u0430. \u0421
    \u0442\u0435\u0445 \u043f\u043e\u0440 \u043e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0432\u0434\u043e\u0432\u0446\u043e\u043c. \u0421\u0430\u043c \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u0432 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e
    \u0441 \u044e\u043c\u043e\u0440\u043e\u043c \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c, \u0433\u043e\u0432\u043e\u0440\u044f,
    \u0447\u0442\u043e \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0435\u0433\u043e \u0441\u043b\u0430\u0432\u0430 \u0431\u044b\u043b\u0430
    \u043d\u0435\u0434\u043e\u043b\u0433\u043e\u0439 \u0438 \u043e\u043d \u043c\u043e\u0433
    \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0445\u043e\u0434\u0438\u0442\u044c \u043f\u043e
    \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430\u043c, \u0430 \u0432 \u043e\u0442\u0432\u0435\u0442
    \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0441\u0430\u043c\u043e\u043c
    \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0449\u0435\u043c\u0441\u044f \u0434\u043d\u0435
    \u0432 \u0436\u0438\u0437\u043d\u0438 \u0448\u0443\u0442\u0438\u043b, \u0447\u0442\u043e
    \u044d\u0442\u043e \u0431\u044b\u043b \u0434\u0435\u043d\u044c \u0435\u0433\u043e \u0436\u0435\u043d\u0438\u0442\u044c\u0431\u044b,
    \u0438\u043d\u0430\u0447\u0435 \u0431\u044b \u0435\u0433\u043e \u0436\u0435\u043d\u0430
    \u043d\u0430 \u043d\u0435\u0433\u043e \u043e\u0431\u0438\u0434\u0435\u043b\u0430\u0441\u044c.
    \u042d\u0442\u0438 \u0441\u043b\u043e\u0432\u0430 \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u044e\u0442
    \u0432\u0430\u0436\u043d\u043e\u0441\u0442\u044c \u0441\u0435\u043c\u044c\u0438 \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e."
  personalLifeEn: 
  shortBioRu: "\u0413\u0435\u0440\u0434 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 (Gerd Faltings)
    \u2014 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u043d\u0430\u0443\u043a\u0443.
    \u0412 2026 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u043c \u0443\u0447\u0435\u043d\u044b\u043c, \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u043c
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u043c \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0420\u0430\u043d\u0435\u0435, \u0432 1986 \u0433\u043e\u0434\u0443, \u043e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0431\u044b\u043b \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0435\u0439, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442
    \u0435\u0433\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u043f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0438\u0445
    \u043e\u0431\u0435 \u0432\u044b\u0441\u0448\u0438\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u041d\u0438\u0436\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0443\u0447\u0435\u043d\u043e\u0433\u043e,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445.\n\n\U0001F4DC \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0413\u0435\u0440\u0434
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    28 \u0438\u044e\u043b\u044f 1954 \u0433\u043e\u0434\u0430 \u0432 \u0440\u0430\u0439\u043e\u043d\u0435
    \u0411\u044e\u0440 \u0433\u043e\u0440\u043e\u0434\u0430 \u0413\u0435\u043b\u044c\u0437\u0435\u043d\u043a\u0438\u0440\u0445\u0435\u043d
    (\u0444\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0437\u0435\u043c\u043b\u044f
    \u0421\u0435\u0432\u0435\u0440\u043d\u044b\u0439 \u0420\u0435\u0439\u043d-\u0412\u0435\u0441\u0442\u0444\u0430\u043b\u0438\u044f,
    \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f). \u041e\u043d \u0432\u044b\u0440\u043e\u0441
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0443\u0447\u0435\u043d\u044b\u0445: \u0435\u0433\u043e
    \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u0444\u0438\u0437\u0438\u043a\u043e\u043c,
    \u0430 \u043c\u0430\u0442\u044c \u2014 \u0445\u0438\u043c\u0438\u043a\u043e\u043c, \u043e\u0431\u0430
    \u0438\u043c\u0435\u043b\u0438 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0438\u0435
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0418\u043d\u0442\u0435\u0440\u0435\u0441 \u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0443 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e
    \u0440\u0430\u043d\u043e. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u043a\u043e\u043b\u043e
    12 \u043b\u0435\u0442 \u043e\u043d \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0443\u0432\u043b\u0435\u043a\u0441\u044f
    \u0444\u0438\u0437\u0438\u043a\u043e\u0439, \u043d\u043e \u0437\u0430\u0442\u0435\u043c
    \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u043b\u0430
    \u0435\u0433\u043e \u0441\u0432\u043e\u0435\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u044f\u0441\u043d\u043e\u0441\u0442\u044c\u044e: \u00ab\u0432\u0435\u0449\u0438 \u043b\u0438\u0431\u043e
    \u0438\u0441\u0442\u0438\u043d\u043d\u044b, \u043b\u0438\u0431\u043e \u043b\u043e\u0436\u043d\u044b,
    \u0438 \u044d\u0442\u043e \u043d\u0435 \u0432\u043e\u043f\u0440\u043e\u0441 \u043c\u043d\u0435\u043d\u0438\u044f\u00bb.
    \u041f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0448\u043a\u043e\u043b\u044b
    Max-Planck-Gymnasium \u0432 \u0413\u0435\u043b\u044c\u0437\u0435\u043d\u043a\u0438\u0440\u0445\u0435\u043d\u0435
    \u0432 1972 \u0433\u043e\u0434\u0443, \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0412\u0435\u0441\u0442\u0444\u0430\u043b\u044c\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438
    \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430 \u0432 \u041c\u044e\u043d\u0441\u0442\u0435\u0440\u0435,
    \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0443. \u0415\u0433\u043e \u0443\u0447\u0435\u0431\u0430
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u0430 \u043d\u0430 18
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0438\u0437-\u0437\u0430 \u0441\u043b\u0443\u0436\u0431\u044b
    \u0432 \u0430\u0440\u043c\u0438\u0438.\n\n\U0001F393 \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430: \u043e\u0442 \u041c\u044e\u043d\u0441\u0442\u0435\u0440\u0430
    \u0434\u043e \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0430 - \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041c\u044e\u043d\u0441\u0442\u0435\u0440\u0430 (1972\u20131982): \u0412 1978 \u0433\u043e\u0434\u0443
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u0434\u0438\u043f\u043b\u043e\u043c \u0438 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c (Ph.D.) \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0425\u0430\u043d\u0441\u0430-\u0419\u043e\u0430\u0445\u0438\u043c\u0430
    \u041d\u0430\u0441\u0442\u043e\u043b\u044c\u0434\u0430. \u0415\u0433\u043e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430 \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435. \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435
    \u0437\u0430\u0449\u0438\u0442\u044b \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u041d\u0435\u043c\u0435\u0446\u043a\u043e\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (DFG) \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0433\u043e\u0434 \u0432 \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430.
    \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432 \u041c\u044e\u043d\u0441\u0442\u0435\u0440
    \u0432 1979 \u0433\u043e\u0434\u0443, \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c \u0443 \u041d\u0430\u0441\u0442\u043e\u043b\u044c\u0434\u0430
    \u0438 \u0432 1981 \u0433\u043e\u0434\u0443 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043f\u0440\u043e\u0448\u0435\u043b
    \u0445\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044e, \u0447\u0442\u043e \u0434\u0430\u043b\u043e
    \u0435\u043c\u0443 \u043f\u0440\u0430\u0432\u043e \u043d\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c. - \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0412\u0443\u043f\u043f\u0435\u0440\u0442\u0430\u043b\u044f (1982\u20131984): \u0412 1982
    \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 28 \u043b\u0435\u0442,
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0441\u0442\u0430\u043b \u043f\u043e\u043b\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0412\u0443\u043f\u043f\u0435\u0440\u0442\u0430\u043b\u044f, \u0441\u0442\u0430\u0432 \u0441\u0430\u043c\u044b\u043c
    \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438
    \u043d\u0430 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0441\u0432\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435.
    - \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    (1985\u20131994): \u0412 1985 \u0433\u043e\u0434\u0443 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043e\u0442 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0433\u043e \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 (\u0421\u0428\u0410),
    \u0433\u0434\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u043f\u043e\u0447\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043b\u0435\u0442.
    \u0422\u0430\u043c \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0410\u043d\u0433\u0435\u043b\u0438\u043a\u0435
    \u0427\u0438\u043c\u043c\u0435\u043b\u044c (\u0443\u043c\u0435\u0440\u043b\u0430 \u0432
    2011 \u0433\u043e\u0434\u0443), \u0438 \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c
    \u0434\u0432\u0435 \u0434\u043e\u0447\u0435\u0440\u0438, \u041a\u0440\u0438\u0441\u0442\u0438\u043d\u0430
    \u0438 \u0423\u043b\u044c\u0440\u0438\u043a\u0435.\n\n\U0001F4A1 \u0413\u043b\u0430\u0432\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435: \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430
    \u0412 1983 \u0433\u043e\u0434\u0443, \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u0435\u0449\u0435
    \u0432 \u0412\u0443\u043f\u043f\u0435\u0440\u0442\u0430\u043b\u0435, \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432, \u0434\u043e\u043a\u0430\u0437\u0430\u0432
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430.
    \u0410\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041b\u0443\u0438\u0441 \u041c\u043e\u0440\u0434\u0435\u043b\u043b \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0435 \u0435\u0449\u0435 \u0432 1922 \u0433\u043e\u0434\u0443. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u0430, \u0447\u0442\u043e \u0434\u043b\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445
    \u0440\u043e\u0434\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0435\u0434\u0438\u043d\u0438\u0446\u044b
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043b\u0438\u0448\u044c \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u043e\u0447\u0435\u043a. \u041f\u0440\u043e\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u044f,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0435 \u0442\u0438\u043f\u044b
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043c\u043e\u0433\u0443\u0442 \u0438\u043c\u0435\u0442\u044c \u043b\u0438\u0448\u044c \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0432 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445 (\u0434\u0440\u043e\u0431\u044f\u0445). \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u044d\u0442\u043e\u0439 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u043e\u0439
    \u0431\u043e\u043b\u0435\u0435 60 \u043b\u0435\u0442, \u0441\u0442\u0430\u043b\u043e \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u0435\u0439
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043c\u0438\u0440\u0435. \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u043d\u043e\u0432\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0432 \u043d\u0430\u0443\u043a\u0435, \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0432
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b. \u0412\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043a\u0430\u043a
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430.
    \u0421\u0430\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0441\u044f,
    \u0447\u0442\u043e \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u043d\u0435
    \u0431\u044b\u043b \u0443\u0432\u0435\u0440\u0435\u043d \u0432 \u0443\u0441\u043f\u0435\u0445\u0435
    \u0438 \u043d\u0430\u0434\u0435\u044f\u043b\u0441\u044f \u043b\u0438\u0448\u044c \u043d\u0430
    \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b.\n\n\U0001F3C6
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    \u0417\u0430 \u0441\u0432\u043e\u0435 \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0435\u0441\u044f
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043d\u0430\u0433\u0440\u0430\u0434: - \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (1986): \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    32 \u043b\u0435\u0442 \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u0432\u044b\u0441\u0448\u0435\u0439 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0434\u043b\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u043c\u043b\u0430\u0434\u0448\u0435
    40 \u043b\u0435\u0442 \u043d\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u043c
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    - \u041f\u0440\u0435\u043c\u0438\u044f \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u0430
    \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430
    (1996): \u0412\u044b\u0441\u0448\u0430\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u0430
    \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438 \u0434\u043b\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439,
    \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0430\u0435\u043c\u0430\u044f \u041d\u0435\u043c\u0435\u0446\u043a\u0438\u043c
    \u043d\u0430\u0443\u0447\u043d\u043e-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c (DFG). - \u041f\u0440\u0435\u043c\u0438\u044f
    \u0428\u0430\u043e (2015): \u041f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0425\u0435\u043d\u0440\u0438\u043a\u043e\u043c \u0418\u0432\u0430\u043d\u0435\u0446\u0435\u043c
    \u0437\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. - \u041f\u0440\u0435\u043c\u0438\u044f \u0410\u0431\u0435\u043b\u044f
    (2026): \u0421\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u043c
    \u044d\u0442\u043e\u0439 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0435\u0439\u0448\u0435\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 \u00ab\u0437\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0445
    \u0446\u0435\u043b\u044b\u0435 \u0447\u0438\u0441\u043b\u0430\u00bb. \u0422\u0430\u043a\u0436\u0435
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0447\u043b\u0435\u043d\u043e\u043c \u043c\u043d\u043e\u0433\u0438\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439
    \u043d\u0430\u0443\u043a, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434\u0438\u043d\u0443
    (1992), \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0435 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e (2016) \u0438 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a \u0421\u0428\u0410
    (2018). \u0415\u0433\u043e \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442
    \u041e\u0444\u0438\u0446\u0435\u0440\u0441\u043a\u0438\u0439 \u043a\u0440\u0435\u0441\u0442
    (2009) \u0438 \u0411\u043e\u043b\u044c\u0448\u043e\u0439 \u043a\u0440\u0435\u0441\u0442
    \u0441\u043e \u0437\u0432\u0435\u0437\u0434\u043e\u0439 (2025) \u043e\u0440\u0434\u0435\u043d\u0430
    \u00ab\u0417\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u0438 \u043f\u0435\u0440\u0435\u0434
    \u0424\u0435\u0434\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0439
    \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f\u00bb.\n\n\U0001F3EB \u0420\u0430\u0431\u043e\u0442\u0430
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u041c\u0430\u043a\u0441\u0430
    \u041f\u043b\u0430\u043d\u043a\u0430 \u0438 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0412 1994 \u0433\u043e\u0434\u0443
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e, \u0441\u0442\u0430\u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u043c, \u0430 \u0441 1995 \u0433\u043e\u0434\u0430
    \u2014 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u041e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u041c\u0430\u043a\u0441\u0430 \u041f\u043b\u0430\u043d\u043a\u0430 \u0432 \u0411\u043e\u043d\u043d\u0435.
    \u041e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u044d\u0442\u043e\u0442 \u043f\u043e\u0441\u0442
    \u0434\u043e \u0432\u044b\u0445\u043e\u0434\u0430 \u043d\u0430 \u043f\u0435\u043d\u0441\u0438\u044e
    \u0432 2023 \u0433\u043e\u0434\u0443, \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u044f \u0432 \u0411\u043e\u043d\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u041d\u0430 \u043f\u043e\u0441\u0442\u0443
    \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430 \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u043e\u0439, \u043a\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0441\u0432\u043e\u044e \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e
    \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0431\u044b\u043b\u0438 \u043e\u0447\u0435\u043d\u044c \u0448\u0438\u0440\u043e\u043a\u0438:
    \u043e\u0442 \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 p-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0425\u043e\u0434\u0436\u0430 \u0434\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0445
    \u0440\u0430\u0441\u0441\u043b\u043e\u0435\u043d\u0438\u0439 \u043d\u0430 \u043a\u0440\u0438\u0432\u044b\u0445.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0421\u0438\u043d\u044a\u0438\u0442\u0438 \u041c\u043e\u0442\u0438\u0434\u0437\u0443\u043a\u0438.
    \u0413\u0435\u0440\u0434 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0432\u043d\u043e\u0441\u0438\u0442\u044c \u0432\u043a\u043b\u0430\u0434 \u0432 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443, \u043e\u0441\u0442\u0430\u0432\u0430\u044f\u0441\u044c \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0444\u0438\u0433\u0443\u0440
    \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435."
  shortBioEn: 
  interestingFactsRu: "\u0413\u0435\u0440\u0434 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u2014 \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u043c\u0438 \u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u043c\u0438.
    \u0417\u0430 \u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438
    \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c,
    \u043f\u043e\u043b\u043d\u0430\u044f \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0445
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432, \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0434\u0430\u0436\u0435 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u0437\u043e\u0440\u0441\u0442\u0432\u0430. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0438 \u043a\u0430\u0440\u044c\u0435\u0440\u044b,
    \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0438\u0437 \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0445
    \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e \u0438 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432.\n\n\U0001F9D1\u200d\U0001F3EB
    \u0421\u0430\u043c\u044b\u0439 \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0438 \"\u0441\u043b\u0443\u0447\u0430\u0439\u043d\u0430\u044f\" \u0441\u043b\u0430\u0432\u0430
    \u0412 1982 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    27 \u043b\u0435\u0442, \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0441\u0442\u0430\u043b
    \u0441\u0430\u043c\u044b\u043c \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u043f\u043e\u043b\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438. \u042d\u0442\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0431\u044b\u043b\u043e \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u044f\u044e\u0449\u0438\u043c
    \u0441\u0430\u043c\u043e \u043f\u043e \u0441\u0435\u0431\u0435, \u043d\u043e \u0443\u0436\u0435
    \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0433\u043e\u0434 \u043e\u043d
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043d\u0435\u0447\u0442\u043e, \u0447\u0442\u043e
    \u0441\u0434\u0435\u043b\u0430\u043b\u043e \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c
    \u043d\u0430 \u0432\u0435\u0441\u044c \u043c\u0438\u0440. \u0421\u0430\u043c\u043e\u0435
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435, \u0447\u0442\u043e,
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u044f \u043a \u0440\u0430\u0431\u043e\u0442\u0435
    \u043d\u0430\u0434 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u043e\u0439 \u041c\u043e\u0440\u0434\u0435\u043b\u043b\u0430,
    \u043e\u043d \u043d\u0435 \u0441\u0442\u0430\u0432\u0438\u043b \u043f\u0435\u0440\u0435\u0434
    \u0441\u043e\u0431\u043e\u0439 \u0446\u0435\u043b\u044c \u0435\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c.
    \u041e\u043d \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442, \u0447\u0442\u043e
    \u0434\u0440\u0443\u0433 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f, \u041b\u044e\u0441\u044c\u0435\u043d
    \u0428\u043f\u0438\u0440\u043e, \u043f\u043e\u0434\u0435\u043b\u0438\u043b\u0441\u044f \u0441
    \u043d\u0438\u043c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u0438\u0434\u0435\u044f\u043c\u0438.
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u043f\u043e\u0434\u0443\u043c\u0430\u043b:
    \u00ab\u042f, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0438 \u043d\u0435 \u0434\u043e\u043a\u0430\u0436\u0443
    \u0435\u0435, \u043d\u043e \u0438\u0437 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u0436\u0435\u0442
    \u0432\u044b\u0439\u0442\u0438 \u0447\u0442\u043e-\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0435\u00bb.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u043c\u0443 \u044d\u0442\u043e \u0443\u0434\u0430\u043b\u043e\u0441\u044c,
    \u043e\u043d \u0441\u0430\u043c \u0431\u044b\u043b \u0443\u0434\u0438\u0432\u043b\u0435\u043d.
    \u041e\u043d \u0434\u0430\u0436\u0435 \u0448\u0443\u0442\u0438\u043b, \u0447\u0442\u043e
    \u0435\u043c\u0443 \u043f\u0440\u043e\u0441\u0442\u043e \"\u043f\u043e\u0432\u0435\u0437\u043b\u043e\",
    \u0438 \u0447\u0442\u043e \u0441 \u0442\u0435\u0445 \u043f\u043e\u0440 \u043e\u043d \"\u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043f\u0435\u0440\u0432\u044b\u043c \u043a\u043b\u0430\u0441\u0441\u043e\u043c \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\".
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043d\u0435 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u0438\u0434\u0435\u0438
    \u0428\u043f\u0438\u0440\u043e \u0432\u0441\u0435\u0440\u044c\u0435\u0437, \u0447\u0442\u043e
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u043e \u044d\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u0435\u0437 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043e\u0432
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e.\n\n\U0001F4A1 \u0421\u043a\u0435\u043f\u0442\u0438\u043a-\u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0430:
    \"\u042f \u043d\u0435 \u043b\u044e\u0431\u043b\u044e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043d\u0435 \u043e\u0431\u0434\u0443\u043c\u0430\u043b\"
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u044f\u0440\u043a\u0438\u043c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u0435\u043c
    \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u0432 \u043d\u0430\u0443\u043a\u0435. \u041e\u043d
    \u043f\u0440\u0438\u0437\u043d\u0430\u0435\u0442\u0441\u044f: \u00ab\u042f \u043d\u0435
    \u043b\u044e\u0431\u043b\u044e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043e \u0442\u043e\u043c,
    \u0447\u0442\u043e \u043d\u0435 \u043e\u0431\u0434\u0443\u043c\u0430\u043b \u0441\u0430\u043c\u00bb.
    \u0418\u0434\u0435\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442 \u043a \u043d\u0435\u043c\u0443
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u043e\u0433\u0443\u043b\u043e\u043a
    \u0438\u043b\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u0441\u0430\u0434\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u043c\u043e\u0437\u0433 \u043d\u0435 \u0437\u0430\u043d\u044f\u0442
    \u043d\u0438\u0447\u0435\u043c \u0434\u0440\u0443\u0433\u0438\u043c. \u041e\u043d \u0441
    \u044e\u043c\u043e\u0440\u043e\u043c \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f
    \u043a \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c \u043c\u0435\u0442\u043e\u0434\u0430\u043c
    \u0440\u0430\u0431\u043e\u0442\u044b. \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441
    \u043e \u0431\u0443\u0434\u0443\u0449\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432 \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \"\u043f\u0440\u043e\u0432\u0435\u0440\u044f\u043b\u044c\u0449\u0438\u043a\u043e\u0432\"
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432, \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u0441 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e\u0439
    \u043f\u0440\u044f\u043c\u043e\u0442\u043e\u0439: \"\u041d\u0435\u0442, \u044d\u0442\u043e
    \u043d\u0435 \u0434\u043b\u044f \u043c\u0435\u043d\u044f... \u042f, \u043a\u0430\u043a \u0414\u0430\u0432\u0438\u0434
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442, \u043d\u0435 \u0445\u043e\u0447\u0443,
    \u0447\u0442\u043e\u0431\u044b \u043c\u043d\u0435 \u043f\u043e\u0440\u0442\u0438\u043b\u0438
    \u043c\u043e\u044e \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443\".
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0441\u043a\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043a \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443, \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044f
    \u0435\u0433\u043e \u0441 \"\u043f\u0443\u0441\u0442\u043e\u0439 \u0431\u043e\u043b\u0442\u043e\u0432\u043d\u0435\u0439\"
    \u043d\u0430 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0435 \u2014 \u043e\u043d
    \u0437\u0432\u0443\u0447\u0438\u0442 \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u043e \u043b\u0438\u0448\u044c \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043d\u043e\u0435.\n\n\U0001F575\ufe0f
    \u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441\u0430
    \u0438 \"\u0441\u043b\u043e\u0436\u043d\u044b\u0439\" \u0443\u0447\u0435\u043d\u0438\u043a
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u0441\u044b\u0433\u0440\u0430\u043b
    \u0432\u0430\u0436\u043d\u0443\u044e, \u043d\u043e \u043c\u0430\u043b\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435
    \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0424\u0435\u0440\u043c\u0430.
    \u041a\u043e\u0433\u0434\u0430 \u042d\u043d\u0434\u0440\u044e \u0423\u0430\u0439\u043b\u0441
    \u043d\u0430\u0448\u0435\u043b \u0441\u043f\u043e\u0441\u043e\u0431 \u0437\u0430\u043a\u0440\u044b\u0442\u044c
    \u043f\u0440\u043e\u0431\u0435\u043b \u0432 \u0441\u0432\u043e\u0435\u043c \u043f\u0435\u0440\u0432\u043e\u043c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435, \u043e\u043d
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0443 \u043d\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438
    \u0432 \u0422\u043e\u0441\u043a\u0430\u043d\u0435, \u043f\u043e\u043a\u0430 \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u043b\u0438\u0441\u044c \"\u0441\u043b\u0430\u0434\u043a\u043e\u0439
    \u0436\u0438\u0437\u043d\u044c\u044e\", \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441
    \u043f\u043e \u0432\u0435\u0447\u0435\u0440\u0430\u043c \u0447\u0438\u0442\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0443
    \u0423\u0430\u0439\u043b\u0441\u0430 \u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b
    \u0435\u0435 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e\u0441\u0442\u044c, \u0447\u0442\u043e
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0423\u0430\u0439\u043b\u0441\u0443
    \u043d\u0430\u043a\u043e\u043d\u0435\u0446 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0412 \u0442\u043e \u0436\u0435
    \u0432\u0440\u0435\u043c\u044f \u0435\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c
    \u2014 \u044f\u043f\u043e\u043d\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0421\u0438\u043d\u044a\u0438\u0442\u0438 \u041c\u043e\u0442\u0438\u0434\u0437\u0443\u043a\u0438
    \u2014 \u0441\u043b\u043e\u0436\u043d\u044b. \u041c\u043e\u0442\u0438\u0434\u0437\u0443\u043a\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u043e\u0436\u0435 \u0443\u0447\u0438\u043b\u0441\u044f
    \u0443 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0432 2012 \u0433\u043e\u0434\u0443 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435, \u043d\u043e
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0441\u043b\u043e\u0436\u043d\u043e\u0435 \u0438 \u0441\u043f\u043e\u0440\u043d\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e ABC-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b.
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u043f\u0440\u044f\u043c\u043e \u0437\u0430\u044f\u0432\u0438\u043b:
    \"\u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u043e\u0442\u0435\u043d \u0441\u0442\u0440\u0430\u043d\u0438\u0446, \u0438 \u044f
    \u0438\u0445 \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e.... \u041d\u043e \u043e\u043d
    \u043c\u043e\u0439 \u0443\u0447\u0435\u043d\u0438\u043a, \u0438 \u044f \u043d\u0435 \u0431\u0443\u0434\u0443
    \u0435\u0433\u043e \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u0442\u044c\".\n\n\U0001F3B5
    \u0416\u0438\u0437\u043d\u044c \u0432\u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0412\u043e\u043f\u0440\u0435\u043a\u0438 \u043e\u0431\u0440\u0430\u0437\u0443 \"\u0441\u0443\u0445\u043e\u0433\u043e\"
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u0443 \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441\u0430
    \u0435\u0441\u0442\u044c \u0432\u043f\u043e\u043b\u043d\u0435 \u0437\u0435\u043c\u043d\u044b\u0435
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u0424\u0443\u0442\u0431\u043e\u043b:
    \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u044b\u043c
    \u0431\u043e\u043b\u0435\u043b\u044c\u0449\u0438\u043a\u043e\u043c \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u043b\u0443\u0431\u0430 \"\u0428\u0430\u043b\u044c\u043a\u0435-04\" \u0438\u0437
    \u0435\u0433\u043e \u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0413\u0435\u043b\u044c\u0437\u0435\u043d\u043a\u0438\u0440\u0445\u0435\u043d\u0430.
    \u041a\u0443\u043b\u044c\u0442\u0443\u0440\u0430: \u041e\u043d \u0437\u043d\u0430\u0442\u043e\u043a
    \u043e\u043f\u0435\u0440\u044b \u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0443\u0437\u044b\u043a\u0438, \u043b\u044e\u0431\u0438\u0442 \u0445\u043e\u0440\u043e\u0448\u0435\u0435
    \u0432\u0438\u043d\u043e \u0438 \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u0441\u0430\u0434\u0443.\n\n\U0001F3C6
    \u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0424\u0430\u043b\u044c\u0442\u0438\u043d\u0433\u0441 \u2014 \u043e\u0431\u043b\u0430\u0434\u0430\u0442\u0435\u043b\u044c
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0441\u0435\u0445
    \u043c\u044b\u0441\u043b\u0438\u043c\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434, \u043d\u043e
    \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0438
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    \u0432 2026 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u043d\u044b \u0441\u0430\u043c\u043e\u0438\u0440\u043e\u043d\u0438\u0438.
    \u0423\u0437\u043d\u0430\u0432 \u043e \u043d\u0430\u0433\u0440\u0430\u0434\u0435, \u043e\u043d
    \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0441\u043e\u0432\u0441\u0435\u043c
    \u043d\u0435 \u043e\u0436\u0438\u0434\u0430\u043b \u044d\u0442\u043e\u0433\u043e, \u0442\u0430\u043a
    \u043a\u0430\u043a \u0434\u0443\u043c\u0430\u043b, \u0447\u0442\u043e \"\u0443\u0436\u0435
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0441\u0442\u0430\u0440 \u0434\u043b\u044f \u0442\u0430\u043a\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434\". \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043f\u043e\u0448\u0443\u0442\u0438\u043b,
    \u0447\u0442\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u0435\u043c\u0443 \u043d\u0443\u0436\u043d\u043e
    \u0430\u0440\u0435\u043d\u0434\u043e\u0432\u0430\u0442\u044c \u0441\u043c\u043e\u043a\u0438\u043d\u0433
    \u0434\u043b\u044f \u0446\u0435\u0440\u0435\u043c\u043e\u043d\u0438\u0438."
