  achievementsRu: "\u0427\u0442\u043e\u0431\u044b \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443
    \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u0432\u043a\u043b\u0430\u0434\u0430
    \u041c\u0438\u0445\u0430\u0438\u043b\u0430 \u0413\u0440\u043e\u043c\u043e\u0432\u0430, \u043d\u0443\u0436\u043d\u043e
    \u043f\u043e\u043d\u044f\u0442\u044c, \u0447\u0442\u043e \u043e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0438\u043b \u0440\u044f\u0434 \u0441\u043b\u043e\u0436\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447. \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0435
    \u044f\u0437\u044b\u043a\u0438 \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u0441\u0432\u044f\u0437\u0438 \u043c\u0435\u0436\u0434\u0443, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0431\u044b, \u0434\u0430\u043b\u0435\u043a\u0438\u043c\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c\u0438
    \u043c\u043e\u0436\u043d\u043e \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0447\u0435\u0440\u0435\u0437
    \u043f\u0440\u0438\u0437\u043c\u0443 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b\u0438
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0439 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u0435\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439.\n\n\U0001F52C
    `h`-\u041f\u0440\u0438\u043d\u0446\u0438\u043f: \u041a\u043e\u0433\u0434\u0430 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0430\u043d\u0430\u043b\u0438\u0437
    \u042d\u0442\u043e \u043e\u0434\u043d\u043e \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0413\u0440\u043e\u043c\u043e\u0432\u0430. \u0412 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0447\u0430\u0441\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043d\u0430\u0439\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u0441 \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438). `h`-\u043f\u0440\u0438\u043d\u0446\u0438\u043f
    (\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0439)
    \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441:
    \u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u043f\u043e \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c\u0443
    (\u0438\u043b\u0438 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c\u0443)
    \u0440\u0435\u0448\u0435\u043d\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043f\u043e \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c, \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0442\u043e\u0447\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u044e\u0449\u0435\u0435
    \u0432\u0441\u0435\u043c \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f\u043c? \u0413\u0440\u043e\u043c\u043e\u0432
    \u0441\u043e\u0437\u0434\u0430\u043b \u043e\u0431\u0449\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0434\u043b\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430
    \u0437\u0430\u0434\u0430\u0447, \u0433\u0434\u0435 \u044d\u0442\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.
    \u041f\u0440\u043e\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u044f, \u043e\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447\u0438 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0433\u043e,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430
    \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0438 \u0431\u044b\u043b\u0430 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0430
    \u0432 \u0435\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u00ab\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438\u00bb. \u042d\u0442\u043e
    \u0434\u0430\u043b\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442,
    \u0433\u0434\u0435 \u0432\u043c\u0435\u0441\u0442\u043e \u0441\u043b\u043e\u0436\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0431\u043e\u043b\u0435\u0435
    \u043f\u0440\u043e\u0441\u0442\u0443\u044e \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e.\n\n\U0001F30A
    \u0421\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0446\u0435\u043b\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0412\u043a\u043b\u0430\u0434
    \u0413\u0440\u043e\u043c\u043e\u0432\u0430 \u0432 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u2014 \u044d\u0442\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435
    \u0434\u0435\u0442\u0438\u0449\u0435, \u0437\u0430\u043b\u043e\u0436\u0438\u0432\u0448\u0435\u0435
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438. \u041f\u0441\u0435\u0432\u0434\u043e\u0433\u043e\u043b\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0435
    \u043a\u0440\u0438\u0432\u044b\u0435: \u0412 1985 \u0433\u043e\u0434\u0443 \u0413\u0440\u043e\u043c\u043e\u0432
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0440\u043e\u0440\u044b\u0432, \u0432\u0432\u0435\u0434\u044f
    `J`-\u0433\u043e\u043b\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0435 \u043a\u0440\u0438\u0432\u044b\u0435.
    \u041e\u043d \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u0433\u043e\u043b\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445 \u043a\u0440\u0438\u0432\u044b\u0445
    \u0438\u0437 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430
    \u043d\u0430 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0449\u0438\u0439
    \u043c\u0438\u0440 \u043f\u043e\u0447\u0442\u0438 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439. \u042d\u0442\u043e
    \u0431\u044b\u043b\u043e \u043f\u043e\u0445\u043e\u0436\u0435 \u043d\u0430 \u0442\u043e,
    \u043a\u0430\u043a \u0435\u0441\u043b\u0438 \u0431\u044b \u043a\u0442\u043e-\u0442\u043e
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0434\u043b\u044f \u043f\u043b\u0430\u0432\u0430\u043d\u0438\u044f
    \u043f\u043e\u0434\u043e\u0439\u0434\u0443\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0433\u043b\u0430\u0434\u043a\u0438\u0435
    \u0440\u0435\u043a\u0438, \u043d\u043e \u0438 \u0431\u0443\u0440\u043d\u044b\u0435 \u043f\u043e\u0442\u043e\u043a\u0438.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0413\u0440\u043e\u043c\u043e\u0432\u0430 \u043e
    \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f
    \u044d\u0442\u0438\u0445 \u043a\u0440\u0438\u0432\u044b\u0445 \u0441\u0442\u0430\u043b\u0430
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u043d\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043d\u0435\u0432\u044b\u0436\u0438\u043c\u0430\u043d\u0438\u0438: \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0435 \u043c\u0435\u0436\u0434\u0443 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438
    (\u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0449\u0438\u043c\u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443)
    \u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0449\u0438\u043c\u0438
    \u043e\u0431\u044a\u0435\u043c. \u041e\u043d\u0430 \u0433\u043b\u0430\u0441\u0438\u0442,
    \u0447\u0442\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u043b\u043e\u0436\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0448\u0430\u0440
    \u0432 \u0431\u043e\u043b\u0435\u0435 \u0443\u0437\u043a\u0438\u0439 \u0446\u0438\u043b\u0438\u043d\u0434\u0440,
    \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u043e\u0431\u044a\u0435\u043c \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442.
    \u042d\u0442\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u0436\u0435\u0441\u0442\u043a\u043e\u0441\u0442\u0438
    \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0418\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b
    \u0413\u0440\u043e\u043c\u043e\u0432\u0430\u2013\u0412\u0438\u0442\u0442\u0435\u043d\u0430:
    \u0415\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0438\u0432\u0435\u043b\u0430
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432
    \u0413\u0440\u043e\u043c\u043e\u0432\u0430\u2013\u0412\u0438\u0442\u0442\u0435\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u043f\u043e \u0441\u0443\u0442\u0438, \u0441\u0447\u0438\u0442\u0430\u044e\u0442
    \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0441\u0435\u0432\u0434\u043e\u0433\u043e\u043b\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u043a\u0440\u0438\u0432\u044b\u0445. \u042d\u0442\u0438 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b
    \u0441\u0442\u0430\u043b\u0438 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u043e \u0438 \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u043e\u043b\u044f \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u0442\u0440\u0443\u043d.\n\n\U0001F3D4\ufe0f
    \u0420\u0438\u043c\u0430\u043d\u043e\u0432\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f:
    \u041d\u043e\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0441\u0442\u0430\u0440\u044b\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0438\u043b \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u0443
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u0441\u043c\u0435\u0441\u0442\u0438\u0432
    \u0444\u043e\u043a\u0443\u0441 \u0441 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432 (\u0432\u0440\u043e\u0434\u0435 \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u044b
    \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0442\u043e\u0447\u043a\u0435) \u043d\u0430
    \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u0446\u0435\u043b\u043e\u0433\u043e \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f.
    \u0421\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0413\u0440\u043e\u043c\u043e\u0432\u0430\u2013\u0425\u0430\u0443\u0441\u0434\u043e\u0440\u0444\u0430:
    \u041e\u043d \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u043c\u0435\u0436\u0434\u0443 \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u043c\u0438, \u0447\u0442\u043e
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c
    \u043e \"\u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438\" \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439 \u043a \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443
    (\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441 \u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044f\u043c\u0438).
    \u042d\u0442\u043e \u0434\u0430\u043b\u043e \u043c\u043e\u0449\u043d\u044b\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0441\u0442\u0438 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0441\u0435\u043c\u044c\u0438 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439
    \u043a\u0430\u043a \u0446\u0435\u043b\u043e\u0435. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043f\u043e\u0447\u0442\u0438 \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f\u0445:
    \u0411\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u0435\u0442
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0432\u0441\u0435 \u0441\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u044b
    \u043e\u0447\u0435\u043d\u044c \u043c\u0430\u043b\u044b.\n\n\U0001F9E9 \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0443\u043f\u043f: \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0432 \u043c\u0438\u0440\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0413\u0440\u043e\u043c\u043e\u0432
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0433\u0440\u0443\u043f\u043f\u044b
    (\u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b \u0430\u043b\u0433\u0435\u0431\u0440\u044b) \u043c\u043e\u0436\u043d\u043e
    \u0438 \u043d\u0443\u0436\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043a\u0430\u043a
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u044b.
    \u0413\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b: \u0412 \u0441\u0432\u043e\u0435\u0439 \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0435\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 1987 \u0433\u043e\u0434\u0430 \u043e\u043d \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0433\u0440\u0443\u043f\u043f (\u0438\u043b\u0438 \u0433\u0440\u0443\u043f\u043f \u0413\u0440\u043e\u043c\u043e\u0432\u0430).
    \u041e\u043d \u043f\u0435\u0440\u0435\u043d\u0435\u0441 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u044b \u043d\u0430 \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u044b\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b. \u0414\u043b\u044f \u0442\u0430\u043a\u0438\u0445
    \u0433\u0440\u0443\u043f\u043f \u0431\u044b\u043b\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u044b
    \u043c\u043e\u0449\u043d\u044b\u0435 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b. \u042d\u0442\u043e \u0434\u0430\u043b\u043e \u043a\u043b\u044e\u0447
    \u043a \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044e \u0438\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b,
    \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439 \u043f\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u0433\u0440\u0443\u043f\u043f\u0430\u0445
    \u043f\u043e\u043b\u0438\u043d\u043e\u043c\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0440\u043e\u0441\u0442\u0430: \u0420\u0430\u043d\u0435\u0435 \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0433\u0440\u0443\u043f\u043f\u044b \u0441 \u043f\u043e\u043b\u0438\u043d\u043e\u043c\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0440\u043e\u0441\u0442\u043e\u043c (\u0447\u0438\u0441\u043b\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432
    \u0432 \u0448\u0430\u0440\u0435 \u0440\u0430\u0441\u0442\u0435\u0442 \u043a\u0430\u043a
    \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d) \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \"\u043f\u043e\u0447\u0442\u0438 \u043d\u0438\u043b\u044c\u043f\u043e\u0442\u0435\u043d\u0442\u043d\u044b\u043c\u0438\",
    \u0442\u043e \u0435\u0441\u0442\u044c \u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0442 \u043f\u0440\u043e\u0441\u0442\u043e\u0439
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043e\u0439. \u042d\u0442\u043e \u0431\u044b\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0432\u044f\u0437\u0430\u043b \u0447\u0438\u0441\u0442\u043e \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u043e\u0435
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0440\u043e\u0441\u0442\u0430 \u0441 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b.\n\n\U0001F9EC
    \u041d\u043e\u0432\u044b\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u044b: \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0438 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044f \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0413\u0440\u043e\u043c\u043e\u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442 \u0441\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0432\u0437\u0433\u043b\u044f\u0434 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0438\u0441\u043a\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440,
    \u0441\u0442\u043e\u044f\u0449\u0438\u0445 \u0437\u0430 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u0430\u043c\u0438,
    \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0433\u0435\u043d\u043e\u043c\u044b
    \u0438\u043b\u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u043c\u043e\u0437\u0433\u0430.
    \u041e\u043d \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c
    \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441\u044b: \u043a\u0430\u043a \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u043c\u043e\u0433\u0443\u0442 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0438 \u043a\u0430\u043a \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c? \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0431\u043e\u0440
    \u0442\u0435\u043e\u0440\u0435\u043c, \u0430 \u0446\u0435\u043b\u0430\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f,
    \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u2014 \u044d\u0442\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u044f\u0437\u044b\u043a \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u0438 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0435\u0439
    \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445 \u044f\u0432\u043b\u0435\u043d\u0438\u044f\u0445,
    \u043e\u0442 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0445 \u0433\u0440\u0443\u043f\u043f
    \u0434\u043e \u0444\u043e\u0440\u043c \u0433\u0435\u043d\u043e\u043c\u043e\u0432. \u0417\u0430
    \u044d\u0442\u0438\u043c\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438
    \u0441\u0442\u043e\u044f\u0442 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u043f\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044e
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u0438\u0442\u0435\u0442\u0430,
    \"\u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u043d\u043e\u0432\u044b\u043c \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u043c
    \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0441\u0444\u0435\u0440\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\"."
  achievementsEn: "To truly assess the extent of Michael Gromov's contribution, we need to understand that he has not simply solved a number of difficult problems. He has created new languages to describe mathematical reality, showing that the deep links between seemingly distant areas can be seen through the lens of geometry. His work has been carried out by several parallel revolutions in mathematics. Here is a detailed overview of his key achievements.\n\nWhen a topology meets an analysis, it's one of Gromov's most fundamental and early achievements. In mathematics, it often needs to solve an equation (e.g. find a function with specified properties).`h'-principle (Homotopia principle) answers the question: can a approximate (or formal) solution, which exists for topological reasons, build an accurate solution that satisfies all differential limitations? Thromes created a common theory for a huge class of tasks where possible.Simply put, it has set the conditions under which the topological possibility of a problem guarantees the existence of a present, geometric solution, which has radically changed the way it looks at differential equations and was set out in its fundamental monograph, \"Differnal relationships with private derivatives\", which has given mathematicians a powerful tool where, instead of complex analysis, a simpler topology could be used.\n\nSymlexic Geometry: The birth of a whole region of Gromov's contribution to the Symptotic Geometry is probably his most famous child, laying the foundation for symlexic topology. Psychoglomorphic curves: In 1985, Gromov made a breakthrough by introducing `J'-holomorphic curves, and he expanded the notion of holomorphic curves from a complex analysis to a much more general world of almost complex diversity.It was like if someone showed that not only perfectly smooth rivers would be suitable for navigation, but also a stormy stream. The Gromov theory of compactity for these curves became the cornerstone of a new theory. The theory of non-squeezing: The famous theorem, which showed the fundamental difference between the Symptotic (sympathetic structure) and just the volume.It says that you can't put a large ball in a smaller cylinder, even if the volume allows it. This amazing and profound assertion has become a symbol of the rigidity of symphlex geometry. The invariants of Gromov-Witten: His theory led to the creation of the Gromov-Witten invariants, which basically consider the number of pseudo-holomorphic curves.These invariants have become the most important tool not only in mathematics, but also in modern quantum field and string theory.\n\nRemanova Geometry: A new look at the old Thromov objects completely re-thinked the Romano geometry, shifting the focus from local properties (like curves at each point) to the global properties of a variety.The convergence of Thromov-Hausdorf: He introduced the concept of distance between different geometric spaces, which allowed us to talk about the \"consequence\" of a sequence of diversitys to a certain limit space (perhaps singularities). This gave a powerful principle of compactness and the opportunity to study families of diversity as a whole.Theorem of almost flat diversity: A brilliant result that classifys diversity that has all secular curves very small.\n\nThe Geometric theory of groups: Geometry in the world of the algebra of Gromov showed that groups (the fundamental objects of the algebra) can and should be studied as geometric objects. Hyperbolic groups: In his 1987 fundamental work, he introduced the concept of hyperbolic groups (or groups of the Gromov), and he moved the geometric concept of negative curves to discrete groups.Strong algorithmic and topological methods have been developed for such groups. This has provided a key to understanding their structure, final origin and the classification of elements. The polynomial growth groups theorem: previously, it has proved that polynomial growth groups (the number of elements in the balloon grows as a multi-member) are \"nearly nippotential\", i.e. they have a simple structure.It was a fundamental result that linked a purely combinatorial pattern of growth to the deep structure of the group.\n\nNew Horizons: Mathematics and Biology In recent years, Gromov has been actively applying his geometric look beyond classical mathematics and is searching for mathematical structures behind complex biological objects such as genomes or brain work.He's trying to answer the questions: how do geometric principles describe evolution and how to formalize the complexity of biological systems? His contribution is not just a set of theorems, but a whole philosophy that geometry is a universal language for describing structure and patterns across phenomena, from abstract groups to forms of genomes.These achievements are followed by profound original ideas, which, according to the Abel Committee, \"bring new perspectives on geometry and other fields of mathematics\"."
  personalLifeRu: "\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0435 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043e \u0441\u0430\u043c\u043e\u043c \u041c\u0438\u0445\u0430\u0438\u043b\u0435 \u041b\u0435\u043e\u043d\u0438\u0434\u043e\u0432\u0438\u0447\u0435
    \u0432\u0435\u0441\u044c\u043c\u0430 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u044b.
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u0432 1967 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041c\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0435
    \u0413\u0440\u043e\u043c\u043e\u0432\u043e\u0439 (\u0434\u0435\u0432\u0438\u0447\u044c\u044f
    \u0444\u0430\u043c\u0438\u043b\u0438\u044f \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u0430).
    \u0411\u044b\u043b \u043b\u0438 \u044d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c,
    \u0435\u0441\u0442\u044c \u043b\u0438 \u0443 \u043d\u0435\u0433\u043e \u0434\u0435\u0442\u0438
    \u2014 \u0432 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u044d\u0442\u0438 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043d\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f.
    \u0412\u0441\u044f \u0435\u0433\u043e \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u044d\u0442\u0438\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c, \u2014 \u044d\u0442\u043e \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430.
    \u041f\u043e\u0441\u043b\u0435 \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438 \u0438\u0437
    \u0421\u0421\u0421\u0420 \u0432 1974 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u0432\u0448\u0438\u0441\u044c
    \u043d\u0430 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438."
  personalLifeEn: "The available information about Michael Leonidovich himself is very limited, and it is known that in 1967 he married Margarita Gromov (the maiden name is not specified), whether the marriage was the only child he had — the information is not disclosed in the sources found — and that his public life, according to these figures, is his work. After his emigration from the USSR in 1974, he devoted himself to mathematics, focusing entirely on scientific activity."
  shortBioRu: "\u041c\u0438\u0445\u0430\u0438\u043b \u041b\u0435\u043e\u043d\u0438\u0434\u043e\u0432\u0438\u0447
    \u0413\u0440\u043e\u043c\u043e\u0432 (\u043d\u0430 \u0417\u0430\u043f\u0430\u0434\u0435
    \u0447\u0430\u0441\u0442\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0430\u043a
    \u041c\u0438\u0448\u0430 \u0413\u0440\u043e\u043c\u043e\u0432) \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0447\u044c\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412 2009 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0447\u0430\u0441\u0442\u043e
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u00ab\u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0435\u0439 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb,
    \u0437\u0430 \u0441\u0432\u043e\u0439 \u00ab\u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e\u00bb.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e.\n\n\U0001F9EC \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b, \u0441\u0435\u043c\u044c\u044f \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u041c\u0438\u0445\u0430\u0438\u043b \u041b\u0435\u043e\u043d\u0438\u0434\u043e\u0432\u0438\u0447
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 23 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1943 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u043e\u043a\u0441\u0438\u0442\u043e\u0433\u043e\u0440\u0441\u043a\u0435
    \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.
    \u0415\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c
    \u043d\u0430 \u0442\u044f\u0436\u0435\u043b\u043e\u0435 \u0432\u043e\u0435\u043d\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f: \u0435\u0433\u043e \u043c\u0430\u0442\u044c, \u0432\u043e\u0435\u043d\u043d\u044b\u0439
    \u0432\u0440\u0430\u0447 \u041b\u0438\u044f \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u043d\u0430
    \u0420\u0430\u0431\u0438\u043d\u043e\u0432\u0438\u0447, \u0441\u043b\u0443\u0436\u0438\u043b\u0430
    \u043d\u0430 \u0412\u043e\u043b\u0445\u043e\u0432\u0441\u043a\u043e\u043c \u0444\u0440\u043e\u043d\u0442\u0435
    \u0438 \u0431\u044b\u043b\u0430 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u0430 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c
    \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u0443\u044e, \u0447\u0442\u043e\u0431\u044b \u0440\u043e\u0434\u0438\u0442\u044c
    \u0441\u044b\u043d\u0430. \u041e\u0442\u0435\u0446, \u041b\u0435\u043e\u043d\u0438\u0434
    \u0418\u043d\u043d\u043e\u043a\u0435\u043d\u0442\u044c\u0435\u0432\u0438\u0447 \u0413\u0440\u043e\u043c\u043e\u0432,
    \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b \u0432\u043e\u0435\u043d\u043d\u044b\u043c
    \u0432\u0440\u0430\u0447\u043e\u043c-\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u043e\u0430\u043d\u0430\u0442\u043e\u043c\u043e\u043c.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043c\u0430\u0442\u044c
    \u041c\u0438\u0445\u0430\u0438\u043b\u0430 \u0413\u0440\u043e\u043c\u043e\u0432\u0430 \u0431\u044b\u043b\u0430
    \u0434\u0432\u043e\u044e\u0440\u043e\u0434\u043d\u043e\u0439 \u0441\u0435\u0441\u0442\u0440\u043e\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u0448\u0430\u0445\u043c\u0430\u0442\u0438\u0441\u0442\u0430
    \u041c\u0438\u0445\u0430\u0438\u043b\u0430 \u0411\u043e\u0442\u0432\u0438\u043d\u043d\u0438\u043a\u0430.
    \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    9 \u043b\u0435\u0442, \u043c\u0430\u0442\u044c \u043f\u043e\u0434\u0430\u0440\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043a\u043d\u0438\u0433\u0443 \u0413\u0430\u043d\u0441\u0430 \u0420\u0430\u0434\u0435\u043c\u0430\u0445\u0435\u0440\u0430
    \u0438 \u041e\u0442\u0442\u043e \u0422\u0435\u043f\u043b\u0438\u0446\u0430 \u00ab\u042d\u0442\u044e\u0434\u044b
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b\u0430 \u0432 \u043d\u0435\u043c \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0421\u0432\u043e\u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u043d\u0430\u043d\u0438\u044f \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0435, \u0433\u0434\u0435
    \u0443\u0447\u0438\u043b\u0441\u044f \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    217-\u0439 \u0448\u043a\u043e\u043b\u0435 (\u0431\u044b\u0432\u0448\u0430\u044f \u041f\u0435\u0442\u0440\u0438\u0448\u0443\u043b\u0435).
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u0438\u0439 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0432 1965 \u0433\u043e\u0434\u0443. \u0422\u0430\u043c
    \u0436\u0435 \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0430
    \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u0410\u0431\u0440\u0430\u043c\u043e\u0432\u0438\u0447\u0430
    \u0420\u043e\u0445\u043b\u0438\u043d\u0430. \u0412 1969 \u0433\u043e\u0434\u0443 \u0413\u0440\u043e\u043c\u043e\u0432
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e, \u0430 \u0432 1973 \u0433\u043e\u0434\u0443
    \u2014 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c.\n\n\U0001F680 \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041d\u0430\u0447\u0430\u043b\u043e \u0432 \u0421\u0421\u0421\u0420
    \u0438 \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f: \u0421 1967 \u0433\u043e\u0434\u0430
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c
    \u0438 \u0434\u043e\u0446\u0435\u043d\u0442\u043e\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u043e-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f\u0445. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u043d\u0435\u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435 \u0441 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u0438 \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435
    \u043a \u0441\u0432\u043e\u0431\u043e\u0434\u0435 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e
    \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u0412 1974 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0421\u0421\u0421\u0420 \u043f\u043e \u0438\u0437\u0440\u0430\u0438\u043b\u044c\u0441\u043a\u043e\u0439
    \u0432\u0438\u0437\u0435 \u0438 \u0447\u0435\u0440\u0435\u0437 \u0418\u0442\u0430\u043b\u0438\u044e
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410. \u042d\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c, \u043e\u0442\u043a\u0440\u044b\u0432\u0448\u0438\u043c
    \u0435\u043c\u0443 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043c\u0438\u0440\u043e\u0432\u043e\u043c\u0443
    \u043d\u0430\u0443\u0447\u043d\u043e\u043c\u0443 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0443.
    \u0417\u0430\u0440\u0443\u0431\u0435\u0436\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434:
    \u0421\u0428\u0410 (1974\u20131981): \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435
    \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0448\u0442\u0430\u0442\u0430
    \u041d\u044c\u044e-\u0419\u043e\u0440\u043a \u0432 \u0421\u0442\u043e\u0443\u043d\u0438-\u0411\u0440\u0443\u043a,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0431\u044b\u043b\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e.
    \u0424\u0440\u0430\u043d\u0446\u0438\u044f (\u0441 1981 \u0433\u043e\u0434\u0430): \u0412
    1981 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e. \u0412 1981\u20131982 \u0433\u043e\u0434\u0430\u0445
    \u043e\u043d \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u041f\u0430\u0440\u0438\u0436\u0430 VI (\u043d\u044b\u043d\u0435 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041f\u044c\u0435\u0440\u0430 \u0438 \u041c\u0430\u0440\u0438\u0438 \u041a\u044e\u0440\u0438).
    \u0412 1982 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0433\u043e
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0432\u044b\u0441\u0448\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IH\u00c9S) \u0432 \u0411\u044e\u0440-\u0441\u044e\u0440-\u0418\u0432\u0435\u0442\u0442,
    \u0433\u0434\u0435 \u0437\u0430\u043d\u044f\u043b \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c. \u0412 1992 \u0433\u043e\u0434\u0443
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u0440\u0438\u043d\u044f\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e. \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438,
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u041c\u044d\u0440\u0438\u043b\u0435\u043d\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (1991\u20131996) \u0438 \u0441 1996 \u0433\u043e\u0434\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0432 \u041a\u0443\u0440\u0430\u043d\u0442\u043e\u0432\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a \u043f\u0440\u0438 \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.\n\n\U0001F52C
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u041c\u0438\u0445\u0430\u0438\u043b
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430 \u0441\u0442\u0430\u0440\u044b\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u043e\u0439, \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f. \u0415\u0433\u043e
    \u0438\u0434\u0435\u0438 \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0446\u0435\u043b\u044b\u0445 \u043d\u043e\u0432\u044b\u0445 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.
    \\(h\\)-\u043f\u0440\u0438\u043d\u0446\u0438\u043f: \u041e\u0434\u043d\u043e \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u043d\u043d\u0438\u0445 \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u0413\u0440\u043e\u043c\u043e\u0432\u0430
    \u2014 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c, \u043a\u043e\u0433\u0434\u0430
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0430
    \u043a\u0430\u043a \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0438
    \u00ab\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438\u00bb. \u0421\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u0413\u0440\u043e\u043c\u043e\u0432
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438. \u041e\u043d \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \\(J\\)-\u0433\u043e\u043b\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u043a\u0440\u0438\u0432\u044b\u0445, \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0413\u0440\u043e\u043c\u043e\u0432\u0430\u2013\u0412\u0438\u0442\u0442\u0435\u043d\u0430,
    \u0432\u0430\u0436\u043d\u044b\u0445 \u0434\u043b\u044f \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u044f. \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u00ab\u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043d\u0435\u0432\u044b\u0436\u0438\u043c\u0430\u043d\u0438\u0438\u00bb
    (Nonsqueezing theorem) \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0435 \u043c\u0435\u0436\u0434\u0443 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438 \u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0438\u043c\u0438 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438.
    \u0420\u0438\u043c\u0430\u043d\u043e\u0432\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f:
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043d\u043e\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0432 \u0446\u0435\u043b\u043e\u043c, \u0438\u0437\u0443\u0447\u0430\u044f \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0430\u0434\u043a\u0438\u0435, \u043d\u043e
    \u0438 \u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0449\u0438\u0435 \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430. \u0421\u0440\u0435\u0434\u0438
    \u0435\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u2014
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043f\u043e\u0447\u0442\u0438 \u043f\u043b\u043e\u0441\u043a\u0438\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f\u0445, \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430
    \u0411\u0435\u0442\u0442\u0438 \u0438 \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c
    \u0413\u0440\u043e\u043c\u043e\u0432\u0430\u2013\u0425\u0430\u0443\u0441\u0434\u043e\u0440\u0444\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043c\u043e\u0449\u043d\u044b\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u043a\u043b\u0430\u0441\u0441\u043e\u0432
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439.
    \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
    \u0433\u0440\u0443\u043f\u043f: \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u0413\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b\u00bb (Gromov hyperbolic groups) \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u043e\u0441\u043d\u043e\u0432\u044b \u0446\u0435\u043b\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041e\u043d \u043f\u0435\u0440\u0435\u043d\u0435\u0441
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0434\u0435\u0438
    (\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0443)
    \u043d\u0430 \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0433\u0440\u0443\u043f\u043f\u044b,
    \u0447\u0442\u043e \u0434\u0430\u043b\u043e \u043d\u043e\u0432\u044b\u0439 \u043c\u043e\u0449\u043d\u044b\u0439
    \u044f\u0437\u044b\u043a \u0434\u043b\u044f \u0438\u0445 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \u0433\u0440\u0443\u043f\u043f\u0430\u0445
    \u043f\u043e\u043b\u0438\u043d\u043e\u043c\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0440\u043e\u0441\u0442\u0430. \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0442\u0430\u043a\u0436\u0435 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u044b \u043a \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u043d\u0435\u0439\u0440\u043e\u043d\u0430\u0443\u043a\u0430\u043c. \u041e\u043d
    \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0434\u043b\u044f \u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440,
    \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u0438 \u0433\u0435\u043d\u043e\u043c\u043e\u0432
    \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u043c\u043e\u0437\u0433\u0430.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0417\u0430 \u0441\u0432\u043e\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u041c\u0438\u0445\u0430\u0438\u043b \u0413\u0440\u043e\u043c\u043e\u0432
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0441\u0435 \u0441\u0430\u043c\u044b\u0435 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0435
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 \u043c\u0438\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043f\u0440\u0435\u043c\u0438\u0438: \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (2009) \u2014 \u00ab\u0437\u0430 \u0435\u0433\u043e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e\u00bb.
    \u041f\u0440\u0435\u043c\u0438\u044f \u0412\u043e\u043b\u044c\u0444\u0430 (1993). \u041c\u0435\u0434\u0430\u043b\u044c
    \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u043e\u0433\u043e (1997). \u041f\u0440\u0435\u043c\u0438\u044f
    \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430 (1999). \u041f\u0440\u0435\u043c\u0438\u044f
    \u041a\u0438\u043e\u0442\u043e (2002). \u041f\u0440\u0435\u043c\u0438\u044f \u0412\u0435\u0431\u043b\u0435\u043d\u0430
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 (1981). \u041f\u0440\u0435\u043c\u0438\u044f
    \u041d\u0435\u043c\u043c\u0435\u0440\u0441\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    (2004). \u0427\u043b\u0435\u043d\u0441\u0442\u0432\u043e \u0432 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f\u0445
    \u0438 \u0437\u0432\u0430\u043d\u0438\u044f: \u0418\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a (\u0420\u0410\u041d) (2011). \u0427\u043b\u0435\u043d \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0424\u0440\u0430\u043d\u0446\u0438\u0438 (\u0441 1997, \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u0441 1989). \u0418\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0421\u0428\u0410
    (1989). \u0418\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439 \u0447\u043b\u0435\u043d
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (2011). \u041f\u043e\u0447\u0451\u0442\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439 \u043c\u0438\u0440\u0430. \u041c\u0438\u0445\u0430\u0438\u043b
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u043c \u0443\u0447\u0435\u043d\u044b\u043c
    \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f
    \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u0442\u044c \u0433\u0440\u0430\u043d\u0438\u0446\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0435\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439.
    \u0415\u0433\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439, \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0438 \u0447\u0430\u0441\u0442\u043e \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0437\u0430\u0434\u0430\u0447
    \u0441\u043d\u0438\u0441\u043a\u0430\u043b \u0435\u043c\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u043a\u0430\u043a \u043e\u0434\u043d\u043e\u043c\u0443 \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043c\u043e\u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438."
  shortBioEn: "Michael Leonidovich Gromov (often known as the Misha Gromov) is one of the most influential and original mathematicians of our time, whose works have radically changed geometry and many other fields of mathematics. In 2009 he was awarded the Abel Prize, often called the Nobel Prize for Mathematics, for his \"revolutionary contribution to geometry\".\n\n* Early years, the family and education of Michael Leonidovich Gromov were born on 23 December 1943 in Boxytogorsk, Leningrad province, where he was born during a difficult war: his mother, a military doctor, Lia Alexandrovna Rabinovich, served on the Volkhov front and was forced to leave the front line to give birth to his son.Interestingly, Michael Gromov's mother was the cousin of the famous chess player Michael Botwinnik, and as a child, at the age of 9, his mother gave him the book of Hans Rademacher and Otto Teplica, \"Mathics\" which gave him a deep interest in mathematics, his first systematic knowledge in Leningrad, where he attended the famous 217th school (formerly Petrichula).He then joined Leningrad State University, which graduated in 1965, where he continued his scientific career under the leadership of the distinguished Topologist Vladimir Abramovich Rohlin, and in 1969 Gromov defended his Ph.D. in physics and mathematics, and in 1973 his Ph.D. in physics and mathematics.\n\n==History==The scientific career began in the USSR and emigration: since 1967, Gromov has worked at Leningrad University as an assistant and associate professor, as well as in other research institutions, but his opposition to the Soviet system and his desire for freedom of creativity led to the decision to emigrate.This was a turning point in his access to the world's scientific community, and in 1981 he moved to France. He taught at the University of Paris VI (now the University of Pierre and Maria Curie) in 1981-1982.In 1982, he became a permanent professor of the prestigious Institute of Higher Studies (IHEES) at Bur-sur-Ivette, where he took a life position, and in 1992 Gromov adopted French citizenship.\n\nThe main scientific achievements of Michael Gromov are known as the mathematician who looked at old problems from a fundamentally new, geometric point of view. His ideas became the basis for whole new directions. \\(h)-principle: One of the earliest and most fundamental achievements of the Gromov is the development and systematization of theory that can determine when a topological problem can be solved as differential geometrically.This was the basis of his famous book, \"Differnal Relationships with Private Derivatives.\" Symplic geometry: Throms are rightly considered to be one of the founders of modern sympellic topology. He introduced the notion of \\(J\\)-holomorphic curves, which revolutionized this area and led to the creation of Gromov-Vitten invariants, important for quantum field theory.His famous \"Nonsqueezing theorem\" showed a fundamental difference between sympttic and massive changes. Rhimana Geometry: Thromov proposed a new look at geometry in general, exploring not only smooth, but also more common metric spaces.Among its results is the theory of almost flat diversity, inequality of Betty and the convergence of Gromov-Hausdorf, which has become a powerful tool for learning classes of rhymanic diversity. The Geometric theory of groups: His work of Gromov Hyperbolic groups has laid the foundations of an entire field of mathematics. He has moved geometrical ideas (negative curves) to discrete groups, which has given a powerful new language for learning them.He has also proved the famous theorem of polynomial growth groups, and in recent years his scientific interests have also been directed to biology and neurosciences, and he has studied the use of geometric and mathematical methods to model biological structures, the evolution of genomes and the understanding of brain activity.\n\n♪ Recognition and awards for his career Michael Gromov received almost all the most prestigious awards in the world of mathematics ♪ The main prizes are the Abel Prize (2009), \"for his revolutionary contribution to geometry\" ♪ Wolf Prize (1993) ♪ The Balzan Medal (1999) ♪ The Kyoto Prize (2002) ♪ The Weblen Prize for Geometry (1981) ♪ The Nummers Prize for Mathematics (2004) Original Air Date on December 24, 2015Member of the Academy of Sciences (2011): Member of the Academy of Sciences of France (since 1997, foreign member since 1989); Foreign member of the National Academy of Sciences (1989); Foreign member of the Royal Society of London (2011); Honorary member of many other academies of the world; Michael Gromov remains active scientists today, continuing to expand the boundaries of mathematics and its applications.His unique, profound and often unconventional approach to the task has been recognized as one of the greatest minds of our time."
  interestingFactsRu: "\u041c\u0438\u0445\u0430\u0438\u043b \u0413\u0440\u043e\u043c\u043e\u0432 \u2014 \u0444\u0438\u0433\u0443\u0440\u0430
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430,
    \u043d\u043e \u0438 \u043e\u0447\u0435\u043d\u044c \u043a\u043e\u043b\u043e\u0440\u0438\u0442\u043d\u0430\u044f.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0438
    \u0436\u0438\u0437\u043d\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0438\u0441\u0443\u044e\u0442
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f, \u0436\u0438\u0432\u0443\u0449\u0435\u0433\u043e \u0432
    \u043c\u0438\u0440\u0435 \u0438\u0434\u0435\u0439.\n\n\U0001F476 \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0435 \u0441\u0432\u044f\u0437\u0438
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0432 \u0432\u043e\u0435\u043d\u043d\u043e\u043c
    \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0435: \u0413\u0440\u043e\u043c\u043e\u0432
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 23 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1943 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u043e\u043a\u0441\u0438\u0442\u043e\u0433\u043e\u0440\u0441\u043a\u0435
    \u0432 \u0441\u0430\u043c\u044b\u0439 \u0440\u0430\u0437\u0433\u0430\u0440 \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0432\u043e\u0439\u043d\u044b.
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c \u0431\u044b\u043b\u0430 \u0432\u043e\u0435\u043d\u043d\u044b\u043c
    \u0432\u0440\u0430\u0447\u043e\u043c \u0438 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u0443\u044e
    \u043d\u0430 \u0412\u043e\u043b\u0445\u043e\u0432\u0441\u043a\u043e\u043c \u0444\u0440\u043e\u043d\u0442\u0435,
    \u0447\u0442\u043e\u0431\u044b \u0440\u043e\u0434\u0438\u0442\u044c \u0441\u044b\u043d\u0430.
    \u041e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0431\u044b\u043b\u0430 \u0441\u0443\u0440\u043e\u0432\u043e\u0439
    \u2014 \u043e\u043d\u0430 \u0441\u043b\u0443\u0436\u0438\u043b\u0430 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a\u043e\u043c
    \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u043e\u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0432 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0435.
    \u0417\u043d\u0430\u043a\u043e\u043c\u0430\u044f \u0444\u0430\u043c\u0438\u043b\u0438\u044f:
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c, \u041b\u0438\u044f \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u043d\u0430
