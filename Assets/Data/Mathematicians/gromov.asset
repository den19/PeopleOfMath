    \u0432\u0435\u0441\u044c\u043c\u0430 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u044b.
    \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0447\u0442\u043e \u0432 1967 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041c\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0435
    \u0413\u0440\u043e\u043c\u043e\u0432\u043e\u0439 (\u0434\u0435\u0432\u0438\u0447\u044c\u044f
    \u0444\u0430\u043c\u0438\u043b\u0438\u044f \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u0430).
    \u0411\u044b\u043b \u043b\u0438 \u044d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c,
    \u0435\u0441\u0442\u044c \u043b\u0438 \u0443 \u043d\u0435\u0433\u043e \u0434\u0435\u0442\u0438
    \u2014 \u0432 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
