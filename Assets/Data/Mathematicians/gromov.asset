    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0432 1965 \u0433\u043e\u0434\u0443. \u0422\u0430\u043c
    \u0436\u0435 \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0430
    \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u0410\u0431\u0440\u0430\u043c\u043e\u0432\u0438\u0447\u0430
    \u0420\u043e\u0445\u043b\u0438\u043d\u0430. \u0412 1969 \u0433\u043e\u0434\u0443 \u0413\u0440\u043e\u043c\u043e\u0432
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e, \u0430 \u0432 1973 \u0433\u043e\u0434\u0443
    \u2014 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043d\u0430\u0443\u043a\u0430\u043c.\n\n\U0001F680 \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041d\u0430\u0447\u0430\u043b\u043e \u0432 \u0421\u0421\u0421\u0420
    \u0438 \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f: \u0421 1967 \u0433\u043e\u0434\u0430
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c
    \u0438 \u0434\u043e\u0446\u0435\u043d\u0442\u043e\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u043e-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f\u0445. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u043d\u0435\u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435 \u0441 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u0438 \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435
    \u043a \u0441\u0432\u043e\u0431\u043e\u0434\u0435 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e
    \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u0412 1974 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0421\u0421\u0421\u0420 \u043f\u043e \u0438\u0437\u0440\u0430\u0438\u043b\u044c\u0441\u043a\u043e\u0439
    \u0432\u0438\u0437\u0435 \u0438 \u0447\u0435\u0440\u0435\u0437 \u0418\u0442\u0430\u043b\u0438\u044e
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410. \u042d\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c
    \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c, \u043e\u0442\u043a\u0440\u044b\u0432\u0448\u0438\u043c
    \u0435\u043c\u0443 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043c\u0438\u0440\u043e\u0432\u043e\u043c\u0443
    \u043d\u0430\u0443\u0447\u043d\u043e\u043c\u0443 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0443.
    \u0417\u0430\u0440\u0443\u0431\u0435\u0436\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434:
    \u0421\u0428\u0410 (1974\u20131981): \u0421\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435
    \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0448\u0442\u0430\u0442\u0430
    \u041d\u044c\u044e-\u0419\u043e\u0440\u043a \u0432 \u0421\u0442\u043e\u0443\u043d\u0438-\u0411\u0440\u0443\u043a,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0431\u044b\u043b\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e.
    \u0424\u0440\u0430\u043d\u0446\u0438\u044f (\u0441 1981 \u0433\u043e\u0434\u0430): \u0412
    1981 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e. \u0412 1981\u20131982 \u0433\u043e\u0434\u0430\u0445
    \u043e\u043d \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u041f\u0430\u0440\u0438\u0436\u0430 VI (\u043d\u044b\u043d\u0435 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041f\u044c\u0435\u0440\u0430 \u0438 \u041c\u0430\u0440\u0438\u0438 \u041a\u044e\u0440\u0438).
    \u0412 1982 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0433\u043e
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0432\u044b\u0441\u0448\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IH\u00c9S) \u0432 \u0411\u044e\u0440-\u0441\u044e\u0440-\u0418\u0432\u0435\u0442\u0442,
    \u0433\u0434\u0435 \u0437\u0430\u043d\u044f\u043b \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c. \u0412 1992 \u0433\u043e\u0434\u0443
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u0440\u0438\u043d\u044f\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e. \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438,
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u041c\u044d\u0440\u0438\u043b\u0435\u043d\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (1991\u20131996) \u0438 \u0441 1996 \u0433\u043e\u0434\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0432 \u041a\u0443\u0440\u0430\u043d\u0442\u043e\u0432\u0441\u043a\u043e\u043c
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a \u043f\u0440\u0438 \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.\n\n\U0001F52C
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u041c\u0438\u0445\u0430\u0438\u043b
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430 \u0441\u0442\u0430\u0440\u044b\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u043e\u0439, \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f. \u0415\u0433\u043e
    \u0438\u0434\u0435\u0438 \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0446\u0435\u043b\u044b\u0445 \u043d\u043e\u0432\u044b\u0445 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.
    \\(h\\)-\u043f\u0440\u0438\u043d\u0446\u0438\u043f: \u041e\u0434\u043d\u043e \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u043d\u043d\u0438\u0445 \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u0413\u0440\u043e\u043c\u043e\u0432\u0430
    \u2014 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c, \u043a\u043e\u0433\u0434\u0430
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0430
    \u043a\u0430\u043a \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f.
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u043a\u043d\u0438\u0433\u0438
    \u00ab\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438\u00bb. \u0421\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u0413\u0440\u043e\u043c\u043e\u0432
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438. \u041e\u043d \u0432\u0432\u0435\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \\(J\\)-\u0433\u043e\u043b\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0445
    \u043a\u0440\u0438\u0432\u044b\u0445, \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0413\u0440\u043e\u043c\u043e\u0432\u0430\u2013\u0412\u0438\u0442\u0442\u0435\u043d\u0430,
    \u0432\u0430\u0436\u043d\u044b\u0445 \u0434\u043b\u044f \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u044f. \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u00ab\u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043d\u0435\u0432\u044b\u0436\u0438\u043c\u0430\u043d\u0438\u0438\u00bb
    (Nonsqueezing theorem) \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0435 \u043c\u0435\u0436\u0434\u0443 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438 \u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0438\u043c\u0438 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438.
    \u0420\u0438\u043c\u0430\u043d\u043e\u0432\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f:
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043d\u043e\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0432 \u0446\u0435\u043b\u043e\u043c, \u0438\u0437\u0443\u0447\u0430\u044f \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0430\u0434\u043a\u0438\u0435, \u043d\u043e
    \u0438 \u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0449\u0438\u0435 \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430. \u0421\u0440\u0435\u0434\u0438
    \u0435\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u2014
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u043f\u043e\u0447\u0442\u0438 \u043f\u043b\u043e\u0441\u043a\u0438\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f\u0445, \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430
    \u0411\u0435\u0442\u0442\u0438 \u0438 \u0441\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c
    \u0413\u0440\u043e\u043c\u043e\u0432\u0430\u2013\u0425\u0430\u0443\u0441\u0434\u043e\u0440\u0444\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043c\u043e\u0449\u043d\u044b\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u043a\u043b\u0430\u0441\u0441\u043e\u0432
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439.
    \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
    \u0433\u0440\u0443\u043f\u043f: \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u0413\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u0440\u0443\u043f\u043f\u044b\u00bb (Gromov hyperbolic groups) \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u043e\u0441\u043d\u043e\u0432\u044b \u0446\u0435\u043b\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041e\u043d \u043f\u0435\u0440\u0435\u043d\u0435\u0441
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0434\u0435\u0438
    (\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0443)
    \u043d\u0430 \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0433\u0440\u0443\u043f\u043f\u044b,
    \u0447\u0442\u043e \u0434\u0430\u043b\u043e \u043d\u043e\u0432\u044b\u0439 \u043c\u043e\u0449\u043d\u044b\u0439
    \u044f\u0437\u044b\u043a \u0434\u043b\u044f \u0438\u0445 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \u0433\u0440\u0443\u043f\u043f\u0430\u0445
    \u043f\u043e\u043b\u0438\u043d\u043e\u043c\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0440\u043e\u0441\u0442\u0430. \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0442\u0430\u043a\u0436\u0435 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u044b \u043a \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u043d\u0435\u0439\u0440\u043e\u043d\u0430\u0443\u043a\u0430\u043c. \u041e\u043d
    \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432
    \u0434\u043b\u044f \u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440,
    \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u0438 \u0433\u0435\u043d\u043e\u043c\u043e\u0432
    \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u043c\u043e\u0437\u0433\u0430.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0417\u0430 \u0441\u0432\u043e\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u041c\u0438\u0445\u0430\u0438\u043b \u0413\u0440\u043e\u043c\u043e\u0432
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0441\u0435 \u0441\u0430\u043c\u044b\u0435 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0435
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 \u043c\u0438\u0440\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043f\u0440\u0435\u043c\u0438\u0438: \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (2009) \u2014 \u00ab\u0437\u0430 \u0435\u0433\u043e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e\u00bb.
    \u041f\u0440\u0435\u043c\u0438\u044f \u0412\u043e\u043b\u044c\u0444\u0430 (1993). \u041c\u0435\u0434\u0430\u043b\u044c
    \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u043e\u0433\u043e (1997). \u041f\u0440\u0435\u043c\u0438\u044f
    \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430 (1999). \u041f\u0440\u0435\u043c\u0438\u044f
    \u041a\u0438\u043e\u0442\u043e (2002). \u041f\u0440\u0435\u043c\u0438\u044f \u0412\u0435\u0431\u043b\u0435\u043d\u0430
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 (1981). \u041f\u0440\u0435\u043c\u0438\u044f
    \u041d\u0435\u043c\u043c\u0435\u0440\u0441\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    (2004). \u0427\u043b\u0435\u043d\u0441\u0442\u0432\u043e \u0432 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f\u0445
    \u0438 \u0437\u0432\u0430\u043d\u0438\u044f: \u0418\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a (\u0420\u0410\u041d) (2011). \u0427\u043b\u0435\u043d \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0424\u0440\u0430\u043d\u0446\u0438\u0438 (\u0441 1997, \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u0441 1989). \u0418\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0421\u0428\u0410
    (1989). \u0418\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439 \u0447\u043b\u0435\u043d
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (2011). \u041f\u043e\u0447\u0451\u0442\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439 \u043c\u0438\u0440\u0430. \u041c\u0438\u0445\u0430\u0438\u043b
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u043c \u0443\u0447\u0435\u043d\u044b\u043c
    \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f
    \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u0442\u044c \u0433\u0440\u0430\u043d\u0438\u0446\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0435\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439.
    \u0415\u0433\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439, \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0438 \u0447\u0430\u0441\u0442\u043e \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0437\u0430\u0434\u0430\u0447
    \u0441\u043d\u0438\u0441\u043a\u0430\u043b \u0435\u043c\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u043a\u0430\u043a \u043e\u0434\u043d\u043e\u043c\u0443 \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u043c\u043e\u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438."
  shortBioEn: 
  interestingFactsRu: "\u041c\u0438\u0445\u0430\u0438\u043b \u0413\u0440\u043e\u043c\u043e\u0432 \u2014 \u0444\u0438\u0433\u0443\u0440\u0430
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430,
    \u043d\u043e \u0438 \u043e\u0447\u0435\u043d\u044c \u043a\u043e\u043b\u043e\u0440\u0438\u0442\u043d\u0430\u044f.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0438
    \u0436\u0438\u0437\u043d\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0438\u0441\u0443\u044e\u0442
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f, \u0436\u0438\u0432\u0443\u0449\u0435\u0433\u043e \u0432
    \u043c\u0438\u0440\u0435 \u0438\u0434\u0435\u0439.\n\n\U0001F476 \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0435 \u0441\u0432\u044f\u0437\u0438
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0432 \u0432\u043e\u0435\u043d\u043d\u043e\u043c
    \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0435: \u0413\u0440\u043e\u043c\u043e\u0432
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 23 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1943 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0411\u043e\u043a\u0441\u0438\u0442\u043e\u0433\u043e\u0440\u0441\u043a\u0435
    \u0432 \u0441\u0430\u043c\u044b\u0439 \u0440\u0430\u0437\u0433\u0430\u0440 \u0412\u0435\u043b\u0438\u043a\u043e\u0439
    \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0432\u043e\u0439\u043d\u044b.
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c \u0431\u044b\u043b\u0430 \u0432\u043e\u0435\u043d\u043d\u044b\u043c
    \u0432\u0440\u0430\u0447\u043e\u043c \u0438 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u0443\u044e
    \u043d\u0430 \u0412\u043e\u043b\u0445\u043e\u0432\u0441\u043a\u043e\u043c \u0444\u0440\u043e\u043d\u0442\u0435,
    \u0447\u0442\u043e\u0431\u044b \u0440\u043e\u0434\u0438\u0442\u044c \u0441\u044b\u043d\u0430.
    \u041e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0431\u044b\u043b\u0430 \u0441\u0443\u0440\u043e\u0432\u043e\u0439
    \u2014 \u043e\u043d\u0430 \u0441\u043b\u0443\u0436\u0438\u043b\u0430 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a\u043e\u043c
    \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u043e\u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0432 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0435.
    \u0417\u043d\u0430\u043a\u043e\u043c\u0430\u044f \u0444\u0430\u043c\u0438\u043b\u0438\u044f:
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c, \u041b\u0438\u044f \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u0432\u043d\u0430
    \u0420\u0430\u0431\u0438\u043d\u043e\u0432\u0438\u0447, \u0431\u044b\u043b\u0430 \u0434\u0432\u043e\u044e\u0440\u043e\u0434\u043d\u043e\u0439
    \u0441\u0435\u0441\u0442\u0440\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0433\u043e
    \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u0430 \u043c\u0438\u0440\u0430 \u043f\u043e \u0448\u0430\u0445\u043c\u0430\u0442\u0430\u043c
    \u041c\u0438\u0445\u0430\u0438\u043b\u0430 \u0411\u043e\u0442\u0432\u0438\u043d\u043d\u0438\u043a\u0430.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u0438 \u0441\u0430\u043c
    \u0413\u0440\u043e\u043c\u043e\u0432, \u0438 \u0411\u043e\u0442\u0432\u0438\u043d\u043d\u0438\u043a
    \u043d\u043e\u0441\u044f\u0442 \u0438\u043c\u044f \u041c\u0438\u0445\u0430\u0438\u043b.
    \u041a\u043d\u0438\u0433\u0430, \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0430\u044f
    \u0432\u0441\u0451: \u041a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u043c\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0431\u044b\u043b\u043e 9
    \u043b\u0435\u0442, \u043c\u0430\u0442\u044c \u043f\u043e\u0434\u0430\u0440\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043a\u043d\u0438\u0433\u0443 \u0413\u0430\u043d\u0441\u0430 \u0420\u0430\u0434\u0435\u043c\u0430\u0445\u0435\u0440\u0430
    \u0438 \u041e\u0442\u0442\u043e \u0422\u0435\u043f\u043b\u0438\u0446\u0430 \u00ab\u042d\u0442\u044e\u0434\u044b
    \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb. \u0418\u043c\u0435\u043d\u043d\u043e
    \u043e\u043d\u0430 \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b\u0430 \u0432 \u043d\u0435\u043c
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0432\u043e
    \u043c\u043d\u043e\u0433\u043e\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0430
    \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u043f\u0443\u0442\u044c.\n\n\U0001F9E0
    \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430
    \u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a \"\u041c\u0438\u0448\u0430\" \u0434\u043b\u044f
    \u0432\u0441\u0435\u0433\u043e \u043c\u0438\u0440\u0430: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u043c\u044f
    \u00ab\u041c\u0438\u0445\u0430\u0438\u043b\u00bb, \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u0438 \u0434\u0430\u0436\u0435 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u041c\u0438\u0448\u0430 (Misha).
    \u041e\u043d \u0441\u0430\u043c \u0442\u0430\u043a \u0441\u0435\u0431\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0435\u0433\u043e
    \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u0435 \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u0438.
    \u041e\u0441\u043e\u0431\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u043d\u043e\u0441\u0438\u0442\u044c
    \u0447\u0430\u0441\u044b: \u0412 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e
    \u043e\u043d \u0437\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u043d\u043e\u0441\u0438\u0442
    \u0447\u0430\u0441\u044b \u0446\u0438\u0444\u0435\u0440\u0431\u043b\u0430\u0442\u043e\u043c
    \u0432\u043d\u0438\u0437, \u043d\u0430 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439
    \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u0437\u0430\u043f\u044f\u0441\u0442\u044c\u044f,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0435\u043c\u0443 \u0442\u0430\u043a
    \u0443\u0434\u043e\u0431\u043d\u0435\u0435 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u043d\u0430 \u0432\u0440\u0435\u043c\u044f. \u042d\u0442\u0430 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0430\u044f,
    \u043d\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u0430\u044f \u0434\u0435\u0442\u0430\u043b\u044c
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043e
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u044b\u0439 \u0438 \u043d\u0435\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439
    \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043c\u0435\u043b\u043e\u0447\u0430\u043c.
    \u0418\u0434\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0440\u0435\u0434\u0430 \u0434\u043b\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b: \u0413\u0440\u043e\u043c\u043e\u0432 \u043b\u044e\u0431\u0438\u0442
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432 \u043f\u043e\u043b\u043d\u043e\u0439
    \u0442\u0438\u0448\u0438\u043d\u0435 \u0438 \u0443\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0438.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438,
    \u043d\u0443\u0436\u0435\u043d \u043b\u0438 \u0435\u043c\u0443 \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u0440\u0430\u0439\u0441\u043a\u0438\u0439 \u0443\u0433\u043e\u043b\u043e\u043a \u0432\u043e
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c \u043f\u0440\u0438\u0433\u043e\u0440\u043e\u0434\u0435,
    \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0434\u043b\u044f \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u2014 \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0438\u043a\u0430\u043a\u043e\u0439
    \u0441\u0440\u0435\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u043b\u0430
    \u0431\u044b \u043e\u0442 \u0432\u043d\u0435\u0448\u043d\u0435\u0433\u043e \u043c\u0438\u0440\u0430.
    \u00ab\u041d\u0435 \u0441\u0442\u0438\u0440\u0430\u0442\u044c!\u00bb: \u0412 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0447\u0435\u043c \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0435
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0432\u044b\u0441\u0448\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IH\u00c9S) \u043d\u0430 \u0434\u043e\u0441\u043a\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0434\u043f\u0438\u0441\u044c: \u00ab\u041d\u0435
    \u0441\u0442\u0438\u0440\u0430\u0442\u044c!\u00bb \u2014 \u043d\u0430 \u0442\u043e\u0442
    \u0441\u043b\u0443\u0447\u0430\u0439, \u0435\u0441\u043b\u0438 \u0443\u0431\u043e\u0440\u0449\u0438\u0446\u0430
    \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442
    \u0435\u0433\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.\n\n\U0001F4D0
    \u041e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c \u0432 \u043e\u0446\u0435\u043d\u043a\u0435
    \u0441\u0432\u043e\u0438\u0445 \u0437\u0430\u0441\u043b\u0443\u0433: \u041a\u043e\u0433\u0434\u0430
    \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u044b \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438
    \u0435\u0433\u043e, \u0437\u0430 \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e,
    \u043e\u043d \u0441 \u0443\u043b\u044b\u0431\u043a\u043e\u0439 \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \"\u041e\u0442\u043a\u0443\u0434\u0430 \u044f \u0437\u043d\u0430\u044e?! \u041a\u043e\u043c\u0438\u0442\u0435\u0442
    \u0440\u0435\u0448\u0430\u043b. \u042f \u0441\u0430\u043c \u0443\u0434\u0438\u0432\u0438\u043b\u0441\u044f\".
    \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441, \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f
    \u043b\u0438 \u043e\u043d \u043a \u043f\u0440\u0435\u043c\u0438\u044f\u043c, \u043e\u043d
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \"\u041f\u0440\u0438\u044f\u0442\u043d\u043e,
    \u043a\u043e\u0433\u0434\u0430 \u043f\u043e \u0433\u043e\u043b\u043e\u0432\u043a\u0435 \u043f\u043e\u0433\u043b\u0430\u0434\u044f\u0442.
    \u041d\u043e \u044f \u043d\u0435 \u043c\u043e\u0433\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u044f \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f\". \u00ab\u041d\u0438\u043a\u0442\u043e
    \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442\u00bb:
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0441 \u043f\u0440\u0438\u0441\u0443\u0449\u0438\u043c
    \u0435\u043c\u0443 \u044e\u043c\u043e\u0440\u043e\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b,
    \u043a\u0430\u043a \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u0435\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432: \"\u0427\u0438\u0441\u0442\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0442\u044c
    \u043e\u0447\u0435\u043d\u044c \u0442\u0440\u0443\u0434\u043d\u043e \u0434\u0430\u0436\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0435\u043a\u0446\u0438\u0438 \u043d\u0438\u043a\u0442\u043e \u043d\u0438\u0447\u0435\u0433\u043e
    \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442. \u0418 \u044d\u0442\u043e
    \u2013 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041d\u043e \u044d\u0442\u043e
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e. \u041f\u043e\u0442\u043e\u043c \u043f\u0440\u043e\u0440\u0435\u0437\u0430\u0435\u0442\u0441\u044f.
    \u0427\u0435\u0440\u0435\u0437 \u0433\u043e\u0434. \u042d\u0442\u043e \u043e\u0447\u0435\u043d\u044c
    \u0442\u0440\u0443\u0434\u043d\u044b\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\".
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043a\u0430\u043a \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430:
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c,
    \u0430 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440.
    \u0410 \u0438\u0442\u043e\u0433\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043d\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430,
    \u0430 \"\u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u043d\u043e\u0435
    \u0441\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043d\u0443\u0436\u043d\u043e \u043b\u0438\u0431\u043e \u043e\u0442\u043a\u043e\u043f\u0430\u0442\u044c,
    \u043b\u0438\u0431\u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c\". \u041e\u043d
    \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u0435\u0442 \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435,
    \u043a\u043e\u0433\u0434\u0430 \u0437\u0430 \u0445\u0430\u043e\u0441\u043e\u043c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442
    \"\u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e\". \"\u042f \u0436\u0438\u0432\u0443
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\": \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u043b\u044e\u0431\u0438\u0442 \u043b\u0438 \u043e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \"\u0410
    \u043a\u0430\u043a \u0436\u0435! \u0412\u043b\u044e\u0431\u043b\u0435\u043d. \u041d\u0435
    \u0442\u043e \u0447\u0442\u043e \u043b\u044e\u0431\u043b\u044e \u2013 \u0436\u0438\u0432\u0443
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\". \u042d\u0442\u043e
    \u044f\u0440\u043a\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442
    \u0435\u0433\u043e \u043f\u043e\u043b\u043d\u0443\u044e \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443. \u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0441 \u0433\u0435\u043d\u0438\u044f\u043c\u0438: \u0412 \u043d\u0430\u0443\u0447\u043d\u043e\u043c
    \u043c\u0438\u0440\u0435 \u0438 \u043f\u0440\u0435\u0441\u0441\u0435 \u0435\u0433\u043e
    \u0447\u0430\u0441\u0442\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044e\u0442
    \u0441 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c, \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c
    \u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0434\u0430 \u0412\u0438\u043d\u0447\u0438,
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u044f \u0433\u043b\u0443\u0431\u0438\u043d\u0443
    \u0438 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0435\u0433\u043e \u0438\u0434\u0435\u0439.\n\n\U0001F30D \u0416\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438
    \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f \u042d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f
    \u0440\u0430\u0434\u0438 \u043d\u0430\u0443\u043a\u0438: \u0413\u0440\u043e\u043c\u043e\u0432
    \u0437\u0430\u0434\u0443\u043c\u044b\u0432\u0430\u043b\u0441\u044f \u043e\u0431 \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438
    \u0438\u0437 \u0421\u0421\u0421\u0420 \u0441 14 \u043b\u0435\u0442 \u0438\u0437-\u0437\u0430
    \u043d\u0435\u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439.
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1970-\u0445 \u043e\u043d \u0434\u0430\u0436\u0435
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c\u0441\u044f,
    \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u0437\u0430\u044f\u0432\u043a\u0430 \u043d\u0430
    \u0432\u044b\u0435\u0437\u0434 \u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u044c \u0431\u044b\u043b\u0430
    \u0443\u0441\u043f\u0435\u0448\u043d\u0435\u0435. \u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0438\u0437-\u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u044b: \u0415\u043c\u0443
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b\u043e \u0437\u0430\u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c
    \u043c\u0435\u0441\u0442\u0430 \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0421\u0442\u043e\u0443\u043d\u0438-\u0411\u0440\u0443\u043a \u0432 \u0421\u0428\u0410,
    \u0435\u0441\u043b\u0438 \u043e\u043d \u0441\u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0435\u0445\u0430\u0442\u044c.
    \u0412 1974 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0421\u0421\u0421\u0420 \u043f\u043e \u0438\u0437\u0440\u0430\u0438\u043b\u044c\u0441\u043a\u043e\u0439
    \u0432\u0438\u0437\u0435 \u0438 \u0447\u0435\u0440\u0435\u0437 \u0418\u0442\u0430\u043b\u0438\u044e
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410. \u041f\u043e\u0437\u0436\u0435
    \u043e\u043d \u043f\u0435\u0440\u0435\u0431\u0440\u0430\u043b\u0441\u044f \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e,
    \u0433\u0434\u0435 \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043f\u043e
    \u0441\u0435\u0439 \u0434\u0435\u043d\u044c. \u0414\u0432\u043e\u0439\u043d\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e: \u0412 1992 \u0433\u043e\u0434\u0443
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u0440\u0438\u043d\u044f\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e, \u043d\u043e \u043f\u043e\u0437\u0436\u0435
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u0438 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0435.
    \u0412 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0435\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0420\u043e\u0441\u0441\u0438\u0438 \u0438
    \u0434\u0430\u0436\u0435 \u0421\u0428\u0410.\n\n\U0001F3C6 \u0420\u0435\u043a\u043e\u0440\u0434\u044b
    \u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0411\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b: \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c \u0431\u043e\u043b\u0435\u0435 \u0434\u0435\u0441\u044f\u0442\u043a\u0430
    \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445
    \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u043f\u0440\u0435\u043c\u0438\u0439,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e 2009 \u0433\u043e\u0434\u0430 (\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u043e\u0433 \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439),
    \u043f\u0440\u0435\u043c\u0438\u044e \u0412\u043e\u043b\u044c\u0444\u0430, \u041a\u0438\u043e\u0442\u043e,
    \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430 \u0438 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0434\u0440\u0443\u0433\u0438\u0435. \u041d\u0430\u0443\u0447\u043d\u044b\u0439 \"\u041e\u0441\u043a\u0430\u0440\":
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    \u0438\u043d\u043e\u0433\u0434\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \"\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u041e\u0441\u043a\u0430\u0440\u043e\u043c\" \u0438\u0437-\u0437\u0430 \u0435\u0451 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0440\u0430\u0437\u043c\u0435\u0440\u0430 (\u0432 2009 \u0433\u043e\u0434\u0443
    \u043e\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043f\u043e\u0447\u0442\u0438
    1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432).\n\n\U0001F9EC
    \u0417\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \"\u0432\u044b\u0445\u043e\u0434\u043a\u0438\" \u041a\u0430\u043a \u043e\u0442\u043b\u0438\u0447\u0438\u0442\u044c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043e\u0442 \u0441\u043e\u0431\u0430\u043a\u0438:
    \u0412 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0441 \u0443\u043b\u044b\u0431\u043a\u043e\u0439 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437 \u0430\u0441\u043f\u0435\u043a\u0442\u043e\u0432
    \u0435\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043c\u043e\u0447\u044c
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0430\u0448\u0438\u043d\u0435
    \u043e\u0442\u043b\u0438\u0447\u0438\u0442\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u043e\u0442 \u0441\u043e\u0431\u0430\u043a\u0438, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u043f\u043e\u0437\u044b. \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u0432 \u0447\u0435\u043c \u0436\u0435 \u0440\u0430\u0437\u043d\u0438\u0446\u0430, \u043e\u043d
    \u0441 \u0438\u0440\u043e\u043d\u0438\u0435\u0439 \u0437\u0430\u043c\u0435\u0442\u0438\u043b:
    \"\u0412\u043e\u0442 \u044f \u0441\u0438\u0436\u0443 \u0432 \u0442\u0430\u043a\u043e\u0439
    \u043f\u043e\u0437\u0435 \u2013 \u0447\u0435\u043c \u044f \u043d\u0435 \u0441\u043e\u0431\u0430\u043a\u0430?\".
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \"\u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u0435\u0440\u0431\u043b\u044e\u0434\u0430\": \u041e\u0434\u0438\u043d \u0438\u0437
    \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432
    \u0432 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u2014 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043d\u0435\u0432\u044b\u0436\u0438\u043c\u0430\u043d\u0438\u0438 \u2014 \u0438\u043c\u0435\u0435\u0442
    \u0437\u0430\u0431\u0430\u0432\u043d\u043e\u0435 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \u00ab\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u0435\u0440\u0431\u043b\u044e\u0434\u0430\u00bb. \u0421\u0443\u0442\u044c \u0432
    \u0442\u043e\u043c, \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043e\u0431\u044a\u0435\u043a\u0442
    (\u0432\u0435\u0440\u0431\u043b\u044e\u0434) \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u043f\u0440\u043e\u0442\u0438\u0441\u043d\u0443\u0442\u044c\u0441\u044f \u0447\u0435\u0440\u0435\u0437
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e
    \u0438\u0433\u043e\u043b\u044c\u043d\u0443\u044e \u0438\u0433\u043b\u0443. \u0417\u0430
    \u044d\u0442\u043e\u0439 \u0448\u0443\u0442\u043b\u0438\u0432\u043e\u0439 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0435\u0439
    \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0433\u043b\u0443\u0431\u043e\u0447\u0430\u0439\u0448\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442.
    \u0412\u0441\u0435 \u044d\u0442\u0438 \u0444\u0430\u043a\u0442\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442,
    \u0447\u0442\u043e \u041c\u0438\u0445\u0430\u0438\u043b \u0413\u0440\u043e\u043c\u043e\u0432
    \u2014 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a
    \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430, \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u0439 \u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u044b\u0439
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0434\u0435\u043b\u0443."
