    \u0431\u044b\u043b\u0430 \u043d\u0430\u0434\u043f\u0438\u0441\u044c: \u00ab\u041d\u0435
    \u0441\u0442\u0438\u0440\u0430\u0442\u044c!\u00bb \u2014 \u043d\u0430 \u0442\u043e\u0442
    \u0441\u043b\u0443\u0447\u0430\u0439, \u0435\u0441\u043b\u0438 \u0443\u0431\u043e\u0440\u0449\u0438\u0446\u0430
    \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442
    \u0435\u0433\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.\n\n\U0001F4D0
    \u041e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c \u0432 \u043e\u0446\u0435\u043d\u043a\u0435
    \u0441\u0432\u043e\u0438\u0445 \u0437\u0430\u0441\u043b\u0443\u0433: \u041a\u043e\u0433\u0434\u0430
    \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u044b \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438
    \u0435\u0433\u043e, \u0437\u0430 \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e,
    \u043e\u043d \u0441 \u0443\u043b\u044b\u0431\u043a\u043e\u0439 \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \"\u041e\u0442\u043a\u0443\u0434\u0430 \u044f \u0437\u043d\u0430\u044e?! \u041a\u043e\u043c\u0438\u0442\u0435\u0442
    \u0440\u0435\u0448\u0430\u043b. \u042f \u0441\u0430\u043c \u0443\u0434\u0438\u0432\u0438\u043b\u0441\u044f\".
    \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441, \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f
    \u043b\u0438 \u043e\u043d \u043a \u043f\u0440\u0435\u043c\u0438\u044f\u043c, \u043e\u043d
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \"\u041f\u0440\u0438\u044f\u0442\u043d\u043e,
    \u043a\u043e\u0433\u0434\u0430 \u043f\u043e \u0433\u043e\u043b\u043e\u0432\u043a\u0435 \u043f\u043e\u0433\u043b\u0430\u0434\u044f\u0442.
    \u041d\u043e \u044f \u043d\u0435 \u043c\u043e\u0433\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u044f \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f\". \u00ab\u041d\u0438\u043a\u0442\u043e
    \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442\u00bb:
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0441 \u043f\u0440\u0438\u0441\u0443\u0449\u0438\u043c
    \u0435\u043c\u0443 \u044e\u043c\u043e\u0440\u043e\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b,
    \u043a\u0430\u043a \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u0435\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432: \"\u0427\u0438\u0441\u0442\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0442\u044c
    \u043e\u0447\u0435\u043d\u044c \u0442\u0440\u0443\u0434\u043d\u043e \u0434\u0430\u0436\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0435\u043a\u0446\u0438\u0438 \u043d\u0438\u043a\u0442\u043e \u043d\u0438\u0447\u0435\u0433\u043e
    \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442. \u0418 \u044d\u0442\u043e
    \u2013 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041d\u043e \u044d\u0442\u043e
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e. \u041f\u043e\u0442\u043e\u043c \u043f\u0440\u043e\u0440\u0435\u0437\u0430\u0435\u0442\u0441\u044f.
    \u0427\u0435\u0440\u0435\u0437 \u0433\u043e\u0434. \u042d\u0442\u043e \u043e\u0447\u0435\u043d\u044c
    \u0442\u0440\u0443\u0434\u043d\u044b\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\".
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043a\u0430\u043a \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430:
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c,
    \u0430 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440.
    \u0410 \u0438\u0442\u043e\u0433\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043d\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430,
    \u0430 \"\u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u043d\u043e\u0435
    \u0441\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043d\u0443\u0436\u043d\u043e \u043b\u0438\u0431\u043e \u043e\u0442\u043a\u043e\u043f\u0430\u0442\u044c,
    \u043b\u0438\u0431\u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c\". \u041e\u043d
    \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u0435\u0442 \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u0435,
    \u043a\u043e\u0433\u0434\u0430 \u0437\u0430 \u0445\u0430\u043e\u0441\u043e\u043c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442
    \"\u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e\". \"\u042f \u0436\u0438\u0432\u0443
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\": \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u043b\u044e\u0431\u0438\u0442 \u043b\u0438 \u043e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \"\u0410
    \u043a\u0430\u043a \u0436\u0435! \u0412\u043b\u044e\u0431\u043b\u0435\u043d. \u041d\u0435
    \u0442\u043e \u0447\u0442\u043e \u043b\u044e\u0431\u043b\u044e \u2013 \u0436\u0438\u0432\u0443
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\". \u042d\u0442\u043e
    \u044f\u0440\u043a\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442
    \u0435\u0433\u043e \u043f\u043e\u043b\u043d\u0443\u044e \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443. \u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0441 \u0433\u0435\u043d\u0438\u044f\u043c\u0438: \u0412 \u043d\u0430\u0443\u0447\u043d\u043e\u043c
    \u043c\u0438\u0440\u0435 \u0438 \u043f\u0440\u0435\u0441\u0441\u0435 \u0435\u0433\u043e
    \u0447\u0430\u0441\u0442\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044e\u0442
    \u0441 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c, \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c
    \u0438 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0434\u0430 \u0412\u0438\u043d\u0447\u0438,
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u044f \u0433\u043b\u0443\u0431\u0438\u043d\u0443
    \u0438 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0435\u0433\u043e \u0438\u0434\u0435\u0439.\n\n\U0001F30D \u0416\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0435
    \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438
    \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f \u042d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f
    \u0440\u0430\u0434\u0438 \u043d\u0430\u0443\u043a\u0438: \u0413\u0440\u043e\u043c\u043e\u0432
    \u0437\u0430\u0434\u0443\u043c\u044b\u0432\u0430\u043b\u0441\u044f \u043e\u0431 \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438
    \u0438\u0437 \u0421\u0421\u0421\u0420 \u0441 14 \u043b\u0435\u0442 \u0438\u0437-\u0437\u0430
    \u043d\u0435\u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439.
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1970-\u0445 \u043e\u043d \u0434\u0430\u0436\u0435
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c\u0441\u044f,
    \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u0437\u0430\u044f\u0432\u043a\u0430 \u043d\u0430
    \u0432\u044b\u0435\u0437\u0434 \u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u044c \u0431\u044b\u043b\u0430
    \u0443\u0441\u043f\u0435\u0448\u043d\u0435\u0435. \u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0438\u0437-\u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u044b: \u0415\u043c\u0443
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b\u043e \u0437\u0430\u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c
    \u043c\u0435\u0441\u0442\u0430 \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0421\u0442\u043e\u0443\u043d\u0438-\u0411\u0440\u0443\u043a \u0432 \u0421\u0428\u0410,
    \u0435\u0441\u043b\u0438 \u043e\u043d \u0441\u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0435\u0445\u0430\u0442\u044c.
    \u0412 1974 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0421\u0421\u0421\u0420 \u043f\u043e \u0438\u0437\u0440\u0430\u0438\u043b\u044c\u0441\u043a\u043e\u0439
    \u0432\u0438\u0437\u0435 \u0438 \u0447\u0435\u0440\u0435\u0437 \u0418\u0442\u0430\u043b\u0438\u044e
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0421\u0428\u0410. \u041f\u043e\u0437\u0436\u0435
    \u043e\u043d \u043f\u0435\u0440\u0435\u0431\u0440\u0430\u043b\u0441\u044f \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e,
    \u0433\u0434\u0435 \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043f\u043e
    \u0441\u0435\u0439 \u0434\u0435\u043d\u044c. \u0414\u0432\u043e\u0439\u043d\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e: \u0412 1992 \u0433\u043e\u0434\u0443
    \u0413\u0440\u043e\u043c\u043e\u0432 \u043f\u0440\u0438\u043d\u044f\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e, \u043d\u043e \u043f\u043e\u0437\u0436\u0435
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u0438 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0435.
    \u0412 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0435\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0420\u043e\u0441\u0441\u0438\u0438 \u0438
    \u0434\u0430\u0436\u0435 \u0421\u0428\u0410.\n\n\U0001F3C6 \u0420\u0435\u043a\u043e\u0440\u0434\u044b
    \u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0411\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b: \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c \u0431\u043e\u043b\u0435\u0435 \u0434\u0435\u0441\u044f\u0442\u043a\u0430
    \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445
    \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u043f\u0440\u0435\u043c\u0438\u0439,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e 2009 \u0433\u043e\u0434\u0430 (\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u043e\u0433 \u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439),
    \u043f\u0440\u0435\u043c\u0438\u044e \u0412\u043e\u043b\u044c\u0444\u0430, \u041a\u0438\u043e\u0442\u043e,
    \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430 \u0438 \u043c\u043d\u043e\u0433\u0438\u0435
    \u0434\u0440\u0443\u0433\u0438\u0435. \u041d\u0430\u0443\u0447\u043d\u044b\u0439 \"\u041e\u0441\u043a\u0430\u0440\":
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    \u0438\u043d\u043e\u0433\u0434\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \"\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u041e\u0441\u043a\u0430\u0440\u043e\u043c\" \u0438\u0437-\u0437\u0430 \u0435\u0451 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0440\u0430\u0437\u043c\u0435\u0440\u0430 (\u0432 2009 \u0433\u043e\u0434\u0443
    \u043e\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043f\u043e\u0447\u0442\u0438
    1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432).\n\n\U0001F9EC
    \u0417\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \"\u0432\u044b\u0445\u043e\u0434\u043a\u0438\" \u041a\u0430\u043a \u043e\u0442\u043b\u0438\u0447\u0438\u0442\u044c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043e\u0442 \u0441\u043e\u0431\u0430\u043a\u0438:
    \u0412 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e
    \u0413\u0440\u043e\u043c\u043e\u0432 \u0441 \u0443\u043b\u044b\u0431\u043a\u043e\u0439 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437 \u0430\u0441\u043f\u0435\u043a\u0442\u043e\u0432
    \u0435\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043c\u043e\u0447\u044c
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0430\u0448\u0438\u043d\u0435
    \u043e\u0442\u043b\u0438\u0447\u0438\u0442\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u043e\u0442 \u0441\u043e\u0431\u0430\u043a\u0438, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u043f\u043e\u0437\u044b. \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u0432 \u0447\u0435\u043c \u0436\u0435 \u0440\u0430\u0437\u043d\u0438\u0446\u0430, \u043e\u043d
    \u0441 \u0438\u0440\u043e\u043d\u0438\u0435\u0439 \u0437\u0430\u043c\u0435\u0442\u0438\u043b:
    \"\u0412\u043e\u0442 \u044f \u0441\u0438\u0436\u0443 \u0432 \u0442\u0430\u043a\u043e\u0439
    \u043f\u043e\u0437\u0435 \u2013 \u0447\u0435\u043c \u044f \u043d\u0435 \u0441\u043e\u0431\u0430\u043a\u0430?\".
    \u041f\u0440\u0438\u043d\u0446\u0438\u043f \"\u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u0435\u0440\u0431\u043b\u044e\u0434\u0430\": \u041e\u0434\u0438\u043d \u0438\u0437
    \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432
    \u0432 \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u2014 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u043d\u0435\u0432\u044b\u0436\u0438\u043c\u0430\u043d\u0438\u0438 \u2014 \u0438\u043c\u0435\u0435\u0442
    \u0437\u0430\u0431\u0430\u0432\u043d\u043e\u0435 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \u00ab\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0441\u0438\u043c\u043f\u043b\u0435\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0432\u0435\u0440\u0431\u043b\u044e\u0434\u0430\u00bb. \u0421\u0443\u0442\u044c \u0432
    \u0442\u043e\u043c, \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043e\u0431\u044a\u0435\u043a\u0442
    (\u0432\u0435\u0440\u0431\u043b\u044e\u0434) \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u043f\u0440\u043e\u0442\u0438\u0441\u043d\u0443\u0442\u044c\u0441\u044f \u0447\u0435\u0440\u0435\u0437
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e
    \u0438\u0433\u043e\u043b\u044c\u043d\u0443\u044e \u0438\u0433\u043b\u0443. \u0417\u0430
    \u044d\u0442\u043e\u0439 \u0448\u0443\u0442\u043b\u0438\u0432\u043e\u0439 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0435\u0439
    \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0433\u043b\u0443\u0431\u043e\u0447\u0430\u0439\u0448\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442.
    \u0412\u0441\u0435 \u044d\u0442\u0438 \u0444\u0430\u043a\u0442\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442,
    \u0447\u0442\u043e \u041c\u0438\u0445\u0430\u0438\u043b \u0413\u0440\u043e\u043c\u043e\u0432
    \u2014 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a
    \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c
    \u044e\u043c\u043e\u0440\u0430, \u0441\u043a\u0440\u043e\u043c\u043d\u044b\u0439 \u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u044b\u0439
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0434\u0435\u043b\u0443."
  interestingFactsEn: "Michael Gromov is not only a huge scientific figure, but also a very colourful figure, and these are the most interesting and interesting facts from his life and his life that paint a portrait of a real genius living in a world of ideas.\n\nEarly years and family ties Children in the military hospital: Gromov was born on 23 December 1943 in Boxytogorsk, in the midst of the Great Patriotic War, and his mother was a military doctor and had to leave the front line on the Volkhov front to give birth to her son.His mother, Lia Alexandrovna Rabinovich, was the cousin of the world's legendary chess champion, Michael Botwinnik. I wonder what Gromov and Botwinnik themselves are named Michael. A book that changed everything: When the future math was nine years old, his mother gave him the book Hans Rademacher and Otto Teplica \"Etudes in Mathematics.\" It was she who gave him a deep interest in mathematics and determined much of his way forward.\n\n♪ The character and habits of \"Misha\" for the world: Despite the official name \"Michail\", colleagues and even official documents often call it \"Misha.\" He himself is such that he speaks of simplicity and accessibility. A special way to wear watches: In an interview he noticed that he wears clocks down, on the inner side of his wrist, because he is so comfortable looking at time.This small but characteristic detail highlights his practical and non-standard approach to small matters. The ideal working environment: Thromov likes to work in complete silence and privacy. When asked if he needed a paradise corner in the French suburbs, he replied that it was essential for math to be done, so that there would be no environment that would distract him from the outside world.\"Don't wash!\": In his office at the Institute of Higher Scientific Research (IHÉS) there was always an inscription on the board: \"Don't wash!\", in case the cleaning lady accidentally destroys his calculations.\n\nWhen journalists asked him why he had received the Abel Prize, he smiled and said, \"How do I know?\" The committee decided. I was surprised.\" To the question whether he was seeking the prizes, he said, \"It's nice to be ironed on the head, but I can't say I was.\"No one understands anything.\" Thunders with their own humor explained how their math lectures are being conducted: \"It's very difficult to explain pure mathematics even to math. No one understands anything in a mathematical lecture. It's math. But it's normal. Then it cuts out. It's a very difficult process in a year.\" Mathematics as architecture: He thinks that mathematics is not a solution to problems, it's an understanding of structures.And the result of mathematical activity is not a proven theorem, but an \"architectural structure that needs to be either dug up or built.\" He's admired when after chaos he discovers \"a wonderfully organized structure.\" \"I live in math\": To the question whether he likes mathematics, Gromov said, \"What is it?Comparisons with genius: In the scientific world and in the press, it is often compared with Einstein, Newton, and Leonardo da Vinci, stressing the depth and originality of his ideas.\n\n♪ Living circumstances and emigration of emigration for science: Gromov had been planning to emigrate from the USSR since he was 14 because of disagreement with the system. In the early 1970s, he even stopped publishing so that his application to go to Israel would be more successful. Invitation from abroad: He received a coded letter offering a place at Stoney Brook University in the United States if he could leave.In 1974, he left the Soviet Union on an Israeli visa and moved through Italy to the United States, and later moved to France, where he continues to work today.\n\n===Records and achievements===He is the winner of more than a dozen of the most prestigious international awards, including the 2009 Abel Prize (the Nobel Peace Prize), the Wolf Award, Kyoto, Balzana and many others.\n\nIn one of Grom's interviews with a smile, he said that one aspect of his research into geometric models could help an automatic machine distinguish a person from a dog, regardless of the pose. To the question, what's the difference, he said with irony, \"Hey, I'm sitting in that position, what am I not a dog?\"The principle of \"symlexic camel\": One of its famous results in symlexic geometry, the theory of non-pushing, has a funny nickname called \"symlexic camel principle.\" The point is that a large object (vert) cannot squeeze through too small a needle. Behind this jokeful analogy is the deepest mathematical result.All these facts show that Michael Gromov is not just a genius mathematician, but also a man with a great sense of humor, modest and fully committed to his cause."
