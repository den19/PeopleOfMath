  achievementsRu: "\u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0418\u0432\u0430\u043d\u0430
    \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447\u0430 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u2014 \u044d\u0442\u043e,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432\u0448\u0435\u0433\u043e
    \u0440\u0435\u0448\u0438\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f\u043c\u0438 \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c
    \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0438. \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 \u2014 \u043c\u0435\u0442\u043e\u0434
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c, \u0441\u0442\u0430\u0432\u0448\u0438\u0439 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u0445 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b.\n\n\U0001F4D0 \u041c\u0435\u0442\u043e\u0434 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c: \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u043a\u043b\u044e\u0447 \u043a \u0437\u0430\u0434\u0430\u0447\u0430\u043c \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b \u0412 \u043e\u0441\u043d\u043e\u0432\u0435 \u043c\u0435\u0442\u043e\u0434\u0430
    \u043b\u0435\u0436\u0438\u0442 \u0438\u0434\u0435\u044f \u043f\u0435\u0440\u0435\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0438
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e-\u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u043d\u0430 \u044f\u0437\u044b\u043a \u0430\u043d\u0430\u043b\u0438\u0437\u0430.
    \u041c\u043d\u043e\u0433\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0447\u0438\u0441\u0435\u043b
    \u0441\u0443\u043c\u043c\u0430\u043c\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e\u0433\u043e
    \u0432\u0438\u0434\u0430 \u0438\u043b\u0438 \u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b) \u043c\u043e\u0433\u0443\u0442
    \u0431\u044b\u0442\u044c \u043e\u043f\u0438\u0441\u0430\u043d\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u0441\u0443\u043c\u043c. \u041c\u0435\u0442\u043e\u0434 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430
    \u0434\u0430\u043b \u043c\u043e\u0449\u043d\u044b\u0435 \u0438 \u043e\u0431\u0449\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u043e\u0446\u0435\u043d\u043a\u0438 \u044d\u0442\u0438\u0445
    \u0441\u0443\u043c\u043c, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u043e
    \u043e\u0442\u0434\u0435\u043b\u0438\u0442\u044c \u0433\u043b\u0430\u0432\u043d\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u043e\u0442\u0432\u0435\u0442\u0430 \u043e\u0442 \u043e\u0448\u0438\u0431\u043a\u0438
    \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0442\u043e\u0447\u043d\u044b\u0435
    \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b. \u042d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0448\u0438\u043b \u0441\u0442\u0430\u0440\u044b\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b, \u043d\u043e \u0438 \u043e\u0442\u043a\u0440\u044b\u043b
    \u043d\u043e\u0432\u044b\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u044b, \u043f\u043e\u0432\u043b\u0438\u044f\u0432
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0446\u0435\u043b\u044b\u0445
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\U0001F3AF
    \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447: \u041e\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0413\u043e\u043b\u044c\u0434\u0431\u0430\u0445\u0430 \u0434\u043e \u0412\u0430\u0440\u0438\u043d\u0433\u0430
    \u0422\u0435\u0440\u043d\u0430\u0440\u043d\u0430\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430
    \u0413\u043e\u043b\u044c\u0434\u0431\u0430\u0445\u0430 (1937 \u0433.): \u042d\u0442\u043e,
    \u0431\u0435\u0437 \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u044f, \u0441\u0430\u043c\u043e\u0435
    \u0433\u0440\u043e\u043c\u043a\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430. \u0412 1742 \u0433\u043e\u0434\u0443
    \u0413\u043e\u043b\u044c\u0434\u0431\u0430\u0445 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b,
    \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435 \u043d\u0435\u0447\u0451\u0442\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0431\u043e\u043b\u044c\u0448\u0435 5 \u043c\u043e\u0436\u043d\u043e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043a\u0430\u043a \u0441\u0443\u043c\u043c\u0443
    \u0442\u0440\u0451\u0445 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b.
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u044d\u0442\u043e \u0432\u0435\u0440\u043d\u043e \u0434\u043b\u044f
    \u0432\u0441\u0435\u0445 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u0445
    \u043d\u0435\u0447\u0451\u0442\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b. \u0415\u0433\u043e
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0440\u0430\u043d\u0438\u0446\u044b
    \\( C \\), \u043f\u043e\u0441\u043b\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435
    \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f
    (\u043f\u043e\u0437\u0436\u0435 \u044d\u0442\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0430
    \u0431\u044b\u043b\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438). \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430
    \u0412\u0430\u0440\u0438\u043d\u0433\u0430 (1934 \u0433.): \u041f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f
    \u0432 1770 \u0433\u043e\u0434\u0443, \u043e\u043d\u0430 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \\( r \\) \u0441\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u0445
    (\u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439 \\( n \\)) \u043d\u0443\u0436\u043d\u043e,
    \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043b\u044e\u0431\u043e\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e. \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u0437\u0434\u0435\u0441\u044c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432: \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0447\u0438\u0441\u0435\u043b \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c \\( 10 \\) \u043a\u0443\u0431\u043e\u0432
    (\\( n=3 \\)). \u0412 \u043e\u0431\u0449\u0435\u043c \u0432\u0438\u0434\u0435 \u043e\u043d
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u043c\u043e\u0449\u043d\u0443\u044e
    \u043e\u0446\u0435\u043d\u043a\u0443 \u0434\u043b\u044f \\( G(n) \\) \u2014 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u0441\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u0445: \\(
    G(n) < 6n \\ln n + 10n \\). \u0422\u0430\u043a\u0436\u0435 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0430
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0447\u0438\u0441\u043b\u0430
    \\( N \\) \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043c\u043c\u044b \\( r \\) \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439,
    \u043a\u043e\u0433\u0434\u0430 \\( r > 10 n^2 \\ln n \\). \u042d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442,
    \u0447\u0442\u043e \u043e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f,
    \u043d\u043e \u0438 \u043d\u0430\u0448\u0451\u043b, \u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0438\u0445 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e.\n\n\U0001F4DA \u0414\u0440\u0443\u0433\u0438\u0435
    \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u041e\u0446\u0435\u043d\u043a\u0438 \u0441\u0443\u043c\u043c \u0412\u0435\u0439\u043b\u044f:
    \u0417\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0441\u0438\u043b\u0438\u043b
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0446\u0435\u043d\u043a\u0438
    \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0413\u0435\u0440\u043c\u0430\u043d\u0430 \u0412\u0435\u0439\u043b\u044f \u0434\u043b\u044f
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c \u0441 \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u0430\u043c\u0438.
    \u0415\u0433\u043e \u043e\u0446\u0435\u043d\u043a\u0438, \u0438\u043c\u0435\u044e\u0449\u0438\u0435
    \u0432\u0438\u0434 \\( P^{1 - c / n^2 \\ln n} \\), \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c
    \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u0442\u043e\u0447\u043d\u0435\u0435, \u0447\u0435\u043c
    \\( P^{1 - c / 2^n} \\) \u0443 \u0412\u0435\u0439\u043b\u044f, \u0438 \u0441\u0442\u0430\u043b\u0438
    \u043d\u0435\u0437\u0430\u043c\u0435\u043d\u0438\u043c\u044b\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0420\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b (1958 \u0433.):
    \u0412\u043d\u0451\u0441 \u0432\u0430\u0436\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b
    \u0434\u043b\u044f \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u043d\u0435 \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0445
    \\( x \\), \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0432 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0439
    \u0447\u043b\u0435\u043d \u0432 \u0444\u043e\u0440\u043c\u0443\u043b\u0435 \\( \\pi(x) =
    \\int_0^x \\frac{du}{\\ln u} + O(x e^{-a(\\ln x)^\\beta}) \\). \u041e\u0446\u0435\u043d\u043a\u0430
    \u0441\u0443\u043c\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u0432: \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u043e\u0446\u0435\u043d\u043a\u0438 \u0441\u0443\u043c\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u0432
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u043f\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u043c
    \u0447\u0438\u0441\u043b\u0430\u043c. \u0415\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0438\u043b\u0451\u043d, \u0447\u0442\u043e \u0435\u0433\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u0430\u0436\u0435
    \u0438\u0437 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0420\u0438\u043c\u0430\u043d\u0430.\n\n\U0001F58B\ufe0f \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u041f\u043e\u043c\u0438\u043c\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0441\u0442\u0430\u0442\u0435\u0439, \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0441\u043b\u0443\u0436\u0430\u0442
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u044b\u043c\u0438 \u043a\u043d\u0438\u0433\u0430\u043c\u0438
    \u0434\u043b\u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432:
    \u00ab\u041c\u0435\u0442\u043e\u0434 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b\u00bb
    (\u043c\u043d\u043e\u0433\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044c)
    \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434, \u0433\u0434\u0435
    \u043c\u0435\u0442\u043e\u0434 \u0438\u0437\u043b\u043e\u0436\u0435\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438.
    \u00ab\u041e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b\u00bb
    \u2014 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a,
    \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u0432\u0448\u0438\u0439 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0438\u0437\u0434\u0430\u043d\u0438\u0439 \u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0451\u043d\u043d\u044b\u0439
    \u043d\u0430 \u043c\u043d\u043e\u0433\u0438\u0435 \u044f\u0437\u044b\u043a\u0438, \u043f\u043e
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0443\u0447\u0438\u043b\u0438\u0441\u044c
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u00ab\u0418\u0437\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b\u00bb
    (1952) \u0438 \u00ab\u041e\u0441\u043e\u0431\u044b\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c\u00bb."
  achievementsEn: 
  personalLifeRu: "\u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u043f\u0440\u043e\u0436\u0438\u043b \u0434\u043e\u043b\u0433\u0443\u044e \u0438 \u044f\u0440\u043a\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c, \u0446\u0435\u043b\u0438\u043a\u043e\u043c \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u043d \u043f\u0440\u043e\u0448\u0435\u043b
    \u043f\u0443\u0442\u044c \u043e\u0442 \u0441\u044b\u043d\u0430 \u0441\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430 \u0434\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u043e\u0433\u043e
    \u0433\u043b\u0430\u0432\u044b \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b, \u0438 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432,
    \u043d\u043e \u0438 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u044d\u043f\u043e\u0445\u0438
    \u0441 \u0435\u0451 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438, \u0430 \u043f\u043e\u0440\u043e\u0439
    \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u044b\u043c\u0438,
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c\u0438.
    \u041d\u0438\u0436\u0435, \u0441 \u043e\u043f\u043e\u0440\u043e\u0439 \u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438, \u044f \u043f\u043e\u0441\u0442\u0430\u0440\u0430\u043b\u0441\u044f
    \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0432\u0435\u0445\u0438 \u0438 \u0434\u0435\u0442\u0430\u043b\u0438 \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0438.\n\n\U0001F468\u200d\U0001F466
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    2 (14) \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1891 \u0433\u043e\u0434\u0430 \u0432
    \u0441\u0435\u043b\u0435 \u041c\u0438\u043b\u043e\u043b\u044e\u0431 \u0412\u0435\u043b\u0438\u043a\u043e\u043b\u0443\u043a\u0441\u043a\u043e\u0433\u043e
    \u0443\u0435\u0437\u0434\u0430 \u041f\u0441\u043a\u043e\u0432\u0441\u043a\u043e\u0439 \u0433\u0443\u0431\u0435\u0440\u043d\u0438\u0438.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u041c\u0430\u0442\u0432\u0435\u0439 \u0410\u0432\u0440\u0430\u0430\u043c\u043e\u0432\u0438\u0447,
    \u0431\u044b\u043b \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u043c \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u043c.
    \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u043e \u044d\u0442\u043e\u0442
    \u0444\u0430\u043a\u0442 \u043d\u0435 \u043f\u043e\u043c\u0435\u0448\u0430\u043b \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0443
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0432 \u0430\u0442\u0435\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u043c \u0421\u043e\u044e\u0437\u0435, \u043d\u043e
    \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f.
    \u0421\u0430\u043c \u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442.
    \u0412\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u043e\u043d \u043f\u0440\u043e\u0436\u0438\u043b
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u043e\u0439
    \u041d\u0430\u0434\u0435\u0436\u0434\u043e\u0439 \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u043d\u043e\u0439,
    \u0438 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435
    \u0443\u0447\u0435\u043d\u0438\u043a\u0438 \u0437\u0430\u043c\u0435\u043d\u044f\u043b\u0438
    \u0435\u043c\u0443 \u0441\u0435\u043c\u044c\u044e. \u0412 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0441\u0430\u0434\u043e\u043c \u0438 \u0446\u0432\u0435\u0442\u0430\u043c\u0438 \u043d\u0430
    \u0441\u0432\u043e\u0435\u0439 \u0434\u0430\u0447\u0435 \u0432 \u0410\u0431\u0440\u0430\u043c\u0446\u0435\u0432\u043e.\n\n\U0001F393
    \u0423\u0447\u0451\u0431\u0430, \u043d\u0430\u0443\u043a\u0430 \u0438 \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u041f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u0447\u0438\u043b\u0438\u0449\u0430 \u0432 \u0412\u0435\u043b\u0438\u043a\u0438\u0445
    \u041b\u0443\u043a\u0430\u0445 \u0432 1910 \u0433\u043e\u0434\u0443, \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0422\u0430\u043c
    \u043e\u043d \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u0447\u0438\u0441\u0435\u043b. \u0412 1914 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0438, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u0432\u043e\u0438\u043c
    \u0443\u0441\u043f\u0435\u0445\u0430\u043c, \u0431\u044b\u043b \u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u043f\u0440\u0438 \u043d\u0435\u043c \u0434\u043b\u044f \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438
    \u043a \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u043c\u0443
    \u0437\u0432\u0430\u043d\u0438\u044e. \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c \u0431\u044b\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u042f.\u0412. \u0423\u0441\u043f\u0435\u043d\u0441\u043a\u0438\u0439.
    \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u043f\u0443\u0442\u044c \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430
    \u0441\u043e\u0432\u043f\u0430\u043b \u0441 \u0431\u0443\u0440\u043d\u044b\u043c\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438: \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u0430\u044f
    \u0432\u043e\u0439\u043d\u0430 \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0438
    (1918\u20131920): \u0412 \u0433\u043e\u0434\u044b \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b \u0432 \u041f\u0435\u0440\u043c\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0430 \u0441
    1920 \u0433\u043e\u0434\u0430 \u2014 \u0432 \u0422\u043e\u043c\u0441\u043a\u043e\u043c.
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434
    (1920\u20131934): \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0438 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430. \u0412 1929 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 37 \u043b\u0435\u0442, \u043e\u043d
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a
    \u0421\u0421\u0421\u0420. \u041f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u041c\u043e\u0441\u043a\u0432\u0443
    \u0438 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u041c\u0418\u0410\u041d
    (1934\u20131983): 1934 \u0433\u043e\u0434 \u0441\u0442\u0430\u043b \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c
    \u0432 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0435. \u0412 \u0441\u0432\u044f\u0437\u0438
    \u0441 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u043c \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0432 \u041c\u043e\u0441\u043a\u0432\u0443 \u0424\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0431\u044b\u043b \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d,
    \u0438 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b
    \u0432\u043d\u043e\u0432\u044c \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0439 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0438\u043c\u0435\u043d\u0438 \u0412.\u0410.
    \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430 (\u041c\u0418\u0410\u041d). \u041e\u043d
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043b \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u043c
    \u043f\u043e\u0447\u0442\u0438 50 \u043b\u0435\u0442, \u0434\u043e \u0441\u0430\u043c\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438, \u0441 \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u043e\u043c
    \u043d\u0430 \u0433\u043e\u0434\u044b \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u0438
    \u0432 \u041a\u0430\u0437\u0430\u043d\u044c (1941\u20131944) \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b.\n\n\U0001F91D \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438: \u0434\u0440\u0443\u0436\u0431\u0430
    \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0431\u044b\u043b \u0444\u0438\u0433\u0443\u0440\u043e\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0438 \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0439. \u0421
    \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u043e\u043d
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u0442\u0435\u0441\u043d\u044b\u0435,
    \u0434\u0440\u0443\u0436\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0432
    \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0441 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u041d \u0421\u0421\u0421\u0420 \u041c.\u0412. \u041a\u0435\u043b\u0434\u044b\u0448\u0435\u043c
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u041c.\u0410.
    \u041b\u0430\u0432\u0440\u0435\u043d\u0442\u044c\u0435\u0432\u044b\u043c. \u041e\u043d \u0431\u044b\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c:
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b
    \u0432 \u041a\u041f\u0421\u0421 \u0438 \u0432 1955 \u0433\u043e\u0434\u0443 \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435 \u00ab\u041f\u0438\u0441\u044c\u043c\u043e
    \u0442\u0440\u0435\u0445\u0441\u043e\u0442\u00bb \u043f\u0440\u043e\u0442\u0438\u0432 \u043b\u044b\u0441\u0435\u043d\u043a\u043e\u0432\u0449\u0438\u043d\u044b.
    \u0421 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b,
    \u0432 1970-\u0435 \u0433\u043e\u0434\u044b \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u0430\u044f
    \u043e\u043f\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u0435\u0433\u043e \u043b\u0438\u0434\u0435\u0440\u0441\u0442\u0432\u0443.
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430 \u043e\u0431\u0432\u0438\u043d\u044f\u043b\u0438
    \u0432 \u043d\u0435\u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u043f\u0440\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u043a\u0430\u0434\u0440\u043e\u0432\u044b\u0445
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u0438, \u0447\u0442\u043e \u0441\u0430\u043c\u043e\u0435
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0435, \u0432 \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c\u0435
    \u2014 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e
    \u043e\u043d \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u043a\u0430\u0440\u044c\u0435\u0440\u043d\u043e\u043c\u0443 \u0440\u043e\u0441\u0442\u0443
    \u0443\u0447\u0435\u043d\u044b\u0445-\u0435\u0432\u0440\u0435\u0435\u0432. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u044d\u0442\u0438 \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f \u0438
    \u0442\u0430\u0439\u043d\u043e\u0435 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0430\u043d\u0438\u0435
    \u0432 1977 \u0433\u043e\u0434\u0443, \u0433\u0434\u0435 \u043e\u043a\u043e\u043b\u043e
    \u0442\u0440\u0435\u0442\u0438 \u0433\u043e\u043b\u043e\u0441\u043e\u0432 \u0431\u044b\u043b\u043e
    \u043f\u043e\u0434\u0430\u043d\u043e \u043f\u0440\u043e\u0442\u0438\u0432 \u043d\u0435\u0433\u043e,
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b
    \u043f\u043e\u0441\u0442 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430 \u041c\u0418\u0410\u041d.\n\n\U0001F54A\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 20 \u043c\u0430\u0440\u0442\u0430
    1983 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435 \u043d\u0430 92-\u043c
    \u0433\u043e\u0434\u0443 \u0436\u0438\u0437\u043d\u0438. \u041e\u043d \u0431\u044b\u043b
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430 \u041d\u043e\u0432\u043e\u0434\u0435\u0432\u0438\u0447\u044c\u0435\u043c
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u043f\u0440\u0438\u043c\u0435\u0440 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043e\u0447\u0435\u0442\u0430\u043b\u0430\u0441\u044c
    \u0441 \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0432\u043e\u043b\u0435\u0439,
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432\u0448\u0435\u0439 \u0435\u043c\u0443 \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f
    \u0443 \u0440\u0443\u043b\u044f \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0441\u0442\u0440\u0430\u043d\u044b
    \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u043b\u0443\u0432\u0435\u043a\u0430."
  personalLifeEn: 
  shortBioRu: "\u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    (1891\u20131983) \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u044f\u0440\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    XX \u0432\u0435\u043a\u0430, \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u043c\u0435\u0442\u043e\u0434\u0430
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c \u0438 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0439
    \u0433\u043b\u0430\u0432\u0430 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c, \u043f\u043e\u043b\u043d\u0430\u044f
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432
    \u0438 \u0436\u0435\u0441\u0442\u043a\u043e\u0433\u043e \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f,
    \u0440\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0430 \u0444\u043e\u043d\u0435 \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0441\u043e\u0431\u044b\u0442\u0438\u0439 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0432\u0435\u0445\u0438 \u0435\u0433\u043e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438, \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435
    \u0432 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0440\u044f\u0434\u043a\u0435.\n\n\U0001F4DC \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b (1891\u20131914) \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0435\u043c\u044c\u044f: \u0418\u0432\u0430\u043d \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 2 (14) \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1891 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0435\u043b\u0435 \u041c\u0438\u043b\u043e\u043b\u044e\u0431
    \u0412\u0435\u043b\u0438\u043a\u043e\u043b\u0443\u043a\u0441\u043a\u043e\u0433\u043e \u0443\u0435\u0437\u0434\u0430
    \u041f\u0441\u043a\u043e\u0432\u0441\u043a\u043e\u0439 \u0433\u0443\u0431\u0435\u0440\u043d\u0438\u0438.
    \u041e\u043d \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b \u0438\u0437 \u0441\u0435\u043c\u044c\u0438
    \u043f\u043e\u0442\u043e\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u0430\u0432\u043e\u0441\u043b\u0430\u0432\u043d\u044b\u0445
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u0432; \u0435\u0433\u043e \u043e\u0442\u0435\u0446,
    \u041c\u0430\u0442\u0444\u0435\u0439 \u0410\u0432\u0440\u0430\u0430\u043c\u043e\u0432\u0438\u0447
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432, \u0431\u044b\u043b \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u043c
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u043c \u0438 \u0437\u0430\u0432\u0435\u0434\u043e\u0432\u0430\u043b
    \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u043e-\u043f\u0440\u0438\u0445\u043e\u0434\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u043e\u0439. \u0421\u0440\u0435\u0434\u043d\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u0423\u0447\u0438\u043b\u0441\u044f \u0432 \u0412\u0435\u043b\u0438\u043a\u043e\u043b\u0443\u043a\u0441\u043a\u043e\u043c
    \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0443\u0447\u0438\u043b\u0438\u0449\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0432
    1910 \u0433\u043e\u0434\u0443. \u0423\u0436\u0435 \u0432 \u044d\u0442\u0438 \u0433\u043e\u0434\u044b
    \u043e\u043d \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439,
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u044f
    \u0432\u044b\u0441\u0448\u0438\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u044d\u0442\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b: \u0412 1910 \u0433\u043e\u0434\u0443 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u041e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0435\u0433\u043e \u0432 1914 \u0433\u043e\u0434\u0443 \u0441 \u0431\u043b\u0435\u0441\u043a\u043e\u043c
    \u0438 \u0431\u044b\u043b \u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u043f\u0440\u0438
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0434\u043b\u044f
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u043a \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u043c\u0443
    \u0437\u0432\u0430\u043d\u0438\u044e. \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c \u0431\u044b\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u042f. \u0412. \u0423\u0441\u043f\u0435\u043d\u0441\u043a\u0438\u0439.\n\n\U0001F4DA
    \u0421\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0443\u0447\u0435\u043d\u043e\u0433\u043e
    \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0448\u0430\u0433\u0438 \u0432 \u043d\u0430\u0443\u043a\u0435
    (1914\u20131934) \u041d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0430: \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u0432 \u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u0412 \u0433\u043e\u0434\u044b \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041f\u0435\u0440\u043c\u0441\u043a\u043e\u043c
    \u0438 \u0422\u043e\u043c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445.
    \u0412 1920 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434: \u0421 1920 \u0433\u043e\u0434\u0430
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u2014 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0438 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u0433\u0434\u0435
    \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043e 1934 \u0433\u043e\u0434\u0430.
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u0412 1929 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 37 \u043b\u0435\u0442, \u043e\u043d
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c (\u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c)
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0421\u0421\u0421\u0420.\n\n\U0001F52C
    \u0422\u0440\u0438\u0443\u043c\u0444: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u0430
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c (1934\u20131945) \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439 \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b. \u0412\u043e
    \u0433\u043b\u0430\u0432\u0435 \u041c\u0418\u0410\u041d: \u0412 1934 \u0433\u043e\u0434\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a
    \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043b\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0443,
    \u0424\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0431\u044b\u043b \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d
    \u043d\u0430 \u0434\u0432\u0430 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430. \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u0432\u043d\u043e\u0432\u044c \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0433\u043e
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0438\u043c. \u0412.\u0410. \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430
    (\u041c\u0418\u0410\u041d) \u0438 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443 \u043f\u043e\u0447\u0442\u0438
    50 \u043b\u0435\u0442, \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438.
    \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435:
    \u0412 1937 \u0433\u043e\u0434\u0443 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c. \u042d\u0442\u043e\u0442 \u043c\u043e\u0449\u043d\u044b\u0439
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b
    \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043f\u0440\u043e\u0440\u044b\u0432 \u0432 \u0441\u0430\u043c\u044b\u0445
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447\u0430\u0445 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0413\u043e\u043b\u044c\u0434\u0431\u0430\u0445\u0430: \u0412 \u0442\u043e\u043c \u0436\u0435
    1937 \u0433\u043e\u0434\u0443 \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0442\u0435\u0440\u043d\u0430\u0440\u043d\u0443\u044e
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0413\u043e\u043b\u044c\u0434\u0431\u0430\u0445\u0430,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0435
    \u043d\u0435\u0447\u0435\u0442\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e
    \u043a\u0430\u043a \u0441\u0443\u043c\u043c\u0430 \u0442\u0440\u0435\u0445 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u042d\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430,
    \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0435\u0449\u0435
    \u0432 XVIII \u0432\u0435\u043a\u0435, \u0431\u043e\u043b\u0435\u0435 200 \u043b\u0435\u0442
    \u043d\u0435 \u043f\u043e\u0434\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u044e.
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0437\u0430\u0441\u043b\u0443\u0433:
    \u0417\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u00ab\u041d\u043e\u0432\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b\u00bb \u0432 1941 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0421\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 I \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0438\u043c
    \u044d\u0442\u0443 \u043f\u0440\u0435\u043c\u0438\u044e. \u0412 1945 \u0433\u043e\u0434\u0443
    \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u043e
    \u0437\u0432\u0430\u043d\u0438\u0435 \u0413\u0435\u0440\u043e\u044f \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430.\n\n\u2696\ufe0f \u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440,
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f
    (1945\u20131983) \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0431\u044b\u043b
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0438
    \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0439. \u0412\u043b\u0430\u0441\u0442\u044c
    \u0438 \u0434\u043e\u043b\u0433\u043e\u043b\u0435\u0442\u0438\u0435: \u041e\u043d \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c,
    \u0430 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0433\u043b\u0430\u0432\u043e\u0439
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c
    \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u043c \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0438 \u0431\u044b\u043b \u0431\u043b\u0438\u0437\u043a\u0438\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430
    \u0410\u041d \u0421\u0421\u0421\u0420 \u041c.\u0412. \u041a\u0435\u043b\u0434\u044b\u0448\u0430.
    \u0415\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u041c\u0418\u0410\u041d\u043e\u043c
    \u0434\u043b\u0438\u043b\u043e\u0441\u044c 49 \u043b\u0435\u0442, \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c \u0441\u043b\u0443\u0447\u0430\u0435\u043c
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438. \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c
    \u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c:
    \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u0447\u0442\u043e
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u041a\u041f\u0421\u0421.
    \u041e\u043d \u043d\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u043b \u0441\u0432\u043e\u0435\u0433\u043e
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u0434\u0430\u0436\u0435
    \u0432 \u044d\u043f\u043e\u0445\u0443 \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u0440\u0435\u043b\u0438\u0433\u0438\u0435\u0439,
    \u0438 \u0438\u043c\u0435\u043b \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0433 \u0443\u043a\u0430\u0437\u0430\u0442\u044c
    \u043d\u0430 \u0434\u0432\u0435\u0440\u044c \u0432\u044b\u0441\u043e\u043a\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u0430\u043c. \u0412 1955 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u00ab\u041f\u0438\u0441\u044c\u043c\u043e \u0442\u0440\u0435\u0445\u0441\u043e\u0442\u00bb
    \u043f\u0440\u043e\u0442\u0438\u0432 \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0422.\u0414.
    \u041b\u044b\u0441\u0435\u043d\u043a\u043e. \u041e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f
    \u0432 \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c\u0435: \u0412
    1970-\u0435 \u0433\u043e\u0434\u044b \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u0430\u044f
    \u043e\u043f\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u0435\u0433\u043e \u043b\u0438\u0434\u0435\u0440\u0441\u0442\u0432\u0443.
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430 \u043d\u0435\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e
    \u043e\u0431\u0432\u0438\u043d\u044f\u043b\u0438 \u0432 \u043d\u0435\u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u043f\u0440\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u043a\u0430\u0434\u0440\u043e\u0432\u044b\u0445
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0432 \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c\u0435 \u0438
    \u0446\u0435\u043b\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u043c
    \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u0438 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0438\u0437 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430.
    \u0412\u043e\u043b\u044f \u043a \u0432\u043b\u0430\u0441\u0442\u0438: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u044d\u0442\u0438 \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f \u0438
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0441\u0443\u043c\u0435\u043b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0439
    \u043f\u043e\u0441\u0442. \u0412 1977 \u0433\u043e\u0434\u0443 \u043d\u0430 \u043e\u0431\u0449\u0435\u043c
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0438 \u0410\u041d \u0421\u0421\u0421\u0420 \u043e\u043a\u043e\u043b\u043e
    \u0442\u0440\u0435\u0442\u0438 \u0433\u043e\u043b\u043e\u0441\u043e\u0432 \u0431\u044b\u043b\u043e
    \u043f\u043e\u0434\u0430\u043d\u043e \u043f\u0440\u043e\u0442\u0438\u0432 \u0435\u0433\u043e
    \u043f\u0435\u0440\u0435\u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044f, \u043d\u043e \u044d\u0442\u043e\u0433\u043e
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0434\u043b\u044f \u0435\u0433\u043e \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u044f.\n\n\U0001F468\u200d\U0001F33E
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u0421\u0435\u043c\u044c\u044f: \u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442
    \u0438 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u043e\u0436\u0438\u043b
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u043e\u0439
    \u041d\u0430\u0434\u0435\u0436\u0434\u043e\u0439 \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u043d\u043e\u0439.
    \u041d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0435 \u0445\u043e\u0431\u0431\u0438: \u041e\u043d
    \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u043b\u043e\u0439.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c,
    \u043e\u043d \u043c\u043e\u0433 \u043e\u0434\u043d\u043e\u0439 \u0440\u0443\u043a\u043e\u0439
    \u043f\u043e\u0434\u043d\u044f\u0442\u044c \u0441\u0442\u0443\u043b \u0441 \u0441\u0438\u0434\u044f\u0449\u0438\u043c
    \u043d\u0430 \u043d\u0435\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u0434\u0435\u0440\u0436\u0430 \u0435\u0433\u043e \u0437\u0430 \u043d\u043e\u0436\u043a\u0443.
    \u0414\u0430\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0412\u0441\u0435
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u043d
    \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u043d\u0430 \u0434\u0430\u0447\u0435 \u0432
    \u0410\u0431\u0440\u0430\u043c\u0446\u0435\u0432\u043e, \u0443\u0432\u043b\u0435\u043a\u0430\u044f\u0441\u044c
    \u0441\u0430\u0434\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u0438 \u0446\u0432\u0435\u0442\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c.\n\n\U0001F3C6
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041d\u0430\u0433\u0440\u0430\u0434\u044b: \u0417\u0430 \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c
    \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043d\u0430\u0433\u0440\u0430\u0434, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0432\u0442\u043e\u0440\u0443\u044e
    \u0437\u0432\u0435\u0437\u0434\u0443 \u0413\u0435\u0440\u043e\u044f \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430 (1971), \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e (1972) \u0438 \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e \u0421\u0421\u0421\u0420 (1983). \u0412 1971 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0417\u043e\u043b\u043e\u0442\u0443\u044e
    \u043c\u0435\u0434\u0430\u043b\u044c \u0438\u043c. \u041c.\u0412. \u041b\u043e\u043c\u043e\u043d\u043e\u0441\u043e\u0432\u0430.
    \u041c\u0443\u0437\u0435\u0439 \u0438 \u043f\u0430\u043c\u044f\u0442\u044c: \u041e\u043d
    \u0441\u0442\u0430\u043b \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0431\u044b\u043b \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d \u043c\u0435\u043c\u043e\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043c\u0443\u0437\u0435\u0439 \u0432 \u0412\u0435\u043b\u0438\u043a\u0438\u0445 \u041b\u0443\u043a\u0430\u0445.
    \u0422\u0430\u043a\u0436\u0435 \u043d\u0430 \u0435\u0433\u043e \u0440\u043e\u0434\u0438\u043d\u0435
    \u0431\u044b\u043b \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d \u0431\u0440\u043e\u043d\u0437\u043e\u0432\u044b\u0439
    \u0431\u044e\u0441\u0442, \u0447\u0430\u0441\u0442\u044c \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u043e\u043f\u043b\u0430\u0442\u0438\u043b
    \u0441\u0430\u043c. \u0421\u043c\u0435\u0440\u0442\u044c: \u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    20 \u043c\u0430\u0440\u0442\u0430 1983 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435
    \u043d\u0430 92-\u043c \u0433\u043e\u0434\u0443 \u0436\u0438\u0437\u043d\u0438. \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043d\u0430 \u041d\u043e\u0432\u043e\u0434\u0435\u0432\u0438\u0447\u044c\u0435\u043c \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0418\u0432\u0430\u043d\u0430 \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447\u0430
