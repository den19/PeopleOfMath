    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0434\u0435\u0442\u0430\u043b\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443
