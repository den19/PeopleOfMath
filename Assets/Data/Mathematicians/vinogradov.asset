    \u0442\u0435\u043e\u0440\u0435\u043c\u044b. \u0412 \u0448\u0443\u0442\u043a\u0443 \u043e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e
    \u043e\u043f\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0437\u043c\u0430 \u0436\u0435\u043d\u0449\u0438\u043d,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u0443\u0442 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c
    \u0431\u0440\u0430\u043a \u0441 \u0443\u0447\u0435\u043d\u044b\u043c \u043a\u0430\u043a
    \u00ab\u0432\u044b\u0433\u043e\u0434\u043d\u0443\u044e \u043f\u0430\u0440\u0442\u0438\u044e\u00bb.
    \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0444\u0430\u043c\u0438\u043b\u0438\u0438: \u0424\u0430\u043c\u0438\u043b\u0438\u044f
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0438\u043c\u0435\u0435\u0442
    \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u043e\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446 \u0443\u0447\u0438\u043b\u0441\u044f \u0432
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u0438\u0438, \u0433\u0434\u0435 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u0438\u043a\u0430\u043c
    \u0434\u0430\u0432\u0430\u043b\u0438 \u0444\u0430\u043c\u0438\u043b\u0438\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438
    \u043e\u0442 \u0443\u0441\u043f\u0435\u0432\u0430\u0435\u043c\u043e\u0441\u0442\u0438. \u041b\u0443\u0447\u0448\u0438\u0435
    \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u0438 \u00ab\u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u044b\u0435\u00bb
    \u0444\u0430\u043c\u0438\u043b\u0438\u0438 (\u041a\u0440\u0435\u0449\u0435\u043d\u0441\u043a\u0438\u0439,
    \u0412\u043e\u0437\u043d\u0435\u0441\u0435\u043d\u0441\u043a\u0438\u0439), \u0442\u0435,
    \u043a\u0442\u043e \u0443\u0447\u0438\u043b\u0441\u044f \u0445\u0443\u0436\u0435 \u2014
    \u00ab\u0446\u0432\u0435\u0442\u043e\u0447\u043d\u044b\u0435\u00bb (\u0413\u0438\u0430\u0446\u0438\u043d\u0442\u043e\u0432,
    \u0420\u043e\u0437\u043e\u0432). \u041d\u0438\u0437\u0448\u0435\u0439 \u0441\u0447\u0438\u0442\u0430\u043b\u0430\u0441\u044c
    \u00ab\u0444\u0440\u0443\u043a\u0442\u043e\u0432\u043e-\u044f\u0433\u043e\u0434\u043d\u0430\u044f\u00bb
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f. \u0424\u0430\u043c\u0438\u043b\u0438\u044f
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0430\u0441\u044c
    \u043a \u00ab\u0446\u0432\u0435\u0442\u043e\u0447\u043d\u043e\u0439\u00bb. \u0411\u044e\u0441\u0442
    \u0437\u0430 \u0441\u0432\u043e\u0439 \u0441\u0447\u0435\u0442: \u041a\u0430\u043a \u0434\u0432\u0430\u0436\u0434\u044b
    \u0413\u0435\u0440\u043e\u0439 \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0438\u043c\u0435\u043b \u043f\u0440\u0430\u0432\u043e \u043d\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443
    \u043f\u0440\u0438\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u0431\u0440\u043e\u043d\u0437\u043e\u0432\u043e\u0433\u043e
    \u0431\u044e\u0441\u0442\u0430 \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0443 \u0432\u043b\u0430\u0441\u0442\u0435\u0439 \u043d\u0435 \u043d\u0430\u0448\u043b\u043e\u0441\u044c
    \u043d\u0430 \u044d\u0442\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432. \u0422\u043e\u0433\u0434\u0430
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a \u0441\u0430\u043c \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e
    \u043e\u043f\u043b\u0430\u0442\u0438\u043b \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438 \u0431\u044b\u043b \u0442\u043e\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442 \u0432 \u0412\u0435\u043b\u0438\u043a\u0438\u0445 \u041b\u0443\u043a\u0430\u0445
    \u0432 1979 \u0433\u043e\u0434\u0443. \u041d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043e\u043d \u043d\u0435 \u043f\u043e\u0435\u0445\u0430\u043b, \u0442\u0430\u043a \u043a\u0430\u043a
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u044b \u043d\u0435 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438
    \u0435\u0433\u043e \u0441\u0435\u0441\u0442\u0440\u0443. \"\u041f\u043d\u0438 \u043a\u043e\u0440\u0447\u0443\u044e
    \u0440\u0443\u043a\u0430\u043c\u0438\": \u0412 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u043b\u044e\u0431\u0438\u043b \u0432\u043e\u0437\u0438\u0442\u044c\u0441\u044f \u0432 \u0441\u0430\u0434\u0443
    \u0438 \u0446\u0432\u0435\u0442\u043d\u0438\u043a\u0435 \u043d\u0430 \u0441\u0432\u043e\u0435\u0439
    \u0434\u0430\u0447\u0435 \u0432 \u0410\u0431\u0440\u0430\u043c\u0446\u0435\u0432\u043e.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u043a\u0430\u043a \u043e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435,
    \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u041f\u043d\u0438 \u043a\u043e\u0440\u0447\u0443\u044e
    \u043d\u0430 \u0434\u0430\u0447\u0435\u00bb. \u0410 \u043d\u0430 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435,
    \u043b\u043e\u043c\u043e\u043c \u043b\u0438 \u043e\u043d \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442,
    \u0434\u043e\u0431\u0430\u0432\u0438\u043b: \u00ab\u041d\u0435\u0442, \u0440\u0443\u043a\u0430\u043c\u0438,
    \u043c\u043d\u0435 \u0431\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430 \u043f\u0435\u043d\u044c
    \u0443\u0445\u0432\u0430\u0442\u0438\u0442\u044c\u0441\u044f...\u00bb, \u0447\u0442\u043e
    \u0432\u043f\u043e\u043b\u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0443\u0435\u0442\u0441\u044f
    \u0441 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043c\u0438 \u043e \u0435\u0433\u043e
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u043b\u0435. \u042d\u0442\u0438
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u043e\u0431\u0440\u0430\u0437
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c,
    \u0441\u0438\u043b\u044c\u043d\u043e\u0439 \u0432\u043e\u043b\u0435\u0439 \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u043c
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c \u044e\u043c\u043e\u0440\u0430. \u041e\u043d
    \u0431\u044b\u043b \u0438 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445 \u0438 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0444\u0438\u0433\u0443\u0440 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438."
