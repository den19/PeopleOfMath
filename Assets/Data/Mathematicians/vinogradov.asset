    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u0433\u0434\u0435
    \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043e 1934 \u0433\u043e\u0434\u0430.
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u0412 1929 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 37 \u043b\u0435\u0442, \u043e\u043d
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c (\u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u043c)
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0421\u0421\u0421\u0420.\n\n\U0001F52C
    \u0422\u0440\u0438\u0443\u043c\u0444: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u0430
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c (1934\u20131945) \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439 \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b. \u0412\u043e
    \u0433\u043b\u0430\u0432\u0435 \u041c\u0418\u0410\u041d: \u0412 1934 \u0433\u043e\u0434\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a
    \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043b\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0443,
    \u0424\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0431\u044b\u043b \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d
    \u043d\u0430 \u0434\u0432\u0430 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430. \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u0432\u043d\u043e\u0432\u044c \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0433\u043e
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0438\u043c. \u0412.\u0410. \u0421\u0442\u0435\u043a\u043b\u043e\u0432\u0430
    (\u041c\u0418\u0410\u041d) \u0438 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443 \u043f\u043e\u0447\u0442\u0438
    50 \u043b\u0435\u0442, \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438.
    \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435:
    \u0412 1937 \u0433\u043e\u0434\u0443 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0443\u043c\u043c. \u042d\u0442\u043e\u0442 \u043c\u043e\u0449\u043d\u044b\u0439
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b
    \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043f\u0440\u043e\u0440\u044b\u0432 \u0432 \u0441\u0430\u043c\u044b\u0445
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447\u0430\u0445 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b. \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0413\u043e\u043b\u044c\u0434\u0431\u0430\u0445\u0430: \u0412 \u0442\u043e\u043c \u0436\u0435
    1937 \u0433\u043e\u0434\u0443 \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0442\u0435\u0440\u043d\u0430\u0440\u043d\u0443\u044e
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0413\u043e\u043b\u044c\u0434\u0431\u0430\u0445\u0430,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0435
    \u043d\u0435\u0447\u0435\u0442\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u043c\u043e\u0436\u0435\u0442
    \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e
    \u043a\u0430\u043a \u0441\u0443\u043c\u043c\u0430 \u0442\u0440\u0435\u0445 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u042d\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430,
    \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0435\u0449\u0435
    \u0432 XVIII \u0432\u0435\u043a\u0435, \u0431\u043e\u043b\u0435\u0435 200 \u043b\u0435\u0442
    \u043d\u0435 \u043f\u043e\u0434\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u044e.
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0437\u0430\u0441\u043b\u0443\u0433:
    \u0417\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u00ab\u041d\u043e\u0432\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b\u00bb \u0432 1941 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0421\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0438 I \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0438\u043c
    \u044d\u0442\u0443 \u043f\u0440\u0435\u043c\u0438\u044e. \u0412 1945 \u0433\u043e\u0434\u0443
    \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u043e
    \u0437\u0432\u0430\u043d\u0438\u0435 \u0413\u0435\u0440\u043e\u044f \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430.\n\n\u2696\ufe0f \u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440,
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f
    (1945\u20131983) \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0431\u044b\u043b
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0438
    \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0439. \u0412\u043b\u0430\u0441\u0442\u044c
    \u0438 \u0434\u043e\u043b\u0433\u043e\u043b\u0435\u0442\u0438\u0435: \u041e\u043d \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c,
    \u0430 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0433\u043b\u0430\u0432\u043e\u0439
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c
    \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u043c \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0438 \u0431\u044b\u043b \u0431\u043b\u0438\u0437\u043a\u0438\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430
    \u0410\u041d \u0421\u0421\u0421\u0420 \u041c.\u0412. \u041a\u0435\u043b\u0434\u044b\u0448\u0430.
    \u0415\u0433\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u041c\u0418\u0410\u041d\u043e\u043c
    \u0434\u043b\u0438\u043b\u043e\u0441\u044c 49 \u043b\u0435\u0442, \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c \u0441\u043b\u0443\u0447\u0430\u0435\u043c
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438. \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c
    \u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c:
    \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u0447\u0442\u043e
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u041a\u041f\u0421\u0421.
    \u041e\u043d \u043d\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u043b \u0441\u0432\u043e\u0435\u0433\u043e
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u0434\u0430\u0436\u0435
    \u0432 \u044d\u043f\u043e\u0445\u0443 \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u0440\u0435\u043b\u0438\u0433\u0438\u0435\u0439,
    \u0438 \u0438\u043c\u0435\u043b \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0433 \u0443\u043a\u0430\u0437\u0430\u0442\u044c
    \u043d\u0430 \u0434\u0432\u0435\u0440\u044c \u0432\u044b\u0441\u043e\u043a\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u0430\u043c. \u0412 1955 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u00ab\u041f\u0438\u0441\u044c\u043c\u043e \u0442\u0440\u0435\u0445\u0441\u043e\u0442\u00bb
    \u043f\u0440\u043e\u0442\u0438\u0432 \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0422.\u0414.
    \u041b\u044b\u0441\u0435\u043d\u043a\u043e. \u041e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f
    \u0432 \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c\u0435: \u0412
    1970-\u0435 \u0433\u043e\u0434\u044b \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u0430\u044f
    \u043e\u043f\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u0435\u0433\u043e \u043b\u0438\u0434\u0435\u0440\u0441\u0442\u0432\u0443.
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430 \u043d\u0435\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e
    \u043e\u0431\u0432\u0438\u043d\u044f\u043b\u0438 \u0432 \u043d\u0435\u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    \u043f\u0440\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u043a\u0430\u0434\u0440\u043e\u0432\u044b\u0445
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0432 \u0430\u043d\u0442\u0438\u0441\u0435\u043c\u0438\u0442\u0438\u0437\u043c\u0435 \u0438
    \u0446\u0435\u043b\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u043c
    \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u0438 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0438\u0437 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430.
    \u0412\u043e\u043b\u044f \u043a \u0432\u043b\u0430\u0441\u0442\u0438: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u044d\u0442\u0438 \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f \u0438
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0441\u0443\u043c\u0435\u043b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0439
    \u043f\u043e\u0441\u0442. \u0412 1977 \u0433\u043e\u0434\u0443 \u043d\u0430 \u043e\u0431\u0449\u0435\u043c
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0438 \u0410\u041d \u0421\u0421\u0421\u0420 \u043e\u043a\u043e\u043b\u043e
    \u0442\u0440\u0435\u0442\u0438 \u0433\u043e\u043b\u043e\u0441\u043e\u0432 \u0431\u044b\u043b\u043e
    \u043f\u043e\u0434\u0430\u043d\u043e \u043f\u0440\u043e\u0442\u0438\u0432 \u0435\u0433\u043e
    \u043f\u0435\u0440\u0435\u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044f, \u043d\u043e \u044d\u0442\u043e\u0433\u043e
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u0434\u043b\u044f \u0435\u0433\u043e \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u044f.\n\n\U0001F468\u200d\U0001F33E
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u0421\u0435\u043c\u044c\u044f: \u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442
    \u0438 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u043e\u0436\u0438\u043b
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u043e\u0439
    \u041d\u0430\u0434\u0435\u0436\u0434\u043e\u0439 \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u043d\u043e\u0439.
    \u041d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0435 \u0445\u043e\u0431\u0431\u0438: \u041e\u043d
    \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u043b\u043e\u0439.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c,
    \u043e\u043d \u043c\u043e\u0433 \u043e\u0434\u043d\u043e\u0439 \u0440\u0443\u043a\u043e\u0439
    \u043f\u043e\u0434\u043d\u044f\u0442\u044c \u0441\u0442\u0443\u043b \u0441 \u0441\u0438\u0434\u044f\u0449\u0438\u043c
    \u043d\u0430 \u043d\u0435\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u0434\u0435\u0440\u0436\u0430 \u0435\u0433\u043e \u0437\u0430 \u043d\u043e\u0436\u043a\u0443.
    \u0414\u0430\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0412\u0441\u0435
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u043d
    \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u043d\u0430 \u0434\u0430\u0447\u0435 \u0432
    \u0410\u0431\u0440\u0430\u043c\u0446\u0435\u0432\u043e, \u0443\u0432\u043b\u0435\u043a\u0430\u044f\u0441\u044c
    \u0441\u0430\u0434\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u0438 \u0446\u0432\u0435\u0442\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c.\n\n\U0001F3C6
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041d\u0430\u0433\u0440\u0430\u0434\u044b: \u0417\u0430 \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c
    \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u043d\u0430\u0433\u0440\u0430\u0434, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0432\u0442\u043e\u0440\u0443\u044e
    \u0437\u0432\u0435\u0437\u0434\u0443 \u0413\u0435\u0440\u043e\u044f \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430 (1971), \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e (1972) \u0438 \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e \u0421\u0421\u0421\u0420 (1983). \u0412 1971 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0417\u043e\u043b\u043e\u0442\u0443\u044e
    \u043c\u0435\u0434\u0430\u043b\u044c \u0438\u043c. \u041c.\u0412. \u041b\u043e\u043c\u043e\u043d\u043e\u0441\u043e\u0432\u0430.
    \u041c\u0443\u0437\u0435\u0439 \u0438 \u043f\u0430\u043c\u044f\u0442\u044c: \u041e\u043d
    \u0441\u0442\u0430\u043b \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0431\u044b\u043b \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d \u043c\u0435\u043c\u043e\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043c\u0443\u0437\u0435\u0439 \u0432 \u0412\u0435\u043b\u0438\u043a\u0438\u0445 \u041b\u0443\u043a\u0430\u0445.
    \u0422\u0430\u043a\u0436\u0435 \u043d\u0430 \u0435\u0433\u043e \u0440\u043e\u0434\u0438\u043d\u0435
    \u0431\u044b\u043b \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d \u0431\u0440\u043e\u043d\u0437\u043e\u0432\u044b\u0439
    \u0431\u044e\u0441\u0442, \u0447\u0430\u0441\u0442\u044c \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u043e\u043f\u043b\u0430\u0442\u0438\u043b
    \u0441\u0430\u043c. \u0421\u043c\u0435\u0440\u0442\u044c: \u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    20 \u043c\u0430\u0440\u0442\u0430 1983 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435
    \u043d\u0430 92-\u043c \u0433\u043e\u0434\u0443 \u0436\u0438\u0437\u043d\u0438. \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043d\u0430 \u041d\u043e\u0432\u043e\u0434\u0435\u0432\u0438\u0447\u044c\u0435\u043c \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435."
  shortBioEn: "Ivan Matveevich Vinograd (1891–1983) is one of the most brilliant mathematicians in the 20th century, the creator of the trignometric method and the long-standing head of the Soviet mathematical school, whose life, full of scientific breakthroughs and rigid administration, has taken place against the backdrop of the most complex events of Russian history.\n\nOrigin and early years (1891–1914): The birth and family of Ivan Vinogradov was born on 2 (14) September 1891 in the village of Milolub of the village of the Great Luki District of Pskov District of Pskov, from a family of descendants of Orthodox priests; his father, Matthew Abrahamovich Vinogradov, was a village priest and ran a church and parish school.He was engaged in mathematics in those years, studying the higher subjects of the science himself, and in 1910 he joined the Faculty of Physics and Mathematics of the University of Petersburg, graduated in 1914 with glitter and was left at the university to prepare for his professorship, and his academic director was Professor J. V. Uspensky.\n\n==History==The beginning of the career and career: Taught at the University of Petrograd during the Civil War at the universities of Perm and Tomsk, and he became a professor in 1920, and his return to Leningrad: from 1920 to 1920, he was a professor at the Leningrad Polytechnic Institute and Leningrad University, where he worked until 1934.Acceptance: In 1929, at the age of 37, he was elected as an active member (academic) of the USSR Academy of Sciences.\n\nTriumph: The establishment of the trigonometric method (1934–1945) was the top of his scientific career, led by IIAN: In 1934, when the Academy of Sciences moved to Moscow, the Physico-Mathematic Institute was divided into two separate institutes, and the Vinograds were appointed director of the newly established V.A. Steel Institute (IIAN) and remained in office for almost 50 years, until his death.Main achievement: In 1937, Vinogradov created the so-called trigonometric method. This powerful tool allowed for a breakthrough in the most difficult tasks of the number theory. The solution to the Goldbach problem: In the same year 1937, he proved Goldbach's thorny problem, showing that any fairly large odd number could be presented as the sum of three primes.This task, which was set in the 18th century, has not been solved for more than 200 years, and the recognition of merit: \"The New Method in the Analytical Theory of Numbers\" in 1941 was awarded the Stalin Prize I. It is interesting that he became the first mathematician to receive the Award. In 1945 he was awarded the title of Hero of Socialist Labour.\n\nHe was not just a director, but a de facto head of Soviet mathematicians, he was a very well-known friend of the President of the USSR, M.V. Keldish, and his leadership of MIAN lasted 49 years, a unique case in the history of science.Independence and integrity: It is noteworthy that Vinogradov was never a member of the KPSS; he did not hide his origins, even in the era of fighting religion, and he had a reputation for pointing to the door of high-ranking officials; in 1955, he signed the famous \"Tripo 300\" against T.D. Lysenko's pseudoscience; charges of anti-Semitism: in the 1970s, the Academy of Sciences had a serious opposition to his leadership.The Vinogradov was repeatedly accused of being biased in dealing with personnel matters, in particular anti-Semitism and the deliberate expulsion of Jewish mathematicians from the institute, and of taking the will to power: despite these accusations and pressures, the Vinograds were able to retain their post. In 1977, at the General Assembly of the Soviet Union, about one third of the votes were cast against his re-election, but this was not enough to remove him.\n\nHe was able to raise a chair with a man sitting on it, holding him by his foot.\n\n===Recent years and legacy===In 1971, he also received the Golden Medal of the M.V. Lomonosov, a museum and memory: he was the only Soviet mathematician to have organized a memorial museum in the Great Lucas.His home country also had a bronze bust, which he had paid for, death: Ivan Matveevich Vinogradov died on 20 March 1983 in Moscow in the 92nd year of his life, buried in Novodevichy Cemetery."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0418\u0432\u0430\u043d\u0430 \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447\u0430
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430 \u0431\u044b\u043b\u0430
    \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u044f\u0440\u043a\u043e\u0439, \u0447\u0435\u043c
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f.
    \u041e\u043d \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0441
    \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c,
    \u043d\u0435\u0434\u044e\u0436\u0438\u043d\u043d\u043e\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u043b\u043e\u0439 \u0438 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0430\u043c\u044f\u0442\u044c\u044e, \u0438 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0434\u0435\u0442\u0430\u043b\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443
    \u0436\u0438\u0432\u043e\u0439 \u0438 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0449\u0435\u0439\u0441\u044f.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438\u0437 \u043d\u0438\u0445.\n\n\U0001F4AA \u0427\u0435\u043b\u043e\u0432\u0435\u043a-\u043b\u0435\u0433\u0435\u043d\u0434\u0430:
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0438\u043b\u0430 \u0438
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0430\u043c\u044f\u0442\u044c
    \u041d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0430\u044f \u0441\u0438\u043b\u0430:
    \u0412\u043d\u0435\u0448\u043d\u0435 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a \u0431\u044b\u043b
    \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0438 \u043a\u043e\u0440\u0435\u043d\u0430\u0441\u0442\u044b\u043c,
    \u043d\u043e \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435
    \u0431\u043e\u0433\u0430\u0442\u044b\u0440\u0441\u043a\u043e\u0439 \u0441\u0438\u043b\u043e\u0439.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u043c\u043e\u0433 \u043e\u0434\u043d\u043e\u0439 \u0440\u0443\u043a\u043e\u0439
    \u043f\u043e\u0434\u043d\u044f\u0442\u044c \u0441\u0442\u0443\u043b \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0441\u0438\u0434\u044f\u0449\u0438\u043c \u043d\u0430 \u043d\u0435\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u0434\u0435\u0440\u0436\u0430 \u0435\u0433\u043e \u0437\u0430 \u043d\u043e\u0436\u043a\u0443.
    \u0422\u0430\u043a\u0436\u0435 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u043c\u043e\u0433 \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443
    \u0437\u0430\u0442\u0430\u0449\u0438\u0442\u044c \u0440\u043e\u044f\u043b\u044c \u043f\u043e
    \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435 \u043d\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044b\u0439
    \u044d\u0442\u0430\u0436. \u042d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c: \u041f\u0430\u043c\u044f\u0442\u044c \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u043c \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u044f. \u041e\u043d \u043c\u043e\u0433
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e \u043d\u0430\u0437\u0432\u0430\u0442\u044c
    \u0434\u043b\u0438\u043d\u0443 \u0438 \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u0431\u0430\u0441\u0441\u0435\u0439\u043d\u0430
    \u043b\u044e\u0431\u043e\u0439 \u0440\u0435\u043a\u0438 \u043c\u0438\u0440\u0430, \u0430
    \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u043c\u043d\u0438\u043b \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c
    \u0442\u044b\u0441\u044f\u0447\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u0430\u0442.\n\n\U0001F3E1 \u041d\u0430\u0443\u043a\u0430, \u0432\u043b\u0430\u0441\u0442\u044c
    \u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \"\u0414\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\"
    \u0432 \u0431\u044b\u0442\u0443: \u0412 \u0442\u0435\u0441\u043d\u043e\u043c \u043a\u0440\u0443\u0433\u0443
    \u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0443 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432\u0430
    \u0431\u044b\u043b\u0430 \u0434\u0430\u0436\u0435 \u0441\u0432\u043e\u044f \u0437\u0430\u0431\u0430\u0432\u043d\u0430\u044f
    \u0438\u0433\u0440\u0430 \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c
    \u00ab\u0414\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u00bb. \u0421\u0443\u0442\u044c
    \u0435\u0435 \u0431\u044b\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u0430: \u0435\u0441\u043b\u0438
    \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u0447\u0442\u043e-\u0442\u043e \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0435
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u044b\u043d\u0435\u0441\u0442\u0438
    \u043c\u0443\u0441\u043e\u0440), \u0442\u043e\u0442, \u043a\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u043c
    \u043a\u0440\u0438\u0447\u0430\u043b \u00ab\u0414\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430!\u00bb,
    \u043f\u0435\u0440\u0435\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b \u044d\u0442\u0443
    \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u043e.
    \u0421\u0443\u0434\u044f \u043f\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u0432 \u044d\u0442\u043e\u0439
    \u0438\u0433\u0440\u0435 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a \u0440\u0435\u0434\u043a\u043e
    \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u043b. \u0413\u043e\u0440\u0434\u043e\u0441\u0442\u044c
    \u0437\u0430 \u0441\u0432\u043e\u0438 \u043a\u043e\u0440\u043d\u0438: \u0412 \u0433\u043e\u0434\u044b
    \u0441\u0442\u0430\u043b\u0438\u043d\u0441\u043a\u0438\u0445 \u0440\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0439,
    \u043a\u043e\u0433\u0434\u0430 \u043c\u043d\u043e\u0433\u0438\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0438
    \u0441\u0432\u043e\u0435 \u00ab\u043d\u0435\u043f\u0440\u043e\u043b\u0435\u0442\u0430\u0440\u0441\u043a\u043e\u0435\u00bb
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e \u043f\u0438\u0441\u0430\u043b \u0432 \u0430\u043d\u043a\u0435\u0442\u0430\u0445,
    \u0447\u0442\u043e \u043e\u043d \u0441\u044b\u043d \u0441\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430. \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b \u0432 \u041a\u041f\u0421\u0421
    \u0438, \u043f\u043e \u0441\u043b\u0443\u0445\u0430\u043c, \u043c\u043e\u0433 \u0431\u0435\u0437
    \u0441\u0442\u0435\u0441\u043d\u0435\u043d\u0438\u044f \u0432\u044b\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0438\u0437 \u0441\u0432\u043e\u0435\u0433\u043e \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430
    \u0432\u044b\u0441\u043e\u043a\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0445
    \u043f\u0430\u0440\u0442\u0438\u0439\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u043e\u0432.
    \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0441
    \u041b\u044b\u0441\u0435\u043d\u043a\u043e: \u0412 1955 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0435
    \u043c\u0443\u0436\u0435\u0441\u0442\u0432\u043e, \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u0432
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435 \u00ab\u041f\u0438\u0441\u044c\u043c\u043e
    \u0442\u0440\u0435\u0445\u0441\u043e\u0442\u00bb, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0440\u0430\u0437\u043e\u0431\u043b\u0430\u0447\u0430\u043b\u043e \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0422.\u0414.
    \u041b\u044b\u0441\u0435\u043d\u043a\u043e.\n\n\U0001F3AD \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u044b \u0428\u0443\u0442\u043b\u0438\u0432\u043e\u0435
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0445\u043e\u043b\u043e\u0441\u0442\u044f\u0446\u043a\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438: \u0418\u0432\u0430\u043d \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442
    \u0438 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u043e\u0436\u0438\u043b
    \u0441 \u0441\u0435\u0441\u0442\u0440\u043e\u0439 \u041d\u0430\u0434\u0435\u0436\u0434\u043e\u0439.
    \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0442\u043e\u043c, \u043f\u043e\u0447\u0435\u043c\u0443
    \u043e\u043d \u043d\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f, \u043e\u043d \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u043e
    \u043e\u0442\u0432\u0435\u0447\u0430\u043b, \u0447\u0442\u043e \u0434\u0435\u0432\u044f\u0442\u044c
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0432 \u0433\u043e\u0434\u0443 \u0435\u043c\u0443
    \u043d\u0435\u043a\u043e\u0433\u0434\u0430 \u0434\u0443\u043c\u0430\u0442\u044c \u043e \u043b\u044e\u0431\u0432\u0438,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b. \u0412 \u0448\u0443\u0442\u043a\u0443 \u043e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e
    \u043e\u043f\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0437\u043c\u0430 \u0436\u0435\u043d\u0449\u0438\u043d,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u0443\u0442 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c
    \u0431\u0440\u0430\u043a \u0441 \u0443\u0447\u0435\u043d\u044b\u043c \u043a\u0430\u043a
    \u00ab\u0432\u044b\u0433\u043e\u0434\u043d\u0443\u044e \u043f\u0430\u0440\u0442\u0438\u044e\u00bb.
    \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0444\u0430\u043c\u0438\u043b\u0438\u0438: \u0424\u0430\u043c\u0438\u043b\u0438\u044f
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u0438\u043c\u0435\u0435\u0442
    \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u043e\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446 \u0443\u0447\u0438\u043b\u0441\u044f \u0432
    \u0441\u0435\u043c\u0438\u043d\u0430\u0440\u0438\u0438, \u0433\u0434\u0435 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u0438\u043a\u0430\u043c
    \u0434\u0430\u0432\u0430\u043b\u0438 \u0444\u0430\u043c\u0438\u043b\u0438\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438
    \u043e\u0442 \u0443\u0441\u043f\u0435\u0432\u0430\u0435\u043c\u043e\u0441\u0442\u0438. \u041b\u0443\u0447\u0448\u0438\u0435
    \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u0438 \u00ab\u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u044b\u0435\u00bb
    \u0444\u0430\u043c\u0438\u043b\u0438\u0438 (\u041a\u0440\u0435\u0449\u0435\u043d\u0441\u043a\u0438\u0439,
    \u0412\u043e\u0437\u043d\u0435\u0441\u0435\u043d\u0441\u043a\u0438\u0439), \u0442\u0435,
    \u043a\u0442\u043e \u0443\u0447\u0438\u043b\u0441\u044f \u0445\u0443\u0436\u0435 \u2014
    \u00ab\u0446\u0432\u0435\u0442\u043e\u0447\u043d\u044b\u0435\u00bb (\u0413\u0438\u0430\u0446\u0438\u043d\u0442\u043e\u0432,
    \u0420\u043e\u0437\u043e\u0432). \u041d\u0438\u0437\u0448\u0435\u0439 \u0441\u0447\u0438\u0442\u0430\u043b\u0430\u0441\u044c
    \u00ab\u0444\u0440\u0443\u043a\u0442\u043e\u0432\u043e-\u044f\u0433\u043e\u0434\u043d\u0430\u044f\u00bb
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f. \u0424\u0430\u043c\u0438\u043b\u0438\u044f
    \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432 \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0430\u0441\u044c
    \u043a \u00ab\u0446\u0432\u0435\u0442\u043e\u0447\u043d\u043e\u0439\u00bb. \u0411\u044e\u0441\u0442
    \u0437\u0430 \u0441\u0432\u043e\u0439 \u0441\u0447\u0435\u0442: \u041a\u0430\u043a \u0434\u0432\u0430\u0436\u0434\u044b
    \u0413\u0435\u0440\u043e\u0439 \u0421\u043e\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0422\u0440\u0443\u0434\u0430 \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u0438\u043c\u0435\u043b \u043f\u0440\u0430\u0432\u043e \u043d\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443
    \u043f\u0440\u0438\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u0431\u0440\u043e\u043d\u0437\u043e\u0432\u043e\u0433\u043e
    \u0431\u044e\u0441\u0442\u0430 \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0443 \u0432\u043b\u0430\u0441\u0442\u0435\u0439 \u043d\u0435 \u043d\u0430\u0448\u043b\u043e\u0441\u044c
    \u043d\u0430 \u044d\u0442\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432. \u0422\u043e\u0433\u0434\u0430
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a \u0441\u0430\u043c \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e
    \u043e\u043f\u043b\u0430\u0442\u0438\u043b \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438 \u0431\u044b\u043b \u0442\u043e\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442 \u0432 \u0412\u0435\u043b\u0438\u043a\u0438\u0445 \u041b\u0443\u043a\u0430\u0445
    \u0432 1979 \u0433\u043e\u0434\u0443. \u041d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043e\u043d \u043d\u0435 \u043f\u043e\u0435\u0445\u0430\u043b, \u0442\u0430\u043a \u043a\u0430\u043a
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u044b \u043d\u0435 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438
    \u0435\u0433\u043e \u0441\u0435\u0441\u0442\u0440\u0443. \"\u041f\u043d\u0438 \u043a\u043e\u0440\u0447\u0443\u044e
    \u0440\u0443\u043a\u0430\u043c\u0438\": \u0412 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043e\u0432
    \u043b\u044e\u0431\u0438\u043b \u0432\u043e\u0437\u0438\u0442\u044c\u0441\u044f \u0432 \u0441\u0430\u0434\u0443
    \u0438 \u0446\u0432\u0435\u0442\u043d\u0438\u043a\u0435 \u043d\u0430 \u0441\u0432\u043e\u0435\u0439
    \u0434\u0430\u0447\u0435 \u0432 \u0410\u0431\u0440\u0430\u043c\u0446\u0435\u0432\u043e.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u043a\u0430\u043a \u043e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435,
    \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u041f\u043d\u0438 \u043a\u043e\u0440\u0447\u0443\u044e
    \u043d\u0430 \u0434\u0430\u0447\u0435\u00bb. \u0410 \u043d\u0430 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435,
    \u043b\u043e\u043c\u043e\u043c \u043b\u0438 \u043e\u043d \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442,
    \u0434\u043e\u0431\u0430\u0432\u0438\u043b: \u00ab\u041d\u0435\u0442, \u0440\u0443\u043a\u0430\u043c\u0438,
    \u043c\u043d\u0435 \u0431\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430 \u043f\u0435\u043d\u044c
    \u0443\u0445\u0432\u0430\u0442\u0438\u0442\u044c\u0441\u044f...\u00bb, \u0447\u0442\u043e
    \u0432\u043f\u043e\u043b\u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0443\u0435\u0442\u0441\u044f
    \u0441 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043c\u0438 \u043e \u0435\u0433\u043e
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u043b\u0435. \u042d\u0442\u0438
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u043e\u0431\u0440\u0430\u0437
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c,
    \u0441\u0438\u043b\u044c\u043d\u043e\u0439 \u0432\u043e\u043b\u0435\u0439 \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u043c
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u043c \u044e\u043c\u043e\u0440\u0430. \u041e\u043d
    \u0431\u044b\u043b \u0438 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445 \u0438 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0444\u0438\u0433\u0443\u0440 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438."
  interestingFactsEn: "Ivan Matveevich Vinogradov's life was as bright as his scientific achievements, he was a man of strong character, undozen physical strength and phenomenal memory, and his biography is full of amazing and funny details that make his personality truly alive and remembered, these are the most interesting of them.\n\nHuman legends: physical strength and phenomenal memory: The outside academic was small and coarse, but had truly rich power. Contemporarys remembered that he could raise a chair with one hand, holding it by the foot, and also said that he could pull a piano down the stairs to the fourth floor alone. Encyclopedia memory: Vinogradov's memory was admired separately.He could call the length and area of any river in the world, and he remembered thousands of historical dates by heart.\n\nScience, power, and principles of \"Disciplina\" in the home: In close association with Vinograd, there was even a funny game called \"Disciplina.\" Its essence was simple: if you had to do something unpleasant (e.g. take out garbage), the first person to shout \"Disciplina!\" transferred this duty to another, and according to the memory of the contemporarys, the academic rarely played in this game.Pride for his roots: In the years of Stalin repression, when many hid their \"non-Zaletar\" origin, Vinogradov openly wrote in the questionnaires that he was a son of a village priest, and he was never a member of the KPSS and was said to have been able to remove high-ranking party officials from his office without being embarrassed.In 1955, he showed civil courage by signing the famous Letter of Three hundred, which exposed the pseudo-scientific activities of T.J. Lysenko.\n\n* Personal life and chickens Jumpy explanation for bachelor life: Ivan Matveevich has never been married and has lived his whole life with Sister Hope. When asked why he had not married, he was smart to say that he had no time to think about love for nine months a year because he proved theorems. He also said that he was afraid of excessive pragmatism on the part of women who might consider marriage to a scientist as a \"favourable party\".The name: The name Vinogradov has an interesting origin; his father studied in a seminary where the graduates were given names according to their academic background; the best ones were given \"celebrity\" names (Kreshensky, Ascension), those who studied worse — \"color\" (Giacinths, Roses).The bust at its own expense: How twice the hero of the Socialist Work of Vinograd was entitled to a live bronze bust in his home country, but the authorities did not have the means to do so, and the academic himself paid part of the cost of making a monument that was inaugurated in the Great Lucas in 1979; he did not go to the opening because the organizers did not invite his sister.\"Ping with your hands.\" In his spare time, the Grapes liked to ride in the garden and the flowerhouse at his delivery in Abrahamtsevo.These stories are not just a great mathematician, but also a man with a unique character, strong will and a great sense of humor, and he has been and remains one of the brightest and most remembered figures in the history of Russian science."
