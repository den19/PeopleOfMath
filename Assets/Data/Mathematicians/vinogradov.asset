  achievementsRu: "\u0414\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u0418\u0432\u0430\u043D\u0430
    \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447\u0430 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430
    \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u2014 \u044D\u0442\u043E,
    \u043F\u043E \u0441\u0443\u0442\u0438, \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430, \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0432\u0448\u0435\u0433\u043E
    \u0440\u0435\u0448\u0438\u0442\u044C \u0437\u0430\u0434\u0430\u0447\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F\u043C\u0438 \u0441\u0447\u0438\u0442\u0430\u043B\u0438\u0441\u044C
    \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u043C\u0438. \u0415\u0433\u043E
    \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0432\u043A\u043B\u0430\u0434 \u2014
    **\u043C\u0435\u0442\u043E\u0434 \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0443\u043C\u043C**, \u0441\u0442\u0430\u0432\u0448\u0438\u0439 \u043E\u0441\u043D\u043E\u0432\u043E\u0439
    \u0434\u043B\u044F \u043F\u0440\u043E\u0440\u044B\u0432\u043E\u0432 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\u0445 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B.  ### \U0001F4D0 \u041C\u0435\u0442\u043E\u0434
    \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0443\u043C\u043C: \u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
    \u043A\u043B\u044E\u0447 \u043A \u0437\u0430\u0434\u0430\u0447\u0430\u043C \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B  \u0412 \u043E\u0441\u043D\u043E\u0432\u0435 \u043C\u0435\u0442\u043E\u0434\u0430
    \u043B\u0435\u0436\u0438\u0442 \u0438\u0434\u0435\u044F \u043F\u0435\u0440\u0435\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0438
    \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u043A\u043E-\u0447\u0438\u0441\u043B\u043E\u0432\u044B\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u043D\u0430 \u044F\u0437\u044B\u043A
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430. \u041C\u043D\u043E\u0433\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B \u0441\u0443\u043C\u043C\u0430\u043C\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0433\u043E
    \u0432\u0438\u0434\u0430 \u0438\u043B\u0438 \u043E \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0438
    \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u0447\u0438\u0441\u0435\u043B) \u043C\u043E\u0433\u0443\u0442
    \u0431\u044B\u0442\u044C \u043E\u043F\u0438\u0441\u0430\u043D\u044B \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0445
    \u0441\u0443\u043C\u043C. \u041C\u0435\u0442\u043E\u0434 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430
    \u0434\u0430\u043B \u043C\u043E\u0449\u043D\u044B\u0435 \u0438 \u043E\u0431\u0449\u0438\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u044B \u043E\u0446\u0435\u043D\u043A\u0438
    \u044D\u0442\u0438\u0445 \u0441\u0443\u043C\u043C, \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u043E
    \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u044C \u0433\u043B\u0430\u0432\u043D\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u0430 \u043E\u0442
    \u043E\u0448\u0438\u0431\u043A\u0438 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0442\u043E\u0447\u043D\u044B\u0435 \u0430\u0441\u0438\u043C\u043F\u0442\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0444\u043E\u0440\u043C\u0443\u043B\u044B.  \u042D\u0442\u043E\u0442 \u043F\u043E\u0434\u0445\u043E\u0434
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0448\u0438\u043B
    \u0441\u0442\u0430\u0440\u044B\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B,
    \u043D\u043E \u0438 \u043E\u0442\u043A\u0440\u044B\u043B \u043D\u043E\u0432\u044B\u0435
    \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u044B, \u043F\u043E\u0432\u043B\u0438\u044F\u0432
    \u043D\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0446\u0435\u043B\u044B\u0445
    \u0440\u0430\u0437\u0434\u0435\u043B\u043E\u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438. 
    ### \U0001F3AF \u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447: \u041E\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    \u0413\u043E\u043B\u044C\u0434\u0431\u0430\u0445\u0430 \u0434\u043E \u0412\u0430\u0440\u0438\u043D\u0433\u0430 
    *   **\u0422\u0435\u0440\u043D\u0430\u0440\u043D\u0430\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
    \u0413\u043E\u043B\u044C\u0434\u0431\u0430\u0445\u0430 (1937 \u0433.)**: \u042D\u0442\u043E,
    \u0431\u0435\u0437 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u044F, \u0441\u0430\u043C\u043E\u0435
    \u0433\u0440\u043E\u043C\u043A\u043E\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430. \u0412 1742
    \u0433\u043E\u0434\u0443 \u0413\u043E\u043B\u044C\u0434\u0431\u0430\u0445 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u043B,
    \u0447\u0442\u043E \u043B\u044E\u0431\u043E\u0435 \u043D\u0435\u0447\u0451\u0442\u043D\u043E\u0435
    \u0447\u0438\u0441\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435 5 \u043C\u043E\u0436\u043D\u043E
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u043A
    \u0441\u0443\u043C\u043C\u0443 \u0442\u0440\u0451\u0445 \u043F\u0440\u043E\u0441\u0442\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B. \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0434\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u044D\u0442\u043E
    \u0432\u0435\u0440\u043D\u043E \u0434\u043B\u044F **\u0432\u0441\u0435\u0445
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u0445**
    \u043D\u0435\u0447\u0451\u0442\u043D\u044B\u0445 \u0447\u0438\u0441\u0435\u043B.
    \u0415\u0433\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435
    \u0433\u0440\u0430\u043D\u0438\u0446\u044B \\( C \\), \u043F\u043E\u0441\u043B\u0435
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435
    \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F (\u043F\u043E\u0437\u0436\u0435
    \u044D\u0442\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0430 \u0431\u044B\u043B\u0430
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0430
    \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430\u043C\u0438). 
    *   **\u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0412\u0430\u0440\u0438\u043D\u0433\u0430
    (1934 \u0433.)**: \u041F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
    \u0432 1770 \u0433\u043E\u0434\u0443, \u043E\u043D\u0430 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \\( r \\) \u0441\u043B\u0430\u0433\u0430\u0435\u043C\u044B\u0445
    (\u0441\u0442\u0435\u043F\u0435\u043D\u0435\u0439 \\( n \\)) \u043D\u0443\u0436\u043D\u043E,
    \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u043B\u044E\u0431\u043E\u0435 \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u0447\u0438\u0441\u043B\u043E. \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0434\u043E\u0431\u0438\u043B\u0441\u044F \u0437\u0434\u0435\u0441\u044C \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432:     *   \u041E\u043D
    \u0434\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0434\u043B\u044F
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u0445
    \u0447\u0438\u0441\u0435\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    **\u043D\u0435 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C \\( 10 \\) \u043A\u0443\u0431\u043E\u0432**
    (\\( n=3 \\)).     *   \u0412 \u043E\u0431\u0449\u0435\u043C \u0432\u0438\u0434\u0435
    \u043E\u043D \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B \u043C\u043E\u0449\u043D\u0443\u044E
    \u043E\u0446\u0435\u043D\u043A\u0443 \u0434\u043B\u044F \\( G(n) \\) \u2014 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0447\u0438\u0441\u043B\u0430 \u0441\u043B\u0430\u0433\u0430\u0435\u043C\u044B\u0445:
    \\( G(n) < 6n \\ln n + 10n \\).     *   \u0422\u0430\u043A\u0436\u0435 \u043E\u043D
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0430\u0441\u0438\u043C\u043F\u0442\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443\u043B\u0443 \u0434\u043B\u044F \u0447\u0438\u0441\u043B\u0430
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439
    \u0447\u0438\u0441\u043B\u0430 \\( N \\) \u0432 \u0432\u0438\u0434\u0435 \u0441\u0443\u043C\u043C\u044B
    \\( r \\) \u0441\u0442\u0435\u043F\u0435\u043D\u0435\u0439, \u043A\u043E\u0433\u0434\u0430
    \\( r > 10 n^2 \\ln n \\). \u042D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442,
    \u0447\u0442\u043E \u043E\u043D \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0434\u043E\u043A\u0430\u0437\u0430\u043B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F,
    \u043D\u043E \u0438 \u043D\u0430\u0448\u0451\u043B, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0438\u0445 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E.  ### \U0001F4DA
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u0435
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B  *   **\u041E\u0446\u0435\u043D\u043A\u0438
    \u0441\u0443\u043C\u043C \u0412\u0435\u0439\u043B\u044F**: \u0417\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0443\u0441\u0438\u043B\u0438\u043B \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043E\u0446\u0435\u043D\u043A\u0438 \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430 \u0413\u0435\u0440\u043C\u0430\u043D\u0430
    \u0412\u0435\u0439\u043B\u044F \u0434\u043B\u044F \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0443\u043C\u043C \u0441 \u043C\u043D\u043E\u0433\u043E\u0447\u043B\u0435\u043D\u0430\u043C\u0438.
    \u0415\u0433\u043E \u043E\u0446\u0435\u043D\u043A\u0438, \u0438\u043C\u0435\u044E\u0449\u0438\u0435
    \u0432\u0438\u0434 \\( P^{1 - c / n^2 \\ln n} \\), \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0442\u043E\u0447\u043D\u0435\u0435,
    \u0447\u0435\u043C \\( P^{1 - c / 2^n} \\) \u0443 \u0412\u0435\u0439\u043B\u044F,
    \u0438 \u0441\u0442\u0430\u043B\u0438 \u043D\u0435\u0437\u0430\u043C\u0435\u043D\u0438\u043C\u044B\u043C
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C \u0432
    \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B. *   **\u0420\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u0447\u0438\u0441\u0435\u043B (1958
    \u0433.)**: \u0412\u043D\u0451\u0441 \u0432\u0430\u0436\u043D\u044B\u0439 \u0432\u043A\u043B\u0430\u0434
    \u0432 \u0443\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u0435 \u0444\u043E\u0440\u043C\u0443\u043B\u044B
    \u0434\u043B\u044F \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u0447\u0438\u0441\u0435\u043B, \u043D\u0435
    \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0445
    \\( x \\), \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0432 \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u044B\u0439
    \u0447\u043B\u0435\u043D \u0432 \u0444\u043E\u0440\u043C\u0443\u043B\u0435 \\(
    \\pi(x) = \\int_0^x \\frac{du}{\\ln u} + O(x e^{-a(\\ln x)^\\beta}) \\). *  
    **\u041E\u0446\u0435\u043D\u043A\u0430 \u0441\u0443\u043C\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u0432**:
    \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043C\u0435\u0442\u043E\u0434 \u043E\u0446\u0435\u043D\u043A\u0438 \u0441\u0443\u043C\u043C
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u0432 \u0414\u0438\u0440\u0438\u0445\u043B\u0435
    \u043F\u043E \u043F\u0440\u043E\u0441\u0442\u044B\u043C \u0447\u0438\u0441\u043B\u0430\u043C.
    \u0415\u0433\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0438\u043B\u0451\u043D,
    \u0447\u0442\u043E \u0435\u0433\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u0431\u044B\u043B\u043E \u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0434\u0430\u0436\u0435 \u0438\u0437 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u043D\u043E\u0439
    \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B \u0420\u0438\u043C\u0430\u043D\u0430. 
    ### \U0001F58B\uFE0F \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0442\u0440\u0443\u0434\u044B 
    \u041F\u043E\u043C\u0438\u043C\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u0445
    \u0441\u0442\u0430\u0442\u0435\u0439, \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u0431\u044F
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u043C\u043E\u043D\u043E\u0433\u0440\u0430\u0444\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0441\u043B\u0443\u0436\u0430\u0442
    \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u044B\u043C\u0438 \u043A\u043D\u0438\u0433\u0430\u043C\u0438
    \u0434\u043B\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u043E\u0432: 
    *   **\xAB\u041C\u0435\u0442\u043E\u0434 \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0443\u043C\u043C \u0432 \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B\xBB**
    (\u043C\u043D\u043E\u0433\u043E\u043A\u0440\u0430\u0442\u043D\u043E \u043F\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044C)
    \u2014 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0442\u0440\u0443\u0434, \u0433\u0434\u0435
    \u043C\u0435\u0442\u043E\u0434 \u0438\u0437\u043B\u043E\u0436\u0435\u043D \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.
    *   **\xAB\u041E\u0441\u043D\u043E\u0432\u044B \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B\xBB** \u2014 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0443\u0447\u0435\u0431\u043D\u0438\u043A, \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0432\u0448\u0438\u0439
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0438\u0437\u0434\u0430\u043D\u0438\u0439
    \u0438 \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439
    \u043D\u0430 \u043C\u043D\u043E\u0433\u0438\u0435 \u044F\u0437\u044B\u043A\u0438,
    \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u0443\u0447\u0438\u043B\u0438\u0441\u044C
    \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432.
    *   **\xAB\u0418\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0442\u0440\u0443\u0434\u044B\xBB**
    (1952) \u0438 **\xAB\u041E\u0441\u043E\u0431\u044B\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B
    \u043C\u0435\u0442\u043E\u0434\u0430 \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0443\u043C\u043C\xBB**."
  achievementsEn: 
  personalLifeRu: "\u0418\u0432\u0430\u043D \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432 \u043F\u0440\u043E\u0436\u0438\u043B
    \u0434\u043E\u043B\u0433\u0443\u044E \u0438 \u044F\u0440\u043A\u0443\u044E \u0436\u0438\u0437\u043D\u044C,
    \u0446\u0435\u043B\u0438\u043A\u043E\u043C \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0443\u044E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435. \u041E\u043D \u043F\u0440\u043E\u0448\u0435\u043B
    \u043F\u0443\u0442\u044C \u043E\u0442 \u0441\u044B\u043D\u0430 \u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
    \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u0430 \u0434\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043D\u043E\u0433\u043E
    \u0433\u043B\u0430\u0432\u044B \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0448\u043A\u043E\u043B\u044B, \u0438 \u0435\u0433\u043E \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u043F\u0440\u043E\u0440\u044B\u0432\u043E\u0432,
    \u043D\u043E \u0438 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u044D\u043F\u043E\u0445\u0438
    \u0441 \u0435\u0451 \u0441\u043B\u043E\u0436\u043D\u044B\u043C\u0438, \u0430
    \u043F\u043E\u0440\u043E\u0439 \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0432\u044B\u043C\u0438,
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u043C\u0438.  \u041D\u0438\u0436\u0435,
    \u0441 \u043E\u043F\u043E\u0440\u043E\u0439 \u043D\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438, \u044F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F
    \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u0432\u0435\u0445\u0438 \u0438 \u0434\u0435\u0442\u0430\u043B\u0438 \u0435\u0433\u043E
    \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0438. 
    ### \U0001F468\u200D\U0001F466 \u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435,
    \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0438 \u0441\u0435\u043C\u044C\u044F 
    \u0418\u0432\u0430\u043D \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432 \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    2 (14) \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F 1891 \u0433\u043E\u0434\u0430
    \u0432 \u0441\u0435\u043B\u0435 \u041C\u0438\u043B\u043E\u043B\u044E\u0431 \u0412\u0435\u043B\u0438\u043A\u043E\u043B\u0443\u043A\u0441\u043A\u043E\u0433\u043E
    \u0443\u0435\u0437\u0434\u0430 \u041F\u0441\u043A\u043E\u0432\u0441\u043A\u043E\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438. \u0415\u0433\u043E \u043E\u0442\u0435\u0446,
    \u041C\u0430\u0442\u0432\u0435\u0439 \u0410\u0432\u0440\u0430\u0430\u043C\u043E\u0432\u0438\u0447,
    \u0431\u044B\u043B \u0441\u0435\u043B\u044C\u0441\u043A\u0438\u043C \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u043E\u043C. 
    \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E, \u043D\u043E
    \u044D\u0442\u043E\u0442 \u0444\u0430\u043A\u0442 \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u043B
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0443 \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u043A\u0430\u0440\u044C\u0435\u0440\u0443 \u0432 \u0430\u0442\u0435\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u043C \u0421\u043E\u044E\u0437\u0435,
    \u043D\u043E \u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
    \u0441\u0432\u043E\u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F. 
    \u0421\u0430\u043C \u0418\u0432\u0430\u043D \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B \u0436\u0435\u043D\u0430\u0442.
    \u0412\u0441\u044E \u0436\u0438\u0437\u043D\u044C \u043E\u043D \u043F\u0440\u043E\u0436\u0438\u043B
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u0441\u0432\u043E\u0435\u0439
    \u0441\u0435\u0441\u0442\u0440\u043E\u0439 \u041D\u0430\u0434\u0435\u0436\u0434\u043E\u0439
    \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u043D\u043E\u0439 , \u0438 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
    \u0443\u0447\u0435\u043D\u0438\u043A\u0438 \u0437\u0430\u043C\u0435\u043D\u044F\u043B\u0438
    \u0435\u043C\u0443 \u0441\u0435\u043C\u044C\u044E. \u0412 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u043E\u043D \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C
    \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F
    \u0441\u0430\u0434\u043E\u043C \u0438 \u0446\u0432\u0435\u0442\u0430\u043C\u0438
    \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u0434\u0430\u0447\u0435 \u0432 \u0410\u0431\u0440\u0430\u043C\u0446\u0435\u0432\u043E. 
    ### \U0001F393 \u0423\u0447\u0451\u0431\u0430, \u043D\u0430\u0443\u043A\u0430
    \u0438 \u043A\u0430\u0440\u044C\u0435\u0440\u0430  \u041F\u043E\u0441\u043B\u0435
    \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0443\u0447\u0438\u043B\u0438\u0449\u0430 \u0432 \u0412\u0435\u043B\u0438\u043A\u0438\u0445
    \u041B\u0443\u043A\u0430\u0445 \u0432 1910 \u0433\u043E\u0434\u0443, \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0430 \u0444\u0438\u0437\u0438\u043A\u043E-\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442 \u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0422\u0430\u043C
    \u043E\u043D \u0443\u0432\u043B\u0435\u043A\u0441\u044F \u0442\u0435\u043E\u0440\u0438\u0435\u0439
    \u0447\u0438\u0441\u0435\u043B. \u0412 1914 \u0433\u043E\u0434\u0443 \u043E\u043D
    \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435 \u043E\u043A\u043E\u043D\u0447\u0438\u043B
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0441\u0432\u043E\u0438\u043C \u0443\u0441\u043F\u0435\u0445\u0430\u043C, \u0431\u044B\u043B
    \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u043F\u0440\u0438 \u043D\u0435\u043C
    \u0434\u043B\u044F \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438
    \u043A \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0441\u043A\u043E\u043C\u0443
    \u0437\u0432\u0430\u043D\u0438\u044E. \u0415\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u043C
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u043C
    \u0431\u044B\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u042F.\u0412.
    \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u0438\u0439.  \u0414\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439
    \u043F\u0443\u0442\u044C \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430
    \u0441\u043E\u0432\u043F\u0430\u043B \u0441 \u0431\u0443\u0440\u043D\u044B\u043C\u0438
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438: *   **\u0413\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0430\u044F
    \u0432\u043E\u0439\u043D\u0430 \u0438 \u0440\u0430\u0431\u043E\u0442\u0430 \u0432
    \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438 (1918\u20131920):** \u0412
    \u0433\u043E\u0434\u044B \u0413\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B \u0432 \u041F\u0435\u0440\u043C\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0430
    \u0441 1920 \u0433\u043E\u0434\u0430 \u2014 \u0432 \u0422\u043E\u043C\u0441\u043A\u043E\u043C.
    *   **\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0432
    \u041F\u0435\u0442\u0440\u043E\u0433\u0440\u0430\u0434 (1920\u20131934):** \u0417\u0434\u0435\u0441\u044C
    \u043E\u043D \u0441\u0442\u0430\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0438
    \u041F\u043E\u043B\u0438\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430. \u0412 1929 \u0433\u043E\u0434\u0443,
    \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 37 \u043B\u0435\u0442,
    \u043E\u043D \u0431\u044B\u043B \u0438\u0437\u0431\u0440\u0430\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0447\u043B\u0435\u043D\u043E\u043C \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438
    \u043D\u0430\u0443\u043A \u0421\u0421\u0421\u0420. *   **\u041F\u0435\u0440\u0435\u0435\u0437\u0434
    \u0432 \u041C\u043E\u0441\u043A\u0432\u0443 \u0438 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u041C\u0418\u0410\u041D (1934\u20131983):** 1934 \u0433\u043E\u0434 \u0441\u0442\u0430\u043B
    \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0432 \u0435\u0433\u043E
    \u043A\u0430\u0440\u044C\u0435\u0440\u0435. \u0412 \u0441\u0432\u044F\u0437\u0438
    \u0441 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u043E\u043C \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438
    \u043D\u0430\u0443\u043A \u0432 \u041C\u043E\u0441\u043A\u0432\u0443 \u0424\u0438\u0437\u0438\u043A\u043E-\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u0431\u044B\u043B \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D,
    \u0438 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432 \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u0438\u043B
    \u0432\u043D\u043E\u0432\u044C \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439
    \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u0438\u043C\u0435\u043D\u0438
    \u0412.\u0410. \u0421\u0442\u0435\u043A\u043B\u043E\u0432\u0430 (\u041C\u0418\u0410\u041D).
    \u041E\u043D \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u043B \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u043E\u043C
    \u043F\u043E\u0447\u0442\u0438 50 \u043B\u0435\u0442, \u0434\u043E \u0441\u0430\u043C\u043E\u0439
    \u0441\u043C\u0435\u0440\u0442\u0438 , \u0441 \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u043E\u043C
    \u043D\u0430 \u0433\u043E\u0434\u044B \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u0438
    \u0432 \u041A\u0430\u0437\u0430\u043D\u044C (1941\u20131944) \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B.  ### \U0001F91D \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
    \u0441 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438: \u0434\u0440\u0443\u0436\u0431\u0430
    \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u044F 
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432 \u0431\u044B\u043B
    \u0444\u0438\u0433\u0443\u0440\u043E\u0439 \u0441\u043B\u043E\u0436\u043D\u043E\u0439
    \u0438 \u043D\u0435\u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u043E\u0439. 
    \u0421 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
    \u043E\u043D \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B
    \u0442\u0435\u0441\u043D\u044B\u0435, \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u0438\u0435
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043C\u0438
    \u0443\u0447\u0435\u043D\u044B\u043C\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438,
    \u0441 \u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u043E\u043C \u0410\u041D
    \u0421\u0421\u0421\u0420 \u041C.\u0412. \u041A\u0435\u043B\u0434\u044B\u0448\u0435\u043C
    \u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C \u041C.\u0410.
    \u041B\u0430\u0432\u0440\u0435\u043D\u0442\u044C\u0435\u0432\u044B\u043C. \u041E\u043D
    \u0431\u044B\u043B \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u044B\u043C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C: \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043B \u0432 \u041A\u041F\u0421\u0421 
    \u0438 \u0432 1955 \u0433\u043E\u0434\u0443 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0435 \xAB\u041F\u0438\u0441\u044C\u043C\u043E
    \u0442\u0440\u0435\u0445\u0441\u043E\u0442\xBB \u043F\u0440\u043E\u0442\u0438\u0432
    \u043B\u044B\u0441\u0435\u043D\u043A\u043E\u0432\u0449\u0438\u043D\u044B.  \u0421
    \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
    \u0432 1970-\u0435 \u0433\u043E\u0434\u044B \u0432 \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438
    \u043D\u0430\u0443\u043A \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u0430 \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u0430\u044F
    \u043E\u043F\u043F\u043E\u0437\u0438\u0446\u0438\u044F \u0435\u0433\u043E \u043B\u0438\u0434\u0435\u0440\u0441\u0442\u0432\u0443.
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430 \u043E\u0431\u0432\u0438\u043D\u044F\u043B\u0438
    \u0432 \u043D\u0435\u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u043F\u0440\u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u0438 \u043A\u0430\u0434\u0440\u043E\u0432\u044B\u0445
    \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432 \u0438, \u0447\u0442\u043E \u0441\u0430\u043C\u043E\u0435
    \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E\u0435, \u0432 \u0430\u043D\u0442\u0438\u0441\u0435\u043C\u0438\u0442\u0438\u0437\u043C\u0435
    \u2014 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u043E\u043D \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u043A\u0430\u0440\u044C\u0435\u0440\u043D\u043E\u043C\u0443 \u0440\u043E\u0441\u0442\u0443
    \u0443\u0447\u0435\u043D\u044B\u0445-\u0435\u0432\u0440\u0435\u0435\u0432. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u044D\u0442\u0438 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F
    \u0438 \u0442\u0430\u0439\u043D\u043E\u0435 \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432 1977 \u0433\u043E\u0434\u0443, \u0433\u0434\u0435 \u043E\u043A\u043E\u043B\u043E
    \u0442\u0440\u0435\u0442\u0438 \u0433\u043E\u043B\u043E\u0441\u043E\u0432 \u0431\u044B\u043B\u043E
    \u043F\u043E\u0434\u0430\u043D\u043E \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0435\u0433\u043E,
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B
    \u043F\u043E\u0441\u0442 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430
    \u041C\u0418\u0410\u041D.  ### \U0001F54A\uFE0F \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B \u0438 \u0441\u043C\u0435\u0440\u0442\u044C  \u0418\u0432\u0430\u043D
    \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F 20 \u043C\u0430\u0440\u0442\u0430
    1983 \u0433\u043E\u0434\u0430 \u0432 \u041C\u043E\u0441\u043A\u0432\u0435 \u043D\u0430
    92-\u043C \u0433\u043E\u0434\u0443 \u0436\u0438\u0437\u043D\u0438. \u041E\u043D
    \u0431\u044B\u043B \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0435\u043D \u043D\u0430
    \u041D\u043E\u0432\u043E\u0434\u0435\u0432\u0438\u0447\u044C\u0435\u043C \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435. 
    \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u2014 \u043F\u0440\u0438\u043C\u0435\u0440
    \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0439 \u043F\u0440\u0435\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438
    \u043D\u0430\u0443\u043A\u0435, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u043E\u0447\u0435\u0442\u0430\u043B\u0430\u0441\u044C
    \u0441 \u0441\u0438\u043B\u044C\u043D\u044B\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C
    \u0438 \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0432\u043E\u043B\u0435\u0439, \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0432\u0448\u0435\u0439
    \u0435\u043C\u0443 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
    \u0443 \u0440\u0443\u043B\u044F \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0441\u0442\u0440\u0430\u043D\u044B
    \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u043E\u0447\u0442\u0438
    \u043F\u043E\u043B\u0443\u0432\u0435\u043A\u0430."
  personalLifeEn: 
  shortBioRu: "\u0418\u0432\u0430\u043D \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432 (1891\u20131983)
    \u2014 \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u044F\u0440\u043A\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 XX \u0432\u0435\u043A\u0430,
    \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C \u043C\u0435\u0442\u043E\u0434\u0430
    \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0443\u043C\u043C \u0438 \u043C\u043D\u043E\u0433\u043E\u043B\u0435\u0442\u043D\u0438\u0439
    \u0433\u043B\u0430\u0432\u0430 \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0448\u043A\u043E\u043B\u044B. \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C,
    \u043F\u043E\u043B\u043D\u0430\u044F \u043D\u0430\u0443\u0447\u043D\u044B\u0445
    \u043F\u0440\u043E\u0440\u044B\u0432\u043E\u0432 \u0438 \u0436\u0435\u0441\u0442\u043A\u043E\u0433\u043E
    \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F,
    \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B\u0430\u0441\u044C
    \u043D\u0430 \u0444\u043E\u043D\u0435 \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u0445
    \u0441\u043E\u0431\u044B\u0442\u0438\u0439 \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439
    \u0438\u0441\u0442\u043E\u0440\u0438\u0438.  \u041D\u0438\u0436\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
    \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u0432\u0435\u0445\u0438 \u0435\u0433\u043E
    \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438, \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
    \u0432 \u0445\u0440\u043E\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u043F\u043E\u0440\u044F\u0434\u043A\u0435.  ### \U0001F4DC \u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0438 \u0440\u0430\u043D\u043D\u0438\u0435 \u0433\u043E\u0434\u044B (1891\u20131914) 
    *   **\u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0438 \u0441\u0435\u043C\u044C\u044F:**
    \u0418\u0432\u0430\u043D \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0440\u043E\u0434\u0438\u043B\u0441\u044F 2 (14) \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F
    1891 \u0433\u043E\u0434\u0430 \u0432 \u0441\u0435\u043B\u0435 \u041C\u0438\u043B\u043E\u043B\u044E\u0431
    \u0412\u0435\u043B\u0438\u043A\u043E\u043B\u0443\u043A\u0441\u043A\u043E\u0433\u043E
    \u0443\u0435\u0437\u0434\u0430 \u041F\u0441\u043A\u043E\u0432\u0441\u043A\u043E\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438. \u041E\u043D \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B
    \u0438\u0437 \u0441\u0435\u043C\u044C\u0438 \u043F\u043E\u0442\u043E\u043C\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0445 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u043E\u0432;
    \u0435\u0433\u043E \u043E\u0442\u0435\u0446, \u041C\u0430\u0442\u0444\u0435\u0439
    \u0410\u0432\u0440\u0430\u0430\u043C\u043E\u0432\u0438\u0447 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432,
    \u0431\u044B\u043B \u0441\u0435\u043B\u044C\u0441\u043A\u0438\u043C \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u043E\u043C
    \u0438 \u0437\u0430\u0432\u0435\u0434\u043E\u0432\u0430\u043B \u0446\u0435\u0440\u043A\u043E\u0432\u043D\u043E-\u043F\u0440\u0438\u0445\u043E\u0434\u0441\u043A\u043E\u0439
    \u0448\u043A\u043E\u043B\u043E\u0439. *   **\u0421\u0440\u0435\u0434\u043D\u0435\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435:** \u0423\u0447\u0438\u043B\u0441\u044F
    \u0432 \u0412\u0435\u043B\u0438\u043A\u043E\u043B\u0443\u043A\u0441\u043A\u043E\u043C
    \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C \u0443\u0447\u0438\u043B\u0438\u0449\u0435,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043E\u043A\u043E\u043D\u0447\u0438\u043B
    \u0432 1910 \u0433\u043E\u0434\u0443. \u0423\u0436\u0435 \u0432 \u044D\u0442\u0438
    \u0433\u043E\u0434\u044B \u043E\u043D \u0443\u0432\u043B\u0435\u043A\u0441\u044F
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0439, \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u0438\u0437\u0443\u0447\u0430\u044F \u0432\u044B\u0441\u0448\u0438\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u044B
    \u044D\u0442\u043E\u0439 \u043D\u0430\u0443\u043A\u0438. *   **\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043A\u0438\u0435
    \u0433\u043E\u0434\u044B:** \u0412 1910 \u0433\u043E\u0434\u0443 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u043D\u0430 \u0444\u0438\u0437\u0438\u043A\u043E-\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442 \u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u041E\u043A\u043E\u043D\u0447\u0438\u043B
    \u0435\u0433\u043E \u0432 1914 \u0433\u043E\u0434\u0443 \u0441 \u0431\u043B\u0435\u0441\u043A\u043E\u043C
    \u0438 \u0431\u044B\u043B \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u043F\u0440\u0438
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0434\u043B\u044F
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u043A \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0441\u043A\u043E\u043C\u0443
    \u0437\u0432\u0430\u043D\u0438\u044E. \u0415\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u043C
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u043C
    \u0431\u044B\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u042F.
    \u0412. \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u0438\u0439.  ### \U0001F4DA
    \u0421\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0443\u0447\u0435\u043D\u043E\u0433\u043E
    \u0438 \u043F\u0435\u0440\u0432\u044B\u0435 \u0448\u0430\u0433\u0438 \u0432 \u043D\u0430\u0443\u043A\u0435
    (1914\u20131934)  *   **\u041D\u0430\u0447\u0430\u043B\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u044B
    \u0438 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0443\u0440\u0430:** \u041F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B
    \u0432 \u041F\u0435\u0442\u0440\u043E\u0433\u0440\u0430\u0434\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0412
    \u0433\u043E\u0434\u044B \u0413\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432
    \u041F\u0435\u0440\u043C\u0441\u043A\u043E\u043C \u0438 \u0422\u043E\u043C\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u0445.
    \u0412 1920 \u0433\u043E\u0434\u0443 \u043E\u043D \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C. *   **\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u0432 \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434:** \u0421 1920
    \u0433\u043E\u0434\u0430 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u2014 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u043B\u0438\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0438 \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u0433\u0434\u0435
    \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0434\u043E 1934
    \u0433\u043E\u0434\u0430. *   **\u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435:**
    \u0412 1929 \u0433\u043E\u0434\u0443, \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    37 \u043B\u0435\u0442, \u043E\u043D \u0431\u044B\u043B \u0438\u0437\u0431\u0440\u0430\u043D
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0447\u043B\u0435\u043D\u043E\u043C (\u0430\u043A\u0430\u0434\u0435\u043C\u0438\u043A\u043E\u043C)
    \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438 \u043D\u0430\u0443\u043A \u0421\u0421\u0421\u0420. 
    ### \U0001F52C \u0422\u0440\u0438\u0443\u043C\u0444: \u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u043C\u0435\u0442\u043E\u0434\u0430 \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0443\u043C\u043C (1934\u20131945)  \u042D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434
    \u0441\u0442\u0430\u043B \u0432\u0435\u0440\u0448\u0438\u043D\u043E\u0439 \u0435\u0433\u043E
    \u043D\u0430\u0443\u0447\u043D\u043E\u0439 \u043A\u0430\u0440\u044C\u0435\u0440\u044B. 
    *   **\u0412\u043E \u0433\u043B\u0430\u0432\u0435 \u041C\u0418\u0410\u041D:**
    \u0412 1934 \u0433\u043E\u0434\u0443, \u043A\u043E\u0433\u0434\u0430 \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u044F
    \u043D\u0430\u0443\u043A \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043B\u0430
    \u0432 \u041C\u043E\u0441\u043A\u0432\u0443, \u0424\u0438\u0437\u0438\u043A\u043E-\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u0431\u044B\u043B \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D
    \u043D\u0430 \u0434\u0432\u0430 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430. \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0431\u044B\u043B \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u043E\u043C
    \u0432\u043D\u043E\u0432\u044C \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0438\u043C. \u0412.\u0410.
    \u0421\u0442\u0435\u043A\u043B\u043E\u0432\u0430 (\u041C\u0418\u0410\u041D) \u0438
    \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u043D\u0430 \u044D\u0442\u043E\u043C
    \u043F\u043E\u0441\u0442\u0443 \u043F\u043E\u0447\u0442\u0438 50 \u043B\u0435\u0442,
    \u0434\u043E \u0441\u0430\u043C\u043E\u0439 \u0441\u043C\u0435\u0440\u0442\u0438.
    *   **\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435:**
    \u0412 1937 \u0433\u043E\u0434\u0443 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0441\u043E\u0437\u0434\u0430\u043B \u0442\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u044B\u0439
    **\u043C\u0435\u0442\u043E\u0434 \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0443\u043C\u043C**. \u042D\u0442\u043E\u0442 \u043C\u043E\u0449\u043D\u044B\u0439
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0440\u043E\u0440\u044B\u0432
    \u0432 \u0441\u0430\u043C\u044B\u0445 \u0441\u043B\u043E\u0436\u043D\u044B\u0445
    \u0437\u0430\u0434\u0430\u0447\u0430\u0445 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B. *   **\u0420\u0435\u0448\u0435\u043D\u0438\u0435
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0413\u043E\u043B\u044C\u0434\u0431\u0430\u0445\u0430:**
    \u0412 \u0442\u043E\u043C \u0436\u0435 1937 \u0433\u043E\u0434\u0443 \u043E\u043D
    \u0434\u043E\u043A\u0430\u0437\u0430\u043B **\u0442\u0435\u0440\u043D\u0430\u0440\u043D\u0443\u044E
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443 \u0413\u043E\u043B\u044C\u0434\u0431\u0430\u0445\u0430**,
    \u043F\u043E\u043A\u0430\u0437\u0430\u0432, \u0447\u0442\u043E \u043B\u044E\u0431\u043E\u0435
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0435
    \u043D\u0435\u0447\u0435\u0442\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E
    \u043A\u0430\u043A \u0441\u0443\u043C\u043C\u0430 \u0442\u0440\u0435\u0445 \u043F\u0440\u043E\u0441\u0442\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B. \u042D\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430,
    \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u0435\u0449\u0435
    \u0432 XVIII \u0432\u0435\u043A\u0435, \u0431\u043E\u043B\u0435\u0435 200 \u043B\u0435\u0442
    \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044C
    \u0440\u0435\u0448\u0435\u043D\u0438\u044E. *   **\u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435
    \u0437\u0430\u0441\u043B\u0443\u0433:** \u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443
    \xAB\u041D\u043E\u0432\u044B\u0439 \u043C\u0435\u0442\u043E\u0434 \u0432 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B\xBB \u0432
    1941 \u0433\u043E\u0434\u0443 \u043E\u043D \u0431\u044B\u043B \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D
    \u0421\u0442\u0430\u043B\u0438\u043D\u0441\u043A\u043E\u0439 \u043F\u0440\u0435\u043C\u0438\u0438
    I \u0441\u0442\u0435\u043F\u0435\u043D\u0438. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
    \u0447\u0442\u043E \u043E\u043D \u0441\u0442\u0430\u043B \u043F\u0435\u0440\u0432\u044B\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C, \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0438\u043C
    \u044D\u0442\u0443 \u043F\u0440\u0435\u043C\u0438\u044E. \u0412 1945 \u0433\u043E\u0434\u0443
    \u0435\u043C\u0443 \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u0441\u0432\u043E\u0435\u043D\u043E
    \u0437\u0432\u0430\u043D\u0438\u0435 \u0413\u0435\u0440\u043E\u044F \u0421\u043E\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0422\u0440\u0443\u0434\u0430.  ### \u2696\uFE0F \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440,
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u044F
    (1945\u20131983)  \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0431\u044B\u043B \u0444\u0438\u0433\u0443\u0440\u043E\u0439 \u0441\u043B\u043E\u0436\u043D\u043E\u0439
    \u0438 \u043D\u0435\u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u043E\u0439. 
    *   **\u0412\u043B\u0430\u0441\u0442\u044C \u0438 \u0434\u043E\u043B\u0433\u043E\u043B\u0435\u0442\u0438\u0435:**
    \u041E\u043D \u0431\u044B\u043B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u043E\u043C, \u0430 \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0433\u043B\u0430\u0432\u043E\u0439 \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432, \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
    \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442\u043E\u043C
    \u0432 \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438 \u043D\u0430\u0443\u043A
    \u0438 \u0431\u044B\u043B \u0431\u043B\u0438\u0437\u043A\u0438\u043C \u0434\u0440\u0443\u0433\u043E\u043C
    \u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u0430 \u0410\u041D \u0421\u0421\u0421\u0420
    \u041C.\u0412. \u041A\u0435\u043B\u0434\u044B\u0448\u0430. \u0415\u0433\u043E
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u041C\u0418\u0410\u041D\u043E\u043C
    \u0434\u043B\u0438\u043B\u043E\u0441\u044C 49 \u043B\u0435\u0442, \u0447\u0442\u043E
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u043B\u0443\u0447\u0430\u0435\u043C \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u043D\u0430\u0443\u043A\u0438. *   **\u041D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C
    \u0438 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C:**
    \u041F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0447\u0442\u043E \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B \u0447\u043B\u0435\u043D\u043E\u043C
    \u041A\u041F\u0421\u0421. \u041E\u043D \u043D\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u043B
    \u0441\u0432\u043E\u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F,
    \u0434\u0430\u0436\u0435 \u0432 \u044D\u043F\u043E\u0445\u0443 \u0431\u043E\u0440\u044C\u0431\u044B
    \u0441 \u0440\u0435\u043B\u0438\u0433\u0438\u0435\u0439, \u0438 \u0438\u043C\u0435\u043B
    \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0433 \u0443\u043A\u0430\u0437\u0430\u0442\u044C
    \u043D\u0430 \u0434\u0432\u0435\u0440\u044C \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u043C
    \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u0430\u043C. \u0412
    1955 \u0433\u043E\u0434\u0443 \u043E\u043D \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0435 \xAB\u041F\u0438\u0441\u044C\u043C\u043E
    \u0442\u0440\u0435\u0445\u0441\u043E\u0442\xBB \u043F\u0440\u043E\u0442\u0438\u0432
    \u043F\u0441\u0435\u0432\u0434\u043E\u043D\u0430\u0443\u0447\u043D\u043E\u0439
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0422.\u0414.
    \u041B\u044B\u0441\u0435\u043D\u043A\u043E. *   **\u041E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F
    \u0432 \u0430\u043D\u0442\u0438\u0441\u0435\u043C\u0438\u0442\u0438\u0437\u043C\u0435:**
    \u0412 1970-\u0435 \u0433\u043E\u0434\u044B \u0432 \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438
    \u043D\u0430\u0443\u043A \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u0430 \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u0430\u044F
    \u043E\u043F\u043F\u043E\u0437\u0438\u0446\u0438\u044F \u0435\u0433\u043E \u043B\u0438\u0434\u0435\u0440\u0441\u0442\u0432\u0443.
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430 \u043D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E
    \u043E\u0431\u0432\u0438\u043D\u044F\u043B\u0438 \u0432 \u043D\u0435\u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u043F\u0440\u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u0438 \u043A\u0430\u0434\u0440\u043E\u0432\u044B\u0445
    \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432, \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438,
    \u0432 \u0430\u043D\u0442\u0438\u0441\u0435\u043C\u0438\u0442\u0438\u0437\u043C\u0435
    \u0438 \u0446\u0435\u043B\u0435\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u043C
    \u0438\u0437\u0433\u043D\u0430\u043D\u0438\u0438 \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 \u0438\u0437
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430. *   **\u0412\u043E\u043B\u044F
    \u043A \u0432\u043B\u0430\u0441\u0442\u0438:** \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u044D\u0442\u0438 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F
    \u0438 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435, \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0441\u0443\u043C\u0435\u043B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u0441\u0432\u043E\u0439 \u043F\u043E\u0441\u0442. \u0412 1977 \u0433\u043E\u0434\u0443
    \u043D\u0430 \u043E\u0431\u0449\u0435\u043C \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0438
    \u0410\u041D \u0421\u0421\u0421\u0420 \u043E\u043A\u043E\u043B\u043E \u0442\u0440\u0435\u0442\u0438
    \u0433\u043E\u043B\u043E\u0441\u043E\u0432 \u0431\u044B\u043B\u043E \u043F\u043E\u0434\u0430\u043D\u043E
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0438\u0437\u0431\u0440\u0430\u043D\u0438\u044F,
    \u043D\u043E \u044D\u0442\u043E\u0433\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u043B\u044F
    \u0435\u0433\u043E \u0441\u043C\u0435\u0449\u0435\u043D\u0438\u044F.  ### \U0001F468\u200D\U0001F33E
    \u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C \u0438 \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F 
    *   **\u0421\u0435\u043C\u044C\u044F:** \u0418\u0432\u0430\u043D \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B \u0436\u0435\u043D\u0430\u0442
    \u0438 \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C \u043F\u0440\u043E\u0436\u0438\u043B
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u0441\u0432\u043E\u0435\u0439
    \u0441\u0435\u0441\u0442\u0440\u043E\u0439 \u041D\u0430\u0434\u0435\u0436\u0434\u043E\u0439
    \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u043D\u043E\u0439. *   **\u041D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0435
    \u0445\u043E\u0431\u0431\u0438:** \u041E\u043D \u043E\u0431\u043B\u0430\u0434\u0430\u043B
    \u0432\u044B\u0434\u0430\u044E\u0449\u0435\u0439\u0441\u044F \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0441\u0438\u043B\u043E\u0439. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C,
    \u043E\u043D \u043C\u043E\u0433 \u043E\u0434\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u0439
    \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0441\u0442\u0443\u043B \u0441 \u0441\u0438\u0434\u044F\u0449\u0438\u043C
    \u043D\u0430 \u043D\u0435\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
    \u0434\u0435\u0440\u0436\u0430 \u0435\u0433\u043E \u0437\u0430 \u043D\u043E\u0436\u043A\u0443.
    *   **\u0414\u0430\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C:**
    \u0412\u0441\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043E\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B \u043D\u0430 \u0434\u0430\u0447\u0435
    \u0432 \u0410\u0431\u0440\u0430\u043C\u0446\u0435\u0432\u043E, \u0443\u0432\u043B\u0435\u043A\u0430\u044F\u0441\u044C
    \u0441\u0430\u0434\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0438
    \u0446\u0432\u0435\u0442\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C. 
    ### \U0001F3C6 \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u0438 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435  *   **\u041D\u0430\u0433\u0440\u0430\u0434\u044B:**
    \u0417\u0430 \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C \u043E\u043D
    \u0431\u044B\u043B \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0430
    \u043D\u0430\u0433\u0440\u0430\u0434, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0432\u0442\u043E\u0440\u0443\u044E \u0437\u0432\u0435\u0437\u0434\u0443 \u0413\u0435\u0440\u043E\u044F
    \u0421\u043E\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0422\u0440\u0443\u0434\u0430 (1971), \u041B\u0435\u043D\u0438\u043D\u0441\u043A\u0443\u044E
    \u043F\u0440\u0435\u043C\u0438\u044E (1972) \u0438 \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u043F\u0440\u0435\u043C\u0438\u044E \u0421\u0421\u0421\u0420 (1983). \u0412
    1971 \u0433\u043E\u0434\u0443 \u043E\u043D \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0417\u043E\u043B\u043E\u0442\u0443\u044E \u043C\u0435\u0434\u0430\u043B\u044C
    \u0438\u043C. \u041C.\u0412. \u041B\u043E\u043C\u043E\u043D\u043E\u0441\u043E\u0432\u0430.
    *   **\u041C\u0443\u0437\u0435\u0439 \u0438 \u043F\u0430\u043C\u044F\u0442\u044C:**
    \u041E\u043D \u0441\u0442\u0430\u043B \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C,
    \u043F\u0440\u0438 \u0436\u0438\u0437\u043D\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0431\u044B\u043B \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D
    \u043C\u0435\u043C\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u043C\u0443\u0437\u0435\u0439
    \u0432 \u0412\u0435\u043B\u0438\u043A\u0438\u0445 \u041B\u0443\u043A\u0430\u0445.
    \u0422\u0430\u043A\u0436\u0435 \u043D\u0430 \u0435\u0433\u043E \u0440\u043E\u0434\u0438\u043D\u0435
    \u0431\u044B\u043B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D
    \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439 \u0431\u044E\u0441\u0442,
    \u0447\u0430\u0441\u0442\u044C \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u043D\u0430
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u043E\u043F\u043B\u0430\u0442\u0438\u043B
    \u0441\u0430\u043C. *   **\u0421\u043C\u0435\u0440\u0442\u044C:** \u0418\u0432\u0430\u043D
    \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F 20 \u043C\u0430\u0440\u0442\u0430
    1983 \u0433\u043E\u0434\u0430 \u0432 \u041C\u043E\u0441\u043A\u0432\u0435 \u043D\u0430
    92-\u043C \u0433\u043E\u0434\u0443 \u0436\u0438\u0437\u043D\u0438. \u041F\u043E\u0445\u043E\u0440\u043E\u043D\u0435\u043D
    \u043D\u0430 \u041D\u043E\u0432\u043E\u0434\u0435\u0432\u0438\u0447\u044C\u0435\u043C
    \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043D\u044C \u0418\u0432\u0430\u043D\u0430
    \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447\u0430 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430
    \u0431\u044B\u043B\u0430 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 \u044F\u0440\u043A\u043E\u0439,
    \u0447\u0435\u043C \u0435\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u0435
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F. \u041E\u043D \u0431\u044B\u043B
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0441 \u0441\u0438\u043B\u044C\u043D\u044B\u043C
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C, \u043D\u0435\u0434\u044E\u0436\u0438\u043D\u043D\u043E\u0439
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u043B\u043E\u0439
    \u0438 \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u0430\u043C\u044F\u0442\u044C\u044E, \u0438 \u0435\u0433\u043E \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F
    \u043F\u043E\u043B\u043D\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0438 \u0437\u0430\u0431\u0430\u0432\u043D\u044B\u0445 \u0434\u0435\u0442\u0430\u043B\u0435\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0435\u043B\u0430\u044E\u0442
    \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
    \u0436\u0438\u0432\u043E\u0439 \u0438 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0435\u0439\u0441\u044F.
    \u0412\u043E\u0442 \u0441\u0430\u043C\u044B\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435
    \u0438\u0437 \u043D\u0438\u0445.  ### \U0001F4AA \u0427\u0435\u043B\u043E\u0432\u0435\u043A-\u043B\u0435\u0433\u0435\u043D\u0434\u0430:
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0438\u043B\u0430
    \u0438 \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u0430\u044F
    \u043F\u0430\u043C\u044F\u0442\u044C  *   **\u041D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u0430\u044F
    \u0441\u0438\u043B\u0430:** \u0412\u043D\u0435\u0448\u043D\u0435 \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u043A
    \u0431\u044B\u043B \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0438\u043C \u0438
    \u043A\u043E\u0440\u0435\u043D\u0430\u0441\u0442\u044B\u043C, \u043D\u043E \u043E\u0431\u043B\u0430\u0434\u0430\u043B
    \u043F\u043E\u0438\u0441\u0442\u0438\u043D\u0435 \u0431\u043E\u0433\u0430\u0442\u044B\u0440\u0441\u043A\u043E\u0439
    \u0441\u0438\u043B\u043E\u0439. \u0421\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u0438
    \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0438, \u0447\u0442\u043E
    \u043E\u043D \u043C\u043E\u0433 **\u043E\u0434\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u0439
    \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0441\u0442\u0443\u043B \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u0441\u0438\u0434\u044F\u0449\u0438\u043C \u043D\u0430 \u043D\u0435\u043C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u0434\u0435\u0440\u0436\u0430
    \u0435\u0433\u043E \u0437\u0430 \u043D\u043E\u0436\u043A\u0443**. \u0422\u0430\u043A\u0436\u0435
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438, \u0447\u0442\u043E
    \u043E\u043D \u043C\u043E\u0433 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443
    \u0437\u0430\u0442\u0430\u0449\u0438\u0442\u044C \u0440\u043E\u044F\u043B\u044C
    \u043F\u043E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435 \u043D\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044B\u0439
    \u044D\u0442\u0430\u0436. *   **\u042D\u043D\u0446\u0438\u043A\u043B\u043E\u043F\u0435\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043F\u0430\u043C\u044F\u0442\u044C:** \u041F\u0430\u043C\u044F\u0442\u044C
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430 \u0431\u044B\u043B\u0430
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0432\u043E\u0441\u0445\u0438\u0449\u0435\u043D\u0438\u044F. \u041E\u043D \u043C\u043E\u0433
    \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E \u043D\u0430\u0437\u0432\u0430\u0442\u044C
    \u0434\u043B\u0438\u043D\u0443 \u0438 \u043F\u043B\u043E\u0449\u0430\u0434\u044C
    \u0431\u0430\u0441\u0441\u0435\u0439\u043D\u0430 **\u043B\u044E\u0431\u043E\u0439
    \u0440\u0435\u043A\u0438 \u043C\u0438\u0440\u0430**, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u043F\u043E\u043C\u043D\u0438\u043B \u043D\u0430\u0438\u0437\u0443\u0441\u0442\u044C
    \u0442\u044B\u0441\u044F\u0447\u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0434\u0430\u0442.  ### \U0001F3E1 \u041D\u0430\u0443\u043A\u0430, \u0432\u043B\u0430\u0441\u0442\u044C
    \u0438 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u044B  *   **\"\u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430\"
    \u0432 \u0431\u044B\u0442\u0443:** \u0412 \u0442\u0435\u0441\u043D\u043E\u043C
    \u043A\u0440\u0443\u0433\u0443 \u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0443
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432\u0430 \u0431\u044B\u043B\u0430
    \u0434\u0430\u0436\u0435 \u0441\u0432\u043E\u044F \u0437\u0430\u0431\u0430\u0432\u043D\u0430\u044F
    \u0438\u0433\u0440\u0430 \u043F\u043E\u0434 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C
    **\xAB\u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430\xBB**. \u0421\u0443\u0442\u044C
    \u0435\u0435 \u0431\u044B\u043B\u0430 \u043F\u0440\u043E\u0441\u0442\u0430: \u0435\u0441\u043B\u0438
    \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0447\u0442\u043E-\u0442\u043E \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0435
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0432\u044B\u043D\u0435\u0441\u0442\u0438
    \u043C\u0443\u0441\u043E\u0440), \u0442\u043E\u0442, \u043A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u043C
    \u043A\u0440\u0438\u0447\u0430\u043B \xAB\u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430!\xBB,
    \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B \u044D\u0442\u0443
    \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u044C \u043D\u0430
    \u0434\u0440\u0443\u0433\u043E\u0433\u043E. \u0421\u0443\u0434\u044F \u043F\u043E
    \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u043E\u0432,
    \u0432 \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u0435 \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u043A
    \u0440\u0435\u0434\u043A\u043E \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u043B.
    *   **\u0413\u043E\u0440\u0434\u043E\u0441\u0442\u044C \u0437\u0430 \u0441\u0432\u043E\u0438
    \u043A\u043E\u0440\u043D\u0438:** \u0412 \u0433\u043E\u0434\u044B \u0441\u0442\u0430\u043B\u0438\u043D\u0441\u043A\u0438\u0445
    \u0440\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u0439, \u043A\u043E\u0433\u0434\u0430
    \u043C\u043D\u043E\u0433\u0438\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u043B\u0438
    \u0441\u0432\u043E\u0435 \xAB\u043D\u0435\u043F\u0440\u043E\u043B\u0435\u0442\u0430\u0440\u0441\u043A\u043E\u0435\xBB
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435,
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u043E
    \u043F\u0438\u0441\u0430\u043B \u0432 \u0430\u043D\u043A\u0435\u0442\u0430\u0445,
    \u0447\u0442\u043E \u043E\u043D **\u0441\u044B\u043D \u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
    \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u0430**. \u041E\u043D
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043B
    \u0432 \u041A\u041F\u0421\u0421 \u0438, \u043F\u043E \u0441\u043B\u0443\u0445\u0430\u043C,
    \u043C\u043E\u0433 \u0431\u0435\u0437 \u0441\u0442\u0435\u0441\u043D\u0435\u043D\u0438\u044F
    \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
    \u043F\u0430\u0440\u0442\u0438\u0439\u043D\u044B\u0445 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u043E\u0432.
    *   **\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
    \u0441 \u041B\u044B\u0441\u0435\u043D\u043A\u043E:** \u0412 1955 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043F\u0440\u043E\u044F\u0432\u0438\u043B \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0435
    \u043C\u0443\u0436\u0435\u0441\u0442\u0432\u043E, \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u0432
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0435 **\xAB\u041F\u0438\u0441\u044C\u043C\u043E
    \u0442\u0440\u0435\u0445\u0441\u043E\u0442\xBB**, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0440\u0430\u0437\u043E\u0431\u043B\u0430\u0447\u0430\u043B\u043E \u043F\u0441\u0435\u0432\u0434\u043E\u043D\u0430\u0443\u0447\u043D\u0443\u044E
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0422.\u0414.
    \u041B\u044B\u0441\u0435\u043D\u043A\u043E.  ### \U0001F3AD \u041B\u0438\u0447\u043D\u0430\u044F
    \u0436\u0438\u0437\u043D\u044C \u0438 \u043A\u0443\u0440\u044C\u0435\u0437\u044B 
    *   **\u0428\u0443\u0442\u043B\u0438\u0432\u043E\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435
    \u0445\u043E\u043B\u043E\u0441\u0442\u044F\u0446\u043A\u043E\u0439 \u0436\u0438\u0437\u043D\u0438:**
    \u0418\u0432\u0430\u043D \u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B \u0436\u0435\u043D\u0430\u0442
    \u0438 \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C \u043F\u0440\u043E\u0436\u0438\u043B
    \u0441 \u0441\u0435\u0441\u0442\u0440\u043E\u0439 \u041D\u0430\u0434\u0435\u0436\u0434\u043E\u0439.
    \u041D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441 \u043E \u0442\u043E\u043C,
    \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D \u043D\u0435 \u0436\u0435\u043D\u0438\u043B\u0441\u044F,
    \u043E\u043D \u043E\u0441\u0442\u0440\u043E\u0443\u043C\u043D\u043E \u043E\u0442\u0432\u0435\u0447\u0430\u043B,
    \u0447\u0442\u043E **\u0434\u0435\u0432\u044F\u0442\u044C \u043C\u0435\u0441\u044F\u0446\u0435\u0432
    \u0432 \u0433\u043E\u0434\u0443 \u0435\u043C\u0443 \u043D\u0435\u043A\u043E\u0433\u0434\u0430
    \u0434\u0443\u043C\u0430\u0442\u044C \u043E \u043B\u044E\u0431\u0432\u0438, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u043E\u043D \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0442\u0435\u043E\u0440\u0435\u043C\u044B**. \u0412 \u0448\u0443\u0442\u043A\u0443
    \u043E\u043D \u0442\u0430\u043A\u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B,
    \u0447\u0442\u043E \u043E\u043F\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u043E\u0433\u043E
    \u043F\u0440\u0430\u0433\u043C\u0430\u0442\u0438\u0437\u043C\u0430 \u0436\u0435\u043D\u0449\u0438\u043D,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
    \u0431\u0440\u0430\u043A \u0441 \u0443\u0447\u0435\u043D\u044B\u043C \u043A\u0430\u043A
    \xAB\u0432\u044B\u0433\u043E\u0434\u043D\u0443\u044E \u043F\u0430\u0440\u0442\u0438\u044E\xBB.
    *   **\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u0444\u0430\u043C\u0438\u043B\u0438\u0438:**
    \u0424\u0430\u043C\u0438\u043B\u0438\u044F \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0438\u043C\u0435\u0435\u0442 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E\u0435
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435.
    \u0415\u0433\u043E \u043E\u0442\u0435\u0446 \u0443\u0447\u0438\u043B\u0441\u044F
    \u0432 \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0438\u0438, \u0433\u0434\u0435
    \u0432\u044B\u043F\u0443\u0441\u043A\u043D\u0438\u043A\u0430\u043C \u0434\u0430\u0432\u0430\u043B\u0438
    \u0444\u0430\u043C\u0438\u043B\u0438\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
    \u043E\u0442 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u0438.
    \u041B\u0443\u0447\u0448\u0438\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u0438
    \xAB\u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u044B\u0435\xBB \u0444\u0430\u043C\u0438\u043B\u0438\u0438
    (\u041A\u0440\u0435\u0449\u0435\u043D\u0441\u043A\u0438\u0439, \u0412\u043E\u0437\u043D\u0435\u0441\u0435\u043D\u0441\u043A\u0438\u0439),
    \u0442\u0435, \u043A\u0442\u043E \u0443\u0447\u0438\u043B\u0441\u044F \u0445\u0443\u0436\u0435
    \u2014 \xAB\u0446\u0432\u0435\u0442\u043E\u0447\u043D\u044B\u0435\xBB (\u0413\u0438\u0430\u0446\u0438\u043D\u0442\u043E\u0432,
    \u0420\u043E\u0437\u043E\u0432). \u041D\u0438\u0437\u0448\u0435\u0439 \u0441\u0447\u0438\u0442\u0430\u043B\u0430\u0441\u044C
    \xAB\u0444\u0440\u0443\u043A\u0442\u043E\u0432\u043E-\u044F\u0433\u043E\u0434\u043D\u0430\u044F\xBB
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F. **\u0424\u0430\u043C\u0438\u043B\u0438\u044F
    \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432 \u043E\u0442\u043D\u043E\u0441\u0438\u043B\u0430\u0441\u044C
    \u043A \xAB\u0446\u0432\u0435\u0442\u043E\u0447\u043D\u043E\u0439\xBB**. *  
    **\u0411\u044E\u0441\u0442 \u0437\u0430 \u0441\u0432\u043E\u0439 \u0441\u0447\u0435\u0442:**
    \u041A\u0430\u043A \u0434\u0432\u0430\u0436\u0434\u044B \u0413\u0435\u0440\u043E\u0439
    \u0421\u043E\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0422\u0440\u0443\u0434\u0430 \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u0438\u043C\u0435\u043B \u043F\u0440\u0430\u0432\u043E \u043D\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443
    \u043F\u0440\u0438\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E\u0433\u043E
    \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0433\u043E \u0431\u044E\u0441\u0442\u0430
    \u043D\u0430 \u0440\u043E\u0434\u0438\u043D\u0435. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0443 \u0432\u043B\u0430\u0441\u0442\u0435\u0439 \u043D\u0435 \u043D\u0430\u0448\u043B\u043E\u0441\u044C
    \u043D\u0430 \u044D\u0442\u043E \u0441\u0440\u0435\u0434\u0441\u0442\u0432. \u0422\u043E\u0433\u0434\u0430
    \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u043A **\u0441\u0430\u043C \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u043E\u043F\u043B\u0430\u0442\u0438\u043B \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0430**, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0438 \u0431\u044B\u043B \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043E\u0442\u043A\u0440\u044B\u0442 \u0432 \u0412\u0435\u043B\u0438\u043A\u0438\u0445
    \u041B\u0443\u043A\u0430\u0445 \u0432 1979 \u0433\u043E\u0434\u0443. \u041D\u0430
    \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435 \u043E\u043D \u043D\u0435 \u043F\u043E\u0435\u0445\u0430\u043B,
    \u0442\u0430\u043A \u043A\u0430\u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u044B
    \u043D\u0435 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B\u0438 \u0435\u0433\u043E
    \u0441\u0435\u0441\u0442\u0440\u0443. *   **\"\u041F\u043D\u0438 \u043A\u043E\u0440\u0447\u0443\u044E
    \u0440\u0443\u043A\u0430\u043C\u0438\":** \u0412 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043E\u0432
    \u043B\u044E\u0431\u0438\u043B \u0432\u043E\u0437\u0438\u0442\u044C\u0441\u044F
    \u0432 \u0441\u0430\u0434\u0443 \u0438 \u0446\u0432\u0435\u0442\u043D\u0438\u043A\u0435
    \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u0434\u0430\u0447\u0435 \u0432 \u0410\u0431\u0440\u0430\u043C\u0446\u0435\u0432\u043E.
    \u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441,
    \u043A\u0430\u043A \u043E\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
    \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435, \u043E\u043D \u043E\u0442\u0432\u0435\u0442\u0438\u043B:
    **\xAB\u041F\u043D\u0438 \u043A\u043E\u0440\u0447\u0443\u044E \u043D\u0430 \u0434\u0430\u0447\u0435\xBB**.
    \u0410 \u043D\u0430 \u0443\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u0435, \u043B\u043E\u043C\u043E\u043C
    \u043B\u0438 \u043E\u043D \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442,
    \u0434\u043E\u0431\u0430\u0432\u0438\u043B: \xAB\u041D\u0435\u0442, \u0440\u0443\u043A\u0430\u043C\u0438,
    \u043C\u043D\u0435 \u0431\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430
    \u043F\u0435\u043D\u044C \u0443\u0445\u0432\u0430\u0442\u0438\u0442\u044C\u0441\u044F...\xBB,
    \u0447\u0442\u043E \u0432\u043F\u043E\u043B\u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0443\u0435\u0442\u0441\u044F
    \u0441 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043C\u0438 \u043E \u0435\u0433\u043E
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u043B\u0435. 
    \u042D\u0442\u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0441\u043E\u0437\u0434\u0430\u044E\u0442
    \u043E\u0431\u0440\u0430\u0437 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430,
    \u043D\u043E \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0441 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C, \u0441\u0438\u043B\u044C\u043D\u043E\u0439
    \u0432\u043E\u043B\u0435\u0439 \u0438 \u0431\u043E\u043B\u044C\u0448\u0438\u043C
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C \u044E\u043C\u043E\u0440\u0430.
    \u041E\u043D \u0431\u044B\u043B \u0438 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
    \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u044F\u0440\u043A\u0438\u0445
    \u0438 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u0445\u0441\u044F
    \u0444\u0438\u0433\u0443\u0440 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439 \u043D\u0430\u0443\u043A\u0438."
