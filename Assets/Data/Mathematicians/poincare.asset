    \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043f\u043e \u0441\u0432\u043e\u0438\u043c
    \u0441\u043b\u0435\u0434\u0430\u043c, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438
    \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430-\u043a\u043e\u0440\u0437\u0438\u043d\u0449\u0438\u043a\u0430,
    \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u00ab\u043f\u043e\u0437\u0430\u0438\u043c\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u00bb
    \u0442\u043e\u0432\u0430\u0440. \u0411\u0435\u043b\u044c\u0451 \u0438 \u043f\u043e\u0440\u0442\u0444\u0435\u043b\u044c:
    \u041a\u043e\u0433\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c
    \u0438 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0441\u044f \u0432 \u043f\u043e\u0435\u0437\u0434\u043a\u0443
    \u043f\u043e \u0410\u0432\u0441\u0442\u0440\u0438\u0438, \u0435\u0433\u043e \u043c\u0430\u0442\u044c,
    \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c, \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u0442\u0435\u0440\u044f\u0435\u0442
    \u043f\u043e\u0440\u0442\u0444\u0435\u043b\u044c \u0438\u0437-\u0437\u0430 \u0441\u0432\u043e\u0435\u0439
    \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0441\u0442\u0438, \u043f\u0440\u0438\u0448\u0438\u043b\u0430
    \u043a \u043d\u0435\u043c\u0443 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u044c\u0447\u0438\u043a\u0438.
    \u041f\u043b\u0430\u043d \u0441\u0440\u0430\u0431\u043e\u0442\u0430\u043b, \u043d\u043e
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u043c:
    \u0432\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c, \u043c\u0430\u0442\u044c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0430,
    \u0447\u0442\u043e \u0410\u043d\u0440\u0438 \u043f\u0440\u0438\u0432\u0451\u0437 \u0432
    \u0441\u0432\u043e\u0451\u043c \u0441\u0430\u043a\u0432\u043e\u044f\u0436\u0435 \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0440\u0442\u0444\u0435\u043b\u044c, \u043d\u043e
    \u0438... \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e \u0441\u043b\u043e\u0436\u0435\u043d\u043d\u0443\u044e
    \u0430\u0432\u0441\u0442\u0440\u0438\u0439\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u0441\u0442\u044b\u043d\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u043f\u043e \u043e\u0448\u0438\u0431\u043a\u0435
    \u043f\u0440\u0438\u043d\u044f\u043b \u0437\u0430 \u0441\u0432\u043e\u044e \u043d\u043e\u0447\u043d\u0443\u044e
    \u0440\u0443\u0431\u0430\u0448\u043a\u0443. \u041f\u0440\u043e\u0432\u0430\u043b\u0435\u043d\u043d\u044b\u0439
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d: \u0415\u0433\u043e \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u0438 \u0432 \u044e\u043d\u043e\u0441\u0442\u0438.
    \u041d\u0430 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0435 \u043d\u0430 \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430 \u043d\u0430\u0443\u043a \u043e\u043d
    \u043e\u043f\u043e\u0437\u0434\u0430\u043b, \u043f\u0435\u0440\u0435\u043f\u0443\u0442\u0430\u043b
    \u0442\u0435\u043c\u0443 \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0438 \u00ab\u043f\u0440\u043e\u0432\u0430\u043b\u0438\u043b\u00bb \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u0421\u043f\u0430\u0441\u043b\u0430 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e \u043b\u0438\u0448\u044c
    \u0435\u0433\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0430\u044f \u0443\u0441\u0442\u043d\u0430\u044f
    \u0447\u0430\u0441\u0442\u044c, \u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0437\u0430\u043a\u0440\u044b\u043b\u0438 \u0433\u043b\u0430\u0437\u0430 \u043d\u0430 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F956
    \u0412\u0435\u043b\u0438\u043a\u0430\u044f \u0431\u0438\u0442\u0432\u0430 \u0437\u0430 \u0431\u0430\u0433\u0435\u0442:
    \u041f\u043e\u0431\u0435\u0434\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438
    \u043d\u0430\u0434 \u0431\u0443\u043b\u043e\u0447\u043d\u0438\u043a\u043e\u043c \u042d\u0442\u043e,
    \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043a\u0430\u043a \u043e\u043d
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b \u043d\u0430\u0443\u043a\u0443 \u0432 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438. \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435, \u043a\u0430\u043a
    \u0438\u0441\u0442\u0438\u043d\u043d\u044b\u0439 \u0444\u0440\u0430\u043d\u0446\u0443\u0437,
    \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u043f\u043e\u043a\u0443\u043f\u0430\u043b
    \u0431\u0430\u0433\u0435\u0442 \u0438, \u0431\u0443\u0434\u0443\u0447\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c, \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0432\u0435\u0441 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u0435\u043d.
    1. \u041f\u0435\u0440\u0432\u043e\u0435 \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435:
    \u041e\u043d \u043d\u0430\u0447\u0430\u043b \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0439 \u0445\u043b\u0435\u0431 \u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u0433\u043e\u0434\u0430 \u0441\u043a\u0440\u0443\u043f\u0443\u043b\u0451\u0437\u043d\u043e
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b.
    \u041a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u0433\u0440\u0430\u0444\u0438\u043a, \u0442\u043e \u0443\u0432\u0438\u0434\u0435\u043b,
    \u0447\u0442\u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0432\u0435\u0441\u0430 \u043e\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u0443\u044e
    \u043a\u0440\u0438\u0432\u0443\u044e, \u043d\u043e \u0441 \u043f\u0438\u043a\u043e\u043c
    \u043d\u0435 \u043d\u0430 \u043e\u0442\u043c\u0435\u0442\u043a\u0435 \u0432 1 \u043a\u0433,
    \u0430 \u043e\u043a\u043e\u043b\u043e 950 \u0433\u0440\u0430\u043c\u043c\u043e\u0432. \u042d\u0442\u043e
    \u0431\u044b\u043b\u043e \u0431\u0435\u0441\u0441\u043f\u043e\u0440\u043d\u044b\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0431\u0443\u043b\u043e\u0447\u043d\u0438\u043a
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\u0434\u043e\u0432\u0435\u0448\u0438\u0432\u0430\u0435\u0442,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0440\u0435\u0446\u0435\u043f\u0442
    \u0434\u043b\u044f 950-\u0433\u0440\u0430\u043c\u043c\u043e\u0432\u044b\u0445 \u0431\u0443\u0445\u0430\u043d\u043e\u043a.
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0441\u044f
    \u0432 \u043f\u043e\u043b\u0438\u0446\u0438\u044e, \u0438 \u0431\u0443\u043b\u043e\u0447\u043d\u0438\u043a\u0430
    \u043e\u0448\u0442\u0440\u0430\u0444\u043e\u0432\u0430\u043b\u0438. 2. \u0412\u0442\u043e\u0440\u043e\u0435
    \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435: \u0411\u0443\u043b\u043e\u0447\u043d\u0438\u043a
    \u0438\u0441\u043f\u0443\u0433\u0430\u043b\u0441\u044f \u0438 \u0440\u0435\u0448\u0438\u043b,
    \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442
    \u043e\u0431\u043c\u0430\u043d\u044b\u0432\u0430\u0442\u044c \u0441\u0430\u043c\u043e\u0433\u043e
    \u043e\u043f\u0430\u0441\u043d\u043e\u0433\u043e \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f.
    \u041d\u043e \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b
    \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0445\u043b\u0435\u0431.
    \u0427\u0435\u0440\u0435\u0437 \u0433\u043e\u0434 \u043e\u043d \u0441\u043d\u043e\u0432\u0430
    \u043f\u0440\u0438\u0448\u0451\u043b \u0432 \u043f\u043e\u043b\u0438\u0446\u0438\u044e \u0441
    \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c, \u0447\u0442\u043e \u043e\u0431\u043c\u0430\u043d
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f! \u041a\u043e\u0433\u0434\u0430
    \u0431\u0443\u043b\u043e\u0447\u043d\u0438\u043a \u0443\u0437\u043d\u0430\u043b \u043e\u0431
    \u044d\u0442\u043e\u043c, \u043e\u043d \u0431\u044b\u043b \u0432 \u0448\u043e\u043a\u0435:
    \u043e\u043d \u0436\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0430\u0432\u0430\u043b
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0441\u0430\u043c\u044b\u0439 \u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0431\u0430\u0433\u0435\u0442!. 3. \u0420\u0430\u0437\u043e\u0431\u043b\u0430\u0447\u0435\u043d\u0438\u0435:
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b
    \u043f\u043e\u043b\u0438\u0446\u0438\u0438 \u043d\u043e\u0432\u044b\u0439 \u0433\u0440\u0430\u0444\u0438\u043a.
    \u041d\u0430 \u044d\u0442\u043e\u0442 \u0440\u0430\u0437 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0432\u0435\u0441\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u043e
    \u0441\u043e\u0431\u043e\u0439 \u0442\u0443 \u0436\u0435 \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u0443\u044e
    \u043a\u0440\u0438\u0432\u0443\u044e \u0441 \u043f\u0438\u043a\u043e\u043c \u043d\u0430
    950 \u0433\u0440\u0430\u043c\u043c\u043e\u0432, \u043d\u043e... \u043e\u0431\u0440\u0435\u0437\u0430\u043d\u043d\u0443\u044e
    \u0441 \u043b\u0435\u0432\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b. \u0412\u0441\u0435
    \u0431\u0443\u0445\u0430\u043d\u043a\u0438 \u0432\u0435\u0441\u0438\u043b\u0438 \u0440\u043e\u0432\u043d\u043e
    1 \u043a\u0433 \u0438\u043b\u0438 \u0447\u0443\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435.
    \u0423\u0447\u0451\u043d\u044b\u0439 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b: \u0431\u0443\u043b\u043e\u0447\u043d\u0438\u043a
    \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u0440\u0435\u0446\u0435\u043f\u0442,
    \u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0447\u0430\u043b \u043e\u0442\u0431\u0438\u0440\u0430\u0442\u044c
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u0430\u043c\u044b\u0435 \u0442\u044f\u0436\u0451\u043b\u044b\u0435
    \u0431\u0430\u0433\u0435\u0442\u044b \u0438\u0437 \u043e\u0431\u0449\u0435\u0439 \u043f\u0430\u0440\u0442\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u0431\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u0438\u0437 \u043e\u0431\u0449\u0435\u0433\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f. \u042d\u0442\u043e\u0442
    \u0441\u043b\u0443\u0447\u0430\u0439 \u2014 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439
    \u043f\u0440\u0438\u043c\u0435\u0440 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438.\n\n\U0001F9E0
    \u041e\u0441\u043e\u0431\u044b\u0439 \u043c\u0435\u0442\u043e\u0434 \u0440\u0430\u0431\u043e\u0442\u044b:
    \u00ab\u0418\u043d\u043a\u0443\u0431\u0430\u0446\u0438\u044f\u00bb \u0438\u0434\u0435\u0439
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043d\u0435 \u0431\u044b\u043b \u0442\u0440\u0443\u0434\u043e\u0433\u043e\u043b\u0438\u043a\u043e\u043c
    \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435.
    \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u0435\u0436\u0438\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b
    \u0435\u0433\u043e \u043f\u043e\u0434\u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043d\u0430\u0434 \u0441\u0430\u043c\u044b\u043c\u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438
    \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438. \u0421\u0442\u0440\u043e\u0433\u0438\u0439
    \u0433\u0440\u0430\u0444\u0438\u043a: \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
    \u0443\u0442\u0440\u043e\u043c (\u0441 10 \u0434\u043e 12) \u0438 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
    \u0432\u0435\u0447\u0435\u0440\u043e\u043c (\u0441 5 \u0434\u043e 7). \u041f\u043e\u0441\u043b\u0435
    \u0443\u0436\u0438\u043d\u0430 \u043e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b. \u042d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434
    \u043e\u043d \u0441\u0430\u043c \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u00ab\u0438\u043d\u043a\u0443\u0431\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c
    \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043c\u00bb: \u043e\u043d \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u043e\u0442 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044f \u043f\u043e\u0434\u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044e
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u0435.
    \u041e\u043d \u0432\u0435\u0440\u0438\u043b, \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f \u0438 \u043f\u043e\u0434\u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438\u0433\u0440\u0430\u044e\u0442 \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e \u0440\u043e\u043b\u044c
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0435, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437.\n\n\U0001F91D
    \u0411\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u0441\u0442\u0432\u043e \u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432 \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u0443\u0447\u0451\u043d\u044b\u0445,
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u0433\u0440\u044f\u0437\u043d\u044b\u0445
    \u0441\u043f\u043e\u0440\u0430\u0445 \u0437\u0430 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442.
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u043e\u0437\u0438\u0446\u0438\u044f. \u0421\u0430\u043c\u044b\u043c \u044f\u0440\u043a\u0438\u043c
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u041e\u043d \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0435\u0451 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0434\u043e \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u043d \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u043e
    \u0443\u0441\u0442\u0443\u043f\u0438\u043b \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442,
    \u043d\u0430\u0437\u0432\u0430\u0432 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438\u043c\u0435\u043d\u0435\u043c \u041b\u043e\u0440\u0435\u043d\u0446\u0430, \u0445\u043e\u0442\u044f
    \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d \u043f\u0440\u0438\u0434\u0430\u043b \u0438\u043c
    \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u0438\u0434.
    \u0414\u043b\u044f \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u043e \u0432\u0430\u0436\u043d\u0435\u0435,
    \u0447\u0442\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u043a\u0440\u0430\u0441\u0438\u0432\u0430
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430,
    \u0447\u0435\u043c \u0447\u044c\u0451-\u0442\u043e \u0438\u043c\u044f \u043d\u0430 \u043d\u0435\u0439.\n\n\u26a1
    \u041f\u0440\u043e\u0447\u0438\u0435 \u043a\u0443\u0440\u044c\u0451\u0437\u044b \u0426\u0432\u0435\u0442\u043d\u043e\u0439
    \u0441\u043b\u0443\u0445: \u041f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0451\u043d\u043d\u043e\u0439
    \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438
    \u0443 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0440\u0430\u0437\u0432\u0438\u043b\u0430\u0441\u044c
    \u0441\u0438\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u044f \u2014 \u043e\u043d \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043b
    \u0437\u0432\u0443\u043a\u0438 \u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u043c\u0438
    \u0446\u0432\u0435\u0442\u0430\u043c\u0438. \u042d\u0442\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c \u0443 \u043d\u0435\u0433\u043e
    \u043d\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c. \u0412\u043d\u0435\u0448\u043d\u0438\u0439
    \u0432\u0438\u0434: \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \u043a\u0430\u043a
    \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e (\u043e\u043a\u043e\u043b\u043e
    165 \u0441\u043c) \u0431\u043b\u043e\u043d\u0434\u0438\u043d\u0430 \u0441 \u043e\u0447\u0435\u043d\u044c
    \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0433\u043e\u043b\u043e\u0432\u043e\u0439, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432 \u0448\u0438\u0440\u0438\u043d\u0443. \u041e\u043d \u0441\u0442\u043e\u044f\u043b,
    \u0441\u0443\u0442\u0443\u043b\u044f\u0441\u044c \u0438 \u0437\u0430\u043f\u0440\u043e\u043a\u0438\u043d\u0443\u0432
    \u043c\u043e\u0440\u0449\u0438\u043d\u0438\u0441\u0442\u044b\u0439 \u043b\u043e\u0431, \u0438
    \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u0441 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u044b\u043c
    \u0432\u0438\u0434\u043e\u043c, \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0434\u0443\u043c\u0430\u043b
    \u043e \u0447\u0451\u043c-\u0442\u043e \u0434\u0440\u0443\u0433\u043e\u043c, \u0434\u0430\u0436\u0435
    \u043a\u043e\u0433\u0434\u0430 \u0431\u044b\u043b \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d
    \u0432 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0435. \u0424\u0438\u043b\u043e\u0441\u043e\u0444,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0435 \u043b\u044e\u0431\u0438\u043b\u0438
    \u0432 \u0421\u0421\u0421\u0420: \u0412 \u0421\u0421\u0421\u0420 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u00ab\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u043c \u0431\u0443\u0440\u0436\u0443\u0430\u0437\u043d\u044b\u043c
    \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u043c\u043e\u043c\u00bb. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b, \u0447\u0442\u043e
    \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0430\u044f \u043d\u0430\u0443\u043a\u0430 \u043d\u0435
    \u043c\u043e\u0433\u043b\u0430 \u043e\u0431\u043e\u0439\u0442\u0438\u0441\u044c \u0431\u0435\u0437
    \u043d\u0438\u0445, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0440\u0430\u0434\u0438\u043e\u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439."
