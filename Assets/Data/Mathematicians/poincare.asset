  achievementsRu: "\u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435, \u0431\u0435\u0441\u0441\u043f\u043e\u0440\u043d\u043e,
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u043e\u0439 \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0438\u0433\u0443\u0440 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438.
    \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u0412\u043a\u043b\u0430\u0434 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c
    \u2014 \u0432\u043e \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u0446\u0435\u043b\u044b\u0435
    \u043d\u043e\u0432\u044b\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043c\u044b\u0441\u043b\u0438. \u041d\u0438\u0436\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u0442\u0440\u0443\u0434\u044b
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445.\n\n\U0001F9EE
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043d\u043e\u0432\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u043e\u0442 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0437\u0434\u0435\u0441\u044c: \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f (Analysis
    Situs): \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043f\u043e \u043f\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0442\u0446\u043e\u043c \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438
    \u2014 \u0440\u0430\u0437\u0434\u0435\u043b\u0430, \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0435\u0433\u043e
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f
    \u043f\u0440\u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0445 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f\u0445.
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f: \u041e\u043d \u0432\u0432\u0435\u043b \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0440\u0443\u043f\u043f\u044b \u0438 \u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438,
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438. \u042d\u0442\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043f\u043e \u0438\u0445
    \u00ab\u0434\u044b\u0440\u043a\u0430\u043c\u00bb \u0438 \u00ab\u0440\u0443\u0447\u043a\u0430\u043c\u00bb.
    \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435:
    \u0415\u0433\u043e \u0441\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430, \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432 1904 \u0433\u043e\u0434\u0443, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0435
    \u0442\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u043e\u0435 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0433\u043e\u043c\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438
    \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u043e \u0442\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u043e\u0439
    \u0441\u0444\u0435\u0440\u0435, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0444\u0435\u0440\u043e\u0439.
    \u042d\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u0441\u0442\u0430\u043b\u0430 \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0431\u044b\u043b\u0430
    \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u0435\u043c
    \u041f\u0435\u0440\u0435\u043b\u044c\u043c\u0430\u043d\u043e\u043c \u043b\u0438\u0448\u044c
    \u0432 2002-2003 \u0433\u043e\u0434\u0430\u0445. \u041a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439: \u0412\u043c\u0435\u0441\u0442\u043e
    \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u043f\u044b\u0442\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430\u0439\u0442\u0438 \u0442\u043e\u0447\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434\u044b,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u0435 \u043f\u043e\u043d\u044f\u0442\u044c
    \u043e\u0431\u0449\u0435\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439. \u042d\u0442\u043e \u0434\u0430\u043b\u043e
    \u0442\u043e\u043b\u0447\u043e\u043a \u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c. \u0410\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438: \u041e\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443
    \u0430\u0432\u0442\u043e\u043c\u043e\u0440\u0444\u043d\u044b\u043c\u0438 \u0438 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u0438, \u043f\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u043e\u043d\u0438 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442
    \u043e\u0434\u043d\u043e\u0439 \u0438 \u0442\u043e\u0439 \u0436\u0435 \u0433\u0440\u0443\u043f\u043f\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.\n\n\U0001F30C
    \u041d\u0435\u0431\u0435\u0441\u043d\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430:
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0445\u0430\u043e\u0441\u0430 \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044e,
    \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0435\u043c\u0443 \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435. \u0417\u0430\u0434\u0430\u0447\u0430
    \u0442\u0440\u0435\u0445 \u0442\u0435\u043b: \u0412 1889 \u0433\u043e\u0434\u0443 \u0437\u0430
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u044d\u0442\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u0435\u043c\u0438\u044e \u043a\u043e\u0440\u043e\u043b\u044f \u041e\u0441\u043a\u0430\u0440\u0430
    II. \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0445\u043e\u0434\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435. \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0438\u0437 \u0442\u0440\u0435\u0445
    \u0433\u0440\u0430\u0432\u0438\u0442\u0438\u0440\u0443\u044e\u0449\u0438\u0445 \u0442\u0435\u043b
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u043d\u0430 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u0440\u043e\u043a
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e. \u0414\u0435\u0442\u0435\u0440\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0445\u0430\u043e\u0441: \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043c\u0430\u043b\u0435\u0439\u0448\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430
    \u0432 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445
    \u043c\u043e\u0436\u0435\u0442 \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c
    \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e
    \u043e\u0442\u043b\u0438\u0447\u0430\u044e\u0449\u0435\u043c\u0443\u0441\u044f \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443.
    \u042d\u0442\u043e \u044f\u0432\u043b\u0435\u043d\u0438\u0435, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u043e\u0435
    \u0434\u0435\u0442\u0435\u0440\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c
    \u0445\u0430\u043e\u0441\u043e\u043c, \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0434\u0435\u0442\u0435\u0440\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043c\u043e\u0433\u0443\u0442 \u0432\u0435\u0441\u0442\u0438
    \u0441\u0435\u0431\u044f \u043d\u0435\u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u043e.\n\n\U0001F52C
    \u0424\u0438\u0437\u0438\u043a\u0430: \u041d\u0430 \u043f\u0443\u0442\u0438 \u043a \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0412 \u0444\u0438\u0437\u0438\u043a\u0435 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438 XX \u0432\u0435\u043a\u0430. \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0417\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u0434\u043e
    \u0440\u0430\u0431\u043e\u0442 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043a\u0430\u043a \u043e\u0431\u0449\u0438\u0439 \u0437\u0430\u043a\u043e\u043d \u043f\u0440\u0438\u0440\u043e\u0434\u044b.
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0421\u0422\u041e: \u0412 \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    1898-1905 \u0433\u043e\u0434\u043e\u0432 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0441\u0435 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u043d\u044f\u0442\u0438\u044f
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u041b\u043e\u0440\u0435\u043d\u0446\u0430
    \u0438 \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u044c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u041c\u0430\u043a\u0441\u0432\u0435\u043b\u043b\u0430.
    \u0415\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435 \u0432\u0437\u0433\u043b\u044f\u0434\u044b
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b\u0438 \u043f\u043e\u0447\u0432\u0443
    \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u043e\u043d\u044f\u0442\u0438\u0439
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\U0001F4DA
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u043d\u0430\u0443\u043a\u0438: \u041a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0438\u0434\u0435\u044f, \u0440\u0430\u0437\u0432\u0438\u0442\u0430\u044f
    \u0432 \u0442\u0440\u0443\u0434\u0435 \u00ab\u041d\u0430\u0443\u043a\u0430 \u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430\u00bb
    (1902), \u2014 \u044d\u0442\u043e \u043a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c.
    \u0421\u0443\u0442\u044c \u043a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c\u0430:
    \u041e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u043d\u0430\u0443\u043a\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438)
    \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0439
    \u0438\u0441\u0442\u0438\u043d\u043e\u0439 \u0438\u043b\u0438 \u043b\u043e\u0436\u044c\u044e.
    \u042d\u0442\u043e \u0441\u043e\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f (\u043a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u0438),
    \u0443\u0434\u043e\u0431\u043d\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u044b \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u043c
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u043c\u0438\u0440\u0430.
    \u0420\u043e\u043b\u044c \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b: \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0440\u043e\u043b\u044c \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0432 \u043d\u0430\u0443\u043a\u0435,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u043e\u043d\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430
    \u0434\u043b\u044f \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0444\u0430\u043a\u0442\u043e\u0432
    \u0438 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0442\u0435\u043e\u0440\u0438\u0439.
    \u041f\u043e \u0435\u0433\u043e \u043c\u0435\u0442\u043a\u043e\u043c\u0443 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e,
    \u043d\u0430\u0443\u043a\u0430 \u0441\u0442\u0440\u043e\u0438\u0442\u0441\u044f \u0438\u0437
    \u0444\u0430\u043a\u0442\u043e\u0432, \u043a\u0430\u043a \u0434\u043e\u043c \u0438\u0437
    \u043a\u0438\u0440\u043f\u0438\u0447\u0435\u0439, \u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0435
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435 \u0444\u0430\u043a\u0442\u043e\u0432 \u0435\u0449\u0435
    \u043d\u0435 \u0435\u0441\u0442\u044c \u043d\u0430\u0443\u043a\u0430. \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f: \u041e\u043d \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f,
    \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u043d\u043e\u0432\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f \u043d\u0435 \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u0435\u0442
    \u0441\u0442\u0430\u0440\u0443\u044e, \u0430 \u043b\u0438\u0448\u044c \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u0435\u0451 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u043e\u0441\u0442\u0438.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043a\u043d\u0438\u0433\u0430
    \u00ab\u041d\u0430\u0443\u043a\u0430 \u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430\u00bb
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b\u0430 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e
    \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u0430 \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430
    \u0438 \u0441\u0442\u0430\u043b\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u044b\u0445
    \u0442\u043e\u0447\u0435\u043a \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u0412 \u0446\u0435\u043b\u043e\u043c, \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u2014 \u044d\u0442\u043e
    \u043f\u0440\u0438\u043c\u0435\u0440 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u044b. \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0438, \u043d\u043e \u0438
    \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u043d\u043e\u0432\u044b\u0435 \u044f\u0437\u044b\u043a\u0438
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u043c\u0438\u0440\u0430,
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f
    \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438."
  achievementsEn: "Henri Poankare is undoubtedly one of the most important figures in the history of science, and his legacy covers the fundamental fields of mathematics, physics and philosophy, and Poincaré's contribution was not just profound; in many cases, he has created whole new directions of scientific thought, and the main achievements and works of Poankare in detail are presented below.\n\nMathematics: The creation of the new reality of Poancare has revolutionized several sections of mathematics. Its main achievements here are: Topology (Analesis Situs): Poancare is rightly considered to be the father of topology, a section that studies the properties of spaces that remain in permanent deformations. Fundamental concepts: He introduced the core concepts of fundamental group and homology, laying the foundation for algebraic topology.These tools classify space by its \"holes\" and \"knobs.\" Poankare's hypothesis: His most famous hypothesis, formulated in 1904, argues that any confined three-dimensional diversity, which is homotopically equivalent to a three-dimensional sphere, is an area that has become one of the most difficult in mathematics and has been proven by Grigory Perelman only in 2002-2003.Qualitative theory of differential equations: Instead of trying to find precise solutions to equations, Poancare developed methods to understand the general behaviour of their solutions, which led to the development of dynamic systems theory. Automorphic functions: He established a deep connection between automorphic and elliptical functions, showing that they belong to the same group of algebraic equations.\n\n==Career=======Career=======Career====In 1889, Poancare received the King Oscar II Award for work on this task. During the course of his work, however, he made a sensational discovery. He proved that in a system of three gravitational bodies, it was impossible to predict the long-term movement.Determinated chaos: Poincare has shown that the slightest mistake in the initial conditions can lead to a fundamentally different result over time, a phenomenon called deterministic chaos, which means that even fully determinated systems can behave unpredictablely.\n\n♪ Physics: Towards the theory of relativity in the physics of Poancare was one of the main predecessors of the 20th century revolution: The principle of relativity: A few years before Einstein Poancare's work, formulated the principle of relativity as the general law of nature.Key provisions of the STO: In its 1898-1905 work, almost all the most important elements of the special theory of relativity are found: the conditionality of the notion of simultaneousity, the transformation of Lorenz, and the invariance of the equations Maxwell, whose philosophical views have prepared the ground for a re-examination of the concepts of space and time.\n\nThe philosophy of science: Puancare's Conventionalism was a profound philosopher of science, and his main idea, developed in Science and Hypothesis (1902), is conventionalism. The essence of the Conventionism: He argued that the fundamental principles of science (e.g., axioms of geometry) are not absolute truth or lies. These are agreements (Conventions), the convenient tools we choose to describe the world.The role of the hypothesis: Poincare studied in detail the role of the hypothesis in science, showing that it was necessary to generalize facts and build theories. By his comparison, science is based on facts, like a house of bricks, but there is no science yet, a simple collection of facts. The principle of conformity: He was one of the first to formulate the principle of conformity, according to which the new theory does not reject the old one, but merely indicates the limits of its applicability.Interestingly, the book Science and Hypothesis inspired young Albert Einstein and became one of the starting points for the theory of relativity. In general, Henri Poankare's scientific legacy is an example of remarkable universality and depth. It has not only solved the problems, but has also created new languages to describe the world, many of which are still at the centre of modern science."
  personalLifeRu: "\u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f, \u0434\u0435\u0442\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0445\u0440\u043e\u043d\u0438\u043a\u0430 \u0436\u0438\u0437\u043d\u0438 \u0410\u043d\u0440\u0438
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u2014 \u043e\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0434\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 \u0434\u043d\u0435\u0439,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043c\u044b \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u0438\u043c
    \u0435\u0433\u043e \u043f\u0443\u0442\u044c \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438.\n\n\U0001F476
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e:
    \u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0435\u043d\u0438\u044f
    \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    29 \u0430\u043f\u0440\u0435\u043b\u044f 1854 \u0433\u043e\u0434\u0430 \u0432 \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435
    \u0421\u0438\u0442\u0435-\u0414\u044e\u043a\u0430\u043b\u044c \u0431\u043b\u0438\u0437 \u0433\u043e\u0440\u043e\u0434\u0430
    \u041d\u0430\u043d\u0441\u0438 (\u041b\u043e\u0442\u0430\u0440\u0438\u043d\u0433\u0438\u044f,
    \u0424\u0440\u0430\u043d\u0446\u0438\u044f). \u0415\u0433\u043e \u043e\u0442\u0435\u0446,
    \u041b\u0435\u043e\u043d \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435, \u0431\u044b\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b
    \u0432 \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u041d\u0430\u043d\u0441\u0438,
    \u0430 \u043c\u0430\u0442\u044c, \u042d\u0436\u0435\u043d\u0438 \u041b\u0430\u043d\u0443\u0430,
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b\u0430 \u0441\u0435\u0431\u044f \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u044e
    \u0434\u0435\u0442\u0435\u0439 \u2014 \u0410\u043d\u0440\u0438 \u0438 \u0435\u0433\u043e
    \u043c\u043b\u0430\u0434\u0448\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u044b \u0410\u043b\u0438\u043d\u044b.
    \u0421\u0435\u043c\u044c\u044f \u0431\u044b\u043b\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439:
    \u0435\u0433\u043e \u0434\u0432\u043e\u044e\u0440\u043e\u0434\u043d\u044b\u0439 \u0431\u0440\u0430\u0442
    \u0420\u0430\u0439\u043c\u043e\u043d \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0442\u0430\u043b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u0421 \u0440\u0430\u043d\u043d\u0435\u0433\u043e
    \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0437\u0430 \u0410\u043d\u0440\u0438 \u0437\u0430\u043a\u0440\u0435\u043f\u0438\u043b\u0430\u0441\u044c
    \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044f \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u043e
    \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.
    \u041e\u043d \u043c\u043e\u0433 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f
    \u043e\u0442 \u0432\u043d\u0435\u0448\u043d\u0435\u0433\u043e \u043c\u0438\u0440\u0430,
    \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u044f\u0441\u044c \u0432 \u0441\u0432\u043e\u0438
    \u043c\u044b\u0441\u043b\u0438, \u0447\u0442\u043e \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e
    \u043e \u043d\u0435\u043c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043b\u0435\u0433\u0435\u043d\u0434.
    \u042d\u0442\u0430 \u0447\u0435\u0440\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u043f\u0440\u043e\u043d\u0435\u0441 \u0447\u0435\u0440\u0435\u0437 \u0432\u0441\u044e
    \u0436\u0438\u0437\u043d\u044c, \u0431\u044b\u043b\u0430 \u043d\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043a\u043e\u043c,
    \u0430 \u0441\u043a\u043e\u0440\u0435\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0435\u0433\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043a \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438.
    \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0410\u043d\u0440\u0438 \u043f\u0435\u0440\u0435\u043d\u0435\u0441
    \u0442\u044f\u0436\u0435\u043b\u0443\u044e \u0444\u043e\u0440\u043c\u0443 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u0432\u0435\u043b\u0430 \u043a
    \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\u043c: \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c\u0443
    \u043f\u0430\u0440\u0430\u043b\u0438\u0447\u0443 \u043d\u043e\u0433 \u0438 \u043c\u044f\u0433\u043a\u043e\u0433\u043e
    \u043d\u0435\u0431\u0430. \u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432
    \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u043a\u043e\u0432\u0430\u043d \u043a
    \u043f\u043e\u0441\u0442\u0435\u043b\u0438 \u0438 \u043d\u0435 \u043c\u043e\u0433 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c.
    \u042d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043e\u0431\u043e\u0441\u0442\u0440\u0438\u043b\u043e
    \u0435\u0433\u043e \u0441\u043b\u0443\u0445 \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044e \u0440\u0435\u0434\u043a\u043e\u0439
    \u0444\u043e\u0440\u043c\u044b \u0441\u0438\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0438
    \u2014 \u043e\u043d \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b \u0437\u0432\u0443\u043a\u0438
    \u0432 \u0446\u0432\u0435\u0442\u0435, \u0438 \u044d\u0442\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c \u0443 \u043d\u0435\u0433\u043e
    \u043d\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c. \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e,
    \u043e\u043d \u0441\u043c\u043e\u0433 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f,
    \u043d\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u0435\u0433\u043e \u043c\u044f\u0433\u043a\u0438\u043c
    \u0438 \u0437\u0430\u0441\u0442\u0435\u043d\u0447\u0438\u0432\u044b\u043c. \u0418\u0437-\u0437\u0430
    \u0441\u043b\u0430\u0431\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f
    \u0435\u0433\u043e \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u043c \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435\u043c
    \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u0434\u0440\u0443\u0433 \u0441\u0435\u043c\u044c\u0438,
    \u0410\u043b\u044c\u0444\u043e\u043d\u0441 \u0413\u0438\u043d\u0446\u0435\u043b\u0438\u043d.
    \u041e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u0441 \u0410\u043d\u0440\u0438
    \u0431\u0435\u0441\u0435\u0434\u044b, \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u044f
    \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442.
    \u042d\u0442\u043e \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0443\u044e \u043c\u0430\u043d\u0435\u0440\u0443
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0443\u0441\u0432\u0430\u0438\u0432\u0430\u0442\u044c
    \u0438 \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e
    \u0432 \u0443\u043c\u0435, \u0431\u0435\u0437 \u0444\u0438\u043a\u0441\u0430\u0446\u0438\u0438
    \u043d\u0430 \u0431\u0443\u043c\u0430\u0433\u0435, \u0447\u0442\u043e \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c
    \u043f\u043e\u0440\u043e\u0436\u0434\u0430\u043b\u043e \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438 \u0441 \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u043c
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c.\n\n\U0001F393 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u041f\u0443\u0442\u044c \u043e\u0442 \u0441\u043b\u043e\u0432\u0435\u0441\u043d\u043e\u0441\u0442\u0438
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0445\u043e\u0440\u043e\u0448\u0435\u0439 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0439
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435, \u0432 8,5 \u043b\u0435\u0442
    \u0410\u043d\u0440\u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0441\u0440\u0430\u0437\u0443
    \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u043a\u043b\u0430\u0441\u0441 \u043b\u0438\u0446\u0435\u044f
    \u041d\u0430\u043d\u0441\u0438. \u0412 \u043b\u0438\u0446\u0435\u0435 \u0435\u0433\u043e
    \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438 \u043a\u0430\u043a \u043f\u0440\u0438\u043b\u0435\u0436\u043d\u043e\u0433\u043e
    \u0438 \u043b\u044e\u0431\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430, \u0430 \u043e\u0434\u043d\u043e \u0438\u0437
    \u0435\u0433\u043e \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439 \u043f\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c\u0443
    \u044f\u0437\u044b\u043a\u0443 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043d\u0430\u0437\u0432\u0430\u043b
    \u00ab\u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c \u0448\u0435\u0434\u0435\u0432\u0440\u043e\u043c\u00bb.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043f\u043e\u043d\u0430\u0447\u0430\u043b\u0443
    \u0435\u0433\u043e \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e \u0431\u044b\u043b\u0430
    \u0441\u043b\u043e\u0432\u0435\u0441\u043d\u043e\u0441\u0442\u044c, \u0430 \u043d\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442 \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b, \u043a\u043e\u0433\u0434\u0430
    \u043e\u0434\u0438\u043d \u0438\u0437 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u043b\u0438\u0446\u0435\u044f \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u0440\u0438 \u0438 \u0432\u0437\u0432\u043e\u043b\u043d\u043e\u0432\u0430\u043d\u043d\u043e
    \u0437\u0430\u044f\u0432\u0438\u043b: \"\u041c\u0430\u0434\u0430\u043c, \u0432\u0430\u0448
    \u0441\u044b\u043d \u0431\u0443\u0434\u0435\u0442 \u0432\u0435\u043b\u0438\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c!\". \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u044d\u0442\u043e, \u0410\u043d\u0440\u0438 \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0441\u043b\u043e\u0432\u0435\u0441\u043d\u043e\u0441\u0442\u0438 \u0438 5 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1871 \u0433\u043e\u0434\u0430 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0441\u0434\u0430\u043b
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u044b \u043d\u0430 \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u0441\u043b\u043e\u0432\u0435\u0441\u043d\u043e\u0441\u0442\u0438. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u043f\u0443\u0442\u044c \u043a \u043d\u0430\u0443\u043a\u0435 \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u044f\u043c\u043e\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u043c.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0444\u0440\u0430\u043d\u043a\u043e-\u043f\u0440\u0443\u0441\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b (1870\u20131871) \u041d\u0430\u043d\u0441\u0438 \u0431\u044b\u043b
    \u043e\u043a\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d \u043d\u0435\u043c\u0446\u0430\u043c\u0438.
    \u0428\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u0438\u043b\u0435\u0442\u043d\u0438\u0439
    \u0410\u043d\u0440\u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u043e\u0442\u0446\u0443
    \u0432 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0435 \u0434\u043b\u044f \u0440\u0430\u043d\u0435\u043d\u044b\u0445,
    \u0430 \u0437\u0430\u0442\u0435\u043c, \u043f\u043e\u0442\u0440\u044f\u0441\u0435\u043d\u043d\u044b\u0439
    \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0424\u0440\u0430\u043d\u0446\u0438\u0438,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430 \u0442\u0435\u043c\u0443: \"\u041a\u0430\u043a
    \u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u0446\u0438\u044f \u0432\u043e\u0437\u0432\u044b\u0441\u0438\u0442\u044c\u0441\u044f?\".
    \u0412 \u0442\u043e\u043c \u0436\u0435 1871 \u0433\u043e\u0434\u0443 \u043e\u043d \u0440\u0435\u0448\u0438\u043b
    \u0441\u0434\u0430\u0432\u0430\u0442\u044c \u044d\u043a\u0437\u0430\u043c\u0435\u043d \u043d\u0430
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u043d\u0430\u0443\u043a. \u0418 \u0437\u0434\u0435\u0441\u044c \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c
    \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0441\u0442\u044c:
    \u043e\u043f\u043e\u0437\u0434\u0430\u0432 \u0438 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e
    \u043f\u043e\u043d\u044f\u0432 \u0437\u0430\u0434\u0430\u043d\u0438\u0435, \u043e\u043d
    \u043f\u0440\u043e\u0432\u0430\u043b\u0438\u043b \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u0430\u0447\u0430\u0432 \u0438\u0437\u043b\u0430\u0433\u0430\u0442\u044c \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0434\u0440\u0443\u0433\u043e\u0439 \u0432\u043e\u043f\u0440\u043e\u0441. \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e,
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0437\u043d\u0430\u043b\u0438
    \u043e \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442\u0435 \u0438, \u0437\u0430\u043a\u0440\u044b\u0432
    \u0433\u043b\u0430\u0437\u0430 \u043d\u0430 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438,
    \u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u0435\u0433\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439
    \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u0443\u0441\u0442\u043d\u043e\u043c \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0435.\n\n\u26cf\ufe0f
    \u041d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b: \u041e\u0442
    \u0448\u0430\u0445\u0442 \u0434\u043e \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u044b \u0412
    \u043e\u043a\u0442\u044f\u0431\u0440\u0435 1873 \u0433\u043e\u0434\u0430 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435, \u0433\u0434\u0435
    \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0441\u0442\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0428\u0430\u0440\u043b\u044c \u042d\u0440\u043c\u0438\u0442. \u0417\u0430\u0442\u0435\u043c,
    \u043f\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0438, \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0413\u043e\u0440\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u044e
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430. \u042d\u0442\u043e \u0431\u044b\u043b
    \u0432\u0430\u0436\u043d\u044b\u0439 \u044d\u0442\u0430\u043f \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.
    \u041a\u0430\u0440\u044c\u0435\u0440\u0443 \u043e\u043d \u043d\u0430\u0447\u0438\u043d\u0430\u043b
    \u043d\u0435 \u043a\u0430\u043a \"\u0447\u0438\u0441\u0442\u044b\u0439\" \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a.
    \u041e\u043d \u0438\u0437\u0443\u0447\u0430\u043b \u0433\u0435\u043e\u043b\u043e\u0433\u0438\u044e,
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0448\u0430\u0445\u0442\u0430\u0445,
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0446\u0438\u0435\u0439
    \u0438 \u0433\u043e\u0440\u043d\u044b\u043c \u0434\u0435\u043b\u043e\u043c. \u0414\u0430\u0436\u0435
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0443\u0447\u0435\u0431\u044b \u0432 \u0413\u043e\u0440\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0441\u0432\u043e\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0432 1879
    \u0433\u043e\u0434\u0443 \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c. \u041e\u0434\u0438\u043d \u0438\u0437
    \u0447\u043b\u0435\u043d\u043e\u0432 \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438, \u0413\u0430\u0441\u0442\u043e\u043d
    \u0414\u0430\u0440\u0431\u0443, \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u0432 \u043d\u0435\u0439 \u0431\u044b\u043b\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430 \u0434\u043b\u044f \u00ab\u043c\u043d\u043e\u0433\u0438\u0445
    \u0445\u043e\u0440\u043e\u0448\u0438\u0445 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0439\u00bb.
    \u041f\u043e\u043b\u0443\u0447\u0438\u0432 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430,
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0433\u043e\u0440\u043e\u0434\u0430 \u041a\u0430\u043d (\u041d\u043e\u0440\u043c\u0430\u043d\u0434\u0438\u044f).
    \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c \u043e\u043d \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b
    \u0441\u0432\u043e\u044e \u0431\u0443\u0434\u0443\u0449\u0443\u044e \u0436\u0435\u043d\u0443,
    \u041b\u0443\u0438\u0437\u0443 \u041f\u0443\u043b\u0435\u043d \u0434\u2019\u0410\u043d\u0434\u0435\u0441\u0438.
    20 \u0430\u043f\u0440\u0435\u043b\u044f 1881 \u0433\u043e\u0434\u0430 \u043e\u043d\u0438
    \u043f\u043e\u0436\u0435\u043d\u0438\u043b\u0438\u0441\u044c. \u0423 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0447\u0435\u0442\u0432\u0435\u0440\u043e
    \u0434\u0435\u0442\u0435\u0439: \u0442\u0440\u0438 \u0434\u043e\u0447\u0435\u0440\u0438
    \u0438 \u0441\u044b\u043d.\n\n\U0001F680 \u0412 \u041f\u0430\u0440\u0438\u0436\u0435: \u0420\u0430\u0441\u0446\u0432\u0435\u0442
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0423\u0436\u0435 \u0432
    \u043e\u043a\u0442\u044f\u0431\u0440\u0435 1881 \u0433\u043e\u0434\u0430 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u0437\u0430\u043d\u044f\u0442\u044c \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0430
    \u0424\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0435 \u043d\u0430\u0443\u043a \u0432
    \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (\u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435). \u041f\u043e\u0437\u0436\u0435, \u0441
    1886 \u0433\u043e\u0434\u0430, \u043e\u043d \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b
    \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0415\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u0448\u043b\u0430 \u0432 \u0433\u043e\u0440\u0443. \u0412 1886 \u0433\u043e\u0434\u0443,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 32 \u043b\u0435\u0442, \u043e\u043d
    \u0441\u0442\u0430\u043b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0430 \u0432 \u044f\u043d\u0432\u0430\u0440\u0435
    1887 \u0433\u043e\u0434\u0430 \u0435\u0433\u043e \u0438\u0437\u0431\u0440\u0430\u043b\u0438
    \u0447\u043b\u0435\u043d\u043e\u043c \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u0421 1893 \u0433\u043e\u0434\u0430
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b
    \u0432 \u0411\u044e\u0440\u043e \u0434\u043e\u043b\u0433\u043e\u0442, \u0430 \u0441 1896
    \u0433\u043e\u0434\u0430 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.\n\n\U0001F91D \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438:
    \u0411\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u0441\u0442\u0432\u043e \u0438 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c,
    \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0431\u043b\u0430\u0433\u043e\u0440\u043e\u0434\u0441\u0442\u0432\u0430 \u0438 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e\u0441\u0442\u0438.
    \u041e\u043d \u0431\u044b\u043b \u0442\u0432\u0435\u0440\u0434 \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0441\u043f\u043e\u0440\u0430\u0445, \u043d\u043e \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u043e
    \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435
    \u043a \u043e\u043f\u043f\u043e\u043d\u0435\u043d\u0442\u0430\u043c \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0431\u044b\u043b \u0437\u0430\u043c\u0435\u0448\u0430\u043d \u0432 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u0430\u0445.
    \u041e\u0445\u043e\u0442\u043d\u043e \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u043c\u043e\u043b\u043e\u0434\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c. \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u0435\u043d
    \u0435\u0433\u043e \u044d\u043f\u0438\u0437\u043e\u0434 \u0441 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c. \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435
    \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u0434\u043e
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u043d\u043e\u0433\u0438\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f
