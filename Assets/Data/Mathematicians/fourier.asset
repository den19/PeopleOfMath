  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0416\u0430\u043d\u0430-\u0411\u0430\u0442\u0438\u0441\u0442\u0430 \u0416\u043e\u0437\u0435\u0444\u0430
    \u0424\u0443\u0440\u044c\u0435 \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0430\u0431\u043e\u0440 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439, \u0430
    \u0446\u0435\u043b\u0430\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0444\u0438\u0437\u0438\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430 \u043f\u043e\u0434\u0445\u043e\u0434 \u043a
    \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u0442\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f: \"\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0442\u0435\u043f\u043b\u0430\" \u0441 \u0435\u0451
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043e\u043c, \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435
    \u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u0430
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043a\u043b\u0438\u043c\u0430\u0442\u0430 \u0438 \u0442\u0435\u0440\u043c\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430.\n\n\U0001F4DC
    \"\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
    \u0442\u0435\u043f\u043b\u0430\" \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u043d\u043e\u0432\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0435
    \u043c\u0435\u0441\u0442\u043e \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0424\u0443\u0440\u044c\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u0442\u0435\u043f\u043b\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u044b\u043b\u0438\u043b\u0430\u0441\u044c
    \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u043e\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435. \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434.
    \u0412 1822 \u0433\u043e\u0434\u0443 \u0424\u0443\u0440\u044c\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u00ab\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u043e\u0440\u0438\u044f
    \u0442\u0435\u043f\u043b\u0430\u00bb (Th\u00e9orie analytique de la chaleur). \u042d\u0442\u043e\u0442
    \u0442\u0440\u0443\u0434 \u0441\u0442\u0430\u043b \u0438\u0442\u043e\u0433\u043e\u043c \u0435\u0433\u043e
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439,
    \u043d\u0430\u0447\u0430\u0442\u044b\u0445 \u0435\u0449\u0435 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u043e\u043c
    \u0432 \u0413\u0440\u0435\u043d\u043e\u0431\u043b\u0435. \u0423\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0442\u0435\u043f\u043b\u043e\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u043e\u0441\u0442\u0438.
    \u0424\u0443\u0440\u044c\u0435 \u0432\u044b\u0432\u0435\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0435\u0435
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435
    \u0442\u0435\u043f\u043b\u0430 \u0432 \u0442\u0432\u0435\u0440\u0434\u044b\u0445 \u0442\u0435\u043b\u0430\u0445.
    \u042d\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u0438
    \u0442\u0435\u043f\u043b\u0430, \u043d\u043e \u0438 \u0434\u043b\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u044f\u0432\u043b\u0435\u043d\u0438\u0439,
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u043c\u044b\u0445 \u0434\u0438\u0444\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430\u043c\u0438: \u043e\u0442 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043c\u043e\u043b\u0435\u043a\u0443\u043b \u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0434\u043e
    \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0432 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438,
    \u0433\u0435\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0434\u0430\u0436\u0435 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a\u0430\u0445. \u041c\u0435\u0442\u043e\u0434 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 (\u043c\u0435\u0442\u043e\u0434
    \u0424\u0443\u0440\u044c\u0435). \u0427\u0442\u043e\u0431\u044b \u0440\u0435\u0448\u0438\u0442\u044c
    \u043d\u043e\u0432\u043e\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435, \u0424\u0443\u0440\u044c\u0435
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u043e\u0449\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u2014 \u043c\u0435\u0442\u043e\u0434 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445. \u0421\u0443\u0442\u044c \u043c\u0435\u0442\u043e\u0434\u0430
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u043e\u0438\u0441\u043a\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0432 \u0432\u0438\u0434\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043a\u0430\u0436\u0434\u0430\u044f \u0438\u0437
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0442 \u043e\u0434\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439.
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0441\u0432\u0435\u0441\u0442\u0438
    \u0441\u043b\u043e\u0436\u043d\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443 \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445 \u043a \u0431\u043e\u043b\u0435\u0435
    \u043f\u0440\u043e\u0441\u0442\u044b\u043c \u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u043c
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c.\n\n\U0001F4C8 \u0420\u044f\u0434\u044b
    \u0424\u0443\u0440\u044c\u0435: \u0442\u0440\u0438\u0443\u043c\u0444 \u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0441\u043f\u043e\u0440 \u0414\u043b\u044f \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u0424\u0443\u0440\u044c\u0435
    \u043f\u043e\u043d\u0430\u0434\u043e\u0431\u0438\u043b\u043e\u0441\u044c \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u0448\u0430\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u0437\u0432\u0430\u043b
    \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0435\u043d\u043d\u044b\u0435 \u0441\u043f\u043e\u0440\u044b
    \u0441\u0440\u0435\u0434\u0438 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u043e\u0442\u043a\u0440\u044b\u043b \u043d\u043e\u0432\u0443\u044e
    \u0433\u043b\u0430\u0432\u0443 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0430\u043d\u0430\u043b\u0438\u0437\u0435. \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. \u0412 \u043e\u0441\u043d\u043e\u0432\u0435
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0424\u0443\u0440\u044c\u0435 \u043b\u0435\u0436\u0438\u0442
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0432 \u0432\u0438\u0434\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u0441\u0443\u043c\u043c \u0441\u0438\u043d\u0443\u0441\u043e\u0432 \u0438 \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u043a\u0430\u043a \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0440\u044f\u0434\u044b \u0424\u0443\u0440\u044c\u0435. \u041d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u0442\u0432\u043e
    \u0438 \u0441\u043a\u0435\u043f\u0441\u0438\u0441. \u0425\u043e\u0442\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0434\u0435\u0438 \u0440\u0430\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0432
    \u0442\u0430\u043a\u0438\u0435 \u0440\u044f\u0434\u044b \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438
    \u0438 \u0440\u0430\u043d\u0435\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0443 \u0414. \u0411\u0435\u0440\u043d\u0443\u043b\u043b\u0438), \u0438\u043c\u0435\u043d\u043d\u043e
    \u0424\u0443\u0440\u044c\u0435 \u043f\u0435\u0440\u0432\u044b\u043c \u043d\u0430\u0447\u0430\u043b
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c
    \u0438\u0445 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447 \u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u0442\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c
    \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043b\u044e\u0431\u0443\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u044e, \u0434\u0430\u0436\u0435
    \u0442\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0430 \u0440\u0430\u0437\u043d\u044b\u0445
    \u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u0437\u0430\u0434\u0430\u043d\u0430 \u0440\u0430\u0437\u043d\u044b\u043c\u0438
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c\u0438.
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u043c\u0435\u043b\u043e\u0435 \u0438
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435.
    \u041a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439 \u043c\u0435\u043c\u0443\u0430\u0440
    \u0432 1807 \u0433\u043e\u0434\u0443, \u0442\u0430\u043a\u0438\u0435 \u043a\u043e\u0440\u0438\u0444\u0435\u0438,
    \u043a\u0430\u043a \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0438 \u041b\u0430\u043f\u043b\u0430\u0441,
    \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u043b\u0438 \u0435\u0433\u043e \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u044e.
    \u041f\u043e\u0437\u0436\u0435 \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0424\u0443\u0440\u044c\u0435
    \u043d\u0435 \u0441\u043e\u0432\u0441\u0435\u043c \u0432\u0435\u0440\u043d\u043e \u0434\u043b\u044f
    \u0432\u0441\u0435\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043d\u043e \u0435\u0433\u043e
    \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0438\u043d\u0438\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043b\u0430
    \u0446\u0438\u043a\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 (\u0414\u0438\u0440\u0438\u0445\u043b\u0435,
    \u0420\u0438\u043c\u0430\u043d\u0430 \u0438 \u0434\u0440.), \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435. \u0421\u0435\u0433\u043e\u0434\u043d\u044f
    \u0440\u044f\u0434\u044b \u0424\u0443\u0440\u044c\u0435 \u2014 \u044d\u0442\u043e \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442.
    \u041e\u043d\u0438 \u043b\u0435\u0436\u0430\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439
    \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432,
    \u0441\u0436\u0430\u0442\u0438\u044f \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0430\u0443\u0434\u0438\u043e (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0444\u043e\u0440\u043c\u0430\u0442 JPEG), \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439 \u0441\u0442\u0440\u0443\u043d, \u0430
    \u0442\u0430\u043a\u0436\u0435 \u0432 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0435 (\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430
    \u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u043c\u043c \u0438 \u0434\u0430\u043d\u043d\u044b\u0445
    \u0423\u0417\u0418).\n\n\U0001F4D0 \u0412\u043a\u043b\u0430\u0434 \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0443
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b \u041f\u043e\u043c\u0438\u043c\u043e
    \u0440\u0430\u0431\u043e\u0442 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435, \u0424\u0443\u0440\u044c\u0435 \u0441\u0434\u0435\u043b\u0430\u043b
    \u0432\u0430\u0436\u043d\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0438
    \u0432 \"\u0447\u0438\u0441\u0442\u043e\u0439\" \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0424\u0443\u0440\u044c\u0435. \u0412 \u0441\u0432\u043e\u0438\u0445
    \u043b\u0435\u043a\u0446\u0438\u044f\u0445 \u0435\u0449\u0435 \u0432 1796 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \u0447\u0438\u0441\u043b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043a\u043e\u0440\u043d\u0435\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u043b\u0435\u0436\u0430\u0449\u0438\u0445
    \u043c\u0435\u0436\u0434\u0443 \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c\u0438 \u0433\u0440\u0430\u043d\u0438\u0446\u0430\u043c\u0438.
    \u042d\u0442\u043e\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0432 1820 \u0433\u043e\u0434\u0443, \u0432\u043e\u0448\u0435\u043b \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e
    \u043a\u0430\u043a \u043e\u0434\u043d\u0430 \u0438\u0437 \u0432\u0430\u0436\u043d\u044b\u0445
    \u0442\u0435\u043e\u0440\u0435\u043c \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u043d\u043e\u0441\u0438\u0442
    \u0435\u0433\u043e \u0438\u043c\u044f. \u0427\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b. \u0424\u0443\u0440\u044c\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u043e\u0441\u0442\u0438
    \u043c\u0435\u0442\u043e\u0434\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0434\u043b\u044f
    \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u0430 \u0435\u0433\u043e \u0438\u0442\u043e\u0433\u043e\u0432\u044b\u0439
    \u0442\u0440\u0443\u0434 \u043f\u043e \u044d\u0442\u043e\u0439 \u0442\u0435\u043c\u0435,
    \u00ab\u0410\u043d\u0430\u043b\u0438\u0437 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439\u00bb (Analyse des \u00e9quations
    d\u00e9termin\u00e9es), \u0431\u044b\u043b \u0438\u0437\u0434\u0430\u043d \u0443\u0436\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u0432
    1831 \u0433\u043e\u0434\u0443.\n\n\U0001F30D \u041f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u044b\u0439
    \u044d\u0444\u0444\u0435\u043a\u0442 \u0438 \u0442\u0435\u0440\u043c\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u041c\u0435\u043d\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b, \u043d\u043e
    \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u044b \u0440\u0430\u0431\u043e\u0442\u044b
    \u0424\u0443\u0440\u044c\u0435, \u0432\u044b\u0445\u043e\u0434\u044f\u0449\u0438\u0435 \u0437\u0430
    \u0440\u0430\u043c\u043a\u0438 \"\u0447\u0438\u0441\u0442\u043e\u0439\" \u043d\u0430\u0443\u043a\u0438
    \u0438 \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u0432\u0448\u0438\u0435
    \u0446\u0435\u043b\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f.
    \u041e\u0442\u0435\u0446 \u043a\u043b\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438.
    \u0412 1820-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0424\u0443\u0440\u044c\u0435 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f
    \u0442\u0435\u043f\u043b\u043e\u0432\u044b\u043c \u0431\u0430\u043b\u0430\u043d\u0441\u043e\u043c
    \u0417\u0435\u043c\u043b\u0438. \u041e\u043d \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0417\u0435\u043c\u043b\u044f, \u043f\u043e\u043b\u0443\u0447\u0430\u044f
    \u0442\u0435\u043f\u043b\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0442 \u0421\u043e\u043b\u043d\u0446\u0430,
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0445\u043e\u043b\u043e\u0434\u043d\u0435\u0435, \u0435\u0441\u043b\u0438 \u0431\u044b
    \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u044b.
    \u041e\u043d \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0432\u044b\u0432\u043e\u0434\u0443,
    \u0447\u0442\u043e \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u043a\u0430\u043a \u0438\u0437\u043e\u043b\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0431\u0430\u0440\u044c\u0435\u0440,
    \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044f \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0439
    \u0441\u0432\u0435\u0442, \u043d\u043e \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044f
    \u0442\u0435\u043f\u043b\u043e\u0432\u043e\u0435 \u0438\u0437\u043b\u0443\u0447\u0435\u043d\u0438\u0435
    \u0417\u0435\u043c\u043b\u0438. \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0432\u0430\u044f
    \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430 \u043f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u043e\u0433\u043e
    \u044d\u0444\u0444\u0435\u043a\u0442\u0430, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442
    \u0435\u0433\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043a\u043b\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438.
    \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0442\u0435\u0440\u043c\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044d\u0444\u0444\u0435\u043a\u0442\u0430. \u0412 1823 \u0433\u043e\u0434\u0443, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u0425\u0430\u043d\u0441\u0430 \u041a\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0430
    \u042d\u0440\u0441\u0442\u0435\u0434\u0430, \u0424\u0443\u0440\u044c\u0435 \u043e\u0442\u043a\u0440\u044b\u043b
    \u0442\u0435\u0440\u043c\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044d\u0444\u0444\u0435\u043a\u0442. \u041e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e, \u043d\u043e \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043e\u043d \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e\u043c
    \u0441\u0443\u043f\u0435\u0440\u043f\u043e\u0437\u0438\u0446\u0438\u0438, \u0438 \u0441\u043e\u0437\u0434\u0430\u043b
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0439
    \u0442\u0435\u0440\u043c\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442, \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u044b
    \u0434\u043b\u044f \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u0442\u0435\u0440\u043c\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u044d\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u043a\u0438. \u0418\u043c\u044f \u0424\u0443\u0440\u044c\u0435
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0432\u044b\u0431\u0438\u0442\u043e \u043d\u0430
    \u042d\u0439\u0444\u0435\u043b\u0435\u0432\u043e\u0439 \u0431\u0430\u0448\u043d\u0435, \u0430
    \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442
    \u043f\u0438\u0442\u0430\u0442\u044c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443 \u0438 \u0442\u0435\u0445\u043d\u0438\u043a\u0443 \u2014
    \u043e\u0442 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0434\u043e \u0441\u0436\u0430\u0442\u0438\u044f
    \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0445
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439."
  achievementsEn: "The scientific legacy of Jean-Baptiste Joseph Fourier is not just a set of discoveries, but a revolution in mathematics and physics that has permanently changed the approach to the difficult tasks, and its contribution can be divided into three main areas: \"Analytic Theory of Heat\" with its revolutionary mathematical apparatus, fundamental works in algebra and unexpected discoveries in climate physics and thermoelectricity.\n\n==History==The \"Analytic Theory of Heat\" and the creation of a new method is the central place in the scientific activity of Fourier, and its work on the theory of the spread of heat has led to the creation of a whole new approach in mathematical physics.This work was the result of his many years of research, which was initiated during the prefect's work in Grenoble, and the equation of heat conductivity. Furje produced a fundamental differential equation in private derivatives describing the heat spread in solid bodies.This equation has become a cornerstone not only for heat physics, but also for a large number of other phenomena described by diffuse processes, ranging from the movement of molecules and the spread of electricity to models in biology, geology and even social sciences. The method of dividing variables (Fourier method) has developed a powerful mathematical tool, the method of dividing variables, to solve the new equation.The essence of the method is to find a solution in the form of a function, each of which depends on only one variable, thus reducing the complexity of the problem in the private derivatives to a simpler ordinary differential equation.\n\nThe Fourier series: triumph and fundamental debate to implement their method, Furiere had to take a step that caused violent controversy among the greatest mathematicians of the time and opened a new chapter in the mathematical analysis. The presentation of functions is based on the presentation of arbitrary functions in the form of endless amounts of sinus and cosine, now known as the Fourier trigonometric series. Innovation and scepticism.Although some ideas of decomposition in such a series existed before (e.g., D. Bernulli), it was Furier who began to systematically apply them to physical tasks and argued that it was thus possible to imagine any function, even one that was presented in different analytical terms at different sites, a bold and revolutionary statement.When he introduced his first memoir in 1807, corifei like Lagrang and Laplas questioned him, and it later became clear that Furier's statement was not entirely true for all functions, but his attempt initiated a cycle of fundamental research (Dirichle, Riman et al.) that led to the theory of the functions of the real variable and the theory of multiples.Today, the Fourier series are not just an abstract mathematical tool; they are the basis for modern digital signal processing, image compression and audio (e.g. JPEG format), solutions to string fluctuations, and in medicine (cardiogram and ultrasound processing).\n\nIn addition to the work in mathematical physics, Furier made important discoveries in pure mathematics. Theorem Furier, in his lectures back in 1796, he formulated the theorem of the true roots of the algebra equation between the boundaries, which was published in 1820, was a historical one, which is one of the most important theorems of algebra and bears its name.The Furier studied the applicability of Newton's method for numerical resolution of equations, and his final work on the subject, \"Analise des équations détermines\", was published after his death in 1831.\n\nThe greenhouse effect and thermoelectricity are less known, but no less significant, of Furier's work, which goes beyond pure science and pre-empts whole scientific directions.He concluded that the atmosphere was acting as an isolation barrier by missing sunlight, but by delaying the Earth's thermal radiation, which was the first scientific formulation of the greenhouse effect mechanism, making it one of the founders of modern climatology.Not only did he describe it, but he also showed that he had a superposition, and he created the first working thermoelectric element, laying the foundation for future thermoelectric power, the name Furier was rightfully out on the Eiffel Tower, and his ideas continued to feed modern science and technology, ranging from climate models to data compression and digital technology."
  personalLifeRu: "\u041e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0416\u0430\u043d\u0430-\u0411\u0430\u0442\u0438\u0441\u0442\u0430
    \u0416\u043e\u0437\u0435\u0444\u0430 \u0424\u0443\u0440\u044c\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043e\u0447\u0435\u043d\u044c \u043c\u0430\u043b\u043e. \u041e\u043d \u043d\u0435 \u0431\u044b\u043b
    \u0436\u0435\u043d\u0430\u0442, \u0438 \u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432
    \u043d\u0435\u0442 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043e \u043a\u0430\u043a\u0438\u0445-\u043b\u0438\u0431\u043e
    \u0435\u0433\u043e \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f\u0445. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430
    \u043d\u0430\u0443\u043a\u0435, \u0430 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0431\u043b\u0438\u0437\u043a\u0430\u044f \u0441\u0432\u044f\u0437\u044c, \u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0435\u0441\u0442\u044c \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f, \u043d\u043e\u0441\u0438\u043b\u0430,
    \u043f\u043e \u0432\u0441\u0435\u0439 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438,
    \u043f\u043b\u0430\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440.\n\n\U0001F64F
    \u0420\u0430\u043d\u043d\u0435\u0435 \u0441\u0438\u0440\u043e\u0442\u0441\u0442\u0432\u043e
    \u0438 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u0440\u0435\u043b\u0438\u0433\u0438\u0438
    \u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0441\u0430\u043c\u043e\u0433\u043e
    \u0424\u0443\u0440\u044c\u0435 \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c \u0441 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438:
    \u043e\u043d \u0440\u0430\u043d\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439.
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c \u0443\u043c\u0435\u0440\u043b\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u0434\u0435\u0432\u044f\u0442\u044c \u043b\u0435\u0442,
    \u0430 \u043e\u0442\u0435\u0446 \u2014 \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c
    \u0433\u043e\u0434\u0443. \u0416\u043e\u0437\u0435\u0444 \u0431\u044b\u043b \u0434\u0435\u0432\u044f\u0442\u044b\u043c
    \u0438\u0437 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438 \u0434\u0435\u0442\u0435\u0439
    \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u043c \u0431\u0440\u0430\u043a\u0435 \u043f\u043e\u0440\u0442\u043d\u043e\u0433\u043e.
    \u042d\u0442\u043e \u0440\u0430\u043d\u043d\u0435\u0435 \u0441\u0438\u0440\u043e\u0442\u0441\u0442\u0432\u043e
    \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u043e
    \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u043f\u0443\u0442\u044c.
    \u041e\u043d \u0432\u043e\u0441\u043f\u0438\u0442\u044b\u0432\u0430\u043b\u0441\u044f \u043f\u0440\u0438
    \u0446\u0435\u0440\u043a\u0432\u0438, \u0438 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0434\u0430\u0436\u0435 \u0433\u043e\u0442\u043e\u0432\u0438\u043b\u0441\u044f
    \u043a \u0434\u0443\u0445\u043e\u0432\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u0435,
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u0432 \u0432 \u0431\u0435\u043d\u0435\u0434\u0438\u043a\u0442\u0438\u043d\u0441\u043a\u043e\u0435
    \u0430\u0431\u0431\u0430\u0442\u0441\u0442\u0432\u043e \u0421\u0435\u043d-\u0411\u0435\u043d\u0443\u0430-\u0441\u044e\u0440-\u041b\u0443\u0430\u0440.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u043e\u043d
    \u0442\u0430\u043a \u0438 \u043d\u0435 \u043f\u0440\u0438\u043d\u044f\u043b \u043c\u043e\u043d\u0430\u0448\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u0435\u0442\u043e\u0432 \u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u042d\u0442\u043e\u0442 \u0440\u0430\u043d\u043d\u0438\u0439 \u043e\u043f\u044b\u0442,
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043d\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0442\u043f\u0435\u0447\u0430\u0442\u043e\u043a \u043d\u0430 \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440,
    \u0441\u0434\u0435\u043b\u0430\u0432 \u0435\u0433\u043e \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u043c
    \u0438 \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u043d\u044b\u043c.\n\n\U0001F52C \u041d\u0430\u0443\u043a\u0430
    \u043a\u0430\u043a \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u0441\u0442\u044c
    \u0438 \u043d\u0435\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u043d\u0430\u044f \u0434\u0440\u0443\u0436\u0431\u0430
    \u0412\u0441\u044f \u0436\u0438\u0437\u043d\u044c \u0424\u0443\u0440\u044c\u0435 \u0431\u044b\u043b\u0430
    \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0446\u0435\u043b\u0438
    \u2014 \u043d\u0430\u0443\u0447\u043d\u043e\u043c\u0443 \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044e.
    \u0414\u0430\u0436\u0435 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0445\u043e\u0434\u0430 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u0435\u043c
    \u0430\u0440\u043c\u0438\u0438, \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u043b
    \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439. \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434, \u00ab\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0442\u0435\u043f\u043b\u0430\u00bb, \u0431\u044b\u043b
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d \u0432 \u0413\u0440\u0435\u043d\u043e\u0431\u043b\u0435,
    \u0433\u0434\u0435 \u043e\u043d, \u0437\u0430\u043d\u0438\u043c\u0430\u044f \u043f\u043e\u0441\u0442
    \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u0430, \u043e\u0442\u0434\u0430\u0432\u0430\u043b
    \u043d\u0430\u0443\u043a\u0435 \u0432\u0441\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u043d\u0438\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u043b\u0430
    \u0435\u0433\u043e \u0441 \u043c\u0438\u0440\u043e\u043c \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445
    \u043b\u0438\u0447\u043d\u044b\u0445 \u0447\u0443\u0432\u0441\u0442\u0432, \u2014 \u044d\u0442\u043e
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u041c\u0430\u0440\u0438-\u0421\u043e\u0444\u0438 \u0416\u0435\u0440\u043c\u0435\u043d.
    \u0424\u0443\u0440\u044c\u0435 \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u0432,
    \u043a\u0442\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u0443\u044e
    \u0436\u0435\u043d\u0449\u0438\u043d\u0443-\u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0432
    \u0442\u043e \u0432\u0440\u0435\u043c\u044f, \u043a\u043e\u0433\u0434\u0430 \u0434\u043b\u044f
    \u0436\u0435\u043d\u0449\u0438\u043d \u043f\u0443\u0442\u044c \u0432 \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443 \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0437\u0430\u043a\u0440\u044b\u0442. \u041e\u043d \u043f\u043e\u043c\u043e\u0433 \u0435\u0439
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0435
    \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0435
    \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u0439 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a. \u0412 \u0430\u0440\u0445\u0438\u0432\u0430\u0445 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c
    \u0438\u0445 \u043f\u0438\u0441\u044c\u043c\u0430. \u041e\u043d\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b, \u043d\u043e \u043e\u0434\u043d\u043e
    \u0438\u0437 \u043d\u0438\u0445, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0435
    \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e \u0434\u043e \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e
    \u0442\u0435\u043f\u043b\u043e\u0435 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u044c. \u0412 \u0434\u0440\u0443\u0433\u043e\u043c
    \u043f\u0438\u0441\u044c\u043c\u0435 \u0424\u0443\u0440\u044c\u0435 \u043f\u0440\u043e\u0441\u0438\u0442
    \u0432\u0440\u0430\u0447\u0430 \u043e \u043a\u043e\u043d\u0444\u0438\u0434\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u043e\u043c\u043e\u0449\u0438 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e
    \u00ab\u0434\u043e\u0440\u043e\u0433\u043e\u0433\u043e \u0434\u0440\u0443\u0433\u0430\u00bb,
    \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u044b\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u0441\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c, \u0445\u043e\u0442\u044f
    \u0438\u043c\u044f \u0434\u0440\u0443\u0433\u0430 \u043f\u0440\u044f\u043c\u043e \u043d\u0435
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f. \u0421\u043e\u0444\u0438 \u0416\u0435\u0440\u043c\u0435\u043d,
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c
    \u043e\u0442 \u0440\u0430\u043a\u0430 \u0433\u0440\u0443\u0434\u0438, \u0447\u0442\u043e
    \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u043e \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u0435\u0433\u043e \u0447\u0443\u0432\u0441\u0442\u0432,
    \u043d\u043e \u043d\u0435 \u0434\u0430\u0435\u0442 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0439
    \u0434\u043b\u044f \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0432\u044b\u0432\u043e\u0434\u043e\u0432."
  personalLifeEn: "Jean-Baptiste Joseph Fourier's personal life is very little known, and he was not married, and historians have no knowledge of any of his romantic passions; his life has been almost entirely devoted to science, and the only close connection to which reference is made has apparently been platonic.\n\nThe early orphanage and religious influence of the family life of Furier himself began with a tragedy: he lost his parents early; his mother died when he was nine years old and his father the following year; Joseph was the ninth of twelve children in the second marriage of a tailor; this early orphanhood determined much of his way; he was raised in the church, and for some time even prepared for a spiritual career by entering the Benedictine Abbey of Saint-Benua-sur-Louar.However, in the end, he never accepted the nun's vows and devoted himself entirely to mathematics, which was probably an early experience that left a mark on his character, making it closed and ascetic.\n\nScience, as the main passion and ununited friendship, Furier's whole life was subject to the same objective of scientific knowledge. Even during the Egyptian Napoleon camp, as an administrator and supplyer of the army, he took time for mathematical research. His main work, \"Analistic Theory of Heat\", was written in Grenoble, where he spent all his free time as a prefect.The only thread that linked him to a world of deep personal feelings was friendship with mathematician Marie-Sophie Germain, who was one of the few academicians who supported a talented female scientist at a time when women's journey to great science was virtually closed, who helped her to obtain permanent permission to attend the Academy of Sciences meetings, and their letters were kept in the archives.They are mostly formal, but one of them, written shortly before his death, contains an unusually warm treatment and signature."
  shortBioRu: "\u0416\u0430\u043d-\u0411\u0430\u0442\u0438\u0441\u0442 \u0416\u043e\u0437\u0435\u0444 \u0424\u0443\u0440\u044c\u0435
    (1768\u20131830) \u2014 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0438 \u0444\u0438\u0437\u0438\u043a,
    \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c
    \u0436\u0435 \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u043e\u0439 \u0438 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0439,
    \u043a\u0430\u043a \u0438 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f. \u041e\u043d \u043f\u0440\u043e\u0448\u0451\u043b
    \u043f\u0443\u0442\u044c \u043e\u0442 \u0441\u0438\u0440\u043e\u0442\u044b \u0438\u0437
    \u0431\u0435\u0434\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0438 \u0434\u043e \u0431\u0430\u0440\u043e\u043d\u0430
    \u0438\u043c\u043f\u0435\u0440\u0438\u0438 \u0438 \u043d\u0435\u043f\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044f \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u0430 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0444\u0438\u0437\u0438\u043a\u0443.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u0430 \u0435\u0433\u043e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0432\u0435\u0445\u0438 \u0436\u0438\u0437\u043d\u0438 \u0438 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0424\u0443\u0440\u044c\u0435 \u043c\u043e\u0436\u043d\u043e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0432 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0440\u044f\u0434\u043a\u0435: 1768, 21 \u043c\u0430\u0440\u0442\u0430: \u0420\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041e\u0441\u0435\u0440, \u0424\u0440\u0430\u043d\u0446\u0438\u044f,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u043f\u043e\u0440\u0442\u043d\u043e\u0433\u043e.
    ~1777: \u0420\u0430\u043d\u043e \u043e\u0441\u0438\u0440\u043e\u0442\u0435\u043b, \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u0435\u0432\u044f\u0442\u0438 \u043b\u0435\u0442
    \u0431\u044b\u043b \u043e\u0442\u0434\u0430\u043d \u043d\u0430 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435
    \u043e\u0440\u0433\u0430\u043d\u0438\u0441\u0442\u0443 \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0441\u043e\u0431\u043e\u0440\u0430. 1780-\u0435 \u0433\u0433.: \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u0430, \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0432\u043e\u0435\u043d\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443 \u0432
    \u041e\u0441\u0435\u0440\u0435, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0438
    \u0431\u0435\u043d\u0435\u0434\u0438\u043a\u0442\u0438\u043d\u0446\u044b. \u041f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. 1789: \u041e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u041f\u0430\u0440\u0438\u0436, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0441\u0432\u043e\u0439
    \u043f\u0435\u0440\u0432\u044b\u0439 \u043c\u0435\u043c\u0443\u0430\u0440 \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435.
    1794\u20131795: \u0421\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0412\u044b\u0441\u0448\u0435\u0439 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b (\u00c9cole Normale) \u0432 \u041f\u0430\u0440\u0438\u0436\u0435.
    1795: \u041d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 (\u00c9cole Polytechnique), \u0433\u0434\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438, \u0442\u0430\u043a\u0438\u043c\u0438
    \u043a\u0430\u043a \u0413\u0430\u0441\u043f\u0430\u0440 \u041c\u043e\u043d\u0436. 1798\u20131801:
    \u041f\u0440\u0438\u043d\u044f\u043b \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u043c
    \u043f\u043e\u0445\u043e\u0434\u0435 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430
    \u0411\u043e\u043d\u0430\u043f\u0430\u0440\u0442\u0430. \u0411\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0451\u043c \u041a\u0430\u0438\u0440\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430. 1801: \u0412\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u0438 \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0437\u0430
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430 \u043f\u043e \u0438\u0442\u043e\u0433\u0430\u043c \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0438
    \u2014 \"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0415\u0433\u0438\u043f\u0442\u0430\".
    1802\u20131814: \u041d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u043e\u043c
    \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0430 \u0418\u0437\u0435\u0440
    \u0441 \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0432 \u0413\u0440\u0435\u043d\u043e\u0431\u043b\u0435.
    \u0417\u0430\u043d\u0438\u043c\u0430\u043b \u044d\u0442\u043e\u0442 \u043f\u043e\u0441\u0442
    13 \u043b\u0435\u0442. 1807: \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439 \u043c\u0435\u043c\u0443\u0430\u0440
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u0442\u0435\u043f\u043b\u0430. 1808: \u041f\u043e\u043b\u0443\u0447\u0438\u043b \u0442\u0438\u0442\u0443\u043b
    \u0431\u0430\u0440\u043e\u043d\u0430 \u0438 \u0431\u044b\u043b \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0451\u043d
    \u043e\u0440\u0434\u0435\u043d\u043e\u043c \u041f\u043e\u0447\u0451\u0442\u043d\u043e\u0433\u043e
    \u043b\u0435\u0433\u0438\u043e\u043d\u0430. 1816: \u041f\u043e\u0441\u043b\u0435 \u043f\u0430\u0434\u0435\u043d\u0438\u044f
    \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0431\u044e\u0440\u043e \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0430
    \u0421\u0435\u043d\u0430 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435. 1817: \u0418\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. 1822: \u041e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u2014 \"\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0442\u0435\u043f\u043b\u0430\". \u0412 \u044d\u0442\u043e\u043c
    \u0436\u0435 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b \u043d\u0435\u043f\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c
    \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0451\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. 1826: \u0418\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u0438 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b \u0437\u0430 \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u0435\u0433\u0438\u043f\u0442\u043e\u043b\u043e\u0433\u0438\u0438. 1829: \u0418\u0437\u0431\u0440\u0430\u043d
    \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c \u043f\u043e\u0447\u0451\u0442\u043d\u044b\u043c
    \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. 1830, 16 \u043c\u0430\u044f:
    \u0421\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    \u043f\u043e\u0441\u043b\u0435 \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0441 \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u044b,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0443\u0441\u0443\u0433\u0443\u0431\u0438\u043b\u043e
    \u0435\u0433\u043e \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u0443\u044e \u0431\u043e\u043b\u0435\u0437\u043d\u044c.
    \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430 \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435
    \u041f\u0435\u0440-\u041b\u0430\u0448\u0435\u0437. --- \u0414\u0435\u0442\u0441\u0442\u0432\u043e,
    \u044e\u043d\u043e\u0441\u0442\u044c \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0416\u0430\u043d-\u0411\u0430\u0442\u0438\u0441\u0442 \u0416\u043e\u0437\u0435\u0444 \u0424\u0443\u0440\u044c\u0435
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 21 \u043c\u0430\u0440\u0442\u0430 1768 \u0433\u043e\u0434\u0430
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041e\u0441\u0435\u0440. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u043f\u043e\u0440\u0442\u043d\u044b\u043c,
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0436\u0438\u043b\u0430 \u0431\u0435\u0434\u043d\u043e.
    \u0420\u0430\u043d\u043e \u043e\u0441\u0438\u0440\u043e\u0442\u0435\u0432 (\u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u0432\u043e\u0441\u044c\u043c\u0438 \u0438\u043b\u0438 \u0434\u0435\u0432\u044f\u0442\u0438
    \u043b\u0435\u0442), \u043c\u0430\u043b\u044c\u0447\u0438\u043a \u043d\u0430\u0448\u0451\u043b
    \u043f\u0440\u0438\u044e\u0442 \u0432 \u0434\u043e\u043c\u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0441\u0442\u0430
    \u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u043c\u0443\u0437\u044b\u043a\u0438 \u043f\u0440\u0438
    \u043c\u0435\u0441\u0442\u043d\u043e\u043c \u0441\u043e\u0431\u043e\u0440\u0435. \u0421\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0441\u044b\u0433\u0440\u0430\u043b
    \u0435\u043f\u0438\u0441\u043a\u043e\u043f \u041e\u0441\u0435\u0440\u0430, \u0437\u0430\u043c\u0435\u0442\u0438\u0432\u0448\u0438\u0439
    \u043d\u0435\u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0440\u0435\u0431\u0435\u043d\u043a\u0430. \u041f\u043e \u0435\u0433\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438
    \u0424\u0443\u0440\u044c\u0435 \u0431\u044b\u043b \u043f\u0440\u0438\u043d\u044f\u0442 \u0432
    \u0432\u043e\u0435\u043d\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443 \u043f\u0440\u0438
    \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435 \u0431\u0435\u043d\u0435\u0434\u0438\u043a\u0442\u0438\u043d\u0446\u0435\u0432.
    \u0422\u0430\u043c \u043e\u043d \u0441 \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u043e\u043c
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439,
    \u0447\u0430\u0441\u0442\u043e \u0442\u0430\u0439\u043a\u043e\u043c \u043f\u0440\u043e\u0441\u044b\u043f\u0430\u044f\u0441\u044c
    \u043d\u043e\u0447\u044c\u044e, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438 \u0441\u0432\u0435\u0442\u0435
    \u043e\u0433\u0430\u0440\u043a\u043e\u0432 \u0447\u0438\u0442\u0430\u0442\u044c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0432\u043e\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430 \u0438\u043b\u0438 \u0430\u0440\u0442\u0438\u043b\u043b\u0435\u0440\u0438\u0441\u0442\u0430
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0430 \u0437\u0430\u043a\u0440\u044b\u0442\u0430:
    \u0432 \u0442\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0432 \u044d\u0442\u0438
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0435 \u043a\u043e\u0440\u043f\u0443\u0441\u0430
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0434\u0432\u043e\u0440\u044f\u043d. \u0415\u043c\u0443 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c
    \u0441\u0442\u0430\u0442\u044c \u043f\u043e\u0441\u043b\u0443\u0448\u043d\u0438\u043a\u043e\u043c
    \u0432 \u0430\u0431\u0431\u0430\u0442\u0441\u0442\u0432\u0435 \u0421\u0435\u043d-\u0411\u0435\u043d\u0443\u0430-\u0441\u044e\u0440-\u041b\u0443\u0430\u0440,
    \u043d\u043e \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u043e\u0441\u043b\u0435 \u043d\u0430\u0447\u0430\u043b\u0430
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    \u043e\u043d \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u044c.
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0438 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u043e\u0442\u043a\u0440\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u0434 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u043c
    \u0440\u0430\u0437\u043d\u043e\u0447\u0438\u043d\u0446\u0435\u043c \u043d\u043e\u0432\u044b\u0435
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438. \u0412 1794 \u0433\u043e\u0434\u0443,
    \u043a\u043e\u0433\u0434\u0430 \u0431\u044b\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0430
    \u0412\u044b\u0441\u0448\u0430\u044f \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430, \u0424\u0443\u0440\u044c\u0435 \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0435\u0451 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432, \u0430 \u0432\u0441\u043a\u043e\u0440\u0435
    \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c.
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0451\u043b \u0432
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0432\u0448\u0443\u044e\u0441\u044f
    \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443, \u0433\u0434\u0435 \u043d\u0430\u0447\u0430\u043b \u0447\u0438\u0442\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e \u0432\u044b\u0441\u0448\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0441\u043c\u0435\u043d\u0438\u0432 \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443
    \u0441\u0430\u043c\u043e\u0433\u043e \u0416\u043e\u0437\u0435\u0444\u0430-\u041b\u0443\u0438
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430. \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440\u043e\u0439, \u0440\u0430\u0431\u043e\u0442\u0430\u044f
    \u043d\u0430\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0412 1796 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \u0447\u0438\u0441\u043b\u0435 \u043a\u043e\u0440\u043d\u0435\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u043b\u0435\u0436\u0430\u0449\u0438\u0445
    \u043c\u0435\u0436\u0434\u0443 \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c\u0438 \u0433\u0440\u0430\u043d\u0438\u0446\u0430\u043c\u0438
    (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430 \u0432 1820).
    \u0415\u0433\u043e \u0438\u0442\u043e\u0433\u043e\u0432\u044b\u0439 \u0442\u0440\u0443\u0434
    \u043f\u043e \u044d\u0442\u043e\u0439 \u0442\u0435\u043c\u0435, \"\u0410\u043d\u0430\u043b\u0438\u0437
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439\",
    \u0431\u044b\u043b \u0438\u0437\u0434\u0430\u043d \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u0432 1831 \u0433\u043e\u0434\u0443.
    \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0430\u044f \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u044f
    \u0412 1798 \u0433\u043e\u0434\u0443 \u0424\u0443\u0440\u044c\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0415\u0433\u0438\u043f\u0435\u0442 \u0432 \u0441\u043e\u0441\u0442\u0430\u0432\u0435
    \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0438 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430.
    \u041e\u043d \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0438 \u043d\u0435\u043f\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0451\u043c
    \u041a\u0430\u0438\u0440\u0441\u043a\u043e\u0433\u043e \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u0441\u043e\u0437\u0434\u0430\u043d
    \u043f\u043e \u043e\u0431\u0440\u0430\u0437\u0446\u0443 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438. \u041d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u0442\u0440\u0451\u0445 \u043b\u0435\u0442 \u0432 \u0415\u0433\u0438\u043f\u0442\u0435
    \u043e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u043e\u0439, \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u044b\u0432\u0430\u044f
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u043e\u0440\u043e\u0445\u0430
    \u0438 \u043e\u0440\u0443\u0436\u0438\u044f \u0434\u043b\u044f \u0430\u0440\u043c\u0438\u0438,
    \u043d\u043e \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u044f. \u041e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0435\u043c\u0443\u0430\u0440\u043e\u0432 \u0438 \u0438\u0437\u0443\u0447\u0430\u043b
    \u0434\u0440\u0435\u0432\u043d\u0435\u0435\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0438\u0435
    \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0438. \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u0432 1801 \u0433\u043e\u0434\u0443,
    \u0424\u0443\u0440\u044c\u0435 \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0437\u0430
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0443 \u043a \u043f\u0435\u0447\u0430\u0442\u0438
    \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0433\u043e \u0442\u0440\u0443\u0434\u0430
    \"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0415\u0433\u0438\u043f\u0442\u0430\",
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b
    \u0441\u0443\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0441\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0438,
    \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043a \u043d\u0435\u043c\u0443 \u043e\u0431\u0448\u0438\u0440\u043d\u043e\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435.
    \u041f\u0440\u0435\u0444\u0435\u043a\u0442 \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0430
    \u0418\u0437\u0435\u0440 \u0438 \"\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0442\u0435\u043f\u043b\u0430\" \u0421 1802 \u043f\u043e
    1814 \u0433\u043e\u0434 \u0424\u0443\u0440\u044c\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u043f\u043e\u0441\u0442 \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u0430 (\u0433\u0443\u0431\u0435\u0440\u043d\u0430\u0442\u043e\u0440\u0430)
    \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0430 \u0418\u0437\u0435\u0440
    \u0432 \u0413\u0440\u0435\u043d\u043e\u0431\u043b\u0435. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u0443\u044e \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u0443\u044e
    \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0443, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0443\u044e
    \u043e\u0441\u0443\u0448\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u043e\u0442, \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0434\u043e\u0440\u043e\u0433 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0432\u043e\u043f\u0440\u043e\u0441\u044b, \u043e\u043d \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043d\u0430\u0443\u043a\u0443. \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u0413\u0440\u0435\u043d\u043e\u0431\u043b\u0435,
    \u0432\u0434\u0430\u043b\u0438 \u043e\u0442 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0445
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u0440\u0443\u0433\u043e\u0432,
    \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0442\u0435\u043f\u043b\u0430. \u0412 1807 \u0438 1811 \u0433\u043e\u0434\u0430\u0445 \u043e\u043d
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a \u043c\u0435\u043c\u0443\u0430\u0440\u044b
    \u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0438
    \u0442\u0435\u043f\u043b\u0430 \u0432 \u0442\u0432\u0451\u0440\u0434\u044b\u0445 \u0442\u0435\u043b\u0430\u0445.
    \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0435\u043c\u0443\u0430\u0440 \u0431\u044b\u043b
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043f\u0440\u0435\u043c\u0438\u0438 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438.
    \u042d\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0438
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0438\u0434\u0435\u0438:
    \u043e\u043d \u0432\u044b\u0432\u0435\u043b \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0442\u0435\u043f\u043b\u043e\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043c\u0435\u0442\u043e\u0434
    \u0435\u0433\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u0440\u0430\u0437\u043b\u0430\u0433\u0430\u044f
    \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f
    \u0432 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0440\u044f\u0434\u044b (\u0440\u044f\u0434\u044b \u0424\u0443\u0440\u044c\u0435). \u0412
    \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u043c\u043d\u043e\u0433\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430, \u0441\u043e\u043c\u043d\u0435\u0432\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0442\u0430\u043a\u0438\u043c\u0438 \u0440\u044f\u0434\u0430\u043c\u0438, \u0424\u0443\u0440\u044c\u0435
    \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b \u043d\u0430 \u0438\u0445 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u041d\u0430\u043a\u043e\u043d\u0435\u0446, \u0432 1822 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u0432 \u041f\u0430\u0440\u0438\u0436, \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 magnum opus \u2014 \"\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0442\u0435\u043f\u043b\u0430\". \u042d\u0442\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u043e\u0439 \u0434\u043b\u044f \u0446\u0435\u043b\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439.
    \u0412 \u043d\u0435\u0439 \u043e\u043d: \u041f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u043c\u0435\u0442\u043e\u0434 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445. \u0412\u0432\u0451\u043b \u0432
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435
    \u0440\u044f\u0434\u044b \u0424\u0443\u0440\u044c\u0435. \u0412\u043d\u0451\u0441 \u0432\u0430\u0436\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437. \u0421\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0442\u0435\u043f\u043b\u043e\u0432\u043e\u0433\u043e \u0438\u0437\u043b\u0443\u0447\u0435\u043d\u0438\u044f.
    \"\u041f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442\"
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441 \u0424\u0443\u0440\u044c\u0435 \u043a \u0442\u0435\u043f\u043b\u0443
    \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439. \u0412 1820-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0442\u0430\u0442\u044c\u0438,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u043b
    \u043e \u0442\u0435\u043f\u043b\u043e\u0432\u043e\u043c \u0431\u0430\u043b\u0430\u043d\u0441\u0435
    \u0417\u0435\u043c\u043b\u0438. \u041e\u043d \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0417\u0435\u043c\u043b\u044f, \u0431\u0443\u0434\u0443\u0447\u0438
    \u043d\u0430\u0433\u0440\u0435\u0432\u0430\u0435\u043c\u043e\u0439 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u043c\u0438 \u043b\u0443\u0447\u0430\u043c\u0438,
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0445\u043e\u043b\u043e\u0434\u043d\u0435\u0435, \u0447\u0435\u043c \u0435\u0441\u0442\u044c
    \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435. \u0412 \u043f\u043e\u0438\u0441\u043a\u0430\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \"\u043b\u0438\u0448\u043d\u0435\u0433\u043e\"
    \u0442\u0435\u043f\u043b\u0430 \u043e\u043d \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u0440\u043e\u043b\u044c \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u044b \u043a\u0430\u043a
    \u0438\u0437\u043e\u043b\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e \u0431\u0430\u0440\u044c\u0435\u0440\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0435\u0442
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0439 \u0441\u0432\u0435\u0442, \u043d\u043e
    \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0442\u0435\u043f\u043b\u043e\u0432\u043e\u0435
    \u0438\u0437\u043b\u0443\u0447\u0435\u043d\u0438\u0435. \u042d\u0442\u043e\u0442 \u0432\u044b\u0432\u043e\u0434,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u0445
    \u0421\u043e\u0441\u0441\u044e\u0440\u0430 \u0441\u043e \u0441\u0442\u0435\u043a\u043b\u044f\u043d\u043d\u044b\u043c\u0438
    \u0431\u0430\u043d\u043a\u0430\u043c\u0438, \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043f\u0435\u0440\u0432\u043e\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430 \u043f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u043e\u0433\u043e
    \u044d\u0444\u0444\u0435\u043a\u0442\u0430. \u041f\u043e\u043c\u0438\u043c\u043e \u044d\u0442\u043e\u0433\u043e,
    \u0424\u0443\u0440\u044c\u0435 \u0432 1823 \u0433\u043e\u0434\u0443 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442\u043a\u0440\u044b\u043b \u0442\u0435\u0440\u043c\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044d\u0444\u0444\u0435\u043a\u0442 \u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u0439
    \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0439 \u0442\u0435\u0440\u043c\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0412
    1817 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0435\u0440\u0438\u043f\u0435\u0442\u0438\u0439
    (\u0435\u0433\u043e \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0443\u0440\u0430 \u0431\u044b\u043b\u0430
    \u043e\u0442\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u0430 \u043a\u043e\u0440\u043e\u043b\u0451\u043c
    \u0432 1816 \u0433\u043e\u0434\u0443 \u0438\u0437-\u0437\u0430 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u0438
    \u0431\u043e\u043d\u0430\u043f\u0430\u0440\u0442\u0438\u0441\u0442\u0430), \u0424\u0443\u0440\u044c\u0435
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0432 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a. \u0412 1822 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0441\u0442\u0430\u043b \u0435\u0451 \u043d\u0435\u043f\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c
    \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0451\u043c, \u0430 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u044d\u0442\u0438\u043c \u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0433\u043b\u0430\u0432\u043e\u0439 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438. \u041d\u0430
    \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443 \u043e\u043d \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0441\u0438\u043b
    \u0440\u0435\u0447\u0438 \u0432 \u0447\u0435\u0441\u0442\u044c \u0443\u0448\u0435\u0434\u0448\u0438\u0445
    \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0443\u0447\u0451\u043d\u044b\u0445, \u0432
    \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0441\u0432\u043e\u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u043f\u043e \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439 \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0438
    \u0416\u0430\u043d\u0430-\u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0428\u0430\u043c\u043f\u043e\u043b\u044c\u043e\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0424\u0443\u0440\u044c\u0435 \u0432 \u044e\u043d\u043e\u0441\u0442\u0438
    \u043f\u043e\u043c\u043e\u0433 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u0435\u0433\u0438\u043f\u0442\u043e\u043b\u043e\u0433\u0438\u0435\u0439. \u0417\u0430\u0441\u043b\u0443\u0433\u0438
    \u0424\u0443\u0440\u044c\u0435 \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u044b
    \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438. \u041e\u043d \u043d\u043e\u0441\u0438\u043b
    \u0442\u0438\u0442\u0443\u043b \u0431\u0430\u0440\u043e\u043d\u0430, \u0431\u044b\u043b
    \u043a\u0430\u0432\u0430\u043b\u0435\u0440\u043e\u043c \u043e\u0440\u0434\u0435\u043d\u0430
    \u041f\u043e\u0447\u0451\u0442\u043d\u043e\u0433\u043e \u043b\u0435\u0433\u0438\u043e\u043d\u0430,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439
    \u043c\u0438\u0440\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a \u0438 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0435
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e.
    \u0415\u0433\u043e \u0438\u043c\u044f \u0432\u044b\u0431\u0438\u0442\u043e \u043d\u0430
    \u042d\u0439\u0444\u0435\u043b\u0435\u0432\u043e\u0439 \u0431\u0430\u0448\u043d\u0435. \u0416\u0430\u043d-\u0411\u0430\u0442\u0438\u0441\u0442
    \u0416\u043e\u0437\u0435\u0444 \u0424\u0443\u0440\u044c\u0435 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    16 \u043c\u0430\u044f 1830 \u0433\u043e\u0434\u0430 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u2014
    \u043e\u0442 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438
    \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432 \u0434\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438."
  shortBioEn: "Jean-Baptiste Joseph Fourier (1768-1830) is a French mathematician and physicist whose life was as full and dramatic as his scientific discoveries, who travelled from an orphan from a poor family to a baron of the empire and a mandatory secretary of the Paris Academy of Sciences, and his work was permanently altered by mathematical physics.The main milestones in the life and career of Furier's biography can be represented in chronological order: 1768, 21 March: Born in Oser, France, in the tailor's family. ~1777: Orphaned early, aged nine, was given to the organist of the local cathedral. 1780s: Thanks to the patronymic of the bishop, he entered the military school in Oser, which was held by Benedictinians.1789: He went to Paris to present his first memoir in algebra at the Academy of Sciences. 1794 - 1795: He became one of the first students and then a teacher of the newly founded Eécole Normal School in Paris. 1795: He began teaching at the Polytechnic School (École Polytechnique), where he worked with outstanding mathematicians, such as Gaspar Monge. 1798 - 1801: He took part in the Egyptian Napoleon Bonaparta camp.1801: Returned to France and was appointed to be responsible for the publication of a great work following the expedition, \"Descriptions of Egypt\". 1802-1814: Appointed Prefect of the Department of Izer with a centre in Grenoble, 13 years old. 1807: Presented his first memoir at the Paris Academy of Sciences on the theory of heat. 1808: Received the title of Baron and was awarded the Order of the Honorable Legion.1816: After Napoleon's fall, he was appointed Director of the Statistics Bureau of the Seine Department in Paris. 1817: Elected member of the Paris Academy of Sciences. 1822: Published his main work, \"Analytical Theory of Heat\". 1826: Elected member of the French Academy and Academy of Medicine for his work in Egyptology. 1829: Elected foreign honorary member of the Petersburg Academy of Sciences.1830, 16 May: Died in Paris after falling down the stairs, which aggravated his heart disease, buried in Per Lashes cemetery. --Region, youth and education, Jean-Baptiste Joseph Furier, born March 21, 1768 in Oser, his father was a tailor and his family lived in poverty. Early orphans (aged 8 or 9 years) and the boy found shelter in the house of an organist and music teacher at the local cathedral.He was given a unique role in his life by Bishop Oser, who noticed the extraordinary abilities of the child, and was admitted to a military school under the Benedictine monastery, where he persisted in math, often waking up at night to read books in the light of the lights, but his career as a military engineer or artilleryist was closed to him: in those days, only nobles were taken into these prestigious corps.He had to become an abbot in the Abbey of Saint-Benois-sur-Louar, but soon after the French Revolution he left the monastery, and the Revolution's scientific and academic career opened up new opportunities for a talented diverse. In 1794, when the High School was founded, Furier became one of her first students and soon a teacher.He then moved to the newly opened Polytechnic School, where he began to lecture on higher mathematics, replacing Joseph-Louis Lagrangha himself in that post; during that period, he was active in algebra, working on the theory of solving equations; in 1796, he set out the famous theory of the number of roots of the algebraic equation between the given borders (published in 1820).His final work on the subject, \"Analysis of Certain Equities\", was published after his death in 1831, and the Egyptian expedition in 1798 Fourier went to Egypt as part of Napoleon's grand scientific expedition, and he became one of the founders and a permanent secretary of the Cairo Institute, which was created on the model of the Paris Academy.For three years in Egypt, he has not only been involved in administrative work, organizing the production of gunpowder and weapons for the army, but has also continued his research, and has published several mathematical memoirs and studied ancient Egyptian monuments.When he returned to France in 1801, Furier was appointed to prepare for the publication of the great work \"The Description of Egypt\", which was to summarize all the scientific results of the expedition, and wrote to it an extensive historical introduction. \"The Prefect of the Department of Izer and the \"Analytic Theory of Heat\" from 1802 to 1814, Furier served as Prefect (Governor) of the Department of Iser in Grenoble.Despite the enormous administrative burden of draining the marshes, building roads and other economic issues, he did not leave science, and it was in Grenoble, far from the Paris academic community, that he began his main research on the theory of heat, and in 1807 and 1811, he presented memoirs to the Paris Academy of Science on the spread of heat in solid bodies.These works contained revolutionary ideas: he drew a differential equation of thermal conductivity and proposed a method for its solution, setting the initial conditions in trignometry series (the Furier series), while many mathematicians, including Lagrangha, questioned the possibility of presenting arbitrary functions in these series, Furier insisted on their universality.Finally, in 1822, after his return to Paris, he published his magnum popus, \"Analytic Theory of Heat\", which was the starting point for an entire field of mathematical physics and functional theory. In it he described in detail the method of dividing variables. He introduced into strict use the Fourier series. He made an important contribution to the dimensional analysis. He formulated the mathematical theory of thermal radiation.\"Parnic Effect\" and other scientific interests Furier's interest in heat was not limited to mathematics. In the 1820s he published articles discussing the Earth's thermal balance. He calculated that the Earth, being heated only by sunlight, should be much colder than it actually is.In his search for the source of excess heat, he considered the role of the atmosphere as an isolation barrier that transmits sunlight but delays thermal radiation; this conclusion, based on Sossür's experiments with glass banks, is considered to be the first scientific formulation of the greenhouse effect mechanism; in addition, Furier independently discovered the thermoelectric effect in 1823 and created the first operating thermoelectric element.In 1817 he was elected to the Paris Academy of Sciences in 1822 as its most important secretary and, in addition, as its actual head of French scientific life.In his post he gave speeches in honour of the lost scientists, including his colleague on the Egyptian expedition of Jean-François Shampollón, who was helped by Furier as a young man to take an interest in Egyptology; Furier was recognized as a baron in his life; he was a cavalier of the Order of the Honorable Legion; and he was a member of the world's leading academies, including the Petersburg Academy of Sciences and the Royal Society of London.His name was knocked out on the Eiffel Tower, and Jean-Baptiste Joseph Fourier died on 16 May 1830 in Paris, leaving behind a legacy that is at the heart of a vast part of modern science and technology, ranging from digital signal processing to the resolution of complex equations of mathematical physics."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0416\u0430\u043d\u0430-\u0411\u0430\u0442\u0438\u0441\u0442\u0430
    \u0416\u043e\u0437\u0435\u0444\u0430 \u0424\u0443\u0440\u044c\u0435 \u043f\u043e\u043b\u043d\u0430
    \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432
    \u0438 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u044b\u0445 \u0434\u0435\u0442\u0430\u043b\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u0445\u043e\u0434\u044f\u0442 \u0434\u0430\u043b\u0435\u043a\u043e
    \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u043e\u0440\u043c\u0443\u043b.\n\n\U0001F525
    1. \"\u041e\u0433\u043d\u0435\u043d\u043d\u0430\u044f\" \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u044c
    \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0442\u044c
    \u0424\u0443\u0440\u044c\u0435 \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0435\u0439 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e\u0439
    \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u044c\u044e \u0442\u0435\u043f\u043b\u043e\u043c
    \u2014 \u0442\u043e\u0439 \u0441\u0430\u043c\u043e\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043c\u0451\u0440\u0437
    \u0438 \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043b \u044d\u0442\u043e
    \u044d\u043a\u0441\u0442\u0440\u0430\u0432\u0430\u0433\u0430\u043d\u0442\u043d\u044b\u043c\u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438. \u041e\u043d \u043a\u0443\u0442\u0430\u043b\u0441\u044f
    \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u043e\u0451\u0432
    \u043e\u0434\u0435\u0436\u0434\u044b, \u0430 \u0435\u0433\u043e \u043a\u043e\u043c\u043d\u0430\u0442\u044b
    \u043e\u0442\u0430\u043f\u043b\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u0434\u043e \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0435
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438 \u043a\u0430\u043a \"\u0436\u0430\u0440\u0447\u0435
    \u0430\u0434\u0430\". \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0430\u0436\u0435
    \u043f\u043e\u043b\u0443\u043c\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0432\u0440\u0430\u0447\u0438 \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u043b\u0438
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c,
    \u0430 \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c \u0441\u0447\u0451\u0442\u0435
    \u0438 \u0430\u043d\u0435\u0432\u0440\u0438\u0437\u043c\u0443, \u0441\u0442\u0430\u0432\u0448\u0443\u044e
    \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438 \u0432
    1830 \u0433\u043e\u0434\u0443, \u0441 \u044d\u0442\u043e\u0439 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u043e\u0439
    \u043a \u0441\u0438\u043b\u044c\u043d\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0443.\n\n\U0001F3DB\ufe0f
    2. \"\u0422\u0430\u043d\u0446\u044b \u0441 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c\":
    \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u0430\u044f \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u0433\u0440\u0430 \u0424\u0443\u0440\u044c\u0435, \u0432\u0435\u0440\u043d\u044b\u0439
    \u0431\u043e\u043d\u0430\u043f\u0430\u0440\u0442\u0438\u0441\u0442, \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u043f\u043e\u0441\u0442 \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u0430 \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0430
    \u0418\u0437\u0435\u0440. \u041a\u043e\u0433\u0434\u0430 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d
    \u0432 1814 \u0433\u043e\u0434\u0443 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u0441\u0441\u044b\u043b\u043a\u0443 \u043d\u0430
    \u042d\u043b\u044c\u0431\u0443, \u0435\u0433\u043e \u043f\u0443\u0442\u044c \u043f\u0440\u043e\u043b\u0435\u0433\u0430\u043b
    \u0447\u0435\u0440\u0435\u0437 \u0413\u0440\u0435\u043d\u043e\u0431\u043b\u044c. \u041e\u043f\u0430\u0441\u0430\u044f\u0441\u044c
    \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0438 \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0435\u0442\u0430\u0446\u0438\u0438
    \u043f\u0435\u0440\u0435\u0434 \u043d\u043e\u0432\u044b\u043c\u0438 \u0432\u043b\u0430\u0441\u0442\u044f\u043c\u0438,
    \u0424\u0443\u0440\u044c\u0435 \u0445\u0438\u0442\u0440\u043e\u0441\u0442\u044c\u044e \u0438\u0437\u043c\u0435\u043d\u0438\u043b
    \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430,
    \u0438\u0437\u0431\u0435\u0436\u0430\u0432 \u0432\u0441\u0442\u0440\u0435\u0447\u0438. \u0412
    1815 \u0433\u043e\u0434\u0443 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d \u0442\u0440\u0438\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u043e
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e
    (\u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \"\u0421\u0442\u043e \u0434\u043d\u0435\u0439\"),
    \u0438 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u043b\u0430\u0441\u044c.
    \u041d\u0430 \u044d\u0442\u043e\u0442 \u0440\u0430\u0437, \u0436\u0435\u043b\u0430\u044f
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043b\u043e\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0440\u043e\u044f\u043b\u0438\u0441\u0442\u0430\u043c, \u0424\u0443\u0440\u044c\u0435 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b
    \u0434\u043b\u044f \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0437\u0430\u043f\u0438\u0441\u043a\u0443 \u043e \u0441\u0432\u043e\u0451\u043c \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432 \u0438... \u0432 \u043f\u0430\u043d\u0438\u043a\u0435
    \u0431\u0435\u0436\u0430\u043b \u0438\u0437 \u0433\u043e\u0440\u043e\u0434\u0430. \u0420\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043d\u043d\u044b\u0439
    \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u044f. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043a\u043e\u0433\u0434\u0430 \u0434\u0440\u0443\u0437\u044c\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0443 \"\u0418\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\" \u0424\u0443\u0440\u044c\u0435 \u043a
    \"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u044e \u0415\u0433\u0438\u043f\u0442\u0430\",
    \u043f\u0440\u043e\u043d\u0438\u043a\u043d\u0443\u0442\u043e\u0435 \u043f\u043e\u0445\u0432\u0430\u043b\u0430\u043c\u0438
    \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u044e, \u0433\u043d\u0435\u0432 \u0441\u043c\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043c\u0438\u043b\u043e\u0441\u0442\u044c. \u041c\u0430\u043b\u043e \u0442\u043e\u0433\u043e,
    \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d \u043f\u0440\u043e\u0441\u0442\u0438\u043b
    \u0424\u0443\u0440\u044c\u0435 \u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0435\u0433\u043e
    \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0430
    \u0420\u043e\u043d\u0430 \u2014 \u0435\u0449\u0451 \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u0439
    \u043f\u043e\u0441\u0442. \u0412\u043f\u0440\u043e\u0447\u0435\u043c, \u044d\u0442\u0430
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u0430\u0441\u044c
    \u0432\u0441\u0435\u0433\u043e \u043e\u043a\u043e\u043b\u043e \u0434\u0432\u0443\u0445 \u043c\u0435\u0441\u044f\u0446\u0435\u0432,
    \u0434\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0411\u043e\u043d\u0430\u043f\u0430\u0440\u0442\u0430
    \u043f\u0440\u0438 \u0412\u0430\u0442\u0435\u0440\u043b\u043e\u043e.\n\n\U0001F4D6 3. \u041d\u043e\u0447\u043d\u044b\u0435
    \u0437\u0430\u043d\u044f\u0442\u0438\u044f \u043f\u0440\u0438 \u0441\u0432\u0435\u0442\u0435
    \u043e\u0433\u0430\u0440\u043a\u043e\u0432 \u0422\u044f\u0433\u0430 \u043a \u0437\u043d\u0430\u043d\u0438\u044f\u043c
    \u0443 \u0424\u0443\u0440\u044c\u0435 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c
    \u0441 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    13 \u043b\u0435\u0442 \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u044c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439, \u0430 \u0432 14 \u043b\u0435\u0442
    \u0443\u0436\u0435 \u043e\u0441\u0432\u043e\u0438\u043b \u0432\u0435\u0441\u044c \u0448\u0435\u0441\u0442\u0438\u0442\u043e\u043c\u043d\u044b\u0439
    \u043a\u0443\u0440\u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439
    \u042d\u0442\u044c\u0435\u043d\u043e\u043c \u0411\u0435\u0437\u0443. \u0415\u0433\u043e
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u0435\u043b\u0438\u043a\u0430, \u0447\u0442\u043e \u043e\u043d, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c \u0432\u043e\u0435\u043d\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u043f\u0440\u0438 \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435,
    \u0441\u043e\u0431\u0438\u0440\u0430\u043b \u0432\u044b\u0431\u0440\u043e\u0448\u0435\u043d\u043d\u044b\u0435
    \u0441\u0432\u0435\u0447\u043d\u044b\u0435 \u043e\u0433\u0430\u0440\u043a\u0438, \u0447\u0442\u043e\u0431\u044b,
    \u0440\u0438\u0441\u043a\u0443\u044f \u0431\u044b\u0442\u044c \u043f\u043e\u0439\u043c\u0430\u043d\u043d\u044b\u043c,
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0443\u0447\u0438\u0442\u044c\u0441\u044f
    \u043f\u043e \u043d\u043e\u0447\u0430\u043c, \u043a\u043e\u0433\u0434\u0430 \u0432\u0441\u0435
    \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043f\u0430\u043b\u0438.\n\n\U0001F30D
    4. \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \"\u043f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u043e\u0433\u043e
    \u044d\u0444\u0444\u0435\u043a\u0442\u0430\" \u0438 CT-\u0441\u043a\u0430\u043d\u0435\u0440\u043e\u0432
    \u0424\u0443\u0440\u044c\u0435 \u2014 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043d\u043e \u0438 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u043f\u0435\u0440\u0432\u043e\u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430 \u043f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u043e\u0433\u043e
    \u044d\u0444\u0444\u0435\u043a\u0442\u0430. \u0418\u0437\u0443\u0447\u0430\u044f \u0442\u0435\u043f\u043b\u043e\u0432\u043e\u0439
    \u0431\u0430\u043b\u0430\u043d\u0441 \u0417\u0435\u043c\u043b\u0438, \u043e\u043d \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0442\u043e \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u043a\u0430\u043a \"\u0442\u0435\u043f\u043b\u043e\u0432\u0430\u044f \u043b\u043e\u0432\u0443\u0448\u043a\u0430\",
    \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u0441\u0442\u0435\u043a\u043b\u0443 \u0432 \u043f\u0430\u0440\u043d\u0438\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0435\u0442
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0439 \u0441\u0432\u0435\u0442, \u043d\u043e
    \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0442\u0435\u043f\u043b\u043e.
    \u0421\u0432\u043e\u0438 \u0432\u044b\u0432\u043e\u0434\u044b \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0432 1827 \u0433\u043e\u0434\u0443. \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0430\u0432\u0442\u043e\u0440\u043e\u043c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0442\u0435\u043f\u043b\u043e\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442,
    \u043a\u0430\u043a \u0442\u0435\u043f\u043b\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f
    \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u043b\u0430. \u0412 \u043d\u0430\u0448\u0438
    \u0434\u043d\u0438 \u044d\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c
    \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439
    \u0432 \u041c\u0420\u0422 \u0438 \u041a\u0422-\u0441\u043a\u0430\u043d\u0435\u0440\u0430\u0445.\n\n\U0001F9D1\u200d\U0001F3EB
    5. \u0423\u0447\u0438\u0442\u0435\u043b\u044c, \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0432\u0448\u0438\u0439
    \u043f\u043b\u0435\u044f\u0434\u0443 \u0433\u0435\u043d\u0438\u0435\u0432 \u0424\u0443\u0440\u044c\u0435
    \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0443\u0447\u0451\u043d\u044b\u043c, \u043d\u043e \u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u043c
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u043c. \u0412 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u043e\u043d \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043b
