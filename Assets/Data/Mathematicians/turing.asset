  achievementsRu: "\u0410\u043b\u0430\u043d \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b \u0434\u043b\u044f
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430,
    \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0441\u043d\u043e\u0432\u044b \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439,
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u044b\u0445 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432,
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430 \u0438 \u0434\u0430\u0436\u0435
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044e.\n\n\U0001F4DC \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043b\u043e\u0433\u0438\u043a\u0430 \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043c\u043e\u0441\u0442\u0438 (1936) \u0412 \u0441\u0432\u043e\u0435\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    1936 \u0433\u043e\u0434\u0430 \u00ab\u041e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043c\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445...\u00bb 24-\u043b\u0435\u0442\u043d\u0438\u0439 \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0442\u043e\u0447\u043a\u0443 \u0432 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u043a\u0430\u043a \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430
    \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438 (Entscheidungsproblem),
    \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0414\u0430\u0432\u0438\u0434\u043e\u043c
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c. \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0435\u0434\u0438\u043d\u043e\u0433\u043e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0433 \u0431\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c,
    \u0434\u043e\u043a\u0430\u0437\u0443\u0435\u043c\u043e \u0438\u043b\u0438 \u043d\u0435\u0442
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u043e\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435
    \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b. \u041f\u043e \u0441\u0443\u0442\u0438, \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u0443\u0434\u0443\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0435\u0442 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f.\n\n\u2699\ufe0f \u00ab\u041c\u0430\u0448\u0438\u043d\u0430
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430\u00bb \u0438 \u0442\u0435\u0437\u0438\u0441
    \u0427\u0435\u0440\u0447\u0430-\u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430 \u0427\u0442\u043e\u0431\u044b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u044d\u0442\u043e, \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u043e\u0449\u043d\u0435\u0439\u0448\u0443\u044e
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u0443\u044e \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e
    \u2014 \u00ab\u041c\u0430\u0448\u0438\u043d\u0443 \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430\u00bb.
    \u042d\u0442\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0441 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439
    \u043b\u0435\u043d\u0442\u043e\u0439 \u0438 \u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0439
    \u0433\u043e\u043b\u043e\u0432\u043a\u043e\u0439 \u043c\u043e\u0433\u043b\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c
    \u043b\u044e\u0431\u044b\u0435 \u043c\u044b\u0441\u043b\u0438\u043c\u044b\u0435 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b,
    \u0441\u0442\u0430\u0432 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u044c\u044e
    \u0434\u043b\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    \u0441\u0430\u043c\u043e\u0433\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b
    \u0442\u0435\u0437\u0438\u0441 \u0427\u0435\u0440\u0447\u0430-\u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430,
    \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u043b\u044e\u0431\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0432 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435 \u043c\u043e\u0436\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430,
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0430
    \u043d\u0430 \u041c\u0430\u0448\u0438\u043d\u0435 \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430.
    \u042d\u0442\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u0432\u0441\u0435\u0439 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u0442\u043e\u0433\u043e, \u0447\u0442\u043e
    \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c.\n\n\U0001F4BB
    \u041e\u0442 \u0442\u0435\u043e\u0440\u0438\u0438 \u043a \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435:
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u044b \u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u0412\u0437\u043b\u043e\u043c \u00ab\u042d\u043d\u0438\u0433\u043c\u044b\u00bb (1939\u20131945):
    \u0412 \u0446\u0435\u043d\u0442\u0440\u0435 \u0411\u043b\u0435\u0442\u0447\u043b\u0438-\u043f\u0430\u0440\u043a
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u0438 \u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435,
    \u0441\u043e\u0437\u0434\u0430\u0432 \u0434\u0435\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043b\u044c\u043d\u0443\u044e
    \u043c\u0430\u0448\u0438\u043d\u0443 \u00ab\u0411\u043e\u043c\u0431\u0430\u00bb. \u041e\u043d\u0430
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0430 \u0432 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0445
    \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430\u0445 \u0432\u0437\u043b\u0430\u043c\u044b\u0432\u0430\u0442\u044c
    \u043a\u043e\u0434 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u0439 \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043b\u044c\u043d\u043e\u0439
    \u043c\u0430\u0448\u0438\u043d\u044b \u00ab\u042d\u043d\u0438\u0433\u043c\u0430\u00bb, \u0447\u0442\u043e
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0438\u0441\u0445\u043e\u0434 \u0432\u043e\u0439\u043d\u044b
    \u0438, \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432,
    \u0441\u043f\u0430\u0441\u043b\u043e \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u044b \u0436\u0438\u0437\u043d\u0435\u0439.
    \u041f\u0440\u043e\u0435\u043a\u0442 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430
    (1945): \u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b \u0432 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043f\u0440\u043e\u0435\u043a\u0442 ACE (Automatic Computing Engine) \u2014 \u043e\u0434\u043d\u0443
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432 \u043c\u0438\u0440\u0435 \u043f\u043e\u043b\u043d\u044b\u0445
    \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0439 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430
    \u0441 \u0445\u0440\u0430\u043d\u0438\u043c\u043e\u0439 \u0432 \u043f\u0430\u043c\u044f\u0442\u0438
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0439. \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u041f\u041e (1948\u20131954): \u0412 \u041c\u0430\u043d\u0447\u0435\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u043e\u043d \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432 \u043c\u0438\u0440\u0435 \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043e\u0432, Ferranti Mark I, \u043d\u043e
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043b\u044f \u043d\u0435\u0433\u043e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u0432
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e
    \u043f\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e.\n\n\U0001F9E0
    \u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442
    \u0438 \u00ab\u0422\u0435\u0441\u0442 \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430\u00bb
    (1950) \u0412 \u0441\u0432\u043e\u0435\u0439 \u044d\u043f\u043e\u0445\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0442\u0430\u0442\u044c\u0435 \u00ab\u0412\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043c\u0430\u0448\u0438\u043d\u044b \u0438 \u0440\u0430\u0437\u0443\u043c\u00bb \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u0437\u0430\u0434\u0430\u043b\u0441\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c
    \u00ab\u041c\u043e\u0436\u0435\u0442 \u043b\u0438 \u043c\u0430\u0448\u0438\u043d\u0430 \u043c\u044b\u0441\u043b\u0438\u0442\u044c?\u00bb
    \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439 \u0434\u043b\u044f \u043e\u0442\u0432\u0435\u0442\u0430
    \u043d\u0430 \u043d\u0435\u0433\u043e. \u042d\u0442\u043e\u0442 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435
    \u00ab\u0422\u0435\u0441\u0442 \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430\u00bb: \u0435\u0441\u043b\u0438
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440 \u0432 \u0445\u043e\u0434\u0435 \u0434\u0438\u0430\u043b\u043e\u0433\u0430
    \u043c\u043e\u0436\u0435\u0442 \u0443\u0431\u0435\u0434\u0438\u0442\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u0447\u0442\u043e \u043e\u043d \u0442\u043e\u0436\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u0442\u043e \u0435\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0441\u0447\u0438\u0442\u0430\u0442\u044c
    \u00ab\u043c\u044b\u0441\u043b\u044f\u0449\u0438\u043c\u00bb. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0435\u0439
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430.\n\n\U0001F9EC \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044f: \u043c\u043e\u0440\u0444\u043e\u0433\u0435\u043d\u0435\u0437
    (1952) \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0436\u0438\u0437\u043d\u0438 \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u0437\u0430\u043d\u044f\u043b\u0441\u044f
    \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0435\u0439 \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u00ab\u0425\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043e\u0441\u043d\u043e\u0432\u0430 \u043c\u043e\u0440\u0444\u043e\u0433\u0435\u043d\u0435\u0437\u0430\u00bb.
    \u0412 \u043d\u0435\u0439 \u043e\u043d \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u043a\u0430\u043a \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f
    \u0434\u0432\u0443\u0445 \u0433\u0438\u043f\u043e\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432
    (\u043c\u043e\u0440\u0444\u043e\u0433\u0435\u043d\u043e\u0432) \u043c\u043e\u0433\u0443\u0442
    \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b, \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044e\u0449\u0438\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u044f\u0442\u0435\u043d
    \u043d\u0430 \u0448\u043a\u0443\u0440\u0435 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445
    \u0438\u043b\u0438 \u0444\u043e\u0440\u043c \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0430 \u0432\u0440\u0435\u043c\u044f \u0438
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u043d\u043e\u0432\u043e\u0433\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0432 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0413\u0435\u043d\u0438\u0439 \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430 \u0431\u044b\u043b
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e.
    \u0412 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0430
    \u041f\u0440\u0435\u043c\u0438\u044f \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430 (Turing
    Award) \u2014 \u0441\u0430\u043c\u0430\u044f \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0430\u044f
    \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u00ab\u041d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u043c\u0438\u0435\u0439 \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0435\u00bb."
  achievementsEn: "Alan Turing left behind a scientific legacy that defined the development of several fields of science, its achievements are fundamental to the modern world, encompassing the theoretical bases of computation, the creation of the first computers, the birth of artificial intelligence, and even biology.\n\n♪ Mathematical logic and computational creation (1936) In his famous 1936 work \"On Computable Numbers...\", 24-year-old Turing put a stop to the most important mathematical problem known as the resolution problem (Entscheidungsproblem) by David Gilbert. He proved that there was no single algorithm that could determine whether or not arbitrary approval was possible in the formal system.In fact, Turing has shown that there will always be mathematical problems that have no algorithmic solution.\n\nThe Turing Machine and the Church-Turing Sage to prove it, Turing created a powerful abstract design, Turing Machine. This hypothetical device with an endless tape and a readable head could perform any thought algorithm, becoming the ideal model for formalizing the very notion of algorithm.He also put forward Church-Turing's argument that any task that can be done in principle by algorithm can be solved in Turing Machine, which has become the cornerstone of all theoretical informatics, defining the fundamental boundaries of what can be calculated.\n\nFrom theory to practice: computers and cryptography of Enigma's hack (1939–1945): In the centre of Bletchley Park Turing has put its theoretical ideas into practice by creating a decryption machine called Bomba. It has allowed industrial hacking of the code of the German encryption machine Enigma, which has had a decisive effect on the outcome of the war and, according to historians, saved millions of lives.The first computer project (1945): After the war at the National Physical Laboratory, Turing developed the ACE (Automatic Computing Engineering) project, one of the world's first complete computer specifications with a stored program.==History==The creation of the software (1948–1954): At Manchester University, he worked not only to create one of the world's first commercial computers, Ferranti Mark I, but also to develop a programming system for him and to write the first-ever programming manual.\n\nIn his landmark article \"Can a machine think?\", Turing asked \"Can a machine think?\" and suggested a practical criterion for answering it. This criterion was called \"Test Turing\": if a computer can convince a person that he is a human being, it can be considered \"thinking.\"This work is considered fundamental to the whole field of artificial intelligence.\n\nMathematic biology: morphogenesis (1952) In recent years, Turing has taken up biology and published the work \"The Chemical Framework of Morphogenesis\", in which he showed, using differential equations, how two hypothetical chemicals (morphogens) can spontaneously create complex periodic structures that explain the formation of spots on the skin of animals or forms of limbs.His work for decades has been ahead of time and has become the basis for a new course in biology.\n\nThe recognition of Genius Turing was recognized postmortem, and he was honored with the Turing Award, which is the most prestigious award in the field of informatics, often referred to as the Nobel Prize for Informatics."
  personalLifeRu: "\U0001F476 \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0443\u0447\u0451\u0431\u0430:
    \u043f\u0443\u0442\u044c \u043a \u0433\u0435\u043d\u0438\u044e \u0410\u043b\u0430\u043d
    \u041c\u044d\u0442\u0438\u0441\u043e\u043d \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    23 \u0438\u044e\u043d\u044f 1912 \u0433\u043e\u0434\u0430 \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0435,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u043a\u043e\u043b\u043e\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430, \u0441\u043b\u0443\u0436\u0438\u0432\u0448\u0435\u0433\u043e
    \u0432 \u0418\u043d\u0434\u0438\u0438. \u041f\u0435\u0440\u0432\u044b\u0435 \u0447\u0435\u0442\u044b\u0440\u043d\u0430\u0434\u0446\u0430\u0442\u044c
    \u043b\u0435\u0442 \u0436\u0438\u0437\u043d\u0438 \u043e\u043d \u043f\u0440\u043e\u0432\u0451\u043b
    \u0432\u0434\u0430\u043b\u0438 \u043e\u0442 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439,
    \u0432\u043e\u0441\u043f\u0438\u0442\u044b\u0432\u0430\u044f\u0441\u044c \u0432 \u0448\u043a\u043e\u043b\u0430\u0445-\u0438\u043d\u0442\u0435\u0440\u043d\u0430\u0442\u0430\u0445.
    \u0415\u0433\u043e \u043d\u0435\u0437\u0430\u0443\u0440\u044f\u0434\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u0440\u0430\u043d\u043e, \u043d\u043e \u0448\u043a\u043e\u043b\u0430, \u0433\u0434\u0435
    \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0443\u043f\u043e\u0440 \u0434\u0435\u043b\u0430\u043b\u0441\u044f
    \u043d\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438
    \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u0435 \u043d\u0430\u0443\u043a\u0438,
    \u043d\u0435 \u0446\u0435\u043d\u0438\u043b\u0430 \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442\u043e\u0432.
    \u041e\u0434\u0438\u043d \u0438\u0437 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u0432
    \u0434\u0430\u0436\u0435 \u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f\u043c,
    \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0410\u043b\u0430\u043d \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f
    \u0431\u044b\u0442\u044c \"\u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u043c\",
    \u0442\u043e \u0447\u0430\u0441\u0442\u043d\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e \u2014 \u043f\u0443\u0441\u0442\u0430\u044f \u0442\u0440\u0430\u0442\u0430
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u044d\u0442\u043e, \u0432 15 \u043b\u0435\u0442 \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u0443\u0436\u0435 \u0440\u0435\u0448\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u0421\u043b\u0430\u0431\u043e\u0441\u0442\u0438 \u043f\u043e \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u043c
    \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c \u0441\u0442\u043e\u0438\u043b\u0438
    \u0435\u043c\u0443 \u043d\u0435\u0434\u043e\u0431\u043e\u0440\u0430 \u0431\u0430\u043b\u043b\u043e\u0432
    \u043d\u0430 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u044b\u0445 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u0445,
    \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043e \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u043d\u0435 \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436,
    \u0430 \u0432 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0438\u0439 \u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0432 1934 \u0433\u043e\u0434\u0443.\n\n\U0001F52C
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438
    \u0412 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u043d\u0430\u0448\u0451\u043b \u0441\u0440\u0435\u0434\u0443, \u0433\u0434\u0435 \u0435\u0433\u043e
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442 \u043c\u043e\u0433 \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c\u0441\u044f.
    \u0415\u0433\u043e \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c, \u0430 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439, \u0441\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u041c.\u0425.\u0410. \u041d\u044c\u044e\u043c\u0435\u043d, \u043a\u0443\u0440\u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043f\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u044f\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u0441\u043b\u0443\u0448\u0430\u043b \u0432 1935
    \u0433\u043e\u0434\u0443. \u0412 1936 \u0433\u043e\u0434\u0443, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430, \u043e\u043d \u0443\u0435\u0445\u0430\u043b
    \u0432 \u0421\u0428\u0410, \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u0433\u0434\u0435 \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c
    \u0431\u044b\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439
    \u043b\u043e\u0433\u0438\u043a \u0410\u043b\u043e\u043d\u0437\u043e \u0427\u0451\u0440\u0447.
    \u0422\u0430\u043c \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e.
    \u0421\u0440\u0435\u0434\u0438 \u043a\u043e\u043b\u043b\u0435\u0433 \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u0441\u043b\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u043d\u0435\u043b\u0435\u0433\u043a\u0438\u043c
    \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u043c. \u0415\u0433\u043e
    \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438 \u043c\u0430\u043d\u0435\u0440\u0430
    \u0440\u0430\u0431\u043e\u0442\u044b \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u0438 \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435:
    \u043e\u043d \u0441\u043b\u044b\u043b \"\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c
    \u043f\u0430\u0440\u043d\u0435\u043c\". \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0432\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u0447\u0438\u043d\u0438\u0442\u044c \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434
    \u0441\u043e \u0441\u043b\u0435\u0442\u0430\u044e\u0449\u0435\u0439 \u0446\u0435\u043f\u044c\u044e,
    \u043e\u043d \u0432\u044b\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043a\u0438,
    \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d\u0430
    \u0441\u043b\u0435\u0442\u0430\u0435\u0442, \u0438 \u0432 \u043d\u0443\u0436\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442 \u043f\u043e\u043f\u0440\u0430\u0432\u043b\u044f\u043b
    \u0435\u0451 \u0440\u0443\u043a\u043e\u0439. \u041e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0441 \u044d\u0442\u0438\u043c \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438
    \u0435\u0433\u043e \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u0443\u044e \u0433\u043b\u0443\u0431\u0438\u043d\u0443
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u0438 \u0434\u043e\u0431\u0440\u043e\u0442\u0443.
    \u041c\u0438\u043a \u0412\u0443\u0434\u0436\u0435\u0440, \u0440\u0430\u0431\u043e\u0442\u0430\u0432\u0448\u0438\u0439
    \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430
    \u0432 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438, \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b
    \u0435\u0433\u043e \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \"\u0441
    \u0437\u043e\u043b\u043e\u0442\u044b\u043c \u0441\u0435\u0440\u0434\u0446\u0435\u043c\",
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043d\u0435\u0442\u0435\u0440\u043f\u0435\u043b\u0438\u0432\u043e\u0441\u0442\u044c, \u0438
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0435\u0433\u043e \"\u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u0433\u0435\u043d\u0438\u0435\u043c,
    \u043d\u043e \u0438 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0434\u0436\u0435\u043d\u0442\u043b\u044c\u043c\u0435\u043d\u043e\u043c\".
    \u0414\u0440\u0443\u0433\u043e\u0439 \u043a\u043e\u043b\u043b\u0435\u0433\u0430, \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444
    \u0418\u0440\u0432\u0438\u043d\u0433 \u0413\u0443\u0434, \u043e\u0442\u043c\u0435\u0447\u0430\u043b,
    \u0447\u0442\u043e \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u043b\u044e\u0431\u0438\u043b
    \"\u043e\u0431\u0440\u0430\u0449\u0430\u0442\u044c \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u043d\u0430 \u043f\u0435\u0440\u0432\u043e\u043f\u0440\u0438\u0447\u0438\u043d\u044b, \u0438
    \u043d\u0430 \u043d\u0435\u0433\u043e \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u0432\u043b\u0438\u044f\u043b\u043e
    \u043e\u0431\u0449\u0435\u043f\u0440\u0438\u043d\u044f\u0442\u043e\u0435 \u043c\u043d\u0435\u043d\u0438\u0435\".
    \u041f\u043e\u0441\u043b\u0435\u0432\u043e\u0435\u043d\u043d\u044b\u0435 \u0433\u043e\u0434\u044b
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u041c\u0430\u043d\u0447\u0435\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0433\u0434\u0435 \u0432 1951 \u0433\u043e\u0434\u0443 \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.
    \u0415\u0433\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430 \u044d\u0442\u043e\u0433\u043e
    \u043f\u0435\u0440\u0438\u043e\u0434\u0430, \u0445\u0440\u0430\u043d\u044f\u0449\u0430\u044f\u0441\u044f
    \u0432 \u0430\u0440\u0445\u0438\u0432\u0430\u0445, \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442,
    \u0447\u0442\u043e \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043e\u0431\u0449\u0430\u043b\u0441\u044f
    \u0441\u043e \u043c\u043d\u043e\u0433\u0438\u043c\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438
    \u0443\u0447\u0451\u043d\u044b\u043c\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0427\u0451\u0440\u0447\u0430,
    \u041c\u043e\u0440\u0433\u0435\u043d\u0448\u0442\u0435\u0440\u043d\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445,
    \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044f \u0441\u0432\u043e\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u043c\u0430\u0448\u0438\u043d\u0430\u043c, \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443 \u0438 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438.\n\n\U0001F494
    \u041b\u0438\u0447\u043d\u0430\u044f \u0434\u0440\u0430\u043c\u0430: \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f,
    \u0441\u0443\u0434 \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u0430 \u0431\u044b\u043b\u0430
    \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u0430 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439.
    \u0415\u0449\u0451 \u0432 \u0448\u043a\u043e\u043b\u0435 \u043e\u043d \u043f\u0435\u0440\u0435\u0436\u0438\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c
    \u043a \u043e\u0434\u043d\u043e\u043a\u043b\u0430\u0441\u0441\u043d\u0438\u043a\u0443 \u041a\u0440\u0438\u0441\u0442\u043e\u0444\u0435\u0440\u0443
    \u041c\u043e\u0440\u043a\u043e\u043c\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f,
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b\u0430
    \u0435\u0433\u043e \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435 \u0441\u0432\u043e\u0435\u0439
    \u0433\u043e\u043c\u043e\u0441\u0435\u043a\u0441\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u041c\u043e\u0440\u043a\u043e\u043c \u0443\u043c\u0435\u0440 \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 18 \u043b\u0435\u0442, \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e
    \u043a \u043d\u0435\u043c\u0443 \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u043f\u0440\u043e\u043d\u0435\u0441
    \u0447\u0435\u0440\u0435\u0437 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c, \u043d\u0430\u0437\u0432\u0430\u0432
    \u0441\u0432\u043e\u044e \u0434\u0435\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043b\u044c\u043d\u0443\u044e
    \u043c\u0430\u0448\u0438\u043d\u0443 \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c.
    \u0412 1941 \u0433\u043e\u0434\u0443 \u0422\u044c\u044e\u0440\u0438\u043d\u0433 \u0441\u0434\u0435\u043b\u0430\u043b
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0432\u043e\u0435\u0439
    \u043a\u043e\u043b\u043b\u0435\u0433\u0435, \u0414\u0436\u043e\u0430\u043d \u041a\u043b\u0430\u0440\u043a,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u043d\u0430\u043b\u0430 \u043e \u0435\u0433\u043e
    \u043d\u0430\u043a\u043b\u043e\u043d\u043d\u043e\u0441\u0442\u044f\u0445, \u043d\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0430\u0441\u044c
    \u0432\u044b\u0439\u0442\u0438 \u0437\u0430 \u043d\u0435\u0433\u043e \u0437\u0430\u043c\u0443\u0436.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e\u0437\u0436\u0435 \u043e\u043d \u0441\u0430\u043c
    \u0440\u0430\u0441\u0442\u043e\u0440\u0433 \u043f\u043e\u043c\u043e\u043b\u0432\u043a\u0443,
    \u0440\u0435\u0448\u0438\u0432 \u043d\u0435 \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0442\u044c
    \u0435\u0451 \u0436\u0438\u0437\u043d\u044c \u0441 \u0441\u043e\u0431\u043e\u0439. \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442 \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    1952 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0422\u044c\u044e\u0440\u0438\u043d\u0433
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 19-\u043b\u0435\u0442\u043d\u0438\u043c
    \u0440\u0430\u0431\u043e\u0447\u0438\u043c \u0410\u0440\u043d\u043e\u043b\u044c\u0434\u043e\u043c
    \u041c\u044e\u0440\u0440\u0435\u0435\u043c. \u0423 \u043d\u0438\u0445 \u0437\u0430\u0432\u044f\u0437\u0430\u043b\u0438\u0441\u044c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0434\u0440\u0443\u0437\u044c\u044f \u041c\u044e\u0440\u0440\u0435\u044f \u043e\u0431\u0432\u043e\u0440\u043e\u0432\u0430\u043b\u0438
    \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0443 \u0443\u0447\u0451\u043d\u043e\u0433\u043e.
