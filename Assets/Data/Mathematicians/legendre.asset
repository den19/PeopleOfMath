  achievementsRu: "\u0412\u043a\u043b\u0430\u0434 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u043e\u0433\u0440\u043e\u043c\u0435\u043d \u0438 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0438. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f, \u0430 \u0446\u0435\u043b\u044b\u0435
    \u0437\u0434\u0430\u043d\u0438\u044f \u0437\u043d\u0430\u043d\u0438\u0439, \u043d\u0430
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u0442\u0440\u043e\u0438\u043b\u0438 \u0441\u0432\u043e\u0438
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f \u0443\u0447\u0451\u043d\u044b\u0445.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b
    \u0435\u0433\u043e \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f,
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u043e
    \u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u043c.\n\n\U0001F522
    \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0447\u0438\u0441\u0435\u043b, \u0441\u0434\u0435\u043b\u0430\u0432
    \u0435\u0451 \u0431\u043e\u043b\u0435\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0439 \u0438
    \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439 \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f.
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434: \u0415\u0433\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u00ab\u041e\u043f\u044b\u0442 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b\u00bb (Essai sur la th\u00e9orie des nombres, 1798), \u043f\u043e\u0437\u0436\u0435
    \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u0430\u044f \u0432
    \u0434\u0432\u0443\u0445\u0442\u043e\u043c\u043d\u0438\u043a \u00ab\u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b\u00bb (Th\u00e9orie des nombres, 1830), \u0441\u0442\u0430\u043b\u0430
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0435\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0435\u0439
    \u0437\u043d\u0430\u043d\u0438\u0439 \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.
    \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u0437\u0430\u043a\u043e\u043d
    \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438: \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u044d\u0442\u043e\u0442
    \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0439 \u0437\u0430\u043a\u043e\u043d \u0438 \u0432\u0432\u0451\u043b
    \u0434\u043b\u044f \u0435\u0433\u043e \u0443\u0434\u043e\u0431\u043d\u043e\u0433\u043e \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0441\u0438\u043c\u0432\u043e\u043b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430. \u0425\u043e\u0442\u044f
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0434\u0430\u043b
    \u0413\u0430\u0443\u0441\u0441, \u0440\u0430\u0431\u043e\u0442\u0430 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    \u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b: \u0412 1798 \u0433\u043e\u0434\u0443 \u043e\u043d \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b
    \u0441\u043c\u0435\u043b\u0443\u044e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u043e\u0431
    \u0430\u0441\u0438\u043c\u043f\u0442\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0437\u0430\u043a\u043e\u043d\u0435 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430
    \u043b\u0438\u0448\u044c \u0441\u043f\u0443\u0441\u0442\u044f \u043f\u043e\u0447\u0442\u0438
    100 \u043b\u0435\u0442, \u0432 1896 \u0433\u043e\u0434\u0443. \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0434\u043b\u044f n=5: \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0443 \u0443\u0434\u0430\u043b\u043e\u0441\u044c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u044c
    \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0424\u0435\u0440\u043c\u0430
    \u0434\u043b\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    n=5 (\u044d\u0442\u043e \u0436\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0438 \u0414\u0438\u0440\u0438\u0445\u043b\u0435).\n\n\U0001F4D0 \u042d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u042d\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0434\u0435\u043b\u043e\u043c \u0436\u0438\u0437\u043d\u0438
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u0438 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e
    \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443.
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434: \u0415\u0433\u043e \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u044b\u0439
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e\u0431 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445\u00bb (Trait\u00e9 des fonctions elliptiques,
    1825\u20131832) \u0441\u0442\u0430\u043b \u043a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439
    \u0435\u0433\u043e \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f: \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043f\u0440\u043e\u0434\u0435\u043b\u0430\u043b \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432,
    \u0441\u0432\u0435\u0434\u044f \u0438\u0445 \u043a \u0442\u0440\u0451\u043c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c
    \u0444\u043e\u0440\u043c\u0430\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u043d\u043e\u0441\u044f\u0442 \u0435\u0433\u043e \u0438\u043c\u044f. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0438\u0445 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439.
    \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b: \u041f\u043e\u0447\u0442\u0438
    \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0445\u043e\u0434\u0430
    \u0435\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0430, \u0440\u0430\u0431\u043e\u0442\u044b
    \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u0433\u0435\u043d\u0438\u0435\u0432 \u2014 \u0410\u0431\u0435\u043b\u044f
    \u0438 \u042f\u043a\u043e\u0431\u0438 \u2014 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438,
    \u043f\u0435\u0440\u0435\u0439\u0434\u044f \u043a \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c (\u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c
    \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0438). \u041e\u0434\u043d\u0430\u043a\u043e
    \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u0440\u0443\u0434\u044b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u0441\u0442\u0430\u043b\u0438 \u0442\u0435\u043c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u043d\u0438 \u0441\u0442\u0440\u043e\u0438\u043b\u0438
    \u0441\u0432\u043e\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f.\n\n\U0001F4C8
    \u041c\u0435\u0442\u043e\u0434 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432 \u041f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f
    \u0438 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442: \u0412 1806 \u0433\u043e\u0434\u0443
    \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043a \u0441\u0432\u043e\u0435\u0439
    \u043a\u043d\u0438\u0433\u0435 \u043e \u043a\u043e\u043c\u0435\u0442\u043d\u044b\u0445 \u043e\u0440\u0431\u0438\u0442\u0430\u0445
    (\u00abNouvelles m\u00e9thodes pour la d\u00e9termination des orbites des com\u00e8tes\u00bb)
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432, \u043d\u0430\u0437\u0432\u0430\u0432
    \u0435\u0433\u043e \u00abm\u00e9thode des moindres carr\u00e9s\u00bb. \u042d\u0442\u043e\u0442
    \u043c\u0435\u0442\u043e\u0434 \u0441\u0442\u0430\u043b \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438, \u0440\u0435\u0433\u0440\u0435\u0441\u0441\u0438\u043e\u043d\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438
    \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432. \u0421\u043f\u043e\u0440 \u0441 \u0413\u0430\u0443\u0441\u0441\u043e\u043c:
    \u041f\u043e\u0437\u0436\u0435 \u0413\u0430\u0443\u0441\u0441 \u0437\u0430\u044f\u0432\u0438\u043b,
    \u0447\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u044d\u0442\u043e\u0442
    \u043c\u0435\u0442\u043e\u0434 \u0435\u0449\u0451 \u0432 1795 \u0433\u043e\u0434\u0443,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u043c\u0443
    \u0441\u043f\u043e\u0440\u0443 \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u0434\u0430\u043b \u043c\u0435\u0442\u043e\u0434\u0443 \u0438\u043c\u044f \u0438 \u0432\u0432\u0451\u043b
    \u0435\u0433\u043e \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043e\u0431\u0438\u0445\u043e\u0434.\n\n\U0001F9D1\u200d\U0001F3EB
    \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u00ab\u041d\u0430\u0447\u0430\u043b\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb:
    \u0415\u0433\u043e \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u00ab\u041d\u0430\u0447\u0430\u043b\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb (\u00c9l\u00e9ments de g\u00e9om\u00e9trie,
    1794) \u0441\u0442\u0430\u043b \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0432 \u043c\u0438\u0440\u0435
    \u043d\u0430 \u0446\u0435\u043b\u043e\u0435 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0435.
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0438 \u0443\u043f\u0440\u043e\u0441\u0442\u0438\u043b \u0442\u0440\u0443\u0434\u044b \u0415\u0432\u043a\u043b\u0438\u0434\u0430,
    \u0441\u0434\u0435\u043b\u0430\u0432 \u0438\u0445 \u0431\u043e\u043b\u0435\u0435 \u043b\u043e\u0433\u0438\u0447\u043d\u044b\u043c\u0438
    \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432.
    \u0412 \u0421\u0428\u0410 \u044d\u0442\u043e\u0442 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u0432, \u043e\u0434\u0438\u043d \u0438\u0437
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u2014 33 \u0438\u0437\u0434\u0430\u043d\u0438\u044f.\n\n\U0001F9F2
    \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430 \u0420\u0430\u0431\u043e\u0442\u044b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0441\u0442\u0430\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447 \u0432 \u0444\u0438\u0437\u0438\u043a\u0435 \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0438\u0438.
    \u041c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u044b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430:
    \u0412\u0432\u0435\u0434\u0451\u043d\u043d\u044b\u0435 \u0432 1784 \u0433\u043e\u0434\u0443
    \u043f\u0440\u0438 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0438 \u043f\u0440\u0438\u0442\u044f\u0436\u0435\u043d\u0438\u044f
    \u0441\u0444\u0435\u0440\u043e\u0438\u0434\u043e\u0432, \u043e\u043d\u0438 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0432\u0430\u0436\u043d\u043e\u0433\u043e
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. \u0421\u0435\u0433\u043e\u0434\u043d\u044f
    \u043e\u043d\u0438 \u0448\u0438\u0440\u043e\u043a\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f
    \u0432 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0435,
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435
    (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u0430 \u0434\u043b\u044f \u0430\u0442\u043e\u043c\u0430
    \u0432\u043e\u0434\u043e\u0440\u043e\u0434\u0430) \u0438 \u0432 \u0441\u043f\u0435\u043a\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u043c\u0435\u0442\u043e\u0434\u0430\u0445 \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430:
    \u042d\u0442\u043e\u0442 \u043c\u043e\u0449\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u044c \u043e\u0442 \u043e\u0434\u043d\u0438\u0445
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043a \u0434\u0440\u0443\u0433\u0438\u043c
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0442 \u043b\u0430\u0433\u0440\u0430\u043d\u0436\u0438\u0430\u043d\u0430
    \u043a \u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0438\u0430\u043d\u0443 \u0432
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435)
    \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0438\u043c
    \u0432 \u0442\u0435\u0440\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435 \u0434\u043b\u044f
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0442\u0430\u043a\u0438\u0445
    \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u043e\u0432, \u043a\u0430\u043a \u044d\u043d\u0442\u0430\u043b\u044c\u043f\u0438\u044f,
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u0430\u044f \u044d\u043d\u0435\u0440\u0433\u0438\u044f
    \u0413\u0435\u043b\u044c\u043c\u0433\u043e\u043b\u044c\u0446\u0430 \u0438 \u044d\u043d\u0435\u0440\u0433\u0438\u044f
    \u0413\u0438\u0431\u0431\u0441\u0430."
  achievementsEn: "Legendra's contribution to science is huge and covers several fundamental areas of mathematics and physics, and its work is not just a separate discovery, but an entire knowledge building, on which successive generations of scientists have built their research, and its major achievements, organized around thematic areas, are presented below.\n\nThe theory of numbers in Lejandr has systematized and significantly advanced the number theory, making it more rigorous and accessible to study. His basic work, \"Exai sur la théorie des nombres, 1798), which was later revised to a two-volume \"Théorie des nombres, 1830\", was the first comprehensive systematization of knowledge in this field.The Quadrant Law of Reciprocity: Legendr formulated this key law and introduced the Ledjandra symbol for its convenient designation. Although the firm proof was later given by Gauss, the work of Ledjandra became the basis for further research in this area.The theory of the distribution of prime numbers: In 1798, he made a bold hypothesis about the asymptotic law on the distribution of prime numbers, which was not strictly proven until nearly 100 years later, in 1896, proof for n=5: The Legandru was able to prove the imperviability of the Grand Farm Theorem for the measure of degree n=5 (the same evidence was independently obtained by Dirichle).\n\n♪ Elliptic integrals and functions ♪ This direction became the main life of Lejandra and brought him world glory. ♪ Basic work: his three-volume \"Traptat on Elliptic Functions\" (Traité des fonctions elliptiques, 1825–1832) was the culmination of his years of research ♪ Classification: Leghandre did a huge job of classifying elliptical integrations, reducing them to the three standard forms that his name is today.He also drew up detailed tables of their meanings: irony: Nearly immediately after the release of his tract, the work of young geniuses, Abel and Jacoby, revolutionized the field, moving to reverse functions (elliptic functions in the modern sense), but it was Lejandra's work that became the foundation on which they built their discoveries.\n\nPublication and priority: In 1806, in the annex to his book Nouvelles methodes pour la détermination des orbites des comètes, Legandre first published the method of least squares, calling it \"méthode des moindres carrés\".The dispute with Gauss: Gowss later stated that he had used this method since 1795, which led to a famous priority dispute, but it was Lejandr who gave the method a name and introduced it into scientific life.\n\n* Teaching and geometry: His textbook \"Starting Geometry\" (Engine of Geometry) became the main textbook on geometry in the world for a century. The Legandre reworked and simplified Euclid's work to make it more logical and accessible to students.\n\n====Lejandra======Lejandra works and mathematical physics in this field have become the basis for solving problems in physics and engineering.==Lejandra's many members: introduced in 1784 in the study of the attraction of spectroids, they are the solutions of an important differential equation.Today, they are widely used in electrostatics, quantum mechanics (including Schroedinger's solution for hydrogen atoms) and in spectral methods for numerical resolution of equations.Lejandra conversion: This powerful mathematical machine allows for a shift from some variables (e.g. Lagrangian to Hamiltonian in classical mechanics) and is fundamental in thermodynamics to identify potentials such as enthalpy, Helmgoltz free energy and Gibbs energy."
  personalLifeRu: "\u0410\u0434\u0440\u0438\u0435\u043d \u041c\u0430\u0440\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043f\u0440\u043e\u0436\u0438\u043b \u0434\u043e\u043b\u0433\u0443\u044e \u0436\u0438\u0437\u043d\u044c,
    \u0432\u043d\u0435\u0448\u043d\u0435 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u0443\u044e,
    \u043d\u043e \u043f\u043e\u043b\u043d\u0443\u044e \u0441\u043a\u0440\u044b\u0442\u044b\u0445
    \u0434\u0440\u0430\u043c \u2014 \u043e\u0442 \u043f\u043e\u0442\u0435\u0440\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    \u0434\u043e \u0433\u043e\u0440\u0435\u0447\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0441\u043f\u043e\u0440\u043e\u0432.\n\n\U0001F4DC \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435,
    \u0441\u0435\u043c\u044c\u044f \u0438 \u0443\u0447\u0451\u0431\u0430 \u0410\u0434\u0440\u0438\u0435\u043d
    \u041c\u0430\u0440\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    18 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1752 \u0433\u043e\u0434\u0430 \u0432
    \u041f\u0430\u0440\u0438\u0436\u0435 \u0432 \u0431\u043e\u0433\u0430\u0442\u043e\u0439 \u0441\u0435\u043c\u044c\u0435,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0435\u043c\u0443
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u041e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439 \u041a\u043e\u043b\u043b\u0435\u0436
    \u041c\u0430\u0437\u0430\u0440\u0438\u043d\u0438 (Coll\u00e8ge Mazarin) \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    \u0438 \u0432 1770 \u0433\u043e\u0434\u0443 \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0421 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u043d\u0430\u0443\u043a\u043e\u0439.\n\n\U0001F468\u200d\U0001F3EB
    \u041d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0412 1775 \u0433\u043e\u0434\u0443
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0432 \u0412\u043e\u0435\u043d\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 (\u00c9cole Militaire) \u0432 \u041f\u0430\u0440\u0438\u0436\u0435,
    \u0433\u0434\u0435 \u043f\u0440\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043e
    1780 \u0433\u043e\u0434\u0430. \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u0441\u0442\u0430\u0440\u0442\u043e\u043c \u0435\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b. \u0412 1783 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0447\u043b\u0435\u043d\u043e\u043c
    \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0432\u0430\u0436\u043d\u044b\u043c
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435\u043c \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442\u0430.
    \u0412 1795 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u044b,
    \u043e\u043d \u0441\u0442\u0430\u043b \u0442\u0430\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c.
    \u0412 1799 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u043c\u0435\u043d\u0438\u043b \u041f\u044c\u0435\u0440\u0430-\u0421\u0438\u043c\u043e\u043d\u0430
    \u041b\u0430\u043f\u043b\u0430\u0441\u0430 \u043d\u0430 \u043f\u043e\u0441\u0442\u0443 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u0442\u043e\u0440\u0430
    \u0432 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435, \u0430 \u0432 1816 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b
    \u0442\u0430\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u041e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b \u0441\u0432\u044f\u0437\u0430\u043d \u0441
    \u0411\u044e\u0440\u043e \u0434\u043e\u043b\u0433\u043e\u0442 (Bureau des Longitudes).\n\n\U0001F5FA\ufe0f
    \u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0438 \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0412 \u0433\u043e\u0434\u044b
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u041a\u043e\u043c\u0438\u0441\u0441\u0438\u0438
    \u043f\u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044e \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u0437\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c
    \u0442\u043e\u0447\u043d\u044b\u043c\u0438 \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f\u043c\u0438. \u0412 1787 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u041a\u0430\u0441\u0441\u0438\u043d\u0438
    \u0438 \u041c\u0435\u0448\u0435\u043d\u043e\u043c \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b
    \u0442\u0440\u0438\u0430\u043d\u0433\u0443\u043b\u044f\u0446\u0438\u044e \u0434\u043b\u044f
    \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0438 \u0413\u0440\u0438\u043d\u0432\u0438\u0447\u0441\u043a\u043e\u0439 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0439
    \u0438 \u0434\u0430\u0436\u0435 \u043f\u043e\u0441\u0435\u0442\u0438\u043b \u0423\u0438\u043b\u044c\u044f\u043c\u0430
    \u0413\u0435\u0440\u0448\u0435\u043b\u044f. \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u0435\u043c\u0443 \u0438 \u043b\u0438\u0447\u043d\u044b\u0435
    \u043f\u043e\u0442\u0440\u044f\u0441\u0435\u043d\u0438\u044f. \u0412 1793 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0441\u0432\u043e\u0451 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041c\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0435-\u041a\u043b\u043e\u0434\u0438\u043d
    \u041a\u0443\u044d\u043d, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u043c\u043e\u0433\u043b\u0430
    \u0435\u043c\u0443 \u043d\u0430\u043b\u0430\u0434\u0438\u0442\u044c \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F58B\ufe0f
    \u0412\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0451\u043d\u044b\u043c\u0438
    \u042d\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0435\u0433\u043e
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438, \u043f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u043e\u0435 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0435.
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \"\u0437\u043b\u043e\u0439 \u0440\u043e\u043a\" \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u044b\u0445
    \u0441\u043f\u043e\u0440\u043e\u0432. \u041a\u0430\u0440\u043b \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    \u0413\u0430\u0443\u0441\u0441: \u0421\u0430\u043c\u044b\u0439 \u043e\u0441\u0442\u0440\u044b\u0439
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0440\u0430\u0437\u0433\u043e\u0440\u0435\u043b\u0441\u044f
    \u0432\u043e\u043a\u0440\u0443\u0433 \u043c\u0435\u0442\u043e\u0434\u0430 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432. \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043f\u0435\u0440\u0432\u044b\u043c \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0432 1806 \u0433\u043e\u0434\u0443,
    \u043d\u0430\u0437\u0432\u0430\u0432 \u0435\u0433\u043e \u00abm\u00e9thode des moindres
    carr\u00e9s\u00bb. \u041e\u0434\u043d\u0430\u043a\u043e \u0413\u0430\u0443\u0441\u0441 \u0437\u0430\u044f\u0432\u0438\u043b,
    \u0447\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0435\u0433\u043e
    \u0441 1795 \u0433\u043e\u0434\u0430, \u043d\u043e \u043d\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b.
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u043e\u0431\u0438\u0436\u0435\u043d \u0442\u0435\u043c, \u0447\u0442\u043e \u0413\u0430\u0443\u0441\u0441
    \u0432 \u0441\u0432\u043e\u0435\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438
    1809 \u0433\u043e\u0434\u0430 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u0438\u043f\u0438\u0441\u0430\u043b \u043c\u0435\u0442\u043e\u0434 \u0441\u0435\u0431\u0435.
    \u0412 1820 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043f\u043e\u043b\u043d\u043e\u0435 \u0433\u043e\u0440\u0435\u0447\u0438 \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u043e\u0435
    \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435, \u0433\u0434\u0435 \u0432\u043e\u0437\u043c\u0443\u0449\u0430\u043b\u0441\u044f
    \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0413\u0430\u0443\u0441\u0441\u0430,
    \u043e\u0442\u043c\u0435\u0447\u0430\u044f, \u0447\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043d\u0430\u0443\u043a\u0438 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c\u0441\u044f
    \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c.
    \u0413\u0430\u0443\u0441\u0441, \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c,
    \u043d\u0435 \u0441\u043d\u0438\u0437\u043e\u0448\u0451\u043b \u0434\u043e \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0433\u043e
    \u043e\u0442\u0432\u0435\u0442\u0430, \u0447\u0442\u043e \u043b\u0438\u0448\u044c \u0443\u0441\u0438\u043b\u0438\u043b\u043e
    \u043e\u0431\u0438\u0434\u0443 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430. \u0410\u0431\u0435\u043b\u044c
    \u0438 \u042f\u043a\u043e\u0431\u0438: \u0415\u0449\u0451 \u043e\u0434\u0438\u043d \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0439
    \u0443\u0434\u0430\u0440 \u0431\u044b\u043b \u043d\u0430\u043d\u0435\u0441\u0451\u043d \u0435\u0433\u043e
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u043c \u0442\u0440\u0443\u0434\u0430\u043c
    \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u043c. \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b \u0433\u043e\u0434\u044b \u043d\u0430 \u0438\u0445
    \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e \u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446, \u043d\u043e \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435
    \u0432\u044b\u0445\u043e\u0434\u0430 \u0435\u0433\u043e \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u043e\u0433\u043e
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442\u0430 \u043e\u0431 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445\u00bb (1825\u20131832) \u043c\u043e\u043b\u043e\u0434\u044b\u0435
    \u0433\u0435\u043d\u0438\u0438 \u0410\u0431\u0435\u043b\u044c \u0438 \u042f\u043a\u043e\u0431\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e,
    \u043f\u0435\u0440\u0435\u0439\u0434\u044f \u043a \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c \u0438 \u0441\u0434\u0435\u043b\u0430\u0432
    \u0447\u0430\u0441\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u043c\u0435\u043d\u0435\u0435 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439.\n\n\U0001F625
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u041a\u043e\u043d\u0435\u0446 \u0436\u0438\u0437\u043d\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u0431\u044b\u043b \u043e\u043c\u0440\u0430\u0447\u0451\u043d \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u044f\u043c\u0438. \u0412 1824 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u043f\u0435\u043d\u0441\u0438\u044f \u0438\u0437 \u0412\u043e\u0435\u043d\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0430.
    \u041f\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439,
    \u044d\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0438\u0437-\u0437\u0430
    \u0431\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u0448\u0438\u0431\u043a\u0438, \u043f\u043e \u0434\u0440\u0443\u0433\u043e\u0439
    \u2014 \u0438\u0437-\u0437\u0430 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0430\u0442\u044c
    \u0437\u0430 \u043d\u0443\u0436\u043d\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430 \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u041b\u0438\u0448\u044c \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u043d\u044b \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0432 1828 \u0433\u043e\u0434\u0443 \u0435\u0433\u043e \u043f\u0435\u043d\u0441\u0438\u044f
    \u0431\u044b\u043b\u0430 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430.
    \u0412 1831 \u0433\u043e\u0434\u0443, \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438, \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d
    \u0437\u0432\u0430\u043d\u0438\u044f \u043e\u0444\u0438\u0446\u0435\u0440\u0430 \u041e\u0440\u0434\u0435\u043d\u0430
    \u041f\u043e\u0447\u0451\u0442\u043d\u043e\u0433\u043e \u043b\u0435\u0433\u0438\u043e\u043d\u0430.
    \u0410\u0434\u0440\u0438\u0435\u043d \u041c\u0430\u0440\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    9 \u044f\u043d\u0432\u0430\u0440\u044f 1833 \u0433\u043e\u0434\u0430 \u043f\u043e\u0441\u043b\u0435
    \u0434\u043e\u043b\u0433\u043e\u0439 \u0438 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0431\u043e\u043b\u0435\u0437\u043d\u0438. \u0415\u0433\u043e \u0432\u0434\u043e\u0432\u0430
    \u043f\u0435\u0440\u0435\u0436\u0438\u043b\u0430 \u0435\u0433\u043e \u0431\u043e\u043b\u0435\u0435
    \u0447\u0435\u043c \u043d\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044c \u043b\u0435\u0442
    \u0438 \u0431\u044b\u043b\u0430 \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d\u0430
    \u0440\u044f\u0434\u043e\u043c \u0441 \u043d\u0438\u043c \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435
    \u041e\u0442\u0435\u0439, \u0433\u0434\u0435 \u043e\u043d\u0438 \u0436\u0438\u043b\u0438.
    \u0418\u043c\u044f \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u043d\u0430\u0432\u0435\u0447\u043d\u043e
    \u0432\u044b\u0433\u0440\u0430\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u043d\u0430
    \u043f\u0435\u0440\u0432\u043e\u043c \u044d\u0442\u0430\u0436\u0435 \u042d\u0439\u0444\u0435\u043b\u0435\u0432\u043e\u0439
    \u0431\u0430\u0448\u043d\u0438 \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 72 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445 \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0430
    \u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0436\u0438\u0432\u0451\u0442
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440."
  personalLifeEn: "Adrien Marie Léjandr lived a long life, apparently calm, but full of hidden dramas — from loss of fortune during the Revolution to grief for scientific disputes.\n\n==Early life==The birth, family and studies of Adrian Marie Lejandr was born in Paris on September 18, 1752, in a wealthy family, which enabled him to receive an excellent education, and he graduated from the prestigious Collège Mazarini College in Paris, and in 1770, he defended his thesis in physics and mathematics.\n\n==Career==In 1775, Lejandr began teaching mathematics at the Military School in Paris, where he worked until 1780, which was the beginning of his professional career, and in 1783 he was elected a member of the Paris Academy of Sciences, which was an important recognition of his talent.In 1799 he succeeded Pierre-Simón Laplaces as an examiner at the Polytechnic School and in 1816 became a professor there, and he was also associated with the Longevity Bureau (Bureau des Longitudes).\n\nIn 1787, Lejandr was actively involved in the work of the Commission for the Implementation of the Metricular System, carrying out precise survey measurements. In 1787, he carried out a triangulation with Cassini and Meschen to connect the Paris and Greenwich Observatorys, and even visited William Gerschel, and the revolution also caused him personal shocks.That same year, he married Margarete-Claudin Quan, who helped him make a living.\n\n==History======Lejandra==================================================================================================================================================================================================================================================In 1820, he published an anonymous statement, in which he resented the behaviour of Gaussa, noting that the history of science should not be rewritten in this way, and in turn Gauss did not go down to the public answer, which only reinforced Lejandra's resentment.Abel and Jacoby: Another painful blow was inflicted by his years of work on elliptical integrals, and the Legendr spent years classifying them and compiling tables, but immediately after his three-volume \"Tactate on elliptical Functions\" (1825-1832), young genius Abel and Jacoby revolutionized, moving back to function and making part of the work of Lejandra less relevant.\n\nHis pension from the Military School was terminated in 1824, one of which was due to a bureaucratic error, the other because he refused to vote for a candidate for the French Institute, and only after the change of government in 1828 was his pension partially restored.In 1831, shortly before his death, he was awarded the rank of officer of the Order of the Honorable Legion, and Adrian Marie Lejandr died in Paris on 9 January 1833 after a long and painful illness, and his widow survived him for more than twenty years and was buried next to him in the village of Otei where they lived.The name Lejandra is permanently etched on the first floor of the Eiffel Tower on the list of the 72 greatest scientists in France, and its legacy lives in the mathematical concepts that we still use."
  shortBioRu: "\u0410\u0434\u0440\u0438\u0435\u043d \u041c\u0430\u0440\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    (1752\u20131833) \u2014 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0447\u044c\u0451 \u0438\u043c\u044f
    \u0443\u0432\u0435\u043a\u043e\u0432\u0435\u0447\u0435\u043d\u043e \u0432 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u043d\u044f\u0442\u0438\u044f\u0445,
    \u0445\u043e\u0442\u044f \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u043e \u043d\u0435\u0437\u0430\u0441\u043b\u0443\u0436\u0435\u043d\u043d\u043e
    \u0437\u0430\u0442\u043c\u0435\u0432\u0430\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u044f\u0440\u043a\u0438\u0435
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438. \u041e\u043d \u043f\u0440\u043e\u0436\u0438\u043b
    \u0434\u043e\u043b\u0433\u0443\u044e, \u0432\u043d\u0435\u0448\u043d\u0435 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c \u0443\u0447\u0451\u043d\u043e\u0433\u043e, \u043d\u043e
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043f\u043e\u043b\u043d\u0430
    \u043a\u0430\u043a \u0442\u0440\u0438\u0443\u043c\u0444\u043e\u0432, \u0442\u0430\u043a
    \u0438 \u0433\u043e\u0440\u044c\u043a\u0438\u0445 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0439.\n\n\U0001F4DC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0447\u0430\u043b\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    18 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1752 \u0433\u043e\u0434\u0430 \u0432
    \u041f\u0430\u0440\u0438\u0436\u0435 \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0435\u043c\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u041e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439 \u041a\u043e\u043b\u043b\u0435\u0436
    \u041c\u0430\u0437\u0430\u0440\u0438\u043d\u0438 \u0432 1770 \u0433\u043e\u0434\u0443, \u0437\u0430\u0449\u0438\u0442\u0438\u0432
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0421 1775 \u043f\u043e
    1780 \u0433\u043e\u0434 \u043e\u043d \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0432 \u0412\u043e\u0435\u043d\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u041f\u0430\u0440\u0438\u0436\u0430, \u0433\u0434\u0435
    \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u043e\u0439 \u0431\u044b\u043b \u041f\u044c\u0435\u0440-\u0421\u0438\u043c\u043e\u043d
    \u041b\u0430\u043f\u043b\u0430\u0441. \u0415\u0433\u043e \u0440\u0430\u043d\u043d\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0438
    \u0435\u043c\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u0432 1782 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0435\u043c\u0438\u044e
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0437\u0430 \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u043e
    \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u044f\u0445 \u0441\u043d\u0430\u0440\u044f\u0434\u043e\u0432,
    \u0430 \u0443\u0436\u0435 \u0432 1783 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b
    \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a.\n\n\U0001F52D
    \u0413\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0438 \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430
    \u0412 \u043a\u043e\u043d\u0446\u0435 1780-\u0445 \u0433\u043e\u0434\u043e\u0432 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445. \u0412 1787 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u041a\u0430\u0441\u0441\u0438\u043d\u0438 \u0438
    \u041c\u0435\u0448\u0435\u043d\u043e\u043c \u043f\u0440\u043e\u0432\u0435\u043b \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u044a\u0435\u043c\u043a\u0443 \u0434\u043b\u044f \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f
    \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439 \u0438 \u0413\u0440\u0438\u043d\u0432\u0438\u0447\u0441\u043a\u043e\u0439
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0439. \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438,
    \u0432 1791 \u0433\u043e\u0434\u0443, \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0431\u044b\u043b
    \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0432 \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u044e
    \u043f\u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044e \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b. \u0415\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u0431\u044b\u043b\u0438 \u0442\u043e\u0447\u043d\u0435\u0439\u0448\u0438\u0435
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u0434\u0443\u0433\u0438 \u043c\u0435\u0440\u0438\u0434\u0438\u0430\u043d\u0430
    \u043c\u0435\u0436\u0434\u0443 \u0414\u044e\u043d\u043a\u0435\u0440\u043a\u043e\u043c \u0438
    \u0411\u0430\u0440\u0441\u0435\u043b\u043e\u043d\u043e\u0439 \u0434\u043b\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f
    \u044d\u0442\u0430\u043b\u043e\u043d\u0430 \u043c\u0435\u0442\u0440\u0430.\n\n\U0001F4DA
    \u0417\u0440\u0435\u043b\u044b\u0435 \u0433\u043e\u0434\u044b: \u0440\u0430\u0441\u0446\u0432\u0435\u0442
    \u0438 \u043e\u043f\u0430\u043b\u0430 \u0412 1793 \u0433\u043e\u0434\u0443, \u0432 \u0440\u0430\u0437\u0433\u0430\u0440
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0442\u0435\u0440\u0440\u043e\u0440\u0430,
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a \u0431\u044b\u043b\u0430
    \u0437\u0430\u043a\u0440\u044b\u0442\u0430, \u0430 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0441\u0432\u043e\u0451 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435.
    \u0412 \u0442\u043e\u0442 \u0436\u0435 \u0433\u043e\u0434 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041c\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0435-\u041a\u043b\u043e\u0434\u0438\u043d\u0435
    \u041a\u0443\u044d\u043d. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438, \u0432 1794 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u00ab\u041d\u0430\u0447\u0430\u043b\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb
    (\u00c9l\u00e9ments de g\u00e9om\u00e9trie), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u0441\u043e\u0431\u043e\u0439
    \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u043e\u0435 \u0438
    \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u043e\u0435 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0438 \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u043f\u043e\u0447\u0442\u0438 \u0441\u0442\u0430 \u043b\u0435\u0442 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c
    \u0432\u043e \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u0442\u0440\u0430\u043d\u0430\u0445,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0420\u043e\u0441\u0441\u0438\u044e \u0438 \u0421\u0428\u0410.
    \u0412 1795 \u0433\u043e\u0434\u0443 \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0441\u0442\u0430\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0442\u043e\u043b\u044c\u043a\u043e
    \u0447\u0442\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b, \u0430 \u0441 1799 \u0433\u043e\u0434\u0430 \u2014 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u0442\u043e\u0440\u043e\u043c
    \u0432 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435, \u0437\u0430\u043c\u0435\u043d\u0438\u0432 \u043d\u0430
    \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443 \u041b\u0430\u043f\u043b\u0430\u0441\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 1824 \u0433\u043e\u0434\u0443 \u0441 \u043d\u0438\u043c
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0451\u043b \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439
    \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0442. \u0418\u0437-\u0437\u0430 \u0431\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u0448\u0438\u0431\u043a\u0438 \u0438\u043b\u0438, \u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c, \u0438\u0437-\u0437\u0430 \u0435\u0433\u043e \u043e\u0442\u043a\u0430\u0437\u0430
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430 \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u043b\u0438\u0448\u0438\u043b\u0441\u044f
    \u0432\u043e\u0435\u043d\u043d\u043e\u0439 \u043f\u0435\u043d\u0441\u0438\u0438 \u0438 \u043e\u0441\u0442\u0430\u0442\u043e\u043a
    \u0436\u0438\u0437\u043d\u0438 \u043f\u0440\u043e\u0432\u0451\u043b \u0432 \u043d\u0443\u0436\u0434\u0435.
    \u0421\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0410\u0434\u0440\u0438\u0435\u043d
    \u041c\u0430\u0440\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    9 \u044f\u043d\u0432\u0430\u0440\u044f 1833 \u0433\u043e\u0434\u0430 \u043f\u043e\u0441\u043b\u0435
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0438 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438.\n\n\U0001F9EE
    \u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u00ab\u043f\u0440\u043e\u043a\u043b\u044f\u0442\u0438\u0435\u00bb \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430
    \u0412\u043a\u043b\u0430\u0434 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043e\u0433\u0440\u043e\u043c\u0435\u043d, \u043d\u043e \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u043e
    \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0430 \u00ab\u0434\u0443\u0440\u043d\u0430\u044f
    \u0441\u043b\u0430\u0432\u0430\u00bb: \u0441\u0442\u043e\u0438\u043b\u043e \u0435\u043c\u0443
    \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u043a\u0430\u043a \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e
    \u0434\u0440\u0443\u0433\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0441\u0434\u0435\u043b\u0430\u043b \u0442\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435
    \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0440\u0430\u043d\u044c\u0448\u0435 \u0438\u043b\u0438
    \u043f\u0440\u0438\u0448\u0451\u043b \u043a \u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0449\u0438\u043c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c. \u042d\u0442\u043e \u043d\u0435
    \u0443\u043c\u0430\u043b\u044f\u0435\u0442 \u0435\u0433\u043e \u0437\u0430\u0441\u043b\u0443\u0433,
    \u043d\u043e \u0447\u0430\u0441\u0442\u043e \u0441\u0442\u0430\u0432\u0438\u0442 \u0435\u0433\u043e
    \u0432 \u0442\u0435\u043d\u044c \u0431\u043e\u043b\u0435\u0435 \u0438\u043c\u0435\u043d\u0438\u0442\u044b\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433. \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b:
    \u0415\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u00ab\u041e\u043f\u044b\u0442 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b\u00bb (Essai sur la th\u00e9orie des nombres), \u0432\u044b\u0448\u0435\u0434\u0448\u0438\u0439
    \u0432 1798 \u0433\u043e\u0434\u0443, \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0432\u043e\u0434\u043a\u043e\u0439 \u0437\u043d\u0430\u043d\u0438\u0439 \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0412 \u043d\u0451\u043c \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u0437\u0430\u043a\u043e\u043d
    \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438 \u0438 \u0432\u0432\u0451\u043b
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0443\u0434\u043e\u0431\u043d\u044b\u0439 \u0441\u0438\u043c\u0432\u043e\u043b,
    \u043d\u044b\u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0430\u043a
    \u0441\u0438\u043c\u0432\u043e\u043b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430, \u0445\u043e\u0442\u044f
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u044d\u0442\u043e\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u0430 \u043f\u043e\u0437\u0436\u0435
    \u0434\u0430\u043b \u0413\u0430\u0443\u0441\u0441. \u041c\u0435\u0442\u043e\u0434 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432: \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043f\u0435\u0440\u0432\u044b\u043c \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0432 1806 \u0433\u043e\u0434\u0443
    \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043a \u0441\u0432\u043e\u0435\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u043e \u043a\u043e\u043c\u0435\u0442\u043d\u044b\u0445
    \u043e\u0440\u0431\u0438\u0442\u0430\u0445, \u043d\u0430\u0437\u0432\u0430\u0432 \u0435\u0433\u043e
    \u00abm\u00e9thode des moindres carr\u00e9s\u00bb. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0413\u0430\u0443\u0441\u0441 \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u044d\u0442\u043e\u0442
    \u043c\u0435\u0442\u043e\u0434 \u0435\u0449\u0451 \u0432 1795 \u0433\u043e\u0434\u0443,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u043c\u0443
    \u0441\u043f\u043e\u0440\u0443 \u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435.
    \u042d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b:
    \u0412 \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u043e\u043c
    \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u043e\u0431 \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445\u00bb (Trait\u00e9 des fonctions elliptiques)
    1825\u20131828 \u0433\u043e\u0434\u043e\u0432 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043f\u0440\u043e\u0434\u0435\u043b\u0430\u043b \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432
    \u0438 \u043f\u0440\u0438\u0432\u0435\u043b \u0438\u0445 \u043a \u043a\u0430\u043d\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0444\u043e\u0440\u043c\u0430\u043c, \u043d\u044b\u043d\u0435 \u043d\u043e\u0441\u044f\u0449\u0438\u043c
    \u0435\u0433\u043e \u0438\u043c\u044f. \u041e\u0434\u043d\u0430\u043a\u043e \u0432\u0441\u043a\u043e\u0440\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0445\u043e\u0434\u0430 \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u0430
    \u0440\u0430\u0431\u043e\u0442\u044b \u0410\u0431\u0435\u043b\u044f \u0438 \u042f\u043a\u043e\u0431\u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0438\u043b\u0438
    \u044d\u0442\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u0441\u0434\u0435\u043b\u0430\u0432
    \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u043c\u0435\u043d\u0435\u0435 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438.
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043d\u044b\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u044f:
    \u0418\u043c\u0435\u043d\u0435\u043c \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u044b
    \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u044b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    (\u0432\u0430\u0436\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432 \u0444\u0438\u0437\u0438\u043a\u0435),
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    (\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u043e\u0435 \u0432 \u0442\u0435\u0440\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435
    \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0430
    \u043e\u0442 \u043b\u0430\u0433\u0440\u0430\u043d\u0436\u0438\u0430\u043d\u0430 \u043a \u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0438\u0430\u043d\u0443),
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u0435 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u0432 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0438.\n\n\U0001F3DB\ufe0f
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0437\u0430\u0441\u043b\u0443\u0433
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0432\u0441\u0435 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u044b\u0435
    \u0441\u043f\u043e\u0440\u044b \u0438 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438, \u0438\u043c\u044f \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u043d\u0430\u0432\u0435\u0447\u043d\u043e \u0432\u043f\u0438\u0441\u0430\u043d\u043e \u0432
    \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043d\u0430\u0443\u043a\u0438. \u041e\u043d\u043e
    \u0432\u044b\u0433\u0440\u0430\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u043d\u0430
    \u043f\u0435\u0440\u0432\u043e\u043c \u044d\u0442\u0430\u0436\u0435 \u042d\u0439\u0444\u0435\u043b\u0435\u0432\u043e\u0439
    \u0431\u0430\u0448\u043d\u0438 \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 72 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0445 \u0443\u0447\u0451\u043d\u044b\u0445.
    \u0412 \u0435\u0433\u043e \u0447\u0435\u0441\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d
    \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435 \u0438 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0430\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043e\u0432."
  shortBioEn: "Adrien Marie Lejandr (1752-1833) is a French mathematician whose name is perpetuated in many mathematical concepts, although he has often been wrongly eclipsed by more visible contemporarys, living a long, seemingly peaceful life of a scientist, but his biography is full of triumphs and bitter disappointments.\n\n==Early years and career==Lejandr was born in Paris on 18 September 1752 to a wealthy family, enabling him to receive a brilliant education, and graduated from the prestigious College of Mazarini in 1770, with his thesis in physics and mathematics, and from 1775 to 1780 he taught mathematics at the Military School of Paris, where Pierre-Simon Laplas was a colleague.His early works quickly gave him recognition: in 1782 he received the Berlin Academy of Sciences Award for a tract on the trajectory of shells, and in 1783 he became a member of the Paris Academy of Sciences.\n\nIn the late 1780s, Lejandr was actively involved in major geodetic projects, and in 1787, he carried out a trigonometry survey with Cassini and Meschen to link the Paris and Greenwich Observatorys, and during the French Revolution, in 1791, Lejandr was appointed to the Commission for the introduction of the metric system.His key task was the exact measurement of the meridian arc between Dunkerk and Barcelona to establish the standard meter.\n\nThe Academy of Sciences was closed, and Lejandr lost his fortune, and he married Margarita Claudine Quan the same year.Despite difficulties, in 1794 he published his famous textbook \"Eléments de géométrie\", which was a revised and simplified version of Euclid, and for almost a century he remained the main textbook in many countries, including Russia and the United States.In 1795, Lejandr became a professor of the newly founded Normal School and, since 1799, an examiner at the Polytechnic School, replacing Laplaces, but in 1824 he was in an unpleasant situation, because of a bureaucratic error or other evidence, because of his refusal to support a government candidate at the French Institute, Ledr lost his military pension and spent the rest of his life in need.Adrian Marie Lejandr died in Paris on January 9, 1833, after a long and painful illness.\n\nThe Lejandra's contribution to math is huge, but he was often persecuted by \"bad glory\" — when he discovered that another mathematician had done the same thing a little earlier or had come to a more general outcome. This does not diminish his merit, but often puts him in the shadow of more famous colleagues.His fundamental work, \"Exai sur la théorie des nombres\", published in 1798, was the first systematic compilation of knowledge in this field. In it he formulated a quadrilateral law of reciprocity and introduced for him a convenient symbol now known as the symbol of Lejandra, although the strict proof of this law was later given by Gauss.The method of least squares: Lejandr first published the method in 1806 in an annex to his work on boiler orbits, calling it \"méthode des moindres carrés.\" However, Gauss stated that he had used the method as early as 1795, which led to a known priority dispute.Elliptic integrals: In its three-volume \"Traité des fonctions elliptiques\", 1825-1828, Lejandr did a tremendous job in classifying elliptical integrals and led them to the canonical forms currently bearing his name, but soon after his work, Abel and Jakobi completely transformed this area, making many of Lejandra's achievements less relevant.Other important concepts are: the name of the Léjandra is called Léjandra's many members (the important solution of differential equations in physics), the transformation of the Léjandra (used in thermodynamics and mechanics for the transition from Lagrangian to Hamilton), and the condition of the Lejandra in a variable calculation.\n\n♪ Recognition of merit despite all the priority disputes and material difficulties, the name of Lejandra is always in the history of science. It is inscribed on the first floor of the Eiffel Tower on the list of 72 greatest French scientists. He is named after the crater on the Moon and one of the asteroids."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0410\u0434\u0440\u0438\u0435\u043d\u0430 \u041c\u0430\u0440\u0438
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432 \u0438 \u043a\u0443\u0440\u044c\u0451\u0437\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439,
    \u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u0434\u0440\u0430\u043c\u043e\u0439
    \u0441 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u043c \u0444\u0438\u043d\u0430\u043b\u043e\u043c.\n\n\U0001F3AD
    \u0421\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0443\u0440\u044c\u0451\u0437:
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0431\u0435\u0437 \u043b\u0438\u0446\u0430 \u042d\u0442\u043e,
    \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u0430\u044f \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f
    \u0441 \u0443\u0447\u0451\u043d\u044b\u043c: \u0431\u043e\u043b\u0435\u0435 150 \u043b\u0435\u0442
    \u0443 \u043d\u0435\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u043b\u0438\u0446\u0430. \u0412\u043f\u043b\u043e\u0442\u044c \u0434\u043e 2005 \u0433\u043e\u0434\u0430
    \u0432\u043e \u0432\u0441\u0435\u0445 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430\u0445
    \u0438 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439,
    \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u043b\u043e\u0441\u044c, \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u043d\u0430
    \u043d\u0451\u043c \u0431\u044b\u043b \u0437\u0430\u043f\u0435\u0447\u0430\u0442\u043b\u0451\u043d...
    \u043f\u043e\u043b\u0438\u0442\u0438\u043a \u041b\u0443\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    (1752\u20131797) \u2014 \u0435\u0433\u043e \u043f\u043e\u043b\u043d\u044b\u0439 \u0442\u0451\u0437\u043a\u0430
    \u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a. \u041a\u0430\u043a
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u0430?
    \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e
    \u043e\u0448\u0438\u0431\u043a\u0430 \u0437\u0430\u043a\u0440\u0430\u043b\u0430\u0441\u044c
    \u0432 \u043a\u043d\u0438\u0433\u0435 1900 \u0433\u043e\u0434\u0430 \u0410\u043b\u044c\u0444\u043e\u043d\u0441\u0430
    \u0420\u0435\u0431\u044c\u0435\u0440\u0430. \u041a \u0442\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u043a
    \u0443\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0443\u043c\u0435\u0440\u043b\u0438.
    \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043f\u043e\u0434\u043f\u0438\u0441\u044c\u044e
    \u043d\u0430 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u0435 \u0431\u044b\u043b\u0430 \u0444\u0430\u043c\u0438\u043b\u0438\u044f
    \"\u041b\u0435\u0436\u0430\u043d\u0434\u0440\", \u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440,
    \u0438\u0449\u0430 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f
    \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b
    \u043f\u043e\u0434\u0432\u043e\u0445\u0430. \u0413\u043e\u0440\u044c\u043a\u0430\u044f \u0438\u0440\u043e\u043d\u0438\u044f
    \u0441\u0443\u0434\u044c\u0431\u044b: \u042d\u0442\u043e\u0442 \u041b\u0443\u0438 \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u0431\u044b\u043b \u044f\u043a\u043e\u0431\u0438\u043d\u0446\u0435\u043c \u0438 \u0441\u044b\u0433\u0440\u0430\u043b
    \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e \u0440\u043e\u043b\u044c \u0432 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u0438
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0439 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438, \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043e
    \u0410\u0434\u0440\u0438\u0435\u043d \u041c\u0430\u0440\u0438, \u043f\u043e\u0442\u0435\u0440\u044f\u0432
    \u0434\u043e\u0445\u043e\u0434, \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c\u0441\u044f. \u041d\u043e\u0432\u043e\u0435
    \u043e\u0431\u0440\u0435\u0442\u0451\u043d\u043d\u043e\u0435 \u043b\u0438\u0446\u043e: \u041b\u0438\u0448\u044c
    \u0432 2008 \u0433\u043e\u0434\u0443 \u0431\u044b\u043b \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u2014 \u0438 \u044d\u0442\u043e \u043a\u0430\u0440\u0438\u043a\u0430\u0442\u0443\u0440\u0430
    1820 \u0433\u043e\u0434\u0430, \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u0430\u044f
    \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u043e\u043c \u0416\u044e\u043b\u044c\u0435\u043d\u043e\u043c-\u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434\u043e\u043c
    \u0411\u0443\u0430\u0438. \u0412\u043e\u0442 \u0442\u0430\u043a \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0443\u043c\u043e\u0432
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u043f\u043e\u0447\u0442\u0438 \u0434\u0432\u0430
    \u0432\u0435\u043a\u0430 \u0431\u044b\u043b \"\u0431\u0435\u0437\u043b\u0438\u043a\u0438\u043c\",
    \u0430 \u0435\u0433\u043e \u043c\u0435\u0441\u0442\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0447\u0443\u0436\u043e\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0434\u0430\u0436\u0435 \u0448\u0443\u0442\u043a\u0430, \u0447\u0442\u043e \u043e\u043d
    \u043f\u0440\u043e\u0441\u0442\u043e \"\u0432\u043b\u043e\u0436\u0438\u043b \u0432\u0441\u0435
    \u043e\u0447\u043a\u0438 \u0432 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442,
    \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u0432 \u0443\u0434\u0430\u0447\u0435\u0439\".\n\n\U0001F947
    \"\u0421\u0435\u0440\u0435\u0431\u0440\u044f\u043d\u044b\u0439 \u043f\u0440\u0438\u0437\u0451\u0440\"
    \u0432 \u0433\u043e\u043d\u043a\u0435 \u0437\u0430 \u043f\u0435\u0440\u0432\u0435\u043d\u0441\u0442\u0432\u043e
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \"\u0437\u043b\u043e\u0439
    \u0440\u043e\u043a\" \u0432 \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u0445 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430.
    \u0421\u0442\u043e\u0438\u043b\u043e \u0435\u043c\u0443 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0435\u0441\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435,
    \u043a\u0430\u043a \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e
    \u043a\u0442\u043e-\u0442\u043e \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0434\u0435\u043b\u0430\u043b
    \u044d\u0442\u043e \u0436\u0435 \u0440\u0430\u043d\u044c\u0448\u0435 \u0438\u043b\u0438
    \u043f\u0440\u0438\u0448\u0451\u043b \u043a \u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0449\u0438\u043c
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c. \u0421\u043f\u043e\u0440
    \u0441 \u0413\u0430\u0443\u0441\u0441\u043e\u043c: \u0421\u0430\u043c\u0430\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u2014 \u043c\u0435\u0442\u043e\u0434 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432. \u041b\u0435\u0436\u0430\u043d\u0434\u0440
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c
    \u0432 1806 \u0433\u043e\u0434\u0443, \u0434\u0430\u0432 \u0435\u043c\u0443 \u0438\u043c\u044f
    [\"m\u00e9thode des moindres carr\u00e9s\"]. \u041e\u0434\u043d\u0430\u043a\u043e \u0413\u0430\u0443\u0441\u0441
    \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0441 1795 \u0433\u043e\u0434\u0430.
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0432\u043e\u0437\u043c\u0443\u0449\u0451\u043d, \u0447\u0442\u043e \u0432 1820 \u0433\u043e\u0434\u0443
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u0443\u044e
    \u0441\u0442\u0430\u0442\u044c\u044e, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0413\u0430\u0443\u0441\u0441\u0430 \u0432 \"\u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u043d\u0430\u0433\u043b\u043e\u0441\u0442\u0438\" \u0438 \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u0438\u0438
    \u0447\u0443\u0436\u0438\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439. \u0413\u0430\u0443\u0441\u0441,
    \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u043d\u0430
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0435 \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f
    \u043d\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u043b, \u0447\u0442\u043e \u043b\u0438\u0448\u044c
    \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u043b\u043e
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430. \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u0447\u043d\u044b\u0439
    \u0437\u0430\u043a\u043e\u043d \u0432\u0437\u0430\u0438\u043c\u043d\u043e\u0441\u0442\u0438:
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
