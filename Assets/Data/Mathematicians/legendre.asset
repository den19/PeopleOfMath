    \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u043b \u0438 \u0441\u0442\u0440\u043e\u0433\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0434\u0430\u043b
    \u0438\u043c\u0435\u043d\u043d\u043e \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u0413\u0430\u0443\u0441\u0441.
    \u042d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438:
    \u041f\u043e\u0442\u0440\u0430\u0442\u0438\u0432 \u0431\u043e\u043b\u0435\u0435 30 \u043b\u0435\u0442
    \u043d\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432
    \u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0442\u0430\u0431\u043b\u0438\u0446,
    \u041b\u0435\u0436\u0430\u043d\u0434\u0440 \u0443\u0432\u0438\u0434\u0435\u043b, \u043a\u0430\u043a
    \u0435\u0433\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0431\u044b\u043b \u043f\u0440\u0435\u0432\u0437\u043e\u0439\u0434\u0451\u043d
    \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438 \u043c\u043e\u043b\u043e\u0434\u044b\u0445
    \u0433\u0435\u043d\u0438\u0435\u0432 \u2014 \u0410\u0431\u0435\u043b\u044f \u0438 \u042f\u043a\u043e\u0431\u0438
    \u2014 \u0432\u0441\u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438
    \u0435\u0433\u043e \u0442\u0440\u0451\u0445\u0442\u043e\u043c\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0430.\n\n\U0001F30D
    \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u044b\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u0438 \u0432\u0435\u0447\u043d\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0432\u0441\u0435 \u044d\u0442\u0438
    \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0441\u0442\u0438, \u0435\u0433\u043e
    \"\u041d\u0430\u0447\u0430\u043b\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\"
    (1794) \u0441\u0442\u0430\u043b\u0438 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u0432
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u0411\u043e\u043b\u0435\u0435 100 \u043b\u0435\u0442
    \u043f\u043e \u043d\u0435\u043c\u0443 \u0443\u0447\u0438\u043b\u0438\u0441\u044c \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u0438
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438, \u0421\u0428\u0410, \u0420\u043e\u0441\u0441\u0438\u0438,
    \u0415\u0433\u0438\u043f\u0442\u0435 \u0438 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0441\u0442\u0440\u0430\u043d\u0430\u0445. \u041e\u043d \u0441\u0434\u0435\u043b\u0430\u043b
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u043f\u043e\u043d\u044f\u0442\u043d\u043e\u0439
    \u0434\u043b\u044f \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432. \u0418, \u043a\u043e\u043d\u0435\u0447\u043d\u043e,
    \u0435\u0433\u043e \u0438\u043c\u044f \u043d\u0430\u0432\u0435\u0447\u043d\u043e \u0432\u044b\u0433\u0440\u0430\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043e
    \u043d\u0430 \u043f\u0435\u0440\u0432\u043e\u043c \u044d\u0442\u0430\u0436\u0435 \u042d\u0439\u0444\u0435\u043b\u0435\u0432\u043e\u0439
    \u0431\u0430\u0448\u043d\u0438 \u0441\u0440\u0435\u0434\u0438 72 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445 \u0424\u0440\u0430\u043d\u0446\u0438\u0438."
  interestingFactsEn: "Adrien Marie Lejandra's life is full of amazing twists and chickens that make his story not just a scientific biography, but a real drama with an unexpected ending.\n\n♪ The most famous chicken: Ljandr without face is probably the most amazing story about a scientist: he had no face for more than 150 years. Until 2005, all the textbooks and encyclopedia used a portrait that was thought to be math, but it turned out that it had been captured... by the politician Louis Lejandr (1752–1797), his full-blown voice and contemporary.How did the confusion happen? It's supposed to be a mistake in the 1900 book of Alphonse Rebier. By then both the mathematician and the politician had died long ago. The only signature on the portrait was the name Lejandr, and the editor, looking for an image for a great mathematician, simply missed the catch.This Louis Lejandr was a Jacobian and played a key role in closing the Academy during the Revolution, which forced Adrien Marie, having lost his income, to hide. The new person: Only in 2008 was the real portrait of Lejandra discovered, and this was the caricature of 1820 performed by artist Julien-Leopold Bouai.So one of France's greatest minds was almost two centuries of \"faceless,\" and it was a completely alien man, and there's even a joke that he just put all the points in his intelligence by sacrificing his luck.\n\n♪ The silver prize in the race for Lejandra's first championship did indeed pursue \"bad rock\" in matters of priority. ♪ When he published an extraordinary discovery, it turned out that someone else had done the same thing before or had come to a more general outcome. ♪ A dispute with Gauss ♪ The most painful story is the method of the least squares ♪ ♪ Lejandr published it first in 1806, giving him the name ♪méthode des moindres carrés\" ♪However, Gauss stated that he had used this method since 1795, and that the Legendr was so outraged that in 1820 he published an anonymous article accusing Gauss of being \"unbelievable\" and of misusing others' discoveries. Gauss, in turn, did not respond to public accusations, which only made Lejandra more annoyed. The Quadrant Law of Reciprocity: Legendre formulated this law and introduced a convenient symbol for it (Lejandra symbol).However, it was the young Gauss who filled the gaps in the evidence and gave the hard evidence: Elliptic functions: After more than 30 years of classification of elliptical integrals and drawing tables, Lejandr saw his fundamental work being surpassed by the work of young genius Abel and Jacoby, just a few years after his three-volume tract was published.\n\nThe World Textbook and the Eternal Recognition, despite all these troubles, has become one of the most powerful textbooks in history, and over 100 years of its use have been taught by schoolchildren in France, the United States, Russia, Egypt and many other countries, making geometry understandable to millions, and of course, its name has been permanently inscribed on the first floor of the Eiffel Tower among the 72 greatest scientists in France."
