  achievementsRu: "\u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0432\u043a\u043b\u0430\u0434\u0430 \u041f\u044c\u0435\u0440\u0430 \u0414\u0435\u043b\u0438\u043d\u044f,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445 \u0438 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f\u0445.\n\n\U0001F3C6 \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437 \u0412\u0435\u0439\u043b\u044f: \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u043f\u0440\u043e\u0440\u044b\u0432 \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0414\u0435\u043b\u0438\u043d\u044f \u2014 \u043f\u043e\u043b\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437 \u0412\u0435\u0439\u043b\u044f \u0432 1973 \u0433\u043e\u0434\u0443.
    \u042d\u0442\u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b, \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u0435
    \u0410\u043d\u0434\u0440\u0435 \u0412\u0435\u0439\u043b\u0435\u043c \u0432 1949 \u0433\u043e\u0434\u0443,
    \u043a\u0430\u0441\u0430\u043b\u0438\u0441\u044c \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439
    \u043d\u0430\u0434 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c\u0438 \u043f\u043e\u043b\u044f\u043c\u0438
    \u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u043b\u0438 \u0430\u043d\u0430\u043b\u043e\u0433
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0420\u0438\u043c\u0430\u043d\u0430. \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e,
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0435 \u0432 \u0434\u0432\u0443\u0445
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u0442\u0430\u0442\u044c\u044f\u0445 \u043e\u0431\u0449\u0438\u043c \u043e\u0431\u044a\u0435\u043c\u043e\u043c
    \u043e\u043a\u043e\u043b\u043e 150 \u0441\u0442\u0440\u0430\u043d\u0438\u0446, \u0431\u044b\u043b\u043e
    \u043d\u0430\u0437\u0432\u0430\u043d\u043e \"\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
    \u043f\u043e\u0434\u0432\u0438\u0433\u043e\u043c\" \u0438 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e
    \u0414\u0435\u043b\u0438\u043d\u044e \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e
    \u043c\u0435\u0434\u0430\u043b\u044c \u0432 1978 \u0433\u043e\u0434\u0443. \u042d\u0442\u043e\u0442
    \u043f\u0440\u043e\u0440\u044b\u0432 \u0441\u0442\u0430\u043b \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b,
    \u0438\u043d\u0438\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u043c
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e
    \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0439.
    \u0414\u0435\u043b\u0438\u043d\u044c \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u044d\u0442\u043e\u0442 \u043c\u043e\u0449\u043d\u044b\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442,
    \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0430\u043c\u0443\u044e
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0438\u0437 \u0433\u0438\u043f\u043e\u0442\u0435\u0437
    \u0412\u0435\u0439\u043b\u044f \u2014 \u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u0445 \u044d\u043d\u0434\u043e\u043c\u043e\u0440\u0444\u0438\u0437\u043c\u0430
    \u0424\u0440\u043e\u0431\u0435\u043d\u0438\u0443\u0441\u0430. \u0420\u0430\u0431\u043e\u0442\u0430
    \u0438\u043c\u0435\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f
    \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b,
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432: \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430-\u041f\u0435\u0442\u0435\u0440\u0441\u043e\u043d\u0430
    \u0434\u043b\u044f \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c.
    \u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043e\u0446\u0435\u043d\u043a\u0438 \u044d\u043a\u0441\u043f\u043e\u043d\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u0443\u043c\u043c, \u0432\u0430\u0436\u043d\u044b\u0435 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b.\n\n\U0001F52C \u0414\u0440\u0443\u0433\u0438\u0435
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0432\u043a\u043b\u0430\u0434\u044b \u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0414\u0435\u043b\u0438\u043d\u044f \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437 \u0412\u0435\u0439\u043b\u044f. \u041e\u043d
    \u0432\u043d\u0435\u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439. \u0421\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0435
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u0425\u043e\u0434\u0436\u0430 \u0414\u0435\u043b\u0438\u043d\u044c
    \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0425\u043e\u0434\u0436\u0430, \u0434\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0445
    \u0438 \u043d\u0435\u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0445 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439 \u043d\u0435\u0441\u0443\u0442
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u0443\u044e
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0425\u043e\u0434\u0436\u0430. \u042d\u0442\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043c\u043e\u0449\u043d\u044b\u0445
    \u0438 \u0447\u0430\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0445
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041a\u0430\u0442\u0442\u0430\u043d\u0438
    \u0438 \u041a\u0430\u043f\u043b\u0430\u043d\u043e\u043c \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u044d\u0442\u0443 \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e\u0431 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u043d\u043e\u0441\u0442\u0438,
    \u0434\u0430\u044e\u0449\u0435\u0439 \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u044b
    \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0425\u043e\u0434\u0436\u0430. \u0422\u0435\u043e\u0440\u0438\u044f
    \u043c\u043e\u0442\u0438\u0432\u043e\u0432 \u0438 \u0435\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0414\u0435\u043b\u0438\u043d\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u043e\u0442\u0438\u0432\u043e\u0432 \u2014 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0433\u043e
    \u0437\u0430\u043c\u044b\u0441\u043b\u0430 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430,
    \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c
    \u0432\u0441\u0435 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438. \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u044b\u0445
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438,
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0445 \u0434\u043b\u044f \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e\u043d \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 1-\u043c\u043e\u0442\u0438\u0432\u043e\u0432
    \u2014 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432, \u0447\u044c\u0438 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0435
    \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0434\u0430\u044e\u0442 \u043f\u0440\u0438\u043c\u0435\u0440\u044b
    \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0445 \u043c\u043e\u0442\u0438\u0432\u043e\u0432.
    \u0415\u0433\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u043e\u0431 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f\u0445
    1-\u043c\u043e\u0442\u0438\u0432\u043e\u0432, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0430\u044f,
    \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435
    \u0442\u0430\u043a\u0438\u0445 \u043c\u043e\u0442\u0438\u0432\u043e\u0432 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442
    \u0438\u0437 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0432\u0430\u0436\u043d\u043e\u0439 \u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u0435\u043c\u043e\u0439
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0447\u0430\u0441\u0442\u043d\u044b\u0445
    \u0441\u043b\u0443\u0447\u0430\u044f\u0445. \u041f\u0443\u0447\u043a\u0438 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0414\u0435\u043b\u0438\u043d\u044c \u0432\u043d\u0435\u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0443\u0447\u043a\u043e\u0432:
    \u041f\u0443\u0447\u043a\u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a:
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0411\u0435\u0439\u043b\u0438\u043d\u0441\u043e\u043d\u043e\u043c,
    \u0411\u0435\u0440\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c \u0438 \u0413\u0430\u0431\u0431\u0435\u0440\u043e\u043c
    \u043e\u043d \u0434\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u0443\u0447\u043a\u043e\u0432
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0433\u0440\u0430\u044e\u0442 \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e \u0440\u043e\u043b\u044c
    \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439
    \u043b\u0435\u043c\u043c\u044b \u041d\u0433\u043e \u0411\u0430\u043e \u0427\u0430\u0443.
    \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u0433\u0440\u0443\u043f\u043f: \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u041b\u044e\u0441\u0442\u0438\u0433\u043e\u043c
    \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u2113-\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f
    \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    \u043e\u0431\u0449\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445 \u0433\u0440\u0443\u043f\u043f
    \u0442\u0438\u043f\u0430 \u041b\u0438, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0432\u0430\u0436\u043d\u044b\u043c \u0448\u0430\u0433\u043e\u043c \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439. \u0414\u0440\u0443\u0433\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u041c\u043e\u0434\u0443\u043b\u0438 \u043a\u0440\u0438\u0432\u044b\u0445:
    \u0412 \u0440\u0430\u043d\u043d\u0435\u0439 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u0441 \u041c\u0430\u043c\u0444\u043e\u0440\u0434\u043e\u043c
    \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0435\u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043c\u043e\u0434\u0443\u043b\u0435\u0439
    \u043a\u0440\u0438\u0432\u044b\u0445 \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0440\u043e\u0434\u0430,
    \u0432\u0432\u0435\u0434\u044f \u0432\u0430\u0436\u043d\u043e\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u0442\u0435\u043a\u0430. \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430:
    \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043d\u043e\u0432\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    21-\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430
    \u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445 \u0441 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u043c\u0438
    \u043e\u0441\u043e\u0431\u044b\u043c\u0438 \u0442\u043e\u0447\u043a\u0430\u043c\u0438. \u0422\u0435\u043d\u0437\u043e\u0440\u043d\u044b\u0435
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438: \u0412\u043d\u0435\u0441 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0442\u0430\u043d\u043d\u0430\u043a\u0438\u0435\u0432\u044b\u0445
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439, \u043e\u0431\u043e\u0431\u0449\u0438\u0432
    \u0438\u0434\u0435\u044e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    \u0433\u0440\u0443\u043f\u043f.\n\n\U0001F30D \u041e\u0431\u0449\u0435\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u041a\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u043d\u043e
    \u0432 \u0446\u0438\u0442\u0430\u0442\u0435 \u0438\u0437 \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u043c\u0438\u0442\u0435\u0442\u0430, \u0432\u043a\u043b\u0430\u0434 \u0414\u0435\u043b\u0438\u043d\u044f
    \u043e\u043a\u0430\u0437\u0430\u043b \"\u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0449\u0435\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b, \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    \u0438 \u0441\u043c\u0435\u0436\u043d\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438\".
    \u0415\u0433\u043e \u0438\u0434\u0435\u0438 \u0438 \u043c\u0435\u0442\u043e\u0434\u044b
    \u0441\u0442\u0430\u043b\u0438 \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b\u0435\u043c\u043e\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u044f.\n\n\U0001F3C5
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (1978) \u041f\u0440\u0435\u043c\u0438\u044f \u041a\u0440\u0430\u0444\u043e\u0440\u0434\u0430
    (1988) \u041f\u0440\u0435\u043c\u0438\u044f \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430
    (2004) \u041f\u0440\u0435\u043c\u0438\u044f \u0412\u043e\u043b\u044c\u0444\u0430 (2008)
    \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u043f\u0440\u0435\u043c\u0438\u044f
    (2013) \u042d\u0442\u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0442
    \u0435\u0433\u043e \u0441\u0442\u0430\u0442\u0443\u0441 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438."
  achievementsEn: 
  personalLifeRu: "\u0425\u043e\u0442\u044f \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f
    \u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u041f\u044c\u0435\u0440\u0430
    \u0414\u0435\u043b\u0438\u043d\u044f \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0441\u043a\u0443\u0434\u043d\u0430,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u044b\u043b \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d
    \u043d\u0430 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435,
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0444\u0430\u043a\u0442\u044b \u0432\u0441\u0451
    \u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0421\u0435\u043c\u044c\u044f \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u041f\u044c\u0435\u0440 \u0414\u0435\u043b\u0438\u043d\u044c \u2014 \u043c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0438\u0437 \u0442\u0440\u043e\u0438\u0445 \u0434\u0435\u0442\u0435\u0439 \u0410\u043b\u044c\u0431\u0435\u0440\u0430
    \u0414\u0435\u043b\u0438\u043d\u044f (\u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430
    \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438) \u0438 \u0420\u0435\u043d\u0435 \u0411\u043e\u0434\u0430\u0440.
    \u0420\u043e\u0434\u0438\u043b\u0441\u044f 3 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1944 \u0433\u043e\u0434\u0430 \u0432 \u0431\u0440\u044e\u0441\u0441\u0435\u043b\u044c\u0441\u043a\u043e\u043c
    \u0440\u0430\u0439\u043e\u043d\u0435 \u042d\u0442\u0442\u0435\u0440\u0431\u0435\u043a. \u0415\u0433\u043e
    \u0431\u0440\u0430\u0442 \u0431\u044b\u043b \u0441\u0442\u0430\u0440\u0448\u0435 \u043d\u0430
    \u0441\u0435\u043c\u044c \u043b\u0435\u0442, \u0430 \u0441\u0435\u0441\u0442\u0440\u0430
    \u2014 \u043d\u0430 \u043e\u0434\u0438\u043d\u043d\u0430\u0434\u0446\u0430\u0442\u044c.
    \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0414\u0435\u043b\u0438\u043d\u044f, \u0431\u0443\u0434\u0443\u0447\u0438
    \u043e\u0447\u0435\u043d\u044c \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u043c\u0438
    \u043b\u044e\u0434\u044c\u043c\u0438, \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0432\u044b\u0441\u0448\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043f\u043e \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u043e\u0447\u0435\u043d\u044c \u0445\u043e\u0442\u0435\u043b\u0438, \u0447\u0442\u043e\u0431\u044b
    \u0438\u0445 \u0434\u0435\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u043e \u0443\u0447\u0438\u043b\u0438\u0441\u044c
    \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b\u0438 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u044b.
    \u0421\u0432\u043e\u0438\u043c \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u043e\u043d \u0432\u043e
    \u043c\u043d\u043e\u0433\u043e\u043c \u043e\u0431\u044f\u0437\u0430\u043d \u0431\u0440\u0430\u0442\u0443,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439
    \u0444\u043e\u0440\u043c\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u043b \u0435\u043c\u0443
    \u043e\u0441\u043d\u043e\u0432\u044b. \u0412 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u0438\u0432\u043b\u0451\u043d, \u0443\u0437\u043d\u0430\u0432,
    \u0447\u0442\u043e \u00ab\u043c\u0438\u043d\u0443\u0441 \u043e\u0434\u0438\u043d \u0443\u043c\u043d\u043e\u0436\u0438\u0442\u044c
    \u043d\u0430 \u043c\u0438\u043d\u0443\u0441 \u043e\u0434\u0438\u043d \u0440\u0430\u0432\u043d\u044f\u0435\u0442\u0441\u044f
    \u043f\u043b\u044e\u0441 \u043e\u0434\u0438\u043d\u00bb, \u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u0448\u0435\u0441\u0442\u0438-\u0441\u0435\u043c\u0438 \u043b\u0435\u0442 \u0443\u0436\u0435
    \u0440\u0435\u0448\u0430\u043b \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f.\n\n\u2764\ufe0f \u0416\u0435\u043d\u0430
    \u0438 \u0434\u0435\u0442\u0438 \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0440\u043e\u0432\u043a\u0438
    \u0414\u0435\u043b\u0438\u043d\u044f \u0432 \u0420\u043e\u0441\u0441\u0438\u044e \u0441\u044b\u0433\u0440\u0430\u043b\u0438
    \u0432\u0430\u0436\u043d\u0443\u044e \u0440\u043e\u043b\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0435, \u043d\u043e \u0438
    \u0432 \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438. 9 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1980 \u0433\u043e\u0434\u0430 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430
    \u0415\u043b\u0435\u043d\u0435 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u043e\u0432\u043d\u0435
    \u0410\u043b\u0435\u043a\u0441\u0435\u0435\u0432\u043e\u0439, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0432\u0438\u0437\u0438\u0442\u043e\u0432
    \u0432 \u0421\u0421\u0421\u0420. \u0423 \u043d\u0438\u0445 \u0435\u0441\u0442\u044c \u0434\u0432\u043e\u0435
    \u0434\u0435\u0442\u0435\u0439: \u0434\u043e\u0447\u044c \u041d\u0430\u0442\u0430\u043b\u044c\u044f
    \u0438 \u0441\u044b\u043d \u0410\u043b\u0435\u043a\u0441\u0438\u0441.\n\n\U0001F3D5\ufe0f
    \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0437\u0430\u043d\u044f\u0442\u043e\u0441\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0435,
    \u0414\u0435\u043b\u0438\u043d\u044c \u2014 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043c\u0438
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u043c\u0438. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043e\u043d \u0441\u043e\u0441\u0442\u043e\u044f\u043b
    \u0432 \u0441\u043a\u0430\u0443\u0442\u0441\u043a\u043e\u043c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u0438\u0432\u0438\u043b\u043e \u0435\u043c\u0443
    \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u043f\u0440\u0438\u0440\u043e\u0434\u0435 \u0438
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u043e\u0442\u0434\u044b\u0445\u0443.
    \u041e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b \u0438\u0433\u0440\u0430\u0442\u044c
    \u0432 \u043b\u0435\u0441\u0443, \u0430 \u043d\u0435 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435,
    \u0438 \u043d\u0430\u0443\u0447\u0438\u043b\u0441\u044f \u0440\u0430\u0437\u0436\u0438\u0433\u0430\u0442\u044c
    \u043a\u043e\u0441\u0442\u0451\u0440 \u0441 \u043e\u0434\u043d\u043e\u0439 \u0441\u043f\u0438\u0447\u043a\u0438.
    \u042d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c
    \u0443 \u043d\u0435\u0433\u043e \u0438 \u0432\u043e \u0432\u0437\u0440\u043e\u0441\u043b\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438: \u043e\u043d \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b,
    \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u043e\u0435 \u0437\u0438\u043c\u043d\u0435\u0435
    \u0443\u0442\u0440\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0441 \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e \u0440\u0430\u0437\u0436\u0438\u0433\u0430\u0435\u0442 \u043e\u0433\u043e\u043d\u044c
    \u0432 \u043a\u0430\u043c\u0438\u043d\u0435. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0443\u0432\u043b\u0435\u043a\u0430\u0435\u0442\u0441\u044f \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f\u043c\u0438
    \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443, \u0447\u0442\u043e\u0431\u044b
    \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0435
    \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u044f, \u0430 \u0437\u0438\u043c\u043e\u0439
    \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0438\u0433\u043b\u0443.
    \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u0414\u0435\u043b\u0438\u043d\u044c,
    \u0436\u0438\u0432\u044f \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u043d\u0435\u0440\u0435\u0434\u043a\u043e \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044f
    \u043f\u043e \u0433\u043e\u0440\u043e\u0434\u0443 \u043d\u0430 \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0435,
    \u0434\u0430\u0436\u0435 \u0447\u0442\u043e\u0431\u044b \u0441\u044a\u0435\u0437\u0434\u0438\u0442\u044c
    \u0437\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430\u043c\u0438 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d."
  personalLifeEn: 
  shortBioRu: "\u041f\u044c\u0435\u0440 \u0420\u0435\u043d\u0435 \u0414\u0435\u043b\u0438\u043d\u044c (\u0440\u043e\u0434\u0438\u043b\u0441\u044f
    3 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1944 \u0433\u043e\u0434\u0430) \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b, \u043f\u0440\u0435\u0436\u0434\u0435
    \u0432\u0441\u0435\u0433\u043e \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0442\u0435\u043e\u0440\u0438\u044e
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0441\u043c\u0435\u0436\u043d\u044b\u0435 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b.
    \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0431\u043b\u0430\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u0432\u0441\u0435\u0445 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u0440\u0435\u043c\u0438\u0438
    \u0424\u0438\u043b\u0434\u0441\u0430, \u0412\u043e\u043b\u044c\u0444\u0430 \u0438 \u0410\u0431\u0435\u043b\u044f.\n\n\U0001F4D6
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0447\u0430\u043b\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u041f\u044c\u0435\u0440 \u0420\u0435\u043d\u0435
    \u0414\u0435\u043b\u0438\u043d\u044c \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0411\u0440\u044e\u0441\u0441\u0435\u043b\u0435,
    \u0411\u0435\u043b\u044c\u0433\u0438\u044f. \u0415\u0433\u043e \u043f\u0443\u0442\u044c
    \u0432 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043d\u0430\u0447\u0430\u043b\u0441\u044f \u0432 \u0411\u0440\u044e\u0441\u0441\u0435\u043b\u044c\u0441\u043a\u043e\u043c
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (Universit\u00e9 Libre de Bruxelles), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d
    \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043e\u043a\u043e\u043d\u0447\u0438\u043b. \u0420\u0435\u0448\u0430\u044e\u0449\u0438\u043c
    \u044d\u0442\u0430\u043f\u043e\u043c \u0432 \u0435\u0433\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0438
    \u0441\u0442\u0430\u043b\u0430 \u0437\u0430\u0449\u0438\u0442\u0430 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438. \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c \u0431\u044b\u043b
    \u043d\u0435 \u043a\u0442\u043e \u0438\u043d\u043e\u0439, \u043a\u0430\u043a \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a \u2014 \u043e\u0434\u043d\u0430 \u0438\u0437
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0444\u0438\u0433\u0443\u0440 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    XX \u0432\u0435\u043a\u0430. \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0449\u0438\u0442\u044b
    \u0414\u0435\u043b\u0438\u043d\u044c \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c
    \u0432\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u0432\u044b\u0441\u0448\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IH\u00c9S) \u043f\u043e\u0434 \u041f\u0430\u0440\u0438\u0436\u0435\u043c.\n\n\U0001F52C
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0414\u0435\u043b\u0438\u043d\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e,
    \u043d\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442
    \u0441\u0442\u0430\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c\u0438
    \u043f\u0440\u043e\u0440\u044b\u0432\u0430\u043c\u0438. \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437 \u0412\u0435\u0439\u043b\u044f: \u042d\u0442\u043e,
    \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u0441\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0414\u0435\u043b\u0438\u043d\u044f. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0412\u0435\u0439\u043b\u044f,
    \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u0435 \u0410\u043d\u0434\u0440\u0435
    \u0412\u0435\u0439\u043b\u0435\u043c \u0432 1949 \u0433\u043e\u0434\u0443, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438
    \u0441\u043e\u0431\u043e\u0439 \u0441\u0435\u0440\u0438\u044e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439 \u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043d\u0430\u0434 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c\u0438 \u043f\u043e\u043b\u044f\u043c\u0438.
    \u0414\u0435\u043b\u0438\u043d\u044c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0438\u0445 \u0432 1973 \u0433\u043e\u0434\u0443,
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0432 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0443\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443, \u043d\u0430\u0447\u0430\u0442\u0443\u044e
    \u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c.
    \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430
    \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443
    \u0438 \u0432 1978 \u0433\u043e\u0434\u0443 \u2014 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e. \u0414\u0440\u0443\u0433\u0438\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b: \u0421\u0444\u0435\u0440\u0430
    \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430\u043c\u0438 \u0412\u0435\u0439\u043b\u044f.
    \u041e\u043d \u0432\u043d\u0435\u0441 \u0440\u0435\u0448\u0430\u044e\u0449\u0438\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440
    \u0425\u043e\u0434\u0436\u0430 \u0438 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u043e\u0442\u0438\u0432\u043e\u0432
    \u2014 \u0435\u0449\u0451 \u043e\u0434\u0438\u043d \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0439
    \u043f\u0440\u043e\u0435\u043a\u0442, \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0439
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c. \u0422\u0430\u043a\u0436\u0435
    \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432 \u043c\u043e\u0434\u0443\u043b\u0435\u0439
    \u043a\u0440\u0438\u0432\u044b\u0445 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0414\u044d\u0432\u0438\u0434\u043e\u043c \u041c\u0430\u043c\u0444\u043e\u0440\u0434\u043e\u043c
    \u0438 \u0432\u043d\u0435\u0441 \u0432\u0430\u0436\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0442\u0435\u043d\u0437\u043e\u0440\u043d\u044b\u0445
    \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439.\n\n\U0001F468\u200d\U0001F3EB \u041a\u0430\u0440\u044c\u0435\u0440\u0430
    \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0414\u0435\u043b\u0438\u043d\u044f \u0442\u0435\u0441\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0434\u0432\u0443\u043c\u044f \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438
    \u043c\u0438\u0440\u043e\u0432\u044b\u043c\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u0446\u0435\u043d\u0442\u0440\u0430\u043c\u0438: \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u0432\u044b\u0441\u0448\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IH\u00c9S), \u0424\u0440\u0430\u043d\u0446\u0438\u044f: \u041e\u043d \u0431\u044b\u043b
    \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u043c
    \u044d\u0442\u043e\u0433\u043e \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430, \u0433\u0434\u0435
    \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u0439 \u043f\u0443\u0442\u044c \u0441
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c. \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    (IAS), \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d, \u0421\u0428\u0410: \u0421 1970
    \u043f\u043e 1984 \u0433\u043e\u0434 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435, \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044f
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043f\u043e\u0437\u0438\u0446\u0438\u044e \u0432
    IH\u00c9S. \u0412 1984 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0432 IAS, \u0430 \u0441
    2008 \u0433\u043e\u0434\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0435\u0433\u043e
    \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    (Professor Emeritus). \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u043e\u0442\u043c\u0435\u0447\u0435\u043d \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e\u043c
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434:
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f \u043f\u0440\u0435\u043c\u0438\u044f
    (1978) \u041f\u0440\u0435\u043c\u0438\u044f \u041a\u0440\u0430\u0444\u043e\u0440\u0434\u0430
    \u043e\u0442 \u0428\u0432\u0435\u0434\u0441\u043a\u043e\u0439 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a (1988) \u041f\u0440\u0435\u043c\u0438\u044f
    \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430 (2004) \u041f\u0440\u0435\u043c\u0438\u044f
    \u0412\u043e\u043b\u044c\u0444\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    (2008) \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u043f\u0440\u0435\u043c\u0438\u044f
    (2013) \u2014 \u044d\u0442\u0430 \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0431\u044b\u043b\u0430
    \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043d\u0430 \u0435\u043c\u0443 \"\u0437\u0430
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438 \u0438\u0445 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u0442\u0435\u043e\u0440\u0438\u0438
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0438 \u0441\u043c\u0435\u0436\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445\". \u0412 2006 \u0433\u043e\u0434\u0443
    \u043a\u043e\u0440\u043e\u043b\u044c \u0411\u0435\u043b\u044c\u0433\u0438\u0438 \u0432\u043e\u0437\u0432\u0435\u043b
    \u0435\u0433\u043e \u0432 \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u043a\u043e\u0435 \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u043e
    \u0441 \u0442\u0438\u0442\u0443\u043b\u043e\u043c \u0432\u0438\u043a\u043e\u043d\u0442\u0430.
    \u0414\u0435\u043b\u0438\u043d\u044c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0447\u043b\u0435\u043d\u043e\u043c
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439
    \u043d\u0430\u0443\u043a \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a (1978), \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a \u0421\u0428\u0410
    (2007) \u0438 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0443\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e
    \u043d\u0430\u0443\u043a (2016).\n\n\U0001F91D \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430
    \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u0443\u0447\u0435\u043d\u044b\u0445 \u041f\u044c\u0435\u0440
    \u0414\u0435\u043b\u0438\u043d\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u0442\u0440\u0443\u0434\u0430\u043c\u0438, \u043d\u043e \u0438 \u0431\u043b\u0430\u0433\u043e\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e. \u041f\u043e\u0441\u043b\u0435
    \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u043c\u0438\u0438
    \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430 \u0432 2004 \u0433\u043e\u0434\u0443, \u043f\u043e
    \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0438\u0434\u0442\u0438 \u043d\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443
    \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u0443\u0447\u0435\u043d\u044b\u0445, \u043e\u043d
    \u0443\u0447\u0440\u0435\u0434\u0438\u043b \"\u041a\u043e\u043d\u043a\u0443\u0440\u0441
    \u0414\u0435\u043b\u0438\u043d\u044f\" \u0434\u043b\u044f \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0438,
    \u0423\u043a\u0440\u0430\u0438\u043d\u044b \u0438 \u0411\u0435\u043b\u043e\u0440\u0443\u0441\u0441\u0438\u0438.
    \u041f\u043e\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u0438
    \u0442\u0440\u0435\u0445\u0433\u043e\u0434\u0438\u0447\u043d\u044b\u0435 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438.
    \u0414\u0435\u043b\u0438\u043d\u044c \u043b\u0438\u0447\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u0436\u044e\u0440\u0438 \u044d\u0442\u043e\u0433\u043e
    \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0430, \u0430 \u043f\u043e\u0437\u0436\u0435
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e
    \u043d\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u043c \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u042d\u043a\u0441\u043f\u0435\u0440\u0442\u043d\u043e\u0433\u043e \u0441\u043e\u0432\u0435\u0442\u0430
    \u0444\u043e\u043d\u0434\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \"\u0411\u0430\u0437\u0438\u0441\"."
  shortBioEn: 
  interestingFactsRu: "\u041f\u044c\u0435\u0440 \u0414\u0435\u043b\u0438\u043d\u044c \u2014 \u043e\u0434\u043d\u0430
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445 \u0444\u0438\u0433\u0443\u0440
    \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0438 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0438 \u043a\u0430\u0440\u044c\u0435\u0440\u0430
    \u043f\u043e\u043b\u043d\u044b \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0438
    \u043f\u043e-\u0441\u0432\u043e\u0435\u043c\u0443 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0434\u0435\u0442\u0430\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u0435\u0449\u0435
    \u0431\u043e\u043b\u0435\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0439.\n\n\U0001F9E0
    \u041d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e:
    \u0411\u0443\u0440\u0431\u0430\u043a\u0438 \u0432 14 \u043b\u0435\u0442 \u041e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u043e,
    \u043a\u0430\u043a \u0440\u0430\u043d\u043e \u0414\u0435\u043b\u0438\u043d\u044c \u0441\u043e\u043f\u0440\u0438\u043a\u043e\u0441\u043d\u0443\u043b\u0441\u044f
    \u0441 \"\u0432\u044b\u0441\u043e\u043a\u043e\u0439\" \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u043a\u043e\u043b\u043e 12
    \u043b\u0435\u0442 \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0447\u0438\u0442\u0430\u0442\u044c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0435
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0431\u0440\u0430\u0442\u0430.
    \u041d\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u043e\u0442
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b, \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0419. \u041d\u0438\u0439\u0441 \u0434\u0430\u043b \u0435\u043c\u0443 \u043f\u043e\u0447\u0438\u0442\u0430\u0442\u044c
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u043c\u043e\u0432 \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0430 \"\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u044b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\" \u041d\u0438\u043a\u043e\u043b\u044f
    \u0411\u0443\u0440\u0431\u0430\u043a\u0438 (\u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439
    \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c \u0433\u0440\u0443\u043f\u043f\u044b
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432).
    \u042d\u0442\u0438 \u043a\u043d\u0438\u0433\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u0431\u044b\u0447\u043d\u043e \u043d\u0435 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e\u0442
    14-\u043b\u0435\u0442\u043d\u0435\u043c\u0443 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0441\u0442\u0443,
    \u0441\u0442\u0430\u043b\u0438 \u0434\u043b\u044f \u0414\u0435\u043b\u0438\u043d\u044f \u0441\u043e\u0431\u044b\u0442\u0438\u0435\u043c,
    \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0438\u043c \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c.
    \u041e\u043d \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e,
    \u0447\u0442\u043e \u0441 \u044d\u0442\u043e\u0433\u043e \u0434\u043d\u044f, \u043f\u043e
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e, \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043e\u0433\u043b\u044f\u0434\u044b\u0432\u0430\u043b\u0441\u044f \u043d\u0430\u0437\u0430\u0434.
    \u042d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442 \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u043e
    \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442 \u0435\u0433\u043e
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0443
    \u0441 \u0441\u0430\u043c\u043e\u0433\u043e \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430.\n\n\U0001F3AF
    \"\u0418\u0433\u0440\u0430\u044f, \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c
    \u043d\u0430 \u0436\u0438\u0437\u043d\u044c\" \u0412 \u044e\u043d\u043e\u0441\u0442\u0438
    \u0414\u0435\u043b\u0438\u043d\u044c \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0442\u0430\u0442\u044c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043d\u0430\u0443\u043a\u043e\u0439
    \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0434\u043b\u044f \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u043f\u0443\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0441\u044f.
    \u041f\u043e\u0441\u0442\u0443\u043f\u0438\u0432 \u0432 \u0421\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0411\u0440\u044e\u0441\u0441\u0435\u043b\u044f,
    \u043e\u043d \u043f\u043e\u043f\u0430\u043b \u043f\u043e\u0434 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0416\u0430\u043a\u0430 \u0422\u0438\u0442\u0441\u0430. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0442\u043e\u0433\u0434\u0430 \u0414\u0435\u043b\u0438\u043d\u044c \u0441 \u0440\u0430\u0434\u043e\u0441\u0442\u044c\u044e
    \u043e\u0442\u043a\u0440\u044b\u043b \u0434\u043b\u044f \u0441\u0435\u0431\u044f, \u0447\u0442\u043e
    \"\u043c\u043e\u0436\u043d\u043e \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c
    \u043d\u0430 \u0436\u0438\u0437\u043d\u044c, \u0438\u0433\u0440\u0430\u044f, \u0442.\u0435.
    \u0437\u0430\u043d\u0438\u043c\u0430\u044f\u0441\u044c \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\". \u042d\u0442\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0435\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u0443\u043a\u0435
    \u043a\u0430\u043a \u043a \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0438\u0433\u0440\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438
    \u044d\u0442\u043e\u043c \u0441\u0442\u0430\u043b\u0430 \u0434\u0435\u043b\u043e\u043c \u0432\u0441\u0435\u0439
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F3AD \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a-\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b
    \u0441 \"\u043d\u0435\u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u043c\u0438\"
    \u0438\u0434\u0435\u044f\u043c\u0438 \u0414\u0435\u043b\u0438\u043d\u044c \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442
    \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0433\u0438\u0431\u043a\u043e\u0441\u0442\u044c\u044e
    \u0443\u043c\u0430. \u041e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e
    \u043e\u043d \u0441 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442 \u0438 \u043e\u0432\u043b\u0430\u0434\u0435\u0432\u0430\u0435\u0442
    \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c\u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438
    \u043b\u044e\u0431\u043e\u0439 \u043d\u043e\u0432\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0438\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b, \u043f\u043e\u0441\u043b\u0435
    \u0447\u0435\u0433\u043e \u043c\u043e\u0436\u0435\u0442 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044c
    \u0435\u0435 \u043a\u0430\u043a \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0439 \u043e\u0431\u044a\u0435\u043a\u0442. \u041e\u043d
    \u043b\u0435\u0433\u043a\u043e \u043f\u0435\u0440\u0435\u043d\u0438\u043c\u0430\u0435\u0442
    \u044f\u0437\u044b\u043a \u0438 \u0442\u0435\u0440\u043c\u0438\u043d\u043e\u043b\u043e\u0433\u0438\u044e
    \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a\u0430, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442
    \u0435\u0433\u043e \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0434\u043b\u044f \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0439 \u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0430.
    \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u0443 \u043d\u0435\u0433\u043e \u0435\u0441\u0442\u044c
    \u043e\u0434\u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0447\u0435\u0440\u0442\u0430: \u0438\u0437-\u0437\u0430 \u043b\u0430\u043a\u043e\u043d\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    \u0441\u0442\u0438\u043b\u044f \u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043f\u0438\u0441\u0430\u0442\u044c \u043e\u0434\u043d\u043e \u0438 \u0442\u043e
    \u0436\u0435 \u0434\u0432\u0430\u0436\u0434\u044b, \u043c\u043d\u043e\u0433\u0438\u0435
    \u0438\u0437 \u0435\u0433\u043e \u043b\u0443\u0447\u0448\u0438\u0445 \u0438\u0434\u0435\u0439
    \u0442\u0430\u043a \u0438 \u043d\u0435 \u0431\u044b\u043b\u0438 \u0438\u043c \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u044b!
    \u042d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0443
    \u043d\u0435\u0433\u043e \u043e\u043a\u043e\u043b\u043e \u0441\u0442\u0430, \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
    \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0431\u043e\u0433\u0430\u0442\u0441\u0442\u0432\u0430
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430.\n\n\U0001F451
    \u0412\u0438\u043a\u043e\u043d\u0442 \u0438 \u043f\u043e\u0447\u0442\u043e\u0432\u0430\u044f
    \u043c\u0430\u0440\u043a\u0430 \u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0414\u0435\u043b\u0438\u043d\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u043c
    \u043c\u0438\u0440\u0435, \u043d\u043e \u0438 \u043d\u0430 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u0443\u0440\u043e\u0432\u043d\u0435. \u0412 2006 \u0433\u043e\u0434\u0443 \u0431\u0435\u043b\u044c\u0433\u0438\u0439\u0441\u043a\u0438\u0439
    \u043a\u043e\u0440\u043e\u043b\u044c \u0410\u043b\u044c\u0431\u0435\u0440\u0442 II \u0432\u043e\u0437\u0432\u0435\u043b
    \u0435\u0433\u043e \u0432 \u0434\u0432\u043e\u0440\u044f\u043d\u0441\u0442\u0432\u043e \u0441
    \u0442\u0438\u0442\u0443\u043b\u043e\u043c \u0432\u0438\u043a\u043e\u043d\u0442\u0430. \u0410
    \u0432 \u0437\u043d\u0430\u043a \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f \u0435\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434\u0430 \u0432 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u041f\u043e\u0447\u0442\u0430
    \u0411\u0435\u043b\u044c\u0433\u0438\u0438 \u0434\u0430\u0436\u0435 \u0432\u044b\u043f\u0443\u0441\u0442\u0438\u043b\u0430
    \u043f\u043e\u0447\u0442\u043e\u0432\u0443\u044e \u043c\u0430\u0440\u043a\u0443 \u0432 \u0435\u0433\u043e
    \u0447\u0435\u0441\u0442\u044c.\n\n\U0001F4B0 \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430
    \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u041f\u043e\u043b\u0443\u0447\u0438\u0432 \u0432 2004 \u0433\u043e\u0434\u0443 \u041f\u0440\u0435\u043c\u0438\u044e
    \u0411\u0430\u043b\u044c\u0446\u0430\u043d\u0430 \u0441 \u043f\u0440\u0438\u0437\u043e\u0432\u044b\u043c
    \u0444\u043e\u043d\u0434\u043e\u043c \u0432 1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d
    \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u0438\u0445 \u0444\u0440\u0430\u043d\u043a\u043e\u0432,
    \u0414\u0435\u043b\u0438\u043d\u044c, \u043f\u043e \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c
    \u0444\u043e\u043d\u0434\u0430, \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b
    \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u0442\u044c \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443
    \u0441\u0443\u043c\u043c\u044b \u043d\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443
    \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439.
    \u041e\u043d \u0443\u0447\u0440\u0435\u0434\u0438\u043b \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u0438
    \u0434\u043b\u044f \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0438, \u0423\u043a\u0440\u0430\u0438\u043d\u044b
    \u0438 \u0411\u0435\u043b\u043e\u0440\u0443\u0441\u0441\u0438\u0438, \u0430 \u043f\u043e\u0437\u0436\u0435
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u043a\u043e\u043d\u043a\u0443\u0440\u0441
    \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u043d\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430. \u042d\u0442\u043e\u0442 \u0436\u0435\u0441\u0442
    \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043e
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0437\u0430\u0431\u043e\u0442\u0443 \u043e
    \u0431\u0443\u0434\u0443\u0449\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438.\n\n\U0001F91D \"\u041f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435
    \u0443\u0447\u0435\u043d\u044b\u0445 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0443\"
    \u0412 1992 \u0433\u043e\u0434\u0443 \u0414\u0435\u043b\u0438\u043d\u044c \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b
    \"\u041f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u0443\u0447\u0435\u043d\u044b\u0445
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0443\" \u2014 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0435
    \u0443\u0447\u0435\u043d\u044b\u0435 \u043c\u0438\u0440\u0430 \u0432\u044b\u0440\u0430\u0437\u0438\u043b\u0438
    \u043e\u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043d\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430 \u043a \u043f\u0440\u0438\u0440\u043e\u0434\u0435
    \u0438 \u043f\u0440\u0438\u0437\u0432\u0430\u043b\u0438 \u043a \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u043c
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u043c \u043f\u043e \u0437\u0430\u0449\u0438\u0442\u0435
    \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044b.
    \u042d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0435\u0433\u043e \u043a\u0430\u043a \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0441
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0439
    \u043f\u043e\u0437\u0438\u0446\u0438\u0435\u0439, \u043d\u0435\u0440\u0430\u0432\u043d\u043e\u0434\u0443\u0448\u043d\u043e\u0433\u043e
    \u043a \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c."
