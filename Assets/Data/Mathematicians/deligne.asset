    \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0435\u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043c\u043e\u0434\u0443\u043b\u0435\u0439
    \u043a\u0440\u0438\u0432\u044b\u0445 \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0440\u043e\u0434\u0430,
    \u0432\u0432\u0435\u0434\u044f \u0432\u0430\u0436\u043d\u043e\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
