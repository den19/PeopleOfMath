  achievementsRu: "\u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439
    \u0438 \u0432\u043a\u043b\u0430\u0434\u0430 \u041f\u044c\u0435\u0440\u0430 \u0414\u0435\u043b\u0438\u043d\u044f,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445 \u0438 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f\u0445.\n\n\U0001F3C6 \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437 \u0412\u0435\u0439\u043b\u044f: \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u043f\u0440\u043e\u0440\u044b\u0432 \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0414\u0435\u043b\u0438\u043d\u044f \u2014 \u043f\u043e\u043b\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437 \u0412\u0435\u0439\u043b\u044f \u0432 1973 \u0433\u043e\u0434\u0443.
    \u042d\u0442\u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b, \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u0435
    \u0410\u043d\u0434\u0440\u0435 \u0412\u0435\u0439\u043b\u0435\u043c \u0432 1949 \u0433\u043e\u0434\u0443,
    \u043a\u0430\u0441\u0430\u043b\u0438\u0441\u044c \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439
    \u043d\u0430\u0434 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c\u0438 \u043f\u043e\u043b\u044f\u043c\u0438
    \u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u043b\u0438 \u0430\u043d\u0430\u043b\u043e\u0433
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0420\u0438\u043c\u0430\u043d\u0430. \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e,
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0435 \u0432 \u0434\u0432\u0443\u0445
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u0442\u0430\u0442\u044c\u044f\u0445 \u043e\u0431\u0449\u0438\u043c \u043e\u0431\u044a\u0435\u043c\u043e\u043c
    \u043e\u043a\u043e\u043b\u043e 150 \u0441\u0442\u0440\u0430\u043d\u0438\u0446, \u0431\u044b\u043b\u043e
    \u043d\u0430\u0437\u0432\u0430\u043d\u043e \"\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
    \u043f\u043e\u0434\u0432\u0438\u0433\u043e\u043c\" \u0438 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e
    \u0414\u0435\u043b\u0438\u043d\u044e \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e
    \u043c\u0435\u0434\u0430\u043b\u044c \u0432 1978 \u0433\u043e\u0434\u0443. \u042d\u0442\u043e\u0442
    \u043f\u0440\u043e\u0440\u044b\u0432 \u0441\u0442\u0430\u043b \u0432\u0435\u0440\u0448\u0438\u043d\u043e\u0439
    \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b,
    \u0438\u043d\u0438\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u043c
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e
    \u0442\u0435\u043e\u0440\u0438\u044e \u044d\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0439.
    \u0414\u0435\u043b\u0438\u043d\u044c \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u044d\u0442\u043e\u0442 \u043c\u043e\u0449\u043d\u044b\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442,
    \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0430\u043c\u0443\u044e
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0438\u0437 \u0433\u0438\u043f\u043e\u0442\u0435\u0437
    \u0412\u0435\u0439\u043b\u044f \u2014 \u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u0445 \u044d\u043d\u0434\u043e\u043c\u043e\u0440\u0444\u0438\u0437\u043c\u0430
    \u0424\u0440\u043e\u0431\u0435\u043d\u0438\u0443\u0441\u0430. \u0420\u0430\u0431\u043e\u0442\u0430
    \u0438\u043c\u0435\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f
    \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b,
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432: \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u0420\u0430\u043c\u0430\u043d\u0443\u0434\u0436\u0430\u043d\u0430-\u041f\u0435\u0442\u0435\u0440\u0441\u043e\u043d\u0430
    \u0434\u043b\u044f \u043c\u043e\u0434\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0444\u043e\u0440\u043c.
    \u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043e\u0446\u0435\u043d\u043a\u0438 \u044d\u043a\u0441\u043f\u043e\u043d\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u0443\u043c\u043c, \u0432\u0430\u0436\u043d\u044b\u0435 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b.\n\n\U0001F52C \u0414\u0440\u0443\u0433\u0438\u0435
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0432\u043a\u043b\u0430\u0434\u044b \u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0414\u0435\u043b\u0438\u043d\u044f \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437 \u0412\u0435\u0439\u043b\u044f. \u041e\u043d
    \u0432\u043d\u0435\u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439. \u0421\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0435
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u0425\u043e\u0434\u0436\u0430 \u0414\u0435\u043b\u0438\u043d\u044c
    \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0425\u043e\u0434\u0436\u0430, \u0434\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0441\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0445
    \u0438 \u043d\u0435\u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0445 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439 \u043d\u0435\u0441\u0443\u0442
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u0443\u044e
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0425\u043e\u0434\u0436\u0430. \u042d\u0442\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043c\u043e\u0449\u043d\u044b\u0445
    \u0438 \u0447\u0430\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0445
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u041a\u0430\u0442\u0442\u0430\u043d\u0438
    \u0438 \u041a\u0430\u043f\u043b\u0430\u043d\u043e\u043c \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u044d\u0442\u0443 \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e\u0431 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u043d\u043e\u0441\u0442\u0438,
    \u0434\u0430\u044e\u0449\u0435\u0439 \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u044b
    \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0425\u043e\u0434\u0436\u0430. \u0422\u0435\u043e\u0440\u0438\u044f
    \u043c\u043e\u0442\u0438\u0432\u043e\u0432 \u0438 \u0435\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u0414\u0435\u043b\u0438\u043d\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u043e\u0442\u0438\u0432\u043e\u0432 \u2014 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u043e\u0433\u043e
    \u0437\u0430\u043c\u044b\u0441\u043b\u0430 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u0430,
    \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u044c
    \u0432\u0441\u0435 \u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438. \u041e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u0434 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u044b\u0445
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438,
    \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0445 \u0434\u043b\u044f \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043e\u043d \u0432\u0432\u0435\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 1-\u043c\u043e\u0442\u0438\u0432\u043e\u0432
    \u2014 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432, \u0447\u044c\u0438 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0435
    \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0434\u0430\u044e\u0442 \u043f\u0440\u0438\u043c\u0435\u0440\u044b
    \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0445 \u043c\u043e\u0442\u0438\u0432\u043e\u0432.
    \u0415\u0433\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u043e\u0431 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f\u0445
    1-\u043c\u043e\u0442\u0438\u0432\u043e\u0432, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0430\u044f,
    \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435
