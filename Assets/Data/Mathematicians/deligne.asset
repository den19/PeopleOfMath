    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439. \u0414\u0440\u0443\u0433\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u041c\u043e\u0434\u0443\u043b\u0438 \u043a\u0440\u0438\u0432\u044b\u0445:
    \u0412 \u0440\u0430\u043d\u043d\u0435\u0439 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439
