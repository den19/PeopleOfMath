    \u0430\u0431\u0431\u0430\u0442\u0441\u0442\u0432\u0435 \u0441 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438
    \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c\u0438. \u0413\u0440\u043e\u0431 \u043d\u0435\u0441\u043b\u0438
    \u043b\u043e\u0440\u0434\u044b-\u043a\u0430\u043d\u0446\u043b\u0435\u0440 \u0438 \u0433\u0435\u0440\u0446\u043e\u0433\u0438.
    \u0415\u0433\u043e \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f \u0433\u043b\u0430\u0441\u0438\u0442:
    \u00ab\u0414\u0430 \u0440\u0430\u0434\u0443\u044e\u0442\u0441\u044f \u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0435,
    \u0447\u0442\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0442\u0430\u043a\u043e\u0435 \u0443\u043a\u0440\u0430\u0448\u0435\u043d\u0438\u0435 \u0440\u043e\u0434\u0430
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e\u00bb. -
    \u0421\u0443\u0434\u044c\u0431\u0430 \u0442\u0435\u043b\u0430: \u0412 1731 \u0433\u043e\u0434\u0443,
    \u0447\u0435\u0440\u0435\u0437 4 \u0433\u043e\u0434\u0430 \u043f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438, \u0435\u0433\u043e \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u0446\u0430
    \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044c \u043e\u0442\u043a\u0440\u044b\u0442\u044c
    \u0433\u0440\u043e\u0431, \u043d\u043e \u0442\u0435\u043b\u043e \u0443\u0436\u0435 \u0440\u0430\u0437\u043b\u043e\u0436\u0438\u043b\u043e\u0441\u044c.
    \u0421\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0440\u044f\u0434\u044c \u0440\u044b\u0436\u0435\u0432\u0430\u0442\u044b\u0445 \u0432\u043e\u043b\u043e\u0441,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0436\u0435 \u0431\u044b\u043b\u0430
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0430 \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u0440\u0442\u0443\u0442\u0438
    (\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043e). \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430: \u041e\u043d \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c
    \u0438\u0441\u043a\u0430\u043b \u0411\u043e\u0433\u0430 \u0447\u0435\u0440\u0435\u0437 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u043d\u043e \u043f\u0440\u043e\u0436\u0438\u043b \u0436\u0438\u0437\u043d\u044c, \u043f\u043e\u043b\u043d\u0443\u044e
    \u043d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u0438, \u0441\u0442\u0440\u0430\u0445\u0430
    \u0438 \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0433\u043e \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0430.
    \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443
    \u043d\u0435\u0431\u0435\u0441, \u043d\u043e \u043d\u0435 \u0441\u043c\u043e\u0433 \u043d\u0430\u043b\u0430\u0434\u0438\u0442\u044c
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0434\u0443\u0448\u0438."
  personalLifeEn: "Isaac Newton's personal life is the story of a genius who knowingly sacrificed human heat for absolute intellectual control, who was a man who feared proximity, hated conflicts (but constantly provoked them) and kept virginity for the rest of his life, considering carnal attractions as an obstacle to his mind.\n\n==Early life==The birth and descent of Isaac Newton (1642) was born on December 25, 1642 (in the Julian calendar then in England) in Wolsthorpe, Lincolnshire County. This day was symbolic of himself: he considered himself \"a Christmas dytem\", which later fed his messian thinking about his divine purpose.His father, Isaac Newton, was an illiterate but wealthy farmer who owned sheep and land.Interestingly, later, as an adult, Newton will be furiously denying the Holy Trinity doctrine as a pagan innovation. --\n\n* Childhood trauma and the breakup with the mother (1645–1655), when Isaac was 3, his mother, Anna Eisco, married for the second time a 63-year-old priest, Varna-Bas Smith. This was a marriage for money. — Traition: The boy was left to the care of his grandmother, Marjorie Eiscow. Newton remembered the moment when her mother left the carriage with his new husband. He vowed publicly to avenge his stepfather.- Documentary testimony: In his \"graves\" notebook (which he led in his youth), item 13 states: \"Did Smith's father and mother burn them and their house above them.\" - Mother's return: in 1656, Varnava Smith died, and Anna returned to Woolstorpe with three children from a second marriage (Newton's mother's brothers and sisters). Newton, who was 14, hated his half-brother and sister, and this exclusion lasted for life.Anna was never able to make emotional contact with Isaac -- he saw her as a stranger. --\n\n===Sabs===Lived by the pharmacist Clark, Newton began to perform engineering skills from the sabsier to the professor (1661–1669), the Grantham School (1655–1661), he was a teacher who was a teacher, and he was a prick, but he defeated a local hooligan in an intellectual duel, and became the first student.Cambridge, Trinity College (1661), when he was 18, he entered the university, not as a nobleman, but as a subsizer, the lowest.- Nature: Co-eds described him as \"worry and suspicious\", he did not participate in the diving, and in his spare time he painted coal on the walls of a portrait of scientists and demons. 1667 - 1669: When new vacancies opened in Cambridge in 1667, Newton was promoted by his mentor Isaac Barrow to the position of junior fellow (a college member).And in 1669, Barrow, who saw the student's genius, voluntarily gave up his prestigious Lucas math department in favor of 26-year-old Newton.\n\nWork: Professor and Chief of the Cambridge Monet Court (1669–1696) Newton gave lectures on optics and mathematics for about 30 years, but his lectures were terribly boring, and students didn't understand it, and he often read it in front of empty benches. That wasn't upsetting. He went completely into his personal calculations. Work at the Monet Court (since 1696) was a cool turn.In 1696, Lord Halifax, a friend of Newton, obtained his appointment as the guardian of the Royal Mint.In particular, he personally obtained the execution of the most famous counterfeiter Isaac (William) Chalonor using legal traps.\n\n♪ Relations with other scientists: Paranoia and the war Newton was insufferable in communication. He suffered persecution: everyone seemed to want to steal his ideas. War with Robert Gook (1672–1703) It was the most violent battle. Guk was the curator of the Royal Society's experiments and had authority. - Conflict over light: When Newton introduced his color theory in 1672, Guk mocked her and claimed to have come to the same conclusions earlier.- Personal aversion: Hook was a humpback and a short, Newton despised him for his appearance. After Guk accused Newton of plagiarizing the law of reverse squares (which was partly fair because Guk had made a hypothesis earlier), Newton was furious and threatened to leave science altogether.When Guk died in 1703, Newton, as president of the Royal Society, ordered the removal of Guke's only living portrait from the conference room, and the portrait disappeared, and we still don't know what Guk looked like, the war with Gotfried Leibnitz (from 1699 to death) The dispute over who first invented the calculation turned into a political scandal between England and Europe.Newton claimed that Leibnitz stole his ideas after watching his drafts in 1676. - Dirty methods: As president of the Royal Society, Newton created a \"investigation committee\", wrote anonymous reviews of Leibnitz's work, and signed them himself as official documents of society.The only friend, Edmund Galley Astron, who was named after the comet, was one of the few Newton respected, and it was Galley who convinced Newton to write \"Start\" and paid for their publication out of his pocket because the Royal Society had no money.\n\nThe psychological crisis (1693) at the peak of Newton's glory was a nervous breakdown. He stopped sleeping, he began hallucinations.- Reasons: The stories link this to mercury poisoning (due to alchemic experiments) and to the exorcism of 30 years of intellectual overwork. - Exit: He survived. The recovery occurred when he changed environment and moved to London for a position in the Monet Court - routine bureaucratic work calmed his mind.\n\n♪ Personal life: Solitude as a choice of Newton was never married and, by historical records, had no romantic relationship with either women or men. ♪ Fatio de Duye: In the 1690s, he had an emotional, almost hysterical attachment to the young Swiss mathematician Nicole Fatio de Dewyet (he was 24, Newton - 50) They lived in the same room, spending days behind alchemy.Fatio saved Newton from insomnia, reading him out loud at night, but when Fatio suddenly left, Newton took it as a betrayal. Later, Fatio was accused of heresy and fled England. This loss of heart aggravated his 1693 crisis.There were rumors in the public that she was Lord Halifax's mistress, but Newton turned a blind eye to it, because he had political backing through her.\n\nIn 1725, Newton began to suffer severe pains from urinary disease (stemstones in his kidneys), and he stopped eating solid food.According to the witnesses, before his death, he refused to accept the holy communion of the priest (which confirms his antitrinitarian views), but the body was displayed with a large pomp. - Funerals: For the first time in the history of England, a scientist was buried in the Westminster Abbey with honors of the State.- Body fate: In 1731, four years after her death, his niece tried to open the coffin, but the body was already decomposed. Only a bunch of red hairs were preserved, which was later examined for mercury content (confirmed). Newton's paradox: He spent his whole life searching for God through math, but lived a life full of hatred, fear, and cold loneliness. He created the mechanic of the heavens, but he couldn't set up the mechanic of his own soul."
  shortBioRu: "\u0418\u0441\u0430\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d \u2014 \u043e\u0434\u043d\u0430
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0438
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u044b\u0445 \u0444\u0438\u0433\u0443\u0440
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0443\u0442\u0435\u043c \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u043d\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445 \u043b\u0438\u0447\u043d\u044b\u0445 \u0442\u0440\u0430\u0432\u043c,
    \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u0438 \u0442\u0430\u0439\u043d\u044b\u043c\u0438
    \u0437\u043d\u0430\u043d\u0438\u044f\u043c\u0438 \u0438 \u043d\u0435\u043f\u0440\u0435\u043a\u043b\u043e\u043d\u043d\u043e\u0439
    \u0431\u043e\u0440\u044c\u0431\u044b \u0437\u0430 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435.\n\n\u23f3
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u044e\u043d\u043e\u0441\u0442\u044c:
    \u0422\u0440\u0430\u0432\u043c\u0430 \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u0411\u0443\u0434\u0443\u0449\u0438\u0439
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0443\u0447\u0435\u043d\u044b\u0439 \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0441\u0432\u0435\u0442 \u0432 \u043a\u0430\u043d\u0443\u043d \u0420\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0430
    1642 \u0433\u043e\u0434\u0430 (25 \u0434\u0435\u043a\u0430\u0431\u0440\u044f \u043f\u043e
    \u0441\u0442\u0430\u0440\u043e\u043c\u0443 \u0441\u0442\u0438\u043b\u044e, \u0438\u043b\u0438
    4 \u044f\u043d\u0432\u0430\u0440\u044f 1643 \u043f\u043e \u043d\u043e\u0432\u043e\u043c\u0443)
    \u0432 \u043f\u043e\u043c\u0435\u0441\u0442\u044c\u0435 \u0412\u0443\u043b\u0441\u0442\u043e\u0440\u043f,
    \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u043e \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0448\u0438\u0440,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u043d\u0435\u0431\u043e\u0433\u0430\u0442\u043e\u0433\u043e
    \u0444\u0435\u0440\u043c\u0435\u0440\u0430. \u0415\u0433\u043e \u043e\u0442\u0435\u0446,
    \u0442\u0430\u043a\u0436\u0435 \u0418\u0441\u0430\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d,
    \u0443\u043c\u0435\u0440 \u0437\u0430 \u0442\u0440\u0438 \u043c\u0435\u0441\u044f\u0446\u0430
    \u0434\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0441\u044b\u043d\u0430.
    \u041c\u0430\u043b\u044c\u0447\u0438\u043a \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0445\u0438\u043b\u044b\u043c \u0438 \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u043c,
    \u0447\u0442\u043e, \u043f\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u043e\u0432\u0430\u043c, \u00ab\u043f\u043e\u043c\u0435\u0441\u0442\u0438\u043b\u0441\u044f
    \u0431\u044b \u0432 \u043f\u0438\u0432\u043d\u0443\u044e \u043a\u0440\u0443\u0436\u043a\u0443\u00bb;
    \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0432\u0435\u0440\u0438\u043b, \u0447\u0442\u043e
    \u043e\u043d \u0432\u044b\u0436\u0438\u0432\u0435\u0442. \u0413\u043b\u0430\u0432\u043d\u044b\u043c
    \u0441\u043e\u0431\u044b\u0442\u0438\u0435\u043c, \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u043c
    \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440, \u0441\u0442\u0430\u043b
    \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0439 \u0431\u0440\u0430\u043a \u043c\u0430\u0442\u0435\u0440\u0438.
    \u041a\u043e\u0433\u0434\u0430 \u0418\u0441\u0430\u0430\u043a\u0443 \u0431\u044b\u043b\u043e
    \u0442\u0440\u0438 \u0433\u043e\u0434\u0430, \u0435\u0433\u043e \u043c\u0430\u0442\u044c,
    \u0410\u043d\u043d\u0430 \u042d\u0439\u0441\u043a\u043e\u0443, \u0432\u044b\u0448\u043b\u0430
    \u0437\u0430\u043c\u0443\u0436 \u0437\u0430 \u0431\u043e\u0433\u0430\u0442\u043e\u0433\u043e
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430 \u0412\u0430\u0440\u043d\u0430\u0432\u0443
    \u0421\u043c\u0438\u0442\u0430 \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430
    \u043a \u043d\u0435\u043c\u0443, \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u0441\u044b\u043d\u0430
    \u043d\u0430 \u043f\u043e\u043f\u0435\u0447\u0435\u043d\u0438\u0435 \u0431\u0430\u0431\u0443\u0448\u043a\u0438.
    \u042d\u0442\u0430 \u00ab\u0438\u0437\u043c\u0435\u043d\u0430\u00bb \u043d\u0430\u043d\u0435\u0441\u043b\u0430
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0443 \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e
    \u0434\u0443\u0448\u0435\u0432\u043d\u0443\u044e \u0440\u0430\u043d\u0443. \u0411\u0443\u0434\u0443\u0447\u0438
    \u0443\u0436\u0435 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c, \u041d\u044c\u044e\u0442\u043e\u043d
    \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0432 \u0441\u043f\u0438\u0441\u043e\u043a \u0441\u0432\u043e\u0438\u0445
    \u0433\u0440\u0435\u0445\u043e\u0432 \u0434\u0435\u0442\u0441\u043a\u0443\u044e \u0443\u0433\u0440\u043e\u0437\u0443:
    \u00ab\u0423\u0433\u0440\u043e\u0436\u0430\u043b \u043e\u0442\u0446\u0443 \u0438 \u043c\u0430\u0442\u0435\u0440\u0438
    \u0421\u043c\u0438\u0442\u0443 \u0441\u0436\u0435\u0447\u044c \u0438\u0445 \u0438 \u0434\u043e\u043c
    \u043d\u0430\u0434 \u043d\u0438\u043c\u0438\u00bb. \u041f\u043e \u043c\u043d\u0435\u043d\u0438\u044e
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432,
    \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0435
    \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442 \u0435\u0433\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u0443\u044e
    \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0441\u0442\u044c, \u043c\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043d\u043e\u0441\u0442\u044c, \u043f\u0440\u043e\u044f\u0432\u0438\u0432\u0448\u0438\u0435\u0441\u044f
    \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c. \u0428\u043a\u043e\u043b\u044c\u043d\u044b\u0435
    \u0433\u043e\u0434\u044b \u043f\u0440\u043e\u0448\u043b\u0438 \u0432 \u0413\u0440\u0430\u043d\u0442\u0435\u043c\u0435,
    \u0433\u0434\u0435 \u043e\u043d \u0436\u0438\u043b \u0432 \u0441\u0435\u043c\u044c\u0435
    \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u0430\u043f\u0442\u0435\u043a\u0430\u0440\u044f
    \u041a\u043b\u0430\u0440\u043a\u0430. \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u0441\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u044b\u043c:
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0445\u0438\u043c\u0438\u0435\u0439
    \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430\u043c\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043f\u0435\u0440\u0432\u044b\u0439 \u043e\u043f\u044b\u0442 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430. \u041e\u043d \u0441 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435\u043c
    \u043c\u0430\u0441\u0442\u0435\u0440\u0438\u043b \u043c\u043e\u0434\u0435\u043b\u0438 \u0432\u0435\u0442\u0440\u044f\u043d\u044b\u0445
    \u043c\u0435\u043b\u044c\u043d\u0438\u0446, \u0432\u043e\u0434\u044f\u043d\u044b\u0435 \u0438
    \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0435 \u0447\u0430\u0441\u044b \u0438 \u0434\u0430\u0436\u0435
    \u0441\u043e\u0437\u0434\u0430\u043b \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437 \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0430.
    \u0412 \u0448\u043a\u043e\u043b\u0435 \u0418\u0441\u0430\u0430\u043a \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u0443\u0447\u0438\u043b\u0441\u044f \u043f\u043b\u043e\u0445\u043e \u0438 \u0431\u044b\u043b
    \u043c\u0438\u0448\u0435\u043d\u044c\u044e \u0434\u043b\u044f \u043d\u0430\u0441\u043c\u0435\u0448\u0435\u043a.
    \u041d\u043e \u043e\u0434\u043d\u0430\u0436\u0434\u044b, \u043f\u043e\u0441\u043b\u0435
    \u0436\u0435\u0441\u0442\u043e\u043a\u043e\u0439 \u0434\u0440\u0430\u043a\u0438, \u043e\u043d
    \u0440\u0435\u0448\u0438\u043b \u0432\u0437\u044f\u0442\u044c \u0440\u0435\u0432\u0430\u043d\u0448
    \u043d\u0435 \u0441\u0438\u043b\u043e\u0439, \u0430 \u0443\u043c\u043e\u043c \u0438 \u0432\u0441\u043a\u043e\u0440\u0435
    \u0441\u0442\u0430\u043b \u043b\u0443\u0447\u0448\u0438\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043c\u0430\u0442\u044c \u0432\u0438\u0434\u0435\u043b\u0430
    \u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0438\u043a\u043e\u043c \u0444\u0435\u0440\u043c\u044b
    \u0438 \u0432 15 \u043b\u0435\u0442 \u0437\u0430\u0431\u0440\u0430\u043b\u0430 \u0438\u0437
    \u0448\u043a\u043e\u043b\u044b. \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e \u0434\u043b\u044f
    \u043d\u0430\u0443\u043a\u0438, \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u043e\u043c
    \u041d\u044c\u044e\u0442\u043e\u043d \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u043d\u0435\u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d: \u043e\u043d \u0437\u0430\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043b
    \u0434\u0435\u043b\u0430 \u0438 \u0447\u0438\u0442\u0430\u043b \u043a\u043d\u0438\u0433\u0438,
    \u0443\u043a\u0440\u044b\u0432\u0448\u0438\u0441\u044c \u0432 \u0442\u0435\u043d\u0438 \u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432.
    \u0414\u044f\u0434\u044f \u0438 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u0443\u0431\u0435\u0434\u0438\u043b\u0438 \u0410\u043d\u043d\u0443 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c
    \u0441\u044b\u043d\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435.\n\n\U0001F393
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436 \u0438 \u043f\u0435\u0440\u0432\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0412 1661 \u0433\u043e\u0434\u0443 \u0432
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 18 \u043b\u0435\u0442 \u041d\u044c\u044e\u0442\u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0418\u0437-\u0437\u0430 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0433\u043e
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043e\u043d \u043d\u0430\u0447\u0430\u043b
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0432 \u0441\u0442\u0430\u0442\u0443\u0441\u0435
    \u00ab\u0441\u0430\u0431\u0441\u0430\u0439\u0437\u0435\u0440\u0430\u00bb \u2014 \u0431\u0435\u0434\u043d\u043e\u0433\u043e
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0438\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043b \u0431\u043e\u043b\u0435\u0435
    \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u0442\u043e\u0432\u0430\u0440\u0438\u0449\u0430\u043c,
    \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043d\u0430 \u0443\u0447\u0435\u0431\u0443. \u0412 \u043f\u0435\u0440\u0432\u044b\u0435
    \u0433\u043e\u0434\u044b \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 \u0435\u0433\u043e
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0441\u0442\u0430\u043b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0418\u0441\u0430\u0430\u043a \u0411\u0430\u0440\u0440\u043e\u0443. \u041d\u044c\u044e\u0442\u043e\u043d
    \u0441 \u0436\u0430\u0434\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u0430\u0431\u0440\u043e\u0441\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u00ab\u043d\u043e\u0432\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb: \u0440\u0430\u0431\u043e\u0442
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u0413\u0430\u0441\u0441\u0435\u043d\u0434\u0438,
    \u0411\u043e\u0439\u043b\u044f \u0438 \u041a\u0435\u043f\u043b\u0435\u0440\u0430. \u0412
    \u0441\u0432\u043e\u0438\u0445 \u043b\u0438\u0447\u043d\u044b\u0445 \u0437\u0430\u043f\u0438\u0441\u044f\u0445
    \u00abQuaestiones Quaedam Philosophicae\u00bb (\u00ab\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0435
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b\u00bb)
    \u043e\u043d \u0443\u0436\u0435 \u043e\u0442\u043e\u0448\u0435\u043b \u043e\u0442 \u0441\u0445\u043e\u043b\u0430\u0441\u0442\u0438\u043a\u0438
    \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044f \u0438 \u043d\u0430\u0447\u0430\u043b
    \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438. \u0427\u0443\u043c\u043d\u044b\u0435 \u0433\u043e\u0434\u044b
    (1665\u20131667) \u0441\u0442\u0430\u043b\u0438 \u0441\u0430\u043c\u044b\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c
    \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043c \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.
    \u0418\u0437-\u0437\u0430 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0438 \u0447\u0443\u043c\u044b
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436 \u0431\u044b\u043b \u0437\u0430\u043a\u0440\u044b\u0442,
    \u0438 \u041d\u044c\u044e\u0442\u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u0440\u043e\u0434\u043d\u043e\u0439 \u0412\u0443\u043b\u0441\u0442\u043e\u0440\u043f.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c, \u0432 \u0443\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0438,
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0442\u043e, \u0447\u0442\u043e
    \u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u0437\u043e\u0432\u0443\u0442 \u0435\u0433\u043e
    \u00abannus mirabilis\u00bb (\u0433\u043e\u0434\u043e\u043c \u0447\u0443\u0434\u0435\u0441):
    \u0412 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u043e\u043d \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    (\u0441\u043e\u0437\u0434\u0430\u0432 \u00ab\u043c\u0435\u0442\u043e\u0434 \u0444\u043b\u044e\u043a\u0441\u0438\u0439\u00bb)
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0431\u0438\u043d\u043e\u043c
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430. \u0412 \u043e\u043f\u0442\u0438\u043a\u0435
    \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u044b \u0441 \u043f\u0440\u0438\u0437\u043c\u0430\u043c\u0438,
    \u0434\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0431\u0435\u043b\u044b\u0439
    \u0441\u0432\u0435\u0442 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u043c\u0435\u0441\u044c\u044e
    \u0446\u0432\u0435\u0442\u043e\u0432. \u0412 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435
    \u043e\u043d \u0432\u044b\u0432\u0435\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0446\u0435\u043d\u0442\u0440\u043e\u0431\u0435\u0436\u043d\u043e\u0439
    \u0441\u0438\u043b\u044b \u0438 \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0434\u043e\u0433\u0430\u0434\u043a\u0435
    \u043e \u0437\u0430\u043a\u043e\u043d\u0435 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f, \u0445\u043e\u0442\u044f \u0442\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0435\u0451.\n\n\U0001F3C6
    \u0417\u0432\u0435\u0437\u0434\u043d\u044b\u0439 \u0447\u0430\u0441: \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440,
    \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436,
    \u041d\u044c\u044e\u0442\u043e\u043d \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u0448\u0435\u043b \u0432\u0432\u0435\u0440\u0445 \u043f\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435. \u0412 1667 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430,
    \u0432 1668 \u2014 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u043e\u043c, \u0430 \u0432
    1669 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 26
    \u043b\u0435\u0442, \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u041b\u0443\u043a\u0430\u0441\u043e\u0432\u0441\u043a\u0443\u044e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0441\u043c\u0435\u043d\u0438\u0432 \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443
    \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0418\u0441\u0430\u0430\u043a\u0430
    \u0411\u0430\u0440\u0440\u043e\u0443. \u042d\u0442\u043e \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u043b\u043e
    \u0435\u0433\u043e \u043e\u0442 \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438
    \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0441\u0430\u043d \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e,
    \u0442\u0430\u043a \u043a\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d \u0442\u0430\u0439\u043d\u043e
    \u043f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0441\u044f \u0435\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u0440\u0438\u0430\u043d\u0441\u0442\u0432\u0430, \u043e\u0442\u0440\u0438\u0446\u0430\u044e\u0449\u0435\u0433\u043e
    \u0422\u0440\u043e\u0438\u0446\u0443. \u0412 1672 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043f\u0435\u0440\u0432\u043e\u0433\u043e
    \u0432 \u043c\u0438\u0440\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430-\u0440\u0435\u0444\u043b\u0435\u043a\u0442\u043e\u0440\u0430,
    \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e
    \u0442\u0435\u043e\u0440\u0438\u044f \u0441\u0432\u0435\u0442\u0430 \u0441\u0440\u0430\u0437\u0443
    \u0432\u044b\u0437\u0432\u0430\u043b\u0430 \u043e\u0441\u0442\u0440\u0443\u044e \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0443
    \u0441 \u0420\u043e\u0431\u0435\u0440\u0442\u043e\u043c \u0413\u0443\u043a\u043e\u043c,
    \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u043e \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u043a\u0440\u0430\u0439\u043d\u0435 \u043d\u0435\u043b\u044e\u0434\u0438\u043c\u044b\u043c
    \u0438 \u043c\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u043e\u0441\u043b\u0435
    \u044d\u0442\u043e\u0439 \u0442\u0440\u0430\u0432\u043b\u0438 \u043e\u043d \u043d\u0430\u0434\u043e\u043b\u0433\u043e
    \u0437\u0430\u043c\u043a\u043d\u0443\u043b\u0441\u044f \u0438 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b. \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u0432\u0441\u0435\u0439 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438, \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043d\u0430\u0447\u0430\u043b\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb (Philosophi\u00e6 Naturalis
    Principia Mathematica), \u0431\u044b\u043b \u0441\u043e\u0437\u0434\u0430\u043d \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430
    \u042d\u0434\u043c\u0443\u043d\u0434\u0430 \u0413\u0430\u043b\u043b\u0435\u044f. \u0412
    1684 \u0433\u043e\u0434\u0443 \u0413\u0430\u043b\u043b\u0435\u0439 \u043f\u0440\u0438\u0448\u0435\u043b
    \u043a \u041d\u044c\u044e\u0442\u043e\u043d\u0443 \u0441 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c
    \u043e \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438 \u0442\u0435\u043b \u043f\u043e\u0434
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043c \u0446\u0435\u043d\u0442\u0440\u043e\u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u0438\u043b\u044b, \u0438 \u041d\u044c\u044e\u0442\u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u0443\u0436\u0435 \u0432\u044b\u0432\u0435\u043b \u044d\u0442\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043d\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u0440\u0430\u0441\u0447\u0435\u0442\u044b. \u041f\u043e\u0434 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c
    \u0413\u0430\u043b\u043b\u0435\u044f \u043e\u043d \u0437\u0430\u043d\u043e\u0432\u043e \u043f\u0440\u043e\u0432\u0435\u043b
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0438 \u0432 1687 \u0433\u043e\u0434\u0443
    \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u043d\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0413\u0430\u043b\u043b\u0435\u044f.
    \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0438 \u0441\u0442\u0430\u043b\u0430 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438.\n\n\U0001F3DB\ufe0f \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434: \u041c\u043e\u043d\u0435\u0442\u043d\u044b\u0439 \u0434\u0432\u043e\u0440,
    \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0438 \u0441\u043f\u043e\u0440\u044b \u0412
    1689 \u0433\u043e\u0434\u0443 \u041d\u044c\u044e\u0442\u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u0447\u043b\u0435\u043d\u043e\u043c \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430
    \u043e\u0442 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u0433\u043e
