  achievementsRu: "\u0418\u0441\u0430\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0442\u0430\u043b\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u0444\u0438\u0437\u0438\u043a\u0443
    \u0438 \u043e\u043f\u0442\u0438\u043a\u0443, \u0438 \u043a\u0430\u0436\u0434\u044b\u0439
    \u0438\u0437 \u044d\u0442\u0438\u0445 \u0442\u0440\u0443\u0434\u043e\u0432 \u043f\u043e-\u0441\u0432\u043e\u0435\u043c\u0443
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0435\u043d.\n\n\U0001F4D0
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u044f\u0437\u044b\u043a\u0430 \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0413\u043b\u0430\u0432\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u0430 \u0444\u043b\u044e\u043a\u0441\u0438\u0439
    \u2014 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043c\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u043c.
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0438\u0434\u0435\u0438 \u044d\u0442\u043e\u0433\u043e
    \u043c\u0435\u0442\u043e\u0434\u0430 \u0431\u044b\u043b\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u044b
    \u0438\u043c \u043e\u043a\u043e\u043b\u043e 1665\u20131667 \u0433\u043e\u0434\u043e\u0432,
    \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u0435\u0433\u043e \u0443\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f
    \u0432 \u0412\u0443\u043b\u0441\u0442\u043e\u0440\u043f\u0435. \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f
    \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f: \u041d\u044c\u044e\u0442\u043e\u043d
    \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b (\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b \u0444\u043b\u044e\u044d\u043d\u0442\u0430\u043c\u0438)
    \u043a\u0430\u043a \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e \"\u0442\u0435\u043a\u0443\u0449\u0438\u0435\"
    \u0432\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c
    \u044d\u0442\u043e\u0433\u043e \"\u0442\u0435\u0447\u0435\u043d\u0438\u044f\" \u043e\u043d
    \u043d\u0430\u0437\u0432\u0430\u043b \u0444\u043b\u044e\u043a\u0441\u0438\u0435\u0439. \u041f\u043e
    \u0441\u0443\u0442\u0438, \u0444\u043b\u044e\u043a\u0441\u0438\u044f \u2014 \u044d\u0442\u043e
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u0430\u044f, \u0430 \u0444\u043b\u044e\u044d\u043d\u0442\u0430
    \u2014 \u043f\u0435\u0440\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f.
    \u0414\u0432\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438:
    \u041c\u0435\u0442\u043e\u0434 \u0441\u0432\u043e\u0434\u0438\u043b \u0432\u0441\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043a \u0434\u0432\u0443\u043c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c:
    1. \u041f\u043e \u0434\u0430\u043d\u043d\u043e\u043c\u0443 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044e
    \u043c\u0435\u0436\u0434\u0443 \u0444\u043b\u044e\u044d\u043d\u0442\u0430\u043c\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c
    \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043c\u0435\u0436\u0434\u0443
    \u0438\u0445 \u0444\u043b\u044e\u043a\u0441\u0438\u044f\u043c\u0438 (\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435).
    2. \u041f\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0435\u043c\u0443
    \u0444\u043b\u044e\u043a\u0441\u0438\u0438, \u043d\u0430\u0439\u0442\u0438 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    \u043c\u0435\u0436\u0434\u0443 \u0444\u043b\u044e\u044d\u043d\u0442\u0430\u043c\u0438 (\u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435).
    \u0411\u0438\u043d\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d\u0430: \u0427\u0442\u043e\u0431\u044b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441\u043e \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u0438, \u041d\u044c\u044e\u0442\u043e\u043d
    \u043e\u0442\u043a\u0440\u044b\u043b \u043e\u0431\u0449\u0443\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u0431\u0438\u043d\u043e\u043c\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u044f\u0434\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u0430
    \u0440\u0430\u0437\u043b\u043e\u0436\u0438\u0442\u044c `(1 + x)^n` \u0432 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439
    \u0440\u044f\u0434 \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f
    `n`. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043c\u043e\u0449\u043d\u0435\u0439\u0448\u0438\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439. \u041f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438:
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u043f\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0442\u0430\u043a\u0438\u0435
    \u043a\u0430\u043a \"\u0410\u043d\u0430\u043b\u0438\u0437 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c
    \u0447\u0438\u0441\u043b\u043e\u043c \u0447\u043b\u0435\u043d\u043e\u0432\" (\u043d\u0430\u043f\u0438\u0441\u0430\u043d
    \u0432 1669, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d \u0432 1711)
    \u0438 \"\u041c\u0435\u0442\u043e\u0434 \u0444\u043b\u044e\u043a\u0441\u0438\u0439 \u0438
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445 \u0440\u044f\u0434\u043e\u0432\"
    (\u043d\u0430\u043f\u0438\u0441\u0430\u043d \u0432 1671, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d
    \u0432 1736), \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u043e\u0439.
    \"\u0412\u0441\u0435\u043e\u0431\u0449\u0430\u044f \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\",
    \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0435\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0439
    \u043f\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0435, \u0432\u044b\u0448\u043b\u0430
    \u0432 1707 \u0433\u043e\u0434\u0443.\n\n\U0001F30C \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430
    \u0438 \u0417\u0430\u043a\u043e\u043d \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f: \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u043c\u0438\u0440\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0412\u0435\u0440\u0448\u0438\u043d\u043e\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0441\u0442\u0430\u043b\u0438 \"\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043d\u0430\u0447\u0430\u043b\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\" (1687). \u0412 \u044d\u0442\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \u043e\u043d \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b
    \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u0438\u043c \u0437\u0430\u043a\u043e\u043d\u044b
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f
    \u0432 \u0435\u0434\u0438\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u043a\u0430\u043a \u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u044f\u0431\u043b\u043e\u043a\u0430,
    \u0442\u0430\u043a \u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0435\u0442.
    \u0422\u0440\u0438 \u0437\u0430\u043a\u043e\u043d\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    (\u0437\u0430\u043a\u043e\u043d\u044b \u041d\u044c\u044e\u0442\u043e\u043d\u0430): \u0417\u0430\u043a\u043e\u043d\u044b,
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0449\u0438\u0435 \u0441\u0432\u044f\u0437\u044c
    \u043c\u0435\u0436\u0434\u0443 \u0441\u0438\u043b\u043e\u0439, \u043c\u0430\u0441\u0441\u043e\u0439
    \u0438 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435\u043c \u0442\u0435\u043b\u0430,
    \u0441\u0442\u0430\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438. \u0417\u0430\u043a\u043e\u043d \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f: \u041d\u044c\u044e\u0442\u043e\u043d
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0441\u0438\u043b\u0430 \u043f\u0440\u0438\u0442\u044f\u0436\u0435\u043d\u0438\u044f
    \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f \u0442\u0435\u043b\u0430\u043c\u0438
    \u043f\u0440\u044f\u043c\u043e \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044e \u0438\u0445 \u043c\u0430\u0441\u0441
    \u0438 \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438 (`F = G (m1 m2) / r^2`). \u041b\u0435\u0433\u0435\u043d\u0434\u0430
    \u043e \u044f\u0431\u043b\u043e\u043a\u0435, \u0445\u043e\u0442\u044c \u0438 \u0443\u043f\u0440\u043e\u0449\u0430\u0435\u0442
    \u0438\u0441\u0442\u043e\u0440\u0438\u044e, \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442
    \u0435\u0433\u043e \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0435 \u043e \u0442\u043e\u043c,
    \u0447\u0442\u043e \u043e\u0434\u043d\u0430 \u0438 \u0442\u0430 \u0436\u0435 \u0441\u0438\u043b\u0430
    \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435\u043c
    \u043d\u0430 \u0417\u0435\u043c\u043b\u0435 \u0438 \u0432 \u043d\u0435\u0431\u0435\u0441\u0430\u0445.\n\n\U0001F308
    \u041e\u043f\u0442\u0438\u043a\u0430: \u041f\u0440\u0438\u0440\u043e\u0434\u0430 \u0441\u0432\u0435\u0442\u0430
    \u0438 \u0446\u0432\u0435\u0442\u0430 \u041d\u044c\u044e\u0442\u043e\u043d \u0432\u043d\u0435\u0441
    \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0438 \u0432 \u0443\u0447\u0435\u043d\u0438\u0435 \u043e
    \u0441\u0432\u0435\u0442\u0435. \u0421\u0432\u043e\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043e\u043d
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0432 \u0442\u0440\u0443\u0434\u0435 \"\u041e\u043f\u0442\u0438\u043a\u0430\",
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u043c \u0432
    1704 \u0433\u043e\u0434\u0443. \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u044b
    \u0441 \u043f\u0440\u0438\u0437\u043c\u0430\u043c\u0438: \u041f\u0440\u043e\u0432\u043e\u0434\u044f
    \u043e\u043f\u044b\u0442\u044b \u0441 \u043f\u0440\u0438\u0437\u043c\u0430\u043c\u0438 \u0432
    \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u043d\u043e\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435,
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u0431\u0435\u043b\u044b\u0439 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0439 \u0441\u0432\u0435\u0442
    \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u043c,
    \u0430 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u043b\u0443\u0447\u0435\u0439
    \u0441 \u0440\u0430\u0437\u043d\u043e\u0439 \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u044f\u0435\u043c\u043e\u0441\u0442\u044c\u044e,
    \u043a\u0430\u0436\u0434\u044b\u0439 \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u043c\u0443
    \u0446\u0432\u0435\u0442\u0443. \u041f\u0440\u0438\u0437\u043c\u0430 \u043d\u0435 \"\u043e\u043a\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\"
    \u0441\u0432\u0435\u0442, \u0430 \u043b\u0438\u0448\u044c \u0440\u0430\u0437\u043b\u0430\u0433\u0430\u0435\u0442
    \u0435\u0433\u043e \u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043d\u044b\u0435 \u0447\u0430\u0441\u0442\u0438.
    \u041e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u0439 \u0438 \u043d\u0435\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u0439
    \u0441\u0432\u0435\u0442: \u041e\u043d \u043e\u0442\u043a\u0440\u044b\u043b, \u0447\u0442\u043e
    \u0446\u0432\u0435\u0442 \u2014 \u044d\u0442\u043e \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b\u0435\u043c\u043e\u0435
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0442\u0438\u043f\u0430 \u043b\u0443\u0447\u0435\u0439. \u041b\u0443\u0447 \u0441 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u044f\u0435\u043c\u043e\u0441\u0442\u0438
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u043c\u0435\u0435\u0442 \u043e\u0434\u0438\u043d
    \u0438 \u0442\u043e\u0442 \u0436\u0435 \u0446\u0432\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c
    \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u043c \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u0435\u043c
    \u0438\u043b\u0438 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c. \u0421\u043c\u0435\u0448\u0435\u043d\u0438\u0435
    \u0446\u0432\u0435\u0442\u043e\u0432: \u041d\u044c\u044e\u0442\u043e\u043d \u0442\u0430\u043a\u0436\u0435
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u043c
    \u0441\u043c\u0435\u0448\u0435\u043d\u0438\u0435\u043c \u0432\u0441\u0435\u0445 \u0446\u0432\u0435\u0442\u043e\u0432
    \u0441\u043f\u0435\u043a\u0442\u0440\u0430 \u043c\u043e\u0436\u043d\u043e \u0441\u043d\u043e\u0432\u0430
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0431\u0435\u043b\u044b\u0439 \u0441\u0432\u0435\u0442.
    \u0411\u0435\u0437\u0436\u0430\u043b\u043e\u0441\u0442\u043d\u043e\u0435 \u0441\u0430\u043c\u043e\u043f\u043e\u0437\u043d\u0430\u043d\u0438\u0435:
    \u0412 \u0441\u0432\u043e\u0438\u0445 \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0430\u0445
    \u041d\u044c\u044e\u0442\u043e\u043d \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0448\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u044b
    \u043f\u043e \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e \u0437\u0440\u0435\u043d\u0438\u044f,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d \u043d\u0430\u0436\u0438\u043c\u0430\u043b
    \u043d\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0433\u043b\u0430\u0437
    \u0442\u043e\u043d\u043a\u043e\u0439 \u0438\u0433\u043b\u043e\u0439 (\u0431\u043e\u0434\u043a\u0438\u043d\u043e\u043c),
    \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c, \u043a\u0430\u043a
    \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0438\u0441\u043a\u0430\u0436\u0430\u0435\u0442 \u0446\u0432\u0435\u0442\u043e\u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u0435.\n\n\U0001F9EA
    \u0422\u0430\u0439\u043d\u044b\u0439 \u043c\u0438\u0440: \u0410\u043b\u0445\u0438\u043c\u0438\u044f
    \u0438 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044f \u0412\u0430\u0436\u043d\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c,
    \u0447\u0442\u043e \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0433\u043e \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0447\u0435\u0442\u043a\u043e\u0439 \u0433\u0440\u0430\u043d\u0438\u0446\u044b
    \u043c\u0435\u0436\u0434\u0443 \u0444\u0438\u0437\u0438\u043a\u043e\u0439, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0438 \u0442\u0435\u043c, \u0447\u0442\u043e \u043c\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u0431\u044b \u044d\u0437\u043e\u0442\u0435\u0440\u0438\u043a\u043e\u0439.
    \u041e\u0433\u0440\u043e\u043c\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0435\u0433\u043e
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0430
    \u0430\u043b\u0445\u0438\u043c\u0438\u0438 \u0438 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u044e.
    \u0410\u043b\u0445\u0438\u043c\u0438\u044f: \u041e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b
    \u0431\u0435\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u043e\u043f\u044b\u0442\u044b
    \u0441 \u043c\u0435\u0442\u0430\u043b\u043b\u0430\u043c\u0438, \u0438\u0441\u043a\u0430\u043b
    \"\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439 \u043a\u0430\u043c\u0435\u043d\u044c\"
    \u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u0442\u0440\u0430\u043d\u0441\u043c\u0443\u0442\u0430\u0446\u0438\u0438
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432. \u0411\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u0435:
    \u041d\u044c\u044e\u0442\u043e\u043d \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0438\u0437\u0443\u0447\u0430\u043b
    \u0411\u0438\u0431\u043b\u0438\u044e, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043a\u043d\u0438\u0433\u0443
    \u043f\u0440\u043e\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0438\u0438\u043b\u0430, \u043f\u044b\u0442\u0430\u044f\u0441\u044c
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u0434\u0430\u0442\u0443 \u043a\u043e\u043d\u0446\u0430
    \u0441\u0432\u0435\u0442\u0430 \u0438 \u043f\u043e\u043d\u044f\u0442\u044c \u0441\u043a\u0440\u044b\u0442\u044b\u0439
    \u0441\u043c\u044b\u0441\u043b \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432."
  achievementsEn: "Isaac Newton left behind a legacy that became the foundation of all modern science, its contribution to mathematics, physics, and optics, and each of these works is revolutionary in its own way.\n\nMathematics: The creation of a language to describe the movement is Newton's main mathematical achievement: the creation of a flux method -- what we call today a differential and integrated calculation. The key ideas of this method were developed by him around 1665 - 1667, during his isolation in Wolstorpe. The basic concept: Newton considered the variables (which he called the fluents) as continuous \"current\" over time.The speed of this \"flow\" he called the fluxy. In fact, the fluxy is a derivative and the fluent is a prime function. Two main tasks: The method reduced all mathematical tasks to two problems: 1. In this relation between the fluents, determine the relationship between their fluuxes (differing). 2. By the equation containing the fluuxy, find the ratio between the fluents (integrating).Newton Binom: To work with complex functions, Newton discovered a common binominal series formula that allowed the \"(1 + x)n\" to be placed in an endless row for any indicator `n'. This has become the most powerful tool for computation.Publications: Main mathematics works, such as \"Analysis by Equation with An infinite number of members\" (written in 1669, published in 1711) and \"Method of Fluxium and Infinity Series\" (written in 1671, published in 1736), were published with great delay. \"General arithmetic\", a collection of his lectures on algebra, was published in 1707.\n\nThe \"Mathematical Beginnings of Natural Philosophy\" (1687), in which he combined the laws of movement and gravity he has discovered into a single system that describes both the fall of the apple and the movement of the planets.The law of worldwide gravity: Newton mathematically proved that the force of gravity between two bodies is directly proportional to the work of their masses and is inversely proportional to the square of distance between them ('F = G (m1 m2) / rx2'). The legend of the apple, while simplifying history, reflects his reflection that the same force controls movement on the Earth and in the heavens.\n\nThe nature of light and colour Newton has contributed equally fundamentally to the teaching of light. He has described his discoveries in this field in \"Optica\" published in 1704. Experiments with prism: By experimenting with prism in a dark room, Newton has shown that white sunlight is not homogeneous, but consists of rays with different refractability, each of which corresponds to a certain colour.Prysma does not \"paint\" light, but decomposes it into parts. A homogeneous and diverse light: It revealed that colour is an inherent property of a certain type of beam. A beam with a particular degree of refractability always has the same color that cannot be changed by further refraction or reflection. The mixture of colors: Newton also showed that by a reverse mix of all the colors of the spectrum, you can get white light again.Unbridled self - knowledge: Newton's diaries describe shocking experiments in the field of vision, in which he pressed a thin needle (bodkin) on his own eye to see how mechanical influence distorts the perception of the flower.\n\nThe secret world: Alchemy and theology, it's important to understand that for Newton himself, there was no clear line between physics, mathematics, and what we would call esoterics today. A huge part of his manuscript is about alchemy and theology. Alchemy: He's done countless experiments with metals, he's been looking for a Philosophical stone and ways to transmute substances.Theology: Newton has studied the Bible in depth, especially the book of the prophet Daniel, trying to calculate the date of the end of the world and to understand the hidden meaning of prophecy."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0418\u0441\u0430\u0430\u043a\u0430
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0433\u0435\u043d\u0438\u044f, \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0435\u0433\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u043c \u0442\u0435\u043f\u043b\u043e\u043c
    \u0440\u0430\u0434\u0438 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f. \u041e\u043d \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u043e\u044f\u043b\u0441\u044f \u0431\u043b\u0438\u0437\u043e\u0441\u0442\u0438,
    \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u044b
    (\u043d\u043e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0438\u0445 \u043f\u0440\u043e\u0432\u043e\u0446\u0438\u0440\u043e\u0432\u0430\u043b)
    \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0434\u043d\u0435\u0439 \u0445\u0440\u0430\u043d\u0438\u043b
    \u0434\u0435\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c, \u0441\u0447\u0438\u0442\u0430\u044f
    \u043f\u043b\u043e\u0442\u0441\u043a\u0438\u0435 \u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u043f\u043e\u043c\u0435\u0445\u043e\u0439 \u0434\u043b\u044f \u0443\u043c\u0430. \u041d\u0438\u0436\u0435
    \u2014 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0438,
    \u043e\u0442 \u043a\u043e\u043b\u044b\u0431\u0435\u043b\u0438 \u0434\u043e \u043c\u043e\u0433\u0438\u043b\u044b,
    \u0441 \u0430\u043a\u0446\u0435\u043d\u0442\u043e\u043c \u043d\u0430 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0434\u0435\u0442\u0430\u043b\u0438 \u0438 \u0432\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f.
    ---\n\n\U0001F476 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    (1642) \u0418\u0441\u0430\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    25 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1642 \u0433\u043e\u0434\u0430 (\u043f\u043e
    \u044e\u043b\u0438\u0430\u043d\u0441\u043a\u043e\u043c\u0443 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044e,
    \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0435\u043c\u0443 \u0442\u043e\u0433\u0434\u0430
    \u0432 \u0410\u043d\u0433\u043b\u0438\u0438) \u0432 \u043f\u043e\u043c\u0435\u0441\u0442\u044c\u0435
    \u0412\u0443\u043b\u0441\u0442\u043e\u0440\u043f, \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u043e
    \u041b\u0438\u043d\u043a\u043e\u043b\u044c\u043d\u0448\u0438\u0440. \u042d\u0442\u043e\u0442
    \u0434\u0435\u043d\u044c \u0431\u044b\u043b \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u043d
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u043e: \u043e\u043d
    \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0435\u0431\u044f \u00ab\u0440\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0435\u043d\u0441\u043a\u0438\u043c
    \u0434\u0438\u0442\u0435\u043c\u00bb, \u0447\u0442\u043e \u043f\u043e\u0437\u0436\u0435
    \u043f\u043e\u0434\u043f\u0438\u0442\u044b\u0432\u0430\u043b\u043e \u0435\u0433\u043e \u043c\u0435\u0441\u0441\u0438\u0430\u043d\u0441\u043a\u0438\u0435
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u043e \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438. -
    \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u043e\u043d:
    \u041e\u043d \u0431\u044b\u043b \u043f\u043e\u0442\u043e\u043c\u043a\u043e\u043c \u0437\u0430\u0436\u0438\u0442\u043e\u0447\u043d\u044b\u0445,
    \u043d\u043e \u043d\u0435 \u0437\u043d\u0430\u0442\u043d\u044b\u0445 \u0439\u043e\u043c\u0435\u043d\u043e\u0432
    (\u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0445 \u043a\u0440\u0435\u0441\u0442\u044c\u044f\u043d).
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0418\u0441\u0430\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d-\u0441\u0442\u0430\u0440\u0448\u0438\u0439,
    \u0431\u044b\u043b \u043d\u0435\u0433\u0440\u0430\u043c\u043e\u0442\u043d\u044b\u043c, \u043d\u043e
    \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0444\u0435\u0440\u043c\u0435\u0440\u043e\u043c,
    \u0432\u043b\u0430\u0434\u0435\u0432\u0448\u0438\u043c \u043e\u0432\u0446\u0430\u043c\u0438
    \u0438 \u0437\u0435\u043c\u043b\u0435\u0439. - \u041e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f: \u041c\u0430\u043b\u044c\u0447\u0438\u043a
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043f\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c
    \u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u043c,
    \u0447\u0442\u043e, \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u043c\u043e\u0433
    \u043f\u043e\u043c\u0435\u0441\u0442\u0438\u0442\u044c\u0441\u044f \u0432 \u043a\u0432\u0430\u0440\u0442\u043e\u0432\u0443\u044e
    \u043a\u0440\u0443\u0436\u043a\u0443 (\u043e\u043a\u043e\u043b\u043e 1,1 \u043b\u0438\u0442\u0440\u0430).
    \u0414\u0432\u0435 \u0442\u0435\u0442\u0443\u0448\u043a\u0438, \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u0435
    \u043f\u0440\u0438 \u0440\u043e\u0434\u0430\u0445, \u043f\u043e\u0441\u043b\u0430\u043b\u0438
    \u0437\u0430 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0430\u043c\u0438, \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0435,
    \u0447\u0442\u043e \u043e\u043d \u0443\u043c\u0440\u0435\u0442, \u043d\u043e \u043e\u043d
    \u0432\u044b\u0436\u0438\u043b. - \u041a\u0440\u0435\u0449\u0435\u043d\u0438\u0435: \u0415\u0433\u043e
    \u043a\u0440\u0435\u0441\u0442\u0438\u043b\u0438 \u0432 \u043c\u0435\u0441\u0442\u043d\u043e\u0439
    \u0446\u0435\u0440\u043a\u0432\u0438 \u0421\u0432\u044f\u0442\u043e\u0433\u043e \u0422\u0440\u043e\u0438\u0446\u044b.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u043f\u043e\u0437\u0436\u0435,
    \u0441\u0442\u0430\u0432 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c, \u041d\u044c\u044e\u0442\u043e\u043d
    \u0431\u0443\u0434\u0435\u0442 \u044f\u0440\u043e\u0441\u0442\u043d\u043e \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u044c
    \u0434\u043e\u0433\u043c\u0430\u0442 \u043e \u0421\u0432\u044f\u0442\u043e\u0439 \u0422\u0440\u043e\u0438\u0446\u0435,
    \u0441\u0447\u0438\u0442\u0430\u044f \u0435\u0433\u043e \u044f\u0437\u044b\u0447\u0435\u0441\u043a\u0438\u043c
    \u043d\u043e\u0432\u043e\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c. ---\n\n\U0001F9D2
    \u0422\u0440\u0430\u0432\u043c\u0430 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0438 \u0440\u0430\u0437\u0440\u044b\u0432
    \u0441 \u043c\u0430\u0442\u0435\u0440\u044c\u044e (1645\u20131655) \u041a\u043e\u0433\u0434\u0430
    \u0418\u0441\u0430\u0430\u043a\u0443 \u0431\u044b\u043b\u043e 3 \u0433\u043e\u0434\u0430,
    \u0435\u0433\u043e \u043c\u0430\u0442\u044c, \u0410\u043d\u043d\u0430 \u042d\u0439\u0441\u043a\u043e\u0443,
    \u0432\u044b\u0448\u043b\u0430 \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437 \u0437\u0430\u043c\u0443\u0436
    \u0437\u0430 63-\u043b\u0435\u0442\u043d\u0435\u0433\u043e \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430
    \u0412\u0430\u0440\u043d\u0430\u0432\u0443 \u0421\u043c\u0438\u0442\u0430 (Barna-bas Smith).
    \u042d\u0442\u043e \u0431\u044b\u043b \u0431\u0440\u0430\u043a \u043f\u043e \u0440\u0430\u0441\u0447\u0435\u0442\u0443
    \u0440\u0430\u0434\u0438 \u0434\u0435\u043d\u0435\u0433. - \u041f\u0440\u0435\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e:
    \u041c\u0430\u043b\u044c\u0447\u0438\u043a\u0430 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u043d\u0430 \u043f\u043e\u043f\u0435\u0447\u0435\u043d\u0438\u0438 \u0431\u0430\u0431\u0443\u0448\u043a\u0438
    \u041c\u0430\u0440\u0434\u0436\u0435\u0440\u0438 \u042d\u0439\u0441\u043a\u043e\u0443. \u041d\u044c\u044e\u0442\u043e\u043d
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u043b
    \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u043c\u0430\u0442\u044c
    \u0443\u0435\u0445\u0430\u043b\u0430 \u0432 \u043a\u0430\u0440\u0435\u0442\u0435 \u0441\u043e
    \u0441\u0432\u043e\u0438\u043c \u043d\u043e\u0432\u044b\u043c \u043c\u0443\u0436\u0435\u043c.
    \u041e\u043d \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u043f\u043e\u043a\u043b\u044f\u043b\u0441\u044f
    \u043e\u0442\u043e\u043c\u0441\u0442\u0438\u0442\u044c \u043e\u0442\u0447\u0438\u043c\u0443.
    - \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e:
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u0442\u0435\u0442\u0440\u0430\u0434\u0438 \u0434\u043b\u044f
    \u00ab\u0433\u0440\u0435\u0445\u043e\u0432\u00bb (\u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u0432\u0435\u043b \u0432 \u044e\u043d\u043e\u0441\u0442\u0438), \u043f\u0443\u043d\u043a\u0442
    \u211613 \u0433\u043b\u0430\u0441\u0438\u0442: \u00ab\u0423\u0433\u0440\u043e\u0436\u0430\u043b
    \u043e\u0442\u0446\u0443 \u0438 \u043c\u0430\u0442\u0435\u0440\u0438 \u0421\u043c\u0438\u0442\u0443
    \u0441\u0436\u0435\u0447\u044c \u0438\u0445 \u0438 \u0434\u043e\u043c \u043d\u0430\u0434
    \u043d\u0438\u043c\u0438\u00bb. - \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u0440\u0438: \u0412 1656 \u0433\u043e\u0434\u0443 \u0412\u0430\u0440\u043d\u0430\u0432\u0430
    \u0421\u043c\u0438\u0442 \u0443\u043c\u0435\u0440, \u0438 \u0410\u043d\u043d\u0430 \u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c
    \u0432 \u0412\u0443\u043b\u0441\u0442\u043e\u0440\u043f \u0441 \u0442\u0440\u0435\u043c\u044f
    \u0434\u0435\u0442\u044c\u043c\u0438 \u043e\u0442 \u0432\u0442\u043e\u0440\u043e\u0433\u043e
    \u0431\u0440\u0430\u043a\u0430 (\u0431\u0440\u0430\u0442\u044c\u044f\u043c\u0438 \u0438
    \u0441\u0435\u0441\u0442\u0440\u043e\u0439 \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u043f\u043e
    \u043c\u0430\u0442\u0435\u0440\u0438). \u041d\u044c\u044e\u0442\u043e\u043d, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u0431\u044b\u043b\u043e 14, \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u0441\u0432\u043e\u0434\u043d\u044b\u0445
    \u0431\u0440\u0430\u0442\u0430 \u0438 \u0441\u0435\u0441\u0442\u0440\u0443, \u0438 \u044d\u0442\u043e
    \u043e\u0442\u0447\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u043d\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c. \u0410\u043d\u043d\u0430
    \u0442\u0430\u043a \u0438 \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c
    \u0441 \u0418\u0441\u0430\u0430\u043a\u043e\u043c \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u2014 \u043e\u043d \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b
    \u0435\u0451 \u043a\u0430\u043a \u0447\u0443\u0436\u0430\u0447\u043a\u0443. ---\n\n\U0001F393
    \u0423\u0447\u0451\u0431\u0430: \u041e\u0442 \u0441\u0430\u0431\u0441\u0430\u0439\u0437\u0435\u0440\u0430
    \u0434\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 (1661\u20131669)
    \u0428\u043a\u043e\u043b\u0430 \u0432 \u0413\u0440\u0430\u043d\u0442\u0435\u043c\u0435 (1655\u20131661)
    \u0416\u0438\u0432\u044f \u0443 \u0430\u043f\u0442\u0435\u043a\u0430\u0440\u044f \u041a\u043b\u0430\u0440\u043a\u0430,
    \u041d\u044c\u044e\u0442\u043e\u043d \u043d\u0430\u0447\u0430\u043b \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0442\u044c
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0439 \u0442\u0430\u043b\u0430\u043d\u0442:
    \u043c\u0430\u0441\u0442\u0435\u0440\u0438\u043b \u0432\u0435\u0442\u0440\u044f\u043d\u044b\u0435
    \u043c\u0435\u043b\u044c\u043d\u0438\u0446\u044b, \u0432\u043e\u0434\u044f\u043d\u044b\u0435
    \u0447\u0430\u0441\u044b \u0438 \u0434\u0430\u0436\u0435 \u043b\u0435\u0442\u0430\u044e\u0449\u0438\u0435
    \u0444\u043e\u043d\u0430\u0440\u0438\u043a\u0438 (\u0431\u0443\u043c\u0430\u0436\u043d\u044b\u0435
    \u0437\u043c\u0435\u0438 \u0441 \u043f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u043e\u0439).
    \u0423\u0447\u0438\u0442\u0435\u043b\u044f \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438
    \u0435\u0433\u043e \u00ab\u0437\u043b\u043e\u0431\u043d\u0443\u044e \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u00bb.
    \u041e\u043d \u0431\u044b\u043b \u0437\u0430\u043c\u043a\u043d\u0443\u0442, \u0434\u0440\u0430\u0447\u043b\u0438\u0432,
    \u043d\u043e \u0440\u0430\u0437\u0433\u0440\u043e\u043c\u0438\u043b \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0445\u0443\u043b\u0438\u0433\u0430\u043d\u0430 \u0432 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0434\u0443\u044d\u043b\u0438, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e
    \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0432\u044b\u043c \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c.
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436, \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436
    (1661) \u0412 18 \u043b\u0435\u0442 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442, \u043d\u043e
    \u043d\u0435 \u043a\u0430\u043a \u0434\u0432\u043e\u0440\u044f\u043d\u0438\u043d, \u0430
    \u043a\u0430\u043a \u00ab\u0441\u0430\u0431\u0441\u0430\u0439\u0437\u0435\u0440\u00bb (subsizar)
    \u2014 \u0441\u0430\u043c\u044b\u0439 \u043d\u0438\u0437\u043a\u0438\u0439 \u0441\u0442\u0430\u0442\u0443\u0441.
    - \u0411\u044b\u0442: \u041e\u043d \u043f\u0440\u0438\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043b
    \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c:
    \u0447\u0438\u0441\u0442\u0438\u043b \u0438\u043c \u043e\u0431\u0443\u0432\u044c, \u0432\u044b\u043d\u043e\u0441\u0438\u043b
    \u043d\u043e\u0447\u043d\u044b\u0435 \u0433\u043e\u0440\u0448\u043a\u0438 \u0438 \u043f\u0440\u0438\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043b
    \u0437\u0430 \u0441\u0442\u043e\u043b\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u043b\u0430\u0442\u0438\u0442\u044c
    \u0441\u0432\u043e\u0451 \u043f\u0438\u0442\u0430\u043d\u0438\u0435. - \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440:
    \u0421\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a\u0438 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438
    \u0435\u0433\u043e \u043a\u0430\u043a \u00ab\u0443\u0433\u0440\u044e\u043c\u043e\u0433\u043e
    \u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\u00bb,
    \u043e\u043d \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432
    \u043f\u043e\u043f\u043e\u0439\u043a\u0430\u0445, \u0430 \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435
    \u0432\u0440\u0435\u043c\u044f \u0440\u0438\u0441\u043e\u0432\u0430\u043b \u0443\u0433\u043b\u0435\u043c
    \u043d\u0430 \u0441\u0442\u0435\u043d\u0430\u0445 \u043a\u043e\u043c\u043d\u0430\u0442\u044b
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u044b \u0443\u0447\u0435\u043d\u044b\u0445 \u0438
    \u0434\u0435\u043c\u043e\u043d\u043e\u0432. \u041a\u0430\u0440\u044c\u0435\u0440\u043d\u044b\u0439
    \u0440\u044b\u0432\u043e\u043a (1667\u20131669): \u041a\u043e\u0433\u0434\u0430 \u0432 1667
    \u0433\u043e\u0434\u0443 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0435 \u043e\u0442\u043a\u0440\u044b\u043b\u0438\u0441\u044c
    \u043d\u043e\u0432\u044b\u0435 \u0432\u0430\u043a\u0430\u043d\u0441\u0438\u0438, \u041d\u044c\u044e\u0442\u043e\u043d
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043f\u0440\u043e\u0442\u0435\u043a\u0446\u0438\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0430
    \u0418\u0441\u0430\u0430\u043a\u0430 \u0411\u0430\u0440\u0440\u043e\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043c\u043b\u0430\u0434\u0448\u0435\u0433\u043e
    \u0444\u0435\u043b\u043b\u043e\u0443 (\u0447\u043b\u0435\u043d\u0430 \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430).
    \u0410 \u0432 1669 \u0433\u043e\u0434\u0443 \u0411\u0430\u0440\u0440\u043e\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u0438\u0434\u0435\u043b \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430, \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u043e
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442 \u0441\u0432\u043e\u0435\u0439
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439 \u041b\u0443\u043a\u0430\u0441\u043e\u0432\u0441\u043a\u043e\u0439
    \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 26-\u043b\u0435\u0442\u043d\u0435\u0433\u043e
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430. \u0411\u0430\u0440\u0440\u043e\u0443 \u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u042f \u0443\u0441\u0442\u0443\u043f\u0430\u044e \u043c\u0435\u0441\u0442\u043e \u0442\u043e\u043c\u0443,
    \u043a\u0442\u043e \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u043c\u0435\u043d\u044f\u00bb.
    \u042d\u0442\u043e \u0431\u044b\u043b \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0432 \u0436\u0438\u0437\u043d\u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043e\u043d \u0431\u044b\u043b \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0435\u043d. ---\n\n\U0001F4BC \u0420\u0430\u0431\u043e\u0442\u0430:
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0438 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a
    \u041c\u043e\u043d\u0435\u0442\u043d\u043e\u0433\u043e \u0434\u0432\u043e\u0440\u0430 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 (1669\u20131696) \u041e\u043a\u043e\u043b\u043e 30
    \u043b\u0435\u0442 \u041d\u044c\u044e\u0442\u043e\u043d \u0447\u0438\u0442\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u043f\u043e \u043e\u043f\u0442\u0438\u043a\u0435 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043d\u043e \u0435\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438 \u0431\u044b\u043b\u0438
    \u0443\u0436\u0430\u0441\u043d\u043e \u0441\u043a\u0443\u0447\u043d\u044b\u043c\u0438. \u0421\u0442\u0443\u0434\u0435\u043d\u0442\u044b
    \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u043b\u0438 \u0435\u0433\u043e, \u0438
    \u0447\u0430\u0441\u0442\u043e \u043e\u043d \u0447\u0438\u0442\u0430\u043b \u043f\u0435\u0440\u0435\u0434
    \u043f\u0443\u0441\u0442\u044b\u043c\u0438 \u0441\u043a\u0430\u043c\u044c\u044f\u043c\u0438.
    \u042d\u0442\u043e \u0435\u0433\u043e \u043d\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b\u043e
    \u2014 \u043e\u043d \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0443\u0448\u0435\u043b
    \u0432 \u0441\u0432\u043e\u0438 \u043b\u0438\u0447\u043d\u044b\u0435 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.
    \u0420\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u041c\u043e\u043d\u0435\u0442\u043d\u043e\u043c
    \u0434\u0432\u043e\u0440\u0435 (\u0441 1696) \u042d\u0442\u043e \u0431\u044b\u043b \u043a\u0440\u0443\u0442\u043e\u0439
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442. \u0412 1696 \u0433\u043e\u0434\u0443 \u043b\u043e\u0440\u0434
    \u0413\u0430\u043b\u0438\u0444\u0430\u043a\u0441, \u0434\u0440\u0443\u0433 \u041d\u044c\u044e\u0442\u043e\u043d\u0430,
    \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435\u043b\u0435\u043c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043c\u043e\u043d\u0435\u0442\u043d\u043e\u0433\u043e \u0434\u0432\u043e\u0440\u0430 (Warden
    of the Mint). - \u0421\u0443\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b: \u0424\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e
    \u2014 \u043d\u0430\u0434\u0437\u043e\u0440 \u0437\u0430 \u043f\u0435\u0440\u0435\u0447\u0435\u043a\u0430\u043d\u043a\u043e\u0439
    \u043c\u043e\u043d\u0435\u0442\u044b, \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u2014 \u043e\u0445\u043e\u0442\u0430 \u043d\u0430 \u0444\u0430\u043b\u044c\u0448\u0438\u0432\u043e\u043c\u043e\u043d\u0435\u0442\u0447\u0438\u043a\u043e\u0432.
    - \u0416\u0435\u0441\u0442\u043e\u043a\u043e\u0441\u0442\u044c: \u041d\u044c\u044e\u0442\u043e\u043d
    \u043f\u043e\u0434\u043e\u0448\u0435\u043b \u043a \u044d\u0442\u043e\u043c\u0443 \u0441
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043f\u0435\u0434\u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e.
    \u041e\u043d \u043b\u0438\u0447\u043d\u043e \u0434\u043e\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u043b
    \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u043e\u0432, \u0432\u043d\u0435\u0434\u0440\u044f\u043b
    \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0432 \u043b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0435
    \u043f\u043e\u0434\u043f\u043e\u043b\u044c\u0435 \u0438 \u0441\u043e\u0431\u0438\u0440\u0430\u043b
    \u0434\u043e\u0441\u044c\u0435. \u041e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b
    \u043d\u0430 \u0432\u0438\u0441\u0435\u043b\u0438\u0446\u0443 \u0431\u043e\u043b\u0435\u0435
    20 \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u0412 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u043e\u043d \u043b\u0438\u0447\u043d\u043e \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u043a\u0430\u0437\u043d\u0438
    \u0441\u0430\u043c\u043e\u0433\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0444\u0430\u043b\u044c\u0448\u0438\u0432\u043e\u043c\u043e\u043d\u0435\u0442\u0447\u0438\u043a\u0430
    \u0410\u0439\u0437\u0435\u043a\u0430 (\u0423\u0438\u043b\u044c\u044f\u043c\u0430) \u0427\u0430\u043b\u043e\u043d\u043e\u0440\u0430,
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043b\u043e\u0432\u0443\u0448\u043a\u0438. - \u0414\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c:
    \u0412 1699 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u041c\u043e\u043d\u0435\u0442\u043d\u043e\u0433\u043e \u0434\u0432\u043e\u0440\u0430 (Master
    of the Mint) \u2014 \u044d\u0442\u043e \u0434\u0430\u0432\u0430\u043b\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u0435 (\u043e\u043a\u043e\u043b\u043e 2000
    \u0444\u0443\u043d\u0442\u043e\u0432 \u0432 \u0433\u043e\u0434), \u0438 \u041d\u044c\u044e\u0442\u043e\u043d
    \u0441\u0442\u0430\u043b \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c. \u041d\u0430 \u044d\u0442\u043e\u0439
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u043e\u043d \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0432\u0435\u043b \u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442
    \u0432 \u0410\u043d\u0433\u043b\u0438\u0438. ---\n\n\U0001F621 \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438:
    \u041f\u0430\u0440\u0430\u043d\u043e\u0439\u044f \u0438 \u0432\u043e\u0439\u043d\u044b \u041d\u044c\u044e\u0442\u043e\u043d
    \u0431\u044b\u043b \u043d\u0435\u0432\u044b\u043d\u043e\u0441\u0438\u043c \u0432 \u043e\u0431\u0449\u0435\u043d\u0438\u0438.
    \u041e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043c\u0430\u043d\u0438\u0435\u0439
    \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u0432\u043e\u043a\u0440\u0443\u0433 \u0445\u043e\u0442\u044f\u0442
    \u0443\u043a\u0440\u0430\u0441\u0442\u044c \u0435\u0433\u043e \u0438\u0434\u0435\u0438.
    \u0412\u043e\u0439\u043d\u0430 \u0441 \u0420\u043e\u0431\u0435\u0440\u0442\u043e\u043c \u0413\u0443\u043a\u043e\u043c
    (1672\u20131703) \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u0441\u0430\u043c\u0430\u044f
    \u044f\u0440\u043e\u0441\u0442\u043d\u0430\u044f \u0431\u0438\u0442\u0432\u0430. \u0413\u0443\u043a
    \u0431\u044b\u043b \u043a\u0443\u0440\u0430\u0442\u043e\u0440\u043e\u043c \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u043e\u0432
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u0438 \u0438\u043c\u0435\u043b \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442.
    - \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u043e \u0441\u0432\u0435\u0442\u0435:
    \u041a\u043e\u0433\u0434\u0430 \u041d\u044c\u044e\u0442\u043e\u043d \u0432 1672 \u0433\u043e\u0434\u0443
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u0432\u043e\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0446\u0432\u0435\u0442\u0430, \u0413\u0443\u043a \u0432\u044b\u0441\u043c\u0435\u044f\u043b
    \u0435\u0451 \u0438 \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u0441\u0430\u043c
    \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0442\u0435\u043c \u0436\u0435 \u0432\u044b\u0432\u043e\u0434\u0430\u043c
    \u0440\u0430\u043d\u044c\u0448\u0435. - \u041b\u0438\u0447\u043d\u0430\u044f \u043d\u0435\u043f\u0440\u0438\u044f\u0437\u043d\u044c:
    \u0413\u0443\u043a \u0431\u044b\u043b \u0433\u043e\u0440\u0431\u0430\u0442\u044b\u043c \u0438
    \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u0438\u043c, \u041d\u044c\u044e\u0442\u043e\u043d
    \u043f\u0440\u0435\u0437\u0438\u0440\u0430\u043b \u0435\u0433\u043e \u0437\u0430 \u0432\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u044c.
    \u041f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u0413\u0443\u043a
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0432
    \u043f\u043b\u0430\u0433\u0438\u0430\u0442\u0435 \u0437\u0430\u043a\u043e\u043d\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u0445
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432 (\u0447\u0442\u043e \u0431\u044b\u043b\u043e
    \u043e\u0442\u0447\u0430\u0441\u0442\u0438 \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0413\u0443\u043a \u0432\u044b\u0441\u043a\u0430\u0437\u0430\u043b
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u0440\u0430\u043d\u044c\u0448\u0435),
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u0440\u0438\u0448\u0435\u043b \u0432 \u044f\u0440\u043e\u0441\u0442\u044c
    \u0438 \u0443\u0433\u0440\u043e\u0436\u0430\u043b \u0441\u043e\u0432\u0441\u0435\u043c \u0443\u0439\u0442\u0438
    \u0438\u0437 \u043d\u0430\u0443\u043a\u0438. \u041e\u043d \u0432\u044b\u0447\u0435\u0440\u043a\u043d\u0443\u043b
    \u0432\u0441\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u0413\u0443\u043a\u0430
    \u0438\u0437 \u0441\u0432\u043e\u0438\u0445 \u00ab\u041d\u0430\u0447\u0430\u043b\u00bb.
    - \u0417\u043b\u043e\u0440\u0430\u0434\u0441\u0442\u0432\u043e: \u041a\u043e\u0433\u0434\u0430
    \u0432 1703 \u0433\u043e\u0434\u0443 \u0413\u0443\u043a \u0443\u043c\u0435\u0440, \u041d\u044c\u044e\u0442\u043e\u043d,
    \u0441\u0442\u0430\u0432 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
    \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043b \u0443\u0431\u0440\u0430\u0442\u044c \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043f\u0440\u0438\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u0413\u0443\u043a\u0430 \u0438\u0437 \u0437\u0430\u043b\u0430 \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u0439.
    \u041f\u043e\u0440\u0442\u0440\u0435\u0442 \u0431\u0435\u0441\u0441\u043b\u0435\u0434\u043d\u043e
    \u0438\u0441\u0447\u0435\u0437, \u0438 \u043c\u044b \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u043d\u0435 \u0437\u043d\u0430\u0435\u043c, \u043a\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0435\u043b
    \u0413\u0443\u043a. \u0412\u043e\u0439\u043d\u0430 \u0441 \u0413\u043e\u0442\u0444\u0440\u0438\u0434\u043e\u043c
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0435\u043c (\u0441 1699 \u0438 \u0434\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438) \u0421\u043f\u043e\u0440 \u043e \u0442\u043e\u043c,
    \u043a\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u043c \u0438\u0437\u043e\u0431\u0440\u0435\u043b
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435, \u043f\u0435\u0440\u0435\u0440\u043e\u0441
    \u0432 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u043a\u0430\u043d\u0434\u0430\u043b
    \u043c\u0435\u0436\u0434\u0443 \u0410\u043d\u0433\u043b\u0438\u0435\u0439 \u0438 \u0415\u0432\u0440\u043e\u043f\u043e\u0439.
    \u041d\u044c\u044e\u0442\u043e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0443\u043a\u0440\u0430\u043b
    \u0435\u0433\u043e \u0438\u0434\u0435\u0438, \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0432
    \u0435\u0433\u043e \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438 \u0432 1676 \u0433\u043e\u0434\u0443.
    - \u0413\u0440\u044f\u0437\u043d\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b: \u0411\u0443\u0434\u0443\u0447\u0438
    \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u041d\u044c\u044e\u0442\u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u00ab\u043a\u043e\u043c\u0438\u0442\u0435\u0442 \u043f\u043e \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044e\u00bb,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u044b\u0435
    \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u0438 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u044b
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430 \u0438 \u0441\u0430\u043c \u0436\u0435
    \u0438\u0445 \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b \u043a\u0430\u043a \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.
    \u041b\u0435\u0439\u0431\u043d\u0438\u0446 \u0443\u043c\u0435\u0440 \u0432 1716 \u0433\u043e\u0434\u0443
    \u0432 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438, \u043f\u043e\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u0432 \u044d\u0442\u043e\u0439 \u0442\u0440\u0430\u0432\u043b\u0435. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0434\u0440\u0443\u0433 \u2014 \u042d\u0434\u043c\u0443\u043d\u0434 \u0413\u0430\u043b\u043b\u0435\u0439
    \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c, \u0432 \u0447\u0435\u0441\u0442\u044c
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0430\u0437\u0432\u0430\u043b\u0438
    \u043a\u043e\u043c\u0435\u0442\u0443, \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0445, \u043a\u043e\u0433\u043e
    \u041d\u044c\u044e\u0442\u043e\u043d \u0443\u0432\u0430\u0436\u0430\u043b. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0413\u0430\u043b\u043b\u0435\u0439 \u0443\u0433\u043e\u0432\u043e\u0440\u0438\u043b \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb
    \u0438 \u0441\u0430\u043c \u043e\u043f\u043b\u0430\u0442\u0438\u043b \u0438\u0445 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e
    \u0438\u0437 \u0441\u0432\u043e\u0435\u0433\u043e \u043a\u0430\u0440\u043c\u0430\u043d\u0430,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0443 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0435\u043d\u0435\u0433.
    ---\n\n\U0001F9E0 \u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u0440\u0438\u0437\u0438\u0441 (1693) \u041d\u0430 \u043f\u0438\u043a\u0435 \u0441\u043b\u0430\u0432\u044b
    \u0443 \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f
    \u043d\u0435\u0440\u0432\u043d\u044b\u0439 \u0441\u0440\u044b\u0432. \u041e\u043d \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b
    \u0441\u043f\u0430\u0442\u044c, \u0443 \u043d\u0435\u0433\u043e \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c
    \u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0438. - \u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:
    \u041e\u043d \u043f\u0438\u0441\u0430\u043b \u0431\u0435\u0437\u0443\u043c\u043d\u044b\u0435
    \u043f\u0438\u0441\u044c\u043c\u0430 \u0434\u0440\u0443\u0437\u044c\u044f\u043c: \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0443
    \u041b\u043e\u043a\u043a\u0443 \u043e\u043d \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0432
    \u0442\u043e\u043c, \u0447\u0442\u043e \u0442\u043e\u0442 \u00ab\u0445\u043e\u0442\u0435\u043b
    \u0437\u0430\u043f\u0443\u0442\u0430\u0442\u044c \u0435\u0433\u043e \u0441 \u0436\u0435\u043d\u0449\u0438\u043d\u0430\u043c\u0438\u00bb;
    \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044e \u041f\u0435\u043f\u0438\u0441\u0443
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u041f\u0435\u043f\u0438\u0441
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u00ab\u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0449\u0438\u043a\u0438\u00bb
    \u043f\u044b\u0442\u0430\u044e\u0442\u0441\u044f \u0435\u0433\u043e \u0443\u0431\u0438\u0442\u044c.
    - \u041f\u0440\u0438\u0447\u0438\u043d\u044b: \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0442 \u044d\u0442\u043e \u0441 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c
    \u0440\u0442\u0443\u0442\u044c\u044e (\u0438\u0437-\u0437\u0430 \u0430\u043b\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u043f\u044b\u0442\u043e\u0432) \u0438 \u0441 \u0432\u044b\u0433\u043e\u0440\u0430\u043d\u0438\u0435\u043c
    \u043e\u0442 30-\u043b\u0435\u0442\u043d\u0435\u0433\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u0435\u0440\u0435\u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f. -
    \u0412\u044b\u0445\u043e\u0434: \u041e\u043d \u0432\u044b\u0436\u0438\u043b. \u0412\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d
    \u0441\u043c\u0435\u043d\u0438\u043b \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443
    \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u041b\u043e\u043d\u0434\u043e\u043d
    \u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0432 \u041c\u043e\u043d\u0435\u0442\u043d\u043e\u043c
    \u0434\u0432\u043e\u0440\u0435 \u2014 \u0440\u0443\u0442\u0438\u043d\u043d\u0430\u044f \u0431\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0443\u0441\u043f\u043e\u043a\u043e\u0438\u043b\u0430
    \u0435\u0433\u043e \u0431\u043e\u043b\u044c\u043d\u043e\u0439 \u0440\u0430\u0437\u0443\u043c.
    ---\n\n\U0001F494 \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u041e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e
    \u043a\u0430\u043a \u0432\u044b\u0431\u043e\u0440 \u041d\u044c\u044e\u0442\u043e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0438, \u043f\u043e \u0432\u0441\u0435\u043c
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0434\u0430\u043d\u043d\u044b\u043c,
    \u043d\u0435 \u0438\u043c\u0435\u043b \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0432\u044f\u0437\u0435\u0439 \u043d\u0438 \u0441 \u0436\u0435\u043d\u0449\u0438\u043d\u0430\u043c\u0438,
    \u043d\u0438 \u0441 \u043c\u0443\u0436\u0447\u0438\u043d\u0430\u043c\u0438. - \u0414\u0440\u0443\u0436\u0431\u0430
    \u0441 \u0424\u0430\u0442\u0438\u043e \u0434\u0435 \u0414\u044e\u0439\u0435: \u0412 1690-\u0445
    \u0433\u043e\u0434\u0430\u0445 \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0430
    \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f, \u043f\u043e\u0447\u0442\u0438
    \u0438\u0441\u0442\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c
