    \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c
    \u0434\u0430\u0442\u0443 \u0410\u043f\u043e\u043a\u0430\u043b\u0438\u043f\u0441\u0438\u0441\u0430.
    \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0440\u0438\u0445\u043e\u0442\u044c \u2014 \u0432 XVII \u0432\u0435\u043a\u0435 \u0430\u043b\u0445\u0438\u043c\u0438\u044f
    \u0441\u0447\u0438\u0442\u0430\u043b\u0430\u0441\u044c \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u043e\u0439, \u0438 \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u043d\u0430\u0439\u0442\u0438 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0441\u0438\u043b\u044b
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435
    \u043c\u043e\u0433\u043b\u0430 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u0430\u043d\u0430\u043b\u0438\u0437
    \u0435\u0433\u043e \u0432\u043e\u043b\u043e\u0441, \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043d\u044b\u0439
    \u0441\u043f\u0443\u0441\u0442\u044f \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f, \u043f\u043e\u043a\u0430\u0437\u0430\u043b
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435
    \u0440\u0442\u0443\u0442\u0438, \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0445
    \u0430\u043b\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u043f\u044b\u0442\u043e\u0432.
    \u042d\u0442\u043e \u043c\u043e\u0433\u043b\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u0442\u044c
    \u043d\u0430 \u0435\u0433\u043e \u043d\u0435\u0440\u0432\u043d\u044b\u0435 \u0441\u0440\u044b\u0432\u044b
    \u0438 \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438
    \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438.
    \u0423\u043c\u0435\u0440 \u0441\u044d\u0440 \u0418\u0441\u0430\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d
    \u0432 1727 \u0433\u043e\u0434\u0443 \u0432 \u041a\u0435\u043d\u0441\u0438\u043d\u0433\u0442\u043e\u043d\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 84 \u043b\u0435\u0442 \u0438 \u0431\u044b\u043b
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u0432 \u0412\u0435\u0441\u0442\u043c\u0438\u043d\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u043c
    \u0430\u0431\u0431\u0430\u0442\u0441\u0442\u0432\u0435, \u0441\u0442\u0430\u0432 \u043f\u0435\u0440\u0432\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c, \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u044b\u043c
    \u0442\u0430\u043a\u043e\u0439 \u0447\u0435\u0441\u0442\u0438."
  shortBioEn: "Isaac Newton is one of the most complex and controversial figures in the history of science; his life was not just a genius scientist, but a history of deep personal trauma, obsession with secret knowledge, and a relentless struggle for recognition.\n\n♪ Childhood and youth: The future great scientist appeared on Christmas Eve of 1642 (25 December in the old style, or 4 January 1643) at Wolstorpe estate, Lincolnshire County, in the family of a rich farmer. His father, Isaac Newton, died three months before his son was born.The boy was born so weak and tiny that, according to his own words, he would \"be in a beer cup\"; no one believed that he would survive; the main event that formed his character was his mother's remarriage; when Isaac was three years old, his mother, Anna Eiscou, married a wealthy priest, Varnavu Smith, and moved in with him, leaving his son in his grandmother's care; this \"truth\" caused a deep heart injury to the boy.As an adult, Newton added to his list of sins a child's threat: \"Did Smith's father and mother burn them and the house over them.\" According to many historians, this is the experience that explains his painful isolation, hunches, and conflict in the future, and he spent high school years in Grantham, where he lived in the family of local pharmacy Clark.And when he saw it, he said, \"O my Lord!However, his mother saw him as a farm heir and took him out of school when she was 15, and fortunately for science, Newton was completely incapable of managing the estate, and he dropped his affairs and read books while hiding in the shadows of trees, and his uncle and his school teacher convinced Anna to allow his son to study.\n\n===Cambridge===Cambridge and the first discoveries in 1661 at the age of 18 entered Trinity College at Cambridge University.Newton's personal notes \"Quaesions Quaedam Philosophiae\" have already moved away from Aristotle's schema and began to formulate his own ideas.It was there, in solitude, that later they would call him \"annus mirabilis\" (year of wonder): in mathematics, he laid the foundations of differential and integrated calculation (after creating the \"fluxie method\") and designed the Newton binom. In the optics, he began famous experiments with prisms, proving that white light was a mixture of flowers. In mechanics, he drew the formula of centrifugal force and came to a guess about the law of global gravity, even though he did not publish it.\n\n♪ Star hour: Professor, \"Starting\" and confession when he returned to Cambridge, Newton quickly went up the academic ladder. In 1667, he became a college member, in 1668 a master's degree, and in 1669, at the age of 26, he received the Lucas mathematics profession, replacing his teacher Isaac Barrow.This relieved him of his duty to take the priest's saint, which was critical, because Newton secretly adhered to the heretical arianism that denied the Trinity. In 1672, after the world's first mirror reflector telescope, he was elected a member of the Royal Society of London, but his theory of light immediately triggered a sharp debate with Robert Hook, which made Newton extremely unhuman and recalcitrant.After this harassment, he was locked up for a long time and refused to publish his work. The main work of his life, \"Philosophié Natural Philosophy\" (Philosophie Naturalist) was created thanks to the perseverance of astronomer Edmund Galley. In 1684, Galley came to Newton with a question about the trajectory of the bodies under the influence of a centrifugal force, and Newton replied that he had already taken that decision, but had lost his calculations.Under the pressure of Halley, he recompensed and in 1687 \"Starting\" was published with Galley's resources, which laid the foundation for classical mechanics and became the greatest scientific work in history.\n\n==History==The London period: In 1689, Newton was elected as a Member of Parliament from Cambridge University, but his real career began in 1696 when he was appointed to the Monet Court Manager and then to his director, and in that post he acted as a brilliant administrator, reformed money and personally fought against counterfeiters.In 1703, after the death of her main enemy, Robert Guk, Newton was elected president of the Royal Society and held the post for the rest of her life. In 1705, Queen Anne raised him to knighthood.The paradox was that Newton had developed a calculation earlier, but later published it later in Leibnitz, Newton, who was of a heavy character, used his position as head of the Royal Society to accuse the opponent of plagiarism.\n\n▪ Secret World: Alchemy and theology Besides Physics and Mathematics, Newton dedicated more than half of his manuscripts to alchemy, theology, and chronology. He sought \"philosophical stone\" and wrote interpretations of Bible prophecies, trying to calculate the date of the Apocalypse. It was not just a whim — in the 17th century, alchemy was considered a full-fledged science, and Newton was trying to find hidden forces of nature that could not explain the mechanic.Interestingly, his hair analysis over the centuries showed a massive mercury content, which is the result of years of alchemical experiments, which could have affected his nervous breakdowns and strange behaviors in recent years, and Sir Isaac Newton died in 1727 in Kensington at the age of 84 and was buried in Westminster Abbey, becoming the first scientist to be so honored."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0418\u0441\u0430\u0430\u043a\u0430 \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0441\u0443\u0445\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b, \u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439
    \u0442\u0440\u0438\u043b\u043b\u0435\u0440 \u0441 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438
    \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u0432\u0430, \u0447\u0435\u0440\u043d\u043e\u0439
    \u043c\u0430\u0433\u0438\u0438, \u0441\u0443\u043c\u0430\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u044f
    \u0438 \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u043e\u0433\u043e \u044d\u0433\u043e.
    \u0417\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0441\u044f \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0439,
    \u043c\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439, \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u044b\u0439
    \u0438 \u043e\u0447\u0435\u043d\u044c \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a.
    \u041d\u0438\u0436\u0435 \u2014 \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u044f \u0441\u0430\u043c\u044b\u0445
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445, \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0445
    \u0438 \u0448\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0445 \u0444\u0430\u043a\u0442\u043e\u0432
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0440\u0430\u0437\u0431\u0438\u0442\u0430\u044f \u043f\u043e \u0442\u0435\u043c\u0430\u043c.
    ---\n\n\U0001F34F 1. \u042f\u0431\u043b\u043e\u043a\u043e: \u041f\u0440\u0430\u0432\u0434\u0430
    \u0438 \u0432\u044b\u043c\u044b\u0441\u0435\u043b \u0418\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e \u043f\u0430\u0434\u0430\u044e\u0449\u0435\u043c \u044f\u0431\u043b\u043e\u043a\u0435
    \u2014 \u0441\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430 \u0432 \u043d\u0430\u0443\u043a\u0435, \u043d\u043e
    \u043f\u0440\u0430\u0432\u0434\u0430 \u0432 \u043d\u0435\u0439 \u043b\u0438\u0448\u044c
    \u043d\u0430\u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443. - \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435: \u0421\u0430\u043c
    \u041d\u044c\u044e\u0442\u043e\u043d \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u044d\u0442\u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u0432 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c \u0434\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c
    \u043b\u0438\u0446\u0430\u043c, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0423\u0438\u043b\u044c\u044f\u043c\u0430
    \u0421\u0442\u044c\u044e\u043a\u043b\u0438 (\u043e\u043d \u0437\u0430\u043f\u0438\u0441\u0430\u043b
    \u044d\u0442\u043e \u0432 \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0435 \u0432 1726 \u0433\u043e\u0434\u0443)
    \u0438 \u0412\u043e\u043b\u044c\u0442\u0435\u0440\u0430 (\u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u0446\u0430
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u041a\u044d\u0442\u0440\u0438\u043d). - \u0421\u0443\u0442\u044c
    \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u044f: \u042f\u0431\u043b\u043e\u043a\u043e \u043d\u0435
    \u0443\u043f\u0430\u043b\u043e \u0435\u043c\u0443 \u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u0443.
    \u041d\u044c\u044e\u0442\u043e\u043d \u0441\u0438\u0434\u0435\u043b \u0443 \u043a\u0430\u043c\u0438\u043d\u0430
    \u0438\u043b\u0438 \u0432 \u0441\u0430\u0434\u0443, \u0443\u0432\u0438\u0434\u0435\u043b
    \u043f\u0430\u0434\u0430\u044e\u0449\u0435\u0435 \u044f\u0431\u043b\u043e\u043a\u043e \u0438
    \u0437\u0430\u0434\u0430\u043b\u0441\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c:
    \u00ab\u041f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d\u043e \u043f\u0430\u0434\u0430\u0435\u0442
    \u0441\u0442\u0440\u043e\u0433\u043e \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e,
    \u0430 \u043d\u0435 \u043f\u043e\u0434 \u0443\u0433\u043b\u043e\u043c \u0438\u043b\u0438
    \u0432\u0432\u0435\u0440\u0445?\u00bb. \u042d\u0442\u043e \u043d\u0430\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u043e
    \u0435\u0433\u043e \u043d\u0430 \u043c\u044b\u0441\u043b\u044c, \u0447\u0442\u043e \u0417\u0435\u043c\u043b\u044f
    \u043f\u0440\u0438\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442 \u044f\u0431\u043b\u043e\u043a\u043e,
    \u0438 \u044d\u0442\u0430 \u0436\u0435 \u0441\u0438\u043b\u0430, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u041b\u0443\u043d\u0443 \u043d\u0430
    \u043e\u0440\u0431\u0438\u0442\u0435. - \u041a\u0443\u0440\u044c\u0435\u0437: \u041d\u044c\u044e\u0442\u043e\u043d
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u044f\u0431\u043b\u043e\u043a\u043e
    \u043d\u0435 \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u0438, \u0430 \u0434\u043b\u044f
    \u043e\u043f\u0442\u0438\u043a\u0438. \u041e\u043d \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e
    \u0447\u0430\u0441\u0442\u043e \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b
    \u044f\u0431\u043b\u043e\u043a\u0438 \u043d\u0430 \u0441\u043e\u043b\u043d\u0446\u0435,
    \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043f\u0435\u0440\u0435\u043b\u0438\u0432\u044b
    \u0446\u0432\u0435\u0442\u043e\u0432 \u043d\u0430 \u0438\u0445 \u043a\u043e\u0436\u0438\u0446\u0435.
    ---\n\n\U0001F525 2. \u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439 \u043f\u0438\u0440\u043e\u043c\u0430\u043d
    \u0438 \u0441\u043f\u0438\u0441\u043e\u043a \u0433\u0440\u0435\u0445\u043e\u0432 \u0412
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19 \u043b\u0435\u0442, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c, \u041d\u044c\u044e\u0442\u043e\u043d
    \u0437\u0430\u0432\u0435\u043b \u0442\u0435\u0442\u0440\u0430\u0434\u044c, \u0432 \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b \u0432\u0441\u0435 \u0441\u0432\u043e\u0438
    \u0433\u0440\u0435\u0445\u0438, \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u0435
    \u0437\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c (\u0432\u0441\u0435\u0433\u043e
    \u043e\u043a\u043e\u043b\u043e 58 \u043f\u0443\u043d\u043a\u0442\u043e\u0432). \u042d\u0442\u043e\u0442
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442 \u2014 \u043a\u043b\u044e\u0447 \u043a
    \u0435\u0433\u043e \u043f\u0441\u0438\u0445\u043e\u0437\u0443. - \u0421\u0430\u043c\u044b\u0435
    \u0434\u0438\u043a\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f: -
    \u00ab\u0423\u0433\u0440\u043e\u0436\u0430\u043b \u043e\u0442\u0446\u0443 \u0438 \u043c\u0430\u0442\u0435\u0440\u0438
    \u0421\u043c\u0438\u0442\u0443 \u0441\u0436\u0435\u0447\u044c \u0438\u0445 \u0438 \u0434\u043e\u043c
    \u043d\u0430\u0434 \u043d\u0438\u043c\u0438\u00bb (\u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    3 \u043b\u0435\u0442). - \u00ab\u0416\u0435\u043b\u0430\u043b \u0441\u043c\u0435\u0440\u0442\u0438
    \u043c\u0430\u0442\u0435\u0440\u0438, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0430
    \u043f\u0438\u043b\u0430 \u043f\u0438\u0432\u043e\u00bb. - \u00ab\u0411\u0438\u043b \u043c\u043e\u044e
    \u0441\u0435\u0441\u0442\u0440\u0443\u00bb. - \u00ab\u0415\u043b \u044f\u0431\u043b\u043e\u043a\u043e
    \u0432 \u0446\u0435\u0440\u043a\u0432\u0438\u00bb (\u0434\u043b\u044f \u043f\u0443\u0440\u0438\u0442\u0430\u043d\u0438\u043d\u0430
    \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0435
    \u043a\u043e\u0449\u0443\u043d\u0441\u0442\u0432\u043e). - \u041e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u044c
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u043e\u0439: \u041e\u043d \u043d\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0441\u0435\u0431\u044f \u0437\u0430 \u00ab\u043d\u0435\u0447\u0438\u0441\u0442\u044b\u0435
    \u043c\u044b\u0441\u043b\u0438\u00bb \u0438 \u00ab\u043b\u0435\u043d\u044c\u00bb, \u043d\u043e
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b
    \u0442\u0443\u0434\u0430 \u0436\u0435 \u0441\u0432\u043e\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u044f, \u0441\u0447\u0438\u0442\u0430\u044f,
    \u0447\u0442\u043e \u0411\u043e\u0433 \u0434\u0430\u0435\u0442 \u0435\u043c\u0443 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438
    \u0437\u0430 \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435.
    ---\n\n\U0001F441\ufe0f 3. \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u044b
    \u043d\u0430\u0434 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0437\u0440\u0435\u043d\u0438\u0435\u043c
    (\u0421\u0430\u0434\u043e\u043c\u0430\u0437\u043e\u0445\u0438\u0437\u043c \u0440\u0430\u0434\u0438
    \u043d\u0430\u0443\u043a\u0438) \u041d\u044c\u044e\u0442\u043e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b \u0437\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u043e\u0439
    \u2014 \u043e\u043d \u043f\u044b\u0442\u0430\u043b \u0441\u0435\u0431\u044f, \u0447\u0442\u043e\u0431\u044b
    \u043f\u043e\u043d\u044f\u0442\u044c \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e
    \u0433\u043b\u0430\u0437\u0430. \u0415\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0438
    \u043f\u043e \u043e\u043f\u0442\u0438\u043a\u0435 \u0447\u0438\u0442\u0430\u0442\u044c \u0436\u0443\u0442\u043a\u043e.
    - \u0418\u0433\u043b\u0430 \u0411\u043e\u0434\u043a\u0438\u043d\u0430: \u041d\u044c\u044e\u0442\u043e\u043d
    \u0432\u0437\u044f\u043b \u0442\u043e\u043d\u043a\u0443\u044e \u043c\u0435\u0442\u0430\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0438\u0433\u043b\u0443 (\u0431\u043e\u0434\u043a\u0438\u043d) \u0438 \u0437\u0430\u0441\u0443\u043d\u0443\u043b
    \u0435\u0451 \u043c\u0435\u0436\u0434\u0443 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0433\u043b\u0430\u0437\u043d\u044b\u043c \u044f\u0431\u043b\u043e\u043a\u043e\u043c \u0438
    \u043a\u043e\u0441\u0442\u044c\u044e \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b, \u043d\u0430\u0434\u0430\u0432\u043b\u0438\u0432\u0430\u044f
    \u043d\u0430 \u0437\u0430\u0434\u043d\u044e\u044e \u0441\u0442\u0435\u043d\u043a\u0443 \u0433\u043b\u0430\u0437\u0430.
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u0432\u0440\u0430\u0449\u0430\u043b \u0438\u0433\u043b\u0443
    \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u043b, \u043a\u0430\u043a \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f
    \u0446\u0432\u0435\u0442\u043d\u044b\u0435 \u043a\u0440\u0443\u0433\u0438 \u043f\u0435\u0440\u0435\u0434
    \u0433\u043b\u0430\u0437\u0430\u043c\u0438. \u041e\u043d \u0434\u0435\u043b\u0430\u043b
    \u044d\u0442\u043e \u043d\u0435 \u0440\u0430\u0437, \u0430 \u0434\u0435\u0441\u044f\u0442\u043a\u0438
    \u0440\u0430\u0437, \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044f
    \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0449\u0438\u0435 \u0440\u0430\u0434\u0443\u0436\u043d\u044b\u0435
    \u0441\u043f\u0438\u0440\u0430\u043b\u0438. - \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442
    \u0441 \u0441\u043e\u043b\u044f\u0440\u0438\u0435\u043c: \u041e\u043d \u043f\u043e\u0434\u043e\u043b\u0433\u0443
    \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430 \u0421\u043e\u043b\u043d\u0446\u0435
    \u0447\u0435\u0440\u0435\u0437 \u0437\u0435\u0440\u043a\u0430\u043b\u043e, \u0447\u0442\u043e\u0431\u044b
    \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0435
    \u043e\u0431\u0440\u0430\u0437\u044b \u043d\u0430 \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0435,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0436\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0441\u043b\u0435\u043f\u043e\u0442\u0435.
    \u0415\u043c\u0443 \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439, \u0447\u0442\u043e\u0431\u044b
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0437\u0440\u0435\u043d\u0438\u0435,
    \u043d\u043e \u043e\u043d \u043d\u0435 \u0436\u0430\u043b\u0435\u043b \u043e\u0431 \u044d\u0442\u043e\u043c,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u0430\u043d\u043d\u044b\u0435
    \u043e \u043f\u0440\u0438\u0440\u043e\u0434\u0435 \u0446\u0432\u0435\u0442\u043e\u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u044f.
    ---\n\n\U0001F52C 4. \u0410\u043b\u0445\u0438\u043c\u0438\u043a-\u043e\u0442\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b \u0431\u043e\u043b\u044c\u0448\u0435
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0431\u0443\u043c\u0430\u0433\u0438 \u043d\u0430
    \u0430\u043b\u0445\u0438\u043c\u0438\u044e, \u0447\u0435\u043c \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u0443
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0432\u0437\u044f\u0442\u044b\u0435. \u0415\u0433\u043e \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u043f\u043e \u0445\u0438\u043c\u0438\u0438
    \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u043c\u0438\u043b\u043b\u0438\u043e\u043d
    \u0441\u043b\u043e\u0432. - \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439
    \u043a\u0430\u043c\u0435\u043d\u044c: \u041e\u043d \u0438\u0441\u043a\u0430\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u00ab\u041c\u0435\u0440\u043a\u0443\u0440\u0438\u044f \u043c\u0443\u0434\u0440\u0435\u0446\u043e\u0432\u00bb
    \u2014 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u0432\u0438\u043d\u0435\u0446
    \u0432 \u0437\u043e\u043b\u043e\u0442\u043e \u0438 \u0434\u0430\u0440\u0443\u0435\u0442
    \u0431\u0435\u0441\u0441\u043c\u0435\u0440\u0442\u0438\u0435. - \u0421\u043c\u0435\u0440\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u043a\u043e\u043a\u0442\u0435\u0439\u043b\u044c: \u041d\u044c\u044e\u0442\u043e\u043d \u0433\u043b\u043e\u0442\u0430\u043b
    \u0438 \u0432\u0434\u044b\u0445\u0430\u043b \u043f\u0430\u0440\u044b \u0440\u0442\u0443\u0442\u0438,
    \u0441\u0443\u0440\u044c\u043c\u044b \u0438 \u043c\u044b\u0448\u044c\u044f\u043a\u0430.
    \u0412 1970-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0443\u0447\u0435\u043d\u044b\u0435 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u043f\u0440\u044f\u0434\u044c \u0435\u0433\u043e \u0432\u043e\u043b\u043e\u0441 \u0438
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0438 \u0432 \u043d\u0435\u0439 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044e
    \u0440\u0442\u0443\u0442\u0438, \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u044e\u0449\u0443\u044e
    \u043d\u043e\u0440\u043c\u0443 \u0432 15\u201320 \u0440\u0430\u0437! \u042d\u0442\u043e
    \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442 \u0435\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u044b
    \u0431\u0435\u0437\u0443\u043c\u0438\u044f (\u043f\u0430\u0440\u0430\u043d\u043e\u0439\u044f,
    \u043f\u043e\u0442\u0435\u0440\u044f \u043f\u0430\u043c\u044f\u0442\u0438) \u0432 1693 \u0433\u043e\u0434\u0443.
    - \u0428\u0438\u0444\u0440\u044b: \u0411\u043e\u044f\u0441\u044c \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0438
    (\u0437\u0430\u043d\u044f\u0442\u0438\u044f \u0430\u043b\u0445\u0438\u043c\u0438\u0435\u0439
    \u0432 \u0410\u043d\u0433\u043b\u0438\u0438 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0437\u0430\u043a\u043e\u043d\u043e\u043c), \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0440\u0435\u0446\u0435\u043f\u0442\u044b \u043d\u0430 \u043b\u0430\u0442\u044b\u043d\u0438,
    \u0430 \u0438\u043d\u043e\u0433\u0434\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043d\u043d\u044b\u0439 \u0438\u043c \u0430\u043b\u0444\u0430\u0432\u0438\u0442,
    \u0447\u0442\u043e\u0431\u044b \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0435\u043c \u043e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f.
    ---\n\n\U0001F575\ufe0f 5. \u041e\u0445\u043e\u0442\u043d\u0438\u043a \u043d\u0430 \u0444\u0430\u043b\u044c\u0448\u0438\u0432\u043e\u043c\u043e\u043d\u0435\u0442\u0447\u0438\u043a\u043e\u0432:
    \u0421\u0443\u0434\u044c\u044f, \u043f\u0440\u0438\u0441\u044f\u0436\u043d\u044b\u0439 \u0438
    \u043f\u0430\u043b\u0430\u0447 \u0420\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u041c\u043e\u043d\u0435\u0442\u043d\u043e\u043c
    \u0434\u0432\u043e\u0440\u0435 \u2014 \u044d\u0442\u043e \u043d\u0435 \u0441\u043a\u0443\u0447\u043d\u0430\u044f
    \u0431\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u044f. \u042d\u0442\u043e \u0431\u044b\u043b
    \u043a\u0440\u0438\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0431\u043e\u0435\u0432\u0438\u043a
    \u0441 \u0443\u0447\u0430\u0441\u0442\u0438\u0435\u043c \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u0444\u0438\u0437\u0438\u043a\u0430. - \u041e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430: \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u0435\u0440\u0435\u043e\u0434\u0435\u0432\u0430\u043b\u0441\u044f
    \u0432 \u043f\u0440\u043e\u0441\u0442\u0443\u044e \u043e\u0434\u0435\u0436\u0434\u0443 \u0438
    \u043b\u0438\u0447\u043d\u043e \u0445\u043e\u0434\u0438\u043b \u043f\u043e \u043b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u0438\u043c
    \u0442\u0430\u0432\u0435\u0440\u043d\u0430\u043c \u0438 \u0442\u0440\u0443\u0449\u043e\u0431\u0430\u043c,
    \u0432\u044b\u0434\u0430\u0432\u0430\u044f \u0441\u0435\u0431\u044f \u0437\u0430 \u043f\u044c\u044f\u043d\u043e\u0433\u043e
    \u0438\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0433\u043e \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0430,
    \u0447\u0442\u043e\u0431\u044b \u043a\u0443\u043f\u0438\u0442\u044c \u043f\u043e\u0434\u0434\u0435\u043b\u044c\u043d\u044b\u0435
    \u043c\u043e\u043d\u0435\u0442\u044b \u0438 \u0432\u044b\u0439\u0442\u0438 \u043d\u0430
    \u0441\u043b\u0435\u0434 \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u043e\u0432.
    - \u041a\u0430\u0437\u043d\u044c \u0427\u0430\u043b\u043e\u043d\u043e\u0440\u0430: \u0421\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0444\u0430\u043b\u044c\u0448\u0438\u0432\u043e\u043c\u043e\u043d\u0435\u0442\u0447\u0438\u043a
    \u0410\u043d\u0433\u043b\u0438\u0438, \u0423\u0438\u043b\u044c\u044f\u043c \u0427\u0430\u043b\u043e\u043d\u043e\u0440,
    \u0431\u044b\u043b \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u043c \u0438 \u043d\u0430\u0433\u043b\u044b\u043c.
    \u041e\u043d \u0431\u0440\u043e\u0441\u0438\u043b \u0432\u044b\u0437\u043e\u0432 \u041d\u044c\u044e\u0442\u043e\u043d\u0443
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e. \u041d\u044c\u044e\u0442\u043e\u043d 2 \u0433\u043e\u0434\u0430
    \u0441\u043e\u0431\u0438\u0440\u0430\u043b \u043d\u0430 \u043d\u0435\u0433\u043e \u0434\u043e\u0441\u044c\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u043b\u0438\u0447\u043d\u043e \u0441\u0442\u0440\u043e\u0438\u043b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0432
    \u0441\u0443\u0434\u0435. \u0427\u0430\u043b\u043e\u043d\u043e\u0440\u0430 \u043f\u043e\u0432\u0435\u0441\u0438\u043b\u0438,
    \u043d\u043e \u041d\u044c\u044e\u0442\u043e\u043d \u0434\u043e\u0431\u0438\u043b\u0441\u044f,
    \u0447\u0442\u043e\u0431\u044b \u043f\u0435\u0440\u0435\u0434 \u043a\u0430\u0437\u043d\u044c\u044e
    \u0435\u0433\u043e \u043f\u0440\u043e\u0432\u0435\u0437\u043b\u0438 \u043f\u043e \u0433\u043e\u0440\u043e\u0434\u0443
    \u0432 \u0442\u0435\u043b\u0435\u0436\u043a\u0435 \u0441 \u043f\u0435\u0442\u043b\u0435\u0439
    \u043d\u0430 \u0448\u0435\u0435 \u0438 \u043f\u044b\u0442\u0430\u043b\u0438 (\u044d\u0442\u043e
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u043e\u0441\u044c \u00ab\u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u043e\u043c
    \u0437\u0430 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0438\u0437\u043c\u0435\u043d\u0443\u00bb). - \u041c\u0435\u0442\u043e\u0434\u044b \u0434\u043e\u043f\u0440\u043e\u0441\u0430:
    \u041d\u044c\u044e\u0442\u043e\u043d \u0437\u0430\u043f\u0443\u0433\u0438\u0432\u0430\u043b
    \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u043e\u0432, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f,
    \u0447\u0442\u043e \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e\u00bb \u0432 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u0432\u0435\u0441\u0430 \u0440\u0430\u0441\u043f\u043b\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0441\u0435\u0440\u0435\u0431\u0440\u0430, \u0438 \u043b\u044e\u0431\u043e\u0439 \u043e\u0431\u043c\u0430\u043d
    \u043e\u043d \u0440\u0430\u0441\u043a\u0440\u043e\u0435\u0442 \u0434\u043e \u0434\u043e\u043b\u0435\u0439
    \u0433\u0440\u0430\u043c\u043c\u0430. ---\n\n\U0001F4CF 6. \u0413\u0440\u0430\u0444\u043e\u043c\u0430\u043d
    \u0438 \u044d\u0433\u043e\u0438\u0441\u0442: \u041a\u0440\u0438\u0432\u043e\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u043e
    \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u0438 - \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb
    \u2014 \u0445\u0438\u0442\u0440\u043e\u0441\u0442\u044c \u0441 \u043c\u0430\u0441\u0441\u043e\u0439:
    \u0412 \u0441\u0432\u043e\u0438\u0445 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445
    \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0447\u0430\u043b\u0430\u0445\u00bb \u041d\u044c\u044e\u0442\u043e\u043d \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0432\u0441\u0435 \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0441\u0442\u0438\u043b\u0435 (\u043a\u0430\u043a \u0434\u0440\u0435\u0432\u043d\u0438\u0435
    \u0433\u0440\u0435\u043a\u0438), \u0445\u043e\u0442\u044f \u0441\u0430\u043c \u0434\u043b\u044f
    \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u043c\u0435\u0442\u043e\u0434 \u0444\u043b\u044e\u043a\u0441\u0438\u0439
    (\u0430\u043d\u0430\u043b\u0438\u0437). \u0417\u0430\u0447\u0435\u043c? \u0427\u0442\u043e\u0431\u044b
    \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043f\u043e\u043d\u044f\u043b, \u043a\u0430\u043a
    \u043e\u043d \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443.
    \u041e\u043d \u043f\u0438\u0441\u0430\u043b: \u00ab\u0427\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c
    \u043f\u0440\u0438\u0434\u0438\u0440\u043e\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u044f \u0438\u0437\u043b\u043e\u0436\u0443 \u0432\u0441\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u00bb,
    \u043d\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u043e\u043d
    \u0445\u043e\u0442\u0435\u043b, \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u044b
    \u043d\u0435 \u0443\u043a\u0440\u0430\u043b\u0438 \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434.
    - \u0414\u043b\u0438\u043d\u043d\u044b\u0439 \u043d\u043e\u0441 \u0438 \u043e\u0431\u0438\u0434\u044b:
    \u041d\u044c\u044e\u0442\u043e\u043d \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043e\u0431\u0438\u0434\u0447\u0438\u0432. \u041e\u043d \u043c\u043e\u0433 \u0433\u043e\u0434\u0430\u043c\u0438
    \u043d\u0435 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c
    \u0441 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0441\u043c\u0435\u043b \u0443\u0441\u043e\u043c\u043d\u0438\u0442\u044c\u0441\u044f
    \u0432 \u0435\u0433\u043e \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445. \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0413\u0443\u043a\u0430 (\u0441\u0432\u043e\u0435\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0432\u0440\u0430\u0433\u0430) \u041d\u044c\u044e\u0442\u043e\u043d
    \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043b \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442\u044c
    \u0435\u0433\u043e \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u0432 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435. \u0414\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u043c\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u043c, \u043a\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0435\u043b
    \u0420\u043e\u0431\u0435\u0440\u0442 \u0413\u0443\u043a \u2014 \u044d\u0442\u043e \u043c\u0435\u0441\u0442\u044c,
    \u043f\u0440\u043e\u0434\u043b\u0438\u0432\u0448\u0430\u044f\u0441\u044f \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f.
    ---\n\n\U0001F37A 7. \u0411\u044b\u0442\u043e\u0432\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u0438
    - \u0411\u0435\u0437\u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0435 \u043a \u0435\u0434\u0435:
    \u0420\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0441\u0442\u044c \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u0432\u043e\u0448\u043b\u0430 \u0432 \u043b\u0435\u0433\u0435\u043d\u0434\u044b. \u041e\u0434\u043d\u0430\u0436\u0434\u044b,
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u044f\u044f \u043d\u0430\u0434 \u0437\u0430\u0434\u0430\u0447\u0435\u0439,
    \u043e\u043d \u0441\u0432\u0430\u0440\u0438\u043b \u043a\u0430\u0440\u043c\u0430\u043d\u043d\u044b\u0435
    \u0447\u0430\u0441\u044b \u0432\u043c\u0435\u0441\u0442\u043e \u044f\u0439\u0446\u0430,
    \u0434\u0435\u0440\u0436\u0430 \u0438\u0445 \u0432 \u043a\u0438\u043f\u044f\u0449\u0435\u0439
    \u0432\u043e\u0434\u0435 \u0438 \u0441 \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435\u043c
    \u0433\u043b\u044f\u0434\u044f \u043d\u0430 \u00ab\u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0435
    \u044f\u0439\u0446\u043e\u00bb. \u0412 \u0434\u0440\u0443\u0433\u043e\u0439 \u0440\u0430\u0437,
    \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u043f\u043e\u0437\u0432\u0430\u043b\u0438
    \u043e\u0431\u0435\u0434\u0430\u0442\u044c, \u043e\u043d \u0432\u044b\u0448\u0435\u043b
    \u0438\u0437 \u043a\u043e\u043c\u043d\u0430\u0442\u044b, \u043d\u043e, \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u044b\u0439
    \u043c\u044b\u0441\u043b\u044c\u044e, \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0438, \u043d\u0435 \u0434\u043e\u0439\u0434\u044f \u0434\u043e \u0441\u0442\u043e\u043b\u043e\u0432\u043e\u0439,
    \u0441\u0435\u043b \u0437\u0430 \u0440\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b,
    \u0437\u0430\u0431\u044b\u0432 \u043f\u043e\u0435\u0441\u0442\u044c. - \u041f\u0443\u0441\u0442\u043e\u0439
    \u043b\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0437\u0430\u043b: \u0421\u0442\u0430\u0432
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c, \u041d\u044c\u044e\u0442\u043e\u043d
    \u0447\u0430\u0441\u0442\u043e \u0447\u0438\u0442\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u043f\u0435\u0440\u0435\u0434 \u043f\u0443\u0441\u0442\u044b\u043c\u0438 \u0441\u043a\u0430\u043c\u044c\u044f\u043c\u0438.
    \u0421\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u043b\u0438
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0438 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0438 \u0445\u043e\u0434\u0438\u0442\u044c.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0443\u0441\u0442\u0430\u0432\u0443, \u043e\u043d
    \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b \u0447\u0438\u0442\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u044e \u0445\u043e\u0442\u044f \u0431\u044b \u0440\u0430\u0437
    \u0432 \u043d\u0435\u0434\u0435\u043b\u044e, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u043e\u043d \u0432\u0445\u043e\u0434\u0438\u043b \u0432 \u043f\u0443\u0441\u0442\u0443\u044e
    \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044e, \u043e\u0431\u0440\u0430\u0449\u0430\u043b\u0441\u044f
    \u043a \u0441\u0442\u0435\u043d\u0430\u043c \u0438 \u0443\u0445\u043e\u0434\u0438\u043b.
    \u042d\u0442\u043e \u0435\u0433\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e
    \u043d\u0435 \u0441\u043c\u0443\u0449\u0430\u043b\u043e. ---\n\n\U0001F52E 8. \u0422\u0435\u043e\u043b\u043e\u0433-\u0435\u0440\u0435\u0442\u0438\u043a
    \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u043a\u043e\u043d\u0446\u0430
    \u0441\u0432\u0435\u0442\u0430 \u041d\u044c\u044e\u0442\u043e\u043d \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u043c, \u043d\u043e \u0435\u0433\u043e \u0432\u0435\u0440\u0430
    \u0431\u044b\u043b\u0430 \u0435\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439.
    - \u0410\u043d\u0442\u0438\u0442\u0440\u0438\u043d\u0438\u0442\u0430\u0440\u0438\u0439:
    \u041e\u043d \u043e\u0442\u0440\u0438\u0446\u0430\u043b \u0434\u043e\u0433\u043c\u0430\u0442
    \u043e \u0421\u0432\u044f\u0442\u043e\u0439 \u0422\u0440\u043e\u0438\u0446\u0435, \u0441\u0447\u0438\u0442\u0430\u044f,
    \u0447\u0442\u043e \u044d\u0442\u043e \u043f\u043e\u0437\u0434\u043d\u0435\u0439\u0448\u0430\u044f
    \u0432\u044b\u0434\u0443\u043c\u043a\u0430 \u0440\u0438\u043c\u0441\u043a\u0438\u0445 \u043f\u0430\u043f.
    \u041e\u043d \u0442\u0430\u0439\u043d\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0442\u0440\u0443\u0434,
    \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439, \u0447\u0442\u043e
    \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0411\u0438\u0431\u043b\u0438\u0438
    \u043d\u0435\u0442 \u0441\u043b\u043e\u0432\u0430 \u00ab\u0422\u0440\u043e\u0438\u0446\u0430\u00bb.
    \u041f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f \u044d\u0442\u0438\u0445 \u0442\u0440\u0443\u0434\u043e\u0432
    \u0431\u044b\u043b\u0430 \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u0430 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f.
    - \u0420\u0430\u0441\u0447\u0435\u0442\u044b \u0410\u043f\u043e\u043a\u0430\u043b\u0438\u043f\u0441\u0438\u0441\u0430:
    \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u0433\u043e\u0434\u044b
    \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0435 \u041a\u043d\u0438\u0433\u0438
    \u043f\u0440\u043e\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0438\u0438\u043b\u0430 \u0438
    \u041e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u044f \u0418\u043e\u0430\u043d\u043d\u0430
    \u0411\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0430. \u041e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b,
    \u0447\u0442\u043e \u043a\u043e\u043d\u0435\u0446 \u0441\u0432\u0435\u0442\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u0442
    \u043d\u0435 \u0440\u0430\u043d\u0435\u0435 2060 \u0433\u043e\u0434\u0430. \u041e\u043d
    \u043f\u0438\u0441\u0430\u043b: \u00ab\u042f \u0433\u043e\u0432\u043e\u0440\u044e \u044d\u0442\u043e
    \u043d\u0435 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0432\u0440\u0435\u043c\u044f,
    \u0430 \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c
    \u043b\u0436\u0438\u0432\u044b\u0435 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u044f
    \u0444\u0430\u043d\u0430\u0442\u0438\u043a\u043e\u0432\u00bb. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0432\u044b\u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c\u0441\u043a\u0438\u0439
    \u0445\u0440\u0430\u043c \u0432 \u0434\u0440\u0435\u0432\u043d\u043e\u0441\u0442\u0438 \u0438\u043c\u0435\u043b
    \u0442\u043e\u0447\u043d\u044b\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043a\u043e\u0434\u0438\u0440\u0443\u044e\u0442 \u0437\u0430\u043a\u043e\u043d\u044b \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439.
    ---\n\n\U0001F3AD 9. \u041d\u044c\u044e\u0442\u043e\u043d \u043f\u0440\u043e\u0442\u0438\u0432
    \u043c\u043e\u0440\u044f\u043a\u043e\u0432 \u0438 \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb
    \u043a\u0430\u043a \u044f\u0434 \u041f\u043e\u0441\u043b\u0435 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438
    \u00ab\u041d\u0430\u0447\u0430\u043b\u00bb \u0432\u0441\u0435 \u0434\u0443\u043c\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043a\u043d\u0438\u0433\u0430 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e
    \u043f\u043e\u043c\u043e\u0433\u043b\u0430 \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u0442\u0435\u043b\u044f\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0441\u0430\u043c \u041d\u044c\u044e\u0442\u043e\u043d
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043e\u043b\u044c\u0437\u0435 \u043f\u0440\u043e\u0445\u043b\u0430\u0434\u043d\u043e.
    - \u0421\u043b\u0443\u0447\u0430\u0439 \u0441 \u0413\u0430\u043b\u043b\u0435\u0435\u043c:
    \u041a\u043e\u0433\u0434\u0430 \u042d\u0434\u043c\u0443\u043d\u0434 \u0413\u0430\u043b\u043b\u0435\u0439
    \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u041d\u044c\u044e\u0442\u043e\u043d\u0430, \u043a\u0430\u043a
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u044b \u0434\u043e\u043b\u0436\u043d\u044b
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438,
    \u041d\u044c\u044e\u0442\u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u0441 \u043f\u0440\u0435\u0437\u0440\u0435\u043d\u0438\u0435\u043c:
    \u00ab\u042f \u0441\u043e\u0437\u0434\u0430\u044e \u0443\u0447\u0435\u043d\u0438\u044f \u0434\u043b\u044f
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432, \u0430 \u043d\u0435 \u0434\u043b\u044f
    \u043c\u043e\u0440\u044f\u043a\u043e\u0432\u00bb. \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u0443\u044e \u043d\u0430\u0443\u043a\u0443
    \u043d\u0438\u0436\u0435 \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u0430.
    ---\n\n\U0001FAA6 10. \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0439
    \u043a\u0443\u0440\u044c\u0435\u0437 - \u041d\u0435\u043f\u0440\u0438\u043d\u044f\u0442\u0438\u0435
    \u043f\u0440\u0438\u0447\u0430\u0441\u0442\u0438\u044f: \u0423\u043c\u0438\u0440\u0430\u044f
    \u0432 \u043c\u0430\u0440\u0442\u0435 1727 \u0433\u043e\u0434\u0430, \u041d\u044c\u044e\u0442\u043e\u043d
    \u043d\u0430\u043e\u0442\u0440\u0435\u0437 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0441\u043e\u0431\u043e\u0440\u043e\u0432\u0430\u043d\u0438\u044f (\u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e
    \u043f\u0440\u0438\u0447\u0430\u0441\u0442\u0438\u044f). \u0421\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a
    \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b, \u043d\u043e \u041d\u044c\u044e\u0442\u043e\u043d
    \u043e\u0442\u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u043a \u0441\u0442\u0435\u043d\u0435.
    \u0414\u043b\u044f \u0432\u0438\u043a\u0442\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0439
    \u0410\u043d\u0433\u043b\u0438\u0438 \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044c\u043d\u043e, \u0447\u0442\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u044b
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0438
    \u044d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442. - \u0413\u0434\u0435 \u0435\u0433\u043e
    \u043c\u043e\u0437\u0433?: \u0412\u0441\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u043e,
