  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0411\u043b\u0435\u0437\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u2014 \u044d\u0442\u043e
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0432\u0441\u0435\u0433\u043e \u0437\u0430
    \u0434\u0432\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f \u043c\u043e\u0436\u043d\u043e
    \u0437\u0430\u043b\u043e\u0436\u0438\u0442\u044c \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u0440\u0430\u0437\u0443
    \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434 \u043f\u0440\u043e\u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0441\u044f
    \u043e\u0442 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0434\u043e \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438
    \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0442\u0435\u0445\u043d\u0438\u043a\u0438.\n\n\U0001F9EE \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430:
    \u041e\u0442 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0434\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442
    \u043a\u0430\u043a \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u0442\u0430\u043a \u0438 \u043d\u043e\u0432\u0443\u044e
    \u0434\u043b\u044f \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u044c
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f (\u041f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f): \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    16 \u043b\u0435\u0442 \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \"\u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0448\u0435\u0441\u0442\u0438\u0432\u0435\u0440\u0448\u0438\u043d\u043d\u0438\u043a\u0435\".
    \u0421\u0443\u0442\u044c \u0435\u0435 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0443
    \u043b\u044e\u0431\u043e\u0433\u043e \u0448\u0435\u0441\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430,
    \u0432\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e \u0432 \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0441\u0435\u0447\u0435\u043d\u0438\u0435 (\u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u044c,
    \u044d\u043b\u043b\u0438\u043f\u0441, \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u0443 \u0438\u043b\u0438
    \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u0443), \u0442\u043e\u0447\u043a\u0438
    \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u044f \u0442\u0440\u0435\u0445
    \u043f\u0430\u0440 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u044b\u0445
    \u0441\u0442\u043e\u0440\u043e\u043d \u043b\u0435\u0436\u0430\u0442 \u043d\u0430 \u043e\u0434\u043d\u043e\u0439
    \u043f\u0440\u044f\u043c\u043e\u0439. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430,
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0432 \"\u041e\u043f\u044b\u0442\u0435
    \u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u0445\",
    \u0441\u0442\u0430\u043b\u0430 \u043c\u043e\u0449\u043d\u044b\u043c \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435\u043c
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u041f\u0430\u043f\u043f\u0430 \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430
    \u043e\u0441\u043d\u043e\u0432\u044b \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0422\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u0438 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0430:
    \u0425\u043e\u0442\u044f \u044d\u0442\u0430 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u0431\u044b\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u0438 \u0434\u043e \u043d\u0435\u0433\u043e \u0432 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430\u0445, \u0438\u043c\u0435\u043d\u043d\u043e
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0432 \u0441\u0432\u043e\u0435\u043c \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442\u0435
    \u043e\u0431 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0435\" (1654) \u0432\u0441\u0435\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0435\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430. \u042d\u0442\u043e\u0442
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440 \u043d\u043e\u0441\u0438\u0442 \u0435\u0433\u043e \u0438\u043c\u044f.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439:
    \u0412 \u0445\u043e\u0434\u0435 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438 \u0441
    \u041f\u044c\u0435\u0440\u043e\u043c \u0424\u0435\u0440\u043c\u0430 \u0432 1654 \u0433\u043e\u0434\u0443
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0440\u0435\u0448\u0438\u043b \"\u0437\u0430\u0434\u0430\u0447\u0443
    \u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0441\u0442\u0430\u0432\u043e\u043a\",
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u043d\u043e\u0435 \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u043c \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u0435
    \u2014 \"\u0441\u0442\u0430\u0432\u043a\u0435 \u041f\u0430\u0441\u043a\u0430\u043b\u044f\".\n\n\u2699\ufe0f
    \u0424\u0438\u0437\u0438\u043a\u0430 \u0438 \u0433\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0430:
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0437\u0430\u043a\u043e\u043d\u044b \u0412\u043a\u043b\u0430\u0434 \u041f\u0430\u0441\u043a\u0430\u043b\u044f
    \u0432 \u0444\u0438\u0437\u0438\u043a\u0443 \u0431\u044b\u043b \u043d\u0435 \u043c\u0435\u043d\u0435\u0435
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043d
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c\u0438 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043c\u0438.
    \u0417\u0430\u043a\u043e\u043d \u041f\u0430\u0441\u043a\u0430\u043b\u044f (\u0413\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0430):
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0444\u0438\u0437\u0438\u043a\u0443 \u2014 \u044d\u0442\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0437\u0430\u043a\u043e\u043d\u0430, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u043c\u043e\u0435
    \u043d\u0430 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c \u0438\u043b\u0438 \u0433\u0430\u0437,
    \u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044f \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f
    \u0432 \u043a\u0430\u0436\u0434\u0443\u044e \u0442\u043e\u0447\u043a\u0443 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438
    \u0438\u043b\u0438 \u0433\u0430\u0437\u0430. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0430\u0448\u0438\u043d, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u0440\u0435\u0441\u0441, \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d \u0441\u0430\u043c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u043e\u043f\u0438\u0441\u0430\u043b. \u041e\u043f\u044b\u0442 \u043d\u0430 \u0433\u043e\u0440\u0435
    \u041f\u044e\u0438-\u0434\u0435-\u0414\u043e\u043c: \u0412 1648 \u0433\u043e\u0434\u0443
    \u043f\u043e \u0438\u0434\u0435\u0435 \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u0435\u0433\u043e
    \u0437\u044f\u0442\u044c \u0424\u043b\u043e\u0440\u0430\u043d \u041f\u0435\u0440\u044c\u0435
    \u043f\u0440\u043e\u0432\u0435\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442: \u0438\u0437\u043c\u0435\u0440\u0438\u043b
    \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0440\u0442\u0443\u0442\u0438 \u0432 \u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440\u0435
    \u0443 \u043f\u043e\u0434\u043d\u043e\u0436\u0438\u044f \u0438 \u043d\u0430 \u0432\u0435\u0440\u0448\u0438\u043d\u0435
    \u0433\u043e\u0440\u044b \u041f\u044e\u0438-\u0434\u0435-\u0414\u043e\u043c. \u041f\u0430\u0434\u0435\u043d\u0438\u0435
    \u0443\u0440\u043e\u0432\u043d\u044f \u0440\u0442\u0443\u0442\u0438 \u043d\u0430 \u0432\u0435\u0440\u0448\u0438\u043d\u0435
    \u0441\u0442\u0430\u043b\u043e \u043d\u0435\u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0436\u0438\u043c\u044b\u043c
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0433\u043e
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043b\u043e
    \u0443\u0447\u0435\u043d\u0438\u0435 \u043e \"\u0431\u043e\u044f\u0437\u043d\u0438 \u043f\u0443\u0441\u0442\u043e\u0442\u044b\".
    \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0438
    \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439\" \u0438 \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u043e \u0432\u0435\u0441\u0435 \u0432\u043e\u0437\u0434\u0443\u0445\u0430\": \u0412 \u044d\u0442\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442\u0430\u0445, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0438 \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b
    \u0441\u0432\u043e\u0438\u0445 \u043e\u043f\u044b\u0442\u043e\u0432, \u0434\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u0432\u043e\u0437\u0434\u0443\u0445 \u0438\u043c\u0435\u0435\u0442 \u0432\u0435\u0441
    \u0438 \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u0435\u0442\u0441\u044f \u0442\u0435\u043c
    \u0436\u0435 \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0433\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438,
    \u0447\u0442\u043e \u0438 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438.\n\n\U0001F4BB
    \u0422\u0435\u0445\u043d\u0438\u043a\u0430 \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f
    \u0421\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435 \u043a \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044e \u0437\u043d\u0430\u043d\u0438\u0439
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u043a
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437
    \u043f\u0435\u0440\u0432\u044b\u0445 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \"\u041f\u0430\u0441\u043a\u0430\u043b\u0438\u043d\u0430\"
    (\u0421\u0447\u0435\u0442\u043d\u0430\u044f \u043c\u0430\u0448\u0438\u043d\u0430): \u0412
    1642 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19
    \u043b\u0435\u0442, \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043d\u0430\u0447\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430\u0434 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c
    \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0447\u0435\u0442\u043d\u043e\u0439
    \u043c\u0430\u0448\u0438\u043d\u044b, \u0447\u0442\u043e\u0431\u044b \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c
    \u0441\u0432\u043e\u0435\u043c\u0443 \u043e\u0442\u0446\u0443, \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u043e\u043c\u0443
    \u0441\u0431\u043e\u0440\u0449\u0438\u043a\u0443, \u0443\u0442\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0440\u0430\u0441\u0447\u0435\u0442\u044b. \u0412 \u043e\u0441\u043d\u043e\u0432\u0435
    \"\u041f\u0430\u0441\u043a\u0430\u043b\u0438\u043d\u044b\" \u043b\u0435\u0436\u0430\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u043a\u043e\u043b\u0435\u0441: \u043f\u0440\u0438 \u043f\u043e\u043b\u043d\u043e\u043c
    \u043e\u0431\u043e\u0440\u043e\u0442\u0435 \u043a\u043e\u043b\u0435\u0441\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0441 9 \u0434\u043e 0), \u043e\u043d\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043b\u043e \u0435\u0434\u0438\u043d\u0438\u0446\u0443
    \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0440\u0430\u0437\u0440\u044f\u0434.
    \u0425\u043e\u0442\u044f \u0438\u0437-\u0437\u0430 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u0438
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e
    \u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f,
    \u0437\u0430\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0439 \u0432 \u043d\u0435\u0433\u043e
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0430
    \u0440\u0430\u0437\u0440\u044f\u0434\u043e\u0432 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f
    \u0432 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0435 \u0430\u0440\u0438\u0444\u043c\u043e\u043c\u0435\u0442\u0440\u043e\u0432
    \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e XX \u0432\u0435\u043a\u0430.\n\n\u270d\ufe0f
    \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u0431\u044b\u043b\u0438 \u0438\u0437\u0434\u0430\u043d\u044b
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e, \u043e\u043d\u0438 \u0441\u0442\u0430\u043b\u0438
    \u043a\u043b\u0430\u0441\u0441\u0438\u043a\u043e\u0439 \u043a\u0430\u043a \u043d\u0430\u0443\u0447\u043d\u043e\u0439,
    \u0442\u0430\u043a \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0439
    \u043c\u044b\u0441\u043b\u0438. | \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0442\u0440\u0443\u0434\u0430
    | \u0413\u043e\u0434 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f/\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438
    | \u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    | |:--- |:--- |:--- | | \"\u041e\u043f\u044b\u0442 \u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u0445\" | 1640 | \u0420\u0430\u0431\u043e\u0442\u0430,
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0430\u044f
    \u0432 16 \u043b\u0435\u0442. | | \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e\u0431
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0435\"
    | 1654 | \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f
    \u0438 \u0435\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0432
    \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0435. | | \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442
    \u043e \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0438 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439\"
    \u0438 \"\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e \u0432\u0435\u0441\u0435 \u0432\u043e\u0437\u0434\u0443\u0445\u0430\"
    | 1663 (\u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e) | \u0420\u0430\u0431\u043e\u0442\u044b,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0437\u043b\u043e\u0436\u0435\u043d
    \u0437\u0430\u043a\u043e\u043d \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043e
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0433\u043e
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f. |"
  achievementsEn: 
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u0411\u043b\u0435\u0437\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0433\u043e
    \u0432\u0437\u043b\u0435\u0442\u0430, \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439
    \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u0445\u0440\u0443\u043f\u043a\u0438\u043c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c
    \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0433\u043e \u0434\u0443\u0445\u043e\u0432\u043d\u043e\u0433\u043e
    \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u043e\u0442\u0430. \u0415\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430
    \u0441 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439
    \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0441 \u0431\u043b\u0438\u0437\u043a\u0438\u043c\u0438,
    \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0439.\n\n\U0001F476
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0441\u0435\u043c\u044c\u044f \u0438
    \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0432 \u041e\u0432\u0435\u0440\u043d\u0438 \u0411\u043b\u0435\u0437
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0440\u043e\u0434\u0438\u043b\u0441\u044f 19
    \u0438\u044e\u043d\u044f 1623 \u0433\u043e\u0434\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u041a\u043b\u0435\u0440\u043c\u043e\u043d-\u0424\u0435\u0440\u0440\u0430\u043d \u043d\u0430
    \u044e\u0433\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u041e\u043d \u0431\u044b\u043b
    \u0442\u0440\u0435\u0442\u044c\u0438\u043c \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u042d\u0442\u044c\u0435\u043d\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f,
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0441\u0443\u0434\u044c\u0438
    \u0438 \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u043e\u0433\u043e \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u0430,
    \u0438 \u0410\u043d\u0442\u0443\u0430\u043d\u0435\u0442\u0442\u044b \u0411\u0435\u0433\u043e\u043d.
    \u0421\u0435\u043c\u044c\u044f \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b\u0430
    \u043a \"\u0434\u0432\u043e\u0440\u044f\u043d\u0441\u0442\u0432\u0443 \u043c\u0430\u043d\u0442\u0438\u0438\"
    \u2014 \u0441\u043b\u043e\u044e \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0443\u043f\u0430\u043b\u0438
    \u0441\u0432\u043e\u0438 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043b\u0438
    \u0438\u0445 \u043f\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0443.
    \u0421\u0435\u043c\u044c\u044f \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u0439 \u0431\u044b\u043b\u0430
    \u043e\u0447\u0435\u043d\u044c \u0434\u0440\u0443\u0436\u043d\u043e\u0439. \u0423 \u0411\u043b\u0435\u0437\u0430
    \u0431\u044b\u043b\u043e \u0434\u0432\u0435 \u0441\u0435\u0441\u0442\u0440\u044b: \u0441\u0442\u0430\u0440\u0448\u0430\u044f
    \u0416\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430 (\u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0432 1620 \u0433\u043e\u0434\u0443) \u0438 \u043c\u043b\u0430\u0434\u0448\u0430\u044f
    \u0416\u0430\u043a\u043b\u0438\u043d (\u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u0432
    1625 \u0433\u043e\u0434\u0443), \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438
    \u043e\u043d \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b
    \u0441\u0430\u043c\u044b\u0435 \u0442\u0435\u043f\u043b\u044b\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f.
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c, \u0410\u043d\u0442\u0443\u0430\u043d\u0435\u0442\u0442\u0430,
    \u0431\u044b\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0441\u0432\u043e\u0435\u0439
    \u043a\u0440\u043e\u0442\u043e\u0441\u0442\u044c\u044e \u0438 \u043d\u0430\u0431\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e,
    \u043d\u043e \u043e\u043d\u0430 \u0443\u043c\u0435\u0440\u043b\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0411\u043b\u0435\u0437\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e \u0442\u0440\u0438
    \u0433\u043e\u0434\u0430. \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438
    \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435 \u0434\u0435\u0442\u0435\u0439
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043b\u0435\u0433\u043b\u043e \u043d\u0430
    \u043f\u043b\u0435\u0447\u0438 \u043e\u0442\u0446\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0442\u0430\u043a \u0438 \u043d\u0435 \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e.
    \u0421\u0430\u043c \u0411\u043b\u0435\u0437 \u0441 \u0440\u0430\u043d\u043d\u0435\u0433\u043e
    \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c
    \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u043c. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0434\u0430\u0436\u0435 \u043b\u0435\u0433\u0435\u043d\u0434\u0430, \u0447\u0442\u043e
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u0432\u0443\u0445 \u043b\u0435\u0442
    \u043e\u043d \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u043b,
    \u0438 \u0435\u0433\u043e \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0432\u044f\u0437\u0430\u043b\u0438 \u0441 \"\u0440\u0430\u0441\u043a\u0430\u044f\u043d\u0438\u0435\u043c\"
    \u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0436\u0435\u043d\u0449\u0438\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u0431\u0432\u0438\u043d\u044f\u043b\u0438 \u0432 \u0441\u0433\u043b\u0430\u0437\u0435.
    \u0412\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b
    \u043e\u0442 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0433\u043e\u043b\u043e\u0432\u043d\u044b\u0445
    \u0431\u043e\u043b\u0435\u0439 \u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0441
    \u043f\u0438\u0449\u0435\u0432\u0430\u0440\u0435\u043d\u0438\u0435\u043c \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438
    \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435\u0439 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F4DA
    \u0423\u0447\u0451\u0431\u0430: \u0424\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \"\u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0439\" \u0442\u0430\u043b\u0430\u043d\u0442
    \u042d\u0442\u044c\u0435\u043d \u041f\u0430\u0441\u043a\u0430\u043b\u044c, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0441\u0430\u043c \u0443\u0432\u0430\u0436\u0430\u0435\u043c\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0440\u0435\u0448\u0438\u043b \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c
    \u0441\u0435\u0431\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044e
    \u0434\u0435\u0442\u0435\u0439. \u041f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e,
    \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0434\u0440\u0435\u0432\u043d\u0438\u0435 \u044f\u0437\u044b\u043a\u0438
    (\u043b\u0430\u0442\u044b\u043d\u044c \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439),
    \u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u2014 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043d\u0430\u0443\u043a\u0430
    \u2014 \u0431\u044b\u043b\u0430 \u043f\u043e\u0434 \u0441\u0442\u0440\u043e\u0433\u0438\u043c
    \u0437\u0430\u043f\u0440\u0435\u0442\u043e\u043c \u0434\u043e 15 \u043b\u0435\u0442. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043a\u0430\u043a \u044d\u0442\u043e \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u0432\u0430\u0435\u0442
    \u0441 \u0433\u0435\u043d\u0438\u044f\u043c\u0438, \u0437\u0430\u043f\u0440\u0435\u0442
    \u043b\u0438\u0448\u044c \u0440\u0430\u0437\u0436\u0435\u0433 \u0438\u043d\u0442\u0435\u0440\u0435\u0441.
    \u0421\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \"\u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\" \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438:
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 12 \u043b\u0435\u0442 \u0411\u043b\u0435\u0437,
    \u043d\u0435 \u0437\u043d\u0430\u044f \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0439 \u0444\u0438\u0433\u0443\u0440,
    \u043d\u0430\u0447\u0430\u043b \u0440\u0438\u0441\u043e\u0432\u0430\u0442\u044c \u0443\u0433\u043b\u0435\u043c
    \u043d\u0430 \u043f\u043e\u043b\u0443 \u0438 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b 32-\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u043e \u0441\u0443\u043c\u043c\u0435 \u0443\u0433\u043b\u043e\u0432
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439
    \u043e\u0442\u0435\u0446 \u0442\u0443\u0442 \u0436\u0435 \u0441\u043d\u044f\u043b \u0437\u0430\u043f\u0440\u0435\u0442
    \u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043b \u0441\u044b\u043d\u0443 \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u044b.
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0441\u0440\u0435\u0434\u0430: \u042d\u0442\u044c\u0435\u043d
    \u0432\u0432\u0435\u043b \u0441\u044b\u043d\u0430 \u0432 \u043a\u0440\u0443\u0436\u043e\u043a
    \u041c\u0430\u0440\u0435\u043d\u0430 \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0430 \u2014
    \u044d\u043b\u0438\u0442\u043d\u044b\u0439 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u043a\u043b\u0443\u0431, \u0433\u0434\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0438\u0441\u044c
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435 \u0443\u043c\u044b \u0415\u0432\u0440\u043e\u043f\u044b
    (\u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u044c, \u0414\u0435\u0437\u0430\u0440\u0433,
    \u0413\u0430\u0441\u0441\u0435\u043d\u0434\u0438). \u0422\u0430\u043c, \u0435\u0449\u0435
    \u0431\u0443\u0434\u0443\u0447\u0438 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u043c,
    \u0411\u043b\u0435\u0437 \u0432\u043f\u0438\u0442\u044b\u0432\u0430\u043b \u0441\u0430\u043c\u044b\u0435
    \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438\u0434\u0435\u0438 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\U0001F468\u200d\U0001F4BC
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0438 \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f
    \u0431\u044b\u043b\u0430 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0438 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u043b\u0430\u0441\u044c
    \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c\u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f\u043c\u0438.
    \u041f\u0435\u0440\u0432\u044b\u0435 \u0442\u0440\u0443\u0434\u044b: \u0412 16 \u043b\u0435\u0442
    \u043e\u043d \u043f\u0438\u0448\u0435\u0442 \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \"\u041e\u043f\u044b\u0442
    \u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u0445\",
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u0443\u0435\u0442
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u043e \"\u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0448\u0435\u0441\u0442\u0438\u0432\u0435\u0440\u0448\u0438\u043d\u043d\u0438\u043a\u0435\".
    \u042d\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u043e \u0434\u0430\u0436\u0435 \u0414\u0435\u043a\u0430\u0440\u0442\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0432\u0435\u0440\u0438\u0442\u044c, \u0447\u0442\u043e \u0435\u0433\u043e \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043e\u043a.
    \"\u041f\u0430\u0441\u043a\u0430\u043b\u0438\u043d\u0430\": \u0412 1642 \u0433\u043e\u0434\u0443
    (\u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19 \u043b\u0435\u0442) \u043e\u043d
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0447\u0435\u0442\u043d\u043e\u0439
    \u043c\u0430\u0448\u0438\u043d\u044b, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u043e\u0447\u044c
    \u043e\u0442\u0446\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u043c \u0438\u043d\u0442\u0435\u043d\u0434\u0430\u043d\u0442\u043e\u043c
    \u0432 \u0420\u0443\u0430\u043d\u0435. \u041f\u043e\u0441\u043b\u0435 \u0431\u043e\u043b\u0435\u0435
    \u0447\u0435\u043c 50 \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f\u043e\u0432 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \"\u043f\u0430\u0441\u043a\u0430\u043b\u0438\u043d\u0430\" \u2014 \u043f\u0435\u0440\u0432\u044b\u0439
    \u0432 \u043c\u0438\u0440\u0435 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0433 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c
    \u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u0442\u044c, \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u044f \u0440\u0430\u0437\u0440\u044f\u0434\u044b.\n\n\U0001F465
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0420\u0435\u043d\u0435
    \u0414\u0435\u043a\u0430\u0440\u0442: \u0418\u0445 \u043b\u0438\u0447\u043d\u0430\u044f
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u0432 1647 \u0433\u043e\u0434\u0443. \u0411\u0435\u0441\u0435\u0434\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u043d\u043e\u0439:
    \u043e\u043d\u0438 \u043d\u0435 \u0441\u043e\u0448\u043b\u0438\u0441\u044c \u0432\u043e
    \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u0445 \u043d\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u0443
    \u0432\u0430\u043a\u0443\u0443\u043c\u0430 \u0438 \u0440\u043e\u043b\u044c \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430
    \u0432 \u043d\u0430\u0443\u043a\u0435. \u0414\u0435\u043a\u0430\u0440\u0442 \u0441\u043a\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0442\u043d\u0435\u0441\u0441\u044f \u043a \u044e\u043d\u044b\u043c \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435
    \u043a \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0435 \u043f\u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u043c. \u041f\u044c\u0435\u0440 \u0424\u0435\u0440\u043c\u0430:
    \u0412 1654 \u0433\u043e\u0434\u0443, \u043f\u043e \u043f\u0440\u043e\u0441\u044c\u0431\u0435
    \u0434\u0440\u0443\u0433\u0430-\u0438\u0433\u0440\u043e\u043a\u0430 \u0448\u0435\u0432\u0430\u043b\u044c\u0435
    \u0434\u0435 \u041c\u0435\u0440\u0435, \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043d\u0430\u0447\u0430\u043b
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443 \u0441 \u0424\u0435\u0440\u043c\u0430
    \u043e \"\u0437\u0430\u0434\u0430\u0447\u0435 \u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u0441\u0442\u0430\u0432\u043e\u043a\" \u0432 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0445
    \u0438\u0433\u0440\u0430\u0445. \u042d\u0442\u0430 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430
    \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b \u2014 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.\n\n\U0001F64F
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0439
    \u043f\u0435\u0440\u0435\u043b\u043e\u043c \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u0431\u044b\u043b\u0430 \u043e\u0442\u043c\u0435\u0447\u0435\u043d\u0430
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c\u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u043c\u0438
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f\u043c\u0438 \u0438
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438.
    \u041f\u0435\u0440\u0432\u043e\u0435 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    (1646): \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0441\u043b\u043e\u043c\u0430\u043b
    \u0431\u0435\u0434\u0440\u043e, \u0432 \u0434\u043e\u043c\u0435 \u043f\u043e\u0441\u0435\u043b\u0438\u043b\u0438\u0441\u044c
    \u0434\u0432\u0430 \u0432\u0440\u0430\u0447\u0430-\u044f\u043d\u0441\u0435\u043d\u0438\u0441\u0442\u0430.
    \u042f\u043d\u0441\u0435\u043d\u0438\u0437\u043c \u0431\u044b\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u043c
    \u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0432 \u043a\u0430\u0442\u043e\u043b\u0438\u0446\u0438\u0437\u043c\u0435,
    \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u043a \u0438\u0434\u0435\u044f\u043c \u0410\u0432\u0433\u0443\u0441\u0442\u0438\u043d\u0430.
    \u041f\u043e\u0434 \u0438\u0445 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u0438 \u0432\u0441\u044f \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u044f \u043f\u0440\u043e\u043d\u0438\u043a\u043b\u0438\u0441\u044c
    \u044d\u0442\u043e\u0439 \u0441\u0443\u0440\u043e\u0432\u043e\u0439 \u0434\u043e\u043a\u0442\u0440\u0438\u043d\u043e\u0439.
    \"\u0421\u0432\u0435\u0442\u0441\u043a\u0438\u0439\" \u043f\u0435\u0440\u0438\u043e\u0434
    (1651-1654): \u0412 1651 \u0433\u043e\u0434\u0443 \u0443\u043c\u0438\u0440\u0430\u0435\u0442
    \u043e\u0442\u0435\u0446, \u0430 \u0432 1652 \u0433\u043e\u0434\u0443 \u0435\u0433\u043e
    \u043c\u043b\u0430\u0434\u0448\u0430\u044f \u0441\u0435\u0441\u0442\u0440\u0430 \u0416\u0430\u043a\u043b\u0438\u043d
    \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u044c
    \u041f\u043e\u0440-\u0420\u043e\u044f\u043b\u044c \u2014 \u0446\u0435\u043d\u0442\u0440
    \u044f\u043d\u0441\u0435\u043d\u0438\u0437\u043c\u0430. \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u0442\u044f\u0436\u0435\u043b\u043e \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0435\u0442
    \u044d\u0442\u0438 \u043f\u043e\u0442\u0435\u0440\u0438 \u0438 \u043e\u0442\u0434\u0430\u043b\u044f\u0435\u0442\u0441\u044f
    \u043e\u0442 \u0440\u0435\u043b\u0438\u0433\u0438\u0438. \u0412\u0440\u0430\u0447\u0438
    \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u044e\u0442 \u0435\u043c\u0443 \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f,
    \u0438 \u043e\u043d \u043e\u043a\u0443\u043d\u0430\u0435\u0442\u0441\u044f \u0432 \u0441\u0432\u0435\u0442\u0441\u043a\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c: \u043f\u043e\u0441\u0435\u0449\u0430\u0435\u0442 \u0431\u0430\u043b\u044b,
    \u0442\u0435\u0430\u0442\u0440\u044b, \u0441\u0430\u043b\u043e\u043d\u044b. \u0412 \u044d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u0437\u0430\u0432\u043e\u0434\u0438\u0442
    \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430 \u0432 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0440\u0443\u0433\u0430\u0445 \u0438 \u0434\u0430\u0436\u0435 \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0442
    \u0437\u0430 \u0434\u0435\u0432\u0443\u0448\u043a\u0430\u043c\u0438, \u043d\u043e, \u043f\u043e
    \u0441\u043b\u043e\u0432\u0430\u043c \u0435\u0433\u043e \u0441\u0435\u0441\u0442\u0440\u044b,
    \u044d\u0442\u043e \u0431\u044b\u043b \"\u043c\u0438\u0440\u0441\u043a\u043e\u0439 \u0434\u0443\u0445,
    \u0432\u0435\u0441\u044c\u043c\u0430 \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u0439 \u043e\u0442
    \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e\". \u041d\u043e\u0447\u044c
    \u043e\u0433\u043d\u044f (23 \u043d\u043e\u044f\u0431\u0440\u044f 1654 \u0433\u043e\u0434\u0430):
    \u041a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439 \u0435\u0433\u043e
    \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0445 \u0438\u0441\u043a\u0430\u043d\u0438\u0439
    \u0441\u0442\u0430\u043b\u0430 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043d\u043e\u0447\u044c \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b \"\u0432\u0442\u043e\u0440\u044b\u043c
    \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c\". \u041e\u043d \u0437\u0430\u043f\u0438\u0441\u0430\u043b
    \u043f\u0435\u0440\u0435\u0436\u0438\u0442\u043e\u0435 \u043d\u0430 \u043a\u043b\u043e\u0447\u043a\u0435
    \u043f\u0435\u0440\u0433\u0430\u043c\u0435\u043d\u0442\u0430 (\"\u041c\u0435\u043c\u043e\u0440\u0438\u0430\u043b\"),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438
    \u043d\u043e\u0441\u0438\u043b \u0437\u0430\u0448\u0438\u0442\u044b\u043c \u0432 \u043f\u043e\u0434\u043a\u043b\u0430\u0434\u043a\u0443
    \u043a\u0430\u043c\u0437\u043e\u043b\u0430. \u0416\u0438\u0437\u043d\u044c \u0432 \u041f\u043e\u0440-\u0420\u043e\u044f\u043b\u0435:
    \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0439 \u043d\u043e\u0447\u0438 \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u0443\u0434\u0430\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u041f\u043e\u0440-\u0420\u043e\u044f\u043b\u044c.
    \u041e\u043d \u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043c\u043e\u043d\u0430\u0445\u043e\u043c,
    \u043d\u043e \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u0435\u0442 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u044f \u0438 \u043f\u043e\u0441\u0432\u044f\u0449\u0430\u0435\u0442
    \u0441\u0435\u0431\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0438 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u0438.
    \u041e\u043d \u0432\u0435\u0434\u0435\u0442 \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u043d\u044b\u0439
    \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438: \u0441\u043f\u0438\u0442
    \u043d\u0430 \u0436\u0435\u0441\u0442\u043a\u043e\u0439 \u043f\u043e\u0441\u0442\u0435\u043b\u0438,
    \u0435\u0441\u0442 \u043d\u0430 \u043a\u0443\u0445\u043d\u0435, \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044f
    \u043e\u0431\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0431\u0435\u0437 \u0441\u043b\u0443\u0433.\n\n\U0001F54A\ufe0f
    \u0421\u043c\u0435\u0440\u0442\u044c \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u041f\u0430\u0441\u043a\u0430\u043b\u044f
    \u0431\u044b\u043b\u0438 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u044b \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0431\u043e\u043b\u0435\u0437\u043d\u044f\u043c\u0438. \u041a 39 \u0433\u043e\u0434\u0430\u043c
    \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u0430\u0431,
    \u0447\u0442\u043e \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u043c\u043e\u0433 \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044c\u0441\u044f.
    \u041e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    19 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1662 \u0433\u043e\u0434\u0430, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u0432\u0441\u0435\u0433\u043e 39 \u043b\u0435\u0442, \u0432 \u043c\u0443\u043a\u0430\u0445
    \u043e\u0442 \u043d\u0435\u0438\u0437\u043b\u0435\u0447\u0438\u043c\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438.
    \u0415\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u044c \u0441\u0442\u0430\u043b\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435\u043c
    \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0439, \u043d\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u043f\u043e\u043b\u043d\u043e\u0439 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0437\u0440\u0435\u043d\u0438\u0439 \u0438 \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0445
    \u0438\u0441\u043a\u0430\u043d\u0438\u0439."
  personalLifeEn: 
  shortBioRu: "\u0411\u043b\u0435\u0437 \u041f\u0430\u0441\u043a\u0430\u043b\u044c (1623\u20131662) \u2014
    \u044d\u0442\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a-\u044d\u043f\u043e\u0445\u0430,
    \u0447\u044c\u044f \u043a\u043e\u0440\u043e\u0442\u043a\u0430\u044f, \u043d\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0432\u043c\u0435\u0441\u0442\u0438\u043b\u0430 \u0432 \u0441\u0435\u0431\u044f \u0438
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u043f\u0440\u043e\u0437\u0440\u0435\u043d\u0438\u044f, \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0439 \u043a\u0440\u0438\u0437\u0438\u0441, \u0438
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0431\u0435\u0441\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0445
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0439. \u041e\u043d \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0447\u0435\u043d\u044b\u043c,
    \u0430, \u043f\u043e \u043c\u0435\u0442\u043a\u043e\u043c\u0443 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u00ab\u043c\u044b\u0441\u043b\u044f\u0449\u0438\u043c
    \u0442\u0440\u043e\u0441\u0442\u043d\u0438\u043a\u043e\u043c\u00bb, \u0447\u044c\u0435 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u044f\u0440\u043a\u0438\u0445 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u043a\u0440\u0438\u0437\u0438\u0441\u0430 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f XVII \u0432\u0435\u043a\u0430.\n\n\U0001F37C
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0411\u043b\u0435\u0437
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0440\u043e\u0434\u0438\u043b\u0441\u044f 19
    \u0438\u044e\u043d\u044f 1623 \u0433\u043e\u0434\u0430 \u0432 \u041a\u043b\u0435\u0440\u043c\u043e\u043d-\u0424\u0435\u0440\u0440\u0430\u043d\u0435,
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u042d\u0442\u044c\u0435\u043d\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f,
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430
    \u0438 \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u044f \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u043e\u0433\u043e
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u0438 \u0410\u043d\u0442\u0443\u0430\u043d\u0435\u0442\u0442\u044b
    \u0411\u0435\u0433\u043e\u043d. \u0421\u0435\u043c\u044c\u044f \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b\u0430
    \u043a \u00ab\u0434\u0432\u043e\u0440\u044f\u043d\u0441\u0442\u0432\u0443 \u043c\u0430\u043d\u0442\u0438\u0438\u00bb
    \u2014 \u0441\u043b\u043e\u044e \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a\u043e\u0432,
    \u0447\u044c\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043e \u043d\u0435 \u043d\u0430 \u0434\u0440\u0435\u0432\u043d\u043e\u0441\u0442\u0438
    \u0440\u043e\u0434\u0430, \u0430 \u043d\u0430 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u043c\u043e\u0439
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438. \u0421\u0443\u0434\u044c\u0431\u0430
    \u0411\u043b\u0435\u0437\u0430 \u0431\u044b\u043b\u0430 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u0430
    \u0440\u0430\u043d\u043d\u0435\u0439 \u0443\u0442\u0440\u0430\u0442\u043e\u0439: \u0435\u0433\u043e
    \u043c\u0430\u0442\u044c \u0443\u043c\u0435\u0440\u043b\u0430, \u043a\u043e\u0433\u0434\u0430
    \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e \u0442\u0440\u0438
    \u0433\u043e\u0434\u0430. \u0412 1631 \u0433\u043e\u0434\u0443 \u0441\u0435\u043c\u044c\u044f
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u0432 \u041f\u0430\u0440\u0438\u0436,
    \u0438 \u043e\u0442\u0435\u0446, \u042d\u0442\u044c\u0435\u043d, \u0441\u0430\u043c \u0443\u0432\u0430\u0436\u0430\u0435\u043c\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0440\u0435\u0448\u0438\u043b \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0432\u0437\u044f\u0442\u044c \u043d\u0430 \u0441\u0435\u0431\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0434\u0435\u0442\u0435\u0439, \u043d\u0435 \u0434\u043e\u0432\u0435\u0440\u044f\u044f
    \u0435\u0433\u043e \u0448\u043a\u043e\u043b\u0435. \u041e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0434\u043b\u044f \u0441\u044b\u043d\u0430 \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442
    \u043e\u0442\u0434\u0430\u0432\u0430\u043b\u0441\u044f \u0434\u0440\u0435\u0432\u043d\u0438\u043c
    \u044f\u0437\u044b\u043a\u0430\u043c (\u043b\u0430\u0442\u044b\u043d\u0438 \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c\u0443),
    \u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u0442\u0435\u0446 \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u043c,
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0434 \u0437\u0430\u043f\u0440\u0435\u0442\u043e\u043c
    \u0434\u043e 15 \u043b\u0435\u0442. \u041e\u0434\u043d\u0430\u043a\u043e, \u043a\u0430\u043a
    \u044d\u0442\u043e \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u0432\u0430\u0435\u0442 \u0441
    \u0433\u0435\u043d\u0438\u044f\u043c\u0438, \u0437\u0430\u043f\u0440\u0435\u0442 \u043b\u0438\u0448\u044c
    \u043f\u043e\u0434\u0441\u0442\u0435\u0433\u043d\u0443\u043b \u0438\u043d\u0442\u0435\u0440\u0435\u0441.
    \u041f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0441\u0435\u0441\u0442\u0440\u044b \u041f\u0430\u0441\u043a\u0430\u043b\u044f, \u0416\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u044b,
    12-\u043b\u0435\u0442\u043d\u0438\u0439 \u0411\u043b\u0435\u0437, \u043d\u0435 \u0437\u043d\u0430\u044f
    \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0430\u043a\u0441\u0438\u043e\u043c, \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0443\u0433\u043b\u0435\u0439 \u043d\u0430
    \u043f\u043e\u043b\u0443, \u00ab\u043e\u0442\u043a\u0440\u044b\u043b\u00bb 32-\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u043e \u0441\u0443\u043c\u043c\u0435 \u0443\u0433\u043b\u043e\u0432
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439
    \u044d\u0442\u0438\u043c, \u043e\u0442\u0435\u0446 \u0441\u043c\u0435\u043d\u0438\u043b
    \u0433\u043d\u0435\u0432 \u043d\u0430 \u043c\u0438\u043b\u043e\u0441\u0442\u044c \u0438
    \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043b \u0441\u044b\u043d\u0443 \u0447\u0438\u0442\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043d\u0438\u0433\u0438,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432\u0432\u0435\u043b \u0435\u0433\u043e \u0432
    \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043a\u0440\u0443\u0436\u043e\u043a \u041c\u0435\u0440\u0441\u0435\u043d\u043d\u0430
    \u2014 \u043a\u043b\u0443\u0431, \u0433\u0434\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0438\u0441\u044c
    \u0432\u0435\u0434\u0443\u0449\u0438\u0435 \u0443\u043c\u044b \u0415\u0432\u0440\u043e\u043f\u044b:
    \u0420\u043e\u0431\u0435\u0440\u0432\u0430\u043b\u044c, \u0414\u0435\u0437\u0430\u0440\u0433,
    \u0413\u0430\u0441\u0441\u0435\u043d\u0434\u0438, \u0430 \u0438\u043d\u043e\u0433\u0434\u0430
    \u0438 \u0441\u0430\u043c \u0414\u0435\u043a\u0430\u0440\u0442. \u0412 16 \u043b\u0435\u0442,
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438
    \u0414\u0435\u0437\u0430\u0440\u0433\u0430, \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u00ab\u041e\u043f\u044b\u0442 \u043e \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u0445\u00bb (Essai pour les coniques), \u0433\u0434\u0435
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u043e \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0448\u0435\u0441\u0442\u0438\u0432\u0435\u0440\u0448\u0438\u043d\u043d\u0438\u043a\u0435
    \u2014 \u043e\u0434\u043d\u0443 \u0438\u0437 \u043e\u0441\u043d\u043e\u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0431\u044b\u043b\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f,
    \u0447\u0442\u043e \u0414\u0435\u043a\u0430\u0440\u0442, \u0443\u0432\u0438\u0434\u0435\u0432
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044c, \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0432\u0435\u0440\u0438\u0442\u044c, \u0447\u0442\u043e \u0435\u0435 \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043e\u043a,
    \u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b, \u0447\u0442\u043e
    \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u0442\u0446\u0430.\n\n\U0001F52C
    \u041d\u0430\u0443\u0447\u043d\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0438 \u00ab\u043f\u0430\u0441\u043a\u0430\u043b\u0438\u043d\u0430\u00bb \u0412 1639 \u0433\u043e\u0434\u0443
    \u042d\u0442\u044c\u0435\u043d\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442
    \u0438\u043d\u0442\u0435\u043d\u0434\u0430\u043d\u0442\u043e\u043c (\u0441\u0431\u043e\u0440\u0449\u0438\u043a\u043e\u043c
    \u043d\u0430\u043b\u043e\u0433\u043e\u0432) \u0432 \u0420\u0443\u0430\u043d, \u0438 \u0441\u0435\u043c\u044c\u044f
    \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0435\u0442 \u0442\u0443\u0434\u0430. \u0411\u043b\u0435\u0437
    \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043e\u0442\u0446\u0443 \u0441 \u0443\u0442\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u043c\u0438 \u0438 \u0432 1642 \u0433\u043e\u0434\u0443
    (\u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19 \u043b\u0435\u0442) \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0435\u0442
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0447\u0435\u0442\u043d\u043e\u0439 \u043c\u0430\u0448\u0438\u043d\u044b \u2014 \u00ab\u043f\u0430\u0441\u043a\u0430\u043b\u0438\u043d\u044b\u00bb.
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u0440\u0438\u0441\u043f\u043e\u0441\u043e\u0431\u043b\u0435\u043d\u0438\u0435, \u0430
    \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u043c\u0438\u0440\u0435 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439
    \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043c\u043e\u0433 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u0442\u044c,
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u044f
    \u0440\u0430\u0437\u0440\u044f\u0434\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0448\u0435\u0441\u0442\u0435\u0440\u0435\u043d\u043e\u043a.
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b
    \u043e\u043a\u043e\u043b\u043e 50 \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f\u043e\u0432,
    \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0434\u043e\u0432\u0435\u043b \u043c\u0430\u0448\u0438\u043d\u0443
    \u0434\u043e \u0443\u043c\u0430. \u0425\u043e\u0442\u044f \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0443\u0441\u043f\u0435\u0445\u0430 \u00ab\u043f\u0430\u0441\u043a\u0430\u043b\u0438\u043d\u0430\u00bb
    \u043d\u0435 \u0438\u043c\u0435\u043b\u0430 \u0438\u0437-\u0437\u0430 \u0432\u044b\u0441\u043e\u043a\u043e\u0439
    \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u0438, \u0441\u0430\u043c \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u043a\u043e\u043b\u0435\u0441 \u043b\u0435\u0433
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0430\u0440\u0438\u0444\u043c\u043e\u043c\u0435\u0442\u0440\u043e\u0432
    \u043d\u0430 \u0442\u0440\u0438 \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u044f \u0432\u043f\u0435\u0440\u0435\u0434.
    \u0412 \u0420\u0443\u0430\u043d\u0435 \u0436\u0435 \u0432 1646 \u0433\u043e\u0434\u0443
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043f\u0435\u0440\u0432\u043e\u0435
    \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u041f\u0430\u0441\u043a\u0430\u043b\u044f
    \u043a \u0440\u0435\u043b\u0438\u0433\u0438\u0438. \u041f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e
    \u043a\u0430\u043a \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0441\u043b\u043e\u043c\u0430\u043b
    \u0431\u0435\u0434\u0440\u043e, \u0437\u0430 \u043d\u0438\u043c \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u043b\u0438
    \u0434\u0432\u0430 \u0432\u0440\u0430\u0447\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0431\u044b\u043b\u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c\u0438
    \u044f\u043d\u0441\u0435\u043d\u0438\u0441\u0442\u0430\u043c\u0438. \u042f\u043d\u0441\u0435\u043d\u0438\u0437\u043c
    \u2014 \u044d\u0442\u043e \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u0432 \u043a\u0430\u0442\u043e\u043b\u0438\u0446\u0438\u0437\u043c\u0435, \u0431\u043b\u0438\u0437\u043a\u043e\u0435
    \u043a \u0438\u0434\u0435\u044f\u043c \u0410\u0432\u0433\u0443\u0441\u0442\u0438\u043d\u0430
    \u043e \u043f\u0440\u0435\u0434\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u0438 \u0441\u043f\u0430\u0441\u0430\u044e\u0449\u0435\u0439 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0442\u0438.
    \u041f\u043e\u0434 \u0438\u0445 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u041f\u0430\u0441\u043a\u0430\u043b\u044c,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u0432\u0441\u044f \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u044f,
    \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u044e\u0442\u0441\u044f \u044d\u0442\u043e\u0439
    \u0441\u0443\u0440\u043e\u0432\u043e\u0439 \u0434\u043e\u043a\u0442\u0440\u0438\u043d\u043e\u0439.
    \u0412 \u044d\u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u0435\u0433\u043e
    \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u043f\u044b\u0442\u044b. \u041e\u043d \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u044b \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438
    \u0441 \u0440\u0442\u0443\u0442\u043d\u044b\u043c \u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440\u043e\u043c,
    \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044f \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0433\u043e \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0443\u0441\u0442\u043e\u0442\u044b
    \u2014 \u043f\u043e\u043d\u044f\u0442\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0430\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u0438\u0430\u043d\u0446\u044b \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u043b\u0438.
    \u0412 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c \u043e\u043f\u044b\u0442\u0435
    \u043d\u0430 \u0433\u043e\u0440\u0435 \u041f\u044e\u0438-\u0434\u0435-\u0414\u043e\u043c
    (\u043f\u043e \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u041f\u0430\u0441\u043a\u0430\u043b\u044f
    \u0435\u0433\u043e \u043f\u0440\u043e\u0432\u0435\u043b \u0437\u044f\u0442\u044c, \u0424\u043b\u043e\u0440\u0430\u043d
    \u041f\u0435\u0440\u044c\u0435) \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u043e\u0437\u0434\u0443\u0445\u0430
    \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0435\u0442\u0441\u044f \u0441 \u0432\u044b\u0441\u043e\u0442\u043e\u0439,
    \u0447\u0442\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u043e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0422\u043e\u0440\u0440\u0438\u0447\u0435\u043b\u043b\u0438. \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435
    \u044d\u0442\u0438\u0445 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u043e\u0432
    \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0437\u0430\u043a\u043e\u043d \u0433\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438
    (\u0437\u0430\u043a\u043e\u043d \u041f\u0430\u0441\u043a\u0430\u043b\u044f) \u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0435
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0432 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044f\u0445
    \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0448\u043f\u0440\u0438\u0446 \u0438
    \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u0435\u0441\u0441.
    \u041f\u043e\u0437\u0436\u0435 \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0437\u0432\u0430\u043b\u0438
    \u0435\u0434\u0438\u043d\u0438\u0446\u0443 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u2014 \u043f\u0430\u0441\u043a\u0430\u043b\u044c.\n\n\U0001F3AD \u00ab\u0421\u0432\u0435\u0442\u0441\u043a\u0438\u0439\u00bb
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0412 1647 \u0433\u043e\u0434\u0443 \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0435\u0442
    \u0432 \u041f\u0430\u0440\u0438\u0436, \u0433\u0434\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u0441\u044f
    \u0441 \u0414\u0435\u043a\u0430\u0440\u0442\u043e\u043c. \u0418\u0445 \u043e\u0431\u0449\u0435\u043d\u0438\u0435
    \u0431\u044b\u043b\u043e \u043a\u0440\u0430\u0442\u043a\u0438\u043c, \u043d\u043e \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u043d\u044b\u043c:
    \u043e\u043d\u0438 \u043d\u0435 \u0441\u043e\u0448\u043b\u0438\u0441\u044c \u0432\u043e
    \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u0445 \u043d\u0430 \u043f\u0443\u0441\u0442\u043e\u0442\u0443
    \u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044e \u043d\u0430\u0443\u043a\u0438.
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u0441\u0447\u0438\u0442\u0430\u043b
    \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430
    \u043d\u0430\u0434 \u0434\u0435\u0434\u0443\u043a\u0446\u0438\u0435\u0439. \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430 \u0432 1651 \u0433\u043e\u0434\u0443
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0435\u0442
    \u043a\u0440\u0438\u0437\u0438\u0441. \u041e\u043d \u0441\u0431\u043b\u0438\u0436\u0430\u0435\u0442\u0441\u044f
    \u0441 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0432\u0435\u0442\u0441\u043a\u043e\u0439 \u0441\u0440\u0435\u0434\u043e\u0439, \u0432
    \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0441 \u0433\u0435\u0440\u0446\u043e\u0433\u043e\u043c
    \u0434\u0435 \u0420\u0443\u0430\u043d\u043d\u0435, \u0438 \u0437\u0430\u0432\u0441\u0435\u0433\u0434\u0430\u0442\u0430\u044f\u043c\u0438
    \u0441\u0430\u043b\u043e\u043d\u043e\u0432, \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a
    \u0448\u0435\u0432\u0430\u043b\u044c\u0435 \u0434\u0435 \u041c\u0435\u0440\u0435 \u0438
    \u0414\u0430\u043c\u044c\u0435\u043d \u041c\u0438\u0442\u0442\u043e\u043d. \u0418\u043c\u0435\u043d\u043d\u043e
    \u043e\u0442 \u043d\u0438\u0445, \u0437\u0430\u044f\u0434\u043b\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432
    \u0432 \u043a\u043e\u0441\u0442\u0438 \u0438 \u043a\u0430\u0440\u0442\u044b, \u043e\u043d
    \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u00ab\u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u0441\u0442\u0430\u0432\u043e\u043a\u00bb: \u043a\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u0431\u0430\u043d\u043a, \u0435\u0441\u043b\u0438
    \u0438\u0433\u0440\u0430 \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u0430 \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e?.
    \u0412 \u0445\u043e\u0434\u0435 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438 \u0441
    \u041f\u044c\u0435\u0440\u043e\u043c \u0424\u0435\u0440\u043c\u0430 \u0432 1654 \u0433\u043e\u0434\u0443
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043d\u0430\u0445\u043e\u0434\u0438\u0442 \u0440\u0435\u0448\u0435\u043d\u0438\u0435,
    \u0442\u0435\u043c \u0441\u0430\u043c\u044b\u043c \u0437\u0430\u043b\u043e\u0436\u0438\u0432
    \u043e\u0441\u043d\u043e\u0432\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0412 \u044d\u0442\u043e\u0442 \u0436\u0435 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d
    \u043f\u0438\u0448\u0435\u0442 \u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u043e\u0431
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0435\u00bb,
    \u0433\u0434\u0435 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0442\u0430\u0431\u043b\u0438\u0446\u0443 \u0431\u0438\u043d\u043e\u043c\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0443\u044e
    \u0442\u0435\u043f\u0435\u0440\u044c \u043a\u0430\u043a \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f.\n\n\U0001F525 \u041d\u043e\u0447\u044c \u043e\u0433\u043d\u044f
    \u0438 \u0443\u0445\u043e\u0434 \u0432 \u041f\u043e\u0440-\u0420\u043e\u044f\u043b\u044c
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u043b\u0430\u0432\u0443
    \u0438 \u0441\u0432\u0435\u0442\u0441\u043a\u0438\u0435 \u0443\u0441\u043f\u0435\u0445\u0438,
    \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0435 \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e
    \u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 (\u0441 18 \u043b\u0435\u0442 \u0435\u0433\u043e
    \u043c\u0443\u0447\u0438\u043b\u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u0433\u043e\u043b\u043e\u0432\u043d\u044b\u0435
    \u0431\u043e\u043b\u0438) \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f. \u041a\u0443\u043b\u044c\u043c\u0438\u043d\u0430\u0446\u0438\u0435\u0439
    \u0435\u0433\u043e \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0445 \u0438\u0441\u043a\u0430\u043d\u0438\u0439
    \u0441\u0442\u0430\u043b\u0430 \u043d\u043e\u0447\u044c \u0441 23 \u043d\u0430 24 \u043d\u043e\u044f\u0431\u0440\u044f
    1654 \u0433\u043e\u0434\u0430. \u0412 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438
    \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u044f
    \u043e\u043d \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u00ab\u0432\u0442\u043e\u0440\u043e\u0435
    \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u00bb \u2014 \u0442\u043e\u0442\u0430\u043b\u044c\u043d\u043e\u0435,
    \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u043a \u0411\u043e\u0433\u0443. \u041f\u043e\u0442\u0440\u044f\u0441\u0435\u043d\u0438\u0435
    \u0431\u044b\u043b\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0438\u043b\u044c\u043d\u044b\u043c,
    \u0447\u0442\u043e \u043e\u043d \u0437\u0430\u043f\u0438\u0441\u0430\u043b \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u043d\u043e\u0435
    \u043d\u0430 \u043a\u043b\u043e\u0447\u043a\u0435 \u043f\u0435\u0440\u0433\u0430\u043c\u0435\u043d\u0442\u0430.
    \u042d\u0442\u043e\u0442 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0439
    \u00ab\u041c\u0435\u043c\u043e\u0440\u0438\u0430\u043b\u043e\u043c\u00bb, \u043d\u0430\u0447\u0438\u043d\u0430\u043b\u0441\u044f
    \u0441\u043b\u043e\u0432\u043e\u043c \u00ab\u041e\u0433\u043e\u043d\u044c\u00bb (Feu) \u0438
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b \u0441\u0442\u0440\u043e\u043a\u0438 \u043b\u0438\u0447\u043d\u043e\u0433\u043e
    \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u044f. \u0414\u043e \u0441\u0430\u043c\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043d\u043e\u0441\u0438\u043b
    \u044d\u0442\u0443 \u0437\u0430\u043f\u0438\u0441\u043a\u0443, \u0437\u0430\u0448\u0438\u0442\u0443\u044e
    \u0432 \u043f\u043e\u0434\u043a\u043b\u0430\u0434\u043a\u0443 \u043a\u0430\u043c\u0437\u043e\u043b\u0430.
    \u0412 \u044f\u043d\u0432\u0430\u0440\u0435 1655 \u0433\u043e\u0434\u0430 \u043e\u043d \u0443\u0434\u0430\u043b\u044f\u0435\u0442\u0441\u044f
    \u0432 \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u044c \u041f\u043e\u0440-\u0420\u043e\u044f\u043b\u044c
    \u2014 \u0446\u0435\u043d\u0442\u0440 \u044f\u043d\u0441\u0435\u043d\u0438\u0437\u043c\u0430.
    \u041e\u043d \u043d\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043c\u043e\u043d\u0430\u0448\u0435\u0441\u043a\u043e\u0433\u043e
    \u043f\u043e\u0441\u0442\u0440\u0438\u0433\u0430, \u043d\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u043e\u0432
    \u0438 \u043f\u043e\u043b\u0435\u043c\u0438\u0441\u0442\u043e\u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f.\n\n\u270d\ufe0f
    \u0413\u043b\u0430\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b: \u00ab\u041f\u0438\u0441\u044c\u043c\u0430\u00bb
    \u0438 \u00ab\u041c\u044b\u0441\u043b\u0438\u00bb \u0412 \u041f\u043e\u0440-\u0420\u043e\u044f\u043b\u0435
    \u0440\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u043e-\u043f\u043e\u043b\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442 \u041f\u0430\u0441\u043a\u0430\u043b\u044f. 1. \u00ab\u041f\u0438\u0441\u044c\u043c\u0430
    \u043a \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u0443\u00bb (1656\u20131657)
    \u2014 \u044d\u0442\u043e \u0441\u0435\u0440\u0438\u044f \u0438\u0437 18 \u0441\u0430\u0442\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0438\u0441\u0435\u043c, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445
    \u043f\u043e\u0434 \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c\u043e\u043c \u041b\u0443\u0438
    \u0434\u0435 \u041c\u043e\u043d\u0442\u0430\u043b\u044c\u0442. \u0412 \u043d\u0438\u0445
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435,
    \u0441 \u044f\u0437\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u0438\u0435\u043c
    \u0438 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0440\u0430\u0437\u0433\u0440\u043e\u043c\u0438\u043b \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u0443\u044e
    \u043a\u0430\u0437\u0443\u0438\u0441\u0442\u0438\u043a\u0443 \u0438\u0435\u0437\u0443\u0438\u0442\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e
    \u044f\u043d\u0441\u0435\u043d\u0438\u0441\u0442\u043e\u0432, \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u043b\u0435\u0433\u043a\u043e \u043e\u0442\u043f\u0443\u0441\u043a\u0430\u043b\u0438 \u0433\u0440\u0435\u0445\u0438
    \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u0433\u0440\u0435\u0448\u043d\u0438\u043a\u0430\u043c.
    \u042d\u0442\u043e\u0442 \u043f\u0430\u043c\u0444\u043b\u0435\u0442 \u0441\u0442\u0430\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u0438\u043c
    \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u043c, \u043d\u043e \u0438 \u0448\u0435\u0434\u0435\u0432\u0440\u043e\u043c
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u043f\u0440\u043e\u0437\u044b,
    \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c \u0441\u0430\u0442\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u0442\u0438\u043b\u044f, \u043f\u043e\u0432\u043b\u0438\u044f\u0432\u0448\u0438\u043c
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0432\u0441\u0435\u0439 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b. 2. \u00ab\u041c\u044b\u0441\u043b\u0438\u00bb
    \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439
    \u0442\u0440\u0443\u0434 \u041f\u0430\u0441\u043a\u0430\u043b\u044f, \u043d\u0430\u0434
    \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0434\u043e \u0441\u0430\u043c\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438. \u042d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u043d\u0430\u044f \u0438\u043c
    \u00ab\u0410\u043f\u043e\u043b\u043e\u0433\u0438\u044f \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0441\u043a\u043e\u0439
    \u0440\u0435\u043b\u0438\u0433\u0438\u0438\u00bb \u2014 \u043a\u043d\u0438\u0433\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u043b\u0430
    \u0443\u0431\u0435\u0434\u0438\u0442\u044c \u0441\u043a\u0435\u043f\u0442\u0438\u043a\u043e\u0432
    \u0438 \u043d\u0435\u0432\u0435\u0440\u0443\u044e\u0449\u0438\u0445 \u0432 \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0441\u0442\u0438
    \u0432\u0435\u0440\u044b. \u041e\u043d \u0442\u0430\u043a \u0438 \u043d\u0435 \u0443\u0441\u043f\u0435\u043b
    \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0441\u0432\u043e\u0438 \u0437\u0430\u043f\u0438\u0441\u0438
    \u0432 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0440\u044f\u0434\u043e\u043a.
    \u0423\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438
    \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u0437\u0430\u043c\u0435\u0442\u043a\u0438
    \u0438 \u0430\u0444\u043e\u0440\u0438\u0437\u043c\u044b \u0431\u044b\u043b\u0438 \u0441\u043e\u0431\u0440\u0430\u043d\u044b
    \u0438 \u0438\u0437\u0434\u0430\u043d\u044b \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c
    \u00ab\u041c\u044b\u0441\u043b\u0438\u00bb. \u0418\u043c\u0435\u043d\u043d\u043e \u0432
    \u00ab\u041c\u044b\u0441\u043b\u044f\u0445\u00bb \u0437\u0430\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438 \u0432\u0435\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043e\u0431\u0440\u0430\u0437 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0437\u0430\u0442\u0435\u0440\u044f\u043d\u043d\u043e\u0433\u043e
    \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f \u0431\u0435\u0437\u0434\u043d\u0430\u043c\u0438
    \u2014 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043d\u0438\u0447\u0442\u043e\u0436\u0435\u0441\u0442\u0432\u043e\u043c. \u0427\u0435\u043b\u043e\u0432\u0435\u043a,
    \u043f\u043e \u041f\u0430\u0441\u043a\u0430\u043b\u044e, \u2014 \u044d\u0442\u043e \u00ab\u043c\u044b\u0441\u043b\u044f\u0449\u0438\u0439
    \u0442\u0440\u043e\u0441\u0442\u043d\u0438\u043a\u00bb. \u041e\u043d \u0441\u043b\u0430\u0431
    \u0438 \u0445\u0440\u0443\u043f\u043e\u043a, \u043a\u0430\u043a \u0442\u0440\u043e\u0441\u0442\u043d\u0438\u043a,
    \u043d\u043e \u0432\u0435\u043b\u0438\u0447\u0438\u0435 \u0435\u0433\u043e \u0432 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043c\u044b\u0441\u043b\u0438\u0442\u044c. \u0412 \u044d\u0442\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0438
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441
    \u0442\u0430\u043a\u043e\u0439 \u043e\u0441\u0442\u0440\u043e\u0442\u043e\u0439 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0433\u0440\u0430\u043d\u0438\u0446\u0430\u0445
    \u0440\u0430\u0437\u0443\u043c\u0430 \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0435\u043c\u0443 \u00ab\u043b\u043e\u0433\u0438\u043a\u0443 \u0441\u0435\u0440\u0434\u0446\u0430\u00bb
    \u2014 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e\u0435 \u043f\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u0432
    \u0431\u044b\u0442\u0438\u044f. \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u00ab\u0441\u0442\u0430\u0432\u043a\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f\u00bb
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u00ab\u041c\u044b\u0441\u043b\u0435\u0439\u00bb:
    \u0430\u0442\u0435\u0438\u0441\u0442\u0443 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f
    \u00ab\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c\u00bb \u043d\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u0411\u043e\u0433\u0430, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0434\u0430\u0436\u0435
    \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448\u0430
    \u043e\u043d \u0442\u0435\u0440\u044f\u0435\u0442 \u043b\u0438\u0448\u044c \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u0437\u0435\u043c\u043d\u044b\u0435 \u0431\u043b\u0430\u0433\u0430, \u0430 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435
    \u0432\u044b\u0438\u0433\u0440\u044b\u0448\u0430 \u043e\u0431\u0440\u0435\u0442\u0430\u0435\u0442
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u0431\u043b\u0430\u0436\u0435\u043d\u0441\u0442\u0432\u043e.
    \u041f\u043e \u0441\u0443\u0442\u0438, \u044d\u0442\u043e \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0439
    \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442 \u0432 \u043f\u043e\u043b\u044c\u0437\u0443
    \u0432\u0435\u0440\u044b, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439,
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u043d \u0441\u0430\u043c \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u043b \u0440\u0443\u043a\u0443.\n\n\U0001F319
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435
    \u0411\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442
    \u0442\u044f\u0436\u0435\u043b\u043e\u0439, \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0431\u043e\u043b\u0435\u0437\u043d\u0438. \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u0441\u0442\u0430\u043b\u0430
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0438\u043b\u044c\u043d\u043e\u0439,
    \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u043c\u043e\u0433
    \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044c\u0441\u044f. \u0422\u0435\u043c
    \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0442\u0432\u043e\u0440\u0438\u0442\u044c: \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b
    \u043f\u0440\u043e\u0435\u043a\u0442 \u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0438\u0434\u0430
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0430
    (\u043e\u043c\u043d\u0438\u0431\u0443\u0441\u0430) \u0434\u043b\u044f \u0431\u0435\u0434\u043d\u044b\u0445,
    \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0434\u0438\u0441\u043f\u0443\u0442\u0430\u0445. \u0411\u043b\u0435\u0437 \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    19 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1662 \u0433\u043e\u0434\u0430, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    39 \u043b\u0435\u0442, \u0432 \u043c\u0443\u043a\u0430\u0445 \u043e\u0442 \u043d\u0435\u0438\u0437\u043b\u0435\u0447\u0438\u043c\u043e\u0439
    \u0431\u043e\u043b\u0435\u0437\u043d\u0438. \u0415\u0433\u043e \u0443\u0445\u043e\u0434
    \u0431\u044b\u043b \u043f\u043e\u043b\u043e\u043d \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u0441\u043c\u0438\u0440\u0435\u043d\u0438\u044f \u0438 \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u0430.
    \u0421\u043f\u0443\u0441\u0442\u044f \u0432\u0435\u043a\u0430 \u0435\u0433\u043e \u0438\u0434\u0435\u0438
    \u043e \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043e \u00ab\u043b\u043e\u0433\u0438\u043a\u0435 \u0441\u0435\u0440\u0434\u0446\u0430\u00bb
    \u0431\u044b\u043b\u0438 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u044f\u0442\u044b \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430\u043c\u0438-\u044d\u043a\u0437\u0438\u0441\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c\u0438,
    \u0430 \u041b\u0435\u0432 \u0422\u043e\u043b\u0441\u0442\u043e\u0439 \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0435\u0433\u043e \u00ab\u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430\u00bb."
  shortBioEn: 
  interestingFactsRu: "\u0417\u0430 \u0441\u0432\u043e\u044e \u043d\u0435\u0434\u043e\u043b\u0433\u0443\u044e,
    \u043d\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u044f\u0440\u043a\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c \u0411\u043b\u0435\u0437 \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u0443\u0441\u043f\u0435\u043b \u043f\u0440\u043e\u044f\u0432\u0438\u0442\u044c \u0441\u0435\u0431\u044f
    \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445, \u043f\u043e\u0440\u043e\u0439
    \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0445 \u0438\u043f\u043e\u0441\u0442\u0430\u0441\u044f\u0445.
    \u041f\u043e\u043c\u0438\u043c\u043e \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439,
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043f\u043e\u043b\u043d\u0430
    \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0445, \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445
    \u0438 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432.\n\n\U0001F4D6 \u0421\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u00ab\u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u00bb \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0432 12 \u043b\u0435\u0442 \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0443\u0440\u044c\u0435\u0437
    \u0438\u0437 \u0435\u0433\u043e \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0437\u0430\u043d
    \u0441 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043c
    \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u044f, \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u043c
    \u043e\u0442\u0446\u043e\u043c. \u042d\u0442\u044c\u0435\u043d \u041f\u0430\u0441\u043a\u0430\u043b\u044c,
    \u043e\u043f\u0430\u0441\u0430\u044f\u0441\u044c, \u0447\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0443\u0432\u043b\u0435\u0447\u0435\u0442 \u0441\u044b\u043d\u0430
    \u0438 \u043f\u043e\u043c\u0435\u0448\u0430\u0435\u0442 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445 \u044f\u0437\u044b\u043a\u043e\u0432, \u0441\u043f\u0440\u044f\u0442\u0430\u043b
    \u0432\u0441\u0435 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438 \u0438 \u0437\u0430\u043f\u0440\u0435\u0442\u0438\u043b
    \u0411\u043b\u0435\u0437\u0443 \u0434\u0430\u0436\u0435 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0430\u0442\u044c\u0441\u044f
    \u043a \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u0435 \u0434\u043e 15 \u043b\u0435\u0442.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0437\u0430\u043f\u0440\u0435\u0442 \u0432\u043e\u0437\u044b\u043c\u0435\u043b
    \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442. \u041e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043e\u0442\u0435\u0446 \u0437\u0430\u0441\u0442\u0430\u043b 12-\u043b\u0435\u0442\u043d\u0435\u0433\u043e
    \u0411\u043b\u0435\u0437\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0443\u0433\u043b\u044f \u043d\u0430 \u043f\u043e\u043b\u0443 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u043e \u0441\u0443\u043c\u043c\u0435 \u0443\u0433\u043b\u043e\u0432
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439
    \u044d\u0442\u0438\u043c, \u042d\u0442\u044c\u0435\u043d \u0441\u043d\u044f\u043b \u0437\u0430\u043f\u0440\u0435\u0442
    \u0438 \u043f\u043e\u0434\u0430\u0440\u0438\u043b \u0441\u044b\u043d\u0443 \u00ab\u041d\u0430\u0447\u0430\u043b\u0430\u00bb
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u0430\u043b\u044c\u0447\u0438\u043a
    \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b \u0441\u0430\u043c, \u0431\u0435\u0437
    \u0447\u044c\u0438\u0445-\u043b\u0438\u0431\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0439.\n\n\U0001F58B\ufe0f
    \u0418\u0437\u0432\u0438\u043d\u0435\u043d\u0438\u0435 \u0437\u0430 \u0434\u043b\u0438\u043d\u043d\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e (\u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u043b\u0430\u043a\u043e\u043d\u0438\u0447\u043d\u043e\u0441\u0442\u0438) \u0412 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0438 \u0440\u0438\u0442\u043e\u0440\u0438\u043a\u0438
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0444\u0440\u0430\u0437\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044f. \u0412 \u043e\u0434\u043d\u043e\u043c
    \u0438\u0437 \u0441\u0432\u043e\u0438\u0445 \u043f\u0438\u0441\u0435\u043c \u043e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \u00ab\u041f\u0440\u043e\u0441\u0442\u0438\u0442\u0435,
    \u0447\u0442\u043e \u043f\u0438\u0448\u0443 \u0432\u0430\u043c \u0442\u0430\u043a\u043e\u0435
    \u0434\u043b\u0438\u043d\u043d\u043e\u0435 \u043f\u0438\u0441\u044c\u043c\u043e, \u0443
    \u043c\u0435\u043d\u044f \u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0435\u00bb.
    \u042d\u0442\u043e\u0442 \u0430\u0444\u043e\u0440\u0438\u0437\u043c \u0441\u0442\u0430\u043b
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043a\u0440\u0430\u0442\u043a\u043e\u0441\u0442\u044c
    \u2014 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430.\n\n\U0001F4A1 \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439...
    \u0438 \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u043c
    \u0438\u0433\u0440\u0430\u043c \u041a\u0430\u043a \u044d\u0442\u043e \u043d\u0438 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u043e,
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0441\u0442\u0440\u043e\u0433\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0431\u044b\u043b
    \u0437\u0430\u043b\u043e\u0436\u0435\u043d \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044e \u0435\u0433\u043e \u0434\u0440\u0443\u0433\u0430,
    \u043a\u0430\u0432\u0430\u043b\u0435\u0440\u0430 \u0434\u0435 \u041c\u0435\u0440\u0435,
    \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u043c\u0438 \u0438\u0433\u0440\u0430\u043c\u0438
    \u0432 \u043a\u043e\u0441\u0442\u0438. \u0414\u0435 \u041c\u0435\u0440\u0435 \u0437\u0430\u0434\u0430\u043b
    \u041f\u0430\u0441\u043a\u0430\u043b\u044e \u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u0432\u044b\u0438\u0433\u0440\u044b\u0448
    \u043f\u0440\u0438 \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u043d\u043e\u0439 \u043f\u0430\u0440\u0442\u0438\u0438.
    \u0412 \u0445\u043e\u0434\u0435 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438 \u0441
    \u0424\u0435\u0440\u043c\u0430 \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043d\u0430\u0448\u0435\u043b
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0438
    \u043b\u0435\u0433\u043b\u043e \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u043d\u043e\u0432\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u0422\u0430\u043a \u0441\u0432\u0435\u0442\u0441\u043a\u043e\u0435
    \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0432\u0435\u043b\u0438\u043a\u043e\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044e.\n\n\U0001F68C \u0421\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c
    \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0430 \u0417\u0430 \u0433\u043e\u0434
    \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438, \u0432 1662 \u0433\u043e\u0434\u0443,
    \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0438\u0434\u0435\u044e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0430
    \u2014 \u00ab\u043a\u0430\u0440\u0435\u0442 \u0437\u0430 \u043f\u044f\u0442\u044c \u0441\u0443\u00bb
    (carrosses \u00e0 cinq sols). \u042d\u0442\u043e \u0431\u044b\u043b\u0438 \u043c\u043d\u043e\u0433\u043e\u043c\u0435\u0441\u0442\u043d\u044b\u0435
    \u043a\u0430\u0440\u0435\u0442\u044b, \u043a\u0443\u0440\u0441\u0438\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0435
    \u043f\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u043c
    \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u043c, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0430\u0432\u0442\u043e\u0431\u0443\u0441\u0430. \u041e\u043d \u0431\u044b\u043b \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0447\u0435\u043d\u044b\u043c, \u043d\u043e
    \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u043e\u043c, \u0434\u0443\u043c\u0430\u044e\u0449\u0438\u043c
    \u043e\u0431 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u0435 \u0433\u043e\u0440\u043e\u0436\u0430\u043d.\n\n\U0001FA7A
    \u0411\u043e\u043b\u0435\u0437\u043d\u044c, \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u043e
    \u0438 \u0434\u0432\u0435 \u043a\u043e\u0448\u043a\u0438 \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435
    \u041f\u0430\u0441\u043a\u0430\u043b\u044f \u0431\u044b\u043b\u043e \u043a\u0440\u0430\u0439\u043d\u0435
    \u0441\u043b\u0430\u0431\u044b\u043c \u0441 \u0441\u0430\u043c\u043e\u0433\u043e \u0434\u0435\u0442\u0441\u0442\u0432\u0430,
    \u0447\u0442\u043e \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e \u043e\u0434\u0438\u043d
    \u0436\u0443\u0442\u043a\u043e\u0432\u0430\u0442\u044b\u0439 \u044d\u043f\u0438\u0437\u043e\u0434.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u043c\u0443 \u0431\u044b\u043b \u0432\u0441\u0435\u0433\u043e
    \u0433\u043e\u0434, \u043e\u043d \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u043b,
    \u0438 \u0435\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0431\u044b\u043b\u043e
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c,
    \u0447\u0442\u043e \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0435 \u0437\u0430\u043f\u043e\u0434\u043e\u0437\u0440\u0438\u043b\u0438
    \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u043e. \u0421\u043e\u0441\u0435\u0434\u0438
    \u0443\u043a\u0430\u0437\u0430\u043b\u0438 \u043d\u0430 \u043f\u043e\u0436\u0438\u043b\u0443\u044e
    \u0436\u0435\u043d\u0449\u0438\u043d\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u0430
    \u043d\u0438\u043c \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u043b\u0430. \u041f\u043e\u0434
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0442\u0430 \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0430\u0441\u044c
    \u0432 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043f\u043e\u0440\u0447\u0438.
    \u0414\u043b\u044f \u00ab\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0430\u00bb \u0437\u0430\u043a\u043b\u044f\u0442\u0438\u044f
    \u043a \u0431\u043e\u043b\u044c\u043d\u043e\u043c\u0443 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0443
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0438 \u0434\u0432\u0443\u0445 \u0431\u0435\u0437\u0434\u043e\u043c\u043d\u044b\u0445
    \u043a\u043e\u0448\u0435\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0437\u0430\u0442\u0435\u043c,
    \u043f\u043e \u0441\u043e\u0432\u0435\u0442\u0443 \u0437\u043d\u0430\u0445\u0430\u0440\u0435\u0439,
    \u0432\u044b\u0431\u0440\u043e\u0441\u0438\u043b\u0438 \u0438\u0437 \u043e\u043a\u043d\u0430.
    \u0427\u0435\u0440\u0435\u0437 \u043d\u0435\u0434\u0435\u043b\u044e \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u043f\u043e\u0448\u0435\u043b \u043d\u0430 \u043f\u043e\u043f\u0440\u0430\u0432\u043a\u0443.
    \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e, \u044d\u0442\u043e\u0442 \u044d\u043f\u0438\u0437\u043e\u0434
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043b\u0438\u0448\u044c \u043c\u0440\u0430\u0447\u043d\u044b\u043c
    \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u0435\u043c \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e.\n\n\U0001F92F
    \u00ab\u041d\u043e\u0447\u044c \u043e\u0433\u043d\u044f\u00bb \u0438 \u0437\u0430\u043f\u0438\u0441\u043a\u0430
    \u0432 \u043f\u043e\u0434\u043a\u043b\u0430\u0434\u043a\u0435 \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442 \u0432 \u0436\u0438\u0437\u043d\u0438 \u041f\u0430\u0441\u043a\u0430\u043b\u044f
    \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043d\u043e\u0447\u044c \u0441
    23 \u043d\u0430 24 \u043d\u043e\u044f\u0431\u0440\u044f 1654 \u0433\u043e\u0434\u0430. \u041e\u043d
    \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043e\u043f\u0438\u0441\u0430\u043b \u043d\u0430 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c
    \u043a\u043b\u043e\u0447\u043a\u0435 \u043f\u0435\u0440\u0433\u0430\u043c\u0435\u043d\u0442\u0430,
    \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u043e\u043c \u00ab\u041c\u0435\u043c\u043e\u0440\u0438\u0430\u043b\u043e\u043c\u00bb.
    \u0422\u0435\u043a\u0441\u0442 \u043d\u0430\u0447\u0438\u043d\u0430\u043b\u0441\u044f \u0441\u043e
    \u0441\u043b\u043e\u0432\u0430 \u00ab\u041e\u0433\u043e\u043d\u044c\u00bb (Feu) \u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b
    \u0441\u0442\u0440\u043e\u043a\u0438 \u043e \u0411\u043e\u0433\u0435 \u0410\u0432\u0440\u0430\u0430\u043c\u0430
    \u0438 \u0418\u0430\u043a\u043e\u0432\u0430, \u0430 \u043d\u0435 \u00ab\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432
    \u0438 \u0443\u0447\u0435\u043d\u044b\u0445\u00bb. \u0414\u043e \u0441\u0430\u043c\u043e\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u041f\u0430\u0441\u043a\u0430\u043b\u044c \u043d\u043e\u0441\u0438\u043b
    \u044d\u0442\u0443 \u0437\u0430\u043f\u0438\u0441\u043a\u0443, \u0437\u0430\u0448\u0438\u0442\u043e\u0439
    \u0432 \u043f\u043e\u0434\u043a\u043b\u0430\u0434\u043a\u0443 \u0441\u0432\u043e\u0435\u0433\u043e
    \u043a\u0430\u043c\u0437\u043e\u043b\u0430.\n\n\U0001F4AC \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u00ab\u041f\u0430\u0440\u0438 \u041f\u0430\u0441\u043a\u0430\u043b\u044f\u00bb \u041e\u0434\u0438\u043d
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u043e\u0432
    \u2014 \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u0434\u043e\u0432\u043e\u0434
    \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u0432\u0435\u0440\u044b, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043a\u0430\u043a \u00ab\u041f\u0430\u0440\u0438 \u041f\u0430\u0441\u043a\u0430\u043b\u044f\u00bb.
    \u0421\u0443\u0442\u044c \u0435\u0433\u043e \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e
    \u043f\u0435\u0440\u0435\u0434 \u043b\u0438\u0446\u043e\u043c \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0435\u0435 \u00ab\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c\u00bb
    \u043d\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u0411\u043e\u0433\u0430, \u0442\u0430\u043a \u043a\u0430\u043a \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0439
    \u0432\u044b\u0438\u0433\u0440\u044b\u0448 (\u0432\u0435\u0447\u043d\u043e\u0435 \u0431\u043b\u0430\u0436\u0435\u043d\u0441\u0442\u0432\u043e)
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0432\u0435\u043b\u0438\u043a,
    \u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0439 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448
    (\u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0437\u0435\u043c\u043d\u044b\u0445 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0439)
    \u043a\u043e\u043d\u0435\u0447\u0435\u043d \u0438 \u043c\u0430\u043b.\n\n\u2699\ufe0f 50
    \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f\u043e\u0432 \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u0430
    \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u00ab\u041f\u0430\u0441\u043a\u0430\u043b\u0438\u043d\u044b\u00bb
    \u2014 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u0430
    \u0434\u043b\u044f \u043f\u043e\u043c\u043e\u0449\u0438 \u043e\u0442\u0446\u0443 \u0432
    \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0445 \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u0430\u0445
    \u2014 \u0437\u0430\u043d\u044f\u043b\u043e \u0443 \u043d\u0435\u0433\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0442. \u0427\u0442\u043e\u0431\u044b \u0434\u043e\u0432\u0435\u0441\u0442\u0438
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0434\u043e \u0443\u043c\u0430,
    \u043e\u043d \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u043e\u043a\u043e\u043b\u043e
    50 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f\u043e\u0432.\n\n\U0001F3C6
    \u041f\u043e\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c \u0432 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0435 \u0412 1658 \u0433\u043e\u0434\u0443 \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u043f\u043e\u0434 \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c\u043e\u043c \u043e\u0431\u044a\u044f\u0432\u0438\u043b
    \u043a\u043e\u043d\u043a\u0443\u0440\u0441 \u043d\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0441
    \u0446\u0438\u043a\u043b\u043e\u0438\u0434\u043e\u0439 (\u043a\u0440\u0438\u0432\u043e\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0442\u043e\u0447\u043a\u0430 \u043d\u0430 \u043a\u0430\u0442\u044f\u0449\u0435\u043c\u0441\u044f
    \u043a\u043e\u043b\u0435\u0441\u0435). \u041a\u043e\u0433\u0434\u0430 \u043f\u0440\u0438\u0448\u043b\u043e
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0439,
    \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043e\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u041f\u0430\u0441\u043a\u0430\u043b\u044c
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u0432\u043e\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u0438, \u0432\u044b\u0441\u0442\u0443\u043f\u0438\u0432
    \u0432 \u0440\u043e\u043b\u0438 \u0441\u0443\u0434\u044c\u0438, \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b
    \u043f\u043e\u0431\u0435\u0434\u0443 \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0435\u0431\u0435.
    \u0411\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439 \u0445\u043e\u0434, \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0449\u0438\u0439
    \u0438 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u044c,
    \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u044e\u043c\u043e\u0440\u0430. \u0412
    \u0436\u0438\u0437\u043d\u0438 \u044d\u0442\u043e\u0433\u043e \u0433\u0435\u043d\u0438\u044f
    \u043f\u0440\u0438\u0447\u0443\u0434\u043b\u0438\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u043b\u0438\u0441\u044c
    \u0434\u0435\u0442\u0441\u043a\u0430\u044f \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u0430\u0437\u0430\u0440\u0442, \u043c\u0438\u0441\u0442\u0438\u0446\u0438\u0437\u043c,
    \u0441\u0442\u0440\u043e\u0433\u0430\u044f \u043b\u043e\u0433\u0438\u043a\u0430 \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u043c\u0435\u043a\u0430\u043b\u043a\u0430. \u041d\u0430\u0434\u0435\u044e\u0441\u044c,
    \u044d\u0442\u0438 \u0434\u0435\u0442\u0430\u043b\u0438 \u043f\u043e\u043c\u043e\u0433\u043b\u0438
    \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0432 \u041f\u0430\u0441\u043a\u0430\u043b\u0435
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430,
    \u043d\u043e \u0438 \u0436\u0438\u0432\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u044f\u043c\u0438
    \u0438 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043c\u0438."
