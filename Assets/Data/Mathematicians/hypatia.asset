  fullNameRu: "\u0413\u0438\u043F\u0430\u0301\u0442\u0438\u044F \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0438\u0301\u0439\u0441\u043A\u0430\u044F"
