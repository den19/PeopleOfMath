  achievementsRu: "\u0425\u043e\u0442\u044f \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0413\u0438\u043f\u0430\u0442\u0438\u0438 \u043f\u043e\u0447\u0442\u0438
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0443\u0442\u0435\u0440\u044f\u043d\u044b,
    \u043c\u044b \u043c\u043e\u0436\u0435\u043c \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c
    \u043a\u0440\u0443\u0433 \u0435\u0451 \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432
    \u0438 \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443. \u0415\u0451
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0431\u044b\u043b\u0430 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u0430
    \u043d\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F4DA
    \u0413\u043b\u0430\u0432\u043d\u044b\u0435 \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0432\u0438\u0437\u0430\u043d\u0442\u0438\u0439\u0441\u043a\u043e\u0439
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0438 X \u0432\u0435\u043a\u0430
    \u00ab\u0421\u0443\u0434\u0430\u00bb, \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0431\u044b\u043b\u0430
    \u0430\u0432\u0442\u043e\u0440\u043e\u043c \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432
    \u043a \u0442\u0440\u0435\u043c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0440\u0430\u0431\u043e\u0442\u0430\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u0430\u043d\u043e\u043d: 1. \u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439
    \u043a \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435\u00bb \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e:
    \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0435\u0451 \u0441\u0430\u043c\u0430\u044f
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430. \u0422\u0440\u0443\u0434 \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u0431\u044b\u043b \u043f\u043e\u0441\u0432\u044f\u0449\u0451\u043d \u0440\u0435\u0448\u0435\u043d\u0438\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0438 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b.
    \u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u0413\u0438\u043f\u0430\u0442\u0438\u0438,
    \u0441\u043e\u0441\u0442\u043e\u044f\u0432\u0448\u0438\u0439 \u0438\u0437 13 \u043a\u043d\u0438\u0433,
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0441\u044f
    \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0432 \u0432\u0438\u0434\u0435 \u0432\u0441\u0442\u0430\u0432\u043e\u043a
    (\u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u0439) \u0432 \u0441\u0430\u043c
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442.
    2. \u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u043a \u00ab\u041a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u043c\u00bb \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f
    \u041f\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e: \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f \u0431\u044b\u043b\u0430 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0432\u0432\u043e\u0434\u0438\u043b\u0438\u0441\u044c
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u044d\u043b\u043b\u0438\u043f\u0441\u0430, \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b
    \u0438 \u0433\u0438\u043f\u0435\u0440\u0431\u043e\u043b\u044b. \u0413\u0438\u043f\u0430\u0442\u0438\u044f
    \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u044d\u0442\u043e\u0442 \u0441\u043b\u043e\u0436\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0431\u043e\u043b\u0435\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c
    \u0434\u043b\u044f \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f, \u0442\u0435\u043c
    \u0441\u0430\u043c\u044b\u043c \u0432\u043d\u0435\u0441\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0435\u0433\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435.
    3. \u00ab\u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u0430\u043d\u043e\u043d\u00bb: \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u044d\u0442\u043e \u0431\u044b\u043b \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439
    \u043a \u0442\u0440\u0435\u0442\u044c\u0435\u0439 \u043a\u043d\u0438\u0433\u0435 \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f\u00bb \u041a\u043b\u0430\u0432\u0434\u0438\u044f
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u043d\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f
    \u0447\u0430\u0441\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0435\u0451 \u043e\u0442\u0446\u0430.
    \u0422\u0430\u043a\u0436\u0435 \u0447\u0430\u0441\u0442\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u043e\u043d\u0430 \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0430 \u0441\u0432\u043e\u0435\u043c\u0443
    \u043e\u0442\u0446\u0443 \u0422\u0435\u043e\u043d\u0443 \u0432 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435
    \u0435\u0433\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u044f
    \u043a \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0443\u00bb \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f.\n\n\U0001F4A1
    \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f \u0438 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u0421 \u0413\u0438\u043f\u0430\u0442\u0438\u0435\u0439 \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0442
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0438\u043b\u0438 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0432\u0430\u0436\u043d\u044b\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432:
    \u0410\u0441\u0442\u0440\u043e\u043b\u044f\u0431\u0438\u044f: \u041f\u0440\u0438\u0431\u043e\u0440
    \u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f
    \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0445 \u0442\u0435\u043b. \u0425\u043e\u0442\u044f
    \u043e\u043d\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0435\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u0435\u043c,
    \u0435\u0451 \u0443\u0447\u0435\u043d\u0438\u043a \u0421\u0438\u043d\u0435\u0437\u0438\u0439
    \u043e\u0431\u0440\u0430\u0449\u0430\u043b\u0441\u044f \u043a \u043d\u0435\u0439 \u0437\u0430
    \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0432 \u0435\u0433\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0435\u0451 \u0432\u044b\u0441\u043e\u043a\u043e\u043c
    \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0435 \u0432 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0445 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432.
    \u041f\u043b\u0430\u043d\u0438\u0441\u0444\u0435\u0440\u0430: \u041f\u043b\u043e\u0441\u043a\u0430\u044f
    \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0430\u044f \u043a\u0430\u0440\u0442\u0430 \u043d\u0435\u0431\u0430.
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0430\u044f
    \u043f\u0440\u0438 \u0435\u0451 \u0443\u0447\u0430\u0441\u0442\u0438\u0438 \u043f\u043b\u0430\u043d\u0438\u0441\u0444\u0435\u0440\u0430
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e XVII \u0432\u0435\u043a\u0430 \u0438 \u0434\u0430\u0436\u0435 \u0431\u044b\u043b\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0443.
    \u0410\u0440\u0435\u043e\u043c\u0435\u0442\u0440 (\u0433\u0438\u0434\u0440\u043e\u0441\u043a\u043e\u043f):
    \u041f\u0440\u0438\u0431\u043e\u0440 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u0438 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439.
    \u0415\u0451 \u0443\u0447\u0435\u043d\u0438\u043a \u0421\u0438\u043d\u0435\u0437\u0438\u0439
    \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0441\u0438\u043b \u0435\u0451 \u043f\u043e\u043c\u043e\u0449\u0438
    \u0432 \u0435\u0433\u043e \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438.\n\n\U0001F9E0
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0430\u044f \u0438 \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0413\u043b\u0430\u0432\u043d\u044b\u043c
    \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u0438\u0435\u043c \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0445\u043e\u043b\u0430\u0440\u0445\u043e\u043c
    (\u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c) \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b, \u0433\u0434\u0435 \u0447\u0438\u0442\u0430\u043b\u0430
    \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    (\u041f\u043b\u0430\u0442\u043e\u043d \u0438 \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044c),
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    \u0415\u0451 \u0448\u043a\u043e\u043b\u0430 \u0431\u044b\u043b\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0430
    \u0442\u0435\u043c, \u0447\u0442\u043e \u0432 \u043d\u0435\u0439 \u043e\u0431\u0443\u0447\u0430\u043b\u0438\u0441\u044c
    \u043a\u0430\u043a \u044f\u0437\u044b\u0447\u043d\u0438\u043a\u0438, \u0442\u0430\u043a
    \u0438 \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0435, \u0438 \u043e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0437\u043e\u043d\u043e\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0439 \u0442\u0435\u0440\u043f\u0438\u043c\u043e\u0441\u0442\u0438.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0443\u0447\u0451\u043d\u044b\u043c, \u043d\u043e \u0438 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0434\u0435\u044f\u0442\u0435\u043b\u0435\u043c,
    \u0447\u044c\u0438\u043c \u043c\u043d\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0440\u043e\u0436\u0438\u043b\u0438
    \u043f\u0435\u0440\u0432\u044b\u0435 \u043b\u0438\u0446\u0430 \u0433\u043e\u0440\u043e\u0434\u0430.
    \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0413\u0438\u043f\u0430\u0442\u0438\u0438 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f
    \u043d\u0435 \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u043d\u043e\u0432\u044b\u0445
    \u0442\u0435\u043e\u0440\u0438\u0439, \u0430 \u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438
    \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0435 \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u043e\u0433\u043e
    \u043f\u043b\u0430\u0441\u0442\u0430 \u0437\u043d\u0430\u043d\u0438\u0439. \u041e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u043c\u0430\u044f\u043a\u043e\u043c
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u043d\u0430\u0443\u043a\u0438 \u0438 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c\u0430,
    \u0438 \u0435\u0451 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0438\u0431\u0435\u043b\u044c
    \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u043a\u043e\u043d\u0446\u0430
    \u0446\u0435\u043b\u043e\u0439 \u044d\u043f\u043e\u0445\u0438."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c, \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u043f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0435 \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u043f\u043e\u043b\u043d\u0430\u044f
    \u0431\u0435\u043b\u044b\u0445 \u043f\u044f\u0442\u0435\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u043f\u044b\u0442\u0430\u044e\u0442\u0441\u044f
    \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u043f\u043e \u043a\u0440\u0443\u043f\u0438\u0446\u0430\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0434\u0430\u0436\u0435 \u0442\u043e \u043d\u0435\u043c\u043d\u043e\u0433\u043e\u0435,
    \u0447\u0442\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0440\u0438\u0441\u0443\u0435\u0442
    \u043e\u0431\u0440\u0430\u0437 \u043d\u0435\u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u044b, \u0436\u0438\u0432\u0448\u0435\u0439 \u043d\u0430
    \u0441\u0442\u044b\u043a\u0435 \u044d\u043f\u043e\u0445.\n\n\U0001F476 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0441\u0435\u043c\u044c\u044f \u0422\u043e\u0447\u043d\u0430\u044f \u0434\u0430\u0442\u0430
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430, \u0438 \u044d\u0442\u043e
    \u043e\u0434\u043d\u0430 \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0437\u0430\u0433\u0430\u0434\u043e\u043a
    \u0435\u0451 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0443\u0447\u0451\u043d\u044b\u0445
    \u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432\u043e \u043c\u043d\u0435\u043d\u0438\u0438,
    \u0447\u0442\u043e \u043e\u043d\u0430 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u0432
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439
    \u0432 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043a\u0435 \u043c\u0435\u0436\u0434\u0443
    355 \u0438 370 \u0433\u043e\u0434\u0430\u043c\u0438 \u043d\u0430\u0448\u0435\u0439 \u044d\u0440\u044b.
    \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0440\u0430\u0437\u043d\u044b\u0435 \u0434\u0430\u0442\u044b: \u043e\u0434\u043d\u0438
    \u0441\u043a\u043b\u043e\u043d\u044f\u044e\u0442\u0441\u044f \u043a 370 \u0433\u043e\u0434\u0443,
    \u0434\u0440\u0443\u0433\u0438\u0435, \u043a\u0430\u043a \u041c\u0430\u0440\u0438\u044f
    \u0414\u0437\u0435\u043b\u044c\u0441\u043a\u0430, \u2014 \u043a 355 \u0433\u043e\u0434\u0443.
    \u0415\u0451 \u043e\u0442\u0446\u043e\u043c \u0431\u044b\u043b \u0422\u0435\u043e\u043d
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0438\u0439
    \u2014 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a,
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0430. \u0422\u0435\u043e\u043d \u0434\u0430\u043b
    \u0434\u043e\u0447\u0435\u0440\u0438 \u0438\u043c\u044f \u00ab\u0413\u0438\u043f\u0430\u0442\u0438\u044f\u00bb,
    \u0447\u0442\u043e \u0432 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0435 \u0441 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u0432\u044b\u0441\u0448\u0430\u044f\u00bb,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0435\u0433\u043e
    \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043d\u0430\u0434\u0435\u0436\u0434\u0430\u0445
    \u043d\u0430 \u043d\u0435\u0451. \u0418\u043c\u044f \u0435\u0451 \u043c\u0430\u0442\u0435\u0440\u0438,
    \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043b\u0438\u0448\u044c \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435,
    \u0447\u0442\u043e \u043e\u043d\u0430 \u0443\u043c\u0435\u0440\u043b\u0430 \u043f\u0440\u0438
    \u0440\u043e\u0434\u0430\u0445 \u0438\u043b\u0438 \u043a\u043e\u0433\u0434\u0430 \u0413\u0438\u043f\u0430\u0442\u0438\u044f
    \u0431\u044b\u043b\u0430 \u0435\u0449\u0451 \u0441\u043e\u0432\u0441\u0435\u043c \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439.
    \u0422\u0430\u043a\u0436\u0435 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u0431\u0440\u0430\u0442\u044c\u044f\u0445
    \u0438 \u0441\u0451\u0441\u0442\u0440\u0430\u0445 \u0413\u0438\u043f\u0430\u0442\u0438\u0438.\n\n\U0001F4D6
    \u0423\u0447\u0451\u0431\u0430 \u0438 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u043a\u0430\u043a \u0443\u0447\u0451\u043d\u043e\u0433\u043e \u0412\u0441\u0451 \u0441\u0432\u043e\u0451
    \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u043e\u0442\u0446\u0430. \u0422\u0435\u043e\u043d \u043e\u0431\u0443\u0447\u0438\u043b
    \u0435\u0451 \u0432 \u0434\u0443\u0445\u0435 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0430\u0439\u0434\u0435\u0439\u0438
    \u2014 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u043a\u043b\u044e\u0447\u0430\u043b\u0430
    \u0432 \u0441\u0435\u0431\u044f \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e,
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443, \u043d\u0430\u0443\u043a\u0443,
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e \u0438 \u0440\u0438\u0442\u043e\u0440\u0438\u043a\u0443.
    \u0410\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0443\u0447\u0451\u0431\u044b: \u041e\u0431\u0443\u0447\u0435\u043d\u0438\u0435,
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b\u043e
    \u0432 \u0441\u0442\u0435\u043d\u0430\u0445 \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0430,
    \u0433\u0434\u0435 \u0422\u0435\u043e\u043d, \u0431\u0443\u0434\u0443\u0447\u0438 \u0435\u0433\u043e
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c, \u0438\u043c\u0435\u043b
    \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0431\u043e\u0433\u0430\u0442\u0435\u0439\u0448\u0438\u043c
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430\u043c.
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u0432\u043f\u0438\u0442\u0430\u043b\u0430 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u043d\u0430\u0443\u043a\u0438 \u0438 \u043e\u0431\u0449\u0430\u043b\u0430\u0441\u044c
    \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438 \u0443\u043c\u0430\u043c\u0438 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0440\u0438\u043c\u0441\u043a\u0438\u0445,
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f: \u0422\u0435\u043e\u043d
    \u0434\u0430\u043b \u0413\u0438\u043f\u0430\u0442\u0438\u0438 \u043e\u0431\u0448\u0438\u0440\u043d\u043e\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435,
    \u0438 \u043e\u043d\u0430 \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u0440\u0435\u0432\u0437\u043e\u0448\u043b\u0430
    \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f, \u0447\u0442\u043e
    \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442 \u0434\u0430\u0436\u0435 \u0432\u0438\u0437\u0430\u043d\u0442\u0438\u0439\u0441\u043a\u0438\u0439
    \u0441\u043b\u043e\u0432\u0430\u0440\u044c \u00ab\u0421\u0443\u0434\u0430\u00bb. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043a\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u0431\u0443\u0447\u0438\u043b
    \u0435\u0451 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u043d\u0435\u043e\u043f\u043b\u0430\u0442\u043e\u043d\u0438\u0437\u043c\u0430
    \u2014 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0437\u0430\u0433\u0430\u0434\u043a\u043e\u0439.
    \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442, \u0447\u0442\u043e \u044d\u0442\u043e
    \u0431\u044b\u043b \u043d\u0435 \u0435\u0451 \u043e\u0442\u0435\u0446, \u0430 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e
    \u0434\u0440\u0443\u0433\u043e\u0439, \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u043d\u0430\u043c \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a. \u041b\u0435\u0433\u0435\u043d\u0434\u044b
    \u043e\u0431 \u0443\u0447\u0451\u0431\u0435: \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043d\u0435\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u043e\u0435
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u0432 \u0441\u043b\u043e\u0432\u0430\u0440\u0435
    \u00ab\u0421\u0443\u0434\u0430\u00bb \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0413\u0438\u043f\u0430\u0442\u0438\u044f
    \u0443\u0447\u0438\u043b\u0430\u0441\u044c \u0432 \u0410\u0444\u0438\u043d\u0430\u0445,
    \u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432
    \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u044e\u0442 \u044d\u0442\u0443 \u0432\u0435\u0440\u0441\u0438\u044e,
    \u0441\u0447\u0438\u0442\u0430\u044f \u0435\u0451 \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e\u0439.\n\n\U0001F4BC
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041a\u0430\u0440\u044c\u0435\u0440\u0430 \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 400 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0435\u0451 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438
    \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438 \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443. \u041e\u043d\u0430 \u0437\u0430\u043d\u044f\u043b\u0430
    \u043e\u0434\u043d\u0443 \u0438\u0437 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043a\u0430\u0444\u0435\u0434\u0440
    \u2014 \u043a\u0430\u0444\u0435\u0434\u0440\u0443 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435: \u0415\u0451 \u043b\u0435\u043a\u0446\u0438\u0438
    \u0431\u044b\u043b\u0438 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u044b \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u041f\u043b\u0430\u0442\u043e\u043d\u0430 \u0438 \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044f,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438. \u041e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c,
    \u0430 \u0441\u0445\u043e\u043b\u0430\u0440\u0445\u043e\u043c (\u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c)
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u044b,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043b\u0430\u0432\u0438\u043b\u0430\u0441\u044c
    \u0441\u0432\u043e\u0435\u0439 \u0432\u0435\u0440\u043e\u0442\u0435\u0440\u043f\u0438\u043c\u043e\u0441\u0442\u044c\u044e:
    \u0441\u0440\u0435\u0434\u0438 \u0435\u0451 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0431\u044b\u043b\u0438 \u043a\u0430\u043a \u044f\u0437\u044b\u0447\u043d\u0438\u043a\u0438,
    \u0442\u0430\u043a \u0438 \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0435, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u0430
    \u041f\u0442\u043e\u043b\u0435\u043c\u0430\u0438\u0434\u044b \u0421\u0438\u043d\u0435\u0437\u0438\u044f.
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430: \u041e\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u043c,
    \u043d\u043e \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0443\u0447\u0451\u043d\u044b\u043c.
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u043e\u0442\u0446\u043e\u043c \u043e\u043d\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u043d\u0430\u0434 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u044f\u043c\u0438
    \u043a \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u0443\u00bb \u041a\u043b\u0430\u0432\u0434\u0438\u044f
    \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f. \u0422\u0430\u043a\u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043b\u0430 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438
    \u043a \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0442\u0440\u0443\u0434\u0430\u043c \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430 \u0438
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f \u041f\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e,
    \u0445\u043e\u0442\u044f \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044b \u044d\u0442\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c.\n\n\U0001F494
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0412 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u043c
    \u043c\u0438\u0440\u0435, \u0433\u0434\u0435 \u0436\u0435\u043d\u0449\u0438\u043d\u044b
    \u0438\u0437 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0441\u0435\u043c\u0435\u0439
    \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0438\u043b\u0438 \u0437\u0430\u043c\u0443\u0436
    \u0434\u043b\u044f \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u044f \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0432\u044f\u0437\u0435\u0439, \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u043f\u043e\u0448\u043b\u0430
    \u0438\u043d\u044b\u043c \u043f\u0443\u0442\u0451\u043c. \u0412\u0441\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f
    \u043d\u0430 \u0442\u043e\u043c, \u0447\u0442\u043e \u0413\u0438\u043f\u0430\u0442\u0438\u044f
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0437\u0430\u043c\u0443\u0436\u0435\u043c
    \u0438 \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b\u0430 \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c
    \u043d\u0430\u0443\u043a\u0435. \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u0422\u0435\u043e\u043d, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u0438 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b
    \u0431\u0440\u0430\u043a\u0430 \u0434\u043b\u044f \u0434\u043e\u0447\u0435\u0440\u0438,
    \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c
    \u0441\u0432\u043e\u044e \u0448\u043a\u043e\u043b\u0443, \u043d\u043e \u0413\u0438\u043f\u0430\u0442\u0438\u044f
    \u043e\u0442\u0434\u0430\u043b\u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u0435
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c.
    \u0415\u0451 \u0436\u0438\u0437\u043d\u044c, \u043f\u043e\u043b\u043d\u0430\u044f \u0441\u0430\u043c\u043e\u043e\u0442\u0432\u0435\u0440\u0436\u0435\u043d\u043d\u043e\u0433\u043e
    \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f \u0437\u043d\u0430\u043d\u0438\u044e \u0438
    \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0434\u043b\u044f
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u044b,
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0431\u043e\u0440\u0432\u0430\u043b\u0430\u0441\u044c
    \u0432 \u043c\u0430\u0440\u0442\u0435 415 \u0433\u043e\u0434\u0430, \u0441\u0442\u0430\u0432
    \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u0433\u0438\u0431\u0435\u043b\u0438 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438."
  personalLifeEn: 
  shortBioRu: "\u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0430\u044f
    \u2014 \u0444\u0438\u0433\u0443\u0440\u0430, \u0441\u0442\u043e\u044f\u0449\u0430\u044f
    \u043d\u0430 \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u0435 \u044d\u043f\u043e\u0445.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0443\u0447\u0451\u043d\u044b\u043c, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c
    \u0438 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u043e\u043c, \u0447\u044c\u044f \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0438\u0431\u0435\u043b\u044c \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u043c\u0435\u0436\u0434\u0443 \u0443\u0445\u043e\u0434\u044f\u0449\u0438\u043c
    \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u043c \u0437\u043d\u0430\u043d\u0438\u0435\u043c
    \u0438 \u043d\u0430\u0440\u043e\u0436\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u043c
    \u0434\u043e\u0433\u043c\u0430\u0442\u0438\u0437\u043c\u043e\u043c. \u042f \u043f\u043e\u0441\u0442\u0430\u0440\u0430\u043b\u0441\u044f
    \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u0434\u043b\u044f \u0432\u0430\u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0443\u044e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e,
    \u043e\u043f\u0438\u0440\u0430\u044f\u0441\u044c \u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438.\n\n\U0001F4DC
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043c\u0435\u0436\u0434\u0443 355 \u0438 370 \u0433\u043e\u0434\u0430\u043c\u0438 \u043d\u0430\u0448\u0435\u0439
    \u044d\u0440\u044b. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0422\u0435\u043e\u043d\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u041c\u0443\u0441\u0435\u0439\u043e\u043d\u0430 \u2014 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u0446\u0435\u043d\u0442\u0440\u0430 \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u0421\u0432\u043e\u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0437\u043d\u0430\u043d\u0438\u044f
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u0413\u0438\u043f\u0430\u0442\u0438\u044f
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u043e\u0442 \u043e\u0442\u0446\u0430.
    \u0422\u0435\u043e\u043d, \u0432\u0438\u0434\u044f \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0434\u043e\u0447\u0435\u0440\u0438,
    \u0434\u0430\u043b \u0435\u0439 \u0438\u043c\u044f, \u043e\u0437\u043d\u0430\u0447\u0430\u044e\u0449\u0435\u0435
    \u00ab\u0432\u044b\u0441\u0448\u0430\u044f\u00bb, \u0438 \u0434\u0430\u043b \u0432\u0441\u0435\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0432\u043a\u043b\u044e\u0447\u0430\u043b\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u043e\u0447\u043d\u044b\u0435 \u043d\u0430\u0443\u043a\u0438, \u043d\u043e \u0438
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e, \u0438 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443.
    \u0418\u043c\u044f \u0435\u0451 \u043c\u0430\u0442\u0435\u0440\u0438 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e.
    \u0410\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438:
    \u0413\u043e\u0440\u043e\u0434 \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0431\u044b\u043b
    \u043f\u043b\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u043c \u043a\u043e\u0442\u043b\u043e\u043c
    \u043a\u0443\u043b\u044c\u0442\u0443\u0440 \u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u0439.
    \u0412 391 \u0433\u043e\u0434\u0443, \u0435\u0449\u0451 \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438
    \u043e\u0442\u0446\u0430 \u0413\u0438\u043f\u0430\u0442\u0438\u0438, \u043f\u043e \u043f\u0440\u0438\u043a\u0430\u0437\u0443
    \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u0430 \u0424\u0435\u043e\u0444\u0438\u043b\u0430
    \u0431\u044b\u043b \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d \u0421\u0435\u0440\u0430\u043f\u0435\u0443\u043c
    \u2014 \u0432\u0430\u0436\u043d\u044b\u0439 \u044f\u0437\u044b\u0447\u0435\u0441\u043a\u0438\u0439
    \u0445\u0440\u0430\u043c \u0438 \u0444\u0438\u043b\u0438\u0430\u043b \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438. \u042d\u0442\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u0435,
    \u043f\u043e\u0442\u0440\u044f\u0441\u0448\u0435\u0435 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e
    \u044d\u043b\u0438\u0442\u0443, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u043e\u043a\u0430\u0437\u0430\u043b\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u0438
    \u043d\u0430 \u0413\u0438\u043f\u0430\u0442\u0438\u044e.\n\n\U0001F9E0 \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430,
    \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0441 405 \u0433\u043e\u0434\u0430, \u0413\u0438\u043f\u0430\u0442\u0438\u044f
    \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0430 \u0435\u0433\u043e
    \u0448\u043a\u043e\u043b\u0443 \u0438 \u0441\u0442\u0430\u043b\u0430 \u0435\u0451 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c
    (\u0441\u0445\u043e\u043b\u0430\u0440\u0445\u043e\u043c). \u041e\u043d\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b\u0430
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u043d\u0435\u043e\u043f\u043b\u0430\u0442\u043e\u043d\u0438\u0437\u043c\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u043d\u0430 \u0432\u0435\u0441\u044c \u0433\u0440\u0435\u043a\u043e-\u0440\u0438\u043c\u0441\u043a\u0438\u0439
    \u043c\u0438\u0440. \u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435:
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0447\u0438\u0442\u0430\u043b\u0430 \u043b\u0435\u043a\u0446\u0438\u0438
    \u043f\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u041f\u043b\u0430\u0442\u043e\u043d\u0430 \u0438 \u0410\u0440\u0438\u0441\u0442\u043e\u0442\u0435\u043b\u044f),
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    \u0415\u0451 \u0448\u043a\u043e\u043b\u0430 \u0431\u044b\u043b\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0430
    \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u2014 \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u043e\u043d\u043e\u0439 \u0432\u0435\u0440\u043e\u0442\u0435\u0440\u043f\u0438\u043c\u043e\u0441\u0442\u0438.
    \u0421\u0440\u0435\u0434\u0438 \u0435\u0451 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432
    \u0431\u044b\u043b\u0438 \u043a\u0430\u043a \u044f\u0437\u044b\u0447\u043d\u0438\u043a\u0438,
    \u0442\u0430\u043a \u0438 \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u044a\u0435\u0437\u0436\u0430\u043b\u0438\u0441\u044c \u043a \u043d\u0435\u0439 \u0441\u043e
    \u0432\u0441\u0435\u0433\u043e \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e\u043c\u043e\u0440\u044c\u044f.
    \u0421\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0443\u0447\u0435\u043d\u0438\u043a:
    \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u044f\u0440\u043a\u0438\u043c \u0438\u0437
    \u0435\u0451 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 \u0431\u044b\u043b \u0421\u0438\u043d\u0435\u0437\u0438\u0439
    \u041a\u0438\u0440\u0435\u043d\u0441\u043a\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u043e\u043c
    \u041f\u0442\u043e\u043b\u0435\u043c\u0430\u0438\u0434\u044b. \u0421\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    7 \u0435\u0433\u043e \u043f\u0438\u0441\u0435\u043c \u043a \u0413\u0438\u043f\u0430\u0442\u0438\u0438,
    \u043f\u043e\u043b\u043d\u044b\u0445 \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u0438\u044f
    \u0438 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u044f \u043a \u0435\u0451 \u0443\u0447\u0451\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u0438. \u0412 \u043d\u0438\u0445 \u043e\u043d
    \u043f\u0440\u043e\u0441\u0438\u043b \u0443 \u043d\u0435\u0451 \u0441\u043e\u0432\u0435\u0442\u0430
    \u043f\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0438 \u0434\u0430\u0436\u0435
    \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u0438\u043c \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c.
    \u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435:
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u043c
    \u0432 \u0433\u043e\u0440\u043e\u0434\u0435. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u0431\u043b\u0438\u0437\u043a\u0430 \u043a \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u0443
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438 \u041e\u0440\u0435\u0441\u0442\u0443
    \u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u0435\u0440\u0432\u044b\u043c \u043b\u0438\u0446\u0430\u043c,
    \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044f \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043c\u0443\u043d\u0438\u0446\u0438\u043f\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435.\n\n\U0001F4DA \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u043d\u0438 \u043e\u0434\u043d\u043e \u0438\u0437 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u0439 \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c. \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f
    \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0435\u0451 \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0438\u0437 \u0432\u0438\u0437\u0430\u043d\u0442\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u0441\u043b\u043e\u0432\u0430\u0440\u044f X \u0432\u0435\u043a\u0430 \u00ab\u0421\u0443\u0434\u0430\u00bb
    \u0438 \u0442\u0440\u0443\u0434\u043e\u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432.
    \u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438: \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d\u0430 \u043d\u0430\u043f\u0438\u0441\u0430\u043b\u0430 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435
    \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438 \u043a \u0442\u0440\u0443\u0434\u0430\u043c
    \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432:
    \u00ab\u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430\u00bb \u0414\u0438\u043e\u0444\u0430\u043d\u0442\u0430
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0433\u043e:
    \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0435\u0451 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438
    \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c
    \u043a\u0430\u043a \u0432\u0441\u0442\u0430\u0432\u043a\u0438 \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0435\u043a\u0441\u0442. \u00ab\u041a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u00bb \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f
    \u041f\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e. \u00ab\u0410\u043b\u044c\u043c\u0430\u0433\u0435\u0441\u0442\u00bb
    \u041a\u043b\u0430\u0432\u0434\u0438\u044f \u041f\u0442\u043e\u043b\u0435\u043c\u0435\u044f:
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043d\u0430
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0430 \u043e\u0442\u0446\u0443 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043d\u0430\u0434 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u044f\u043c\u0438
    \u043a \u044d\u0442\u043e\u043c\u0443 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0442\u0440\u0443\u0434\u0443. \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f:
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u0435
    \u043c\u043d\u0435\u043d\u0438\u0435, \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u043d\u0435
    \u0438\u0437\u043e\u0431\u0440\u0435\u043b\u0430 \u0430\u0441\u0442\u0440\u043e\u043b\u044f\u0431\u0438\u044e
    \u0438 \u0430\u0440\u0435\u043e\u043c\u0435\u0442\u0440 (\u043f\u0440\u0438\u0431\u043e\u0440\u044b
    \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u0438
    \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439), \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0431\u044b\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u0438 \u0434\u043e
    \u043d\u0435\u0451. \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u043d\u0430, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b\u0430 \u0438
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0438\u0445, \u043e \u0447\u0451\u043c \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043f\u0440\u043e\u0441\u044c\u0431\u0430 \u0435\u0451 \u0443\u0447\u0435\u043d\u0438\u043a\u0430
    \u0421\u0438\u043d\u0435\u0437\u0438\u044f \u043f\u043e\u043c\u043e\u0447\u044c \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u044d\u0442\u0438\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432.
    \u0421\u043e\u0437\u0434\u0430\u043d\u043d\u0430\u044f \u043f\u0440\u0438 \u0435\u0451 \u0443\u0447\u0430\u0441\u0442\u0438\u0438
    \u043f\u043b\u0430\u043d\u0438\u0441\u0444\u0435\u0440\u0430 (\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0430\u044f
    \u043a\u0430\u0440\u0442\u0430 \u043d\u0435\u0431\u0430) \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u0434\u043e XVII \u0432\u0435\u043a\u0430.\n\n\u2694\ufe0f \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0438\u0431\u0435\u043b\u044c
    \u0413\u0438\u0431\u0435\u043b\u044c \u0413\u0438\u043f\u0430\u0442\u0438\u0438 \u0432 \u043c\u0430\u0440\u0442\u0435
    415 \u0433\u043e\u0434\u0430 \u0441\u0442\u0430\u043b\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c
    \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u043e-\u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0433\u043e
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438.
    \u041a\u0438\u0440\u0438\u043b\u043b \u0438 \u041e\u0440\u0435\u0441\u0442: \u0412 412 \u0433\u043e\u0434\u0443
    \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u043e\u043c \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438
    \u0441\u0442\u0430\u043b \u041a\u0438\u0440\u0438\u043b\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0451\u043d\u043d\u0443\u044e
    \u0431\u043e\u0440\u044c\u0431\u0443 \u0437\u0430 \u0432\u043b\u0430\u0441\u0442\u044c \u0441
    \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u043e\u043c \u041e\u0440\u0435\u0441\u0442\u043e\u043c.
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f, \u0431\u0443\u0434\u0443\u0447\u0438 \u0434\u0440\u0443\u0433\u043e\u043c
    \u0438 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c \u041e\u0440\u0435\u0441\u0442\u0430,
    \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f.
    \u041e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044f \u0438 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e:
    \u0412\u0440\u0430\u0433\u0438 \u0413\u0438\u043f\u0430\u0442\u0438\u0438 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0438\u043b\u0438
    \u0441\u043b\u0443\u0445\u0438, \u0447\u0442\u043e \u043e\u043d\u0430 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f
    \u0447\u0451\u0440\u043d\u043e\u0439 \u043c\u0430\u0433\u0438\u0435\u0439 \u0438 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u043f\u0440\u0438\u043c\u0438\u0440\u0435\u043d\u0438\u044e \u041a\u0438\u0440\u0438\u043b\u043b\u0430
    \u0438 \u041e\u0440\u0435\u0441\u0442\u0430. \u0422\u043e\u043b\u043f\u0430 \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0441\u043a\u0438\u0445
    \u0444\u0430\u043d\u0430\u0442\u0438\u043a\u043e\u0432 (\u043f\u0430\u0440\u0430\u0431\u043e\u043b\u0430\u043d\u043e\u0432)
    \u0432\u043e \u0433\u043b\u0430\u0432\u0435 \u0441 \u0447\u0442\u0435\u0446\u043e\u043c
    \u041f\u0435\u0442\u0440\u043e\u043c \u043d\u0430\u043f\u0430\u043b\u0430 \u043d\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0432\u0448\u0443\u044e\u0441\u044f
    \u0434\u043e\u043c\u043e\u0439 \u0413\u0438\u043f\u0430\u0442\u0438\u044e. \u0416\u0435\u0441\u0442\u043e\u043a\u043e\u0441\u0442\u044c:
    \u0415\u0451 \u0432\u044b\u0442\u0430\u0449\u0438\u043b\u0438 \u0438\u0437 \u043f\u0430\u043b\u0430\u043d\u043a\u0438\u043d\u0430,
    \u0437\u0430\u0442\u0430\u0449\u0438\u043b\u0438 \u0432 \u0446\u0435\u0440\u043a\u043e\u0432\u044c,
    \u0441\u043e\u0440\u0432\u0430\u043b\u0438 \u043e\u0434\u0435\u0436\u0434\u0443 \u0438 \u0437\u0432\u0435\u0440\u0441\u043a\u0438
    \u0443\u0431\u0438\u043b\u0438, \u0441\u0434\u0438\u0440\u0430\u044f \u043f\u043b\u043e\u0442\u044c
    \u0441 \u043a\u043e\u0441\u0442\u0435\u0439 \u043e\u0441\u0442\u0440\u044b\u043c\u0438 \u0447\u0435\u0440\u0435\u043f\u043a\u0430\u043c\u0438.
    \u0422\u0435\u043b\u043e \u0431\u044b\u043b\u043e \u0440\u0430\u0441\u0447\u043b\u0435\u043d\u0435\u043d\u043e
    \u0438 \u0441\u043e\u0436\u0436\u0435\u043d\u043e. \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f:
    \u0423\u0431\u0438\u0439\u0441\u0442\u0432\u043e \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u043e
    \u0438\u043c\u043f\u0435\u0440\u0438\u044e. \u0421 \u0433\u0438\u0431\u0435\u043b\u044c\u044e
    \u0413\u0438\u043f\u0430\u0442\u0438\u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0443\u0447\u0451\u043d\u044b\u0435
    \u043f\u043e\u043a\u0438\u043d\u0443\u043b\u0438 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u044e,
    \u0447\u0442\u043e \u043e\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043b\u043e
    \u043d\u0430\u0447\u0430\u043b\u043e \u0443\u043f\u0430\u0434\u043a\u0430 \u0433\u043e\u0440\u043e\u0434\u0430
    \u043a\u0430\u043a \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0446\u0435\u043d\u0442\u0440\u0430. \u0415\u043f\u0438\u0441\u043a\u043e\u043f \u041a\u0438\u0440\u0438\u043b\u043b,
    \u043f\u0440\u044f\u043c\u043e \u0438\u043b\u0438 \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u043e
    \u043f\u0440\u0438\u0447\u0430\u0441\u0442\u043d\u044b\u0439 \u043a \u044d\u0442\u043e\u0439
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438, \u043f\u043e\u0437\u0436\u0435 \u0431\u044b\u043b
    \u043a\u0430\u043d\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0441\u043a\u043e\u0439
    \u0446\u0435\u0440\u043a\u043e\u0432\u044c\u044e.\n\n\U0001F31F \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0438 \u043f\u0430\u043c\u044f\u0442\u044c \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0441\u0442\u0430\u043b\u0430
    \u043b\u0435\u0433\u0435\u043d\u0434\u043e\u0439. \u0412 \u044d\u043f\u043e\u0445\u0443
    \u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0435\u0451 \u043e\u0431\u0440\u0430\u0437
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u043a\u0430\u043a
    \u0441\u0438\u043c\u0432\u043e\u043b \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u043c
    \u0444\u0430\u043d\u0430\u0442\u0438\u0437\u043c\u043e\u043c. \u0415\u0451 \u0436\u0438\u0437\u043d\u0438
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u044b \u043a\u043d\u0438\u0433\u0438, \u043a\u0430\u0440\u0442\u0438\u043d\u044b
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0430 \u0444\u0440\u0435\u0441\u043a\u0435
    \u0420\u0430\u0444\u0430\u044d\u043b\u044f \u00ab\u0410\u0444\u0438\u043d\u0441\u043a\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430\u00bb), \u0441\u043a\u0443\u043b\u044c\u043f\u0442\u0443\u0440\u044b
    \u0438 \u0445\u0443\u0434\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0444\u0438\u043b\u044c\u043c \u00ab\u0410\u0433\u043e\u0440\u0430\u00bb (2009) \u0441
    \u0420\u044d\u0439\u0447\u0435\u043b \u0412\u0430\u0439\u0441 \u0432 \u0433\u043b\u0430\u0432\u043d\u043e\u0439
    \u0440\u043e\u043b\u0438. \u0418\u043c\u0435\u043d\u0435\u043c \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430
    \u041b\u0443\u043d\u0435 \u0438 \u0430\u0441\u0442\u0435\u0440\u043e\u0438\u0434. \u0413\u0438\u043f\u0430\u0442\u0438\u044f
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u00ab\u043f\u0435\u0440\u0432\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c\u00bb.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u043e\u043f\u043b\u043e\u0449\u0435\u043d\u0438\u0435\u043c
    \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c\u0430
    \u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u044b \u043c\u044b\u0441\u043b\u0438, \u0438
    \u0435\u0451 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0443\u0434\u044c\u0431\u0430
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0441\u043b\u0443\u0436\u0438\u0442
    \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435\u043c \u043e \u0445\u0440\u0443\u043f\u043a\u043e\u0441\u0442\u0438
    \u0437\u043d\u0430\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434 \u043b\u0438\u0446\u043e\u043c
    \u043d\u0435\u0442\u0435\u0440\u043f\u0438\u043c\u043e\u0441\u0442\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0430\u044f
    \u2014 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c, \u0432\u043e\u043a\u0440\u0443\u0433
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0437\u0430 16 \u0432\u0435\u043a\u043e\u0432
    \u0441\u043b\u043e\u0436\u0438\u043b\u043e\u0441\u044c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439,
    \u043a\u0443\u0440\u044c\u0451\u0437\u043e\u0432 \u0438 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0445
    \u043c\u0438\u0444\u043e\u0432. \u0415\u0451 \u0436\u0438\u0437\u043d\u044c \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0443\u0434\u044c\u0431\u0430 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0438 \u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0433\u0435\u043d\u0434, \u0447\u0442\u043e \u043f\u043e\u0440\u043e\u0439
    \u043e\u0442\u0434\u0435\u043b\u0438\u0442\u044c \u0444\u0430\u043a\u0442\u044b \u043e\u0442
    \u0432\u044b\u043c\u044b\u0441\u043b\u0430 \u043e\u0447\u0435\u043d\u044c \u0441\u043b\u043e\u0436\u043d\u043e.\n\n\U0001F3AD
    \u041e\u0442 \u0441\u0432\u044f\u0442\u043e\u0439 \u0434\u043e \u0432\u0435\u0434\u044c\u043c\u044b:
    \u042d\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u043e\u0431\u0440\u0430\u0437\u0430 \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442 \u043e \u0413\u0438\u043f\u0430\u0442\u0438\u0438 \u2014 \u044d\u0442\u043e
    \u0442\u043e, \u043a\u0430\u043a \u0441\u0438\u043b\u044c\u043d\u043e \u043c\u0435\u043d\u044f\u043b\u043e\u0441\u044c
    \u0435\u0451 \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u0435 \u0432 \u0440\u0430\u0437\u043d\u044b\u0435
    \u044d\u043f\u043e\u0445\u0438. \u041e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
    \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u043c \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043a\u0430\u0436\u0434\u0430\u044f \u044d\u043f\u043e\u0445\u0430
    \"\u043f\u043e\u0434\u0433\u043e\u043d\u044f\u043b\u0430\" \u043f\u043e\u0434 \u0441\u0435\u0431\u044f:
    \u0410\u043d\u0442\u0438\u0447\u043d\u044b\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444:
    \u0412 \u0441\u0432\u043e\u0451 \u0432\u0440\u0435\u043c\u044f \u2014 \u0436\u0435\u043d\u0449\u0438\u043d\u0430-\u0443\u0447\u0451\u043d\u044b\u0439
    \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444-\u043d\u0435\u043e\u043f\u043b\u0430\u0442\u043e\u043d\u0438\u043a,
    \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0432\u0448\u0430\u044f\u0441\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c
    \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u0430\u0436\u0435 \u0443 \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d.
    \u0421\u0438\u043c\u0432\u043e\u043b \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0441\u0442\u0432\u0430:
    \u0412 \u0421\u0440\u0435\u0434\u043d\u0438\u0435 \u0432\u0435\u043a\u0430 \u0434\u0435\u0442\u0430\u043b\u0438
    \u0435\u0451 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0431\u044b\u043b\u0438
    \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u044b \u0441 \u0436\u0438\u0442\u0438\u0435\u043c
    \u0421\u0432\u044f\u0442\u043e\u0439 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u0439.
    \u0410\u043d\u0442\u0438\u043a\u043b\u0435\u0440\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439
    \u0441\u0438\u043c\u0432\u043e\u043b: \u0412 \u044d\u043f\u043e\u0445\u0443 \u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f
    \u0412\u043e\u043b\u044c\u0442\u0435\u0440 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043c\u044b\u0441\u043b\u0438\u0442\u0435\u043b\u0438
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0438 \u0435\u0451 \u0432 \u043c\u0443\u0447\u0435\u043d\u0438\u0446\u0443,
    \u043f\u0430\u0432\u0448\u0443\u044e \u0436\u0435\u0440\u0442\u0432\u043e\u0439 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0433\u043e
    \u0444\u0430\u043d\u0430\u0442\u0438\u0437\u043c\u0430. \u041f\u0440\u0435\u0434\u0432\u0435\u0441\u0442\u043d\u0438\u0446\u0430
    \u0444\u0435\u043c\u0438\u043d\u0438\u0437\u043c\u0430: \u0412 XIX \u0438 XX \u0432\u0435\u043a\u0430\u0445
    \u0435\u0451 \u043e\u0431\u0440\u0430\u0437 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438
    \u043a\u0430\u043a \u0441\u0438\u043c\u0432\u043e\u043b \u0431\u043e\u0440\u044c\u0431\u044b
    \u0436\u0435\u043d\u0449\u0438\u043d \u0437\u0430 \u043f\u0440\u0430\u0432\u043e \u043d\u0430
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0443\u043a\u0443.\n\n\U0001F631
    \u0421\u0430\u043c\u044b\u0439 \u0448\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0439
    \u043a\u0443\u0440\u044c\u0451\u0437: \u041c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u044f\u043f\u043a\u0438 \u0438 \u0432\u043b\u044e\u0431\u043b\u0451\u043d\u043d\u044b\u0439
    \u0443\u0447\u0435\u043d\u0438\u043a \u041e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0438, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u0441\u0430\u043c\u044b\u0445 \u043f\u0438\u043a\u0430\u043d\u0442\u043d\u044b\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432
    \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0413\u0438\u043f\u0430\u0442\u0438\u0438 \u043e\u043f\u0438\u0441\u0430\u043d
    \u0432 \u0432\u0438\u0437\u0430\u043d\u0442\u0438\u0439\u0441\u043a\u043e\u043c \u0441\u043b\u043e\u0432\u0430\u0440\u0435
    X \u0432\u0435\u043a\u0430. \u0412\u043e\u0442 \u043a\u0430\u043a \u044d\u0442\u043e \u0431\u044b\u043b\u043e:
    > \u041e\u0434\u0438\u043d \u0438\u0437 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432,
    \u043f\u044b\u043b\u0430\u044f \u0441\u0442\u0440\u0430\u0441\u0442\u044c\u044e \u043a \u0441\u0432\u043e\u0435\u0439
    \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0439 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u0446\u0435,
    \u043d\u0435 \u0441\u043c\u043e\u0433 \u0441\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0447\u0443\u0432\u0441\u0442\u0432.
    \u0412 \u043e\u0442\u0432\u0435\u0442 \u0413\u0438\u043f\u0430\u0442\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u0430\u043b\u0430 \u043e\u0431\u0435\u0442 \u0431\u0435\u0437\u0431\u0440\u0430\u0447\u0438\u044f,
    \u0432\u0437\u044f\u043b\u0430 \u0441\u0432\u043e\u044e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0442\u043a\u0430\u043d\u044c
    \u0438, \u0431\u0440\u043e\u0441\u0438\u0432 \u0435\u0451 \u043f\u0435\u0440\u0435\u0434
    \u044e\u043d\u043e\u0448\u0435\u0439, \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \"\u0412\u043e\u0442
    \u0447\u0442\u043e \u0442\u044b \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435
    \u043b\u044e\u0431\u0438\u0448\u044c, \u044e\u043d\u043e\u0448\u0430, \u043d\u043e \u0442\u044b
    \u043b\u044e\u0431\u0438\u0448\u044c \u044d\u0442\u043e \u043d\u0435 \u0440\u0430\u0434\u0438
    \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0433\u043e\". \u042d\u0442\u043e\u0442
    \u0436\u0435\u0441\u0442, \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0443\u0447\u0435\u043d\u0438\u043a\u0443 \u0432\u0441\u044e \u0438\u043b\u043b\u044e\u0437\u043e\u0440\u043d\u043e\u0441\u0442\u044c
    \u0435\u0433\u043e \u043f\u043b\u043e\u0442\u0441\u043a\u043e\u0433\u043e \u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f,
    \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0435\u0451 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f:
    \u043d\u0443\u0436\u043d\u043e \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u044c\u0441\u044f
    \u043a \u0434\u0443\u0445\u043e\u0432\u043d\u043e\u043c\u0443 \u0438 \u043e\u0442\u0440\u0435\u0448\u0430\u0442\u044c\u0441\u044f
    \u043e\u0442 \u0442\u0435\u043b\u0435\u0441\u043d\u043e\u0433\u043e. \u0421\u0443\u0434\u044f
    \u043f\u043e \u0432\u0441\u0435\u043c\u0443, \u043c\u0435\u0442\u043e\u0434 \u0441\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u2014 \u044e\u043d\u043e\u0448\u0443 \"\u0441\u0442\u044b\u0434 \u0438 \u0438\u0437\u0443\u043c\u043b\u0435\u043d\u0438\u0435
    \u043e\u0442\u0432\u043b\u0435\u043a\u043b\u0438 \u043e\u0442 \u0432\u043e\u0436\u0434\u0435\u043b\u0435\u043d\u0438\u044f\"
    \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0441\u0434\u0435\u0440\u0436\u0430\u043d\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F9AA
    \"\u0423\u0441\u0442\u0440\u0438\u0447\u043d\u044b\u0435 \u0440\u0430\u043a\u0443\u0448\u043a\u0438\"?
    \u041d\u0435 \u0432\u0441\u0451 \u0442\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u043e
    \u041e\u0440\u0443\u0434\u0438\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u0430\u043f\u0443\u0442\u0430\u043d\u043d\u044b\u0445
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432. \u0412 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0447\u0430\u0441\u0442\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u0435\u0451 \u0443\u0431\u0438\u043b\u0438, \u0441\u0434\u0438\u0440\u0430\u044f
    \u043f\u043b\u043e\u0442\u044c \"\u043e\u0441\u0442\u0440\u0430\u043a\u0438\u0441 \u0430\u043d\u0435\u0439\u043b\u043e\u043d\".
    \u0413\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043b\u043e\u0432\u043e `\u1f44\u03c3\u03c4\u03c1\u03b1\u03ba\u03bf\u03bd`
    (`ostrakon`) \u043c\u043e\u0436\u0435\u0442 \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c
    \u043a\u0430\u043a \u0447\u0435\u0440\u0435\u043f\u043e\u043a, \u0433\u043b\u0438\u043d\u044f\u043d\u0443\u044e
    \u0447\u0435\u0440\u0435\u043f\u0438\u0446\u0443, \u0442\u0430\u043a \u0438 \u0443\u0441\u0442\u0440\u0438\u0447\u043d\u0443\u044e
    \u0440\u0430\u043a\u0443\u0448\u043a\u0443. \u0412\u0435\u0440\u0441\u0438\u044f \u0441
    \u0447\u0435\u0440\u0435\u043f\u0438\u0446\u0435\u0439: \u0411\u043e\u043b\u0435\u0435 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0430,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0447\u0435\u0440\u0435\u043f\u043a\u0438 \u0431\u044b\u043b\u0438
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u043c
    \u043f\u043e\u0434\u0440\u0443\u0447\u043d\u044b\u043c \u043e\u0440\u0443\u0434\u0438\u0435\u043c.
    \u0412\u0435\u0440\u0441\u0438\u044f \u0441 \u0440\u0430\u043a\u0443\u0448\u043a\u0430\u043c\u0438:
    \u042d\u0442\u0430 \u0432\u0435\u0440\u0441\u0438\u044f \u0431\u043e\u043b\u0435\u0435 \u043a\u0438\u043d\u0435\u043c\u0430\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u043d\u0430
    \u0438 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u043d\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u0447\u0430\u0441\u0442\u043e \u0446\u0438\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f
    \u0432 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435 \u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435.\n\n\u2699\ufe0f
    \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f: \u0427\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u0430
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435?
    \u0415\u0439 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432, \u043d\u043e
    \u0432\u0430\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u0442\u044c \u0444\u0430\u043a\u0442\u044b
    \u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u044b: \u0410\u0441\u0442\u0440\u043e\u043b\u044f\u0431\u0438\u044f
    (\u041d\u0415 \u0418\u0417\u041e\u0411\u0420\u0415\u041b\u0410): \u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0439 \u043c\u0438\u0444. \u0410\u0441\u0442\u0440\u043e\u043b\u044f\u0431\u0438\u044f
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430\u043c\u0438
    \u043f\u043e \u043c\u0435\u043d\u044c\u0448\u0435\u0439 \u043c\u0435\u0440\u0435 \u0437\u0430
    500 \u043b\u0435\u0442 \u0434\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0413\u0438\u043f\u0430\u0442\u0438\u0438.
    \u041e\u043d\u0430, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e,
    \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0435\u0451 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u0438 \u043d\u0430\u0443\u0447\u0438\u043b\u0430
    \u0441\u0432\u043e\u0438\u0445 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0441 \u044d\u0442\u0438\u043c \u0441\u043b\u043e\u0436\u043d\u044b\u043c \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u043c.
    \u0410\u0440\u0435\u043e\u043c\u0435\u0442\u0440 (\u041d\u0415 \u0418\u0417\u041e\u0411\u0420\u0415\u041b\u0410):
    \u041f\u0440\u0438\u0431\u043e\u0440 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u0438 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0438 \u0434\u043e
    \u043d\u0435\u0451. \u041e\u0434\u043d\u0430\u043a\u043e, \u043f\u043e \u043f\u0440\u043e\u0441\u044c\u0431\u0435
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430 \u0421\u0438\u043d\u0435\u0437\u0438\u044f, \u043e\u043d\u0430
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0430 \u0432 \u0435\u0433\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0435\u0451 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u043c
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u043c \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0435. \u041f\u043b\u0430\u043d\u0438\u0441\u0444\u0435\u0440\u0430
    (\u0412\u041e\u0417\u041c\u041e\u0416\u041d\u041e, \u0423\u0421\u041e\u0412\u0415\u0420\u0428\u0415\u041d\u0421\u0422\u0412\u041e\u0412\u0410\u041b\u0410):
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043d\u0430
    \u0441\u043e\u0437\u0434\u0430\u043b\u0430 \u043f\u043b\u043e\u0441\u043a\u0443\u044e \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0443\u044e
    \u043a\u0430\u0440\u0442\u0443 \u043d\u0435\u0431\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e XVII \u0432\u0435\u043a\u0430.\n\n\u2728 \u0421\u0430\u043c\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435: \"\u041e\u043d\u0430
    \u0443\u043c\u0435\u0440\u043b\u0430 \u0437\u0430 \u043d\u0430\u0443\u043a\u0443\" \u0415\u0451
    \u0447\u0430\u0441\u0442\u043e \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442
    \u043a\u0430\u043a \u043c\u0443\u0447\u0435\u043d\u0438\u0446\u0443 \u043d\u0430\u0443\u043a\u0438,
    \u043f\u043e\u0433\u0438\u0431\u0448\u0443\u044e \u043e\u0442 \u0440\u0443\u043a \u043c\u0440\u0430\u043a\u043e\u0431\u0435\u0441\u043e\u0432
    \u0438\u0437-\u0437\u0430 \u0441\u0432\u043e\u0438\u0445 \u0437\u043d\u0430\u043d\u0438\u0439.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432
    \u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432\u043e \u043c\u043d\u0435\u043d\u0438\u0438,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0430 \u0435\u0451 \u0433\u0438\u0431\u0435\u043b\u0438
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439:
    \u042d\u0442\u043e \u0431\u044b\u043b \u0443\u0434\u0430\u0440 \u043f\u043e \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u0443
    \u041e\u0440\u0435\u0441\u0442\u0443, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0431\u044b\u043b\u0430 \u0431\u043b\u0438\u0437\u043a\u0430,
    \u0430 \u043d\u0435 \u0430\u043a\u0442 \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u043d\u0430\u0443\u043a\u043e\u0439.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0443\u0431\u0438\u0442\u0430 \u043d\u0435
    \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a \u0443\u0447\u0451\u043d\u044b\u0439,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u0433\u0440\u043e\u043a
    \u0438 \u0441\u043e\u044e\u0437\u043d\u0438\u043a \u0432\u0440\u0430\u0433\u0430 \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u0430
    \u041a\u0438\u0440\u0438\u043b\u043b\u0430.\n\n\U0001F48E \u041a\u0440\u0430\u0442\u043a\u0438\u0439
    \u0438\u0442\u043e\u0433: \u0416\u0438\u0437\u043d\u044c \u043a\u0430\u043a \u043b\u0435\u0433\u0435\u043d\u0434\u0430
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0431\u044b\u043b\u0430, \u0431\u0435\u0437
    \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u044f, \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0432\u043d\u0435\u0441\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439 \u0438 \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0432\u043e\u0431\u043e\u0434\u044b. \u0415\u0451 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0438\u0431\u0435\u043b\u044c, \u043a\u0430\u043a\u043e\u0439 \u0431\u044b \u043d\u0438
    \u0431\u044b\u043b\u0430 \u0435\u0451 \u043f\u0440\u0438\u0447\u0438\u043d\u0430, \u043e\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043b\u0430
    \u043a\u043e\u043d\u0435\u0446 \u0446\u0435\u043b\u043e\u0439 \u044d\u043f\u043e\u0445\u0438.
    \u0418 \u0434\u0430\u0436\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u0447\u0435\u0440\u0435\u0437
    1600 \u043b\u0435\u0442, \u043e\u043d\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u0438 \u043f\u043e\u0440\u0430\u0436\u0430\u0442\u044c
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435."
