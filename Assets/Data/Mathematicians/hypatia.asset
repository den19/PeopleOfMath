    \u2014 \u044e\u043d\u043e\u0448\u0443 \"\u0441\u0442\u044b\u0434 \u0438 \u0438\u0437\u0443\u043c\u043b\u0435\u043d\u0438\u0435
    \u043e\u0442\u0432\u043b\u0435\u043a\u043b\u0438 \u043e\u0442 \u0432\u043e\u0436\u0434\u0435\u043b\u0435\u043d\u0438\u044f\"
    \u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u0441\u0434\u0435\u0440\u0436\u0430\u043d\u043d\u043e\u0441\u0442\u0438.\n\n\U0001F9AA
    \"\u0423\u0441\u0442\u0440\u0438\u0447\u043d\u044b\u0435 \u0440\u0430\u043a\u0443\u0448\u043a\u0438\"?
    \u041d\u0435 \u0432\u0441\u0451 \u0442\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u043e
    \u041e\u0440\u0443\u0434\u0438\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0413\u0438\u043f\u0430\u0442\u0438\u0438
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u0430\u043f\u0443\u0442\u0430\u043d\u043d\u044b\u0445
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432. \u0412 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0447\u0430\u0441\u0442\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442\u0441\u044f,
    \u0447\u0442\u043e \u0435\u0451 \u0443\u0431\u0438\u043b\u0438, \u0441\u0434\u0438\u0440\u0430\u044f
    \u043f\u043b\u043e\u0442\u044c \"\u043e\u0441\u0442\u0440\u0430\u043a\u0438\u0441 \u0430\u043d\u0435\u0439\u043b\u043e\u043d\".
    \u0413\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043b\u043e\u0432\u043e `\u1f44\u03c3\u03c4\u03c1\u03b1\u03ba\u03bf\u03bd`
    (`ostrakon`) \u043c\u043e\u0436\u0435\u0442 \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c
    \u043a\u0430\u043a \u0447\u0435\u0440\u0435\u043f\u043e\u043a, \u0433\u043b\u0438\u043d\u044f\u043d\u0443\u044e
    \u0447\u0435\u0440\u0435\u043f\u0438\u0446\u0443, \u0442\u0430\u043a \u0438 \u0443\u0441\u0442\u0440\u0438\u0447\u043d\u0443\u044e
    \u0440\u0430\u043a\u0443\u0448\u043a\u0443. \u0412\u0435\u0440\u0441\u0438\u044f \u0441
    \u0447\u0435\u0440\u0435\u043f\u0438\u0446\u0435\u0439: \u0411\u043e\u043b\u0435\u0435 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0430,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0447\u0435\u0440\u0435\u043f\u043a\u0438 \u0431\u044b\u043b\u0438
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u043c
    \u043f\u043e\u0434\u0440\u0443\u0447\u043d\u044b\u043c \u043e\u0440\u0443\u0434\u0438\u0435\u043c.
    \u0412\u0435\u0440\u0441\u0438\u044f \u0441 \u0440\u0430\u043a\u0443\u0448\u043a\u0430\u043c\u0438:
    \u042d\u0442\u0430 \u0432\u0435\u0440\u0441\u0438\u044f \u0431\u043e\u043b\u0435\u0435 \u043a\u0438\u043d\u0435\u043c\u0430\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u043d\u0430
    \u0438 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u043d\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u0447\u0430\u0441\u0442\u043e \u0446\u0438\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f
    \u0432 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435 \u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435.\n\n\u2699\ufe0f
    \u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f: \u0427\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u0430
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435?
    \u0415\u0439 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432, \u043d\u043e
    \u0432\u0430\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u0442\u044c \u0444\u0430\u043a\u0442\u044b
    \u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u044b: \u0410\u0441\u0442\u0440\u043e\u043b\u044f\u0431\u0438\u044f
    (\u041d\u0415 \u0418\u0417\u041e\u0411\u0420\u0415\u041b\u0410): \u042d\u0442\u043e \u0441\u0430\u043c\u044b\u0439
    \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0439 \u043c\u0438\u0444. \u0410\u0441\u0442\u0440\u043e\u043b\u044f\u0431\u0438\u044f
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430\u043c\u0438
    \u043f\u043e \u043c\u0435\u043d\u044c\u0448\u0435\u0439 \u043c\u0435\u0440\u0435 \u0437\u0430
    500 \u043b\u0435\u0442 \u0434\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0413\u0438\u043f\u0430\u0442\u0438\u0438.
    \u041e\u043d\u0430, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e,
    \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0435\u0451 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u0438 \u043d\u0430\u0443\u0447\u0438\u043b\u0430
    \u0441\u0432\u043e\u0438\u0445 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0441 \u044d\u0442\u0438\u043c \u0441\u043b\u043e\u0436\u043d\u044b\u043c \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u043c.
    \u0410\u0440\u0435\u043e\u043c\u0435\u0442\u0440 (\u041d\u0415 \u0418\u0417\u041e\u0411\u0420\u0415\u041b\u0410):
    \u041f\u0440\u0438\u0431\u043e\u0440 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u0438 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0438 \u0434\u043e
    \u043d\u0435\u0451. \u041e\u0434\u043d\u0430\u043a\u043e, \u043f\u043e \u043f\u0440\u043e\u0441\u044c\u0431\u0435
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430 \u0421\u0438\u043d\u0435\u0437\u0438\u044f, \u043e\u043d\u0430
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0430 \u0432 \u0435\u0433\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0435\u0451 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u043c
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u043c \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0435. \u041f\u043b\u0430\u043d\u0438\u0441\u0444\u0435\u0440\u0430
    (\u0412\u041e\u0417\u041c\u041e\u0416\u041d\u041e, \u0423\u0421\u041e\u0412\u0415\u0420\u0428\u0415\u041d\u0421\u0422\u0412\u041e\u0412\u0410\u041b\u0410):
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043d\u0430
    \u0441\u043e\u0437\u0434\u0430\u043b\u0430 \u043f\u043b\u043e\u0441\u043a\u0443\u044e \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0443\u044e
    \u043a\u0430\u0440\u0442\u0443 \u043d\u0435\u0431\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e XVII \u0432\u0435\u043a\u0430.\n\n\u2728 \u0421\u0430\u043c\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435: \"\u041e\u043d\u0430
    \u0443\u043c\u0435\u0440\u043b\u0430 \u0437\u0430 \u043d\u0430\u0443\u043a\u0443\" \u0415\u0451
    \u0447\u0430\u0441\u0442\u043e \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442
    \u043a\u0430\u043a \u043c\u0443\u0447\u0435\u043d\u0438\u0446\u0443 \u043d\u0430\u0443\u043a\u0438,
    \u043f\u043e\u0433\u0438\u0431\u0448\u0443\u044e \u043e\u0442 \u0440\u0443\u043a \u043c\u0440\u0430\u043a\u043e\u0431\u0435\u0441\u043e\u0432
    \u0438\u0437-\u0437\u0430 \u0441\u0432\u043e\u0438\u0445 \u0437\u043d\u0430\u043d\u0438\u0439.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432
    \u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432\u043e \u043c\u043d\u0435\u043d\u0438\u0438,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0430 \u0435\u0451 \u0433\u0438\u0431\u0435\u043b\u0438
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439:
    \u042d\u0442\u043e \u0431\u044b\u043b \u0443\u0434\u0430\u0440 \u043f\u043e \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u0443
    \u041e\u0440\u0435\u0441\u0442\u0443, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0431\u044b\u043b\u0430 \u0431\u043b\u0438\u0437\u043a\u0430,
    \u0430 \u043d\u0435 \u0430\u043a\u0442 \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u043d\u0430\u0443\u043a\u043e\u0439.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0443\u0431\u0438\u0442\u0430 \u043d\u0435
    \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a \u0443\u0447\u0451\u043d\u044b\u0439,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u0433\u0440\u043e\u043a
    \u0438 \u0441\u043e\u044e\u0437\u043d\u0438\u043a \u0432\u0440\u0430\u0433\u0430 \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u0430
    \u041a\u0438\u0440\u0438\u043b\u043b\u0430.\n\n\U0001F48E \u041a\u0440\u0430\u0442\u043a\u0438\u0439
    \u0438\u0442\u043e\u0433: \u0416\u0438\u0437\u043d\u044c \u043a\u0430\u043a \u043b\u0435\u0433\u0435\u043d\u0434\u0430
    \u0413\u0438\u043f\u0430\u0442\u0438\u044f \u0431\u044b\u043b\u0430, \u0431\u0435\u0437
    \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u044f, \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0432\u043d\u0435\u0441\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0447\u043d\u044b\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439 \u0438 \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0441\u0432\u043e\u0431\u043e\u0434\u044b. \u0415\u0451 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0438\u0431\u0435\u043b\u044c, \u043a\u0430\u043a\u043e\u0439 \u0431\u044b \u043d\u0438
    \u0431\u044b\u043b\u0430 \u0435\u0451 \u043f\u0440\u0438\u0447\u0438\u043d\u0430, \u043e\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043b\u0430
    \u043a\u043e\u043d\u0435\u0446 \u0446\u0435\u043b\u043e\u0439 \u044d\u043f\u043e\u0445\u0438.
    \u0418 \u0434\u0430\u0436\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u0447\u0435\u0440\u0435\u0437
    1600 \u043b\u0435\u0442, \u043e\u043d\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u0438 \u043f\u043e\u0440\u0430\u0436\u0430\u0442\u044c
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435."
  interestingFactsEn: "The Gipathy of Alexandria is a person around whom there have been many amazing stories, smokers and myths in 16 centuries, and her life and tragic fate have been so legendary that it is sometimes difficult to separate facts from fiction.\n\nFrom the Holy to the Witch: The evolution of Hypathia's image, perhaps the most amazing fact about Hypathia is how much it has changed in different times, and it has become a real cultural symbol that every era has \"made up\" itself: Antiquated Philosophy: In its time, a female scientist and a non-profit philosopher, who has enjoyed great respect even from Christians.The symbol of Christianity: In the Middle Ages, the details of her biography were interwoven with the life of Saint Catherine of Alexandria, an anticlerical symbol: In the era of Enlightenment Volter and other thinkers turned her into a martyr who had fallen victim to religious fanaticism, the predisposition of feminism: in the nineteenth and twentieth centuries, her image was used actively as a symbol of women's struggle for the right to education and science.\n\nThe most shocking smoking: The menstrual rags and the in love student One of the most famous and certainly the most spiciest episodes of Hypathia's life is described in the Byzantine dictionary of the Xth century. This is how it was: > One of the students, passionately passionate about his beautiful mentor, was unable to contain feelings.In response, Gipathia, who vowed to be single, took her used menstrual tissue and, leaving it in front of the young men, said, \"This is what you really love, young man, but you don't love it for the love of the beautiful.\" This gesture, which is designed to show the student the illusion of his carnal appeal, illustrates her philosophical beliefs: one must strive for spiritual things and avoid the physical.The method seems to have worked — the young man was \"smart and astonishment distracted from lust\" and led to restraint.\n\n\"Oyster shells\"? It's not all that simple The Hypathia Killing Instrument is one of the most confusing questions. The sources often mention that she was killed by wiping off the flesh of \"Osterakis Anilon.\" The Greek word \"Ostrakon\" can mean both a skull, a clay cranium, and an oyster shell. The cranium version: more likely, because the skulls were a common handgun.The shell version: This version is more cinematic and scenic, so it is often quoted in literature and art.\n\n==Early life==The inventions: What did Hypathia really do? She is attributed to the invention of many instruments, but it is important to share facts and legends: Astrolabia (NO ISBRELA): This is the most popular myth. Astrolabia was used by astronomers at least 500 years before Gipathia was born. It has probably improved its design and taught its students how to work with this complex device.Areometer (NO ISBEL): The fluid density measurement device was known before it, but at the request of the student, Synesia, she helped create it, which indicates its excellent engineering and mechanical skills.\n\nThe most important mistake: \"She died for science\" is often portrayed as a martyr of science, who died at the hands of the darknesses because of her knowledge. But most modern historians agree that the cause of her death was political: it was a blow to the Prefect of Orest, with whom Gipathia was close, not an act of fighting science. She was killed not so much as a scientist, but as an influential political player and an ally of Bishop Cyrille's enemy.\n\nThe sum total: Life as Gipathia's legend was no doubt an outstanding person. She was the first known mathematician woman to make a huge contribution to the preservation of antiquity knowledge, and became a symbol of intellectual freedom. Her tragic death, whatever its cause, marked the end of an era. And even today, 1600 years later, she continues to inspire and impress imagination."
