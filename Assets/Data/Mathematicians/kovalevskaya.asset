    \u0431\u044b\u043b\u043e \u0437\u0430\u043a\u0440\u044b\u0442\u043e. \u0427\u0442\u043e\u0431\u044b
    \u0443\u0447\u0438\u0442\u044c\u0441\u044f \u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0435\u0439,
    \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u043e\u0442\u0446\u0430 \u0438\u043b\u0438 \u043c\u0443\u0436\u0430. \u0421\u043e\u0444\u044c\u044f
    \u0438 \u0435\u0451 \u0441\u0435\u0441\u0442\u0440\u0430 \u0410\u043d\u043d\u0430 \u043d\u0430\u0448\u043b\u0438
    \u0432\u044b\u0445\u043e\u0434 \u0432 \"\u0444\u0438\u043a\u0442\u0438\u0432\u043d\u043e\u043c
    \u0431\u0440\u0430\u043a\u0435\" \u2014 \u043c\u043e\u043b\u043e\u0434\u044b\u0435 \u043b\u044e\u0434\u0438
    \u0438\u0437 \u043a\u0440\u0443\u0433\u0430 \u044d\u043c\u0430\u043d\u0441\u0438\u043f\u0435
    \u0441\u043e\u0433\u043b\u0430\u0448\u0430\u043b\u0438\u0441\u044c \u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f
    \u0438 \u0443\u0432\u043e\u0437\u0438\u0442\u044c \u0434\u0435\u0432\u0443\u0448\u0435\u043a
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0443. \u0412 \u043a\u0440\u0443\u0436\u043a\u0435
    \u0441\u0435\u0441\u0442\u0451\u0440 \u0442\u0430\u043a\u0438\u0445 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043c\u0443\u0436\u0435\u0439 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \"\u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u043c\u0438\",
    \u0430 \u0441\u0430\u043c \u043f\u043b\u0430\u043d \u043f\u043e\u0431\u0435\u0433\u0430
    \u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043b\u0441\u044f \"\u043a\u0443\u0445\u043d\u0435\u0439\".
    \u041a\u043e\u0433\u0434\u0430 \u0432 \u0433\u043e\u0441\u0442\u0438\u043d\u043e\u0439 \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u043c\u043e\u043b\u043e\u0434\u043e\u0439 \u0443\u0447\u0451\u043d\u044b\u0439 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0438\u0439, \u043e\u043d, \u043d\u0435\u0434\u043e\u043b\u0433\u043e
    \u0434\u0443\u043c\u0430\u044f, \u0432\u044b\u0431\u0440\u0430\u043b \u0421\u043e\u0444\u044c\u044e
    \u0438 \u0441\u043a\u0430\u0437\u0430\u043b: \"\u0413\u043e\u0442\u043e\u0432 \u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f
    \u0445\u043e\u0442\u044c \u0437\u0430\u0432\u0442\u0440\u0430!\". \u0418\u0440\u043e\u043d\u0438\u044f
    \u0441\u0443\u0434\u044c\u0431\u044b \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0444\u0438\u043a\u0442\u0438\u0432\u043d\u044b\u0439
    \u0431\u0440\u0430\u043a, \u0437\u0430\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u0439
    \u0440\u0430\u0434\u0438 \u043d\u0430\u0443\u043a\u0438, \u0447\u0435\u0440\u0435\u0437
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u0441\u0442\u0430\u043b
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c, \u0438 \u0443 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u0434\u043e\u0447\u044c.\n\n\U0001F3AD
    \"\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0443\u0441\u0430\u043b\u043a\u0430\"
    \u0438 \u0434\u0432\u043e\u0439\u043d\u043e\u0439 \u043f\u0440\u0438\u0437 \u0417\u0430\u0434\u0430\u0447\u0430
    \u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0442\u0432\u0451\u0440\u0434\u043e\u0433\u043e
    \u0442\u0435\u043b\u0430, \u0437\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430
    \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443, \u0431\u044b\u043b\u0430
    \u0442\u0430\u043a \u0441\u043b\u043e\u0436\u043d\u0430, \u0447\u0442\u043e \u0441\u0440\u0435\u0434\u0438
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u043e\u043d\u0430 \u043d\u043e\u0441\u0438\u043b\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435
    \"Die mathematische Nixe\" (\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0440\u0443\u0441\u0430\u043b\u043a\u0430). \u042d\u0442\u043e \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \u043e\u0442\u0440\u0430\u0436\u0430\u043b\u043e \u0435\u0451 \"\u043d\u0435\u0443\u043b\u043e\u0432\u0438\u043c\u043e\u0441\u0442\u044c\"
    \u2014 \u043d\u0430\u0434 \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c \u0431\u0438\u043b\u0438\u0441\u044c
    \u043b\u0443\u0447\u0448\u0438\u0435 \u0443\u043c\u044b, \u043d\u043e \u043e\u043d\u0430
    \u0443\u0441\u043a\u043e\u043b\u044c\u0437\u0430\u043b\u0430 \u043e\u0442 \u043d\u0438\u0445.
    \u041a\u043e\u0433\u0434\u0430 \u0432 1888 \u0433\u043e\u0434\u0443 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b\u0430
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u044e
    \u0411\u043e\u0440\u0434\u0435\u043d\u0430 \u0437\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u044d\u0442\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438, \u0441\u0443\u043c\u043c\u0430
    \u043f\u0440\u0435\u043c\u0438\u0438 \u0431\u044b\u043b\u0430 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430
    \u0432\u0434\u0432\u043e\u0435 (\u0441 3000 \u0434\u043e 5000 \u0444\u0440\u0430\u043d\u043a\u043e\u0432)
    \u2014 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0438
    \u0431\u044b\u043b\u0438 \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u044b \u0435\u0451
    \u0440\u0430\u0431\u043e\u0442\u043e\u0439. \u0415\u0451 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0434\u0430\u043d\u0430 \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u043e,
    \u043f\u043e\u0434 \u0434\u0435\u0432\u0438\u0437\u043e\u043c: \u00ab\u0413\u043e\u0432\u043e\u0440\u0438,
    \u0447\u0442\u043e \u0437\u043d\u0430\u0435\u0448\u044c, \u0434\u0435\u043b\u0430\u0439,
    \u0447\u0442\u043e \u0434\u043e\u043b\u0436\u0435\u043d, \u0438 \u043f\u0443\u0441\u0442\u044c
    \u0431\u0443\u0434\u0435\u0442, \u0447\u0442\u043e \u0431\u0443\u0434\u0435\u0442\u00bb.\n\n\U0001F48E
    \"\u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0430\u044f\" \u043a\u0440\u043e\u0432\u044c
    \u0438 \u0443\u043f\u0440\u044f\u043c\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440
    \u0421\u043e\u0444\u044c\u044f \u0412\u0430\u0441\u0438\u043b\u044c\u0435\u0432\u043d\u0430
    \u043b\u044e\u0431\u0438\u043b\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0442\u044c,
    \u0447\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u0441\u0432\u043e\u0438
    \u0442\u0430\u043b\u0430\u043d\u0442\u044b \u0438 \u0447\u0435\u0440\u0442\u044b \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430
    \u0432 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e \u043e\u0442 \u0440\u0430\u0437\u043d\u044b\u0445
    \u043f\u0440\u0435\u0434\u043a\u043e\u0432. \u041e\u043d\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430:
    > \u00ab\u042f \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u0432 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u043d\u0430\u0443\u043a\u0435 \u043e\u0442
    \u043f\u0440\u0435\u0434\u043a\u0430, \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u041c\u0430\u0442\u0432\u0435\u044f \u041a\u043e\u0440\u0432\u0438\u043d\u0430;
    \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043c\u0443\u0437\u044b\u043a\u0435, \u043f\u043e\u044d\u0437\u0438\u0438 \u2014 \u043e\u0442
    \u0434\u0435\u0434\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u0440\u0438, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430
    \u0428\u0443\u0431\u0435\u0440\u0442\u0430; \u043b\u0438\u0447\u043d\u0443\u044e \u0441\u0432\u043e\u0431\u043e\u0434\u0443
    \u2014 \u043e\u0442 \u041f\u043e\u043b\u044c\u0448\u0438; \u043e\u0442 \u0446\u044b\u0433\u0430\u043d\u043a\u0438-\u043f\u0440\u0430\u0431\u0430\u0431\u043a\u0438
    \u2014 \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u0431\u0440\u043e\u0434\u044f\u0436\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0443
    \u0438 \u043d\u0435\u0443\u043c\u0435\u043d\u0438\u0435 \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u0442\u044c\u0441\u044f
    \u043f\u0440\u0438\u043d\u044f\u0442\u044b\u043c \u043e\u0431\u044b\u0447\u0430\u044f\u043c;
    \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u2014 \u043e\u0442 \u0420\u043e\u0441\u0441\u0438\u0438\u00bb.
    \u042d\u0442\u043e \"\u043d\u0435\u0443\u043c\u0435\u043d\u0438\u0435 \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u0442\u044c\u0441\u044f\"
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u043e\u0441\u044c \u0438 \u0432 \u043f\u043e\u043f\u044b\u0442\u043a\u0430\u0445
    \u043d\u0430\u0439\u0442\u0438 \u0441\u0432\u043e\u0451 \u043c\u0435\u0441\u0442\u043e \u043d\u0430
    \u0440\u043e\u0434\u0438\u043d\u0435. \u0412 1890 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a, \u043e\u043d\u0430 \u043f\u0440\u0438\u0435\u0445\u0430\u043b\u0430
    \u0432 \u0420\u043e\u0441\u0441\u0438\u044e \u0441 \u043d\u0430\u0434\u0435\u0436\u0434\u043e\u0439
    \u0437\u0430\u043d\u044f\u0442\u044c \u043c\u0435\u0441\u0442\u043e \u0443\u043c\u0435\u0440\u0448\u0435\u0433\u043e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0439 \u0443\u043a\u0430\u0437\u0430\u043b\u0438 \u043d\u0430 \u0434\u0432\u0435\u0440\u044c
    \u0441\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0438: \u00ab\u041f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0436\u0435\u043d\u0449\u0438\u043d \u043d\u0430 \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u044f\u0445
    \u043d\u0435 \u0432 \u043e\u0431\u044b\u0447\u0430\u044f\u0445 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438\u00bb.\n\n\U0001F58B\ufe0f
    \u041f\u0438\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430, \u043f\u043e\u044d\u0442\u0435\u0441\u0441\u0430
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0432 \u043e\u0434\u043d\u043e\u043c
    \u043b\u0438\u0446\u0435 \u0421\u043e\u0444\u044c\u044f \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u043e\u0439 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439.
    \u041e\u043d\u0430 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0432\u044b\u0443\u0447\u0438\u043b\u0430
    \u0448\u0432\u0435\u0434\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a \u0437\u0430 \u0433\u043e\u0434,
    \u0447\u0442\u043e\u0431\u044b \u0447\u0438\u0442\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438
    \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435, \u0438 \u0434\u0430\u0436\u0435
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b\u0430 \u043d\u0430 \u043d\u0451\u043c \u0440\u043e\u043c\u0430\u043d
    \u00ab\u0411\u043e\u0440\u044c\u0431\u0430 \u0437\u0430 \u0441\u0447\u0430\u0441\u0442\u044c\u0435.
    \u0414\u0432\u0435 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0435
    \u0434\u0440\u0430\u043c\u044b\u00bb. \u0412 \u043e\u0441\u043d\u043e\u0432\u0443 \u044d\u0442\u043e\u0433\u043e
    \u0440\u043e\u043c\u0430\u043d\u0430 \u043e\u043d\u0430 \u043f\u043e\u043b\u043e\u0436\u0438\u043b\u0430
    \u0441\u0432\u043e\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0438\u0434\u0435\u044e
    \u043e \u0442\u043e\u0447\u043a\u0430\u0445 \u0431\u0438\u0444\u0443\u0440\u043a\u0430\u0446\u0438\u0438
    \u0432 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445, \u0433\u0434\u0435 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u043e\u0435
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u0439
    \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f
    \u0432 \"\u043e\u0441\u043e\u0431\u043e\u0439 \u0442\u043e\u0447\u043a\u0435\". \u041e\u043d\u0430
    \u0441\u0447\u0438\u0442\u0430\u043b\u0430, \u0447\u0442\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0443\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u043f\u043e\u0445\u043e\u0436\u0438\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c."
  interestingFactsEn: "Sophia Kovalevsky's life is full of amazing coincidences, dramatic twists, and funny episodes that make her biography look like a fascinating novel, these are the most interesting of them.\n\n♪ Mathematical wallpaper and mystical prophecy ♪ ♪ I think the most famous chicken in her childhood is the case of the wallpaper ♪ ♪ When the family lived in the Palibino estate ♪ ♪ didn't have enough wallpapers on one of the walls in the children's room ♪ ♪ and they put it on lytographed lectures ♪ ♪ Differential and integrated calculation of the Academy of Ostrobgrad ♪ ♪ Little Sonya looked over and over and over ♪Years later, when she began to study the math of Alexander Strange, she felt that she already knew it -- the formulas came up from childhood -- and the mystical fact added: her mother had a dream in which an unknown person said, \"Your daughter will be a mathematician.\" Sophia's dream later described it in her memoirs.\n\nIn the 1860s, women's higher education in Russia was closed. In order to study abroad, they required the permission of their father or husband. Sophia and her sister Anna found a way out of a \"fake marriage\", young people from the Emancipe community agreed to marry and take the girls to Europe.When a young scientist, Vladimir Kovalevsky, appeared in the living room, he briefly chose Sofia and said, \"I'm ready to marry tomorrow!\" The irony of fate is that a fake marriage concluded for science became real after a few years, and they had a daughter.\n\nThe \"Mathematic Mermaid\" and the double prize The Problem of Turning the Hard Body, for which Kovalevsky received world glory, was so complex that it was called \"Die mathmatishe Nixe\" among German mathematicians.When the Paris Academy of Sciences awarded the Kovalev Borden Prize in 1888, the award was doubled (from 3,000 to 5,000 francs) and so admired by its work, its work was presented anonymously, under the slogan \"Tell me what you know, do what you have to do, and let it be what it will be.\"\n\n* \"Royal\" blood and the stubborn character of Sophia Vasilyevne liked to repeat that she had inherited her talents and personality from different ancestors.She said: > \"I inherited the passion for science from an ancestor, King Matthew Corwin of Hungary; love for mathematics, music, poetry — from my mother's grandfather, astronomer Schubert; personal freedom — from Poland; love for vagrancy and ignorance of custom; the rest — from Russia.\" This \"failure to obey\" was also manifested in attempts to find a place in the home country.In 1890, already a member of the respondent body of the Petersburg Academy of Sciences, she came to Russia with the hope of taking her place as a dead academic, but was told on the door saying, \"The presence of women at meetings is not in the customs of the Academy.\"\n\n♪ The writer, poet and mathematician in one person, Sofia Kovalevskaya, was not only a genius mathematician but also a talented writer. She learned Swedish brilliantly in a year to lecture in Stockholm, and even wrote a novel on him, \"The Fight for Happiness, Two Parallel Dramas\".She based this novel on her scientific idea of bifurcation points in differential equations, where predictable events suddenly change at a \"special point.\" She thought human life was similar."
