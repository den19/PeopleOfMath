  id: kovalevskaya
  wikiTitleRu: "\u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u0430\u044F,
    \u0421\u043E\u0444\u044C\u044F \u0412\u0430\u0441\u0438\u043B\u044C\u0435\u0432\u043D\u0430"
  wikidataId: Q184535
  fullNameRu: "\u041A\u043E\u0432\u0430\u043B\u0435\u0432\u0441\u043A\u0430\u044F,
    \u0421\u043E\u0444\u044C\u044F \u0412\u0430\u0441\u0438\u043B\u044C\u0435\u0432\u043D\u0430"
  fullNameEn: Sofia Kovalevskaya
  birthDate: 15.01.1850
  deathDate: 10.02.1891
  countryKeys:
