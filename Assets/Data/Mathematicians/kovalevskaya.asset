  branchKeys:
  - analysis
  achievementsRu: "\u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0442\u0440\u0438\u0443\u043c\u0444:
    \u0437\u0430\u0434\u0430\u0447\u0430 \u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u0442\u0432\u0435\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u0421\u0430\u043c\u043e\u0435
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u2014 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0441\u043b\u0443\u0447\u0430\u044f \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u0442\u0432\u0435\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u0432\u043e\u043a\u0440\u0443\u0433
    \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438.
    \u0414\u043e \u043d\u0435\u0435 \u044d\u0442\u0443 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u043b\u0438
    \u043b\u0438\u0448\u044c \u041b\u0435\u043e\u043d\u0430\u0440\u0434 \u042d\u0439\u043b\u0435\u0440
    \u0438 \u0416\u043e\u0437\u0435\u0444 \u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436,
    \u043d\u043e \u043e\u043d\u0438 \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043b\u0438
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0430\u0441\u0442\u043d\u044b\u0435 \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u044b\u0435
    \u0441\u043b\u0443\u0447\u0430\u0438. \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043d\u0430\u0448\u043b\u0430 \u043d\u043e\u0432\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439
    \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043d\u0435\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u043e\u0433\u043e
    \u0433\u0438\u0440\u043e\u0441\u043a\u043e\u043f\u0430, \u043a\u043e\u0433\u0434\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0434\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0443\u043b\u044c\u0442\u0440\u0430\u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0412
    1888 \u0433\u043e\u0434\u0443 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0430\u044f \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f
    \u043d\u0430\u0443\u043a \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b\u0430 \u0435\u0439
    \u043f\u0440\u0435\u043c\u0438\u044e \u0411\u043e\u0440\u0434\u0435\u043d\u0430 \u0437\u0430
    \u044d\u0442\u0443 \u0440\u0430\u0431\u043e\u0442\u0443, \u043f\u0440\u0438\u0447\u0435\u043c
    \u0441\u0443\u043c\u043c\u0430 \u043f\u0440\u0435\u043c\u0438\u0438 \u0431\u044b\u043b\u0430
    \u0443\u0434\u0432\u043e\u0435\u043d\u0430 \u0432\u0432\u0438\u0434\u0443 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.
    \u0412 1889 \u0433\u043e\u0434\u0443 \u0437\u0430 \u0432\u0442\u043e\u0440\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0442\u0432\u0435\u0440\u0434\u043e\u0433\u043e
    \u0442\u0435\u043b\u0430 \u043e\u043d\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430
    \u043f\u0440\u0435\u043c\u0438\u044e \u0428\u0432\u0435\u0434\u0441\u043a\u043e\u0439 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. --- \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u041a\u043e\u0448\u0438 \u2014 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0415\u0449\u0435 \u043e\u0434\u043d\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430, \u0432\u043e\u0448\u0435\u0434\u0448\u0430\u044f \u0432
    \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u2014 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f \u00ab\u041a \u0442\u0435\u043e\u0440\u0438\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445\u00bb (1874). \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e (\u0433\u043e\u043b\u043e\u043c\u043e\u0440\u0444\u043d\u043e\u0433\u043e)
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447\u0438 \u041a\u043e\u0448\u0438
    \u0434\u043b\u044f \u0441\u0438\u0441\u0442\u0435\u043c \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u0447\u0430\u0441\u0442\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u043c\u0438. \u0421\u0443\u0442\u044c
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b: \u0435\u0441\u043b\u0438 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u044b
    \u0432 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u044b
    \u0438 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u0438 (\u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043c\u044b
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0433\u043e\u0441\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0433\u043e \u0440\u044f\u0434\u0430),
    \u0430 \u0438\u0441\u043a\u043e\u043c\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0438\u043c\u0435\u0435\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0442\u043e\u0447\u043a\u0435,
    \u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0438 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0432 \u043e\u043a\u0440\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438
    \u044d\u0442\u043e\u0439 \u0442\u043e\u0447\u043a\u0438. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0432\u044b\u0445\u043e\u0434\u0438\u0442
    \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438: \u043e\u043d\u0430 \u043b\u0435\u0436\u0438\u0442
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447
    \u0433\u0438\u0434\u0440\u043e\u0433\u0430\u0437\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438,
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0438\u0442\u043d\u044b\u0445
    \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439, \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432
    \u0442\u0435\u043f\u043b\u043e\u043e\u0431\u043c\u0435\u043d\u0430, \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u044f
    \u043f\u043e\u0433\u043e\u0434\u044b, \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0445
    \u0442\u0435\u043b. \u0421 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u043e\u043d\u0430 \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u043b\u0430
    \u043e\u0441\u043e\u0431\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432.
    --- \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u0435\u0446
    \u0421\u0430\u0442\u0443\u0440\u043d\u0430 \u0412 1885 \u0433\u043e\u0434\u0443 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0443
    \u00ab\u0414\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u044f
    \u043a \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044e \u041b\u0430\u043f\u043b\u0430\u0441\u0430
    \u043e \u0444\u043e\u0440\u043c\u0435 \u043a\u043e\u043b\u044c\u0446\u0430 \u0421\u0430\u0442\u0443\u0440\u043d\u0430\u00bb.
    \u041e\u043d\u0430 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u043e\u0434\u0435\u043b\u044c \u0443\u0437\u043a\u043e\u0433\u043e \u043a\u043e\u043b\u044c\u0446\u0430
    \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u043e\u0440\u043c\u044b
    \u0438 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043b\u0430
    \u0440\u0430\u0441\u0447\u0435\u0442\u044b \u0441 \u0443\u0447\u0435\u0442\u043e\u043c \u043c\u0430\u0441\u0441\u044b
    \u0441\u0430\u043c\u043e\u0433\u043e \u043a\u043e\u043b\u044c\u0446\u0430 (\u0447\u0435\u0433\u043e
    \u043d\u0435 \u0434\u0435\u043b\u0430\u043b \u043d\u0438\u043a\u0442\u043e \u0440\u0430\u043d\u0435\u0435).
    \u0415\u0439 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u0432\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0435
    \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u044d\u0442\u043e\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438. \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0432\u044b\u0432\u043e\u0434\u044b
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439: - \u041a\u043e\u043b\u044c\u0446\u043e
    \u043c\u043e\u0436\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0432 \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0440\u0438 \u0441\u0442\u0440\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u043c
    \u043d\u0430\u0431\u043e\u0440\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432
    \u2014 \u043b\u044e\u0431\u043e\u0435 \u043e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u0435
    \u0432\u0435\u0434\u0435\u0442 \u043a \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u044e
    - \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u043a\u043e\u043b\u044c\u0446\u0430 \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0442\u043e\u0447\u043a\u0435
    \u0434\u043e\u043b\u0436\u043d\u0430 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0442\u044c
    \u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0430
    \u043f\u043b\u0430\u043d\u0435\u0442\u044b - \u041e\u043d\u0430 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u0430
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u041c\u0430\u043a\u0441\u0432\u0435\u043b\u043b\u0430
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043a\u043e\u043b\u044c\u0446\u0430 \u043d\u0435
    \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0436\u0438\u0434\u043a\u0438\u043c\u0438
    \u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u044c
    \u0438\u0437 \u0442\u0432\u0435\u0440\u0434\u044b\u0445 \u0447\u0430\u0441\u0442\u0438\u0446
    \u042d\u0442\u043e \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u043e\u0441\u044c
    \u0432 XX \u0432\u0435\u043a\u0435, \u043a\u043e\u0433\u0434\u0430 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u044b \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0438
    \u0421\u0430\u0442\u0443\u0440\u043d. --- \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f 1. \u0410\u0431\u0435\u043b\u0435\u0432\u044b
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b \u2014 \u0440\u0435\u0448\u0438\u043b\u0430
    \u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u0438\u0438
    \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430
    \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432
    \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0440\u0430\u043d\u0433\u0430 \u043a \u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430\u043c. 2. \u041e\u043f\u0442\u0438\u043a\u0430
    \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u043e\u0432 \u2014 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430
    \u043d\u0430\u0434 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0435\u043d\u0438\u044f
    \u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430 \u0432 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0440\u0435\u0434\u0430\u0445. 3. \u0422\u0435\u043e\u0440\u0438\u044f \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u0430,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u0438\u0437\u0438\u043a\u0430,
    \u043d\u0435\u0431\u0435\u0441\u043d\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430.
    --- \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438
    \u0412 1889 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e
    \u043a\u0430\u043a \u0431\u044b\u043b \u0440\u0435\u0448\u0435\u043d \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0438\u0438
    \u0436\u0435\u043d\u0449\u0438\u043d \u043a \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044e
    \u0432 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044e, \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u043e\u0439 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439 \u2014 \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a. --- \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b (\u0441 \u0431\u0438\u0431\u043b\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439)
    | \u0413\u043e\u0434 | \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    | \u041e\u0431\u043b\u0430\u0441\u0442\u044c | |-----|----------------|---------| | 1874
    | \u00abZur Theorie der partiellen Differentialgleichungen\u00bb | \u0422\u0435\u043e\u0440\u0438\u044f
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 | | 1884 | \u00ab\u00dcber die Reduction
    einer bestimmten Klasse Abel\u2019scher Integrale 3ten Ranges auf elliptische Integrale\u00bb
    | \u0410\u0431\u0435\u043b\u0435\u0432\u044b \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b
    | | 1885 | \u00abZus\u00e4tze und Bemerkungen zu Laplace\u2019s Untersuchung \u00fcber die
    Gestalt der Saturnsringe\u00bb | \u041a\u043e\u043b\u044c\u0446\u0430 \u0421\u0430\u0442\u0443\u0440\u043d\u0430
    | | 1888 | \u00ab\u0417\u0430\u0434\u0430\u0447\u0430 \u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u0442\u0432\u0435\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u043e\u043a\u043e\u043b\u043e
    \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438\u00bb
    (\u043f\u0440\u0435\u043c\u0438\u044f \u0411\u043e\u0440\u0434\u0435\u043d\u0430) | \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430
    | | 1889 | \u041c\u0435\u043c\u0443\u0430\u0440 \u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u0442\u0432\u0435\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430 (\u043f\u0440\u0435\u043c\u0438\u044f
    \u0428\u0432\u0435\u0434\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438)
    | \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 | | 1890 | \u00abSur une propri\u00e9t\u00e9
    du syst\u00e8me d\u2019equations differentielles qui definit la rotation d\u2019un corps
    solide\u00bb | \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 | \u0420\u0435\u0444\u0435\u0440\u0430\u0442\u044b
    \u043d\u0430 \u0435\u0451 \u0442\u0440\u0443\u0434\u044b \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438
    \u0442\u0430\u043a\u0438\u0435 \u043a\u043e\u0440\u0438\u0444\u0435\u0438 \u0440\u0443\u0441\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438, \u043a\u0430\u043a \u0410.\u0413. \u0421\u0442\u043e\u043b\u0435\u0442\u043e\u0432,
    \u041d.\u0415. \u0416\u0443\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0438 \u041f.\u0410.
    \u041d\u0435\u043a\u0440\u0430\u0441\u043e\u0432."
  achievementsEn: "The main scientific triumph: the task of spinning the solid body. The most significant achievement of Kovalevska is the discovery of the third classic case of resolution of the task of spinning the solid body around a fixed point, before which the fundamental task of mechanics was advanced only by Leonard Eyler and Joseph Louis Lagrange, but they considered only private symmetrical cases.In 1888, the Paris Academy of Sciences awarded her the Borden Award, the award being doubled because of the exceptional value of the study, and in 1889 she received the Royal Swedish Academy of Sciences Award for the second job of spinning a solid body.----Kosha's theorem — Kovalevsky Another fundamental work in the history of mathematics is the thesis \"To the theory of differential equations in private derivatives\" (1874). Kovalevskaya proved the existence of an analytical (holomorphic) solution to Kosha's task for differential equation systems with private derivatives.Theorem: If coefficients in the differential equation are defined and are analytical functions (as a set of degrees) and the solution is known at some point, then the solution is the only one around that point.The importance of this theorem goes far beyond pure mathematics: it forms the basis of hydrogasometallic problems, electromagnetic fluctuations, heat exchange processes, weather forecasting, the movement of celestial bodies. With the development of numerous methods, it has become particularly important for computer calculations. &quot; The Saturn Ring Study in 1885, Kovalevsky published the work &quot; Supplements and Comments to the Laplas Study on the Form of Saturn Ring. &quot;She built a mathematical model of a narrow elliptical ring and performed for the first time the calculations based on the mass of the ring itself (which no one had done before) and managed to get a second approach to this complex task.Kovalevsky's key conclusion: - The ring can only exist in equilibrium with a strictly defined set of parameters - any deviation leads to destruction - The rotation rate of the ring at each point should coincide with the speed of the planet's satellite - It confirmed the hypothesis of the Maxwell that the rings cannot be liquid and must consist of particulates. This prediction was brilliantly confirmed in the 20th century,1. Abeleva integralals have solved the problem of bringing some class of abelian integrals of the third rank to elliptical integrals. 2. A crystallry has worked on the theory of refracting and spreading light in crystallic environments. 3. Potential theory, mathematical physics, celestial mechanics.---Recognition in Russia in 1889, after the fundamental issue of allowing women to be elected to the Academy was resolved, Kovalevsky became Russia's first female respondent member of the Petersburg Academy of Sciences.- - - Basic scientific works (with bibliography) - year ~ Work name ~ Work area ~ ~ -------------------------------------------------------------------------------------------------------------------------------- ~ \"Zur Theorie der partiellen Differentialgleichungen\" ~ Integration theory ♪ 1885 ~ \"Zusätze und Bemerkungen zu Laplaces über die Gestalt der Saternsringe\" ~Saturn's ring ~ 1888 ~ \"The rotation of a solid body near a fixed point\" (Borden's prize) ~ Mechanic ~ 1889 ~ Memoir on the rotation of a solid body (Sweden Academy prize) ~ Mechanica ~ 1890 ~ \"Sur une propriété du système d ¡equations disferentieles qui definit la rotation d\\un corps solide\" ~ Mechanics on her work were corifes of Russian science such as A. G. Stolets, N. E. Zukowski and P.A. Nekrasov."
  personalLifeRu: "\u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u044e\u043d\u043e\u0441\u0442\u044c \u0421\u043e\u0444\u044c\u044f
    \u0412\u0430\u0441\u0438\u043b\u044c\u0435\u0432\u043d\u0430 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    15 \u044f\u043d\u0432\u0430\u0440\u044f 1850 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0433\u0435\u043d\u0435\u0440\u0430\u043b-\u043b\u0435\u0439\u0442\u0435\u043d\u0430\u043d\u0442\u0430
    \u0412\u0430\u0441\u0438\u043b\u0438\u044f \u041a\u043e\u0440\u0432\u0438\u043d-\u041a\u0440\u0443\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e.
    \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0440\u0435\u0434\u043d\u0438\u043c \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c:
    \u0443 \u043d\u0435\u0435 \u0431\u044b\u043b\u0438 \u0441\u0442\u0430\u0440\u0448\u0430\u044f
    \u0441\u0435\u0441\u0442\u0440\u0430 \u0410\u043d\u043d\u0430 \u0438 \u043c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0431\u0440\u0430\u0442 \u0424\u0435\u0434\u043e\u0440. \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043e\u0442\u0435\u0446, \u043e\u0447\u0435\u043d\u044c
    \u0445\u043e\u0442\u0435\u043b\u0438 \u0441\u044b\u043d\u0430, \u0438 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435
    \u0421\u043e\u0444\u044c\u0438 \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u0443
    \u043d\u0438\u0445 \u043e\u0441\u043e\u0431\u043e\u0439 \u0440\u0430\u0434\u043e\u0441\u0442\u0438.
    \u0414\u0435\u0432\u043e\u0447\u043a\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0441\u0435\u0431\u044f \u043d\u0435\u043b\u044e\u0431\u0438\u043c\u043e\u0439, \u0438\u0437-\u0437\u0430
    \u0447\u0435\u0433\u043e \u0440\u0430\u043d\u043e \u0441\u0442\u0430\u043b\u0430 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0439
    \u0438 \u0434\u0430\u0436\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \"\u0434\u0438\u043a\u0430\u0440\u043a\u0430\". \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0421\u043e\u0444\u044c\u0438 \u043f\u0440\u043e\u0448\u043b\u043e \u0432 \u0440\u043e\u0434\u043e\u0432\u043e\u043c
    \u0438\u043c\u0435\u043d\u0438\u0438 \u041f\u043e\u043b\u0438\u0431\u0438\u043d\u043e, \u043a\u0443\u0434\u0430
    \u0441\u0435\u043c\u044c\u044f \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u043f\u043e\u0441\u043b\u0435
    \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0438 \u043e\u0442\u0446\u0430. \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u0434\u0435\u0442\u0435\u0439 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0439
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u0418\u043e\u0441\u0438\u0444 \u041c\u0430\u043b\u0435\u0432\u0438\u0447.
    \u0421\u043e\u0444\u044c\u044f \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0430 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438, \u043e\u0441\u0432\u043e\u0438\u0432
    \u0437\u0430 \u0432\u043e\u0441\u0435\u043c\u044c \u043b\u0435\u0442 \u043f\u043e\u043b\u043d\u044b\u0439
    \u043a\u0443\u0440\u0441 \u043c\u0443\u0436\u0441\u043a\u043e\u0439 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438.
    \u0415\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442 \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u041d\u0438\u043a\u043e\u043b\u0430\u0439 \u0422\u044b\u0440\u0442\u043e\u0432, \u0434\u0440\u0443\u0433
    \u043e\u0442\u0446\u0430. \u041e\u043d \u0431\u044b\u043b \u0442\u0430\u043a \u043f\u043e\u0440\u0430\u0436\u0435\u043d
    \u0435\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c\u0438,
    \u0447\u0442\u043e \u043d\u0430\u0437\u0432\u0430\u043b \u0434\u0435\u0432\u043e\u0447\u043a\u0443
    \"\u043d\u043e\u0432\u044b\u043c \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c\" \u0438
    \u0443\u0431\u0435\u0436\u0434\u0430\u043b \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0430
    \u0434\u0430\u0442\u044c \u0435\u0439 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435, \u043d\u043e \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e.
    \u0423 \u0421\u043e\u0444\u044c\u0438 \u0431\u044b\u043b\u0430 \u0438 \u0440\u0430\u043d\u043d\u044f\u044f,
    \u0442\u0440\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u044e\u043d\u043e\u0448\u0435\u0441\u043a\u0430\u044f
    \u0432\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c. \u041a\u043e\u0433\u0434\u0430
    \u0435\u0439 \u0431\u044b\u043b\u043e 14 \u043b\u0435\u0442, \u0432 \u0438\u0445 \u0434\u043e\u043c\u0435
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u0431\u044b\u0432\u0430\u043b
    \u0424\u0435\u0434\u043e\u0440 \u0414\u043e\u0441\u0442\u043e\u0435\u0432\u0441\u043a\u0438\u0439,
    \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0432\u0448\u0438\u0439 \u0437\u0430 \u0441\u0442\u0430\u0440\u0448\u0435\u0439
    \u0441\u0435\u0441\u0442\u0440\u043e\u0439 \u0410\u043d\u043d\u043e\u0439. \u0421\u043e\u0444\u044c\u044f
    \u0431\u044b\u043b\u0430 \u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0430 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u0435\u043c
    \u0438 \u043e\u0447\u0435\u043d\u044c \u0441\u0442\u0440\u0430\u0434\u0430\u043b\u0430,
    \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u043d\u044f\u043b\u0430, \u0447\u0442\u043e
    \u0432\u0441\u0435 \u0435\u0433\u043e \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442
    \u0441\u0435\u0441\u0442\u0440\u0435. \u041f\u0443\u0442\u044c \u043a \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044e
    \u0438 \u0444\u0438\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0440\u0430\u043a \u0412
    1860-\u0435 \u0433\u043e\u0434\u044b \u0434\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d
    \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u0432\u044b\u0441\u0448\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e. \u0427\u0442\u043e\u0431\u044b
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0435\u0439, \u043d\u0443\u0436\u043d\u043e
    \u0431\u044b\u043b\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439
    \u0438\u043b\u0438 \u043c\u0443\u0436\u0430. \u041e\u0442\u0435\u0446 \u0421\u043e\u0444\u044c\u0438
    \u0431\u044b\u043b \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u043e\u0442\u0438\u0432. \u0422\u043e\u0433\u0434\u0430 \u0441\u0451\u0441\u0442\u0440\u044b
    \u041a\u043e\u0440\u0432\u0438\u043d-\u041a\u0440\u0443\u043a\u043e\u0432\u0441\u043a\u0438\u0435
    \u0440\u0435\u0448\u0438\u043b\u0438 \u043f\u0440\u0438\u0431\u0435\u0433\u043d\u0443\u0442\u044c
    \u043a \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435 \u0444\u0438\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e
    \u0431\u0440\u0430\u043a\u0430. \u0412\u044b\u0431\u043e\u0440 \u043f\u0430\u043b \u043d\u0430
    \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e-\u043f\u0430\u043b\u0435\u043e\u043d\u0442\u043e\u043b\u043e\u0433\u0430
    \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0441\u044f
    \u0441\u0442\u0430\u0442\u044c \u0444\u0438\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u043c\u0443\u0436\u0435\u043c
    \u0410\u043d\u043d\u044b. \u041e\u0434\u043d\u0430\u043a\u043e, \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0432\u0448\u0438\u0441\u044c
    \u0441 \u0421\u043e\u0444\u044c\u0435\u0439, \u043e\u043d \u0432\u043b\u044e\u0431\u0438\u043b\u0441\u044f
    \u0432 \u043d\u0435\u0435 \u0438 \u043d\u0430\u0441\u0442\u043e\u044f\u043b \u043d\u0430
    \u0431\u0440\u0430\u043a\u0435 \u0438\u043c\u0435\u043d\u043d\u043e \u0441 \u043d\u0435\u0439.
    \u0421\u0432\u0430\u0434\u044c\u0431\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c
    \u0432 1868 \u0433\u043e\u0434\u0443 \u0432 \u0438\u043c\u0435\u043d\u0438\u0438 \u041f\u043e\u043b\u0438\u0431\u0438\u043d\u043e.
    \u0414\u043b\u044f \u0421\u043e\u0444\u044c\u0438 \u044d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a
    \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u043c, \u0438 \u043e\u043d\u0430
    \u0441\u0447\u0438\u0442\u0430\u043b\u0430 \u043c\u0443\u0436\u0430 \u0441\u043a\u043e\u0440\u0435\u0435
    \u0434\u0440\u0443\u0433\u043e\u043c \u0438 \u0431\u0440\u0430\u0442\u043e\u043c. \u0423\u0447\u0451\u0431\u0430
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 \u0438 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0412 1869 \u0433\u043e\u0434\u0443 \u0421\u043e\u0444\u044c\u044f \u0441 \u043c\u0443\u0436\u0435\u043c
    \u0443\u0435\u0445\u0430\u043b\u0430 \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e.
    \u041e\u043d\u0430 \u0443\u0447\u0438\u043b\u0430\u0441\u044c \u0432 \u0413\u0435\u0439\u0434\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0441\u043b\u0443\u0448\u0430\u044f
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0443\u0447\u0435\u043d\u044b\u0445, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a
    \u0413\u0443\u0441\u0442\u0430\u0432 \u041a\u0438\u0440\u0445\u0433\u043e\u0444 \u0438 \u0413\u0435\u0440\u043c\u0430\u043d
    \u0413\u0435\u043b\u044c\u043c\u0433\u043e\u043b\u044c\u0446. \u0417\u0430\u0442\u0435\u043c
    \u043e\u043d\u0430 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d,
    \u043d\u043e \u0436\u0435\u043d\u0449\u0438\u043d\u044b \u0432 \u043c\u0435\u0441\u0442\u043d\u044b\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043d\u0435 \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u043b\u0438\u0441\u044c.
    \u0422\u043e\u0433\u0434\u0430 \u0421\u043e\u0444\u044c\u044f \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0430\u0441\u044c
    \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u043a \u041a\u0430\u0440\u043b\u0443 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0443,
    \u043e\u0434\u043d\u043e\u043c\u0443 \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0427\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044c\u0441\u044f
    \u043e\u0442 \u043d\u0430\u0437\u043e\u0439\u043b\u0438\u0432\u043e\u0439 \u0443\u0447\u0435\u043d\u0438\u0446\u044b,
    \u043e\u043d \u0437\u0430\u0434\u0430\u043b \u0435\u0439 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u0437\u0430\u0434\u0430\u0447.
    \u041a\u043e\u0433\u0434\u0430 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u0438\u0445 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441
    \u0431\u044b\u043b \u043f\u043e\u0440\u0430\u0436\u0435\u043d \u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0441\u044f
    \u0434\u0430\u0432\u0430\u0442\u044c \u0435\u0439 \u0447\u0430\u0441\u0442\u043d\u044b\u0435
    \u0443\u0440\u043e\u043a\u0438. \u042d\u0442\u0438 \u0437\u0430\u043d\u044f\u0442\u0438\u044f
    \u0434\u043b\u0438\u043b\u0438\u0441\u044c \u0447\u0435\u0442\u044b\u0440\u0435 \u0433\u043e\u0434\u0430
    (1870\u20131874). \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u0448\u0443\u0442\u0438\u043b\u0438, \u0447\u0442\u043e \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \"\u0432\u044b\u0432\u0435\u043b\u0430 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0438\u0437 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u0441\u0442\u0438\".
    \u041e\u043d \u0432\u044b\u0441\u043e\u043a\u043e \u0446\u0435\u043d\u0438\u043b \u0435\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0438\u043c\u0435\u043b \u043e\u0447\u0435\u043d\u044c \u043c\u0430\u043b\u043e
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u043e\u0433\u043b\u0438 \u0431\u044b \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c\u0441\u044f
    \u0441 \u043d\u0435\u0439 \u0432 \u043f\u0440\u0438\u043b\u0435\u0436\u0430\u043d\u0438\u0438
    \u0438 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u043e\u0439.
    \u0412 1874 \u0433\u043e\u0434\u0443 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0437\u0430\u043e\u0447\u043d\u043e
    \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b \u0421\u043e\u0444\u044c\u0435 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u0437\u0430 \u0442\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u044b, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u043e\u043c. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u0420\u043e\u0441\u0441\u0438\u044e \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f
    \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432 \u0420\u043e\u0441\u0441\u0438\u044e,
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430\u0441\u044c
    \u0441 \u043d\u0435\u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0438\u043c\u043e\u0439 \u0441\u0442\u0435\u043d\u043e\u0439.
    \u041e\u043d\u0430 \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043c\u0435\u0441\u0442\u043e \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0411\u043e\u043b\u0435\u0435
    \u0442\u043e\u0433\u043e, \u0435\u0439 \u0434\u0430\u0436\u0435 \u043d\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043b\u0438
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u043d\u0430 \u0412\u044b\u0441\u0448\u0438\u0445
    \u0436\u0435\u043d\u0441\u043a\u0438\u0445 \u043a\u0443\u0440\u0441\u0430\u0445. \u041f\u043e\u0447\u0442\u0438
    \u043d\u0430 \u0448\u0435\u0441\u0442\u044c \u043b\u0435\u0442 \u043e\u043d\u0430 \u043e\u0442\u043e\u0448\u043b\u0430
    \u043e\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0437\u0430\u043d\u044f\u0432\u0448\u0438\u0441\u044c
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u043e-\u043f\u0443\u0431\u043b\u0438\u0446\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e. \u041e\u043d\u0430
    \u043e\u0431\u0449\u0430\u043b\u0430\u0441\u044c \u0441\u043e \u043c\u043d\u043e\u0433\u0438\u043c\u0438
    \u0432\u0438\u0434\u043d\u044b\u043c\u0438 \u0434\u0435\u044f\u0442\u0435\u043b\u044f\u043c\u0438
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b,
    \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0414\u043c\u0438\u0442\u0440\u0438\u0439
    \u041c\u0435\u043d\u0434\u0435\u043b\u0435\u0435\u0432, \u0418\u0432\u0430\u043d \u0421\u0435\u0447\u0435\u043d\u043e\u0432,
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0411\u0443\u0442\u043b\u0435\u0440\u043e\u0432,
    \u041f\u0430\u0444\u043d\u0443\u0442\u0438\u0439 \u0427\u0435\u0431\u044b\u0448\u0435\u0432,
    \u0418\u0432\u0430\u043d \u0422\u0443\u0440\u0433\u0435\u043d\u0435\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435.
    \u0415\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043c\u0443\u0436\u0435\u043c
    \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u0441\u0442\u0430\u043b\u0438
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c\u0438. \u0412 1878 \u0433\u043e\u0434\u0443
    \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u0434\u043e\u0447\u044c,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0442\u043e\u0436\u0435 \u043d\u0430\u0437\u0432\u0430\u043b\u0438
    \u0421\u043e\u0444\u044c\u0435\u0439, \u0430 \u0434\u043e\u043c\u0430 \u0437\u0432\u0430\u043b\u0438
    \"\u0424\u0443\u0444\u0430\". \u041e\u0434\u043d\u0430\u043a\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435
    \u0434\u0435\u043b\u0430 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u0440\u0430\u0437\u043b\u0430\u0434\u0438\u043b\u0438\u0441\u044c. \u0412 1883 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u0433\u0440\u044f\u0437\u043d\u0443\u0432 \u0432 \u0434\u043e\u043b\u0433\u0430\u0445,
    \u043e\u043d \u043f\u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0436\u0438\u0437\u043d\u044c
    \u0441\u0430\u043c\u043e\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e\u043c. \u042d\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u0434\u043b\u044f \u0421\u043e\u0444\u044c\u0438 \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0435\u0439
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439. \u0422\u0440\u0438\u0443\u043c\u0444
    \u0432 \u0428\u0432\u0435\u0446\u0438\u0438 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u041e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c \u0431\u0435\u0437 \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u0441 \u043f\u044f\u0442\u0438\u043b\u0435\u0442\u043d\u0435\u0439 \u0434\u043e\u0447\u0435\u0440\u044c\u044e,
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d \u043a \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0443.
    \u0415\u0435 \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u0438 \u0448\u0432\u0435\u0434\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0413\u0435\u0441\u0442\u0430 \u041c\u0438\u0442\u0442\u0430\u0433-\u041b\u0435\u0444\u0444\u043b\u0435\u0440
    \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435
    \u0443\u0441\u0438\u043b\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438
    \u0435\u0439 \u043c\u0435\u0441\u0442\u043e. \u0412 1884 \u0433\u043e\u0434\u0443 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0430 \u0432
    \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c.
    \u041f\u0435\u0440\u0432\u044b\u0439 \u0433\u043e\u0434 \u043e\u043d\u0430 \u0447\u0438\u0442\u0430\u043b\u0430
    \u043b\u0435\u043a\u0446\u0438\u0438 \u043d\u0430 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c
    \u044f\u0437\u044b\u043a\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0435\u0440\u0435\u0448\u043b\u0430
    \u043d\u0430 \u0448\u0432\u0435\u0434\u0441\u043a\u0438\u0439. \u0412 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u0441\u0431\u043b\u0438\u0437\u0438\u043b\u0430\u0441\u044c
    \u0441 \u0431\u0440\u0430\u0442\u043e\u043c \u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0433\u043e
    \u043c\u0443\u0436\u0430, \u0441\u043e\u0446\u0438\u043e\u043b\u043e\u0433\u043e\u043c \u041c\u0430\u043a\u0441\u0438\u043c\u043e\u043c
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0438\u043c. \u041e\u043d \u0431\u044b\u043b
    \u0432 \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u0438, \u0438 \u0421\u043e\u0444\u044c\u044f
    \u043f\u043e\u043c\u043e\u0433\u043b\u0430 \u0435\u043c\u0443 \u0443\u0441\u0442\u0440\u043e\u0438\u0442\u044c\u0441\u044f
    \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0418\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u0438
    \u0432 \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c.
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0438\u0439 \u0441\u0434\u0435\u043b\u0430\u043b
    \u0435\u0439 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043d\u043e
    \u0421\u043e\u0444\u044c\u044f \u043e\u0442\u0432\u0435\u0442\u0438\u043b\u0430 \u043e\u0442\u043a\u0430\u0437\u043e\u043c.
    \u041e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u043d\u0438
    \u0440\u0430\u0441\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u0432 1890 \u0433\u043e\u0434\u0443
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u043f\u043e \u0420\u0438\u0432\u044c\u0435\u0440\u0435.
    \u0412 1888 \u0433\u043e\u0434\u0443 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0434\u043e\u0431\u0438\u043b\u0430\u0441\u044c \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0442\u0440\u0438\u0443\u043c\u0444\u0430:
    \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \"\u0417\u0430\u0434\u0430\u0447\u0430
    \u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0442\u0432\u0435\u0440\u0434\u043e\u0433\u043e
    \u0442\u0435\u043b\u0430 \u0432\u043e\u043a\u0440\u0443\u0433 \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u0438\" \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b\u0430
    \u0435\u0439 \u043f\u0440\u0435\u043c\u0438\u044e \u0411\u043e\u0440\u0434\u0435\u043d\u0430,
    \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432 \u043f\u0440\u0438\u0437\u043e\u0432\u0443\u044e
    \u0441\u0443\u043c\u043c\u0443 \u0432\u0434\u0432\u043e\u0435 \u0432\u0432\u0438\u0434\u0443
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f. \u0412 1889 \u0433\u043e\u0434\u0443 \u0437\u0430
    \u0432\u0442\u043e\u0440\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430 \u0442\u0443
    \u0436\u0435 \u0442\u0435\u043c\u0443 \u043e\u043d\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430
    \u043f\u0440\u0435\u043c\u0438\u044e \u0428\u0432\u0435\u0434\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a. \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443,
    \u043f\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044e
    \u041f\u0430\u0444\u043d\u0443\u0442\u0438\u044f \u0427\u0435\u0431\u044b\u0448\u0435\u0432\u0430
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u043e\u0432,
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u0431\u044b\u043b\u0430
    \u0438\u0437\u0431\u0440\u0430\u043d\u0430 \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a, \u0441\u0442\u0430\u0432 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438,
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u043e\u0439 \u044d\u0442\u043e\u0433\u043e
    \u0437\u0432\u0430\u043d\u0438\u044f. \u0421\u043c\u0435\u0440\u0442\u044c \u0421\u043e\u0444\u044c\u044f
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u0443\u043c\u0435\u0440\u043b\u0430
    \u0432 \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0435 \u0441\u0438\u043b \u0438 \u0441\u043b\u0430\u0432\u044b.
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1891 \u0433\u043e\u0434\u0430 \u043e\u043d\u0430
    \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u043b\u0430\u0441\u044c \u0438\u0437 \u041d\u0438\u0446\u0446\u044b,
    \u0433\u0434\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b\u0430 \u0440\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0435\u043d\u0441\u043a\u0438\u0435
    \u043a\u0430\u043d\u0438\u043a\u0443\u043b\u044b \u0432\u043c\u0435\u0441\u0442\u0435 \u0441
    \u041c\u0430\u043a\u0441\u0438\u043c\u043e\u043c \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0438\u043c.
    \u041f\u043e \u0434\u043e\u0440\u043e\u0433\u0435 \u043e\u043d\u0430 \u0441\u0438\u043b\u044c\u043d\u043e
    \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0438\u043b\u0430\u0441\u044c. 10 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    1891 \u0433\u043e\u0434\u0430 \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435
    \u043e\u043d\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c \u043e\u0442
    \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 41 \u0433\u043e\u0434\u0430. \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d\u0430
    \u043e\u043d\u0430 \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435."
  personalLifeEn: "She was born in Moscow on January 15, 1850, in the family of Lieutenant General Vasilia Corvin-Krukovsky, and was a middle-aged child, with an older sister Anna and a younger brother, Fedor, and parents, especially the father, wanted a son, and the appearance of Sophia did not make them very happy.Sophia's childhood took place in the Polibino estate, where the family moved after her father's resignation. The children were educated by a hometeacher, Joseph Malevich. Sophia showed brilliant skills, with eight years of complete master's degree in masculinity. Her math talent was observed by Professor Nikolai Tyrtov, a friend of her father, who was so impressed by her abilities that he called the girl \"New Pascal\" and convinced the general to give her a serious education, but unsuccessfully.Sophia had an early, touching young love, when she was 14 years old, had a few visits to their home by Fedor Dostoevsky, who cared for Anna's older sister, and Sophia was enthralled by the writer and suffered a great deal when she realized that all his attention belonged to her sister.To get an education abroad, you had to have the consent of your parents or your husband. Sophia's father was categorically opposed. Then the sisters of Corwin-Krukovsky decided to resort to the practice of sham marriage.The wedding took place in 1868 at the Polybino estate, where she remained in formal form for a long time, and she considered her husband more of a friend and brother. She studied in Europe and worked in 1869 with her husband in Germany. She studied at Heidelberg University, giving lectures to distinguished scholars such as Gustav Kirhgoff and Herman Helmgoltz, and then moved to Berlin, but women were not allowed to attend the local university.Sophia went directly to Carl Weyerstrass, one of the greatest mathematicians of the time, to get rid of a hard-working student, and he gave her a few difficult tasks. When Kovalevsky brought them brilliant solutions, Weyerstrass was impressed and agreed to give her private lessons. These classes lasted four years (1870-1874).He appreciated her abilities and said that he had very few students who could compare to her in the care and passion of science. In 1874, Göttingen University awarded Sofie Kovalevsk Ph.D. in absentia for three jobs presented by Weyerstrasss, returning to Russia and a tragedy, returning to Russia, Kovalevsky faced an insurmountable wall, unable to gain a seat at the University of Petersburg.Moreover, she was not even allowed to teach at the Higher Women's Courses, and she left mathematics for almost six years, engaging in literary and publicistic activities, and interacting with many prominent figures in science and culture, such as Dmitry Mendeleyev, Ivan Sechenov, Alexander Butlerov, Paphnut Chebshev, Ivan Turgenev and others, and her relationship with her husband has become real over time.In 1878, they had a daughter named Sophia, who was also called \"Fufa\", but the financial affairs of Vladimir Kovalevsky were broken. In 1883, after he was in debt, he committed suicide, and this was a great tragedy for Sophia.Her teacher and Swedish mathematician Gesta Mittag-Lefler made great efforts to find her place, and in 1884 Kovalevskaya was invited to Stockholm University, where she became a professor. She lectured in German for the first year and then transferred to Sweden.They became deeply attached, and Kovalevsky proposed to her, but Sophia refused, and they finally broke up in 1890 during a joint trip to Riviera.In 1888, Kovalevskaya achieved the greatest scientific triumph: for the work \"The task of spinning a solid body around a fixed point\", the Paris Academy of Sciences awarded her the Borden Award, doubling the prize because of the exceptional value of discovery.In the same year, according to a submission by Paphnuty Chebshev and other academicians, Kovalevskaya was elected a respondent member of the Petersburg Academy of Sciences, becoming the first woman in Russia to be awarded this title; the death of Sophia Kovalevsky died in the prime of strength and glory; in early 1891, she returned from Nice, where she spent Christmas holidays with Maxim Kovalevsky, and she became very cold on the road.On 10 February 1891, she died of pulmonary inflammation at the age of 41 in Stockholm, where she was buried in Stockholm."
  shortBioRu: "\u0421\u043e\u0444\u044c\u044f \u0412\u0430\u0441\u0438\u043b\u044c\u0435\u0432\u043d\u0430
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f (\u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f
    \u041a\u043e\u0440\u0432\u0438\u043d-\u041a\u0440\u0443\u043a\u043e\u0432\u0441\u043a\u0430\u044f)
    \u2014 \u0444\u0438\u0433\u0443\u0440\u0430, \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0437\u043c\u0430
    \u0438 \u0431\u043e\u0440\u044c\u0431\u044b \u0437\u0430 \u043f\u0440\u0430\u0432\u043e
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043d\u0430\u0443\u043a\u043e\u0439.
    \u041e\u043d\u0430 \u0432\u043e\u0448\u043b\u0430 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e
    \u043a\u0430\u043a \u043f\u0435\u0440\u0432\u0430\u044f \u0432 \u043c\u0438\u0440\u0435
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430-\u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043f\u0435\u0440\u0432\u0430\u044f
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430 \u2014 \u0447\u043b\u0435\u043d-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a. \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0435\u0451 \u0436\u0438\u0437\u043d\u0438:
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    (1850\u20131866) \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u043c\u044c\u044f:
    \u0421\u043e\u0444\u044c\u044f \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c 15 \u044f\u043d\u0432\u0430\u0440\u044f
    1850 \u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0433\u0435\u043d\u0435\u0440\u0430\u043b-\u043b\u0435\u0439\u0442\u0435\u043d\u0430\u043d\u0442\u0430
    \u0430\u0440\u0442\u0438\u043b\u043b\u0435\u0440\u0438\u0438 \u0412\u0430\u0441\u0438\u043b\u0438\u044f
    \u0412\u0430\u0441\u0438\u043b\u044c\u0435\u0432\u0438\u0447\u0430 \u041a\u043e\u0440\u0432\u0438\u043d-\u041a\u0440\u0443\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0438 \u0415\u043b\u0438\u0437\u0430\u0432\u0435\u0442\u044b \u0424\u0451\u0434\u043e\u0440\u043e\u0432\u043d\u044b,
    \u0443\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0439 \u0428\u0443\u0431\u0435\u0440\u0442.
    \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u043d\u0435 \u0431\u044b\u043b\u0438 \u0440\u0430\u0434\u044b
    \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e \u0434\u043e\u0447\u0435\u0440\u0438,
    \u043e\u0436\u0438\u0434\u0430\u044f \u0441\u044b\u043d\u0430, \u0438 \u0421\u043e\u0444\u044c\u044f
    \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0441\u0435\u0431\u044f \u043d\u0435\u043b\u044e\u0431\u0438\u043c\u044b\u043c \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c,
    \u0437\u0430 \u0447\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435
    \"\u0434\u0438\u043a\u0430\u0440\u043a\u0430\". \u041f\u0440\u0435\u0434\u043a\u0438: \u0421\u044b\u0433\u0440\u0430\u043b\u0438
    \u0432\u0430\u0436\u043d\u0443\u044e \u0440\u043e\u043b\u044c \u0432 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438
    \u0435\u0451 \u0442\u0430\u043b\u0430\u043d\u0442\u0430. \u041f\u043e \u043e\u0442\u0446\u0443
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u0442\u043e\u043c\u043a\u043e\u043c
    \u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u044f
    \u041c\u0430\u0442\u0432\u0435\u044f \u041a\u043e\u0440\u0432\u0438\u043d\u0430, \u0430
    \u043f\u043e \u043c\u0430\u0442\u0435\u0440\u0438 \u2014 \u0432\u043d\u0443\u0447\u043a\u043e\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0438 \u0433\u0435\u043e\u0434\u0435\u0437\u0438\u0441\u0442\u0430 \u0424\u0451\u0434\u043e\u0440\u0430
    \u0424\u0451\u0434\u043e\u0440\u043e\u0432\u0438\u0447\u0430 \u0428\u0443\u0431\u0435\u0440\u0442\u0430
    \u0438 \u043f\u0440\u0430\u0432\u043d\u0443\u0447\u043a\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430
    \u0424\u0451\u0434\u043e\u0440\u0430 \u0418\u0432\u0430\u043d\u043e\u0432\u0438\u0447\u0430
    \u0428\u0443\u0431\u0435\u0440\u0442\u0430. \u041f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432
    \u0438\u043c\u0435\u043d\u0438\u0435: \u0412 1858 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u0432\u044b\u0445\u043e\u0434\u0430 \u043e\u0442\u0446\u0430 \u0432 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0443,
    \u0441\u0435\u043c\u044c\u044f \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430 \u0432
    \u0440\u043e\u0434\u043e\u0432\u043e\u0435 \u043f\u043e\u043c\u0435\u0441\u0442\u044c\u0435
    \u041f\u043e\u043b\u0438\u0431\u0438\u043d\u043e \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043a\u043e\u0439
    \u0433\u0443\u0431\u0435\u0440\u043d\u0438\u0438 (\u043d\u044b\u043d\u0435 \u041f\u0441\u043a\u043e\u0432\u0441\u043a\u0430\u044f
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c). \u0417\u0434\u0435\u0441\u044c \u043f\u0440\u043e\u0448\u043b\u0438
    \u0434\u0435\u0442\u0441\u043a\u0438\u0435 \u0433\u043e\u0434\u044b \u0421\u043e\u0444\u044c\u0438.
    \u0414\u043e\u043c\u0430\u0448\u043d\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u0412\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435\u043c \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0430\u0441\u044c
    \u0441\u0442\u0440\u043e\u0433\u0430\u044f \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0430\u044f
    \u0433\u0443\u0432\u0435\u0440\u043d\u0430\u043d\u0442\u043a\u0430, \u0430 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435\u043c
    \u2014 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c
    \u0418\u043e\u0441\u0438\u0444 \u0418\u0433\u043d\u0430\u0442\u044c\u0435\u0432\u0438\u0447
    \u041c\u0430\u043b\u0435\u0432\u0438\u0447. \u0417\u0430 \u0432\u043e\u0441\u0435\u043c\u044c
    \u043b\u0435\u0442 \u043e\u043d\u0430 \u043e\u0441\u0432\u043e\u0438\u043b\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443
    \u043c\u0443\u0436\u0441\u043a\u0438\u0445 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0439.
    \"\u0422\u0430\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f\" \u0441\u0442\u0435\u043d\u0430:
    \u041e\u0434\u0438\u043d \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432
    \u0434\u0435\u0442\u0441\u0442\u0432\u0430. \u0412 \u0435\u0451 \u043a\u043e\u043c\u043d\u0430\u0442\u0435
    \u043d\u0435 \u0445\u0432\u0430\u0442\u0438\u043b\u043e \u043e\u0431\u043e\u0435\u0432,
    \u0438 \u0441\u0442\u0435\u043d\u0443 \u043e\u043a\u043b\u0435\u0438\u043b\u0438 \u043b\u0438\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438
    \u043b\u0435\u043a\u0446\u0438\u044f\u043c\u0438 \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430 \u041e\u0441\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e.
    \u0421\u043e\u0444\u044c\u044f \u0447\u0430\u0441\u0430\u043c\u0438 \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u044b\u0432\u0430\u043b\u0430
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \"\u0432\u0440\u0435\u0437\u0430\u043b\u0438\u0441\u044c\"
    \u0435\u0439 \u0432 \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u043b\u0438 \u0431\u0443\u0434\u0443\u0449\u0435\u0435
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435. \u041f\u0435\u0440\u0432\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438:
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u041d\u0438\u043a\u043e\u043b\u0430\u0439
    \u0422\u044b\u0440\u0442\u043e\u0432, \u0434\u0440\u0443\u0433 \u043e\u0442\u0446\u0430,
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0434\u0430\u0440 \u0434\u0435\u0432\u043e\u0447\u043a\u0438, \u043a\u043e\u0433\u0434\u0430
    \u0442\u0430 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0438\u0437\u0443\u0447\u0430\u044f \u0435\u0433\u043e \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u0444\u0438\u0437\u0438\u043a\u0438, \u0440\u0430\u0437\u043e\u0431\u0440\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f\u0445. \u041e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u0435\u0451 \"\u043d\u043e\u0432\u044b\u043c \u041f\u0430\u0441\u043a\u0430\u043b\u0435\u043c\"
    \u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043b \u043e\u0442\u0446\u0443
    \u0434\u0430\u0442\u044c \u0435\u0439 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435, \u043d\u043e \u0433\u0435\u043d\u0435\u0440\u0430\u043b
    \u0441\u0447\u0435\u043b \u044d\u0442\u043e \u043d\u0435\u0443\u043c\u0435\u0441\u0442\u043d\u044b\u043c
    \u0434\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d\u044b. \u042e\u043d\u043e\u0441\u0442\u044c,
    \u0444\u0438\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0440\u0430\u043a \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0432 \u0415\u0432\u0440\u043e\u043f\u0435 (1866\u20131874) \u041f\u0443\u0442\u044c \u043a
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044e: \u0412 1866 \u0433\u043e\u0434\u0443
    \u0421\u043e\u0444\u044c\u044f \u043d\u0430\u0447\u0430\u043b\u0430 \u0431\u0440\u0430\u0442\u044c
    \u0447\u0430\u0441\u0442\u043d\u044b\u0435 \u0443\u0440\u043e\u043a\u0438 \u043f\u043e \u0432\u044b\u0441\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0443 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0430 \u0410.\u041d. \u0421\u0442\u0440\u0430\u043d\u043d\u043e\u043b\u044e\u0431\u0441\u043a\u043e\u0433\u043e
    \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0432\u044b\u0441\u0448\u0435\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0443\u0442\u044c
    \u0432 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u0435 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u044b
    \u0434\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d \u0431\u044b\u043b \u0437\u0430\u043a\u0440\u044b\u0442.
    \u041c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0443\u0435\u0445\u0430\u0442\u044c
    \u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0443, \u043d\u043e \u0434\u043b\u044f
    \u044d\u0442\u043e\u0433\u043e \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043e\u0442\u0446\u0430 \u0438\u043b\u0438
    \u043c\u0443\u0436\u0430. \u0424\u0438\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0440\u0430\u043a:
    \u0412\u043c\u0435\u0441\u0442\u0435 \u0441 \u0441\u0435\u0441\u0442\u0440\u043e\u0439 \u0410\u043d\u043d\u043e\u0439,
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u043e\u0439 \u0438\u0434\u0435\u044f\u043c\u0438
    \u044d\u043c\u0430\u043d\u0441\u0438\u043f\u0430\u0446\u0438\u0438, \u0421\u043e\u0444\u044c\u044f
    \u0440\u0435\u0448\u0438\u043b\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0438\u0442\u044c
    \u0444\u0438\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0440\u0430\u043a. \u0412\u044b\u0431\u043e\u0440
    \u043f\u0430\u043b \u043d\u0430 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e
    \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u041e\u043d\u0443\u0444\u0440\u0438\u0435\u0432\u0438\u0447\u0430
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e. \u041e\u043d \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0441\u044f,
    \u043d\u043e \u0432\u043b\u044e\u0431\u0438\u043b\u0441\u044f \u0432 \u0421\u043e\u0444\u044c\u044e
    \u0441 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u0430
    \u0438 \u043d\u0430\u0441\u0442\u043e\u044f\u043b \u043d\u0430 \u0431\u0440\u0430\u043a\u0435
    \u0438\u043c\u0435\u043d\u043d\u043e \u0441 \u043d\u0435\u0439. \u0421\u0432\u0430\u0434\u044c\u0431\u0430
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c \u0432 1868 \u0433\u043e\u0434\u0443.
    \u0413\u043e\u0434\u044b \u0443\u0447\u0435\u0431\u044b: \u0413\u0435\u0439\u0434\u0435\u043b\u044c\u0431\u0435\u0440\u0433
    (1869\u20131870): \u041f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0430
    \u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0443 \u0421\u043e\u0444\u044c\u044f \u0434\u043e\u0431\u0438\u043b\u0430\u0441\u044c
    \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u043b\u0443\u0448\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0432 \u0413\u0435\u0439\u0434\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0443 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432. \u0411\u0435\u0440\u043b\u0438\u043d
    (1870\u20131874): \u0416\u0435\u043d\u0449\u0438\u043d\u0430\u043c \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0432\u0445\u043e\u0434
    \u0431\u044b\u043b \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d. \u0422\u043e\u0433\u0434\u0430
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0430\u0441\u044c
    \u043a \u0432\u0435\u043b\u0438\u043a\u043e\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u041a\u0430\u0440\u043b\u0443 \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0443.
    \u0427\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044c\u0441\u044f
    \u043e\u0442 \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0439 \u0443\u0447\u0435\u043d\u0438\u0446\u044b,
    \u043e\u043d \u0434\u0430\u043b \u0435\u0439 \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d\u0430
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u0440\u0435\u0448\u0438\u043b\u0430. \u0412\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u043d\u044b\u0439
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441 \u0441\u0442\u0430\u043b
    \u0434\u0430\u0432\u0430\u0442\u044c \u0435\u0439 \u0447\u0430\u0441\u0442\u043d\u044b\u0435
    \u0443\u0440\u043e\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b\u0438\u0441\u044c
    \u0447\u0435\u0442\u044b\u0440\u0435 \u0433\u043e\u0434\u0430. \u0414\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c: \u0412 1874 \u0433\u043e\u0434\u0443, \u043c\u0438\u043d\u0443\u044f
    \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b
    \u0421\u043e\u0444\u044c\u0435 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u0437\u0430 \u0442\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u044b, \u0432 \u0442\u043e\u043c
    \u0447\u0438\u0441\u043b\u0435 \u043f\u043e \"\u041a \u0442\u0435\u043e\u0440\u0438\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432 \u0447\u0430\u0441\u0442\u043d\u044b\u0445
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445\" \u0438 \"\u041e \u0444\u043e\u0440\u043c\u0435
    \u043a\u043e\u043b\u044c\u0446\u0430 \u0421\u0430\u0442\u0443\u0440\u043d\u0430\". \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0432 \u0420\u043e\u0441\u0441\u0438\u044e, \u043b\u0438\u0447\u043d\u044b\u0435 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438
    \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    (1874\u20131891) \u041d\u0435\u0443\u0434\u0430\u0447\u0438 \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0435:
    \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432 \u0420\u043e\u0441\u0441\u0438\u044e
    \u0432 1874 \u0433\u043e\u0434\u0443, \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430\u0441\u044c \u0441 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u0438\u0435\u043c.
    \u0415\u0439 \u043d\u0435 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u043c\u0435\u0441\u0442\u0430 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0438 \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u0430
    \u043f\u043e\u0447\u0442\u0438 \u043d\u0430 6 \u043b\u0435\u0442 \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c: \u0424\u0438\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0440\u0430\u043a
    \u043f\u0435\u0440\u0435\u0440\u043e\u0441 \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439.
    \u0412 1878 \u0433\u043e\u0434\u0443 \u0443 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c
    \u0434\u043e\u0447\u044c \u0421\u043e\u0444\u044c\u044f (\"\u0424\u0443\u0444\u0430\").
    \u041e\u0434\u043d\u0430\u043a\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435
    \u0434\u0435\u043b\u0430 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u0440\u0430\u0437\u043b\u0430\u0434\u0438\u043b\u0438\u0441\u044c. \u0412 1883 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u0433\u0440\u044f\u0437\u043d\u0443\u0432 \u0432 \u0434\u043e\u043b\u0433\u0430\u0445,
    \u043e\u043d \u043f\u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0436\u0438\u0437\u043d\u044c
    \u0441\u0430\u043c\u043e\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e\u043c, \u0447\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u0443\u0434\u0430\u0440\u043e\u043c
    \u0434\u043b\u044f \u0421\u043e\u0444\u044c\u0438. \u0422\u0440\u0438\u0443\u043c\u0444
    \u0432 \u0428\u0432\u0435\u0446\u0438\u0438: \u0412 1884 \u0433\u043e\u0434\u0443, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0443\u0441\u0438\u043b\u0438\u044f\u043c \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430
    \u0438 \u0448\u0432\u0435\u0434\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u041c\u0438\u0442\u0442\u0430\u0433-\u041b\u0435\u0444\u0444\u043b\u0435\u0440\u0430, \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u041e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0432\u043e\u0439 \u0432
    \u043c\u0438\u0440\u0435 \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439, \u0437\u0430\u043d\u044f\u0432\u0448\u0435\u0439
    \u044d\u0442\u0443 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c. \u041f\u0435\u0440\u0432\u044b\u0439
    \u0433\u043e\u0434 \u043e\u043d\u0430 \u0447\u0438\u0442\u0430\u043b\u0430 \u043b\u0435\u043a\u0446\u0438\u0438
    \u043f\u043e-\u043d\u0435\u043c\u0435\u0446\u043a\u0438, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u043f\u0435\u0440\u0435\u0448\u043b\u0430
    \u043d\u0430 \u0448\u0432\u0435\u0434\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a.
    \u0412\u0435\u0440\u0448\u0438\u043d\u0430 \u0441\u043b\u0430\u0432\u044b (1888\u20131889):
    \u0412 1888 \u0433\u043e\u0434\u0443 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b\u0430
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u044e
    \u0411\u043e\u0440\u0434\u0435\u043d\u0430 \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0443,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d\u0430 \u0440\u0435\u0448\u0438\u043b\u0430
    \"\u0437\u0430\u0434\u0430\u0447\u0443 \u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438
    \u0442\u0432\u0435\u0440\u0434\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u0432\u043e\u043a\u0440\u0443\u0433
    \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438\",
    \u043e\u0442\u043a\u0440\u044b\u0432 \u0442\u0440\u0435\u0442\u0438\u0439 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u044d\u0442\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438. \u0412 1889 \u0433\u043e\u0434\u0443 \u043e\u043d\u0430
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430 \u043f\u0440\u0435\u043c\u0438\u044e \u0428\u0432\u0435\u0434\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0438, \u043d\u0430\u043a\u043e\u043d\u0435\u0446,
    \u0431\u044b\u043b\u0430 \u0438\u0437\u0431\u0440\u0430\u043d\u0430 \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a, \u0441\u0442\u0430\u0432 \u043f\u0435\u0440\u0432\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439, \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d\u043d\u043e\u0439
    \u044d\u0442\u043e\u0439 \u0447\u0435\u0441\u0442\u0438 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438.
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b: \u0412
    \u043a\u043e\u043d\u0446\u0435 1880-\u0445 \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c
    \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u0441\u0442\u0430\u043b
    \u0441\u043e\u0446\u0438\u043e\u043b\u043e\u0433 \u041c\u0430\u043a\u0441\u0438\u043c \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0438\u0439
    (\u043e\u0434\u043d\u043e\u0444\u0430\u043c\u0438\u043b\u0435\u0446 \u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0433\u043e
    \u043c\u0443\u0436\u0430). \u041e\u043d\u0438 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u043f\u043e\u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f, \u043d\u043e \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0442\u0430\u043a \u0438 \u043d\u0435
    \u043e\u0444\u043e\u0440\u043c\u0438\u043b\u0438. \u0421\u043c\u0435\u0440\u0442\u044c:
    \u0421\u043e\u0444\u044c\u044f \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c 10 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    (29 \u044f\u043d\u0432\u0430\u0440\u044f \u043f\u043e \u0441\u0442\u0430\u0440\u043e\u043c\u0443
    \u0441\u0442\u0438\u043b\u044e) 1891 \u0433\u043e\u0434\u0430 \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435
    \u043e\u0442 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445,
    \u0432\u0441\u0435\u0433\u043e \u0432 41 \u0433\u043e\u0434. \u041e\u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0438\u043b\u0430\u0441\u044c
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u0438\u0437 \u043f\u043e\u0435\u0437\u0434\u043a\u0438 \u043f\u043e \u0420\u0438\u0432\u044c\u0435\u0440\u0435.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u043c \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c.
    \u041e\u043d\u0430 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043f\u043e\u0441\u043b\u0435
    \u0441\u0435\u0431\u044f \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043f\u043e\u0432\u0435\u0441\u0442\u044c \"\u0412\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f
    \u0434\u0435\u0442\u0441\u0442\u0432\u0430\" \u0438 \u0440\u043e\u043c\u0430\u043d \"\u041d\u0438\u0433\u0438\u043b\u0438\u0441\u0442\u043a\u0430\".
    \u0415\u0451 \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u043b\u044b
    \u0432\u043e\u043b\u0438, \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f
    \u0433\u0435\u043d\u0438\u044f \u0441 \u043f\u0440\u0435\u0434\u0440\u0430\u0441\u0441\u0443\u0434\u043a\u0430\u043c\u0438
    \u044d\u043f\u043e\u0445\u0438 \u0438 \u043f\u043e\u0438\u0441\u043a\u0430 \u043b\u0438\u0447\u043d\u043e\u0433\u043e
    \u0441\u0447\u0430\u0441\u0442\u044c\u044f."
  shortBioEn: "Sophia Vasilievna Kovalevskaya (born Corwin-Krukovskaya) is a figure whose life was full of dramatism and the struggle for the right to study science, and whose history was the first female professor of mathematics in the world and the first female respondent member of the Petersburg Academy of Sciences.Here's a detailed timeline of her life: Childhood and Origin (1850-1866) Birth and Family: Sophia was born on January 15, 1850 in Moscow, in the family of Lieutenant General Vasilievich Corwin-Krukovsky and Elizabeth Fyodorovna, born in Schubert, and her parents were not happy to see her daughter waiting for her son, and Sofia felt unloved as a child, for which she became known as \"the savage\".The ancestors: She played an important role in shaping her talent. She was a descendant of the Hungarian King Matway Corwin, and the mother was the granddaughter of the famous mathematician and surveyor Fyodor Fyodorovich Schubert, and the great-granddaughter of astronomer Fyodor Ivanovich Schubert.Home education: A strict English governess and a hometeacher, Joseph Ignatyevich Malewich, taught the masculine gymnasium programme in eight years. The \"Mystery\" wall: One of the key episodes of childhood. There were no wallpapers in her room, and the wall was taped with lytographed lectures on differential and integrated calculations of the Academy of Ostrobgrad.Sophia spent hours looking at formulas that \"crashed\" her in memory and greatly facilitated her future learning. The first abilities: Professor Nikolai Tyrtov, a friend of her father, noticed the math gift of the girl when she, herself, had studied his physics textbook, understood it in trignometric terms, called it \"new Pascal\" and recommended that her father give her a serious education, but the general found it inappropriate for a woman.Youth, fake marriage and education in Europe (1866 - 1874): In 1866, Sofia began taking private classes in higher mathematics from the famous teacher A.N. Strangel in Petersburg, but the way to higher education for women was closed for women in Russia, and it was possible to go abroad but required the permission of the father or husband.Factual marriage: Together with Anna's sister, who was passionate about emancipation, Sofia decided to marry a fake, and the young scientist Vladimir Onufrievich Kovalevsky took the choice. He agreed, but fell in love with Sofia at first sight and insisted on marriage with her.Years of study: Heidelberg (1869 - 1870): After moving abroad, Sophia obtained permission to attend lectures at Heidelberg University from prominent mathematicians. Berlin (1870 - 1874): Women were not allowed to enter Berlin University. Kovalevsky then turned to the great mathematician Carl Weyerstress, and to get rid of a persistent student, he gave her the daunting tasks she had brilliantly accomplished.In 1874, Göttingen University awarded Sophie Kovalev University of Philosophy for three jobs, including \"Corresponding to the theory of differential equations in private derivatives\" and \"On the shape of Saturn's ring\".Returning to Russia, personal tragedies and scientific recognition (1874-1891), failed in the home country: Returning to Russia in 1874, Kovalevsky faced rejection, was not given a university seat, and had to leave active scientific activity for almost six years. Family life: Factual marriage has grown into a real marriage. In 1878, their daughter Sophia (Fufa) was born. However, Vladimir Kovalevsky's financial affairs have been disrupted.In 1883, he committed suicide in debt, which was a serious blow to Sophia.1888–1889: In 1888, the Paris Academy of Sciences awarded the Kovalev Borden Prize for a job in which it decided to \"turn the solid body around a fixed point\" by opening the third classic case of this task.In 1889, she received the Swedish Academy of Sciences Award and was finally elected as a respondent member of the Petersburg Academy of Sciences, becoming the first woman to have this honour in Russia.Personal life and death in the last years: At the end of 1880, a close friend of Kovalevskaya became a socialist, Maxim Kovalevsky (one-named deceased husband), who planned to get married but never officially married. Death: Sofia Kovalevsky died on February 10 (29 January old style) in Stockholm in 1891 from pulmonary inflammation, only 41 years old. She had a cold on her return from a trip to Riviera.Interestingly, Kovalevskaya was not only a mathematician, but also a talented literary writer, who left behind the autobiographical tale of \"Memories of Childhood\" and the novel \"Nigilist.\" Her life is a story of remarkable willpower, a clash of genius with the prejudices of the era and a search for personal happiness."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0421\u043e\u0444\u044c\u0438 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0439, \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432 \u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445
    \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0451 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u043f\u043e\u0445\u043e\u0436\u0435\u0439 \u043d\u0430 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0440\u043e\u043c\u0430\u043d. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438\u0437 \u043d\u0438\u0445.\n\n\U0001F9F1 \"\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u043e\u0438\" \u0438 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e \u041f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0443\u0440\u044c\u0451\u0437
    \u0438\u0437 \u0435\u0451 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u2014 \u044d\u0442\u043e
    \u0441\u043b\u0443\u0447\u0430\u0439 \u0441 \u043e\u0431\u043e\u044f\u043c\u0438. \u041a\u043e\u0433\u0434\u0430
    \u0441\u0435\u043c\u044c\u044f \u0436\u0438\u043b\u0430 \u0432 \u0438\u043c\u0435\u043d\u0438\u0438
    \u041f\u0430\u043b\u0438\u0431\u0438\u043d\u043e, \u043d\u0430 \u043e\u0434\u043d\u0443
    \u0438\u0437 \u0441\u0442\u0435\u043d \u0432 \u0434\u0435\u0442\u0441\u043a\u043e\u0439
    \u043a\u043e\u043c\u043d\u0430\u0442\u0435 \u043d\u0435 \u0445\u0432\u0430\u0442\u0438\u043b\u043e
