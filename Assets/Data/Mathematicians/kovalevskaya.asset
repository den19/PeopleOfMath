    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a\u0430 \u041e\u0441\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0433\u043e.
    \u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0430\u044f \u0421\u043e\u043d\u044f \u0447\u0430\u0441\u0430\u043c\u0438
    \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u044b\u0432\u0430\u043b\u0430 \u043d\u0435\u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0435
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u0438 \u043e\u043d\u0438 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u0432\u0440\u0435\u0437\u0430\u043b\u0438\u0441\u044c \u0435\u0439 \u0432 \u043f\u0430\u043c\u044f\u0442\u044c.
    \u0413\u043e\u0434\u044b \u0441\u043f\u0443\u0441\u0442\u044f, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d\u0430 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
