    \u041a\u0430\u0440\u0442\u0430\u043d\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e. \u0415\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u043d\u043e\u0432\u044b\u0439
    \u044f\u0437\u044b\u043a \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0438. \u0422\u0435\u043e\u0440\u0438\u044f \u0433\u0440\u0443\u043f\u043f
    \u041b\u0438: \u041e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e
    \u043f\u043e\u043b\u0443\u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0430\u043b\u0433\u0435\u0431\u0440
    \u041b\u0438 \u043d\u0430\u0434 \u043f\u043e\u043b\u0435\u043c \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0438\u0445 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439.
    \u041c\u0435\u0442\u043e\u0434 \u0432\u043d\u0435\u0448\u043d\u0438\u0445 \u0444\u043e\u0440\u043c:
    \u0421\u043e\u0437\u0434\u0430\u043b \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043e\u0431\u0449\u0438\u0439 \u043c\u0435\u0442\u043e\u0434 \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0433\u043e
    \u0440\u0435\u043f\u0435\u0440\u0430 \u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 (\u0430\u0444\u0444\u0438\u043d\u043d\u043e\u0439,
    \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0438 \u043a\u043e\u043d\u0444\u043e\u0440\u043c\u043d\u043e\u0439
    \u0441\u0432\u044f\u0437\u043d\u043e\u0441\u0442\u0438), \u0432\u0432\u0435\u0434\u044f
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043a\u0440\u0443\u0447\u0435\u043d\u0438\u044f
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430: \u0412\u043d\u0451\u0441 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u043e\u0431\u0449\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u0441\u043f\u0438\u043d\u043e\u0440\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u0448\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435."
  shortBioEn: "Eli Joseph Cartan (1869–1951) is one of the greatest mathematicians in the 20th century whose work has become the foundation of many modern sections of mathematics and physics.\n\nEarly years and education, Eli Joseph Cartan was born on April 9, 1869, in the small village of Dolomieu, in the department of Izer, south-east of France. He was the second child in the village blacksmith family. The family lived in poverty, and the future mathematician from childhood heard a hammer knock from an early morning, and his parents, later described as \"uninvolved peasants\", gave children an example of hard work and endurance.Ali's gifts were very early, and his schoolteachers were struck by his brilliant memory and extraordinary wittyness, and the decisive role played by school inspector Antonen Dubo, who noticed the gifted boy, and it was Dubo who helped to obtain a government scholarship that allowed Cartan to leave his home village and enter the lyceum.In 1888, after a brilliant study at the Vienne, Grenoble and Paris high schools, Cartan became a student at the prestigious Paris High School, where he had the privilege of attending lectures by corifei, such as Henri Puancare, Charles Ermit, Gaston Darbú and Emile Picar, who graduated from school in 1891 and returned to science after a year in the army.\n\n===Scientific career===After the protection of the thesis in 1894, he began his academic career in Sorbonne, where he was a lecturer at the University of Montpellier (1894–1896), a lecturer at the University of Lyon (1896–1903), a professor at the University of Nancy (1903–109), and in 1909 he returned to Paris, where he began to work in Sorbonne.In 1912, he was promoted to professorship and later to head the Department of High Geometry until retirement in 1940.\n\n==Personal life==In 1903, Eli Cartan married Marie-Louise Biancony, daughter of a chemistry professor, and four children were born in their family: Henri Cartan (1904–2008) as a prominent mathematician, one of the founders of the school, Nicole Burbaki, Jean Cartan (1907–1932), who died of tuberculosis at the age of 25, and Louis Cartan (1908–1943) as a member of the French Resistance, was arrested and executed by the Nazis in December 1943.He became a math teacher during World War I, and in spite of his age, Cartan was drafted into the army as a sergeant and served in a military hospital, and the death of his two sons was a great personal tragedy for a scientist.\n\nIn 1937 he was awarded the prestigious N. I. Lobachevsky International Prize for outstanding works in geometry, and in 1947 he became a member of the Royal Society of London.His name is permanently in the name of the crater on the back of the moon and in the prizes of the French Academy of Sciences.\n\nThe scientific heritage of Cartan is huge. His work has created a new language for mathematics and physics. The Lee group theory: He has completed the classification of Lee's semi-simple algebra over the field of complex numbers and built the theory of their representation. The external form method: Created this method to solve differential equation systems, which has become the cornerstone of modern differential geometry.Differential Geometry: Developed a common mobile repertoire method and created shared spaces (of fin, design, and conform connectivity), introducing the concept of spinal cord. Mathematical physics: contributed to the general theory of relativity and spinal theory, which have been applied in quantum mechanics."
  interestingFactsRu: "\u0425\u043e\u0442\u044f \u042d\u043b\u0438 \u0416\u043e\u0437\u0435\u0444 \u041a\u0430\u0440\u0442\u0430\u043d
    \u0438 \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u0446\u0435\u043b\u0438\u043a\u043e\u043c
    \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u043c \u0432 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435
    \u043c\u0438\u0440\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439, \u044f\u0440\u043a\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u044e\u0449\u0438\u0445
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u044d\u043f\u043e\u0445\u0443.
    \u0412\u043e\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0445 \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432.\n\n\U0001F468\u200d\U0001F466 \u0414\u0438\u043d\u0430\u0441\u0442\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u041a\u0430\u0440\u0442\u0430\u043d
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e
    \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u0434\u0438\u043d\u0430\u0441\u0442\u0438\u044e.
    \u0415\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d, \u0410\u043d\u0440\u0438
    \u041a\u0430\u0440\u0442\u0430\u043d, \u0442\u0430\u043a\u0436\u0435 \u0441\u0442\u0430\u043b
    \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b
    `\u0411\u0443\u0440\u0431\u0430\u043a\u0438`. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043e\u0431\u0449\u0443\u044e
    \u0441\u0442\u0440\u0430\u0441\u0442\u044c \u043a \u043d\u0430\u0443\u043a\u0435, \u0438\u0445
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u0441\u043a\u043e\u0440\u0435\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435\u043c \u0434\u0432\u0443\u0445 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445
    \u043a\u043e\u043b\u043b\u0435\u0433. \u0410\u043d\u0440\u0438 \u043f\u043e\u0437\u0436\u0435
    \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b: \u00ab\u041e\u0442\u0435\u0446 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0443\u0433\u043b\u0443, \u0430 \u044f \u2014 \u0432
    \u0441\u0432\u043e\u0435\u043c. \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0432\u043b\u0438\u044f\u0442\u044c
    \u043d\u0430 \u043c\u0435\u043d\u044f\u00bb. \u0418\u0445 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0432\u044b\u0448\u043b\u0430 \u0432 1931 \u0433\u043e\u0434\u0443.\n\n\u2692\ufe0f
    \u0416\u0438\u0437\u043d\u044c \u043f\u043e\u0434 \u0437\u0432\u043e\u043d \u043d\u0430\u043a\u043e\u0432\u0430\u043b\u044c\u043d\u0438
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043f\u0440\u043e\u0448\u043b\u043e \u0432 \u0431\u0435\u0434\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0435
    \u0434\u0435\u0440\u0435\u0432\u0435\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u0443\u0437\u043d\u0435\u0446\u0430.
    \u0412 1939 \u0433\u043e\u0434\u0443, \u043a \u0441\u0432\u043e\u0435\u043c\u0443 70-\u043b\u0435\u0442\u0438\u044e,
    \u041a\u0430\u0440\u0442\u0430\u043d \u043f\u0438\u0441\u0430\u043b: \u00ab\u041c\u043e\u0435
    \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0448\u043b\u043e \u043f\u043e\u0434
    \u0443\u0434\u0430\u0440\u0430\u043c\u0438 \u043d\u0430\u043a\u043e\u0432\u0430\u043b\u044c\u043d\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b\u0438\u0441\u044c
