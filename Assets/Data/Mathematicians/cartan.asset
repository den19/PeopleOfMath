  achievementsRu: "\u042d\u043b\u0438 \u0416\u043e\u0437\u0435\u0444 \u041a\u0430\u0440\u0442\u0430\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0442\u0435\u043e\u0440\u0435\u043c\u044b,
    \u0430 \u0446\u0435\u043b\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0438\u0440. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u2014 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043d\u043e\u0432\u043e\u0433\u043e,
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b
    \u0438 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b \u0430\u043b\u0433\u0435\u0431\u0440\u0443,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0443. \u0413\u043b\u0443\u0431\u0438\u043d\u0443
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442 \u0432 1912 \u0433\u043e\u0434\u0443 \u043d\u0435
    \u043f\u043e\u0431\u043e\u044f\u043b\u0441\u044f \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c
    \u0441\u0430\u043c \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435,
    \u043d\u0430\u0437\u0432\u0430\u0432 \u0438\u0445 \u043e\u0434\u043d\u0438\u043c\u0438 \u0438\u0437
    \u00ab\u0441\u0430\u043c\u044b\u0445 \u0432\u0430\u0436\u043d\u044b\u0445, \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0445
    \u0438 \u043e\u0431\u0449\u0438\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb.
    \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c \u043c\u0430\u0441\u0448\u0442\u0430\u0431
    \u0435\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f, \u0443\u0434\u043e\u0431\u043d\u043e
    \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445,
    \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u043c\u0435\u0436\u0434\u0443
    \u0441\u043e\u0431\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445.\n\n\U0001F3DB\ufe0f
    1. \u0413\u0440\u0443\u043f\u043f\u044b \u041b\u0438 \u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f: \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \"\u0441\u043a\u0435\u043b\u0435\u0442\u0430\"
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u041a\u0430\u0440\u0442\u0430\u043d
    \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u0439 \u043f\u0443\u0442\u044c \u0441
    \u0441\u0430\u043c\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u044b \u2014 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0443\u043f\u043f \u041b\u0438, \u0441\u0442\u0430\u0432 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0435\u0451 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u043e\u043c. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f
    \u0430\u043b\u0433\u0435\u0431\u0440 \u041b\u0438 (1894 \u0433.): \u0415\u0433\u043e \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f \u0441\u0442\u0430\u043b\u0430
    \u044d\u043f\u043e\u0445\u0430\u043b\u044c\u043d\u044b\u043c \u0442\u0440\u0443\u0434\u043e\u043c.
    \u041a\u0430\u0440\u0442\u0430\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u0438
    \u0443\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0438\u043b \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443, \u043d\u0430\u0447\u0430\u0442\u0443\u044e \u0421\u043e\u0444\u0443\u0441\u043e\u043c
    \u041b\u0438 \u0438 \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u043e\u043c \u041a\u0438\u043b\u043b\u0438\u043d\u0433\u043e\u043c.
    \u041e\u043d \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u0441\u0435 \u043f\u043e\u043b\u0443 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    \u041b\u0438 \u043d\u0430\u0434 \u043f\u043e\u043b\u0435\u043c \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u0432\u044b\u0434\u0435\u043b\u0438\u0432 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435 \u0441\u0435\u0440\u0438\u0438
    \u0438 \u043f\u044f\u0442\u044c \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u043b\u0443\u0447\u0430\u0435\u0432 (G\u2082, F\u2084, E\u2086, E\u2087, E\u2088).
    \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a\u043e\u043c, \u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438. \u0422\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    (1913 \u0433.): \u041e\u043d \u043f\u043e\u0448\u0435\u043b \u0434\u0430\u043b\u044c\u0448\u0435
    \u0438 \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u044d\u0442\u0438\u0445
    \u0430\u043b\u0433\u0435\u0431\u0440, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432,
    \u043a\u0430\u043a \u043e\u043d\u0438 \u043c\u043e\u0433\u0443\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u043d\u0430 \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430.
    \u042d\u0442\u043e \u0434\u0430\u043b\u043e \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438.
    \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u044b
    \u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438: \u0412
    \u0441\u0432\u043e\u0435\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438
    \u041a\u0430\u0440\u0442\u0430\u043d\u0430, \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c,
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043b\u0438 \u0433\u0440\u0443\u043f\u043f\u0430
    \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0438\u043b\u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0439,
    \u043d\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u044f \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u0445
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439.\n\n\u2795 2. \u041c\u0435\u0442\u043e\u0434
    \u0432\u043d\u0435\u0448\u043d\u0438\u0445 \u0444\u043e\u0440\u043c: \u042f\u0437\u044b\u043a
    \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u0438 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 XX \u0432\u0435\u043a\u0430 \u041a\u0430\u0440\u0442\u0430\u043d
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u043e\u0449\u043d\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0432\u043d\u0435\u0448\u043d\u0438\u0445 \u0444\u043e\u0440\u043c
    (1899-1902 \u0433\u0433.), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c. \u0412\u043c\u0435\u0441\u0442\u043e
    \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u044b\u0445 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442
    \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0444\u043e\u0440\u043c\u044b \u2014 \u043e\u0431\u044a\u0435\u043a\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u043e\u0436\u043d\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043d\u0430 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f\u0445
    \u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u044f\u0442
    \u043e\u0442 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442.
    \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439:
    \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b
    \u0435\u043c\u0443 \u0440\u0435\u0448\u0438\u0442\u044c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438
    \u0441\u0438\u0441\u0442\u0435\u043c \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u041f\u0444\u0430\u0444\u0444\u0430,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u043c
    \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0415\u0434\u0438\u043d\u044b\u0439
    \u044f\u0437\u044b\u043a: \u0412\u043d\u0435\u0448\u043d\u0438\u0435 \u0444\u043e\u0440\u043c\u044b
    \u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f \u0432\u043d\u0435\u0448\u043d\u0435\u0433\u043e
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    (\u043d\u044b\u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043a\u0430\u043a
    \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u0430\u044f \u041a\u0430\u0440\u0442\u0430\u043d\u0430)
    \u0441\u0442\u0430\u043b\u0438 \u0442\u0435\u043c \u043e\u0431\u0449\u0438\u043c \u044f\u0437\u044b\u043a\u043e\u043c,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u043d \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e
    \u0438 \u0442\u0435\u043e\u0440\u0438\u044e \u0433\u0440\u0443\u043f\u043f.\n\n\U0001F5FA\ufe0f
    3. \u041c\u0435\u0442\u043e\u0434 \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0433\u043e
    \u0440\u0435\u043f\u0435\u0440\u0430: \u041d\u043e\u0432\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u041e\u043f\u0438\u0440\u0430\u044f\u0441\u044c \u043d\u0430 \u0441\u0432\u043e\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442
    \u0444\u043e\u0440\u043c, \u041a\u0430\u0440\u0442\u0430\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0433\u043e \u0440\u0435\u043f\u0435\u0440\u0430.
    \u0418\u0434\u0435\u044f \u043f\u0440\u043e\u0441\u0442\u0430: \u0432\u043c\u0435\u0441\u0442\u043e
    \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u0432\u0441\u0451 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0441\u0440\u0430\u0437\u0443, \u043c\u044b \u0431\u0435\u0440\u0451\u043c \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u00ab\u0440\u0435\u043f\u0435\u0440\u00bb (\u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0432\u0435\u043a\u0442\u043e\u0440\u043e\u0432)
    \u0438 \u0434\u0432\u0438\u0433\u0430\u0435\u043c \u0435\u0433\u043e \u043f\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0443,
    \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u044f, \u043a\u0430\u043a \u043e\u043d \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f.
    \u041e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430:
    \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u044d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434,
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u043d\u043e\u0432\u044b\u0445, \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432, \u0432\u0432\u0435\u0434\u044f
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0430\u0444\u0444\u0438\u043d\u043d\u043e\u0439,
    \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0438 \u043a\u043e\u043d\u0444\u043e\u0440\u043c\u043d\u043e\u0439
    \u0441\u0432\u044f\u0437\u043d\u043e\u0441\u0442\u0438. \u041f\u0440\u043e\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u044f,
    \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0439
    \u043f\u0435\u0440\u0435\u043d\u043e\u0441 \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u0445, \u0433\u0434\u0435
    \u043d\u0435\u0442 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u043e\u0439 \u043c\u0435\u0442\u0440\u0438\u043a\u0438.
    \u0421\u0432\u044f\u0437\u043d\u043e\u0441\u0442\u044c \u0438 \u043a\u0440\u0443\u0447\u0435\u043d\u0438\u0435:
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u044d\u0442\u043e\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u041a\u0430\u0440\u0442\u0430\u043d \u0432\u0432\u0435\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0441\u0432\u044f\u0437\u043d\u043e\u0441\u0442\u0438
    \u0438 \u043a\u0440\u0443\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430.
    \u0412 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043a\u0440\u0443\u0447\u0435\u043d\u0438\u0435
    \u043e\u0431\u044b\u0447\u043d\u043e \u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442 \u0440\u0430\u0432\u043d\u044b\u043c
    \u043d\u0443\u043b\u044e, \u043d\u043e \u041a\u0430\u0440\u0442\u0430\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0432 \u043e\u0431\u0449\u0435\u043c \u0441\u043b\u0443\u0447\u0430\u0435
    \u043e\u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0438 \u043d\u0435\u0441\u0442\u0438 \u0432\u0430\u0436\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e.\n\n\U0001F30C
    4. \u0412\u043a\u043b\u0430\u0434 \u0432 \u0444\u0438\u0437\u0438\u043a\u0443: \u041e\u0442
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0434\u043e \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430
    \u041a\u0430\u0440\u0442\u0430\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u043f\u0435\u0440\u0432\u044b\u0445, \u043a\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0441\u0432\u043e\u0438 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c. \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0437\u0430\u0446\u0438\u044f
    \u043d\u044c\u044e\u0442\u043e\u043d\u043e\u0432\u0441\u043a\u043e\u0439 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438
    (1923 \u0433.): \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0443 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u0447\u0435\u0442\u044b\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430-\u0432\u0440\u0435\u043c\u0435\u043d\u0438,
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0434\u0435\u0438 \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    (\u041e\u0422\u041e). \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044e \u041d\u044c\u044e\u0442\u043e\u043d\u0430
    \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c
    \u043a\u0430\u043a \u0438\u0441\u043a\u0440\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430-\u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043e\u0441\u043e\u0431\u043e\u0433\u043e \u0440\u043e\u0434\u0430, \u0433\u0434\u0435
    \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u044c\u044e
    \u043c\u0430\u0441\u0441\u044b. \u0422\u0435\u043e\u0440\u0438\u044f \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430-\u041a\u0430\u0440\u0442\u0430\u043d\u0430:
    \u041e\u043d \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u041e\u0422\u041e, \u0432\u043a\u043b\u044e\u0447\u0438\u0432
    \u0432 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u0443, \u043d\u043e \u0438 \u043a\u0440\u0443\u0447\u0435\u043d\u0438\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430-\u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u0412 \u044d\u0442\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043a\u0440\u0443\u0447\u0435\u043d\u0438\u0435
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u043e \u0441\u043f\u0438\u043d\u043e\u043c
    (\u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u0430) \u043c\u0430\u0442\u0435\u0440\u0438\u0438.
    \u0425\u043e\u0442\u044f \u044d\u0442\u0430 \u0442\u0435\u043e\u0440\u0438\u044f \u043d\u0435
    \u0441\u0442\u0430\u043b\u0430 \u043c\u0435\u0439\u043d\u0441\u0442\u0440\u0438\u043c\u043e\u043c,
    \u043e\u043d\u0430 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0432\u0430\u0436\u043d\u043e\u0439
    \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043e\u0439 \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u0442\u0435\u043e\u0440\u0438\u044f\u0445
    \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0441\u043f\u0438\u043d\u043e\u0440\u043e\u0432: \u0415\u0433\u043e \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \"\u0422\u0435\u043e\u0440\u0438\u044f \u0441\u043f\u0438\u043d\u043e\u0440\u043e\u0432\"
    \u0441\u0442\u0430\u043b\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0442\u0440\u0443\u0434\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u043f\u043e\u0432\u043b\u0438\u044f\u043b \u043d\u0430 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0443\u044e
    \u0444\u0438\u0437\u0438\u043a\u0443. \u0421\u043f\u0438\u043d\u043e\u0440\u044b \u2014
    \u044d\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u0447\u0430\u0441\u0442\u0438\u0446\u044b \u0441 \u043f\u043e\u043b\u0443\u0446\u0435\u043b\u044b\u043c
    \u0441\u043f\u0438\u043d\u043e\u043c (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u044b), \u0438 \u0438\u0445 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435
    \u0431\u044b\u043b\u043e \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u0439
    \u041a\u0430\u0440\u0442\u0430\u043d\u0430.\n\n\U0001F48E \u0420\u0435\u0437\u044e\u043c\u0435
    \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041a\u0430\u0440\u0442\u0430\u043d\u0430
    \u0441\u0442\u0430\u043b\u043e \u00ab\u0441\u043a\u0435\u043b\u0435\u0442\u043e\u043c\u00bb
    \u0434\u043b\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0438. \u0415\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u044b,
    \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u043c\u0435\u0442\u043e\u0434 \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0433\u043e
    \u0440\u0435\u043f\u0435\u0440\u0430 \u0438 \u0442\u0435\u043e\u0440\u0438\u044f \u0432\u043d\u0435\u0448\u043d\u0438\u0445
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0441\u0438\u0441\u0442\u0435\u043c, \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0440\u0430\u0431\u043e\u0447\u0438\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u043e\u0432 \u0438 \u0444\u0438\u0437\u0438\u043a\u043e\u0432.
    \u041a\u0430\u043a \u0442\u043e\u0447\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0423\u0433\u043e \u0410\u043c\u0430\u043b\u044c\u0434\u0438,
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u0430\u044f
    \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u041a\u0430\u0440\u0442\u0430\u043d\u0430\u00bb
    \u2014 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0438 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434
    \u043d\u0430 \u043d\u0430\u0443\u043a\u0443, \u0433\u0434\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0430,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0438 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0441\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0432\u043e\u0435\u0434\u0438\u043d\u043e."
  achievementsEn: "Eli Joseph Cartan left behind not just a few theories, but a whole mathematical world, his main contribution being the creation of a new, exclusively universal mathematical language that combined and transformed algebra, geometry, topology and physics.To understand the extent of its legacy, it is convenient to consider its achievements in several key, closely related areas.\n\n1. Group Lee and structural theory: The creation of a skeleton mathematician, Cartan, began from the very foundation of Lee's theory, becoming actually its architect. The classification of Algebra Lee (1894): His doctoral thesis became a landmark work. Cartan completed and streamlined the gigantic work started by Sofus Lee and Wilhelm Killing.He completely classified all the simple algebras of Lee above the complex number field, highlighting four endless series and five exceptional cases (G2, F4, E6, E7, E8). This was not just a reference, but a basis for all subsequent theory. The theory of the submissions (1913): He went further and built the theory of the representation of these algebras, determining how they could operate on vector space.This has provided a powerful tool for physics, especially quantum mechanics. The criteria for simplicity and resolution: In his dissertation, he has also developed the famous Cartan criteria, which can be algebraically checked whether the group is simple or resolutionable, without having to do cumbersome calculations.\n\n2. Method of external forms: In the early 20th century, Cartan developed a powerful method of external forms (1899-1902), which became his main mathematical tool, and instead of his usual coordinates, he suggested the use of differential forms, objects that could be integrated on a variety and that are independent of the reference system.Equation systems solution: This method allowed him to solve the fundamental problem of the co-existence of Pffaffa's differential equation systems, which was a breakthrough in the theory of differential equations. A single language: External forms and the operation of external differentiation (now known as Cartan's derivative) became the common language in which he combined differential geometry, topology and group theory.\n\n3. Mobile Reper Method: New Geometry based on its shapes machine, Cartan created a universal mobile reper. The idea is simple: instead of studying the whole space at once, we take a small \"reper\" and move it around, watching it change.So, in a common way, using this method, it created geometry of new, generic spaces, introducing the concepts offfinity, design and conformity. So basically, it showed how to define parallel transport and geometry in spaces where there is no conventional metrics. Connectivity and twisting: It's within this approach that Cartan introduced the fundamental concepts of connectivity and spinning.In classical rhythmic geometry, the twist is usually considered to be zero, but Cartan has shown that in general it can exist and carry important information.\n\n4. Contribution to physics: From Newton to Einstein Cartan was one of the first to use his abstract designs to solve real physical problems. Geometry of Newton's gravity (1923): He proposed geometric wording of Newton's gravity theory in the language of four-dimensional space-time, predisposing some ideas of general relativity theory (TO).He showed that Newton's gravity could be imagined as a pervert of space-time of a special kind, where the curve is completely determined by mass density. Einstein-Cartan's theory: He summarized the UTO by including not only curvature but also the curve of space-time in the equations.Although this theory has not become a mainstream, it remains an important alternative and is actively used in the theory of integration. The theory of spinor: its monograph \"Theory of Spinors\" has become a classic work that deeply influenced quantum physics. Spinors are mathematical objects that describe particles with half-int backs (e.g. electrons) and their correct mathematical description has been largely attributable to Cartan.\n\n♪ The science heritage of Cartan has become a skeleton for a vast part of modern mathematics and physics, and its methods, such as mobile repertoire and the theory of external differential systems, are still a working tool for geometry and physics.As Hugo Amaldi's mathematician has clearly observed, there is a unique \"Mathematics of Cartan\", a unique and strikingly holistic view of science, where algebra, geometry and analysis merge."
  personalLifeRu: "\u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0432 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445
    \u043c\u043d\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u043b\u0438\u0448\u044c \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u042d\u043b\u0438 \u0416\u043e\u0437\u0435\u0444\u0430 \u041a\u0430\u0440\u0442\u0430\u043d\u0430.
    \u0421\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043e \u0434\u0435\u0442\u0430\u043b\u044f\u0445
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0435, \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u0445
    \u0438\u043b\u0438 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0445
    \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u0445 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u043e\u0447\u0435\u043d\u044c \u043c\u0430\u043b\u043e. \u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0442\u0430\u0442\u044c\u0438 \u0438 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0438
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u044b \u043d\u0430
    \u0435\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0445. \u041e\u0434\u043d\u0430\u043a\u043e
    \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432 \u043e
    \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0442\u043e\u0447\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b: \u0416\u0435\u043d\u0438\u0442\u044c\u0431\u0430
    \u0438 \u0441\u0435\u043c\u044c\u044f: \u0412 1903 \u0433\u043e\u0434\u0443 \u041a\u0430\u0440\u0442\u0430\u043d
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041c\u0430\u0440\u0438-\u041b\u0443\u0438\u0437\u0435
    \u0411\u044c\u044f\u043d\u043a\u043e\u043d\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0445\u0438\u043c\u0438\u0438. \u0418\u0445 \u0431\u0440\u0430\u043a \u0441\u0442\u0430\u043b
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0435\u0433\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438. \u0414\u0435\u0442\u0438: \u0412 \u0441\u0435\u043c\u044c\u0435
    \u0431\u044b\u043b\u043e \u0447\u0435\u0442\u0432\u0435\u0440\u043e \u0434\u0435\u0442\u0435\u0439:
    \u0410\u043d\u0440\u0438 \u041a\u0430\u0440\u0442\u0430\u043d (1904\u20132008) \u2014 \u043f\u043e\u0448\u0451\u043b
    \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c \u043e\u0442\u0446\u0430 \u0438 \u0441\u0442\u0430\u043b
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0433\u0440\u0443\u043f\u043f\u044b \u0411\u0443\u0440\u0431\u0430\u043a\u0438. \u0416\u0430\u043d
    \u041a\u0430\u0440\u0442\u0430\u043d (1907\u20131932) \u2014 \u0441\u0442\u0430\u043b \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u043e\u043c,
    \u043d\u043e, \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0443\u043c\u0435\u0440
    \u0432 25 \u043b\u0435\u0442 \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437\u0430.
    \u041b\u0443\u0438 \u041a\u0430\u0440\u0442\u0430\u043d (1908\u20131943) \u2014 \u0444\u0438\u0437\u0438\u043a,
    \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u0421\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f, \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u043e\u0433\u0438\u0431, \u0431\u044b\u043b \u043a\u0430\u0437\u043d\u0451\u043d
    \u043d\u0430\u0446\u0438\u0441\u0442\u0430\u043c\u0438. \u042d\u043b\u0435\u043d \u041a\u0430\u0440\u0442\u0430\u043d
    \u2014 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041c\u043e\u0436\u043d\u043e
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c, \u0447\u0442\u043e,
    \u043a\u0430\u043a \u0438 \u0443 \u043c\u043d\u043e\u0433\u0438\u0445 \u043b\u044e\u0434\u0435\u0439
    \u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u043a\u0440\u0443\u0433\u0430,
    \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430
    \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430
    \u0441 \u0441\u0435\u043c\u044c\u0451\u0439 \u0438 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0441\u0440\u0435\u0434\u043e\u0439. \u0422\u043e\u0442 \u0444\u0430\u043a\u0442, \u0447\u0442\u043e
    \u0438 \u0435\u0433\u043e \u0441\u044b\u043d \u0410\u043d\u0440\u0438, \u0438 \u0434\u043e\u0447\u044c
    \u042d\u043b\u0435\u043d \u0441\u0442\u0430\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438,
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e
    \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0432 \u0434\u043e\u043c\u0435 \u0431\u044b\u043b\u0430
    \u043f\u0440\u043e\u043d\u0438\u0437\u0430\u043d\u0430 \u043b\u044e\u0431\u043e\u0432\u044c\u044e
    \u043a \u043d\u0430\u0443\u043a\u0435."
  personalLifeEn: "Unfortunately, the information available to me is mostly limited to the scientific biography of Eli Joseph Cartan, and very few details of his personal life, nature, habits or everyday activities are available, and the biographical articles and encyclopedia focus on his professional achievements.However, there are several key facts about his family that are well known: marriage and family: in 1903, Cartan married Marie-Louise Biancony, who was the daughter of a chemistry professor, and their marriage became the foundation of his family life. Children: The family had four children: Henri Cartan (1904 - 2008), followed in the footsteps of his father and became an outstanding mathematician, one of the founding members of the Burbaki group.Jean Cartan (1907–1932) was a composer, but unfortunately died at age 25 from tuberculosis. Louis Cartan (1908–1943), a French resistance member, was tragically killed, executed by the Nazis, and was a math teacher. Like many people in his time and circle, personal life was closely linked to the family and the scientific environment.The fact that both his son Henri and Helen's daughter became mathematicians suggests that the atmosphere in the house was filled with love for science."
  shortBioRu: "\u042d\u043b\u0438 \u0416\u043e\u0437\u0435\u0444 \u041a\u0430\u0440\u0442\u0430\u043d (1869\u20131951)
    \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0438. \u0415\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0442\u0430\u043b\u0430\u043d\u0442\u0443 \u0438 \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u0443
    \u043f\u043e\u0434\u043d\u044f\u043b\u0441\u044f \u0438\u0437 \u0431\u0435\u0434\u043d\u043e\u0439
    \u0441\u0435\u043b\u044c\u0441\u043a\u043e\u0439 \u0441\u0435\u043c\u044c\u0438 \u0434\u043e
    \u0432\u0435\u0440\u0448\u0438\u043d \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u043d\u0430\u0443\u043a\u0438.\n\n\U0001F4DC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u042d\u043b\u0438 \u0416\u043e\u0437\u0435\u0444 \u041a\u0430\u0440\u0442\u0430\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    9 \u0430\u043f\u0440\u0435\u043b\u044f 1869 \u0433\u043e\u0434\u0430 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439
    \u0434\u0435\u0440\u0435\u0432\u0443\u0448\u043a\u0435 \u0414\u043e\u043b\u043e\u043c\u044c\u0451
    \u0432 \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0435 \u0418\u0437\u0435\u0440,
    \u043d\u0430 \u044e\u0433\u043e-\u0432\u043e\u0441\u0442\u043e\u043a\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438.
    \u041e\u043d \u0431\u044b\u043b \u0432\u0442\u043e\u0440\u044b\u043c \u0440\u0435\u0431\u0451\u043d\u043a\u043e\u043c
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0434\u0435\u0440\u0435\u0432\u0435\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u0443\u0437\u043d\u0435\u0446\u0430. \u0421\u0435\u043c\u044c\u044f \u0436\u0438\u043b\u0430
    \u0432 \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438, \u0438 \u0431\u0443\u0434\u0443\u0449\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u0441\u043b\u044b\u0448\u0430\u043b \u0441\u0442\u0443\u043a \u043c\u043e\u043b\u043e\u0442\u0430
    \u043f\u043e \u043d\u0430\u043a\u043e\u0432\u0430\u043b\u044c\u043d\u0435 \u0441 \u0440\u0430\u043d\u043d\u0435\u0433\u043e
    \u0443\u0442\u0440\u0430. \u0415\u0433\u043e \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d \u043f\u043e\u0437\u0436\u0435 \u043e\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u043e\u0432\u0430\u043b
    \u043a\u0430\u043a \u00ab\u043d\u0435\u043f\u0440\u0438\u0442\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043a\u0440\u0435\u0441\u0442\u044c\u044f\u043d\u00bb, \u043f\u043e\u0434\u0430\u0440\u0438\u043b\u0438
    \u0434\u0435\u0442\u044f\u043c \u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u0440\u0443\u0434\u043e\u043b\u044e\u0431\u0438\u044f
    \u0438 \u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u0438. \u0414\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u042d\u043b\u0438 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u043e\u0447\u0435\u043d\u044c
    \u0440\u0430\u043d\u043e. \u0415\u0433\u043e \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0435
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0431\u044b\u043b\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u044b
    \u0435\u0433\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439 \u043f\u0430\u043c\u044f\u0442\u044c\u044e
    \u0438 \u043d\u0435\u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u043e\u0439
    \u043e\u0441\u0442\u0440\u043e\u0442\u043e\u0439 \u0443\u043c\u0430. \u0420\u0435\u0448\u0430\u044e\u0449\u0443\u044e
    \u0440\u043e\u043b\u044c \u0432 \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u0435
    \u0441\u044b\u0433\u0440\u0430\u043b \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0439 \u0438\u043d\u0441\u043f\u0435\u043a\u0442\u043e\u0440
    \u0410\u043d\u0442\u043e\u043d\u0435\u043d \u0414\u044e\u0431\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043e\u0434\u0430\u0440\u0451\u043d\u043d\u043e\u0433\u043e
    \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430. \u0418\u043c\u0435\u043d\u043d\u043e \u0414\u044e\u0431\u043e
    \u043f\u043e\u043c\u043e\u0433 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432\u0448\u0443\u044e
    \u041a\u0430\u0440\u0442\u0430\u043d\u0443 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c
    \u0440\u043e\u0434\u043d\u0443\u044e \u0434\u0435\u0440\u0435\u0432\u043d\u044e \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u0442\u044c
    \u0432 \u043b\u0438\u0446\u0435\u0439. \u0412 1888 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439 \u0443\u0447\u0451\u0431\u044b \u0432
    \u043b\u0438\u0446\u0435\u044f\u0445 \u0412\u044c\u0435\u043d\u043d\u0430, \u0413\u0440\u0435\u043d\u043e\u0431\u043b\u044f
    \u0438 \u041f\u0430\u0440\u0438\u0436\u0430, \u041a\u0430\u0440\u0442\u0430\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u0412\u044b\u0441\u0448\u0435\u0439 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u0432 \u041f\u0430\u0440\u0438\u0436\u0435. \u0422\u0430\u043c
    \u0435\u043c\u0443 \u043f\u043e\u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u0438\u043b\u043e\u0441\u044c
    \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u043b\u0435\u043a\u0446\u0438\u0438 \u0442\u0430\u043a\u0438\u0445
    \u043a\u043e\u0440\u0438\u0444\u0435\u0435\u0432, \u043a\u0430\u043a \u0410\u043d\u0440\u0438
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435, \u0428\u0430\u0440\u043b\u044c \u042d\u0440\u043c\u0438\u0442,
    \u0413\u0430\u0441\u0442\u043e\u043d \u0414\u0430\u0440\u0431\u0443 \u0438 \u042d\u043c\u0438\u043b\u044c
    \u041f\u0438\u043a\u0430\u0440. \u0412 1891 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0448\u043a\u043e\u043b\u0443, \u0430 \u043f\u043e\u0441\u043b\u0435 \u0433\u043e\u0434\u0430
    \u0441\u043b\u0443\u0436\u0431\u044b \u0432 \u0430\u0440\u043c\u0438\u0438 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u043a \u043d\u0430\u0443\u043a\u0435.\n\n\U0001F52C \u041d\u0430\u0443\u0447\u043d\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0449\u0438\u0442\u044b
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u0432 1894 \u0433\u043e\u0434\u0443
    \u0432 \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f
    \u0435\u0433\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430. \u041e\u043d \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438: \u041b\u0435\u043a\u0442\u043e\u0440
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u041c\u043e\u043d\u043f\u0435\u043b\u044c\u0435
    (1894\u20131896). \u041b\u0435\u043a\u0442\u043e\u0440 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u041b\u0438\u043e\u043d\u0430 (1896\u20131903). \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u041d\u0430\u043d\u0441\u0438
    (1903\u20131909). \u0412 1909 \u0433\u043e\u0434\u0443 \u041a\u0430\u0440\u0442\u0430\u043d
    \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436,
    \u0433\u0434\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435. \u0412 1912 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430, \u0430 \u043f\u043e\u0437\u0436\u0435
    \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u0432\u044b\u0441\u0448\u0435\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u043b
    \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0432\u044b\u0445\u043e\u0434\u0430 \u043d\u0430
    \u043f\u0435\u043d\u0441\u0438\u044e \u0432 1940 \u0433\u043e\u0434\u0443.\n\n\u2764\ufe0f
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0412 1903 \u0433\u043e\u0434\u0443
    \u042d\u043b\u0438 \u041a\u0430\u0440\u0442\u0430\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041c\u0430\u0440\u0438-\u041b\u0443\u0438\u0437\u0435 \u0411\u044c\u044f\u043d\u043a\u043e\u043d\u0438,
    \u0434\u043e\u0447\u0435\u0440\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0445\u0438\u043c\u0438\u0438. \u0412 \u0438\u0445 \u0441\u0435\u043c\u044c\u0435 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0447\u0435\u0442\u0432\u0435\u0440\u043e \u0434\u0435\u0442\u0435\u0439: \u0410\u043d\u0440\u0438
    \u041a\u0430\u0440\u0442\u0430\u043d (1904\u20132008) \u2014 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u043e\u0434\u0438\u043d \u0438\u0437
    \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0448\u043a\u043e\u043b\u044b
    \u041d\u0438\u043a\u043e\u043b\u044f \u0411\u0443\u0440\u0431\u0430\u043a\u0438. \u0416\u0430\u043d
    \u041a\u0430\u0440\u0442\u0430\u043d (1907\u20131932) \u2014 \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0442\u043e\u0440,
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u043c\u0435\u0440\u0448\u0438\u0439
    \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    25 \u043b\u0435\u0442. \u041b\u0443\u0438 \u041a\u0430\u0440\u0442\u0430\u043d (1908\u20131943)
    \u2014 \u0444\u0438\u0437\u0438\u043a, \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e \u0421\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f,
    \u0431\u044b\u043b \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u0430\u043d \u0438 \u043a\u0430\u0437\u043d\u0451\u043d
    \u043d\u0430\u0446\u0438\u0441\u0442\u0430\u043c\u0438 \u0432 \u0434\u0435\u043a\u0430\u0431\u0440\u0435
    1943 \u0433\u043e\u0434\u0430. \u042d\u043b\u0435\u043d \u041a\u0430\u0440\u0442\u0430\u043d
    \u2014 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0432\u043e\u0437\u0440\u0430\u0441\u0442,
    \u041a\u0430\u0440\u0442\u0430\u043d \u0431\u044b\u043b \u043f\u0440\u0438\u0437\u0432\u0430\u043d
    \u0432 \u0430\u0440\u043c\u0438\u044e \u0432 \u0437\u0432\u0430\u043d\u0438\u0438 \u0441\u0435\u0440\u0436\u0430\u043d\u0442\u0430
    \u0438 \u0441\u043b\u0443\u0436\u0438\u043b \u0432 \u0432\u043e\u0435\u043d\u043d\u043e\u043c
    \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0435. \u0421\u043c\u0435\u0440\u0442\u044c
    \u0434\u0432\u0443\u0445 \u0435\u0433\u043e \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0441\u0442\u0430\u043b\u0430
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u043b\u0438\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439
    \u0434\u043b\u044f \u0443\u0447\u0451\u043d\u043e\u0433\u043e.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u043f\u0440\u0438\u0448\u043b\u043e \u043a \u041a\u0430\u0440\u0442\u0430\u043d\u0443 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u043e\u0437\u0434\u043d\u043e. \u041e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c
    \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0432 1931 \u0433\u043e\u0434\u0443,
    \u0430 \u0435\u0451 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c \u2014
    \u0432 1946 \u0433\u043e\u0434\u0443. \u0412 1937 \u0433\u043e\u0434\u0443 \u041a\u0430\u0437\u0430\u043d\u0441\u043a\u043e\u0435
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b\u043e
    \u0435\u043c\u0443 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0443\u044e
    \u043f\u0440\u0435\u043c\u0438\u044e \u0438\u043c\u0435\u043d\u0438 \u041d. \u0418. \u041b\u043e\u0431\u0430\u0447\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u0437\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0412 1947 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u042d\u043b\u0438 \u0416\u043e\u0437\u0435\u0444
    \u041a\u0430\u0440\u0442\u0430\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
