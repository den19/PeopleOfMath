    \u0432 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0438 \u043a\u0440\u0430\u0442\u0435\u0440\u0430
    \u043d\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435
    \u041b\u0443\u043d\u044b \u0438 \u0432 \u043f\u0440\u0435\u043c\u0438\u0438 \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a.\n\n\U0001F4A1
