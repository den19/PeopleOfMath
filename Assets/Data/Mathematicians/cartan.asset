    \u0412 \u044d\u0442\u043e\u0439 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0435 \u043e\u043d
    \u0438 \u0432\u044b\u0440\u043e\u0441. \u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0447\u0442\u043e, \u0443\u0436\u0435 \u0431\u0443\u0434\u0443\u0447\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u0438 \u043f\u0440\u0438\u0435\u0437\u0436\u0430\u044f
    \u043d\u0430 \u043a\u0430\u043d\u0438\u043a\u0443\u043b\u044b \u0432 \u0440\u043e\u0434\u043d\u0443\u044e
    \u0434\u0435\u0440\u0435\u0432\u043d\u044e \u0414\u043e\u043b\u043e\u043c\u044c\u0451, \u041a\u0430\u0440\u0442\u0430\u043d
    \u0438\u043d\u043e\u0433\u0434\u0430 \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u043e\u0442\u0446\u0443
    \u0438 \u0431\u0440\u0430\u0442\u0443 \u0432 \u043a\u0443\u0437\u043d\u0438\u0446\u0435
    \u2014 \u0440\u0430\u0437\u0434\u0443\u0432\u0430\u043b \u043c\u0435\u0445\u0430. \u042d\u0442\u043e
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0432\u0441\u044e \u0441\u0432\u043e\u044e \u0441\u043b\u0430\u0432\u0443,
    \u043e\u043d \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b
    \u0441\u0432\u044f\u0437\u044c \u0441 \u043a\u043e\u0440\u043d\u044f\u043c\u0438.\n\n\U0001F52C
    \u0421\u043f\u0430\u0441\u0435\u043d\u0438\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u043c\u0443 \u0438\u043d\u0441\u043f\u0435\u043a\u0442\u043e\u0440\u0443
    \u041a\u0430\u0440\u0442\u0430\u043d \u043c\u043e\u0433 \u0431\u044b \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u043e\u0441\u0442\u0430\u0442\u044c\u0441\u044f \u043a\u0443\u0437\u043d\u0435\u0446\u043e\u043c
    \u0438\u043b\u0438 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c,
    \u0435\u0441\u043b\u0438 \u0431\u044b \u043d\u0435 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0439
    \u0441\u043b\u0443\u0447\u0430\u0439. \u0415\u0433\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 (\u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439
    \u0443\u043c) \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0439
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c, \u0430 \u0437\u0430\u0442\u0435\u043c \u0438
    \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0439 \u0438\u043d\u0441\u043f\u0435\u043a\u0442\u043e\u0440
    \u0410\u043d\u0442\u043e\u043d\u0435\u043d \u0414\u044e\u0431\u043e. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0414\u044e\u0431\u043e, \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u0432 \u0442\u0430\u043b\u0430\u043d\u0442,
    \u0443\u0431\u0435\u0434\u0438\u043b \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0432 \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0435 \u043d\u0430 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e. \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    10-\u043b\u0435\u0442\u043d\u0435\u043c\u0443 \u042d\u043b\u0438 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c
    \u0434\u0435\u0440\u0435\u0432\u043d\u044e \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u043b\u0438\u0446\u0435\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u0432 \u0412\u044b\u0441\u0448\u0435\u0439
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u0435.\n\n\U0001F3C6
    \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u043e\u0442 \u0441\u0430\u043c\u043e\u0433\u043e
    \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u0422\u0440\u0443\u0434\u044b \u041a\u0430\u0440\u0442\u0430\u043d\u0430
    \u0431\u044b\u043b\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u043e\u0436\u043d\u044b
    \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u043c\u0438, \u0447\u0442\u043e
    \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u043d\u0435\u0434\u043e\u043e\u0446\u0435\u043d\u0435\u043d\u043d\u044b\u043c\u0438. \u041f\u0435\u0440\u0432\u044b\u043c,
    \u043a\u0442\u043e \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443
    \u043f\u043e\u043d\u044f\u043b \u0438\u0445 \u043c\u0430\u0441\u0448\u0442\u0430\u0431,
    \u0431\u044b\u043b \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435.
    \u0412 1912 \u0433\u043e\u0434\u0443, \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e
    \u0434\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u043c\u0435\u0440\u0442\u0438, \u043e\u043d
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442 \u043e\u0431\u0437\u043e\u0440\u0443
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439 \u041a\u0430\u0440\u0442\u0430\u043d\u0430.
    \u042d\u0442\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0432 \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u0443\u0447\u0435\u043d\u043e\u0433\u043e
    \u0438 \u043e\u0442\u043a\u0440\u044b\u043b\u043e \u0435\u043c\u0443 \u043f\u0443\u0442\u044c
    \u043a \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0432 \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u0435.\n\n\U0001F468\u200d\U0001F3EB \u0421\u0442\u0440\u0430\u043d\u043d\u0430\u044f
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430
    \u0422\u0440\u0443\u0434\u043e\u043b\u044e\u0431\u0438\u0435 \u041a\u0430\u0440\u0442\u0430\u043d\u0430
    \u0432\u043e\u0448\u043b\u043e \u0432 \u043b\u0435\u0433\u0435\u043d\u0434\u0443. \u0415\u0433\u043e
    \u0434\u0440\u0443\u0433 \u0438 \u043e\u0434\u043d\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a
    \u0410\u0440\u0442\u0443\u0440 \u0422\u0440\u0435\u0441\u0441 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b,
    \u0447\u0442\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0443\u0447\u0435\u0431\u044b
    \u0432 \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u0435
    \u041a\u0430\u0440\u0442\u0430\u043d \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0430\u0434\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043c\u0435\u0441\u0442\u043e \u0443 \u0432\u0445\u043e\u0434\u0430 \u0432
    \u0447\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0437\u0430\u043b. \u0414\u0435\u043b\u0430\u043b
    \u043e\u043d \u044d\u0442\u043e \u043d\u0435 \u0438\u0437-\u0437\u0430 \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u044f,
    \u0430 \u0438\u0437 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0437\u043c\u0430: \u0447\u0435\u043c \u043a\u043e\u0440\u043e\u0447\u0435
    \u043f\u0443\u0442\u044c \u043a \u0441\u0442\u043e\u043b\u0443, \u0442\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442\u044c \u0434\u043b\u044f \u0443\u0447\u0435\u0431\u044b.\n\n\U0001F4D6
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \"\u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u0432 \u0442\u0443\u043f\u0438\u043a\" \u043a\u043e\u043b\u043b\u0435\u0433 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0416\u0430\u043d \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435 \u043f\u0438\u0441\u0430\u043b,
    \u0447\u0442\u043e \u041a\u0430\u0440\u0442\u0430\u043d \u0438\u0437\u043b\u0430\u0433\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438 \u0432 \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e
    \u0441\u0436\u0430\u0442\u043e\u043c \u0438 \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u043c
    \u0441\u0442\u0438\u043b\u0435. \u042d\u0442\u043e\u0442 \u0441\u0442\u0438\u043b\u044c,
    \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435,
    \u00ab\u0441\u0442\u0430\u0432\u0438\u043b \u0432 \u0442\u0443\u043f\u0438\u043a \u0434\u0432\u0430
    \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432\u00bb.
    \u0415\u0433\u043e \u0433\u043b\u0443\u0431\u043e\u0447\u0430\u0439\u0448\u0430\u044f \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f
    \u0438 \u0443\u043c\u0435\u043d\u0438\u0435 \u0432\u0438\u0434\u0435\u0442\u044c \u0441\u043a\u0440\u044b\u0442\u044b\u0435
    \u0441\u0432\u044f\u0437\u0438 \u043c\u0435\u0436\u0434\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0434\u0435\u043b\u0430\u043b\u0438
    \u0435\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u044b \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438 \u0442\u0440\u0443\u0434\u043d\u044b\u043c\u0438
    \u0434\u043b\u044f \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f.\n\n\U0001F680
    \"\u041f\u0440\u043e\u0432\u0430\u043b\u044c\u043d\u0430\u044f\" \u0442\u0435\u043e\u0440\u0438\u044f,
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0430\u044f \u0432\u0440\u0435\u043c\u044f
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 XX \u0432\u0435\u043a\u0430 \u041a\u0430\u0440\u0442\u0430\u043d,
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u044b\u0439 \u043e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430, \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0435\u0434\u0438\u043d\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u043e\u043b\u044f.
    \u0412 \u044d\u0442\u043e\u043c \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u043c
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u043e\u043d \u043d\u0435
    \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u0443\u0441\u043f\u0435\u0445\u0430. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0432 \u0445\u043e\u0434\u0435 \u044d\u0442\u0438\u0445 \u043f\u043e\u0438\u0441\u043a\u043e\u0432
    \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432
    \u0441 \u043a\u0440\u0443\u0447\u0435\u043d\u0438\u0435\u043c \u2014 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0430
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0438 \u043b\u0438\u0448\u044c
    \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u043d\u0430\u0448\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0442\u0435\u043e\u0440\u0438\u044f\u0445
    \u0444\u0438\u0437\u0438\u043a\u0438, \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0445
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044e \u0441 \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u043c\u0438
    \u044d\u0444\u0444\u0435\u043a\u0442\u0430\u043c\u0438. \u0422\u0430\u043a \u043d\u0430\u0443\u0447\u043d\u0430\u044f
    \"\u043d\u0435\u0443\u0434\u0430\u0447\u0430\" \u043e\u0431\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c
    \u0432\u043a\u043b\u0430\u0434\u043e\u043c \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u0435.\n\n\U0001F315
    \u0412\u0435\u0447\u043d\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u043d\u0430 \u041b\u0443\u043d\u0435 \u0412\u043a\u043b\u0430\u0434 \u041a\u0430\u0440\u0442\u0430\u043d\u0430
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u0431\u044b\u043b \u0443\u0432\u0435\u043a\u043e\u0432\u0435\u0447\u0435\u043d
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0417\u0435\u043c\u043b\u0435,
    \u043d\u043e \u0438 \u0437\u0430 \u0435\u0435 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438:
    \u0432 \u0447\u0435\u0441\u0442\u044c \u043d\u0435\u0433\u043e \u043d\u0430\u0437\u0432\u0430\u043d
    \u043a\u0440\u0430\u0442\u0435\u0440 \u043d\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0439
    \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u041b\u0443\u043d\u044b. \u041a\u0440\u043e\u043c\u0435
    \u0442\u043e\u0433\u043e, \u0435\u0433\u043e \u0438\u043c\u044f \u043d\u043e\u0441\u0438\u0442
    \u043f\u0440\u0435\u043c\u0438\u044f, \u043f\u0440\u0438\u0441\u0443\u0436\u0434\u0430\u0435\u043c\u0430\u044f
    \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0435\u0439
    \u043d\u0430\u0443\u043a."
  interestingFactsEn: "Although Eli Joseph Cartan was a man who was completely trapped in the abstract worlds of mathematics, his life was full of amazing stories about his personality and age, and these are some of the most interesting and interesting facts.\n\n===Career=====Charter's Mathematics Dynasty===Cartan founded a real scientific dynasty. His eldest son, Henri Cartan, also became a world-renowned mathematician, one of the founders of the group Burbaki. It's interesting that, despite the general passion for science, their relationship was more of a relationship between two independent colleagues. Henri later recalled: \"The father worked in his corner and I worked in his own corner. He never tried to influence me.\"Their only joint scientific work came out in 1931.\n\nIn 1939, by his 70th birthday, Cartan wrote: \"My childhood was under the blows of the hardcores that were given every morning since dawn.\" In this atmosphere, he grew up. It is indicative that, already as a professor in Paris and visiting his home village of Dolomieu, Cartan sometimes helped his father and his brother in the blacksmith, he blew fur.This shows that, despite his glory, he has forever maintained a connection with his roots.\n\nThe rescue of a school inspector, Cartan, could have been a blacksmith or a village teacher for ever had it not been for a happy occasion. His exceptional abilities (fenominal memory and brilliant mind) were noticed by a school teacher, and then by a school inspector, Antonen Dubo. It was Dubo who, after seeing the talent, convinced the boy to compete for a government scholarship.This allowed a 10-year-old Ali to leave the village and to be educated at the lyceum and then at the Normal High School.\n\nThe recognition of Poancare's own work was so complex and innovative that it remained undervalued for a long time. The first to truly understand its scale was the great Henri Poankare, who in 1912, shortly before his death, dedicated one of the most recent scientific works to a review of the achievements of Cartan, which marked a turning point in his academic career and opened the way for him to become a professor in Sorbonne.\n\nHis friend Arthur Tress recalled that during normal school, Cartan always sat in front of the reading room. He did so not because of superstition, but because of the amazing pragmatism: the shorter the way to the table, the more time could be saved for study.\n\nHis work \"sustained\" colleagues, Mathematician Jean Dieudonne, wrote that Cartan had expressed his ideas in an extremely concise and elegant way, a style that, according to Dieudonne, \"sold two generations of mathematicians into a dead end.\" His deepest intuition and the ability to see hidden links between mathematics areas made his texts both genius and difficult to understand.\n\n==History====================================================================)=============================================)====================)===============)=============)=======================)==============================================================So the scientific \"failure\" turned out to be a fundamental contribution to the future.\n\n▪ The eternal recognition on the Moon of the Contribution of Cartan to Science was perpetuated not only on Earth but also beyond it, with a crater named on the back of the Moon, and a prize awarded by the French Academy of Sciences."
