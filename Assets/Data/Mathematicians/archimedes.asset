  achievementsRu: "\u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u2014 \u0444\u0438\u0433\u0443\u0440\u0430,
    \u0447\u0435\u0439 \u0433\u0435\u043d\u0438\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0441\u0440\u0430\u0437\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c
    \u043d\u0430 \u0442\u0440\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0441\u0444\u0435\u0440\u044b:
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u0444\u0438\u0437\u0438\u043a\u0430
    \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0438\u044f. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430:
    \u041f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0449\u0430\u044f \u0430\u043d\u0430\u043b\u0438\u0437
    \u0412 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f, \u043f\u043e\u0434\u043e\u0439\u0434\u044f
    \u0432\u043f\u043b\u043e\u0442\u043d\u0443\u044e \u043a \u0438\u0434\u0435\u044f\u043c \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u041c\u0435\u0442\u043e\u0434
    \u0438\u0441\u0447\u0435\u0440\u043f\u044b\u0432\u0430\u043d\u0438\u044f \u0438 \u043f\u0440\u0435\u0434\u0442\u0435\u0447\u0430
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u043e\u0432: \u041e\u043d \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u043e
    \u0440\u0430\u0437\u0432\u0438\u043b \u043c\u0435\u0442\u043e\u0434 \u0438\u0441\u0447\u0435\u0440\u043f\u044b\u0432\u0430\u043d\u0438\u044f
    \u0415\u0432\u0434\u043e\u043a\u0441\u0430 \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u043f\u043b\u043e\u0449\u0430\u0434\u0435\u0439 \u0438 \u043e\u0431\u044a\u0435\u043c\u043e\u0432
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0444\u0438\u0433\u0443\u0440. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f,
    \u043e\u043d \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \"\u043d\u0430\u0445\u043e\u0434\u0438\u043b\"
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c \u0441\u0442\u0440\u043e\u0433\u043e
    \u0435\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438.
    \u0412 \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0443\u0434\u0435 \u00ab\u041f\u043e\u0441\u043b\u0430\u043d\u0438\u0435
    \u043a \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u0443 \u043e \u043c\u0435\u0442\u043e\u0434\u0435\u00bb
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u044f,
    \u0431\u043b\u0438\u0437\u043a\u0438\u0435 \u043a \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e
    \u043c\u0430\u043b\u044b\u043c, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u0435\u0434\u0432\u0435\u0441\u0442\u043d\u0438\u043a\u043e\u043c
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u041b\u0435\u0439\u0431\u043d\u0438\u0446\u0430.
    \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f:
    \u041e\u043d \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u043f\u043b\u043e\u0449\u0430\u0434\u044c
    \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430 \u043f\u0430\u0440\u0430\u0431\u043e\u043b\u044b
    (\u043e\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 4/3 \u043e\u0442
    \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u0432\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430) \u0438 \u0434\u043b\u044f
    \u044d\u0442\u043e\u0433\u043e \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043d\u0430\u0448\u0435\u043b \u0441\u0443\u043c\u043c\u0443 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0440\u044f\u0434\u0430 \u0441\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0430\u0442\u0435\u043b\u0435\u043c
    1/4. \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f: \u0412 \u0440\u0430\u0431\u043e\u0442\u0435
    \u00ab\u041e \u0448\u0430\u0440\u0435 \u0438 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0435\u00bb
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u043e\u0431\u044a\u0435\u043c \u0448\u0430\u0440\u0430 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f
    \u043a \u043e\u0431\u044a\u0435\u043c\u0443 \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e
    \u0432\u043e\u043a\u0440\u0443\u0433 \u043d\u0435\u0433\u043e \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430
    \u043a\u0430\u043a 2:3, \u0430 \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u0438\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439
    \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u0442\u043e\u043c \u0436\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043e\u043d \u0446\u0435\u043d\u0438\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e,
    \u0447\u0442\u043e \u0437\u0430\u0432\u0435\u0449\u0430\u043b \u0432\u044b\u0441\u0435\u0447\u044c
    \u043d\u0430 \u0441\u0432\u043e\u0435\u0439 \u043c\u043e\u0433\u0438\u043b\u0435 \u0438\u043c\u0435\u043d\u043d\u043e
    \u044d\u0442\u043e\u0442 \u0447\u0435\u0440\u0442\u0435\u0436. \u0412\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435
    \u0447\u0438\u0441\u043b\u0430 \u03c0 (\u041f\u0438): \u0412 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435
    \u00ab\u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u043a\u0440\u0443\u0433\u0430\u00bb
    \u043e\u043d \u0434\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u0447\u0438\u0441\u043b\u0430
    \u03c0, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0432 \u0435\u0433\u043e \u0432
    \u0442\u043e\u0447\u043d\u044b\u0445 \u0433\u0440\u0430\u043d\u0438\u0446\u0430\u0445: `3
    + 10/71 < \u03c0 < 3 + 1/7`. \u0414\u0440\u0443\u0433\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f:
    \u041e\u043d \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u0441\u0432\u043e\u0435\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0441\u043f\u0438\u0440\u0430\u043b\u0438, \u043d\u0430\u0448\u0435\u043b \u0432\u0441\u0435
    \u043f\u043e\u043b\u0443\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0435 \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u043d\u0438\u043a\u0438
    (\u0430\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u0432\u044b \u0442\u0435\u043b\u0430),
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u0443
    \u0434\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0438 \u0441\u0432\u0435\u0440\u0445\u0431\u043e\u043b\u044c\u0448\u0438\u0445
    \u0447\u0438\u0441\u0435\u043b \u0432 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u00ab\u041f\u0441\u0430\u043c\u043c\u0438\u0442\u00bb
    (\u00ab\u0418\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u043f\u0435\u0441\u0447\u0438\u043d\u043e\u043a\u00bb)
    \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0430\u043a\u0441\u0438\u043e\u043c\u0443,
    \u043d\u043e\u0441\u044f\u0449\u0443\u044e \u0435\u0433\u043e \u0438\u043c\u044f. \u0424\u0438\u0437\u0438\u043a\u0430:
    \u041e\u0441\u043d\u043e\u0432\u044b \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0438
    \u0433\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438 \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0442\u0446\u043e\u0432-\u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438 \u043a\u0430\u043a \u043d\u0430\u0443\u043a\u0438.
    \u0421\u0442\u0430\u0442\u0438\u043a\u0430 \u0438 \u0440\u044b\u0447\u0430\u0433: \u041e\u043d
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0440\u044b\u0447\u0430\u0433, \u0430 \u0434\u0430\u043b \u0435\u0433\u043e \u043f\u043e\u043b\u043d\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e.
    \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u0444\u0440\u0430\u0437\u0430:
    \u00ab\u0414\u0430\u0439\u0442\u0435 \u043c\u043d\u0435 \u0442\u043e\u0447\u043a\u0443 \u043e\u043f\u043e\u0440\u044b,
    \u0438 \u044f \u0441\u0434\u0432\u0438\u043d\u0443 \u0417\u0435\u043c\u043b\u044e\u00bb
    \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u043c\u043e\u0449\u0438
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u043d\u0430\u043d\u0438\u0439.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0432\u0432\u0435\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u0446\u0435\u043d\u0442\u0440\u0430 \u0442\u044f\u0436\u0435\u0441\u0442\u0438
    \u0442\u0435\u043b \u0438 \u043d\u0430\u0448\u0435\u043b \u0435\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0434\u043b\u044f \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0438\u0433\u0443\u0440. \u0413\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0430
    \u0438 \u0417\u0430\u043a\u043e\u043d \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430:
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0444\u0438\u0437\u0438\u043a\u0443 \u2014 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435
    \u0433\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438. \u0412 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435
    \u00ab\u041e \u043f\u043b\u0430\u0432\u0430\u044e\u0449\u0438\u0445 \u0442\u0435\u043b\u0430\u0445\u00bb
    \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0437\u0430\u043a\u043e\u043d:
    \u043d\u0430 \u0442\u0435\u043b\u043e, \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0435
    \u0432 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432\u044b\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0441\u0438\u043b\u0430,
    \u0440\u0430\u0432\u043d\u0430\u044f \u0432\u0435\u0441\u0443 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438
    \u0432 \u043e\u0431\u044a\u0435\u043c\u0435 \u044d\u0442\u043e\u0433\u043e \u0442\u0435\u043b\u0430.
    \u041b\u0435\u0433\u0435\u043d\u0434\u0430 \u043e\u0431 \u00ab\u042d\u0432\u0440\u0438\u043a\u0435!\u00bb:
    \u0421 \u044d\u0442\u0438\u043c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u0441\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043b\u0435\u0433\u0435\u043d\u0434\u0430.
    \u0426\u0430\u0440\u044c \u0413\u0438\u0435\u0440\u043e\u043d \u043f\u043e\u0440\u0443\u0447\u0438\u043b
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0443 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c,
    \u043d\u0435 \u043e\u0431\u043c\u0430\u043d\u0443\u043b \u043b\u0438 \u0435\u0433\u043e
    \u044e\u0432\u0435\u043b\u0438\u0440, \u0441\u0434\u0435\u043b\u0430\u0432\u0448\u0438\u0439
    \u0437\u043e\u043b\u043e\u0442\u0443\u044e \u043a\u043e\u0440\u043e\u043d\u0443. \u0420\u0430\u0437\u043c\u044b\u0448\u043b\u044f\u044f
    \u043d\u0430\u0434 \u0437\u0430\u0434\u0430\u0447\u0435\u0439, \u0410\u0440\u0445\u0438\u043c\u0435\u0434,
    \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u0432\u0448\u0438\u0441\u044c \u0432 \u0432\u0430\u043d\u043d\u0443,
    \u0437\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u0443\u0440\u043e\u0432\u0435\u043d\u044c
    \u0432\u043e\u0434\u044b \u043f\u043e\u0434\u043d\u044f\u043b\u0441\u044f, \u0438 \u043f\u043e\u043d\u044f\u043b,
    \u043a\u0430\u043a \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u044c \u043e\u0431\u044a\u0435\u043c
    \u043a\u043e\u0440\u043e\u043d\u044b \u043f\u043e \u043e\u0431\u044a\u0435\u043c\u0443 \u0432\u044b\u0442\u0435\u0441\u043d\u0435\u043d\u043d\u043e\u0439
    \u0432\u043e\u0434\u044b. \u0421 \u043a\u0440\u0438\u043a\u043e\u043c \u00ab\u042d\u0432\u0440\u0438\u043a\u0430!\u00bb
    (\u00ab\u041d\u0430\u0448\u0435\u043b!\u00bb) \u043e\u043d \u0432\u044b\u0441\u043a\u043e\u0447\u0438\u043b
    \u0438\u0437 \u0432\u0430\u043d\u043d\u044b \u0438 \u043f\u043e\u0431\u0435\u0436\u0430\u043b
    \u043a \u0446\u0430\u0440\u044e. \u0422\u0430\u043a \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043a\u043e\u0440\u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0434\u0435\u043b\u0430\u043d\u0430
    \u043d\u0435 \u0438\u0437 \u0447\u0438\u0441\u0442\u043e\u0433\u043e \u0437\u043e\u043b\u043e\u0442\u0430.
    \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u0435 \u0434\u0435\u043b\u043e \u0438
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f \u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0438 \u0435\u043c\u0443 \u043e\u0433\u0440\u043e\u043c\u043d\u0443\u044e
    \u0441\u043b\u0430\u0432\u0443 \u043f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438. \u041e\u0431\u043e\u0440\u043e\u043d\u0430
    \u0421\u0438\u0440\u0430\u043a\u0443\u0437: \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u043e\u0441\u0430\u0434\u044b \u0435\u0433\u043e \u0440\u043e\u0434\u043d\u043e\u0433\u043e
    \u0433\u043e\u0440\u043e\u0434\u0430 \u0440\u0438\u043c\u043b\u044f\u043d\u0430\u043c\u0438
    \u0432\u043e \u0412\u0442\u043e\u0440\u043e\u0439 \u041f\u0443\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0432\u043e\u0439\u043d\u0435, \u043f\u0440\u0435\u0441\u0442\u0430\u0440\u0435\u043b\u044b\u0439
    \u0443\u0447\u0435\u043d\u044b\u0439 \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u0430\u0448\u0438\u043d\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435
    \u0434\u0432\u0443\u0445 \u043b\u0435\u0442 \u043d\u0435 \u0434\u0430\u0432\u0430\u043b\u0438
    \u0432\u0440\u0430\u0433\u0443 \u0432\u0437\u044f\u0442\u044c \u0433\u043e\u0440\u043e\u0434.
    \u041e\u043d \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u043e\u0449\u043d\u044b\u0435 \u043a\u0430\u0442\u0430\u043f\u0443\u043b\u044c\u0442\u044b
    \u0438 \u0431\u0430\u043b\u043b\u0438\u0441\u0442\u044b, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043f\u043e\u0434\u044a\u0435\u043c\u043d\u044b\u0435 \u043a\u0440\u0430\u043d\u044b (\u00ab\u041a\u043e\u0433\u043e\u0442\u044c
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430\u00bb), \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u043b\u0438 \u043d\u043e\u0441\u044b
    \u0440\u0438\u043c\u0441\u043a\u0438\u0445 \u0433\u0430\u043b\u0435\u0440, \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u043b\u0438
    \u0438\u0445 \u0432 \u0432\u043e\u0437\u0434\u0443\u0445 \u0438 \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u043b\u0438
    \u043e \u0441\u043a\u0430\u043b\u044b \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043b\u0438.
    \u0415\u043c\u0443 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0437\u0430\u0436\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0437\u0435\u0440\u043a\u0430\u043b
    \u0434\u043b\u044f \u043f\u043e\u0434\u0436\u043e\u0433\u0430 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u043b\u043e\u0442\u0430, \u0445\u043e\u0442\u044f \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0441\u0442\u044c
    \u044d\u0442\u043e\u0433\u043e \u0444\u0430\u043a\u0442\u0430 \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044f
    \u043f\u043e\u0434 \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u0435. \u00ab\u0410\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u0432
    \u0432\u0438\u043d\u0442\u00bb: \u042d\u0442\u043e \u0432\u043e\u0434\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u044b\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c (\u0448\u043d\u0435\u043a), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u0434\u043b\u044f
    \u043e\u0440\u043e\u0448\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u0435\u0439 \u0438 \u043e\u0441\u0443\u0448\u0435\u043d\u0438\u044f
    \u0431\u043e\u043b\u043e\u0442. \u041f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u043e \u0435\u0433\u043e \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u044b\u0439
    \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438
    \u0438 \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043c\u044f\u0441\u043e\u0440\u0443\u0431\u043a\u0430\u0445.
    \u041c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b \u0434\u043b\u044f \u043f\u043e\u0434\u044a\u0435\u043c\u0430
    \u0442\u044f\u0436\u0435\u0441\u0442\u0435\u0439: \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0431\u043b\u043e\u043a\u043e\u0432 (\u043f\u043e\u043b\u0438\u0441\u043f\u0430\u0441\u0442),
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043a\u043e\u0442\u043e\u0440\u043e\u0439,
    \u043a\u0430\u043a \u0433\u043b\u0430\u0441\u0438\u0442 \u043b\u0435\u0433\u0435\u043d\u0434\u0430,
    \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443 \u0441\u043c\u043e\u0433 \u0441\u043f\u0443\u0441\u0442\u0438\u0442\u044c
    \u043d\u0430 \u0432\u043e\u0434\u0443 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u043a\u043e\u0440\u0430\u0431\u043b\u044c
    \u00ab\u0421\u0438\u0440\u0430\u043a\u0443\u0437\u0438\u044f\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0435 \u043c\u043e\u0433\u043b\u0438 \u0441\u0434\u0432\u0438\u043d\u0443\u0442\u044c
    \u0441\u043e\u0442\u043d\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f
    \u0438 \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u0440\u0438\u0439: \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u044b\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u0440\u0438\u0439
    (\u00ab\u043d\u0435\u0431\u0435\u0441\u043d\u0443\u044e \u0441\u0444\u0435\u0440\u0443\u00bb),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0435\u0442, \u0421\u043e\u043b\u043d\u0446\u0430
    \u0438 \u041b\u0443\u043d\u044b, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0444\u0430\u0437\u044b \u0438 \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u044f. \u0418\u0434\u0435\u0438
    \u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430
    \u043d\u0430 \u0446\u0435\u043b\u044b\u0445 \u0434\u0432\u0430 \u0442\u044b\u0441\u044f\u0447\u0435\u043b\u0435\u0442\u0438\u044f
    \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438 \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0432 \u044d\u043f\u043e\u0445\u0443
    \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u044b\u0440\u043e\u0441\u043b\u043e
    \u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0444\u0438\u0437\u0438\u043a\u0438."
  achievementsEn: "Archimedes is a figure whose genius determined the development of several scientific disciplines. His contributions can be divided into three main areas: mathematics, physics and engineering. Mathematics: Anticipating Analysis In mathematics, Archimedes was far ahead of his time, coming close to the ideas of integral calculus. The method of exhaustion and the forerunner of integrals: He masterfully developed the method of exhaustion of Eudoxus for calculating the areas and volumes of complex figures. Using mechanical considerations, he first “found” the solution and then rigorously proved it geometrically. In his work “Epistle to Eratosthenes on Method,” he used concepts close to infinitesimals, which became the forerunner of the integral calculus of Newton and Leibniz. Geometric discoveries: He calculated the area of ​​a parabola segment (it is 4/3 of the area of ​​an inscribed triangle) and for this, for the first time in history, he found the sum of an infinite geometric series with a denominator of 1/4. Fundamental relationships: In his work “On the Sphere and the Cylinder,” Archimedes proved that the volume of a sphere is related to the volume of the cylinder described around it as 2:3, and the areas of their surfaces are in the same ratio. He valued this discovery so much that he bequeathed this particular drawing to be carved on his grave. Calculation of the number π (Pi): In the treatise “Measurement of the Circle”, he gave the first ever rigorous mathematical calculation of the number π, establishing it within the exact boundaries: `3 + 10/71 < π < 3 + 1/7`. Other achievements: He explored the properties of his famous spiral, found all the semiregular polyhedra (Archimedean solids), developed a system for writing superlarge numbers in the treatise Psammit (Calculus of grains of sand), and formulated the axiom that bears his name. Physics: Fundamentals of Mechanics and Hydrostatics Archimedes is rightfully considered one of the founding fathers of physics as a science. Statics and Lever: He did not just use the lever, but gave a complete mathematical theory of it. His famous phrase: “Give me a fulcrum, and I will move the Earth” became a symbol of the power of theoretical knowledge. He also introduced the fundamental concept of the center of gravity of bodies and found its position for many geometric figures. Hydrostatics and Archimedes' Law: His main contribution to physics is the foundation of hydrostatics. In his treatise “On Floating Bodies,” he formulated his famous law: a body immersed in a liquid is acted upon by a buoyant force equal to the weight of the liquid in the volume of this body. The Legend of \"Eureka!\": The most famous legend is associated with this discovery.King Hiero instructed Archimedes to check whether the jeweler who made the golden crown had deceived him. While pondering the problem, Archimedes, immersed in a bathtub, noticed that the water level had risen and figured out how to measure the volume of the crown by the volume of water displaced. With a cry of “Eureka!” (“Found!”) he jumped out of the bath and ran to the king. So he proved that the crown was not made of pure gold. Engineering and Inventions Archimedes' practical inventions brought him great fame during his lifetime. Defense of Syracuse: During the siege of his hometown by the Romans in the Second Punic War, the elderly scientist created machines that prevented the enemy from taking the city for two years. He designed powerful catapults and ballistas, as well as cranes (the Claw of Archimedes) that grabbed the bows of Roman galleys, lifted them into the air and smashed them against rocks or overturned them. He is also credited with creating a system of incendiary mirrors for setting enemy fleets on fire, although the veracity of this fact has been questioned. “Archimedes screw”: This is a water-lifting mechanism (auger) that was used to irrigate fields and drain swamps. Surprisingly, its simplified version can also be found in modern meat grinders. Mechanisms for lifting weights: He created a system of blocks (pulley hoist), with the help of which, as legend says, he was able to single-handedly launch the huge ship Syracuse, which hundreds of people could not move. Astronomy and Planetarium: Archimedes constructed a complex mechanical planetarium (“celestial sphere”) that showed the movements of the planets, the Sun and the Moon, and predicted phases and eclipses. Archimedes' ideas and discoveries were two millennia ahead of their time. His work became the foundation on which the edifice of modern mathematics and physics grew during the Renaissance."
  personalLifeRu: "\u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e
    \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043b\u0438\u0447\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 \u043f\u043e
    \u0433\u043e\u0434\u0430\u043c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0430\u044f \u0435\u0433\u043e \u0434\u0440\u0443\u0433\u043e\u043c
    \u0413\u0435\u0440\u0430\u043a\u043b\u0438\u0434\u043e\u043c, \u0431\u044b\u043b\u0430 \u0443\u0442\u0435\u0440\u044f\u043d\u0430,
    \u0430 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u044b
    \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043d\u0430 \u0435\u0433\u043e
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u0445 \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f\u0445.
    \u0412\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f
    \u043e \u0435\u0433\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u043c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438
    \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u043c\u0443
    \u0444\u0430\u043a\u0442\u0443: \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0431\u044b\u043b \u043b\u0438 \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u0436\u0435\u043d\u0430\u0442
    \u0438 \u0438\u043c\u0435\u043b \u043b\u0438 \u0434\u0435\u0442\u0435\u0439. \u0418\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u043d\u0435 \u043d\u0430\u0448\u043b\u0438 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b \u043f\u0440\u043e\u043b\u0438\u0432\u0430\u043b\u0438
    \u0441\u0432\u0435\u0442 \u043d\u0430 \u044d\u0442\u0443 \u0441\u0442\u043e\u0440\u043e\u043d\u0443
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u043b\u0438\u0448\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043e \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0435: \u041e\u0442\u0435\u0446: \u0424\u0438\u0434\u0438\u0439,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a.
    \u0420\u043e\u0434\u0441\u0442\u0432\u043e: \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0441\u043e\u0441\u0442\u043e\u044f\u043b \u0432 \u0440\u043e\u0434\u0441\u0442\u0432\u0435
    \u0441 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u0435\u043c \u0421\u0438\u0440\u0430\u043a\u0443\u0437
    \u0413\u0438\u0435\u0440\u043e\u043d\u043e\u043c II. \u041e\u0441\u0442\u0430\u0451\u0442\u0441\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0442\u043e\u0442
    \u0444\u0430\u043a\u0442, \u0447\u0442\u043e \u00ab\u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c\u00bb \u044d\u0442\u043e\u0433\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u0432\u043d\u0435 \u043f\u043e\u043b\u044f
    \u0437\u0440\u0435\u043d\u0438\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u0443\u0441\u0442\u0443\u043f\u0438\u0432
    \u043c\u0435\u0441\u0442\u043e \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0442\u0440\u0443\u0434\u0430\u043c \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f\u043c."
  personalLifeEn: "Unfortunately, it is impossible to reliably reconstruct Archimedes' personal life year by year. The scientific biography written by his friend Heracleides was lost, and the information from later historians focuses mainly on his discoveries and inventions. All available information about his family status comes down to one unequivocal fact: it is unknown whether Archimedes was married or had children. Historians have found no evidence that would shed light on this aspect of his life. Only some information about his family is known: Father: Phidias, an astronomer and mathematician. Relatives: Presumably related to the ruler of Syracuse, Hieron II. One can only accept the fact that the \"personal life\" of this great scientist has forever remained outside the field of historical view, giving way to his brilliant works and inventions."
  shortBioRu: "\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043e \u0436\u0438\u0437\u043d\u0438 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 \u0434\u043e\u0448\u043b\u0438
    \u0434\u043e \u043d\u0430\u0441 \u0438\u0437 \u0442\u0440\u0443\u0434\u043e\u0432 \u0431\u043e\u043b\u0435\u0435
    \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432,
    \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u041f\u043b\u0443\u0442\u0430\u0440\u0445,
    \u0422\u0438\u0442 \u041b\u0438\u0432\u0438\u0439 \u0438 \u0426\u0438\u0446\u0435\u0440\u043e\u043d,
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0430\u0442\u044b
    \u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438.
    \u041d\u0430\u0447\u0430\u043b\u043e \u043f\u0443\u0442\u0438 \u0432 \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u0430\u0445
    (\u043e\u043a. 287 \u0433. \u0434\u043e \u043d. \u044d.) \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043e\u043a\u043e\u043b\u043e 287 \u0433\u043e\u0434\u0430
    \u0434\u043e \u043d\u0430\u0448\u0435\u0439 \u044d\u0440\u044b \u0432 \u0433\u043e\u0440\u043e\u0434\u0435
    \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432\u0435
    \u0421\u0438\u0446\u0438\u043b\u0438\u044f. \u0412 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u044d\u0442\u043e \u0431\u044b\u043b \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u0438
    \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u043b\u0438\u0441. \u0415\u0433\u043e \u043e\u0442\u0446\u043e\u043c, \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u0431\u044b\u043b \u0424\u0438\u0434\u0438\u0439 \u2014 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a, \u0441\u043e\u0441\u0442\u043e\u044f\u0432\u0448\u0438\u0439
    \u0432 \u0431\u043b\u0438\u0437\u043a\u043e\u043c \u0440\u043e\u0434\u0441\u0442\u0432\u0435
    \u0441 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u0435\u043c \u0421\u0438\u0440\u0430\u043a\u0443\u0437,
    \u0442\u0438\u0440\u0430\u043d\u043e\u043c \u0413\u0438\u0435\u0440\u043e\u043d\u043e\u043c
    II. \u042d\u0442\u043e \u0440\u043e\u0434\u0441\u0442\u0432\u043e \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u043b\u043e \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0443
    \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f
    \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u043d\u0430\u0443\u043a\u043e\u0439. \u0413\u043e\u0434\u044b
    \u0443\u0447\u0435\u043d\u0438\u044f \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438
    (\u043e\u043a. 287 - \u043e\u043a. 265 \u0433. \u0434\u043e \u043d. \u044d.) \u0414\u043b\u044f
    \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u044e \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u0443\u044e,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u043c
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0430\u043d\u0442\u0438\u0447\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u0422\u0430\u043c, \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c
    \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u043e\u043c
    \u043c\u0443\u0441\u0435\u0439\u043e\u043d\u0435 \u0438 \u043f\u0440\u0438 \u0435\u0433\u043e
    \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435, \u0441\u043e\u0431\u0440\u0430\u0432\u0448\u0435\u0439
    \u0441\u043e\u0442\u043d\u0438 \u0442\u044b\u0441\u044f\u0447 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439,
    \u043e\u043d \u0441\u043c\u043e\u0433 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0442\u0440\u0443\u0434\u0430\u043c\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u043e\u0432,
    \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0414\u0435\u043c\u043e\u043a\u0440\u0438\u0442
    \u0438 \u0415\u0432\u0434\u043e\u043a\u0441. \u0412 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0438
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0441\u044f
    \u0438 \u0432\u0451\u043b \u043d\u0430\u0443\u0447\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438 \u0443\u0447\u0451\u043d\u044b\u043c\u0438
    \u2014 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c \u041a\u043e\u043d\u043e\u043d\u043e\u043c
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u042d\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u043d\u043e\u043c.
    \u0417\u0440\u0435\u043b\u044b\u0435 \u0433\u043e\u0434\u044b \u0438 \u0440\u0430\u0441\u0446\u0432\u0435\u0442
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    (\u043e\u043a. 265 - 215 \u0433. \u0434\u043e \u043d. \u044d.) \u041f\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0440\u043e\u0434\u043d\u044b\u0435
    \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u044b, \u0433\u0434\u0435 \u043f\u0440\u043e\u0432\u0451\u043b
    \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0441\u0432\u043e\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438. \u041e\u043d \u043d\u0435 \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f
    \u043a \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u0435
    \u0438, \u0431\u0443\u0434\u0443\u0447\u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043c\u043e\u0433 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c \u0441\u0435\u0431\u044f \u043d\u0430\u0443\u043a\u0435.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u0434\u0435\u043b\u0430\u0435\u0442 \u0441\u0432\u043e\u0438 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f. \u0421\u0440\u0435\u0434\u0438 \u043d\u0438\u0445:
    \u0417\u0430\u043a\u043e\u043d \u0433\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438
    (\u00ab\u0417\u0430\u043a\u043e\u043d \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430\u00bb).
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u0446\u0430\u0440\u044c \u0413\u0438\u0435\u0440\u043e\u043d \u043f\u043e\u0440\u0443\u0447\u0438\u043b
    \u0435\u043c\u0443 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c, \u043d\u0435
    \u043e\u0431\u043c\u0430\u043d\u0443\u043b \u043b\u0438 \u044e\u0432\u0435\u043b\u0438\u0440,
    \u0441\u0434\u0435\u043b\u0430\u0432\u0448\u0438\u0439 \u0437\u043e\u043b\u043e\u0442\u0443\u044e
    \u043a\u043e\u0440\u043e\u043d\u0443, \u043f\u043e\u0434\u043c\u0435\u0448\u0430\u0432 \u0432
    \u043d\u0435\u0451 \u0441\u0435\u0440\u0435\u0431\u0440\u043e. \u0420\u0430\u0437\u043c\u044b\u0448\u043b\u044f\u044f
    \u043d\u0430\u0434 \u0437\u0430\u0434\u0430\u0447\u0435\u0439, \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u043d\u0430\u0448\u0451\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043a\u043e\u0433\u0434\u0430
    \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u043b\u0441\u044f \u0432 \u0432\u0430\u043d\u043d\u0443:
    \u043e\u0431\u044a\u0451\u043c \u0432\u044b\u0442\u0435\u0441\u043d\u0435\u043d\u043d\u043e\u0439
    \u0432\u043e\u0434\u044b \u0440\u0430\u0432\u0435\u043d \u043e\u0431\u044a\u0451\u043c\u0443
    \u043f\u043e\u0433\u0440\u0443\u0436\u0451\u043d\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430.
    \u0421 \u043a\u0440\u0438\u043a\u043e\u043c \u00ab\u042d\u0432\u0440\u0438\u043a\u0430!\u00bb
    \u043e\u043d \u0432\u044b\u0441\u043a\u043e\u0447\u0438\u043b \u0438\u0437 \u0432\u0430\u043d\u043d\u044b
    \u0438 \u043f\u043e\u0431\u0435\u0436\u0430\u043b \u0434\u043e\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c
    \u043e \u0441\u0432\u043e\u0451\u043c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0440\u044b\u0447\u0430\u0433\u0430 \u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0435
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b. \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043f\u0438\u0441\u0430\u043b \u0437\u0430\u043a\u043e\u043d
    \u0440\u044b\u0447\u0430\u0433\u0430, \u043d\u043e \u0438 \u0441\u043e\u0437\u0434\u0430\u043b
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0431\u043b\u043e\u0447\u043d\u044b\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b
    (\u043f\u043e\u043b\u0438\u0441\u043f\u0430\u0441\u0442\u044b). \u0415\u043c\u0443 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0444\u0440\u0430\u0437\u0443:
    \u00ab\u0414\u0430\u0439\u0442\u0435 \u043c\u043d\u0435 \u0442\u043e\u0447\u043a\u0443 \u043e\u043f\u043e\u0440\u044b,
    \u0438 \u044f \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443 \u043c\u0438\u0440\u00bb.
    \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u044d\u0442\u0438\u0445 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u043e\u0432
    \u043e\u043d \u0441\u043c\u043e\u0433 \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443
    \u0441\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043d\u0430 \u0432\u043e\u0434\u0443 \u0442\u044f\u0436\u0435\u043b\u043e\u0433\u0440\u0443\u0436\u0451\u043d\u044b\u0439
    \u043a\u043e\u0440\u0430\u0431\u043b\u044c \u00ab\u0421\u0438\u0440\u0430\u043a\u0443\u0437\u0438\u044f\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u043c\u043e\u0433\u043b\u0438 \u0441\u0434\u0432\u0438\u043d\u0443\u0442\u044c
    \u0441\u043e\u0442\u043d\u0438 \u043b\u044e\u0434\u0435\u0439. \u0422\u0430\u043a\u0436\u0435
    \u0435\u043c\u0443 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u0432\u043e\u0434\u043e\u043f\u043e\u0434\u044a\u0451\u043c\u043d\u043e\u0433\u043e \u0432\u0438\u043d\u0442\u0430
    (\u00ab\u0430\u0440\u0445\u0438\u043c\u0435\u0434\u043e\u0432 \u0432\u0438\u043d\u0442\u00bb),
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0441\u0442\u0440\u0430\u043d\u0430\u0445. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.
    \u0412 \u0441\u0432\u043e\u0438\u0445 \u0442\u0440\u0443\u0434\u0430\u0445 (\u00ab\u041e\u0431
    \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438 \u043a\u0440\u0443\u0433\u0430\u00bb,
    \u00ab\u041e \u0448\u0430\u0440\u0435 \u0438 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0435\u00bb)
    \u043e\u043d \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u0447\u0438\u0441\u043b\u043e \u03c0 \u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043e\u0431\u044a\u0451\u043c
    \u0448\u0430\u0440\u0430 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043a \u043e\u0431\u044a\u0451\u043c\u0443
    \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e \u0432\u043e\u043a\u0440\u0443\u0433
    \u043d\u0435\u0433\u043e \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430 \u043a\u0430\u043a
    2:3. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043e\u043d \u0446\u0435\u043d\u0438\u043b
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e, \u0447\u0442\u043e \u0437\u0430\u0432\u0435\u0449\u0430\u043b
    \u0432\u044b\u0441\u0435\u0447\u044c \u043d\u0430 \u0441\u0432\u043e\u0435\u0439 \u043c\u043e\u0433\u0438\u043b\u0435
    \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0443 \u0444\u0438\u0433\u0443\u0440\u0443.
    \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u0430\u044f \u043e\u0431\u043e\u0440\u043e\u043d\u0430
    \u0421\u0438\u0440\u0430\u043a\u0443\u0437 (214 - 212 \u0433\u0433. \u0434\u043e \u043d.
    \u044d.) \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0412\u0442\u043e\u0440\u043e\u0439
    \u041f\u0443\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    \u0440\u0438\u043c\u0441\u043a\u0438\u0439 \u0444\u043b\u043e\u0442 \u0438 \u0430\u0440\u043c\u0438\u044f
    \u043f\u043e\u0434 \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u043a\u043e\u043d\u0441\u0443\u043b\u0430 \u041c\u0430\u0440\u0446\u0435\u043b\u043b\u0430
    \u043e\u0441\u0430\u0434\u0438\u043b\u0438 \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u044b.
    75-\u043b\u0435\u0442\u043d\u0438\u0439 \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043b
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u0443\u044e \u043e\u0431\u043e\u0440\u043e\u043d\u0443
    \u0433\u043e\u0440\u043e\u0434\u0430. \u0412\u043e\u0435\u043d\u043d\u044b\u0435 \u043c\u0430\u0448\u0438\u043d\u044b.
    \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043c\u043e\u0449\u043d\u044b\u0435 \u043a\u0430\u0442\u0430\u043f\u0443\u043b\u044c\u0442\u044b
    \u0438 \u0431\u0430\u043b\u043b\u0438\u0441\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043c\u0435\u0442\u0430\u043b\u0438 \u0442\u044f\u0436\u0451\u043b\u044b\u0435 \u043a\u0430\u043c\u043d\u0438
    \u0438 \u043a\u043e\u043f\u044c\u044f \u0432 \u0440\u0438\u043c\u0441\u043a\u0438\u0435
    \u043a\u043e\u0440\u0430\u0431\u043b\u0438 \u0438 \u0441\u043e\u043b\u0434\u0430\u0442.
    \u00ab\u041a\u043e\u0433\u043e\u0442\u044c \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430\u00bb.
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f\u043c,
    \u043e\u043d \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u043e\u0434\u044a\u0451\u043c\u043d\u044b\u0435 \u043a\u0440\u0430\u043d\u044b \u0441
    \u0436\u0435\u043b\u0435\u0437\u043d\u044b\u043c\u0438 \u043a\u0440\u044e\u043a\u0430\u043c\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u043b\u0438
    \u043d\u043e\u0441\u044b \u0440\u0438\u043c\u0441\u043a\u0438\u0445 \u0433\u0430\u043b\u0435\u0440,
    \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u043b\u0438 \u0438\u0445 \u0432 \u0432\u043e\u0437\u0434\u0443\u0445
    \u0438 \u0448\u0432\u044b\u0440\u044f\u043b\u0438 \u0432\u043d\u0438\u0437, \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u044f
    \u043e \u0441\u043a\u0430\u043b\u044b \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u044f.
    \u042d\u0442\u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0430\u043f\u0443\u0433\u0430\u043b\u0438 \u0440\u0438\u043c\u043b\u044f\u043d, \u0447\u0442\u043e
    \u043e\u043d\u0438 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u043e\u0442
    \u0448\u0442\u0443\u0440\u043c\u0430 \u0438 \u043f\u0435\u0440\u0435\u0448\u043b\u0438 \u043a
    \u0434\u043e\u043b\u0433\u043e\u0439 \u043e\u0441\u0430\u0434\u0435. \u0413\u0438\u0431\u0435\u043b\u044c
    (212 \u0433. \u0434\u043e \u043d. \u044d.) \u041e\u0441\u0435\u043d\u044c\u044e 212 \u0433\u043e\u0434\u0430
    \u0434\u043e \u043d. \u044d. \u0440\u0438\u043c\u043b\u044f\u043d\u0430\u043c \u0443\u0434\u0430\u043b\u043e\u0441\u044c
    \u0432\u0437\u044f\u0442\u044c \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u044b \u0438\u0437-\u0437\u0430
    \u043f\u0440\u0435\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438 \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a\u0430. \u0412\u043e
    \u0432\u0440\u0435\u043c\u044f \u0448\u0442\u0443\u0440\u043c\u0430 \u0433\u043e\u0440\u043e\u0434\u0430
    \u0440\u0438\u043c\u0441\u043a\u0438\u0439 \u0441\u043e\u043b\u0434\u0430\u0442 \u0443\u0431\u0438\u043b
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u0440\u0441\u0438\u0439
    \u0435\u0433\u043e \u0433\u0438\u0431\u0435\u043b\u0438, \u043d\u043e \u0432\u0441\u0435
    \u043e\u043d\u0438 \u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u0442\u043e\u043c,
    \u0447\u0442\u043e \u0443\u0447\u0451\u043d\u044b\u0439 \u0431\u044b\u043b \u0443\u0431\u0438\u0442
    \u0432 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430
    \u0431\u044b\u043b \u043f\u043e\u0433\u0440\u0443\u0436\u0451\u043d \u0432 \u0441\u0432\u043e\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f.
    \u041f\u043e \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439
    \u0432\u0435\u0440\u0441\u0438\u0438, \u043e\u043d \u0447\u0435\u0440\u0442\u0438\u043b
    \u043d\u0430 \u043f\u0435\u0441\u043a\u0435 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u0438\u0433\u0443\u0440\u044b \u0438, \u043a\u043e\u0433\u0434\u0430 \u043a \u043d\u0435\u043c\u0443
    \u043f\u043e\u0434\u043e\u0448\u0451\u043b \u0440\u0438\u043c\u0441\u043a\u0438\u0439 \u0432\u043e\u0438\u043d,
    \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b: \u00ab\u041d\u0435 \u0442\u0440\u043e\u0433\u0430\u0439
    \u043c\u043e\u0438\u0445 \u0447\u0435\u0440\u0442\u0435\u0436\u0435\u0439!\u00bb, \u043f\u043e\u0441\u043b\u0435
    \u0447\u0435\u0433\u043e \u0431\u044b\u043b \u0437\u0430\u0440\u0443\u0431\u043b\u0435\u043d.
    \u041f\u0430\u043c\u044f\u0442\u044c \u0421\u043f\u0443\u0441\u0442\u044f \u043f\u043e\u0447\u0442\u0438
    150 \u043b\u0435\u0442, \u0432 75 \u0433\u043e\u0434\u0443 \u0434\u043e \u043d. \u044d.,
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0440\u0438\u043c\u0441\u043a\u0438\u0439
    \u043e\u0440\u0430\u0442\u043e\u0440 \u0426\u0438\u0446\u0435\u0440\u043e\u043d, \u0431\u0443\u0434\u0443\u0447\u0438
    \u043d\u0430 \u0421\u0438\u0446\u0438\u043b\u0438\u0438, \u0440\u0430\u0437\u044b\u0441\u043a\u0430\u043b
    \u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043d\u0443\u044e
    \u043c\u043e\u0433\u0438\u043b\u0443 \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430. \u041d\u0430
    \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0438 \u043e\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u0432\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0433\u043e \u0432 \u0446\u0438\u043b\u0438\u043d\u0434\u0440
    \u0448\u0430\u0440\u0430, \u043a\u0430\u043a \u0438 \u0437\u0430\u0432\u0435\u0449\u0430\u043b
    \u0443\u0447\u0451\u043d\u044b\u0439."
  shortBioEn: "Basic information about the life of Archimedes has come to us from the works of later historians such as Plutarch, Titus Livius and Cicero, so many dates and events are approximate. Beginning of the journey in Syracuse (c. 287 BCE) Archimedes was born around 287 BC in the city of Syracuse, which was located on the island of Sicily. At that time it was a large and influential Greek polis. His father was presumably Phidias, an astronomer and mathematician who was closely related to the ruler of Syracuse, the tyrant Hieron II. This relationship subsequently provided Archimedes with patronage and opportunities for scientific pursuits. Years of study in Alexandria (c. 287 - c. 265 BCE) To obtain an education, Archimedes went to Alexandria in Egypt, which was the largest scientific and cultural center of the ancient world. There, in the famous Alexandria Museion and its library, which collected hundreds of thousands of manuscripts, he was able to become acquainted with the works of outstanding Greek geometers such as Democritus and Eudoxus. In Alexandria, Archimedes also became friends and carried on scientific correspondence with famous scientists - the astronomer Conon and the mathematician Eratosthenes. Mature years and the flourishing of scientific activity (c. 265 - 215 BCE) Upon completion of his studies, Archimedes returned to his native Syracuse, where he spent most of his life. He did not strive for a court career and, being a wealthy man, could devote himself entirely to science. It was during this period that he made his greatest discoveries. Among them: The Law of Hydrostatics (“Archimedes’ Law”). According to legend, King Hiero instructed him to check whether the jeweler who made the golden crown had cheated by mixing silver into it. Reflecting on the problem, Archimedes found a solution when he immersed himself in a bath: the volume of displaced water is equal to the volume of the immersed body. With a cry of “Eureka!” he jumped out of the bath and ran to report his discovery. Leverage theory and simple mechanisms. Archimedes not only described the law of leverage, but also created complex block mechanisms (pulley hoists). He is credited with the famous phrase: “Give me a point of support, and I will change the world.” With the help of these mechanisms, he was able to single-handedly launch the heavily loaded ship Syracuse, which hundreds of people could not move. He is also credited with the invention of the water-lifting screw (“Archimedes screw”), which is still used in some countries. Mathematics. In his works (“On the measurement of a circle”, “On a ball and a cylinder”), he calculated the number π with high accuracy and proved that the volume of a ball is related to the volume of the cylinder described around it as 2:3.He valued this discovery so much that he bequeathed to carve this particular figure on his grave. Engineer Defense of Syracuse (214 - 212 BCE) During the Second Punic War, the Roman fleet and army under the command of the consul Marcellus laid siege to Syracuse. 75-year-old Archimedes organized the engineering defense of the city. Military vehicles. He created powerful catapults and ballistas that threw heavy stones and spears at Roman ships and soldiers. \"Archimedes' Claw\" According to descriptions, he designed cranes with iron hooks that grabbed the bows of Roman galleys, lifted them into the air and hurled them down, smashing them against rocks or capsizing them. These inventions frightened the Romans so much that they abandoned the assault and switched to a long siege. Death (212 BCE) In the fall of 212 BCE, the Romans managed to take Syracuse due to treachery and during a festival. During the assault on the city, a Roman soldier killed Archimedes. There are several versions of his death, but they all agree that the scientist was killed at the moment when he was immersed in his mathematical thoughts. According to the most famous version, he drew geometric figures in the sand and, when a Roman soldier approached him, exclaimed: “Don’t touch my drawings!”, after which he was hacked to death. Memory Almost 150 years later, in 75 BCE, the famous Roman orator Cicero, while in Sicily, found and restored the neglected tomb of Archimedes. On the tombstone he actually found an image of a ball inscribed in a cylinder, as the scientist had bequeathed."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430
    \u043e\u043a\u0443\u0442\u0430\u043d\u044b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e\u043c
    \u043b\u0435\u0433\u0435\u043d\u0434, \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u043e\u0432
    \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u0438\u0437 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f \u0432 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0435.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0438\u0441\u0443\u044e\u0442 \u0435\u0433\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u043a \u0441\u0443\u0445\u043e\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u043d\u043e \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0441 \u044f\u0440\u043a\u0438\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c
    \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439.
    1. \u00ab\u042d\u0432\u0440\u0438\u043a\u0430!\u00bb \u0438 \u0432\u0430\u043d\u043d\u0430
    (\u043b\u0435\u0433\u0435\u043d\u0434\u0430 \u043e \u043a\u043e\u0440\u043e\u043d\u0435)
    \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438.
    \u0426\u0430\u0440\u044c \u0413\u0438\u0435\u0440\u043e\u043d \u0437\u0430\u043f\u043e\u0434\u043e\u0437\u0440\u0438\u043b
    \u044e\u0432\u0435\u043b\u0438\u0440\u0430 \u0432 \u043a\u0440\u0430\u0436\u0435 \u0437\u043e\u043b\u043e\u0442\u0430
    \u043f\u0440\u0438 \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u0438
    \u0440\u0438\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u043e\u0440\u043e\u043d\u044b
    \u0438 \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430
    \u0440\u0430\u0437\u043e\u0431\u043b\u0430\u0447\u0438\u0442\u044c \u043e\u0431\u043c\u0430\u043d,
    \u043d\u0435 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044f \u0438\u0437\u0434\u0435\u043b\u0438\u044f.
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u043c\u0443\u0447\u0438\u043b\u0441\u044f \u043d\u0430\u0434
    \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f,
    \u043f\u043e\u043a\u0430 \u043e\u0434\u043d\u0430\u0436\u0434\u044b, \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u044f\u0441\u044c
    \u0432 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u0443\u044e \u0434\u043e \u043a\u0440\u0430\u0435\u0432
    \u0432\u0430\u043d\u043d\u0443, \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u0447\u0430\u0441\u0442\u044c \u0432\u043e\u0434\u044b \u0432\u044b\u043f\u043b\u0435\u0441\u043d\u0443\u043b\u0430\u0441\u044c
    \u043d\u0430\u0440\u0443\u0436\u0443. \u0412 \u044d\u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442
    \u0435\u0433\u043e \u043e\u0441\u0435\u043d\u0438\u043b\u043e: \u043e\u0431\u044a\u0435\u043c
    \u0432\u044b\u0442\u0435\u0441\u043d\u0435\u043d\u043d\u043e\u0439 \u0432\u043e\u0434\u044b
    \u0440\u0430\u0432\u0435\u043d \u043e\u0431\u044a\u0435\u043c\u0443 \u0435\u0433\u043e \u0442\u0435\u043b\u0430.
    \u0417\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c
    \u043a\u043e\u0440\u043e\u043d\u0443, \u043d\u0443\u0436\u043d\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c
    \u043e\u0431\u044a\u0435\u043c\u044b \u0432\u044b\u0442\u0435\u0441\u043d\u0435\u043d\u043d\u043e\u0439
    \u0432\u043e\u0434\u044b \u0434\u043b\u044f \u043a\u043e\u0440\u043e\u043d\u044b \u0438
    \u0434\u043b\u044f \u0441\u043b\u0438\u0442\u043a\u0430 \u0437\u043e\u043b\u043e\u0442\u0430
    \u0442\u043e\u0433\u043e \u0436\u0435 \u0432\u0435\u0441\u0430. \u041b\u0435\u0433\u0435\u043d\u0434\u0430
    \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0437\u0431\u0443\u0434\u043e\u0440\u0430\u0436\u0435\u043d,
    \u0447\u0442\u043e \u0432\u044b\u0441\u043a\u043e\u0447\u0438\u043b \u0438\u0437 \u0432\u0430\u043d\u043d\u044b
    \u0438 \u0433\u043e\u043b\u044b\u0448\u043e\u043c \u043f\u043e\u0431\u0435\u0436\u0430\u043b
    \u043f\u043e \u0443\u043b\u0438\u0446\u0430\u043c \u0421\u0438\u0440\u0430\u043a\u0443\u0437,
    \u043a\u0440\u0438\u0447\u0430 \u0432\u043e \u0432\u0435\u0441\u044c \u0433\u043e\u043b\u043e\u0441:
    \u00ab\u042d\u0432\u0440\u0438\u043a\u0430! \u042d\u0432\u0440\u0438\u043a\u0430!\u00bb
    (\u00ab\u041d\u0430\u0448\u0435\u043b! \u041d\u0430\u0448\u0435\u043b!\u00bb). \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b \u043f\u043e\u0434\u043c\u0435\u043d\u0443:
    \u044e\u0432\u0435\u043b\u0438\u0440 \u0431\u044b\u043b \u043a\u0430\u0437\u043d\u0435\u043d,
    \u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e
    \u0437\u0430\u043a\u043e\u043d \u0433\u0438\u0434\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438.
    2. \u00ab\u0414\u0430\u0439\u0442\u0435 \u043c\u043d\u0435 \u0442\u043e\u0447\u043a\u0443
    \u043e\u043f\u043e\u0440\u044b, \u0438 \u044f \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443
    \u043c\u0438\u0440\u00bb \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043e\u0442\u043a\u0440\u044b\u043b \u0437\u0430\u043a\u043e\u043d \u0440\u044b\u0447\u0430\u0433\u0430,
    \u043d\u043e \u0438 \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u043e \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438. \u0427\u0442\u043e\u0431\u044b
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435
    \u043d\u0430 \u0446\u0430\u0440\u044f \u0413\u0438\u0435\u0440\u043e\u043d\u0430, \u043e\u043d
    \u044f\u043a\u043e\u0431\u044b \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0440\u044b\u0447\u0430\u0433\u0430 \u0438
    \u0431\u043b\u043e\u043a\u043e\u0432 \u0441\u043c\u043e\u0436\u0435\u0442 \u0441\u0434\u0432\u0438\u043d\u0443\u0442\u044c
    \u0441 \u043c\u0435\u0441\u0442\u0430 \u043b\u044e\u0431\u043e\u0439 \u0433\u0440\u0443\u0437,
    \u043a\u0430\u043a\u0438\u043c \u0431\u044b \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u043e\u043d
    \u043d\u0438 \u0431\u044b\u043b. \u0426\u0430\u0440\u044c \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043b
    \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u044d\u0442\u043e \u043d\u0430 \u043a\u043e\u0440\u0430\u0431\u043b\u0435 \u00ab\u0421\u0438\u0440\u0430\u043a\u0443\u0437\u0438\u044f\u00bb
    \u2014 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0433\u0440\u0443\u0436\u0435\u043d\u043e\u0439
    \u0442\u0440\u0438\u0440\u0435\u043c\u0435, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0441\u043e\u0442\u043d\u0438
    \u043b\u044e\u0434\u0435\u0439 \u043d\u0435 \u043c\u043e\u0433\u043b\u0438 \u0441\u0434\u0432\u0438\u043d\u0443\u0442\u044c
    \u0441 \u043c\u0435\u0441\u0442\u0430. \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0431\u043b\u043e\u043a\u043e\u0432
    (\u043f\u043e\u043b\u0438\u0441\u043f\u0430\u0441\u0442\u043e\u0432) \u0438, \u0443\u0441\u0435\u0432\u0448\u0438\u0441\u044c
    \u043d\u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438,
    \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u043f\u043e\u0442\u044f\u043d\u0443\u043b
    \u0437\u0430 \u0432\u0435\u0440\u0435\u0432\u043a\u0443. \u041a\u043e\u0440\u0430\u0431\u043b\u044c
    \u043f\u043b\u0430\u0432\u043d\u043e \u043f\u043e\u043f\u043b\u044b\u043b \u043f\u043e \u0432\u043e\u0434\u0435,
    \u0441\u043b\u043e\u0432\u043d\u043e \u0435\u0433\u043e \u0442\u044f\u043d\u0443\u043b\u0430
    \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u0430\u044f \u0441\u0438\u043b\u0430. \u0421
    \u0442\u0435\u0445 \u043f\u043e\u0440 \u0444\u0440\u0430\u0437\u0430 \u00ab\u0414\u0430\u0439\u0442\u0435
    \u043c\u043d\u0435 \u0442\u043e\u0447\u043a\u0443 \u043e\u043f\u043e\u0440\u044b...\u00bb
    \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u0441\u0438\u043b\u044b
    \u0443\u043c\u0430, \u0442\u043e\u0440\u0436\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0433\u043e
    \u043d\u0430\u0434 \u0433\u0440\u0443\u0431\u043e\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043c\u043e\u0449\u044c\u044e. 3. \u041d\u0435\u0431\u0435\u0441\u043d\u0430\u044f \u0441\u0444\u0435\u0440\u0430
    \u2014 \u0434\u0440\u0435\u0432\u043d\u0438\u0439 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u0440\u0438\u0439 \u2014 \u00ab\u043d\u0435\u0431\u0435\u0441\u043d\u0443\u044e
    \u0441\u0444\u0435\u0440\u0443\u00bb. \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u043b\u043e\u0436\u043d\u043e\u0435
    \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439
    \u0448\u0435\u0441\u0442\u0435\u0440\u0435\u043d\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u0421\u043e\u043b\u043d\u0446\u0430, \u041b\u0443\u043d\u044b \u0438 \u043f\u044f\u0442\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0442\u043e\u0433\u0434\u0430 \u043f\u043b\u0430\u043d\u0435\u0442
    \u043f\u043e \u043d\u0435\u0431\u0443. \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043d\u043e \u044d\u0442\u043e\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u043c\u043e\u0433
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0444\u0430\u0437\u044b
    \u041b\u0443\u043d\u044b \u0438 \u0434\u0430\u0436\u0435 \u043b\u0443\u043d\u043d\u044b\u0435
    \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u044f. \u042d\u0442\u043e \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u043e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u0447\u0442\u043e
    \u0434\u0430\u0436\u0435 \u0441\u043f\u0443\u0441\u0442\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0441\u0442\u043e\u043b\u0435\u0442\u0438\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043e\u0440\u0430\u0442\u043e\u0440 \u0426\u0438\u0446\u0435\u0440\u043e\u043d \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u043d\u043e
    \u043f\u0438\u0441\u0430\u043b \u043e \u043d\u0435\u043c. \u041f\u043e \u0441\u0443\u0442\u0438,
    \u044d\u0442\u043e \u0431\u044b\u043b \u0434\u0440\u0435\u0432\u043d\u0435\u0439\u0448\u0438\u0439
    \u0432 \u043c\u0438\u0440\u0435 \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0439
    \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440, \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0438\u0439
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u0434\u0432\u0435
    \u0442\u044b\u0441\u044f\u0447\u0438 \u043b\u0435\u0442. 4. \u041e\u0431\u043e\u0440\u043e\u043d\u0430
    \u0421\u0438\u0440\u0430\u043a\u0443\u0437 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0438\u043c\u0430
    \u041a\u043e\u0433\u0434\u0430 \u0440\u0438\u043c\u0441\u043a\u0438\u0435 \u0432\u043e\u0439\u0441\u043a\u0430
    \u043e\u0441\u0430\u0434\u0438\u043b\u0438 \u0421\u0438\u0440\u0430\u043a\u0443\u0437\u044b,
    \u043f\u0440\u0435\u0441\u0442\u0430\u0440\u0435\u043b\u044b\u0439 \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b \u0440\u043e\u0434\u043d\u043e\u0439
    \u0433\u043e\u0440\u043e\u0434 \u0432 \u043d\u0435\u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043d\u0443\u044e
    \u043a\u0440\u0435\u043f\u043e\u0441\u0442\u044c. \u00ab\u041a\u043e\u0433\u043e\u0442\u044c
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430\u00bb: \u041e\u043d \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u043e\u0434\u044a\u0435\u043c\u043d\u044b\u0435 \u043a\u0440\u0430\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u043f\u0443\u0441\u043a\u0430\u043b\u0438\u0441\u044c \u043d\u0430 \u043a\u043e\u0440\u0430\u0431\u043b\u0438
    \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u0435\u043b\u044f, \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u043b\u0438
    \u0438\u0445 \u0436\u0435\u043b\u0435\u0437\u043d\u044b\u043c\u0438 \u043a\u0440\u044e\u043a\u0430\u043c\u0438
    \u0437\u0430 \u043d\u043e\u0441, \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u043b\u0438
    \u0432 \u0432\u043e\u0437\u0434\u0443\u0445, \u0430 \u0437\u0430\u0442\u0435\u043c \u0441\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043b\u0438
    \u0432\u043d\u0438\u0437, \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u044f \u043e \u0441\u043a\u0430\u043b\u044b.
    \u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u0438 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043a\u043e\u0440\u0430\u0431\u043b\u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u0438 \u0442\u043e\u043d\u0443\u043b\u0438, \u0430 \u044d\u043a\u0438\u043f\u0430\u0436\u0438
    \u0431\u044b\u043b\u0438 \u0432 \u0443\u0436\u0430\u0441\u0435. \u0413\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0438\u0435
    \u043a\u0430\u0442\u0430\u043f\u0443\u043b\u044c\u0442\u044b: \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043c\u0435\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043c\u0430\u0448\u0438\u043d\u044b
    \u0440\u0430\u0437\u043d\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438: \u043e\u0434\u043d\u0438
    \u0431\u0438\u043b\u0438 \u043d\u0430 \u0434\u0430\u043b\u044c\u043d\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f,
    \u043f\u043e\u0440\u0430\u0436\u0430\u044f \u043a\u043e\u0440\u0430\u0431\u043b\u0438 \u0434\u043e
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0442\u0435 \u043f\u043e\u0434\u043e\u0439\u0434\u0443\u0442
    \u043a \u0431\u0435\u0440\u0435\u0433\u0443, \u0434\u0440\u0443\u0433\u0438\u0435 \u2014
    \u0441 \u0431\u043b\u0438\u0437\u043a\u043e\u0439 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0438,
    \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u044f \u0431\u043e\u0440\u0442\u0430. \u0412
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0440\u0438\u043c\u0441\u043a\u0438\u0439
    \u043f\u043e\u043b\u043a\u043e\u0432\u043e\u0434\u0435\u0446 \u041c\u0430\u0440\u0446\u0435\u043b\u043b,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0441\u0432\u043e\u0435\u0439 \u0445\u0440\u0430\u0431\u0440\u043e\u0441\u0442\u044c\u044e,
    \u0432 \u0443\u0436\u0430\u0441\u0435 \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b,
    \u0447\u0442\u043e \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u0432\u0435\u0434\u0435\u0442
    \u0441 \u043d\u0438\u043c \u0432\u043e\u0439\u043d\u0443, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u043a\u043e\u0440\u0430\u0431\u043b\u0438 \u043a\u0430\u043a \u00ab\u0447\u0435\u0440\u043f\u0430\u043a\u0438
    \u0434\u043b\u044f \u0432\u043e\u0434\u044b\u00bb, \u0438 \u0441\u0440\u0430\u0432\u043d\u0438\u043b
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0441\u043e \u0441\u0442\u043e\u0433\u043b\u0430\u0432\u044b\u043c
    \u043c\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0433\u0438\u0433\u0430\u043d\u0442\u043e\u043c
    \u0411\u0440\u0438\u0430\u0440\u0435\u0435\u043c. \u0420\u0438\u043c\u043b\u044f\u043d\u0435
    \u043f\u0435\u0440\u0435\u0448\u043b\u0438 \u043e\u0442 \u0448\u0442\u0443\u0440\u043c\u0430
    \u043a \u0434\u043e\u043b\u0433\u043e\u0439 \u043e\u0441\u0430\u0434\u0435, \u0441\u043c\u0438\u0440\u0438\u0432\u0448\u0438\u0441\u044c
    \u0441 \u0442\u0435\u043c, \u0447\u0442\u043e \u043e\u0434\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u0440\u0438\u043a\u0430
    \u0431\u043e\u044f\u0442\u0441\u044f \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c
    \u0446\u0435\u043b\u043e\u0439 \u0430\u0440\u043c\u0438\u0438. 5. \u0422\u0430\u0439\u043d\u0430
    \u00ab\u043e\u0433\u043d\u0435\u043d\u043d\u044b\u0445 \u0437\u0435\u0440\u043a\u0430\u043b\u00bb
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u0440\u0435\u0434\u0430\u043d\u0438\u0435,
    \u0447\u0442\u043e \u0410\u0440\u0445\u0438\u043c\u0435\u0434 \u0441\u0436\u0438\u0433\u0430\u043b
    \u0440\u0438\u043c\u0441\u043a\u0438\u0435 \u043a\u043e\u0440\u0430\u0431\u043b\u0438, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u044f
    \u043d\u0430 \u043d\u0438\u0445 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0435 \u043b\u0443\u0447\u0438
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0445 \u0432\u043e\u0433\u043d\u0443\u0442\u044b\u0445
    \u0437\u0435\u0440\u043a\u0430\u043b. \u0412 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u043a\u0430\u043a \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u044d\u0442\u043e \u0432\u044b\u043c\u044b\u0441\u043b\u043e\u043c
    (\u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0441\u0442\u0435\u043a\u043b\u0430
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0431\u044b\u043b\u0430
    \u043d\u0435\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u0430), \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0441\u0442\u044b \u0438 \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u043e\u043d\u043d\u044b\u0435
    \u0448\u043e\u0443 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u0435\u0440\u0438\u044f
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u043e\u0432 \u043e\u0442
    \u041c\u0438\u043d\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u041e\u0431\u043e\u0440\u043e\u043d\u044b
    \u0421\u0428\u0410) \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e
    \u043f\u0440\u0438 \u0431\u043e\u043b\u044c\u0448\u043e\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u043c\u0435\u0434\u043d\u044b\u0445 \u043f\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0449\u0438\u0442\u043e\u0432 \u0438 \u044f\u0441\u043d\u043e\u0439 \u043f\u043e\u0433\u043e\u0434\u0435
    \u0434\u0435\u0440\u0435\u0432\u044f\u043d\u043d\u043e\u0435 \u0441\u0443\u0434\u043d\u043e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043c\u043e\u0436\u043d\u043e
    \u043f\u043e\u0434\u0436\u0435\u0447\u044c. \u0422\u0430\u043a \u0447\u0442\u043e \u0410\u0440\u0445\u0438\u043c\u0435\u0434
    \u043c\u043e\u0433 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u044d\u0442\u043e\u0442 \u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0440\u044e\u043a,
    \u043f\u0443\u0441\u0442\u044c \u0438 \u043d\u0435 \u0442\u0430\u043a \u044d\u0444\u0444\u0435\u043a\u0442\u043d\u043e,
    \u043a\u0430\u043a \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u043b\u0435\u0433\u0435\u043d\u0434\u044b.
    6. \u0424\u0438\u043d\u0430\u043b: \u00ab\u041d\u0435 \u0442\u0440\u043e\u0433\u0430\u0439
    \u043c\u043e\u0438\u0445 \u0447\u0435\u0440\u0442\u0435\u0436\u0435\u0439!\u00bb \u0413\u0438\u0431\u0435\u043b\u044c
    \u0410\u0440\u0445\u0438\u043c\u0435\u0434\u0430 \u0432 212 \u0433\u043e\u0434\u0443 \u0434\u043e
    \u043d.\u044d. \u0441\u0442\u0430\u043b\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c
    \u0433\u0438\u0431\u0435\u043b\u0438 \u043d\u0430\u0443\u043a\u0438 \u043e\u0442 \u0440\u0443\u043a
    \u0432\u0430\u0440\u0432\u0430\u0440\u0441\u0442\u0432\u0430. \u041a\u043e\u0433\u0434\u0430
    \u0440\u0438\u043c\u043b\u044f\u043d\u0435 \u0432\u043e\u0440\u0432\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043d\u043e\u0447\u043d\u043e\u0433\u043e
    \u0448\u0442\u0443\u0440\u043c\u0430, \u0441\u043e\u043b\u0434\u0430\u0442\u0430\u043c \u0431\u044b\u043b\u043e
    \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043d\u043e \u043d\u0430\u0439\u0442\u0438 \u0443\u0447\u0435\u043d\u043e\u0433\u043e
    \u0438 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u041c\u0430\u0440\u0446\u0435\u043b\u043b\u0443
    (\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0445\u043e\u0442\u0435\u043b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c
