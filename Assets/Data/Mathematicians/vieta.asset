    \u0438 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0434\u0435\u044f\u0442\u0435\u043b\u0435\u043c, \u0438 \u0442\u0430\u0439\u043d\u044b\u043c
    \u043a\u0440\u0438\u043f\u0442\u043e\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u043e\u043c,
    \u0438 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438.
    \u0415\u0433\u043e \u043f\u0443\u0442\u044c \u043f\u0440\u043e\u043b\u0435\u0433\u0430\u043b
