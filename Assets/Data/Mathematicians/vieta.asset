    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u043f\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u043e\u043d\u043e \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a
    \u0437\u0430\u0434\u0430\u0447\u0435 \u043e \u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0443\u0433\u043b\u0430
    \u043d\u0430 45 \u0447\u0430\u0441\u0442\u0435\u0439. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u043f\u0440\u0438\u0435\u0445\u0430\u043b
    \u043a \u0412\u0438\u0435\u0442\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438, \u0438 \u043c\u0435\u0436\u0434\u0443
    \u043d\u0438\u043c\u0438 \u0437\u0430\u0432\u044f\u0437\u0430\u043b\u0430\u0441\u044c \u0434\u0440\u0443\u0436\u0431\u0430.
    \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u0412\u0438\u0435\u0442 \u043e\u0442\u043e\u0448\u0435\u043b \u043e\u0442 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
