    \u043e\u043d \u043d\u0430\u0448\u0435\u043b \u0432\u0440\u0435\u043c\u044f, \u0447\u0442\u043e\u0431\u044b
    \u0437\u0430\u043b\u043e\u0436\u0438\u0442\u044c \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F4DC
