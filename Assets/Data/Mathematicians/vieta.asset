    ### \u2696\uFE0F \u0422\u043E\u043D\u043A\u0430\u044F \u0433\u0440\u0430\u043D\u044C
    \u0432\u0435\u0440\u044B: \u043A\u0430\u0442\u043E\u043B\u0438\u043A \u0441\u0440\u0435\u0434\u0438
    \u0433\u0443\u0433\u0435\u043D\u043E\u0442\u043E\u0432  \u0412 \u0440\u0430\u0437\u0433\u0430\u0440
    \u0436\u0435\u0441\u0442\u043E\u043A\u0438\u0445 \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u044B\u0445
