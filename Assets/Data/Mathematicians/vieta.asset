  achievementsRu: "\u0424\u0440\u0430\u043D\u0441\u0443\u0430 \u0412\u0438\u0435\u0442
    \u0437\u0430\u043B\u043E\u0436\u0438\u043B \u043E\u0441\u043D\u043E\u0432\u044B
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438,
    \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432 \u0430\u043B\u0433\u0435\u0431\u0440\u0443
    \u0438\u0437 \u043D\u0430\u0431\u043E\u0440\u0430 \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u0432
    \u0434\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0437\u0430\u0434\u0430\u0447
    \u0432 \u0441\u0442\u0440\u043E\u0433\u0443\u044E \u043D\u0430\u0443\u043A\u0443
    \u043E \u0441\u0438\u043C\u0432\u043E\u043B\u0430\u0445 \u0438 \u043E\u0431\u0449\u0438\u0445
    \u0437\u0430\u043A\u043E\u043D\u0430\u0445. \u0415\u0433\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E
    \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439.  ### \U0001F4D0
    1. \u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B (\u0433\u043B\u0430\u0432\u043D\u043E\u0435
    \u0434\u0435\u043B\u043E \u0436\u0438\u0437\u043D\u0438)  \u0413\u043B\u0430\u0432\u043D\u044B\u0439
    \u0432\u043A\u043B\u0430\u0434 \u0412\u0438\u0435\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u043E \u043F\u0440\u0430\u0432\u0443 \u0441\u0434\u0435\u043B\u0430\u043B
    \u0435\u0433\u043E \"\u043E\u0442\u0446\u043E\u043C \u0430\u043B\u0433\u0435\u0431\u0440\u044B\",
    \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u0432 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u043E
    \u043D\u043E\u0432\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u044F\u0437\u044B\u043A\u0430.  *   **\xAB\u0412\u0438\u0434\u043E\u0432\u043E\u0435\xBB
    \u0438\u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0435:** \u0421\u0432\u043E\u044E
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u043E\u043D \u043D\u0430\u0437\u0432\u0430\u043B
    **\xAB\u0432\u0438\u0434\u043E\u0432\u043E\u0439 \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u043E\u0439\xBB**
    (logistica speciosa), \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0432
    \u0435\u0451 \xAB\u0447\u0438\u0441\u043B\u043E\u0432\u043E\u0439 \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0435\xBB
    (\u0440\u0430\u0431\u043E\u0442\u0435 \u0441 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u043C\u0438
    \u0447\u0438\u0441\u043B\u0430\u043C\u0438). \u041F\u043E\u0434 \xAB\u0432\u0438\u0434\u0430\u043C\u0438\xBB
    \u043E\u043D \u043F\u043E\u043D\u0438\u043C\u0430\u043B \u043D\u0435 \u0447\u0438\u0441\u043B\u0430,
    \u0430 \u043E\u0431\u043E\u0431\u0449\u0451\u043D\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u2014 \u0434\u043B\u0438\u043D\u044B,
    \u043F\u043B\u043E\u0449\u0430\u0434\u0438, \u043E\u0431\u044A\u0435\u043C\u044B
    \u0438 \u0442.\u0434.. *   **\u041D\u043E\u0432\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
    \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439:** \u0412\u0438\u0435\u0442
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0442\u044C \u0431\u0443\u043A\u0432\u0430\u043C\u0438
    **\u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435,
    \u043D\u043E \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u044B**
    (\u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u044B).    
    *   \u0414\u043B\u044F **\u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445**
    \u043E\u043D \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
    **\u0433\u043B\u0430\u0441\u043D\u044B\u0435** \u0431\u0443\u043A\u0432\u044B
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, `A`, `E`).     *   \u0414\u043B\u044F
    **\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445** (\u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u043E\u0432)
    \u2014 **\u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u0435** (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    `B`, `C`, `D`). *   **\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0444\u043E\u0440\u043C\u0443\u043B\u0430:** \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u044D\u0442\u043E\u043C\u0443 \u0441\u0442\u0430\u043B\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u043C
    \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430
    \u0438 \u0437\u0430\u043A\u043E\u043D\u044B \u0432 \u043E\u0431\u0449\u0435\u043C
    \u0432\u0438\u0434\u0435, \u0442\u043E \u0435\u0441\u0442\u044C \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u044C
    **\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0444\u043E\u0440\u043C\u0443\u043B\u044B**, \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u0435
    \u043A \u0446\u0435\u043B\u043E\u043C\u0443 \u043A\u043B\u0430\u0441\u0441\u0443
    \u0437\u0430\u0434\u0430\u0447. \u0412\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u0435
    \u044D\u0442\u043E\u0439 \u0438\u0434\u0435\u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u043E
    \u043F\u043E\u0447\u0432\u0443 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442
    \u0414\u0435\u043A\u0430\u0440\u0442\u0430 \u0438 \u041D\u044C\u044E\u0442\u043E\u043D\u0430. 
    > **\u041F\u0440\u0438\u043C\u0435\u0440 \u0438\u0437 \u0435\u0433\u043E \u0442\u0440\u0443\u0434\u0430:**
    \u0412 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u043C \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0435
    **\xAB\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\xBB** (1591) \u0412\u0438\u0435\u0442
    \u0438\u0437\u043B\u043E\u0436\u0438\u043B \u0441\u0432\u043E\u044E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
    \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0441\u0438\u043B\u0443 \u043D\u043E\u0432\u043E\u0433\u043E
    \u043C\u0435\u0442\u043E\u0434\u0430. \u041E\u043D \u043F\u0438\u0441\u0430\u043B,
    \u0447\u0442\u043E \u0437\u0430\u0434\u0430\u0447\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0447\u0438\u0442\u0430\u043B\u0438\u0441\u044C
    \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u043C\u0438, \u0442\u0435\u043F\u0435\u0440\u044C
    \xAB\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043B\u0435\u0433\u043A\u043E
    \u0440\u0435\u0448\u0430\u044E\u0442\u0441\u044F \u0434\u0435\u0441\u044F\u0442\u043A\u0430\u043C\u0438
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043D\u0430\u0448\u0435\u0433\u043E
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430\xBB.  ### \U0001F4DD 2.
    \u0422\u0435\u043E\u0440\u0435\u043C\u0430 \u0412\u0438\u0435\u0442\u0430 \u0438
    \u043E\u0431\u0449\u0430\u044F \u0442\u0435\u043E\u0440\u0438\u044F \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439 
    \u0412 \u0442\u043E\u043C \u0436\u0435 1591 \u0433\u043E\u0434\u0443 \u0412\u0438\u0435\u0442
    \u043E\u0431\u043D\u0430\u0440\u043E\u0434\u043E\u0432\u0430\u043B \u0441\u0432\u043E\u044E
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0443\u044E \u0442\u0435\u043E\u0440\u0435\u043C\u0443,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C\u0443
    \u0448\u043A\u043E\u043B\u044C\u043D\u0438\u043A\u0443.  *   **\u0421\u0443\u0442\u044C
    \u0442\u0435\u043E\u0440\u0435\u043C\u044B:** \u041E\u043D\u0430 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0443\u044E
    \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u043A\u043E\u0440\u043D\u044F\u043C\u0438
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F \u0438 \u0435\u0433\u043E
    \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0430\u043C\u0438.
    \u0414\u043B\u044F \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0433\u043E
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F `Ax\xB2 - Bx + D = 0`
    \u043E\u043D \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u044D\u0442\u043E \u0442\u0430\u043A: *\xAB\u0415\u0441\u043B\u0438 B+D, \u0443\u043C\u043D\u043E\u0436\u0435\u043D\u043D\u043E\u0435
    \u043D\u0430 \u0410, \u043C\u0438\u043D\u0443\u0441 \u0410 \u0432 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0435
    \u0440\u0430\u0432\u043D\u043E BD, \u0442\u043E \u0410 \u0440\u0430\u0432\u043D\u043E
    \u0412 \u0438 \u0440\u0430\u0432\u043D\u043E D\xBB*. \u042D\u0442\u0430 \u0442\u0435\u043E\u0440\u0435\u043C\u0430
    \u0432\u0435\u0440\u043D\u0430 \u0434\u043B\u044F \u043C\u043D\u043E\u0433\u043E\u0447\u043B\u0435\u043D\u043E\u0432
    \u043B\u044E\u0431\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438. *  
    **\u041E\u0431\u0449\u0438\u0439 \u043C\u0435\u0442\u043E\u0434 \u0440\u0435\u0448\u0435\u043D\u0438\u044F:**
    \u0412\u0438\u0435\u0442\u0443 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0435\u0434\u0438\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0433\u043E
    \u043F\u043E\u0434\u0445\u043E\u0434\u0430 \u043A \u0440\u0435\u0448\u0435\u043D\u0438\u044E
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439 2-\u0439, 3-\u0439 \u0438
    4-\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0435\u0439. \u041E\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u043C\u0435\u0442\u043E\u0434\u044B \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0437\u0430\u043C\u0435\u043D\u0443 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445. 
    ### \U0001F53A 3. \u0420\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u044F \u0432
    \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0438 
    \u0412\u0438\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u043B \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u044E,
    \u0442\u0435\u0441\u043D\u043E \u0441\u0432\u044F\u0437\u0430\u0432 \u0435\u0451
    \u0441 \u0430\u043B\u0433\u0435\u0431\u0440\u043E\u0439.  *   **\u0420\u0435\u0448\u0435\u043D\u0438\u0435
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u0432:**
    \u041E\u043D \u0434\u0430\u043B \u043F\u043E\u043B\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043E\u0431 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0438
    \u0432\u0441\u0435\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432
    \u043F\u043B\u043E\u0441\u043A\u043E\u0433\u043E \u0438\u043B\u0438 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430 \u043F\u043E
    \u0442\u0440\u0435\u043C \u0434\u0430\u043D\u043D\u044B\u043C. **\u041E\u043D
    \u043F\u0435\u0440\u0432\u044B\u043C \u044F\u0432\u043D\u043E \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u043A\u043E\u0441\u0438\u043D\u0443\u0441\u043E\u0432
    \u0432 \u0441\u043B\u043E\u0432\u0435\u0441\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435**.
    *   **\u0424\u043E\u0440\u043C\u0443\u043B\u044B \u043A\u0440\u0430\u0442\u043D\u044B\u0445
    \u0443\u0433\u043B\u043E\u0432:** \u0412\u0438\u0435\u0442 \u043F\u0435\u0440\u0432\u044B\u043C
    \u0432\u044B\u0432\u0435\u043B \u043E\u0431\u0449\u0438\u0435 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u0434\u043B\u044F \u0441\u0438\u043D\u0443\u0441\u043E\u0432 \u0438 \u043A\u043E\u0441\u0438\u043D\u0443\u0441\u043E\u0432
    \u043A\u0440\u0430\u0442\u043D\u044B\u0445 \u0443\u0433\u043B\u043E\u0432 (`sin
    n\u0445` \u0438 `cos n\u0445`) \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0435\u043F\u0435\u043D\u0438
    `sin \u0445` \u0438 `cos \u0445`. \u042D\u0442\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435
    \u0441\u0442\u0430\u043B\u043E \u043A\u043B\u044E\u0447\u043E\u043C \u043A \u0435\u0433\u043E
    \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0435\u043C\u0443 \u0443\u0441\u043F\u0435\u0445\u0443. 
    ### \U0001F3C6 4. \u0422\u0440\u0438\u0443\u043C\u0444: \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F \u0432\u0430\u043D \u0420\u043E\u0443\u043C\u0435\u043D\u0430 
    \u0412\u0441\u0435\u043C\u0438\u0440\u043D\u0443\u044E \u0441\u043B\u0430\u0432\u0443
    \u0412\u0438\u0435\u0442\u0443 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
    \u043F\u043E\u0431\u0435\u0434\u0430 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u043F\u043E\u0435\u0434\u0438\u043D\u043A\u0435 1594 \u0433\u043E\u0434\u0430. 
    *   **\u0412\u044B\u0437\u043E\u0432:** \u0413\u043E\u043B\u043B\u0430\u043D\u0434\u0441\u043A\u0438\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A \u0410\u0434\u0440\u0438\u0430\u043D
    \u0432\u0430\u043D \u0420\u043E\u0443\u043C\u0435\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u0440\u0435\u0448\u0438\u0442\u044C \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435
    45-\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438, \u0440\u0430\u0437\u043E\u0441\u043B\u0430\u0432
    \u0432\u044B\u0437\u043E\u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430\u043C
    \u0415\u0432\u0440\u043E\u043F\u044B, \u043D\u043E \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0432
    \u0424\u0440\u0430\u043D\u0446\u0438\u044E, \u0442\u0430\u043A \u043A\u0430\u043A
    \u0441\u0447\u0438\u0442\u0430\u043B \u0442\u0430\u043C\u043E\u0448\u043D\u0438\u0445
    \u0443\u0447\u0451\u043D\u044B\u0445 \u043D\u0435\u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u043C\u0438.
    *   **\u041E\u0442\u0432\u0435\u0442:** \u0412\u0438\u0435\u0442, \u0443\u0437\u043D\u0430\u0432
    \u043E\u0431 \u044D\u0442\u043E\u043C, \u0432 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438
    \u043A\u043E\u0440\u043E\u043B\u044F \u0413\u0435\u043D\u0440\u0438\u0445\u0430
    IV \u043D\u0430\u0448\u0451\u043B \u043D\u0435 \u043E\u0434\u0438\u043D, \u0430
    **\u0432\u0441\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043A\u043E\u0440\u043D\u0438** \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F.
    *   **\u041C\u0435\u0442\u043E\u0434:** \u041E\u043D \u043F\u043E\u043D\u044F\u043B,
    \u0447\u0442\u043E \u044D\u0442\u043E \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435
    \u0441\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u043A \u0437\u0430\u0434\u0430\u0447\u0435
    \u043E \u0434\u0435\u043B\u0435\u043D\u0438\u0438 \u0443\u0433\u043B\u0430 \u043D\u0430
    45 \u0447\u0430\u0441\u0442\u0435\u0439, \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043B
    \u0441\u0432\u043E\u0439 \u043C\u043E\u0449\u043D\u044B\u0439 \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u0435\u0442\u043E\u0434. \u041E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B,
    \u043A\u0430\u043A \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043D\u0435\u043F\u0440\u0438\u0432\u043E\u0434\u0438\u043C\u044B\u0445
    \u043A\u0443\u0431\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439
    \u043C\u043E\u0436\u043D\u043E \u0441\u0432\u0435\u0441\u0442\u0438 \u043A \u0442\u0440\u0438\u0441\u0435\u043A\u0446\u0438\u0438
    \u0443\u0433\u043B\u0430, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
    \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0444\u043E\u0440\u043C\u0443\u043B\u044B.  ### \U0001F4A1 5. \u0414\u0440\u0443\u0433\u0438\u0435
    \u0432\u0430\u0436\u043D\u044B\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F 
    \u041F\u043E\u043C\u0438\u043C\u043E \u044D\u0442\u043E\u0433\u043E, \u0412\u0438\u0435\u0442
    \u0441\u0434\u0435\u043B\u0430\u043B \u0440\u044F\u0434 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0439: 
    *   **\u0411\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0438 \u0447\u0438\u0441\u043B\u043E \u03C0:** \u041E\u043D \u0432\u043F\u0435\u0440\u0432\u044B\u0435
    \u043F\u0440\u0438\u0432\u0451\u043B \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0435
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u043A\u0430\u043A
    \u0444\u043E\u0440\u043C\u0443\u043B\u0443 \u0434\u043B\u044F \u0447\u0438\u0441\u043B\u0430
    \u03C0. \u042D\u0442\u043E \u0431\u044B\u043B \u043E\u0434\u0438\u043D \u0438\u0437
    \u043F\u0435\u0440\u0432\u044B\u0445 \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u0432
    \u0442\u0430\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435.
    *   **\u0410\u043D\u0430\u043B\u0438\u0437 \u0434\u0440\u0435\u0432\u043D\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447:** \u041E\u043D \u0434\u0430\u043B \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0438\u044F
    \u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0438 \u043A\u0440\u0443\u0433\u0430,
    \u043A\u0430\u0441\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F \u0442\u0440\u0451\u0445
    \u0434\u0430\u043D\u043D\u044B\u0445 \u043A\u0440\u0443\u0433\u043E\u0432 (\u0432
    \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0435 \xAB\u0413\u0430\u043B\u043B\u044C\u0441\u043A\u0438\u0439
    \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0438\u0439\xBB, 1600). *   **\u041F\u0440\u0438\u0431\u043B\u0438\u0436\u0451\u043D\u043D\u044B\u0435
    \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F:** \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043C\u0435\u0442\u043E\u0434
    \u0434\u043B\u044F \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0451\u043D\u043D\u043E\u0433\u043E
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439 \u0441 \u0447\u0438\u0441\u043B\u043E\u0432\u044B\u043C\u0438
    \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0430\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u0435\u0434\u0432\u043E\u0441\u0445\u0438\u0442\u0438\u043B
    \u0431\u043E\u043B\u0435\u0435 \u043F\u043E\u0437\u0434\u043D\u0438\u0439 \u043C\u0435\u0442\u043E\u0434
    \u041D\u044C\u044E\u0442\u043E\u043D\u0430. \u0422\u0430\u043A\u0436\u0435 \u043E\u043D
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
    \u0434\u0435\u0441\u044F\u0442\u0438\u0447\u043D\u044B\u0435 \u0434\u0440\u043E\u0431\u0438
    \u0432 \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0442\u0430\u0431\u043B\u0438\u0446\u0430\u0445.  ### \U0001F4DA \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
    \u0442\u0440\u0443\u0434\u044B  \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u0440\u0430\u0431\u043E\u0442 \u0412\u0438\u0435\u0442\u0430 \u0431\u044B\u043B\u0430
    \u0438\u0437\u0434\u0430\u043D\u0430 \u043B\u0438\u0448\u044C \u043F\u043E\u0441\u043B\u0435
    \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u0438. \u0421\u0440\u0435\u0434\u0438
    \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C: 
    *   **\xAB\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\xBB** (1591) \u2014 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u044B\u0439
    \u043C\u0430\u043D\u0438\u0444\u0435\u0441\u0442 \u0435\u0433\u043E \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B. *   **\xAB\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u0430\u043D\u043E\u043D\xBB** (1579) \u2014 \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u0442\u0440\u0443\u0434 \u043F\u043E \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0438,
    \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439 \u0442\u0430\u0431\u043B\u0438\u0446\u044B.
    *   **\xAB\u0413\u0430\u043B\u043B\u044C\u0441\u043A\u0438\u0439 \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0438\u0439\xBB**
    (1600) \u2014 \u0440\u0430\u0431\u043E\u0442\u0430 \u043F\u043E \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438,
    \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0435
    \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0438\u044F. *   **\xAB\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u043E\u0447\u0438\u043D\u0435\u043D\u0438\u044F \u0412\u0438\u0435\u0442\u0430\xBB**
    (1646) \u2014 \u043F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u043E\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0435
    \u0442\u0440\u0443\u0434\u043E\u0432, \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0435
    \u0432 \u041B\u0435\u0439\u0434\u0435\u043D\u0435 \u0435\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u0424\u0440\u0430\u043D\u0441\u043E\u043C \u0432\u0430\u043D \u0421\u0445\u043E\u0442\u0435\u043D\u043E\u043C. 
    ### \U0001F48E \u0418\u0442\u043E\u0433  \u0424\u0440\u0430\u043D\u0441\u0443\u0430
    \u0412\u0438\u0435\u0442 \u0441\u0442\u0430\u043B \u0442\u0435\u043C \u0442\u0438\u0442\u0430\u043D\u043E\u043C,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0435\u0440\u0435\u0432\u0435\u043B
    \u0430\u043B\u0433\u0435\u0431\u0440\u0443 \u0441 \u044F\u0437\u044B\u043A\u0430
    \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0445 \u0447\u0438\u0441\u0435\u043B
    \u043D\u0430 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
    \u044F\u0437\u044B\u043A \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432. \u0415\u0433\u043E
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u2014 \u043E\u0442
    \u0432\u0441\u0435\u043C \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439
    \u0442\u0435\u043E\u0440\u0435\u043C\u044B \u0434\u043E \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u0435\u0442\u043E\u0434\u043E\u0432 \u2014 \u0441\u0442\u0430\u043B\u0438
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u043E\u043C, \u043D\u0430
    \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0432\u044B\u0440\u043E\u0441\u043B\u0430
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430 \u041D\u043E\u0432\u043E\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0438 \u0435\u0433\u043E \u043F\u043E
    \u043F\u0440\u0430\u0432\u0443 \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0443\u0447\u0451\u043D\u044B\u0445
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438."
  achievementsEn: 
  personalLifeRu: "\u0424\u0440\u0430\u043D\u0441\u0443\u0430 \u0412\u0438\u0435\u0442
    \u043F\u0440\u043E\u0436\u0438\u043B \u0434\u043E\u043B\u0433\u0443\u044E \u0438
    \u0431\u0443\u0440\u043D\u0443\u044E \u0436\u0438\u0437\u043D\u044C, \u043F\u043E\u043B\u043D\u0443\u044E
    \u043A\u0440\u0443\u0442\u044B\u0445 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u0432.
    \u041E\u043D \u0443\u0441\u043F\u0435\u043B \u043F\u043E\u0431\u044B\u0432\u0430\u0442\u044C
    \u0438 \u0430\u0434\u0432\u043E\u043A\u0430\u0442\u043E\u043C, \u0438 \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C,
    \u0438 \u0432\u043B\u0438\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0434\u0435\u044F\u0442\u0435\u043B\u0435\u043C, \u0438 \u0442\u0430\u0439\u043D\u044B\u043C
    \u043A\u0440\u0438\u043F\u0442\u043E\u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A\u043E\u043C,
    \u0438 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438.
    \u0415\u0433\u043E \u043F\u0443\u0442\u044C \u043F\u0440\u043E\u043B\u0435\u0433\u0430\u043B
    \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u044B\u0435
    \u0432\u043E\u0439\u043D\u044B \u0438 \u043F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u044B\u0435
    \u0438\u043D\u0442\u0440\u0438\u0433\u0438, \u043D\u043E \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u043E\u043D \u043D\u0430\u0448\u0435\u043B \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B
    \u0437\u0430\u043B\u043E\u0436\u0438\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u044B
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0430\u043B\u0433\u0435\u0431\u0440\u044B.
    \u0412\u043E\u0442 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0430\u044F \u0445\u0440\u043E\u043D\u043E\u043B\u043E\u0433\u0438\u044F
    \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438.  ### \U0001F4DC \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0438 \u0440\u0430\u043D\u043D\u0438\u0435 \u0433\u043E\u0434\u044B (1540\u20131560) 
    \u0424\u0440\u0430\u043D\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    \u0432 **1540 \u0433\u043E\u0434\u0443** \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C
    \u0433\u043E\u0440\u043E\u0434\u043A\u0435 **\u0424\u043E\u043D\u0442\u0435\u043D\u0435-\u043B\u0435-\u041A\u043E\u043D\u0442**
    \u0432 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438 \u041F\u0443\u0430\u0442\u0443,
    \u043D\u0430 \u044E\u0433\u0435 \u0424\u0440\u0430\u043D\u0446\u0438\u0438. \u0415\u0433\u043E
    \u043E\u0442\u0435\u0446, \u042D\u0442\u044C\u0435\u043D \u0412\u0438\u0435\u0442,
    \u0431\u044B\u043B \u043F\u0440\u043E\u043A\u0443\u0440\u043E\u0440\u043E\u043C,
    \u0438 \u043F\u043E \u0441\u0435\u043C\u0435\u0439\u043D\u043E\u0439 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438
    \u0424\u0440\u0430\u043D\u0441\u0443\u0430 \u0434\u043E\u043B\u0436\u0435\u043D
    \u0431\u044B\u043B \u043F\u043E\u0439\u0442\u0438 \u043F\u043E \u0435\u0433\u043E
    \u0441\u0442\u043E\u043F\u0430\u043C. \u0415\u0433\u043E \u043C\u0430\u0442\u044C,
    \u041C\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0430 \u0414\u044E\u043F\u043E\u043D,
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430 \u0438\u0437
    \u0437\u043D\u0430\u0442\u043D\u043E\u0439 \u0441\u0435\u043C\u044C\u0438, \u0447\u0442\u043E
    \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u043E\u0431\u043B\u0435\u0433\u0447\u0438\u043B\u043E
    \u0435\u0433\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u0443.  \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0412\u0438\u0435\u0442
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432 \u0448\u043A\u043E\u043B\u0435
    \u043F\u0440\u0438 \u043C\u0435\u0441\u0442\u043D\u043E\u043C **\u0444\u0440\u0430\u043D\u0446\u0438\u0441\u043A\u0430\u043D\u0441\u043A\u043E\u043C
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435**. \u0417\u0430\u0442\u0435\u043C
    \u043E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u044B\u0439
    **\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041F\u0443\u0430\u0442\u044C\u0435**,
    \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043B \u043F\u0440\u0430\u0432\u043E.
    \u0412 **1560 \u0433\u043E\u0434\u0443** \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u0431\u0430\u043A\u0430\u043B\u0430\u0432\u0440\u0430
    \u043F\u0440\u0430\u0432\u0430, \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E
    \u0435\u043C\u0443 \u043D\u0430\u0447\u0430\u0442\u044C \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0443.  ### \u2696\uFE0F \u042E\u0440\u0438\u0441\u0442,
    \u0443\u0447\u0438\u0442\u0435\u043B\u044C \u0438 \u043D\u0430\u0447\u0430\u043B\u043E
    \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0439
    (1560\u20131571)  \u0412 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 19
    \u043B\u0435\u0442 \u0412\u0438\u0435\u0442 \u043D\u0430\u0447\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0430\u0434\u0432\u043E\u043A\u0430\u0442\u043E\u043C \u0432 \u0440\u043E\u0434\u043D\u043E\u043C
    \u0433\u043E\u0440\u043E\u0434\u0435. \u041E\u0434\u043D\u0430\u043A\u043E \u0447\u0435\u0440\u0435\u0437
    \u0442\u0440\u0438 \u0433\u043E\u0434\u0430, \u0432 **1563 \u0433\u043E\u0434\u0443**,
    \u043E\u043D \u0441\u0434\u0435\u043B\u0430\u043B \u0448\u0430\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043A\u0430\u0440\u0434\u0438\u043D\u0430\u043B\u044C\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B
    \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u044C. \u041E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u043D\u0430 \u0441\u043B\u0443\u0436\u0431\u0443 \u0432 \u0437\u043D\u0430\u0442\u043D\u0443\u044E
    \u0441\u0435\u043C\u044C\u044E \u0434\u0435 \u041F\u0430\u0440\u0442\u0435\u043D\u0435
    \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044F
    \u0438, \u0447\u0442\u043E \u0441\u0430\u043C\u043E\u0435 \u0432\u0430\u0436\u043D\u043E\u0435,
    **\u0443\u0447\u0438\u0442\u0435\u043B\u044F \u0434\u043B\u044F 12-\u043B\u0435\u0442\u043D\u0435\u0439
    \u0434\u043E\u0447\u0435\u0440\u0438 \u0445\u043E\u0437\u044F\u0438\u043D\u0430,
    \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u044B**. \u0418\u043C\u0435\u043D\u043D\u043E
    \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u044F
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044C \u044E\u043D\u043E\u0439 \u0430\u0440\u0438\u0441\u0442\u043E\u043A\u0440\u0430\u0442\u043A\u0435
    \u0441 \u0442\u0440\u0443\u0434\u043E\u043C, \u0412\u0438\u0435\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E
    \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0433\u043E \u0441\u0435\u0431\u044F
    \u0443\u0432\u043B\u0435\u043A\u0441\u044F \u044D\u0442\u043E\u0439 \u043D\u0430\u0443\u043A\u043E\u0439. 
    ### \U0001F3DB\uFE0F \u041D\u0430 \u043F\u0443\u0442\u0438 \u043A \u0432\u0435\u0440\u0448\u0438\u043D\u0430\u043C
    \u0432\u043B\u0430\u0441\u0442\u0438 (1571\u20131584)  \u041A\u043E\u0433\u0434\u0430
    \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u0430 \u0432\u044B\u0440\u043E\u0441\u043B\u0430
    \u0438 \u0432\u044B\u0448\u043B\u0430 \u0437\u0430\u043C\u0443\u0436, \u0412\u0438\u0435\u0442
    \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0441 \u0435\u0435 \u0441\u0435\u043C\u044C\u0435\u0439
    \u0438 \u0432 **1571 \u0433\u043E\u0434\u0443** \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B
    \u0432 **\u041F\u0430\u0440\u0438\u0436**. \u0412 \u0441\u0442\u043E\u043B\u0438\u0446\u0435
    \u043E\u043D \u043E\u043A\u0443\u043D\u0443\u043B\u0441\u044F \u0432 \u043D\u0430\u0443\u0447\u043D\u0443\u044E
    \u0436\u0438\u0437\u043D\u044C, \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F
    \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043C\u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430\u043C\u0438
    \u0415\u0432\u0440\u043E\u043F\u044B, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435
    \u0441 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u0421\u043E\u0440\u0431\u043E\u043D\u043D\u044B
    **\u041F\u044C\u0435\u0440\u043E\u043C \u0420\u0430\u043C\u0443\u0441\u043E\u043C**
    \u0438 \u043D\u0430\u0447\u0430\u043B \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0443
    \u0441 \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C
    **\u0420\u0430\u0444\u0430\u044D\u043B\u0435\u043C \u0411\u043E\u043C\u0431\u0435\u043B\u043B\u0438**. 
    \u0412 1571 \u0433\u043E\u0434\u0443 \u043E\u043D \u0442\u0430\u043A\u0436\u0435
    \u043F\u0435\u0440\u0435\u0448\u0435\u043B \u043D\u0430 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0441\u043B\u0443\u0436\u0431\u0443, \u0441\u0442\u0430\u0432 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u043C \u043F\u0430\u0440\u043B\u0430\u043C\u0435\u043D\u0442\u0430,
    \u0430 \u0437\u0430\u0442\u0435\u043C \u0438 **\u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u043C
    \u043A\u043E\u0440\u043E\u043B\u044F \u0424\u0440\u0430\u043D\u0446\u0438\u0438
    \u0413\u0435\u043D\u0440\u0438\u0445\u0430 III**. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u0431\u044B\u043B\u0430 \u0442\u0435\u0441\u043D\u043E
    \u0441\u0432\u044F\u0437\u0430\u043D\u0430 \u0441 \u0441\u0435\u043C\u044C\u0435\u0439
    \u0434\u0435 \u041F\u0430\u0440\u0442\u0435\u043D\u0435, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0431\u044B\u043B\u0430 \u0433\u0443\u0433\u0435\u043D\u043E\u0442\u0430\u043C\u0438
    (\u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0430\u043D\u0442\u0430\u043C\u0438). 
    **\u0412\u0430\u0440\u0444\u043E\u043B\u043E\u043C\u0435\u0435\u0432\u0441\u043A\u0430\u044F
    \u043D\u043E\u0447\u044C 1572 \u0433\u043E\u0434\u0430** \u0441\u0442\u0430\u043B\u0430
    \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u043D\u044B\u043C
    \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C. \u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u044D\u0442\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u0439 \u0440\u0435\u0437\u043D\u0438
    \u0433\u0443\u0433\u0435\u043D\u043E\u0442\u043E\u0432 \u043A\u0430\u0442\u043E\u043B\u0438\u043A\u0430\u043C\u0438
    \u043F\u043E\u0433\u0438\u0431\u043B\u0438 \u043C\u0443\u0436 \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u044B
    \u0434\u0435 \u041F\u0430\u0440\u0442\u0435\u043D\u0435 \u0438 \u0435\u0433\u043E
    \u0434\u0440\u0443\u0433, \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A
    \u0420\u0430\u043C\u0443\u0441. \u0412\u0438\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0441\u0430\u043C \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u043A\u0430\u0442\u043E\u043B\u0438\u043A\u043E\u043C,
    \u043A\u0430\u043A\u0438\u043C-\u0442\u043E \u043E\u0431\u0440\u0430\u0437\u043E\u043C
    \u043F\u0435\u0440\u0435\u0436\u0438\u043B \u044D\u0442\u0443 \u0440\u0435\u0437\u043D\u044E. 
    \u0421\u043F\u0443\u0441\u0442\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043B\u0435\u0442 \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u0430 \u0432\u043D\u043E\u0432\u044C
    \u0432\u044B\u0448\u043B\u0430 \u0437\u0430\u043C\u0443\u0436 \u2014 \u0437\u0430
    \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u043B\u0438\u0434\u0435\u0440\u043E\u0432
    \u0433\u0443\u0433\u0435\u043D\u043E\u0442\u043E\u0432, **\u043F\u0440\u0438\u043D\u0446\u0430
    \u0434\u0435 \u0420\u043E\u0433\u0430\u043D\u0430**. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0435\u0433\u043E \u0445\u043E\u0434\u0430\u0442\u0430\u0439\u0441\u0442\u0432\u0443
    \u0432 **1580 \u0433\u043E\u0434\u0443** \u0413\u0435\u043D\u0440\u0438\u0445
    III \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u043B \u0412\u0438\u0435\u0442\u0430
    \u043D\u0430 \u0432\u0430\u0436\u043D\u044B\u0439 \u0438 \u0432\u043B\u0438\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043F\u043E\u0441\u0442 **\u0440\u0435\u043A\u0435\u0442\u043C\u0435\u0439\u0441\u0442\u0435\u0440\u0430**.
    \u042D\u0442\u0430 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u0434\u0430\u0432\u0430\u043B\u0430
    \u0435\u043C\u0443 \u043F\u0440\u0430\u0432\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043E\u0442 \u0438\u043C\u0435\u043D\u0438 \u043A\u043E\u0440\u043E\u043B\u044F
    \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u0432
    \u0432 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u044F\u0445 \u0438 \u0434\u0430\u0436\u0435
    \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
    \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u044F \u043A\u0440\u0443\u043F\u043D\u044B\u0445
    \u0444\u0435\u043E\u0434\u0430\u043B\u043E\u0432.  ### \U0001F575\uFE0F\u200D\u2642\uFE0F
    \u041A\u0440\u0438\u043F\u0442\u043E\u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A
    \u0438 \xAB\u0443\u0447\u0435\u043D\u0438\u043A \u0434\u044C\u044F\u0432\u043E\u043B\u0430\xBB 
    \u0418\u043C\u0435\u043D\u043D\u043E \u043D\u0430 \u044D\u0442\u043E\u043C \u043F\u043E\u0441\u0442\u0443
    \u0412\u0438\u0435\u0442 \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B \u0441\u0432\u043E\u0439
    \u0441\u0430\u043C\u044B\u0439 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u043D\u0435-\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043F\u043E\u0434\u0432\u0438\u0433. \u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0432\u043E\u0439\u043D\u044B \u0424\u0440\u0430\u043D\u0446\u0438\u0438 \u0441
    \u0418\u0441\u043F\u0430\u043D\u0438\u0435\u0439 \u0435\u043C\u0443 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
    **\u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C \u043A\u043E\u0434
    \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u043E\u0439
    \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0438 \u0438\u0441\u043F\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u043B\u044F \u0424\u0438\u043B\u0438\u043F\u043F\u0430
    II** \u0441 \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F\u043C\u0438
    \u0432 \u041D\u0438\u0434\u0435\u0440\u043B\u0430\u043D\u0434\u0430\u0445.  \u0428\u0438\u0444\u0440
    \u0431\u044B\u043B \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
    \u0441\u043B\u043E\u0436\u043D\u044B\u043C: \u043E\u043D \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B
    \u0434\u043E **600 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u0432**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u0435\u043D\u044F\u043B\u0438\u0441\u044C
    \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0435 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0439
    \u043A\u043E\u0440\u043E\u043B\u044C \u0413\u0435\u043D\u0440\u0438\u0445 IV
    \u0431\u044B\u043B \u0432 \u043A\u0443\u0440\u0441\u0435 \u0432\u0441\u0435\u0445
    \u043F\u043B\u0430\u043D\u043E\u0432 \u0441\u0432\u043E\u0438\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432,
    \u0447\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u043A \u0443\u0441\u043F\u0435\u0445\u0430\u043C
    \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u043E\u044F. \u0420\u0430\u0437\u0433\u043D\u0435\u0432\u0430\u043D\u043D\u044B\u0439
    \u0424\u0438\u043B\u0438\u043F\u043F II \u043E\u0431\u0432\u0438\u043D\u0438\u043B
    \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u043E\u0432 \u0432 \u0441\u0432\u044F\u0437\u0438
    \u0441 \u043D\u0435\u0447\u0438\u0441\u0442\u043E\u0439 \u0441\u0438\u043B\u043E\u0439,
    \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443, \u043F\u043E \u0435\u0433\u043E
    \u043C\u043D\u0435\u043D\u0438\u044E, \u0442\u0430\u043A\u043E\u0439 \u0448\u0438\u0444\u0440
    \u043D\u0435 \u043C\u043E\u0433 \u0440\u0430\u0437\u0433\u0430\u0434\u0430\u0442\u044C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u0418\u0441\u043F\u0430\u043D\u0441\u043A\u0430\u044F
    \u0438\u043D\u043A\u0432\u0438\u0437\u0438\u0446\u0438\u044F \u0437\u0430\u043E\u0447\u043D\u043E
    \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u0412\u0438\u0435\u0442\u0430
    \u043A \u0441\u043E\u0436\u0436\u0435\u043D\u0438\u044E \u043D\u0430 \u043A\u043E\u0441\u0442\u0440\u0435. 
    \u041A \u044D\u0442\u043E\u043C\u0443 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043E \u0435\u0433\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0439
    \u0442\u0440\u0443\u0434\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438:
    \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u043D\u044B\u0439 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
    \u0437\u0430\u0434\u0430\u0447\u0435\u0439, \u043E\u043D \u043C\u043E\u0433 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043F\u043E \u0442\u0440\u043E\u0435 \u0441\u0443\u0442\u043E\u043A \u0431\u0435\u0437
    \u0441\u043D\u0430.  ### \U0001F4D0 \u041F\u0438\u043A \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430:
    \u0438\u0437\u0433\u043D\u0430\u043D\u0438\u0435 \u0438 \xAB\u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\xBB (1584\u20131591) 
    \u0412 **1584 \u0433\u043E\u0434\u0443**, \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u043F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u044B\u0445 \u0438\u043D\u0442\u0440\u0438\u0433
    \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043C\u043E\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0440\u043E\u0434\u0430 \u0413\u0438\u0437\u043E\u0432, \u0412\u0438\u0435\u0442\u0430
    \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u0438\u043B\u0438 \u043E\u0442 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0432\u044B\u0441\u043B\u0430\u043B\u0438 \u0438\u0437 \u041F\u0430\u0440\u0438\u0436\u0430.
    \u042D\u0442\u043E \u0438\u0437\u0433\u043D\u0430\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0441\u0442\u0430\u0442\u044C
    \u043A\u043E\u043D\u0446\u043E\u043C \u0435\u0433\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u044B,
    \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u043E\u0441\u044C \u0434\u043B\u044F
    \u043D\u0430\u0443\u043A\u0438 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u043C
    \u0431\u043B\u0430\u0433\u043E\u043C. \u041E\u0431\u0440\u0435\u0442\u044F \u0434\u043E\u043B\u0433\u043E\u0436\u0434\u0430\u043D\u043D\u044B\u0439
    \u043F\u043E\u043A\u043E\u0439, \u0412\u0438\u0435\u0442 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u043F\u043E\u0441\u0432\u044F\u0442\u0438\u043B \u0441\u0435\u0431\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435. 
    \u041E\u043D \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u0435\u0440\u0435\u0434
    \u0441\u043E\u0431\u043E\u0439 \u0446\u0435\u043B\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C
    \u0432\u0441\u0435\u043E\u0431\u044A\u0435\u043C\u043B\u044E\u0449\u0443\u044E
    \u043D\u0430\u0443\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0430
    \u0431\u044B \u0430\u043B\u0433\u0435\u0431\u0440\u0443 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u043E\u0432
    \u0438 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044E \u0434\u0440\u0435\u0432\u043D\u0438\u0445.
    \u0418\u043C\u0435\u043D\u043D\u043E \u0432 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434,
    \u0432 **1591 \u0433\u043E\u0434\u0443**, \u043E\u043D \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B
    \u0441\u0432\u043E\u0439 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u0442\u0440\u0443\u0434 **\xAB\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0432 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\xBB**. \u0412 \u044D\u0442\u043E\u0439
    \u043A\u043D\u0438\u0433\u0435 \u043E\u043D \u0438\u0437\u043B\u043E\u0436\u0438\u043B
    \u0441\u0432\u043E\u044E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
    \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B \u043C\u0438\u0440\u0443
    **\u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0430\u043B\u0433\u0435\u0431\u0440\u0443** \u2014 \u043D\u043E\u0432\u044B\u0439
    \u044F\u0437\u044B\u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438,
    \u0433\u0434\u0435 \u0431\u0443\u043A\u0432\u0430\u043C\u0438 (\u0433\u043B\u0430\u0441\u043D\u044B\u043C\u0438
    \u0434\u043B\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445,
    \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u043C\u0438 \u0434\u043B\u044F
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445) \u043C\u043E\u0436\u043D\u043E
    \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0442\u044C \u043B\u044E\u0431\u044B\u0435
    \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u044B \u0438 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C
    \u0444\u043E\u0440\u043C\u0443\u043B\u044B \u0432 \u043E\u0431\u0449\u0435\u043C
    \u0432\u0438\u0434\u0435. \u0412 \u0442\u043E\u043C \u0436\u0435 \u0433\u043E\u0434\u0443
    \u043E\u043D \u043E\u0431\u043D\u0430\u0440\u043E\u0434\u043E\u0432\u0430\u043B
    \u0441\u0432\u043E\u044E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0443\u044E
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443, \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0449\u0443\u044E
    \u043A\u043E\u0440\u043D\u0438 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F
    \u0441 \u0435\u0433\u043E \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0430\u043C\u0438. 
    ### \u2B50 \u0417\u0432\u0435\u0437\u0434\u043D\u044B\u0439 \u0447\u0430\u0441
    \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 (1589\u20131603) 
    \u041F\u043E\u0441\u043B\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430
    \u0413\u0435\u043D\u0440\u0438\u0445\u0430 III \u0432 1589 \u0433\u043E\u0434\u0443
    \u0432\u043B\u0430\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0448\u043B\u0430
    \u043A \u0413\u0435\u043D\u0440\u0438\u0445\u0443 \u041D\u0430\u0432\u0430\u0440\u0440\u0441\u043A\u043E\u043C\u0443,
    \u0431\u0443\u0434\u0443\u0449\u0435\u043C\u0443 \u043A\u043E\u0440\u043E\u043B\u044E
    \u0413\u0435\u043D\u0440\u0438\u0445\u0443 IV. \u0412\u0438\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439,
    \u043F\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0434\u0430\u043D\u043D\u044B\u043C,
    \u043F\u0435\u0440\u0435\u0448\u0435\u043B \u043D\u0430 \u0441\u043B\u0443\u0436\u0431\u0443
    \u043A \u043D\u043E\u0432\u043E\u043C\u0443 \u043A\u043E\u0440\u043E\u043B\u044E,
    \u0432\u0441\u043A\u043E\u0440\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0432 \u041F\u0430\u0440\u0438\u0436.  \u0412\u0441\u0435\u043C\u0438\u0440\u043D\u0443\u044E
    \u0441\u043B\u0430\u0432\u0443 \u0435\u043C\u0443 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
    \u043F\u043E\u0431\u0435\u0434\u0430 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u043F\u043E\u0435\u0434\u0438\u043D\u043A\u0435 \u0432 **1594 \u0433\u043E\u0434\u0443**.
    \u0413\u043E\u043B\u043B\u0430\u043D\u0434\u0441\u043A\u0438\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A
    \u0410\u0434\u0440\u0438\u0430\u043D \u0432\u0430\u043D \u0420\u043E\u0443\u043C\u0435\u043D
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0440\u0435\u0448\u0438\u0442\u044C
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 45-\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438,
    \u0434\u0430\u0436\u0435 \u043D\u0435 \u0430\u0434\u0440\u0435\u0441\u043E\u0432\u0430\u0432
    \u0432\u044B\u0437\u043E\u0432 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0430\u043C,
    \u0441\u0447\u0438\u0442\u0430\u044F, \u0447\u0442\u043E \u0432\u043E \u0424\u0440\u0430\u043D\u0446\u0438\u0438
    \u043D\u0435\u0442 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432.
    \u0412\u0438\u0435\u0442 \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043F\u0440\u0438\u0435\u043C\u0435
    \u0443 \u043A\u043E\u0440\u043E\u043B\u044F \u043D\u0430\u0448\u0435\u043B \u0432\u0441\u0435
    \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043A\u043E\u0440\u043D\u0438 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F,
    \u043F\u043E\u043A\u0430\u0437\u0430\u0432, \u0447\u0442\u043E \u043E\u043D\u043E
    \u0441\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u043A \u0437\u0430\u0434\u0430\u0447\u0435
    \u043E \u0434\u0435\u043B\u0435\u043D\u0438\u0438 \u0443\u0433\u043B\u0430 \u043D\u0430
    45 \u0447\u0430\u0441\u0442\u0435\u0439. \u041F\u043E\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0439
    \u0432\u0430\u043D \u0420\u043E\u0443\u043C\u0435\u043D \u043F\u0440\u0438\u0435\u0445\u0430\u043B
    \u043A \u0412\u0438\u0435\u0442\u0443, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F
    \u0441 \u0435\u0433\u043E \u043C\u0435\u0442\u043E\u0434\u0430\u043C\u0438, \u0438
    \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0437\u0430\u0432\u044F\u0437\u0430\u043B\u0430\u0441\u044C
    \u0434\u0440\u0443\u0436\u0431\u0430.  \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B \u0436\u0438\u0437\u043D\u0438 \u0412\u0438\u0435\u0442
    \u043E\u0442\u043E\u0448\u0435\u043B \u043E\u0442 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0441\u043B\u0443\u0436\u0431\u044B. \u0418\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
    \u0447\u0442\u043E \u043E\u043D \u0432\u0441\u0442\u0443\u043F\u0438\u043B \u0432
    \u043F\u043E\u043B\u0435\u043C\u0438\u043A\u0443 \u043E \u0432\u0432\u0435\u0434\u0435\u043D\u0438\u0438
    \u0432 \u0415\u0432\u0440\u043E\u043F\u0435 \u043D\u043E\u0432\u043E\u0433\u043E,
    \u0433\u0440\u0438\u0433\u043E\u0440\u0438\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044F \u0438 \u0434\u0430\u0436\u0435
    \u0445\u043E\u0442\u0435\u043B \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0441\u0432\u043E\u0439
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439.  ### \U0001F56F\uFE0F
    \u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C \u0438 \u0441\u043C\u0435\u0440\u0442\u044C 
    \u041E \u043B\u0438\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438 \u0412\u0438\u0435\u0442\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E.
    \u0412 \u043C\u0435\u043C\u0443\u0430\u0440\u0430\u0445 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u043E\u0432
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F,
    \u0447\u0442\u043E \u043E\u043D \u0431\u044B\u043B **\u0436\u0435\u043D\u0430\u0442**
    \u0438 \u0443 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0430 \u0434\u043E\u0447\u044C,
    **\u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u0446\u0430
    \u0438\u043C\u0435\u043D\u0438\u044F**, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043E\u043D \u043D\u043E\u0441\u0438\u043B
    \u0442\u0438\u0442\u0443\u043B \u0441\u0435\u043D\u044C\u043E\u0440\u0430 \u0434\u0435
    \u043B\u0430 \u0411\u0438\u0433\u043E\u0442\u044C\u0435.  \u0424\u0440\u0430\u043D\u0441\u0443\u0430
    \u0412\u0438\u0435\u0442 \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F
    \u0432 **\u041F\u0430\u0440\u0438\u0436\u0435 13 \u0444\u0435\u0432\u0440\u0430\u043B\u044F
    (\u0438\u043B\u0438 14 \u0444\u0435\u0432\u0440\u0430\u043B\u044F) 1603 \u0433\u043E\u0434\u0430**.
    \u0412 \u043F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u044B\u0445 \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u0445
    \u0431\u044B\u043B\u043E \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E: \xAB...\u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D
    \u0412\u0438\u0435\u0442, \u0440\u0435\u043A\u0435\u0442\u043C\u0435\u0439\u0441\u0442\u0435\u0440,
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
    \u0443\u043C\u0430 \u0438 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F
    \u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0443\u0447\u0435\u043D\u044B\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432 \u0432\u0435\u043A\u0430
    \u0443\u043C\u0435\u0440... \u0432 \u041F\u0430\u0440\u0438\u0436\u0435. \u0415\u043C\u0443
    \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u0435\u0435 \u0448\u0435\u0441\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u0438
    \u043B\u0435\u0442\xBB.  \u0415\u0433\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439
    \u0442\u0440\u0443\u0434 \u2014 \u0432\u0441\u0435\u043E\u0431\u044A\u0435\u043C\u043B\u044E\u0449\u0438\u0439
    \u0442\u0440\u0430\u043A\u0442\u0430\u0442 \xAB\u0410\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\xBB \u2014 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
    \u043D\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u043C.
    \u041C\u043D\u043E\u0433\u0438\u0435 \u0440\u0430\u0431\u043E\u0442\u044B \u0431\u044B\u043B\u0438
    \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u044B \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u0438.
    \u0421\u0431\u043E\u0440\u043D\u0438\u043A \u0435\u0433\u043E \u0442\u0440\u0443\u0434\u043E\u0432
    \u0431\u044B\u043B \u0438\u0437\u0434\u0430\u043D \u0432 1646 \u0433\u043E\u0434\u0443
    \u0432 \u041B\u0435\u0439\u0434\u0435\u043D\u0435 \u0435\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u0424\u0440\u0430\u043D\u0441\u043E\u043C \u0432\u0430\u043D \u0421\u0445\u043E\u0442\u0435\u043D\u043E\u043C."
  personalLifeEn: 
  shortBioRu: "\u0424\u0440\u0430\u043D\u0441\u0443\u0430 \u0412\u0438\u0435\u0442
    (1540\u20131603) \u2013 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A, \u043E\u0441\u043D\u043E\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u0438\u043A
    \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u043E \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044E
    \u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u0438
    \u0431\u044B\u043B \u044E\u0440\u0438\u0441\u0442\u043E\u043C \u0438 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0434\u0435\u044F\u0442\u0435\u043B\u0435\u043C.  ### \U0001F4DC \u0420\u0430\u043D\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B \u0438 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    (1540\u20131560)  \u0424\u0440\u0430\u043D\u0441\u0443\u0430 \u0412\u0438\u0435\u0442
    \u0440\u043E\u0434\u0438\u043B\u0441\u044F \u0432 1540 \u0433\u043E\u0434\u0443
    \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u043A\u0435
    \u0424\u043E\u043D\u0442\u0435\u043D\u0435-\u043B\u0435-\u041A\u043E\u043D\u0442
    \u0432 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438 \u041F\u0443\u0430\u0442\u0443-\u0428\u0430\u0440\u0430\u043D\u0442
    \u043D\u0430 \u044E\u0433\u0435 \u0424\u0440\u0430\u043D\u0446\u0438\u0438. \u0415\u0433\u043E
    \u043E\u0442\u0435\u0446 \u0431\u044B\u043B \u043F\u0440\u043E\u043A\u0443\u0440\u043E\u0440\u043E\u043C,
    \u0438 \u043F\u043E \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u0441\u0435\u043C\u044C\u0438
    \u0441\u044B\u043D \u0432\u044B\u0431\u0440\u0430\u043B \u0442\u0443 \u0436\u0435
    \u0441\u0442\u0435\u0437\u044E. \u0415\u0433\u043E \u043C\u0430\u0442\u044C,
    \u041C\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0430 \u0414\u044E\u043F\u043E\u043D,
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430 \u0438\u0437
    \u0437\u043D\u0430\u0442\u043D\u043E\u0439 \u0441\u0435\u043C\u044C\u0438, \u0447\u0442\u043E
    \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u043E\u0431\u043B\u0435\u0433\u0447\u0438\u043B\u043E
    \u0435\u0433\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u0443.  \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0412\u0438\u0435\u0442
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432 \u043C\u0435\u0441\u0442\u043D\u043E\u043C
    \u0444\u0440\u0430\u043D\u0446\u0438\u0441\u043A\u0430\u043D\u0441\u043A\u043E\u043C
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435. \u0417\u0430\u0442\u0435\u043C
    \u043E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u041F\u0443\u0430\u0442\u044C\u0435, \u0433\u0434\u0435 \u0432 1560 \u0433\u043E\u0434\u0443
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0442\u0435\u043F\u0435\u043D\u044C
    \u0431\u0430\u043A\u0430\u043B\u0430\u0432\u0440\u0430 (\u0447\u0442\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u043D\u0430\u0447\u0430\u043B\u0443 \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043A\u0430\u0440\u044C\u0435\u0440\u044B).  ### \u2696\uFE0F \u041D\u0430\u0447\u0430\u043B\u043E
    \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043A\u0430\u0440\u044C\u0435\u0440\u044B
    \u0438 \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0439
    (1560\u20131571)  \u0421 19 \u043B\u0435\u0442 \u0412\u0438\u0435\u0442 \u043D\u0430\u0447\u0430\u043B
    \u0430\u0434\u0432\u043E\u043A\u0430\u0442\u0441\u043A\u0443\u044E \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0443
    \u0432 \u0440\u043E\u0434\u043D\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435.
    \u0412 1564 \u0433\u043E\u0434\u0443 \u043E\u043D \u043F\u0435\u0440\u0435\u0448\u0435\u043B
    \u043D\u0430 \u0441\u043B\u0443\u0436\u0431\u0443 \u0432 \u0437\u043D\u0430\u0442\u043D\u0443\u044E
    \u0433\u0443\u0433\u0435\u043D\u043E\u0442\u0441\u043A\u0443\u044E \u0441\u0435\u043C\u044C\u044E
    \u0434\u0435 \u041F\u0430\u0440\u0442\u0435\u043D\u0435, \u0441\u0442\u0430\u0432
    \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u0435\u043C \u0438 \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C
    12-\u043B\u0435\u0442\u043D\u0435\u0439 \u0434\u043E\u0447\u0435\u0440\u0438
    \u0445\u043E\u0437\u044F\u0438\u043D\u0430, \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u044B.
    \u0418\u043C\u0435\u043D\u043D\u043E \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u0435
    \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u043B\u043E \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u043C
    \u044E\u0440\u0438\u0441\u0442\u0435 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435. 
    \u041A\u043E\u0433\u0434\u0430 \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u0430
    \u0432\u044B\u0440\u043E\u0441\u043B\u0430 \u0438 \u0432\u044B\u0448\u043B\u0430
    \u0437\u0430\u043C\u0443\u0436, \u0412\u0438\u0435\u0442 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
    \u0441 \u0435\u0435 \u0441\u0435\u043C\u044C\u0435\u0439 \u0438 \u043E\u043A\u043E\u043B\u043E
    1571 \u0433\u043E\u0434\u0430 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B
    \u0441 \u043D\u0438\u043C\u0438 \u0432 \u041F\u0430\u0440\u0438\u0436. \u0412
    \u0441\u0442\u043E\u043B\u0438\u0446\u0435 \u043E\u043D \u0441\u043C\u043E\u0433
    \u0431\u043B\u0438\u0436\u0435 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F
    \u0441 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F\u043C\u0438
    \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432
    \u0415\u0432\u0440\u043E\u043F\u044B, \u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F
    \u0441 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C \u0421\u043E\u0440\u0431\u043E\u043D\u043D\u044B
    \u0420\u0430\u043C\u0443\u0441\u043E\u043C \u0438 \u0432\u0435\u0441\u0442\u0438
    \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0443 \u0441 \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C \u0420\u0430\u0444\u0430\u044D\u043B\u0435\u043C
    \u0411\u043E\u043C\u0431\u0435\u043B\u043B\u0438. \u0412 \u044D\u0442\u043E\u0442
    \u043F\u0435\u0440\u0438\u043E\u0434 \u043E\u043D \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u0442\u0440\u0443\u0434
    \u043F\u043E \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u0438
    \xAB\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u0430\u043D\u043E\u043D\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0431\u044B\u043B \u0438\u0437\u0434\u0430\u043D \u0432 \u041F\u0430\u0440\u0438\u0436\u0435
    \u0432 1579 \u0433\u043E\u0434\u0443.  ### \U0001F3DB\uFE0F \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0441\u043B\u0443\u0436\u0431\u0430 \u0438 \u0441\u043B\u0443\u0436\u0431\u0430
    \u043A\u043E\u0440\u043E\u043D\u0435 (1571\u20131584)  \u0412 1571 \u0433\u043E\u0434\u0443
    \u0412\u0438\u0435\u0442 \u043F\u0435\u0440\u0435\u0448\u0435\u043B \u043D\u0430
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0441\u043B\u0443\u0436\u0431\u0443, \u0441\u0442\u0430\u0432 \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u043C
    \u043F\u0430\u0440\u043B\u0430\u043C\u0435\u043D\u0442\u0430, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0438 \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u043C \u043A\u043E\u0440\u043E\u043B\u044F
    \u0413\u0435\u043D\u0440\u0438\u0445\u0430 III. \u0412 1580 \u0433\u043E\u0434\u0443
    \u043A\u043E\u0440\u043E\u043B\u044C \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u043B
    \u0435\u0433\u043E \u043D\u0430 \u0432\u0430\u0436\u043D\u044B\u0439 \u043F\u043E\u0441\u0442
    \u0440\u0435\u043A\u0435\u0442\u043C\u0435\u0439\u0441\u0442\u0435\u0440\u0430.
    \u042D\u0442\u0430 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u0434\u0430\u0432\u0430\u043B\u0430
    \u0435\u043C\u0443 \u043F\u0440\u0430\u0432\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043E\u0442 \u0438\u043C\u0435\u043D\u0438 \u043C\u043E\u043D\u0430\u0440\u0445\u0430
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0445
    \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0439 \u0432
    \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u044F\u0445 \u0438 \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
    \u043F\u0440\u0438\u043A\u0430\u0437\u044B \u043A\u0440\u0443\u043F\u043D\u044B\u0445
    \u0444\u0435\u043E\u0434\u0430\u043B\u043E\u0432.  \u041D\u0430 \u044D\u0442\u043E\u0439
    \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438 \u0412\u0438\u0435\u0442
    \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0441\u044F \u043A\u0430\u043A
    \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0439\u0441\u044F \u043A\u0440\u0438\u043F\u0442\u043E\u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A.
    \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0439\u043D\u044B \u0441
    \u0418\u0441\u043F\u0430\u043D\u0438\u0435\u0439 \u0435\u043C\u0443 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
    \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u0439
    \u0438\u0441\u043F\u0430\u043D\u0441\u043A\u0438\u0439 \u0448\u0438\u0444\u0440,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
    \u043C\u0435\u043D\u044F\u043B\u0441\u044F \u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B
    \u0434\u043E 600 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u0432.
    \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u044D\u0442\u043E\u043C\u0443
    \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043E\u043B\u044C
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B \u0432 \u043A\u0443\u0440\u0441\u0435
    \u043F\u043B\u0430\u043D\u043E\u0432 \u0441\u0432\u043E\u0438\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432.
    \u0418\u0441\u043F\u0430\u043D\u0446\u044B, \u043D\u0435 \u0432\u0435\u0440\u044F
    \u0432 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0435
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438,
    \u043E\u0431\u0432\u0438\u043D\u0438\u043B\u0438 \u0412\u0438\u0435\u0442\u0430
    \u0432 \u0441\u043E\u044E\u0437\u0435 \u0441 \u0434\u044C\u044F\u0432\u043E\u043B\u043E\u043C. 
    ### \U0001F4D0 \u041F\u0435\u0440\u0438\u043E\u0434 \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430 (1584\u20131591)  \u0412 1584
    \u0433\u043E\u0434\u0443 \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u043F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u044B\u0445 \u0438\u043D\u0442\u0440\u0438\u0433
    \u0412\u0438\u0435\u0442\u0430 \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u0438\u043B\u0438
    \u043E\u0442 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438 \u0438 \u0432\u044B\u0441\u043B\u0430\u043B\u0438
    \u0438\u0437 \u041F\u0430\u0440\u0438\u0436\u0430. \u042D\u0442\u043E\u0442 \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D\u043D\u044B\u0439
    \u043E\u0442\u0434\u044B\u0445 \u0441\u0442\u0430\u043B \u043F\u0438\u043A\u043E\u043C
    \u0435\u0433\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430. \u041E\u0431\u0440\u0435\u0442\u044F
    \u043F\u043E\u043A\u043E\u0439, \u043E\u043D \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439 \u0430\u043C\u0431\u0438\u0446\u0438\u043E\u0437\u043D\u0443\u044E
    \u0446\u0435\u043B\u044C: \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0432\u0441\u0435\u043E\u0431\u044A\u0435\u043C\u043B\u044E\u0449\u0443\u044E
    \u043D\u0430\u0443\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0430
    \u0431\u044B \u0440\u0435\u0448\u0430\u0442\u044C \u043B\u044E\u0431\u044B\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438. \u041F\u043E \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430\u043C,
    \u043E\u043D \u0431\u044B\u043B \u0443\u0431\u0435\u0436\u0434\u0435\u043D, \"\u0447\u0442\u043E
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u043E\u0431\u0449\u0430\u044F, \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F
    \u0435\u0449\u0435 \u043D\u0430\u0443\u043A\u0430, \u043E\u0431\u043D\u0438\u043C\u0430\u044E\u0449\u0430\u044F
    \u0438 \u043E\u0441\u0442\u0440\u043E\u0443\u043C\u043D\u044B\u0435 \u0438\u0437\u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F
    \u043D\u043E\u0432\u0435\u0439\u0448\u0438\u0445 \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0441\u0442\u043E\u0432,
    \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u0438\u044F \u0434\u0440\u0435\u0432\u043D\u0438\u0445\". 
    \u0418\u0442\u043E\u0433\u043E\u043C \u0435\u0433\u043E \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0439
    \u0441\u0442\u0430\u043B \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u0442\u0440\u0430\u043A\u0442\u0430\u0442 **\xAB\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0432 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\xBB** (1591 \u0433\u043E\u0434).
    \u0412 \u044D\u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435 \u0412\u0438\u0435\u0442
    \u0438\u0437\u043B\u043E\u0436\u0438\u043B \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
    \u0441\u0432\u043E\u0438\u0445 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439
    \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B \u043D\u043E\u0432\u044B\u0439
    \u044F\u0437\u044B\u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u2014 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0430\u043B\u0433\u0435\u0431\u0440\u0443. \u0421\u0432\u043E\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443
    \u043E\u043D \u043D\u0430\u0437\u0432\u0430\u043B \xAB\u0432\u0438\u0434\u043E\u0432\u043E\u0439
    \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u043E\u0439\xBB. \u0413\u043B\u0430\u0432\u043D\u043E\u0439
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0438\u0434\u0435\u0435\u0439 \u0431\u044B\u043B\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0431\u0443\u043A\u0432 \u0434\u043B\u044F \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    (\u0433\u043B\u0430\u0441\u043D\u044B\u0435), \u043D\u043E \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u0432\u0435\u043B\u0438\u0447\u0438\u043D (\u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u0435).
    \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E:  -
    \u0417\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0438 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F
    \u0432 \u043E\u0431\u0449\u0435\u043C \u0432\u0438\u0434\u0435. - \u041E\u043F\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0441\u0438\u043C\u0432\u043E\u043B\u0430\u043C\u0438, \u043F\u043E\u043B\u0443\u0447\u0430\u044F
    \u0444\u043E\u0440\u043C\u0443\u043B\u044B, \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u0435
    \u043A \u043B\u044E\u0431\u044B\u043C \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u0430\u043C.  \u0422\u0430\u043A\u0438\u043C
    \u043E\u0431\u0440\u0430\u0437\u043E\u043C, \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430 \u0431\u044B\u0442\u044C
    \u043D\u0430\u0443\u043A\u043E\u0439 \u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0445
    \u0447\u0438\u0441\u043B\u0430\u0445 \u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430\u0441\u044C
    \u0432 \u043D\u0430\u0443\u043A\u0443 \u043E \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0439, \u0447\u0442\u043E \u0437\u0430\u043B\u043E\u0436\u0438\u043B\u043E
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442
    \u0414\u0435\u043A\u0430\u0440\u0442\u0430, \u0424\u0435\u0440\u043C\u0430 \u0438
    \u041D\u044C\u044E\u0442\u043E\u043D\u0430.  \u0418\u043C\u0435\u043D\u043D\u043E
    \u0432 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434 \u043E\u043D
    \u043E\u0431\u043D\u0430\u0440\u043E\u0434\u043E\u0432\u0430\u043B \u0441\u0432\u043E\u044E
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0443\u044E \u0442\u0435\u043E\u0440\u0435\u043C\u0443,
    \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0449\u0443\u044E
    \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u043A\u043E\u0440\u043D\u044F\u043C\u0438
    \u0438 \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0430\u043C\u0438
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F. \u0414\u043B\u044F \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0433\u043E
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F \u043E\u043D \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u0435\u0451 \u0442\u0430\u043A: *\xAB\u0415\u0441\u043B\u0438 B+D, \u0443\u043C\u043D\u043E\u0436\u0435\u043D\u043D\u043E\u0435
    \u043D\u0430 \u0410, \u043C\u0438\u043D\u0443\u0441 \u0410 \u0432 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0435
    \u0440\u0430\u0432\u043D\u043E BD, \u0442\u043E \u0410 \u0440\u0430\u0432\u043D\u043E
    \u0412 \u0438 \u0440\u0430\u0432\u043D\u043E D\xBB*. \u0422\u0435\u043F\u0435\u0440\u044C
    \u043E\u043D\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430 \u043A\u0430\u043A
    **\u0442\u0435\u043E\u0440\u0435\u043C\u0430 \u0412\u0438\u0435\u0442\u0430**. 
    ### \u2B50 \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u0438 \u0432\u0441\u0435\u043C\u0438\u0440\u043D\u0430\u044F \u0441\u043B\u0430\u0432\u0430
    (1589\u20131594)  \u0412 1589 \u0433\u043E\u0434\u0443, \u043F\u043E\u0441\u043B\u0435
    \u0433\u0438\u0431\u0435\u043B\u0438 \u0413\u0435\u043D\u0440\u0438\u0445\u0430
    \u0413\u0438\u0437\u0430, \u0412\u0438\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0432 \u041F\u0430\u0440\u0438\u0436. \u041E\u043D \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
    \u0441\u043B\u0443\u0436\u0431\u0443, \u0441\u0442\u0430\u0432 \u043F\u0440\u0438
    \u0413\u0435\u043D\u0440\u0438\u0445\u0435 IV \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u043D\u044B\u0445
    \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u0432. \u0422\u0435\u043C
    \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043E\u043D \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B
    \u0437\u0430\u043D\u044F\u0442\u0438\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0439. 
    \u0412\u0441\u0435\u043C\u0438\u0440\u043D\u0443\u044E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C
    \u0435\u043C\u0443 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430 \u043F\u043E\u0431\u0435\u0434\u0430
    \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u043F\u043E\u0435\u0434\u0438\u043D\u043A\u0435. \u0412 1594 \u0433\u043E\u0434\u0443
    \u0433\u043E\u043B\u043B\u0430\u043D\u0434\u0441\u043A\u0438\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A
    \u0410\u0434\u0440\u0438\u0430\u043D \u0432\u0430\u043D \u0420\u043E\u0443\u043C\u0435\u043D
    \u0431\u0440\u043E\u0441\u0438\u043B \u0432\u044B\u0437\u043E\u0432 \u0432\u0441\u0435\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430\u043C \u043C\u0438\u0440\u0430,
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432 \u0440\u0435\u0448\u0438\u0442\u044C
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 45-\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438.
    \u0412\u044B\u0437\u043E\u0432 \u0432\u043E \u0424\u0440\u0430\u043D\u0446\u0438\u044E
    \u043E\u043D \u043D\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B, \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443
    \u0441\u0447\u0438\u0442\u0430\u043B, \u0447\u0442\u043E \u0442\u0430\u043C \u043D\u0435\u0442
    \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432.
    \u0412\u0438\u0435\u0442, \u0443\u0437\u043D\u0430\u0432 \u043E\u0431 \u044D\u0442\u043E\u043C,
    \u0432 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043A\u043E\u0440\u043E\u043B\u044F
    \u0438 \u043F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u044B\u0445 \u043D\u0430\u0448\u0435\u043B
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u043A\u043E\u0440\u0435\u043D\u044C,
    \u043D\u043E \u0438 \u0432\u0441\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435,
    \u043F\u043E\u043A\u0430\u0437\u0430\u0432, \u0447\u0442\u043E \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435
    \u0441\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u043A \u0437\u0430\u0434\u0430\u0447\u0435
    \u043E \u0434\u0435\u043B\u0435\u043D\u0438\u0438 \u0443\u0433\u043B\u0430 \u043D\u0430
    45 \u0447\u0430\u0441\u0442\u0435\u0439. \u041F\u043E\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0439
    \u0432\u0430\u043D \u0420\u043E\u0443\u043C\u0435\u043D \u0441\u0442\u0430\u043B
    \u0435\u0433\u043E \u0440\u0435\u0432\u043D\u043E\u0441\u0442\u043D\u044B\u043C
    \u043F\u043E\u0447\u0438\u0442\u0430\u0442\u0435\u043B\u0435\u043C.  ### \U0001F3C6
    \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u0438 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435  \u0424\u0440\u0430\u043D\u0441\u0443\u0430
    \u0412\u0438\u0435\u0442 \u0443\u043C\u0435\u0440 \u0432 \u041F\u0430\u0440\u0438\u0436\u0435
    13 \u0434\u0435\u043A\u0430\u0431\u0440\u044F 1603 \u0433\u043E\u0434\u0430 (\u043F\u043E
    \u0434\u0440\u0443\u0433\u0438\u043C \u0434\u0430\u043D\u043D\u044B\u043C \u2014
    14 \u0444\u0435\u0432\u0440\u0430\u043B\u044F ). \u0415\u043C\u0443 \u0431\u044B\u043B\u043E
    63 \u0433\u043E\u0434\u0430. \u0415\u0441\u0442\u044C \u043D\u0435\u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u043D\u044B\u0435
    \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
    \u0447\u0442\u043E \u043E\u043D \u043C\u043E\u0433 \u0441\u0442\u0430\u0442\u044C
    \u0436\u0435\u0440\u0442\u0432\u043E\u0439 \u043D\u0430\u0441\u0438\u043B\u044C\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0441\u043C\u0435\u0440\u0442\u0438.  \u0413\u043B\u0430\u0432\u043D\u044B\u0439
    \u0442\u0440\u0443\u0434 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438 \u2014
    \u0432\u0441\u0435\u043E\u0431\u044A\u0435\u043C\u043B\u044E\u0449\u0438\u0439
    \u0442\u0440\u0430\u043A\u0442\u0430\u0442 \xAB\u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430, \u0438\u043B\u0438 \u041D\u043E\u0432\u0430\u044F
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\xBB \u2014 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
    \u043D\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u043C.
    \u041F\u0440\u0438 \u0436\u0438\u0437\u043D\u0438 \u0431\u044B\u043B\u0438 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u044B
    \u043B\u0438\u0448\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    \u0435\u0433\u043E \u0447\u0430\u0441\u0442\u0438. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u0431\u044B\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u043D\u043E:
    \u0412\u0438\u0435\u0442 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0437\u0434\u0430\u043B
    \u043D\u043E\u0432\u044B\u0439 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u044F\u0437\u044B\u043A \u0434\u043B\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438,
    \u043D\u043E \u0438:  - \u0414\u0430\u043B\u0435\u043A\u043E \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u043B
    \u0442\u0440\u0438\u0433\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0438\u044E:
    \u043F\u0435\u0440\u0432\u044B\u043C \u044F\u0432\u043D\u043E \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u043A\u043E\u0441\u0438\u043D\u0443\u0441\u043E\u0432
    \u0438 \u0432\u044B\u0432\u0435\u043B \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u0434\u043B\u044F \u0441\u0438\u043D\u0443\u0441\u043E\u0432 \u0438 \u043A\u043E\u0441\u0438\u043D\u0443\u0441\u043E\u0432
    \u043A\u0440\u0430\u0442\u043D\u044B\u0445 \u0443\u0433\u043B\u043E\u0432. -
    \u0420\u0435\u0448\u0438\u043B \u0434\u0440\u0435\u0432\u043D\u044E\u044E \u0437\u0430\u0434\u0430\u0447\u0443
    \u0442\u0440\u0438\u0441\u0435\u043A\u0446\u0438\u0438 \u0443\u0433\u043B\u0430,
    \u0441\u0432\u0435\u0434\u044F \u0435\u0435 \u043A \u043A\u0443\u0431\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E. - \u0412\u043D\u0435\u0441
    \u0432\u043A\u043B\u0430\u0434 \u0432 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438,
    \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0440\u0435\u0448\u0438\u0432
    \u0437\u0430\u0434\u0430\u0447\u0443 \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0438\u044F.
    - \u0412\u0432\u0435\u043B \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u0434\u0435\u0441\u044F\u0442\u0438\u0447\u043D\u044B\u0445 \u0434\u0440\u043E\u0431\u0435\u0439
