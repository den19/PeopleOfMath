    \u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435
    \u043d\u043e\u0432\u043e\u0433\u043e, \u0433\u0440\u0438\u0433\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f \u0438 \u0434\u0430\u0436\u0435 \u0445\u043e\u0442\u0435\u043b
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439.\n\n\U0001F56F\ufe0f
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u041e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0412\u0438\u0435\u0442\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043d\u0435\u043c\u043d\u043e\u0433\u043e.
