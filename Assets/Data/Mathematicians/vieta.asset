    (\u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0445 \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0430\u043D\u0442\u043E\u0432),
    \u043D\u043E \u0441\u0430\u043C \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F
    \u043A\u0430\u0442\u043E\u043B\u0438\u043A\u043E\u043C. \u041F\u043E-\u0432\u0438\u0434\u0438\u043C\u043E\u043C\u0443,
    \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u044B\u0435 \u0440\u0430\u0437\u043D\u043E\u0433\u043B\u0430\u0441\u0438\u044F
    \u0435\u0433\u043E \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u043B\u0438,
    \u0438 \u043E\u043D \u0441\u0443\u043C\u0435\u043B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u0438\u0442\u0435\u0442. *   **\u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C
    \u0440\u0435\u0437\u043D\u0438:** \u0412 \u0412\u0430\u0440\u0444\u043E\u043B\u043E\u043C\u0435\u0435\u0432\u0441\u043A\u0443\u044E
