    \u043d\u0435 \u0432\u0435\u0440\u044f \u0432 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438,
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b\u0438 \u0412\u0438\u0435\u0442\u0430 \u0432 \u0441\u043e\u044e\u0437\u0435
    \u0441 \u0434\u044c\u044f\u0432\u043e\u043b\u043e\u043c.\n\n\U0001F4D0 \u041f\u0435\u0440\u0438\u043e\u0434
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430
    (1584\u20131591) \u0412 1584 \u0433\u043e\u0434\u0443 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445 \u0438\u043d\u0442\u0440\u0438\u0433
    \u0412\u0438\u0435\u0442\u0430 \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438\u043b\u0438
    \u043e\u0442 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u0438 \u0432\u044b\u0441\u043b\u0430\u043b\u0438
    \u0438\u0437 \u041f\u0430\u0440\u0438\u0436\u0430. \u042d\u0442\u043e\u0442 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u044b\u0439
    \u043e\u0442\u0434\u044b\u0445 \u0441\u0442\u0430\u043b \u043f\u0438\u043a\u043e\u043c \u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430. \u041e\u0431\u0440\u0435\u0442\u044f
    \u043f\u043e\u043a\u043e\u0439, \u043e\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u0435\u0440\u0435\u0434 \u0441\u043e\u0431\u043e\u0439 \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u0443\u044e
    \u0446\u0435\u043b\u044c: \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0430
    \u0431\u044b \u0440\u0435\u0448\u0430\u0442\u044c \u043b\u044e\u0431\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u041f\u043e \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c, \u043e\u043d \u0431\u044b\u043b
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d, \"\u0447\u0442\u043e \u0434\u043e\u043b\u0436\u043d\u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043e\u0431\u0449\u0430\u044f,
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0435\u0449\u0435 \u043d\u0430\u0443\u043a\u0430,
    \u043e\u0431\u043d\u0438\u043c\u0430\u044e\u0449\u0430\u044f \u0438 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u0435
    \u0438\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u043d\u043e\u0432\u0435\u0439\u0448\u0438\u0445
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0441\u0442\u043e\u0432, \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u044f
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445\". \u0418\u0442\u043e\u0433\u043e\u043c \u0435\u0433\u043e
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439 \u0441\u0442\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb (1591 \u0433\u043e\u0434).
    \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u0412\u0438\u0435\u0442
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443
    \u0441\u0432\u043e\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u043e\u0432\u044b\u0439
    \u044f\u0437\u044b\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u2014
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0443.
    \u0421\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u00ab\u0432\u0438\u0434\u043e\u0432\u043e\u0439 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u043e\u0439\u00bb.
    \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0438\u0434\u0435\u0435\u0439 \u0431\u044b\u043b\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0431\u0443\u043a\u0432 \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    (\u0433\u043b\u0430\u0441\u043d\u044b\u0435), \u043d\u043e \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d (\u0441\u043e\u0433\u043b\u0430\u0441\u043d\u044b\u0435).
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e: - \u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432 \u043e\u0431\u0449\u0435\u043c
    \u0432\u0438\u0434\u0435. - \u041e\u043f\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438, \u043f\u043e\u043b\u0443\u0447\u0430\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u044b\u0435
    \u043a \u043b\u044e\u0431\u044b\u043c \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430\u043c. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0430
    \u0431\u044b\u0442\u044c \u043d\u0430\u0443\u043a\u043e\u0439 \u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445 \u0438 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0430\u0441\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u043e \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438
    \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0439, \u0447\u0442\u043e \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u0424\u0435\u0440\u043c\u0430 \u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u0430.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u043e\u0431\u043d\u0430\u0440\u043e\u0434\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443,
    \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0449\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043d\u044f\u043c\u0438
    \u0438 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. \u0414\u043b\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0451 \u0442\u0430\u043a: \u00ab\u0415\u0441\u043b\u0438 B+D, \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u043d\u043e\u0435
    \u043d\u0430 \u0410, \u043c\u0438\u043d\u0443\u0441 \u0410 \u0432 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0435
    \u0440\u0430\u0432\u043d\u043e BD, \u0442\u043e \u0410 \u0440\u0430\u0432\u043d\u043e \u0412
    \u0438 \u0440\u0430\u0432\u043d\u043e D\u00bb. \u0422\u0435\u043f\u0435\u0440\u044c \u043e\u043d\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043a\u0430\u043a \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0412\u0438\u0435\u0442\u0430.\n\n\u2b50 \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0438 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430
    (1589\u20131594) \u0412 1589 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0433\u0438\u0431\u0435\u043b\u0438
    \u0413\u0435\u043d\u0440\u0438\u0445\u0430 \u0413\u0438\u0437\u0430, \u0412\u0438\u0435\u0442
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436.
    \u041e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0441\u043b\u0443\u0436\u0431\u0443,
    \u0441\u0442\u0430\u0432 \u043f\u0440\u0438 \u0413\u0435\u043d\u0440\u0438\u0445\u0435 IV
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u043d\u044b\u0445
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u0432. \u0422\u0435\u043c \u043d\u0435
    \u043c\u0435\u043d\u0435\u0435, \u043e\u043d \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u0443\u044e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c
    \u0435\u043c\u0443 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u043f\u043e\u0431\u0435\u0434\u0430
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0435\u0434\u0438\u043d\u043a\u0435. \u0412 1594 \u0433\u043e\u0434\u0443 \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0410\u0434\u0440\u0438\u0430\u043d
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u0431\u0440\u043e\u0441\u0438\u043b
    \u0432\u044b\u0437\u043e\u0432 \u0432\u0441\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u043c\u0438\u0440\u0430, \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u0432 \u0440\u0435\u0448\u0438\u0442\u044c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 45-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438.
    \u0412\u044b\u0437\u043e\u0432 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u043e\u043d
    \u043d\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443
    \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0442\u0430\u043c \u043d\u0435\u0442
    \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u0412\u0438\u0435\u0442, \u0443\u0437\u043d\u0430\u0432 \u043e\u0431 \u044d\u0442\u043e\u043c,
    \u0432 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043a\u043e\u0440\u043e\u043b\u044f
    \u0438 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445 \u043d\u0430\u0448\u0435\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u0438\u043d \u043a\u043e\u0440\u0435\u043d\u044c,
    \u043d\u043e \u0438 \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a \u0437\u0430\u0434\u0430\u0447\u0435
    \u043e \u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0443\u0433\u043b\u0430 \u043d\u0430
    45 \u0447\u0430\u0441\u0442\u0435\u0439. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u043d\u044b\u043c \u043f\u043e\u0447\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u043c.\n\n\U0001F3C6
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 \u0443\u043c\u0435\u0440
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 13 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1603 \u0433\u043e\u0434\u0430 (\u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c \u0434\u0430\u043d\u043d\u044b\u043c
    \u2014 14 \u0444\u0435\u0432\u0440\u0430\u043b\u044f ). \u0415\u043c\u0443 \u0431\u044b\u043b\u043e
    63 \u0433\u043e\u0434\u0430. \u0415\u0441\u0442\u044c \u043d\u0435\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u0435
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u0447\u0442\u043e
    \u043e\u043d \u043c\u043e\u0433 \u0441\u0442\u0430\u0442\u044c \u0436\u0435\u0440\u0442\u0432\u043e\u0439
    \u043d\u0430\u0441\u0438\u043b\u044c\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438.
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438
    \u2014 \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0438\u0439 \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00ab\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430,
    \u0438\u043b\u0438 \u041d\u043e\u0432\u0430\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u00bb
    \u2014 \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u043d\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u043c.
    \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u043b\u0438\u0448\u044c \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0435\u0433\u043e
    \u0447\u0430\u0441\u0442\u0438. \u041e\u0434\u043d\u0430\u043a\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0431\u044b\u043b\u043e \u0441\u0434\u0435\u043b\u0430\u043d\u043e: \u0412\u0438\u0435\u0442
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043d\u043e
    \u0438: - \u0414\u0430\u043b\u0435\u043a\u043e \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u043b
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e: \u043f\u0435\u0440\u0432\u044b\u043c
    \u044f\u0432\u043d\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u0438 \u0432\u044b\u0432\u0435\u043b \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u0441\u0438\u043d\u0443\u0441\u043e\u0432 \u0438 \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u043a\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u0433\u043b\u043e\u0432. - \u0420\u0435\u0448\u0438\u043b
    \u0434\u0440\u0435\u0432\u043d\u044e\u044e \u0437\u0430\u0434\u0430\u0447\u0443 \u0442\u0440\u0438\u0441\u0435\u043a\u0446\u0438\u0438
    \u0443\u0433\u043b\u0430, \u0441\u0432\u0435\u0434\u044f \u0435\u0435 \u043a \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e. - \u0412\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0447 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0440\u0435\u0448\u0438\u0432 \u0437\u0430\u0434\u0430\u0447\u0443
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f. - \u0412\u0432\u0435\u043b \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0445 \u0434\u0440\u043e\u0431\u0435\u0439
    \u0441 \u0437\u0430\u043f\u044f\u0442\u043e\u0439. \u0421\u0431\u043e\u0440\u043d\u0438\u043a
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432 \u0431\u044b\u043b \u0438\u0437\u0434\u0430\u043d
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e \u0432 1646 \u0433\u043e\u0434\u0443
    \u0432 \u041b\u0435\u0439\u0434\u0435\u043d\u0435."
  shortBioEn: "François Viet (1540–1603) was a French mathematician who was the founder of a symbolic algebra, who was a lawyer and a public figure in education and basic professions.\n\n==Early years and education=====Early years and education (1540–1560)=====Early years and education (1540–1560), François Veet was born in 1540 in the small town of Fontené-le-Cont in the province of Poito Sharant in southern France, where his father was a prosecutor, and his son chose the same path, and his mother, Margarita Dupont, came from a noble family, which in the future facilitated his career.He then entered the University of Poitier, where he received a bachelor &apos; s degree in 1560 (which was consistent with the beginning of the legal career).\n\n==Career==In 1564, Viet began to practice as a lawyer in his hometown, and in 1564, he became a secretary and teacher of the master's 12-year-old daughter Catherine, who became a teacher of the master's 12-year-old daughter, and in 1571, he became a teacher of the young lawyer.In the capital, he was able to learn more about the achievements of leading European mathematicians, to communicate with Professor Sorbonne Ramos, and to communicate with Italian mathematician Rafael Bombelli, and during this period he prepared a major work on the trigonometry \"Mathematic Canon\", which was published in Paris in 1579.\n\nIn 1571, Viet took up public service as an adviser to the Parliament and then as an adviser to King Henry III. In 1580, the King appointed him to the important post of Resetmaster, which gave him the power to supervise, on behalf of the monarch, the implementation of royal orders in the provinces and to suspend orders from the major fedads.In this post, Viet was known as an outstanding crypto analyst, and during the war with Spain, he was able to decipher a complex Spanish cipher that constantly changed and contained up to 600 different characters, and the French king was always aware of the plans of his opponents.\n\nIn 1584, Viet was removed from his office and expelled from Paris, and in 1584, he became the peak of his math, and in 1584, he set an ambitious goal: to create a comprehensive science that would meet all the challenges.He said that he was convinced that \"there should be a common, unknown science that grasps and witty conjectures of the latest algebraists and deep geometrical research of the ancients.\" His thinking led to his thinking on the famous tract \"Introduction to the Analytical Arts\" (1591), in which he outlined his research agenda and introduced the new language of mathematics, symbolic algebra, and called his system \"species logistics\".The main revolutionary idea was to use letters to indicate not only unknown (verbal) but also known values (consent), which allowed: - Write down algebraic expressions and equations in general. - Operate symbols with formulas applicable to any relevant values.So, math was no longer a science about specific numbers and turned into a science about the conversion of expressions, which laid the foundation for the work of Decart, Farm and Newton. It was during this period that he released his famous theorem, which established the relationship between roots and equation coefficients. For the square equation, he put it this way: \"If B+D times A minus A squared is BD, then A equals B and D.Now it's known as Viet's Theorem.\n\n* Return and world glory (1589–1594) In 1589, after the death of Henry Geese, he returned to Paris. He continued to serve with Henry IV as one of the closest advisers. However, he did not leave math classes. He was well known for winning a math match. In 1594, Dutch mathematician Adrian van Rowman challenged all the mathematicians in the world by proposing a 45th degree equation.He did not send a challenge to France because he thought there were no decent mathematicians there, and Viet found not only one root in the presence of the king and the courtiers, but all others, showing that the equation was a 45-part problem, and that van Rowman was a zealous admirer of him.\n\nHe died in Paris on December 13, 1603 (on February 14, 1603) and was 63 years old. There are unconfirmed assumptions that he may have been the victim of violent death. His main work — a comprehensive tract called \"The Art of Analysis, or New Algebra\" — has not been completed.However, the main thing was done: Viet not only created a new symbolic language for mathematics, but also: - Faraway advanced trigonometry: first clearly formulated the cosine theorem and produced expressions for sinus and cosine angles with multiple angles. - Solved the ancient task of trisection of the angle by reducing it to a cubic equation. - He contributed to the problems of geometry by partially solving the task of Apollonia. - I introduced the designation of decimals with a decimal point.His book was published posthumously in 1646 in Leiden."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442\u0430
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u043f\u043e\u0445\u043e\u0436\u0435\u0439 \u043d\u0430 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0439
    \u0440\u043e\u043c\u0430\u043d. \u041e\u0442 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430 \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0433\u043e
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0442\u0440\u0438\u0443\u043c\u0444\u0430 \u0434\u043e \u043f\u043e\u0431\u0435\u0434\u044b
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0443\u044d\u043b\u0438 \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \u2014 \u0435\u0433\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0438\u0437\u043e\u0431\u0438\u043b\u0443\u0435\u0442 \u044f\u0440\u043a\u0438\u043c\u0438,
    \u0430 \u043f\u043e\u0440\u043e\u0439 \u0438 \u043a\u0443\u0440\u044c\u0451\u0437\u043d\u044b\u043c\u0438
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430\u043c\u0438.\n\n\U0001F575\ufe0f\u200d\u2642\ufe0f
    \u041f\u043e\u0431\u0435\u0434\u0430 \u043d\u0430\u0434 \u00ab\u043d\u0435\u0447\u0438\u0442\u0430\u0435\u043c\u044b\u043c\u00bb
    \u0448\u0438\u0444\u0440\u043e\u043c \u0438 \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0435
    \u0432 \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u0435 \u041f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u044b\u0439 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0439
    \u0444\u0430\u043a\u0442 \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0412\u0438\u0435\u0442\u0430
    \u2014 \u044d\u0442\u043e \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u043a\u0440\u0438\u043f\u0442\u043e\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u043e\u043c.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0439\u043d\u044b \u0441 \u0418\u0441\u043f\u0430\u043d\u0438\u0435\u0439
    \u043e\u043d \u0441\u0443\u043c\u0435\u043b \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u0442\u044c
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u0424\u0438\u043b\u0438\u043f\u043f\u0430 II \u0441
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044f\u043c\u0438
    \u0432 \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0430\u0445. \u0421\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0439
    \u043a\u043e\u0434: \u0418\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0439 \u0448\u0438\u0444\u0440
    \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0441\u043b\u043e\u0436\u043d\u044b\u043c
    \u2014 \u043e\u043d \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b \u0434\u043e 600 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0437\u043d\u0430\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u044f\u043b\u0438\u0441\u044c.
    \u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e
    \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c. \u041e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0435
    \u0432 \u043c\u0430\u0433\u0438\u0438: \u041a\u043e\u0433\u0434\u0430 \u0438\u0441\u043f\u0430\u043d\u0446\u044b
    \u0443\u0437\u043d\u0430\u043b\u0438, \u0447\u0442\u043e \u0438\u0445 \u0442\u0430\u0439\u043d\u044b\u0439
    \u043a\u043e\u0434 \u0440\u0430\u0437\u0433\u0430\u0434\u0430\u043d, \u043e\u043d\u0438
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u0432\u0435\u0440\u0438\u0442\u044c
    \u0432 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0437\u0430\u043e\u0447\u043d\u043e \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438
    \u0412\u0438\u0435\u0442\u0430... \u043a \u0441\u043e\u0436\u0436\u0435\u043d\u0438\u044e
    \u043d\u0430 \u043a\u043e\u0441\u0442\u0440\u0435, \u043e\u0431\u0432\u0438\u043d\u0438\u0432
    \u0432 \u0441\u043e\u044e\u0437\u0435 \u0441 \u0434\u044c\u044f\u0432\u043e\u043b\u043e\u043c
    \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u0447\u0451\u0440\u043d\u043e\u0439
    \u043c\u0430\u0433\u0438\u0438! \u0422\u0440\u0443\u0434\u043e\u0433\u043e\u043b\u0438\u0437\u043c:
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438
    \u0435\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c.
    \u0420\u0430\u0434\u0438 \u0440\u0430\u0437\u0433\u0430\u0434\u043a\u0438 \u0448\u0438\u0444\u0440\u0430
    \u0438\u043b\u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043e\u043d \u043c\u043e\u0433 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043f\u043e \u0442\u0440\u043e\u0435 \u0441\u0443\u0442\u043e\u043a \u0431\u0435\u0437
    \u0441\u043d\u0430.\n\n\U0001F3C6 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0434\u0443\u044d\u043b\u044c: \u043a\u0430\u043a \u0412\u0438\u0435\u0442 \u00ab\u0443\u0442\u0435\u0440
    \u043d\u043e\u0441\u00bb \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0446\u0443 \u0412\u0442\u043e\u0440\u043e\u0439
    \u043f\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u044d\u043f\u0438\u0437\u043e\u0434
    \u2014 \u044d\u0442\u043e \u0435\u0433\u043e \u0442\u0440\u0438\u0443\u043c\u0444 \u0432
    \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u0441\u0442\u0430\u0442\u044c \u043c\u0438\u0440\u043e\u0432\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0432\u044b\u0437\u043e\u0432\u043e\u043c. \u0414\u0435\u0440\u0437\u043a\u0438\u0439 \u0432\u044b\u0437\u043e\u0432:
    \u0412 1594 \u0433\u043e\u0434\u0443 \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0410\u0434\u0440\u0438\u0430\u043d
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0440\u0435\u0448\u0438\u0442\u044c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    45-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u0440\u0430\u0437\u043e\u0441\u043b\u0430\u0432
    \u0435\u0433\u043e \u0432\u0441\u0435\u043c \u0432\u0435\u0434\u0443\u0449\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u0415\u0432\u0440\u043e\u043f\u044b, \u043d\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0432
    \u0424\u0440\u0430\u043d\u0446\u0438\u044e, \u0442\u0430\u043a \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0442\u0430\u043c \u043d\u0435\u0442 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445. \u041e\u0442\u0432\u0435\u0442 \u043a\u043e\u0440\u043e\u043b\u044f:
    \u0413\u0435\u043d\u0440\u0438\u0445 IV, \u0443\u0437\u043d\u0430\u0432 \u043e\u0431 \u044d\u0442\u043e\u043c,
    \u0437\u0430\u044f\u0432\u0438\u043b \u043d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u043c\u0443
    \u043f\u043e\u0441\u043b\u0443, \u0447\u0442\u043e \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u0435\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0438
    \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b \u0412\u0438\u0435\u0442\u0430. \u0411\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435: \u041d\u0430 \u043f\u0440\u0438\u0451\u043c\u0435
    \u0443 \u043a\u043e\u0440\u043e\u043b\u044f \u0412\u0438\u0435\u0442 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0430\u0448\u0451\u043b \u043e\u0434\u0438\u043d \u043a\u043e\u0440\u0435\u043d\u044c,
    \u0430 \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0435 \u043e \u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0443\u0433\u043b\u0430,
    \u0438 \u043d\u0430\u0448\u0451\u043b \u0432\u0441\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043a\u043e\u0440\u043d\u0438. \u041d\u0430\u0434\u043f\u0438\u0441\u044c-\u043f\u0438\u043d-\u043a\u043e\u0434:
    \u041f\u043e\u043a\u0440\u044b\u0432\u0430\u044f \u0441\u0432\u043e\u0451 \u0440\u0435\u0448\u0435\u043d\u0438\u0435,
    \u0412\u0438\u0435\u0442 \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e
    \u043a\u0430\u043a: \"\u0423\u0432\u0438\u0434\u0435\u0432 \u2014 \u0440\u0435\u0448\u0438\u043b\".
    \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u0436\u0451\u043d\u043d\u044b\u0439
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u043d\u044b\u043c \u043f\u043e\u0447\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u043c.\n\n\U0001F4D6
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u00ab\u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f
    \u0413\u0430\u043b\u043b\u044c\u0441\u043a\u043e\u0433\u043e\u00bb \u0438 \u0437\u0430\u0433\u0430\u0434\u043a\u0430
    \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0430 \u0421\u0432\u043e\u0451 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435
    \u043a \u0434\u0440\u0435\u0432\u043d\u0435\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0412\u0438\u0435\u0442 \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438
    \u0435\u0449\u0451 \u043e\u0434\u043d\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438. \u0417\u0430\u0434\u0430\u0447\u0430 \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f:
    \u0412\u0438\u0435\u0442 \u0440\u0435\u0448\u0438\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f
    \u041f\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e \u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0438
    \u043a\u0440\u0443\u0433\u0430, \u043a\u0430\u0441\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u0442\u0440\u0451\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u043e\u0432.
    \u0413\u043e\u0440\u0434\u043e\u0435 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435: \u041e\u043d
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0433\u043e\u0440\u0434\u0438\u043b\u0441\u044f
    \u044d\u0442\u0438\u043c \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c,
    \u0447\u0442\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438,
    \u043e\u0442\u043c\u0435\u0447\u0430\u044f \u0435\u0433\u043e \u0437\u0430\u0441\u043b\u0443\u0433\u0438,
    \u0434\u0430\u043b\u0438 \u0435\u043c\u0443 \u043f\u043e\u0447\u0451\u0442\u043d\u043e\u0435
    \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435 \u00ab\u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u0439
    \u0413\u0430\u043b\u043b\u044c\u0441\u043a\u0438\u0439\u00bb (\u0442.\u0435. \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u0439).\n\n\u2696\ufe0f \u0422\u043e\u043d\u043a\u0430\u044f
    \u0433\u0440\u0430\u043d\u044c \u0432\u0435\u0440\u044b: \u043a\u0430\u0442\u043e\u043b\u0438\u043a
    \u0441\u0440\u0435\u0434\u0438 \u0433\u0443\u0433\u0435\u043d\u043e\u0442\u043e\u0432 \u0412
    \u0440\u0430\u0437\u0433\u0430\u0440 \u0436\u0435\u0441\u0442\u043e\u043a\u0438\u0445 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0445
    \u0432\u043e\u0439\u043d \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u0412\u0438\u0435\u0442
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0443\u044e
    \u043f\u043e\u0437\u0438\u0446\u0438\u044e. \u0412\u0435\u0440\u043e\u0442\u0435\u0440\u043f\u0438\u043c\u043e\u0441\u0442\u044c:
    \u041e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0438 \u0431\u043e\u043b\u044c\u0448\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438 \u043f\u0440\u043e\u0436\u0438\u043b
    \u0441\u0440\u0435\u0434\u0438 \u0433\u0443\u0433\u0435\u043d\u043e\u0442\u043e\u0432 (\u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0445
    \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u043e\u0432), \u043d\u043e
    \u0441\u0430\u043c \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u043a\u0430\u0442\u043e\u043b\u0438\u043a\u043e\u043c.
    \u041f\u043e-\u0432\u0438\u0434\u0438\u043c\u043e\u043c\u0443, \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435
    \u0440\u0430\u0437\u043d\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u0435\u0433\u043e \u043f\u043e\u0447\u0442\u0438
    \u043d\u0435 \u0432\u043e\u043b\u043d\u043e\u0432\u0430\u043b\u0438, \u0438 \u043e\u043d
    \u0441\u0443\u043c\u0435\u043b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0442\u0435\u0442.
    \u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c \u0440\u0435\u0437\u043d\u0438: \u0412
    \u0412\u0430\u0440\u0444\u043e\u043b\u043e\u043c\u0435\u0435\u0432\u0441\u043a\u0443\u044e
    \u043d\u043e\u0447\u044c 1572 \u0433\u043e\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u043a\u0430\u0442\u043e\u043b\u0438\u043a\u0438
    \u0443\u0441\u0442\u0440\u043e\u0438\u043b\u0438 \u043c\u0430\u0441\u0441\u043e\u0432\u0443\u044e
    \u0440\u0435\u0437\u043d\u044e \u0433\u0443\u0433\u0435\u043d\u043e\u0442\u043e\u0432, \u043f\u043e\u0433\u0438\u0431\u043b\u0438
    \u0435\u0433\u043e \u0434\u0440\u0443\u0433-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0420\u0430\u043c\u0443\u0441 \u0438 \u043c\u0443\u0436 \u0435\u0433\u043e \u0431\u044b\u0432\u0448\u0435\u0439
    \u0443\u0447\u0435\u043d\u0438\u0446\u044b. \u0412\u0438\u0435\u0442 \u0447\u0443\u0434\u043e\u043c
    \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0442\u0443 \u043d\u043e\u0447\u044c, \u0447\u0442\u043e
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442
    \u043e \u0435\u0433\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c
    \u0432\u0435\u0437\u0435\u043d\u0438\u0438 \u0438\u043b\u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u0432\u043d\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430.\n\n\U0001F4A1
    \u0417\u0430\u0431\u0430\u0432\u043d\u044b\u0435 \u0438 \u043c\u0430\u043b\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435
    \u0434\u0435\u0442\u0430\u043b\u0438 \u00ab\u041d\u0435\u0441\u0435\u0440\u044c\u0451\u0437\u043d\u044b\u0439\u00bb
    \u0443\u0447\u0451\u043d\u044b\u0439: \u0421\u0430\u043c \u0412\u0438\u0435\u0442 \u043d\u0435
    \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0435\u0431\u044f \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c. \u041e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043d\u0430\u0443\u043a\u043e\u0439
    \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0434\u043b\u044f \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f, \u0438 \u0438\u0437\u0434\u0430\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0442\u0440\u0443\u0434\u044b \u0437\u0430 \u0441\u0432\u043e\u0439
    \u0441\u0447\u0451\u0442. \u0417\u0430\u043f\u044f\u0442\u0430\u044f \u0434\u043b\u044f
    \u0434\u0440\u043e\u0431\u0435\u0439: \u0412\u0438\u0435\u0442 \u043f\u0435\u0440\u0432\u044b\u043c
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u0437\u0430\u043f\u044f\u0442\u0443\u044e \u0434\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0438
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0445 \u0434\u0440\u043e\u0431\u0435\u0439.
    \u0414\u043e \u043d\u0435\u0433\u043e \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043a\u0440\u0430\u0439\u043d\u0435
    \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u043e (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    0,3469 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u043e\u0441\u044c \u043a\u0430\u043a
    3(1)4(2)6(3)9(4)). \u0422\u0435\u043e\u0440\u0435\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u0437\u043d\u0430\u043b\u0438 \u0434\u043e \u043d\u0435\u0433\u043e: \u041a\u0430\u043a
