    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0441\u0432\u043e\u0435\u0439 \u043d\u043e\u0432\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b, \u0437\u0430 \u0447\u0442\u043e \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043c\u0438\u0440\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435.\n\n\U0001F56F\ufe0f
