    \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430\u0443\u043A\u043E\u0439 \u0432 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F, \u0438
    \u0438\u0437\u0434\u0430\u0432\u0430\u043B \u0441\u0432\u043E\u0438 \u0442\u0440\u0443\u0434\u044B
    \u0437\u0430 \u0441\u0432\u043E\u0439 \u0441\u0447\u0451\u0442. *   **\u0417\u0430\u043F\u044F\u0442\u0430\u044F
    \u0434\u043B\u044F \u0434\u0440\u043E\u0431\u0435\u0439:** \u0412\u0438\u0435\u0442
    \u043F\u0435\u0440\u0432\u044B\u043C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C **\u0437\u0430\u043F\u044F\u0442\u0443\u044E**
    \u0434\u043B\u044F \u0437\u0430\u043F\u0438\u0441\u0438 \u0434\u0435\u0441\u044F\u0442\u0438\u0447\u043D\u044B\u0445
    \u0434\u0440\u043E\u0431\u0435\u0439. \u0414\u043E \u043D\u0435\u0433\u043E \u044D\u0442\u043E
    \u0431\u044B\u043B\u043E \u043A\u0440\u0430\u0439\u043D\u0435 \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u043A\u043E
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, 0,3469 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u043E\u0441\u044C
    \u043A\u0430\u043A 3(1)4(2)6(3)9(4)). *   **\u0422\u0435\u043E\u0440\u0435\u043C\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0437\u043D\u0430\u043B\u0438 \u0434\u043E
    \u043D\u0435\u0433\u043E:** \u041A\u0430\u043A \u043D\u0438 \u043F\u0430\u0440\u0430\u0434\u043E\u043A\u0441\u0430\u043B\u044C\u043D\u043E,
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0430\u044F \u0442\u0435\u043E\u0440\u0435\u043C\u0430
    \u0412\u0438\u0435\u0442\u0430 \u0431\u044B\u043B\u0430 \u0432 \u0447\u0430\u0441\u0442\u043D\u044B\u0445
    \u0441\u043B\u0443\u0447\u0430\u044F\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430
    \u0435\u0449\u0451 \u0434\u0440\u0435\u0432\u043D\u0438\u043C \u0432\u0430\u0432\u0438\u043B\u043E\u043D\u044F\u043D\u0430\u043C,
    \u0430 \u043F\u043E\u0437\u0436\u0435 \u2014 \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0446\u0443
    \u041A\u0430\u0440\u0434\u0430\u043D\u043E. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0437\u0430\u0441\u043B\u0443\u0433\u0430 \u0412\u0438\u0435\u0442\u0430 \u0432
    \u0442\u043E\u043C, \u0447\u0442\u043E \u043E\u043D **\u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u044B\u0432\u0435\u043B \u0435\u0451 \u0432 \u043E\u0431\u0449\u0435\u043C
    \u0432\u0438\u0434\u0435** \u0438 \u0441\u0434\u0435\u043B\u0430\u043B \u043E\u0441\u043D\u043E\u0432\u043E\u0439
    \u0441\u0432\u043E\u0435\u0439 \u043D\u043E\u0432\u043E\u0439 \u0430\u043B\u0433\u0435\u0431\u0440\u044B,
    \u0437\u0430 \u0447\u0442\u043E \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u043C\u0438\u0440\u043E\u0432\u043E\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435. 
    ### \U0001F56F\uFE0F \u0417\u0430\u0433\u0430\u0434\u043A\u0430 \u0441\u043C\u0435\u0440\u0442\u0438 
    \u0421\u043C\u0435\u0440\u0442\u044C \u0412\u0438\u0435\u0442\u0430 \u043E\u043A\u0443\u0442\u0430\u043D\u0430
    \u0442\u0443\u043C\u0430\u043D\u043D\u043E\u0439 \u0442\u0430\u0439\u043D\u043E\u0439.
    \u0412 \u043F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u044B\u0445 \u0445\u0440\u043E\u043D\u0438\u043A\u0430\u0445
    \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E, \u0447\u0442\u043E \u043E\u043D
    \u0443\u043C\u0435\u0440 \u0432 \u041F\u0430\u0440\u0438\u0436\u0435 \u0432 \u0444\u0435\u0432\u0440\u0430\u043B\u0435
    1603 \u0433\u043E\u0434\u0430 \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    \u0431\u043E\u043B\u0435\u0435 60 \u043B\u0435\u0442. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0442 **\u043D\u0435\u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043D\u043D\u044B\u0435
    \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u044F, \u0447\u0442\u043E
    \u043E\u043D \u0431\u044B\u043B \u0443\u0431\u0438\u0442**. \u0415\u0441\u043B\u0438
    \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u044D\u0442\u043E \u0431\u044B\u043B\u0430 \u043C\u0435\u0441\u0442\u044C \u0438\u0441\u043F\u0430\u043D\u0446\u0435\u0432
    \u0437\u0430 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0443
    \u0438\u0445 \u0448\u0438\u0444\u0440\u0430 \u0438\u043B\u0438 \u043C\u0435\u0441\u0442\u044C
    \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u044B\u0445 \u0444\u0430\u043D\u0430\u0442\u0438\u043A\u043E\u0432
    \u0437\u0430 \u0435\u0433\u043E \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u0443\u044E
    \u043F\u043E\u0437\u0438\u0446\u0438\u044E.  \u042D\u0442\u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u0434\u0435\u043B\u0430\u044E\u0442 \u0424\u0440\u0430\u043D\u0441\u0443\u0430
    \u0412\u0438\u0435\u0442\u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u0443\u0445\u0438\u043C \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u043E\u043C
    \u0438\u0437 \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0430, \u0430 \u0436\u0438\u0432\u044B\u043C
    \u0433\u0435\u0440\u043E\u0435\u043C \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u2014 \u044E\u0440\u0438\u0441\u0442\u043E\u043C, \u0448\u043F\u0438\u043E\u043D\u043E\u043C,
    \u0434\u0443\u044D\u043B\u044F\u043D\u0442\u043E\u043C \u043E\u0442 \u043D\u0430\u0443\u043A\u0438
    \u0438 \u043E\u0442\u0446\u043E\u043C \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438."
