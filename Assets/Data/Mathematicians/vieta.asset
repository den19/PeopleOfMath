  fullNameRu: "\u0424\u0440\u0430\u043D\u0441\u0443\u0430\u0301 \u0412\u0438\u0435\u0301\u0442,
    \u0441\u0435\u043D\u044C\u043E\u0440 \u0434\u0435 \u043B\u044F \u0411\u0438\u0433\u043E\u0442\u044C\u0435\u0440"
