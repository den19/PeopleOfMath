    \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0441 \u0435\u0435 \u0441\u0435\u043c\u044c\u0435\u0439
    \u0438 \u043e\u043a\u043e\u043b\u043e 1571 \u0433\u043e\u0434\u0430 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0441 \u043d\u0438\u043c\u0438 \u0432 \u041f\u0430\u0440\u0438\u0436. \u0412 \u0441\u0442\u043e\u043b\u0438\u0446\u0435
    \u043e\u043d \u0441\u043c\u043e\u0433 \u0431\u043b\u0438\u0436\u0435 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0415\u0432\u0440\u043e\u043f\u044b,
    \u043e\u0431\u0449\u0430\u0442\u044c\u0441\u044f \u0441 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
