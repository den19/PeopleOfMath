  achievementsRu: "\u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0438\u0437 \u043d\u0430\u0431\u043e\u0440\u0430
    \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0432 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447 \u0432 \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u043d\u0430\u0443\u043a\u0443
    \u043e \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u0445 \u0438 \u043e\u0431\u0449\u0438\u0445
    \u0437\u0430\u043a\u043e\u043d\u0430\u0445. \u0415\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\n\U0001F4D0 1. \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b
    (\u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u0435\u043b\u043e \u0436\u0438\u0437\u043d\u0438)
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434 \u0412\u0438\u0435\u0442\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e \u043f\u0440\u0430\u0432\u0443 \u0441\u0434\u0435\u043b\u0430\u043b
    \u0435\u0433\u043e \"\u043e\u0442\u0446\u043e\u043c \u0430\u043b\u0433\u0435\u0431\u0440\u044b\",
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e \u043d\u043e\u0432\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430. \u00ab\u0412\u0438\u0434\u043e\u0432\u043e\u0435\u00bb \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435:
    \u0421\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u00ab\u0432\u0438\u0434\u043e\u0432\u043e\u0439 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u043e\u0439\u00bb
    (logistica speciosa), \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u0435\u0451 \u00ab\u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u0435\u00bb
    (\u0440\u0430\u0431\u043e\u0442\u0435 \u0441 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u043c\u0438
    \u0447\u0438\u0441\u043b\u0430\u043c\u0438). \u041f\u043e\u0434 \u00ab\u0432\u0438\u0434\u0430\u043c\u0438\u00bb
    \u043e\u043d \u043f\u043e\u043d\u0438\u043c\u0430\u043b \u043d\u0435 \u0447\u0438\u0441\u043b\u0430,
    \u0430 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b \u2014 \u0434\u043b\u0438\u043d\u044b, \u043f\u043b\u043e\u0449\u0430\u0434\u0438,
    \u043e\u0431\u044a\u0435\u043c\u044b \u0438 \u0442.\u0434.. \u041d\u043e\u0432\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439:
    \u0412\u0438\u0435\u0442 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c
    \u0431\u0443\u043a\u0432\u0430\u043c\u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435, \u043d\u043e \u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b
    (\u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u044b). \u0414\u043b\u044f
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0433\u043b\u0430\u0441\u043d\u044b\u0435 \u0431\u0443\u043a\u0432\u044b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    `A`, `E`). \u0414\u043b\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 (\u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u043e\u0432)
    \u2014 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u044b\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    `B`, `C`, `D`). \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430: \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u044d\u0442\u043e\u043c\u0443 \u0441\u0442\u0430\u043b\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u0438 \u0437\u0430\u043a\u043e\u043d\u044b \u0432 \u043e\u0431\u0449\u0435\u043c \u0432\u0438\u0434\u0435,
    \u0442\u043e \u0435\u0441\u0442\u044c \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u044b\u0435
    \u043a \u0446\u0435\u043b\u043e\u043c\u0443 \u043a\u043b\u0430\u0441\u0441\u0443 \u0437\u0430\u0434\u0430\u0447.
    \u0412\u043d\u0435\u0434\u0440\u0435\u043d\u0438\u0435 \u044d\u0442\u043e\u0439 \u0438\u0434\u0435\u0438
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b\u043e \u043f\u043e\u0447\u0432\u0443
    \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442 \u0414\u0435\u043a\u0430\u0440\u0442\u0430
    \u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u0430. > \u041f\u0440\u0438\u043c\u0435\u0440
    \u0438\u0437 \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u0430: \u0412 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb
    (1591) \u0412\u0438\u0435\u0442 \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043b
    \u0441\u0438\u043b\u0443 \u043d\u043e\u0432\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430.
    \u041e\u043d \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u0437\u0430\u0434\u0430\u0447\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u043d\u044c\u0448\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438\u0441\u044c
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u043c\u0438, \u0442\u0435\u043f\u0435\u0440\u044c
    \u00ab\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043b\u0435\u0433\u043a\u043e
    \u0440\u0435\u0448\u0430\u044e\u0442\u0441\u044f \u0434\u0435\u0441\u044f\u0442\u043a\u0430\u043c\u0438
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043d\u0430\u0448\u0435\u0433\u043e \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430\u00bb.\n\n\U0001F4DD
    2. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0412\u0438\u0435\u0442\u0430 \u0438 \u043e\u0431\u0449\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0412 \u0442\u043e\u043c \u0436\u0435 1591 \u0433\u043e\u0434\u0443 \u0412\u0438\u0435\u0442
    \u043e\u0431\u043d\u0430\u0440\u043e\u0434\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u0443.
    \u0421\u0443\u0442\u044c \u0442\u0435\u043e\u0440\u0435\u043c\u044b: \u041e\u043d\u0430
    \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043d\u044f\u043c\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0438 \u0435\u0433\u043e \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438.
    \u0414\u043b\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    `Ax\u00b2 - Bx + D = 0` \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e \u0442\u0430\u043a: \u00ab\u0415\u0441\u043b\u0438 B+D, \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u043d\u043e\u0435
    \u043d\u0430 \u0410, \u043c\u0438\u043d\u0443\u0441 \u0410 \u0432 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0435
    \u0440\u0430\u0432\u043d\u043e BD, \u0442\u043e \u0410 \u0440\u0430\u0432\u043d\u043e \u0412
    \u0438 \u0440\u0430\u0432\u043d\u043e D\u00bb. \u042d\u0442\u0430 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0432\u0435\u0440\u043d\u0430 \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u043e\u0432
    \u043b\u044e\u0431\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u041e\u0431\u0449\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434 \u0440\u0435\u0448\u0435\u043d\u0438\u044f: \u0412\u0438\u0435\u0442\u0443
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435
    \u0435\u0434\u0438\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0430
    \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    2-\u0439, 3-\u0439 \u0438 4-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439. \u041e\u043d
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434\u044b
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u0430\u043c\u0435\u043d\u0443 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445.\n\n\U0001F53A
    3. \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0432 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0412\u0438\u0435\u0442 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u043b \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e,
    \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u0432 \u0435\u0451 \u0441
    \u0430\u043b\u0433\u0435\u0431\u0440\u043e\u0439. \u0420\u0435\u0448\u0435\u043d\u0438\u0435
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432: \u041e\u043d
    \u0434\u0430\u043b \u043f\u043e\u043b\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043e\u0431 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u0432\u0441\u0435\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u043f\u043b\u043e\u0441\u043a\u043e\u0433\u043e
    \u0438\u043b\u0438 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 \u043f\u043e \u0442\u0440\u0435\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c. \u041e\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u044f\u0432\u043d\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u0432 \u0441\u043b\u043e\u0432\u0435\u0441\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435.
    \u0424\u043e\u0440\u043c\u0443\u043b\u044b \u043a\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u0433\u043b\u043e\u0432:
    \u0412\u0438\u0435\u0442 \u043f\u0435\u0440\u0432\u044b\u043c \u0432\u044b\u0432\u0435\u043b
    \u043e\u0431\u0449\u0438\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0434\u043b\u044f
    \u0441\u0438\u043d\u0443\u0441\u043e\u0432 \u0438 \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u043a\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u0433\u043b\u043e\u0432 (`sin n\u0445`
    \u0438 `cos n\u0445`) \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    `sin \u0445` \u0438 `cos \u0445`. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u043a\u043b\u044e\u0447\u043e\u043c \u043a \u0435\u0433\u043e
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u043c\u0443 \u0443\u0441\u043f\u0435\u0445\u0443.\n\n\U0001F3C6
    4. \u0422\u0440\u0438\u0443\u043c\u0444: \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d\u0430 \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u0443\u044e
    \u0441\u043b\u0430\u0432\u0443 \u0412\u0438\u0435\u0442\u0443 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430
    \u043f\u043e\u0431\u0435\u0434\u0430 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0435\u0434\u0438\u043d\u043a\u0435 1594 \u0433\u043e\u0434\u0430. \u0412\u044b\u0437\u043e\u0432:
    \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0410\u0434\u0440\u0438\u0430\u043d \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0440\u0435\u0448\u0438\u0442\u044c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 45-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438,
    \u0440\u0430\u0437\u043e\u0441\u043b\u0430\u0432 \u0432\u044b\u0437\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u0415\u0432\u0440\u043e\u043f\u044b, \u043d\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0432
    \u0424\u0440\u0430\u043d\u0446\u0438\u044e, \u0442\u0430\u043a \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u043b
    \u0442\u0430\u043c\u043e\u0448\u043d\u0438\u0445 \u0443\u0447\u0451\u043d\u044b\u0445 \u043d\u0435\u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u043c\u0438.
    \u041e\u0442\u0432\u0435\u0442: \u0412\u0438\u0435\u0442, \u0443\u0437\u043d\u0430\u0432
    \u043e\u0431 \u044d\u0442\u043e\u043c, \u0432 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438
    \u043a\u043e\u0440\u043e\u043b\u044f \u0413\u0435\u043d\u0440\u0438\u0445\u0430 IV \u043d\u0430\u0448\u0451\u043b
    \u043d\u0435 \u043e\u0434\u0438\u043d, \u0430 \u0432\u0441\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043a\u043e\u0440\u043d\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. \u041c\u0435\u0442\u043e\u0434:
    \u041e\u043d \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u044d\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a \u0437\u0430\u0434\u0430\u0447\u0435
    \u043e \u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0443\u0433\u043b\u0430 \u043d\u0430
    45 \u0447\u0430\u0441\u0442\u0435\u0439, \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0441\u0432\u043e\u0439 \u043c\u043e\u0449\u043d\u044b\u0439 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0442\u043e\u0434. \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u043a\u0430\u043a \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043d\u0435\u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043c\u044b\u0445
    \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u043c\u043e\u0436\u043d\u043e \u0441\u0432\u0435\u0441\u0442\u0438 \u043a \u0442\u0440\u0438\u0441\u0435\u043a\u0446\u0438\u0438
    \u0443\u0433\u043b\u0430, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b.\n\n\U0001F4A1 5. \u0414\u0440\u0443\u0433\u0438\u0435
    \u0432\u0430\u0436\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u041f\u043e\u043c\u0438\u043c\u043e \u044d\u0442\u043e\u0433\u043e, \u0412\u0438\u0435\u0442
    \u0441\u0434\u0435\u043b\u0430\u043b \u0440\u044f\u0434 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439:
    \u0411\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0438 \u0447\u0438\u0441\u043b\u043e \u03c0: \u041e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435
    \u043f\u0440\u0438\u0432\u0451\u043b \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043a\u0430\u043a
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0430
    \u03c0. \u042d\u0442\u043e \u0431\u044b\u043b \u043e\u0434\u0438\u043d \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432 \u0442\u0430\u043a\u043e\u0433\u043e \u0440\u043e\u0434\u0430
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0410\u043d\u0430\u043b\u0438\u0437
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445 \u0437\u0430\u0434\u0430\u0447: \u041e\u043d
    \u0434\u0430\u043b \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f \u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0438
    \u043a\u0440\u0443\u0433\u0430, \u043a\u0430\u0441\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u0442\u0440\u0451\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u043e\u0432
    (\u0432 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u00ab\u0413\u0430\u043b\u043b\u044c\u0441\u043a\u0438\u0439
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u0439\u00bb, 1600). \u041f\u0440\u0438\u0431\u043b\u0438\u0436\u0451\u043d\u043d\u044b\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f: \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u0434\u043b\u044f \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0451\u043d\u043d\u043e\u0433\u043e
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0441 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u043c\u0438
    \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b \u0431\u043e\u043b\u0435\u0435
    \u043f\u043e\u0437\u0434\u043d\u0438\u0439 \u043c\u0435\u0442\u043e\u0434 \u041d\u044c\u044e\u0442\u043e\u043d\u0430.
    \u0422\u0430\u043a\u0436\u0435 \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0435 \u0434\u0440\u043e\u0431\u0438
    \u0432 \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0430\u0431\u043b\u0438\u0446\u0430\u0445.\n\n\U0001F4DA \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u0411\u043e\u043b\u044c\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u044c
    \u0440\u0430\u0431\u043e\u0442 \u0412\u0438\u0435\u0442\u0430 \u0431\u044b\u043b\u0430 \u0438\u0437\u0434\u0430\u043d\u0430
    \u043b\u0438\u0448\u044c \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438.
    \u0421\u0440\u0435\u0434\u0438 \u043d\u0438\u0445 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c:
    \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb (1591) \u2014 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u044b\u0439
    \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442 \u0435\u0433\u043e \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u0430\u043d\u043e\u043d\u00bb (1579) \u2014 \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u043f\u043e \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439 \u0442\u0430\u0431\u043b\u0438\u0446\u044b.
    \u00ab\u0413\u0430\u043b\u043b\u044c\u0441\u043a\u0438\u0439 \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u0439\u00bb
    (1600) \u2014 \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0435
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f. \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u0438\u044f \u0412\u0438\u0435\u0442\u0430\u00bb
    (1646) \u2014 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u0442\u0440\u0443\u0434\u043e\u0432, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0435
    \u0432 \u041b\u0435\u0439\u0434\u0435\u043d\u0435 \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0424\u0440\u0430\u043d\u0441\u043e\u043c \u0432\u0430\u043d \u0421\u0445\u043e\u0442\u0435\u043d\u043e\u043c.\n\n\U0001F48E
    \u0418\u0442\u043e\u0433 \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442
    \u0441\u0442\u0430\u043b \u0442\u0435\u043c \u0442\u0438\u0442\u0430\u043d\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u0435\u043b \u0430\u043b\u0433\u0435\u0431\u0440\u0443
    \u0441 \u044f\u0437\u044b\u043a\u0430 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u043d\u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439
    \u044f\u0437\u044b\u043a \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432. \u0415\u0433\u043e
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u2014 \u043e\u0442 \u0432\u0441\u0435\u043c
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0434\u043e \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u2014 \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0432\u044b\u0440\u043e\u0441\u043b\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u041d\u043e\u0432\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0438 \u0435\u0433\u043e \u043f\u043e \u043f\u0440\u0430\u0432\u0443
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438."
  achievementsEn: 
  personalLifeRu: "\u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 \u043f\u0440\u043e\u0436\u0438\u043b
    \u0434\u043e\u043b\u0433\u0443\u044e \u0438 \u0431\u0443\u0440\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c,
    \u043f\u043e\u043b\u043d\u0443\u044e \u043a\u0440\u0443\u0442\u044b\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432.
    \u041e\u043d \u0443\u0441\u043f\u0435\u043b \u043f\u043e\u0431\u044b\u0432\u0430\u0442\u044c
    \u0438 \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u043e\u043c, \u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c,
    \u0438 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0434\u0435\u044f\u0442\u0435\u043b\u0435\u043c, \u0438 \u0442\u0430\u0439\u043d\u044b\u043c
    \u043a\u0440\u0438\u043f\u0442\u043e\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u043e\u043c,
    \u0438 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438.
    \u0415\u0433\u043e \u043f\u0443\u0442\u044c \u043f\u0440\u043e\u043b\u0435\u0433\u0430\u043b
    \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435
    \u0432\u043e\u0439\u043d\u044b \u0438 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0435
    \u0438\u043d\u0442\u0440\u0438\u0433\u0438, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u043e\u043d \u043d\u0430\u0448\u0435\u043b \u0432\u0440\u0435\u043c\u044f, \u0447\u0442\u043e\u0431\u044b
    \u0437\u0430\u043b\u043e\u0436\u0438\u0442\u044c \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u0412\u043e\u0442 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F4DC
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b (1540\u20131560) \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 1540 \u0433\u043e\u0434\u0443 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u0424\u043e\u043d\u0442\u0435\u043d\u0435-\u043b\u0435-\u041a\u043e\u043d\u0442
    \u0432 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0438 \u041f\u0443\u0430\u0442\u0443,
    \u043d\u0430 \u044e\u0433\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446, \u042d\u0442\u044c\u0435\u043d \u0412\u0438\u0435\u0442, \u0431\u044b\u043b
    \u043f\u0440\u043e\u043a\u0443\u0440\u043e\u0440\u043e\u043c, \u0438 \u043f\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u0424\u0440\u0430\u043d\u0441\u0443\u0430
    \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b \u043f\u043e\u0439\u0442\u0438 \u043f\u043e
    \u0435\u0433\u043e \u0441\u0442\u043e\u043f\u0430\u043c. \u0415\u0433\u043e \u043c\u0430\u0442\u044c,
    \u041c\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0430 \u0414\u044e\u043f\u043e\u043d, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0437\u043d\u0430\u0442\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0438,
    \u0447\u0442\u043e \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u043b\u043e
    \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0443. \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0412\u0438\u0435\u0442
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432 \u0448\u043a\u043e\u043b\u0435 \u043f\u0440\u0438
    \u043c\u0435\u0441\u0442\u043d\u043e\u043c \u0444\u0440\u0430\u043d\u0446\u0438\u0441\u043a\u0430\u043d\u0441\u043a\u043e\u043c
    \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435. \u0417\u0430\u0442\u0435\u043c \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041f\u0443\u0430\u0442\u044c\u0435,
    \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b \u043f\u0440\u0430\u0432\u043e.
    \u0412 1560 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    \u043f\u0440\u0430\u0432\u0430, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e
    \u0435\u043c\u0443 \u043d\u0430\u0447\u0430\u0442\u044c \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443.\n\n\u2696\ufe0f \u042e\u0440\u0438\u0441\u0442,
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 (1560\u20131571) \u0412
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 19 \u043b\u0435\u0442 \u0412\u0438\u0435\u0442
    \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u043e\u043c
    \u0432 \u0440\u043e\u0434\u043d\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0433\u043e\u0434\u0430, \u0432 1563
    \u0433\u043e\u0434\u0443, \u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b \u0448\u0430\u0433,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c.
    \u041e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0443
    \u0432 \u0437\u043d\u0430\u0442\u043d\u0443\u044e \u0441\u0435\u043c\u044c\u044e \u0434\u0435
    \u041f\u0430\u0440\u0442\u0435\u043d\u0435 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044f \u0438, \u0447\u0442\u043e \u0441\u0430\u043c\u043e\u0435
    \u0432\u0430\u0436\u043d\u043e\u0435, \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0434\u043b\u044f
    12-\u043b\u0435\u0442\u043d\u0435\u0439 \u0434\u043e\u0447\u0435\u0440\u0438 \u0445\u043e\u0437\u044f\u0438\u043d\u0430,
    \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u044e\u043d\u043e\u0439 \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u043a\u0435
    \u0441 \u0442\u0440\u0443\u0434\u043e\u043c, \u0412\u0438\u0435\u0442 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e
    \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0433\u043e \u0441\u0435\u0431\u044f \u0443\u0432\u043b\u0435\u043a\u0441\u044f
    \u044d\u0442\u043e\u0439 \u043d\u0430\u0443\u043a\u043e\u0439.\n\n\U0001F3DB\ufe0f \u041d\u0430
    \u043f\u0443\u0442\u0438 \u043a \u0432\u0435\u0440\u0448\u0438\u043d\u0430\u043c \u0432\u043b\u0430\u0441\u0442\u0438
    (1571\u20131584) \u041a\u043e\u0433\u0434\u0430 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0430
    \u0432\u044b\u0440\u043e\u0441\u043b\u0430 \u0438 \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436,
    \u0412\u0438\u0435\u0442 \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0441 \u0435\u0435
    \u0441\u0435\u043c\u044c\u0435\u0439 \u0438 \u0432 1571 \u0433\u043e\u0434\u0443 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u041f\u0430\u0440\u0438\u0436. \u0412 \u0441\u0442\u043e\u043b\u0438\u0446\u0435
    \u043e\u043d \u043e\u043a\u0443\u043d\u0443\u043b\u0441\u044f \u0432 \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c, \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438
    \u0415\u0432\u0440\u043e\u043f\u044b, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435
    \u0441 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u044b
    \u041f\u044c\u0435\u0440\u043e\u043c \u0420\u0430\u043c\u0443\u0441\u043e\u043c \u0438 \u043d\u0430\u0447\u0430\u043b
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443 \u0441 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0420\u0430\u0444\u0430\u044d\u043b\u0435\u043c
    \u0411\u043e\u043c\u0431\u0435\u043b\u043b\u0438. \u0412 1571 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0442\u0430\u043a\u0436\u0435 \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u043d\u0430 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u043b\u0443\u0436\u0431\u0443, \u0441\u0442\u0430\u0432 \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c
    \u043a\u043e\u0440\u043e\u043b\u044f \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u0413\u0435\u043d\u0440\u0438\u0445\u0430
    III. \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u0434\u0435 \u041f\u0430\u0440\u0442\u0435\u043d\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0433\u0443\u0433\u0435\u043d\u043e\u0442\u0430\u043c\u0438
    (\u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c\u0438 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0430\u043c\u0438).
    \u0412\u0430\u0440\u0444\u043e\u043b\u043e\u043c\u0435\u0435\u0432\u0441\u043a\u0430\u044f
    \u043d\u043e\u0447\u044c 1572 \u0433\u043e\u0434\u0430 \u0441\u0442\u0430\u043b\u0430 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u044d\u0442\u043e\u0439 \u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0439
    \u0440\u0435\u0437\u043d\u0438 \u0433\u0443\u0433\u0435\u043d\u043e\u0442\u043e\u0432 \u043a\u0430\u0442\u043e\u043b\u0438\u043a\u0430\u043c\u0438
    \u043f\u043e\u0433\u0438\u0431\u043b\u0438 \u043c\u0443\u0436 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b
    \u0434\u0435 \u041f\u0430\u0440\u0442\u0435\u043d\u0435 \u0438 \u0435\u0433\u043e \u0434\u0440\u0443\u0433,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0420\u0430\u043c\u0443\u0441. \u0412\u0438\u0435\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0430\u043c \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u043a\u0430\u0442\u043e\u043b\u0438\u043a\u043e\u043c, \u043a\u0430\u043a\u0438\u043c-\u0442\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u044d\u0442\u0443
    \u0440\u0435\u0437\u043d\u044e. \u0421\u043f\u0443\u0441\u0442\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0442 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0430 \u0432\u043d\u043e\u0432\u044c
    \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436 \u2014 \u0437\u0430 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u0437 \u043b\u0438\u0434\u0435\u0440\u043e\u0432 \u0433\u0443\u0433\u0435\u043d\u043e\u0442\u043e\u0432,
    \u043f\u0440\u0438\u043d\u0446\u0430 \u0434\u0435 \u0420\u043e\u0433\u0430\u043d\u0430.
    \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0435\u0433\u043e \u0445\u043e\u0434\u0430\u0442\u0430\u0439\u0441\u0442\u0432\u0443
    \u0432 1580 \u0433\u043e\u0434\u0443 \u0413\u0435\u043d\u0440\u0438\u0445 III \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b
    \u0412\u0438\u0435\u0442\u0430 \u043d\u0430 \u0432\u0430\u0436\u043d\u044b\u0439 \u0438
    \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0441\u0442
    \u0440\u0435\u043a\u0435\u0442\u043c\u0435\u0439\u0441\u0442\u0435\u0440\u0430. \u042d\u0442\u0430
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u0430\u0432\u0430\u043b\u0430
    \u0435\u043c\u0443 \u043f\u0440\u0430\u0432\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043e\u0442 \u0438\u043c\u0435\u043d\u0438 \u043a\u043e\u0440\u043e\u043b\u044f \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435
    \u043f\u0440\u0438\u043a\u0430\u0437\u043e\u0432 \u0432 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u044f\u0445
    \u0438 \u0434\u0430\u0436\u0435 \u043f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0442\u044c
    \u0440\u0430\u0441\u043f\u043e\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u043a\u0440\u0443\u043f\u043d\u044b\u0445
    \u0444\u0435\u043e\u0434\u0430\u043b\u043e\u0432.\n\n\U0001F575\ufe0f\u200d\u2642\ufe0f
    \u041a\u0440\u0438\u043f\u0442\u043e\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a \u0438
    \u00ab\u0443\u0447\u0435\u043d\u0438\u043a \u0434\u044c\u044f\u0432\u043e\u043b\u0430\u00bb
    \u0418\u043c\u0435\u043d\u043d\u043e \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443
    \u0412\u0438\u0435\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0432\u043e\u0439
    \u0441\u0430\u043c\u044b\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043d\u0435-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u0434\u0432\u0438\u0433. \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0439\u043d\u044b
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u0441 \u0418\u0441\u043f\u0430\u043d\u0438\u0435\u0439
    \u0435\u043c\u0443 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u0442\u044c
    \u043a\u043e\u0434 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043d\u043d\u043e\u0439
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u0424\u0438\u043b\u0438\u043f\u043f\u0430 II \u0441
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044f\u043c\u0438
    \u0432 \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0430\u0445. \u0428\u0438\u0444\u0440
    \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0441\u043b\u043e\u0436\u043d\u044b\u043c:
    \u043e\u043d \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b \u0434\u043e 600 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0437\u043d\u0430\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c
    \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0435 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u043a\u043e\u0440\u043e\u043b\u044c \u0413\u0435\u043d\u0440\u0438\u0445 IV \u0431\u044b\u043b
    \u0432 \u043a\u0443\u0440\u0441\u0435 \u0432\u0441\u0435\u0445 \u043f\u043b\u0430\u043d\u043e\u0432
    \u0441\u0432\u043e\u0438\u0445 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u0432,
    \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0443\u0441\u043f\u0435\u0445\u0430\u043c
    \u043d\u0430 \u043f\u043e\u043b\u0435 \u0431\u043e\u044f. \u0420\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043d\u043d\u044b\u0439
    \u0424\u0438\u043b\u0438\u043f\u043f II \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u043e\u0432
    \u0432 \u0441\u0432\u044f\u0437\u0438 \u0441 \u043d\u0435\u0447\u0438\u0441\u0442\u043e\u0439
    \u0441\u0438\u043b\u043e\u0439, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443,
    \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e, \u0442\u0430\u043a\u043e\u0439
    \u0448\u0438\u0444\u0440 \u043d\u0435 \u043c\u043e\u0433 \u0440\u0430\u0437\u0433\u0430\u0434\u0430\u0442\u044c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u0418\u0441\u043f\u0430\u043d\u0441\u043a\u0430\u044f
    \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u044f \u0437\u0430\u043e\u0447\u043d\u043e
    \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430 \u0412\u0438\u0435\u0442\u0430
    \u043a \u0441\u043e\u0436\u0436\u0435\u043d\u0438\u044e \u043d\u0430 \u043a\u043e\u0441\u0442\u0440\u0435.
    \u041a \u044d\u0442\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043e \u0435\u0433\u043e
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0442\u0440\u0443\u0434\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438:
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u044b\u0439 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e
    \u0437\u0430\u0434\u0430\u0447\u0435\u0439, \u043e\u043d \u043c\u043e\u0433 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043f\u043e \u0442\u0440\u043e\u0435 \u0441\u0443\u0442\u043e\u043a \u0431\u0435\u0437
    \u0441\u043d\u0430.\n\n\U0001F4D0 \u041f\u0438\u043a \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430:
    \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u0435 \u0438 \u00ab\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb (1584\u20131591) \u0412 1584
    \u0433\u043e\u0434\u0443, \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445 \u0438\u043d\u0442\u0440\u0438\u0433
    \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e
    \u0440\u043e\u0434\u0430 \u0413\u0438\u0437\u043e\u0432, \u0412\u0438\u0435\u0442\u0430
    \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438\u043b\u0438 \u043e\u0442 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0432\u044b\u0441\u043b\u0430\u043b\u0438 \u0438\u0437 \u041f\u0430\u0440\u0438\u0436\u0430.
    \u042d\u0442\u043e \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0441\u0442\u0430\u0442\u044c
    \u043a\u043e\u043d\u0446\u043e\u043c \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b,
    \u043e\u0431\u0435\u0440\u043d\u0443\u043b\u043e\u0441\u044c \u0434\u043b\u044f \u043d\u0430\u0443\u043a\u0438
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c \u0431\u043b\u0430\u0433\u043e\u043c.
    \u041e\u0431\u0440\u0435\u0442\u044f \u0434\u043e\u043b\u0433\u043e\u0436\u0434\u0430\u043d\u043d\u044b\u0439
    \u043f\u043e\u043a\u043e\u0439, \u0412\u0438\u0435\u0442 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u041e\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u0435\u0440\u0435\u0434
    \u0441\u043e\u0431\u043e\u0439 \u0446\u0435\u043b\u044c \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0443\u044e \u043d\u0430\u0443\u043a\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u043b\u0430
    \u0431\u044b \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0434\u0440\u0435\u0432\u043d\u0438\u0445.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434,
    \u0432 1591 \u0433\u043e\u0434\u0443, \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0442\u0440\u0443\u0434
    \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb. \u0412 \u044d\u0442\u043e\u0439
    \u043a\u043d\u0438\u0433\u0435 \u043e\u043d \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u043c\u0438\u0440\u0443 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u2014 \u043d\u043e\u0432\u044b\u0439 \u044f\u0437\u044b\u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0433\u0434\u0435 \u0431\u0443\u043a\u0432\u0430\u043c\u0438
    (\u0433\u043b\u0430\u0441\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445,
    \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445)
    \u043c\u043e\u0436\u043d\u043e \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c
    \u043b\u044e\u0431\u044b\u0435 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b \u0438 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0432 \u043e\u0431\u0449\u0435\u043c \u0432\u0438\u0434\u0435.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u0431\u043d\u0430\u0440\u043e\u0434\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443,
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0449\u0443\u044e \u043a\u043e\u0440\u043d\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0441 \u0435\u0433\u043e \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438.\n\n\u2b50
    \u0417\u0432\u0435\u0437\u0434\u043d\u044b\u0439 \u0447\u0430\u0441 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    (1589\u20131603) \u041f\u043e\u0441\u043b\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430
    \u0413\u0435\u043d\u0440\u0438\u0445\u0430 III \u0432 1589 \u0433\u043e\u0434\u0443 \u0432\u043b\u0430\u0441\u0442\u044c
    \u043f\u0435\u0440\u0435\u0448\u043b\u0430 \u043a \u0413\u0435\u043d\u0440\u0438\u0445\u0443
    \u041d\u0430\u0432\u0430\u0440\u0440\u0441\u043a\u043e\u043c\u0443, \u0431\u0443\u0434\u0443\u0449\u0435\u043c\u0443
    \u043a\u043e\u0440\u043e\u043b\u044e \u0413\u0435\u043d\u0440\u0438\u0445\u0443 IV. \u0412\u0438\u0435\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c, \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u043d\u0430
    \u0441\u043b\u0443\u0436\u0431\u0443 \u043a \u043d\u043e\u0432\u043e\u043c\u0443 \u043a\u043e\u0440\u043e\u043b\u044e,
    \u0432\u0441\u043a\u043e\u0440\u0435 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432
    \u041f\u0430\u0440\u0438\u0436. \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u0443\u044e \u0441\u043b\u0430\u0432\u0443
    \u0435\u043c\u0443 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u043f\u043e\u0431\u0435\u0434\u0430
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0435\u0434\u0438\u043d\u043a\u0435 \u0432 1594 \u0433\u043e\u0434\u0443. \u0413\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0410\u0434\u0440\u0438\u0430\u043d
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0440\u0435\u0448\u0438\u0442\u044c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    45-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u0434\u0430\u0436\u0435 \u043d\u0435
    \u0430\u0434\u0440\u0435\u0441\u043e\u0432\u0430\u0432 \u0432\u044b\u0437\u043e\u0432 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0430\u043c,
    \u0441\u0447\u0438\u0442\u0430\u044f, \u0447\u0442\u043e \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u043d\u0435\u0442 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u0412\u0438\u0435\u0442 \u043f\u0440\u044f\u043c\u043e \u043d\u0430 \u043f\u0440\u0438\u0435\u043c\u0435
    \u0443 \u043a\u043e\u0440\u043e\u043b\u044f \u043d\u0430\u0448\u0435\u043b \u0432\u0441\u0435
    \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u0440\u043d\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u043f\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u043e\u043d\u043e \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a
    \u0437\u0430\u0434\u0430\u0447\u0435 \u043e \u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0443\u0433\u043b\u0430
    \u043d\u0430 45 \u0447\u0430\u0441\u0442\u0435\u0439. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u043f\u0440\u0438\u0435\u0445\u0430\u043b
    \u043a \u0412\u0438\u0435\u0442\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0435\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438, \u0438 \u043c\u0435\u0436\u0434\u0443
    \u043d\u0438\u043c\u0438 \u0437\u0430\u0432\u044f\u0437\u0430\u043b\u0430\u0441\u044c \u0434\u0440\u0443\u0436\u0431\u0430.
    \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u0412\u0438\u0435\u0442 \u043e\u0442\u043e\u0448\u0435\u043b \u043e\u0442 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0441\u043b\u0443\u0436\u0431\u044b. \u0418\u0437\u0432\u0435\u0441\u0442\u043d\u043e,
    \u0447\u0442\u043e \u043e\u043d \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043f\u043e\u043b\u0435\u043c\u0438\u043a\u0443
    \u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435
    \u043d\u043e\u0432\u043e\u0433\u043e, \u0433\u0440\u0438\u0433\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f \u0438 \u0434\u0430\u0436\u0435 \u0445\u043e\u0442\u0435\u043b
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439.\n\n\U0001F56F\ufe0f
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    \u041e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438 \u0412\u0438\u0435\u0442\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043d\u0435\u043c\u043d\u043e\u0433\u043e.
    \u0412 \u043c\u0435\u043c\u0443\u0430\u0440\u0430\u0445 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f,
    \u0447\u0442\u043e \u043e\u043d \u0431\u044b\u043b \u0436\u0435\u043d\u0430\u0442 \u0438
    \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u044c, \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0438\u0446\u0430 \u0438\u043c\u0435\u043d\u0438\u044f,
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u043e\u043d \u043d\u043e\u0441\u0438\u043b \u0442\u0438\u0442\u0443\u043b \u0441\u0435\u043d\u044c\u043e\u0440\u0430
    \u0434\u0435 \u043b\u0430 \u0411\u0438\u0433\u043e\u0442\u044c\u0435. \u0424\u0440\u0430\u043d\u0441\u0443\u0430
    \u0412\u0438\u0435\u0442 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    13 \u0444\u0435\u0432\u0440\u0430\u043b\u044f (\u0438\u043b\u0438 14 \u0444\u0435\u0432\u0440\u0430\u043b\u044f)
    1603 \u0433\u043e\u0434\u0430. \u0412 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445
    \u043d\u043e\u0432\u043e\u0441\u0442\u044f\u0445 \u0431\u044b\u043b\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043e:
    \u00ab...\u0433\u043e\u0441\u043f\u043e\u0434\u0438\u043d \u0412\u0438\u0435\u0442, \u0440\u0435\u043a\u0435\u0442\u043c\u0435\u0439\u0441\u0442\u0435\u0440,
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e
    \u0443\u043c\u0430 \u0438 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0443\u0447\u0435\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0432\u0435\u043a\u0430
    \u0443\u043c\u0435\u0440... \u0432 \u041f\u0430\u0440\u0438\u0436\u0435. \u0415\u043c\u0443
    \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u0435\u0435 \u0448\u0435\u0441\u0442\u0438\u0434\u0435\u0441\u044f\u0442\u0438
    \u043b\u0435\u0442\u00bb. \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u2014 \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0438\u0439
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb \u2014 \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u043d\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u043c. \u041c\u043d\u043e\u0433\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438.
    \u0421\u0431\u043e\u0440\u043d\u0438\u043a \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432
    \u0431\u044b\u043b \u0438\u0437\u0434\u0430\u043d \u0432 1646 \u0433\u043e\u0434\u0443 \u0432
    \u041b\u0435\u0439\u0434\u0435\u043d\u0435 \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0424\u0440\u0430\u043d\u0441\u043e\u043c \u0432\u0430\u043d \u0421\u0445\u043e\u0442\u0435\u043d\u043e\u043c."
  personalLifeEn: 
  shortBioRu: "\u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 (1540\u20131603) \u2013
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u043e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u0438\u043a \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044e \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0438 \u0431\u044b\u043b \u044e\u0440\u0438\u0441\u0442\u043e\u043c
    \u0438 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0434\u0435\u044f\u0442\u0435\u043b\u0435\u043c.\n\n\U0001F4DC \u0420\u0430\u043d\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    (1540\u20131560) \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 1540 \u0433\u043e\u0434\u0443 \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u043a\u0435 \u0424\u043e\u043d\u0442\u0435\u043d\u0435-\u043b\u0435-\u041a\u043e\u043d\u0442
    \u0432 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0438 \u041f\u0443\u0430\u0442\u0443-\u0428\u0430\u0440\u0430\u043d\u0442
    \u043d\u0430 \u044e\u0433\u0435 \u0424\u0440\u0430\u043d\u0446\u0438\u0438. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u043f\u0440\u043e\u043a\u0443\u0440\u043e\u0440\u043e\u043c,
    \u0438 \u043f\u043e \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u0441\u0435\u043c\u044c\u0438
    \u0441\u044b\u043d \u0432\u044b\u0431\u0440\u0430\u043b \u0442\u0443 \u0436\u0435 \u0441\u0442\u0435\u0437\u044e.
    \u0415\u0433\u043e \u043c\u0430\u0442\u044c, \u041c\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0430
    \u0414\u044e\u043f\u043e\u043d, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0437\u043d\u0430\u0442\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0438,
    \u0447\u0442\u043e \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u043b\u043e
    \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0443. \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0412\u0438\u0435\u0442
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432 \u043c\u0435\u0441\u0442\u043d\u043e\u043c
    \u0444\u0440\u0430\u043d\u0446\u0438\u0441\u043a\u0430\u043d\u0441\u043a\u043e\u043c \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0435.
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041f\u0443\u0430\u0442\u044c\u0435,
    \u0433\u0434\u0435 \u0432 1560 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0431\u0430\u043a\u0430\u043b\u0430\u0432\u0440\u0430
    (\u0447\u0442\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u043d\u0430\u0447\u0430\u043b\u0443 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b).\n\n\u2696\ufe0f \u041d\u0430\u0447\u0430\u043b\u043e
    \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u0438 \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    (1560\u20131571) \u0421 19 \u043b\u0435\u0442 \u0412\u0438\u0435\u0442 \u043d\u0430\u0447\u0430\u043b
    \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u0441\u043a\u0443\u044e \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443
    \u0432 \u0440\u043e\u0434\u043d\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0435. \u0412
    1564 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0435\u0440\u0435\u0448\u0435\u043b \u043d\u0430
    \u0441\u043b\u0443\u0436\u0431\u0443 \u0432 \u0437\u043d\u0430\u0442\u043d\u0443\u044e \u0433\u0443\u0433\u0435\u043d\u043e\u0442\u0441\u043a\u0443\u044e
    \u0441\u0435\u043c\u044c\u044e \u0434\u0435 \u041f\u0430\u0440\u0442\u0435\u043d\u0435,
    \u0441\u0442\u0430\u0432 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0435\u043c \u0438
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c 12-\u043b\u0435\u0442\u043d\u0435\u0439
    \u0434\u043e\u0447\u0435\u0440\u0438 \u0445\u043e\u0437\u044f\u0438\u043d\u0430, \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b.
    \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435
    \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b\u043e \u0432 \u043c\u043e\u043b\u043e\u0434\u043e\u043c
    \u044e\u0440\u0438\u0441\u0442\u0435 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041a\u043e\u0433\u0434\u0430
    \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0430 \u0432\u044b\u0440\u043e\u0441\u043b\u0430
    \u0438 \u0432\u044b\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436, \u0412\u0438\u0435\u0442
    \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0441 \u0435\u0435 \u0441\u0435\u043c\u044c\u0435\u0439
    \u0438 \u043e\u043a\u043e\u043b\u043e 1571 \u0433\u043e\u0434\u0430 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0441 \u043d\u0438\u043c\u0438 \u0432 \u041f\u0430\u0440\u0438\u0436. \u0412 \u0441\u0442\u043e\u043b\u0438\u0446\u0435
    \u043e\u043d \u0441\u043c\u043e\u0433 \u0431\u043b\u0438\u0436\u0435 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u0432\u0435\u0434\u0443\u0449\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 \u0415\u0432\u0440\u043e\u043f\u044b,
    \u043e\u0431\u0449\u0430\u0442\u044c\u0441\u044f \u0441 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0421\u043e\u0440\u0431\u043e\u043d\u043d\u044b \u0420\u0430\u043c\u0443\u0441\u043e\u043c
    \u0438 \u0432\u0435\u0441\u0442\u0438 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443
    \u0441 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0420\u0430\u0444\u0430\u044d\u043b\u0435\u043c \u0411\u043e\u043c\u0431\u0435\u043b\u043b\u0438.
    \u0412 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b
    \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0440\u0443\u0434
    \u043f\u043e \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u0430\u043d\u043e\u043d\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b
    \u0438\u0437\u0434\u0430\u043d \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u0432 1579 \u0433\u043e\u0434\u0443.\n\n\U0001F3DB\ufe0f
    \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0441\u043b\u0443\u0436\u0431\u0430 \u0438 \u0441\u043b\u0443\u0436\u0431\u0430 \u043a\u043e\u0440\u043e\u043d\u0435
    (1571\u20131584) \u0412 1571 \u0433\u043e\u0434\u0443 \u0412\u0438\u0435\u0442 \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u043d\u0430 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u043b\u0443\u0436\u0431\u0443, \u0441\u0442\u0430\u0432 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c
    \u043f\u0430\u0440\u043b\u0430\u043c\u0435\u043d\u0442\u0430, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0438 \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u043c \u043a\u043e\u0440\u043e\u043b\u044f
    \u0413\u0435\u043d\u0440\u0438\u0445\u0430 III. \u0412 1580 \u0433\u043e\u0434\u0443 \u043a\u043e\u0440\u043e\u043b\u044c
    \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0435\u0433\u043e \u043d\u0430 \u0432\u0430\u0436\u043d\u044b\u0439
    \u043f\u043e\u0441\u0442 \u0440\u0435\u043a\u0435\u0442\u043c\u0435\u0439\u0441\u0442\u0435\u0440\u0430.
    \u042d\u0442\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u0430\u0432\u0430\u043b\u0430
    \u0435\u043c\u0443 \u043f\u0440\u0430\u0432\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043e\u0442 \u0438\u043c\u0435\u043d\u0438 \u043c\u043e\u043d\u0430\u0440\u0445\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0438\u0445 \u0440\u0430\u0441\u043f\u043e\u0440\u044f\u0436\u0435\u043d\u0438\u0439
    \u0432 \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u044f\u0445 \u0438 \u043f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0442\u044c
    \u043f\u0440\u0438\u043a\u0430\u0437\u044b \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u0444\u0435\u043e\u0434\u0430\u043b\u043e\u0432.
    \u041d\u0430 \u044d\u0442\u043e\u0439 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438
    \u0412\u0438\u0435\u0442 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u043a\u0430\u043a \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f \u043a\u0440\u0438\u043f\u0442\u043e\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0439\u043d\u044b \u0441 \u0418\u0441\u043f\u0430\u043d\u0438\u0435\u0439
    \u0435\u043c\u0443 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0439 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0439
    \u0448\u0438\u0444\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u043c\u0435\u043d\u044f\u043b\u0441\u044f \u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b
    \u0434\u043e 600 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0437\u043d\u0430\u043a\u043e\u0432.
    \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u044d\u0442\u043e\u043c\u0443 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439
    \u043a\u043e\u0440\u043e\u043b\u044c \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u043b
    \u0432 \u043a\u0443\u0440\u0441\u0435 \u043f\u043b\u0430\u043d\u043e\u0432 \u0441\u0432\u043e\u0438\u0445
    \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u0432. \u0418\u0441\u043f\u0430\u043d\u0446\u044b,
    \u043d\u0435 \u0432\u0435\u0440\u044f \u0432 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438,
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b\u0438 \u0412\u0438\u0435\u0442\u0430 \u0432 \u0441\u043e\u044e\u0437\u0435
    \u0441 \u0434\u044c\u044f\u0432\u043e\u043b\u043e\u043c.\n\n\U0001F4D0 \u041f\u0435\u0440\u0438\u043e\u0434
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430
    (1584\u20131591) \u0412 1584 \u0433\u043e\u0434\u0443 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435
    \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445 \u0438\u043d\u0442\u0440\u0438\u0433
    \u0412\u0438\u0435\u0442\u0430 \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438\u043b\u0438
    \u043e\u0442 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u0438 \u0432\u044b\u0441\u043b\u0430\u043b\u0438
    \u0438\u0437 \u041f\u0430\u0440\u0438\u0436\u0430. \u042d\u0442\u043e\u0442 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u044b\u0439
    \u043e\u0442\u0434\u044b\u0445 \u0441\u0442\u0430\u043b \u043f\u0438\u043a\u043e\u043c \u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430. \u041e\u0431\u0440\u0435\u0442\u044f
    \u043f\u043e\u043a\u043e\u0439, \u043e\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u043f\u0435\u0440\u0435\u0434 \u0441\u043e\u0431\u043e\u0439 \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u0443\u044e
    \u0446\u0435\u043b\u044c: \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0430
    \u0431\u044b \u0440\u0435\u0448\u0430\u0442\u044c \u043b\u044e\u0431\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u041f\u043e \u0435\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c, \u043e\u043d \u0431\u044b\u043b
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d, \"\u0447\u0442\u043e \u0434\u043e\u043b\u0436\u043d\u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043e\u0431\u0449\u0430\u044f,
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0435\u0449\u0435 \u043d\u0430\u0443\u043a\u0430,
    \u043e\u0431\u043d\u0438\u043c\u0430\u044e\u0449\u0430\u044f \u0438 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u0435
    \u0438\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u043d\u043e\u0432\u0435\u0439\u0448\u0438\u0445
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0441\u0442\u043e\u0432, \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u0438\u044f
    \u0434\u0440\u0435\u0432\u043d\u0438\u0445\". \u0418\u0442\u043e\u0433\u043e\u043c \u0435\u0433\u043e
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439 \u0441\u0442\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00ab\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb (1591 \u0433\u043e\u0434).
    \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u0412\u0438\u0435\u0442
    \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443
    \u0441\u0432\u043e\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u043e\u0432\u044b\u0439
    \u044f\u0437\u044b\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u2014
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0443.
    \u0421\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u00ab\u0432\u0438\u0434\u043e\u0432\u043e\u0439 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u043e\u0439\u00bb.
    \u0413\u043b\u0430\u0432\u043d\u043e\u0439 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u0438\u0434\u0435\u0435\u0439 \u0431\u044b\u043b\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0431\u0443\u043a\u0432 \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    (\u0433\u043b\u0430\u0441\u043d\u044b\u0435), \u043d\u043e \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d (\u0441\u043e\u0433\u043b\u0430\u0441\u043d\u044b\u0435).
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e: - \u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432 \u043e\u0431\u0449\u0435\u043c
    \u0432\u0438\u0434\u0435. - \u041e\u043f\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0441\u0438\u043c\u0432\u043e\u043b\u0430\u043c\u0438, \u043f\u043e\u043b\u0443\u0447\u0430\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u044b\u0435
    \u043a \u043b\u044e\u0431\u044b\u043c \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430\u043c. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0430
    \u0431\u044b\u0442\u044c \u043d\u0430\u0443\u043a\u043e\u0439 \u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445 \u0438 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0430\u0441\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u043e \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438
    \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0439, \u0447\u0442\u043e \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u043e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442
    \u0414\u0435\u043a\u0430\u0440\u0442\u0430, \u0424\u0435\u0440\u043c\u0430 \u0438 \u041d\u044c\u044e\u0442\u043e\u043d\u0430.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u043e\u043d \u043e\u0431\u043d\u0430\u0440\u043e\u0434\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443,
    \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0449\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043d\u044f\u043c\u0438
    \u0438 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f. \u0414\u043b\u044f \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0433\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u043e\u043d \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0451 \u0442\u0430\u043a: \u00ab\u0415\u0441\u043b\u0438 B+D, \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u043d\u043e\u0435
    \u043d\u0430 \u0410, \u043c\u0438\u043d\u0443\u0441 \u0410 \u0432 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0435
    \u0440\u0430\u0432\u043d\u043e BD, \u0442\u043e \u0410 \u0440\u0430\u0432\u043d\u043e \u0412
    \u0438 \u0440\u0430\u0432\u043d\u043e D\u00bb. \u0422\u0435\u043f\u0435\u0440\u044c \u043e\u043d\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043a\u0430\u043a \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0412\u0438\u0435\u0442\u0430.\n\n\u2b50 \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0438 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430
    (1589\u20131594) \u0412 1589 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0433\u0438\u0431\u0435\u043b\u0438
    \u0413\u0435\u043d\u0440\u0438\u0445\u0430 \u0413\u0438\u0437\u0430, \u0412\u0438\u0435\u0442
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436.
    \u041e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0441\u043b\u0443\u0436\u0431\u0443,
    \u0441\u0442\u0430\u0432 \u043f\u0440\u0438 \u0413\u0435\u043d\u0440\u0438\u0445\u0435 IV
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u043d\u044b\u0445
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u043e\u0432. \u0422\u0435\u043c \u043d\u0435
    \u043c\u0435\u043d\u0435\u0435, \u043e\u043d \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u0443\u044e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c
    \u0435\u043c\u0443 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u043f\u043e\u0431\u0435\u0434\u0430
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0435\u0434\u0438\u043d\u043a\u0435. \u0412 1594 \u0433\u043e\u0434\u0443 \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0410\u0434\u0440\u0438\u0430\u043d
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u0431\u0440\u043e\u0441\u0438\u043b
    \u0432\u044b\u0437\u043e\u0432 \u0432\u0441\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u043c\u0438\u0440\u0430, \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u0432 \u0440\u0435\u0448\u0438\u0442\u044c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 45-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438.
    \u0412\u044b\u0437\u043e\u0432 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u043e\u043d
    \u043d\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443
    \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0442\u0430\u043c \u043d\u0435\u0442
    \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u0412\u0438\u0435\u0442, \u0443\u0437\u043d\u0430\u0432 \u043e\u0431 \u044d\u0442\u043e\u043c,
    \u0432 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043a\u043e\u0440\u043e\u043b\u044f
    \u0438 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u0445 \u043d\u0430\u0448\u0435\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u0438\u043d \u043a\u043e\u0440\u0435\u043d\u044c,
    \u043d\u043e \u0438 \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435,
    \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a \u0437\u0430\u0434\u0430\u0447\u0435
    \u043e \u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0443\u0433\u043b\u0430 \u043d\u0430
    45 \u0447\u0430\u0441\u0442\u0435\u0439. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u043d\u044b\u043c \u043f\u043e\u0447\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u043c.\n\n\U0001F3C6
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442 \u0443\u043c\u0435\u0440
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 13 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1603 \u0433\u043e\u0434\u0430 (\u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c \u0434\u0430\u043d\u043d\u044b\u043c
    \u2014 14 \u0444\u0435\u0432\u0440\u0430\u043b\u044f ). \u0415\u043c\u0443 \u0431\u044b\u043b\u043e
    63 \u0433\u043e\u0434\u0430. \u0415\u0441\u0442\u044c \u043d\u0435\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u0435
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u0447\u0442\u043e
    \u043e\u043d \u043c\u043e\u0433 \u0441\u0442\u0430\u0442\u044c \u0436\u0435\u0440\u0442\u0432\u043e\u0439
    \u043d\u0430\u0441\u0438\u043b\u044c\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438.
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438
    \u2014 \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0438\u0439 \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00ab\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430,
    \u0438\u043b\u0438 \u041d\u043e\u0432\u0430\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u00bb
    \u2014 \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u043d\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u043c.
    \u041f\u0440\u0438 \u0436\u0438\u0437\u043d\u0438 \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u043b\u0438\u0448\u044c \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0435\u0433\u043e
    \u0447\u0430\u0441\u0442\u0438. \u041e\u0434\u043d\u0430\u043a\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0431\u044b\u043b\u043e \u0441\u0434\u0435\u043b\u0430\u043d\u043e: \u0412\u0438\u0435\u0442
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439
    \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043d\u043e
    \u0438: - \u0414\u0430\u043b\u0435\u043a\u043e \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u043b
    \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u044e: \u043f\u0435\u0440\u0432\u044b\u043c
    \u044f\u0432\u043d\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u0438 \u0432\u044b\u0432\u0435\u043b \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0434\u043b\u044f \u0441\u0438\u043d\u0443\u0441\u043e\u0432 \u0438 \u043a\u043e\u0441\u0438\u043d\u0443\u0441\u043e\u0432
    \u043a\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u0433\u043b\u043e\u0432. - \u0420\u0435\u0448\u0438\u043b
    \u0434\u0440\u0435\u0432\u043d\u044e\u044e \u0437\u0430\u0434\u0430\u0447\u0443 \u0442\u0440\u0438\u0441\u0435\u043a\u0446\u0438\u0438
    \u0443\u0433\u043b\u0430, \u0441\u0432\u0435\u0434\u044f \u0435\u0435 \u043a \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e. - \u0412\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0447 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0440\u0435\u0448\u0438\u0432 \u0437\u0430\u0434\u0430\u0447\u0443
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f. - \u0412\u0432\u0435\u043b \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0445 \u0434\u0440\u043e\u0431\u0435\u0439
    \u0441 \u0437\u0430\u043f\u044f\u0442\u043e\u0439. \u0421\u0431\u043e\u0440\u043d\u0438\u043a
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432 \u0431\u044b\u043b \u0438\u0437\u0434\u0430\u043d
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e \u0432 1646 \u0433\u043e\u0434\u0443
    \u0432 \u041b\u0435\u0439\u0434\u0435\u043d\u0435."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0424\u0440\u0430\u043d\u0441\u0443\u0430 \u0412\u0438\u0435\u0442\u0430
    \u043f\u043e\u043b\u043d\u0430 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u043f\u043e\u0445\u043e\u0436\u0435\u0439 \u043d\u0430 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0439
    \u0440\u043e\u043c\u0430\u043d. \u041e\u0442 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u0441\u043e\u0432\u0435\u0442\u043d\u0438\u043a\u0430 \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0433\u043e
    \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0442\u0440\u0438\u0443\u043c\u0444\u0430 \u0434\u043e \u043f\u043e\u0431\u0435\u0434\u044b
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0434\u0443\u044d\u043b\u0438 \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044f\u0437\u044b\u043a\u0430 \u2014 \u0435\u0433\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0438\u0437\u043e\u0431\u0438\u043b\u0443\u0435\u0442 \u044f\u0440\u043a\u0438\u043c\u0438,
    \u0430 \u043f\u043e\u0440\u043e\u0439 \u0438 \u043a\u0443\u0440\u044c\u0451\u0437\u043d\u044b\u043c\u0438
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430\u043c\u0438.\n\n\U0001F575\ufe0f\u200d\u2642\ufe0f
    \u041f\u043e\u0431\u0435\u0434\u0430 \u043d\u0430\u0434 \u00ab\u043d\u0435\u0447\u0438\u0442\u0430\u0435\u043c\u044b\u043c\u00bb
    \u0448\u0438\u0444\u0440\u043e\u043c \u0438 \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0435
    \u0432 \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u0435 \u041f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u044b\u0439 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0439
    \u0444\u0430\u043a\u0442 \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0412\u0438\u0435\u0442\u0430
    \u2014 \u044d\u0442\u043e \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u043a\u0440\u0438\u043f\u0442\u043e\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u043e\u043c.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0439\u043d\u044b \u0441 \u0418\u0441\u043f\u0430\u043d\u0438\u0435\u0439
    \u043e\u043d \u0441\u0443\u043c\u0435\u043b \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u0442\u044c
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u0424\u0438\u043b\u0438\u043f\u043f\u0430 II \u0441
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044f\u043c\u0438
    \u0432 \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0430\u0445. \u0421\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0439
    \u043a\u043e\u0434: \u0418\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0439 \u0448\u0438\u0444\u0440
    \u0431\u044b\u043b \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0441\u043b\u043e\u0436\u043d\u044b\u043c
    \u2014 \u043e\u043d \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b \u0434\u043e 600 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u0437\u043d\u0430\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u044f\u043b\u0438\u0441\u044c.
    \u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e
    \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c. \u041e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0435
    \u0432 \u043c\u0430\u0433\u0438\u0438: \u041a\u043e\u0433\u0434\u0430 \u0438\u0441\u043f\u0430\u043d\u0446\u044b
    \u0443\u0437\u043d\u0430\u043b\u0438, \u0447\u0442\u043e \u0438\u0445 \u0442\u0430\u0439\u043d\u044b\u0439
    \u043a\u043e\u0434 \u0440\u0430\u0437\u0433\u0430\u0434\u0430\u043d, \u043e\u043d\u0438
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u0432\u0435\u0440\u0438\u0442\u044c
    \u0432 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0437\u0430\u043e\u0447\u043d\u043e \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438
    \u0412\u0438\u0435\u0442\u0430... \u043a \u0441\u043e\u0436\u0436\u0435\u043d\u0438\u044e
    \u043d\u0430 \u043a\u043e\u0441\u0442\u0440\u0435, \u043e\u0431\u0432\u0438\u043d\u0438\u0432
    \u0432 \u0441\u043e\u044e\u0437\u0435 \u0441 \u0434\u044c\u044f\u0432\u043e\u043b\u043e\u043c
    \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u0447\u0451\u0440\u043d\u043e\u0439
    \u043c\u0430\u0433\u0438\u0438! \u0422\u0440\u0443\u0434\u043e\u0433\u043e\u043b\u0438\u0437\u043c:
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u0438
    \u0435\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c.
    \u0420\u0430\u0434\u0438 \u0440\u0430\u0437\u0433\u0430\u0434\u043a\u0438 \u0448\u0438\u0444\u0440\u0430
    \u0438\u043b\u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043e\u043d \u043c\u043e\u0433 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043f\u043e \u0442\u0440\u043e\u0435 \u0441\u0443\u0442\u043e\u043a \u0431\u0435\u0437
    \u0441\u043d\u0430.\n\n\U0001F3C6 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0434\u0443\u044d\u043b\u044c: \u043a\u0430\u043a \u0412\u0438\u0435\u0442 \u00ab\u0443\u0442\u0435\u0440
    \u043d\u043e\u0441\u00bb \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0446\u0443 \u0412\u0442\u043e\u0440\u043e\u0439
    \u043f\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u044d\u043f\u0438\u0437\u043e\u0434
    \u2014 \u044d\u0442\u043e \u0435\u0433\u043e \u0442\u0440\u0438\u0443\u043c\u0444 \u0432
    \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u0441\u0442\u0430\u0442\u044c \u043c\u0438\u0440\u043e\u0432\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0432\u044b\u0437\u043e\u0432\u043e\u043c. \u0414\u0435\u0440\u0437\u043a\u0438\u0439 \u0432\u044b\u0437\u043e\u0432:
    \u0412 1594 \u0433\u043e\u0434\u0443 \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0410\u0434\u0440\u0438\u0430\u043d
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0440\u0435\u0448\u0438\u0442\u044c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    45-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u0440\u0430\u0437\u043e\u0441\u043b\u0430\u0432
    \u0435\u0433\u043e \u0432\u0441\u0435\u043c \u0432\u0435\u0434\u0443\u0449\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u0415\u0432\u0440\u043e\u043f\u044b, \u043d\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0432
    \u0424\u0440\u0430\u043d\u0446\u0438\u044e, \u0442\u0430\u043a \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0442\u0430\u043c \u043d\u0435\u0442 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445. \u041e\u0442\u0432\u0435\u0442 \u043a\u043e\u0440\u043e\u043b\u044f:
    \u0413\u0435\u043d\u0440\u0438\u0445 IV, \u0443\u0437\u043d\u0430\u0432 \u043e\u0431 \u044d\u0442\u043e\u043c,
    \u0437\u0430\u044f\u0432\u0438\u043b \u043d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u043c\u0443
    \u043f\u043e\u0441\u043b\u0443, \u0447\u0442\u043e \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u0435\u0441\u0442\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u0438
    \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b \u0412\u0438\u0435\u0442\u0430. \u0411\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435: \u041d\u0430 \u043f\u0440\u0438\u0451\u043c\u0435
    \u0443 \u043a\u043e\u0440\u043e\u043b\u044f \u0412\u0438\u0435\u0442 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0430\u0448\u0451\u043b \u043e\u0434\u0438\u043d \u043a\u043e\u0440\u0435\u043d\u044c,
    \u0430 \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0435 \u043e \u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0443\u0433\u043b\u0430,
    \u0438 \u043d\u0430\u0448\u0451\u043b \u0432\u0441\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043a\u043e\u0440\u043d\u0438. \u041d\u0430\u0434\u043f\u0438\u0441\u044c-\u043f\u0438\u043d-\u043a\u043e\u0434:
    \u041f\u043e\u043a\u0440\u044b\u0432\u0430\u044f \u0441\u0432\u043e\u0451 \u0440\u0435\u0448\u0435\u043d\u0438\u0435,
    \u0412\u0438\u0435\u0442 \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e
    \u043a\u0430\u043a: \"\u0423\u0432\u0438\u0434\u0435\u0432 \u2014 \u0440\u0435\u0448\u0438\u043b\".
    \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u0436\u0451\u043d\u043d\u044b\u0439
    \u0432\u0430\u043d \u0420\u043e\u0443\u043c\u0435\u043d \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u043d\u044b\u043c \u043f\u043e\u0447\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u043c.\n\n\U0001F4D6
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u00ab\u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f
    \u0413\u0430\u043b\u043b\u044c\u0441\u043a\u043e\u0433\u043e\u00bb \u0438 \u0437\u0430\u0433\u0430\u0434\u043a\u0430
    \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0430 \u0421\u0432\u043e\u0451 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435
    \u043a \u0434\u0440\u0435\u0432\u043d\u0435\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0412\u0438\u0435\u0442 \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0438
    \u0435\u0449\u0451 \u043e\u0434\u043d\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0438. \u0417\u0430\u0434\u0430\u0447\u0430 \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f:
    \u0412\u0438\u0435\u0442 \u0440\u0435\u0448\u0438\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0438\u044f
    \u041f\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e \u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0438
    \u043a\u0440\u0443\u0433\u0430, \u043a\u0430\u0441\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u0442\u0440\u0451\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u043a\u0440\u0443\u0433\u043e\u0432.
    \u0413\u043e\u0440\u0434\u043e\u0435 \u043f\u0440\u043e\u0437\u0432\u0438\u0449\u0435: \u041e\u043d
