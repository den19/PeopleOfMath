    \u0440\u0435\u0448\u0438\u0442\u044c \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    45-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u0434\u0430\u0436\u0435 \u043d\u0435
    \u0430\u0434\u0440\u0435\u0441\u043e\u0432\u0430\u0432 \u0432\u044b\u0437\u043e\u0432 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0430\u043c,
    \u0441\u0447\u0438\u0442\u0430\u044f, \u0447\u0442\u043e \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438
