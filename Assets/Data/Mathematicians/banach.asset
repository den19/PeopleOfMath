  achievementsRu: "\u0421\u0442\u0435\u0444\u0430\u043d \u0411\u0430\u043d\u0430\u0445 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u043f\u043e \u0441\u0443\u0442\u0438
    \u0441\u043e\u0437\u0434\u0430\u0432 \u0437\u0430\u043d\u043e\u0432\u043e \u0446\u0435\u043b\u0443\u044e
    \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437. \u0415\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0441\u044f \u0432 \u0442\u043e\u043c,
    \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u043e\u0431\u0449\u0443\u044e
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0437\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e\u043c
    \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447,
    \u0438 \u044d\u0442\u043e\u0442 \u043f\u043e\u0434\u0445\u043e\u0434 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c.
    \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c
    \u0435\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435.\n\n\U0001F4DC \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u043d\u043e\u0432\u043e\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b:
    \u0411\u0430\u043d\u0430\u0445\u043e\u0432\u044b \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u0411\u0430\u043d\u0430\u0445\u0430 \u2014 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438 \u043d\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0431\u0430\u043d\u0430\u0445\u043e\u0432\u044b\u043c\u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u043c\u0438.
    \u0427\u0442\u043e \u044d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442:
    \u0411\u0430\u043d\u0430\u0445 \u0432\u0432\u0435\u043b \u0441\u0442\u0440\u043e\u0433\u0438\u0435
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u0433\u0434\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0438\u0441\u043b\u0430, \u0430,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0444\u0443\u043d\u043a\u0446\u0438\u0438.
    \u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b, \u043a\u0430\u043a
    \u044d\u0442\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c,
    \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c \u043d\u0430 \u0447\u0438\u0441\u043b\u043e
    \u0438, \u0441\u0430\u043c\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435, \u043a\u0430\u043a
    \u0438\u0437\u043c\u0435\u0440\u044f\u0442\u044c \u0438\u0445 \"\u0434\u043b\u0438\u043d\u0443\"
    (\u043d\u043e\u0440\u043c\u0443) \u0438 \u0447\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442,
    \u0447\u0442\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0442\u0430\u043a\u0438\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0441\u0445\u043e\u0434\u0438\u0442\u0441\u044f
    (\u043f\u043e\u043b\u043d\u043e\u0442\u0430). \u042d\u0442\u043e \u0434\u0430\u043b\u043e
    \u043c\u043e\u0449\u043d\u044b\u0439 \u0435\u0434\u0438\u043d\u044b\u0439 \u044f\u0437\u044b\u043a
    \u0434\u043b\u044f \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0441\u0430\u043c\u044b\u0445
    \u0440\u0430\u0437\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435:
    \u0424\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438, \u0432 \u0435\u0433\u043e
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    1920 \u0433\u043e\u0434\u0430 \u0438, \u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u0432 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u00abTh\u00e9orie des
    op\u00e9rations lin\u00e9aires\u00bb (1932) \u0431\u044b\u043b \u0437\u0430\u043b\u043e\u0436\u0435\u043d
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043a\u0430\u043a \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b. \u0414\u043e \u0411\u0430\u043d\u0430\u0445\u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u043b\u0438\u0448\u044c
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u043b\u0438
    \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u0438 \u0435\u0434\u0438\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u0439\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438.\n\n\U0001F3DB\ufe0f \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0435
    \u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u0412 \u0440\u0430\u043c\u043a\u0430\u0445
    \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0439 \u0438\u043c \u0442\u0435\u043e\u0440\u0438\u0438
    \u0411\u0430\u043d\u0430\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0442\u0430\u043b\u0438 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c\u0438
    \u043a\u0430\u043c\u043d\u044f\u043c\u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0425\u0430\u043d\u0430-\u0411\u0430\u043d\u0430\u0445\u0430: \u041e\u0434\u043d\u0430
    \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u0442\u0435\u043e\u0440\u0435\u043c
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u0442\u044c \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044b \u0441 \u043f\u043e\u0434\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u043d\u0430 \u0432\u0441\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e
    \u0431\u0435\u0437 \u043f\u043e\u0442\u0435\u0440\u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432.
    \u042d\u0442\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0431\u0435\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0437\u0430\u0434\u0430\u0447. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0411\u0430\u043d\u0430\u0445\u0430-\u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437\u0430
    (\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0439
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u0438): \u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442
    \u0432\u0430\u0436\u043d\u043e\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0441\u0435\u043c\u0435\u0439\u0441\u0442\u0432
    \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u043a\u0440\u0430\u0439\u043d\u0435 \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u043c \u0432\u043e
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0438. \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0441\u0442\u0438 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f
    \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u043e\u043c
    \u0433\u0440\u0430\u0444\u0438\u043a\u0435: \u042d\u0442\u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0434\u0430\u044e\u0442 \u0432\u0430\u0436\u043d\u044b\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438
    \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f
    \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432
    \u043c\u0435\u0436\u0434\u0443 \u0431\u0430\u043d\u0430\u0445\u043e\u0432\u044b\u043c\u0438
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430\u043c\u0438.\n\n\U0001F30D
    \u041a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u043f\u0440\u043e\u0440\u044b\u0432\u044b
    \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445
    \u0418\u0434\u0435\u0438 \u0411\u0430\u043d\u0430\u0445\u0430 \u043d\u0430\u0448\u043b\u0438
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0434\u0430\u043b\u0435\u043a\u043e
    \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \"\u0447\u0438\u0441\u0442\u043e\u0439\"
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043b\u0435\u0433\u043b\u0438
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0442\u0435\u043e\u0440\u0438\u0439 \u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u0432.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0411\u0430\u043d\u0430\u0445\u0430 \u043e \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u0435 (\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0441\u0436\u0438\u043c\u0430\u044e\u0449\u0438\u0445
    \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439): \u042d\u0442\u0430
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0431\u044b\u043b\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430
    \u0438\u043c \u0435\u0449\u0435 \u0432 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438. \u041e\u043d\u0430 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u0441\u0436\u0438\u043c\u0430\u044e\u0449\u0435\u0433\u043e
    \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u043d\u043e\u0433\u043e
    \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0432 \u0441\u0435\u0431\u044f \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0430\u044f
    \u0442\u043e\u0447\u043a\u0430. \u042d\u0442\u043e \u043c\u043e\u0449\u043d\u044b\u0439
    \u0438 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f
    \u0438 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0432 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445,
    \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u0430\u0445
    \u0438 \u0434\u0430\u0436\u0435 \u0432 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435.
    \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0411\u0430\u043d\u0430\u0445\u0430-\u0422\u0430\u0440\u0441\u043a\u043e\u0433\u043e:
    \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0439
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0410\u043b\u044c\u0444\u0440\u0435\u0434\u043e\u043c
    \u0422\u0430\u0440\u0441\u043a\u0438\u043c. \u042d\u0442\u0430 \"\u0442\u0435\u043e\u0440\u0435\u043c\u0430\"
    \u0433\u043b\u0430\u0441\u0438\u0442, \u0447\u0442\u043e \u0448\u0430\u0440 \u043c\u043e\u0436\u043d\u043e
    \u0440\u0430\u0437\u0431\u0438\u0442\u044c \u043d\u0430 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e \u0447\u0430\u0441\u0442\u0435\u0439 \u0438, \u0434\u0432\u0438\u0433\u0430\u044f
    \u0438\u0445 \u043a\u0430\u043a \u0442\u0432\u0435\u0440\u0434\u044b\u0435 \u0442\u0435\u043b\u0430
    (\u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0444\u043e\u0440\u043c\u044b),
    \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u0438\u0437 \u043d\u0438\u0445 \u0434\u0432\u0430
    \u0448\u0430\u0440\u0430, \u0442\u043e\u0447\u043d\u043e \u0442\u0430\u043a\u0438\u0445
    \u0436\u0435, \u043a\u0430\u043a \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0439. \u042d\u0442\u043e\u0442
    \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442,
    \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 \u0430\u043a\u0441\u0438\u043e\u043c\u0435
    \u0432\u044b\u0431\u043e\u0440\u0430, \u0441\u0442\u0430\u043b \u0432\u0430\u0436\u043d\u044b\u043c
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c \u0432 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. \u0412\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u0438\u0437\u0438\u043a\u0443: \u0411\u0430\u043d\u0430\u0445\u043e\u0432\u044b \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0441\u0442\u0430\u043b\u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u044f\u0437\u044b\u043a\u043e\u043c \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438.
    \u0421\u0430\u043c\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u00ab\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0437\u0430\u0434\u0430\u0447\u0438\u00bb
    (\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e\u0441\u0442\u0438 \u0437\u0430\u0434\u0430\u0447\u0438)
    \u0447\u0430\u0441\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f
    \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0443\u044e
    \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u0439
    \u0432 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u0445 \u043d\u043e\u0440\u043c\u044b \u0431\u0430\u043d\u0430\u0445\u043e\u0432\u0430
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430. \u042d\u0442\u043e
    \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043e \u043c\u0430\u043b\u044b\u0435
    \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0445
    \u0434\u0430\u043d\u043d\u044b\u0445 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u044e\u0442
    \u043c\u0430\u043b\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432
    \u0440\u0435\u0448\u0435\u043d\u0438\u0438, \u0447\u0442\u043e \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0430\u0436\u043d\u043e \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043e\u0434\u0435\u043b\u0435\u0439.\n\n\U0001F4DA \u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c
    \u0448\u043a\u043e\u043b\u044b \u0412\u043a\u043b\u0430\u0434 \u0411\u0430\u043d\u0430\u0445\u0430
    \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f
    \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043c\u0438. \u041e\u043d \u0431\u044b\u043b
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0447\u0435\u043d\u044b\u043c, \u043d\u043e \u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c. \u041e\u043d
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0438 \u0434\u0443\u0448\u043e\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u043b\u044c\u0432\u043e\u0432\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u0438 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041f\u043e\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u0412\u043c\u0435\u0441\u0442\u0435 \u0441
    \u0413\u0443\u0433\u043e \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437\u043e\u043c
    \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0432\u0430\u0436\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0436\u0443\u0440\u043d\u0430\u043b
    \u00abStudia Mathematica\u00bb \u0438 \u0431\u044b\u043b \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u043e\u0440\u043e\u043c
    \u0438\u0437\u0434\u0430\u043d\u0438\u044f \u0441\u0435\u0440\u0438\u0438 \u00abMathematical
    Monographs\u00bb, \u043f\u0435\u0440\u0432\u044b\u0439 \u0442\u043e\u043c \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0430\u043c. \u041a\u0430\u043a \u043a\u0440\u0430\u0442\u043a\u043e
    \u0438 \u0442\u043e\u0447\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0441\u0443\u0442\u044c \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0430
    \u0441\u0430\u043c \u0411\u0430\u043d\u0430\u0445: \"\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u2014 \u044d\u0442\u043e \u0442\u043e\u0442, \u043a\u0442\u043e \u0443\u043c\u0435\u0435\u0442
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0438
    \u043c\u0435\u0436\u0434\u0443 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f\u043c\u0438,
    \u043b\u0443\u0447\u0448\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u2014 \u0442\u043e\u0442, \u043a\u0442\u043e \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442
    \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432,
    \u0431\u043e\u043b\u0435\u0435 \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u2014 \u0442\u043e\u0442, \u043a\u0442\u043e \u0437\u0430\u043c\u0435\u0447\u0430\u0435\u0442
    \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0438 \u0442\u0435\u043e\u0440\u0438\u0439...\".
    \u0415\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0439 \u0432\u043a\u043b\u0430\u0434
    \u2014 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u0443\u0432\u0438\u0434\u0435\u043b
    \u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u044d\u0442\u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \"\u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0438 \u0442\u0435\u043e\u0440\u0438\u0439\",
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u0432
    \u043b\u0438\u0446\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0421\u0442\u0435\u0444\u0430\u043d\u0430
    \u0411\u0430\u043d\u0430\u0445\u0430 \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c
    \u0436\u0435 \u043d\u0435\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0439, \u043a\u0430\u043a
    \u0438 \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0433\u0435\u043d\u0438\u0439. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430
    \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432
    \u0441 \u0441\u0430\u043c\u043e\u0433\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0438 \u0434\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 \u0434\u043d\u0435\u0439.\n\n\U0001F476
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u043e:
    \u0442\u0430\u0439\u043d\u0430 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0421\u0442\u0435\u0444\u0430\u043d
    \u0411\u0430\u043d\u0430\u0445 \u0440\u043e\u0434\u0438\u043b\u0441\u044f 30 \u043c\u0430\u0440\u0442\u0430
    1892 \u0433\u043e\u0434\u0430 \u0432 \u041a\u0440\u0430\u043a\u043e\u0432\u0435 \u0438 \u0431\u044b\u043b
    \u0432\u043d\u0435\u0431\u0440\u0430\u0447\u043d\u044b\u043c \u0441\u044b\u043d\u043e\u043c
    \u041a\u0430\u0442\u0430\u0436\u0438\u043d\u044b \u0411\u0430\u043d\u0430\u0445 \u0438 \u0421\u0442\u0435\u0444\u0430\u043d\u0430
    \u0413\u0440\u0435\u0447\u0435\u043a\u0430. \u0415\u0433\u043e \u043e\u0442\u0435\u0446
    \u0431\u044b\u043b \u0441\u043e\u043b\u0434\u0430\u0442\u043e\u043c \u0430\u0432\u0441\u0442\u0440\u043e-\u0432\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u0439
    \u0430\u0440\u043c\u0438\u0438 \u0438 \u043f\u043e \u0432\u043e\u0435\u043d\u043d\u044b\u043c
    \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043d\u0435 \u043c\u043e\u0433 \u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f \u043d\u0430
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u0440\u0438. \u0424\u0430\u043c\u0438\u043b\u0438\u044e
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043e\u0442 \u043c\u0430\u0442\u0435\u0440\u0438,
    \u0430 \u0438\u043c\u044f \u2014 \u043e\u0442 \u043e\u0442\u0446\u0430. \u041c\u0430\u0442\u044c
    \u0438\u0441\u0447\u0435\u0437\u043b\u0430 \u0438\u0437 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438,
    \u043a\u043e\u0433\u0434\u0430 \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u043e
    \u0447\u0435\u0442\u044b\u0440\u0435 \u0434\u043d\u044f \u043e\u0442 \u0440\u043e\u0434\u0443,
    \u0438 \u0421\u0442\u0435\u0444\u0430\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u0435\u0451
    \u043d\u0435 \u0437\u043d\u0430\u043b. \u041f\u043e\u0437\u0436\u0435, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0443\u0437\u043d\u0430\u0442\u044c
    \u043e \u043d\u0435\u0439, \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0445\u0440\u0430\u043d\u0438\u043b
    \u043c\u043e\u043b\u0447\u0430\u043d\u0438\u0435, \u0441\u0441\u044b\u043b\u0430\u044f\u0441\u044c
    \u043d\u0430 \u0434\u0430\u043d\u043d\u0443\u044e \u043a\u043b\u044f\u0442\u0432\u0443,
    \u0438 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u041a\u0430\u0442\u0430\u0436\u0438\u043d\u044b
    \u0411\u0430\u043d\u0430\u0445 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u0442\u0430\u0439\u043d\u043e\u0439. \u041c\u043b\u0430\u0434\u0435\u043d\u0446\u0435\u043c
    \u0421\u0442\u0435\u0444\u0430\u043d \u0436\u0438\u043b \u0443 \u0431\u0430\u0431\u0443\u0448\u043a\u0438,
    \u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u0435\u0451 \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    \u0431\u044b\u043b \u043f\u0435\u0440\u0435\u0434\u0430\u043d \u043d\u0430 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435
    \u043f\u0440\u0438\u0435\u043c\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0435 \u2014 \u0424\u0440\u0430\u043d\u0446\u0438\u0448\u043a\u0435
    \u041f\u043b\u043e\u0432\u043e\u0439 \u0438 \u0435\u0451 \u043f\u043b\u0435\u043c\u044f\u043d\u043d\u0438\u0446\u0435
    \u041c\u0430\u0440\u0438\u0438 \u041f\u0443\u0445\u0430\u043b\u044c\u0441\u043a\u043e\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043b\u0430\u0434\u0435\u043b\u0438 \u043f\u0440\u0430\u0447\u0435\u0447\u043d\u043e\u0439
    \u0432 \u041a\u0440\u0430\u043a\u043e\u0432\u0435. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0438\u0445 \u0421\u0442\u0435\u0444\u0430\u043d \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0432\u043e\u0435\u0439
    \u0441\u0435\u043c\u044c\u0435\u0439. \u0412 \u0434\u043e\u043c\u0435 \u041f\u043b\u043e\u0432\u044b\u0445
    \u0436\u0438\u043b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b
    \u042e\u043b\u0438\u0443\u0448 \u041c\u0435\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0431\u0443\u0447\u0438\u043b \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c\u0443
    \u044f\u0437\u044b\u043a\u0443 \u0438, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u043f\u043e\u043e\u0449\u0440\u044f\u043b \u0435\u0433\u043e \u0440\u0430\u043d\u043d\u0438\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.\n\n\u2764\ufe0f
    \u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0431\u0440\u0430\u043a
    \u0438 \u0441\u044b\u043d \u0412 1920 \u0433\u043e\u0434\u0443 \u0411\u0430\u043d\u0430\u0445
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u041b\u044e\u0446\u0438\u0438 (\u041b\u0443\u0446\u0435)
    \u0411\u0440\u0430\u0443\u0441. \u041e\u043d\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b\u0438\u0441\u044c
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0443
    \u0413\u0443\u0433\u043e \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437\u0443: \u041b\u044e\u0446\u0438\u044f
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0435\u043c
    \u0443 \u043a\u0443\u0437\u0435\u043d\u0430 \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437\u0430.
    \u0412 1922 \u0433\u043e\u0434\u0443 \u0443 \u043f\u0430\u0440\u044b \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0441\u044b\u043d, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0442\u0430\u043a\u0436\u0435
    \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u0421\u0442\u0435\u0444\u0430\u043d\u043e\u043c.
    \u0421\u044b\u043d \u043f\u043e\u0448\u0435\u043b \u043f\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u043c\u0443
    \u043f\u0443\u0442\u0438 \u0438 \u0441\u0442\u0430\u043b \u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u043e\u043c.
    \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0436\u0435\u043d\u044b \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e
    \u0434\u043e\u0440\u043e\u0433\u043e\u0441\u0442\u043e\u044f\u0449\u0435\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f,
    \u0447\u0442\u043e \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u043e\u0439 \u0411\u0430\u043d\u0430\u0445\u0430
    \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u043f\u043e\u0441\u0435\u0449\u0430\u0442\u044c
    \u043a\u0430\u0444\u0435 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b\u043e \u0434\u043b\u044f
    \u0441\u0435\u043c\u044c\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435 \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0435\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e
    \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u0443.\n\n\u2615 \u041e\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043d\u0438 \u0438 \u043f\u0440\u0438\u0447\u0443\u0434\u044b \u0433\u0435\u043d\u0438\u044f
    \u0411\u0430\u043d\u0430\u0445 \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0441\u0432\u043e\u0438\u043c \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u043c \u0441\u0442\u0438\u043b\u0435\u043c
    \u0440\u0430\u0431\u043e\u0442\u044b. \u041e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u0442\u0440\u0443\u0434\u0438\u0442\u044c\u0441\u044f \u043d\u0435 \u0432 \u0442\u0438\u0448\u0438
    \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430, \u0430 \u0432 \u0448\u0443\u043c\u043d\u044b\u0445
    \u043a\u0430\u0444\u0435, \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044f, \u0447\u0442\u043e
    \u0433\u0443\u043b \u0433\u043e\u043b\u043e\u0441\u043e\u0432 \u0438 \u043c\u0443\u0437\u044b\u043a\u0430
    \u043d\u0435 \u043c\u0435\u0448\u0430\u044e\u0442 \u0435\u0433\u043e \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438,
    \u0430 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442, \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442
    \u0435\u043c\u0443 \u0434\u0443\u043c\u0430\u0442\u044c. \u041e\u043d \u043c\u043e\u0433
    \u043f\u0440\u043e\u0441\u0438\u0434\u0435\u0442\u044c \u0432 \u043a\u0430\u0444\u0435 \u0432\u0435\u0441\u044c
    \u0434\u0435\u043d\u044c, \u0430 \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0438\u0441\u044c,
    \u043f\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u043b\u0441\u044f \u0432 \u043a\u0440\u0443\u0433\u043b\u043e\u0441\u0443\u0442\u043e\u0447\u043d\u044b\u0439
    \u0431\u0443\u0444\u0435\u0442 \u043d\u0430 \u0432\u043e\u043a\u0437\u0430\u043b\u0435,
    \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c
    \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f \u0437\u0430 \u043a\u0440\u0443\u0436\u043a\u043e\u0439
    \u043f\u0438\u0432\u0430. \u0415\u0433\u043e \u0441\u0442\u0440\u0430\u0441\u0442\u044c
    \u043a \u043a\u0430\u0444\u0435 \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u0430 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u0443\u044e
    \u00ab\u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u0443\u044e \u043a\u043d\u0438\u0433\u0443\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u041b\u044e\u0446\u0438\u044f
    \u043a\u0443\u043f\u0438\u043b\u0430 \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432,
    \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438 \u043c\u043e\u0433\u043b\u0438 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c
    \u0432 \u043d\u0435\u0439 \u0441\u0432\u043e\u0438 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0438 \u043d\u0435 \u0442\u0435\u0440\u044f\u0442\u044c \u0438\u0445 \u043d\u0430 \u043c\u0440\u0430\u043c\u043e\u0440\u043d\u044b\u0445
    \u0441\u0442\u043e\u043b\u0438\u043a\u0430\u0445.\n\n\u2694\ufe0f \u0412\u043e\u0439\u043d\u0430
    \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0438\u043d\u0430\u043b
    \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0436\u0438\u0437\u043d\u044c \u0411\u0430\u043d\u0430\u0445\u0430
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u043e\u0439
    \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u0438 \u041b\u044c\u0432\u043e\u0432\u0430,
    \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u0440\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0439,
    \u043e\u043d \u0443\u0441\u0442\u0440\u043e\u0438\u043b\u0441\u044f \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043f\u043e \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e
    \u0441\u044b\u043f\u043d\u043e\u0433\u043e \u0442\u0438\u0444\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0430 \u0412\u0430\u0439\u0433\u043b\u044f, \u0433\u0434\u0435
    \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u0441\u044b\u043d\u043e\u043c
    \u043a\u043e\u0440\u043c\u0438\u043b \u0432\u0448\u0435\u0439 \u0441\u0432\u043e\u0435\u0439
    \u043a\u0440\u043e\u0432\u044c\u044e \u0434\u043b\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430
    \u0432\u0430\u043a\u0446\u0438\u043d\u044b. \u042d\u0442\u0430 \u043e\u043f\u0430\u0441\u043d\u0430\u044f
    \u0438 \u0443\u043d\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u0441\u043f\u0430\u0441\u043b\u0430 \u0438\u043c \u0436\u0438\u0437\u043d\u044c, \u0432
    \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u043c\u043d\u043e\u0433\u0438\u0435
    \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0430 \u041b\u043e\u043c\u043d\u0438\u0446\u043a\u043e\u0433\u043e,
    \u0431\u044b\u043b\u0438 \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043b\u044f\u043d\u044b.
    \u0412 1945 \u0433\u043e\u0434\u0443, \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u041b\u044c\u0432\u043e\u0432\u0430,
    \u0411\u0430\u043d\u0430\u0445 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u0442\u044c \u0432 \u041a\u0440\u0430\u043a\u043e\u0432,
    \u0433\u0434\u0435 \u0435\u043c\u0443 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438
    \u043c\u0435\u0441\u0442\u043e \u0432 \u042f\u0433\u0435\u043b\u043b\u043e\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u044d\u0442\u0438\u043c \u043f\u043b\u0430\u043d\u0430\u043c \u043d\u0435 \u0441\u0443\u0436\u0434\u0435\u043d\u043e
    \u0431\u044b\u043b\u043e \u0441\u0431\u044b\u0442\u044c\u0441\u044f: \u0443 \u043d\u0435\u0433\u043e
    \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u0438\u0445. \u0421\u0442\u0435\u0444\u0430\u043d
    \u0411\u0430\u043d\u0430\u0445 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 31
    \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1945 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    53 \u043b\u0435\u0442 \u0438 \u0431\u044b\u043b \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043d\u0430 \u041b\u044b\u0447\u0430\u043a\u043e\u0432\u0441\u043a\u043e\u043c \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435
    \u0432\u043e \u041b\u044c\u0432\u043e\u0432\u0435.\n\n\U0001F4D6 \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0439
    \u0444\u0430\u043a\u0442: \u041b\u0435\u0433\u0435\u043d\u0434\u0430 \u043e \u0437\u0430\u0449\u0438\u0442\u0435
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u0421 \u0435\u0433\u043e
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u043e\u0434\u043d\u0430 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u0430\u044f, \u0447\u0430\u0441\u0442\u043e
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u043c\u0430\u044f, \u043d\u043e \u043d\u0435
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f.
    \u0413\u043e\u0432\u043e\u0440\u044f\u0442, \u0447\u0442\u043e \u0411\u0430\u043d\u0430\u0445
    \u0442\u0430\u043a \u0434\u043e\u043b\u0433\u043e \u043e\u0442\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b
    \u0437\u0430\u0449\u0438\u0442\u0443 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438, \u0447\u0442\u043e \u0435\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438, \u0443\u0441\u0442\u0430\u0432 \u0436\u0434\u0430\u0442\u044c,
    \u0437\u0430\u043c\u0430\u043d\u0438\u043b\u0438 \u0435\u0433\u043e \u0432 \u043a\u0430\u0431\u0438\u043d\u0435\u0442
    \u0434\u0435\u043a\u0430\u043d\u0430 \u043f\u043e\u0434 \u043f\u0440\u0435\u0434\u043b\u043e\u0433\u043e\u043c
    \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0431\u0435\u0441\u0435\u0434\u044b. \u0422\u0430\u043c
    \u043e\u043d, \u043d\u0435 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u044f
    \u043e\u0431 \u044d\u0442\u043e\u043c, \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u043d\u0430 \u0432\u0441\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b
    \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439
    \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438 \u0438 \u0441\u0434\u0430\u043b \u044d\u043a\u0437\u0430\u043c\u0435\u043d,
    \u0434\u0430\u0436\u0435 \u043d\u0435 \u043e\u0441\u043e\u0437\u043d\u0430\u0432\u0430\u044f
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0433\u043e. \u042d\u0442\u0430
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u043f\u0440\u0430\u0432\u0434\u0438\u0432\u0430\u044f
    \u0438\u043b\u0438 \u043d\u0435\u0442, \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442
    \u0435\u0433\u043e \u043a\u0430\u043a \u0433\u0435\u043d\u0438\u044f, \u0434\u043b\u044f
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c."
  personalLifeEn: 
  shortBioRu: "\u0421\u0442\u0435\u0444\u0430\u043d \u0411\u0430\u043d\u0430\u0445 (1892\u20131945) \u2014
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u043b\u0438\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430,
    \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438 \u043a\u043b\u044e\u0447\u0435\u0432\u0430\u044f
    \u0444\u0438\u0433\u0443\u0440\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u043b\u044c\u0432\u043e\u0432\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b. \u0415\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u2014 \u044d\u0442\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0441\u0430\u043c\u043e\u0443\u0447\u043a\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0443\u0436\u0430\u0441\u044b \u0412\u0442\u043e\u0440\u043e\u0439
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b.\n\n\U0001F4DC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043f\u0443\u0442\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435:
    \u0421\u0442\u0435\u0444\u0430\u043d \u0411\u0430\u043d\u0430\u0445 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    30 \u043c\u0430\u0440\u0442\u0430 1892 \u0433\u043e\u0434\u0430 \u0432 \u041a\u0440\u0430\u043a\u043e\u0432\u0435
    (\u0442\u043e\u0433\u0434\u0430 \u0410\u0432\u0441\u0442\u0440\u043e-\u0412\u0435\u043d\u0433\u0440\u0438\u044f).
    \u041e\u043d \u0431\u044b\u043b \u0432\u043d\u0435\u0431\u0440\u0430\u0447\u043d\u044b\u043c
    \u0441\u044b\u043d\u043e\u043c \u041a\u0430\u0442\u0430\u0436\u0438\u043d\u044b \u0411\u0430\u043d\u0430\u0445
    \u0438 \u0441\u043e\u043b\u0434\u0430\u0442\u0430 \u0421\u0442\u0435\u0444\u0430\u043d\u0430
    \u0413\u0440\u0435\u0447\u0435\u043a\u0430. \u041f\u043e \u0437\u0430\u043a\u043e\u043d\u0430\u043c
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0435\u0433\u043e \u043e\u0442\u0435\u0446
    \u043d\u0435 \u043c\u043e\u0433 \u0436\u0435\u043d\u0438\u0442\u044c\u0441\u044f \u043d\u0430
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u0440\u0438, \u0438 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0433\u043e
    \u0421\u0442\u0435\u0444\u0430\u043d\u0430 \u043e\u0442\u0434\u0430\u043b\u0438 \u043d\u0430
    \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435 \u0432 \u0441\u0435\u043c\u044c\u044e
    \u043f\u0440\u0438\u0435\u043c\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u0440\u0438 \u0424\u0440\u0430\u043d\u0446\u0438\u0448\u043a\u0438
    \u041f\u043b\u043e\u0432\u043e\u0439. \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u0437\u043d\u0430\u043b \u0441\u0432\u043e\u044e \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u0430\u0442\u044c, \u0430 \u043e\u0442\u0435\u0446, \u0445\u043e\u0442\u044c \u0438
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u0441\u0432\u044f\u0437\u044c,
    \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0445\u0440\u0430\u043d\u0438\u043b
    \u0442\u0430\u0439\u043d\u0443 \u0435\u0451 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435: \u0412 \u0448\u043a\u043e\u043b\u0435
    \u0411\u0430\u043d\u0430\u0445 \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0447\u0430\u0441\u0442\u043e \u0440\u0435\u0448\u0430\u044f \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0438\u043c
    \u0434\u0440\u0443\u0433\u043e\u043c, \u0431\u0443\u0434\u0443\u0449\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0412\u0438\u0442\u043e\u043b\u044c\u0434\u043e\u043c \u0412\u0438\u043b\u044c\u043a\u043e\u0448\u0435\u043c.
    \u041f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438
    \u0432 1910 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432\u043e \u041b\u044c\u0432\u043e\u0432\u0441\u043a\u0443\u044e \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u043d\u0430 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442, \u0442\u0430\u043a \u043a\u0430\u043a
    \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0443\u0436\u0435 \u043d\u0438\u0447\u0435\u0433\u043e
    \u043d\u043e\u0432\u043e\u0433\u043e \u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u044c.
    \u0421\u0443\u0434\u044c\u0431\u043e\u043d\u043e\u0441\u043d\u0430\u044f \u0432\u0441\u0442\u0440\u0435\u0447\u0430:
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b, \u0432 1916 \u0433\u043e\u0434\u0443, \u0432 \u041a\u0440\u0430\u043a\u043e\u0432\u0441\u043a\u043e\u043c
    \u043f\u0430\u0440\u043a\u0435 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430,
    \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0411\u0430\u043d\u0430\u0445\u0430. \u041e\u043d \u0438 \u0435\u0433\u043e \u0434\u0440\u0443\u0433
    \u041e\u0442\u0442\u043e \u041d\u0438\u043a\u043e\u0434\u044b\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438
    \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0438 \u0438\u0445
    \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0443\u0441\u043b\u044b\u0448\u0430\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0413\u0443\u0433\u043e \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u044b\u043b \u043f\u043e\u0440\u0430\u0436\u0435\u043d \u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439
    \u043c\u044b\u0441\u043b\u0435\u0439 \u0441\u0430\u043c\u043e\u0443\u0447\u043a\u0438 \u0411\u0430\u043d\u0430\u0445\u0430.
    \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437 \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0438 \u0434\u0440\u0443\u0433\u043e\u043c.
    \u0423\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0434\u0435\u043b\u044e \u0411\u0430\u043d\u0430\u0445
    \u0440\u0435\u0448\u0438\u043b \u0441\u043b\u043e\u0436\u043d\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443,
    \u043d\u0430\u0434 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e
    \u0431\u0438\u043b\u0441\u044f \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0438
    \u043e\u043d\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b\u0438
    \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443.\n\n\U0001F3DB\ufe0f
    \u041b\u044c\u0432\u043e\u0432\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0438 \u0440\u0430\u0441\u0446\u0432\u0435\u0442 \u043a\u0430\u0440\u044c\u0435\u0440\u044b
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c
    \u0448\u043a\u043e\u043b\u044b: \u041f\u0440\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435
    \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437\u0430, \u0432 1920 \u0433\u043e\u0434\u0443
    \u0411\u0430\u043d\u0430\u0445 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u0435\u0441\u0442\u043e
    \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0430 \u0432\u043e \u041b\u044c\u0432\u043e\u0432\u0441\u043a\u043e\u0439
    \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u043a\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c,
    \u0432 1922 \u0433\u043e\u0434\u0443, \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0438 \u0441\u0442\u0430\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u0421 1924 \u0433\u043e\u0434\u0430
    \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u041b\u044c\u0432\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0438\u043c\u0435\u043d\u0438 \u042f\u043d\u0430 \u041a\u0430\u0437\u0438\u043c\u0438\u0440\u0430.
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430: \u0413\u043b\u0430\u0432\u043d\u044b\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0411\u0430\u043d\u0430\u0445\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443 \u0441\u0442\u0430\u043b\u043e
    \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438 \u0431\u0430\u043d\u0430\u0445\u043e\u0432\u044b\u0445
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432 (\u043f\u043e\u043b\u043d\u044b\u0445
    \u043d\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432). \u0415\u0433\u043e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f 1920 \u0433\u043e\u0434\u0430
    \u0438 \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u00ab\u0422\u0435\u043e\u0440\u0438\u044f
    \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439\u00bb
    (1932) \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u043d\u043e\u0432\u043e\u0433\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u00ab\u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0435
    \u043a\u0430\u0444\u0435\u00bb: \u0411\u0430\u043d\u0430\u0445 \u0431\u044b\u043b \u0434\u0443\u0448\u043e\u0439
    \u043b\u044c\u0432\u043e\u0432\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b. \u041e\u043d \u0438 \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    (\u041c\u0430\u0437\u0443\u0440, \u0423\u043b\u0430\u043c, \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437
    \u0438 \u0434\u0440.) \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0438\u0441\u044c \u0432
    \u043a\u0430\u0444\u0435 \u00ab\u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u0430\u044f\u00bb,
    \u0433\u0434\u0435 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b\u0438 \u0438 \u0440\u0435\u0448\u0430\u043b\u0438
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b.
    \u0422\u0430\u043c \u0432\u0435\u043b\u0430\u0441\u044c \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u00ab\u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u0430\u044f \u043a\u043d\u0438\u0433\u0430\u00bb
    \u2014 \u0442\u043e\u043b\u0441\u0442\u0430\u044f \u0442\u0435\u0442\u0440\u0430\u0434\u044c
    \u0434\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0438 \u0437\u0430\u0434\u0430\u0447.
    \u0421\u0430\u043c \u0411\u0430\u043d\u0430\u0445 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0437\u0430 \u0441\u0442\u043e\u043b\u0438\u043a\u043e\u043c
    \u043a\u0430\u0444\u0435, \u0447\u0430\u0441\u0442\u043e \u0432 \u0448\u0443\u043c\u043d\u043e\u0439
    \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435, \u0447\u0442\u043e \u043d\u0435
    \u043c\u0435\u0448\u0430\u043b\u043e \u0435\u0433\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438.\n\n\u2694\ufe0f
    \u0412\u043e\u0439\u043d\u0430, \u0432\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0438
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434: \u0412 1939 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435
    \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0417\u0430\u043f\u0430\u0434\u043d\u043e\u0439
    \u0423\u043a\u0440\u0430\u0438\u043d\u044b \u043a \u0421\u0421\u0421\u0420, \u0411\u0430\u043d\u0430\u0445
    \u0441\u0442\u0430\u043b \u0434\u0435\u043a\u0430\u043d\u043e\u043c \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430 \u041b\u044c\u0432\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0438 \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u041d \u0423\u0421\u0421\u0420 (\u044d\u0442\u043e\u0442 \u0441\u0442\u0430\u0442\u0443\u0441
    \u043f\u043e\u0437\u0436\u0435 \u0431\u044b\u043b \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u043f\u043e\u0434 \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u0435). \u041e\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438.
    \u041d\u0430\u0446\u0438\u0441\u0442\u0441\u043a\u0430\u044f \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u044f:
    \u0421 \u043f\u0440\u0438\u0445\u043e\u0434\u043e\u043c \u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432
    \u0432 1941 \u0433\u043e\u0434\u0443 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0431\u044b\u043b \u0437\u0430\u043a\u0440\u044b\u0442, \u0438 \u0436\u0438\u0437\u043d\u044c
    \u043f\u043e\u043b\u044c\u0441\u043a\u0438\u0445 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u043e\u0432
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u043f\u043e\u0434 \u0443\u0433\u0440\u043e\u0437\u043e\u0439.
    \u0411\u0430\u043d\u0430\u0445\u0430, \u043a\u0430\u043a \u0438 \u043c\u043d\u043e\u0433\u0438\u0445
    \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433, \u0441\u043f\u0430\u0441\u0430\u043b\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u00ab\u043a\u043e\u0440\u043c\u0438\u0442\u0435\u043b\u0435\u043c
    \u0432\u0448\u0435\u0439\u00bb \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043f\u043e \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e \u0441\u044b\u043f\u043d\u043e\u0433\u043e
    \u0442\u0438\u0444\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0430
    \u0412\u0430\u0439\u0433\u043b\u044f. \u0417\u0430\u0434\u0430\u0447\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044c
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u0440\u043c\u0438\u0442\u044c
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043a\u0440\u043e\u0432\u044c\u044e
    \u0432\u0448\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0434\u043b\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430
    \u0432\u0430\u043a\u0446\u0438\u043d\u044b. \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0434\u0430\u0432\u0430\u043b\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u043e\u0442 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u0421\u043c\u0435\u0440\u0442\u044c: \u041f\u043e\u0441\u043b\u0435 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u041b\u044c\u0432\u043e\u0432\u0430 \u0432 1944 \u0433\u043e\u0434\u0443 \u0411\u0430\u043d\u0430\u0445
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u043a \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044e
    \u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b \u043f\u0435\u0440\u0435\u0435\u0437\u0434
    \u0432 \u041a\u0440\u0430\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u042f\u0433\u0435\u043b\u043b\u043e\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u041e\u0434\u043d\u0430\u043a\u043e
    \u044d\u0442\u0438\u043c \u043f\u043b\u0430\u043d\u0430\u043c \u043d\u0435 \u0441\u0443\u0436\u0434\u0435\u043d\u043e
    \u0431\u044b\u043b\u043e \u0441\u0431\u044b\u0442\u044c\u0441\u044f. \u0412 \u044f\u043d\u0432\u0430\u0440\u0435
    1945 \u0433\u043e\u0434\u0430 \u0443 \u043d\u0435\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u0438\u0445, \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 31 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1945 \u0433\u043e\u0434\u0430. \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u043d\u0430
    \u041b\u044b\u0447\u0430\u043a\u043e\u0432\u0441\u043a\u043e\u043c \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435
    \u0432\u043e \u041b\u044c\u0432\u043e\u0432\u0435.\n\n\U0001F9E0 \u041d\u0430\u0443\u0447\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0418\u043c\u044f \u0411\u0430\u043d\u0430\u0445\u0430
    \u043d\u043e\u0441\u044f\u0442 \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u043d\u044f\u0442\u0438\u0439 \u0438 \u0442\u0435\u043e\u0440\u0435\u043c \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0441\u0440\u0435\u0434\u0438
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445: \u0411\u0430\u043d\u0430\u0445\u043e\u0432\u044b
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0438 \u0431\u0430\u043d\u0430\u0445\u043e\u0432\u044b
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0425\u0430\u043d\u0430-\u0411\u0430\u043d\u0430\u0445\u0430
    \u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0438 \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u043e\u0432. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0411\u0430\u043d\u0430\u0445\u0430-\u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437\u0430
    (\u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0439
    \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u0438). \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u0411\u0430\u043d\u0430\u0445\u0430 \u043e \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u0435. \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0411\u0430\u043d\u0430\u0445\u0430-\u0422\u0430\u0440\u0441\u043a\u043e\u0433\u043e
    (\u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u0438
    \u0448\u0430\u0440\u0430). \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438
    \u043b\u0438\u0446\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u0432\u043f\u0435\u0440\u0435\u0434. \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0411\u0430\u043d\u0430\u0445\u0430 \u0441\u0432\u043e\u0438\u043c
    \u00ab\u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c\u00bb."
  shortBioEn: 
  interestingFactsRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0421\u0442\u0435\u0444\u0430\u043d\u0430
    \u0411\u0430\u043d\u0430\u0445\u0430 \u043f\u043e\u043b\u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0438\u0441\u0442\u043e\u0440\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439. \u041e\u043d \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438
    \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u043c\u0438,
    \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b\u0430
    \u043d\u0430 \u0433\u0440\u0430\u043d\u0438 \u043d\u0430\u0443\u043a\u0438, \u0432\u043e\u0439\u043d\u044b
    \u0438 \u0431\u044b\u0442\u043e\u0432\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438.
    \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u043e \u043d\u0435\u043c:\n\n\U0001F4D6 \u0424\u0430\u043a\u0442 \u21161: \u0417\u0430\u0449\u0438\u0442\u0430
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438, \u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u043d \u043d\u0435 \u0437\u043d\u0430\u043b \u041f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0431\u0430\u0439\u043a\u0430 \u043e \u0411\u0430\u043d\u0430\u0445\u0435. \u041e\u043d
    \u043d\u0435 \u0442\u043e\u0440\u043e\u043f\u0438\u043b\u0441\u044f \u0441 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044f\u043c\u0438,
    \u0438 \u0435\u0433\u043e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f
    \u0443\u0436\u0435 \u043f\u043e\u0447\u0442\u0438 \u0433\u043e\u0434 \u043b\u0435\u0436\u0430\u043b\u0430
    \u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044b. \u0422\u043e\u0433\u0434\u0430
    \u0435\u0433\u043e \u0434\u0440\u0443\u0433 \u0438 \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a
    \u0413\u0443\u0433\u043e \u0428\u0442\u0435\u0439\u043d\u0433\u0430\u0443\u0437 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b
    \u0445\u0438\u0442\u0440\u043e\u0441\u0442\u044c. \u0411\u0430\u043d\u0430\u0445\u0430 \u0437\u0430\u043c\u0430\u043d\u0438\u043b\u0438
    \u0432 \u043a\u0430\u0431\u0438\u043d\u0435\u0442 \u0434\u0435\u043a\u0430\u043d\u0430 \u043f\u043e\u0434
    \u043f\u0440\u0435\u0434\u043b\u043e\u0433\u043e\u043c \"\u043f\u0440\u043e\u0441\u0442\u043e
    \u043f\u043e\u0431\u043e\u043b\u0442\u0430\u0442\u044c\", \u0430 \u0442\u0430\u043c \u0443\u0436\u0435
    \u0441\u0438\u0434\u0435\u043b\u0430 \u0432\u0441\u044f \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u044f. \u041d\u0430\u0447\u0430\u043b\u0430\u0441\u044c
    \u043e\u0436\u0438\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044f
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0435\u043c\u044b. \u0411\u0430\u043d\u0430\u0445, \u043d\u0435 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u044f
    \u043f\u043e\u0434\u0432\u043e\u0445\u0430, \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u0438
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u043b
    \u043d\u0430 \u0432\u0441\u0435 \u043a\u0430\u0432\u0435\u0440\u0437\u043d\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0441\u043e\u0432\u0435\u0442\u0430. \u041b\u0438\u0448\u044c
    \u0432 \u043a\u043e\u043d\u0446\u0435 \u0435\u043c\u0443 \u043e\u0431\u044a\u044f\u0432\u0438\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u043e
    \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0438 \u0441\u0434\u0430\u043b
    \u0432\u0441\u0435 \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u044b.\n\n\U0001F37A \u0424\u0430\u043a\u0442
    \u21162: \u0420\u0430\u0431\u043e\u0442\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0432 \u043a\u0430\u0444\u0435 \u0411\u0430\u043d\u0430\u0445 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043b \u0442\u0438\u0448\u0438\u043d\u0443
    \u0438 \u043d\u0435 \u043b\u044e\u0431\u0438\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0441\u0432\u043e\u0435\u043c \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0435.
    \u0415\u0433\u043e \"\u0440\u0430\u0431\u043e\u0447\u0438\u043c \u043c\u0435\u0441\u0442\u043e\u043c\"
    \u0431\u044b\u043b\u0438 \u0448\u0443\u043c\u043d\u044b\u0435 \u043b\u044c\u0432\u043e\u0432\u0441\u043a\u0438\u0435
    \u043a\u0430\u0444\u0435. \u041e\u043d \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435
    \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0433\u0443\u043b \u0433\u043e\u043b\u043e\u0441\u043e\u0432,
    \u0437\u0432\u043e\u043d \u043f\u043e\u0441\u0443\u0434\u044b \u0438 \u043c\u0443\u0437\u044b\u043a\u0430
    \u043d\u0435 \u043c\u0435\u0448\u0430\u044e\u0442, \u0430, \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442,
    \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u0443\u044e\u0442 \u043c\u044b\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441. \u041e\u043d \u043c\u043e\u0433 \u043f\u0440\u043e\u0441\u0438\u0434\u0435\u0442\u044c
    \u0437\u0430 \u0441\u0442\u043e\u043b\u0438\u043a\u043e\u043c \u0441 \u0443\u0442\u0440\u0430
    \u0434\u043e \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f, \u0430 \u0435\u0441\u043b\u0438
    \u043a\u0430\u0444\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u043e\u0441\u044c,
    \u043e\u043d \u0448\u0435\u043b \u0432 \u043a\u0440\u0443\u0433\u043b\u043e\u0441\u0443\u0442\u043e\u0447\u043d\u044b\u0439
    \u0436\u0435\u043b\u0435\u0437\u043d\u043e\u0434\u043e\u0440\u043e\u0436\u043d\u044b\u0439
    \u0431\u0443\u0444\u0435\u0442. \u041e\u0431\u044b\u0447\u043d\u043e \u043e\u043d \u0437\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u043a\u043e\u0444\u0435 \u0438\u043b\u0438 \u043f\u0438\u0432\u043e \u0438, \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u044f\u0441\u044c
    \u0432 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f, \u0438\u043d\u043e\u0433\u0434\u0430
    \u0443\u043c\u0443\u0434\u0440\u044f\u043b\u0441\u044f \u0441\u0436\u0435\u0447\u044c \u0441\u0432\u043e\u0438
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438, \u043f\u0435\u043f\u0435\u043b \u043e\u0442
    \u0441\u0438\u0433\u0430\u0440\u0435\u0442\u044b \u043f\u0430\u0434\u0430\u043b \u043d\u0430
    \u0431\u0443\u043c\u0430\u0433\u0438, \u0430 \u043e\u043d \u044d\u0442\u043e\u0433\u043e
    \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u043b.\n\n\U0001F4D3
    \u0424\u0430\u043a\u0442 \u21163: \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u00ab\u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0439
    \u043a\u043d\u0438\u0433\u0438\u00bb \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0447\u0430\u0441\u0442\u043e
    \u0442\u0435\u0440\u044f\u043b\u0438 \u0441\u0432\u043e\u0438 \u0438\u0434\u0435\u0438,
    \u043d\u0430\u0446\u0430\u0440\u0430\u043f\u0430\u043d\u043d\u044b\u0435 \u043d\u0430 \u043c\u0440\u0430\u043c\u043e\u0440\u043d\u044b\u0445
    \u0441\u0442\u043e\u043b\u0438\u043a\u0430\u0445 \u043a\u0430\u0444\u0435, \u0436\u0435\u043d\u0430
    \u0411\u0430\u043d\u0430\u0445\u0430, \u041b\u044e\u0446\u0438\u044f, \u043a\u0443\u043f\u0438\u043b\u0430
    \u0434\u043b\u044f \u043d\u0438\u0445 \u0442\u043e\u043b\u0441\u0442\u0443\u044e \u0442\u0435\u0442\u0440\u0430\u0434\u044c
    \u0432 \u043a\u043b\u0435\u0435\u043d\u0447\u0430\u0442\u043e\u0439 \u043e\u0431\u043b\u043e\u0436\u043a\u0435.
    \u042d\u0442\u0430 \u0442\u0435\u0442\u0440\u0430\u0434\u044c \u0441\u0442\u0430\u043b\u0430
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439 \u043d\u0430 \u0432\u0435\u0441\u044c
    \u043c\u0438\u0440 \u00ab\u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0439
    \u043a\u043d\u0438\u0433\u043e\u0439\u00bb. \u0412 \u043d\u0435\u0435 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438
    \u0441\u0430\u043c\u044b\u0435 \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u0417\u0430 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0438\u0437 \u043d\u0438\u0445 \u043f\u043e\u043b\u0430\u0433\u0430\u043b\u0438\u0441\u044c
    \u043f\u0440\u0438\u0437\u044b: \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0436\u0438\u0432\u043e\u0439
    \u0433\u0443\u0441\u044c \u0437\u0430 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0442\u0440\u0443\u0434\u043d\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443. \u041a\u043d\u0438\u0433\u0430 \u043f\u0435\u0440\u0435\u0436\u0438\u043b\u0430
    \u0432\u043e\u0439\u043d\u0443 \u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0412\u0440\u043e\u0446\u043b\u0430\u0432\u0430.\n\n\U0001FA78
    \u0424\u0430\u043a\u0442 \u21164: \u00ab\u041a\u043e\u0440\u043c\u0438\u043b\u0435\u0446
    \u0432\u0448\u0435\u0439\u00bb (\u0421\u043f\u0430\u0441\u0435\u043d\u0438\u0435 \u0447\u0435\u0440\u0435\u0437
    \u043f\u0430\u0440\u0430\u0437\u0438\u0442\u043e\u0432) \u0412\u043e \u0432\u0440\u0435\u043c\u044f
    \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043a\u043e\u0439 \u043e\u043a\u043a\u0443\u043f\u0430\u0446\u0438\u0438
    \u041b\u044c\u0432\u043e\u0432\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0420\u0443\u0434\u043e\u043b\u044c\u0444 \u0412\u0430\u0439\u0433\u043b\u044c \u0438\u0437\u043e\u0431\u0440\u0435\u043b
    \u0432\u0430\u043a\u0446\u0438\u043d\u0443 \u043e\u0442 \u0441\u044b\u043f\u043d\u043e\u0433\u043e
    \u0442\u0438\u0444\u0430. \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0431\u044b\u043b\u0430
    \u0443\u0436\u0430\u0441\u0430\u044e\u0449\u0435\u0439: \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e
    \u043a\u043e\u0440\u043c\u0438\u0442\u044c \u0432\u0448\u0435\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u043a\u0440\u043e\u0432\u044c\u044e, \u0430 \u0437\u0430\u0442\u0435\u043c \u0438\u0437
    \u0438\u0445 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0435\u0439
    \u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0430\u043a\u0446\u0438\u043d\u0443. \u0412\u0430\u0439\u0433\u043b\u044c
    \u043d\u0430\u043d\u044f\u043b \u0433\u0440\u0443\u043f\u043f\u0443 \u0443\u0447\u0435\u043d\u044b\u0445
    \u0434\u043b\u044f \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b. \u0411\u0430\u043d\u0430\u0445,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u043f\u043e\u043b\u044f\u043a\u043e\u043c, \u043d\u0435
    \u043c\u043e\u0433 \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0430 \u0443\u043b\u0438\u0446\u0443
    \u0431\u0435\u0437 \u0440\u0438\u0441\u043a\u0430 \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043b\u044f\u043d\u043d\u044b\u043c,
    \u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0443 \u0412\u0430\u0439\u0433\u043b\u044f
    \u0434\u0430\u0432\u0430\u043b\u0430 \u0435\u043c\u0443 \u00ab\u043a\u0440\u044b\u0448\u0443
    \u043d\u0430\u0434 \u0433\u043e\u043b\u043e\u0432\u043e\u0439\u00bb \u0438 \u0437\u0430\u0449\u0438\u0442\u0443
    \u043e\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u0432 \u043a\u043e\u043d\u0446\u043b\u0430\u0433\u0435\u0440\u044c.
    \u041e\u043d \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0438\u043c
    \u0441\u044b\u043d\u043e\u043c \u0421\u0442\u0435\u0444\u0430\u043d\u043e\u043c \u0441\u0430\u0434\u0438\u043b\u0441\u044f,
    \u0437\u0430\u043a\u0430\u0442\u044b\u0432\u0430\u043b \u0440\u0443\u043a\u0430\u0432\u0430,
    \u0438 \u0435\u0433\u043e \u043a\u0440\u043e\u0432\u044c \u043a\u043e\u0440\u043c\u0438\u043b\u0430
    \u0442\u044b\u0441\u044f\u0447\u0438 \u043d\u0430\u0441\u0435\u043a\u043e\u043c\u044b\u0445.
    \u042d\u0442\u043e \u0441\u043f\u0430\u0441\u043b\u043e \u0435\u043c\u0443 \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F9E0
    \u0424\u0430\u043a\u0442 \u21165: \u0424\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u043a\u043e\u043d\u0441\u043f\u0435\u043a\u0442\u043e\u0432 \u0423 \u0411\u0430\u043d\u0430\u0445\u0430
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c. \u041e\u043d \u043c\u043e\u0433 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0443\u044e \u0441\u0442\u0430\u0442\u044c\u044e,
    \u0437\u0430\u043a\u0440\u044b\u0442\u044c \u0435\u0435 \u0438 \u0442\u0443\u0442 \u0436\u0435
    \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435
    \u0441 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e \u0444\u043e\u0440\u043c\u0443\u043b.
    \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u043f\u043e\u0447\u0442\u0438
    \u043d\u0435 \u043f\u0438\u0441\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0439 \u043d\u0430
    \u0431\u0443\u043c\u0430\u0433\u0435. \u0417\u0430\u0445\u043e\u0434\u044f \u0432 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044e,
    \u043e\u043d \u043c\u043e\u0433 \u0432\u0437\u044f\u0442\u044c \u043a\u0443\u0441\u043e\u043a
    \u043c\u0435\u043b\u0430 \u0438 \u043d\u0430\u0447\u0430\u0442\u044c \u0447\u0438\u0442\u0430\u0442\u044c
    \u043c\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c,
    \u043d\u0435 \u0433\u043b\u044f\u0434\u044f \u0432 \u0437\u0430\u043f\u0438\u0441\u0438,
    \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e
    \u0440\u0435\u0448\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0438 \u043d\u0430 \u0434\u043e\u0441\u043a\u0435.
    \u0421\u0442\u0443\u0434\u0435\u043d\u0442\u044b \u0435\u0433\u043e \u0431\u043e\u0433\u043e\u0442\u0432\u043e\u0440\u0438\u043b\u0438,
    \u043d\u043e \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0437\u0430 \u043d\u0438\u043c
    \u0431\u044b\u043b\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u2014
    \u043e\u043d \u0434\u0438\u043a\u0442\u043e\u0432\u0430\u043b \u0441 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e.\n\n\U0001F3AF \u0424\u0430\u043a\u0442
    \u21166: \u0421\u043a\u0435\u043f\u0442\u0438\u0446\u0438\u0437\u043c \u0438 \u00ab\u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0435\u00bb
    \u0437\u0430\u0434\u0430\u0447\u0438 \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0441\u0442\u0443\u0434\u0435\u043d\u0442
    \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u0411\u0430\u043d\u0430\u0445\u0430: \u00ab\u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440,
    \u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0435 \u043b\u0438 \u0432\u044b, \u0447\u0442\u043e
    \u043c\u043e\u0436\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c \u043b\u044e\u0431\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443?\u00bb
    \u0411\u0430\u043d\u0430\u0445 \u0437\u0430\u0434\u0443\u043c\u0447\u0438\u0432\u043e \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u043d\u0430 \u043d\u0435\u0433\u043e \u0438 \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u0414\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0432\u044b \u043f\u043e\u0432\u0435\u0441\u0438\u0442\u0435
    \u043c\u043d\u0435 \u043d\u0430 \u0448\u0435\u044e \u0442\u0430\u0431\u043b\u0438\u0447\u043a\u0443
    \u0441 \u043f\u0440\u043e\u0441\u044c\u0431\u043e\u0439 \u043e\u0442\u044b\u0441\u043a\u0430\u0442\u044c
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0435
    \u0447\u0438\u0441\u043b\u043e-\u0431\u043b\u0438\u0437\u043d\u0435\u0446 \u0438\u043b\u0438
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0420\u0438\u043c\u0430\u043d\u0430 \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0435
    \u043c\u0435\u043d\u044f \u0432 \u0442\u044e\u0440\u044c\u043c\u0443 \u0434\u043e \u0442\u0435\u0445
    \u043f\u043e\u0440, \u043f\u043e\u043a\u0430 \u044f \u043d\u0435 \u0440\u0435\u0448\u0443
    \u0435\u0451, \u2014 \u044f \u0431\u0443\u0434\u0443 \u0441\u0438\u0434\u0435\u0442\u044c
    \u0442\u0430\u043c \u0432\u0435\u0447\u043d\u043e\u0441\u0442\u044c\u00bb (\u044d\u0442\u043e
    \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u044b\u0439 \u043d\u0430\u043c\u0435\u043a \u043d\u0430
    \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0435 \u0432\u0435\u043b\u0438\u043a\u0438\u0435
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438).\n\n\U0001F3C5
    \u0424\u0430\u043a\u0442 \u21167: \u041f\u043e\u0437\u0434\u043d\u0435\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0432 \u0421\u0421\u0421\u0420 \u0412 1939 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430
    \u041b\u044c\u0432\u043e\u0432 \u0441\u0442\u0430\u043b \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u043c,
    \u0411\u0430\u043d\u0430\u0445 \u0441\u0442\u0430\u043b \u0434\u0435\u043a\u0430\u043d\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0438 \u0431\u044b\u043b
    \u0438\u0437\u0431\u0440\u0430\u043d \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0410\u041d \u0423\u0421\u0421\u0420. \u041e\u0434\u043d\u0430\u043a\u043e \u0438\u0440\u043e\u043d\u0438\u044f
    \u0441\u0443\u0434\u044c\u0431\u044b \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0432
    1958 \u0433\u043e\u0434\u0443 (\u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u0438) \u0435\u0433\u043e \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u0435
    \u043e\u0442\u043c\u0435\u043d\u0438\u043b\u0438 \u0438 \u043b\u0438\u0448\u0438\u043b\u0438
    \u044d\u0442\u043e\u0433\u043e \u0437\u0432\u0430\u043d\u0438\u044f, \u043e\u0431\u044a\u044f\u0432\u0438\u0432
    \u0435\u0433\u043e \"\u0431\u044b\u0432\u0448\u0438\u043c \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c\".
    \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438 \u0435\u0433\u043e
    \u0432 \u044d\u0442\u043e\u043c \u0437\u0432\u0430\u043d\u0438\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0432 1990-\u0445 \u0433\u043e\u0434\u0430\u0445, \u0441\u043f\u0443\u0441\u0442\u044f
    \u043f\u043e\u043b\u0432\u0435\u043a\u0430.\n\n\U0001F48E \u0424\u0430\u043a\u0442 \u21168:
    \u0410\u0444\u043e\u0440\u0438\u0437\u043c, \u0441\u0442\u0430\u0432\u0448\u0438\u0439 \u043a\u0440\u044b\u043b\u0430\u0442\u044b\u043c
    \u0411\u0430\u043d\u0430\u0445 \u043e\u0447\u0435\u043d\u044c \u0442\u043e\u0447\u043d\u043e
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0441\u0443\u0442\u044c
    \u0440\u0430\u0431\u043e\u0442\u044b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.
    \u0415\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f \u0444\u0440\u0430\u0437\u0430
    \u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043a: \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u2014 \u044d\u0442\u043e \u0442\u043e\u0442, \u043a\u0442\u043e \u0443\u043c\u0435\u0435\u0442
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0438
    \u043c\u0435\u0436\u0434\u0443 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f\u043c\u0438;
    \u043b\u0443\u0447\u0448\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u2014 \u0442\u043e\u0442, \u043a\u0442\u043e \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442
    \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432;
    \u0431\u043e\u043b\u0435\u0435 \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u2014 \u0442\u043e\u0442, \u043a\u0442\u043e \u0437\u0430\u043c\u0435\u0447\u0430\u0435\u0442
    \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0438 \u0442\u0435\u043e\u0440\u0438\u0439; \u043d\u043e
    \u0435\u0441\u0442\u044c \u0438 \u0442\u0430\u043a\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0438\u0434\u044f\u0442 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0438
    \u043c\u0435\u0436\u0434\u0443 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u044f\u043c\u0438\u00bb.
    \u042d\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442 \u0438 \u0435\u0433\u043e
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u0442\u0438\u043b\u044c
    \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f."
