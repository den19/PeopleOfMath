    \u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0441\u0443\u0434\u0435\u0431\u043d\u044b\u0445
    \u0442\u044f\u0436\u0431 \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u0435\u0435 \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u0438\u044f.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u0438 \u043f\u043e\u0442\u0440\u044f\u0441\u0435\u043d\u0438\u044f,
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c. \u0412 1619 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u00ab\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u044e
    \u043c\u0438\u0440\u0430\u00bb (Harmonices Mundi), \u0433\u0434\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0442\u0440\u0435\u0442\u0438\u0439, \u0441\u0430\u043c\u044b\u0439
    \u043e\u0431\u0449\u0438\u0439 \u0437\u0430\u043a\u043e\u043d \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442: 3. \u0422\u0440\u0435\u0442\u0438\u0439 \u0437\u0430\u043a\u043e\u043d
    (\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0437\u0430\u043a\u043e\u043d):
    \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u044b \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u0432
    \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u0435\u0442
