  achievementsRu: "\u0418\u043e\u0433\u0430\u043d\u043d \u041a\u0435\u043f\u043b\u0435\u0440 \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u0432\u0442\u043e\u0440 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445
    \u0437\u0430\u043a\u043e\u043d\u043e\u0432, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043c\u0435\u043b\u043e \u0437\u0430\u043c\u0435\u043d\u0438\u043b
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u0440\u0443\u0433\u0438 \u043d\u0430
    \u044d\u043b\u043b\u0438\u043f\u0441\u044b, \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u0438 \u0444\u0438\u0437\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u0435\u043d,
    \u043d\u043e \u0442\u0440\u0438 \u0437\u0430\u043a\u043e\u043d\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442 \u0441\u0442\u0430\u043b\u0438 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435\u043c, \u0441\u0434\u0435\u043b\u0430\u0432\u0448\u0438\u043c
    \u0433\u0435\u043b\u0438\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0442\u0435\u043e\u0440\u0438\u0435\u0439, \u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0435\u0439
    \u043c\u043e\u0434\u0435\u043b\u044c\u044e \u043c\u0438\u0440\u0430.\n\n\U0001FA90 \u0422\u0440\u0438
    \u0437\u0430\u043a\u043e\u043d\u0430 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438:
    \u041e\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043a \u0444\u0438\u0437\u0438\u043a\u0435
    \u042d\u0442\u0438 \u0442\u0440\u0438 \u0437\u0430\u043a\u043e\u043d\u0430 \u0441\u0442\u0430\u043b\u0438
    \u0438\u0442\u043e\u0433\u043e\u043c \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439
    \u0438 \u043a\u0440\u043e\u043f\u043e\u0442\u043b\u0438\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b
    \u041a\u0435\u043f\u043b\u0435\u0440\u0430 \u043d\u0430\u0434 \u0442\u043e\u0447\u043d\u0435\u0439\u0448\u0438\u043c\u0438
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f\u043c\u0438 \u0422\u0438\u0445\u043e
    \u0411\u0440\u0430\u0433\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0437\u0430
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u041c\u0430\u0440\u0441\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043d\u0438\u043a\u0430\u043a \u043d\u0435 \u0432\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u043e\u0441\u044c
    \u0432 \u0434\u0440\u0435\u0432\u043d\u044e\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0445
    \u043a\u0440\u0443\u0433\u043e\u0432. \u041f\u0435\u0440\u0432\u044b\u0439 \u0437\u0430\u043a\u043e\u043d
    (\u0417\u0430\u043a\u043e\u043d \u044d\u043b\u043b\u0438\u043f\u0441\u043e\u0432), \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0432 1609 \u0433\u043e\u0434\u0443 \u0432 \u043a\u043d\u0438\u0433\u0435 \u00ab\u041d\u043e\u0432\u0430\u044f
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f\u00bb, \u0433\u043b\u0430\u0441\u0438\u0442:
    \u041a\u0430\u0436\u0434\u0430\u044f \u043f\u043b\u0430\u043d\u0435\u0442\u0430 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f
    \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0441\u0443, \u0432 \u043e\u0434\u043d\u043e\u043c
    \u0438\u0437 \u0444\u043e\u043a\u0443\u0441\u043e\u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0421\u043e\u043b\u043d\u0446\u0435.
    \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439
    \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f,
    \u0447\u0442\u043e \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0435 \u0442\u0435\u043b\u0430
    \u043e\u0431\u044f\u0437\u0430\u043d\u044b \u0434\u0432\u0438\u0433\u0430\u0442\u044c\u0441\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u043c
    \u043a\u0440\u0443\u0433\u0430\u043c. \u0421\u043e\u043b\u043d\u0446\u0435 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u043e
    \u0431\u044b\u0442\u044c \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u043c\u0438\u0440\u0430,
    \u0441\u043c\u0435\u0441\u0442\u0438\u0432\u0448\u0438\u0441\u044c \u0432 \u0444\u043e\u043a\u0443\u0441
    \u043e\u0440\u0431\u0438\u0442\u044b. \u0412\u0442\u043e\u0440\u043e\u0439 \u0437\u0430\u043a\u043e\u043d
    (\u0417\u0430\u043a\u043e\u043d \u043f\u043b\u043e\u0449\u0430\u0434\u0435\u0439) \u0431\u044b\u043b
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d \u0432 \u0442\u043e\u0439
    \u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0435 \u0438 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438
    \u043f\u043b\u0430\u043d\u0435\u0442\u044b: \u0420\u0430\u0434\u0438\u0443\u0441-\u0432\u0435\u043a\u0442\u043e\u0440
    \u043f\u043b\u0430\u043d\u0435\u0442\u044b (\u043b\u0438\u043d\u0438\u044f, \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u044e\u0449\u0430\u044f
    \u0435\u0435 \u0441 \u0421\u043e\u043b\u043d\u0446\u0435\u043c) \u0437\u0430 \u0440\u0430\u0432\u043d\u044b\u0435
    \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043a\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0440\u0430\u0432\u043d\u044b\u0435
    \u043f\u043b\u043e\u0449\u0430\u0434\u0438. \u041e\u0442\u0441\u044e\u0434\u0430 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u043e,
    \u0447\u0442\u043e \u043f\u043b\u0430\u043d\u0435\u0442\u0430 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f
    \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e \u0432 \u043f\u0435\u0440\u0438\u0433\u0435\u043b\u0438\u0438
    (\u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0435\u0439 \u043a \u0421\u043e\u043b\u043d\u0446\u0443
    \u0442\u043e\u0447\u043a\u0435) \u0438 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u0435\u0435
    \u2014 \u0432 \u0430\u0444\u0435\u043b\u0438\u0438 (\u0441\u0430\u043c\u043e\u0439 \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u0435). \u0422\u0440\u0435\u0442\u0438\u0439 \u0437\u0430\u043a\u043e\u043d
    (\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0437\u0430\u043a\u043e\u043d),
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0432
    1619 \u0433\u043e\u0434\u0443 \u0432 \u0442\u0440\u0443\u0434\u0435 \u00ab\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u044f
    \u043c\u0438\u0440\u0430\u00bb, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u0435\u0434\u0438\u043d\u0443\u044e
    \u0441\u0432\u044f\u0437\u044c \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b:
    \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u044b \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u0432
    \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u0435\u0442
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0421\u043e\u043b\u043d\u0446\u0430 \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f
    \u043a\u0430\u043a \u043a\u0443\u0431\u044b \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043f\u043e\u043b\u0443\u043e\u0441\u0435\u0439
    \u0438\u0445 \u043e\u0440\u0431\u0438\u0442. \u042d\u0442\u043e\u0442 \u0437\u0430\u043a\u043e\u043d
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u0442\u044c
    \u043e\u0440\u0431\u0438\u0442\u044b \u043b\u044e\u0431\u044b\u0445 \u043f\u043b\u0430\u043d\u0435\u0442
    \u0438 \u0434\u0430\u0436\u0435 \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u043e\u0432,
    \u043d\u043e \u0435\u0433\u043e \u0438\u0441\u0442\u0438\u043d\u043d\u044b\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0441\u043c\u044b\u0441\u043b \u0431\u044b\u043b \u0440\u0430\u0441\u043a\u0440\u044b\u0442
    \u043f\u043e\u0437\u0436\u0435. \u042d\u0442\u0438 \u0442\u0440\u0438 \u0437\u0430\u043a\u043e\u043d\u0430
    \u0441\u0442\u0430\u043b\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435\u043c
    \u043a\u0438\u043d\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0430\u0440\u0442\u0438\u043d\u044b
    \u0421\u043e\u043b\u043d\u0435\u0447\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0438 \u043f\u043e\u0437\u0436\u0435 \u043f\u043e\u0441\u043b\u0443\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0418\u0441\u0430\u0430\u043a\u043e\u043c \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u043c
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f.\n\n\U0001F4A1 \u041e\u043f\u0442\u0438\u043a\u0430
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0430: \u041e\u0442 \u0433\u043b\u0430\u0437\u0430
    \u0434\u043e \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430 \u041d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u0432\u044b\u0445\u043e\u0434\u0438\u043b\u0438 \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430
    \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u0432 \u043e\u043f\u0442\u0438\u043a\u0443
    \u0442\u0430\u043a\u0436\u0435 \u0441\u0442\u0430\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c:
    \u0422\u0435\u043e\u0440\u0438\u044f \u0437\u0440\u0435\u043d\u0438\u044f: \u0412 1604 \u0433\u043e\u0434\u0443
    \u0432 \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0435 \u00ab\u0414\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f
    \u043a \u0412\u0438\u0442\u0435\u043b\u043b\u0438\u044e\u00bb \u043e\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043b
    \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0437\u0440\u0435\u043d\u0438\u044f, \u043f\u043e\u043a\u0430\u0437\u0430\u0432,
    \u0447\u0442\u043e \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0441\u0442\u0440\u043e\u0438\u0442\u0441\u044f
    \u043d\u0430 \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0435 \u0433\u043b\u0430\u0437\u0430.
    \u0417\u0430\u043a\u043e\u043d \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u043d\u043e\u0441\u0442\u0438:
    \u0412 \u0442\u043e\u0439 \u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0437\u0430\u043a\u043e\u043d,
    \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443
    \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043e\u0431\u0440\u0430\u0442\u043d\u043e
    \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u0434\u043e \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \u0441\u0432\u0435\u0442\u0430.
    \u0422\u0435\u043b\u0435\u0441\u043a\u043e\u043f \u041a\u0435\u043f\u043b\u0435\u0440\u0430:
    \u0412 1611 \u0433\u043e\u0434\u0443 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u0414\u0438\u043e\u043f\u0442\u0440\u0438\u043a\u0430\u00bb
    \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430
    \u0441 \u0434\u0432\u0443\u043c\u044f \u0434\u0432\u043e\u044f\u043a\u043e\u0432\u044b\u043f\u0443\u043a\u043b\u044b\u043c\u0438
    \u043b\u0438\u043d\u0437\u0430\u043c\u0438. \u042d\u0442\u0430 \u0441\u0445\u0435\u043c\u0430,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043a\u0430\u043a \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0442\u0440\u0443\u0431\u0430 \u041a\u0435\u043f\u043b\u0435\u0440\u0430, \u0434\u0430\u0432\u0430\u043b\u0430
    \u0431\u043e\u043b\u044c\u0448\u0435\u0435 \u043f\u043e\u043b\u0435 \u0437\u0440\u0435\u043d\u0438\u044f
    \u0438 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u043c
    \u0432\u0441\u0435\u0445 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0440\u0435\u0444\u0440\u0430\u043a\u0442\u043e\u0440\u043e\u0432. \u0422\u0435\u043e\u0440\u0438\u044f
    \u043f\u0440\u0438\u043b\u0438\u0432\u043e\u0432: \u041e\u043d \u0432\u044b\u0441\u043a\u0430\u0437\u0430\u043b
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u0434\u043e\u0433\u0430\u0434\u043a\u0443,
    \u0447\u0442\u043e \u043f\u0440\u0438\u043b\u0438\u0432\u044b \u0438 \u043e\u0442\u043b\u0438\u0432\u044b
    \u0432 \u043e\u043a\u0435\u0430\u043d\u0430\u0445 \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043c
    \u041b\u0443\u043d\u044b.\n\n\U0001F58B\ufe0f \u0413\u043b\u0430\u0432\u043d\u044b\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b: \u041a\u043d\u0438\u0433\u0438,
    \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0438\u0435 \u043c\u0438\u0440 \u041f\u043e\u043c\u0438\u043c\u043e
    \u0443\u043f\u043e\u043c\u044f\u043d\u0443\u0442\u044b\u0445 \u0440\u0430\u0431\u043e\u0442,
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u043e\u043d\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432:
    \u00ab\u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u0432\u043e\u0439
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438\u00bb (1618\u20131622): \u042d\u0442\u043e\u0442
    \u0442\u0440\u0435\u0445\u0442\u043e\u043c\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 \u0441\u0442\u0430\u043b
    \u043b\u0443\u0447\u0448\u0438\u043c \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u043e\u043c
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u0442\u043e\u0439 \u044d\u043f\u043e\u0445\u0438.
    \u0412 \u043d\u0435\u043c \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u0435 \u0434\u0432\u0430
    \u0437\u0430\u043a\u043e\u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u044b
    \u043a\u043e \u0432\u0441\u0435\u043c \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u043c,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0417\u0435\u043c\u043b\u044e, \u0430 \u0442\u0440\u0435\u0442\u0438\u0439
    \u2014 \u0434\u0430\u0436\u0435 \u043a \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0430\u043c
    \u042e\u043f\u0438\u0442\u0435\u0440\u0430. \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0430
    \u044d\u0442\u0443 \u043a\u043d\u0438\u0433\u0443 \u0412\u0430\u0442\u0438\u043a\u0430\u043d
    \u0432\u043d\u0435\u0441 \u0435\u0435 \u0432 \u00ab\u0418\u043d\u0434\u0435\u043a\u0441
    \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043d\u044b\u0445 \u043a\u043d\u0438\u0433\u00bb.
    \u00ab\u0420\u0443\u0434\u043e\u043b\u044c\u0444\u043e\u0432\u044b \u0442\u0430\u0431\u043b\u0438\u0446\u044b\u00bb
    (1627): \u0418\u0442\u043e\u0433 22-\u043b\u0435\u0442\u043d\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u044b,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0431\u044b\u043b\u0438 \u0441\u043e\u0431\u0440\u0430\u043d\u044b
    \u0441\u0430\u043c\u044b\u0435 \u0442\u043e\u0447\u043d\u044b\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u041e\u043d\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c
    \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0435\u0442
    \u0441 \u043d\u0435\u0432\u0438\u0434\u0430\u043d\u043d\u043e\u0439 \u0440\u0430\u043d\u0435\u0435
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0438 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0438\u0441\u044c
    \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u0432 \u0438 \u043c\u043e\u0440\u0435\u043f\u043b\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0434\u043e \u043d\u0430\u0447\u0430\u043b\u0430 XIX \u0432\u0435\u043a\u0430. \u00ab\u0421\u0442\u0435\u0440\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0432\u0438\u043d\u043d\u044b\u0445 \u0431\u043e\u0447\u0435\u043a\u00bb (1615): \u0412
    \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u0441\u0432\u043e\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043a \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0435 \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b
    \u043e\u0431\u044a\u0435\u043c\u044b \u0442\u0435\u043b, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0445
    \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u0435\u0447\u0435\u043d\u0438\u0439. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0432\u0430\u0436\u043d\u044b\u043c \u0448\u0430\u0433\u043e\u043c \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f.\n\n\U0001F30C
    \u0418\u0442\u043e\u0433: \u041a\u0435\u043f\u043b\u0435\u0440 \u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u043d\u0430\u0443\u043a\u0430 \u041a\u0435\u043f\u043b\u0435\u0440 \u0441\u0442\u043e\u044f\u043b
    \u043d\u0430 \u043f\u0435\u0440\u0435\u043f\u0443\u0442\u044c\u0435 \u044d\u043f\u043e\u0445:
    \u043c\u0438\u0441\u0442\u0438\u043a, \u0432\u0435\u0440\u0438\u0432\u0448\u0438\u0439 \u0432
    \u0447\u0438\u0441\u043b\u043e\u0432\u0443\u044e \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u044e
    \u043c\u0438\u0440\u0430, \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u0442\u043e\u0440,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0446\u0435\u043d\u043e\u0439 \u043d\u0435\u0438\u043c\u043e\u0432\u0435\u0440\u043d\u044b\u0445
    \u0443\u0441\u0438\u043b\u0438\u0439 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b
    \u043f\u043e\u044d\u0437\u0438\u044e \u043a\u043e\u0441\u043c\u043e\u0441\u0430 \u0432 \u0441\u0442\u0440\u043e\u0433\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u043b
    \u0437\u0430\u043a\u043e\u043d\u044b \u2014 \u043e\u043d \u043f\u0435\u0440\u0432\u044b\u043c
    \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0438\u043b \u043e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u043b\u0435, \u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0439 \u043e\u0442
    \u0421\u043e\u043b\u043d\u0446\u0430, \u0438 \u0437\u0430\u043b\u043e\u0436\u0438\u043b
    \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043e \u043f\u0440\u0438\u0447\u0438\u043d\u043d\u043e\u0441\u0442\u0438
    \u0432 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438, \u0447\u0435\u043c,
    \u043f\u043e \u0441\u0443\u0442\u0438, \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b
    \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438. \u0415\u0433\u043e \u0432\u0435\u0440\u0430
    \u0432 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439
    \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438, \u0434\u0430\u0436\u0435
    \u0432 \u0441\u0430\u043c\u044b\u0445 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445
    \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445,
    \u0431\u044b\u043b\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u0410\u043b\u044c\u0431\u0435\u0440\u0442\u043e\u043c
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c \u00ab\u043d\u0435\u0441\u0440\u0430\u0432\u043d\u0435\u043d\u043d\u043e\u0439\u00bb."
  achievementsEn: 
  personalLifeRu: "\u0416\u0438\u0437\u043d\u044c \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u0432\u044b\u0442\u0430\u0449\u0438\u043b \u0441\u0435\u0431\u044f \u0438\u0437 \u043d\u0438\u0449\u0435\u0442\u044b
    \u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439, \u0447\u0442\u043e\u0431\u044b
    \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0442\u044c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430 \u043e \u043a\u043e\u0441\u043c\u043e\u0441\u0435.
    \u0417\u0430 \u0441\u0442\u0440\u043e\u0433\u0438\u043c\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438
    \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u044c \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f,
    \u043f\u043e\u043b\u043d\u0430\u044f \u0441\u043a\u0438\u0442\u0430\u043d\u0438\u0439 \u0438
    \u043f\u043e\u0442\u0435\u0440\u044c \u0441\u0443\u0434\u044c\u0431\u0430. \u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u0438\u043c \u0435\u0435 \u0448\u0430\u0433 \u0437\u0430
    \u0448\u0430\u0433\u043e\u043c, \u0432 \u043c\u0435\u043b\u044c\u0447\u0430\u0439\u0448\u0438\u0445
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u0445.\n\n\U0001F476
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    (1571\u20131584) \u0418\u043e\u0433\u0430\u043d\u043d \u041a\u0435\u043f\u043b\u0435\u0440
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 27 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1571 \u0433\u043e\u0434\u0430 \u0432 \u0438\u043c\u043f\u0435\u0440\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435 \u0412\u0430\u0439\u043b\u044c-\u0434\u0435\u0440-\u0428\u0442\u0430\u0434\u0442
    (\u043d\u044b\u043d\u0435 \u0437\u0435\u043c\u043b\u044f \u0411\u0430\u0434\u0435\u043d-\u0412\u044e\u0440\u0442\u0435\u043c\u0431\u0435\u0440\u0433,
    \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f). \u041e\u043d \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0441\u0432\u0435\u0442 \u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u043c,
    \u0447\u0435\u0440\u0435\u0437 7 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043f\u043e\u0441\u043b\u0435
    \u0437\u0430\u0447\u0430\u0442\u0438\u044f. \u042d\u0442\u043e \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u043e\u0442\u0440\u0430\u0437\u0438\u043b\u043e\u0441\u044c \u043d\u0430 \u0435\u0433\u043e
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435: \u043e\u043d \u0431\u044b\u043b \u0445\u0440\u0443\u043f\u043a\u0438\u043c,
    \u0447\u0430\u0441\u0442\u043e \u0431\u043e\u043b\u0435\u043b, \u0438\u043c\u0435\u043b
    \u0441\u043b\u0430\u0431\u043e\u0435 \u0437\u0440\u0435\u043d\u0438\u0435 (\u0431\u043b\u0438\u0437\u043e\u0440\u0443\u043a\u043e\u0441\u0442\u044c
    \u0438 \u0434\u0435\u0444\u0435\u043a\u0442\u044b \u0437\u0440\u0435\u043d\u0438\u044f \u0438\u0437-\u0437\u0430
    \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u043e\u0439 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
    \u043e\u0441\u043f\u044b) \u0438 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u0435
    \u0440\u0443\u043a\u0438, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u043e \u0435\u0433\u043e
    \u043d\u0435\u043f\u0440\u0438\u0433\u043e\u0434\u043d\u044b\u043c \u0434\u043b\u044f \u043a\u0440\u043e\u043f\u043e\u0442\u043b\u0438\u0432\u044b\u0445
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439. \u0415\u0433\u043e \u0434\u0435\u0434,
    \u0417\u0435\u0431\u043e\u043b\u044c\u0434 \u041a\u0435\u043f\u043b\u0435\u0440, \u0431\u044b\u043b
    \u0431\u0443\u0440\u0433\u043e\u043c\u0438\u0441\u0442\u0440\u043e\u043c \u0433\u043e\u0440\u043e\u0434\u0430,
    \u043d\u043e \u043a \u043c\u043e\u043c\u0435\u043d\u0442\u0443 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u0441\u0435\u043c\u044c\u044f \u043e\u0431\u0435\u0434\u043d\u0435\u043b\u0430.
    \u041e\u0442\u0435\u0446, \u0413\u0435\u043d\u0440\u0438\u0445 \u041a\u0435\u043f\u043b\u0435\u0440,
    \u0431\u044b\u043b \u0431\u0440\u043e\u0434\u044f\u0447\u0438\u043c \u043d\u0430\u0435\u043c\u043d\u0438\u043a\u043e\u043c-\u043b\u0430\u043d\u0434\u0441\u043a\u043d\u0435\u0445\u0442\u043e\u043c,
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0432\u0441\u043f\u044b\u043b\u044c\u0447\u0438\u0432\u044b\u043c
    \u0438 \u0433\u0440\u0443\u0431\u044b\u043c. \u041c\u0430\u0442\u044c, \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430
    \u0413\u0443\u043b\u044c\u0434\u0435\u043d\u043c\u0430\u043d\u043d, \u0431\u044b\u043b\u0430
    \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u0442\u0440\u0430\u043a\u0442\u0438\u0440\u0449\u0438\u043a\u0430.
    \u041e\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u0446\u0435\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0435\u0439
    \u0438 \u0442\u0440\u0430\u0432\u043d\u0438\u0446\u0435\u0439, \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0430
    \u0442\u0440\u0430\u0432\u044b \u0438 \u0433\u043e\u0442\u043e\u0432\u0438\u043b\u0430 \u0441\u043d\u0430\u0434\u043e\u0431\u044c\u044f,
    \u0447\u0442\u043e \u043f\u043e\u0437\u0436\u0435 \u0441\u044b\u0433\u0440\u0430\u0435\u0442
    \u0440\u043e\u043a\u043e\u0432\u0443\u044e \u0440\u043e\u043b\u044c. \u041a\u043e\u0433\u0434\u0430
    \u0418\u043e\u0433\u0430\u043d\u043d\u0443 \u0431\u044b\u043b\u043e 5 \u043b\u0435\u0442,
    \u043e\u0442\u0435\u0446 \u0443\u0448\u0435\u043b \u0438\u0437 \u0434\u043e\u043c\u0430,
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0432\u0448\u0438\u0441\u044c \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439
    \u0432\u043e\u0435\u043d\u043d\u044b\u0439 \u043f\u043e\u0445\u043e\u0434 \u0432 \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u044b,
    \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    (\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043f\u043e\u0433\u0438\u0431). \u041c\u0430\u043b\u044c\u0447\u0438\u043a\u0430 \u043e\u0442\u0434\u0430\u043b\u0438
    \u043d\u0430 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435 \u0434\u0435\u0434\u0443
    \u043f\u043e \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u043e\u0439 \u043b\u0438\u043d\u0438\u0438.
    \u0421 \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u043e\u043d \u043f\u043e\u0440\u0430\u0436\u0430\u043b \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c\u0438. \u0420\u0430\u0431\u043e\u0442\u0430\u044f
    \u0432 \u0442\u0440\u0430\u043a\u0442\u0438\u0440\u0435 \u0434\u0435\u0434\u0430, \u043c\u0430\u043b\u044c\u0447\u0438\u043a
    \u0432 \u0443\u043c\u0435 \u0440\u0435\u0448\u0430\u043b \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0434\u043b\u044f \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u0435\u0439,
    \u0438 \u0442\u0435 \u0434\u0430\u0432\u0430\u043b\u0438 \u0435\u043c\u0443 \u043d\u0430
    \u0447\u0430\u0439. \u0412 1577 \u0433\u043e\u0434\u0443 \u043c\u0430\u0442\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430
    \u0435\u043c\u0443 \u0441 \u0431\u0430\u043b\u043a\u043e\u043d\u0430 \u0411\u043e\u043b\u044c\u0448\u0443\u044e
    \u043a\u043e\u043c\u0435\u0442\u0443, \u0430 \u0432 1580 \u0433\u043e\u0434\u0443 \u043e\u043d\u0438
    \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b\u0438 \u043b\u0443\u043d\u043d\u043e\u0435
    \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0435 \u2013 \u044d\u0442\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f
    \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b\u0438 \u0432 \u043d\u0435\u043c \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u043d\u0435\u0431\u0443.\n\n\U0001F393
    \u0423\u0447\u0451\u0431\u0430 (1584\u20131594) \u0412 1584 \u0433\u043e\u0434\u0443 \u041a\u0435\u043f\u043b\u0435\u0440
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u043c\u043e\u043d\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u0410\u0434\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0435,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u0432\u044b\u0441\u0448\u0443\u044e \u0448\u043a\u043e\u043b\u0443 \u0432 \u041c\u0430\u0443\u043b\u044c\u0431\u0440\u043e\u043d\u043d\u0435.
    \u041e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u0441\u0443\u0440\u043e\u0432\u044b\u043c,
    \u0430 \u0436\u0438\u0437\u043d\u044c \u2014 \u043f\u043e\u043b\u0443\u0433\u043e\u043b\u043e\u0434\u043d\u043e\u0439,
    \u043d\u043e \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435.
    \u0412 1589 \u0433\u043e\u0434\u0443 \u043e\u043d \u0432\u044b\u0438\u0433\u0440\u0430\u043b
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e (\u0437\u0435\u043c\u0435\u043b\u044c\u043d\u0443\u044e
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u0433\u0435\u0440\u0446\u043e\u0433\u0430
    \u0412\u044e\u0440\u0442\u0435\u043c\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u0433\u043e)
    \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0422\u044e\u0431\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u2014 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u0446\u0435\u043d\u0442\u0440\u043e\u0432
    \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u0439 \u0443\u0447\u0435\u043d\u043e\u0441\u0442\u0438.
    \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u044d\u0442\u0438\u043a\u0443, \u0434\u0438\u0430\u043b\u0435\u043a\u0442\u0438\u043a\u0443
    \u0438 \u0440\u0438\u0442\u043e\u0440\u0438\u043a\u0443, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0443\u0433\u043b\u0443\u0431\u0438\u043b\u0441\u044f \u0432 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e,
    \u0433\u043e\u0442\u043e\u0432\u044f\u0441\u044c \u0441\u0442\u0430\u0442\u044c \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u0438\u043c
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u043c. \u0415\u0433\u043e \u0443\u0441\u043f\u0435\u0445\u0438
    \u0431\u044b\u043b\u0438 \u0441\u0442\u043e\u043b\u044c \u0432\u0435\u043b\u0438\u043a\u0438,
    \u0447\u0442\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043f\u0440\u043e\u0434\u043b\u0435\u0432\u0430\u043b
    \u0435\u043c\u0443 \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u0422\u044e\u0431\u0438\u043d\u0433\u0435\u043d\u0435 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442.
    \u0415\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u043f\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0441\u0442\u0430\u043b \u041c\u0438\u0445\u0430\u044d\u043b\u044c
    \u041c\u0451\u0441\u0442\u043b\u0438\u043d. \u041c\u0451\u0441\u0442\u043b\u0438\u043d \u0442\u0430\u0439\u043d\u043e
    (\u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u044d\u0442\u043e \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u0437\u0430\u043f\u0440\u0435\u0449\u0430\u043b\u043e\u0441\u044c \u0446\u0435\u0440\u043a\u043e\u0432\u044c\u044e)
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u0441 \u0433\u0435\u043b\u0438\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u041d\u0438\u043a\u043e\u043b\u0430\u044f
    \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430. \u041a\u0435\u043f\u043b\u0435\u0440
    \u0431\u044b\u043b \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u043f\u043e\u043a\u043e\u0440\u0435\u043d:
    \u043e\u043d \u0443\u0432\u0438\u0434\u0435\u043b \u0432 \u0433\u0435\u043b\u0438\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0437\u043c\u0435
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0440\u044e\u043a, \u0430 \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043f\u043b\u0430\u043d.\n\n\U0001F3EB \u0420\u0430\u0431\u043e\u0442\u0430. \u0413\u0440\u0430\u0446
    (1594\u20131600): \u041f\u0435\u0440\u0432\u044b\u0439 \u0431\u0440\u0430\u043a \u0438 \"\u0422\u0430\u0439\u043d\u0430
    \u043c\u0438\u0440\u043e\u0437\u0434\u0430\u043d\u0438\u044f\" \u0412 1594 \u0433\u043e\u0434\u0443,
    \u043d\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0432 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043a\u0443\u0440\u0441\u0430 (\u0435\u043c\u0443 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0433\u043e\u0434), \u041a\u0435\u043f\u043b\u0435\u0440
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0435
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u041f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0413\u0440\u0430\u0446
    (\u0410\u0432\u0441\u0442\u0440\u0438\u044f) \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b\u0430
    \u043f\u0440\u0438\u0441\u043b\u0430\u0442\u044c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u041a\u0435\u043f\u043b\u0435\u0440
    \u043d\u0435 \u0445\u043e\u0442\u0435\u043b \u0435\u0445\u0430\u0442\u044c, \u043d\u043e
    \u0446\u0435\u0440\u043a\u043e\u0432\u043d\u044b\u0435 \u0432\u043b\u0430\u0441\u0442\u0438
    \u043d\u0430\u0441\u0442\u043e\u044f\u043b\u0438. \u0412 \u0413\u0440\u0430\u0446\u0435
    \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c. \u0415\u043c\u0443 \u0431\u044b\u043b\u043e 23 \u0433\u043e\u0434\u0430.
    \u0417\u0430\u0440\u043f\u043b\u0430\u0442\u0430 \u0431\u044b\u043b\u0430 \u043c\u0438\u0437\u0435\u0440\u043d\u043e\u0439,
    \u0438 \u043e\u043d \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043f\u043e\u0434\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f\u043e\u0432
    (\u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u043f\u043e \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e, \u0431\u044b\u043b\u0438 \"\u0434\u0435\u0448\u0435\u0432\u043a\u043e\u0439\",
    \u043d\u043e \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u043b\u0438 \u0434\u0435\u043d\u044c\u0433\u0438).
    \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c, 19 \u0438\u044e\u043b\u044f
    1595 \u0433\u043e\u0434\u0430, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043b\u0435\u043a\u0446\u0438\u0438
    \u043e \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f\u0445 \u043f\u043b\u0430\u043d\u0435\u0442,
    \u0435\u0433\u043e \u043e\u0441\u0435\u043d\u0438\u043b\u0430 \u0438\u0434\u0435\u044f,
    \u0447\u0442\u043e \u043c\u0435\u0436\u0434\u0443 \u043e\u0440\u0431\u0438\u0442\u0430\u043c\u0438
    \u043f\u043b\u0430\u043d\u0435\u0442 \u0432\u043b\u043e\u0436\u0435\u043d\u044b \u043f\u044f\u0442\u044c
    \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445 \u043f\u043b\u0430\u0442\u043e\u043d\u043e\u0432\u044b\u0445
    \u0442\u0435\u043b. \u042d\u0442\u0430 \u0438\u0434\u0435\u044f \u043b\u0435\u0433\u043b\u0430
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u043e\u0433\u043e
    \u0442\u0440\u0443\u0434\u0430 \u00ab\u0422\u0430\u0439\u043d\u0430 \u043c\u0438\u0440\u043e\u0437\u0434\u0430\u043d\u0438\u044f\u00bb
    (Mysterium Cosmographicum), \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e
    \u0432 1596 \u0433\u043e\u0434\u0443. \u041a\u043d\u0438\u0433\u0430 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430
    \u0435\u043c\u0443 \u043f\u0435\u0440\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443,
    \u0445\u043e\u0442\u044f \u0440\u0430\u0441\u0447\u0435\u0442\u044b \u0431\u044b\u043b\u0438
    \u043d\u0435\u0442\u043e\u0447\u043d\u044b. \u0412 1597 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0411\u0430\u0440\u0431\u0430\u0440\u0435
    \u041c\u044e\u043b\u043b\u0435\u0440. \u042d\u0442\u043e \u0431\u044b\u043b \u0431\u0440\u0430\u043a
    \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u043b\u044e\u0431\u0432\u0438,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438:
    \u0411\u0430\u0440\u0431\u0430\u0440\u0430 \u0431\u044b\u043b\u0430 23-\u043b\u0435\u0442\u043d\u0435\u0439
    \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0432\u0434\u043e\u0432\u043e\u0439
    \u0441 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439 \u0434\u043e\u0447\u0435\u0440\u044c\u044e.
    \u0415\u0435 \u043e\u0442\u0435\u0446, \u0418\u043e\u0430\u0445\u0438\u043c \u041c\u044e\u043b\u043b\u0435\u0440,
    \u0431\u044b\u043b \u043f\u0440\u043e\u0442\u0438\u0432 \u0431\u0440\u0430\u043a\u0430 \u0441
    \u0431\u0435\u0434\u043d\u044b\u043c \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c, \u043d\u043e
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f \"\u0422\u0430\u0439\u043d\u044b\"
    \u043f\u0435\u0440\u0435\u0443\u0431\u0435\u0434\u0438\u043b\u0430 \u0435\u0433\u043e. \u0412
    \u044d\u0442\u043e\u043c \u0431\u0440\u0430\u043a\u0435 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u043f\u044f\u0442\u0435\u0440\u043e \u0434\u0435\u0442\u0435\u0439, \u043d\u043e \u0432\u044b\u0436\u0438\u043b\u0438
    \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0432\u043e\u0435 \u2014 \u0441\u044b\u043d
    \u0413\u0435\u043d\u0440\u0438\u0445 \u0438 \u0434\u043e\u0447\u044c \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430.
    \u041e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0443\u043c\u0435\u0440\u043b\u0438
    \u0432\u043e \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u0442\u0432\u0435 \u043e\u0442
    \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439. \u0412 1598 \u0433\u043e\u0434\u0443 \u0432
    \u0413\u0440\u0430\u0446\u0435 \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435
    \u0433\u043e\u043d\u0435\u043d\u0438\u044f. \u041a\u043e\u043d\u0442\u0440\u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f
    \u043b\u0438\u0448\u0430\u043b\u0430 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u043e\u0432
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0435\u0439. \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u043b\u0438 \u0438\u0437 \u0441\u043f\u0438\u0441\u043a\u043e\u0432
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u0438
    \u043e\u043d \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0431\u0435\u0437 \u0440\u0430\u0431\u043e\u0442\u044b.\n\n\U0001F451
    \u0420\u0430\u0431\u043e\u0442\u0430. \u041f\u0440\u0430\u0433\u0430 (1600\u20131612): \u0421\u0441\u043e\u0440\u044b
    \u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435 \u041e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c
    \u0431\u0435\u0437 \u0441\u0440\u0435\u0434\u0441\u0442\u0432, \u041a\u0435\u043f\u043b\u0435\u0440
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u041f\u0440\u0430\u0433\u0443,
    \u043a \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c\u0443 \u0434\u0430\u0442\u0441\u043a\u043e\u043c\u0443
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0443 \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043b\u0443\u0436\u0438\u043b \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u043f\u0440\u0438 \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0435
    II. \u041e\u043d\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b\u0438\u0441\u044c
    \u0432 1600 \u0433\u043e\u0434\u0443. \u0418\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e
    \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438. - \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440
    \u0422\u0438\u0445\u043e: \u0411\u0440\u0430\u0433\u0435 \u0431\u044b\u043b \u0434\u0432\u043e\u0440\u044f\u043d\u0438\u043d\u043e\u043c,
    \u0431\u043e\u0433\u0430\u0442\u044b\u043c, \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u043c
    (\u0441 \u0437\u043e\u043b\u043e\u0442\u044b\u043c \u043f\u0440\u043e\u0442\u0435\u0437\u043e\u043c
    \u043d\u043e\u0441\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u043d\u043e\u0441\u0438\u043b
    \u043f\u043e\u0441\u043b\u0435 \u0434\u0443\u044d\u043b\u0438), \u043f\u0440\u0438\u0432\u044b\u043a\u0448\u0438\u043c
    \u043a \u0440\u043e\u0441\u043a\u043e\u0448\u0438 \u0438 \u043f\u043e\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u044e.
    - \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u041a\u0435\u043f\u043b\u0435\u0440\u0430:
    \u0411\u0435\u0434\u043d\u044b\u0439, \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0439,
    \u0432\u0441\u043f\u044b\u043b\u044c\u0447\u0438\u0432\u044b\u0439, \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439,
    \u043d\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439. \u0422\u0438\u0445\u043e
    \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u043d\u043e \u043e\u0431\u0435\u0440\u0435\u0433\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0431\u0435\u0441\u0446\u0435\u043d\u043d\u044b\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f
    (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0434\u0430\u043d\u043d\u044b\u0435 \u043e
    \u041c\u0430\u0440\u0441\u0435) \u0438 \u043d\u0435 \u0445\u043e\u0442\u0435\u043b \u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f
    \u0438\u043c\u0438 \u0441 \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043e\u043c.
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0436\u0438\u043b \u0432 \u041f\u0440\u0430\u0433\u0435
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432 \u043d\u0438\u0449\u0435\u0442\u0435,
    \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044f \u0441\u0435\u0431\u044f \u0443\u043d\u0438\u0436\u0435\u043d\u043d\u044b\u043c
    \u0441\u043b\u0443\u0433\u043e\u0439. \u041a\u0435\u043f\u043b\u0435\u0440 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0422\u0438\u0445\u043e \u0433\u043d\u0435\u0432\u043d\u043e\u0435 \u043f\u0438\u0441\u044c\u043c\u043e,
    \u0433\u0434\u0435 \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0435\u0433\u043e \u0432
    \u0441\u043a\u0430\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438 \u0434\u0435\u0441\u043f\u043e\u0442\u0438\u0437\u043c\u0435,
    \u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u0448\u0435\u043b.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u041a\u0435\u043f\u043b\u0435\u0440 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0431\u044b\u043b \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f, \u043f\u0440\u0438\u0437\u043d\u0430\u0432,
    \u0447\u0442\u043e \u043d\u0438\u0433\u0434\u0435 \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442
    \u043d\u0430\u0439\u0442\u0438 \u043b\u0443\u0447\u0448\u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0445
    \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.
    \u0418\u0445 \u043f\u0440\u0438\u043c\u0438\u0440\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u043e\u0441\u044c,
    \u043d\u043e \u0434\u043b\u0438\u043b\u043e\u0441\u044c \u043d\u0435\u0434\u043e\u043b\u0433\u043e.
    24 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 1601 \u0433\u043e\u0434\u0430 \u0422\u0438\u0445\u043e
    \u0411\u0440\u0430\u0433\u0435 \u0441\u043a\u043e\u0440\u043e\u043f\u043e\u0441\u0442\u0438\u0436\u043d\u043e
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f (\u043f\u043e \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439, \u043e\u0442 \u0440\u0430\u0437\u0440\u044b\u0432\u0430
    \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u0443\u0437\u044b\u0440\u044f, \u043f\u043e
    \u0434\u0440\u0443\u0433\u043e\u0439 \u2014 \u043e\u0442 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f,
    \u0445\u043e\u0442\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0432\u043e\u043b\u043e\u0441
    \u0422\u0438\u0445\u043e \u044d\u0442\u0443 \u0432\u0435\u0440\u0441\u0438\u044e \u043d\u0435
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0442). \u041f\u0435\u0440\u0435\u0434
    \u0441\u043c\u0435\u0440\u0442\u044c\u044e \u0422\u0438\u0445\u043e \u043f\u0435\u0440\u0435\u0434\u0430\u043b
    \u041a\u0435\u043f\u043b\u0435\u0440\u0443 \u0441\u0432\u043e\u0438 \u0434\u0430\u043d\u043d\u044b\u0435
    \u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0435\u0433\u043e \u0441\u0432\u043e\u0438\u043c
    \u043f\u0440\u0435\u0435\u043c\u043d\u0438\u043a\u043e\u043c \u043d\u0430 \u043f\u043e\u0441\u0442\u0443
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430.
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u0441\u0442\u0443\u043f
    \u043a \u0430\u0440\u0445\u0438\u0432\u0430\u043c, \u043d\u043e \u0441\u0435\u043c\u044c\u044f
    \u0422\u0438\u0445\u043e \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b \u0441\u0443\u0434\u0438\u043b\u0430\u0441\u044c
    \u0441 \u043d\u0438\u043c \u0437\u0430 \u043f\u0440\u0430\u0432\u043e \u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u044f
    \u0442\u0430\u0431\u043b\u0438\u0446\u0430\u043c\u0438, \u0438 \u043e\u043d \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0431\u044b\u043b \u0432\u044b\u043a\u0443\u043f\u0430\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435
    \u0443 \u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0438\u043a\u043e\u0432. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u041f\u0440\u0430\u0433\u0435, \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044f
    \u0434\u0430\u043d\u043d\u044b\u0435 \u041c\u0430\u0440\u0441\u0430, \u041a\u0435\u043f\u043b\u0435\u0440
    \u043c\u0435\u0436\u0434\u0443 1601 \u0438 1609 \u0433\u043e\u0434\u0430\u043c\u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0441\u0432\u043e\u0438\u0445 \u043f\u0435\u0440\u0432\u044b\u0445 \u0434\u0432\u0443\u0445
    \u0437\u0430\u043a\u043e\u043d\u043e\u0432. \u0412 \u041f\u0440\u0430\u0433\u0435 \u0436\u0435
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0441\u0432\u043e\u0438 \u0442\u0440\u0443\u0434\u044b
    \u043f\u043e \u043e\u043f\u0442\u0438\u043a\u0435 \u0438 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f. \u0412 1611 \u0433\u043e\u0434\u0443 \u0432
    \u041f\u0440\u0430\u0433\u0435 \u0441\u043b\u0443\u0447\u0438\u043b\u0430\u0441\u044c \u0441\u0435\u0440\u0438\u044f
    \u0443\u0434\u0430\u0440\u043e\u0432 \u0441\u0443\u0434\u044c\u0431\u044b: \u0443\u043c\u0435\u0440
    \u0435\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439
    \u0441\u044b\u043d \u0424\u0440\u0438\u0434\u0440\u0438\u0445, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u043b\u0430 \u0438
    \u0432\u0441\u043a\u043e\u0440\u0435 \u0443\u043c\u0435\u0440\u043b\u0430 \u0435\u0433\u043e
    \u0436\u0435\u043d\u0430 \u0411\u0430\u0440\u0431\u0430\u0440\u0430 \u043e\u0442 \u0441\u044b\u043f\u043d\u043e\u0433\u043e
    \u0442\u0438\u0444\u0430. \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0420\u0443\u0434\u043e\u043b\u044c\u0444
    II, \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c \u041a\u0435\u043f\u043b\u0435\u0440\u0430,
    \u0441\u043e\u0448\u0435\u043b \u0441 \u0443\u043c\u0430 \u0438 \u0431\u044b\u043b \u0441\u0432\u0435\u0440\u0433\u043d\u0443\u0442
    \u0431\u0440\u0430\u0442\u043e\u043c. \u041a\u0435\u043f\u043b\u0435\u0440 \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u0431\u0435\u0437 \u0437\u0430\u0449\u0438\u0442\u044b \u0438 \u0431\u0435\u0437 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044f.\n\n\U0001F4DC
    \u0420\u0430\u0431\u043e\u0442\u0430. \u041b\u0438\u043d\u0446 (1612\u20131626): \u0412\u0442\u043e\u0440\u043e\u0439
    \u0431\u0440\u0430\u043a, \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043e \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u0435
    \u0438 \"\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u044f \u043c\u0438\u0440\u0430\" \u0412
    1612 \u0433\u043e\u0434\u0443 \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0433\u043e\u0440\u043e\u0434 \u041b\u0438\u043d\u0446, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0412\u0435\u0440\u0445\u043d\u0435\u0439
    \u0410\u0432\u0441\u0442\u0440\u0438\u0438. \u042d\u0442\u043e \u0431\u044b\u043b \u043c\u0435\u043d\u0435\u0435
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439, \u043d\u043e \u0431\u043e\u043b\u0435\u0435
    \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0441\u0442. \u0412
    1613 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432\u043e
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437 \u043d\u0430 \u0421\u044e\u0437\u0430\u043d\u043d\u0435
    \u0420\u043e\u0439\u0442\u0438\u043d\u0433\u0435\u0440, \u0434\u043e\u0447\u0435\u0440\u0438
    \u0440\u0435\u0437\u0447\u0438\u043a\u0430 \u043f\u043e \u0434\u0435\u0440\u0435\u0432\u0443.
    \u042d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c, \u0421\u044e\u0437\u0430\u043d\u043d\u0430
    \u0431\u044b\u043b\u0430 \u0437\u0430\u0431\u043e\u0442\u043b\u0438\u0432\u043e\u0439, \u043d\u043e
    \u0438 \u0432 \u044d\u0442\u043e\u043c \u0431\u0440\u0430\u043a\u0435 \u0438\u0437 \u0441\u0435\u043c\u0438
    \u0440\u043e\u0434\u0438\u0432\u0448\u0438\u0445\u0441\u044f \u0434\u0435\u0442\u0435\u0439
    \u0432\u044b\u0436\u0438\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0432\u043e\u0435.
    \u0421\u0430\u043c\u0430\u044f \u0442\u0435\u043c\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c
    \u0432 1615 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e
    \u043c\u0430\u0442\u044c, \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430 \u041a\u0435\u043f\u043b\u0435\u0440,
    \u0431\u044b\u043b\u0430 \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u0430\u043d\u0430 \u043f\u043e
    \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044e \u0432 \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u0435.
    \u041a\u0442\u043e-\u0442\u043e \u0438\u0437 \u0441\u043e\u0441\u0435\u0434\u0435\u0439
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0435\u0435 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e
    \u043e\u043d\u0430 \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u0438\u043b\u0430 \"\u0434\u044c\u044f\u0432\u043e\u043b\u044c\u0441\u043a\u043e\u0435
    \u0437\u0435\u043b\u044c\u0435\". \u041d\u0430\u0447\u0430\u043b\u0441\u044f \u0441\u0443\u0434\u0435\u0431\u043d\u044b\u0439
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441, \u0434\u043b\u0438\u0432\u0448\u0438\u0439\u0441\u044f
    \u0446\u0435\u043b\u044b\u0445 6 \u043b\u0435\u0442 (\u0434\u043e 1621 \u0433\u043e\u0434\u0430).
    \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0435 \u0433\u0440\u043e\u0437\u0438\u043b\u0430
    \u043a\u0430\u0437\u043d\u044c \u0447\u0435\u0440\u0435\u0437 \u0441\u043e\u0436\u0436\u0435\u043d\u0438\u0435.
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e
    \u043f\u0440\u0435\u0440\u0432\u0430\u043b \u0432\u0441\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0437\u0430\u043d\u044f\u0442\u0438\u044f \u0438 \u0431\u0440\u043e\u0441\u0438\u043b \u0432\u0441\u0435
    \u0441\u0438\u043b\u044b \u043d\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u043c\u0430\u0442\u0435\u0440\u0438.
    \u041e\u043d \u043b\u0438\u0447\u043d\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u043e\u0437\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b
    \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u0434\u0435\u043b\u0430, \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u043b
    \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u043e\u0432 \u0438 \u0434\u0430\u0436\u0435 \u043f\u0435\u0440\u0435\u0432\u0435\u0437
    \u043c\u0430\u0442\u044c \u0432 \u041b\u0438\u043d\u0446, \u0447\u0442\u043e\u0431\u044b
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u0434 \u0435\u0433\u043e \u043f\u0440\u0438\u0441\u043c\u043e\u0442\u0440\u043e\u043c.
    \u0412 1621 \u0433\u043e\u0434\u0443, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0435\u0433\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u043c \u0443\u0441\u0438\u043b\u0438\u044f\u043c
    \u0438 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u0437\u0432\u043e\u0440\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u0438,
    \u0441\u0443\u0434 \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043b \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0443.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u043f\u044b\u0442\u043e\u043a
    \u0438 \u0434\u043e\u043b\u0433\u043e\u0433\u043e \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u043b\u043e\u043c\u043b\u0435\u043d\u0430
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u0438 \u0443\u043c\u0435\u0440\u043b\u0430
    \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432
    \u043f\u043e\u0441\u043b\u0435 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u044f.
    \u0412 \u044d\u0442\u043e\u0442 \u0436\u0435 \u0442\u044f\u0436\u0435\u043b\u044b\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 (1619) \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0439 \u0442\u0440\u0443\u0434
    \u00ab\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u044f \u043c\u0438\u0440\u0430\u00bb, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439
    \u0422\u0440\u0435\u0442\u0438\u0439 \u0437\u0430\u043a\u043e\u043d \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442. \u0412 1626 \u0433\u043e\u0434\u0443, \u0432 \u0440\u0430\u0437\u0433\u0430\u0440
    \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u0438\u043b\u0435\u0442\u043d\u0435\u0439 \u0432\u043e\u0439\u043d\u044b,
    \u041b\u0438\u043d\u0446 \u0431\u044b\u043b \u043e\u0441\u0430\u0436\u0434\u0435\u043d,
    \u0433\u043e\u0440\u043e\u0434 \u0432\u0437\u0431\u0443\u043d\u0442\u043e\u0432\u0430\u043b\u0441\u044f,
    \u0438 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u043e\u0432 \u0438\u0437\u0433\u043d\u0430\u043b\u0438.
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0441 \u0441\u0435\u043c\u044c\u0435\u0439 \u0431\u0435\u0436\u0430\u043b,
    \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435
    \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e.\n\n\U0001F6B6\u200d\u2642\ufe0f
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c
    (1626\u20131630) \u0421\u0435\u043c\u044c\u044f \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u0436\u0438\u043b\u0430 \u0432 \u0441\u043a\u0438\u0442\u0430\u043d\u0438\u044f\u0445.
    \u041e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0423\u043b\u044c\u043c,
    \u0433\u0434\u0435 \u0432 1627 \u0433\u043e\u0434\u0443 \u043d\u0430\u043a\u043e\u043d\u0435\u0446
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u2014 \u00ab\u0420\u0443\u0434\u043e\u043b\u044c\u0444\u043e\u0432\u044b
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b\u00bb, \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0435
    \u0432 \u0447\u0435\u0441\u0442\u044c \u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0433\u043e
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0430.
    \u0417\u0430 \u044d\u0442\u0443 \u0440\u0430\u0431\u043e\u0442\u0443 \u0435\u043c\u0443
    \u043f\u043e\u043b\u0430\u0433\u0430\u043b\u043e\u0441\u044c \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0435 \u043e\u0442
    \u043a\u0430\u0437\u043d\u044b, \u043d\u043e \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u043a\u0430\u0437\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u0443\u0441\u0442\u0430 \u0438\u0437-\u0437\u0430
    \u0432\u043e\u0439\u043d\u044b. \u041e\u0442\u0447\u0430\u044f\u0432\u0448\u0438\u0441\u044c
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u0435\u043d\u044c\u0433\u0438, \u0432
    1628 \u0433\u043e\u0434\u0443 \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0443 \u043a \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c\u0443
    \u043f\u043e\u043b\u043a\u043e\u0432\u043e\u0434\u0446\u0443 \u0410\u043b\u044c\u0431\u0440\u0435\u0445\u0442\u0443
    \u0444\u043e\u043d \u0412\u0430\u043b\u043b\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u0443
    \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u043e\u0433\u043e
    \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0430. \u041f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0433\u043e\u0440\u043e\u0434 \u0421\u0430\u0433\u0430\u043d (\u0421\u0438\u043b\u0435\u0437\u0438\u044f,
    \u043d\u044b\u043d\u0435 \u041f\u043e\u043b\u044c\u0448\u0430). \u041a\u0435\u043f\u043b\u0435\u0440
    \u043f\u0440\u0435\u0437\u0438\u0440\u0430\u043b \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u044e
    \u043a\u0430\u043a \u043d\u0430\u0443\u043a\u0443, \u043d\u043e \u043a\u0430\u043a \u0440\u0435\u043c\u0435\u0441\u043b\u043e
    \u043e\u043d\u0430 \u043a\u043e\u0440\u043c\u0438\u043b\u0430 \u0435\u0433\u043e. \u041e\u043d
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f\u044b
    \u0434\u043b\u044f \u0412\u0430\u043b\u043b\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u0430,
    \u0445\u043e\u0442\u044f \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435
    \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \"\u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u044f
    \u2014 \u0433\u043b\u0443\u043f\u0430\u044f \u0434\u043e\u0447\u043a\u0430 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438,
    \u043d\u043e \u0431\u0435\u0437 \u043d\u0435\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f,
    \u043a\u0430\u043a \u043c\u0430\u0442\u044c, \u0443\u043c\u0435\u0440\u043b\u0430 \u0431\u044b
    \u0441 \u0433\u043e\u043b\u043e\u0434\u0443\". \u0412 \u043e\u043a\u0442\u044f\u0431\u0440\u0435
    1630 \u0433\u043e\u0434\u0430, \u043d\u0430\u0434\u0435\u044f\u0441\u044c \u0432\u0441\u0435-\u0442\u0430\u043a\u0438
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0447\u0430\u0441\u0442\u044c \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u044c\u044f
    \u0443 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430, \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0420\u0435\u0433\u0435\u043d\u0441\u0431\u0443\u0440\u0433. 15 \u043d\u043e\u044f\u0431\u0440\u044f
    \u043e\u043d \u043f\u0440\u0438\u0431\u044b\u043b \u0432 \u0433\u043e\u0440\u043e\u0434.
    \u041e\u043d \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0438\u043b\u0441\u044f
    \u0432 \u0434\u043e\u0440\u043e\u0433\u0435, \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c
    \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430. 15 \u043d\u043e\u044f\u0431\u0440\u044f
    1630 \u0433\u043e\u0434\u0430 \u0418\u043e\u0433\u0430\u043d\u043d \u041a\u0435\u043f\u043b\u0435\u0440
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0446\u0435
    \u0432 \u0420\u0435\u0433\u0435\u043d\u0441\u0431\u0443\u0440\u0433\u0435, \u043d\u0435
    \u0434\u043e\u0436\u0438\u0432 \u0434\u043e 59 \u043b\u0435\u0442. \u0411\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439
    \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u0433\u0440\u043e\u0431\u043d\u0438\u0446\u0430,
    \u0433\u0434\u0435 \u0435\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0438\u043b\u0438,
    \u0431\u044b\u043b\u0430 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0430 \u0430\u0440\u043c\u0438\u0435\u0439
    \u0448\u0432\u0435\u0434\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u044f
    \u0413\u0443\u0441\u0442\u0430\u0432\u0430-\u0410\u0434\u043e\u043b\u044c\u0444\u0430 \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u0438\u043b\u0435\u0442\u043d\u0435\u0439
    \u0432\u043e\u0439\u043d\u044b, \u0438 \u0442\u043e\u0447\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e
    \u0435\u0433\u043e \u0437\u0430\u0445\u043e\u0440\u043e\u043d\u0435\u043d\u0438\u044f \u0443\u0442\u0435\u0440\u044f\u043d\u043e
    \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430. \u0421\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c
    \u043b\u0438\u0448\u044c \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0440\u0443\u0447\u043d\u043e
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u043d\u0430\u044f \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f:
    > \u00ab\u042f \u043c\u0435\u0440\u0438\u043b \u043d\u0435\u0431\u0435\u0441\u0430, \u0442\u0435\u043f\u0435\u0440\u044c
    \u043c\u0435\u0440\u044f\u044e \u0442\u0435\u043d\u0438. / \u0414\u0443\u0445\u043e\u043c
    \u0431\u044b\u043b \u044f \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u043c, \u0442\u0435\u043b\u043e
    \u0437\u0434\u0435\u0441\u044c \u043f\u043e\u043a\u043e\u0438\u0442\u0441\u044f \u0437\u0435\u043c\u043d\u043e\u0435\u00bb.\n\n\U0001F91D
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u044b\u043c\u0438 - \u041c\u0438\u0445\u0430\u044d\u043b\u044c
    \u041c\u0451\u0441\u0442\u043b\u0438\u043d (\u0443\u0447\u0438\u0442\u0435\u043b\u044c):
    \u0421\u0430\u043c\u0430\u044f \u0442\u0435\u043f\u043b\u0430\u044f, \u043f\u043e\u0447\u0442\u0438
    \u0441\u044b\u043d\u043e\u0432\u044c\u044f \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f.
    \u041c\u0451\u0441\u0442\u043b\u0438\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u041a\u0435\u043f\u043b\u0435\u0440\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c,
    \u043e\u043d\u0438 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438\u0441\u044c,
    \u0438 \u041a\u0435\u043f\u043b\u0435\u0440 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441
    \u0431\u043b\u0430\u0433\u043e\u0433\u043e\u0432\u0435\u043d\u0438\u0435\u043c \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b
    \u043e \u043d\u0435\u043c. - \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435 (\u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430): \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u043e\u0442 \"\u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0439 \u0432\u043e\u0439\u043d\u044b\"
    \u0434\u043e \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u044e\u0437\u0430.
    \u041d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u044c \u043a \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0443
    \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0430\u043b\u0430\u0441\u044c
    \u0441 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u043a \u0434\u0430\u043d\u043d\u044b\u043c
    \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u0411\u0435\u0437 \u0422\u0438\u0445\u043e
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u044b \u0437\u0430\u043a\u043e\u043d\u043e\u0432
    \u041a\u0435\u043f\u043b\u0435\u0440\u0430, \u0431\u0435\u0437 \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u0434\u0430\u043d\u043d\u044b\u0435 \u0422\u0438\u0445\u043e \u0442\u0430\u043a \u0438
    \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u0431\u044b \u0433\u0440\u0443\u0434\u043e\u0439
    \u0446\u0438\u0444\u0440. - \u0413\u0430\u043b\u0438\u043b\u0435\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    (\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a): \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u043e\u0447\u043d\u044b\u0435 \u0438 \u043a\u0440\u0430\u0439\u043d\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043d\u044b\u0435.
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u043e\u0441\u043b\u0430\u043b \u0413\u0430\u043b\u0438\u043b\u0435\u044e
    \u0432 \u043f\u043e\u0434\u0430\u0440\u043e\u043a \u0441\u0432\u043e\u044e \"\u0422\u0430\u0439\u043d\u0443\",
    \u0413\u0430\u043b\u0438\u043b\u0435\u0439 \u0435\u0433\u043e \u0445\u0432\u0430\u043b\u0438\u043b,
    \u043d\u043e \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u0442\u044c
    \u0437\u0430\u043a\u043e\u043d\u044b \u041a\u0435\u043f\u043b\u0435\u0440\u0430 (\u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u043d\u0430 \u043f\u043e\u0437\u0438\u0446\u0438\u044f\u0445 \u043a\u0440\u0443\u0433\u043e\u0432\u044b\u0445
    \u043e\u0440\u0431\u0438\u0442). \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u0440\u043e\u0441\u0438\u043b
    \u0443 \u0413\u0430\u043b\u0438\u043b\u0435\u044f \u0435\u0433\u043e \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0442\u0440\u0443\u0431\u0443, \u043d\u043e \u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0441\u0442\u0440\u0443\u0441\u0438\u043b \u0438 \u043d\u0435 \u043f\u043e\u0434\u0435\u043b\u0438\u043b\u0441\u044f
    \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0435\u0439. \u041a\u0435\u043f\u043b\u0435\u0440
    \u0437\u043b\u0438\u043b\u0441\u044f \u043d\u0430 \u043d\u0435\u0433\u043e \u0437\u0430
    \u0442\u0440\u0443\u0441\u043e\u0441\u0442\u044c (\u0413\u0430\u043b\u0438\u043b\u0435\u0439
    \u0441\u043a\u0440\u044b\u0432\u0430\u043b \u0441\u0432\u043e\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f),
    \u0445\u043e\u0442\u044f \u0438 \u0432\u043e\u0441\u0445\u0438\u0449\u0430\u043b\u0441\u044f
    \u0435\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f\u043c\u0438 \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u043e\u0432
    \u042e\u043f\u0438\u0442\u0435\u0440\u0430. - \u0418\u0441\u0430\u0430\u043a \u041d\u044c\u044e\u0442\u043e\u043d
    (\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c): \u041e\u043d\u0438
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0438\u0441\u044c
    (\u041d\u044c\u044e\u0442\u043e\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432
    \u0433\u043e\u0434 \u0441\u043c\u0435\u0440\u0442\u0438 \u041a\u0435\u043f\u043b\u0435\u0440\u0430).
    \u041e\u0434\u043d\u0430\u043a\u043e \u041d\u044c\u044e\u0442\u043e\u043d \u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u0443\u0447\u0438\u043b \u0442\u0440\u0443\u0434\u044b \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u0438, \u0432\u044b\u0432\u0435\u0434\u044f \u0437\u0430\u043a\u043e\u043d \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f, \u043f\u0440\u044f\u043c\u043e \u0441\u0441\u044b\u043b\u0430\u043b\u0441\u044f
    \u043d\u0430 \"\u0442\u0440\u0438 \u0437\u0430\u043a\u043e\u043d\u0430 \u041a\u0435\u043f\u043b\u0435\u0440\u0430\"
    \u043a\u0430\u043a \u043d\u0430 \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0431\u0430\u0437\u0443 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438."
  personalLifeEn: 
  shortBioRu: "\u0418\u043e\u0433\u0430\u043d\u043d \u041a\u0435\u043f\u043b\u0435\u0440 (1571\u20131630)
    \u2014 \u0444\u0438\u0433\u0443\u0440\u0430, \u0441\u0442\u043e\u044f\u0449\u0430\u044f
    \u043d\u0430 \u0441\u0442\u044b\u043a\u0435 \u044d\u043f\u043e\u0445. \u0415\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a
    \u0441 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043a\u043b\u0430\u0434\u043e\u043c
    \u0443\u043c\u0430, \u0432\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0439 \u0442\u0435\u0440\u043f\u0435\u043d\u0438\u0435\u043c
    \u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, \u0437\u0430\u043c\u0435\u043d\u0438\u043b
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u0440\u0443\u0433\u0438 \u043d\u0430
    \u044d\u043b\u043b\u0438\u043f\u0441\u044b \u0438 \u0442\u0435\u043c \u0441\u0430\u043c\u044b\u043c
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438,
    \u0441\u043e\u0437\u0434\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0433\u043e
    \u0442\u044f\u0433\u043e\u0442\u0435\u043d\u0438\u044f \u041d\u044c\u044e\u0442\u043e\u043d\u0430.\n\n\U0001F9EC
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b: \u0411\u043e\u043b\u0435\u0437\u043d\u0438,
    \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0435\u0440\u0432\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0437\u0432\u0435\u0437\u0434\u0430\u043c
    \u0418\u043e\u0433\u0430\u043d\u043d \u041a\u0435\u043f\u043b\u0435\u0440 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    27 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1571 \u0433\u043e\u0434\u0430 \u0432 \u0438\u043c\u043f\u0435\u0440\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435 \u0412\u0430\u0439\u043b\u044c-\u0434\u0435\u0440-\u0428\u0442\u0430\u0434\u0442
    (\u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e \u043e\u0442 \u0428\u0442\u0443\u0442\u0433\u0430\u0440\u0442\u0430)
    \u0432 \u043e\u0431\u0435\u0434\u043d\u0435\u0432\u0448\u0435\u0439 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435. \u0415\u0433\u043e \u0434\u0435\u0442\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u043e \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u043e \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u044f\u043c\u0438. \u041e\u0442\u0435\u0446,
    \u0413\u0435\u043d\u0440\u0438\u0445 \u041a\u0435\u043f\u043b\u0435\u0440, \u0431\u044b\u043b
    \u043d\u0430\u0435\u043c\u043d\u0438\u043a\u043e\u043c \u0438 \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0441\u0435\u043c\u044c\u044e, \u043a\u043e\u0433\u0434\u0430 \u0418\u043e\u0433\u0430\u043d\u043d\u0443
    \u0431\u044b\u043b\u043e \u043f\u044f\u0442\u044c \u043b\u0435\u0442 (\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e,
    \u043e\u043d \u043f\u043e\u0433\u0438\u0431 \u043d\u0430 \u0432\u043e\u0439\u043d\u0435).
    \u041c\u0430\u0442\u044c, \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0430 \u0413\u0443\u043b\u044c\u0434\u0435\u043d\u043c\u0430\u043d\u043d,
    \u0434\u043e\u0447\u044c \u0442\u0440\u0430\u043a\u0442\u0438\u0440\u0449\u0438\u043a\u0430,
    \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043b\u0430 \u043d\u0430 \u0436\u0438\u0437\u043d\u044c
    \u043a\u0430\u043a \u0446\u0435\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430
    \u0438 \u0442\u0440\u0430\u0432\u043d\u0438\u0446\u0430. \u041f\u043e\u0437\u0436\u0435,
    \u0432 \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u0434\u043b\u044f \u0441\u0435\u043c\u044c\u0438
    \u043f\u0435\u0440\u0438\u043e\u0434, \u0435\u0435 \u043e\u0431\u0432\u0438\u043d\u0438\u043b\u0438
    \u0432 \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u0435, \u0438 \u041a\u0435\u043f\u043b\u0435\u0440\u0443
    \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u0442\u044c
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u0443\u0441\u0438\u043b\u0438\u044f, \u0447\u0442\u043e\u0431\u044b
    \u0441\u043f\u0430\u0441\u0442\u0438 \u0435\u0435 \u043e\u0442 \u043a\u043e\u0441\u0442\u0440\u0430.
    \u0420\u043e\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044f \u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u043c
    \u0438 \u043e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u044b\u043c, \u043e\u043d
    \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441
    \u043e\u0441\u043f\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u043e\u0441\u043b\u0430\u0431\u0438\u043b\u0430 \u0435\u0433\u043e \u0437\u0440\u0435\u043d\u0438\u0435
    \u0438 \u043f\u043e\u0432\u0440\u0435\u0434\u0438\u043b\u0430 \u0440\u0443\u043a\u0438,
    \u0441\u0434\u0435\u043b\u0430\u0432 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u0435\u043b\u044f-\u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u044d\u0442\u043e \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c \u0443\u043c\u043e\u043c. \u0415\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0431\u044b\u043b\u0438 \u0441\u0442\u043e\u043b\u044c \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b,
    \u0447\u0442\u043e \u043e\u043d \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u0440\u0430\u0436\u0430\u043b
    \u0438\u043c\u0438 \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u0435\u0439 \u0432
    \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0446\u0435 \u0434\u0435\u0434\u0430. \u0418\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043d\u0435\u0431\u0443 \u043f\u0440\u043e\u0441\u043d\u0443\u043b\u0441\u044f \u0440\u0430\u043d\u043e:
    \u0432 1577 \u0433\u043e\u0434\u0443 \u043c\u0430\u0442\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430
    \u0435\u043c\u0443 \u0412\u0435\u043b\u0438\u043a\u0443\u044e \u043a\u043e\u043c\u0435\u0442\u0443,
    \u0430 \u0432 1580 \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b
    \u043b\u0443\u043d\u043d\u043e\u0435 \u0437\u0430\u0442\u043c\u0435\u043d\u0438\u0435.\n\n\U0001F393
    \u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0422\u044e\u0431\u0438\u043d\u0433\u0435\u043d\u0430:
    \u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439
    \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430 \u0412 1589 \u0433\u043e\u0434\u0443
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    \u0422\u044e\u0431\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u0438 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e, \u0433\u043e\u0442\u043e\u0432\u044f\u0441\u044c
    \u0441\u0442\u0430\u0442\u044c \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u0438\u043c
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u043e\u043c. \u041e\u043d \u0431\u044b\u043b
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u043c,
    \u0438 \u0435\u0433\u043e \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u043f\u0440\u043e\u0434\u043b\u0435\u0432\u0430\u043b\u0438
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0443\u0441\u043f\u0435\u0445\u0430\u043c. \u0418\u043c\u0435\u043d\u043d\u043e \u0432
    \u0422\u044e\u0431\u0438\u043d\u0433\u0435\u043d\u0435 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e
    \u0441\u043e\u0431\u044b\u0442\u0438\u0435, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432\u0448\u0435\u0435
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c: \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u041c\u0438\u0445\u0430\u044d\u043b\u044c
    \u041c\u0451\u0441\u0442\u043b\u0438\u043d, \u0442\u0430\u0439\u043d\u044b\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a
    \u0433\u0435\u043b\u0438\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0437\u043c\u0430, \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b
    \u041a\u0435\u043f\u043b\u0435\u0440\u0430 \u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439
    \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430. \u041a\u0435\u043f\u043b\u0435\u0440
    \u0441\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u043a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430\u043d\u0446\u0435\u043c, \u0432\u0438\u0434\u044f
    \u0432 \u044d\u0442\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0434\u043e\u0431\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u043e\u0434\u0435\u043b\u044c, \u0430 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0437\u0430\u043c\u044b\u0441\u043b\u0430.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0436\u0435\u043b\u0430\u043d\u0438\u0435
    \u0441\u0442\u0430\u0442\u044c \u043f\u0430\u0441\u0442\u043e\u0440\u043e\u043c, \u0435\u0433\u043e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0441\u043b\u043e\u0436\u0438\u043b\u0430\u0441\u044c
    \u0438\u043d\u0430\u0447\u0435. \u0412 1594 \u0433\u043e\u0434\u0443, \u0435\u0449\u0435
    \u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u0435\u0433\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043b\u0438
    \u043d\u0430 \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0432 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u0432 \u0413\u0440\u0430\u0446\u0435 (\u0410\u0432\u0441\u0442\u0440\u0438\u044f).
    \u0415\u043c\u0443 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u043f\u0440\u0438\u043d\u044f\u0442\u044c
    \u044d\u0442\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435.\n\n\U0001F4D0
    \u0413\u0440\u0430\u0446 (1594\u20131600): \u00ab\u041a\u043e\u0441\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0442\u0430\u0439\u043d\u0430\u00bb \u0438 \u0431\u0440\u0430\u043a \u0412 \u0413\u0440\u0430\u0446\u0435
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u044e
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u0417\u0434\u0435\u0441\u044c
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0440\u0430\u043d\u043d\u0435\u0435 \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0435. 19
    \u0438\u044e\u043b\u044f 1595 \u0433\u043e\u0434\u0430, \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044f
    \u043d\u0430 \u0443\u0440\u043e\u043a\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f
    \u042e\u043f\u0438\u0442\u0435\u0440\u0430 \u0438 \u0421\u0430\u0442\u0443\u0440\u043d\u0430,
    \u043e\u043d \u0437\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0435
    \u043c\u043d\u043e\u0433\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u043e\u0440\u0431\u0438\u0442\u044b
    \u043f\u043b\u0430\u043d\u0435\u0442. \u0420\u0430\u0437\u0432\u0438\u0432 \u044d\u0442\u0443
    \u0438\u0434\u0435\u044e, \u043e\u043d \u043f\u0440\u0438\u0448\u0435\u043b \u043a \u0432\u044b\u0432\u043e\u0434\u0443,
    \u0447\u0442\u043e \u043c\u0435\u0436\u0434\u0443 \u0448\u0435\u0441\u0442\u044c\u044e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438
    \u0442\u043e\u0433\u0434\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u043c\u0438 (\u043e\u0442
    \u041c\u0435\u0440\u043a\u0443\u0440\u0438\u044f \u0434\u043e \u0421\u0430\u0442\u0443\u0440\u043d\u0430)
    \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u043f\u044f\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0445
    \u043f\u043b\u0430\u0442\u043e\u043d\u043e\u0432\u044b\u0445 \u0442\u0435\u043b. \u0412\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435
    \u0434\u0440\u0443\u0433 \u0432 \u0434\u0440\u0443\u0433\u0430, \u043e\u043d\u0438 \u0437\u0430\u0434\u0430\u044e\u0442
    \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043c\u0435\u0436\u0434\u0443
    \u043f\u043b\u0430\u043d\u0435\u0442\u043d\u044b\u043c\u0438 \u0441\u0444\u0435\u0440\u0430\u043c\u0438.
    \u0412 1596 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u044d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434 \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c
    \u00ab\u0422\u0430\u0439\u043d\u0430 \u043c\u0438\u0440\u043e\u0437\u0434\u0430\u043d\u0438\u044f\u00bb
    (Mysterium Cosmographicum). \u0425\u043e\u0442\u044f \u043f\u043e\u0437\u0436\u0435 \u043e\u043d
    \u043f\u0440\u0438\u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u0435\u0433\u043e \u0440\u0430\u0441\u0447\u0435\u0442\u044b
    \u0431\u044b\u043b\u0438 \u043d\u0435\u0442\u043e\u0447\u043d\u044b, \u044d\u0442\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u0435\u043c\u0443
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c \u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0430
    \u0435\u0433\u043e \u043a\u0430\u043a \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u043e\u0433\u043e
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430. \u0412 \u044d\u0442\u043e \u0436\u0435
    \u0432\u0440\u0435\u043c\u044f \u041a\u0435\u043f\u043b\u0435\u0440 \u0436\u0435\u043d\u0438\u043b\u0441\u044f.
    \u0415\u0433\u043e \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u0438\u0446\u0435\u0439 \u0441\u0442\u0430\u043b\u0430
    \u0411\u0430\u0440\u0431\u0430\u0440\u0430 \u041c\u044e\u043b\u043b\u0435\u0440, 23-\u043b\u0435\u0442\u043d\u044f\u044f
    \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0432\u0434\u043e\u0432\u0430.
    \u0415\u0435 \u043e\u0442\u0435\u0446 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0431\u044b\u043b
    \u043f\u0440\u043e\u0442\u0438\u0432 \u0431\u0440\u0430\u043a\u0430 \u0441 \u0431\u0435\u0434\u043d\u044b\u043c
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u043c, \u043d\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435
    \u0431\u044b\u043b\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043e \u043f\u043e\u0441\u043b\u0435
    \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u00ab\u0422\u0430\u0439\u043d\u044b
    \u043c\u0438\u0440\u043e\u0437\u0434\u0430\u043d\u0438\u044f\u00bb. \u0412 \u044d\u0442\u043e\u043c
    \u0431\u0440\u0430\u043a\u0435 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u043f\u044f\u0442\u0435\u0440\u043e
    \u0434\u0435\u0442\u0435\u0439, \u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0432\u043e\u0435
    \u043f\u0435\u0440\u0435\u0436\u0438\u043b\u0438 \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u0442\u0432\u043e
    \u2014 \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u043f\u043e\u0442\u0435\u0440\u044f,
    \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0432\u0448\u0430\u044f \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c.\n\n\U0001F451 \u041f\u0440\u0430\u0433\u0430
    (1600\u20131612): \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0422\u0438\u0445\u043e
    \u0411\u0440\u0430\u0433\u0435 \u0438 \u00ab\u041d\u043e\u0432\u0430\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f\u00bb
    \u0420\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f
    \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u043e\u0432 \u0432 \u0413\u0440\u0430\u0446\u0435
    \u0432\u044b\u043d\u0443\u0434\u0438\u043b\u0438 \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u0432 1600 \u0433\u043e\u0434\u0443 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u0433\u043e\u0440\u043e\u0434.
    \u041e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u041f\u0440\u0430\u0433\u0443,
    \u043a \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u043c\u0443 \u0434\u0430\u0442\u0441\u043a\u043e\u043c\u0443
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0443 \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u0438\u043c\u043f\u0435\u0440\u0441\u043a\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u043f\u0440\u0438 \u0434\u0432\u043e\u0440\u0435
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0430
    II. \u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u043e \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u044b\u043c. \u0422\u0438\u0445\u043e
    \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u043d\u043e \u043e\u0431\u0435\u0440\u0435\u0433\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0431\u0435\u0441\u0446\u0435\u043d\u043d\u044b\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0434\u0430\u043d\u043d\u044b\u0435 \u043e
    \u041c\u0430\u0440\u0441\u0435, \u0438 \u043d\u0435 \u0441\u043f\u0435\u0448\u0438\u043b
    \u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u0438\u043c\u0438 \u0441 \u041a\u0435\u043f\u043b\u0435\u0440\u043e\u043c.
    \u041e\u043d \u043f\u043e\u0440\u0443\u0447\u0438\u043b \u043c\u043e\u043b\u043e\u0434\u043e\u043c\u0443
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0443 \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u0443\u044e
    \u0437\u0430\u0434\u0430\u0447\u0443 \u2014 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u041c\u0430\u0440\u0441\u0430. \u0412\u0441\u043a\u043e\u0440\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0438\u0445 \u0432\u0441\u0442\u0440\u0435\u0447\u0438,
    \u0432 1601 \u0433\u043e\u0434\u0443, \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435
    \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e \u0443\u043c\u0435\u0440. \u041a\u0435\u043f\u043b\u0435\u0440,
    \u043a \u0435\u0433\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u043c\u0443 \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u043e\u043b\u043d\u043e\u0433\u043e
    \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a \u0434\u0430\u043d\u043d\u044b\u043c \u0441\u0440\u0430\u0437\u0443,
    \u043d\u043e \u0437\u0430\u043d\u044f\u043b \u043c\u0435\u0441\u0442\u043e \u0422\u0438\u0445\u043e
    \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u0418\u043c\u0435\u043d\u043d\u043e
    \u0432 \u041f\u0440\u0430\u0433\u0435, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0431\u0435\u0441\u0446\u0435\u043d\u043d\u044b\u0435, \u0442\u043e\u0447\u043d\u0435\u0439\u0448\u0438\u0435
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435,
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0432\u043e\u0435
    \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435.
    \u041c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0438
    \u043f\u043e\u0434\u043e\u0433\u043d\u0430\u0442\u044c \u043e\u0440\u0431\u0438\u0442\u0443
    \u041c\u0430\u0440\u0441\u0430 \u043f\u043e\u0434 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0439
    \u043a\u0440\u0443\u0433 (\u0434\u0430\u0436\u0435 \u0441 \u0443\u0447\u0435\u0442\u043e\u043c
    \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0441\u0438\u0442\u0435\u0442\u0430)
    \u043d\u0435 \u0443\u0434\u0430\u0432\u0430\u043b\u0438\u0441\u044c. \u0420\u0430\u0437\u043d\u0438\u0446\u0430
    \u043c\u0435\u0436\u0434\u0443 \u0442\u0435\u043e\u0440\u0438\u0435\u0439 \u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f\u043c\u0438
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0430 \u0432\u0441\u0435\u0433\u043e
    8 \u0443\u0433\u043b\u043e\u0432\u044b\u0445 \u043c\u0438\u043d\u0443\u0442 \u2014 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043c\u043d\u043e\u0433\u0438\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u044b
    \u0441\u043f\u0438\u0441\u0430\u043b\u0438 \u0431\u044b \u043d\u0430 \u043f\u043e\u0433\u0440\u0435\u0448\u043d\u043e\u0441\u0442\u044c.
    \u041d\u043e \u041a\u0435\u043f\u043b\u0435\u0440, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d \u0432 \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    \u0434\u0430\u043d\u043d\u044b\u0445 \u0422\u0438\u0445\u043e, \u043f\u043e\u043d\u044f\u043b,
    \u0447\u0442\u043e \u043e\u0448\u0438\u0431\u043a\u0430 \u043d\u0435 \u0432 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f\u0445,
    \u0430 \u0432 \u0441\u0430\u043c\u043e\u0439 \u0442\u0435\u043e\u0440\u0438\u0438. \u0412
    1609 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 magnum opus \u2014 \u00ab\u041d\u043e\u0432\u0443\u044e \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e\u00bb
    (Astronomia Nova), \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0434\u0432\u0430 \u043f\u0435\u0440\u0432\u044b\u0445 \u0437\u0430\u043a\u043e\u043d\u0430
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u0435\u0442: 1.
    \u041f\u0435\u0440\u0432\u044b\u0439 \u0437\u0430\u043a\u043e\u043d (\u0417\u0430\u043a\u043e\u043d
    \u044d\u043b\u043b\u0438\u043f\u0441\u043e\u0432): \u041a\u0430\u0436\u0434\u0430\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442\u0430 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f
    \u043f\u043e \u044d\u043b\u043b\u0438\u043f\u0441\u0443, \u0432 \u043e\u0434\u043d\u043e\u043c
    \u0438\u0437 \u0444\u043e\u043a\u0443\u0441\u043e\u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0421\u043e\u043b\u043d\u0446\u0435.
    2. \u0412\u0442\u043e\u0440\u043e\u0439 \u0437\u0430\u043a\u043e\u043d (\u0417\u0430\u043a\u043e\u043d
    \u043f\u043b\u043e\u0449\u0430\u0434\u0435\u0439): \u0420\u0430\u0434\u0438\u0443\u0441-\u0432\u0435\u043a\u0442\u043e\u0440
    \u043f\u043b\u0430\u043d\u0435\u0442\u044b (\u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u043c\u0430\u044f
    \u043b\u0438\u043d\u0438\u044f, \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u044e\u0449\u0430\u044f
    \u0421\u043e\u043b\u043d\u0446\u0435 \u0438 \u043f\u043b\u0430\u043d\u0435\u0442\u0443)
    \u0437\u0430 \u0440\u0430\u0432\u043d\u044b\u0435 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043a\u0438
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0440\u0430\u0432\u043d\u044b\u0435 \u043f\u043b\u043e\u0449\u0430\u0434\u0438. \u042d\u0442\u043e
    \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e \u043f\u043b\u0430\u043d\u0435\u0442\u0430
    \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f \u0431\u044b\u0441\u0442\u0440\u0435\u0435,
    \u043a\u043e\u0433\u0434\u0430 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0431\u043b\u0438\u0436\u0435
    \u043a \u0421\u043e\u043b\u043d\u0446\u0443, \u0438 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u0435\u0435
    \u2014 \u043a\u043e\u0433\u0434\u0430 \u0434\u0430\u043b\u044c\u0448\u0435. \u041f\u043e\u043c\u0438\u043c\u043e
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438, \u0432 \u041f\u0440\u0430\u0433\u0435
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u0440\u043e\u0432\u0435\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043e\u043f\u0442\u0438\u043a\u0438. \u0412 1604 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0442\u0440\u0443\u0434
    \u00ab\u0414\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043a \u0412\u0438\u0442\u0435\u043b\u043b\u0438\u044e\u00bb,
    \u0433\u0434\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c
    \u0437\u0440\u0435\u043d\u0438\u044f, \u043f\u043e\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e
    \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f
    \u043d\u0430 \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0435 \u0433\u043b\u0430\u0437\u0430,
    \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0437\u0430\u043a\u043e\u043d
    \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044f \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f.
    \u0412 1611 \u0433\u043e\u0434\u0443 \u0432\u044b\u0448\u043b\u0430 \u0435\u0433\u043e \u00ab\u0414\u0438\u043e\u043f\u0442\u0440\u0438\u043a\u0430\u00bb,
    \u0433\u0434\u0435 \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f \u0441 \u0434\u0432\u0443\u043c\u044f \u0432\u044b\u043f\u0443\u043a\u043b\u044b\u043c\u0438
    \u043b\u0438\u043d\u0437\u0430\u043c\u0438 (\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0442\u0440\u0443\u0431\u0430 \u041a\u0435\u043f\u043b\u0435\u0440\u0430), \u0441\u0442\u0430\u0432\u0448\u0438\u0439
    \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    \u0440\u0435\u0444\u0440\u0430\u043a\u0442\u043e\u0440\u043e\u0432. \u0412 1611 \u0433\u043e\u0434\u0443
    \u0443\u043c\u0435\u0440\u043b\u0430 \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u0411\u0430\u0440\u0431\u0430\u0440\u0430.
    \u0412 1612 \u0433\u043e\u0434\u0443, \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0430
    II, \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u041f\u0440\u0430\u0433\u0443.\n\n\U0001F52D
    \u041b\u0438\u043d\u0446 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    (1612\u20131630): \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u0442\u0440\u0443\u0434\u043e\u0432
    \u0438 \u0431\u043e\u0440\u044c\u0431\u0430 \u0437\u0430 \u0436\u0438\u0437\u043d\u044c
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432
    \u041b\u0438\u043d\u0446, \u0433\u0434\u0435 \u0437\u0430\u043d\u044f\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0431\u044b\u043b \u043e\u0437\u043d\u0430\u043c\u0435\u043d\u043e\u0432\u0430\u043d \u043a\u0430\u043a
    \u0432\u0435\u043b\u0438\u043a\u0438\u043c\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u043c\u0438
    \u0441\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f\u043c\u0438, \u0442\u0430\u043a \u0438
    \u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f\u043c\u0438.
    \u0412 1613 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437 \u043d\u0430 \u0421\u044e\u0437\u0430\u043d\u043d\u0435
    \u0420\u043e\u0439\u0442\u0438\u043d\u0433\u0435\u0440. \u041e\u0442 \u0434\u0432\u0443\u0445
    \u0431\u0440\u0430\u043a\u043e\u0432 \u0443 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u043e
    12 \u0434\u0435\u0442\u0435\u0439, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0432\u044b\u0436\u0438\u043b\u0438 \u043b\u0438\u0448\u044c \u043d\u0435\u043c\u043d\u043e\u0433\u0438\u0435.
    \u0412 1615\u20131617 \u0433\u043e\u0434\u0430\u0445 \u0440\u0430\u0437\u0440\u0430\u0437\u0438\u043b\u0441\u044f
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b: \u043c\u0430\u0442\u044c \u041a\u0435\u043f\u043b\u0435\u0440\u0430,
    \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u0443, \u043e\u0431\u0432\u0438\u043d\u0438\u043b\u0438
    \u0432 \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u0435. \u041a\u0435\u043f\u043b\u0435\u0440
    \u043b\u0438\u0447\u043d\u043e \u0432\u0437\u044f\u043b\u0441\u044f \u0437\u0430 \u0435\u0435
    \u0437\u0430\u0449\u0438\u0442\u0443 \u0438 \u043f\u043e\u0441\u043b\u0435 \u0434\u043e\u043b\u0433\u0438\u0445
    \u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0441\u0443\u0434\u0435\u0431\u043d\u044b\u0445
    \u0442\u044f\u0436\u0431 \u0434\u043e\u0431\u0438\u043b\u0441\u044f \u0435\u0435 \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u0438\u044f.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u0438 \u043f\u043e\u0442\u0440\u044f\u0441\u0435\u043d\u0438\u044f,
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c. \u0412 1619 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u00ab\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u044e
    \u043c\u0438\u0440\u0430\u00bb (Harmonices Mundi), \u0433\u0434\u0435 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0442\u0440\u0435\u0442\u0438\u0439, \u0441\u0430\u043c\u044b\u0439
    \u043e\u0431\u0449\u0438\u0439 \u0437\u0430\u043a\u043e\u043d \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f
    \u043f\u043b\u0430\u043d\u0435\u0442: 3. \u0422\u0440\u0435\u0442\u0438\u0439 \u0437\u0430\u043a\u043e\u043d
    (\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0437\u0430\u043a\u043e\u043d):
    \u041a\u0432\u0430\u0434\u0440\u0430\u0442\u044b \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u0432
    \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u0435\u0442
    \u0432\u043e\u043a\u0440\u0443\u0433 \u0421\u043e\u043b\u043d\u0446\u0430 \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f
    \u043a\u0430\u043a \u043a\u0443\u0431\u044b \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043f\u043e\u043b\u0443\u043e\u0441\u0435\u0439
    \u0438\u0445 \u043e\u0440\u0431\u0438\u0442. \u0412 1621 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0432\u043e\u0439 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u00ab\u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u043a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u0432\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438\u00bb,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u044b \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u044b
    \u043a\u043e \u0432\u0441\u0435\u043c \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u043c \u0438
    \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0430\u043c. \u0412 1626 \u0433\u043e\u0434\u0443,
    \u0438\u0437-\u0437\u0430 \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u0438\u043b\u0435\u0442\u043d\u0435\u0439
    \u0432\u043e\u0439\u043d\u044b \u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0440\u0435\u0430\u043a\u0446\u0438\u0438, \u041a\u0435\u043f\u043b\u0435\u0440 \u0431\u044b\u043b
    \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c
    \u041b\u0438\u043d\u0446. \u041e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0423\u043b\u044c\u043c, \u0433\u0434\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b
