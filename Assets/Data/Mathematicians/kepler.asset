  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0443\u0445\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438,
    \u043d\u043e \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435,
    \u043f\u043e\u0440\u043e\u0439 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0435, \u0430
    \u0438\u043d\u043e\u0433\u0434\u0430 \u0438 \u0448\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u041e\u043d \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0433 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u0438\u043c\u043d
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u0438 \u0442\u0443\u0442 \u0436\u0435
    \u0437\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c
    \u043e\u0431\u044a\u0435\u043c\u043e\u0432 \u0432\u0438\u043d\u043d\u044b\u0445 \u0431\u043e\u0447\u0435\u043a,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0432\u0435\u0441\u0442\u0438 \u043a\u043e\u043d\u0446\u044b
    \u0441 \u043a\u043e\u043d\u0446\u0430\u043c\u0438. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u044f\u0440\u043a\u0438\u0435, \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u0438
    \u043c\u0430\u043b\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445.\n\n\U0001F52E
    1. \u0413\u043e\u0440\u043e\u0441\u043a\u043e\u043f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u0441\u0430\u043c \u0441\u0435\u0431\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    (\u0438 \u0441\u0431\u044b\u043b\u0441\u044f) \u041a\u0435\u043f\u043b\u0435\u0440, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u043c,
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f,
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0438\u043c \u0441\u0430\u043c\u0438\u043c
    \u0432 1597 \u0433\u043e\u0434\u0443. \u0427\u0442\u043e \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u2014 \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u0432 \u043d\u0435\u043c \u0441\u0432\u043e\u044e
    \u0431\u0443\u0434\u0443\u0449\u0443\u044e \u0436\u0438\u0437\u043d\u044c \u0441 \u043f\u0443\u0433\u0430\u044e\u0449\u0435\u0439
