    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u0441\u0432\u043e\u0439 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a \u00ab\u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u043a\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u0432\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438\u00bb,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u044b \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u044b
    \u043a\u043e \u0432\u0441\u0435\u043c \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u043c \u0438
    \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0430\u043c. \u0412 1626 \u0433\u043e\u0434\u0443,
    \u0438\u0437-\u0437\u0430 \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u0438\u043b\u0435\u0442\u043d\u0435\u0439
    \u0432\u043e\u0439\u043d\u044b \u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0440\u0435\u0430\u043a\u0446\u0438\u0438, \u041a\u0435\u043f\u043b\u0435\u0440 \u0431\u044b\u043b
    \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c
    \u041b\u0438\u043d\u0446. \u041e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0423\u043b\u044c\u043c, \u0433\u0434\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b
    \u0441\u0432\u043e\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0432\u0435\u043b\u0438\u043a\u0438\u0439
    \u0442\u0440\u0443\u0434 \u2014 \u00ab\u0420\u0443\u0434\u043e\u043b\u044c\u0444\u043e\u0432\u044b
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b\u00bb (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u0432 1627 \u0433\u043e\u0434\u0443). \u042d\u0442\u043e \u0431\u044b\u043b\u0438 \u0441\u0430\u043c\u044b\u0435
    \u0442\u043e\u0447\u043d\u044b\u0435 \u043d\u0430 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0442\u0430\u0431\u043b\u0438\u0446\u044b, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0448\u0438\u0435
    \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0442\u044c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043f\u043b\u0430\u043d\u0435\u0442 \u043d\u0430 \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442
    \u0432\u043f\u0435\u0440\u0435\u0434. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438 \u041a\u0435\u043f\u043b\u0435\u0440
    \u043f\u0440\u043e\u0432\u0435\u043b \u0432 \u0441\u043a\u0438\u0442\u0430\u043d\u0438\u044f\u0445
    \u0432 \u043f\u043e\u0438\u0441\u043a\u0430\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u043a \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044e. \u0412
    1628 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u043c
    \u0443 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u043f\u043e\u043b\u043a\u043e\u0432\u043e\u0434\u0446\u0430
    \u0410\u043b\u044c\u0431\u0440\u0435\u0445\u0442\u0430 \u0444\u043e\u043d \u0412\u0430\u043b\u043b\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u0430,
    \u0436\u0438\u043b \u0432 \u0421\u0430\u0433\u0430\u043d\u0435 (\u043d\u044b\u043d\u0435
    \u0416\u0430\u0433\u0430\u043d\u044c, \u041f\u043e\u043b\u044c\u0448\u0430). \u041f\u044b\u0442\u0430\u044f\u0441\u044c
    \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u0435\u043d\u044c\u0433\u0438, \u043f\u0440\u0438\u0447\u0438\u0442\u0430\u044e\u0449\u0438\u0435\u0441\u044f
    \u0435\u043c\u0443 \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430\u0434
    \u0442\u0430\u0431\u043b\u0438\u0446\u0430\u043c\u0438, \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0420\u0435\u0433\u0435\u043d\u0441\u0431\u0443\u0440\u0433, \u0433\u0434\u0435
    15 \u043d\u043e\u044f\u0431\u0440\u044f 1630 \u0433\u043e\u0434\u0430 \u0437\u0430\u0431\u043e\u043b\u0435\u043b
    \u0432 \u043f\u0443\u0442\u0438 \u0438 \u0443\u043c\u0435\u0440. \u041d\u0430 \u0435\u0433\u043e
    \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0438 \u0432\u044b\u0431\u0438\u0442\u043e
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0440\u0443\u0447\u043d\u043e
    \u0441\u043e\u0447\u0438\u043d\u0435\u043d\u043d\u043e\u0435 \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f:
    \u00ab\u042f \u043c\u0435\u0440\u0438\u043b \u043d\u0435\u0431\u0435\u0441\u0430, \u0442\u0435\u043f\u0435\u0440\u044c
    \u043c\u0435\u0440\u044f\u044e \u0442\u0435\u043d\u0438. / \u0414\u0443\u0445\u043e\u043c
    \u0431\u044b\u043b \u044f \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u043c, \u0442\u0435\u043b\u043e
    \u0437\u0434\u0435\u0441\u044c \u043f\u043e\u043a\u043e\u0438\u0442\u0441\u044f \u0437\u0435\u043c\u043d\u043e\u0435\u00bb."
  shortBioEn: "Johann Kepler (1571-1630) is a figure standing at the crossroads of the era, whose life is a story about how a deeply religious man with a mystical mind, armed with patience and genius, replaced the ideal circles with ellipses, thus laying the foundation of modern astronomy, creating the basis for the law of Newton's worldwide gravity.\n\nEarly years: Disease, poverty, and first interest in the stars Johann Kepler was born on 27 December 1571 in the imperial city of Weil der Stadt (near Stuttgart) in a impoverished Protestant family. His childhood was darkened by poverty and disease. His father, Henry Kepler, was a mercenary and left the family when Johanna was five years old (presumably killed in the war).Her mother, Katharina Guldenmann, the daughter of the innkeeper, worked for a living as a healer and herbalist, and later, during a difficult period for the family, she was accused of witchcraft, and Kepler had to make a great effort to save her from the fire.His math skills were so obvious that he often struck the customers at his grandfather's hotel, and his interest in the sky woke up early: in 1577, his mother showed him the Great Comet, and in 1580, he watched the lunar eclipse.\n\nUniversity of Tubingen: The Copernicus meeting in 1589, Kepler entered the University of Tubingen, where he studied philosophy and theology in preparation for becoming a Lutheran priest. He was a brilliant student and his scholarship was extended thanks to outstanding success. It was in Tubingen that his life was determined: Michael Möstlin, a mathematician, a secret supporter of heliocentrism, introduced Kepler to the Copernicus system.Kepler immediately became a convinced copernican, not just a convenient mathematical model, but a reflection of a divine purpose, and despite the desire to become a pastor, his career was different. In 1594, even before the completion of his theological education, he was recommended for the post of professor of mathematics and astronomy at the Protestant school in Graz, Austria.\n\nHe began his teaching work in Graz, where his main early reflection took place. On July 19, 1595, he explained in a class between Jupiter and Saturn that the right polygons could describe the orbits of the planets. After developing this idea, he concluded that there were five proper platonic bodies between the six planets then known (from Mercury to Saturn).In 1596, he published this work called Mysterium Cosmographicum. Although he later admitted that his calculations were inaccurate, this work brought him to his attention and established him as a talented astronomer, while Kepler was married, and he was elected by Barbara Müller, a 23-year-old wealthy widow.Her father was initially opposed to marriage to a poor teacher, but the consent was obtained after the publication of the Mysteries of the World, which gave birth to five children, but only two of them survived the childhood loss that had been a great loss to Kepler for the rest of their lives.\n\n*Praga (1600– 1612): The legacy of Tycho Brague and New Astronomy, the religious persecution of Protestants in Graz forced Kepler to leave the city in 1600. He went to Prague, a famous Danish astronomer, Thiho Braga, who was an imperial mathematician at the court of Emperor Rudolph II. Cooperation was not easy. Tycho was eager to safeguard his invaluable observations, especially those of Mars, and did not rush to share them with Kepler.He gave a young astronomer the difficult task of explaining Mars' movement, and soon after their meeting in 1601, Tycho Braga died suddenly. Kepler, unfortunately, did not get full access to the data immediately, but took the place of Tiho as an imperial mathematician, and it was in Prague that Kepler made his main discovery using the invaluable, accurate observations of Thiho Brague.Many years of trying to fit the orbit of Mars into an ideal circle (even with eccentricity) did not fail. The difference between theory and observation was only eight corner minutes — a magnitude many astronomers would have written off for error. But Kepler, convinced of the integrity of Tiho's data, realized that the error was not in observations, but in theory.In 1609, he published his magnum opus, \"New Astronomy\" (Astronomia Nova), which formulated the first two laws of planetary motion: 1. The first law (the Ellipse Law): Each planet moves along an ellipse, one of which is the sun. 2. The second law (the Area Law): The planet's radio vector (an imaginary line connecting the Sun and the planet) for equal time intervals describes the same space.This meant that the planet moves faster when it is closer to the sun and slower when it is further. In addition to astronomy, Kepler conducted fundamental optic research in Prague. In 1604, he published the work Supplements to Vitellia, which explained the mechanism of vision by showing that the image is formed on the retina of the eye and formulated the law of the loss of light inversely proportional to the square of the distance.In 1611, his \"Diopterica\" was released, describing an advanced telescope with two convex lenses (Kepler's optic tube), which was a model of modern refractors. His wife Barbara died in 1611. In 1612, after the death of Emperor Rudolph II, Kepler left Prague.\n\nIn 1613 he married for the second time in Susanne Roytinger, two marriages of which he had 12 children, of whom only a few survived, and in 1615–1617 he was accused of witchcraft.Kepler personally took over her defence and, after a long and complex lawsuit, obtained her acquittal. Despite these shocks, Kepler continued to work. In 1619, he published \"Harmonices Mundi\", where he formulated his third, most general law of planetism: 3.In 1621, he completed his basic textbook, Reducing Copernician Astronomy, which showed that its laws applied to all planets and satellites. In 1626, due to the Thirty Years of War and the increasing Catholic reaction, Kepler was forced to leave Linz, and moved to Ulm, where he finished his last great work, the Rudolfoves Tables (published in 1627).These were the most accurate astronomical tables at the time, which allowed the position of the planets to be calculated for many years to come, and Kepler spent the last years of his life in the quest for a livelihood, and in 1628 he became an astrologist to the famous generalist Albrecht von Wallenstein, who lived in Sagan (now Jagany, Poland).In an attempt to obtain the money he owed for the work on the tables, he went to Regensburg, where on November 15, 1630, he fell ill on the road and died. On his tombstone, a handmade epitaph was thrown out: \"I measured the heavens, now I measure the shadows."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0418\u043e\u0433\u0430\u043d\u043d\u0430 \u041a\u0435\u043f\u043b\u0435\u0440\u0430
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0443\u0445\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438,
    \u043d\u043e \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435,
    \u043f\u043e\u0440\u043e\u0439 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0435, \u0430
    \u0438\u043d\u043e\u0433\u0434\u0430 \u0438 \u0448\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u041e\u043d \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0433 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u0438\u043c\u043d
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u0438 \u0442\u0443\u0442 \u0436\u0435
    \u0437\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c
    \u043e\u0431\u044a\u0435\u043c\u043e\u0432 \u0432\u0438\u043d\u043d\u044b\u0445 \u0431\u043e\u0447\u0435\u043a,
    \u0447\u0442\u043e\u0431\u044b \u0441\u0432\u0435\u0441\u0442\u0438 \u043a\u043e\u043d\u0446\u044b
    \u0441 \u043a\u043e\u043d\u0446\u0430\u043c\u0438. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u044f\u0440\u043a\u0438\u0435, \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u0438
    \u043c\u0430\u043b\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445.\n\n\U0001F52E
    1. \u0413\u043e\u0440\u043e\u0441\u043a\u043e\u043f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u0441\u0430\u043c \u0441\u0435\u0431\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    (\u0438 \u0441\u0431\u044b\u043b\u0441\u044f) \u041a\u0435\u043f\u043b\u0435\u0440, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u043c,
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f,
    \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0438\u043c \u0441\u0430\u043c\u0438\u043c
    \u0432 1597 \u0433\u043e\u0434\u0443. \u0427\u0442\u043e \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u2014 \u043e\u043d \u043e\u043f\u0438\u0441\u0430\u043b \u0432 \u043d\u0435\u043c \u0441\u0432\u043e\u044e
    \u0431\u0443\u0434\u0443\u0449\u0443\u044e \u0436\u0438\u0437\u043d\u044c \u0441 \u043f\u0443\u0433\u0430\u044e\u0449\u0435\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e, \u043d\u043e \u043d\u0435 \u043a\u0430\u043a
    \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043d\u0438\u0435,
    \u0430 \u043a\u0430\u043a \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0441\u0430\u043c\u043e\u0430\u043d\u0430\u043b\u0438\u0437. \u041e\u043d \u0437\u0430\u043f\u0438\u0441\u0430\u043b,
    \u0447\u0442\u043e \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043f\u043e\u0434 \u0437\u043d\u0430\u043a\u043e\u043c
    \u0412\u043e\u0434\u043e\u043b\u0435\u044f, \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b:
    \u00ab\u0412 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u043e\u043d
    \u0431\u0443\u0434\u0435\u0442 \u0436\u0438\u0442\u044c \u0432 \u043a\u0440\u0430\u0439\u043d\u0435\u0439
    \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438 \u043d\u0443\u0436\u0434\u0435...
    \u0415\u0433\u043e \u0436\u0435\u043d\u0443 \u0431\u0443\u0434\u0443\u0442 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u0442\u044c,
    \u0430 \u0434\u0435\u0442\u0435\u0439 \u0436\u0434\u0443\u0442 \u043d\u0435\u0441\u0447\u0430\u0441\u0442\u044c\u044f\u00bb.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0431\u0443\u0434\u0435\u0442
    \u043f\u043e\u043b\u043d\u0430 \u00ab\u0441\u043f\u0435\u0448\u043d\u044b\u0445 \u043e\u0442\u044a\u0435\u0437\u0434\u043e\u0432
    \u0438 \u043e\u043f\u0430\u0441\u043d\u044b\u0445 \u0434\u043e\u0440\u043e\u0433\u00bb.
    \u0412\u0441\u0435 \u044d\u0442\u043e \u0441\u0431\u044b\u043b\u043e\u0441\u044c \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u043d \u0434\u043e\u0431\u0430\u0432\u0438\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u043f\u043b\u0430\u043d\u0435\u0442\u0430
    (\u041c\u0435\u0440\u043a\u0443\u0440\u0438\u0439) \u0434\u0430\u0440\u0443\u0435\u0442
    \u0435\u043c\u0443 \u043e\u0441\u0442\u0440\u044b\u0439 \u0443\u043c, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0439
    \u00ab\u0440\u0430\u0441\u043a\u0443\u0441\u0438\u0442\u044c \u043b\u044e\u0431\u043e\u0439
    \u043e\u0431\u043c\u0430\u043d\u00bb, \u2014 \u044d\u0442\u0438\u043c \u0434\u0430\u0440\u043e\u043c
    \u043e\u043d \u0441\u043f\u0430\u0441 \u0441\u0432\u043e\u044e \u043c\u0430\u0442\u044c
    \u043e\u0442 \u043a\u043e\u0441\u0442\u0440\u0430.\n\n\U0001F377 2. \u041f\u043e\u0447\u0435\u043c\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0438\u0437\u0443\u0447\u0430\u043b
    \u0432\u0438\u043d\u043d\u044b\u0435 \u0431\u043e\u0447\u043a\u0438 \u0412 1613 \u0433\u043e\u0434\u0443
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432\u043e
    \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437 \u043d\u0430 \u0421\u044e\u0437\u0430\u043d\u043d\u0435
    \u0420\u043e\u0439\u0442\u0438\u043d\u0433\u0435\u0440. \u0421\u0432\u0430\u0434\u044c\u0431\u0430
    \u0431\u044b\u043b\u0430 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0439, \u0438 \u043d\u0430
    \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a\u0435 \u0432\u043e\u0437\u043d\u0438\u043a
    \u0441\u043f\u043e\u0440 \u043c\u0435\u0436\u0434\u0443 \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0430\u043c\u0438
    \u0432\u0438\u043d\u043e\u043c. \u041a\u0435\u043f\u043b\u0435\u0440 \u0437\u0430\u043c\u0435\u0442\u0438\u043b,
    \u0447\u0442\u043e \u0432\u0438\u043d\u043e\u0434\u0435\u043b\u044b \u0432 \u0410\u0432\u0441\u0442\u0440\u0438\u0438
    \u0438\u0437\u043c\u0435\u0440\u044f\u044e\u0442 \u043e\u0431\u044a\u0435\u043c \u0431\u043e\u0447\u0435\u043a,
    \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0441\u043e\u0432\u044b\u0432\u0430\u044f
    \u043f\u0430\u043b\u043a\u0443 \u0432 \u0437\u0430\u043b\u0438\u0432\u043d\u043e\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435
    \u043f\u043e \u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u0438, \u0438 \u043d\u0435
    \u043c\u043e\u0433\u0443\u0442 \u043f\u043e\u043d\u044f\u0442\u044c, \u043f\u043e\u0447\u0435\u043c\u0443
    \u0432 \u043e\u0434\u043d\u0438\u0445 \u0431\u043e\u0447\u043a\u0430\u0445 \u0431\u043e\u043b\u044c\u0448\u0435
    \u0432\u0438\u043d\u0430, \u0447\u0435\u043c \u0432 \u0434\u0440\u0443\u0433\u0438\u0445
    \u043f\u0440\u0438 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0445 \u0437\u0430\u043c\u0435\u0440\u0430\u0445.
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0441\u0435\u043b \u0437\u0430 \u0440\u0430\u0441\u0447\u0435\u0442\u044b
    \u0438 \u0432 1615 \u0433\u043e\u0434\u0443 \u0438\u0437\u0434\u0430\u043b \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00ab\u041d\u043e\u0432\u0430\u044f \u0441\u0442\u0435\u0440\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0432\u0438\u043d\u043d\u044b\u0445 \u0431\u043e\u0447\u0435\u043a\u00bb. \u042d\u0442\u043e
    \u0431\u044b\u043b \u0447\u0438\u0441\u0442\u043e \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439
    \u0442\u0440\u0443\u0434, \u0433\u0434\u0435 \u043e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u044b\u0432\u0435\u043b, \u043a\u0430\u043a \u0444\u043e\u0440\u043c\u0430 \u0431\u043e\u0447\u043a\u0438
    \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u043e\u0431\u044a\u0435\u043c. \u041d\u043e
    \u0441\u0430\u043c\u043e\u0435 \u0441\u043c\u0435\u0448\u043d\u043e\u0435, \u0447\u0442\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c \u044d\u0442\u043e\u0442
    \u0442\u0440\u0443\u0434 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u043a
    \u043f\u0440\u0435\u0434\u0442\u0435\u0447\u0430 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u2014 \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434\u044b \u00ab\u043d\u0435\u0434\u0435\u043b\u0438\u043c\u044b\u0445\u00bb,
    \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u043e\u0431\u044a\u0435\u043c\u044b
    \u0442\u0435\u043b \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f. \u0422\u043e \u0435\u0441\u0442\u044c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0432\u044b\u0441\u0448\u0438\u0439
    \u043c\u0430\u0442\u0430\u043d \u0432\u044b\u0440\u043e\u0441 \u0438\u0437 \u0436\u0435\u043b\u0430\u043d\u0438\u044f
    \u043d\u0435 \u0434\u0430\u0442\u044c \u0430\u0432\u0441\u0442\u0440\u0438\u0439\u0441\u043a\u0438\u043c
    \u0442\u0440\u0430\u043a\u0442\u0438\u0440\u0449\u0438\u043a\u0430\u043c \u0441\u0435\u0431\u044f
    \u043e\u0431\u043c\u0430\u043d\u0443\u0442\u044c.\n\n\U0001F319 3. \u041f\u0438\u0441\u0430\u0442\u0435\u043b\u044c-\u0444\u0430\u043d\u0442\u0430\u0441\u0442,
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0432\u0448\u0438\u0439 \u043b\u044e\u0434\u0435\u0439
    \u043d\u0430 \u041b\u0443\u043d\u0443 \u0437\u0430 300 \u043b\u0435\u0442 \u0434\u043e \u0416\u044e\u043b\u044f
    \u0412\u0435\u0440\u043d\u0430 \u0412 1634 \u0433\u043e\u0434\u0443 (\u0443\u0436\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u041a\u0435\u043f\u043b\u0435\u0440\u0430)
    \u0431\u044b\u043b \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d \u0435\u0433\u043e
    \u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u043e\u043c\u0430\u043d
    \u00ab\u0421\u043e\u043d\u00bb (Somnium). \u041a\u0435\u043f\u043b\u0435\u0440 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0435\u0433\u043e \u0435\u0449\u0435 \u0432 \u0441\u0442\u0443\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0435
    \u0433\u043e\u0434\u044b, \u043d\u043e \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c. \u0412 \u0441\u044e\u0436\u0435\u0442\u0435
    \u044e\u043d\u043e\u0448\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0443\u0445\u043e\u0432
    \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u041b\u0443\u043d\u0443.
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0441 \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0434\u043b\u044f XVII \u0432\u0435\u043a\u0430 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e
    \u043e\u043f\u0438\u0441\u0430\u043b: - \u041a\u0430\u043a \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0438
    \u043e\u0442 \u0417\u0435\u043c\u043b\u0438. - \u041a\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442
    \u0417\u0435\u043c\u043b\u044f \u0441 \u041b\u0443\u043d\u044b (\u043e\u043d\u0430 \u043a\u0430\u0436\u0435\u0442\u0441\u044f
    \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0438\u043c \u0441\u0432\u0435\u0442\u0438\u043b\u043e\u043c).
    - \u041e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u043f\u0430\u0434\u044b
    \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440 \u043d\u0430 \u041b\u0443\u043d\u0435
    (\u043e\u043d \u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u043d\u0430 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u043d\u043e\u0439
    \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u043d\u0435\u0432\u044b\u043d\u043e\u0441\u0438\u043c\u044b\u0439
    \u0436\u0430\u0440, \u0430 \u043d\u0430 \u0442\u0435\u043d\u0435\u0432\u043e\u0439 \u2014
    \u043b\u0435\u0434\u044f\u043d\u043e\u0439 \u0445\u043e\u043b\u043e\u0434). - \u0418 \u0434\u0430\u0436\u0435
    \u044f\u0432\u043b\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u044b
    \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c
    \u00ab\u0443\u0433\u043b\u0435\u0440\u043e\u0434\u043d\u044b\u043c \u0448\u043e\u0432\u0438\u043d\u0438\u0437\u043c\u043e\u043c\u00bb:
    \u043e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b, \u0447\u0442\u043e
    \u043b\u0443\u043d\u0430\u0442\u0438\u043a\u0438 (\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430,
    \u0436\u0438\u0432\u0443\u0449\u0438\u0435 \u043d\u0430 \u041b\u0443\u043d\u0435) \u043c\u043e\u0433\u0443\u0442
    \u0431\u044b\u0442\u044c \u0441\u0434\u0435\u043b\u0430\u043d\u044b \u043d\u0435 \u0438\u0437
    \u043f\u043b\u043e\u0442\u0438 \u0438 \u043a\u0440\u043e\u0432\u0438, \u0430 \u0438\u0437
    \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0443\u0431\u0441\u0442\u0430\u043d\u0446\u0438\u0438,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0445 \u043c\u0438\u0440
    \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0445\u043e\u043b\u043e\u0434\u0435\u043d \u0434\u043b\u044f
    \u043d\u0430\u0448\u0435\u0439 \u0444\u043e\u0440\u043c\u044b \u0436\u0438\u0437\u043d\u0438.
    \u0420\u043e\u043c\u0430\u043d \u0447\u0443\u0442\u044c \u043d\u0435 \u0441\u0442\u043e\u0438\u043b
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u0440\u0438 \u0436\u0438\u0437\u043d\u0438:
    \u0432 \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0438 \u041a\u0435\u043f\u043b\u0435\u0440
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0441\u0432\u043e\u044e
    \u043c\u0430\u0442\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0447\u0438\u0446\u044b,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \"\u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442
    \u0434\u0435\u043c\u043e\u043d\u043e\u0432\". \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044c \u043f\u043e\u0441\u043b\u0443\u0436\u0438\u043b\u0430
    \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u044b\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u043f\u0440\u043e\u0442\u0438\u0432 \u041a\u0430\u0442\u0430\u0440\u0438\u043d\u044b \u043d\u0430
    \u0441\u0443\u0434\u0435 \u043f\u043e \u0434\u0435\u043b\u0443 \u043e \u043a\u043e\u043b\u0434\u043e\u0432\u0441\u0442\u0432\u0435.\n\n\u2694\ufe0f
    4. \u0421\u0441\u043e\u0440\u0430 \u0441 \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435:
    \u0414\u0443\u044d\u043b\u044c \u043d\u0430 \u043f\u0438\u0441\u044c\u043c\u0430\u0445 \u0418\u0445
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043d\u0430\u0447\u0430\u043b\u043e\u0441\u044c
    \u0441 \u0433\u0440\u043e\u043c\u043a\u043e\u0433\u043e \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u0430.
    \u041f\u0440\u0438\u0435\u0445\u0430\u0432 \u0432 \u041f\u0440\u0430\u0433\u0443 \u043a
    \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435, \u041a\u0435\u043f\u043b\u0435\u0440
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f \u0443\u043d\u0438\u0436\u0435\u043d\u043d\u044b\u043c:
    \u0435\u043c\u0443 \u043f\u043b\u0430\u0442\u0438\u043b\u0438 \u043c\u0435\u043d\u044c\u0448\u0435
    \u0441\u043b\u0443\u0433, \u0430 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0442\u0430\u0431\u043b\u0438\u0446\u0430\u043c
    \u041c\u0430\u0440\u0441\u0430 \u0431\u044b\u043b \u0437\u0430\u043a\u0440\u044b\u0442.
    \u0412 \u043e\u0434\u0438\u043d \u0438\u0437 \u0434\u043d\u0435\u0439 \u041a\u0435\u043f\u043b\u0435\u0440
    \u0432\u043f\u0430\u043b \u0432 \u044f\u0440\u043e\u0441\u0442\u044c \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0422\u0438\u0445\u043e \u043f\u0438\u0441\u044c\u043c\u043e, \u0433\u0434\u0435 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u043e\u0431\u0432\u0438\u043d\u0438\u043b \u0435\u0433\u043e \u0432 \u043c\u043e\u0448\u0435\u043d\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0435.
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u0422\u0438\u0445\u043e
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0435\u0433\u043e, \u043a\u0430\u043a
    \u00ab\u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u043c\u043e\u043b\u043e\u0442 \u0434\u043b\u044f
    \u0440\u0430\u0441\u043a\u0430\u043b\u044b\u0432\u0430\u043d\u0438\u044f \u043a\u0430\u043c\u043d\u0435\u0439\u00bb,
    \u0438 \u0447\u0442\u043e \u043e\u043d, \u041a\u0435\u043f\u043b\u0435\u0440, \u0443\u0435\u0437\u0436\u0430\u0435\u0442.
    \u041e\u043d \u0443\u043f\u0430\u043a\u043e\u0432\u0430\u043b \u0432\u0435\u0449\u0438 \u0438
    \u0443\u0448\u0435\u043b \u043f\u0435\u0448\u043a\u043e\u043c \u0438\u0437 \u041f\u0440\u0430\u0433\u0438.
    \u0422\u0438\u0445\u043e, \u043f\u043e\u043d\u044f\u0432, \u0447\u0442\u043e \u0442\u0435\u0440\u044f\u0435\u0442
    \u0433\u0435\u043d\u0438\u044f, \u0431\u0440\u043e\u0441\u0438\u043b\u0441\u044f \u0432\u0434\u043e\u0433\u043e\u043d\u043a\u0443.
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u041a\u0435\u043f\u043b\u0435\u0440\u0443
    \u0443\u043d\u0438\u0436\u0435\u043d\u043d\u043e\u0435 \u043f\u043e\u043a\u0430\u044f\u043d\u043d\u043e\u0435
    \u043f\u0438\u0441\u044c\u043c\u043e \u0438 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b
    \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u043d\u0430 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u043d\u044b\u0445
    \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445. \u041a\u0435\u043f\u043b\u0435\u0440 \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f,
    \u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u043d\u0435\u0434\u0435\u043b\u044c \u043e\u043d\u0438 \u043d\u0435 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u043b\u0438,
    \u043e\u0431\u0449\u0430\u044f\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u043a\u0430\u043c\u0438,
    \u043f\u043e\u043a\u0430 \u0422\u0438\u0445\u043e \u043d\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0435\u043c\u0443 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u043f\u043e\u0436\u0430\u0442\u044c
    \u0440\u0443\u043a\u0443 \u0432 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438
    \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430.\n\n\U0001F927 5. \u0421\u043c\u0435\u0440\u0442\u044c
    \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435 \u0438 \"\u0432\u0438\u043d\u043e\u0432\u0430\u0442\u044b\u0439\"
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435
    \u0443\u043c\u0435\u0440 \u043f\u0440\u0438 \u043e\u0447\u0435\u043d\u044c \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445
    \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445.
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0443\u0436\u0438\u043d\u0430 \u0443 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430
    \u0420\u0443\u0434\u043e\u043b\u044c\u0444\u0430 II \u0435\u043c\u0443 \u0431\u044b\u043b\u043e
    \u043d\u0435\u0443\u0434\u043e\u0431\u043d\u043e \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c
    \u0438\u0437-\u0437\u0430 \u0441\u0442\u043e\u043b\u0430 (\u044d\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u043b\u043e\u0441\u044c
    \u0434\u0443\u0440\u043d\u044b\u043c \u0442\u043e\u043d\u043e\u043c), \u0438 \u043e\u043d
    \u0442\u0435\u0440\u043f\u0435\u043b, \u043d\u0435 \u0441\u0445\u043e\u0434\u044f \u0432
    \u0442\u0443\u0430\u043b\u0435\u0442. \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0434\u043e\u043c\u043e\u0439, \u043e\u043d \u0443\u0436\u0435 \u043d\u0435 \u043c\u043e\u0433
    \u043c\u043e\u0447\u0438\u0442\u044c\u0441\u044f, \u043d\u0430\u0447\u0430\u043b\u0441\u044f
    \u0443\u0440\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0440\u0438\u0437\u0438\u0441,
    \u0438 \u043e\u043d \u0443\u043c\u0435\u0440 \u0447\u0435\u0440\u0435\u0437 11 \u0434\u043d\u0435\u0439.
    \u041d\u043e \u043a\u0443\u0440\u044c\u0435\u0437 \u0432 \u0434\u0440\u0443\u0433\u043e\u043c:
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b
    \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u043b\u0441\u044f \u0432 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0435.
    \u041f\u043e\u0447\u0435\u043c\u0443? \u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e
    \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0445\u043e\u0440\u043e\u043d
    \u0422\u0438\u0445\u043e \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0435\u0433\u043e \u043f\u043e\u0441\u0442 \u0438 \u0435\u0433\u043e \u0430\u0440\u0445\u0438\u0432\u044b.
    \u0413\u043e\u0432\u043e\u0440\u0438\u043b\u0438, \u0447\u0442\u043e \u041a\u0435\u043f\u043b\u0435\u0440
    \u043c\u043e\u0433 \u043f\u043e\u0434\u0441\u044b\u043f\u0430\u0442\u044c \u044f\u0434,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435
    \u0431\u044b\u0441\u0442\u0440\u0435\u0435. \u0422\u043e\u043b\u044c\u043a\u043e \u0432
    2010 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u044d\u043a\u0441\u0433\u0443\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u043e\u0441\u0442\u0430\u043d\u043a\u0438 \u0422\u0438\u0445\u043e \u0411\u0440\u0430\u0433\u0435,
    \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0440\u0442\u0443\u0442\u0438
    \u0432 \u043d\u0438\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e (\u0432\u043e\u043f\u0440\u0435\u043a\u0438
    \u0441\u043b\u0443\u0445\u0430\u043c), \u0438 \u0432\u0435\u0440\u0441\u0438\u044f \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u0430.
    \u041a\u0435\u043f\u043b\u0435\u0440 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e
    \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u043d.\n\n\U0001F3A8
    6. \u041e\u043d \u0431\u044b\u043b \u043f\u043e\u044d\u0442\u043e\u043c \u0438 \u0441\u043e\u0447\u0438\u043d\u044f\u043b
    \u043c\u0443\u0437\u044b\u043a\u0443 \u0441\u0444\u0435\u0440 \u041a\u0435\u043f\u043b\u0435\u0440
    \u0432\u0435\u0440\u0438\u043b, \u0447\u0442\u043e \u043f\u043b\u0430\u043d\u0435\u0442\u044b
    \u043f\u043e\u044e\u0442. \u0412 \u0441\u0432\u043e\u0435\u0439 \u043a\u043d\u0438\u0433\u0435
    \u00ab\u0413\u0430\u0440\u043c\u043e\u043d\u0438\u044f \u043c\u0438\u0440\u0430\u00bb (1619)
    \u043e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0430\u043b \u0442\u0440\u0435\u0442\u0438\u0439
    \u0437\u0430\u043a\u043e\u043d, \u043d\u043e \u0438 \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u043f\u0435\u0440\u0435\u043b\u043e\u0436\u0438\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u043f\u043b\u0430\u043d\u0435\u0442 \u043d\u0430 \u043d\u043e\u0442\u044b. \u041e\u043d
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b, \u0447\u0442\u043e \u0417\u0435\u043c\u043b\u044f
    \u043f\u043e\u0435\u0442 \u043d\u043e\u0442\u044b \u00ab\u041c\u0438-\u0424\u0430-\u041c\u0438\u00bb
    (\u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0435\u0451 \u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f),
    \u0430 \u0421\u0430\u0442\u0443\u0440\u043d \u0434\u0430\u0435\u0442 \u0431\u0430\u0441\u043e\u0432\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b. \u041a\u0435\u043f\u043b\u0435\u0440 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u0434\u0443\u0448\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u0430 \u0441\u043b\u044b\u0448\u0430\u0442\u044c
    \u044d\u0442\u0443 \u043c\u0443\u0437\u044b\u043a\u0443, \u043d\u043e \u044d\u0442\u043e
    \u043d\u0435 \u0437\u0432\u0443\u043a \u0432 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u043e\u043c
    \u0441\u043c\u044b\u0441\u043b\u0435, \u0430 \u00ab\u0433\u0430\u0440\u043c\u043e\u043d\u0438\u044f
    \u0440\u0430\u0437\u0443\u043c\u0430\u00bb. \u042d\u0442\u043e\u0442 \u0442\u0440\u0443\u0434
    \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c
    \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0434\u043e\u043b\u0433\u043e \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438
    \u043a\u0430\u043a \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0431\u0440\u0435\u0434,
    \u0430 \u043d\u0435 \u043a\u0430\u043a \u043d\u0430\u0443\u043a\u0443.\n\n\U0001F47B 7.
    \u041e\u043d \u0434\u0432\u0430\u0436\u0434\u044b \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b
    \u0441\u0432\u043e\u044e \u0441\u043c\u0435\u0440\u0442\u044c (\u0438 \u043e\u0431\u0430
    \u0440\u0430\u0437\u0430 \u043e\u0448\u0438\u0431\u0441\u044f) \u0411\u0443\u0434\u0443\u0447\u0438
    \u043f\u0440\u0438\u0434\u0432\u043e\u0440\u043d\u044b\u043c \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u043c
    \u0412\u0430\u043b\u043b\u0435\u043d\u0448\u0442\u0435\u0439\u043d\u0430, \u041a\u0435\u043f\u043b\u0435\u0440
    \u043e\u0434\u043d\u0430\u0436\u0434\u044b (\u0432 1627 \u0433\u043e\u0434\u0443) \u043d\u0430\u0447\u0435\u0440\u0442\u0438\u043b
    \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0433\u043e
    \u0441\u0435\u0431\u044f \u043d\u0430 1634 \u0433\u043e\u0434. \u041e\u043d \u0440\u0435\u0448\u0438\u043b,
    \u0447\u0442\u043e \u0443\u043c\u0440\u0435\u0442 \u0432 \u043c\u0430\u0435 1634 \u0433\u043e\u0434\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u043d \u0443\u043c\u0435\u0440 \u0432 1630 \u0433\u043e\u0434\u0443,
    \u043d\u0435 \u0434\u043e\u0436\u0438\u0432 4 \u0433\u043e\u0434\u0430. \u041d\u043e \u0435\u0441\u0442\u044c
    \u0431\u043e\u043b\u0435\u0435 \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439:
    \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432
    \u0434\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u043e\u043d\u0447\u0438\u043d\u044b,
    \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044f\u0441\u044c \u0432 \u043f\u0443\u0442\u044c
    \u0432 \u0420\u0435\u0433\u0435\u043d\u0441\u0431\u0443\u0440\u0433 (\u0433\u0434\u0435
    \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f), \u043e\u043d, \u043f\u0440\u043e\u0435\u0437\u0436\u0430\u044f
    \u0447\u0435\u0440\u0435\u0437 \u043c\u043e\u0441\u0442, \u0441\u0438\u043b\u044c\u043d\u043e
    \u0438\u0441\u043f\u0443\u0433\u0430\u043b\u0441\u044f \u0433\u0440\u043e\u0437\u044b \u0438
    \u0441\u043a\u0430\u0437\u0430\u043b \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u0430\u043c:
    \u00ab\u0412\u043e\u0442, \u044d\u0442\u043e \u0437\u043d\u0430\u043a. \u041c\u043d\u0435
    \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u044f \u0441\u043a\u043e\u0440\u043e \u0443\u043c\u0440\u0443.
    \u041d\u043e \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u044f \u0434\u043e\u043b\u0436\u0435\u043d
    \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c \u0440\u0430\u0441\u0447\u0435\u0442\u044b\u00bb.
    \u041e\u043d \u043e\u0448\u0438\u0431\u0441\u044f \u0432 \u0434\u0430\u0442\u0435, \u043d\u043e
    \u043d\u0435 \u0432 \u0444\u0430\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u0438\u0441\u0445\u043e\u0434\u0435
    \u043f\u043e\u0435\u0437\u0434\u043a\u0438.\n\n\U0001FAA6 8. \u0421\u0430\u0440\u043a\u0430\u0441\u0442\u0438\u0447\u043d\u0430\u044f
    \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f (\u0432\u043c\u0435\u0441\u0442\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u044f)
    \u0415\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0430 \u0431\u044b\u043b\u0430 \u0443\u0442\u0435\u0440\u044f\u043d\u0430
    \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439
    \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0445\u043e\u0440\u043e\u043d \u2014 \u0430\u0440\u043c\u0438\u044f
    \u0448\u0432\u0435\u0434\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u044f
    \u0441\u0440\u0430\u0432\u043d\u044f\u043b\u0430 \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435
    \u0441 \u0437\u0435\u043c\u043b\u0435\u0439. \u041e\u0434\u043d\u0430\u043a\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u0441\u0442\u0438\u0445\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0441\u043e\u0447\u0438\u043d\u0438\u043b \u0434\u043b\u044f
    \u0441\u0432\u043e\u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u043e\u0433\u043e
    \u043a\u0430\u043c\u043d\u044f \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0442 \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438. \u042d\u0442\u043e
    \u0431\u044b\u043b\u0430 \u0435\u0434\u043a\u0430\u044f \u0438\u0440\u043e\u043d\u0438\u044f
    \u043d\u0430\u0434 \u0441\u0432\u043e\u0435\u0439 \u0431\u043b\u0438\u0437\u043e\u0440\u0443\u043a\u043e\u0441\u0442\u044c\u044e:
    > \u00ab\u042f, \u0418\u043e\u0433\u0430\u043d\u043d \u041a\u0435\u043f\u043b\u0435\u0440,
    \u043c\u0435\u0440\u0438\u043b \u043d\u0435\u0431\u0435\u0441\u0430, \u043d\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u043c\u0435\u0440\u044f\u044e \u0442\u0435\u043d\u0438 \u0437\u0435\u043c\u043d\u044b\u0435.
    / \u0422\u0430\u043c, \u043d\u0430\u0432\u0435\u0440\u0445\u0443, \u044f \u0436\u0438\u043b
    \u0434\u0443\u0445\u043e\u043c, \u0437\u0434\u0435\u0441\u044c \u0436\u0435 \u043f\u043e\u043a\u043e\u0438\u0442\u0441\u044f
    \u043b\u0438\u0448\u044c \u0442\u0435\u043b\u0435\u0441\u043d\u0430\u044f \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430\u00bb.
    \u041d\u043e \u0432 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0430\u0445 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c
    \u0432\u0442\u043e\u0440\u0430\u044f, \u0431\u043e\u043b\u0435\u0435 \u044f\u0437\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u0432\u0435\u0440\u0441\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u043d\u0435 \u0440\u0435\u0448\u0438\u043b\u0441\u044f \u0432\u044b\u0433\u0440\u0430\u0432\u0438\u0440\u043e\u0432\u0430\u0442\u044c:
    > \u00ab\u0412\u043e\u0442 \u043b\u0435\u0436\u0438\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u0435\u0432\u0437\u043e\u0448\u0435\u043b
    \u0432\u0441\u0435\u0445, \u043d\u043e \u0433\u0440\u043e\u0448 \u0435\u043c\u0443 \u0446\u0435\u043d\u0430,
    \u0438\u0431\u043e \u043e\u043d \u043d\u0435 \u0443\u043c\u0435\u043b \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c
    \u0434\u0435\u043d\u044c\u0433\u0438\u00bb.\n\n\U0001F52D 9. \u0422\u0435\u043b\u0435\u0441\u043a\u043e\u043f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u043c\u043e\u0433\u043b\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c
    10 \u043b\u0435\u0442 \u0412 1611 \u0433\u043e\u0434\u0443 \u041a\u0435\u043f\u043b\u0435\u0440
    \u043e\u043f\u0438\u0441\u0430\u043b \u0441\u0445\u0435\u043c\u0443 \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430
    \u0441 \u0434\u0432\u0443\u043c\u044f \u0432\u044b\u043f\u0443\u043a\u043b\u044b\u043c\u0438
    \u043b\u0438\u043d\u0437\u0430\u043c\u0438. \u041e\u0434\u043d\u0430\u043a\u043e \u0432
    \u0435\u0433\u043e \u0447\u0435\u0440\u0442\u0435\u0436\u0435 \u0431\u044b\u043b\u043e \u043e\u0434\u043d\u043e
    \"\u043d\u043e\": \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0432
    \u043d\u0435\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u043e\u0441\u044c \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u043c
    \u0432\u0432\u0435\u0440\u0445 \u043d\u043e\u0433\u0430\u043c\u0438. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438
    \u0432\u044b\u0441\u043c\u0435\u044f\u043b\u0438 \u0435\u0433\u043e. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u044b
    \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438: \u00ab\u041a\u0442\u043e \u0437\u0430\u0445\u043e\u0447\u0435\u0442
    \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u0435
    \u0437\u0432\u0435\u0437\u0434\u044b? \u042d\u0442\u043e \u0431\u0435\u0441\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e!\u00bb.
    \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f
    \u041a\u0435\u043f\u043b\u0435\u0440\u0430 \u043d\u0435 \u0441\u0442\u0440\u043e\u0438\u043b\u0438
    \u043f\u043e\u0447\u0442\u0438 10 \u043b\u0435\u0442. \u0422\u043e\u043b\u044c\u043a\u043e
    \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u043d\u044f\u043b\u0438, \u0447\u0442\u043e
    \u0434\u043b\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0442\u043e\u0435
    \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043d\u0435 \u0438\u043c\u0435\u0435\u0442
    \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f (\u0432 \u043a\u043e\u0441\u043c\u043e\u0441\u0435
    \u043d\u0435\u0442 \"\u0432\u0435\u0440\u0445\u0430\" \u0438 \"\u043d\u0438\u0437\u0430\"),
    \u044d\u0442\u0443 \u0441\u0445\u0435\u043c\u0443 \u0432\u0437\u044f\u043b\u0438 \u0437\u0430
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0432\u0441\u0435 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438
    \u043c\u0438\u0440\u0430.\n\n\u2712\ufe0f 10. \u0415\u0433\u043e \u0441\u043f\u0430\u0441\u043b\u0430...
    \u043e\u043f\u0435\u0447\u0430\u0442\u043a\u0430 \u0432 \u0442\u0438\u0442\u0443\u043b\u0435
    \u041a\u043e\u0433\u0434\u0430 \u0432 \u0413\u0440\u0430\u0446\u0435 \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c
    \u041a\u043e\u043d\u0442\u0440\u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f,
    \u0432\u0441\u0435 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u0438\u0435
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0431\u044b\u043b\u0438 \u0443\u0432\u043e\u043b\u0435\u043d\u044b.
    \u041a\u0435\u043f\u043b\u0435\u0440\u0443 \u0442\u043e\u0436\u0435 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043b\u0438
    \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u0433\u043e\u0440\u043e\u0434. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0432 \u0435\u0433\u043e \u0443\u0432\u043e\u043b\u044c\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0431\u0443\u043c\u0430\u0433\u0435 \u043f\u043e \u043e\u0448\u0438\u0431\u043a\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u0443\u0435\u0437\u0436\u0430\u0435\u0442 \u0434\u043b\u044f
    \u00ab\u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f\u00bb
    (Sanitatis causa), \u0430 \u043d\u0435 \u043f\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u043c
    \u043c\u043e\u0442\u0438\u0432\u0430\u043c. \u042d\u0442\u0430 \u0431\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043e\u043f\u0435\u0447\u0430\u0442\u043a\u0430 \u0441\u044b\u0433\u0440\u0430\u043b\u0430
    \u0440\u0435\u0448\u0430\u044e\u0449\u0443\u044e \u0440\u043e\u043b\u044c: \u043f\u043e\u0437\u0436\u0435,
    \u043a\u043e\u0433\u0434\u0430 \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0432\u043b\u0430\u0441\u0442\u0438 \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c
    \u043e\u0431\u044a\u044f\u0432\u0438\u0442\u044c \u0435\u0433\u043e \u0438\u0437\u0433\u043d\u0430\u043d\u043d\u0438\u043a\u043e\u043c-\u0435\u0440\u0435\u0442\u0438\u043a\u043e\u043c,
    \u043e\u043d \u043f\u0440\u0435\u0434\u044a\u044f\u0432\u0438\u043b \u044d\u0442\u0443 \u0431\u0443\u043c\u0430\u0433\u0443.
    \u0424\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u043e\u043d \u043d\u0435 \u0431\u044b\u043b
    \u043b\u0438\u0448\u0435\u043d \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u0437\u0430
    \u0432\u0435\u0440\u0443, \u0430 \u043f\u0440\u043e\u0441\u0442\u043e \"\u0443\u0435\u0445\u0430\u043b
    \u043b\u0435\u0447\u0438\u0442\u044c\u0441\u044f\", \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u043e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b \u043f\u0440\u0430\u0432\u043e
    \u043d\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435
    \u043f\u0435\u043d\u0441\u0438\u0438. --- \u041a\u0430\u043a \u0432\u0438\u0434\u0438\u0442\u0435,
    \u041a\u0435\u043f\u043b\u0435\u0440 \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \"\u0441\u043a\u0443\u0447\u043d\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c\" \u0441
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438. \u041e\u043d \u0431\u044b\u043b
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u0438\u0441\u0442\u043e\u043c, \u0444\u0430\u043d\u0442\u0430\u0441\u0442\u043e\u043c,
    \u043f\u043e\u044d\u0442\u043e\u043c, \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0441\u043a\u0443\u043f\u044b\u043c,
    \u043a\u0440\u0430\u0439\u043d\u0435 \u043d\u0435\u0443\u0434\u0430\u0447\u043b\u0438\u0432\u044b\u043c
    \u0432 \u0431\u044b\u0442\u0443, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u0430\u0436\u0435 \u0432 \u043d\u0438\u0449\u0435\u0442\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u044e\u043c\u043e\u0440\u0430."
  interestingFactsEn: "The life of Johann Kepler is not only a dry math and tragedy, but also an amazing, sometimes funny, and sometimes shocking story, he was a man who could write the mystical anthem of the universe and immediately do the math count to make ends meet, and these are the brightest, chickeny, and little-known facts from his biography, collected in detail.\n\nThe horoscope he wrote to himself (and came true) Kepler, as a forced astrologer, left behind his own horoscope he had made in 1597. What is striking is that he described his future life in it with a frightening accuracy, not as a mystical vision, but as a psychological self-examination. He wrote that he was born under the sign of Water, and he predicted: \"In the early years he will live in extreme poverty and want...He said, \"My Lord, my Lord!\n\n2. Why did mathematicians study wine barrels in 1613? Kepler married for the second time in Susanne Roytinger. The wedding was modest, and at the festival there was a dispute between wine dealers. Kepler noticed that wine companies in Austria measure the volume of barrels by simply sticking a stick into an infestation in a diagonal, and they couldn't understand why some barrels had more wine than others in the same measurements.Kepler sat down for the calculations, and in 1615, he published the tract \"New Stereometrics of Wine Buckles.\" It was a purely applied work, where he mathematically learned how the shape of the barrel affects the volume, but the funny thing is that mathematicians know this work as a precursor to integrated calculation, he used methods of \"indimensurable\" to calculate the volume of spinal organs, which means that modern maths have grown out of a desire to keep Austrian tractors from cheating themselves.\n\n3. A fantastist writer who sent people to the moon 300 years before Jules Verne in 1634 (even after Kepler's death) published his fantastic novel \"Son\" (Somnium). Kepler wrote it back in his high school years, but edited it all his life. In the story, a young man is sent to the moon with spirits. Kepler described it with remarkable accuracy for the 17th century: - How gravity changes when he is removed from the Earth.The Earth from the moon looks like a giant light. - The huge temperature changes on the moon (he knew that the heat on the lighted side was unbearable and the ice cold on the shadow side). - And even what we call today \"carbon chauvinism\": he suggested that lunatics (the creatures on the moon) could be made not from flesh and blood, but from another substance because their world is too cold for our form of life.Roman almost cost his mother his life: in Kepler's manuscript, he used his mother as a storyteller who \"causes demons.\" This is the manuscript that gave indirect evidence against Katarina in the witchcraft trial.\n\n4. An argument with Tycho Brague: Duell in letters. Their cooperation began with a loud scandal. When Kepler arrived in Prague to Tiho Braga, he felt humiliated: he was paid less than his servants and had no access to Mars tables. On one day, Kepler went into rage and wrote a letter to Tiho, where he literally accused him of fraud. He wrote that Tiho used him as a \"simple hammer to crack stones\" and that he, Kepler, was leaving.He packed his things and walked out of Prague, and quietly realized that he was losing genius, and he ran into the wind, and he wrote a humiliated penitent letter to Kepler and invited him back on better terms, and Kepler returned, but for weeks they did not speak, but only with notes, until Tiho asked him to shake his hand in public in the presence of the Emperor.\n\n5. The death of Tycho Brague and the \"guilty\" Kepler Thiho Brague died under very strange circumstances. During his dinner at Rudolph II, he was uncomfortable leaving the table (that was considered a bad tone), and he endured without going to the bathroom. He was unable to pee at home, and he began a remacular crisis, and died 11 days later.Because right after the funeral, Tycho Kepler received his post and his archives, and they said Kepler could have put poison in to get the data faster. Only in 2010, when Tiho Brague's remains were exhumed, did the chemical analysis show that the mercury was not present (despite the rumors) and the murder was completely denied. Kepler was postmortem rehabilitated.\n\n6. He was a poet and he composed the music of Kepler's spheres and believed that the planets were singing. In his book \"The Garmony of the World\" (1619), he not only gave the third law but also tried to change the movement of the planets to notes. He calculated that the Earth was singing the notes \"Mi-Fa-Mi\" (as its orbital velocity changes), and Saturn gave the bass interval. Kepler claimed that the human soul was able to hear the music, but it was not sound in the conventional sense, but \"the harmony of reason\".This work was so strange to moderns that it was long perceived as mystical delusions, not as science.\n\n7. He predicted his death twice (and he was wrong both times) as a court-appointed astrologer of Wallenstein, Kepler once (in 1627) drew a horoscope for himself for 1634; he decided that he would die in May 1634; however, he died in 1630, before 4 years.But there's a funnier case: a few months before the real death, on his way to Regensburg (where he died), he, passing over the bridge, got very scared of the thunderstorms and said to the satellites, \"Here, that's a sign. I think I'm about to die, but first I have to finish the calculations.\" He made a mistake on the date, but not on the fatal end of the trip.\n\n8. His grave was lost a few days after the funeral, and the army of the Swedish king levelled the cemetery with the ground. However, a poem that Kepler had composed for his tombstone several years before his death was preserved. It was a caustic irony over his short-sightedness: > \"I, Johann Kepler, measured the heavens, but today I measure the shadows of the earth.There I was, upstairs, living with a spirit, but there's only a body shell in it.\" But there was a second, more sarcastic version in the drafts, which he didn't want to engrave: > \"Here's a mathematician who's out there, and he's out there, but he's worth nothing because he couldn't make money.\"\n\n9. A telescope that couldn't repeat 10 years in 1611 Kepler described a telescope design with two convex lenses. However, it had one \"but\" in its design: it was an image that was inverted upside-down. The moderns mocked it. Astronomers said, \"Who wants to look at the inverted stars? It's pointless!\" Because of this, Kepler's telescope was not built for almost 10 years.Only when they realized that an inverted image was irrelevant to astronomy (no \"up\" or \"down\" in space) was the pattern taken as the basis for all the world's observatory.\n\n10. He was rescued by a... a misprint in the title when the Counter-Reform began in Graz, all Protestant teachers were dismissed. Kepler was also ordered to leave the city, but his paper mistakenly stated that he was leaving for \"health improvement\" (Sanitatis causa) rather than for religious reasons.This bureaucratic error played a decisive role: later, when the Catholic authorities tried to declare him a heretic exile, he presented this paper; he was not formally deposed for his faith, but simply \"to be treated\", so he retained the right to return and to receive a pension. -- As you can see, Kepler was not just a \"satisfied scientist\" with formulas.He was a scandalist, fantastist, poet, a bit of a cheap, highly unlucky person at home, but also an incredibly witty man who even in poverty kept a sense of humor."
