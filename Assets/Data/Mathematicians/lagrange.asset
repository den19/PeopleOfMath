  achievementsRu: "\u041e\u0441\u043d\u043e\u0432\u043e\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0438\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0416\u043e\u0437\u0435\u0444\u0430 \u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u2014 \u044d\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u044f\u0437\u044b\u043a\u0430 \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0433\u043e\u0432\u043e\u0440\u0438\u0442
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0444\u0438\u0437\u0438\u043a\u0430
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430 \u2014
    \u0432 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043e\u0431\u043e\u0431\u0449\u0430\u0442\u044c \u0438 \u0441\u0438\u043d\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0440\u0430\u0437\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u0437\u043d\u0430\u043d\u0438\u044f
    \u0432 \u0441\u0442\u0440\u043e\u0439\u043d\u044b\u0435, \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438. \u0412\u0435\u043d\u0446\u043e\u043c \u0435\u0433\u043e
    \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0442\u0430\u043b \u0442\u0440\u0443\u0434,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0423\u0438\u043b\u044c\u044f\u043c \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u043d\u0430\u0437\u0432\u0430\u043b \u00ab\u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043f\u043e\u044d\u043c\u043e\u0439\u00bb,
    \u2014 \u00ab\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u00bb.\n\n\U0001F4D6 \u00ab\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u00bb: \u0412\u0435\u0440\u0448\u0438\u043d\u0430
    \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0441\u0438\u043d\u0442\u0435\u0437\u0430
    \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u0432 1788 \u0433\u043e\u0434\u0443, \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0435\u0439 \u0432 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435.
    \u0415\u0451 \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0438\u0434\u0435\u044f \u2014
    \u0441\u0432\u0435\u0441\u0442\u0438 \u0432\u0441\u044e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443
    (\u0438 \u0441\u0442\u0430\u0442\u0438\u043a\u0443, \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0443)
    \u043a \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c \u043e\u0431\u0449\u0438\u043c
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c,
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u043d\u044b\u0435
    \u0441\u043b\u0443\u0447\u0430\u0438 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438
    \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0437\u0430\u043a\u043e\u043d\u044b.
    \u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438:
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0433\u043e\u0440\u0434\u0438\u043b\u0441\u044f
    \u0442\u0435\u043c, \u0447\u0442\u043e \u0432 \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0435
    \u00ab\u043d\u0435\u043b\u044c\u0437\u044f \u043d\u0430\u0439\u0442\u0438 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0447\u0435\u0440\u0442\u0435\u0436\u0430\u00bb. \u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430
    \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043a\u0430\u043a \u0447\u0438\u0441\u0442\u043e \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043d\u0430\u0443\u043a\u0430, \u0440\u0430\u0437\u0434\u0435\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b: \u0412 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0441\u0442\u0430\u0442\u0438\u043a\u0438 \u043e\u043d \u043f\u043e\u043b\u043e\u0436\u0438\u043b
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445
    \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u0439, \u0430 \u0434\u043b\u044f
    \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e
    \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043b \u0435\u0433\u043e \u0441 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u043c
    \u0414'\u0410\u043b\u0430\u043c\u0431\u0435\u0440\u0430, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0414'\u0410\u043b\u0430\u043c\u0431\u0435\u0440\u0430 \u2014 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430.
    \u042d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0435\u043c\u0443
    \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u043e\u0431\u0449\u0435\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435
    \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0442\u0435\u043b. \u00ab\u041e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0435
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b\u00bb: \u042d\u0442\u043e \u043e\u0434\u043d\u043e
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u0430\u0436\u043d\u044b\u0445 \u043d\u043e\u0432\u043e\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0439
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e
    \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043a\u0430\u0436\u0434\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0432 \u0434\u0435\u043a\u0430\u0440\u0442\u043e\u0432\u044b\u0445 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0430\u0445
    (x, y, z), \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c
    \u043b\u044e\u0431\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445
    (\u0443\u0433\u043b\u044b, \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f
    \u0438 \u0442.\u0434.), \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u0443\u0447\u0448\u0435
    \u0432\u0441\u0435\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442 \u0434\u043b\u044f
    \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438.
    \u0418\u0445 \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0432\u043d\u043e \u0447\u0438\u0441\u043b\u0443
    \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439 \u0441\u0432\u043e\u0431\u043e\u0434\u044b
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b. \u0423\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430: \u0414\u043b\u044f \u044d\u0442\u0438\u0445
    \u043d\u043e\u0432\u044b\u0445 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442 \u043e\u043d
    \u0432\u044b\u0432\u0435\u043b \u044d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0435
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    \u043a\u0430\u043a \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0440\u043e\u0434\u0430. \u041e\u043d\u0438
    \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437
    \u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e (T) \u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e
    (U) \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0438 \u0438\u0445 \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u044e
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 (L = T \u2013 U). \u041c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0438
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430: \u0414\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u0447 \u0441\u043e \u0441\u043b\u043e\u0436\u043d\u044b\u043c\u0438
    \u0441\u0432\u044f\u0437\u044f\u043c\u0438, \u043a\u043e\u0433\u0434\u0430 \u043d\u0435\u0443\u0434\u043e\u0431\u043d\u043e
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u044c \u043a \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u043c
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0430\u043c, \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0435\u0439 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430.
    \u042d\u0442\u043e \u043c\u043e\u0449\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430
    \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0443\u043c\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0448\u0438\u0440\u043e\u043a\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f
    \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f. \u0418\u0437 \u0441\u0432\u043e\u0435\u0433\u043e
    \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0441\u0442\u0440\u043e\u0433\u043e \u0432\u044b\u0432\u0435\u043b
    \u0442\u0440\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b: 1. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0446\u0435\u043d\u0442\u0440\u0430
    \u043c\u0430\u0441\u0441: \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0441\u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f \u0442\u0430\u043a, \u043a\u0430\u043a
    \u0435\u0441\u043b\u0438 \u0431\u044b \u0432 \u043d\u0451\u043c \u0431\u044b\u043b\u0430
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u0430 \u0432\u0441\u044f
    \u043c\u0430\u0441\u0441\u0430 \u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u044b
    \u0432\u0441\u0435 \u0432\u043d\u0435\u0448\u043d\u0438\u0435 \u0441\u0438\u043b\u044b.
    2. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e\u0431 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f (\u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430): \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u0430\u044f
    \u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0442 \u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0440\u0430\u0432\u043d\u0430
    \u0441\u0443\u043c\u043c\u0435 \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u0432 \u0432\u0441\u0435\u0445
    \u0432\u043d\u0435\u0448\u043d\u0438\u0445 \u0441\u0438\u043b. 3. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e\u0431 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u044d\u043d\u0435\u0440\u0433\u0438\u0438: \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b
    \u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u044d\u043d\u0435\u0440\u0433\u0438\u0438
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0440\u0430\u0432\u0435\u043d \u0441\u0443\u043c\u043c\u0430\u0440\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u0435 \u0432\u0441\u0435\u0445 \u0441\u0438\u043b \u043d\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u0438.\n\n\U0001F52D
    \u0414\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043d\u0430\u0443\u043a\u0438
    \u0413\u0435\u043d\u0438\u0439 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0441\u044f
    \u0438 \u0432\u043e \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0441\u0444\u0435\u0440\u0430\u0445: \u0412\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u043f\u043e \u0441\u0443\u0442\u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u044d\u0442\u043e
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u0432 \u043e\u0431\u0449\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u0435\u0442\u043e\u0434
    (\u043c\u0435\u0442\u043e\u0434 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0439) \u0434\u043b\u044f
    \u043f\u043e\u0438\u0441\u043a\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043e\u0431\u0440\u0430\u0449\u0430\u044e\u0442 \u0432 \u043c\u0438\u043d\u0438\u043c\u0443\u043c
    \u0438\u043b\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0435
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u044b. \u041e\u043d \u0442\u0430\u043a\u0436\u0435
    \u0432\u043d\u0451\u0441 \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e
    \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b \u0412\u043d\u0451\u0441
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u043a\u043b\u0430\u0434
    \u0432 \u044d\u0442\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c. \u0421\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435
    \u2014 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u0412\u0438\u043b\u044c\u0441\u043e\u043d\u0430:
    \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 p \u0447\u0438\u0441\u043b\u043e `(p-1)! + 1` \u0434\u0435\u043b\u0438\u0442\u0441\u044f
    \u043d\u0430 p. \u0422\u0435\u043e\u0440\u0438\u044f \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0412 \u0441\u0432\u043e\u0451\u043c
    \u043c\u0435\u043c\u0443\u0430\u0440\u0435 \u00ab\u0420\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f
    \u043e\u0431 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439\u00bb
    (1770-1771) \u043e\u043d \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u043c\u0435\u0442\u043e\u0434\u044b
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0432\u044b\u0441\u0448\u0438\u0445 \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439, \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044f
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0438\u0445 \u043a\u043e\u0440\u043d\u0435\u0439.
    \u0425\u043e\u0442\u044f \u0435\u043c\u0443 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c
    \u043d\u0430\u0439\u0442\u0438 \u043e\u0431\u0449\u0435\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0432\u044b\u0448\u0435 4-\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043e\u0437\u0436\u0435 \u0440\u0430\u0437\u0432\u0438\u043b\u0438
    \u0410\u0431\u0435\u043b\u044c \u0438 \u0413\u0430\u043b\u0443\u0430. \u041d\u0435\u0431\u0435\u0441\u043d\u0430\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0412\u043d\u0451\u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u044d\u0442\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0438\u0437\u0443\u0447\u0430\u044f
    \u0437\u0430\u0434\u0430\u0447\u0443 \u0442\u0440\u0451\u0445 \u0442\u0435\u043b. \u041e\u043d
    \u0440\u0435\u0448\u0438\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u043b\u0438\u0431\u0440\u0430\u0446\u0438\u0438
    \u041b\u0443\u043d\u044b (\u0435\u0451 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439),
    \u0437\u0430 \u0447\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0435\u043c\u0438\u044e
    \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0432 1764 \u0433\u043e\u0434\u0443. \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u0430
    \u043a \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u044e \u0442\u043e\u0447\u0435\u043a
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u2014 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439
    \u0432 \u043a\u043e\u0441\u043c\u043e\u0441\u0435, \u0433\u0434\u0435 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u0441\u0438\u043b\u044b \u0434\u0432\u0443\u0445 \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u0445
    \u0442\u0435\u043b \u0443\u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0448\u0438\u0432\u0430\u044e\u0442
    \u0446\u0435\u043d\u0442\u0440\u043e\u0431\u0435\u0436\u043d\u0443\u044e \u0441\u0438\u043b\u0443.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u0443\u044e
    \u0442\u0435\u043e\u0440\u0438\u044e \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0443\u044e
    \u043d\u0430 \u0440\u0430\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0432 \u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u0435
    \u0440\u044f\u0434\u044b (\u043a\u043d\u0438\u0433\u0430 \u00ab\u0422\u0435\u043e\u0440\u0438\u044f
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439\u00bb,
    1797). \u0422\u0430\u043a\u0436\u0435 \u043e\u043d \u0434\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0434\u043b\u044f \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e
    \u0447\u043b\u0435\u043d\u0430 \u0440\u044f\u0434\u0430 \u0422\u0435\u0439\u043b\u043e\u0440\u0430
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043c\u0435\u0442\u043e\u0434
    \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0445
    \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439. \u0412\u043a\u043b\u0430\u0434 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439. \u0415\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u044b
    \u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u044b, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u0438 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0438, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u043d\u0430\u043d\u0438\u044f."
  achievementsEn: 
  personalLifeRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0416\u043e\u0437\u0435\u0444\u0430
    \u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u2014 \u044d\u0442\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b \u0441\u0430\u043c\u044b\u043c
    \u044f\u0440\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432\u043e
    \u043c\u043d\u043e\u0433\u043e\u043c \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0441\u0442\u0435\u0447\u0435\u043d\u0438\u044e \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u0438 \u0441\u0432\u043e\u0435\u043c\u0443 \u043d\u0435\u0443\u043a\u0440\u043e\u0442\u0438\u043c\u043e\u043c\u0443
    \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u044e \u043a \u0437\u043d\u0430\u043d\u0438\u044f\u043c.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u0443\u0442\u044c
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430
    \u0442\u0440\u0438 \u0447\u0435\u0442\u043a\u0438\u0445 \u043f\u0435\u0440\u0438\u043e\u0434\u0430,
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445
    \u0433\u043e\u0440\u043e\u0434\u0430\u043c \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438:
    \u0422\u0443\u0440\u0438\u043d, \u0411\u0435\u0440\u043b\u0438\u043d \u0438 \u041f\u0430\u0440\u0438\u0436.\n\n\U0001F4DC
    \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0416\u043e\u0437\u0435\u0444 \u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 25 \u044f\u043d\u0432\u0430\u0440\u044f 1736
    \u0433\u043e\u0434\u0430 \u0432 \u0422\u0443\u0440\u0438\u043d\u0435, \u0432 \u0442\u043e
    \u0432\u0440\u0435\u043c\u044f \u0441\u0442\u043e\u043b\u0438\u0446\u0435 \u0421\u0430\u0440\u0434\u0438\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u0442\u0432\u0430 (\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0418\u0442\u0430\u043b\u0438\u044f). \u041f\u0440\u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0438
    \u0435\u0433\u043e \u043d\u0430\u0440\u0435\u043a\u043b\u0438 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c
    \u0438\u043c\u0435\u043d\u0435\u043c \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041b\u043e\u0434\u043e\u0432\u0438\u043a\u043e
    \u041b\u0430\u0433\u0440\u0430\u043d\u0434\u0436\u0430. \u0415\u0433\u043e \u043e\u0442\u0435\u0446,
    \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u0424\u0440\u0430\u043d\u0447\u0435\u0441\u043a\u043e
    \u041b\u043e\u0434\u043e\u0432\u0438\u043a\u043e, \u0431\u044b\u043b \u0432\u043e\u0435\u043d\u043d\u044b\u043c
    \u043a\u0430\u0437\u043d\u0430\u0447\u0435\u0435\u043c \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0438\u0437-\u0437\u0430 \u043d\u0435\u0443\u0434\u0430\u0447\u043d\u044b\u0445 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0445
    \u0441\u043f\u0435\u043a\u0443\u043b\u044f\u0446\u0438\u0439 \u043a \u043c\u043e\u043c\u0435\u043d\u0442\u0443
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e\u043b\u0435\u0442\u0438\u044f
    \u0441\u044b\u043d\u0430 \u0441\u0435\u043c\u044c\u044f \u043f\u043e\u0442\u0435\u0440\u044f\u043b\u0430
    \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0441\u0451 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435.
    \u041b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u043e, \u0447\u0442\u043e \u0441\u0430\u043c
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0441\u0447\u0438\u0442\u0430\u043b \u044d\u0442\u043e \u0440\u0430\u0437\u043e\u0440\u0435\u043d\u0438\u0435
    \u0443\u0434\u0430\u0447\u0435\u0439: \"\u0415\u0441\u043b\u0438 \u0431\u044b \u044f \u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435, \u043c\u043d\u0435, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u043d\u0435 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u0431\u044b \u0441\u0432\u044f\u0437\u0430\u0442\u044c
    \u0441\u0432\u043e\u044e \u0441\u0443\u0434\u044c\u0431\u0443 \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439\".
    \u041e\u043d \u0431\u044b\u043b \u043c\u043b\u0430\u0434\u0448\u0438\u043c \u0438\u0437
    11 \u0434\u0435\u0442\u0435\u0439, \u043d\u043e \u0432\u044b\u0436\u0438\u043b, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c.\n\n\U0001F393
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043f\u0443\u0442\u044c
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e
    \u043e\u0442\u0435\u0446 \u0432\u0438\u0434\u0435\u043b \u0416\u043e\u0437\u0435\u0444\u0430
    \u043d\u0430 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0442\u0435\u0437\u0435,
    \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b
    \u0435\u0433\u043e \u0443\u0447\u0438\u0442\u044c\u0441\u044f \u0432 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0421\u043d\u0430\u0447\u0430\u043b\u0430
    \u044e\u043d\u043e\u0448\u0430 \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u0435\u0439 \u0438 \u0434\u0440\u0435\u0432\u043d\u0438\u043c\u0438
    \u044f\u0437\u044b\u043a\u0430\u043c\u0438. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c,
    \u043a\u043e\u0433\u0434\u0430 \u0432 \u0435\u0433\u043e \u0440\u0443\u043a\u0438 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e
    \u043f\u043e\u043f\u0430\u043b \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043e\u043f\u0442\u0438\u043a\u0435. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e \u0443\u0432\u043b\u0435\u043a\u043b\u043e,
    \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f
    \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u0417\u0430
    \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u0432\u0440\u0435\u043c\u044f (\u0432\u0441\u0435\u0433\u043e
    \u0437\u0430 \u043f\u0430\u0440\u0443 \u043b\u0435\u0442) \u041b\u0430\u0433\u0440\u0430\u043d\u0436,
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u0431\u0435\u0437
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439, \u043e\u0441\u0432\u043e\u0438\u043b \u0432\u0441\u044e
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u0435\u043c\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443. \u041a 16 \u0433\u043e\u0434\u0430\u043c
    \u0435\u0433\u043e \u0437\u043d\u0430\u043d\u0438\u0439 \u0431\u044b\u043b\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e,
    \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c.\n\n\U0001F9D1\u200d\U0001F3EB
    \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434:
    \u043d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b (1754\u20131766)
    \u0412 1755 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u0432\u0441\u0435\u0433\u043e 19 \u043b\u0435\u0442, \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439
    \u0430\u0440\u0442\u0438\u043b\u043b\u0435\u0440\u0438\u0439\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u0435
    \u0422\u0443\u0440\u0438\u043d\u0430. \u041e\u043d \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u043e\u043b\u043e\u0434, \u0447\u0442\u043e \u0435\u0433\u043e \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u044b
    \u0431\u044b\u043b\u0438 \u0441\u0442\u0430\u0440\u0448\u0435 \u0435\u0433\u043e. \u0412
    \u0422\u0443\u0440\u0438\u043d\u0435 \u043e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b, \u043d\u043e \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f \u043d\u0430\u0443\u043a\u043e\u0439.
    \u0412 1757 \u0433\u043e\u0434\u0443 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043c\u043e\u043b\u043e\u0434\u044b\u043c\u0438
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \"\u0427\u0430\u0441\u0442\u043d\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\",
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0441\u043a\u043e\u0440\u0435 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u043e\u0441\u044c
    \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a. \u0412 1759 \u0433\u043e\u0434\u0443
    \u0432\u044b\u0448\u0435\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u0442\u043e\u043c \u0442\u0440\u0443\u0434\u043e\u0432
    \u044d\u0442\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0433\u0434\u0435
    \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b
    \u043f\u0438\u043e\u043d\u0435\u0440\u0441\u043a\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u043f\u043e \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e, \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u0430\u043a\u0443\u0441\u0442\u0438\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u0435\u0433\u043e \u0432 \u043e\u0434\u0438\u043d \u0440\u044f\u0434 \u0441 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438 \u0415\u0432\u0440\u043e\u043f\u044b.\n\n\U0001F451
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434:
    \u0433\u043e\u0434\u044b \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430 (1766\u20131787)
    \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441\u0442\u0430\u043b \u0441\u0430\u043c\u044b\u043c
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0432 \u043a\u0430\u0440\u044c\u0435\u0440\u0435
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430. \u041f\u0435\u0440\u0435\u0435\u0437\u0434
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d: \u0412 1766 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u043f\u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u044f
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 II \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d, \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u0432
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u041a\u043e\u0440\u043e\u043b\u044c,
    \u043b\u044e\u0431\u0438\u0432\u0448\u0438\u0439 \u043e\u043a\u0440\u0443\u0436\u0430\u0442\u044c
    \u0441\u0435\u0431\u044f \u0432\u0435\u043b\u0438\u043a\u0438\u043c\u0438 \u0443\u043c\u0430\u043c\u0438,
    \u0431\u044b\u043b \u0440\u0430\u0434 \u0438\u043c\u0435\u0442\u044c \u043f\u0440\u0438
    \u0434\u0432\u043e\u0440\u0435 \"\u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0415\u0432\u0440\u043e\u043f\u044b\".
    \u042d\u0442\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0443 \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0435\u0433\u043e
    \u0441\u0442\u0430\u0440\u0448\u0438\u0435 \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0438
    \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u0438 \u2014 \u041b\u0435\u043e\u043d\u0430\u0440\u0434
    \u042d\u0439\u043b\u0435\u0440 \u0438 \u0416\u0430\u043d \u041b\u0435\u0440\u043e\u043d
    \u0414'\u0410\u043b\u0430\u043c\u0431\u0435\u0440. \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435: \u0412
    1767 \u0433\u043e\u0434\u0443 \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0441\u0432\u043e\u0435\u0439 \u043a\u0443\u0437\u0438\u043d\u0435 \u0412\u0438\u0442\u0442\u043e\u0440\u0438\u0438
    \u041a\u043e\u043d\u0442\u0438. \u0411\u0440\u0430\u043a \u0431\u044b\u043b \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c,
    \u043d\u043e \u043d\u0435\u0434\u043e\u043b\u0433\u0438\u043c. \u0412 1783 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u0436\u0435\u043d\u0430 \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u043b\u0430,
    \u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436, \u0437\u0430\u0431\u044b\u0432\u0430\u044f
    \u043e \u0441\u043d\u0435, \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u043b \u0437\u0430
    \u043d\u0435\u0439. \u0415\u0435 \u0441\u043c\u0435\u0440\u0442\u044c \u0441\u0442\u0430\u043b\u0430
    \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u043c \u0443\u0434\u0430\u0440\u043e\u043c
    \u0434\u043b\u044f \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u0438 \u043e\u043d \u0438\u0441\u043a\u0430\u043b
    \u0443\u0442\u0435\u0448\u0435\u043d\u0438\u0435 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435.\n\n\u2696\ufe0f \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434: \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u0437\u0430\u043a\u0430\u0442 (1787\u20131813) \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u043a\u043e\u0440\u043e\u043b\u044f \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430 II
    \u0432 1786 \u0433\u043e\u0434\u0443 \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0411\u0435\u0440\u043b\u0438\u043d \u0438 \u0432 1787 \u0433\u043e\u0434\u0443 \u043f\u043e
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0430
    XVI \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u041f\u0430\u0440\u0438\u0436.
    \u0412\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u0435\u0433\u043e \u0436\u0434\u0430\u043b
    \u0442\u0440\u0438\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0438\u0435\u043c:
    \u043e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u0438 \u0435\u043c\u0443
    \u0431\u044b\u043b\u0430 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0430\u0431\u0435\u043b\u044c\u043d\u0430\u044f
    \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0430 \u0432 \u041b\u0443\u0432\u0440\u0435.
    \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0438 \u043d\u043e\u0432\u044b\u0439
    \u0431\u0440\u0430\u043a: \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0443\u044e
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e.
    \u041a \u043d\u0435\u043c\u0443, \u043a\u0430\u043a \u043a \u0432\u0435\u043b\u0438\u043a\u043e\u043c\u0443
    \u0443\u0447\u0435\u043d\u043e\u043c\u0443, \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043e\u0442\u043d\u0435\u0441\u043b\u043e\u0441\u044c
    \u0441\u043d\u0438\u0441\u0445\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u0432
    \u043f\u0435\u043d\u0441\u0438\u044e \u0438 \u0432\u043a\u043b\u044e\u0447\u0438\u0432 \u0432
    \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u044e \u043f\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435
    \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b
    \u043c\u0435\u0440 \u0438 \u0432\u0435\u0441\u043e\u0432. \u0412 1792 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439
    \u0440\u0430\u0437 \u2014 \u043d\u0430 \u0420\u0435\u043d\u0435-\u0424\u0440\u0430\u043d\u0441\u0443\u0430\u0437\u0435-\u0410\u0434\u0435\u043b\u0430\u0438\u0434\u0435
    \u041b\u0435\u043c\u043e\u043d\u044c\u0435, \u0434\u043e\u0447\u0435\u0440\u0438 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0434\u0440\u0443\u0433\u0430-\u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430. \u042d\u0442\u043e\u0442
    \u0431\u0440\u0430\u043a \u0431\u044b\u043b \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c.
    \u041f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u043f\u043e\u0447\u0435\u0441\u0442\u0438: \u0412 \u041f\u0430\u0440\u0438\u0436\u0435
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435\u043c. \u041e\u043d
    \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0432
    \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445
    \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u0435
    (\u0441 1795) \u0438 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 (\u0441 1797), \u0433\u0434\u0435 \u0447\u0438\u0442\u0430\u043b
    \u043a\u0443\u0440\u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u041f\u0440\u0438\u0448\u0435\u0434\u0448\u0438\u0439
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d
    \u0411\u043e\u043d\u0430\u043f\u0430\u0440\u0442 \u0431\u043b\u0430\u0433\u043e\u0432\u043e\u043b\u0438\u043b
    \u043a \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0443, \u043e\u0441\u044b\u043f\u0430\u043b
    \u0435\u0433\u043e \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c\u0438, \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u043b
    \u0442\u0438\u0442\u0443\u043b \u0433\u0440\u0430\u0444\u0430, \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0441\u0435\u043d\u0430\u0442\u043e\u0440\u0430 \u0438 \u043e\u0440\u0434\u0435\u043d \u041f\u043e\u0447\u0435\u0442\u043d\u043e\u0433\u043e
    \u043b\u0435\u0433\u0438\u043e\u043d\u0430. \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440
    \u0446\u0435\u043d\u0438\u043b \u0431\u0435\u0441\u0435\u0434\u044b \u0441 \u0443\u0447\u0435\u043d\u044b\u043c
    \u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0435\u0433\u043e \"\u0432\u0435\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u043f\u0438\u0440\u0430\u043c\u0438\u0434\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0443\u043a\".\n\n\u26b0\ufe0f \u0421\u043c\u0435\u0440\u0442\u044c \u0438
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0441\u043b\u043e\u0432\u0430 \u0416\u043e\u0437\u0435\u0444
    \u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 10 \u0430\u043f\u0440\u0435\u043b\u044f 1813
    \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 77 \u043b\u0435\u0442.
    \u041f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u0435\u0433\u043e
    \u043a\u043e\u043d\u0447\u0438\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c
    \u0436\u0435 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0439, \u043a\u0430\u043a
    \u0438 \u0432\u0441\u044f \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c. \u0415\u0433\u043e
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0441\u043b\u043e\u0432\u0430, \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u043d\u044b\u0435
    \u043a \u0434\u0440\u0443\u0437\u044c\u044f\u043c, \u0431\u044b\u043b\u0438: \"\u042f \u0441\u0434\u0435\u043b\u0430\u043b
    \u0441\u0432\u043e\u0451 \u0434\u0435\u043b\u043e\u2026 \u042f \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0438\u043a\u043e\u0433\u043e \u043d\u0435 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b
    \u0438 \u043d\u0435 \u0434\u0435\u043b\u0430\u043b \u043d\u0438\u043a\u043e\u043c\u0443
    \u0437\u043b\u0430\". \u041f\u043e \u043f\u0440\u0438\u043a\u0430\u0437\u0443 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430
    \u0435\u0433\u043e \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0438\u043b\u0438 \u0441 \u0432\u044b\u0441\u0448\u0438\u043c\u0438
    \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c\u0438 \u0432 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u043c
    \u041f\u0430\u043d\u0442\u0435\u043e\u043d\u0435.\n\n\U0001F91D \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445
    \u0433\u0435\u043d\u0438\u0435\u0432, \u041b\u0430\u0433\u0440\u0430\u043d\u0436, \u043a\u0430\u0436\u0435\u0442\u0441\u044f,
    \u043d\u0435 \u0438\u0441\u043a\u0430\u043b \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432
    \u0438 \u0440\u0435\u0434\u043a\u043e \u0432\u0441\u0442\u0443\u043f\u0430\u043b \u0432
    \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0441\u043f\u043e\u0440\u044b. \u041e\u043d \u0431\u044b\u043b \u0441\u0434\u0435\u0440\u0436\u0430\u043d
    \u0438 \u043d\u0435 \u043b\u044e\u0431\u0438\u043b \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0439,
    \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0442\u0438\u0448\u0438\u043d\u0435. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435
    \u0441\u043f\u043e\u0440\u0430 \u043e\u043d \u0447\u0430\u0441\u0442\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u0441\u044f
    \u0444\u0440\u0430\u0437\u043e\u0439 \"\u041d\u0435 \u0437\u043d\u0430\u044e\". \u0415\u0433\u043e
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u043c\u0438
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0431\u044b\u043b\u0438 \u043e\u0431\u0440\u0430\u0437\u0446\u043e\u043c
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438: \u041b\u0435\u043e\u043d\u0430\u0440\u0434
    \u042d\u0439\u043b\u0435\u0440 \u0441\u0442\u0430\u043b \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c. \u041f\u043e\u043b\u0443\u0447\u0438\u0432
    \u043e\u0442 \u044e\u043d\u043e\u0433\u043e \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447, \u042d\u0439\u043b\u0435\u0440
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e
    \u043f\u043e\u0445\u0432\u0430\u043b\u0438\u043b \u0435\u0433\u043e, \u043d\u043e \u0438
    \u0432\u0441\u044f\u0447\u0435\u0441\u043a\u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044e \u0432 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0440\u0443\u0433\u0430\u0445. \u0416\u0430\u043d \u041b\u0435\u0440\u043e\u043d
    \u0414'\u0410\u043b\u0430\u043c\u0431\u0435\u0440 \u0442\u0430\u043a\u0436\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e
    \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b \u0438 \u043f\u043e\u043e\u0449\u0440\u044f\u043b
    \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u0443\u0447\u0451\u043d\u043e\u0433\u043e,
    \u0437\u0430\u0431\u043e\u0442\u044f\u0441\u044c \u043e \u0435\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435
    \u0438 \u043f\u0440\u043e\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438. \u0415\u0433\u043e
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438 \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c\u0438
    \u0431\u044b\u043b\u0438 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f,
    \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0416\u0430\u043d \u0411\u0430\u0442\u0438\u0441\u0442
    \u0416\u043e\u0437\u0435\u0444 \u0424\u0443\u0440\u044c\u0435 \u0438 \u0421\u0438\u043c\u0435\u043e\u043d
    \u0414\u0435\u043d\u0438 \u041f\u0443\u0430\u0441\u0441\u043e\u043d. \u0415\u0433\u043e
    \u0438\u0434\u0435\u0438 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u043b\u0438 \u041d\u0438\u043b\u044c\u0441\u0430
    \u0410\u0431\u0435\u043b\u044f \u0438 \u042d\u0432\u0430\u0440\u0438\u0441\u0442\u0430 \u0413\u0430\u043b\u0443\u0430
    \u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0433\u0440\u0443\u043f\u043f."
  personalLifeEn: 
  shortBioRu: "\u0416\u043e\u0437\u0435\u0444 \u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u2014 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a
    \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u0443\u0447\u0451\u043d\u044b\u0445 XVIII \u0432\u0435\u043a\u0430 \u043d\u0430\u0440\u044f\u0434\u0443
    \u0441 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e\u043c \u042d\u0439\u043b\u0435\u0440\u043e\u043c.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0438 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u044b
    \u043d\u0438\u0436\u0435.\n\n\U0001F4DC \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438
    \u044e\u043d\u043e\u0441\u0442\u044c: \u043f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0443
    \u0411\u0443\u0434\u0443\u0449\u0438\u0439 \u0433\u0435\u043d\u0438\u0439 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    25 \u044f\u043d\u0432\u0430\u0440\u044f 1736 \u0433\u043e\u0434\u0430 \u0432 \u0422\u0443\u0440\u0438\u043d\u0435
    (\u0421\u0430\u0440\u0434\u0438\u043d\u0441\u043a\u043e\u0435 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u0442\u0432\u043e,
    \u043d\u044b\u043d\u0435 \u0418\u0442\u0430\u043b\u0438\u044f) \u0438 \u043f\u0440\u0438
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u0431\u044b\u043b \u043d\u0430\u0437\u0432\u0430\u043d
    \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435 \u041b\u043e\u0434\u043e\u0432\u0438\u043a\u043e
    \u041b\u0430\u0433\u0440\u0430\u043d\u0434\u0436\u0430. \u041e\u043d \u0431\u044b\u043b
    \u0441\u0442\u0430\u0440\u0448\u0438\u043c \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c
    \u0432 \u0441\u0435\u043c\u044c\u0435, \u0433\u0434\u0435 \u0432\u0441\u0435\u0433\u043e
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c 11 \u0434\u0435\u0442\u0435\u0439, \u043d\u043e
    \u0434\u043e \u0432\u0437\u0440\u043e\u0441\u043b\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430
    \u0434\u043e\u0436\u0438\u043b\u0438 \u043b\u0438\u0448\u044c \u0434\u0432\u043e\u0435.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0414\u0436\u0443\u0437\u0435\u043f\u043f\u0435
    \u0424\u0440\u0430\u043d\u0447\u0435\u0441\u043a\u043e \u041b\u043e\u0434\u043e\u0432\u0438\u043a\u043e,
    \u0431\u044b\u043b \u043a\u0430\u0437\u043d\u0430\u0447\u0435\u0435\u043c \u043f\u0440\u0438
    \u0434\u0432\u043e\u0440\u0435 \u0441\u0430\u0440\u0434\u0438\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f, \u043d\u043e \u0438\u0437-\u0437\u0430 \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0445 \u0441\u043f\u0435\u043a\u0443\u043b\u044f\u0446\u0438\u0439
    \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435.
    \u041f\u043e\u0437\u0436\u0435 \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0433\u043e\u0432\u043e\u0440\u0438\u043b:
    \"\u0415\u0441\u043b\u0438 \u0431\u044b \u044f \u0431\u044b\u043b \u0431\u043e\u0433\u0430\u0442,
    \u044f, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043d\u0435 \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u0431\u044b \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\".
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0440\u0430\u043d\u043d\u0438\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b: \u041e\u0442\u0435\u0446 \u043f\u0440\u043e\u0447\u0438\u043b
    \u0416\u043e\u0437\u0435\u0444\u0430 \u043a \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u044e\u0440\u0438\u0441\u0442\u0430,
    \u0438 \u044e\u043d\u043e\u0448\u0430 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432
    \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u043d \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u0430\u0442\u044b\u043d\u044c\u044e
    \u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0441\u043a\u0443\u0447\u043d\u043e\u0439. \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u0439
    \u043c\u043e\u043c\u0435\u043d\u0442: \u0418\u043d\u0442\u0435\u0440\u0435\u0441 \u043a
    \u0442\u043e\u0447\u043d\u044b\u043c \u043d\u0430\u0443\u043a\u0430\u043c \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b\u0441\u044f
    \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e, \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0447\u0442\u0435\u043d\u0438\u044f
    \u0440\u0430\u0431\u043e\u0442\u044b \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0433\u043e
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430 \u042d\u0434\u043c\u0443\u043d\u0434\u0430
    \u0413\u0430\u043b\u043b\u0435\u044f \u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0432 \u043e\u043f\u0442\u0438\u043a\u0435.
    \u041f\u0435\u0440\u0432\u044b\u0435 \u0443\u0441\u043f\u0435\u0445\u0438: \u041d\u0430\u0447\u0430\u0432
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u0443\u0436\u0435 \u0432 1754 \u0433\u043e\u0434\u0443 (\u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    18 \u043b\u0435\u0442) \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443, \u0430 \u0432 1755 \u0433\u043e\u0434\u0443 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b
    \u043f\u0438\u0441\u044c\u043c\u043e \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u0443 \u042d\u0439\u043b\u0435\u0440\u0443
    \u0441 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438
    \u0438\u0434\u0435\u044f\u043c\u0438 \u043f\u043e \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e, \u0440\u0435\u0448\u0438\u0432
    \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435
    \u043f\u043e\u0434\u0434\u0430\u0432\u0430\u043b\u0438\u0441\u044c \u0441\u0430\u043c\u043e\u043c\u0443
    \u042d\u0439\u043b\u0435\u0440\u0443.\n\n\U0001F3C6 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f
    (1755\u20131766) \u041c\u043e\u043b\u043e\u0434\u043e\u0439 \u0443\u0447\u0451\u043d\u044b\u0439
    \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435.
    \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0430\u044f \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c:
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0432\u0441\u0435\u0433\u043e 19
    \u043b\u0435\u0442, 28 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1755 \u0433\u043e\u0434\u0430,
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u0430\u0440\u0442\u0438\u043b\u043b\u0435\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u0422\u0443\u0440\u0438\u043d\u0430. \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f: \u041e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0432 \u0422\u0443\u0440\u0438\u043d\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u043e\u0441\u044c \u0432 \u0422\u0443\u0440\u0438\u043d\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e \u043d\u0430\u0443\u043a. \u0412 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f\u0445
    \u044d\u0442\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \"M\u00e9langes
    de Turin\", \u0431\u044b\u043b\u0438 \u043d\u0430\u043f\u0435\u0447\u0430\u0442\u0430\u043d\u044b
    \u0435\u0433\u043e \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u044b
    \u043f\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435, \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c\u0443
    \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044e \u0438 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439. \u041f\u0435\u0440\u0432\u044b\u0439
    \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0439 \u0443\u0441\u043f\u0435\u0445:
    \u0412 1764 \u0433\u043e\u0434\u0443 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0430\u044f
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u043d\u0430\u0443\u043a \u043f\u0440\u0438\u0441\u0443\u0434\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043f\u0440\u0435\u043c\u0438\u044e \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0443
    \u043f\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435 \u043b\u0438\u0431\u0440\u0430\u0446\u0438\u0438
    \u041b\u0443\u043d\u044b (\u0435\u0451 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0439).
    \u0412 1766 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u043d\u043e\u0432\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u0435\u043c\u0438\u044e \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u0437\u0430
    \u0442\u0435\u043e\u0440\u0438\u044e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u043e\u0432
    \u042e\u043f\u0438\u0442\u0435\u0440\u0430.\n\n\U0001F451 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434: \u0433\u043e\u0434\u044b \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430
    (1766\u20131787) \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u0430\u043c\u043e\u0435
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f
    \u0432 \u043a\u0430\u0440\u044c\u0435\u0440\u0435 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430.
    \u041f\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d:
    \u0412 1766 \u0433\u043e\u0434\u0443, \u043f\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438
    \u042d\u0439\u043b\u0435\u0440\u0430 \u0438 \u0414'\u0410\u043b\u0430\u043c\u0431\u0435\u0440\u0430,
    \u043f\u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u043a\u043e\u0440\u043e\u043b\u044c \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    II \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d, \u0447\u0442\u043e\u0431\u044b \"\u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0439
    \u043a\u043e\u0440\u043e\u043b\u044c \u0415\u0432\u0440\u043e\u043f\u044b\" \u0438\u043c\u0435\u043b
    \u043f\u0440\u0438 \u0441\u0432\u043e\u0451\u043c \u0434\u0432\u043e\u0440\u0435 \"\u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0415\u0432\u0440\u043e\u043f\u044b\".
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b
    \u0444\u0438\u0437\u0438\u043a\u043e-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a, \u0441\u043c\u0435\u043d\u0438\u0432
    \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0443 \u042d\u0439\u043b\u0435\u0440\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u0435\u0445\u0430\u043b \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433.
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0412 1767 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0441\u0432\u043e\u0435\u0439
    \u043a\u0443\u0437\u0438\u043d\u0435 \u0412\u0438\u0442\u0442\u043e\u0440\u0438\u0438 \u041a\u043e\u043d\u0442\u0438.
    \u0411\u0440\u0430\u043a \u0431\u044b\u043b \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c,
    \u043d\u043e \u0431\u0435\u0437\u0434\u0435\u0442\u043d\u044b\u043c. \u0412 1783 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u0441\u0443\u043f\u0440\u0443\u0433\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0430\u0441\u044c.
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f: \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b: \u0414\u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0439 \u0424\u0435\u0440\u043c\u0430
    \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0442\u0435\u043e\u0440\u0435\u043c\u0443
    \u0412\u0438\u043b\u044c\u0441\u043e\u043d\u0430: \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e
    \u043f\u0440\u043e\u0441\u0442\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430 `p` \u0447\u0438\u0441\u043b\u043e
    `(p-1)! + 1` \u0434\u0435\u043b\u0438\u0442\u0441\u044f \u043d\u0430 `p`. \u0410\u043b\u0433\u0435\u0431\u0440\u0430:
    \u0412 \u0440\u0430\u0431\u043e\u0442\u0435 \"\u0420\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f
    \u043e\u0431 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439\"
    (1770-1771) \u043e\u043d \u0432\u043f\u043b\u043e\u0442\u043d\u0443\u044e \u043f\u043e\u0434\u043e\u0448\u0451\u043b
    \u043a \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f \u043f\u043e\u0434\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a,
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f
    \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u0440\u0430\u0431\u043e\u0442 \u0410\u0431\u0435\u043b\u044f
    \u0438 \u0413\u0430\u043b\u0443\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043e\u0431\u0449\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0432\u044b\u0448\u0435 4-\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043d\u0435
    \u0440\u0435\u0448\u0430\u044e\u0442\u0441\u044f \u0432 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u0430\u0445.
    \u041d\u0435\u0431\u0435\u0441\u043d\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430:
    \u0412 1772 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0432\u0430\u0436\u043d\u044b\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0432 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0437\u0430\u0434\u0430\u0447\u0435 \u0442\u0440\u0451\u0445 \u0442\u0435\u043b, \u0447\u0442\u043e
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044e
    \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0445 \u0442\u043e\u0447\u0435\u043a
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u2014 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439
    \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435
    \u0434\u0432\u0443\u0445 \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u0445 \u0442\u0435\u043b.
    \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0443\u0434: \u0412 \u044d\u0442\u043e\u0442
    \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043d \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b
    \u0441\u0432\u043e\u0439 magnum opus \u2014 \u043a\u043d\u0438\u0433\u0443 \"\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\", \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0431\u044b\u043b\u0430 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430
    \u0432 1788 \u0433\u043e\u0434\u0443 \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e
    \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u0432 \u041f\u0430\u0440\u0438\u0436.
    \u042d\u0442\u043e \u0431\u044b\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u043d
    \u0441\u0432\u0435\u043b \u0432\u0441\u044e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443
    \u043a \u0435\u0434\u0438\u043d\u044b\u043c \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c \u0438 \u0433\u0434\u0435,
    \u043f\u043e \u0435\u0433\u043e \u0433\u043e\u0440\u0434\u043e\u043c\u0443 \u0437\u0430\u043c\u0435\u0447\u0430\u043d\u0438\u044e,
    \"\u043d\u0435\u043b\u044c\u0437\u044f \u043d\u0430\u0439\u0442\u0438 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0447\u0435\u0440\u0442\u0435\u0436\u0430\".\n\n\U0001F956 \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434: \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    (1787\u20131813) \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u0430
    II \u0432 1787 \u0433\u043e\u0434\u0443 \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u043f\u0440\u0438\u043d\u044f\u043b
    \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u044f \u041b\u044e\u0434\u043e\u0432\u0438\u043a\u0430 XVI
    \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u041f\u0430\u0440\u0438\u0436.
    \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u044f \u0438 \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f:
    \u041e\u043d \u0441\u0442\u0430\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a. \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0430\u044f
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u043e\u0431\u043e\u0448\u043b\u0430\u0441\u044c
    \u0441 \u043d\u0438\u043c \u0441\u043d\u0438\u0441\u0445\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e:
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0435\u043d\u0441\u0438\u044e
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438
    \u043f\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435 \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043c\u0435\u0440 \u0438 \u0432\u0435\u0441\u043e\u0432.
    \u041d\u043e\u0432\u044b\u0439 \u0431\u0440\u0430\u043a: \u0412 1792 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0420\u0435\u043d\u0435-\u0424\u0440\u0430\u043d\u0441\u0443\u0430\u0437\u0435-\u0410\u0434\u0435\u043b\u0430\u0438\u0434\u0435
    \u041b\u0435\u043c\u043e\u043d\u044c\u0435, \u0434\u043e\u0447\u0435\u0440\u0438 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0434\u0440\u0443\u0433\u0430-\u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430. \u042d\u0442\u043e\u0442
    \u0431\u0440\u0430\u043a \u0442\u0430\u043a\u0436\u0435 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c. \u041f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c: \u0412 1795 \u0433\u043e\u0434\u0443
    \u0441\u0442\u0430\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0432 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439
    \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u0435.
    \u0421 1797 \u0433\u043e\u0434\u0430 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0432 \u041f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435, \u043f\u0440\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u0442\u043e\u0436\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b.
    \u0415\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u0438 \u043b\u0435\u0433\u043b\u0438 \u0432
    \u043e\u0441\u043d\u043e\u0432\u0443 \u0442\u0440\u0443\u0434\u043e\u0432 \"\u0422\u0435\u043e\u0440\u0438\u044f
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439\"
    (1797) \u0438 \"\u041b\u0435\u043a\u0446\u0438\u0438 \u043e\u0431 \u0438\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439\" (1801). \u0412 \u044d\u0442\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u043e\u043d \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f \u0434\u0430\u0442\u044c
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435, \u0447\u0438\u0441\u0442\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0430\u043d\u0430\u043b\u0438\u0437\u0443, \u0432\u0432\u0435\u043b \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0447\u043b\u0435\u043d\u0430
    \u0440\u044f\u0434\u0430 \u0422\u0435\u0439\u043b\u043e\u0440\u0430 \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u043c\u0435\u0442\u043e\u0434 \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0435\u0439
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430
    \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0443\u043c\u0430.
    \u041f\u043e\u0447\u0435\u0441\u0442\u0438 \u043e\u0442 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d\u0430:
    \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d \u0411\u043e\u043d\u0430\u043f\u0430\u0440\u0442,
    \u0432\u043e\u0441\u0445\u0438\u0449\u0430\u0432\u0448\u0438\u0439\u0441\u044f \u0443\u0447\u0451\u043d\u044b\u043c,
    \u043e\u0441\u044b\u043f\u0430\u043b \u0435\u0433\u043e \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c\u0438:
    \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u043b \u0442\u0438\u0442\u0443\u043b \u0433\u0440\u0430\u0444\u0430,
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0441\u0435\u043d\u0430\u0442\u043e\u0440\u0430
    \u0438 \u043e\u0440\u0434\u0435\u043d \u041f\u043e\u0447\u0435\u0442\u043d\u043e\u0433\u043e
    \u043b\u0435\u0433\u0438\u043e\u043d\u0430.\n\n\U0001F4DD \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041a\u043e\u043d\u0447\u0438\u043d\u0430:
    \u0416\u043e\u0437\u0435\u0444 \u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041f\u0430\u0440\u0438\u0436\u0435
    10 \u0430\u043f\u0440\u0435\u043b\u044f 1813 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    77 \u043b\u0435\u0442. \u041f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432, \u043e\u043d
    \u0443\u0448\u0435\u043b \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0442\u0430\u043a
    \u0436\u0435 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e, \u043a\u0430\u043a \u0438
    \u0436\u0438\u043b, \u0438 \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441: \"\u042f \u0441\u0434\u0435\u043b\u0430\u043b
    \u0441\u0432\u043e\u0451 \u0434\u0435\u043b\u043e... \u042f \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0438\u043a\u043e\u0433\u043e \u043d\u0435 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b
    \u0438 \u043d\u0435 \u0434\u0435\u043b\u0430\u043b \u043d\u0438\u043a\u043e\u043c\u0443
    \u0437\u043b\u0430\". \u041f\u043e\u0447\u0435\u0441\u0442\u0438: \u041e\u043d \u0431\u044b\u043b
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d \u0441 \u0432\u044b\u0441\u0448\u0438\u043c\u0438
    \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c\u0438 \u0432 \u043f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u043c
    \u041f\u0430\u043d\u0442\u0435\u043e\u043d\u0435. \u0418\u0434\u0435\u0438 \u0438 \u043c\u0435\u0442\u043e\u0434\u044b
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u2014 \u043e\u0442 \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0445
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442 \u0432 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435
    \u0434\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0433\u0440\u0443\u043f\u043f \u0432
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435 \u2014 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043d\u0430\u0443\u043a\u0438 \u0438 \u043d\u0430\u0448\u043b\u0438 \u0441\u0432\u043e\u0451
    \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u041a\u043e\u0448\u0438, \u041f\u0443\u0430\u0441\u0441\u043e\u043d\u0430, \u0410\u0431\u0435\u043b\u044f
    \u0438 \u0413\u0430\u043b\u0443\u0430."
  shortBioEn: 
  interestingFactsRu: "\u0417\u0430 \u043d\u0430\u0443\u043a\u043e\u0439 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0442\u043e\u044f\u0442
    \u0436\u0438\u0432\u044b\u0435 \u043b\u044e\u0434\u0438 \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u043c\u0438, \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044f\u043c\u0438
    \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u044f\u043c\u0438.
    \u0416\u043e\u0437\u0435\u0444 \u041b\u0443\u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u043d\u0435 \u0431\u044b\u043b \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c
    \u2014 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u043f\u043e\u043b\u043d\u0430
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442 \u0435\u0433\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u043c\u0435\u043d\u0435\u043c \u0432
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430\u0445, \u0430 \u043e\u0447\u0435\u043d\u044c
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0439 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\U0001F4B0
    \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438:
    \u00ab\u0415\u0441\u043b\u0438 \u0431\u044b \u044f \u0431\u044b\u043b \u0431\u043e\u0433\u0430\u0442...\u00bb
    \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439
    \u0430\u0444\u043e\u0440\u0438\u0437\u043c \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430
    \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u043c.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446 \u0440\u0430\u0437\u043e\u0440\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0445 \u0441\u043f\u0435\u043a\u0443\u043b\u044f\u0446\u0438\u044f\u0445,
    \u0438 \u044d\u0442\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u0435, \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e
    \u0441\u0430\u043c\u043e\u0433\u043e \u0443\u0447\u0435\u043d\u043e\u0433\u043e, \u0441\u0442\u0430\u043b\u043e
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0431\u043b\u0430\u0433\u043e\u043c. \u041e\u043d
    \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u043b: \u00ab\u0415\u0441\u043b\u0438
    \u0431\u044b \u044f \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435,
    \u044f, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043d\u0435 \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b
    \u0431\u044b \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435\u00bb.
    \u0420\u0430\u0437\u043e\u0440\u0435\u043d\u0438\u0435 \u0441\u0435\u043c\u044c\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043e\u0431\u044b\u0447\u043d\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439,
    \u0432 \u0435\u0433\u043e \u0441\u043b\u0443\u0447\u0430\u0435 \u0441\u0442\u0430\u043b\u043e
    \u043c\u043e\u0449\u043d\u0435\u0439\u0448\u0438\u043c \u043c\u043e\u0442\u0438\u0432\u0430\u0442\u043e\u0440\u043e\u043c
    \u043d\u0430 \u043f\u0443\u0442\u0438 \u043a \u043d\u0430\u0443\u043a\u0435.\n\n\U0001F3B5
    \u041c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u0435
    \u0423 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u0430\u044f
    \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430, \u043f\u043e\u043c\u043e\u0433\u0430\u0432\u0448\u0430\u044f
    \u0435\u043c\u0443 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435. \u041e\u043d \u0431\u044b\u043b
    \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0435\u043c
    \u043c\u0443\u0437\u044b\u043a\u0438 \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0451 \u043a\u0430\u043a \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u043c\u043e\u0433 \u0441\u0438\u0434\u0435\u0442\u044c
    \u0432 \u043a\u0440\u0435\u0441\u043b\u0435 \u0438 \u0441\u043b\u0443\u0448\u0430\u0442\u044c
    \u043c\u0443\u0437\u044b\u043a\u0443, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u044f\u0441\u044c \u0432 \u0441\u0432\u043e\u0438
    \u043c\u044b\u0441\u043b\u0438. \u041e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u00ab\u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0435\u0442\u044c\u0435\u0439
    \u043d\u043e\u0442\u044b \u044f \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0441\u043b\u044b\u0448\u0443\u2026
    \u0438 \u0432\u0441\u0451, \u0447\u0442\u043e \u044f \u0437\u043d\u0430\u044e \u043f\u043e\u0442\u043e\u043c,
    \u2014 \u044d\u0442\u043e \u0442\u043e, \u0447\u0442\u043e \u044f \u0440\u0435\u0448\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443\u00bb.
    \u041c\u0443\u0437\u044b\u043a\u0430 \u0441\u043b\u0443\u0436\u0438\u043b\u0430 \u0435\u043c\u0443
    \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c \u00ab\u0431\u0435\u043b\u044b\u043c
    \u0448\u0443\u043c\u043e\u043c\u00bb, \u043e\u0442\u0441\u0435\u043a\u0430\u044e\u0449\u0438\u043c
    \u0432\u043d\u0435\u0448\u043d\u0438\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0438
    \u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u043c \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u0442\u044c\u0441\u044f
    \u043d\u0430 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f\u0445.\n\n\U0001F5E3\ufe0f
    \u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c \u0438 \u0430\u043d\u0442\u0438\u043f\u0430\u0442\u0438\u044f
    \u043a \u0441\u043f\u043e\u0440\u0430\u043c \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u043e\u0431\u043b\u0430\u0434\u0430\u043b
    \u043a\u0440\u0430\u0439\u043d\u0435 \u043c\u0438\u0440\u043e\u043b\u044e\u0431\u0438\u0432\u044b\u043c
    \u0438 \u0434\u0435\u043b\u0438\u043a\u0430\u0442\u043d\u044b\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0440\u0435\u0434\u043a\u043e\u0441\u0442\u044c\u044e
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0441\u0440\u0435\u0434\u0435, \u043f\u043e\u043b\u043d\u043e\u0439
    \u0430\u043c\u0431\u0438\u0446\u0438\u0439 \u0438 \u0441\u043f\u043e\u0440\u043e\u0432.
    \u00ab\u042f \u043d\u0435 \u0437\u043d\u0430\u044e\u00bb: \u0415\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u043e\u0439
    \u0444\u0440\u0430\u0437\u043e\u0439 \u0432 \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044f\u0445
    \u0431\u044b\u043b\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u00ab\u042f \u043d\u0435
    \u0437\u043d\u0430\u044e\u00bb (Je ne sais pas). \u041e\u043d \u043d\u0435 \u043b\u044e\u0431\u0438\u043b
    \u0441\u043f\u043e\u0440\u0438\u0442\u044c \u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432,
    \u0447\u0442\u043e \u0440\u0435\u0437\u043a\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0441 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u043c\u043d\u043e\u0433\u0438\u0445
    \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u041f\u044c\u0435\u0440\u0430-\u0421\u0438\u043c\u043e\u043d\u0430
    \u041b\u0430\u043f\u043b\u0430\u0441\u0430. \u0418\u0440\u043e\u043d\u0438\u044f \u043d\u0430\u0434
    \u0442\u0438\u0442\u0443\u043b\u0430\u043c\u0438: \u0414\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d
    \u0441\u0434\u0435\u043b\u0430\u043b \u0435\u0433\u043e \u0441\u0435\u043d\u0430\u0442\u043e\u0440\u043e\u043c
    \u0438 \u0433\u0440\u0430\u0444\u043e\u043c, \u041b\u0430\u0433\u0440\u0430\u043d\u0436
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0438\u0440\u043e\u043d\u0438\u0447\u043d\u044b\u043c
    \u043f\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044e \u043a \u0432\u043d\u0435\u0448\u043d\u0438\u043c
    \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u0430\u043c \u0432\u043b\u0430\u0441\u0442\u0438.
    \u041e\u0434\u043d\u0430\u0436\u0434\u044b, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435
    \u043d\u0430 \u043e\u0431\u0435\u0434 \u043e\u0442 \u043a\u043e\u043b\u043b\u0435\u0433\u0438-\u0441\u0435\u043d\u0430\u0442\u043e\u0440\u0430,
    \u043e\u043d \u0441 \u0443\u043b\u044b\u0431\u043a\u043e\u0439 \u0441\u043f\u0440\u043e\u0441\u0438\u043b:
    \u00ab\u041d\u0443\u0436\u043d\u043e \u043b\u0438 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u0434\u0435\u0442\u044c
    \u0441\u0435\u043d\u0430\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0444\u043e\u0440\u043c\u0443?\u00bb,
    \u0447\u0435\u043c \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u043d\u0443\u043b \u0441\u0432\u043e\u044e
    \u0438\u0440\u043e\u043d\u0438\u044e \u043d\u0430\u0434 \u0441\u0432\u0435\u0442\u0441\u043a\u0438\u043c\u0438
    \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u0441\u0442\u044f\u043c\u0438.\n\n\U0001F3DB\ufe0f
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0432\u043b\u0430\u0441\u0442\u044c\u044e:
    \u043e\u0442 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438 \u0434\u043e \u0438\u043c\u043f\u0435\u0440\u0438\u0438
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u043f\u0435\u0440\u0435\u0436\u0438\u043b \u0431\u0443\u0440\u043d\u044b\u0435
    \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438 \u0438 \u0441\u043c\u0435\u043d\u0443
    \u0440\u0435\u0436\u0438\u043c\u043e\u0432, \u0438 \u0435\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0432\u043b\u0430\u0441\u0442\u044c\u044e \u043f\u043e\u043b\u043d\u044b \u043a\u0443\u0440\u044c\u0435\u0437\u043e\u0432.
    \u0418\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0438\u0437 \u043f\u0440\u0430\u0432\u0438\u043b:
    \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0438
    \u0431\u044b\u043b \u043f\u0440\u0438\u043d\u044f\u0442 \u0434\u0435\u043a\u0440\u0435\u0442
    \u043e\u0431 \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u0438 \u0438\u0437 \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u0432\u0441\u0435\u0445 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u0446\u0435\u0432,
    \u043e\u0434\u043d\u0430\u043a\u043e \u0434\u043b\u044f \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430,
    \u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0433\u043e \u0432 \u0422\u0443\u0440\u0438\u043d\u0435,
    \u0431\u044b\u043b\u043e \u0441\u0434\u0435\u043b\u0430\u043d\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435
    \u2014 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u043e \u0435\u0433\u043e \u0432 \u041f\u0430\u0440\u0438\u0436\u0435.
    \u0421\u043c\u0435\u0440\u0442\u044c \u041b\u0430\u0432\u0443\u0430\u0437\u044c\u0435: \u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f
    \u0444\u0440\u0430\u0437\u0430 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u0431\u044b\u043b\u0430
    \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0437\u043d\u0438
    \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0445\u0438\u043c\u0438\u043a\u0430 \u0410\u043d\u0442\u0443\u0430\u043d\u0430
    \u041b\u0430\u0432\u0443\u0430\u0437\u044c\u0435. \u0423\u0437\u043d\u0430\u0432 \u043e\u0431
    \u044d\u0442\u043e\u043c, \u041b\u0430\u0433\u0440\u0430\u043d\u0436 \u0432\u043e\u0441\u043a\u043b\u0438\u043a\u043d\u0443\u043b:
    \u00ab\u0418\u043c \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u043b\u0438\u0448\u044c \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b
    \u043e\u0442\u0440\u0443\u0431\u0438\u0442\u044c \u044d\u0442\u0443 \u0433\u043e\u043b\u043e\u0432\u0443,
    \u043d\u043e \u0438 \u0441\u0442\u0430 \u043b\u0435\u0442 \u043d\u0435 \u0445\u0432\u0430\u0442\u0438\u0442,
    \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438
    \u0435\u0449\u0451 \u043e\u0434\u043d\u0443 \u0442\u0430\u043a\u0443\u044e \u0436\u0435\u00bb.
    \u00ab\u041f\u0438\u0440\u0430\u043c\u0438\u0434\u0430 \u043d\u0430\u0443\u043a\u00bb: \u041f\u0440\u0438\u0448\u0435\u0434\u0448\u0438\u0439
    \u043a \u0432\u043b\u0430\u0441\u0442\u0438 \u041d\u0430\u043f\u043e\u043b\u0435\u043e\u043d
    \u0411\u043e\u043d\u0430\u043f\u0430\u0440\u0442 \u0431\u043e\u0433\u043e\u0442\u0432\u043e\u0440\u0438\u043b
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u0435\u0433\u043e \u00ab\u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043f\u0438\u0440\u0430\u043c\u0438\u0434\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a\u00bb.
    \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u043b\u044e\u0431\u0438\u043b \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044c
    \u0441 \u043d\u0438\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0435
    \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0438 \u043e\u0441\u044b\u043f\u0430\u043b \u0435\u0433\u043e
    \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c\u0438.\n\n\U0001F9E0 \u0425\u0440\u0443\u043f\u043a\u043e\u0441\u0442\u044c
    \u0433\u0435\u043d\u0438\u044f: \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u0438
    \u043f\u0435\u0440\u0435\u0443\u0442\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044c
    \u0435\u043c\u0443 \u0446\u0435\u043d\u043e\u0439 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e
    \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f. \u0423\u0436\u0435 \u043a
    25 \u0433\u043e\u0434\u0430\u043c \u043e\u043d \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043f\u0435\u0440\u0435\u0443\u0442\u043e\u043c\u043b\u0435\u043d, \u0447\u0442\u043e \u0432\u0440\u0430\u0447\u0438
    \u0432 1761 \u0433\u043e\u0434\u0443 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e
    \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0434\u0438\u043b\u0438 \u0435\u0433\u043e:
    \u0435\u0441\u043b\u0438 \u043e\u043d \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u0442
    \u0441\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0447\u0438\u0439 \u0433\u0440\u0430\u0444\u0438\u043a,
    \u043e\u043d\u0438 \u043d\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0442 \u0437\u0430
    \u0435\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u043f\u0440\u0438\u0441\u043b\u0443\u0448\u0430\u043b\u0441\u044f \u043a \u0441\u043e\u0432\u0435\u0442\u0430\u043c,
    \u043d\u043e \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u0438 \u0430\u043f\u0430\u0442\u0438\u044f
    \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0438 \u0435\u0433\u043e
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438. \u0412 \u043f\u0438\u0441\u044c\u043c\u0435
    \u0441\u0432\u043e\u0435\u043c\u0443 \u043a\u043e\u043b\u043b\u0435\u0433\u0435 \u0414'\u0410\u043b\u0430\u043c\u0431\u0435\u0440\u0443
    \u0432 1776 \u0433\u043e\u0434\u0443 (\u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    40 \u043b\u0435\u0442) \u043e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0441\u044f:
    \u00ab\u042f \u043d\u0430\u0447\u0438\u043d\u0430\u044e \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c,
    \u043a\u0430\u043a \u0432\u043e \u043c\u043d\u0435 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442
    \u0438\u043d\u0435\u0440\u0446\u0438\u044f... \u044f \u043d\u0435 \u0443\u0432\u0435\u0440\u0435\u043d,
    \u0447\u0442\u043e \u0441\u043c\u043e\u0433\u0443 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0435\u0449\u0451 \u0434\u0435\u0441\u044f\u0442\u044c
    \u043b\u0435\u0442\u00bb. \u041f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0436\u0435\u043d\u044b \u0432 1783 \u0433\u043e\u0434\u0443
    \u0435\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0443\u0441\u0443\u0433\u0443\u0431\u0438\u043b\u043e\u0441\u044c
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e, \u0447\u0442\u043e \u043e\u043d
    \u043d\u0430 \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0447\u0442\u0438 \u043e\u0442\u043e\u0448\u0435\u043b
    \u043e\u0442 \u043d\u0430\u0443\u043a\u0438."
