  fullNameRu: "\u0420\u0438\u043C\u0430\u043D, \u0413\u0435\u043E\u0301\u0440\u0433
    \u0424\u0440\u0438\u0301\u0434\u0440\u0438\u0445 \u0411\u0435\u0301\u0440\u043D\u0445\u0430\u0440\u0434"
  fullNameEn: Bernhard Riemann
