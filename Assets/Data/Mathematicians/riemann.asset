  achievementsRu: "\u041d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434\u0430 \u0420\u0438\u043c\u0430\u043d\u0430,
    \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0435\u0433\u043e \u043a\u043e\u0440\u043e\u0442\u043a\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c (\u0432\u0441\u0435\u0433\u043e \u043e\u043a\u043e\u043b\u043e
    \u0434\u0435\u0441\u044f\u0442\u0438 \u043b\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b), \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e
    \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e \u043e\u0431\u043b\u0438\u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044b, \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e
    \u043d\u043e\u0432\u044b\u0435 \u0434\u043b\u044f XIX \u0432\u0435\u043a\u0430, \u0441\u0442\u0430\u043b\u0438
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u043d\u043e \u0438 \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b
    \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439, \u043a\u0430\u0436\u0434\u0430\u044f \u0438\u0437
    \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442
    \u0440\u0430\u0431\u043e\u0442\u044b, \u0441\u0442\u0430\u0432\u0448\u0438\u0435 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u0446\u0435\u043b\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\n\U0001F9EE \u0420\u0438\u043c\u0430\u043d\u043e\u0432\u0430
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f: \u041d\u043e\u0432\u0430\u044f \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u042d\u0442\u043e,
    \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u0441\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0438 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0420\u0438\u043c\u0430\u043d\u0430,
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432\u0448\u0435\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u043e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430. \u0418\u043d\u0430\u0443\u0433\u0443\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u043b\u0435\u043a\u0446\u0438\u044f (1854 \u0433.): \u0412 \u0441\u0432\u043e\u0435\u0439
    \u043f\u0440\u043e\u0431\u043d\u043e\u0439 \u043b\u0435\u043a\u0446\u0438\u0438 \u00ab\u041e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430\u0445, \u043b\u0435\u0436\u0430\u0449\u0438\u0445
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb
    (\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0430 \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e
    \u0432 1868 \u0433.), \u0420\u0438\u043c\u0430\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u043e\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434
    \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e. \u041e\u043d \u043e\u0431\u043e\u0431\u0449\u0438\u043b
    \u0438\u0434\u0435\u0438 \u0413\u0430\u0443\u0441\u0441\u0430 \u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439
    \u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u043e\u0439
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438 (\u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f).
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043f\u043e\u043d\u044f\u0442\u0438\u044f:
    \u041e\u043d \u0432\u0432\u0435\u043b \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439
    \u043c\u0435\u0442\u0440\u0438\u043a\u0438 (\u0441\u043f\u043e\u0441\u043e\u0431\u0430 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f
    \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0439 \u043c\u0435\u0436\u0434\u0443
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0431\u043b\u0438\u0437\u043a\u0438\u043c\u0438
    \u0442\u043e\u0447\u043a\u0430\u043c\u0438) \u0438 \u0442\u0435\u043d\u0437\u043e\u0440\u0430
    \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u044b. \u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f
    \u0415\u0432\u043a\u043b\u0438\u0434\u0430 \u0441\u0442\u0430\u043b\u0430 \u043b\u0438\u0448\u044c
    \u0447\u0430\u0441\u0442\u043d\u044b\u043c \u0441\u043b\u0443\u0447\u0430\u0435\u043c \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432.
    \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u00ab\u0441\u0432\u0435\u0440\u0433\u043b\u0430 \u0441 \u0442\u0440\u043e\u043d\u0430\u00bb
    \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u0443 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e
    \u043a\u0430\u043a \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043c\u0438\u0440\u0430. \u0420\u0438\u043c\u0430\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430
    \u0434\u043e\u043b\u0436\u043d\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c\u0441\u044f
    \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u0438, \u0447\u0442\u043e \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b\u043e \u0438\u0434\u0435\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430 \u043e \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u043e\u043c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435-\u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\U0001F4D0
    \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0438 \u0420\u0438\u043c\u0430\u043d\u043e\u0432\u044b \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438
    \u0415\u0433\u043e \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f
    (1851 \u0433.) \u00ab\u041e\u0441\u043d\u043e\u0432\u044b \u043e\u0431\u0449\u0435\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u043e\u0434\u043d\u043e\u0439
    \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439\u00bb
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b\u0430 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u043e\u0442
    \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0420\u0438\u043c\u0430\u043d\u043e\u0432\u044b
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438: \u0414\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f
    \u043c\u043d\u043e\u0433\u043e\u0437\u043d\u0430\u0447\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0433\u043e
    \u043a\u043e\u0440\u043d\u044f \u0438\u043b\u0438 \u043b\u043e\u0433\u0430\u0440\u0438\u0444\u043c\u0430)
    \u0420\u0438\u043c\u0430\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u2014 \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u0443
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c. \u041d\u0430 \u0442\u0430\u043a\u043e\u0439
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u043c\u043d\u043e\u0433\u043e\u0437\u043d\u0430\u0447\u043d\u0430\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f
    \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0439. \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f
    \u0438 \u0440\u043e\u0434: \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u0442\u0430\u043a\u0438\u0435 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438
    \u043c\u043e\u0436\u043d\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0438\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430 \u2014 \u0440\u043e\u0434\u0430
    (\u0447\u0438\u0441\u043b\u0430 \u00ab\u0440\u0443\u0447\u0435\u043a\u00bb), \u0447\u0442\u043e
    \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0414\u0440\u0443\u0433\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b: \u0412 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439
    (1857 \u0433.), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430
    \u0432\u0430\u0436\u043d\u044b\u043c \u0448\u0430\u0433\u043e\u043c \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439, \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u0420\u0438\u043c\u0430\u043d\u0430 \u043e\u0431
    \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0438.\n\n\U0001F4CA \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0414\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u044f
    \u0420\u0438\u043c\u0430\u043d\u0430 \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043f\u0440\u0438
    \u0436\u0438\u0437\u043d\u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u0420\u0438\u043c\u0430\u043d\u0430
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b (1859 \u0433.)
    \u2014 \u00ab\u041e \u0447\u0438\u0441\u043b\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u043d\u0435 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u044e\u0449\u0438\u0445
    \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0439 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b\u00bb
    \u2014 \u0441\u0442\u0430\u043b\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u043e\u0439 \u0434\u043b\u044f \u0446\u0435\u043b\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u2014 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b. \u0414\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u044f
    \u0420\u0438\u043c\u0430\u043d\u0430: \u0420\u0438\u043c\u0430\u043d \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u043b
    \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0438
    (\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u0435\u0449\u0435 \u042d\u0439\u043b\u0435\u0440\u0443)
    \u043d\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0420\u0438\u043c\u0430\u043d\u0430:
    \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043e\u043d \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0420\u0438\u043c\u0430\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u0447\u0442\u043e \u0432\u0441\u0435 \u043d\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u044b\u0435
    \u043d\u0443\u043b\u0438 \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u0438
    \u043b\u0435\u0436\u0430\u0442 \u043d\u0430 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439
    \u043f\u0440\u044f\u043c\u043e\u0439 `Re(s) = 1/2`. \u0412\u043b\u0438\u044f\u043d\u0438\u0435:
    \u042d\u0442\u0430 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0434\u043e \u0441\u0438\u0445
    \u043f\u043e\u0440 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0432\u0430\u0436\u043d\u044b\u0445 \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u0415\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043f\u0440\u043e\u043b\u0438\u043b\u043e \u0431\u044b \u0441\u0432\u0435\u0442 \u043d\u0430
    \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u043e\u0442\u043a\u0440\u044b\u043b\u043e \u0431\u044b
    \u043d\u043e\u0432\u044b\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u044b \u0432
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0437\u0430 \u0447\u0442\u043e
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u043e\u043c \u041a\u043b\u044d\u044f \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0430
    \u043f\u0440\u0435\u043c\u0438\u044f \u0432 1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d
    \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432.\n\n\u2699\ufe0f \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u0420\u0438\u043c\u0430\u043d\u0430 \u043d\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437
    \u0442\u0430\u043a\u0436\u0435 \u043e\u0433\u0440\u043e\u043c\u043d\u043e. \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u043b
    \u0420\u0438\u043c\u0430\u043d\u0430: \u0412 \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043f\u043e \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0440\u044f\u0434\u0430\u043c (\u0433\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f 1854 \u0433.) \u043e\u043d
    \u0441\u043e\u0437\u0434\u0430\u043b \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e
    \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u0432\u0432\u0435\u0434\u044f
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0432\u0441\u0435\u043c \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u0420\u0438\u043c\u0430\u043d\u0430. \u0420\u044f\u0434\u044b
    \u0424\u0443\u0440\u044c\u0435: \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0435\u043c\u0430\u044f
    \u043f\u043e \u0420\u0438\u043c\u0430\u043d\u0443, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u0440\u044f\u0434\u043e\u043c
    \u0424\u0443\u0440\u044c\u0435, \u0438 \u043f\u0440\u0438\u0432\u0435\u043b \u043f\u0440\u0438\u043c\u0435\u0440
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0439
    \u043f\u043e\u0447\u0442\u0438 \u043d\u0438\u0433\u0434\u0435, \u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043c\u043e\u0439
    \u0442\u0430\u043a\u0438\u043c \u0440\u044f\u0434\u043e\u043c, \u0447\u0442\u043e \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b\u043e
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u0438\u0437\u0438\u043a\u0430:
    \u0420\u0438\u043c\u0430\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u0441\u044f
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c\u0438:
    \u0438\u0437\u0443\u0447\u0430\u043b \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435
    \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u0437\u0432\u0443\u043a\u043e\u0432\u044b\u0445
    \u0432\u043e\u043b\u043d \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0439 \u0430\u043c\u043f\u043b\u0438\u0442\u0443\u0434\u044b
    (\u0432\u043e\u043b\u043d\u044b \u0420\u0438\u043c\u0430\u043d\u0430), \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435
    \u0436\u0438\u0434\u043a\u043e\u0433\u043e \u044d\u043b\u043b\u0438\u043f\u0441\u043e\u0438\u0434\u0430,
    \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438 \u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u044d\u0442\u043e\u0439
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043b\u0435\u043a\u0446\u0438\u0438
    \u043f\u043e \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438, \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0443
    \u0438 \u043c\u0430\u0433\u043d\u0435\u0442\u0438\u0437\u043c\u0443, \u0431\u044b\u043b\u0438
    \u0438\u0437\u0434\u0430\u043d\u044b \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e.\n\n\U0001F4DC
    \u041f\u043e\u043b\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432 \u0420\u0438\u043c\u0430\u043d\u0430 \u0414\u043b\u044f
    \u043f\u043e\u043b\u043d\u043e\u0442\u044b \u043a\u0430\u0440\u0442\u0438\u043d\u044b \u043f\u0440\u0438\u0432\u0435\u0434\u0443
    \u0441\u043f\u0438\u0441\u043e\u043a \u0435\u0433\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445
    \u0440\u0430\u0431\u043e\u0442: 1. Grundlagen f\u00fcr eine allgemeine Theorie der Functionen
    einer ver\u00e4nderlichen complexen Gr\u00f6sse (1851) \u2014 \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f \u043e \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445
    \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445. 2. Ueber die Gesetze
    der Vertheilung von Spannungselectricit\u00e4t... (1854) \u2014 \u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0438
    \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430. 3. Zur Theorie
    der Nobili'schen Farbenringe (1855) \u2014 \u043e \u0444\u0438\u0437\u0438\u043a\u0435 \u0446\u0432\u0435\u0442\u043d\u044b\u0445
    \u043a\u043e\u043b\u0435\u0446. 4. Beitr\u00e4ge zur Theorie der durch die Gauss'sche Reihe
    darstellbaren Functionen (1857) \u2014 \u043e \u0433\u0438\u043f\u0435\u0440\u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445. 5. Theorie der Abel'schen Functionen (1857)
    \u2014 \u0442\u0435\u043e\u0440\u0438\u044f \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439. 6. Ueber die Anzahl der Primzahlen unter einer
    gegebenen Gr\u00f6sse (1859) \u2014 \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b \u0438
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0420\u0438\u043c\u0430\u043d\u0430. 7.
    Ueber die Fortpflanzung ebener Luftwellen von endlicher Schwingungsweite (1860) \u2014 \u043e
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0438
    \u0437\u0432\u0443\u043a\u043e\u0432\u044b\u0445 \u0432\u043e\u043b\u043d. 8. Ein Beitrag
    zu den Untersuchungen \u00fcber die Bewegung eines fl\u00fcssigen gleichartigen Ellipsoides
    (1860) \u2014 \u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u044d\u043b\u043b\u0438\u043f\u0441\u043e\u0438\u0434\u0430.
    9. Ueber das Verschwinden der Theta-Functionen (1866) \u2014 \u043e \u0442\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445.
    \u0420\u0430\u0431\u043e\u0442\u044b, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0435
    \u043f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u043e, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442
    \u0435\u0433\u043e \u0438\u043d\u0430\u0443\u0433\u0443\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u043b\u0435\u043a\u0446\u0438\u044e \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438,
    \u0433\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u043f\u043e \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0440\u044f\u0434\u0430\u043c \u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u043e\u0432 \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0435,
    \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435
    \u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u0442\u0435\u043c\u0430\u043c. \u041a\u043e\u0440\u043e\u0442\u043a\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0420\u0438\u043c\u0430\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0439.
    \u0421\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0438\u043c \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u043b\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439,
    \u043d\u043e \u0438 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u0441\u0430\u043c\u043e
    \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438,
    \u043e\u043a\u0430\u0437\u0430\u0432 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u0434\u0430\u043b\u0435\u043a\u043e
    \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438."
  achievementsEn: 
  personalLifeRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434\u0430
    \u0420\u0438\u043c\u0430\u043d\u0430 \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043e\u0434\u0430\u0440\u0451\u043d\u043d\u043e\u0433\u043e, \u043d\u043e \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0437\u0430\u0441\u0442\u0435\u043d\u0447\u0438\u0432\u043e\u0433\u043e
    \u0438 \u043d\u0435 \u0441\u0430\u043c\u043e\u0433\u043e \u043a\u0440\u0435\u043f\u043a\u043e\u0433\u043e
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0437\u0430 \u0441\u0432\u043e\u044e \u043a\u043e\u0440\u043e\u0442\u043a\u0443\u044e \u0436\u0438\u0437\u043d\u044c
    \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u041e\u043d \u0431\u044b\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d
    \u043a \u0441\u0435\u043c\u044c\u0435 \u0438 \u0443\u0432\u0430\u0436\u0430\u043b \u043c\u043d\u0435\u043d\u0438\u0435
    \u043e\u0442\u0446\u0430, \u0447\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u043e
    \u0435\u0433\u043e \u043f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0435.\n\n\U0001F4D6
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u044e\u043d\u043e\u0441\u0442\u044c (1826\u20131846)
    \u0413\u0435\u043e\u0440\u0433 \u0424\u0440\u0438\u0434\u0440\u0438\u0445 \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434
    \u0420\u0438\u043c\u0430\u043d \u0440\u043e\u0434\u0438\u043b\u0441\u044f 17 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1826 \u0433\u043e\u0434\u0430 \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435 \u0411\u0440\u0435\u0437\u0435\u043b\u0435\u043d\u0446
    (\u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u0442\u0432\u043e \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440)
    \u0432 \u0441\u0435\u043c\u044c\u0435 \u0431\u0435\u0434\u043d\u043e\u0433\u043e \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u0433\u043e
    \u043f\u0430\u0441\u0442\u043e\u0440\u0430. \u041e\u043d \u0431\u044b\u043b \u0432\u0442\u043e\u0440\u044b\u043c
    \u0438\u0437 \u0448\u0435\u0441\u0442\u0438 \u0434\u0435\u0442\u0435\u0439. \u0415\u0433\u043e
    \u0440\u0430\u043d\u043d\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b\u043e \u0434\u043e\u043c\u0430 \u043f\u043e\u0434
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u043e\u0442\u0446\u0430.
    \u0421\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0440\u0430\u043d\u043e: \u0432
    \u0448\u043a\u043e\u043b\u0435, \u043a\u0443\u0434\u0430 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 14 \u043b\u0435\u0442, \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0437\u0430\u043c\u0435\u0447\u0430\u043b\u0438
    \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442. \u041e\u0434\u0438\u043d \u0438\u0437
    \u043d\u0438\u0445, \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438
    \u0432 \u041b\u044e\u043d\u0435\u0431\u0443\u0440\u0433\u0435 \u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0438\u043d
    \u0428\u043c\u0430\u043b\u044c\u0444\u0443\u0441, \u0434\u0430\u0432\u0430\u043b \u043c\u0430\u043b\u044c\u0447\u0438\u043d\u0443
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043a\u043d\u0438\u0433\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0420\u0438\u043c\u0430\u043d, \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u043e\u0441\u0432\u0430\u0438\u0432\u0430\u043b \u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b
    \u0432\u0441\u0435\u0433\u043e \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0434\u043d\u0435\u0439. \u041e\u0434\u043d\u0430\u043a\u043e \u0441\u0430\u043c \u0420\u0438\u043c\u0430\u043d
    \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0431\u044b\u043b \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e
    \u0437\u0430\u0441\u0442\u0435\u043d\u0447\u0438\u0432\u044b\u043c \u0438 \u0440\u043e\u0431\u043a\u0438\u043c,
    \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u0431\u043e\u044f\u0437\u043d\u0438
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445 \u0432\u044b\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0439
    \u0438 \u043d\u0435\u0440\u0432\u043d\u044b\u0445 \u0441\u0440\u044b\u0432\u043e\u0432.
    \u0412 1846 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    19 \u043b\u0435\u0442, \u0420\u0438\u043c\u0430\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u044e
    \u0438 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e, \u0436\u0435\u043b\u0430\u044f
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c
    \u043e\u0442\u0446\u0430 \u0438 \u0441\u0442\u0430\u0442\u044c \u043f\u0430\u0441\u0442\u043e\u0440\u043e\u043c.
    \u041f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c,
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0438\u043b
    \u043a \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.\n\n\U0001F393
    \u0423\u0447\u0451\u0431\u0430 \u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0430\u043c\u0438 (1846\u20131851)
    \u0412 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435 \u0420\u0438\u043c\u0430\u043d
    \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u043f\u043e\u0441\u0435\u0449\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438.
    \u0412\u043e\u043f\u0440\u0435\u043a\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u0439
    \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u0438\u043c\u0435\u043d\u043d\u043e \u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044c \u0428\u043c\u0430\u043b\u044c\u0444\u0443\u0441,
    \u0430 \u043d\u0435 \u0413\u0430\u0443\u0441\u0441, \u0441\u044b\u0433\u0440\u0430\u043b
    \u0440\u0435\u0448\u0430\u044e\u0449\u0443\u044e \u0440\u043e\u043b\u044c \u0432 \u0435\u0433\u043e
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0435 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442. \u041f\u043e\u043b\u0443\u0447\u0438\u0432
    \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043e\u0442\u0446\u0430, \u0420\u0438\u043c\u0430\u043d
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e,
    \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c \u0441\u0435\u0431\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0412 1847 \u0433\u043e\u0434\u0443
    \u0420\u0438\u043c\u0430\u043d \u043f\u0435\u0440\u0435\u0432\u0451\u043b\u0441\u044f \u0432
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u0431\u044b\u043b \u0432\u0435\u0434\u0443\u0449\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c. \u0422\u0430\u043c \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f
    \u0443 \u0442\u0430\u043a\u0438\u0445 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u043a\u0430\u043a \u0413\u0443\u0441\u0442\u0430\u0432
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435, \u041a\u0430\u0440\u043b \u0413\u0443\u0441\u0442\u0430\u0432
    \u042f\u043a\u043e\u0431\u0438 \u0438 \u0413\u043e\u0442\u0445\u043e\u043b\u044c\u0434 \u042d\u0439\u0437\u0435\u043d\u0448\u0442\u0435\u0439\u043d.
    \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0441\u0438\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0435\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u043e\u043a\u0430\u0437\u0430\u043b
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435\u043c \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c
    \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e\u0435 \u0438 \u044f\u0441\u043d\u043e\u0435
    \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0441\u043b\u043e\u0436\u043d\u044b\u043c
    \u0432\u0435\u0449\u0430\u043c, \u0438\u0437\u0431\u0435\u0433\u0430\u044f \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u0445
    \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439. \u0412 \u0411\u0435\u0440\u043b\u0438\u043d\u0435
    \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u043b\u0441\u044f
    \u0432 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043d\u043e\u0432\u0435\u0439\u0448\u0435\u0439
    \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0440\u0430\u0431\u043e\u0442 \u041a\u043e\u0448\u0438. \u0412 1849 \u0433\u043e\u0434\u0443
    \u0420\u0438\u043c\u0430\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d.
    \u0417\u0434\u0435\u0441\u044c \u043e\u043d \u0441\u0431\u043b\u0438\u0437\u0438\u043b\u0441\u044f
    \u0441 \u0444\u0438\u0437\u0438\u043a\u043e\u043c \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u043e\u043c
    \u0412\u0435\u0431\u0435\u0440\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b
    \u0432 \u043d\u0451\u043c \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435 \u0438 \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c
    \u0438 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c. \u041f\u0440\u0438\u043c\u0435\u0440\u043d\u043e
    \u0432 \u044d\u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0441\u044f
    \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0420\u0438\u0445\u0430\u0440\u0434\u043e\u043c
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043d\u0435\u0442 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u043e\u043c
    \u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432. 16 \u0434\u0435\u043a\u0430\u0431\u0440\u044f
    1851 \u0433\u043e\u0434\u0430 \u0420\u0438\u043c\u0430\u043d \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u00ab\u041e\u0441\u043d\u043e\u0432\u044b \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u043e\u0434\u043d\u043e\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0439
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439\u00bb \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0413\u0430\u0443\u0441\u0441\u0430. \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432\u0432\u0451\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438,
    \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0413\u0430\u0443\u0441\u0441\u0430,
    \u0432\u044b\u0441\u043e\u043a\u043e \u043e\u0446\u0435\u043d\u0438\u0432\u0448\u0435\u0433\u043e
    \u0442\u0430\u043b\u0430\u043d\u0442 \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0430.\n\n\U0001F9D1\u200d\U0001F3EB
    \u0420\u0430\u0431\u043e\u0442\u0430, \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0432\u0441\u0435\u043c\u0438\u0440\u043d\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    (1854\u20131866) \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u0430,
    \u0420\u0438\u043c\u0430\u043d\u0443 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u043b\u043e
    \u043f\u0440\u043e\u0439\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443
    \u0445\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0443\u044e
    \u043f\u0440\u043e\u0431\u043d\u0443\u044e \u043b\u0435\u043a\u0446\u0438\u044e. \u041e\u043d
    \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0442\u0440\u0438 \u0442\u0435\u043c\u044b,
    \u043d\u043e \u0413\u0430\u0443\u0441\u0441 \u0432\u044b\u0431\u0440\u0430\u043b \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e \u0441\u0430\u043c\u0443\u044e \u0441\u043b\u043e\u0436\u043d\u0443\u044e
    \u2014 \u00ab\u041e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430\u0445, \u043b\u0435\u0436\u0430\u0449\u0438\u0445
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb.
    \u041b\u0435\u043a\u0446\u0438\u044f, \u0441\u043e\u0441\u0442\u043e\u044f\u0432\u0448\u0430\u044f\u0441\u044f
    10 \u0438\u044e\u043d\u044f 1854 \u0433\u043e\u0434\u0430, \u0441\u0442\u0430\u043b\u0430
    \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u0435\u0439. \u041f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430, \u0413\u0430\u0443\u0441\u0441 \u0431\u044b\u043b
    \u043f\u043e\u0440\u0430\u0436\u0451\u043d \u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439
    \u0438 \u043d\u043e\u0432\u0438\u0437\u043d\u043e\u0439 \u0438\u0434\u0435\u0439 \u0420\u0438\u043c\u0430\u043d\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0442\u0440\u0438\u0443\u043c\u0444, \u0420\u0438\u043c\u0430\u043d\u0430 \u043d\u0435
    \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u0438 \u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430. \u041e\u043d \u043d\u0430\u0447\u0430\u043b
    \u0441\u0432\u043e\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u0430 \u0441 \u043c\u0438\u0437\u0435\u0440\u043d\u044b\u043c
    \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u044c\u0435\u043c, \u0447\u0438\u0442\u0430\u044f
    \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u043c. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435,
    \u043e\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c.
    \u0412 1857 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0442\u0440\u0443\u0434\u044b \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u0431\u0435\u043b\u0435\u0432\u044b\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438, \u043d\u0430\u043a\u043e\u043d\u0435\u0446,
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u0433\u043e
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u0412 1859 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0414\u0438\u0440\u0438\u0445\u043b\u0435, \u0420\u0438\u043c\u0430\u043d
    \u0437\u0430\u043d\u044f\u043b \u0435\u0433\u043e \u043c\u0435\u0441\u0442\u043e, \u0441\u0442\u0430\u0432
    \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u0438 \u0433\u043b\u0430\u0432\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435.
    \u0412 \u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u00ab\u041e \u0447\u0438\u0441\u043b\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u043d\u0435 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u044e\u0449\u0438\u0445
    \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0439 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b\u00bb,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443
    \u0420\u0438\u043c\u0430\u043d\u0430. \u041a\u0430\u0440\u043b \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0438\u0437 \u0411\u0435\u0440\u043b\u0438\u043d\u0430,
    \u0432\u044b\u0441\u043e\u043a\u043e \u043e\u0446\u0435\u043d\u0438\u043b \u044d\u0442\u0443
    \u0440\u0430\u0431\u043e\u0442\u0443, \u0447\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044e \u0420\u0438\u043c\u0430\u043d\u0430 \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0438 \u0447\u043b\u0435\u043d\u043e\u043c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438 \u043d\u0430\u0443\u043a \u0438 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434 \u0442\u0435\u043e\u0440\u0435\u043c\u0430\u043c\u0438
    \u0438 \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438 \u0431\u044b\u043b\u0430 \u0442\u0435\u0441\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u043e\u0431\u0449\u0435\u043d\u0438\u0435\u043c
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0451\u043d\u044b\u043c\u0438.
    \u0412 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435 \u043e\u043d \u0442\u0435\u0441\u043d\u043e
    \u043e\u0431\u0449\u0430\u043b\u0441\u044f \u0441 \u0420\u0438\u0445\u0430\u0440\u0434\u043e\u043c
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u043c, \u0438 \u0438\u0445 \u0434\u0440\u0443\u0436\u0431\u0430
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0412 1858 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u0438 \u0441 \u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0438\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c\u0438, \u0442\u0430\u043a\u0438\u043c\u0438
    \u043a\u0430\u043a \u042d\u043d\u0440\u0438\u043a\u043e \u0411\u0435\u0442\u0442\u0438,
    \u0447\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044e
    \u0435\u0433\u043e \u0438\u0434\u0435\u0439 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435.\n\n\U0001F494
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c, \u0431\u043e\u043b\u0435\u0437\u043d\u044c
    \u0438 \u0441\u043c\u0435\u0440\u0442\u044c 3 \u0438\u044e\u043d\u044f 1862 \u0433\u043e\u0434\u0430
    \u0420\u0438\u043c\u0430\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u042d\u043b\u044c\u0437\u0435
    \u041a\u043e\u0445, \u043f\u043e\u0434\u0440\u0443\u0433\u0435 \u0441\u0432\u043e\u0435\u0439
    \u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0439 \u0441\u0435\u0441\u0442\u0440\u044b. \u0412\u0441\u043a\u043e\u0440\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0432\u0430\u0434\u044c\u0431\u044b, \u043e\u0441\u0435\u043d\u044c\u044e
    1862 \u0433\u043e\u0434\u0430, \u043e\u043d \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u043b,
    \u0438 \u044d\u0442\u043e \u0443\u0441\u043a\u043e\u0440\u0438\u043b\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043e\u043d, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0431\u043e\u043b\u0435\u043b
    \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430. \u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437
    \u0443\u0436\u0435 \u0443\u043d\u0451\u0441 \u0436\u0438\u0437\u043d\u0438 \u0435\u0433\u043e
    \u043c\u0430\u0442\u0435\u0440\u0438 \u0438 \u0434\u0432\u0443\u0445 \u0441\u0435\u0441\u0442\u0451\u0440.
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0433\u043e\u0434\u0430 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u0420\u0438\u043c\u0430\u043d
    \u043f\u0440\u043e\u0432\u0451\u043b \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c
    \u0432 \u0418\u0442\u0430\u043b\u0438\u0438, \u043d\u0430\u0434\u0435\u044f\u0441\u044c,
    \u0447\u0442\u043e \u0431\u043e\u043b\u0435\u0435 \u043c\u044f\u0433\u043a\u0438\u0439 \u043a\u043b\u0438\u043c\u0430\u0442
    \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u0435\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0431\u043e\u043b\u0435\u0437\u043d\u044c\u044e. \u0412 \u043d\u0430\u0447\u0430\u043b\u0435
    \u0410\u0432\u0441\u0442\u0440\u043e-\u043f\u0440\u0443\u0441\u0441\u043a\u043e\u0439 \u0432\u043e\u0439\u043d\u044b
    (1866) \u043e\u043d, \u043a\u0430\u043a \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d
    \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440\u0430, \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0431\u0435\u0436\u0430\u0442\u044c \u0438\u0437 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0430
    \u0438 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0435\u0445\u0430\u043b
    \u0432 \u0418\u0442\u0430\u043b\u0438\u044e. 20 \u0438\u044e\u043b\u044f 1866 \u0433\u043e\u0434\u0430,
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 39 \u043b\u0435\u0442, \u0420\u0438\u043c\u0430\u043d
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437\u0430
    \u0432 \u0421\u0435\u043b\u0430\u0441\u043a\u0435 \u043d\u0430 \u0431\u0435\u0440\u0435\u0433\u0443
    \u043e\u0437\u0435\u0440\u0430 \u041b\u0430\u0433\u043e-\u041c\u0430\u0434\u0436\u043e\u0440\u0435
    \u0432 \u0418\u0442\u0430\u043b\u0438\u0438. \u0420\u044f\u0434\u043e\u043c \u0441 \u043d\u0438\u043c
    \u0431\u044b\u043b\u0438 \u0436\u0435\u043d\u0430 \u042d\u043b\u044c\u0437\u0430 \u0438
    \u0438\u0445 \u0442\u0440\u0451\u0445\u043b\u0435\u0442\u043d\u044f\u044f \u0434\u043e\u0447\u044c
    \u0418\u0434\u0430. \u0415\u0433\u043e \u0434\u0440\u0443\u0433 \u0420\u0438\u0445\u0430\u0440\u0434
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043a\u0440\u0430\u0441\u043e\u0447\u043d\u043e
    \u043e\u043f\u0438\u0441\u0430\u043b \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0434\u043d\u0438: \u0437\u0430 \u0434\u0435\u043d\u044c \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438
    \u043e\u043d, \u043e\u0442\u0434\u044b\u0445\u0430\u044f \u0432 \u0442\u0435\u043d\u0438
    \u0444\u0438\u0433\u043e\u0432\u043e\u0433\u043e \u0434\u0435\u0440\u0435\u0432\u0430, \u0432\u0441\u0451
    \u0435\u0449\u0451 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u0447\u0435\u043d\u043d\u043e\u0439
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044c\u044e. \u041e\u043d \u0443\u0448\u0451\u043b
    \u043c\u0438\u0440\u043d\u043e, \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u0432 \u0436\u0435\u043d\u0443
    \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u044c \u043f\u0440\u0438\u0432\u0435\u0442 \u0432\u0441\u0435\u043c
    \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u043c \u0438 \u043f\u043e\u0446\u0435\u043b\u043e\u0432\u0430\u0442\u044c
    \u0438\u0445 \u0434\u043e\u0447\u044c. \u041f\u043e\u0445\u043e\u0440\u043e\u043d\u0435\u043d
    \u043e\u043d \u043f\u0440\u0438 \u0446\u0435\u0440\u043a\u0432\u0438 \u0432 \u0411\u0438\u0433\u0430\u043d\u0446\u043e\u043b\u043e.
    \u041d\u0430 \u0435\u0433\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0438 \u0432\u044b\u0441\u0435\u0447\u0435\u043d\u0430
    \u044d\u043f\u0438\u0442\u0430\u0444\u0438\u044f: \u00ab\u041b\u044e\u0431\u044f\u0449\u0438\u043c
    \u0411\u043e\u0433\u0430 \u0432\u0441\u0435 \u0441\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u043a\u043e \u0431\u043b\u0430\u0433\u0443\u00bb. \u041c\u043e\u0433\u0438\u043b\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0437\u0436\u0435 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0430
    \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u043a\u0435
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0430, \u043d\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u0430\u044f
    \u043f\u043b\u0438\u0442\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c.
    \u041f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u0435\u0433\u043e
    \u0432\u0434\u043e\u0432\u0430 \u042d\u043b\u044c\u0437\u0430 \u0438 \u0434\u043e\u0447\u044c
    \u0418\u0434\u0430 \u0432\u0435\u0440\u043d\u0443\u043b\u0438\u0441\u044c \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d.
    \u0427\u0430\u0441\u0442\u044c \u0435\u0433\u043e \u043d\u0435\u0438\u0437\u0434\u0430\u043d\u043d\u044b\u0445
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u0435\u0439, \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e,
    \u0431\u044b\u043b\u0430 \u0443\u0442\u0435\u0440\u044f\u043d\u0430."
  personalLifeEn: 
  shortBioRu: "\u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0420\u0438\u043c\u0430\u043d (\u043f\u043e\u043b\u043d\u043e\u0435
    \u0438\u043c\u044f \u2014 \u0413\u0435\u043e\u0440\u0433 \u0424\u0440\u0438\u0434\u0440\u0438\u0445
    \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0420\u0438\u043c\u0430\u043d) \u2014
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438
    \u043e\u0441\u043d\u043e\u0432\u044b \u0441\u0440\u0430\u0437\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0444\u0438\u0437\u0438\u043a\u0438.
    \u0415\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043f\u0440\u0435\u0435\u043c\u043d\u0438\u043a\u043e\u043c \u0413\u0430\u0443\u0441\u0441\u0430
    \u0438 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XIX \u0432\u0435\u043a\u0430.
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u044e\u043d\u043e\u0441\u0442\u044c:
    \u043f\u0443\u0442\u044c \u043e\u0442 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u0438 \u043a
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0420\u0438\u043c\u0430\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 17 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1826 \u0433\u043e\u0434\u0430 \u0432 \u0431\u0435\u0434\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0435
    \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0430\u0441\u0442\u043e\u0440\u0430
    \u0432 \u0434\u0435\u0440\u0435\u0432\u043d\u0435 \u0411\u0440\u0435\u0437\u0435\u043b\u0435\u043d\u0446,
    \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440. \u041e\u043d \u0431\u044b\u043b \u0432\u0442\u043e\u0440\u044b\u043c
    \u0438\u0437 \u0448\u0435\u0441\u0442\u0438 \u0434\u0435\u0442\u0435\u0439. \u0415\u0433\u043e
    \u043c\u0430\u0442\u044c, \u0428\u0430\u0440\u043b\u043e\u0442\u0442\u0430 \u042d\u0431\u0435\u043b\u043b\u044c,
    \u0443\u043c\u0435\u0440\u043b\u0430 \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437\u0430,
    \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u0435\u0449\u0451 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u043c;
    \u044d\u0442\u0430 \u0436\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0443\u043d\u0435\u0441\u043b\u0430 \u0436\u0438\u0437\u043d\u0438 \u0434\u0432\u0443\u0445
    \u0435\u0433\u043e \u0441\u0435\u0441\u0442\u0451\u0440 \u0438 \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u043e.
    \u0421\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0443 \u043d\u0435\u0433\u043e
    \u0440\u0430\u043d\u043e. \u041e\u0434\u0438\u043d \u0438\u0437 \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0445
    \u0443\u0447\u0438\u0442\u0435\u043b\u0435\u0439, \u0437\u0430\u043c\u0435\u0442\u0438\u0432
    \u0442\u0430\u043b\u0430\u043d\u0442 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430, \u0434\u0430\u0432\u0430\u043b
    \u0435\u043c\u0443 \u043a\u043d\u0438\u0433\u0438 \u043f\u043e \u0432\u044b\u0441\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435, \u0432 \u0442\u043e\u043c
    \u0447\u0438\u0441\u043b\u0435 \u0442\u0440\u0443\u0434\u044b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0420\u0438\u043c\u0430\u043d, \u043a\u0430\u043a \u0433\u043e\u0432\u043e\u0440\u044f\u0442,
    \u043e\u0441\u0432\u043e\u0438\u043b \u0437\u0430 \u043d\u0435\u0434\u0435\u043b\u044e.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u043e, \u043e\u043d
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0432 1846 \u0433\u043e\u0434\u0443,
    \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0438\u044e
    \u0438 \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e, \u0436\u0435\u043b\u0430\u044f
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c
    \u043e\u0442\u0446\u0430. \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0420\u0438\u043c\u0430\u043d \u043d\u0430\u0447\u0430\u043b \u043f\u043e\u0441\u0435\u0449\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0447\u0438\u0442\u0430\u043b \u041a\u0430\u0440\u043b
    \u0424\u0440\u0438\u0434\u0440\u0438\u0445 \u0413\u0430\u0443\u0441\u0441. \u041f\u043e\u0434
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u0413\u0430\u0443\u0441\u0441\u0430 \u043e\u043d
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0442\u0435\u043e\u043b\u043e\u0433\u0438\u044e
    \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u043e\u0442\u0446\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c
    \u0441\u0435\u0431\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u0413\u043e\u0434\u044b
    \u0443\u0447\u0435\u043d\u0438\u044f \u0438 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432
    \u0412 1847 \u0433\u043e\u0434\u0443 \u0420\u0438\u043c\u0430\u043d \u043f\u0435\u0440\u0435\u0432\u0451\u043b\u0441\u044f
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f
    \u0432\u0435\u0434\u0443\u0449\u0438\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0446\u0435\u043d\u0442\u0440\u043e\u043c \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438.
    \u0422\u0430\u043c \u043e\u043d \u0441\u043b\u0443\u0448\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432:
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435, \u042f\u043a\u043e\u0431\u0438 \u0438 \u0428\u0442\u0435\u0439\u043d\u0435\u0440\u0430.
    \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u043e\u043a\u0430\u0437\u0430\u043b \u043d\u0430
    \u043d\u0435\u0433\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0441\u0438\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435, \u043f\u0440\u0438\u0432\u0438\u0432 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b \u0438 \u0430\u043d\u0430\u043b\u0438\u0437\u0443.
    \u0412 1849 \u0433\u043e\u0434\u0443 \u0420\u0438\u043c\u0430\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d, \u0433\u0434\u0435 \u0441\u0431\u043b\u0438\u0437\u0438\u043b\u0441\u044f
    \u0441 \u0444\u0438\u0437\u0438\u043a\u043e\u043c \u0412\u0438\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u043e\u043c
    \u0412\u0435\u0431\u0435\u0440\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0431\u0443\u0434\u0438\u043b
    \u0432 \u043d\u0451\u043c \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441
    \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435. \u0412 \u044d\u0442\u043e\u043c \u0436\u0435 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0438
    \u043f\u043e\u0434\u0440\u0443\u0436\u0438\u043b\u0441\u044f \u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c
    \u0420\u0438\u0445\u0430\u0440\u0434\u043e\u043c \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0436\u0435 \u0441\u0442\u0430\u043b
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u043e\u043c \u0438 \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u043e\u0432. \u0414\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0430\u044f
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439
    \u0412 1851 \u0433\u043e\u0434\u0443 \u0420\u0438\u043c\u0430\u043d \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u00ab\u041e\u0441\u043d\u043e\u0432\u044b \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u043e\u0434\u043d\u043e\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0439
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439\u00bb. \u0415\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c \u0431\u044b\u043b
    \u0413\u0430\u0443\u0441\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u0441\u043e\u043a\u043e
    \u043e\u0446\u0435\u043d\u0438\u043b \u0440\u0430\u0431\u043e\u0442\u0443. \u0412 \u044d\u0442\u043e\u0439
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u0420\u0438\u043c\u0430\u043d
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u043e\u0441\u043d\u043e\u0432\u044b \u043d\u043e\u0432\u043e\u0433\u043e
    \u043f\u043e\u0434\u0445\u043e\u0434\u0430 \u043a \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0432\u0432\u0435\u0434\u044f \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438
    \u2014 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u044a\u0435\u043a\u0442\u0430, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0435\u0433\u043e
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u043c\u043d\u043e\u0433\u043e\u0437\u043d\u0430\u0447\u043d\u044b\u0435
    \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043a\u0430\u043a \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u044b\u0435
    \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438. \u041f\u0440\u043e\u0431\u043d\u0430\u044f
    \u043b\u0435\u043a\u0446\u0438\u044f: \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u0430,
    \u0420\u0438\u043c\u0430\u043d\u0443 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e
    \u0431\u044b\u043b\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u043f\u0440\u043e\u0431\u043d\u0443\u044e
    \u043b\u0435\u043a\u0446\u0438\u044e. \u041e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u043d\u0430 \u0432\u044b\u0431\u043e\u0440 \u0442\u0440\u0438 \u0442\u0435\u043c\u044b,
    \u0438 \u0413\u0430\u0443\u0441\u0441, \u043a \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u044e
    \u0420\u0438\u043c\u0430\u043d\u0430, \u0432\u044b\u0431\u0440\u0430\u043b \u0442\u0435\u043c\u0443
    \u00ab\u041e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430\u0445, \u043b\u0435\u0436\u0430\u0449\u0438\u0445
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb.
    \u041b\u0435\u043a\u0446\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c
    10 \u0438\u044e\u043d\u044f 1854 \u0433\u043e\u0434\u0430. \u041f\u043e \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430, \u0413\u0430\u0443\u0441\u0441,
    \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u0439
    \u043d\u0430 \u043d\u0435\u0439, \u0431\u044b\u043b \u043f\u043e\u0440\u0430\u0436\u0451\u043d
    \u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439 \u0438 \u043d\u043e\u0432\u0438\u0437\u043d\u043e\u0439
    \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u0438\u0434\u0435\u0439. \u0412
    \u044d\u0442\u043e\u043c \u0434\u043e\u043a\u043b\u0430\u0434\u0435 \u0420\u0438\u043c\u0430\u043d
    \u043e\u0431\u043e\u0431\u0449\u0438\u043b \u0433\u0430\u0443\u0441\u0441\u043e\u0432\u0443
    \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439
    \u043d\u0430 \u043c\u043d\u043e\u0433\u043e\u043c\u0435\u0440\u043d\u044b\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u0432\u0432\u0435\u0434\u044f \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u0430
    \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f, \u0440\u0438\u043c\u0430\u043d\u043e\u0432\u043e\u0439
    \u043c\u0435\u0442\u0440\u0438\u043a\u0438 \u0438 \u0442\u0435\u043d\u0437\u043e\u0440\u0430
    \u043a\u0440\u0438\u0432\u0438\u0437\u043d\u044b. \u041e\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b,
    \u0447\u0442\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043c\u043e\u0436\u0435\u0442
    \u043d\u0435 \u0431\u044b\u0442\u044c \u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439,
    \u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0432\u043e\u043f\u0440\u043e\u0441
    \u043e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u0445
    \u0435\u0433\u043e \u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0432\u043e\u0439\u0441\u0442\u0432,
    \u0447\u0442\u043e \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f
    \u043f\u0440\u0435\u0434\u0432\u043e\u0441\u0445\u0438\u0442\u0438\u043b\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u042d\u0439\u043d\u0448\u0442\u0435\u0439\u043d\u0430. \u041d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043f\u0443\u0442\u044c \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 1854
    \u0433\u043e\u0434: \u0420\u0438\u043c\u0430\u043d \u0441\u0442\u0430\u043b \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u043e\u043c
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    1857 \u0433\u043e\u0434: \u041f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430. 1859 \u0433\u043e\u0434: \u041f\u043e\u0441\u043b\u0435
    \u0441\u043c\u0435\u0440\u0442\u0438 \u0414\u0438\u0440\u0438\u0445\u043b\u0435 \u0437\u0430\u043d\u044f\u043b
    \u0435\u0433\u043e \u043c\u0435\u0441\u0442\u043e, \u0441\u0442\u0430\u0432 \u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0438 \u0433\u043b\u0430\u0432\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0435.
    \u0412 \u044d\u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u00ab\u041e \u0447\u0438\u0441\u043b\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u043d\u0435 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u044e\u0449\u0438\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0439
    \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b\u00bb, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043d\u043a\u0446\u0438\u044e
    \u0438 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u0420\u0438\u043c\u0430\u043d\u0430 \u043e
    \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0435\u0451 \u043d\u0443\u043b\u0435\u0439,
    \u043e\u0441\u0442\u0430\u044e\u0449\u0443\u044e\u0441\u044f \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u0445 \u043d\u0435\u0440\u0435\u0448\u0451\u043d\u043d\u044b\u0445
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0437\u0430\u0441\u043b\u0443\u0433\u0438 \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u044b
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c:
    \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0447\u043b\u0435\u043d\u043e\u043c
    \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439 (1859), \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0439 \u043d\u0430\u0443\u043a \u0438 \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    (1860). \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0412 1862 \u0433\u043e\u0434\u0443 \u0420\u0438\u043c\u0430\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u042d\u043b\u044c\u0437\u0435 \u041a\u043e\u0445. \u0412\u0441\u043a\u043e\u0440\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0441\u0432\u0430\u0434\u044c\u0431\u044b \u043e\u043d \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e
    \u0437\u0430\u0431\u043e\u043b\u0435\u043b \u043f\u043b\u0435\u0432\u0440\u0438\u0442\u043e\u043c,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u0435\u0433\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437\u043e\u043c.
    \u041d\u0430\u0434\u0435\u044f\u0441\u044c \u043f\u043e\u043f\u0440\u0430\u0432\u0438\u0442\u044c
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u043e\u043d \u0441 \u0436\u0435\u043d\u043e\u0439
    \u0438 \u0434\u043e\u0447\u0435\u0440\u044c\u044e \u0418\u0434\u043e\u0439 \u0443\u0435\u0445\u0430\u043b
    \u0432 \u0418\u0442\u0430\u043b\u0438\u044e. \u0420\u0438\u043c\u0430\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0451\u0437\u0430 20 \u0438\u044e\u043b\u044f
    1866 \u0433\u043e\u0434\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 39
    \u043b\u0435\u0442 \u0432 \u043c\u0435\u0441\u0442\u0435\u0447\u043a\u0435 \u0421\u0435\u043b\u0430\u0441\u043a\u0430
    \u043d\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u043e\u0437\u0435\u0440\u0430 \u041b\u0430\u0433\u043e-\u041c\u0430\u0434\u0436\u043e\u0440\u0435
    \u0432 \u0418\u0442\u0430\u043b\u0438\u0438. \u0415\u0433\u043e \u043c\u043e\u0433\u0438\u043b\u0430
    \u0431\u044b\u043b\u0430 \u043f\u043e\u0437\u0436\u0435 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0430
    \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u043a\u0435
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0430, \u043d\u043e \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u043d\u0430\u044f
    \u043f\u043b\u0438\u0442\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0443\u044e
    \u0436\u0438\u0437\u043d\u044c \u0438 \u0432\u0441\u0435\u0433\u043e \u0434\u0435\u0441\u044f\u0442\u044c
    \u043b\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b, \u0420\u0438\u043c\u0430\u043d \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u0430 \u0435\u0433\u043e
    \u0438\u0434\u0435\u0438 \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0425\u043e\u0442\u044f \u0436\u0438\u0437\u043d\u044c \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434\u0430
    \u0420\u0438\u043c\u0430\u043d\u0430 \u0431\u044b\u043b\u0430 \u043e\u043c\u0440\u0430\u0447\u0435\u043d\u0430
    \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u044c\u044e, \u0431\u043e\u043b\u0435\u0437\u043d\u044f\u043c\u0438
    \u0438 \u0447\u0435\u0440\u0435\u0434\u043e\u0439 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0445
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0439, \u043e\u043d\u0430 \u043f\u043e\u043b\u043d\u0430
    \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u044f\u0440\u043a\u043e \u0432\u044b\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u044e\u0442
    \u0438 \u0435\u0433\u043e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0433\u0435\u043d\u0438\u0439, \u0438 \u0441\u043b\u043e\u0436\u043d\u044b\u0439, \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u044b\u0439
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440. \u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.\n\n\U0001F92F
    \u0424\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0430\u043c\u044f\u0442\u044c
    \u0438 \"900 \u0441\u0442\u0440\u0430\u043d\u0438\u0446 \u0437\u0430 6 \u0434\u043d\u0435\u0439\"
    \u041f\u043e\u0436\u0430\u043b\u0443\u0439, \u0441\u0430\u043c\u044b\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0430\u043d\u0435\u043a\u0434\u043e\u0442 \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0420\u0438\u043c\u0430\u043d\u0430
    \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0435\u0433\u043e \u0443\u0447\u0435\u0431\u043e\u0439
    \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438. \u0415\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u043e\u043d\u044f\u043b\u0438, \u0447\u0442\u043e
    \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u0430,
    \u0438 \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u043b\u0438 \u0435\u0433\u043e \u043e\u0442
    \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u0427\u0442\u043e\u0431\u044b \u043c\u0430\u043b\u044c\u0447\u0438\u043a \u043d\u0435 \u0441\u043a\u0443\u0447\u0430\u043b,
    \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438
    \u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0435\u043c\u0443 \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0442\u0440\u0443\u0434 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430
    \u00ab\u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b\u00bb \u2014 \u043a\u043d\u0438\u0433\u0443
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432 \u0442\u0435 \u0433\u043e\u0434\u044b
    \u043c\u043e\u0433\u043b\u0438 \u043e\u0441\u0438\u043b\u0438\u0442\u044c \u043b\u0438\u0448\u044c
    \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u0432 \u043c\u0438\u0440\u0435. \u041a\u0430\u043a\u043e\u0432\u043e
    \u0436\u0435 \u0431\u044b\u043b\u043e \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435
    \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430, \u043a\u043e\u0433\u0434\u0430 \u0447\u0435\u0440\u0435\u0437
    \u0448\u0435\u0441\u0442\u044c \u0434\u043d\u0435\u0439 \u0420\u0438\u043c\u0430\u043d \u0432\u0435\u0440\u043d\u0443\u043b
    \u043a\u043d\u0438\u0433\u0443. \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441, \u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043e\u043d \u0443\u0441\u043f\u0435\u043b \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c,
    \u044e\u043d\u044b\u0439 \u0411\u0435\u0440\u043d\u0445\u0430\u0440\u0434 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e
    \u043e\u0442\u0432\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u043f\u0440\u043e\u0447\u0435\u043b
    \u0432\u0441\u044e \u043a\u043d\u0438\u0433\u0443 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u2014 \u0438, \u043a\u0430\u043a \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u043e\u0441\u044c
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438, \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u0443\u0441\u0432\u043e\u0438\u043b \u0435\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435.
    \u0412 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u043d
    \"\u043f\u043e\u0433\u043b\u043e\u0449\u0430\u043b \u043f\u043e 900 \u0441\u0442\u0440\u0430\u043d\u0438\u0446
    \u0432 \u043d\u0435\u0434\u0435\u043b\u044e\", \u0447\u0442\u043e, \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f
    \u043e\u0431\u044a\u0435\u043c \u0440\u0430\u0431\u043e\u0442\u044b \u041b\u0435\u0436\u0430\u043d\u0434\u0440\u0430,
    \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0432\u043f\u043e\u043b\u043d\u0435 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e.\n\n\U0001F3AD
    \u0420\u043e\u0431\u043a\u0438\u0439 \u0433\u0435\u043d\u0438\u0439 \u0438 \"\u0418\u0441\u043a\u0440\u044b
    \u0432\u043d\u0443\u0442\u0440\u0438 \u0445\u0438\u0431\u0430\u0440\u043a\u0438\" \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u0439 \u0443\u043c, \u0420\u0438\u043c\u0430\u043d
    \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u043a\u0440\u0430\u0439\u043d\u0435
    \u0437\u0430\u0441\u0442\u0435\u043d\u0447\u0438\u0432\u044b\u043c \u0438 \u0434\u0430\u0436\u0435
    \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e \u0440\u043e\u0431\u043a\u0438\u043c.
    \u041e\u043d \u0442\u0430\u043a \u0441\u0438\u043b\u044c\u043d\u043e \u0431\u043e\u044f\u043b\u0441\u044f
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445 \u0432\u044b\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0439,
    \u0447\u0442\u043e \u044d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u043f\u0440\u0438\u0447\u0438\u043d, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u043d \u0432 \u0438\u0442\u043e\u0433\u0435 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043e\u0442 \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u043f\u0430\u0441\u0442\u043e\u0440\u0430,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u043b
    \u0435\u0433\u043e \u043e\u0442\u0435\u0446. \u0415\u0433\u043e \u0437\u0430\u0441\u0442\u0435\u043d\u0447\u0438\u0432\u043e\u0441\u0442\u044c
    \u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0430\u0441\u044c \u043d\u0430 \u0432\u0441\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438: \u043e\u043d \u0438\u0437\u0431\u0435\u0433\u0430\u043b
    \u0441\u0432\u0435\u0442\u0441\u043a\u0438\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432
    \u0438 \u0441\u0438\u043b\u044c\u043d\u043e \u0442\u043e\u0441\u043a\u043e\u0432\u0430\u043b
    \u043f\u043e \u0434\u043e\u043c\u0443, \u0435\u0441\u043b\u0438 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f
    \u0432\u0434\u0430\u043b\u0438 \u043e\u0442 \u0441\u0435\u043c\u044c\u0438. \u041d\u043e
    \u044d\u0442\u0430 \u0432\u043d\u0435\u0448\u043d\u044f\u044f \u0440\u043e\u0431\u043e\u0441\u0442\u044c
    \u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0430
    \u0441 \u0434\u0435\u0440\u0437\u043e\u0441\u0442\u044c\u044e \u0438 \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u044c\u044e
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043c\u044b\u0441\u043b\u0438.
    \u0410\u0432\u0442\u043e\u0440 \u043a\u043d\u0438\u0433\u0438 \u043e \u0420\u0438\u043c\u0430\u043d\u0435
    \u0414\u0436\u043e\u043d \u0414\u0435\u0440\u0431\u0438\u0448\u0438\u0440 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442
    \u044f\u0440\u043a\u0443\u044e \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u044e: \u0432\u043d\u0435\u0448\u043d\u0435
    \u0420\u0438\u043c\u0430\u043d \u0431\u044b\u043b \u043f\u043e\u0434\u043e\u0431\u0435\u043d
    \u0443\u0431\u043e\u0433\u043e\u0439 \u0445\u0438\u0436\u0438\u043d\u0435, \u043d\u043e
    \u0441\u0442\u043e\u0438\u043b\u043e \u043f\u0435\u0440\u0435\u0441\u0442\u0443\u043f\u0438\u0442\u044c
    \u043f\u043e\u0440\u043e\u0433, \u043a\u0430\u043a \u0432\u043d\u0443\u0442\u0440\u0438
    \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u043b\u043e\u0441\u044c \u0441\u0438\u044f\u043d\u0438\u0435,
    \u044f\u0440\u0447\u0435 \u0441\u043e\u043b\u043d\u0446\u0430. \u041e\u043d \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \"\u0431\u0435\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u044b\u0439 \u0440\u0430\u0437\u043c\u0430\u0445
    \u0438 \u044d\u043d\u0435\u0440\u0433\u0438\u044e\", \u0440\u0435\u0448\u0430\u044f \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043b\u0438
    \u0443\u0441\u0442\u043e\u044f\u0432\u0448\u0438\u0435\u0441\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f
    \u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435.\n\n\U0001F393
    \u0422\u0440\u0438\u0443\u043c\u0444, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043b\u0443\u0448\u0430\u043b\u0438
    \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u0412 1854 \u0433\u043e\u0434\u0443 \u0420\u0438\u043c\u0430\u043d
    \u0433\u043e\u0442\u043e\u0432\u0438\u043b\u0441\u044f \u043a \u043f\u0440\u043e\u0431\u043d\u043e\u0439
    \u043b\u0435\u043a\u0446\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043c\u0435\u0441\u0442\u043e \u043f\u0440\u0438\u0432\u0430\u0442-\u0434\u043e\u0446\u0435\u043d\u0442\u0430.
    \u0415\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044c, \u0432\u0435\u043b\u0438\u043a\u0438\u0439
    \u041a\u0430\u0440\u043b \u0424\u0440\u0438\u0434\u0440\u0438\u0445 \u0413\u0430\u0443\u0441\u0441,
    \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0432\u044b\u0431\u0440\u0430\u043b
    \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0443\u044e
    \u0442\u0435\u043c\u0443 \u2014 \u00ab\u041e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430\u0445,
    \u043b\u0435\u0436\u0430\u0449\u0438\u0445 \u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\u00bb, \u0442\u0430\u043a \u043a\u0430\u043a
    \u0435\u043c\u0443 \u0441\u0430\u043c\u043e\u043c\u0443 \u0431\u044b\u043b\u043e \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u043e,
    \u0447\u0442\u043e \u0441\u043a\u0430\u0436\u0435\u0442 \u043c\u043e\u043b\u043e\u0434\u043e\u0439
    \u0443\u0447\u0435\u043d\u044b\u0439. \u041b\u0435\u043a\u0446\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c
    10 \u0438\u044e\u043d\u044f 1854 \u0433\u043e\u0434\u0430 \u0438 \u0441\u0442\u0430\u043b\u0430
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0442\u0440\u0438\u0443\u043c\u0444\u043e\u043c,
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u044b \u043d\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u041e\u0434\u043d\u0430\u043a\u043e,
    \u043f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u0439 \u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0439,
    \u0447\u0442\u043e \u0438\u0437 \u0432\u0441\u0435\u0439 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438
    \u0435\u0435 \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u043f\u043e\u043d\u044f\u043b,
    \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0430\u043c
    \u0413\u0430\u0443\u0441\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u0438\u0448\u0435\u043b
    \u0432 \u0432\u043e\u0441\u0442\u043e\u0440\u0433. \u041a\u0443\u0440\u044c\u0435\u0437\u043d\u043e
    \u0438 \u0442\u043e, \u0447\u0442\u043e \u043d\u0430 \u0441\u0432\u043e\u044e \u0441\u0430\u043c\u0443\u044e
    \u043f\u0435\u0440\u0432\u0443\u044e \u043b\u0435\u043a\u0446\u0438\u044e \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f \u0433\u043e\u0434\u043e\u043c
    \u0440\u0430\u043d\u0435\u0435 \u0420\u0438\u043c\u0430\u043d \u0441 \u0440\u0430\u0434\u043e\u0441\u0442\u044c\u044e
    \u0441\u043e\u043e\u0431\u0449\u0430\u043b \u043e \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e
    \u0431\u043e\u043b\u044c\u0448\u043e\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u0435\u0439 \u2014 \u0430 \u0438\u043c\u0435\u043d\u043d\u043e,
    \u0432\u043e\u0441\u044c\u043c\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u0445.\n\n\U0001F48D
    \u0421\u0435\u043c\u0435\u0439\u043d\u044b\u0435 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438
    \u0438 \u043d\u0435\u0434\u043e\u043b\u0433\u043e\u0435 \u0441\u0447\u0430\u0441\u0442\u044c\u0435
    \u0416\u0438\u0437\u043d\u044c \u0420\u0438\u043c\u0430\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0433\u043e\u0440\u0435\u043c. \u041e\u043d
    \u0440\u0430\u043d\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u043c\u0430\u0442\u044c,
    \u0430 \u0437\u0430\u0442\u0435\u043c, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    29 \u043b\u0435\u0442, \u043e\u0442\u0446\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0431\u043e\u0433\u043e\u0442\u0432\u043e\u0440\u0438\u043b. \u0417\u0430 \u0434\u0435\u0441\u044f\u0442\u044c
    \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430
    \u043e\u0434\u0438\u043d \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043c \u0443\u043c\u0435\u0440\u043b\u0438
    \u0447\u0435\u0442\u0432\u0435\u0440\u043e \u0438\u0437 \u043f\u044f\u0442\u0438 \u0435\u0433\u043e
    \u0431\u0440\u0430\u0442\u044c\u0435\u0432 \u0438 \u0441\u0435\u0441\u0442\u0435\u0440.
    \u042d\u0442\u0438 \u0443\u0434\u0430\u0440\u044b \u0441\u0443\u0434\u044c\u0431\u044b \u043f\u043e\u0432\u0435\u0440\u0433\u0430\u043b\u0438
    \u0435\u0433\u043e \u0432 \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044e
    (\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438
    \u043e\u0431 \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0438), \u0441\u043f\u0430\u0441\u0430\u044f\u0441\u044c
    \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u0441 \u0433\u043e\u043b\u043e\u0432\u043e\u0439
    \u0443\u0445\u043e\u0434\u0438\u043b \u0432 \u0440\u0430\u0431\u043e\u0442\u0443. \u0422\u0435\u043c
    \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0432 1862 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u042d\u043b\u044c\u0437\u0435 \u041a\u043e\u0445,
    \u043f\u043e\u0434\u0440\u0443\u0433\u0435 \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u044b.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0441\u0447\u0430\u0441\u0442\u044c\u0435 \u043f\u0440\u043e\u0434\u043b\u0438\u043b\u043e\u0441\u044c
    \u043d\u0435\u0434\u043e\u043b\u0433\u043e \u2014 \u0432\u0441\u0435\u0433\u043e \u0442\u0440\u0438
    \u0433\u043e\u0434\u0430 \u0434\u043e \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    \u2014 \u044d\u0442\u043e\u0442 \u0431\u0440\u0430\u043a \u0441\u0442\u0430\u043b \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0443\u0442\u0435\u0448\u0435\u043d\u0438\u0435\u043c.
    \u0414\u0440\u0443\u0433 \u0420\u0438\u043c\u0430\u043d\u0430, \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434,
    \u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u043e\u043d\u0430 \u0431\u044b\u043b\u0430
    \"\u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c
    \u0441 \u043d\u0438\u043c \u0433\u0440\u044f\u0434\u0443\u0449\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0431\u043e\u043b\u0438 \u0438 \u0443\u043a\u0440\u0430\u0441\u0438\u0442\u044c \u0438\u0445
    \u0441\u0432\u043e\u0435\u0439 \u043d\u0435\u0443\u0442\u043e\u043c\u0438\u043c\u043e\u0439
    \u043b\u044e\u0431\u043e\u0432\u044c\u044e\".\n\n\U0001F9EC \"\u0415\u0441\u043b\u0438 \u0431\u044b
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u043e\u043c!\"
    \u0423 \u0420\u0438\u043c\u0430\u043d\u0430 \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u044c,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u0418\u0434\u043e\u0439,
    \u0432 \u0447\u0435\u0441\u0442\u044c \u0435\u0433\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0432\u044b\u0436\u0438\u0432\u0448\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u044b. \u0414\u0435\u0432\u043e\u0447\u043a\u0430
    \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0442\u0430\u043b\u0430\u043d\u0442 \u043e\u0442\u0446\u0430. \u0412 \u043f\u0438\u0441\u044c\u043c\u0435
    \u043a \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0443 \u0435\u0433\u043e \u0432\u0434\u043e\u0432\u0430
    \u042d\u043b\u044c\u0437\u0430 \u0441 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u044c\u044e
    \u043f\u0438\u0441\u0430\u043b\u0430, \u0447\u0442\u043e 11-\u043b\u0435\u0442\u043d\u044f\u044f
    \u0418\u0434\u0430 \u043e\u0431\u043e\u0436\u0430\u0435\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u0447\u0430\u0441\u0442\u043e, \u0438\u0437 \u0447\u0438\u0441\u0442\u043e\u0433\u043e
    \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f, \u0440\u0435\u0448\u0430\u0435\u0442
    \u043d\u0430 30 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432 \u0431\u043e\u043b\u044c\u0448\u0435,
    \u0447\u0435\u043c \u0437\u0430\u0434\u0430\u044e\u0442 \u043d\u0430 \u0434\u043e\u043c.
    \u041e\u043d\u0430 \u043e\u043f\u0435\u0440\u0435\u0436\u0430\u043b\u0430 \u0432 \u0443\u0447\u0435\u0431\u0435
    \u0434\u0435\u0432\u043e\u0447\u0435\u043a \u0438\u0437 \u0441\u0442\u0430\u0440\u0448\u0438\u0445
    \u043a\u043b\u0430\u0441\u0441\u043e\u0432. \u0417\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u043b\u043e\u0441\u044c
    \u043f\u0438\u0441\u044c\u043c\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e\u0439
    \u0434\u043b\u044f \u0442\u043e\u0439 \u044d\u043f\u043e\u0445\u0438 \u0444\u0440\u0430\u0437\u043e\u0439:
    \u00ab\u0415\u0441\u043b\u0438 \u0431\u044b \u043e\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0431\u044b\u043b\u0430 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u043e\u043c!\u00bb.
    \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u043a\u0430\u043a \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c, \u0432 \u0442\u043e
    \u0432\u0440\u0435\u043c\u044f \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0435
    \u0434\u0435\u0432\u0443\u0448\u043a\u0438 \u0440\u0435\u0434\u043a\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u0438
    \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b.\n\n\U0001F48E
    \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u043c\u0438\u043d\u0443\u0442\u044b
    \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u043e\u0439 \u0423\u043c\u0438\u0440\u0430\u044f
    \u043e\u0442 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430 \u0432 \u0418\u0442\u0430\u043b\u0438\u0438,
    \u0420\u0438\u043c\u0430\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u043b \u044f\u0441\u043d\u043e\u0441\u0442\u044c
    \u0443\u043c\u0430 \u0434\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e
    \u0434\u043d\u044f. \u0414\u0440\u0443\u0433\u043e\u0439 \u0435\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u0433\u0430,
    \u0412\u0435\u0431\u0435\u0440, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b, \u0447\u0442\u043e
    \u0437\u0430 \u0434\u0435\u043d\u044c \u0434\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    19 \u0438\u044e\u043b\u044f 1866 \u0433\u043e\u0434\u0430, \u0420\u0438\u043c\u0430\u043d
    \u043b\u0435\u0436\u0430\u043b \u043f\u043e\u0434 \u0444\u0438\u0433\u043e\u0432\u044b\u043c
    \u0434\u0435\u0440\u0435\u0432\u043e\u043c, \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u044f\u0441\u044c
    \u0432\u0438\u0434\u043e\u043c \u043d\u0430 \u043e\u0437\u0435\u0440\u043e \u041b\u0430\u0433\u043e-\u041c\u0430\u0434\u0436\u043e\u0440\u0435,
    \u0438... \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u0441\u0432\u043e\u0435\u0439
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u043d\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e\u0439
    \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044c\u044e \u043f\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435
    \u0443\u0445\u0430."
