  fullNameRu: "\u041F\u0438\u0444\u0430\u0433\u043E\u0301\u0440 \u0421\u0430\u0301\u043C\u043E\u0441\u0441\u043A\u0438\u0439"
  fullNameEn: Pythagoras of Samos
