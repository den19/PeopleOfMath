  achievementsRu: "\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u0442\u0440\u0443\u0434\u044b
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430. \u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f
    \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e
    \u043e\u043d, \u043a\u0430\u043a \u0438 \u0421\u043e\u043a\u0440\u0430\u0442, \u043d\u0435
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0431\u044f
    \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0445 \u0442\u0440\u0443\u0434\u043e\u0432.
    \u0412\u0441\u0435, \u0447\u0442\u043e \u043c\u044b \u0437\u043d\u0430\u0435\u043c, \u0434\u043e\u0448\u043b\u043e
    \u0434\u043e \u043d\u0430\u0441 \u0432 \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u0430\u0445
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432 (\u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u0435\u0432)
    \u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0447\u0430\u0441\u0442\u043e \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438
    \u0443\u0447\u0438\u0442\u0435\u043b\u044e \u0432\u0441\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u0441\u0432\u043e\u0435\u0439 \u0448\u043a\u043e\u043b\u044b. \u041f\u043e\u044d\u0442\u043e\u043c\u0443
    \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0445
    \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u044b
    \u0432 \u0446\u0435\u043b\u043e\u043c, \u043d\u043e\u0441\u044f\u0449\u0435\u0439 \u0435\u0433\u043e
    \u0438\u043c\u044f.\n\n\U0001F4D0 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430:
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0412 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0437\u0430\u0441\u043b\u0443\u0433\u0438
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u0438 \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b. \u0418\u043c
    \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438\u0437 \u043d\u0430\u0431\u043e\u0440\u0430
    \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0430\u0432\u0438\u043b
    \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u043d\u0430\u0443\u043a\u0443.
    \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432:
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u043f\u0435\u0440\u0432\u044b\u043c \u043d\u0430\u0447\u0430\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0432\u043e\u0434\u0438\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e, \u043f\u0440\u0438\u0434\u0430\u0432\u0430\u044f
    \u0435\u0439 \u0441\u0442\u0440\u043e\u0433\u0438\u0439 \u0438 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440. \u0414\u043e \u043d\u0435\u0433\u043e
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0430\u043a\u0442\u044b
    \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u043e\u043d\u0441\u0442\u0430\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c,
    \u0430 \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0445 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u0442\u044c. \u0422\u0435\u043e\u0440\u0435\u043c\u0430
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430: \u042d\u0442\u043e, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e,
    \u0441\u0430\u043c\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435. \u0425\u043e\u0442\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438
    \u043c\u0435\u0436\u0434\u0443 \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438 \u043f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0433\u043e
    \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a\u0430 \u0431\u044b\u043b\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u0432 \u0415\u0433\u0438\u043f\u0442\u0435
    \u0438 \u0412\u0430\u0432\u0438\u043b\u043e\u043d\u0435, \u0438\u043c\u0435\u043d\u043d\u043e
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0443, \u043f\u043e \u043f\u0440\u0435\u0434\u0430\u043d\u0438\u044e,
    \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0435\u0451 \u043f\u0435\u0440\u0432\u043e\u0435
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e.
    \u0424\u043e\u0440\u043c\u0443\u043b\u0430 `a\u00b2 + b\u00b2 = c\u00b2` \u0441\u0442\u0430\u043b\u0430
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0422\u0435\u043e\u0440\u0438\u044f
    \u0447\u0438\u0441\u0435\u043b: \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u044b
    \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0441\u043d\u043e\u0432\u044b \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0438. \u041e\u043d\u0438: \u0420\u0430\u0437\u0434\u0435\u043b\u0438\u043b\u0438
    \u0447\u0438\u0441\u043b\u0430 \u043d\u0430 \u0447\u0435\u0442\u043d\u044b\u0435 \u0438
    \u043d\u0435\u0447\u0435\u0442\u043d\u044b\u0435, \u043f\u0440\u043e\u0441\u0442\u044b\u0435
    \u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043d\u044b\u0435. \u0418\u0437\u0443\u0447\u0430\u043b\u0438
    \u00ab\u0444\u0438\u0433\u0443\u0440\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430\u00bb
    (\u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0435, \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0435,
    \u043f\u044f\u0442\u0438\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0435), \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438 \u0432 \u0432\u0438\u0434\u0435
    \u0442\u043e\u0447\u0435\u043a, \u0432\u044b\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044f
    \u0438\u0445 \u043d\u0430 \u043f\u0435\u0441\u043a\u0435. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0447\u0438\u0441\u043b\u043e 10 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0430\u043b\u043e\u0441\u044c
    \u043a\u0430\u043a \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u044b\u0439 \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a
    \u2014 \u0442\u0435\u0442\u0440\u0430\u043a\u0442\u0438\u0441. \u041e\u0442\u043a\u0440\u044b\u043b\u0438
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u221a2),
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0448\u043e\u043a\u043e\u043c \u0434\u043b\u044f
    \u0438\u0445 \u043a\u0430\u0440\u0442\u0438\u043d\u044b \u043c\u0438\u0440\u0430, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u043d\u0430 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438 \u0446\u0435\u043b\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b. \u041f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u0438:
    \u0418\u043c \u0431\u044b\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u0442\u0440\u0438
    \u0432\u0438\u0434\u0430 \u0441\u0440\u0435\u0434\u043d\u0438\u0445: \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438
    \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f.\n\n\U0001F30C
    \u041a\u043e\u0441\u043c\u043e\u043b\u043e\u0433\u0438\u044f \u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f:
    \u0413\u0430\u0440\u043c\u043e\u043d\u0438\u044f \u0441\u0444\u0435\u0440 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u044b
    \u043e\u0434\u043d\u0438\u043c\u0438 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c
    \u043e\u043f\u0438\u0441\u0430\u0442\u044c \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u0443\u044e
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u043a\u043e\u043d\u043e\u0432. \u0417\u0435\u043c\u043b\u044f \u2014 \u0448\u0430\u0440:
    \u041e\u043d\u0438 \u043f\u0435\u0440\u0432\u044b\u043c\u0438 \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b\u0438
    \u0438\u0434\u0435\u044e \u043e \u0448\u0430\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0441\u0442\u0438
    \u0417\u0435\u043c\u043b\u0438, \u043e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u044f\u0441\u044c
    \u043d\u0435 \u043d\u0430 \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0434\u0430\u043d\u043d\u044b\u0445, \u0430 \u043d\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0438
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0441\u0444\u0435\u0440\u0430 \u2014 \u0441\u0430\u043c\u0430\u044f
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u0430\u044f \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u043e\u0440\u043c\u0430. \u00ab\u041a\u043e\u0441\u043c\u043e\u0441\u00bb: \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0443
    \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0441\u0430\u043c\u043e\u0433\u043e \u0442\u0435\u0440\u043c\u0438\u043d\u0430 \u00ab\u043a\u043e\u0441\u043c\u043e\u0441\u00bb
    \u0434\u043b\u044f \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0443\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0435\u043d\u043d\u043e\u0433\u043e
    \u0438 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430,
    \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0445\u0430\u043e\u0441\u0430.
    \u00ab\u041c\u0443\u0437\u044b\u043a\u0430 \u0441\u0444\u0435\u0440\u00bb: \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0430\u044f
    \u0438\u0434\u0435\u044f, \u0447\u0442\u043e \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u043f\u043b\u0430\u043d\u0435\u0442 \u043f\u043e\u0440\u043e\u0436\u0434\u0430\u0435\u0442
    \u0437\u0432\u0443\u043a, \u0447\u0430\u0441\u0442\u043e\u0442\u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0440\u0430\u0437\u0438\u0442\u044c \u0447\u0438\u0441\u043b\u0430\u043c\u0438.
    \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0431\u044b\u043b\u043e
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u0441\u0432\u044f\u0437\u044c\u044e
    \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438
    \u0438 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u0439.\n\n\U0001F3B5
    \u041c\u0443\u0437\u044b\u043a\u0430 \u0438 \u0430\u043a\u0443\u0441\u0442\u0438\u043a\u0430:
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0437\u0432\u0443\u043a\u0430
    \u041e\u0434\u043d\u043e \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430
    \u043b\u0435\u0436\u0438\u0442 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0443\u0437\u044b\u043a\u0438.
    \u0427\u0438\u0441\u043b\u043e\u0432\u0430\u044f \u043f\u0440\u0438\u0440\u043e\u0434\u0430
    \u0437\u0432\u0443\u043a\u0430: \u041e\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b,
    \u0447\u0442\u043e \u0432\u044b\u0441\u043e\u0442\u0430 \u0442\u043e\u043d\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043e\u0442 \u0434\u043b\u0438\u043d\u044b \u0441\u0442\u0440\u0443\u043d\u044b. \u041f\u0440\u0438\u044f\u0442\u043d\u044b\u0435
    \u0441\u043b\u0443\u0445\u0443 \u0441\u043e\u0437\u0432\u0443\u0447\u0438\u044f (\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b)
    \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u0434\u043b\u0438\u043d\u044b
    \u0441\u0442\u0440\u0443\u043d \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a\u0430\u043a
    \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0446\u0435\u043b\u044b\u0435 \u0447\u0438\u0441\u043b\u0430.
    \u041e\u043a\u0442\u0430\u0432\u0430 \u2014 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    2:1. \u041a\u0432\u0438\u043d\u0442\u0430 \u2014 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    3:2. \u041a\u0432\u0430\u0440\u0442\u0430 \u2014 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435
    4:3. \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u043c\u043e\u0449\u043d\u0435\u0439\u0448\u0438\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0442\u0435\u0437\u0438\u0441\u0430:
    \u00ab\u0412\u0441\u0451 \u0435\u0441\u0442\u044c \u0447\u0438\u0441\u043b\u043e\u00bb.
    \u0422\u0430\u043a \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u043a\u0430.\n\n\U0001F9D8 \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u0438 \u044d\u0442\u0438\u043a\u0430: \u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u0436\u0438\u0442\u044c \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0441\u043a\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u043d\u0430\u0443\u0447\u043d\u044b\u043c, \u043d\u043e \u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e-\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c. \u0422\u0435\u0440\u043c\u0438\u043d
    \u00ab\u0424\u0438\u043b\u043e\u0441\u043e\u0444\u00bb: \u0418\u043c\u0435\u043d\u043d\u043e
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0438\u043b
    \u044d\u0442\u043e \u0441\u043b\u043e\u0432\u043e, \u043d\u0430\u0437\u0432\u0430\u0432
    \u0441\u0435\u0431\u044f \u043d\u0435 \u00ab\u043c\u0443\u0434\u0440\u0435\u0446\u043e\u043c\u00bb
    (\u0442\u0435\u043c, \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442), \u0430 \u00ab\u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0435\u043c
    \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u0438\u00bb (\u0442\u0435\u043c, \u043a\u0442\u043e
    \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0441\u044f \u043a \u0437\u043d\u0430\u043d\u0438\u044e).
    \u041c\u0435\u0442\u0435\u043c\u043f\u0441\u0438\u0445\u043e\u0437: \u0423\u0447\u0435\u043d\u0438\u0435
    \u043e \u043f\u0435\u0440\u0435\u0441\u0435\u043b\u0435\u043d\u0438\u0438 \u0434\u0443\u0448,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u043b\u043e \u0438\u0445 \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0441\u0442\u0432\u043e. \u0426\u0435\u043b\u0435\u0431\u043d\u0430\u044f
    \u0441\u0438\u043b\u0430 \u043c\u0443\u0437\u044b\u043a\u0438: \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u044b
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438 \u043c\u0443\u0437\u044b\u043a\u0443
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e,
    \u043d\u043e \u0438 \u0434\u043b\u044f \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u044d\u0444\u0444\u0435\u043a\u0442\u0430, \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u044f
    \u0445\u043e\u0440\u043e\u0432\u043e\u0435 \u043f\u0435\u043d\u0438\u0435 \u0434\u043b\u044f
    \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0434\u0443\u0448\u0435\u0432\u043d\u044b\u0445
    \u043d\u0435\u0434\u0443\u0433\u043e\u0432. \u0421\u043b\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c,
    \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u0431\u044b\u043b\u043e \u043b\u0438\u0447\u043d\u044b\u043c
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435\u043c \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430,
    \u0430 \u0447\u0442\u043e \u2014 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432.
    \u041d\u043e \u044f\u0441\u043d\u043e \u043e\u0434\u043d\u043e: \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u0448\u043a\u043e\u043b\u0443, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0430\u0443\u043a\u0430,
    \u043c\u0438\u0441\u0442\u0438\u043a\u0430 \u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u0438 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u044b \u0435\u0434\u0438\u043d\u043e\u0439
    \u0432\u0435\u0440\u043e\u0439 \u0432 \u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u043e
    \u0447\u0438\u0441\u043b\u0430 \u0438 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438."
  achievementsEn: 
  personalLifeRu: "\u041a\u043e\u043d\u0435\u0447\u043d\u043e, \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043c
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430
    \u0432 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0440\u044f\u0434\u043a\u0435, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u044d\u0442\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0434\u043b\u044f \u0444\u0438\u0433\u0443\u0440\u044b,
    \u043e\u043a\u0443\u0442\u0430\u043d\u043d\u043e\u0439 \u043c\u0438\u0444\u0430\u043c\u0438.
    \u0412\u0441\u0435, \u0447\u0442\u043e \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u043e
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438,
    \u0443\u0447\u0451\u0431\u0435 \u0438 \u0441\u043c\u0435\u0440\u0442\u0438, \u0434\u043e\u0448\u043b\u043e
    \u0434\u043e \u043d\u0430\u0441 \u0432 \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u0430\u0445
    \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0447\u0430\u0441\u0442\u043e \u043e\u0431\u043e\u0436\u0435\u0441\u0442\u0432\u043b\u044f\u043b\u0438
    \u0441\u0432\u043e\u0435\u0433\u043e \u0443\u0447\u0438\u0442\u0435\u043b\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0430\u043a\u0442\u044b
    \u0437\u0434\u0435\u0441\u044c \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u044b
    \u0441 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u043c\u0438.\n\n\U0001F476 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435,
    \u0441\u0435\u043c\u044c\u044f \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u0414\u0430\u0442\u0430 \u0438 \u043c\u0435\u0441\u0442\u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f:
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043e\u043a\u043e\u043b\u043e
    570 \u0433\u043e\u0434\u0430 \u0434\u043e \u043d. \u044d. \u043d\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c
    \u043e\u0441\u0442\u0440\u043e\u0432\u0435 \u0421\u0430\u043c\u043e\u0441 \u0432 \u042d\u0433\u0435\u0439\u0441\u043a\u043e\u043c
    \u043c\u043e\u0440\u0435. \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438: \u0415\u0433\u043e
    \u043e\u0442\u0446\u043e\u043c \u0431\u044b\u043b \u041c\u043d\u0435\u0441\u0430\u0440\u0445.
    \u0421\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u043d\u0435\u043c \u0440\u0430\u0437\u043d\u044f\u0442\u0441\u044f:
    \u043e\u0434\u043d\u0438 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u0437\u0430\u0436\u0438\u0442\u043e\u0447\u043d\u044b\u043c \u043a\u0443\u043f\u0446\u043e\u043c
    \u0438\u043b\u0438 \u043a\u0430\u043c\u043d\u0435\u0440\u0435\u0437\u043e\u043c (\u044e\u0432\u0435\u043b\u0438\u0440\u043e\u043c),
    \u0434\u0440\u0443\u0433\u0438\u0435 \u2014 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043e\u0431\u043b\u0430\u0434\u0430\u0432\u0448\u0438\u043c \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c
    \u0438 \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u043e\u043c, \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u043c
    \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u0430.
    \u0418\u043c\u044f \u043c\u0430\u0442\u0435\u0440\u0438 \u2014 \u041f\u0430\u0440\u0442\u0435\u043d\u0438\u044f
    (\u0438\u043b\u0438 \u041f\u0430\u0440\u0442\u0435\u043d\u0438\u0434\u0430), \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f\u0445 \u043e\u043d\u0430 \u0442\u0430\u043a\u0436\u0435
    \u0444\u0438\u0433\u0443\u0440\u0438\u0440\u0443\u0435\u0442 \u043a\u0430\u043a \u041f\u0438\u0444\u0438\u0430\u0434\u0430.
    \u041f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e \u0438 \u0438\u043c\u044f:
    \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f\u043c \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u043e
    \u0434\u0435\u043b\u044c\u0444\u0438\u0439\u0441\u043a\u043e\u0439 \u041f\u0438\u0444\u0438\u0435\u0439
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u044b\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043d\u0435\u0442 \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u043c\u0443\u0434\u0440\u0435\u0446\u043e\u043c.
    \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430
    \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u043e\u043c,
    \u0447\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u0442\u043e\u0442,
    \u043e \u043a\u043e\u043c \u043e\u0431\u044a\u044f\u0432\u0438\u043b\u0430 \u041f\u0438\u0444\u0438\u044f\u00bb.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0438 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0432\u0435\u0440\u0441\u0438\u044f \u043e \u0435\u0433\u043e \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u043e\u0442
    \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u0430. \u0411\u0440\u0430\u0442\u044c\u044f:
    \u0412 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u0434\u0432\u0430 \u0435\u0433\u043e
    \u0441\u0442\u0430\u0440\u0448\u0438\u0445 \u0431\u0440\u0430\u0442\u0430 \u2014 \u042d\u0432\u043d\u043e\u0441\u0442
    \u0438 \u0422\u0438\u0440\u0440\u0435\u043d.\n\n\U0001F9E0 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u0438 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u042e\u043d\u044b\u0439
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u0440\u0430\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043a \u043d\u0430\u0443\u043a\u0430\u043c. \u041f\u0435\u0440\u0432\u044b\u0435 \u0443\u0447\u0438\u0442\u0435\u043b\u044f:
    \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c
    \u0431\u044b\u043b \u0413\u0435\u0440\u043c\u043e\u0434\u0430\u043c\u0430\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u0431\u0443\u0447\u0438\u043b \u0435\u0433\u043e \u043e\u0441\u043d\u043e\u0432\u0430\u043c
    \u043c\u0443\u0437\u044b\u043a\u0438, \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u0438,
    \u0433\u0440\u0430\u043c\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u043b
    \u0437\u0430\u0443\u0447\u0438\u0432\u0430\u0442\u044c \u043d\u0430\u0438\u0437\u0443\u0441\u0442\u044c
    \u043f\u043e\u044d\u043c\u044b \u0413\u043e\u043c\u0435\u0440\u0430 \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f
    \u043f\u0430\u043c\u044f\u0442\u0438. \u041e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0443
    \u0424\u0435\u0440\u0435\u043a\u0438\u0434\u0430: \u041e\u043a\u043e\u043b\u043e 18 \u043b\u0435\u0442
    \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432
    \u041b\u0435\u0441\u0431\u043e\u0441, \u0433\u0434\u0435 \u0438\u0437\u0443\u0447\u0430\u043b
    \u0444\u0438\u0437\u0438\u043a\u0443, \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443,
    \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u044e \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u0443 \u0424\u0435\u0440\u0435\u043a\u0438\u0434\u0430 \u0421\u0438\u0440\u043e\u0441\u0441\u043a\u043e\u0433\u043e,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u0432. \u041c\u0438\u043b\u0435\u0442\u0441\u043a\u0430\u044f
    \u0448\u043a\u043e\u043b\u0430: \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u041c\u0438\u043b\u0435\u0442, \u0433\u0434\u0435 \u0441\u043b\u0443\u0448\u0430\u043b
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0424\u0430\u043b\u0435\u0441\u0430 \u0438 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0430
    \u0410\u043d\u0430\u043a\u0441\u0438\u043c\u0430\u043d\u0434\u0440\u0430, \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u043f\u0435\u0440\u0432\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0439
    \u0448\u043a\u043e\u043b\u044b \u0432 \u0413\u0440\u0435\u0446\u0438\u0438. \u041e\u0442
    \u043d\u0438\u0445 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0437\u043d\u0430\u043d\u0438\u044f
    \u043f\u043e \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u0441\u043d\u043e\u0432\u044b \u0438\u043e\u043d\u0438\u0439\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438. \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u0432 \u0415\u0433\u0438\u043f\u0435\u0442: \u041f\u043e \u0441\u043e\u0432\u0435\u0442\u0443
    \u0424\u0430\u043b\u0435\u0441\u0430, \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f
    \u0432 \u0415\u0433\u0438\u043f\u0435\u0442, \u0447\u0442\u043e\u0431\u044b \u0443\u0447\u0438\u0442\u044c\u0441\u044f
    \u0443 \u0436\u0440\u0435\u0446\u043e\u0432. \u041f\u043e \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439, \u043e\u043d \u043f\u0440\u043e\u0432\u0435\u043b
    \u0442\u0430\u043c 22 \u0433\u043e\u0434\u0430, \u0438\u0437\u0443\u0447\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443 \u0438 \u0431\u044b\u043b \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d
    \u0432 \u0445\u0440\u0430\u043c\u043e\u0432\u044b\u0435 \u0442\u0430\u0438\u043d\u0441\u0442\u0432\u0430.
    \u0412\u0430\u0432\u0438\u043b\u043e\u043d\u0441\u043a\u0438\u0439 \u043f\u043b\u0435\u043d:
    \u0412 525 \u0433\u043e\u0434\u0443 \u0434\u043e \u043d. \u044d. \u0415\u0433\u0438\u043f\u0435\u0442
    \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043b \u043f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u0438\u0439
    \u0446\u0430\u0440\u044c \u041a\u0430\u043c\u0431\u0438\u0437, \u0438 \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u0431\u044b\u043b \u0443\u0432\u0435\u0434\u0435\u043d \u0432 \u0412\u0430\u0432\u0438\u043b\u043e\u043d
    \u043a\u0430\u043a \u043f\u043b\u0435\u043d\u043d\u0438\u043a. \u0422\u0430\u043c \u043e\u043d
    \u043f\u0440\u043e\u0432\u0435\u043b 12 \u043b\u0435\u0442, \u043e\u0431\u0449\u0430\u044f\u0441\u044c
    \u0441 \u043c\u0430\u0433\u0430\u043c\u0438 \u0438 \u0445\u0430\u043b\u0434\u0435\u0439\u0441\u043a\u0438\u043c\u0438
    \u0436\u0440\u0435\u0446\u0430\u043c\u0438, \u0438 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0432\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0435\u0439
    \u0438 \u043c\u0438\u0441\u0442\u0438\u043a\u043e\u0439, \u0447\u0442\u043e \u043f\u043e\u0437\u0436\u0435
    \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u043e \u043d\u0430 \u0435\u0433\u043e \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e.
    \u041f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u0435\u0433\u043e \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u043b
    \u0446\u0430\u0440\u044c \u0414\u0430\u0440\u0438\u0439 \u0413\u0438\u0441\u0442\u0430\u0441\u043f.\n\n\U0001F3DB\ufe0f
    \u0420\u0430\u0431\u043e\u0442\u0430 \u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0448\u043a\u043e\u043b\u044b \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435
    \u0438 \u043f\u0435\u0440\u0435\u0435\u0437\u0434: \u041e\u043a\u043e\u043b\u043e 532 \u0433\u043e\u0434\u0430
    \u0434\u043e \u043d. \u044d., \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u043a\u043e\u043b\u043e
    60 \u043b\u0435\u0442, \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u043f\u043e\u043a\u0438\u043d\u0443\u043b
    \u0421\u0430\u043c\u043e\u0441 (\u0438\u0437-\u0437\u0430 \u043d\u0435\u0436\u0435\u043b\u0430\u043d\u0438\u044f
    \u043c\u0438\u0440\u0438\u0442\u044c\u0441\u044f \u0441 \u0442\u0438\u0440\u0430\u043d\u0438\u0435\u0439
    \u041f\u043e\u043b\u0438\u043a\u0440\u0430\u0442\u0430) \u0438 \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b
    \u0432 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0443\u044e \u043a\u043e\u043b\u043e\u043d\u0438\u044e
    \u041a\u0440\u043e\u0442\u043e\u043d \u0432 \u042e\u0436\u043d\u043e\u0439 \u0418\u0442\u0430\u043b\u0438\u0438.
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0441\u043a\u0438\u0439 \u0441\u043e\u044e\u0437:
    \u0412 \u041a\u0440\u043e\u0442\u043e\u043d\u0435 \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u044e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e \u0448\u043a\u043e\u043b\u0443.
    \u042d\u0442\u043e \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0443\u0447\u0435\u0431\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440, \u0430 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e-\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435
    \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u043e, \u0442\u0430\u0439\u043d\u044b\u0439 \u043e\u0440\u0434\u0435\u043d
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043b\u0443\u0431.
    \u0415\u0433\u043e \u043f\u0440\u043e\u043f\u043e\u0432\u0435\u0434\u0438 \u043e \u043d\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0438
    \u0438\u043c\u0435\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0443\u0441\u043f\u0435\u0445,
    \u0438 \u043e\u043d \u043e\u0431\u0440\u0435\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u043a\u0430\u043a
    \u0441\u0440\u0435\u0434\u0438 \u043c\u0443\u0436\u0447\u0438\u043d, \u0442\u0430\u043a
    \u0438 \u0441\u0440\u0435\u0434\u0438 \u0436\u0435\u043d\u0449\u0438\u043d.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c: \u0436\u0435\u043d\u0430
    \u0438 \u0434\u0435\u0442\u0438 \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442
    \u043c\u043d\u043e\u0433\u0438\u0445 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0436\u0438\u0437\u043d\u044c
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u0431\u044b\u043b\u0430 \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439,
    \u0438 \u044d\u0442\u043e \u043d\u0430\u0448\u043b\u043e \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445.
    \u0421\u0443\u043f\u0440\u0443\u0433\u0430: \u0415\u0433\u043e \u0436\u0435\u043d\u043e\u0439
    \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0430\u044f
    \u0434\u0435\u0432\u0443\u0448\u043a\u0430 \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0424\u0435\u0430\u043d\u0430
    (\u0422\u0435\u0430\u043d\u043e). \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u0446, \u043a\u043e\u0442\u043e\u0440\u0430\u044f,
    \u0432\u043e\u043f\u0440\u0435\u043a\u0438 \u0437\u0430\u043a\u043e\u043d\u0430\u043c, \u043f\u0440\u0438\u0448\u043b\u0430
    \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u0442\u044c \u0435\u0433\u043e \u0440\u0435\u0447\u0438.
    \u0414\u0435\u0442\u0438: \u0412 \u0431\u0440\u0430\u043a\u0435 \u0443 \u043d\u0438\u0445
    \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0434\u0435\u0442\u0438. \u0418\u043c\u0435\u043d\u0430
    \u0434\u0435\u0442\u0435\u0439 \u0432 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445
    \u0440\u0430\u0437\u043d\u044f\u0442\u0441\u044f: \u0443 \u0414\u0438\u043e\u0433\u0435\u043d\u0430
    \u041b\u0430\u044d\u0440\u0442\u0441\u043a\u043e\u0433\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442\u0441\u044f
    \u0441\u044b\u043d \u0422\u0435\u043b\u0430\u0432\u0433 \u0438 \u0434\u043e\u0447\u044c
    \u0410\u0440\u0438\u0433\u043d\u043e\u0442\u0430, \u0432 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u0445 \u2014 \u0441\u044b\u043d \u0410\u0440\u0438\u043c\u043d\u0435\u0441\u0442
    \u0438 \u0434\u043e\u0447\u044c \u041c\u043d\u044f. \u0421\u044b\u043d \u0422\u0435\u043b\u0430\u0432\u0433
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0441\u0442\u0430\u043b
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u0414\u0435\u043c\u043e\u043a\u0440\u0438\u0442\u0430.\n\n\U0001F940
    \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043a\u043e\u043d\u0447\u0438\u043d\u044b \u0416\u0438\u0437\u043d\u044c \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430
    \u0438 \u0435\u0433\u043e \u0441\u043e\u044e\u0437\u0430 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u043e\u0431\u043e\u0440\u0432\u0430\u043b\u0430\u0441\u044c \u0438\u0437-\u0437\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0431\u043e\u0440\u044c\u0431\u044b \u0432 \u041a\u0440\u043e\u0442\u043e\u043d\u0435.
    \u041f\u0440\u0438\u0447\u0438\u043d\u0430: \u0412 \u043a\u043e\u043d\u0446\u0435 VI \u0432\u0435\u043a\u0430
    \u0434\u043e \u043d. \u044d. \u0432 \u041a\u0440\u043e\u0442\u043e\u043d\u0435 \u0432\u0441\u043f\u044b\u0445\u043d\u0443\u043b
    \u043c\u044f\u0442\u0435\u0436 \u043f\u0440\u043e\u0442\u0438\u0432 \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u0435\u0432
    (\u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0430\u044f \u00ab\u041a\u0438\u043b\u043e\u043d\u043e\u0432\u0430
    \u0441\u043c\u0443\u0442\u0430\u00bb), \u0438 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0443
    \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u0431\u0435\u0436\u0430\u0442\u044c \u0432
    \u0441\u043e\u0441\u0435\u0434\u043d\u0438\u0439 \u0433\u043e\u0440\u043e\u0434 \u041c\u0435\u0442\u0430\u043f\u043e\u043d\u0442.
    \u041e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u043c\u0435\u0440\u0442\u0438:
    \u0422\u043e\u0447\u043d\u044b\u0435 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0435\u0433\u043e \u043a\u043e\u043d\u0447\u0438\u043d\u044b \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b,
    \u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0432\u0435\u0440\u0441\u0438\u0439: 1. \u041c\u0438\u0440\u043d\u0430\u044f \u043a\u043e\u043d\u0447\u0438\u043d\u0430:
    \u041f\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439,
    \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u041c\u0435\u0442\u0430\u043f\u043e\u043d\u0442\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 80 \u043b\u0435\u0442 (\u0438\u043b\u0438
    90 \u043b\u0435\u0442, \u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c \u0434\u0430\u043d\u043d\u044b\u043c).
    2. \u0413\u0438\u0431\u0435\u043b\u044c \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0436\u0430\u0440\u0430
    \u0438\u043b\u0438 \u043d\u0430\u043f\u0430\u0434\u0435\u043d\u0438\u044f: \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u044d\u0442\u0438\u0447\u043d\u043e\u0439
    \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u043d\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0438, \u043f\u044b\u0442\u0430\u044f\u0441\u044c
    \u0441\u043f\u0430\u0441\u0442\u0438 \u0435\u0433\u043e \u0438\u0437 \u0433\u043e\u0440\u044f\u0449\u0435\u0433\u043e
    \u0434\u043e\u043c\u0430, \u0441\u043b\u043e\u0436\u0438\u043b\u0438 \u043c\u043e\u0441\u0442
    \u0438\u0437 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0442\u0435\u043b.
    \u041e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0435,
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u043f\u043e\u0433\u0438\u0431 \u0432 \u043e\u0433\u043d\u0435
    \u0438\u043b\u0438 \u043b\u0438\u0448\u0438\u043b \u0441\u0435\u0431\u044f \u0436\u0438\u0437\u043d\u0438.
    3. \u0412\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0439 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442:
    \u0415\u0449\u0435 \u043e\u0434\u043d\u0430 \u0432\u0435\u0440\u0441\u0438\u044f \u0433\u043e\u0432\u043e\u0440\u0438\u0442
    \u043e \u0435\u0433\u043e \u0433\u0438\u0431\u0435\u043b\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f
    \u0432\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f
    \u0432 \u041c\u0435\u0442\u0430\u043f\u043e\u043d\u0442\u0435. \u0418\u0442\u0430\u043a,
    \u0436\u0438\u0437\u043d\u044c \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u2014 \u044d\u0442\u043e
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u043e\u0442 \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u0430 \u043e \u0435\u0433\u043e
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u0434\u043e \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0438\u0431\u0435\u043b\u0438 \u0432 \u043f\u043e\u043f\u044b\u0442\u043a\u0435 \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e,
    \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u043e\u0435 \u0437\u043d\u0430\u043d\u0438\u0435\u043c
    \u0438 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0435\u0439."
  personalLifeEn: 
  shortBioRu: "\u0416\u0438\u0437\u043d\u044c \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u0421\u0430\u043c\u043e\u0441\u0441\u043a\u043e\u0433\u043e
    \u2014 \u044d\u0442\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0438\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0430\u043a\u0442\u043e\u0432
    \u0438 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0445 \u043b\u0435\u0433\u0435\u043d\u0434,
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u043e\u0447\u0442\u0438 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.
    \u041e\u043d \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u0430 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u043c \u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0442\u043e\u0440\u043e\u043c
    \u0438 \u043c\u0438\u0441\u0442\u0438\u043a\u043e\u043c, \u043e\u0441\u043d\u043e\u0432\u0430\u0432\u0448\u0438\u043c
    \u0442\u0430\u0439\u043d\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043d\u0430 \u0434\u0432\u0430 \u0442\u044b\u0441\u044f\u0447\u0435\u043b\u0435\u0442\u0438\u044f
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0437\u0430\u043f\u0430\u0434\u043d\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u0438 \u043d\u0430\u0443\u043a\u0438. \u0414\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u044b\u0445
    \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432,
    \u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u043c \u0441\u0430\u043c\u0438\u043c,
    \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u043d\u0430\u043c \u043f\u043e \u0442\u0440\u0443\u0434\u0430\u043c \u0431\u043e\u043b\u0435\u0435
    \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432, \u043f\u043e\u043b\u043d\u044b\u0445
    \u043c\u0438\u0444\u043e\u0432.\n\n\U0001F4DC \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0438 \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b (\u043e\u043a. 570
    \u0433. \u0434\u043e \u043d.\u044d.) \u0411\u0443\u0434\u0443\u0449\u0438\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u043e\u043a\u043e\u043b\u043e 570 \u0433\u043e\u0434\u0430
    \u0434\u043e \u043d. \u044d. \u043d\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u043c
    \u043e\u0441\u0442\u0440\u043e\u0432\u0435 \u0421\u0430\u043c\u043e\u0441 \u0432 \u042d\u0433\u0435\u0439\u0441\u043a\u043e\u043c
    \u043c\u043e\u0440\u0435. \u0415\u0433\u043e \u0438\u043c\u044f, \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u043e
    \u0434\u0435\u043b\u044c\u0444\u0438\u0439\u0441\u043a\u043e\u0439 \u041f\u0438\u0444\u0438\u0435\u0439,
    \u0447\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u0442\u043e\u0442,
    \u043e \u043a\u043e\u043c \u043e\u0431\u044a\u044f\u0432\u0438\u043b\u0430 \u041f\u0438\u0444\u0438\u044f\u00bb.
    \u0421\u0435\u043c\u044c\u044f: \u041e\u0442\u0446\u0430 \u0437\u0432\u0430\u043b\u0438
    \u041c\u043d\u0435\u0441\u0430\u0440\u0445. \u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438
    \u0440\u0430\u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438:
    \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438, \u043e\u043d
    \u0431\u044b\u043b \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u043a\u0443\u043f\u0446\u043e\u043c
    \u0438\u0437 \u0422\u0438\u0440\u0430, \u043f\u043e\u043b\u0443\u0447\u0438\u0432\u0448\u0438\u043c
    \u0441\u0430\u043c\u043e\u0441\u0441\u043a\u043e\u0435 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e
    \u0437\u0430 \u043f\u043e\u043c\u043e\u0449\u044c \u0433\u043e\u0440\u043e\u0434\u0443,
    \u043f\u043e \u0434\u0440\u0443\u0433\u043e\u0439 \u2014 \u0440\u0435\u043c\u0435\u0441\u043b\u0435\u043d\u043d\u0438\u043a\u043e\u043c
    (\u043a\u0430\u043c\u043d\u0435\u0440\u0435\u0437\u043e\u043c \u0438\u043b\u0438 \u0440\u0435\u0437\u0447\u0438\u043a\u043e\u043c
    \u0433\u0435\u043c\u043c). \u041c\u0430\u0442\u044c, \u041f\u0430\u0440\u0442\u0435\u043d\u0438\u0434\u0430
    (\u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f \u041f\u0438\u0444\u0430\u0438\u0434\u043e\u0439),
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430 \u0438\u0437 \u0437\u043d\u0430\u0442\u043d\u043e\u0433\u043e
    \u0440\u043e\u0434\u0430.\n\n\U0001F30D \u041f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f
    \u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 (\u043e\u043a. 548\u2013532 \u0433\u0433.
    \u0434\u043e \u043d.\u044d.) \u041d\u0435\u0443\u0433\u043e\u043c\u043e\u043d\u043d\u044b\u0439
    \u0443\u043c \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u0438 \u0436\u0430\u0436\u0434\u0430
    \u0437\u043d\u0430\u043d\u0438\u0439 \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u0435\u0433\u043e
    \u0432 \u0434\u043e\u043b\u0433\u0438\u0435 \u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0438\u044f.
    \u041e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043b\u044e\u0434\u0435\u0439
    \u0441\u0432\u043e\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0432\u043e\u0431\u0440\u0430\u0432\u0448\u0438\u043c
    \u0432 \u0441\u0435\u0431\u044f \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u044c \u0440\u0430\u0437\u043d\u044b\u0445
    \u043a\u0443\u043b\u044c\u0442\u0443\u0440. \u041d\u0430\u0447\u0430\u043b\u043e \u043f\u0443\u0442\u0438:
    \u0415\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c
    \u0431\u044b\u043b \u0413\u0435\u0440\u043c\u043e\u0434\u0430\u043c\u0430\u043d\u0442, \u043e\u0431\u0443\u0447\u0438\u0432\u0448\u0438\u0439
    \u0435\u0433\u043e \u043c\u0443\u0437\u044b\u043a\u0435 \u0438 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u0438.
    \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u0441\u043b\u0443\u0448\u0430\u043b \u043b\u0435\u043a\u0446\u0438\u0438
    \u0424\u0430\u043b\u0435\u0441\u0430 \u0438 \u0410\u043d\u0430\u043a\u0441\u0438\u043c\u0430\u043d\u0434\u0440\u0430
    \u0432 \u041c\u0438\u043b\u0435\u0442\u0435 \u2014 \u043a\u043e\u043b\u044b\u0431\u0435\u043b\u0438
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u0415\u0433\u0438\u043f\u0435\u0442: \u041f\u043e \u0441\u043e\u0432\u0435\u0442\u0443
    \u0424\u0430\u043b\u0435\u0441\u0430 \u0438 \u043f\u0440\u0438 \u0441\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438
    \u0441\u0430\u043c\u043e\u0441\u0441\u043a\u043e\u0433\u043e \u0442\u0438\u0440\u0430\u043d\u0430
    \u041f\u043e\u043b\u0438\u043a\u0440\u0430\u0442\u0430, \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0432 \u0415\u0433\u0438\u043f\u0435\u0442,
    \u0433\u0434\u0435 \u043f\u0440\u043e\u0431\u044b\u043b 22 \u0433\u043e\u0434\u0430. \u0422\u0430\u043c
    \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044e, \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443
    \u0438, \u0447\u0442\u043e \u0441\u0430\u043c\u043e\u0435 \u0432\u0430\u0436\u043d\u043e\u0435,
    \u0431\u044b\u043b \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d \u0432 \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0435
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0435 \u0442\u0430\u0438\u043d\u0441\u0442\u0432\u0430
    \u0436\u0440\u0435\u0446\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430
    \u043d\u0435\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435
    \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435. \u0412\u0430\u0432\u0438\u043b\u043e\u043d:
    \u0412 525 \u0433\u043e\u0434\u0443 \u0434\u043e \u043d. \u044d. \u0415\u0433\u0438\u043f\u0435\u0442
    \u0437\u0430\u0432\u043e\u0435\u0432\u0430\u043b \u043f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u0438\u0439
    \u0446\u0430\u0440\u044c \u041a\u0430\u043c\u0431\u0438\u0437, \u0438 \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u0431\u044b\u043b \u0443\u0432\u0435\u0434\u0435\u043d \u0432 \u0412\u0430\u0432\u0438\u043b\u043e\u043d
    \u043a\u0430\u043a \u043f\u043b\u0435\u043d\u043d\u0438\u043a. \u041f\u0440\u043e\u0431\u044b\u0432
    \u0442\u0430\u043c 12 \u043b\u0435\u0442, \u043e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f
    \u0441 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0435\u0439 \u0438 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0443\u0447\u0435\u043d\u0438\u044f\u043c\u0438 \u043c\u0435\u0441\u0442\u043d\u044b\u0445
    \u043c\u0430\u0433\u043e\u0432 \u0438 \u0445\u0430\u043b\u0434\u0435\u0435\u0432.\n\n\U0001F3DB
    \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0448\u043a\u043e\u043b\u044b \u0438
    \u0436\u0438\u0437\u043d\u044c \u0432 \u041a\u0440\u043e\u0442\u043e\u043d\u0435 (\u043e\u043a.
    532\u2013510 \u0433\u0433. \u0434\u043e \u043d.\u044d.) \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u043e\u043a\u043e\u043b\u043e 56 \u043b\u0435\u0442 \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u043d\u0430 \u0421\u0430\u043c\u043e\u0441,
    \u043d\u043e, \u043d\u0435 \u0436\u0435\u043b\u0430\u044f \u043c\u0438\u0440\u0438\u0442\u044c\u0441\u044f
    \u0441 \u0442\u0438\u0440\u0430\u043d\u0438\u0435\u0439 \u041f\u043e\u043b\u0438\u043a\u0440\u0430\u0442\u0430,
    \u043e\u043a\u043e\u043b\u043e 532 \u0433\u043e\u0434\u0430 \u0434\u043e \u043d. \u044d.
    \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0440\u043e\u0434\u0438\u043d\u0443 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0438 \u043f\u0435\u0440\u0435\u0441\u0435\u043b\u0438\u043b\u0441\u044f \u0432 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439
    \u0433\u043e\u0440\u043e\u0434 \u041a\u0440\u043e\u0442\u043e\u043d \u0432 \u042e\u0436\u043d\u043e\u0439
    \u0418\u0442\u0430\u043b\u0438\u0438. \u042d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434
    \u0441\u0442\u0430\u043b \u0441\u0430\u043c\u044b\u043c \u044f\u0440\u043a\u0438\u043c \u0432
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438. \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0441\u043a\u0438\u0439
    \u0441\u043e\u044e\u0437: \u0412 \u041a\u0440\u043e\u0442\u043e\u043d\u0435 \u043e\u043d
    \u043e\u0441\u043d\u043e\u0432\u0430\u043b \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430
    \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0439
    \u043e\u0431\u0449\u0438\u043d\u043e\u0439, \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u043e\u043c
    \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043a\u043b\u0443\u0431\u043e\u043c.
    \u042d\u0442\u043e \u0431\u044b\u043b \u0441\u0432\u043e\u0435\u0433\u043e \u0440\u043e\u0434\u0430
    \u0442\u0430\u0439\u043d\u044b\u0439 \u043e\u0440\u0434\u0435\u043d \u0434\u043b\u044f \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u044b\u0445.
    \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430: \u0423\u0447\u0435\u043d\u0438\u043a\u0438
    \u0434\u0435\u043b\u0438\u043b\u0438\u0441\u044c \u043d\u0430 \u0434\u0432\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438:
    \u0430\u043a\u0443\u0441\u043c\u0430\u0442\u0438\u043a\u0438 (\u00ab\u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u0438\u00bb)
    \u2014 \u043d\u043e\u0432\u0438\u0447\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u043b\u043e\u0441\u044c \u043b\u0438\u0448\u044c
    \u0432\u043d\u0438\u043c\u0430\u0442\u044c \u0433\u043e\u043b\u043e\u0441\u0443 \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u0438\u0437-\u0437\u0430 \u0437\u0430\u043d\u0430\u0432\u0435\u0441\u0430, \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    (\u00ab\u043f\u043e\u0437\u043d\u0430\u044e\u0449\u0438\u0435\u00bb) \u2014 \u0442\u0435,
    \u043a\u0442\u043e \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0438 \u043c\u043e\u0433 \u0432\u0438\u0434\u0435\u0442\u044c
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430. \u041e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438:
    \u0427\u043b\u0435\u043d\u044b \u0441\u043e\u044e\u0437\u0430 \u0432\u0435\u043b\u0438 \u0441\u0442\u0440\u043e\u0433\u0438\u0439
    \u0430\u0441\u043a\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043d\u0438: \u0431\u044b\u043b\u0438 \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0446\u0430\u043c\u0438,
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u043e\u0432\u0430\u043b\u0438 \u0440\u0438\u0442\u0443\u0430\u043b\u044b
    \u043e\u0447\u0438\u0449\u0435\u043d\u0438\u044f, \u0443\u0434\u0435\u043b\u044f\u043b\u0438
    \u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043c\u0443\u0437\u044b\u043a\u0435
    \u0438 \u0433\u0438\u043c\u043d\u0430\u0441\u0442\u0438\u043a\u0435. \u0418\u0445 \u0434\u0435\u0432\u0438\u0437\u043e\u043c
    \u0431\u044b\u043b\u0438 \u0441\u043b\u043e\u0432\u0430: \u00ab\u041e\u0442\u0441\u0435\u043a\u0430\u0439
    \u043e\u0433\u043d\u0435\u043c, \u0436\u0435\u043b\u0435\u0437\u043e\u043c \u0438 \u043b\u044e\u0431\u044b\u043c
    \u043e\u0440\u0443\u0436\u0438\u0435\u043c \u043e\u0442 \u0442\u0435\u043b\u0430 \u2014
    \u0431\u043e\u043b\u0435\u0437\u043d\u044c, \u043e\u0442 \u0434\u0443\u0448\u0438 \u2014
    \u043d\u0435\u0432\u0435\u0436\u0435\u0441\u0442\u0432\u043e, \u043e\u0442 \u0443\u0442\u0440\u043e\u0431\u044b
    \u2014 \u0440\u043e\u0441\u043a\u043e\u0448\u044c\u00bb. \u0421\u0438\u043c\u0432\u043e\u043b:
    \u041e\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0437\u043d\u0430\u043a\u043e\u043c \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u0435\u0432
    \u0431\u044b\u043b\u0430 \u043f\u0435\u043d\u0442\u0430\u0433\u0440\u0430\u043c\u043c\u0430
    \u2014 \u043f\u044f\u0442\u0438\u043a\u043e\u043d\u0435\u0447\u043d\u0430\u044f \u0437\u0432\u0435\u0437\u0434\u0430.\n\n\U0001F4A1
    \u0423\u0447\u0435\u043d\u0438\u0435 \u0438 \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443
    \u0421\u0435\u0440\u0434\u0446\u0435\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u0431\u044b\u043b\u0430 \u043c\u044b\u0441\u043b\u044c:
    \u00ab\u0412\u0441\u0451 \u0435\u0441\u0442\u044c \u0447\u0438\u0441\u043b\u043e\u00bb.
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u044c
    \u043c\u0438\u0440\u0430 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0437\u043d\u0430\u0442\u044c
    \u0447\u0435\u0440\u0435\u0437 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438,
    \u0438 \u0447\u0438\u0441\u043b\u0430 \u044d\u0442\u0438 \u2014 \u043d\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u044f,
    \u0430 \u0436\u0438\u0432\u044b\u0435 \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438.
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u043c\u0443\u0437\u044b\u043a\u0430:
    \u0415\u043c\u0443 \u0438 \u0435\u0433\u043e \u0448\u043a\u043e\u043b\u0435 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432
    \u0432 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0443\u044e
    \u0442\u0435\u043e\u0440\u0435\u043c\u0443 (\u0445\u043e\u0442\u044f, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430
    \u0438 \u0434\u043e \u043d\u0435\u0433\u043e). \u0422\u0430\u043a\u0436\u0435 \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u043e\u0442\u043a\u0440\u044b\u043b, \u0447\u0442\u043e \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u043d\u044b\u0435
    \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b
    (\u043e\u043a\u0442\u0430\u0432\u0430, \u043a\u0432\u0438\u043d\u0442\u0430, \u043a\u0432\u0430\u0440\u0442\u0430)
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0441\u0442\u0440\u043e\u0433\u0438\u043c
    \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u043c \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c
    (2:1, 3:2, 4:3). \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0438
    \u043b\u0435\u0433\u043b\u043e \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0438\u0434\u0435\u0438
    \u00ab\u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438 \u0441\u0444\u0435\u0440\u00bb \u2014
    \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u0447\u0430\u043d\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0438\u0437\u0434\u0430\u044e\u0442 \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0435
    \u0442\u0435\u043b\u0430, \u0432\u0440\u0430\u0449\u0430\u044f\u0441\u044c \u0432\u043e
    \u0412\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u041c\u0438\u0441\u0442\u0438\u043a\u0430
    \u0438 \u044d\u0442\u0438\u043a\u0430: \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u0432\u0435\u0440\u0438\u043b
    \u0432 \u043c\u0435\u0442\u0435\u043c\u043f\u0441\u0438\u0445\u043e\u0437 (\u043f\u0435\u0440\u0435\u0441\u0435\u043b\u0435\u043d\u0438\u0435
    \u0434\u0443\u0448) \u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u043f\u043e\u043c\u043d\u0438\u0442 \u0447\u0435\u0442\u044b\u0440\u0435 \u0441\u0432\u043e\u0438
    \u043f\u0440\u043e\u0448\u043b\u044b\u0435 \u0436\u0438\u0437\u043d\u0438. \u0418\u0437-\u0437\u0430
    \u044d\u0442\u043e\u0439 \u0432\u0435\u0440\u044b \u043e\u043d \u043f\u0440\u043e\u043f\u043e\u0432\u0435\u0434\u043e\u0432\u0430\u043b
    \u0441\u0432\u044f\u0442\u043e\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438 \u0432\u0441\u0435\u0445
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432 \u0438 \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0441\u0442\u0432\u043e.\n\n\U0001F4D6
    \u0421\u043c\u0435\u0440\u0442\u044c \u0438 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u041c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0441\u043a\u0438\u0439
    \u0441\u043e\u044e\u0437 \u0432\u044b\u0437\u044b\u0432\u0430\u043b \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u043e
    \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0440\u0443\u0433\u043e\u0432 \u041a\u0440\u043e\u0442\u043e\u043d\u0430. \u041e\u043a\u043e\u043b\u043e
    500 \u0433\u043e\u0434\u0430 \u0434\u043e \u043d. \u044d. \u0432\u0441\u043f\u044b\u0445\u043d\u0443\u043b
    \u043c\u044f\u0442\u0435\u0436 \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u043d\u0435\u043a\u043e\u0435\u0433\u043e \u041a\u0438\u043b\u043e\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0430\u043f\u0430\u043b \u043d\u0430 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435
    \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u0435\u0432. \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u0431\u0435\u0436\u0430\u043b \u0432 \u0441\u043e\u0441\u0435\u0434\u043d\u0438\u0439 \u0433\u043e\u0440\u043e\u0434
    \u041c\u0435\u0442\u0430\u043f\u043e\u043d\u0442. \u041e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u043f\u043e\u043a\u0440\u044b\u0442\u044b
    \u043c\u0440\u0430\u043a\u043e\u043c. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442
    \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0435\u0440\u0441\u0438\u0439:
    1. \u041c\u0438\u0440\u043d\u0430\u044f \u043a\u043e\u043d\u0447\u0438\u043d\u0430: \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u0414\u0438\u043e\u0433\u0435\u043d\u0443 \u041b\u0430\u044d\u0440\u0442\u0441\u043a\u043e\u043c\u0443,
    \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    90 \u043b\u0435\u0442 \u0432 \u041c\u0435\u0442\u0430\u043f\u043e\u043d\u0442\u0435. 2.
    \u0413\u0438\u0431\u0435\u043b\u044c \u0432 \u043f\u043e\u0436\u0430\u0440\u0435: \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u0434\u0440\u0443\u0433\u043e\u0439 \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u0435\u0433\u043e
    \u0443\u0447\u0435\u043d\u0438\u043a\u0438, \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u0441\u043f\u0430\u0441\u0442\u0438
    \u0435\u0433\u043e \u0438\u0437 \u0433\u043e\u0440\u044f\u0449\u0435\u0433\u043e \u0434\u043e\u043c\u0430,
    \u0441\u043b\u043e\u0436\u0438\u043b\u0438 \u043c\u043e\u0441\u0442 \u0438\u0437 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0442\u0435\u043b. \u041e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c \u043e\u0434\u0438\u043d,
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u043f\u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0441 \u0441\u043e\u0431\u043e\u0439. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0433\u0438\u0431\u0435\u043b\u044c \u0443\u0447\u0438\u0442\u0435\u043b\u044f
    \u0438 \u0440\u0430\u0437\u0433\u0440\u043e\u043c \u0448\u043a\u043e\u043b\u044b \u0432
    \u041a\u0440\u043e\u0442\u043e\u043d\u0435, \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u044b
    \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0438\u0441\u044c \u043f\u043e \u0433\u043e\u0440\u043e\u0434\u0430\u043c
    \u0413\u0440\u0435\u0446\u0438\u0438 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b\u0438
    \u0441\u0432\u043e\u044e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u043e\u043a\u0430\u0437\u0430\u0432 \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e
    \u041f\u043b\u0430\u0442\u043e\u043d\u0430 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0432\u0441\u0435\u0439 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439
    \u043d\u0430\u0443\u043a\u0438."
  shortBioEn: 
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043e\u0431\u0440\u043e\u0441\u043b\u0430 \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u043c\u0438,
    \u0447\u0442\u043e \u043e\u0442\u0434\u0435\u043b\u0438\u0442\u044c \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043f\u0440\u0430\u0432\u0434\u0443 \u043e\u0442 \u0432\u044b\u043c\u044b\u0441\u043b\u0430
    \u043f\u043e\u0440\u043e\u0439 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e\u0439 \u00ab\u0441\u0435\u0440\u043e\u0439
    \u0437\u043e\u043d\u0435\u00bb \u043a\u0440\u043e\u044e\u0442\u0441\u044f \u0441\u0430\u043c\u044b\u0435
    \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b. \u0412\u043e\u0442 \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430
    \u0441\u0430\u043c\u044b\u0445 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0438
    \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0445 \u0434\u0435\u0442\u0430\u043b\u0435\u0439
    \u0438\u0437 \u0436\u0438\u0437\u043d\u0438 \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430 \u0438 \u0435\u0433\u043e \u0448\u043a\u043e\u043b\u044b.
    1.\n\n\U0001F947 \u00ab\u0424\u0438\u043b\u043e\u0441\u043e\u0444\u00bb \u2014 \u044d\u0442\u043e
    \u0441\u043b\u043e\u0432\u043e \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u043e\u043d
    \u0414\u043e \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u043c\u0443\u0434\u0440\u0435\u0446\u043e\u0432
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u00ab\u0441\u043e\u0444\u043e\u0441\u0430\u043c\u0438\u00bb
    (\u043c\u0443\u0434\u0440\u0435\u0446\u0430\u043c\u0438). \u042d\u0442\u043e \u0437\u0432\u0443\u0447\u0430\u043b\u043e
    \u0433\u043e\u0440\u0434\u0435\u043b\u0438\u0432\u043e \u0438 \u0441\u0430\u043c\u043e\u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e.
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u0436\u0435 \u0432\u0432\u0435\u043b \u0442\u0435\u0440\u043c\u0438\u043d
    \u00ab\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u00bb (\u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u2014 \u00ab\u043b\u044e\u0431\u044f\u0449\u0438\u0439 \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u044c\u00bb).
    \u041d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441, \u043a\u0442\u043e \u043e\u043d \u0442\u0430\u043a\u043e\u0439,
    \u043e\u043d \u0441\u043a\u0440\u043e\u043c\u043d\u043e \u043e\u0442\u0432\u0435\u0447\u0430\u043b:
    \u00ab\u042f \u043d\u0435 \u043c\u0443\u0434\u0440\u0435\u0446, \u044f \u043b\u0438\u0448\u044c
    \u0441\u0442\u0440\u0435\u043c\u043b\u044e\u0441\u044c \u043a \u043c\u0443\u0434\u0440\u043e\u0441\u0442\u0438\u00bb.
    \u041e\u043d \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b \u0436\u0438\u0437\u043d\u044c
    \u0441 \u041e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u0438\u043c\u0438 \u0438\u0433\u0440\u0430\u043c\u0438:
    \u043e\u0434\u043d\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u0442\u044c\u0441\u044f,
    \u0434\u0440\u0443\u0433\u0438\u0435 \u2014 \u0442\u043e\u0440\u0433\u043e\u0432\u0430\u0442\u044c,
    \u0430 \u0442\u0440\u0435\u0442\u044c\u0438 (\u0441\u0430\u043c\u044b\u0435 \u043b\u0443\u0447\u0448\u0438\u0435)
    \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c, \u043a\u0430\u043a \u0432\u0441\u0451
    \u0443\u0441\u0442\u0440\u043e\u0435\u043d\u043e. 2.\n\n\U0001F507 \u041e\u0431\u0435\u0442
    \u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044f \u0438 \u00ab\u0421\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u043b\u00bb
    \u0412 \u0448\u043a\u043e\u043b\u0435 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e
    \u0441\u0442\u0440\u043e\u0436\u0430\u0439\u0448\u0435\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e:
    \u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u044f\u0442\u044c \u043b\u0435\u0442 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f
    \u0443\u0447\u0435\u043d\u0438\u043a\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u043b\u0438
    \u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043c\u043e\u043b\u0447\u0430\u043d\u0438\u0435.
    \u041e\u043d\u0438 \u043c\u043e\u0433\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u0443\u0448\u0430\u0442\u044c
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u0438\u0437-\u0437\u0430
    \u0437\u0430\u043d\u0430\u0432\u0435\u0441\u043a\u0438, \u043d\u0435 \u0432\u0438\u0434\u044f
    \u0435\u0433\u043e \u043b\u0438\u0446\u0430, \u0438 \u043d\u0438 \u0432 \u043a\u043e\u0435\u043c
    \u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u0442\u044c
    \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u0438 \u043d\u0435 \u0441\u043f\u043e\u0440\u0438\u0442\u044c.
    \u042d\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u043e\u0441\u044c \u0434\u043b\u044f \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e\u0431\u044b \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u0440\u0430\u0437\u0443\u043c
    \u043e\u0442 \u0441\u0442\u0430\u0440\u044b\u0445 \u043f\u0440\u0435\u0434\u0440\u0430\u0441\u0441\u0443\u0434\u043a\u043e\u0432.
    \u041f\u043e\u0437\u0436\u0435, \u043a\u043e\u0433\u0434\u0430 \u0443\u0447\u0435\u043d\u0438\u043a
    \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u043b \u0432 \u0440\u0430\u0437\u0440\u044f\u0434
    \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432\u00bb (\u043f\u043e\u0437\u043d\u0430\u044e\u0449\u0438\u0445),
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u043a\u043b\u044f\u0442\u0432\u043e\u0439
    \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0438\u0435\u043c
    \u0432 \u0442\u0430\u0439\u043d\u044b \u0443\u0447\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0430
    \u0444\u0440\u0430\u0437\u0430: \u00ab\u0410\u0432\u0442\u0301\u043e\u0441 \u044d\u0301\u0444\u0430\u00bb
    \u2014 \u00ab\u0421\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u043b\u00bb (\u0438\u043c\u0435\u044f
    \u0432 \u0432\u0438\u0434\u0443 \u0423\u0447\u0438\u0442\u0435\u043b\u044f). \u042d\u0442\u043e\u0442
    \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0435\u043f\u0440\u0435\u0440\u0435\u043a\u0430\u0435\u043c, \u0447\u0442\u043e \u0444\u0440\u0430\u0437\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u044b\u043b\u0430\u0442\u043e\u0439. \u0415\u0441\u043b\u0438
    \u0443\u0447\u0435\u043d\u0438\u043a\u0438 \u0441\u043b\u044b\u0448\u0430\u043b\u0438 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u043b
    \u0441\u043b\u043e\u0432\u0430\u043c \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430, \u043e\u043d\u0438
    \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0438
    \u0433\u043b\u0430\u0437\u0430 \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u043b\u0438:
    \u00ab\u0421\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u043b\u00bb, \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u044f
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044e. 3.\n\n\U0001F300 \u0424\u0430\u0441\u043e\u043b\u044c
    \u2014 \u0441\u0430\u043c\u043e\u0435 \u0441\u0442\u0440\u0430\u0448\u043d\u043e\u0435 \u0442\u0430\u0431\u0443
    \u0421\u0430\u043c\u044b\u043c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0438
    \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u043c \u0437\u0430\u043f\u0440\u0435\u0442\u043e\u043c
    \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u0435\u0432 \u0431\u044b\u043b\u043e
    \u0442\u0430\u0431\u0443 \u043d\u0430 \u0431\u043e\u0431\u044b (\u0444\u0430\u0441\u043e\u043b\u044c).
    \u0417\u0430\u043f\u0440\u0435\u0442 \u0431\u044b\u043b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u0442\u0440\u043e\u0433\u0438\u043c, \u0447\u0442\u043e \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435
    \u043a\u0430\u0440\u0430\u043b\u043e\u0441\u044c \u0441\u043c\u0435\u0440\u0442\u044c\u044e.
    \u041f\u0440\u0438\u0447\u0438\u043d (\u043f\u043e \u0432\u0435\u0440\u0441\u0438\u044f\u043c
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432) \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e,
    \u0438 \u0432\u0441\u0435 \u043e\u043d\u0438 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b:
    \u041c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f: \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u0432\u0435\u0440\u0438\u043b \u0432 \u043f\u0435\u0440\u0435\u0441\u0435\u043b\u0435\u043d\u0438\u0435
    \u0434\u0443\u0448 \u0438 \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0432
    \u0431\u043e\u0431\u0430\u0445 \u043c\u043e\u0433\u0443\u0442 \u043e\u0431\u0438\u0442\u0430\u0442\u044c
    \u0434\u0443\u0448\u0438 \u0443\u043c\u0435\u0440\u0448\u0438\u0445 (\u0438\u0437-\u0437\u0430
    \u043f\u043e\u043b\u043e\u0439 \u0442\u0440\u0443\u0431\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u0438
    \u0441\u0442\u0435\u0431\u043b\u044f, \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u0442\u043e\u0440\u0443\u044e,
    \u044f\u043a\u043e\u0431\u044b, \u0434\u0443\u0448\u0438 \u043f\u043e\u043f\u0430\u0434\u0430\u044e\u0442
    \u0432 \u0437\u0435\u043c\u043b\u044e). \u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f:
    \u0411\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c
    \u0434\u043b\u044f \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0430\u043d\u0438\u044f \u0432
    \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u044f\u0445 (\u0431\u0435\u043b\u044b\u0435 \u0438
    \u0447\u0435\u0440\u043d\u044b\u0435 \u043a\u0430\u043c\u0435\u0448\u043a\u0438). \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e,
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b
    \u0430\u0440\u0438\u0441\u0442\u043e\u043a\u0440\u0430\u0442\u043e\u043c, \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b
    \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u044e \u0438 \u0437\u0430\u043f\u0440\u0435\u0449\u0430\u043b
    \u0431\u043e\u0431\u044b \u043a\u0430\u043a \u0441\u0438\u043c\u0432\u043e\u043b \u00ab\u0432\u043b\u0430\u0441\u0442\u0438
    \u0442\u043e\u043b\u043f\u044b\u00bb. \u0414\u0438\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f:
    \u0421\u044b\u0440\u044b\u0435 \u0431\u043e\u0431\u044b \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442
    \u043c\u0435\u0442\u0435\u043e\u0440\u0438\u0437\u043c \u0438 \u0432\u0437\u0434\u0443\u0442\u0438\u0435,
    \u0447\u0442\u043e \u043d\u0430\u0440\u0443\u0448\u0430\u043b\u043e \u00ab\u0433\u0430\u0440\u043c\u043e\u043d\u0438\u044e\u00bb
    \u0442\u0435\u043b\u0430 \u0438 \u0441\u0431\u0438\u0432\u0430\u043b\u043e \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0439
    \u0441\u0442\u0440\u043e\u0439 \u0434\u0443\u0448\u0438. \u0410\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f:
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430,
    \u0447\u0442\u043e \u0443 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u0431\u044b\u043b\u0430
    \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u044c
    (\u0444\u0430\u0432\u0438\u0437\u043c), \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0431\u043e\u0431\u043e\u0432
    \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u043e \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u0435
    \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u043e\u0432 \u0438 \u043c\u043e\u0433\u043b\u043e
    \u0431\u044b\u0442\u044c \u0441\u043c\u0435\u0440\u0442\u0435\u043b\u044c\u043d\u044b\u043c.
    \u041f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u0438\u043c\u0435\u043d\u043d\u043e
    \u0431\u043e\u0431\u044b \u0441\u0442\u0430\u043b\u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u0435\u0433\u043e \u0433\u0438\u0431\u0435\u043b\u0438: \u0441\u043f\u0430\u0441\u0430\u044f\u0441\u044c
    \u043e\u0442 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439,
    \u043e\u043d \u0431\u0435\u0436\u0430\u043b \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0435
    \u0441 \u0431\u043e\u0431\u0430\u043c\u0438, \u043d\u043e, \u0443\u0432\u0438\u0434\u0435\u0432
    \u0438\u0445, \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0441\u044f \u0438
    \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u041b\u0443\u0447\u0448\u0435 \u0443\u043c\u0435\u0440\u0435\u0442\u044c,
    \u0447\u0435\u043c \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u0442\u044c \u043d\u0430 \u0431\u043e\u0431\u044b\u00bb,
    \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0438\u0433\u043b\u0438
    \u0432\u0440\u0430\u0433\u0438. 4.\n\n\U0001F4D0 \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    (\u0438 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e \u0437\u0430 \u043d\u0435\u0433\u043e)
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u044b \u0431\u043e\u0433\u043e\u0442\u0432\u043e\u0440\u0438\u043b\u0438
    \u0447\u0438\u0441\u043b\u0430 \u0438 \u0432\u0435\u0440\u0438\u043b\u0438, \u0447\u0442\u043e
    \u0432\u0441\u0451 \u0432 \u043c\u0438\u0440\u0435 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0440\u0430\u0437\u0438\u0442\u044c
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435\u043c \u0446\u0435\u043b\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b (\u0434\u0440\u043e\u0431\u044f\u043c\u0438). \u041e\u043d\u0438
    \u0431\u044b\u043b\u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u044b \u0432 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0438
    \u0438 \u00ab\u0438\u0437\u043c\u0435\u0440\u0438\u043c\u043e\u0441\u0442\u0438\u00bb \u043c\u0438\u0440\u0430.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u0434\u0438\u043d \u0438\u0437 \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u0432,
    \u0413\u0438\u043f\u043f\u0430\u0441 \u041c\u0435\u0442\u0430\u043f\u043e\u043d\u0442\u0441\u043a\u0438\u0439,
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430
    \u043d\u0435\u0441\u043e\u0438\u0437\u043c\u0435\u0440\u0438\u043c\u0430 \u0441 \u0435\u0433\u043e
    \u0441\u0442\u043e\u0440\u043e\u043d\u043e\u0439 (\u0442\u043e \u0435\u0441\u0442\u044c
    \u221a2 \u2014 \u044d\u0442\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u0430\u044f
    \u043d\u0435\u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0434\u0440\u043e\u0431\u044c). \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u043b\u043e \u0432\u0441\u044e \u0438\u0445 \u043a\u0430\u0440\u0442\u0438\u043d\u0443
    \u043c\u0438\u0440\u0430. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e
    \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0434\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u043d\u0430\u0443\u0447\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0440\u044b\u0432\u0443,
    \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u044b \u043f\u0440\u0438\u0448\u043b\u0438
    \u0432 \u0443\u0436\u0430\u0441. \u041f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435,
    \u043e\u043d\u0438 \u0441\u0445\u0432\u0430\u0442\u0438\u043b\u0438 \u0413\u0438\u043f\u043f\u0430\u0441\u0430
    \u0438 \u0443\u0442\u043e\u043f\u0438\u043b\u0438 \u0435\u0433\u043e \u0432 \u043c\u043e\u0440\u0435,
    \u043e\u0431\u044a\u044f\u0432\u0438\u0432, \u0447\u0442\u043e \u043e\u043d \u00ab\u0432\u043d\u0435\u0441
    \u0432 \u043c\u0438\u0440 \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e,
    \u043e\u0442\u0440\u0438\u0446\u0430\u044e\u0449\u0435\u0433\u043e \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u044e\u00bb,
    \u0438\u043b\u0438, \u043f\u043e \u0434\u0440\u0443\u0433\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438,
    \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0437\u0433\u043d\u0430\u043b\u0438 \u0435\u0433\u043e
    \u0441 \u043f\u043e\u0437\u043e\u0440\u043e\u043c. \u0412\u043e\u0442 \u0442\u0430\u043a\u0430\u044f
    \u00ab\u043b\u044e\u0431\u043e\u0432\u044c \u043a \u0438\u0441\u0442\u0438\u043d\u0435\u00bb.
    5.\n\n\U0001F9E6 \u041d\u0435\u043e\u0431\u044b\u0447\u043d\u0430\u044f \u0432\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u044c
    \u0438 \u00ab\u0417\u043e\u043b\u043e\u0442\u043e\u0435 \u0431\u0435\u0434\u0440\u043e\u00bb
    \u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0442,
    \u0447\u0442\u043e \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c
    \u044d\u0444\u0444\u0435\u043a\u0442\u043d\u044b\u043c \u043c\u0443\u0436\u0447\u0438\u043d\u043e\u0439.
    \u041e\u043d \u043d\u043e\u0441\u0438\u043b \u0434\u043b\u0438\u043d\u043d\u044b\u0435,
    \u043d\u0438\u0441\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0435 \u043e\u0434\u0435\u0436\u0434\u044b
    \u0431\u0435\u043b\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430 (\u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435
    \u043e\u0442 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0433\u0440\u0435\u043a\u043e\u0432
    \u0432 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0445 \u0445\u0438\u0442\u043e\u043d\u0430\u0445),
    \u0447\u0442\u043e \u043f\u0440\u0438\u0434\u0430\u0432\u0430\u043b\u043e \u0435\u043c\u0443
    \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0434.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u043b\u0435\u0433\u0435\u043d\u0434\u0430,
    \u0447\u0442\u043e \u0443 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430 \u0431\u044b\u043b\u043e
    \u00ab\u0437\u043e\u043b\u043e\u0442\u043e\u0435 \u0431\u0435\u0434\u0440\u043e\u00bb. \u041a\u043e\u0433\u0434\u0430
    \u043e\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b \u043d\u0430 \u041e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u0438\u0445
    \u0438\u0433\u0440\u0430\u0445 \u043f\u0435\u0440\u0435\u0434 \u0442\u043e\u043b\u043f\u043e\u0439,
    \u043e\u043d \u044f\u043a\u043e\u0431\u044b \u043f\u0440\u0438\u043f\u043e\u0434\u043d\u044f\u043b
    \u043e\u0434\u0435\u0436\u0434\u044b \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0441\u043e\u0431\u0440\u0430\u0432\u0448\u0438\u043c\u0441\u044f,
    \u0447\u0442\u043e \u0443 \u043d\u0435\u0433\u043e \u043e\u0434\u043d\u0430 \u043d\u043e\u0433\u0430
    \u043e\u0442 \u0431\u0435\u0434\u0440\u0430 \u0441\u0434\u0435\u043b\u0430\u043d\u0430 \u0438\u0437
    \u0447\u0438\u0441\u0442\u043e\u0433\u043e \u0437\u043e\u043b\u043e\u0442\u0430. \u042d\u0442\u043e
    \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c
    \u0435\u0433\u043e \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 (\u0441\u0432\u044f\u0437\u044c
    \u0441 \u0410\u043f\u043e\u043b\u043b\u043e\u043d\u043e\u043c). \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438 \u0441\u0447\u0438\u0442\u0430\u044e\u0442,
    \u0447\u0442\u043e \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0442\u0435\u0430\u0442\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0443\u043b\u043e\u0432\u043a\u0430
    \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c
    \u043f\u043e\u0437\u043e\u043b\u043e\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0442\u0435\u0437\u0430
    \u0438\u043b\u0438 \u043c\u0435\u0442\u0430\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u044b, \u0432\u0448\u0438\u0442\u043e\u0439 \u043f\u043e\u0434
    \u043a\u043e\u0436\u0443. 6.\n\n\U0001F9E0 \u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \u043f\u0440\u043e\u0448\u043b\u044b\u0435 \u0436\u0438\u0437\u043d\u0438
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u0432\u0435\u0440\u0438\u043b \u0432 \u043f\u0435\u0440\u0435\u0441\u0435\u043b\u0435\u043d\u0438\u0435
    \u0434\u0443\u0448 (\u043c\u0435\u0442\u0435\u043c\u043f\u0441\u0438\u0445\u043e\u0437)
    \u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e \u043f\u043e\u043c\u043d\u0438\u0442
    \u0432\u0441\u0435 \u0441\u0432\u043e\u0438 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0435
    \u0436\u0438\u0437\u043d\u0438. \u041e\u043d \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c, \u0447\u0442\u043e \u0431\u044b\u043b:
    1. \u0421\u044b\u043d\u043e\u043c \u0413\u0435\u0440\u043c\u0435\u0441\u0430 \u043f\u043e
    \u0438\u043c\u0435\u043d\u0438 \u042d\u0444\u0430\u043b\u0438\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043c\u043e\u0433 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c \u0432\u0441\u0451
    \u043d\u0430 \u0441\u0432\u0435\u0442\u0435. 2. \u0422\u0440\u043e\u044f\u043d\u0441\u043a\u0438\u043c
    \u0433\u0435\u0440\u043e\u0435\u043c \u0415\u0432\u0444\u043e\u0440\u0431\u043e\u043c (\u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0443\u0431\u0438\u043b\u0438 \u043f\u043e\u0434 \u0441\u0442\u0435\u043d\u0430\u043c\u0438
    \u0422\u0440\u043e\u0438). 3. \u0420\u044b\u0431\u0430\u043a\u043e\u043c \u043f\u043e \u0438\u043c\u0435\u043d\u0438
    \u041f\u0438\u0440\u0440. 4. \u041a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0435\u0439
    \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0410\u043b\u0435\u0442\u0430. \u0427\u0442\u043e\u0431\u044b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435,
    \u043e\u043d \u044f\u043a\u043e\u0431\u044b \u0437\u0430\u0448\u0435\u043b \u0432 \u0445\u0440\u0430\u043c
    \u0413\u0435\u0440\u044b \u0432 \u0410\u0440\u0433\u043e\u0441\u0435 \u0438 \u0443\u0437\u043d\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0441\u0442\u0430\u0440\u044b\u0439 \u0449\u0438\u0442, \u0432\u0438\u0441\u0435\u0432\u0448\u0438\u0439
    \u0442\u0430\u043c \u0435\u0449\u0435 \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d
    \u0422\u0440\u043e\u044f\u043d\u0441\u043a\u043e\u0439 \u0432\u043e\u0439\u043d\u044b \u2014
    \u043d\u0430 \u043d\u0435\u043c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0430\u0441\u044c
    \u043d\u0430\u0434\u043f\u0438\u0441\u044c \u0441 \u0438\u043c\u0435\u043d\u0435\u043c \u0415\u0432\u0444\u043e\u0440\u0431\u0430.
    7.\n\n\U0001F4A7 \u0417\u043e\u043b\u043e\u0442\u0430\u044f \u0447\u0430\u0448\u0430 \u0438
    \u0433\u0438\u0433\u0438\u0435\u043d\u0430 \u041e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432
    \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u0435\u0432 \u0431\u044b\u043b\u0430
    \u00ab\u0417\u043e\u043b\u043e\u0442\u0430\u044f \u0447\u0430\u0448\u0430\u00bb. \u041d\u0430
    \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u044d\u0442\u043e \u0431\u044b\u043b\u0430
    \u043d\u0435 \u0447\u0430\u0448\u0430, \u0430 \u0431\u0440\u043e\u043d\u0437\u043e\u0432\u044b\u0439
    \u0441\u043e\u0441\u0443\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u0432\u0438\u043b\u0438
    \u043d\u0430 \u043f\u0435\u0440\u0435\u043a\u0440\u0435\u0441\u0442\u043a\u0430\u0445. \u0421\u0443\u0442\u044c
    \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c
    \u0432 \u043d\u0435\u043c \u0432\u043e\u0434\u0443 \u043c\u043e\u0433\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u0435, \u043a\u0442\u043e \u0442\u043e\u0447\u043d\u043e \u0437\u043d\u0430\u043b
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u043e\u0431\u044a\u0435\u043c\u0430.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b
    \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431
    \u0431\u043e\u0440\u043e\u0442\u044c\u0441\u044f \u0441 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u044f\u043c\u0438
    (\u0434\u043e\u0433\u0430\u0434\u0430\u0432\u0448\u0438\u0441\u044c \u043e\u0431 \u0438\u0445
    \u0437\u0430\u0440\u0430\u0437\u043d\u043e\u0439 \u043f\u0440\u0438\u0440\u043e\u0434\u0435).
    \u041e\u043d \u043f\u0440\u0438\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u0436\u0438\u0442\u0435\u043b\u044f\u043c
    \u0433\u043e\u0440\u043e\u0434\u0430 \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0430
    \u0443\u043b\u0438\u0446\u044b \u0441 \u0432\u0435\u0442\u043a\u0430\u043c\u0438 \u043b\u0430\u0432\u0440\u0430
    \u0438 \u00ab\u043e\u0447\u0438\u0449\u0430\u0442\u044c \u0432\u043e\u0437\u0434\u0443\u0445\u00bb
    \u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\u043c \u0445\u043e\u0440\u043e\u0432\u043e\u0433\u043e
    \u043f\u0435\u043d\u0438\u044f \u0438 \u043c\u0443\u0437\u044b\u043a\u0438, \u0447\u0442\u043e
    \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u043e
    \u0440\u0430\u0441\u043f\u044b\u043b\u044f\u0442\u044c \u0444\u0438\u0442\u043e\u043d\u0446\u0438\u0434\u044b
    \u0438 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043a\u043e\u043c\u0444\u043e\u0440\u0442. 8.\n\n\U0001F6AB \u041f\u0435\u0440\u0432\u044b\u0439
    \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0435\u0446 \u0438 \u0432\u0435\u0433\u0430\u043d\u0441\u043a\u0438\u0435
    \u00ab\u043d\u043e\u0443-\u0445\u0430\u0443\u00bb \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0446\u0435\u043c.
    \u041d\u043e \u0435\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434 \u0431\u044b\u043b
    \u0438\u0437\u0431\u0438\u0440\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c: \u043e\u043d
    \u0437\u0430\u043f\u0440\u0435\u0449\u0430\u043b \u0435\u0441\u0442\u044c \u043c\u044f\u0441\u043e
    \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445, \u0442\u0430\u043a \u043a\u0430\u043a
    \u0432 \u043d\u0438\u0445 \u043c\u043e\u0433\u0443\u0442 \u0436\u0438\u0442\u044c \u0434\u0443\u0448\u0438
    \u043b\u044e\u0434\u0435\u0439, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c
    \u043e\u043d \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0442\u044c
    \u0432 \u043f\u0438\u0449\u0443 \u0440\u044b\u0431\u0443 \u0438 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043f\u0442\u0438\u0446 (\u0438\u0441\u043a\u043b\u044e\u0447\u0430\u044f \u043e\u0440\u043b\u043e\u0432,
    \u043f\u0447\u0435\u043b \u0438 \u0434\u0435\u043b\u044c\u0444\u0438\u043d\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u043f\u043e \u0435\u0433\u043e \u043c\u043d\u0435\u043d\u0438\u044e,
    \u0442\u043e\u0436\u0435 \u0431\u044b\u043b\u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0432
    \u043f\u0440\u043e\u0448\u043b\u043e\u0439 \u0436\u0438\u0437\u043d\u0438). \u041a\u0441\u0442\u0430\u0442\u0438,
    \u0438\u043c\u0435\u043d\u043d\u043e \u043f\u0438\u0444\u0430\u0433\u043e\u0440\u0435\u0439\u0446\u044b
    \u043f\u0435\u0440\u0432\u044b\u043c\u0438 \u043d\u0430\u0447\u0430\u043b\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c
    \u00ab\u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043c\u044f\u0441\u043e\u00bb
    \u0438\u0437 \u043f\u0448\u0435\u043d\u0438\u0446\u044b \u0438 \u0431\u043e\u0431\u043e\u0432,
    \u043f\u043e\u0434\u0436\u0430\u0440\u0438\u0432\u0430\u044f \u0438\u0445 \u0434\u043e \u0445\u0440\u0443\u0441\u0442\u044f\u0449\u0435\u0439
    \u043a\u043e\u0440\u043e\u0447\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c
    \u0436\u0435\u0440\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u044c
    \u043a\u0440\u043e\u0432\u0430\u0432\u044b\u0435 \u0436\u0435\u0440\u0442\u0432\u044b \u0431\u043e\u0433\u0430\u043c
    \u043e\u043d\u0438 \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u0432\u0430\u0440\u0432\u0430\u0440\u0441\u0442\u0432\u043e\u043c.
    9.\n\n\U0001F3B5 \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u0443\u0437\u044b\u043a\u043e\u0439
    (\u00ab\u041c\u0443\u0437\u044b\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f\u00bb)
    \u041f\u0438\u0444\u0430\u0433\u043e\u0440 \u043b\u0435\u0447\u0438\u043b \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    \u0434\u0443\u0448\u0438 \u0438 \u0442\u0435\u043b\u0430 \u043c\u0443\u0437\u044b\u043a\u043e\u0439.
    \u041e\u043d \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0441\u043e\u0447\u0438\u043d\u044f\u043b
    \u043c\u0435\u043b\u043e\u0434\u0438\u0438 \u043f\u0440\u043e\u0442\u0438\u0432 \u044f\u0440\u043e\u0441\u0442\u0438
    \u0438 \u0433\u043d\u0435\u0432\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0442\u0438\u0432
    \u0441\u0442\u0440\u0430\u0441\u0442\u0435\u0439. \u0423\u0442\u0440\u043e\u043c \u043e\u043d
    \u043f\u0440\u0438\u043a\u0430\u0437\u044b\u0432\u0430\u043b \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c
    \u043f\u0435\u0442\u044c \u0431\u043e\u0434\u0440\u044b\u0435, \u0441\u043b\u043e\u0436\u043d\u044b\u0435
    \u043c\u0435\u043b\u043e\u0434\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0443\u043c, \u0430 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u2014 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u044b\u0435,
    \u0443\u0431\u0430\u044e\u043a\u0438\u0432\u0430\u044e\u0449\u0438\u0435, \u0447\u0442\u043e\u0431\u044b
    \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435
    \u043e\u0442 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0432\u043e\u043b\u043d\u0435\u043d\u0438\u0439.
    \u0413\u043e\u0432\u043e\u0440\u044f\u0442, \u0447\u0442\u043e \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u043e\u043d \u043b\u0438\u0447\u043d\u043e \u0443\u0441\u043c\u0438\u0440\u0438\u043b \u043f\u044c\u044f\u043d\u043e\u0433\u043e
    \u0431\u0443\u044f\u043d\u0430, \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043c\u0435\u043d\u0438\u0432
    \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043b\u0430\u0434 (\u0444\u043b\u0435\u0439\u0442\u0443)
    \u0432 \u0434\u043e\u043c\u0435, \u0433\u0434\u0435 \u0442\u043e\u0442 \u043f\u0438\u0440\u043e\u0432\u0430\u043b.
    10.\n\n\U0001F480 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u0448\u0443\u0442\u043a\u0430
    \u0438\u043b\u0438 \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u0438\u0435 \u0414\u0438\u043e\u0433\u0435\u043d
    \u041b\u0430\u044d\u0440\u0442\u0441\u043a\u0438\u0439 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0437\u0430\u043f\u0438\u0441\u044c \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u041f\u0438\u0444\u0430\u0433\u043e\u0440
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u0441\u043c\u0435\u0440\u0442\u0438.
    \u041a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438,
    \u0447\u0442\u043e \u043b\u0443\u0447\u0448\u0435 \u0434\u043b\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u043f\u043e\u0441\u043b\u0435 \u0436\u0438\u0437\u043d\u0438, \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b:
    \u00ab\u041d\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u0439 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432
    \u043e \u0442\u043e\u043c, \u043e \u0447\u0435\u043c \u0443 \u0442\u0435\u0431\u044f \u043d\u0435\u0442
    \u0434\u0430\u0436\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432\u00bb. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u0439 \u043a\u0443\u0440\u044c\u0435\u0437, \u0447\u0442\u043e
    \u043f\u0435\u0440\u0435\u0434 \u0441\u043c\u0435\u0440\u0442\u044c\u044e (\u043f\u043e
    \u0432\u0435\u0440\u0441\u0438\u0438 \u043c\u0438\u0440\u043d\u043e\u0439 \u043a\u043e\u043d\u0447\u0438\u043d\u044b)
    \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c, \u0433\u0434\u0435 \u043f\u0440\u043e\u0441\u0438\u043b
    \u0438\u0445 \u043a\u043e\u0440\u043c\u0438\u0442\u044c \u0435\u0433\u043e \u043a\u043e\u0442\u0430
    \u0438 \u043a\u0443\u043f\u0438\u0442\u044c \u043d\u043e\u0432\u044b\u0439 \u0445\u0438\u0442\u043e\u043d,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0441\u0442\u0430\u0440\u044b\u0439 \u00ab\u0438\u0437\u043d\u043e\u0441\u0438\u043b\u0441\u044f\u00bb.
    \u042d\u0442\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u0430\u044f \u043c\u0435\u043b\u043e\u0447\u044c
    \u043d\u0430 \u0444\u043e\u043d\u0435 \u0435\u0433\u043e \u0432\u0435\u043b\u0438\u0447\u0438\u044f
    \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u0434\u0430\u0436\u0435
    \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0444\u0438\u043b\u043e\u0441\u043e\u0444 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0441 \u0431\u044b\u0442\u043e\u0432\u044b\u043c\u0438
    \u0437\u0430\u0431\u043e\u0442\u0430\u043c\u0438."
