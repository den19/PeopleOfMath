  fullNameRu: "\u0410\u0440\u043D\u043E\u043B\u044C\u0434, \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440
    \u0418\u0433\u043E\u0440\u0435\u0432\u0438\u0447"
  fullNameEn: Vladimir Igorovich Arnold
  birthDate: 12.06.1937
  deathDate: 03.06.2010
