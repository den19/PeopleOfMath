  achievementsRu: "\u0422\u0435\u0440\u0435\u043D\u0441 \u0422\u0430\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0448\u0438\u0440\u043E\u0442\u043E\u0439
    \u0441\u0432\u043E\u0438\u0445 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432,
    \u043D\u043E \u0438 \u0433\u043B\u0443\u0431\u0438\u043D\u043E\u0439 \u043F\u0440\u043E\u0440\u044B\u0432\u043E\u0432
    \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445, \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u0431\u044B, \u043D\u0435\u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
    \u043E\u0431\u043B\u0430\u0441\u0442\u044F\u0445. \u0415\u0433\u043E \u0432\u043A\u043B\u0430\u0434
    \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
    \u043D\u0430 \u0442\u0440\u0438 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F: \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B, \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
    \u0432 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0438 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439
    \u0433\u0438\u0434\u0440\u043E\u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0438
    \u0438 \u043D\u043E\u0432\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0439 \u043F\u043E\u0434\u0445\u043E\u0434
    \u043A \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0437\u0430\u0434\u0430\u0447\u0430\u043C \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0442\u043E\u0440\u0438\u043A\u0438.
    \u0412\u043E\u0442 \u0434\u0435\u0442\u0430\u043B\u0438 \u0435\u0433\u043E \u0441\u0430\u043C\u044B\u0445
    \u0437\u043D\u0430\u0447\u0438\u043C\u044B\u0445 \u0442\u0440\u0443\u0434\u043E\u0432. 
    ### \U0001F9E9 \u0422\u0435\u043E\u0440\u0438\u044F \u0447\u0438\u0441\u0435\u043B:
    \u0422\u0435\u043E\u0440\u0435\u043C\u0430 \u0413\u0440\u0438\u043D\u0430-\u0422\u0430\u043E
    \u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    \u042D\u0440\u0434\u0451\u0448\u0430  \u0412\u043A\u043B\u0430\u0434 \u0422\u0430\u043E
    \u0432 \u0442\u0435\u043E\u0440\u0438\u044E \u0447\u0438\u0441\u0435\u043B \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F,
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0441\u0430\u043C\u044B\u043C
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C.  *   **\u0422\u0435\u043E\u0440\u0435\u043C\u0430
    \u0413\u0440\u0438\u043D\u0430-\u0422\u0430\u043E (2004 \u0433.)**: \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E
    \u0441 \u0411\u0435\u043D\u043E\u043C \u0413\u0440\u0438\u043D\u043E\u043C \u0422\u0430\u043E
    \u0434\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u044B\u0435
    \u0447\u0438\u0441\u043B\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442
    \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0438\u0438 **\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u043B\u044C\u043D\u043E
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0434\u043B\u0438\u043D\u044B**.
    \u042D\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043E
    \u0434\u043B\u044F \u043B\u044E\u0431\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430
    `k` \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 `k` \u043F\u0440\u043E\u0441\u0442\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445
    \u043D\u0430 \u0440\u0430\u0432\u043D\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438
    \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430.     *  
    **\u041C\u0435\u0442\u043E\u0434**: \u0422\u0430\u043A \u043A\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u044B\u0435
    \u0447\u0438\u0441\u043B\u0430 \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \"\u043F\u043B\u043E\u0442\u043D\u044B\u043C\" \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E\u043C,
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u0421\u0435\u043C\u0435\u0440\u0435\u0434\u0438
    (\u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u0434\u043B\u044F \u043F\u043B\u043E\u0442\u043D\u044B\u0445 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432)
    \u043D\u0435\u043B\u044C\u0437\u044F \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C
    \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E. \u0413\u0440\u0438\u043D \u0438
    \u0422\u0430\u043E \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438
    **\"\u043F\u0440\u0438\u043D\u0446\u0438\u043F \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430\"
    (transference principle)**. \u041E\u043D\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438,
    \u0447\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u0447\u0438\u0441\u043B\u0430
    \u043C\u043E\u0436\u043D\u043E \u0432\u043B\u043E\u0436\u0438\u0442\u044C \u0432
    \u0431\u043E\u043B\u0435\u0435 \u043F\u043B\u043E\u0442\u043D\u043E\u0435 \"\u043F\u0441\u0435\u0432\u0434\u043E\u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0435\"
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \"\u043F\u043E\u0447\u0442\u0438
    \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u0447\u0438\u0441\u0435\u043B\",
    \u0434\u043B\u044F \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0443\u0436\u0435
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043E\u0431\u043E\u0431\u0449\u0435\u043D\u043D\u0430\u044F
    \u0442\u0435\u043E\u0440\u0435\u043C\u0430 \u0421\u0435\u043C\u0435\u0440\u0435\u0434\u0438.    
    *   **\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442**: \u042D\u0442\u0430
    \u0440\u0430\u0431\u043E\u0442\u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0440\u0435\u0448\u0438\u043B\u0430 \u0434\u0430\u0432\u043D\u044E\u044E \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0443,
    \u043D\u043E \u0438 \u0441\u043E\u0437\u0434\u0430\u043B\u0430 \u043D\u043E\u0432\u044B\u0439
    \u043C\u043E\u0449\u043D\u044B\u0439 \u043C\u0435\u0442\u043E\u0434 \u0432 \u0430\u0434\u0434\u0438\u0442\u0438\u0432\u043D\u043E\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0442\u043E\u0440\u0438\u043A\u0435. 
    *   **\u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    \u042D\u0440\u0434\u0451\u0448\u0430 \u043E \u0440\u0430\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438
    (EDP, 2015 \u0433.)**: \u0412 1930-\u0445 \u0433\u043E\u0434\u0430\u0445 \u041F\u0430\u043B
    \u042D\u0440\u0434\u0451\u0448 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u043B,
    \u0447\u0442\u043E \u0434\u043B\u044F \u043B\u044E\u0431\u043E\u0439 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
    \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0438\u0437 `+1` \u0438 `-1` \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
    \u0442\u0430\u043A\u0438\u0435 \u0447\u0438\u0441\u043B\u0430 `n` \u0438 `d`,
    \u0447\u0442\u043E \u0441\u0443\u043C\u043C\u0430 `f(d) + f(2d) +... + f(nd)`
    \u0431\u0443\u0434\u0435\u0442 \u043F\u043E \u043C\u043E\u0434\u0443\u043B\u044E
    \u0441\u043A\u043E\u043B\u044C \u0443\u0433\u043E\u0434\u043D\u043E \u0432\u0435\u043B\u0438\u043A\u0430.
    \u0422\u0430\u043E \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0435\u0448\u0438\u043B
    \u044D\u0442\u0443 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443.     *  
    **\u041C\u0435\u0442\u043E\u0434**: \u0412 \u0440\u0430\u043C\u043A\u0430\u0445
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 Polymath5 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
    \u0431\u044B\u043B\u0430 \u0441\u0432\u0435\u0434\u0435\u043D\u0430 \u043A \u0447\u0430\u0441\u0442\u043D\u043E\u043C\u0443
    \u0441\u043B\u0443\u0447\u0430\u044E **\u0432\u043F\u043E\u043B\u043D\u0435 \u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0438\u043A\u0430\u0442\u0438\u0432\u043D\u044B\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439**. \u0417\u0430\u0442\u0435\u043C,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u043D\u0435\u0434\u0430\u0432\u043D\u0438\u0435
    \u043F\u0440\u043E\u0440\u044B\u0432\u044B \u041A. \u041C\u0430\u0442\u043E\u043C\u044F\u043A\u0438
    \u0438 \u041C. \u0420\u0430\u0434\u0437\u0438\u0432\u0438\u043B\u043B\u0430 \u0432
    \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0438 \u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0438\u043A\u0430\u0442\u0438\u0432\u043D\u044B\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439 \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445
    \u0438\u043D\u0442\u0435\u0440\u0432\u0430\u043B\u0430\u0445, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0432 \u044D\u043D\u0442\u0440\u043E\u043F\u0438\u0439\u043D\u044B\u0435
    \u043D\u0435\u0440\u0430\u0432\u0435\u043D\u0441\u0442\u0432\u0430 \u0428\u0435\u043D\u043D\u043E\u043D\u0430,
    \u0422\u0430\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
    \u0442\u0430\u043A\u0438\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438 \u043D\u0435
    \u043C\u043E\u0433\u0443\u0442 \u0438\u043C\u0435\u0442\u044C \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0435
    \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u044B\u0435 \u0441\u0443\u043C\u043C\u044B,
    \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u043D\u0435 \u043A\u043E\u0440\u0440\u0435\u043B\u0438\u0440\u0443\u044E\u0442
    \u0441 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C \u0414\u0438\u0440\u0438\u0445\u043B\u0435. 
    ### \U0001F30A \u0423\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F \u041D\u0430\u0432\u044C\u0435-\u0421\u0442\u043E\u043A\u0441\u0430:
    \u0412\u043A\u043B\u0430\u0434 \u0432 \u043E\u0434\u043D\u0443 \u0438\u0437 \"\u0437\u0430\u0434\u0430\u0447
    \u0442\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u0438\u044F\"  \u0423\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F
    \u041D\u0430\u0432\u044C\u0435-\u0421\u0442\u043E\u043A\u0441\u0430 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0435\u0439
    \u0438 \u0433\u0430\u0437\u043E\u0432. \u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0433\u043B\u0430\u0434\u043A\u043E\u0441\u0442\u0438 \u0438\u0445 \u0440\u0435\u0448\u0435\u043D\u0438\u0439
    \u0432 \u0442\u0440\u0435\u0445\u043C\u0435\u0440\u043D\u043E\u043C \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u0441\u0435\u043C\u0438 \"\u0437\u0430\u0434\u0430\u0447 \u0442\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u0438\u044F\". 
    *   **\u041D\u043E\u0432\u044B\u0439 \u043F\u043E\u0434\u0445\u043E\u0434 \u043A
    \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u0441\u043B\u0443\u0447\u0430\u044E
    (2019 \u0433.)**: \u0422\u0430\u043E \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0435\u043B
    \u0442\u0435\u043E\u0440\u0438\u044E \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438
    \u0434\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u0439, \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0445
    \u0432 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043D\u043E\u0440\u043C\u0435
    `L\xB3_x`. \u041E\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0432\u0435\u0440\u0441\u0438\u0438 \u0440\u0430\u043D\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 (\u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0441\u0442\u043D\u044B\u0445)
    \u043C\u0435\u0442\u043E\u0434\u043E\u0432.     *   **\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442**:
    \u041E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0435\u0441\u043B\u0438
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0432\u0441\u0451 \u0436\u0435 \"\u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F\"
    \u0437\u0430 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F,
    \u0442\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043D\u043E\u0440\u043C\u044B \u0434\u043E\u043B\u0436\u043D\u043E \u0440\u0430\u0441\u0442\u0438
    \u043A\u0430\u043A \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u0441 \u0442\u0440\u043E\u0439\u043D\u043E\u0439
    \u044D\u043A\u0441\u043F\u043E\u043D\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E (\u0438\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435). 
    *   **\u041B\u043E\u0433\u0430\u0440\u0438\u0444\u043C\u0438\u0447\u0435\u0441\u043A\u0438
    \u0441\u0443\u043F\u0435\u0440\u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 (2009 \u0433.)**: \u0412\u043C\u0435\u0441\u0442\u043E
    \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F
    \u0440\u0435\u0448\u0438\u0442\u044C \u0438\u0441\u0445\u043E\u0434\u043D\u0443\u044E
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E,
    \u0422\u0430\u043E \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
    \u0435\u0435 \"\u043E\u0431\u043E\u0431\u0449\u0435\u043D\u043D\u0443\u044E\"
    \u0432\u0435\u0440\u0441\u0438\u044E (\u0433\u0438\u043F\u0435\u0440\u0434\u0438\u0441\u0441\u0438\u043F\u0430\u0442\u0438\u0432\u043D\u043E\u0435
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435).     *   **\u0418\u0434\u0435\u044F**:
    \u0412 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0435 \u043C\u0435\u0442\u043E\u0434\u044B
    (\"\u0413\u0440\u043E\u043D\u0443\u043E\u043B\u043B\") \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442.
    \u0422\u0430\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
    \u043C\u043E\u0436\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \"\u043E\u0441\u043B\u0430\u0431\u0438\u0442\u044C\"
    \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438,
    \u0432\u0432\u0435\u0434\u044F \u043B\u043E\u0433\u0430\u0440\u0438\u0444\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C. \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E
    \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F \u0447\u0443\u0442\u044C
    \u0434\u0430\u043B\u044C\u0448\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u0431\u0430\u0440\u044C\u0435\u0440\u0430.     *   **\u0417\u043D\u0430\u0447\u0435\u043D\u0438\u0435**:
    \u042D\u0442\u0430 \u0440\u0430\u0431\u043E\u0442\u0430 \u0434\u0430\u043B\u0430
    \u0432\u0430\u0436\u043D\u043E\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435,
    \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0436\u0435\u0441\u0442\u043A\u043E\u0439
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430
    \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0445 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439
    \u0438 \u043A\u0430\u043A\u0438\u0435 \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F
    \u043C\u0435\u0448\u0430\u044E\u0442 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443
    \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438.  ###
    \U0001F9E0 \u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0442\u043E\u0440\u0438\u043A\u0430
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 
    \u0422\u0430\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442 \u043C\u043E\u0449\u043D\u044B\u0439
    \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442 \u043A \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0442\u043E\u0440\u043D\u044B\u043C
    \u0437\u0430\u0434\u0430\u0447\u0430\u043C.  *   **\u041F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0437\u0430\u043C\u043E\u0449\u0435\u043D\u0438\u044F (2020 \u0433.)**: \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E
    \u0441 \u0420\u0435\u0439\u0447\u0435\u043B \u0413\u0440\u0438\u043D\u0444\u0435\u043B\u044C\u0434
    \u043E\u043D \u0438\u0437\u0443\u0447\u0430\u043B \u0437\u0430\u0434\u0430\u0447\u0443
    \u043E \u0437\u0430\u043C\u043E\u0449\u0435\u043D\u0438\u0438 \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438
    (\u0438\u043B\u0438 \u0440\u0435\u0448\u0435\u0442\u043A\u0438) \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
    \u0444\u0438\u0433\u0443\u0440\u043E\u0439.     *   **\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442**:
    \u041E\u043D\u0438 \u0440\u0435\u0448\u0438\u043B\u0438 \u0434\u0430\u0432\u043D\u044E\u044E
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443 \u0434\u043B\u044F \u0434\u0432\u0443\u043C\u0435\u0440\u043D\u043E\u0433\u043E
    \u0441\u043B\u0443\u0447\u0430\u044F, \u0434\u043E\u043A\u0430\u0437\u0430\u0432
    **\u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u043E \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u043D\u043E\u0441\u0442\u0438**.
    \u041E\u043D\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E
    \u0435\u0441\u043B\u0438 \u0444\u0438\u0433\u0443\u0440\u0430 \u0437\u0430\u043C\u043E\u0449\u0430\u0435\u0442
    \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u044C, \u0442\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0437\u0430\u043C\u043E\u0449\u0435\u043D\u0438\u0435 \u0441 \u043F\u0435\u0440\u0438\u043E\u0434\u043E\u043C,
    \u043F\u043E\u043B\u0438\u043D\u043E\u043C\u0438\u0430\u043B\u044C\u043D\u043E
    \u0437\u0430\u0432\u0438\u0441\u044F\u0449\u0438\u043C \u043E\u0442 \u0440\u0430\u0437\u043C\u0435\u0440\u0430
    \u0444\u0438\u0433\u0443\u0440\u044B. \u042D\u0442\u043E \u0442\u0430\u043A\u0436\u0435
    \u0434\u0430\u0435\u0442 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F (\u0437\u0430\u0434\u0430\u0447\u0430
    \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442 \u0432 \u043A\u043B\u0430\u0441\u0441
    NP).  *   **\u041F\u0440\u043E\u0435\u043A\u0442 ANTEDB (2025 \u0433.)**: \u0422\u0430\u043E
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u043E\u0430\u0432\u0442\u043E\u0440\u043E\u043C
    \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u044B \u043F\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E
    **\u0431\u0430\u0437\u044B \u0434\u0430\u043D\u043D\u044B\u0445 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439
    \u0432 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B**. \u042D\u0442\u043E
    \"\u0436\u0438\u0432\u043E\u0439\" \u0440\u0435\u043F\u043E\u0437\u0438\u0442\u043E\u0440\u0438\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442
    \u0432\u043E\u0435\u0434\u0438\u043D\u043E \u0432\u0441\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435
    \u0433\u0440\u0430\u043D\u0438\u0446\u044B \u0434\u043B\u044F \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445
    \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0434\u043B\u044F \u0440\u043E\u0441\u0442\u0430 \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043D\u043A\u0446\u0438\u0438
    \u0420\u0438\u043C\u0430\u043D\u0430).     *   **\u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435**:
    \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u044D\u0442\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430 \u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u043E\u0433\u043E
    \u043F\u0435\u0440\u0435\u0431\u043E\u0440\u0430 \u0438\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C **\u0447\u0435\u0442\u044B\u0440\u0435
    \u043D\u043E\u0432\u044B\u0445 \"\u044D\u043A\u0441\u043F\u043E\u043D\u0435\u043D\u0442\u043D\u044B\u0445
    \u043F\u0430\u0440\u044B\"** (\u0434\u043B\u044F \u043E\u0446\u0435\u043D\u043A\u0438
    \u044D\u043A\u0441\u043F\u043E\u043D\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u0441\u0443\u043C\u043C) \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    **\u043D\u043E\u0432\u044B\u0445 \u043E\u0446\u0435\u043D\u043E\u043A \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u0438
    \u043D\u0443\u043B\u0435\u0439** \u0434\u0437\u0435\u0442\u0430-\u0444\u0443\u043D\u043A\u0446\u0438\u0438. 
    ### \U0001F48E \u0418\u0442\u043E\u0433: \u041C\u0430\u0441\u0448\u0442\u0430\u0431
    \u0438 \u0441\u0442\u0438\u043B\u044C \u0440\u0430\u0431\u043E\u0442\u044B  \u0412\u043A\u043B\u0430\u0434
    \u0422\u0435\u0440\u0435\u043D\u0441\u0430 \u0422\u0430\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C
    \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u0445 \u043F\u0440\u043E\u0431\u043B\u0435\u043C,
    \u043D\u043E \u0438 \u0442\u0435\u043C, \u0447\u0442\u043E \u043E\u043D \u0447\u0430\u0441\u0442\u043E
    **\u0441\u043E\u0437\u0434\u0430\u0435\u0442 \u043D\u043E\u0432\u044B\u0435 \u043C\u043E\u0449\u043D\u044B\u0435
    \u043C\u0435\u0442\u043E\u0434\u044B** (\u043F\u0440\u0438\u043D\u0446\u0438\u043F
    \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430, \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0441\u0442\u043D\u044B\u0445
    \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u043E\u0432, \u0431\u0430\u0437\u044B
    \u0434\u0430\u043D\u043D\u044B\u0445 \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0440\u0443\u0442\u0438\u043D\u044B). \u0415\u0433\u043E \u0441\u0442\u0438\u043B\u044C
    \u2014 \u044D\u0442\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0435 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \u0432 \u0441\u0443\u0442\u044C \u0437\u0430\u0434\u0430\u0447\u0438, \u0441\u043C\u0435\u043B\u043E\u0435
    \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438\u0434\u0435\u0439 \u0438\u0437 \u0440\u0430\u0437\u043D\u044B\u0445 \u043E\u0431\u043B\u0430\u0441\u0442\u0435\u0439
    \u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u0434\u043B\u044F
    \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0433\u0438\u043F\u043E\u0442\u0435\u0437.
    \u0415\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0442
    \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439
    \u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u043D\u0430 \u0433\u043E\u0434\u044B
    \u0432\u043F\u0435\u0440\u0435\u0434."
  achievementsEn: 
  personalLifeRu: "\u0422\u0435\u0440\u0435\u043D\u0441 \u0422\u0430\u043E \u2014
    \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u044F\u0440\u043A\u0438\u0445
    \u0443\u043C\u043E\u0432 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0438.
    \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
    \u2014 \u044D\u0442\u043E \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0430\u044F
    \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u043E \u0442\u043E\u043C, \u043A\u0430\u043A
    \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u044B\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0439
    \u0434\u0430\u0440, \u043F\u043E\u043C\u043D\u043E\u0436\u0435\u043D\u043D\u044B\u0439
    \u043D\u0430 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C \u0441\u0435\u043C\u044C\u0438
    \u0438 \u0443\u043F\u043E\u0440\u043D\u044B\u0439 \u0442\u0440\u0443\u0434, \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B
    \"\u0432\u0443\u043D\u0434\u0435\u0440\u043A\u0438\u043D\u0434\u0443\" \u0441\u0442\u0430\u0442\u044C
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0432\u043B\u0438\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0438 \u0443\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432
    \u043D\u0430\u0448\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438.
    \u0412\u043E\u0442 \u0435\u0433\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445.  ### \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0438 \u0441\u0435\u043C\u044C\u044F \U0001F9EC  \u0422\u0435\u0440\u0435\u043D\u0441
    \u0427\u0438-\u0428\u0435\u043D \u0422\u0430\u043E (\u043A\u0438\u0442. \u9676\u54F2\u8ED2)
    \u0440\u043E\u0434\u0438\u043B\u0441\u044F **17 \u0438\u044E\u043B\u044F 1975
    \u0433\u043E\u0434\u0430** \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0410\u0434\u0435\u043B\u0430\u0438\u0434\u0430,
    \u0410\u0432\u0441\u0442\u0440\u0430\u043B\u0438\u044F, \u0432 \u0441\u0435\u043C\u044C\u0435
    \u044D\u043C\u0438\u0433\u0440\u0430\u043D\u0442\u043E\u0432 \u0438\u0437 \u0413\u043E\u043D\u043A\u043E\u043D\u0433\u0430.
    \u0415\u0433\u043E \u043E\u0442\u0435\u0446, \u0411\u0438\u043B\u043B\u0438 (\u0423\u0438\u043B\u044C\u044F\u043C
    \u0420\u044D\u043D\u0434\u043E\u043B\u044C\u0444) \u0422\u0430\u043E, \u0431\u044B\u043B
    \u043F\u0435\u0434\u0438\u0430\u0442\u0440\u043E\u043C, \u0440\u043E\u0434\u0438\u0432\u0448\u0438\u043C\u0441\u044F
    \u0432 \u0428\u0430\u043D\u0445\u0430\u0435. \u041C\u0430\u0442\u044C, \u0413\u0440\u0435\u0439\u0441
    \u041B\u0435\u043D\u0433 (\u041B\u044F\u043D \u0425\u0443\u044D\u0439\u043B\u0430\u043D\u044C),
    \u0438\u043C\u0435\u043B\u0430 \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u0441
    \u043E\u0442\u043B\u0438\u0447\u0438\u0435\u043C \u043F\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435
    \u0438 \u0444\u0438\u0437\u0438\u043A\u0435 \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430
    \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C \u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u0439
    \u0448\u043A\u043E\u043B\u0435. \u0420\u043E\u0434\u0438\u0442\u0435\u043B\u0438
    \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0413\u043E\u043D\u043A\u043E\u043D\u0433\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435,
    \u0430 \u0432 \u0410\u0432\u0441\u0442\u0440\u0430\u043B\u0438\u044E \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0438
    \u0432 1972 \u0433\u043E\u0434\u0443.  \u0423 \u0422\u0435\u0440\u0435\u043D\u0441\u0430
    \u0435\u0441\u0442\u044C \u0434\u0432\u0430 \u043C\u043B\u0430\u0434\u0448\u0438\u0445
    \u0431\u0440\u0430\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u0430\u043A\u0436\u0435
    \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438 \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0435\u0441\u044F
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438: *   **\u041D\u0430\u0439\u0434\u0436\u0435\u043B
    \u0422\u0430\u043E** \u2014 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A
    \u043A\u043E\u043C\u0430\u043D\u0434\u044B, \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0432\u0448\u0435\u0439
    Google Wave, \u0435\u0433\u043E IQ \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 180 \u0431\u0430\u043B\u043B\u043E\u0432. *   **\u0422\u0440\u0435\u0432\u043E\u0440
    \u0422\u0430\u043E** \u2014 \u0442\u0430\u043B\u0430\u043D\u0442\u043B\u0438\u0432\u044B\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A \u0438 \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0439
    \u043C\u0430\u0441\u0442\u0435\u0440 \u043F\u043E \u0448\u0430\u0445\u043C\u0430\u0442\u0430\u043C. 
    \u0422\u0430\u043A\u043E\u0435 \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0435
    \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435, \u0431\u0435\u0437\u0443\u0441\u043B\u043E\u0432\u043D\u043E,
    \u0441\u044B\u0433\u0440\u0430\u043B\u043E \u0441\u0432\u043E\u044E \u0440\u043E\u043B\u044C,
    \u043D\u043E \u0441\u0430\u043C \u0422\u0435\u0440\u0435\u043D\u0441 \u043F\u043E\u0448\u0435\u043B
    \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0434\u0430\u043B\u044C\u0448\u0435. 
    ### \u0414\u0435\u0442\u0441\u0442\u0432\u043E: \"\u0412\u0443\u043D\u0434\u0435\u0440\u043A\u0438\u043D\u0434\"
    \u0441 \"\u0423\u043B\u0438\u0446\u044B \u0421\u0435\u0437\u0430\u043C\" \U0001F9F8 
    \u0424\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0422\u0435\u0440\u0435\u043D\u0441\u0430
    \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u043E\u0447\u0435\u043D\u044C
    \u0440\u0430\u043D\u043E. **\u0412 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    \u0434\u0432\u0443\u0445 \u043B\u0435\u0442** \u043E\u043D \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u044B\u0443\u0447\u0438\u043B \u0431\u0443\u043A\u0432\u044B \u0438 \u0446\u0438\u0444\u0440\u044B,
    \u0441\u043C\u043E\u0442\u0440\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443
    \xAB\u0423\u043B\u0438\u0446\u0430 \u0421\u0435\u0437\u0430\u043C\xBB, \u0430
    \u0437\u0430\u0442\u0435\u043C \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u043E\u0431\u0443\u0447\u0438\u0442\u044C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u043F\u044F\u0442\u0438\u043B\u0435\u0442\u043D\u0438\u0445
    \u0434\u0435\u0442\u0435\u0439. \u0415\u0433\u043E \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438,
    \u0437\u0430\u043C\u0435\u0442\u0438\u0432 \u043D\u0435\u043E\u0431\u044B\u043A\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
    \u043E\u0442\u0434\u0430\u0442\u044C **3,5-\u043B\u0435\u0442\u043D\u0435\u0433\u043E**
    \u0422\u0435\u0440\u0435\u043D\u0441\u0430 \u0432 \u0448\u043A\u043E\u043B\u0443,
    \u043D\u043E \u043E\u043D \u0431\u044B\u043B \u0435\u0449\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u043C\u0430\u043B \u0434\u043B\u044F \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u0438, \u0438 \u0435\u0433\u043E
    \u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0432 \u0434\u0435\u0442\u0441\u043A\u0438\u0439
    \u0441\u0430\u0434. \u0422\u043E\u0433\u0434\u0430 \u043C\u0430\u0442\u044C \u0437\u0430\u043D\u044F\u043B\u0430\u0441\u044C
    \u0435\u0433\u043E \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u0434\u043E\u043C\u0430, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u0432
    \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u0443\u044E
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443.  \u0421\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0431\u044B\u043B \u043E\u0447\u0435\u0432\u0438\u0434\u0435\u043D:
    *   **\u0412 7 \u043B\u0435\u0442** \u043E\u043D \u043D\u0430\u0447\u0430\u043B
    \u0438\u0437\u0443\u0447\u0430\u0442\u044C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043D\u0430\u043B\u0438\u0437 \u0438 \u043F\u043E\u0441\u0435\u0449\u0430\u0442\u044C
    \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u0432 \u0441\u0442\u0430\u0440\u0448\u0435\u0439
    \u0448\u043A\u043E\u043B\u0435. *   **\u0412 8 \u043B\u0435\u0442** \u043E\u043D
    \u043D\u0430\u0431\u0440\u0430\u043B **760 \u0431\u0430\u043B\u043B\u043E\u0432
    \u0438\u0437 800** \u043F\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0441\u0435\u043A\u0446\u0438\u0438 \u0442\u0435\u0441\u0442\u0430 SAT. \u042D\u0442\u043E
    \u043E\u0434\u0438\u043D \u0438\u0437 \u043B\u0443\u0447\u0448\u0438\u0445 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432
    \u0434\u043B\u044F \u0435\u0433\u043E \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
    \u043F\u043E \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044E \u0442\u0430\u043B\u0430\u043D\u0442\u043B\u0438\u0432\u044B\u0445
    \u0434\u0435\u0442\u0435\u0439. *   **\u0421 9 \u043B\u0435\u0442** \u043E\u043D
    \u043D\u0430\u0447\u0430\u043B \u043F\u043E\u0441\u0435\u0449\u0430\u0442\u044C
    \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u043F\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435
    \u043D\u0430 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043A\u043E\u043C
    \u0443\u0440\u043E\u0432\u043D\u0435 \u0432 \u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0424\u043B\u0438\u043D\u0434\u0435\u0440\u0441\u0430.  \u0415\u0433\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
    \u0432 \u043C\u0438\u0440\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0443\u043A\u0440\u0435\u043F\u0438\u043B\u0430\u0441\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0432\u044B\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F\u043C \u043D\u0430
    \u041C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043E\u043B\u0438\u043C\u043F\u0438\u0430\u0434\u0435 (IMO): *   **\u0412 10
    \u043B\u0435\u0442 (1986)** \u043E\u043D \u0441\u0442\u0430\u043B \u0441\u0430\u043C\u044B\u043C
    \u043C\u043E\u043B\u043E\u0434\u044B\u043C \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u043C
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0438 \u0437\u0430\u0432\u043E\u0435\u0432\u0430\u043B
    **\u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E \u043C\u0435\u0434\u0430\u043B\u044C**.
    *   **\u0412 11 \u043B\u0435\u0442 (1987)** \u043E\u043D \u0432\u044B\u0438\u0433\u0440\u0430\u043B
    **\u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0443\u044E \u043C\u0435\u0434\u0430\u043B\u044C**.
    *   **\u0412 13 \u043B\u0435\u0442 (1988)** \u043E\u043D \u0437\u0430\u0432\u043E\u0435\u0432\u0430\u043B
    **\u0437\u043E\u043B\u043E\u0442\u0443\u044E \u043C\u0435\u0434\u0430\u043B\u044C**,
    \u0441\u0442\u0430\u0432 \u0441\u0430\u043C\u044B\u043C \u043C\u043E\u043B\u043E\u0434\u044B\u043C
    \u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u0435\u043C \u0437\u043E\u043B\u043E\u0442\u0430
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u043E\u043B\u0438\u043C\u043F\u0438\u0430\u0434\u044B.
    \u042D\u0442\u043E\u0442 \u0440\u0435\u043A\u043E\u0440\u0434 \u043D\u0435 \u043F\u043E\u0431\u0438\u0442
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440.  \u0417\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A **\u041F\u0430\u043B \u042D\u0440\u0434\u0451\u0448**,
    \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0422\u0435\u0440\u0435\u043D\u0441
    \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F \u0432
    10 \u043B\u0435\u0442, \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043B
    \u0435\u043C\u0443 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0435. 
    ### \u0423\u0447\u0451\u0431\u0430: \u041E\u0442 \u0410\u0434\u0435\u043B\u0430\u0438\u0434\u044B
    \u0434\u043E \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0430 \U0001F393 
    \u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0422\u0435\u0440\u0435\u043D\u0441\u0430
    \u0422\u0430\u043E \u0431\u044B\u043B\u043E \u0441\u0442\u043E\u043B\u044C \u0436\u0435
    \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C,
    \u043A\u0430\u043A \u0438 \u0435\u0433\u043E \u0440\u0430\u043D\u043D\u0435\u0435
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435, \u043D\u043E \u0435\u0433\u043E
    \u043F\u0443\u0442\u044C \u043D\u0435 \u0431\u044B\u043B \u043B\u0438\u0448\u0435\u043D
    \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0435\u0439.  *   **\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    \u0424\u043B\u0438\u043D\u0434\u0435\u0440\u0441\u0430 (\u0410\u0432\u0441\u0442\u0440\u0430\u043B\u0438\u044F)**:    
    *   \u0412 14 \u043B\u0435\u0442 \u043E\u043D \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 \u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442
    (Research Science Institute).     *   **\u0412 1991 \u0433\u043E\u0434\u0443,
    \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 16 \u043B\u0435\u0442**,
    \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0442\u0435\u043F\u0435\u043D\u044C
    \u0431\u0430\u043A\u0430\u043B\u0430\u0432\u0440\u0430, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0438 \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430 \u0432 \u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0424\u043B\u0438\u043D\u0434\u0435\u0440\u0441\u0430 \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430 \u0413\u0430\u0440\u0442\u0430
    \u0413\u043E\u0434\u0440\u0438. *   **\u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 (\u0421\u0428\u0410)**:    
    *   \u0412 1992 \u0433\u043E\u0434\u0443 \u043E\u043D \u0432\u044B\u0438\u0433\u0440\u0430\u043B
    \u0441\u0442\u0438\u043F\u0435\u043D\u0434\u0438\u044E \u0424\u0443\u043B\u0431\u0440\u0430\u0439\u0442\u0430
    \u0434\u043B\u044F \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F \u0432 \u0430\u0441\u043F\u0438\u0440\u0430\u043D\u0442\u0443\u0440\u0435
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0441\u043A\u043E\u0433\u043E
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.    
    *   \u042D\u0442\u043E \u0431\u044B\u043B \u0432\u0430\u0436\u043D\u044B\u0439
    \u044D\u0442\u0430\u043F \u0432 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438:
    \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u043A\u0438\u043D\u0443\u0432
    \u0410\u0432\u0441\u0442\u0440\u0430\u043B\u0438\u044E, \u043E\u043D \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F
    \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C\u0438 \u0431\u044B\u0442\u043E\u0432\u044B\u043C\u0438
    \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u044F\u043C\u0438, \u0438 \u0435\u0433\u043E
    \u043E\u0442\u0435\u0446 \u043F\u043E\u043C\u043E\u0433\u0430\u043B \u0435\u043C\u0443
    \u043E\u0431\u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F, \u0443\u0447\u0438\u043B
    \u0441\u0442\u0438\u0440\u0430\u0442\u044C \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C
    \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u0438\u0439 \u0441\u0447\u0435\u0442.    
    *   \u0412 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 \u043E\u043D
    \u0443\u0447\u0438\u043B\u0441\u044F \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    **\u042D\u043B\u0438\u0430\u0441\u0430 \u0421\u0442\u0435\u0439\u043D\u0430**.    
    *   **\u041F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442**:
    \u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0443\u0447\u0435\u0431\u044B \u0422\u0435\u0440\u0435\u043D\u0441
    \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F \u0441 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C
    \u0432\u044B\u0437\u043E\u0432\u043E\u043C. \u041F\u0440\u0438\u0432\u044B\u043A\u0448\u0438\u0439
    \u043B\u0435\u0433\u043A\u043E \u0443\u0441\u0432\u0430\u0438\u0432\u0430\u0442\u044C
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B, \u043E\u043D \u043F\u043E\u0447\u0442\u0438
    \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B \u043A\u0432\u0430\u043B\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u044D\u043A\u0437\u0430\u043C\u0435\u043D, \u0443\u0434\u0435\u043B\u044F\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u043E\u0439 \u0438\u0433\u0440\u0435
    \"Civilization\", \u0447\u0435\u043C \u0443\u0447\u0435\u0431\u0435. \u042D\u0442\u043E
    \u0441\u0442\u0430\u043B\u043E \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u043E\u0442\u0440\u0435\u0437\u0432\u043B\u044F\u044E\u0449\u0438\u043C
    \u043E\u043F\u044B\u0442\u043E\u043C \u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E
    \u0435\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434 \u043A \u0440\u0430\u0431\u043E\u0442\u0435.    
    *   **\u0412 1996 \u0433\u043E\u0434\u0443, \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    21 \u0433\u043E\u0434\u0430**, \u043E\u043D \u0437\u0430\u0449\u0438\u0442\u0438\u043B
    \u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E
    (Ph.D.).  ### \u0420\u0430\u0431\u043E\u0442\u0430 \u0438 \u043D\u0430\u0443\u0447\u043D\u043E\u0435
    \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435 \U0001F3C6  \u041F\u043E\u0441\u043B\u0435
    \u0437\u0430\u0449\u0438\u0442\u044B \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438
    \u043A\u0430\u0440\u044C\u0435\u0440\u0430 \u0422\u0430\u043E \u043F\u043E\u0448\u043B\u0430
    \u043F\u043E \u0432\u043E\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0439 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438. 
    *   **\u041D\u0430\u0447\u0430\u043B\u043E \u0432 UCLA**:     *   \u0412 1996
    \u0433\u043E\u0434\u0443, \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    21 \u0433\u043E\u0434\u0430, \u043E\u043D \u043D\u0430\u0447\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0432 \u041A\u0430\u043B\u0438\u0444\u043E\u0440\u043D\u0438\u0439\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0432
    \u041B\u043E\u0441-\u0410\u043D\u0434\u0436\u0435\u043B\u0435\u0441\u0435 (UCLA).    
    *   **\u0412 1999 \u0433\u043E\u0434\u0443, \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    24 \u043B\u0435\u0442**, \u043E\u043D \u0441\u0442\u0430\u043B \u0441\u0430\u043C\u044B\u043C
    \u043C\u043E\u043B\u043E\u0434\u044B\u043C \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    (full professor) \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 UCLA, \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u0438\u0432
    \u043A\u0430\u0444\u0435\u0434\u0440\u0443 \u0414\u0436\u0435\u0439\u043C\u0441\u0430
    \u0438 \u041A\u044D\u0440\u043E\u043B \u041A\u043E\u043B\u043B\u0438\u043D\u0437.
    *   **\"\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A-\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\"**:    
    \u0422\u0430\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u0441\u0432\u043E\u0435\u0439
    \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0439 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E
    \u0438 \u0448\u0438\u0440\u043E\u0442\u043E\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432.
    \u0415\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0442
    \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043D\u0430\u043B\u0438\u0437, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F \u0432 \u0447\u0430\u0441\u0442\u043D\u044B\u0445
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u043D\u044B\u0445, \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0442\u043E\u0440\u0438\u043A\u0443,
    \u0442\u0435\u043E\u0440\u0438\u044E \u0447\u0438\u0441\u0435\u043B, \u0442\u0435\u043E\u0440\u0438\u044E
    \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0435\u0439, \u0442\u0435\u043E\u0440\u0438\u044E
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439
    \u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438. \u0415\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u0433\u0438
    \u0447\u0430\u0441\u0442\u043E \u043E\u0442\u043C\u0435\u0447\u0430\u044E\u0442,
    \u0447\u0442\u043E \u0442\u0430\u043A\u0438\u0445 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0445
    \u0437\u043D\u0430\u043D\u0438\u0439 \u043D\u0435 \u0431\u044B\u043B\u043E \u0441\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D \u0414\u0430\u0432\u0438\u0434\u0430 \u0413\u0438\u043B\u044C\u0431\u0435\u0440\u0442\u0430.
    *   **\u0412\u0435\u0440\u0448\u0438\u043D\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u044F**:    
    *   **\u0424\u0438\u043B\u0434\u0441\u043E\u0432\u0441\u043A\u0430\u044F \u043F\u0440\u0435\u043C\u0438\u044F
    (2006)**: \u0412 31 \u0433\u043E\u0434 \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0441\u0430\u043C\u0443\u044E \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u0443\u044E
    \u043D\u0430\u0433\u0440\u0430\u0434\u0443 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435.    
    *   **\u0413\u0440\u0430\u043D\u0442 \u0424\u043E\u043D\u0434\u0430 \u041C\u0430\u043A-\u0410\u0440\u0442\u0443\u0440\u043E\u0432
    (\"\u0413\u0440\u0430\u043D\u0442 \u0434\u043B\u044F \u0433\u0435\u043D\u0438\u0435\u0432\")
    (2006)**.     *   **\u041F\u0440\u0435\u043C\u0438\u044F \u041A\u0440\u0430\u0444\u043E\u0440\u0434\u0430
    (2012)**.     *   **\u041F\u0440\u043E\u0440\u044B\u0432\u043D\u0430\u044F \u043F\u0440\u0435\u043C\u0438\u044F
    \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 (Breakthrough
    Prize) (2014)**. *   **\u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430**: \u0412
    2021 \u0433\u043E\u0434\u0443 \u043E\u043D \u0431\u044B\u043B \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
    \u0447\u043B\u0435\u043D\u043E\u043C \u041F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u0432\u0435\u0442\u0430 \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u0432
    \u043F\u043E \u043D\u0430\u0443\u043A\u0435 \u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F\u043C
    (PCAST) \u043F\u0440\u0438 \u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u0435
    \u0421\u0428\u0410.  ### \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0443\u0447\u0451\u043D\u044B\u043C\u0438
    \U0001F91D  \u0422\u0435\u0440\u0435\u043D\u0441 \u0422\u0430\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0432\u043E\u0438\u043C\u0438
    \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F\u043C\u0438, \u043D\u043E
    \u0438 \u043D\u0435\u043E\u0431\u044B\u0447\u0430\u0439\u043D\u043E \u0448\u0438\u0440\u043E\u043A\u043E\u0439
    \u0441\u0435\u0442\u044C\u044E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430.
    \u041A 2006 \u0433\u043E\u0434\u0443 \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C \u0441 30 \u0441\u043E\u0430\u0432\u0442\u043E\u0440\u0430\u043C\u0438,
    \u0430 \u043A 2015 \u0433\u043E\u0434\u0443 \u0438\u0445 \u0447\u0438\u0441\u043B\u043E
    \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u043E 68.  *   **\u041A\u043B\u044E\u0447\u0435\u0432\u043E\u0439
    \u043F\u0430\u0440\u0442\u043D\u0451\u0440: \u0411\u0435\u043D \u0413\u0440\u0438\u043D**:    
    \u0418\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u043C.
    \u0412\u043C\u0435\u0441\u0442\u0435 \u043E\u043D\u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u043B\u0438
    **\u0442\u0435\u043E\u0440\u0435\u043C\u0443 \u0413\u0440\u0438\u043D\u0430-\u0422\u0430\u043E**
    (\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435
    \u0441\u043A\u043E\u043B\u044C \u0443\u0433\u043E\u0434\u043D\u043E \u0434\u043B\u0438\u043D\u043D\u044B\u0445
    \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0438\u0439 \u0438\u0437 \u043F\u0440\u043E\u0441\u0442\u044B\u0445
    \u0447\u0438\u0441\u0435\u043B), \u0447\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u0445
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439 \u0432 \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B XXI \u0432\u0435\u043A\u0430. \u041F\u043E\u0437\u0436\u0435
    \u043E\u043D\u0438 \u0442\u0430\u043A\u0436\u0435 \u0440\u0435\u0448\u0438\u043B\u0438
    \"\u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443 \u043F\u043E\u0441\u0430\u0434\u043A\u0438
    \u0444\u0440\u0443\u043A\u0442\u043E\u0432\u043E\u0433\u043E \u0441\u0430\u0434\u0430\"
    (orchard-planting problem). *   **\u041C\u043D\u0435\u043D\u0438\u0435 \u043A\u043E\u043B\u043B\u0435\u0433**:    
    *   \u041F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0430
    \u0438 \u043B\u0430\u0443\u0440\u0435\u0430\u0442 \u0424\u0438\u043B\u0434\u0441\u043E\u0432\u0441\u043A\u043E\u0439
    \u043F\u0440\u0435\u043C\u0438\u0438 **\u0427\u0430\u0440\u043B\u044C\u0437 \u0424\u0435\u0444\u0444\u0435\u0440\u043C\u0430\u043D**
    \u0441\u043A\u0430\u0437\u0430\u043B \u043E \u043D\u0451\u043C: *\"\u0415\u0441\u043B\u0438
    \u0432\u044B \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438 \u043D\u0430 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0435,
    \u0442\u043E \u043E\u0434\u0438\u043D \u0438\u0437 \u0432\u044B\u0445\u043E\u0434\u043E\u0432
    \u2014 \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u0442\u044C
    \u0422\u0435\u0440\u0435\u043D\u0441\u0430 \u0422\u0430\u043E\"*.     *   **\u0422\u0438\u043C\u043E\u0442\u0438
    \u0413\u0430\u0443\u044D\u0440\u0441**, \u0435\u0449\u0451 \u043E\u0434\u0438\u043D
    \u043B\u0430\u0443\u0440\u0435\u0430\u0442 \u0424\u0438\u043B\u0434\u0441\u043E\u0432\u0441\u043A\u043E\u0439
    \u043F\u0440\u0435\u043C\u0438\u0438, \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442
    \u043F\u043E\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u0448\u0438\u0440\u043E\u0442\u0443 \u0435\u0433\u043E \u0437\u043D\u0430\u043D\u0438\u0439:
    \u0422\u0430\u043E \u043C\u043E\u0436\u0435\u0442 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E
    \u043F\u0438\u0441\u0430\u0442\u044C \u043D\u0430 \u0442\u0430\u043A\u0438\u0435
    \u0440\u0430\u0437\u043D\u044B\u0435 \u0442\u0435\u043C\u044B, \u043A\u0430\u043A
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F \u0432 \u0447\u0430\u0441\u0442\u043D\u044B\u0445
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u043D\u044B\u0445, \u0442\u0435\u043E\u0440\u0438\u044F
    \u0447\u0438\u0441\u0435\u043B, \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F
    3-\u043C\u043D\u043E\u0433\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0439, \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u0430\u044F
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 \u0438 \u043C\u043D\u043E\u0433\u0438\u0435
    \u0434\u0440\u0443\u0433\u0438\u0435, \u043F\u0440\u0438\u0447\u0451\u043C \u043D\u0430
    \u0443\u0440\u043E\u0432\u043D\u0435 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0433\u043E
    \u0438\u043D\u0442\u0443\u0438\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F
    \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0430.  ### \u041B\u0438\u0447\u043D\u0430\u044F
    \u0436\u0438\u0437\u043D\u044C: \"\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A
    \u2014 \u044D\u0442\u043E \u043C\u043E\u044F \u0438\u0434\u0435\u043D\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C\"
    \u2764\uFE0F  *   **\u0421\u0435\u043C\u044C\u044F**: \u0412 2002 \u0433\u043E\u0434\u0443
    \u0422\u0435\u0440\u0435\u043D\u0441 \u0436\u0435\u043D\u0438\u043B\u0441\u044F
    \u043D\u0430 **\u041B\u0430\u0443\u0440\u0435**, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C-\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u043E\u043C
    \u0432 \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u0440\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u041D\u0410\u0421\u0410. \u0423
    \u043D\u0438\u0445 \u0434\u0432\u043E\u0435 \u0434\u0435\u0442\u0435\u0439, \u0438
    \u043E\u043D\u0438 \u0436\u0438\u0432\u0443\u0442 \u0432 \u041B\u043E\u0441-\u0410\u043D\u0434\u0436\u0435\u043B\u0435\u0441\u0435.
    *   **\u0414\u0432\u043E\u0439\u043D\u043E\u0435 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u0442\u0432\u043E**:
    \u0422\u0430\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u0442\u0432\u043E
    \u0410\u0432\u0441\u0442\u0440\u0430\u043B\u0438\u0438 \u0438 \u0432 2009 \u0433\u043E\u0434\u0443
    \u0442\u0430\u043A\u0436\u0435 \u0441\u0442\u0430\u043B \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0438\u043D\u043E\u043C
    \u0421\u0428\u0410. \u0412 \u044D\u0441\u0441\u0435 \u0434\u043B\u044F CNN \u043E\u043D
    \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0435\u0433\u043E \u0438\u0434\u0435\u043D\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C
    \u2014 \u044D\u0442\u043E \"\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\",
    \u0434\u0430\u0436\u0435 \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430
    \u0442\u043E, \u0447\u0442\u043E \u043E\u043D \u0433\u043E\u0440\u0434\u044B\u0439
    \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0438\u043D \u0434\u0432\u0443\u0445
    \u0441\u0442\u0440\u0430\u043D, \u043C\u0443\u0436 \u0438 \u043E\u0442\u0435\u0446.
    *   **\u041F\u043E\u043F\u0443\u043B\u044F\u0440\u0438\u0437\u0430\u0442\u043E\u0440
    \u043D\u0430\u0443\u043A\u0438**: \u041E\u043D \u0432\u0435\u0434\u0435\u0442
    \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0431\u043B\u043E\u0433\u043E\u0432 **\"What's New\"**, \u0433\u0434\u0435 \u0434\u0435\u043B\u0438\u0442\u0441\u044F
    \u043C\u044B\u0441\u043B\u044F\u043C\u0438 \u043E \u0442\u0435\u043A\u0443\u0449\u0438\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u0445
    \u0438 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u0438\u0437\u0438\u0440\u0443\u0435\u0442
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443. \u042D\u0442\u043E
    \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u0445
    \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445 \u0434\u043B\u044F
    \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u043A\u0440\u0443\u043F\u043D\u044B\u0445
    \u0443\u0447\u0435\u043D\u044B\u0445 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0438.
    *   **\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0418\u0418**: \u0422\u0430\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435.
    \u041E\u043D \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u0445
    \u043F\u043E \u0444\u043E\u0440\u043C\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0418\u0418 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u044F\u0437\u044B\u043A\u0430 Lean) \u0438 \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0438\u0440\u0443\u0435\u0442
    \u043A\u043E\u043C\u0430\u043D\u0434\u044B, \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0435
    AI-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u043E\u0432 \u0434\u043B\u044F
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432.  ### \u0421\u043C\u0435\u0440\u0442\u044C 
    **\u0422\u0435\u0440\u0435\u043D\u0441 \u0422\u0430\u043E \u0436\u0438\u0432,
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442 \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0438 \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u043F\u043E
    \u0441\u0435\u0439 \u0434\u0435\u043D\u044C.**"
  personalLifeEn: 
  shortBioRu: "**\u0422\u0435\u0440\u0435\u043D\u0441 \u0422\u0430\u043E (\u9676\u54F2\u8F69)
    \u2014 \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0445\u0441\u044F
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432,
    \u0447\u0435\u0439 \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
    \u0443\u043D\u0438\u043A\u0430\u043B\u0435\u043D: \u043E\u0442 \u0432\u0443\u043D\u0434\u0435\u0440\u043A\u0438\u043D\u0434\u0430,
    \u043F\u043E\u0431\u0438\u0432\u0448\u0435\u0433\u043E \u0432\u0441\u0435 \u0440\u0435\u043A\u043E\u0440\u0434\u044B
    \u043D\u0430 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u043E\u043B\u0438\u043C\u043F\u0438\u0430\u0434\u0430\u0445, \u0434\u043E \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430
    \u0438 \u043B\u0430\u0443\u0440\u0435\u0430\u0442\u0430 \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u0435\u0439\u0448\u0435\u0439
    \u0424\u0438\u043B\u0434\u0441\u043E\u0432\u0441\u043A\u043E\u0439 \u043F\u0440\u0435\u043C\u0438\u0438.
    \u0412\u043E\u0442 \u0435\u0433\u043E \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0430\u044F
    \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F.**  ### \u0414\u0435\u0442\u0441\u0442\u0432\u043E
    \u0438 \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438  \u0422\u0435\u0440\u0435\u043D\u0441
    \u0422\u0430\u043E \u0440\u043E\u0434\u0438\u043B\u0441\u044F **17 \u0438\u044E\u043B\u044F
    1975 \u0433\u043E\u0434\u0430** \u0432 \u0410\u0434\u0435\u043B\u0430\u0438\u0434\u0435,
    \u0410\u0432\u0441\u0442\u0440\u0430\u043B\u0438\u044F, \u0432 \u0441\u0435\u043C\u044C\u0435
    \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0445 \u0438\u043C\u043C\u0438\u0433\u0440\u0430\u043D\u0442\u043E\u0432
    \u0438\u0437 \u0413\u043E\u043D\u043A\u043E\u043D\u0433\u0430. \u0415\u0433\u043E
    \u043E\u0442\u0435\u0446, \u0423\u0438\u043B\u044C\u044F\u043C \u0420\u044D\u043D\u0434\u043E\u043B\u044C\u0444
    \u0422\u0430\u043E (\u0422\u0430\u043E \u0421\u044F\u043D\u0433\u043E), \u0431\u044B\u043B
    \u043F\u0435\u0434\u0438\u0430\u0442\u0440\u043E\u043C, \u0430 \u043C\u0430\u0442\u044C,
    \u0413\u0440\u0435\u0439\u0441 \u041B\u0435\u043D\u0433 (\u041B\u044F\u043D \u0425\u0443\u044D\u0439\u043B\u0430\u043D\u044C),
    \u0438\u043C\u0435\u043B\u0430 \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u043F\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u0438 \u0444\u0438\u0437\u0438\u043A\u0435
    \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439
    \u0432 \u0448\u043A\u043E\u043B\u0435. \u0423 \u0422\u0435\u0440\u0435\u043D\u0441\u0430
    \u0435\u0441\u0442\u044C \u0434\u0432\u0430 \u0431\u0440\u0430\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438
    \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0435\u0441\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438:
    \u041D\u0430\u0439\u0434\u0436\u0435\u043B \u0438 \u0422\u0440\u0435\u0432\u043E\u0440
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0438 \u0410\u0432\u0441\u0442\u0440\u0430\u043B\u0438\u044E
    \u043D\u0430 \u041C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043E\u043B\u0438\u043C\u043F\u0438\u0430\u0434\u0435.  **\u0424\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0422\u0435\u0440\u0435\u043D\u0441\u0430
    \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0432 \u0440\u0430\u043D\u043D\u0435\u043C
    \u0434\u0435\u0442\u0441\u0442\u0432\u0435**: *   **\u0412 2 \u0433\u043E\u0434\u0430**
