  interestingFactsRu: "\u0417\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0444\u0430\u043A\u0442\u044B \u0438\u0437 \u0436\u0438\u0437\u043D\u0438 \u0422\u0435\u0440\u0435\u043D\u0441\u0430
    \u0422\u0430\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u0437\u0430 \u0440\u0430\u043C\u043A\u0438
    \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438
    \u0433\u0435\u043D\u0438\u044F. \u042D\u0442\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u0438,
    \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0430\u044E\u0442\u0441\u044F
    \u0442\u0440\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0434\u0435\u0442\u0441\u0442\u0432\u043E,
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u0438,
    \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u043F\u0440\u043E\u0440\u044B\u0432\u044B
    \u0438 \u0449\u0435\u043F\u043E\u0442\u043A\u0430 \u044E\u043C\u043E\u0440\u0430.
    \u0412\u043E\u0442 \u0441\u0430\u043C\u044B\u0435 \u044F\u0440\u043A\u0438\u0435
    \u0438\u0437 \u043D\u0438\u0445.  ### \U0001F9F8 \u041D\u0435\u043F\u043E\u0441\u043B\u0443\u0448\u043D\u044B\u0439
    \u0440\u0435\u0431\u0451\u043D\u043E\u043A \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0438 \u0435\u0433\u043E \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435 
    \u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u0441\u0430\u043C\u044B\u0439 \u044F\u0440\u043A\u0438\u0439
    \u044D\u043F\u0438\u0437\u043E\u0434 \u0438\u0437 \u0435\u0433\u043E \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u2014 \u044D\u0442\u043E \u0443\u0447\u0451\u0431\u0430 \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0432 9 \u043B\u0435\u0442. \u0412 \u0442\u043E \u0432\u0440\u0435\u043C\u044F
    \u0435\u0433\u043E \u043C\u0430\u043C\u0430 \u043E\u0442\u0432\u043E\u0437\u0438\u043B\u0430
    \u0435\u0433\u043E \u043D\u0430 \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u0432
    \u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0424\u043B\u0438\u043D\u0434\u0435\u0440\u0441\u0430,
    \u043D\u043E \u043E\u043D \u0431\u044B\u043B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u043C, \u0430 **\"\u0443\u0436\u0430\u0441\u043D\u043E
    \u0448\u0443\u043C\u043D\u044B\u043C \u0438 \u043D\u0430\u0434\u043E\u0435\u0434\u043B\u0438\u0432\u044B\u043C
    \u0440\u0435\u0431\u0451\u043D\u043A\u043E\u043C\"**. \u041E\u043D \u0441\u0438\u0434\u0435\u043B
    \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u0430\u0440\u0442\u0435,
    \u0437\u0430\u0434\u0430\u0432\u0430\u043B \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0435
    \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u0438, \u0447\u0442\u043E \u0441\u0430\u043C\u043E\u0435
    \u043F\u043E\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435,
    **\u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u0432\u044B\u0445\u043E\u0434\u0438\u043B
    \u043A \u0434\u043E\u0441\u043A\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u0442\u044C
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F**.
    \u0421\u0430\u043C \u0422\u0430\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442\u0441\u044F,
    \u0447\u0442\u043E \u0431\u044B\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u044E\u043D, \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u043E\u0437\u043D\u0430\u0432\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u0441\u043C\u0443\u0449\u0435\u043D\u0438\u0435,
    \u0438 \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B \u044D\u0442\u043E
    \u043A\u0430\u043A \u043D\u043E\u0440\u043C\u0443.  \u0415\u0449\u0451 \u0431\u043E\u043B\u0435\u0435
    \u0437\u0430\u0431\u0430\u0432\u043D\u044B\u043C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
    \u0441\u043F\u043E\u0441\u043E\u0431, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u0435\u0433\u043E \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0438\u0441\u044C
    \u0441 \u0435\u0433\u043E \u043D\u0435\u0443\u0451\u043C\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439:
    \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
    \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u0443\u0439\u043D\u044B\u043C,
    \u0435\u043C\u0443 \u0434\u0430\u0432\u0430\u043B\u0438 **\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0442\u0435\u0442\u0440\u0430\u0434\u044C, \u0447\u0442\u043E\u0431\u044B \u043E\u043D
    \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0441\u044F**. \u0414\u043B\u044F
    \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430 \u0434\u0435\u0442\u0435\u0439
    \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435\u043C,
    \u0430 \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u2014 \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C
    \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043C\u044B\u0441\u043B\u0438
    \u0432 \u043F\u043E\u0440\u044F\u0434\u043E\u043A.  ### \U0001F3AE \"\u041C\u043E\u0446\u0430\u0440\u0442
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438\" \u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u0430\u044F
    \u0438\u0433\u0440\u0430  \u0421\u0432\u043E\u0451 \u043F\u0435\u0440\u0432\u043E\u0435
    \"\u0444\u0438\u0430\u0441\u043A\u043E\" \u0432 \u0443\u0447\u0451\u0431\u0435
    \u0422\u0430\u043E \u043F\u043E\u0442\u0435\u0440\u043F\u0435\u043B \u043D\u0435
    \u0438\u0437-\u0437\u0430 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430, \u0430 \u0438\u0437-\u0437\u0430
    \u0432\u0438\u0434\u0435\u043E\u0438\u0433\u0440\u044B **Civilization**. \u041F\u043E\u0441\u0442\u0443\u043F\u0438\u0432
    \u0432 \u0430\u0441\u043F\u0438\u0440\u0430\u043D\u0442\u0443\u0440\u0443 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0430,
    \u043E\u043D \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0432\u043B\u0451\u043A\u0441\u044F
    \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u043E\u0439, \u0447\u0442\u043E \u0435\u0434\u0432\u0430
    \u043D\u0435 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B \u043A\u0432\u0430\u043B\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u044D\u043A\u0437\u0430\u043C\u0435\u043D. \u042D\u0442\u043E\u0442 \u0441\u043B\u0443\u0447\u0430\u0439
    \u0441\u0442\u0430\u043B \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u043E\u0442\u0440\u0435\u0437\u0432\u043B\u044F\u044E\u0449\u0438\u043C
    \u0443\u0440\u043E\u043A\u043E\u043C: \u043E\u043D \u043E\u0441\u043E\u0437\u043D\u0430\u043B,
    \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0443\u043C \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B.
    \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E \u0441\u043F\u0443\u0441\u0442\u044F
    \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F \u0418\u0418
    \u043F\u043E\u043C\u043E\u0433 \u0435\u043C\u0443 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C
    \u0447\u0430\u0441\u044B \u0440\u0430\u0431\u043E\u0442\u044B, \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u044F
    \u043A\u043E\u0434 \u043D\u0430 Python  \u2014 \u0442\u0430\u043A \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438
    \u0438\u0437 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0439
    \u0441\u0442\u0430\u043B\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C
    \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B.  ### \U0001F9E0 IQ 230
    \u0438 \u043F\u0440\u043E\u0437\u0432\u0438\u0449\u0435 \"\u041C\u043E\u0446\u0430\u0440\u0442\" 
    IQ \u0422\u0435\u0440\u0435\u043D\u0441\u0430 \u0422\u0430\u043E \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 **230 \u0431\u0430\u043B\u043B\u043E\u0432**, \u0447\u0442\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
