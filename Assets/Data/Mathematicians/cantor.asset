  achievementsRu: "\u0415\u0441\u043b\u0438 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0413\u0435\u043e\u0440\u0433\u0430
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u2014 \u044d\u0442\u043e \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f
    \u0433\u0435\u043d\u0438\u044f, \u0442\u043e \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0438 \u0432\u043a\u043b\u0430\u0434 \u0432 \u043d\u0430\u0443\u043a\u0443 \u2014 \u044d\u0442\u043e
    \u043f\u043e\u0434\u043b\u0438\u043d\u043d\u0430\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f,
    \u0441\u0440\u0430\u0432\u043d\u0438\u043c\u0430\u044f \u0441 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043c
    \u043d\u0435\u0435\u0432\u043a\u043b\u0438\u0434\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438\u043b\u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u041a\u0430\u043d\u0442\u043e\u0440 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b
    \u043d\u043e\u0432\u044b\u0439 \u0440\u0430\u0437\u0434\u0435\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438;
    \u043e\u043d \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u0441\u0430\u043c\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c,
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432 \u0435\u0451 \u0438\u0437 \u0442\u0443\u043c\u0430\u043d\u043d\u043e\u0433\u043e
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043d\u044f\u0442\u0438\u044f
    \u0432 \u0441\u0442\u0440\u043e\u0433\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043e\u0431\u044a\u0435\u043a\u0442. \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d
    \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u0440\u0430\u0437\u0431\u043e\u0440 \u0435\u0433\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445
    \u0432 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e-\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043f\u043e\u0440\u044f\u0434\u043a\u0435. 1. \u0421\u0442\u0440\u043e\u0433\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 (1870\u20131872) \u0414\u043e \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043e\u043f\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0438
    \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0447\u0438\u0441\u043b\u0430\u043c\u0438 (\\( \\sqrt{2}, \\pi, e \\)), \u043d\u043e \u043d\u0435
    \u0438\u043c\u0435\u043b\u0438 \u0438\u0445 \u0441\u0442\u0440\u043e\u0433\u043e\u0433\u043e
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f. \u0412 \u0441\u0432\u043e\u0435\u0439
    \u0440\u0430\u043d\u043d\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u041a\u0430\u043d\u0442\u043e\u0440
    \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0442\u0435\u043e\u0440\u0438\u044e
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0421\u0443\u0442\u044c: \u041e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e
    \u043a\u0430\u043a \u043f\u0440\u0435\u0434\u0435\u043b \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u00ab\u0441\u0442\u044f\u0433\u0438\u0432\u0430\u044e\u0442\u0441\u044f\u00bb
    \u0434\u0440\u0443\u0433 \u043a \u0434\u0440\u0443\u0433\u0443 (\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u041a\u043e\u0448\u0438). \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u043e
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u043d\u0430 \u043f\u0440\u043e\u0447\u043d\u043e\u043c \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0435, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e
    \u043e\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 (\u043a\u0430\u043a
    \u0443 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430). \u042d\u0442\u043e \u0431\u044b\u043b\u043e
    \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e\u0435
    \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u0435 \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u0432 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0430\u043d\u0430\u043b\u0438\u0437\u0430.
    --- 2. \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0438 \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u00ab\u041c\u043e\u0449\u043d\u043e\u0441\u0442\u0438\u00bb (1874) \u042d\u0442\u043e \u2014
    \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043f\u0440\u043e\u0440\u044b\u0432 \u041a\u0430\u043d\u0442\u043e\u0440\u0430.
    \u041e\u043d \u0432\u0432\u0451\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u043a\u0430\u043a \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u00ab\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432\u00bb \u043d\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430. \u0414\u0432\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0438\u043c\u0435\u044e\u0442 \u0440\u0430\u0432\u043d\u0443\u044e \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c,
    \u0435\u0441\u043b\u0438 \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438 \u043c\u043e\u0436\u043d\u043e
    \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0432\u0437\u0430\u0438\u043c\u043d\u043e-\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0435
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 (\u0431\u0438\u0435\u043a\u0446\u0438\u044e).
    \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    1874 \u0433\u043e\u0434\u0430: \u041a\u0430\u043d\u0442\u043e\u0440 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0432\u0441\u0435\u0445
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0447\u0438\u0441\u0435\u043b
    (\u043a\u043e\u0440\u043d\u0435\u0439 \u043c\u043d\u043e\u0433\u043e\u0447\u043b\u0435\u043d\u043e\u0432
    \u0441 \u0446\u0435\u043b\u044b\u043c\u0438 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430\u043c\u0438)
    \u0441\u0447\u0451\u0442\u043d\u043e, \u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0432\u0441\u0435\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u2014 \u043d\u0435\u0441\u0447\u0451\u0442\u043d\u043e.
    \u041c\u0435\u0442\u043e\u0434 \u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438
    (1891): \u041f\u043e\u0437\u0436\u0435 \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e\u0439
    \u043c\u0435\u0442\u043e\u0434 \u00ab\u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430\u00bb, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0433\u043b\u044f\u0434\u043d\u043e
    \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0432\u0441\u0435\u0445 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0445
    \u0434\u0432\u043e\u0438\u0447\u043d\u044b\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0435\u0439
    (\u0430 \u0437\u043d\u0430\u0447\u0438\u0442, \u0438 \u0442\u043e\u0447\u0435\u043a \u043e\u0442\u0440\u0435\u0437\u043a\u0430)
    \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u0442\u044c
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438.
    \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434 \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043c\u043e\u0449\u043d\u0435\u0439\u0448\u0438\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432
    \u043b\u043e\u0433\u0438\u043a\u0438 \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432.
    --- 3. \u0418\u0435\u0440\u0430\u0440\u0445\u0438\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439:
    \u0422\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430
    (\u0410\u043b\u0435\u0444-\u043d\u0443\u043b\u044c \u0438 \u0434\u0430\u043b\u0435\u0435)
    \u041a\u0430\u043d\u0442\u043e\u0440 \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0431\u044b\u0432\u0430\u044e\u0442
    \u0440\u0430\u0437\u043d\u044b\u0445 \u00ab\u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432\u00bb
    (\u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0435\u0439). \u0421\u0447\u0451\u0442\u043d\u0430\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c: \u041c\u043e\u0449\u043d\u043e\u0441\u0442\u044c
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u044f\u0434\u0430
    (\\( \\mathbb{N} \\)) \u043e\u043d \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0438\u043b
    \u043a\u0430\u043a \\( \\aleph_0 \\) (\u00ab\u0430\u043b\u0435\u0444-\u043d\u0443\u043b\u044c\u00bb,
    \u043f\u0435\u0440\u0432\u0430\u044f \u0431\u0443\u043a\u0432\u0430 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0433\u043e
    \u0430\u043b\u0444\u0430\u0432\u0438\u0442\u0430). \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430
    \u0441\u0432\u043e\u044e \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u044c, \u0438\u043c\u0435\u0435\u0442
    \u0442\u0430\u043a\u0443\u044e \u0436\u0435 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c
    \\( \\aleph_0 \\). \u041c\u043e\u0449\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c\u0430:
    \u041c\u043e\u0449\u043d\u043e\u0441\u0442\u044c \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b (\\( \\mathbb{R} \\)) \u043e\u043d \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0438\u043b
    \u0431\u0443\u043a\u0432\u043e\u0439 \\( \\mathfrak{c} \\) (\u0438\u043b\u0438 \\( 2^{\\aleph_0}
    \\)). \u041e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \\( \\aleph_0
    < \\mathfrak{c} \\) (\u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c \u0441\u0442\u0440\u043e\u0433\u043e
    \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u0447\u0451\u0442\u043d\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430).
    \u0410\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0430 \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b\u043e\u0432:
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0441\u043e\u0437\u0434\u0430\u043b \u0446\u0435\u043b\u0443\u044e
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443 \u0434\u043b\u044f \u044d\u0442\u0438\u0445
    \u0447\u0438\u0441\u0435\u043b: \u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \\( \\aleph_0 + \\aleph_0 = \\aleph_0 \\) \u0438 \\( \\aleph_0 \\cdot
    \\aleph_0 = \\aleph_0 \\), \u043d\u043e \\( 2^{\\aleph_0} > \\aleph_0 \\). \u0418\u0435\u0440\u0430\u0440\u0445\u0438\u044f
    \u0430\u043b\u0435\u0444\u043e\u0432: \u041e\u043d \u0432\u0432\u0451\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \\( \\aleph_1, \\aleph_2, \\dots, \\aleph_\\omega \\) \u0438 \u0442.\u0434., \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0432
    \u0441\u0442\u0440\u043e\u0433\u0443\u044e \u0432\u043e\u0441\u0445\u043e\u0434\u044f\u0449\u0443\u044e
    \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0443 \u0432\u0441\u0451 \u0431\u043e\u043b\u0435\u0435
    \u043c\u043e\u0449\u043d\u044b\u0445 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439.
    --- 4. \u041a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430
    (CH) \u041f\u0440\u043e\u0432\u0435\u0434\u044f \u0433\u0440\u0430\u043d\u0438\u0446\u0443
    \u043c\u0435\u0436\u0434\u0443 \\( \\aleph_0 \\) \u0438 \\( \\mathfrak{c} \\) (\u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c\u043e\u043c),
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0437\u0430\u0434\u0430\u043b \u0441\u0430\u043a\u0440\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439
    \u0432\u043e\u043f\u0440\u043e\u0441: \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043b\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e, \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c
    \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u0442\u0440\u043e\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0435
    \\( \\aleph_0 \\), \u043d\u043e \u0441\u0442\u0440\u043e\u0433\u043e \u043c\u0435\u043d\u044c\u0448\u0435
    \\( \\mathfrak{c} \\)? \u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430: \u041a\u0430\u043d\u0442\u043e\u0440
    \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b, \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0439
    \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438
    \u043d\u0435\u0442, \u0442\u043e \u0435\u0441\u0442\u044c \\( \\mathfrak{c} = \\aleph_1
    \\). \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u041a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c-\u0433\u0438\u043f\u043e\u0442\u0435\u0437\u043e\u0439.
    \u0421\u0443\u0434\u044c\u0431\u0430 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b: \u042d\u0442\u043e
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432\u043e\u043f\u0440\u043e\u0441
    \u0438\u0437 \u0441\u043f\u0438\u0441\u043a\u0430 \u00ab\u041f\u0440\u043e\u0431\u043b\u0435\u043c
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442\u0430\u00bb (\u21161), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f\u043c\u0438 \u043c\u0443\u0447\u0438\u043b
    \u0443\u043c\u044b. \u041b\u0438\u0448\u044c \u0432 1963 \u0433\u043e\u0434\u0443 \u041f\u043e\u043b
    \u041a\u043e\u044d\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e
    \u044d\u0442\u0443 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0443 \u043d\u0435\u043b\u044c\u0437\u044f
    \u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u043d\u0438 \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c
    \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439
    \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u043a\u0438 \u0426\u0435\u0440\u043c\u0435\u043b\u043e-\u0424\u0440\u0435\u043d\u043a\u0435\u043b\u044f
    (ZFC). \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u043b\u043e
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043e \u043f\u0440\u0438\u0440\u043e\u0434\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0442\u0438\u043d,
    \u043d\u043e \u043d\u0430\u0447\u0430\u043b\u043e\u0441\u044c \u0432\u0441\u0451 \u0441
    \u0434\u043e\u0433\u0430\u0434\u043a\u0438 \u041a\u0430\u043d\u0442\u043e\u0440\u0430. ---
    5. \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438
    (\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043e\u0442\u0440\u0435\u0437\u043a\u0430
    \u0432 \u043a\u0432\u0430\u0434\u0440\u0430\u0442, 1877) \u042d\u0442\u043e \u043e\u0434\u043d\u043e
    \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043a\u043e\u043d\u0442\u0440\u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u044b\u0445
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439 \u041a\u0430\u043d\u0442\u043e\u0440\u0430,
    \u0432\u044b\u0437\u0432\u0430\u0432\u0448\u0435\u0435 \u0448\u043e\u043a \u0443 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432.
    \u0421\u0443\u0442\u044c: \u041a\u0430\u043d\u0442\u043e\u0440 \u0434\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043c\u0435\u0436\u0434\u0443 \u0442\u043e\u0447\u043a\u0430\u043c\u0438
    \u043e\u0442\u0440\u0435\u0437\u043a\u0430 \u043f\u0440\u044f\u043c\u043e\u0439 (\u043e\u0434\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u0439
    \u043e\u0431\u044a\u0435\u043a\u0442) \u0438 \u0442\u043e\u0447\u043a\u0430\u043c\u0438
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430 (\u0434\u0432\u0443\u043c\u0435\u0440\u043d\u044b\u0439
    \u043e\u0431\u044a\u0435\u043a\u0442) \u043c\u043e\u0436\u043d\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c
    \u0432\u0437\u0430\u0438\u043c\u043d\u043e-\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0435
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435. \u0424\u043e\u0440\u043c\u0443\u043b\u0430:
    \u041e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u043e\u0432\u0430\u043b \u0444\u0443\u043d\u043a\u0446\u0438\u044e
    \\( f(x, y) \\), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043a\u043e\u0434\u0438\u0440\u0443\u0435\u0442
    \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b \u0434\u0432\u0443\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0432 \u043e\u0434\u043d\u043e \u0447\u0438\u0441\u043b\u043e \u0447\u0435\u0440\u0435\u0437
    \u043f\u0435\u0440\u0435\u043c\u0435\u0448\u0438\u0432\u0430\u043d\u0438\u0435 \u0434\u0435\u0441\u044f\u0442\u0438\u0447\u043d\u044b\u0445
    \u0437\u043d\u0430\u043a\u043e\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \\( 0.a_1a_2a_3... \\) \u0438 \\( 0.b_1b_2b_3... \\) \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044e\u0442\u0441\u044f
    \u0432 \\( 0.a_1b_1a_2b_2... \\)). \u0412\u044b\u0432\u043e\u0434: \u041e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0442\u043e\u0447\u0435\u043a \u043f\u0440\u044f\u043c\u043e\u0439, \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438
    \u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u0430
    (\\( \\mathfrak{c} \\)). \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e,
    \u0447\u0442\u043e \u00ab\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c\u00bb
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 (1D, 2D, 3D) \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f
    \u043d\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u0442\u043e\u0447\u0435\u043a,
    \u0430 \u0438\u0445 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 (\u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u044c\u044e).
    \u042d\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e
    \u043f\u043e\u0434\u0432\u0435\u043b\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0442\u0435\u043e\u0440\u0438\u0438
    \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438 \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438.
    --- 6. \u041a\u0430\u043d\u0442\u043e\u0440\u043e\u0432\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    (\u041a\u0430\u043d\u0442\u043e\u0440\u043e\u0432\u0441\u043a\u0430\u044f \u043f\u044b\u043b\u044c,
    1883) \u0412 \u0445\u043e\u0434\u0435 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u041a\u0430\u043d\u0442\u043e\u0440 \u0441\u043e\u0437\u0434\u0430\u043b
    \u00ab\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u00bb \u2014 \u043e\u0434\u0438\u043d \u0438\u0437
    \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432 \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u043e\u0432
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u041f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435:
    \u0411\u0435\u0440\u0435\u0442\u0441\u044f \u043e\u0442\u0440\u0435\u0437\u043e\u043a [0,1].
    \u0418\u0437 \u043d\u0435\u0433\u043e \u0443\u0434\u0430\u043b\u044f\u0435\u0442\u0441\u044f
    \u0441\u0440\u0435\u0434\u043d\u044f\u044f \u0442\u0440\u0435\u0442\u044c (\u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f
    [0, 1/3] \u0438 [2/3, 1]). \u0417\u0430\u0442\u0435\u043c \u0443\u0434\u0430\u043b\u044f\u0435\u0442\u0441\u044f
    \u0441\u0440\u0435\u0434\u043d\u044f\u044f \u0442\u0440\u0435\u0442\u044c \u0438\u0437 \u043a\u0430\u0436\u0434\u043e\u0433\u043e
    \u043e\u0441\u0442\u0430\u0432\u0448\u0435\u0433\u043e\u0441\u044f \u043e\u0442\u0440\u0435\u0437\u043a\u0430,
    \u0438 \u0442\u0430\u043a \u0434\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438.
    \u0421\u0432\u043e\u0439\u0441\u0442\u0432\u0430: 1. \u042d\u0442\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u043d\u0438\u0433\u0434\u0435 \u043d\u0435 \u043f\u043b\u043e\u0442\u043d\u043e (\u043d\u0435
    \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e
    \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430). 2. \u041e\u043d\u043e \u0438\u043c\u0435\u0435\u0442
    \u043d\u0443\u043b\u0435\u0432\u0443\u044e \u043c\u0435\u0440\u0443 (\u0435\u0433\u043e
    \u0434\u043b\u0438\u043d\u0430 \u0440\u0430\u0432\u043d\u0430 0). 3. \u041f\u0440\u0438
    \u044d\u0442\u043e\u043c \u043e\u043d\u043e \u0438\u043c\u0435\u0435\u0442 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c
    \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c (\\( \\mathfrak{c} \\))! \u0422\u043e
    \u0435\u0441\u0442\u044c, \u0432 \u043d\u0451\u043c \u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0436\u0435 \u0442\u043e\u0447\u0435\u043a, \u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0432\u043e \u0432\u0441\u0451\u043c \u043e\u0442\u0440\u0435\u0437\u043a\u0435, \u0445\u043e\u0442\u044f
    \u0441\u0443\u043c\u043c\u0430\u0440\u043d\u0430\u044f \u0434\u043b\u0438\u043d\u0430 \u0435\u0433\u043e
    \u043e\u0442\u0440\u0435\u0437\u043a\u043e\u0432 \u0440\u0430\u0432\u043d\u0430 \u043d\u0443\u043b\u044e.
    \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435: \u042d\u0442\u043e \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043b\u043e
    \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u00ab\u0440\u0430\u0437 \u0434\u043b\u0438\u043d\u0430
    \u0440\u0430\u0432\u043d\u0430 \u043d\u0443\u043b\u044e, \u0437\u043d\u0430\u0447\u0438\u0442
    \u0442\u043e\u0447\u0435\u043a \u043c\u0430\u043b\u043e\u00bb. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043e\u0442\u043f\u0440\u0430\u0432\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u043e\u0439
    \u0434\u043b\u044f \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0435\u0440\u044b \u0438
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b\u0430 \u041b\u0435\u0431\u0435\u0433\u0430.
    --- 7. \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f \u0438 \u00ab\u041f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0435
    \u0442\u043e\u0447\u043a\u0438\u00bb (\u0422\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432) \u0412 1872\u20131884 \u0433\u043e\u0434\u0430\u0445
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u0441\u043b\u043e\u0436\u043d\u0443\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u0442\u043e\u0447\u0435\u0447\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u043d\u0430 \u043f\u0440\u044f\u043c\u043e\u0439.
    \u041e\u043d \u0432\u0432\u0451\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435 \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u0438 (\u0442\u043e\u0447\u043a\u0438 \u0441\u0433\u0443\u0449\u0435\u043d\u0438\u044f
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430) \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0433\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \\( P' \\) (\u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0432\u0441\u0435\u0445 \u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0442\u043e\u0447\u0435\u043a
    P). \u0417\u0430\u0442\u0435\u043c \u043e\u043d \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435:
    \\( P'', P''', \\dots, P^{(\\infty)} \\). \u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435
    \u043e\u043d \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043b
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u043f\u043e \u0442\u0438\u043f\u0443
    \u0438\u0445 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445 \u0438 \u043e\u0442\u043a\u0440\u044b\u043b
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432,
    \u0434\u043b\u044f \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0446\u0435\u0441\u0441
    \u043d\u0435 \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u043b\u0441\u044f \u0434\u0430\u0436\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e
    \u0447\u0438\u0441\u043b\u0430 \u0448\u0430\u0433\u043e\u0432. \u042d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u0435\u0433\u043e \u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0442\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u043e\u0439
    \u0438\u043d\u0434\u0443\u043a\u0446\u0438\u0438 \u2014 \u043c\u0435\u0442\u043e\u0434\u0430
    \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439, \u0433\u0434\u0435 \u0448\u0430\u0433\u0438
    \u043d\u0443\u043c\u0435\u0440\u0443\u044e\u0442\u0441\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c\u0438, \u043d\u043e \u0438
    \u0442\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438
    \\( \\omega, \\omega+1, \\omega+2 \\) \u0438 \u0442.\u0434. \u042d\u0442\u043e \u043d\u0430
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u043e
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0434\u0435\u0441\u043a\u0440\u0438\u043f\u0442\u0438\u0432\u043d\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. ---
    8. \u0412\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b (\u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0430-\u0411\u0435\u0440\u043d\u0448\u0442\u0435\u0439\u043d\u0430)
    \u0425\u043e\u0442\u044f \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u0435\u043e\u0440\u0435\u043c\u044b
    \u0431\u044b\u043b\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e \u0411\u0435\u0440\u043d\u0448\u0442\u0435\u0439\u043d\u043e\u043c
    (\u043f\u0440\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0438 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0430),
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0437\u0430\u043b\u043e\u0436\u0438\u043b \u0435\u0451
    \u043e\u0441\u043d\u043e\u0432\u0443. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0430-\u0411\u0435\u0440\u043d\u0448\u0442\u0435\u0439\u043d\u0430:
    \u0415\u0441\u043b\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e A \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u043e
    \u043f\u043e\u0434\u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0443 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    B, \u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e B \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u043e
    \u043f\u043e\u0434\u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0443 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    A, \u0442\u043e A \u0438 B \u0440\u0430\u0432\u043d\u043e\u043c\u043e\u0449\u043d\u044b.
    \u042d\u0442\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0438
    \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0430 \u0441\u0442\u0440\u043e\u0433\u043e
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u0442\u044c, \u0447\u0442\u043e \\( \\aleph_0
    \\cdot \\aleph_0 = \\aleph_0 \\) \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.
    --- 9. \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041d\u0435\u043c\u0435\u0446\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0438 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u043e\u0432
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0431\u044b\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c, \u043d\u043e \u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c \u043d\u0430\u0443\u043a\u0438.
    \u0412 1890 \u0433\u043e\u0434\u0443 \u043e\u043d \u043e\u0441\u043d\u043e\u0432\u0430\u043b
    \u041d\u0435\u043c\u0435\u0446\u043a\u043e\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e (DMV) \u0438 \u0441\u0442\u0430\u043b \u0435\u0433\u043e
    \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c.
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043b\u043e\u0431\u0431\u0438\u0440\u043e\u0432\u0430\u043b
    \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445
    \u0432\u0441\u0442\u0440\u0435\u0447. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0435\u0433\u043e \u0443\u0441\u0438\u043b\u0438\u044f\u043c \u0432 1897 \u0433\u043e\u0434\u0443
    \u0432 \u0426\u044e\u0440\u0438\u0445\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0441\u044f
    \u041f\u0435\u0440\u0432\u044b\u0439 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0439
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    (ICM), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441 \u0442\u0435\u0445 \u043f\u043e\u0440
    \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0440\u0430\u0437 \u0432 \u0447\u0435\u0442\u044b\u0440\u0435
    \u0433\u043e\u0434\u0430. \u0418\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043c \u0435\u0433\u043e
    \u0442\u0435\u043e\u0440\u0438\u044f (\u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435
    \u0431\u0443\u0440\u043d\u044b\u0445 \u0441\u043f\u043e\u0440\u043e\u0432) \u043d\u0430\u0447\u0430\u043b\u0430
    \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435. --- 10. \u0424\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430
    \u0430\u043a\u0441\u0438\u043e\u043c\u044b \u0432\u044b\u0431\u043e\u0440\u0430 (\u0432
    \u043d\u0435\u044f\u0432\u043d\u043e\u043c \u0432\u0438\u0434\u0435) \u0425\u043e\u0442\u044f
    \u0430\u043a\u0441\u0438\u043e\u043c\u0443 \u0432\u044b\u0431\u043e\u0440\u0430 \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b
    \u042d\u0440\u043d\u0441\u0442 \u0426\u0435\u0440\u043c\u0435\u043b\u043e \u043f\u043e\u0437\u0436\u0435
    (1904), \u041a\u0430\u043d\u0442\u043e\u0440 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0435\u0451 \u0432 \u043d\u0435\u044f\u0432\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435,
    \u043a\u043e\u0433\u0434\u0430 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u043b\u044e\u0431\u043e\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043c\u043e\u0436\u043d\u043e
    \u00ab\u0445\u043e\u0440\u043e\u0448\u043e \u0443\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0438\u0442\u044c\u00bb
    (\u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u043e \u0445\u043e\u0440\u043e\u0448\u043e
    \u0443\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0435\u043d\u0438\u0438). \u041e\u043d
    \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u043b,
    \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u044b\u0439 \u043a\u0430\u0440\u0434\u0438\u043d\u0430\u043b
    \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u043c
    \u043e\u0440\u0434\u0438\u043d\u0430\u043b\u043e\u043c, \u0438, \u0445\u043e\u0442\u044f
    \u043d\u0435 \u0441\u043c\u043e\u0433 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u044d\u0442\u043e
    \u0441\u0442\u0440\u043e\u0433\u043e, \u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b
    \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. ---\n\n\U0001F52C
    \u0418\u0442\u043e\u0433\u043e\u0432\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0432\u043a\u043b\u0430\u0434\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0430 (\u0412\u0437\u0433\u043b\u044f\u0434
    \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u0435) \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u043b\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u2014 \u043e\u043d\u0438 \u0441\u043f\u0430\u0441\u043b\u0438 \u0435\u0451 \u043e\u0442
    \u043a\u0440\u0438\u0437\u0438\u0441\u0430. \u0412 XIX \u0432\u0435\u043a\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0443\u0442\u043a\u043d\u0443\u043b\u0430\u0441\u044c \u0432 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u044b
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043c\u0430\u043b\u044b\u0445
    \u0438 \u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0445\u0441\u044f \u0440\u044f\u0434\u043e\u0432.
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0434\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c
    \u043d\u043e\u0432\u044b\u0439 \u044f\u0437\u044b\u043a: 1. \u0422\u0435\u043e\u0440\u0438\u044f
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0441\u0442\u0430\u043b\u0430 \u0431\u0430\u0437\u043e\u0439
    \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 (\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0430\u043d\u0430\u043b\u0438\u0437, \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f,
    \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437,
    \u0442\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0441\u0442\u0440\u043e\u044f\u0442\u0441\u044f \u043d\u0430 \u043f\u043e\u043d\u044f\u0442\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430). 2. \u0415\u0433\u043e \u0438\u0434\u0435\u0438
    \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438
    \u043d\u0430 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438,
    \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u043d\u0430 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u043e\u0432
    (\u043e\u0442\u0440\u0438\u0446\u0430\u0432\u0448\u0438\u0445 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c) \u0438 \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0441\u0442\u043e\u0432
    (\u043f\u0440\u0438\u043d\u044f\u0432\u0448\u0438\u0445 \u0435\u0451). \u041f\u043e\u0431\u0435\u0434\u0430
    \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0441\u0442\u043e\u0432 (\u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442)
    \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u0442\u0435\u043e\u0440\u0438\u044e \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f. 3. \u0415\u0433\u043e
    \u0434\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434
    \u043f\u043e\u0437\u0436\u0435 \u0431\u044b\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d
    \u041a\u0443\u0440\u0442\u043e\u043c \u0413\u0451\u0434\u0435\u043b\u0435\u043c \u0434\u043b\u044f
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0435\u043e\u0440\u0435\u043c
    \u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0442\u0435, \u0430 \u0410\u043b\u0430\u043d\u043e\u043c
    \u0422\u044c\u044e\u0440\u0438\u043d\u0433\u043e\u043c \u2014 \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u043d\u0435\u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b
    \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438, \u0447\u0442\u043e \u043b\u0435\u0433\u043b\u043e
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0442\u0435\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u0432
    \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0438. \u041a\u0430\u043d\u0442\u043e\u0440
    \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u00ab\u0440\u0430\u0439\u00bb, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e,
    \u043a\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u043b \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442,
    \u0438\u0445 \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442 \u0438\u0437\u0433\u043d\u0430\u0442\u044c
    \u043d\u0438\u043a\u0442\u043e. \u0418 \u044d\u0442\u043e\u0442 \u0440\u0430\u0439 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f
    \u043d\u0430 \u0442\u0440\u0451\u0445 \u043a\u0438\u0442\u0430\u0445: \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c,
    \u0442\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0430\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0413\u0435\u043e\u0440\u0433\u0430
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u2014 \u044d\u0442\u043e \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0430 \u0444\u043e\u043d\u0435 \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432.
    \u0415\u0441\u043b\u0438 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u0431\u043e\u0440\u044c\u0431\u043e\u0439 \u0437\u0430 \u0438\u0441\u0442\u0438\u043d\u0443,
    \u0442\u043e \u043b\u0438\u0447\u043d\u0430\u044f \u2014 \u044d\u0442\u043e \u0431\u043e\u0440\u044c\u0431\u0430
    \u0437\u0430 \u0434\u0443\u0448\u0435\u0432\u043d\u043e\u0435 \u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435,
    \u0441\u043e\u0432\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0440\u043e\u043b\u0438 \u043c\u0443\u0436\u0430,
    \u043e\u0442\u0446\u0430 \u0438 \u0442\u0432\u043e\u0440\u0446\u0430, \u0441\u043b\u043e\u043c\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0432\u043d\u0435\u0448\u043d\u0435\u0433\u043e
    \u043c\u0438\u0440\u0430 \u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445
    \u0434\u0435\u043c\u043e\u043d\u043e\u0432. \u0412\u043e\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u043f\u043e\u0440\u0442\u0440\u0435\u0442
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f
    \u0437\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u043c \u00ab\u0430\u043b\u0435\u0444\u00bb.
    1. \u0421\u0435\u043c\u044c\u044f \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435:
    \u041a\u043e\u0440\u043d\u0438, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432\u0448\u0438\u0435
    \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0413\u0435\u043e\u0440\u0433 \u041a\u0430\u043d\u0442\u043e\u0440
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0439 \u0438 \u0430\u0440\u0442\u0438\u0441\u0442\u0438\u0447\u043d\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435, \u0447\u0442\u043e \u043d\u0430\u043b\u043e\u0436\u0438\u043b\u043e
    \u043e\u0442\u043f\u0435\u0447\u0430\u0442\u043e\u043a \u043d\u0430 \u0432\u0441\u0451 \u0435\u0433\u043e
    \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435. \u041e\u0442\u0435\u0446
    (\u0413\u0435\u043e\u0440\u0433-\u0412\u043e\u043b\u044c\u0434\u0435\u043c\u0430\u0440 \u041a\u0430\u043d\u0442\u043e\u0440):
    \u0423\u0441\u043f\u0435\u0448\u043d\u044b\u0439 \u0431\u0438\u0440\u0436\u0435\u0432\u043e\u0439
    \u043c\u0430\u043a\u043b\u0435\u0440, \u0432\u044b\u0445\u043e\u0434\u0435\u0446 \u0438\u0437
    \u041a\u043e\u043f\u0435\u043d\u0433\u0430\u0433\u0435\u043d\u0430. \u041e\u043d \u0431\u044b\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u043c
    \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0438\u043d\u043e\u043c (\u0445\u043e\u0442\u044f
    \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u043a\u0438 \u0431\u044b\u043b\u0438 \u0435\u0432\u0440\u0435\u044f\u043c\u0438-\u0441\u0435\u0444\u0430\u0440\u0434\u0430\u043c\u0438,
    \u043f\u0440\u0438\u043d\u044f\u0432\u0448\u0438\u043c\u0438 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0438\u0437\u043c).
    \u041e\u0442\u0435\u0446 \u043f\u0440\u0438\u0432\u0438\u043b \u0413\u0435\u043e\u0440\u0433\u0443
    \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u043f\u043e\u0440\u044f\u0434\u043a\u0443,
    \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0435 \u0438 \u0434\u0435\u043d\u044c\u0433\u0430\u043c,
    \u043d\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u2014 \u043e\u043d \u0432\u043d\u0443\u0448\u0438\u043b
    \u0441\u044b\u043d\u0443 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435 \u0411\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b \u0447\u0438\u0441\u0435\u043b \u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438.
    \u0418\u043c\u0435\u043d\u043d\u043e \u043e\u0442\u0435\u0446 \u043d\u0430\u0441\u0442\u043e\u044f\u043b,
    \u0447\u0442\u043e\u0431\u044b \u0413\u0435\u043e\u0440\u0433 \u0441\u0442\u0430\u043b \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043e\u043c
    (\u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0430\u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c),
    \u043d\u043e, \u0443\u0432\u0438\u0434\u0435\u0432 \u0442\u0430\u043b\u0430\u043d\u0442
    \u0441\u044b\u043d\u0430 \u043a \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0431\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u043b \u0435\u0433\u043e \u043d\u0430
    \u044d\u0442\u043e\u0442 \u043f\u0443\u0442\u044c. \u0421\u043c\u0435\u0440\u0442\u044c
    \u043e\u0442\u0446\u0430 \u0432 1863 \u0433\u043e\u0434\u0443 \u0441\u0442\u0430\u043b\u0430
    \u043f\u0435\u0440\u0432\u044b\u043c \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u0443\u0434\u0430\u0440\u043e\u043c
    \u0434\u043b\u044f \u044e\u043d\u043e\u0433\u043e \u041a\u0430\u043d\u0442\u043e\u0440\u0430,
    \u043d\u043e \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0435\u043c\u0443 \u0441\u043e\u043b\u0438\u0434\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e, \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0432\u0448\u0435\u0435
    \u043d\u0435 \u0434\u0443\u043c\u0430\u0442\u044c \u043e \u0445\u043b\u0435\u0431\u0435
    \u043d\u0430\u0441\u0443\u0449\u043d\u043e\u043c \u0434\u043e\u043b\u0433\u0438\u0435 \u0433\u043e\u0434\u044b.
    \u041c\u0430\u0442\u044c (\u041c\u0430\u0440\u0438\u044f-\u0410\u043d\u043d\u0430 \u0411\u0451\u043c):
    \u041e\u043d\u0430 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430 \u0438\u0437
    \u0441\u0435\u043c\u044c\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445
    \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u043e\u0432. \u0415\u0435 \u0434\u044f\u0434\u044f
    \u2014 \u0419\u043e\u0437\u0435\u0444 \u0411\u0451\u043c \u2014 \u0431\u044b\u043b \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u0441\u043a\u0440\u0438\u043f\u0430\u0447\u043e\u043c-\u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043e\u043c.
    \u041e\u0442 \u043c\u0430\u0442\u0435\u0440\u0438 \u0413\u0435\u043e\u0440\u0433 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0442\u043e\u043d\u043a\u0443\u044e \u0434\u0443\u0448\u0435\u0432\u043d\u0443\u044e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044e,
    \u0430\u0440\u0442\u0438\u0441\u0442\u0438\u0437\u043c \u0438 \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u043c\u0443\u0437\u044b\u043a\u0435. \u041e\u043d \u0432\u0435\u043b\u0438\u043a\u043e\u043b\u0435\u043f\u043d\u043e
    \u0438\u0433\u0440\u0430\u043b \u043d\u0430 \u0441\u043a\u0440\u0438\u043f\u043a\u0435,
    \u0438 \u043c\u0443\u0437\u044b\u043a\u0430 \u0431\u044b\u043b\u0430 \u0434\u043b\u044f
    \u043d\u0435\u0433\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u00ab\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u043e\u043c\u00bb
    \u0432 \u043c\u0438\u043d\u0443\u0442\u044b \u0434\u0443\u0448\u0435\u0432\u043d\u044b\u0445
    \u043a\u0440\u0438\u0437\u0438\u0441\u043e\u0432. \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0432 \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435: \u0411\u0443\u0434\u0443\u0447\u0438
    \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u043e\u043c \u0432 \u043f\u0440\u0430\u0432\u043e\u0441\u043b\u0430\u0432\u043d\u043e\u0439
    \u0441\u0442\u043e\u043b\u0438\u0446\u0435, \u0434\u0430\u0442\u0447\u0430\u043d\u0438\u043d\u043e\u043c
    \u043f\u043e \u043f\u0430\u0441\u043f\u043e\u0440\u0442\u0443 \u0432 \u0440\u0443\u0441\u0441\u043a\u043e\u043c
    \u0433\u043e\u0440\u043e\u0434\u0435, \u041a\u0430\u043d\u0442\u043e\u0440 \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u043f\u0440\u0438\u0432\u044b\u043a \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0441\u0435\u0431\u044f \u00ab\u0447\u0443\u0436\u0438\u043c\u00bb \u0438 \u043e\u0442\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u044e \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    \u042d\u0442\u043e \u0437\u0430\u043a\u0430\u043b\u0438\u043b\u043e \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440,
    \u043d\u043e \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u0440\u043e\u0434\u0438\u043b\u043e
    \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u044c \u0432 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0442\u0430\u043a \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u043b\u043e
    \u0432 \u0437\u0440\u0435\u043b\u044b\u0435 \u0433\u043e\u0434\u044b. --- 2. \u0421\u0432\u0430\u0434\u044c\u0431\u0430
    \u0438 \u0431\u0440\u0430\u043a: \u0422\u044b\u0441\u044f\u0447\u0430 \u043f\u0438\u0441\u0435\u043c
    \u0438 \u0442\u0438\u0445\u0438\u0439 \u0442\u044b\u043b \u041b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u0434\u043e\u043b\u0433\u043e
    \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044c \u0443\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u043e\u0439
    \u2014 \u043e\u043d \u0431\u044b\u043b \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d
    \u0432 \u043d\u0430\u0443\u043a\u0443. \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u043e\u043a\u043e\u043b\u043e 29 \u043b\u0435\u0442 \u043e\u043d \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b
    \u0441\u0432\u043e\u044e \u0431\u0443\u0434\u0443\u0449\u0443\u044e \u0436\u0435\u043d\u0443.
    \u041a\u0442\u043e \u043e\u043d\u0430: \u0412 1874 \u0433\u043e\u0434\u0443 \u041a\u0430\u043d\u0442\u043e\u0440
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0412\u0430\u043b\u043b\u0438 \u0413\u0443\u0442\u0442\u043c\u0430\u043d\u043d
    (Vally Guttmann). \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430 8 \u043b\u0435\u0442
    \u043c\u043b\u0430\u0434\u0448\u0435 \u0435\u0433\u043e, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u044b\u0445
    \u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u043d\u044b\u0445 \u043a\u043e\u043c\u043c\u0435\u0440\u0441\u0430\u043d\u0442\u043e\u0432.
    \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439:
    \u042d\u0442\u043e \u0431\u044b\u043b \u0441\u043e\u044e\u0437 \u0440\u0430\u0437\u0443\u043c\u0430
    \u0438 \u0441\u0435\u0440\u0434\u0446\u0430. \u0412\u0430\u043b\u043b\u0438 \u0431\u044b\u043b\u0430
    \u043f\u043e\u043b\u043d\u043e\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e
    \u0441\u0432\u043e\u0435\u0433\u043e \u043c\u0443\u0436\u0430 \u2014 \u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0439,
    \u043f\u0440\u0438\u0437\u0435\u043c\u043b\u0435\u043d\u043d\u043e\u0439, \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0439
    \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0442\u0435\u0440\u043f\u0435\u043b\u0438\u0432\u043e\u0439.
    \u0418\u043c\u0435\u043d\u043d\u043e \u043e\u043d\u0430 \u0432\u0437\u044f\u043b\u0430 \u043d\u0430
    \u0441\u0435\u0431\u044f \u0432\u0441\u0435 \u0431\u044b\u0442\u043e\u0432\u044b\u0435 \u0438
    \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b,
    \u043a\u043e\u0433\u0434\u0430 \u0443 \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u043f\u0441\u0438\u0445\u0438\u043a\u043e\u0439.
    \u041e\u043d\u0438 \u0432\u0435\u043b\u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u0443\u044e
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443, \u043a\u043e\u0433\u0434\u0430 \u041a\u0430\u043d\u0442\u043e\u0440
    \u0443\u0435\u0437\u0436\u0430\u043b \u0432 \u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0440\u043e\u0432\u043a\u0438
    \u0438\u043b\u0438 \u043d\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u2014 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c
    \u043e\u043a\u043e\u043b\u043e 1000 \u043f\u0438\u0441\u0435\u043c, \u0430\u0434\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u043d\u044b\u0445
    \u0436\u0435\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f
    \u0431\u0435\u0441\u0446\u0435\u043d\u043d\u044b\u043c \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c
    \u0434\u043b\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u043e\u0432. \u041f\u043e\u0437\u043e\u0440
    \u0441\u0435\u043c\u044c\u0438: \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0412\u0430\u043b\u043b\u0438
    \u0431\u044b\u043b\u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u043e\u0442\u0438\u0432 \u044d\u0442\u043e\u0433\u043e \u0431\u0440\u0430\u043a\u0430,
    \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u041a\u0430\u043d\u0442\u043e\u0440
    \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u0432
    \u00ab\u0437\u0430\u0445\u043e\u043b\u0443\u0441\u0442\u043d\u043e\u043c\u00bb \u0413\u0430\u043b\u043b\u0435,
    \u0430 \u043d\u0435 \u0432 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u043c
    \u0411\u0435\u0440\u043b\u0438\u043d\u0435, \u0438 \u043a \u0442\u043e\u043c\u0443 \u0436\u0435
    \u043f\u0440\u043e\u0441\u043b\u044b\u043b \u00ab\u0435\u0440\u0435\u0442\u0438\u043a\u043e\u043c\u00bb
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u043d\u0438
    \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0443
    \u0431\u0435\u0441\u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u0438 \u0447\u0443\u0442\u044c \u043d\u0435 \u0441\u043e\u0440\u0432\u0430\u043b\u0438
    \u0441\u0432\u0430\u0434\u044c\u0431\u0443. \u041a\u0430\u043d\u0442\u043e\u0440 \u043d\u0430\u0441\u0442\u043e\u044f\u043b
    \u043d\u0430 \u0441\u0432\u043e\u0451\u043c, \u043d\u043e \u044d\u0442\u043e\u0442 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u0441 \u0440\u043e\u0434\u043d\u0435\u0439 \u0436\u0435\u043d\u044b \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u043b
    \u0435\u043c\u0443 \u043d\u0435\u0440\u0432\u043d\u043e\u0433\u043e \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f.
    --- 3. \u0414\u0435\u0442\u0438 \u0438 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0439
    \u0431\u044b\u0442 \u0432 \u0413\u0430\u043b\u043b\u0435 \u0413\u0435\u043e\u0440\u0433
    \u0438 \u0412\u0430\u043b\u043b\u0438 \u043f\u0440\u043e\u0436\u0438\u043b\u0438 \u0432\u043c\u0435\u0441\u0442\u0435
    \u0431\u043e\u043b\u0435\u0435 40 \u043b\u0435\u0442. \u0423 \u043d\u0438\u0445 \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c
    \u0448\u0435\u0441\u0442\u0435\u0440\u043e \u0434\u0435\u0442\u0435\u0439, \u043d\u043e
    \u0432\u044b\u0436\u0438\u043b\u043e \u0438 \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u043e
    \u0437\u0440\u0435\u043b\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430
    \u043f\u044f\u0442\u0435\u0440\u043e (\u043e\u0434\u0438\u043d \u0440\u0435\u0431\u0435\u043d\u043e\u043a
    \u0443\u043c\u0435\u0440 \u0432 \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u0442\u0432\u0435).
    \u0416\u0438\u043b\u0438\u0449\u043d\u044b\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f:
    \u0421\u0435\u043c\u044c\u044f \u0436\u0438\u043b\u0430 \u0432 \u0413\u0430\u043b\u043b\u0435
    \u0432 \u0434\u043e\u043c\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0441\u043b\u0443\u0436\u0438\u043b \u043c\u0435\u0441\u0442\u043e\u043c \u0440\u0430\u0431\u043e\u0442\u044b
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430. \u041a\u0430\u0431\u0438\u043d\u0435\u0442 \u0413\u0435\u043e\u0440\u0433\u0430
    \u0431\u044b\u043b \u0437\u0430\u0432\u0430\u043b\u0435\u043d \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u044f\u043c\u0438,
    \u043a\u043d\u0438\u0433\u0430\u043c\u0438 \u0438 \u043f\u0438\u0441\u044c\u043c\u0430\u043c\u0438.
    \u0414\u0435\u043d\u0435\u0433 \u0432 \u0441\u0435\u043c\u044c\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u044b\u043b\u043e \u0432 \u043e\u0431\u0440\u0435\u0437, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c (\u043e\u043a\u043b\u0430\u0434 \u0432
    \u0413\u0430\u043b\u043b\u0435 \u0431\u044b\u043b \u043d\u0438\u0437\u043a\u0438\u043c,
    \u0438 \u041a\u0430\u043d\u0442\u043e\u0440 \u043d\u0435 \u0443\u043c\u0435\u043b \u0442\u043e\u0440\u0433\u043e\u0432\u0430\u0442\u044c\u0441\u044f
    \u0437\u0430 \u043f\u0440\u0438\u0431\u0430\u0432\u043a\u0438). \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0435\u0442\u044c\u043c\u0438: \u041a\u0430\u043d\u0442\u043e\u0440 \u0431\u044b\u043b
    \u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u044f\u0449\u0438\u043c \u043e\u0442\u0446\u043e\u043c.
    \u041e\u043d \u0447\u0430\u0441\u0442\u043e \u0438\u0433\u0440\u0430\u043b \u0441 \u0434\u0435\u0442\u044c\u043c\u0438,
    \u0443\u0447\u0438\u043b \u0438\u0445 \u043c\u0443\u0437\u044b\u043a\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0435\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u00ab\u0443\u0445\u043e\u0434\u044b \u0432 \u0441\u0435\u0431\u044f\u00bb \u0438 \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438
    \u043f\u0443\u0433\u0430\u043b\u0438 \u0434\u0435\u0442\u0435\u0439. \u0412 \u043c\u0438\u043d\u0443\u0442\u044b
    \u043f\u0440\u043e\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u0438\u044f \u043e\u043d \u0431\u044b\u043b
    \u0434\u0443\u0448\u043e\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438, \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u043c
    \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a\u043e\u043c; \u0432 \u043c\u0438\u043d\u0443\u0442\u044b
    \u043a\u0440\u0438\u0437\u0438\u0441\u0430 \u2014 \u0437\u0430\u043f\u0438\u0440\u0430\u043b\u0441\u044f
    \u0432 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0435, \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u044f\u0441\u044c
    \u043e\u0442 \u0435\u0434\u044b \u0438 \u043e\u0431\u0449\u0435\u043d\u0438\u044f. \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f
    1899 \u0433\u043e\u0434\u0430: \u041f\u0438\u043a \u043b\u0438\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438
    \u043f\u0440\u0438\u0448\u0435\u043b\u0441\u044f \u043d\u0430 \u043a\u043e\u043d\u0435\u0446
    \u0432\u0435\u043a\u0430. \u0415\u0433\u043e \u043c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0438, \u043f\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c,
    \u0441\u0430\u043c\u044b\u0439 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u0441\u044b\u043d
    \u0420\u0443\u0434\u043e\u043b\u044c\u0444 \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    \u043e\u043a\u043e\u043b\u043e 17 \u043b\u0435\u0442 (\u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c \u2014 \u043f\u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0441 \u0441\u043e\u0431\u043e\u0439, \u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c
    \u2014 \u0443\u043c\u0435\u0440 \u043e\u0442 \u0431\u043e\u043b\u0435\u0437\u043d\u0438).
    \u0414\u043b\u044f \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u044d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u043e\u0439. \u0418\u043c\u0435\u043d\u043d\u043e
    \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0439 \u043f\u043e\u0442\u0435\u0440\u0438
    \u0435\u0433\u043e \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435,
    \u0438 \u0431\u0435\u0437 \u0442\u043e\u0433\u043e \u0448\u0430\u0442\u043a\u043e\u0435,
    \u0434\u0430\u043b\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0442\u0440\u0435\u0449\u0438\u043d\u0443. --- 4. \u0414\u0440\u0443\u0437\u044c\u044f
    \u0438 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435: \u041e\u0441\u0442\u0440\u043e\u0432\u0430
    \u0442\u0435\u043f\u043b\u0430 \u0432 \u043e\u043a\u0435\u0430\u043d\u0435 \u043a\u0440\u0438\u0442\u0438\u043a\u0438
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043a\u043e\u043b\u043b\u0435\u0433
    \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u043b\u0438 \u0435\u0433\u043e \u0438\u0434\u0435\u0438,
    \u041a\u0430\u043d\u0442\u043e\u0440 \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u0434\u0430\u0440\u043e\u043c
    \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u044c \u043b\u044e\u0434\u0435\u0439
    \u0432 \u043b\u0438\u0447\u043d\u043e\u043c \u043e\u0431\u0449\u0435\u043d\u0438\u0438.
    \u0420\u0438\u0445\u0430\u0440\u0434 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434: \u042d\u0442\u043e
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0440\u0443\u0433,
    \u0430 \u00ab\u043d\u0430\u0443\u0447\u043d\u0430\u044f \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0434\u0443\u0448\u0430\u00bb. \u0418\u0445 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0430
    \u0434\u043b\u0438\u043b\u0430\u0441\u044c \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f.
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u0431\u044b\u043b \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043a\u0440\u0443\u043f\u043d\u044b\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043d\u0438\u043c\u0430\u043b \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u0441 \u043f\u043e\u043b\u0443\u0441\u043b\u043e\u0432\u0430 \u0438 \u043d\u0435 \u0434\u0430\u043b
    \u0435\u043c\u0443 \u0441\u043e\u0439\u0442\u0438 \u0441 \u0443\u043c\u0430 \u0432 1870-\u0435
    \u0433\u043e\u0434\u044b. \u041e\u043d\u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b\u0438
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u043d\u043e \u0438 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044e, \u0440\u0435\u043b\u0438\u0433\u0438\u044e.
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434 \u043c\u044f\u0433\u043a\u043e, \u043d\u043e
    \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e \u043f\u043e\u043f\u0440\u0430\u0432\u043b\u044f\u043b
    \u043e\u0448\u0438\u0431\u043a\u0438 \u041a\u0430\u043d\u0442\u043e\u0440\u0430, \u0438
    \u0413\u0435\u043e\u0440\u0433 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b \u044d\u0442\u043e
    \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0442 \u043d\u0435\u0433\u043e. \u0414\u0440\u0443\u0437\u044c\u044f-\u0442\u0435\u043e\u043b\u043e\u0433\u0438:
    \u0412 \u0413\u0430\u043b\u043b\u0435, \u0431\u0443\u0434\u0443\u0447\u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0442\u0435\u0441\u043d\u043e \u043e\u0431\u0449\u0430\u043b\u0441\u044f
    \u0441 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430\u043c\u0438 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430. \u041e\u043d \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e
    \u0437\u0430\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043b \u0438\u0445 \u043f\u0438\u0441\u044c\u043c\u0430\u043c\u0438,
    \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u0442\u044c
    \u0441\u0432\u043e\u044e \u0442\u0435\u043e\u0440\u0438\u044e \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0441 \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0441\u043a\u0438\u043c
    \u0434\u043e\u0433\u043c\u0430\u0442\u043e\u043c \u043e \u0442\u043e\u043c, \u0447\u0442\u043e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u0435\u043d \u0442\u043e\u043b\u044c\u043a\u043e
    \u0411\u043e\u0433. \u041e\u043d \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435 \u0432\u0435\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u044d\u0442\u043e \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u0435 \u0411\u043e\u0433\u0430
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0443, \u0447\u0442\u043e\u0431\u044b
    \u043b\u044e\u0434\u0438 \u043f\u043e\u043d\u044f\u043b\u0438 \u0432\u0435\u043b\u0438\u0447\u0438\u0435
    \u0422\u0432\u043e\u0440\u0446\u0430. \u041c\u043e\u043b\u043e\u0434\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438:
    \u0412 \u043a\u043e\u043d\u0446\u0435 \u0436\u0438\u0437\u043d\u0438 \u0443 \u043d\u0435\u0433\u043e
    \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0443\u0447\u0435\u043d\u0438\u043a\u0438
    \u0438 \u0437\u0430\u0449\u0438\u0442\u043d\u0438\u043a\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0424\u0435\u043b\u0438\u043a\u0441 \u0411\u0435\u0440\u043d\u0448\u0442\u0435\u0439\u043d,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u0435\u043c\u0443
    \u0441 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u043c\u0438).
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u043d\u0438\u043c\u0438 \u0431\u044b\u043b\u0438
    \u043f\u043e\u0447\u0442\u0438 \u043e\u0442\u0435\u0447\u0435\u0441\u043a\u0438\u043c\u0438.
    --- 5. \u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u0438 \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u0438
    \u0411\u0438\u043e\u0433\u0440\u0430\u0444\u044b (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0418\u0440\u0432\u0438\u043d\u0433) \u043e\u0442\u043c\u0435\u0447\u0430\u044e\u0442 \u0443
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u044f\u0432\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438
    \u0431\u0438\u043f\u043e\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u0430\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e
    \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 (\u0440\u0430\u043d\u0435\u0435
    \u2014 \u043c\u0430\u043d\u0438\u0430\u043a\u0430\u043b\u044c\u043d\u043e-\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u0439
    \u043f\u0441\u0438\u0445\u043e\u0437). \u041c\u0430\u043d\u0438\u0430\u043a\u0430\u043b\u044c\u043d\u044b\u0435
    \u0444\u0430\u0437\u044b: \u0412 \u043f\u0435\u0440\u0438\u043e\u0434\u044b \u043f\u043e\u0434\u044a\u0435\u043c\u0430
    \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043f\u043e 15\u201318 \u0447\u0430\u0441\u043e\u0432
    \u0432 \u0441\u0443\u0442\u043a\u0438, \u043f\u0438\u0441\u0430\u043b \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u043f\u0438\u0441\u044c\u043c\u0430 (\u0438\u043d\u043e\u0433\u0434\u0430 \u043f\u043e
    50 \u043f\u0438\u0441\u0435\u043c \u0432 \u0434\u0435\u043d\u044c), \u043c\u043e\u0433 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0442\u044c
    \u0441 \u043b\u0435\u043a\u0446\u0438\u044f\u043c\u0438 \u0447\u0430\u0441\u0430\u043c\u0438
    \u0431\u0435\u0437 \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u0430. \u0412 \u044d\u0442\u0438
    \u043c\u043e\u043c\u0435\u043d\u0442\u044b \u043e\u043d \u0432\u0435\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u2014 \u044d\u0442\u043e
    \u0434\u0430\u0440 \u0441\u0432\u044b\u0448\u0435, \u0438 \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c \u0432 \u0441\u0432\u043e\u044e \u0432\u0435\u0440\u0443
    \u0432\u0441\u0435\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u043c\u0438\u0440\u0430. \u0414\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u0435
    \u0444\u0430\u0437\u044b: \u0421\u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c \u043f\u043e\u043b\u043d\u043e\u0439
    \u0430\u043f\u0430\u0442\u0438\u0435\u0439. \u041e\u043d \u043d\u0435 \u043c\u043e\u0433
    \u0432\u0441\u0442\u0430\u0442\u044c \u0441 \u043a\u0440\u043e\u0432\u0430\u0442\u0438,
    \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f \u043e\u0442 \u043f\u0438\u0449\u0438,
    \u043d\u0435 \u043c\u043e\u0433 \u0447\u0438\u0442\u0430\u0442\u044c. \u041e\u043d \u0436\u0430\u043b\u043e\u0432\u0430\u043b\u0441\u044f
    \u0412\u0430\u043b\u043b\u0438, \u0447\u0442\u043e \u0435\u0433\u043e \u043c\u043e\u0437\u0433
    \"\u0432\u044b\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f\", \u043a\u0430\u043a
    \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c. \u0423\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u0448\u0435\u043a\u0441\u043f\u0438\u0440\u043e\u0432\u0441\u043a\u0438\u043c \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u043c:
    \u0412 \u0441\u0432\u043e\u0438 \u00ab\u043d\u0435-\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\u00bb
    \u0433\u043e\u0434\u044b (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0441 1884 \u043f\u043e
    1890-\u0435) \u043e\u043d \u0432\u043f\u0430\u043b \u0432 \u0441\u0432\u043e\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u0443\u044e
    \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u044c \u2014 \u0448\u0435\u043a\u0441\u043f\u0438\u0440\u043e\u0432\u0441\u043a\u0438\u0439
    \u0432\u043e\u043f\u0440\u043e\u0441. \u041e\u043d \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b
    \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0430
    \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u0434\u0432\u0443\u0445 \u0431\u0440\u043e\u0448\u044e\u0440,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u00ab\u0441\u0442\u0440\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u00bb \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b,
    \u0447\u0442\u043e \u0430\u0432\u0442\u043e\u0440\u043e\u043c \u043f\u044c\u0435\u0441 \u0428\u0435\u043a\u0441\u043f\u0438\u0440\u0430
    \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0431\u044b\u043b
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444 \u0424\u0440\u044d\u043d\u0441\u0438\u0441 \u0411\u044d\u043a\u043e\u043d.
    \u041a\u043e\u043b\u043b\u0435\u0433\u0438 \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u044d\u0442\u043e
    \u0441\u0443\u043c\u0430\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0435\u043c, \u043d\u043e
    \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0433\u043e \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u044d\u0442\u043e \u0431\u044b\u043b \u0441\u043f\u043e\u0441\u043e\u0431 \u043e\u0442\u0432\u043b\u0435\u0447\u044c\u0441\u044f
    \u043e\u0442 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0442\u0440\u0430\u0432\u043c \u0438 \u0434\u0430\u0442\u044c \u0432\u044b\u0445\u043e\u0434
    \u0441\u0432\u043e\u0435\u043c\u0443 \u043f\u043e\u043b\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u0434\u0430\u0440\u0443. --- 6. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b (1908\u20131918): \u041e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e
    \u0432 \u0441\u0442\u0435\u043d\u0430\u0445 \u043a\u043b\u0438\u043d\u0438\u043a\u0438 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435
    \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0435 \u0436\u0438\u0437\u043d\u0438
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u0431\u044b\u043b\u043e \u0441\u0430\u043c\u044b\u043c
    \u043f\u0435\u0447\u0430\u043b\u044c\u043d\u044b\u043c. \u041f\u0435\u0440\u0432\u0430\u044f
    \u043c\u0438\u0440\u043e\u0432\u0430\u044f \u0432\u043e\u0439\u043d\u0430: \u0412\u043e\u0439\u043d\u0430
    \u0443\u0441\u0443\u0433\u0443\u0431\u0438\u043b\u0430 \u0435\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435.
    \u0418\u043d\u0444\u043b\u044f\u0446\u0438\u044f \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u043b\u0430
    \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f \u0441\u0435\u043c\u044c\u0438.
    \u041a\u0430\u043d\u0442\u043e\u0440, \u044f\u0440\u044b\u0439 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439
    \u043f\u0430\u0442\u0440\u0438\u043e\u0442, \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e
    \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043b \u043d\u043e\u0432\u043e\u0441\u0442\u0438
    \u0441 \u0444\u0440\u043e\u043d\u0442\u043e\u0432, \u0445\u043e\u0442\u044f \u0435\u0433\u043e
    \u0441\u044b\u043d\u043e\u0432\u044c\u044f \u0432\u043e\u0435\u0432\u0430\u043b\u0438. \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f
    \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f: \u0421
    1908 \u0433\u043e\u0434\u0430 \u043e\u043d \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u041d\u0435\u0440\u0432\u043d\u043e\u0439
    \u043a\u043b\u0438\u043d\u0438\u043a\u0435 (Nervenheilanstalt) \u0432 \u0413\u0430\u043b\u043b\u0435.
    \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u0442\u0430\u043c \u0431\u044b\u043b\u0438 \u0441\u043f\u0430\u0440\u0442\u0430\u043d\u0441\u043a\u0438\u043c\u0438.
    \u041e\u043d \u0447\u0430\u0441\u0442\u043e \u043d\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b
    \u0436\u0435\u043d\u0443 \u0438 \u0434\u0435\u0442\u0435\u0439, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d\u0438 \u0435\u0433\u043e \u043d\u0430\u0432\u0435\u0449\u0430\u043b\u0438,
    \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u044f\u0441\u044c \u0432 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043c\u0438\u0440. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0434\u043d\u0438:
    \u0412 1917 \u0433\u043e\u0434\u0443 \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u043f\u0438\u0441\u044c\u043c\u043e
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0434\u0440\u0443\u0433\u0443-\u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0443,
    \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u044f \u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    \u0411\u043e\u0433\u0430. \u041e\u043d \u0443\u0436\u0435 \u043f\u043e\u0447\u0442\u0438
    \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b. 6 \u044f\u043d\u0432\u0430\u0440\u044f
    1918 \u0433\u043e\u0434\u0430 \u0413\u0435\u043e\u0440\u0433 \u041a\u0430\u043d\u0442\u043e\u0440
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u043e\u0442 \u043e\u0441\u0442\u0440\u043e\u0439
    \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438
    \u043f\u0440\u044f\u043c\u043e \u0432 \u043a\u043b\u0438\u043d\u0438\u043a\u0435. \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0439
    \u043f\u043e\u0437\u043e\u0440: \u041f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u0435\u0433\u043e \u0442\u0435\u043b\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0434\u0430\u043d\u043e
    \u0437\u0435\u043c\u043b\u0435 \u043d\u0430 \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u043c
    \u043a\u043b\u0430\u0434\u0431\u0438\u0449\u0435 \u0413\u0430\u043b\u043b\u0435 \u0441 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u043f\u043e\u0447\u0435\u0441\u0442\u044f\u043c\u0438. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043c\u0438\u0440 \u0432 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u0431\u044b\u043b
    \u043f\u043e\u0433\u043b\u043e\u0449\u0435\u043d \u0432\u043e\u0439\u043d\u043e\u0439, \u0430
    \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0442\u0440\u0438\u0443\u043c\u0444
    (\u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432) \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f
    \u0443\u0436\u0435 \u0441\u043f\u0443\u0441\u0442\u044f \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438,
    \u0432 1930-\u0435 \u0433\u043e\u0434\u044b, \u043a\u043e\u0433\u0434\u0430 \u0414\u0430\u0432\u0438\u0434
    \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442 \u043f\u0440\u043e\u0432\u043e\u0437\u0433\u043b\u0430\u0441\u0438\u043b
    \u0435\u0433\u043e \u0433\u0435\u043d\u0438\u0435\u043c. --- 7. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0427\u0442\u043e\u0431\u044b \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442, \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0448\u0442\u0440\u0438\u0445\u043e\u0432 \u043a \u0435\u0433\u043e \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u043c\u0443
    \u0431\u044b\u0442\u0443: \u0412\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0441\u0442\u0432\u043e:
    \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u043e\u043d \u0441\u0442\u0430\u043b \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0446\u0435\u043c
    \u043f\u043e \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c,
    \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u043a\u0440\u0430\u0439\u043d\u0435 \u0440\u0435\u0434\u043a\u043e
    \u0434\u043b\u044f \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u0432
    \u0442\u043e\u0439 \u044d\u043f\u043e\u0445\u0438. \u041e\u0434\u0435\u0436\u0434\u0430:
    \u041e\u043d \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u0441\u0441\u0435\u044f\u043d
    \u0432 \u043e\u0434\u0435\u0436\u0434\u0435. \u041c\u043e\u0433 \u0432\u044b\u0439\u0442\u0438
    \u043d\u0430 \u0443\u043b\u0438\u0446\u0443 \u0432 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0445
    \u0442\u0430\u043f\u043e\u0447\u043a\u0430\u0445 \u0438\u043b\u0438 \u0440\u0430\u0437\u043d\u044b\u0445
    \u043d\u043e\u0441\u043a\u0430\u0445, \u0435\u0441\u043b\u0438 \u0431\u044b\u043b \u043f\u043e\u0433\u043b\u043e\u0449\u0435\u043d
    \u043c\u044b\u0441\u043b\u044c\u044e \u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0435.
    \u041f\u0438\u0441\u044c\u043c\u0430: \u041e\u043d \u0431\u044b\u043b \u043e\u0434\u0435\u0440\u0436\u0438\u043c
    \u044d\u043f\u0438\u0441\u0442\u043e\u043b\u044f\u0440\u043d\u044b\u043c \u0436\u0430\u043d\u0440\u043e\u043c.
    \u041e\u043d \u043f\u0438\u0441\u0430\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u043c, \u043d\u043e \u0438
    \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0430\u043c, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0430\u043c,
    \u043f\u0430\u043f\u0435 \u0440\u0438\u043c\u0441\u043a\u043e\u043c\u0443 \u041b\u044c\u0432\u0443
    XIII (\u043f\u044b\u0442\u0430\u044f\u0441\u044c \u0443\u0431\u0435\u0434\u0438\u0442\u044c
    \u0412\u0430\u0442\u0438\u043a\u0430\u043d \u0432 \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0441\u0442\u0438
    \u0441\u0432\u043e\u0435\u0439 \u0442\u0435\u043e\u0440\u0438\u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438).
    \u041f\u043e\u043b\u0443\u0447\u0430\u044f \u043e\u0442\u043a\u0430\u0437, \u043e\u043d
    \u0432\u043f\u0430\u0434\u0430\u043b \u0432 \u044f\u0440\u043e\u0441\u0442\u044c. \u0421\u043a\u0440\u0438\u043f\u043a\u0430:
    \u0412 \u043a\u043b\u0438\u043d\u0438\u043a\u0435 \u0432\u0440\u0430\u0447\u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u043b\u0438
    \u0435\u043c\u0443 \u0438\u0433\u0440\u0430\u0442\u044c \u043d\u0430 \u0441\u043a\u0440\u0438\u043f\u043a\u0435,
    \u0442\u0430\u043a \u043a\u0430\u043a \u044d\u0442\u043e \u0431\u044b\u043b \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u0441\u043f\u043e\u0441\u043e\u0431 \u00ab\u0434\u043e\u0441\u0442\u0443\u0447\u0430\u0442\u044c\u0441\u044f\u00bb
    \u0434\u043e \u0435\u0433\u043e \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f. \u0418\u0433\u0440\u0430\u044f
    \u0411\u0435\u0442\u0445\u043e\u0432\u0435\u043d\u0430 \u0438 \u0411\u0430\u0445\u0430,
    \u043e\u043d \u043d\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0435 \u0447\u0430\u0441\u044b
    \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u043b\u0441\u044f \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c,
    \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0441\u044f \u0432\u043d\u043e\u0432\u044c
    \u0442\u0435\u043c \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u044b\u043c \u0438 \u043c\u044f\u0433\u043a\u0438\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043b\u044e\u0431\u0438\u043b\u0430 \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u044f.
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u0442\u043e\u043c,
    \u043a\u0430\u043a \u0446\u0435\u043d\u0430 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u043d\u0435\u043f\u043e\u043c\u0435\u0440\u043d\u043e
    \u0432\u044b\u0441\u043e\u043a\u043e\u0439. \u041e\u043d \u043e\u0442\u0434\u0430\u043b
    \u0441\u0432\u043e\u0439 \u0440\u0430\u0437\u0443\u043c \u0440\u0430\u0434\u0438 \u0442\u043e\u0433\u043e,
    \u0447\u0442\u043e\u0431\u044b \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043e
    \u043d\u0430\u0443\u0447\u0438\u043b\u043e\u0441\u044c \u0432\u0438\u0434\u0435\u0442\u044c
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c."
  personalLifeEn: 
  shortBioRu: "\u0413\u0435\u043e\u0440\u0433 \u041a\u0430\u043d\u0442\u043e\u0440 (1845\u20131918) \u2014
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e
    \u0432 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438.
    \u0415\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u2014 \u044d\u0442\u043e
    \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u043f\u0440\u043e\u0437\u0440\u0435\u043d\u0438\u0439, \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0451\u043d\u043d\u044b\u0445
    \u0441\u043f\u043e\u0440\u043e\u0432 \u0441 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438
    \u0438 \u0442\u044f\u0436\u0451\u043b\u043e\u0439 \u043b\u0438\u0447\u043d\u043e\u0439 \u0431\u043e\u0440\u044c\u0431\u044b.
    \u041f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e \u0432\u0430\u043c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439
    \u043e\u0431\u0437\u043e\u0440 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438 \u0438
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430.\n\n\U0001F30D \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u044e\u043d\u043e\u0441\u0442\u044c: \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433
    \u2013 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f \u0413\u0435\u043e\u0440\u0433 \u041a\u0430\u043d\u0442\u043e\u0440
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f 3 \u043c\u0430\u0440\u0442\u0430 (19 \u0444\u0435\u0432\u0440\u0430\u043b\u044f
    \u043f\u043e \u0441\u0442\u0430\u0440\u043e\u043c\u0443 \u0441\u0442\u0438\u043b\u044e)
    1845 \u0433\u043e\u0434\u0430 \u0432 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435,
    \u0432 \u0417\u0430\u043f\u0430\u0434\u043d\u043e\u0439 \u043a\u0443\u043f\u0435\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u043e\u043b\u043e\u043d\u0438\u0438. \u041e\u043d \u0431\u044b\u043b \u0441\u0442\u0430\u0440\u0448\u0438\u043c
    \u0438\u0437 \u0448\u0435\u0441\u0442\u0438 \u0434\u0435\u0442\u0435\u0439 \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0435.
    \u0421\u0435\u043c\u044c\u044f: \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u0413\u0435\u043e\u0440\u0433-\u0412\u043e\u043b\u044c\u0434\u0435\u043c\u0430\u0440
    \u041a\u0430\u043d\u0442\u043e\u0440, \u0431\u044b\u043b \u0434\u0430\u0442\u0441\u043a\u0438\u043c
    \u043f\u043e\u0434\u0434\u0430\u043d\u043d\u044b\u043c, \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u043c
    \u0431\u0438\u0440\u0436\u0435\u0432\u044b\u043c \u043c\u0430\u043a\u043b\u0435\u0440\u043e\u043c,
    \u0440\u043e\u0434\u043e\u043c \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u043f\u043e\u0440\u0442\u0443\u0433\u0430\u043b\u044c\u0441\u043a\u0438\u0445
    \u0435\u0432\u0440\u0435\u0435\u0432, \u043e\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
    \u0410\u043c\u0441\u0442\u0435\u0440\u0434\u0430\u043c\u0435. \u041c\u0430\u0442\u044c,
    \u041c\u0430\u0440\u0438\u044f-\u0410\u043d\u043d\u0430 \u0411\u0451\u043c, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u0430
    \u0438\u0437 \u0441\u0435\u043c\u044c\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445
    \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u043e\u0432; \u0435\u0451 \u0434\u044f\u0434\u044f
    \u0431\u044b\u043b \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c \u0441\u043a\u0440\u0438\u043f\u0430\u0447\u043e\u043c
    \u0419\u043e\u0437\u0435\u0444\u043e\u043c \u0411\u0451\u043c\u043e\u043c. \u0421\u0430\u043c
    \u0413\u0435\u043e\u0440\u0433 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u043c\u0443\u0437\u044b\u043a\u0435 \u0438
    \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u043e \u0438\u0433\u0440\u0430\u043b \u043d\u0430
    \u0441\u043a\u0440\u0438\u043f\u043a\u0435. \u041f\u0435\u0440\u0435\u0435\u0437\u0434:
    \u0412 1856 \u0433\u043e\u0434\u0443, \u0438\u0437-\u0437\u0430 \u0431\u043e\u043b\u0435\u0437\u043d\u0438
    \u043e\u0442\u0446\u0430, \u0441\u0435\u043c\u044c\u044f \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b\u0430
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044e \u0432 \u043f\u043e\u0438\u0441\u043a\u0430\u0445
    \u0431\u043e\u043b\u0435\u0435 \u043c\u044f\u0433\u043a\u043e\u0433\u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0430.
    \u041e\u043d\u0438 \u0436\u0438\u043b\u0438 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432
    \u0412\u0438\u0441\u0431\u0430\u0434\u0435\u043d\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c
    \u0432\u043e \u0424\u0440\u0430\u043d\u043a\u0444\u0443\u0440\u0442\u0435. \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u0412 1860 \u0433\u043e\u0434\u0443 \u041a\u0430\u043d\u0442\u043e\u0440 \u0441 \u043e\u0442\u043b\u0438\u0447\u0438\u0435\u043c
    \u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u0447\u0438\u043b\u0438\u0449\u0435 \u0432 \u0414\u0430\u0440\u043c\u0448\u0442\u0430\u0434\u0442\u0435,
    \u043f\u0440\u043e\u044f\u0432\u0438\u0432 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043a \u0442\u0440\u0438\u0433\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0412 1862 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0424\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u043b\u0438\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0432 \u0426\u044e\u0440\u0438\u0445\u0435,
    \u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u043e\u0442\u0446\u0430
    \u0432 1863 \u0433\u043e\u0434\u0443, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u0441\u043e\u043b\u0438\u0434\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e, \u043f\u0435\u0440\u0435\u0432\u0451\u043b\u0441\u044f
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0412 \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u043e\u043d \u0441\u043b\u0443\u0448\u0430\u043b
    \u043b\u0435\u043a\u0446\u0438\u0438 \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438: \u041a\u0430\u0440\u043b\u0430
    \u0412\u0435\u0439\u0435\u0440\u0448\u0442\u0440\u0430\u0441\u0441\u0430, \u042d\u0440\u043d\u0441\u0442\u0430
    \u041a\u0443\u043c\u043c\u0435\u0440\u0430 \u0438 \u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434\u0430
    \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u0430. \u041b\u0435\u0442\u043e\u043c 1866
    \u0433\u043e\u0434\u0430 \u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 \u0413\u0451\u0442\u0442\u0438\u043d\u0433\u0435\u043d\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u0412 1867 \u0433\u043e\u0434\u0443 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043f\u0440\u0438\u0441\u0432\u043e\u0438\u043b
    \u0435\u043c\u0443 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u043e\u043a\u0442\u043e\u0440\u0430
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0437\u0430 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u043f\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b.\n\n\U0001F9D1\u200d\U0001F3EB
    \u041d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0438 \u043f\u0435\u0440\u0432\u044b\u0435
    \u0448\u0430\u0433\u0438 \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432
    \u0421\u0432\u043e\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u041a\u0430\u043d\u0442\u043e\u0440 \u043d\u0430\u0447\u0430\u043b
    \u0441 \u043d\u0435\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u0439 \u0448\u043a\u043e\u043b\u0435
    \u0434\u043b\u044f \u0434\u0435\u0432\u043e\u0447\u0435\u043a. \u0412 1869 \u0433\u043e\u0434\u0443
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u0435\u0441\u0442\u043e \u0432
    \u0413\u0430\u043b\u043b\u044c\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041c\u0430\u0440\u0442\u0438\u043d\u0430
    \u041b\u044e\u0442\u0435\u0440\u0430), \u0433\u0434\u0435 \u0438 \u043f\u0440\u043e\u0448\u043b\u0430
    \u0432\u0441\u044f \u0435\u0433\u043e \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c. \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u043e\u0441\u0442: \u0412 1872 \u0433\u043e\u0434\u0443 \u043e\u043d \u0441\u0442\u0430\u043b
    \u044d\u043a\u0441\u0442\u0440\u0430\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u044b\u043c,
    \u0430 \u0432 1879 \u0433\u043e\u0434\u0443 \u2014 \u043f\u043e\u043b\u043d\u044b\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c. \u0412\u0430\u0436\u043d\u043e\u0435
    \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e: \u0412 1872 \u0433\u043e\u0434\u0443,
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0442\u043f\u0443\u0441\u043a\u0430 \u0432
    \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0438\u0438, \u041a\u0430\u043d\u0442\u043e\u0440
    \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u043c\u0441\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c \u0420\u0438\u0445\u0430\u0440\u0434\u043e\u043c
    \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u0435\u0433\u043e \u0431\u043b\u0438\u0437\u043a\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c
    \u0438 \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0435\u0434\u0438\u043d\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u0438\u043a\u043e\u043c.
    \u041c\u043d\u043e\u0433\u0438\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0438\u0434\u0435\u0438
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u0440\u043e\u0436\u0434\u0430\u043b\u0438\u0441\u044c
    \u0438 \u043e\u0442\u0442\u0430\u0447\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u0432 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0435\u0439
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0441 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u043c.
    \u041f\u0435\u0440\u0432\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b: \u0412 1872 \u0433\u043e\u0434\u0443
    \u041a\u0430\u043d\u0442\u043e\u0440 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430
    \u0447\u0435\u0440\u0435\u0437 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438
    \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0438\u0441\u0435\u043b
    (\u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0441 \u0434\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u043e\u0432\u044b\u043c\u0438 \u0441\u0435\u0447\u0435\u043d\u0438\u044f\u043c\u0438).\n\n\U0001F4A1
    \u0420\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435:
    \u0442\u0435\u043e\u0440\u0438\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438
    \u041f\u0435\u0440\u0435\u043b\u043e\u043c\u043d\u044b\u043c \u0441\u0442\u0430\u043b 1874
    \u0433\u043e\u0434, \u043a\u043e\u0433\u0434\u0430 \u041a\u0430\u043d\u0442\u043e\u0440
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0443,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0432\u0432\u0451\u043b \u043f\u043e\u043d\u044f\u0442\u0438\u0435
    \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430
    \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c
    \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u043f\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0443.
    \u0421\u0447\u0451\u0442\u043d\u044b\u0435 \u0438 \u043d\u0435\u0441\u0447\u0451\u0442\u043d\u044b\u0435
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430: \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0441\u0447\u0451\u0442\u043d\u043e (\u0442\u043e \u0435\u0441\u0442\u044c
    \u0435\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0432\u0437\u0430\u0438\u043c\u043d\u043e-\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e
    \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0441 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c\u0438
    \u0447\u0438\u0441\u043b\u0430\u043c\u0438), \u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e
    \u0432\u0441\u0435\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u043d\u0435\u0441\u0447\u0451\u0442\u043d\u043e. \u042d\u0442\u043e
    \u0431\u044b\u043b\u043e \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435, \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0448\u0435\u0435,
    \u0447\u0442\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043d\u0435
    \u043e\u0434\u043d\u0430, \u0430 \"\u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439\".
    \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438:
    \u0412 1877 \u0433\u043e\u0434\u0443 \u041a\u0430\u043d\u0442\u043e\u0440 \u0434\u043e\u043a\u0430\u0437\u0430\u043b
    \u0435\u0449\u0451 \u043e\u0434\u0438\u043d \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442: \u043c\u0435\u0436\u0434\u0443 \u0442\u043e\u0447\u043a\u0430\u043c\u0438
    \u043e\u0442\u0440\u0435\u0437\u043a\u0430 \u0438 \u0442\u043e\u0447\u043a\u0430\u043c\u0438
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430 (\u0438\u043b\u0438 \u0434\u0430\u0436\u0435
    \u043a\u0443\u0431\u0430) \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0437\u0430\u0438\u043c\u043d\u043e-\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0435
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435. \u042d\u0442\u043e
    \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e \u0443 \u043e\u0434\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u0445
    \u0438 \u0434\u0432\u0443\u043c\u0435\u0440\u043d\u044b\u0445 \u0444\u0438\u0433\u0443\u0440
    \u043e\u0434\u043d\u0430 \u0438 \u0442\u0430 \u0436\u0435 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c.
    \u0421\u0430\u043c \u041a\u0430\u043d\u0442\u043e\u0440 \u043f\u0438\u0441\u0430\u043b \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0443:
    \"\u042f \u0432\u0438\u0436\u0443 \u044d\u0442\u043e, \u043d\u043e \u043d\u0435 \u0432\u0435\u0440\u044e
    \u0432 \u044d\u0442\u043e!\". \u042d\u0442\u0438 \u0438\u0434\u0435\u0438 \u043b\u0435\u0433\u043b\u0438
    \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u0435\u0433\u043e \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0442\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u0438\u0437\u043b\u043e\u0436\u0438\u043b
    \u0432 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 1879\u20131884 \u0433\u043e\u0434\u043e\u0432
    \u0438 \u0432 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c
    \u0442\u0440\u0443\u0434\u0435 \"Beitr\u00e4ge zur Begr\u00fcndung der transfiniten Mengenlehre\"
    (\"\u041e\u0441\u043d\u043e\u0432\u044b \u0443\u0447\u0435\u043d\u0438\u044f \u043e \u0442\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430\u0445\", 1895\u20131897).\n\n\u2694\ufe0f
    \u0411\u0438\u0442\u0432\u0430 \u0438\u0434\u0435\u0439: \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u0441 \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u043e\u043c \u0438 \u043d\u0435\u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0422\u0435\u043e\u0440\u0438\u044f \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0430\u0441\u044c
    \u0441 \u044f\u0440\u043e\u0441\u0442\u043d\u044b\u043c \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435\u043c.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043e\u043f\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u043c
    \u0441\u0442\u0430\u043b \u0431\u044b\u0432\u0448\u0438\u0439 \u0443\u0447\u0438\u0442\u0435\u043b\u044c,
    \u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434 \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440,
    \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u043b\u044f\u0432\u0448\u0438\u0439 \u043a\u0430\u0444\u0435\u0434\u0440\u0443
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u041f\u0440\u0438\u0447\u0438\u043d\u0430
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430: \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440
    \u0431\u044b\u043b \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u043c \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c\u0438 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043e\u0431\u044a\u0435\u043a\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u0443\u0442
    \u0431\u044b\u0442\u044c \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u044b \u0437\u0430
    \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u0448\u0430\u0433\u043e\u0432.
    \u041f\u043e\u043d\u044f\u0442\u0438\u0435 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0438 \u043d\u0435\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u0431\u044b\u043b\u0438 \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u044b.
    \u041e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \"\u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0448\u0430\u0440\u043b\u0430\u0442\u0430\u043d\u043e\u043c\",
    \"\u0440\u0435\u043d\u0435\u0433\u0430\u0442\u043e\u043c\" \u0438 \"\u0440\u0430\u0441\u0442\u043b\u0438\u0442\u0435\u043b\u0435\u043c
    \u043c\u043e\u043b\u043e\u0434\u0451\u0436\u0438\". \u041f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f
    \u0432 \u043a\u0430\u0440\u044c\u0435\u0440\u0435: \u0418\u0437-\u0437\u0430 \u0432\u043b\u0438\u044f\u043d\u0438\u044f
    \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0443
    \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c
    \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0435, \u0438 \u043e\u043d \u043e\u0441\u0442\u0430\u043b\u0441\u044f
    \u0432 \u0413\u0430\u043b\u043b\u0435, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0435\u0433\u043e \u043c\u0435\u0447\u0442\u044b \u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0435
    \u0432 \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0415\u0433\u043e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u043d\u044b\u0435
    \u0441\u0442\u0430\u0442\u044c\u0438 \u0441 \u0442\u0440\u0443\u0434\u043e\u043c \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u0432 \u043f\u0435\u0447\u0430\u0442\u044c. \u041a\u0440\u0438\u0442\u0438\u043a\u0430
    \u0431\u044b\u043b\u0430 \u0441\u0442\u043e\u043b\u044c \u043e\u0436\u0435\u0441\u0442\u043e\u0447\u0451\u043d\u043d\u043e\u0439,
    \u0447\u0442\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a
    \u0410\u043d\u0440\u0438 \u041f\u0443\u0430\u043d\u043a\u0430\u0440\u0435 \u043d\u0430\u0437\u0432\u0430\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \"\u0442\u044f\u0436\u0451\u043b\u043e\u0439
    \u0431\u043e\u043b\u0435\u0437\u043d\u044c\u044e\", \u043f\u043e\u0440\u0430\u0437\u0438\u0432\u0448\u0435\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443. \u0422\u043e\u043b\u044c\u043a\u043e
    \u043f\u043e\u0437\u0436\u0435 \u0414\u0430\u0432\u0438\u0434 \u0413\u0438\u043b\u044c\u0431\u0435\u0440\u0442
    \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441\u0451\u0442 \u0441\u0432\u043e\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435
    \u0441\u043b\u043e\u0432\u0430: \"\u041d\u0438\u043a\u0442\u043e \u043d\u0435 \u0438\u0437\u0433\u043e\u043d\u0438\u0442
    \u043d\u0430\u0441 \u0438\u0437 \u0440\u0430\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u043e\u0437\u0434\u0430\u043b \u041a\u0430\u043d\u0442\u043e\u0440\".\n\n\U0001F494
    \u041b\u0438\u0447\u043d\u0430\u044f \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f: \u0433\u043e\u0434\u044b
    \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0438 \u043f\u043e\u0437\u0434\u043d\u0435\u0435
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0421 1884 \u0433\u043e\u0434\u0430
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0441\u0442\u0430\u043b \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044c
    \u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u0432 \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u044b
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0442 \u043a\u0430\u043a \u0441 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c
    \u043a\u0440\u0438\u0442\u0438\u043a\u0438, \u0442\u0430\u043a \u0438 \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c
    \u0431\u0438\u043f\u043e\u043b\u044f\u0440\u043d\u044b\u043c \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u043c.
    \u041d\u043e\u0432\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b: \u0412
    \u0442\u044f\u0436\u0451\u043b\u044b\u0435 \u043f\u0435\u0440\u0438\u043e\u0434\u044b \u043e\u043d
    \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u0438 \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c,
    \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c,
    \u0447\u0442\u043e \u0430\u0432\u0442\u043e\u0440\u043e\u043c \u043f\u044c\u0435\u0441 \u0428\u0435\u043a\u0441\u043f\u0438\u0440\u0430
    \u0431\u044b\u043b \u0424\u0440\u044d\u043d\u0441\u0438\u0441 \u0411\u044d\u043a\u043e\u043d
    (\u044d\u0442\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u044b\u043b\u0438\u043b\u043e\u0441\u044c
    \u0432 \u0434\u0432\u0430 \u043f\u0430\u043c\u0444\u043b\u0435\u0442\u0430). \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439
    \u0443\u0434\u0430\u0440: \u0412 1899 \u0433\u043e\u0434\u0443 \u0443\u043c\u0435\u0440
    \u0435\u0433\u043e \u043c\u043b\u0430\u0434\u0448\u0438\u0439 \u0441\u044b\u043d \u0420\u0443\u0434\u043e\u043b\u044c\u0444,
    \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0434\u043b\u044f \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u0442\u044f\u0436\u0451\u043b\u044b\u043c \u0443\u0434\u0430\u0440\u043e\u043c. \u0412
    1904 \u0433\u043e\u0434\u0443 \u0435\u0433\u043e \u043f\u043e\u0442\u0440\u044f\u0441\u043b\u0430
    \u043d\u0435\u0443\u0434\u0430\u0447\u043d\u0430\u044f \u043f\u043e\u043f\u044b\u0442\u043a\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u042e\u043b\u0438\u0443\u0441\u0430
    \u041a\u0451\u043d\u0438\u0433\u0430 \"\u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044c\"
    \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044e \u043d\u0430 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u043c
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0435 (\u043e\u0448\u0438\u0431\u043a\u0430
    \u041a\u0451\u043d\u0438\u0433\u0430 \u0431\u044b\u043b\u0430 \u0431\u044b\u0441\u0442\u0440\u043e
    \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430, \u043d\u043e \u041a\u0430\u043d\u0442\u043e\u0440\u0443
    \u044d\u0442\u043e \u043d\u0430\u043d\u0435\u0441\u043b\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e
    \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0442\u0440\u0430\u0432\u043c\u0443). \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e
    \u043e\u043d \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u043c\u043d\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432 \u043a\u043b\u0438\u043d\u0438\u043a\u0430\u0445.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0432\u0441\u0451 \u044d\u0442\u043e,
    \u041a\u0430\u043d\u0442\u043e\u0440 \u043d\u0435 \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u043b
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    \u041e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u041d\u0435\u043c\u0435\u0446\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (Deutsche Mathematiker-Vereinigung) \u0432
    1890 \u0433\u043e\u0434\u0443 \u0438 \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u044b\u043c
    \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u043e\u0440\u043e\u043c \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u043f\u0435\u0440\u0432\u044b\u0445 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445
    \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u043e\u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0432 1897 \u0433\u043e\u0434\u0443. \u0412 1904 \u0433\u043e\u0434\u0443 \u041a\u0430\u043d\u0442\u043e\u0440
    \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043c\u0435\u0434\u0430\u043b\u0438
    \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u0430 \u2014 \u0432\u044b\u0441\u0448\u0435\u0439
    \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.
    \u0415\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u0438 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e
    \u0437\u0430\u0432\u043e\u0451\u0432\u044b\u0432\u0430\u043b\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435
    \u0438 \u0441\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432
    \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0413\u0435\u043e\u0440\u0433 \u041a\u0430\u043d\u0442\u043e\u0440 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    6 \u044f\u043d\u0432\u0430\u0440\u044f 1918 \u0433\u043e\u0434\u0430 \u0432 \u0413\u0430\u043b\u043b\u0435
    \u043e\u0442 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430
    \u0432 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u043b\u0438\u043d\u0438\u043a\u0435."
  shortBioEn: 
  interestingFactsRu: "\u0411\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0413\u0435\u043e\u0440\u0433\u0430
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u043f\u043e\u043b\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0439 \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u043f\u0440\u043e\u0440\u044b\u0432\u043e\u0432, \u043d\u043e \u0438 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445,
    \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0445, \u0430 \u0438\u043d\u043e\u0433\u0434\u0430
    \u0438 \u0448\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u043a\u0430\u043b\u0435\u0439\u0434\u043e\u0441\u043a\u043e\u043f
    \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u0432: \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u0430\u044f
    \u044f\u0441\u043d\u043e\u0441\u0442\u044c \u0443\u043c\u0430 \u0441\u043e\u0441\u0435\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430
    \u0441 \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u044c\u044e, \u0430
    \u0441\u0442\u0440\u043e\u0433\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u2014 \u0441 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0432\u0438\u0434\u0435\u043d\u0438\u044f\u043c\u0438.
    \u0412\u043e\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430 \u0441\u0430\u043c\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0445
    \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432
    \u043e \u00ab\u043a\u043e\u0440\u043e\u043b\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438\u00bb.
    1.\n\n\U0001F3BB \u0421\u043a\u0440\u0438\u043f\u0430\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0447\u0443\u0442\u044c \u043d\u0435 \u0441\u0442\u0430\u043b \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u0438\u0435\u043c
    \u041c\u0430\u043b\u043e \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e
    \u041a\u0430\u043d\u0442\u043e\u0440 \u043c\u043e\u0433 \u0431\u044b \u0441\u0442\u0430\u0442\u044c
    \u043d\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0430
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c
    \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u043e\u043c. \u0412\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u0430\u044f
    \u0438\u0433\u0440\u0430: \u041e\u043d \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b
    \u0442\u0430\u043b\u0430\u043d\u0442 \u043e\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u043e\u0433\u043e
    \u0434\u044f\u0434\u0438, \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e
    \u0441\u043a\u0440\u0438\u043f\u0430\u0447\u0430 \u0419\u043e\u0437\u0435\u0444\u0430 \u0411\u0451\u043c\u0430.
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0438\u0433\u0440\u0430\u043b \u043d\u0430 \u0441\u043a\u0440\u0438\u043f\u043a\u0435
    \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435, \u0431\u043b\u0438\u0437\u043a\u043e\u043c
    \u043a \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u043d\u043e\u043c\u0443, \u0438 \u0432
    \u044e\u043d\u043e\u0441\u0442\u0438 \u0432\u0441\u0435\u0440\u044c\u0451\u0437 \u043a\u043e\u043b\u0435\u0431\u0430\u043b\u0441\u044f
    \u043c\u0435\u0436\u0434\u0443 \u043c\u0443\u0437\u044b\u043a\u043e\u0439 \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439.
    \u042f\u0437\u044b\u043a\u0438: \u041e\u043d \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e
    \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445
    \u044f\u0437\u044b\u043a\u0430\u0445 (\u0440\u0443\u0441\u0441\u043a\u043e\u043c, \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c,
    \u0434\u0430\u0442\u0441\u043a\u043e\u043c, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c,
    \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c, \u043b\u0430\u0442\u044b\u043d\u0438)
    \u0438 \u043b\u044e\u0431\u0438\u043b \u0434\u0435\u043a\u043b\u0430\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0428\u0435\u043a\u0441\u043f\u0438\u0440\u0430 \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435.
    \u0415\u0433\u043e \u0434\u043e\u043c \u0432 \u0413\u0430\u043b\u043b\u0435 \u0447\u0430\u0441\u0442\u043e
    \u043d\u0430\u043f\u043e\u043b\u043d\u044f\u043b\u0441\u044f \u043c\u0443\u0437\u044b\u043a\u043e\u0439
    \u2014 \u0411\u0430\u0445, \u0411\u0435\u0442\u0445\u043e\u0432\u0435\u043d \u0438 \u041c\u043e\u0446\u0430\u0440\u0442
    \u0431\u044b\u043b\u0438 \u0435\u0433\u043e \u00ab\u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c
    \u0434\u043e\u043f\u0438\u043d\u0433\u043e\u043c\u00bb. \u0412\u0440\u0430\u0447\u0438 \u0432
    \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u043b\u0438\u043d\u0438\u043a\u0435 \u043f\u043e\u0437\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438
    \u0441\u043a\u0440\u0438\u043f\u043a\u0443 \u043a\u0430\u043a \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e, \u0447\u0442\u043e\u0431\u044b \u00ab\u0432\u0435\u0440\u043d\u0443\u0442\u044c\u00bb
    \u0435\u0433\u043e \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c.
    --- 2.\n\n\U0001F575\ufe0f\u200d\u2642\ufe0f \u041e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0441\u0442\u044c
    \u0428\u0435\u043a\u0441\u043f\u0438\u0440\u043e\u043c \u0438 \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u0432\u00bb \u042d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u044b\u0439 \u043a\u0443\u0440\u044c\u0435\u0437\u043d\u044b\u0439 \u0444\u0430\u043a\u0442
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0412 1884 \u0433\u043e\u0434\u0443,
    \u043d\u0430\u0445\u043e\u0434\u044f\u0441\u044c \u0432 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439
    \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438 \u0438\u0437-\u0437\u0430 \u0442\u0440\u0430\u0432\u043b\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u041a\u0430\u043d\u0442\u043e\u0440
    \u0431\u0440\u043e\u0441\u0438\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443
    \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u0438
    \u0437\u0430\u043d\u044f\u043b\u0441\u044f... \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0430: \u041e\u043d
    \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d, \u0447\u0442\u043e \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u0432\u0441\u0435\u0445 \u043f\u044c\u0435\u0441 \u0423\u0438\u043b\u044c\u044f\u043c\u0430
    \u0428\u0435\u043a\u0441\u043f\u0438\u0440\u0430 \u043d\u0430 \u0441\u0430\u043c\u043e\u043c
    \u0434\u0435\u043b\u0435 \u0431\u044b\u043b \u0444\u0438\u043b\u043e\u0441\u043e\u0444 \u0438
    \u0443\u0447\u0435\u043d\u044b\u0439 \u0424\u0440\u044d\u043d\u0441\u0438\u0441 \u0411\u044d\u043a\u043e\u043d.
    \u00ab\u0421\u0442\u0440\u043e\u0433\u0438\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u00bb:
    \u041a\u0430\u043d\u0442\u043e\u0440 \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b \u0446\u0435\u043b\u043e\u0435
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e
    \u0434\u0432\u0443\u0445 \u043e\u0431\u044a\u0435\u043c\u0438\u0441\u0442\u044b\u0445 \u0431\u0440\u043e\u0448\u044e\u0440
    (\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0438\u043a\u0442\u043e \u043d\u0435
    \u043f\u043e\u043a\u0443\u043f\u0430\u043b), \u0433\u0434\u0435 \u043e\u043d \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0441\u0442\u0440\u043e\u0433\u043e\u00bb \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u044d\u0442\u0443 \u0442\u0435\u043e\u0440\u0438\u044e, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f
    \u0447\u0430\u0441\u0442\u043e\u0442\u043d\u043e\u0441\u0442\u044c \u0431\u0443\u043a\u0432
    \u0432 \u0442\u0435\u043a\u0441\u0442\u0430\u0445 (\u043f\u043e \u0441\u0443\u0442\u0438,
    \u043e\u043d \u0431\u044b\u043b \u043f\u0438\u043e\u043d\u0435\u0440\u043e\u043c \u0441\u0442\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u0438\u0438!).
    \u0421\u043c\u0435\u0445 \u043a\u043e\u043b\u043b\u0435\u0433: \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u044d\u0442\u043e \u0434\u0443\u0440\u043d\u044b\u043c
    \u0437\u043d\u0430\u043a\u043e\u043c \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u043c
    \u0431\u0435\u0437\u0443\u043c\u0438\u044f, \u043d\u043e \u0441\u0430\u043c \u041a\u0430\u043d\u0442\u043e\u0440
    \u043e\u0442\u043d\u043e\u0441\u0438\u043b\u0441\u044f \u043a \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u0447\u0435\u043d\u044c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e \u0438 \u043e\u0431\u0438\u0436\u0430\u043b\u0441\u044f,
    \u043a\u043e\u0433\u0434\u0430 \u0435\u0451 \u043d\u0435 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438
    \u0432\u0441\u0435\u0440\u044c\u0451\u0437. --- 3.\n\n\U0001F4DC \u041f\u0438\u0441\u044c\u043c\u0430
    \u041f\u0430\u043f\u0435 \u0420\u0438\u043c\u0441\u043a\u043e\u043c\u0443 \u0438 \u0442\u0435\u043e\u043b\u043e\u0433\u0430\u043c
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0431\u044b\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u043e
    \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u043c \u043b\u044e\u0442\u0435\u0440\u0430\u043d\u0438\u043d\u043e\u043c,
    \u043d\u043e \u0435\u0433\u043e \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0441\u0442\u044c
    \u0431\u044b\u043b\u0430 \u043e\u0447\u0435\u043d\u044c \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u2014 \u043e\u043d \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0447\u0430\u0441\u0442\u044c\u044e
    \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u044f. \u0410\u0442\u0430\u043a\u0430
    \u043d\u0430 \u0412\u0430\u0442\u0438\u043a\u0430\u043d: \u041a\u0430\u043d\u0442\u043e\u0440
    \u0437\u0430\u0432\u0430\u043b\u0438\u0432\u0430\u043b \u043f\u0438\u0441\u044c\u043c\u0430\u043c\u0438
    \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0431\u043e\u0433\u043e\u0441\u043b\u043e\u0432\u043e\u0432,
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u0435\u043f\u0438\u0441\u043a\u043e\u043f\u043e\u0432
    \u0438 \u0434\u0430\u0436\u0435 \u0441\u0430\u043c\u043e\u0433\u043e \u041f\u0430\u043f\u0443
    \u0420\u0438\u043c\u0441\u043a\u043e\u0433\u043e \u041b\u044c\u0432\u0430 XIII. \u041e\u043d
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0443\u0431\u0435\u0434\u0438\u0442\u044c \u0438\u0445,
    \u0447\u0442\u043e \u0442\u0435\u043e\u0440\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u0445
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0411\u043e\u0433\u0430
    \u0438 \u0447\u0442\u043e \u0446\u0435\u0440\u043a\u043e\u0432\u044c \u0434\u043e\u043b\u0436\u043d\u0430
    \u043f\u0440\u0438\u0437\u043d\u0430\u0442\u044c \u0435\u0433\u043e \u00ab\u0430\u043b\u0435\u0444\u044b\u00bb
    \u043a\u0430\u043a \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0411\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b. \u041e\u0442\u0432\u0435\u0442: \u041f\u0430\u043f\u0430
    \u0420\u0438\u043c\u0441\u043a\u0438\u0439 \u0432\u0435\u0436\u043b\u0438\u0432\u043e (\u043d\u043e
    \u0445\u043e\u043b\u043e\u0434\u043d\u043e) \u043f\u043e\u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u043b
    \u0435\u0433\u043e \u0437\u0430 \u043f\u0438\u0441\u044c\u043c\u0430, \u043d\u043e \u0434\u0430\u0436\u0435
    \u043d\u0435 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b \u0438\u0445. \u0410 \u043e\u0434\u0438\u043d
    \u0438\u0437 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u0442\u0435\u043e\u043b\u043e\u0433\u043e\u0432
    \u0432 \u043e\u0442\u0432\u0435\u0442 \u043f\u043e\u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u043b
    \u0435\u043c\u0443 \u00ab\u043b\u0435\u0447\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u0433\u043e\u0440\u0434\u044b\u043d\u0438\u00bb,
    \u0438\u0431\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0435\u0442
    \u043f\u043e\u0441\u0442\u0438\u0447\u044c \u0411\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c \u0443\u0442\u0440\u043e\u043c
    \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u0432\u0442\u0440\u0430\u043a\u043e\u043c. ---
    4.\n\n\U0001F94A \u0411\u043e\u043a\u0441\u0435\u0440\u0441\u043a\u0438\u0439 \u043f\u043e\u0435\u0434\u0438\u043d\u043e\u043a
    \u0441 \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u043e\u043c (\u0432 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435)
    \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u041a\u0430\u043d\u0442\u043e\u0440\u0430
    \u0441 \u041b\u0435\u043e\u043f\u043e\u043b\u044c\u0434\u043e\u043c \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u043e\u043c
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0439
    \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0435\u0439, \u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439
    \u00ab\u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0439 \u0432\u043e\u0439\u043d\u043e\u0439\u00bb
    \u0432 \u043f\u0438\u0441\u044c\u043c\u0430\u0445. \u041e\u0441\u043a\u043e\u0440\u0431\u043b\u0435\u043d\u0438\u044f:
    \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440 \u043d\u0430\u0437\u044b\u0432\u0430\u043b
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u00ab\u0448\u0430\u0440\u043b\u0430\u0442\u0430\u043d\u043e\u043c\u00bb,
    \u00ab\u043a\u043e\u0440\u0440\u0443\u043c\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c
    \u0443\u043c\u043e\u043c\u00bb \u0438 \u00ab\u0440\u0430\u0437\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043b\u0435\u043c
    \u043c\u043e\u043b\u043e\u0434\u0435\u0436\u0438\u00bb. \u041e\u0442\u0432\u0435\u0442 \u041a\u0430\u043d\u0442\u043e\u0440\u0430:
    \u0423\u0441\u0442\u0430\u0432 \u043e\u0442 \u043d\u0430\u043f\u0430\u0434\u043e\u043a,
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0432 \u043e\u0434\u043d\u043e\u043c \u0438\u0437
    \u043f\u0438\u0441\u0435\u043c \u0432\u044b\u0437\u0432\u0430\u043b \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u0430
    \u043d\u0430 \u0434\u0443\u044d\u043b\u044c! \u041a\u043e\u043d\u0435\u0447\u043d\u043e,
    \u0434\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0440\u0435\u043b\u044c\u0431\u044b
    \u043d\u0435 \u0434\u043e\u0448\u043b\u043e (\u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440
    \u043f\u0440\u043e\u0438\u0433\u043d\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043b \u0432\u044b\u0437\u043e\u0432),
    \u043d\u043e \u0441\u0430\u043c \u0444\u0430\u043a\u0442 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u0440\u0435\u0448\u0438\u0442\u044c
    \u0441\u043f\u043e\u0440 \u043d\u0430 \u043f\u0438\u0441\u0442\u043e\u043b\u0435\u0442\u0430\u0445,
    \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u043d\u0430\u043a\u0430\u043b\u0435 \u0441\u0442\u0440\u0430\u0441\u0442\u0435\u0439.
    \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b: \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440
    \u0443\u043c\u0435\u0440 \u0432 1891 \u0433\u043e\u0434\u0443. \u041f\u043e\u0441\u043b\u0435
    \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438 \u041a\u0430\u043d\u0442\u043e\u0440
    \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e
    \u0441\u043c\u0435\u0440\u0442\u044c \u041a\u0440\u043e\u043d\u0435\u043a\u0435\u0440\u0430
    \u2014 \u044d\u0442\u043e \u00ab\u0411\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u00bb \u0438
    \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0437\u0430 \u0433\u043e\u043d\u0435\u043d\u0438\u044f
    \u043d\u0430 \u0438\u0441\u0442\u0438\u043d\u0443. --- 5.\n\n\U0001F9E9 \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u00ab\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u00bb: \u041a\u0430\u043d\u0442\u043e\u0440\u043e\u0432\u043e
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u041a\u043e\u0433\u0434\u0430 \u041a\u0430\u043d\u0442\u043e\u0440
    \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u0441\u0432\u043e\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0435
    \u00ab\u043a\u0430\u043d\u0442\u043e\u0440\u043e\u0432\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e\u00bb
    (\u043f\u044b\u043b\u044c), \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b \u043e\u0434\u0438\u043d
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0444\u0440\u0430\u043a\u0442\u0430\u043b\u043e\u0432
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438. \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441:
    \u041e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e,
    \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0434\u043b\u0438\u043d\u0430 \u0440\u0430\u0432\u043d\u0430
    \u043d\u0443\u043b\u044e, \u043d\u043e \u0442\u043e\u0447\u0435\u043a \u0432 \u043d\u0435\u043c
    \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0436\u0435, \u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0432\u043e \u0432\u0441\u0435\u043c \u043e\u0442\u0440\u0435\u0437\u043a\u0435 \u043f\u0440\u044f\u043c\u043e\u0439
    (\u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u043d\u0442\u0438\u043d\u0443\u0443\u043c\u0430).
    \u0420\u0435\u0430\u043a\u0446\u0438\u044f: \u041a\u043e\u0433\u0434\u0430 \u043e\u043d
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b \u043e\u0431 \u044d\u0442\u043e\u043c
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c, \u043c\u043d\u043e\u0433\u0438\u0435 \u0440\u0435\u0448\u0438\u043b\u0438,
    \u0447\u0442\u043e \u043e\u043d \u0448\u0443\u0442\u0438\u0442 \u0438\u043b\u0438 \u0441\u043e\u0448\u0435\u043b
    \u0441 \u0443\u043c\u0430. \u041a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0438\u043c\u0435\u0442\u044c
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0442\u043e\u0447\u0435\u043a, \u0435\u0441\u043b\u0438 \u0438\u0445 \u043e\u0431\u0449\u0430\u044f
    \u0434\u043b\u0438\u043d\u0430 \u2014 \u043d\u043e\u043b\u044c? \u042d\u0442\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u043b\u043e
    \u0432\u0441\u0435\u0439 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438. \u0421\u0435\u0439\u0447\u0430\u0441
    \u044d\u0442\u043e\u0442 \u00ab\u043c\u043e\u043d\u0441\u0442\u0440\u00bb \u0438\u0437\u0443\u0447\u0430\u044e\u0442
    \u0432 \u043a\u0443\u0440\u0441\u0430\u0445 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u0435\u0440\u044b. --- 6.\n\n\U0001F37D
    \u042d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438
    \u0438 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u043e\u0441\u0442\u044c \u041a\u0430\u043a
    \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0433\u0435\u043d\u0438\u0438, \u041a\u0430\u043d\u0442\u043e\u0440
    \u0431\u044b\u043b \u0441\u0442\u0440\u0430\u0448\u043d\u043e \u0440\u0430\u0441\u0441\u0435\u044f\u043d
    \u0432 \u0431\u044b\u0442\u0443. \u0412\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0435\u0446-\u043d\u043e\u0432\u0430\u0442\u043e\u0440:
    \u0412 \u043a\u043e\u043d\u0446\u0435 XIX \u0432\u0435\u043a\u0430 \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0441\u0442\u0432\u043e
    \u0431\u044b\u043b\u043e \u044d\u043a\u0437\u043e\u0442\u0438\u043a\u043e\u0439. \u041a\u0430\u043d\u0442\u043e\u0440
    \u0441\u0442\u0430\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0432\u0435\u0433\u0435\u0442\u0430\u0440\u0438\u0430\u043d\u0446\u0435\u043c
    \u043f\u043e \u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c,
    \u0447\u0442\u043e \u0448\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043b\u043e \u0435\u0433\u043e
    \u043c\u044f\u0441\u043e\u0435\u0434\u043d\u044b\u0445 \u043a\u043e\u043b\u043b\u0435\u0433.
    \u041e\u0434\u0435\u0436\u0434\u0430: \u0415\u0433\u043e \u0436\u0435\u043d\u0430 \u0412\u0430\u043b\u043b\u0438
    \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0436\u0430\u043b\u043e\u0432\u0430\u043b\u0430\u0441\u044c
    \u0432 \u043f\u0438\u0441\u044c\u043c\u0430\u0445, \u0447\u0442\u043e \u043e\u043d \u0432\u044b\u0445\u043e\u0434\u0438\u0442
    \u0438\u0437 \u0434\u043e\u043c\u0430 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u043d\u043e\u0441\u043a\u0430\u0445
    \u0438\u043b\u0438 \u0432 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0445 \u0442\u0430\u043f\u043e\u0447\u043a\u0430\u0445,
    \u0435\u0441\u043b\u0438 \u0435\u0433\u043e \u043c\u044b\u0441\u043b\u0438 \u0431\u044b\u043b\u0438
    \u0437\u0430\u043d\u044f\u0442\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b. \u0415\u0434\u0430: \u041e\u043d \u043c\u043e\u0433
    \u043f\u0440\u043e\u0441\u0438\u0434\u0435\u0442\u044c \u0437\u0430 \u0441\u0442\u043e\u043b\u043e\u043c
    \u0441 \u043d\u0435\u0434\u043e\u0435\u0434\u0435\u043d\u043d\u044b\u043c \u0441\u0443\u043f\u043e\u043c
    6 \u0447\u0430\u0441\u043e\u0432, \u0443\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0438\u0441\u044c
    \u0432 \u043e\u0434\u043d\u0443 \u0442\u043e\u0447\u043a\u0443 \u0438 \u043f\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044f
    \u0432 \u0443\u043c\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435
    \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.
    --- 7.\n\n\U0001F92F \u00ab\u042f \u0432\u0438\u0436\u0443 \u044d\u0442\u043e, \u043d\u043e
    \u043d\u0435 \u0432\u0435\u0440\u044e \u0432 \u044d\u0442\u043e!\u00bb \u042d\u0442\u043e
    \u043e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0445
    \u0444\u0440\u0430\u0437 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442: \u0412 1877 \u0433\u043e\u0434\u0443 \u041a\u0430\u043d\u0442\u043e\u0440
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043c\u0435\u0436\u0434\u0443
    \u0442\u043e\u0447\u043a\u0430\u043c\u0438 \u043e\u0442\u0440\u0435\u0437\u043a\u0430 (1D)
    \u0438 \u0442\u043e\u0447\u043a\u0430\u043c\u0438 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0430
    (2D) \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0437\u0430\u0438\u043c\u043d\u043e-\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0435
    \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435. \u041e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043e\u0434\u043d\u043e\u043c\u0435\u0440\u043d\u044b\u0439
    \u043e\u0442\u0440\u0435\u0437\u043e\u043a \u0438 \u0434\u0432\u0443\u043c\u0435\u0440\u043d\u044b\u0439
    \u043a\u0432\u0430\u0434\u0440\u0430\u0442 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442
    \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0442\u043e\u0447\u0435\u043a. \u0428\u043e\u043a: \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u043e
    \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u043e, \u0447\u0442\u043e \u0432 \u043f\u0438\u0441\u044c\u043c\u0435
    \u0441\u0432\u043e\u0435\u043c\u0443 \u0434\u0440\u0443\u0433\u0443 \u0414\u0435\u0434\u0435\u043a\u0438\u043d\u0434\u0443
    \u043e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \"Je le vois, mais je ne le crois
    pas!\" \u00ab\u042f \u0432\u0438\u0436\u0443 \u044d\u0442\u043e, \u043d\u043e \u044f \u043d\u0435
    \u0432\u0435\u0440\u044e \u0432 \u044d\u0442\u043e!\u00bb. \u042d\u0442\u043e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0430\u043a\u0446\u0438\u044f
    \u0433\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043b\u043e\u043c\u0430\u043b
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044e.
    --- 8.\n\n\U0001F3B2 \u0418\u0433\u0440\u0430 \u0432 \u043a\u0430\u0440\u0442\u044b \u043a\u0430\u043a
    \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u041a\u0430\u043d\u0442\u043e\u0440 \u043e\u0431\u043e\u0436\u0430\u043b
    \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u043a\u0430\u0440\u0442\u044b, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432 \u0431\u0440\u0438\u0434\u0436 \u0438 \u0432\u0438\u0441\u0442. \u0418\u0433\u0440\u043e\u0432\u0430\u044f
    \u0442\u0435\u043e\u0440\u0438\u044f: \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u043a\u0430\u0440\u0442\u043e\u0447\u043d\u044b\u0435 \u0438\u0433\u0440\u044b
    \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u0435\u0433\u043e \u043c\u043e\u0437\u0433\u0443
    \u00ab\u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u044c\u0441\u044f\u00bb
    \u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c\u0441\u044f
    \u043e\u0442 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0445 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439.
    \u0412 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432
    \u0438 \u043a\u043e\u043b\u043b\u0435\u0433 \u043e\u043d \u043c\u043e\u0433 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u0442\u044c
    \u043a\u0440\u0443\u043f\u043d\u044b\u0435 \u0441\u0443\u043c\u043c\u044b (\u0447\u0442\u043e
    \u043e\u0447\u0435\u043d\u044c \u0437\u043b\u0438\u043b\u043e \u0435\u0433\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0443\u044e
    \u0436\u0435\u043d\u0443). \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0432 \u043a\u0430\u0440\u0442\u0430\u0445: \u0418\u043d\u043e\u0433\u0434\u0430, \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u044f
    \u043a\u0430\u0440\u0442\u044b, \u043e\u043d \u043d\u0430\u0447\u0438\u043d\u0430\u043b
    \u0431\u043e\u0440\u043c\u043e\u0442\u0430\u0442\u044c \u043f\u0440\u043e \u00ab\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u043d\u044b\u0435
    \u0432\u0437\u0440\u044b\u0432\u044b\u00bb \u0438 \u00ab\u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a\u00bb,
    \u0447\u0435\u043c \u0432\u0433\u043e\u043d\u044f\u043b \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u043e\u0432
    \u0432 \u0441\u0442\u0443\u043f\u043e\u0440. --- 9.\n\n\U0001F4C9 \u0424\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0435
    \u0431\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0432 \u043a\u043e\u043d\u0446\u0435 \u0436\u0438\u0437\u043d\u0438
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0431\u044b\u043b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c,
    \u043e\u043d \u0443\u043c\u0435\u0440 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0431\u0435\u0434\u043d\u044f\u043a\u043e\u043c. \u041f\u0440\u0438\u0447\u0438\u043d\u0430:
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u043e\u043d
    \u0436\u0438\u043b \u043d\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e
    \u043e\u0442\u0446\u0430 \u0438 \u043d\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b
    \u043f\u0440\u0438\u0431\u0430\u0432\u043a\u0438 \u043a \u0436\u0430\u043b\u043e\u0432\u0430\u043d\u044c\u044e.
    \u041a\u043e\u0433\u0434\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u043e
    \u043a\u043e\u043d\u0447\u0438\u043b\u043e\u0441\u044c, \u0430 \u0438\u043d\u0444\u043b\u044f\u0446\u0438\u044f
    \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u041f\u0435\u0440\u0432\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u0432\u043e\u0439\u043d\u044b \u0432\u0437\u043b\u0435\u0442\u0435\u043b\u0430, \u0435\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u043e\u043a\u043b\u0430\u0434\u0430
    \u0432 \u0437\u0430\u0445\u043e\u043b\u0443\u0441\u0442\u043d\u043e\u043c \u0413\u0430\u043b\u043b\u0435
    \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u043e \u0445\u0432\u0430\u0442\u0430\u0442\u044c.
    \u0423\u043d\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0444\u0430\u043a\u0442:
    \u0427\u0442\u043e\u0431\u044b \u043e\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u0432 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u043b\u0438\u043d\u0438\u043a\u0435, \u0435\u0433\u043e \u0436\u0435\u043d\u0430
    \u0412\u0430\u043b\u043b\u0438 \u0431\u044b\u043b\u0430 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u0430
    \u043f\u0438\u0441\u0430\u0442\u044c \u0443\u043d\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043f\u0440\u043e\u0448\u0435\u043d\u0438\u044f \u043e \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0439
    \u043f\u043e\u043c\u043e\u0449\u0438 \u0432 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0438 \u0432 \u0411\u0435\u0440\u043b\u0438\u043d\u0441\u043a\u0443\u044e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e
    \u043d\u0430\u0443\u043a (\u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043a\u043e\u0433\u0434\u0430-\u0442\u043e
    \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0430 \u041a\u0430\u043d\u0442\u043e\u0440\u0443
    \u0432 \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u0435). \u0415\u0439 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u0441 \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u043e\u0439: \u00ab\u0415\u0433\u043e
    \u0442\u0435\u043e\u0440\u0438\u0438 \u043d\u0435 \u0438\u043c\u0435\u044e\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438\u00bb. --- 10.\n\n\U0001F6F8 \u0410\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0430\u044f
    \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c \u043a\u0430\u043a
    \u0411\u043e\u0433 \u041a\u0430\u043d\u0442\u043e\u0440 \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u043b
    \u0434\u0432\u0430 \u0432\u0438\u0434\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438:
    1. \u0422\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u0435 \u0447\u0438\u0441\u043b\u0430
    (\u0410\u043b\u0435\u0444\u044b): \u042d\u0442\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0436\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438, \u043e\u043d\u0438
    \u00ab\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u00bb \u0443\u043c\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.
    2. \u0410\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0430\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c:
    \u042d\u0442\u043e \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0435\u043b\u044c\u0437\u044f \u043d\u0438
    \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c, \u043d\u0438 \u0434\u0430\u0436\u0435
    \u043f\u043e\u043d\u044f\u0442\u044c. \u041a\u0430\u043d\u0442\u043e\u0440 \u043f\u0440\u044f\u043c\u043e
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u043b \u0435\u0451 \u0441 \u0411\u043e\u0433\u043e\u043c.
    \u041c\u0438\u0441\u0442\u0438\u043a\u0430: \u041e\u043d \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435
    \u0432\u0435\u0440\u0438\u043b, \u0447\u0442\u043e \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0438\u044f
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432 \u0431\u044b\u043b\u0430 \u043d\u0438\u0441\u043f\u043e\u0441\u043b\u0430\u043d\u0430
    \u0435\u043c\u0443 \u0411\u043e\u0433\u043e\u043c \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e,
    \u043a\u0430\u043a \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u0435. \u0412
    \u043f\u0435\u0440\u0438\u043e\u0434\u044b \u043c\u0430\u043d\u0438\u0438 \u043e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u00ab\u0432\u0438\u0434\u0438\u0442 \u0442\u0440\u0430\u043d\u0441\u0444\u0438\u043d\u0438\u0442\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430\u00bb \u0432 \u044f\u0440\u043a\u0438\u0445 \u0446\u0432\u0435\u0442\u043d\u044b\u0445
    \u043e\u0431\u0440\u0430\u0437\u0430\u0445, \u0441\u043b\u043e\u0432\u043d\u043e \u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0438.
    --- 11.\n\n\U0001F3C6 \u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0432 \u0447\u0443\u0436\u0438\u0445
    \u043a\u0440\u0430\u044f\u0445 \u041f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u043d\u0430 \u0440\u043e\u0434\u0438\u043d\u0435 \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438
    \u041a\u0430\u043d\u0442\u043e\u0440\u0430 \u0442\u0440\u0430\u0432\u0438\u043b\u0438, \u043d\u043e
    \u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0435\u0439 \u0435\u0433\u043e \u0443\u0432\u0430\u0436\u0430\u043b\u0438.
    \u041c\u0435\u0434\u0430\u043b\u044c \u0421\u0438\u043b\u044c\u0432\u0435\u0441\u0442\u0440\u0430
    (1904): \u042d\u0442\u043e \u0432\u044b\u0441\u0448\u0430\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u0430
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u041a\u043e\u0433\u0434\u0430 \u041a\u0430\u043d\u0442\u043e\u0440
    \u043f\u0440\u0438\u0435\u0445\u0430\u043b \u0432 \u0410\u043d\u0433\u043b\u0438\u044e \u0437\u0430
    \u043c\u0435\u0434\u0430\u043b\u044c\u044e, \u0435\u0433\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0438
    \u043a\u0430\u043a \u0433\u0435\u0440\u043e\u044f. \u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0435
    \u0438 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0430\u043f\u043b\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0435\u043c\u0443
    \u0441\u0442\u043e\u044f, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a
    \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0435 \u043a\u043e\u043b\u043b\u0435\u0433\u0438
    \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0435\u0433\u043e.
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0431\u044b\u043b \u0442\u0430\u043a \u0442\u0440\u043e\u043d\u0443\u0442
    \u044d\u0442\u0438\u043c, \u0447\u0442\u043e \u043f\u043b\u0430\u043a\u0430\u043b \u043d\u0430
    \u0446\u0435\u0440\u0435\u043c\u043e\u043d\u0438\u0438. --- 12.\n\n\U0001F635 \u0421\u043c\u0435\u0440\u0442\u044c
    \u0432 \u0434\u0435\u043d\u044c... \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430?
    \u041a\u0430\u043d\u0442\u043e\u0440 \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    6 \u044f\u043d\u0432\u0430\u0440\u044f 1918 \u0433\u043e\u0434\u0430 \u0432 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u043b\u0438\u043d\u0438\u043a\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,
    \u0447\u0442\u043e \u0432 \u0435\u0433\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u043e\u043d \u0431\u044b\u043b \u043e\u0434\u0435\u0440\u0436\u0438\u043c
    \u0438\u0434\u0435\u0435\u0439, \u0447\u0442\u043e 6 \u044f\u043d\u0432\u0430\u0440\u044f
    \u2014 \u044d\u0442\u043e \u0440\u043e\u043a\u043e\u0432\u0430\u044f \u0434\u0430\u0442\u0430.
    \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e\u0442 \u0434\u0435\u043d\u044c \u043f\u0440\u043e\u0438\u0437\u043e\u0439\u0434\u0435\u0442
    \u043d\u0435\u043a\u043e\u0435 \u00ab\u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u0435\u00bb
    \u0438\u043b\u0438 \u00ab\u043a\u043e\u043d\u0435\u0446 \u0441\u0432\u0435\u0442\u0430\u00bb
    (\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0435 \u0441 \u0435\u0433\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f\u043c\u0438
    \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432).
    \u0418\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b: \u043e\u043d
    \u043e\u0448\u0438\u0431\u0441\u044f \u0432 \u0441\u0432\u043e\u0438\u0445 \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u0430\u0445,
    \u043d\u043e \u0443\u043c\u0435\u0440 \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u0443
    \u0434\u0430\u0442\u0443, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0441\u0430\u043c
    \u0436\u0435 \u0438 \u0441\u0447\u0438\u0442\u0430\u043b \u0441\u0430\u043a\u0440\u0430\u043b\u044c\u043d\u043e\u0439.
    --- \u0413\u0435\u043e\u0440\u0433 \u041a\u0430\u043d\u0442\u043e\u0440 \u0431\u044b\u043b
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0432\u0438\u0434\u0435\u043b \u043c\u0438\u0440 \u043d\u0435 \u0442\u0430\u043a\u0438\u043c,
    \u043a\u0430\u043a \u0432\u0441\u0435. \u041e\u043d \u0441\u043c\u043e\u0442\u0440\u0435\u043b
    \u043d\u0430 \u043f\u0443\u0441\u0442\u043e\u0442\u0443 \u0438 \u0432\u0438\u0434\u0435\u043b
    \u0442\u0430\u043c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u0443\u044e \u043a\u0440\u0430\u0441\u043e\u0442\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438. \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c
    \u2014 \u044d\u0442\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0431\u0435\u0437\u0443\u043c\u0438\u0435 \u0438\u043d\u043e\u0433\u0434\u0430 \u0445\u043e\u0434\u044f\u0442
    \u0440\u0443\u043a\u0430 \u043e\u0431 \u0440\u0443\u043a\u0443, \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e
    \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u044d\u0442\u043e\u043c\u0443 \u00ab\u0431\u0435\u0437\u0443\u043c\u0438\u044e\u00bb
    \u043c\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0438\u043c\u0435\u0435\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443."
