    \u0433\u0440\u0443\u043f\u043f\u044b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432, \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0431\u044b\u043b \u0412\u0435\u0439\u043b\u044c. \u041e\u0442 \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043b\u0430
    \u0435\u0433\u043e, \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u0441\u043f\u0430\u0441\u043b\u043e
    \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e
    \u0444\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u0420\u043e\u043b\u044c\u0444\u0430 \u041d\u0435\u0432\u0430\u043d\u043b\u0438\u043d\u043d\u044b.\n\n\U0001F4D6
    \u0423\u0447\u0451\u0431\u0430 \u0438 \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442,
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0432\u0448\u0438\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u0443
    \u041b\u044e\u0431\u043e\u0432\u044c \u043a \u0434\u0440\u0435\u0432\u043d\u0438\u043c \u044f\u0437\u044b\u043a\u0430\u043c
    \u0441\u044b\u0433\u0440\u0430\u043b\u0430 \u0432 \u0441\u0443\u0434\u044c\u0431\u0435 \u0412\u0435\u0439\u043b\u044f
    \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0431\u0430\u0432\u043d\u0443\u044e
    \u0440\u043e\u043b\u044c. \u041a\u043e\u0433\u0434\u0430 \u043f\u043e\u0441\u043b\u0435
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439 \u0443\u0447\u0435\u0431\u044b \u0438
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u043e\u043d \u043d\u0435
    \u043c\u043e\u0433 \u043d\u0430\u0439\u0442\u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0443\u044e
    \u0440\u0430\u0431\u043e\u0442\u0443 \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438,
    \u0438\u043c\u0435\u043d\u043d\u043e \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a
    \u043f\u043e \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442\u0443, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0421\u0438\u043b\u044c\u0432\u0435\u043d \u041b\u0435\u0432\u0438, \u043f\u043e\u043c\u043e\u0433
    \u0435\u043c\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u0433\u043e\u0440\u043e\u0434\u0430
    \u0410\u043b\u0438\u0433\u0430\u0440\u0445. \u0422\u0430\u043a \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435
    \u044f\u0437\u044b\u043a\u0430\u043c\u0438 \u043e\u0442\u043a\u0440\u044b\u043b\u043e \u043f\u0435\u0440\u0435\u0434
    \u043d\u0438\u043c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0441\u0442\u0440\u0430\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u043f\u043e\u043b\u044e\u0431\u0438\u043b \u0437\u0430\u043e\u0447\u043d\u043e.\n\n\U0001F91D
    \u041d\u0435\u0442, \u043e\u043d \u043d\u0435 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a
