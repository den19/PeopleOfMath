    \u0440\u043e\u0441\u043b\u0438 \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0435
    \u043b\u044e\u0431\u0432\u0438 \u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0430. \u0421\u0435\u043c\u044c\u044f \u0434\u0440\u0443\u0436\u0438\u043b\u0430
    \u0441 \u043d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0438\u043c \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c
    \u0418\u043b\u044c\u0435\u0439 \u041c\u0435\u0447\u043d\u0438\u043a\u043e\u0432\u044b\u043c.
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u0412\u0435\u0439\u043b\u044f \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u0432 \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u043a\u0435: \u043e\u043d
    \u0432\u044b\u0443\u0447\u0438\u043b \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439, \u043f\u043e\u0434\u0441\u043b\u0443\u0448\u0438\u0432\u0430\u044f
    \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u044b \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439,
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0443\u0432\u043b\u0435\u043a\u0441\u044f \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u043c,
    \u043b\u0430\u0442\u044b\u043d\u044c\u044e \u0438 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043d\u0430\u0447\u0430\u043b \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0421\u0438\u043b\u044c\u0432\u0435\u043d\u0430
    \u041b\u0435\u0432\u0438. \u0415\u0433\u043e \u0440\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b
    \u043f\u0440\u0438\u0448\u043b\u0438\u0441\u044c \u043d\u0430 \u041f\u0435\u0440\u0432\u0443\u044e
    \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u0432\u043e\u0439\u043d\u0443: \u043e\u0442\u0446\u0430
    \u043f\u0440\u0438\u0437\u0432\u0430\u043b\u0438 \u0432\u043e\u0435\u043d\u043d\u044b\u043c
    \u0432\u0440\u0430\u0447\u043e\u043c, \u0438 \u0441\u0435\u043c\u044c\u044f \u0447\u0430\u0441\u0442\u043e
    \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043b\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u0410\u043d\u0434\u0440\u0435 \u0438\u043d\u043e\u0433\u0434\u0430 \u0443\u0447\u0438\u043b\u0441\u044f
    \u0434\u043e\u043c\u0430. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435,
    \u043e\u043d \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e \u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0448\u043a\u043e\u043b\u0443 \u0438 \u0432 1920-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0412\u044b\u0441\u0448\u0443\u044e
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0448\u043a\u043e\u043b\u0443
    (\u00c9cole Normale Sup\u00e9rieure) \u2014 \u043b\u0443\u0447\u0448\u0435\u0435 \u0432\u044b\u0441\u0448\u0435\u0435
    \u0443\u0447\u0435\u0431\u043d\u043e\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438.\n\n\U0001F393 \u0423\u0447\u0451\u0431\u0430
    \u0438 \u043d\u0430\u0447\u0430\u043b\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0412
    \u0412\u044b\u0441\u0448\u0435\u0439 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439
    \u0448\u043a\u043e\u043b\u0435 \u0412\u0435\u0439\u043b\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e
    \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 (\u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0440\u0430\u0431\u043e\u0442\u044b \u0420\u0438\u043c\u0430\u043d\u0430), \u043d\u043e
    \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0437\u0430\u043d\u044f\u0442\u0438\u044f
    \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442\u043e\u043c \u0438 \u0434\u0440\u0435\u0432\u043d\u0435\u0438\u043d\u0434\u0438\u0439\u0441\u043a\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439 \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0421\u0438\u043b\u044c\u0432\u0435\u043d\u0430 \u041b\u0435\u0432\u0438. \u0425\u043e\u0442\u044f
    \u043e\u043d \u0431\u044b\u043b \u0434\u0430\u043b\u0435\u043a \u043e\u0442 \u0440\u0435\u043b\u0438\u0433\u0438\u0438,
    \u0434\u0440\u0435\u0432\u043d\u0435\u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u0435
    \u0442\u0435\u043a\u0441\u0442\u044b \u043f\u043e\u0437\u0436\u0435 \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438
    \u043d\u0430 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f.
    \u0412 1928 \u0433\u043e\u0434\u0443 \u0412\u0435\u0439\u043b\u044c \u0437\u0430\u0449\u0438\u0442\u0438\u043b
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    \u0416\u0430\u043a\u0430 \u0410\u0434\u0430\u043c\u0430\u0440\u0430 \u0438 \u042d\u043c\u0438\u043b\u044f
    \u041f\u0438\u043a\u0430\u0440\u0430. \u0415\u0433\u043e \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044f
    \u0432\u043e\u0448\u043b\u0430 \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438. \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0449\u0438\u0442\u044b
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e
    \u0434\u043b\u044f \u043f\u043e\u0435\u0437\u0434\u043e\u043a \u043f\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c
    \u0446\u0435\u043d\u0442\u0440\u0430\u043c \u0418\u0442\u0430\u043b\u0438\u0438 \u0438 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438.
    \u0412\u0430\u0436\u043d\u044b\u043c \u044d\u0442\u0430\u043f\u043e\u043c \u0441\u0442\u0430\u043b\u043e
    \u0435\u0433\u043e \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0441 \u042d\u043c\u043c\u0438
    \u041d\u0451\u0442\u0435\u0440, \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0441\u0442\u043e\u043c,
    \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438 \u0438 \u0447\u044c\u0438 \u0438\u0434\u0435\u0438
    \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u043d\u0430 \u043d\u0435\u0433\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435.\n\n\U0001F1EE\U0001F1F3 \u0418\u043d\u0434\u0438\u0439\u0441\u043a\u0430\u044f
    \u043e\u0434\u0438\u0441\u0441\u0435\u044f \u041f\u043e\u0441\u043b\u0435 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0435\u0439
    \u0432\u0430\u043a\u0430\u043d\u0441\u0438\u0438 \u0434\u043b\u044f \u0412\u0435\u0439\u043b\u044f
    \u043d\u0435 \u0431\u044b\u043b\u043e. \u0422\u043e\u0433\u0434\u0430 \u0435\u0433\u043e
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a \u043f\u043e \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442\u0443
    \u0421\u0438\u043b\u044c\u0432\u0435\u043d \u041b\u0435\u0432\u0438 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0441\u044f
    \u043e \u0435\u0433\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u043c
    \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0410\u043b\u0438\u0433\u0430\u0440\u0445\u0430
    \u0432 \u0411\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0439 \u0418\u043d\u0434\u0438\u0438.
    \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0435
    \u0438 \u0441\u043c\u0435\u043b\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435.
    \u0414\u0432\u0430 \u0433\u043e\u0434\u0430 \u0432 \u0418\u043d\u0434\u0438\u0438 \u0441\u0442\u0430\u043b\u0438
    \u0434\u043b\u044f \u0412\u0435\u0439\u043b\u044f \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0443\u0441\u043f\u0435\u0445\u043e\u0432, \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0439
    \u043f\u043e \u0441\u0442\u0440\u0430\u043d\u0435 \u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430
    \u0441 \u043c\u0435\u0441\u0442\u043d\u044b\u043c\u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u0430\u043c\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041c\u0430\u0445\u0430\u0442\u043c\u0443 \u0413\u0430\u043d\u0434\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e\u043f\u044b\u0442\u043a\u0438 \u0440\u0435\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c
    \u043d\u0430 \u043c\u0435\u0441\u0442\u043d\u0443\u044e \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0443
    \u0438 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435
    \u0438\u043d\u0442\u0440\u0438\u0433\u0438, \u0438 \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0442\u043e\u0440\u0430
    \u0433\u043e\u0434\u0430 \u0435\u0433\u043e \u0443\u0432\u043e\u043b\u0438\u043b\u0438.\n\n\U0001F3DB\ufe0f
    \u0421\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435: \u0411\u0443\u0440\u0431\u0430\u043a\u0438
    \u0438 \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c
    \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e, \u0412\u0435\u0439\u043b\u044c
    \u0432 1933 \u0433\u043e\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u0435\u0441\u0442\u043e
    \u0432 \u0421\u0442\u0440\u0430\u0441\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435.
    \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c \u043e\u043d \u0432\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0433\u0440\u0443\u043f\u043f\u043e\u0439 \u043c\u043e\u043b\u043e\u0434\u044b\u0445
    \u0435\u0434\u0438\u043d\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    (\u0410\u043d\u0440\u0438 \u041a\u0430\u0440\u0442\u0430\u043d, \u0416\u0430\u043d \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435,
    \u041a\u043b\u043e\u0434 \u0428\u0435\u0432\u0430\u043b\u043b\u0435) \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b
    \u041d\u0438\u043a\u043e\u043b\u044f \u0411\u0443\u0440\u0431\u0430\u043a\u0438. \u0412
    1937 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430
    \u042d\u0432\u0435\u043b\u0438\u043d\u0435, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0443 \u043d\u0435\u0433\u043e \u043f\u043e\u0437\u0436\u0435 \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0441\u044b\u043d.\n\n\u2694\ufe0f \u0412\u043e\u0439\u043d\u0430 \u0438 \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0439
    \u043f\u043e\u0431\u0435\u0433 \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0412\u0442\u043e\u0440\u043e\u0439
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b \u0412\u0435\u0439\u043b\u044c
    \u0441 \u0436\u0435\u043d\u043e\u0439 \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c
    \u0432 \u0424\u0438\u043d\u043b\u044f\u043d\u0434\u0438\u0438. \u041f\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c
    \u0437\u0430\u043a\u043e\u043d\u0430\u043c, \u043e\u043d \u0431\u044b\u043b \u043e\u0431\u044f\u0437\u0430\u043d
    \u044f\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0441\u0431\u043e\u0440\u043d\u044b\u0439
    \u043f\u0443\u043d\u043a\u0442. \u041e\u0434\u043d\u0430\u043a\u043e \u0412\u0435\u0439\u043b\u044c,
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u0439, \u0447\u0442\u043e \u0435\u0433\u043e
    \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u0438\u0435 \u2014 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u0430 \u043d\u0435 \u0432\u043e\u0439\u043d\u0430, \u0440\u0435\u0448\u0438\u043b \u0443\u043a\u043b\u043e\u043d\u0438\u0442\u044c\u0441\u044f
    \u043e\u0442 \u043c\u043e\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438. \u042d\u0442\u043e
    \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443
    \u044d\u043f\u0438\u0437\u043e\u0434\u0443: \u0435\u0433\u043e \u0437\u0430\u043f\u043e\u0434\u043e\u0437\u0440\u0438\u043b\u0438
    \u0432 \u0448\u043f\u0438\u043e\u043d\u0430\u0436\u0435, \u0438 \u043e\u043d \u0431\u044b\u043b
    \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u0430\u043d. \u041e\u0442 \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043b\u0430
    \u0435\u0433\u043e \u0441\u043f\u0430\u0441\u043b\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u0444\u0438\u043d\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0420\u043e\u043b\u044c\u0444\u0430
    \u041d\u0435\u0432\u0430\u043d\u043b\u0438\u043d\u043d\u044b. \u041f\u043e\u0441\u043b\u0435
    \u044d\u0442\u043e\u0433\u043e \u043e\u043d \u0441\u0443\u043c\u0435\u043b \u0432\u044b\u0435\u0445\u0430\u0442\u044c
    \u0438\u0437 \u0424\u0438\u043d\u043b\u044f\u043d\u0434\u0438\u0438 \u0438 \u0432 1941 \u0433\u043e\u0434\u0443
    \u043f\u0440\u0438\u0431\u044b\u043b \u0432 \u0421\u0428\u0410.\n\n\U0001F1FA\U0001F1F8
    \u0416\u0438\u0437\u043d\u044c \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u0410\u043c\u0435\u0440\u0438\u043a\u0435
    \u0412 \u0410\u043c\u0435\u0440\u0438\u043a\u0435 \u0412\u0435\u0439\u043b\u044c \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u041b\u0438\u0445\u0430\u0439\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435, \u0433\u0434\u0435
    \u0435\u0433\u043e \u043d\u0435 \u0446\u0435\u043d\u0438\u043b\u0438, \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0430\u043b\u0438
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435\u043c \u0438 \u043f\u043b\u0430\u0442\u0438\u043b\u0438
    \u043c\u0430\u043b\u043e. \u041e\u043d \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b
    \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0438 \u043f\u043e\u043a\u043b\u044f\u043b\u0441\u044f
    \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043e \u043d\u0435\u043c \u043d\u0435 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c.
    \u0417\u0430\u0442\u0435\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u0432 \u0421\u0430\u043d-\u041f\u0430\u0443\u043b\u0443
    (\u0411\u0440\u0430\u0437\u0438\u043b\u0438\u044f) \u0432 1945\u20131947 \u0433\u043e\u0434\u0430\u0445,
    \u0433\u0434\u0435 \u043e\u043d, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b \u0441 \u041e\u0441\u043a\u0430\u0440\u043e\u043c
    \u0417\u0430\u0440\u0438\u0441\u043a\u0438\u043c. \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e
    \u0412\u0435\u0439\u043b\u044c \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u0421\u0428\u0410
    \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0432 \u0427\u0438\u043a\u0430\u0433\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (1947\u20131958),
    \u0430 \u0437\u0430\u0442\u0435\u043c \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435 (1958\u20131976), \u0433\u0434\u0435
    \u0438 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u0434\u043e \u043a\u043e\u043d\u0446\u0430
    \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F91D \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0443\u0447\u0435\u043d\u044b\u043c\u0438
    \u041e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0433\u0440\u0443\u043f\u043f\u044b \u0411\u0443\u0440\u0431\u0430\u043a\u0438 \u0438 \u0442\u0435\u0441\u043d\u043e
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b \u0441 \u0410\u043d\u0440\u0438
    \u041a\u0430\u0440\u0442\u0430\u043d\u043e\u043c, \u0416\u0430\u043d\u043e\u043c \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435,
    \u041a\u043b\u043e\u0434\u043e\u043c \u0428\u0435\u0432\u0430\u043b\u043b\u0435. \u0415\u0433\u043e
    \u0443\u0447\u0435\u043d\u0438\u043a\u0430\u043c\u0438 \u0431\u044b\u043b\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u041f\u044c\u0435\u0440 \u041a\u0430\u0440\u0442\u044c\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043e \u043d\u0435\u043c
    \u043f\u0440\u043e\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0435 \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438
    \u0441\u0442\u043e\u043b\u043f\u0430\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b\u0438\u0441\u044c \u043f\u043e-\u0440\u0430\u0437\u043d\u043e\u043c\u0443.
    \u0415\u0433\u043e \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u043b\u0430 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u044f\u044f
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438, \u0442\u0430\u043a\u0438\u043c\u0438
    \u043a\u0430\u043a \u041a\u043b\u043e\u0434 \u041b\u0435\u0432\u0438-\u0421\u0442\u0440\u043e\u0441\u0441
    (\u043a \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043a\u043d\u0438\u0433 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u0412\u0435\u0439\u043b\u044c \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435), \u043e\u043d \u0432\u044b\u0441\u043e\u043a\u043e
    \u0446\u0435\u043d\u0438\u043b \u0438 \u043f\u0438\u0441\u0430\u043b \u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0445
    \u0413\u0435\u0440\u043c\u0430\u043d\u0430 \u0412\u0435\u0439\u043b\u044f. \u0415\u0433\u043e
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u043e\u043c
    \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0435\u0433\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b,
    \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0437\u0430\u043c\u0435\u0442\u043d\u043e\u0439
    \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\U0001F54A\ufe0f \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u0412 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u0412\u0435\u0439\u043b\u044c \u043f\u0440\u043e\u0432\u0435\u043b \u0441\u0432\u043e\u0438
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f,
    \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c
    \u043f\u0430\u0442\u0440\u0438\u0430\u0440\u0445\u043e\u043c \u043c\u0438\u0440\u043e\u0432\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412 1979 \u0433\u043e\u0434\u0443
    \u043e\u043d \u0431\u044b\u043b \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u043f\u0440\u0435\u043c\u0438\u0438
    \u0412\u043e\u043b\u044c\u0444\u0430. \u0410\u043d\u0434\u0440\u0435 \u0412\u0435\u0439\u043b\u044c
    \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f 6 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1998 \u0433\u043e\u0434\u0430 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 92 \u043b\u0435\u0442. \u0415\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u0434\u043e\u043b\u0433\u043e\u0439
    \u0438 \u0431\u0443\u0440\u043d\u043e\u0439, \u043f\u043e\u043b\u043d\u043e\u0439 \u043a\u0430\u043a
    \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u0442\u0430\u043a \u0438
    \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u043e\u0431\u044b\u0442\u0438\u0439,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b
    \u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u0430\u043b\u0438\u0441\u044c
    \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f\u043c."
  personalLifeEn: "Here is a detailed account of Andre Veil's life course, from his childhood in Paris to his last days in Princeton, including his relationship with other scientists.\n\n==Early life==The birth, childhood and youth of André Abraham Weil was born on May 6, 1906 in Paris, in an educated and wealthy Jewish family from Elsas, and his father was a doctor and his mother received a good musical education.Vale's early abilities were manifested in linguistics: he learned German by eavesdropping on his parents' conversations, and then became interested in the ancient Greek, Latin, and especially Sanskrit, which he began to study under the leadership of Professor Sylvain Levi, and his early years in World War I were called upon by a military doctor, and the family often moved, so Andre sometimes went home.However, he graduated early from school, and in the 1920s he entered the Higher Normal School (Eócole Normal Superiure), the best university in France.\n\n===Reception and career======Learning and career development============================================================================================================================================================================================================================================In 1928, Weil defended his thesis in Diofant Geometry under the leadership of prominent mathematicians Jacques Adamard and Emile Picard, who entered classical textbooks, and after protection he received a scholarship to travel to Italian and German scientific centres, and an important step was his introduction to Emmy Neuter, a great algebraist from whom he studied in Germany and whose ideas had a significant influence on him.\n\n==History==The Indian Odyssey, upon his return to France, did not have a suitable vacancy for Weil. His Sanskrit mentor, Sylvain Levy, agreed to appoint him as head of the Department of Mathematics at Aligarh University in British India, which was an unusual and courageous decision.However, attempts to reform the teaching came across local specificities and administrative intrigues, and after a year and a half, he was dismissed.\n\n===Career======Structure: Burbaki and personal life=====In 1933, Veil received a place at the University of Strasbourg, where he and a group of young like-minded men (Henri Cartan, Jean Djedonne, Claude Chevalle) became one of the founders of the legendary group Nicole Burbaki.\n\nThe war and the dangerous escape with the outbreak of the Second World War, Weil and his wife were in Finland. Under French law, he was obliged to appear at the assembly site. However, Veille, convinced that his calling was mathematician rather than war, decided to avoid mobilization. This led to a dramatic episode: he was suspected of being a spy and was arrested. He was rescued by the shooting of a famous Finnish mathematician, Rolf Nevanlinna.He was then able to leave Finland and arrived in the United States in 1941.\n\nIn America, Weil first worked at the University of Lichai, where he was not valued, overworked and paid little, and he hated this period and vowed never to mention it, followed by work in São Paulo, Brazil, from 1945 to 1947, where he worked with Oscar Zaris.Weil then returned to the United States and worked at the University of Chicago (1947–158) and then at the Institute of Advanced Studies in Princeton (1958–1976), where he stayed for the rest of his life.\n\nHe was one of the founders of the Burbaki group and worked closely with Henri Cartan, Jean Dieudonne, Claude Chevalle, and his students were Pierre Cartier, who later wrote about him, and the relationship with other math pillars varied.He had long-standing friendships and cooperation with colleagues such as Claude Levy-Stross (to which Weil wrote a mathematical application), and he appreciated and wrote about Herman Weil's work. His relationship with Alexander Grotendik, who had proved his hypothesis, was also a prominent page in the history of mathematics.\n\n==Death==In Princeton, Weil spent his last decades remaining a recognized patriarch of world mathematics. In 1979, he was awarded the Wolf Prize. André Weil died on 6 August 1998 in Princeton at the age of 92, a long and violent life full of both outstanding scientific achievements and dramatic events in which his principles and beliefs were severely tested."
  shortBioRu: "\u0410\u043d\u0434\u0440\u0435 \u0412\u0435\u0439\u043b\u044c (1906\u20131998) \u0431\u044b\u043b
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0434\u043d\u0438\u043c \u0438\u0437
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432
    XX \u0432\u0435\u043a\u0430, \u043d\u043e \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c
    \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u043e \u0448\u0438\u0440\u043e\u043a\u0438\u0445
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0445
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432, \u0447\u044c\u044f \u0436\u0438\u0437\u043d\u044c
    \u0431\u044b\u043b\u0430 \u0442\u0435\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0430
    \u0441 \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0435\u0439
    \u0438 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c\u0438 \u0441\u0432\u043e\u0435\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0412\u043e\u0442 \u0435\u0433\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f. \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438
    (1906\u20131920-\u0435) \u0410\u043d\u0434\u0440\u0435 \u0410\u0432\u0440\u0430\u0430\u043c
    \u0412\u0435\u0439\u043b\u044c \u0440\u043e\u0434\u0438\u043b\u0441\u044f 6 \u043c\u0430\u044f
    1906 \u0433\u043e\u0434\u0430 \u0432 \u041f\u0430\u0440\u0438\u0436\u0435 \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439
    \u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u043d\u043e\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439
    \u0441\u0435\u043c\u044c\u0435, \u0432\u044b\u0445\u043e\u0434\u0446\u0430\u0445 \u0438\u0437
    \u042d\u043b\u044c\u0437\u0430\u0441\u0430. \u0415\u0433\u043e \u043e\u0442\u0435\u0446
    \u0431\u044b\u043b \u0432\u0440\u0430\u0447\u043e\u043c, \u043c\u0430\u0442\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0430
    \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0435
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u0410\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430
    \u0432 \u0434\u043e\u043c\u0435 \u0446\u0430\u0440\u0438\u043b\u0430 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0430\u044f;
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0441\u0435\u043c\u044c\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0441 \u043d\u043e\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0438\u043c \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u043c
    \u0418\u043b\u044c\u0451\u0439 \u041c\u0435\u0447\u043d\u0438\u043a\u043e\u0432\u044b\u043c,
    \u0431\u044b\u043b\u0430 \u0447\u0430\u0441\u0442\u044c\u044e \u0438\u0445 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u043e\u0433\u043e
    \u043a\u0440\u0443\u0433\u0430. \u0421 \u0440\u0430\u043d\u043d\u0438\u0445 \u043b\u0435\u0442
    \u0443 \u0410\u043d\u0434\u0440\u0435 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438
    \u043a \u044f\u0437\u044b\u043a\u0430\u043c. \u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438
    \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438
    \u043f\u043e-\u043d\u0435\u043c\u0435\u0446\u043a\u0438, \u0438 \u0434\u0435\u0442\u0438,
    \u043f\u043e\u0434\u0441\u043b\u0443\u0448\u0438\u0432\u0430\u044f \u0438\u0445, \u0432\u044b\u0443\u0447\u0438\u043b\u0438
    \u044f\u0437\u044b\u043a \u0432 \u0440\u0430\u043d\u043d\u0435\u043c \u0434\u0435\u0442\u0441\u0442\u0432\u0435.
    \u042d\u0442\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u043c: \u043e\u043d \u0438\u0437\u0443\u0447\u0430\u043b
    \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439,
    \u043b\u0430\u0442\u044b\u043d\u044c \u0438, \u0447\u0442\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0432\u0430\u0436\u043d\u043e, \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u043c
    \u043d\u0430\u0447\u0430\u043b \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f
    \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u0430
    \u0437\u0430\u0442\u0435\u043c \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0421\u0438\u043b\u044c\u0432\u0435\u043d\u0430 \u041b\u0435\u0432\u0438. \u041f\u043e\u0437\u0436\u0435
    \u0412\u0435\u0439\u043b\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442 \u0434\u043b\u044f \u0447\u0442\u0435\u043d\u0438\u044f
    \u0434\u0440\u0435\u0432\u043d\u0435\u0438\u043d\u0434\u0438\u0439\u0441\u043a\u0438\u0445
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0445\u043e\u0442\u044f \u043e\u043d \u0438
    \u0431\u044b\u043b \u0434\u0430\u043b\u0451\u043a \u043e\u0442 \u0440\u0435\u043b\u0438\u0433\u0438\u0438,
    \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430
    \u0435\u0433\u043e \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435
    \u0438 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f.
    \u0421\u0442\u043e\u0438\u0442 \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043c\u043b\u0430\u0434\u0448\u0430\u044f \u0441\u0435\u0441\u0442\u0440\u0430,
    \u0421\u0438\u043c\u043e\u043d\u0430 \u0412\u0435\u0439\u043b\u044c, \u0441\u0442\u0430\u043b\u0430
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c \u0438 \u043c\u0438\u0441\u0442\u0438\u043a\u043e\u043c.
    \u041f\u0435\u0440\u0432\u0430\u044f \u043c\u0438\u0440\u043e\u0432\u0430\u044f \u0432\u043e\u0439\u043d\u0430
    \u0432\u043d\u0435\u0441\u043b\u0430 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0432\u044b
    \u0432 \u0435\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435:
    \u043e\u0442\u0446\u0430 \u043f\u0440\u0438\u0437\u0432\u0430\u043b\u0438 \u0432\u043e\u0435\u043d\u043d\u044b\u043c
    \u0432\u0440\u0430\u0447\u043e\u043c, \u0438 \u0441\u0435\u043c\u044c\u044f \u0447\u0430\u0441\u0442\u043e
    \u043f\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043b\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443
    \u0410\u043d\u0434\u0440\u0435 \u0438\u043d\u043e\u0433\u0434\u0430 \u0443\u0447\u0438\u043b\u0441\u044f
    \u0434\u043e\u043c\u0430. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435,
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u0440\u0430\u043d\u043e \u2014 \u043e\u043d \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0441\u0432\u043e\u0438\u043b \u0448\u043a\u043e\u043b\u044c\u043d\u044b\u0439 \u0443\u0447\u0435\u0431\u043d\u0438\u043a
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0432 \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0430\u0445 \u043f\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044e
    \u0437\u0430\u0434\u0430\u0447 \u0434\u043b\u044f \u00ab\u0416\u0443\u0440\u043d\u0430\u043b\u0430
    \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb.
    \u041d\u0430\u0447\u0430\u043b\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0438
    (1920-\u0435 \u2013 1933) \u041e\u043a\u043e\u043d\u0447\u0438\u0432 \u0448\u043a\u043e\u043b\u0443
    \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e, \u0412\u0435\u0439\u043b\u044c \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0441\u0430\u043c\u043e\u0435 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0435
    \u0432\u044b\u0441\u0448\u0435\u0435 \u0443\u0447\u0435\u0431\u043d\u043e\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0435
    \u0424\u0440\u0430\u043d\u0446\u0438\u0438 \u2014 \u0412\u044b\u0441\u0448\u0443\u044e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e
    \u0448\u043a\u043e\u043b\u0443 (\u00c9cole Normale Sup\u00e9rieure). \u0422\u0430\u043c
    \u043e\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0433\u043b\u0443\u0431\u043b\u0451\u043d\u043d\u043e
    \u0438\u0437\u0443\u0447\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443,
    \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u0440\u0430\u0431\u043e\u0442\u044b
    \u0420\u0438\u043c\u0430\u043d\u0430, \u043d\u043e \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0437\u0430\u043d\u044f\u0442\u0438\u044f \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442\u043e\u043c.
    \u0412 1925 \u0433\u043e\u0434\u0443 \u043e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435, \u0430 \u0432 1928 \u0433\u043e\u0434\u0443,
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0416\u0430\u043a\u0430 \u0410\u0434\u0430\u043c\u0430\u0440\u0430 \u0438 \u042d\u043c\u0438\u043b\u044f
    \u041f\u0438\u043a\u0430\u0440\u0430, \u0437\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e
    \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0434\u0438\u043e\u0444\u0430\u043d\u0442\u043e\u0432\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0432\u043e\u0448\u043b\u0430
    \u0432 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0438.
    \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0449\u0438\u0442\u044b \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0438\u044e \u0434\u043b\u044f \u043f\u043e\u0435\u0437\u0434\u043e\u043a
    \u043f\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u0446\u0435\u043d\u0442\u0440\u0430\u043c
    \u0418\u0442\u0430\u043b\u0438\u0438 \u0438 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438.
    \u0412\u0430\u0436\u043d\u044b\u043c \u044d\u0442\u0430\u043f\u043e\u043c \u0441\u0442\u0430\u043b\u043e
    \u0435\u0433\u043e \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e \u0441 \u042d\u043c\u043c\u0438
    \u041d\u0451\u0442\u0435\u0440, \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0441\u0442\u043e\u043c,
    \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d \u0443\u0447\u0438\u043b\u0441\u044f
    \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438. \u042d\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u043e
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0435\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435.
    \u00ab\u0418\u043d\u0434\u0438\u0439\u0441\u043a\u0430\u044f \u043e\u0434\u0438\u0441\u0441\u0435\u044f\u00bb
    \u0438 \u0411\u0443\u0440\u0431\u0430\u043a\u0438 (1930\u20131939) \u0412\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u0438
    \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0445
    \u0432\u0430\u043a\u0430\u043d\u0441\u0438\u0439, \u0438 \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a
    \u043f\u043e \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442\u0443, \u0421\u0438\u043b\u044c\u0432\u0435\u043d
    \u041b\u0435\u0432\u0438, \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0441\u044f
    \u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u0412\u0435\u0439\u043b\u044f
    \u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e
    \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0410\u043b\u0438\u0433\u0430\u0440\u0445\u0430
    \u0432 \u0411\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0439 \u0418\u043d\u0434\u0438\u0438.
    \u042d\u0442\u043e \u0431\u044b\u043b \u0441\u043c\u0435\u043b\u044b\u0439 \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0439
    \u0448\u0430\u0433 \u0434\u043b\u044f \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430. \u041f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0435
    \u0432 \u0418\u043d\u0434\u0438\u0438 (\u043d\u0430\u0447\u0430\u043b\u043e 1930-\u0445)
    \u0441\u0442\u0430\u043b\u043e \u0434\u043b\u044f \u043d\u0435\u0433\u043e \u0432\u0430\u0436\u043d\u044b\u043c
    \u043b\u0438\u0447\u043d\u044b\u043c \u043e\u043f\u044b\u0442\u043e\u043c: \u043e\u043d
    \u043c\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b,
    \u043e\u0431\u0449\u0430\u043b\u0441\u044f \u0441 \u043c\u0435\u0441\u0442\u043d\u044b\u043c\u0438
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u0430\u043c\u0438,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041c\u0430\u0445\u0430\u0442\u043c\u0443 \u0413\u0430\u043d\u0434\u0438.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0433\u043e \u043f\u043e\u043f\u044b\u0442\u043a\u0438
    \u0440\u0435\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0431\u0440\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0445 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432
    \u043f\u0440\u043e\u0432\u0430\u043b\u0438\u043b\u0438\u0441\u044c \u0438\u0437-\u0437\u0430
    \u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0438
    \u0438 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u043d\u0442\u0440\u0438\u0433, \u0438 \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0442\u043e\u0440\u0430
    \u0433\u043e\u0434\u0430 \u0435\u0433\u043e \u0443\u0432\u043e\u043b\u0438\u043b\u0438.
    \u0412\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0432\u043e \u0424\u0440\u0430\u043d\u0446\u0438\u044e,
    \u0412\u0435\u0439\u043b\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043c\u0435\u0441\u0442\u043e
    \u0432 \u0421\u0442\u0440\u0430\u0441\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u043c \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    (1933\u20131940). \u0418\u043c\u0435\u043d\u043d\u043e \u0437\u0434\u0435\u0441\u044c \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c
    \u0435\u0433\u043e \u0441\u0430\u043c\u0430\u044f \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f
    \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f
    \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u0412\u043c\u0435\u0441\u0442\u0435
    \u0441 \u0433\u0440\u0443\u043f\u043f\u043e\u0439 \u043c\u043e\u043b\u043e\u0434\u044b\u0445
    \u0435\u0434\u0438\u043d\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    (\u0410\u043d\u0440\u0438 \u041a\u0430\u0440\u0442\u0430\u043d, \u0416\u0430\u043d \u0414\u044c\u0451\u0434\u043e\u043d\u043d\u0435,
    \u041a\u043b\u043e\u0434 \u0428\u0435\u0432\u0430\u043b\u043b\u0435 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435)
    \u043e\u043d \u0441\u0442\u0430\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b
    \u041d\u0438\u043a\u043e\u043b\u044f \u0411\u0443\u0440\u0431\u0430\u043a\u0438. \u0418\u0445
    \u0446\u0435\u043b\u044c\u044e \u0431\u044b\u043b\u043e \u043f\u0435\u0440\u0435\u0438\u0437\u043b\u043e\u0436\u0438\u0442\u044c
    \u043e\u0441\u043d\u043e\u0432\u044b \u0432\u0441\u0435\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0441 \u0435\u0434\u0438\u043d\u044b\u0445 \u043f\u043e\u0437\u0438\u0446\u0438\u0439,
    \u043e\u0442\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u044f\u0441\u044c \u043e\u0442 \u0442\u0435\u043e\u0440\u0438\u0438
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432, \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u043d\u043e\u0432\u044b\u0439 \u0441\u0442\u0440\u043e\u0433\u0438\u0439 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e
    \u0437\u043d\u0430\u043d\u0438\u044f. \u0420\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434
    \u043c\u043d\u043e\u0433\u043e\u0442\u043e\u043c\u043d\u044b\u043c\u0438 \u00ab\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438\u00bb \u0441\u0442\u0430\u043b\u0430
    \u0434\u0435\u043b\u043e\u043c \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u0434\u043b\u044f
    \u0412\u0435\u0439\u043b\u044f \u0438 \u0435\u0433\u043e \u0441\u043e\u0440\u0430\u0442\u043d\u0438\u043a\u043e\u0432.
    \u0412\u043e\u0439\u043d\u0430, \u044d\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f \u0438
    \u0437\u0440\u0435\u043b\u044b\u0435 \u0433\u043e\u0434\u044b (1940\u20131998) \u0421 \u043d\u0430\u0447\u0430\u043b\u043e\u043c
    \u0412\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u0432\u043e\u0439\u043d\u044b,
    \u0431\u0443\u0434\u0443\u0447\u0438 \u0435\u0432\u0440\u0435\u0435\u043c, \u0412\u0435\u0439\u043b\u044c
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0432 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438.
    \u041e\u043d \u044d\u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b \u0432 \u0421\u0428\u0410,
    \u0433\u0434\u0435 \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u041f\u0435\u043d\u0441\u0438\u043b\u044c\u0432\u0430\u043d\u0438\u0438
    (1941\u20131945), \u0437\u0430\u0442\u0435\u043c \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0421\u0430\u043d-\u041f\u0430\u0443\u043b\u0443 \u0432 \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0438
    (1945\u20131947), \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u043f\u0435\u0440\u0435\u0448\u0451\u043b
    \u0432 \u0427\u0438\u043a\u0430\u0433\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    (1947\u20131958). \u0424\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u043c \u044d\u0442\u0430\u043f\u043e\u043c
    \u0435\u0433\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u043a\u0430\u0440\u044c\u0435\u0440\u044b \u0441\u0442\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430
    \u0432 \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435
    (1958\u20131976), \u0433\u0434\u0435 \u043e\u043d \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f
    \u0434\u043e \u0432\u044b\u0445\u043e\u0434\u0430 \u043d\u0430 \u043f\u0435\u043d\u0441\u0438\u044e
    \u0438 \u0433\u0434\u0435 \u0443\u043c\u0435\u0440 6 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1998 \u0433\u043e\u0434\u0430. \u0412 \u044d\u0442\u0438 \u0433\u043e\u0434\u044b \u043e\u043d
    \u0441\u0442\u0430\u043b \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u043c \u043b\u0438\u0434\u0435\u0440\u043e\u043c
    \u043c\u0438\u0440\u043e\u0432\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u0415\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b
    \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e
    \u043e\u043d \u043f\u0435\u0440\u0435\u043e\u0441\u043c\u044b\u0441\u043b\u0438\u043b \u0438
    \u043f\u0440\u0438\u0434\u0430\u043b \u0435\u0439 \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043a \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b
    \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438. \u041e\u043d \u0440\u0430\u0437\u0432\u0438\u043b
    \u0442\u0435\u043e\u0440\u0438\u044e \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0432 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0433\u0440\u0443\u043f\u043f\u0430\u0445 \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u043c\u0435\u0442\u043e\u0434\u044b \u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u043a \u0442\u0435\u043e\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043b
    (\u043a\u043e\u0433\u043e\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0413\u0430\u043b\u0443\u0430).
    \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435: \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0412\u0435\u0439\u043b\u044f \u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b
    \u0412\u0435\u0440\u0448\u0438\u043d\u043e\u0439 \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e
    \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430 \u0441\u0442\u0430\u043b\u0438
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0412\u0435\u0439\u043b\u044f (\u0434\u043e\u043a\u0430\u0437\u0430\u043d\u044b
    \u0432 1970-\u0445 \u0433\u043e\u0434\u0430\u0445 \u0413\u0440\u043e\u0442\u0435\u043d\u0434\u0438\u043a\u043e\u043c
    \u0438 \u0414\u0435\u043b\u0438\u043d\u0435\u043c). \u041e\u043d\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443
    \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u044b\u043c \u043c\u0438\u0440\u043e\u043c
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439
    \u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u043c \u043c\u0438\u0440\u043e\u043c
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0441\u043e\u0431\u044b\u0442\u0438\u0439 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
