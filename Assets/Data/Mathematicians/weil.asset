  achievementsRu: "\u041D\u0430\u0443\u0447\u043D\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435
    \u0410\u043D\u0434\u0440\u0435 \u0412\u0435\u0439\u043B\u044F \u043E\u0433\u0440\u043E\u043C\u043D\u043E
    \u0438 \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043E\u0431\u043B\u0430\u0441\u0442\u0435\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.
    \u0415\u0433\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0432\u043A\u043B\u0430\u0434
    \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u0432 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438
    \u0441\u0442\u0440\u043E\u0433\u043E\u0433\u043E \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430
    \u0434\u043B\u044F \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438 \u0438 \u0432 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438
    \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445 \u0441\u0432\u044F\u0437\u0435\u0439
    \u043C\u0435\u0436\u0434\u0443 \u0442\u0435\u043E\u0440\u0438\u0435\u0439 \u0447\u0438\u0441\u0435\u043B
    \u0438 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0435\u0439, \u0447\u0442\u043E
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u043E \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u0432\u043F\u0435\u0440\u0435\u0434.  ### \U0001F3DB\uFE0F \u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435
    \"\u0411\u0443\u0440\u0431\u0430\u043A\u0438\" \u0438 \u0440\u0435\u0444\u043E\u0440\u043C\u0430
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438  \u041E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u0445 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439 \u0412\u0435\u0439\u043B\u044F
    \u0441\u0442\u0430\u043B\u043E \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u0433\u0440\u0443\u043F\u043F\u044B
    **\u041D\u0438\u043A\u043E\u043B\u044F \u0411\u0443\u0440\u0431\u0430\u043A\u0438**
    \u0432 1930-\u0445 \u0433\u043E\u0434\u0430\u0445. \u042D\u0442\u043E \u0431\u044B\u043B
    \u0430\u043C\u0431\u0438\u0446\u0438\u043E\u0437\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442
    \u0433\u0440\u0443\u043F\u043F\u044B \u043C\u043E\u043B\u043E\u0434\u044B\u0445
    \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
    \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439 \u0437\u0430\u0434\u0430\u0447\u0443
    \u043F\u0435\u0440\u0435\u0438\u0437\u043B\u043E\u0436\u0438\u0442\u044C \u0432\u0441\u044E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443 \u043D\u0430 \u0435\u0434\u0438\u043D\u043E\u0439
    \u0441\u0442\u0440\u043E\u0433\u043E\u0439 \u043E\u0441\u043D\u043E\u0432\u0435,
    \u043E\u0442\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u044F\u0441\u044C \u043E\u0442
    \u0442\u0435\u043E\u0440\u0438\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432.
    \u0421\u0435\u0440\u0438\u044F \u043A\u043D\u0438\u0433 \"\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438\", \u043D\u0430\u0434
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0412\u0435\u0439\u043B\u044C \u0438 \u0435\u0433\u043E \u0441\u043E\u0440\u0430\u0442\u043D\u0438\u043A\u0438,
    \u043E\u043A\u0430\u0437\u0430\u043B\u0430 \u043A\u043E\u043B\u043E\u0441\u0441\u0430\u043B\u044C\u043D\u043E\u0435
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043D\u0430 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043D\u0430\u0443\u043A\u0443
    XX \u0432\u0435\u043A\u0430, \u0437\u0430\u0434\u0430\u0432 \u043D\u043E\u0432\u044B\u0435
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u0438
    \u0438 \u0430\u043A\u0441\u0438\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u0434\u0445\u043E\u0434\u0430.  ### \U0001F4D0 \u041F\u0435\u0440\u0435\u043E\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u0438\u0435
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438  \u0414\u043E \u0440\u0430\u0431\u043E\u0442
    \u0412\u0435\u0439\u043B\u044F \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F, \u0438\u0437\u0443\u0447\u0430\u044E\u0449\u0430\u044F
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043E\u0431\u044A\u0435\u043A\u0442\u044B, \u0437\u0430\u0434\u0430\u0432\u0430\u0435\u043C\u044B\u0435
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F\u043C\u0438, \u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430
    \u043E\u0442 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0430 \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u0438.
    \u0412\u0435\u0439\u043B\u044C \u0432\u0437\u044F\u043B \u043D\u0430 \u0441\u0435\u0431\u044F
    \u0442\u0438\u0442\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0442\u0440\u0443\u0434
    \u043F\u043E \u0435\u0451 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0435
    \u043D\u0430 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u043A\u043E-\u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0431\u0430\u0437\u0435. \u0415\u0433\u043E \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044F,
    \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u043D\u0430\u044F \u0432 1928 \u0433\u043E\u0434\u0443
    \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u0416\u0430\u043A\u0430 \u0410\u0434\u0430\u043C\u0430\u0440\u0430 \u0438 \u042D\u043C\u0438\u043B\u044F
    \u041F\u0438\u043A\u0430\u0440\u0430, \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u0430
    \u0434\u0438\u043E\u0444\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0432\u0445\u043E\u0434\u0438\u0442
    \u0432 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438. \u041F\u043E\u0437\u0434\u043D\u0435\u0435
    \u043E\u043D \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B \u044D\u0442\u0443
    \u0440\u0430\u0431\u043E\u0442\u0443, \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u043A \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438 \u043C\u043E\u0449\u043D\u044B\u0439
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0440\u0430\u0437\u0434\u0435\u043B\u043E\u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438. 
    ### \U0001F517 \u0413\u0438\u043F\u043E\u0442\u0435\u0437\u044B \u0412\u0435\u0439\u043B\u044F:
    \u043C\u043E\u0441\u0442 \u043C\u0435\u0436\u0434\u0443 \u0434\u0438\u0441\u043A\u0440\u0435\u0442\u043D\u044B\u043C
    \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u043C  \u0412\u0435\u0440\u0448\u0438\u043D\u043E\u0439
    \u0435\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
    \u0441\u0442\u0430\u043B\u0438 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0435
    **\u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B \u0412\u0435\u0439\u043B\u044F**,
    \u0432\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044B\u0435 \u0438\u043C \u0432
    \u043A\u043E\u043D\u0446\u0435 1940-\u0445 \u0433\u043E\u0434\u043E\u0432. \u042D\u0442\u0438
    \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
    \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u0438 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u0443\u044E
    \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F,
    \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0431\u044B, \u0434\u0430\u043B\u0435\u043A\u0438\u043C\u0438
    \u043C\u0438\u0440\u0430\u043C\u0438:  *   **\u0414\u0438\u0441\u043A\u0440\u0435\u0442\u043D\u044B\u043C
    \u043C\u0438\u0440\u043E\u043C** \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u043D\u043E\u0433\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0439, \u0437\u0430\u0434\u0430\u0432\u0430\u0435\u043C\u044B\u0445
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F\u043C\u0438 \u043D\u0430\u0434
    \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u043C\u0438 \u043F\u043E\u043B\u044F\u043C\u0438.
    *   **\u041D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u043C \u043C\u0438\u0440\u043E\u043C**
    \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u0438, \u0438\u0437\u0443\u0447\u0430\u044E\u0449\u0438\u043C
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u0444\u043E\u0440\u043C \u0438
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432.  \u041F\u043E
    \u0441\u0443\u0442\u0438, \u0412\u0435\u0439\u043B\u044C \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0440\u0435\u0448\u0435\u043D\u0438\u0439 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0439
    \u043D\u0430\u0434 \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u043C\u0438 \u043F\u043E\u043B\u044F\u043C\u0438
    \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C, \u0438\u0437\u0443\u0447\u0430\u044F
    \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
    \u0438\u043C \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0445
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432. \u0414\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u044D\u0442\u0438\u0445 \u0433\u0438\u043F\u043E\u0442\u0435\u0437, \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D\u043D\u043E\u0435
    \u0432 1970-\u0445 \u0433\u043E\u0434\u0430\u0445 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u043C
    \u0413\u0440\u043E\u0442\u0435\u043D\u0434\u0438\u043A\u043E\u043C \u0438 \u041F\u044C\u0435\u0440\u043E\u043C
    \u0414\u0435\u043B\u0438\u043D\u0435\u043C, \u0441\u0442\u0430\u043B\u043E \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0441\u043E\u0431\u044B\u0442\u0438\u0439 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435
    XX \u0432\u0435\u043A\u0430 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u043E
    \u0414\u0435\u043B\u0438\u043D\u044E \u0424\u0438\u043B\u0434\u0441\u043E\u0432\u0441\u043A\u0443\u044E
    \u043F\u0440\u0435\u043C\u0438\u044E.  ### \U0001F9E9 \u0414\u0440\u0443\u0433\u0438\u0435
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438  \u041F\u043E\u043C\u0438\u043C\u043E
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438, \u0412\u0435\u0439\u043B\u044C
    \u0432\u043D\u0435\u0441 \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439 \u0432\u043A\u043B\u0430\u0434
    \u0432 \u0440\u044F\u0434 \u0434\u0440\u0443\u0433\u0438\u0445 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439: 
    *   **\u0422\u0435\u043E\u0440\u0438\u044F \u0447\u0438\u0441\u0435\u043B**:
    \u041E\u043D \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043B \u043C\u0435\u0442\u043E\u0434\u044B
    \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0438 \u0433\u043E\u043C\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B \u043A \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u0432,
    \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u0442\u0435\u043E\u0440\u0438\u044E
    \u043A\u043E\u0433\u043E\u043C\u043E\u043B\u043E\u0433\u0438\u0439 \u0413\u0430\u043B\u0443\u0430.
    \u0415\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \"\u041E\u0441\u043D\u043E\u0432\u044B
    \u0442\u0435\u043E\u0440\u0438\u0438 \u0447\u0438\u0441\u0435\u043B\" \u0441\u0442\u0430\u043B\u0430
    \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u043E\u043C.
    \u041E\u043D \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0432\u0430\u0436\u043D\u044B\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
    \u043E \u0440\u044F\u0434\u0430\u0445 \u0414\u0438\u0440\u0438\u0445\u043B\u0435
    \u0438 \u0438\u0445 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0438
    \u0447\u0435\u0440\u0435\u0437 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F. *   **\u0422\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0433\u0440\u0443\u043F\u043F\u044B \u0438 \u0438\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435**:
    \u0412\u0435\u0439\u043B\u044C \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0442\u0435\u043E\u0440\u0438\u044E \u0438\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u043D\u0430 \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0433\u0440\u0443\u043F\u043F\u0430\u0445, \u0447\u0442\u043E \u043D\u0430\u0448\u043B\u043E
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0432 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u0430\u043D\u0430\u043B\u0438\u0437\u0435. \u0415\u0433\u043E \u043C\u043E\u043D\u043E\u0433\u0440\u0430\u0444\u0438\u044F
    \"\u0418\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432 \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0433\u0440\u0443\u043F\u043F\u0430\u0445 \u0438 \u0435\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F\"
    \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043D\u0430 \u043D\u0430 \u0440\u0443\u0441\u0441\u043A\u0438\u0439
    \u044F\u0437\u044B\u043A. *   **\u0422\u0435\u043E\u0440\u0438\u044F \u0433\u0440\u0443\u043F\u043F
    \u0438 \u0430\u043B\u0433\u0435\u0431\u0440\u044B**: \u041E\u043D \u0438\u0437\u0443\u0447\u0430\u043B
    \u0433\u0440\u0443\u043F\u043F\u044B \u041B\u0438 \u0438 \u0438\u0445 \u0434\u0438\u0441\u043A\u0440\u0435\u0442\u043D\u044B\u0435
    \u043F\u043E\u0434\u0433\u0440\u0443\u043F\u043F\u044B, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B \u0441 \u0438\u043D\u0432\u043E\u043B\u044E\u0446\u0438\u044F\u043C\u0438
    \u0438 \u0438\u0445 \u0441\u0432\u044F\u0437\u044C \u0441 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0433\u0440\u0443\u043F\u043F\u0430\u043C\u0438. *   **\u041A\u044D\u043B\u0435\u0440\u043E\u0432\u044B
    \u043C\u043D\u043E\u0433\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u044F**: \u0412\u0435\u0439\u043B\u044C
    \u0432\u043D\u0435\u0441 \u0432\u043A\u043B\u0430\u0434 \u0432 \u0438\u0445 \u0442\u0435\u043E\u0440\u0438\u044E,
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0431\u044B\u043B\u0438
    \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u044B \u0432 \u043A\u043D\u0438\u0433\u0435
    \"\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 \u0442\u0435\u043E\u0440\u0438\u044E
    \u043A\u044D\u043B\u0435\u0440\u043E\u0432\u044B\u0445 \u043C\u043D\u043E\u0433\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0439\". 
    ### \U0001F48E \u0424\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044F \u0438
    \u043C\u0435\u0436\u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430\u0440\u043D\u043E\u0441\u0442\u044C 
    \u041D\u0430\u0443\u0447\u043D\u044B\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u044B
    \u0412\u0435\u0439\u043B\u044F \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C
    \u043F\u043E\u0434 \u0432\u043B\u0438\u044F\u043D\u0438\u0435\u043C \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430\u043B\u0438\u0437\u043C\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u044F\u043B
    \u043E\u0442 \u041A\u043B\u043E\u0434\u0430 \u041B\u0435\u0432\u0438-\u0421\u0442\u0440\u043E\u0441\u0441\u0430.
    \u041E\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043A \u0435\u0433\u043E
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435
    \"\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u044B\u0435 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B
    \u0440\u043E\u0434\u0441\u0442\u0432\u0430\". \u042D\u0442\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0435\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u0435\u0442\u043E\u0434\u043E\u0432 \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D. 
    ### \U0001F3C6 \u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435  \u041C\u0430\u0441\u0448\u0442\u0430\u0431
    \u0435\u0433\u043E \u0432\u043A\u043B\u0430\u0434\u0430 \u0431\u044B\u043B \u043E\u0442\u043C\u0435\u0447\u0435\u043D
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E\u043C \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u044B\u0445
    \u043D\u0430\u0433\u0440\u0430\u0434, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u043F\u0440\u0435\u043C\u0438\u044E \u0412\u043E\u043B\u044C\u0444\u0430 \u043F\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 (1979), \u043F\u0440\u0435\u043C\u0438\u044E
    \u0421\u0442\u0438\u043B\u0430 (1980) \u0438 \u043F\u0440\u0435\u043C\u0438\u044E
    \u041A\u0438\u043E\u0442\u043E (1994). \u041E\u043D \u0431\u044B\u043B \u0447\u043B\u0435\u043D\u043E\u043C
    \u0424\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u0439 \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0438
    \u043D\u0430\u0443\u043A \u0438 \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C
    \u0447\u043B\u0435\u043D\u043E\u043C \u041B\u043E\u043D\u0434\u043E\u043D\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0433\u043E \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430."
  achievementsEn: 
  personalLifeRu: "\u0412\u043E\u0442 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u0439
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437 \u043E \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E\u043C
    \u043F\u0443\u0442\u0438 \u0410\u043D\u0434\u0440\u0435 \u0412\u0435\u0439\u043B\u044F:
    \u043E\u0442 \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u0432 \u041F\u0430\u0440\u0438\u0436\u0435
    \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445 \u0434\u043D\u0435\u0439
    \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0435\u0433\u043E \u0432\u0437\u0430\u0438\u043C\u043E\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0443\u0447\u0435\u043D\u044B\u043C\u0438. 
    ### \U0001F476 \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435, \u0434\u0435\u0442\u0441\u0442\u0432\u043E
    \u0438 \u044E\u043D\u043E\u0441\u0442\u044C  \u0410\u043D\u0434\u0440\u0435 \u0410\u0432\u0440\u0430\u0430\u043C
    \u0412\u0435\u0439\u043B\u044C \u0440\u043E\u0434\u0438\u043B\u0441\u044F **6
    \u043C\u0430\u044F 1906 \u0433\u043E\u0434\u0430 \u0432 \u041F\u0430\u0440\u0438\u0436\u0435**
    \u0432 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u043E\u0439
    \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0439 \u0441\u0435\u043C\u044C\u0435,
    \u0440\u043E\u0434\u043E\u043C \u0438\u0437 \u042D\u043B\u044C\u0437\u0430\u0441\u0430.
    \u0415\u0433\u043E \u043E\u0442\u0435\u0446 \u0431\u044B\u043B \u0432\u0440\u0430\u0447\u043E\u043C,
    \u0430 \u043C\u0430\u0442\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430
    \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435. \u0421 \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u0410\u043D\u0434\u0440\u0435 \u0438 \u0435\u0433\u043E \u043C\u043B\u0430\u0434\u0448\u0430\u044F
    \u0441\u0435\u0441\u0442\u0440\u0430 **\u0421\u0438\u043C\u043E\u043D\u0430**
    (\u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444) \u0440\u043E\u0441\u043B\u0438 \u0432
    \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0435 \u043B\u044E\u0431\u0432\u0438
    \u0438 \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0430. \u0421\u0435\u043C\u044C\u044F
    \u0434\u0440\u0443\u0436\u0438\u043B\u0430 \u0441 \u043D\u043E\u0431\u0435\u043B\u0435\u0432\u0441\u043A\u0438\u043C
    \u043B\u0430\u0443\u0440\u0435\u0430\u0442\u043E\u043C \u0418\u043B\u044C\u0435\u0439
    \u041C\u0435\u0447\u043D\u0438\u043A\u043E\u0432\u044B\u043C.  \u0420\u0430\u043D\u043D\u0438\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0412\u0435\u0439\u043B\u044F
    \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0432 \u043B\u0438\u043D\u0433\u0432\u0438\u0441\u0442\u0438\u043A\u0435:
    \u043E\u043D \u0432\u044B\u0443\u0447\u0438\u043B \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0439,
    \u043F\u043E\u0434\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044F \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B
    \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0443\u0432\u043B\u0435\u043A\u0441\u044F \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u043C,
    \u043B\u0430\u0442\u044B\u043D\u044C\u044E \u0438 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    **\u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u043E\u043C**, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u043D\u0430\u0447\u0430\u043B \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
    \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430 \u0421\u0438\u043B\u044C\u0432\u0435\u043D\u0430
    \u041B\u0435\u0432\u0438.  \u0415\u0433\u043E \u0440\u0430\u043D\u043D\u0438\u0435
    \u0433\u043E\u0434\u044B \u043F\u0440\u0438\u0448\u043B\u0438\u0441\u044C \u043D\u0430
    \u041F\u0435\u0440\u0432\u0443\u044E \u043C\u0438\u0440\u043E\u0432\u0443\u044E
    \u0432\u043E\u0439\u043D\u0443: \u043E\u0442\u0446\u0430 \u043F\u0440\u0438\u0437\u0432\u0430\u043B\u0438
    \u0432\u043E\u0435\u043D\u043D\u044B\u043C \u0432\u0440\u0430\u0447\u043E\u043C,
    \u0438 \u0441\u0435\u043C\u044C\u044F \u0447\u0430\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043B\u0430,
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0410\u043D\u0434\u0440\u0435 \u0438\u043D\u043E\u0433\u0434\u0430
    \u0443\u0447\u0438\u043B\u0441\u044F \u0434\u043E\u043C\u0430. \u0422\u0435\u043C
    \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043E\u043D \u0434\u043E\u0441\u0440\u043E\u0447\u043D\u043E
    \u043E\u043A\u043E\u043D\u0447\u0438\u043B \u0448\u043A\u043E\u043B\u0443 \u0438
    \u0432 1920-\u0445 \u0433\u043E\u0434\u0430\u0445 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B
    \u0432 **\u0412\u044B\u0441\u0448\u0443\u044E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0443\u044E
    \u0448\u043A\u043E\u043B\u0443 (\xC9cole Normale Sup\xE9rieure)** \u2014 \u043B\u0443\u0447\u0448\u0435\u0435
    \u0432\u044B\u0441\u0448\u0435\u0435 \u0443\u0447\u0435\u0431\u043D\u043E\u0435
    \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0424\u0440\u0430\u043D\u0446\u0438\u0438. 
    ### \U0001F393 \u0423\u0447\u0451\u0431\u0430 \u0438 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043A\u0430\u0440\u044C\u0435\u0440\u044B  \u0412 \u0412\u044B\u0441\u0448\u0435\u0439
    \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0448\u043A\u043E\u043B\u0435
    \u0412\u0435\u0439\u043B\u044C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u043D\u043E \u0438\u0437\u0443\u0447\u0430\u043B
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443 (\u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438,
    \u0440\u0430\u0431\u043E\u0442\u044B \u0420\u0438\u043C\u0430\u043D\u0430), \u043D\u043E
    \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B \u0437\u0430\u043D\u044F\u0442\u0438\u044F
    \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u043E\u043C \u0438 \u0434\u0440\u0435\u0432\u043D\u0435\u0438\u043D\u0434\u0438\u0439\u0441\u043A\u043E\u0439
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0435\u0439 \u043F\u043E\u0434
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0421\u0438\u043B\u044C\u0432\u0435\u043D\u0430
    \u041B\u0435\u0432\u0438. \u0425\u043E\u0442\u044F \u043E\u043D \u0431\u044B\u043B
    \u0434\u0430\u043B\u0435\u043A \u043E\u0442 \u0440\u0435\u043B\u0438\u0433\u0438\u0438,
    \u0434\u0440\u0435\u0432\u043D\u0435\u0438\u043D\u0434\u0438\u0439\u0441\u043A\u0438\u0435
    \u0442\u0435\u043A\u0441\u0442\u044B \u043F\u043E\u0437\u0436\u0435 \u043F\u043E\u0432\u043B\u0438\u044F\u043B\u0438
    \u043D\u0430 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F.  **\u0412 1928 \u0433\u043E\u0434\u0443
    \u0412\u0435\u0439\u043B\u044C \u0437\u0430\u0449\u0438\u0442\u0438\u043B \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E**
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0434\u0438\u043E\u0444\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438 \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432
    \u0416\u0430\u043A\u0430 \u0410\u0434\u0430\u043C\u0430\u0440\u0430 \u0438 \u042D\u043C\u0438\u043B\u044F
    \u041F\u0438\u043A\u0430\u0440\u0430. \u0415\u0433\u043E \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044F
    \u0432\u043E\u0448\u043B\u0430 \u0432 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438.  \u041F\u043E\u0441\u043B\u0435
    \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0441\u0442\u0438\u043F\u0435\u043D\u0434\u0438\u044E \u0434\u043B\u044F \u043F\u043E\u0435\u0437\u0434\u043E\u043A
    \u043F\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u043C \u0446\u0435\u043D\u0442\u0440\u0430\u043C
    \u0418\u0442\u0430\u043B\u0438\u0438 \u0438 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438.
    \u0412\u0430\u0436\u043D\u044B\u043C \u044D\u0442\u0430\u043F\u043E\u043C \u0441\u0442\u0430\u043B\u043E
    \u0435\u0433\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E
    \u0441 **\u042D\u043C\u043C\u0438 \u041D\u0451\u0442\u0435\u0440**, \u0432\u0435\u043B\u0438\u043A\u0438\u043C
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0441\u0442\u043E\u043C, \u0443
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u043D \u0443\u0447\u0438\u043B\u0441\u044F
    \u0432 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438 \u0438 \u0447\u044C\u0438
    \u0438\u0434\u0435\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430
    \u043D\u0435\u0433\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435.  ### \U0001F1EE\U0001F1F3 \u0418\u043D\u0434\u0438\u0439\u0441\u043A\u0430\u044F
    \u043E\u0434\u0438\u0441\u0441\u0435\u044F  \u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u0432\u043E \u0424\u0440\u0430\u043D\u0446\u0438\u044E \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0439
    \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u0438 \u0434\u043B\u044F \u0412\u0435\u0439\u043B\u044F
    \u043D\u0435 \u0431\u044B\u043B\u043E. \u0422\u043E\u0433\u0434\u0430 \u0435\u0433\u043E
    \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u043F\u043E \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0443
    \u0421\u0438\u043B\u044C\u0432\u0435\u043D \u041B\u0435\u0432\u0438 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F
    \u043E \u0435\u0433\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0438
    **\u0437\u0430\u0432\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u043A\u0430\u0444\u0435\u0434\u0440\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0410\u043B\u0438\u0433\u0430\u0440\u0445\u0430 \u0432 \u0411\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u043E\u0439
    \u0418\u043D\u0434\u0438\u0438**.  \u042D\u0442\u043E \u0431\u044B\u043B\u043E
    \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0435 \u0438 \u0441\u043C\u0435\u043B\u043E\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435. \u0414\u0432\u0430 \u0433\u043E\u0434\u0430
    \u0432 \u0418\u043D\u0434\u0438\u0438 \u0441\u0442\u0430\u043B\u0438 \u0434\u043B\u044F
    \u0412\u0435\u0439\u043B\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
    \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u0443\u0441\u043F\u0435\u0445\u043E\u0432,
    \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0439 \u043F\u043E
    \u0441\u0442\u0440\u0430\u043D\u0435 \u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430
    \u0441 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u0430\u043C\u0438,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F **\u041C\u0430\u0445\u0430\u0442\u043C\u0443
    \u0413\u0430\u043D\u0434\u0438**. \u041E\u0434\u043D\u0430\u043A\u043E \u043F\u043E\u043F\u044B\u0442\u043A\u0438
    \u0440\u0435\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u0435 \u043D\u0430\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0438\u0441\u044C
    \u043D\u0430 \u043C\u0435\u0441\u0442\u043D\u0443\u044E \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u043A\u0443
    \u0438 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435
    \u0438\u043D\u0442\u0440\u0438\u0433\u0438, \u0438 \u0447\u0435\u0440\u0435\u0437
    \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0433\u043E\u0434\u0430 \u0435\u0433\u043E
    \u0443\u0432\u043E\u043B\u0438\u043B\u0438.  ### \U0001F3DB\uFE0F \u0421\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435:
    \u0411\u0443\u0440\u0431\u0430\u043A\u0438 \u0438 \u043B\u0438\u0447\u043D\u0430\u044F
    \u0436\u0438\u0437\u043D\u044C  \u0412\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C
    \u0432\u043E \u0424\u0440\u0430\u043D\u0446\u0438\u044E, \u0412\u0435\u0439\u043B\u044C
    \u0432 1933 \u0433\u043E\u0434\u0443 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u043C\u0435\u0441\u0442\u043E \u0432 \u0421\u0442\u0440\u0430\u0441\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0418\u043C\u0435\u043D\u043D\u043E
    \u0437\u0434\u0435\u0441\u044C \u043E\u043D \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u0433\u0440\u0443\u043F\u043F\u043E\u0439 \u043C\u043E\u043B\u043E\u0434\u044B\u0445
    \u0435\u0434\u0438\u043D\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u0438\u043A\u043E\u0432
    (\u0410\u043D\u0440\u0438 \u041A\u0430\u0440\u0442\u0430\u043D, \u0416\u0430\u043D
    \u0414\u044C\u0451\u0434\u043E\u043D\u043D\u0435, \u041A\u043B\u043E\u0434 \u0428\u0435\u0432\u0430\u043B\u043B\u0435)
    \u0441\u0442\u0430\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u044B
    **\u041D\u0438\u043A\u043E\u043B\u044F \u0411\u0443\u0440\u0431\u0430\u043A\u0438**. 
    \u0412 1937 \u0433\u043E\u0434\u0443 \u043E\u043D \u0436\u0435\u043D\u0438\u043B\u0441\u044F
    \u043D\u0430 **\u042D\u0432\u0435\u043B\u0438\u043D\u0435**, \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0443 \u043D\u0435\u0433\u043E \u043F\u043E\u0437\u0436\u0435 \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    \u0441\u044B\u043D.  ### \u2694\uFE0F \u0412\u043E\u0439\u043D\u0430 \u0438 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043F\u043E\u0431\u0435\u0433  \u0421 \u043D\u0430\u0447\u0430\u043B\u043E\u043C
    \u0412\u0442\u043E\u0440\u043E\u0439 \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0412\u0435\u0439\u043B\u044C \u0441 \u0436\u0435\u043D\u043E\u0439
    \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0432 \u0424\u0438\u043D\u043B\u044F\u043D\u0434\u0438\u0438.
    \u041F\u043E \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u043C
    \u0437\u0430\u043A\u043E\u043D\u0430\u043C, \u043E\u043D \u0431\u044B\u043B \u043E\u0431\u044F\u0437\u0430\u043D
    \u044F\u0432\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u0441\u0431\u043E\u0440\u043D\u044B\u0439
    \u043F\u0443\u043D\u043A\u0442. \u041E\u0434\u043D\u0430\u043A\u043E \u0412\u0435\u0439\u043B\u044C,
    \u0443\u0431\u0435\u0436\u0434\u0435\u043D\u043D\u044B\u0439, \u0447\u0442\u043E
    \u0435\u0433\u043E \u043F\u0440\u0438\u0437\u0432\u0430\u043D\u0438\u0435 \u2014
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430, \u0430 \u043D\u0435
    \u0432\u043E\u0439\u043D\u0430, \u0440\u0435\u0448\u0438\u043B \u0443\u043A\u043B\u043E\u043D\u0438\u0442\u044C\u0441\u044F
    \u043E\u0442 \u043C\u043E\u0431\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438. 
    \u042D\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u043A \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443
    \u044D\u043F\u0438\u0437\u043E\u0434\u0443: \u0435\u0433\u043E \u0437\u0430\u043F\u043E\u0434\u043E\u0437\u0440\u0438\u043B\u0438
    \u0432 \u0448\u043F\u0438\u043E\u043D\u0430\u0436\u0435, \u0438 \u043E\u043D
    \u0431\u044B\u043B \u0430\u0440\u0435\u0441\u0442\u043E\u0432\u0430\u043D. \u041E\u0442
    \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u0430 \u0435\u0433\u043E \u0441\u043F\u0430\u0441\u043B\u043E
    \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0444\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430 **\u0420\u043E\u043B\u044C\u0444\u0430
    \u041D\u0435\u0432\u0430\u043D\u043B\u0438\u043D\u043D\u044B**.  \u041F\u043E\u0441\u043B\u0435
    \u044D\u0442\u043E\u0433\u043E \u043E\u043D \u0441\u0443\u043C\u0435\u043B \u0432\u044B\u0435\u0445\u0430\u0442\u044C
    \u0438\u0437 \u0424\u0438\u043D\u043B\u044F\u043D\u0434\u0438\u0438 \u0438 \u0432
    **1941 \u0433\u043E\u0434\u0443 \u043F\u0440\u0438\u0431\u044B\u043B \u0432 \u0421\u0428\u0410**. 
    ### \U0001F1FA\U0001F1F8 \u0416\u0438\u0437\u043D\u044C \u0438 \u0440\u0430\u0431\u043E\u0442\u0430
    \u0432 \u0410\u043C\u0435\u0440\u0438\u043A\u0435  \u0412 \u0410\u043C\u0435\u0440\u0438\u043A\u0435
    \u0412\u0435\u0439\u043B\u044C \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u0432 **\u041B\u0438\u0445\u0430\u0439\u0441\u043A\u043E\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435**,
    \u0433\u0434\u0435 \u0435\u0433\u043E \u043D\u0435 \u0446\u0435\u043D\u0438\u043B\u0438,
    \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0430\u043B\u0438 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u0435\u043C
    \u0438 \u043F\u043B\u0430\u0442\u0438\u043B\u0438 \u043C\u0430\u043B\u043E. \u041E\u043D
    \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0435\u043B \u044D\u0442\u043E\u0442
    \u043F\u0435\u0440\u0438\u043E\u0434 \u0438 \u043F\u043E\u043A\u043B\u044F\u043B\u0441\u044F
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043E \u043D\u0435\u043C \u043D\u0435
    \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C.  \u0417\u0430\u0442\u0435\u043C
    \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u0430
    \u0432 **\u0421\u0430\u043D-\u041F\u0430\u0443\u043B\u0443 (\u0411\u0440\u0430\u0437\u0438\u043B\u0438\u044F)**
    \u0432 1945\u20131947 \u0433\u043E\u0434\u0430\u0445, \u0433\u0434\u0435 \u043E\u043D,
    \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u043B
    \u0441 **\u041E\u0441\u043A\u0430\u0440\u043E\u043C \u0417\u0430\u0440\u0438\u0441\u043A\u0438\u043C**.
    \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u0412\u0435\u0439\u043B\u044C
    \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0432 \u0421\u0428\u0410 \u0438
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 **\u0427\u0438\u043A\u0430\u0433\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435** (1947\u20131958),
    \u0430 \u0437\u0430\u0442\u0435\u043C \u0432 **\u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435
    \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0432
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435** (1958\u20131976), \u0433\u0434\u0435
    \u0438 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u0434\u043E \u043A\u043E\u043D\u0446\u0430
    \u0436\u0438\u0437\u043D\u0438.  ### \U0001F91D \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0443\u0447\u0435\u043D\u044B\u043C\u0438 
    *   \u041E\u043D \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437
    \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439 \u0433\u0440\u0443\u043F\u043F\u044B
    \u0411\u0443\u0440\u0431\u0430\u043A\u0438 \u0438 \u0442\u0435\u0441\u043D\u043E
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u043B \u0441 \u0410\u043D\u0440\u0438
    \u041A\u0430\u0440\u0442\u0430\u043D\u043E\u043C, \u0416\u0430\u043D\u043E\u043C
    \u0414\u044C\u0451\u0434\u043E\u043D\u043D\u0435, \u041A\u043B\u043E\u0434\u043E\u043C
    \u0428\u0435\u0432\u0430\u043B\u043B\u0435. *   \u0415\u0433\u043E \u0443\u0447\u0435\u043D\u0438\u043A\u0430\u043C\u0438
    \u0431\u044B\u043B\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u041F\u044C\u0435\u0440
    \u041A\u0430\u0440\u0442\u044C\u0435 , \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u043E\u0437\u0436\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u043E
    \u043D\u0435\u043C \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0435
    \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F. *  
    \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
    \u0441\u0442\u043E\u043B\u043F\u0430\u043C\u0438 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B\u0438\u0441\u044C \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443.
    \u0415\u0433\u043E \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043B\u0430 \u043C\u043D\u043E\u0433\u043E\u043B\u0435\u0442\u043D\u044F\u044F
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438, \u0442\u0430\u043A\u0438\u043C\u0438
    \u043A\u0430\u043A \u041A\u043B\u043E\u0434 \u041B\u0435\u0432\u0438-\u0421\u0442\u0440\u043E\u0441\u0441
    (\u043A \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043A\u043D\u0438\u0433
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0412\u0435\u0439\u043B\u044C
    \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435), \u043E\u043D \u0432\u044B\u0441\u043E\u043A\u043E
    \u0446\u0435\u043D\u0438\u043B \u0438 \u043F\u0438\u0441\u0430\u043B \u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0445
    \u0413\u0435\u0440\u043C\u0430\u043D\u0430 \u0412\u0435\u0439\u043B\u044F. *  
    \u0415\u0433\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441
    **\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u043C \u0413\u0440\u043E\u0442\u0435\u043D\u0434\u0438\u043A\u043E\u043C**,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u043E\u043A\u0430\u0437\u0430\u043B
    \u0435\u0433\u043E \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B, \u0442\u0430\u043A\u0436\u0435
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0439
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435\u0439 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438.  ### \U0001F54A\uFE0F
    \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u0438 \u0441\u043C\u0435\u0440\u0442\u044C  \u0412 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435
    \u0412\u0435\u0439\u043B\u044C \u043F\u0440\u043E\u0432\u0435\u043B \u0441\u0432\u043E\u0438
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F,
    \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044C \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043D\u044B\u043C
    \u043F\u0430\u0442\u0440\u0438\u0430\u0440\u0445\u043E\u043C \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438. \u0412 1979 \u0433\u043E\u0434\u0443
    \u043E\u043D \u0431\u044B\u043B \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D
    \u043F\u0440\u0435\u043C\u0438\u0438 \u0412\u043E\u043B\u044C\u0444\u0430.  \u0410\u043D\u0434\u0440\u0435
    \u0412\u0435\u0439\u043B\u044C \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F
    **6 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1998 \u0433\u043E\u0434\u0430**
    \u0432 \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
    92 \u043B\u0435\u0442. \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u0431\u044B\u043B\u0430
    \u0434\u043E\u043B\u0433\u043E\u0439 \u0438 \u0431\u0443\u0440\u043D\u043E\u0439,
    \u043F\u043E\u043B\u043D\u043E\u0439 \u043A\u0430\u043A \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0445\u0441\u044F
    \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439,
    \u0442\u0430\u043A \u0438 \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u043E\u0431\u044B\u0442\u0438\u0439, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0435\u0433\u043E \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u044B \u0438 \u0443\u0431\u0435\u0436\u0434\u0435\u043D\u0438\u044F
    \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u043B\u0438\u0441\u044C \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u044B\u043C
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F\u043C."
  personalLifeEn: 
  shortBioRu: "\u0410\u043D\u0434\u0440\u0435 \u0412\u0435\u0439\u043B\u044C (1906\u20131998)
    \u0431\u044B\u043B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432
    XX \u0432\u0435\u043A\u0430, \u043D\u043E \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C
    \u043D\u0435\u043E\u0431\u044B\u0447\u0430\u0439\u043D\u043E \u0448\u0438\u0440\u043E\u043A\u0438\u0445
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0445
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432, \u0447\u044C\u044F \u0436\u0438\u0437\u043D\u044C
    \u0431\u044B\u043B\u0430 \u0442\u0435\u0441\u043D\u043E \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0435\u043D\u0430
    \u0441 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439, \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0435\u0439
    \u0438 \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u0412\u043E\u0442 \u0435\u0433\u043E
    \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0430\u044F \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F. 
    ### \u0414\u0435\u0442\u0441\u0442\u0432\u043E \u0438 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 (1906\u20131920-\u0435)  \u0410\u043D\u0434\u0440\u0435
    \u0410\u0432\u0440\u0430\u0430\u043C \u0412\u0435\u0439\u043B\u044C \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    6 \u043C\u0430\u044F 1906 \u0433\u043E\u0434\u0430 \u0432 \u041F\u0430\u0440\u0438\u0436\u0435
    \u0432 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u043E\u0439
    \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0439 \u0441\u0435\u043C\u044C\u0435,
    \u0432\u044B\u0445\u043E\u0434\u0446\u0430\u0445 \u0438\u0437 \u042D\u043B\u044C\u0437\u0430\u0441\u0430.
    \u0415\u0433\u043E \u043E\u0442\u0435\u0446 \u0431\u044B\u043B \u0432\u0440\u0430\u0447\u043E\u043C,
    \u043C\u0430\u0442\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u0445\u043E\u0440\u043E\u0448\u0435\u0435
    \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435.
    \u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u0432 \u0434\u043E\u043C\u0435
    \u0446\u0430\u0440\u0438\u043B\u0430 \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u0430\u044F
    \u0438 \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u0430\u044F;
    \u0434\u0440\u0443\u0436\u0431\u0430 \u0441\u0435\u043C\u044C\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0441 \u043D\u043E\u0431\u0435\u043B\u0435\u0432\u0441\u043A\u0438\u043C \u043B\u0430\u0443\u0440\u0435\u0430\u0442\u043E\u043C
    \u0418\u043B\u044C\u0451\u0439 \u041C\u0435\u0447\u043D\u0438\u043A\u043E\u0432\u044B\u043C,
    \u0431\u044B\u043B\u0430 \u0447\u0430\u0441\u0442\u044C\u044E \u0438\u0445 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E\u0433\u043E
    \u043A\u0440\u0443\u0433\u0430.  \u0421 \u0440\u0430\u043D\u043D\u0438\u0445
    \u043B\u0435\u0442 \u0443 \u0410\u043D\u0434\u0440\u0435 \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
    \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u043A \u044F\u0437\u044B\u043A\u0430\u043C. \u0420\u043E\u0434\u0438\u0442\u0435\u043B\u0438
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
    \u043F\u043E-\u043D\u0435\u043C\u0435\u0446\u043A\u0438, \u0438 \u0434\u0435\u0442\u0438,
    \u043F\u043E\u0434\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044F \u0438\u0445,
    \u0432\u044B\u0443\u0447\u0438\u043B\u0438 \u044F\u0437\u044B\u043A \u0432 \u0440\u0430\u043D\u043D\u0435\u043C
    \u0434\u0435\u0442\u0441\u0442\u0432\u0435. \u042D\u0442\u043E \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435
    \u0441\u0442\u0430\u043B\u043E \u043F\u043E\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u043C:
    \u043E\u043D \u0438\u0437\u0443\u0447\u0430\u043B \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439,
    \u043B\u0430\u0442\u044B\u043D\u044C \u0438, \u0447\u0442\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0432\u0430\u0436\u043D\u043E, \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442,
    \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043D\u0430\u0447\u0430\u043B \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
    \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0430 \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440\u0430
    \u0421\u0438\u043B\u044C\u0432\u0435\u043D\u0430 \u041B\u0435\u0432\u0438. \u041F\u043E\u0437\u0436\u0435
    \u0412\u0435\u0439\u043B\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
    \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442 \u0434\u043B\u044F \u0447\u0442\u0435\u043D\u0438\u044F
    \u0434\u0440\u0435\u0432\u043D\u0435\u0438\u043D\u0434\u0438\u0439\u0441\u043A\u0438\u0445
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u0438\u0445 \u0442\u0435\u043A\u0441\u0442\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435, \u0445\u043E\u0442\u044F \u043E\u043D
    \u0438 \u0431\u044B\u043B \u0434\u0430\u043B\u0451\u043A \u043E\u0442 \u0440\u0435\u043B\u0438\u0433\u0438\u0438,
    \u043E\u043A\u0430\u0437\u0430\u043B\u0438 \u0432\u043B\u0438\u044F\u043D\u0438\u0435
    \u043D\u0430 \u0435\u0433\u043E \u043C\u0438\u0440\u043E\u0432\u043E\u0437\u0437\u0440\u0435\u043D\u0438\u0435
    \u0438 \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u044F.
    \u0421\u0442\u043E\u0438\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C,
    \u0447\u0442\u043E \u0435\u0433\u043E \u043C\u043B\u0430\u0434\u0448\u0430\u044F
    \u0441\u0435\u0441\u0442\u0440\u0430, \u0421\u0438\u043C\u043E\u043D\u0430 \u0412\u0435\u0439\u043B\u044C,
    \u0441\u0442\u0430\u043B\u0430 \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u043E\u043C
    \u0438 \u043C\u0438\u0441\u0442\u0438\u043A\u043E\u043C.  \u041F\u0435\u0440\u0432\u0430\u044F
    \u043C\u0438\u0440\u043E\u0432\u0430\u044F \u0432\u043E\u0439\u043D\u0430 \u0432\u043D\u0435\u0441\u043B\u0430
    \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0432\u044B \u0432 \u0435\u0433\u043E
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435: \u043E\u0442\u0446\u0430
    \u043F\u0440\u0438\u0437\u0432\u0430\u043B\u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u043C
    \u0432\u0440\u0430\u0447\u043E\u043C, \u0438 \u0441\u0435\u043C\u044C\u044F \u0447\u0430\u0441\u0442\u043E
    \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043B\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0410\u043D\u0434\u0440\u0435 \u0438\u043D\u043E\u0433\u0434\u0430 \u0443\u0447\u0438\u043B\u0441\u044F
    \u0434\u043E\u043C\u0430. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435,
    \u0435\u0433\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
    \u0440\u0430\u043D\u043E \u2014 \u043E\u043D \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u043E\u0441\u0432\u043E\u0438\u043B \u0448\u043A\u043E\u043B\u044C\u043D\u044B\u0439
    \u0443\u0447\u0435\u0431\u043D\u0438\u043A \u0430\u043B\u0433\u0435\u0431\u0440\u044B
    \u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432 \u043A\u043E\u043D\u043A\u0443\u0440\u0441\u0430\u0445
    \u043F\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044E \u0437\u0430\u0434\u0430\u0447
    \u0434\u043B\u044F \xAB\u0416\u0443\u0440\u043D\u0430\u043B\u0430 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438\xBB.  ### \u041D\u0430\u0447\u0430\u043B\u043E
    \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0438 (1920-\u0435
    \u2013 1933)  \u041E\u043A\u043E\u043D\u0447\u0438\u0432 \u0448\u043A\u043E\u043B\u0443
    \u0434\u043E\u0441\u0440\u043E\u0447\u043D\u043E, \u0412\u0435\u0439\u043B\u044C
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0441\u0430\u043C\u043E\u0435
    \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u043E\u0435 \u0432\u044B\u0441\u0448\u0435\u0435
    \u0443\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0424\u0440\u0430\u043D\u0446\u0438\u0438 \u2014 \u0412\u044B\u0441\u0448\u0443\u044E
    \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u0448\u043A\u043E\u043B\u0443
    (\xC9cole Normale Sup\xE9rieure). \u0422\u0430\u043C \u043E\u043D \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0433\u043B\u0443\u0431\u043B\u0451\u043D\u043D\u043E
    \u0438\u0437\u0443\u0447\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443,
    \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u0440\u0430\u0431\u043E\u0442\u044B
    \u0420\u0438\u043C\u0430\u043D\u0430, \u043D\u043E \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B
    \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u043E\u043C.
    \u0412 1925 \u0433\u043E\u0434\u0443 \u043E\u043D \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435, \u0430 \u0432 1928 \u0433\u043E\u0434\u0443,
    \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u0416\u0430\u043A\u0430 \u0410\u0434\u0430\u043C\u0430\u0440\u0430 \u0438 \u042D\u043C\u0438\u043B\u044F
    \u041F\u0438\u043A\u0430\u0440\u0430, \u0437\u0430\u0449\u0438\u0442\u0438\u043B
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0434\u0438\u043E\u0444\u0430\u043D\u0442\u043E\u0432\u043E\u0439 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0432\u043E\u0448\u043B\u0430 \u0432 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438.  \u041F\u043E\u0441\u043B\u0435
    \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0441\u0442\u0438\u043F\u0435\u043D\u0434\u0438\u044E \u0434\u043B\u044F \u043F\u043E\u0435\u0437\u0434\u043E\u043A
    \u043F\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u043C \u0446\u0435\u043D\u0442\u0440\u0430\u043C
    \u0418\u0442\u0430\u043B\u0438\u0438 \u0438 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438.
    \u0412\u0430\u0436\u043D\u044B\u043C \u044D\u0442\u0430\u043F\u043E\u043C \u0441\u0442\u0430\u043B\u043E
    \u0435\u0433\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E
    \u0441 \u042D\u043C\u043C\u0438 \u041D\u0451\u0442\u0435\u0440, \u0432\u0435\u043B\u0438\u043A\u0438\u043C
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0441\u0442\u043E\u043C, \u0443
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u043D \u0443\u0447\u0438\u043B\u0441\u044F
    \u0432 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438. \u042D\u0442\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u043E
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0432\u043B\u0438\u044F\u043D\u0438\u0435
    \u043D\u0430 \u0435\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434 \u043A \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435. 
    ### \xAB\u0418\u043D\u0434\u0438\u0439\u0441\u043A\u0430\u044F \u043E\u0434\u0438\u0441\u0441\u0435\u044F\xBB
    \u0438 \u0411\u0443\u0440\u0431\u0430\u043A\u0438 (1930\u20131939)  \u0412\u043E
    \u0424\u0440\u0430\u043D\u0446\u0438\u0438 \u043D\u0435 \u0431\u044B\u043B\u043E
    \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0445 \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u0439,
    \u0438 \u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
    \u043F\u043E \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0443, \u0421\u0438\u043B\u044C\u0432\u0435\u043D
    \u041B\u0435\u0432\u0438, \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F
    \u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0438 \u0412\u0435\u0439\u043B\u044F
    \u043D\u0430 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u0437\u0430\u0432\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
    \u043A\u0430\u0444\u0435\u0434\u0440\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0410\u043B\u0438\u0433\u0430\u0440\u0445\u0430 \u0432 \u0411\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u043E\u0439
    \u0418\u043D\u0434\u0438\u0438. \u042D\u0442\u043E \u0431\u044B\u043B \u0441\u043C\u0435\u043B\u044B\u0439
    \u0438 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0448\u0430\u0433
    \u0434\u043B\u044F \u043C\u043E\u043B\u043E\u0434\u043E\u0433\u043E \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430.  \u041F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u0435
    \u0432 \u0418\u043D\u0434\u0438\u0438 (\u043D\u0430\u0447\u0430\u043B\u043E 1930-\u0445)
    \u0441\u0442\u0430\u043B\u043E \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0432\u0430\u0436\u043D\u044B\u043C
    \u043B\u0438\u0447\u043D\u044B\u043C \u043E\u043F\u044B\u0442\u043E\u043C: \u043E\u043D
    \u043C\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B,
    \u043E\u0431\u0449\u0430\u043B\u0441\u044F \u0441 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u0430\u043C\u0438,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u041C\u0430\u0445\u0430\u0442\u043C\u0443
    \u0413\u0430\u043D\u0434\u0438. \u041E\u0434\u043D\u0430\u043A\u043E \u0435\u0433\u043E
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 \u0440\u0435\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043D\u0438\u0435 \u0438
    \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
    \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C \u0438\u0437-\u0437\u0430
    \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u043A\u0438
    \u0438 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u043D\u0442\u0440\u0438\u0433, \u0438 \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
    \u0433\u043E\u0434\u0430 \u0435\u0433\u043E \u0443\u0432\u043E\u043B\u0438\u043B\u0438. 
    \u0412\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C \u0432\u043E \u0424\u0440\u0430\u043D\u0446\u0438\u044E,
    \u0412\u0435\u0439\u043B\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043C\u0435\u0441\u0442\u043E
    \u0432 \u0421\u0442\u0440\u0430\u0441\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u043C
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (1933\u20131940).
    \u0418\u043C\u0435\u043D\u043D\u043E \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
    \u0435\u0433\u043E \u0441\u0430\u043C\u0430\u044F \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u0430\u044F
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C. \u0412\u043C\u0435\u0441\u0442\u0435
    \u0441 \u0433\u0440\u0443\u043F\u043F\u043E\u0439 \u043C\u043E\u043B\u043E\u0434\u044B\u0445
    \u0435\u0434\u0438\u043D\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u0438\u043A\u043E\u0432
    (\u0410\u043D\u0440\u0438 \u041A\u0430\u0440\u0442\u0430\u043D, \u0416\u0430\u043D
    \u0414\u044C\u0451\u0434\u043E\u043D\u043D\u0435, \u041A\u043B\u043E\u0434 \u0428\u0435\u0432\u0430\u043B\u043B\u0435
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435) \u043E\u043D \u0441\u0442\u0430\u043B
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u044B
    **\u041D\u0438\u043A\u043E\u043B\u044F \u0411\u0443\u0440\u0431\u0430\u043A\u0438**.
    \u0418\u0445 \u0446\u0435\u043B\u044C\u044E \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0438\u0437\u043B\u043E\u0436\u0438\u0442\u044C
    \u043E\u0441\u043D\u043E\u0432\u044B \u0432\u0441\u0435\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438
    \u0441 \u0435\u0434\u0438\u043D\u044B\u0445 \u043F\u043E\u0437\u0438\u0446\u0438\u0439,
    \u043E\u0442\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u044F\u0441\u044C \u043E\u0442
    \u0442\u0435\u043E\u0440\u0438\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432,
    \u0438 \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439
    \u0441\u0442\u0440\u043E\u0433\u0438\u0439 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442
    \u0434\u043B\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0437\u043D\u0430\u043D\u0438\u044F. \u0420\u0430\u0431\u043E\u0442\u0430 \u043D\u0430\u0434
    \u043C\u043D\u043E\u0433\u043E\u0442\u043E\u043C\u043D\u044B\u043C\u0438 \xAB\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438\xBB \u0441\u0442\u0430\u043B\u0430
    \u0434\u0435\u043B\u043E\u043C \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043D\u0438
    \u0434\u043B\u044F \u0412\u0435\u0439\u043B\u044F \u0438 \u0435\u0433\u043E \u0441\u043E\u0440\u0430\u0442\u043D\u0438\u043A\u043E\u0432. 
    ### \u0412\u043E\u0439\u043D\u0430, \u044D\u043C\u0438\u0433\u0440\u0430\u0446\u0438\u044F
    \u0438 \u0437\u0440\u0435\u043B\u044B\u0435 \u0433\u043E\u0434\u044B (1940\u20131998) 
    \u0421 \u043D\u0430\u0447\u0430\u043B\u043E\u043C \u0412\u0442\u043E\u0440\u043E\u0439
    \u043C\u0438\u0440\u043E\u0432\u043E\u0439 \u0432\u043E\u0439\u043D\u044B, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0435\u0432\u0440\u0435\u0435\u043C, \u0412\u0435\u0439\u043B\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u0432 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438. \u041E\u043D \u044D\u043C\u0438\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043B
    \u0432 \u0421\u0428\u0410, \u0433\u0434\u0435 \u043D\u0430\u0447\u0430\u043B
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u041F\u0435\u043D\u0441\u0438\u043B\u044C\u0432\u0430\u043D\u0438\u0438 (1941\u20131945),
    \u0437\u0430\u0442\u0435\u043C \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0421\u0430\u043D-\u041F\u0430\u0443\u043B\u0443 \u0432 \u0411\u0440\u0430\u0437\u0438\u043B\u0438\u0438
    (1945\u20131947), \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0448\u0451\u043B
    \u0432 \u0427\u0438\u043A\u0430\u0433\u0441\u043A\u0438\u0439 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
    (1947\u20131958). \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u043C \u044D\u0442\u0430\u043F\u043E\u043C
    \u0435\u0433\u043E \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043A\u0430\u0440\u044C\u0435\u0440\u044B \u0441\u0442\u0430\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u0430
    \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0432
    \u041F\u0440\u0438\u043D\u0441\u0442\u043E\u043D\u0435 (1958\u20131976), \u0433\u0434\u0435
    \u043E\u043D \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u0434\u043E
    \u0432\u044B\u0445\u043E\u0434\u0430 \u043D\u0430 \u043F\u0435\u043D\u0441\u0438\u044E
    \u0438 \u0433\u0434\u0435 \u0443\u043C\u0435\u0440 6 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1998 \u0433\u043E\u0434\u0430.  \u0412 \u044D\u0442\u0438 \u0433\u043E\u0434\u044B
    \u043E\u043D \u0441\u0442\u0430\u043B \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043D\u044B\u043C
    \u043B\u0438\u0434\u0435\u0440\u043E\u043C \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438. \u0415\u0433\u043E
    \u0433\u043B\u0430\u0432\u043D\u044B\u0435 \u0442\u0440\u0443\u0434\u044B \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F
    \u043A \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u043E\u043D \u043F\u0435\u0440\u0435\u043E\u0441\u043C\u044B\u0441\u043B\u0438\u043B
    \u0438 \u043F\u0440\u0438\u0434\u0430\u043B \u0435\u0439 \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u044C,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u043A \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B \u0438 \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u0438.
    \u041E\u043D \u0440\u0430\u0437\u0432\u0438\u043B \u0442\u0435\u043E\u0440\u0438\u044E
    \u0438\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432 \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0433\u0440\u0443\u043F\u043F\u0430\u0445 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043B
    \u043C\u0435\u0442\u043E\u0434\u044B \u0433\u043E\u043C\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0430\u043B\u0433\u0435\u0431\u0440\u044B \u043A \u0442\u0435\u043E\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043B (\u043A\u043E\u0433\u043E\u043C\u043E\u043B\u043E\u0433\u0438\u0438
    \u0413\u0430\u043B\u0443\u0430).  ### \u041D\u0430\u0441\u043B\u0435\u0434\u0438\u0435:
    \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B \u0412\u0435\u0439\u043B\u044F
    \u0438 \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B 
    \u0412\u0435\u0440\u0448\u0438\u043D\u043E\u0439 \u0435\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E
    \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430 \u0441\u0442\u0430\u043B\u0438
    **\u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B \u0412\u0435\u0439\u043B\u044F**
    (\u0434\u043E\u043A\u0430\u0437\u0430\u043D\u044B \u0432 1970-\u0445 \u0433\u043E\u0434\u0430\u0445
    \u0413\u0440\u043E\u0442\u0435\u043D\u0434\u0438\u043A\u043E\u043C \u0438 \u0414\u0435\u043B\u0438\u043D\u0435\u043C).
    \u041E\u043D\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
    \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u0441\u0432\u044F\u0437\u044C
    \u043C\u0435\u0436\u0434\u0443 \u0434\u0438\u0441\u043A\u0440\u0435\u0442\u043D\u044B\u043C
    \u043C\u0438\u0440\u043E\u043C \u0430\u043B\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u043D\u043E\u0433\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0439 \u0438
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u043C \u043C\u0438\u0440\u043E\u043C
    \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u0438, \u0447\u0442\u043E \u0441\u0442\u0430\u043B\u043E
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0441\u043E\u0431\u044B\u0442\u0438\u0439 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435
    XX \u0432\u0435\u043A\u0430.  \u041F\u043E\u043C\u0438\u043C\u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438,
    \u0412\u0435\u0439\u043B\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u0441\u044F
    \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439 \u043D\u0430\u0443\u043A\u0438
    \u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0435\u0439. \u041D\u0430
    \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u044B \u0437\u0430\u043C\u0435\u0442\u043D\u043E
    \u043F\u043E\u0432\u043B\u0438\u044F\u043B **\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430\u043B\u0438\u0437\u043C**,
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0447\u0435\u0440\u0435\u0437
    \u043B\u0438\u0447\u043D\u043E\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E
    \u0441 \u041A\u043B\u043E\u0434\u043E\u043C \u041B\u0435\u0432\u0438-\u0421\u0442\u0440\u043E\u0441\u0441\u043E\u043C.
    \u0412\u0435\u0439\u043B\u044C \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043A \u0435\u0433\u043E
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0439 \u043A\u043D\u0438\u0433\u0435
    \xAB\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u044B\u0435
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B \u0440\u043E\u0434\u0441\u0442\u0432\u0430\xBB.
    \u041E\u043D \u0442\u0430\u043A\u0436\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E
    \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043D\u0430 \u043C\u043D\u043E\u0433\u0438\u0445
    \u044F\u0437\u044B\u043A\u0430\u0445, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0440\u0443\u0441\u0441\u043A\u0438\u0439, \u0438 \u0447\u0438\u0442\u0430\u043B
    \u043B\u0435\u043A\u0446\u0438\u0438 \u043D\u0430 \u043F\u043E\u0440\u0442\u0443\u0433\u0430\u043B\u044C\u0441\u043A\u043E\u043C
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0431\u043E\u0442\u044B
    \u0432 \u0411\u0440\u0430\u0437\u0438\u043B\u0438\u0438.  ### \u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435 
    \u0410\u043D\u0434\u0440\u0435 \u0412\u0435\u0439\u043B\u044C \u0431\u044B\u043B
    \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0430
    \u043D\u0430\u0433\u0440\u0430\u0434, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u043F\u0440\u0435\u043C\u0438\u044E \u0412\u043E\u043B\u044C\u0444\u0430 \u043F\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 (1979), \u043F\u0440\u0435\u043C\u0438\u044E
    \u0421\u0442\u0438\u043B\u0430 (1980) \u0438 \u043F\u0440\u0435\u043C\u0438\u044E
    \u041A\u0438\u043E\u0442\u043E (1994). \u041E\u043D \u0431\u044B\u043B \u0447\u043B\u0435\u043D\u043E\u043C
    \u0424\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u0439 \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0438
    \u043D\u0430\u0443\u043A \u0438 \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C
    \u0447\u043B\u0435\u043D\u043E\u043C \u041B\u043E\u043D\u0434\u043E\u043D\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0433\u043E \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430.
    \u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u0438 \u0440\u0430\u0431\u043E\u0442\u0430
    \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043D\u0435\u0438\u0437\u0433\u043B\u0430\u0434\u0438\u043C\u044B\u0439
    \u0441\u043B\u0435\u0434 \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435,
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0432 \u0435\u0451 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u0432\u043F\u0435\u0440\u0451\u0434."
  shortBioEn: 
  interestingFactsRu: "\u0410\u043D\u0434\u0440\u0435 \u0412\u0435\u0439\u043B\u044C
    \u0431\u044B\u043B \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u043C\u0441\u044F
    \u0438 \u043C\u043D\u043E\u0433\u043E\u0433\u0440\u0430\u043D\u043D\u044B\u043C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u043F\u043E\u043B\u043D\u0430
    \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u0444\u0430\u043A\u0442\u043E\u0432.
    \u0412\u043E\u0442 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0437
    \u043D\u0438\u0445.  ### \U0001F5E3\uFE0F \u041F\u043E\u043B\u0438\u0433\u043B\u043E\u0442
    \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430  \u042F\u0437\u044B\u043A\u0438
    \u0434\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u0412\u0435\u0439\u043B\u044E
    \u0441 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043B\u0435\u0433\u043A\u043E\u0441\u0442\u044C\u044E. \u041D\u0430\u0447\u0430\u043B\u043E\u0441\u044C
    \u0432\u0441\u0451 \u0441 **\u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0433\u043E**:
    \u0435\u0433\u043E \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
    \u043D\u0430 \u043D\u0435\u043C, \u043A\u043E\u0433\u0434\u0430 \u043D\u0435
    \u0445\u043E\u0442\u0435\u043B\u0438, \u0447\u0442\u043E\u0431\u044B \u0434\u0435\u0442\u0438
    \u043F\u043E\u043D\u0438\u043C\u0430\u043B\u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.
    \u0412 \u0438\u0442\u043E\u0433\u0435 \u0410\u043D\u0434\u0440\u0435 \u0438 \u0435\u0433\u043E
    \u0441\u0435\u0441\u0442\u0440\u0430 \u0421\u0438\u043C\u043E\u043D\u0430 \u0432\u044B\u0443\u0447\u0438\u043B\u0438
    \u044F\u0437\u044B\u043A, \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0434\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044F
    \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445.  \u0412 \u044E\u043D\u043E\u0441\u0442\u0438
    \u043E\u043D \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E \u0443\u0432\u043B\u0435\u043A\u0441\u044F
    **\u0434\u0440\u0435\u0432\u043D\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u043C
    \u0438 \u043B\u0430\u0442\u044B\u043D\u044C\u044E**, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0438 **\u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u043E\u043C**. \u0415\u0433\u043E
    \u0441\u0442\u0440\u0430\u0441\u0442\u044C \u043A \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0443
    \u0431\u044B\u043B\u0430 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u0441\u0438\u043B\u044C\u043D\u0430, \u0447\u0442\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0430
    \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
    (\u0438\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u043E\u0442 \u044F\u0437\u044B\u043A
    \u043F\u0440\u0438\u0432\u0435\u043B \u0435\u0433\u043E \u0432 \u0418\u043D\u0434\u0438\u044E).
    \u041D\u043E \u0438 \u044D\u0442\u043E \u043D\u0435 \u0432\u0441\u0435: \u0432\u043E
    \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0411\u0440\u0430\u0437\u0438\u043B\u0438\u0438
    \u043E\u043D **\u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443
    \u043D\u0430 \u043F\u043E\u0440\u0442\u0443\u0433\u0430\u043B\u044C\u0441\u043A\u043E\u043C**,
    \u0447\u0438\u0442\u0430\u043B \u043B\u0435\u043A\u0446\u0438\u0438 \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u043B\u0441\u044F
    **\u043F\u043E-\u0440\u0443\u0441\u0441\u043A\u0438**, \u0430 \u0432 \u0421\u0428\u0410
    \u0435\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u044F\u0437\u044B\u043A\u043E\u043C
    \u0441\u0442\u0430\u043B \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438\u0439. 
    ### \U0001F575\uFE0F \u0428\u043F\u0438\u043E\u043D\u0441\u043A\u0438\u0439 \u0441\u043A\u0430\u043D\u0434\u0430\u043B
    \u0438 \u0432\u0438\u0437\u0438\u0442\u043A\u0438 \u0411\u0443\u0440\u0431\u0430\u043A\u0438 
    \u042D\u0442\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u0441\u0430\u043C\u044B\u0439
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u043A\u0443\u0440\u044C\u0435\u0437
    \u0432 \u0435\u0433\u043E \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438.
    \u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0412\u0442\u043E\u0440\u043E\u0439
    \u043C\u0438\u0440\u043E\u0432\u043E\u0439 \u0432\u043E\u0439\u043D\u044B \u0412\u0435\u0439\u043B\u044C
    \u0443\u0435\u0445\u0430\u043B \u0438\u0437 \u0424\u0440\u0430\u043D\u0446\u0438\u0438
    \u0432 \u0424\u0438\u043D\u043B\u044F\u043D\u0434\u0438\u044E. \u0424\u0438\u043D\u043B\u044F\u043D\u0434\u0438\u044F
    \u0432 \u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442 \u0432\u043E\u0435\u0432\u0430\u043B\u0430
    \u0441 \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u043C \u0421\u043E\u044E\u0437\u043E\u043C,
    \u0438 \u0443 \u0432\u043B\u0430\u0441\u0442\u0435\u0439 \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u0438
    \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u044F, \u0447\u0442\u043E
    \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0448\u043F\u0438\u043E\u043D\u043E\u043C. 
    \u0427\u0442\u043E \u0436\u0435 \u0432\u044B\u0437\u0432\u0430\u043B\u043E \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u044F?
    \u0412 \u0435\u0433\u043E \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u043D\u0430\u0448\u043B\u0438
    **\u0432\u0438\u0437\u0438\u0442\u043A\u0438 \u043D\u0430 \u0438\u043C\u044F
    \"\u041D\u0438\u043A\u043E\u043B\u0430 \u0411\u0443\u0440\u0431\u0430\u043A\u0438\"**
    \u0438 \u043F\u0438\u0441\u044C\u043C\u0430 \u043A \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u043C
    \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C-\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430\u043C.
    \u0414\u043B\u044F \u043D\u0435\u043E\u0441\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044B\u0445
    \u0444\u0438\u043D\u0441\u043A\u0438\u0445 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0445
    \u044D\u0442\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u043E \u043A\u0430\u043A
    \u0443\u043B\u0438\u043A\u0430. \u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435,
    \"\u041D\u0438\u043A\u043E\u043B\u044F \u0411\u0443\u0440\u0431\u0430\u043A\u0438\"
    \u0431\u044B\u043B \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u043C
    \u043F\u0441\u0435\u0432\u0434\u043E\u043D\u0438\u043C\u043E\u043C \u0433\u0440\u0443\u043F\u043F\u044B
    \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0445 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432,
    \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0431\u044B\u043B \u0412\u0435\u0439\u043B\u044C.
    \u041E\u0442 \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u0430 \u0435\u0433\u043E,
    \u043F\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0435, \u0441\u043F\u0430\u0441\u043B\u043E
    \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0444\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430 \u0420\u043E\u043B\u044C\u0444\u0430
    \u041D\u0435\u0432\u0430\u043D\u043B\u0438\u043D\u043D\u044B.  ### \U0001F4D6
    \u0423\u0447\u0451\u0431\u0430 \u0438 \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442,
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0432\u0448\u0438\u0439 \u043A\u0430\u0440\u044C\u0435\u0440\u0443 
    \u041B\u044E\u0431\u043E\u0432\u044C \u043A \u0434\u0440\u0435\u0432\u043D\u0438\u043C
    \u044F\u0437\u044B\u043A\u0430\u043C \u0441\u044B\u0433\u0440\u0430\u043B\u0430
    \u0432 \u0441\u0443\u0434\u044C\u0431\u0435 \u0412\u0435\u0439\u043B\u044F \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0431\u0430\u0432\u043D\u0443\u044E
    \u0440\u043E\u043B\u044C. \u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u0441\u043B\u0435
    \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435\u0439 \u0443\u0447\u0435\u0431\u044B
    \u0438 \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u0438 \u043E\u043D
    \u043D\u0435 \u043C\u043E\u0433 \u043D\u0430\u0439\u0442\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0432\u043E \u0424\u0440\u0430\u043D\u0446\u0438\u0438,
    \u0438\u043C\u0435\u043D\u043D\u043E \u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
    \u043F\u043E \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0443, \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440
    \u0421\u0438\u043B\u044C\u0432\u0435\u043D \u041B\u0435\u0432\u0438, \u043F\u043E\u043C\u043E\u0433
    \u0435\u043C\u0443 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C
    **\u0437\u0430\u0432\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043A\u0430\u0444\u0435\u0434\u0440\u043E\u0439
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
    \u0438\u043D\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430
    \u0410\u043B\u0438\u0433\u0430\u0440\u0445**. \u0422\u0430\u043A \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435
    \u044F\u0437\u044B\u043A\u0430\u043C\u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u043E
    \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u0441\u0442\u0440\u0430\u043D\u0435,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043E\u043D \u043F\u043E\u043B\u044E\u0431\u0438\u043B
    \u0437\u0430\u043E\u0447\u043D\u043E.  ### \U0001F91D \u041D\u0435\u0442, \u043E\u043D
    \u043D\u0435 \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A
    \u0413\u0435\u0440\u043C\u0430\u043D\u0443 \u0412\u0435\u0439\u043B\u044E  \u0418\u043C\u044F
    \"\u0412\u0435\u0439\u043B\u044C\" \u0432 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E \u043E\u0447\u0435\u043D\u044C
    \u0445\u043E\u0440\u043E\u0448\u043E, \u043D\u043E \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
    \u043F\u0443\u0442\u0430\u0442\u044C \u043D\u0430\u0448\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C \u0432\u0435\u043B\u0438\u043A\u0438\u043C
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C, **\u0413\u0435\u0440\u043C\u0430\u043D\u043E\u043C
    \u0412\u0435\u0439\u043B\u0435\u043C**. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0441\u0445\u043E\u0436\u0443\u044E \u0444\u0430\u043C\u0438\u043B\u0438\u044E
    \u0438 \u043E\u0431\u0449\u0443\u044E \u043E\u0431\u043B\u0430\u0441\u0442\u044C
    \u043D\u0430\u0443\u043A\u0438, \u043E\u043D\u0438 \u043D\u0435 \u0431\u044B\u043B\u0438
    \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430\u043C\u0438.
    \u0410\u043D\u0434\u0440\u0435, \u043E\u0434\u043D\u0430\u043A\u043E, \u0445\u043E\u0440\u043E\u0448\u043E
    \u0437\u043D\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u044B \u0413\u0435\u0440\u043C\u0430\u043D\u0430
    \u0412\u0435\u0439\u043B\u044F \u0438 \u0434\u0430\u0436\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043B
    \u043E \u043D\u0438\u0445 \u0441\u0442\u0430\u0442\u044C\u044E."
