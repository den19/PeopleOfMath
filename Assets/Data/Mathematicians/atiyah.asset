  achievementsRu: "\u041c\u0430\u0439\u043a\u043b \u0410\u0442\u044c\u044f \u0431\u044b\u043b \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c, \u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c
    \"\u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u043e\u043c\" \u043d\u043e\u0432\u044b\u0445
    \u0441\u0432\u044f\u0437\u0435\u0439 \u043c\u0435\u0436\u0434\u0443, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0431\u044b, \u0434\u0430\u043b\u0435\u043a\u0438\u043c\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c\u0438
    \u043d\u0430\u0443\u043a\u0438. \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u2014 \u044d\u0442\u043e \u0442\u0440\u0438 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445
    \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u0432 \u043a\u0430\u0436\u0434\u043e\u043c
    \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b
    \u043f\u0440\u043e\u0440\u044b\u0432.\n\n\U0001F9E9 1. \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 K-\u0442\u0435\u043e\u0440\u0438\u0438
    \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 1960-\u0445 \u0433\u043e\u0434\u043e\u0432,
    \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u043e\u043c
    \u0425\u0438\u0440\u0446\u0435\u0431\u0440\u0443\u0445\u043e\u043c, \u0410\u0442\u044c\u044f
    \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u043e\u0432\u044b\u0439
    \u043c\u043e\u0449\u043d\u044b\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u2014 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    K-\u0442\u0435\u043e\u0440\u0438\u044e. \u042d\u0442\u043e\u0442 \u0440\u0430\u0437\u0434\u0435\u043b
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0438
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0438\u0437\u0443\u0447\u0430\u0442\u044c
    \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u043c\u043d\u043e\u0433\u043e\u043c\u0435\u0440\u043d\u044b\u0435
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432
    \u2014 \u043a\u043e\u043b\u0435\u0446. \u041f\u0440\u043e\u0441\u0442\u0430\u044f \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u044f:
    \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c\u0442\u0435, \u0447\u0442\u043e \u0443
    \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u044c.
    \u041a \u043a\u0430\u0436\u0434\u043e\u0439 \u0435\u0435 \u0442\u043e\u0447\u043a\u0435
    \u043c\u043e\u0436\u043d\u043e \"\u043f\u0440\u0438\u043a\u043b\u0435\u0438\u0442\u044c\"
    \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u0443\u044e \u043f\u0440\u044f\u043c\u0443\u044e,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u0430\u043a \u0432 \u043b\u0438\u0441\u0442\u0435
    \u041c\u0451\u0431\u0438\u0443\u0441\u0430. K-\u0442\u0435\u043e\u0440\u0438\u044f \u0438\u0437\u0443\u0447\u0430\u0435\u0442
    \u0442\u0430\u043a\u0438\u0435 \"\u0440\u0430\u0441\u0441\u043b\u043e\u0435\u043d\u0438\u044f\"
    \u0438 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442, \u043a\u0430\u043a \u0438\u0445
    \u043c\u043e\u0436\u043d\u043e \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c
    \u0438 \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c. \u042d\u0442\u043e\u0442 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e
    \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b
    \u0440\u0435\u0448\u0438\u0442\u044c \u0440\u044f\u0434 \u0441\u043b\u043e\u0436\u043d\u0435\u0439\u0448\u0438\u0445
    \u0437\u0430\u0434\u0430\u0447, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0439
    \u0442\u043e\u0447\u043a\u0435 (\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441
    \u0420. \u0411\u043e\u0442\u0442\u043e\u043c).\n\n\U0001F3C6 2. \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f
    \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u0410\u0442\u044c\u0438\u2013\u0417\u0438\u043d\u0433\u0435\u0440\u0430
    \u043e\u0431 \u0438\u043d\u0434\u0435\u043a\u0441\u0435 \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0410\u0442\u044c\u0438, \u0437\u0430
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0438 \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    (1966), \u0438 \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e
    (2004). \u0412 1963 \u0433\u043e\u0434\u0443 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441
    \u0418\u0437\u0430\u0434\u043e\u0440\u043e\u043c \u0417\u0438\u043d\u0433\u0435\u0440\u043e\u043c
    \u043e\u043d \u0434\u043e\u043a\u0430\u0437\u0430\u043b \u0442\u0435\u043e\u0440\u0435\u043c\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u043c\u043e\u0441\u0442\u043e\u043c
    \u043c\u0435\u0436\u0434\u0443 \u0430\u043d\u0430\u043b\u0438\u0437\u043e\u043c (\u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435\u043c
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439) \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0435\u0439
    (\u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u043e\u0440\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0436\u043d\u043e
    \u0434\u0435\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c). \u0421\u0443\u0442\u044c
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f: \u0414\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e
    \u043a\u043b\u0430\u0441\u0441\u0430 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 (\u044d\u043b\u043b\u0438\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432) \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0447\u0438\u0441\u043b\u043e \u2014 \u0438\u043d\u0434\u0435\u043a\u0441, \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u044c \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c
    \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0438 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u0440\u0435\u0448\u0435\u043d\u0438\u0439
    \u0441\u043e\u043f\u0440\u044f\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0410\u0442\u044c\u0438\u2013\u0417\u0438\u043d\u0433\u0435\u0440\u0430
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u044d\u0442\u043e\u0442
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u043d\u0434\u0435\u043a\u0441
    \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c, \u0437\u043d\u0430\u044f
    \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0437\u0430\u0434\u0430\u043d\u043e
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435. \u042d\u0442\u0430 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e\u0431\u043e\u0431\u0449\u0438\u043b\u0430 \u0441\u0440\u0430\u0437\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432
    XIX \u0432\u0435\u043a\u0430, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0413\u0430\u0443\u0441\u0441\u0430\u2013\u0411\u043e\u043d\u043d\u0435 \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0420\u0438\u043c\u0430\u043d\u0430\u2013\u0420\u043e\u0445\u0430. \u041e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u0445
    \u043a\u0430\u043c\u043d\u0435\u0439 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438, \u043d\u0430\u0439\u0434\u044f
    \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438, \u0442\u0435\u043e\u0440\u0438\u0438
    \u0447\u0438\u0441\u0435\u043b \u0438 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445.\n\n\U0001F30C 3. \u041f\u0438\u043e\u043d\u0435\u0440
    \u0432 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438
    \u042d\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u043f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u044f\u0440\u043a\u043e \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0435\u0433\u043e \u0440\u043e\u043b\u044c \"\u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044f
    \u043c\u043e\u0441\u0442\u043e\u0432\". \u0425\u043e\u0442\u044f \u0432 \u043c\u043e\u043c\u0435\u043d\u0442
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u043e\u0431 \u0438\u043d\u0434\u0435\u043a\u0441\u0435 \u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439,
    \u043a \u043a\u043e\u043d\u0446\u0443 1970-\u0445 \u0433\u043e\u0434\u043e\u0432 \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c,
    \u0447\u0442\u043e \u043e\u043d\u0430 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0432\u0430\u0436\u043d\u0430 \u0434\u043b\u044f \u0444\u0438\u0437\u0438\u043a\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0445
    \u0447\u0430\u0441\u0442\u0438\u0446. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f
    \u0438\u043d\u0441\u0442\u0430\u043d\u0442\u043e\u043d\u043e\u0432: \u0410\u0442\u044c\u044f
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b
    \u043c\u0435\u0442\u043e\u0434\u044b \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 (\u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438,
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u0442\u0432\u0438\u0441\u0442\u043e\u0440\u043e\u0432)
    \u0434\u043b\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438
    \u0438\u043d\u0441\u0442\u0430\u043d\u0442\u043e\u043d\u043e\u0432 \u2014 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438
    \u043d\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u0448\u0435\u043d\u0438\u0439
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u042f\u043d\u0433\u0430-\u041c\u0438\u043b\u043b\u0441\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442
    \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f. \u0414\u043b\u044f
    \u0438\u0445 \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f
    \u0431\u044b\u043b\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u0430
    \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u0430\u044f ADHM-\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f
    (\u0410\u0442\u044c\u044f\u2013\u0414\u0440\u0438\u043d\u0444\u0435\u043b\u044c\u0434\u2013\u0425\u0438\u0442\u0447\u0438\u043d\u2013\u041c\u0430\u043d\u0438\u043d).
    \u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0444\u0438\u0437\u0438\u043a\u043e\u0432:
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441 \u0444\u0438\u0437\u0438\u043a\u0430\u043c\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u042d\u0434\u0432\u0430\u0440\u0434\u0430 \u0412\u0438\u0442\u0442\u0435\u043d\u0430, \u0438
    \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0441\u0442\u0440\u0443\u043d \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u0445 \u0442\u0435\u043e\u0440\u0438\u0439
    \u043f\u043e\u043b\u044f. \u0410\u0442\u044c\u044f \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b,
    \u0447\u0442\u043e \u0444\u0438\u0437\u0438\u043a\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442
    \u0434\u0430\u0436\u0435 \"\u0441\u0430\u043c\u044b\u0435 \u044d\u043a\u0437\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\"
    \u0447\u0430\u0441\u0442\u0438 \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0435\u043c\u044b,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u043b
    \u043d\u0438\u043a\u043e\u043c\u0443 \u043d\u0435 \u043d\u0443\u0436\u043d\u044b\u043c\u0438.
    \u041e\u0431\u0440\u0430\u0442\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435:
    \u042d\u0442\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u043d\u0435 \u0431\u044b\u043b\u043e \u043e\u0434\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043c.
    \u0418\u0434\u0435\u0438 \u0438\u0437 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043e\u0447\u043d\u044b\u0445
    \u0442\u0435\u043e\u0440\u0438\u0439 \u043f\u043e\u043b\u044f, \u043f\u0440\u0438\u0448\u0435\u0434\u0448\u0438\u0435
    \u0438\u0437 \u0444\u0438\u0437\u0438\u043a\u0438, \u043f\u043e\u0437\u0436\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u0443 \u0421\u0430\u0439\u043c\u043e\u043d\u0443
    \u0414\u043e\u043d\u0430\u043b\u044c\u0434\u0441\u043e\u043d\u0443 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u0442\u044c
    \u043f\u0440\u043e\u0440\u044b\u0432 \u0432 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0438
    \u0447\u0435\u0442\u044b\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0439,
    \u0437\u0430 \u0447\u0442\u043e \u0442\u043e\u0442 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0443\u044e \u043f\u0440\u0435\u043c\u0438\u044e.\n\n\U0001F4DA
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0430\u0436\u043d\u044b\u0435 \u0432\u043a\u043b\u0430\u0434\u044b
    \u0422\u0435\u043e\u0440\u0438\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439:
    \u0410\u0442\u044c\u044f \u0432\u043d\u0435\u0441 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0432 \u0442\u0435\u043e\u0440\u0438\u044e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439
    \u2014 \u0440\u0430\u0437\u0434\u0435\u043b \u0430\u043b\u0433\u0435\u0431\u0440\u044b,
    \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0438\u0439 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b.
    \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435: \u041e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f
    \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u043e\u043c \"\u043a\u0430\u043d\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\"
    \u0443\u0447\u0435\u0431\u043d\u0438\u043a\u0430 \u043f\u043e \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b
    \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u043e\u0439
    \u0434\u043b\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432."
  achievementsEn: 
  personalLifeRu: "\u041f\u043e\u043c\u0438\u043c\u043e \u0441\u0432\u043e\u0435\u0439 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439
    \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u044c\u0435\u0440\u044b, \u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u0441\u044d\u0440\u0430 \u041c\u0430\u0439\u043a\u043b\u0430
    \u0410\u0442\u044c\u0438 \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c\u0438 \u0438 \u0434\u043e\u043b\u0433\u0438\u043c\u0438
    \u0441\u0432\u044f\u0437\u044f\u043c\u0438 \u0441 \u0441\u0435\u043c\u044c\u0435\u0439,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u0440\u0430\u0436\u0430\u043b\u0430 \u0435\u0433\u043e
    \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044e\u044e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u0443\u044e
    \u043f\u043e\u0437\u0438\u0446\u0438\u044e.\n\n\U0001F48D \u0421\u0435\u043c\u044c\u044f
    \u0438 \u0431\u0440\u0430\u043a \u0421\u0430\u043c\u043e\u0439 \u0432\u0430\u0436\u043d\u043e\u0439
    \u0447\u0430\u0441\u0442\u044c\u044e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0431\u044b\u043b\u0430 \u0441\u0435\u043c\u044c\u044f.
    30 \u0438\u044e\u043b\u044f 1955 \u0433\u043e\u0434\u0430 \u0410\u0442\u044c\u044f \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041b\u0438\u043b\u0438 \u0411\u0440\u0430\u0443\u043d. \u0418\u0445 \u0431\u0440\u0430\u043a
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0447\u0435\u043d\u044c \u0434\u043e\u043b\u0433\u0438\u043c
    \u0438 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c, \u043f\u0440\u043e\u0434\u043b\u0438\u0432\u0448\u0438\u043c\u0441\u044f
    \u043f\u043e\u0447\u0442\u0438 63 \u0433\u043e\u0434\u0430, \u0432\u043f\u043b\u043e\u0442\u044c
    \u0434\u043e \u043a\u043e\u043d\u0447\u0438\u043d\u044b \u041b\u0438\u043b\u0438 \u0432
    \u043c\u0430\u0440\u0442\u0435 2018 \u0433\u043e\u0434\u0430. \u0423 \u0441\u0443\u043f\u0440\u0443\u0433\u043e\u0432
    \u0440\u043e\u0434\u0438\u043b\u043e\u0441\u044c \u0442\u0440\u043e\u0435 \u0441\u044b\u043d\u043e\u0432\u0435\u0439.
    \u041a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0438\u0445 \u043f\u043e\u0441\u0442\u0438\u0433\u043b\u0430
    \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0443\u0442\u0440\u0430\u0442\u0430: \u043e\u0434\u0438\u043d
    \u0438\u0437 \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u043f\u043e\u0433\u0438\u0431 \u0432
    2002 \u0433\u043e\u0434\u0443 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0435\u0448\u0435\u0433\u043e
    \u043f\u043e\u0445\u043e\u0434\u0430 \u0432 \u041f\u0438\u0440\u0435\u043d\u0435\u044f\u0445.\n\n\U0001F3A8
    \u0421\u0435\u043c\u0435\u0439\u043d\u044b\u0435 \u043a\u043e\u0440\u043d\u0438 \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440
    \u041b\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0410\u0442\u044c\u0438 \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c
    \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0435 \u0438 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c\u0443
    \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u043e\u043c\u0443 \u0431\u044d\u043a\u0433\u0440\u0430\u0443\u043d\u0434\u0443.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u042d\u0434\u0443\u0430\u0440\u0434 \u0410\u0442\u044c\u044f,
    \u0431\u044b\u043b \u043b\u0438\u0432\u0430\u043d\u0441\u043a\u0438\u043c \u043f\u0440\u0430\u0432\u043e\u0441\u043b\u0430\u0432\u043d\u044b\u043c
    \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043d\u0438\u043d\u043e\u043c \u0438 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u0435\u043c,
    \u0430 \u043c\u0430\u0442\u044c, \u0414\u0436\u0438\u043d \u041b\u0435\u0432\u0435\u043d\u0441,
    \u2014 \u0448\u043e\u0442\u043b\u0430\u043d\u0434\u043a\u043e\u0439 \u0438 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u0446\u0435\u0439.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0447\u0442\u043e \u0435\u0433\u043e
    \u0431\u0440\u0430\u0442, \u041f\u0430\u0442\u0440\u0438\u043a \u0410\u0442\u044c\u044f,
    \u0441\u0442\u0430\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u044e\u0440\u0438\u0441\u0442\u043e\u043c,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u0438
    \u0432\u0441\u0435\u0439 \u0441\u0435\u043c\u044c\u0438. \u042d\u0442\u043e \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0435
    \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u043e
    \u043d\u0430 \u0435\u0433\u043e \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446, \u043a\u0430\u043a \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b
    \u0441\u0430\u043c \u0410\u0442\u044c\u044f, \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c
    \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043b \u043c\u0435\u0436\u0434\u0443
    \u0436\u0435\u043b\u0430\u043d\u0438\u0435\u043c \u0441\u0442\u0430\u0442\u044c \"\u0430\u043d\u0433\u043b\u0438\u0447\u0430\u043d\u0438\u043d\u043e\u043c\"
    \u0438 \u0441\u0438\u043c\u043f\u0430\u0442\u0438\u044f\u043c\u0438 \u043a \u0430\u0440\u0430\u0431\u0441\u043a\u043e\u043c\u0443
    \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c\u0443, \u0447\u0442\u043e,
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043d\u0430\u0443\u0447\u0438\u043b\u043e
    \u041c\u0430\u0439\u043a\u043b\u0430 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0430
    \u043c\u0438\u0440 \u0441 \u0440\u0430\u0437\u043d\u044b\u0445 \u0442\u043e\u0447\u0435\u043a
    \u0437\u0440\u0435\u043d\u0438\u044f.\n\n\U0001F33F \u0425\u043e\u0431\u0431\u0438 \u0438
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0417\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0410\u0442\u044c\u044f \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0441\u0432\u043e\u0435\u0439 \u043b\u044e\u0431\u043e\u0432\u044c\u044e
    \u043a \u043f\u0440\u0438\u0440\u043e\u0434\u0435. \u041e\u043d \u043b\u044e\u0431\u0438\u043b
    \u0433\u0443\u043b\u044f\u0442\u044c \u043f\u0435\u0448\u043a\u043e\u043c \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u0432 \u0441\u0430\u0434\u0443. \u0415\u0433\u043e \u0436\u0435\u043d\u0430 \u0448\u0443\u0442\u043b\u0438\u0432\u043e
    \u0436\u0430\u043b\u043e\u0432\u0430\u043b\u0430\u0441\u044c, \u0447\u0442\u043e \u0432\u043e
    \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u043e\u0433\u0443\u043b\u043e\u043a \u043e\u043d
    \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442
    \u0434\u0443\u043c\u0430\u0442\u044c \u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435,
    \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0435\u0433\u043e
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0432 \u043d\u0430\u0443\u043a\u0443 \u0434\u0430\u0436\u0435 \u0432 \u043c\u0438\u043d\u0443\u0442\u044b
    \u043e\u0442\u0434\u044b\u0445\u0430.\n\n\U0001F5E3\ufe0f \u041e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u0430\u044f \u043f\u043e\u0437\u0438\u0446\u0438\u044f
    \u0410\u0442\u044c\u044f \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \"\u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043d\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c\".
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u043b
    \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u0443\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e
    \u043f\u043e \u0432\u0430\u0436\u043d\u044b\u043c \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c.
    \u0411\u0443\u0434\u0443\u0447\u0438 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (1990\u20131995), \u043e\u043d \u043d\u0435
    \u0431\u043e\u044f\u043b\u0441\u044f \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0432\u0430\u0442\u044c
    \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0437\u0430
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435
    \u043d\u0430\u0443\u043a\u0438. \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0431\u044b\u043b
    \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u043f\u0430\u0446\u0438\u0444\u0438\u0441\u0442\u043e\u043c.
    \u042f\u0432\u043b\u044f\u044f\u0441\u044c \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c
    \u041f\u0430\u0433\u0443\u043e\u0448\u0441\u043a\u0438\u0445 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0439
    \u043f\u043e \u043d\u0430\u0443\u043a\u0435 \u0438 \u043c\u0438\u0440\u043e\u0432\u044b\u043c
    \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c, \u043e\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u0437\u0430 \u044f\u0434\u0435\u0440\u043d\u043e\u0435 \u0440\u0430\u0437\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0435
    \u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u044f\u0434\u0435\u0440\u043d\u0443\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u0438
    \"\u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e\u0439,
    \u043f\u043e\u043b\u043d\u043e\u0439 \u0442\u0440\u0430\u0442\u043e\u0439 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432\".
    \u0415\u0433\u043e \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0438\u043d\u043e\u0433\u0434\u0430 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b\u0430
    \u043a \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430\u043c, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0432 1997 \u0433\u043e\u0434\u0443 \u043e\u043d \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e
    \u0443\u0448\u0435\u043b \u0441 \u043f\u043e\u0441\u0442\u0430 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430
    \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0437\u043d\u043e\u0433\u043b\u0430\u0441\u0438\u0439
    \u0441 \u0441\u0430\u0434\u043e\u0432\u044b\u043c \u043a\u043e\u043c\u0438\u0442\u0435\u0442\u043e\u043c
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430 \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443
    \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u043a\u0438 \u0441\u0430\u0434\u0430 \u0434\u043b\u044f
    \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439."
  personalLifeEn: 
  shortBioRu: "\u0421\u044d\u0440 \u041c\u0430\u0439\u043a\u043b \u0424\u0440\u044d\u043d\u0441\u0438\u0441
    \u0410\u0442\u044c\u044f (22 \u0430\u043f\u0440\u0435\u043b\u044f 1929 \u2014 11 \u044f\u043d\u0432\u0430\u0440\u044f
    2019) \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432 XX \u0432\u0435\u043a\u0430,
    \u0447\u044c\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0445\u0432\u0430\u0442\u0438\u043b\u0438
    \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044e, \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e,
    \u0430\u043d\u0430\u043b\u0438\u0437 \u0438 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u0438\u0437\u0438\u043a\u0443. \u0415\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \"\u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u0435\u043c \u043c\u043e\u0441\u0442\u043e\u0432\"
    \u043c\u0435\u0436\u0434\u0443 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u043c\u0438
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u043c\u0435\u0436\u0434\u0443 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0438 \u0444\u0438\u0437\u0438\u043a\u043e\u0439.\n\n\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466
    \u0420\u0430\u043d\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u041c\u0430\u0439\u043a\u043b \u0410\u0442\u044c\u044f \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    \u0432 \u041b\u043e\u043d\u0434\u043e\u043d\u0435, \u0432 \u0441\u0435\u043c\u044c\u0435
    \u0441 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u043c
    \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0435\u043d\u0438\u0435\u043c. \u0415\u0433\u043e
    \u043e\u0442\u0435\u0446, \u042d\u0434\u0443\u0430\u0440\u0434 \u0410\u0442\u044c\u044f,
    \u0431\u044b\u043b \u043b\u0438\u0432\u0430\u043d\u0446\u0435\u043c \u043f\u0440\u0430\u0432\u043e\u0441\u043b\u0430\u0432\u043d\u043e\u0433\u043e
    \u0432\u0435\u0440\u043e\u0438\u0441\u043f\u043e\u0432\u0435\u0434\u0430\u043d\u0438\u044f
    \u0438 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u0435\u043c, \u0430 \u043c\u0430\u0442\u044c,
    \u0414\u0436\u0438\u043d \u041b\u0435\u0432\u0435\u043d\u0441, \u2014 \u0448\u043e\u0442\u043b\u0430\u043d\u0434\u043a\u043e\u0439.
    \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0448\u043b\u043e \u0432\u0434\u0430\u043b\u0438
    \u043e\u0442 \u0411\u0440\u0438\u0442\u0430\u043d\u0438\u0438: \u043e\u043d \u043f\u043e\u0441\u0435\u0449\u0430\u043b
    \u0448\u043a\u043e\u043b\u0443 \u0432 \u0425\u0430\u0440\u0442\u0443\u043c\u0435 (\u0421\u0443\u0434\u0430\u043d),
    \u0433\u0434\u0435 \u0435\u0433\u043e \u043e\u0442\u0435\u0446 \u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043d\u0430 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0441\u043b\u0443\u0436\u0431\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u044b\u0439
    \u0412\u0438\u043a\u0442\u043e\u0440\u0438\u044f-\u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u0432 \u041a\u0430\u0438\u0440\u0435. \u042d\u0442\u043e\u0442 \u043c\u0443\u043b\u044c\u0442\u0438\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u0439
    \u043e\u043f\u044b\u0442, \u0432\u043a\u043b\u044e\u0447\u0430\u0432\u0448\u0438\u0439 \u0436\u0438\u0437\u043d\u044c
    \u043d\u0430 \u0411\u043b\u0438\u0436\u043d\u0435\u043c \u0412\u043e\u0441\u0442\u043e\u043a\u0435,
    \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b
    \u0435\u0433\u043e \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0432\u0437\u0433\u043b\u044f\u0434
    \u043d\u0430 \u043c\u0438\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0436\u0435
    \u043f\u0440\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0438 \u0432 \u0435\u0433\u043e
    \u043d\u0430\u0443\u0447\u043d\u044b\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u0445.\n\n\U0001F393
    \u041f\u0443\u0442\u044c \u0432 \u043d\u0430\u0443\u043a\u0435: \u043e\u0442 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0430
    \u0434\u043e \u043c\u0438\u0440\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f
    \u0412 1947 \u0433\u043e\u0434\u0443 \u0410\u0442\u044c\u044f \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0415\u0433\u043e \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0431\u044b\u043b\u0430 \u0441\u0432\u044f\u0437\u0430\u043d\u0430
    \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043c\u0438 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430\u043c\u0438
    \u043c\u0438\u0440\u0430: \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436 (1955\u20131961):
    \u0417\u0430\u0449\u0438\u0442\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e
    \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044e \u0432 1955 \u0433\u043e\u0434\u0443
    \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0425\u043e\u0434\u0436\u0430. \u041e\u043a\u0441\u0444\u043e\u0440\u0434
    (1961\u20131969): \u0417\u0430\u043d\u0438\u043c\u0430\u043b \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0443\u044e
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u0421\u0430\u0432\u0438\u043b\u0438\u0430\u043d\u043e\u0432\u0441\u043a\u043e\u0433\u043e
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438.
    \u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0445
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0432 \u041f\u0440\u0438\u043d\u0441\u0442\u043e\u043d\u0435,
    \u0421\u0428\u0410: \u0420\u0430\u0431\u043e\u0442\u0430\u043b \u0442\u0430\u043c \u0432
    1955\u20131956 \u0438 1969\u20131972 \u0433\u043e\u0434\u0430\u0445, \u0447\u0442\u043e
    \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e \u0435\u0433\u043e
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438 \u0432 \u043c\u0438\u0440\u043e\u0432\u043e\u0435
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e.
    \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0432 \u041a\u0435\u043c\u0431\u0440\u0438\u0434\u0436
    (1990\u20131997): \u0421\u0442\u0430\u043b \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u043e\u043c
    \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430
    \u0438 \u043f\u0435\u0440\u0432\u044b\u043c \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u043c
    \u041d\u044c\u044e\u0442\u043e\u043d\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a.
    \u042d\u0434\u0438\u043d\u0431\u0443\u0440\u0433: \u0421 1997 \u0433\u043e\u0434\u0430 \u0438
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438 \u0431\u044b\u043b
    \u043f\u043e\u0447\u0435\u0442\u043d\u044b\u043c \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c
    \u042d\u0434\u0438\u043d\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.
    \u0410\u0442\u044c\u044f \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d \u0447\u043b\u0435\u043d\u043e\u043c
    \u041b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0432 1962 \u0433\u043e\u0434\u0443, \u0430
    \u0441 1990 \u043f\u043e 1995 \u0433\u043e\u0434 \u044f\u0432\u043b\u044f\u043b\u0441\u044f
    \u0435\u0433\u043e \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c. \u0417\u0430
    \u0441\u0432\u043e\u044e \u043a\u0430\u0440\u044c\u0435\u0440\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u0447\u0435\u0441\u0442\u0435\u0439,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0440\u044b\u0446\u0430\u0440\u0441\u0442\u0432\u043e
    \u0432 1983 \u0433\u043e\u0434\u0443 \u0438 \u041e\u0440\u0434\u0435\u043d \u0417\u0430\u0441\u043b\u0443\u0433
    \u0432 1992 \u0433\u043e\u0434\u0443.\n\n\U0001F3C6 \u0413\u043b\u0430\u0432\u043d\u044b\u0435
    \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0410\u0442\u044c\u044f \u0431\u044b\u043b
    \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0434\u0432\u0443\u0445 \u0432\u044b\u0441\u043e\u0447\u0430\u0439\u0448\u0438\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435:
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u0430\u044f \u043c\u0435\u0434\u0430\u043b\u044c
    (1966) \u2014 \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    K-\u0442\u0435\u043e\u0440\u0438\u0438 \u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0435
    \u043e\u0431 \u0438\u043d\u0434\u0435\u043a\u0441\u0435. \u0410\u0431\u0435\u043b\u0435\u0432\u0441\u043a\u0430\u044f
    \u043f\u0440\u0435\u043c\u0438\u044f (2004, \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e
    \u0441 \u0418\u0437\u0430\u0434\u043e\u0440\u043e\u043c \u0417\u0438\u043d\u0433\u0435\u0440\u043e\u043c)
    \u2014 \u0437\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b \u043e\u0431 \u0438\u043d\u0434\u0435\u043a\u0441\u0435.
    \u0421\u0440\u0435\u0434\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0445
    \u043d\u0430\u0433\u0440\u0430\u0434 \u2014 \u041c\u0435\u0434\u0430\u043b\u044c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (1968) \u0438 \u041c\u0435\u0434\u0430\u043b\u044c
    \u041a\u043e\u043f\u043b\u0438 (1988).\n\n\U0001F9E0 \u0412\u043a\u043b\u0430\u0434 \u0432
    \u043d\u0430\u0443\u043a\u0443: \"\u0421\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c
    \u043c\u043e\u0441\u0442\u043e\u0432\" \u041c\u0430\u0439\u043a\u043b \u0410\u0442\u044c\u044f
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0448\u0430\u0442\u0435\u043b\u0435\u043c
    \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447, \u0430 \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0435\u043c
    \u043d\u043e\u0432\u044b\u0445 \u0442\u0435\u043e\u0440\u0438\u0439 \u0438 \u0441\u0432\u044f\u0437\u0435\u0439:
    1. \u0422\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    K-\u0442\u0435\u043e\u0440\u0438\u044f: \u0412 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u0441 \u0424\u0440\u0438\u0434\u0440\u0438\u0445\u043e\u043c \u0425\u0438\u0440\u0446\u0435\u0431\u0440\u0443\u0445\u043e\u043c
    \u043e\u043d \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b K-\u0442\u0435\u043e\u0440\u0438\u044e
    \u2014 \u043c\u043e\u0449\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442
    \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432 \u0447\u0435\u0440\u0435\u0437
    \u0438\u0445 \"\u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0435 \u0440\u0430\u0441\u0441\u043b\u043e\u0435\u043d\u0438\u044f\"
    (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043b\u0435\u043d\u0442\u0443 \u041c\u0451\u0431\u0438\u0443\u0441\u0430).
    2. \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0410\u0442\u044c\u0438\u2013\u0417\u0438\u043d\u0433\u0435\u0440\u0430
    \u043e\u0431 \u0438\u043d\u0434\u0435\u043a\u0441\u0435: \u042d\u0442\u043e \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u044b.
    \u0422\u0435\u043e\u0440\u0435\u043c\u0430 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442
    \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443
    \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u0438 \u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043e\u0439 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u044d\u0442\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0437\u0430\u0434\u0430\u043d\u044b. \u041e\u043d\u0430 \u043e\u0431\u043e\u0431\u0449\u0430\u0435\u0442
    \u043c\u043d\u043e\u0433\u0438\u0435 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b, \u0442\u0430\u043a\u0438\u0435
    \u043a\u0430\u043a \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u0413\u0430\u0443\u0441\u0441\u0430\u2013\u0411\u043e\u043d\u043d\u0435,
    \u0438 \u043d\u0430\u0448\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435.
    3. \u0421\u0432\u044f\u0437\u044c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0438: \u0412 1970-\u0445 \u0433\u043e\u0434\u0430\u0445
    \u0410\u0442\u044c\u044f \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u043e\u0441\u043e\u0437\u043d\u0430\u043b \u0432\u0430\u0436\u043d\u043e\u0441\u0442\u044c
    \u0438\u0434\u0435\u0439 \u0438\u0437 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043e\u0447\u043d\u044b\u0445
    \u0442\u0435\u043e\u0440\u0438\u0439 \u043f\u043e\u043b\u044f (\u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u042f\u043d\u0433\u0430\u2013\u041c\u0438\u043b\u043b\u0441\u0430) \u0434\u043b\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441 \u0444\u0438\u0437\u0438\u043a\u0430\u043c\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f
    \u042d\u0434\u0432\u0430\u0440\u0434\u0430 \u0412\u0438\u0442\u0442\u0435\u043d\u0430, \u0438
    \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e
    \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439
    \u043a\u0430\u043a \"\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430\", \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u044f,
    \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0438\u043d\u0441\u0442\u0430\u043d\u0442\u043e\u043d\u044b
    \u0438 \u043c\u043e\u043d\u043e\u043f\u043e\u043b\u0438.\n\n\U0001F4DC \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0433\u043e\u0434\u044b \u0438 \u0441\u043a\u0430\u043d\u0434\u0430\u043b \u0432\u043e\u043a\u0440\u0443\u0433
    \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b \u0420\u0438\u043c\u0430\u043d\u0430 \u0412
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0441\u0432\u043e\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438 \u0410\u0442\u044c\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b
    \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0432 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438. \u0412
    \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u0435 2018 \u0433\u043e\u0434\u0430 \u043d\u0430
    \u0413\u0435\u0439\u0434\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0441\u043a\u043e\u043c
    \u0444\u043e\u0440\u0443\u043c\u0435 \u043b\u0430\u0443\u0440\u0435\u0430\u0442\u043e\u0432
    \u0424\u0438\u043b\u0434\u0441\u043e\u0432\u0441\u043a\u043e\u0439 \u043f\u0440\u0435\u043c\u0438\u0438
    \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u0432\u043e\u0435
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0420\u0438\u043c\u0430\u043d\u0430 \u2014 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437
    \u0441\u0430\u043c\u044b\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u043d\u0435\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0445
    \"\u0437\u0430\u0434\u0430\u0447 \u0442\u044b\u0441\u044f\u0447\u0435\u043b\u0435\u0442\u0438\u044f\".
    \u041a \u0435\u0433\u043e \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044e \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435
    \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u043e\u0442\u043d\u0435\u0441\u043b\u043e\u0441\u044c
    \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u0441\u043a\u0435\u043f\u0441\u0438\u0441\u043e\u043c,
    \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043e\u043d\u043e \u0431\u044b\u043b\u043e
    \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u043a\u0440\u0430\u0442\u043a\u0438\u043c
    \u0438 \u043d\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u043e \u0441\u0442\u0440\u043e\u0433\u0438\u0445
    \u0432\u044b\u043a\u043b\u0430\u0434\u043e\u043a, \u0430 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u0410\u0442\u044c\u0438 \u0432 \u043f\u0440\u0435\u043a\u043b\u043e\u043d\u043d\u043e\u043c
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435, \u043f\u043e \u043c\u043d\u0435\u043d\u0438\u044e
    \u043a\u043e\u043b\u043b\u0435\u0433, \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438
    \u043d\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435
    \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u0438 \u0435\u0433\u043e \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438.
    \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0441\u0430\u043c \u0410\u0442\u044c\u044f
    \u043d\u0430\u0434\u0435\u044f\u043b\u0441\u044f \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u0442\u044c
    \u043c\u043e\u043b\u043e\u0434\u044b\u0445 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0432.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u0438 \u0441\u043f\u043e\u0440\u044b,
    \u041c\u0430\u0439\u043a\u043b \u0410\u0442\u044c\u044f \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f
    \u0444\u0438\u0433\u0443\u0440\u043e\u0439, \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0435\u0439
    \u043b\u0430\u043d\u0434\u0448\u0430\u0444\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435
    \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u043d\u043e \u0438 \u0441\u0430\u043c \u043f\u043e\u0434\u0445\u043e\u0434,
    \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0449\u0438\u0439
    \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0438\u0434\u0435\u0439."
  shortBioEn: 
  interestingFactsRu: "\u041f\u043e\u043c\u0438\u043c\u043e \u0441\u0442\u0440\u043e\u0433\u0438\u0445 \u0442\u0435\u043e\u0440\u0435\u043c
    \u0438 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0432\u0430\u043d\u0438\u0439,
    \u0436\u0438\u0437\u043d\u044c \u041c\u0430\u0439\u043a\u043b\u0430 \u0410\u0442\u044c\u0438
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u044f\u0440\u043a\u0438\u0445 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0445
    \u0447\u0435\u0440\u0442, \u043a\u0443\u0440\u044c\u0435\u0437\u043e\u0432 \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439.
    \u0412\u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445
    \u0444\u0430\u043a\u0442\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u0435\u0433\u043e \u043d\u0435\u043e\u0440\u0434\u0438\u043d\u0430\u0440\u043d\u0443\u044e
    \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c.\n\n\U0001F9E0 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \"\u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0435\" \u0432\u043e \u0441\u043d\u0435 \u0410\u0442\u044c\u044f
    \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b, \u0447\u0442\u043e \u043e\u0434\u043d\u0430\u0436\u0434\u044b
    \u0435\u043c\u0443 \u043f\u0440\u0438\u0441\u043d\u0438\u043b\u0441\u044f \u0441\u043b\u043e\u0436\u043d\u044b\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u043e\u043f\u0440\u043e\u0441,
    \u0438 \u043e\u043d \u0440\u0435\u0448\u0438\u043b \u0435\u0433\u043e \u0432\u043e \u0441\u043d\u0435.
    \u041e\u0434\u043d\u0430\u043a\u043e, \u043f\u0440\u043e\u0441\u043d\u0443\u0432\u0448\u0438\u0441\u044c,
    \u043e\u043d \u043d\u0435 \u043c\u043e\u0433 \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u0442\u044c
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435. \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e,
    \u043a\u0430\u043a \u043e\u043d \u0441\u0430\u043c \u0448\u0443\u0442\u0438\u043b, \u0435\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430 \u0418\u0437\u0430\u0434\u043e\u0440 \u0417\u0438\u043d\u0433\u0435\u0440
    \u0442\u043e\u0436\u0435 \u0432\u0438\u0434\u0435\u043b \u0442\u043e\u0442 \u0436\u0435
    \u0441\u043e\u043d \u0438 \u043f\u043e\u043c\u043d\u0438\u043b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e.
    \u042d\u0442\u043e\u0442 \u0441\u043b\u0443\u0447\u0430\u0439 \u0441\u0442\u0430\u043b \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u0440\u0443\u0433\u0430\u0445, \u0438\u043b\u043b\u044e\u0441\u0442\u0440\u0438\u0440\u0443\u044f
    \u0438\u0445 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0442\u0435\u0441\u043d\u043e\u0435
    \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e.\n\n\U0001F3A8
    \u0421\u0435\u043c\u0435\u0439\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u0439 \u043a\u043e\u0434 \u0415\u0433\u043e
    \u043c\u0430\u0442\u044c \u0431\u044b\u043b\u0430 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u0446\u0435\u0439,
    \u0447\u0442\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u0440\u0438\u0432\u0438\u043b\u043e
    \u0435\u043c\u0443 \u044d\u0441\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.
    \u041e\u043d \u0447\u0430\u0441\u0442\u043e \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0441 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044f, \u0447\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0432 \u043d\u0435\u0439 \u2014 \u043a\u0440\u0430\u0441\u043e\u0442\u0430 \u0438 \u0438\u0437\u044f\u0449\u0435\u0441\u0442\u0432\u043e.
    \u0415\u0433\u043e \u043e\u0442\u0435\u0446 \u0431\u044b\u043b \u043b\u0438\u0432\u0430\u043d\u0441\u043a\u0438\u043c
    \u043f\u0440\u0430\u0432\u043e\u0441\u043b\u0430\u0432\u043d\u044b\u043c \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u0435\u043c,
    \u0438, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0410\u0442\u044c\u0438, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f
    \u043e\u0442\u0446\u0443 \u043e\u043d \u043d\u0430\u0443\u0447\u0438\u043b\u0441\u044f \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u043d\u0430 \u043c\u0438\u0440 \u0441 \u0440\u0430\u0437\u043d\u044b\u0445 \u0442\u043e\u0447\u0435\u043a
    \u0437\u0440\u0435\u043d\u0438\u044f, \u0447\u0442\u043e \u043f\u043e\u043c\u043e\u0433\u043b\u043e
    \u0435\u043c\u0443 \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u0442\u044c, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0431\u044b, \u043d\u0435\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043c\u044b\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438.\n\n\U0001F30D \u0412\u0438\u0434\u0435\u043d\u0438\u0435
    \u043d\u0430\u0443\u043a\u0438 \u043a\u0430\u043a \u0435\u0434\u0438\u043d\u043e\u0433\u043e
    \u0446\u0435\u043b\u043e\u0433\u043e \u0410\u0442\u044c\u044f \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d,
    \u0447\u0442\u043e \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043c\u0435\u0436\u0434\u0443
    \u0447\u0438\u0441\u0442\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439
    \u0438 \u0444\u0438\u0437\u0438\u043a\u043e\u0439 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b.
    \u041e\u043d \u0441 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u044c\u044e \u0433\u043e\u0432\u043e\u0440\u0438\u043b,
    \u0447\u0442\u043e \u0435\u0433\u043e \u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u043e\u0431
    \u0438\u043d\u0434\u0435\u043a\u0441\u0435 \u043d\u0430\u0448\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435
    \u0432 \u0442\u0430\u043a\u0438\u0445 \"\u044d\u043a\u0437\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445\"
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445, \u043a\u0430\u043a \u0442\u0435\u043e\u0440\u0438\u044f
    \u0441\u0442\u0440\u0443\u043d, \u043e \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d
    \u0434\u0430\u0436\u0435 \u043d\u0435 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u043b
    \u0432 \u043c\u043e\u043c\u0435\u043d\u0442 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f.
    \u041e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u0441\u0435\u0431\u044f \"\u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u0435\u043c
    \u043c\u043e\u0441\u0442\u043e\u0432\" \u0438 \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e
    \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f
    \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u044f\u0442 \u0438\u043c\u0435\u043d\u043d\u043e
    \u043d\u0430 \u0441\u0442\u044b\u043a\u0435 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d.\n\n\U0001F331
    \u042f\u0440\u044b\u0439 \u0437\u0430\u0449\u0438\u0442\u043d\u0438\u043a \u043f\u0440\u0438\u0440\u043e\u0434\u044b
    \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u044f\u0434\u0435\u0440\u043d\u043e\u0433\u043e
    \u043e\u0440\u0443\u0436\u0438\u044f \u0415\u0433\u043e \u043b\u044e\u0431\u043e\u0432\u044c
    \u043a \u0441\u0430\u0434\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0443 \u0431\u044b\u043b\u0430
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0431\u0431\u0438. \u0412
    1997 \u0433\u043e\u0434\u0443 \u043e\u043d \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e
    \u0443\u0448\u0435\u043b \u0441 \u043f\u043e\u0441\u0442\u0430 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430
    \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430
    \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043f\u043e\u0441\u0441\u043e\u0440\u0438\u043b\u0441\u044f
    \u0441 \u0441\u0430\u0434\u043e\u0432\u044b\u043c \u043a\u043e\u043c\u0438\u0442\u0435\u0442\u043e\u043c
    \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430 \u2014 \u043e\u043d\u0438 \u0445\u043e\u0442\u0435\u043b\u0438
    \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u043a\u0443
    \u0441\u0430\u0434\u0430 \u0434\u043b\u044f \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439,
    \u0438 \u043e\u043d \u0441\u0447\u0435\u043b \u044d\u0442\u043e \u043d\u0435\u043f\u0440\u0438\u0435\u043c\u043b\u0435\u043c\u044b\u043c.
    \u041e\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u043b \u044f\u0434\u0435\u0440\u043d\u0443\u044e
    \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u0438
    \"\u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u043e\u0439
    \u0438 \u043f\u0443\u0441\u0442\u043e\u0439 \u0442\u0440\u0430\u0442\u043e\u0439 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432\"
    \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b
    \u0437\u0430 \u0440\u0430\u0437\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u0435.\n\n\U0001F9D0
    \u0421\u043a\u0435\u043f\u0442\u0438\u0446\u0438\u0437\u043c \u043a \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u0436\u0435 \u0438\u0434\u0435\u044f\u043c (\u0438\u0440\u043e\u043d\u0438\u044f \u0441\u0443\u0434\u044c\u0431\u044b)
    \u0412 1960-\u0445, \u043a\u043e\u0433\u0434\u0430 \u0410\u0442\u044c\u044f \u0438 \u0417\u0438\u043d\u0433\u0435\u0440
    \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u043d\u0430\u0434
    \u0441\u0432\u043e\u0435\u0439 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u043e\u0439
    \u0442\u0435\u043e\u0440\u0435\u043c\u043e\u0439, \u043e\u043d\u0438 \u043f\u043e\u0434\u0430\u043b\u0438
    \u0437\u0430\u044f\u0432\u043a\u0443 \u043d\u0430 \u0433\u0440\u0430\u043d\u0442 \u0432
    \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u0444\u043e\u043d\u0434 \u0421\u0428\u0410. \u0417\u0430\u044f\u0432\u043a\u0443 \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b\u0438,
    \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u0432 \u0438\u0445 \u0438\u0434\u0435\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u044b\u043c\u0438 \u0438 \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u044b\u043c\u0438.
    \u041f\u043e\u0437\u0436\u0435 \u044d\u0442\u0430 \u0442\u0435\u043e\u0440\u0435\u043c\u0430
    \u0441\u0442\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f
    \u0442\u044b\u0441\u044f\u0447 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445
    \u0440\u0430\u0431\u043e\u0442 \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u0438 \u0444\u0438\u0437\u0438\u043a\u0435, \u0430 \u0441\u0430\u043c \u0410\u0442\u044c\u044f
    \u043b\u044e\u0431\u0438\u043b \u0441 \u0438\u0440\u043e\u043d\u0438\u0435\u0439 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c
    \u044d\u0442\u043e\u0442 \u043e\u0442\u043a\u0430\u0437.\n\n\U0001F399\ufe0f \"\u0414\u0435\u0442\u0441\u043a\u043e\u0435\"
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0420\u0438\u043c\u0430\u043d\u0430 \u041d\u0430 \u0441\u043a\u043b\u043e\u043d\u0435 \u043b\u0435\u0442,
    \u0432 2018 \u0433\u043e\u0434\u0443, 89-\u043b\u0435\u0442\u043d\u0438\u0439 \u0410\u0442\u044c\u044f
    \u043f\u0440\u0438\u0435\u0445\u0430\u043b \u043d\u0430 \u0413\u0435\u0439\u0434\u0435\u043b\u044c\u0431\u0435\u0440\u0433\u0441\u043a\u0438\u0439
    \u0444\u043e\u0440\u0443\u043c \u0441 \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c
    \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u2014 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u044b
    \u0420\u0438\u043c\u0430\u043d\u0430. \u0415\u0433\u043e \u043b\u0435\u043a\u0446\u0438\u044f
    \u0434\u043b\u0438\u043b\u0430\u0441\u044c \u0432\u0441\u0435\u0433\u043e \u043e\u043a\u043e\u043b\u043e
    5 \u043c\u0438\u043d\u0443\u0442, \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043f\u043e\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u0435
    \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u044b, \u0432\u044b\u0432\u043e\u0434\u044f
    \u043d\u0430 \u044d\u043a\u0440\u0430\u043d \"\u0434\u0435\u0442\u0441\u043a\u0438\u0435\"
    \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0438. \u0425\u043e\u0442\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433 \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043d\u0435\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u043c, \u0441\u0430\u043c
    \u0410\u0442\u044c\u044f \u0441 \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0437\u043c\u043e\u043c
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u0430\u044f
    \u0435\u0433\u043e \u0446\u0435\u043b\u044c \u2014 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0438\u0442\u044c
    \u043c\u043e\u043b\u043e\u0434\u043e\u0435 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0435
    \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u0434\u0430\u0436\u0435
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043d\u0435 \u0441\u0442\u043e\u0438\u0442 \u0431\u043e\u044f\u0442\u044c\u0441\u044f.\n\n\U0001F4DA
    \u0421\u043a\u0440\u043e\u043c\u043d\u043e\u0441\u0442\u044c \u0432 \u0431\u044b\u0442\u0443
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043c\u0438\u0440\u043e\u0432\u0443\u044e
    \u0441\u043b\u0430\u0432\u0443, \u0440\u044b\u0446\u0430\u0440\u0441\u043a\u0438\u0439 \u0442\u0438\u0442\u0443\u043b
    \u0438 \u043c\u0435\u0441\u0442\u043e \u0432 \u044d\u043b\u0438\u0442\u0435 \u043d\u0430\u0443\u043a\u0438,
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0438
    \u0435\u0433\u043e \u043a\u0430\u043a \u043a\u0440\u0430\u0439\u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0433\u043e
    \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.
    \u041e\u043d \u043c\u043e\u0433 \u0447\u0430\u0441\u0430\u043c\u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044c
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0441 \u0430\u0441\u043f\u0438\u0440\u0430\u043d\u0442\u043e\u043c
    \u0432 \u043a\u043e\u0440\u0438\u0434\u043e\u0440\u0435 \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430
    \u043d\u0435 \u043a\u0438\u0447\u0438\u043b\u0441\u044f \u0441\u0432\u043e\u0438\u043c\u0438
    \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u043c\u0438."
