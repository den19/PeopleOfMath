    \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0435\u0442\u044c\u043c\u0438,
    \u0430 \u0442\u0430\u043a\u0436\u0435 \u0435\u0433\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439
    \u043e\u043f\u044b\u0442 \u0442\u044e\u0440\u0435\u043c\u043d\u043e\u0433\u043e \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f.\n\n\U0001F9EC
    \u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
