  achievementsRu: "\u0414\u0436\u0435\u0440\u043e\u043b\u0430\u043c\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439
    \u0441\u043b\u0435\u0434 \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445
    \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u0445 \u0437\u043d\u0430\u043d\u0438\u044f, \u043e\u0442
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0434\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b
    \u0438 \u043d\u0430\u0442\u0443\u0440\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438.
    \u0415\u0433\u043e \u0432\u043a\u043b\u0430\u0434 \u2014 \u044d\u0442\u043e \u043d\u0435
    \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f, \u0430 \u0446\u0435\u043b\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432,
    \u0432\u043e \u043c\u043d\u043e\u0433\u043e\u043c \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432\u0448\u0430\u044f
    \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.\n\n\U0001F4D0 \u00abArs Magna\u00bb
    \u0438 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0435 \u0412 1545 \u0433\u043e\u0434\u0443 \u0443\u0432\u0438\u0434\u0435\u043b
    \u0441\u0432\u0435\u0442 \u0442\u0440\u0443\u0434, \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u0432\u043f\u0438\u0441\u0430\u0432\u0448\u0438\u0439 \u0438\u043c\u044f \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u2014 \u00abArs Magna\u00bb (\u00ab\u0412\u0435\u043b\u0438\u043a\u043e\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb).
    \u042d\u0442\u0430 \u043a\u043d\u0438\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439
    \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u0435\u0439 \u0432 \u0430\u043b\u0433\u0435\u0431\u0440\u0435,
    \u0441\u043e\u0431\u0440\u0430\u0432 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0432
    \u0441\u0430\u043c\u044b\u0435 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u044b\u0435 \u043d\u0430
    \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u0437\u043d\u0430\u043d\u0438\u044f.
    \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439: \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435
    \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u043e
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c.
    \u0412 \u00abArs Magna\u00bb \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0432\u0438\u0434\u0430 `x\u00b3 + ax = b`, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439
    \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043a\u0430\u043a \u0444\u043e\u0440\u043c\u0443\u043b\u0430
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e. \u0412\u0430\u0436\u043d\u043e \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c,
    \u0447\u0442\u043e \u0441\u0430\u043c \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u043d\u0435
    \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u043e\u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u0435\u043b\u0435\u043c
    \u044d\u0442\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u2014 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0435\u0433\u043e \u043e\u0442 \u041d\u0438\u043a\u043a\u043e\u043b\u043e
    \u0422\u0430\u0440\u0442\u0430\u043b\u044c\u0438, \u043f\u043e\u043a\u043b\u044f\u0432\u0448\u0438\u0441\u044c
    \u043d\u0435 \u0440\u0430\u0437\u0433\u043b\u0430\u0448\u0430\u0442\u044c. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0432 \u0441\u0432\u043e\u0435\u043c \u0442\u0440\u0443\u0434\u0435 \u043e\u043d \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043d\u043e \u0438 \u0440\u0430\u0437\u0432\u0438\u043b
    \u0435\u0433\u043e. \u0414\u043b\u044f \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u0438\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u043a \u043d\u0443\u0436\u043d\u043e\u043c\u0443
    \u0432\u0438\u0434\u0443 \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b
    \u043c\u0435\u0442\u043e\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0435\u0439\u0447\u0430\u0441
    \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u00ab\u043f\u043e\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438\u00bb (\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0435\u0439)
    \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f,
    \u0437\u0430\u043c\u0435\u043d\u043e\u0439 `x = y + t`. \u042d\u0442\u043e\u0442 \u043c\u0435\u0442\u043e\u0434,
    \u043a\u0430\u043a \u0442\u043e\u0433\u0434\u0430 \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u043e,
    \u043e\u043d \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b
    \u043d\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043c\u043e\u0434\u0435\u043b\u044f\u0445, \u0440\u0430\u0437\u043b\u0430\u0433\u0430\u044f
    \u043a\u0443\u0431 \u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0435.
    \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439
    \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438:
    \u042d\u0442\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442
    \u0435\u0433\u043e \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u043e\u043c\u0443
    \u0443\u0447\u0435\u043d\u0438\u043a\u0443 \u041b\u043e\u0434\u043e\u0432\u0438\u043a\u043e
    \u0424\u0435\u0440\u0440\u0430\u0440\u0438, \u043d\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0441 \u0447\u0435\u0441\u0442\u044c\u044e \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0435\u0433\u043e
    \u0432 \u0441\u0432\u043e\u044e \u043a\u043d\u0438\u0433\u0443. \u0412 \u00abArs Magna\u00bb
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f
    \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u0442\u0438\u043f\u044b \u0431\u0438\u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    `x\u2074 + 3x\u00b2 = 28`), \u043f\u0440\u0438\u0447\u0435\u043c \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u043d\u0430\u0445\u043e\u0434\u0438\u0442 \u043a\u0430\u043a \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435,
    \u0442\u0430\u043a \u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043a\u043e\u0440\u043d\u0438.\n\n\U0001F3B2 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435
    \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439
    \u0438 \u00ab\u041a\u043d\u0438\u0433\u0430 \u043e\u0431 \u0438\u0433\u0440\u0435 \u0432
    \u043a\u043e\u0441\u0442\u0438\u00bb \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u043c,
    \u0438 \u044d\u0442\u043e\u0442, \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0431\u044b,
    \u043d\u0435 \u0441\u0430\u043c\u044b\u0439 \u0431\u043b\u0430\u0433\u043e\u0432\u0438\u0434\u043d\u044b\u0439
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043f\u0440\u0438\u0432\u0435\u043b \u043a \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044e
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u0430, \u0437\u0430\u043b\u043e\u0436\u0438\u0432\u0448\u0435\u0433\u043e
    \u043e\u0441\u043d\u043e\u0432\u044b \u043d\u043e\u0432\u043e\u0439 \u043d\u0430\u0443\u043a\u0438.
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u00abLiber de ludo aleae\u00bb
    (\u00ab\u041a\u043d\u0438\u0433\u0430 \u043e\u0431 \u0438\u0433\u0440\u0435 \u0432 \u043a\u043e\u0441\u0442\u0438\u00bb)
    \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0430 \u0431\u043b\u0438\u0436\u0435
    \u043a \u043a\u043e\u043d\u0446\u0443 \u0436\u0438\u0437\u043d\u0438, \u043d\u043e \u0443\u0432\u0438\u0434\u0435\u043b\u0430
    \u0441\u0432\u0435\u0442 \u043b\u0438\u0448\u044c \u0432 1663 \u0433\u043e\u0434\u0443.
    \u041f\u0435\u0440\u0432\u044b\u0439 \u0448\u0430\u0433 \u043a \u0442\u0435\u043e\u0440\u0438\u0438
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439: \u042d\u0442\u043e\u0442
    \u0442\u0440\u0443\u0434 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432,
    \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044e\u0449\u0438\u0445 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u043f\u043e\u043d\u044f\u0442\u0438\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438
    \u0438 \u0442\u0435\u043e\u0440\u0438\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439.
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432\u0432\u043e\u0434\u0438\u0442
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438
    \u043a\u0430\u043a \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0447\u0438\u0441\u043b\u0430
    \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0445 \u0438\u0441\u0445\u043e\u0434\u043e\u0432
    \u043a \u043e\u0431\u0449\u0435\u043c\u0443 \u0447\u0438\u0441\u043b\u0443 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445
    \u0441\u043b\u0443\u0447\u0430\u0435\u0432. \u041f\u043e \u0441\u0443\u0442\u0438, \u043e\u043d
    \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438
    \u0437\u0430\u0434\u043e\u043b\u0433\u043e \u0434\u043e \u041b\u0430\u043f\u043b\u0430\u0441\u0430.
    \u041d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0435 \u0438\u0434\u0435\u0438:
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u043a\u043d\u0438\u0433\u0435 \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0442\u0430\u043a\u0436\u0435 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u0443\u0435\u0442
    \u0437\u0430\u043a\u043e\u043d \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0447\u0438\u0441\u0435\u043b
    \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442,
    \u0447\u0442\u043e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f
    \u0441\u043e\u0431\u044b\u0442\u0438\u044f `n` \u0440\u0430\u0437 \u043f\u043e\u0434\u0440\u044f\u0434
    \u0440\u0430\u0432\u043d\u0430 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438
    \u044d\u0442\u043e\u0433\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0432 \u0441\u0442\u0435\u043f\u0435\u043d\u0438
    `n`. \u0415\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430\u0442 \u2014 \u044d\u0442\u043e
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0443\u0445\u0430\u044f \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430,
    \u043d\u043e \u0438 \u0446\u0435\u043d\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a
    \u043f\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438 \u0434\u0430\u0436\u0435 \u043c\u043e\u0440\u0430\u043b\u0438 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0445
    \u0438\u0433\u0440 \u044d\u043f\u043e\u0445\u0438 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.\n\n\U0001FA7A
    \u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0430: \u043c\u0435\u0436\u0434\u0443 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0435\u0439
    \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u0442\u0432\u043e\u043c \u0414\u043b\u044f
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0430
    \u0431\u044b\u043b\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0443\u043a\u043e\u0439,
    \u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0435\u0439 \u0438 \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u0438\u0435\u043c.
    \u041e\u043d \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u044e\u0449\u0438\u043c
    \u0432\u0440\u0430\u0447\u043e\u043c, \u0438 \u0435\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u044b
    \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u043d\u0430
    \u0441\u0442\u044b\u043a\u0435 \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u044b\u0445
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0439 \u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0445
    \u0438\u0434\u0435\u0439. \u0413\u0430\u043b\u0435\u043d \u0438 \u00ab\u043d\u043e\u0432\u044b\u0439
    \u0413\u0438\u043f\u043f\u043e\u043a\u0440\u0430\u0442\u00bb: \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u0435\u0433\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0430\u044f
    \u0431\u0430\u0437\u0430 \u043e\u043f\u0438\u0440\u0430\u043b\u0430\u0441\u044c \u043d\u0430
    \u0442\u0440\u0443\u0434\u044b \u0413\u0430\u043b\u0435\u043d\u0430, \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445,
    \u043a\u0442\u043e \u0441 \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0437\u043c\u043e\u043c
    \u043f\u0440\u0438\u043d\u044f\u043b \u0443\u0447\u0435\u043d\u0438\u0435 \u0413\u0438\u043f\u043f\u043e\u043a\u0440\u0430\u0442\u0430.
    \u041e\u043d \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0438\u0437\u0443\u0447\u0430\u043b
    \u0433\u0438\u043f\u043f\u043e\u043a\u0440\u0430\u0442\u043e\u0432\u0441\u043a\u0438\u0439
    \u043a\u043e\u0440\u043f\u0443\u0441 \u0438 \u043f\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u043b
    \u0435\u0433\u043e \u0438\u0434\u0435\u0438 \u0432 \u0441\u0432\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0445,
    \u0441\u0442\u0440\u0435\u043c\u044f\u0441\u044c \u0440\u0435\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443. \u041f\u0440\u0438\u0432\u0435\u0440\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0438: \u041e\u043d \u0431\u044b\u043b \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u043e\u043c
    \u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439
    \u0438 \u0432\u044b\u0441\u043e\u043a\u043e \u0446\u0435\u043d\u0438\u043b \u0442\u0440\u0443\u0434\u044b
    \u0410\u043d\u0434\u0440\u0435\u0430\u0441\u0430 \u0412\u0435\u0437\u0430\u043b\u0438\u044f,
    \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u044f \u0432\u0430\u0436\u043d\u043e\u0441\u0442\u044c
    \u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0442\u0435\u043b\u0430 \u0434\u043b\u044f
    \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0432\u0440\u0430\u0447\u0430. \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435
    \u0433\u0440\u0430\u043d\u0438\u0446: \u00ab\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0430
    \u0447\u0443\u0434\u0435\u0441\u00bb: \u0412 \u043a\u0440\u0443\u0433 \u0435\u0433\u043e
    \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432
    \u0432\u0445\u043e\u0434\u0438\u043b\u0438 \u044f\u0432\u043b\u0435\u043d\u0438\u044f, \u0432\u044b\u0445\u043e\u0434\u044f\u0449\u0438\u0435
    \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u0441\u0443\u0445\u043e\u0439 \u044d\u043c\u043f\u0438\u0440\u0438\u043a\u0438.
    \u041e\u043d \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u043b
    \u043e\u043a\u043a\u0443\u043b\u044c\u0442\u043d\u044b\u0435 \u0441\u0438\u043b\u044b \u0432
    \u043f\u0440\u0438\u0440\u043e\u0434\u0435, \u0441\u043d\u044b \u0438 \u0434\u0430\u0436\u0435
    \u0437\u0430\u043a\u043b\u0438\u043d\u0430\u043d\u0438\u044f \u043a\u0430\u043a \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f. \u0415\u0433\u043e
    \u043a\u043d\u0438\u0433\u0430 \u00abSynesiorum somniorum libri\u00bb (1562) \u0441\u0442\u0430\u043b\u0430
    \u0441\u0430\u043c\u044b\u043c \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u043e\u043c \u043e \u0441\u043d\u0430\u0445 \u0432
    \u044d\u043f\u043e\u0445\u0443 \u0420\u0435\u043d\u0435\u0441\u0441\u0430\u043d\u0441\u0430.\n\n\U0001F30D
    \u041d\u0430\u0442\u0443\u0440\u0444\u0438\u043b\u043e\u0441\u043e\u0444: \u00ab\u041e \u0442\u043e\u043d\u043a\u043e\u0441\u0442\u0438
    \u0432\u0435\u0449\u0435\u0439\u00bb \u0438 \u00ab\u041e\u0431 \u0438\u0437\u043c\u0435\u043d\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u0432\u0435\u0449\u0435\u0439\u00bb \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0441\u0442\u0440\u0435\u043c\u0438\u043b\u0441\u044f
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0432\u0441\u0435\u043e\u0431\u044a\u0435\u043c\u043b\u044e\u0449\u0443\u044e
    \u043a\u0430\u0440\u0442\u0438\u043d\u0443 \u043c\u0438\u0440\u0430, \u0447\u0442\u043e
    \u043e\u0442\u0440\u0430\u0437\u0438\u043b\u043e\u0441\u044c \u0432 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0445
    \u043d\u0430\u0442\u0443\u0440\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445
    \u0442\u0440\u0443\u0434\u0430\u0445 \u2014 \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f\u0445
    \u00abDe subtilitate\u00bb (\u00ab\u041e \u0442\u043e\u043d\u043a\u043e\u0441\u0442\u0438
    \u0432\u0435\u0449\u0435\u0439\u00bb, 1550) \u0438 \u00abDe rerum varietate\u00bb (\u00ab\u041e\u0431
    \u0438\u0437\u043c\u0435\u043d\u0447\u0438\u0432\u043e\u0441\u0442\u0438 \u0432\u0435\u0449\u0435\u0439\u00bb,
    1557). \u0426\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0435 \u043c\u0438\u0440\u043e\u0432\u043e\u0437\u0437\u0440\u0435\u043d\u0438\u0435:
    \u0412 \u044d\u0442\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u0445 \u043e\u043d
    \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0441\u043c\u044b\u0441\u043b\u0438\u0442\u044c
    \u043f\u0440\u0438\u0440\u043e\u0434\u0443 \u043a\u0430\u043a \u0435\u0434\u0438\u043d\u043e\u0435
    \u0446\u0435\u043b\u043e\u0435, \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044f \u0432\u043e\u0435\u0434\u0438\u043d\u043e
    \u0437\u0435\u043c\u043d\u043e\u0435 \u0438 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0435,
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438 \u0434\u0443\u0445\u043e\u0432\u043d\u043e\u0435.
    \u0418\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u043c
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b: \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b
    \u0443\u0432\u043b\u0435\u0447\u0435\u043d \u0438\u0434\u0435\u0435\u0439 \u0442\u0430\u0439\u043d\u044b\u0445
    \u0437\u043d\u0430\u043d\u0438\u0439. \u0415\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00abDe Secretis\u00bb \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d \u043f\u043e\u0438\u0441\u043a\u0443
    \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044e \u00ab\u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0432\u00bb
    \u043f\u0440\u0438\u0440\u043e\u0434\u044b, \u0447\u0442\u043e \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442
    \u043e\u0431\u0449\u0443\u044e \u0434\u043b\u044f \u0440\u0435\u043d\u0435\u0441\u0441\u0430\u043d\u0441\u043d\u043e\u0439
    \u043d\u0430\u0442\u0443\u0440\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438 \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044e.\n\n\U0001F4A1
    \u0414\u0440\u0443\u0433\u0438\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f
    \u0438 \u0432\u043a\u043b\u0430\u0434\u044b \u041f\u043e\u043c\u0438\u043c\u043e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445
    \u043d\u0430\u0443\u043a, \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u0438\u043b
    \u0441\u0435\u0431\u044f \u043a\u0430\u043a \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0439
    \u0438\u043d\u0436\u0435\u043d\u0435\u0440 \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u044c.
    \u041a\u0430\u0440\u0434\u0430\u043d\u043d\u044b\u0439 \u0432\u0430\u043b: \u0425\u043e\u0442\u044f
    \u0441\u0430\u043c \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u0438 \u0434\u043e \u043d\u0435\u0433\u043e, \u0438\u043c\u0435\u043d\u043d\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0434\u0430\u043b \u0435\u0433\u043e \u043f\u0435\u0440\u0432\u043e\u0435 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0435
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435.
    \u0420\u0435\u0448\u0435\u0442\u043a\u0430 \u041a\u0430\u0440\u0434\u0430\u043d\u043e: \u041e\u043d
    \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u043f\u0440\u043e\u0441\u0442\u043e\u0435, \u043d\u043e
    \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e
    \u0434\u043b\u044f \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u043e\u0441\u044c
    \u0434\u043b\u044f \u0442\u0430\u0439\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438.
    \u0414\u0436\u0435\u0440\u043e\u043b\u0430\u043c\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043e\u0431\u044a\u044f\u0442\u044c \u043d\u0435\u043e\u0431\u044a\u044f\u0442\u043d\u043e\u0435.
    \u0415\u0433\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f, \u0431\u0443\u0434\u044c
    \u0442\u043e \u0430\u043b\u0433\u0435\u0431\u0440\u0430\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0438\u043b\u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0435
    \u0442\u0440\u0430\u043a\u0442\u0430\u0442\u044b, \u043f\u0440\u043e\u0440\u044b\u0432\u0430\u043b\u0438
    \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u0437\u043d\u0430\u043d\u0438\u0439 \u0435\u0433\u043e
    \u044d\u043f\u043e\u0445\u0438. \u041e\u043d \u043d\u0435 \u0431\u043e\u044f\u043b\u0441\u044f
    \u0437\u0430\u0434\u0430\u0432\u0430\u0442\u044c \u0432\u043e\u043f\u0440\u043e\u0441\u044b
    \u0438 \u0438\u0441\u043a\u0430\u0442\u044c \u043d\u0430 \u043d\u0438\u0445 \u043e\u0442\u0432\u0435\u0442\u044b,
    \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0442\u0435 \u0443\u0432\u043e\u0434\u0438\u043b\u0438
    \u0435\u0433\u043e \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0441\u043d\u043e\u0432
    \u0438\u043b\u0438 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0445 \u0438\u0433\u0440,
    \u0447\u0442\u043e \u0438 \u0441\u0434\u0435\u043b\u0430\u043b\u043e \u0435\u0433\u043e
    \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u044f\u0440\u043a\u0438\u0445
    \u0444\u0438\u0433\u0443\u0440 \u0420\u0435\u043d\u0435\u0441\u0441\u0430\u043d\u0441\u0430."
  achievementsEn: "Gerolamo Cardano left a deep mark in a wide range of fields of knowledge, from mathematics to medicine and naturalhood, and his contribution is not just a separate discovery, but a whole system of views that is largely ahead of its time.\n\n♪ \"Ars Magna\" and the greatest achievements in algebra in 1545 saw the light of work that forever put Cardano's name in the history of mathematics, \"Ars Magna\". This book was a real revolution in algebra, gathering and organizing the most advanced knowledge at that time. The solution to the cube equations is the main algebraic achievement that Cardano has brought to its attention.In \"Ars Magna\", he published a method for solving the equations of species `x3 + ax = b', known today as the Cardano formula. It is important to note that Cardano himself was not the first to discover this method; he received it from Nikkol Tartalya, swearing not to disclose it. However, in his work he not only published the decision but also developed it.To bring the equations to the right view, he used a method now called \"depressiveness\" (depressive) cube equation, replacing `x = y + t'. This method, as was then accepted, showed on geometric models, dividing the cube into components. The solution to equations of the fourth degree: This achievement belongs to his talented student Lodovico Ferrari, but Cardano honorably included it in his book.\"Ars Magna\" details different types of biquadrate equations (e.g. `x4 + 3x2 = 28'), with Cardano finding both positive and negative roots.\n\nThe birth of the probabilities theory and the \"Kiddy Play Book\" Cardano was a famous player, and this seemingly not the most beneficial interest led to the emergence of a tract that laid the foundation for a new science. His work, \"Liber de lido aleae\", was written closer to the end of life, but only saw light in 1663.The first step to probability theory: this work is considered to be one of the first texts to explain the fundamental concepts of combination and probability theory. For the first time, Cardano introduces a definition of probability as the ratio of favourable outcomes to the total number of possible cases. In fact, he has formulated a classic definition of probability long before Laplaces.Innovative ideas: In its book Cardano also for the first time formulates the law of large numbers and correctly determines that the probability of an event `n' occurring once in a row is equal to the probability of that event to the extent `n'. His tract is not just a dry math, but also a valuable source of history, psychology and even morality in the gambling of the Renaissance era.\n\n▪ Medicine: Between tradition and innovation for Cardano, medicine was not just a science, it was a profession and a calling. He was a practicing doctor, and his views were formed by a convergence of authoritative traditions and innovative ideas. Galen and \"new Hippocratic\": Despite his medical base based on the work of Galena, Cardano was one of the first to enthusiastically accept the teaching of Hippocrates.He studied the hippocratic corps and promoted its ideas in his work, seeking to reform medicine. A commitment to anatomy: He was a supporter of anatomy and highly valued Andreas Vesalia's work, recognizing the importance of body construction to the practice of a doctor. The widening of boundaries: \"medical miracles\": His medical interests included phenomena beyond dry empirics.He studied the occult forces in nature, dreams, and even spells as possible treatments, and his book \"Synesiorum somniorum libri\" (1562) became the most significant tract of dreams in the Renaissance era.\n\n~ Naturfilosof: \"On the subtlety of things\" and \"On the variability of things\" Cardano sought to create a comprehensive picture of the world, which was reflected in his main naturalistic works, the encyclopedia \"De subtilitate\" and \"De rerum variate\", 1557). A whole world view: in these works he tries to understand nature as a whole, linking the earth and the heavens, physical and spiritual.Interest in nature's secrets: Cardano was interested in the idea of secret knowledge, and his tract, De Secretis, is about finding and explaining \"secrets\" of nature, which reflects a common trend for Renaissance naturalology.\n\nOther relevant inventions and contributions besides fundamental sciences, Cardano has shown himself as a talented engineer and inventor. The Kardano shaft: Although the mechanism itself was known before it, it was Cardano who gave it the first detailed description in Europe. Cardano's grid: He invented a simple but effective message encryption device that was used for secret correspondence. Gerolamo Cardano was a man who tried to embrace the unbroken.His achievements, be they algebraic formulas or medical tracts, broke the limits of his age's knowledge, and he was not afraid to ask questions and find answers to them, even if they took him to the realm of sleep or gambling, which made him one of the brightest figures in Renaissance."
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0414\u0436\u0435\u0440\u043e\u043b\u0430\u043c\u043e
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u2014 \u044d\u0442\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439,
    \u0441\u0430\u043c\u0430\u044f \u0442\u0440\u0430\u0433\u0438\u0447\u043d\u0430\u044f \u0438
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u0430\u044f \u0433\u043b\u0430\u0432\u0430
    \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0415\u0441\u043b\u0438
    \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u0431\u044b\u043b\u0438 \u0442\u0440\u0438\u0443\u043c\u0444\u043e\u043c \u0440\u0430\u0437\u0443\u043c\u0430,
    \u0442\u043e \u0435\u0433\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u0441\u0442\u0430\u043b\u0430 \u0447\u0435\u0440\u0435\u0434\u043e\u0439 \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043d, \u0431\u0443\u0434\u0443\u0447\u0438
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u043e\u043c-\u0441\u0430\u043c\u043e\u0443\u0447\u043a\u043e\u0439,
    \u0441\u043a\u0440\u0443\u043f\u0443\u043b\u0435\u0437\u043d\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b
    \u0432 \u0441\u0432\u043e\u0435\u0439 \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u00ab\u041e \u043c\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438\u00bb. \u0427\u0442\u043e\u0431\u044b
    \u043f\u043e\u043d\u044f\u0442\u044c \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0443\u044e
    \u0434\u0440\u0430\u043c\u0443, \u043d\u0443\u0436\u043d\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c
    \u0435\u0451 \u043d\u0430 \u0442\u0440\u0438 \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445
    \u043f\u043b\u0430\u0441\u0442\u0430: \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
