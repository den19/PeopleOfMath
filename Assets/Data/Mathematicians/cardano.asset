    \u043c\u0430\u043b\u043e, \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043b
    \u043f\u0440\u043e\u0441\u0442\u0443\u044e \u043f\u0438\u0449\u0443, \u0431\u044b\u043b
    \u043a\u0440\u0430\u0439\u043d\u0435 \u0440\u0430\u0437\u0431\u043e\u0440\u0447\u0438\u0432
    \u0432 \u0432\u0438\u043d\u0435 \u0438 \u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f
    \u0441\u0432\u043e\u0435\u0439 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\U0001F494
    \u0411\u0440\u0430\u043a \u0438 \u0443\u0442\u0440\u0430\u0442\u0430 \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439 \u0432 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438
    \u0441\u0442\u0430\u043b\u0430 \u041b\u044e\u0447\u0438\u044f \u0411\u043e\u043d\u0434\u0430\u0440\u0435\u043d\u0438,
    \u0434\u043e\u0447\u044c \u0435\u0433\u043e \u0431\u044b\u0432\u0448\u0435\u0433\u043e \u043e\u043f\u0435\u043a\u0443\u043d\u0430.
    \u0412\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0441\u043e\u044e\u0437:
    \u0411\u0440\u0430\u043a \u0431\u044b\u043b \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d
    \u043d\u0435 \u043f\u043e \u043b\u044e\u0431\u0432\u0438, \u0430 \u0441\u043a\u043e\u0440\u0435\u0435
    \u043f\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438.
    \u0412 1531 \u0433\u043e\u0434\u0443 \u041b\u044e\u0447\u0438\u044f \u0440\u043e\u0434\u0438\u043b\u0430
    \u0435\u043c\u0443 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0441\u044b\u043d\u0430,
    \u0438, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c
    \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u0430 \u0438 \u0443\u0437\u0430\u043a\u043e\u043d\u0438\u0442\u044c
    \u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0438\u043a\u0430, \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u043d\u0435\u0439. \u0425\u043e\u043b\u043e\u0434\u043d\u044b\u0435
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f: \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u043d\u0435 \u043f\u0438\u0442\u0430\u043b \u043a \u0436\u0435\u043d\u0435 \u0442\u0435\u043f\u043b\u044b\u0445
    \u0447\u0443\u0432\u0441\u0442\u0432. \u0412 \u0441\u0432\u043e\u0438\u0445 \u0437\u0430\u043f\u0438\u0441\u044f\u0445
    \u043e\u043d \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0435\u0451 \u043a\u0430\u043a
    \u0436\u0435\u043d\u0449\u0438\u043d\u0443 \u0441\u0432\u0430\u0440\u043b\u0438\u0432\u0443\u044e,
    \u043d\u0435\u0443\u0440\u0430\u0432\u043d\u043e\u0432\u0435\u0448\u0435\u043d\u043d\u0443\u044e
    \u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0440\u043e\u0436\u0430\u0432\u0448\u0443\u044e
    \u0435\u043c\u0443 \u0434\u0435\u0442\u0435\u0439, \u0447\u0442\u043e, \u043f\u043e \u0435\u0433\u043e
    \u043c\u043d\u0435\u043d\u0438\u044e, \u043f\u043e\u0434\u0440\u044b\u0432\u0430\u043b\u043e
    \u0435\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0438 \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u043b\u043e
    \u043e\u0442 \u043d\u0430\u0443\u043a\u0438. \u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0431\u0440\u0430\u043a \u2014 \u044d\u0442\u043e \u00ab\u043a\u0440\u0435\u0441\u0442\u00bb,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u043d\u0435\u0441\u0442\u0438. \u041f\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f
    \u0441\u043c\u0435\u0440\u0442\u044c: \u041b\u044e\u0447\u0438\u044f \u0443\u043c\u0435\u0440\u043b\u0430
    \u0432 1546 \u0433\u043e\u0434\u0443. \u041f\u0440\u0438\u0447\u0438\u043d\u044b \u0441\u043c\u0435\u0440\u0442\u0438
    \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b
    (\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0447\u0443\u043c\u0430 \u0438\u043b\u0438
    \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435
    \u0440\u043e\u0434\u043e\u0432), \u043d\u043e \u0434\u043b\u044f \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u044d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u043b\u0438\u0447\u043d\u043e\u0439 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0432\u043e\u0434\u043e\u043c \u0434\u043b\u044f
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0439
    \u043e \u0431\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0431\u044b\u0442\u0438\u044f.\n\n\U0001F468\u200d\U0001F467\u200d\U0001F466
    \u041f\u0440\u043e\u043a\u043b\u044f\u0442\u0438\u0435 \u0434\u0435\u0442\u0435\u0439: \u0414\u0436\u043e\u0432\u0430\u043d\u043d\u0438
    \u0411\u0430\u0442\u0442\u0438\u0441\u0442\u0430 \u0438 \u0410\u043b\u044c\u0434\u043e \u0418\u043c\u0435\u043d\u043d\u043e
    \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0434\u0435\u0442\u044c\u043c\u0438
    \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0438 \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0441\u0430\u043c\u044b\u0435 \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u0435 \u0441\u0442\u0440\u0430\u0434\u0430\u043d\u0438\u044f.
    \u0423 \u043d\u0435\u0433\u043e \u0431\u044b\u043b\u043e \u0442\u0440\u043e\u0435 \u0434\u0435\u0442\u0435\u0439:
    \u0441\u044b\u043d\u043e\u0432\u044c\u044f \u0414\u0436\u043e\u0432\u0430\u043d\u043d\u0438
    \u0411\u0430\u0442\u0442\u0438\u0441\u0442\u0430 (\u0441\u0442\u0430\u0440\u0448\u0438\u0439)
    \u0438 \u0410\u043b\u044c\u0434\u043e (\u043c\u043b\u0430\u0434\u0448\u0438\u0439), \u0430
    \u0442\u0430\u043a\u0436\u0435 \u0434\u043e\u0447\u044c \u041a\u044c\u044f\u0440\u0430.
    \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d (\u0414\u0436\u043e\u0432\u0430\u043d\u043d\u0438
    \u0411\u0430\u0442\u0442\u0438\u0441\u0442\u0430): \u042d\u0442\u043e \u0431\u044b\u043b\u0430
    \u0441\u0430\u043c\u0430\u044f \u0441\u0438\u043b\u044c\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u0432\u044c
    \u0438 \u0441\u0430\u043c\u0430\u044f \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u044f \u0431\u043e\u043b\u044c
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e. \u041e\u0442\u0435\u0446 \u0434\u0443\u0448\u0438
    \u043d\u0435 \u0447\u0430\u044f\u043b \u0432 \u0441\u0442\u0430\u0440\u0448\u0435\u043c
    \u0441\u044b\u043d\u0435, \u0432\u043b\u043e\u0436\u0438\u043b \u0432 \u0435\u0433\u043e
    \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0441\u0435 \u0441\u0438\u043b\u044b
    \u0438 \u0434\u0435\u043d\u044c\u0433\u0438, \u043c\u0435\u0447\u0442\u0430\u043b \u0432\u0438\u0434\u0435\u0442\u044c
    \u0435\u0433\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u0435\u043b\u0435\u043c
    \u0434\u0435\u043b\u0430. \u041e\u0434\u043d\u0430\u043a\u043e \u0414\u0436\u043e\u0432\u0430\u043d\u043d\u0438
    \u0411\u0430\u0442\u0442\u0438\u0441\u0442\u0430 \u0432\u044b\u0440\u043e\u0441 \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u044b\u043c,
    \u0432\u0441\u043f\u044b\u043b\u044c\u0447\u0438\u0432\u044b\u043c \u0438 \u043a\u0440\u0430\u0439\u043d\u0435
    \u043d\u0435\u0441\u0434\u0435\u0440\u0436\u0430\u043d\u043d\u044b\u043c \u043c\u043e\u043b\u043e\u0434\u044b\u043c
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c. \u0412 1560 \u0433\u043e\u0434\u0443
    \u0440\u0430\u0437\u0440\u0430\u0437\u0438\u043b\u0430\u0441\u044c \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0430:
    \u0414\u0436\u043e\u0432\u0430\u043d\u043d\u0438 \u0411\u0430\u0442\u0442\u0438\u0441\u0442\u0430
    \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0434\u0435\u0432\u0443\u0448\u043a\u0435
    \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0411\u0440\u0430\u043d\u0434\u043e\u0437\u0438\u044f
    \u0421\u0435\u0440\u043e\u043d\u0438. \u0411\u0440\u0430\u043a \u0431\u044b\u043b \u043d\u0435\u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c.
    \u0412 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0435 \u0440\u0435\u0432\u043d\u043e\u0441\u0442\u0438
    \u0438\u043b\u0438 \u044f\u0440\u043e\u0441\u0442\u0438 (\u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430
    \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0441\u043f\u043e\u0440\u043d\u044b)
    \u0414\u0436\u043e\u0432\u0430\u043d\u043d\u0438 \u0411\u0430\u0442\u0442\u0438\u0441\u0442\u0430
    \u0434\u0430\u043b \u0436\u0435\u043d\u0435 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435
    \u043f\u0438\u0440\u043e\u0436\u043d\u043e\u0435. \u0414\u0435\u0432\u0443\u0448\u043a\u0430
    \u0443\u043c\u0435\u0440\u043b\u0430. \u0415\u0433\u043e \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u0430\u043b\u0438,
    \u0441\u0443\u0434\u0438\u043b\u0438 \u0438 \u043f\u0440\u0438\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438
    \u043a \u043e\u0431\u0435\u0437\u0433\u043b\u0430\u0432\u043b\u0438\u0432\u0430\u043d\u0438\u044e.
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e, \u0431\u0443\u0434\u0443\u0447\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u043c
    \u0432\u0440\u0430\u0447\u043e\u043c, \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u043b \u043a\u043e\u043b\u043e\u0441\u0441\u0430\u043b\u044c\u043d\u044b\u0435
    \u0443\u0441\u0438\u043b\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0441\u043f\u0430\u0441\u0442\u0438
    \u0441\u044b\u043d\u0430, \u043d\u043e \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e.
    \u041a\u0430\u0437\u043d\u044c \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430\u0441\u044c.
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b \u0441\u043b\u043e\u043c\u043b\u0435\u043d
    \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u043e, \u0438, \u043f\u043e \u0435\u0433\u043e
    \u0441\u043b\u043e\u0432\u0430\u043c, \u0438\u043c\u0435\u043d\u043d\u043e \u0441 \u044d\u0442\u043e\u0433\u043e
    \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u043e\u043d \u043f\u043e\u0442\u0435\u0440\u044f\u043b
    \u0432\u043a\u0443\u0441 \u043a \u0436\u0438\u0437\u043d\u0438. \u041c\u043b\u0430\u0434\u0448\u0438\u0439
    \u0441\u044b\u043d (\u0410\u043b\u044c\u0434\u043e): \u0415\u0441\u043b\u0438 \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u0441\u044b\u043d \u0440\u0430\u0437\u0431\u0438\u043b \u0441\u0435\u0440\u0434\u0446\u0435
    \u043e\u0442\u0446\u0430 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0435\u0439, \u0442\u043e
    \u043c\u043b\u0430\u0434\u0448\u0438\u0439 \u2014 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c
    \u0431\u0435\u0441\u0447\u0435\u0441\u0442\u044c\u0435\u043c. \u0410\u043b\u044c\u0434\u043e
    \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u0438\u043c\u044b\u043c
    \u0438\u0433\u0440\u043e\u043a\u043e\u043c \u0438 \u0432\u043e\u0440\u043e\u043c. \u041e\u043d
    \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0432\u043e\u0440\u043e\u0432\u0430\u043b
    \u0443 \u043e\u0442\u0446\u0430 \u0434\u0435\u043d\u044c\u0433\u0438 \u0438 \u0434\u0440\u0430\u0433\u043e\u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438,
    \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0441\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0442\u044c\u0441\u044f
    \u0441 \u043a\u0430\u0440\u0442\u043e\u0447\u043d\u044b\u043c\u0438 \u0434\u043e\u043b\u0433\u0430\u043c\u0438.
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0432 \u0441\u0432\u043e\u0435\u0439 \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438
    \u0441 \u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c \u043f\u0438\u0448\u0435\u0442
    \u043e \u043c\u043b\u0430\u0434\u0448\u0435\u043c \u0441\u044b\u043d\u0435, \u043d\u0430\u0437\u044b\u0432\u0430\u044f
    \u0435\u0433\u043e \u00ab\u043f\u043e\u0437\u043e\u0440\u043e\u043c \u0441\u0435\u043c\u044c\u0438\u00bb
    \u0438 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u043e\u0442\u0440\u0435\u043a\u0430\u044f\u0441\u044c
    \u043e\u0442 \u043d\u0435\u0433\u043e. \u0414\u043e\u0447\u044c (\u041a\u044c\u044f\u0440\u0430):
    \u041e \u0435\u0451 \u0441\u0443\u0434\u044c\u0431\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e
    \u043c\u0435\u043d\u044c\u0448\u0435. \u041e\u043d\u0430 \u0432\u044b\u0448\u043b\u0430
    \u0437\u0430\u043c\u0443\u0436, \u0438, \u0445\u043e\u0442\u044f \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0435\u0451 \u0432 \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0438,
    \u0432 \u0435\u0433\u043e \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0437\u0430\u043f\u0438\u0441\u044f\u0445 \u043e\u043d\u0430 \u0438\u0433\u0440\u0430\u0435\u0442
    \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0440\u043e\u043b\u044c.\n\n\u26d3\ufe0f
    \u0410\u0440\u0435\u0441\u0442 \u0438 \u0442\u044e\u0440\u044c\u043c\u0430 \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0438
    (1570) \u041b\u0438\u0447\u043d\u0430\u044f \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f
    \u0443\u0441\u0443\u0433\u0443\u0431\u0438\u043b\u0430\u0441\u044c \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u043e\u0439. \u041f\u043e\u0432\u043e\u0434
    \u0434\u043b\u044f \u0430\u0440\u0435\u0441\u0442\u0430: \u0412 1570 \u0433\u043e\u0434\u0443
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u0430\u043d
    \u0440\u0438\u043c\u0441\u043a\u043e\u0439 \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0435\u0439.
    \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u0435\u043c
    \u0441\u0442\u0430\u043b\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f\u0430 \u0418\u0438\u0441\u0443\u0441\u0430
    \u0425\u0440\u0438\u0441\u0442\u0430. \u0414\u043b\u044f \u0446\u0435\u0440\u043a\u0432\u0438
    \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043a\u043e\u0449\u0443\u043d\u0441\u0442\u0432\u043e\u043c
    \u0432\u044b\u0441\u0448\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u2014 \u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0439
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043e\u0441\u043c\u0435\u043b\u0438\u043b\u0441\u044f
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u0437\u0432\u0435\u0437\u0434 \u0432 \u043c\u043e\u043c\u0435\u043d\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u044c\u0435\u0433\u043e \u0438, \u0447\u0442\u043e
    \u0435\u0449\u0435 \u0445\u0443\u0436\u0435, \u0441\u0434\u0435\u043b\u0430\u0442\u044c
    \u0432\u044b\u0432\u043e\u0434\u044b \u043e \u0435\u0433\u043e \u0441\u0443\u0434\u044c\u0431\u0435
    \u0438 \u0440\u0430\u0441\u043f\u044f\u0442\u0438\u0438. \u041f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0435
    \u0432 \u0442\u044e\u0440\u044c\u043c\u0435: \u041e\u043d \u0431\u044b\u043b \u0431\u0440\u043e\u0448\u0435\u043d
    \u0432 \u0442\u044e\u0440\u044c\u043c\u0443 \u0438 \u043f\u0440\u043e\u0432\u0435\u043b
    \u0442\u0430\u043c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432
    (\u0442\u043e\u0447\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e
    \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u043f\u043e \u0440\u0430\u0437\u043d\u044b\u043c
    \u0434\u0430\u043d\u043d\u044b\u043c \u043e\u0442 3 \u0434\u043e 5). \u0423\u0441\u043b\u043e\u0432\u0438\u044f
    \u0431\u044b\u043b\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u043c\u0438. \u0414\u043b\u044f
    \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043f\u0440\u0438\u0432\u044b\u043a\u0448\u0435\u0433\u043e
    \u043a \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0443 \u0438 \u0441\u0442\u0440\u0430\u0434\u0430\u044e\u0449\u0435\u0433\u043e
    \u043f\u043e\u0434\u0430\u0433\u0440\u043e\u0439, \u0442\u044e\u0440\u0435\u043c\u043d\u043e\u0435
    \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u044b\u0442\u043a\u043e\u0439.
    \u041e\u0442\u0440\u0435\u0447\u0435\u043d\u0438\u0435 \u0438 \u043a\u0440\u0430\u0445 \u043a\u0430\u0440\u044c\u0435\u0440\u044b:
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u0431\u044b\u043b \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u043e\u0442\u0440\u0435\u0447\u044c\u0441\u044f
    \u043e\u0442 \u0441\u0432\u043e\u0438\u0445 \u00ab\u0435\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445\u00bb
    \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432. \u0415\u0433\u043e \u0432\u044b\u043f\u0443\u0441\u0442\u0438\u043b\u0438,
    \u043d\u043e \u043e\u043d \u043b\u0438\u0448\u0438\u043b\u0441\u044f \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u0439
    \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u0432 \u0411\u043e\u043b\u043e\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 (\u0435\u043c\u0443
    \u0431\u044b\u043b\u043e \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c),
    \u0430 \u0435\u0433\u043e \u043a\u043d\u0438\u0433\u0438 \u0431\u044b\u043b\u0438 \u0432\u043d\u0435\u0441\u0435\u043d\u044b
    \u0432 \u00ab\u0418\u043d\u0434\u0435\u043a\u0441 \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043d\u044b\u0445
    \u043a\u043d\u0438\u0433\u00bb.\n\n\U0001F3AD \u0412\u043e\u043b\u044c\u043d\u043e\u0435
    \u0438\u0437\u0433\u043d\u0430\u043d\u0438\u0435 \u0432 \u0420\u0438\u043c\u0435 \u0438
    \u0437\u0430\u0433\u0430\u0434\u043a\u0430 \u0441\u043c\u0435\u0440\u0442\u0438 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439
    \u043f\u0435\u0440\u0438\u043e\u0434 \u0436\u0438\u0437\u043d\u0438 \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u043f\u0440\u043e\u0448\u0435\u043b \u0432 \u0420\u0438\u043c\u0435. \u041f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043f\u0430\u043f\u044b: \u041a\u0430\u043a \u043d\u0438 \u043f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u043e,
    \u043d\u043e \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u0442\u044e\u0440\u044c\u043c\u044b
    \u0435\u043c\u0443 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f
    \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043f\u0430\u043f\u044b
    \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u044f XIII. \u041f\u043e \u043e\u0434\u043d\u043e\u0439
    \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439, \u043f\u0430\u043f\u0430 \u043d\u0443\u0436\u0434\u0430\u043b\u0441\u044f
    \u0432 \u0443\u0441\u043b\u0443\u0433\u0430\u0445 \u043b\u0443\u0447\u0448\u0435\u0433\u043e
    \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0430 \u0415\u0432\u0440\u043e\u043f\u044b.
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d
    \u043b\u0438\u0447\u043d\u044b\u043c \u0432\u0440\u0430\u0447\u043e\u043c \u043f\u0430\u043f\u0441\u043a\u043e\u0433\u043e
    \u043b\u0435\u0433\u0430\u0442\u0430 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u0443\u044e
    \u043f\u0430\u043f\u0441\u043a\u0443\u044e \u043f\u0435\u043d\u0441\u0438\u044e, \u0447\u0442\u043e
    \u0441\u043f\u0430\u0441\u043b\u043e \u0435\u0433\u043e \u043e\u0442 \u043d\u0438\u0449\u0435\u0442\u044b.
    \u0421\u0430\u043c\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043b\u0435\u0433\u0435\u043d\u0434\u0430:
    \u041f\u0435\u0440\u0435\u0435\u0445\u0430\u0432 \u0432 \u0420\u0438\u043c, \u043e\u043d
    \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e
    \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0438 \u0442\u043e\u0447\u043d\u043e
    \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u043b \u0434\u0430\u0442\u0443 \u0441\u0432\u043e\u0435\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u2014 21 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1576 \u0433\u043e\u0434\u0430. \u041a\u043e\u0433\u0434\u0430 \u044d\u0442\u043e\u0442 \u0434\u0435\u043d\u044c
    \u043d\u0430\u0441\u0442\u0430\u043b, \u0430 \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0431\u044b\u043b \u0432\u0441\u0435 \u0435\u0449\u0435 \u0436\u0438\u0432 (\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b
    \u0441\u0435\u0431\u044f \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043d\u0435\u043f\u043b\u043e\u0445\u043e), \u0447\u0442\u043e\u0431\u044b \u043d\u0435
    \u0443\u0434\u0430\u0440\u0438\u0442\u044c \u0432 \u0433\u0440\u044f\u0437\u044c \u043b\u0438\u0446\u043e\u043c
    \u043f\u0435\u0440\u0435\u0434 \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439 \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c
    \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e \u043d\u0435\u043f\u043e\u0433\u0440\u0435\u0448\u0438\u043c\u043e\u0433\u043e
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f, \u043e\u043d,
    \u043f\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u043f\u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0441 \u0441\u043e\u0431\u043e\u0439 \u0433\u043e\u043b\u043e\u0434\u0430\u043d\u0438\u0435\u043c.
    \u0412\u0435\u0440\u0441\u0438\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u043e\u0432:
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438
    \u0441\u043a\u043b\u043e\u043d\u044f\u044e\u0442\u0441\u044f \u043a \u0431\u043e\u043b\u0435\u0435
    \u043f\u0440\u043e\u0437\u0430\u0438\u0447\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438:
    \u043e\u043d \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0448\u0438\u0431\u0441\u044f \u0432
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445 \u043d\u0430 \u0433\u043e\u0434. \u041e\u043d
    \u0443\u043c\u0435\u0440 \u043d\u0435 \u0432 1576, \u0430 \u0432 1575 \u0433\u043e\u0434\u0443
    (\u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c,
    20 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1575 \u0433\u043e\u0434\u0430). \u0421\u043a\u043e\u0440\u0435\u0435
    \u0432\u0441\u0435\u0433\u043e, \u0435\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c
    \u0431\u044b\u043b \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u0438\u0441\u0442\u043e\u0449\u0435\u043d \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u043c\u0438
    \u0431\u043e\u043b\u0435\u0437\u043d\u044f\u043c\u0438 \u0438 \u0441\u0442\u0440\u0435\u0441\u0441\u0430\u043c\u0438,
    \u0438 \u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c
    \u043f\u0443\u0442\u0435\u043c, \u0430 \u043b\u0435\u0433\u0435\u043d\u0434\u0430 \u043e
    \u0433\u043e\u043b\u043e\u0434\u043e\u0432\u043a\u0435 \u2014 \u043b\u0438\u0448\u044c \u043a\u0440\u0430\u0441\u0438\u0432\u0430\u044f
    \u043c\u0435\u0442\u0430\u0444\u043e\u0440\u0430 \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u0438,
    \u0433\u0434\u0435 \u0440\u0430\u0437\u0443\u043c \u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u043f\u043e\u0434\u0447\u0438\u043d\u0438\u0442\u044c \u0441\u0435\u0431\u0435 \u0441\u0430\u043c\u0443
    \u0441\u043c\u0435\u0440\u0442\u044c. \u0414\u0436\u0435\u0440\u043e\u043b\u0430\u043c\u043e
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u043f\u0440\u043e\u0436\u0438\u043b \u0436\u0438\u0437\u043d\u044c,
    \u043f\u043e\u043b\u043d\u0443\u044e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u0442\u0440\u0438\u0443\u043c\u0444\u0430
    \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0436\u0435\u043d\u0438\u044f.
    \u041e\u043d \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0432\u0441\u0435: \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0435\u0442,
    \u0441\u0443\u0434\u044c\u0431\u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432
    \u0438 \u0434\u0430\u0436\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439
    \u043a\u043e\u043d\u0435\u0446, \u043d\u043e \u0442\u0430\u043a \u0438 \u043d\u0435 \u0441\u043c\u043e\u0433
    \u0441\u043e\u0432\u043b\u0430\u0434\u0430\u0442\u044c \u0441\u043e \u0441\u0432\u043e\u0435\u0439
    \u0441\u0435\u043c\u044c\u0435\u0439 \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439
    \u0431\u043e\u043b\u044c\u044e."
  personalLifeEn: "Gerolamo Cardano's personal life is perhaps the most tragic and controversial chapter of his life story, and if his scientific achievements were the triumph of reason, his family history became a series of catastrophes that he, as a genius self-samologist, carefully analysed in his autobiography \"O My Life\".To understand his personal drama, it must be divided into three interrelated layers: his own health and psychological profile, his marriage and his relationship with children, and his unique experience of imprisonment.\n\nThe psychological portrait and obsession of Cardano was not just a hypochondriac; he was a person who lived in constant dialogue with his body and mind. A painful childhood: he was born premature, and his mother, according to his own claim, tried to terminate the pregnancy by abortion, and this left a mark on his entire life: he thought he was weak from birth.The Spectacle of Diseases: Throughout his life, he suffered from a host of diseases that he described in detail: increased heartbeat, impotence in youth (which he believed was the result of an unhappily horoscope), gymnastics, haemorrhage and chronic abdominal pains. \"Sleeping paralysis\" and visions: Cardano suffered from conditions that today identify as sleep paralysis.He woke up and couldn't move, feeling the presence of demonic creatures in the room, but as a rationalist, he did not think of them as demons, but as natural but abnormal processes in the brain. Narcissism and asceticism: He was convinced of his divine choice. His autobiography was based on his own sense of greatness, but he was rather a Spartan lifestyle.He ate little, preferred simple food, was extremely picky in wine, and was famous for his incredible ability to work.\n\nThe marriage and loss of the only woman in his life was Lucia Bondarena, the daughter of his former guardian.In his notes, he described her as a woman who had a grumpy, unstable and constant child, which, in his opinion, undermined his health and distracted him from science. He believed that marriage was the \"crusade\" he was forced to carry.The causes of death are not known (perhaps plagues or complications after childbirth), but for Cardano it has become not so much a personal tragedy as a reason for philosophical thinking about the depravity of existence.\n\nThe curse of the children: Giovanni Batista and Aldo The relationship with the children was the most painful of all. He had three children: the sons of Giovanni Battista (senior) and Aldo (supreme), as well as the daughter of Kiara. The eldest son (Jovanni Battista): It was the best love and the worst pain of Cardano. Father of the soul did not feel in the eldest son, invested all his strength and money in his education, dreamed of seeing him continue the work.However, Giovanni Batista grew up impulsive, violent and extremely unbridled young man, and in 1560, Giovanni Battista married a girl named Brandozia Seroni, and the marriage was unhappy, and Giovanni Batista gave his wife a poisoned cake in a fit of jealousy or rage (the circumstances are still disputed).Cardano, as a famous doctor, made a tremendous effort to save his son, but without success, the execution took place, and Cardano was morally broken, and he said it was from that moment that he had lost his taste for life. The youngest son (Aldo): If the eldest son broke his father's heart with tragedy, the youngest one was in permanent contempt, Aldo was an incorruptible player and a thief.He was constantly stealing money and jewels from his father to pay off his card debt. Cardano, in his autobiography, repulsively writes about his youngest son, calling him \"the shame of his family\" and publicly disavowing him.\n\nThe arrest and prison of the Inquisition (1570), the personal tragedy was exacerbated by political and religious tragedy.He was imprisoned and spent several months there (exactly unknown, according to different figures from 3 to 5), and the conditions were difficult, and for a man who was comfortable and had a stroke, imprisonment became physical torture, and the loss of his career: Cardano was forced to publicly renounce his \"heretical\" views.He was released, but he lost his professorship at the University of Bologna (it was forbidden to teach), and his books were placed in the Index of Prohibited Books.\n\nThe free exile in Rome and the mystery of death were the last years of Cardano's life in Rome. The Pope's patronymic: paradoxically, but immediately after the prison, he managed to secure the location of Pope Gregory XIII. According to one version, he needed the best astrologer in Europe. Cardano was appointed as a personal doctor of the papal legate and received a life-long papal pension, which saved him from poverty.The most famous legend is that when he moved to Rome, he stated that he had calculated with astrology the exact date of his death, 21 September 1576, when the day had come and Cardano was still alive (and felt relatively good) to avoid being struck in the mud in front of history and to preserve the reputation of an infallible fortune teller, he had, by legend, committed suicide.History Version: Modern historians are leaning towards a more prosaic version: he just miscalculated for a year; he died not in 1576, but in 1575 (some data indicate 20 September 1575); his body was likely completely exhausted by years of illness and stress, and he died naturally, and the story of the hunger strike was only a beautiful metaphor of his life, where his mind tried to control itself by death.Gerolamo Cardano lived a life full of scientific triumph and human humiliation, and he was a man who tried to control everything -- planet movement, patient fate and even his own end, but never managed to cope with his family and his own pain."
  shortBioRu: "\u0414\u0436\u0435\u0440\u043e\u043b\u0430\u043c\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u2014 \u0444\u0438\u0433\u0443\u0440\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043f\u0440\u0438\u0447\u0443\u0434\u043b\u0438\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u043b\u0438\u0441\u044c
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0443\u0447\u0435\u043d\u043e\u0433\u043e,
    \u0441\u0430\u043c\u043e\u043e\u0442\u0432\u0435\u0440\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u0432\u0440\u0430\u0447\u0430, \u043c\u0438\u0441\u0442\u0438\u0446\u0438\u0437\u043c \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0430
    \u0438 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430
    \u0432\u0437\u043b\u0435\u0442\u043e\u0432 \u0438 \u043f\u0430\u0434\u0435\u043d\u0438\u0439,
    \u0430 \u0435\u0433\u043e \u0442\u0440\u0443\u0434\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0438
    \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435
    \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u043e\u0437\u043d\u0430\u043d\u0438\u044f.\n\n\U0001F9EC
    \u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u044e\u043d\u043e\u0441\u0442\u044c
    (1501\u20131526) \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0440\u043e\u0434\u0438\u043b\u0441\u044f
    24 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1501 \u0433\u043e\u0434\u0430 \u0432
    \u041f\u0430\u0432\u0438\u0438. \u041e\u043d \u0431\u044b\u043b \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c
    \u0441\u044b\u043d\u043e\u043c \u044e\u0440\u0438\u0441\u0442\u0430 \u0424\u0430\u0446\u0438\u043e
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b
    \u0434\u0440\u0443\u0433\u043e\u043c \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0434\u0430
    \u0412\u0438\u043d\u0447\u0438 \u0438 \u043e\u0431\u043b\u0430\u0434\u0430\u043b \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f\u043c\u0438
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u0442\u0435\u0446
    \u0443\u0437\u0430\u043a\u043e\u043d\u0438\u043b \u0435\u0433\u043e \u043b\u0438\u0448\u044c
    \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e \u0434\u043e \u0441\u0432\u043e\u0435\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438. \u0414\u0435\u0442\u0441\u0442\u0432\u043e \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e
    \u0443\u0447\u0435\u043d\u043e\u0433\u043e \u0431\u044b\u043b\u043e \u0442\u0440\u0443\u0434\u043d\u044b\u043c:
    \u043e\u043d \u0447\u0430\u0441\u0442\u043e \u0431\u043e\u043b\u0435\u043b, \u0438, \u043f\u043e
    \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c,
    \u043c\u0430\u0442\u044c \u0434\u0430\u0436\u0435 \u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044c
    \u043f\u0440\u0435\u0440\u0432\u0430\u0442\u044c \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c.
    \u041f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435
    \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c
    \u043e\u0442\u0446\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0431\u0443\u0447\u0438\u043b
    \u0435\u0433\u043e \u0447\u0442\u0435\u043d\u0438\u044e, \u043f\u0438\u0441\u044c\u043c\u0443
    \u0438 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0435. \u0412 1520 \u0433\u043e\u0434\u0443
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u041f\u0430\u0432\u0438\u0438
    \u043d\u0430 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442.
    \u0418\u0437-\u0437\u0430 \u0432\u043e\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0437\u0430\u043a\u0440\u044b\u043b\u0441\u044f,
    \u0438 \u0432 1526 \u0433\u043e\u0434\u0443 \u043e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b
    \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0441\u0442\u0435\u043f\u0435\u043d\u044c
    \u043f\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0435 \u0432 \u041f\u0430\u0434\u0443\u0430\u043d\u0441\u043a\u043e\u043c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435. \u0421 \u044e\u043d\u043e\u0441\u0442\u0438
    \u043e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445
    \u043d\u0435\u0434\u0443\u0433\u043e\u0432 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u0432
    \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0438, \u0447\u0442\u043e \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043e\u043d \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043b
    \u0432 \u0441\u0432\u043e\u0435\u0439 \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.\n\n\U0001F4DA
    \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0438
    \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0442\u0440\u0443\u0434\u044b \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f
    \u043d\u0430 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435,
    \u0435\u0433\u043e \u043a\u0430\u0440\u044c\u0435\u0440\u0430 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b\u0430\u0441\u044c
    \u043d\u0435\u043f\u0440\u043e\u0441\u0442\u043e. \u0418\u0437-\u0437\u0430 \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0441\u0442\u0438
    \u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430
    \u043e\u043d \u043d\u0435 \u043c\u043e\u0433 \u043d\u0430\u0439\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u0443,
    \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0433\u043e\u0434\u044b \u043f\u043e\u0441\u043b\u0435
    \u0443\u0447\u0435\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u043b \u0432 \u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438.
    \u0415\u0433\u043e \u043f\u0440\u043e\u0440\u044b\u0432 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b
    \u0432 1534 \u0433\u043e\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0441\u0442\u0430\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u043e\u043c \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438
    \u0432 \u041c\u0438\u043b\u0430\u043d\u0435, \u0430 \u0432 1539 \u0433\u043e\u0434\u0443
    \u0431\u044b\u043b \u043f\u0440\u0438\u043d\u044f\u0442 \u0432 \u041c\u0438\u043b\u0430\u043d\u0441\u043a\u0443\u044e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0438\u044e \u0432\u0440\u0430\u0447\u0435\u0439, \u043f\u043e\u043b\u0443\u0447\u0438\u0432
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u043a\u0430\u043a \u0432\u044b\u0434\u0430\u044e\u0449\u0438\u0439\u0441\u044f
    \u043c\u0435\u0434\u0438\u043a. \u0412 1543 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0443\u0440\u0443 \u043f\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0435
    \u0432 \u041f\u0430\u0432\u0438\u0438, \u0430 \u0432 1562 \u0433\u043e\u0434\u0443 \u043f\u0435\u0440\u0435\u0448\u0435\u043b
    \u043d\u0430 \u0442\u0443 \u0436\u0435 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0432 \u0411\u043e\u043b\u043e\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.
    \u0412\u043a\u043b\u0430\u0434 \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0432 \u043d\u0430\u0443\u043a\u0443
    \u043e\u0433\u0440\u043e\u043c\u0435\u043d \u0438 \u043c\u043d\u043e\u0433\u043e\u0433\u0440\u0430\u043d\u0435\u043d:
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430: \u0415\u0433\u043e magnum
    opus \u2014 \u043a\u043d\u0438\u0433\u0430 \u00abArs Magna\u00bb (\u00ab\u0412\u0435\u043b\u0438\u043a\u043e\u0435
    \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u00bb, 1545), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0430\u043b\u0433\u0435\u0431\u0440\u044b.
    \u0412 \u043d\u0435\u0439 \u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0444\u043e\u0440\u043c\u0443\u043b\u0443 \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f
    \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043e\u0442
    \u041d\u0438\u043a\u043a\u043e\u043b\u043e \u0422\u0430\u0440\u0442\u0430\u043b\u044c\u0438,
    \u043d\u043e \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d \u043f\u043e\u043a\u043b\u044f\u043b\u0441\u044f
    \u043d\u0435 \u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f, \u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u043e\u0435
    \u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u043a\u043e\u043c \u041b\u043e\u0434\u043e\u0432\u0438\u043a\u043e
    \u0424\u0435\u0440\u0440\u0430\u0440\u0438. \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0441\u0442\u0430\u043b
    \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0432
    \u0415\u0432\u0440\u043e\u043f\u0435, \u043a\u0442\u043e \u043d\u0430\u0447\u0430\u043b
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u0438 \u043c\u043d\u0438\u043c\u044b\u0435 \u043a\u043e\u0440\u043d\u0438 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439:
    \u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0442\u0440\u0430\u043a\u0442\u0430\u0442
    \u00ab\u041a\u043d\u0438\u0433\u0430 \u043e\u0431 \u0438\u0433\u0440\u0435 \u0432 \u043a\u043e\u0441\u0442\u0438\u00bb
    (Liber de ludo aleae), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d
    \u043b\u0438\u0448\u044c \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438
    \u0432 1663 \u0433\u043e\u0434\u0443. \u0412 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435
    \u043e\u043d \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u0437\u0430\u043d\u044f\u043b\u0441\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435\u043c
    \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0435\u0439 \u0432 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0445
    \u0438\u0433\u0440\u0430\u0445, \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0448\u0430\u0433\u043e\u043c \u0432\u043f\u0435\u0440\u0435\u0434 \u0434\u043b\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0440\u0438\u043a\u0438.
    \u0418\u043d\u0436\u0435\u043d\u0435\u0440\u0438\u044f \u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u044f:
    \u0415\u0433\u043e \u0438\u043c\u044f \u043d\u043e\u0441\u0438\u0442 \u043a\u0430\u0440\u0434\u0430\u043d\u043d\u044b\u0439
    \u0432\u0430\u043b \u2014 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0434\u043b\u044f
    \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f
    \u043f\u043e\u0434 \u0443\u0433\u043b\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0435
    \u043e\u043d \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043b,
    \u0445\u043e\u0442\u044f \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c
    \u0431\u044b\u043b \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0438 \u0440\u0430\u043d\u0435\u0435.
    \u041e\u043d \u0442\u0430\u043a\u0436\u0435 \u0438\u0437\u043e\u0431\u0440\u0435\u043b \u0440\u0435\u0448\u0435\u0442\u043a\u0443
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u2014 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439,
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043f\u0440\u043e\u0435\u043a\u0442
    \u043a\u043e\u0434\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043c\u043a\u0430. \u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u044f
    \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u043e\u0437\u043d\u0430\u043d\u0438\u0435:
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u0434\u0432\u0443\u0445 \u043d\u0430\u0442\u0443\u0440\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0445
    \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0439: \u00ab\u041e \u0442\u043e\u043d\u043a\u043e\u0441\u0442\u0438
    \u0432\u0435\u0449\u0435\u0439\u00bb (1550) \u0438 \u00ab\u041e\u0431 \u0438\u0437\u043c\u0435\u043d\u0447\u0438\u0432\u043e\u0441\u0442\u0438
    \u0432\u0435\u0449\u0435\u0439\u00bb (1557). \u0415\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u044b
    \u0441\u043e\u0447\u0435\u0442\u0430\u043b\u0438 \u0432 \u0441\u0435\u0431\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0438\u0434\u0435\u0438 (\u0432\u0435\u0447\u043d\u0430\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u044f
    \u043a\u0430\u043a \u043e\u0441\u043d\u043e\u0432\u0430 \u0432\u0435\u0449\u0435\u0439)
    \u0438 \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0435\u043e\u043f\u043b\u0430\u0442\u043e\u043d\u0438\u0437\u043c.
    \u041e\u043d \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445
    \u0432\u044b\u0434\u0432\u0438\u043d\u0443\u043b \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439
    \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u0435
    \u0433\u043b\u0430\u0437\u0443 \u0436\u0438\u0432\u044b\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430,
    \u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u0435\u0440\u0432\u043e\u0435 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435
    \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0442\u0438\u0444\u0430.\n\n\U0001F3AD
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c, \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438
    \u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0438
    \u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u0441\u0442\u0440\u0430\u0434\u0430\u043d\u0438\u0439.
    \u0412 1531 \u0433\u043e\u0434\u0443 \u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u041b\u044e\u0447\u0438\u0438 \u0411\u043e\u043d\u0434\u0430\u0440\u0435\u043d\u0438,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0443\u043c\u0435\u0440\u043b\u0430 \u0432 1546
    \u0433\u043e\u0434\u0443, \u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u0435\u043c\u0443
    \u0442\u0440\u043e\u0438\u0445 \u0434\u0435\u0442\u0435\u0439. \u0415\u0433\u043e \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u0441\u044b\u043d, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u043d \u0433\u043e\u0440\u044f\u0447\u043e
    \u043b\u044e\u0431\u0438\u043b, \u0431\u044b\u043b \u043a\u0430\u0437\u043d\u0435\u043d
    \u0432 1560 \u0433\u043e\u0434\u0443 \u0437\u0430 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0441\u0432\u043e\u0435\u0439 \u0436\u0435\u043d\u044b. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e
    \u0434\u043b\u044f \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0438\u043c
    \u0443\u0434\u0430\u0440\u043e\u043c, \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e
    \u043e\u043d \u0442\u0430\u043a \u0438 \u043d\u0435 \u043e\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f.
    \u041c\u043b\u0430\u0434\u0448\u0438\u0439 \u0441\u044b\u043d, \u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c
    \u0441\u0430\u043c\u043e\u0433\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e, \u0431\u044b\u043b
    \u0438\u0433\u0440\u043e\u043a\u043e\u043c \u0438 \u0432\u043e\u0440\u043e\u0432\u0430\u043b
    \u0443 \u043d\u0435\u0433\u043e \u0434\u0435\u043d\u044c\u0433\u0438. \u0412 1570 \u0433\u043e\u0434\u0443
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b \u0430\u0440\u0435\u0441\u0442\u043e\u0432\u0430\u043d
    \u0438\u043d\u043a\u0432\u0438\u0437\u0438\u0446\u0438\u0435\u0439 \u043f\u043e \u043e\u0431\u0432\u0438\u043d\u0435\u043d\u0438\u044e
    \u0432 \u0435\u0440\u0435\u0441\u0438. \u041f\u0440\u0438\u0447\u0438\u043d\u043e\u0439
    \u0441\u0442\u0430\u043b\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435
    \u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f \u0433\u043e\u0440\u043e\u0441\u043a\u043e\u043f\u0430
    \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430. \u041e\u043d
    \u043f\u0440\u043e\u0432\u0435\u043b \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0432 \u0442\u044e\u0440\u044c\u043c\u0435,
    \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u0431\u044b\u043b \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d
    \u043e\u0442\u0440\u0435\u0447\u044c\u0441\u044f \u0438 \u043b\u0438\u0448\u0438\u043b\u0441\u044f
    \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430.
    \u0415\u043c\u0443 \u0442\u0430\u043a\u0436\u0435 \u0437\u0430\u043f\u0440\u0435\u0442\u0438\u043b\u0438
    \u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b, \u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435
    \u0438\u0437 \u043d\u0438\u0445 \u0431\u044b\u043b\u0438 \u0432\u043d\u0435\u0441\u0435\u043d\u044b
    \u0432 \u0418\u043d\u0434\u0435\u043a\u0441 \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043d\u044b\u0445
    \u043a\u043d\u0438\u0433. \u041f\u043e\u0441\u043b\u0435 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u044f
    \u043e\u043d \u043f\u0435\u0440\u0435\u0435\u0445\u0430\u043b \u0432 \u0420\u0438\u043c,
    \u0433\u0434\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e
    \u043f\u0430\u043f\u044b \u0413\u0440\u0438\u0433\u043e\u0440\u0438\u044f XIII, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0435\u043c\u0443 \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u0443\u044e
    \u043f\u0435\u043d\u0441\u0438\u044e.\n\n\u2712\ufe0f \u0410\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u0438 \u0437\u0430\u0433\u0430\u0434\u043a\u0430 \u0441\u043c\u0435\u0440\u0442\u0438 \u0412
    \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044e
    \u00ab\u041e \u043c\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438\u00bb (De propria vita).
    \u042d\u0442\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u043d \u0441 \u0431\u0435\u0441\u043f\u043e\u0449\u0430\u0434\u043d\u043e\u0439
    \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442
    \u0441\u0432\u043e\u044e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0431\u043e\u043b\u0435\u0437\u043d\u0438, \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438,
    \u0441\u043d\u044b, \u043f\u043e\u0440\u043e\u043a\u0438 \u0438 \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u044f. \u0421 \u0435\u0433\u043e
    \u0441\u043c\u0435\u0440\u0442\u044c\u044e \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430. \u0413\u043e\u0432\u043e\u0440\u044f\u0442,
    \u0447\u0442\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b
    \u0434\u0435\u043d\u044c \u0441\u0432\u043e\u0435\u0439 \u043a\u043e\u043d\u0447\u0438\u043d\u044b
    \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0438
    \u0438, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430,
    21 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1576 \u0433\u043e\u0434\u0430 \u043f\u043e\u043a\u043e\u043d\u0447\u0438\u043b
    \u0441 \u0441\u043e\u0431\u043e\u0439 \u0433\u043e\u043b\u043e\u0434\u0430\u043d\u0438\u0435\u043c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435
    \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u0441\u0447\u0438\u0442\u0430\u044e\u0442,
    \u0447\u0442\u043e \u043e\u043d \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0448\u0438\u0431\u0441\u044f
    \u0432 \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0442. \u0414\u0436\u0435\u0440\u043e\u043b\u0430\u043c\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0443\u043c\u0435\u0440 21 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1576 \u0433\u043e\u0434\u0430
    \u0432 \u0420\u0438\u043c\u0435. \u0415\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f, \u043d\u043e \u0438 \u043f\u0440\u0438\u043c\u0435\u0440
    \u0431\u0435\u0437\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u043e\u0433\u043e, \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u043e\u0433\u043e
    \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0432\u043e\u0433\u043e
    \u0443\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0441\u043b\u0435\u0434 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u044b\u0441\u043b\u0438."
  shortBioEn: "Gerolamo Cardano is a figure that has bizarrely interwoven the genius of a scientist, the dedication of a doctor, the mysticism of an astrologer and the tragedy of a human being; his life has been full of ups and downs, and his work has had a profound impact on the development of mathematics and natural knowledge.\n\n==Early life==He was born on September 24, 1501 in Pavia, and was the illegitimate son of lawyer Fazio Cardano, who was a friend of Leonardo da Vinci and had knowledge of mathematics, and he was only legalized shortly before his death, and the children of the future scientist were difficult: he was often ill and, according to his own memory, the mother even tried to terminate her pregnancy.In 1520, Cardano entered the University of Pavia in the Faculty of Medicine, where he closed the university because of the war, and in 1526 he completed his studies and received a doctorate in medicine at Paduan University.Since his youth, he has suffered from various illnesses and seizures of hypochondria, which he later described in detail in his autobiography.\n\nIn addition to his brilliant education, his career was not easy because of his illegitimate and difficult nature, and he was unable to find a job and spent the first years of his studies in poverty, a breakthrough that occurred in 1534 when he became a professor of mathematics in Milan and was admitted to the Milan College of Doctors in 1539, recognized as a leading medical doctor.In 1543, he received a medical professor in Pavia, and in 1562 he took the same position at the University of Bologna, and Cardano's contribution to science is enormous and multi-dimensional: Mathematics: His magnum opus is the book \"Ars Magna\", 1545, which has become the cornerstone in the history of algebra.In it he published a formula for solving the cube equations that he received from Nikkol Tartali, but with which he vowed not to share, and the fourth degree equation found by his student Lodovico Ferrari, Cardano was one of the first in Europe to use the negative and perceived roots of the equations.Probability theory: He wrote a tract entitled \"Liber de ludo aleae\", which was published only after his death in 1663, in which he systematically calculated the probabilities of gambling for the first time, which was a significant step forward for the combination.Engineering and inventions: His name is the cardan berm, an angle transmission device that he described in detail, although this mechanism was already known. He also invented the Cardano grid, a message encryption tool, and designed a code lock. Philosophy and natural knowledge: Cardano was the author of two Naturfilosopian encyclopaedia: \"On the fineness of things\" (1550) and \"On the variability of things\" (1557).His views combined materialistic ideas (in perpetuity as the foundation of things) and mystical neoplatonicism, and he first suggested that the cause of infectious diseases could be invisible animals, leaving the first clinical description of typhus.\n\nIn 1531, he married Lucia Bondareni, who died in 1546, leaving him three children. His eldest son, whom he loved, was executed in 1560 for poisoning his wife. This was a terrible blow for Cardano, and he never recovered from it.In 1570, Cardano was arrested by the inquisitor on the charge of heresy, the reason being that Jesus Christ had written and published a horoscope, and spent several months in prison, then he was forced to renounce and lose his professorship, and he was also banned from publishing his work, and some of them were included in the prohibited book index.After his release, he moved to Rome, where he received the protection of Pope Gregory XIII, who granted him a life pension.\n\nThe autobiography and mystery of death in the last years of Cardano's life has written an autobiography called \"De propria vita.\" This is a unique document in which he analyses his personality with unbridled frankness, describing diseases, habits, dreams, vices, and astrologers. His death is associated with a legend.It is said that Cardano predicted the day he died by astrology and to prove the accuracy of the prognosis, on September 21, 1576, he committed starvation, but modern researchers believe that he simply miscalculated for several years.Its legacy is not only a scientific discovery, but also an example of an infinite, passionate and controversial mind that has left a deep mark in the history of human thought."
  interestingFactsRu: "\u0416\u0438\u0437\u043d\u044c \u0414\u0436\u0435\u0440\u043e\u043b\u0430\u043c\u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0439, \u043c\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0439 \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u043a\u043e\u0432,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0440\u0430\u0436\u0430\u044e\u0442
    \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f.
    \u041e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0447\u0435\u043d\u044b\u043c
    \u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c, \u043e\u0434\u0435\u0440\u0436\u0438\u043c\u044b\u043c
    \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u044f\u043c\u0438, \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u043e\u043c,
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0432\u0448\u0438\u043c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0441\u043c\u0435\u0440\u0442\u044c, \u0438 \u0430\u0432\u0442\u043e\u0440\u043e\u043c
    \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e\u0439 \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438,
    \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0435\u0439 \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432
    \u0432 \u0435\u0433\u043e \u044d\u043f\u043e\u0445\u0443. \u0412\u043e\u0442 \u0441\u0430\u043c\u044b\u0435
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0435
    \u0444\u0430\u043a\u0442\u044b \u0438\u0437 \u0435\u0433\u043e \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0438.\n\n\U0001F4D6
    \u0410\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043a\u0430\u043a
    \u0438\u0441\u043f\u043e\u0432\u0435\u0434\u044c \u0438 \u0441\u043a\u0430\u043d\u0434\u0430\u043b
    \u0421\u0430\u043c\u0430 \u043f\u043e \u0441\u0435\u0431\u0435 \u0430\u0432\u0442\u043e\u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u00ab\u041e \u043c\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438\u00bb
    (De propria vita) \u2014 \u044d\u0442\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439
    \u0438 \u0448\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0434\u043b\u044f XVI
    \u0432\u0435\u043a\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442. \u041e\u043d
    \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0435\u0451 \u0441 \u0431\u0435\u0441\u043f\u0440\u0435\u0446\u0435\u0434\u0435\u043d\u0442\u043d\u043e\u0439
    \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e, \u043d\u0435
    \u0449\u0430\u0434\u044f \u043d\u0438 \u0441\u0435\u0431\u044f, \u043d\u0438 \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u044f.
    \u0418\u0441\u043f\u043e\u0432\u0435\u0434\u044c \u0432 \u043f\u043e\u0440\u043e\u043a\u0430\u0445:
    \u0412 \u0441\u0432\u043e\u0435\u0439 \u043a\u043d\u0438\u0433\u0435 \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0447\u0435\u0441\u0442\u043d\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u0435\u0442\u0441\u044f
    \u0432 \u0441\u0430\u043c\u044b\u0445 \u043d\u0435\u043f\u0440\u0438\u0433\u043b\u044f\u0434\u043d\u044b\u0445
    \u0447\u0435\u0440\u0442\u0430\u0445 \u0441\u0432\u043e\u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430.
    \u041e\u043d \u043f\u0438\u0448\u0435\u0442, \u0447\u0442\u043e \u0431\u044b\u043b \u0441\u043a\u043b\u043e\u043d\u0435\u043d
    \u043a \u043f\u044c\u044f\u043d\u0441\u0442\u0432\u0443, \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u043c
    \u0438\u0433\u0440\u0430\u043c, \u043b\u0436\u0438, \u0440\u0430\u0441\u043f\u0443\u0442\u0441\u0442\u0432\u0443
    \u0438 \u0437\u0430\u0432\u0438\u0441\u0442\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435
    \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0441\u044f \u043c\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438 \u0436\u0435\u0441\u0442\u043e\u043a\u043e\u0441\u0442\u044c\u044e \u0432 \u0441\u043b\u043e\u0432\u0430\u0445.
    \u041e\u043d \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0441\u0435\u0431\u044f
    \u043a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043c\u043e\u0433 \u0431\u044b\u0442\u044c \u043d\u0430\u0440\u043e\u0447\u0438\u0442\u043e
    \u0433\u0440\u0443\u0431 \u0438 \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c
    \u0443\u0433\u0440\u044b\u0437\u0435\u043d\u0438\u0439 \u0441\u043e\u0432\u0435\u0441\u0442\u0438.
    \u041e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u0438\u0435 \u043e \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0438:
    \u041a\u043d\u0438\u0433\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f
    \u0441 \u0441\u0435\u043d\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f:
    \u0435\u0433\u043e \u043c\u0430\u0442\u044c \u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044c
    \u043f\u0440\u0435\u0440\u0432\u0430\u0442\u044c \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c,
    \u043d\u043e \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e. \u042d\u0442\u043e
    \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u0442\u043e\u0439 \u044d\u043f\u043e\u0445\u0438 \u0431\u044b\u043b\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439
    \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u044c\u044e. \u0410\u043d\u0430\u043b\u0438\u0437
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043d\u0435\u0434\u0443\u0433\u043e\u0432:
    \u041e\u043d \u0441\u043a\u0440\u0443\u043f\u0443\u043b\u0435\u0437\u043d\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442
    \u0441\u0432\u043e\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438: \u0437\u0430\u0438\u043a\u0430\u043d\u0438\u0435,
    \u0438\u043c\u043f\u043e\u0442\u0435\u043d\u0446\u0438\u044e \u0434\u043e 34 \u043b\u0435\u0442,
    \u043f\u043e\u0434\u0430\u0433\u0440\u0443, \u0433\u0435\u043c\u043e\u0440\u0440\u043e\u0439,
    \u0431\u043e\u043b\u0438 \u0432 \u0436\u0438\u0432\u043e\u0442\u0435 \u0438 \u0438\u043f\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u044e.
    \u041e\u043d \u0431\u044b\u043b \u0443\u0431\u0435\u0436\u0434\u0435\u043d, \u0447\u0442\u043e
    \u0431\u043e\u043b\u0435\u043d \u0432\u0441\u0435\u043c\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u044f\u043c\u0438,
    \u043e \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u044b\u0448\u0430\u043b.
    \u041c\u0430\u043d\u0438\u044f \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0435\u0439.
    \u0415\u043c\u0443 \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e
    \u0437\u0430 \u043d\u0438\u043c \u0448\u043f\u0438\u043e\u043d\u044f\u0442 \u0432\u0441\u0435
    \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430, \u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0432 \u041f\u0430\u0432\u0438\u0438
    \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c \u0435\u0433\u043e \u043e\u0442\u0440\u0430\u0432\u0438\u0442\u044c.\n\n\U0001F47B
    \u0414\u0443\u0445\u0438, \u0434\u0435\u043c\u043e\u043d\u044b \u0438 \u0432\u0435\u0449\u0438\u0435
    \u0441\u043d\u044b \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435
    \u0432\u0435\u0440\u0438\u043b \u0432 \u0441\u0432\u0435\u0440\u0445\u044a\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435
    \u0441\u0438\u043b\u044b \u0438 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0441\u044f
    \u0438\u043c\u0438 \u0432 \u0441\u0430\u043c\u044b\u0445 \u0432\u0430\u0436\u043d\u044b\u0445
    \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u0445. \u042d\u0442\u0430 \u0432\u0435\u0440\u0430
    \u0441\u043e\u0441\u0435\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0432 \u043d\u0435\u043c
    \u0441 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043c\u043e\u043c \u0443\u0447\u0435\u043d\u043e\u0433\u043e.
    \u0412\u0441\u0442\u0440\u0435\u0447\u0438 \u0441 \u0434\u0443\u0445\u0430\u043c\u0438:
    \u041d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u0436\u0438\u0437\u043d\u0438
    \u043e\u043d \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b, \u0447\u0442\u043e
    \u0435\u0433\u043e \u043f\u043e\u0441\u0435\u0449\u0430\u044e\u0442 \u043d\u0435\u043a\u0438\u0435
    \u0434\u0443\u0445\u0438 \u0438\u043b\u0438 \u0434\u0435\u043c\u043e\u043d\u044b. \u0421
    19 \u0434\u043e 26 \u043b\u0435\u0442 \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f
    \u043f\u043e\u0434 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c
    \u0434\u0443\u0445\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u043a\u0430\u043a
    \u043e\u043d \u0432\u0435\u0440\u0438\u043b, \u043d\u0435\u043a\u043e\u0433\u0434\u0430
    \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u0435\u0433\u043e \u043e\u0442\u0446\u0443.
    \u042d\u0442\u043e\u0442 \u0434\u0443\u0445 \u0434\u0430\u0432\u0430\u043b \u0435\u043c\u0443
    \u0441\u043e\u0432\u0435\u0442\u044b \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b
    \u0431\u0443\u0434\u0443\u0449\u0435\u0435. \u041f\u043e\u0437\u0436\u0435 \u0443 \u043d\u0435\u0433\u043e
    \u0431\u044b\u043b \"\u0434\u0443\u0445-\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c\"
    \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0421\u0442\u0435\u0444\u0430\u043d \u0414\u0430\u043c\u0435\u0441.
    \u041e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u0412\u0441\u044e \u0441\u0432\u043e\u044e \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c
    \u043a \u043c\u043e\u043b\u043d\u0438\u0435\u043d\u043e\u0441\u043d\u044b\u043c \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u044f\u043c,
    \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u044e \u0442\u0440\u0443\u0434\u043e\u0432
    \u0438 \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0438\u043c \u043b\u0435\u043a\u0446\u0438\u044f\u043c
    \u043e\u043d \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u043b \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u043e
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443,
    \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443
    \u0441\u0432\u043e\u0435\u0433\u043e \"\u0434\u0435\u043c\u043e\u043d\u0430\" \u0438 \u0434\u0430\u0440\u0443
    \"splendor\" \u2014 \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e\u0433\u043e \u044f\u0441\u043d\u043e\u0432\u0438\u0434\u0435\u043d\u0438\u044f.
    \u0421\u043d\u044b \u043a\u0430\u043a \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e
    \u043a \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044e: \u0421\u043d\u044b \u0434\u043b\u044f
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b\u0438 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0438\u043c
    \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438.
    \u041e\u043d \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0441\u044f
    \u0438\u043c\u0438 \u043f\u0440\u0438 \u0432\u044b\u0431\u043e\u0440\u0435 \u0436\u0435\u043d\u044b,
    \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u043e\u0432
    \u0438 \u0434\u0430\u0436\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u0442\u0440\u0443\u0434\u043e\u0432. \u041e\u0434\u043d\u0430\u0436\u0434\u044b \u0432\u043e
    \u0441\u043d\u0435 \u043e\u043d \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0443\u044e
    \u043c\u0443\u0437\u044b\u043a\u0443, \u0430 \u043f\u0440\u043e\u0441\u043d\u0443\u0432\u0448\u0438\u0441\u044c,
    \u043d\u0430\u0448\u0435\u043b \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b,
    \u043d\u0430\u0434 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u0438\u043b\u0441\u044f
    25 \u043b\u0435\u0442. \u0412 \u0434\u0440\u0443\u0433\u043e\u043c \u0441\u043d\u0435 \u0435\u043c\u0443
    \u0431\u044b\u043b\u043e \u0432\u0435\u043b\u0435\u043d\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c
    \u043a\u043d\u0438\u0433\u0443 \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0432, \u0438
    \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c
    \u043d\u0430\u0434 \u043d\u0435\u0439 \u0441 \u043d\u0435\u0431\u044b\u0432\u0430\u043b\u044b\u043c
    \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u0435\u043c. \u0421\u0430\u043c\u044b\u0439
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439
    \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u043b \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0437\u043d\u0438
    \u0435\u0433\u043e \u043b\u044e\u0431\u0438\u043c\u043e\u0433\u043e \u0441\u044b\u043d\u0430.
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b \u043d\u0430 \u0433\u0440\u0430\u043d\u0438
    \u0431\u0435\u0437\u0443\u043c\u0438\u044f \u043e\u0442 \u0433\u043e\u0440\u044f. \u0412
    \u043e\u0442\u0447\u0430\u044f\u043d\u043d\u043e\u043c \u0441\u043d\u0435 \u043e\u043d \u0443\u0441\u043b\u044b\u0448\u0430\u043b
    \u0433\u043e\u043b\u043e\u0441, \u0441\u043e\u0432\u0435\u0442\u043e\u0432\u0430\u0432\u0448\u0438\u0439
    \u0432\u0437\u044f\u0442\u044c \u0432 \u0440\u043e\u0442 \u0438\u0437\u0443\u043c\u0440\u0443\u0434,
    \u0432\u0438\u0441\u0435\u0432\u0448\u0438\u0439 \u0443 \u043d\u0435\u0433\u043e \u043d\u0430
    \u0448\u0435\u0435. \u041f\u0440\u043e\u0441\u043d\u0443\u0432\u0448\u0438\u0441\u044c,
    \u043e\u043d \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0441\u043e\u0432\u0435\u0442\u0443
    \u0438, \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u0438\u0437\u0443\u043c\u043b\u0435\u043d\u0438\u044e,
    \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b, \u0447\u0442\u043e
    \u0441\u043a\u043e\u0440\u0431\u044c \u043e \u0441\u044b\u043d\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e
    \u0438\u0441\u0447\u0435\u0437\u043b\u0430 \u0438\u0437 \u0435\u0433\u043e \u043f\u0430\u043c\u044f\u0442\u0438.
    \u041e\u043d \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u044d\u0442\u0438\u043c
    \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u043f\u043e\u043b\u0442\u043e\u0440\u0430 \u0433\u043e\u0434\u0430,
    \u0438 \u0431\u043e\u043b\u044c \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u043b\u0430\u0441\u044c
    \u043b\u0438\u0448\u044c \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430
    \u043e\u043d \u0432\u044b\u043d\u0438\u043c\u0430\u043b \u043a\u0430\u043c\u0435\u043d\u044c
    \u0438\u0437\u043e \u0440\u0442\u0430.\n\n\U0001F3AD \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f,
    \u043f\u0440\u0438\u0447\u0443\u0434\u044b \u0438 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044b
    \u041f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0447\u0430\u0441\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0435\u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u044b\u043c
    \u0438 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u043c, \u0430
    \u0435\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u043f\u043e\u043b\u043d\u0430 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445
    \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0439. \u041c\u0430\u0433\u043d\u0438\u0442\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f:
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
    \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445, \u043a\u0442\u043e \u043d\u0430\u0447\u0430\u043b
    \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u043c\u0430\u0433\u043d\u0438\u0442\u044b
    \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439,
    \u0437\u0430\u043b\u043e\u0436\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u044b \u043c\u0430\u0433\u043d\u0438\u0442\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438.
    \u042d\u043a\u0437\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b
    \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u041e\u043d \u0432\u0435\u0440\u0438\u043b
    \u0432 \u0446\u0435\u043b\u0435\u0431\u043d\u0443\u044e \u0441\u0438\u043b\u0443 \u0434\u0440\u0430\u0433\u043e\u0446\u0435\u043d\u043d\u044b\u0445
    \u043a\u0430\u043c\u043d\u0435\u0439, \u043e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u044f\u0441\u044c
    \u043d\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043b\u043e\u0436\u043d\u043e\u0439
    \u044d\u0442\u0438\u043c\u043e\u043b\u043e\u0433\u0438\u0438 \u0441\u043b\u043e\u0432, \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0449\u0435\u0439
    \"gioia\" (\u0440\u0430\u0434\u043e\u0441\u0442\u044c) \u0438 \"gemme\" (\u0434\u0440\u0430\u0433\u043e\u0446\u0435\u043d\u043d\u044b\u0439
    \u043a\u0430\u043c\u0435\u043d\u044c). \u0421\u0442\u0440\u0430\u043d\u043d\u044b\u0435
    \u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0438: \u0421 \u0434\u0435\u0442\u0441\u0442\u0432\u0430
    \u043e\u043d \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u0433\u0438\u043f\u043d\u043e\u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0439. \u0415\u043c\u0443
    \u044f\u0432\u043b\u044f\u043b\u0438\u0441\u044c \u0433\u043e\u0432\u043e\u0440\u044f\u0449\u0438\u0435
    \u043f\u0435\u0442\u0443\u0445\u0438, \u0433\u0440\u043e\u0431\u044b, \u043f\u043e\u043b\u043d\u044b\u0435
    \u043a\u043e\u0441\u0442\u0435\u0439, \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0436\u0443\u0442\u043a\u0438\u0435
    \u0432\u0438\u0434\u0435\u043d\u0438\u044f. \u041f\u0430\u0440\u0430\u0434\u043e\u043a\u0441\u0430\u043b\u044c\u043d\u043e\u0435
    \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435 \u043e\u0442 \u0431\u043e\u043b\u0438:
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u0441\u044f,
    \u0447\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f
    \u0445\u043e\u0440\u043e\u0448\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0434
    \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u0431\u043e\u043b\u0438. \u0415\u0441\u043b\u0438
    \u0443 \u043d\u0435\u0433\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0431\u043e\u043b\u0435\u043b\u043e,
    \u043e\u043d \u0434\u043e \u043a\u0440\u043e\u0432\u0438 \u043a\u0443\u0441\u0430\u043b
    \u0433\u0443\u0431\u044b \u0438\u043b\u0438 \u0440\u0443\u043a\u0438, \u0442\u0430\u043a
    \u043a\u0430\u043a \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u0438
    \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u043e \u0435\u043c\u0443 \u043e\u0441\u0442\u0440\u043e\u0435
    \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u0435.\n\n\U0001F52E \u041f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e
    \u0438 \u0437\u0430\u0433\u0430\u0434\u043a\u0430 \u0441\u043c\u0435\u0440\u0442\u0438 \u0421\u0430\u043c\u0430\u044f
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0438 \u0441\u043f\u043e\u0440\u043d\u0430\u044f
    \u043b\u0435\u0433\u0435\u043d\u0434\u0430 \u043e \u041a\u0430\u0440\u0434\u0430\u043d\u043e
    \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u0435\u0433\u043e \u0443\u0445\u043e\u0434\u043e\u043c
    \u0438\u0437 \u0436\u0438\u0437\u043d\u0438. \u041f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435
    \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438:
    \u0421 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0438\u0438
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043b
    \u0442\u043e\u0447\u043d\u0443\u044e \u0434\u0430\u0442\u0443 \u0441\u0432\u043e\u0435\u0439
    \u0441\u043c\u0435\u0440\u0442\u0438 \u2014 21 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1576 \u0433\u043e\u0434\u0430. \u0421\u0430\u043c\u043e\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e
    \u0438\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0430? \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e
    \u043b\u0435\u0433\u0435\u043d\u0434\u0435, \u043a\u043e\u0433\u0434\u0430 \u044d\u0442\u043e\u0442
    \u0434\u0435\u043d\u044c \u043d\u0430\u0441\u0442\u0430\u043b, \u0430 \u043e\u043d \u0431\u044b\u043b
    \u0435\u0449\u0435 \u0436\u0438\u0432, \u043e\u043d, \u0447\u0442\u043e\u0431\u044b \u043d\u0435
    \u0443\u0434\u0430\u0440\u0438\u0442\u044c \u0432 \u0433\u0440\u044f\u0437\u044c \u043b\u0438\u0446\u043e\u043c
    \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e
    \u043d\u0435\u043f\u043e\u0433\u0440\u0435\u0448\u0438\u043c\u043e\u0433\u043e \u0430\u0441\u0442\u0440\u043e\u043b\u043e\u0433\u0430,
    \u043f\u043e\u043a\u043e\u043d\u0447\u0438\u043b \u0441 \u0441\u043e\u0431\u043e\u0439 \u0433\u043e\u043b\u043e\u0434\u0430\u043d\u0438\u0435\u043c.
    \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u043a\u0438,
    \u043e\u0434\u043d\u0430\u043a\u043e, \u0441\u0447\u0438\u0442\u0430\u044e\u0442, \u0447\u0442\u043e
    \u043e\u043d \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0448\u0438\u0431\u0441\u044f \u0432
    \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u043b\u0435\u0442 \u0438 \u0443\u043c\u0435\u0440 \u043e\u0442 \u0438\u0441\u0442\u043e\u0449\u0435\u043d\u0438\u044f,
    \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u044f\u043c\u0438
    \u0438 \u0441\u0442\u0440\u0435\u0441\u0441\u0430\u043c\u0438. \u0414\u0436\u0435\u0440\u043e\u043b\u0430\u043c\u043e
    \u041a\u0430\u0440\u0434\u0430\u043d\u043e \u0431\u044b\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c,
    \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0443\u0436\u0438\u0432\u0430\u043b\u0438\u0441\u044c
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0439 \u0443\u043c, \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435
    \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u044f, \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u044f\u044f
    \u0432\u0435\u0440\u0430 \u0432 \u043d\u0430\u0443\u043a\u0443 \u0438 \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0434\u0443\u0448\u0435\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u044c.
    \u0415\u0433\u043e \u0436\u0438\u0437\u043d\u044c \u2014 \u044f\u0440\u043a\u0438\u0439
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430
    \u044d\u043f\u043e\u0445\u0438 \u0412\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f,
    \u0433\u0434\u0435 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438 \u0438\u0440\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u0435\u0440\u0435\u043f\u043b\u0435\u0442\u0430\u043b\u0438\u0441\u044c \u0432 \u0435\u0434\u0438\u043d\u044b\u0439,
    \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0439 \u043a\u043b\u0443\u0431\u043e\u043a."
  interestingFactsEn: "Gerolamo Cardano's life was full of incredible contradictions, mystical coincidences and actions that still strike imagination today, and he was both a brilliant scientist and a man possessed by superstitions, an astrologer who predicted his own death, and an author of a frank autobiography with no equivalent in his age, and these are the most interesting and incredible facts from his biography.\n\nThe autobiography as a confession and a scandal is itself Cardano's autobiography \"On My Life\" (De propria vita) is a unique and shocking document for the 16th century. He wrote it with unprecedented frankness, neither of himself nor of the reader. A confession in vices: Cardano's book is honest about the most unattractive of its character.He said, \"O my people, I have been led by God, and I have been led by God, and I have been led astray.\"Analysis of his own diseases: He carefully describes his diseases: stuttering, impotence to the age of 34, pagra, hemorrhage, abdominal pain, and hypochondria, he was convinced that he was sick of all the diseases he had ever heard of, and persecution: Cardano suffered from paranoia, he thought all the governments were spying on him, and the university professors in Pavia were trying to poison him.\n\nHe said: \"O my people!He later had a \"guard spirit\" by the name of Stefan Dames, an explanation of genius: all his ability to lightning, writing and brilliant lectures, he attributed not so much his own intelligence to the intervention of his \"demon\" and the gift of \"splendor\" to sudden psychic vision. Dreams as a guide to action: dreams for Cardano were the most important source of information.He was guided by them in choosing his wife, in making his diagnosis, and even in writing scientific works.And when he woke up, he said, \"O my son!\n\n♪ Disguises, freaks and scandals ♪ Cardano's behavior was often unpredictable and eccentric, and his life was full of incredible coincidences. ♪ Magnetic therapy: Cardano was one of the first to use magnets to treat disease, laying the foundations of magnetic therapy ♪Exotic methods of treatment: He believed in the healing power of gemstones based on his own false etyology of the words linking gioia and gemme. Strange hallucinations: From childhood he suffered from hypno-fantastic hallucinations. He was talking cocks, coffins full of bones, and other creepy visions.The irony of pain: Cardano admitted that he felt well only under the influence of pain.\n\nThe prophecy and mystery of death is the most famous and controversial legend of Cardano's life.Some historians, however, believe that he simply miscalculated for a few years and died of exhaustion caused by disease and stress. Gerolamo Cardano was a man in whom the greatest mind, deep superstition, sincere faith in science and tragic mental illness were found, and his life was a vivid portrait of the Renaissance man, where rational and irrational was intertwined into a single, incredible ball."
