  achievementsRu: "\u0420\u0430\u0434, \u0447\u0442\u043e \u0432\u0430\u0441 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0430
    \u044d\u0442\u0430 \u0442\u0435\u043c\u0430. \u0415\u0441\u043b\u0438 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0420\u043e\u0443\u044d\u043d\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0436\u0438\u0437\u043d\u0438
    \u0433\u0435\u043d\u0438\u044f, \u0442\u043e \u0435\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0435
    \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u043e\u0434\u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438\u0434\u0435\u044f \u043c\u043e\u0436\u0435\u0442 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c
    \u0432\u0441\u044e \u0444\u0438\u0437\u0438\u043a\u0443. \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0435,
    \u0447\u0435\u043c \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e
    \u0444\u043e\u0440\u043c\u0443\u043b. \u041e\u043d \u0441\u043e\u0437\u0434\u0430\u043b
    \u043d\u043e\u0432\u044b\u0439 \u044f\u0437\u044b\u043a, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c
    \u0444\u0438\u0437\u0438\u043a\u0438 XX \u0432\u0435\u043a\u0430 \u043e\u043f\u0438\u0441\u0430\u043b\u0438
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u044b\u0439 \u043c\u0438\u0440, \u0438 \u0438\u0437\u043e\u0431\u0440\u0451\u043b
    \u043d\u043e\u0432\u0443\u044e \u0430\u043b\u0433\u0435\u0431\u0440\u0443, \u0431\u0435\u0437
    \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u0435\u043c\u044b\u0441\u043b\u0438\u043c\u044b
    \u043d\u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0430\u044f \u0433\u0440\u0430\u0444\u0438\u043a\u0430,
    \u043d\u0438 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f.
    \u041d\u0438\u0436\u0435 \u044f \u0440\u0430\u0437\u0431\u0438\u043b \u0435\u0433\u043e
    \u0432\u043a\u043b\u0430\u0434 \u043f\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c,
    \u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0435\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0435\u0439.
    --- 1.\n\n\U0001F4D0 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u043e\u0432\u0430
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 (\u0422\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0438\u0437\u0438\u043a\u0430) \u042d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u0432 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e
    \u043d\u0430\u0443\u043a\u0443. \u0414\u043e \u043d\u0435\u0433\u043e \u0444\u0438\u0437\u0438\u043a\u0430
    \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u043e\u0439
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430,
    \u043d\u043e \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b
    \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0438\u043d\u043e\u0439 \u0432\u0437\u0433\u043b\u044f\u0434.
    \u0412\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430 (\u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f):
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b,
    \u0447\u0442\u043e \u043b\u044e\u0431\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f
    \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0430\u043a, \u0430 \u043f\u043e
    \u0442\u0430\u043a\u043e\u043c\u0443 \u043f\u0443\u0442\u0438, \u0447\u0442\u043e\u0431\u044b
    \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u043b \u0440\u0430\u0437\u043d\u043e\u0441\u0442\u0438
    \u043c\u0435\u0436\u0434\u0443 \u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u044d\u043d\u0435\u0440\u0433\u0438\u0435\u0439
    (\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043c) \u0431\u044b\u043b \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u043c.
    \u042d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u043b\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443
    \u0438\u0437 \u0440\u0430\u0437\u0440\u044f\u0434\u0430 \u00ab\u043f\u0440\u0438\u0447\u0438\u043d\u043d\u043e-\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445
    \u0441\u0432\u044f\u0437\u0435\u0439\u00bb \u0432 \u0440\u0430\u0437\u0440\u044f\u0434 \u00ab\u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u044b\u0445
    \u0437\u0430\u0434\u0430\u0447\u00bb \u0438 \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c \u0434\u043b\u044f
    \u0432\u0441\u0435\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u043e\u0432 \u0444\u0438\u0437\u0438\u043a\u0438
    (\u043e\u043f\u0442\u0438\u043a\u0430, \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430,
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430).
    \u041a\u0430\u043d\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430: \u041e\u043d \u0437\u0430\u043c\u0435\u043d\u0438\u043b
    \u0433\u0440\u043e\u043c\u043e\u0437\u0434\u043a\u0438\u0435 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f
    \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430 \u0432\u0442\u043e\u0440\u043e\u0433\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430 \u043d\u0430 \u0438\u0437\u044f\u0449\u043d\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0438\u0437 2n \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0439 \u043f\u0435\u0440\u0432\u043e\u0433\u043e
    \u043f\u043e\u0440\u044f\u0434\u043a\u0430. \u0412\u043c\u0435\u0441\u0442\u043e \u0441\u0438\u043b
    \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0444\u0443\u043d\u043a\u0446\u0438\u044e
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0438\u0430\u043d (H), \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e\u043b\u043d\u0443\u044e
    \u044d\u043d\u0435\u0440\u0433\u0438\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u044b. \u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0435
    \u043d\u043e\u0432\u0448\u0435\u0441\u0442\u0432\u043e \u2014 \u043e\u043d \u0432\u0432\u0451\u043b
    \u043e\u0431\u043e\u0431\u0449\u0451\u043d\u043d\u044b\u0435 \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u044b
    \u043a\u0430\u043a \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u0435
    \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435, \u043d\u0430\u0440\u0430\u0432\u043d\u0435
    \u0441 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0430\u043c\u0438. \u042d\u0442\u043e
    \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0434\u0435\u043b\u0430\u043b\u043e
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443 \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u043e\u0439
    \u0438 \u043e\u0442\u043a\u0440\u044b\u043b\u043e \u043f\u0443\u0442\u044c \u043a \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435. \u0422\u0435\u043e\u0440\u0438\u044f \u0432\u043e\u0437\u043c\u0443\u0449\u0435\u043d\u0438\u0439:
    \u0412 \u0440\u0430\u0431\u043e\u0442\u0435 \u00ab\u041e\u0431 \u043e\u0431\u0449\u0435\u043c
    \u043c\u0435\u0442\u043e\u0434\u0435 \u0432 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435\u00bb
    (1834) \u043e\u043d \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043c\u0435\u0442\u043e\u0434,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u0439 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0435\u0442, \u043d\u0430
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043b\u0438\u044f\u044e\u0442 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0442\u0435\u043b\u0430. \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438. > \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0434\u043b\u044f \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e: \u041a\u043e\u0433\u0434\u0430
    \u0432 1920-\u0445 \u0433\u043e\u0434\u0430\u0445 \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c
    \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430,
    \u042d\u0440\u0432\u0438\u043d \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e
    \u043e\u043f\u0438\u0440\u0430\u043b\u0441\u044f \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430. \u0412\u043e\u043b\u043d\u043e\u0432\u043e\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0428\u0440\u0451\u0434\u0438\u043d\u0433\u0435\u0440\u0430
    \u2014 \u044d\u0442\u043e, \u043f\u043e \u0441\u0443\u0442\u0438, \u00ab\u0437\u0430\u043a\u0432\u0430\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u044b\u0439\u00bb
    \u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0438\u0430\u043d. \u0411\u0435\u0437
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u044b \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438 \u043c\u0438\u043a\u0440\u043e\u043c\u0438\u0440\u0430.
    --- 2.\n\n\U0001F300 \u041e\u043f\u0442\u0438\u043a\u0430 \u0438 \u00ab\u041a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0440\u0435\u0444\u0440\u0430\u043a\u0446\u0438\u044f\u00bb \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c
    \u2014 \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u043c.
    \u0422\u0435\u043e\u0440\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c \u043b\u0443\u0447\u0435\u0439:
    \u0412 1820-\u0445 \u043e\u043d \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u043b \u043e\u0431\u0449\u0443\u044e
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c
    \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f
    \u0441\u0432\u0435\u0442\u0430, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0441\u0432\u043e\u044e
    \u00ab\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0444\u0443\u043d\u043a\u0446\u0438\u044e\u00bb (\u044d\u0442\u043e \u043f\u0440\u043e\u043e\u0431\u0440\u0430\u0437
    \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0438\u0430\u043d\u0430).
    \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435:
    \u0412 1832 \u0433\u043e\u0434\u0443, \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044f
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0434\u0432\u0443\u0445\u043e\u0441\u043d\u044b\u0445
    \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u043e\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u0430\u0440\u0430\u0433\u043e\u043d\u0438\u0442\u0430), \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0432 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0445
    \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445
    \u0432\u043d\u0443\u0442\u0440\u0438 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u0430
    \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043d\u0435 \u043e\u0434\u0438\u043d
    \u043f\u0440\u0435\u043b\u043e\u043c\u043b\u0451\u043d\u043d\u044b\u0439 \u043b\u0443\u0447,
    \u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e,
    \u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0449\u0438\u0445 \u043f\u043e\u043b\u044b\u0439
    \u043a\u043e\u043d\u0443\u0441. \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435
    \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435: \u042d\u0442\u043e
    \u0431\u044b\u043b\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e,
    \u0447\u0442\u043e \u0444\u0438\u0437\u0438\u043a \u0425\u0430\u043c\u0444\u0440\u0438 \u041b\u043b\u043e\u0439\u0434
    \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b
    \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442. \u041f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435
    \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u043e\u0441\u044c!
    \u042d\u0442\u043e \u0431\u044b\u043b \u0442\u0440\u0438\u0443\u043c\u0444 \u0447\u0438\u0441\u0442\u043e\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043d\u0430\u0434 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u043e\u043c
    \u2014 \u043e\u0434\u043d\u043e \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0441\u043e\u0431\u044b\u0442\u0438\u0439
    \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043d\u0430\u0443\u043a\u0438, \u043a\u043e\u0433\u0434\u0430
    \u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u0441\u043d\u0430\u0447\u0430\u043b\u0430
    \u043e\u0442\u043a\u0440\u044b\u0442\u043e \u043d\u0430 \u043a\u043e\u043d\u0447\u0438\u043a\u0435
    \u043f\u0435\u0440\u0430, \u0430 \u043b\u0438\u0448\u044c \u043f\u043e\u0442\u043e\u043c
    \u0443\u0432\u0438\u0434\u0435\u043d\u043e \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438.
    --- 3.\n\n\U0001F52E \u041a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u044b
    \u0438 \u0420\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0412\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u0433\u043e
    \u0418\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u042d\u0442\u043e \u0441\u0430\u043c\u043e\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0438 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044c\u043d\u043e\u0435
    \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u0440\u0430\u0441\u043a\u043e\u043b
    \u0432 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c
    \u043c\u0438\u0440\u0435 \u043d\u0430 50 \u043b\u0435\u0442. \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430:
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u0438\u0441\u043a\u0430\u043b \u0441\u043f\u043e\u0441\u043e\u0431
    \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c \u0442\u043e\u0447\u043a\u0438 \u0432 \u0442\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u043c
    \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435, \u043f\u043e\u0434\u043e\u0431\u043d\u043e
    \u0442\u043e\u043c\u0443, \u043a\u0430\u043a \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u043d\u0430
    \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438 (\u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044f
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u044b). \u041e\u043d \u0431\u0438\u043b\u0441\u044f
    \u043d\u0430\u0434 \u044d\u0442\u0438\u043c 10 \u043b\u0435\u0442 (\u0441 1833 \u043f\u043e
    1843), \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u043b,
    \u0447\u0442\u043e \u0447\u0438\u0441\u0435\u043b \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c
    \u0442\u0440\u0438 (x, y, z). \u041e\u0437\u0430\u0440\u0435\u043d\u0438\u0435 (16 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1843): \u041e\u043d \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c
    \u0442\u0440\u043e\u0439\u043a\u0438 \u0447\u0438\u0441\u0435\u043b \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e
    \u0431\u0435\u0437 \u043f\u043e\u0442\u0435\u0440\u0438 \u0441\u0432\u043e\u0439\u0441\u0442\u0432
    \u0434\u0435\u043b\u0435\u043d\u0438\u044f. \u041d\u0443\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c
    \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043e\u0435 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435
    \u2014 \u00ab\u0432\u0440\u0435\u043c\u044f\u00bb \u0438\u043b\u0438 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c. \u0422\u0430\u043a \u0440\u043e\u0434\u0438\u043b\u0438\u0441\u044c
    \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u044b \u2014 \u0447\u0438\u0441\u043b\u0430
    \u0432\u0438\u0434\u0430 `q = a + bi + cj + dk`. \u0413\u043b\u0430\u0432\u043d\u0430\u044f
    \u0444\u043e\u0440\u043c\u0443\u043b\u0430: `i\u00b2 = j\u00b2 = k\u00b2 = ijk = -1`. \u042d\u0442\u043e
    \u043e\u0437\u043d\u0430\u0447\u0430\u043b\u043e, \u0447\u0442\u043e `i \u00d7 j = k`, \u043d\u043e
    `j \u00d7 i = -k`. \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e
    \u043e\u0442\u0431\u0440\u043e\u0441\u0438\u043b \u0437\u0430\u043a\u043e\u043d \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438
    (\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u0435\u0439
    \u0432\u0430\u0436\u0435\u043d). \u042d\u0442\u043e \u0441\u0442\u0430\u043b\u043e \u043f\u0435\u0440\u0432\u044b\u043c
    \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c
    \u043d\u0435\u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438. \u0412\u0432\u0435\u0434\u0451\u043d\u043d\u0430\u044f
    \u0442\u0435\u0440\u043c\u0438\u043d\u043e\u043b\u043e\u0433\u0438\u044f: \u0421\u043a\u0430\u043b\u044f\u0440
    (\u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u044c
    `a`). \u0412\u0435\u043a\u0442\u043e\u0440 (\u043c\u043d\u0438\u043c\u0430\u044f \u0447\u0430\u0441\u0442\u044c
    `bi + cj + dk`). \u0412\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437:
    \u041e\u043d \u0438\u0437\u043e\u0431\u0440\u0451\u043b \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u044b \u0441\u0435\u0439\u0447\u0430\u0441
    \u0437\u043d\u0430\u0435\u043c \u043a\u0430\u043a \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u0435
    \u0438 \u0441\u043a\u0430\u043b\u044f\u0440\u043d\u043e\u0435 \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435
    \u0432\u0435\u043a\u0442\u043e\u0440\u043e\u0432. \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440
    \u041d\u0430\u0431\u043b\u0430 (\u2207): \u0421\u0438\u043c\u0432\u043e\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043e\u043d \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u0434\u043b\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f
    \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435, \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432\u043e \u0432\u0441\u0435\u0445
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438
    \u041c\u0430\u043a\u0441\u0432\u0435\u043b\u043b\u0430. \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439:
    \u0425\u043e\u0442\u044f \u0432 \u0447\u0438\u0441\u0442\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0435
    \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f
    \u0443\u0441\u0442\u0443\u043f\u0438\u043b\u0438 \u043c\u0435\u0441\u0442\u043e \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u043c\u0443
    \u0430\u043d\u0430\u043b\u0438\u0437\u0443 \u0413\u0438\u0431\u0431\u0441\u0430, \u043e\u043d\u0438
    \u043d\u0435\u0437\u0430\u043c\u0435\u043d\u0438\u043c\u044b \u0432 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0439
    \u0433\u0440\u0430\u0444\u0438\u043a\u0435 \u0438 \u0440\u043e\u0431\u043e\u0442\u043e\u0442\u0435\u0445\u043d\u0438\u043a\u0435.
    \u041e\u043d\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u0432\u0440\u0430\u0449\u0430\u0442\u044c
    3D-\u043e\u0431\u044a\u0435\u043a\u0442\u044b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,
    \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439 \u0432 \u0432\u0438\u0434\u0435\u043e\u0438\u0433\u0440\u0430\u0445
    \u0438\u043b\u0438 \u043a\u0430\u043c\u0435\u0440\u0443 \u0432 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043a\u043e\u0440\u0430\u0431\u043b\u044f\u0445) \u0431\u0435\u0437 \u043e\u0448\u0438\u0431\u043e\u043a,
    \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0445 \u00ab\u0448\u0430\u0440\u043d\u0438\u0440\u043d\u044b\u043c
    \u0437\u0430\u043c\u043a\u043e\u043c\u00bb (Gimbal lock) \u043f\u0440\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438
    \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0443\u0433\u043b\u043e\u0432 \u042d\u0439\u043b\u0435\u0440\u0430.
    \u0412\u0441\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438
    \u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043f\u0443\u0442\u043d\u0438\u043a\u043e\u0432
    (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041c\u041a\u0421) \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442
    \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u043d\u044b\u0435 \u0440\u0430\u0441\u0447\u0451\u0442\u044b.
    --- 4.\n\n\U0001F4CA \u0422\u0435\u043e\u0440\u0438\u044f \u0447\u0438\u0441\u0435\u043b
    \u0438 \u0410\u043b\u0433\u0435\u0431\u0440\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b\u0441\u044f \u0444\u0438\u0437\u0438\u043a\u043e\u0439.
    \u041e\u043d \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u043b
    \u043e\u0441\u043d\u043e\u0432\u044b \u0430\u043b\u0433\u0435\u0431\u0440\u044b: \u0410\u043b\u0433\u0435\u0431\u0440\u0430
    \u043a\u0430\u043a \u043d\u0430\u0443\u043a\u0430 \u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438:
    \u041e\u043d \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0434\u0430\u0442\u044c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u043e\u0435
    \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u043b\u0433\u0435\u0431\u0440\u0435,
    \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044f \u0435\u0451 \u0441 \u0447\u0438\u0441\u0442\u043e\u0439
    \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439 \u0432\u0440\u0435\u043c\u0435\u043d\u0438.
    \u0422\u0435\u043e\u0440\u0438\u044f \u043e\u043a\u0442\u0430\u0432: \u041f\u043e\u0441\u043b\u0435
    \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u043e\u0432 \u043e\u043d \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0438\u0437
    \u0432\u043e\u0441\u044c\u043c\u0438 \u0447\u0438\u0441\u0435\u043b (\u043e\u043a\u0442\u0430\u0432\u044b),
    \u043d\u043e \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b, \u0447\u0442\u043e
    \u0432 \u043d\u0435\u0439 \u0442\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u043d\u0435
    \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c,
    \u043d\u043e \u0438 \u0430\u0441\u0441\u043e\u0446\u0438\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c
    (\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0441\u043a\u043e\u0431\u043e\u043a) \u2014
    `(a\u00d7b)\u00d7c \u2260 a\u00d7(b\u00d7c)`. \u0425\u043e\u0442\u044f \u044d\u0442\u0430
    \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u043d\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d\u043d\u043e\u0439,
    \u043e\u043d\u0430 \u0437\u0430\u043b\u043e\u0436\u0438\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442
    \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0433\u0438\u043f\u0435\u0440\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445
    \u0447\u0438\u0441\u0435\u043b \u0438 \u0430\u043b\u0433\u0435\u0431\u0440 \u041b\u0438.
    --- 5.\n\n\U0001F30C \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u044f \u0438
    \u00ab\u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u043e\u0432\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u00bb
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e \u0447\u0442\u043e
    \u043e\u043d \u0431\u044b\u043b \u00ab\u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u043e\u043c-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a\u043e\u043c\u00bb
    (\u0438 \u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u0438\u043b \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c
    \u0432 \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f), \u0438\u043c\u0435\u043d\u043d\u043e
    \u0432 \u044d\u0442\u043e\u0439 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u043e\u043d
    \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c.
    \u0412 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438 \u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u044b\u0439
    \u0432\u043a\u043b\u0430\u0434 \u2014 \u043d\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f,
    \u0430 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430.
    \u0415\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0444\u0443\u043d\u043a\u0446\u0438\u044f (\u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u0430\u044f
    \u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u043e\u0432\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f) \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u0430
    \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u043e\u0440\u0431\u0438\u0442\u044b
    \u043f\u043b\u0430\u043d\u0435\u0442 \u043d\u0430 \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442
    \u0432\u043f\u0435\u0440\u0451\u0434 \u0441 \u0431\u0435\u0441\u043f\u0440\u0435\u0446\u0435\u0434\u0435\u043d\u0442\u043d\u043e\u0439
    \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e, \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043e\u0439
    \u0434\u043b\u044f \u044d\u0444\u0435\u043c\u0435\u0440\u0438\u0434\u043d\u043e\u0439 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438.
    ---\n\n\U0001F4DD \u0418\u0442\u043e\u0433\u043e\u0432\u043e\u0435 \u0440\u0435\u0437\u044e\u043c\u0435
    \u0435\u0433\u043e \u0432\u043a\u043b\u0430\u0434\u0430 \u0415\u0441\u043b\u0438 \u0441\u0436\u0430\u0442\u044c
    \u0432\u0441\u0451 \u0432\u044b\u0448\u0435\u0441\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0435
    \u0432 \u0442\u0440\u0438 \u043f\u0443\u043d\u043a\u0442\u0430, \u0442\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u0439
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0442\u0430\u043a: 1. \u0424\u0438\u0437\u0438\u043a-\u0442\u0435\u043e\u0440\u0435\u0442\u0438\u043a:
    \u041f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443 \u0432 \u0441\u0442\u0440\u043e\u0439\u043d\u0443\u044e,
    \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0443\u044e \u0430\u043a\u0441\u0438\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e
    \u0441\u0438\u0441\u0442\u0435\u043c\u0443, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0431\u0430\u0437\u0438\u0440\u0443\u044e\u0442\u0441\u044f
    \u0432\u0441\u0435 \u043f\u043e\u043b\u0435\u0432\u044b\u0435 \u0442\u0435\u043e\u0440\u0438\u0438.
    2. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a-\u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u043e\u043d\u0435\u0440:
    \u041f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043b \u043f\u0440\u0430\u0432\u0438\u043b\u0430
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b, \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u0432
    \u00ab\u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c\u00bb \u0437\u0430\u043a\u043e\u043d\u043e\u043c
    `xy = yx` \u0440\u0430\u0434\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043d\u043e\u0432\u044b\u0445
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u043b\u043e
    \u043a \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u0435. 3. \u041f\u0440\u043e\u0432\u0438\u0434\u0435\u0446:
    \u0415\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0431\u044b\u043b\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c
    \u0441\u043b\u043e\u0436\u043d\u044b \u0434\u043b\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432,
    \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0430 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c
    \u043e\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c
    \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f
    \u0444\u0438\u0437\u0438\u043a\u043e\u0432 \u0447\u0435\u0440\u0435\u0437 50\u201380 \u043b\u0435\u0442
    \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u0441\u043c\u0435\u0440\u0442\u0438.
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e
    \u0440\u0435\u0448\u0438\u043b \u0437\u0430\u0434\u0430\u0447\u0438 \u2014 \u043e\u043d
    \u0434\u0430\u043b \u0443\u0447\u0451\u043d\u044b\u043c \u043c\u0435\u0442\u043e\u0434,
    \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u0439 \u0440\u0435\u0448\u0430\u0442\u044c
    \u0437\u0430\u0434\u0430\u0447\u0438, \u043e \u043a\u043e\u0442\u043e\u0440\u044b\u0445
    \u043e\u043d\u0438 \u0434\u0430\u0436\u0435 \u043d\u0435 \u0437\u043d\u0430\u043b\u0438."
  achievementsEn: 
  personalLifeRu: "\u041b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0441\u044d\u0440\u0430
    \u0423\u0438\u043b\u044c\u044f\u043c\u0430 \u0420\u043e\u0443\u044d\u043d\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u2014 \u044d\u0442\u043e \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f
    \u0438 \u043f\u0440\u043e\u043d\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f,
    \u0440\u0435\u0437\u043a\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f
    \u0441 \u0432\u043e\u0437\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u0439\u043d\u043e\u0441\u0442\u044c\u044e
    \u0435\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0444\u043e\u0440\u043c\u0443\u043b. \u0415\u0441\u043b\u0438 \u0432 \u043d\u0430\u0443\u043a\u0435
    \u043e\u043d \u0431\u044b\u043b \u043f\u0440\u043e\u0432\u0438\u0434\u0446\u0435\u043c,
    \u0432\u0438\u0434\u0435\u0432\u0448\u0438\u043c \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u044e
    \u0442\u0430\u043c, \u0433\u0434\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0432\u0438\u0434\u0435\u043b\u0438
    \u0445\u0430\u043e\u0441, \u0442\u043e \u0432 \u0431\u044b\u0442\u0443 \u0435\u0433\u043e
    \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0430
    \u0441\u043e\u0431\u043e\u0439 \u0446\u0435\u043f\u044c \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445
    \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444, \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0430
    \u0438 \u0441\u0430\u043c\u043e\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u044f.
    \u041d\u0438\u0436\u0435 \u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e
    \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e, \u043e\u043f\u0438\u0440\u0430\u044f\u0441\u044c
    \u043d\u0430 \u043f\u0438\u0441\u044c\u043c\u0430, \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0438
    \u0438 \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u043e\u0432,
    \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0443\u044e
    \u0434\u0440\u0430\u043c\u0443. --- 1.\n\n\U0001F622 \u042e\u043d\u043e\u0448\u0435\u0441\u043a\u0430\u044f
    \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044f \u0438 \u043c\u0443\u0437\u0430 (\u041a\u044d\u0442\u0440\u0438\u043d
    \u0414\u0438\u0441\u043d\u0435\u0439) \u0421\u0430\u043c\u043e\u0439 \u0441\u0438\u043b\u044c\u043d\u043e\u0439
    \u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439
    \u043b\u044e\u0431\u043e\u0432\u044c\u044e \u0432 \u0436\u0438\u0437\u043d\u0438 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u0441\u0442\u0430\u043b\u0430 \u041a\u044d\u0442\u0440\u0438\u043d \u0414\u0438\u0441\u043d\u0435\u0439.
    \u041e\u043d \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441
    \u043d\u0435\u0439 \u0432 1820-\u0445 \u0433\u043e\u0434\u0430\u0445, \u043a\u043e\u0433\u0434\u0430
    \u0435\u043c\u0443 \u0431\u044b\u043b\u043e \u043e\u043a\u043e\u043b\u043e 20 \u043b\u0435\u0442.
    \u041a\u044d\u0442\u0440\u0438\u043d \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430 \u0438, \u043f\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c,
    \u043e\u0431\u043b\u0430\u0434\u0430\u043b\u0430 \u0440\u0435\u0434\u043a\u043e\u0439 \u043a\u0440\u0430\u0441\u043e\u0442\u043e\u0439
    \u0438 \u043e\u0441\u0442\u0440\u044b\u043c \u0443\u043c\u043e\u043c. \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0432\u043b\u044e\u0431\u0438\u043b\u0441\u044f \u0432 \u043d\u0435\u0451 \u0431\u0435\u0437\u043e\u0433\u043b\u044f\u0434\u043d\u043e.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0438\u0445 \u0431\u0440\u0430\u043a\u0443 \u0432\u043e\u0441\u043f\u0440\u043e\u0442\u0438\u0432\u0438\u043b\u0430\u0441\u044c
    \u0441\u0435\u043c\u044c\u044f \u041a\u044d\u0442\u0440\u0438\u043d, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u043e\u0447\u043b\u0430 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430
    \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u043d\u044b\u043c
    \u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u043c \u0436\u0435\u043d\u0438\u0445\u043e\u043c
    (\u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0435\u0433\u043e \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0435
    \u0431\u0443\u0434\u0443\u0449\u0435\u0435). \u042d\u0442\u043e\u0442 \u0440\u0430\u0437\u0440\u044b\u0432
    \u0441\u0442\u0430\u043b \u0434\u043b\u044f \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0442\u0440\u0430\u0432\u043c\u043e\u0439 \u043d\u0430 \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c.
    \u041e\u043d \u0431\u044b\u043b \u043d\u0430\u0442\u0443\u0440\u043e\u0439 \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u043e\u0439
    \u0438 \u0440\u0430\u043d\u0438\u043c\u043e\u0439; \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u044f
    \u0432\u044b\u043b\u0438\u043b\u0438\u0441\u044c \u0432 \u0442\u043e, \u0447\u0442\u043e
    \u043e\u043d \u0441\u0442\u0430\u043b \u043f\u0438\u0441\u0430\u0442\u044c \u0441\u0442\u0438\u0445\u0438
    (\u043e\u043d \u0438\u0437\u0434\u0430\u043b \u0434\u0430\u0436\u0435 \u0441\u0431\u043e\u0440\u043d\u0438\u043a
    \u0441\u0442\u0438\u0445\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0439 \u043d\u0430
    \u0438\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u043c \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c).
    \u041d\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u2014 \u044d\u0442\u0430 \u0431\u0435\u0437\u043e\u0442\u0432\u0435\u0442\u043d\u0430\u044f
    \u043b\u044e\u0431\u043e\u0432\u044c \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u0440\u0438\u0443\u0447\u0438\u043b\u0430
    \u0435\u0433\u043e \u043a \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u043c
    \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f\u043c. \u0412 \u0441\u0432\u043e\u0438\u0445
    \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0430\u0445 \u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043e\u043d \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f
    \u043a \u043e\u0431\u0440\u0430\u0437\u0443 \u041a\u044d\u0442\u0440\u0438\u043d, \u0438\u0434\u0435\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442
    \u0435\u0451 \u0438 \u043a\u043e\u0440\u0438\u0442 \u0441\u0435\u0431\u044f \u0437\u0430
    \u043d\u0435\u0443\u0434\u0430\u0447\u0443. \u041c\u043d\u043e\u0433\u0438\u0435 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u044b
    \u0441\u0447\u0438\u0442\u0430\u044e\u0442, \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e
    \u0438\u0437-\u0437\u0430 \u044d\u0442\u043e\u0439 \u0434\u0443\u0448\u0435\u0432\u043d\u043e\u0439
    \u0431\u043e\u043b\u0438 \u043e\u043d \u0441 \u0433\u043e\u043b\u043e\u0432\u043e\u0439
    \u0443\u0448\u0451\u043b \u0432 \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430\u0434
    \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u0430\u043c\u0438 \u2014 \u044d\u0442\u043e
    \u0431\u044b\u043b \u0435\u0433\u043e \u0441\u043f\u043e\u0441\u043e\u0431 \u0441\u043f\u0430\u0441\u0442\u0438\u0441\u044c
    \u043e\u0442 \u043c\u044b\u0441\u043b\u0435\u0439 \u043e \u043d\u0435\u0439. \u041a\u044d\u0442\u0440\u0438\u043d
    \u0414\u0438\u0441\u043d\u0435\u0439 \u043f\u043e\u0437\u0436\u0435 \u0432\u044b\u0448\u043b\u0430
    \u0437\u0430\u043c\u0443\u0436 \u0437\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u043e,
    \u043d\u043e \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b
    \u043a \u043d\u0435\u0439 \u0442\u0451\u043f\u043b\u044b\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430
    \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0436\u0438\u0437\u043d\u0438 \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b
    \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0443 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u0449\u0435\u043c\u044f\u0449\u0435\u0439 \u0433\u0440\u0443\u0441\u0442\u0438.
    --- 2.\n\n\U0001F494 \u041d\u0435\u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0439
    \u0431\u0440\u0430\u043a \u0441 \u0425\u0435\u043b\u0435\u043d \u041c\u0430\u0440\u0438\u0435\u0439
    \u0411\u044d\u0439\u043b\u0438 \u0412 1833 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    28 \u043b\u0435\u0442, \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u0436\u0435\u043d\u0438\u043b\u0441\u044f
    \u043d\u0430 \u0425\u0435\u043b\u0435\u043d \u041c\u0430\u0440\u0438\u0438 \u0411\u044d\u0439\u043b\u0438.
    \u042d\u0442\u043e \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u0448\u0430\u0433, \u0441\u043e\u0432\u0435\u0440\u0448\u0451\u043d\u043d\u044b\u0439 \u043e\u0442\u0447\u0430\u0441\u0442\u0438
    \u043f\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u0441\u0435\u043c\u044c\u0438,
    \u0447\u0442\u043e\u0431\u044b \u00ab\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u0438\u0442\u044c\u0441\u044f\u00bb
    \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u043e\u0439
    \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u0438 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430.
    \u0425\u0435\u043b\u0435\u043d \u0431\u044b\u043b\u0430 \u0434\u043e\u0447\u0435\u0440\u044c\u044e
    \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430 \u0438\u0437 \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u0430
    \u041c\u0438\u0442. \u0423\u0432\u044b, \u0431\u0440\u0430\u043a \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f
    \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u043e\u0439 \u0441 \u0441\u0430\u043c\u043e\u0433\u043e
    \u043d\u0430\u0447\u0430\u043b\u0430. \u041e\u043d\u0438 \u0431\u044b\u043b\u0438 \u043f\u043e\u043b\u043d\u044b\u043c\u0438
    \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044f\u043c\u0438:
    - \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u2014 \u043c\u0435\u043b\u0430\u043d\u0445\u043e\u043b\u0438\u0447\u043d\u044b\u0439,
    \u043f\u043e\u0433\u0440\u0443\u0436\u0451\u043d\u043d\u044b\u0439 \u0432 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0438
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u043c\u043e\u0433 \u043d\u0435 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c
    \u0447\u0430\u0441\u0430\u043c\u0438, \u043e\u0431\u0434\u0443\u043c\u044b\u0432\u0430\u044f
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443.
    - \u0425\u0435\u043b\u0435\u043d \u2014 \u043f\u0440\u043e\u0441\u0442\u0430\u044f, \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0430\u044f
    \u0436\u0435\u043d\u0449\u0438\u043d\u0430, \u0434\u0430\u043b\u0451\u043a\u0430\u044f \u043e\u0442
    \u043d\u0430\u0443\u043a\u0438, \u043d\u0443\u0436\u0434\u0430\u0432\u0448\u0430\u044f\u0441\u044f
    \u0432 \u043e\u0431\u044b\u0447\u043d\u043e\u043c \u0431\u044b\u0442\u043e\u0432\u043e\u043c
    \u0442\u0435\u043f\u043b\u0435 \u0438 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0438.
    \u0425\u0435\u043b\u0435\u043d \u043d\u0435 \u0432\u044b\u043d\u043e\u0441\u0438\u043b\u0430
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0441\u043a\u0443\u0447\u0430\u043b\u0430
    \u0432 \u0414\u0430\u043d\u0441\u0438\u043d\u043a\u0441\u043a\u043e\u0439 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438,
    \u0433\u0434\u0435 \u043e\u043d\u0438 \u0436\u0438\u043b\u0438. \u041e\u043d\u0430 \u0441\u0447\u0438\u0442\u0430\u043b\u0430
    \u043c\u0443\u0436\u0430 \u0447\u0443\u0434\u0430\u043a\u043e\u043c, \u0430 \u043e\u043d
    \u043d\u0435 \u043c\u043e\u0433 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u0435\u0439
    \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u0438\u0434\u0435\u0439.
    \u041c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u0432\u0441\u043f\u044b\u0445\u0438\u0432\u0430\u043b\u0438 \u0441\u0441\u043e\u0440\u044b.
    \u0412\u0434\u043e\u0431\u0430\u0432\u043e\u043a \u0443 \u0425\u0435\u043b\u0435\u043d \u0431\u044b\u043b\u043e
    \u0441\u043b\u0430\u0431\u043e\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u0438
    \u043e\u043d\u0430 \u0447\u0430\u0441\u0442\u043e \u0431\u043e\u043b\u0435\u043b\u0430,
    \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u043e \u0435\u0451 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439.
    \u041e\u043d\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438 \u043d\u0430 \u0441\u0432\u0435\u0442
    \u0442\u0440\u043e\u0438\u0445 \u0434\u0435\u0442\u0435\u0439: \u0434\u0432\u0443\u0445
    \u0441\u044b\u043d\u043e\u0432\u0435\u0439 (\u0423\u0438\u043b\u044c\u044f\u043c \u042d\u0434\u0432\u0438\u043d
    \u0438 \u0410\u0440\u0447\u0438\u0431\u0430\u043b\u044c\u0434 \u0413\u0435\u043d\u0440\u0438)
    \u0438 \u0434\u043e\u0447\u044c (\u0425\u0435\u043b\u0435\u043d \u042d\u043b\u0438\u0437\u0430\u0431\u0435\u0442).
    \u041e\u0434\u043d\u0430\u043a\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c
    \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u0442\u0435\u043f\u043b\u0435\u0435. \u0425\u0435\u043b\u0435\u043d
    \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u0435\u0437\u0436\u0430\u043b\u0430
    \u043e\u0442 \u043c\u0443\u0436\u0430, \u0436\u0438\u043b\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e
    \u0441 \u0434\u0435\u0442\u044c\u043c\u0438 \u0443 \u0441\u0432\u043e\u0438\u0445 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432
    \u0438\u043b\u0438 \u043d\u0430 \u043a\u0443\u0440\u043e\u0440\u0442\u0430\u0445 \u043f\u043e
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f.
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d, \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c
    \u043e\u0434\u0438\u043d \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439, \u043c\u0440\u0430\u0447\u043d\u043e\u0439
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438, \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0441\u044f \u0432 \u0437\u0430\u0442\u0432\u043e\u0440\u043d\u0438\u043a\u0430.
    --- 3.\n\n\U0001F943 \u0410\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c \u0438
    \u0431\u044b\u0442\u043e\u0432\u043e\u0439 \u0445\u0430\u043e\u0441 \u041e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c
    \u0431\u0435\u0437 \u0436\u0435\u043d\u0441\u043a\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438
    \u0438 \u0441\u0442\u0440\u0430\u0434\u0430\u044f \u043e\u0442 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u0430,
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0437\u043b\u043e\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0442\u044c
    \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0435\u043c. \u042d\u0442\u043e \u043d\u0435
    \u0431\u044b\u043b\u043e \u0432\u0435\u0441\u0451\u043b\u044b\u043c \u043f\u044c\u044f\u043d\u0441\u0442\u0432\u043e\u043c;
    \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435,
    \u0443\u0433\u0440\u044e\u043c\u043e\u0435 \u043f\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u0438\u0435
    \u043a \u0432\u0438\u0441\u043a\u0438 \u0438 \u043f\u043e\u0440\u0442\u0435\u0440\u0443.
    \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u043b\u0438
    \u0435\u0433\u043e \u0432\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u044c \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    20 \u043b\u0435\u0442 \u0436\u0438\u0437\u043d\u0438 \u043a\u0430\u043a \u0443\u0441\u0442\u0440\u0430\u0448\u0430\u044e\u0449\u0443\u044e:
    \u0432\u0435\u0447\u043d\u043e \u043d\u0435\u0431\u0440\u0438\u0442\u044b\u0439, \u0432
    \u043d\u0435\u0447\u0438\u0449\u0435\u043d\u043e\u043c \u0441\u044e\u0440\u0442\u0443\u043a\u0435,
    \u0441 \u043a\u0440\u0430\u0441\u043d\u044b\u043c \u043b\u0438\u0446\u043e\u043c \u0438
    \u043c\u0443\u0442\u043d\u044b\u043c\u0438 \u0433\u043b\u0430\u0437\u0430\u043c\u0438. \u041e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044f
    \u043f\u0440\u0438\u0448\u043b\u0430 \u0432 \u043f\u043e\u043b\u043d\u0435\u0439\u0448\u0438\u0439
    \u0443\u043f\u0430\u0434\u043e\u043a: \u0432\u0441\u044e\u0434\u0443 \u0432\u0430\u043b\u044f\u043b\u0438\u0441\u044c
    \u0433\u0440\u0443\u0434\u044b \u043d\u0435\u0440\u0430\u0437\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0445
    \u0431\u0443\u043c\u0430\u0433, \u0433\u0440\u044f\u0437\u043d\u0430\u044f \u043f\u043e\u0441\u0443\u0434\u0430,
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043f\u0440\u0438\u0431\u043e\u0440\u044b \u043f\u043e\u043a\u0440\u044b\u043b\u0438\u0441\u044c
    \u043f\u044b\u043b\u044c\u044e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e
    \u043e\u043d \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b
    \u0432\u0435\u0441\u0442\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f
    (\u0438\u0441\u043f\u043e\u043b\u043d\u044f\u044f \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e
    \u043d\u043e\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e, \u0447\u0435\u043c \u0432\u044b\u0437\u044b\u0432\u0430\u043b
    \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u043e \u043d\u0430\u0447\u0430\u043b\u044c\u0441\u0442\u0432\u0430).
    \u0415\u0433\u043e \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0438 \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u043e\u043b\u043d\u044b \u0437\u0430\u043f\u0438\u0441\u0435\u0439
    \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d \u043f\u0440\u043e\u0441\u044b\u043f\u0430\u0435\u0442\u0441\u044f
    \u0441 \u043f\u043e\u0445\u043c\u0435\u043b\u044c\u0435\u043c, \u0434\u0430\u0435\u0442
    \u0441\u0435\u0431\u0435 \u0441\u043b\u043e\u0432\u043e \u00ab\u0431\u043e\u043b\u044c\u0448\u0435
    \u043d\u0435 \u043f\u0438\u0442\u044c\u00bb, \u043d\u043e \u043a \u0432\u0435\u0447\u0435\u0440\u0443
    \u0441\u043d\u043e\u0432\u0430 \u0431\u0435\u0440\u0435\u0442\u0441\u044f \u0437\u0430 \u0431\u0443\u0442\u044b\u043b\u043a\u0443,
    \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0433\u043b\u0443\u0448\u0438\u0442\u044c \u0442\u043e\u0441\u043a\u0443.
    \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u044d\u0442\u043e, \u0435\u0433\u043e
    \u043c\u043e\u0437\u0433 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0434\u0435\u0438 \u2014
    \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043a\u0430\u043a \u043f\u0440\u0438
    \u0442\u0430\u043a\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u0435 \u0436\u0438\u0437\u043d\u0438
    \u043e\u043d \u0443\u043c\u0443\u0434\u0440\u044f\u043b\u0441\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c
    \u044f\u0441\u043d\u043e\u0441\u0442\u044c \u0443\u043c\u0430 \u0432 \u0447\u0430\u0441\u044b
    \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0434 \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u0430\u043c\u0438.
    --- 4.\n\n\U0001F468\u200d\U0001F467\u200d\U0001F466 \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f
    \u0441 \u0434\u0435\u0442\u044c\u043c\u0438 \u0438 \u00ab\u0412\u0442\u043e\u0440\u043e\u0439
    \u0431\u0440\u0430\u043a\u00bb \u041a \u0434\u0435\u0442\u044f\u043c \u0443 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u0431\u044b\u043b\u043e \u0441\u043b\u043e\u0436\u043d\u043e\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435.
    \u041e\u043d \u043b\u044e\u0431\u0438\u043b \u0438\u0445, \u043d\u043e \u0431\u044b\u043b
    \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0435\u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d
    \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u0438\u0445 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0435\u043c
    \u0438\u0437-\u0437\u0430 \u0441\u0432\u043e\u0435\u0439 \u043e\u0442\u0440\u0435\u0448\u0451\u043d\u043d\u043e\u0441\u0442\u0438.
    \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044b\u043d, \u0423\u0438\u043b\u044c\u044f\u043c
    \u042d\u0434\u0432\u0438\u043d, \u043f\u043e\u0448\u0451\u043b \u043f\u043e \u0441\u0442\u043e\u043f\u0430\u043c
    \u043e\u0442\u0446\u0430 \u0438 \u0441\u0442\u0430\u043b \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u043c,
    \u043d\u043e \u0438\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438
    \u043f\u0440\u043e\u0445\u043b\u0430\u0434\u043d\u044b\u043c\u0438 \u2014 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e,
    \u0441\u044b\u043d \u0432\u0438\u0434\u0435\u043b, \u043a\u0430\u043a \u043e\u0442\u0435\u0446
    \u0433\u0443\u0431\u0438\u0442 \u0441\u0435\u0431\u044f \u0432\u044b\u043f\u0438\u0432\u043a\u043e\u0439,
    \u0438 \u0441\u0442\u0430\u0440\u0430\u043b\u0441\u044f \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f.
    \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0436\u0438\u0437\u043d\u0438 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u0431\u044b\u043b \u044d\u043f\u0438\u0437\u043e\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442
    \u00ab\u043c\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0431\u0440\u0430\u043a\u043e\u043c\u00bb.
    \u0412 1850-\u0445 \u0433\u043e\u0434\u0430\u0445, \u043a\u043e\u0433\u0434\u0430 \u0425\u0435\u043b\u0435\u043d
    \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0436\u0438\u043b\u0430
    \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e, \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0441\u0442\u0430\u043b \u0436\u0438\u0442\u044c \u0432 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438
    \u0441 \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439 \u043f\u043e \u0438\u043c\u0435\u043d\u0438
    \u041c\u044d\u0440\u0438 \u0425\u0430\u0442\u0442\u043e\u043d. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430
    \u0434\u0430\u043b\u044c\u043d\u0435\u0439 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u0446\u0435\u0439
    \u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b\u0430
    \u0440\u043e\u043b\u044c \u044d\u043a\u043e\u043d\u043e\u043c\u043a\u0438 \u0438 \u0441\u0438\u0434\u0435\u043b\u043a\u0438.
    \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u041c\u044d\u0440\u0438 \u0431\u044b\u043b\u0438
    \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0442\u0435\u043f\u043b\u0435\u0435,
    \u0447\u0435\u043c \u0441 \u0437\u0430\u043a\u043e\u043d\u043d\u043e\u0439 \u0436\u0435\u043d\u043e\u0439.
    \u041e\u043d\u0430 \u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044c \u043d\u0430\u0432\u0435\u0441\u0442\u0438
    \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0432 \u0435\u0433\u043e \u0434\u043e\u043c\u0435
    \u0438 \u0445\u043e\u0442\u044c \u043a\u0430\u043a-\u0442\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c
    \u0435\u0433\u043e \u043f\u0440\u0438\u0451\u043c\u044b \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f.
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u043b
    \u043a \u043d\u0435\u0439 \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u044c.
    \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u0442\u043e\u0433\u043e
    \u0432\u0440\u0435\u043c\u0435\u043d\u0438 (\u0438 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e
    \u0435\u0433\u043e \u0434\u0435\u0442\u0438 \u043e\u0442 \u0425\u0435\u043b\u0435\u043d)
    \u043e\u0441\u0443\u0436\u0434\u0430\u043b\u043e \u044d\u0442\u0443 \u0441\u0432\u044f\u0437\u044c,
    \u0441\u0447\u0438\u0442\u0430\u044f \u0435\u0451 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u044c\u043d\u043e\u0439,
    \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e
    \u0440\u0430\u0437\u0432\u043e\u0434\u0430 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u043d\u0435 \u043e\u0444\u043e\u0440\u043c\u043b\u044f\u043b (\u0440\u0430\u0437\u0432\u043e\u0434
    \u0432 \u0432\u0438\u043a\u0442\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0439 \u0418\u0440\u043b\u0430\u043d\u0434\u0438\u0438
    \u0431\u044b\u043b \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d).
    \u042d\u0442\u0430 \u0434\u0432\u043e\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f
    \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f
    (\u0440\u0430\u0437\u0440\u044b\u0432 \u0441 \u0436\u0435\u043d\u043e\u0439 \u0438 \u0436\u0438\u0437\u043d\u044c
    \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u0436\u0435\u043d\u0449\u0438\u043d\u043e\u0439,
    \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0449\u0435\u0439\u0441\u044f \u0441\u0443\u043f\u0440\u0443\u0433\u043e\u0439)
    \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u043b\u0430 \u0435\u043c\u0443 \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0445
    \u0442\u0435\u0440\u0437\u0430\u043d\u0438\u0439. \u041e\u043d \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e
    \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f \u0432\u0438\u043d\u043e\u0432\u0430\u0442\u044b\u043c
    \u043f\u0435\u0440\u0435\u0434 \u0432\u0441\u0435\u043c\u0438 \u2014 \u043f\u0435\u0440\u0435\u0434
    \u0425\u0435\u043b\u0435\u043d, \u043f\u0435\u0440\u0435\u0434 \u041c\u044d\u0440\u0438,
    \u043f\u0435\u0440\u0435\u0434 \u0434\u0435\u0442\u044c\u043c\u0438. --- 5.\n\n\U0001F319
    \u0423\u043f\u0430\u0434\u043e\u043a \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435
    \u0434\u043d\u0438 \u041a \u043d\u0430\u0447\u0430\u043b\u0443 1860-\u0445 \u0433\u043e\u0434\u043e\u0432
    \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430
    \u0431\u044b\u043b\u043e \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0434\u043e\u0440\u0432\u0430\u043d\u043e.
    \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c
    \u043f\u0440\u0438\u0432\u0435\u043b \u043a \u0442\u044f\u0436\u0435\u043b\u0435\u0439\u0448\u0435\u0439
    \u043f\u043e\u0434\u0430\u0433\u0440\u0435 (\u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0439
    \u043e\u043d \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0442\u0440\u0430\u0434\u0430\u043b)
    \u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c \u0441 \u043f\u043e\u0447\u043a\u0430\u043c\u0438.
    \u041e\u043d \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b
    \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u0438\u0437 \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438,
    \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u043b\u0441\u044f \u0441 \u0442\u0440\u0443\u0434\u043e\u043c
    \u0438 \u0441\u0438\u043b\u044c\u043d\u043e \u0440\u0430\u0441\u043f\u043e\u043b\u043d\u0435\u043b.
    \u0412 \u043a\u043e\u043d\u0446\u0435 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1865 \u0433\u043e\u0434\u0430
    \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0440\u0435\u0437\u043a\u043e \u0443\u0445\u0443\u0434\u0448\u0438\u043b\u043e\u0441\u044c.
    \u0423 \u043d\u0435\u0433\u043e \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u0441\u0438\u043b\u044c\u043d\u044b\u0439
    \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u043f\u043e\u0434\u0430\u0433\u0440\u044b, \u043f\u0435\u0440\u0435\u0448\u0435\u0434\u0448\u0438\u0439
    \u0432 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u043d\u0430 \u0436\u0435\u043b\u0443\u0434\u043e\u043a
    \u0438 \u043f\u043e\u0447\u043a\u0438. \u0415\u0433\u043e \u0434\u0435\u0442\u0438 \u0443\u0441\u043f\u0435\u043b\u0438
    \u043f\u0440\u0438\u0435\u0445\u0430\u0442\u044c \u043a \u043d\u0435\u043c\u0443. 2 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f
    1865 \u0433\u043e\u0434\u0430 \u0423\u0438\u043b\u044c\u044f\u043c \u0420\u043e\u0443\u044d\u043d
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u0441\u043a\u043e\u043d\u0447\u0430\u043b\u0441\u044f
    \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 60 \u043b\u0435\u0442 \u0432 \u0414\u0430\u043d\u0441\u0438\u043d\u043a\u0441\u043a\u043e\u0439
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438, \u0432 \u0442\u043e\u043c
    \u0441\u0430\u043c\u043e\u043c \u0434\u043e\u043c\u0435, \u0433\u0434\u0435 \u043f\u0440\u043e\u0432\u0451\u043b
    \u043f\u043e\u0447\u0442\u0438 40 \u043b\u0435\u0442 \u0441\u0432\u043e\u0435\u0439 \u043e\u0434\u0438\u043d\u043e\u043a\u043e\u0439,
    \u0441\u0443\u043c\u0440\u0430\u0447\u043d\u043e\u0439 \u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e
    \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438.
    --- 6.\n\n\U0001F4DC \u041f\u043e\u0441\u043c\u0435\u0440\u0442\u043d\u044b\u0439 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442
    \u0414\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438
    \u0435\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c \u0441\u0442\u0430\u043b\u0430
    \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0441\u043a\u0430\u043d\u0434\u0430\u043b\u0430.
    \u0412 \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0438 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u043f\u0440\u043e\u044f\u0432\u0438\u043b \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435
    \u043a \u041c\u044d\u0440\u0438 \u0425\u0430\u0442\u0442\u043e\u043d, \u043e\u0441\u0442\u0430\u0432\u0438\u0432
    \u0435\u0439 \u0447\u0430\u0441\u0442\u044c \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430.
    \u042d\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u044f\u0440\u043e\u0441\u0442\u043d\u044b\u0439
    \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u043c\u0435\u0436\u0434\u0443 \u0435\u0433\u043e
    \u0437\u0430\u043a\u043e\u043d\u043d\u044b\u043c\u0438 \u0434\u0435\u0442\u044c\u043c\u0438
    \u043e\u0442 \u0425\u0435\u043b\u0435\u043d \u0411\u044d\u0439\u043b\u0438 \u0438 \u0434\u0443\u0448\u0435\u043f\u0440\u0438\u043a\u0430\u0437\u0447\u0438\u043a\u0430\u043c\u0438.
    \u0421\u044b\u043d \u0423\u0438\u043b\u044c\u044f\u043c \u042d\u0434\u0432\u0438\u043d \u043e\u0441\u043f\u0430\u0440\u0438\u0432\u0430\u043b
    \u0437\u0430\u0432\u0435\u0449\u0430\u043d\u0438\u0435, \u0438 \u0432 \u0438\u0442\u043e\u0433\u0435
    \u041c\u044d\u0440\u0438 \u0431\u044b\u043b\u0430 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u0430
    \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044e
    \u043f\u043e\u0447\u0442\u0438 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435
    \u043f\u043e\u0445\u043e\u0440\u043e\u043d, \u043f\u043e\u043b\u0443\u0447\u0438\u0432 \u043b\u0438\u0448\u044c
    \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u0435 \u043f\u043e\u0441\u043e\u0431\u0438\u0435.
    ---\n\n\U0001F48E \u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439
    \u043f\u043e\u0440\u0442\u0440\u0435\u0442 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0431\u044b\u043b \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c
    \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u00ab\u0431\u0435\u0437\u0443\u043c\u043d\u043e\u0433\u043e
    \u0443\u0447\u0451\u043d\u043e\u0433\u043e\u00bb \u0432\u0438\u043a\u0442\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0439
    \u044d\u043f\u043e\u0445\u0438. \u0415\u0433\u043e \u043b\u0438\u0447\u043d\u0430\u044f
    \u0436\u0438\u0437\u043d\u044c \u2014 \u044d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f
    \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0432\u044b\u0441\u043e\u0447\u0430\u0439\u0448\u0438\u0439
    \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442 \u0438 \u0433\u043b\u0443\u0431\u043e\u0447\u0430\u0439\u0448\u0430\u044f
    \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043b\u0438 \u0431\u044b\u0442\u043e\u0432\u043e\u0435
    \u0441\u0447\u0430\u0441\u0442\u044c\u0435. \u041e\u043d \u0436\u0438\u043b \u0432 \u043f\u043b\u0435\u043d\u0443
    \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043b\u043b\u044e\u0437\u0438\u0439
    (\u043e\u0431\u0440\u0430\u0437 \u041a\u044d\u0442\u0440\u0438\u043d \u0414\u0438\u0441\u043d\u0435\u0439),
    \u043d\u0435 \u0441\u0443\u043c\u0435\u043b \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u0435\u043c\u044c\u044e,
    \u0441\u0442\u0440\u0430\u0434\u0430\u043b \u043e\u0442 \u043d\u0435\u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f
    \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0436\u0435\u043d\u044b \u0438
    \u0432 \u0438\u0442\u043e\u0433\u0435 \u0432\u044b\u0431\u0440\u0430\u043b \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0443\u0442\u0435\u0448\u0438\u0442\u0435\u043b\u0435\u0439 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c
    \u0438 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443.
    \u041f\u043e \u0438\u0440\u043e\u043d\u0438\u0438 \u0441\u0443\u0434\u044c\u0431\u044b,
    \u0438\u043c\u0435\u043d\u043d\u043e \u0435\u0433\u043e \u043d\u0435\u0441\u0447\u0430\u0441\u0442\u044c\u0435
    \u0432 \u043b\u044e\u0431\u0432\u0438 \u0438 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e
    \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438 \u0435\u043c\u0443 \u0441\u043e\u0437\u0434\u0430\u0442\u044c
    \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u044b \u2014 \u0432\u0435\u0434\u044c
    \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u0430 \u0431\u044b\u043b\u0430
    \u043f\u043e\u043b\u043d\u0430\u044f, \u043f\u043e\u0447\u0442\u0438 \u043c\u043e\u043d\u0430\u0448\u0435\u0441\u043a\u0430\u044f
    \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c
    \u043d\u0430 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u043c \u043c\u0438\u0440\u0435,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d
    \u0434\u0430\u0442\u044c \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0439 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0439
    \u0431\u044b\u0442."
  personalLifeEn: 
  shortBioRu: "\u0421\u044d\u0440 \u0423\u0438\u043b\u044c\u044f\u043c \u0420\u043e\u0443\u044d\u043d \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    (1805\u20131865) \u2014 \u0438\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a,
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a \u0438 \u0444\u0438\u0437\u0438\u043a, \u0447\u044c\u0438
    \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u043b\u0438
    \u0441\u0432\u043e\u0451 \u0432\u0440\u0435\u043c\u044f. \u041e\u043d \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d
    \u043a\u0430\u043a \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u043e\u0432\u043e\u0439
    \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f
    \u0441\u0442\u0430\u043b\u0430 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u043e\u043c
    \u0434\u043b\u044f \u043a\u0432\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438,
    \u0438 \u043a\u0430\u043a \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u044c
    \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u043e\u0432 \u2014 \u043f\u0435\u0440\u0432\u043e\u0439
    \u043d\u0435\u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0439
    \u0430\u043b\u0433\u0435\u0431\u0440\u044b, \u043e\u0442\u043a\u0440\u044b\u0432\u0448\u0435\u0439
    \u043f\u0443\u0442\u044c \u043a \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c\u0443
    \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u043c\u0443 \u0430\u043d\u0430\u043b\u0438\u0437\u0443.
    \u041d\u0438\u0436\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430
    \u0435\u0433\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f,
    \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f
    \u043f\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u044d\u0442\u0430\u043f\u0430\u043c
    \u0436\u0438\u0437\u043d\u0438.\n\n\U0001F4DC \u0414\u0435\u0442\u0441\u0442\u0432\u043e
    \u0438 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442
    \u0423\u0438\u043b\u044c\u044f\u043c \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0440\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0414\u0443\u0431\u043b\u0438\u043d\u0435
    4 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1805 \u0433\u043e\u0434\u0430. \u041e\u043d
    \u0431\u044b\u043b \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044b\u043c \u0438\u0437 \u0434\u0435\u0432\u044f\u0442\u0438
    \u0434\u0435\u0442\u0435\u0439 \u0432 \u0441\u0435\u043c\u044c\u0435 \u044e\u0440\u0438\u0441\u0442\u0430.
    \u0418\u0437-\u0437\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0445 \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0435\u0439
    \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u0441 \u0433\u043e\u0434\u043e\u0432\u0430\u043b\u043e\u0433\u043e
    \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0435\u0433\u043e \u0432\u043e\u0441\u043f\u0438\u0442\u044b\u0432\u0430\u043b
    \u0434\u044f\u0434\u044f, \u0414\u0436\u0435\u0439\u043c\u0441 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d,
    \u0432\u0438\u043a\u0430\u0440\u0438\u0439 \u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0439
    \u043f\u0435\u0434\u0430\u0433\u043e\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441
    \u0441\u0430\u043c\u043e\u0433\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0435\u043b
    \u0432 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0435 \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u044b\u0435
    \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438. \u0424\u0435\u043d\u043e\u043c\u0435\u043d\u0430\u043b\u044c\u043d\u0430\u044f
    \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \u043b\u044e\u0431\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430 \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c
    \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u043d\u043e: \u0412 3 \u0433\u043e\u0434\u0430
    \u043e\u043d \u0443\u0436\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u0447\u0438\u0442\u0430\u043b
    \u0438 \u043e\u0441\u0432\u0430\u0438\u0432\u0430\u043b \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443.
    \u041a 7 \u0433\u043e\u0434\u0430\u043c \u043e\u043d \u0437\u043d\u0430\u043b \u043b\u0430\u0442\u044b\u043d\u044c,
    \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439 \u0438 \u0434\u0440\u0435\u0432\u043d\u0435\u0435\u0432\u0440\u0435\u0439\u0441\u043a\u0438\u0439
    \u044f\u0437\u044b\u043a\u0438. \u041a 12 \u0433\u043e\u0434\u0430\u043c \u043f\u043e\u0434
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u043c \u0434\u044f\u0434\u0438,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u044b\u043b \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u043e\u043c,
    \u043e\u043d \u0432\u044b\u0443\u0447\u0438\u043b \u0443\u0436\u0435 12 \u044f\u0437\u044b\u043a\u043e\u0432,
    \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u0438\u0439,
    \u0430\u0440\u0430\u0431\u0441\u043a\u0438\u0439, \u0441\u0430\u043d\u0441\u043a\u0440\u0438\u0442,
    \u0445\u0438\u043d\u0434\u0443\u0441\u0442\u0430\u043d\u0438 \u0438 \u043c\u0430\u043b\u0430\u0439\u0441\u043a\u0438\u0439.
    \u0412 13 \u043b\u0435\u0442 \u043e\u043d \u0434\u0430\u0436\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b
    \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u043e \u0441\u0438\u0440\u0438\u0439\u0441\u043a\u043e\u0439
    \u0433\u0440\u0430\u043c\u043c\u0430\u0442\u0438\u043a\u0435. \u041e\u0434\u043d\u0430\u043a\u043e
    \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043a \u044f\u0437\u044b\u043a\u0430\u043c \u0443\u0441\u0442\u0443\u043f\u0438\u043b
    \u043c\u0435\u0441\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435
    \u043f\u043e\u0441\u043b\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0441 \u0434\u0435\u0432\u044f\u0442\u0438\u043b\u0435\u0442\u043d\u0438\u043c
    \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u043c \"\u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c
    \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043c\" \u0417\u0435\u0440\u0430\u0445\u043e\u043c
    \u041a\u043e\u043b\u0431\u0435\u0440\u043d\u043e\u043c. \u0412 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0438
    \u043f\u043e \u0443\u0441\u0442\u043d\u043e\u043c\u0443 \u0441\u0447\u0451\u0442\u0443 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u043b, \u0438 \u044d\u0442\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435
    \u0441\u0442\u0430\u043b\u043e \u043c\u043e\u0449\u043d\u044b\u043c \u0441\u0442\u0438\u043c\u0443\u043b\u043e\u043c.
    \u0412 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 10 \u043b\u0435\u0442 \u043e\u043d
    \u0438\u0437\u0443\u0447\u0438\u043b \u043b\u0430\u0442\u0438\u043d\u0441\u043a\u0438\u0439
    \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u00ab\u041d\u0430\u0447\u0430\u043b\u00bb \u0415\u0432\u043a\u043b\u0438\u0434\u0430,
    \u0432 13 \u2014 \u00ab\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0443\u044e
    \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a\u0443\u00bb \u041d\u044c\u044e\u0442\u043e\u043d\u0430,
    \u0430 \u0432 16 \u2014 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e
    \u0447\u0430\u0441\u0442\u044c \u0435\u0433\u043e \u0436\u0435 \u00ab\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0447\u0430\u043b \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0439
    \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438\u0438\u00bb. \u0412 17 \u043b\u0435\u0442
    \u043e\u043d \u043d\u0430\u0447\u0430\u043b \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435
    \u00ab\u041d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438\u00bb
    \u041b\u0430\u043f\u043b\u0430\u0441\u0430 \u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b
    \u0432 \u043d\u0435\u0439 \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043e\u0448\u0438\u0431\u043a\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0443\u043a\u0430\u0437\u0430\u043b \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u043c\u0443
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0443 \u0418\u0440\u043b\u0430\u043d\u0434\u0438\u0438
    \u0414\u0436\u043e\u043d\u0443 \u0411\u0440\u0438\u043d\u043a\u043b\u0438. \u042d\u0442\u043e
    \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u043b\u043e \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435
    \u0411\u0440\u0438\u043d\u043a\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0442\u0430\u043b
    \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u043e\u043c \u044e\u043d\u043e\u0433\u043e
    \u0433\u0435\u043d\u0438\u044f.\n\n\U0001F393 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u0438 \u043d\u0435\u0431\u044b\u0432\u0430\u043b\u043e\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0412 1823 \u0433\u043e\u0434\u0443, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435
    18 \u043b\u0435\u0442, \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b
    \u0432 \u0422\u0440\u0438\u043d\u0438\u0442\u0438-\u043a\u043e\u043b\u043b\u0435\u0434\u0436
    \u0414\u0443\u0431\u043b\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430,
    \u0433\u0434\u0435 \u0441 \u0431\u043b\u0435\u0441\u043a\u043e\u043c \u0438\u0437\u0443\u0447\u0430\u043b
    \u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443,
    \u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443, \u043f\u043e\u043b\u0443\u0447\u0430\u044f
    \u0432\u044b\u0441\u0448\u0438\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u043f\u043e
    \u0432\u0441\u0435\u043c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c. \u0412
    1824 \u0433\u043e\u0434\u0443 \u043e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b
    \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443
    \u043f\u043e \u043e\u043f\u0442\u0438\u043a\u0435 \u00ab\u041e \u043a\u0430\u0443\u0441\u0442\u0438\u043a\u0430\u0445\u00bb
    (On Caustics) \u0432 \u0418\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u0443\u044e \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0443\u044e
    \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u044e. \u0413\u043b\u0430\u0432\u043d\u044b\u043c
    \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0441\u0442\u0430\u043b\u043e \u0435\u0433\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0432 1827 \u0433\u043e\u0434\u0443. 22-\u043b\u0435\u0442\u043d\u0435\u043c\u0443 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0443,
    \u0435\u0449\u0451 \u043d\u0435 \u0438\u043c\u0435\u0432\u0448\u0435\u043c\u0443 \u0443\u0447\u0451\u043d\u043e\u0439
    \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438
    \u043f\u043e\u0441\u0442 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438
    \u0414\u0443\u0431\u043b\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430
    \u0438 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0430
    \u0418\u0440\u043b\u0430\u043d\u0434\u0438\u0438 (\u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0438
    \u0411\u0440\u0438\u043d\u043a\u043b\u0438). \u042d\u0442\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435
    \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u043c\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u0440\u043e\u0432,
    \u0442\u0430\u043a \u043a\u0430\u043a \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u043d\u0435 \u0438\u043c\u0435\u043b \u043e\u043f\u044b\u0442\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445
    \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439, \u043d\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u0435
    \u0432\u043b\u0430\u0441\u0442\u0438 \u043f\u043e\u0448\u043b\u0438 \u043d\u0430 \u044d\u0442\u043e\u0442
    \u0448\u0430\u0433, \u0432\u0438\u0434\u044f \u0432 \u043d\u0451\u043c \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439
    \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b.\n\n\U0001F4A1
    \u0420\u0430\u0441\u0446\u0432\u0435\u0442 \u043d\u0430\u0443\u0447\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:
    \u043e\u043f\u0442\u0438\u043a\u0430 \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430
    \u041f\u043e\u0441\u0435\u043b\u0438\u0432\u0448\u0438\u0441\u044c \u0432 \u0414\u0430\u043d\u0441\u0438\u043d\u043a\u0441\u043a\u043e\u0439
    \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u0438, \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0432\u0440\u0435\u043c\u0435\u043d\u0438
    \u043f\u043e\u0441\u0432\u044f\u0449\u0430\u043b \u043d\u0435 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0438,
    \u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0435. \u0412 1832 \u0433\u043e\u0434\u0443 \u043e\u043d
    \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b \u0440\u0430\u0431\u043e\u0442\u0443,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430
    \u0435\u043c\u0443 \u043c\u0438\u0440\u043e\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443.
    \u0412 \u0442\u0440\u0435\u0442\u044c\u0435\u043c \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438
    \u043a \u0441\u0432\u043e\u0435\u0439 \u00ab\u0422\u0435\u043e\u0440\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c
    \u043b\u0443\u0447\u0435\u0439\u00bb \u043e\u043d \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b \u044f\u0432\u043b\u0435\u043d\u0438\u0435
    \u043a\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0435\u0444\u0440\u0430\u043a\u0446\u0438\u0438.
    \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043f\u0440\u0438
    \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445
    \u0441\u0432\u0435\u0442, \u043f\u0440\u043e\u0445\u043e\u0434\u044f \u0447\u0435\u0440\u0435\u0437
    \u0434\u0432\u0443\u0445\u043e\u0441\u043d\u044b\u0439 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b,
    \u0434\u043e\u043b\u0436\u0435\u043d \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u0438\u0437
    \u043d\u0435\u0433\u043e \u043d\u0435 \u0432 \u0432\u0438\u0434\u0435 \u043e\u0434\u043d\u043e\u0433\u043e
    \u043b\u0443\u0447\u0430, \u0430 \u0432 \u0432\u0438\u0434\u0435 \u043f\u043e\u043b\u043e\u0433\u043e
    \u043a\u043e\u043d\u0443\u0441\u0430. \u042d\u0442\u043e \u0441\u043c\u0435\u043b\u043e\u0435
    \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0432\u0441\u043a\u043e\u0440\u0435
    \u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b
    \u043d\u0430 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0435 \u0435\u0433\u043e
    \u043a\u043e\u043b\u043b\u0435\u0433\u0430, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440
    \u0425\u0430\u043c\u0444\u0440\u0438 \u041b\u043b\u043e\u0439\u0434. \u0412 1834\u20131835
    \u0433\u043e\u0434\u0430\u0445 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043b
    \u0441\u0432\u043e\u0438 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435
    \u0440\u0430\u0431\u043e\u0442\u044b \u00ab\u041e\u0431 \u043e\u0431\u0449\u0435\u043c \u043c\u0435\u0442\u043e\u0434\u0435
    \u0432 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435\u00bb. \u0412 \u043d\u0438\u0445
    \u043e\u043d \u043f\u0435\u0440\u0435\u043d\u0451\u0441 \u0441\u0432\u043e\u0438 \u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u043c\u0435\u0442\u043e\u0434\u044b \u043d\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443
    \u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439, \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e
    \u043e\u0431\u0449\u0438\u0439 \u043f\u043e\u0434\u0445\u043e\u0434 \u043a \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044e
    \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c. \u0415\u0433\u043e
    \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f
    \u044d\u0442\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430: \u041f\u0440\u0438\u043d\u0446\u0438\u043f
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430 (\u0432\u0430\u0440\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439
    \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f), \u043a\u043e\u0442\u043e\u0440\u044b\u0439
    \u0441\u0442\u0430\u043b \u043a\u0440\u0430\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c
    \u043a\u0430\u043c\u043d\u0435\u043c \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439
    \u0444\u0438\u0437\u0438\u043a\u0438. \u041a\u0430\u043d\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435
    \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0430,
    \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438
    \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0443
    \u0447\u0435\u0440\u0435\u0437 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 (\u0433\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d\u0438\u0430\u043d\u044b)
    \u0438 \u043e\u0442\u043a\u0440\u044b\u043b\u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e
    \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044e \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0430\u043c\u0438
    \u0438 \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u0430\u043c\u0438. \u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439
    \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u041f\u0438\u0442\u0435\u0440 \u0422\u0435\u0439\u0442
    \u043d\u0430\u0437\u0432\u0430\u043b \u044d\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b
    \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u043c \u0432\u043a\u043b\u0430\u0434\u043e\u043c
    \u0432 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0443 \u0441\u043e \u0432\u0440\u0435\u043c\u0451\u043d
    \u041d\u044c\u044e\u0442\u043e\u043d\u0430 \u0438 \u041b\u0430\u0433\u0440\u0430\u043d\u0436\u0430.
    \u0417\u0430 \u0441\u0432\u043e\u0438 \u043d\u0430\u0443\u0447\u043d\u044b\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u0438
    \u0432 1835 \u0433\u043e\u0434\u0443 \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0431\u044b\u043b \u043f\u043e\u0441\u0432\u044f\u0449\u0451\u043d \u0432 \u0440\u044b\u0446\u0430\u0440\u0441\u043a\u043e\u0435
    \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u043e \u0432\u0438\u0446\u0435-\u043a\u043e\u0440\u043e\u043b\u0451\u043c
    \u0418\u0440\u043b\u0430\u043d\u0434\u0438\u0438, \u0430 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0435
    \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u043d\u0430\u0433\u0440\u0430\u0434\u0438\u043b\u043e
    \u0435\u0433\u043e \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u043c\u0435\u0434\u0430\u043b\u044c\u044e.
    \u0412 1837 \u0433\u043e\u0434\u0443 \u043e\u043d \u0431\u044b\u043b \u0438\u0437\u0431\u0440\u0430\u043d
    \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043e\u043c \u0418\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u043e\u0439
    \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u0438 \u0447\u043b\u0435\u043d\u043e\u043c-\u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u043e\u043c
    \u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043a\u043e\u0439 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u0438
    \u043d\u0430\u0443\u043a.\n\n\u2728 \u0412\u0435\u043b\u0438\u043a\u043e\u0435 \u043e\u0437\u0430\u0440\u0435\u043d\u0438\u0435:
    \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u043e\u0432
    \u041a 1840-\u043c \u0433\u043e\u0434\u0430\u043c \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d
    \u0431\u044b\u043b \u043e\u0434\u0435\u0440\u0436\u0438\u043c \u0438\u0434\u0435\u0435\u0439
    \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0430\u043b\u0433\u0435\u0431\u0440\u0443 \u0434\u043b\u044f
    \u0442\u0440\u0451\u0445\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430,
    \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0431\u044b \u0441\u0442\u043e\u043b\u044c
    \u0436\u0435 \u043f\u043e\u043b\u0435\u0437\u043d\u0430, \u043a\u0430\u043a \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0435
    \u0447\u0438\u0441\u043b\u0430 \u0434\u043b\u044f \u0434\u0432\u0443\u043c\u0435\u0440\u043d\u043e\u0439
    \u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u0438. \u0414\u043e\u043b\u0433\u0438\u0435
    \u0433\u043e\u0434\u044b \u043e\u043d \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u043e
    \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c
    \u0442\u0435\u043e\u0440\u0438\u044e \"\u0442\u0440\u0438\u043f\u043b\u0435\u0442\u043e\u0432\".
    \u041d\u0430\u043a\u043e\u043d\u0435\u0446, 16 \u043e\u043a\u0442\u044f\u0431\u0440\u044f
    1843 \u0433\u043e\u0434\u0430, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438
    \u0432\u0434\u043e\u043b\u044c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e
    \u043a\u0430\u043d\u0430\u043b\u0430 \u0432 \u0414\u0443\u0431\u043b\u0438\u043d\u0435 \u0441
    \u0436\u0435\u043d\u043e\u0439, \u0435\u0433\u043e \u043e\u0441\u0435\u043d\u0438\u043b\u043e.
    \u041e\u043d \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435
    \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u0432 \u0442\u0440\u0451\u0445
    \u0447\u0438\u0441\u043b\u0430\u0445, \u0430 \u0432 \u0447\u0435\u0442\u044b\u0440\u0451\u0445
    \u2014 \u0432 \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u0430\u0445.
    \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c
    \u0431\u044b\u043b \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u043a\u043e\u043c\u043c\u0443\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e
    \u0437\u0430\u043a\u043e\u043d\u0430 \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f
    (\u0442.\u0435. `a \u00d7 b \u2260 b \u00d7 a`). \u041e\u0445\u0432\u0430\u0447\u0435\u043d\u043d\u044b\u0439
    \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u043e\u043c, \u043e\u043d \u0432\u044b\u0440\u0435\u0437\u0430\u043b
    \u043e\u0441\u043d\u043e\u0432\u043d\u0443\u044e \u0444\u043e\u0440\u043c\u0443\u043b\u0443
    \u043d\u0430 \u043a\u0430\u043c\u043d\u0435 \u043c\u043e\u0441\u0442\u0430 \u0411\u0440\u0443\u043c-\u0411\u0440\u0438\u0434\u0436:
    `i\u00b2 = j\u00b2 = k\u00b2 = ijk = -1`. \u041e\u0441\u0442\u0430\u0442\u043e\u043a \u0441\u0432\u043e\u0435\u0439
    \u0436\u0438\u0437\u043d\u0438, \u043f\u043e\u0447\u0442\u0438 22 \u0433\u043e\u0434\u0430,
    \u043e\u043d \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u043b \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044e
    \u044d\u0442\u043e\u0439 \u0430\u043b\u0433\u0435\u0431\u0440\u044b \u0438 \u0435\u0451
    \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439. \u0425\u043e\u0442\u044f \u043f\u043e\u0437\u0436\u0435
    \u043a\u0432\u0430\u0442\u0435\u0440\u043d\u0438\u043e\u043d\u044b \u0431\u044b\u043b\u0438
    \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0432\u044b\u0442\u0435\u0441\u043d\u0435\u043d\u044b
    \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u043e\u043c
