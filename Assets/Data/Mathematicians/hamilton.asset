    \u043b\u0438\u0447\u043d\u044b\u0435 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438 \u0441\u043f\u043b\u0435\u043b\u0438\u0441\u044c
    \u0432 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u043b\u043e\u0434\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0445
    \u0438 \u0434\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0445 \u043d\u0430\u0443\u0447\u043d\u044b\u0445
    \u043f\u0443\u0442\u0435\u0439 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438."
