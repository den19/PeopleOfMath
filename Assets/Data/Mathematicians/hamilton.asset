    \u043f\u043e\u0434\u0430\u0433\u0440\u044b.\n\n\U0001F4D6 \u041d\u0430\u0441\u043b\u0435\u0434\u0438\u0435
    \u0413\u0430\u043c\u0438\u043b\u044c\u0442\u043e\u043d \u0431\u044b\u043b \u043e\u0434\u043d\u0438\u043c
